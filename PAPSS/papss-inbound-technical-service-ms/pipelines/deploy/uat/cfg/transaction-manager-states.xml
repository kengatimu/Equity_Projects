<?xml version="1.0" encoding="UTF-8"?>
<transaction-manager-states>
    <!-- The initial state now points to our new metrics participant state -->
    <state name="initial" next="start-metrics"/>

    <!-- This new state is the first step, capturing the start of the transaction -->
    <state name="start-metrics" participant="com.equitybank.gag.papss.its.jpos.jolokia.metrics.MetricsParticipant" next="validate"/>

    <!-- Common initial validation -->
    <state name="validate" participant="ValidationParticipant" next="message-type-check"/>

    <!-- ISO 20022 digital signature validation -->
    <!--    <state name="signature-validation" participant="ISO20022SignatureValidationParticipant" next="message-type-check"/>-->

    <!-- Decide flow based on inbound message type -->
    <state name="message-type-check" participant="MessageTypeCheckerParticipant">
        <transition name="acmt023" next="namecheck"/>
        <transition name="pacs008" next="persist-initial"/>
        <transition name="default" next="failure"/>
    </state>

    <!-- === acmt.023 (Name Check) flow === -->
    <!-- No NEEDS_PAPSS_REVERSAL or DB updates for acmt -->
    <state name="namecheck" participant="NamecheckParticipant" next="build-acmt-response"/>
    <state name="build-acmt-response" participant="ISO20022Acmt024BuilderParticipant" next="acmt-024-http-client"/>
    <state name="acmt-024-http-client" participant="Acmt024HttpClientParticipant" next="acmt-completed"/>
    <state name="acmt-completed"/>

    <!-- === pacs.008 (Credit Transfer) flow === -->
    <state name="persist-initial" participant="InitialTransactionPersistenceParticipant" next="account-enquiry-check"/>
    <state name="account-enquiry-check" participant="Pacs008AccountEnquiryParticipant" next="iso8583-message-builder"/>
    <state name="iso8583-message-builder" participant="ISO8583MessageBuilderParticipant" next="finacle-dr-cr"/>
    <state name="finacle-dr-cr" participant="FinacleDebitCreditParticipant" next="final-status-consolidator"/>
    <state name="final-status-consolidator" participant="FinalTransactionStatusConsolidatorParticipant" next="pacs-completed"/>
    <state name="pacs-completed"/>

    <!-- Shared failure route for all inbound flows -->
    <!-- For pacs.008, TransactionErrorHandlingParticipant will check NEEDS_PAPSS_REVERSAL and NEEDS_FINACLE_REVERSAL flags -->
    <state name="failure" participant="TransactionErrorHandlingParticipant" next="failed"/>
    <state name="failed"/>
</transaction-manager-states>
