<?xml version="1.0" encoding="UTF-8"?>
<transaction-manager name="transaction-manager-tm-2"
                     logger="Q2"
                     realm="papss"
                     class="org.jpos.transaction.TransactionManager">

    <!-- Space and queue configuration -->
    <property name="input-space" value="tspace:inbound"/>
    <property name="queue" value="transaction-manager-queue-q2"/>
    <property name="space" value="transaction-manager-queue-q2"/>
    <property name="sessions" value="10"/>
    <property name="max-sessions" value="100"/>
    <property name="debug" value="true"/>
    <property name="logger" value="Q2"/>

    <!-- Optional metrics tracking -->
    <participant name="MetricsParticipant"
                 class="com.equitybank.gag.papss.its.jpos.jolokia.metrics.MetricsParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader">
        <!-- Tell participant which MBean key to bind to -->
        <property name="metrics-mbean-key" value="jpos.metrics.mbean.inbound"/>
    </participant>

    <!-- Common participants -->
    <participant name="ValidationParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.ValidationParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <!--    <participant name="ISO20022SignatureValidationParticipant"-->
    <!--                 class="com.equitybank.gag.papss.its.jpos.space.participants.ISO20022SignatureValidationParticipant"-->
    <!--                 autoconnect="true"-->
    <!--                 contextRef="spring-bean-loader"/>-->

    <participant name="MessageTypeCheckerParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.MessageTypeCheckerParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <!-- acmt.023 (Name Check) flow -->
    <participant name="NamecheckParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.namecheckFlow.NamecheckParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>
    <participant name="ISO20022Acmt024BuilderParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.namecheckFlow.ISO20022Acmt024BuilderParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>
    <participant name="Acmt024HttpClientParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.namecheckFlow.Acmt024HttpClientParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <!-- pacs.008 (Credit Transfer) flow -->
    <participant name="InitialTransactionPersistenceParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.creditTransferFlow.InitialTransactionPersistenceParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>
    <participant name="Pacs008AccountEnquiryParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.creditTransferFlow.Pacs008AccountEnquiryParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>
    <participant name="ISO8583MessageBuilderParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.creditTransferFlow.ISO8583MessageBuilderParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>
    <participant name="FinacleDebitCreditParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.creditTransferFlow.FinacleDebitCreditParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>
    <participant name="FinalTransactionStatusConsolidatorParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.creditTransferFlow.FinalTransactionStatusConsolidatorParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <!-- Shared failure handler -->
    <participant name="TransactionErrorHandlingParticipant"
                 class="com.equitybank.gag.papss.its.jpos.space.participants.TransactionErrorHandlingParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <!-- States definition -->
    <states>cfg/transaction-manager-states_backup.xml</states>

</transaction-manager>
