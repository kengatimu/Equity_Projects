<?xml version="1.0" encoding="utf-8"?>
<hdr:Message xmlns:hdr="urn:montran:message.01">
    <hdr:AppHdr xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.01">
        <Fr>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </Fr>
        <To>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{toClearingSystemId}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </To>
        <BizMsgIdr>{{messageId}}</BizMsgIdr>
        <MsgDefIdr>camt.056.001.06</MsgDefIdr>
        <BizSvc>RTP</BizSvc>
        <CreDt>{{creationDateTime}}</CreDt>
    </hdr:AppHdr>

    <hdr:FIToFIPmtCxlReq xmlns="urn:iso:std:iso:20022:tech:xsd:camt.056.001.06">
        <Assgnmt>
            <Id>{{messageId}}</Id>
            <Assgnr>
                <Agt>
                    <FinInstnId>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>{{sender_papss_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgnr>
            <Assgne>
                <Agt>
                    <FinInstnId>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>{{toClearingSystemId}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgne>
            <CreDtTm>{{creationDateTime}}</CreDtTm>
        </Assgnmt>

        <Undrlyg>
            <TxInf>
                <CxlId>{{messageId}}</CxlId>
                <OrgnlGrpInf>
                    <OrgnlMsgId>{{original_message_id}}</OrgnlMsgId>
                    <OrgnlMsgNmId>camt.056.001.06</OrgnlMsgNmId>
                </OrgnlGrpInf>
                <OrgnlEndToEndId>{{original_end_to_end_ref}}</OrgnlEndToEndId>
                <OrgnlTxId>{{original_message_id}}</OrgnlTxId>
                <OrgnlIntrBkSttlmAmt Ccy="{{sender_currency}}">{{sender_amount}}</OrgnlIntrBkSttlmAmt>
                <OrgnlIntrBkSttlmDt>{{transactionDate}}</OrgnlIntrBkSttlmDt>

                <CxlRsnInf>
                    <Orgtr>
                        <Id>
                            <OrgId>
                                <Othr>
                                    <Id>{{sender_papss_id}}</Id>
                                    <SchmeNm>
                                        <Prtry>PAPSS</Prtry>
                                    </SchmeNm>
                                </Othr>
                            </OrgId>
                        </Id>
                    </Orgtr>
                    <Rsn>
                        <Cd>{{reasonCode}}</Cd>
                    </Rsn>
                </CxlRsnInf>

                <OrgnlTxRef>
                    <Amt>
                        <InstdAmt Ccy="{{receiver_currency}}">{{receiver_amount}}</InstdAmt>
                    </Amt>
                    <PmtTpInf>
                        <SvcLvl>
                            <Cd>INST</Cd>
                        </SvcLvl>
                        <LclInstrm>
                            <Cd>{{settlementType}}</Cd>
                        </LclInstrm>
                    </PmtTpInf>
                    <RmtInf>
                        <Ustrd>{{narration}}</Ustrd>
                    </RmtInf>
                    <Dbtr>
                        <Nm>{{sender_account_name}}</Nm>
                        <PstlAdr>
                            <Ctry>{{sender_country_code}}</Ctry>
                            <AdrLine>{{sender_address}}</AdrLine>
                        </PstlAdr>
                    </Dbtr>
                    <DbtrAcct>
                        <Id>
                            <Othr>
                                <Id>{{sender_account_number}}</Id>
                                <SchmeNm>
                                    <Cd>{{iban}}</Cd>
                                </SchmeNm>
                            </Othr>
                        </Id>
                    </DbtrAcct>
                    <DbtrAgt>
                        <FinInstnId>
                            <ClrSysMmbId>
                                <ClrSysId>
                                    <Prtry>PAPSS</Prtry>
                                </ClrSysId>
                                <MmbId>{{sender_papss_id}}</MmbId>
                            </ClrSysMmbId>
                        </FinInstnId>
                    </DbtrAgt>
                    <CdtrAgt>
                        <FinInstnId>
                            <BICFI>{{receiver_bank_scheme}}</BICFI>
                            <ClrSysMmbId>
                                <ClrSysId>
                                    <Prtry>PAPSS</Prtry>
                                </ClrSysId>
                                <MmbId>{{receiver_papss_id}}</MmbId>
                            </ClrSysMmbId>
                        </FinInstnId>
                    </CdtrAgt>
                    <Cdtr>
                        <Nm>{{receiver_account_name}}</Nm>
                        <PstlAdr>
                            <Ctry>{{receiver_country_code}}</Ctry>
                            <AdrLine>{{receiver_address}}</AdrLine>
                        </PstlAdr>
                    </Cdtr>
                    <CdtrAcct>
                        <Id>
                            <Othr>
                                <Id>{{receiver_account_number}}</Id>
                                <SchmeNm>
                                    <Cd>{{iban}}</Cd>
                                </SchmeNm>
                            </Othr>
                        </Id>
                    </CdtrAcct>
                </OrgnlTxRef>
            </TxInf>
        </Undrlyg>

        <SplmtryData>
            <Envlp>
                <AuditInfo>
                    <IP>{{papss_ip}}</IP>
                    <PC>{{pc_name}}</PC>
                </AuditInfo>
            </Envlp>
        </SplmtryData>
    </hdr:FIToFIPmtCxlReq>

</hdr:Message>
