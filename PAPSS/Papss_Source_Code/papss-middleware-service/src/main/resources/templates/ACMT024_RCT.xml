<?xml version="1.0" encoding="utf-8"?>
<hdr:Message xmlns:hdr="urn:montran:message.01">
    <hdr:AppHdr xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.01">
        <Fr>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>{{clearing_sys_id_prtry}}</Prtry>
                        </ClrSysId>
                        <MmbId>{{participant_member_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </Fr>
        <To>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>{{clearing_sys_id_prtry}}</Prtry>
                        </ClrSysId>
                        <MmbId>{{participant_clearing_system_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </To>
        <BizMsgIdr>{{message_id}}</BizMsgIdr>
        <MsgDefIdr>{{msg_def_idr}}</MsgDefIdr>
        <BizSvc>RTP</BizSvc>
        <CreDt>{{create_date_time}}</CreDt>
    </hdr:AppHdr>
    <hdr:IdVrfctnRpt xmlns="urn:iso:std:iso:20022:tech:xsd:acmt.024.001.02">
        <Assgnmt>
            <MsgId>{{message_id}}</MsgId>
            <CreDtTm>{{create_date_time}}</CreDtTm>
            <Assgnr>
                <Agt>
                    <FinInstnId>

                        {{#participant_bic_fi}}<BICFI>{{participant_bic_fi}}</BICFI>{{/participant_bic_fi}}
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>{{clearing_sys_id_prtry}}</Prtry>
                            </ClrSysId>
                            <MmbId>{{participant_member_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgnr>
            <Assgne>
                <Agt>
                    <FinInstnId>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>{{clearing_sys_id_prtry}}</Prtry>
                            </ClrSysId>
                            <MmbId>{{assignee_member_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgne>
        </Assgnmt>
        <OrgnlAssgnmt>
            <MsgId>{{original_assignment_message_id}}</MsgId>
        </OrgnlAssgnmt>
        <Rpt>
            <OrgnlId>{{rpt_original_id}}</OrgnlId>
            <Vrfctn>{{rpt_vrfctn}}</Vrfctn>
            <Rsn>
                <Cd>{{reject_reason}}</Cd>
            </Rsn>
            <OrgnlPtyAndAcctId>
                <Acct>
                    <Othr>
                        <Id>{{account_number}}</Id>
                        <SchmeNm>
                            <Cd>{{scheme_name_cd}}</Cd>
                        </SchmeNm>
                    </Othr>
                </Acct>
            </OrgnlPtyAndAcctId>
        </Rpt>
    </hdr:IdVrfctnRpt>
</hdr:Message>
