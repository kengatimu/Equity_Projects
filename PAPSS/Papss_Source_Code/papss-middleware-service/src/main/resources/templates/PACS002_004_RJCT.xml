            <OrgnlMsgNmId>pacs.004.001.07</OrgnlMsgNmId>
            <GrpSts>{{grp_sts}}</GrpSts>
            <StsRsnInf>
                <Orgtr>
                    <Id>
                        <OrgId>
                            <Othr>
                                <Id>{{dbtr_memberId}}</Id>
                            </Othr>
                        </OrgId>
                    </Id>
                </Orgtr>
