<?xml version="1.0" encoding="utf-8"?>
<hdr:Message xmlns:hdr="urn:montran:message.01">
    <hdr:AppHdr xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.01">
        <Fr>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </Fr>
        <To>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{toClearingSystemId}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </To>
        <BizMsgIdr>{{messageId}}</BizMsgIdr>
        <MsgDefIdr>camt.029.001.07</MsgDefIdr>
        <BizSvc>RTP</BizSvc>
        <CreDt>{{creationDateTime}}</CreDt>
    </hdr:AppHdr>

    <hdr:RsltnOfInvstgtn xmlns="urn:iso:std:iso:20022:tech:xsd:camt.029.001.07">
        <Assgnmt>
            <Id>{{messageId}}</Id>
            <Assgnr>
                <Agt>
                    <FinInstnId>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>{{sender_papss_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgnr>
            <Assgne>
                <Agt>
                    <FinInstnId>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>{{toClearingSystemId}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgne>
            <CreDtTm>{{creationDateTime}}</CreDtTm>
        </Assgnmt>
        <Sts>
            <Conf>RJCR</Conf>
        </Sts>
        <CxlDtls>
            <TxInfAndSts>
                <CxlStsId>{{messageId}}</CxlStsId>
                <OrgnlGrpInf>
                    <OrgnlMsgId>{{original_message_id}}</OrgnlMsgId>
                    <OrgnlMsgNmId>pacs.008.001.07</OrgnlMsgNmId>
                </OrgnlGrpInf>
                <OrgnlEndToEndId>{{original_end_to_end_ref}}</OrgnlEndToEndId>
                <OrgnlTxId>{{original_message_id}}</OrgnlTxId>
                <CxlStsRsnInf>
                    <Orgtr>
                        <Id>
                            <OrgId>
                                <Othr>
                                    <Id>{{sender_papss_id}}</Id>
                                </Othr>
                            </OrgId>
                        </Id>
                    </Orgtr>
                    <Rsn>
                        <Cd>{{reasonCode}}</Cd>
                    </Rsn>
                </CxlStsRsnInf>
                <OrgnlTxRef>
                    <IntrBkSttlmAmt Ccy="{{sender_currency}}">{{sender_amount}}</IntrBkSttlmAmt>
                    <Amt>
                        <InstdAmt Ccy="{{receiver_currency}}">{{receiver_amount}}</InstdAmt>
                    </Amt>
                    <IntrBkSttlmDt>{{transactionDate}}</IntrBkSttlmDt>
                    <PmtTpInf>
                        <SvcLvl>
                            <Prtry>INST</Prtry>
                        </SvcLvl>
                        <LclInstrm>
                            <Cd>{{settlementType}}</Cd>
                        </LclInstrm>
                        <CtgyPurp>
                            <Cd>SUPP</Cd>
                        </CtgyPurp>
                    </PmtTpInf>
                    <RmtInf>
                        <Ustrd>{{narration}}</Ustrd>
                    </RmtInf>
                    <Dbtr>
                        <Nm>{{receiver_account_name}}</Nm>
                        <PstlAdr>
                            <Ctry>{{receiver_country_code}}</Ctry>
                            <AdrLine>{{receiver_address}}</AdrLine>
                        </PstlAdr>
                    </Dbtr>
                    <DbtrAcct>
                        <Id>
                            <Othr>
                                <Id>{{receiver_account_number}}</Id>
                                <SchmeNm>
                                    <Cd>{{iban}}</Cd>
                                </SchmeNm>
                            </Othr>
                        </Id>
                    </DbtrAcct>
                    <DbtrAgt>
                        <FinInstnId>
                            <ClrSysMmbId>
                                <ClrSysId>
                                    <Prtry>PAPSS</Prtry>
                                </ClrSysId>
                                <MmbId>{{receiver_papss_id}}</MmbId>
                            </ClrSysMmbId>
                        </FinInstnId>
                    </DbtrAgt>
                    <CdtrAgt>
                        <FinInstnId>
                            <BICFI>{{sender_bank_scheme}}</BICFI>
                            <ClrSysMmbId>
                                <ClrSysId>
                                    <Prtry>PAPSS</Prtry>
                                </ClrSysId>
                                <MmbId>{{sender_papss_id}}</MmbId>
                            </ClrSysMmbId>
                        </FinInstnId>
                    </CdtrAgt>
                    <Cdtr>
                        <Nm>{{sender_account_name}}</Nm>
                        <PstlAdr>
                            <Ctry>{{sender_country_code}}</Ctry>
                            <AdrLine>{{sender_address}}</AdrLine>
                        </PstlAdr>
                    </Cdtr>
                    <CdtrAcct>
                        <Id>
                            <Othr>
                                <Id>{{sender_account_number}}</Id>
                                <SchmeNm>
                                    <Cd>{{iban}}</Cd>
                                </SchmeNm>
                            </Othr>
                        </Id>
                    </CdtrAcct>
                </OrgnlTxRef>
            </TxInfAndSts>
        </CxlDtls>
    </hdr:RsltnOfInvstgtn>
</hdr:Message>
