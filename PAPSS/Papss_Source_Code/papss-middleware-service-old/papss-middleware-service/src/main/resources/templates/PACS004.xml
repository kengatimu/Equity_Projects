<env:Message xmlns:env="urn:montran:message.01">
    <env:AppHdr xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.01">
        <Fr>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </Fr>
        <To>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{toClearingSystemId}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </To>
        <BizMsgIdr>{{messageId}}</BizMsgIdr>
        <MsgDefIdr>pacs.004.001.07</MsgDefIdr>
        <BizSvc>RTP</BizSvc>
        <CreDt>{{creationDateTime}}</CreDt>
    </env:AppHdr>
    <env:PmtRtr xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.004.001.07">
        <GrpHdr>
            <MsgId>{{messageId}}</MsgId>
            <CreDtTm>{{creationDateTime}}</CreDtTm>
            <NbOfTxs>1</NbOfTxs>
            <TtlRtrdIntrBkSttlmAmt Ccy="{{sender_currency}}">{{sender_amount}}</TtlRtrdIntrBkSttlmAmt>
            <IntrBkSttlmDt>{{interbankSttlmtDate}}</IntrBkSttlmDt>
            <SttlmInf>
                <SttlmMtd>CLRG</SttlmMtd>
                <ClrSys>
                    <Prtry>PAPSS</Prtry>
                </ClrSys>
            </SttlmInf>
            <InstgAgt>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </InstgAgt>
        </GrpHdr>
        <TxInf>
            <RtrId>{{messageId}}</RtrId>
            <OrgnlGrpInf>
                <OrgnlMsgId>{{original_messageId}}</OrgnlMsgId>
                <OrgnlMsgNmId>pacs.004.001.07</OrgnlMsgNmId>
            </OrgnlGrpInf>

            <OrgnlEndToEndId>{{original_end_to_end_ref}}</OrgnlEndToEndId>
            <OrgnlTxId>{{original_messageId}}</OrgnlTxId>
            <OrgnlIntrBkSttlmAmt Ccy="{{receiver_currency}}">{{receiver_amount}}</OrgnlIntrBkSttlmAmt>
            <RtrdIntrBkSttlmAmt Ccy="{{sender_currency}}">{{sender_amount}}</RtrdIntrBkSttlmAmt>
            <RtrdInstdAmt Ccy="{{sender_currency}}">{{sender_amount}}</RtrdInstdAmt>
            <XchgRate>1</XchgRate>
            <ChrgBr>SLEV</ChrgBr>
            <RtrRsnInf>
                <Orgtr>
                    <Id>
                        <OrgId>
                            <Othr>
                                <Id>{{sender_papss_id}}</Id>
                                <SchmeNm>
                                    <Prtry>PAPSS</Prtry>
                                </SchmeNm>
                            </Othr>
                        </OrgId>
                    </Id>
                </Orgtr>
                <Rsn>
                    <Cd>{{return_reason_code}}</Cd>
                </Rsn>
            </RtrRsnInf>
            <OrgnlTxRef>
                <IntrBkSttlmDt>{{creationDateSimple}}</IntrBkSttlmDt>

                <PmtTpInf>
                    <SvcLvl>
                        <Prtry>INST</Prtry>
                    </SvcLvl>
                    <LclInstrm>
                        <Cd>{{instrm_type}}</Cd>
                    </LclInstrm>

                </PmtTpInf>
                <RmtInf>
                    <Ustrd>{{narration}}</Ustrd>
                </RmtInf>

                <Dbtr>
                    <Nm>{{receiver_account_name}}</Nm>
                    <PstlAdr>
                        <Ctry>{{receiver_country}}</Ctry>
                        <AdrLine>{{receiver_address}}</AdrLine>
                    </PstlAdr>
                </Dbtr>
                <DbtrAcct>
                    <Id>
                        <Othr>
                            <Id>{{receiver_account_number}}</Id>
                            <SchmeNm>
                                <Cd>BBAN</Cd>
                            </SchmeNm>
                        </Othr>
                    </Id>
                </DbtrAcct>
                <DbtrAgt>
                    <FinInstnId>
                        <BICFI>{{receiver_bic_id}}</BICFI>
                        <ClrSysMmbId>
                            <MmbId>{{receiver_papss_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </DbtrAgt>
                <CdtrAgt>
                    <FinInstnId>
                        <BICFI>{{sender_bic_id}}</BICFI>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>{{sender_papss_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </CdtrAgt>
                <Cdtr>
                    <Nm>{{sender_account_name}}</Nm>
                    <PstlAdr>
                        <Ctry>{{sender_country}}</Ctry>
                        <AdrLine>{{sender_address}}</AdrLine>
                    </PstlAdr>
                </Cdtr>
                <CdtrAcct>
                    <Id>
                        <Othr>
                            <Id>{{sender_account_number}}</Id>
                            <SchmeNm>
                                <Cd>BBAN</Cd>
                            </SchmeNm>
                        </Othr>
                    </Id>
                </CdtrAcct>

            </OrgnlTxRef>
        </TxInf>
        <SplmtryData>
            <Envlp>
                <AuditInfo>{{audit_info}}</AuditInfo>
                <Sender>
                    <Rate>{{sender_rate}}</Rate>
                    <Amt Ccy="{{sender_currency}}">{{sender_amount}}</Amt>
                    <SttAmt Ccy="{{sender_settlement_currency}}">{{sender_settlement_amount}}</SttAmt>
                </Sender>
                <Receiver>
                    <Rate>{{receiver_rate}}</Rate>
                    <Amt Ccy="{{receiver_currency}}">{{receiver_amount}}</Amt>
                    <SttAmt Ccy="{{receiver_settlement_currency}}">{{receiver_settlement_amount}}</SttAmt>
                </Receiver>
            </Envlp>
        </SplmtryData>
    </env:PmtRtr>
</env:Message>
