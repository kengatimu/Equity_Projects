<?xml version="1.0" encoding="UTF-8"?>
<!-- Montran Corporation 2016 - RP -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:com.montran:rtp:sttlm.01"
           xmlns="urn:com.montran:rtp:sttlm.01"
           elementFormDefault="qualified">

    <xs:element name="Document" type="DocumentType"/>

    <xs:complexType name="DocumentType">
        <xs:sequence>
            <xs:element name="settlement" type="SettlementType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SettlementType">
        <xs:sequence>
            <xs:element name="nsi" type="NetSettlementType"/>
        </xs:sequence>
        <xs:attribute name="reference" type="ReferenceType" use="required"/>
        <xs:attribute name="spaceSequence" type="SequenceType"/>
    </xs:complexType>

    <xs:complexType name="NetSettlementType">
        <xs:sequence>
            <xs:element name="nsi-part" type="NetSettlementInstruction" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="totalDebit" type="AmountType" use="required"/>
        <xs:attribute name="totalCredit" type="AmountType" use="required"/>
        <xs:attribute name="ccy" type="CurrencyType" use="required"/>
        <xs:attribute name="reversedPosting" type="xs:boolean" use="required"/>
    </xs:complexType>

    <xs:complexType name="NetSettlementInstruction">
        <xs:attribute name="accountId" type="AccountType" use="required"/>
        <xs:attribute name="amount" type="AmountType" use="required"/>
    </xs:complexType>

    <xs:simpleType name="AccountType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="34"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AmountType">
        <xs:restriction base="xs:decimal">
            <xs:fractionDigits value="2"/>
            <xs:totalDigits value="17"/>
            <xs:maxInclusive value="999999999999999.99"/>
            <xs:pattern value="[\-]{0,1}[0-9]{0,15}([\.]([0-9]{0,2})){0,1}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CurrencyType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3,3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ReferenceType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="16"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SequenceType">
        <xs:restriction base="xs:integer">

        </xs:restriction>
    </xs:simpleType>

</xs:schema>