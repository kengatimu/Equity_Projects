<hdr:Message xmlns:hdr="urn:montran:message.01">
    <hdr:AppHdr xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.01">
        <Fr>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </Fr>
        <To>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{toClearingSystemId}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </To>
        <BizMsgIdr>{{messageId}}</BizMsgIdr>
        <MsgDefIdr>pacs.009.001.07</MsgDefIdr>
        <BizSvc>RTP</BizSvc>
        <CreDt>{{creationDateTime}}</CreDt>
    </hdr:AppHdr>
    <hdr:FICdtTrf xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.009.001.07">
        <GrpHdr>
            <MsgId>{{messageId}}</MsgId>
            <CreDtTm>{{creationDateTime}}</CreDtTm>
            <NbOfTxs>1</NbOfTxs>
            <TtlIntrBkSttlmAmt Ccy="{{sender_currency}}">{{sender_amount}}</TtlIntrBkSttlmAmt>
            <IntrBkSttlmDt>{{creationDateSimple}}</IntrBkSttlmDt>
            <SttlmInf>
                <SttlmMtd>CLRG</SttlmMtd>
                <ClrSys>
                    <Prtry>PAPSS</Prtry>
                </ClrSys>
            </SttlmInf>
            <PmtTpInf>
                <SvcLvl>
                    <Cd>INST</Cd>
                </SvcLvl>
                <LclInstrm>
                    <Cd>{{instrm_type}}</Cd>
                </LclInstrm>
                <CtgyPurp>
                    <Cd>{{ctgy_purp}}</Cd>
                </CtgyPurp>
            </PmtTpInf>
            <InstgAgt>
                <FinInstnId>
                    <BICFI>{{sender_bic_id}}</BICFI>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </InstgAgt>
        </GrpHdr>
        <CdtTrfTxInf> 
            <PmtId>
                <InstrId>{{messageId}}</InstrId>
                <EndToEndId>{{end_to_end_ref}}</EndToEndId>
                <TxId>{{messageId}}</TxId>
            </PmtId>
            <IntrBkSttlmAmt Ccy="{{sender_currency}}">{{sender_amount}}</IntrBkSttlmAmt>
            <Dbtr>
                <FinInstnId>
                    <BICFI>{{sender_bic_id}}</BICFI>
                    <ClrSysMmbId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
                <BrnchId>
                    <PstlAdr>
                        <Ctry>{{sender_country}}</Ctry>
                        <AdrLine>{{sender_address}}</AdrLine>
                    </PstlAdr>
                </BrnchId>
            </Dbtr>

            <Cdtr>
                <FinInstnId>
                    <BICFI>{{receiver_bic_id}}</BICFI>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{receiver_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
                <BrnchId>
                    <PstlAdr>
                        <Ctry>{{receiver_country}}</Ctry>
                        <AdrLine>{{receiver_address}}</AdrLine>
                    </PstlAdr>
                </BrnchId>
            </Cdtr>
            <RmtInf>
                <Ustrd>{{narration}}</Ustrd>
            </RmtInf>
            <SplmtryData>
                <Envlp>
                    <InstdAmt Ccy="{{receiver_currency}}">{{receiver_amount}}</InstdAmt>
                </Envlp>
            </SplmtryData>
        </CdtTrfTxInf>
        <SplmtryData>
            <Envlp>
                <AuditInfo>
                    <IP>8.8.8.9</IP>
                    <PC>google</PC>
                </AuditInfo>
            </Envlp>
        </SplmtryData>
    </hdr:FICdtTrf>
</hdr:Message>
