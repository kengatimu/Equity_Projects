<?xml version="1.0" encoding="UTF-8"?>
<env:Message xmlns:env="urn:montran:message.01">
    <env:AppHdr xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.01">
        <Fr>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>{{sender_papss_id}}</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </Fr>
        <To>
            <FIId>
                <FinInstnId>
                    <ClrSysMmbId>
                        <ClrSysId>
                            <Prtry>PAPSS</Prtry>
                        </ClrSysId>
                        <MmbId>XA0001</MmbId>
                    </ClrSysMmbId>
                </FinInstnId>
            </FIId>
        </To>
        <BizMsgIdr>{{message_id}}</BizMsgIdr>
        <MsgDefIdr>camt.007.002.03</MsgDefIdr>
        <BizSvc>RTP</BizSvc>
        <CreDt>{{creation_date}}</CreDt>
    </env:AppHdr>
    <env:ReqToModfyPmt xmlns="urn:iso:std:iso:20022:tech:xsd:camt.007.002.03">
        <Assgnmt>
            <Id>{{message_id}}</Id>
            <Assgnr>
                <Agt>
                    <FinInstnId>
                        <BIC>{{sender_bic}}</BIC>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>{{sender_papss_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgnr>
            <Assgne>
                <Agt>
                    <FinInstnId>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>XA0001</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Assgne>
            <CreDtTm>{{assignment_date}}</CreDtTm>
        </Assgnmt>
        <Case>
            <Id>{{message_id}}</Id>
            <Cretr>
                <Agt>
                    <FinInstnId>
                        <BIC>{{sender_bic}}</BIC>
                        <ClrSysMmbId>
                            <ClrSysId>
                                <Prtry>PAPSS</Prtry>
                            </ClrSysId>
                            <MmbId>{{sender_papss_id}}</MmbId>
                        </ClrSysMmbId>
                    </FinInstnId>
                </Agt>
            </Cretr>
        </Case>
        <Undrlyg>
            <IntrBk>
                <OrgnlGrpInf>
                    <OrgnlMsgId>M{{original_message_id}}</OrgnlMsgId>
                    <OrgnlMsgNmId>pacs.008.001.07</OrgnlMsgNmId>
                </OrgnlGrpInf>
                <OrgnlInstrId>{{original_end_to_end_id}}</OrgnlInstrId>
                <OrgnlEndToEndId>{{original_end_to_end_id}}</OrgnlEndToEndId>
                <OrgnlTxId>{{original_end_to_end_id}}</OrgnlTxId>
                <OrgnlIntrBkSttlmAmt Ccy="{{currency}}">{{amount}}</OrgnlIntrBkSttlmAmt>
                <OrgnlIntrBkSttlmDt>{{settlement_date}}</OrgnlIntrBkSttlmDt>
            </IntrBk>
        </Undrlyg>
        <Mod>
            <InstrForDbtrAgt>{{mod_instruction}}</InstrForDbtrAgt><!--POSTPONED, STOPPED-->
        </Mod>
    </env:ReqToModfyPmt>
</env:Message>
