<?xml version="1.0" encoding="UTF-8"?>
<transaction-manager-states>
    <!-- The initial state now points to our new metrics participant state -->
    <state name="initial" next="start-metrics"/>

    <!-- This new state is the first step, capturing the start of the transaction -->
    <state name="start-metrics" participant="com.equitybank.gag.papss.ots.jpos.jolokia.MetricsParticipant" next="validate"/>

    <!-- The rest of your transaction flow remains the same -->
    <state name="validate" participant="ValidationParticipant" next="persist-initial"/>
    <state name="persist-initial" participant="InitialTransactionPersistenceParticipant" next="build-finacle-iso"/>
    <state name="build-finacle-iso" participant="ISO8583MessageBuilderParticipant" next="send-to-finacle"/>
    <state name="send-to-finacle" participant="SendToFinacleParticipant" next="process-finacle-response"/>
    <state name="process-finacle-response" participant="ProcessFinacleResponseParticipant" next="build-papss-iso20022"/>
    <state name="build-papss-iso20022" participant="ISO20022MessageBuilderParticipant" next="sign-papss-iso20022"/>
    <state name="sign-papss-iso20022" participant="ISO20022MessageSigningParticipant" next="send-to-papss"/>
    <state name="send-to-papss" participant="SendHttpMessagesParticipant" next="process-papss-response"/>
    <state name="process-papss-response" participant="ProcessHttpResponseParticipant" next="consolidate-final-status"/>
    <state name="consolidate-final-status" participant="FinalTransactionStatusConsolidatorParticipant" next="handle-errors"/>
    <state name="handle-errors" participant="TransactionErrorHandlingParticipant" next="completed"/>
    <state name="completed"/>
</transaction-manager-states>
