<?xml version="1.0" encoding="UTF-8"?>
<transaction-manager name="transaction-manager-tm-${tm.index}"
                     logger="Q2"
                     realm="papss"
                     class="org.jpos.transaction.TransactionManager">

    <property name="input-space" value="tspace:default"/>
    <property name="queue" value="transaction-manager-queue-q${tm.index}" />
    <property name="space" value="transaction-manager-queue-q${tm.index}" />
    <property name="sessions" value="10" />
    <property name="max-sessions" value="100"/>
    <property name="debug" value="true" />
    <property name="logger" value="Q2"/>

    <participant name="MetricsParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.jolokia.metrics.MetricsParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="ValidationParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.ValidationParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="InitialTransactionPersistenceParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.InitialTransactionPersistenceParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="ISO8583MessageBuilderParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.ISO8583MessageBuilderParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="SendToFinacleParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.SendToFinacleParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="ProcessFinacleResponseParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.ProcessFinacleResponseParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="ISO20022MessageBuilderParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.ISO20022MessageBuilderParticipant"
                 prepare="needsPapssProcessing"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="ISO20022MessageSigningParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.ISO20022MessageSigningParticipant"
                 prepare="needsPapssProcessing"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="SendHttpMessagesParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.SendHttpMessagesParticipant"
                 prepare="needsPapssProcessing"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="ProcessHttpResponseParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.ProcessHttpResponseParticipant"
                 prepare="needsPapssProcessing"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="FinalTransactionStatusConsolidatorParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.FinalTransactionStatusConsolidatorParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <participant name="TransactionErrorHandlingParticipant"
                 class="com.equitybank.gag.papss.ots.jpos.space.participants.TransactionErrorHandlingParticipant"
                 autoconnect="true"
                 contextRef="spring-bean-loader"/>

    <states>${q2.states.relative.path}/transaction-manager-states.xml</states>
</transaction-manager>
