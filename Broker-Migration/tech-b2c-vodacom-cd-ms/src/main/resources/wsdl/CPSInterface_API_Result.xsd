				<xs:annotation>
					<xs:documentation>Indicates the target number to be presented if money is transferred to or reversed from another customer or the organization during a transaction.
If money is not transferred during the transaction, the target number is not presented in the message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Currency" type="xs:string">
				<xs:annotation>
					<xs:documentation>Currency Type in ISO 4217</xs:documentation>
