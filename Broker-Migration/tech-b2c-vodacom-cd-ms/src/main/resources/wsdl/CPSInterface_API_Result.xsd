							<xs:complexType>
								<xs:sequence>
									<xs:element name="IdentityBundleId" type="xs:long">
										<xs:annotation>
											<xs:documentation>Bundle实例的唯一标识符</xs:documentation>
										</xs:annotation>
									</xs:element>
