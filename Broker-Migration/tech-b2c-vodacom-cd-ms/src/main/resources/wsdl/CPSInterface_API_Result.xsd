			</xs:element>
			<xs:element name="Status" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the transaction status to be presented if the status of the transaction is authorized; otherwise this field is not displayed. That value is always Pend for authorized transactions.</xs:documentation>
