	<xs:complexType name="ReverseTransactionResult">
		<xs:annotation>
			<xs:documentation>回滚指定的Transaction</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BOCompletedTime" type="xs:string">
				<xs:annotation>
					<xs:documentation>Date time of BO completed,The format is yyyyMMddHHmmss.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DebitPartyPublicName" type="xs:string">
				<xs:annotation>
					<xs:documentation>debit party's public name of the reversal transaction</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CreditPartyPublicName" type="xs:string">
				<xs:annotation>
					<xs:documentation>credit party's public name of the reversal transaction</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DebitAccountBalance" type="xs:string">
				<xs:annotation>
					<xs:documentation>Indicates the balance for the transaction account of debit party in the reversal transaction after the reversal.
The balance fields are presented in the following order and separated by vertical bars |:
Format: Account Type Alias|Currency|Current Balance|Available Balance|Unclear Balance|Reserved Balance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CreditAccountBalance" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the balance for the transaction account of credit party in the reversal transaction after the reversal.
The balance fields are presented in the following order and separated by vertical bars |:
Format: Account Type Alias|Currency|Current Balance|Available Balance|Unclear Balance|Reserved Balance.

only returned if the reversal is initiated from a SP operator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransCompletedTime" type="common:DateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date time recorded in system when the transaction was completed.
The format is YYYYMMDDhhmmss.
If approval is required, the field will not appear</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Amount" type="xs:string">
				<xs:annotation>
					<xs:documentation>Indicates the amount of the primary transaction.
Decimal included if there is.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Charge" type="xs:string">
				<xs:annotation>
					<xs:documentation>Indicate the charge for the transaction reversal. If there is no charge for the reversal this field will be either 0.00 or is empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReceiptNumber" type="xs:string">
				<xs:annotation>
					<xs:documentation>receipt number of the reversing transaction</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransactionStatus" type="xs:string">
				<xs:annotation>
					<xs:documentation>status of the reversing transaction.
If maker-checker flow is required for the reversing, the status will be 'Pending Authorization'</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OriginalAmount" type="xs:string">
				<xs:annotation>
					<xs:documentation>amount of the transaction reversed</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OriginalReceiptNumber" type="xs:string">
				<xs:annotation>
					<xs:documentation>receipt number of the transaction reversed</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
