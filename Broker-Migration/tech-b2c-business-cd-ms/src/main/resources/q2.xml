<q2>
    <!-- MUX Server Configuration -->
    <service name="dr-mux">
        <class>org.jpos.iso.MUXServer</class>
        <property name="mux" value="mux"/>
        <property name="port" value="3008"/>
        <property name="packager" value="com.equitybank.gag.telco_b2c.ISO8583.configs.FinaclePackager"/>
    </service>

    <!-- Keep-Alive Service -->
    <service name="keep-alive-service">
        <class>org.jpos.iso.ISOChannel</class>
        <property name="host" value="10.17.1.46"/>
        <property name="port" value="45000"/>
        <property name="packager" value="com.equitybank.gag.telco_b2c.ISO8583.configs.FinaclePackager"/>
        <property name="interval" value="60000"/> <!-- Keep-alive every 1 minute -->
    </service>
</q2>
