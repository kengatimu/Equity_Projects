function checkValidPhoneNo(obj)
{
	if (((billerId=="2587")||(billerId=="1225")||(billerId=="1226")) && (profileId = '56'))
	{
		var val =document.forms[0].name.value;
		if ((val.length > 10)||(val.length<10))
		{
			alert ("Max/min length for Phone no. is 10");
			//ObjForm.name.value
			document.forms[0].name.focus()
			document.forms[0].name.value = ""
			return false
		}

		var invalidChars = "abcdefghijklmnopqrstuvwxyz~`!@#$%^*+=|?;:'\"{},_[]{}";
        var str = obj.value;
        for (i = 0; i < str.length; i++)
        {
                if (invalidChars.indexOf(str.charAt(i)) != -1)
                {
                        alert("Enter a Valid Phone. No.");
                        document.forms[0].name.focus()
                        document.forms[0].name.value = ""
                        return false
                }
        }
	}
}
