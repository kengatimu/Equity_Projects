function cddum_det_ONCLICK1(obj,p1)
{
  
var retVal = "";
if (pre_ONCLICK('cddum_crit',obj) == false) { 
        return false;
    }
    if ((retVal = fnValAndSubmit(p1)) == false) {
        return false;
    }
    if (post_ONCLICK('cddum_crit',obj) == false) { 
        return false;
    }
    return (retVal == undefined) ? true : retVal;


}
