var delCallRecord = "";
function addCustomDetRow2(arrObj)
{
                    
	var iRecNum = arrObj[0]; // Record Number
	var bIsCurrRec = arrObj[1]; //
	var locStyle = "";
	if(arrObj[2] != "")
	{
		if(delCallRecord == "")
		{
			delCallRecord = delCallRecord + arrObj[9];
		}
		else
		{
			delCallRecord = delCallRecord + "~" + arrObj[9];
		}
	}
	if( bIsCurrRec == 'Y')
	{
	locStyle = 'class="searclist1arow"';
	}
	else
	{
		if(iRecNum % 2 == 0)
		{
			locStyle = 'class="searclist1a"';
		}
		else
		{
			locStyle = 'class="searclist2a"';
		}
	}
	with(document)
	{
		write('<tr ' + locStyle + 'class="ctext">');
		write('<td align="left">'+jsUtil.encodeChar(arrObj[2]) + '&nbsp;</td>');
		write('<td align="left">'+jsUtil.encodeChar(arrObj[3]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[4]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[5]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[6]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[7]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[8]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[9]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[10]) + '&nbsp;</td>'); 
		write('<td align="left">'+jsUtil.encodeChar(arrObj[11]) + '&nbsp;</td>'); 
		write('<td class="leftscroll">&nbsp;</td>');
		write('</tr>');
	}
}

