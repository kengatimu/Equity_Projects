function fnd2CrAmtOnChange()
{
	if (document.forms[0].d2CrAmt.value != "")
	{
		if (!fnValidateAmount(document.forms[0].d2CrAmt.value,2))
		{
			document.forms[0].d2CrAmt.focus();
			return false;
		}
		if (parseFloat(document.forms[0].d2CrAmt.value) == 0)
		{
			alert("Enter amount value grater than zero.");
			document.forms[0].d2CrAmt.value="";
			document.forms[0].d2CrAmt.focus();
			return false;
		}
		var amtInFloat =parseFloat(document.forms[0].d2CrAmt.value);
		amtInFloat = amtInFloat.toFixed(2);
		document.forms[0].d2CrAmt.value = amtInFloat;
	}
	return true;
}

