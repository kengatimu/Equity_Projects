########################################################################
#							dn.scr
########################################################################
#
#
# This script sets the values of fields obtained from JSP into environment
# variables so that they are accessible to the COM script. The user hook
# urhk_putEnvForCallShellScript(<"name|value">) is used to add the
# variables to environment and urhk_CallShellScript("<F/B>") is used to 
# execute the shell script.
#
########################################################################
#
#
#
#
#
<--start
trace on

#----------------------------------------------------------
# The com script name and the arguments (if any) must be
# set in the BANCS.INPARAM.scriptName and BANCS.INPARAM.arguments
# respectively. If no arguments are passed then the 
# BANCS.INPARAM.arguments = "" has to be used
#----------------------------------------------------------

BANCS.INPARAM.scriptName = "dn.com"
BANCS.INPARAM.arguments = ""
BANCS.OUTPUT.successOrFailure = "S"

#----------------------------------------------------------
# Check if the field is populated with value. if not then
# populate it with a 'space'
#----------------------------------------------------------
if(BANCS.INPUT.solId=="") then
	sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
	sv_a = BANCS.INPUT.solId
	sv_v = urhk_B2k_valSolId(sv_a)
    if(sv_v != 0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid SOL ID"
    else
        BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "solIdError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "SolId" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.reportTo=="") then
    sv_a = " "
else
    sv_a = BANCS.INPUT.reportTo
endif
sv_t = "ReportTo" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.custId=="") then
    sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
    sv_a = BANCS.INPUT.custId
	sv_b = "Count|select count(CUST_ID) from CMG where trim(CUST_ID) = trim('"+BANCS.INPUT.custId+"') and del_flg != 'Y'"
    sv_v = urhk_dbselect(sv_b)
    if(BANCS.OUTPARAM.Count==0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid CustId"
    else
            BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "custIdError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "CustId" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.crncyCode=="") then
    sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
    sv_a = BANCS.INPUT.crncyCode
	sv_v = urhk_B2k_valCrncy(sv_a)
    if(sv_v != 0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid Currency"
    else
            BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "crncyCodeError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "CrncyCode" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.depositType=="") then
    sv_a = " "
else
    sv_a = BANCS.INPUT.depositType
endif
sv_t = "DepositType" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.schmCode=="") then
    sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
    sv_a = BANCS.INPUT.schmCode
    sv_b = "Count|select count(SCHM_CODE) from GSP where trim(SCHM_CODE) = trim('"+BANCS.INPUT.schmCode+"') and del_flg != 'Y'"
    sv_v = urhk_dbselect(sv_b)
    if(BANCS.OUTPARAM.Count==0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid SchmCode"
    else
            BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "schmCodeError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "SchmCode" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.glSubHeadCode=="") then
    sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
    sv_a = BANCS.INPUT.glSubHeadCode
	sv_b = "Count|select count(GL_SUB_HEAD_CODE) from GSH where trim(GL_SUB_HEAD_CODE) = trim('"+BANCS.INPUT.glSubHeadCode+"') and del_flg != 'Y'"
    sv_v = urhk_dbselect(sv_b)
    if(BANCS.OUTPARAM.Count==0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid GlSubHeadCode"
    else
            BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "glSubHeadCodeError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "GlSubHeadCode" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.fromAcRange=="") then
    sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
    sv_a = BANCS.INPUT.fromAcRange
	sv_v = urhk_valAcctNumber(sv_a)
    if(sv_v != 0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid From Account Range"
    else
            BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "fromAcRangeError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "FromAcRange" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.toAcRange=="") then
    sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
    sv_a = BANCS.INPUT.toAcRange
	sv_v = urhk_valAcctNumber(sv_a)
    if(sv_v != 0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid To Account Range"
    else
            BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "toAcRangeError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "ToAcRange" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)

#--------------------------------------------------------
# Date difference from BOD date is required to be passed
# ,so get the date difference from BOD date and set it
# in to the variable. If date is not entered then set
# date difference to zero
#-------------------------------------------------------

sv_z = BANCS.INPUT.fromMatDate
if (sv_z =="") then
	sv_z = "0"
	sv_t = "FromMatDate" + "|" + sv_z
else	
	sv_b = urhk_B2k_getDateDiffFromBODDate(sv_z)
	sv_t = "FromMatDate" + "|" + BANCS.OUTPARAM.DateDiff
endif	
sv_q = urhk_putEnvForCallShellScript(sv_t) 


sv_z = BANCS.INPUT.toMatDate
if (sv_z =="") then
	sv_z = "0"
	sv_t = "ToMatDate" + "|" + sv_z
else	
	sv_b = urhk_B2k_getDateDiffFromBODDate(sv_z)
	sv_t = "ToMatDate" + "|" + BANCS.OUTPARAM.DateDiff
endif	
sv_q = urhk_putEnvForCallShellScript(sv_t)

if(BANCS.INPUT.lienAc=="") then
    sv_a = " "
else
    sv_a = BANCS.INPUT.lienAc
endif
	sv_t = "LienAc" + "|" + sv_a
	sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.safeCustody=="") then
    sv_a = " "
else
    sv_a = BANCS.INPUT.safeCustody
endif
    sv_t = "SafeCustody" + "|" + sv_a
    sv_q = urhk_putEnvForCallShellScript(sv_t)


if(BANCS.INPUT.autoRenew=="") then
    sv_a = " "
else
    sv_a = BANCS.INPUT.autoRenew
endif
    sv_t = "AutoRenew" + "|" + sv_a
    sv_q = urhk_putEnvForCallShellScript(sv_t)

if(BANCS.INPUT.principalCust=="") then
    sv_a = " "
else
    sv_a = BANCS.INPUT.principalCust
endif
    sv_t = "PricipalCust" + "|" + sv_a
    sv_q = urhk_putEnvForCallShellScript(sv_t)

if(BANCS.INPUT.mrtFileName=="") then
    sv_a = " "
	BANCS.OUTPUT.errorMessage = " "
else
    sv_a = BANCS.INPUT.mrtFileName
	sv_b = "Count|select count(OPTION_VALUE) from ROT where trim(OPTION_VALUE) = trim('"+BANCS.INPUT.mrtFileName+"') and OPTION_CODE = 'DUE_NOTICE_TRN_RPT' and del_flg != 'Y'"
    sv_v = urhk_dbselect(sv_b)
    if(BANCS.OUTPARAM.Count==0) then
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.errorMessage = "Invalid MrtFile Name"
    else
            BANCS.OUTPUT.errorMessage = " "
    endif
endif
sv_s = BANCS.OUTPUT.errorMessage
sv_w = "mrtFileNameError" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
sv_t = "MrtFileName" + "|" + sv_a
sv_q = urhk_putEnvForCallShellScript(sv_t)


#------------------------------------------------------
# The COM script is called here. The user hook accepts
# only foreground or background as parameter i.e F or B.
# If a blank (i.e "") is passed, then by default the
# COM script will be executed in BACKGROUND
#------------------------------------------------------

if(BANCS.OUTPUT.successOrFailure=="S") then
	sv_b = urhk_CallShellScript("B")
else
	BANCS.OUTPARAM.successOrFailure = "F"
endif

#----------------------------------------------------
# Check if the script has executed successfully
# and send the successorFailure message back
# to the frontend
#-----------------------------------------------------
sv_s = BANCS.OUTPARAM.successOrFailure
sv_w = "custValues" + "|" + sv_s
sv_z = urhk_SetOrbOut(sv_w)
trace off
exitscript
end-->
