                    return false;
                }
                if(document.forms[0].agentname.value =="")
                {
                    alert("Enter a value in the field");
                    document.forms[0].agentname.focus();
                    return false;
                }
                if(document.forms[0].agentshortname.value =="")
                {
                    alert("Enter a value in the field");
                    document.forms[0].agentshortname.focus();
                    return false;
                }

                if(document.forms[0].agentaddr1.value =="")
                {
                    alert("Enter a value in the field");
                    document.forms[0].agentaddr1.focus();
                    return false;
                }
		if (document.forms[0].agentaddr2.value == "") {
			alert("Enter Agents KRA pin");
			document.forms[0].agentaddr2.focus();
			return false;
		}
		if (!isValid(document.forms[0].agentaddr2.value)) {
			alert("Enter Valid Agents KRA pin..");
			document.forms[0].agentaddr2.focus();
			return false;
		}
		if (document.forms[0].agentaddr3.value == "") {
			alert("Enter Valid Agent Email Address");
			document.forms[0].agentaddr3.focus();
			return false;
		}

                if(document.forms[0].agentcitycode.value =="")
                {
                    alert("Enter a value in the field");
                    document.forms[0].agentcitycode.focus();
                    return false;
                }
		if(document.forms[0].operacctnum.value =="")
                {
                    alert("Enter a value in the field");
                    document.forms[0].operacctnum.focus();
                    return false;
                }
                if(document.forms[0].inoperacctnum.value =="")
                {
                    alert("Enter a value in the field");
                    document.forms[0].inoperacctnum.focus();
                    return false;
                }
		if(document.forms[0].itaxpcnt.value !="")
		{
			var itaxpcn = document.forms[0].itaxpcnt.value;
			if((isNaN(itaxpcn)) || ((itaxpcn) < 0) || ((itaxpcn) >100))
			{
				alert("Enter valid taxpercent");
				document.forms[0].itaxpcnt.value ="";
				document.forms[0].itaxpcnt.focus();
				return false;
			}
		}
		if(document.forms[0].noofacctopened.value !="")
		{
			if((isNaN(document.forms[0].noofacctopened.value)) || ((document.forms[0].noofacctopened.value) < 0))
			{
				alert("Enter valid number");
				document.forms[0].noofacctopened.value ="";	
				document.forms[0].noofacctopened.focus();
				return false;
			}
		}
		var dco = document.forms[0].agentshortname.value;
		var input = "dco|" + dco;
		var outputNames = "output|outVal";
		var scrName = "b_solidcheck.scr";
		var retVal = appFnExecuteScript(input, outputNames, scrName, false);
		var retBuff = retVal.split("|");
		var output = retBuff[0];
		var value = retBuff[1];
		var c = value;
		if (c <= 0) {
			alert("Enter the correct SOL ID")
				document.forms[0].agentshortname.focus();
				return false;
			} 
			else 
			{
				//call ("b_solidcheck_update.scr")
				/*
				var dco=document.forms[0].agentshortname.value;
				var input      = "dco|"+dco;
				var outputNames    = "output|outVal";
				var scrName     =   "b_solidcheck_update.scr";
				var retVal = appFnExecuteScript(input,outputNames,scrName,false);
				var retBuff = retVal.split("|");
				var output = retBuff[0];
				var value = retBuff[1];
				var d = value;
				//alert(d);
				*/
			}
			var dco = document.forms[0].operacctnum.value;
			var input = "dco|" + dco;
			var outputNames = "output|outVal";
			var scrName = "b_acctcifid.scr";
			var retVal = appFnExecuteScript(input, outputNames, scrName, false);
			var retBuff = retVal.split("|");
			var output = retBuff[0];
			var value = retBuff[1];
			var a = value;
			//alert(a);
			//var dco = document.forms[0].agentaddr3.value;
			var dco = document.forms[0].inoperacctnum.value;
			var input = "dco|" + dco;
			var outputNames = "output|outVal";
			var scrName = "b_acctcifid.scr";
			var retVal = appFnExecuteScript(input, outputNames, scrName, false);
			var retBuff = retVal.split("|");
			var output = retBuff[0];
			var value = retBuff[1];
			var b = value;
			//alert(b);
			if (a != b) {
				alert("Commission Account does not belong to Agent..")
				return false;
			}
			if(document.forms[0].dummyintamtceiling.value != "")
			{
				var dummyintamtceiling = document.forms[0].dummyintamtceiling.value;
				dummyintamtceiling = dummyintamtceiling.replace(new RegExp(',','g'),"");
				document.forms[0].dummyintamtceiling.value = parseFloat(dummyintamtceiling,2);
			}
			if(document.forms[0].dummysecurityamt.value != "")
			{
			    var dummysecurityamt = document.forms[0].dummysecurityamt.value;
			    dummysecurityamt = dummysecurityamt.replace(new RegExp(',','g'),"");
			    document.forms[0].dummysecurityamt.value = parseFloat(dummysecurityamt,2);
			}
			if(document.forms[0].dummyexceptedcollection.value != "")
			{
			    var dummyexceptedcollection = document.forms[0].dummyexceptedcollection.value;
			    dummyexceptedcollection = dummyexceptedcollection.replace(new RegExp(',','g'),"");
			    document.forms[0].dummyexceptedcollection.value = parseFloat(dummyexceptedcollection,2);
			}		

		}
	}
}	

function isValid(str) {
        for (i = 0; i < str.length; i++) {
                var validChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
                if ((validChars.indexOf(str.charAt(i)) == -1)) {
                        return false;
                }
        }
        if (str.length != 11) {
                return false;
        }
        return true;
}
function fnValidateNumbers(objectField)
{
        var iChars = ".,-0123456789";
        for (var i = 0; i < objectField.length; i++)
        {
                if (iChars.indexOf(objectField.charAt(i)) == -1)
                {
                        return false;
                }
        }
        return true;
}

