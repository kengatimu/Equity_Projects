		{
		      document.forms[0].crncycode.value = crncyCode;
			document.forms[0].crncycode.readOnly = true;
		}
		if(ObjForm.operacctnum.value != "")
		{
			fnAcctNum(obj);
		}

	}
	return true;
}

function fnAcctNum(obj)
{
        if(obj.value != "")
        {
                fetchDesc(ObjForm.operacctnum);
        }
}
function fetchDesc(obj)
{
        if(obj.value != "")
        {
                fnCommonFetchAcctDtls(obj,'cacctName','csolId','cacctCrncyCode',true,'VALACCTID');
        }
}

function operacctnumSearcher()
{
        objForm = document.forms[0];

        if(funcCode == "M")
        {
		if(document.forms[0].operacctnum.value =="")
		{
			showAccountIdList(document.forms[0].operacctnum, document.forms[0].csolId, document.forms[0].cacctName, "F", document.forms[0].cacctCrncyCode);
		}
		else
		{
			cfnPopAccountDet();
		}
        }
}

function cfnPopAccountDet()
{
        clearDescField("cacctName","csolId","cacctCrncyCode");

        if(document.forms[0].operacctnum.value != "")
        {
                if ((a = fnCommonFetchAcctDtls(document.forms[0].operacctnum, 'cacctName', 'csolId', 'cacctCrncyCode', true,'VALACCTID')) == false)
                {
                        clearDescField("operacctnum","cacctName","csolId","cacctCrncyCode");
                        document.forms[0].operacctnum.focus();
                        return false;
                }
        }
	else
	{
		clearDescField("operacctnum","cacctName","csolId","cacctCrncyCode");
	}
        return true;
}

