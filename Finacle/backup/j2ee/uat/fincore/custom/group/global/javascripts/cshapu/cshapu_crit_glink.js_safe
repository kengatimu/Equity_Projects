function printFooterBlock()

{

    with (document) {

    if ((sReferralMode == 'I')||(sReferralMode == 'S')){

    write('<div align="left" class="ctable">');

    if (sReferralMode == 'S'){

    write('<input type="button" class="Button" id="Submit" value="'+jspResArr.get("FLT000193")+ '" onClick="javascript:return doRefSubmit(this);" hotKeyId="Submit" >');

    }

    writeRefFooter();

    write('<input type="button" class="Button" id="_BackRef_" value="'+jspResArr.get("FLT001721")+ '" onClick="javascript:return doSubmit(this.id);" hotKeyId="Cancel" >');

    write('</div>');

    }else{

    write('<div class="ctable">');

    write('<input id="Accept" name="Go" type="button" class="button"    onClick="javascript:return cshapu_crit_ONCLICK1(this,this);"" value="' + jspResArr.get("FLT004977") + '" hotKeyId="Go">');

    write('<input id="Clear" name="Clear" type="button" class="button" value="' + jspResArr.get("FLT001439") + '"   onClick="javascript:return cshapu_crit_ONCLICK2(this);"">');

    writeFooter();

    write('</div>');

    }

    } //End with()

}//End function



function fnOnLoad()



{

    var ObjForm = document.forms[0];



    //disabling the tran id field



    ObjForm.tranid.disabled=true;



    pre_ONLOAD('cshapu_crit',this);



    var funcName = "this."+"locfnOnLoad";

    if(eval(funcName) != undefined){

        eval(funcName).call(this);

    }



    fnPopulateControlValues();



    fnPopUpExceptionWindow(ObjForm.actionCode);

    if((typeof(WF_IN_PROGRESS) != "undefined") && (WF_IN_PROGRESS == "PEAS")){

        checkCustErrExecNextStep(Message);

    }



    post_ONLOAD('cshapu_crit',this);

}



function fnCheckMandatoryFields()

{

    var ObjForm = document.forms[0];



    return true;

}



function fnPopulateControlValues()

{

    var ObjForm = document.forms[0];



    ObjForm.funcCode.value = funcCode;

    ObjForm.tranType.value = tranType;

    ObjForm.cdscnumber.value = cdscnumber;

    ObjForm.ordernumber.value = ordernumber;

    ObjForm.accountnumber.value = accountnumber;

}





function cshapu_crit_ONCLICK1(obj,p1)

{

    var retVal = "";

    //do the validations to verify that the account exists

    var ObjForm = document.forms[0];



    var funcCode=ObjForm.funcCode.value;



    if(funcCode=='A')

    {

        if(fnIsNull(ObjForm.cdscnumber.value))

        {

            alert("Enter the CDSC number");

            ObjForm.cdscnumber.focus();

            return false;

        }

        if(fnIsNull(ObjForm.accountnumber.value))

        {

            alert("Enter the Account Number");

            ObjForm.accountnumber.focus();

            return false;



        }

        if(fnIsNull(ObjForm.funcCode.value))

        {

            alert("Select the function code");

            ObjForm.funcCode.focus();

            return false;

        }


        if(validateAcctNum(document.forms[0].accountnumber.value)==false)

        {

           return false;

        }
        if(CDSCexists(ObjForm.cdscnumber.value)==false)
        {
            alert("Invalid Cdsc Number");

            ObjForm.cdscnumber.value="";

            return false;

        }



    }



    if(funcCode=='I'||funcCode=='V'||funcCode=='H')

    {



        if(fnIsNull(ObjForm.tranid.value))

        {

            alert("The Tran Id can must be entered");

            ObjForm.tranid.focus();

            return false;



        }



    }







    if (preEventCall('cshapu_crit',obj,'ONCLICK') == false) {

        return false;

    }

    if ((retVal =  fnValAndSubmit(p1)) == false) {

        return false;

    }

    if (postEventCall('cshapu_crit',obj,'ONCLICK') == false) {

        return false;

    }

    return (retVal == undefined) ? true : retVal;





}



function cshapu_crit_ONCLICK2(obj)

{

    //getting the value of the funcCode

    var ObjForm = document.forms[0];



    var retVal = "";

    if (preEventCall('cshapu_crit',obj,'ONCLICK') == false) {

        return false;

    }

    if ((retVal =  fnClearFields()) == false) {

        return false;

    }

    if (postEventCall('cshapu_crit',obj,'ONCLICK') == false) {

        return false;

    }

    return (retVal == undefined) ? true : retVal;

}



function funcCodeChange()

{

    var ObjForm = document.forms[0];

    var funcCode=ObjForm.funcCode.value;

    if(funcCode=='V'||funcCode=='I'||funcCode=='H')

    {

    ObjForm.tranid.disabled=false;

    ObjForm.tranid.focus();


    //disabling some fields


    ObjForm.cdscnumber.disabled=true;

    ObjForm.tranid.disabled=true;

    ObjForm.cdscnumber2.disabled=true;

    ObjForm.cdscnumber.value="";

    ObjForm.tranType.disabled=true;

    ObjForm.tranType.value="";

    ObjForm.accountnumber.disabled=true;

    ObjForm.accountnumber.value="";



    }

    else

    {

        ObjForm.tranid.disabled=true;

        ObjForm.cdscnumber.disabled=false;

        ObjForm.cdscnumber.focus();

        ObjForm.tranType.disabled=false;

        ObjForm.accountnumber.disabled=true;



    }



}



function fnTranIDList()

{

    var inputNameValues = "Originator|OriginatorVal";

    var outputNames = "tranid|txtfldname28|txtfldname29|txtfldname30|txtfldname31";

    var scrName = "trading012.scr";

    var title = "UNVERIFIED PURCHASE TRANSACTIONS";

    var literalNames = "PURCHASE_ID|TRAN ID|TRAN AMOUNT|CREATED_BY|SOL ID";

    var hyperLnks = "1";

    var retVal = fnExecuteScriptForList(inputNameValues, outputNames, scrName, title, literalNames, hyperLnks, true);

    var retVal = "";


}



function getCdscFromId(idNumber)

{

        var id = idNumber.value;

        var inputNameValues = "idNumber" + "|" + id;

        var outputNames1 = "RESULTS";
        var scrName1 = "trading014.scr";

        var retVal = "";

        var retVal = appFnExecuteScript(inputNameValues, outputNames1, scrName1, false);
        if (retVal != "")

        {

            //alert(retVal);


            var ret1 = retVal.split("|");

            var ret2=ret1[0];

            if(ret2=="Error")

            {

               alert("There was an Error "+ret2[1]);

               return false;

            }

            else

            {

            if(ret2=="DATA")
            {
		
               /* var ret3=ret1[1].split(":");

                if(ret3[1].length==0)
                {
                    alert("The response from the server is blank");
                    return false;

                }
		*/
		var ret3=ret1[1];
                var resp=ret3;


               // var resp=resp[1];
                var idN=resp.substring(1,resp.length);

                 //If zero it does not exist
                 if(idN.length==1)
                 {

                        alert("The Id number entered does not exist 1");

                        var ObjForm = document.forms[0];
						
			ObjForm.cdscnumber.value="";

                        ObjForm.cdscnumber2.value="";

                        ObjForm.cdscnumber2.focus();

                        return false;

                  }

                  var cDetails=idN.split(":");

                  var ObjForm = document.forms[0];
			alert("ObjForm.cdscnumber.value--"+cDetails[1]);
                  ObjForm.cdscnumber.value=cDetails[1];

                  ObjForm.clientNameLabel.value=cDetails[0];

            }


            }



        }

}

function getDetailsFromCdsc(cdsc)

{
        var cid = cdsc.value;


        //Getting the full account number if the short number is input
         if(cid.length<15)
         {
            var inputNameValues = "shortNumber" + "|" + cid;
            var outputNames1 = "RESULTS";
            var scrName1 = "trading014.scr";
            var retVal = "";
            var retVal = appFnExecuteScript(inputNameValues, outputNames1, scrName1, false);

            if(retVal!=null)
            {
		alert("REsponse-->"+retVal);
		    var response=retVal.split("|");

                 if(response[0]=="Error")
                 {
                    alert("There was an error from the server"+response[1]);

                    return false;
                 }
                 if(response[0]=="DATA")
                 {
                    //parsing the response string

                    var resp=response[1].split("=");
			alert("resp-->"+resp);
                    //if The response from the server is blank

                    if(resp[1].length==0)
                    {
                        alert("The response from server was blank");
                        return false;
                    }

                    var cdscN=resp[1].substring(1,resp[1].length);
                    //alert(cdscN);
                    //If zero it does not exist
                    if(cdscN.length==1)
                    {
					
					    setNamesLabel("");

                        alert("The CDSC entered does not exist 1");

                        var ObjForm = document.forms[0];

                        ObjForm.cdscnumber.value="";
						
						ObjForm.cdscnumber2.value="";

                        ObjForm.cdscnumber.focus();

                        return false;

                    }
                    else
                    {
                        var ObjForm = document.forms[0];
			alert("CSDCNUMBER -->"+cdscN);
                        ObjForm.cdscnumber.value=cdscN;

                        //Executing script to set Names Label

                        var inputNameValues = "cdscNumber" + "|" + cdscN;

                        var outputNames1 = "RESULTS";

                        var scrName1 = "trading014.scr";

                        var retVal = "";

                        var retVal = appFnExecuteScript(inputNameValues, outputNames1, scrName1, false);



                        if(!fnIsNull(retVal))
                        {

                            var response=retVal.split("|");

                            if(response[0]=="Error")
                            {
                                alert("There was an error "+response[1]);
                                return false;
                            }
                            else
                            {

                            var response=response[1].split("=");


                            var r=response[1];

                            var res=r.substring(1,r.length);

                            var resarray=res.split(":");

                            //alert(resarray[0]);

                            //Setting the names label

                            setNamesLabel(resarray[0]);
                           }



                        }


                    }

                 }


            }



         }

         //If the full CDSC account number has been entered

         else
         {

            var inputNameValues = "cdscNumber" + "|" + cid;
            var outputNames1 = "RESULTS";
            var scrName1 = "trading014.scr";
            var retVal = "";
            var retVal = appFnExecuteScript(inputNameValues, outputNames1, scrName1, false);


            var response=retVal.split("|");

             if(response[0]=="Error")
             {
                   alert("There was an error "+response[1]);
                   return false;
             }

             var resp=response[1].split("=");

            if(!chkUndefinedElement(resp,1))
            {
                alert("The response from server is blank");
                return false;

            }

             var resp=resp[1];


             //alert(resp);


             var cdscN=resp.substring(1,resp.length);

             //alert(cdscN);

             //If zero it does not exist
             if(cdscN.length==1)
             {

                   alert("The CDSC entered does not exist 2");
                   var ObjForm = document.forms[0];
                   ObjForm.cdscnumber.value="";
                   return false;

             }


             var res=resp.substring(1,resp.length);


             var resarray=res.split(":");

             //Setting the names label

              setNamesLabel(resarray[0]);



         }


}
function setNamesLabel(nameString)
{
var ObjForm = document.forms[0];
ObjForm.clientNameLabel.value=nameString;
}
function CDSCexists(csdsNumber)
{

            var inputNameValues = "cdscNumber" + "|" + csdsNumber;
            var outputNames1 = "RESULTS";
            var scrName1 = "trading014.scr";
            var retVal = "";
            var retVal = appFnExecuteScript(inputNameValues, outputNames1, scrName1, false);

            var response=retVal.split("|");
             if(response[0]=="Error")
             {
                   alert("There was an error "+response[1]);

                   return false;
             }

             //var resp=response[1].split("=");

             var resp=response[1];

             if(resp.length==0)
             {
                alert("The CDSC entered could not be validated");

                return false;
             }


             var cdscN=resp.substring(1,resp.length);

             //alert(cdscN);

             //If zero it does not exist
             if(cdscN.length==1)
             {

                   alert("The CDSC entered does not exist 2");

                   return false;

             }

             return true;



}
function chkUndefinedElement(aElement,aIndex)
{

    if(typeof aElement[aIndex]=='undefined')
    {
       //alert("The response from server was blank");
        return false;
    }
    return true;

}
