                setFieldsToCustomData("pTranTypes", "refCrncys", "refAmts", "acctIds", "temp", "varbiotest");
            }
        }
    } else {
        return true;
    }
}

function IsNumeric(sText) {
    var ValidChars = "0123456789",
        IsNumber = true,
        Char;
    for (i = 0; i < sText.length && IsNumber == true; i++) {
        Char = sText.charAt(i);
        if (ValidChars.indexOf(Char) == -1)
            IsNumber = false;
    }
    return IsNumber;
}

