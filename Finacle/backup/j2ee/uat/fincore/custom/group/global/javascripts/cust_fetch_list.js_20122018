function printHTML()
{
	with(document)
	{
		write('<table class="ctable" align="center" border="0" cellspacing="1" cellpadding="1">');
		write('<tr><td class="page-heading" colspan="' + colsLen + '">');
		write('<b>&nbsp;' + pageTitle + '<b></td>');
		write('</tr></table>');
		
		if (!displayRecs)
		{
	
			showErrors();
		
		}
	
		else
		
		{
	
			write('<table class="tableborder" cellspacing="0" cellpadding="0" border="0" width="100%">');
			write('<tr><td>');
			write('<table class="innertable" cellspacing="0" cellpadding="0" border="0" width="100%">');
			write('<tr><td valign="top">');
			write('<table class="innertabletop1" cellspacing="0" cellpadding="0" border="0" width="100%" frame="vsides">');
			write('<tr class="rowspacing1">');
			write('<td><spacer type="block" width="1" height="1"></spacer></td>');
			write('</tr>');
			
			//Added for pagewise display
			//var isPageWiseListReq = "true";
  
			
			if(isPageWiseListReq == "true"){
				//alert(totRecs);
				write('<tr valign="middle"  class="subhdrbg">');
				write('<td align="right" valign="middle" >');
				write('<table border="0" cellpadding="0" cellspacing="0" width="100%">');
				write('<tr><td align="right">');
				//if (parseInt(pageNumber) > 1){
					write('<img type="image" src="../../Renderer/images/arrowpre.gif" alt="Previous" width="7" height="14" border="0" name = "Back"');
					write('onclick="javaScript:fnArrowClick(\'prev\');" onMouseOver="displayHand(this)"  hotKeyId="Prev"> &nbsp; &nbsp; </img>');
				//}
				if(totRecs > 0 ){
					write('<img type="image" src="../../Renderer/images/arrownext.gif" alt="Next" width="7" height="14" border="0" name = "Next"');
					write('onclick="javaScript:fnArrowClick(\'next\');" onMouseOver="displayHand(this)" hotKeyId="Next">');
				}
				write('</td></tr></table>');
				write('</td></tr>');
			}
			
			write('</table>');
			write('<table width="100%" border="0" cellpadding="0" cellspacing="0">');
			write('<tr>');
			//write('<table class="ctable" align="center" cellspacing="2" cellpadding="2" border="1">');
			/*
				Literal Names
			*/

			write('<tr>');
			for (var colCount=0; colCount<colsLen; colCount++)
			{
				write('<td class="searcheader" align=center><b>' + literalsBuff[colCount] + '</b></td>');
			}
			write('</tr>');

			if(totRecs == 0)
			{
				write('<tr>');
				write('<td colspan="' + colsLen + '" align="center">No records were fetched.</td>');
				write('</tr>');
			}
			else
			{
				showList();
			}

			
			write('</td></tr></table>');
			write('</td></tr></table>');
			write('</td>');
			
			write('</tr>');
			write('</table>');

			write('<table width = 100% border="0" cellpadding="4" cellspacing="0">');

			write('<tr>');
			write('<td>');
			write('<input class="button" type="button" name="Close" value="Close" onclick="javaScript:fnClose();"  hotKeyId="Cancel" >');
			write('</td>');
			write('</tr>');
			write('</table>');

		}
	}
}

function showList()
{
	var effColNum = 0;
	var retVal = "";
	var obj = null;
	
	for (var i=0; i<totRecs; i++)
	{

		var rem = i%2;	
		if (parseInt(rem) == 0)
			document.write('<tr  class="searclist1a">');
		else
			document.write('<tr  class="searclist2a">');

		
		retVal = getReturnValues(i);
		
		for(var j=0; j<colsLen; j++)
		{
			/*
				Column Names are starting with 1. Hence, used effColNum.
			*/
			
			effColNum = j+1;
			
			obj = eval("col" + effColNum);
					
			if (isHyperLink(effColNum))
			{
				document.write('<td align="center">');
				document.write('<font color="blue"> <u>');
				document.write('<a onclick="javaScript:fnSetValue(\'' + retVal + '\');" onmouseover="this.style.cursor=\'hand\';"');
				document.write(' onmouseout="this.style.cursor=\'default\';">' + obj[i] + '</font></u></a></td>');
			}
			else 
			{
				document.write('<td align="center">' + obj[i] + '&nbsp;</td>');
			}				
		}
		
		document.write('</tr>');			
	}
}

function getReturnValues(recNum)
{
	var str = "";
	for(var i=0; i<colsLen; i++)
	{
		str += eval("col"+(i+1) + "[" + recNum + "]");
		if (i != (colsLen-1))
			str += "|";
	}
	return str;
}

function isHyperLink(colNum)
{
	var chk = false;
	for(var i=0; i<hyperLnksLen; i++)
	{
		if (parseInt(hyperLnksBuff[i], 10) == colNum)
		{
			chk = true;
			break;
		}
	}

	return chk;
}

function fnClose()
{
	window.close();
}

function fnSetValue(str)
{
	window.returnValue = str;
	window.close();
}

function showErrors()
{
	with (document) {
		write('<table class="tableborder" cellspacing="0" cellpadding="0" border="0" width="100%">');
		write('<tr><td>');
		write('<table class="innertable" cellspacing="0" cellpadding="0" border="0" width="100%">');
		write('<tr><td valign="top">');
		write('<table class="innertabletop1" cellspacing="0" cellpadding="0" border="0" width="100%" frame="vsides">');
		write('<TR class="searcheader">');
		write('<td class="ccaption">' + finbranchResource.FLT003072 + '</td>');
		write('<td class="ccaption">' + finbranchResource.FLT000217 + '</td>');
		write('<td class="ccaption">' + finbranchResource.FLT002771 + '</td>');
		write('</tr>');
		for (var i=0; i<errCode.length; i++)
		{
		    with(document)
		    {
		    write('<tr><td align="left">&nbsp;' + errCode[i] + '</td>');
		    write('<td align="left">&nbsp;' + errType[i] + '</td>');
		    write('<td align="left">&nbsp;' + errDesc[i] + '</td></tr>');
		    }
		}

		write('<tr>');
		write('<td class="ctext" colspan="3"  align="center">');
		write('<center><font color="blue">');
		write('<a onClick=\'window.close()\' onmouseover="this.style.cursor=\'hand\'"; onmouseout="this.style.cursor=\'default\'"><b>Close<b></a>');
		write('</font></center></td>');
		write('</tr>');
		write('</table>');
		write('</td></tr></table>');
		write('</td></tr></table>');

	} //End with()
}

/*
                Function gets called on click of prev or next arrow for Page wise list display
                direction is next or prev based on the arrow, next or prev respectively.
*/

function fnArrowClick(direction)
{
                var pageNumber = "pageNumber";
                document.forms[0].target = "listWindow";
                
                var temp  = document.forms[0].inputs.value ;
                var index1 = temp.indexOf(pageNumber);
                var inputNameValues = temp.substring(0,index1+1 + pageNumber.length);       
                var queryString1 = temp.substr(index1+1 + pageNumber.length);
                var index2 = queryString1.indexOf("|");
                var pageNumber = queryString1.substring(0,index2);
                if(direction == 'next')
                                pageNumber = parseInt(pageNumber) + 1;
                else
                                pageNumber = parseInt(pageNumber) - 1;
                
                var queryString2 = pageNumber + queryString1.substr(index2);
				//alert(queryString2);

                document.forms[0].inputs.value = inputNameValues.concat(queryString2);
				//alert(document.forms[0].inputs.value);
                document.forms[0].submit();
}

function displayHand(obj){
	var browser_name = navigator.appName;
	if("Microsoft Internet Explorer" == browser_name){
		obj.style.cursor="hand";
	} else {
		obj.style.cursor="pointer";
	}
}
