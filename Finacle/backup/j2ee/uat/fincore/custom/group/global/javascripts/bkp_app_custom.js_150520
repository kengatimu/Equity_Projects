//var valMenu = new Array("HLADISB","HLAUPAY","HCLSPAY","HGCHRG","HTUTM","HDDMI","HORM","HIRM","HCAAC","HCAACTD","HCRT","HDDXMI","HTM","HCASHWD","HXFER","HCLUPAY","HOAACCA","HOAACSB","HOAACOD","HOAACCC","HOAACLA","HOAACCL","OICA","OISA","OIOA","OIFA","HOAACTD","HOAACTU","OCMIDA","OITUA","HRINBX");
/*----------------------------------------------------------------------------------------*/
