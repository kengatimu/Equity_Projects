/*---------------------------------------------------------------------
 *       Function Name   :app_pre_ONCLICK()
 *       Description     :The function is called on click
 *                        of any event.
 *       Input           :object ID
 *       Return Value    :None
 ---------------------------------------------------------------------*/
function app_pre_ONCLICK(obj) {
    var bioRet = doBioMetricVal(obj);
    //alert("bioRet : " + bioRet); 
    return bioRet;
}

/**************************************************************************************
 *       Function Name   :doBioMetricVal()
 *       Description     :The is the main function that does the biometric validation
 *       Return Value    :None
 **************************************************************************************/
function doBioMetricVal(obj) {
    var myMopId = "";
    var retVal4Menu = "";
    var retVal4Func = "";
    var retVal4Button = "";

    /**************************************************************************************
     * Fetching the menu id
     **************************************************************************************/
    if (typeof(mopId) != "undefined") {
        myMopId = mopId;
    }
    if (typeof(menuName) != "undefined") {
        myMopId = menuName;
    }
    /**************************************************************************************
     * For menus HORM/HIRM/HTM/HXFER/HCASHDEP/HCASHWD the biometric
     * validation is written in respective custom jsp
     **************************************************************************************/
    if ((myMopId == "HORM") || (myMopId == "HIRM") || (myMopId == "HTM") || (myMopId == "HXFER") || (myMopId == "HCASHDEP") || (myMopId == "HCASHWD")) {
        return true;
    }
    /**************************************************************************************
     * Checking if the menu invoked is present in valMenu. Only if the
     * mopId is present in valMenu array the biometric validation has 
     * to be executed
     **************************************************************************************/
    retVal4Menu = isBioValReq4Menu(myMopId);
    //alert("retVal4Menu : " + retVal4Menu);
    /**************************************************************************************
     * Checking if the function Code selection is mentioned in funcCodeVal
     * to see whether biometric validation needs to be done for that
     * particular function code
     **************************************************************************************/
    if (retVal4Menu == true) {
        retVal4Button = isBioValReq4Button(obj, myMopId);
    } else {
        return true;
    }
    /**************************************************************************************
     * Fetching the button id clicking in the menu and checking whether
     * the same is mentioned in buttonIDVal array. Only if it is present
     * the biometric validation needs to be executed
     **************************************************************************************/
    //alert("retVal4Button : " + retVal4Button); 
    if (retVal4Button == true) {
        /*********************************************************************************
         * The function isBioValReq4FuncCode checks whether the function code selected needs
         * to be considered for Biometric validation using the array funcCodeVal
         *********************************************************************************/
        retVal4Func = isBioValReq4FuncCode(obj, myMopId);
        //alert("retVal4Func : " + retVal4Func);
        if (retVal4Func == true) {
            /******************************************************************************
             * Thhe function getFieldforBioAndCallBio fetches the value from screen using the array
             * menuFieldMap and would do the Biometric validation
             *****************************************************************************/
            return getFieldforBioAndCallBio(myMopId);
        } else {
            return true;
        }
    }
    return true;

}
/**************************************************************************************
 *       Function Name   :isBioValReq4Menu()
 *       Description     :The function checks whether menu needs to be
 *       				  validated against biometric
 *       Return Value    :None
 **************************************************************************************/
function isBioValReq4Menu(myMopId) {
if(myMopId != "")
{    
	var input = "menuId|" + myMopId;
    var scrName = "biodp002.scr";
    var output = appFnExecuteScript(input, "", scrName, false);
    var doValidation = output.split("|");
    if (doValidation[1] == "Y") {
        return true;
    }
    return false;
}
return true;
}


/**************************************************************************************
 *       Function Name   :isBioValReq4FuncCode()
 *       Description     :The function checks whether funcCode needs to be
 *       				  validated against biometric
 *       Return Value    :None
 **************************************************************************************/
function isBioValReq4FuncCode(obj, myMopId) {
    var input = "menuId|" + myMopId;
    var scrName = "biodp004.scr";
    var output1 = appFnExecuteScript(input, "", scrName, false);
    var output = output1.split("|")[1];
    var menuFuncObjId = output.split(":")[0];
    if (menuFuncObjId != "ALL") {
        var isObjExist = document.getElementById(menuFuncObjId);
        if (isObjExist != null) {
            var funcCodeSel = document.getElementById(menuFuncObjId).value;
            var menuFuncValList = output.split(":")[1];
            var menuFuncValArr = menuFuncValList.split(",");
            var j;
            for (j = 0; j < menuFuncValArr.length; j++) {
                if (funcCodeSel == menuFuncValArr[j]) {
                    //alert("returning true from isBioValReq4FuncCode");
                    return true;
                }
            }
        }
    } else {
        //alert("returning true from isBioValReq4FuncCode");
        return true;
    }
    return false;

}

/**************************************************************************************
 *       Function Name   :isBioValReq4Button()
 *       Description     :The function checks whether button click needs to be
 *       				  validated against biometric
 *       Return Value    :None
 **************************************************************************************/
function isBioValReq4Button(obj, myMopId) {
    /**************************************************************************************
     * For menus HLASPAY/HLAUPAY/HCLSPAY/HCLUPAY/HOAACLA/HOAACCL the page name has to
     * be checked as the button id is same is both crit and det page
     **************************************************************************************/
    if ((myMopId == "HLASPAY") || (myMopId == "HLAUPAY") || (myMopId == "HCLSPAY") || (myMopId == "HCLUPAY") || (myMopId == "HOAACLA") || (myMopId == "HOAACCL")) {
        var myPageName = document.forms[0].pagename.value;
        if ((myPageName == "laupaymain") || (myPageName == "clspaymain") || (myPageName == "laspaymain") || (myPageName == "clupaymain")) {
            var input = "buttonIdDtls|" + myMopId + ":" + obj.id.toString().toUpperCase();
            var scrName = "biodp003.scr";
            var output = appFnExecuteScript(input, "", scrName, false);
            var doValidation = output.split("|");
            if (doValidation[1] == "Y") {
                //alert("returning true from isBioValReq4Button");
                return true;
            }

        }
        if ((myPageName == "laacop") || (myPageName == "clacop")) {
            var input = "buttonIdDtls|" + myMopId + ":" + obj.id.toString().toUpperCase();
            var scrName = "biodp003.scr";
            var output = appFnExecuteScript(input, "", scrName, false);
            var doValidation = output.split("|");
            if (doValidation[1] == "Y") {
                //alert("returning true from isBioValReq4Button");
                return true;
            }
        }
    } 
	else 
	{
		if(myMopId != "")
		{
				var input = "buttonIdDtls|" + myMopId + ":" + obj.id.toString().toUpperCase();
				var scrName = "biodp003.scr";
				var output = appFnExecuteScript(input, "", scrName, false);
				var doValidation = output.split("|");
				if (doValidation[1] == "Y") 
				{
					//alert("returning true from isBioValReq4Button");
					return true;
				}
		}
    }

    return false;
}


/**************************************************************************************
 *       Function Name   :getFieldforBioAndCallBio()
 *       Description     :The function decides whether biometric validation is required
 *       Input           :menu name
 *       Return Value    :None
 ***************************************************************************************/
function getFieldforBioAndCallBio(mopVal) {
    var gotBioKeyVal = "N"
    if (mopVal != "HRINBX") {
	if(mopVal != "HDPP"){
        var input = "menuId|" + mopVal;
        var scrName = "biodp005.scr";
        var output = appFnExecuteScript(input, "", scrName, false);
        var keyVal = output.split("|")[1];
        //alert(keyVal);
        var biofrmElements = document.forms[0].elements;
        var biototalElements = biofrmElements.length;
        for (i = 0; i < biototalElements; i++) {
            if (biofrmElements[i].type != 'hidden') {
                //alert("Id : " + biofrmElements[i].id );
                if (biofrmElements[i].id.toString().toUpperCase() == keyVal.toUpperCase()) {
                    gotBioKeyVal = "Y";
                    //alert("GOT IT :");
                }
            }
        }
        //alert("After Break");
        if (gotBioKeyVal == "Y") {
		    var custIdOrAcctIdVal = document.getElementById(keyVal).value;
        } else {
            return true;
        }
	}
	if(mopVal=="HDPP"){
	    //alert(mopVal);
	    var custIdOrAcctIdVal = document.getElementById("accNum").value;
		var input = "menuId|" + mopVal;
		var scrName = "biodp005.scr";
		var output = appFnExecuteScript(input, "", scrName, false);
		var keyVal = output.split("|")[1];
		//alert(keyVal);
	}
    } else {
        var custIdOrAcctIdVal = aExcpCode;
    }
    if (custIdOrAcctIdVal != "") {
        return callBiometricSys(custIdOrAcctIdVal, mopVal, keyVal);
    }
    //alert("The value is null in the field");
    return true;
}

/***************************************************************************************
 *       Function Name   : callBiometricSys()
 *       Description     : This function calls script to fetch Customer details
 *       Input           : Customer ID/Account ID and menu id
 *       Return Value    : None
 ****************************************************************************************/
function callBiometricSys(keyObj, mopVal, keyVal) {
    //alert("Value : " + document.getElementById(keyVal).value);
    var bioInput = "";
    if (mopVal == "HRINBX") {
        var custIdOrAcctId = keyObj;
    } else {
        var custIdOrAcctId = keyObj.toUpperCase();
    }
    var input = "custIdOrAcctId|" + custIdOrAcctId + "|menuId|" + mopVal;
    var scrName = "biomn001.scr";
    var output = "";
    var output = appFnExecuteScript(input, "", scrName, false);
    var outputArr = output.split("|");
//alert("outputArr "+outputArr);
    var bioDtl = outputArr[1];
    var bioArr = bioDtl.split("&");
//alert("bioArr "+bioArr);
    if ((bioArr[2] != "1") && (bioArr[2] != "NA")) {
        alert("Biometric enrollment status : " + bioArr[6]);
        setSValue("bioStatus|C");
        return true;
    }
    delSValue("bioStatus");

    if (outputArr[0] == "N") {
        var bioArrVar = bioArr[7].split(",");
        var bioArrLen = bioArrVar.length;
        var bioModeOper = bioArr[8];
        var bioExcp = "N";
        var bioSuc = 0;
        var varTrue = 0;
        var loop = 1;
        if (bioArr[1] == "U") {
            loop = bioArrLen;
        }
        while (loop <= bioArrLen) {
            var bioUrl = bioArr[0];
            var bioInput = bioArr[1] + "|" + bioArr[2] + "|" + bioArr[3] + "|" + bioArrVar[loop - 1] + "|" + bioArr[5];
            if (bioArr[1] == "U") {
                bioInput = bioArr[1] + "|" + bioArr[5] + "|" + bioArr[3] + "|0|0";
            }
            if (bioArr[2] == "NA") {
                if (bioInput != "") {
                   //alert("loop "+loop);
                   //alert("bioArrLen "+bioArrLen);
                  // alert("bioArrVar "+bioArrVar[loop-1]);
                   //alert("bioInput "+bioInput);
                    var cifcustid = bioArrVar[loop - 1]
                    //alert("cifcustid "+cifcustid);
                    if ((cifcustid != "") && (bioArrLen > 1)) {
                        var input = "cifcustid|" + cifcustid;
                        var outputNames = "output|outVal";
                        var scrName = "getcustcifname.scr";
                        var retVal = appFnExecuteScript(input, outputNames, scrName, false);
                        var retBuff = retVal.split("|");
                        var output = retBuff[0];
                        var value = retBuff[1];
                        var a = value;
                        //alert(a);
                        var namecifcustid = cifcustid + " " + a
                        alert("Bio Validation On: " + namecifcustid);
                    }
                    //var urlWithBioInp = bioUrl + bioInput;
bioUrl="../custom/BIO/BioModal.jsp";
 var urlWithBioInp = bioUrl +"?cif="+cifcustid;
                    //alert(urlWithBioInp);
                    //var bioResp = window.showModalDialog(urlWithBioInp + 'center:yes;unadorned:yes;resizable:no;dialogHeight:400px;dialogWidth:600px;scrollbars=no');
					var params = "center:yes;unadorned:yes;resizable:no;dialogHeight:400px;dialogWidth:600px;scrollbars=no";
					//alert(bioUrl);
					//var bioResp = window.showModalDialog(urlWithBioInp,"",params);
//alert(keyVal);
//alert(urlWithBioInp);

var bioResp=window.showModalDialog(urlWithBioInp,"","dialogWidth:626px;dialogHeight:626px;status:No;help:No;resizable:No;scroll:No");
//var bioResp=window.open(urlWithBioInp,'','height=600,left=120,top=120,width=900,location=no, menubar=no, resizable=no, status=no, toolbar=no, scrollbars=no');
					//var bioResp=window.showModalDialog("https://finpreprod.ebsafrica.com:20322/finbranch/custom/BIO/BioModal.jsp?cif="+cifcustid,"","dialogWidth:626px;dialogHeight:626px;status:No;help:No;resizable:No;scroll:No");
//alert(keyVal);
					//alert("bioResp:"+bioResp);
                    if (bioResp == undefined) {
                        alert("Biometric validation Cancelled");
                        setSValue("bioStatus|F");
                        bioExcp = "Y";
                        if (mopVal == "CDAA") {
                            return false;
                        }
                        //return false;
                    }
                    if (bioResp == "O") {
                        alert("Overriding Bio validation");
                        setSValue("bioStatus|C");
                        varTrue++;
                        if (mopVal == "CDAA") {
                            //var input = "dco|" + mopVal;
							var input = "dco|" + mopVal + "|custIdOrAcctId|" + custIdOrAcctId;
                            var outputNames = "output|outVal";
                            var outputNames = "output2|outVal";
                            var scrName = "biooveride_check.scr";
                            var retVal = appFnExecuteScript(input, outputNames, scrName, false);
                            var retBuff = retVal.split("|");
                            var output = retBuff[0];
                            var value = retBuff[1];
                            var a = value;
                            //alert(a);
                            var retBuff = retVal.split("|");
                            var output = retBuff[2];
                            if (a == "Y") {
                                alert("Override Bio validation done");
								return true;
                            } else {
                                alert("Override Bio validation Failed");
                                return false;
                            }
                        }
                        //var input = "menuId|" + mopVal;
                        //var scrName   = "bioexcp.scr";
                        //var output    = appFnExecuteScript(input, "", scrName, false);
                        //var keyVal      = output.split("|")[1];
                        //alert(keyVal);
                        //return false;
                    }
			//alert("bioResp:"+bioResp);		
                              if (bioResp != undefined) {
                        var aResult = bioResp.split("|");
						//alert("aResult[0]:"+aResult[0]);
                        if (aResult[0] == "Y") {
                            alert("Bio validation successful");
                            varTrue++;
                            bioSuc++;
                            setSValue("bioStatus|S");
                            return true;
                        }
                        if ((aResult[0] != "Y") && (aResult[0] != "O")) {
                            alert("Biometric validation failed");
							//alert(keyVal+":keyVal");
							//var keyVal2 = "acctId";
                            //document.getElementById(keyVal2).value = "";
							//alert("done:");
							document.getElementById(keyVal).value = "";
							
                            setSValue("bioStatus|F");
                            bioExcp = "Y";
                            if (mopVal == "CDAA") {
                                return false;
                            }
                            //fnClearFields();
                            return false;
                        }
                    }
                }
            }

            loop++;
        }
        //alert(bioModeOper+"|"+bioArrLen+"|"+varTrue+"|"+ bioExcp +"|"+bioSuc);
        if (bioArr[1] == "U") {
            if (bioSuc == 1)
                return true;
            else
                return false;
        }

        if ((bioModeOper == "ETS") || (bioModeOper == "SELF")) {
            if (bioSuc > 0) {
                setSValue("bioStatus|S");
            } else {
                if (varTrue > 0) {
                    setSValue("bioStatus|C");
                } else {
                    setSValue("bioStatus|F");
                }
            }
        }

        if ((bioModeOper == "ALL") || (bioModeOper == "BTS")) {
            if (bioArrLen == varTrue) {
                if (bioExcp == "Y") {
                    setSValue("bioStatus|F");
                }
                if (bioSuc < varTrue) {
                    setSValue("bioStatus|C");
                } else {
                    setSValue("bioStatus|S");
                    return true;
                }
            } else {
                if (bioExcp == "Y") {
                    setSValue("bioStatus|F");
                }
                return false;
            }
        }

        if (bioModeOper == "ANY") {
            if (bioSuc >= 2) {
                setSValue("bioStatus|S");
            } else {
                if (varTrue > 1) {
                    setSValue("bioStatus|C");
                } else {
                    setSValue("bioStatus|F");
                }
            }

        }
    } else {
        return true;
    }
    return true;

}

function app_post_ONKEYUP(obj) {
    if (window.event.keyCode == 18)
        return true;
}


</script>
