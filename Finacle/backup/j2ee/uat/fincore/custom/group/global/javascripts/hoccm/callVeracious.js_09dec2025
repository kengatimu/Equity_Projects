<!--	This file is used for making the url call to Veracious  -->

var respString = "";

function fetchUrlDtlsFromProp(APIName)
{
	var retVerUrl = "";
	if(APIName == "LODGECHQDTLS")
	{
		if((profileId=="54")||(profileId=="56")){
                        //retVerUrl = "http://vphprodclearing.ebsafrica.com/global_vph_nginx/#/finacle-scan?params=";
                        retVerUrl = "http://vphappuat.ebsafrica.com/global_vph_nginx/#/finacle-scan?params=";
		} else if (profileId=="50") {
		        retVerUrl = "http://vphappuat.ebsafrica.com/app_vph_scan_rw/#/finacle-scan?params=";
                }else{
			//retVerUrl = "net.tcp:// veraciousdev.ebsafrica.com:4504/RDAPI";
			//retVerUrl = "https://veraciousdev.ebsafrica.com/RDAPI/SendChequeDetails.html?";
			//retVerUrl = "../../Veracious/callverSC.jsp?Params=";
			//thisiscorrect -- retVerUrl = "../custom/Veracious/callverSC.jsp?Params=";
			//retVerUrl = "../../Veracious/callverSC.jsp?Params=";
			retVerUrl = "../callverSC.jsp?Params=";
			//retVerUrl = "http://veraciousdev.ebsafrica.com/RDAPI/SendChequeDetails.html?";
                }


	}
        if(APIName == "VPHINQCHQIMG"){
			//retVerUrl = "https://vphprodclearing.ebsafrica.com/global_vph_nginx/#/view-image?tran_id=";
			if((profileId=="54") || (profileId=="56")){
				retVerUrl = "https://vphappuat.ebsafrica.com/global_vph_nginx/#/view-image?tran_id=";
			}
			if(profileId=="50"){
			 	retVerUrl = "https://vphappuat.ebsafrica.com/app_vph_scan_rw/#/view-image?tran_id=";
			}
        }
	if(APIName == "INQCHQIMG")
	{

		//retVerUrl = "net.tcp://Host:4504/RDAPI";
		//retVerUrl = ".../Renderer/custom/Veracious/callverSI.jsp?Params=";
		retVerUrl = "../custom/Veracious/callverSI.jsp?Params=";
		//retVerUrl = "http://veraciousdev.ebsafrica.com/RDAPI/InquireChequeImage.html?Params="

	}
	/*if(APIName == "REPRESENTCHQ")
	{
		retVerUrl = "http://veraciousdev.ebsafrica.com/RDAPI/RDService.svc/RepresentCheque/{0}";
		
	}*/
	return retVerUrl;
}
function callVPHapi(APIName, InputValues, InpUserId,nDate,isSubmit){
        if(APIName == "VPHINQCHQIMG"){
                var verURL = fetchUrlDtlsFromProp(APIName);
                var verURLWithInp = verURL + InputValues ;
                //stopIdleCheckTimer();
                var popupWidth = (parseInt(window.innerWidth) * 0.9);
                var popupHeight = (parseInt(window.innerHeight) * 0.8);
                var popupLeft = (parseInt(screen.width) - popupWidth) / 2;
                var popupTop = (parseInt(screen.height) - popupHeight) / 4;
                var respVal = window.open(verURLWithInp,'',"width=" + popupWidth + ",height=" + popupHeight + ",menubar=yes,location=yes,resizable=yes,scrollbars=yes,status=yes,top=" + popupTop + ",left=" + popupLeft + "");
                //alert(respVal);
                //startIdleCheckTimer();
        }
        if(APIName == "LODGECHQDTLS"){
		var retrievedObject = window.lstringVal;
		if((!retrievedObject)||(isSubmit=="N")){
                var verURL = fetchUrlDtlsFromProp(APIName);
                var uniqueString = InpUserId + nDate + Math.floor(Date.now() / 1000);
			window['lstringVal']=uniqueString;
                var InputValues = InputValues + "|" + uniqueString;
                var verURLWithInp = verURL + InputValues;
                //alert(InputValues);
                //alert(verURLWithInp);
                var popupWidth = (parseInt(window.innerWidth) * 0.9);
                var popupHeight = (parseInt(window.innerHeight) * 0.8);
                var popupLeft = (parseInt(screen.width) - popupWidth) / 2;
                var popupTop = (parseInt(screen.height) - popupHeight) / 4;
                var respVal = window.open(verURLWithInp,'',"width=" + popupWidth + ",height=" + popupHeight + ",menubar=yes,location=yes,resizable=yes,scrollbars=yes,status=yes,top=" + popupTop + ",left=" + popupLeft + "");
                //alert("is clsoed  " + respVal.closed);
                //This setInterval is used to check the child window closed or not for every 500ms
               
		}else{
		window.lstringVal=undefined;
		checkChild(APIName,InpUserId,retrievedObject);
		}
        }
}
function checkChild(APIName,InpUserId,retrievedObject){
        if(APIName == "LODGECHQDTLS"){
                respString = retrievedObject;
        }
}

function callVeraciousAPI(APIName, InputValues)
{
	var verURL = fetchUrlDtlsFromProp(APIName);
	var verURLWithInp = verURL + InputValues;
	alert(verURLWithInp);
	if(APIName == "INQCHQIMG")
        {
		stopIdleCheckTimer();
		var respVal = window.showModalDialog(verURLWithInp,'ALL IS  ' ,'dialogWidth:80pc;dialogHeight:400px;dialogTop:0;center=yes;fullscreen=no');
		//var respVal = window.open(verURLWithInp);
		startIdleCheckTimer();
        }
        if(APIName == "LODGECHQDTLS")
        {
		stopIdleCheckTimer();
		var respVal = window.showModalDialog(verURLWithInp,'ALL IS  ' ,'dialogWidth:100pc;dialogHeight:100pc;center=yes;fullscreen=yes');
		startIdleCheckTimer();
	}

	//alert("Response value : " + respVal);
	//alert("APIName : " + APIName);

	if(APIName == "LODGECHQDTLS")
	{
		extractLodgeDtls(respVal);
	}
	
	if(APIName == "INQCHQIMG")
	{
		/* No processing required. The pop up window comes up with image*/
	}
	
	/*if(APIName == "REPRESENTCHQ")
	{
		extractRepresDtls(respVal);
	}*/
}

function extractLodgeDtls(respVal)
{
	//alert("response From veracious : " + respVal);
	
	var veraciousRes = '{"chequeDetail":' + respVal + '}';
	
	var obj = eval ("(" + veraciousRes + ")");

	respString = "";
	//alert("respVal array length : " + obj.chequeDetail.length);
	for(var i = 0; i < obj.chequeDetail.length; i++)
	{
		respString = respString + obj.chequeDetail[i].BankCode + "~";
		respString = respString + obj.chequeDetail[i].BatchNum + "~";
		respString = respString + obj.chequeDetail[i].BranchCode + "~";
		respString = respString + obj.chequeDetail[i].ChequeAmount + "~";
		respString = respString + obj.chequeDetail[i].Chequenumber + "~";
		respString = respString + obj.chequeDetail[i].DebitAccountName + "~";
		respString = respString + obj.chequeDetail[i].DrAccountNum + "~";
		respString = respString + obj.chequeDetail[i].TranID + "~";
		respString = respString + obj.chequeDetail[i].Transactioncode + "::";
	}
	//alert("data for script : " + respString)
}


function extractRepresDtls(respVal)
{
	//alert("call veracious response From veracious : " + respVal);
	
	//var veraciousRes = '{"chequeDetail":' + respVal + '}';
	var veraciousRes = '{"chequeDetail":[' + respVal + ']}';
	//alert("veraciousRes : " + veraciousRes);
	var obj = eval ("(" + veraciousRes + ")");

	respString = "";
	//alert("respVal array length : " + obj.chequeDetail.length);
	
	respString = respString + obj.chequeDetail[0].BankCode + "~";
	respString = respString + obj.chequeDetail[0].BatchNum + "~";
	respString = respString + obj.chequeDetail[0].BranchCode + "~";
	respString = respString + obj.chequeDetail[0].ChequeAmount + "~";
	respString = respString + obj.chequeDetail[0].Chequenumber + "~";
	respString = respString + obj.chequeDetail[0].DebitAccountName + "~";
	respString = respString + obj.chequeDetail[0].DrAccountNum + "~";
	respString = respString + obj.chequeDetail[0].TranID + "~";
	respString = respString + obj.chequeDetail[0].Transactioncode + "::";
	
	//alert("data for script : " + respString)
}
