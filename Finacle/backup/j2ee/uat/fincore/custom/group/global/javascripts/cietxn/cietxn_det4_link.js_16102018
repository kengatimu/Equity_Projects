}

function fnComputeTranAmt(obj){
        var ObjForm = document.forms[0];

	var cashTxn = "N"
	if(ObjForm.cashTxn[0].checked){
		cashTxn = "Y";
	}
	if(cashTxn == "Y"){
		fnComputeTranAmtForCashTxn(obj);
	}else{
		fnComputeTranAmtForXferTxn(obj);	
	}
}

function fnComputeTranAmtForCashTxn(obj){
	var ObjForm = document.forms[0];
        var crAcctNumCcy = ObjForm.crAcctNumCcy.value.toUpperCase();
