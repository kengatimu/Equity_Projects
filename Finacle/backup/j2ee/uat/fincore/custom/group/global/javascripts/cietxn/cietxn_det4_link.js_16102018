        var rate = removeCommas(rateTmp);
        var treaRateTmp = ObjForm.treaRate.value;
        var treaRate = removeCommas(treaRateTmp);

	if(fnIsNull(crAcctNumCcy) || fnIsNull(refCrncy)){
                ObjForm.rateCode.value = "";
