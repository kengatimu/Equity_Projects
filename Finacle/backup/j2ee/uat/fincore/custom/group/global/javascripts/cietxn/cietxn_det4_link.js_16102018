function cietxn_det4_post_ONLOAD()
{
        var ObjForm = document.forms[0];

	if(funcCode == "A"){
		if(cashTxnFlg == "N"){
			ObjForm.cashTxn[1].checked = true;
		}else{
			cashTxnFlg = "Y";
			ObjForm.cashTxn[0].checked = true;	
		}

		if(cashTxnFlg == "Y"){
			hideImage("drAcctNumRow");
			hideImage("instrumentTypeRow");
			hideImage("instrumentDateRow");
			ObjForm.crAcctNum.focus();
		}

                hideImage("rateCodeImg");
		hideImage("treaRefNumImg");
		fnOnloadDisableFields();
                fnDisableAmtFields();
				showRateWrkClss();
		//fnPopulateValues();
		ObjForm.refCrncy.focus();
        }

	hideImage("debitEntityRow");
	hideImage("creditEntityRow");		
	hideImage("crAcctNumImg");

        return true;
}

function cietxn_det4_pre_ONLOAD(){
        var ObjForm = document.forms[0];
        if(funcCode == "A"){
                if(cashTxnFlg == "N"){
                        ObjForm.cashTxn[1].checked = true;
                }else{
                        cashTxnFlg = "Y";
                        ObjForm.cashTxn[0].checked = true;
                }
        }
}

function showRateWrkClss(){

	    var inputNameValues = "";
        var outputNames = "";
        var scriptName = "cietxnRate.scr";
		var retVal = appFnExecuteScript(inputNameValues, outputNames, scriptName, false);
		var ret = retVal.split("|");

		if(ret[0] == "err")
		{	
			var ObjForm = document.forms[0];
			ObjForm.treaRate.disabled = true;
			ObjForm.rate.disabled = true;
		}

}

function fnOnloadDisableFields(){
        var ObjForm = document.forms[0];
	ObjForm.crAcctNum.disabled = true;
        ObjForm.creditEntityDesc.disabled = true;
        ObjForm.crAcctNumEntityId.disabled = true;
        ObjForm.crAcctNumSolId.disabled = true;
        ObjForm.crAcctNumCcy.disabled = true;
        ObjForm.crAcctName.disabled = true;
        ObjForm.nostroAcct.disabled = true;
        ObjForm.nostroAcctName.disabled = true;
	ObjForm.tranParticular.disabled = true;
	ObjForm.tranRmks.disabled = true;
	ObjForm.tranRmks2.disabled = true;
	ObjForm.refNo.disabled = true;

        var rateCode = ObjForm.rateCode.value;
        if(fnIsNull(rateCode)){
                ObjForm.rateCode.disabled = true;
                ObjForm.rate.disabled = true;
                ObjForm.treaRefNum.disabled = true;
                ObjForm.treaRate.disabled = true;

        }
}

function fnPopulateCrAcctNum(){
	var ObjForm = document.forms[0];
	var refCrncy = ObjForm.refCrncy.value;
	if(fnIsNull(refCrncy)){
		return false;
	}
	var inputNameValues = "refCrncy|"+refCrncy;
	var outputNames = "errorFlg|errorMsg|crAcctNum";
	var scriptName = "cietxndp044.scr"
	var retVal = appFnExecuteScript(inputNameValues,outputNames,scriptName,false);
	var token = retVal.split("|");
	if(token != undefined){
		var errorFlg = token[1];
		var errorMsg = token[3];
		var crAcctNum = token[5];

		if(errorFlg == "Y"){
			alert(errorMsg);
			ObjForm.crAcctNum.value = "";
			ObjForm.crAcctNumCcy.value = "";
			ObjForm.crAcctNumSolId.value = "";
			ObjForm.crAcctName.value = "";
			ObjForm.refCrncy.focus();
			return false;
		}else{
			ObjForm.crAcctNum.value = crAcctNum;
			fnGetAcctDetails2();
			if((!fnIsNull(crAcctNumEntityId)) &&(!fnIsNull(drAcctNumEntityId))){
				if(crAcctNumEntityId != drAcctNumEntityId){
					alert("Other Entity Account cannot be used");
					fnClearAcctDetails1();
					ObjForm.drAcctNum.value = "";	
					return false;
				}	
			}
			ObjForm.refAmt.focus();
			return true;
		}
	}
	return false;
}

