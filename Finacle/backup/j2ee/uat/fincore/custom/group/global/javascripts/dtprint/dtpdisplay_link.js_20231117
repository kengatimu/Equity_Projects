var printOnLoad = '<%=ParseValue.checkString(ARJspCurr.getInput(sGroupName+".printOnLoad",""))%>';
var printTried = false;
function fnOnLoad()
{
	hideImage(divReturn.id);
	defaultDeviceId = masageDefaultDeviceId(defaultDeviceId);
	var PDF_REPORT = 1;
	var RTF_REPORT = 2;
	var XLS_REPORT = 3;
	var CSV_REPORT = 4;

	if(!fnIsNull(defaultDeviceId))
	{
		document.forms[0].deviceId.value = defaultDeviceId;
	}
	else
	{
		document.forms[0].deviceId.value="WPRN";
	}
	if (printOnLoad == "true" && (!fnIsNull(defaultDeviceId)) && validateDeviceId()) {
		hideImage(divCancel.id);
		doPrint();
		doPostPrintWork();
	}
	else {
		
		if (document.forms[0].deviceId.value == "WPRN")
		{
			/* Disable print button in case the file is of PDF or RTF or 
			XLS or CSV format */
		 	if (rptFormat == PDF_REPORT || rptFormat == RTF_REPORT ||
		 	rptFormat == XLS_REPORT || rptFormat == CSV_REPORT)
		 	{
		 		document.forms[0].Print.disabled = true;
				showImage(divCancel.id);
				showImage(divReturn.id);
			
			}
			else
			{
			/* Enable print button if the file format is HTM or TXT or MRT */
		
				document.forms[0].Print.disabled = false;
				showImage(divCancel.id);
			}
			

		}
		else
		{ 
			document.forms[0].Print.disabled = false;
			showImage(divCancel.id);
		}
		
	}
}
//This will validate if the deviceId which is being passed is valid or not
function validateDeviceId()
{
var validDevice = false;
        if(defaultDeviceId == "WPRN")
		 	return true;
		if(TPRNT_Pflg){
            for (i=0; i< TPRNT_DeviceId.length; i++)
            {
                if(TPRNT_DeviceId[i] == defaultDeviceId)
                {
                    validDevice =true;
                    break;
                }
            }
        }
		if(LPRNT_Pflg){
            for (i=0; i< LPRNT_DeviceId.length; i++)
                {
                if(LPRNT_DeviceId[i] == defaultDeviceId)
                {
                    validDevice =true;
                    break;
                }
            }
        }
		if(PBPRN_Pflg){
            for (i=0; i< PBPRN_DeviceId.length; i++)
                {
                if(PBPRN_DeviceId[i] == defaultDeviceId)
                {
                    validDevice =true;
                    break;
                }
            }
        }
		if(SPPRN_Pflg){
            for (i=0; i< SPPRN_DeviceId.length; i++)
                {
                if(SPPRN_DeviceId[i] == defaultDeviceId)
                {
                    validDevice =true;
                    break;
                }
            }
        }
    return validDevice;
}
function fnOnButtonClick(btnObj)
{
	var ret =	null;
	
	if(btnObj.id == 'Cancel') {
		document.location.href = jsUtil.formatUrl('../dtprint/dtprint_ctrl.jsp?actionCode='+btnObj.id);
		return true;
	}
	else if(btnObj.id == 'Return') {
		getUserConfirmation();
	}
	else if(btnObj.id == 'Print') {
		doPrint();
		doPostPrintWork();
	}	
}

function doPrint()
{
    var ret= null;
    var hdeviceId;
    if(document.forms[0].deviceId[0].selected) {
        dataframe.focus();
        dataframe.print();
        ret = true;
    }
    else if(TPRNT_Pflg || LPRNT_Pflg || SPPRN_Pflg || PBRN_Pflg)
    {
        hdeviceId=document.forms[0].deviceId.value;
        if(!fnIsNull(hdeviceId))
            ret = eval(hdeviceId +"_Invoke").call();
        else
        {
            //alert(finbranchResource.FAT002908);
            document.forms[0].deviceId.focus();
        }
    }
    else
    {
        //alert(finbranchResource.FAT002909);
    }
    if(ret ==true)
    {
        printTried = true;
        if (dupPrntAlwd != "true") {
            getUserConfirmation();
        }
    }
    else
    {
        document.forms[0].deviceId.value=hdeviceId;
        return false;
    }
    return true;
}

function getUserConfirmation()
{
	var objForm = document.forms[0];
	var reqParams = "&isInventoryUsedChkReq="+checkInventoryUsed+"&isPQTFile="+isPQTFile;
	ret = popModalWindow("../dtprint/"+applangcode+"/dtpconf.jsp?"+reqParams, "Print Confirmation");

	var liarrBufArray = ret.split("|");

	/* setting the hidden values */
	objForm.deleteFile.value = liarrBufArray[1];
	objForm.inventoryUsed.value = liarrBufArray[2];
	objForm.printedSuccessfully.value = liarrBufArray[3];

	if ((checkInventoryUsed == "true" && dupPrntAlwd != "true") 
						&& 
		(objForm.printedSuccessfully.value != 'Y' && objForm.inventoryUsed.value != 'Y'))
	{
		printTried = false;
	}
	else {
		doSubmit("ProceedAfterPrint");
	}
	return;
}

function doPostPrintWork()
{
	document.forms[0].Print.disabled = false;
	if (!printTried) {
		hideImage(divReturn.id);
		showImage(divCancel.id);
	}
	else {
		hideImage(divCancel.id);
		showImage(divReturn.id);
	}
}

function loadDeviceIdOptionList() {
    with(document) {
        writeWindowPrint();
        if(TPRNT_Pflg)
        writeTPRNTDevices();
        if(PBPRN_Pflg)
        writePBPRNDevices();
        if(LPRNT_Pflg)
        writeLPRNTDevices();
        if(SPPRN_Pflg)
        writeSPPRNDevices();

    }
    return;
}

function writeTPRNTDevices() {
    var dispName;
    for(i=0; i<TPRNT_DeviceId.length; i++) {

        locDeviceId = eval("TPRNT"+"_DeviceId["+i+"]");
	dispName = locDeviceId.split("window.parent.DEVICEFRAME.TPRNT.");
        if(locDeviceId == undefined)
            break;
        else
            with(document) {
                write('<OPTION VALUE="'+locDeviceId+'">'+dispName[1]+'</OPTION>');
            }
    }
}

function writePBPRNDevices() {
    var dispName;
    for(i=0; i<PBPRN_DeviceId.length; i++) {

        locDeviceId = eval("PBPRN"+"_DeviceId["+i+"]");
	dispName = locDeviceId.split("window.parent.DEVICEFRAME.PBPRN.");
	
        if(locDeviceId == undefined)
            break;
        else
            with(document) {
                write('<OPTION VALUE="'+locDeviceId+'">'+jsUtil.encodeChar(dispName[1])+'</OPTION>');
            }
    }
}

