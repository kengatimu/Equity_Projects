function writeWindowPrint()
{
with(document) {
 write('<OPTION VALUE="WPRN">'+ finbranchResource.FAT002910 +'</OPTION>');
}
}

function masageDefaultDeviceId(defaultDeviceId) {
	var deviceIdArr = defaultDeviceId.split("DEVICEFRAME");
	var deviceId = "";
	var deviceName;
    
	if(defaultDeviceId == "WPRN")
 		return defaultDeviceId;
	
	if(!fnIsNull(deviceIdArr[1]))
		return defaultDeviceId;
	
	if(TPRNT_Pflg){
	    for (i=0; i< TPRNT_DeviceId.length; i++)
	    {
			deviceName = TPRNT_DeviceId[i].split("window.parent.DEVICEFRAME.TPRNT.");
			if(deviceName[1] == defaultDeviceId)
			{
				deviceId = TPRNT_DeviceId[i];
				return deviceId;
			}
	    }
	}
	if(LPRNT_Pflg){
	    for (i=0; i< LPRNT_DeviceId.length; i++)
	    {
			deviceName = LPRNT_DeviceId[i].split("window.parent.DEVICEFRAME.LPRNT.");
			if(deviceName[1] == defaultDeviceId)
			{
				deviceId = LPRNT_DeviceId[i];
				return deviceId;
			}
	    }
	}
	if(PBPRN_Pflg){
	    for (i=0; i< PBPRN_DeviceId.length; i++)
	    {
			deviceName = PBPRN_DeviceId[i].split("window.parent.DEVICEFRAME.PBPRN.");
			if(deviceName[1] == defaultDeviceId)
			{
				deviceId = PBPRN_DeviceId[i];
				return deviceId;
			}
	    }
	}
	if(SPPRN_Pflg){
	    for (i=0; i< SPPRN_DeviceId.length; i++)
	    {
			deviceName = SPPRN_DeviceId[i].split("window.parent.DEVICEFRAME.SPPRN.");
			if(deviceName[1] == defaultDeviceId)
			{
				deviceId = SPPRN_DeviceId[i];
				return deviceId;
			}
	    }
	}     
    return deviceId;
}


function autoPrintToDfltPrinter(data) 
{
	alert("Inside JS");
	var pApplet = document.customPrintApp;
    if (pApplet != null) 
	{
		alert("ppApplet-->"+pApplet);
				alert("data-->"+data);	
		try
		{
			 alert("inside try before prin");	
			pApplet.printToDfltPrinter(data);
			autoPrintComplete("Print Done");
			alert("inside try");
		}
		catch (err)
		{
			alert("err");
			alert("err.message-->"+err.message);
			autoPrintComplete(err.message);
			alert("after autoprint");
		}
		if(audGrpName =="Customize")
		{
			alert("Inside customize");	
			window.close();
		}
		else
		{
			alert("inside else of custom");	
			dtpdisplay_ONCLICK5(document.forms[0].Cancel, document.forms[0].Cancel);
		}

	}
}

