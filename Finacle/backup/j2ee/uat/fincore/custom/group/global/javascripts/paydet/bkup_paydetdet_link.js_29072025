	fnPopulateAmtnRate(ObjForm.rate);
	return true;
}



function paydetdet_post_onLoad()
{

	if(funcCode =='V' || funcCode =='I' || funcCode =='D' || funcCode =='U' ||  funcCode =='X' || sReferralMode =='I' || sReferralMode =='S')
	{
		hideImage(("sLnk5"));
		hideImage(("sLnk4"));
		hideImage(("sLnk6"));
		hideImage(("sLnk8"));
		hideImage(("sLnk9"));




	}

}

function paydetdet_getAccInfo(acctId)
{
	
	retVal="";
	var inputNameValues = "acctId|"+ acctId;
		
	var scrName="paydetGetAcctInfo1.scr";
	
	var outputNames="";

	
	var retVal=	appFnExecuteScript(inputNameValues, outputNames, scrName, false);
	
	return retVal;	
	
}

function fnchk_invld_chr(obj)
{
	obj.value = obj.value.toUpperCase();
	var iChars = "!~@`#$&*()+=[]\\\';,/{}|\":<>?.%-^_";
	var iFlag1  = 0;
	var value = obj.value;
	for (var j = 0; j < value.length; j++)
	{
		if (iChars.indexOf(value.charAt(j)) != -1)
		{
			alert("Special characters are not allowed");
			obj.value="";
			obj.focus();
			return false;
		}
	}

	return true;
}



