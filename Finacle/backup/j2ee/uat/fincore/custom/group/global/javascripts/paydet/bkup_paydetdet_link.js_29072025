function fnValidateData() {
//		if (!fnCheckMandatoryFields())
//		{
//			return false;
//		}

		if(document.forms[0].remitamt.value!="")
		{	
			var tlmtCr = document.forms[0].remitamt.value;
			if(isNaN(tlmtCr))
			{	
				document.forms[0].remitamt.focus();
				alert("Remit amount is mandatory");
				return false;

			}
			alert("Remit amount is mandatory"+tlmtCr);

					
		}


		if(document.forms[0].remitamt.value =="")
		{
			document.forms[0].remitamt.focus();
			alert("Remit amount is mandatory");
			return false;
		}
			

		if(document.forms[0].custacc.value == "")
		{
			document.forms[0].custacc.focus();
			alert("Invalid Customer Account");
			return false;
		}


		if(document.forms[0].ecsmebid.value == "")
		{
			document.forms[0].ecsmebid.focus();
			alert("ECS Membership Id is Mandatory");
			return false;
		}


		if(document.forms[0].tranrmks.value == "")
		{
			document.forms[0].tranrmks.focus();
			alert("Transaction remarks are mandatory");
			return false;
		}

		if(document.forms[0].citycode.value == "")
		{
			document.forms[0].citycode.focus();
			alert("Invalid destination city");
			return false;
		}

		if(document.forms[0].bankcode.value == "")
		{
			document.forms[0].bankcode.focus();
			alert("Invalid bankcodecity");
			return false;
		}

		if(document.forms[0].branchcode.value == "")
		{
			document.forms[0].branchcode.focus();
			alert("Invalid branchcode ");
			return false;
		}

		if(document.forms[0].receiveracc.value == "")
		{
			document.forms[0].receiveracc.focus();
			alert("Invalid receiveracc");
			return false;
		}

		if(document.forms[0].receiveraccname.value == "")
		{
			document.forms[0].receiveraccname.focus();
			alert("Invalid receiveraccname");
			return false;
		}


		 if (document.forms[0].receiveracc.value != "") 
		{
            if (document.forms[0].receiveracc.value.length > 13)
		 {
                alert("Receiver account more than 13");
                document.forms[0].receiveracc.focus();
                return false
            }
		}

		
		return true;
}

