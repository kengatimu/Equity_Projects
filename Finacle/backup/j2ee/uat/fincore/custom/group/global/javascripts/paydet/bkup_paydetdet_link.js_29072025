function paydetdet_onChange_custacc()
{
	var acctId = document.forms[0].custacc.value;
	var retVal = paydetdet_getAccInfo(acctId)
	if (retVal != undefined) 
	{
		var strMesg = retVal.split("|");
		if(strMesg[1] == "Y")
		{

//			alert("results" + strMesg);

			document.forms[0].custaccsolIdS.value=strMesg[3];
			document.forms[0].custaccacctDescS.value=strMesg[5];
		  	document.forms[0].custacccrncyCodeS.value=strMesg[7];

			document.forms[0].chrgacc.value=acctId ;
			document.forms[0].chrgaccsolIdS.value=strMesg[3];
			document.forms[0].chrgaccacctDescS.value=strMesg[5];
		  	document.forms[0].chrgacccrncyCodeS.value=strMesg[7];

			document.forms[0].tranccy.value=strMesg[7];
			document.forms[0].suspacc.value=strMesg[9];
			document.forms[0].suspacctDescS.value=strMesg[11];
			document.forms[0].suspcrncyCodeS.value=strMesg[13];

			document.forms[0].remitamt.value="0";
//auto populate rate code

			if(document.forms[0].custacccrncyCodeS.value != "CDF")
			{
			document.forms[0].treaRate.value="TTB";
			}
	
		}
		else
		{
			document.forms[0].custaccsolIdS.value= "";
			document.forms[0].custaccacctDescS.value= "";
			document.forms[0].custacccrncyCodeS.value= "";


		}
	
	}



}


