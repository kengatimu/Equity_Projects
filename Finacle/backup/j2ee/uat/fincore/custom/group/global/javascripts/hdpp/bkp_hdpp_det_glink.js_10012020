function printFooterBlock()
{
	with (document) {
	if ((sReferralMode == 'I')||(sReferralMode == 'S')){
	write('<div align="left" class="ctable">');
	if (sReferralMode == 'S'){
	write('<input type="button" class="Button" id="Submit" value="SUBMIT" onClick="javascript:return doRefSubmit(this);" hotKeyId="Submit" >');
	}
	writeRefFooter();
	write('<input type="button" class="Button" id="_BackRef_" value="CANCEL" onClick="javascript:return doSubmit(this.id);" hotKeyId="Cancel" >');
	write('</div>');
	}else{
	//if(funcCode =='C'){
	write('<div class="ctable">');
	write('<input name="Submit" type="button" class="button" onClick="javascript:return hdpp_det_ONCLICK1(this,this);" id="Submit" value="Submit" hotKeyId="Submit">');
	write('<input name="Clear" type="button" class="button" onClick="javascript:return hdpp_det_ONCLICK2(this);" id="Clear" value="Clear">');
	//}else{
	//write('&nbsp;<input class="button" type="button" id="Back" value="OK" onClick="javascript:return doSubmit(this.id)" hotKeyId="Ok">');
	//}
	writeFooter();
	write('</div>');
	}
	} //End with()
}//End function
function fnOnLoad(){
        var ObjForm = document.forms[0];
        pre_ONLOAD('hdpp_det',this);
        var funcName = "this."+"locfnOnLoad";
        if(eval(funcName) != undefined){
                eval(funcName).call(this);
        }
        fnPopulateControlValues();
	if(document.forms[0].funcCode=="I"){
		document.getElementById("dpId").style.visibility = "hidden";
                document.getElementById("dpId").style.display = "none";
	}
        fnPopUpExceptionWindow(ObjForm.actionCode);
        if((typeof(WF_IN_PROGRESS) != "undefined") && (WF_IN_PROGRESS == "PEAS")){
                checkCustErrExecNextStep(Message);
        }
        post_ONLOAD('hdpp_crit',this);
}
function fnCheckMandatoryFields(){
        var ObjForm = document.forms[0];
        if (fnIsNull(ObjForm.funcCode.value)){
                alert("Select the Option");
                ObjForm.funcCode.focus();
                return false;
        }
        if (fnIsNull(ObjForm.accNum.value)){
                //alert(jspErrResArr.get("FAT000924"));
                alert("Enter Account Number");
                ObjForm.accNum.focus();
                return false;
        }
	if((document.forms[0].funcCode.value=="C") && (getRadioValue(ObjForm.gdprYn)=="N")){
		if(document.forms[0].accNum.value != "") {
                var inputNameValues    = "acctNo|"+document.forms[0].accNum.value;
                var outputNames     = "gacO";
                var scrName         = "hdppmn002.scr";
                var retVal          = appFnExecuteScript(inputNameValues, outputNames, scrName, false);
                var ret = retVal.split("|");
                //alert(ret[1]);
                if( ret[1] == 'GDPR' ) {
                        alert("Customer Data Protection Privacy Already Registered");
                        document.forms[0].accNum.focus();
			checkRadio(document.forms[0].gdprYn,"Y");
                        return false;
                }else{
                        alert("Customer not accepted GDPR Terms!!");
			ObjForm.gdprYn.focus();
                        return false;
                }
		}
	}
        return true;
}
function fnPopulateControlValues(){
	var ObjForm = document.forms[0];
	ObjForm.accNum.value = accNum;
	ObjForm.funcCode.value = funcCode;
	ObjForm.gdprYn.value = gdprYn;
}
function fnValidateData(){
	var ObjForm = document.forms[0];
	return true;
}
function hdpp_det_ONCLICK1(obj,p1)
{
	var retVal = "";
	if (pre_ONCLICK('hdpp_det',obj) == false) { 
		return false;
	}
	fnCheckMandatoryFields();
        //if(confirm("Confirm GDPR Data Policy Readed/Accepted by Customer")){
         //       return false;
        //}
	if ((retVal = fnValAndSubmit(p1)) == false) {
		return false;
	}
	if (post_ONCLICK('hdpp_det',obj) == false) { 
		return false;
	}
	return (retVal == undefined) ? true : retVal;
}
function hdpp_det_ONCLICK2(obj){
        var retVal = "";
        if (preEventCall('hdpp_det',obj,'ONCLICK') == false) {
                return false;
        }
        if ((retVal =  fnClearFields()) == false) {
                return false;
        }
        if (postEventCall('hdpp_det',obj,'ONCLICK') == false) {
                return false;
        }
        return (retVal == undefined) ? true : retVal;
}
function fnshowAccountIdList(obj){
    showAccountIdList(obj,null,null,'F');
	fnCustValidate();
}

function fnshowOpenDp(obj){
	window.open(' https://finacleprod2.ebsafrica.com:20333/SSO/hdpp/Data Privacy Policy Website.pdf','name','height=450,width=650,toolbar=no,directories=no,status=no,menubar=no,scrollbars=yes,resizable=no ,modal=yes');
}
function hdpp_crit_ONCHANGE1(){
 	var ObjForm = document.forms[0];
	//alert(ObjForm.funcCode.value);
	//fnCustValidate();
	if(document.forms[0].funcCode=="I"){
                document.getElementById("dpId").style.visibility = "hidden";
                document.getElementById("dpId").style.display = "none";
        }
       if(document.forms[0].accNum.value != "") {
                //alert(document.forms[0].accNum.value);
                var inputNameValues    = "acctNo|"+document.forms[0].accNum.value;
                var outputNames     = "gacO";
                var scrName         = "hdppmn002.scr";
                var retVal          = appFnExecuteScript(inputNameValues, outputNames, scrName, false);
                var ret = retVal.split("|");
                //alert(ret[1]);
                if( ret[1] == 'GDPR' ) {
                        alert("Customer Data Protection Privacy Already Registered");
                        document.forms[0].accNum.focus();
			radiobtn = document.getElementById("gdprYn");
			radiobtn.checked = true;
                        return false;
                }else{
                        alert("GDPR Not Maintained");
			radiobtn = document.getElementById("gdprYn");
			radiobtn.checked = false;
                        return true;
                }
        }
	return true;
}
