       if ((retVal = fetchAcctDtls(p1,p2,p3,p4,p5,p6)) == false){
                return false;
        }
	fnCustValidate();
	var objForm = document.forms[0];
	if(document.forms[0].funcCode.value != "") {
		//if((document.forms[0].funcCode.value=="C") && (objForm.gdprYn.value=="Y")){
		if(document.forms[0].funcCode.value=="C"){
			fnBiCheck();
			fnBiCall();
			//varbiotest = getSValue("bioStatus");
			//alert(varbiotest);
		}
	}
	//document.forms[0].varbiotest.value = getSValue("bioStatus");
	//setFieldsToCustomData("varbiotest");
	//return true;
}
function fetchAcctDtls(acctObj, acctName, acctSol, acctCrncy, isError, fType){
        if((retVal=fnCommonFetchAcctDtls(acctObj,acctName,acctSol,acctCrncy,isError,"VALCUSTACCTID"))==false)
        {
                return false;
        }
}
function fnShowAccNum(){
        var objForm = document.forms[0];
        showAccountIdList(objForm.accNum,objForm.acctSolId,objForm.acctName,'F',objForm.acctCrncy,'','','');
	fnCustValidate();
}
function fnCustValidate(){
	if(document.forms[0].funcCode=="I"){
                document.getElementById("dpId").style.visibility = "hidden";
                document.getElementById("dpId").style.display = "none";
        }
	if(document.forms[0].accNum.value != "") {
		//alert(document.forms[0].accNum.value);
		var inputNameValues    = "acctNo|"+document.forms[0].accNum.value;
		var outputNames     = "gacO";
		var scrName         = "hdppmn002.scr";
		var retVal          = appFnExecuteScript(inputNameValues, outputNames, scrName, false);
		var ret = retVal.split("|");
		//alert(ret[1]);
		if( ret[1] == 'GDPR' ) {
			alert("Customer Data Protection Privacy Already Registered");
			document.forms[0].accNum.focus();
			radiobtn = document.getElementById("gdprYn");
                        radiobtn.checked = true;
                        return false;

			return false;
		}else{
			alert("GDPR Not Maintained");
			radiobtn = document.getElementById("gdprYn");
                        radiobtn.checked = true;
			return true;
		}
	}
}
function fnBiCheck(){
            var acct = document.forms[0].accNum.value;
            var input = "acct|" + acct;
            var outputNames = "output|outVal";
            var scrName = "bio_check.scr";
            var retVal = appFnExecuteScript(input, outputNames, scrName, false);
            var retBuff = retVal.split("|");
            var output = retBuff[0];
            var value = retBuff[1];
            var a = value;
            var retBuff = retVal.split("|");
            var output1 = retBuff[2];
            var value1 = retBuff[3];
            var b = value1;
            if (a != 1){
                if (b != 4){
                    alert("ENROLL CUSTOMER FOR BIO");
                }
                if (b == 4){
                    alert("PLEASE ENROLL CUSTOMER FOR BIO");
                    document.forms[0].accNum.focus();
                    return false;
                }
            }
}
