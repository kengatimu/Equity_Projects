}
function hdpp_det_ONCLICK28(obj){
        var retVal = "";
        if (preEventCall('hdpp_det',obj,'ONCLICK') == false) {
                return false;
        }
        if (preEventCallForLocale('hdpp_det',obj,'ONCLICK') == false) {
                return false;
        }
        if ((retVal = fnOnChangeGdprYn()) == false) {
                return false;
        }
        if (postEventCallForLocale('hdpp_det',obj,'ONCLICK') == false) {
                return false;
        }
        if (postEventCall('hdpp_det',obj,'ONCLICK') == false) {
                return false;
        }
        return (retVal == undefined) ? true : retVal;
}
