function printFooterBlock()
{
	with (document) {
	if ((sReferralMode == 'I')||(sReferralMode == 'S')){
	write('<div align="left" class="ctable">');
	if (sReferralMode == 'S'){
	write('<input type="button" class="Button" id="Submit" value="'+jspResArr.get("FLT000193")+ '" onClick="javascript:return doRefSubmit(this);" hotKeyId="Submit" >');
	}
	writeRefFooter();
	write('<input type="button" class="Button" id="_BackRef_" value="'+jspResArr.get("FLT001721")+ '" onClick="javascript:return doSubmit(this.id);" hotKeyId="Cancel" >');
	write('</div>');
	}else{
	if(funcCode !='I'){
	write('<div class="ctable">');
	write('<input id="Submit" name="Submit" type="button" class="button"	onClick="javascript:return ccompay_det1_ONCLICK1(this,this);"" value="' + jspResArr.get("FLT000193") + '" hotKeyId="Submit">');
	write('<input id="Validate" name="Validate" type="button" class="button" value="' + jspResArr.get("FLT000194") + '"	onClick="javascript:return ccompay_det1_ONCLICK2(this,this);"" hotKeyId="Validate">');
	write('<input id="Cancel" name="Cancel" type="button" class="button" value="' + jspResArr.get("FLT001721") + '"	onClick="javascript:return ccompay_det1_ONCLICK3(this,this.id);"" hotKeyId="Cancel">');
	}else{
	write('<div class="ctable">');
	write('<input class="button" type="button" id="Back" value="'+jspResArr.get("FLT026526")+ '" onClick="javascript:return doSubmit(this.id)" hotKeyId="Ok">');
	}
	writeFooter();
	write('</div>');
	}
	} //End with()
}//End function

function fnOnLoad()
{
	var ObjForm = document.forms[0];

	initFocusHandler();

	pre_ONLOAD('ccompay_det1',this);

	var funcName = "this."+"locfnOnLoad";
	if(eval(funcName) != undefined){
		eval(funcName).call(this);
	}

	fnPopulateControlValues();

	if(funcCode =='V' || funcCode =='I' || funcCode =='D' || funcCode =='R' ||  funcCode =='X' || sReferralMode =='I' || sReferralMode =='S'){
		fnDisableFormDataControls('V',ObjForm,0);
	}
	if(funcCode=="I" || funcCode =='R' ){
		showImage("sLnk5");
	}
	if(funcCode =='R' ){
		ObjForm.Cancel.disabled=false;
	}
	fnPopUpExceptionWindow(ObjForm.actionCode);
	if((typeof(WF_IN_PROGRESS) != "undefined") && (WF_IN_PROGRESS == "PEAS")){
		checkCustErrExecNextStep(Message);
	}

	post_ONLOAD('ccompay_det1',this);
}

function fnCheckMandatoryFields()
{
	var ObjForm = document.forms[0];

	return true;
}

function fnPopulateControlValues() 
{
	var ObjForm = document.forms[0];

	ObjForm.commCode.value = commCode;
	ObjForm.commDesc.value = commDesc;
	ObjForm.commCrncy.value = commCrncy;
	ObjForm.commAmt.value = commAmt;
	ObjForm.ratecode.value = ratecode;
	ObjForm.rate.value = rate;
	ObjForm.vatCrncy.value = vatCrncy;
	ObjForm.vatAmt.value = vatAmt;
	ObjForm.drAcctNum.value = drAcctNum;
	ObjForm.acctEntityId.value = acctEntityId;
	ObjForm.acctSolId.value = acctSolId;
	ObjForm.acctCrncy.value = acctCrncy;
	ObjForm.acctName.value = acctName;
	ObjForm.pmntPrps.value = pmntPrps;
	ObjForm.crAcctNum.value = crAcctNum;
	ObjForm.crAcctEntityId.value = crAcctEntityId;
	ObjForm.crAcctSolId.value = crAcctSolId;
	ObjForm.crAcctCrncy.value = crAcctCrncy;
	ObjForm.crAcctName.value = crAcctName;
	
	ObjForm.taxAcctNum.value = taxAcctNum;
	ObjForm.taxAcctEntityId.value = taxAcctEntityId;
	ObjForm.taxAcctSolId.value = taxAcctSolId;
	ObjForm.taxAcctCrncy.value = taxAcctCrncy;
	ObjForm.taxAcctName.value = taxAcctName;
	ObjForm.rvsTranId.value = rvsTranId;
	ObjForm.rvsTranDate.value = rvsTranDate;
	
	ObjForm.commDesc.disabled=true;
	fnEnableRateFields();
	
	if(pmntType=="C"){
		ObjForm.drAcctNum.disabled=true;
		hideImage("sLnk4");
		hideImage("sLnk5");
		hideImage("sLnk6");
	}
	
	if(funcCode=="A"){
		hideImage("tranDetRow");
		hideImage("tranRevRow");
		hideImage("tranRevDetRow");	
	}
	if(funcCode=="R"){
		hideImage("sLnk2");
		hideImage("sLnk3");
		hideImage("sLnk4");
		hideImage("tranRevRow");	
		hideImage("tranRevDetRow");	
		ObjForm.ratecode.disabled=true;
		ObjForm.rate.disabled=true;
		ObjForm.commCode.disabled=true;
		ObjForm.drAcctNum.disabled=true;
	}
	if(funcCode=="I"){
		hideImage("sLnk2");
		hideImage("sLnk3");
		hideImage("sLnk4");
		ObjForm.ratecode.disabled=true;
		ObjForm.rate.disabled=true;
		ObjForm.commCode.disabled=true;
	}
}

function fnGetPymntType()
{
	switch (dummyPmntType) 
	{
        case 'A':
            return "Pay Using Account";
        case 'C':
            return "Pay At Cashbox";
        default:
            return dummyPmntType;
	}
}

function ccompay_det1_ONCLICK1(obj,p1)
{
	var retVal = "";
	if (preEventCall('ccompay_det1',obj,'ONCLICK') == false) { 
		return false;
	}
	if ((retVal =  fnEnableRateFields(p1)) == false) {
		return false;
	}
	if ((retVal =  fnValAndSubmit(p1)) == false) {
		return false;
	}
	if (postEventCall('ccompay_det1',obj,'ONCLICK') == false) { 
		return false;
	}
	return (retVal == undefined) ? true : retVal;
}

