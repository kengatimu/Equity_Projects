function ccompay_det1_ONBLUR1(obj)
{
        var retVal = "";
        if (preEventCall('ccompay_det1',obj,'ONBLUR') == false) {
                return false;
        }
		fnPopulateAmt();
        if (postEventCall('ccompay_det1',obj,'ONBLUR') == false) {
                return false;
        }
        return (retVal == undefined) ? true : retVal;
}

function ccompay_det1_ONCHANGE2(obj)
{
		var retVal = "";
        if (preEventCall('ccompay_det1',obj,'ONCHANGE') == false) {
                return false;
        }
		if ((retVal = fnGetAccountDetails()) == false) {
                return false;
        }
		if ((retVal = fnEnableRateFields(obj)) == false) {
                return false;
        }
        if (postEventCall('ccompay_det1',obj,'ONCHANGE') == false) {
                return false;
        }
        return (retVal == undefined) ? true : retVal;
	
}