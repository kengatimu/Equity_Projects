function fnTrannSearcher1()
{

        var bUrl = getBaseUrl();
        var ObjForm = document.forms[0];
	var acct = ObjForm.accNum.value;	
	var inputNameValues = "funcCode|" + ObjForm.funcCode.value;
        if(ObjForm.accNum.value != "")
        {
		//alert(ObjForm.accNum.value);
                inputNameValues = inputNameValues + "|acctNo|" + ObjForm.accNum.value;
        }
	else
	{
		alert("Enter Loan Account Number");
		ObjForm.accNum.focus();
		return
	}
	var outputNames = "lstAdjDate|tranId|tranAmt";
	var scriptName = "getSchedulesforaccount.scr";
	var title  = "LIST OF TRANS TO REVERSE";
	var literalNames="TRAN DATE|TRAN ID|TRAN AMOUNT";
	var hyperLnks   = "1";
	var retVal = fnExecuteScriptForList(inputNameValues, outputNames, scriptName, title, literalNames, hyperLnks, true);
	//alert(retVal);
        if(retVal != undefined)
        {
		var ObjForm = document.forms[0];
                var token = retVal.split("|");
                var lstAdjDate = token[1];
                var tranId = token[3];
                var tranAmt = token[5];
                ObjForm.lstAdjDate.value=lstAdjDate;
                ObjForm.tranId.value=tranId;
                ObjForm.tranAmt.value=tranAmt;
        }

}

function codlpay_det_ONBLUR1(obj,p1,p2){
        var retVal = "";
        if (preEventCall('codlpay_det',obj,'ONBLUR') == false) {
                return false;
        }
        if ((retVal = onBlurFormatDate(p1)) == false) {
                return false;
        }
        if ((retVal = fnAssignDateOnEnter(p2)) == false) {
                return false;
        }
        if (postEventCall('codlpay_det',obj,'ONBLUR') == false) {
                return false;
        }
        return (retVal == undefined) ? true : retVal;
}
function showAcctDetails() {
    if (fnIsNull(frm.accNum.value)) {
        alert(finbranchResArr.get("FAT000200"));
        frm.accNum.focus();
        return
    }
    var a = "../arjspmorph/" + applangcode + "/acctdtls.jsp?acctId=" + escape(frm.accNum.value);
    popModalWindow(a, "Acct Details")
}
function opshowAcctDetails() {
    if (fnIsNull(frm.OperaccNum.value)) {
        alert(finbranchResArr.get("FAT000200"));
        frm.OperaccNum.focus();
        return
    }
    var a = "../arjspmorph/" + applangcode + "/acctdtls.jsp?acctId=" + escape(frm.OperaccNum.value);
    popModalWindow(a, "Acct Details")
}
function getRefCrncyList() {
    if (!window.showModalDialog) {
        callBackFn = "getRefCrncyList_callBack"
    }
    var b = frm.refCrncy.value;
    var c = popModalWindow("../arjspmorph/" + applangcode + "/get_currency.jsp?wReturn=refCrncy&Currency=" + b, "CurrencyList");
    if (window.showModalDialog) {
        if (c != null) {
            var a = c.split("|");
            frm.refCrncy.value = a[0];
            if (b != a[0]) {
                getCrncyDetails()
            }
        }
    }
}
function getRefCrncyList_callBack(b) {
    if (b != null) {
        var a = b.split("|");
        frm.refCrncy.value = a[0];
        if (oldValue != a[0]) {
            getCrncyDetails()
        }
    }
}
