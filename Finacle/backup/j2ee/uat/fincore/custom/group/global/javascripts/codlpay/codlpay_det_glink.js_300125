function printFooterBlock()
{
	with (document) {
	if ((sReferralMode == 'I')||(sReferralMode == 'S')){
	write('<div align="left" class="ctable">');
	if (sReferralMode == 'S'){
	write('<input type="button" class="Button" id="Submit" value="SUBMIT" onClick="javascript:return doRefSubmit(this);" hotKeyId="Submit" >');
	}
	writeRefFooter();
	write('<input type="button" class="Button" id="_BackRef_" value="CANCEL" onClick="javascript:return doSubmit(this.id);" hotKeyId="Cancel" >');
	write('</div>');
	}else{
	//if(funcCode =='C'){
	write('<div class="ctable">');
	write('<input name="Submit" type="button" class="button" onClick="javascript:return codlpay_det_ONCLICK1(this,this);" id="Submit" value="Submit" hotKeyId="Submit">');
	write('<input name="Clear" type="button" class="button" onClick="javascript:return codlpay_det_ONCLICK2(this);" id="Clear" value="Clear">');
	//}else{
	//write('&nbsp;<input class="button" type="button" id="Back" value="OK" onClick="javascript:return doSubmit(this.id)" hotKeyId="Ok">');
	//}
	writeFooter();
	write('</div>');
	}
	} //End with()
}//End function
function fnOnLoad(){
        var ObjForm = document.forms[0];
        pre_ONLOAD('codlpay_det',this);
        var funcName = "this."+"locfnOnLoad";
        if(eval(funcName) != undefined){
                eval(funcName).call(this);
        }
        fnPopulateControlValues();
        fnPopUpExceptionWindow(ObjForm.actionCode);
        if((typeof(WF_IN_PROGRESS) != "undefined") && (WF_IN_PROGRESS == "PEAS")){
                checkCustErrExecNextStep(Message);
        }
        post_ONLOAD('codlpay_crit',this);
	fnCodeChng();
}
function fnCheckMandatoryFields(){
        var ObjForm = document.forms[0];
        if (fnIsNull(ObjForm.funcCode.value)){
                alert("Select the Option");
                ObjForm.funcCode.focus();
                return false;
        }
        if (fnIsNull(ObjForm.accNum.value)){
                alert("Enter Loan Account Number");
                ObjForm.accNum.focus();
                return false;
        }
        if (fnIsNull(ObjForm.OperaccNum.value)){
                alert("Enter Operative Account Number");
                ObjForm.OperaccNum.focus();
                return false;
        }
        if (fnIsNull(ObjForm.lstAdjDate.value)){
                alert("Enter Schedule to Reverse");
                ObjForm.lstAdjDate.focus();
                return false;
        }
	if(document.forms[0].funcCode.value=="R"){
		if (fnIsNull(ObjForm.refAmt.value)){
			alert("Enter Recover Amount");
			ObjForm.refAmt.focus();
			return false;
		}
	}
	/*
	if(document.forms[0].funcCode.value=="R"){
		if(document.forms[0].accNum.value != "") {
			if (fnIsNull(ObjForm.reshDate.value)){
				alert("Enter Rescheduling Date ");
				ObjForm.reshDate.focus();
				return false;
			}
		}
	}
	*/
        return true;
}
function fnPopulateControlValues(){
	var ObjForm = document.forms[0];
	ObjForm.accNum.value = accNum;
	ObjForm.OperaccNum.value = OperaccNum;
	ObjForm.funcCode.value = funcCode;
	ObjForm.refCrncy.value = refCrncy;
	ObjForm.refAmt.value = refAmt;
	ObjForm.lstAdjDate.value = lstAdjDate;
	//ObjForm.reshDate.value = reshDate;
}
function fnValidateData(){
	var ObjForm = document.forms[0];
	return true;
}
function codlpay_det_ONCLICK1(obj,p1){
	var retVal = "";
	if (pre_ONCLICK('codlpay_det',obj) == false) { 
		return false;
	}
	fnCheckMandatoryFields();
	if ((retVal = fnValAndSubmit(p1)) == false) {
		return false;
	}
	if (post_ONCLICK('codlpay_det',obj) == false) { 
		return false;
	}
	return (retVal == undefined) ? true : retVal;
}
function codlpay_det_ONCLICK2(obj){
        var retVal = "";
	document.forms[0].accNum.value = "";
	document.forms[0].OperaccNum.value = "";
	//document.forms[0].funcCode.value = "";
	document.forms[0].reshDate.value = "";
        if (preEventCall('codlpay_det',obj,'ONCLICK') == false) {
                return false;
        }
        if ((retVal =  fnClearFields()) == false) {
                return false;
        }
        if (postEventCall('codlpay_det',obj,'ONCLICK') == false) {
                return false;
        }
        return (retVal == undefined) ? true : retVal;
}
