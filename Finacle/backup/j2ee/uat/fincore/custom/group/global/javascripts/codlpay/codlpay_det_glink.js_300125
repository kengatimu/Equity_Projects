function fnGetAmt(){
	var ObjForm = document.forms[0];
	var refAmt = '0';
	var refAmt = ObjForm.refAmt.value;
	var funCode = ObjForm.funcCode.value;
	if(funCode=="R"){
		if((!fnIsNull(refAmt))){
			if (!isNumber(ObjForm.refAmt.value)) {
				alert("Enter valid number");
				return false;
			}
			var totrefAmt = parseFloat(refAmt);
			var b = getAmtInStdFormat(ObjForm.refAmt.value);
			var b = getAmtInCustomFormat(ObjForm.refAmt.value);
		}else{
			alert("Enter valid amount");
			return false;
		}
	}
}
function fnCodeChng(){
	var ObjForm = document.forms[0];
	var refAmt = '0';
	var refAmt = ObjForm.refAmt.value;
	var funCode = ObjForm.funcCode.value;
	if(funCode=="P")
	{
		var ObjForm = document.forms[0];
		ObjForm.refCrncy.value = "KES"; 
		ObjForm.refAmt.value = "000000000000000.00"; 
		ObjForm.refCrncy.disabled = true; 
		ObjForm.refAmt.disabled = true;
		ObjForm.tranId.disabled = true;
		ObjForm.lstAdjDate.disabled = true;
		hideImage("benfList1");		
	}
	if(funCode=="R")
	{
		var ObjForm = document.forms[0];
		ObjForm.refCrncy.value = "KES"; 
		ObjForm.refAmt.value = ""; 
		ObjForm.refCrncy.disabled = false; 
		ObjForm.refAmt.disabled = false;
		ObjForm.tranId.disabled = true;
		ObjForm.lstAdjDate.disabled = true;
		hideImage("benfList1");
	}
}
