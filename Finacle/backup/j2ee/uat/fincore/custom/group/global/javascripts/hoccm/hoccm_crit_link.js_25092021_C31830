function fnValidateCrit()
{
	if (document.forms[0].funcCode.value == "L")
	{
		if (document.forms[0].noOfChq.value == "")
		{
			alert(jspErrResArr.get("FAT000924"));
			document.forms[0].noOfChq.focus();
			return false;
		}
		else
		{
			if(!isInteger(document.forms[0].noOfChq.value))
			{
				alert("Enter a numeric value.");
				document.forms[0].noOfChq.value="";
				document.forms[0].noOfChq.focus();
				return false;
			}
			if (parseInt(document.forms[0].noOfChq.value) == 0)
			{
				alert("Enter value grater than zero.");
				document.forms[0].noOfChq.value="";
				document.forms[0].noOfChq.focus();
				return false;
			}
		}
		
		if (document.forms[0].totalCrAmt.value == "")
		{
			alert(jspErrResArr.get("FAT000924"));
			document.forms[0].totalCrAmt.focus();
			return false;
		}
		else
		{
			if (!fnValidateAmount(document.forms[0].totalCrAmt.value,2))
			{
				document.forms[0].totalCrAmt.focus();
				return false;
			}
			if (parseFloat(document.forms[0].totalCrAmt.value) == 0)
			{
				alert("Enter amount value grater than zero.");
				document.forms[0].totalCrAmt.value="";
				document.forms[0].totalCrAmt.focus();
				return false;
			}
		}
		//Added for UBP--START
		if(document.forms[0].billPayYes[0].checked==true)
		{
			if(document.forms[0].billerId.value == "")
			{
				alert("Enter Biller ID.");
				document.forms[0].billerId.focus();
				return false;
			}
			
			if((document.forms[0].valType.value == "R")||(document.forms[0].valType.value == "LR"))
			{
				if(document.forms[0].typOfServ.value == "")
				{
					alert("Enter Type of Service from searcher.");
					//document.forms[0].typOfServiceSerchr.focus();
					return false;
				}
			}
			//ubp start
			if((document.forms[0].funcCode.value == "L")&&(getRadioValue(document.forms[0].billPayYes)=="Y"))
			{
				if(document.forms[0].billerId.value=="KRA")
				{
					
					fnKraOutboundCallGoButton();
				}
			}
			//ubp end
		}
		//Added for UBP--END
	}
	if ((document.forms[0].funcCode.value == "D") || (document.forms[0].funcCode.value == "R"))
	{
		if (document.forms[0].setNum.value == "")
		{
			alert(jspErrResArr.get("FAT000924"));
			document.forms[0].setNum.focus();
			return false;
		}	
	}
	if (document.forms[0].funcCode.value == "P")
	{
		if (document.forms[0].critTranId.value == "")
		{
			alert(jspErrResArr.get("FAT000924"));
			document.forms[0].critTranId.focus();
			return false;
		}
		if (document.forms[0].critBatchNum.value == "")
		{
			alert(jspErrResArr.get("FAT000924"));
			document.forms[0].critBatchNum.focus();
			return false;
		}
		/*if (document.forms[0].zoneIdentifier.value == "O")
		{
			alert("Representment Mode is not allowed for Zone Code of Type O - Only Our Bank.");
			document.forms[0].funcCode.focus();
			return false;
		}
		*/
	}
	var smInstval = getRadioValue(document.forms[0].smInstrument);
	//alert("smInstrument : " + smInstval);
	if (document.forms[0].noOfChq.value != "")
	{
		if((smInstval == "S") && (parseInt(document.forms[0].noOfChq.value) != 1))
		{
			alert("If No. of cheque value is greater than 1, then Single/Multiple Instruments cannot be Single");
			document.forms[0].smInstrument[0].focus();
			return false;
		}

		if((smInstval == "M") && (parseInt(document.forms[0].noOfChq.value) == 1))
		{
			alert("If No. of cheque value is equal to 1, then Single/Multiple Instruments cannot be Multiple");
			document.forms[0].smInstrument[0].focus();
			return false;
		}
	}
	if (parseInt(document.forms[0].noOfChq.value) > 25)
	{
		alert("No. of Cheque can not be grater than 25.");
		//document.forms[0].noOfChq.value="";
		document.forms[0].noOfChq.focus();
		return false;
	}
	return true;
}


