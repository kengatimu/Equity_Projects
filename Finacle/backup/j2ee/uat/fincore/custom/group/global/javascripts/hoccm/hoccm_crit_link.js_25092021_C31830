function isInteger(number) 
{
    var count;
    for (count = 0; count < number.length; count++) 
    {
        // Check that current character is number.
        var char = number.charAt(count);
        if (((char < '0') || (char > '9'))) 
        	return false;
    }
    // All characters are numbers.
    return true;
}

