				ObjForm.smInstrument[1].disabled=true;
				ObjForm.billPayYes[0].checked=true;
				ObjForm.billPayYes[1].disabled=true;
			}
			else
			{
				ObjForm.billerId.disabled = true;
				hideImage("billerIdSerch");
				ObjForm.typOfServ.disabled = true;
				hideImage("typOfServiceSerchr");
				document.forms[0].critCrAcctNum.disabled = false;
				ObjForm.billerId.value="";
				ObjForm.typOfServ.value="";
				ObjForm.smInstrument[0].checked=true;
				ObjForm.smInstrument[0].value="S";
				ObjForm.smInstrument[1].disabled=false;
				ObjForm.valType.value="";
				ObjForm.billPayYes[1].checked=true;
			}

		}
	}
}
