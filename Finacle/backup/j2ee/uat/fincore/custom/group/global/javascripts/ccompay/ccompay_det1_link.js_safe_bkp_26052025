function fnEnableRateFields(obj){
	var ObjForm = document.forms[0];
	var drAcctNumCcy = ObjForm.acctCrncy.value.toUpperCase();
	var crAcctNumCcy = ObjForm.crAcctCrncy.value.toUpperCase();
    var refCrncy = ObjForm.commCrncy.value.toUpperCase();
	
	if((crAcctNumCcy != refCrncy) && (crAcctNumCcy != "") && (refCrncy !="")){
		fnPopulateRateCode();
	}
	
	if((crAcctNumCcy == refCrncy) && (crAcctNumCcy != "") && (refCrncy !="")){
		hideImage("sLnk3");
		ObjForm.ratecode.value = "";
		ObjForm.rate.value = "";
		ObjForm.ratecode.disabled = true;
		ObjForm.rate.disabled = true;
	}	
	return true;
}

function fnPopulateRateCode(){
	var objForm = document.forms[0];
	var crAcctCrncy = objForm.crAcctCrncy.value;
	var drAcctCrncy = objForm.commCrncy.value;
	if(objForm.drAcctNum.disabled == false){
		var pmntType = "A";
	}else{
		var pmntType = "C";
	}
	var pmntType = pmntType;
	var inputNameValues    = "varCrncy|"+crAcctCrncy+"|fxdCrncy|"+drAcctCrncy+"|pmntType|"+pmntType;
	var outputNames        = "errorFlg|errorMsg|rateCode|rate";
	var scrName            = "compay011.scr";
	var retVal             = appFnExecuteScript(inputNameValues, outputNames, scrName, false);
	var result     		   = retVal.split("|");
	var errorFlg           = result[1];
	var errorMsg           = result[3];
	if(errorFlg=="Y"){
		showImage("sLnk3");
		objForm.ratecode.disabled = false;
		objForm.rate.disabled = false;
		objForm.ratecode.focus();
		return false;
	}
	else	
	{
		hideImage("sLnk3");
		objForm.ratecode.value=result[5];
		objForm.rate.value=result[7];
		objForm.ratecode.disabled = true;
		objForm.rate.disabled = true;
		return true;
	}	
}

