function CnvrtAmtEng(amt)
{
        if(amt.indexOf(",") > -1)
        {
                var amt1= amt.split(",");
                var amt2= amt1[0].replace(/\./g,'');
                var amt3= amt1[1];
                amt= amt2 + "." + amt3;
        }
        return amt;
}

function CnvrtAmtFrnch(amt)
{
        if(amt.indexOf(".") > -1)
        {
                var amt1= amt.split(".");
                var amt2= amt1[0].replace(/\,/g,'.');
                var amt3= amt1[1];
                amt= amt2 + "," + amt3;
        }
        else
        {
               if(!fnIsNull(amt))
               {
                       amt= amt.replace(/\,/g,'');
               }
        }
        return amt;
}

