function fnPopulateAmt(){
	var objForm = document.forms[0];
	
	var	temp1=objForm.commCode.value.replace(/\s/g,'');
	objForm.commCode.value = temp1;
	if(temp1 == "")
	{
		objForm.commDesc.value="";
		objForm.commCrncy.value="";
		objForm.commAmt.value="";
		objForm.vatCrncy.value="";
		objForm.vatAmt.value="";
		return;
	} 
	var commCode = objForm.commCode.value;
	var inputNameValues    = "commCode|"+commCode;
	var outputNames        = "errorFlg|errorMsg|commCrncy|commAmt|commDesc|vatCrncy|vatAmt";
	var scrName            = "compay002.scr";
	var retVal             = appFnExecuteScript(inputNameValues, outputNames, scrName, false);
	var result      = retVal.split("|");
	var errorFlg = result[1];
	var errorMsg = result[3];
	
	if(errorFlg=="Y"){
		alert(errorMsg);
		objForm.commCode.value="";
		objForm.commDesc.value="";
		objForm.commCrncy.value="";
		objForm.commAmt.value="";
		objForm.vatCrncy.value="";
		objForm.vatAmt.value="";
		objForm.commCode.focus();
		return ;
	}  
	else{
		objForm.commCrncy.value=result[5];
		objForm.commAmt.value=result[7].replace(/\./g,',');
		objForm.commDesc.value=result[9];
		objForm.vatCrncy.value=result[11];
		objForm.vatAmt.value=result[13].replace(/\./g,',');
		newformatAmt("Million",objForm.commAmt,commCrncy,'N');
		newformatAmt("Million",objForm.vatAmt,vatCrncy,'N');
	}
	
	if(pmntType =="C")
	{
		if(!fnGetTellerAcct()){
			return false;
		}
	}
	
	if((objForm.commCrncy.value != objForm.acctCrncy.value) && (objForm.acctCrncy.value != ""))
	{
		alert("Commission Currency and Debit Account Currency should be same.");
		objForm.commCode.focus();
		return;
	}
	if(!fnEnableRateFields()){
		return false;
	}  
	if(!fnGetCreditAcctNum()){
		return false;
	}
	return true;
}

