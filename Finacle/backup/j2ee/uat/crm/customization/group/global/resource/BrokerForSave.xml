<!DOCTYPE FCRM [
	<!ELEMENT FCRM (ServiceName+)*>
	<!ELEMENT ServiceName (BoName+)>
	<!ELEMENT BoName (Class, Method, Parameter1, Parameter2, ReturnType, BOType, KeyField, Mandatory)>
	<!ELEMENT Class (#PCDATA)>
	<!ELEMENT Method (#PCDATA)>
	<!ELEMENT Parameter1 (#PCDATA)>
	<!ELEMENT Parameter2 (#PCDATA)>
	<!ELEMENT ReturnType (#PCDATA)>
	<!ELEMENT BOType (#PCDATA)>
	<!ELEMENT KeyField (#PCDATA)>
	<!ELEMENT Mandatory (#PCDATA)>
	<!ATTLIST BoName name CDATA #REQUIRED>
	<!ATTLIST ServiceName name CDATA #REQUIRED id CDATA #REQUIRED>
]>

