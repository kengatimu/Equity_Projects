<!-- Custom ValdiationDefinition
Properties file for FI online enquiries.

Contains custom validation methods

-->

<!DOCTYPE FCRM [
<!ELEMENT FCRM (ServiceName+)*>
<!ELEMENT ServiceName (ValidationMethod+)>
<!ELEMENT ValidationMethod (Channel, isShowStopper, Class, Method) >
<!ELEMENT Channel (#PCDATA)>
<!ELEMENT Class (#PCDATA)>
<!ELEMENT isShowStopper (#PCDATA)>
<!ELEMENT Method (#PCDATA)>
<!ATTLIST ServiceName name CDATA #REQUIRED>
]>

<FCRM>
<!-- Add custom services here in the format given below

		<ServiceName name="CIFRetailCustomerCreate">
		<ValidationMethod>
		<Channel>FI</Channel>
		<Class>com.infy.cis.validations.CIFRetailValidations</Class>
		<isShowStopper>N</isShowStopper>
		<Method>DCMarginPercentage</Method>
		</ValidationMethod>
		</ServiceName>
-->

		<ServiceName name="CIFRetailCustomerCreate">
		<ValidationMethod>
		<Channel>FI</Channel>
		<isShowStopper>Y</isShowStopper>
		<Class>com.infy.cis.custom.validations.EquityCustomValidations</Class>
		<Method>EquityRetailCustomValidations</Method>
		</ValidationMethod>
		</ServiceName>


		<ServiceName name="CIFCorpCustomerCreate">
		<ValidationMethod>
		<Channel>FI</Channel>
		<isShowStopper>Y</isShowStopper>
		<Class>com.infy.cis.custom.validations.EquityCustomValidations</Class>
		<Method>EquityCorporateCustomValidations</Method>
		</ValidationMethod>
		</ServiceName>


<!--Changes for tracker id 253909 end -->
</FCRM>
