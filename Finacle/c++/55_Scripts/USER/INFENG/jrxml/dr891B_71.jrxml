<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="dr891B" language="groovy" pageWidth="910" pageHeight="750" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="870" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5bc72600-6be8-4d2e-b523-a9092e5b0667">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Bank_Id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="sol_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DTD.DTH_INIT_SOL_ID,GAM.FORACID,GAM .ACCT_NAME,TRAN_CRNCY_CODE,GAM.SCHM_CODE,DTD.TRAN_AMT,DTD.TRAN_PARTICULAR,DTD.PART_TRAN_TYPE,DTD.TRAN_DATE,DTD.TRAN_ID,
DTD.PSTD_USER_ID,
DTD.VFD_USER_ID
FROM tbaadm.DTD,tbaadm.GAM,tbaadm.DTH,tbaadm.GCT
WHERE DTD.ACID = GAM.ACID
AND DTD.TRAN_ID=DTH.TRAN_ID
AND DTD.TRAN_DATE=DTH.TRAN_DATE
AND DECODE(UPPER($P{sol_id}),'ALL','ALL',DTD.DTH_INIT_SOL_ID)
= DECODE(UPPER($P{sol_id}),'ALL','ALL',UPPER($P{sol_id}))
AND dtd.DEL_FLG='N'
AND dtd.TRAN_DATE = GCT.DB_STAT_DATE
AND dtd.TRAN_TYPE = 'T'
AND dtd.TRAN_SUB_TYPE='BI'
AND SCHM_TYPE!='LAA'
AND SCHM_CODE!='INCOM'
AND dtd.PART_TRAN_TYPE IN ('C','D')
AND dtd.BANK_ID = $P{Bank_Id}
AND gam.BANK_ID = $P{Bank_Id}
AND DTH.BANK_ID = $P{Bank_Id}
AND GCT.BANK_ID = $P{Bank_Id}
AND SCHM_CODE!='BNKCH'
AND SCHM_CODE!='CASH'
AND SCHM_CODE!='OTHER'
AND DTD.PSTD_USER_ID NOT LIKE 'CDCI%'
AND GAM.LCHG_USER_ID!='CDCI'
and dtd.pstd_user_id not like 'FIVUSR%'
and dtd.tran_particular not like '%Charge%'
and dtd.tran_particular not like '%CHARGE%'
and dtd.tran_particular not like '%charge%'
-----AND INSTRMNT_TYPE!='CHQ'
AND dtd.TRAN_ID NOT LIKE '%S%'
AND dtd.PSTD_USER_ID NOT LIKE '%SYSTEM%'
AND TRAN_PARTICULAR NOT LIKE '%Issue of DD%'
AND TRAN_PARTICULAR NOT LIKE '%ISSUE OF D%'
AND TRAN_PARTICULAR NOT LIKE '%ATM ERROR%'
AND TRAN_PARTICULAR NOT LIKE 'Dormant%'
GROUP BY DTD.DTH_INIT_SOL_ID,DTD.TRAN_ID,GAM.FORACID,GAM .ACCT_NAME,TRAN_CRNCY_CODE,GAM.SCHM_CODE,DTD.TRAN_AMT,DTD.TRAN_PARTICULAR,DTD.PART_TRAN_TYPE,DTD.TRAN_DATE,DTD.TRAN_ID,DTD.PSTD_USER_ID,DTD.VFD_USER_ID
ORDER BY DTD.DTH_INIT_SOL_ID,DTD.TRAN_ID,GAM.FORACID,GAM .ACCT_NAME,TRAN_CRNCY_CODE,GAM.SCHM_CODE,DTD.TRAN_AMT,DTD.TRAN_PARTICULAR,DTD.PART_TRAN_TYPE,DTD.TRAN_DATE,DTD.TRAN_ID,DTD.PSTD_USER_ID,DTD.VFD_USER_ID]]>
	</queryString>
