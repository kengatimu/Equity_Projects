		#{
			CUST.CIETXN.targetEntity = CUST.CIETXN.debitEntity
			print(CUST.CIETXN.targetEntity)
		#}
		ENDIF
		
		IF(CUST.CIETXN.creditEntity != BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIETXN.targetEntity = CUST.CIETXN.creditEntity
			print(CUST.CIETXN.targetEntity)
		#}
		ENDIF
		
		IF((CUST.CIETXN.debitEntity != BANCS.STDIN.contextBankId) AND (CUST.CIETXN.creditEntity != BANCS.STDIN.contextBankId))THEN
		#{
			IF(CUST.CIETXN.debitEntity != CUST.CIETXN.creditEntity)THEN
			#{
				CUST.CIETXN.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^Atleast one account should belong to Initiating Entity OR Both Cr AND Dr A/c should belong to same target entity^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
				
			#}
			ENDIF
		#}
		ENDIF
		
	#}
	ENDIF
	
	########################################################################################
	# 1. Cross Country Limit Check
	########################################################################################
	
	IF(CUST.CIETXN.targetEntity != "")THEN
	#{
		CUST.CIETXN.parameterId = CUST.CIETXN.txnType + "_CROSS_CNTRY_LIMIT_" + CUST.CIETXN.targetEntity + "_" + CUST.CIETXN.refCrncy
		print(CUST.CIETXN.parameterId)
		
		sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.parameterId = CUST.CIETXN.txnType + "_CROSS_CNTRY_LIMIT_" + CUST.CIETXN.targetEntity + "_" + BANCS.STDIN.homeCrncyCode
			print(CUST.CIETXN.parameterId)
			sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				CUST.CIETXN.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^Cross Country Transaction Amount Limit Not Maintained in CPARAM for Home Currency. Parameter Id is " + CUST.CIETXN.parameterId + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CIETXN.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIETXN.parameterValue)
			
			CUST.CIETXN.crossCntryLim = CDOUBLE(CUST.CIETXN.parameterValue)
			print(CUST.CIETXN.crossCntryLim)
			
			#########################################################################################
			# Get the Rate Code for Calculation of Limit
			#########################################################################################
			
			CUST.CIETXN.parameterId = CUST.CIETXN.txnType + "_RATE_CODE_" + CUST.CIETXN.targetEntity
			print(CUST.CIETXN.parameterId)
			sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				CUST.CIETXN.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^Rate Code Not Maintained in CPARAM to find Limit value in Home Ccy. Parameter Id is " + CUST.CIETXN.parameterId + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CIETXN.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIETXN.parameterValue)
			
			CUST.CIETXN.limitRateCode = CUST.CIETXN.parameterValue
			PRINT(CUST.CIETXN.limitRateCode)
			
			#########################################################################################
			# Convert Amount
			#########################################################################################
			
			BANCS.INPARAM.InputAmount = CUST.CIETXN.refAmt
			BANCS.INPARAM.FromCurrency = CUST.CIETXN.refCrncy
			BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.RateCode = CUST.CIETXN.limitRateCode
			BANCS.INPARAM.Rate = 0.00
			BANCS.INPARAM.CustId = ""
			
			sv_u = urhk_B2k_ConvertAmount("")
			print(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				CUST.CIETXN.convertedRefAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				print(CUST.CIETXN.convertedRefAmt)
				#}
			ELSE
				#{
				CUST.CIETXN.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^Unable to find Limit value in Home Ccy^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			IF(CDOUBLE(CUST.CIETXN.convertedRefAmt) > CDOUBLE(CUST.CIETXN.crossCntryLim))THEN
			#{
				CUST.CIETXN.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				CUST.CIETXN.crossCntryLim = Format$(CDOUBLE(CUST.CIETXN.crossCntryLim),"%12.02f")
				sv_s = "Error_1|Error^Cross Country Transaction Amount Limit Exceeded. Limit is "+ CUST.CIETXN.crossCntryLim + " " + BANCS.STDIN.homeCrncyCode + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.CIETXN.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIETXN.parameterValue)
			
			CUST.CIETXN.crossCntryLim = CDOUBLE(CUST.CIETXN.parameterValue)
			print(CUST.CIETXN.crossCntryLim)
			
			IF(CDOUBLE(CUST.CIETXN.refAmt) > CDOUBLE(CUST.CIETXN.crossCntryLim))THEN
			#{
				CUST.CIETXN.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				CUST.CIETXN.crossCntryLim = Format$(CDOUBLE(CUST.CIETXN.crossCntryLim),"%12.02f")
				sv_s = "Error_1|Error^Cross Country Transaction Amount Limit Exceeded. Limit is "+ CUST.CIETXN.crossCntryLim + " " + CUST.CIETXN.refCrncy + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
