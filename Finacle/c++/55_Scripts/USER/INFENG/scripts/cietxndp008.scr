CHECKSUM="57144b3901baeea7f21ad2195f0edd42d460a1885c3f76d84db4e5e44f3812d9"
	TRACE ON
	
	CUST.CIETXN.scriptSuccess = "Y"
	
	print(CUST.CIETXN.txnType)
	print(CUST.CIETXN.refCrncy)
	print(CUST.CIETXN.refAmt)
	print(BANCS.STDIN.roleId)
	print(BANCS.STDIN.contextBankId)
	
	CUST.CIETXN.crossCntryLim = ""
	CUST.CIETXN.userRoleLim = ""
	
	IF((CUST.CIETXN.txnType == "CD") OR (CUST.CIETXN.txnType == "CW"))THEN
	#{
		print(CUST.CIETXN.targetEntity)
		
	#}
	ENDIF
	
	IF(CUST.CIETXN.txnType == "TT")THEN
	#{
