#---------------------------------------------------------------------------------------------------------------->
#    Name              :   s_ecsvalmn001.scr
#    Description       :   This script checks the referenc field 1 and
#					   :   if it is blanks it shows the alert and it avoids the special characters in other party a/c id.
#    Date              :   28-01-2012
#    Author            :   Manoj
#    Called By         :   None
#    Calling jsp       :   None
#    Menu Option       :   HECSM.
#    Modification History:
#    Sl No.             Date          Author               		Description
#   ---------         ----------      ------------------    	---------------------
#     0.1            28-01-2012   	  Manoj						Original Version
#---------------------------------------------------------------------------------------------------------------->
<--START
CHECKSUM="4a4ec09797c1678762d35df9107887c504d3c59fbd84aaa8f4b6f470d9eb010f"
	TRACE ON
	
	#-----------------------------------------------
	# Creating Repository
	#-----------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	CUST.DATA.partyAcctId = ""
	CUST.DATA.refId = ""
	
	sv_z = urhk_SRV_GetVal("ecsMandateDtl.refId1")
	
	IF (sv_z != 0) THEN
	#{
		GOTO FINISH
	#}
	ENDIF
	
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.refId = BANCS.OUTPARAM.srvValue
	
	IF (CUST.DATA.refId == "") THEN
	#{
		sv_u = urhk_SRV_SetErr("ecsMandateDtl.refId1|The particulars field Reference ID 1 should not be left blank.")
	#}
	ENDIF
	
	sv_z = urhk_SRV_GetVal("ecsMandateDtl.otherPartyAcctId")
	
	IF (sv_z != 0) THEN
	#{
		GOTO FINISH
	#}
	ENDIF
	
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.partyAcctId=BANCS.OUTPARAM.srvValue
	sv_w = CUST.DATA.partyAcctId
	
	sv_a= getposition(sv_w ,".")
	print(sv_a)
	sv_b= getposition(sv_w ,",")
	print(sv_b)
	sv_c= getposition(sv_w ,"/")
	print(sv_c)
	sv_d= getposition(sv_w ,"\")
	print(sv_d)
	sv_e= getposition(sv_w ,"*")
	print(sv_e)
	sv_f= getposition(sv_w ,"-")
	print(sv_f)
	sv_g= getposition(sv_w ,",")
	print(sv_g)
	sv_h= getposition(sv_w ,";")
	print(sv_h)
	sv_i= getposition(sv_w ,":")
	print(sv_i)
	sv_j= getposition(sv_w ,"&")
	print(sv_j)
	sv_k= getposition(sv_w ,"_")
	print(sv_k)
	
	IF (((sv_a > CINT("0")) OR (sv_b > CINT("0")) OR (sv_c > CINT("0")) OR (sv_d > CINT("0"))OR (sv_e > CINT("0"))OR (sv_f > CINT("0"))OR (sv_g > CINT("0"))OR (sv_h > CINT("0"))OR (sv_i > CINT("0")) OR (sv_j > CINT("0")) OR (sv_k > CINT("0")))) THEN
	#{
		sv_u = urhk_SRV_SetErr("ecsMandateDtl.otherPartyAcctId|Special characters (. , / \ - * , ; : & _ )are not allowed in the other party a/c id ")
	#}
	ENDIF
	FINISH:
		EXITSCRIPT
		TRACE OFF
END-->
