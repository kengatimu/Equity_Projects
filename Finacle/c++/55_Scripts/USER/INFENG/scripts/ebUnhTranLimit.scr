#UNHCR Beneficary Credit Limit Validation
#13/11/2019
<--start
trace on
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	sv_u = urhk_GetChannelInfo("")
	if(sv_u==0)then
		EBSRV.GLBDATA.chnlId = BANCS.OUTPARAM.DccId
	else
		exitscript	
	endif
	if(EBSRV.GLBDATA.chnlId == "UNH")then
		goto CRVAL
	else
		goto VAYU
	endif
#SrvValues
	CRVAL:	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	##if ((EBSRV.GLBDATA.tranSubType == "NP") or (EBSRV.GLBDATA.tranSubType=="CP") or (EBSRV.GLBDATA.tranSubType=="NR") or (EBSRV.GLBDATA.tranSubType=="CR"))then
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EBSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EBSRV.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_rmks)
		sv_l = strlen(EBSRV.GLBDATA.tran_amt)
		sv_f = mid$(EBSRV.GLBDATA.tran_amt,0,sv_l)
		sv_l = strlen(EBSRV.GLBDATA.tran_amt)
		sv_p = getposition(sv_f,"|")
		EBSRV.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
		EBSRV.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
		print(EBSRV.GLBDATA.trans_amt)
		print(EBSRV.GLBDATA.trans_crncy)
		print(EBSRV.GLBDATA.tran_amt)
		if((EBSRV.GLBDATA.partTranType=="C") and (cdouble(EBSRV.GLBDATA.trans_amt)>250000))then
		##if((EBSRV.GLBDATA.partTranType=="C") and (cdouble(EBSRV.GLBDATA.trans_amt)>100))then
			sv_r=urhk_B2k_PutUserException("UNC")
		endif
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	##endif
VAYU:	
	####if(classexists("EBSRV","GLBDATA")==1) then
		####deleteclass("EBSRV","GLBDATA")
	####endif
	####if(repexists("EBSRV")==1) then
		####deleterep("EBSRV")
	####endif
	exitscript
##trace off
end-->
