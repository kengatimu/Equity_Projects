########################################################################################################
# rate request
########################################################################################################
<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

IF( (FIELDEXISTS(("BANCS").("INPUT").("BankId"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Bank id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.BankId=BANCS.INPUT.BankId
	print(CUST.DATA.BankId)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("from_cncy"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply from_cncy"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.from_cncy=BANCS.INPUT.from_cncy
	print(CUST.DATA.from_cncy)
ENDIF


IF( (FIELDEXISTS(("BANCS").("INPUT").("to_crncy"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply to_crncy"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.to_crncy=BANCS.INPUT.to_crncy
	print(CUST.DATA.to_crncy)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("tran_crncy"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply tran_crncy"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.tran_crncy=BANCS.INPUT.tran_crncy
	print(CUST.DATA.tran_crncy)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("rate_code"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply rate_code"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.rate_code=BANCS.INPUT.rate_code
	print(CUST.DATA.rate_code)
	BANCS.INPARAM.BINDVARS =  CUST.DATA.rate_code + "|" +BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_u = "count|SELECT count(1) FROM tbaadm.rtl "
	sv_u = sv_u + " where  RATECODE= ?SVAR "
	sv_u = sv_u + " AND BANK_ID = ?SVAR and del_flg='N' "
	print(sv_u)
	sv_y=urhk_dbSelectWithBind(sv_u)
	print(sv_y)
	if (sv_y == "0") then
		CUST.DATA.count=BANCS.OUTPARAM.count
		print(CUST.DATA.count)
		if (CUST.DATA.count==0) then
			CUST.DATA.errMsg="Kindly Supply Valid rate_code"
			sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
			GOTO End
		endif
	endif
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("free_text"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply free_text"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.free_text=BANCS.INPUT.free_text
	print(CUST.DATA.free_text)
ENDIF

############################################
# Fetching the value from table
############################################

BANCS.INPARAM.BINDVARS =CUST.DATA.from_cncy + "|" + CUST.DATA.to_crncy
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.rate_code + "|" +BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
sv_u = sv_u + " AND RATECODE= ?SVAR "
sv_u = sv_u + " AND BANK_ID = ?SVAR  and rownum<2 "
print(sv_u)
sv_y=urhk_dbSelectWithBind(sv_u)
print(sv_y)
if (sv_y == "0") then
	sv_k = BANCS.OUTPARAM.fxdcrncycode
	print(sv_k)
	sv_j = BANCS.OUTPARAM.ratecode
	print(sv_j)
	sv_p = BANCS.OUTPARAM.Rate
	print(sv_p)
	CUST.DATA.rate = sv_p
	print(CUST.DATA.rate)
	sv_x= BANCS.OUTPARAM.treaRate
	print(sv_x)
	CUST.DATA.treaRate = sv_x
	print(CUST.DATA.treaRate)
	sv_e=urhk_SetOrbOut("StattusCode|1")

	CUST.DATA.fixed_crncy = CUST.DATA.from_cncy
	print(CUST.DATA.fixed_crncy)
	CUST.DATA.var_crncy = CUST.DATA.to_crncy
	print(CUST.DATA.var_crncy)

	sv_z = urhk_SetOrbOut("FIXED_CRNCY|"+CUST.DATA.fixed_crncy)
	print(sv_z)
	sv_z = urhk_SetOrbOut("VAR_CRNCY|"+CUST.DATA.var_crncy)
	print(sv_z)

	sv_z = urhk_SetOrbOut("RATE|"+CUST.DATA.rate)
	print(sv_z)
	sv_z = urhk_SetOrbOut("TREARATE|"+CUST.DATA.treaRate)
	print(sv_z)
else
	BANCS.INPARAM.BINDVARS = CUST.DATA.to_crncy + "|" + CUST.DATA.from_cncy 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.rate_code + "|" +BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
	sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
	sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
	sv_u = sv_u + " AND RATECODE= ?SVAR "
	sv_u = sv_u + " AND BANK_ID = ?SVAR and rownum<2 "
	print(sv_u)
	sv_y=urhk_dbSelectWithBind(sv_u)
	print(sv_y)
	if (sv_y == "0") then
		sv_k = BANCS.OUTPARAM.fxdcrncycode
		print(sv_k)
		sv_j = BANCS.OUTPARAM.ratecode
		print(sv_j)
		sv_p = BANCS.OUTPARAM.Rate
		print(sv_p)
		CUST.DATA.rate = sv_p
		print(CUST.DATA.rate)
		sv_x= BANCS.OUTPARAM.treaRate
		print(sv_x)
		CUST.DATA.treaRate = sv_x
		print(CUST.DATA.treaRate)
		sv_e=urhk_SetOrbOut("StattusCode|1")

		CUST.DATA.fixed_crncy = CUST.DATA.to_crncy
		print(CUST.DATA.fixed_crncy)
		CUST.DATA.var_crncy = CUST.DATA.from_cncy
		print(CUST.DATA.var_crncy)

		sv_z = urhk_SetOrbOut("FIXED_CRNCY|"+CUST.DATA.fixed_crncy)
		print(sv_z)
		sv_z = urhk_SetOrbOut("VAR_CRNCY|"+CUST.DATA.var_crncy)
		print(sv_z)

		sv_z = urhk_SetOrbOut("RATE|"+CUST.DATA.rate)
		print(sv_z)
		sv_z = urhk_SetOrbOut("TREARATE|"+CUST.DATA.treaRate)
		print(sv_z)
	ELSE
		CUST.DATA.errMsg="Rate Not Maintained"
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	endif
endif

End:
EXITSCRIPT
trace off
end-->

