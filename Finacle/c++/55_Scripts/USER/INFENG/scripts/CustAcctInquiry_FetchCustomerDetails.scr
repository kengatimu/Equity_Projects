#----------------------------------------------------------------------------------------------------------
# Filename              :       CustAcctInquiry_FetchCustomerDetails.scr
# Author                :       Venkatesh T R
# Description           :       This script fetches the values of a given Customer ID
# Input                 :       Customer ID
# Output                :       Success or Failure
# Called Script         :       CustAcctInquiry_FetchCustAddress.scr
# Calling Script        :       CustAcctInquiry_main.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Venkatesh          Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
#trace on
	#++++++++++++++++++++++++++++++++++ Ken +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	sv_a = urhk_GetChannelInfo("")
        print(sv_a)
        CUST.INTERFACE.DccId =BANCS.OUTPARAM.DccId
        print(CUST.INTERFACE.DccId)
	IF(CUST.INTERFACE.DccId=="FNT") THEN
		CUST.INTERFACE.CustVerifyStatus	= ""
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankID + "|" + CUST.INTERFACE.customerID
		sv_s = "recordstatus | select recordstatus from crmuser.accounts where bank_id=?SVAR and orgkey=?SVAR "
		sv_d = urhk_dbSelectWithBind(sv_s)
		if(sv_d==0)then
			CUST.INTERFACE.recStatus	= BANCS.OUTPARAM.recordstatus
		else
			CUST.INTERFACE.recStatus	= "" 
		endif
		if(CUST.INTERFACE.recStatus == "I")then
			CUST.INTERFACE.CustVerifyStatus = "N"
		endif
		if(CUST.INTERFACE.recStatus == "A")then
			CUST.INTERFACE.CustVerifyStatus = "Y"
		endif
	ENDIF
	#++++++++++++++++++++++++++++++++++ Ken +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	#---------------------------------------------------------------------------------
	# Fetch the Customer Details from CMG table
	#---------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID
	sv_s = "prefEntityDocId,custID,custShortName,custTitleCode,custName,custSex,custCommuCode,custMinorFlg,custNREFlg,"
	sv_s = sv_s + "custNationalID,custDOB,custPassportNo,passportExpDate,custFirstName,custLastName,custCorpID,custHlth|"
	sv_s = sv_s + "SELECT (select t.ENTITYDOCUMENTID from crmuser.entitydocument t where t.bank_id=CMG.BANK_ID and orgkey=CIF_ID and preferreduniqueid='Y' and rownum <2) entitydocid,CUST_ID,CUST_SHORT_NAME,CUST_TITLE_CODE,CUST_NAME,CUST_SEX,CUST_COMMU_CODE,"
	sv_s = sv_s + "CUST_MINOR_FLG,CUST_NRE_FLG,NAT_ID_CARD_NUM,to_char(DATE_OF_BIRTH,'DD-MM-YYYY'),PSPRT_NUM,"
	sv_s = sv_s + "to_char(PSPRT_EXP_DATE,'DD-MM-YYYY'),CUST_FIRST_NAME,CUST_LAST_NAME,CORP_ID,CUST_HLTH_CODE"
	sv_s = sv_s + " FROM TBAADM.CMG WHERE CIF_ID = ?SVAR AND BANK_ID = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.INTERFACE.custID = BANCS.OUTPARAM.custID
		CUST.INTERFACE.custShortName = BANCS.OUTPARAM.custShortName
		CUST.INTERFACE.custTitleCode = BANCS.OUTPARAM.custTitleCode
		CUST.INTERFACE.custName = BANCS.OUTPARAM.custName
		CUST.INTERFACE.custSex = BANCS.OUTPARAM.custSex
		CUST.INTERFACE.custCommuCode = BANCS.OUTPARAM.custCommuCode
		CUST.INTERFACE.custMinorFlg = BANCS.OUTPARAM.custMinorFlg
		CUST.INTERFACE.custNREFlg = BANCS.OUTPARAM.custNREFlg
		CUST.INTERFACE.custNationalID = BANCS.OUTPARAM.custNationalID
		CUST.INTERFACE.custDOB = BANCS.OUTPARAM.custDOB
		CUST.INTERFACE.custPassportNo = BANCS.OUTPARAM.custPassportNo
		CUST.INTERFACE.passportExpDate= BANCS.OUTPARAM.passportExpDate
		CUST.INTERFACE.custFirstName = BANCS.OUTPARAM.custFirstName
		CUST.INTERFACE.custLastName = BANCS.OUTPARAM.custLastName
		CUST.INTERFACE.custCorpID = BANCS.OUTPARAM.custCorpID
		CUST.INTERFACE.custHlth = BANCS.OUTPARAM.custHlth
		CUST.INTERFACE.prefEntityDocId = BANCS.OUTPARAM.prefEntityDocId
		print(CUST.INTERFACE.custID)
		print(CUST.INTERFACE.custShortName)
		print(CUST.INTERFACE.custTitleCode)
		print(CUST.INTERFACE.custName)
		print(CUST.INTERFACE.custSex)
		print(CUST.INTERFACE.custCommuCode)
		print(CUST.INTERFACE.custMinorFlg)
		print(CUST.INTERFACE.custNREFlg)
		print(CUST.INTERFACE.custNationalID)
		print(CUST.INTERFACE.custDOB)
		print(CUST.INTERFACE.custPassportNo)
		print(CUST.INTERFACE.passportExpDate)
		print(CUST.INTERFACE.custFirstName)
		print(CUST.INTERFACE.custLastName)
		print(CUST.INTERFACE.custCorpID)
		print(CUST.INTERFACE.custHlth)
		print(CUST.INTERFACE.prefEntityDocId)
		
	      
		IF((CUST.INTERFACE.custNationalID == "") AND (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "43")) THEN
		#{##
		  IF (FIELDEXISTS(CUST.INTERFACE.DccId) == 1)  THEN
			IF((CUST.INTERFACE.DccId == "EXP") OR (CUST.INTERFACE.DccId == "PHS")) THEN
			#{ 
			BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.customerID
			print(BANCS.INPARAM.BINDVARS)
			sv_s = "refNumber|"
			sv_s = sv_s + "select UNIQUEID from crmuser.accounts where bank_id = ?SVAR  and orgkey = ?SVAR "
			sv_s = sv_s + "and UNIQUEIDTYPE in ('IDTypeR1','Passport Number','Driving Licence','IDTypeR5') and rownum <2 "
			print(sv_s)
			sv_d =  urhk_dbSelectWithBind(sv_s)
			print(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.INTERFACE.custNationalID = BANCS.OUTPARAM.refNumber
					print(CUST.INTERFACE.custNationalID)
				#}
				ELSE
				#{
					CUST.INTERFACE.custNationalID = ""			
				#}
				ENDIF	
			#}
			ENDIF
		 ENDIF

		#}
	       ENDIF


	##########################james 06/04/2023 CHG0032076############################
		IF(BANCS.STDIN.contextBankId == "54")THEN
		#{
			IF(CUST.INTERFACE.DccId=="OMN")THEN
			#{
				CUST.INTERFACE.doccode = ""
				CUST.INTERFACE.permitExpiryDate=""
				CUST.INTERFACE.docExpDate = ""
				CUST.INTERFACE.PrefdocDesc =""
				CUST.INTERFACE.PrefExpDate =""

				sv_s = "doccode, docDesc,ExpDate,prefflg|SELECT DOCCODE, DOCDESCR,to_char(DOCEXPIRYDATE,'DD-MM-YYYY'),PREFERREDUNIQUEID FROM CRMUSER.ENTITYDOCUMENT "
				sv_s = sv_s + "WHERE BANK_ID=?SVAR and core_cust_id=?SVAR and orgkey=?SVAR"
		
				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.custID + "|" + CUST.INTERFACE.customerID  
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_v = urhk_dbcursorOpenWithBind(sv_s)
       				PRINT(sv_v)	

				IF(sv_v == 0) THEN
       	 			#{
        				CUST.INTERFACE.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       					print(CUST.INTERFACE.CURSOR_NUMBER)
       					sv_b = urhk_dbCursorFetch(CUST.INTERFACE.CURSOR_NUMBER)
        				print(sv_b)

					sv_i=1
					print(sv_i)
					WHILE(sv_b == "0")
        				#{
						CUST.INTERFACE.doccode= BANCS.OUTPARAM.doccode
						print(CUST.INTERFACE.doccode)
						CUST.INTERFACE.docDesc= BANCS.OUTPARAM.docDesc
						print(CUST.INTERFACE.docDesc)
						CUST.INTERFACE.ExpDate= BANCS.OUTPARAM.ExpDate
						print(CUST.INTERFACE.ExpDate)
						CUST.INTERFACE.prefflg= BANCS.OUTPARAM.prefflg
						print(CUST.INTERFACE.prefflg)
						IF(CUST.INTERFACE.doccode=="PERMT")THEN
						#{
							CUST.INTERFACE.permitExpiryDate = CUST.INTERFACE.ExpDate
						#}
						ENDIF
						IF(CUST.INTERFACE.doccode=="ALNID")THEN
						#{
							CUST.INTERFACE.docExpDate= CUST.INTERFACE.ExpDate
						#}
						ENDIF
						IF(CUST.INTERFACE.prefflg=="Y")THEN
						#{
							CUST.INTERFACE.PrefdocDesc= CUST.INTERFACE.docDesc
							CUST.INTERFACE.PrefExpDate= CUST.INTERFACE.ExpDate
						#}
						ENDIF

       						GOTO NEXTREC
      						BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
        					PRINT(BANCS.INPUT.RECCOUNT)

        					NEXTREC:
						sv_i = sv_i + 1 
       						sv_b = urhk_dbCursorFetch(CUST.INTERFACE.CURSOR_NUMBER)
       						print(sv_b)
					#}
					DO
					sv_x = urhk_dbCursorClose(CUST.INTERFACE.CURSOR_NUMBER)
        				print(sv_x)
				#}
				ENDIF	
			#}
			ENDIF
		#}
		ENDIF

	##########################james 06/04/2023 CHG0032076############################

	#}
	ELSE
	#{
		CUST.INTERFACE.successOrFailure = "F"
		CUST.INTERFACE.errorCode = "ERR002"
		GOTO ERROREXIT
	#}
	ENDIF
#$$$$$$$$
	##########################james 06/04/2023 CHG0032076############################
    #---------------------------------------------------------------------------------
    # --------------------------------------KRA field --------------------------------
    #---------------------------------------------------------------------------------
	IF(BANCS.STDIN.contextBankId == "54")THEN
	#{
		IF(CUST.INTERFACE.DccId=="OMN")THEN
		#{
			sv_s = "KRAPIN|SELECT Cust_Swift_Code_Desc "
			sv_s = sv_s + "FROM CRMUSER.ACCOUNTS "
			sv_s = sv_s + "WHERE BANK_ID=?SVAR AND ORGKEY=?SVAR"
		
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.customerID  
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_r =  urhk_dbSelectWithBind(sv_s)
			print(sv_r)
			IF (sv_r ==0) THEN
			#{
				CUST.INTERFACE.KRAPIN= TRIM(BANCS.OUTPARAM.KRAPIN)
				print (CUST.INTERFACE.KRAPIN)
			#}
			ELSE
			#{
				CUST.INTERFACE.KRAPIN=""
			#}
			ENDIF
		#}
		ENDIF

	#}
	ENDIF
	##########################james 06/04/2023 CHG0032076############################

        #---------------------------------------------------------------------------------
        # Set Retail corporate flag
        #---------------------------------------------------------------------------------
        IF(CUST.INTERFACE.custCorpID != "") THEN
        #{
		CUST.INTERFACE.retCorpFlg = "C"
	#}
	ELSE
	#{
		CUST.INTERFACE.retCorpFlg = "R"
	#}
	ENDIF

        #---------------------------------------------------------------------------------
        # Fetch date of incorporation of the corporate customer
        #---------------------------------------------------------------------------------
        IF(CUST.INTERFACE.custCorpID != "") THEN
        #{
                BANCS.INPARAM.BINDVARS = CUST.INTERFACE.custCorpID + "|" + CUST.INTERFACE.bankID
                sv_s = "dateOfIncorp,constCode,compRegNo,secRegNo|" 
		sv_s = sv_s + " SELECT to_char(DATE_OF_INCORPORATION,'DD-MM-YYYY'),CUST_CONST_CODE,REGISTRATION_NUMBER,SECTOR "
		sv_s = sv_s + " FROM CRMUSER.CORPORATE WHERE"
                sv_s = sv_s + " CORP_ID = ?SVAR AND BANK_ID = ?SVAR"
                sv_d = urhk_dbSelectWithBind(sv_s)
                IF(sv_d == 0) THEN
                #{
                        CUST.INTERFACE.dateOfIncorp= BANCS.OUTPARAM.dateOfIncorp
                        CUST.INTERFACE.constCode= BANCS.OUTPARAM.constCode
                        CUST.INTERFACE.compRegNo= BANCS.OUTPARAM.compRegNo
                        CUST.INTERFACE.secRegNo= BANCS.OUTPARAM.secRegNo
                #}
                ELSE
                #{
                        CUST.INTERFACE.dateOfIncorp= ""
                        CUST.INTERFACE.constCode= ""
                        CUST.INTERFACE.compRegNo= ""
                        CUST.INTERFACE.secRegNo= ""
                #}
                ENDIF
        #}
        ELSE
        #{
                CUST.INTERFACE.dateOfIncorp= ""
                CUST.INTERFACE.constCode= ""
                CUST.INTERFACE.compRegNo= ""
                CUST.INTERFACE.secRegNo= ""
        #}
        ENDIF


	#---------------------------------------------------------------------------------
	# Fetch Marital Status of the customer of the customer
	#---------------------------------------------------------------------------------
	IF(CUST.INTERFACE.custCorpID == "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID
		sv_s = "custMaritalStatus,nationality|SELECT MARITAL_STATUS,NATIONALITY FROM CRMUSER.DEMOGRAPHIC WHERE"
		sv_s = sv_s + " ORGKEY = ?SVAR AND BANK_ID = ?SVAR AND rownum<2"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.custMaritalStatus = BANCS.OUTPARAM.custMaritalStatus
			CUST.INTERFACE.nationality = BANCS.OUTPARAM.nationality
		#}
		ELSE
		#{
			CUST.INTERFACE.custMaritalStatus = ""
			CUST.INTERFACE.nationality = ""
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.INTERFACE.custMaritalStatus = ""
		CUST.INTERFACE.nationality = ""
	#}
	ENDIF
        #---------------------------------------------------------------------------------
	# Fetch Financial card number of the customer of the customer
	#---------------------------------------------------------------------------------
	IF(CUST.INTERFACE.custCorpID == "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID 
		sv_s = "fincardno|select FREE_TEXT_1   from crmuser.coreinterface  where"
		sv_s = sv_s + " ORGKEY = ?SVAR AND BANK_ID = '56'"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.fincardno = BANCS.OUTPARAM.fincardno
		#}
		ELSE
		#{
			CUST.INTERFACE.fincardno = ""
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.INTERFACE.fincardno = ""
	#}
	ENDIF	
	#---------------------------------------------------------------------------------
	# Get Asset Classification Details
	#---------------------------------------------------------------------------------	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.custID + "|" + CUST.INTERFACE.bankID
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "CUSTR" + "|" + "Y" + "|" + "N"	
	sv_s = "userSubClassification|SELECT SUB_CLASSIFICATION_USER FROM TBAADM.ACD WHERE"
	sv_s = sv_s + " B2K_ID = ?SVAR AND BANK_ID = ?SVAR AND B2K_TYPE = ?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG = ?SVAR AND DEL_FLG = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN	
	#{
		CUST.INTERFACE.userSubClassification = BANCS.OUTPARAM.userSubClassification
	#}
	ELSE
	#{
		CUST.INTERFACE.userSubClassification = ""
	#}
	ENDIF	

	#--------------------------------------------------------------
	## Adding VisionSBU and Location Details for Rwanda
	#--------------------------------------------------------------
	IF (BANCS.STDIN.contextBankId == "50") THEN
	#{
		IF (CUST.INTERFACE.DccId== "NGN") THEN
		#{
			CUST.INTERFACE.Segmentation	= "" 
			CUST.INTERFACE.Location	= "" 
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankID + "|" + CUST.INTERFACE.customerID
		sv_s = "SegmentCode,Village,locCode | select SEGMENTATION_CLASS,PLACEOFBIRTH, SUBSTR(PLACEOFBIRTH,-5) from crmuser.accounts where bank_id=?SVAR and orgkey=?SVAR "
		sv_d = urhk_dbSelectWithBind(sv_s)
			if(sv_d==0)then
				CUST.INTERFACE.SegmentCode	= BANCS.OUTPARAM.SegmentCode
				print(CUST.INTERFACE.SegmentCode)
				CUST.INTERFACE.Village	= BANCS.OUTPARAM.Village
				print(CUST.INTERFACE.Village)
				CUST.INTERFACE.locCode	= BANCS.OUTPARAM.locCode
				print(CUST.INTERFACE.locCode)
			else
				CUST.INTERFACE.SegmentCode	= "" 
				CUST.INTERFACE.Village= ""
				CUST.INTERFACE.locCode= ""
			endif

			IF(CUST.INTERFACE.SegmentCode != "")THEN

			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankID + "|" + CUST.INTERFACE.SegmentCode
			sv_s = "Segmentation | select localetext from CRMUSER.CATEGORY_LANG  where categoryid in (select categoryid from CRMUSER.CATEGORIES "
			sv_s = sv_s + "where bank_id = ?SVAR and categorytype ='SEGMENTATION_CLASS' and   value = ?SVAR) "
			print (sv_s)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
				if(sv_d==0)then
					CUST.INTERFACE.Segmentation	= BANCS.OUTPARAM.Segmentation
					print(CUST.INTERFACE.Segmentation)
				endif
			ELSE
				CUST.INTERFACE.Segmentation = ""
			#}
			ENDIF
			
			IF(CUST.INTERFACE.locCode != "")THEN
			#{
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankID + "|" + CUST.INTERFACE.locCode
			sv_b = "Location| select REF_DESC from tbaadm.rct where bank_id = ?SVAR and REF_code  = ?SVAR "
			sv_b = sv_b + "and REF_REC_TYPE = '01' "
			print (sv_b)
			sv_c = urhk_dbSelectWithBind(sv_b)
				if(sv_c==0)then
					CUST.INTERFACE.Location	= BANCS.OUTPARAM.Location
					print(CUST.INTERFACE.Location)
				endif
			#}
			ENDIF


		#}
		ENDIF
	#}
	ENDIF

	#---------------------------------------------------------------------------------
	# Fetch Customer Permanent and Communication Address
	#---------------------------------------------------------------------------------
	CALL("CustAcctInquiry_FetchCustAddress.scr")
	
trace off
end-->
