		#{
			PRINT(sv_c)
			sv_c = 10 - sv_c
			PRINT(sv_c)
			
			CUST.MISC.instPayingAcct = LPAD(CUST.MISC.instPayingAcct,10,'0')
			PRINT(CUST.MISC.instPayingAcct)
		#}
		ENDIF
		
		CUST.MISC.instTranCode  = CUST.MISC.instPayingAcct  + CUST.MISC.instBankCode + CUST.MISC.instBranchCode
		PRINT(CUST.MISC.instTranCode)
		
		CUST.MISC.chr1 = MID$(CUST.MISC.instPayingAcct,9,1)
		PRINT(CUST.MISC.chr1)
		
		CUST.MISC.chr3 = MID$(CUST.MISC.instPayingAcct,7,1)
		PRINT(CUST.MISC.chr3)
		
		CUST.MISC.chr5 = MID$(CUST.MISC.instPayingAcct,5,1)
		PRINT(CUST.MISC.chr5)
		
		CUST.MISC.chr7 = MID$(CUST.MISC.instPayingAcct,3,1)
		PRINT(CUST.MISC.chr7)
		
		CUST.MISC.chr9 = MID$(CUST.MISC.instPayingAcct,1,1)
		PRINT(CUST.MISC.chr9)
		
		CUST.MISC.chr11 = MID$(CUST.MISC.instBankCode,1,1)
		PRINT(CUST.MISC.chr11)
		
		CUST.MISC.chr13 = MID$(CUST.MISC.instBranchCode,1,1)
		PRINT(CUST.MISC.chr13)
		
		CUST.MISC.firststring = CINT(CUST.MISC.chr1) + CINT(CUST.MISC.chr3) + CINT(CUST.MISC.chr5) + CINT(CUST.MISC.chr7) + CINT(CUST.MISC.chr9) + CINT(CUST.MISC.chr11) + CINT(CUST.MISC.chr13)
		PRINT(CUST.MISC.firststring)
		
		CUST.MISC.chr2 = MID$(CUST.MISC.instPayingAcct,8,1)
		PRINT(CUST.MISC.chr2)
		
		CUST.MISC.chr2a = CINT(CUST.MISC.chr2) * CINT("2")
		CUST.MISC.chr4 = MID$(CUST.MISC.instPayingAcct,6,1)
		PRINT(CUST.MISC.chr4)
		
		CUST.MISC.chr4a = CINT(CUST.MISC.chr4) * CINT("2")
		
		CUST.MISC.chr6 = MID$(CUST.MISC.instPayingAcct,4,1)
		PRINT(CUST.MISC.chr6)
		
		CUST.MISC.chr6a = CINT(CUST.MISC.chr6) * CINT("2")
		
		CUST.MISC.chr8 = MID$(CUST.MISC.instPayingAcct,2,1)
		PRINT(CUST.MISC.chr8)
		
		CUST.MISC.chr8a = CINT(CUST.MISC.chr8) * CINT("2")
		
		CUST.MISC.chr10 = MID$(CUST.MISC.instPayingAcct,0,1)
		PRINT(CUST.MISC.chr10)
		
		CUST.MISC.chr10a = CINT(CUST.MISC.chr10) * CINT("2")
		
		CUST.MISC.chr12 = MID$(CUST.MISC.instBranchCode,2,1)
		PRINT(CUST.MISC.chr12)
		
		CUST.MISC.chr12a = CINT(CUST.MISC.chr12) * CINT("2")
		
		CUST.MISC.chr14 = MID$(CUST.MISC.instBranchCode,0,1)
		PRINT(CUST.MISC.chr14)
		
		CUST.MISC.chr14a = CINT(CUST.MISC.chr14) * CINT("2")
		
		CUST.MISC.chr16 = MID$(CUST.MISC.instBankCode,0,1)
		PRINT(CUST.MISC.chr16)
		
		CUST.MISC.chr16a = CINT(CUST.MISC.chr16) * CINT("2")
		PRINT(CUST.MISC.chr16a)
		
		
		IF (CINT(CUST.MISC.chr2a) < CINT("10")) THEN
		#{
			CUST.MISC.thirdstring2 = CUST.MISC.chr2a
