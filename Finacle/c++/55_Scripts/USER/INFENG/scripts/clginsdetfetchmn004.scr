			#}
		ELSE
			#{
			CUST.MISC.thirdstring2 = CINT(CUST.MISC.chr2a) - CINT("9")
			PRINT(CUST.MISC.thirdstring2)
		#}
		ENDIF
		
		IF (CINT(CUST.MISC.chr4a) < CINT("10")) THEN
