		CUST.MISC.syschkdigit = CINT(CUST.MISC.calc1) - CINT(CUST.MISC.fourthstring)
		PRINT(CUST.MISC.syschkdigit)
		PRINT(CUST.MISC.instRepsCode)
		
		#	CUST.MISC.instRepsCode = 8
		#----------------------------------------------------------------------------------
		#--To validate the check digit
		#----------------------------------------------------------------------------------
		IF (CUST.MISC.syschkdigit != CUST.MISC.instRepsCode) THEN
		#{
			sv_b = "status1|" +  "Y"
