			#}
		ELSE
			#{
			CUST.MISC.thirdstring8 = CINT(CUST.MISC.chr8a) - CINT("9")
			PRINT(CUST.MISC.thirdstring8)
		#}
		ENDIF
		
		IF (CINT(CUST.MISC.chr10a) < CINT("10")) THEN
		#{
			CUST.MISC.thirdstring10 = CUST.MISC.chr10a
			PRINT(CUST.MISC.thirdstring10)
			#}
		ELSE
			#{
			CUST.MISC.thirdstring10 = CINT(CUST.MISC.chr10a) - CINT("9")
			PRINT(CUST.MISC.thirdstring10)
		#}
		ENDIF
		
		IF (CINT(CUST.MISC.chr12a) < CINT("10")) THEN
		#{
			CUST.MISC.thirdstring12 = CUST.MISC.chr12a
			PRINT(CUST.MISC.thirdstring12)
			#}
		ELSE
			#{
			CUST.MISC.thirdstring12 = CINT(CUST.MISC.chr12a) - CINT("9")
			PRINT(CUST.MISC.thirdstring12)
		#}
		ENDIF
		
		IF (CINT(CUST.MISC.chr14a) < CINT("10")) THEN
		#{
			CUST.MISC.thirdstring14 = CUST.MISC.chr14a
			PRINT(CUST.MISC.thirdstring14)
			#}
		ELSE
			#{
			CUST.MISC.thirdstring14 = CINT(CUST.MISC.chr_14) - CINT("9")
			PRINT(CUST.MISC.thirdstring14)
		#}
		ENDIF
		
		IF (CINT(CUST.MISC.chr16a) < CINT("10")) THEN
		#{
			CUST.MISC.thirdstring16 = CUST.MISC.chr16a
			PRINT(CUST.MISC.thirdstring16)
			#}
		ELSE
			#{
			CUST.MISC.thirdstring16 = CINT(CUST.MISC.chr16a) - CINT("9")
			PRINT(CUST.MISC.thirdstring16)
		#}
		ENDIF
		
		CUST.MISC.thirdstring = CINT(CUST.MISC.thirdstring2) + CINT(CUST.MISC.thirdstring4) + CINT(CUST.MISC.thirdstring6) + CINT(CUST.MISC.thirdstring8) + CINT(CUST.MISC.thirdstring10) + CINT(CUST.MISC.thirdstring12) + CINT(CUST.MISC.thirdstring14) + CINT(CUST.MISC.thirdstring16)
		PRINT(CUST.MISC.thirdstring)
		
		PRINT(CUST.MISC.firststring)
		PRINT(CUST.MISC.thirdstring)
		
		CUST.MISC.fourthstring = CINT(CUST.MISC.firststring) + CINT(CUST.MISC.thirdstring)
		PRINT(CUST.MISC.fourthstring)
		
		CUST.MISC.calc1 = cdouble(CUST.MISC.fourthstring) / cdouble("10")
		PRINT(CUST.MISC.calc1)
		
		
		sv_c = "."
		sv_p = GETPOSITION(CUST.MISC.calc1,sv_c)
		PRINT(sv_p)
		sv_o = MID$(CUST.MISC.calc1,sv_p,2)
		
		IF (sv_o != "00") THEN
		#{
			PRINT(CUST.MISC.calc1)
			CUST.MISC.calc1 = (CINT(CUST.MISC.calc1) + CINT("1")) * CINT("10")
			PRINT(CUST.MISC.calc1)
			#}
		ELSE
			#{
			CUST.MISC.calc1 = "0"
			PRINT(CUST.MISC.calc1)
		#}
