#-----------------------------------------------------------------------------------------------

#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	#BANCS.INPUT.AccountNo = "0040195625735"

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("AccountNo"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="please enter CIFId"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "PhoneDetails_RES.Error | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
   	ELSE 
   		CUST.EZB.accountNo = BANCS.INPUT.AccountNo
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.EZB.prefdPhone = ""
	CUST.EZB.prefdEmail =""

	#----------------------------------------------------------------------------------------------
	# validations
	#----------------------------------------------------------------------------------------------

	sv_q = "acctName, acctCrncy, cif |"
	sv_q = sv_q + " SELECT acct_name,acct_crncy_code,cif_id "
	sv_q = sv_q + " FROM tbaadm.gam "
	sv_q = sv_q + " WHERE bank_id=?SVAR AND entity_cre_flg='Y' AND del_flg='N' AND acct_cls_flg='N' AND foracid=?SVAR "
	print(sv_q)
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId+"|"+CUST.EZB.accountNo
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_c)

	IF(sv_c == 0)THEN
	#{
		CUST.EZB.acctName = BANCS.OUTPARAM.acctName
		print(CUST.EZB.acctName)
		CUST.EZB.acctCrncy = BANCS.OUTPARAM.acctCrncy
		print(CUST.EZB.acctCrncy)
		CUST.EZB.cif = BANCS.OUTPARAM.cif
		print(CUST.EZB.cif)

		sv_q = "email, phoneNo, prefdFlg,phoneoremail |"
		sv_q = sv_q + " SELECT email,phoneno,preferredflag,phoneoremail "
		sv_q = sv_q + " from crmuser.phoneemail "
		sv_q = sv_q + " where orgkey=?SVAR AND bank_id=?SVAR order by phoneoremail desc"
		print(sv_q)
		
		BANCS.INPARAM.BINDVARS =  CUST.EZB.cif +"|"+BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)

		sv_c = urhk_dbcursorOpenWithBind(sv_q)
		PRINT(sv_c)

		IF (sv_c == 0)THEN
		#{
			CUST.EZB.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(CUST.EZB.cursor_number)

			sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
			print(sv_d)

			sv_q = 0
			print(sv_q)

			WHILE (sv_d == 0)
			#{
				sv_q = sv_q + 1
				print(sv_q)					

				sv_v = "Phoneoremail_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.phoneoremail

				IF(("CUST").("EZB").(sv_v) == "PHONE")THEN
				#{
					sv_v = "PrefdFlg_" + FORMAT$(sv_q, "%d")
					("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.prefdFlg

					IF(("CUST").("EZB").(sv_v) == "Y")THEN
					#{
						CUST.EZB.prefdPhone = BANCS.OUTPARAM.phoneNo
						print(CUST.EZB.prefdPhone)
						sv_v = "PhoneNo_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.phoneNo
						sv_v = "Email_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.email
					ELSE 
						sv_v = "PhoneNo_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.phoneNo
						sv_v = "Email_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.email
					#}
					ENDIF
				ELSE 
					sv_v = "PrefdFlg_" + FORMAT$(sv_q, "%d")
					("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.prefdFlg

					IF(("CUST").("EZB").(sv_v) == "Y")THEN
					#{
						CUST.EZB.prefdEmail = BANCS.OUTPARAM.email
						print(CUST.EZB.prefdEmail)
						sv_v = "Email_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.email
						sv_v = "PhoneNo_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.phoneNo
					ELSE 
						sv_v = "Email_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.email
						sv_v = "PhoneNo_" + FORMAT$(sv_q, "%d")
						("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.phoneNo
					#}
					ENDIF
					
				#}
				ENDIF

				CUST.EZB.email = BANCS.OUTPARAM.email
				print(CUST.EZB.email)
				CUST.EZB.phoneNo = BANCS.OUTPARAM.phoneNo
				print(CUST.EZB.phoneNo)
				CUST.EZB.prefdFlg = BANCS.OUTPARAM.prefdFlg
				print(CUST.EZB.prefdFlg)
				CUST.EZB.phoneoremail = BANCS.OUTPARAM.phoneoremail
				print(CUST.EZB.phoneoremail)

				sv_t = "PhoneDetails.<rec_1>.accountName| " + CUST.EZB.acctName
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "PhoneDetails.<rec_1>.accountNumber| " + CUST.EZB.accountNo
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "PhoneDetails.<rec_1>.accountCurrency| " + CUST.EZB.acctCrncy
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "PhoneDetails.<rec_1>.cifID| " + CUST.EZB.cif
				sv_u = urhk_SetOrbOut(sv_t)

				IF(CUST.EZB.prefdPhone !="")THEN
					sv_t = "PhoneDetails.<rec_1>.preferredPhoneNumber| " + CUST.EZB.prefdPhone
					sv_u = urhk_SetOrbOut(sv_t)
				ENDIF

				IF(CUST.EZB.prefdEmail !="")THEN
					sv_t = "PhoneDetails.<rec_1>.preferredEmail| " + CUST.EZB.prefdEmail
					sv_u = urhk_SetOrbOut(sv_t)
				ENDIF
				
				sv_v = "Email_" + FORMAT$(sv_q, "%d")
				IF(("CUST").("EZB").(sv_v) !="")THEN
					sv_t = "PhoneDetails.<rec_" + FORMAT$(sv_q,"%d") + ">.email| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)
				ELSE 
					#sv_t = "PhoneDetails.LL.<rec_" + FORMAT$(sv_q,"%d") + ">.email| " + ("CUST").("EZB").(sv_v)
					#sv_u = urhk_SetOrbOut(sv_t)
				ENDIF

				sv_v = "PhoneNo_" + FORMAT$(sv_q, "%d")
				IF(("CUST").("EZB").(sv_v) !="")THEN
					sv_t = "PhoneDetails.<rec_" + FORMAT$(sv_q,"%d") + ">.phone| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)
				ELSE 
					#sv_t = "PhoneDetails_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.phone| " + ("CUST").("EZB").(sv_v)
					#sv_u = urhk_SetOrbOut(sv_t)
				ENDIF 

				sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
				print(sv_d)
				
			#} 
			DO 

			sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
			print(sv_x)
			print(CUST.EZB.cursor_number)
		ELSE 
			CUST.EZB.errMsg="An Error Occured!! Try Again or Contact Admin"
			sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_t = "PhoneDetails_RES.Error | " +CUST.EZB.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
	   		exitscript
		#}
		ENDIF
	ELSE 
		CUST.EZB.errMsg="An Error Occured!! Try Again or Contact Admin"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "PhoneDetails_RES.Error | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF


	


ENDSCRIPT:
trace off
END-->

