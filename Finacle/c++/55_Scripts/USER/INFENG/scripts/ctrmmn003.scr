<--START
CHECKSUM="62eb89c7945f18d36b66cec9b2d13f040e609a7ef8ed8bd7a635285d586766b2"
	#trace on
	
	#----------------------------------------------------------------------
	# Create the necessary repositories and Classes
	#----------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","UPM") == 0) THEN
	#{
		CREATECLASS("CUST","UPM",5)
	#}
	ENDIF
	
	print(BANCS.INPUT.tempRolId)
	print(BANCS.INPUT.expDate)
	
	CUST.UPM.tempRoleId = BANCS.INPUT.tempRolId
	CUST.UPM.expiryDate = BANCS.INPUT.expDate
	#---------------------------------------------
	# Validating Temp Role ID
	#---------------------------------------------
	#sv_a = urhk_B2K_printRepos("BANCS")
	BANCS.INPARAM.BINDVARS = CUST.UPM.tempRoleId + "|" + BANCS.STDIN.contextBankId
	sv_s = "recCount|SELECT COUNT(*) FROM TBAADM.RPT WHERE ROLE_ID = ?SVAR AND BANK_ID = ?SVAR AND DEL_FLG = 'N'"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d != 0) THEN
	#{
		print("Query execution failed")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF(BANCS.OUTPARAM.recCount == 0) THEN
		#{
			CUST.UPM.failureMessage = "Invalid Temp Role ID"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	print(MID$(CUST.UPM.tempRoleId,0,3))
	IF((MID$(CUST.UPM.tempRoleId,0,3) == "AMO") OR (MID$(CUST.UPM.tempRoleId,0,3) == "BRM")) THEN
	#{
		print("OK")
		#}
	ELSE
		#{
		CUST.UPM.failureMessage = "Temp Role can be only one of the following: AMO,AMO2,AMO3,BRM,BRM2,BRM3"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	#---------------------------------------------
	# Validating Expiry Date
	#---------------------------------------------
	BANCS.INPARAM.date1 = CUST.UPM.expiryDate
	BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
	sv_u = urhk_B2k_dateDiff("")
	IF (sv_u == 0) THEN
	#{
		print(BANCS.OUTPARAM.dateDiff)
		IF(BANCS.OUTPARAM.dateDiff <  0) THEN
		#{
			CUST.UPM.failureMessage = "Expiry Date cannot be less than BOD Date"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CDOUBLE(BANCS.OUTPARAM.dateDiff) > CDOUBLE("14")) THEN
		#{
			CUST.UPM.failureMessage = "Temporary Role should only be granted for a maximum period of 14 calendar days"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#trace off
END-->
