<--start
trace on
#Rep/Class
	if(repexists("ODLAC")==0)then
		createrep("ODLAC")
	endif
	if(classexists("ODLAC","GLBDATA")==0)then
		createclass("ODLAC","GLBDATA",5)
	endif
#####exitscript
#SrvValues
	ODLAC.GLBDATA.trans_amt ="" 
	ODLAC.GLBDATA.trans_crncy = ""
	ODLAC.GLBDATA.isDrAcctId = ""
	ODLAC.GLBDATA.totCAmt = 0
	ODLAC.GLBDATA.totDAmt = 0
	ODLAC.GLBDATA.chrgDrYN = ""
	ODLAC.GLBDATA.usertCode = ""
	ODLAC.GLBDATA.clearBalance = ""
	ODLAC.GLBDATA.isTranYN = ""
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	ODLAC.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	ODLAC.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.addlTranCritPtr.tranParticularCode.refCode")
	ODLAC.GLBDATA.usertCode=BANCS.OUTPARAM.srvValue
	print(ODLAC.GLBDATA.usertCode)
	if ((ODLAC.GLBDATA.tranSubType == "CI") or (ODLAC.GLBDATA.tranSubType=="BI") or (ODLAC.GLBDATA.tranSubType=="NR") or (ODLAC.GLBDATA.tranSubType=="NP") or (ODLAC.GLBDATA.tranSubType =="I")) then

	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			ODLAC.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(ODLAC.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			ODLAC.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(ODLAC.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			ODLAC.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(ODLAC.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			ODLAC.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(ODLAC.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
			ODLAC.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(ODLAC.GLBDATA.tranParticulars)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
			ODLAC.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
			print(ODLAC.GLBDATA.tranParticulars2)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg")
			ODLAC.GLBDATA.recDelYN=BANCS.OUTPARAM.srvValue
			print(ODLAC.GLBDATA.recDelYN)
		if(ODLAC.GLBDATA.foracid!="")then
			sv_u = urhk_getAcctDetailsInRepository(ODLAC.GLBDATA.foracid)
			if(sv_u==0)then
				ODLAC.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
				ODLAC.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
				ODLAC.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance   
				print(ODLAC.GLBDATA.clearBalance)
				ODLAC.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
				#--------------------------Vino.palani added agent scheme INC0139820
				if((ODLAC.GLBDATA.schmCode=="OD541") or (ODLAC.GLBDATA.schmCode=="OD542") or (ODLAC.GLBDATA.schmCode=="OD543") or (ODLAC.GLBDATA.schmCode=="OD544") or (ODLAC.GLBDATA.schmCode=="OD545") or (ODLAC.GLBDATA.schmCode=="OD546") or (ODLAC.GLBDATA.schmCode=="OD547"))then 
					ODLAC.GLBDATA.isTranYN = "N" 
				endif
			endif
		endif
                sv_l = strlen(ODLAC.GLBDATA.tran_amt)
                sv_f = mid$(ODLAC.GLBDATA.tran_amt,0,sv_l)
                sv_l = strlen(ODLAC.GLBDATA.tran_amt)
                sv_p = getposition(sv_f,"|")
                ODLAC.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
                ODLAC.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
                print(ODLAC.GLBDATA.trans_amt)
                print(ODLAC.GLBDATA.trans_crncy)
                print(ODLAC.GLBDATA.tran_amt)
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif
	if(ODLAC.GLBDATA.isTranYN=="N")then
		sv_u = urhk_SRV_SetErr("Transaction Not Allowed on ODA Loans :"+ ODLAC.GLBDATA.foracid )
	endif
VAYU:	
	if(classexists("ODLAC","GLBDATA")==1) then
		deleteclass("ODLAC","GLBDATA")
	endif
	if(repexists("ODLAC")==1) then
		deleterep("ODLAC")
	endif
	exitscript
##trace off
end-->

