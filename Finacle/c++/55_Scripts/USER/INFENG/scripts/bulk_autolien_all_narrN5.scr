#------------------------------------------------------------------------------------------------
#  Name            : b_autolien.scr
#  Description     : This script will lien accounts and verify
#  Date            : 09-07-2014
#  Author          : Jane Ndirangu
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :  (Batch Job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             09-07-2014      Jane Ndirangu		Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="22c624c4bbff5129ffa2aea2cc57403435624a8919345e2117c653c57a4a288f"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.SBACT.errMsg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) "
	sv_s = sv_s + " FROM CUSTOM.INT_CHANGE3 "
	sv_s = sv_s + " WHERE INT_CHANGE3.entity_cre_flg='N5' "
	sv_s = sv_s + " AND INT_CHANGE3.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
	#{
		CUSTS.SBACT.errMsg = "DB ERROR!"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.custcount)
		IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s="foracid,solid,lienamount,narrationsss|"
	sv_s = sv_s + " SELECT INT_CHANGE3.foracid,sol_id,CUST_PREF,ACCT_PREF "
	sv_s = sv_s + " FROM CUSTOM.INT_CHANGE3 "
	sv_s = sv_s + " WHERE INT_CHANGE3.entity_cre_flg='N5' "
	sv_s = sv_s + " AND INT_CHANGE3.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.SBACT.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUSTS.SBACT.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.SBACT.solid	= BANCS.OUTPARAM.solid
			CUSTS.SBACT.amount	= BANCS.OUTPARAM.lienamount
			CUSTS.SBACT.narrationsss = BANCS.OUTPARAM.narrationsss
			print(CUSTS.SBACT.narrationsss)
			CUSTS.SBACT.narrationsss=MID$(CUSTS.SBACT.narrationsss,0,50)
			print(CUSTS.SBACT.narrationsss)
			
			print(CUSTS.SBACT.foracid)
			print(CUSTS.SBACT.solid)
			print(CUSTS.SBACT.amount)
			
			CUSTS.SBACT.amount1="0.00|KES"
			CUSTS.SBACT.date="01-12-2099 12:11:48"
			
			IF(CUSTS.SBACT.solid != BANCS.STDIN.mySolId)THEN
			#{
				sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.SBACT.solid)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
			#}
			ENDIF
			
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account lien services
			# urhk_SetUrhkInp is used to set inputs
			#--------------------------------------------------------------------------------------------------------------
			
			
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUSTS.SBACT.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|KES")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUSTS.SBACT.amount+"|KES")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUSTS.SBACT.amount1)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUSTS.SBACT.date)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|OTH")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUSTS.SBACT.narrationsss)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUSTS.SBACT.date)
			PRINT(sv_u)
			
			sv_u = urhk_ExecSrv("SRV_AddLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				sv_s = "UPDATE CUSTOM.INT_CHANGE3 "
				sv_s = sv_s + " SET INT_CHANGE3.entity_cre_flg = 'P',"
				sv_s = sv_s + " INT_CHANGE3.acct_opn_date= SYSDATE"
				sv_s = sv_s + " WHERE INT_CHANGE3.foracid= ?SVAR"
				sv_s = sv_s + " AND INT_CHANGE3.bank_id = ?SVAR and ACCT_PREF= ?SVAR  "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUSTS.SBACT.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUSTS.SBACT.narrationsss
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUSTS.SBACT.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|KES")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUSTS.SBACT.amount+"|KES")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUSTS.SBACT.amount1)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUSTS.SBACT.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|OTH")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUSTS.SBACT.narrationsss)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUSTS.SBACT.date)
				PRINT(sv_u)
				
				sv_u = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF (sv_u == 0) THEN
				#{
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					sv_s = "UPDATE CUSTOM.INT_CHANGE3 "
					sv_s = sv_s + " SET INT_CHANGE3.entity_cre_flg = 'P',"
					sv_s = sv_s + " INT_CHANGE3.acct_opn_date= SYSDATE"
					sv_s = sv_s + " WHERE INT_CHANGE3.foracid= ?SVAR"
					sv_s = sv_s + " AND INT_CHANGE3.bank_id = ?SVAR and ACCT_PREF= ?SVAR  "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUSTS.SBACT.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUSTS.SBACT.narrationsss
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
				#}
				ENDIF
				
				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						print(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) THEN
					#{
						sv_u = system("echo 'Error for Acct:"+CUSTS.SBACT.foracid+" ' >>lienedacct3.log")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)

							sv_s = "UPDATE CUSTOM.INT_CHANGE3 "
							sv_s = sv_s + " SET INT_CHANGE3.entity_cre_flg = 'E',"
							sv_s = sv_s + " INT_CHANGE3.acct_opn_date= SYSDATE , INT_CHANGE3.sol_id = ?SVAR  "
							sv_s = sv_s + " WHERE INT_CHANGE3.foracid= ?SVAR"
							sv_s = sv_s + " AND INT_CHANGE3.bank_id = ?SVAR and ACCT_PREF= ?SVAR  "
							print(sv_s)
							BANCS.INPARAM.BINDVARS = sv_e + "|" +  CUSTS.SBACT.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUSTS.SBACT.narrationsss
							print(BANCS.INPARAM.BINDVARS)
							
							sv_d = urhk_dbSQLWithBind(sv_s)
							IF (sv_d == 0) THEN
							#{
								sv_c = urhk_dbSQLWithBind("commit")
								print(sv_c)
							#}
							ENDIF
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>lienedacct3.log")
							print(sv_u)
						#}
						DO
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.SBACT.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.SBACT.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUSTS.SBACT.errMsg+"' >>lienedacct3.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
