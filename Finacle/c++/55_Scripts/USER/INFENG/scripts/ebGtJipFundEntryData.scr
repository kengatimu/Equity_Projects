#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Name                   : ebGtJipFundEntryData.scr 
#   Date                   : 24-Jul-2019
#   Description            :
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Rep/Class
        if(repexists("EQGTG")==0)then
                createrep("EQGTG")
        endif
        if(classexists("EQGTG","GLBDATA")==0)then
                createclass("EQGTG","GLBDATA",5)
        endif
#Inp/Out
	EQGTG.GLBDATA.ErrMsg	= ""
	BANCS.INPUT.goaldts	= ""
	BANCS.INPUT.wkbAcct	= ""
	BANCS.INPUT.wkbthlmt	= ""
	BANCS.INPUT.wkbdeppcnt	= ""
	BANCS.INPUT.wksAcct	= ""
	BANCS.INPUT.wksDepPcnt	= ""
	BANCS.INPUT.wkJipAcct	= ""
	EQGTG.GLBDATA.jipAcct   = ""		
	EQGTG.GLBDATA.ModuleId	= ""
	EQGTG.GLBDATA.tranId =""
	EQGTG.GLBDATA.tranDate = ""
	EQGTG.GLBDATA.ErrMsg = ""
	EQGTG.GLBDATA.fundCurNum = ""
	EQGTG.GLBDATA.crAcctNum = ""
	EQGTG.GLBDATA.crPaticulars = ""
	EQGTG.GLBDATA.crAmt = "0"
	EQGTG.GLBDATA.schmType = ""
	EQGTG.GLBDATA.isKenyaTea = "0"
	EQGTG.GLBDATA.jipangeFundYN = "N"
	EQGTG.GLBDATA.ErrMsg = ""
	EQGTG.GLBDATA.ModuleId = ""
	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	if(sv_u == 0)then
		print(MTT.InputDetails.Argument1)
		EQGTG.GLBDATA.tranId = MTT.InputDetails.Argument1
		EQGTG.GLBDATA.tranDate = left$(BANCS.STDIN.BODDate,10)
	else
		EQGTG.GLBDATA.tranId = ""
	endif
	sv_d = "crAcctNum,crPaticulars,crAmt|select acid,tran_particular,tran_amt from tbaadm.dtd where bank_id=?SVAR "
	sv_d = sv_d + " and tran_id=lpad(?SVAR,9,' ') and tran_date=to_date(?SVAR,'DD-MM-RR') and part_tran_type='C'"   	
	sv_d = sv_d + " and pstd_flg<>'Y' and del_flg='N'"
	sv_d = sv_d + " and tran_particular like '%KENYATEA%'"
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQGTG.GLBDATA.tranId + "|" + EQGTG.GLBDATA.tranDate
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_u!=0)then
		EQGTG.GLBDATA.ErrMsg = BANCS.OUTPARAM.DB_ERRCODE + " " + BANCS.OUTPARAM.DB_ERRMSG
		goto VAYU
	else
		EQGTG.GLBDATA.fundCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	endif
	EQGTG.GLBDATA.fundRecNum = 0
	print(EQGTG.GLBDATA.fundCurNum)
	sv_u = urhk_dbCursorFetch(EQGTG.GLBDATA.fundCurNum)
	if(sv_u!=0)then
		EQGTG.GLBDATA.ErrMsg = BANCS.OUTPARAM.DB_ERRCODE + " " + BANCS.OUTPARAM.DB_ERRMSG
		goto VAYU
	endif
	while(sv_u<=0)
	##{
		EQGTG.GLBDATA.crAcctNum	= BANCS.OUTPARAM.crAcctNum
		EQGTG.GLBDATA.crPaticulars = BANCS.OUTPARAM.crPaticulars
		EQGTG.GLBDATA.crAmt = BANCS.OUTPARAM.crAmt
		sv_a= urhk_B2k_AcidToForacid(EQGTG.GLBDATA.crAcctNum)
		if(sv_a==0)then
			EQGTG.GLBDATA.crAcctNum = BANCS.OUTPARAM.Foracid
		endif
		sv_u = urhk_getAcctDetailsInRepository(EQGTG.GLBDATA.crAcctNum)
		if(sv_u==0)then
			EQGTG.GLBDATA.schmType  =       BANCS.OUTPARAM.schmType
		endif
	if((EQGTG.GLBDATA.crAcctNum!="") and (EQGTG.GLBDATA.schmType !="OAB") and (EQGTG.GLBDATA.schmType != "OSP") and (EQGTG.GLBDATA.schmType !="DDA") and (EQGTG.GLBDATA.schmType != "HOA") and cdouble(EQGTG.GLBDATA.crAmt)>0)then
	##{
		sv_d = "isKenyaTea | select custom.ebgtgoal_master_fun('"+EQGTG.GLBDATA.crAcctNum+"',"+EQGTG.GLBDATA.crAmt+",'KES',"
		sv_d = sv_d + " '"+EQGTG.GLBDATA.crPaticulars+"','remarks','refnum','"+BANCS.STDIN.contextBankId+"','T') from dual"
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.isKenyaTea = BANCS.OUTPARAM.isKenyaTea	
		else
			EQGTG.GLBDATA.isKenyaTea = "0"
		endif
		if(cint(EQGTG.GLBDATA.isKenyaTea)<=0)then 
			EQGTG.GLBDATA.ErrMsg = "No Goals Funding"
			goto NXTLP
		endif
		sv_d ="goalsDtls | select custom.ebgtgoal_master_fun('"+EQGTG.GLBDATA.crAcctNum+"',"+EQGTG.GLBDATA.crAmt+",'KES',"
		sv_d = sv_d + " '"+EQGTG.GLBDATA.crPaticulars+"','remarks','refnum','"+BANCS.STDIN.contextBankId+"','P') from dual "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			BANCS.INPUT.goaldts = BANCS.OUTPARAM.goalsDtls
		else
			BANCS.INPUT.goaldts = "NA"
		endif
		#To Check KTDA Salary should be funded to Jipange or not
			EQGTG.GLBDATA.jipangeFundYN = "N"
			sv_d = left$(BANCS.STDIN.BODDate,10)
			print(sv_d)
			sv_y = mid$(sv_d,8,10)
			print(sv_y)
			sv_m = mid$(sv_d,3,2)
			print(sv_m)
			if((cint(sv_m) == 3) or (cint(sv_m) ==4 ))then
				print("april KTDA Salary Tran Ok, for funding to jipange")
				EQGTG.GLBDATA.jipangeFundYN = "Y"
			endif
			if((cint(sv_m) == 9) or (cint(sv_m) ==10 ))then
				print("october KTDA Salary Tran Ok, for funding to jipange")
				EQGTG.GLBDATA.jipangeFundYN = "Y"
			endif
			if((BANCS.INPUT.goaldts != "NA") and (EQGTG.GLBDATA.jipangeFundYN!="Y"))then
				EQGTG.GLBDATA.ErrMsg = "no jipanage funding , since ktda salary is not under april/october"
				##goto NXTLP
			endif
		#To get goal details
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wkbAcct  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wkbAcct)
			#-- Wekeza Threshold Limit
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wkbthlmt  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wkbthlmt)
			#-- Wekeza Deposit Pcnt
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wkbdeppcnt  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wkbdeppcnt)
			#--Wekeza Sasa Acct
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wksAcct  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wksAcct)
			#--Wekeza Sasa Dep Pcnt
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wksDepPcnt  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wksDepPcnt)
			#--Wekeza Oct Jipange Acct
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wksOctJipAcct  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wksOctJipAcct)
			#--Wekeza Apr Jipange Acct
			BANCS.INPUT.wksAprJipAcct = mid$(sv_f,sv_p,sv_l)
			print(BANCS.INPUT.wksAprJipAcct)

			##if((BANCS.INPUT.wkbAcct != "") and (BANCS.INPUT.wkbAcct!="NA"))then
			##	EQGTG.GLBDATA.ModuleId = "GTWKB"
			##	EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wkbAcct
			##endif
			##if((BANCS.INPUT.wksAcct != "") and (BANCS.INPUT.wksAcct!="NA"))then
			##	EQGTG.GLBDATA.ModuleId = "GTWKS"
			##	EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAcct
			##endif
			if((BANCS.INPUT.wksOctJipAcct != "") and (BANCS.INPUT.wksOctJipAcct!="NA"))then
				EQGTG.GLBDATA.ModuleId = "GTJIP"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksOctJipAcct
			endif
			if((BANCS.INPUT.wksAprJipAcct != "") and (BANCS.INPUT.wksAprJipAcct!="NA"))then
				EQGTG.GLBDATA.ModuleId = "GTJIP"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAprJipAcct
			endif
			#+++++++++++++++++++++++++++++++++++++++++++++++++++++++
			#to derive which account has to credit October or April
			#+++++++++++++++++++++++++++++++++++++++++++++++++++++++
			sv_d = left$(BANCS.STDIN.BODDate,10)
			print(sv_d)
			sv_y = mid$(sv_d,8,10)
			print(sv_y)
			sv_m = mid$(sv_d,3,2)
			print(sv_m)
			####if((cint(sv_m) == 1) or (cint(sv_m) == 2) or (cint(sv_m) == 3) or (cint(sv_m) ==4 ))then
			if((cint(sv_m) ==4 ))then
				print("april KTDA Salary Tran Ok, for funding to jipange")
				EQGTG.GLBDATA.jipangeFundYN = "Y"
				EQGTG.GLBDATA.ModuleId = "GTJIP"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAprJipAcct
			endif
			##if((cint(sv_m) == 9) or (cint(sv_m) ==10 ))then
			if((cint(sv_m) == 5) or (cint(sv_m) == 6) or (cint(sv_m) == 7) or (cint(sv_m) == 8) or (cint(sv_m) == 9) or (cint(sv_m) ==10 ))then
			##if((cint(sv_m) ==10 ))then
				print("october KTDA Salary Tran Ok, for funding to jipange")
				EQGTG.GLBDATA.jipangeFundYN = "Y"
				EQGTG.GLBDATA.ModuleId = "GTJIP"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksOctJipAcct
			endif
			if((EQGTG.GLBDATA.jipAcct != "") and (EQGTG.GLBDATA.crAcctNum!="") and (cdouble(EQGTG.GLBDATA.crAmt)>0) and (EQGTG.GLBDATA.tranId !="")) then
				print(EQGTG.GLBDATA.jipAcct)
				#+++++++++++++++++++++++++
				#Funding Data 
				#+++++++++++++++++++++++++
				sv_i = "Insert into CUSTOM.EBGTGOAL_JIPANGE_FUNDING (BANK_ID, "
				sv_i = sv_i + "DR_ACCTID,"
				sv_i = sv_i + "CR_ACCTID,"
				sv_i = sv_i + "UPL_TRANID,UPL_TRANDATE,UPL_TRANAMT,FUND_YN,"
				sv_i = sv_i + "FUND_TRANID,FUND_TRANDATE,RCRE_USER_ID,RCRE_TIME,"
				sv_i = sv_i + "LCHG_USER_ID,LCHG_TIME,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,DEL_FLG) values "
				sv_i = sv_i + "(?SVAR,?SVAR,?SVAR,ltrim(?SVAR),to_date(?SVAR,'DD-MM-RR'),?SVAR,'N',null,null,?SVAR,sysdate,?SVAR,sysdate,'N',null,null,'N') "
				#print(BANCS.STDIN.contextBankId)
				#print(EQGTG.GLBDATA.crAcctNum)
				#print(EQGTG.GLBDATA.jipAcct)
				#print(EQGTG.GLBDATA.tranId)
				#print(BANCS.STDIN.BODDate)
				#print(EQGTG.GLBDATA.crAmt)
				
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQGTG.GLBDATA.crAcctNum + "|" + EQGTG.GLBDATA.jipAcct + "|" + EQGTG.GLBDATA.tranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQGTG.GLBDATA.crAmt + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId 
				print(BANCS.INPARAM.BINDVARS)
				print(sv_i)
				sv_u = urhk_dbSqlWithBind(sv_i)
				if(sv_u==0)then
					sv_u = urhk_dbSqlWithBind("Commit")
				else
					goto NXTLP
				endif
			else
					EQGTG.GLBDATA.ErrMsg = "No Goal Funding"
					goto NXTLP
			endif
	NXTLP:
                sv_u = urhk_dbCursorFetch(EQGTG.GLBDATA.fundCurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(EQGTG.GLBDATA.fundCurNum)
                        print(sv_u)
                        goto VAYU
                endif
		##}
		endif
	##}
	do
        sv_u = urhk_dbCursorClose(EQGTG.GLBDATA.fundCurNum)
        print(sv_u)
VAYU:
	print(EQGTG.GLBDATA.ErrMsg)
	exitscript
trace off
end-->
