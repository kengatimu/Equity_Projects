				MTT.PartTranDetails.Particulars = "Iclg Charge Coll"
                                MTT.PartTranDetails.RefAmount = 1 * cdouble(EQSRV.GLBDATA.tranAmt)
                                print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = "Charge Coll"
				MTT.PartTranDetails.RefNum = "Charge Coll"
                                MTT.PartTranDetails.IgnoreExcp = "I"
                                MTT.PartTranDetails.Consolidate = "N"
                                MTT.PartTranDetails.TranIdentifier = "ODLoanRec"
                                MTT.PartTranDetails.ReportCode   = "ODLoan"
                                MTT.PartTranDetails.PstFlg = "Y"
                                sv_r = urhk_MTTS_definePartTran("OdLoanRecov")
                                if (sv_r != 0) then
                                        BANCS.OUTPUT.successOrFailure = "F"
                                        print(MTT.Error.Description)
                                        MTT.Error.Description="Credit Part Tran Definition failed "
                                        sv_r = urhk_MTTS_ReportErrorCondition("")
                                        sv_r = BANCS.OUTPARAM.MTTErrorDesc
                                        EQSRV.GLBDATA.srvErrMsg = MTT.Error.Description
                                        EQSRV.GLBDATA.srvErrCode = "MTT"
                                        EQSRV.GLBDATA.srvSucFail = "F"
                                        goto NXTREC
                                endif
                                sv_u = urhk_MTTS_EndDefinition("")
                                print(sv_u)
                                if (sv_u != 0) then
                                        sv_r = urhk_MTTS_ReportErrorCondition("")
                                        print (MTT.Error.Description)
                                        EQSRV.GLBDATA.srvErrMsg = MTT.Error.Description
                                        EQSRV.GLBDATA.srvErrCode = "MTT"
                                        EQSRV.GLBDATA.srvSucFail = "F"
                                        goto NXTREC
                                        EQSRV.GLBDATA.TranId = ""
                                else
                                        EQSRV.GLBDATA.TranId = BANCS.OUTPARAM.MTTTranId
                                        print(EQSRV.GLBDATA.TranId)
                                endif

                                print(MTT.XCPN.NumExceptions)
                                print(MTT.XCPN.NumWarnings)
                                if((MTT.XCPN.NumExceptions >= 1) or (MTT.XCPN.NumWarnings >= 1)) then
                                #{
                                        sv_u = urhk_MTTS_HandleExceptions("POST")
                                        if (sv_u != 0) then
                                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                                print (MTT.Error.Description)
                                                EQSRV.GLBDATA.srvErrMsg = MTT.Error.Description
                                                EQSRV.GLBDATA.srvErrCode = "MTT"
                                                EQSRV.GLBDATA.srvSucFail = "F"
                                                goto NXTREC
                                        endif
                                else
                                        sv_u = urhk_MTTS_HandleExceptions("POST")
                                        if (sv_u != 0) then
                                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                                print (MTT.Error.Description)
                                                EQSRV.GLBDATA.srvErrMsg = MTT.Error.Description
                                                EQSRV.GLBDATA.srvErrCode = "MTT"
                                                EQSRV.GLBDATA.srvSucFail = "F"
                                                goto NXTREC
                                        endif
                                #}
                                endif
##Lien on Operative Account for loan demand with Tran Creation
                                if(cdouble(EQSRV.GLBDATA.lienAmtt)and(EQSRV.GLBDATA.TranId!=""))then
                                #{
                                        print(EQSRV.GLBDATA.lienAcid)
					print(EQSRV.GLBDATA.lienB2kId)
                                        print(EQSRV.GLBDATA.lienAmtt)
					print(EQSRV.GLBDATA.lienRemarks)
					print(EQSRV.GLBDATA.lienReasonCode)
					print("Lien Add")
					BANCS.INPARAM.acctNum = EQSRV.GLBDATA.drAcctId
					BANCS.INPARAM.blockMode = "A"
					EQSRV.GLBDATA.lienAmt = cdouble(EQSRV.GLBDATA.lienAmtt) * -1
					BANCS.INPARAM.lienAmt = cdouble(EQSRV.GLBDATA.lienAmt)
					BANCS.INPARAM.expiryDate = "31-12-2099"
					BANCS.INPARAM.remarks = EQSRV.GLBDATA.lienRemarks 
					BANCS.INPARAM.reasonCode = EQSRV.GLBDATA.lienReasonCode 
					BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
					BANCS.INPARAM.lienValueDate = LEFT$(BANCS.STDIN.BODDate,10)
					sv_u = urhk_updateLien("")
					if(sv_u != 0)then
					#{
						EQSRV.GLBDATA.srvErrMsg =  "Unable to Mark the lien on operative account for iclg Chrg"
						EQSRV.GLBDATA.srvErrCode = "Lien"
