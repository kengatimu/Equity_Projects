#--------------------------------------------------------------------------
#  Name            : ebodlaResh.scr
#  Description     : loan reschedule
#  Date            : 21-10-2021
#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             21-10-2021      Vino Palani          Original Version
#---------------------------------------------------------------------------
<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                EQSRV.GLBDATA.OdAcctId = MTT.InputDetails.Argument1
                EQSRV.GLBDATA.DmdDate = MTT.InputDetails.Argument2
                BANCS.INPUT.OdAcctId = EQSRV.GLBDATA.OdAcctId
                BANCS.INPUT.DmdDate = EQSRV.GLBDATA.DmdDate
                BANCS.INPUT.ReshType = "F"
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
        endif
        if(fieldexists(BANCS.INPUT.ReshType)==1)then
                print(BANCS.INPUT.ReshType)
                EQSRV.GLBDATA.ReshType = BANCS.INPUT.ReshType
        else
                EQSRV.GLBDATA.ReshType = ""
        endif
        if(fieldexists(BANCS.INPUT.OdAcctId)==1)then
                print(BANCS.INPUT.OdAcctId)
                EQSRV.GLBDATA.OdAcctId = BANCS.INPUT.OdAcctId
        else
                EQSRV.GLBDATA.OdAcctId = ""
        endif
        if(fieldexists(BANCS.INPUT.DmdDate)==1)then
                print(BANCS.INPUT.DmdDate)
                EQSRV.GLBDATA.DmdDate = BANCS.INPUT.DmdDate
        else
                EQSRV.GLBDATA.DmdDate = ""
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Demand Date")
                exitscript
        endif
        if(EQSRV.GLBDATA.ReshType!="F")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Rescheduling Type")
                exitscript
        endif
        sv_a = urhk_B2k_valDate(EQSRV.GLBDATA.DmdDate)
        if(sv_a != 0) then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Demand Date")
                exitscript
        endif
        if(EQSRV.GLBDATA.OdAcctId=="")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Loan Account")
                exitscript
        endif
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.OdAcctId)
        if(sv_u==0)then
                print(BANCS.OUTPARAM.sanctionLimit)
                        EQSRV.GLBDATA.csanctionLimit = BANCS.OUTPARAM.sanctionLimit
                print(BANCS.OUTPARAM.cleanAdhocLimit)
                print(BANCS.OUTPARAM.drawingPower)
                print(BANCS.OUTPARAM.usedUnclearOverDACC)
                print(BANCS.OUTPARAM.FXClearBalance)
                print(BANCS.OUTPARAM.FxAvailableAmt)
                print(BANCS.OUTPARAM.AvailableAmt)
                print(BANCS.OUTPARAM.ClearBalance)
                        EQSRV.GLBDATA.cClearBalance = BANCS.OUTPARAM.ClearBalance
                EQSRV.GLBDATA.cClearBalance1 = BANCS.OUTPARAM.ClearBalance
                print(EQSRV.GLBDATA.cClearBalance1)
                print(BANCS.OUTPARAM.DACCLimit)
                print(BANCS.OUTPARAM.FxFFDAvailableAmt)
                print(BANCS.OUTPARAM.FFDAvailableAmt)
                print(BANCS.OUTPARAM.lienAmt)
                print(BANCS.OUTPARAM.FxEffAvailableAmt)
                print(BANCS.OUTPARAM.EffAvailableAmt)
                print(BANCS.OUTPARAM.systemGeneratedLimit)
                print(BANCS.OUTPARAM.SystemReservedAmt)
                print(BANCS.OUTPARAM.singleTranLimit)
                print(BANCS.OUTPARAM.cleanSingleTranLimit)
                print(BANCS.OUTPARAM.schmCode)
                EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
        else
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Loan Account")
                exitscript
        endif
        if(cdouble(EQSRV.GLBDATA.cClearBalance)>=0)then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Loan Rescheduling not allowed! Loan is in Credit")
                sv_u = urhk_SetOrbOut("LoanAcctId|" + EQSRV.GLBDATA.OdAcctId )
                exitscript
        endif
        if((EQSRV.GLBDATA.schmCode=="OD542") or (EQSRV.GLBDATA.schmCode=="OD543") or (EQSRV.GLBDATA.schmCode=="OD544") or (EQSRV.GLBDATA.schmCode=="OD545") or (EQSRV.GLBDATA.schmCode=="OD546") or (EQSRV.GLBDATA.schmCode=="OD112"))then
                print("rescheduling ")
        else
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Loan Rescheduling not allowed")
                exitscript
        endif
        sv_q = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.OdAcctId)
        if(sv_q==0)then
                EQSRV.GLBDATA.LoanAcid = BANCS.OUTPARAM.Acid
        else
                EQSRV.GLBDATA.LoanAcid = ""
        endif
        lv_d = " dmdCnt | select count(*) from custom.odla_dmd_tbl where bank_id=?SVAR "
        lv_d = lv_d + " and od_acid = ?SVAR "
        lv_d = lv_d + " and dmd_amt-tot_adj_amt <> 0 "
        lv_d = lv_d + " and entity_cre_flg='Y' and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.LoanAcid
        print(BANCS.INPARAM.BINDVARS)
        print(lv_d)
        lv_s = urhk_dbSelectWithBind(lv_d)
        if(lv_s==0)then
                EQSRV.GLBDATA.dmdCnt = BANCS.OUTPARAM.dmdCnt
        else
                EQSRV.GLBDATA.dmdCnt = "0"
        endif
        if(cdouble(EQSRV.GLBDATA.dmdCnt)<=0)then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Loan Rescheduling not allowed ! No Active demamds for the account")
                exitscript
        endif
        lv_r = "exRshcnt | select count(*) from custom.odla_dmd_rsh_cnt where bank_id=?SVAR and od_acid=?SVAR and entity_cre_flg='Y' and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.LoanAcid
        print(BANCS.INPARAM.BINDVARS)
        print(lv_r)
        lv_b = urhk_dbSelectWithBind(lv_r)
        if(lv_b==0)then
                EQSRV.GLBDATA.exRshcnt = BANCS.OUTPARAM.exRshcnt
        else
                EQSRV.GLBDATA.exRshcnt = "0"
        endif
        lv_u = "insert into custom.odla_dmd_rsh_tbl select * from custom.odla_dmd_tbl where bank_id=?SVAR and flow_id in ('PRDEM','INDEM') and od_acid=?SVAR "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.LoanAcid
        print(BANCS.INPARAM.BINDVARS)
        print(lv_u)
        lv_d = urhk_dbSqlWithBind(lv_u)
        if(lv_d==0)then
                lv_d = urhk_dbSqlWithBind("Commit")
        else
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Loan Rescheduling Failed")
                exitscript
        endif
        lv_r = "cShdlNum,cflowId,copSolId,copAcid,cDmdDate,cDmdovDate,cDmdamt| select shdl_num,flow_id,op_sol_id,op_acid,to_char(dmd_date,'DD-MM-YYYY'),to_date(dmd_ovdu_date,'DD-MM-YYYY'),dmd_amt from custom.odla_dmd_tbl where bank_id=?SVAR and od_acid=?SVAR and entity_cre_flg='Y' and del_flg='N' and dmd_amt-tot_adj_amt <> 0 order by dmd_date "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.LoanAcid
        sv_u = urhk_dbCursorOpenWithBind(lv_r)
        if(sv_u==0)then
                EQSRV.GLBDATA.schdlcurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                print(BANCS.OUTPARAM.DB_ERRCODE)
                print(BANCS.OUTPARAM.DB_ERRMSG)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Loan Rescheduling Failed")
                exitscript
        endif
        EQSRV.GLBDATA.ddaRec = "0"
        EQSRV.GLBDATA.FreshYcnt = "0"
        EQSRV.GLBDATA.FreshNcnt = "0"
        sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.schdlcurNum)
        if(sv_z!=0)then
                print(BANCS.OUTPARAM.DB_ERRCODE)
                print(BANCS.OUTPARAM.DB_ERRMSG)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Loan Rescheduling Failed")
                exitscript
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
                EQSRV.GLBDATA.cShdlNum = BANCS.OUTPARAM.cShdlNum
                EQSRV.GLBDATA.cflowId = BANCS.OUTPARAM.cflowId
                EQSRV.GLBDATA.copSolId = BANCS.OUTPARAM.copSolId
                EQSRV.GLBDATA.copAcid = BANCS.OUTPARAM.copAcid
                EQSRV.GLBDATA.cDmdDate = BANCS.OUTPARAM.cDmdDate
                EQSRV.GLBDATA.cDmdovDate = BANCS.OUTPARAM.cDmdovDate
                EQSRV.GLBDATA.cDmdamt = BANCS.OUTPARAM.cDmdamt
                print(EQSRV.GLBDATA.cShdlNum)
                print(EQSRV.GLBDATA.cflowId)
                print(EQSRV.GLBDATA.copSolId)
                print(EQSRV.GLBDATA.copAcid)
                print(EQSRV.GLBDATA.cDmdDate)
                print(EQSRV.GLBDATA.cDmdovDate)
                print(EQSRV.GLBDATA.DmdDate)
                print(EQSRV.GLBDATA.cDmdamt)
                print(EQSRV.GLBDATA.ddaRec)
                if(cdouble(EQSRV.GLBDATA.ddaRec)<=0)then
                        EQSRV.GLBDATA.tmpInitDate = EQSRV.GLBDATA.cDmdDate
                        EQSRV.GLBDATA.nxtDmdDate = EQSRV.GLBDATA.DmdDate
                        EQSRV.GLBDATA.addmnths = "0"
                        EQSRV.GLBDATA.adddays = "1"
                        EQSRV.GLBDATA.balDate = (EQSRV.GLBDATA.nxtDmdDate + "|" + EQSRV.GLBDATA.addmnths + "|" + EQSRV.GLBDATA.adddays)
                        print(EQSRV.GLBDATA.balDate)
                        sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.balDate)
                        if(sv_u != 0)then
                                EQSRV.GLBDATA.nxtDmdovDate = EQSRV.GLBDATA.cDmdovDate
                        else
                                print(BANCS.OUTPARAM.MODIFIED_DATE)
                                EQSRV.GLBDATA.nxtDmdovDate = mid$(BANCS.OUTPARAM.MODIFIED_DATE,0,10)
                        endif
                endif
                print(EQSRV.GLBDATA.ddaRec)
                if(cdouble(EQSRV.GLBDATA.ddaRec)>=1)then
                BANCS.INPARAM.date1 = EQSRV.GLBDATA.DmdDate
                BANCS.INPARAM.date2 = EQSRV.GLBDATA.tmpInitDate
                sv_u = urhk_B2K_dateDiff("")
                print(sv_u)
                if(sv_u == 0 ) then
                        BANCS.INPUT.migdatediff = BANCS.OUTPARAM.dateDiff
                else
                        BANCS.INPUT.migdatediff = 365
                endif
                EQSRV.GLBDATA.addmnths = "0"
                EQSRV.GLBDATA.adddays = BANCS.INPUT.migdatediff
                EQSRV.GLBDATA.balDate = (EQSRV.GLBDATA.cDmdDate + "|" + EQSRV.GLBDATA.addmnths + "|" + EQSRV.GLBDATA.adddays)
                print(EQSRV.GLBDATA.balDate)
                sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.balDate)
                if(sv_u != 0)then
                        EQSRV.GLBDATA.nxtDmdDate = EQSRV.GLBDATA.cDmdDate
                else
                        print(BANCS.OUTPARAM.MODIFIED_DATE)
                        EQSRV.GLBDATA.nxtDmdDate = mid$(BANCS.OUTPARAM.MODIFIED_DATE,0,10)
                endif
                EQSRV.GLBDATA.addmnths = "0"
                EQSRV.GLBDATA.adddays = "1"
                EQSRV.GLBDATA.balDate = (EQSRV.GLBDATA.nxtDmdDate + "|" + EQSRV.GLBDATA.addmnths + "|" + EQSRV.GLBDATA.adddays)
                print(EQSRV.GLBDATA.balDate)
                sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.balDate)
                if(sv_u != 0)then
                        EQSRV.GLBDATA.nxtDmdovDate = EQSRV.GLBDATA.cDmdovDate
                else
                        print(BANCS.OUTPARAM.MODIFIED_DATE)
                        EQSRV.GLBDATA.nxtDmdovDate = mid$(BANCS.OUTPARAM.MODIFIED_DATE,0,10)
                endif
                endif
                lv_f = " update custom.odla_dmd_tbl set dmd_date=to_date(?SVAR,'DD-MM-RRRR'),dmd_ovdu_date=to_date(?SVAR,'DD-MM-RRRR'),lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and od_acid=?SVAR and flow_id in ('PRDEM','INDEM') and entity_cre_flg='Y' and del_flg='N' and dmd_date=to_date(?SVAR,'DD-MM-RRRR') and dmd_ovdu_date=to_date(?SVAR,'DD-MM-RRRR')"
                BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.nxtDmdDate + "|" + EQSRV.GLBDATA.nxtDmdovDate + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.LoanAcid + "|" + EQSRV.GLBDATA.cDmdDate + "|" + EQSRV.GLBDATA.cDmdovDate
                print(BANCS.INPARAM.BINDVARS)
                print(lv_f)
                lv_h = urhk_dbSqlWithBind(lv_f)
                if(lv_h==0)then
                        print("frequency rescheduled")
                        lv_h = urhk_dbSqlWithBind("commit")
                        EQSRV.GLBDATA.FreshYcnt = cdouble(EQSRV.GLBDATA.FreshYcnt) + 1
                else
                        print("frequency reschedule failed")
                        EQSRV.GLBDATA.FreshNcnt = cdouble(EQSRV.GLBDATA.FreshNcnt) + 1
                endif

                NXTREC:
                sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.schdlcurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.schdlcurNum)
                        print(sv_u)
                        EQSRV.GLBDATA.srvErrMsg =  "Cursor Fetch Failed"
                        EQSRV.GLBDATA.srvErrCode = "DBCursor"
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto FREQEND
                endif
                EQSRV.GLBDATA.ddaRec = cint(EQSRV.GLBDATA.ddaRec) + 1
                EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.ddaRec
                print(EQSRV.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.schdlcurNum)
        print(sv_u)
FREQEND:
        print(EQSRV.GLBDATA.srvErrMsg)
        print(EQSRV.GLBDATA.srvErrCode)
        print(EQSRV.GLBDATA.srvSucFail)
        print(EQSRV.GLBDATA.FreshYcnt)
        print(EQSRV.GLBDATA.FreshNcnt)
        if(cdouble(EQSRV.GLBDATA.FreshYcnt)>=1)then
                EQSRV.GLBDATA.reshType = "F"
                if(cdouble(EQSRV.GLBDATA.exRshcnt)<=0)then
                        lv_i = " Insert into custom.odla_dmd_rsh_cnt (BANK_ID,SHDL_NUM,OD_ACID,RESH_TYPE,RESH_CNT,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,ENTITY_CRE_FLG,DEL_FLG,FREE_TEXT_1,FREE_TEXT_2,FREE_TEXT_3,FREE_TEXT_4,FREE_TEXT_5,FREE_TEXT_6) values (?SVAR,?NVAR,?SVAR,?SVAR,1,?SVAR,sysdate,?SVAR,sysdate,'Y','N',null,null,null,null,null,null)"
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.cShdlNum + "|" + EQSRV.GLBDATA.LoanAcid + "|" + EQSRV.GLBDATA.reshType + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId
                else
                        lv_i = " Update custom.odla_dmd_rsh_cnt set resh_cnt=resh_cnt+1,lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and od_acid=?SVAR "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.LoanAcid
                endif
                print(lv_i)
                print(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                sv_u = urhk_SetOrbOut("Message|Loan Demand Frequency Rescheduled Successfully")
                sv_u = urhk_SetOrbOut("NumberOfDemand|" + EQSRV.GLBDATA.FreshYcnt )
                sv_u = urhk_SetOrbOut("LoanAcctId|" + EQSRV.GLBDATA.OdAcctId )
        endif
        if(cdouble(EQSRV.GLBDATA.FreshYcnt)!=cdouble(EQSRV.GLBDATA.FreshNcnt))then
                if(cdouble(EQSRV.GLBDATA.FreshNcnt)>=1)then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Loan Demand Frequency Rescheduling Failed")
                sv_u = urhk_SetOrbOut("LoanAcctId|" + EQSRV.GLBDATA.OdAcctId )
        endif
trace off
end-->
