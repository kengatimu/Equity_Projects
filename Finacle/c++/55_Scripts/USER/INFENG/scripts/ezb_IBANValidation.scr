<--start
trace on

	IF (REPEXISTS("EAZBZ") == 0) THEN
	#{
		CREATEREP("EAZBZ")
	#}
	ENDIF

	IF (CLASSEXISTS("EAZBZ","DATA") == 0) THEN
	#{
		CREATECLASS("EAZBZ","DATA",5)
	#}
	ENDIF
	
	sv_x = urhk_B2k_PrintRepos("BANCS")
    print(sv_x)
	
	IF(FIELDEXISTS(BANCS.INPUT.AccountNo) == 1 ) THEN
	#{
		EAZBZ.DATA.IBAN = BANCS.INPUT.AccountNo
		print(EAZBZ.DATA.IBAN)
	#}
	ELSE
	#{
		EAZBZ.DATA.IBAN = ""
		lv_c = "Please Enter Account Number"
		sv_t = "IBANValidation_RES.<rec_1>.Error| " + lv_c
		sv_u = urhk_SetOrbOut(sv_t)
	#}
    ENDIF

    IF(FIELDEXISTS(BANCS.STDIN.myBankCode) == 1 ) THEN
	#{
		EAZBZ.DATA.bankCode = BANCS.STDIN.myBankCode
		print(EAZBZ.DATA.bankCode)
	#}
	ELSE
	#{
		EAZBZ.DATA.bankCode = ""
	#}
    ENDIF

    BANCS.INPARAM.iban_number = EAZBZ.DATA.IBAN
	sv_u = urhk_getForacidFromIBANnumber("") 
	PRINT(sv_u)
	IF (sv_u==0) THEN
		PRINT(BANCS.OUTPARAM.foracid)
		IF(BANCS.OUTPARAM.foracid != "") THEN
			EAZBZ.DATA.accountNum = TRIM(BANCS.OUTPARAM.foracid)
			print(EAZBZ.DATA.accountNum)
		ELSE
			EAZBZ.DATA.accountNum = ""
		ENDIF
	ELSE
		EAZBZ.DATA.accountNum = ""
	ENDIF

	
	sv_a = urhk_getAcctDetailsInRepository(EAZBZ.DATA.accountNum)

    IF(sv_a == 0) THEN
    #{
        EAZBZ.DATA.solid = BANCS.OUTPARAM.acctSolId
        print(EAZBZ.DATA.solid)

        EAZBZ.DATA.ownership = trim(BANCS.OUTPARAM.acctOwnerShip)
        print(EAZBZ.DATA.ownership)

        IF(EAZBZ.DATA.ownership !="O")THEN
        #{
        	sv_q = "ibanNumber,hashNo,solId,brName,cntryCode,city,instName,postalCode,routingNum,bic |"
			sv_q = sv_q + "select * from (select iban_number,hashed_no,sol_id, "
			sv_q = sv_q + "(select SWIFT_BR_NAME from tbaadm.bct b where b.bank_id=g.bank_id and b.br_code=g.sol_id and b.del_flg='N' and bank_code=?SVAR) brname,"
			sv_q = sv_q + "(select CNTRY_CODE from tbaadm.bct b2 where b2.bank_id=g.bank_id  and b2.br_code=g.sol_id and b2.del_flg='N' and bank_code=?SVAR) cntrycode,"
			sv_q = sv_q + "(select ref_desc from tbaadm.rct r, tbaadm.bct b3 where r.ref_code=b3.br_city_code and b3.bank_id=g.bank_id and b3.br_code=g.sol_id and b3.del_flg='N' and b3.bank_code=?SVAR and rownum < 2) city,"
			sv_q = sv_q + "(select BANK_NAME  from tbaadm.bkc b4 where b4.bank_id=g.bank_id and b4.del_flg='N' and b4.bank_code=?SVAR) instName,"
			sv_q = sv_q + "(select BR_ADDR_1 from tbaadm.bct b5 where b5.bank_id=g.bank_id and b5.br_code=g.sol_id and b5.del_flg='N' and b5.bank_code=?SVAR) postal, "
			sv_q = sv_q + "(select ROUTING_BANK_CODE from tbaadm.bct b6 where b6.bank_id=g.bank_id and b6.br_code=g.sol_id and b6.del_flg='N' and b6.bank_code=?SVAR) routingNum,"
			sv_q = sv_q + "( select BANK_IDENTIFIER  from tbaadm.brbic b7 where b7.branch_code=g.sol_id and b7.del_flg='N' and  b7.bank_code=?SVAR  and rownum < 2) bic "
			sv_q = sv_q + "from tbaadm.gam g where foracid=?SVAR and bank_id=?SVAR) "
			print(sv_q)

			BANCS.INPARAM.BINDVARS = EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.accountNum +"|"+BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_c = urhk_dbSelectWithBind(sv_q)
			PRINT(sv_c)

			IF(sv_c == 0)THEN
			#{
				EAZBZ.DATA.ibanNumber = BANCS.OUTPARAM.ibanNumber
				print(EAZBZ.DATA.ibanNumber)
				EAZBZ.DATA.hashNo = BANCS.OUTPARAM.hashNo
				print(EAZBZ.DATA.hashNo)
				EAZBZ.DATA.solId = BANCS.OUTPARAM.solId
				print(EAZBZ.DATA.solId)
				EAZBZ.DATA.brName = BANCS.OUTPARAM.brName
				print(EAZBZ.DATA.brName)
				EAZBZ.DATA.cntryCode = BANCS.OUTPARAM.cntryCode
				print(EAZBZ.DATA.cntryCode)
				EAZBZ.DATA.city = BANCS.OUTPARAM.city
				print(EAZBZ.DATA.city)
				EAZBZ.DATA.instName = BANCS.OUTPARAM.instName
				print(EAZBZ.DATA.instName)
				EAZBZ.DATA.postalCode = BANCS.OUTPARAM.postalCode
				EAZBZ.DATA.postalCode = EAZBZ.DATA.postalCode +","+ EAZBZ.DATA.city+"," + EAZBZ.DATA.cntryCode
				print(EAZBZ.DATA.postalCode)
				EAZBZ.DATA.routingNum = BANCS.OUTPARAM.routingNum
				print(EAZBZ.DATA.routingNum)
				EAZBZ.DATA.bic = BANCS.OUTPARAM.bic
				print(EAZBZ.DATA.bic)
			ELSE
				PRINT("eRROR")
				lv_c = "An error occured!! Try again."
				sv_t = "IBANValidation_RES.<rec_1>.Error| " + lv_c
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ENDIF

        ELSE 
        	lv_c = "Office Accounts not Allowed"
			sv_t = "IBANValidation_RES.<rec_1>.Error| " + lv_c
			sv_u = urhk_SetOrbOut(sv_t)
        #}
        ENDIF 
    ELSE 
    	lv_c = "Invalid Account Number"
		sv_t = "IBANValidation_RES.<rec_1>.Error| " + lv_c
		sv_u = urhk_SetOrbOut(sv_t)
    #}
    ENDIF     
	

		sv_q = "paysys, bic|"
		sv_q = sv_q + "select PAYSYS_ID,BANK_IDENTIFIER from tbaadm.brbic where bank_code=?SVAR and branch_code=?SVAR and del_flg='N' "
		print(sv_q)

		BANCS.INPARAM.BINDVARS = EAZBZ.DATA.bankCode +"|"+ EAZBZ.DATA.solid
		print(BANCS.INPARAM.BINDVARS)
		
		sv_c = urhk_dbcursorOpenWithBind(sv_q)
		PRINT(sv_c)

		IF (sv_c == 0)THEN
		#{
			EAZBZ.DATA.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(EAZBZ.DATA.cursor_number)

			sv_d = urhk_dbCursorFetch(EAZBZ.DATA.cursor_number)
			print(sv_d)

			sv_q = 0
			print(sv_q)

			WHILE (sv_d == 0)
			#{
				sv_q = sv_q + 1
				print(sv_q)

				sv_v = "Paysys_" + FORMAT$(sv_q, "%d") 
				("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.paysys

				sv_v = "BIC_" + FORMAT$(sv_q, "%d") 
				("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.bic
				
				sv_d = urhk_dbCursorFetch(EAZBZ.DATA.cursor_number)
				print(sv_d)

			#}
			DO 

			sv_x = urhk_dbCursorClose(EAZBZ.DATA.cursor_number)
			print(sv_x)
			print(EAZBZ.DATA.cursor_number)
			
			EAZBZ.DATA.totRec =  sv_q
			print(EAZBZ.DATA.totRec)

			EAZBZ.DATA.null = " "
			
			sv_t = "IBANValidation_RES.AccountNumber| " + EAZBZ.DATA.accountNum
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.IBAN| " + EAZBZ.DATA.ibanNumber
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.AccountNo| " + EAZBZ.DATA.accountNum
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.accountBase| " + EAZBZ.DATA.null
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.accountChecksum| " + EAZBZ.DATA.hashNo
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.bban| " + EAZBZ.DATA.null
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.branchCode| " + EAZBZ.DATA.solId
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.branchCodeClearingSystems| " + EAZBZ.DATA.null
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.branchName| " + EAZBZ.DATA.brName
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.city| " + EAZBZ.DATA.city
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.instTitle| " + EAZBZ.DATA.instName
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.instTitleOver| " + EAZBZ.DATA.instName
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.postal| " + EAZBZ.DATA.postalCode
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.routingNo| " + EAZBZ.DATA.routingNum
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.street| " + EAZBZ.DATA.null
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "IBANValidation_RES.swiftOver| " + EAZBZ.DATA.null
			sv_u = urhk_SetOrbOut(sv_t)
			
			sv_q = 1

			WHILE (sv_q <= EAZBZ.DATA.totRec)
			#{
				sv_v = "BIC_" + FORMAT$(sv_q, "%d")
				sv_t = "IBANValidation_RES.Paysys.<rec_" + FORMAT$(sv_q,"%d") + ">.code| " + ("EAZBZ").("DATA").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)
				sv_v = "Paysys_" + FORMAT$(sv_q, "%d")
				sv_t = "IBANValidation_RES.Paysys.<rec_" + FORMAT$(sv_q,"%d") + ">.clearingSystem| " + ("EAZBZ").("DATA").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_q = sv_q + 1
				print(sv_q)
			#}
			DO
		#}
		ENDIF
				
	
ENDOFSCRIPT:
##trace off
