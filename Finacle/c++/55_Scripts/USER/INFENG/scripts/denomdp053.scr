<--START
CHECKSUM="28ba175a3c31e6afcb9cb821e7887b0bf37a374e7215b7a3d2bbad97916d4e6c"
	TRACE ON
	
	sv_r=urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_r)
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "TM") == 0) THEN
	#{
		CREATECLASS("CUST","TM",5)
	#}
	ENDIF
	CUST.TM.FLG="N"
	PRINT(CUST.TM.FLG)
	
	
	CUST.TM.fromCrncy = TOUPPER(BANCS.INPUT.acctCrncy)
	CUST.TM.toCrncy = TOUPPER(BANCS.INPUT.refCrncy)
	CUST.TM.bank_id = BANCS.STDIN.contextBankId
	CUST.TM.MENUId =  BANCS.STDIN.menuId
	
	CUST.TM.ratecode = ""
	
	BANCS.INPARAM.BINDVARS = CUST.TM.fromCrncy +"|"+ CUST.TM.toCrncy +"|"+ CUST.TM.bank_id
	sv_q = "count|select count(distinct fxd_crncy_code)  "
	sv_q = sv_q + "FROM tbaadm.rtl "
	sv_q = sv_q + "WHERE fxd_crncy_code= ?SVAR "
	sv_q = sv_q + "AND var_crncy_code = ?SVAR "
	sv_q = sv_q + "AND var_crncy_units > 1 "
	sv_q = sv_q + "AND del_flg != 'Y' "
	sv_q = sv_q + "AND bank_id = ?SVAR "
	sv_q = sv_q + "AND rownum <2 "
	PRINT(sv_q)
	sv_u = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_u)
	IF(BANCS.OUTPARAM.count == 0) THEN
	#{
		CUST.TM.type="SELL_RC"
		PRINT(CUST.TM.type)
		#}
	ELSE
		#{
		CUST.TM.type="BUY_RC"
		PRINT(CUST.TM.type)
	#}
	ENDIF
	
	
	BANCS.INPUT.moduleName = "CASHDX_RT_CODE"
	PRINT(BANCS.INPUT.moduleName)
	
	BANCS.INPUT.parameterId = CUST.TM.type
	PRINT(BANCS.INPUT.parameterId)
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.TM.ratecode = BANCS.OUTPUT.parameterVal
		sv_u = urhk_SetOrbOut("rateCode|"+CUST.TM.ratecode)
		PRINT(sv_u)
		#}
	ELSE
		#{
		#sv_u = urhk_SetOrbOut("N|Setvar SetUp not available")
		CUST.TM.rateCode1="NOR"
		sv_u = urhk_SetOrbOut("rateCode|"+CUST.TM.rateCode1)
		PRINT(sv_u)
	#}
	ENDIF
	
	###########################################################################################
	# Get Treasury Rate From SRV
	###########################################################################################
	
	sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.TM.fromCrncy)
	sv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.TM.toCrncy)
	IF(TRIM(CUST.TM.ratecode) == "")THEN
	#{
		CUST.TM.ratecode = "NOR"
	#}
	ENDIF
	sv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.TM.ratecode)
	sv_u = urhk_SetUrhkOut("treaRate|treaRate")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_TieredConvCrncy")
	PRINT(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.TM.treaRate = BANCS.OUTPARAM.treaRate
		PRINT(CUST.TM.treaRate)
		sv_u = urhk_SetOrbOut("treaRate|"+CUST.TM.treaRate)
		PRINT(sv_u)
	#}
	ENDIF
	
	
	TRACE OFF
END-->
