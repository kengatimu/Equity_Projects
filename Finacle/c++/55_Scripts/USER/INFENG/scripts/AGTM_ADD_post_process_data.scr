<--START
TRACE ON

sv_a = urhk_B2k_printRepos("BANCS")
print(sv_a)


IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
	CREATECLASS("CUST","DATA",5)
#}
ENDIF

sv_u = urhk_SRV_GetVal("sol_id")
CUST.DATA.sol_id = BANCS.OUTPARAM.srvValue
print(CUST.DATA.sol_id)

sv_u = urhk_SRV_GetVal("agent_code")
CUST.DATA.agent_code = trim(BANCS.OUTPARAM.srvValue)
print(CUST.DATA.agent_code)

sv_u = urhk_SRV_GetVal("agent_short_name")
CUST.DATA.agent_short_name = trim(BANCS.OUTPARAM.srvValue)
print(CUST.DATA.agent_short_name)

IF (BANCS.STDIN.contextBankId=="54") THEN
	sv_q = "update tbaadm.agt set SOL_ID=?SVAR where AGENT_CODE=?SVAR and  BANK_ID=?SVAR and rownum<2 "
	PRINT(sv_q)
	BANCS.INPARAM.BINDVARS = CUST.DATA.agent_short_name + "|" + CUST.DATA.agent_code + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_p= urhk_dbSQLWithBind(sv_q)
	print(sv_p)
	if (sv_p==0) then
		sv_d = urhk_dbSqlWithBind("COMMIT")
		print(sv_d)
		print("Okay")
	else
		sv_d = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_d)
		print("Error")
	endif
ENDIF
EXITSCRIPT
END-->
