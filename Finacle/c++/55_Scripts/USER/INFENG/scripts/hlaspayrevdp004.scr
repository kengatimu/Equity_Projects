<--START
CHECKSUM="5b9d39b7e93c0c12bd2fda63a9f6b47158e3b306718b06bdc1c5c4d1c75187e7"
	TRACE ON
	
	###########################################################################################
	print(CUST.HLASPAYREV.srlNum)
	PRINT(CUST.HLASPAYREV.errMsgFlg)
	PRINT(CUST.HLASPAYREV.errMsg)
	
	###########################################################################################
	
	sv_s = "UPDATE CUSTOM.LSPRV SET "
	sv_s = sv_s + " STATUS_FLG = 'F',"
	sv_s = sv_s + " FAILURE_MSG = ?SVAR" + ","
	sv_s = sv_s + " LCHG_USER_ID = ?SVAR" + ","
	sv_s = sv_s + " LCHG_TIME = sysdate"
	sv_s = sv_s + " WHERE SRL_NUM = ?SVAR"
	
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + MID$(CUST.HLASPAYREV.errMsg,0,80)		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId                    + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.HLASPAYREV.srlNum
	
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.HLASPAYREV.errMsg = "Database Update Operation Failed ON Custom Table"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	ENDOFSCRIPT:
		
END-->
