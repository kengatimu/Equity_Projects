############################################################################################################
<--START
	TRACE ON
	#==========================================================
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CDMM") == 0) THEN
	#{
		CREATECLASS("CUST", "CDMM", 5)
	#}
	ENDIF
	
	CUST.CDMM.errorMsg = ""
	CUST.CDMM.funcCode = BANCS.INPUT.funcCode
	print(CUST.CDMM.funcCode)
	CUST.CDMM.roleId = BANCS.INPUT.roleId
	print(CUST.CDMM.roleId)
	CUST.CDMM.usrwrkcls= BANCS.INPUT.usrwrkcls
	print(CUST.CDMM.usrwrkcls)
	CUST.CDMM.recCount = "0"
	
	########################################################################################
	# Validation of funcCode Code
	########################################################################################
	IF (CUST.CDMM.funcCode == "") THEN
	#{
		sv_e = "Enter the function"
		sv_m = "funcCode"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF (CUST.CDMM.roleId == "") THEN
	#{
		sv_e = "Enter the Role ID"
		sv_m = "roleId"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	
	IF (CUST.CDMM.usrwrkcls == "") THEN
	#{
		sv_e = "Enter the User Work Class"
		sv_m = "usrwrkcls"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF ((CUST.CDMM.funcCode != "") AND(CUST.CDMM.funcCode == "A")) THEN
	#{
		sv_s = "recCount|SELECT COUNT(1) FROM CUSTOM.C_FINACLEUSER_MAPPING_TBL"
		sv_s = sv_s + " where ROLE_ID = ?SVAR  and USER_WORK_CLASS = ?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CDMM.roleId + "|" + CUST.CDMM.usrwrkcls
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.CDMM.recCount = BANCS.OUTPARAM.recCount
			PRINT(CUST.CDMM.recCount)
		#}
		ENDIF

		IF(CUST.CDMM.recCount != "0")THEN
		#{
			sv_e = "Record already exists"
			sv_m = "usrwrkcls"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.CDMM.funcCode == "A") THEN
	#{
		sv_s = "c_wrkCls|SELECT COUNT(1) FROM TBAADM.RCT WHERE REF_REC_TYPE='29' and REF_CODE = ?SVAR AND DEL_FLG = 'N'"
		
		BANCS.INPARAM.BINDVARS = CUST.CDMM.usrwrkcls
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CDMM.c_wrkCls = BANCS.OUTPARAM.c_wrkCls
			IF(CUST.CDMM.c_wrkCls == "0")THEN
			#{
				sv_e = "Invalid User Work Class"
				sv_m = "usrwrkcls"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT       
			#}
			ENDIF
		#}
		ENDIF
	
		sv_s = "c_usrRoleId|SELECT COUNT(1) FROM TBAADM.RPT WHERE ROLE_ID = ?SVAR AND DEL_FLG = 'N'"
	
		BANCS.INPARAM.BINDVARS = CUST.CDMM.roleId
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CDMM.c_usrRoleId = BANCS.OUTPARAM.c_usrRoleId
			IF(CUST.CDMM.c_usrRoleId == "0")THEN
			#{
				sv_e = "Invalid Role ID"
				sv_m = "roleId"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT       
			#}
			ENDIF
		#}
		ENDIF
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		exitscript
		
	#}
	ENDIF
	
sv_s = "ASSIGN_SSOADMIN,CRE_ASSIGN_SVSSERVER,CRE_ASSIGN_REPORT_INFRA,ASSIGN_ADMIN_WORKFLOW,ASSIGN_FCSE,ASSIGN_FINACLE_INTEGRATOR,"
sv_s = sv_s + "CRE_ASSIGN_CORE_SERVER,ASSIGN_CRM_SERVICE,CRE_ASSIGN_CRM_SERVER,IS_GLOBAL_ADMIN,USER_GROUP_NAME,SSO_ROLE_NAME,VIRTUAL_FLG,PRIMARY_GROUP_ID,DESCRIPTION,PROXY_POST_ALLWD,REMOTE_ACCESS_FLG,SSO_ROLE_ID,DEL_FLG|SELECT "
sv_s = sv_s + " ASSIGN_SSOADMIN,CRE_ASSIGN_SVSSERVER,CRE_ASSIGN_REPORT_INFRA,ASSIGN_ADMIN_WORKFLOW,ASSIGN_FCSE,ASSIGN_FINACLE_INTEGRATOR,"
sv_s = sv_s + "CRE_ASSIGN_CORE_SERVER,ASSIGN_CRM_SERVICE,CRE_ASSIGN_CRM_SERVER,IS_GLOBAL_ADMIN,USER_GROUP_NAME,SSO_ROLE_NAME,VIRTUAL_FLG,PRIMARY_GROUP_ID,DESCRIPTION,PROXY_POST_ALLWD,REMOTE_ACCESS_FLG,SSO_ROLE_ID,DEL_FLG FROM CUSTOM.C_FINACLEUSER_MAPPING_TBL"
sv_s = sv_s + " where ROLE_ID = ?SVAR  and USER_WORK_CLASS = ?SVAR"
BANCS.INPARAM.BINDVARS = CUST.CDMM.roleId + "|" + CUST.CDMM.usrwrkcls
PRINT(sv_s)
PRINT(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
        CUST.CDMM.ASSIGN_SSOADMIN  =  BANCS.OUTPARAM.ASSIGN_SSOADMIN
        CUST.CDMM.CRE_ASSIGN_SVSSERVER  =  BANCS.OUTPARAM.CRE_ASSIGN_SVSSERVER
        CUST.CDMM.CRE_ASSIGN_REPORT_INFRA  =  BANCS.OUTPARAM.CRE_ASSIGN_REPORT_INFRA
        CUST.CDMM.ASSIGN_ADMIN_WORKFLOW  =  BANCS.OUTPARAM.ASSIGN_ADMIN_WORKFLOW
        CUST.CDMM.ASSIGN_FCSE  =  BANCS.OUTPARAM.ASSIGN_FCSE
        CUST.CDMM.ASSIGN_FINACLE_INTEGRATOR  =  BANCS.OUTPARAM.ASSIGN_FINACLE_INTEGRATOR
        CUST.CDMM.CRE_ASSIGN_CORE_SERVER  = BANCS.OUTPARAM.CRE_ASSIGN_CORE_SERVER
        CUST.CDMM.ASSIGN_CRM_SERVICE  = BANCS.OUTPARAM.ASSIGN_CRM_SERVICE
        CUST.CDMM.CRE_ASSIGN_CRM_SERVER  = BANCS.OUTPARAM.CRE_ASSIGN_CRM_SERVER
        CUST.CDMM.isGlobalAdmin = BANCS.OUTPARAM.IS_GLOBAL_ADMIN
        CUST.CDMM.USER_GROUP_NAME = BANCS.OUTPARAM.USER_GROUP_NAME
        CUST.CDMM.RoleName = BANCS.OUTPARAM.SSO_ROLE_NAME
        CUST.CDMM.VIRTUAL_FLG = BANCS.OUTPARAM.VIRTUAL_FLG
        CUST.CDMM.PRIMARY_GROUP_ID = BANCS.OUTPARAM.PRIMARY_GROUP_ID
        CUST.CDMM.DESCRIPTION = BANCS.OUTPARAM.DESCRIPTION
        CUST.CDMM.PROXY_POST_ALLWD = BANCS.OUTPARAM.PROXY_POST_ALLWD
        CUST.CDMM.REMOTE_ACCESS_FLG = BANCS.OUTPARAM.REMOTE_ACCESS_FLG
        CUST.CDMM.SSO_ROLE_ID = BANCS.OUTPARAM.SSO_ROLE_ID
        CUST.CDMM.DEL_FLG = BANCS.OUTPARAM.DEL_FLG
#}
ELSE
#{
        sv_e = "Record not exists for User Work Class and Role ID Combination"
	sv_m = "usrwrkcls"
	sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
	sv_u = urhk_SetOrbOut(sv_s)
        sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
        EXITSCRIPT
#}
ENDIF

	IF ((CUST.CDMM.DEL_FLG == "Y") AND(CUST.CDMM.funcCode == "D")) THEN
	#{
		sv_e = "Record already Deleted"
		sv_m = "usrwrkcls"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ((CUST.CDMM.DEL_FLG != "Y") AND(CUST.CDMM.funcCode == "U")) THEN
	#{
		sv_e = "Record not Deleted"
		sv_m = "usrwrkcls"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	

		IF(TRIM(CUST.CDMM.ASSIGN_SSOADMIN) != "")THEN
		#{
			sv_u = urhk_SetOrbOut("ssoadmin|" + CUST.CDMM.ASSIGN_SSOADMIN)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.CRE_ASSIGN_SVSSERVER) != "")THEN
		#{
			sv_u = urhk_SetOrbOut("svsserver|" + CUST.CDMM.CRE_ASSIGN_SVSSERVER)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.CRE_ASSIGN_REPORT_INFRA) != "")THEN
		#{		
			sv_u = urhk_SetOrbOut("reportinfra|" + CUST.CDMM.CRE_ASSIGN_REPORT_INFRA)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.ASSIGN_ADMIN_WORKFLOW) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("adminworkflow|" + CUST.CDMM.ASSIGN_ADMIN_WORKFLOW)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.ASSIGN_FCSE) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("fcse|" + CUST.CDMM.ASSIGN_FCSE)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.ASSIGN_FINACLE_INTEGRATOR) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("finclintegratr|" + CUST.CDMM.ASSIGN_FINACLE_INTEGRATOR)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.CRE_ASSIGN_CORE_SERVER) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("coresrvr|" + CUST.CDMM.CRE_ASSIGN_CORE_SERVER)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.ASSIGN_CRM_SERVICE) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("crmservice|" + CUST.CDMM.ASSIGN_CRM_SERVICE)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.CRE_ASSIGN_CRM_SERVER) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("crmserver|" + CUST.CDMM.CRE_ASSIGN_CRM_SERVER)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.isGlobalAdmin) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("globaladmin|" + CUST.CDMM.isGlobalAdmin)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.USER_GROUP_NAME) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("usergrpname|" + CUST.CDMM.USER_GROUP_NAME)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.RoleName) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("rolename|" + CUST.CDMM.RoleName)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.VIRTUAL_FLG) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("virtualr|" + CUST.CDMM.VIRTUAL_FLG)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.PRIMARY_GROUP_ID) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("primarygrpid|" + CUST.CDMM.PRIMARY_GROUP_ID)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.DESCRIPTION) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("description|" + CUST.CDMM.DESCRIPTION)
		#}
		ENDIF		
		IF(TRIM(CUST.CDMM.PROXY_POST_ALLWD) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("proxypostr|" + CUST.CDMM.PROXY_POST_ALLWD)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.REMOTE_ACCESS_FLG) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("remoteacsr|" + CUST.CDMM.REMOTE_ACCESS_FLG)
		#}
		ENDIF
		IF(TRIM(CUST.CDMM.SSO_ROLE_ID) != "")THEN
		#{			
			sv_u = urhk_SetOrbOut("ssoroleid|" + CUST.CDMM.SSO_ROLE_ID)
		#}
		ENDIF
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
ENDOFSCRIPT:	
		EXITSCRIPT
END-->
