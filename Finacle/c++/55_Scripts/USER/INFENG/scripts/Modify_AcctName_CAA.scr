					PRINT(CUST.DATA.tablekey)

   					sv_a = "INSERT INTO TBAADM.TBA_AUDIT_TBL (ref_num,table_name,table_key,audit_srl_num,bank_id,audit_sol_id,acid,enterer_id,auth_id,rmks,audit_date, "
					sv_a =sv_a+ " modified_fields_data,func_code,init_sol_id,audit_bod_date,caller_module,referral_id,auth_date,auth_bod_date,mop_id,calling_func_name,entity_id) "
					sv_a =sv_a+ " VALUES ( ?SVAR , 'GAM' , ?SVAR , '002' , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , 'Account Name Changed' ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'Account Name has been Changed' , 'V' , '000' ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'O' , '' , "
					sv_a =sv_a+ " TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'),TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'), '' , 'NAPI_ExecOrbScr' , '!' )"
					PRINT(sv_a)

