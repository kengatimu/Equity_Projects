			#{
				sv_d = 1
				WHILE (sv_d <= sv_c)
				#{
					sv_f = FORMAT$(sv_d, "%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_f)
					sv_m = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_f)
