<--start
trace on

	IF (REPEXISTS("EAZBZ") == 0) THEN
	#{
		CREATEREP("EAZBZ")
	#}
	ENDIF

	IF (CLASSEXISTS("EAZBZ","DATA") == 0) THEN
	#{
		CREATECLASS("EAZBZ","DATA",5)
	#}
	ENDIF
	
	sv_x = urhk_B2k_PrintRepos("BANCS")
	print(sv_x)

	sv_v = "cifID"
	
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_v))) THEN
	#{
		
		EAZBZ.DATA.cifID =("BANCS").("INPUT").(sv_v)
		print(EAZBZ.DATA.cifID)
	#}
	ELSE
	#{
		EAZBZ.DATA.cifID = ""
		EAZBZ.DATA.successOrFailure = "F"
		EAZBZ.DATA.msg = "Please enter the CIF ID" 
		exitscript
	#}
	 ENDIF

	
	IF(FIELDEXISTS(BANCS.STDIN.contextBankId) ) THEN
	#{
		
		EAZBZ.DATA.bankID =BANCS.STDIN.contextBankId
		print(EAZBZ.DATA.bankID)
	#}
	ELSE
	#{
		EAZBZ.DATA.successOrFailure = "F"
		EAZBZ.DATA.errorCode = "ERR032"
		EAZBZ.DATA.msg = "Please enter the Bank ID" 
		exitscript
	#}
    ENDIF

    #-- Variable init 
    EAZBZ.DATA.BankId=""
	EAZBZ.DATA.CifNo =""
	EAZBZ.DATA.CustName=""
	EAZBZ.DATA.PrimaryID=""
	EAZBZ.DATA.RMName=""
	EAZBZ.DATA.Address1=""
	EAZBZ.DATA.Address2=""
	EAZBZ.DATA.Address3 = ""
	EAZBZ.DATA.CityTown =""
	EAZBZ.DATA.CountryCode =""
	EAZBZ.DATA.ZipCode = ""
	EAZBZ.DATA.PhoneNo=""
	EAZBZ.DATA.CellNo =""
	EAZBZ.DATA.EmailID =""
	EAZBZ.DATA.BranchCode =""
	EAZBZ.DATA.CustCategory=""
	EAZBZ.DATA.CustCategoryType =""
	EAZBZ.DATA.Status =""
	EAZBZ.DATA.lang =""
	EAZBZ.DATA.managerName=""
	EAZBZ.DATA.managerEmail = ""
	EAZBZ.DATA.rshpMgrName = ""
	EAZBZ.DATA.rshpMgrEmail = ""
	EAZBZ.DATA.totAccount = ""
	
	
	IF (EAZBZ.DATA.bankID=="54") THEN
	#{
		sv_a = urhk_GetChannelInfo("")
		print(sv_a)
	
		EAZBZ.DATA.DccId =BANCS.OUTPARAM.DccId
		print(EAZBZ.DATA.DccId)
		IF (EAZBZ.DATA.DccId=="OMN") THEN
		#{
			IF (FIELDEXISTS(EAZBZ.DATA.cifID) == 1) THEN
			#{
				IF (EAZBZ.DATA.cifID != "") THEN
				#{
					sv_q = "tin,segmentCode,BankId_1,CifNo,CustName,PrimaryID,RMName,Address1,Address2,Address3,CityTown,CountryCode,ZipCode,PhoneNo,CellNo,EmailID,BranchCode,CustCategory,CustCategoryType,Status,lang |"
					sv_q = sv_q + "select * from (select a.CUST_SWIFT_CODE_DESC,a.SEGMENTATION_CLASS,a.BANK_ID BankId_1, a.orgkey CifNo, a.name CustName, a.orgkey PrimaryID, MANAGER RMName, a.ADDRESS_LINE1 Address1, decode(a.ADDRESS_LINE2 ,null,"
					sv_q = sv_q + "(SELECT REF_DESC FROM tbaadm.RCT WHERE REF_REC_TYPE='01'AND REF_CODE=a.city and rct.bank_id = ?SVAR)) Address2, a.ADDRESS_LINE3 Address3,"
					sv_q = sv_q + "(SELECT REF_DESC FROM tbaadm.RCT WHERE REF_REC_TYPE='01'AND REF_CODE=a.city and rct.bank_id = ?SVAR) CityTown, a.COUNTRY CountryCode, a.ZIP ZipCode,"
					sv_q = sv_q + "a.PREFERREDPHONE PhoneNo, a.PREFERREDPHONE CellNo, a.PREFERREDEMAIL EmailID, a.PRIMARY_SOL_ID BranchCode, (case when a.CORP_ID is not null then 'C' else 'I' end) CustCategory,"
					sv_q = sv_q + "a.CUST_TYPE CustCategoryType, decode(a.SUSPENDED,'N','A','C') Status, "
					sv_q = sv_q + "(select l.localetext from crmuser.categories c, crmuser.category_lang l where c.bank_id=?SVAR and l.bank_id=c.bank_id and categorytype='LANGUAGE' and c.categoryid=l.categoryid) lang "
					sv_q = sv_q + "from crmuser.accounts a where a.orgkey = ?SVAR) "
					print(sv_q)

					BANCS.INPARAM.BINDVARS = EAZBZ.DATA.bankID +"|"+ EAZBZ.DATA.bankID +"|"+ EAZBZ.DATA.bankID +"|"+ EAZBZ.DATA.cifID
  	    				print(BANCS.INPARAM.BINDVARS)
					
					sv_c = urhk_dbSelectWithBind(sv_q)
					PRINT(sv_c)
					
					IF(sv_c == 0)THEN
					#{
						EAZBZ.DATA.tin = BANCS.OUTPARAM.tin
						EAZBZ.DATA.segmentCode = BANCS.OUTPARAM.segmentCode
						EAZBZ.DATA.BankId = BANCS.OUTPARAM.BankId_1
						EAZBZ.DATA.CifNo = BANCS.OUTPARAM.CifNo
						EAZBZ.DATA.CustName = BANCS.OUTPARAM.CustName
						EAZBZ.DATA.PrimaryID = BANCS.OUTPARAM.PrimaryID
						EAZBZ.DATA.RMName = BANCS.OUTPARAM.RMName
						
						EAZBZ.DATA.Address1 = BANCS.OUTPARAM.Address1
						EAZBZ.DATA.Address2 = BANCS.OUTPARAM.Address2
						EAZBZ.DATA.Address3 = BANCS.OUTPARAM.Address3
						EAZBZ.DATA.CityTown = BANCS.OUTPARAM.CityTown
						EAZBZ.DATA.CountryCode = BANCS.OUTPARAM.CountryCode
						EAZBZ.DATA.ZipCode = BANCS.OUTPARAM.ZipCode

						EAZBZ.DATA.PhoneNo = BANCS.OUTPARAM.PhoneNo
						EAZBZ.DATA.CellNo = BANCS.OUTPARAM.CellNo
						EAZBZ.DATA.EmailID = BANCS.OUTPARAM.EmailID
						EAZBZ.DATA.BranchCode = BANCS.OUTPARAM.BranchCode

						EAZBZ.DATA.CustCategory = BANCS.OUTPARAM.CustCategory
						EAZBZ.DATA.CustCategoryType = BANCS.OUTPARAM.CustCategoryType
						EAZBZ.DATA.Status = BANCS.OUTPARAM.Status
						EAZBZ.DATA.lang = BANCS.OUTPARAM.lang

						IF(EAZBZ.DATA.RMName != "")THEN
						#{
							lv_q = "userEmpId | select user_emp_id  from tbaadm.upr where user_id=?SVAR"
							BANCS.INPARAM.BINDVARS = EAZBZ.DATA.RMName
		  	    				print(BANCS.INPARAM.BINDVARS)
							
							sv_c = urhk_dbSelectWithBind(lv_q)
							PRINT(sv_c)

							IF(sv_c == 0)THEN
							#{
								lv_b = BANCS.OUTPARAM.userEmpId
								print(lv_b)

								lv_q = "rshpMgrName,rshpMgrEmail| select emp_name,emp_email_id from tbaadm.get where emp_id=?SVAR "
								BANCS.INPARAM.BINDVARS = lv_b
								
								sv_c = urhk_dbSelectWithBind(lv_q)
								PRINT(sv_c)
								
								IF(sv_c == 0)THEN
								#{
									EAZBZ.DATA.managerName = BANCS.OUTPARAM.rshpMgrName
									print(EAZBZ.DATA.managerName)
									EAZBZ.DATA.managerEmail = BANCS.OUTPARAM.rshpMgrEmail
									print(EAZBZ.DATA.managerEmail)
								ELSE
									EAZBZ.DATA.managerName = ""
									EAZBZ.DATA.managerEmail = ""
								#}
								ENDIF
							ELSE 
								EAZBZ.DATA.managerName = ""
								EAZBZ.DATA.managerEmail = ""
							#}
							ENDIF
						ELSE 
							EAZBZ.DATA.managerName = ""
							EAZBZ.DATA.managerEmail = ""
						#}
						ENDIF
					ELSE
						PRINT("ERROR IN FETCHING")
						EAZBZ.DATA.successOrFailure = "F"
						EAZBZ.DATA.msg = "Could not fetch the details" 
						GOTO ERRORHANDLER
					#}
					ENDIF

					
					sv_q = "IBAN,FrezCode,BankId,AccountNo,AccountCcy,Branch,AccountName,OpenDate,CIFNo,AccountType,ProductCd,AccCategory,ClosureFlag,ClosureDate,InactiveStatus,mandate,AcctMgr|"
					sv_q = sv_q + " select * from (select IBAN_NUMBER,FREZ_CODE,BANK_ID BankId, foracid AccountNo, acct_crncy_code AccountCcy, sol_id Branch, ACCT_NAME AccountName, to_char(acct_opn_date,'YYYYMMDD') OpenDate, cif_id CIFNo,"
					sv_q = sv_q + "schm_type AccountType, schm_code ProductCd,decode(cif_id,null,'Bank','Customer') AccCategory, decode(acct_cls_flg,'Y','C','O') ClosureFlag, to_char(acct_cls_date,'YYYYMMDD') ClosureDate, "
					sv_q = sv_q + "decode((select ACCT_STATUS from tbaadm.SMT WHERE acid=a.acid and SMT.bank_id = ?SVAR),'A','N',null,'N','Y') InactiveStatus,MODE_OF_OPER_CODE mandate, acct_mgr_user_id AcctMgr from tbaadm.gam a where a.del_flg='N' and a.acct_cls_flg='N' and a.cif_id = ?SVAR and CUST_ID is not null)"
					print(sv_q)

					BANCS.INPARAM.BINDVARS = EAZBZ.DATA.bankID +"|"+ EAZBZ.DATA.cifID
  	    				print(BANCS.INPARAM.BINDVARS)
					
					sv_c = urhk_dbcursorOpenWithBind(sv_q)
					PRINT(sv_c)

					IF (sv_c == 0)THEN
					#{
						EAZBZ.DATA.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
						PRINT(EAZBZ.DATA.cursor_number)

						sv_d = urhk_dbCursorFetch(EAZBZ.DATA.cursor_number)
						print(sv_d)

						sv_q = 0
						print(sv_q)

						WHILE (sv_d == 0)
						#{
							sv_q = sv_q + 1
							print(sv_q)
							sv_v = "BankId_" + FORMAT$(sv_q, "%d")
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.BankId

							sv_v = "AccountNo_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.AccountNo
							sv_v = "AccountCcy_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.AccountCcy
							sv_v = "Branch_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.Branch

							sv_v = "AccountName_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.AccountName
							sv_v = "OpenDate_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.OpenDate
							sv_v = "CIFNo_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.CIFNo
							sv_v = "AccountType_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.AccountType
							sv_v = "ProductCd_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.ProductCd
							sv_v = "AccCategory_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.AccCategory
							sv_v = "ClosureFlag_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.ClosureFlag
							sv_v = "ClosureDate_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.ClosureDate
							sv_v = "InactiveStatus_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.InactiveStatus
							sv_v = "Mandate_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.mandate
							print(("EAZBZ").("DATA").(sv_v))

							sv_v = "AcctMgr_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.AcctMgr
							print(BANCS.OUTPARAM.AcctMgr)

							sv_v = "IBAN_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.IBAN
							sv_v = "FrezCode_" + FORMAT$(sv_q, "%d") 
							("EAZBZ").("DATA").(sv_v) = BANCS.OUTPARAM.FrezCode
							
							#lv_d = strlen(lv_c)
							#print(lv_d)

							#lv_a = mid$(BANCS.OUTPARAM.AcctMgr, 2,lv_d - 2)
							#print(lv_a)


							lv_q = "userEmpId | select user_emp_id  from tbaadm.upr where user_id=?SVAR"
							BANCS.INPARAM.BINDVARS = BANCS.OUTPARAM.AcctMgr
		  	    				print(BANCS.INPARAM.BINDVARS)
							
							sv_c = urhk_dbSelectWithBind(lv_q)
							PRINT(sv_c)

							IF(sv_c == 0)THEN
							#{
								lv_a = BANCS.OUTPARAM.userEmpId
								lv_q = "rshpMgrName,rshpMgrEmail| select emp_name,emp_email_id from tbaadm.get where emp_id=?SVAR "

								BANCS.INPARAM.BINDVARS = lv_a
			  	    				print(BANCS.INPARAM.BINDVARS)
								
								sv_c = urhk_dbSelectWithBind(lv_q)
								PRINT(sv_c)
								
								IF(sv_c == 0)THEN
								#{
									EAZBZ.DATA.rshpMgrName = BANCS.OUTPARAM.rshpMgrName
									print(EAZBZ.DATA.rshpMgrName)
									EAZBZ.DATA.rshpMgrEmail = BANCS.OUTPARAM.rshpMgrEmail
									print(EAZBZ.DATA.rshpMgrEmail)

									sv_v = "AcctMgrName_" + FORMAT$(sv_q, "%d") 
									("EAZBZ").("DATA").(sv_v) = EAZBZ.DATA.rshpMgrName
									sv_v = "AcctMgrEmail_" + FORMAT$(sv_q, "%d") 
									("EAZBZ").("DATA").(sv_v) = EAZBZ.DATA.rshpMgrEmail
								ELSE
									print("Failed to fetch acct manager")
									EAZBZ.DATA.rshpMgrName = ""
									EAZBZ.DATA.rshpMgrEmail = ""
									sv_v = "AcctMgrName_" + FORMAT$(sv_q, "%d") 
									("EAZBZ").("DATA").(sv_v) = EAZBZ.DATA.rshpMgrName
									sv_v = "AcctMgrEmail_" + FORMAT$(sv_q, "%d") 
									("EAZBZ").("DATA").(sv_v) = EAZBZ.DATA.rshpMgrEmail
								#}
								ENDIF
							ELSE 
								EAZBZ.DATA.rshpMgrName = ""
								EAZBZ.DATA.rshpMgrEmail = ""
								sv_v = "AcctMgrName_" + FORMAT$(sv_q, "%d") 
								("EAZBZ").("DATA").(sv_v) = EAZBZ.DATA.rshpMgrName
								sv_v = "AcctMgrEmail_" + FORMAT$(sv_q, "%d") 
								("EAZBZ").("DATA").(sv_v) = EAZBZ.DATA.rshpMgrEmail
							#}
							ENDIF
							
							sv_d = urhk_dbCursorFetch(EAZBZ.DATA.cursor_number)
							print(sv_d)

						#}
						DO 

						sv_x = urhk_dbCursorClose(EAZBZ.DATA.cursor_number)
						print(sv_x)
						print(EAZBZ.DATA.cursor_number)
						
						
						EAZBZ.DATA.totAccount =  sv_q
						print(EAZBZ.DATA.totAccount)

						EAZBZ.DATA.hostSystem = "FIN"
						
						sv_t = "CustAcctInquiry_RES.BankID| " + EAZBZ.DATA.BankId
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CustomerID| " + EAZBZ.DATA.CifNo
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CustName| " + EAZBZ.DATA.CustName
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.PrimaryID| " + EAZBZ.DATA.PrimaryID
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.HostSystem| " + EAZBZ.DATA.hostSystem
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.RMId| " + EAZBZ.DATA.RMName
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.RMName| " + EAZBZ.DATA.managerName
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.RMEmail| " + EAZBZ.DATA.managerEmail
						sv_u = urhk_SetOrbOut(sv_t)

						sv_t = "CustAcctInquiry_RES.Email| " + EAZBZ.DATA.EmailID
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.Branch| " + EAZBZ.DATA.BranchCode
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CustCategory| " + EAZBZ.DATA.CustCategory
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CustCategoryType| " + EAZBZ.DATA.CustCategoryType
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CustStatus| " + EAZBZ.DATA.Status
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.NativeLangCode| " + EAZBZ.DATA.lang
						sv_u = urhk_SetOrbOut(sv_t)

						sv_t = "CustAcctInquiry_RES.Address1| " + EAZBZ.DATA.Address1
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.Address2| " + EAZBZ.DATA.Address2
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.Address3| " + EAZBZ.DATA.Address3
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CityTown| " + EAZBZ.DATA.CityTown
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CountryCode| " + EAZBZ.DATA.CountryCode
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.ZipCode| " + EAZBZ.DATA.ZipCode
						sv_u = urhk_SetOrbOut(sv_t)

						sv_t = "CustAcctInquiry_RES.PhoneNo| " + EAZBZ.DATA.PhoneNo
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.CellNo| " + EAZBZ.DATA.CellNo
						sv_u = urhk_SetOrbOut(sv_t)

						sv_t = "CustAcctInquiry_RES.SICCode| " + EAZBZ.DATA.segmentCode
						sv_u = urhk_SetOrbOut(sv_t)
						sv_t = "CustAcctInquiry_RES.TIN| " + EAZBZ.DATA.tin
						sv_u = urhk_SetOrbOut(sv_t)

						sv_q = 1

						WHILE (sv_q <= EAZBZ.DATA.totAccount)
						#{
							sv_v = "BankId_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.BankId| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
							sv_v = "AccountNo_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountID| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "AccountCcy_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountCrncy| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)

                			sv_v = "Branch_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.Branch| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "AccountName_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountName| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "OpenDate_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.OpenDate| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "CIFNo_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.CIFNo| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)

                			#----------------------
                			#- Account List 
                			#----------------------
                			sv_v = "AccountType_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountType| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "ProductCd_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ProductCd| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "AccCategory_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccCategory| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "ClosureFlag_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ClosureFlag| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)
                			sv_v = "ClosureDate_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ClosureDate| " + ("EAZBZ").("DATA").(sv_v)
                			sv_u = urhk_SetOrbOut(sv_t)

                			sv_v = "InactiveStatus_" + FORMAT$(sv_q, "%d")
							sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.InactiveStatus| " + ("EAZBZ").("DATA").(sv_v)
