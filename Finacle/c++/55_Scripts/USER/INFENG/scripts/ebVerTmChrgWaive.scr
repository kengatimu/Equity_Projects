#------------------------------------------------------------------------------------------------
#  Name            : ebVerTmChrgWaive.scr 
#  Description     : ETF/RTGS Charges Waiver for VER Channel.
#  Date            : 21-02-2020
#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             21-02-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	sv_u = urhk_GetChannelInfo("")
	if(sv_u==0)then
		EBSRV.GLBDATA.chnlId = BANCS.OUTPARAM.DccId
	else
		exitscript	
	endif
	if(EBSRV.GLBDATA.chnlId != "VER")then
		goto VAYU
	endif
#SrvValues
	EBSRV.GLBDATA.chrgDrYN = ""
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	if ((EBSRV.GLBDATA.tranSubType == "CI") or (EBSRV.GLBDATA.tranSubType=="BI"))then
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EBSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EBSRV.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
			EBSRV.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
			EBSRV.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars2)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg")
			EBSRV.GLBDATA.recDelYN=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.recDelYN)
		if(EBSRV.GLBDATA.foracid!="")then
		sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.foracid)
		if(sv_u==0)then
			EBSRV.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
			EBSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		endif
		endif
		if(EBSRV.GLBDATA.tranParticulars!="")then
		sv_u = "ChrgCnt | select regexp_count(?SVAR, 'Charge')+ "
	        sv_u = sv_u + "	regexp_count(?SVAR, 'charge')+ "
		sv_u = sv_u + " regexp_count(?SVAR, 'Charges')+ "
		sv_u = sv_u + " regexp_count(?SVAR, 'charges')+ "
		sv_u = sv_u + " regexp_count(?SVAR, 'CHARGE')+ "
		sv_u = sv_u + " regexp_count(?SVAR, 'CHARGES')from dual "
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars
		print(BANCS.INPARAM.BINDVARS)
		print(sv_u)
		sv_d = urhk_dbSelectWithBind(sv_u)
		if(sv_d==0)then
			EBSRV.GLBDATA.ChrgCnt = BANCS.OUTPARAM.ChrgCnt
		else
			EBSRV.GLBDATA.ChrgCnt = 0 
		endif
			print(EBSRV.GLBDATA.ChrgCnt)
		endif
		print(EBSRV.GLBDATA.partTranType)
		print(EBSRV.GLBDATA.schmCode)
		if((EBSRV.GLBDATA.partTranType=="D")and (cdouble(EBSRV.GLBDATA.ChrgCnt)>=1))then
			if(EBSRV.GLBDATA.foracid!="")then
			sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.foracid)
			if(sv_u==0)then
				EBSRV.GLBDATA.drChrgSolId = BANCS.OUTPARAM.acctSolId
			endif
			endif
		endif
		if((EBSRV.GLBDATA.partTranType=="C")and (cdouble(EBSRV.GLBDATA.ChrgCnt)>=1))then
			if(EBSRV.GLBDATA.foracid!="")then
			sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.foracid)
			if(sv_u==0)then
				EBSRV.GLBDATA.crChrBacid = BANCS.OUTPARAM.acctPlaceHolder 
				EBSRV.GLBDATA.crChrCrncy = BANCS.OUTPARAM.acctCrncyCode
			endif
			sv_t = EBSRV.GLBDATA.crChrBacid +"|"+ EBSRV.GLBDATA.crChrCrncy +"|"+ EBSRV.GLBDATA.drChrgSolId 
			print(sv_t)
			sv_u = urhk_B2k_BacidToAcctId(sv_t)
			if(sv_u == 0 )then
				EBSRV.GLBDATA.crChrgAcctId =BANCS.OUTPARAM.AcctId
				print(EBSRV.GLBDATA.crChrgAcctId)
			else
				EBSRV.GLBDATA.crChrgAcctId = ""
			endif
			if((EBSRV.GLBDATA.crChrgAcctId!="") and (EBSRV.GLBDATA.recDelYN!="Y"))then
			print("charge Vino")
			print(EBSRV.GLBDATA.crChrgAcctId)
			sv_u = urhk_B2k_ForacidToAcid(EBSRV.GLBDATA.crChrgAcctId)
                        if(sv_u==0)then
                                EBSRV.GLBDATA.goalacid = BANCS.OUTPARAM.Acid
                        else
                                EBSRV.GLBDATA.goalacid = "" 
			endif
			sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid|" + EBSRV.GLBDATA.crChrgAcctId )
			sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.acid|" + EBSRV.GLBDATA.goalacid ) 
			sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.solId|" + EBSRV.GLBDATA.drChrgSolId )
			endif
			endif
		endif
		if(EBSRV.GLBDATA.partTranType=="D")then
		if(((EBSRV.GLBDATA.schmCode=="CA202") or (EBSRV.GLBDATA.schmCode=="CA204") or (EBSRV.GLBDATA.schmCode=="SB190") or (EBSRV.GLBDATA.schmCode=="OTHER")) and (cdouble(EBSRV.GLBDATA.ChrgCnt)>=1))then
			sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg|Y")
			print(sv_u)
			EBSRV.GLBDATA.chrgDrYN="Y"
		else
			sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg|N")
			print(sv_u)
		endif
		endif
		print(EBSRV.GLBDATA.chrgDrYN)
		if(EBSRV.GLBDATA.partTranType=="C")then
			if((cdouble(EBSRV.GLBDATA.ChrgCnt)>=1) and (EBSRV.GLBDATA.chrgDrYN=="Y"))then
				sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg|Y")
				print(sv_u)
			else
				sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg|N")
				print(sv_u)
			endif
		endif
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif
VAYU:	
	####if(classexists("EBSRV","GLBDATA")==1) then
		#####deleteclass("EBSRV","GLBDATA")
	#####endif
	####if(repexists("EBSRV")==1) then
		#####deleterep("EBSRV")
	#####endif
	exitscript
##trace off
end-->
