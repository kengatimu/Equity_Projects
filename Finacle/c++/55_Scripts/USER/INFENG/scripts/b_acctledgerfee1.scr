<--start
trace on

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","LEDGR") == 0) THEN
#{
	CREATECLASS("CUST","LEDGR",5)
#}
ENDIF

IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
#{
	CREATECLASS("CUST","GCHRG",5)
#}
ENDIF

sv_b = BANCS.STDIN.mySolId
print(sv_b)

sv_q="foracid|"
sv_q = sv_q + "select foracid from tbaadm.gam where foracid='1160271801983' and schm_type='CAA' and acct_cls_flg='N' and acct_crncy_code='KES'"
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
	    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	    sv_q = urhk_dbCursorFetch(sv_m)
	    print(sv_q)

	   IF(sv_q == 1) THEN
		 sv_x = urhk_dbCursorClose(sv_m)
		 print(sv_x)
		 exitscript
	   ENDIF
	  print(sv_q)

WHILE (sv_q==0)
	CUST.LEDGR.foracid=BANCS.OUTPARAM.foracid
	print(CUST.LEDGR.foracid)

	CUST.LEDGR.acct=BANCS.OUTPARAM.foracid

	CUST.LEDGR.amt="1200"

	CUST.GCHRG.tranType = "T"
	CUST.GCHRG.tranSubType = "BI"
	CUST.GCHRG.drAcctId = CUST.LEDGR.acct
	CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode

	CUST.GCHRG.chrgAmt = CUST.LEDGR.amt + "|" + BANCS.STDIN.homeCrncyCode
	CUST.GCHRG.eventId = "LEDGERFEE"
	CALL("gchrgcommon.scr")
	IF (CUST.GCHRG.successOrFailure == "S") THEN
	#{
		PRINT("Charge collected")
	#}
	ELSE
	#{
		PRINT("Failure")
	#}
	ENDIF


	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)	

DO
               print("ALL ACCOUNTS CHARGED")
ENDIF

trace off
exitscript
end-->
