#-----------------------------------------------------------------------------------------------

<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DD") == 0) THEN
        #{
                CREATECLASS("CUST","DD",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("IssueUserID"))== 1) ) THEN
	#{
		CUST.DD.IssueUserID= BANCS.INPUT.IssueUserID
		PRINT(CUST.DD.IssueUserID)
	#}
	ELSE
	#{
		CUST.DD.IssueUserID=""
		PRINT(CUST.DD.IssueUserID)
	#}
	ENDIF


	IF( (FIELDEXISTS(("BANCS").("INPUT").("tranType"))== 1) ) THEN
