	IF( (FIELDEXISTS(("BANCS").("INPUT").("payee"))== 1) ) THEN
	#{
		CUST.DD.payee= BANCS.INPUT.payee
		PRINT(CUST.DD.payee)
	#}
	ELSE
	#{
		CUST.DD.payee=""
		PRINT(CUST.DD.payee)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("printIndicator"))== 1) ) THEN
	#{
		CUST.DD.printIndicator= BANCS.INPUT.printIndicator
		PRINT(CUST.DD.printIndicator)
	#}
	ELSE
	#{
		CUST.DD.printIndicator=""
		PRINT(CUST.DD.printIndicator)
	#}
	ENDIF

	################################ Variable Inititalization#######################################################
	CUST.DD.branchCode= BANCS.STDIN.myBrCode
	print(CUST.DD.branchCode)
	CUST.DD.bankCode= BANCS.STDIN.myBankCode
	print(CUST.DD.bankCode)

	IF(CUST.DD.PurchaserAcc !="")THEN
	#{
		sv_h = urhk_getAcctDetailsInRepository(CUST.DD.PurchaserAcc)
		IF(sv_h==0)THEN
		#{
			CUST.DD.pcrncyCode=trim(BANCS.OUTPARAM.acctCrncyCode)
			print(CUST.DD.pcrncyCode)
		#}
		ELSE
		#{
			CUST.DD.errMsg="Failed to fetch purchasers account currency"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
			GOTO ENDSCRIPT	
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.DD.errMsg="PurchaserAcc is null"
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT	
	#}
	ENDIF
		IF(CUST.DD.IssueUserID !="")THEN
		#{
			sv_s = "usersolid|select SOL_ID from tbaadm.upr  "
			sv_s = sv_s + "where HOME_BANK_ID=?SVAR and user_id=?SVAR "
	
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.IssueUserID
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_r =  urhk_dbSelectWithBind(sv_s)
			print(sv_r)
			IF (sv_r ==0) THEN
			#{
				CUST.DD.usersolid= BANCS.OUTPARAM.usersolid
				print (CUST.DD.usersolid)
				#---------------------------------------------------------------------------------------------------------------
				#Fetch demand draft account
				#---------------------------------------------------------------------------------------------------------------
				IF(CUST.DD.DDacctCrncy !="")THEN
				#{
					sv_s="DemandDraftAcc , solid|"
					sv_s=sv_s + "Select foracid,sol_id From TBAADM.GAM  Where BANK_ID=?SVAR AND acct_cls_flg ='N' And entity_cre_flg='Y'"
					sv_s=sv_s + " And del_flg = 'N'  AND sol_id =?SVAR   AND schm_type='DDA'"
					sv_s=sv_s + " AND ROWNUM < 801 AND acct_crncy_code=?SVAR AND schm_code='BNKCH' "
					print(sv_s)
	
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DD.usersolid+ "|" + CUST.DD.DDacctCrncy
					print(BANCS.INPARAM.BINDVARS)

					sv_v = urhk_dbSelectWithBind(sv_s)
     	  				PRINT(sv_v)
					IF(sv_v == 0) THEN
       					#{
	     					CUST.DD.DDacct= BANCS.OUTPARAM.DemandDraftAcc 
    	     					print(CUST.DD.DDacct)	

						sv_h = urhk_getAcctDetailsInRepository(CUST.DD.DDacct)
						IF(sv_h==0)THEN
						#{
							CUST.DD.ddAcctCrncyCode = trim(BANCS.OUTPARAM.acctCrncyCode)
							print(CUST.DD.ddAcctCrncyCode)
						#}
						ELSE
						#{
   							CUST.DD.errMsg="Failed to Fetch Demand account currency"
							sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
							sv_t = "Msg| " +CUST.DD.errMsg
							sv_u = urhk_SetOrbOut(sv_t)
   							GOTO ENDSCRIPT
						#}
						ENDIF

						IF(CUST.DD.DemandDraftAmt !="")THEN
						#{
							CUST.DD.DDAMT = BANCS.INPUT.DemandDraftAmt
							CUST.DD.DDAMT= FORMAT$(CDOUBLE(CUST.DD.DDAMT),"%.2f")
							print(CUST.DD.DDAMT)
						#}
						ELSE
						#{
   							CUST.DD.errMsg="DemandDraftAmt is null"
							sv_t = "Msg| " +CUST.DD.errMsg
							sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
							sv_u = urhk_SetOrbOut(sv_t)
   							GOTO ENDSCRIPT
						#}
						ENDIF	
					#}
					ELSE
					#{
   						CUST.DD.errMsg="Failed to Fetch Demand Draft account"
						sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
						sv_t = "Msg| " +CUST.DD.errMsg
						sv_u = urhk_SetOrbOut(sv_t)
   						GOTO ENDSCRIPT
					#}
					ENDIF
				#}
				ELSE
				#{
   					CUST.DD.errMsg="DDacctCrncy is null"
					sv_t = "Msg| " +CUST.DD.errMsg
					sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO ENDSCRIPT
				#}
				ENDIF

			#}
			ELSE
			#{
   				CUST.DD.errMsg="Invalid UserID passed"
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
   			CUST.DD.errMsg="IssueUserID is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}	
		ENDIF

		IF(CUST.DD.tranType =="")THEN
		#{
   			CUST.DD.errMsg="tranType is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.tranSubType=="")THEN
		#{
   			CUST.DD.errMsg="tranSubType is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.payee=="")THEN
		#{
   			CUST.DD.errMsg="payee is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.printIndicator=="")THEN
		#{
   			CUST.DD.errMsg="printIndicator is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		#----------------------------------------------------------------------------------
		#change context sol id
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.FlagType="A"
		BANCS.INPARAM.AcctId=CUST.DD.DDacct
		sv_u = urhk_ContextSOLUpdate("")
		IF(sv_u != 0) THEN	
		#{
			CUST.DD.errMsg="Failed to switch sol"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
			GOTO ENDSCRIPT
		#}
		ENDIF

		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.valueDate|" + BANCS.STDIN.BODDate)

		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranSubType.tranType|" + CUST.DD.tranType)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranSubType.tranSubType|" + CUST.DD.tranSubType)
		sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.purTranType.tranType|" + CUST.DD.tranType)
		sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.purTranType.tranSubType|" + CUST.DD.tranSubType)

		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commTranType.tranType|" + CUST.DD.tranType)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commTranType.tranSubType|" + CUST.DD.tranSubType)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.ddAcct.foracid|" + CUST.DD.DDacct)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.purAcct.foracid|" + CUST.DD.PurchaserAcc)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commAcct.foracid|" + CUST.DD.PurchaserAcc)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.prntOption.code|" + CUST.DD.printIndicator)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.purCrncy.crncyCode|" + CUST.DD.ddAcctCrncyCode)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commCrncy.crncyCode|" + CUST.DD.pcrncyCode)

		sv_u = urhk_ExecSrv("SRV_FetchDataForDDMassIss|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.totDDAmt|" + CUST.DD.DDAMT+"|"+ BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp("ddMassIssHdr.funcCode|A")
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.key.serial_num|1")
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.ddAmt|"+ CUST.DD.DDAMT+"|"+ BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeBrCode.brCode|" + CUST.DD.usersolid)
				#sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeBrCode.brCode|145")

			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeBrCode.bankCode|" + CUST.DD.bankCode)
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.prntSol.solId|" + CUST.DD.usersolid)
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeName|" + CUST.DD.payee)
			sv_u = urhk_SetUrhkOut("ddMassIssLL.<rec_0>.ddIssChrgs.totCommAmt|charge")

			sv_u = urhk_ExecSrv("SRV_ComputeChrgsForDDMassIssue|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				print(BANCS.OUTPARAM.charge)
				CUST.DD.ChargeAmt = BANCS.OUTPARAM.charge 				
				sv_t = "ChargeAmt| " +CUST.DD.ChargeAmt
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Success")
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT
			#}
			ELSE
			#{
				GOTO ERRORCHECK
			#}
			ENDIF
		#}
		ELSE
		#{
			GOTO ERRORCHECK
		#}
		ENDIF

	ERRORCHECK:		

	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>ddadd.log")
				print(sv_u)
				
				#Error response
				sv_t = "Msg | " +sv_e
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT
			#}
			DO
			#}
		ENDIF
	#}
	ENDIF


ENDSCRIPT:

trace off

end-->

