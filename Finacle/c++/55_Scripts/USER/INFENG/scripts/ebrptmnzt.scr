<--start
trace on	
	if(fieldexists(BANCS.INPUT.rptCode))then
		sv_c = "N"
		sv_s = "repDesc"
		sv_s = sv_s + "|"
		sv_s = sv_s + "SELECT report_desc "
		sv_s = sv_s + " FROM custom.c_ebrpt "
		sv_s = sv_s + " WHERE report_code = '"+ BANCS.INPUT.rptCode +"' "
		sv_s = sv_s + " AND report_module = '"+ BANCS.INPUT.rptMod +"' "
		sv_s = sv_s + " AND report_division = '"+ BANCS.INPUT.rptDiv +"' "
		sv_s = sv_s + " AND del_flg = 'N'"
		sv_s = sv_s + " AND BANK_ID = '"+ BANCS.STDIN.contextBankId +"' "
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		if (sv_d == "0") then
			sv_m = BANCS.OUTPARAM.repDesc
			print(sv_m)
		else
			sv_m = "Invalid Report Code"
			sv_c = "Y"
		endif
	else
		sv_m = "Please Enter Report Code"
		sv_c = "Y"
	endif
	if (sv_m != "") then
		print(sv_m)
		sv_z = sv_c + "|" + sv_m
		print(sv_z)
		
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
	endif
trace off
end-->

