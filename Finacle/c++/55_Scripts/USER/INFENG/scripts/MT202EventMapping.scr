                       sv_s = sv_s+ltrim(rtrim(BANCS.INPUT.InterMediaryAddress2))+" " 
                       sv_s = sv_s+ltrim(rtrim(BANCS.INPUT.InterMediaryAddress3))+" " 
                       sv_s = sv_s+ltrim(rtrim(BANCS.INPUT.InterMediaryCntryName))+" " 
    
                       sv_t = mid$(sv_s,0,35) 
                           if(sv_t !="") then 
                            	sv_m = sv_m + ":56d3:E:" +sv_t + "|"
                           endif 
    
                       sv_u = mid$(sv_s,35,35) 
                       if(sv_u !="") then 
                           sv_m = sv_m + ":56d4:E:" +sv_u + "|" 
                       endif 
                       sv_v = mid$(sv_s,70,35) 
                       if(sv_v !="") then 
                       sv_m = sv_m + ":56d5:E:" +sv_v + "|"
                       endif 
                   #} 
                   endif 
               #} 
               endif 
           #} 
           endif 
       #} 
       endif 

#}ends the else of cover 202
endif
#
# If Bank Remmitance, then populate tag 58-Beneficiary institution as Other Party Details
# In case of 202 as cover message popualte payee bank details as 58B- Beneficiary Institution
if(BANCS.INPUT.BeneficiaryInstitutionBIC != "") then
	if(BANCS.INPUT.BeneficiaryInstitutionPartyId != "") then
		sv_g = MID$(BANCS.INPUT.BeneficiaryInstitutionPartyId, 0,1) 
		if(sv_g != "/") then
			sv_m = sv_m + ":58a1:" + "E:/" + BANCS.INPUT.BeneficiaryInstitutionPartyId + "|"
		else
			sv_m = sv_m + ":58a1:" + "E:" + BANCS.INPUT.BeneficiaryInstitutionPartyId + "|"
		endif
	endif
	sv_m = sv_m + ":58a2:" + BANCS.INPUT.BeneficiaryInstitutionBIC + "|"
else 
	if(BANCS.INPUT.BeneficiaryInstitutionPartyId != "") then
		sv_g = MID$(BANCS.INPUT.BeneficiaryInstitutionPartyId, 0,1)
		if(sv_g != "/") then
            sv_m = sv_m + ":58d1:" + "E:/" + BANCS.INPUT.BeneficiaryInstitutionPartyId + "|"
        else
            sv_m = sv_m + ":58d1:" + "E:" + BANCS.INPUT.BeneficiaryInstitutionPartyId + "|"
        endif
	endif
		sv_o = mid$(BANCS.INPUT.BeneficiaryInstitutionName,0,35)
		sv_m = sv_m + ":58d2:" + sv_o + "|"
	sv_p = strlen(BANCS.INPUT.BeneficiaryInstitutionAddress1)	
	sv_q = strlen(BANCS.INPUT.BeneficiaryInstitutionAddress2)
	sv_r = strlen(BANCS.INPUT.BeneficiaryInstitutionAddress3)
	sv_w = strlen(BANCS.INPUT.BeneficiaryInstitutionCountryName)
	sv_x = sv_r + sv_w

	if( (sv_p <= 35) AND (sv_q <= 35) AND (sv_x <= 35) ) then
			sv_m = sv_m + ":58d3:" + BANCS.INPUT.BeneficiaryInstitutionAddress1 + "|"
			sv_m = sv_m + ":58d4:" + BANCS.INPUT.BeneficiaryInstitutionAddress2 + "|"
			sv_m = sv_m + ":58d5:" + BANCS.INPUT.BeneficiaryInstitutionAddress3 +BANCS.INPUT.BeneficiaryInstitutionCountryName +  "|"
	else
			sv_s = ""
			sv_s = sv_s+ltrim(rtrim(BANCS.INPUT.BeneficiaryInstitutionAddress1))
			sv_t = mid$(sv_s,0,35)
			sv_m = sv_m + ":58d3:" + sv_t + "|"	
			sv_s = ""
			sv_s = sv_s+ltrim(rtrim(BANCS.INPUT.BeneficiaryInstitutionAddress2))
			sv_u = mid$(sv_s,0,35)
			sv_m = sv_m + ":58d4:" + sv_u + "|"	
			sv_s = ""
			sv_s = sv_s+ltrim(rtrim(BANCS.INPUT.BeneficiaryInstitutionAddress3))
			sv_s = sv_s+ltrim(rtrim(BANCS.INPUT.BeneficiaryInstitutionCountryName))
			sv_v = mid$(sv_s,0,35)
			sv_m = sv_m + ":58d5:" + sv_v + "|"	
	endif
endif
