#
#print (BANCS.INPUT.PresentingBanksReference)
#   In MT202 when no value is present for Tag20 then by default we will first populate 
#   Tag20 with ZZZZZ-99999 (BANCS.INPUT.TransactionReferenceNo). This will be populated
#   in the message screen. Logic is written in code, that when Tag20 field is found to have value 
#   ZZZZZ-99999 then Tag 20 will be populated with Tag21 field value

#	if(BANCS.INPUT.PresentingBanksReference == "") then
#		BANCS.INPUT.PresentingBanksReference = BANCS.INPUT.TransactionReferenceNo
#	endif

    if(BANCS.INPUT.PresentingBanksReference != "") then
        sv_m = sv_m + ":211:E:" + BANCS.INPUT.PresentingBanksReference + "|"
	else
	    sv_m = sv_m + ":211:E:" + "NONREF" + "|"
	endif	
#
	if(BANCS.INPUT.NostroValueDate !="") then
		sv_m = sv_m + ":32a1:E:"  +BANCS.INPUT.NostroValueDate + "|"
	else
		sv_m = sv_m + ":32a1:E:" + BANCS.INPUT.ValueDate + "|"
	endif
