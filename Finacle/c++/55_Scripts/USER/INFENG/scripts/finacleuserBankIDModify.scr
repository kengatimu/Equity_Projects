<--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
		CUST.INTERFACE.GOTO = ""
		CUST.INTERFACE.VAL_STATUS = "S"
		CUST.INTERFACE.c_mbpcount  = "0"
	####################################################################
	# Inputs from Frontend
	####################################################################
		
		IF(FIELDEXISTS(("BANCS").("INPUT").("UserId")) == 1) THEN
		#{
			CUST.INTERFACE.userId = ("BANCS").("INPUT").("UserId")
			print("userId is")
			print(CUST.INTERFACE.userId)
		#}
		ELSE
		#{
			CUST.INTERFACE.userId = " "
			PRINT("Please enter UserId ")
			CUST.INTERFACE.VAL_STATUS = "F"	
			sv_b = "UserAdd_Val.MandatoryInput_UserId|Please enter UserId"
			sv_u = urhk_SetOrbOut(sv_b)
		#}
		ENDIF
		
		IF(FIELDEXISTS(("BANCS").("INPUT").("BankID")) == 1) THEN
		#{
			CUST.INTERFACE.BankID = ("BANCS").("INPUT").("BankID")
			print("Bank ID is")
			print(CUST.INTERFACE.BankID)
		#}
		ELSE
		#{
			CUST.INTERFACE.BankID = " "
			PRINT("Please enter BankID ")
			CUST.INTERFACE.VAL_STATUS = "F"	
			sv_b = "UserAdd_Val.MandatoryInput_BankID|Please enter BankID"
			sv_u = urhk_SetOrbOut(sv_b)
		#}
		ENDIF

		IF(CUST.INTERFACE.VAL_STATUS == "F")THEN
		#{
		
			sv_a = "UserAdd_Val.Status|Missing Mandatory Input"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.ErrorMessage|Please enter the above Mandatory Inputs"
			sv_u = urhk_SetOrbOut(sv_b)
			exitscript
		#}
		ENDIF
		
		sv_s = "homeBankId,usrWrkClass1,roleId1,solId1,multbankproID1,empID|SELECT HOME_BANK_ID,USER_WORK_CLASS"
		sv_s = sv_s + ",ROLE_ID,SOL_ID,MULTI_BANK_USER_PROFILE_ID,USER_EMP_ID FROM TBAADM.UPR WHERE USER_ID=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId 
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.homeBankId  	=  BANCS.OUTPARAM.homeBankId
			CUST.INTERFACE.usrWrkClass1 	=  BANCS.OUTPARAM.usrWrkClass1
			CUST.INTERFACE.roleId1  	=  BANCS.OUTPARAM.roleId1
			CUST.INTERFACE.SolID1  		=  BANCS.OUTPARAM.solId1
			CUST.INTERFACE.multbankproID1	=  BANCS.OUTPARAM.multbankproID1
			CUST.INTERFACE.EmployeeID	=  BANCS.OUTPARAM.empID
		
			PRINT(CUST.INTERFACE.homeBankId)
			PRINT(CUST.INTERFACE.usrWrkClass1)
			PRINT(CUST.INTERFACE.roleId1)
			PRINT(CUST.INTERFACE.SolID1)
			PRINT(CUST.INTERFACE.multbankproID1)
			PRINT(CUST.INTERFACE.EmployeeID)
		#}
		ELSE
		#{
			
			CUST.INTERFACE.VAL_STATUS = "F"	
			sv_b = "UserAdd_Val.MandatoryInput_userId|Invalid User ID"
			sv_u = urhk_SetOrbOut(sv_b)
		#}
		ENDIF
		
		IF(CUST.INTERFACE.VAL_STATUS == "F")THEN
		#{
		
			sv_a = "UserAdd_Val.Status|Invalid Input"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.ErrorMessage|Please enter the valid Inputs"
			sv_u = urhk_SetOrbOut(sv_b)
			exitscript
		#}
		ENDIF
		
		CUST.INTERFACE.bank_id = CUST.INTERFACE.homeBankId
		
	####################################################################
	# VARIABLE INITAILIZATION
	####################################################################
	
		CUST.INTERFACE.EFM_USER_FLG  = ""
		CUST.INTERFACE.EFM_REMARKS  = ""
		CUST.INTERFACE.CORE_USER_FLG  = ""
		CUST.INTERFACE.CORE_REMARKS  = ""
		CUST.INTERFACE.SSO_USER_FLG  = ""
		CUST.INTERFACE.SSO_REMARKS  = ""
		CUST.INTERFACE.CRM_USER_FLG  = ""
		CUST.INTERFACE.CRM_REMARKS  = ""
		CUST.INTERFACE.SVS_USER_FLG  = ""
		CUST.INTERFACE.SVS_REMARKS  = ""
		CUST.INTERFACE.RI_USER_FLG  = ""
		CUST.INTERFACE.RI_REMARKS  = ""		
		CUST.INTERFACE.RCRE_USERID  = ""
		CUST.INTERFACE.RCRE_TIME  = ""
		CUST.INTERFACE.LCHG_USERID  = ""
		CUST.INTERFACE.LCHG_TIME  = ""
		CUST.INTERFACE.API_NAME  = "FinacleUserBankIDMod"		
		
		IF(TRIM(CUST.INTERFACE.multbankproID1) != "")THEN
		#{
			sv_s = "c_mbpcount|select count(1) from tbaadm.mpb where multi_bank_user_profile_id =?SVAR and del_flg ='N' and user_work_class =?SVAR"
			sv_s = sv_s + "and home_bank_id=?SVAR and target_bank_id=?SVAR and role_id=?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.multbankproID1 + "|" + CUST.INTERFACE.usrWrkClass1 + "|" + CUST.INTERFACE.homeBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|" + CUST.INTERFACE.BankID + "|" + CUST.INTERFACE.roleId1
			PRINT(sv_s)
		
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
			#{
				CUST.INTERFACE.c_mbpcount  =  BANCS.OUTPARAM.c_mbpcount
			#}
			ENDIF
		#}
		ENDIF
		
		IF(CUST.INTERFACE.c_mbpcount  != "0")THEN
		#{
			CALL("UserBankIDMod002.scr")
		#}
		ELSE
		#{
			CALL("UserBankIDMod001.scr")
		#}
		ENDIF
		
	ENDOFSCRIPT:
	
	CUST.INTERFACE.c_user = "0"
        sv_a = "c_user|SELECT COUNT(*) FROM "
        sv_a = sv_a + " CUSTOM.C_FINACLEUSER_STATUS_TBL WHERE USER_ID = ?SVAR AND API_NAME = ?SVAR"

        BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.API_NAME

        sv_d = urhk_dbSelectWithBind(sv_a)

        IF(sv_d == 0) THEN
        #{
	        CUST.INTERFACE.c_user  = BANCS.OUTPARAM.c_user
                PRINT(CUST.INTERFACE.c_user)
        #}
        ELSE
        #{
                sv_a = "UserAdd.Status|ERROR"
                sv_u = urhk_SetOrbOut(sv_a)
                sv_b = "UserAdd.ErrorMessage|Unable to fetch data"
                sv_u = urhk_SetOrbOut(sv_b)
                exitscript


        #}
        ENDIF

	IF(CUST.INTERFACE.c_user == "0")THEN
	#{
		sv_a = "INSERT INTO CUSTOM.C_FINACLEUSER_STATUS_TBL(USER_ID,EMP_ID,BANK_ID,API_NAME,EFM_USER_FLG,EFM_REMARKS,CORE_USER_FLG,CORE_REMARKS,SSO_USER_FLG,"
		sv_a = sv_a +"SSO_REMARKS,CRM_USER_FLG,CRM_REMARKS,SVS_USER_FLG,SVS_REMARKS,RI_USER_FLG,RI_REMARKS,LCHG_USER_ID,LCHG_TIME,RCRE_USER_ID,RCRE_TIME)"
		sv_a = sv_a + "VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,sysdate,?SVAR,sysdate)"

		CUST.INTERFACE.RCRE_USER_ID = BANCS.STDIN.userId
		CUST.INTERFACE.LCHG_USERID = BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.bank_id + "|" + CUST.INTERFACE.API_NAME + "|" +  CUST.INTERFACE.EFM_USER_FLG
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.EFM_REMARKS  + "|" + CUST.INTERFACE.CORE_USER_FLG  + "|" + CUST.INTERFACE.CORE_REMARKS 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.SSO_USER_FLG + "|" + CUST.INTERFACE.SSO_REMARKS  + "|" +	CUST.INTERFACE.CRM_USER_FLG  
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.CRM_REMARKS  + "|" + CUST.INTERFACE.SVS_USER_FLG  + "|" + CUST.INTERFACE.SVS_REMARKS
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	CUST.INTERFACE.RI_USER_FLG + "|" + CUST.INTERFACE.RI_REMARKS + "|" + CUST.INTERFACE.LCHG_USERID 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	 CUST.INTERFACE.RCRE_USER_ID 
		PRINT(BANCS.INPARAM.BINDVARS)
		PRINT(CUST.INTERFACE.RI_REMARKS)
		sv_d = urhk_dbSqlWithBind(sv_a)
		IF(sv_d == 0) THEN
		#{
			print("inserted")
		#}
		ELSE
		#{
			sv_a = "STATUS_TABLE_UPDATE.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "STATUS_TABLE_UPDATE.ErrorMessage| FAILED TO UPDATE STATUS TABLE"
			sv_u = urhk_SetOrbOut(sv_b)
			EXITSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.INTERFACE.LCHG_USERID = BANCS.STDIN.userId
		sv_a = "UPDATE CUSTOM.C_FINACLEUSER_STATUS_TBL SET EFM_USER_FLG = ?SVAR,EFM_REMARKS = ?SVAR,CORE_USER_FLG = ?SVAR,CORE_REMARKS = ?SVAR,SSO_USER_FLG = ?SVAR,"
		sv_a = sv_a +"SSO_REMARKS = ?SVAR,CRM_USER_FLG = ?SVAR,CRM_REMARKS = ?SVAR,SVS_USER_FLG = ?SVAR,SVS_REMARKS = ?SVAR,RI_USER_FLG = ?SVAR,RI_REMARKS = ?SVAR,"
		sv_a = sv_a + "LCHG_USER_ID = ?SVAR,LCHG_TIME = sysdate WHERE USER_ID = ?SVAR AND EMP_ID = ?SVAR AND API_NAME = ?SVAR"
		
		BANCS.INPARAM.BINDVARS =  CUST.INTERFACE.EFM_USER_FLG
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.EFM_REMARKS  + "|" + CUST.INTERFACE.CORE_USER_FLG  + "|" + CUST.INTERFACE.CORE_REMARKS 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.SSO_USER_FLG + "|" + CUST.INTERFACE.SSO_REMARKS  + "|" +	CUST.INTERFACE.CRM_USER_FLG  
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.CRM_REMARKS  + "|" + CUST.INTERFACE.SVS_USER_FLG  + "|" + CUST.INTERFACE.SVS_REMARKS
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	CUST.INTERFACE.RI_USER_FLG + "|" + CUST.INTERFACE.RI_REMARKS + "|" + CUST.INTERFACE.LCHG_USERID 
		
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.API_NAME
	
		PRINT(CUST.INTERFACE.RI_REMARKS)
		print(sv_a)
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSqlWithBind(sv_a)
		IF(sv_d == 0) THEN
		#{
			print("updated")
		#}
		ELSE
		#{
			sv_a = "STATUS_TABLE_UPDATE.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "STATUS_TABLE_UPDATE.ErrorMessage| FAILED TO UPDATE STATUS TABLE"
			sv_u = urhk_SetOrbOut(sv_b)
			EXITSCRIPT
		#}
		ENDIF
	
	#}
	ENDIF
	
	#-------------------------------------------------------------------------
	# INPUT VALIDATION
	#-------------------------------------------------------------------------
	
	#TRACE OFF
END-->
