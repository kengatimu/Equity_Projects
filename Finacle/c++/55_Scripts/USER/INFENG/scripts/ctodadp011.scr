#----------------------------------------------------------------------------------------------------------
# Filename              :       ctodadp011.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to execute SRV for TOD availment(menu HACTODM).
# Input                 :       Account Id, netTodAmount, Grant Date,expiry date, permiter userId,
# Output                :       None
# Called Script         :       None
# Calling Script        :       ctodadp007.scr
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           25-04-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="d03fbd8f4bb31ae8b326fa6326cb41ca4a7244c2c508e4eb00b587002a8935e2"
	TRACE ON
	CUST.CTODA.foracid = CUST.CTODA.accNum
	print(CUST.CTODA.foracid)
	CUST.CTODA.srvGrantDate = CUST.CTODA.grantDate + " 00:00:00"
	print(CUST.CTODA.srvGrantDate)
	#CUST.CTODA.todAmtToBeGrntd = CUST.CTODA.netTodAmount + "|" + CUST.CTODA.accCCY
	CUST.CTODA.todAmtToBeGrntd = CUST.CTODA.availAmt + "|" + CUST.CTODA.accCCY
	print(CUST.CTODA.todAmtToBeGrntd)
	CUST.CTODA.todLevIntFlg = "N"
	#--------------------------------------------------------------------------------
	# setting input parameter for execution of service
	#--------------------------------------------------------------------------------
	sv_j = "sumInfo.acct.foracid|" + CUST.CTODA.foracid
	sv_u = urhk_SetUrhkInp(sv_j)
	sv_j = "acctTODLLRec.todBasicDtl.grantDate|" + CUST.CTODA.srvGrantDate
	sv_u = urhk_SetUrhkInp(sv_j)
	sv_j = "acctTODLLRec.todBasicDtl.todAmtToBeGrntd|" + CUST.CTODA.todAmtToBeGrntd
	sv_u = urhk_SetUrhkInp(sv_j)
	sv_j = "acctTODLLRec.todBasicDtl.todLevIntFlg|" + CUST.CTODA.todLevIntFlg
	sv_u = urhk_SetUrhkInp(sv_j)
	#------------------------------------------------------------------------------
	# using userhook for execution of service
	#------------------------------------------------------------------------------
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltTODForAdd|same_user_verify = Y|retain_all_output = Y|call_mode=N")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		# calling script to trap SRV execution error
		CUST.INTERFACE.srvErrFlg ="Y"
		call("Common_Interface_ErrorExit.scr")
		print(CUST.INTERFACE.errorDesc)
		CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
		CUST.CTODA.fieldName = "abc"
		CUST.CTODA.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_u = urhk_CopyOutToIn("")
	CUST.CTODA.srvExpiryDate = CUST.CTODA.expiryDate + " 00:00:00"
	print(CUST.CTODA.srvExpiryDate)
	# acctTODLLRec.todBasicDtl.permittedBy.userId
	sv_j = "acctTODLLRec.todBasicDtl.permittedBy.userId|" + BANCS.STDIN.userId
	sv_u = urhk_SetUrhkInp(sv_j)
	print(sv_u)
	# acctTODLLRec.todBasicDtl.expiryDate
	sv_j = "acctTODLLRec.todBasicDtl.expiryDate|" + CUST.CTODA.srvExpiryDate
	sv_u = urhk_SetUrhkInp(sv_j)
	print(sv_u)
	# acctTODLLRec.todBasicDtl.penalDate
	sv_j = "acctTODLLRec.todBasicDtl.penalDate|" + CUST.CTODA.srvExpiryDate
	sv_u = urhk_SetUrhkInp(sv_j)
	print(sv_u)
	# acctTODLLRec.todBasicDtl.rmks
	sv_j = "acctTODLLRec.todBasicDtl.rmks|" + CUST.CTODA.contractId
	sv_u = urhk_SetUrhkInp(sv_j)
	print(sv_u)
	
	sv_u = urhk_ExecSrvNoCommit("SRV_AddAcctTOD|same_user_verify = Y|call_mode=N")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		# calling script to trap SRV execution error
		CUST.INTERFACE.srvErrFlg ="Y"
		call("Common_Interface_ErrorExit.scr")
		print(CUST.INTERFACE.errorDesc)
		CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
		CUST.CTODA.fieldName = "abc"
		CUST.CTODA.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------------
	# setting input parameter for execution of verify fetch service
	#--------------------------------------------------------------------------------
	sv_j = "criteria.acct.foracid|" + CUST.CTODA.foracid
	sv_u = urhk_SetUrhkInp(sv_j)
	
	#------------------------------------------------------------------------------
	# using userhook for execution of service
	#------------------------------------------------------------------------------
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchAcctTODForVerify|same_user_verify = Y|retain_all_output = Y|call_mode=N")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		# calling script to trap SRV execution error
		CUST.INTERFACE.srvErrFlg ="Y"
		call("Common_Interface_ErrorExit.scr")
		print(CUST.INTERFACE.errorDesc)
		CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
		CUST.CTODA.fieldName = "abc"
		CUST.CTODA.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_CopyOutToIn("")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_VerifyAcctTOD|same_user_verify = Y|call_mode=N")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		# calling script to trap SRV execution error
		CUST.INTERFACE.srvErrFlg ="Y"
		call("Common_Interface_ErrorExit.scr")
		print(CUST.INTERFACE.errorDesc)
		CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
		CUST.CTODA.fieldName = "abc"
		CUST.CTODA.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
