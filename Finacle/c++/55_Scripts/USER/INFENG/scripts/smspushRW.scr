	CUST.MESSAGING.msg=CUST.MESSAGING.header+"body^=^SendSms^|^opCode^=^1^|^Url^=^"+CUST.MESSAGING.URL+"^|^RefNumber^=^"+CUST.MESSAGING.REFNUMBER+"^|^Language^=^"+CUST.MESSAGING.LANGUAGE+"^|^InstitutionCode^=^"+CUST.MESSAGING.INSTITUTIONCODE+"^|^MobileNumber^=^"+CUST.MESSAGING.MOBILENUMBER+"^|^MessageArriveDate^=^"+CUST.MESSAGING.MESSAGEARRIVEDATE+"^|^MessagePriority^=^"+CUST.MESSAGING.MESSAGEPRIORITY+"^|^MessageStatus^=^"+CUST.MESSAGING.MESSAGESTATUS+"^|^MessageValidityPeriod^=^"+CUST.MESSAGING.MESSAGEVALIDITYPERIOD+"^|^Department^=^"+CUST.MESSAGING.DEPARTMENT+"^|^MessageText^=^"+CUST.MESSAGING.MESSAGETEXT+"^|^RetryCount^=^"+CUST.MESSAGING.RETRYCOUNT+"^|^BankId^=^"+CUST.MESSAGING.BANKID+"^|^MessageBody^=^"+CUST.MESSAGING.messpayload+"^|^"
	PRINT(CUST.MESSAGING.msg)
	
	#Setting the Service Name to FIJCA. This should not be changed.
