	CUST.MESSAGING.MESSAGEARRIVEDATE=BANCS.STDIN.sysDate
	print(CUST.MESSAGING.MESSAGEARRIVEDATE)

	CUST.MESSAGING.MESSAGEPRIORITY="4"
	print(CUST.MESSAGING.MESSAGEPRIORITY)

	CUST.MESSAGING.MESSAGESTATUS="0"
	print(CUST.MESSAGING.MESSAGESTATUS)

	CUST.MESSAGING.MESSAGEVALIDITYPERIOD="86400000"
	print(CUST.MESSAGING.MESSAGEVALIDITYPERIOD)

	CUST.MESSAGING.DEPARTMENT="smsdirectauto"
	print(CUST.MESSAGING.DEPARTMENT)

	print(CUST.MESSAGING.MESSAGETEXT)

	CUST.MESSAGING.RETRYCOUNT="0"
