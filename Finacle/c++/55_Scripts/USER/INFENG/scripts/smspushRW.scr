	############################Setting the input Parameter #########################
	#Getting the time-stamp from sysDate
	print(BANCS.STDIN.sysDate)	
	BANCS.INPARAM.Day = LEFT$(BANCS.STDIN.sysDate,2)
	print(BANCS.INPARAM.Day)
	BANCS.INPARAM.Month = MID$(BANCS.STDIN.sysDate,3,2)
	print(BANCS.INPARAM.Month)
	BANCS.INPARAM.Year = MID$(BANCS.STDIN.sysDate,8,2)
	print(BANCS.INPARAM.Year)
	BANCS.INPARAM.Hour = MID$(BANCS.STDIN.sysDate,11,2)
	print(BANCS.INPARAM.Hour)
	BANCS.INPARAM.Minute = MID$(BANCS.STDIN.sysDate,14,2)
	print(BANCS.INPARAM.Minute)
	BANCS.INPARAM.Second = MID$(BANCS.STDIN.sysDate,17,2)
	print(BANCS.INPARAM.Second)
	
	BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second
	
	
	BANCS.INPARAM.REQUESTUUID           = "reqUUID"+"SendSms"+BANCS.INPARAM.SYSDATE
	BANCS.INPARAM.BANKID                = "50"
	BANCS.INPARAM.SERVICEREQUESTID      = "SmsSender1"
	BANCS.INPARAM.MESSAGEDATETIME       = "BANCS.STDIN.sysDate"
	BANCS.INPARAM.CHANNELID             = "SSC"
	BANCS.INPARAM.SERVICEREQUESTVERSION = "10.2"
	BANCS.INPARAM.TIMEZONE              = "GMT+04:00"
	
	CUST.MESSAGING.header=""	
	CUST.MESSAGING.header="MSG_TYPE=NVPSTR,MSG_SUB_TYPE=FINVP###reqhdr.requestuuid^=^"+BANCS.INPARAM.REQUESTUUID+"^|^reqhdr.servicerequestid^=^"+BANCS.INPARAM.SERVICEREQUESTID+"^|^reqhdr.servicerequestversion^=^"+BANCS.INPARAM.SERVICEREQUESTVERSION
	print(CUST.MESSAGING.header)	
	print(BANCS.STDIN.sysDate)	
	CUST.MESSAGING.header=CUST.MESSAGING.header+"^|^reqhdr.origchannelid^=^"+BANCS.INPARAM.CHANNELID+"^|^reqhdr.languageid^=^en_US^|^reqhdr.messagedatetime^=^"+BANCS.STDIN.sysDate+"^|^reqhdr.bankid^=^"+BANCS.INPARAM.BANKID+"^|^reqhdr.timezone^=^"+BANCS.INPARAM.TIMEZONE+"^|^"
	
	CUST.MESSAGING.messpayload="<?xml version='1.0' encoding='UTF-8'?><request><msg><header>Equity Bank</header><type>SMS</type><text>"+CUST.MESSAGING.MESSAGETEXT+"</text><recipient>"+CUST.MESSAGING.MOBILENUMBER+"</recipient></msg></request>"
	
