<--START
TRACE ON

	#--------------------------------------------------------------------------
	# Initialise Repository
	#--------------------------------------------------------------------------
	IF (REPEXISTS("CUST")==0)THEN
		CREATEREP("CUST")
	ENDIF
	IF(CLASSEXISTS("CUST","DATA")==0)then
		CREATECLASS("CUST","DATA",5)
	ENDIF

	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif

	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	#EBSRV.GLBDATA.tranType="T"
	PRINT(EBSRV.GLBDATA.tranType)

	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	
	
	sv_j = 0
	sv_j = FORMAT$(sv_j,"%d")
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
	CUST.DATA.trgforacid= BANCS.OUTPARAM.srvValue
	#CUST.DATA.trgforacid="0480191246594"
	print(CUST.DATA.trgforacid)

	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.partTranType.code")
	CUST.DATA.partTranType= BANCS.OUTPARAM.srvValue
	#CUST.DATA.partTranType ="D"
	print(CUST.DATA.partTranType)

	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranAmt")
	CUST.DATA.Amount= BANCS.OUTPARAM.srvValue
	sv_p = GETPOSITION(CUST.DATA.Amount,"|")
	PRINT(sv_p)
	sv_a = MID$(CUST.DATA.Amount,0,sv_p-1)
	print(sv_a)
	CUST.DATA.Amount = sv_a
	PRINT(CUST.DATA.Amount)

	##############################################
	#Insert Debit Alerts done with overdraft #####
	##############################################
				
		sv_s = "trgacid,AccontName,PhoneNumber,shortname,cifid,trgforacid|"
		sv_s = sv_s + " select acid,acct_name,phone_num,acct_short_name,cif_id,foracid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR and del_flg='N' and acct_cls_flg='N' and schm_type in('SBA','CAA')"
		sv_s = sv_s + " and cif_id in(select cif_id from tbaadm.gam where schm_code in ('ODASM','OD548') and clr_bal_amt <=0) "
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.trgforacid
		print(BANCS.INPARAM.BINDVARS)
	
		sv_e = urhk_dbSelectWithBind(sv_s)
		print(sv_e)
	
		if(sv_e == 0) THEN
		CUST.DATA.trgacid= BANCS.OUTPARAM.trgacid
		PRINT(CUST.DATA.trgacid)
		CUST.DATA.trgforacid= BANCS.OUTPARAM.trgforacid
		PRINT(CUST.DATA.trgforacid)
		CUST.DATA.shortname= BANCS.OUTPARAM.shortname
		PRINT(CUST.DATA.shortname)
		CUST.DATA.AccontName= BANCS.OUTPARAM.AccontName
		PRINT(CUST.DATA.AccontName)
		CUST.DATA.cifid= BANCS.OUTPARAM.cifid
		PRINT(CUST.DATA.cifid)
		CUST.DATA.PhoneNumber= BANCS.OUTPARAM.PhoneNumber
		PRINT(CUST.DATA.PhoneNumber)
		CUST.DATA.Amount =CUST.DATA.Amount
		print(CUST.DATA.Amount)
		else
GOTO ENDOFSCRIPT
		endif
		

		CUST.DATA.MESSAGE1 = "Dear"
		PRINT(CUST.DATA.MESSAGE1)
		CUST.DATA.MESSAGE2 = "Your Overdraft limit of KES:"
		PRINT(CUST.DATA.MESSAGE2)
		CUST.DATA.MESSAGE3 = "has been ultilized to complete transaction."
		PRINT(CUST.DATA.MESSAGE3)

		CUST.DATA.MESSAGE = CUST.DATA.MESSAGE1 +" "+ CUST.DATA.shortname +","+ CUST.DATA.MESSAGE2 +" "+ CUST.DATA.Amount +" "+ CUST.DATA.MESSAGE3
		PRINT(CUST.DATA.MESSAGE)

		
		IF (CUST.DATA.partTranType == "D") THEN

		#{

		sv_i = "INSERT INTO CUSTOM.ALERT_SME (ACID, FORACID, ACCT_NAME, PHONE_NUM,BANK_ID,RCRE_TIME,MESSAGE_TYPE,MESSAGE,MESSAGE_STATUS,AMOUNT)"
		sv_i = sv_i + " VALUES (?SVAR, ?SVAR, ?SVAR, ?SVAR,?SVAR,SYSDATE,'T',?SVAR,'0',?SVAR)"
		print (sv_i)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.trgacid +"|"+ CUST.DATA.trgforacid +"|"+ CUST.DATA.AccontName +"|"+ CUST.DATA.PhoneNumber +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.MESSAGE +"|"+ CUST.DATA.Amount
		Print(BANCS.INPARAM.BINDVARS)

		sv_i = urhk_dbSqlWithBind(sv_i)
		print (sv_i)
		
		#}
		ENDIF
ENDOFSCRIPT:	
	
EXITSCRIPT
END-->

