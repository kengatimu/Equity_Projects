IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
ENDIF


        sv_s=" TDATE,YDATE,ODATE|select to_char(sysdate,'DD-mon-YYYY') , to_char(sysdate-1,'DD-mon-YYYY') ,  to_char(sysdate,'YYYYMMDD')from dual  "
        print(sv_s)
        sv_d = urhk_dbSelectWithBind(sv_s)
        print(sv_d)
                IF (sv_d == 0) THEN
                        #{
                        CUST.DATA.TDATE=BANCS.OUTPARAM.TDATE
                        PRINT(CUST.DATA.TDATE)
                        CUST.DATA.YDATE=BANCS.OUTPARAM.YDATE
                        PRINT(CUST.DATA.YDATE)
                        CUST.DATA.ODATE=BANCS.OUTPARAM.ODATE
                        PRINT(CUST.DATA.ODATE)


                        CUST.DATA.KEDATE = CUST.DATA.ODATE + "_54"
                        CUST.DATA.CDDATE = CUST.DATA.ODATE + "_43"
                        CUST.DATA.TZDATE = CUST.DATA.ODATE + "_55"
                        CUST.DATA.UGDATE = CUST.DATA.ODATE + "_56"
                        CUST.DATA.RWDATE = CUST.DATA.ODATE + "_50"
                        CUST.DATA.FNDATE = CUST.DATA.ODATE + "_99"
                        CUST.DATA.SUDATE = CUST.DATA.ODATE + "_11"

                        #}
                ELSE
                        #{
                        GOTO ENDOFSCRIPT
                        #{
                ENDIF
        sv_u = urhk_getFileLocation("COM|Dchange.com")
        sv_l = BANCS.OUTPARAM.fileLocation
        sv_t = sv_l + "Dchange.com" + " " + CUST.DATA.TDATE + " " + CUST.DATA.YDATE + " " + CUST.DATA.KEDATE + " " + CUST.DATA.CDDATE + " " + CUST.DATA.TZDATE + " " + CUST.DATA.UGDATE + " " + CUST.DATA.RWDATE + " " + CUST.DATA.FNDATE + " " + CUST.DATA.SUDATE
        sv_u = SYSTEM(sv_t)
        sv_k = 1
        CUST.DATA.resultMsg =   "DATE CHANGED"
        PRINT(CUST.DATA.resultMsg)
        GOTO ENDOFSCRIPT

ENDOFSCRIPT:

