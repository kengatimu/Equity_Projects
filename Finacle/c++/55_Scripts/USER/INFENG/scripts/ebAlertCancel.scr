	lv_d = lv_d + " and bank_id = ?SVAR "
	lv_d = lv_d + " and del_flg <> 'Y' "
	lv_d = lv_d + " and entity_cre_flg = 'N' "
	print(lv_d)

	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId
        print(BANCS.INPARAM.BINDVARS)
	
	lv_r = urhk_dbSQLWithBind(lv_d)
	print(lv_r)
	if(lv_r == 0) then
		EBSRV.GLBDATA.resMsg = "Alert Details Cancelled Successfully"
		GOTO ENDOFSCRIPT
	else
		EBSRV.GLBDATA.errMsg = "Verification Failed"
		GOTO ENDOFSCRIPT
	endif
#}
endif

if(EBSRV.GLBDATA.recVerType == "MOD") then
