#-------------------------------------------------------------------------------------    
#    Name				: getmoreinfo1.scr
#    Description     	: This script will be called from the mrt for generating report
#						: of future uncleared
#						:
#    Date            	: 28-07-2014
#    Author          	: jane
#    Input           	: BANCS.INPUT.lv_trandate ,BANCS.INPUT.lv_srlnum , BANCS.INPUT.lv_tranid
#    Output				: BANCS.OUTPUT.lv_bacid ,BANCS.OUTPUT.refnum ,BANCS.OUTPUT.lv_datetime ,BANCS.OUTPUT.lv_username
#					: BANCS.OUTPUT.lv_userlogedon , BANCS.OUTPUT.lv_PRINTid
#    Called Script	 	: NA
#    Calling Script	 	: NA
#    Menu Option		: NA
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0		28-07-2014		jane	 	Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="1f97622fee1aa1991b8e9887035595d73f42b8f21be778a5540d034eb03e39a9"
	TRACE ON
	LIBNAME CUSTOMSO
	
	BANCS.OUTPUT.lv_unclearbal=""
	BANCS.OUTPUT.lv_clearbal=""
	
	print(BANCS.INPUT.acctNum)
	sv_s = "unclearbal,clearbal|SELECT FUTURE_UN_CLR_BAL_AMT,FUTURE_CLR_BAL_AMT "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE GAM.bank_id = ?SVAR "
	sv_s = sv_s + "AND GAM.foracid = ?SVAR "
	sv_s = sv_s + "AND GAM.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.acctNum
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_s)
	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		BANCS.OUTPUT.lv_unclearbal = BANCS.OUTPARAM.unclearbal
		BANCS.OUTPUT.lv_clearbal = BANCS.OUTPARAM.clearbal
		PRINT(BANCS.OUTPUT.lv_unclearbal)
		PRINT(BANCS.OUTPUT.lv_clearbal)
		#}
	ELSE
		#{
		BANCS.OUTPUT.lv_unclearbal = " "
		BANCS.OUTPUT.lv_clearbal = " "
		
	#}
	ENDIF
	
	
	TRACE OFF
	EXITSCRIPT
END-->
