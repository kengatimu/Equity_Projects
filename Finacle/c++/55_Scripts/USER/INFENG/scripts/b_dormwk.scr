<--START
CHECKSUM="72574182a87ac0b699ca9cfa0e7de487520d2191878ed03b3eb907085a1d31ba"
	TRACE ON
	
	sv_b = BANCS.STDIN.mySolId
	print(sv_b)
	
	sv_q="foracid,acid,schmcode,delflg,glsubheadcode,schmtype,acctstatus,sweeps|"
	sv_q = sv_q + "select foracid,a.acid,schm_code,del_flg,gl_sub_head_code,schm_type,ACCT_STATUS,allow_sweeps from tbaadm.gam a,tbaadm.smt b where a.BANK_ID = ?SVAR AND a.acid=b.acid AND b.ACCT_STATUS='D' AND schm_code ='SB125' AND sol_id=?SVAR AND a.acct_cls_flg='N' "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + sv_b
	print(BANCS.INPARAM.BINDVARS)
	
	sv_e = urhk_dbCursorOpenWithBind(sv_q)
	
	IF(sv_e==0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		
		IF(sv_q == 1) THEN
		#{
			sv_x = urhk_dbCursorClose(sv_m)
			print(sv_x)
			exitscript
		#}
		ENDIF
		print(sv_q)
		
		WHILE(sv_q==0)
		#{
			sv_r = REPEXISTS("STDWFS")
			IF (sv_r == 0) THEN
			#{
				CREATEREP("STDWFS")
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("STDWFS", "DORMA")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("STDWFS", "DORMA", 5)
			#}
			ENDIF
			
			sv_j=BANCS.OUTPARAM.foracid
			sv_k=BANCS.OUTPARAM.acid
			sv_a=BANCS.OUTPARAM.schmcode
			STDWFS.DORMA.delflg=BANCS.OUTPARAM.delflg
			STDWFS.DORMA.glsubheadcode=BANCS.OUTPARAM.glsubheadcode
			sv_c=BANCS.OUTPARAM.schmtype
			STDWFS.DORMA.acctstatus=BANCS.OUTPARAM.acctstatus
			print(STDWFS.DORMA.acctstatus)
			sv_l=BANCS.OUTPARAM.sweeps
			
			
			
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account Modify services
			# urhk_SetUrhkInp is used to set inputs
			#--------------------------------------------------------------------------------------------------------------
			
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + sv_j)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + sv_k)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + sv_c)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + sv_a)
			PRINT(sv_u)
			
			#--------------------------------------------------------------------------------------------------------------
			# Fetch the account data for modify
			#--------------------------------------------------------------------------------------------------------------
			sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y")
			PRINT(sv_u)
			
			IF (sv_u == 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + sv_j)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + sv_k)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + sv_c)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + sv_a)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|"+ sv_l)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("operAcctSchmDtls.acctStat.code|A")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("operAcctSchmDtls.acctSchemeEntered|1")
				PRINT(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
			#}
			ENDIF
			IF(sv_u ==0) THEN
			#{
				#============================================================================*
				# Updating the table SVSUSER.SIGNMAINTENANCE column to  'N'
				#============================================================================*
				sv_r = REPEXISTS("STDWFS")
				IF (sv_r == 0) THEN
				#{
					CREATEREP("STDWFS")
				#}
				ENDIF
				
				sv_r = CLASSEXISTS("STDWFS", "DORMA")
				IF (sv_r == 0) THEN
				#{
					CREATECLASS("STDWFS", "DORMA", 5)
				#}
				ENDIF
				sv_s =""
				sv_s = sv_s + " UPDATE SVSUSER.SIGNMAINTENANCE"
				sv_s = sv_s + " SET SIGNMAINTENANCE.active ='Y'"
				sv_s = sv_s + " WHERE SIGNMAINTENANCE.signid IN "
				sv_s = sv_s + 								" (SELECT SIGNOTHERINFO.signid"
				sv_s = sv_s +								" FROM SVSUSER.SIGNOTHERINFO"
				sv_s = sv_s +								" WHERE SIGNOTHERINFO.acctid=?SVAR"
				sv_s = sv_s +								" AND   SIGNOTHERINFO.entityid=?SVAR)"
				PRINT(sv_s)
				#BANCS.INPARAM.BINDVARS	= ""
				BANCS.INPARAM.BINDVARS	= sv_j + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				PRINT(sv_d)
				
				IF(sv_d==0)THEN
				#{
					sv_d = urhk_dbSQLWithBind("COMMIT")
					PRINT(sv_d)
				#}
				ENDIF
			#}
			ENDIF
			
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				
				IF (sv_v > 0) THEN
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			
			
			
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			
		#}
		DO
		print("ALL ACCOUNTS ACTIVATED")
	#}
	ENDIF
	
	
	TRACE OFF
	exitscript
END-->
