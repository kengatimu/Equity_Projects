<--START
CHECKSUM="3477142315f0d8b2f2340a55b6f50b5e77bc774d3541329dbe1c37b71c13ae14"
	TRACE ON
	
	CUST.CIETXN.scriptSuccess = "Y"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.entity1TranId = ""
	CUST.CIETXN.entity1TranDate = ""
	CUST.CIETXN.entity2TranId = ""
	CUST.CIETXN.entity2TranDate = ""
	CUST.CIETXN.nostroAcct = ""
	CUST.CIETXN.vostroAcct = ""
	
	CUST.CIETXN.msgStr = "tranDtl.tranIdentifier.tranId"
	sv_u = urhk_SRV_GetVal(CUST.CIETXN.msgStr)
	IF(sv_u != 0) THEN
	#{
		GOTO NEXTFETCH
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.srvValue)
	CUST.CIETXN.entity1TranId = BANCS.OUTPARAM.srvValue
	PRINT(CUST.CIETXN.entity1TranId)
	
	CUST.CIETXN.msgStr = "tranDtl.tranIdentifier.tranDate"
	sv_u = urhk_SRV_GetVal(CUST.CIETXN.msgStr)
	IF(sv_u != 0) THEN
	#{
		GOTO NEXTFETCH
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.srvValue)
	CUST.CIETXN.entity1TranDate = BANCS.OUTPARAM.srvValue
	PRINT(CUST.CIETXN.entity1TranDate)
	
	CUST.CIETXN.entity1TranDate = MID$(CUST.CIETXN.entity1TranDate,0,10)
	PRINT(CUST.CIETXN.entity1TranDate)
	
	CUST.CIETXN.nostroAcct = CUST.CIETXN.foracid
	PRINT(CUST.CIETXN.nostroAcct)
	
	######################################################################################
	# Get Current Txn Ref Amt and Ref Crncy to Compare with Original Ref Amt and Ref Crncy
	######################################################################################
	
	CUST.CIETXN.refAmt = ""
	CUST.CIETXN.refCrncy = ""
	
	CUST.CIETXN.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.refAmt"
	sv_u = urhk_SRV_GetVal(CUST.CIETXN.msgStr)
	IF(sv_u != 0) THEN
	#{
		GOTO NEXTFETCH
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.srvValue)
	CUST.CIETXN.refAmtAndCcy = BANCS.OUTPARAM.srvValue
	PRINT(CUST.CIETXN.refAmtAndCcy)
	
	sv_p = GETPOSITION(CUST.CIETXN.refAmtAndCcy,"|")
	print(sv_p)
	
	IF(sv_p > 0)THEN
	#{
		CUST.CIETXN.refAmt =  MID$(CUST.CIETXN.refAmtAndCcy,0,sv_p-1)
		PRINT(CUST.CIETXN.refAmt)
		CUST.CIETXN.refCrncy = MID$(CUST.CIETXN.refAmtAndCcy,sv_p,3)
		PRINT(CUST.CIETXN.refCrncy)
		#}
	ELSE
		#{
		CUST.CIETXN.scriptSuccess = "N"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Create Transaction in the Other Entity Through FI Call
	######################################################################################
	
	CUST.CIETXN.entity2 = MID$(CUST.CIETXN.ieTxnRefNo,0,2)
	CUST.CIETXN.ieRefAmt = ""
	CUST.CIETXN.ieRefCrncy = ""
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.ieTxnRefNo
	sv_s = "crAcctNum,ieRefAmt,ieRefCrncy,ieTranAmt,ieTranCrncy|"
	sv_s = sv_s + " SELECT CR_ACCOUNT_ID,REF_AMT,REF_CRNCY_CODE,TRAN_AMT,TRAN_CRNCY_CODE"
	sv_s = sv_s + " FROM TBAADM.IEPAGL "
	sv_s = sv_s + " WHERE STATUS_FLG = 'I'"
	sv_s = sv_s + " AND IE_TXN_REF_NO = ?SVAR"
	
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.crAcctNum = BANCS.OUTPARAM.crAcctNum
		print(CUST.CIETXN.crAcctNum)
		CUST.CIETXN.ieRefAmt = BANCS.OUTPARAM.ieRefAmt
		print(CUST.CIETXN.ieRefAmt)
		CUST.CIETXN.ieRefCrncy = BANCS.OUTPARAM.ieRefCrncy
		print(CUST.CIETXN.ieRefCrncy)
		CUST.CIETXN.ieTranAmt = BANCS.OUTPARAM.ieTranAmt
                print(CUST.CIETXN.ieTranAmt)
                CUST.CIETXN.ieTranCrncy = BANCS.OUTPARAM.ieTranCrncy
                print(CUST.CIETXN.ieTranCrncy)
		#}
	ELSE
		#{
		CUST.CIETXN.scriptSuccess = "N"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#IF((CUST.CIETXN.refAmt != CUST.CIETXN.ieRefAmt) OR (CUST.CIETXN.refCrncy != CUST.CIETXN.ieRefCrncy))THEN
	#{
	#	CUST.CIETXN.errorMsg = "Original Ref. CCY/Amt. is altered. Cannot proceed with Cash Withdrawal"
	#	CUST.CIETXN.scriptSuccess = "N"
	#        GOTO ENDOFSCRIPT
	#}
	#ENDIF
	
	####################################################################
	# Find the Vostro Account Number
	####################################################################
	
	CUST.CIETXN.targetEntity = CUST.CIETXN.entity2
	PRINT(CUST.CIETXN.targetEntity)
	
	IF(CUST.CIETXN.targetEntity == BANCS.STDIN.contextBankId)THEN
	#{
		#CUST.CIETXN.errorMsg = "Init Entity and Target Entity are same. Unable to derive Vostro Account"
		#sv_u = urhk_SRV_SetErr(CUST.CIETXN.errorMsg)
		#CUST.CIETXN.scriptSuccess = "N"
		
		#FI Call Not Required
		GOTO UPDATE_IEPAGL
	#}
	ENDIF
	
	VOSTRO:
		CUST.CIETXN.parameterId = "PA" + "_VOSTRO_" + CUST.CIETXN.targetEntity
		print(CUST.CIETXN.parameterId)
		
		sv_s = "vostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account"
			sv_u = urhk_SRV_SetErr(CUST.CIETXN.errorMsg)
			CUST.CIETXN.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.vostroAcct = BANCS.OUTPARAM.vostroAcct
		print(CUST.CIETXN.vostroAcct)
		
		IF(TRIM(CUST.CIETXN.vostroAcct) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account"
			sv_u = urhk_SRV_SetErr(CUST.CIETXN.errorMsg)
			CUST.CIETXN.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.acctNumSolId = ""
		CUST.CIETXN.acctNumCcy = ""
		
		sv_s = "acctNumSolId,acctNumCcy|"
		sv_s = sv_s + " SELECT SOL_ID,ACCT_CRNCY_CODE"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE FORACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.crAcctNum
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
			print(CUST.CIETXN.acctNumSolId)
			CUST.CIETXN.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
			print(CUST.CIETXN.acctNumCcy)
			#}
		ELSE
			#{
			CUST.CIETXN.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.inputBankId = CUST.CIETXN.entity2
		CUST.CIETXN.inputBacid = CUST.CIETXN.vostroAcct
		CUST.CIETXN.inputSolId = CUST.CIETXN.acctNumSolId
		CUST.CIETXN.inputCcy = CUST.CIETXN.acctNumCcy
		CUST.CIETXN.inputBacidOrForacid = CUST.CIETXN.vostroAcct
		
		CALL("cietxndp032.scr")
		
		PRINT(CUST.CIETXN.outputForacid)
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account"
			sv_u = urhk_SRV_SetErr(CUST.CIETXN.errorMsg)
			CUST.CIETXN.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.vostroAcct = CUST.CIETXN.outputForacid
		
		#######################################################################################
		
		CUST.CIETXN.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.refAmt"
		sv_u = urhk_SRV_GetVal(CUST.CIETXN.msgStr)
		IF(sv_u != 0) THEN
		#{
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.CIETXN.refAmtAndCcy = BANCS.OUTPARAM.srvValue
		PRINT(CUST.CIETXN.refAmtAndCcy)
		
		sv_p = GETPOSITION(CUST.CIETXN.refAmtAndCcy,"|")
		print(sv_p)
		
		IF(sv_p > 0)THEN
		#{
			CUST.CIETXN.refAmt =  MID$(CUST.CIETXN.refAmtAndCcy,0,sv_p-1)
			PRINT(CUST.CIETXN.refAmt)
			CUST.CIETXN.refCrncy = MID$(CUST.CIETXN.refAmtAndCcy,sv_p,3)
			PRINT(CUST.CIETXN.refCrncy)
			#}
		ELSE
			#{
			CUST.CIETXN.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#######################################################################################
		
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
		print(BANCS.STDIN.sysDate)
		
		sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.RequestID = BANCS.OUTPARAM.RequestID
			print(CUST.CIETXN.RequestID)
			#}
		ELSE
			#{
			CUST.CIETXN.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
			print(CUST.CIETXN.RequestID)
		#}
		ENDIF
		
		CUST.INTERFACE.interfaceRequestID = "XferTrnAdd"
		CUST.INTERFACE.interfaceRequestVersion = "10.2"
		CUST.INTERFACE.RequestID = CUST.CIETXN.RequestID
		CUST.INTERFACE.bankID = CUST.CIETXN.entity2
		CUST.INTERFACE.channelID = "COR"
		CUST.INTERFACE.tranType = "T"
		CUST.INTERFACE.tranSubType = "CI"
		CUST.INTERFACE.drAcctID = CUST.CIETXN.crAcctNum
		CUST.INTERFACE.crAcctID = CUST.CIETXN.vostroAcct
		#CUST.INTERFACE.tranAmtCr = CUST.CIETXN.ieRefAmt
		#CUST.INTERFACE.tranCcyCr = CUST.CIETXN.ieRefCrncy
		#CUST.INTERFACE.tranAmtDr = CUST.CIETXN.ieRefAmt
		#CUST.INTERFACE.tranCcyDr = CUST.CIETXN.ieRefCrncy
		CUST.INTERFACE.tranAmtCr = CUST.CIETXN.ieTranAmt
                CUST.INTERFACE.tranCcyCr = CUST.CIETXN.ieTranCrncy
                CUST.INTERFACE.tranAmtDr = CUST.CIETXN.ieTranAmt
                CUST.INTERFACE.tranCcyDr = CUST.CIETXN.ieTranCrncy
		CUST.INTERFACE.tranParticularsCr = "Paymet To A/c GL Txn"
		CUST.INTERFACE.tranParticularsDr = "Paymet To A/c GL Txn"
		CUST.INTERFACE.tranRmksCr = "Paymet To A/c GL Txn"
		CUST.INTERFACE.tranRmksDr = "Paymet To A/c GL Txn"
		CUST.INTERFACE.drValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.rateCode = ""
		CUST.INTERFACE.drRate = "1.00"
		CUST.INTERFACE.crRate = "1.00"
		CUST.INTERFACE.chkInstDetails = "N"
		CUST.INTERFACE.instDate = ""
		CUST.INTERFACE.instAlpha = ""
		CUST.INTERFACE.instNum = ""
		CUST.INTERFACE.instType = ""
		CUST.INTERFACE.chargeAmtPartTran = "N"
		CUST.INTERFACE.errorMsgFlg = "N"
		CUST.INTERFACE.errorMsgCode = " "
		CUST.INTERFACE.errorMsgDesc = " "
		CUST.INTERFACE.errorDesc = " "
		CUST.INTERFACE.errorCode = " "
		
		CALL("cietxnmn003.scr")
		
		IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SRV_SetErr("Could not create transaction in the other entity")
			print(sv_u)
			
			lv_a = CUST.INTERFACE.errorDesc
			
			lv_l = STRLEN(lv_a)
			lv_n = 0
			lv_s = ""
			WHILE(lv_n < lv_l)
			#{
				PRINT(lv_a)
				PRINT(lv_n)
				lv_c = ""
				lv_c = MID$(lv_a,lv_n,1)
				print(lv_c)
				
				IF(lv_c == "|")THEN
				#{
					PRINT("IF")
					lv_s = lv_s + " - "
					PRINT(lv_s)
					GOTO NEXT_CHAR
				#}
				ENDIF
				
				IF(lv_c == "'")THEN
				#{
					PRINT("IF")
					lv_s = lv_s + ""
					PRINT(lv_s)
					GOTO NEXT_CHAR
				#}
				ENDIF
				
				lv_s = lv_s + lv_c
				PRINT(lv_s)
				
			NEXT_CHAR:
				
				lv_n = lv_n + 1
			#}
			DO
			
			PRINT(lv_a)
			PRINT(lv_s)
			
			CUST.INTERFACE.errorDesc = lv_s
			CUST.INTERFACE.errorDesc = CUST.INTERFACE.errorCode + " - " + CUST.INTERFACE.errorDesc
			PRINT(CUST.INTERFACE.errorDesc)
			CUST.CIETXN.scriptSuccess = "N"
			sv_u = urhk_SRV_SetErr(CUST.INTERFACE.errorDesc)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.entity2TranId = CUST.INTERFACE.tranId
		PRINT(CUST.CIETXN.entity2TranId)
		CUST.CIETXN.entity2TranDate = MID$(CUST.INTERFACE.tranDate,0,10)
		PRINT(CUST.CIETXN.entity2TranDate)
		
		######################################################################################
		# Update data into the IEPAGL Custom Table
		######################################################################################
		
	UPDATE_IEPAGL:
		
		CALL("cietxndp043.scr")
		
		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	ENDOFSCRIPT:
END-->
