<--START
TRACE ON
	#--------------------------------------------------------
	#create repository
	#--------------------------------------------------------
		IF (REPEXISTS("CUST") == 0 ) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF

		IF (CLASSEXISTS("CUST","DATA") == 0) THEN
		#{
			CREATECLASS("CUST","DATA",5)
		#}
		ENDIF

        
        #----------------------------------------------------------------------
        # Printing Bancs Repository
        #----------------------------------------------------------------------

            sv_x = urhk_B2k_PrintRepos("BANCS")
            print(sv_x)

        #----------------------------------------------------------------------
        # Variable Initialization
        #----------------------------------------------------------------------

            CUST.DATA.funCode		= BANCS.INPUT.funCode
			PRINT(CUST.DATA.funCode)
			
			CUST.DATA.CUST_TYPE		= ""
			CUST.DATA.REFCODE = CUST.CCLT.refnumber

			CUST.DATA.CIF_ID		= CUST.CCLT.CIF_ID
			PRINT(CUST.DATA.CIF_ID )

			CUST.DATA.ACCT_NAME 		= CUST.CCLT.ACCT_NAME
			PRINT(CUST.DATA.ACCT_NAME)

			CUST.DATA.CLT_ID		= CUST.CCLT.CLT_ID
			PRINT(CUST.DATA.CLT_ID)

		
			BANCS.INPARAM.BINDVARS =  CUST.DATA.CIF_ID+"|"+BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)

            sv_q = "count|select count(1) from crmuser.accounts where orgkey=?SVAR and bank_id=?SVAR"
			print(sv_q)

			sv_u = urhk_dbSelectWithBind(sv_q)
			PRINT(sv_u)

            IF(SV_U == 0)THEN
            #{
                sv_t = BANCS.OUTPARAM.count
                print(sv_t)

            #}

           ENDIF 
		
            CUST.CCLT.STATUS_FLG = "u"

            IF(sv_t == 0)THEN
            #{
                    CUST.CCLT.VALID_FLG = "N"
                    PRINT(CUST.CCLT.VALID_FLG)
                    CUST.CCLT.STATUS_FLG = "F"
            #}
            ELSE
            #{
                    CUST.CCLT.VALID_FLG = "Y"
                    PRINT(CUST.CCLT.VALID_FLG)
                    CUST.CCLT.STATUS_FLG = "U"
            #}
            ENDIF


            BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.CIF_ID
			print(BANCS.INPARAM.BINDVARS)
		
			sv_q = "orgkey,cust_type|select orgkey,(case when corp_id is not null then 'C' else 'I' end)cust_type "
			sv_q = sv_q +"from crmuser.accounts where bank_id=?SVAR and orgkey = ?SVAR"
			print(sv_q)

            sv_u = urhk_dbSelectWithBind(sv_q)
			PRINT(sv_u)

            IF(sv_u == 0) THEN
			#{
				CUST.CCLT.CIF_ID = BANCS.OUTPARAM.orgkey
				print(CUST.CCLT.CIF_ID)
				CUST.DATA.CUST_TYPE = BANCS.OUTPARAM.cust_type
				print(CUST.DATA.CUST_TYPE)
			#}
			ENDIF

            IF(sv_u == 1) THEN
			#{
				CUST.DATA.CUST_TYPE = "X" 
				print(CUST.DATA.CUST_TYPE)
			#}
			ENDIF

            	
				IF(CUST.DATA.funCode == "U")THEN
				#{
					print("Start insert")
					 
					BANCS.INPARAM.BINDVARS =  CUST.DATA.REFCODE + "|" +CUST.DATA.CIF_ID+"|"+CUST.DATA.CUST_TYPE
					BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS +"|"+CUST.DATA.ACCT_NAME +"|"+ CUST.DATA.CLT_ID 
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+CUST.CCLT.VALID_FLG+"|"+CUST.CCLT.STATUS_FLG+"|"+'N'+"|"+BANCS.STDIN.userId
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
				
					sv_a = "INSERT INTO CUSTOM.CCLT(REF_CODE,CIF_ID,CUST_TYPE,ACCT_NAME,CLT_ID,VALID_FLG,STATUS_CODE,ENTITY_CRE_FLG"
					sv_a = sv_a + ",RCRE_USER_ID,LCHG_USER_ID,RCRE_TIME,LCHG_TIME,BANK_ID)"
					sv_a = sv_a + " values(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,SYSDATE,SYSDATE,?SVAR)"
					print(sv_a)

					sv_b = urhk_dbSQLWithBind(sv_a)
					PRINT(sv_b)
					
					IF(sv_b == "0")THEN
					#{
						print("Data Inserted successfully :" + CUST.DATA.CIF_ID )
					#}
					ENDIF
					
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				sv_z   =   urhk_SetOrbOut("SuccessOrFailure|Y")

	ENDOFSCRIPT:

	   EXITSCRIPT 
END-->
