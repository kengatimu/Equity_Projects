#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName       : ebGtJipangeFundEntry.scr 
#Desc           : 
#MenuId         : NA
#CalledScript   :
#Module         : GtGoals
#Date           : 24/07/2019
#Author         : Vino Palani
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Reps&Classes
	if(BANCS.STDIN.moduleIdentity =="FI")then
		exitscript
	endif
	if(repexists("EQGTG")==0) then
		createrep("EQGTG")
	endif
	if(classexists("EQGTG","GLBDATA")==0) then
		createclass("EQGTG","GLBDATA",5)
	endif
	#sv_u = urhk_B2k_PrintRepos("BANCS")
	#print(sv_u)
	if(fieldexists(BANCS.STDIN.menuId)==1)then
		EQGTG.GLBDATA.menuId	=	BANCS.STDIN.menuId
	else
		EQGTG.GLBDATA.menuId	=	""
	endif
	if(fieldexists(BANCS.STDIN.serviceName)==1)then
		EQGTG.GLBDATA.serviceName	=	BANCS.STDIN.serviceName
	else
		EQGTG.GLBDATA.serviceName	=	""
	endif
	if(fieldexists(BANCS.STDIN.funcName)==1)then
		EQGTG.GLBDATA.funcName	=	BANCS.STDIN.funcName
	else
		EQGTG.GLBDATA.funcName	=	""
	endif
	if(fieldexists(BANCS.STDIN.ScriptName)==1)then
		EQGTG.GLBDATA.ScriptName	=	BANCS.STDIN.ScriptName
	else
		EQGTG.GLBDATA.ScriptName	=	""
	endif
	if(fieldexists(BANCS.STDIN.mySolId)==1)then
		EQGTG.GLBDATA.mySolId	=	BANCS.STDIN.mySolId
	else
		EQGTG.GLBDATA.mySolId	=	""
	endif		
	if(fieldexists(BANCS.STDIN.onlineOrBatch)==1)then
		EQGTG.GLBDATA.onlineOrBatch	=	BANCS.STDIN.onlineOrBatch
	else
		EQGTG.GLBDATA.onlineOrBatch	=	""
	endif		
	if(fieldexists(BANCS.STDIN.exeName)==1)then
		EQGTG.GLBDATA.exeName	=	BANCS.STDIN.exeName
	else
		EQGTG.GLBDATA.exeName	=	""
	endif		
	if(fieldexists(BANCS.STDIN.userId)==1)then
		EQGTG.GLBDATA.userId	=	BANCS.STDIN.userId
	else
		EQGTG.GLBDATA.userId	=	""
	endif		
	if(fieldexists(BANCS.STDIN.userWorkClass)==1)then
		EQGTG.GLBDATA.userWorkClass	=	BANCS.STDIN.userWorkClass
	else
		EQGTG.GLBDATA.userWorkClass	=	""
	endif		
	if(fieldexists(BANCS.STDIN.roleId)==1)then
		EQGTG.GLBDATA.roleId	=	BANCS.STDIN.roleId
	else
		EQGTG.GLBDATA.roleId	=	""
	endif		

	BANCS.INPUT.goaldts	= ""
	BANCS.INPUT.wkbAcct	= ""
	BANCS.INPUT.wkbthlmt	= "0"
	BANCS.INPUT.wkbdeppcnt	= "0"
	BANCS.INPUT.wksAcct	= ""
	BANCS.INPUT.wksDepPcnt	= "0"
	BANCS.INPUT.wkJipAcct	= ""
	EQGTG.GLBDATA.jipAcct	= ""
	EQGTG.GLBDATA.ModuleId	= ""
#SrvValues
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EQGTG.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EQGTG.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranDate")
	EQGTG.GLBDATA.tranDate=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
	EQGTG.GLBDATA.tranId=BANCS.OUTPARAM.srvValue
	if ((EQGTG.GLBDATA.tranSubType == "NP") or (EQGTG.GLBDATA.tranSubType=="CP") or (EQGTG.GLBDATA.tranSubType=="NR") or (EQGTG.GLBDATA.tranSubType=="CR") or (EQGTG.GLBDATA.tranSubType=="BI") or (EQGTG.GLBDATA.tranSubType=="CI"))then
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EQGTG.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EQGTG.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EQGTG.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EQGTG.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EQGTG.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EQGTG.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EQGTG.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EQGTG.GLBDATA.tran_rmks)
		sv_l = strlen(EQGTG.GLBDATA.tran_amt)
		sv_f = mid$(EQGTG.GLBDATA.tran_amt,0,sv_l)
		sv_l = strlen(EQGTG.GLBDATA.tran_amt)
		sv_p = getposition(sv_f,"|")
		EQGTG.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
		EQGTG.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
		print(EQGTG.GLBDATA.trans_amt)
		print(EQGTG.GLBDATA.trans_crncy)
		print(EQGTG.GLBDATA.tran_amt)
		if((EQGTG.GLBDATA.partTranType =="C") and (EQGTG.GLBDATA.foracid!=""))then
			sv_d = "fundChk | select count(*) from custom.ebgtgoal_jipange_funding "
			sv_d = sv_d + " where bank_id=?SVAR and fund_YN='N' and upl_tranid is not null and free_text1='N' "
			sv_d = sv_d + " and upl_tranid = ltrim(?SVAR) " 
			sv_d = sv_d + " and upl_trandate = to_date(?SVAR,'DD-MM-RR') "
			sv_d = sv_d + " and dr_acctid = ?SVAR "
			sv_d = sv_d + " and upl_tranamt = ?NVAR "
			sv_d = sv_d + " and fund_tranid is null and rownum<=1"
			print(sv_d)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQGTG.GLBDATA.tranId + "|" +mid$(BANCS.STDIN.BODDate,0,10)+ "|" + EQGTG.GLBDATA.foracid + "|" +EQGTG.GLBDATA.trans_amt
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u ==0)then
				EQGTG.GLBDATA.fundChk = BANCS.OUTPARAM.fundChk
			else
				EQGTG.GLBDATA.fundChk = "0"
			endif
			if(cint(EQGTG.GLBDATA.fundChk)<=0)then
				goto NXTLP
			endif
			sv_d ="tranPartiCnt | select custom.ebgtgoal_master_fun('"+EQGTG.GLBDATA.foracid+"',"+EQGTG.GLBDATA.trans_amt+",'KES',"
			sv_d = sv_d + " '"+EQGTG.GLBDATA.tran_rmks+"','remarks','refnum','"+BANCS.STDIN.contextBankId+"','T') from dual "
			print(sv_d)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EQGTG.GLBDATA.tranPartiCnt = BANCS.OUTPARAM.tranPartiCnt 
			else
				EQGTG.GLBDATA.tranPartiCnt = 0 
			endif
		if(cint(EQGTG.GLBDATA.tranPartiCnt)>=1)then
		#{
			sv_d ="goalsDtls | select custom.ebgtgoal_master_fun('"+EQGTG.GLBDATA.foracid+"',"+EQGTG.GLBDATA.trans_amt+",'KES',"
			sv_d = sv_d + " '"+EQGTG.GLBDATA.tran_rmks+"','remarks','refnum','"+BANCS.STDIN.contextBankId+"','P') from dual "
			print(sv_d)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				BANCS.INPUT.goaldts = BANCS.OUTPARAM.goalsDtls 
			else
				BANCS.INPUT.goaldts = "NA" 
			endif
			#++++++++to get goal details ++++++++++++
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wkbAcct  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wkbAcct)
			#-- Wekeza Threshold Limit
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wkbthlmt  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wkbthlmt)
			#-- Wekeza Deposit Pcnt
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wkbdeppcnt  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wkbdeppcnt)
			#--Wekeza Sasa Acct
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wksAcct  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wksAcct)
			#--Wekeza Sasa Dep Pcnt
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wksDepPcnt  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wksDepPcnt)
			#--Wekeza Jipange Acct
			###BANCS.INPUT.wkJipAcct = mid$(sv_f,sv_p,sv_l)
			###print(BANCS.INPUT.wkJipAcct)
			#--Wekeza Oct Jipange Acct
			BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
			sv_l = strlen(BANCS.INPUT.goaldts)
			sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
			sv_p = getposition(sv_f,"|")
			BANCS.INPUT.wksOctJipAcct  = mid$(sv_f,0,(sv_p-1))
			print(BANCS.INPUT.wksOctJipAcct)
			#--Wekeza Apr Jipange Acct
			BANCS.INPUT.wksAprJipAcct = mid$(sv_f,sv_p,sv_l)
			print(BANCS.INPUT.wksAprJipAcct)

			if((BANCS.INPUT.wkbAcct != "") and (BANCS.INPUT.wkbAcct!="NA"))then
				EQGTG.GLBDATA.ModuleId = "GTWKB"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wkbAcct	
			endif
			if((BANCS.INPUT.wksAcct != "") and (BANCS.INPUT.wksAcct!="NA"))then
				EQGTG.GLBDATA.ModuleId = "GTWKS"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAcct
			endif
			#+++++++++++++++++++++++++++++++++++++++++++++++++++++++
			#to derive which account has to credit October or April
			#+++++++++++++++++++++++++++++++++++++++++++++++++++++++
			sv_d = left$(BANCS.STDIN.BODDate,10)
			print(sv_d)
			sv_y = mid$(sv_d,8,10)
			print(sv_y)
			sv_m = mid$(sv_d,3,2)
			print(sv_m)
			if((cint(sv_m)==4))then
				print("april KTDA Salary Tran Ok, for funding to jipange")
				EQGTG.GLBDATA.jipangeFundYN = "Y"
				EQGTG.GLBDATA.ModuleId = "GTJIP"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAprJipAcct 
			endif
			##if((cint(sv_m) ==10 ))then
			if((cint(sv_m) == 7) or (cint(sv_m) == 8))then 
				print("october KTDA Salary Tran Ok, for funding to jipange")
				EQGTG.GLBDATA.jipangeFundYN = "Y"
				EQGTG.GLBDATA.ModuleId = "GTJIP"
				EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksOctJipAcct 
			endif
			if(EQGTG.GLBDATA.jipAcct != "") then
				print(EQGTG.GLBDATA.jipAcct)
				callscriptifexist("ebGtJipFundEntryTranMtt.scr")
				if(fieldexists(EQGTG.GLBDATA.fundTranId)==1)then
					print(EQGTG.GLBDATA.fundTranId)
					if(EQGTG.GLBDATA.fundTranId != "")then
					#{
                                        sv_d = "update custom.EBGTGOAL_JIPANGE_FUNDING set fund_yn='Y' ,fund_tranid=ltrim(?SVAR) ,"
					sv_d = sv_d + " fund_trandate=to_date(?SVAR,'DD-MM-RR') ,lchg_user_id=?SVAR "
                                        sv_d = sv_d + " ,lchg_time = to_date(?SVAR,'DD-MM-RR') where "
                                        sv_d = sv_d + " bank_id =?SVAR and dr_acctid=?SVAR and cr_acctid=?SVAR and upl_tranid=ltrim(?SVAR) "
                                    BANCS.INPARAM.BINDVARS = EQGTG.GLBDATA.fundTranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.contextBankId + "|" + EQGTG.GLBDATA.foracid + "|" + EQGTG.GLBDATA.crAcct + "|" +EQGTG.GLBDATA.tranId
                                        print(sv_d)
                                        print(BANCS.INPARAM.BINDVARS)
                                        sv_u = urhk_dbSqlWithBind(sv_d)
                                        if(sv_u==0)then
                                                sv_u = urhk_dbSqlWithBind("commit")
						goto NXTLP
                                        else
                                                sv_u = urhk_dbSqlWithBind("rollback")
						goto NXTLP
                                        endif
					#}
					endif
				endif
			else
				goto NXTLP
			endif
		else
			goto NXTLP
		#}
		endif
		endif
	NXTLP:
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif
VAYU:	
	if(classexists("EQGTG","GLBDATA")==1) then
		deleteclass("EQGTG","GLBDATA")
	endif
	if(repexists("EQGTG")==1) then
		deleterep("EQGTG")
	endif
	exitscript
#trace off
end-->

