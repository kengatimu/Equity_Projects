        if(EBSRV.GLBDATA.CrncyCode=="USD")then
                lv_a = lv_a + " and lower_lim='10000' "
                lv_a = lv_a + " and higher_lim='49999' "
        endif
        if(EBSRV.GLBDATA.CrncyCode=="KES")then
                lv_a = lv_a + " and lower_lim='1000000' "
                lv_a = lv_a + " and higher_lim='9999999' "
        endif
        lv_a = lv_a + " and del_flg <> 'Y' "
        lv_a = lv_a + " and entity_cre_flg = 'Y' "
        PRINT(lv_a)

        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.LowLimR2 +"|"+ EBSRV.GLBDATA.HighLimR2+"|"+ BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode +"|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        PRINT(BANCS.INPARAM.BINDVARS)

        lv_r = urhk_dbSQLWithBind(lv_a)
        PRINT(lv_r)
        #}
        ENDIF
        if(EBSRV.GLBDATA.LowLim3!="")then
        #{
        lv_a = " update custom.armt set "
        lv_a = lv_a + " lower_rate = ?SVAR, "
        lv_a = lv_a + " higher_rate = ?SVAR, "
        lv_a = lv_a + " lchg_time = SYSDATE ,"
        lv_a = lv_a + " lchg_user_id = ?SVAR "
        lv_a = lv_a + " where bank_id=?SVAR "
        lv_a = lv_a + " and currency_code = ?SVAR "
        lv_a = lv_a + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_a = lv_a + " and deposit_type=?SVAR "
        lv_a = lv_a + " and deposit_period_mnths=?SVAR "
        if(EBSRV.GLBDATA.CrncyCode=="USD")then
                lv_a = lv_a + " and lower_lim='50000' "
                lv_a = lv_a + " and higher_lim='99999' "
        endif
        if(EBSRV.GLBDATA.CrncyCode=="KES")then
                lv_a = lv_a + " and lower_lim='10000000' "
                lv_a = lv_a + " and higher_lim='49999999' "
        endif
        lv_a = lv_a + " and del_flg <> 'Y' "
        lv_a = lv_a + " and entity_cre_flg = 'Y' "
        PRINT(lv_a)

        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.LowLimR3 +"|"+ EBSRV.GLBDATA.HighLimR3+"|"+ BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode +"|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        PRINT(BANCS.INPARAM.BINDVARS)

        lv_r = urhk_dbSQLWithBind(lv_a)
        PRINT(lv_r)
        #}
        ENDIF
        if(EBSRV.GLBDATA.LowLim4!="")then
        #{
        lv_a = " update custom.armt set "
        lv_a = lv_a + " lower_rate = ?SVAR, "
        lv_a = lv_a + " higher_rate = ?SVAR, "
        lv_a = lv_a + " lchg_time = SYSDATE ,"
        lv_a = lv_a + " lchg_user_id = ?SVAR "
        lv_a = lv_a + " where bank_id=?SVAR "
        lv_a = lv_a + " and currency_code = ?SVAR "
        lv_a = lv_a + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_a = lv_a + " and deposit_type=?SVAR "
        lv_a = lv_a + " and deposit_period_mnths=?SVAR "
        if(EBSRV.GLBDATA.CrncyCode=="USD")then
                lv_a = lv_a + " and lower_lim='100000' "
                lv_a = lv_a + " and higher_lim='500000' "
        endif
        if(EBSRV.GLBDATA.CrncyCode=="KES")then
                lv_a = lv_a + " and lower_lim='50000000' "
                lv_a = lv_a + " and higher_lim='99999999' "
        endif
        lv_a = lv_a + " and del_flg <> 'Y' "
        lv_a = lv_a + " and entity_cre_flg = 'Y' "
        PRINT(lv_a)

        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.LowLimR4 +"|"+ EBSRV.GLBDATA.HighLimR4+"|"+ BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode +"|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        PRINT(BANCS.INPARAM.BINDVARS)

        lv_r = urhk_dbSQLWithBind(lv_a)
        PRINT(lv_r)
        #}
        ENDIF
        if(EBSRV.GLBDATA.LowLim5!="")then
        #{
        lv_a = " update custom.armt set "
        lv_a = lv_a + " lower_rate = ?SVAR, "
        lv_a = lv_a + " higher_rate = ?SVAR, "
        lv_a = lv_a + " lchg_time = SYSDATE ,"
        lv_a = lv_a + " lchg_user_id = ?SVAR "
        lv_a = lv_a + " where bank_id=?SVAR "
        lv_a = lv_a + " and currency_code = ?SVAR "
        lv_a = lv_a + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_a = lv_a + " and deposit_type=?SVAR "
        lv_a = lv_a + " and deposit_period_mnths=?SVAR "
        if(EBSRV.GLBDATA.CrncyCode=="USD")then
                lv_a = lv_a + " and lower_lim='1000000' "
                lv_a = lv_a + " and higher_lim='ABOVE' "
        endif
        if(EBSRV.GLBDATA.CrncyCode=="KES")then
                lv_a = lv_a + " and lower_lim='100000000' "
                lv_a = lv_a + " and higher_lim='249999999' "
        endif
        lv_a = lv_a + " and del_flg <> 'Y' "
        lv_a = lv_a + " and entity_cre_flg = 'Y' "
        PRINT(lv_a)

        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.LowLimR5 +"|"+ EBSRV.GLBDATA.HighLimR5+"|"+ BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode +"|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        PRINT(BANCS.INPARAM.BINDVARS)

        lv_r = urhk_dbSQLWithBind(lv_a)
        PRINT(lv_r)
        #}
        ENDIF
        if(EBSRV.GLBDATA.LowLim6!="")then
        #{
        lv_a = " update custom.armt set "
        lv_a = lv_a + " lower_rate = ?SVAR, "
        lv_a = lv_a + " higher_rate = ?SVAR, "
        lv_a = lv_a + " lchg_time = SYSDATE ,"
        lv_a = lv_a + " lchg_user_id = ?SVAR "
        lv_a = lv_a + " where bank_id=?SVAR "
        lv_a = lv_a + " and currency_code = ?SVAR "
        lv_a = lv_a + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_a = lv_a + " and deposit_type=?SVAR "
        lv_a = lv_a + " and deposit_period_mnths=?SVAR "
        if(EBSRV.GLBDATA.CrncyCode=="USD")then
                lv_a = lv_a + " and lower_lim='0' "
                lv_a = lv_a + " and higher_lim='0' "
        endif
        if(EBSRV.GLBDATA.CrncyCode=="KES")then
                lv_a = lv_a + " and lower_lim='250000000' "
