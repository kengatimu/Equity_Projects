        PRINT(BANCS.INPARAM.BINDVARS)

        lv_r = urhk_dbSQLWithBind(lv_a)
        PRINT(lv_r)
        #}
        ENDIF

	lv_d = "delete from custom.alco_rate_mod_tbl "
	lv_d = lv_d + " where bank_id = ?SVAR "
	lv_d = lv_d + " and currency_code = ?SVAR "
	lv_d = lv_d + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
	lv_d = lv_d + " and deposit_type=?SVAR "
	lv_d = lv_d + " and deposit_period_mnths=?SVAR "
	lv_d = lv_d + " and del_flg <> 'Y' "
	##lv_d = lv_d + " and entiry_cre_flg = 'N' "
	lv_d = lv_d + " and entiry_cre_flg = 'Y' "
	PRINT(lv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" + EBSRV.GLBDATA.AplliDate +"|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays    
	PRINT(BANCS.INPARAM.BINDVARS)
	lv_r = urhk_dbSQLWithBind(lv_d)
	PRINT(lv_r)
	IF(lv_r == 0) THEN
	#{
		EBSRV.GLBDATA.resMsg = "ALCO Rate Details Verified Successfully"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
