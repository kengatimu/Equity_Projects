<--START

TRACE ON
callscriptifexist("ebRepClass.scr")

EBSRV.GLBDATA.recVerType = BANCS.INPUT.RecVerifyType
PRINT(EBSRV.GLBDATA.recVerType)

IF(EBSRV.GLBDATA.recVerType == "MAIN") THEN
#{
	lv_u = " update custom.armt set entity_cre_flg = 'Y', "
	lv_u = lv_u + " lchg_time = SYSDATE, "
	lv_u = lv_u + " lchg_user_id = ?SVAR "
	lv_u = lv_u + " where bank_id=?SVAR "
        lv_u = lv_u + " and currency_code = ?SVAR "
        lv_u = lv_u + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_u = lv_u + " and deposit_type=?SVAR "
        lv_u = lv_u + " and deposit_period_mnths=?SVAR "
	lv_u = lv_u + " and del_flg <> 'Y' "
	lv_u = lv_u + " and entity_cre_flg = 'N' "
	print(lv_u)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" +  EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays  
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_r = urhk_dbSQLWithBind(lv_u)
	PRINT(lv_r)
	IF(lv_r == 0) THEN
	#{
		EBSRV.GLBDATA.resMsg = "ALCO Rate Verified Successfully for Currency " + EBSRV.GLBDATA.CrncyCode
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		EBSRV.GLBDATA.errMsg = "Verification Failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF
		
IF(EBSRV.GLBDATA.recVerType == "MOD") THEN
#{
	EBSRV.GLBDATA.boddate = LEFT$(BANCS.STDIN.BODDate,10)
	PRINT(EBSRV.GLBDATA.boddate)

	lv_a = " Insert into custom.alco_rate_hist_tbl (bank_id,currency_code,applicable_date,deposit_type,deposit_period_mnths,lower_lim,higher_lim,lower_rate,higher_rate,rcre_user_id,rcre_time,lchg_user_id,lchg_time,entiry_cre_flg,del_flg,record_source) " 
	lv_a = lv_a + "select "
	lv_a = lv_a + "bank_id,"
	lv_a = lv_a + "currency_code,"
	lv_a = lv_a + "applicable_date,"
	lv_a = lv_a + "deposit_type,"
	lv_a = lv_a + "deposit_period_mnths,"
	lv_a = lv_a + "lower_lim,"
	lv_a = lv_a + "higher_lim,"
	lv_a = lv_a + "lower_rate,"
	lv_a = lv_a + "higher_rate,"
	lv_a = lv_a + "rcre_user_id,"
	lv_a = lv_a + "rcre_time,"
	lv_a = lv_a + "lchg_user_id,"
	lv_a = lv_a + "lchg_time,"
	lv_a = lv_a + "entity_cre_flg,"
	lv_a = lv_a + "del_flg,"
	lv_a = lv_a + "record_source "
	lv_a = lv_a + " from custom.armt "
	lv_a = lv_a + " where bank_id = ?SVAR " 
	lv_a = lv_a + " and currency_code = ?SVAR "
	lv_a = lv_a + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
	lv_a = lv_a + " and deposit_type=?SVAR "
	lv_a = lv_a + " and deposit_period_mnths=?SVAR "
	PRINT(lv_a)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" + EBSRV.GLBDATA.AplliDate +"|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays    
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_a = urhk_dbSQLWithBind(lv_a)
	PRINT(lv_a)
	IF(lv_a != 0) THEN
	#{
		EBSRV.GLBDATA.errMsg = "History Table Entry Failed "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	if(EBSRV.GLBDATA.LowLim1!="")then	
	#{
	lv_a = " update custom.armt set "
	lv_a = lv_a + " lower_rate = ?SVAR, "
	lv_a = lv_a + " higher_rate = ?SVAR, "
	lv_a = lv_a + " lchg_time = SYSDATE ,"
	lv_a = lv_a + " lchg_user_id = ?SVAR "
	lv_a = lv_a + " where bank_id=?SVAR " 
	lv_a = lv_a + " and currency_code = ?SVAR "
	lv_a = lv_a + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
	lv_a = lv_a + " and deposit_type=?SVAR "
	lv_a = lv_a + " and deposit_period_mnths=?SVAR "
	if(EBSRV.GLBDATA.CrncyCode=="USD")then
		lv_a = lv_a + " and lower_lim='5000' "
		lv_a = lv_a + " and higher_lim='9999' "
	endif
	if(EBSRV.GLBDATA.CrncyCode=="KES")then
		lv_a = lv_a + " and lower_lim='50000' "
		lv_a = lv_a + " and higher_lim='999999' "
	endif
	lv_a = lv_a + " and del_flg <> 'Y' "
	lv_a = lv_a + " and entity_cre_flg = 'Y' "
	PRINT(lv_a)

	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.LowLimR1 +"|"+ EBSRV.GLBDATA.HighLimR1+"|"+ BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode +"|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_r = urhk_dbSQLWithBind(lv_a)
	PRINT(lv_r)
	#}
	ENDIF
        if(EBSRV.GLBDATA.LowLim2!="")then
        #{
        lv_a = " update custom.armt set "
        lv_a = lv_a + " lower_rate = ?SVAR, "
        lv_a = lv_a + " higher_rate = ?SVAR, "
        lv_a = lv_a + " lchg_time = SYSDATE ,"
        lv_a = lv_a + " lchg_user_id = ?SVAR "
        lv_a = lv_a + " where bank_id=?SVAR "
        lv_a = lv_a + " and currency_code = ?SVAR "
        lv_a = lv_a + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_a = lv_a + " and deposit_type=?SVAR "
