<--start
trace on
#Rep/Class
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	EQSRV.GLBDATA.hapohapoYN = ""
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
#Data
	if(fieldexists(BANCS.INPUT.funcCode)==1)then
		EQSRV.GLBDATA.funcCode = BANCS.INPUT.funcCode
	else
		EQSRV.GLBDATA.funcCode = ""
	endif
	if(fieldexists(BANCS.INPUT.NatIdNum)==1)then
		EQSRV.GLBDATA.NatIdNum = BANCS.INPUT.NatIdNum
	else
		EQSRV.GLBDATA.NatIdNum = ""
	endif
	if(fieldexists(BANCS.INPUT.FirstName)==1)then
		EQSRV.GLBDATA.FirstName = BANCS.INPUT.FirstName
	else
		EQSRV.GLBDATA.FirstName = ""
	endif
	if(fieldexists(BANCS.INPUT.LastName)==1)then
		EQSRV.GLBDATA.LastName = BANCS.INPUT.LastName
	else
		EQSRV.GLBDATA.LastName = ""
	endif
	if(fieldexists(BANCS.INPUT.MiddleName)==1)then
		EQSRV.GLBDATA.MiddleName = BANCS.INPUT.MiddleName
	else
		EQSRV.GLBDATA.MiddleName = ""
	endif
	if(fieldexists(BANCS.INPUT.MobileNum)==1)then
		EQSRV.GLBDATA.MobileNum = BANCS.INPUT.MobileNum
	else
		EQSRV.GLBDATA.MobileNum = ""
	endif
	if(fieldexists(BANCS.INPUT.AddressLine1)==1)then
		EQSRV.GLBDATA.AddressLine1 = BANCS.INPUT.AddressLine1
	else
		EQSRV.GLBDATA.AddressLine1 = ""
	endif
	if(fieldexists(BANCS.INPUT.AddressLine2)==1)then
		EQSRV.GLBDATA.AddressLine2 = BANCS.INPUT.AddressLine2
	else
		EQSRV.GLBDATA.AddressLine2 = ""
	endif
	if(fieldexists(BANCS.INPUT.EmailId)==1)then
		EQSRV.GLBDATA.EmailId = BANCS.INPUT.EmailId
	else
		EQSRV.GLBDATA.EmailId = ""
	endif
	if(fieldexists(BANCS.INPUT.Occupation)==1)then
		EQSRV.GLBDATA.Occupation = BANCS.INPUT.Occupation
	else
		EQSRV.GLBDATA.Occupation = ""
	endif
	if(fieldexists(BANCS.INPUT.CurrencyC)==1)then
		EQSRV.GLBDATA.CurrencyC = BANCS.INPUT.CurrencyC
	else
		EQSRV.GLBDATA.CurrencyC = ""
	endif
	if(fieldexists(BANCS.INPUT.KraPin)==1)then
		EQSRV.GLBDATA.KraPin = BANCS.INPUT.KraPin
	else
		EQSRV.GLBDATA.KraPin = ""
	endif
	sv_d = "natId,revYN,recUser | select national_id,entity_cre_flg,rcre_user_id from custom.obmt "
	sv_d = sv_d + " where bank_id=?SVAR "
	sv_d = sv_d + " and national_id =?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.NatIdNum 
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u =urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.natId = BANCS.OUTPARAM.natId
		EQSRV.GLBDATA.revYN = BANCS.OUTPARAM.revYN
		EQSRV.GLBDATA.recUser = BANCS.OUTPARAM.recUser
	else
		EQSRV.GLBDATA.natId = ""
		EQSRV.GLBDATA.revYN = ""
		EQSRV.GLBDATA.recUser= ""
	endif
	print(EQSRV.GLBDATA.natId)
	print(EQSRV.GLBDATA.NatIdNum)
	print(EQSRV.GLBDATA.revYN)
	print(EQSRV.GLBDATA.recUser)
	if((EQSRV.GLBDATA.funcCode=="O") and (EQSRV.GLBDATA.natId==EQSRV.GLBDATA.NatIdNum) and (EQSRV.GLBDATA.revYN=="N"))then
		EQSRV.GLBDATA.errMsg = "National Id Exist Already and Unverified "
                sv_e = EQSRV.GLBDATA.errMsg
                sv_m = "NatIdNum"
                sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
                sv_u = urhk_SetOrbOut(sv_s)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		exitscript
	endif
	if((EQSRV.GLBDATA.funcCode=="O") and (EQSRV.GLBDATA.natId==EQSRV.GLBDATA.NatIdNum) and (EQSRV.GLBDATA.revYN=="Y"))then
	##	EQSRV.GLBDATA.errMsg = "National Id Exist Already and Verified "
        ##      sv_e = EQSRV.GLBDATA.errMsg
        ##      sv_m = "NatIdNum"
        ##      sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
        ##      sv_u = urhk_SetOrbOut(sv_s)
        ##      sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
	##	exitscript
	endif
        if((EQSRV.GLBDATA.funcCode=="V") and (EQSRV.GLBDATA.natId==EQSRV.GLBDATA.NatIdNum) and (EQSRV.GLBDATA.revYN=="Y"))then
                EQSRV.GLBDATA.errMsg = "National Id Exist Already and Verified "
                sv_e = EQSRV.GLBDATA.errMsg
                sv_m = "NatIdNum"
                sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
                sv_u = urhk_SetOrbOut(sv_s)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		exitscript
        endif
        if((EQSRV.GLBDATA.funcCode=="V") and (EQSRV.GLBDATA.natId==EQSRV.GLBDATA.NatIdNum) and (EQSRV.GLBDATA.revYN=="N"))then
		if(BANCS.STDIN.userId==EQSRV.GLBDATA.recUser)then
                EQSRV.GLBDATA.errMsg = "Same User Verification Not Allowed"
                sv_e = EQSRV.GLBDATA.errMsg
                sv_m = "NatIdNum"
                sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
                sv_u = urhk_SetOrbOut(sv_s)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		exitscript
		endif
		if(BANCS.STDIN.userId!=EQSRV.GLBDATA.recUser)then
			sv_d = "exCif,exCifSt|select accounts.orgkey,accounts.recordstatus from crmuser.accounts "
			sv_d = sv_d + " where bank_id=?SVAR and nat_id_card_num=?SVAR and rownum<=1 "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.NatIdNum
			print(sv_d)
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EQSRV.GLBDATA.exCif = BANCS.OUTPARAM.exCif
				EQSRV.GLBDATA.exCifSt = BANCS.OUTPARAM.exCifSt
			else
				EQSRV.GLBDATA.exCif = ""
				EQSRV.GLBDATA.exCifSt = ""
			endif
			if((EQSRV.GLBDATA.exCif!="") and (EQSRV.GLBDATA.NatIdNum!=""))then
				sv_d = "recCifCnt,recSbAcct,recSbacid | select count(cif_id),foracid,acid "
				sv_d = sv_d + " from tbaadm.gam where bank_id=?SVAR "
				sv_d = sv_d + " and cif_id=?SVAR "
				sv_d = sv_d + " and entity_cre_flg='Y' "
				sv_d = sv_d + " and del_flg='N' "
				###sv_d = sv_d + " and schm_code='SB777' "
				sv_d = sv_d + " and schm_type not in ('LAA','TDA','TUA') "
				sv_d = sv_d + " and acct_cls_flg<>'Y' "
				sv_d = sv_d + " and rownum<=1 "
				sv_d = sv_d + " group by cif_id,foracid,acid "
				print(sv_d)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.exCif
				print(BANCS.INPARAM.BINDVARS)
				sv_u = urhk_dbSelectWithBind(sv_d)
				if(sv_u==0)then
					EQSRV.GLBDATA.recCifCnt = BANCS.OUTPARAM.recCifCnt
					EQSRV.GLBDATA.recSbAcct = BANCS.OUTPARAM.recSbAcct
					EQSRV.GLBDATA.recSbacid = BANCS.OUTPARAM.recSbacid
				else
					EQSRV.GLBDATA.recCifCnt = ""
					EQSRV.GLBDATA.recSbAcct = ""
					EQSRV.GLBDATA.recSbacid = ""
				endif
			else
				EQSRV.GLBDATA.recCifCnt = ""
				EQSRV.GLBDATA.recSbAcct = ""
				EQSRV.GLBDATA.recSbacid = ""
			endif
			if((EQSRV.GLBDATA.exCif!="") and (cdouble(EQSRV.GLBDATA.recCifCnt)>=1) and (EQSRV.GLBDATA.NatIdNum!=""))then
				BANCS.INPARAM.acid = EQSRV.GLBDATA.recSbacid
				sv_u = urhk_getAcctStatus("")
				print(sv_u)
				if(sv_u == 0)then
					EQSRV.GLBDATA.acctStst = BANCS.OUTPARAM.acctStatus
				else
					EQSRV.GLBDATA.acctStst = ""
				endif
				EQSRV.GLBDATA.hapohapoYN = "N"
				sv_m = "Hapo Hapo Account Already Exists AccountId: " + EQSRV.GLBDATA.recSbAcct + " Status: " + EQSRV.GLBDATA.acctStst + " NationalId: " + EQSRV.GLBDATA.NatIdNum + " CifId : " + EQSRV.GLBDATA.exCif 
				sv_d = urhk_SetOrbOut("RESULT_MSG|"+sv_m)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
				exitscript
			else
				if(EQSRV.GLBDATA.exCif!="")then
				EQSRV.GLBDATA.hapohapoYN = "Y"
				callscriptifexist("ebchapoProcessAV.scr")
				if(fieldexists(EQSRV.GLBDATA.scrValYN)==1)then
					print(EQSRV.GLBDATA.scrValYN)
				endif
				if(fieldexists(EQSRV.GLBDATA.valerr)==1)then
					print(EQSRV.GLBDATA.valerr)
				endif
				endif
			endif
			if(EQSRV.GLBDATA.hapohapoYN=="")then
				callscriptifexist("ebchapoProcessC.scr")
			endif
			if(fieldexists(EQSRV.GLBDATA.scrValYN)==1)then
				print(EQSRV.GLBDATA.scrValYN)
			endif
			if(fieldexists(EQSRV.GLBDATA.valerr)==1)then
				print(EQSRV.GLBDATA.valerr)
			endif
			if(EQSRV.GLBDATA.scrValYN!="Y")then
				EQSRV.GLBDATA.errMsg = EQSRV.GLBDATA.valerr
				sv_e = EQSRV.GLBDATA.errMsg
				sv_m = "NatIdNum"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				exitscript
			endif
			if(EQSRV.GLBDATA.scrValYN=="Y")then
				sv_m = EQSRV.GLBDATA.valerr 
				sv_d = urhk_SetOrbOut("RESULT_MSG|"+sv_m)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_e = "nohup babx4061 $B2K_SESSION_ID  ebchapoProcessMsg.scr " +'"'+EQSRV.GLBDATA.MobileNum +'"'+ " " +'"'+ EQSRV.GLBDATA.valerr + '"' + " @s &"
				sv_a = system(sv_e)
				sv_d = "update custom.obmt set entity_cre_flg='Y' ,iprs_checkyn='Y',free_text2=?SVAR, "
				sv_d = sv_d + " lchg_user_id=?SVAR,lchg_time=sysdate "
				sv_d = sv_d + " where bank_id=?SVAR and module_id='CU-HAPO' "
				sv_d = sv_d + " and national_id=?SVAR "
				BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.valerr + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.NatIdNum
				print(sv_d)
				print(BANCS.INPARAM.BINDVARS)
				sv_u = urhk_dbSqlWithBind(sv_d)
				if(sv_u==0)then
					sv_u = urhk_dbSqlWithBind("commit")
					if(EQSRV.GLBDATA.hapohapoYN=="")then
					sv_d = "update crmuser.accounts set cust_swift_code_desc=?SVAR where bank_id=?SVAR "
					sv_d = sv_d + " and orgkey=?SVAR " 
					BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.KraPin + "|" + BANCS.STDIN.contextBankId + "|" +EQSRV.GLBDATA.CifId 
					print(sv_d)
					print(BANCS.INPARAM.BINDVARS)
					sv_u =urhk_dbSqlWithBind(sv_d)
					if(sv_u==0)then
						sv_u = urhk_dbSqlWithBind("commit")
					endif 
					endif
				endif
				exitscript
			endif
		endif
	endif
        if((EQSRV.GLBDATA.funcCode=="V") and (EQSRV.GLBDATA.natId==EQSRV.GLBDATA.NatIdNum) and (EQSRV.GLBDATA.revYN=="Y"))then
                EQSRV.GLBDATA.errMsg = "No Verification Record Exists"
                sv_e = EQSRV.GLBDATA.errMsg
                sv_m = "NatIdNum"
                sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
                sv_u = urhk_SetOrbOut(sv_s)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		exitscript
        endif
	if(EQSRV.GLBDATA.funcCode=="O")then
	#{
	sv_d = "exCif,exCifSt|select accounts.orgkey,accounts.recordstatus from crmuser.accounts "
	sv_d = sv_d + " where bank_id=?SVAR and nat_id_card_num=?SVAR and rownum<=1 "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.NatIdNum
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.exCif = BANCS.OUTPARAM.exCif
		EQSRV.GLBDATA.exCifSt = BANCS.OUTPARAM.exCifSt
		EQSRV.GLBDATA.hapohapoYN = "Y"
	else
		EQSRV.GLBDATA.exCif = ""
		EQSRV.GLBDATA.exCifSt = ""
		EQSRV.GLBDATA.hapohapoYN = "N"
	endif
	if((EQSRV.GLBDATA.exCif!="") and (EQSRV.GLBDATA.NatIdNum!=""))then
		sv_d = "recCifCnt,recSbAcct,recSbacid | select count(cif_id),foracid,acid "
		sv_d = sv_d + " from tbaadm.gam where bank_id=?SVAR "
		sv_d = sv_d + " and cif_id=?SVAR "
		sv_d = sv_d + " and entity_cre_flg='Y' "
		sv_d = sv_d + " and del_flg='N' "
		###sv_d = sv_d + " and schm_code='SB777' "
		sv_d = sv_d + " and schm_type not in ('LAA','TDA','TUA') "
		sv_d = sv_d + " and acct_cls_flg<>'Y' "
		sv_d = sv_d + " and rownum<=1 "
		sv_d = sv_d + " group by cif_id,foracid,acid "	
		print(sv_d)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.exCif
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQSRV.GLBDATA.recCifCnt = BANCS.OUTPARAM.recCifCnt
			EQSRV.GLBDATA.recSbAcct = BANCS.OUTPARAM.recSbAcct
			EQSRV.GLBDATA.recSbacid = BANCS.OUTPARAM.recSbacid
		else
			EQSRV.GLBDATA.recCifCnt = ""
			EQSRV.GLBDATA.recSbAcct = ""
			EQSRV.GLBDATA.recSbacid = ""
		endif
		EQSRV.GLBDATA.hapohapoYN = "Y"
	else
		EQSRV.GLBDATA.recCifCnt = ""
		EQSRV.GLBDATA.recSbAcct = ""
		EQSRV.GLBDATA.recSbacid = ""
		EQSRV.GLBDATA.hapohapoYN = "N"
	endif
	if(EQSRV.GLBDATA.recSbacid!="")then
		BANCS.INPARAM.acid = EQSRV.GLBDATA.recSbacid 
		sv_u = urhk_getAcctStatus("")
		print(sv_u)
		if(sv_u == 0)then
			EQSRV.GLBDATA.acctStst = BANCS.OUTPARAM.acctStatus
		else
			EQSRV.GLBDATA.acctStst = ""
		endif
		EQSRV.GLBDATA.hapohapoYN = "Y"
	else
		EQSRV.GLBDATA.acctStst = ""
		EQSRV.GLBDATA.hapohapoYN = "N"
	endif
	if(EQSRV.GLBDATA.acctStst!="")then
                sv_m = "Hapo Hapo Account Already Exists AccountId: " + EQSRV.GLBDATA.recSbAcct + " Status: " + EQSRV.GLBDATA.acctStst + " NationalId: " + EQSRV.GLBDATA.NatIdNum + " CifId : " + EQSRV.GLBDATA.exCif  
                sv_d = urhk_SetOrbOut("RESULT_MSG|"+sv_m)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		exitscript
	else
		EQSRV.GLBDATA.hapohapoYN = "N"
	endif
	sv_d = "Insert into  custom.obmt (bank_id,module_id,module_desc,national_id,first_name,last_name,middle_name,mobile_number,address_line1,address_line2,mail_id,occupation,currency_code,karpin_code,rcre_user_id,rcre_time,lchg_user_id,lchg_time,entity_cre_flg,del_flg,iprs_checkyn,core_cif_id,is_cif_verify,is_ccfm_yn,free_text1,free_text2,free_text3,free_text4,free_text5,free_text6,free_text7,free_text8,free_text9,free_text10,free_text11,free_text12,free_text13,free_text14,free_text15) "
	sv_d = sv_d + "values (?SVAR,'CU-HAPO','Customer Onboard Hapo Hapo',?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,sysdate,?SVAR,sysdate,'N','N',null,null,null,null,?SVAR,null,null,null,null,null,null,null,null,null,null,null,null,null,null) "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.NatIdNum + "|" + EQSRV.GLBDATA.FirstName + "|" + EQSRV.GLBDATA.LastName + "|" + EQSRV.GLBDATA.MiddleName + "|" + EQSRV.GLBDATA.MobileNum + "|" + EQSRV.GLBDATA.AddressLine1 + "|" + EQSRV.GLBDATA.AddressLine2 + "|" + EQSRV.GLBDATA.EmailId + "|" + EQSRV.GLBDATA.Occupation + "|" + EQSRV.GLBDATA.CurrencyC + "|" + EQSRV.GLBDATA.KraPin + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.mySolId
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSqlWithBind(sv_d)
	print(sv_u)
	if(sv_u==0)then
		sv_u = urhk_dbSqlWithBind("commit")
		print(sv_u)
		if(EQSRV.GLBDATA.hapohapoYN=="N")then
                sv_e = "nohup babx4061 $B2K_SESSION_ID  ebchapoIpChk.scr " + EQSRV.GLBDATA.NatIdNum + " @s &"
                sv_a = system(sv_e)
		endif
                sv_m = "Customer Registered for Onboarding Successfully Please Verify" 
                sv_d = urhk_SetOrbOut("RESULT_MSG|"+sv_m)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	endif
	#}
	endif
trace off
end-->
