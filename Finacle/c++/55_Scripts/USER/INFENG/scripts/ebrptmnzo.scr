<--start
trace on
	if (REPEXISTS("EBRPT") == 0) then
		CREATEREP("EBRPT")
	endif
	if (CLASSEXISTS("EBRPT", "DATA") == 0) then
		CREATECLASS("EBRPT", "DATA", 5)
	endif
	EBRPT.DATA.RptModule		= BANCS.INPUT.RptModule
	print(EBRPT.DATA.RptModule)
	EBRPT.DATA.counter = "0"
	EBRPT.DATA.rptDiv             = BANCS.INPUT.rptDiv
	print(EBRPT.DATA.rptDiv)
	sv_a = "reportcode,reportdesc,inputfile|select report_code,report_desc,rfp_number "
	sv_a = sv_a + "from custom.c_ebrpt "
	#sv_a = sv_a + "where report_module ='"+ EBRPT.DATA.RptModule +"' "
	sv_a = sv_a + "where report_division ='"+ EBRPT.DATA.rptDiv +"' order by report_code "
	print (sv_a)
	sv_a =  urhk_dbCursorOpenWithBind(sv_a)
	print (sv_a)
	if (sv_a != 0) then
		exitscript
	endif
	if (sv_a == 0) then
		EBRPT.DATA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print (EBRPT.DATA.cursorNum)
		sv_r = urhk_dbCursorFetch(EBRPT.DATA.cursorNum)
		print (sv_r)
		if (sv_r == 0) then
			while (sv_r == 0)
				EBRPT.DATA.counter = CINT(EBRPT.DATA.counter) + 1
				EBRPT.DATA.reportcode = BANCS.OUTPARAM.reportcode
				print(EBRPT.DATA.reportcode)
				EBRPT.DATA.inputfile = BANCS.OUTPARAM.inputfile
				print(EBRPT.DATA.inputfile)
				EBRPT.DATA.reportdesc = BANCS.OUTPARAM.reportdesc
				print(EBRPT.DATA.reportdesc)
				
				sv_u    =   urhk_SetOrbOut("recCount|" + EBRPT.DATA.counter)
				print(sv_u)
				sv_z    = "idreportcode_" + EBRPT.DATA.counter + "|" + EBRPT.DATA.reportcode
				print(sv_z)
				sv_y    =   urhk_SetOrbOut(sv_z)
				sv_z    = "idinputfile_" + EBRPT.DATA.counter + "|" + EBRPT.DATA.inputfile
				print(sv_z)
				sv_y    =   urhk_SetOrbOut(sv_z)
				sv_z    = "idreportdesc_" + EBRPT.DATA.counter + "|" + EBRPT.DATA.reportdesc
				print(sv_z)
				sv_y    =   urhk_SetOrbOut(sv_z)
				
				print(EBRPT.DATA.cursorNum)
				sv_r = urhk_dbCursorFetch(EBRPT.DATA.cursorNum)
			do
		else
			print("No records fetched")
		endif
		
		print(EBRPT.DATA.cursorNum)
		sv_r = urhk_dbCursorClose(EBRPT.DATA.cursorNum)
	endif
	exitscript
	trace off
end-->
