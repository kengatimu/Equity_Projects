#------------------------------------------------------------------------------------------------
#  Name            : ebCubpEdUp.scr
#  Description     : cubp ED Update
#  Date            : 15-12-2019
#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             15-12-2019      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
        libname CUSTOMSO
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0) then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_u = urhk_B2k_PrintRepos("BANCS")
        print(sv_u)
        sv_s = "refNum,drName|SELECT CONCAT(CONCAT('EQED',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))),"
	sv_s = sv_s + " replace(?SVAR,' ', '/')FROM DUAL"
	BANCS.INPARAM.BINDVARS=CUST.UBP.tranRem 
        sv_d = urhk_dbSelectWithBind(sv_s)
        if(sv_d == 0)then
                EQSRV.GLBDATA.refNum = BANCS.OUTPARAM.refNum
                print(EQSRV.GLBDATA.refNum)
		EQSRV.GLBDATA.drName = BANCS.OUTPARAM.drName
		
        endif
        EQSRV.GLBDATA.edResp = EQSRV.GLBDATA.refNum + ".dat"
	EQSRV.GLBDATA.acctNum = CUST.UBP.billAcctId
	#EQSRV.GLBDATA.acctName = "201004"
	EQSRV.GLBDATA.acctName = CUST.UBP.billerCode
	EQSRV.GLBDATA.bankCode = "068" 
	EQSRV.GLBDATA.billamt = CUST.UBP.billAmt 
	EQSRV.GLBDATA.billno = CUST.UBP.billRefNum
	EQSRV.GLBDATA.branchCode = "1000" 
	EQSRV.GLBDATA.Channel = "COR" 
	EQSRV.GLBDATA.CountryCode = "XX" 
	#EQSRV.GLBDATA.DrAcctId = CUST.UBP.dbForacid
	EQSRV.GLBDATA.DrAcctId = "XXXX"
	EQSRV.GLBDATA.DrCustName = EQSRV.GLBDATA.drName 
	#EQSRV.GLBDATA.DrCustName = "XXXXX"
	EQSRV.GLBDATA.TranDate = mid$(CUST.UBP.tranDate,0,10) 
	EQSRV.GLBDATA.TranId = trim(CUST.UBP.tranId)
	EQSRV.GLBDATA.Remarks = "BillPayment" 
	EQSRV.GLBDATA.rrnNum = trim(CUST.UBP.tranId)
	#EQSRV.GLBDATA.ServiceName = "201004"
	EQSRV.GLBDATA.ServiceName = CUST.UBP.billerCode
	#EQSRV.GLBDATA.TranCrncy = "UGX" 
	EQSRV.GLBDATA.TranCrncy = CUST.UBP.refCrncy
	EQSRV.GLBDATA.partTranType = "Otherbill" 
	EQSRV.GLBDATA.phoneNum = "XXXXXXXXXXXX" 
	##EQSRV.GLBDATA.EdUrl = "http://10.11.6.110:7003/edmqservice/payments/ws/v1" 
	##EQSRV.GLBDATA.EdUrl = "http://pgwprodcore.ebsafrica.com:80/edmqservice/payments/ws/v1"
	#EQSRV.GLBDATA.EdUrl = "http://10.9.64.92:8080/ws/notification"
	EQSRV.GLBDATA.EdUrl = "http://10.9.96.47:8080/ws/notification"
	if((EQSRV.GLBDATA.TranId!="") and (EQSRV.GLBDATA.TranDate!=""))then
		sv_s = "dtdCnt | select count(*) from tbaadm.dtd where tran_id = lpad(?SVAR,9,' ') "
		sv_s = sv_s + " and bank_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR') and pstd_flg='Y' "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.TranId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.TranDate
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u==0)then
			EQSRV.GLBDATA.dtdCnt = BANCS.OUTPARAM.dtdCnt
		else
			EQSRV.GLBDATA.dtdCnt = 0
		endif
	endif
	if(cdouble(EQSRV.GLBDATA.dtdCnt)<=0)then
			goto VAYU
	endif
	EQSRV.GLBDATA.jInp = EQSRV.GLBDATA.acctNum + " " + EQSRV.GLBDATA.acctName + " " + EQSRV.GLBDATA.bankCode + " " + EQSRV.GLBDATA.billamt + " " + EQSRV.GLBDATA.billno + " " + EQSRV.GLBDATA.branchCode + " " + EQSRV.GLBDATA.Channel + " " + EQSRV.GLBDATA.CountryCode + " " + EQSRV.GLBDATA.DrAcctId + " " + EQSRV.GLBDATA.DrCustName + " " + EQSRV.GLBDATA.TranDate + " " + EQSRV.GLBDATA.TranId + " " + EQSRV.GLBDATA.Remarks + " " + EQSRV.GLBDATA.rrnNum + " " + EQSRV.GLBDATA.ServiceName + " " + EQSRV.GLBDATA.TranCrncy + " " + EQSRV.GLBDATA.partTranType + " " + EQSRV.GLBDATA.phoneNum + " " + EQSRV.GLBDATA.EdUrl
        print(EQSRV.GLBDATA.jInp)
        ###sv_r=system("java -cp /finacle/EQPPROD/Fin10218/APP/Finacle/FC/app/cust/INFENG com.cubpEquityDirect.cubpUp.cubpEdUp "+ EQSRV.GLBDATA.jInp + " >> " +EQSRV.GLBDATA.edResp )
	##sv_r=system("java -cp /finacle/EQDR/Fin10218/APP/Finacle/FC/app/cust/INFENG com.cubpEquityDirect.cubpUp.cubpEdUp "+ EQSRV.GLBDATA.jInp + " >> " +EQSRV.GLBDATA.edResp )
	sv_r=system("java -cp /finacle/EQPROD/BackEnd/Finacle/FC/app/cust/INFENG com.cubpEquityDirect.cubpUp.cubpEdUp "+ EQSRV.GLBDATA.jInp + " >> " +EQSRV.GLBDATA.edResp )  
        print(sv_r)
        sv_a = urhk_getEnv("ONS_LOG_DIR")
        print(BANCS.OUTPARAM.envValue)
        print(sv_a)
        if(sv_a == 1)then
                print("Env variable ONS/log not found")
		goto VAYU
        endif
VAYU:
	exitscript
trace off
end-->

