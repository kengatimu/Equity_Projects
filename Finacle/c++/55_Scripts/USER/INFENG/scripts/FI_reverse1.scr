		CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</AcctId>"
		CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<CreditDebitFlg>D</CreditDebitFlg>"
		CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnAmt>"
