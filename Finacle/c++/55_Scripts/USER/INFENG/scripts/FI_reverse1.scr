	sv_s = sv_s + " and tran_date = TO_DATE ('" + CUST.DATA.Date + "','DD-MM-YYYY') and tran_id = '" + CUST.DATA.TranId + "' "
	sv_s = sv_s + " and htd.bank_id = '" + CUST.DATA.BankId + "' and part_tran_type = 'C' "
	print(sv_s)
#}
ENDIF

print(sv_s)

	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
