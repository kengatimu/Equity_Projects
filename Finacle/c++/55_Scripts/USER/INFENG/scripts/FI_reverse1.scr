CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<XferTrnDetail>"


IF (CUST.DATA.boddate == CUST.DATA.Date ) THEN
#{
	sv_s = ""
	sv_s = sv_s + " drAcctID,tranAmtDr| select foracid,tran_amt "
