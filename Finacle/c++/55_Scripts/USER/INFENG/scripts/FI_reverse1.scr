<--start
trace on

sv_s = ""
		sv_s = sv_s + "time |"
		sv_s = sv_s + " select to_char(sysdate,'hh24.mi.ss') from dual  "
		sv_d=urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			CUST.DATA.errMsg 	= "error in fetching time"
			sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.DATA.time= BANCS.OUTPARAM.time
			print(CUST.DATA.time)
		#}
		ENDIF
		
		
sv_s = ""
sv_s = sv_s + "RequestID1|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0)THEN
#{
        CUST.DATA.RequestID1 = BANCS.OUTPARAM.RequestID1
        print(CUST.DATA.RequestID1)
#}
ELSE
#{
        CUST.DATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
        print(CUST.DATA.RequestID1)
#}
ENDIF

CUST.DATA.RequestID1=CUST.DATA.RequestID1

#CUST.DATA.tranParticular = CUST.DATA.Service + "/REVERSE/" +CUST.DATA.RefNum
CUST.DATA.tranParticular= "REV/" + CUST.DATA.Service + "/" + CUST.DATA.PhoneNum + "/" + CUST.DATA.RefNum + "/" + CUST.DATA.time
CUST.DATA.tranParticular = mid$(CUST.DATA.tranParticular,0,50)
CUST.DATA.rmks = "REVERSAL"
print(CUST.DATA.tranParticular)
CUST.DATA.rateCode = ""
CUST.DATA.crRate = "1.00"
CUST.DATA.drRate = "1.00"
CUST.DATA.tranCcy = "KES"
CUST.DATA.interfaceRequestID = "XferTrnAdd"
CUST.DATA.interfaceRequestVersion = "10.2"
CUST.DATA.channelID = "COR"
CUST.DATA.tranType = "T"
CUST.DATA.tranSubType = "CI"
print(CUST.DATA.BankId)

#-------------------------------------------------------------------------
# Fetch the current data time to send in request header
#-------------------------------------------------------------------------
sv_s = ""
sv_s = sv_s + "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
	CUST.DATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
	print(CUST.DATA.msgDateTime)
#}
ENDIF
#-------------------------------------------------------------------------
#- Forming the Header for XferTrnAdd
#-------------------------------------------------------------------------
CUST.DATA.headerXML = ""
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Header>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestHeader>"
