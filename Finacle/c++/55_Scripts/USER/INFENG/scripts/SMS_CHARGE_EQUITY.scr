<--START
#TRACE ON

	IF ((REPEXISTS("CUST")) == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF((CLASSEXISTS("CUST","DATA")) == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF

	CUST.DATA.DATA_INSERT_FLG="N"

	print(CUST.DATA.tranType)
	print(CUST.DATA.tranSubType)
	print(CUST.DATA.DebitAccount)
	print(CUST.DATA.EventId)
	print(CUST.DATA.chrgAmt)
	print(CUST.DATA.ChrgCrncy)
	print(CUST.DATA.OrgTranId)
	print(CUST.DATA.OrgTranDate)
	print(CUST.DATA.Narration)


	sv_a  = urhk_GetChannelInfo("")
	print(sv_a)
	print(BANCS.OUTPARAM.DccId)

	IF(BANCS.OUTPARAM.DccId!="")THEN
	#{
		CUST.DATA.DccId = BANCS.OUTPARAM.DccId
		print(CUST.DATA.DccId)
	ELSE
		CUST.DATA.DccId = "COR" 
		print(CUST.DATA.DccId)
	#}
	ENDIF

        IF(CUST.DATA.Insufficient_flg=="Y")THEN
        #{
                CUST.DATA.MASSAGE = "Insufficient Fund to Collect Charges" 
                print(CUST.DATA.MASSAGE)
        ELSE
                CUST.DATA.MASSAGE = ""
                print(CUST.DATA.MASSAGE)
        #}
        ENDIF


	sv_a = ""
	sv_a = sv_a + " INSERT INTO CUSTOM.SMS_CHARGE_TBL "
	sv_a = sv_a + " (SRLNUM,"
	sv_a = sv_a + " DCC_ID,"
	sv_a = sv_a + " BANK_ID,"
	sv_a = sv_a + " TRANTYPE,"
	sv_a = sv_a + " TRANSUBTYPE,"
	sv_a = sv_a + " DEBITACCOUNT,"
	sv_a = sv_a + " EVENTID,"
	sv_a = sv_a + " CHRGAMT,"
	sv_a = sv_a + " CHRGCRNCY,"
	sv_a = sv_a + " ORGTRANID,"
	sv_a = sv_a + " ORGTRANDATE,"
	sv_a = sv_a + " NARRATION,"
	sv_a = sv_a + " RCRE_TIME,"
	sv_a = sv_a + " LCHG_TIME,"
	sv_a = sv_a + " MASSAGE, "
	sv_a = sv_a + " STATUS_FLG)"
	sv_a = sv_a + " VALUES (CUSTOM.SMS_CHARGE_SEQ.nextval,"
	sv_a = sv_a + " '"+CUST.DATA.DccId+"',"
	sv_a = sv_a + " '"+BANCS.STDIN.contextBankId+"',"
	sv_a = sv_a + " '"+CUST.DATA.tranType+"', "
	sv_a = sv_a + " '"+CUST.DATA.tranSubType+"',"
	sv_a = sv_a + " '"+CUST.DATA.DebitAccount+"',"
	sv_a = sv_a + " '"+CUST.DATA.EventId+"',"
	sv_a = sv_a + " '"+CUST.DATA.chrgAmt+"',"
	sv_a = sv_a + " '"+CUST.DATA.ChrgCrncy+"',"
	sv_a = sv_a + " '"+CUST.DATA.OrgTranId+"',"
	sv_a = sv_a + " TO_DATE ('"+CUST.DATA.OrgTranDate+"','DD-MM-YY'),"
	sv_a = sv_a + " ?SVAR, "
	sv_a = sv_a + " sysdate,"
	sv_a = sv_a + " sysdate,"
	sv_a = sv_a + " '"+CUST.DATA.MASSAGE+"',"
	sv_a = sv_a + " 'N')"

	BANCS.INPARAM.BINDVARS = CUST.DATA.Narration 

	sv_d = urhk_dbSQLWithBind(sv_a)

	IF (sv_d == 0) THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		PRINT(sv_d)
		CUST.DATA.DATA_INSERT_FLG="Y"
	ELSE
		sv_d = urhk_dbSQLWithBind("ROLLBACK")
		PRINT(sv_d)
		CUST.DATA.DATA_INSERT_FLG="N"
		
	#}
	ENDIF
	PRINT(CUST.DATA.DATA_INSERT_FLG)

END-->


