<--start
trace on

CALL("Common_Interface_CreateRepos.scr")


sv_s = "UPDATE CUSTOM.INT_CHANGE   SET ENTITY_CRE_FLG = 'OK' WHERE  bank_id = ?SVAR and ENTITY_CRE_FLG = 'OK5' "
print(sv_s)
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSQLWithBind(sv_s)
IF (sv_d == 0) THEN
	sv_c = urhk_dbSQLWithBind("commit")
	print(sv_c)
ENDIF



sv_s = "UPDATE CUSTOM.INT_CHANGE   SET ENTITY_CRE_FLG = 'OK5' WHERE  bank_id = ?SVAR and ENTITY_CRE_FLG = 'OK' and rownum < 5000 "
print(sv_s)
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSQLWithBind(sv_s)
IF (sv_d == 0) THEN
	sv_c = urhk_dbSQLWithBind("commit")
	print(sv_c)
ENDIF


sv_s=" CIF_ID, PHN, COMMPH1 ,PhnTypex |"
sv_s = sv_s + " select foracid , '1' , FREE_TEXT1, FREE_TEXT2  "
sv_s = sv_s + " from CUSTOM.INT_CHANGE a, crmuser.accounts c   "
sv_s = sv_s + "  WHERE a.BANK_ID = ?SVAR and orgkey = foracid and  A.ENTITY_CRE_FLG = 'OK5'  " 
sv_s = sv_s + " and (length (FREE_TEXT1 ) = 12 and substr(FREE_TEXT1,0,3) =254)  and  CORP_ID is null  "
print(sv_s)
