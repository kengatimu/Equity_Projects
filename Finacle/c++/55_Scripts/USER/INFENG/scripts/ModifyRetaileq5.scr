								#CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailtType>CAT200009</PhoneEmailtType>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneNumCountryCode>" + CUST.INTERFACE.PHONEPRE + "</PhoneNumCountryCode>"					
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneNumLocalCode>" + CUST.INTERFACE.PHONESUF + "</PhoneNumLocalCode>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PrefFlag>" + CUST.INTERFACE.PREFERREDFLAGCOMMPH1 + "</PrefFlag>"					
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PhoneEmailModData>"

							ELSE
								Print (CUST.INTERFACE.COMMPH1)
								CUST.INTERFACE.PHONEPRE = MID$(CUST.INTERFACE.COMMPH1,0,3)
								PRINT  (CUST.INTERFACE.PHONEPRE)
								CUST.INTERFACE.PHONESUF = MID$(CUST.INTERFACE.COMMPH1,3,14)
								PRINT (CUST.INTERFACE.PHONESUF)

								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailModData>"                                                          
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailTypeModData>"                                                      
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<HiddenCustId>" + CUST.INTERFACE.CIF + "</HiddenCustId>"                      
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustAttributeId>ADD</CustAttributeId>"                                    
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PhoneEmailTypeModData>"                                                     
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneOrEmail>PHONE</PhoneOrEmail>"                                         
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailtType>" + CUST.INTERFACE.PhnTypex + "</PhoneEmailtType>"
								#CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailtType>CAT200009</PhoneEmailtType>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneNumCountryCode>" + CUST.INTERFACE.PHONEPRE + "</PhoneNumCountryCode>"					
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneNumLocalCode>" + CUST.INTERFACE.PHONESUF + "</PhoneNumLocalCode>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PrefFlag>" + CUST.INTERFACE.PREFERREDFLAGCOMMPH1 + "</PrefFlag>"					
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PhoneEmailModData>"






							ENDIF
							
						ENDIF

						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CustModData>"							
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustModMainData>"
					
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustModRq>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustModRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Body>"
		
		#-------------------------------------------------------------------------
		#Appending the header XML and body XML.
		#-------------------------------------------------------------------------
		CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML 
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"

		#-------------------------------------------------------------------------------
		# Setting input values for urhk_ConnectToFIAndSendMsg userhook
		#-------------------------------------------------------------------------------
		BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
		print(BANCS.INPARAM.SERVICE_NAME)
		BANCS.INPARAM.SEND_RECV_FLG             = "R"
		sv_a = CUST.INTERFACE.reqXMLMsg
		PRINT(sv_a)

		#-------------------------------------------------------------------------
		#- Executing the userhook to make the Outbound Call
		#-------------------------------------------------------------------------
		sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
		print(sv_l)
		IF (sv_l != 0) THEN
		#{
			print(BANCS.OUTPARAM.ErrMsg)
			CUST.INTERFACE.errorMsgFlg = "Y"
			CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
			CUST.INTERFACE.errorMsgCode = "FIERR"  
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF (BANCS.OUTPARAM.ErrMsg != "") THEN
		#{
			CUST.INTERFACE.errorMsgFlg = "Y"
			CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
			CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg 
			CUST.INTERFACE.errorMsgCode = "FIERR" 
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
			print(CUST.INTERFACE.respXMLMsg)
			CUST.INTERFACE.errorMsgFlg = ""
			CUST.INTERFACE.errorMsgDesc = ""
			
			CUST.INTERFACE.opndate = ""
			CUST.INTERFACE.cifid = ""
			CUST.INTERFACE.errorCode = ""
			CUST.INTERFACE.errorDesc = ""
			sv_x = CUST.INTERFACE.respXMLMsg

			#--------------------------------------------------------------------------------------------------------
			# Fetching the status of the request
			#--------------------------------------------------------------------------------------------------------
			sv_y = "<Status>"
			sv_z = "</Status>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
			#}
			ELSE
			#{
				CUST.INTERFACE.tranStatus = ""
			#}
			ENDIF
			print(CUST.INTERFACE.tranStatus)
			#--------------------------------------------------------------------------------------------------------
			# If Success fetching cif id and cif opn date else fetching error code and description
			#--------------------------------------------------------------------------------------------------------
			IF (CUST.INTERFACE.tranStatus =="SUCCESS")  THEN
			#{
				CUST.INTERFACE.errorMsgFlg = "N"
				sv_x = CUST.INTERFACE.respXMLMsg
					#IF (CUST.INTERFACE.RETCOPR == "CORP") THEN
					#sv_y = "<cifid>"
					#sv_z = "</cifid>"
					#ELSE
						sv_y = "<CustId>"
						sv_z = "</CustId>"
					#ENDIF
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.cifid = MID$(sv_x, sv_b, (sv_e - sv_b))
					print(CUST.INTERFACE.cifid)
				#}
				ENDIF
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				sv_s = "UPDATE CUSTOM.INT_CHANGE   SET ENTITY_CRE_FLG = 'MOD', ACCT_OPN_DATE = sysdate,  ACCT_PREF ='SUCCESS' "
				sv_s = sv_s + " WHERE Foracid  = ?SVAR AND bank_id = ?SVAR and FREE_TEXT2 =?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.INTERFACE.cifid  + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.INTERFACE.PhnTypex 
				print(BANCS.INPARAM.BINDVARS)
		
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF

		sv_a = "nohup babx4061 $B2K_SESSION_ID VerifyRetailCif1.scr " +'"'+ CUST.INTERFACE.PhnTypex +'"'+ " " +'"'+ CUST.INTERFACE.cifid + '"' + " @s &"
		print(sv_a)
		sv_a = system(sv_a)
		print(sv_a)

				#call("VerifyRetailCifADHOC.scr")
				
				IF (CUST.INTERFACE.CIF == "") THEN
				#{
					CUST.INTERFACE.errorMsgFlg = "Y"
					CUST.INTERFACE.errorCode = "SYSERR"
					CUST.INTERFACE.errorDesc = "Could not get response from server"
				#}
				ENDIF
			#}
			ELSE
			#{
				CUST.INTERFACE.errorMsgFlg = "Y"
				IF(CUST.INTERFACE.tranStatus != "SUCCESS") THEN
				#{
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<ErrorCode>"
					sv_z = "</ErrorCode>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
					#}
					ENDIF
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<ErrorDesc>"
					sv_z = "</ErrorDesc>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))

					#}
					ENDIF

					
					sv_m = GETPOSITION(CUST.INTERFACE.errorDesc,"E-mail ID")                               
					IF (sv_m > 0)THEN
						CUST.INTERFACE.errorDesc = "Email Format is wrong"
					ENDIF

					#----------------------------------------------------------------------------------------------------
					# Update custom table failure status
					#----------------------------------------------------------------------------------------------------
					IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
					#{
						CUST.INTERFACE.errorCode = "SYSERR"
						CUST.INTERFACE.errorDesc = "Could not get response from server"
					#}
					ENDIF

					sv_s = "UPDATE CUSTOM.INT_CHANGE  SET ENTITY_CRE_FLG = 'MDE', ACCT_OPN_DATE = sysdate,  ACCT_PREF = replace (q'["+CUST.INTERFACE.errorDesc+"]',q'[|]',q'[ ]')  "
					sv_s = sv_s + " WHERE Foracid  = ?SVAR AND bank_id = ?SVAR and FREE_TEXT2 =?SVAR "
					print(sv_s)
					BANCS.INPARAM.BINDVARS =  CUST.INTERFACE.CIF   + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.INTERFACE.PhnTypex
					print(BANCS.INPARAM.BINDVARS)
			
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					ENDIF
				ENDIF
				IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
				#{
					CUST.INTERFACE.errorCode = "SYSERR"
					CUST.INTERFACE.errorDesc = "Could not get response from server"
				#}
				ENDIF
			#}
			ENDIF

JUMP3:
		#}
		ENDIF

		sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
		print(sv_k)

	#}
	DO

	sv_c = urhk_dbCursorClose(CUST.INTERFACE.DbcursorNumber)
	print(sv_c)
#}
ENDIF

ENDOFSCRIPT:
EXITSCRIPT
#trace off
end-->

