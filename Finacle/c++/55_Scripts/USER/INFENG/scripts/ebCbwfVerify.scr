<--START

TRACE ON
sv_u=urhk_B2k_PrintRepos("BANCS")
print(sv_u)
callscriptifexist("ebRepClass.scr")

	lv_s = " UnvRecCnt | select count(1) from custom.caml where id_number  =?SVAR "
	lv_s = lv_s + " and bank_id = ?SVAR "
	lv_s = lv_s + " and del_flg <> 'Y' "
	lv_s = lv_s + " and entity_cre_flg = 'X' "
	print(lv_s)
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	lv_r = urhk_dbSelectWithBind(lv_s)
	if ( lv_r == "0") then
		EBSRV.GLBDATA.UnvRecCnt = BANCS.OUTPARAM.UnvRecCnt
		print(EBSRV.GLBDATA.UnvRecCnt)
		if (EBSRV.GLBDATA.UnvRecCnt != "0" )then
			EBSRV.GLBDATA.recVerType = "DEL"
			print(EBSRV.GLBDATA.recVerType)
		else
			EBSRV.GLBDATA.recVerType = BANCS.INPUT.RecVerifyType
			print(EBSRV.GLBDATA.recVerType)
		endif
        endif


IF(EBSRV.GLBDATA.recVerType == "MAIN") THEN
#{
	lv_u = " UPDATE CUSTOM.caml SET ENTITY_CRE_FLG = 'Y', "
	lv_u = lv_u + " LCHG_TIME = SYSDATE, "
	lv_u = lv_u + " LCHG_USER_ID = ?SVAR "
	lv_u = lv_u + " WHERE id_number=?SVAR " 
	lv_u = lv_u + " AND BANK_ID =?SVAR "
	lv_u = lv_u + " AND ENTITY_CRE_FLG = 'N' "
	PRINT(lv_u)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId 
	PRINT(BANCS.INPARAM.BINDVARS)
	lv_r = urhk_dbSQLWithBind(lv_u)
	PRINT(lv_r)
	IF(lv_r == 0) THEN
		EBSRV.GLBDATA.resMsg = "BlackList Details Verified Successfully"
		GOTO ENDOFSCRIPT
	ELSE
		EBSRV.GLBDATA.errMsg = "Verification Failed"
		GOTO ENDOFSCRIPT
	ENDIF
#}
ENDIF

IF(EBSRV.GLBDATA.recVerType == "DEL") THEN
#{
        lv_u = " UPDATE CUSTOM.caml SET ENTITY_CRE_FLG = 'Y',del_flg ='Y', "
        lv_u = lv_u + " LCHG_TIME = SYSDATE, "
        lv_u = lv_u + " LCHG_USER_ID = ?SVAR "
        lv_u = lv_u + " WHERE id_number=?SVAR "
        lv_u = lv_u + " AND BANK_ID =?SVAR "
        lv_u = lv_u + " AND ENTITY_CRE_FLG = 'X' "
        PRINT(lv_u)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
        PRINT(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSQLWithBind(lv_u)
        PRINT(lv_r)
        IF(lv_r == 0) THEN
                EBSRV.GLBDATA.resMsg = "BlackList Details Verified Successfully"
                GOTO ENDOFSCRIPT
        ELSE
                EBSRV.GLBDATA.errMsg = "Verification Failed"
                GOTO ENDOFSCRIPT
        ENDIF
#}
ENDIF


IF(EBSRV.GLBDATA.recVerType == "MOD") THEN
#{
	EBSRV.GLBDATA.boddate = LEFT$(BANCS.STDIN.BODDate,10)
	PRINT(EBSRV.GLBDATA.boddate)

	lv_i = "INSERT INTO CUSTOM.caml_hist_tbl("
