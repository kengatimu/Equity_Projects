	lv_u = lv_u + " BACKLIST_EVIDENCE = ?SVAR, "
	lv_u = lv_u + " LCHG_TIME = SYSDATE ,"
	lv_u = lv_u + " LCHG_USER_ID = ?SVAR ,"
	lv_u = lv_u + " free_text1 = ?SVAR ,"
	lv_u = lv_u + " free_text2 = ?SVAR "
	lv_u = lv_u + " WHERE id_number =?SVAR "
	lv_u = lv_u + " AND BANK_ID = ?SVAR "
	lv_u = lv_u + " AND DEL_FLG <> 'Y' "
	lv_u = lv_u + " AND ENTITY_CRE_FLG = 'Y' "
	PRINT(lv_u)

	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.custName + "|" + EBSRV.GLBDATA.custDob + "|" + EBSRV.GLBDATA.custCntyOrg + "|" + EBSRV.GLBDATA.custConst + "|" + EBSRV.GLBDATA.custBranch + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.evideNce +"|"+ BANCS.STDIN.userId +"|"+ EBSRV.GLBDATA.WatchList + "|" + EBSRV.GLBDATA.WatchListReson + "|" + EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_r = urhk_dbSQLWithBind(lv_u)
	PRINT(lv_r)

	IF(lv_r == 0) THEN
	#{
		lv_d = "DELETE FROM CUSTOM.caml_mod "
		lv_d = lv_d + " WHERE id_number = ?SVAR " 
		lv_d = lv_d + " AND BANK_ID = ?SVAR "
		lv_d = lv_d + " AND DEL_FLG <> 'Y' "
		lv_d = lv_d + " AND ENTITY_CRE_FLG = 'N' "
