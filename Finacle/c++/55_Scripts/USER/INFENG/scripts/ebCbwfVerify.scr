       lv_i = lv_i + " free_text4, "
       lv_i = lv_i + " free_text5 ) "
	lv_i = lv_i + "SELECT "
       lv_i = lv_i + " bank_id, "
       lv_i = lv_i + " cif_id, "
       lv_i = lv_i + " cust_name, "
       lv_i = lv_i + " cust_dob, "
       lv_i = lv_i + " cust_country, "
       lv_i = lv_i + " cust_const, "
       lv_i = lv_i + " cust_branch, "
       lv_i = lv_i + " id_type, "
       lv_i = lv_i + " id_number, "
       lv_i = lv_i + " backlist_code, "
       lv_i = lv_i + " backlist_desc, "
       lv_i = lv_i + " backlist_reason, "
       lv_i = lv_i + " backlist_evidence, "
       lv_i = lv_i + " entity_cre_flg, "
       lv_i = lv_i + " del_flg, "
       lv_i = lv_i + " rcre_user_id, "
       lv_i = lv_i + " rcre_time, "
       lv_i = lv_i + " lchg_user_id, "
       lv_i = lv_i + " lchg_time, "
       lv_i = lv_i + " is_cust_yn, "
       lv_i = lv_i + " is_backlisted_crm, "
       lv_i = lv_i + " backlist_status, "
       lv_i = lv_i + " free_text1, "
       lv_i = lv_i + " free_text2, "
       lv_i = lv_i + " free_text3, "
       lv_i = lv_i + " free_text4, "
       lv_i = lv_i + " free_text5  "
	lv_i = lv_i + " FROM CUSTOM.caml "
	lv_i = lv_i + " WHERE id_number = ?SVAR " 
	lv_i = lv_i + " AND BANK_ID = ?SVAR "
	PRINT(lv_i)

	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_a = urhk_dbSQLWithBind(lv_i)
	PRINT(lv_a)
	IF(lv_a != 0) THEN
	#{
		EBSRV.GLBDATA.errMsg = "History Table Entry Failed "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	lv_u = " UPDATE CUSTOM.caml SET "
	lv_u = lv_u + " CUST_NAME = ?SVAR, "
	lv_u = lv_u + " CUST_DOB = ?SVAR, "
	lv_u = lv_u + " CUST_COUNTRY = ?SVAR, "
