			CUST.DATA.CIF = BANCS.OUTPARAM.CIF
			print(CUST.DATA.CIF)

			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.ROLEID
			sv_g = "ROLE_DESC|"
