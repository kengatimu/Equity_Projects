<--START
CHECKSUM="07c36328a9df7f92167ef233d57eacc0444c57fdbbc48ceb0e44589014b138f9"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	lv_r = REPEXISTS("CUST")
	
	IF(lv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	lv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(lv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.startEntityId = ""
	CUST.CIETXN.startSolId = ""
	CUST.CIETXN.entityId = ""
	CUST.CIETXN.drAcctNum = " "
	CUST.CIETXN.drAcctNumEntityId = " "
	CUST.CIETXN.refAmt = " "
	CUST.CIETXN.refCrncy = " "
	CUST.CIETXN.acctCrncy = " "
	
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	
	CUST.CIETXN.ieRateCode = " "
	CUST.CIETXN.ieRate = " "
	CUST.CIETXN.ieTreaRate = " "
	CUST.CIETXN.tranAmt = " "
	CUST.CIETXN.tranAmtCcy = " "
	CUST.CIETXN.chargeAmt = " "
	CUST.CIETXN.chargeAmtCcy = " "
	CUST.CIETXN.chargeEventId = " "
	CUST.CIETXN.nostroAcct = " "
	CUST.CIETXN.nostroAcctName = " "
	CUST.CIETXN.vostroAcct = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.drAcctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.drAcctNum) != "")THEN
		#{
			CUST.CIETXN.drAcctNum = TOUPPER(TRIM(BANCS.INPUT.drAcctNum))
			print(CUST.CIETXN.drAcctNum)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.drAcctNumEntityId))THEN
	#{
		IF(TRIM(BANCS.INPUT.drAcctNumEntityId) != "")THEN
		#{
			CUST.CIETXN.drAcctNumEntityId = TOUPPER(TRIM(BANCS.INPUT.drAcctNumEntityId))
			print(CUST.CIETXN.drAcctNumEntityId)
			IF (CUST.CIETXN.drAcctNumEntityId =="11") THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Cannot withdraw from Sudan"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.refAmt))THEN
	#{
		IF(TRIM(BANCS.INPUT.refAmt) != "")THEN
		#{
			CUST.CIETXN.refAmt = TOUPPER(TRIM(BANCS.INPUT.refAmt))
			print(CUST.CIETXN.refAmt)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.refCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.refCrncy) != "")THEN
		#{
			CUST.CIETXN.refCrncy = TOUPPER(TRIM(BANCS.INPUT.refCrncy))
			print(CUST.CIETXN.refCrncy)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.acctCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctCrncy) != "")THEN
		#{
			CUST.CIETXN.acctCrncy= TOUPPER(TRIM(BANCS.INPUT.acctCrncy))
			print(CUST.CIETXN.acctCrncy)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(TRIM(CUST.CIETXN.refCrncy) == "")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(TRIM(CUST.CIETXN.refAmt) == "")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###########################################################################################
	# HARD CURRENCY CHECK
	###########################################################################################
	
	PRINT(BANCS.STDIN.homeCrncyCode)
	
	IF(BANCS.STDIN.contextBankId =="56")THEN
	#{
		
		IF(CUST.CIETXN.refCrncy != BANCS.STDIN.homeCrncyCode)THEN
		#{
			print("currency differs")
			print(CUST.CIETXN.startEntityId)
			
			IF((CUST.CIETXN.refCrncy != "USD") AND (CUST.CIETXN.refCrncy != "GBP") AND (CUST.CIETXN.refCrncy != "KES") AND (CUST.CIETXN.refCrncy != "EUR") AND (CUST.CIETXN.refCrncy != "CAD"))THEN
			#{
				PRINT(CUST.CIETXN.refCrncy)
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Cash Withdrawal is allowed only in Local Currency"
				
				GOTO ENDOFSCRIPT
				
			#}
			ENDIF
			
			
			
			IF((CUST.CIETXN.acctCrncy != CUST.CIETXN.refCrncy) AND (CUST.CIETXN.refCrncy != "KES")) THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Cash Withdrawal is allowed only in Local Currency OR Account Currency"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(BANCS.STDIN.contextBankId !="56")THEN
	#{
		IF(CUST.CIETXN.refCrncy != BANCS.STDIN.homeCrncyCode)THEN
		#{
			
			IF((CUST.CIETXN.refCrncy != "USD") AND (CUST.CIETXN.refCrncy != "GBP") AND (CUST.CIETXN.refCrncy != "EUR") AND (CUST.CIETXN.refCrncy != "CAD"))THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Cash Withdrawal is allowed only in Local Currency"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			
			IF(CUST.CIETXN.acctCrncy != CUST.CIETXN.refCrncy)THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Cash Withdrawal is allowed only in Local Currency OR Account Currency"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	CUST.CIETXN.startEntityId = BANCS.STDIN.contextBankId
	CUST.CIETXN.startSolId = BANCS.STDIN.mySolId
	
	###########################################################################################
	# Get Target Entity Rate Code and Rate
	###########################################################################################
	
	BANCS.INPUT.initOrInterOrTargetEntity = "IE"
	BANCS.INPUT.initEntity = CUST.CIETXN.startEntityId
	BANCS.INPUT.targetEntity = CUST.CIETXN.drAcctNumEntityId
	BANCS.INPUT.foracid = CUST.CIETXN.drAcctNum
	BANCS.INPUT.refCrncy = CUST.CIETXN.refCrncy
	BANCS.INPUT.refAmt = CUST.CIETXN.refAmt
	
	CUST.CIETXN.scriptSuccess = "Y"
	CALL("cietxndp055.scr")
	
	IF(CUST.CIETXN.scriptSuccess == "N")THEN
	#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Target Entity Rate Code/Rate;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(CUST.CIETXN.ieRateCode)
	PRINT(CUST.CIETXN.ieRate)
	PRINT(CUST.CIETXN.ieTreaRate)
	PRINT(CUST.CIETXN.tranAmt)
	PRINT(CUST.CIETXN.tranAmtCcy)
	
	################################################################################################
	# Incoming and Outgoing CP Accounts
	################################################################################################
	#Get the Incoming CP Account (Nostro Account Id)
	NOSTRO:
		CUST.CIETXN.parameterId = "CW_IC_CP_ACCT"
		print(CUST.CIETXN.parameterId)
		
		sv_s = "nostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.startEntityId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find CP Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.nostroAcct = BANCS.OUTPARAM.nostroAcct
		print(CUST.CIETXN.nostroAcct)
		
		IF(TRIM(CUST.CIETXN.nostroAcct) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find CP Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------------
		# Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		#HARD CCY CHECK
		
		IF((CUST.CIETXN.refCrncy != "USD") OR (CUST.CIETXN.refCrncy != "GBP") OR (CUST.CIETXN.refCrncy != "EUR") OR (CUST.CIETXN.refCrncy != "CAD"))THEN
		#{
			CUST.CIETXN.inputCcy = "USD"
			#}
		ELSE
			#{
			CUST.CIETXN.inputCcy = CUST.CIETXN.refCrncy
		#}
		ENDIF
		
		BANCS.INPUT.inputBacid = CUST.CIETXN.nostroAcct
		BANCS.INPUT.inputCcy   = CUST.CIETXN.inputCcy
		BANCS.INPUT.inputSolID = CUST.CIETXN.startSolId
		BANCS.INPUT.inputBankId = CUST.CIETXN.startEntityId
		
		CALL("bacidtoacid.scr")
		CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
		print(CUST.CIETXN.outputForacid)
		
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find CP Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.nostroAcct = CUST.CIETXN.outputForacid
		
		sv_s = "nostroAcctName|"
		sv_s = sv_s + " SELECT ACCT_NAME"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE FORACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.nostroAcct
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.nostroAcctName = BANCS.OUTPARAM.nostroAcctName
			PRINT(CUST.CIETXN.nostroAcctName)
		#}
		ENDIF
		
		###########################################################################################
		# Get the Outgoing CP Account / Vostro Account Id
		###########################################################################################
		
		#Outgoing CP Account
	VOSTRO:
		CUST.CIETXN.parameterId = "CW_OG_CP_ACCT"
		print(CUST.CIETXN.parameterId)
		CUST.CIETXN.parameterId =CUST.CIETXN.parameterId +"_"+CUST.CIETXN.drAcctNumEntityId
		PRINT(CUST.CIETXN.parameterId)	
		sv_s = "vostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		#sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.drAcctNumEntityId + "|" + CUST.CIETXN.parameterId
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find CP Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.vostroAcct = BANCS.OUTPARAM.vostroAcct
		print(CUST.CIETXN.vostroAcct)
		
		IF(TRIM(CUST.CIETXN.vostroAcct) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find CP Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------------
		# Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		IF((CUST.CIETXN.acctCrncy != "USD") OR (CUST.CIETXN.acctCrncy != "GBP") OR (CUST.CIETXN.acctCrncy != "EUR") OR (CUST.CIETXN.acctCrncy != "CAD"))THEN
		#{
			CUST.CIETXN.inputCcy = "USD"
			#}
		ELSE
			#{
			CUST.CIETXN.inputCcy = CUST.CIETXN.acctCrncy
		#}
		ENDIF
		
	#	BANCS.INPUT.inputBacid = CUST.CIETXN.vostroAcct
	#	BANCS.INPUT.inputCcy   = CUST.CIETXN.inputCcy
	#	BANCS.INPUT.inputSolID = BANCS.STDIN.mySolId
	#	BANCS.INPUT.inputBankId = CUST.CIETXN.drAcctNumEntityId
		
	#	CALL("bacidtoacid.scr")
	#	CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
	#	print(CUST.CIETXN.outputForacid)
		CUST.CIETXN.inputBankId = CUST.CIETXN.drAcctNumEntityId
		CUST.CIETXN.inputBacid = CUST.CIETXN.vostroAcct
		CUST.CIETXN.inputSolId =BANCS.STDIN.mySolId
		CUST.CIETXN.inputCcy = CUST.CIETXN.inputCcy
		CUST.CIETXN.inputBacidOrForacid = CUST.CIETXN.vostroAcct
		
		CALL("cietxndp032.scr")
		
		PRINT(CUST.CIETXN.outputForacid)	
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find CP Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.vostroAcct = CUST.CIETXN.outputForacid
		
		#######################################################################################
		
	ENDOFSCRIPT:
		
		IF(CUST.CIETXN.errorFlg == "")THEN
		#{
			CUST.CIETXN.errorFlg = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.errorMsg == "")THEN
		#{
			CUST.CIETXN.errorMsg = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.ieRateCode == "")THEN
		#{
			CUST.CIETXN.ieRateCode = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.ieRate == "")THEN
		#{
			CUST.CIETXN.ieRate = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.ieTreaRate == "")THEN
		#{
			CUST.CIETXN.ieTreaRate = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.tranAmt == "")THEN
		#{
			CUST.CIETXN.tranAmt = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.tranAmtCcy == "")THEN
		#{
			CUST.CIETXN.tranAmtCcy = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.chargeAmt == "")THEN
		#{
			CUST.CIETXN.chargeAmt = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.chargeAmtCcy == "")THEN
		#{
			CUST.CIETXN.chargeAmtCcy = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.chargeEventId == "")THEN
		#{
			CUST.CIETXN.chargeEventId = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.nostroAcct == "")THEN
		#{
			CUST.CIETXN.nostroAcct = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.vostroAcct == "")THEN
		#{
			CUST.CIETXN.vostroAcct = " "
		#}
		ENDIF
		
		IF(CUST.CIETXN.nostroAcctName == "")THEN
		#{
			CUST.CIETXN.nostroAcctName = " "
		#}
		ENDIF
		
		lv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(lv_u)
		lv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(lv_u)
		lv_u = urhk_SetOrbOut("rateCode|"+CUST.CIETXN.ieRateCode)
		print(lv_u)
		lv_u = urhk_SetOrbOut("rate|"+CUST.CIETXN.ieRate)
		print(lv_u)
		lv_u = urhk_SetOrbOut("treaRate|"+CUST.CIETXN.ieTreaRate)
		print(lv_u)
		lv_u = urhk_SetOrbOut("tranAmt|"+CUST.CIETXN.tranAmt)
		print(lv_u)
		lv_u = urhk_SetOrbOut("tranAmtCcy|"+CUST.CIETXN.tranAmtCcy)
		print(lv_u)
		lv_u = urhk_SetOrbOut("chargeAmt|"+CUST.CIETXN.chargeAmt)
		print(lv_u)
		lv_u = urhk_SetOrbOut("chargeAmtCcy|"+CUST.CIETXN.chargeAmtCcy)
		print(lv_u)
		lv_u = urhk_SetOrbOut("chargeEventId|"+CUST.CIETXN.chargeEventId)
		print(lv_u)
		lv_u = urhk_SetOrbOut("nostroAcct|"+CUST.CIETXN.nostroAcct)
		print(lv_u)
		lv_u = urhk_SetOrbOut("vostroAcct|"+CUST.CIETXN.vostroAcct)
		print(lv_u)
		lv_u = urhk_SetOrbOut("nostroAcctName|"+CUST.CIETXN.nostroAcctName)
		print(lv_u)
		
		
END-->
