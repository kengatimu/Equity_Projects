		CUST.DATA.acid=BANCS.OUTPARAM.Acid
		print(CUST.DATA.acid)

		    sv_k = " count| "
			sv_k = sv_k +" select count(*) from tbaadm.aas where NMA_KEY_ID =?SVAR and bank_id = ?SVAR  and ACCT_POA_AS_REC_TYPE ='O' and acid =?SVAR"
	
		PRINT(sv_k)
        BANCS.INPARAM.BINDVARS = CUST.DATA.CUSTID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.acid 
        PRINT(BANCS.INPARAM.BINDVARS)

		sv_r = urhk_dbSelectWithBind(sv_k)
		print(sv_r)


		if(sv_r==0) then
		print(BANCS.OUTPARAM.count)
		CUST.DATA.COUNT= BANCS.OUTPARAM.count
		
			IF(CUST.DATA.COUNT <1) THEN
					sv_k ="400"
					sv_t="ResponseCode| " + sv_k
