					lv_b = urhk_SetOrbOut("MSG|Agent Record Not Found On That Account")
					GOTO ENDOFSCRIPT
			
			ENDIF
			
		#######CHECKING IF AGENT IS ACTIVE
		
		    sv_k = " DEL_FLG| "
			sv_k = sv_k +" select DEL_FLG from tbaadm.aas where NMA_KEY_ID =?SVAR and bank_id = ?SVAR  and ACCT_POA_AS_REC_TYPE ='O' and acid =?SVAR"
	
		PRINT(sv_k)
        BANCS.INPARAM.BINDVARS = CUST.DATA.CUSTID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.acid 
        PRINT(BANCS.INPARAM.BINDVARS)

		sv_r = urhk_dbSelectWithBind(sv_k)
		print(sv_r)


		if(sv_r==0) then
		
		CUST.DATA.DEL_FLG= BANCS.OUTPARAM.DEL_FLG
		PRINT(CUST.DATA.DEL_FLG)
			IF(CUST.DATA.DEL_FLG !="N") THEN
					sv_k ="400"
					sv_t="ResponseCode| " + sv_k
					sv_u = urhk_SetOrbOut(sv_t)
					
					lv_b = urhk_SetOrbOut("MSG|Agent Record is deleted.")
					GOTO ENDOFSCRIPT
			
			ENDIF
		
		
			
		else
					sv_k ="400"
					sv_t="ResponseCode| " + sv_k
					sv_u = urhk_SetOrbOut(sv_t)
					
					lv_b = urhk_SetOrbOut("MSG|Database Error. Please contact administrator.")
					GOTO ENDOFSCRIPT
		endif
		
		
		
		sv_k = " update  SVSUSER.SIGNMAINTENANCE set REMARKS=?SVAR where  signid in (SELECT SIGNID FROM SVSUSER.AUDITINFO WHERE CUSTID =?SVAR "
		sv_k = sv_k +" AND ENTITYID =?SVAR AND  ACCTID = ?SVAR and ACTIVITY='ADD') and rownum =1 "
	
		PRINT(sv_k)
        BANCS.INPARAM.BINDVARS = CUST.DATA.FUNCTIONS + "|" + CUST.DATA.CUSTID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Foracid
        PRINT(BANCS.INPARAM.BINDVARS)

		sv_r = urhk_dbSQLWithBind(sv_k)
		print(sv_r)

		############################IF SUCCESS##################################
		if(sv_r==0) then


		###Fetching Account Phone Number and Email
				
			sv_s = "EMAIL, PHONE|"
			sv_s = sv_s + " select email, phone from crmuser.cmg where cif_id in (select cif_id from tbaadm.gam where foracid =?SVAR) and bank_id =?SVAR "
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			CUST.DATA.AccountEMAIL =""
			CUST.DATA.AccountPHONE =""
			IF(sv_d==0)THEN
			#{		
				
				CUST.DATA.AccountEMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.AccountEMAIL)
				
				CUST.DATA.AccountPHONE = BANCS.OUTPARAM.PHONE
				print(CUST.DATA.AccountPHONE)
				
			#}
			
			ENDIF

			IF(CUST.DATA.AccountPHONE =="") THEN
			sv_s = "PHONE|"
