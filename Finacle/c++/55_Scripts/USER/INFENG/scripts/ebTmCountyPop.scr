<--start
trace on
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	BANCS.INPUT.funCode = BANCS.INPUT.funcCode
	BANCS.INPUT.nationn = BANCS.INPUT.nation
	sv_d = "pymntCnt | select count(*) "
	sv_d = sv_d + " from tbaadm.rct where del_flg='N' and ref_rec_type='03' and bank_id=?SVAR order by ref_code "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		BANCS.INPUT.pymntCnt = BANCS.OUTPARAM.pymntCnt
	else
		BANCS.INPUT.pymntCnt = 0
	endif
	sv_h = urhk_SetOrbOut("recCount|" +BANCS.INPUT.pymntCnt)
	sv_d = " paymentRefNum,PaymentRefDate | select ref_code,ref_desc "
	sv_d = sv_d + " from tbaadm.rct where del_flg='N' and ref_rec_type='03' and bank_id=?SVAR order by ref_code "
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_c==0)then
		BANCS.INPUT.pttNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		BANCS.INPUT.pttNum = ""
	endif
	sv_r = urhk_dbCursorFetch(BANCS.INPUT.pttNum)
	print(sv_r)
	sv_z = 0
	sv_n = 1
	while(sv_r == 0)
	#{
			BANCS.INPUT.paymentRefNum	= BANCS.OUTPARAM.paymentRefNum
			BANCS.INPUT.PaymentRefDate	= BANCS.OUTPARAM.PaymentRefDate
			BANCS.INPUT.count = sv_n
			if(BANCS.INPUT.paymentRefNum=="")then
				BANCS.INPUT.paymentRefNum = " "
			endif
			if(BANCS.INPUT.PaymentRefDate=="")then
				BANCS.INPUT.PaymentRefDate = " "
			endif
			if(BANCS.INPUT.nationn=="Y")then
				##sv_s = "freeFld4_" + BANCS.INPUT.count + "|" + BANCS.INPUT.paymentRefNum 
				##print(sv_s)
				sv_s = "issueCty_" + BANCS.INPUT.count + "|" + BANCS.INPUT.paymentRefNum 
				print(sv_s)
			else
				##sv_s = "freeFld6_" + BANCS.INPUT.count + "|" + BANCS.INPUT.paymentRefNum 
				##print(sv_s)
				sv_s = "natLity_" + BANCS.INPUT.count + "|" + BANCS.INPUT.paymentRefNum 
				print(sv_s)
			endif
				sv_u = urhk_SetOrbOut(sv_s)
			if(BANCS.INPUT.nationn=="Y")then
				sv_s = "nCountryDesc_" + BANCS.INPUT.count + "|" + BANCS.INPUT.PaymentRefDate 
				print(sv_s)
			else
				sv_s = "CountryDesc_" + BANCS.INPUT.count + "|" + BANCS.INPUT.PaymentRefDate 
				print(sv_s)
			endif
				sv_u = urhk_SetOrbOut(sv_s)
			if(sv_r == 0)then
				sv_r = urhk_dbCursorFetch(BANCS.INPUT.pttNum)
			endif
			sv_n = sv_n + 1
			print(sv_n)
	#}
	do
        sv_r = urhk_dbCursorClose(BANCS.INPUT.pttNum)
trace off
end-->
