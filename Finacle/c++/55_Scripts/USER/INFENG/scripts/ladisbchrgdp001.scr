			#}
		ELSE
			#{
			CUST.LADISB.cursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_r = urhk_dbCursorFetch(CUST.LADISB.cursorNumber)
			WHILE(sv_r == 0)
			#{
				print(BANCS.OUTPARAM.chrgCrncy)
				print(BANCS.OUTPARAM.chrgAmt)
				IF(CDOUBLE(BANCS.OUTPARAM.chrgAmt) != CDOUBLE("0")) THEN
				#{
					IF(BANCS.OUTPARAM.chrgCrncy != CUST.LADISB.laAcctCrncy) THEN
					#{
						BANCS.INPARAM.InputAmount = BANCS.OUTPARAM.chrgAmt
						BANCS.INPARAM.FromCurrency = BANCS.OUTPARAM.chrgCrncy
						BANCS.INPARAM.ToCurrency = CUST.LADISB.laAcctCrncy
