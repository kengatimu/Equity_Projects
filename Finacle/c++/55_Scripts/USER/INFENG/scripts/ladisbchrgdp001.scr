		IF(CDOUBLE(CUST.LADISB.charge) != CDOUBLE("0")) THEN
		#{
			CUST.LADISB.srlNo="0"
			CUST.LADISB.tranPrac = CUST.LADISB.tranPrac + " CHARGES"
			print(CUST.LADISB.tranPrac)
