<--START
CHECKSUM="ad43aa2b33fb0d7184ae60055dfc006d1950651ffb0f6d97f02eb54a6a97a942"
	TRACE ON
	LIBNAME CUSTOMSO
	#======Repository creation============#
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	#================================================
	# Opening of Upload File for Reading
	#================================================
	sv_r = urhk_getEnv("TBA_PROD_ROOT")
	sv_a = BANCS.OUTPARAM.envValue
	print(sv_a)
	CUST.DATA.filePath =  sv_a + "/" + "CDCI_LOGS" + "/" + BANCS.STDIN.userId + "/"
	CUST.DATA.fileName = "sample.lst"
	CUST.DATA.fileName = CUST.DATA.filePath + CUST.DATA.fileName
	print(CUST.DATA.fileName)
	sv_t = urtn_fileOpen(CUST.DATA.fileName+"|r")
	print(sv_t)
	CUST.DATA.index = sv_t
	print(CUST.DATA.index)
	
	sv_t= urtn_fileOpen("invalid.txt|w")
	PRINT(sv_t)
	CUST.DATA.indexW = sv_t
	print(CUST.DATA.indexW)
	
	sv_x = urtn_fileRead(CUST.DATA.index + "|CUST.DATA.record")
	print(sv_x)
	print(CUST.DATA.record)
	#CUST.DATA.record = RIGHT$(CUST.DATA.record,16)
	#print(CUST.DATA.record)
	
	####----------------------------------------------------------####
	# To check the end of Request file
	####----------------------------------------------------------####
	WHILE(sv_x == 0)
	#{
		BANCS.INPARAM.BINDVARS = ""
		BANCS.INPARAM.BINDVARS = CUST.DATA.record + "|" + BANCS.STDIN.contextBankId+ "|" + CUST.DATA.record + "|" + BANCS.STDIN.contextBankId
		
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_g = "acctno|select distinct acctid from svsuser.nsignotherinfo"
		sv_g = sv_g + " WHERE "
		sv_g = sv_g + " acctid = ?SVAR  AND "
		sv_g = sv_g + " entityid = ?SVAR  AND "
		sv_g = sv_g + " not exists (select 1 from tbaadm.gam"
		sv_g = sv_g + " WHERE gam.foracid = ?SVAR  AND gam.bank_id = ?SVAR)"
		
		sv_d = urhk_dbSelectWithBind(sv_g)
		print(sv_d)
		
		IF(sv_d == 0) THEN
		#{
			print(BANCS.OUTPARAM.acctno)
			CUST.DATA.acctno = BANCS.OUTPARAM.acctno
			sv_r= urtn_fileWrite(CUST.DATA.indexW + "|" + CUST.DATA.acctno)
			PRINT(sv_r)
		#}
		ENDIF
		
		sv_x = urtn_fileRead(CUST.DATA.index + "|CUST.DATA.record")
		print(sv_x)
		
	#}
	DO
	####--------------------------------------------####
	# To close the Request file  and move to backup
	####--------------------------------------------####
	
	sv_v = urtn_fileClose(CUST.DATA.index)
	PRINT(sv_v)
	sv_v = urtn_fileClose(CUST.DATA.indexW)
	PRINT(sv_v)
	
	exitscript
	#######################################################################################################
	TRACE OFF
END-->
