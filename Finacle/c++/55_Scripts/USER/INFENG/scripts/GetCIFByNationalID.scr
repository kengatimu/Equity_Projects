#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

#sv_a = urhk_b2k_PrintRepos("BANCS")
#print(sv_a)
sv_b=0



CUST.DATA.nationalid=BANCS.INPUT.nationalid

print(CUST.DATA.nationalid)

sv_c = urhk_GetChannelInfo("")
print(sv_c)

CUST.DATA.DccId =BANCS.OUTPARAM.DccId
#print(CUST.DATA.DccId)

print(BANCS.OUTPARAM.DccId)




############################################################################
#This section gets the value of the cust given the national id
#
############################################################################


sv_d="cif_count|SELECT count(ACCOUNTID)  FROM CRMUSER.accounts WHERE UNIQUEID=?SVAR"


print(sv_d)


BANCS.INPARAM.BINDVARS=CUST.DATA.nationalid
PRINT(BANCS.INPARAM.BINDVARS)


sv_e=urhk_dbSelectWithBind(sv_d) 
#if sv_e=urhk_dbSelectWithBind executed successfully
if(sv_e==0)then
print(sv_e)
CUST.DATA.cifcount=BANCS.OUTPARAM.cif_count
sv_e=urhk_SetOrbOut("count|"+CUST.DATA.cifcount)

#if the count is 1 return xml <count=1> and the existing CIF ID

if(CUST.DATA.cifcount==1) then

print("CIF COUNT EQUALS 1")

sv_f="cifid|SELECT ORGKEY FROM CRMUSER.accounts WHERE UNIQUEID=?SVAR"

BANCS.INPARAM.BINDVARS=CUST.DATA.nationalid

sv_f=urhk_dbSelectWithBind(sv_f)

CUST.DATA.cifid=BANCS.OUTPARAM.cifid 

sv_e=urhk_SetOrbOut("count|"+CUST.DATA.cifcount)
sv_e=urhk_SetOrbOut("description|"+"This CIF ID already exists")
sv_e=urhk_SetOrbOut("CIFID|"+CUST.DATA.cifid)

PRINT(sv_e)

else
	  #count is >1 then return xml <count=0>
	if(CUST.DATA.cifcount>1) then
	
	     print("Multiple CIFS found for the National ID")

         sv_e=urhk_SetOrbOut("count|"+CUST.DATA.cifcount)
		 sv_e=urhk_SetOrbOut("desciption|"+"Multiple CIFS found for the National ID")
	
	else
	
		#The query found no CIF for the National ID
		#Return xml which contains <count>0</count>
		CUST.DATA.desc="No CIF was found for the National Id"
		sv_e=urhk_SetOrbOut("count|"+CUST.DATA.cifcount)
		sv_e=urhk_SetOrbOut("description|"+CUST.DATA.desc)
	endif
endif







else
PRINT(BANCS.OUTPARAM.DB_ERRCODE)
PRINT(BANCS.OUTPARAM.DB_ERRMSG)
endif



print(CUST.DATA.cifcount)




trace off

end-->
