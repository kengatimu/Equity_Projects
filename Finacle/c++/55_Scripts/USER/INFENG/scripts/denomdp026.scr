<--START
CHECKSUM="501fa76151e34bdbfb3cf20f41c9f6a7f13b5ef5824fc3447d8b2370e725ccb1"
	TRACE ON
	
	IF(FIELDEXISTS(CUST.DENOM.tranDate)==0) THEN
	#{
		CUST.DENOM.tranDate = LEFT$(BANCS.STDIN.BODDate,10)
		print(CUST.DENOM.tranDate)
	#}
	ENDIF
	IF(CUST.DENOM.tranDate == "") THEN
	#{
		CUST.DENOM.tranDate = LEFT$(BANCS.STDIN.BODDate,10)
		PRINT(CUST.DENOM.tranDate)
	#}
	ENDIF
	CUST.DENOM.bank_id = toUpper(BANCS.STDIN.contextBankId)
	print(CUST.DENOM.bank_id)
	
	#--------------------------------------------------------------------------------
	# Parsing Total denominations details
	#-----------------------------------------------------------------------------------
	sv_a=("CUST").("DENOM").("coinDenomValue"+ FORMAT$(sv_k,"%d"))
	sv_b=("CUST").("DENOM").("noteDenomValue"+ FORMAT$(sv_k,"%d"))
	print(sv_a)
	print(sv_b)
	print(sv_k)
	CUST.DENOM.coinDenomVal = sv_a
	CUST.DENOM.noteDenomVal = sv_b
	CUST.DENOM.pType = ("CUST").("DENOM").("pType"+ FORMAT$(sv_k,"%d"))
	CUST.DENOM.crncy = MID$(("CUST").("DENOM").("currency"+ FORMAT$(sv_k,"%d")),0,3)
	PRINT(CUST.DENOM.crncy)
	
	sv_j = GETPOSITION(("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d")),"D")
	IF(sv_j == 0)THEN
	#{
		sv_j = GETPOSITION(("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d")),"C")
	#}
	ENDIF
	PRINT(sv_j)
	PRINT((("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d"))))
	sv_e = LEFT$(("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d")),sv_j-2)
	print(sv_e)
	sv_c = sv_e
	sv_e = RIGHT$(("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d")),(STRLEN(("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d")))-(sv_j-1)))
	print(sv_e)
	CUST.DENOM.roundoff = sv_e
	print(CUST.DENOM.roundoff)
	
	sv_x = 0
	sv_y = 0
	sv_q = 1
	print(sv_a)
	print(sv_b)
	print(sv_c)
	
	sv_g = ("CUST").("DENOM").("totDenGB"+ FORMAT$(sv_k,"%d"))
	print(sv_g)
	sv_h = ("CUST").("DENOM").("totDenPB"+ FORMAT$(sv_k,"%d"))
	print(sv_h)
	
	sv_r = 1
	sv_p = "C"
	sv_d = ""
	sv_j = ""
	sv_v = ""
	CUST.DENOM.userId = BANCS.STDIN.userId
	
	WHILE(sv_r!=0)
	#{
		sv_q = GETPOSITION(sv_a,"-")
		print(sv_q)
		sv_r = GETPOSITION(sv_c,"!")
		print(sv_r)
		IF(sv_q != 0) THEN
		#{
			sv_x = LEFT$(sv_a,(sv_q-1))
		#}
		ELSE
		#{
			sv_x = sv_a
		#}
		ENDIF
		IF(sv_r != 0) THEN
		#{
			sv_y = LEFT$(sv_c,(sv_r-1))
		#}
		ELSE
		#{
			sv_y = sv_c
		#}
		ENDIF
		print(sv_x)
		print(sv_y)
		print(sv_a)
		print(sv_c)
		print(sv_p)
		CUST.DENOM.DENOMVALUE = sv_x
		
		#-------------------------------------------------------------------------
		# Parsing GB denominations
		#-------------------------------------------------------------------------
		PRINT(("CUST").("DENOM").("totDenGB" + FORMAT$(sv_k, "%d")))
		IF ((("CUST").("DENOM").("totDenGB" + FORMAT$(sv_k, "%d"))) != "") THEN
		#{
			sv_f = GETPOSITION(sv_g, "!")
			PRINT(sv_f)
			IF (sv_f == 0) THEN
			#{
				sv_y = sv_g
			#}
			ELSE
			#{
				sv_y = LEFT$(sv_g, (sv_f - 1))
			#}
			ENDIF
			PRINT(sv_y)
		#}
		ENDIF
		#-------------------------------------------------------------------------
		# Parsing PB denominations
		#-------------------------------------------------------------------------
		PRINT(("CUST").("DENOM").("totDenPB" + FORMAT$(sv_k, "%d")))
		IF (("CUST").("DENOM").("totDenPB" + FORMAT$(sv_k, "%d")) != "") THEN
		#{
			sv_w = GETPOSITION(sv_h, "!")
			PRINT(sv_w)
			IF (sv_w == 0) THEN
			#{
				sv_y = sv_h
			#}
			ELSE
			#{
				sv_y = LEFT$(sv_h, (sv_w - 1))
			#}
			ENDIF
			PRINT(sv_y)
		#}
		ENDIF
		#---------------------------------------------------------------------------
		
		sv_a = RIGHT$(sv_a,(STRLEN(sv_a)-(sv_q)))
		print(sv_a)
		PRINT(sv_q)
		IF(sv_r != 0) THEN
		#{
			sv_d = sv_d + LEFT$(sv_c,sv_r)
		#}
		ELSE
		#{
			sv_d = sv_d + sv_c
		#}
		ENDIF
		print(sv_d)
		sv_c = RIGHT$(sv_c,(STRLEN(sv_c)-(sv_r)))
		print(sv_c)
		
		IF ((("CUST").("DENOM").("totDenGB" + FORMAT$(sv_k, "%d"))) != "") THEN
		#{
			IF (sv_f != 0) THEN
			#{
				sv_j = sv_j + LEFT$(sv_g, sv_f)
			#}
			ELSE
			#{
				sv_j = sv_j + sv_g
			#}
			ENDIF
			PRINT(sv_j)
			sv_g = RIGHT$(sv_g, (STRLEN(sv_g) - (sv_f)))
			PRINT(sv_g)
		#}
		ENDIF
		IF (("CUST").("DENOM").("totDenPB" + FORMAT$(sv_k, "%d")) != "") THEN
		#{
			IF (sv_w != 0) THEN
			#{
				sv_v = sv_v + LEFT$(sv_h, sv_w)
			#}
			ELSE
			#{
				sv_v = sv_v + sv_h
			#}
			ENDIF
			PRINT(sv_v)
			sv_h = RIGHT$(sv_h, (STRLEN(sv_h) - (sv_w)))
			PRINT(sv_h)
		#}
		ENDIF
		IF(sv_q == 0) THEN
		#{
			print(sv_d)
			#---- Insert into C_DETD ---------
			IF(sv_p == "C") THEN
			#{
				print(sv_a)
				CUST.DENOM.denomVal 	= CUST.DENOM.coinDenomVal
				CUST.DENOM.denomInd 	= "C"
				#}
			ELSE
				#{
				print(sv_b)
				CUST.DENOM.denomVal 	= CUST.DENOM.noteDenomVal
				CUST.DENOM.denomInd 	= "N"
			#}
			ENDIF
			print(sv_d)
			print(sv_j)
			print(sv_v)
			IF(RIGHT$(sv_d,1) == "!") THEN
			#{
				CUST.DENOM.denomCnt = LEFT$(sv_d,STRLEN(sv_d)-1)
			#}
			ELSE
			#{
				CUST.DENOM.denomCnt = sv_d
			#}
			ENDIF
			CUST.DENOM.denomCntGB 	= sv_j
			CUST.DENOM.denomCntPB 	= sv_v
			print(CUST.DENOM.pType)
			
			
			
			sv_m = "INSERT INTO c_detd (sol_id,dxfer_id,dxfer_flg,ptran_type,crncy_code,denom_ind,denom_value,"
			sv_m = sv_m + "denom_count,type,teller_id,tran_date,"
			sv_m = sv_m + "value_date,"
			sv_m = sv_m + "part_tran_srl_num,auth_matrix_id,rcre_user_id,rcre_time,"
			sv_m = sv_m + "lchg_user_id,lchg_time,bank_id)"
			sv_m = sv_m + "	VALUES (?SVAR,"
			sv_m = sv_m + "?SVAR,"
			sv_m = sv_m + "?SVAR,?SVAR,"
			sv_m = sv_m + "?SVAR,?SVAR,"
			sv_m = sv_m + "?SVAR,REPLACE('"
			CUST.DENOM.bindvarsM = CUST.DENOM.solId +"|"+ CUST.DENOM.tranId +"|"+	CUST.DENOM.EVENT +"|"+ CUST.DENOM.pType +"|"+ CUST.DENOM.crncy +"|"+ CUST.DENOM.denomInd +"|"+ CUST.DENOM.denomVal
			sv_n = "','!','-'),'"
			sv_o = "',?SVAR"+","
			sv_o = sv_o + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
			sv_o = sv_o + "TO_DATE(?SVAR,'DD-MM-YYYY') ,?SVAR,"
			sv_o = sv_o + "?SVAR,"
			sv_o = sv_o + "?SVAR,sysdate,?SVAR,sysdate,?SVAR)"
			CUST.DENOM.bindvarsO = CUST.DENOM.tellerId +"|"+ CUST.DENOM.tranDate +"|"+ CUST.DENOM.tranDate+"|"+ CUST.DENOM.serialno +"|"+ CUST.DENOM.authMatrixId +"|"+ CUST.DENOM.userId +"|"+ CUST.DENOM.userId + "|" + BANCS.STDIN.contextBankId
			print(sv_m)
			print(sv_n)
			print(sv_o)
			#BANCS.INPARAM.BINDVARS = CUST.DENOM.bindvarsM + "|"+ CUST.DENOM.denomCnt +"|"+ CUST.DENOM.bindvarsO
			BANCS.INPARAM.BINDVARS = CUST.DENOM.bindvarsM +"|"+ CUST.DENOM.bindvarsO
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = sv_m + CUST.DENOM.denomCnt + sv_n + "" + sv_o
			print(sv_q)
			sv_v = urhk_dbsqlWithBind(sv_q)
			print(sv_v)
			IF(("CUST").("DENOM").("totDenGB"+ FORMAT$(sv_k,"%d")) != "") THEN
			#{
				CUST.DENOM.denomCnt = CUST.DENOM.denomCntGB
				
				BANCS.INPARAM.BINDVARS = CUST.DENOM.bindvarsM + "|" + CUST.DENOM.bindvarsO
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_q = sv_m + CUST.DENOM.denomCnt + sv_n + "GB" + sv_o
				print(sv_q)
				sv_v = urhk_dbsqlWithBind(sv_q)
				print(sv_v)
			#}
			ENDIF
			IF(("CUST").("DENOM").("totDenPB"+ FORMAT$(sv_k,"%d")) != "") THEN
			#{
				CUST.DENOM.denomCnt = CUST.DENOM.denomCntPB
				
				BANCS.INPARAM.BINDVARS = CUST.DENOM.bindvarsM + "|"+  CUST.DENOM.bindvarsO
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_q = sv_m + CUST.DENOM.denomCnt + sv_n + "PB" + sv_o
				print(sv_q)
				sv_v = urhk_dbsqlWithBind(sv_q)
				print(sv_v)
			#}
			ENDIF
			sv_d = ""
			sv_j = ""
			sv_v = ""
			sv_p = "N"
			sv_a = ("CUST").("DENOM").("noteDenomValue"+ FORMAT$(sv_k,"%d"))
		#}
		ENDIF
	#}
	DO
	
	TRACE OFF
