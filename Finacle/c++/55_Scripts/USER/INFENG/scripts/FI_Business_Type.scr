        #{
                CUST.DATA.legalType = ""
        #}
        ELSE
        #{
                CUST.DATA.legalType = BANCS.INPUT.legalType
                PRINT(CUST.DATA.legalType)
        #}
        ENDIF
	
	IF(CUST.DATA.bankId == "") THEN
	#{
		sv_u = urhk_SetOrbOut("Failed| Please enter Bank Id")
                print(sv_u)
		
		EXITSCRIPT
	#}
	ENDIF

	IF((CUST.DATA.businessType == "") and (CUST.DATA.legalType == ""))THEN
	#{
		sv_u = urhk_SetOrbOut("Failed| Please enter either Business Type/Legal Entity Type")
                print(sv_u)

                EXITSCRIPT
	#}
	ENDIF

	IF(CUST.DATA.businessType != "")THEN
	#{
		IF(CUST.DATA.businessType != "BUSINESS")THEN
		#{
			sv_u = urhk_SetOrbOut("Failed| Kindly pass the correct value as 'BUSINESS'")
			print(sv_u)

			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	IF(CUST.DATA.legalType != "")THEN
        #{
                IF(CUST.DATA.legalType != "LEGAL")THEN
                #{
                        sv_u = urhk_SetOrbOut("Failed| Kindly pass the correct value as 'LEGAL'")
                        print(sv_u)

                        EXITSCRIPT
                #}
                ENDIF
        #}
        ENDIF

	IF((CUST.DATA.bankId != "") and (CUST.DATA.businessType != ""))THEN
	#{
		IF(CUST.DATA.businessType == "BUSINESS")THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.bankId
			print(BANCS.INPARAM.BINDVARS)

			sv_a = "businessTypeCode,businessTypeDesc|select unique value, localetext"
			sv_a = sv_a + " from crmuser.categories c, crmuser.category_lang l"
			sv_a = sv_a + " where c.bank_id=?SVAR and l.bank_id=c.bank_id and categorytype='BUS_TYPE' and c.categoryid=l.categoryid"
			print(sv_a)
	
			sv_d = urhk_dbCursorOpenWithBind(sv_a)
			print(sv_d)

			IF(sv_d!=0) THEN
			#{
				sv_u = urhk_dbCursorClose(sv_a)
				print(sv_u)

				sv_u = urhk_SetOrbOut("Status| No record found")
				print(sv_u)
			#}
			ELSE
			#{
				CUST.DATA.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				print(CUST.DATA.DB_CURSOR_NUMBER)

				sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
				print(sv_c)

				IF(sv_c != "0")THEN
				#{
					sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
					sv_u = urhk_SetOrbOut("Failure| No record found")	
					print(sv_u) 
				#}
				ENDIF

				while(sv_c ==0)
				#{
					CUST.DATA.businessTypeCode = BANCS.OUTPARAM.businessTypeCode
					print(CUST.DATA.businessTypeCode)
					CUST.DATA.businessTypeDesc = BANCS.OUTPARAM.businessTypeDesc
					print(CUST.DATA.businessTypeDesc)

					CUST.DATA.count = CINT(CUST.DATA.count)+ 1
					print(CUST.DATA.count)

					sv_c = urhk_SetOrbOut("BusinessTypeDetails.<rec_"+CUST.DATA.count+">.BusinessTypeCode"+"| "+CUST.DATA.businessTypeCode)
					print(sv_c)
					
					sv_c = urhk_SetOrbOut("BusinessTypeDetails.<rec_"+CUST.DATA.count+">.BusinessTypeDesc"+"| "+CUST.DATA.businessTypeDesc)
					print(sv_c)
					
					sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
					print(sv_c)
				#}
				do
				sv_c = urhk_dbCursorClose(CUST.DATA.DB_CURSOR_NUMBER)
				print(sv_c)
			#}
			ENDIF
		#}
		ELSE
		#{
			sv_u = urhk_SetOrbOut("Failed| Kindly pass the correct value as 'BUSINESS'")
                        print(sv_u)

                        EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	IF((CUST.DATA.bankId != "") and (CUST.DATA.legalType != ""))THEN
        #{
                IF(CUST.DATA.legalType == "LEGAL")THEN
                #{
                        BANCS.INPARAM.BINDVARS = CUST.DATA.bankId
                        print(BANCS.INPARAM.BINDVARS)

                        sv_a = "legalTypeCode,legalTypeDesc|select unique value, localetext"
                        sv_a = sv_a + " from crmuser.categories c, crmuser.category_lang l"
                        sv_a = sv_a + " where c.bank_id=?SVAR and l.bank_id=c.bank_id and categorytype='LEGAL_ENTITY' and c.categoryid=l.categoryid"
                        print(sv_a)

                        sv_d = urhk_dbCursorOpenWithBind(sv_a)
                        print(sv_d)

                        IF(sv_d!=0) THEN
                        #{
                                sv_u = urhk_dbCursorClose(sv_a)
                                print(sv_u)

                                sv_u = urhk_SetOrbOut("Status| No record found")
                                print(sv_u)
                        #}
                        ELSE
                        #{
                                CUST.DATA.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                                print(CUST.DATA.DB_CURSOR_NUMBER)

                                sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
                                print(sv_c)

                                IF(sv_c != "0")THEN
                                #{
                                        sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
                                        sv_u = urhk_SetOrbOut("Failure| No record found")
                                        print(sv_u)
                                #}
                                ENDIF
								
								 while(sv_c ==0)
                                #{
                                        CUST.DATA.legalTypeCode = BANCS.OUTPARAM.legalTypeCode
                                        print(CUST.DATA.legalTypeCode)
                                        CUST.DATA.legalTypeDesc = BANCS.OUTPARAM.legalTypeDesc
                                        print(CUST.DATA.legalTypeDesc)

                                        CUST.DATA.count = CINT(CUST.DATA.count)+ 1
                                        print(CUST.DATA.count)

                                        sv_c = urhk_SetOrbOut("LegalEntityTypeDetails.<rec_"+CUST.DATA.count+">.LegalTypeCode"+"| "+CUST.DATA.legalTypeCode)
                                        print(sv_c)

                                        sv_c = urhk_SetOrbOut("LegalEntityTypeDetails.<rec_"+CUST.DATA.count+">.LegalTypeDesc"+"| "+CUST.DATA.legalTypeDesc)
                                        print(sv_c)

                                        sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
                                        print(sv_c)
                                #}
                                do
                                sv_c = urhk_dbCursorClose(CUST.DATA.DB_CURSOR_NUMBER)
                                print(sv_c)
                        #}
                        ENDIF
                #}
                ELSE
                #{
                        sv_u = urhk_SetOrbOut("Failed| Kindly pass the correct value as 'LEGAL'")
                        print(sv_u)

                        EXITSCRIPT
                #}
                ENDIF
        #}
        ENDIF

EXITSCRIPT




