<--start
trace on
	
	sv_t = "ValidateBillerRef_RES.RefNum| " + CUST.INTERFACE.refNum
	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_t = "ValidateBillerRef_RES.AccountID| " + CUST.INTERFACE.accountID
	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_t = "ValidateBillerRef_RES.Name| " + CUST.INTERFACE.name
	sv_u = urhk_SetOrbOut(sv_t)
	
#trace off
end-->
