<--START
TRACE ON

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        ###########################################################################################
        # Check whether CIETXN Class exists else create it
        ###########################################################################################

        sv_r = CLASSEXISTS("CUST","CIETXN")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","CIETXN",5)
        #}
        ENDIF

        ###########################################################################################
        # Initialize the variables
        ###########################################################################################

        sv_u = urhk_b2k_printrepos("BANCS")
	CUST.CIETXN.refNum  = " "
        CUST.CIETXN.AcctNum = " "
        CUST.CIETXN.RefCrncy = " "
        CUST.CIETXN.userId = " "
        CUST.CIETXN.solId = " "
        CUST.CIETXN.errFlg = "N"
        CUST.CIETXN.errMsg = " "
        CUST.CIETXN.acctCrncy = " "
        CUST.CIETXN.AcctName = " "
	CUST.CIETXN.recCount = "0"
        CUST.CIETXN.payglFlg = "N"
		
	IF(FIELDEXISTS(BANCS.INPUT.AcctNum)) THEN
	#{
		IF(TRIM(BANCS.INPUT.AcctNum) != "")THEN
		#{
			CUST.CIETXN.AcctNum = BANCS.INPUT.AcctNum
		#}
		ENDIF
	#}
	ENDIF	
	IF(FIELDEXISTS(BANCS.INPUT.refNum)) THEN
	#{
		IF(TRIM(BANCS.INPUT.refNum) != "")THEN
		#{
			CUST.CIETXN.refNum = BANCS.INPUT.refNum
		#}
		ENDIF
	#}
	ENDIF	
	IF(FIELDEXISTS(BANCS.INPUT.refCrncy)) THEN
	#{
		IF(TRIM(BANCS.INPUT.refCrncy) != "")THEN
		#{
			CUST.CIETXN.RefCrncy = BANCS.INPUT.refCrncy
		#}
		ENDIF
	#}
	ENDIF	
        CUST.CIETXN.userId = BANCS.STDIN.userId
        CUST.CIETXN.solId  = BANCS.STDIN.mySolId
        PRINT(CUST.CIETXN.RefCrncy)
        PRINT(CUST.CIETXN.userId)
        PRINT(CUST.CIETXN.solId)
	PRINT(CUST.CIETXN.refNum)
		
	IF(TRIM(CUST.CIETXN.AcctNum) != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_s = "recCount|SELECT COUNT(1) FROM CUSTOM.IEPAGL WHERE IE_TXN_REF_NO=?SVAR AND TARGET_ENTITY_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.refNum + "|" + BANCS.STDIN.contextBankId
	PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)
        IF(sv_d ==0) THEN
        #{
                CUST.CIETXN.recCount = BANCS.OUTPARAM.recCount
	#}
	ENDIF
		
	IF(CUST.CIETXN.recCount == "0")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
		
        sv_s = "AcctNum,acctCrncy,AcctName|SELECT FORACID,ACCT_CRNCY_CODE,ACCT_NAME FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND SOL_ID=?SVAR AND ACCT_CRNCY_CODE=?SVAR AND "
        sv_s = sv_s + "BACID=(SELECT EMP_CASH_ACCT FROM TBAADM.GEC WHERE BANK_ID=?SVAR AND CRNCY_CODE=?SVAR AND SOL_ID=?SVAR AND EMP_ID =(SELECT USER_EMP_ID "
        sv_s = sv_s + " FROM TBAADM.UPR WHERE USER_ID=?SVAR))"

        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.solId + "|" + CUST.CIETXN.RefCrncy + "|" + BANCS.STDIN.contextBankId
        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.CIETXN.RefCrncy + "|" + CUST.CIETXN.solId + "|" + CUST.CIETXN.userId

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)
        IF(sv_d ==0) THEN
        #{
                CUST.CIETXN.AcctNum = BANCS.OUTPARAM.AcctNum
                CUST.CIETXN.acctCrncy = BANCS.OUTPARAM.acctCrncy
                CUST.CIETXN.AcctName = BANCS.OUTPARAM.AcctName
                PRINT(CUST.CIETXN.AcctNum)
                PRINT(CUST.CIETXN.acctCrncy)
                PRINT(CUST.CIETXN.AcctName)
        	CUST.CIETXN.payglFlg = "Y"
        #}
        ELSE
        #{
                CUST.CIETXN.errFlg = "Y"
                CUST.CIETXN.errMsg = "Cash Account for the entered refCrncy not exist for the user"
        #}
        ENDIF

		ENDOFSCRIPT:
                sv_u = urhk_SetOrbOut("errFlg|"+CUST.CIETXN.errFlg)
                PRINT(sv_u)
                sv_u = urhk_SetOrbOut("errMsg|"+CUST.CIETXN.errMsg)
                PRINT(sv_u)
                sv_u = urhk_SetOrbOut("AcctNum|"+CUST.CIETXN.AcctNum)
                PRINT(sv_u)
                sv_u = urhk_SetOrbOut("acctCrncy|"+CUST.CIETXN.acctCrncy)
                PRINT(sv_u)
                sv_u = urhk_SetOrbOut("AcctName|"+CUST.CIETXN.AcctName)
                PRINT(sv_u)
                sv_u = urhk_SetOrbOut("solId|"+CUST.CIETXN.solId)
                PRINT(sv_u)
                sv_u = urhk_SetOrbOut("payglFlg|"+CUST.CIETXN.payglFlg)
                PRINT(sv_u)
TRACE OFF
END-->
