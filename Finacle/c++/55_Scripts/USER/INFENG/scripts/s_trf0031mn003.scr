<--START
CHECKSUM="80e21ca8bf365a38f2e29386a7a10aaef066e063c5ed4bbb71bf662b9d229643"
	TRACE ON
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","TRF0031") == 0) THEN
	#{
		CREATECLASS("CUST","TRF0031",5)
	#}
	ENDIF
	
	CUST.TRF0031.remtId =""
	CUST.TRF0031.errorMsg =""
	#---------------------------------------------------------------------------------------------
	#User hook used to get dc Number from screen
	#---------------------------------------------------------------------------------------------
	IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1) THEN
	#{
		CUST.TRF0031.menuId = BANCS.STDIN.menuId
		PRINT(CUST.TRF0031.menuId)
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_a=urhk_SRV_GetVal("remCritDtls.remitId")
	IF(sv_a == 0) THEN
	#{
		CUST.TRF0031.remtId = trim(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.TRF0031.remtId)
		#}
	ELSE
		#{
		CUST.TRF0031.errorMsg = "Unable to get  remtId from front end"
		sv_v = urhk_SRV_SetErr(CUST.TRF0031.errorMsg)
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------------------------
	#Updating the entity creation flg To 'Y'
	#---------------------------------------------------------------------------------------------
	sv_s = ""
	sv_s = sv_s + "cnt|"
	sv_s = sv_s + " SELECT COUNT(*)"
	sv_s = sv_s + " FROM CUSTOM.C_PTYDTL"
	sv_s = sv_s + " WHERE C_PTYDTL.remt_id =?SVAR"
	sv_s = sv_s + " AND C_PTYDTL.entity_cre_flg ='N'"
	sv_s = sv_s + " AND C_PTYDTL.del_flg = 'N'"
	sv_s = sv_s + " AND C_PTYDTL.bank_id = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS	=""
	BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
	BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d ==0) THEN
	#{
		IF(CINT(BANCS.OUTPARAM.cnt) >0) THEN
		#{
			sv_s = ""
			sv_s = sv_s + " UPDATE CUSTOM.C_PTYDTL"
			sv_s = sv_s + " SET C_PTYDTL.entity_cre_flg = 'Y'"
			sv_s = sv_s + " WHERE C_PTYDTL.remt_id = ?SVAR"
			sv_s = sv_s + " AND C_PTYDTL.entity_cre_flg ='N'"
			sv_s = sv_s + " AND C_PTYDTL.del_flg = 'N' "
			sv_s = sv_s + " AND C_PTYDTL.bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS	=""
			BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
			BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d == 0) THEN
			#{
				sv_d = urhk_dbSQLWithBind("commit")
				PRINT(sv_d)
				#}
			ELSE
				#{
				CUST.TRF0031.errMsg = "The records are not commited"
				sv_v = urhk_SRV_SetErr(CUST.TRF0031.errorMsg)
			#}
			ENDIF
			
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.TRF0031.errMsg = "Unable to find records for the remittance id"
		sv_v = urhk_SRV_SetErr(CUST.TRF0031.errorMsg)
		
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
