#-------------------------------------------------------------------------------------
#    Name               : cecsmidp002.scr
#    Description        : This script will give the details of the account number from EMD table.
#    Date               : 16-02-2013
#    Author             : Chandrasekhar
#    Input              : NA
#    Output             : It gives the EMD details for the account number.
#    Called Script      : NA
#    Calling Script     : cecsmi_det_glink.js
#    Menu Option        :
#    Srl. No        Date            Author          Description.
#    -------        ----            ------          ----------------
#    1.0            16-02-2013      Chandrasekhar   Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="f30cc5e2410d435304d168bf8ebf91c0f620b1970ef1378f6f3f029b156ea448"
	TRACE ON
	sv_r = REPEXISTS("CUST")
	
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "PORT")
	
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "PORT", 5)
	#}
	ENDIF
	print(BANCS.INPUT.forAcid)
	CUST.PORT.forAcid = BANCS.INPUT.forAcid
	CUST.PORT.mandNum = ""
	CUST.PORT.strtDate = ""
	CUST.PORT.endDate = ""
	CUST.PORT.refId = ""
	CUST.PORT.amount = ""
	CUST.PORT.tranCode = ""
	CUST.PORT.count = ""
	CUST.PORT.outWard = ""
	CUST.PORT.inWard = ""
	sv_a =1
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="TRANCODE"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.PORT.tranCode = BANCS.OUTPUT.parameterVal
		print(CUST.PORT.tranCode)
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr(BANCS.INPUT.parameterId+"setup is not done in CPARAM")
		GOTO FINISH
	#}
	ENDIF
	
	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50")) THEN
	#{
		CUST.PORT.outWard = "O"
		CUST.PORT.inWard  = "I"
	#}
	ENDIF
	
	IF((BANCS.STDIN.contextBankId == "56") OR (BANCS.STDIN.contextBankId == "11")) THEN
	#{
		CUST.PORT.outWard = "O"
		CUST.PORT.inWard  = "O"
	#}
	ENDIF
	
	sv_p = "recCount|"
	sv_p = sv_p +" SELECT"
	sv_p = sv_p +" COUNT(*)"
	sv_p = sv_p +" FROM"
	sv_p = sv_p +" TBAADM.EMD"
	sv_p = sv_p +" WHERE"
	sv_p = sv_p +" b2k_type = 'ACCNT'"
	sv_p = sv_p +" AND in_out_ind IN('"+CUST.PORT.inWard+"','"+CUST.PORT.outWard+"')"
	sv_p = sv_p +" AND dr_cr_ind = 'D'"
	sv_p = sv_p +" AND transaction_code = ?SVAR"
	sv_p = sv_p +" AND bank_id = ?SVAR"
	sv_p = sv_p +" AND EMD.b2k_id IN ("
	sv_p = sv_p +" SELECT acid"
	sv_p = sv_p +" FROM TBAADM.GAM"
	sv_p = sv_p +" WHERE foracid = ?SVAR AND bank_id = ?SVAR)"
	sv_p = sv_p +" AND EMD.del_flg != 'Y'"
	
	BANCS.INPARAM.BINDVARS = CUST.PORT.tranCode + "|" + BANCS.STDIN.contextBankId + "|" + CUST.PORT.forAcid + "|" + BANCS.STDIN.contextBankId
	sv_q = urhk_dbselectWithBind(sv_p)
	sv_q = urhk_SetOrbOut("recCount|"+BANCS.OUTPARAM.recCount)
	
	sv_s = "mandNum,strtDate,endDate,refId,amount|"
	sv_s = sv_s +" SELECT"
	sv_s = sv_s +" mandate_srl_num,"
	sv_s = sv_s +" TO_CHAR(start_date,'DD-MM-YYYY'),"
	sv_s = sv_s +" TO_CHAR(end_date,'DD-MM-YYYY'),"
	sv_s = sv_s +" reference_id_1,"
	sv_s = sv_s +" TO_CHAR(amount,'9,99,99,99,99,99,990.99')"
	sv_s = sv_s +" FROM"
	sv_s = sv_s +" TBAADM.EMD"
	sv_s = sv_s +" WHERE"
	sv_s = sv_s +" b2k_type = 'ACCNT'"
	sv_s = sv_s +" AND in_out_ind IN('"+CUST.PORT.inWard+"','"+CUST.PORT.outWard+"')"
	sv_s = sv_s +" AND dr_cr_ind = 'D'"
	sv_s = sv_s +" AND transaction_code = '"+CUST.PORT.tranCode+"'"
	sv_s = sv_s +" AND bank_id = '"+BANCS.STDIN.contextBankId+"'"
	sv_s = sv_s +" AND EMD.b2k_id IN ("
	sv_s = sv_s +" SELECT acid"
	sv_s = sv_s +" FROM TBAADM.GAM"
	sv_s = sv_s +" WHERE foracid = '"+CUST.PORT.forAcid+"'"
	sv_s = sv_s +" AND bank_id = '"+BANCS.STDIN.contextBankId+"')"
	sv_s = sv_s +" AND EMD.del_flg != 'Y'"
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	
	
	IF( sv_c != 0) THEN
	#{
		sv_u = urhk_SRV_SetErr("No recods fetched for the entered Account Number")
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		
		WHILE( sv_c == 0)
		#{
			CUST.PORT.mandNum=BANCS.OUTPARAM.mandNum
			print(CUST.PORT.mandNum)
			CUST.PORT.strtDate=BANCS.OUTPARAM.strtDate
			print(CUST.PORT.strtDate)
			CUST.PORT.endDate = BANCS.OUTPARAM.endDate
			print(CUST.PORT.endDate)
			CUST.PORT.refId = BANCS.OUTPARAM.refId
			print(CUST.PORT.refId)
			CUST.PORT.amount = BANCS.OUTPARAM.amount
			print(CUST.PORT.amount)
			CUST.PORT.count = sv_a
			sv_z = "mandNum_" + CUST.PORT.count
			sv_z = sv_z + "|" + CUST.PORT.mandNum
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "strtDate_" + CUST.PORT.count
			sv_z = sv_z + "|" + CUST.PORT.strtDate
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "endDate_" + CUST.PORT.count
			sv_z = sv_z + "|" + CUST.PORT.endDate
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "refId_" + CUST.PORT.count
			sv_z = sv_z + "|" + CUST.PORT.refId
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "amount_" + CUST.PORT.count
			sv_z = sv_z + "|" + CUST.PORT.amount
			sv_u = urhk_SetOrbOut(sv_z)
			sv_c = urhk_dbCursorFetch(sv_l)
			sv_a = sv_a + 1
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
	#}
	ENDIF
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
