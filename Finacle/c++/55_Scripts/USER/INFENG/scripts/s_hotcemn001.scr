			#{
				CUST.HOTCE.suspenseGl = BANCS.OUTPUT.parameterVal
				print(CUST.HOTCE.suspenseGl)

			#}
			ELSE
			#{
				CUST.HOTCE.errMsg = " Gl setup not done in CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.HOTCE.foracid1 = MID$(CUST.HOTCE.acctId,3,13)
			PRINT(CUST.HOTCE.foracid1)

			IF (CUST.HOTCE.foracid1 == CUST.HOTCE.suspenseGl) THEN
			#{
				IF ((CUST.HOTCE.acctId != "2223000100774") AND (CUST.HOTCE.acctId != "0003000100774")) THEN
				#{
					IF (CDOUBLE(CUST.HOTCE.remitAmt) > CDOUBLE(CUST.HOTCE.preEffAvailableAmt)) THEN
					#{
