			CUST.HOTCE.remitAmt = TRIM(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.HOTCE.remitAmt)
			CUST.HOTCE.remitAmt = LEFT$(CUST.HOTCE.remitAmt,GETPOSITION(CUST.HOTCE.remitAmt,"|") - 1)
			PRINT(CUST.HOTCE.remitAmt)
			#}
		ELSE
			#{
			CUST.HOTCE.errMsg = "Error in finding remitAmt"
			PRINT(CUST.HOTCE.errMsg)
