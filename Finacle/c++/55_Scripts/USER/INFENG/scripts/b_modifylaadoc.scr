<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUSTS") == 0) THEN
#{
	CREATEREP("CUSTS")
#}
ENDIF

IF (CLASSEXISTS("CUSTS","ACMLA") == 0) THEN
#{
	CREATECLASS("CUSTS","ACMLA",5)
#}
ENDIF

IF (CLASSEXISTS("CUSTS","ACMLA") == 0) THEN
#{
    CREATECLASS("CUSTS","ACMLA", 5)
#}
ENDIF
#------------------------------------------------------------------------------
#Initialisig required repository variables 
#------------------------------------------------------------------------------
CUSTS.ACMLA.errMsg = ""

#------------------------------------------------------------------------------
#Finding count of records that need to be processed
#------------------------------------------------------------------------------

sv_a=urhk_B2k_PrintRepos("BANCS")
print (sv_a)

sv_s="custcount|"
sv_s = sv_s + " SELECT COUNT(1) "
sv_s = sv_s + " FROM custom.bulk_cif "
sv_s = sv_s + " WHERE ENTITY_CRE_FLG='N' "
sv_s = sv_s + " AND bank_id = ?SVAR"
print(sv_s)
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
IF (sv_d != 0) THEN 
#{
	CUSTS.ACMLA.errMsg = "DB ERROR!"
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	print(BANCS.OUTPARAM.custcount)
	IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF

sv_s="foracid,solid,secured,collateral,valuationdate,marketvalue,forcedvalue,doccode|"
sv_s = sv_s + " SELECT foracid,sol_id,GENDER,OTHERS,DATE_OF_BIRTH,FIRST_NAME,MIDDLE_NAME,SUR_NAME "
sv_s = sv_s + " FROM custom.bulk_cif "
sv_s = sv_s + " WHERE entity_cre_flg='N' "
sv_s = sv_s + " AND bank_id = ?SVAR"
print(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)

sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c==0) then
#{
	CUSTS.ACMLA.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_k = urhk_dbCursorFetch(CUSTS.ACMLA.DbcursorNumber)
	print(sv_k)

	WHILE (sv_k == 0)
	#{
		CUSTS.ACMLA.foracid	= BANCS.OUTPARAM.foracid
		CUSTS.ACMLA.solid	= BANCS.OUTPARAM.solid
		CUSTS.ACMLA.secured	= BANCS.OUTPARAM.secured
		CUSTS.ACMLA.collateral	= BANCS.OUTPARAM.collateral
		CUSTS.ACMLA.valuationdate	= BANCS.OUTPARAM.valuationdate
		CUSTS.ACMLA.marketvalue	= BANCS.OUTPARAM.marketvalue
		CUSTS.ACMLA.forcedvalue	= BANCS.OUTPARAM.forcedvalue
		CUSTS.ACMLA.doccode	= BANCS.OUTPARAM.doccode
		
		print(CUSTS.ACMLA.foracid)
		print(CUSTS.ACMLA.solid)
		print(CUSTS.ACMLA.secured)
		print(CUSTS.ACMLA.collateral)
		print(CUSTS.ACMLA.valuationdate)
		print(CUSTS.ACMLA.marketvalue)
		print(CUSTS.ACMLA.forcedvalue)
		print(CUSTS.ACMLA.doccode)
		print(BANCS.STDIN.mySolId)
		
		IF(CUSTS.ACMLA.solid != BANCS.STDIN.mySolId)THEN
		#{
			sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.ACMLA.solid)
			print(sv_u)
			sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			print(sv_u)
		#}
		ENDIF
		
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUSTS.ACMLA.foracid
			sv_s = " acid,AcctsolId,schmCode,schmType,acctClsFlag,sweeps,acctCrncyCode,acctMgr|select acid,sol_id,schm_code, schm_type, acct_cls_flg,allow_sweeps, acct_crncy_code,ACCT_MGR_USER_ID from tbaadm.gam "
			sv_s = sv_s + "where bank_id = ?SVAR "
			sv_s = sv_s + "and foracid = ?SVAR "
			sv_s = sv_s + "and acct_cls_flg != 'Y' "
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)

			IF (sv_d == 0) THEN
			#{
			CUSTS.ACMLA.acid = BANCS.OUTPARAM.acid
			PRINT(sv_d)
			CUSTS.ACMLA.AcctsolId = BANCS.OUTPARAM.AcctsolId
			PRINT(CUSTS.ACMLA.acid)
			CUSTS.ACMLA.schmCode = BANCS.OUTPARAM.schmCode
			PRINT(CUSTS.ACMLA.schmCode)
			CUSTS.ACMLA.schmType = BANCS.OUTPARAM.schmType
			PRINT(CUSTS.ACMLA.schmType)
			CUSTS.ACMLA.acctClsFlag = BANCS.OUTPARAM.acctClsFlag
			PRINT(CUSTS.ACMLA.acctClsFlag)
			CUSTS.ACMLA.sweeps = BANCS.OUTPARAM.sweeps
			PRINT(CUSTS.ACMLA.sweeps)
			CUSTS.ACMLA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
			PRINT(CUSTS.ACMLA.acctCrncyCode)
			CUSTS.ACMLA.acctMgr = BANCS.OUTPARAM.acctMgr
			PRINT(CUSTS.ACMLA.acctMgr)
			#}
			ELSE
			#{
			GOTO ERROR
			#}
			ENDIF
		#--------------------------------------------------------------------------------------------------------------
		#--------------------------------------------------------------------------------------------------------------
		#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.creationMode|M")
		#PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.ACMLA.foracid)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTS.ACMLA.acid)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.ACMLA.schmCode)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTS.ACMLA.schmType)
		PRINT(sv_u)
		
		sv_u = urhk_ExecSrv("SRV_FetchLAAcctDtlForModify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
			IF (sv_u == 0) THEN
			
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)

			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.ACMLA.foracid)
			PRINT(sv_u)
			#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.creationMode|M")
			#PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTS.ACMLA.acid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTS.ACMLA.schmType)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.ACMLA.schmCode)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|" + CUSTS.ACMLA.sweeps)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctClsFlag|" + CUSTS.ACMLA.acctClsFlag)
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
			PRINT(sv_u)
			
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctMgrAtAcct.userId|" + CUSTS.ACMLA.acctMgr)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctCrncyCode.crncyCode|" + CUSTS.ACMLA.acctCrncyCode)
			PRINT(sv_u)

			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentEntered|1")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.key.serial_num|1")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.documentCode.refCode|" + CUSTS.ACMLA.doccode)
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.documentCode.refRecType|BX")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.dueDate|31-12-2015")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.docScanFlg|N")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.freeText2|" + CUSTS.ACMLA.secured)
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.freeText3|" + CUSTS.ACMLA.collateral)
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.freeText4|" + CUSTS.ACMLA.valuationdate)
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.freeText5|" + CUSTS.ACMLA.marketvalue)
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctDocument.acctDocumentLL.<rec_0>.freeText6|" + CUSTS.ACMLA.forcedvalue)
			PRINT(sv_u)
			


			sv_u = urhk_ExecSrv("SRV_ModifyLAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)

			IF (sv_u == 0) THEN
				
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					sv_s = "UPDATE custom.bulk_cif "
					sv_s = sv_s + " SET entity_cre_flg = 'P'"
					sv_s = sv_s + " WHERE foracid= ?SVAR"
					sv_s = sv_s + " AND bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUSTS.ACMLA.foracid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
			
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
			ENDIF

			ENDIF

			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{

				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}									
				ELSE
				#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) then
				#{
					sv_u = system("echo 'Error for Acct:"+CUSTS.ACMLA.foracid+" ' >>hacmla.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>hacmla.log")
						print(sv_u)
					#}
					DO
				#}
				ENDIF
					CUSTS.ACMLA.errMsg=sv_e
					print(CUSTS.ACMLA.errMsg)
					#-----------------------------------------------------------------------------------
					# Update custom table status
					#-----------------------------------------------------------------------------------
					sv_s = "UPDATE custom.bulk_cif "
					sv_s = sv_s + " SET entity_cre_flg = 'E',"
					sv_s = sv_s + " ERROR_CODE= ?SVAR"
					sv_s = sv_s + " WHERE foracid= ?SVAR"
					sv_s = sv_s + " AND bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUSTS.ACMLA.errMsg + "|" + CUSTS.ACMLA.foracid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
			
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
			#}
			ENDIF
	ERROR:
	IF (sv_d !=0)THEN
		#-----------------------------------------------------------------------------------
		# Update custom table status
		#-----------------------------------------------------------------------------------
		sv_s = "UPDATE custom.bulk_cif "
		sv_s = sv_s + " SET entity_cre_flg = 'C'"
		sv_s = sv_s + " WHERE foracid= ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUSTS.ACMLA.foracid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbSQLWithBind(sv_s)
		IF (sv_d == 0) THEN
		#{
			sv_c = urhk_dbSQLWithBind("commit")
			print(sv_c)
		#}
		ENDIF
	#}
	ENDIF
	sv_k = urhk_dbCursorFetch(CUSTS.ACMLA.DbcursorNumber)
	print(sv_k)
	
	#}
	DO

	sv_c = urhk_dbCursorClose(CUSTS.ACMLA.DbcursorNumber)
	print(sv_c)
#}
ENDIF

ENDOFSCRIPT:
IF(CUSTS.ACMLA.errMsg != "") THEN
#{
    sv_u = system("echo '"+CUSTS.ACMLA.errMsg+"' >>hacmla.log")
#}
ENDIF

EXITSCRIPT
