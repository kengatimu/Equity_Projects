<--START
CHECKSUM="abc86936416d2540f0ebb1d893bba8b5f803d6513ddd85cf7f586339bb400be3"
	TRACE ON
	
	PRINT(CUST.CIECLG.zoneCode)
	PRINT(CUST.CIECLG.zoneDate)
	PRINT(CUST.CIECLG.setNum)
	PRINT(CUST.CIECLG.rejectReasonCode)
	
	CUST.CIECLG.iZoneCode = ""
	CUST.CIECLG.iZoneDate = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.CIECLG.foracid = ""
	
	IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
	#{
		sv_a = CUST.CIECLG.crAcctNum
		print(sv_a)
		CUST.CIECLG.foracid = CUST.CIECLG.crAcctNum
		CUST.CIECLG.presentingBankCode = CUST.CIECLG.defaultBankCode
		CUST.CIECLG.presentingBranchCode = CUST.CIECLG.defaultBranchCode
		CUST.CIECLG.presentingSortCode = " "
		#}
	ELSE
		#{
		sv_a = CUST.CIECLG.nostroAcct
		print(sv_a)
		CUST.CIECLG.foracid = CUST.CIECLG.nostroAcct
		CUST.CIECLG.presentingBankCode = CUST.CIECLG.instrumentBankCode
		CUST.CIECLG.presentingBranchCode = CUST.CIECLG.instrumentBranchCode
		CUST.CIECLG.presentingSortCode = CUST.CIECLG.instrumentSortCode
	#}
	ENDIF
	
	PRINT(CUST.CIECLG.foracid)
	PRINT(CUST.CIECLG.presentingBankCode)
	PRINT(CUST.CIECLG.presentingBranchCode)
	PRINT(CUST.CIECLG.presentingSortCode)
	
	CUST.CIECLG.parameterId = "CL_OUTREJ_INW_ZONE_CODE_" + BANCS.STDIN.contextBankId
	print(CUST.CIECLG.parameterId)
	sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^Inward Clearing Zone Code not set in CPARAM for marking Outward Reject" + "^prodCode"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
	PRINT(CUST.CIECLG.parameterValue)
	
	CUST.CIECLG.iZoneCode = CUST.CIECLG.parameterValue
	PRINT(CUST.CIECLG.iZoneCode)
	
	IF(TRIM(CUST.CIECLG.iZoneCode) == "")THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^Inward Clearing Zone Code not set in CPARAM for marking Outward Reject" + "^prodCode"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	##################################################################################
	# SRV Input
	##################################################################################
	
	sv_u = urhk_SetUrhkInp("zoneDtl.zone.zoneCode|"+CUST.CIECLG.iZoneCode)
	sv_s = CUST.CIECLG.iZoneDate + " 00:00:00"
	sv_u = urhk_SetUrhkInp("zoneDtl.zoneDate|"+sv_s)
	sv_u = urhk_SetUrhkInp("zoneDtl.sol.solId|"+BANCS.STDIN.mySolId)
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltIcTranDtl|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_u = urhk_CopyOutToIn("")
	print(sv_u)
	
	sv_u = urhk_SetUrhkInp("instrmntDtl.acct.foracid|"+CUST.CIECLG.foracid)
	sv_u = urhk_SetUrhkInp("instrmntDtl.instrmntNum|"+CUST.CIECLG.instrumentNum)
	sv_u = urhk_SetUrhkInp("instrmntDtl.instrmntAmt|"+CUST.CIECLG.instrumentAmt+"|"+CUST.CIECLG.instrumentAmtCcy)
	sv_u = urhk_SetUrhkInp("instrmntDtl.rejType.code|O")
	sv_u = urhk_SetUrhkInp("instrmntRejDtl.rejType.code|O")
	sv_u = urhk_SetUrhkInp("instrmntRejDtl.rejCode1.rejectCode|"+CUST.CIECLG.rejectReasonCode)
	sv_u = urhk_SetUrhkInp("instrmntDtl.carveFlg|N")
	#sv_u = urhk_SetUrhkInp("instrmntDtl.presSortCode|"+CUST.CIECLG.presentingSortCode)
	sv_u = urhk_SetUrhkInp("instrmntDtl.presBr.bankCode|"+CUST.CIECLG.presentingBankCode)
	sv_u = urhk_SetUrhkInp("instrmntDtl.presBr.brCode|"+CUST.CIECLG.presentingBranchCode)
	
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltOutRejDtl|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_u = urhk_CopyOutToIn("")
	print(sv_u)
	
	sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZone.zoneCode|"+CUST.CIECLG.zoneCode)
	sv_s = CUST.CIECLG.zoneDate + " 00:00:00"
	sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneDate|"+sv_s)
	sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSol.solId|"+BANCS.STDIN.mySolId)
	sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSetNum|"+CUST.CIECLG.setNum)
	sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejInstrmntSrlNum|1")
	sv_u = urhk_ExecSrvNoCommit("SRV_AddIcTranDtlAndVerify|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
END-->
