			sv_s = sv_s + " user_cash_cr_lim,"
			sv_s = sv_s + " user_clg_cr_lim,"
			sv_s = sv_s + " user_xfer_cr_lim,"
			sv_s = sv_s + " user_intersol_cash_cr_limit,"
			sv_s = sv_s + " user_intersol_clg_cr_limit,"
			sv_s = sv_s + " user_intersol_xfer_cr_limit,"
			sv_s = sv_s + " crncy_code,"
			sv_s = sv_s + " del_flg,"
			sv_s = sv_s + " ent_cre_flg,"
			sv_s = sv_s + " lchg_user_id,"
			sv_s = sv_s + " lchg_time,"
			sv_s = sv_s + " rcre_user_id,"
			sv_s = sv_s + " rcre_time,"
			sv_s = sv_s + " bank_id ) values ("
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + "'N',"
			sv_s = sv_s + "'N',"
