			BANCS.INPARAM.BINDVARS =  BANCS.INPUT.roleId + "|" + CUST.DATA.cashcrlm + "|" + CUST.DATA.clrncrlm + "|" + CUST.DATA.trnsfrcrlm + "|" + CUST.DATA.cashsollm + "|" + CUST.DATA.clgintsolmt + "|" + CUST.DATA.trnsfrsollm + "|" + CUST.DATA.currencycode + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
			sv_u = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				sv_e = "Error in Adding Details"
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				EXITSCRIPT
				#}
			ELSE
				#{
				sv_e = "RESULT_MSG|Record Added"
				PRINT(sv_e)
				sv_u = urhk_SetOrbOut(sv_e)
				PRINT(sv_u)
				sv_r = urhk_dbSQLWithBind("Commit")
				PRINT(sv_r)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
				PRINT(sv_u)
				EXITSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (BANCS.INPUT.funcCode == "M") THEN
	#{
		sv_s = "count1|SELECT COUNT(1)"
		sv_s = sv_s + "FROM CUSTOM.CRCL "
		sv_s = sv_s + "WHERE del_flg = 'N' "
		sv_s = sv_s + "AND role_id = ?SVAR "
