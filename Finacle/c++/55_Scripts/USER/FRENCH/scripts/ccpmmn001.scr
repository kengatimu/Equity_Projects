	PRINT(CUST.DATA.cashsollm)
	#PRINT(CUST.DATA.trnsfrsollm)
	PRINT(CUST.DATA.clgintsolmt)
	
	#------------------------------------------------------------------------------------------
	# If Function Value is "A" then INSERTING INTO TABLE CUSTOM.CRCL
	#------------------------------------------------------------------------------------------
	
	
	IF (BANCS.INPUT.funcCode=="A") THEN
	#{
		CUST.DATA.currencycode = BANCS.INPUT.currency
		CUST.DATA.cashcrlm = CDOUBLE(BANCS.INPUT.cashCrLm)
		CUST.DATA.cashcrlm = CDOUBLE(BANCS.INPUT.cashCrLm)
