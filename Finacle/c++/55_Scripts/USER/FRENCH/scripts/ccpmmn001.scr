		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.roleId)
	PRINT(BANCS.INPUT.cashCrLm)
	PRINT(BANCS.INPUT.TrnsfrCrLm)
