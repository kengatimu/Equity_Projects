		sv_s = "UPDATE CUSTOM.CRCL SET del_flg = 'Y' "
		sv_s = sv_s + " WHERE role_id =  ?SVAR"
		sv_s = sv_s + " AND crncy_code = ?SVAR"
		sv_s = sv_s + " AND bank_id =?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.INPUT.roleId  + "|" + CUST.DATA.currencycode + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_u = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_dbSQLWithBind("Commit")
			sv_e = "RESULT_MSG|Record Deleted"
			PRINT(sv_e)
			sv_u = urhk_SetOrbOut(sv_e)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			PRINT(sv_u)
			EXITSCRIPT
			#}
		ELSE
			#{
			PRINT("Problem Here")
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	
	ENDOFSCRIPT:
		
		TRACE OFF
		EXITSCRIPT
END-->
