<--START
CHECKSUM="e08dd2a179efca436ebce078054c25ce5acfa8a723b7d9250e46cb107f16c656"
	TRACE ON
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
