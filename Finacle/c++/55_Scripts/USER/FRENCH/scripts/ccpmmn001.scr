		sv_s = sv_s + " AND crncy_code = ?SVAR"
		sv_s = sv_s + " AND bank_id =?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.INPUT.roleId  + "|" + CUST.DATA.currencycode + "|" + BANCS.STDIN.contextBankId
		sv_u=urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		PRINT(BANCS.OUTPARAM.count)
		
		IF (BANCS.OUTPARAM.count== "1") THEN
		#{
			sv_e = "Record Already Exist. Use M as Function"
			sv_m = "funcCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			EXITSCRIPT
			#}
		ELSE
