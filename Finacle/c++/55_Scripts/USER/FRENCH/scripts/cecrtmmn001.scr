<--START
CHECKSUM="bfbe4e66691b7bc0a07f1178a816cef18a23ca50ed1c3ff7434b689b0076a689"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "BNKCQPR") == 0) THEN
	#{
		CREATECLASS("CUST", "BNKCQPR", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.reportTo)
	PRINT(BANCS.INPUT.tranSub)
	PRINT(BANCS.INPUT.upldFile)
	PRINT(BANCS.INPUT.test)
	PRINT(BANCS.INPUT.tranRemark)
	
	sv_s = "tmpname|SELECT to_char(sysdate,'ddmmyyhhmmss')"
	sv_s = sv_s + " FROM DUAL"
	
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d ==0) THEN
	#{
		CUST.BNKCQPR.tmpfilename = BANCS.OUTPARAM.tmpname + "." + "txt"
		
	#}
	ENDIF
	CUST.BNKCQPR.upldFile = BANCS.INPUT.upldFile
	CUST.BNKCQPR.test     = BANCS.INPUT.test
	CUST.BNKCQPR.remarks  = BANCS.INPUT.tranRemark
	CUST.BNKCQPR.tranSub = BANCS.INPUT.tranSub
	CUST.BNKCQPR.userPass = ""
	CUST.BNKCQPR.ctlPath  = ""
	CUST.BNKCQPR.dataPath = ""
	CUST.BNKCQPR.upldPath = ""
	CUST.BNKCQPR.ctfthnm  = ""
	CUST.BNKCQPR.fileNamePath = ""
	CUST.BNKCQPR.acctno = ""
	CUST.BNKCQPR.solid = ""
	CUST.BNKCQPR.ttumsal_mod = ""
	CUST.BNKCQPR.Rename = ""
	CUST.BNKCQPR.errMsg = ""
	
	BANCS.INPUT.moduleName = "ECRTUPLOAD"
	BANCS.INPUT.parameterId = "ECRTACCTNO"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.BNKCQPR.acctno = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.BNKCQPR.errMsg = " Account no setup not done in CPARAM"
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	BANCS.INPUT.parameterId = "ECRTS0LID"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.BNKCQPR.solid = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.BNKCQPR.errMsg = " Account no setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# All Path setting getting from the Environment
	#---------------------------------------------------------------------------------------------
	
	sv_u = urhk_getEnv("USER_PASS")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^User Id Password is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.envValue)
		CUST.BNKCQPR.userPass = BANCS.OUTPARAM.envValue
		PRINT(CUST.BNKCQPR.userPass)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("CTL_PATH")
	PRINT(sv_u)
	#sv_u = 0
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.envValue)
		CUST.BNKCQPR.ctlPath = BANCS.OUTPARAM.envValue
		PRINT(CUST.BNKCQPR.ctlPath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("DATA_PATH")
	PRINT(sv_u)
	sv_u = 0
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Data file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.envValue)
		CUST.BNKCQPR.dataPath = BANCS.OUTPARAM.envValue
		PRINT(CUST.BNKCQPR.dataPath)
		
		#----------TOL - 367144-------------#
		BANCS.INPUT.upldPath = CUST.BNKCQPR.dataPath
		#---------------------------------------------------------------
		# Calling common script to append userId to upload file path
		#---------------------------------------------------------------
		CALL("appendUserId.scr")
		CUST.BNKCQPR.dataPath = BANCS.INPUT.upldPath
		PRINT(CUST.BNKCQPR.dataPath)
		
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#The foll step is to Validate Upload file name
	#------------------------------------------------------------------------------
	
	PRINT(CUST.BNKCQPR.upldFile)
	
	IF (CUST.BNKCQPR.upldFile == "") THEN
	#{
		sv_e = "The upload file name should be entered"
		sv_m = "upldFile"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		
		#}
	ELSE
		#{
		sv_a = "test -f " + CUST.BNKCQPR.dataPath + CUST.BNKCQPR.upldFile
		PRINT(sv_a)
		sv_r = SYSTEM(sv_a)
		PRINT(sv_r)
		
		IF (sv_r != 0) THEN
		#{
			sv_e = "The Upload File name does not exist OR the wrong uploadfile name "
			sv_m = "upldFile"
			sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "sed 's/$/|" + BANCS.STDIN.contextBankId + "/g' " + CUST.BNKCQPR.dataPath + CUST.BNKCQPR.upldFile  + " > "  + CUST.BNKCQPR.tmpfilename
		print(sv_a)
		sv_r = SYSTEM(sv_a)
		PRINT(sv_r)
		
		#	sv_s = "cp " + CUST.BNKCQPR.tmpfilename + " " + CUST.BNKCQPR.dataPath + CUST.BNKCQPR.upldFile
		#	print(sv_s)
		#    sv_r = SYSTEM(sv_s)
		#    PRINT(sv_r)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#The foll step is to Validate test flag
	#------------------------------------------------------------------------------
	
	PRINT(CUST.BNKCQPR.test)
	
	IF (CUST.BNKCQPR.test == "") THEN
	#{
		sv_e = "The test flag should be entered"
		sv_m = "test"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF ((CUST.BNKCQPR.test != "Y") AND (CUST.BNKCQPR.test != "N")) THEN
		#{
			sv_e = "Inavlid test flag  'Y' OR 'N' "
			sv_m = "test"
			sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate remarks
	#---------------------------------------------------------------------------
	
	PRINT(CUST.BNKCQPR.remarks)
	
	IF (CUST.BNKCQPR.remarks == "") THEN
	#{
		sv_e = "The Transaction Particulars should be entered "
		sv_m = "remarks"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#----------------------------------------------------------------------------
	# Deleteting custom table data
	#----------------------------------------------------------------------------
	
	sv_s = "DELETE CUSTOM.EXCANRE_TABLE "
	sv_s = sv_s + "WHERE bank_id = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_d = urhk_dbSQLWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0 ) THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		PRINT(sv_d)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Using SQL Loader upload the file into CUSTOM.EXCANRE_TABLE  table
	#-----------------------------------------------------------------------------
	
	CUST.BNKCQPR.ctfthnm = CUST.BNKCQPR.ctlPath + "ECRTrading.ctl"
	CUST.BNKCQPR.fileNamePath = CUST.BNKCQPR.dataPath + CUST.BNKCQPR.upldFile
	
	PRINT(CUST.BNKCQPR.ctfthnm)
	PRINT(CUST.BNKCQPR.fileNamePath)
	
	sv_b = "sqlldr " + CUST.BNKCQPR.userPass + "  control=" + CUST.BNKCQPR.ctfthnm + " data=" + CUST.BNKCQPR.tmpfilename
	PRINT(sv_b)
	
	sv_a = SYSTEM(sv_b)
	PRINT(sv_a)
	
	IF(sv_a != 0 ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Error in uploading file please retry^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "rm -f " + CUST.BNKCQPR.tmpfilename
	print(sv_s)
	sv_r = SYSTEM(sv_s)
	PRINT(sv_r)
	
	#-----------------------------------------------------------------------------------------------------------------------
	#----Processing the uploaded file
	#------------------------------------------------------------------------------------------------------------------------
	
	IF (CUST.BNKCQPR.test == "Y") THEN
	#{
		CUST.BNKCQPR.ttumsal_mod = "T"
		CUST.BNKCQPR.Rename = "N"
		#}
	ELSE
		#{
		CUST.BNKCQPR.ttumsal_mod = "P"
		CUST.BNKCQPR.Rename = "Y"
	#}
	ENDIF
	
	sv_s = "name|SELECT SUBSTR(?SVAR,1,INSTR(?SVAR,'.')-1) "
	sv_s = sv_s + "FROM DUAL"
	BANCS.INPARAM.BINDVARS =  CUST.BNKCQPR.upldFile + "|" + CUST.BNKCQPR.upldFile
	
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d ==0) THEN
	#{
		CUST.BNKCQPR.filename=BANCS.OUTPARAM.name
		PRINT(CUST.BNKCQPR.filename)
		
		sv_u = urhk_getFileLocation("COM|ECRProcess.com")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			#----------------------------------------------------------------------------------
			#---    Setting Env variables
			#----------------------------------------------------------------------------------
			sv_a = "fileName|" + CUST.BNKCQPR.filename
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "bankId|" + BANCS.STDIN.contextBankId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "homeCrncy|" + BANCS.STDIN.homeCrncyCode
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "acctNo|" + CUST.BNKCQPR.acctno
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "solId|" + CUST.BNKCQPR.solid
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "ttumsal|" + CUST.BNKCQPR.ttumsal_mod
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "renameFlg|" + CUST.BNKCQPR.Rename
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "rmks|" + CUST.BNKCQPR.remarks
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "tranSub|" + CUST.BNKCQPR.tranSub
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "fileNamePath|" + CUST.BNKCQPR.fileNamePath
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------
			#---    Executing com file in background
			#----------------------------------------------------------------------------------
			BANCS.INPARAM.scriptName = "ECRProcess.com"
			BANCS.INPARAM.arguments = ""
			sv_u = urhk_CallShellScript("b")
			print(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.BNKCQPR.errMsg = "Upload process failed please retry"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.BNKCQPR.errMsg = "Unable to load com file"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#	sv_x = urhk_getFileLocation("COM|ECRProcess.com")
		#	PRINT(sv_x)
		#
		#	sv_l = BANCS.OUTPARAM.fileLocation
		#	PRINT(sv_l)
		#
		#	sv_t  =  sv_l + "ECRProcess.com" + " " + CUST.BNKCQPR.filename  + " " + BANCS.STDIN.contextBankId  + " " + BANCS.STDIN.homeCrncyCode + " " + CUST.BNKCQPR.acctno + " " + CUST.BNKCQPR.solid + " " + CUST.BNKCQPR.ttumsal_mod + " " + CUST.BNKCQPR.Rename + " " + CUST.BNKCQPR.remarks + " " + CUST.BNKCQPR.tranSub + " " + CUST.BNKCQPR.fileNamePath
		#
		#	PRINT(sv_t)
		#
		#	sv_a = SYSTEM(sv_t + " &")
		#	PRINT(sv_a)
		#
		#	IF(sv_a != 0 ) THEN
		#	#{
		#    	sv_z = urhk_SetOrbOut("Error_01|ERROR^Technical Error - Com file for loading a file^upldFileName")
		#    	sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		#    	GOTO ENDOFSCRIPT
		#	#}
		#	ENDIF
	#}
	ENDIF
	
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	sv_g = "RESULT_MSG| File is  Uploaded Succesfully "
	sv_z = urhk_SetOrbOut(sv_g)
	
	ENDOFSCRIPT:
		#---------------------------------------------------------
		# If any error while processing file sending msg
		#---------------------------------------------------------
		IF( CUST.BNKCQPR.errMsg != "" ) THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|"+ CUST.BNKCQPR.errMsg)
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
