<--START
CHECKSUM="9fe51f5e4b8dd25443be2c146c28bb3f0ed3993d6cfc722e8c8dbe3f00d60278"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIECLG Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIECLG")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIECLG",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIECLG.instrumentEntity = " "
	CUST.CIECLG.instrumentEntityDesc = " "
	CUST.CIECLG.instrumentEntityHomeCcy = " "
	CUST.CIECLG.recordCount = "0"
	
	BANCS.INPARAM.BINDVARS = ""
	sv_s = "recordCount|"
	sv_s = sv_s + " SELECT COUNT(*)"
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE DEL_FLG != 'Y'"
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIECLG.recordCount = BANCS.OUTPARAM.recordCount
		print(CUST.CIECLG.recordCount)
	#}
	ENDIF
	
	sv_u = urhk_SetOrbOut("recordCount|"+CUST.CIECLG.recordCount)
	print(sv_u)
	
	BANCS.INPARAM.BINDVARS = ""
	sv_s = "instrumentEntity,instrumentEntityDesc,instrumentEntityHomeCcy|"
	sv_s = sv_s + " SELECT BANK_ID,GROUP_DESC,HOME_CRNCY_CODE"
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE DEL_FLG != 'Y'"
	sv_s = sv_s + " ORDER BY BANK_ID"
	print(sv_s)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF(sv_c != 0)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	
	sv_i = 1
	
	WHILE(sv_f == 0)
	#{
		CUST.CIECLG.instrumentEntity = BANCS.OUTPARAM.instrumentEntity
		print(CUST.CIECLG.instrumentEntity)
		
		CUST.CIECLG.instrumentEntityDesc = TOUPPER(BANCS.OUTPARAM.instrumentEntityDesc)
		print(CUST.CIECLG.instrumentEntityDesc)
		
		CUST.CIECLG.instrumentEntityHomeCcy = BANCS.OUTPARAM.instrumentEntityHomeCcy
		print(CUST.CIECLG.instrumentEntityHomeCcy)
		
		sv_s = "instrumentEntity_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.instrumentEntity
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "instrumentEntityDesc_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.instrumentEntityDesc
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "instrumentEntityHomeCcy_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.instrumentEntityHomeCcy
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_i = sv_i + 1
		
		sv_f = urhk_dbCursorFetch(sv_n)
		print(sv_f)
		
	#}
	DO
	
	sv_c = urhk_dbCursorClose(sv_n)
	print(sv_c)
	
	
	ENDOFSCRIPT:
		
END-->
