#----------------------------------------------------------------------------------------------------------
# Filename              :       VilleFeeTransfer.scr
# Author                :       Katumo M
# Description           :       Regularizes VILLE DE KINSHASA Accounts
# Calling Script        :       HBJSTM
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           22-04-2022	  Katumo M	    original Version		1.0
#-----------------------------------------------------------------------------------------------------------
 
<--start
trace on

	#--------------------------------------------------------------------------
	#  Creation of MISS repository and CHRG class
	#--------------------------------------------------------------------------
	

	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
		CREATEREP("BANCS")
	ENDIF	
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
		CREATEREP("CUST")
	ENDIF	
	sv_r = CLASSEXISTS("CUST", "DATA")
	IF (sv_r == 0) THEN
		CREATECLASS("CUST", "DATA", 5)
	ENDIF
	
		CUST.DATA.debitAcct1="15051307150203"
		CUST.DATA.debitAcct2="15051307150204"


		
			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.debitAcct1)
			IF (sv_n == 0)THEN
				CUST.DATA.crncyViOne = BANCS.OUTPARAM.acctCrncyCode
				print (CUST.DATA.crncyViOne)
			ENDIF

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.debitAcct2)
			IF (sv_n == 0)THEN
				CUST.DATA.crncyViTwo = BANCS.OUTPARAM.acctCrncyCode
				print (CUST.DATA.crncyViTwo)
			ENDIF
		#-----------------------------
		#Cust1 a/c--STE MAXIMUM B SARLU 
		#------------------------------

		CUST.DATA.SteMaxUsdAcct ="026200000031007"
		

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.SteMaxUsdAcct)
			IF (sv_n == 0)THEN
			CUST.DATA.crncySteUsd = BANCS.OUTPARAM.acctCrncyCode
			print (CUST.DATA.crncySteUsd)
			ENDIF
		
		CUST.DATA.SteMaxCdfAcct ="366200000481697"

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.SteMaxCdfAcct)
			IF (sv_n == 0)THEN
			CUST.DATA.crncySteCdf = BANCS.OUTPARAM.acctCrncyCode
			print (CUST.DATA.crncySteCdf)
			ENDIF
		#----------------------------------------------
		#cust2 a/c--VILLE DE KINSHASA VILLE DE KINSHASA
		#----------------------------------------------

		CUST.DATA.VilleUsdAcct="010101825120211"
		
			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.VilleUsdAcct)
			IF (sv_n == 0)THEN
			CUST.DATA.crncyVilUsd = BANCS.OUTPARAM.acctCrncyCode
			print(CUST.DATA.crncyVilUsd)
			ENDIF

		CUST.DATA.VilleCdfAcct="010101825110414"

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.VilleCdfAcct)
			IF (sv_n == 0)THEN
			CUST.DATA.crncyVilCdf = BANCS.OUTPARAM.acctCrncyCode
			print(CUST.DATA.crncyVilCdf)
			ENDIF
		#-------------------------
		#bank1 a/c --  COMMISSION
		#--------------------------

		CUST.DATA.CommCdfAcct ="15000657050015"

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.CommCdfAcct)
			IF (sv_n == 0)THEN
			CUST.DATA.crncyBank = BANCS.OUTPARAM.acctCrncyCode
			print (CUST.DATA.crncyBank)
			ENDIF

		#------------------
		#bank2 a/c -- T.V.A
		#------------------

		CUST.DATA.VtaCdfAcct ="15000347010005"

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.VtaCdfAcct)
			IF (sv_n == 0)THEN
			CUST.DATA.crncyTva = BANCS.OUTPARAM.acctCrncyCode
			print (CUST.DATA.crncyTva)

			ENDIF
		
		
		
		sv_u = urhk_B2K_PrintRepos("BANCS")
		print(sv_u)

		sv_s= "StartDate|select  SUBSTR(to_char(to_date(sysdate-5,'dd/mm/rrrr'),'dd/mm/rrrr'),0,5) from dual"
		print(sv_s)
		sv_d=urhk_dbselectWithBind(sv_s)
		if (sv_d == 0 ) then
			CUST.DATA.StartDate=BANCS.OUTPARAM.StartDate
			print (CUST.DATA.StartDate)
		endif
		sv_s= "InitDate|select  to_char(to_date(sysdate,'dd/mm/rrrr'),'dd/mm/rrrr') from dual "
		print(sv_s)
		sv_d=urhk_dbselectWithBind(sv_s)
		if (sv_d == 0 ) then
			CUST.DATA.InitDate=BANCS.OUTPARAM.InitDate
			print (CUST.DATA.InitDate)
		ENDIF



		
		CUST.DATA.SteandVille="Nivellement plaques moto du " +  CUST.DATA.StartDate  + " au " + CUST.DATA.InitDate
		print (CUST.DATA.SteandVille)
		CUST.DATA.CION="Cion sur ventes plaques du " +  CUST.DATA.StartDate  + " au " + CUST.DATA.InitDate
		print (CUST.DATA.CION)
		CUST.DATA.TVA= "TVA sur Cion"

		#-------------------------------------
		# Getting the effective available bal.
		#-------------------------------------

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.debitAcct1)
			IF (sv_n == 0)THEN
				CUST.DATA.Bal1= FORMAT$(cdouble(BANCS.OUTPARAM.EffAvailableAmt),"%.2f")
				print (cdouble(CUST.DATA.Bal1))
			ENDIF

			sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.debitAcct2)
			IF (sv_n == 0)THEN
				CUST.DATA.Bal2= FORMAT$(cdouble(BANCS.OUTPARAM.EffAvailableAmt),"%.2f")
				print (cdouble(CUST.DATA.Bal2))
			ENDIF
		#----------------------------------------
		# initializing how the bal will be shared
		#------------------------------------------
		sv_a="0.64875"
		sv_b="0.328125"
		sv_c="0.02"
		

		
		CUST.DATA.SteMaxUsdAmt= FORMAT$((cdouble(sv_a) * CDOUBLE(CUST.DATA.Bal1)),"%.2f")
		Print (cdouble(CUST.DATA.SteMaxUsdAmt))

		CUST.DATA.SteMaxCdfAmt= FORMAT$((cdouble(sv_a) * CDOUBLE(CUST.DATA.Bal2)),"%.2f")
		Print (cdouble(CUST.DATA.SteMaxCdfAmt))

		CUST.DATA.VilleUsdAmt= FORMAT$((cdouble(sv_b) * CDOUBLE(CUST.DATA.Bal1)),"%.2f")
		Print (cdouble(CUST.DATA.VilleUsdAmt))

		CUST.DATA.VilleCdfAmt= FORMAT$((cdouble(sv_b) * CDOUBLE(CUST.DATA.Bal2)),"%.2f")
		Print (cdouble(CUST.DATA.VilleCdfAmt))

		CUST.DATA.CommUsdAmt= FORMAT$((cdouble(sv_c) * CDOUBLE(CUST.DATA.Bal1)),"%.2f")
		Print (cdouble(CUST.DATA.CommUsdAmt))

		CUST.DATA.CommCdfAmt= FORMAT$((cdouble(sv_c) * CDOUBLE(CUST.DATA.Bal2)),"%.2f")
		Print (cdouble(CUST.DATA.CommCdfAmt))
		
		CUST.DATA.VtaUsdAmt= FORMAT$ ((cdouble(CUST.DATA.Bal1) - (cdouble(CUST.DATA.CommUsdAmt) + cdouble(CUST.DATA.VilleUsdAmt) + cdouble(CUST.DATA.SteMaxUsdAmt))),"%.2f")
		Print (cdouble(CUST.DATA.VtaUsdAmt))

		CUST.DATA.VtaCdfAmt= FORMAT$ ((cdouble(CUST.DATA.Bal2) - (cdouble(CUST.DATA.CommCdfAmt) + cdouble(CUST.DATA.VilleCdfAmt) + cdouble(CUST.DATA.SteMaxCdfAmt))),"%.2f")
		Print (cdouble(CUST.DATA.VtaCdfAmt))


		sv_r = REPEXISTS("MTT")
			IF (sv_r == 0) THEN
					CREATEREP("MTT")
			ENDIF

			sv_r = CLASSEXISTS("MTT","TranDetails")
			IF (sv_r == 0) THEN
					CREATECLASS("MTT","TranDetails",5)
			ENDIF

			sv_r = CLASSEXISTS("MTT","PartTranDetails")
			IF (sv_r == 0) THEN
					CREATECLASS("MTT","PartTranDetails",5)
			ENDIF

			sv_r = CLASSEXISTS("MTT","InputDetails")
			IF (sv_r == 0) THEN
					CREATECLASS("MTT","InputDetails",5)
			ENDIF

			sv_r = CLASSEXISTS("MTT","Error")
			IF (sv_r == 0) THEN
					CREATECLASS("MTT","Error",5)
			ENDIF

			sv_r = CLASSEXISTS("BANCS","INPARAM")
			IF (sv_r == 0) THEN
				CREATECLASS("BANCS","INPARAM",5)
			ENDIF

			#===================================
			# INITIALIZE MTT
			#===================================

			BANCS.INPARAM.PostTranFlg               = "Y"
			BANCS.INPARAM.CommitFlg                 = "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
			BANCS.INPARAM.ValidationFlag            = "Y"
			BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
			BANCS.INPARAM.ErrorCheckForLuw          = "Y"
			BANCS.INPARAM.CheckExceptions           = "N"

			sv_a = urhk_MTTS_PopulateInputDetails("")
			print(sv_a)
			MTT.TranDetails.TranDate="0"
			MTT.TranDetails.TranType = "T"
			MTT.TranDetails.TranSubType = "BI"
			MTT.TranDetails.IgnoreExcp = "I"
			MTT.TranDetails.Consolidate = "N"
			MTT.TranDetails.Remarks = "SPLITING FEE"
			sv_a = urhk_MTTS_PopulateInputDetails("")
			sv_r = urhk_MTTS_DefineTransaction("WITHTran")
			sv_v = "WITHTran"
			

#------------------------------USD TRANSACTION -----------------------------------#

		IF (cdouble(CUST.DATA.Bal1) > 0 )THEN
			
			MTT.PartTranDetails.Account  = CUST.DATA.debitAcct1
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViOne
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars =  CUST.DATA.SteandVille
			MTT.PartTranDetails.RefAmount = -(cdouble(CUST.DATA.Bal1))
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.SteandVille
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("CustDr")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF


			#-----------------------------------
			# credit STE MAXIMUM B SARLU USD A/C
			#-----------------------------------

			MTT.PartTranDetails.Account     = CUST.DATA.SteMaxUsdAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViOne
			if (CUST.DATA.crncySteUsd != CUST.DATA.crncyViOne)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.SteandVille
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.SteMaxUsdAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.SteandVille
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF

			#---------------------------------------------------
			# credit VILLE DE KINSHASA VILLE DE KINSHASA USD A/C
			#---------------------------------------------------

			MTT.PartTranDetails.Account     = CUST.DATA.VilleUsdAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViOne
			if (CUST.DATA.crncyVilUsd != CUST.DATA.crncyViOne)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.SteandVille
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.VilleUsdAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.SteandVille
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF

			#-----------------------------------
			#crediting Cdf bank account with USD
			#------------------------------------

			MTT.PartTranDetails.Account     = CUST.DATA.CommCdfAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViOne
			if (CUST.DATA.crncyBank != CUST.DATA.crncyViOne)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.CION
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.CommUsdAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.CION
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF
			
			#----------------------------------------------
			#Credting TVA ACcount with usd
			#-----------------------------------------------

			MTT.PartTranDetails.Account     = CUST.DATA.VtaCdfAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViOne
			if (CUST.DATA.crncyTva != CUST.DATA.crncyViOne)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.TVA
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.VtaUsdAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.TVA
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF
		ENDIF

#----------------------------------CDF TRANSACTION-------------------------------------#
		
		IF (cdouble(CUST.DATA.Bal2) > 0 )THEN


			MTT.PartTranDetails.Account  = CUST.DATA.debitAcct2
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViTwo
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars =  CUST.DATA.SteandVille
			MTT.PartTranDetails.RefAmount = -(cdouble(CUST.DATA.Bal2))
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.SteandVille
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("CustDr")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF

			#------------------------------------------
			# credit STE MAXIMUM B SARLU CDF  A/C
			#-----------------------------------------

			MTT.PartTranDetails.Account     = CUST.DATA.SteMaxCdfAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViTwo
			if (CUST.DATA.crncySteCdf != CUST.DATA.crncyViTwo)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.SteandVille
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.SteMaxCdfAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.SteandVille
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF

			

			#--------------------------------------------------
			# credit VILLE DE KINSHASA VILLE DE KINSHASA CDF A/C
			#-----------------------------------------------------

			MTT.PartTranDetails.Account     = CUST.DATA.VilleCdfAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViTwo
			if (CUST.DATA.crncyVilCdf != CUST.DATA.crncyViTwo)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.SteandVille
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.VilleCdfAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.SteandVille
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF

                       #--------------------------------
		       # credit BANK COMMISSION CDF A/C
		       #--------------------------------


			MTT.PartTranDetails.Account     = CUST.DATA.CommCdfAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViTwo
			if (CUST.DATA.crncyBank != CUST.DATA.crncyViTwo)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.CION
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.CommCdfAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.CION
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF

		       #--------------------------------
		       # credit T.V.A  CDF A/C
		       #--------------------------------

				
			MTT.PartTranDetails.Account     = CUST.DATA.VtaCdfAcct
			MTT.PartTranDetails.RefCurrency = CUST.DATA.crncyViTwo
			if (CUST.DATA.crncyTva != CUST.DATA.crncyViTwo)then
				MTT.PartTranDetails.RateCode ="TTB"
			else
				MTT.PartTranDetails.RateCode ="MEAN"
			endif
			MTT.PartTranDetails.Rate        = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.DATA.TVA
			MTT.PartTranDetails.RefAmount = cdouble(CUST.DATA.VtaCdfAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.DATA.TVA
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
			print(sv_r)
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.DATA.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF
		ENDIF
	
			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)
			IF(fieldexists(BANCS.OUTPARAM.MTTTranId)) THEN
			#{
				print(BANCS.OUTPARAM.MTTTranId)
				CUST.DATA.tranid = BANCS.OUTPARAM.MTTTranId
				print(CUST.DATA.tranid)
			#}
			ENDIF
trace off
end-->

