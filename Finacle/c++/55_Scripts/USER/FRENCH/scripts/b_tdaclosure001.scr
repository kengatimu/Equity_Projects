<--START
CHECKSUM="c3d11614d8602732c54f545267d39ba68db02c017aa3e834af4874446fbc7f24"
	TRACE ON
	
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "GLBDATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "GLBDATA", 5)
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "INTERFACE")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	
	sv_u = urhk_B2k_printRepos("BANCS")
	print(sv_u)
	
	sv_b = BANCS.STDIN.mySolId
	print(sv_b)
	
	sv_q="foracid|"
	sv_q = sv_q + " select foracid from custom.int_change where bank_id = ?SVAR AND ENTITY_CRE_FLG='Z' AND foracid in  (select foracid from tbaadm.gam where bank_id='54'  AND schm_type='TDA' AND acct_cls_date is null ) "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_e = urhk_dbCursorOpenWithBind(sv_q)
	
	IF(sv_e==0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		
		IF(sv_q == 1) THEN
		#{
			sv_x = urhk_dbCursorClose(sv_m)
			print(sv_x)
			exitscript
		#}
		ENDIF
		print(sv_q)
		
		WHILE (sv_q==0)
		#{
			CUST.GLBDATA.foracid=BANCS.OUTPARAM.foracid
			print(CUST.GLBDATA.foracid)
			
			sv_u = "solid,acid,schmcode,clsflg,clrbal,acctCurr,cifId|"
			sv_u = sv_u + "select sol_id,acid,schm_code,acct_cls_flg,clr_bal_amt,acct_crncy_code,cif_id from tbaadm.gam  "
			sv_u = sv_u + " where foracid = ?SVAR  AND bank_id= ?SVAR"
			print(sv_u)
			
			BANCS.INPARAM.BINDVARS = CUST.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_w =  urhk_dbSelectWithBind(sv_u)
			print(sv_w)
			
			IF (sv_w==0) THEN
			#{
				CUST.GLBDATA.acid=BANCS.OUTPARAM.acid
				print(CUST.GLBDATA.acid)
				
				CUST.GLBDATA.schmcode=BANCS.OUTPARAM.schmcode
				print(CUST.GLBDATA.schmcode)
				
				CUST.GLBDATA.solid=BANCS.OUTPARAM.solid
				print(CUST.GLBDATA.solid)
				
				CUST.GLBDATA.clsflg=BANCS.OUTPARAM.clsflg
				print(CUST.GLBDATA.clsflg)
				
				CUST.GLBDATA.clrbal=BANCS.OUTPARAM.clrbal
				print(CUST.GLBDATA.clrbal)
				
				CUST.GLBDATA.acctCurr = BANCS.OUTPARAM.acctCurr
				print(CUST.GLBDATA.acctCurr)
				
				CUST.GLBDATA.cifId = BANCS.OUTPARAM.cifId
				print(CUST.GLBDATA.cifId)
				
				IF(CUST.GLBDATA.clsflg == "Y") THEN
				#{
					#print (BANCS.OUTPARAM.foracid)
					sv_s = "UPDATE CUSTOM.INT_CHANGE "
					sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'S',"
					sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
					sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
					sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
					GOTO TARGET
				#}
				ENDIF
				
				####--------------------Below makes the script close only Accounts with zero balance--------------------------
				
				IF(CUST.GLBDATA.clrbal != "0") THEN
				#{
					sv_s = "UPDATE CUSTOM.INT_CHANGE "
					sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'A',"
					sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
					sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
					sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
					GOTO TARGET
				#}
				ENDIF
				
				IF(CUST.GLBDATA.solid != BANCS.STDIN.mySolId)THEN
				#{
					sv_u = urhk_SetUrhkInp("sol.solId|"+CUST.GLBDATA.solid)
					print(sv_u)
					sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
					print(sv_u)
				#}
				ENDIF
			#}
			ENDIF
			####----------------------------End of restriction to close zero balance accounts only-----------------------------------------------
			
			
			BANCS.INPARAM.BINDVARS = CUST.GLBDATA.acid
			print(BANCS.INPARAM.BINDVARS)
			sv_s = "acctNum|select foracid from tbaadm.gam where acid in (select REPAYMENT_ACID from tbaadm.tam where acid = ?SVAR) "
			sv_e = urhk_dbSelectWithBind(sv_s)
			IF(sv_e == 0) THEN
			#{
				CUST.INTERFACE.acctNum = BANCS.OUTPARAM.acctNum
				print(CUST.INTERFACE.acctNum)
				
				#}
			ELSE
				#{
				sv_s = "acctNum|SELECT foracid "
				sv_s = sv_s + "FROM TBAADM.GAM "
				sv_s = sv_s + "WHERE bank_id  = ?SVAR "
				sv_s = sv_s + "AND schm_type IN ('SBA','CAA') "
				sv_s = sv_s + "AND acct_cls_flg = 'N' "
				sv_s = sv_s + "AND cif_id = ?SVAR "
				sv_s = sv_s + "AND rownum < 2 "
				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.GLBDATA.cifId
				
				sv_u = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_u)
				IF(sv_u == 0) THEN
				#{
					CUST.INTERFACE.acctNum = BANCS.OUTPARAM.acctNum
					print(CUST.INTERFACE.acctNum)
				#}
				ENDIF
				
			#}
			ENDIF
			
			#####################################################################################################################################
			
			#-------------------------------------------------------------------------
			# Fetch the current data time to send in request header
			#-------------------------------------------------------------------------
			sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
			#{
				CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
				print(CUST.INTERFACE.msgDateTime)
			#}
			ENDIF
			
			sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0)THEN
			#{
				CUST.INTERFACE.RequestID = BANCS.OUTPARAM.RequestID
				print(CUST.INTERFACE.RequestID)
				#}
			ELSE
				#{
				CUST.INTERFACE.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
				print(CUST.INTERFACE.RequestID)
			#}
			ENDIF
			
			#-------------------------------------------------------------------------
			#- Forming the Header for XferTrnAdd
			#-------------------------------------------------------------------------
			CUST.INTERFACE.headerXML = ""
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Header>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestHeader>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageKey>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestUUID>"+ CUST.INTERFACE.RequestID +"</RequestUUID>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestId>DepAcctClose</ServiceRequestId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ChannelId>COR</ChannelId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</MessageKey>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestMessageInfo>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<BankId>"+ BANCS.STDIN.contextBankId +"</BankId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<TimeZone>GMT+05:00</TimeZone>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityType />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ArmCorrelationId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageDateTime>"+ CUST.INTERFACE.msgDateTime +"</MessageDateTime>"
			
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestMessageInfo>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Security>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Token>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<PasswordToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<UserId>200102817</UserId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Password />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</PasswordToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Token>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<FICertToken />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserLoginSessionId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUser />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserPwd />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<SSOTransferToken />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Security>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestHeader>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Header>"
			
			#-------------------------------------------------------------------------
			#- Forming the Body for XferTrnAdd
			#-------------------------------------------------------------------------
			CUST.INTERFACE.bodyXMLMsg = ""
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Body><DepAcctCloseRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DepAcctCloseRq>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DepAcctId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctId>"+ CUST.GLBDATA.foracid +"</AcctId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctType>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SchmCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SchmType />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</AcctType>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctCurr />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BankInfo>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BankId />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Name />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BranchId />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BranchName />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PostAddr>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Addr1 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Addr2 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Addr3 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<City />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<StateProv />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PostalCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Country />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AddrType />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PostAddr>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</BankInfo>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</DepAcctId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CloseModeFlg>Y</CloseModeFlg>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RepayAcctId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctId>"+ CUST.INTERFACE.acctNum +"</AcctId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctType />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctCurr>KES</AcctCurr>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BankInfo />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RepayAcctId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RepayAcctRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PrefCustRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<value />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PrefCustRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RateCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TreaRefNum />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TreaRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<value />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</TreaRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RepayAcctRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CashCurCode>KES</CashCurCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CloseAmtXferFlg>T</CloseAmtXferFlg>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CloseAmt>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<amountValue />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<currencyCode>KES</currencyCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CloseAmt>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BrokenTermProfitRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<value />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</BrokenTermProfitRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CloseReasonCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CloseRemarks>TDA  CLOSURE</CloseRemarks>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CashRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PrefCustRate />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RateCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TreaRefNum />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TreaRate />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CashRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DepTemplateInfo>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TemplateId />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</DepTemplateInfo>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</DepAcctCloseRq>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DepAcctClose_CustomData>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<WITHDRWLAMT />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<WDCRNCY>KES</WDCRNCY>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</DepAcctClose_CustomData>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</DepAcctCloseRequest></Body>"
			print(CUST.INTERFACE.bodyXMLMsg)
			
			
			
			#-------------------------------------------------------------------------
			#Appending the header XML and body XML.
			#-------------------------------------------------------------------------
			CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"
			
			#-------------------------------------------------------------------------------
			# Setting input values for urhk_ConnectToFIAndSendMsg userhook
			#-------------------------------------------------------------------------------
			BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
			BANCS.INPARAM.SEND_RECV_FLG             = "R"
			sv_a = CUST.INTERFACE.reqXMLMsg
			PRINT(sv_a)
			
			#-------------------------------------------------------------------------
			#- Executing the userhook to make the Outbound Call
			#-------------------------------------------------------------------------
			sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
			print(sv_l)
			IF (sv_l != 0) THEN
			#{
				print(BANCS.OUTPARAM.ErrMsg)
				CUST.INTERFACE.errorMsgFlg = "Y"
				CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.INTERFACE.errorMsgCode = "FIERR"
				GOTO TARGET
			#}
			ENDIF
			
			IF (BANCS.OUTPARAM.ErrMsg != "") THEN
			#{
				CUST.INTERFACE.errorMsgFlg = "Y"
				CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
				CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.INTERFACE.errorMsgCode = "FIERR"
				GOTO TARGET
				#}
			ELSE
				#{
				CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
				print(CUST.INTERFACE.respXMLMsg)
				CUST.INTERFACE.errorMsgFlg = ""
				CUST.INTERFACE.errorMsgDesc = ""
				
				CUST.INTERFACE.opndate = ""
				#CUST.INTERFACE.cifid = ""
				CUST.INTERFACE.errorCode = ""
				CUST.INTERFACE.errorDesc = ""
				sv_x = CUST.INTERFACE.respXMLMsg
				
				#--------------------------------------------------------------------------------------------------------
				# Fetching the status of the request
				#--------------------------------------------------------------------------------------------------------
				sv_y = "<Status>"
				sv_z = "</Status>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
					#}
				ELSE
					#{
					CUST.INTERFACE.tranStatus = ""
				#}
				ENDIF
				print(CUST.INTERFACE.tranStatus)
				#--------------------------------------------------------------------------------------------------------
				# If Success fetching cif id and cif opn date else fetching error code and description
				#--------------------------------------------------------------------------------------------------------
				IF (CUST.INTERFACE.tranStatus =="SUCCESS")  THEN
				#{
					CUST.INTERFACE.errorMsgFlg = "N"
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<AcctId>"
					sv_z = "</AcctId>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.AcctId = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.INTERFACE.AcctId)
					#}
					ENDIF
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					#print (BANCS.OUTPARAM.foracid)
					sv_s = "UPDATE CUSTOM.INT_CHANGE "
					sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'K',"
					sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
					sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
					sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.INTERFACE.errorMsgFlg = "Y"
					IF(CUST.INTERFACE.tranStatus != "SUCCESS") THEN
					#{
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<ErrorCode>"
						sv_z = "</ErrorCode>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
						#}
						ENDIF
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<ErrorDesc>"
						sv_z = "</ErrorDesc>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
						#}
						ENDIF
						
						#----------------------------------------------------------------------------------------------------
						# Update custom table failure status
						#----------------------------------------------------------------------------------------------------
						sv_s = "UPDATE CUSTOM.INT_CHANGE "
						sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'H',"
						sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
						sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
						sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
						#{
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						#}
						ENDIF
						IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
						#{
							CUST.INTERFACE.errorCode = "SYSERR"
							CUST.INTERFACE.errorDesc = "Could not get response from server"
						#}
						ENDIF
					#}
					ENDIF
					IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
					#{
						CUST.INTERFACE.errorCode = "SYSERR"
						CUST.INTERFACE.errorDesc = "Could not get response from server"
					#}
					ENDIF
				#}
				ENDIF
				
				print(CUST.INTERFACE.errorMsgFlg)
				print(CUST.INTERFACE.errorCode)
				print(CUST.INTERFACE.errorDesc)
			#}
			ENDIF
			
			########################################################################################################################################
			
			TARGET:
				
				sv_q = urhk_dbCursorFetch(sv_m)
				print(sv_q)
				
			#}
			DO
			print("ALL ACCOUNTS CLOSED")
		#}
		ENDIF
		
		TRACE OFF
		exitscript
END-->
