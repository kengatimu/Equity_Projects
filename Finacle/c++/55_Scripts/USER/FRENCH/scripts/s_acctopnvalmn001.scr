	IF(sv_u == 0) THEN
	#{
		CUST.ACCOPEN.schmCode=TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.schmCode)
	#}
	ENDIF
	
	IF ((CUST.ACCOPEN.cifId !="")AND(CUST.ACCOPEN.schmCode!="")) THEN
	#{
		sv_s = "gspCount|SELECT count(1) FROM TBAADM.GSP"
		sv_s = sv_s + " WHERE schm_type = 'LAA' "
		sv_s = sv_s + " AND schm_code = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		
