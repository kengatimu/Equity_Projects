		print(sv_d)
		
		sv_q = BANCS.OUTPARAM.gspCount
		print(sv_q)
		
		IF (sv_q == CINT("0")) THEN
		#{
			GOTO FINISH
		#}
		ENDIF
		
		sv_s = "gamCount|SELECT count(1) FROM TBAADM.GAM"
		sv_s = sv_s + " WHERE schm_type = 'LAA' "
		sv_s = sv_s + " AND cif_id = ?SVAR "
		sv_s = sv_s + " AND entity_cre_flg ='Y' "
		sv_s = sv_s + " AND del_flg ='N' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.ACCOPEN.cifId + "|" + BANCS.STDIN.contextBankId
		
		print(sv_s)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		
		sv_q = BANCS.OUTPARAM.gamCount
		print(sv_q)
		
		IF (sv_q != CINT("0")) THEN
		#{
			sv_a = urhk_SRV_SetErr("acctCriteria.custId.cifId|Repeated Borrower" )
			print(sv_a)
			BANCS.OUTPUT.successOrFailure="S"
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	FINISH:
