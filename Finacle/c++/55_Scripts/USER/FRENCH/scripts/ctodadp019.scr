<--START
CHECKSUM="3d64612eaa099742d78792342020a99e65091a77a2d8a9f13501311ad21fc7d1"
	
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CTODA") == 0) THEN
	#{
		CREATECLASS("CUST", "CTODA", 5)
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "INTERFACE") == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# Getting Input at Backend
	#--------------------------------------------------------------------------
	CUST.CTODA.accNum =  TRIM(BANCS.INPUT.accNum)
	print(CUST.CTODA.accNum)
	
	BANCS.INPARAM.BINDVARS = CUST.CTODA.accNum + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "crncyCode,acctName|"
	sv_s = sv_s + " SELECT ACCT_CRNCY_CODE,ACCT_NAME"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		CUST.CTODA.crncyCode = ""
		CUST.CTODA.acctName = ""
		#}
	ELSE
		#{
		CUST.CTODA.crncyCode = BANCS.OUTPARAM.crncyCode
		print(CUST.CTODA.crncyCode)
		CUST.CTODA.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CTODA.acctName)
		
	#}
	ENDIF
	
	
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctCrncy|" + CUST.CTODA.crncyCode
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctName|" + CUST.CTODA.acctName
	sv_u = urhk_SetOrbOut(sv_w)
	
	
END-->
