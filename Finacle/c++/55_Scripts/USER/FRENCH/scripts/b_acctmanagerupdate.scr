	    print(sv_q)

	   IF(sv_q == 1) THEN
		 sv_x = urhk_dbCursorClose(sv_m)
		 print(sv_x)
		 exitscript
	   ENDIF
	  print(sv_q)

WHILE (sv_q==0)
		CUSTS.GLBDATA.cifid=BANCS.OUTPARAM.cifid
		print(CUSTS.GLBDATA.cifid)

