<--start
trace on

sv_r = REPEXISTS("CUSTS")
IF (sv_r == 0) THEN
	CREATEREP("CUSTS")
ENDIF

sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
IF (sv_r == 0) THEN
     CREATECLASS("CUSTS", "GLBDATA", 5)
ENDIF

sv_b = BANCS.STDIN.mySolId
print(sv_b)

sv_q="cifid,acctmanager|"
sv_q = sv_q + "select foracid,acct_pref from custom.int_change where bank_id = ?SVAR and ENTITY_CRE_FLG='AW'"
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
	    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
