		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.acctmanager + "|" + CUSTS.GLBDATA.cifid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		IF (sv_d == 0) THEN
		#{
			sv_c = urhk_dbSQLWithBind("commit")
			print(sv_c)
			IF(sv_c == 0) THEN
			#{
				
				sv_s = "UPDATE CUSTOM.INT_CHANGE "
				sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'BS',"
				sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
				sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
				sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.cifid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			ELSE
			#{
				sv_s = "UPDATE CUSTOM.INT_CHANGE "
				sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'AS',"
				sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
				sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
				sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.cifid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			ENDIF

		#}
		ENDIF
			
		

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)	

DO
               print("ALL CIFS UPDATED")
ENDIF

trace off
exitscript
end-->
