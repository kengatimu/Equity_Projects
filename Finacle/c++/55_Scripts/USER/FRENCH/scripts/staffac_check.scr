<--start	
TRACE ON

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","INTERFACE") == 0) THEN
#{
	CREATECLASS ("CUST","INTERFACE",5)
#}
ENDIF

sv_a = urhk_B2k_PrintRepos("BANCS")
print(sv_a)

CUST.INTERFACE.cifId =""

CUST.INTERFACE.status="0"
CUST.INTERFACE.schmecountstatus="0"

sv_s = "cifId|select cif_id "
sv_s = sv_s + "FROM tbaadm.gam "
sv_s = sv_s + "WHERE foracid = ?SVAR "
sv_s = sv_s + "AND bank_id = ?SVAR and ACCT_OWNERSHIP in ('E','C') "
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.INPUT.acct + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)	
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF (sv_d == 0) THEN
#{
	CUST.INTERFACE.cifId = BANCS.OUTPARAM.cifId
	PRINT(CUST.INTERFACE.cifId)
#}
ELSE
	print("Not E or C")
	GOTO ENDOFSCRIPT
ENDIF

CUST.INTERFACE.schmecode="SB190"
print(CUST.INTERFACE.schmecode)

sv_s = "countcorp|select count(*) FROM tbaadm.gam WHERE cif_id=?SVAR "
sv_s = sv_s + " and schm_code =?SVAR and bank_id=?SVAR  "
BANCS.INPARAM.BINDVARS = CUST.INTERFACE.cifId + "|" + CUST.INTERFACE.schmecode + "|" + BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF(sv_d == 0 ) THEN
#{
	print(BANCS.OUTPARAM.countcorp)
	IF (CINT(BANCS.OUTPARAM.countcorp) > 0 ) THEN
		CUST.INTERFACE.schmecountstatus="1"
		print(CUST.INTERFACE.schmecountstatus)
	ELSE
		CUST.INTERFACE.schmecountstatus="0"
		print(CUST.INTERFACE.schmecountstatus)
	ENDIF
#}
ENDIF

print(CUST.INTERFACE.status)
sv_z = urhk_SetOrbOut("output|"+CUST.INTERFACE.status)
print(sv_z)

print(CUST.INTERFACE.schmecountstatus)
sv_z = urhk_SetOrbOut("output1|"+ CUST.INTERFACE.schmecountstatus)
print(sv_z)

ENDOFSCRIPT:
EXITSCRIPT
#TRACE OFF 
end-->
