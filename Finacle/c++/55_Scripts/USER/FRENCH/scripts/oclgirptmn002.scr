#-------------------------------------------------------------------------------------
#    Name               : oclgrptmn002.scr
#    Description        : This script will give parameter value for a parameter id and module name
#    Date               : 21-02-2013
#    Author             : Shishira
#    Input              : BANCS.INPUT.moduleName , BANCS.INPUT.parameterId
#    Output             : BANCS.OUTPUT.parameterVal
#    Called Script      : NA
#    Calling Script     : JSP's
#    Menu Option        :
#    Srl. No        Date            Author          Description.
#    -------        ----            ------          ----------------
#    1            01-01-2013      Shishira           Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="6197772ec354da2c58d3ac49b1d9b3a503949037db6ba743147467079e4cfac4"
	TRACE ON
	IF (BANCS.INPUT.opt=="stId") THEN
	#{
		sv_z = urhk_SetOrbOut("setVal|"+BANCS.STDIN.mySolId)
		print(sv_z)
		#}
	ELSE
		#{
		print(BANCS.STDIN.contextBankId)
		print(BANCS.INPUT.moduleName)
		print(BANCS.INPUT.parameterId)
		
		sv_g = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER"
		sv_g = sv_g + " WHERE "
		sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
		sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
		sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
		sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
		sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
		sv_g = sv_g + " C_CPVALUE.parameter_id = ?SVAR"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.moduleName + "|" + BANCS.INPUT.parameterId
		sv_d = urhk_dbSelectWithBind(sv_g)
		print(sv_d)
		
		IF(sv_d == 0) THEN
		#{
			sv_z = urhk_SetOrbOut("parameterVal|"+BANCS.OUTPARAM.parameterVal)
			print(sv_z)
			#}
		ELSE
			#{
			BANCS.OUTPUT.parameterVal = ""
			sv_z = urhk_SetOrbOut("parameterVal|"+BANCS.OUTPARAM.parameterVal)
			print(sv_z)
		#}
		ENDIF
		#}
		TRACE OFF
	END-->
	
	
	
