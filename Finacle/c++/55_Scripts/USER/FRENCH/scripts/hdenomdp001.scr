#----------------------------------------------------------------------------------------------------------
# Filename              :       hdenomdp001.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to fetch currency name and decimal point allowed for currency.
# Input                 :       crncyCode, contextBankId
# Output                :       crncyName, decimalPointAllow
# Called Script         :       None
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           06-05-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="551d3f3287d2056c59e1b9a4ac5cdefa49556933844364a84bb4b08ae0a2e7b5"
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "INTERFACE") == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# Getting Input at Backend
	#--------------------------------------------------------------------------
	CUST.DENOM.crncyCode =  TRIM(TOUPPER(BANCS.INPUT.crncyCode))
	print(CUST.DENOM.crncyCode)
	CUST.DENOM.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.DENOM.bankId)
	#--------------------------------------------------------------------------
	# Getiing account details for further charge calculation.
	#--------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.DENOM.crncyCode
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.DENOM.bankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "crncyName,decimalPointAllow|"
	sv_s = sv_s + " SELECT CRNCY_NAME, NUM_OF_DEC_POINTS"
	sv_s = sv_s + " FROM TBAADM.CNC "
	sv_s = sv_s + " WHERE CRNCY_CODE = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
		sv_m = "Invalid Currency Code."
		sv_z = "Error_0|" + sv_m
		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DENOM.crncyName = BANCS.OUTPARAM.crncyName
		print(CUST.DENOM.crncyName)
		CUST.DENOM.crncyName = CUST.DENOM.crncyCode + " - " + CUST.DENOM.crncyName
		print(CUST.DENOM.crncyName)
		CUST.DENOM.decimalPointAllow = BANCS.OUTPARAM.decimalPointAllow
		print(CUST.DENOM.decimalPointAllow)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# sending values to FE.
	#--------------------------------------------------------------------------
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "crncyName|" + CUST.DENOM.crncyName
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "decimalPointAllow|" + CUST.DENOM.decimalPointAllow
	sv_u = urhk_SetOrbOut(sv_w)
	ENDOFSCRIPT:
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","DENOM") != 0) THEN
		#{
			DELETECLASS ("CUST","DENOM")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
