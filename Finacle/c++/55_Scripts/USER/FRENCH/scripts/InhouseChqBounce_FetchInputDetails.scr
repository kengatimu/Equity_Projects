        ENDIF
        
        
	#-------------------------------------------------------------------------------
	# Converting the TranDate into the rquired formats
	#-------------------------------------------------------------------------------
	lv_a = "trandate|SELECT to_char(to_date('"+ CUST.INTERFACE.TranDate + "','DD-MM-YYYY HH24:MI:SS'),'DD-MM-YYYY HH24:MI:SS') from dual"
	print(lv_a)
	lv_b = urhk_dbSelectWithBind(lv_a)
	
	IF(lv_b == 0) THEN
	#{
		CUST.INTERFACE.TranDate = BANCS.OUTPARAM.trandate
		print(CUST.INTERFACE.TranDate)
	#}
	ENDIF
	
	
	#-------------------------------------------------------------------------------
	# Fetching the inwardZone Code and outwardRejZone Code
	#-------------------------------------------------------------------------------

	lv_s = "clgZoneCode,clgZoneDate,oSolId,oSetNum,oInstSrNum,oBankCode,oBrCode,oSortCode,zoneCncy,instAmt,payingAcct,instDate|"
	lv_s = lv_s + "SELECT CLG_ZONE_CODE,CLG_ZONE_DATE,SOL_ID,SET_NUM,INSTRMNT_SRL_NUM,BANK_CODE,BR_CODE,"
	lv_s = lv_s + "SORT_CODE,CRNCY_CODE,INSTRMNT_AMT,PAYING_ACCT_ID,INSTRMNT_DATE"
	lv_s = lv_s + " FROM TBAADM.OCI "
	lv_s = lv_s + " WHERE INSTRMNT_ID =  '"+CUST.INTERFACE.ChqNum+"'"
	lv_s = lv_s + " AND FREETEXT2 = '" +CUST.INTERFACE.OrgTranID+"'"
	lv_s = lv_s + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "'"
	lv_s = lv_s + " AND STATUS_FLG != 'J'"
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	IF(lv_d == 0)THEN
	#{
		CUST.INTERFACE.clgZoneCode = BANCS.OUTPARAM.clgZoneCode
		print(CUST.INTERFACE.clgZoneCode)
		CUST.INTERFACE.clgZoneDate = BANCS.OUTPARAM.clgZoneDate
		print(CUST.INTERFACE.clgZoneDate)
		CUST.INTERFACE.oSolId = BANCS.OUTPARAM.oSolId
		print(CUST.INTERFACE.oSolId)
		CUST.INTERFACE.oSetNum = TRIM(BANCS.OUTPARAM.oSetNum)
		print(CUST.INTERFACE.oSetNum)
		CUST.INTERFACE.oInstSrNum = TRIM(BANCS.OUTPARAM.oInstSrNum)
		print(CUST.INTERFACE.oInstSrNum)
		CUST.INTERFACE.oBankCode = BANCS.OUTPARAM.oBankCode
		print(CUST.INTERFACE.oBankCode)
		CUST.INTERFACE.oBrCode = BANCS.OUTPARAM.oBrCode
		print(CUST.INTERFACE.oBrCode)
		CUST.INTERFACE.oSortCode = BANCS.OUTPARAM.oSortCode
		print(CUST.INTERFACE.oSortCode)
		CUST.INTERFACE.ZoneCcy = BANCS.OUTPARAM.zoneCncy
		print(CUST.INTERFACE.ZoneCcy)
		CUST.INTERFACE.instAmt = BANCS.OUTPARAM.instAmt
		print(CUST.INTERFACE.instAmt)
		CUST.INTERFACE.payingAcct = BANCS.OUTPARAM.payingAcct
		print(CUST.INTERFACE.payingAcct)
		CUST.INTERFACE.instDate = BANCS.OUTPARAM.instDate
		print(CUST.INTERFACE.instDate)
	#}
	ELSE
	#{
		# Frror in fetching Outward Zone details 
		CUST.INTERFACE.errorCode = "ERR112"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	# Converting the Instrument Date and Zone date into the rquired formats
	#-------------------------------------------------------------------------------
	lv_a = "instDate|SELECT to_char(to_date('"+ CUST.INTERFACE.instDate + "','DD-MON-YY HH24:MI:SS'),'DD-MM-YYYY HH24:MI:SS') from dual"
	print(lv_a)
	lv_b = urhk_dbSelectWithBind(lv_a)

	IF(lv_b == 0) THEN
	#{
		CUST.INTERFACE.instDate = BANCS.OUTPARAM.instDate
		print(CUST.INTERFACE.instDate)
	#}
	ENDIF
	lv_a = "clgZoneDate|SELECT to_char(to_date('"+ CUST.INTERFACE.clgZoneDate + "','DD-MON-YY HH24:MI:SS'),'DD-MM-YYYY HH24:MI:SS') from dual"
	print(lv_a)
	lv_b = urhk_dbSelectWithBind(lv_a)

	IF(lv_b == 0) THEN
	#{
		CUST.INTERFACE.clgZoneDate = BANCS.OUTPARAM.clgZoneDate
		print(CUST.INTERFACE.clgZoneDate)
	#}
	ENDIF
	
	CUST.INTERFACE.DrTranAmt = CUST.INTERFACE.instAmt
	CUST.INTERFACE.CrTranAmt = CUST.INTERFACE.instAmt
	CUST.INTERFACE.CrAcct = CUST.INTERFACE.payingAcct

	BANCS.INPARAM.BINDVARS = "VERACIOUS|IN_CLRZONE_" + CUST.INTERFACE.ZoneCcy + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + BANCS.STDIN.contextBankId 		
	lv_s = "inwZoneCode|"
	lv_s = lv_s + "SELECT PARAMETER_VALUE FROM CUSTOM.C_CPVALUE "
	lv_s = lv_s + " WHERE MODULE_NAME = ?SVAR "
	lv_s = lv_s + " AND PARAMETER_ID = ?SVAR "
	lv_s = lv_s + " AND BANK_ID = ?SVAR "
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	IF(lv_d == 0)THEN
	#{
		CUST.INTERFACE.inwZoneCode = BANCS.OUTPARAM.inwZoneCode
		print(CUST.INTERFACE.inwZoneCode)
	#}
	ENDIF
	#-------------------------------------------------------------------------------
	#Getting paying account currency.	
	#-------------------------------------------------------------------------------

	sv_b = urhk_getAcctDetailsInRepository(CUST.INTERFACE.payingAcct)
	IF(sv_b == 1) THEN
	#{
		print("Account is  Invalid")
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.INTERFACE.payingAcctCcy = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.INTERFACE.payingAcctCcy)
	#}
	ENDIF

	#-------------------------------------------------------------------------------
	#Getting associated Bacid from CPARAM.
	#-------------------------------------------------------------------------------
	
	lv_s = "bacid|"
	lv_s = lv_s + "SELECT PARAMETER_VALUE FROM CUSTOM.C_CPVALUE "
	lv_s = lv_s + " WHERE MODULE_NAME ='VERACIOUS'"
	lv_s = lv_s + " AND PARAMETER_ID ='CHQ_OFACC'"
	lv_s = lv_s + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "'"
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	IF(lv_d == 0)THEN
	#{
		CUST.INTERFACE.bacid = BANCS.OUTPARAM.bacid
		print(CUST.INTERFACE.bacid)
	#}
	ELSE
	#{
		# Error in fetching Office Account Details 
		CUST.INTERFACE.errorCode = "ERR113"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF

        CUST.INTERFACE.showError = ""
        CUST.INTERFACE.callFlg = ""

        ###CUSTOMIZATION DONE TO FETCH THE HOME SOL ID DURING INWARD LODGE
        print(BANCS.STDIN.contextBankId)

        sv_g = "SolId|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER"
        sv_g = sv_g + " WHERE "
        sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
        sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
        sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
        sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
        sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
        sv_g = sv_g + " C_CPVALUE.parameter_id = ?SVAR"
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|VERACIOUS|HMESOLID"
        sv_d = urhk_dbSelectWithBind(sv_g)
        print(sv_d)
        if(sv_d == 0) then
        #{
                CUST.INTERFACE.hoSolId = BANCS.OUTPARAM.SolId
                print(CUST.INTERFACE.hoSolId)
        #}
        else
        #{
                CUST.INTERFACE.hoSolId  = BANCS.STDIN.homeSolId
        #}
        endif


