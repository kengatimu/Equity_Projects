	#----------------------------------------------------------------------------------------

	BANCS.INPUT.inputBacid = CUST.INTERFACE.bacid
	BANCS.INPUT.inputCcy   = CUST.INTERFACE.payingAcctCcy
	BANCS.INPUT.inputSolID = CUST.INTERFACE.hoSolId
	BANCS.INPUT.inputBankId = BANCS.STDIN.contextBankId

        sv_s = CUST.INTERFACE.bacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + CUST.INTERFACE.hoSolId
	print(CUST.INTERFACE.bacid)
	print(BANCS.STDIN.homeCrncyCode)
	print(CUST.INTERFACE.hoSolId)

        sv_u = urhk_B2k_BacidtoAcctId(sv_s)

        if (sv_u == 0) then
        #{
             BANCS.OUTPUT.AcctId  = BANCS.OUTPARAM.AcctId
        #}
        endif

	#CALL("bacidtoacid.scr")

	CUST.INTERFACE.DrAcct = BANCS.OUTPUT.AcctId
