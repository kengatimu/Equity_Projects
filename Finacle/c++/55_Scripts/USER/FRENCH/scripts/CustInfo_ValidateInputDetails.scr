<--start
trace on

#-------------------------------------------------------------------------------
# Validating the Foracid Entered 
#-------------------------------------------------------------------------------

BANCS.INPARAM.BINDVARS = CUST.INTERFACE.foracid +"|"+ BANCS.STDIN.contextBankId

sv_q = "newForacid|SELECT FORACID"
sv_q = sv_q + " FROM TBAADM.GAM"
sv_q = sv_q + " WHERE FORACID = ?SVAR "
sv_q = sv_q + " AND DEL_FLG = 'N' "
sv_q = sv_q + " AND BANK_ID = ?SVAR "
	
sv_e = urhk_dbSelectWithBind(sv_q)
print(sv_e)
	
IF(sv_e != 0)THEN
#{

	IF(CUST.INTERFACE.PaymentType == "E") THEN
	#{
		CUST.INTERFACE.errorCode = "ERR110"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ELSE
	#{
		sv_l = strlen(BANCS.STDIN.mySolId)
		CUST.INTERFACE.foracidTrim = MID$(CUST.INTERFACE.foracid,sv_l,STRLEN(CUST.INTERFACE.foracid))
		print(CUST.INTERFACE.foracidTrim)
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.foracidTrim + "|" +  BANCS.STDIN.contextBankId

		sv_q = "newForacid|SELECT CUSTOM.VERACIOUS_ACCT(?SVAR,?SVAR)"
		sv_q = sv_q + " FROM DUAL"

		sv_e = urhk_dbSelectWithBind(sv_q)
		print(sv_e)

		IF(sv_e != 0)THEN
		#{
			CUST.INTERFACE.errorCode = "ERR110"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ELSE
		#{
			IF(CINT(BANCS.OUTPARAM.newForacid) == 0)THEN
