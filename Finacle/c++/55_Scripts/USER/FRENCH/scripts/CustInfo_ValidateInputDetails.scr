			       CUST.INTERFACE.errorCode = "ERR110"
			       CUST.INTERFACE.successOrFailure = "F"
			       GOTO FINISH
			#}
			ENDIF
			IF(CINT(BANCS.OUTPARAM.newForacid)== 2  )THEN
