########################################################################################################
<--START
CHECKSUM="790bb79cb967328f7e20e8e5dd41c77cabedca98993709878d59cccd9037c449"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Bank id"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Bankid=BANCS.INPUT.Bankid
		print(CUST.DATA.Bankid)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("DebitAccount"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Credit Account Number"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.DebitAccount=BANCS.INPUT.DebitAccount
		print(CUST.DATA.DebitAccount)
	#}
	ENDIF
	
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("REFNUM"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply REFNUM"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.REFNUM=BANCS.INPUT.REFNUM
		print(CUST.DATA.REFNUM)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("RRN"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply RRN"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.RRN=BANCS.INPUT.RRN
		print(CUST.DATA.RRN)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("Amount"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Amount"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Amount=BANCS.INPUT.Amount
		print(CUST.DATA.Amount)
	#}
	ENDIF

	
	sv_h = mid$(BANCS.STDIN.BODDate,0,10)
	print(sv_h)
	sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
	BANCS.INPARAM.BINDVARS =  sv_h
	sv_d = urhk_dbSelectWithBind(sv_s)
	##print(sv_d)
	IF (sv_d =="0") THEN
		CUST.DATA.getboddate = BANCS.OUTPARAM.getboddate
		print(CUST.DATA.getboddate)
	ENDIF

	############################################
	# Fetching the value from table
	############################################

	sv_q = " tranid,trandate,bankidded,valuedate,entrydate| "
	sv_q = sv_q + " select tran_id,tran_date,bank_id,value_date,ENTRY_DATE from tbaadm.dtd where bank_id=?SVAR  and acid in (select acid from tbaadm.gam  where bank_id=?SVAR and foracid=?SVAR ) "
	sv_q = sv_q + " and tran_date=?SVAR and tran_amt=?SVAR and PART_TRAN_TYPE='C'  and REF_NUM =?SVAR "
	sv_q = sv_q + " and del_flg='N' and tran_particular LIKE CONCAT(CONCAT('%',?SVAR),'%') "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.DebitAccount + "|" + CUST.DATA.getboddate + "|" + CUST.DATA.Amount + "|" + CUST.DATA.REFNUM  + "|" + CUST.DATA.RRN
	print(BANCS.INPARAM.BINDVARS)
	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)
	
	IF (sv_p==0) THEN
	#{
		CUST.DATA.varValue1 = BANCS.OUTPARAM.tranid
		print (CUST.DATA.varValue1)
		sv_z = urhk_SetOrbOut("TRAN_ID|"+CUST.DATA.varValue1)
		print(sv_z)

		CUST.DATA.boddate = CUST.DATA.getboddate
		print (CUST.DATA.boddate)
		sv_z = urhk_SetOrbOut("BOD_DATE|"+CUST.DATA.boddate)
		print(sv_z)

		sv_e = urhk_SetOrbOut("StattusCode|1")
		print(sv_e)
		#}
	ELSE
		#{
		CUST.DATA.errMsg="Data Error/Data does not exist "
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	#}
	ENDIF
	
	End:
		EXITSCRIPT
		TRACE OFF
END-->
