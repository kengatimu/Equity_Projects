		sv_s = sv_s + "FROM CUSTOM.CUSTOM_CEXCHRT"
		sv_s = sv_s + " WHERE ROLE_ID = ?SVAR AND FROM_CURRENCY = ?SVAR AND TO_CURRENCY = ?SVAR"
		sv_s = sv_s + "  AND BANK_ID = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CEXCH.roleId + "|" + CUST.CEXCH.frmccyCode + "|" + CUST.CEXCH.toccyCode  + "|" +  BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		CUST.CEXCH.roleId =BANCS.OUTPARAM.roleId
		PRINT(CUST.CEXCH.roleId)
		
		CUST.CEXCH.frmccyCode =BANCS.OUTPARAM.frmccyCode
		PRINT(CUST.CEXCH.frmccyCode)
		CUST.CEXCH.toccyCode =BANCS.OUTPARAM.toccyCode
		PRINT(CUST.CEXCH.toccyCode)
		#CUST.CEXCH.transfer_margin_amt =BANCS.OUTPARAM.marginAmt
		#PRINT(CUST.CEXCH.transfer_margin_amt)
		CUST.CEXCH.transfer_margin_amt =BANCS.OUTPARAM.transfer_margin_amt
		PRINT(CUST.CEXCH.transfer_margin_amt)
		CUST.CEXCH.cash_margin_amt =BANCS.OUTPARAM.cash_margin_amt
		PRINT(CUST.CEXCH.cash_margin_amt)
		CUST.CEXCH.rate =BANCS.OUTPARAM.rate
		PRINT(CUST.CEXCH.rate)
		
		
		sv_u = urhk_SetOrbOut("roleId|"+ CUST.CEXCH.roleId)
		PRINT(sv_u)
		
		sv_u = urhk_SetOrbOut("frmccyCode|"+ CUST.CEXCH.frmccyCode)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("toccyCode|"+ CUST.CEXCH.toccyCode)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("txmrgnAmt|"+ CUST.CEXCH.transfer_margin_amt)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("cashmrgnAmt|"+ CUST.CEXCH.cash_margin_amt)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("rate|"+ CUST.CEXCH.rate)
		PRINT(sv_u)
		PRINT(sv_u)
	#}
	ENDIF
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	PRINT(sv_z)
	TRACE OFF
	ENDOFSCRIPT:
