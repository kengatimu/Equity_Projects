	print(CUST.LAOPN.schmCode)

	sv_a = urhk_SRV_GetVal("acctCriteria.crncyCode.crncyCode")
	CUST.LAOPN.crncyCode =BANCS.OUTPARAM.srvValue
	print(CUST.LAOPN.crncyCode)
	
	sv_a = urhk_SRV_GetVal("defaultLaAcct.hldyPerdIntFlg")
	CUST.LAOPN.hldyPerdIntFlg =BANCS.OUTPARAM.srvValue
	print(CUST.LAOPN.hldyPerdIntFlg)
	
	IF(CUST.LAOPN.hldyPerdIntFlg == "") THEN
	#{
		sv_q = "hldyPerdIntFlg, hldyPerdFreqType, hldyPerdFreqWeekNum, hldyPerdFreqWeekDay, hldyPerdFreqStartDD, hldyPerdFreqHldyStat "
		sv_q = sv_q + "|SELECT "
