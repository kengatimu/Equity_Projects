<--START
TRACE ON
	IF(BANCS.STDIN.roleId != "CDCI") THEN
		GOTO ENDOFSCR
	ENDIF

	IF (REPEXISTS("CUST") == 0) THEN
	#{
        CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","LAOPN") == 0) THEN
	#{
        CREATECLASS("CUST","LAOPN",5)
	#}
	ENDIF
	
	sv_a=urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_a)
	
	sv_a = urhk_SRV_GetVal("acctCriteria.schmCode.schmCode")
