		sv_q = sv_q + " HLDY_PERD_FREQ_WEEK_DAY,HLDY_PERD_FREQ_START_DD,HLDY_PERD_FREQ_HLDY_STAT "
		sv_q = sv_q + " FROM TBAADM.LSP "
		sv_q = sv_q + " WHERE SCHM_CODE = ?SVAR "
		sv_q = sv_q + " AND CRNCY_CODE = ?SVAR "
		sv_q = sv_q + " AND BANK_ID = ?SVAR "
		PRINT(sv_q)
		BANCS.INPARAM.BINDVARS = CUST.LAOPN.schmCode + "|" + CUST.LAOPN.crncyCode + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_z = urhk_dbselectWithBind(sv_q)
		PRINT(sv_z)
		
		IF(sv_z == 0) THEN
		#{
			CUST.LAOPN.hldyPerdIntFlg = BANCS.OUTPARAM.hldyPerdIntFlg
			PRINT(CUST.LAOPN.hldyPerdIntFlg)
			CUST.LAOPN.hldyPerdFreqType = BANCS.OUTPARAM.hldyPerdFreqType
			PRINT(CUST.LAOPN.hldyPerdFreqType)
			CUST.LAOPN.hldyPerdFreqWeekNum = BANCS.OUTPARAM.hldyPerdFreqWeekNum
			PRINT(CUST.LAOPN.hldyPerdFreqWeekNum)
			CUST.LAOPN.hldyPerdFreqWeekDay = BANCS.OUTPARAM.hldyPerdFreqWeekDay
			PRINT(CUST.LAOPN.hldyPerdFreqWeekDay)
			CUST.LAOPN.hldyPerdFreqStartDD = BANCS.OUTPARAM.hldyPerdFreqStartDD
			PRINT(CUST.LAOPN.hldyPerdFreqStartDD)
			CUST.LAOPN.hldyPerdFreqHldyStat = BANCS.OUTPARAM.hldyPerdFreqHldyStat
			PRINT(CUST.LAOPN.hldyPerdFreqHldyStat)
		#}
		ELSE
		#{
			PRINT("ERROR")
			GOTO ENDOFSCR
		#}
		ENDIF
	
		IF(CUST.LAOPN.hldyPerdIntFlg != "N") THEN
		#{
			sv_a = urhk_SRV_SetVal("defaultLaAcct.hldyPerdIntFlg|"+CUST.LAOPN.hldyPerdIntFlg)
			PRINT(sv_a)
			
			sv_a = urhk_SRV_SetVal("defaultLaAcct.hldyFrequency.type|"+CUST.LAOPN.hldyPerdFreqType)
