# Template Name :		payoff.mrt
# Description	:		Unverified Payoff Account exist
# Author			KIM MUGAMBI,03-11-2016.
# Modified			JAMES IRUNGU 08-09-2018
#########################################################################
RECORDLAYOUT

SOL_ID		 stringType
FORACID		 stringtype
ACCT_NAME 	 stringtype
EVENT_ID	 stringType
RCRE_USER_ID	 stringtype
VALUE_DATE	 stringtype
TRAN_ID 	 stringtype

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 105
columnsperline 105
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 105 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
 begin
        execute pipe	
	print SOL_ID  column 6
	print FORACID      column 14
	print ACCT_NAME     column 30
	print EVENT_ID   column 58		
	print RCRE_USER_ID  column 67
	print VALUE_DATE  column 79
	print TRAN_ID  column 92
	
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL ID" column  5
	print "ACC NUM"     COLUMN 13	
	print "ACCT_NAME"   column 30
	print "EVENT_ID"   column  57		
	print "ENTERER_ID" column  67
	print "VALUE_DATE" column  79
	print "TRAN_ID" column  92
	Separatorline

end 
	
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 105 center 
	nextline
	print branchName  size 105 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 105 center
	nextline
	print "UNVERIFIED PAYOFF/HLASPAY ACCOUNT(S)EXIST"  size 105 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 105 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 3
	print "|"   column 12
	print "|"   column 28
	print "|"   column 56
	print "|"   column 65
	print "|"   column 77
	print "|"   column 90
	print "|"   column 105
end


