#############################################################################
#  FILE   :  NonSuitFiledRpt.mrt
#  DATE   :  13-12-2004
#  AUTHOR :  Jaya Lakshmi Darsi
#  DESC   :  This is the Mahareport specs for generating Statement of non
#            Suit Filed Accounts.
#
#############################################################################
#
#
RECORDLAYOUT
#############################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#############################################################################
#
$$$include NonSuitFiledRpt.mri
#
LOCALVARIABLES
#############################################################################
# Local variables are defined here
srl_num         numberType
decCount 		numberType
decSum   		numberType
ndecCount		numberType
ndecSum			numberType
nSuitCount  	numberType
nSuitSum		numberType
GTotCount  		numberType
GTotSum     	numberType
totdecCount 	numberType
totdecSum   	numberType
totndecCount	numberType
totndecSum		numberType
totnSuitCount  	numberType
totnSuitSum		numberType
totGTotCount	numberType
totGTotSum     	numberType
count           numberType
localdate       numberType
localyears      numberType
#############################################################################
#
GROUPANDSORT
#############################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in
#   RECORDLAYOUT section.
#############################################################################
crncyCode         ascending
#suitStatus        ascending
sectorCode        ascending 
subSectorCode     ascending
industryCode      ascending
##############################################################################
REPOSITORY bankRepos.rip readonly  
localYearsToAdd        stringType
#
REPOSITORY argv4
PAGE_NUMBER              numberType
crit_reportTo            stringType
crit_solSetId            stringType
crit_acctNum             stringType
crit_custId              stringType
crit_asOnDate            stringType
crit_fromDate  			 stringType
crit_toDate              stringType
crit_suitStatus          stringType
crit_courtOrTribunal     stringType
crit_rptCrncyCode        stringType
#
#############################################################################
#
#   IGNORERECORD (Optional Section).
#   The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
#   for input records), the record is Ignored.
#
#############################################################################
#
#IGNORERECORD
#if (pastDueFlg != "Y")
#
PAGEHEADER
  print "Page No."    column 82
  print pageNumber size 5 precision 0
  nextline
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "" column 82
  print " "
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "HH24:NN:SS"
  nextline
  nextline
  print "STATEMENT ON NON-SUIT FILED ACCOUNTS AS ON  " column 26
  set localdate = stringToDate  crit_asOnDate
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat ""
  nextline
#
PAGEFORMAT
#############################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
#############################################################################
linesperPage    65
columnsperline 170
topMargin        0
bottomMargin     0
leftMargin       0
pageHeaderLines  8
pageFooterLines  2
#
ONSTARTOFREPORT
#
set localyears = strToNum localYearsToAdd
set pageNumber	 	= 1
set srl_num 	 	= 0
nextline
nextline
nextline
print "STATEMENT ON NON-SUIT FILED ACCOUNTS AS ON  " column 29
if (crit_asOnDate != "")
begin
	print substr crit_asOnDate 1,2
 	print "/"
  	print substr crit_asOnDate 4,2
end
nextline
nextline
execute printCriteria
#
BEFOREBREAKOF industryCode
execute clearCounts
#
AFTERBREAKOF industryCode
	if ( srl_num != 0)
		execute printRecord
#
BEFOREBREAKOF CrncyCode
nextpage
execute pageHeader
execute clearCounts
set srl_num			= 0
set totdecCount     = 0
set totdecSum       = 0
set totndecCount    = 0
set totndecSum      = 0
set totnSuitCount   = 0
set totnSuitSum     = 0
set totGTotCount    = 0
set totGTotSum      = 0
#
AFTERBREAKOF crncyCode
 	if ( srl_num != 0)
	begin
		execute printTotal
		execute summary
	end
#
ONEVERYRECORD
set srl_num = srl_num + 1
if (SuitStatus = "DCREE")
begin
	set decCount = decCount + 1
	set decSum	 = decSum + liability
end
else if (SuitStatus = "NDCRE")
begin
	set ndecCount = ndecCount + 1
	set ndecSum	 = ndecSum + liability
end
else 
begin
	set nSuitCount = nSuitCount + 1
	set nSuitSum   = nSuitSum + liability
end
	set GTotCount= GTotCount + 1
	set GTotSum  = GTotSum + liability
#	 
ONENDOFREPORT
	nextline
	nextline
	nextline
	nextline
	nextline
	nextline
	if (srl_num = 0)
		print "  *****  NO RECORD FOUND *****  "	column 25

	nextline
	nextline
	nextline
	print "*** " column 24
	print pageNumber size 3 column 30 precision 0
	print " PAGE(S) PRINTED. ****END OF REPORT****" size 40 column 34
	nextline
#
    set PAGE_NUMBER = pagenumber
#
	
PROCEDURE summary
begin
   	if (linesleftinpage < 15)
		nextpage
   	nextline
   	nextline
   	nextline
   	print  "SUMMARY FOR THE ABOVE REPORT" column 20 center size 60
   	nextline
   	separatorline
   	nextline
   	print "                   Category              Total No of Accounts           Amount  " column 1
   	nextline
	separatorline
	print "Suit Filed - Decreed Accounts"  		column 10
	print totdecCount                      		column 50
	print abs totdecSum                    		column 70 autocomma precision 2 size 20
	if (totdecSum < 0)
		print "Dr"
	if (totdecSum > 0)
		print "Cr"
	nextline
	print "Suit Filed - Non Decreed Accounts"	column 10
	print totndecCount                     		column 50
	print abs totndecSum                   		column 70 autocomma precision 2 size 20
	if (totndecSum < 0)
		print "Dr"
	if (totndecSum > 0)
		print "Cr"
	nextline
	print "Non  Suit Filed  Accounts"  		    column 10
	print totnSuitCount                    		column 50
	print abs totnSuitSum                  		column 70 autocomma precision 2 size 20
	if (totnSuitSum < 0)
		print "Dr"
	if (totnSuitSum > 0)
		print "Cr"
	nextline
	print "Total"                               column 10
	print totGTotCount                          column 50
	print abs totGTotSum                        column 70 autocomma precision 2 size 20
	if (totGTotSum < 0)
		print "Dr"
	if (totGTotSum > 0)
		print "Cr"
	nextline
	nextline
	separatorline
end

PROCEDURE printRecord	
begin
	
	set totdecCount = totdecCount + decCount
	set totdecSum   = totdecSum + decSum
	set totndecCount= totndecCount + ndecCount
	set totndecSum   = totndecSum + ndecSum
	set totnSuitCount = totnSuitCount + nSuitCount
	set totnSuitSum   = totnSuitSum + nSuitSum
	set totGTotCount = totGTotCount + GTotCount
	set totGTotSum   = totGTotSum + GTotSum
	if ( linesleftinpage < 4 )
	begin
    	nextPage
    	execute pageHeader
	end
	print sectorCode	column 7
	print "-"        	column 12
	print subSectorCode	column 13
	print "-"        	column 18
	print industryCode 	column 19 
	print decCount      column 30
	print abs decSum    column 36 autocomma precision 2 size 20
   	if (decSum < 0) 
		print "Dr" 
   	if (decSum > 0) 
		print "Cr" 
	print ndecCount     column 65
   	print abs ndecSum   column 71 autocomma precision 2 size 20
   	if (ndecSum < 0) 
		print "Dr" 
	if (ndecSum > 0)	
		print "Cr" 
   	print nSuitCount    column 100
   	print abs nSuitSum  column 106 autocomma precision 2 size 20
   	if (nSuitSum < 0) 
		print "Dr" 
	if (nSuitSum > 0)	
		print "Cr" 
   	print GTotCount     column 135
   	print abs GTotSum   column 141 autocomma precision 2 size 20	
   	if (GTotSum < 0) 
		print "Dr" 
	if (GTotSum > 0)
		print "Cr" 
	nextline
	nextline
end
#
PROCEDURE clearCounts
begin
	set decCount        = 0
	set decSum          = 0
	set ndecCount       = 0
	set ndecSum         = 0
	set nSuitCount      = 0
	set nSuitSum        = 0
	set GTotCount       = 0
	set GTotSum         = 0
end
PROCEDURE printTotal
begin
	nextline
	separatorline
	print "Total"  		column 12
	print totdecCount   column 30
	print abs totdecSum column 36 autocomma precision 2 size 20
   	if (totdecSum < 0) 
		print "Dr" 
   	if (totdecSum > 0) 
		print "Cr" 
	print totndecCount   column 65 
	print abs totndecSum column 71 autocomma precision 2 size 20
   	if (totndecSum < 0) 
		print "Dr" 
   	if (totndecSum > 0) 
		print "Cr" 
	print totnSuitCount   column 100
	print abs totnSuitSum column 106 autocomma precision 2 size 20
   	if (totnSuitSum < 0) 
		print "Dr" 
   	if (totnSuitSum > 0) 
		print "Cr" 
	print totGTotCount   column 135
	print abs totGTotSum column 141 autocomma precision 2 size 20
   	if (totGTotSum < 0) 
		print "Dr" 
   	if (totGTotSum > 0) 
		print "Cr" 
	separatorline
end
#==========================================================================
PROCEDURE pageHeader
#==========================================================================
begin
  nextline
  print "Currency Code :  " column 3
  print crncyCode 
  separatorline
  print "       Category               Suit Filed - Decreed            Suit Filed - Non Decreed               Non Suit Filed                        Total "
  nextline
  print "                        ------------------------------    --------------------------------     ----------------------------      -------------------------------- "
  nextline	
  print "						 No. of A/c          Amount       No. of A/c             Amount         No. of A/c       Amount          No. of A/c       Amount "
  separatorline
  nextline
end
#==========================================================================
PROCEDURE printCriteria
#==========================================================================
    nextLine
    nextLine
    separatorLine
    nextline
    nextline
    print   "SELECTION CRITERIA"              column 40
    nextline
    print   "-------------------"             column 40
    nextline
    nextline
    print   "Report To                : "     column 30
    print   crit_reportTo
    nextline
    print   "Set Id                   : "     column 30
    print   crit_solSetId
    nextLine
    print   "Account Num              : "     column 30
    print   crit_acctNum
    nextline
    print   "CIF ID                   : "     column 30
    print   crit_custId
    nextline
    print   "As on date               : "     column 30
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "From Date                : "     column 30
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextLine
    print   "To Date                  : "     column 30
    set localdate = stringToDate  crit_toDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "Suit Status              : "     column 30
    print   crit_suitStatus
    nextline
    print   "Judicial Authority       : "     column 30
    print   crit_courtOrTribunal
    nextline
    print   "Report Currency Code     : "     column 30
    print   crit_rptCrncyCode
    nextline
	nextline
    separatorLine
#============================ End Of File ================================

