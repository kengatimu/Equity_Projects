sql.Timestamp%7::CATOD_AVAILMENT_VIEW%LODGED_USER%CATOD_AVAILMENT_VIEW_LODGED_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%LODGED_DATE%CATOD_AVAILMENT_VIEW_LODGED_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%VERIFIED_USER%CATOD_AVAILMENT_VIEW_VERIFIED_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%VERIFIED_DATE%CATOD_AVAILMENT_VIEW_VERIFIED_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%RCRE_USER%CATOD_AVAILMENT_VIEW_RCRE_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%RCRE_DATE%CATOD_AVAILMENT_VIEW_RCRE_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%LCHG_USER%CATOD_AVAILMENT_VIEW_LCHG_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%LCHG_DATE%CATOD_AVAILMENT_VIEW_LCHG_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%MSG_IND%CATOD_AVAILMENT_VIEW_MSG_IND%java.lang.String%1::CATOD_AVAILMENT_VIEW%EMAIL_FLG%CATOD_AVAILMENT_VIEW_EMAIL_FLG%java.lang.String%1::CATOD_AVAILMENT_VIEW%SMS_FLG%CATOD_AVAILMENT_VIEW_SMS_FLG%java.lang.String%1::CATOD_AVAILMENT_VIEW%IS_DELETED%CATOD_AVAILMENT_VIEW_IS_DELETED%java.lang.String%1::CATOD_AVAILMENT_VIEW%MAX_LIMIT%CATOD_AVAILMENT_VIEW_MAX_LIMIT%java.math.BigDecimal%22::CATOD_AVAILMENT_VIEW%FREE_TEXT_1%CATOD_AVAILMENT_VIEW_FREE_TEXT_1%java.lang.String%50::|!NULL!|CATOD_AVAILMENT_VIEW%SANCT_ID%CATOD_AVAILMENT_VIEW_SANCT_ID%java.lang.String%16::CATOD_AVAILMENT_VIEW%ACCT_NAME%CATOD_AVAILMENT_VIEW_ACCT_NAME%java.lang.String%80::|!NULL!|CATOD_AVAILMENT_VIEW%SANCT_ID%CATOD_AVAILMENT_VIEW_SANCT_ID%java.lang.String%16::CATOD_AVAILMENT_VIEW%ACCT_NAME%CATOD_AVAILMENT_VIEW_ACCT_NAME%java.lang.String%80::|where%CATOD_AVAILMENT_VIEW.SOL_ID%=%$P{SOL_ID}%Parameter%String::and%CATOD_AVAILMENT_VIEW.GRANT_DATE%=%$P{CREATE_DATE}%Parameter%Date::|SOL_ID%java.lang.String%8%!NULL!%SOL ID@DBQUERY%PRODUCT!@!SolID_List#@#N%java.lang.String!@!DEFAULT!@!0!@!8%CONSTANT%N%N::CREATE_DATE%java.sql.Timestamp%10%!NULL!%CREATION FROM DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::END_DATE%java.sql.Timestamp%10%!NULL!%CREATION TO DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::|!NULL!|!NULL!|!NULL!|select     CATOD_AVAILMENT_VIEW.SANCT_ID as *CATOD_AVAILMENT_VIEW_SANCT_ID* ,     CATOD_AVAILMENT_VIEW.ACCT_NAME as *CATOD_AVAILMENT_VIEW_ACCT_NAME* from     CUSTOM.CATOD_AVAILMENT_VIEW CATOD_AVAILMENT_VIEW  where    CATOD_AVAILMENT_VIEW.SOL_ID = $P{SOL_ID}     and CATOD_AVAILMENT_VIEW.GRANT_DATE = TO_DATE( CAST ( $P{CREATE_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )|SELECT A.SOL_ID,   B.ACCT_NUM,   B.ACCT_NAME,   A.DISCRET_ADVN_START_DATE TOD_START_DATE,   A.DISCRET_ADVN_DUE_DATE TOD_DUE_DATE,   A.DISCRET_ADVN_AMT TOD_AMOUNT,   A.DISCRET_ADVN_REGLR_IND TOD_STATUS,   NVL(TO_CHAR(CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE),'DD/MM/YYYY'),'-') REGULARIZATION_DATE ,   A.REGULARISED_AMT,   'CATOD' TOD_TYPE,   B.CREATED_BY,   to_char(A.RCRE_TIME,'DD-MM-YYYY HH24:MI:SS') CREATED_TIME ,   C.CLR_BAL_AMT ACCT_BAL,   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE- A.DISCRET_ADVN_DUE_DATE),'0') NO_OF_DAYS_OVERDUE,   CASE      WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN 0 AND 30     THEN 'NORMAL'     WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  31 AND 90      THEN 'WATCH'      WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  91 AND 180      THEN 'SUBSTANDARD'      WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  181 AND 365      THEN 'DOUBTFUL'     ELSE 'LOSS'   END AS CLASSFICATION,   TRUNC(SYSDATE) REPORT_AS_ON FROM CUSTOM.CATOD_AVAILMENT_VIEW B ,   TBAADM.DAT A,   TBAADM.GAM C WHERE C.ACID  = A.ACID AND C.FORACID = B.ACCT_NUM AND A.DISCRET_ADVN_START_DATE = B.GRANT_DATE AND A.DISCRET_ADVN_DUE_DATE   = B.EXPIRY_DATE AND CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE)IS  NULL AND A.DISCRET_ADVN_REGLR_IND in ('U') AND (B.SOL_ID                 = $P{SOL_ID} OR NVL($P{SOL_ID},'ALL')      ='ALL')                     AND TRUNC(B.GRANT_DATE)   BETWEEN TO_DATE(NVL($P{CREATE_DATE},'01-01-1900'),'DD-MM-YYYY')  AND TO_DATE(NVL($P{END_DATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY')  UNION  SELECT A.SOL_ID,   B.FORACID,   B.ACCT_NAME,   A.DISCRET_ADVN_START_DATE TOD_START_DATE,   A.DISCRET_ADVN_DUE_DATE TOD_DUE_DATE,   A.DISCRET_ADVN_AMT TOD_AMOUNT,   A.DISCRET_ADVN_REGLR_IND TOD_STATUS,   NVL(TO_CHAR(CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE),'DD/MM/YYYY'),'-') REGULARIZATION_DATE ,   A.REGULARISED_AMT,   DECODE(A.RCRE_USER_ID, 'SWT', 'CHANNEL', 'EAZ', 'CHANNEL','FINACLE'),   A.RCRE_USER_ID,   to_char(A.RCRE_TIME,'DD-MM-YYYY HH24:MI:SS'),   B.CLR_BAL_AMT,   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') NO_OF_DAYS_OVERDUE,   CASE      WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN 0 AND 30     THEN 'NORMAL'     WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  31 AND 90      THEN 'WATCH'      WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  91 AND 180      THEN 'SUBSTANDARD'      WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE- A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  181 AND 365      THEN 'DOUBTFUL'     ELSE 'LOSS'   END AS CLASSFICATION,   SYSDATE FROM TBAADM.DAT A ,   TBAADM.GAM B WHERE B.ACID                   = A.ACID AND A.DISCRET_ADVN_START_DATE BETWEEN TO_DATE(NVL($P{CREATE_DATE},'01-01-1900'),'DD-MM-YYYY')  AND TO_DATE(NVL($P{END_DATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY')  AND (A.SOL_ID                  = $P{SOL_ID} OR NVL($P{SOL_ID},'ALL')       ='ALL') AND A.ENTITY_TYPE              = 'TODMN' AND CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE)IS  NULL AND A.DISCRET_ADVN_REGLR_IND in ('U')|true"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT A.SOL_ID,
  B.ACCT_NUM,
  B.ACCT_NAME,
  A.DISCRET_ADVN_START_DATE TOD_START_DATE,
  A.DISCRET_ADVN_DUE_DATE TOD_DUE_DATE,
  A.DISCRET_ADVN_AMT TOD_AMOUNT,
  A.DISCRET_ADVN_REGLR_IND TOD_STATUS,
  NVL(TO_CHAR(CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE),'DD/MM/YYYY'),'-') REGULARIZATION_DATE ,
  A.REGULARISED_AMT,
  'CATOD' TOD_TYPE,
  B.CREATED_BY,
  to_char(A.RCRE_TIME,'DD-MM-YYYY HH24:MI:SS') CREATED_TIME ,
  C.CLR_BAL_AMT ACCT_BAL,
  DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE- A.DISCRET_ADVN_DUE_DATE),'0') NO_OF_DAYS_OVERDUE,
  CASE 
    WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN 0 AND 30
    THEN 'NORMAL'
    WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  31 AND 90
     THEN 'WATCH'
     WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  91 AND 180
     THEN 'SUBSTANDARD'
     WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  181 AND 365
     THEN 'DOUBTFUL'
    ELSE 'LOSS'
  END AS CLASSFICATION,
  TRUNC(SYSDATE) REPORT_AS_ON
FROM CUSTOM.CATOD_AVAILMENT_VIEW B ,
  TBAADM.DAT A,
  TBAADM.GAM C
WHERE C.ACID  = A.ACID
AND C.FORACID = B.ACCT_NUM
AND A.DISCRET_ADVN_START_DATE = B.GRANT_DATE
AND A.DISCRET_ADVN_DUE_DATE   = B.EXPIRY_DATE
AND CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE)IS  NULL
AND A.DISCRET_ADVN_REGLR_IND in ('U')
AND (B.SOL_ID                 = $P{SOL_ID}
OR NVL($P{SOL_ID},'ALL')      ='ALL')                    
AND TRUNC(B.GRANT_DATE)   BETWEEN TO_DATE(NVL($P{CREATE_DATE},'01-01-1900'),'DD-MM-YYYY') 
AND TO_DATE(NVL($P{END_DATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY')

UNION

SELECT A.SOL_ID,
  B.FORACID,
  B.ACCT_NAME,
  A.DISCRET_ADVN_START_DATE TOD_START_DATE,
  A.DISCRET_ADVN_DUE_DATE TOD_DUE_DATE,
  A.DISCRET_ADVN_AMT TOD_AMOUNT,
  A.DISCRET_ADVN_REGLR_IND TOD_STATUS,
  NVL(TO_CHAR(CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE),'DD/MM/YYYY'),'-') REGULARIZATION_DATE ,
  A.REGULARISED_AMT,
  DECODE(A.RCRE_USER_ID, 'SWT', 'CHANNEL', 'EAZ', 'CHANNEL','FINACLE'),
  A.RCRE_USER_ID,
  to_char(A.RCRE_TIME,'DD-MM-YYYY HH24:MI:SS'),
  B.CLR_BAL_AMT,
  DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') NO_OF_DAYS_OVERDUE,
  CASE 
    WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN 0 AND 30
    THEN 'NORMAL'
    WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  31 AND 90
     THEN 'WATCH'
     WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  91 AND 180
     THEN 'SUBSTANDARD'
     WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(SYSDATE- A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  181 AND 365
     THEN 'DOUBTFUL'
    ELSE 'LOSS'
  END AS CLASSFICATION,
  SYSDATE
FROM TBAADM.DAT A ,
  TBAADM.GAM B
WHERE B.ACID                   = A.ACID
AND A.DISCRET_ADVN_START_DATE BETWEEN TO_DATE(NVL($P{CREATE_DATE},'01-01-1900'),'DD-MM-YYYY') 
AND TO_DATE(NVL($P{END_DATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY') 
AND (A.SOL_ID                  = $P{SOL_ID}
OR NVL($P{SOL_ID},'ALL')       ='ALL')
AND A.ENTITY_TYPE              = 'TODMN'
AND CUSTOM.tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE)IS  NULL
AND A.DISCRET_ADVN_REGLR_IND in ('U')]]></queryString>

	<field name="SOL_ID" class="java.lang.String"/>
	<field name="ACCT_NUM" class="java.lang.String"/>
	<field name="ACCT_NAME" class="java.lang.String"/>
	<field name="TOD_START_DATE" class="java.sql.Timestamp"/>
	<field name="TOD_DUE_DATE" class="java.sql.Timestamp"/>
