	<field name="TOD_TYPE" class="java.lang.String"/>
	<field name="CREATED_BY" class="java.lang.String"/>
	<field name="CREATED_TIME" class="java.lang.String"/>
	<field name="ACCT_BAL" class="java.math.BigDecimal"/>
	<field name="NO_OF_DAYS_OVERDUE" class="java.math.BigDecimal"/>
	<field name="CLASSFICATION" class="java.lang.String"/>
	<field name="REPORT_AS_ON" class="java.sql.Timestamp"/>

