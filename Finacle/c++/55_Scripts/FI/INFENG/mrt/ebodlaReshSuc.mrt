####################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
fieldData1					stringType
fieldData2					stringType
fieldData3					stringType
fieldData4					stringType
fieldData5					stringType
fieldData6					stringType
fieldData7					stringType
fieldData8					stringType
fieldData9					stringType
fieldData10					stringType
fieldData11					stringType

#####################################################################
LOCALVARIABLES
#####################################################################
slno 						numberType           
total_pages					stringType
totalpages					numberType
reportCnt					numberType

#####################################################################
GroupAndSort
#####################################################################
ALREADYSORTED

#####################################################################
MASSAGERECORD
#####################################################################

#####################################################################  
REPOSITORY bankRepos.rip
####################################################################
bankName					stringType			
branchName					stringType	
BODDate						stringType		
userId						stringType		

#####################################################################  
#REPOSITORY argv4
###################################################################

######################################################################
PAGEFORMAT 
######################################################################
linesperpage					60	
columnsperline  			        280 
pageheaderlines					14
leftMargin					02
rightMargin					02
topMargin      					02 
bottomMargin					02	

######################################################################
ONSTARTOFREPORT
######################################################################
set slno=0
set reportCnt=0

execute RptHeader
execute pageHeader

######################################################################
PAGEHEADER
#####################################################################
execute RptHeader   
execute pageHeader

######################################################################
PAGEFOOTER
#####################################################################
separatorline

#####################################################################
ONEVERYRECORD
#####################################################################
set slno=slno+1
set reportCnt=1
execute printrecords

#####################################################################  
ONENDOFREPORT
#####################################################################
set total_pages=numtostr PageNumber
set totalpages=prntagVal "pages" total_pages
if (reportCnt!=0)
begin 
separatorline
end
if (reportCnt=0)
	begin
		print "No Data Found"			column 01       size 95        center
		nextline
	end

#####################################################################
PROCEDURE RptHeader
#####################################################################
begin 
	nextline
	print bankName					column 01	size 95		center
	nextline
	nextline
	print "UserID :"				column 74  
	print userId
	nextline
	print "Page   :"				column 74 		
	print Pagenumber
	print "/"
	print "<<pages>>"
	nextline
	nextline
	print "Loan Schedule Report of CODLAR menu" 	column 	74 	size 95 	center
	nextline

end

#####################################################################	
PROCEDURE pageHeader
#####################################################################
begin
	nextline
	separatorline
        print "|"                                      column 01       size 01
        print "Bank Id"                                 column 05       size 08 
        print "|"                                      column 13       size 01
        print "Loan AcctNumber"                         column 15       size 17
        print "|"                                      column 34       size 01
        print "Schdule Number"                          column 36       size 16
        print "|"                                      column 54       size 01
        print "Flow Id"                        		column 56       size 08 
        print "|"                                      column 66      size 01
        print "Demand Date"                   		column 68      size 15 
        print "|"                                      column 83      size 01
        print "Demand OverDue Date"                    	column 86      size 30 
        print "|"                                      column 118      size 01
        print "Demand Amount"                      	column 119      size 20 
        print "|"                                      column 142      size 01
        print "Last Recovery Date"                     	column 144      size 30 
        print "|"                                      column 176      size 01
        print "Total Adjust Amount"                     column 178      size 20 
        print "|"                                      column 200      size 01
        print "FlowId Seg"                     		column 203      size 20 
        print "|"                                      column 225      size 01
        print "FlowAmount Seg"                     	column 227      size 43 
        print "|"                                      column 273      size 01
 	separatorline
 end

#####################################################################
PROCEDURE printrecords
#####################################################################
begin
        print "|"                                      column 01       size 01
        print fieldData1                                column 05       size 08
        print "|"                                      column 13       size 01
        print fieldData2                           	column 15       size 17
        print "|"                                      column 34       size 01
        print fieldData3                           	column 36       size 16
        print "|"                                      column 54       size 01
        print fieldData4                        	column 56       size 08
        print "|"                                      column 66      size 01
        print fieldData5                         	column 68      size 15
        print "|"                                      column 83      size 01
        print fieldData6                          	column 86      size 30
        print "|"                                      column 118      size 01
        print fieldData7                      		column 119      size 20
        print "|"                                      column 142      size 01
        print fieldData8                     		column 144      size 30
        print "|"                                      column 176      size 01
        print fieldData9                     		column 178      size 20
        print "|"                                      column 200      size 01
        print fieldData10                     		column 203      size 20 
        print "|"                                      column 225      size 01
        print fieldData11                     		column 227      size 43 
        print "|"                                      column 273      size 01

end	
