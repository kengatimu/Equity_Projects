		PRINT(CUST.DD.PurchaserAcc)
	#}
	ELSE
	#{
		CUST.DD.PurchaserAcc=""
		PRINT(CUST.DD.PurchaserAcc)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("DemandDraftAmt"))== 1) ) THEN
	#{
		CUST.DD.DemandDraftAmt= BANCS.INPUT.DemandDraftAmt
		PRINT(CUST.DD.DemandDraftAmt)
