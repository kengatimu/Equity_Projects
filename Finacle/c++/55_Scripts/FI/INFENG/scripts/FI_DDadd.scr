	IF( (FIELDEXISTS(("BANCS").("INPUT").("printIndicator"))== 1) ) THEN
	#{
		CUST.DD.printIndicator= BANCS.INPUT.printIndicator
		PRINT(CUST.DD.printIndicator)
	#}
	ELSE
	#{
		CUST.DD.printIndicator=""
		PRINT(CUST.DD.printIndicator)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("TranID"))== 1) ) THEN
	#{
		CUST.DD.TranID= BANCS.INPUT.TranID
		PRINT(CUST.DD.TranID)
	#}
	ELSE
	#{
		CUST.DD.TranID=""
		PRINT(CUST.DD.TranID)
	#}
	ENDIF



	################################ Variable Inititalization#######################################################
	CUST.DD.branchCode= BANCS.STDIN.myBrCode
	print(CUST.DD.branchCode)
	CUST.DD.bankCode= BANCS.STDIN.myBankCode
	print(CUST.DD.bankCode)
	CUST.DD.Function= BANCS.INPUT.Function
	print(CUST.DD.Function)

	#----------------------------------------------------------------------------------
	#Function and charge code validation
	#----------------------------------------------------------------------------------
	IF((CUST.DD.Function!="A") AND (CUST.DD.Function!="P") )THEN
	#{
   		CUST.DD.errMsg="Invalid Function code. valid[A,P]"
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF(CUST.DD.Function=="A")THEN
	#{
		IF(CUST.DD.PurchaserAcc !="")THEN
		#{
			sv_h = urhk_getAcctDetailsInRepository(CUST.DD.PurchaserAcc)
			IF(sv_h==0)THEN
			#{
				CUST.DD.pcrncyCode=trim(BANCS.OUTPARAM.acctCrncyCode)
				print(CUST.DD.pcrncyCode)
			#}
			ELSE
			#{
   				CUST.DD.errMsg="Failed to fetch purchasers account currency"
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT	
			#}
			ENDIF
		#}
		ELSE
		#{
   			CUST.DD.errMsg="PurchaserAcc is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT	
		#}
		ENDIF
		IF(CUST.DD.IssueUserID !="")THEN
		#{
			sv_s = "usersolid|select SOL_ID from tbaadm.upr  "
			sv_s = sv_s + "where HOME_BANK_ID=?SVAR and user_id=?SVAR "
	
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.IssueUserID
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_r =  urhk_dbSelectWithBind(sv_s)
			print(sv_r)
			IF (sv_r ==0) THEN
			#{
				CUST.DD.usersolid= BANCS.OUTPARAM.usersolid
				print (CUST.DD.usersolid)
				#---------------------------------------------------------------------------------------------------------------
				#Fetch demand draft account
				#---------------------------------------------------------------------------------------------------------------
				IF(CUST.DD.DDacctCrncy !="")THEN
				#{
					sv_s="DemandDraftAcc , solid|"
					sv_s=sv_s + "Select foracid,sol_id From TBAADM.GAM  Where GAM.BANK_ID=?SVAR AND acct_cls_flg ='N' And entity_cre_flg='Y'"
					sv_s=sv_s + " And del_flg = 'N'  AND GAM.sol_id =?SVAR   AND GAM.schm_type='DDA'"
					sv_s=sv_s + " AND ROWNUM < 801 AND acct_crncy_code=?SVAR AND schm_code='BNKCH' "
					print(sv_s)
	
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DD.usersolid+ "|" + CUST.DD.DDacctCrncy
					print(BANCS.INPARAM.BINDVARS)

					sv_v = urhk_dbSelectWithBind(sv_s)
     	  				PRINT(sv_v)
					IF(sv_v == 0) THEN
       					#{
	     					CUST.DD.DDacct= BANCS.OUTPARAM.DemandDraftAcc 
    	     					print(CUST.DD.DDacct)	

						sv_h = urhk_getAcctDetailsInRepository(CUST.DD.DDacct)
						IF(sv_h==0)THEN
						#{
							CUST.DD.ddAcctCrncyCode = trim(BANCS.OUTPARAM.acctCrncyCode)
							print(CUST.DD.ddAcctCrncyCode)
						#}
						ELSE
						#{
   							CUST.DD.errMsg="Failed to Fetch Demand account currency"
							sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
							sv_t = "Msg| " +CUST.DD.errMsg
							sv_u = urhk_SetOrbOut(sv_t)
   							GOTO ENDSCRIPT
						#}
						ENDIF

						IF(CUST.DD.DemandDraftAmt !="")THEN
						#{
							CUST.DD.DDAMT = BANCS.INPUT.DemandDraftAmt
							CUST.DD.DDAMT= FORMAT$(CDOUBLE(CUST.DD.DDAMT),"%.2f")
							print(CUST.DD.DDAMT)
						#}
						ELSE
						#{
   							CUST.DD.errMsg="DemandDraftAmt is null"
							sv_t = "Msg| " +CUST.DD.errMsg
							sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
							sv_u = urhk_SetOrbOut(sv_t)
   							GOTO ENDSCRIPT
						#}
						ENDIF	
					#}
					ELSE
					#{
   						CUST.DD.errMsg="Failed to Fetch Demand Draft account"
						sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
						sv_t = "Msg| " +CUST.DD.errMsg
						sv_u = urhk_SetOrbOut(sv_t)
   						GOTO ENDSCRIPT
					#}
					ENDIF
				#}
				ELSE
				#{
   					CUST.DD.errMsg="DDacctCrncy is null"
					sv_t = "Msg| " +CUST.DD.errMsg
					sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO ENDSCRIPT
				#}
				ENDIF

			#}
			ELSE
			#{
   				CUST.DD.errMsg="Invalid UserID passed"
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
   			CUST.DD.errMsg="IssueUserID is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}	
		ENDIF

		IF(CUST.DD.tranType =="")THEN
		#{
   			CUST.DD.errMsg="tranType is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.tranSubType=="")THEN
		#{
   			CUST.DD.errMsg="tranSubType is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.payee=="")THEN
		#{
   			CUST.DD.errMsg="payee is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.printIndicator=="")THEN
		#{
   			CUST.DD.errMsg="printIndicator is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.charge=="")THEN
		#{
   			CUST.DD.errMsg="charge is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		else
		#{
			IF((CUST.DD.charge!="Y") AND (CUST.DD.charge!="N") )THEN
			#{
   				CUST.DD.errMsg="Invalid charge value. valid[N,Y]"
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF
			IF(CUST.DD.charge=="N")THEN
			#{
				IF(CUST.DD.waiverReasonCode=="")THEN
				#{
   					CUST.DD.errMsg="waiverReasonCode is null"
					sv_t = "Msg| " +CUST.DD.errMsg
					sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO ENDSCRIPT
				#}
				ENDIF
				IF(CUST.DD.waiverRemarks=="")THEN
				#{
   					CUST.DD.errMsg="waiverRemarks is null"
					sv_t = "Msg| " +CUST.DD.errMsg
					sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO ENDSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#----------------------------------------------------------------------------------
		#change context sol id
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.FlagType="A"
		BANCS.INPARAM.AcctId=CUST.DD.DDacct
		sv_u = urhk_ContextSOLUpdate("")
		IF(sv_u != 0) THEN	
		#{
			CUST.DD.errMsg="Failed to switch sol"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
			GOTO ENDSCRIPT
		#}
		ENDIF

		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.valueDate|" + BANCS.STDIN.BODDate)

		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranSubType.tranType|" + CUST.DD.tranType)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranSubType.tranSubType|" + CUST.DD.tranSubType)
		sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.purTranType.tranType|" + CUST.DD.tranType)
		sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.purTranType.tranSubType|" + CUST.DD.tranSubType)

		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commTranType.tranType|" + CUST.DD.tranType)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commTranType.tranSubType|" + CUST.DD.tranSubType)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.ddAcct.foracid|" + CUST.DD.DDacct)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.purAcct.foracid|" + CUST.DD.PurchaserAcc)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commAcct.foracid|" + CUST.DD.PurchaserAcc)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.prntOption.code|" + CUST.DD.printIndicator)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.purCrncy.crncyCode|" + CUST.DD.ddAcctCrncyCode)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.commCrncy.crncyCode|" + CUST.DD.pcrncyCode)

		sv_u = urhk_ExecSrv("SRV_FetchDataForDDMassIss|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.totDDAmt|" + CUST.DD.DDAMT+"|"+ BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp("ddMassIssHdr.funcCode|A")
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.key.serial_num|1")
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.ddAmt|"+ CUST.DD.DDAMT+"|"+ BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeBrCode.brCode|" + CUST.DD.usersolid)
			#sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeBrCode.brCode|145")

			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeBrCode.bankCode|" + CUST.DD.bankCode)
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.prntSol.solId|" + CUST.DD.usersolid)
			sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.payeeName|" + CUST.DD.payee)
			sv_u = urhk_SetUrhkOut("ddMassIssLL.<rec_0>.ddIssChrgs.totCommAmt|charge")

			sv_u = urhk_ExecSrv("SRV_ComputeChrgsForDDMassIssue|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				print(BANCS.OUTPARAM.charge)
				CUST.DD.ChargeAmt = BANCS.OUTPARAM.charge

				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
		
				IF(CUST.DD.charge=="N")THEN
				#{
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssChrgs.totCommAmt|             0.00")
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssChrgs.totPostAmt|             0.00")
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssChrgs.waiverReasonCode.refCode|"+CUST.DD.waiverReasonCode)
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssChrgs.ddChrgLL.<rec_0>.waiverReasonCode.refCode|"+CUST.DD.waiverReasonCode)
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssChrgs.ddChrgLL.<rec_0>.waiverRmks|" +CUST.DD.waiverRemarks)
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssChrgs.waiverRmks|"+CUST.DD.waiverRemarks)
					sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.totChrgAmt|             0.00")
					sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.totPurChrgAmt|                0")
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssChrgs.ddChrgLL.<rec_0>.actualAmtColl|             0.00")
					sv_u = urhk_SetUrhkInp("ddMassIssLL.<rec_0>.ddIssDtl.adviceGenPref|I")
					sv_u = urhk_SetUrhkInp("ddMassIssMiscDtl.totPurDDAmt|"+ CUST.DD.DDAMT+"|"+ BANCS.STDIN.homeCrncyCode)

				#}
				ENDIF


				sv_u = urhk_SetUrhkOut("ddMassIssHdr.tranDate|Date")
				sv_u = urhk_SetUrhkOut("ddMassIssHdr.tranId|tranId")

				sv_u = urhk_ExecSrv("SRV_AddDDMassIssDtl|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF(sv_u == 0) THEN
				#{
					print(BANCS.OUTPARAM.tranId)
					print(BANCS.OUTPARAM.Date)
					CUST.DD.TRANID = BANCS.OUTPARAM.tranId
					print(CUST.DD.TRANID)
					CUST.DD.Date= BANCS.OUTPARAM.Date
					print(CUST.DD.Date)

   					CUST.DD.Msg="Demand Draft issued successfully with transaction ID. " + CUST.DD.TRANID
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
					sv_t = "TranID| " +CUST.DD.TRANID
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "Msg| " +CUST.DD.Msg
					sv_u = urhk_SetOrbOut(sv_t)
					IF(CUST.DD.charge=="N")THEN
					#{
						CUST.DD.ChargeAmt="0.00"
						sv_t = "ChargeAmt|" +CUST.DD.ChargeAmt
						sv_u = urhk_SetOrbOut(sv_t)
					#}
					ELSE
					#{
						sv_t = "ChargeAmt| " +CUST.DD.ChargeAmt
						sv_u = urhk_SetOrbOut(sv_t)
					#}
					ENDIF

					sv_u = urhk_SetUrhkInp("sol.solId|000")
					sv_u = urhk_ExecSrv("SRV_ModifyContextSol")

   					GOTO ENDSCRIPT
				#}
				ELSE
				#{
					GOTO ERRORCHECK
				#}
				ENDIF
			#}
			ELSE
			#{
				GOTO ERRORCHECK
			#}
			ENDIF
		#}
		ELSE
		#{
			GOTO ERRORCHECK
		#}
		ENDIF
	#}
	ENDIF



	IF(CUST.DD.Function =="P")THEN
	#{
		IF(CUST.DD.TranID=="")THEN
		#{
   			CUST.DD.errMsg="TranID is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ELSE
		#{
			sv_s = "initsolid,tranid|select init_sol_id,tran_id from tbaadm.DD1 "
			sv_s = sv_s + "WHERE bank_id=?SVAR and Module_name='DDI' and trim(tran_id)=?SVAR"
	
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.TranID
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_r =  urhk_dbSelectWithBind(sv_s)
			print(sv_r)
			IF (sv_r ==0) THEN
			#{
				CUST.DD.initsolid= BANCS.OUTPARAM.initsolid
				print (CUST.DD.initsolid)
				CUST.DD.tranid= BANCS.OUTPARAM.tranid
				print (CUST.DD.tranid)

			#}
			ELSE
			#{
   				CUST.DD.errMsg="There is no mass issue transaction corresponding to the transaction ID [ " + CUST.DD.TranID + " ]."
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF

			IF(CUST.DD.PostUserID=="")THEN
			#{
   				CUST.DD.errMsg="PostUserID is null"
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ELSE
			#{
				sv_s = "usersolid|select SOL_ID from tbaadm.upr  "
				sv_s = sv_s + "where HOME_BANK_ID=?SVAR and user_id=?SVAR "
	
				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.PostUserID
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_r =  urhk_dbSelectWithBind(sv_s)
				print(sv_r)
				IF (sv_r ==0) THEN
				#{
					CUST.DD.usersolid= BANCS.OUTPARAM.usersolid
					print (CUST.DD.usersolid)
				#}
				ELSE
				#{
   					CUST.DD.errMsg="Invalid PostUserID"
					sv_t = "Msg| " +CUST.DD.errMsg
					sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO ENDSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

		IF(CUST.DD.usersolid ==CUST.DD.initsolid)THEN
		#{
			sv_u = urhk_SetUrhkInp("sol.solId|"+CUST.DD.initsolid)
			sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			IF(sv_u !=0)THEN
			#{
   				CUST.DD.errMsg="same solid"
				print(CUST.DD.errMsg)
				#sv_t = "Msg| " +CUST.DD.errMsg
				#sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				#sv_u = urhk_SetOrbOut(sv_t)
   				#GOTO ENDSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
   			CUST.DD.errMsg="PostUserID belongs to a different sol from issuing sol"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF

		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranId|" + CUST.DD.tranid)
		sv_u = urhk_SetUrhkInp("ddMassIssHdr.tranDate|" + BANCS.STDIN.BODDate)

		sv_u = urhk_ExecSrv("SRV_FetchDDMassIssDtlForPost|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_SetUrhkInp("ddMassIssDtl.ddMassIssHdr.tranId|" + CUST.DD.tranid)
			sv_u = urhk_SetUrhkInp("ddMassIssDtl.ddMassIssHdr.tranDate|" + BANCS.STDIN.BODDate)

			sv_u = urhk_ExecSrv("SRV_CreateTranForDDMassIss|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN 
			#{	
				sv_u = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranDate|"+ BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranId|" + CUST.DD.tranid)

				sv_u = urhk_ExecSrv("SRV_PostAnEnteredTransaction|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF(sv_u==0)THEN
				#{
   					CUST.DD.Msg="Demand Draft Posted successfully with transaction ID : " + CUST.DD.TranID
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
					sv_t = "TranID| " +CUST.DD.TranID
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "Msg| " +CUST.DD.Msg
					sv_u = urhk_SetOrbOut(sv_t)

					sv_u = urhk_SetUrhkInp("sol.solId|000")
					sv_u = urhk_ExecSrv("SRV_ModifyContextSol")

   					GOTO ENDSCRIPT
				#}
				ELSE
				#{
					GOTO ERRORCHECK
				#}
				ENDIF
			#}
			ELSE
			#{
				GOTO ERRORCHECK
			#}
			ENDIF	
		#}
		ELSE
		#{
			GOTO ERRORCHECK
		#}
		ENDIF
	#}
	ENDIF

	ERRORCHECK:		

	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
