	IF( (FIELDEXISTS(("BANCS").("INPUT").("DDacctCrncy"))== 1) ) THEN
	#{
		CUST.DD.DDacctCrncy= BANCS.INPUT.DDacctCrncy
		PRINT(CUST.DD.DDacctCrncy)
	#}
	ELSE
	#{
		CUST.DD.DDacctCrncy=""
		PRINT(CUST.DD.DDacctCrncy)
