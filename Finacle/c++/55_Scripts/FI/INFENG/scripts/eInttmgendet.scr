#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : urhk_SRV_GetVal
#  Menu Option     : HINTTM
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             01-04-2021      Edwin Zico           Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="4f9b1b4970ff9c8e712a12fd23de1224185e4d4462d2bb24f38793465378ff79"
TRACE ON
sv_l = urhk_B2k_printrepos("BANCS")
print(sv_l)
#------------------------------------------------------------------------------
# Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
        CREATECLASS("CUST","DATA",5)
#}
ENDIF

#-------------------------------------------------------------------------------------------------------
# Get the number of accounts entered from HINTTM menu option
#-------------------------------------------------------------------------------------------------------
sv_u = urhk_SRV_GetVal("IntTblCrit.entityId.entityDispId")
print(sv_u)
CUST.DATA.Acct = BANCS.OUTPARAM.srvValue
print(CUST.DATA.Acct)
sv_u = urhk_SRV_GetVal("IntTblCrit.crncyCode.crncyCode")
print(sv_u)
CUST.DATA.CrncyCode = BANCS.OUTPARAM.srvValue
print(CUST.DATA.CrncyCode)

sv_b = urhk_getAcctDetailsInRepository(CUST.DATA.Acct)
if(sv_b == 0) then
	CUST.DATA.schmType = BANCS.OUTPARAM.schmType
	print(CUST.DATA.schmType)
else
	CUST.DATA.schmType = ""
endif

if(CUST.DATA.schmType !="CAA")then
	goto end
endif

sv_u = urhk_SRV_NumOfRecs("IntTblDtlLL")
PRINT(sv_u)
if(sv_u != 0)then
#{
	goto end
#}
endif
sv_j = cint(BANCS.OUTPARAM.srvValue)
print(sv_j)
sv_b = 0
while(sv_b < sv_j)
#{
	sv_u = urhk_SRV_GetVal("IntTblDtlLL.<rec_" + FORMAT$(sv_b, "%d") + ">.intTblCode.tblCode")
	print(sv_u)
	CUST.DATA.IntCode = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.IntCode)
	sv_u = urhk_SRV_GetVal("IntTblDtlLL.<rec_" + FORMAT$(sv_b, "%d") + ">.intTblCode.tblCodeDesc")
	print(sv_u)
	CUST.DATA.IntDesc = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.IntDesc)
	sv_u = urhk_SRV_GetVal("IntTblDtlLL.<rec_" + FORMAT$(sv_b, "%d") + ">.maxIntCr")
        print(sv_u)
        CUST.DATA.maxIntCr = Mid$(BANCS.OUTPARAM.srvValue,0,5) 
        print(CUST.DATA.maxIntCr)
	sv_u = urhk_SRV_GetVal("IntTblDtlLL.<rec_" + FORMAT$(sv_b, "%d") + ">.startDate")
	print(sv_u)
	CUST.DATA.IntStartDate = Mid$(BANCS.OUTPARAM.srvValue,0,10) 
	print(CUST.DATA.IntStartDate)
	sv_u = urhk_SRV_GetVal("IntTblDtlLL.<rec_" + FORMAT$(sv_b, "%d") + ">.lastChngDate")
	print(sv_u)
	CUST.DATA.IntLastDate = Mid$(BANCS.OUTPARAM.srvValue,0,10) 
	print(CUST.DATA.IntStartDate)
	
	sv_s = "minimumAmt|select begin_slab_amt from (select * from tbaadm.ivs where int_tbl_code in (select INT_TBL_CODE from tbaadm.itc where"
	sv_s = sv_s + " entity_id in (select acid from tbaadm.gam where foracid=?SVAR) and INT_TBL_CODE_SRL_NUM in (select max(INT_TBL_CODE_SRL_NUM)"
	sv_s = sv_s + " from tbaadm.itc where entity_id in (select acid from tbaadm.gam where foracid=?SVAR) and entity_cre_flg='Y' and del_flg='N'))"
	sv_s = sv_s + " and NRML_INT_PCNT<>0 and entity_cre_flg='Y' and del_flg='N' and bank_id =?SVAR and CRNCY_CODE=?SVAR"
	sv_s = sv_s + " order by INT_TBL_VER_NUM desc ) where rownum <2"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.Acct + "|" + CUST.DATA.Acct + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.CrncyCode 
	print(BANCS.INPARAM.BINDVARS)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	if(sv_d == 0)then
		CUST.DATA.minimumAmt = BANCS.OUTPARAM.minimumAmt
		print(CUST.DATA.minimumAmt)
	else
		CUST.DATA.minimumAmt ="0"
	endif

	print(sv_b)
	sv_b = sv_b + 1
#}
do
print(CUST.DATA.Acct)
print(CUST.DATA.CrncyCode)
print(CUST.DATA.IntCode)
print(CUST.DATA.IntDesc)
print(CUST.DATA.IntStartDate)
print(CUST.DATA.IntStartDate)
print(CUST.DATA.minimumAmt)
#CUST.DATA.toAddr ="edwin.mureithi@equitybank.co.ke,john.wamai@equitybank.co.ke,paul.githinji@equitybank.co.ke,kelvin.makau@equitybank.co.ke,samuel.mbogori@equitybank.co.ke,jane.ndirangu@equitybank.co.ke"
CUST.DATA.toAddr ="paul.githinji@equitybank.co.ke,miringu.nganga@equitybank.co.ke,isaac.mwaurah@equitybank.co.ke"
#CUST.DATA.toAddr ="edwin.mureithi@equitybank.co.ke"
sv_u = urhk_getFileLocation("COM|eInttmgendet.com")
if(sv_u ==0)then
	print(BANCS.OUTPARAM.fileLocation)
	CUST.DATA.comfil = BANCS.OUTPARAM.fileLocation + "eInttmgendet.com"
	CUST.DATA.comfil = CUST.DATA.comfil + " " + CUST.DATA.toAddr + " " + CUST.DATA.Acct + " " + CUST.DATA.CrncyCode + " " + CUST.DATA.IntStartDate + " " + CUST.DATA.IntLastDate + " " + BANCS.STDIN.userId + " " + CUST.DATA.maxIntCr + " " + CUST.DATA.minimumAmt + " " + CUST.DATA.IntCode + " " + CUST.DATA.IntDesc 
else
	CUST.DATA.comfil   = ""
endif
print(CUST.DATA.comfil)
if(CUST.DATA.comfil != "")then
	sv_u = system(CUST.DATA.comfil)
	if(sv_u ==0)then
		print("smtp success")
	else
		print("failed smtp")
	endif
endif

end:
TRACE OFF
EXITSCRIPT
END-->


