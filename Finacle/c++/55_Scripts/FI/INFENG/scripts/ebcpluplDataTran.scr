<--start
	trace on
	print(CUST.GLBDATA.pfNumber)
	print(CUST.GLBDATA.eqDrAcctNum)
	print(CUST.GLBDATA.eqCrAcctNum)
	print(CUST.GLBDATA.beneficaryName)
	print(CUST.GLBDATA.benfBankCode)
	print(CUST.GLBDATA.benfBranchCode)
	print(CUST.GLBDATA.benfAcctNum)
	print(CUST.GLBDATA.tranAmt)
	print(CUST.GLBDATA.chrgAmt)
	print(CUST.GLBDATA.tranParticulars)
	print(CUST.GLBDATA.TranYN)
	print(CUST.GLBDATA.fileName)
  	print(CUST.GLBDATA.batchId)
	CUST.GLBDATA.CurrencyCode 	=	BANCS.STDIN.homeCrncyCode
	sv_u = urhk_getAcctDetailsInRepository(CUST.GLBDATA.eqDrAcctNum)
	print(sv_u)
	if(sv_u == 0)then
		CUST.GLBDATA.dracctSolId  = BANCS.OUTPARAM.acctSolId
		CUST.GLBDATA.dracctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		CUST.GLBDATA.drschmType = BANCS.OUTPARAM.schmType
		CUST.GLBDATA.drschmCode = BANCS.OUTPARAM.schmCode
		CUST.GLBDATA.drglSubHeadCode = BANCS.OUTPARAM.glSubHeadCode
		CUST.GLBDATA.dracctOwner = BANCS.OUTPARAM.acctOwnerShip
		print(CUST.GLBDATA.dracctSolId)
		print(CUST.GLBDATA.dracctCrncyCode)
		print(CUST.GLBDATA.drschmType)
		print(CUST.GLBDATA.drschmCode)
		print(CUST.GLBDATA.drglSubHeadCode)
		print(CUST.GLBDATA.dracctOwner)
	else
		sv_v = "N"
		sv_c = sv_c + 1
		CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "~" + "Debit Account number is Invalid"
		GOTO ENDOFSCRIPT
	endif
	sv_u = urhk_getAcctDetailsInRepository(CUST.GLBDATA.eqCrAcctNum)
	print(sv_u)
	if(sv_u == 0)then
		CUST.GLBDATA.cracctSolId  = BANCS.OUTPARAM.acctSolId
		CUST.GLBDATA.cracctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		CUST.GLBDATA.crschmType = BANCS.OUTPARAM.schmType
		CUST.GLBDATA.crschmCode = BANCS.OUTPARAM.schmCode
		CUST.GLBDATA.crglSubHeadCode = BANCS.OUTPARAM.glSubHeadCode
		CUST.GLBDATA.cracctOwner = BANCS.OUTPARAM.acctOwnerShip
		print(CUST.GLBDATA.cracctSolId)
		print(CUST.GLBDATA.cracctCrncyCode)
		print(CUST.GLBDATA.crschmType)
		print(CUST.GLBDATA.crschmCode)
		print(CUST.GLBDATA.crglSubHeadCode)
		print(CUST.GLBDATA.cracctOwner)
	else
		sv_v = "N"
		sv_c = sv_c + 1
		CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "~" + "Credit Account number is Invalid"
		GOTO ENDOFSCRIPT
	endif
	IF (CUST.GLBDATA.Function=="U")  THEN
	#{
		sv_e = MID$(BANCS.STDIN.BODDate,0,10)
		print(sv_e)
		sv_s = "sysdate "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT TO_CHAR((TO_DATE('" + sv_e + "','DD-MM-YYYY')),'DD-MON-YYYY') "
		sv_s = sv_s + " FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
		#{
			CUST.GLBDATA.sysdate = BANCS.OUTPARAM.sysdate
			print(CUST.GLBDATA.sysdate)
		#}
		ENDIF
		#+++++++++31-08-2020
		sv_d = "pesaBankCnt|select count(bank_code) from custom.pesalink_bank "
		sv_d = sv_d + " where bank_id=?SVAR and del_flg='N' "
		sv_d = sv_d + " and bank_code=?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.GLBDATA.benfBankCode 
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.GLBDATA.pesaCnt = BANCS.OUTPARAM.pesaBankCnt
		else
			CUST.GLBDATA.pesaCnt = 0
		endif
		#++
		CUST.GLBDATA.uplRefNum = CUST.GLBDATA.batchId 
		CUST.GLBDATA.uplFileName = CUST.GLBDATA.fileName 
		sv_s = "Insert into CUSTOM.PLMT (bank_id,"
		sv_s = sv_s + " pf_number,dr_acct_num,"
		sv_s = sv_s + " cr_acct_num,beneficary_name,"
		sv_s = sv_s + " benef_bank_code,benef_branch_code,"
		sv_s = sv_s + " benef_account_num,tran_amt,tran_remarks,"
		sv_s = sv_s + " upl_sol_id,upl_ref_num,upl_fil_name,"
		sv_s = sv_s + " rcre_user_id,rcre_time,lchg_user_id,lchg_time,"
		sv_s = sv_s + " core_tran_id,core_tran_date,"
		sv_s = sv_s + " process_staus,process_msg,"
		sv_s = sv_s + " api_yn,free_text1,free_text2,"
		sv_s = sv_s + " free_text3,free_text4,free_text5) "
		sv_s = sv_s + " values (?SVAR,"
		sv_s = sv_s + " ?SVAR,?SVAR,"
		sv_s = sv_s + " ?SVAR,?SVAR,"
		sv_s = sv_s + " ?SVAR,?SVAR,"
		sv_s = sv_s + " ?SVAR,?NVAR,?SVAR,"
		sv_s = sv_s + " ?SVAR,?SVAR,?SVAR,"
		if(cdouble(CUST.GLBDATA.pesaCnt)>=1)then
		sv_s = sv_s + " ?SVAR,sysdate,?SVAR,sysdate,null,null,'U',null,null,"
		endif
		if(cdouble(CUST.GLBDATA.pesaCnt)<=0)then
		sv_s = sv_s + " ?SVAR,sysdate,?SVAR,sysdate,null,null,'EFT',null,'E',"
		endif
		sv_s = sv_s + " ?SVAR,null,custom.plupl_num_seq.nextval,?SVAR,null) "
		CUST.GLBDATA.tranAmt = cdouble(CUST.GLBDATA.tranAmt)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.GLBDATA.pfNumber + "|" + CUST.GLBDATA.eqDrAcctNum + "|" + CUST.GLBDATA.eqCrAcctNum + "|" + trim(CUST.GLBDATA.beneficaryName) + "|" + CUST.GLBDATA.benfBankCode + "|" + CUST.GLBDATA.benfBranchCode + "|" + trim(CUST.GLBDATA.benfAcctNum) + "|" + CUST.GLBDATA.tranAmt + "|" + trim(CUST.GLBDATA.tranParticulars) + "|" + BANCS.STDIN.mySolId + "|" + CUST.GLBDATA.uplRefNum + "|" + CUST.GLBDATA.uplFileName + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + CUST.GLBDATA.TranYN + "|" + CUST.GLBDATA.chrgAmt 
		print(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_d = urhk_dbsqlWithBind(sv_s)
		IF (sv_d != 0)  THEN
		#{
			sv_v = "N"
			sv_c = sv_c + 1
			CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "~" + "Error in Adding Details"
			GOTO ENDOFSCRIPT
		ELSE
			sv_d = urhk_dbSqlWithBind("commit")
			print(sv_d)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
