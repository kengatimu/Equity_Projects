		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		print(sv_j)
		sv_c=sv_c+1
		 #}
		 DO
		 sv_x = urhk_dbCursorClose(sv_m)
        print(sv_x)
#}
ENDIF
if(sv_r=="1")then
