        IF(sv_q != 0) THEN
        #{
                sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        #}
        ENDIF
		sv_s=0
		sv_c =1
WHILE(sv_q == 0)
#{
        sv_j = sv_c 
