	sv_k = " CRNCY_CODE, CRNCY_NAME |SELECT  CRNCY_CODE, CRNCY_NAME FROM TBAADM.TBA_CNTRY_CRNCY_CODE_TBL WHERE BANK_ID =?SVAR AND ENTITY_CRE_FLG='Y' AND DEL_FLG ='N' "

     PRINT(sv_k)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
        PRINT(BANCS.INPARAM.BINDVARS)

sv_r = urhk_dbCursorOpenWithBind(sv_k)
print(sv_r)

IF(sv_r==0) THEN
#{
        sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_m)
        sv_q = urhk_dbCursorFetch(sv_m)
