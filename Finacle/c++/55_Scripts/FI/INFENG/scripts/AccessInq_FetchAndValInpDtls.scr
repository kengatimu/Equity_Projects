#----------------------------------------------------------------------------------------------------------
# Filename              :       AccessInq_FetchAndValInpDtls.scr
# Author                :       Swati Ganjoo
# Description           :       This script validates the input provided in the request xml
# Input                 :       UserID,EmployeeID,AccessCode,MenuId
# Output                :       None
# Called Script         :       None
# Calling Script        :       AccessInq_main.scr                                                            
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Swati Ganjoo      Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
TRACE ON
	# Script body goes here
	#========================================================	
	# Checking if the Inputs are provided in Resquest
	#========================================================
	#-----Validation in case no input is provided in resquest-----
	sv_v="AccessInq_REQ.AccessCode"
	sv_w="AccessInq_REQ.MenuID"
	sv_y="AccessInq_REQ.UserID"
	sv_z="AccessInq_REQ.EmployeeID"
	
	CUST.INTERFACE.hmeEntityId=BANCS.STDIN.contextBankId
	PRINT(CUST.INTERFACE.hmeEntityId)
	IF((FIELDEXISTS(("BANCS").("INPUT").(sv_v))== "0") AND (FIELDEXISTS(("BANCS").("INPUT").(sv_w))== "0") AND(FIELDEXISTS(("BANCS").("INPUT").(sv_y))== "0") AND (FIELDEXISTS(("BANCS").("INPUT").(sv_z))=="0")) THEN
	#{
		print("No Input details received")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR008"
		GOTO ERROREXIT
	#}	
	ENDIF
	#---Checking if the User Id exists or not-------
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_y))== 0)THEN
	#{
		print("Enter UserID")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR006"
		GOTO ERROREXIT
	#}
	ELSE
	#{
		CUST.INTERFACE.usrId=("BANCS").("INPUT").(sv_y)
	#}	
	ENDIF
	
	#---Checking if the employee ID exists or not-------
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_z))== "0")THEN
	#{
		CUST.INTERFACE.usrEmpId=""
	#}
	ELSE
	#{
		CUST.INTERFACE.usrEmpId=("BANCS").("INPUT").(sv_z)
		print(CUST.INTERFACE.usrEmpId)
	#}
	ENDIF
	#------Throw ERROREXIT if Access code and MenuId both are entered as part of input-- 
	IF((FIELDEXISTS(("BANCS").("INPUT").(sv_v))== "1") AND ((FIELDEXISTS(("BANCS").("INPUT").(sv_w))== "1")))THEN
	#{
		print("Enter Either AccessCode or MenuId")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR007"
		GOTO ERROREXIT
	#}	
	ENDIF
	#------Throw ERROREXIT if Access code and MenuId both are not entered as part of input-- 
	IF((FIELDEXISTS(("BANCS").("INPUT").(sv_v))== "0") AND ((FIELDEXISTS(("BANCS").("INPUT").(sv_w))== "0")))THEN
	#{
		print("Enter Either AccessCode or MenuId")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR007"
		GOTO ERROREXIT
	#}	
	ENDIF
	#---Checking if the AccessCode exists or not----
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_v))== "0")THEN
	#{
		print("Enter AccessCode")
		CUST.INTERFACE.userAccAllwd=""
		CUST.INTERFACE.accessCode=""
	#}
	ELSE
	#{
		CUST.INTERFACE.userAccAllwd="N"
		CUST.INTERFACE.accessCode=("BANCS").("INPUT").(sv_v)
		print(CUST.INTERFACE.accessCode)
	#}
	ENDIF
	
	#---Checking if the MenuId exists or not-------
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_w))== "0")THEN
	#{
		print("Enter Menu Id")
		CUST.INTERFACE.bwRange=""
		CUST.INTERFACE.mopId=""
	#}
	ELSE
	#{
		CUST.INTERFACE.bwRange="N"
		CUST.INTERFACE.mopId=("BANCS").("INPUT").(sv_w)
		print(CUST.INTERFACE.mopId)
	#}
	ENDIF
	
	#========================================================	
	# Fetching Bank id for Bio requests
	#========================================================
	
	sv_a = urhk_GetChannelInfo("")
	PRINT(sv_a)
	IF(sv_a == 0)THEN
	#{
		CUST.INTERFACE.dcc=BANCS.OUTPARAM.DccId
		 PRINT(CUST.INTERFACE.dcc)
		 	IF(CUST.INTERFACE.dcc=="BIO")THEN
	#{
		BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|Y|N"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "hmeEntityId|"
		sv_s = sv_s + " SELECT home_bank_id"
		sv_s = sv_s + " FROM TBAADM.UPR"
		sv_s = sv_s + " WHERE USER_ID =?SVAR"
		sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.INTERFACE.hmeEntityId = BANCS.OUTPARAM.hmeEntityId
			print(CUST.INTERFACE.hmeEntityId)			
		#}
		ENDIF
	#}
	ENDIF
	#}
	ENDIF

	#========================================================	
	# Validating User Id 
	# Note-This validation would occour if user enters UserId only.
	#========================================================
	IF(CUST.INTERFACE.usrEmpId=="")THEN
	#{
		BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|Y|N"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "valUserId|"
		sv_s = sv_s + " SELECT count(1)"
		sv_s = sv_s + " FROM TBAADM.UPR"
		sv_s = sv_s + " WHERE USER_ID =?SVAR"
		sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.INTERFACE.valUserId = BANCS.OUTPARAM.valUserId
			print(CUST.INTERFACE.valUserId)
			IF(CUST.INTERFACE.valUserId=="0")THEN
			#{
				print("Enter a valid UserID")
				CUST.INTERFACE.successOrFailure="F"
				CUST.INTERFACE.errorCode="ERR009"
				GOTO ERROREXIT
			#}
			ENDIF
		#}
		ELSE
		#{
			print("Enter a valid UserID")
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.errorCode="ERR009"
			GOTO ERROREXIT
		#}
		ENDIF
		#========================================================
		# Fetching Employee Id
		#========================================================
		BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|Y|N"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "usrEmpId|"
		sv_s = sv_s + " SELECT USER_EMP_ID"
		sv_s = sv_s + " FROM TBAADM.UPR"
		sv_s = sv_s + " WHERE USER_ID =?SVAR"
		sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.INTERFACE.usrEmpId = BANCS.OUTPARAM.usrEmpId
			print(CUST.INTERFACE.usrEmpId)
		#}
		ELSE
		#{
			print("ERROREXIT in fetching Employee Id")
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.errorCode="ERR010"
			GOTO ERROREXIT
		#}
		ENDIF
	#}	
	ENDIF
	#========================================================	
	# Validating User Id AND Employee Id
	# Note-This validation would occour if user enters UserId 
	#      as well as Employee Id
	#========================================================
	IF(((FIELDEXISTS(("BANCS").("INPUT").(sv_y))== "1"))AND ((FIELDEXISTS(("BANCS").("INPUT").(sv_z))== "1")))THEN
	#{
		BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|Y|N"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "valUserId|"
		sv_s = sv_s + " SELECT count(1)"
		sv_s = sv_s + " FROM TBAADM.UPR"
		sv_s = sv_s + " WHERE USER_ID =?SVAR"
		sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.INTERFACE.valUserId = BANCS.OUTPARAM.valUserId
			print(CUST.INTERFACE.valUserId)
			IF(CUST.INTERFACE.valUserId=="0")THEN
			#{
				print("Enter a valid UserID")
				CUST.INTERFACE.successOrFailure="F"
				CUST.INTERFACE.errorCode="ERR009"
				GOTO ERROREXIT
			#}
			ENDIF
			
		#}
		ELSE
		#{
			print("Enter a valid UserID")
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.errorCode="ERR009"
			GOTO ERROREXIT
			
		#}
		ENDIF
		
		BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|"+CUST.INTERFACE.usrEmpId+"|Y|N"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "valUserEmpId|"
		sv_s = sv_s + " SELECT COUNT(2)"
		sv_s = sv_s + " FROM TBAADM.UPR"
		sv_s = sv_s + " WHERE USER_ID =?SVAR"
		sv_s = sv_s + " AND USER_EMP_ID =?SVAR"
		sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.INTERFACE.valUserEmpId = BANCS.OUTPARAM.valUserEmpId
			print(CUST.INTERFACE.valUserEmpId)
			IF(CUST.INTERFACE.valUserEmpId=="0")THEN
			#{
				CUST.INTERFACE.successOrFailure="F"
				CUST.INTERFACE.errorCode="ERR011"
				GOTO ERROREXIT
			#}
			ENDIF
		#}
		ELSE
		#{
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.errorCode="ERR011"
			print("Enter a valid EmployeeID")
			GOTO ERROREXIT
		#}
		ENDIF
	#}
	ENDIF
	#========================================================	
	# Validating the User Access Codes
	#========================================================
	IF(CUST.INTERFACE.accessCode!="")THEN
	#{
		#========================================================	
		# Validating the User Access Codes from Userhook
		#========================================================
		sv_u = "25|" +CUST.INTERFACE.accessCode
		sv_u = urhk_B2k_valRefCode(sv_u)
		IF(sv_u!=0)THEN
		#{
			print("Enter a valid AccessCode")
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.errorCode="ERR012"
			GOTO ERROREXIT
		#}
		ENDIF
			
		#========================================================	
		# Calling comtum script to validate Access code from UAC table
		#========================================================
		CALL("AccessInq_ValAcctAccess.scr")
	#}
	ELSE
	#{
		CUST.INTERFACE.userAccAllwd=""
	#}
	ENDIF
	#========================================================	
	# Validating the Menu Id Codes from MOD table
	#========================================================
	IF(CUST.INTERFACE.mopId!="")THEN
	#{
		#========================================================	
		# Calling the below scr for validating MENUID from MOD table
		#========================================================
		CALL("AccessInq_ValMenuID.scr")
		
		
	#}
	ENDIF
end-->
