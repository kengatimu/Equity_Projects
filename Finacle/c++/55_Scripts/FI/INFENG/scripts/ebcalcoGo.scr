                EBSRV.GLBDATA.HighLim6 = "0"
                EBSRV.GLBDATA.LowLimR6 = "0"
                EBSRV.GLBDATA.HighLimR6 = "0"
        endif
	if((EBSRV.GLBDATA.funcCode == "R") OR (EBSRV.GLBDATA.funcCode == "M") OR (EBSRV.GLBDATA.funcCode == "X")) then
		if(BANCS.STDIN.userWorkClass!=152)then
			EBSRV.GLBDATA.errMsg = "User WorkClass Not Allowed for Register,Modify or Cancel"
			GOTO ERROR
		endif
	endif
	if(EBSRV.GLBDATA.funcCode == "V")then
		if(BANCS.STDIN.userWorkClass!=260)then
			EBSRV.GLBDATA.errMsg = "User WorkClass Not Allowed for Verify & Cancel"
			GOTO ERROR
		endif
	endif
	sv_d = "ModRecCnt | select count(*) from custom.alco_rate_mod_tbl "
	sv_d = sv_d + " where bank_id=?SVAR "
	sv_d = sv_d + " and currency_code=?SVAR "
	sv_d = sv_d + " and applicable_date=to_date(?SVAR,'DD-MM-RR') "
	sv_d = sv_d + " and deposit_type=?SVAR "
	sv_d = sv_d + " and deposit_period_mnths=?SVAR "
	#sv_d = sv_d + " and lower_lim=?SVAR "
	#sv_d = sv_d + " and higher_lim=?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.ModRecCnt = BANCS.OUTPARAM.ModRecCnt
	else
		EBSRV.GLBDATA.ModRecCnt = 0
	endif
        sv_d = "UnvRecCnt | select count(*) from custom.armt "
        sv_d = sv_d + " where bank_id=?SVAR "
        sv_d = sv_d + " and currency_code=?SVAR "
        sv_d = sv_d + " and applicable_date=to_date(?SVAR,'DD-MM-RR') "
        sv_d = sv_d + " and deposit_type=?SVAR "
        sv_d = sv_d + " and deposit_period_mnths=?SVAR "
        sv_d = sv_d + " and del_flg <> 'Y' " 
        sv_d = sv_d + " and entity_cre_flg = 'N' " 
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        #BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        print(BANCS.INPARAM.BINDVARS)
        print(sv_d)
        sv_u = urhk_dbSelectWithBind(sv_d)
        if(sv_u==0)then
                EBSRV.GLBDATA.UnvRecCnt = BANCS.OUTPARAM.UnvRecCnt
        else
                EBSRV.GLBDATA.UnvRecCnt = 0
        endif
        sv_d = "DupRecCnt | select count(*) from custom.armt "
        sv_d = sv_d + " where bank_id=?SVAR "
        sv_d = sv_d + " and currency_code=?SVAR "
        sv_d = sv_d + " and applicable_date=to_date(?SVAR,'DD-MM-RR') "
        sv_d = sv_d + " and deposit_type=?SVAR "
        sv_d = sv_d + " and deposit_period_mnths=?SVAR "
        sv_d = sv_d + " and del_flg <> 'Y' "
        sv_d = sv_d + " and entity_cre_flg in('Y','N') "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        print(BANCS.INPARAM.BINDVARS)
        print(sv_d)
        sv_u = urhk_dbSelectWithBind(sv_d)
        if(sv_u==0)then
                EBSRV.GLBDATA.DupRecCnt = BANCS.OUTPARAM.DupRecCnt
        else
                EBSRV.GLBDATA.DupRecCnt = 0
        endif


        if((EBSRV.GLBDATA.funcCode == "R") OR (EBSRV.GLBDATA.funcCode == "M")) then
                if(EBSRV.GLBDATA.ModRecCnt != 0) then
                        EBSRV.GLBDATA.errMsg = "Unverified Record Exist for currency " + EBSRV.GLBDATA.CrncyCode 
                        GOTO ERROR
                endif
                if(EBSRV.GLBDATA.UnvRecCnt != 0) then
                        EBSRV.GLBDATA.errMsg = "Unverified Record Exist for currency " + EBSRV.GLBDATA.CrncyCode 
                        GOTO ERROR
                endif
        endif
        if((EBSRV.GLBDATA.funcCode == "V") OR (EBSRV.GLBDATA.funcCode == "X")) then
		print(EBSRV.GLBDATA.ModRecCnt)
		print(EBSRV.GLBDATA.UnvRecCnt)
                if((EBSRV.GLBDATA.ModRecCnt  == "0" ) and (EBSRV.GLBDATA.UnvRecCnt == "0") ) then
                        if(EBSRV.GLBDATA.funcCode == "V") then
                                EBSRV.GLBDATA.errMsg = "Nothing to Verify"
                        else
                                EBSRV.GLBDATA.errMsg = "Nothing to Cancel"
                        endif
                        GOTO ERROR
                endif
        endif
        if(EBSRV.GLBDATA.funcCode == "R") then
                if(EBSRV.GLBDATA.DupRecCnt != "0") then
                        EBSRV.GLBDATA.errMsg = "Record Already Exist with Entered Currency and Date!!!"
                        GOTO ERROR
                endif
        endif
        if((EBSRV.GLBDATA.funcCode != "R") and (EBSRV.GLBDATA.funcCode != "X")) then
                if ( EBSRV.GLBDATA.DupRecCnt == "0" ) then
                        EBSRV.GLBDATA.errMsg = "No Record Exist with Entered Currency and Date"
                        GOTO ERROR
                endif
        endif
	if((EBSRV.GLBDATA.funcCode == "V") OR (EBSRV.GLBDATA.funcCode == "X")) then
		callscriptifexist("ebcalcodp001.scr")
		GOTO ERROR
	endif
	if((EBSRV.GLBDATA.funcCode == "I") OR (EBSRV.GLBDATA.funcCode == "M")) then
		callscriptifexist("ebcalcodp002.scr")
		GOTO ERROR
	endif
