<--start
trace on
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	callscriptifexist("ebRepClass.scr")
	EBSRV.GLBDATA.errMsg = ""
	EBSRV.GLBDATA.resMsg = ""
	EBSRV.GLBDATA.ModRecCnt = 0
	EBSRV.GLBDATA.RecCnt = 0
	EBSRV.GLBDATA.UnvRecCnt = 0
	EBSRV.GLBDATA.DupRecCnt = 0
	EBSRV.GLBDATA.ModUnvRecCnt = 0
	EBSRV.GLBDATA.UnvRecCnt = 0
	EBSRV.GLBDATA.RecCnt = 0

	EBSRV.GLBDATA.RecVerifyType = ""
	EBSRV.GLBDATA.RecType = ""

	EBSRV.GLBDATA.funcCode = BANCS.INPUT.funcCode
	print(EBSRV.GLBDATA.funcCode)
	EBSRV.GLBDATA.CrncyCode = BANCS.INPUT.CrncyCode
	print(EBSRV.GLBDATA.CrncyCode)
	EBSRV.GLBDATA.AplliDate = BANCS.INPUT.AplliDate
	print(EBSRV.GLBDATA.AplliDate)
	EBSRV.GLBDATA.depPerdMths = BANCS.INPUT.depPerdMths
	print(EBSRV.GLBDATA.depPerdMths)
	EBSRV.GLBDATA.depPerdDays = BANCS.INPUT.depPerdDays
	print(EBSRV.GLBDATA.depPerdDays)

	if(EBSRV.GLBDATA.CrncyCode=="KES")then
		EBSRV.GLBDATA.LowLim1 = "50000"
		EBSRV.GLBDATA.HighLim1 = "999999"
		EBSRV.GLBDATA.LowLimR1 = ""
		EBSRV.GLBDATA.HighLimR1 = ""
		EBSRV.GLBDATA.LowLim2 = "1000000"
		EBSRV.GLBDATA.HighLim2 = "9999999"
		EBSRV.GLBDATA.LowLimR2 = ""
		EBSRV.GLBDATA.HighLimR2 = ""
		EBSRV.GLBDATA.LowLim3 = "10000000"
		EBSRV.GLBDATA.HighLim3 = "49999999"
		EBSRV.GLBDATA.LowLimR3 = ""
		EBSRV.GLBDATA.HighLimR3 = ""
		EBSRV.GLBDATA.LowLim4 = "50000000"
		EBSRV.GLBDATA.HighLim4 = "99999999"
		EBSRV.GLBDATA.LowLimR4 = ""
		EBSRV.GLBDATA.HighLimR4 = ""
		EBSRV.GLBDATA.LowLim5 = "100000000"
		EBSRV.GLBDATA.HighLim5 = "249999999"
		EBSRV.GLBDATA.LowLimR5 = ""
		EBSRV.GLBDATA.HighLimR5 = ""
		EBSRV.GLBDATA.LowLim6 = "250000000"
		EBSRV.GLBDATA.HighLim6 = "499999999"
		EBSRV.GLBDATA.LowLimR6 = ""
		EBSRV.GLBDATA.HighLimR6 = ""
	endif
        if(EBSRV.GLBDATA.CrncyCode=="USD")then
                EBSRV.GLBDATA.LowLim1 = "5000"
                EBSRV.GLBDATA.HighLim1 = "9999"
                EBSRV.GLBDATA.LowLimR1 = ""
                EBSRV.GLBDATA.HighLimR1 = ""
                EBSRV.GLBDATA.LowLim2 = "10000"
                EBSRV.GLBDATA.HighLim2 = "49999"
                EBSRV.GLBDATA.LowLimR2 = ""
                EBSRV.GLBDATA.HighLimR2 = ""
                EBSRV.GLBDATA.LowLim3 = "50000"
                EBSRV.GLBDATA.HighLim3 = "99999"
                EBSRV.GLBDATA.LowLimR3 = ""
                EBSRV.GLBDATA.HighLimR3 = ""
                EBSRV.GLBDATA.LowLim4 = "100000"
                EBSRV.GLBDATA.HighLim4 = "500000"
                EBSRV.GLBDATA.LowLimR4 = ""
                EBSRV.GLBDATA.HighLimR4 = ""
                EBSRV.GLBDATA.LowLim5 = "1000000"
                EBSRV.GLBDATA.HighLim5 = "above"
                EBSRV.GLBDATA.LowLimR5 = ""
