<--START
CHECKSUM="12bc5eba98f2095abab1281d4352ba23d3dfd39f92cf51e1d8f4c66717c80772"
TRACE ON

        #------------------------------------------------------------------------------
        #Creating repository and class
        #------------------------------------------------------------------------------
        sv_r = REPEXISTS("CUSTS")
        IF (sv_r == 0) THEN
        #{
                CREATEREP("CUSTS")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
        IF (sv_r == 0) THEN
        #{
                CREATECLASS("CUSTS", "GLBDATA", 5)
        #}
        ENDIF
        sv_a=urhk_B2k_PrintRepos("BANCS")
        print(sv_a)
	sv_o = urhk_GetChannelInfo("")
	print(sv_o)
	if(FIELDEXISTS(BANCS.OUTPARAM.DccId))then
		print(BANCS.OUTPARAM.DccId)
		if (BANCS.OUTPARAM.DccId != "")then
			CUSTS.GLBDATA.DccId = BANCS.OUTPARAM.DccId
		else
			CUSTS.GLBDATA.DccId = ""
		endif
	else
			CUSTS.GLBDATA.DccId = ""
	endif
	if(CUSTS.GLBDATA.DccId=="CRS")then
		sv_u = urhk_SRV_GetVal("dfltODAcctDtl.acctCommonInfo.acctClassMISC.acctOccpCode.refCode")
		CUSTS.GLBDATA.refCode = BANCS.OUTPARAM.srvValue
		print(CUSTS.GLBDATA.refCode)
		#----------------------Assign Default Value
		sv_u = urhk_SRV_SetVal("dfltODAcctDtl.acctCommonInfo.acctClassMISC.acctOccpCode.refCode|OTH")
		print(sv_u)
	endif
TRACE OFF
exitscript
