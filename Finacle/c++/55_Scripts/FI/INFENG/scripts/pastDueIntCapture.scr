						CUST.PINT.flwId = BANCS.OUTPARAM.flwId
						
						IF(CUST.PINT.flwId == "PRDEM")THEN
						#{
							CUST.PINT.prdemAmt = CUST.PINT.adjAmt
							#}
						ELSE
