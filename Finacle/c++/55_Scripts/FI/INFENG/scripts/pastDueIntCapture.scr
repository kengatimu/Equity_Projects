					#{
					CUST.PINT.intSuspAmt = 0
					CUST.PINT.penalIntSuspAmt = 0
				#}
				ENDIF
				
				###################################################################
				# getting interest suspence bacid from AIP for given scheme code
				###################################################################
				
				sv_l = ""
				sv_l = sv_l + "intSuspBacid|SELECT distinct INT_SUSP_BACID FROM TBAADM.AIP "
				sv_l = sv_l + "WHERE b2k_type = 'ACCNT' AND SCHM_CODE = ?SVAR AND BANK_ID = ?SVAR AND INT_SUSP_BACID is not null"
				
				BANCS.INPARAM.BINDVARS = CUST.PINT.schmCode +"|"+ BANCS.STDIN.contextBankId
				
				PRINT(sv_l)
				
				sv_b = urhk_dbSelectWithBind(sv_l)
				
				PRINT(sv_b)
				
				IF(sv_b == 0)THEN
				#{
					PRINT(BANCS.OUTPARAM.intSuspBacid)
					
