					#}
				ELSE
					#{
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				############################################################
				# inserting fetched data into custom table PINTCAPTURE
				###########################################################
				
				BANCS.INPARAM.BINDVARS = CUST.PINT.foracid + "|" + CUST.PINT.schmCode +"|"+ CUST.PINT.ccyCode +"|"+ CUST.PINT.solId
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.PINT.prdemAmt +"|" + CUST.PINT.indemAmt +"|"+ CUST.PINT.pidemAmt
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.PINT.intSuspAmt +"|" + CUST.PINT.penalIntSuspAmt +"|"+ CUST.PINT.drAmt
