				###################################################################
				
				sv_l = ""
				sv_l = sv_l + "suspForacid,suspAcid|SELECT FORACID,ACID FROM TBAADM.GAM "
				sv_l = sv_l + "WHERE BACID = ?SVAR AND SOL_ID = ?SVAR AND acct_CRNCY_CODE = ?SVAR AND BANK_ID = ?SVAR"
				
				BANCS.INPARAM.BINDVARS = CUST.PINT.intSuspBacid +"|"+ CUST.PINT.solId +"|"+ CUST.PINT.ccyCode +"|"+ BANCS.STDIN.contextBankId
				
