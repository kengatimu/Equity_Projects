			IF(CUST.PINT.pdFlg == "Y")THEN
			#{
				
				#############################################################
				# getting values from COT
				###########################################################
				
				sv_l = ""
				sv_l = sv_l + "intSuspAmt,penalIntSuspAmt|SELECT INT_SUSPENSE_AMT, PENAL_INT_SUSPENSE_AMT FROM TBAADM.COT "
				sv_l = sv_l + "WHERE ACID = ?SVAR AND DATE_NON_ACCRUE = ?SVAR AND BANK_ID = ?SVAR "
				
				BANCS.INPARAM.BINDVARS = CUST.PINT.acid+"|"+ CUST.PINT.bodDate +"|"+ BANCS.STDIN.contextBankId
				
				PRINT(sv_l)
				
				sv_b = urhk_dbSelectWithBind(sv_l)
				
				PRINT(sv_b)
				
