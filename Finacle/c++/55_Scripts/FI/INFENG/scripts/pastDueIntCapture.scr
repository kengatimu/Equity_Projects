							#{
							CUST.PINT.indemAmt = 0
						#}
						ENDIF
						
						IF(CUST.PINT.flwId == "PIDEM")THEN
						#{
							CUST.PINT.pidemAmt = CUST.PINT.adjAmt
							#}
						ELSE
							#{
							CUST.PINT.pidemAmt = 0
						#}
						ENDIF
						
						sv_h= urhk_dbCursorFetch(sv_q)
						PRINT(sv_h)
					#}
					DO
					sv_h= urhk_dbCursorClose(sv_q)
					PRINT(sv_h)
					
					IF (sv_x == 0) THEN
					#{
						CUST.PINT.errMsg ="no more records"
						PRINT(CUST.PINT.errMsg)
						
					#}
					ENDIF
					#}
				ELSE
					#{
					
					CUST.PINT.errMsg ="Can't access LDA table for getting the account details"
					PRINT(CUST.PINT.errMsg)
					
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				PRINT(CUST.PINT.pidemAmt)
				PRINT(CUST.PINT.indemAmt)
				PRINT(CUST.PINT.prdemAmt)
				
				############################################################
				# getting drAmt from ACPART
				###########################################################
				
				sv_l = ""
				sv_l = sv_l + "drAmt|SELECT SUM(TRAN_AMT) FROM TBAADM.ACPART "
				sv_l = sv_l + "WHERE PART_TRAN_TYPE = 'D' "
				sv_l = sv_l + "AND PARTITIONED_ACID  = ?SVAR AND BANK_ID = ?SVAR "
				sv_l = sv_l + "AND b2k_type = 'ACCNT' AND b2k_id = ?SVAR AND PSTD_FLG = 'Y' AND TRAN_DATE = ?SVAR"
				
				BANCS.INPARAM.BINDVARS = CUST.PINT.suspAcid +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.PINT.acid +"|"+ CUST.PINT.bodDate
				
				PRINT(sv_l)
				
				sv_b = urhk_dbSelectWithBind(sv_l)
				
				PRINT(sv_b)
				
				IF(sv_b == 0)THEN
				#{
