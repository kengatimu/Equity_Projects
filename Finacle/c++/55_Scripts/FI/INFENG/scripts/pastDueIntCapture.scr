				ELSE
					#{
					CUST.PINT.suspForacid = ""
					CUST.PINT.suspAcid = ""
				#}
				ENDIF
				
				############################################################
				# getting PRDEM, PIDEM, INDEM amounts corresponding to acid
				###########################################################
				sv_x = 0
				BANCS.INPARAM.BINDVARS = CUST.PINT.bodDate +"|"+ BANCS.STDIN.contextBankId +"|" + CUST.PINT.acid
				sv_m = "adjAmt,flwId|select sum(ADJ_AMT), DMD_FLOW_ID from tbaadm.lda where "
				sv_m = sv_m + "tran_date = ?SVAR AND bank_id = ?SVAR AND acid = ?SVAR group by acid, DMD_FLOW_ID"
				
				sv_k = urhk_dbCursorOpenWithBind(sv_m)
