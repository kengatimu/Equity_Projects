<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	#BANCS.INPUT.CIFId = "54312489116"

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("LoanAccount"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Loan Account"
		sv_t = "LoanDisbSchedule_RES.<rec_1>.Error| " + CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("BankId"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter the Bank Id"
		sv_t = "LoanDisbSchedule_RES.<rec_1>.Error| " + CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------
	CUST.EZB.schm_type = "TDA"

	lv_u = urhk_B2k_ForacidToAcid(("BANCS").("INPUT").("LoanAccount"))
	print(lv_u)

    if(lv_u == 0)then
    #{
        CUST.EZB.acid = BANCS.OUTPARAM.Acid
		print(CUST.EZB.acid)
	ELSE 
		CUST.EZB.errMsg="Error Occured. Try Again or Contact Admin"
		sv_t = "LoanDisbSchedule_RES.<rec_1>.Error| " + CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF

	#----------------------------------------------------------------------------------------------
	#-- GET 
	#----------------------------------------------------------------------------------------------

	lv_q = "tran_date, tran_id, value_date, flow_amt |"
	lv_q = lv_q + "SELECT tran_date, tran_id,value_date,flow_amt "
	lv_q = lv_q + " FROM TBAADM.LTD "
	lv_q = lv_q + " WHERE ACID=?SVAR AND FLOW_ID='DISBT' "
	print(lv_q)
	BANCS.INPARAM.BINDVARS =  CUST.EZB.acid
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbcursorOpenWithBind(lv_q)
	PRINT(sv_c)

	IF (sv_c == 0)THEN
	#{
		CUST.EZB.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.EZB.cursor_number)

		sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
		print(sv_d)


		IF(sv_d == 0)THEN
		#{
			sv_q = 0
			print(sv_q)

			WHILE (sv_d == 0)
			#{
				sv_q = sv_q + 1
				print(sv_q)

				CUST.EZB.tranDate = BANCS.OUTPARAM.tran_date
				print(CUST.EZB.tranDate)
				CUST.EZB.tranId = BANCS.OUTPARAM.tran_id
				print(CUST.EZB.tranId)

				lv_q = "description,currency,flowAmt,valueDate| select TRAN_PARTICULAR,TRAN_CRNCY_CODE,TRAN_AMT,VALUE_DATE from tbaadm.dctd_acli where tran_id=?SVAR and tran_date=?SVAR and acid=?SVAR and bank_id=?SVAR "
				print(lv_q)
				BANCS.INPARAM.BINDVARS = CUST.EZB.tranId +"|"+ CUST.EZB.tranDate +"|"+ CUST.EZB.acid +"|"+ BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				sv_c = urhk_dbSelectWithBind(lv_q)
				print(sv_c)

				IF(sv_c == 0)THEN
				#{
					sv_v = "DisbType_" + FORMAT$(sv_q, "%d")
					("CUST").("EZB").(sv_v) = "Single"
					print(("CUST").("EZB").(sv_v))

					sv_v = "Description_" + FORMAT$(sv_q, "%d")
					("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.description
					print(("CUST").("EZB").(sv_v))

					sv_v = "Currency_" + FORMAT$(sv_q, "%d")
					("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.currency
					print(("CUST").("EZB").(sv_v))

					sv_v = "DisbAmt_" + FORMAT$(sv_q, "%d")
					("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.flowAmt
					print(("CUST").("EZB").(sv_v))

					sv_v = "DisbDate_" + FORMAT$(sv_q, "%d")
					("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.valueDate
					print(("CUST").("EZB").(sv_v))

					sv_v = "DisbType_" + FORMAT$(sv_q, "%d")
					sv_t = "LoanDisbSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DisbursementType| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)

					sv_v = "Description_" + FORMAT$(sv_q, "%d")
					sv_t = "LoanDisbSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.Description| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)

					sv_v = "Currency_" + FORMAT$(sv_q, "%d")
					sv_t = "LoanDisbSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.Currency| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)

					sv_v = "DisbAmt_" + FORMAT$(sv_q, "%d")
					sv_t = "LoanDisbSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DisbursementAmount| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)

					sv_v = "DisbDate_" + FORMAT$(sv_q, "%d")
					sv_t = "LoanDisbSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DisbursementDate| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)

					sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
					print(sv_d)
				#}
				ENDIF 
			#} 
			DO 

			sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
			print(sv_x)
			print(CUST.EZB.cursor_number)
		ELSE 
			CUST.EZB.errMsg="Failed to get result. Try Again or Contact Admin"
			sv_t = "LoanDisbSchedule_RES.<rec_1>.Error| " + CUST.EZB.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
	   		exitscript
		#}
		ENDIF 
	#}
	ENDIF
	
trace off

END-->

