#------------------------------------------------------------------------------------------------    
#	Name			: foracidECS.scr
#	Description		: This script used for getting the foracid from EMD based on mandate_srl_num.
#	Date			: 16-01-2013
#	Author			: Prakash
#	Input			: BANCS.INPUT.mandate_srl_num,BANCS.INPUT.destn_acc_no
#	Output			: BANCS.OUTPUT.lv_foracid
#	Called Script	: NA
#	Calling Scrip	: NA
#	Menu Option		: NA
#	Srl. No			Date			Author			Description.
#	-------			---------		-------			---------------
#	1.0				16-01-2013		Prakash			Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="f407d3a915e9718b1ae8694c0f3b036c25c0ea66f2942e689715a5b481247698"
	TRACE ON
	print(BANCS.INPUT.mandate_srl_num)
	#print(BANCS.INPUT.destn_acc_no)
	
	sv_s = "lv_foracid|SELECT foracid "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE del_flg = 'N' "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND acct_cls_flg = 'N' "
	sv_s = sv_s + "AND acid IN "
	sv_s = sv_s + "("
	sv_s = sv_s + "SELECT acid "
	sv_s = sv_s + "FROM TBAADM.PYRD "
	sv_s = sv_s + "WHERE entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	sv_s = sv_s + "AND pr_srl_num IN "
	sv_s = sv_s + "("
	sv_s = sv_s + "SELECT pr_srl_num "
	sv_s = sv_s + "FROM TBAADM.PYRH "
	sv_s = sv_s + "WHERE entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	sv_s = sv_s + "AND pr_b2k_id "
	sv_s = sv_s + "="
	sv_s = sv_s + "("
	sv_s = sv_s + "SELECT b2k_id "
	sv_s = sv_s + "FROM TBAADM.EMD "
	sv_s = sv_s + "WHERE mandate_srl_num = ?SVAR "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + ")"
	sv_s = sv_s + ")"
	sv_s = sv_s + ")"
	sv_s = sv_s + "AND bacid is NULL "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.mandate_srl_num + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		BANCS.OUTPUT.lv_foracid = BANCS.OUTPARAM.lv_foracid
		PRINT(BANCS.OUTPUT.lv_foracid)
		#}
	ELSE
		#{
		BANCS.OUTPUT.lv_foracid = " "
		PRINT(BANCS.OUTPUT.lv_foracid)
	#}
	ENDIF
	PRINT(BANCS.OUTPUT.lv_foracid)
	TRACE OFF
END-->
