<--start
trace on
        if(repexists("CUST") == 0) then
                createrep("CUST")
        endif
        if (classexists("CUST", "CORPREQ") == 0) then
                createclass("CUST", "CORPREQ", 5)
        endif
	
	
	CUST.CORPREQ.cif_id = trim(CUST.CCRRM.customer_id)
	CUST.CORPREQ.riskrating = trim(CUST.CCRRM.riskrating)
	CUST.CORPREQ.riskscore = trim(CUST.CCRRM.riskscore)
	
	CUST.CORPREQ.ChannelCode = "CRM"
	CUST.CORPREQ.SuccessOrFailure = "F"
	CUST.CORPREQ.custtype="C"
	
	print(CUST.CORPREQ.cif_id)
	print(CUST.CORPREQ.riskrating)
	print(CUST.CORPREQ.riskscore)
	

	sv_a = "messagedatatime,reqUUId,timeStampFF3|SELECT to_char(systimestamp,'yyyy-mm-ddhh:mi:ssxff'),regexp_replace(rawtohex(sys_guid()),'([A-F0-9]{8})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{12})', '\1-\2-\3-\4-\5'),to_char(systimestamp,'DD-MM-YYYY HH24:MI:SS:FF3') from dual"
	sv_b = urhk_dbSelectWithBind(sv_a)
	print(sv_b)
	if(sv_b ==0)then
	#{
		CUST.CORPREQ.reqUUId = BANCS.OUTPARAM.reqUUId
		CUST.CORPREQ.messagedatatime = BANCS.OUTPARAM.messagedatatime
		print(CUST.CORPREQ.messagedatatime)
		CUST.CORPREQ.tt  = MID$(CUST.CORPREQ.messagedatatime,0,10)
		CUST.CORPREQ.ttt = MID$(CUST.CORPREQ.messagedatatime,10,12)
		CUST.CORPREQ.messagedatatime = CUST.CORPREQ.tt  + "T" + CUST.CORPREQ.ttt
		BANCS.INPARAM.SYSDATE = BANCS.OUTPARAM.timeStampFF3
		print(BANCS.INPARAM.SYSDATE)
	#}
        else
	#{
        #2022-01-2604:57:34.290868
        CUST.CORPREQ.messagedatatime = "2022-01-11T15:18:54.167"
		CUST.CORPREQ.reqUUId = ""
        #}
        endif
	if(CUST.CORPREQ.reqUUId=="")then
		CUST.CORPREQ.RequestUUID =BANCS.INPARAM.SYSDATE
	else
		CUST.CORPREQ.RequestUUID = CUST.CORPREQ.reqUUId
	endif
	BANCS.INPARAM.milliSec = MID$(BANCS.INPARAM.SYSDATE,20,3)
	BANCS.INPARAM.Day = LEFT$(BANCS.INPARAM.SYSDATE,2)
	BANCS.INPARAM.Month = MID$(BANCS.INPARAM.SYSDATE,3,2)
	BANCS.INPARAM.Year = MID$(BANCS.INPARAM.SYSDATE,8,2)
	BANCS.INPARAM.MesgYear = MID$(BANCS.INPARAM.SYSDATE,6,4)
	BANCS.INPARAM.Hour = MID$(BANCS.INPARAM.SYSDATE,11,2)
	BANCS.INPARAM.Minute = MID$(BANCS.INPARAM.SYSDATE,14,2)
	BANCS.INPARAM.Second = MID$(BANCS.INPARAM.SYSDATE,17,2)

	BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second + BANCS.INPARAM.milliSec
	BANCS.INPARAM.MESSAGEDATETIME = BANCS.INPARAM.MesgYear + "-" + BANCS.INPARAM.Month + "-" + BANCS.INPARAM.Day + "T" + BANCS.INPARAM.Hour + ":" +  BANCS.INPARAM.Minute + ":" + BANCS.INPARAM.Second + "."+BANCS.INPARAM.milliSec

	BANCS.INPARAM.UserId = BANCS.STDIN.userId
	BANCS.INPARAM.BANKID = BANCS.STDIN.contextBankId
	BANCS.INPARAM.REQUESTUUID = CUST.CORPREQ.RequestUUID 
	
	
	BANCS.INPARAM.SERVICEREQUESTID = "updateCorpCustomer" 
	BANCS.INPARAM.CHANNELID = "CRM"
	BANCS.INPARAM.SERVICEREQUESTVERSION = "10.2"
	BANCS.INPARAM.TIMEZONE = "EAT+05:30"
	BANCS.INPARAM.UserApplId = "CRM"
	BANCS.INPARAM.UserChannelId = "FI"
	BANCS.INPARAM.SERVICE_NAME = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG = "R"

	CUST.CORPREQ.fiChnId	= "CRM"
	CUST.CORPREQ.XmlMessage = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"				
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<?xml version='1.0' encoding='UTF-8'?>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<FIXML xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xmlns:xsd='http://www.w3.org/2001/XMLSchema' xmlns='http://www.finacle.com/fixml'><Header>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<RequestHeader>" 
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<MessageKey>" 
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<RequestUUID>"+CUST.CORPREQ.RequestUUID+"</RequestUUID>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<ServiceRequestId>"+BANCS.INPARAM.SERVICEREQUESTID+"</ServiceRequestId>" 
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<ServiceRequestVersion>"+BANCS.INPARAM.SERVICEREQUESTVERSION+"</ServiceRequestVersion>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<ChannelId>"+CUST.CORPREQ.fiChnId+"</ChannelId>" 
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<LanguageId></LanguageId>" 
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</MessageKey>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<RequestMessageInfo>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<BankId>"+BANCS.STDIN.contextBankId+"</BankId>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<TimeZone></TimeZone>" 
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<EntityId></EntityId>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<EntityType></EntityType>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<ArmCorrelationId></ArmCorrelationId>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<MessageDateTime>"+CUST.CORPREQ.messagedatatime+"</MessageDateTime>" 
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</RequestMessageInfo>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</RequestHeader>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</Header>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<Body>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<updateCorpCustomerRequest>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<CorpCustomerModData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<mainData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<corpCustomerModCorporateData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<corp_key>"+CUST.CORPREQ.cif_id+"</corp_key>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<RiskProfileScore>"+CUST.CORPREQ.riskscore+"</RiskProfileScore>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<RiskRating>"+CUST.CORPREQ.riskrating+"</RiskRating>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<riskProfileScore>"+CUST.CORPREQ.riskscore+"</riskProfileScore>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</corpCustomerModCorporateData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</mainData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</CorpCustomerModData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<updateCorpCustomer_CustomData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "<riskRating>"+CUST.CORPREQ.riskrating+"</riskRating>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</updateCorpCustomer_CustomData>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</updateCorpCustomerRequest>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</Body>"
	CUST.CORPREQ.XmlMessage = CUST.CORPREQ.XmlMessage + "</FIXML>"
	print(CUST.CORPREQ.XmlMessage)

	BANCS.INPARAM.SERVICE_NAME="FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG="R"
	sv_l=urhk_ConnectToFIAndSendMsg(CUST.CORPREQ.XmlMessage)
	print(sv_l)
	if(fieldexists(BANCS.OUTPARAM.ErrCode)==1)then
	#{
		print(BANCS.OUTPARAM.ErrCode)
	#}
	endif
	if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
	#{
		print(BANCS.OUTPARAM.ErrMsg)
	#}
	endif
	if(fieldexists(BANCS.OUTPARAM.RespMesg))then
	#{
		print("Response message is ["+BANCS.OUTPARAM.RespMesg+"]")
		sv_d = BANCS.OUTPARAM.RespMesg
		sv_l = strlen(sv_d)
		CUST.CORPREQ.Response = BANCS.OUTPARAM.RespMesg
		CUST.CORPREQ.Status = GETPOSITION(CUST.CORPREQ.Response,"<Status>")
		print(CUST.CORPREQ.Status)
		
        if (CUST.CORPREQ.Status != "") then
		#{
			CUST.CORPREQ.Status1 = GETPOSITION(CUST.CORPREQ.Response,"</Status>")
			print(CUST.CORPREQ.Status1)
			CUST.CORPREQ.StatusFlag= mid$(CUST.CORPREQ.Response,cint(CUST.CORPREQ.Status)+7,cint(CUST.CORPREQ.Status1)-cint(CUST.CORPREQ.Status)-8)
			print(CUST.CORPREQ.StatusFlag)
		#}
        else
		#{
            CUST.CORPREQ.StatusFlag = ""
		#}
        endif
		
		IF(trim(CUST.CORPREQ.StatusFlag)=="SUCCESS")THEN
		#{
			CUST.CORPREQ.SuccessOrFailure = "S"
			print("CIF Verification Success")
		#}
		ENDIF
		if(trim(CUST.CORPREQ.StatusFlag)!="SUCCESS")THEN
		#{
			CUST.CORPREQ.SuccessOrFailure = "F"
			print("CIF Verification failed")
		#}
		ENDIF

		#----- Error Capturing Starts
			
			sv_x = CUST.CRMREQ.Response
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.CRMREQ.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
				print(CUST.CRMREQ.errorCode)
			#}
			ENDIF
			sv_x = CUST.CRMREQ.Response
			sv_y = "<ErrorDesc>"
			sv_z = "</ErrorDesc>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.CRMREQ.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
				print(CUST.CRMREQ.errorDesc)
			#}
			ENDIF

			
			#----- Error Capturing Ends
	#}
	else
	#{
		if(fieldexists(BANCS.OUTPARAM.ErrCode)==1)then
		#{
			CUST.CORPREQ.SuccessOrFailure = "F"
			print(BANCS.OUTPARAM.ErrCode)
		#}
		endif
		if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
		#{
			CUST.CORPREQ.SuccessOrFailure = "F"
			print(BANCS.OUTPARAM.ErrMsg)
		#}
		endif
		CUST.CORPREQ.SuccessOrFailure = "F"
	#}
	endif
	
EXITSCRIPT
TRACE OFF	
	
end-->
