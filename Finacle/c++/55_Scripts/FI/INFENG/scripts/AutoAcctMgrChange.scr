-------------------------------------------------------------------------------------------------------------
#    Name            : AutoAcctMgrChange.scr
#    Description     : Automation menu
#    Date            : 24-FEB-2023
#    Author          : Irungu James
#    Input           : NA
#    Output          : NA
#    Calling Script  : NA
#    Menu Option     : CAUTOMNU
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           24-FEB-2023         Irungu James              Original Version         1.0
#------------------------------------------------------------------------------------------------------

<--START
TRACE ON

	#==============================================================================
	#       Intialising Variables
	#=============================================================================

	CUST.DATA.SOURCEFILE = CUST.DATA.FilePath
	print(CUST.DATA.SOURCEFILE)

	sv_r = urtn_fileAccess(CUST.DATA.SOURCEFILE)
	print(sv_r)
	IF ( sv_r != 0 ) THEN
		sv_r = urhk_TBAF_DispMesg("Unable to Access FILE_LIST")
		sv_v = "UNABLE TO ACCESS THE LIST OF FILES"
		GOTO ENDOFSCRIPT
	ENDIF

	#--------------------------
	#	OPENING THE FILE
	#--------------------------

	sv_t = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	print(sv_t)
	IF (sv_t < 0) THEN
		print("Unable to open the file")
		GOTO ENDOFSCRIPT
	ELSE
		print("File Opened SuccessFully")
		CUST.DATA.succIndex = sv_t
	ENDIF

	#===================================================================================================================
	#       Read The File Data
	#===================================================================================================================

	CUST.DATA.fileRec = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	PRINT(CUST.DATA.fileRec)
	sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
	PRINT(sv_t)
	IF(sv_t != 0) THEN
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "Error_03|ERROR^Upload file is empty^fileName"
		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
	ENDIF

	sv_z = 0
	sv_y = 0
	CUST.DATA.RECCNT = 0
	#=======================================================================================
	#       Split And Storage Of data in file
	#=======================================================================================

	WHILE(sv_t == 0)
	

		
		sv_y =format$(sv_z,"%d")
		CUST.DATA.RECCNT = cint(CUST.DATA.RECCNT)+1
		CUST.DATA.inputRecord         =       TOUPPER(CUST.DATA.inputRecord)
		sv_k = CUST.DATA.inputRecord
		print(sv_k)
		sv_q = getposition(sv_k,",")
		print(sv_q)
		if(sv_q == 0) then
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^Enter an Valid file^upldFile"
			sv_u = urhk_SetOrbOut(sv_z)
			EXITSCRIPT
		ENDIF
	
		sv_g = 0
		sv_n = 1

		sv_l = STRLEN (CUST.DATA.inputRecord)
		sv_c = CUST.DATA.inputRecord
		print(sv_c)
		sv_q = getposition(sv_c,",")
		print(sv_q)
		CUST.DATA.FORACID= Left$(sv_c,sv_q - 1)
		CUST.DATA.FORACID = TRIM(CUST.DATA.FORACID)
		print(CUST.DATA.FORACID)


		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		#sv_q = getposition(sv_c,",")
		CUST.DATA.SCHM = sv_c 
		CUST.DATA.SCHM = TRIM(CUST.DATA.SCHM)
		print(CUST.DATA.SCHM)
		

		#===================================================================================================
		#       STORAGE OF DATA INTO CUSTOM TABLE
		#===================================================================================================
			
		sv_s = " INSERT INTO custom.CUST_AUTO_ACCT_MGR (FORACID, ACCTMGR, RCRE_USER_ID,FILE_NAME,RCRE_TIME, ENTITY_CRE_FLG, PROCESSED_FLG,FREE_TEXT2, BANK_ID ) "
		sv_s = sv_s + "  VALUES (?SVAR,?SVAR,?SVAR,?SVAR,sysdate,'N','N',?SVAR, ?SVAR)"
		BANCS.INPARAM.BINDVARS  = CUST.DATA.FORACID +"|"+ CUST.DATA.SCHM +"|"+ BANCS.STDIN.userId  + "|" + CUST.DATA.file_name  + "|" + CUST.DATA.RECCNT + "|" +  BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_r =  urhk_dbSQLwithbind(sv_s)
		print(sv_r)
		if(sv_r == 0)then
			sv_r = urhk_dbSQLwithbind("commit")
			print(sv_r)
			if(sv_r == 0)then
				CUST.DATA.sucess = "UPDATE SUCCESSFULL"
				CUST.DATA.scnt="1"
			else
				CUST.DATA.errorMsg  = " UPDATE FAILED"
				sv_r = urhk_dbSQLwithbind("ROLLBACK")
				GOTO NEXTREC1
			endif
		else
			CUST.DATA.errorMsg  = "UPDATE SOME ERROR IN THIS"
			sv_w =CUST.DATA.errorMsg+"  "+CUST.DATA.SOURCEFILE
			print(sv_w)
			sv_r = urhk_dbSQLwithbind("ROLLBACK")
			GOTO NEXTREC1
		endif
		
	

		NEXTREC1:
		sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
		PRINT(sv_t)
		sv_z = sv_z + 1


		CUST.DATA.recCount = sv_z
		print(CUST.DATA.recCount)
		sv_y = format$(sv_z,"%d")
		PRINT(sv_y)

	

	DO
	#===================================================================================#
	# Closing the files                                                                 #
	#===================================================================================#
	sv_j = urtn_fileClose(CUST.DATA.SOURCEFILE)
	print(sv_j)
	sv_t = urtn_fileClose(CUST.DATA.fileRec)
	PRINT(sv_t)
	sv_e = system("mv "+CUST.DATA.FilePath+" "+CUST.DATA.FilePath+"_Done")
	print(sv_e)
	
	
			

	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
		CREATEREP("CUSTS")
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","ACMLA") == 0) THEN
		CREATECLASS("CUSTS","ACMLA",5)
	ENDIF

	IF(REPEXISTS("EQSRV") == 0 ) THEN
	    CREATEREP("EQSRV")
	ENDIF
	IF (CLASSEXISTS("EQSRV","GLBDATA") == 0) THEN
	
	    CREATECLASS("EQSRV","GLBDATA",5)
	
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.ACMLA.errMsg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	
	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)
		
	sv_s=" foracid,ROW, acctMgr, solid ,acid ,schmType ,schmCode, acctClsFlag ,sweeps ,acctCrncyCode  |select a.FORACID, a.FREE_TEXT2, a.ACCTMGR, gam.sol_id, "
	sv_s = sv_s + " gam.acid , gam.schm_type, gam.schm_code  ,gam.acct_cls_flg, gam.allow_sweeps, gam.acct_crncy_code "
	sv_s = sv_s + " from CUSTOM.CUST_AUTO_ACCT_MGR a, tbaadm.gam where a.FILE_NAME= ?SVAR  "
	sv_s = sv_s + " AND a.ENTITY_CRE_FLG = 'N' and a.PROCESSED_FLG ='N' and a.bank_id =?SVAR and gam.foracid =a.foracid  "
	sv_s = sv_s + " and a.bank_id =gam.bank_id  and gam.acct_cls_flg ='N' order by gam.sol_id "
        BANCS.INPARAM.BINDVARS = CUST.DATA.file_name +"|"+  BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)	
	IF (sv_c==0) THEN	
		CUSTS.ACMLA.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.ACMLA.DbcursorNumber)
		print(sv_k)		
		WHILE (sv_k == 0)
		
			CUSTS.ACMLA.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.ACMLA.solid	= BANCS.OUTPARAM.solid
			CUSTS.ACMLA.acctMgr	= BANCS.OUTPARAM.acctMgr
			CUSTS.ACMLA.acid	= BANCS.OUTPARAM.acid
			CUSTS.ACMLA.AcctsolId	= BANCS.OUTPARAM.solid
			CUSTS.ACMLA.schmCode	= BANCS.OUTPARAM.schmCode
			CUSTS.ACMLA.schmType	= BANCS.OUTPARAM.schmType
			CUSTS.ACMLA.acctClsFlag = BANCS.OUTPARAM.acctClsFlag
			CUSTS.ACMLA.sweeps	= BANCS.OUTPARAM.sweeps
			CUSTS.ACMLA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
			CUST.DATA.ROW =  BANCS.OUTPARAM.ROW

			IF(CUSTS.ACMLA.solid != BANCS.STDIN.mySolId)THEN
			
				sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.ACMLA.solid)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
			
			ENDIF


			#--------------------------------------------------------------------------------------------------------------
			#--------------------------------------------------------------------------------------------------------------
			#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.creationMode|M")
			#PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.ACMLA.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTS.ACMLA.acid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.ACMLA.schmCode)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTS.ACMLA.schmType)
			PRINT(sv_u)

			###########-------------Adding the next assessment date for Eazzy loan and Eazzy plus loans and ODAs
			IF ((BANCS.STDIN.contextBankId == "54") AND ((CUSTS.ACMLA.schmCode == "LA527") OR (CUSTS.ACMLA.schmCode == "LA529"))) THEN 
			
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUSTS.ACMLA.foracid
				sv_j = "nextAssDate |select  to_char(next_assessment_date,'DD-MM-YYYY HH24:MI:SS') from tbaadm.chat "
				sv_j = sv_j + "where charge_type = 'MIS10' and acid in "
				sv_j = sv_j + "(select acid from tbaadm.gam where "
				sv_j = sv_j + "bank_id = ?SVAR and foracid = ?SVAR)"
				print(sv_j)
				sv_q = urhk_dbSelectWithBind(sv_j)
				PRINT(sv_q)
				
				IF (sv_q == 0) THEN
				
					CUSTS.ACMLA.nextAssDate = BANCS.OUTPARAM.nextAssDate
					PRINT(CUSTS.ACMLA.nextAssDate)
					CUSTS.ACMLA.BODDate = BANCS.STDIN.BODDate
					PRINT(CUSTS.ACMLA.BODDate)
				
				ENDIF
				BANCS.INPARAM.date1 = CUSTS.ACMLA.nextAssDate 
				BANCS.INPARAM.date2 = CUSTS.ACMLA.BODDate
				sv_a = urhk_B2k_dateDiff("")
				if(sv_a==0)then
					print(BANCS.OUTPARAM.dateDiff)
					BANCS.INPUT.diffdate = BANCS.OUTPARAM.dateDiff
				else
					BANCS.INPUT.diffdate = ""
				endif
				IF ((BANCS.INPUT.diffdate!="") AND (cdouble(BANCS.INPUT.diffdate)<=0))THEN
					CUSTS.ACMLA.targetDate = "31-12-2099 00:00:00"
					PRINT (CUSTS.ACMLA.targetDate)
							
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.multiKey.serial_num|1")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.eventid.chargeType|MIS10")
					#sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.eventid.chargeDesc
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.maxNoOfAssessmnts|999")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.type|D")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.weekNum| ")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.weekDay|0")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.startDd|0")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.hldyStat|N")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.calBase|00")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.months|0")
					sv_u = urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.assessFreq.days|0")
					#sv_u =urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.nextAssessDate|" + CUSTS.ACMLA.targetDate)
					#PRINT(sv_u)
				
				ELSE
				
					CUSTS.ACMLA.targetDate = CUSTS.ACMLA.nextAssDate
					PRINT(CUSTS.ACMLA.targetDate)
				
				ENDIF
			
			ENDIF
			IF (CUSTS.ACMLA.schmType =="ODA") THEN
				sv_u = urhk_ExecSrv("SRV_FetchODAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
			ELSE
				sv_u = urhk_ExecSrv("SRV_FetchLAAcctDtlForModify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
				PRINT(sv_u)
			ENDIF
				###########-------------End of Adding the next assessment date for Eazzy loan and Eazzy plus loans and ODAs

			IF (sv_u == 0) THEN		
				
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)				
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.ACMLA.foracid)
				PRINT(sv_u)
				#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.creationMode|M")
				#PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTS.ACMLA.acid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTS.ACMLA.schmType)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.ACMLA.schmCode)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|" + CUSTS.ACMLA.sweeps)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctClsFlag|" + CUSTS.ACMLA.acctClsFlag)
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
				PRINT(sv_u)
	
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctMgrAtAcct.userId|" + CUSTS.ACMLA.acctMgr)
				PRINT(sv_u)
				#sv_u = urhk_SetUrhkInp("acctInterestLA.grcPrdForPnlInt.days|0")
				#PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctCrncyCode.crncyCode|" + CUSTS.ACMLA.acctCrncyCode)
				PRINT(sv_u)

				IF ((BANCS.STDIN.contextBankId == "54") AND ((CUSTS.ACMLA.schmCode == "LA527") OR (CUSTS.ACMLA.schmCode == "LA529"))) THEN 
				
					sv_u =urhk_SetUrhkInp("acctChargeFreqLA.chargeFreqLL.<rec_0>.nextAssessDate|" + CUSTS.ACMLA.targetDate)
					PRINT(sv_u)
				
				ENDIF
				IF (CUSTS.ACMLA.schmType =="ODA") THEN
					sv_u = urhk_ExecSrv("SRV_ModifyODAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)
				ELSE
					sv_u = urhk_ExecSrv("SRV_ModifyLAAcctAndVerify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
					PRINT(sv_u)
				ENDIF
				
				IF (sv_u == 0) THEN
					CUST.DATA.Proc = "Y"
					CUST.DATA.InfoRes = "Success_"+ CUSTS.ACMLA.foracid
					
					sv_s = "  update  CUSTOM.CUST_AUTO_ACCT_MGR set LCHG_USER_ID = ?SVAR , LCHG_TIME = sysdate , FREE_TEXT1 = ?SVAR , ENTITY_CRE_FLG ='Y', PROCESSED_FLG =?SVAR where FILE_NAME = ?SVAR  and FREE_TEXT2 =?SVAR and foracid =?SVAR "
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.userId + "|" + CUST.DATA.InfoRes +"|"+  CUST.DATA.Proc +"|"+  CUST.DATA.file_name + "|" + CUST.DATA.ROW  + "|" + CUSTS.ACMLA.foracid  
					print(BANCS.INPARAM.BINDVARS)
					print(sv_s)
					sv_d=urhk_dbSqlWithBind(sv_s)
					IF (sv_d == 0)  THEN
						sv_d = urhk_dbSQLWithBind("COMMIT")
					ENDIF
					
				ELSE
					CUST.DATA.Proc = "N"
					print(CUSTS.ACMLA.foracid)
					EQSRV.GLBDATA.srvAcctId = CUSTS.ACMLA.foracid
					callscriptifexist("ebsrvHandler.scr")
					CUST.DATA.InfoRes =  EQSRV.GLBDATA.SrvError
					EQSRV.GLBDATA.srvErrCode = "Failed : AcctMgr Reallocation "
					EQSRV.GLBDATA.srvSucFail = "F"
					
					#-----------------------------------------------------------------------------------
					# Update custom table status
					#-----------------------------------------------------------------------------------
					
					sv_s = " update  CUSTOM.CUST_AUTO_ACCT_MGR set LCHG_USER_ID = ?SVAR , LCHG_TIME = sysdate , FREE_TEXT1 = ?SVAR , ENTITY_CRE_FLG ='Y', PROCESSED_FLG =?SVAR where FILE_NAME = ?SVAR  and FREE_TEXT2 =?SVAR and foracid =?SVAR "
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.userId + "|" + CUST.DATA.InfoRes +"|"+  CUST.DATA.Proc +"|"+  CUST.DATA.file_name + "|" + CUST.DATA.ROW  + "|" + CUSTS.ACMLA.foracid  
					print(BANCS.INPARAM.BINDVARS)
					print(sv_s)
					sv_d=urhk_dbSqlWithBind(sv_s)
					IF (sv_d == 0)  THEN
						sv_d = urhk_dbSQLWithBind("COMMIT")
					ENDIF

				
				ENDIF
				
			
			ELSE
					CUST.DATA.Proc = "N"
					print(CUSTS.ACMLA.foracid)
					EQSRV.GLBDATA.srvAcctId = CUSTS.ACMLA.foracid
					callscriptifexist("ebsrvHandler.scr")
					CUST.DATA.InfoRes =  EQSRV.GLBDATA.SrvError
					

					sv_s = " update  CUSTOM.CUST_AUTO_ACCT_MGR set LCHG_USER_ID = ?SVAR , LCHG_TIME = sysdate , FREE_TEXT1 = ?SVAR , ENTITY_CRE_FLG ='Y', PROCESSED_FLG =?SVAR where FILE_NAME = ?SVAR  and FREE_TEXT2 =?SVAR and foracid =?SVAR "
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.userId + "|" + CUST.DATA.InfoRes +"|"+  CUST.DATA.Proc +"|"+  CUST.DATA.file_name + "|" + CUST.DATA.ROW  + "|" + CUSTS.ACMLA.foracid  
					print(BANCS.INPARAM.BINDVARS)
					print(sv_s)
					sv_d=urhk_dbSqlWithBind(sv_s)
					IF (sv_d == 0)  THEN
						sv_d = urhk_dbSQLWithBind("COMMIT")
					ENDIF
			
			ENDIF
				
				
		sv_k = urhk_dbCursorFetch(CUSTS.ACMLA.DbcursorNumber)
		print(sv_k)	
	
		DO
			
		sv_c = urhk_dbCursorClose(CUSTS.ACMLA.DbcursorNumber)
		print(sv_c)
		
	ENDIF
		
ENDOFSCRIPT:
EXITSCRIPT
#TRACE OFF
END-->
