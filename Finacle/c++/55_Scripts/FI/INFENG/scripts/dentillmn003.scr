<--START
CHECKSUM="0651af39415422b8f19702a255133cfcc50ed3ef4735794e8a46abc884016be8"
	TRACE ON
	
	########################################
	# Create the necessary repos and classes
	########################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	CUST.DATA.bank_id = toUpper(BANCS.STDIN.contextBankId)
	print(CUST.DATA.bank_id)
	##########################################
	# Fetching number of records in CNC Table
	##########################################
	sv_a = "recCount|select count(1) from CNC"
	sv_a = sv_a + " WHERE bank_id ='" + CUST.DATA.bank_id + "' "
	print(sv_a)
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	
	IF (sv_d != 0) THEN
	#{
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.recCount = BANCS.OUTPARAM.recCount
		sv_u = urhk_SetOrbOut("recCount|" + CUST.DATA.recCount)
	#}
	ENDIF
	
	##########################################
	# Fetching CRNCY details from CNC Table
	##########################################
	sv_s = "CRNCY_CODE,CRNCY_NAME|"
	sv_s = sv_s + "select CRNCY_CODE,CRNCY_NAME FROM CNC "
	sv_s = sv_s + " WHERE bank_id ='" + CUST.DATA.bank_id + "' "
	sv_s = sv_s + "union "
	sv_s = sv_s + "select 'ALL','ALL' from dual"
	print(sv_s)
	sv_d = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_d = urhk_dbCursorFetch(sv_m)
	print(sv_d)
	sv_z = 1
	
	WHILE(sv_d == 0)
	#{
		CUST.DATA.CRNCY_CODE = BANCS.OUTPARAM.CRNCY_CODE
		CUST.DATA.CRNCY_NAME = BANCS.OUTPARAM.CRNCY_NAME
		print(CUST.DATA.CRNCY_CODE)
		print(CUST.DATA.CRNCY_NAME)
		
		sv_y = format$(sv_z, "%d")
		
		sv_s = "CRNCY_CODE_" + sv_y + "|" + CUST.DATA.CRNCY_CODE
		sv_u = urhk_SetOrbOut(sv_s)
		sv_s = "CRNCY_NAME_" + sv_y + "|" + CUST.DATA.CRNCY_NAME
		sv_u = urhk_SetOrbOut(sv_s)
		
		sv_z = sv_z + 1
		sv_d = urhk_dbCursorFetch(sv_m)
		print(sv_d)
	#}
	DO
	sv_d = urhk_dbCursorClose(sv_m)
	ENDOFSCRIPT:
		DELETEREP("CUST")
		EXITSCRIPT
		
		#trace off
END-->
