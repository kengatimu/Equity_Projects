#-------------------------------------------------------------------------------------
#    Name				: sharedtmdp001.scr
#    Description     	: For the given account,bacid is selected.Func code is "A" and
#						: bacid is "INTER", userWorkClass less than 600, error message displayed.
#    Date            	: 28-02-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: getcparamvalue.scr
#    Menu Option		:
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0			28-02-2013		Divya	 		Original Version
#    2.0            25-03-2013      Divya          Removed Hard Coded fields
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="e5e842b45a5fa3c4d2f2b96c4720df5590680af19c05a144cb03280c90f6b05b"
	TRACE ON
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("TMSS") == 0) THEN
	#{
		CREATEREP("TMSS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("TMSS","GLBDATA") == 0) THEN
	#{
		CREATECLASS("TMSS","GLBDATA",5)
	#}
	ENDIF
	
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		TMSS.GLBDATA.rateCode = BANCS.OUTPUT.parameterVal
		PRINT(TMSS.GLBDATA.rateCode)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "NORRATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	TMSS.GLBDATA.acctId = ""
	TMSS.GLBDATA.totalamt = "0"
	#--------------------------------------------------------------------------------
	# Intializing the variables
	#--------------------------------------------------------------------------------
	TMSS.GLBDATA.errMsg    = ""
	
	PRINT(BANCS.INPUT.acctId)
	TMSS.GLBDATA.acctId = BANCS.INPUT.acctId
	PRINT(TMSS.GLBDATA.acctId)
	
	PRINT(BANCS.INPUT.refAmt)
	TMSS.GLBDATA.refAmt = BANCS.INPUT.refAmt
	PRINT(TMSS.GLBDATA.refAmt)
	
	
	PRINT(BANCS.INPUT.pTranType)
	TMSS.GLBDATA.part_tran_type = BANCS.INPUT.pTranType
	PRINT(TMSS.GLBDATA.part_tran_type)
	
	#--------------------------------------------------------------------------------
	# Getting values from CPARAM
	#--------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "TRANDETAIL"
	BANCS.INPUT.parameterId = "WORKCLASS"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		TMSS.GLBDATA.workClass = BANCS.OUTPUT.parameterVal
		PRINT(TMSS.GLBDATA.workClass)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "Work Class setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MIDBACID"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		TMSS.GLBDATA.midBacid = BANCS.OUTPUT.parameterVal
		PRINT(TMSS.GLBDATA.midBacid)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "Bacid setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TABCODE1"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		TMSS.GLBDATA.tabCode1 = BANCS.OUTPUT.parameterVal
		PRINT(TMSS.GLBDATA.tabCode1)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "Table Code 1 not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TABCODE2"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		TMSS.GLBDATA.tabCode2 = BANCS.OUTPUT.parameterVal
		PRINT(TMSS.GLBDATA.tabCode2)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "Table Code 2 not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "LIMIT"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		TMSS.GLBDATA.limit = BANCS.OUTPUT.parameterVal
		PRINT(TMSS.GLBDATA.limit)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "USD limit not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "RATE"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		TMSS.GLBDATA.rate = BANCS.OUTPUT.parameterVal
		PRINT(TMSS.GLBDATA.rate)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "Rate not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	PRINT(TMSS.GLBDATA.acctId)
	sv_u = urhk_getAcctDetailsInRepository(TMSS.GLBDATA.acctId)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		TMSS.GLBDATA.bacid = BANCS.OUTPARAM.acctPlaceHolder
		PRINT(TMSS.GLBDATA.bacid)
		TMSS.GLBDATA.bacid = MID$(TMSS.GLBDATA.bacid,0,5)
		PRINT(TMSS.GLBDATA.bacid)
		#}
	ELSE
		#{
		TMSS.GLBDATA.errMsg = "Account Invalid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(TMSS.GLBDATA.bacid)
	PRINT(TMSS.GLBDATA.midBacid)
	IF (TMSS.GLBDATA.bacid == TMSS.GLBDATA.midBacid) THEN
	#{
		PRINT("yaa2")
		IF ((TMSS.GLBDATA.refAmt != "") AND (TMSS.GLBDATA.part_tran_type == "D")) THEN
		#{
			IF (CINT(BANCS.STDIN.userWorkClass) < CINT(TMSS.GLBDATA.workClass)) THEN
			#{
				COLL.GLBDATA.errMsg = "Inter-Country Transaction Debits not allowed cannot proceed"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		IF ((TMSS.GLBDATA.refAmt != "") AND (TMSS.GLBDATA.part_tran_type == "C")) THEN
		#{
			IF (FIELDEXISTS(TMSS.GLBDATA.fcaccount == 1)) THEN
			#{
				PRINT(BANCS.STDIN.userWorkClass)
				PRINT(TMSS.GLBDATA.workClass)
				IF (CINT(BANCS.STDIN.userWorkClass) < CINT(TMSS.GLBDATA.workClass)) THEN
				#{
					COLL.GLBDATA.errMsg = "Inter-Country Transaction Deposit P&P failure cannot proceed"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				TMSS.GLBDATA.fcaccount = "0303300100412"
				PRINT(TMSS.GLBDATA.fcaccount)
				TMSS.GLBDATA.sub_type = "BI"
				PRINT(TMSS.GLBDATA.sub_type)
				TMSS.GLBDATA.tran_type = "T"
				PRINT(TMSS.GLBDATA.tran_type)
				TMSS.GLBDATA.tran_amt = "1"
				PRINT(TMSS.GLBDATA.tran_amt)
				TMSS.GLBDATA.ACCT_NAME = "SUSPENDED INTEREST STAFF HOUSING LOANS"
				PRINT(TMSS.GLBDATA.ACCT_NAME)
				TMSS.GLBDATA.CLR_BAL_AMT = "-16060009"
				PRINT(TMSS.GLBDATA.CLR_BAL_AMT)
				TMSS.GLBDATA.ACID = "TQ43"
				PRINT(TMSS.GLBDATA.ACID)
				TMSS.GLBDATA.FREZ_CODE = ""
				PRINT(TMSS.GLBDATA.FREZ_CODE)
				TMSS.GLBDATA.ccy = "KES"
				PRINT(TMSS.GLBDATA.ccy)
				TMSS.GLBDATA.amountfc = "0"
				TMSS.GLBDATA.rate     = "0"
				
				
				#--------------------------------------------------------------------------------
				# Checking inter Account status
				#--------------------------------------------------------------------------------
				sv_s = "Status|SELECT DECODE(acct_status,'A','Active A/c','D','Dormant A/c','I','Inactive A/c') "
				sv_s = sv_s + "FROM TBAADM.SMT "
				sv_s = sv_s + "WHERE acid = ?SVAR "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				PRINT(TMSS.GLBDATA.ACID)
				BANCS.INPARAM.BINDVARS = TMSS.GLBDATA.ACID + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					TMSS.GLBDATA.status = BANCS.OUTPARAM.Status
					PRINT(TMSS.GLBDATA.status)
					#}
				ELSE
					#{
					TMSS.GLBDATA.status = ""
				#}
				ENDIF
				
				
				#--------------------------------------------------------------------------------
				# Checking inter account freze status
				#--------------------------------------------------------------------------------
				sv_s = "modeofoprn|SELECT ref_desc "
				sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.RCT "
				sv_s = sv_s + "WHERE mode_of_oper_code = ref_code "
				sv_s = sv_s + "AND GAM.bank_id = RCT.bank_id "
				sv_s = sv_s + "AND ref_rec_type = '27' "
				sv_s = sv_s + "AND RCT.del_flg = 'N' "
				sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
				sv_s = sv_s + "AND GAM.del_flg = 'N' "
				sv_s = sv_s + "AND acid = ?SVAR "
				sv_s = sv_s + "AND GAM.bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = TMSS.GLBDATA.ACID + "|" + BANCS.STDIN.contextBankId
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					TMSS.GLBDATA.modeofoprn = BANCS.OUTPARAM.modeofoprn
					PRINT(TMSS.GLBDATA.modeofoprn)
					#}
				ELSE
					#{
					TMSS.GLBDATA.modeofoprn = ""
				#}
				ENDIF
				
				IF (TMSS.GLBDATA.part_tran_type == "C") THEN
				#{
					TMSS.GLBDATA.trxtype = "Dep Amount in FCY"
					PRINT(TMSS.GLBDATA.trxtype)
					#}
				ELSE
					#{
					TMSS.GLBDATA.trxtype = "Wdrwal Amount in FCY"
					PRINT(TMSS.GLBDATA.trxtype)
				#}
				ENDIF
				
				TMSS.GLBDATA.feefc = "0"
				
				PRINT(TMSS.GLBDATA.refAmt)
				
				IF (TMSS.GLBDATA.tran_type == "T") THEN
				#{
					TMSS.GLBDATA.TableCode = TMSS.GLBDATA.tabCode1
					PRINT(TMSS.GLBDATA.TableCode)
					#}
				ELSE
					#{
					TMSS.GLBDATA.TableCode = TMSS.GLBDATA.tabCode2
					PRINT(TMSS.GLBDATA.TableCode)
				#}
				ENDIF
				
				IF (BANCS.STDIN.contextBankId != "UG") THEN
				#{
					#--------------------------------------------------------------------------------
					# Convert amount to USD to check for allowable amounts
					#--------------------------------------------------------------------------------
					PRINT(TMSS.GLBDATA.ccy)
					BANCS.INPARAM.InputAmount  = TMSS.GLBDATA.refAmt
					BANCS.INPARAM.FromCurrency = TMSS.GLBDATA.ccy
					BANCS.INPARAM.ToCurrency   = "USD"
					BANCS.INPARAM.RateCode     = TMSS.GLBDATA.rateCode
					BANCS.INPARAM.Rate         = TMSS.GLBDATA.rate
					sv_u = urhk_B2k_ConvertAmount("")
					PRINT(sv_u)
					IF (sv_u == 1) THEN
					#{
						TMSS.GLBDATA.errMsg = "Rate not set for currency code" + TMSS.GLBDATA.ccy
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						TMSS.GLBDATA.usdcontdamt  = BANCS.OUTPARAM.OutputAmount
						TMSS.GLBDATA.usdcontdrate = BANCS.OUTPARAM.Rate
						PRINT(TMSS.GLBDATA.usdcontdamt)
						PRINT(TMSS.GLBDATA.usdcontdrate)
						TMSS.GLBDATA.USDlimit = CDOUBLE(TMSS.GLBDATA.limit)
						PRINT(TMSS.GLBDATA.USDlimit)
						IF (CINT(BANCS.STDIN.userWorkClass) < CINT(TMSS.GLBDATA.workClass)) THEN
						#{
							PRINT(BANCS.STDIN.userWorkClass)
							IF (CDOUBLE(TMSS.GLBDATA.usdcontdamt) > CDOUBLE(TMSS.GLBDATA.USDlimit)) THEN
							#{
								TMSS.GLBDATA.errMsg = "Insufficent Workclass (>150).cannot proceed"
								GOTO ENDOFSCRIPT
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				
				
				#--------------------------------------------------------------------------------
				# Convert amount to KES using mean rate
				#--------------------------------------------------------------------------------
				BANCS.INPARAM.InputAmount  = TMSS.GLBDATA.refAmt
				BANCS.INPARAM.FromCurrency = TMSS.GLBDATA.ccy
				BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.RateCode     = TMSS.GLBDATA.rateCode
				BANCS.INPARAM.Rate         = TMSS.GLBDATA.rate
				sv_u = urhk_B2k_ConvertAmount("")
				PRINT(sv_u)
				IF (sv_u == 1) THEN
				#{
					TMSS.GLBDATA.errMsg = "Rate not set for currency code" + TMSS.GLBDATA.ccy
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					TMSS.GLBDATA.contdamt  = BANCS.OUTPARAM.OutputAmount
					TMSS.GLBDATA.contdrate = BANCS.OUTPARAM.Rate
					PRINT(TMSS.GLBDATA.contdamt)
					PRINT(TMSS.GLBDATA.contdrate)
				#}
				ENDIF
				
				BANCS.INPARAM.InputAmount     = TMSS.GLBDATA.contdamt
				BANCS.INPARAM.CurrencyCode    = BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.AmountTableCode = TMSS.GLBDATA.TableCode
				sv_u = urhk_B2k_GetASTMAmount("")
				PRINT(sv_u)
				IF (sv_u == 1)  THEN
				#{
					TMSS.GLBDATA.errMsg = "Invalid Charge Code"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					TMSS.GLBDATA.feefc = BANCS.OUTPARAM.OutputAmount
					PRINT(TMSS.GLBDATA.feefc)
					TMSS.GLBDATA.feefc = TMSS.GLBDATA.feefc
				#}
				ENDIF
				PRINT(TMSS.GLBDATA.feefc)
				
				#--------------------------------------------------------------------------------
				# Convert fee amount to fcy using mean rate
				#--------------------------------------------------------------------------------
				BANCS.INPARAM.InputAmount  = TMSS.GLBDATA.feefc
				BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.ToCurrency   = TMSS.GLBDATA.ccy
				BANCS.INPARAM.RateCode     = TMSS.GLBDATA.rateCode
				BANCS.INPARAM.Rate         = TMSS.GLBDATA.rate
				sv_u = urhk_B2k_ConvertAmount("")
				IF (sv_u == 1) THEN
				#{
					TMSS.GLBDATA.errMsg = "Rate not set for currency code" + TMSS.GLBDATA.ccy
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					TMSS.GLBDATA.feefcy       = BANCS.OUTPARAM.OutputAmount
					TMSS.GLBDATA.contdfeerate = BANCS.OUTPARAM.Rate
					PRINT(TMSS.GLBDATA.feefcy)
					PRINT(TMSS.GLBDATA.contdfeerate)
				#}
				ENDIF
				
				PRINT(CDOUBLE(TMSS.GLBDATA.refAmt))
				PRINT(CDOUBLE(TMSS.GLBDATA.feefc))
				TMSS.GLBDATA.totalamt = CDOUBLE(TMSS.GLBDATA.refAmt) + CDOUBLE(TMSS.GLBDATA.feefc)
				
				sv_a = "Success| " + "S"
				sv_b = urhk_SetOrbOut(sv_a)
				
				sv_a = "clramt| " + TMSS.GLBDATA.CLR_BAL_AMT
				sv_b = urhk_SetOrbOut(sv_a)
				
				sv_a = "feeamt| " + TMSS.GLBDATA.feefcy
				sv_b = urhk_SetOrbOut(sv_a)
				
				sv_a = "alcy| " + TMSS.GLBDATA.contdamt
				sv_b = urhk_SetOrbOut(sv_a)
				
				sv_a = "clcy| " + TMSS.GLBDATA.feefc
				sv_b = urhk_SetOrbOut(sv_a)
				
				sv_a = "trxtype| " + TMSS.GLBDATA.trxtype
				sv_b = urhk_SetOrbOut(sv_a)
				
				sv_a = "tranType| " + TMSS.GLBDATA.tran_type
				PRINT(sv_a)
				sv_b = urhk_SetOrbOut(sv_a)
				
				PRINT("P")
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	
	ENDOFSCRIPT:
		IF(TMSS.GLBDATA.errMsg != "") THEN
		#{
			sv_a = "Error|" + TMSS.GLBDATA.errMsg
			sv_b = urhk_SetOrbOut(sv_a)
		#}
		ENDIF
		
		
		DELETEREP("TMSS")
		TRACE OFF
		EXITSCRIPT
END-->
