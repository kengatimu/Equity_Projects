<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "CSEG")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "CSEG", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("SUB_SECTOR_CODE"))== 0) ) THEN
	#{
   		CUST.CSEG.errMsg="please enter SUB_SECTOR_CODE"
		sv_t = "ERROR | " +CUST.CSEG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.CSEG.SUB_SECTOR_CODE= BANCS.INPUT.SUB_SECTOR_CODE
	print(CUST.CSEG.SUB_SECTOR_CODE)		


	sv_s="ISIC3_CODE, ISIC3_DESC |"
	sv_s=sv_s + "SELECT C.VALUE, L.LOCALETEXT FROM CRMUSER.CATEGORIES C, CRMUSER.CATEGORY_LANG L WHERE  "
	sv_s=sv_s + "C.BANK_ID=?SVAR AND L.BANK_ID=?SVAR AND C.CATEGORYID=L.CATEGORYID AND "
	sv_s=sv_s + "C.CATEGORYTYPE='ISICP1' AND C.RATING=?SVAR AND C.RATINGTYPE='SUB_SECTOR_CODE' " 
	print(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CSEG.SUB_SECTOR_CODE
	print(BANCS.INPARAM.BINDVARS)

	sv_v = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_v)	

	IF(sv_v == 0) THEN
       	 #{
        	CUST.CSEG.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       		print(CUST.CSEG.CURSOR_NUMBER)
       		sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
        	print(sv_b)
		BANCS.INPUT.RECCOUNT = CINT("1")
        	print(BANCS.INPUT.RECCOUNT)

		sv_i=1
		print(sv_i)

		WHILE(sv_b == "0")
        	#{
			CUST.CSEG.ISIC3_CODE= BANCS.OUTPARAM.ISIC3_CODE
			print(CUST.CSEG.ISIC3_CODE)

			CUST.CSEG.ISIC3_DESC= BANCS.OUTPARAM.ISIC3_DESC
			print(CUST.CSEG.ISIC3_DESC)

			sv_s="ISIC3_CODE"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.ISIC3_CODE
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="ISIC3_DESC"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.ISIC3_DESC
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)


       			GOTO NEXTREC

      			BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
        		PRINT(BANCS.INPUT.RECCOUNT)

        		NEXTREC:
			sv_i = sv_i + 1 
       			sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
       			print(sv_b)
		#}
		DO
	#}
	ENDIF


ENDOFSCRIPT:
END-->

