<--start
trace on
	##sv_u = urhk_B2K_PrintRepos("BANCS")
	##print(sv_u)
        if(repexists("ODCAL")==0)then
                createrep("ODCAL")
        endif
        if(classexists("ODCAL","DATA")==0)then
                createclass("ODCAL","DATA",5)
        endif
	if(fieldexists(BANCS.INPUT.schmType)==1)then
	if(BANCS.INPUT.schmType!="ODA")then	
		exitscript
	endif	
	endif
	if(fieldexists(BANCS.INPUT.schmCode)==1)then
	if(BANCS.INPUT.schmCode!="OD551")then
		exitscript
	endif
	endif
	if(fieldexists(BANCS.INPUT.b2kType)==1)then
		print(BANCS.INPUT.b2kType)
	endif
	if(fieldexists(BANCS.INPUT.b2kId)==1)then
		print(BANCS.INPUT.b2kId)
	endif
	if(fieldexists(BANCS.INPUT.solId)==1)then
		print(BANCS.INPUT.solId)
	endif
	BANCS.OUTPUT.maxDPDCounter	= ""  
	BANCS.OUTPUT.mainClassificationSystem	= BANCS.INPUT.mainClassificationSystem 
	BANCS.OUTPUT.subClassificationSystem	= BANCS.INPUT.subClassificationSystem
	BANCS.OUTPUT.assetClsReasonCode	= ""
	BANCS.OUTPUT.trgEntityType = BANCS.INPUT.b2kType
	BANCS.OUTPUT.trgEntityId = BANCS.INPUT.b2kId

	lv_a= urhk_B2k_AcidToForacid(BANCS.INPUT.b2kId)
	if(lv_a==0)then
	#{
		ODCAL.DATA.Odforacid = BANCS.OUTPARAM.Foracid
	#}
	else
	#{
		ODCAL.DATA.Odforacid = ""
	#}
	endif
	sv_u = urhk_getAcctDetailsInRepository(ODCAL.DATA.Odforacid)
	print(sv_u)
	if(sv_u==0)then
	#{
		print(BANCS.OUTPARAM.AllowSweeps)
		print(BANCS.OUTPARAM.PoolId)
		BANCS.INPUT.iAllowSweeps = BANCS.OUTPARAM.AllowSweeps
	#}
	else
	#{
		BANCS.INPUT.iAllowSweeps = ""
	#}
	endif
	lv_h = " limexpDate | select to_char(lim_exp_date,'DD-MM-YYYY') from tbaadm.lht where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and acid=?SVAR and serial_num in (select max(serial_num) from tbaadm.lht where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and acid=?SVAR) and lim_exp_date <= to_date(?SVAR,'DD-MM-RRRR') " 
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.b2kId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.b2kId + "|" + left$(BANCS.STDIN.BODDate,10) 
	print(lv_h)
	print(BANCS.INPARAM.BINDVARS)
	lv_d = urhk_dbSelectWithBind(lv_h)
	if(lv_d==0)then
	#{
		ODCAL.DATA.limexpDate = BANCS.OUTPARAM.limexpDate
	#}
	else
	#{
		ODCAL.DATA.limexpDate = ""
	#}
	endif
	if(ODCAL.DATA.limexpDate!="")then
	#{
		BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10) 
		BANCS.INPARAM.date2 = ODCAL.DATA.limexpDate 
		sv_u = urhk_B2K_dateDiff("")
		print(sv_u)
		if(sv_u==0)then
		#{
			ODCAL.DATA.overdueDays = BANCS.OUTPARAM.dateDiff
		#}
		else
		#{
			ODCAL.DATA.overdueDays = "0" 
		#}
		endif
	#}
	else
	#{
		ODCAL.DATA.overdueDays = "0"
	#}
	endif
	if(ODCAL.DATA.Odforacid!="")then
	#{
		lv_u = urhk_getAcctDetailsInRepository(ODCAL.DATA.Odforacid)
		print(lv_u)
		if(lv_u==0)then
		#{
                        ODCAL.DATA.icrEffBal = BANCS.OUTPARAM.EffAvailableAmt
                        ODCAL.DATA.icrclearBalance = BANCS.OUTPARAM.clearBalance
		#}
		else
		#{
			ODCAL.DATA.icrEffBal = ""
			ODCAL.DATA.icrclearBalance = ""
		#}
		endif
		print(ODCAL.DATA.icrEffBal)
		print(ODCAL.DATA.icrclearBalance)
		if(cdouble(ODCAL.DATA.icrclearBalance)>=0)then
		#{
			ODCAL.DATA.overdueDays = "0"
		#}
		endif
	#}
	endif
        if(cint(ODCAL.DATA.overdueDays) <= 30) then
	#{
                ODCAL.DATA.mainClassfn = "PA"
                ODCAL.DATA.subClassfn = "NORM"
                goto ENDOFSCRIPT
	#}
        endif
        if((cint(ODCAL.DATA.overdueDays) > 30) and (cint(ODCAL.DATA.overdueDays) <= 90)) then
	#{
                ODCAL.DATA.mainClassfn = "PA"
                ODCAL.DATA.subClassfn = "WATC"
                goto ENDOFSCRIPT
	#}
        endif
        if((cint(ODCAL.DATA.overdueDays) > 90) and (CINT(ODCAL.DATA.overdueDays) <= 180)) then
	#{
                ODCAL.DATA.mainClassfn = "NPA"
                ODCAL.DATA.subClassfn = "SUBS"
                goto ENDOFSCRIPT
	#}
        endif
        if((cint(ODCAL.DATA.overdueDays) > 180) and (CINT(ODCAL.DATA.overdueDays) <= 365)) then
	#{
                ODCAL.DATA.mainClassfn = "NPA"
                ODCAL.DATA.subClassfn = "DBTL"
                goto ENDOFSCRIPT
	#}
        endif
        if(cint(ODCAL.DATA.overdueDays) > 365) then
	#{
                ODCAL.DATA.mainClassfn = "NPA"
                ODCAL.DATA.subClassfn = "LOSS"
                goto ENDOFSCRIPT
	#}
        endif
        ENDOFSCRIPT:
                if((ODCAL.DATA.subClassfn != "") and (ODCAL.DATA.mainClassfn != "")) then
		#{
                        BANCS.OUTPUT.maxDPDCounter = ODCAL.DATA.overdueDays 
                        BANCS.OUTPUT.mainClassificationSystem = ODCAL.DATA.mainClassfn 
                        BANCS.OUTPUT.subClassificationSystem = ODCAL.DATA.subClassfn 
		#}
                endif
                print(BANCS.OUTPUT.mainClassificationSystem)
                print(BANCS.OUTPUT.subClassificationSystem)
                print(BANCS.OUTPUT.maxDPDCounter)
                print(BANCS.OUTPUT.assetClsReasonCode)
                print(BANCS.OUTPUT.trgEntityType)
                print(BANCS.OUTPUT.trgEntityId)
	exitscript
trace off
end-->
