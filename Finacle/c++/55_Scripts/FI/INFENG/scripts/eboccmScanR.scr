#------------------------------------------------------------------------
#  Name            : eboccmScanR.scr 
#  Description     :
#  Date            : 19-03-2021
#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             19-03-2021      Vino Palani          Original Version
#-------------------------------------------------------------------------
<--start
trace on
        if(repexists("CUST") == 0) then
                createrep("CUST")
        endif
        if (classexists("CUST", "HOCCM") == 0) then
                createclass("CUST", "HOCCM", 5)
        endif
        if (classexists("CUST", "INTERFACE") == 0) then
                createclass("CUST", "INTERFACE", 5)
        endif
        CUST.HOCCM.UniqueString = TOUPPER(TRIM(BANCS.INPUT.UniqueString))
        print(CUST.HOCCM.UniqueString)
        CUST.HOCCM.ModuleId = TOUPPER(TRIM(BANCS.INPUT.ModuleId))
        print(CUST.HOCCM.ModuleId)
        CUST.INTERFACE.errorMsgFlg = ""
        CUST.INTERFACE.errorMsgDesc = ""
        if(CUST.HOCCM.UniqueString=="")then
                CUST.INTERFACE.errorMsgFlg = "Y"
                CUST.INTERFACE.errorMsgDesc = "Input Param Not Exists for Third Party Call Failed"
                goto ENDOFSCRIPT
        endif
	CUST.HOCCM.ResDesc = ""
	CUST.HOCCM.ResCode = ""
	CUST.HOCCM.ProcessStatus = ""
	CUST.HOCCM.ServiceStatus = ""
	CUST.HOCCM.ScanData = ""
        BANCS.INPARAM.Day=LEFT$(BANCS.STDIN.sysDate,2)
        BANCS.INPARAM.Month=MID$(BANCS.STDIN.sysDate,3,2)
        BANCS.INPARAM.Year=MID$(BANCS.STDIN.sysDate,8,2)
        BANCS.INPARAM.Hour=MID$(BANCS.STDIN.sysDate,11,2)
        BANCS.INPARAM.Minute=MID$(BANCS.STDIN.sysDate,14,2)
        BANCS.INPARAM.Second=MID$(BANCS.STDIN.sysDate,17,2)
        BANCS.INPARAM.SYSDATE=BANCS.INPARAM.Second+BANCS.INPARAM.Minute+BANCS.INPARAM.Day+BANCS.INPARAM.Month+BANCS.INPARAM.Year
        BANCS.INPARAM.MESSAGEDATETIME           = "2013-04-24T15:30:30.910"
        BANCS.INPARAM.CHANNELID                 = "COR"
        BANCS.INPARAM.TIMEZONE                  = "GMT+05:30"
        BANCS.INPARAM.BANKID                    = BANCS.STDIN.contextBankId
        if(BANCS.STDIN.contextBankId=="50")then
        BANCS.INPARAM.ServiceReqId              = "RwVPHScanResp"
        else
        BANCS.INPARAM.ServiceReqId              = "VPHScanResp"
        endif
        BANCS.INPARAM.SERVICEREQUESTVERSION     = "10.2" 
        BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
        BANCS.INPARAM.SEND_RECV_FLG             = "R"
	CUST.HOCCM.RequestUUID                ="VPH-SCAN"+ BANCS.INPARAM.SYSDATE
	####CUST.HOCCM.unique_id 			="FM051662021-03-191616159347"
	CUST.HOCCM.unique_id 			= CUST.HOCCM.UniqueString
	CUST.HOCCM.XmlMessage = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"				
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<?xml version='1.0' encoding='UTF-8'?>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<FIXML xsi:schemaLocation='http://www.finacle.com/fixml executeFinacleScript.xsd' xmlns='http://www.finacle.com/fixml' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'><Header>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<RequestHeader>" 
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<MessageKey>" 
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<RequestUUID>"+CUST.HOCCM.RequestUUID+"</RequestUUID>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<ServiceRequestId>"+BANCS.INPARAM.ServiceReqId+"</ServiceRequestId>" 
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<ServiceRequestVersion>"+BANCS.INPARAM.SERVICEREQUESTVERSION+"</ServiceRequestVersion>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<ChannelId>VER</ChannelId>" 
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<LanguageId></LanguageId>" 
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "</MessageKey>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<RequestMessageInfo>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<BankId>"+BANCS.STDIN.contextBankId+"</BankId>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<TimeZone></TimeZone>" 
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<EntityId></EntityId>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<EntityType></EntityType>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<ArmCorrelationId></ArmCorrelationId>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<MessageDateTime>2018-00-10T15:18:54.167</MessageDateTime>" 
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "</RequestMessageInfo>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "</RequestHeader>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "</Header>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<Body>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "<unique_id>"+CUST.HOCCM.unique_id+"</unique_id>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "</Body>"
	CUST.HOCCM.XmlMessage = CUST.HOCCM.XmlMessage + "</FIXML>"
	print(CUST.HOCCM.XmlMessage)

	BANCS.INPARAM.SERVICE_NAME="FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG="R"
	sv_l=urhk_ConnectToFIAndSendMsg(CUST.HOCCM.XmlMessage)
	print(sv_l)
	if(fieldexists(BANCS.OUTPARAM.RespMesg))then
		CUST.HOCCM.Response = BANCS.OUTPARAM.RespMesg
		print(CUST.HOCCM.Response)
		CUST.HOCCM.Status = GETPOSITION(CUST.HOCCM.Response,"<StatusFlag>")
		print(CUST.HOCCM.Status)
		if (CUST.HOCCM.Status != "") then
			CUST.HOCCM.Status1 = GETPOSITION(CUST.HOCCM.Response,"</StatusFlag>")
			print(CUST.HOCCM.Status1)
			CUST.HOCCM.StatusFlag= mid$(CUST.HOCCM.Response,cint(CUST.HOCCM.Status)+11,cint(CUST.HOCCM.Status1)-cint(CUST.HOCCM.Status)-12)
			print(CUST.HOCCM.StatusFlag)
		else
			CUST.HOCCM.StatusFlag = ""
		endif
		if(CUST.HOCCM.StatusFlag=="Y")then
			CUST.HOCCM.OrgId1 = GETPOSITION(CUST.HOCCM.Response,"<ServiceStatus>")
			print(CUST.HOCCM.OrgId1)
			if (CUST.HOCCM.OrgId1 != "") then
				CUST.HOCCM.OrgId2 = GETPOSITION(CUST.HOCCM.Response,"</ServiceStatus>")
				print(CUST.HOCCM.OrgId2)
				CUST.HOCCM.ServiceStatus= mid$(CUST.HOCCM.Response,cint(CUST.HOCCM.OrgId1)+14,cint(CUST.HOCCM.OrgId2)-cint(CUST.HOCCM.OrgId1)-15)
				print(CUST.HOCCM.ServiceStatus)
			else
				CUST.HOCCM.ServiceStatus = ""
			endif
			CUST.HOCCM.OrgId1 = GETPOSITION(CUST.HOCCM.Response,"<ProcessStatus>")
			print(CUST.HOCCM.OrgId1)
			if (CUST.HOCCM.OrgId1 != "") then
				CUST.HOCCM.OrgId2 = GETPOSITION(CUST.HOCCM.Response,"</ProcessStatus>")
				print(CUST.HOCCM.OrgId2)
				CUST.HOCCM.ProcessStatus= mid$(CUST.HOCCM.Response,cint(CUST.HOCCM.OrgId1)+14,cint(CUST.HOCCM.OrgId2)-cint(CUST.HOCCM.OrgId1)-15)
				print(CUST.HOCCM.ProcessStatus)
			else
				CUST.HOCCM.ProcessStatus = ""
			endif
			CUST.HOCCM.OrgId1 = GETPOSITION(CUST.HOCCM.Response,"<ErrorCode>")
			print(CUST.HOCCM.OrgId1)
			if (CUST.HOCCM.OrgId1 != "") then
				CUST.HOCCM.OrgId2 = GETPOSITION(CUST.HOCCM.Response,"</ErrorCode>")
				print(CUST.HOCCM.OrgId2)
				CUST.HOCCM.ErrorCode= mid$(CUST.HOCCM.Response,cint(CUST.HOCCM.OrgId1)+10,cint(CUST.HOCCM.OrgId2)-cint(CUST.HOCCM.OrgId1)-11)
				print(CUST.HOCCM.ErrorCode)
			else
				CUST.HOCCM.ErrorCode = ""
			endif
			CUST.HOCCM.OrgId1 = GETPOSITION(CUST.HOCCM.Response,"<ScanData>")
			print(CUST.HOCCM.OrgId1)
			if (CUST.HOCCM.OrgId1 != "") then
				CUST.HOCCM.OrgId2 = GETPOSITION(CUST.HOCCM.Response,"</ScanData>")
				print(CUST.HOCCM.OrgId2)
				CUST.HOCCM.ScanData= mid$(CUST.HOCCM.Response,cint(CUST.HOCCM.OrgId1)+9,cint(CUST.HOCCM.OrgId2)-cint(CUST.HOCCM.OrgId1)-10)
				print(CUST.HOCCM.ScanData)
			else
				CUST.HOCCM.ScanData = ""
			endif
		else
			CUST.HOCCM.ResDesc1 = GETPOSITION(CUST.HOCCM.Response,"<ResDesc>")
			print(CUST.HOCCM.ResDesc1)
			if (CUST.HOCCM.ResDesc1 != "") then
				CUST.HOCCM.ResDesc2 = GETPOSITION(CUST.HOCCM.Response,"</ResDesc>")
				print(CUST.HOCCM.ResDesc2)
				CUST.HOCCM.ResDesc= mid$(CUST.HOCCM.Response,cint(CUST.HOCCM.ResDesc1)+8,cint(CUST.HOCCM.ResDesc2)-cint(CUST.HOCCM.ResDesc1)-9)
				print(CUST.HOCCM.ResDesc)
			else
				CUST.HOCCM.ResDesc = ""
			endif	
			CUST.HOCCM.ResCode1 = GETPOSITION(CUST.HOCCM.Response,"<ResCode>")
			print(CUST.HOCCM.ResCode1)
			if (CUST.HOCCM.ResCode1 != "") then
				CUST.HOCCM.ResCode2 = GETPOSITION(CUST.HOCCM.Response,"</ResCode>")
				print(CUST.HOCCM.ResCode2)
				CUST.HOCCM.ResCode= mid$(CUST.HOCCM.Response,cint(CUST.HOCCM.ResCode1)+8,cint(CUST.HOCCM.ResCode2)-cint(CUST.HOCCM.ResCode1)-9)
				print(CUST.HOCCM.ResCode)
			else
				CUST.HOCCM.ResCode = ""
			endif

		endif
		print(BANCS.OUTPARAM.ErrMsg)
	else
		print(BANCS.OUTPARAM.ErrMsg)
		GOTO ENDOFSCRIPT
	endif
	if(CUST.HOCCM.ScanData!="")then
		sv_w = "SuccessOrFailure|Y"
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
		sv_w = "ScanResp|" + CUST.HOCCM.ScanData 
		print(sv_w)
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
	endif
	if((CUST.HOCCM.ServiceStatus!="SUCCESS") and (CUST.HOCCM.ServiceStatus!=""))then
                sv_w = "SuccessOrFailure|F"
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
                sv_w = "ScanResp|" + CUST.HOCCM.ServiceStatus 
                print(sv_w)
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
	endif
        if((CUST.HOCCM.ProcessStatus!="SUCCESS") and (CUST.HOCCM.ProcessStatus!=""))then
                sv_w = "SuccessOrFailure|F"
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
                sv_w = "ScanResp|" + CUST.HOCCM.ProcessStatus 
                print(sv_w)
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
        endif
        if((CUST.HOCCM.ResDesc!="SUCCESS") and (CUST.HOCCM.ResDesc!=""))then
                sv_w = "SuccessOrFailure|F"
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
                sv_w = "ScanResp|" + CUST.HOCCM.ResDesc 
                print(sv_w)
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
        endif
        if((CUST.HOCCM.ResCode!="SUCCESS") and (CUST.HOCCM.ResCode!=""))then
                sv_w = "SuccessOrFailure|F"
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
                sv_w = "ScanResp|" + CUST.HOCCM.ResCode 
                print(sv_w)
                sv_u = urhk_SetOrbOut(sv_w)
                print(sv_u)
        endif
ENDOFSCRIPT:
        exitscript
end-->
