<--START
CHECKSUM="a77aac4cde1e41579e06d153f5aeac940721362704c55b52d3114661c78d1140"
	TRACE ON
	
	PRINT(CUST.CIECLG.zoneCode)
	PRINT(CUST.CIECLG.zoneDate)
	PRINT(CUST.CIECLG.setNum)
	PRINT(CUST.CIECLG.zoneCcy)
	
	##################################################################################
	# Fetch SRV
	##################################################################################
	
	sv_u = urhk_SetUrhkInp("zoneHeader.zoneCode|"+CUST.CIECLG.zoneCode)
	sv_s = CUST.CIECLG.zoneDate + " 00:00:00"
	sv_u = urhk_SetUrhkInp("zoneHeader.zoneDate|"+sv_s)
	sv_u = urhk_SetUrhkInp("zoneHeader.solId.solId|"+BANCS.STDIN.mySolId)
	sv_u = urhk_SetUrhkInp("setInfo.setNum|"+CUST.CIECLG.setNum)
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchOcSetForRelReg|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	##################################################################################
	# Copy Out To In With Diff Struct
	##################################################################################
	
	BANCS.INPARAM.SourceStr= ""
	BANCS.INPARAM.ReplaceStr= "ocSet"
	
	sv_u = urhk_CopyOutToInDiffStruct("")
	print(sv_u)
	
	##################################################################################
	# Release OC Set SRV
	##################################################################################
	
	sv_u = urhk_SetUrhkOut("tranObject.tranIdentifier.tranId|tranId")
	sv_u = urhk_SetUrhkOut("tranObject.tranIdentifier.tranDate|tranDate")
	sv_u = urhk_SetUrhkOut("tranObject.pstFlg|tranPstFlg")
	sv_u = urhk_ExecSrvNoCommit("SRV_ReleaseOcSet|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	CUST.CIECLG.tranId = BANCS.OUTPARAM.tranId
	PRINT(CUST.CIECLG.tranId)
	CUST.CIECLG.tranDate = BANCS.OUTPARAM.tranDate
	PRINT(CUST.CIECLG.tranDate)
	CUST.CIECLG.tranPstFlg = BANCS.OUTPARAM.tranPstFlg
	PRINT(CUST.CIECLG.tranPstFlg)
	
	##################################################################################
	# Fetch Tran Details for Posting
	##################################################################################
	
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranId|" + CUST.CIECLG.tranId)
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + CUST.CIECLG.tranDate)
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchTranDtlsForPost|retain_all_output = Y")
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_u = urhk_CopyOutToIn("")
	
	##################################################################################
	# Post Tran
	##################################################################################
	
	sv_u = urhk_SetUrhkOut("tranHdr.status|status")
	sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y|call_mode = N")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
END-->
