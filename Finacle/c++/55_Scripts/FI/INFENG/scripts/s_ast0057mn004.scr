#-------------------------------------------------------------------------------------    
#	Name			: s_ast0057mn004.scr
#	Description		: This script is used for inserting required data into custom table during disbursement
#	Date			: 13-06-2013
#	Author			: Prashanth
#	Input			: NA
#	Output			: NA
#	Called Script		: SRV_InsertDisbData_post_process_data.scr
#	Calling Script	:
#	Menu Option		: HLADISB
#	Srl. No		Date			Author			Description.
#	-------		----			------			----------------
#	1.0			13-06-2013		Prashanth		Original Version
#	2.0			10-07-2013		Bharath			Skip for reversal added
#	3.0			22-10-2013		Bharath			Field exists check added
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="8f6392ee35945854502b5b9dc32bd5ae60e0018687a27b4e630bd08bc81529e0"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	CUST.LADISB.errMsg = ""
	CUST.LADISB.totAmt = 0
	IF(BANCS.STDIN.menuId=="HLADISB") THEN
	#{
		
		#------------------------------------------------------------------------------
		# Exitscript if function code is Reversal
		#------------------------------------------------------------------------------
		sv_b = urhk_SRV_GetVal("acctDisburseTranLA.reversalTranId")
		CUST.LADISB.reversalTran = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.reversalTran)
		IF (CUST.LADISB.reversalTran != "") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Getting foracid from from frontend
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("acctDisburseTranLA.tranId")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			print(BANCS.OUTPARAM.srvValue)
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Getting foracid from from frontend
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.LADISB.foracid = BANCS.OUTPARAM.srvValue
			print(CUST.LADISB.foracid)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error: urhk_SRV_GetVal failed for foracid"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Getting schmCode from from frontend
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("acctDisburseTranLA.schmCode.schmCode")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.LADISB.schmCode = BANCS.OUTPARAM.srvValue
			PRINT(CUST.LADISB.schmCode)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error: urhk_SRV_GetVal failed for schmCode"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#--------------------------------------------------------------------------
		# Calculate the count of foracid's under same cif_id,schemeCode
		#--------------------------------------------------------------------------
		sv_s = ""
		sv_s = "count|"
		sv_s = sv_s + " SELECT COUNT(*)"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE GAM.schm_code = ?SVAR"
		sv_s = sv_s + " AND GAM.cif_id = ("
		sv_s = sv_s +			   	" SELECT GAM.cif_id"
		sv_s = sv_s +	                 	" FROM TBAADM.GAM"
		sv_s = sv_s +			   	" WHERE GAM.foracid = ?SVAR"
		sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
		sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
		sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
		sv_s = sv_s +			   	" AND GAM.bank_id = ?SVAR)"
		sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
		sv_s = sv_s + " AND GAM.del_flg = 'N'"
		sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
		sv_s = sv_s + " AND GAM.foracid != ?SVAR"
		sv_s = sv_s + " AND GAM.clr_bal_amt != 0"
		
		BANCS.INPARAM.BINDVARS = ""
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.schmCode + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid  + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid
		print(BANCS.INPARAM.BINDVARS)
		
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		
		IF ( sv_d != 0 ) THEN
		#{
			CUST.LADISB.errMsg = "Error occured in calculating count of old loan foracid's"
			PRINT(CUST.LADISB.errMsg)
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.count = BANCS.OUTPARAM.count
			print(CUST.LADISB.count)
		#}
		ENDIF
		
		IF(CUST.LADISB.count > 0) THEN
		#{
			CUST.LADISB.payofflag = ""
			print(ONS.CUSTOM.custDataIn)
			IF(STRLEN(ONS.CUSTOM.custDataIn) > 0) THEN
			#{
				sv_d = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)
				IF(FIELDEXISTS(BANCS.INPUT.ladisb_tran_details_FIELD_1) == 1) THEN
				#{
					CUST.LADISB.payofflag = BANCS.INPUT.ladisb_tran_details_FIELD_1
					print(CUST.LADISB.payofflag)
					#}
				ELSE
					#{
					#CUST.LADISB.errMsg = "error getting in payofflag from CUSTDATAIN "
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			#---------------------------------------------------------------
			# when selecting 'YES' option in drop down box of old loan payoff
			#----------------------------------------------------------------
			IF(CUST.LADISB.payofflag == "Y") THEN
			#{
				#-----------------------------------------------------------------------------------------------
				#Getting rateCode from CPARAM values--'NOR'
				#-----------------------------------------------------------------------------------------------
				BANCS.INPUT.moduleName = "GENERAL"
				BANCS.INPUT.parameterId = "NORRATECODE"
				
				CALL ("getcparamvalue.scr")
				print(BANCS.OUTPUT.parameterVal)
				
				IF (BANCS.OUTPUT.parameterVal != "")THEN
				#{
					CUST.LADISB.limitRateCode = BANCS.OUTPUT.parameterVal
					print(CUST.LADISB.limitRateCode)
					#}
				ELSE
					#{
					CUST.LADISB.errMsg = "NORRATECODE setup not done in CPARAM"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				IF (FIELDEXISTS(CUST.LADISB.crdOpAcctNum) == 0) THEN
				#{
					IF(STRLEN(ONS.CUSTOM.custDataIn) > 0) THEN
					#{
						sv_d = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)
						IF(FIELDEXISTS(BANCS.INPUT.ladisbdet_FIELD_2) == 1) THEN
						#{
							CUST.LADISB.crdOpAcctNum = BANCS.INPUT.ladisbdet_FIELD_2
							print(CUST.LADISB.crdOpAcctNum)
							#}
						ELSE
							#{
							CUST.LADISB.errMsg = "error getting in crdOpAcctNum from CUSTDATAIN "
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				
				#--------------------------------------------------------------------
				#getting Operative Account currency code
				#--------------------------------------------------------------------
				sv_s = ""
				sv_s = "OprAcctCrncyCode|SELECT GAM.acct_crncy_code "
				sv_s = sv_s + "FROM TBAADM.GAM "
				sv_s = sv_s + "WHERE GAM.foracid = ?SVAR "
				sv_s = sv_s + "AND GAM.bank_id = ?SVAR"
				
				print(sv_s)
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.crdOpAcctNum + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				print(sv_d)
				
				IF ( sv_d != 0 ) THEN
				#{
					CUST.LADISB.errMsg = "Error occured in getting account currency code"
					print(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CUST.LADISB.OprAcctCrncyCode= BANCS.OUTPARAM.OprAcctCrncyCode
					print(BANCS.OUTPARAM.OprAcctCrncyCode)
				#}
				ENDIF
				
				sv_a = 1
				#--------------------------------------------------------------------------
				# Selecting accounts, clearBalAmount  from GAM
				#--------------------------------------------------------------------------
				sv_s = ""
				sv_s = "oldForacid,acid,clrBalAmt,oldLoanCrncyCode|"
				sv_s = sv_s + " SELECT GAM.foracid,GAM.acid,GAM.clr_bal_amt,GAM.acct_crncy_code"
				sv_s = sv_s + " FROM TBAADM.GAM "
				sv_s = sv_s + " WHERE GAM.schm_code = ?SVAR"
				sv_s = sv_s + " AND GAM.cif_id = ("
				sv_s = sv_s +			   	" SELECT GAM.cif_id"
				sv_s = sv_s +				" FROM TBAADM.GAM"
				sv_s = sv_s +				" WHERE GAM.foracid = ?SVAR"
				sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
				sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
				sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
				sv_s = sv_s +			   	" AND GAM.bank_id = ?SVAR)"
				sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
				sv_s = sv_s + " AND GAM.del_flg = 'N'"
				sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + " AND GAM.clr_bal_amt != 0"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
				sv_s = sv_s + " AND GAM.foracid != ?SVAR"
				
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.schmCode + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid  + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid
				print(BANCS.INPARAM.BINDVARS)
				
				print(sv_s)
				sv_c = urhk_dbcursorOpenWithBind(sv_s)
				print(sv_c)
				
				IF( sv_c != 0) THEN
				#{
					CUST.LADISB.errMsg = "No records fetched for the entered Account Number"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
					print(sv_l)
					sv_c = urhk_dbCursorFetch(sv_l)
					print(sv_c)
					
					WHILE( sv_c == 0)
					#{
						CUST.LADISB.oldForacid=BANCS.OUTPARAM.oldForacid
						print(CUST.LADISB.oldForacid)
						
						CUST.LADISB.acid = BANCS.OUTPARAM.acid
						print(CUST.LADISB.acid)
						
						CUST.LADISB.clrBalAmt = BANCS.OUTPARAM.clrBalAmt
						print(CUST.LADISB.clrBalAmt)
						
						CUST.LADISB.oldLoanCrncyCode = BANCS.OUTPARAM.oldLoanCrncyCode
						print(CUST.LADISB.oldLoanCrncyCode)
						#CUST.LADISB.count = sv_a
						
						#--------------------------------------------------------------------------------------
						# getting Int route flag from LAM table
						#--------------------------------------------------------------------------------------
						sv_s = ""
						sv_s = sv_s + " intRoute|"
						sv_s = sv_s + " SELECT LAM.int_route_flg"
						sv_s = sv_s + "	FROM TBAADM.LAM"
						sv_s = sv_s + " WHERE LAM.acid ="
						sv_s = sv_s + 			" (SELECT GAM.ACID"
						sv_s = sv_s + 			" FROM TBAADM.GAM"
						sv_s = sv_s + 			" WHERE GAM.FORACID = ?SVAR"
						sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
						sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
						sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
						sv_s = sv_s + 			" AND GAM.bank_id = ?SVAR)"
						sv_s = sv_s + " AND LAM.del_flg='N'"
						sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
						sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
						
						print(sv_s)
						BANCS.INPARAM.BINDVARS = ""
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldForacid + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
						
						print(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbselectWithBind(sv_s)
						print(sv_d)
						
						IF ( sv_d != 0 ) THEN
						#{
							CUST.LADISB.errMsg = "Error occured in calculating old Loan O/S amount"
							print(CUST.LADISB.errMsg)
							GOTO ENDOFSCRIPT
							#}
						ELSE
							#{
							CUST.LADISB.intRoute = BANCS.OUTPARAM.intRoute
							print(CUST.LADISB.intRoute)
						#}
						ENDIF
						
						#--------------------------------------------------------------------------------------
						#getting interest amt through loan a/c's
						#--------------------------------------------------------------------------------------
						IF(CUST.LADISB.intRoute == "L") THEN
						#{
							sv_s = "interest|"
							sv_s = sv_s + " SELECT"
							sv_s = sv_s + " (nvl(nrml_interest_amount_dr"
							sv_s = sv_s + " - nrml_booked_amount_dr,0) +"
							sv_s = sv_s + " nvl(penal_interest_amount_dr"
							sv_s = sv_s + " -penal_booked_amount_dr,0))"
							sv_s = sv_s + " FROM TBAADM.EIT"
							sv_s = sv_s + " WHERE EIT.entity_id = ?SVAR"
							sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
							sv_s = sv_s + " AND EIT.bank_id = ?SVAR"
							
							BANCS.INPARAM.BINDVARS = ""
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
							
							sv_q = urhk_dbSelectWithBind(sv_s)
							CUST.LADISB.interest = BANCS.OUTPARAM.interest
							print(CUST.LADISB.interest)
							
							#}
						ELSE
							#{
							sv_s = "interest|"
							sv_s = sv_s + " SELECT"
							sv_s = sv_s + " (nvl(nrml_interest_amount_dr"
							sv_s = sv_s + " - nrml_booked_amount_dr,0) +"
							sv_s = sv_s + " nvl(penal_interest_amount_dr"
							sv_s = sv_s + " -penal_booked_amount_dr,0)"
							sv_s = sv_s + " + nvl(LAM.INT_DMD_OS,0)"
							sv_s = sv_s + " + nvl(LAM.BCHG_DMD_OS,0)"
							sv_s = sv_s + " + nvl(LAM.OCHG_DMD_OS,0))"
							sv_s = sv_s + " FROM TBAADM.EIT,TBAADM.LAM"
							sv_s = sv_s + " WHERE EIT.entity_id = ?SVAR"
							sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
							sv_s = sv_s + " AND EIT.bank_id = ?SVAR"
							sv_s = sv_s + " AND LAM.acid = ?SVAR"
							sv_s = sv_s + " AND LAM.del_flg='N'"
							sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
							sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
							
							BANCS.INPARAM.BINDVARS = ""
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
							
							sv_q = urhk_dbSelectWithBind(sv_s)
							CUST.LADISB.interest = BANCS.OUTPARAM.interest
							print(CUST.LADISB.interest)
							
						#}
						ENDIF
						CUST.LADISB.totAmt = CDOUBLE(CUST.LADISB.clrBalAmt) + CDOUBLE(CUST.LADISB.interest)
						print(CUST.LADISB.totAmt)
						IF(CDOUBLE(CUST.LADISB.totAmt) < 0) THEN
						#{
							CUST.LADISB.totAmt = -1 * CDOUBLE(CUST.LADISB.totAmt)
							print(CUST.LADISB.totAmt)
							#}
						ELSE
							#{
							print(CUST.LADISB.totAmt)
						#}
						ENDIF
						
						#--------------------------------
						# for testing
						#--------------------------------
						#CUST.LADISB.OprAcctCrncyCode = "USD"
						
						#------------------------------------------------------------------------------
						#	If currency codes are different, Convert Amount
						#------------------------------------------------------------------------------
						IF(CUST.LADISB.oldLoanCrncyCode!=CUST.LADISB.OprAcctCrncyCode) THEN
						#{
							BANCS.INPARAM.InputAmount = CUST.LADISB.totAmt
							BANCS.INPARAM.FromCurrency = CUST.LADISB.oldLoanCrncyCode
							BANCS.INPARAM.ToCurrency = CUST.LADISB.OprAcctCrncyCode
							BANCS.INPARAM.RateCode = CUST.LADISB.limitRateCode
							BANCS.INPARAM.Rate = 0.00
							BANCS.INPARAM.CustId = ""
							
							sv_u = urhk_B2k_ConvertAmount("")
							print(sv_u)
							
							IF(sv_u == 0)THEN
							#{
								CUST.LADISB.operativeConvAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
								print(CUST.LADISB.operativeConvAmt)
								
								IF(CDOUBLE(CUST.LADISB.operativeConvAmt) < 0) THEN
								#{
									CUST.LADISB.operativeConvAmt = -1 * CDOUBLE(CUST.LADISB.operativeConvAmt)
									print(CUST.LADISB.operativeConvAmt)
									#}
								ELSE
									#{
									print(CUST.LADISB.operativeConvAmt)
								#}
								ENDIF
								#}
							ELSE
								#{
								CUST.LADISB.errMsg = "Error occured in converting the Amount"
								PRINT(CUST.LADISB.errMsg)
								GOTO ENDOFSCRIPT
							#}
							ENDIF
							#}
						ELSE
							#{
							CUST.LADISB.operativeConvAmt = CUST.LADISB.totAmt
							print(CUST.LADISB.operativeConvAmt)
						#}
						ENDIF
						
						IF(CUST.LADISB.totAmt != 0) THEN
						#{
							CUST.LADISB.count = sv_a
							#-----------------------------------------------------------------------------
							# Inserting rows into LADISB_PAYOFF_OLDLOAN custom table
							#-----------------------------------------------------------------------------
							sv_s = "INSERT INTO CUSTOM.C_LADISB_PAYOFF_OLDLOAN("
							sv_s = sv_s + " srno,loan_foracid,loan_op_foracid,"
							sv_s = sv_s + " la_op_amt,la_op_crncy_code,old_foracid,"
							sv_s = sv_s + " old_la_amt,old_la_crncy_code,payoff_flg,"
							sv_s = sv_s + " del_flg,entity_cre_flg,rcre_time,"
							sv_s = sv_s + " lchg_user_id,rcre_user_id,lchg_time,bank_id)"
							sv_s = sv_s + " VALUES ("
							sv_s = sv_s + "?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",'N'"
							sv_s = sv_s + ",'N'"
							sv_s = sv_s + ",sysdate"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ",sysdate"
							sv_s = sv_s + ",?SVAR"
							sv_s = sv_s + ")"
							print(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.LADISB.count + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.crdOpAcctNum + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.operativeConvAmt + "|"
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.OprAcctCrncyCode + "|"
