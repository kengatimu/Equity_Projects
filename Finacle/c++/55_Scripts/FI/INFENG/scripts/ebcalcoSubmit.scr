        lv_i = lv_i + " and entity_cre_flg = 'Y' ) "
        print(lv_i)
        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.LowLimR6 + "|" + EBSRV.GLBDATA.HighLimR6 + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" + EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays + "|" + EBSRV.GLBDATA.LowLim6 + "|" + EBSRV.GLBDATA.HighLim6
        print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbSqlWithBind(lv_i)
endif

	EBSRV.GLBDATA.resMsg = "ALCO Rate Modified Successfully for " + EBSRV.GLBDATA.CrncyCode 
	
	GOTO ERR_RES
#}
endif
if(EBSRV.GLBDATA.funcCode == "V") then
#{
	callscriptifexist("ebcalcoVerify.scr")
	GOTO ERR_RES
#}
endif
if(EBSRV.GLBDATA.funcCode == "X") then
#{
	callscriptifexist("ebcalcoCancel.scr")
	GOTO ERR_RES
#}
endif
ERR_RES:
	if(EBSRV.GLBDATA.errMsg != "") then
		lv_e = urhk_SetOrbErr(EBSRV.GLBDATA.errMsg)
		GOTO ENDOFSCRIPT
	else
		if(EBSRV.GLBDATA.resMsg != "") then
			lv_a = urhk_dbSQLWithBind("COMMIT")
			print(lv_a)
			if(lv_a == 0) then
				lv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
				lv_b = urhk_SetOrbOut("RESULT_MSG|" +EBSRV.GLBDATA.resMsg)
			else
				lv_e = urhk_SetOrbErr("Error in Saving Data")
				GOTO ENDOFSCRIPT
			endif
		endif
	endif
ENDOFSCRIPT:
	callscriptifexist("ebRepClean.scr")
        EXITSCRIPT

trace off
end-->
