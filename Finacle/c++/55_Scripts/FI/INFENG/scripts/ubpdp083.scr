#-------------------------------------------------------------------------------------------------------------
# Filename              :       ubpdp083.scr
# Author                :       Pankaj Gaur
# Description           :       This script autopopulate the biller id based on a/c number and to validate both
# Input                 :       CrAcctNum or billerId
# Output                :       billerId,CrAcctNum.
# Called Script         :       None
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           22-10-2013         Pankaj Gaur	    original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="9c3dccf9c686d3caac4374c9555e031dcd6021fffeb6c11a64265cecaf740075"
	
	TRACE ON
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	#========================================================
	# Check whether CUST Repository exists else create it
	#========================================================
	sv_r = REPEXISTS("CUST")
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	#========================================================
	# Check whether UBP Class exists else create it
	#========================================================
	sv_r = CLASSEXISTS("CUST","UBP")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","UBP",5)
	#}
	ENDIF
	#========================================================
	# Initialize the variables
	#========================================================
	
	CUST.UBP.billerId1 = ""
	CUST.UBP.critCrAcctNumUbp = ""
	CUST.UBP.billAcctId1 = ""
	CUST.UBP.errorFlg1="N"
	CUST.UBP.errorMsg1=""
	CUST.UBP.valType1=" "
	CUST.UBP.ubpCounter="N"
	CUST.UBP.flg = ""
	
	IF(FIELDEXISTS(BANCS.INPUT.critCrAcctNumUbp))THEN
	#{
		IF(TRIM(BANCS.INPUT.critCrAcctNumUbp) != "")THEN
		#{
			CUST.UBP.critCrAcctNumUbp = TOUPPER(TRIM(BANCS.INPUT.critCrAcctNumUbp))
			PRINT(CUST.UBP.critCrAcctNumUbp)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.UBP.errorFlg1 = "Y"
		CUST.UBP.errorMsg1 = "Unable to get CR Account Number"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.billerId))THEN
	#{
		IF(TRIM(BANCS.INPUT.billerId) != "")THEN
		#{
			CUST.UBP.billerId1 = TOUPPER(TRIM(BANCS.INPUT.billerId))
			PRINT(CUST.UBP.billerId1)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.UBP.errorFlg1 = "Y"
		CUST.UBP.errorMsg1 = "Unable to get Biller Id"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF((CUST.UBP.critCrAcctNumUbp == "") AND (CUST.UBP.billerId1==""))THEN
	#{
		CUST.UBP.errorFlg1 = "Y"
		CUST.UBP.errorMsg1 = "Either Biller Id OR Credit account number should be entered"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#========================================================
	# Fetching tthe values from BRGT table and populating
	# the searcher list
	#========================================================
	IF((CUST.UBP.critCrAcctNumUbp != "") AND (CUST.UBP.billerId1!=""))THEN
	#{
		CUST.UBP.flg = "Y"
		BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNumUbp+"|"+CUST.UBP.billerId1+"|Y|N"
		print(BANCS.INPARAM.BINDVARS)
	#}
	ENDIF
	
	IF(CUST.UBP.flg !="Y") THEN
	#{
		IF(CUST.UBP.critCrAcctNumUbp != "") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNumUbp+"|Y|N"
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF

		sv_g  = MID$(CUST.UBP.critCrAcctNumUbp, 0,2)
		IF ( sv_g == "99") THEN
			sv_k = MID$(CUST.UBP.critCrAcctNumUbp, 2,3)
			print (sv_k)

			sv_s = "billAcctId|"
			sv_s = sv_s + " SELECT FREE_TEXT1 "
			sv_s = sv_s + " FROM TBAADM.BRGT "
			sv_s = sv_s + " WHERE biller_id=?SVAR"

			BANCS.INPARAM.BINDVARS = sv_k
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d == 0)THEN

				CUST.UBP.critCrAcctNumUbp = BANCS.OUTPARAM.billAcctId
				print (CUST.UBP.critCrAcctNumUbp)

				BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNumUbp+"|Y|N"
				PRINT(BANCS.INPARAM.BINDVARS)
			ELSE
				CUST.UBP.errorFlg1 = "Y"
				CUST.UBP.errorMsg1 ="No Biller Setup for Ref Number"
				GOTO ENDOFSCRIPT
				
			ENDIF
		ENDIF
		
		IF(CUST.UBP.billerId1 != "") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.UBP.billerId1+"|Y|N"
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s = "count1|"
	sv_s = sv_s + " SELECT count(1)"
	sv_s = sv_s + " FROM TBAADM.BRGT "
	IF((CUST.UBP.critCrAcctNumUbp != "") OR (CUST.UBP.flg == "Y")) THEN
	#{
		sv_s = sv_s + " WHERE FREE_TEXT1=?SVAR"
		#sv_s = sv_s + " AND FREE_TEXT2 =?SVAR"
	#}
	ENDIF
	
	
	IF(CUST.UBP.billerId1 != "") THEN
	#{
		IF(CUST.UBP.flg == "Y") THEN
		#{
			sv_s = sv_s + "  AND"
			#}
		ELSE
			#{
			sv_s = sv_s + "  WHERE"
		#}
		ENDIF
		
	#}
	ENDIF
	
	IF((CUST.UBP.billerId1 != "") OR (CUST.UBP.flg == "Y")) THEN
	#{
		sv_s = sv_s + "  BILLER_ID=?SVAR"
	#}
	ENDIF
	sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
	sv_s = sv_s + " AND FREE_TEXT1 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT2 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT4 IS NOT NULL"
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d != 0)THEN
	#{
		#Error Handling
		
		CUST.UBP.errorFlg1 = "Y"
		#CUST.UBP.errorMsg1 = "Enter a valid Biller Id"
		CUST.UBP.errorCode = "UBP_ERR001"
		CALL("ubpdp044.scr")
		CUST.UBP.errorMsg1 =CUST.UBP.errorDesc
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.UBP.count1 = BANCS.OUTPARAM.count1
		PRINT(CUST.UBP.count1)
		IF(CUST.UBP.count1==0)THEN
		#{
			CUST.UBP.errorFlg1 = "Y"
			CUST.UBP.errorMsg1 ="Account is not registered to any Biller"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.UBP.ubpCounter="Y"
	#}
	ENDIF
	#========================================================
	# Fetching tthe values from BRGT table and populating
	# the searcher list
	#========================================================
	IF((CUST.UBP.critCrAcctNumUbp != "") AND (CUST.UBP.billerId1!=""))THEN
	#{
		CUST.UBP.flg = "Y"
		BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNumUbp+"|"+CUST.UBP.billerId1+"|Y|N"
		
	#}
	ENDIF
	
	IF(CUST.UBP.flg !="Y") THEN
	#{
		IF(CUST.UBP.critCrAcctNumUbp != "") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNumUbp+"|Y|N"
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
		
		IF(CUST.UBP.billerId1 != "") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.UBP.billerId1+"|Y|N"
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s = "billerId,billAcctId,bankId,chgEvetId,valType|"
	sv_s = sv_s + " SELECT BILLER_ID,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,FREE_TEXT4"
	sv_s = sv_s + " FROM TBAADM.BRGT "
	IF((CUST.UBP.critCrAcctNumUbp != "") OR (CUST.UBP.flg == "Y")) THEN
	#{
		sv_s = sv_s + " WHERE FREE_TEXT1=?SVAR"
		#sv_s = sv_s + " AND FREE_TEXT2 =?SVAR"
	#}
	ENDIF
	
	IF(CUST.UBP.billerId1 != "") THEN
	#{
		IF(CUST.UBP.flg == "Y") THEN
		#{
			sv_s = sv_s + "  AND"
			#}
		ELSE
			#{
			sv_s = sv_s + "  WHERE"
		#}
		ENDIF
		
	#}
	ENDIF
	
	IF((CUST.UBP.billerId1 != "") OR (CUST.UBP.flg == "Y")) THEN
	#{
		sv_s = sv_s + "  BILLER_ID=?SVAR"
	#}
	ENDIF
	sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
	sv_s = sv_s + " AND FREE_TEXT1 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT2 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT4 IS NOT NULL AND rownum =1"
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d != 0)THEN
	#{
		#Error Handling
		
		CUST.UBP.errorFlg1 = "Y"
		#CUST.UBP.errorMsg1 = "Enter a valid Biller Id"
		CUST.UBP.errorCode = "UBP_ERR001"
		CALL("ubpdp044.scr")
		CUST.UBP.errorMsg1 =CUST.UBP.errorDesc
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.UBP.billerId1 = BANCS.OUTPARAM.billerId
		PRINT(CUST.UBP.billerId1)
		CUST.UBP.billAcctId1 = BANCS.OUTPARAM.billAcctId
		PRINT(CUST.UBP.billAcctId1)
		CUST.UBP.bankId = BANCS.OUTPARAM.bankId
		PRINT(CUST.UBP.bankId)
		CUST.UBP.valType1 = BANCS.OUTPARAM.valType
		PRINT(CUST.UBP.valType1)
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		IF(CUST.UBP.errorFlg1!="") THEN
		#{
			sv_s = "errorFlg|" + CUST.UBP.errorFlg1
			PRINT(sv_s)
			
			#}
		ELSE
			#{
			sv_s = "errorFlg|NULL"
			PRINT(sv_s)
		#}
		ENDIF
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		IF(CUST.UBP.errorMsg1!="") THEN
		#{
			sv_s = "errorMsg|" + CUST.UBP.errorMsg1
			PRINT(sv_s)
			#}
		ELSE
			#{
			sv_s = "errorMsg|NULL"
			PRINT(sv_s)
		#}
		ENDIF
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		IF(CUST.UBP.billAcctId1!="") THEN
		#{
			sv_s = "critCrAcctNum|" + CUST.UBP.billAcctId1
			PRINT(sv_s)
			#}
		ELSE
			#{
			sv_s = "critCrAcctNum|NULL"
			PRINT(sv_s)
		#}
		ENDIF
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		IF(CUST.UBP.billAcctId1!="") THEN
		#{
			sv_s = "valType|" + CUST.UBP.valType1
			PRINT(sv_s)
			#}
		ELSE
			#{
			sv_s = "valType|NULL"
			PRINT(sv_s)
		#}
		ENDIF
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		IF(CUST.UBP.billAcctId1!="") THEN
		#{
			sv_s = "ubpCounter|" + CUST.UBP.ubpCounter
			PRINT(sv_s)
			#}
		ELSE
			#{
			sv_s = "ubpCounter|NULL"
			PRINT(sv_s)
		#}
		ENDIF
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		IF(CUST.UBP.billerId1!="") THEN
		#{
			sv_s = "billerId|" + CUST.UBP.billerId1
			PRINT(sv_s)
			#}
		ELSE
			#{
			sv_s = "billerId|NULL"
			PRINT(sv_s)
		#}
		ENDIF
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
END-->
