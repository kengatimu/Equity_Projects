<--START
#TRACE ON

	#--------------------------------------------------------------------------
	# Initialise Repository
	#--------------------------------------------------------------------------
	IF (REPEXISTS("CUST")==0)THEN
		CREATEREP("CUST")
	ENDIF
	IF(CLASSEXISTS("CUST","DATA")==0)then
		CREATECLASS("CUST","DATA",5)
	ENDIF

	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif

	IF (FIELDEXISTS(BANCS.INPUT.TranId) == 1) THEN
		print(BANCS.INPUT.TranId)
		print(BANCS.STDIN.serviceName)
		print(BANCS.INPUT.TranCrncyCode)
				
	ELSE
		#BANCS.INPUT.TranId="xxxxx"
	ENDIF

	IF (FIELDEXISTS(BANCS.OUTPUT.PartTranType) == 1) THEN
		print(BANCS.OUTPUT.PartTranType)
	ELSE
		print("Nothing")
	ENDIF

	IF (FIELDEXISTS(BANCS.INPUT.Foracid) == 1) THEN
		print(BANCS.INPUT.Foracid)
		CUST.DATA.trgforacid = BANCS.INPUT.Foracid
		print(CUST.DATA.trgforacid)
	ELSE
		print("Nothing")
	ENDIF

	IF (FIELDEXISTS(BANCS.INPUT.TranAmt) == 1) THEN
		print(BANCS.INPUT.TranAmt)
	ELSE
		print("Nothing")
	ENDIF
	

	##############################################
	#Insert Debit Alerts done with overdraft #####
	##############################################

		IF(BANCS.STDIN.exeName == "babx4016") THEN
		#{
			PRINT("Success")
		#}
		ELSE
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
				
		sv_s = "trgacid,AccontName,cifid,trgforacid|"
		sv_s = sv_s + " select acid,acct_name,cif_id,foracid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR and del_flg='N' and acct_cls_flg='N' and schm_type in('ODA')"
		sv_s = sv_s + " and cif_id in(select cif_id from tbaadm.gam where schm_code in ('OD548') and clr_bal_amt <=0) "
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.trgforacid
		print(BANCS.INPARAM.BINDVARS)
	
		sv_e = urhk_dbSelectWithBind(sv_s)
		print(sv_e)
	
		if(sv_e == 0) THEN
		CUST.DATA.trgacid= BANCS.OUTPARAM.trgacid
		PRINT(CUST.DATA.trgacid)
		CUST.DATA.trgforacid= BANCS.OUTPARAM.trgforacid
		PRINT(CUST.DATA.trgforacid)
		CUST.DATA.AccontName= BANCS.OUTPARAM.AccontName
		PRINT(CUST.DATA.AccontName)
		CUST.DATA.cifid= BANCS.OUTPARAM.cifid
		PRINT(CUST.DATA.cifid)
		CUST.DATA.Amount = BANCS.INPUT.TranAmt
		print(CUST.DATA.Amount)
		CUST.DATA.Amount1="1.2"
		CUST.DATA.Amount2=(CDOUBLE(CUST.DATA.Amount1) * CDOUBLE(CUST.DATA.Amount))/100
		CUST.DATA.Amount=(CDOUBLE(CUST.DATA.Amount) + CDOUBLE(CUST.DATA.Amount2))

		print(CUST.DATA.Amount)
		else
			GOTO ENDOFSCRIPT
		endif
			
		#IF (CUST.DATA.partTranType == "D") THEN

		#{

		sv_i = "INSERT INTO CUSTOM.ODSME_BOOK (TRAN_ID,ACID, FORACID, ACCT_NAME,BANK_ID,RCRE_TIME,TOT_AMOUNT,ADJ_AMOUNT,COLLECTED,DPD_COUNTER)"
		sv_i = sv_i + " VALUES (?SVAR, ?SVAR, ?SVAR, ?SVAR,?SVAR,SYSDATE,?SVAR,'0','N','0')"
		print (sv_i)
		
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.TranId +"|"+ CUST.DATA.trgacid +"|"+ CUST.DATA.trgforacid +"|"+ CUST.DATA.AccontName +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.Amount
		Print(BANCS.INPARAM.BINDVARS)

		sv_i = urhk_dbSqlWithBind(sv_i)
		print (sv_i)
		
		#}
		#ENDIF
ENDOFSCRIPT:
#IF((BANCS.STDIN.menuId == "HOCCM") AND (BANCS.STDIN.serviceName== "SRV_ReleaseOcSet") AND (BANCS.INPUT.TranCrncyCode !="KES")) THEN
