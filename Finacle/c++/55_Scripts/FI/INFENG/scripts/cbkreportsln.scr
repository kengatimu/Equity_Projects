<--START
TRACE ON
#-----------------------------------------------------------------------------------------------
# CREATING NEW REPOSITORY AND CLASS
#-----------------------------------------------------------------------------------------------

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
#{
	CREATECLASS("CUST", "DATA", 5)
#}
ENDIF

#---------------------------------------------------------------------------------
# Initialinzing required variables
#---------------------------------------------------------------------------------
sv_k = 0
CUST.DATA.RET = "0"
CUST.DATA.successOrFailure = "S"

CUST.DATA.solID1="000"

CUST.DATA.bacid7="ISO"

IF (BANCS.STDIN.contextBankId!="") THEN
#{
	CUST.DATA.RET = "1"
	CUST.DATA.successOrFailure = "F"
	sv_s = urhk_getFileLocation("COM|cbkreportsln.com")
	sv_l = BANCS.OUTPARAM.fileLocation
	sv_t = sv_l + "cbkreportsln.com" + " " + BANCS.STDIN.mySolId + " " + BANCS.STDIN.contextBankId + " " + CUST.DATA.solID1 + " " + CUST.DATA.bacid7
	PRINT(sv_t)
	sv_u = SYSTEM(sv_t)
	print(sv_u)
	CUST.DATA.errMsg = "CBK REPORT LOAN JOB "
	PRINT(CUST.DATA.errMsg)
	sv_u = SYSTEM("echo '"+ CUST.DATA.errMsg +"' >> cbkreportsln.log")
	sv_k = 1
#}
ENDIF

IF (sv_k != 0) THEN
#{
	CUST.DATA.RET = "1"
	CUST.DATA.successOrFailure = "F"
#}
ELSE
#{
	CUST.DATA.RET = "0"
	CUST.DATA.successOrFailure = "S"
#}
ENDIF

print(CUST.DATA.RET)
print(CUST.DATA.successOrFailure)

EXITSCRIPT
END-->

