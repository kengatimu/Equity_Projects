			sv_t = "Ecomoto_RES.<rec_" + FORMAT$(sv_q,"%d") + ">." + "ECOSYS1_NOM_PHONE| " + CUST.DATA.ECOSYS1_NOM_PHONE
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "Ecomoto_RES.<rec_" + FORMAT$(sv_q,"%d") + ">." + "ECOSYS1_NOM_PHONE| " + CUST.DATA.ECOSYS1_NOM_PHONE
