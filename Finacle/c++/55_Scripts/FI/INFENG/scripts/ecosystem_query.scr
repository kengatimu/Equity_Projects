		sv_s = sv_s + "  ECO_SYS5,ECOSYS5_NOM_PHONE,bank_id,acct_cls_flg| "
		sv_s = sv_s + " select distinct sol_id,foracid,acct_name,PHONENO,cif_id, "
		sv_s = sv_s + " schm_code,acct_crncy_code,preferredemail,nat_id_card_num, D.FREE_TEXT_1 FCS_NUMBER, "
