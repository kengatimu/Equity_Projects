		print (BANCS.INPARAM.BINDVARS)
		
		sv_s = "sol_id,foracid,acct_name,ACOUNTS_MOBILE,cif_id,schm_code,acct_crncy_code, "
		sv_s = sv_s + "  email_id,national_id, FCS_NUMBER, ECO_SYS1, ECOSYS1_NOM_PHONE,ECO_SYS2, "
