		sv_u = urhk_SetOrbOut(sv_t)


			sv_t = "Ecomoto_RES.<rec_" + FORMAT$(sv_q,"%d") + ">." + "FORACID| " + CUST.DATA.foracid
			sv_u = urhk_SetOrbOut(sv_t)
