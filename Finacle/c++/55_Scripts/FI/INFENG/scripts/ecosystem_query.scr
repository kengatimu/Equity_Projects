			sv_u = urhk_SetOrbOut(sv_t)

		sv_r = urhk_dbCursorFetch(sv_c)
		#}
		DO
		sv_r = urhk_dbCursorClose(sv_c)
		sv_z = sv_q
		print(sv_z)
			IF (sv_z == 0)THEN	
				sv_j = urhk_SetOrbOut("code|0")
