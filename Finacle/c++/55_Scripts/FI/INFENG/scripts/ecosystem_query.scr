			sv_t = "Ecomoto_RES.<rec_" + FORMAT$(sv_q,"%d") + ">." + "FCS_NUMBER| " + CUST.DATA.FCS_NUMBER
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "Ecomoto_RES.<rec_" + FORMAT$(sv_q,"%d") + ">." + "ECO_SYS1| " + CUST.DATA.ECO_SYS1
