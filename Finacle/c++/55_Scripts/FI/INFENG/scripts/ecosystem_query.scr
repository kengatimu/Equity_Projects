		sv_s = sv_s + " gac.FREE_TEXT_6,gac.FREE_TEXT_7,gac.FREE_TEXT_8,gac.FREE_TEXT_9, "
		sv_s = sv_s + " gac.FREE_TEXT_10,gam.bank_id,acct_cls_flg from tbaadm.gam , "
		sv_s = sv_s + " tbaadm.adt,TBAADM.GAC,crmuser.accounts A,crmuser.CPHONE B ,TBAADM.RCT C, crmuser.acmg D where  "
		sv_s = sv_s + " gam.bank_id= ?SVAR and gam.bank_id=adt.bank_id and gam.acid=adt.acid and "
		sv_s = sv_s + " gam.bank_id=A.bank_id and gam.cif_id=A.orgkey and gam.bank_id=B.bank_id and "
		sv_s = sv_s + " gam.cif_id=B.PHONE_B2KID AND B.PREFERREDFLAG ='Y' and gam.bank_id=GAC.bank_id "
		sv_s = sv_s + " and gam.acid=GAC.acid AND GAM.BANK_ID = C.BANK_ID and C.bank_id = D.bank_id "
		sv_s = sv_s + " and gam.cust_id = D.cust_id and REF_REC_TYPE ='AG' "
		sv_s = sv_s + " and adt.table_name='GAC' and adt.FUNC_CODE='M' and adt.MOP_ID='HACM' AND AUTH_ID !='!' "
		sv_s = sv_s + " and gam.schm_type in ('SBA','CAA') and (substr(gac.FREE_TEXT_1,1,5)=ref_code OR "
		sv_s = sv_s + " substr(gac.FREE_TEXT_3,1,5)=ref_code OR substr(gac.FREE_TEXT_5,1,5)=ref_code OR "
		sv_s = sv_s + " substr(gac.FREE_TEXT_7,1,5)=ref_code OR substr(gac.FREE_TEXT_9,1,5)=ref_code) "
		sv_s = sv_s + " and AUDIT_DATE >= ?SVAR AND CORP_ID IS NULL "
		sv_s = sv_s + " and adt.MODIFIED_FIELDS_DATA like '%free_text%' union all Select distinct sol_id, "
		sv_s = sv_s + " foracid,acct_name, PHONENO ACOUNTS_MOBILE,cif_id,schm_code,acct_crncy_code, "
		sv_s = sv_s + " preferredemail email_id,nvl(nvl(nvl(nvl(nvl(nvl(nvl(nvl(nvl(A.IDTYPEC1,A.IDTYPEC2),IDTYPEC3),IDTYPEC4), "
		sv_s = sv_s + " IDTYPEC5),IDTYPEC6),IDTYPEC7),IDTYPEC8),IDTYPEC9),IDTYPEC10) national_id, D.FREE_TEXT_1 FCS_NUMBER, "
		sv_s = sv_s + " gac.FREE_TEXT_1 ECO_SYS1,gac.FREE_TEXT_2 ECOSYS1_NOM_PHONE,gac.FREE_TEXT_3 ECO_SYS2, "
		sv_s = sv_s + " gac.FREE_TEXT_4 ECOSYS2_NOM_PHONE,gac.FREE_TEXT_5 ECO_SYS3,gac.FREE_TEXT_6 ECOSYS3_NOM_PHONE, "
		sv_s = sv_s + " gac.FREE_TEXT_7 ECO_SYS4,gac.FREE_TEXT_8 ECOSYS4_NOM_PHONE, gac.FREE_TEXT_9 ECO_SYS5, "
		sv_s = sv_s + " gac.FREE_TEXT_10 ECOSYS5_NOM_PHONE ,gam.bank_id,acct_cls_flg from tbaadm.gam , "
		sv_s = sv_s + " tbaadm.adt,TBAADM.GAC,crmuser.corporate A, crmuser.CPHONE B ,TBAADM.RCT C, crmuser.acmg D where  gam.bank_id= ?SVAR "
		sv_s = sv_s + " and gam.bank_id=adt.bank_id and gam.acid=adt.acid and gam.bank_id=A.bank_id "
		sv_s = sv_s + " and gam.cif_id=A.CORP_KEY and gam.bank_id=B.bank_id and gam.cif_id=B.PHONE_B2KID "
		sv_s = sv_s + " AND B.PREFERREDFLAG ='Y' and gam.bank_id=GAC.bank_id and gam.acid=GAC.acid "
		sv_s = sv_s + " AND GAM.BANK_ID = C.BANK_ID and C.Bank_id = D.bank_id and gam.cust_id = D.cust_id "
		sv_s = sv_s + " and REF_REC_TYPE ='AG' and adt.table_name='GAC' "
		sv_s = sv_s + " and adt.FUNC_CODE='M' and adt.MOP_ID='HACM' AND AUTH_ID !='!' and gam.schm_type in ('CAA','SBA') "
		#sv_s = sv_s + " and (substr(gac.FREE_TEXT_1,1,3)=ref_code OR substr(FREE_TEXT_3,1,3)=ref_code "
