	lv_i = lv_i + " free_text5 "
	lv_i = lv_i + " ) VALUES ( "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " to_date(?SVAR,'DD-MM-RRRR'), "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
