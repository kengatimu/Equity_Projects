	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " SYSDATE, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " NULL, "
	lv_i = lv_i + " NULL, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " NULL, "
	lv_i = lv_i + " NULL, "
	lv_i = lv_i + " NULL "
	lv_i = lv_i + " ) "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.custId + "|" + EBSRV.GLBDATA.custName + "|" + EBSRV.GLBDATA.custDob + "|" + EBSRV.GLBDATA.custCntyOrg + "|" + EBSRV.GLBDATA.custConst + "|" + EBSRV.GLBDATA.custBranch + "|" + EBSRV.GLBDATA.idType + "|" + EBSRV.GLBDATA.UniqIdNum + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.evideNce + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EBSRV.GLBDATA.iscustYN + "|" + EBSRV.GLBDATA.WatchList + "|" + EBSRV.GLBDATA.WatchListReson 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_i)
	sv_u = urhk_dbSqlWithBind(lv_i)
	if(sv_u==0)then
		sv_u = urhk_dbSqlWithBind("commit")
		print(sv_u)
		EBSRV.GLBDATA.resMsg = "Backlist Registered for Id " + EBSRV.GLBDATA.UniqIdNum 
		goto ENDOFSCRIPT
	else
		sv_u = urhk_dbSqlWithBind("rollback")
		EBSRV.GLBDATA.errMsg = "Backlist Registeration Failed for Id " + EBSRV.GLBDATA.UniqIdNum
		goto ENDOFSCRIPT
	endif
	##}
	endif
if(EBSRV.GLBDATA.funcCode == "V") then
        callscriptifexist("ebCbwfVerify.scr")
        GOTO ENDOFSCRIPT
endif
if((EBSRV.GLBDATA.funcCode == "X") or (EBSRV.GLBDATA.funcCode=="D")) then
        callscriptifexist("ebCbwfCancel.scr")
        GOTO ENDOFSCRIPT
endif
if(EBSRV.GLBDATA.funcCode == "M") then
#{
	lv_i = "INSERT INTO custom.caml_mod ( "
	lv_i = lv_i + " bank_id, "
	lv_i = lv_i + " cif_id, "
