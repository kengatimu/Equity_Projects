	if(lv_a == 0) then
		EBSRV.GLBDATA.iscustYN = "Y"
	else
		EBSRV.GLBDATA.iscustYN = "N"
	endif
	if(EBSRV.GLBDATA.funcCode=="A")then
	##{
	lv_i = "INSERT INTO custom.caml ( "
