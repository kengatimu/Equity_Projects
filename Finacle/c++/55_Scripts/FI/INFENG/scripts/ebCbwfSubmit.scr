	lv_i = lv_i + " free_text4, "
	lv_i = lv_i + " free_text5 ) " 
	lv_i = lv_i + " (SELECT bank_id,cif_id, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " to_date(?SVAR,'DD-MM-RRRR'), "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " ?SVAR, "
	lv_i = lv_i + " 'N'," 
	lv_i = lv_i + " 'N'," 
	lv_i = lv_i + " RCRE_USER_ID,RCRE_TIME,RCRE_USER_ID,SYSDATE, "
	lv_i = lv_i + " is_cust_yn,is_backlisted_crm,backlist_status,?SVAR,?SVAR,free_text3,free_text4,free_text5 "
	lv_i = lv_i + " FROM CUSTOM.caml "
	lv_i = lv_i + " WHERE id_number=?SVAR "
	lv_i = lv_i + " AND BANK_ID = ?SVAR "
	lv_i = lv_i + " AND DEL_FLG = 'N' "
	lv_i = lv_i + " AND ENTITY_CRE_FLG = 'Y' ) "
	print(lv_i)
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.custName + "|" + EBSRV.GLBDATA.custDob + "|" + EBSRV.GLBDATA.custCntyOrg + "|" + EBSRV.GLBDATA.custConst + "|" + EBSRV.GLBDATA.custBranch + "|" + EBSRV.GLBDATA.idType + "|" + EBSRV.GLBDATA.UniqIdNum + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.blackReason + "|" + EBSRV.GLBDATA.evideNce + "|" + EBSRV.GLBDATA.WatchList + "|" + EBSRV.GLBDATA.WatchListReson + "|" + EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_i)
	sv_u = urhk_dbSqlWithBind(lv_i)
	if(sv_u==0)then
		sv_u = urhk_dbSqlWithBind("commit")
		print(sv_u)
		EBSRV.GLBDATA.resMsg = "Backlist Modified for Id " + EBSRV.GLBDATA.UniqIdNum + " Please Verify" 
		goto ENDOFSCRIPT
	else
		sv_u = urhk_dbSqlWithBind("rollback")
		EBSRV.GLBDATA.errMsg = "Backlist Modification Failed for Id " + EBSRV.GLBDATA.UniqIdNum
		goto ENDOFSCRIPT
	endif
#}
endif
ENDOFSCRIPT:
	if(EBSRV.GLBDATA.errMsg != "") then
                lv_e = urhk_SetOrbErr(EBSRV.GLBDATA.errMsg)
		goto CLEANUP
        else
                if(EBSRV.GLBDATA.resMsg != "") then
                        lv_a = urhk_dbSQLWithBind("COMMIT")
                        print(lv_a)
                        if(lv_a == 0) then
                                lv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
                                lv_b = urhk_SetOrbOut("RESULT_MSG|" +EBSRV.GLBDATA.resMsg)
				goto CLEANUP
                        else
                                lv_e = urhk_SetOrbErr("Error in Saving Data")
				goto CLEANUP
                        endif
                endif
        endif
CLEANUP:
	callscriptifexist("ebRepClean.scr")
        EXITSCRIPT

trace off
end-->
