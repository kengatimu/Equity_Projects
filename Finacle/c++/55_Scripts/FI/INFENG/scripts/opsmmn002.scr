<--START
CHECKSUM="08a9cb0dadf0ff3e477e4f87673bd1f33ef386b0562110aadddeb330fc401c54"
	TRACE ON
	
	######################################################
	# Creating Custom Repository
	######################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "PORT")
	
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "PORT", 5)
	#}
	ENDIF
	
	CUST.PORT.acctNum = BANCS.INPUT.acctNum
	
	print(BANCS.INPUT.acctNum)
	print(BANCS.INPUT.frmdate_ui)
	print(BANCS.INPUT.todate_ui)
	CUST.PORT.frmdate	= BANCS.INPUT.frmdate_ui
	CUST.PORT.todate	= BANCS.INPUT.todate_ui
	########################################################
	## NO OF TRANSACTIONS
	#######################################################
	sv_s = "trans|"
	sv_s = sv_s + " SELECT"
	sv_s = sv_s + "	COUNT(HTD.acid)"
	sv_s = sv_S + " FROM"
	sv_s = sv_s + " TBAADM.HTD,TBAADM.GAM"
	sv_s = sv_s + "	WHERE"
	sv_s = SV_S + " GAM.ACID=HTD.ACID"
	sv_s = sv_s + " AND GAM.foracid=?SVAR"
	sv_s = sv_s + "	AND HTD.TRAN_DATE BETWEEN"
	sv_s = sv_s + "  TO_DATE(?SVAR,'DD-MM-YYYY') AND TO_DATE(?SVAR,'DD-MM-YYYY')"
	sv_s = sv_s + " AND GAM.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND GAM.DEL_FLG = 'N'"
	sv_s = sv_s + " AND GAM.BANK_ID = ?SVAR"
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.PORT.acctNum + "|" + CUST.PORT.frmdate +"|"+ CUST.PORT.todate +"|"+ BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	CUST.PORT.trans = CINT(BANCS.OUTPARAM.trans)
	print(CUST.PORT.trans)
	IF (sv_d == 0) THEN
	#{
		IF (CUST.PORT.trans > 0) THEN
		#{
			sv_e = " your number of transactions are"+ CUST.PORT.trans
			print(sv_e)
			sv_m = "RESULT_MSG|"
			sv_s = sv_m+sv_e
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			#}
		ELSE
			#{
			sv_e = "no transactions are done"
			sv_m = "RESULT_MSG|"
			sv_s = sv_m+sv_e
			sv_u = urhk_SetOrbOut(sv_s)
		#}
		ENDIF
	#}
	ENDIF
	
	TRACE OFF
	EXITSCRIPT
END-->
