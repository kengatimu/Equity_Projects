<--START
CHECKSUM="3437261982dbf26f22095ffd1e4750d2b1a8e36eedb32894795c363e1f08242f"
	# Script body goes here
	#TRACE ON
	##############################################
	# Creation of Repository and Class and Initialization
	##############################################
	
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST","FIINBOUND")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST","FIINBOUND",5)
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST","INTERFACE",5)
	#}
	ENDIF
	
	CUST.INTERFACE.successOrFailure="S"
	CUST.INTERFACE.Message="Success"
	CUST.INTERFACE.AcctInpInd="Y"
	CUST.INTERFACE.CustInpInd="Y"
	CUST.INTERFACE.CustValInd="N"
	CUST.INTERFACE.AcctValInd="N"
	
	
	
	IF((FIELDEXISTS(BANCS.INPUT.ACCOUNT_ID)) == 0)THEN
	#{
		CUST.INTERFACE.Message="AccountId not provided"
		CUST.INTERFACE.AcctInpInd="N"
		
		#}
	ELSE
		#{
		CUST.INTERFACE.AcctInpInd="Y"
		#CUST.FIINBOUND.acctNum = sv_d
		CUST.FIINBOUND.acctNum = BANCS.INPUT.ACCOUNT_ID
	#}
	ENDIF

	#############################################
	# If acctId is provided, validating it and comparing custId.
	#############################################
	IF(CUST.INTERFACE.AcctInpInd == "Y")THEN
	#{
		print(CUST.FIINBOUND.acctNum)
		sv_b = urhk_getAcctDetailsInRepository(CUST.FIINBOUND.acctNum)
		print(sv_b)
		IF(sv_b == 1) THEN
		#{
			CUST.INTERFACE.AcctValInd="N"
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.Message="Invalid account Id"
			GOTO END
			#}
		ELSE
			#{
			CUST.INTERFACE.successOrFailure="S"
			CUST.INTERFACE.Message="Success - valid account"
			
				CUST.FIINBOUND.solidsh = BANCS.OUTPARAM.acctSolId
				print(CUST.FIINBOUND.solidsh)
				CUST.FIINBOUND.schmcodesh = BANCS.OUTPARAM.schmCode
				print(CUST.FIINBOUND.schmcodesh)
				CUST.FIINBOUND.schmType = BANCS.OUTPARAM.schmType
				print(CUST.FIINBOUND.schmType)
				CUST.FIINBOUND.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
				print(CUST.FIINBOUND.EffAvailableAmttr)
				CUST.FIINBOUND.lienAmt = BANCS.OUTPARAM.lienAmt
				print(CUST.FIINBOUND.lienAmt)
				CUST.FIINBOUND.acctName=BANCS.OUTPARAM.acctName
				print(CUST.FIINBOUND.acctName)

				CUST.FIINBOUND.acctCrncyCode=BANCS.OUTPARAM.acctCrncyCode
				print(CUST.FIINBOUND.acctCrncyCode)
				CUST.FIINBOUND.acctCloseflg=BANCS.OUTPARAM.acctCloseflg
				print(CUST.FIINBOUND.acctCloseflg)
				
				IF (CUST.FIINBOUND.acctCloseflg=="Y") THEN
				#{
					CUST.INTERFACE.AcctValInd="N"
					CUST.INTERFACE.successOrFailure="F"
					CUST.INTERFACE.Message="Invalid account Id ...Closed"
					GOTO END
				#}
				ENDIF
				
				PRINT(CUST.FIINBOUND.acctNum)
				sv_u=urhk_SetOrbOut("ACCT_NUMBER|" + CUST.FIINBOUND.acctNum)

				PRINT(CUST.FIINBOUND.acctName)
				sv_u=urhk_SetOrbOut("ACCT_NAME|" + CUST.FIINBOUND.acctName)
				
				PRINT(CUST.FIINBOUND.acctCrncyCode)
				sv_u=urhk_SetOrbOut("ACCT_CRNCY_CODE|" + CUST.FIINBOUND.acctCrncyCode)
				
				PRINT(CUST.FIINBOUND.schmcodesh)
				sv_u=urhk_SetOrbOut("ACCT_SCHM_CODE|" + CUST.FIINBOUND.schmcodesh)
		#}
		ENDIF
	#}
	ENDIF
	END:
		print(CUST.INTERFACE.successOrFailure)
		print(CUST.INTERFACE.Message)
		
		sv_u=urhk_SetOrbOut("RESPONSE|" + CUST.INTERFACE.successOrFailure)
		sv_u=urhk_SetOrbOut("MESSAGE|" + CUST.INTERFACE.Message)
		TRACE OFF
		exitscript
		
END-->
