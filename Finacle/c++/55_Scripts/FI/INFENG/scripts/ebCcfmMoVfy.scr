<--start
trace on
#Reps/Class
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        EQSRV.GLBDATA.srvErrCode = ""
        EQSRV.GLBDATA.srvErrMsg = ""
        EQSRV.GLBDATA.srvSucFail = ""
	if(fieldexists(EBSRV.GLBDATA.cifId)==1)then
		if(EBSRV.GLBDATA.cifId!="")then
			EQSRV.GLBDATA.cifId = EBSRV.GLBDATA.cifId
		else
			EQSRV.GLBDATA.cifId = ""
		endif
	else
			EQSRV.GLBDATA.cifId = ""
	endif
	sv_u = urhk_SetUrhkInp("custGeneralDet.custId.cifId|" + EQSRV.GLBDATA.cifId )
        sv_u = urhk_SetUrhkOut("custGeneralDet.sweepsFlg|oSweepsFlg")
	sv_u = urhk_SetUrhkOut("custGeneralDet.combStmtReqd|ocombStmtReqd")
	sv_u = urhk_SetUrhkOut("custGeneralDet.custCombStmtFreqDet.type|otype")
	sv_u = urhk_SetUrhkOut("custGeneralDet.custCombStmtFreqDet.weekNum|oweekNum")
	sv_u = urhk_SetUrhkOut("custGeneralDet.custCombStmtFreqDet.weekDay|oweekDay")
	sv_u = urhk_SetUrhkOut("custGeneralDet.custCombStmtFreqDet.startDd|ostartDd")
	sv_u = urhk_SetUrhkOut("custGeneralDet.custCombStmtFreqDet.hldyStat|ohldyStat")
	sv_u = urhk_SetUrhkOut("custGeneralDet.custCombStmtFreqDet.months|omonths")
	sv_u = urhk_SetUrhkOut("custGeneralDet.custCombStmtFreqDet.days|odays")
	sv_u = urhk_SetUrhkOut("custGeneralDet.zakatDedCalBase|ozakatDedCalBase")
	sv_u = urhk_SetUrhkOut("custGeneralDet.poSTPCeilCrncy.crncyCode|oPoscrncyCode")
	sv_u = urhk_SetUrhkOut("custGeneralDet.poSTPCeilAmount|oPosSTPCeilAmount")
        sv_u = urhk_ExecSrv("SRV_FetchCoreCustomerDataForModify|same_user_verify = Y|retain_all_output = Y")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
		EQSRV.GLBDATA.oSweepsFlg = BANCS.OUTPARAM.oSweepsFlg
		EQSRV.GLBDATA.ocombStmtReqd = BANCS.OUTPARAM.ocombStmtReqd
		EQSRV.GLBDATA.otype = BANCS.OUTPARAM.otype
		EQSRV.GLBDATA.oweekNum = BANCS.OUTPARAM.oweekNum
		EQSRV.GLBDATA.oweekDay = BANCS.OUTPARAM.oweekDay
		EQSRV.GLBDATA.ostartDd = BANCS.OUTPARAM.ostartDd
		EQSRV.GLBDATA.ohldyStat = BANCS.OUTPARAM.ohldyStat
		EQSRV.GLBDATA.omonths = BANCS.OUTPARAM.omonths
		EQSRV.GLBDATA.odays = BANCS.OUTPARAM.odays
		EQSRV.GLBDATA.ozakatDedCalBase = BANCS.OUTPARAM.ozakatDedCalBase
		EQSRV.GLBDATA.oPoscrncyCode = BANCS.OUTPARAM.oPoscrncyCode
		EQSRV.GLBDATA.oPosSTPCeilAmount = BANCS.OUTPARAM.oPosSTPCeilAmount
		EQSRV.GLBDATA.srvSucFail = "S"
        else
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.cifId 
                callscriptifexist("ebsrvHandler.scr")
                EQSRV.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchCoreCustomerDataForModify "
                EQSRV.GLBDATA.srvSucFail = "F"
        endif
	sv_u = urhk_CopyOutToIn("")
	print(sv_u)
	sv_u = urhk_SetUrhkInp("custGeneralDet.custId.cifId|" + EQSRV.GLBDATA.cifId )
	sv_u = urhk_SetUrhkInp("custGeneralDet.sweepsFlg|Y")
	print(EQSRV.GLBDATA.ocombStmtReqd)
	sv_u = urhk_SetUrhkInp("custGeneralDet.combStmtReqd|" + EQSRV.GLBDATA.ocombStmtReqd ) 
	print(EQSRV.GLBDATA.otype)
	if(EQSRV.GLBDATA.ocombStmtReqd=="Y")then
		sv_u = urhk_SetUrhkInp("custGeneralDet.custCombStmtFreqDet.type|" + EQSRV.GLBDATA.otype)
		print(EQSRV.GLBDATA.oweekNum)
		sv_u = urhk_SetUrhkInp("custGeneralDet.custCombStmtFreqDet.weekNum|" + EQSRV.GLBDATA.oweekNum)
		print(EQSRV.GLBDATA.oweekDay)
		sv_u = urhk_SetUrhkInp("custGeneralDet.custCombStmtFreqDet.weekDay|" + EQSRV.GLBDATA.oweekDay)
		print(EQSRV.GLBDATA.ostartDd)
		sv_u = urhk_SetUrhkInp("custGeneralDet.custCombStmtFreqDet.startDd|" + EQSRV.GLBDATA.ostartDd)
		print(EQSRV.GLBDATA.ohldyStat)
		sv_u = urhk_SetUrhkInp("custGeneralDet.custCombStmtFreqDet.hldyStat|" + EQSRV.GLBDATA.ohldyStat)
		print(EQSRV.GLBDATA.omonths)
		sv_u = urhk_SetUrhkInp("custGeneralDet.custCombStmtFreqDet.months|" + EQSRV.GLBDATA.omonths)
		print(EQSRV.GLBDATA.odays)
	endif
        sv_u = urhk_SetUrhkInp("custGeneralDet.custCombStmtFreqDet.days|" + EQSRV.GLBDATA.odays)
	sv_u = urhk_SetUrhkInp("custGeneralDet.zakatDedCalBase|" + EQSRV.GLBDATA.ozakatDedCalBase )
	sv_u = urhk_SetUrhkInp("custGeneralDet.delFlg|N")
	sv_u = urhk_SetUrhkInp("custBuySellLimDet.isCustBuySellLimDetEntered|0")
	sv_u = urhk_SetUrhkInp("custGeneralDet.poSTPCeilCrncy.crncyCode|" + BANCS.STDIN.homeCrncyCode ) 
	sv_u = urhk_SetUrhkInp("custGeneralDet.poSTPCeilAmount|0.00|" + BANCS.STDIN.homeCrncyCode ) 
	sv_u = urhk_ExecSrv("SRV_ModifyCoreCustomerAndVerify|same_user_verify = Y")
	if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
		print(BANCS.OUTPARAM.successOrFailure)
		sv_s = BANCS.OUTPARAM.successOrFailure
	else
		sv_s = "X"
	endif
	if (( sv_u != 0 ) and ( sv_s != "S"))then
		EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.cifId 
		callscriptifexist("ebsrvHandler.scr")
		EBSRV.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError
		EBSRV.GLBDATA.srvErrCode = "SRV_ModifyCoreCustomerAndVerify"
		EBSRV.GLBDATA.srvSucFail = "F"
	else
		EBSRV.GLBDATA.srvErrCode = "CCFMS"
		EBSRV.GLBDATA.srvSucFail = "S"	
	endif
	exitscript
##trace off
end-->
