<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
	if(repexists("EQOD")==0)then
                createrep("EQOD")
        endif
	if(classexists("EQOD","GLBDATA")==0)then
               createclass("EQOD","GLBDATA",5)
        endif
        sv_p = urhk_B2k_PrintRepos("BANCS")
        print(sv_p)
        if(fieldexists(EQOD.GLBDATA.LoanAcid)==1)then
        #{
                EBSRV.GLBDATA.LoanAcid = EQOD.GLBDATA.LoanAcid
                EBSRV.GLBDATA.dmdby = "CODLAR"
        else
                EBSRV.GLBDATA.LoanAcid = ""
                EBSRV.GLBDATA.dmdby = ""
        #}
        endif
        if(EBSRV.GLBDATA.LoanAcid=="")then
        lv_a = "gsolid,gcifid,gacid,gloanacct,gclrbalamt,gsanctlim,gcumdrAmt,gcumcrAmt,gacctOpnDate,grcreId,gMgrId,gdpdValue,gdpdDate,gOperAcctId,gLoanFrequency,gLoanAmt,gschmCode | select gam.sol_id,gam.cif_id,gam.acid,gam.foracid,gam.clr_bal_Amt,gam.sanct_lim,gam.cum_dr_amt,gam.cum_cr_amt,to_char(gam.acct_opn_date,'DD-MM-YYYY'),gam.rcre_user_id,gam.acct_mgr_user_id,gac.dpd_cntr,gac.dpd_ason_date,gac.free_text_1 as operativeAcct ,gac.free_text_2 loanFrequency ,gac.free_text_3 as LoanAmount,gam.schm_code from tbaadm.gam ,tbaadm.gac where gam.bank_id=?SVAR and gac.bank_id=?SVAR and gam.acid=gac.acid and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.schm_code in ('OD542','OD543','OD544','OD545','OD546') and gam.acct_cls_flg='N' and gam.acct_cls_date is null and gam.acid not in (select od_acid  from custom.odla_dmd_tbl where bank_id=?SVAR and del_flg='N' and entity_cre_flg='Y') and gam.sol_id=?SVAR order by gam.sol_id,gam.cif_id,gam.acct_opn_date desc "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
        else
        lv_a = "gsolid,gcifid,gacid,gloanacct,gclrbalamt,gsanctlim,gcumdrAmt,gcumcrAmt,gacctOpnDate,grcreId,gMgrId,gdpdValue,gdpdDate,gOperAcctId,gLoanFrequency,gLoanAmt,gschmCode | select gam.sol_id,gam.cif_id,gam.acid,gam.foracid,gam.clr_bal_Amt,gam.sanct_lim,gam.cum_dr_amt,gam.cum_cr_amt,to_char(gam.acct_opn_date,'DD-MM-YYYY'),gam.rcre_user_id,gam.acct_mgr_user_id,gac.dpd_cntr,gac.dpd_ason_date,gac.free_text_1 as operativeAcct ,gac.free_text_2 loanFrequency ,gac.free_text_3 as LoanAmount,gam.schm_code from tbaadm.gam ,tbaadm.gac where gam.bank_id=?SVAR and gac.bank_id=?SVAR and gam.acid=gac.acid and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.schm_code in ('OD542','OD543','OD544','OD545','OD546') and gam.acct_cls_flg='N' and gam.acct_cls_date is null and gam.acid not in (select od_acid  from custom.odla_dmd_tbl where bank_id=?SVAR and del_flg='N' and entity_cre_flg='Y') and gam.acid=?SVAR order by gam.sol_id,gam.cif_id,gam.acct_opn_date desc "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.LoanAcid
        endif
        print(BANCS.INPARAM.BINDVARS)
        print(lv_a)
        sv_c = urhk_dbCursorOpenWithBind(lv_a)
        print(sv_c)
        if(sv_c != 0)then
        #{
                print("fetching failed")
                EBSRV.GLBDATA.onsmsg = "Data Fetch Failed"
                goto DMDEND
        #}
        endif
        EBSRV.GLBDATA.curNum1 = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        print(EBSRV.GLBDATA.curNum1)
        sv_r = urhk_dbCursorFetch(EBSRV.GLBDATA.curNum1)
        print(sv_r)
        if(sv_r != 0)then
        #{
                 print("fetch failed")
                EBSRV.GLBDATA.onsmsg = "Data Fetch Failed"
                        sv_u = urhk_dbCursorClose(EBSRV.GLBDATA.curNum1)
                        print(sv_u)
                        goto DMDEND
        #}
        endif
        EBSRV.GLBDATA.record_count = 0
        while(sv_r == 0)
        #{
                EBSRV.GLBDATA.gsolid =  BANCS.OUTPARAM.gsolid
                EBSRV.GLBDATA.gcifid =  BANCS.OUTPARAM.gcifid
                EBSRV.GLBDATA.gacid =   BANCS.OUTPARAM.gacid
                EBSRV.GLBDATA.gloanacct =       BANCS.OUTPARAM.gloanacct
                EBSRV.GLBDATA.gclrbalamt =      BANCS.OUTPARAM.gclrbalamt
                EBSRV.GLBDATA.gsanctlim =       BANCS.OUTPARAM.gsanctlim
                EBSRV.GLBDATA.gcumdrAmt =       BANCS.OUTPARAM.gcumdrAmt
                EBSRV.GLBDATA.gcumcrAmt =       BANCS.OUTPARAM.gcumcrAmt
                EBSRV.GLBDATA.gacctOpnDate =    BANCS.OUTPARAM.gacctOpnDate
                EBSRV.GLBDATA.grcreId = BANCS.OUTPARAM.grcreId
                EBSRV.GLBDATA.gMgrId =  BANCS.OUTPARAM.gMgrId
                EBSRV.GLBDATA.gdpdValue =       BANCS.OUTPARAM.gdpdValue
                EBSRV.GLBDATA.gdpdDate =        BANCS.OUTPARAM.gdpdDate
                EBSRV.GLBDATA.gOperAcctId =     BANCS.OUTPARAM.gOperAcctId
                EBSRV.GLBDATA.gLoanFrequency =  BANCS.OUTPARAM.gLoanFrequency
                EBSRV.GLBDATA.gLoanAmt =        BANCS.OUTPARAM.gLoanAmt
                EBSRV.GLBDATA.gschmCode =        BANCS.OUTPARAM.gschmCode
        #AgriTea
                if(EBSRV.GLBDATA.gschmCode=="OD544")then
                #{
                        goto DMDNXT
                #}
                endif
                if(cdouble(EBSRV.GLBDATA.gclrbalamt)<=0)then
                #{
                        EBSRV.GLBDATA.gclrbalamt = -1 * cdouble(EBSRV.GLBDATA.gclrbalamt)
                        if(cdouble(EBSRV.GLBDATA.gclrbalamt)<=0)then
                        #{
                                goto DMDNXT
                        #}
                        endif
                #}
                endif
        #OperAcct
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.gOperAcctId)
                if(sv_u==0)then
                #{
                        EBSRV.GLBDATA.SolId = BANCS.OUTPARAM.acctSolId
                        EBSRV.GLBDATA.drschmCode = BANCS.OUTPARAM.schmCode
                        EBSRV.GLBDATA.drCifId = BANCS.OUTPARAM.cifId
                #}
                else
                #{
                        EBSRV.GLBDATA.SolId = ""
                        EBSRV.GLBDATA.drschmCode = ""
                        EBSRV.GLBDATA.drCifId = ""
                #}
                endif
                sv_q = urhk_B2k_ForacidToAcid(EBSRV.GLBDATA.gOperAcctId)
                if(sv_q==0)then
                #{
                        EBSRV.GLBDATA.OperAcid = BANCS.OUTPARAM.Acid
                else
                        EBSRV.GLBDATA.OperAcid = ""
                #}
                endif
        #LastDisbursement
                lv_b = "diAcid,diTranDate,totDisbAmt| select acid,to_char(tran_date,'DD-MM-YYYY'),sum(tran_amt) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and tran_particular like '%Disbursement%' and tran_date in (select max(tran_date) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and tran_particular like '%Disbursement%' and pstd_flg='Y') and pstd_flg='Y' and rownum<=1 group by acid,tran_date,tran_amt "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gacid + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gacid
                print(lv_b)
                print(BANCS.INPARAM.BINDVARS)
                lv_b = urhk_dbSelectWithBind(lv_b)
                if(lv_b==0)then
                #{
                        EBSRV.GLBDATA.diAcid = BANCS.OUTPARAM.diAcid
                        EBSRV.GLBDATA.diTranDate = BANCS.OUTPARAM.diTranDate
                        EBSRV.GLBDATA.totDisbAmt = BANCS.OUTPARAM.totDisbAmt
                        EBSRV.GLBDATA.diTranId = "DISBTRAN9"
                #}
                else
                #{
                        EBSRV.GLBDATA.diAcid = ""
                        EBSRV.GLBDATA.diTranDate = ""
                        EBSRV.GLBDATA.totDisbAmt = ""
                        EBSRV.GLBDATA.diTranId = "DISBTRAN9"
                #}
                endif
        #Check Disbursement Entry
                lv_h = "schCnt| select count(*) from custom.odla_disb_tbl where bank_id=?SVAR and od_acct_id=?SVAR and od_acid=?SVAR and entity_cre_flg='Y' and del_flg='N' "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gloanacct + "|" + EBSRV.GLBDATA.gacid
                print(BANCS.INPARAM.BINDVARS)
                print(lv_h)
                lv_h = urhk_dbSelectWithBind(lv_h)
                if(lv_h==0)then
                #{
                        EBSRV.GLBDATA.schCnt = BANCS.OUTPARAM.schCnt
                #}
                else
                #{
                        EBSRV.GLBDATA.schCnt = "0"
                #}
                endif
                if(cdouble(EBSRV.GLBDATA.schCnt)<=0)then
                #{
                lv_i = " Insert into CUSTOM.ODLA_DISB_TBL (BANK_ID,OD_SOL_ID,OP_SOL_ID,OD_ACCT_ID,OP_ACCT_ID,OD_ACID,OP_ACID,OD_SCHM_CODE,OD_SANCT_LIM,OD_DISB_AMT,OD_DISB_TRAN_DATE,OD_DISB_TRAN_ID,OD_TOT_COMM_AMT,OD_COMM_TRAN_DATE,OD_COMM_TRAN_ID,IS_RESH_YN,RESH_DATE,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,ENTITY_CRE_FLG,DEL_FLG,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,FREE_TEXT4,FREE_TEXT5,FREE_TEXT6) values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?NVAR,?NVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,0,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,'Y',to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(sysdate,'DD-MM-YYYY'),?SVAR,to_date(sysdate,'DD-MM-YYYY'),'Y','N','1',null,null,null,null,?SVAR) "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gsolid + "|" + EBSRV.GLBDATA.SolId + "|" + EBSRV.GLBDATA.gloanacct + "|" + EBSRV.GLBDATA.gOperAcctId + "|" + EBSRV.GLBDATA.gacid + "|" + EBSRV.GLBDATA.OperAcid + "|" + EBSRV.GLBDATA.gschmCode + "|" + EBSRV.GLBDATA.gsanctlim + "|" + EBSRV.GLBDATA.gclrbalamt + "|" +  EBSRV.GLBDATA.diTranDate + "|" + EBSRV.GLBDATA.diTranId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + EBSRV.GLBDATA.diTranId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EBSRV.GLBDATA.gLoanFrequency
                        print(lv_i)
                        print(BANCS.INPARAM.BINDVARS)
                        lv_i = urhk_dbSqlWithBind(lv_i)
                        if(lv_i==0)then
                        #{
                                lv_i = urhk_dbSqlWithBind("commit")
                        else
                                goto DMDNXT
                        #}
                        endif
                #}
                endif
        #Check schedule Entry
                lv_h = "schCnt | select count(*) from custom.odla_schl_tbl where bank_id=?SVAR and od_acct_id=?SVAR and od_acid=?SVAR and entity_cre_flg='Y' "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gloanacct + "|" + EBSRV.GLBDATA.gacid
                print(BANCS.INPARAM.BINDVARS)
                print(lv_h)
                lv_h = urhk_dbSelectWithBind(lv_h)
                if(lv_h==0)then
                #{
                        EBSRV.GLBDATA.schCnt = BANCS.OUTPARAM.schCnt
                #}
                else
                #{
                        EBSRV.GLBDATA.schCnt = "0"
                #}
                endif
                if(cdouble(EBSRV.GLBDATA.schCnt)<=0)then
                #{
        #Limit Entry
                lv_l = " liSanctLim,limSanctDate,limExpDate,limCrncyCode | select sanct_lim,to_char(lim_sanct_date,'DD-MM-YYYY'),to_char(lim_exp_date,'DD-MM-YYYY'),crncy_code from tbaadm.lht where bank_id=?SVAR and acid=?SVAR and del_flg='N' and entity_cre_flg='Y' and serial_num in (select max(serial_num) from tbaadm.lht where bank_id=?SVAR and acid=?SVAR and del_flg='N' and entity_cre_flg='Y' ) "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gacid + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gacid
                lv_l = urhk_dbSelectWithBind(lv_l)
                if(lv_l==0)then
                #{
                        EBSRV.GLBDATA.liSanctLim = BANCS.OUTPARAM.liSanctLim
                        EBSRV.GLBDATA.limSanctDate = BANCS.OUTPARAM.limSanctDate
                        EBSRV.GLBDATA.limExpDate = BANCS.OUTPARAM.limExpDate
                        EBSRV.GLBDATA.limCrncyCode = BANCS.OUTPARAM.limCrncyCode
                #}
                else
                #{
                        EBSRV.GLBDATA.liSanctLim = ""
                        EBSRV.GLBDATA.limSanctDate = ""
                        EBSRV.GLBDATA.limExpDate = ""
                        EBSRV.GLBDATA.limCrncyCode = ""
                #}
                endif
        #IntTbl
                lv_i = "IntTblCode |  select int_tbl_code from tbaadm.csp where bank_id=?SVAR and schm_code=?SVAR and crncy_code=?SVAR and del_flg='N' "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gschmCode + "|" + EBSRV.GLBDATA.limCrncyCode
                print(lv_i)
                print(BANCS.INPARAM.BINDVARS)
                lv_i = urhk_dbSelectWithBind(lv_i)
                if(lv_i==0)then
                #{
                        EBSRV.GLBDATA.IntTblCode = BANCS.OUTPARAM.IntTblCode
                else
                        EBSRV.GLBDATA.IntTblCode = ""
                #}
                endif
#Flat Rate & Variable Rate
                                call("vpodlaLarsh_wbmyhq.scr")
                                goto DMDNXT
                #}
                else
                #{
                        #Limit Entry
                                lv_l = " liSanctLim,limSanctDate,limExpDate,limCrncyCode | select sanct_lim,to_char(lim_sanct_date,'DD-MM-YYYY'),to_char(lim_exp_date,'DD-MM-YYYY'),crncy_code from tbaadm.lht where bank_id=?SVAR and acid=?SVAR and del_flg='N' and entity_cre_flg='Y' and serial_num in (select max(serial_num) from tbaadm.lht where bank_id=?SVAR and acid=?SVAR and del_flg='N' and entity_cre_flg='Y' ) "
                                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gacid + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gacid
                                lv_l = urhk_dbSelectWithBind(lv_l)
                                if(lv_l==0)then
                                #{
                                        EBSRV.GLBDATA.liSanctLim = BANCS.OUTPARAM.liSanctLim
                                        EBSRV.GLBDATA.limSanctDate = BANCS.OUTPARAM.limSanctDate
                                        EBSRV.GLBDATA.limExpDate = BANCS.OUTPARAM.limExpDate
                                        EBSRV.GLBDATA.limCrncyCode = BANCS.OUTPARAM.limCrncyCode
                                #}
                                else
                                #{
                                        EBSRV.GLBDATA.liSanctLim = ""
                                        EBSRV.GLBDATA.limSanctDate = ""
                                        EBSRV.GLBDATA.limExpDate = ""
                                        EBSRV.GLBDATA.limCrncyCode = ""
                                #}
                                endif
                        #IntTbl
                                lv_i = "IntTblCode |  select int_tbl_code from tbaadm.csp where bank_id=?SVAR and schm_code=?SVAR and crncy_code=?SVAR and del_flg='N' "
                                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.gschmCode + "|" + EBSRV.GLBDATA.limCrncyCode
                                print(lv_i)
                                print(BANCS.INPARAM.BINDVARS)
                                lv_i = urhk_dbSelectWithBind(lv_i)
                                if(lv_i==0)then
                                #{
                                        EBSRV.GLBDATA.IntTblCode = BANCS.OUTPARAM.IntTblCode
                                else
                                        EBSRV.GLBDATA.IntTblCode = ""
                                #}
                                endif
        #Flat Rate & Variable Rate
                                        call("vpodlaLarsh_wbmyhq.scr")
                                        goto DMDNXT
                #}
                endif


                DMDNXT:
                sv_r = urhk_dbCursorFetch(EBSRV.GLBDATA.curNum1)
                if(sv_r!=0)then
                #{
                        print("fetch failed")
                        EBSRV.GLBDATA.onsmsg = "Data Fetch Failed"
                        sv_u = urhk_dbCursorClose(EBSRV.GLBDATA.curNum1)
                        print(sv_u)
                        goto DMDEND
                #}
                endif
        #}
        do
        sv_r = urhk_dbCursorClose(EBSRV.GLBDATA.curNum1)

DMDEND:
        print(EBSRV.GLBDATA.onsmsg)

trace off
