		sv_s = sv_s + " UNION"
		sv_s = sv_s + " SELECT tran_particular,tran_rmks "
		sv_s = sv_s + " FROM tbaadm.htd "
		sv_s = sv_s + " WHERE tran_id = ?SVAR "
		sv_s = sv_s + " AND tran_date = to_date(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND acid = (SELECT acid FROM tbaadm.gam "
		sv_s = sv_s + " WHERE foracid = ?SVAR)"
		sv_s = sv_s + " AND BANK_ID = ?SVAR "
		sv_s = sv_s + " AND ROWNUM = 1 "
		
		print(sv_s)
