			BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.chargeTranId+"|"+MID$(CUST.CIEREV.chargeTranDate,0,10)+"|"+BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_s = "chrgAmtTran|SELECT tran_amt "
			sv_s = sv_s + " FROM tbaadm.dtd "
			sv_s = sv_s + " WHERE tran_id = ?SVAR "
			sv_s = sv_s + " AND tran_date = to_date(?SVAR,'DD-MM-YYYY') "
			sv_s = sv_s + " AND TRIM(PART_TRAN_SRL_NUM) = '2' "
