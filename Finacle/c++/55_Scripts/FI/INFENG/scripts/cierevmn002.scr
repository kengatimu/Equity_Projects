		###########################################################################################
		# Checking whether the orignal transaction is Cash Transaction or not
		###########################################################################################
		
		IF(CUST.CIEREV.tranType == "C") THEN
		#{
			###########################################################################################
			# Checking whether the orignal transaction is cash withdrawal or not
			###########################################################################################
			
			IF((CUST.CIEREV.tranSubType == "NP") OR (CUST.CIEREV.tranSubType == "PI") OR (CUST.CIEREV.tranSubType == "CP")) THEN
			#{
				###########################################################################################
				# Calling script for cash deposit
				###########################################################################################
				CUST.CIEREV.partTranType = "C"
				IF(CUST.CIEREV.tranSubType == "NP") THEN
				#{
					CUST.CIEREV.tranSubType1 = "NR"
				#}
				ENDIF
				IF(CUST.CIEREV.tranSubType == "PI") THEN
				#{
					CUST.CIEREV.tranSubType1 = "RI"
				#}
				ENDIF
				IF(CUST.CIEREV.tranSubType == "CP") THEN
				#{
					CUST.CIEREV.tranSubType1 = "CR"
				#}
				ENDIF
				
				CUST.CIEREV.txnType = "CD"
				CUST.CIEREV.scriptSuccess = "Y"
				
				CALL("cierevdp012.scr")
				
				IF(CUST.CIEREV.scriptSuccess == "N")THEN
				#{
					sv_u = urhk_dbSqlWithBind("ROLLBACK")
					print(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				CUST.CIEREV.tarDrAcctNum = CUST.CIEREV.vostroAcct
				CUST.CIEREV.tarCrAcctNum = CUST.CIEREV.drAcctNum
				print(CUST.CIEREV.tarDrAcctNum)
				print(CUST.CIEREV.tarCrAcctNum)
				CUST.CIEREV.chargeAmtPartTran = "Y"
				CUST.CIEREV.drAcctNum2= CUST.CIEREV.vostroAcct
				CUST.CIEREV.chargeAmtInTranAmtCcy = CUST.CIEREV.chrgAmtTran
				CUST.CIEREV.tranAmtCcy=CUST.CIEREV.chargeAmtCcy
				PRINT(CUST.CIEREV.tranAmtCcy)
				PRINT(CUST.CIEREV.chargeAmtInTranAmtCcy)
				
			#}
			ENDIF
			
			###########################################################################################
			# Checking whether the orignal transaction is cash deposits or not
			###########################################################################################
			
			IF((CUST.CIEREV.tranSubType == "NR") OR (CUST.CIEREV.tranSubType == "RI") OR (CUST.CIEREV.tranSubType == "CR"))THEN
			#{
				###########################################################################################
				# Calling script for cash withdrawal
				###########################################################################################
				CUST.CIEREV.partTranType = "D"
				IF(CUST.CIEREV.tranSubType == "NR") THEN
				#{
					CUST.CIEREV.tranSubType1 = "NP"
				#}
				ENDIF
				IF(CUST.CIEREV.tranSubType == "RI") THEN
				#{
					CUST.CIEREV.tranSubType1 = "PI"
				#}
				ENDIF
				IF(CUST.CIEREV.tranSubType == "CR") THEN
				#{
					CUST.CIEREV.tranSubType1 = "CP"
				#}
				ENDIF
				
				CUST.CIEREV.txnType = "CW"
				CUST.CIEREV.scriptSuccess = "Y"
				
				CALL("cierevdp012.scr")
				
				IF(CUST.CIEREV.scriptSuccess == "N")THEN
				#{
					sv_u = urhk_dbSqlWithBind("ROLLBACK")
					print(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				CUST.CIEREV.tarDrAcctNum = CUST.CIEREV.crAcctNum
				CUST.CIEREV.tarCrAcctNum = CUST.CIEREV.vostroAcct
				print(CUST.CIEREV.tarDrAcctNum)
				print(CUST.CIEREV.tarCrAcctNum)
				
			#}
			ENDIF
		#}
		ENDIF
		
		###########################################################################################
		# Checking whether the orignal transaction is Cash Transaction or Transfer Transaction
		###########################################################################################
		
		IF(CUST.CIEREV.tranType == "T") THEN
		#{
			CUST.CIEREV.txnType = "TT"
			BANCS.INPARAM.BINDVARS= CUST.CIEREV.drAcctNum
			
			sv_s = "drBankId|SELECT bank_id"
			sv_s = sv_s + " FROM tbaadm.gam"
			sv_s = sv_s + " WHERE foracid = ?SVAR"
			
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			
			IF(sv_d == 0)THEN
			#{
				CUST.CIEREV.drBankId = BANCS.OUTPARAM.drBankId
				PRINT(CUST.CIEREV.drBankId)
				
				###########################################################################################
				# Checking whether the debit account number is in our entity or not
				###########################################################################################
				
				IF(TRIM(CUST.CIEREV.drBankId) == TRIM(BANCS.STDIN.contextBankId)) THEN
				#{
					CUST.CIEREV.drAcctNum1 = CUST.CIEREV.nostroAcct
					CUST.CIEREV.crAcctNum1 = CUST.CIEREV.drAcctNum
					CALL("cierevdp013.scr")
					CUST.CIEREV.tarDrAcctNum = CUST.CIEREV.crAcctNum
					
					CUST.CIEREV.tarCrAcctNum = CUST.CIEREV.vostroAcct
					
					#}
				ELSE
					#{
					CUST.CIEREV.drAcctNum1 = CUST.CIEREV.crAcctNum
					CUST.CIEREV.crAcctNum1 = CUST.CIEREV.nostroAcct
					CUST.CIEREV.scriptSuccess = "Y"
					
					CALL("cierevdp013.scr")
					
					IF(CUST.CIEREV.scriptSuccess == "N")THEN
					#{
						sv_u = urhk_dbSqlWithBind("ROLLBACK")
						print(sv_u)
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					CUST.CIEREV.tarDrAcctNum = CUST.CIEREV.vostroAcct
					CUST.CIEREV.tarCrAcctNum = CUST.CIEREV.drAcctNum
					CUST.CIEREV.chargeAmtPartTran = "Y"
					CUST.CIEREV.drAcctNum2= CUST.CIEREV.vostroAcct
					CUST.CIEREV.chargeAmtInTranAmtCcy = CUST.CIEREV.chrgAmtTran
					PRINT(CUST.CIEREV.chargeAmtInTranAmtCcy)
					CUST.CIEREV.tranAmtCcy=CUST.CIEREV.chargeAmtCcy
					PRINT(CUST.CIEREV.tranAmtCcy)
					
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		IF(CUST.CIEREV.scriptSuccess == "N")THEN
		#{
			#sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		PRINT(CUST.CIEREV.revTranId)
		PRINT(CUST.CIEREV.revTranDate)
		CUST.CIEREV.revTranDate = MID$(CUST.CIEREV.revTranDate,0,10)
		PRINT(CUST.CIEREV.revTranDate)
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	###########################################################################################
	# Code ended by Pankaj
	# Commented the below call
	###########################################################################################
	
	#CALL("cierevdp005.scr")
	
	
	
	###########################################################################################
	# Reverse the Init Entity Charge Tran Id
	###########################################################################################
	
	CHARGE_TRAN_ID:
		
		IF((CUST.CIEREV.chargeTranId!="No Charge") AND (CUST.CIEREV.chargeTranDate1!="")) THEN
		#{
			
			CUST.CIEREV.revChargeTranId = ""
			CUST.CIEREV.revChargeTranDate = ""
			
			CALL("cierevdp007.scr")
			
			IF(CUST.CIEREV.scriptSuccess == "N")THEN
			#{
				sv_u = urhk_dbSqlWithBind("ROLLBACK")
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			PRINT(CUST.CIEREV.revChargeTranId)
			PRINT(CUST.CIEREV.revChargeTranDate)
			#}
		ELSE
			#{
			CUST.CIEREV.revChargeTranId = ""
			CUST.CIEREV.revChargeTranDate = ""
		#}
		ENDIF
		
		######################################################################################
		# Reverse Transaction in the Other Entity Through FI Call
		######################################################################################
		
		CUST.CIEREV.revTargetTranId = ""
		CUST.CIEREV.revTargetTranDate = ""
		
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
		print(BANCS.STDIN.sysDate)
		
		sv_s = "RequestID|SELECT CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')) FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0)THEN
		#{
			CUST.CIEREV.RequestID = BANCS.OUTPARAM.RequestID
			print(CUST.CIEREV.RequestID)
			#}
		ELSE
			#{
			CUST.CIEREV.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
			print(CUST.CIEREV.RequestID)
		#}
		ENDIF
		
		
		######################################################################################
		# Code added by Pankaj
		# Fetching tran particulars for debit and credit a/cs
		######################################################################################
		
		BANCS.INPARAM.BINDVARS= CUST.CIEREV.targetTranId+"|"+MID$(CUST.CIEREV.targetTranDate,0,10)+"|"+CUST.CIEREV.tarDrAcctNum+"|"+CUST.CIEREV.targetEntity
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.targetTranId+"|"+MID$(CUST.CIEREV.targetTranDate,0,10)+"|"+CUST.CIEREV.tarDrAcctNum+"|"+CUST.CIEREV.targetEntity
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "drTranpart|SELECT tran_particular "
		sv_s = sv_s + " FROM tbaadm.dtd "
		sv_s = sv_s + " WHERE tran_id = ?SVAR "
		sv_s = sv_s + " AND tran_date = to_date(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND acid = (SELECT acid FROM tbaadm.gam "
		sv_s = sv_s + " WHERE foracid = ?SVAR)"
		sv_s = sv_s + " AND TRIM(PART_TRAN_SRL_NUM) = '2' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " UNION"
		sv_s = sv_s + " SELECT tran_particular "
		sv_s = sv_s + " FROM tbaadm.htd "
		sv_s = sv_s + " WHERE tran_id = ?SVAR "
		sv_s = sv_s + " AND tran_date = to_date(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND acid = (SELECT acid FROM tbaadm.gam "
		sv_s = sv_s + " WHERE foracid = ?SVAR)"
		sv_s = sv_s + " AND TRIM(PART_TRAN_SRL_NUM) = '2' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0)THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.drTranpart))THEN
			#{
				IF(TRIM(BANCS.OUTPARAM.drTranpart) != "")THEN
				#{
					CUST.CIEREV.drTranpart = "REV:"+BANCS.OUTPARAM.drTranpart
					CUST.CIEREV.crTranpart = CUST.CIEREV.drTranpart
					print(CUST.CIEREV.drTranpart)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		######################################################################################
		# Code added by Pankaj
		# Reverse Transaction in the Other Entity Through FI Call
		######################################################################################
		
		CUST.INTERFACE.interfaceRequestID = "XferTrnAdd"
		CUST.INTERFACE.interfaceRequestVersion = "10.2"
		CUST.INTERFACE.RequestID = CUST.CIEREV.RequestID
		CUST.INTERFACE.bankID = CUST.CIEREV.targetEntity
		CUST.INTERFACE.channelID = "COR"
		CUST.INTERFACE.tranType = "T"
		CUST.INTERFACE.tranSubType = "BI"
		print(CUST.CIEREV.tarDrAcctNum)
		CUST.INTERFACE.drAcctID = CUST.CIEREV.tarDrAcctNum
		print(CUST.CIEREV.tarCrAcctNum)
		CUST.INTERFACE.crAcctID = CUST.CIEREV.tarCrAcctNum
		
		IF((CUST.CIEREV.refCrncy != CUST.CIEREV.drAcctNumCcy0) AND (CUST.CIEREV.drAcctNumCcy0 != ""))THEN
		#{
			CUST.INTERFACE.tranAmtCr = CUST.CIEREV.refAmt
			CUST.INTERFACE.tranCcyCr = CUST.CIEREV.refCrncy
			CUST.INTERFACE.tranAmtDr = CUST.CIEREV.refAmt
			CUST.INTERFACE.tranCcyDr = CUST.CIEREV.refCrncy
			#}
		ELSE
			#{
			
			IF ((CUST.CIEREV.refCrncy != CUST.CIEREV.crAcctNumCcy0) AND (CUST.CIEREV.crAcctNumCcy0 != "")) THEN
			#{
				CUST.INTERFACE.tranAmtCr = CUST.CIEREV.tranAmt
				CUST.INTERFACE.tranCcyCr = CUST.CIEREV.crtranAmtCcy
				CUST.INTERFACE.tranAmtDr = CUST.CIEREV.tranAmt
				CUST.INTERFACE.tranCcyDr = CUST.CIEREV.crtranAmtCcy
				
				#}
			ELSE
				#{
				CUST.INTERFACE.tranAmtCr = CUST.CIEREV.tranAmt
				CUST.INTERFACE.tranCcyCr = CUST.CIEREV.tranCrncyCode
				CUST.INTERFACE.tranAmtDr = CUST.CIEREV.tranAmt
				CUST.INTERFACE.tranCcyDr = CUST.CIEREV.tranCrncyCode
			#}
			ENDIF
		#}
		ENDIF
		
		
		#CUST.INTERFACE.tranAmtCr = CUST.CIEREV.tranAmt
		#CUST.INTERFACE.tranCcyCr = CUST.CIEREV.tranCrncyCode
		#CUST.INTERFACE.tranAmtDr = CUST.CIEREV.tranAmt
		#CUST.INTERFACE.tranCcyDr = CUST.CIEREV.tranCrncyCode
		
		CUST.INTERFACE.tranParticularsCr = MID$(CUST.CIEREV.crTranpart,0,50)
		CUST.INTERFACE.tranParticularsDr = MID$(CUST.CIEREV.drTranpart,0,50)
		CUST.INTERFACE.tranRmksCr = CUST.CIEREV.tranCrncyCode + " / " + CUST.CIEREV.tranAmt + " @ " + CUST.CIEREV.rate
		CUST.INTERFACE.tranRmksCr = MID$(CUST.INTERFACE.tranRmksCr,0,30)
		CUST.INTERFACE.tranRmksDr = MID$(CUST.CIEREV.tarCrAcctNum,0,30)
		CUST.INTERFACE.drValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		
		IF(CUST.CIEREV.tranSubType1 == "RI")THEN
		#{
			CUST.INTERFACE.rateCode = CUST.CIEREV.rateCode
			CUST.INTERFACE.drRate = CUST.CIEREV.rate
			CUST.INTERFACE.crRate = CUST.CIEREV.rate
			#}
		ELSE
			#{
			CUST.INTERFACE.rateCode = ""
			CUST.INTERFACE.drRate = "1.00"
			CUST.INTERFACE.crRate = "1.00"
		#}
		ENDIF
		
		CUST.INTERFACE.chkInstDetails = "N"
		CUST.INTERFACE.instDate = ""
		CUST.INTERFACE.instAlpha = ""
		CUST.INTERFACE.instNum = ""
		CUST.INTERFACE.instType = ""
		CUST.INTERFACE.chargeAmtPartTran = "N"
		CUST.INTERFACE.errorMsgFlg = "N"
		CUST.INTERFACE.errorMsgCode = " "
		CUST.INTERFACE.errorMsgDesc = " "
		CUST.INTERFACE.errorDesc = " "
		CUST.INTERFACE.errorCode = " "
		
		IF((CUST.CIEREV.chargeAmtPartTran=="Y") AND (CUST.CIEREV.chargeTranId!="No Charge") AND (CUST.CIEREV.chargeTranDate1!=""))THEN
		#{
			CUST.INTERFACE.chargeAmtPartTran = CUST.CIEREV.chargeAmtPartTran
			CUST.INTERFACE.chargeDrAcctID = CUST.CIEREV.drAcctNum2
			CUST.INTERFACE.chargeTranAmt = CDOUBLE(CUST.CIEREV.chargeAmtInTranAmtCcy)
			CUST.INTERFACE.chargeTranCcy = CUST.CIEREV.chargeAmtCcy
			CUST.INTERFACE.chargeTranParticulars = "REV:INTER ENTITY CHARGES"
			CUST.INTERFACE.chargeTranRmks = ""
		#}
		ENDIF
		
		###########################################################################################
		# Code ended by Pankaj
		###########################################################################################
		
		#CALL("cierevmn003.scr")
		CALL("cietxnmn003.scr")
		
		IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Could not reverse the transaction in the other entity^prodCode")
			print(sv_u)
			sv_s = "Error_2|Error^"+ CUST.INTERFACE.errorDesc + "^prodCode"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		PRINT(CUST.INTERFACE.tranId)
		PRINT(CUST.INTERFACE.tranDate)
		CUST.CIEREV.entity2TranId = CUST.INTERFACE.tranId
		CUST.CIEREV.entity2TranDate = CUST.INTERFACE.tranDate
		
		CUST.CIEREV.dbStatDate = ""
		BANCS.INPARAM.BINDVARS = CUST.CIEREV.targetEntity
		sv_s = "dbStatDate|SELECT TO_CHAR(DB_STAT_DATE,'DD-MM-YYYY') FROM TBAADM.GCT WHERE BANK_ID = ?SVAR"
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0)THEN
		#{
			CUST.CIEREV.dbStatDate = BANCS.OUTPARAM.dbStatDate
			PRINT(CUST.CIEREV.dbStatDate)
			
			IF(CUST.CIEREV.entity2TranDate == "")THEN
			#{
				CUST.CIEREV.entity2TranDate = CUST.CIEREV.dbStatDate
				PRINT(CUST.CIEREV.entity2TranDate)
			#}
			ENDIF
		#}
		ENDIF
		
		######################################################################################
		# Update IETD for Txn Reversal
		######################################################################################
		
		CALL("cierevdp008.scr")
		
		IF(CUST.CIEREV.scriptSuccess == "N")THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		######################################################################################
		# Send the Result Page Details to front end
		######################################################################################
		
		CUST.CIEREV.entity1 = BANCS.STDIN.contextBankId
		CUST.CIEREV.entity1TranId = CUST.CIEREV.revTranId
		CUST.CIEREV.entity1TranDate = CUST.CIEREV.revTranDate
		
		CUST.CIEREV.entity2 = CUST.CIEREV.targetEntity
		
		sv_s = "RESULT_MSG|Inter Entity Transaction Reversed Successfully"
		sv_s = sv_s + "!" + CUST.CIEREV.entity1 + "!" + CUST.CIEREV.entity1TranId + "!" + CUST.CIEREV.entity1TranDate + "!" + CUST.CIEREV.entity2 + "!" + CUST.CIEREV.entity2TranId + "!" + CUST.CIEREV.entity2TranDate + "!" + CUST.CIEREV.revChargeTranId + "!" + CUST.CIEREV.revChargeTranDate
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_u)
		
		###########################################################################################
		# Code added by Pankaj
		###########################################################################################
		
		######################################################################################
		# Inserting Values into custom table custom.ierev
		######################################################################################
		
		BANCS.INPARAM.BINDVARS = CUST.CIEREV.ieTxnRefNo+"|"+CUST.CIEREV.tranId+"|"+CUST.CIEREV.tranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.targetTranId+"|"+CUST.CIEREV.targetTranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.chargeTranId+"|"+CUST.CIEREV.chargeTranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.entity1TranId+"|"+CUST.CIEREV.entity1TranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.entity2TranId+"|"+CUST.CIEREV.entity2TranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.revChargeTranId+"|"+CUST.CIEREV.revChargeTranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|N|Y|"+BANCS.STDIN.userId+"|"+BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_s = "INSERT INTO custom.ierev "
		sv_s = sv_s + "VALUES (?SVAR,?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),"
		sv_s = sv_s + "?SVAR,?SVAR,?SVAR,sysdate,?SVAR,sysdate,?SVAR)"
		print(sv_s)
		sv_d = urhk_dbSqlWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print("insertion failed")
			GOTO ENDOFSCRIPT
			
		#}
		ENDIF
		
		
		
	ENDOFSCRIPT:
		
END-->
