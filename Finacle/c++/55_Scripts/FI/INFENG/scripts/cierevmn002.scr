		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS +"|"+CUST.CIEREV.tranId+"|"+MID$(CUST.CIEREV.tranDate,0,10)+"|"+CUST.CIEREV.nostroAcct+"|"+BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "tranpart1,tranRmks1|SELECT tran_particular,tran_rmks "
		sv_s = sv_s + " FROM tbaadm.dtd "
