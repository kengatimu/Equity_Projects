			sv_s = sv_s + " UNION"
			sv_s = sv_s + " SELECT tran_amt "
			sv_s = sv_s + " FROM tbaadm.htd "
			sv_s = sv_s + " WHERE tran_id = ?SVAR "
			sv_s = sv_s + " AND tran_date = to_date(?SVAR,'DD-MM-YYYY') "
			sv_s = sv_s + " AND TRIM(PART_TRAN_SRL_NUM) = '2' "
			sv_s = sv_s + " AND BANK_ID = ?SVAR "
			
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF(sv_d == 0)THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.chrgAmtTran))THEN
				#{
					IF(TRIM(BANCS.OUTPARAM.chrgAmtTran) != "")THEN
