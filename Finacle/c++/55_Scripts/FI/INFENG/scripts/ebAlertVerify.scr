		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		lv_r = urhk_dbSQLWithBind(lv_d)
		PRINT(lv_r)
		IF(lv_r == 0) THEN
		#{
			EBSRV.GLBDATA.resMsg = "Alert Details Verified Successfully"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
		EBSRV.GLBDATA.errMsg = "Verification Failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF

