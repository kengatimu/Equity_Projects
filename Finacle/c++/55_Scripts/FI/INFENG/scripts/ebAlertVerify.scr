<--START

TRACE ON
callscriptifexist("ebRepClass.scr")

EBSRV.GLBDATA.recVerType = BANCS.INPUT.RecVerifyType
PRINT(EBSRV.GLBDATA.recVerType)

IF(EBSRV.GLBDATA.recVerType == "MAIN") THEN
#{
	lv_u = " update custom.cust_alerts_tbl set entity_cre_flg = 'Y', "
	lv_u = lv_u + " lchg_time = SYSDATE, "
	lv_u = lv_u + " lchg_user = ?SVAR "
	lv_u = lv_u + " where cust_id = '"+EBSRV.GLBDATA.custId+"' "
	lv_u = lv_u + " and bank_id =?SVAR "
	lv_u = lv_u + " and foracid = ?SVAR " 
	lv_u = lv_u + " and del_flg <> 'Y' "
	lv_u = lv_u + " and entity_cre_flg = 'N' "
	PRINT(lv_u)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId + "|" +  EBSRV.GLBDATA.accNo
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_r = urhk_dbSQLWithBind(lv_u)
	PRINT(lv_r)
	IF(lv_r == 0) THEN
	#{
		EBSRV.GLBDATA.resMsg = "Alert Details Verified Successfully"
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		EBSRV.GLBDATA.errMsg = "Verification Failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF
		
IF(EBSRV.GLBDATA.recVerType == "MOD") THEN
#{
	EBSRV.GLBDATA.boddate = LEFT$(BANCS.STDIN.BODDate,10)
	PRINT(EBSRV.GLBDATA.boddate)

	lv_a = "insert into custom.cust_alert_hist_tbl("
