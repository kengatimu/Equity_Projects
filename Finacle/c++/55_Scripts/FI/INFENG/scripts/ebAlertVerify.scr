	lv_a = lv_a + "lchg_time,"
	lv_a = lv_a + "lchg_user)"
	lv_a = lv_a + "select "
	lv_a = lv_a + "bank_id,"
	lv_a = lv_a + "cust_id,"
	lv_a = lv_a + "del_flg,"
	lv_a = lv_a + "entity_cre_flg,"
	lv_a = lv_a + "register_date,"
	lv_a = lv_a + "foracid,"
	lv_a = lv_a + "charge_foracid,"
	lv_a = lv_a + "dr_alert_flg,"
	lv_a = lv_a + "dr_min_amount,"
	lv_a = lv_a + "cr_alert_flg,"
	lv_a = lv_a + "cr_min_amount,"
	lv_a = lv_a + "mobile_no,"
	lv_a = lv_a + "email_address,"
	lv_a = lv_a + "activation_status,"
	lv_a = lv_a + "rcre_time,"
	lv_a = lv_a + "rcre_user,"
	lv_a = lv_a + "lchg_time,"
	lv_a = lv_a + "lchg_user "
	lv_a = lv_a + " from custom.cust_alerts_tbl "
	lv_a = lv_a + " where cust_id = '"+EBSRV.GLBDATA.custId+"'  "
	lv_a = lv_a + " and foracid = ?SVAR "
	lv_a = lv_a + " and bank_id = ?SVAR "
	#lv_a = lv_a + " and entity_cre_flg = 'Y'"
	PRINT(lv_a)

	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_a = urhk_dbSQLWithBind(lv_a)
	PRINT(lv_a)
	IF(lv_a != 0) THEN
	#{
		EBSRV.GLBDATA.errMsg = "History Table Entry Failed "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	lv_u = " update custom.cust_alerts_tbl set "
	lv_u = lv_u + " charge_foracid = ?SVAR, "
	lv_u = lv_u + " dr_alert_flg = ?SVAR, "
	lv_u = lv_u + " dr_min_amount = ?SVAR, "
	lv_u = lv_u + " cr_alert_flg = ?SVAR, "
	lv_u = lv_u + " cr_min_amount = ?SVAR, "
	lv_u = lv_u + " mobile_no = ?SVAR, "
	lv_u = lv_u + " email_address = ?SVAR, "
	lv_u = lv_u + " activation_status = ?SVAR, "
	lv_u = lv_u + " lchg_time = SYSDATE ,"
	lv_u = lv_u + " lchg_user = ?SVAR "
	lv_u = lv_u + " where cust_id ='"+EBSRV.GLBDATA.custId+"' "
	lv_u = lv_u + " and foracid = ?SVAR "
	lv_u = lv_u + " and bank_id = ?SVAR "
	lv_u = lv_u + " and del_flg <> 'Y' "
	lv_u = lv_u + " and entity_cre_flg = 'Y' "
	PRINT(lv_u)

	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.chrgAcc +"|"+ EBSRV.GLBDATA.drAlerts +"|"+ EBSRV.GLBDATA.minDrAmt +"|"+ EBSRV.GLBDATA.crAlerts
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ EBSRV.GLBDATA.minCrAmt +"|"+ EBSRV.GLBDATA.phNum +"|"+ EBSRV.GLBDATA.email
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ EBSRV.GLBDATA.activateFlag +"|"+ BANCS.STDIN.userId +"|"+ EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_r = urhk_dbSQLWithBind(lv_u)
	PRINT(lv_r)

	IF(lv_r == 0) THEN
	#{
		lv_d = "delete from custom.cust_alert_mod_tbl "
		lv_d = lv_d + " where cust_id = '"+EBSRV.GLBDATA.custId+"' "
		lv_d = lv_d + " and foracid = ?SVAR "
