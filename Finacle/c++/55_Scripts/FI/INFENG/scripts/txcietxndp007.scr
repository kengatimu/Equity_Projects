##########################################################################################
# Checking credit balance for Faiba (Balance limit should not exceed the 100000)
##########################################################################################

sv_q=""
sv_q = " cr_sol,acct_own | select sol_id,acct_ownership from tbaadm.gam where foracid=?SVAR"
BANCS.INPARAM.BINDVARS=CUST.CIETXN.crAcctNum
print(BANCS.INPARAM.BINDVARS)

print(sv_q)

sv_d = urhk_dbSelectWithBind(sv_q)
PRINT(sv_d)

        IF (sv_d == 0) THEN
        #{

                CUST.CIETXN.cr_sol = BANCS.OUTPARAM.cr_sol
                CUST.CIETXN.acct_own = BANCS.OUTPARAM.acct_own
                PRINT(CUST.CIETXN.cr_sol)
                PRINT(CUST.CIETXN.acct_own)
		ELSE
		#KenVp
				CUST.CIETXN.acct_own	= ""
				CUST.CIETXN.cr_sol	= ""
				print("Invalid Credit Account Number")
				CUST.DATA.errMsgs="Invalid Credit Account Number "  + CUST.CIETXN.crAcctNum
				sv_e=urhk_SetOrbOut("StattusCode|5")
				sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsgs)
				sv_u =urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.CIETXN.scriptSuccess = "N"
				BANCS.OUTPUT.successOrFailure= "F"
				exitscript
        #}
        ENDIF

CUST.CIETXN.AcctID = CUST.CIETXN.crAcctNum
