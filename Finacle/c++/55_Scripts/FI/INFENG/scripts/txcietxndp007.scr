############################################################
	########## Get the Vostro Account Id #######################
	############################################################
	CUST.CIETXN.parameterId = "CD_VOSTRO_" + BANCS.INPUT.crAcctNumEntityId
	print(CUST.CIETXN.parameterId)
		sv_s = "vostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Account Currency Code;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.bacid = BANCS.OUTPARAM.vostroAcct
		print(CUST.CIETXN.bacid)
		
		IF(CUST.CIETXN.bacid!= "") THEN
			CUST.CIETXN.creditEntity = BANCS.INPUT.crAcctNumEntityId

			CUST.CIETXN.inputBankId = BANCS.INPUT.crAcctNumEntityId
			PRINT(CUST.CIETXN.inputBankId)
			CUST.CIETXN.inputBacid = CUST.CIETXN.bacid 
			PRINT(CUST.CIETXN.inputBacid)
			CUST.CIETXN.inputSolId = BANCS.STDIN.mySolId
			PRINT(CUST.CIETXN.inputSolId)
			CUST.CIETXN.inputCcy = BANCS.INPUT.drAcctNumCcy
			#CUST.CIETXN.inputCcy = "USD"
			PRINT(CUST.CIETXN.inputCcy)
			CUST.CIETXN.inputBacidOrForacid = CUST.CIETXN.bacid
			PRINT(CUST.CIETXN.inputBacidOrForacid)
			call("tzmxcietxndp032.scr")
			CUST.CIETXN.crAcctNumCcy = CUST.CIETXN.outputForacid
			PRINT(CUST.CIETXN.crAcctNumCcy)

		ENDIF



