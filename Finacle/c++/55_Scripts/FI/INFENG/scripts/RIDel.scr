			##########  CHECK IF USER ID AND BANK_ID COMBINATION EXISTS IN UDT TABLE  ##############
			
				BANCS.INPARAM.BINDVARS = CUST.RIDEL.v_userid + "|" + CUST.RIDEL.bankId
				sv_s = "valUser|"
				sv_s = sv_s + " SELECT USER_ID"
				sv_s = sv_s + " FROM FINRIADM.UDT"
				sv_s = sv_s + " WHERE UPPER(USER_ID) =UPPER(?SVAR)"
				sv_s = sv_s + " AND BANK_ID = ?SVAR"
				
				print(sv_s)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				
				IF (sv_d != 0) THEN
			
					sv_a = "RIDel_RES.Status|ERROR"
