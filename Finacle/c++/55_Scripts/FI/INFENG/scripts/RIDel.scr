		################################ UPDATE DEL_FLG IN UDT ##################################

			BANCS.INPARAM.BINDVARS = CUST.RIDEL.v_userid + "|" + CUST.RIDEL.bankId
			sv_s = "UPDATE FINRIADM.UDT SET DEL_FLAG='Y',TS_CNT = TS_CNT+1 WHERE USER_ID = ?SVAR AND BANK_ID = ?SVAR"
