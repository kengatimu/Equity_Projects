<--START
CHECKSUM="ca8c20a4ef9b7e075c095f84144ce10b4d8cbcc9ffc2041395bbe2b092892fac"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.refCrncy = " "
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.refCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.refCrncy) != "")THEN
		#{
			CUST.CIETXN.refCrncy = TOUPPER(TRIM(BANCS.INPUT.refCrncy))
			print(CUST.CIETXN.refCrncy)
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s = "recCount|"
	sv_s = sv_s + " SELECT 1 FROM DUAL WHERE EXISTS("
	sv_s = sv_s + " SELECT 1 FROM TBAADM.CNC"
	sv_s = sv_s + " WHERE CRNCY_CODE = ?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	sv_s = sv_s + " AND BANK_ID = ?SVAR)"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.refCrncy + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Invalid Ref. CCY"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(sv_u)
		
END-->
