		PRINT("STEP1")
  		CUST.SI.siSrlNum = BANCS.OUTPARAM.siSrlNum
		print(CUST.SI.siSrlNum)

		sv_u = urhk_SetUrhkInp("siHdr.siSrlNum|"+CUST.SI.siSrlNum)

		sv_u = urhk_ExecSrv("SRV_FetchSIForVerify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)

		IF(sv_u==0)THEN
		#{
			PRINT("STEP 2")
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_VerifySI|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF(sv_u==0)THEN
			#{
				PRINT("VERIFIED")
   				CUST.SI.Msg=CUST.SI.siSrlNum
				sv_t = "MSG| " +CUST.SI.Msg
				sv_u = urhk_SetOrbOut(sv_t)

			#}
			ELSE
			#{
				GOTO CHECKERROR

			#}
			ENDIF

		#}
		ELSE
		#{
			GOTO CHECKERROR

		#}
		ENDIF


	#}
	ELSE
	#{
		GOTO CHECKERROR

	#}
	ENDIF

	CHECKERROR:

	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				PRINT(sv_f)
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				#Error response
				sv_t = "ERROR|"  +sv_e
				sv_u = urhk_SetOrbOut(sv_t)

				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>loanMgr.log")
				print(sv_u)
				GOTO ENDSCRIPT
				

			#}
			DO
			#}
		ENDIF
	#}
	ENDIF


ENDSCRIPT:

trace off

end-->
