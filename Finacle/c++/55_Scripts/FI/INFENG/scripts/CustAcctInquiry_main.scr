<--start
trace on
#sv_a = urhk_B2k_PrintRepos("BANCS")
#print(sv_a)
	#-------------------------------------------------------------------------------
	# Calling create repository script
	#-------------------------------------------------------------------------------
	CALL("Common_Interface_CreateRepos.scr")
	CUST.INTERFACE.successOrFailure = "S"
	CUST.INTERFACE.srvErrFlg = "N"
	CUST.INTERFACE.checkGL = "N"
	#-------------------------------------------------------------------------------
	# Fetching Input Fields from FI
	#-------------------------------------------------------------------------------
	
	CALL("CustAcctInquiry_FetchInputDetails.scr")
	IF (CUST.INTERFACE.checkGL == "Y") THEN
		print(CUST.INTERFACE.checkGL)
		GOTO ERROREXIT
	ENDIF
	
	#-------------------------------------------------------------------------------
	# Validating Input Fields
	#-------------------------------------------------------------------------------
	CALL("CustAcctInquiry_ValidateInputDetails.scr")
	
	IF(CUST.INTERFACE.specialCase == "N") THEN
	#{
		#-------------------------------------------------------------------------------
		# Fetching the customer details
		#-------------------------------------------------------------------------------
		CALL("CustAcctInquiry_FetchCustomerDetails.scr")
		
		#-------------------------------------------------------------------------------
		# Fetching all the accounts and its details
		#-------------------------------------------------------------------------------
		CALL("CustAcctInquiry_FetchAccountDetails.scr")
	
		#-------------------------------------------------------------------------------
		# Send Response
		#-------------------------------------------------------------------------------
		CALL("CustAcctInquiry_SendResponse.scr")
	#}
	ELSE
	#{
		sv_p = 0
		WHILE(GETPOSITION(CUST.INTERFACE.tempCifId,",") != 0)
		#{
			CUST.INTERFACE.customerID = MID$(CUST.INTERFACE.tempCifId,0,GETPOSITION(CUST.INTERFACE.tempCifId,",") -1)
    		print(CUST.INTERFACE.customerID)
			
			#-------------------------------------------------------------------------------
			# Fetching the customer details
			#-------------------------------------------------------------------------------
			CALL("CustAcctInquiry_FetchCustomerDetails.scr")
			
			#-------------------------------------------------------------------------------
			# Fetching all the accounts and its details
			#-------------------------------------------------------------------------------
			CALL("CustAcctInquiry_FetchAccountDetails.scr")
		
			#-------------------------------------------------------------------------------
			# Send Response
			#-------------------------------------------------------------------------------
			CALL("CustAcctInquiry_SendResp.scr")
			sv_p = sv_p + 1
			CUST.INTERFACE.tempCifId = MID$(CUST.INTERFACE.tempCifId,GETPOSITION(CUST.INTERFACE.tempCifId,","), STRLEN(CUST.INTERFACE.tempCifId))	
			print(CUST.INTERFACE.tempCifId)
		#}
		DO	
		
	
	#}
	ENDIF
	ENDOFSPCLCASE:
	ERROREXIT:
	IF(CUST.INTERFACE.successOrFailure == "F") THEN
	#{
	    CALL("Common_Interface_ErrorExit.scr")
	#}
	ENDIF

	IF (REPEXISTS("CUST")!=0) then
		DELETEREP("CUST")
		print("DEL REP")
	ENDIF
	
trace off
end-->
