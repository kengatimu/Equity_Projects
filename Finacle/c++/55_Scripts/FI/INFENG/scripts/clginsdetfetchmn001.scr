<--START
CHECKSUM="7254757d0e584ed79608d80ec01517b0521551bfb2bf38fe9f0a3dd41a2764cc"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	# Initializing the variables
	#------------------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","MISC") == 0) THEN
	#{
		CREATECLASS("CUST","MISC",5)
	#}
	ENDIF
	#--------------------------------------------------------------------------------
	# To populate the values
	#--------------------------------------------------------------------------------
	
	CUST.MISC.micrstring = BANCS.INPUT.micrstring
	
	CUST.MISC.instInstrNum= MID$(CUST.MISC.micrstring,1,6)
	print(CUST.MISC.instInstrNum)
	
	CUST.MISC.instBankCode= MID$(CUST.MISC.micrstring,8,2)
	PRINT(CUST.MISC.instBankCode)
	
	CUST.MISC.instBranchCode= MID$(CUST.MISC.micrstring,10,3)
	PRINT(CUST.MISC.instBranchCode)
	
	CUST.MISC.instRepsCode = MID$(CUST.MISC.micrstring,13,1)
	PRINT(CUST.MISC.instRepsCode)
	
	CUST.MISC.instTranCode = MID$(CUST.MISC.micrstring,15,2)
	PRINT(CUST.MISC.instTranCode)
	
	CUST.MISC.instPayingAcct	= MID$(CUST.MISC.micrstring,18,10)
	PRINT(CUST.MISC.instPayingAcct)
	
	CUST.MISC.instPayingAcct = TRIM(CUST.MISC.instPayingAcct)
	PRINT(CUST.MISC.instPayingAcct)
	
	sv_c = STRLEN(CUST.MISC.instPayingAcct)
	PRINT(sv_c)
	IF (sv_c < 10) THEN
	#{
		PRINT(sv_c)
		sv_c = 10 - sv_c
		print(sv_c)
		
		CUST.MISC.instPayingAcct = LPAD(CUST.MISC.instPayingAcct,10,'0')
		PRINT(CUST.MISC.instPayingAcct)
	#}
	ENDIF
	
	
	sv_b = "val1|" +  CUST.MISC.instInstrNum
	sv_z = urhk_SetOrbOut(sv_b)
	PRINT(sv_z)
	
	sv_b = "val2|" +  CUST.MISC.instRepsCode
	sv_z = urhk_SetOrbOut(sv_b)
	PRINT(sv_z)
	
	sv_b = "val3|" +  CUST.MISC.instPayingAcct
	sv_z = urhk_SetOrbOut(sv_b)
	PRINT(sv_z)
	
	sv_b = "val4|" +  CUST.MISC.instBankCode
	sv_z = urhk_SetOrbOut(sv_b)
	PRINT(sv_z)
	
	sv_b = "val5|" +  CUST.MISC.instBranchCode
	sv_z = urhk_SetOrbOut(sv_b)
	PRINT(sv_z)
	
	sv_b = "val6|" +  CUST.MISC.instTranCode
	sv_z = urhk_SetOrbOut(sv_b)
	PRINT(sv_z)
	
	EXITSCRIPT
	TRACE OFF
END-->
