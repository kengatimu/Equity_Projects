<--START
CHECKSUM="6a5d22e795f6eb5363ae1058dbd2ed39516d0a0279fc87b375eae1888fda7974"
	TRACE ON
	sv_s  = "lv_setdesc|"
	sv_s  = sv_s  + "SELECT set_desc "
	sv_s  = sv_s  + "FROM TBAADM.STID "
	sv_s  = sv_s  + "WHERE set_id = ?SVAR "
	sv_s  = sv_s  + "AND Bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.lv_setid + "|" + BANCS.STDIN.contextBankId
	
	sv_u = urhk_dbselectWithBind(sv_s)
	
	IF ( sv_u == "0" ) THEN
	#{
		BANCS.OUTPUT.lv_setdesc = TRIM(BANCS.OUTPARAM.lv_setdesc)
		PRINT (BANCS.OUTPUT.lv_setdesc)
		BANCS.OUTPUT.lv_userId = BANCS.STDIN.userId
		PRINT (BANCS.OUTPUT.lv_userId)
		#}
	ELSE
		#{
		BANCS.OUTPUT.lv_setdesc = " "
		BANCS.OUTPUT.lv_userId = " "
	#}
	ENDIF
	
	EXITSCRIPT
	TRACE OFF
END-->
