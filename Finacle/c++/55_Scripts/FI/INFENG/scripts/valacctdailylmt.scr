 <--START
  TRACE ON

IF (REPEXISTS("CUST") == 0 ) THEN
#{
	CREATEREP("CUST")
#}
ENDIF
IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
	CREATECLASS("CUST","DATA",5)
#}
ENDIF

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)

if (BANCS.STDIN.contextBankId == 54) then 
	if (BANCS.STDIN.menuId=="HDDMI") then 
		CUST.DATA.DebitLimit = "50000.00"
		PRINT(CDOUBLE(CUST.DATA.DebitLimit))
		CUST.DATA.DebitLimit1=(CDOUBLE(CUST.DATA.DebitLimit) * (-1.00))
		print (cdouble(CUST.DATA.DebitLimit1))
	
   BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId 
   PRINT(BANCS.INPARAM.BINDVARS)
   sv_s= "ClrBal|"
   sv_s= sv_s + " select clr_bal_amt from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR "
   print (sv_s)
   sv_d = urhk_dbSelectWithBind(sv_s)
   PRINT(sv_d)
	if (sv_d == 0) then
		CUST.DATA.clrBal= CDOUBLE(BANCS.OUTPARAM.ClrBal) 
		print (CDOUBLE(CUST.DATA.clrBal))

			if (CDOUBLE(CUST.DATA.clrBal) < cdouble(CUST.DATA.DebitLimit1) )  then
		#{
			sv_s = urhk_SRV_SetErr("account balance exceeds set limit" )
			print (sv_s)
			GOTO END
		#}
			endif
	endif

  sv_s = "sum|"
  sv_s = sv_s + "select sum(tran_amt) from tbaadm.dtd where PART_TRAN_TYPE='D' and del_flg='N' " 
  sv_s = sv_s + "and acid in ( select acid from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR ) and bank_id=?SVAR "
  print (sv_s)
  BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
  PRINT(BANCS.INPARAM.BINDVARS)
  sv_d = urhk_dbSelectWithBind(sv_s)
  PRINT(sv_d)
   
   print (CUST.DATA.totPurDDAmt)
   print (CDOUBLE(CUST.DATA.totPurDDAmt))

		IF (sv_d == 0) THEN
				#{
						CUST.DATA.sum= ((CDOUBLE(BANCS.OUTPARAM.sum)) + (CDOUBLE(CUST.DATA.totPurDDAmt)))
						PRINT(CDOUBLE(CUST.DATA.sum))
						CUST.DATA.TOTALSUM=((CDOUBLE(CUST.DATA.sum) * (-1.00)) + (CDOUBLE(CUST.DATA.clrBal)))
						print (CDOUBLE(CUST.DATA.TOTALSUM))

						if (CDOUBLE(CUST.DATA.TOTALSUM) < CDOUBLE(CUST.DATA.DebitLimit1))  then
						#{
							sv_s = urhk_SRV_SetErr("total debit exceeds set limit " + CUST.DATA.DebitLimit )
							print (sv_s)
							GOTO END
						#}
						endif
		endif
	endif
endif

    TRACE OFF	
END-->