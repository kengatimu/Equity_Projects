		#{
		PRINT(BANCS.OUTPARAM.custcount)
		IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	sv_s="foracid|"
	sv_s = sv_s + " SELECT f.FORACID FROM tbaadm.ACD B ,tbaadm.GAM F,tbaadm.GAC M,tbaadm.ITC e,(select  max(INT_TBL_CODE_SRL_NUM)max_srl ,entity_id,bank_id from    tbaadm.itc  where   bank_id='54'  group by entity_id,bank_id)A WHERE F.ACID=b.B2K_ID AND E.ENTITY_ID =b.B2K_ID AND F.ACID=E.ENTITY_ID "
	sv_s = sv_s + " AND b.B2K_ID=M.ACID AND B.B2K_TYPE='ACCNT' AND F.SCHM_TYPE IN ('SBA','CAA') AND F.BANK_ID=?SVAR AND B.BANK_ID=?SVAR AND M.BANK_ID=?SVAR AND E.BANK_ID =?SVAR AND B.B2K_TYPE =E.ENTITY_TYPE and  A.entity_id=F.ACID and  A.BANK_ID=F.BANK_ID"
	sv_s = sv_s + " AND M.CHRGE_OFF_FLG !='Y'  AND M.DPD_CNTR<365 AND E.INT_TBL_CODE_SRL_NUM=max_srl and B.SUB_CLASSIFICATION_SYSTEm NOT in ('LOSSC','LOSSS','LOSS','DBTL','SUBS') and f.sol_id =?SVAR AND E.INT_TBL_CODE='ZEROC' "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUST.LNTMN.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUST.LNTMN.DbcursorNumber)
		PRINT(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUST.LNTMN.foracid	= BANCS.OUTPARAM.foracid
			CUST.LNTMN.custpref	= "0"
			CUST.LNTMN.acctpref	= "0"
			PRINT(CUST.LNTMN.foracid)
			PRINT(CUST.LNTMN.custpref)
			PRINT(CUST.LNTMN.acctpref)
		

			#------------------------------------------------------------------------------------------------------------------------
                        #Getting the current interest table code
                        #------------------------------------------------------------------------------------------------------------------------
                        sv_s="code|"
                        sv_s = sv_s + " SELECT INT_TBL_CODE FROM TBAADM.ITC WHERE "
                        sv_s = sv_s + " BANK_ID=?SVAR AND ENTITY_ID=(select acid from tbaadm.gam where bank_id='54' and acid=itc.entity_id and foracid=?SVAR ) order by INT_TBL_CODE_SRL_NUM desC "
                        sv_s = sv_s + " OFFSET 0 ROWS FETCH NEXT 1 ROWS ONLY "
                        print(sv_s)

                        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.LNTMN.foracid
                        print(BANCS.INPARAM.BINDVARS)

                        sv_d = urhk_dbSelectWithBind(sv_s)
                 	IF(sv_d==0)THEN
                        #{
                                CUST.LNTMN.code= BANCS.OUTPARAM.code
                                print(CUST.LNTMN.code)
                   	ENDIF 
			IF(CUST.LNTMN.code == "ZEROC")THEN	
			#----------------------------------------------------------------------------------------------------
			# Modify and verify using services
			#----------------------------------------------------------------------------------------------------
			sv_u = urhk_SetUrhkInp("IntTblCrit.entityType.type|ACCNT")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("IntTblCrit.entityId.entityDispId|" + CUST.LNTMN.foracid)
			PRINT(sv_u)
			
			sv_u = urhk_ExecSrv("SRV_FetchIntTblDtlForModify|retain_all_output = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				#new porting changes
				##
				CUST.LNTMN.acctprefcrd = "0"
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.acctPrefIntCr|" + CUST.LNTMN.acctprefcrd)
				PRINT(sv_u)
				CUST.LNTMN.custprefcrd = "0"
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.custPrefIntCr|" + CUST.LNTMN.custprefcrd)
				PRINT(sv_u)
				##
				CUST.LNTMN.acctpref = "0"
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.acctPrefIntDr|" + CUST.LNTMN.acctpref)
				PRINT(sv_u)
				CUST.LNTMN.custpref = "0"
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.custPrefIntDr|" + CUST.LNTMN.custpref)
				PRINT(sv_u)
				
				
				sv_s="acctopndate|"
				sv_s = sv_s + " SELECT TO_CHAR(db_stat_date,'DD-MM-YYYY') "
				sv_s = sv_s + " FROM tbaadm.gct "
				sv_s = sv_s + " WHERE bank_id= ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)

				IF (sv_d == 0) THEN
				#{
					CUST.CPARAM.acctopndate  = BANCS.OUTPARAM.acctopndate
					PRINT(CUST.CPARAM.acctopndate)
					#sos/CHG0032139
					#CUST.CPARAM.acctopndate  = "21-09-2022"
					#PRINT(CUST.CPARAM.acctopndate)
				#}
				ENDIF

				CUST.CPARAM.startDate=CUST.CPARAM.acctopndate
				PRINT(CUST.CPARAM.startDate)

				PRINT(CUST.CPARAM.startDate)
				
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.startDate|" + CUST.CPARAM.startDate)
				PRINT(sv_u)
				###############
				sv_h = urhk_getAcctDetailsInRepository(CUST.LNTMN.foracid)
				PRINT(sv_h)
				IF (sv_h==0) THEN
				#{
					CUST.LNTMN.solidsh = BANCS.OUTPARAM.acctSolId
					PRINT(CUST.LNTMN.solidsh)
					CUST.LNTMN.schmcodesh = BANCS.OUTPARAM.schmCode
					PRINT(CUST.LNTMN.schmcodesh)
					CUST.LNTMN.schmType = BANCS.OUTPARAM.schmType
					PRINT(CUST.LNTMN.schmType)
					sv_s="gspschm_code,int_tbl_code,min_int_pcnt_dr,max_int_pcnt_dr|"
					sv_s = sv_s + " SELECT gsp.SCHM_CODE,INT_TBL_CODE,MIN_INT_PCNT_DR,MAX_INT_PCNT_DR FROM TBAADM.csp,TBAADM.gsp WHERE gsp.SCHM_CODE=csp.SCHM_CODE AND csp.CRNCY_CODE='KES' AND gsp.BANK_ID=?SVAR "
					sv_s = sv_s + " AND csp.BANK_ID=?SVAR AND gsp.del_flg='N' AND gsp.schm_type in('SBA','CAA') AND gsp.schm_code =?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.LNTMN.schmcodesh
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUST.LNTMN.int_tbl_code	= BANCS.OUTPARAM.int_tbl_code
						PRINT(CUST.LNTMN.int_tbl_code)
						CUST.CPARAM.intTblCode=CUST.LNTMN.int_tbl_code
						PRINT(CUST.CPARAM.intTblCode)
						CUST.LNTMN.min_int_pcnt_dr= BANCS.OUTPARAM.min_int_pcnt_dr
						PRINT(CUST.LNTMN.min_int_pcnt_dr)
						CUST.CPARAM.minIntDr=CUST.LNTMN.min_int_pcnt_dr
						PRINT(CUST.CPARAM.minIntDr)
						CUST.LNTMN.max_int_pcnt_dr= BANCS.OUTPARAM.max_int_pcnt_dr
						PRINT(CUST.LNTMN.max_int_pcnt_dr)
						CUST.CPARAM.maxIntDr=CUST.LNTMN.max_int_pcnt_dr
						PRINT(CUST.CPARAM.maxIntDr)
						#CUST.CPARAM.intTblCode = "INTCA"
						sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.intTblCode.tblCode|" + CUST.CPARAM.intTblCode)
						PRINT(sv_u)
						#new porting changes
						CUST.CPARAM.minIntDr = "0"
						sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.minIntDr|" + CUST.CPARAM.minIntDr)
						PRINT(sv_u)
						#CUST.CPARAM.maxIntDr="13"
						sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.maxIntDr|" + CUST.CPARAM.maxIntDr)
						PRINT(sv_u)
					#}
					ENDIF
				#}
				ENDIF
				###############
				sv_u = urhk_ExecSrv("SRV_ModifyIntTblDtlAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF(sv_u == 0) THEN
				#{
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					sv_s = "UPDATE TBAADM.GAM "
					sv_s = sv_s + " SET GAM.INT_COLL_FLG='Y'"
					sv_s = sv_s + " WHERE GAM.FORACID=?SVAR"
					sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.LNTMN.foracid + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						PRINT(sv_c)
					#}
					ENDIF
				#}
				ENDIF
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_u = SYSTEM("echo 'Error for Acct:"+CUST.LNTMN.foracid+" ' >>casaintmodtableC.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_i = sv_i + 1
