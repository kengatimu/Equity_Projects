###################################################################################################################
#---------------------------------------- CONFIRM IF THE DATA EXISTS IN CUSTOM TABLE ---------------------------#
###################################################################################################################

BANCS.INPARAM.BINDVARS = CUST.ACCTOPENLA.userId + "|" + CUST.ACCTOPENLA.contextBankId + "|" + CUST.ACCTOPENLA.mySolId
PRINT(BANCS.INPARAM.BINDVARS)
sv_s = "COUNT|"
sv_s = sv_s + " SELECT COUNT(*)"
sv_s = sv_s + " FROM CUSTOM.TEMP_MIS_CODES"
sv_s = sv_s + " WHERE USER_ID = ?SVAR"
sv_s = sv_s + " AND BANK_ID = ?SVAR"
sv_s = sv_s + " AND SOL_ID = ?SVAR"
sv_s = sv_s + " AND ENTITY_CRE_FLG = 'N'"
PRINT(sv_s)

sv_d =  urhk_dbSelectWithBind(sv_s)
PRINT(sv_d)
IF (sv_d == 0 ) THEN
#{
	CUST.ACCTOPENLA.Count = BANCS.OUTPARAM.COUNT
	PRINT(CUST.ACCTOPENLA.Count)

	IF (CINT(CUST.ACCTOPENLA.Count) == 0) THEN
	#{
		GOTO TEMPTABLEINSERT
	#}
	ELSE
	#{
		CUST.ACCTOPENLA.sucFail = "N"
		CUST.ACCTOPENLA.retMsg = "Data Exists"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	###################################################################################################################
	#---------------------------------------- INSERTING A NEW ACCOUNT ------------------------------------------------#
	###################################################################################################################
#}
ELSE
#{
	CUST.ACCTOPENLA.sucFail = "N"
	CUST.ACCTOPENLA.retMsg = "Data Exists"
	GOTO ENDOFSCRIPT
#}
ENDIF


###################################################################################################################
#-----------------------------------------------------------------------------------------------------------------#
###################################################################################################################
TEMPTABLEINSERT:
	BANCS.INPARAM.BINDVARS = CUST.ACCTOPENLA.userId + "|" + CUST.ACCTOPENLA.contextBankId + "|" + CUST.ACCTOPENLA.mySolId + "|N|" + CUST.ACCTOPENLA.BODDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText16
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText17
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText18
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText19
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText20
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText21
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText22
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText23
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText24
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ACCTOPENLA.misFreeText25
	print(BANCS.INPARAM.BINDVARS)

	sv_s =  "INSERT INTO CUSTOM.TEMP_MIS_CODES("
	sv_s = sv_s + " USER_ID, BANK_ID, SOL_ID, ENTITY_CRE_FLG, RCRE_TIME,"
    sv_s = sv_s + " FREE_TEXT_16, FREE_TEXT_17, FREE_TEXT_18, FREE_TEXT_19, FREE_TEXT_20, FREE_TEXT_21, FREE_TEXT_22, FREE_TEXT_23, FREE_TEXT_24, FREE_TEXT_25)"
	sv_s = sv_s + " VALUES( "
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
	sv_s = sv_s + " ?SVAR, TO_DATE(?SVAR, 'DD-MM-YYYY HH24:MI:SS'), ?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR )"
	sv_d = urhk_dbSQLWithBind(sv_s)

	PRINT(sv_d)

	IF(sv_d==0)THEN
	#{
		sv_d = urhk_dbSqlWithBind("COMMIT")
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.ACCTOPENLA.sucFail = "N"
		CUST.ACCTOPENLA.retMsg = "Failed to insert into the temp table"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

ENDOFSCRIPT:
	IF(CUST.ACCTOPENLA.sucFail == "N") THEN
	#{
		print(CUST.ACCTOPENLA.retMsg)
		print(CUST.ACCTOPENLA.sucFail)

		sv_u = urhk_SetOrbOut("retMsg|" + CUST.ACCTOPENLA.retMsg)
		sv_u = urhk_SetOrbOut("sucFail|" + CUST.ACCTOPENLA.sucFail)
		sv_u = urhk_SetOrbOut("fieldId| ")
	#}
	ELSE
	#{
		sv_u = urhk_SetOrbOut("retMsg| ")
		sv_u = urhk_SetOrbOut("sucFail|" + CUST.ACCTOPENLA.sucFail)
		sv_u = urhk_SetOrbOut("fieldId| ")
	#}
	ENDIF

EXITSCRIPT
TRACE OFF
