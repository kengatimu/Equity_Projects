	PRINT(("BANCS").("INPUT").(sv_x))
	CUST.INTERFACE.RunType = ("BANCS").("INPUT").(sv_x)
	
	
	# Get the input file path
	CUST.INTERFACE.InputFileWithPath = CUST.INTERFACE.upldPath + "/" + CUST.INTERFACE.inputFile
	
