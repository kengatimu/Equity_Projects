                			PRINT(sv_u)
					GOTO SUCCESSEXIT
				#}
				endif
			#}
			ENDIF
			sv_j = sv_j +1
                        print(sv_j)	
			#}
                        DO	
			sv_c = urtn_fileClose(CUST.INTERFACE.fileindex)
			PRINT(sv_c)
			
			#}
		ELSE
			#{
			if(sv_d == "F") then
			#{
			CUST.INTERFACE.SuccessOrFailure="N"
			CUST.INTERFACE.tranId = "Please refer Finacle Logs"
			CUST.INTERFACE.ErrorDesc = "Please refer Finacle logs"
			GOTO ENDOFSCRIPT
			#}
			endif
		#}
		ENDIF
		
		
		#sv_z = "TtumExec_RES.Status|SUCCESS"
		#sv_u = urhk_SetOrbOut(sv_z)
		#sv_z = "TtumExec_RES.TranId|"+ CUST.INTERFACE.tranId
		#sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
