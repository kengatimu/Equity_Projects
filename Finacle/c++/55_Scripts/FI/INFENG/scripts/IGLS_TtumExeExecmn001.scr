				sv_m = GETPOSITION(CUST.INTERFACE.buffer,"Tran Id")
				PRINT(sv_m)
				if(sv_m !=0)then
				#{
					
                			CUST.INTERFACE.tranId = LTRIM(MID$(CUST.INTERFACE.buffer,(GETPOSITION(CUST.INTERFACE.buffer,":")),sv_s))
                			print(CUST.INTERFACE.tranId)
				#}
				endif

				sv_w = GETPOSITION(CUST.INTERFACE.buffer,"successfully")
				PRINT(sv_w)
				if(sv_w !=0)then
				#{	
					sv_d = "S"
					sv_z = "TtumExec_RES.Status|SUCCESS"
                			sv_u = urhk_SetOrbOut(sv_z)
