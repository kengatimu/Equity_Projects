	PRINT(CUST.INTERFACE.write_msg)
	
	sv_l = "echo '" +CUST.INTERFACE.write_msg+ "'"
	sv_l = sv_l + " >> " + CUST.INTERFACE.DATFLE
	PRINT(sv_l)
	sv_g = SYSTEM(sv_l)
	PRINT(sv_g)
	
	CUST.INTERFACE.write_msg=""
	
	CUST.INTERFACE.write_msg = " report_to tran_sub_type inp_file_name fire_bfti_flg remarks rename_inp_file h_script_name h_mrt_success h_mrt_fail rmi"
	PRINT(CUST.INTERFACE.write_msg)
	
