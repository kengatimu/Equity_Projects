#-----------------------------------------------------------------------------------------------

<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","TDCLS") == 0) THEN
        #{
                CREATECLASS("CUST","TDCLS",5)
        #}
        ENDIF

        sv_a=urhk_B2k_PrintRepos("BANCS")
        print (sv_a)

        IF( (FIELDEXISTS(("BANCS").("INPUT").("FORACID"))== 0) ) THEN
        #{
            CUST.TDCLS.errMsg="FORACID IS NULL"
            sv_t = urhk_SetOrbOut("SuccessOrFailure|N")
            sv_j = "ERROR | " +CUST.TDCLS.errMsg
            sv_u = urhk_SetOrbOut(sv_j)
            GOTO ENDSCRIPT
        #}
        ENDIF

        CUST.TDCLS.FORACID= TRIM(BANCS.INPUT.FORACID)
        print(CUST.TDCLS.FORACID)

        sv_a = urhk_getAcctDetailsInRepository(CUST.TDCLS.FORACID)

        IF(sv_a == 0) THEN
        #{
            CUST.TDCLS.solid = BANCS.OUTPARAM.acctSolId
            print(CUST.TDCLS.solid)
            CUST.TDCLS.EffAvailableAmt = TRIM(BANCS.OUTPARAM.EffAvailableAmt)
            print(CUST.TDCLS.EffAvailableAmt)
            CUST.TDCLS.schmType = BANCS.OUTPARAM.schmType
            print(CUST.TDCLS.schmType)
            CUST.TDCLS.cncyCode=BANCS.OUTPARAM.acctCrncyCode
            print(CUST.TDCLS.cncyCode)

            sv_a=urhk_B2k_ForacidToAcid(CUST.TDCLS.FORACID)
            IF(sv_a == 0) THEN
            #{
                CUST.TDCLS.Acid=BANCS.OUTPARAM.Acid
                print(CUST.TDCLS.Acid)
            #}
            ENDIF
            #Get the operative account
            sv_k= "operacctno, accname,acctOpnDate,acctMaturDate,newSysdate|SELECT foracid, acct_name,to_char(OPEN_EFFECTIVE_DATE,'dd-mm-yyyy'),to_char(MATURITY_DATE,'dd-mm-yyyy'),to_char(sysdate,'dd-mm-yyyy') "
            sv_k=sv_k +" from tbaadm.gam g, tbaadm.tam t WHERE t.REPAYMENT_ACID=g.acid and t.acid=?SVAR and g.bank_id=?SVAR "
            BANCS.INPARAM.BINDVARS=CUST.TDCLS.Acid  + "|"+BANCS.STDIN.contextBankId
            print(BANCS.INPARAM.BINDVARS)
            sv_s= urhk_dbSelectWithBind(sv_k)
            print(sv_s)
            IF(sv_s == 0) THEN
            #{
                CUST.TDCLS.OPERNO=BANCS.OUTPARAM.operacctno
                print(CUST.TDCLS.OPERNO)
                CUST.TDCLS.accname=BANCS.OUTPARAM.accname
                print(CUST.TDCLS.accname)
                CUST.TDCLS.acctMaturDate=BANCS.OUTPARAM.acctMaturDate
                print(CUST.TDCLS.acctMaturDate)
                CUST.TDCLS.newSysdate=BANCS.OUTPARAM.newSysdate
                print(CUST.TDCLS.newSysdate)
                CUST.TDCLS.acctOpnDate=BANCS.OUTPARAM.acctOpnDate
                print(CUST.TDCLS.acctOpnDate)

                BANCS.INPARAM.date1 = CUST.TDCLS.newSysdate
                BANCS.INPARAM.date2 = CUST.TDCLS.acctMaturDate
                sv_a = urhk_B2k_dateDiff("")
                if(sv_a==0)then
                    print(BANCS.OUTPARAM.dateDiff)
                    sv_i = cint(BANCS.OUTPARAM.dateDiff)
                else
                    sv_i =0
                endif

                if(sv_i < 0) then
                    CUST.TDCLS.renSrlNum ="0000"
                    CUST.TDCLS.acctNum = CUST.TDCLS.FORACID
                    print(CUST.TDCLS.acctNum)
                    CUST.TDCLS.startDate = CUST.TDCLS.acctOpnDate
                    print(CUST.TDCLS.startDate)
                    CUST.TDCLS.acctPrfCr = "0"
                    print(CUST.TDCLS.acctPrfCr)
                    CUST.TDCLS.intTblCod = "ZEROT"
                    print(CUST.TDCLS.intTblCod)
                  ######################james 28/11/2022#######################
                        #call("fiRateModNew.scr")
                  ######################james 28/11/2022#######################
               endif
               ######account freeze check    james 29/10/2022 ##########################

                IF(CUST.TDCLS.OPERNO !="")THEN
                #{
                    sv_a = urhk_getAcctDetailsInRepository(CUST.TDCLS.OPERNO)
                    IF(sv_a == 0)THEN
                    #{
                        CUST.TDCLS.freezeCode = TRIM(BANCS.OUTPARAM.freezeCode)
                        print(CUST.TDCLS.freezeCode)
                        CUST.TDCLS.clsflg = BANCS.OUTPARAM.acctCloseflg
                        print(CUST.TDCLS.clsflg)
                        IF(CUST.TDCLS.freezeCode !="")THEN
                        #{
                            IF(CUST.TDCLS.freezeCode !="D")THEN
                            #{
                                CUST.TDCLS.errMsg="ACCOUNT FROZEN"
                                sv_t = urhk_SetOrbOut("SuccessOrFailure|N")
                                sv_t = "ERROR | " +CUST.TDCLS.errMsg
                                sv_u = urhk_SetOrbOut(sv_t)
                                GOTO ENDSCRIPT
                            #}
                            ENDIF
        
                        #}
                        ENDIF
                    #}
                    ENDIF
                #}
                ENDIF
               ######account freeze check    james 29/10/2022 ##########################
            #}
            ENDIF
        ELSE
            CUST.TDCLS.errMsg="Invalid Account"
            sv_t = "ERROR | " +CUST.TDCLS.errMsg
            sv_u = urhk_SetOrbOut(sv_t)
            GOTO ENDSCRIPT
        #}
        ENDIF

        CUST.TDCLS.FORACID= TRIM(BANCS.INPUT.FORACID)
        print(CUST.TDCLS.FORACID)

        PRINT(BANCS.STDIN.mySolId)  
        #############################context sol update########################
        BANCS.INPARAM.FlagType="A"
        BANCS.INPARAM.AcctId=CUST.TDCLS.FORACID
        sv_t = urhk_ContextSOLUpdate("")
        if(sv_t !=0)then
        #{
            sv_t = urhk_SetOrbOut("SuccessOrFailure|N")
            CUST.TDCLS.MSG ="Unable to Change Context SOL for Acct" +CUST.TDCLS.FORACID
            sv_t = "message| " +CUST.TDCLS.MSG
            GOTO ENDSCRIPT
        #}
        endif
        PRINT(BANCS.STDIN.mySolId)
        #############################context sol update########################

        sv_u = urhk_SetUrhkInp("tdAcctId.foracid|" + CUST.TDCLS.FORACID)
        sv_u = urhk_SetUrhkOut("clsValDt|CLSDATE")
        sv_u = urhk_SetUrhkOut("withdrwlAmt|AMT")
        sv_u = urhk_ExecSrv("SRV_FetchDfltTDClsrDtls|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg = Y|override_xcpn_flg = Y")
        PRINT(sv_u)
        IF (sv_u == 0) THEN
        #{
            print(BANCS.STDIN.mySolId)

            CUST.TDCLS.CLSDATE = BANCS.OUTPARAM.CLSDATE
            PRINT(CUST.TDCLS.CLSDATE)
            CUST.TDCLS.AMT= BANCS.OUTPARAM.AMT
            PRINT(CUST.TDCLS.AMT)

            sv_u = urhk_SetUrhkInp("tdAcctClsrCrit.tdAcctId.foracid|" + CUST.TDCLS.FORACID)
            sv_u = urhk_SetUrhkInp("tdAcctClsrCrit.clsValDt|" + CUST.TDCLS.CLSDATE)
            sv_u = urhk_SetUrhkInp("tdAcctClsrCrit.withdrwlAmt|" + CUST.TDCLS.AMT)
            sv_u = urhk_ExecSrv("SRV_FetchTDAcctForClsr|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg = Y|override_xcpn_flg = Y")
            PRINT(sv_u)
            print(BANCS.STDIN.mySolId)
            IF (sv_u == 0) THEN
            #{

                sv_u = urhk_CopyOutToIn("")
                PRINT(sv_u)
                print(BANCS.STDIN.mySolId)
                sv_u = urhk_ExecSrv("SRV_ValidateTDAcctForClsr|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg = Y|override_xcpn_flg = Y")
                PRINT(sv_u)
                IF(sv_u==0)THEN
                #{
                    print(BANCS.STDIN.mySolId)
                    PRINT("SUCCESS3")
                    sv_u = urhk_CopyOutToIn("")
                    PRINT(sv_u)

                    print(BANCS.STDIN.mySolId)

                    sv_u = urhk_ExecSrv("NAPI_CloseTDAcct|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg = Y|override_xcpn_flg = Y")
                    IF(sv_u==0)THEN
                    #{
                        print("TD Closed Successfully. Please verify")
                        sv_t = urhk_SetOrbOut("SuccessOrFailure|Y")
                        CUST.TDCLS.MSG ="ACCOUNT "+CUST.TDCLS.FORACID+" has been closed successfully. Please Verify"
                        sv_t = "message| " +CUST.TDCLS.MSG
                        sv_u = urhk_SetOrbOut(sv_t)
                    ELSE
                        GOTO ERRORCHECK
                    #}
                    ENDIF
                ELSE
                    GOTO ERRORCHECK
                #}
                ENDIF
            ELSE
                GOTO ERRORCHECK
            #}
            ENDIF
        ELSE
            GOTO ERRORCHECK
        #}
        ENDIF

    ERRORCHECK:
        PRINT(BANCS.STDIN.mySolId)
        #----------------------------------------------------------------------------------------------------
        # SRV Error check
        #----------------------------------------------------------------------------------------------------
        IF (sv_u != 0) THEN
        #{
            IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
            #{
                print(BANCS.OUTPARAM.Error_num)
                sv_v = BANCS.OUTPARAM.Error_num
            #}
            ELSE
            #{
                sv_v = 0
            #}
            ENDIF

            IF (sv_v > 0) then
            #{
                sv_u = system("echo 'Error'")
                sv_i = 1
                WHILE (sv_i <= sv_v)
                #{
                    sv_f = FORMAT$(sv_i,"%d")
                    sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
                    sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
                    sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
                    print(sv_e)
                    sv_i = sv_i + 1
                    sv_u = system("echo '"+sv_e+"' >>tdcls.log")
                    print(sv_u)

                    #Error response
                    ###############james 29/11/2022#####################
                    sv_t = urhk_SetOrbOut("SuccessOrFailure|N")
                    sv_t = "message| " +sv_e
                    ###############james 29/11/2022#####################

                    sv_u = urhk_SetOrbOut(sv_t)
                    GOTO ENDSCRIPT
                #}
                DO
            #}    
            ENDIF
        #}
        ENDIF




ENDSCRIPT:


trace off

