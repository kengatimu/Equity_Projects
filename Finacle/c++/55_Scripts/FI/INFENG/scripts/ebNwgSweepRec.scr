#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName       : ebNwgSweepRec.scr 
#Desc           :
#MenuId         : NA
#CalledScript   :
#Module         :
#Date           : 02/07/2020
#Author         : Vino Palani
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Rep/Class
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
	if(fieldexists(BANCS.INPUT.LaAcctId)==1)then
		print(BANCS.INPUT.LaAcctId)
		EQSRV.GLBDATA.LaAcctId = BANCS.INPUT.LaAcctId
	else
		EQSRV.GLBDATA.LaAcctId = ""
	endif
	if(fieldexists(BANCS.INPUT.numSweep)==1)then
		print(BANCS.INPUT.numSweep)
		EQSRV.GLBDATA.numSweep = BANCS.INPUT.numSweep
	else
		EQSRV.GLBDATA.numSweep = 0
	endif
	EQSRV.GLBDATA.uiCnt = "0"
	EQSRV.GLBDATA.siCnt = "0"
        sv_l=0
        while(sv_l<BANCS.INPUT.numSweep)
                print(sv_l)
                if(sv_l<=0)then
                        BANCS.INPUT.RecNum = "LaSweepRec"
                else
                        sv_r = sv_l
                        BANCS.INPUT.recCnt = sv_r
                        BANCS.INPUT.RecNum = "LaSweepRec" + BANCS.INPUT.recCnt
                endif
                print(BANCS.INPUT.RecNum)
		sv_i = BANCS.INPUT.RecNum + ".LaSweeptoAcct"
		if(fieldexists(("BANCS").("INPUT").(sv_i))) THEN
			EQSRV.GLBDATA.LaSweeptoAcct =("BANCS").("INPUT").(sv_i)
		else
			EQSRV.GLBDATA.LaSweeptoAcct = ""
		endif
		print(EQSRV.GLBDATA.LaSweeptoAcct)
		sv_i = BANCS.INPUT.RecNum + ".LaSweepAmt"
		if(fieldexists(("BANCS").("INPUT").(sv_i))) THEN
			EQSRV.GLBDATA.LaSweepAmt =("BANCS").("INPUT").(sv_i)
		else
			EQSRV.GLBDATA.LaSweepAmt = ""
		endif
		print(EQSRV.GLBDATA.LaSweepAmt)
		if(cdouble(EQSRV.GLBDATA.LaSweepAmt)>0)then
		sv_d = "Insert into custom.eb_lst (BANK_ID,SWEEP_MODULE,SWEEP_SRL_NUM,FROM_ACCT_NUM,TO_ACCT_NUM,SWEEP_AMOUNT,SWEEP_CREATION_DATE,IS_TRANYN,SWEEP_TRAN_ID,SWEEP_TRAN_DATE,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,ENTITY_CRE_FLG,DEL_FLG)values "
		sv_d = sv_d + "(?SVAR,'NEWGEN',custom.eblst_numseq.NEXTVAL,"
		sv_d = sv_d + " ?SVAR,?SVAR,?NVAR,to_date(?SVAR,'DD-MM-RR'),'N',null,null,"
		sv_d = sv_d + " ?SVAR,sysdate,?SVAR,sysdate,'Y','N') "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.LaAcctId + "|" + EQSRV.GLBDATA.LaSweeptoAcct + "|" + EQSRV.GLBDATA.LaSweepAmt + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId  
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlWithBind(sv_d)
		if(sv_u==0)then
			sv_u = urhk_dbSqlWithBind("commit")
			print(sv_u)
			EQSRV.GLBDATA.siCnt = cdouble(EQSRV.GLBDATA.siCnt) + 1
		else
			EQSRV.GLBDATA.uiCnt = cdouble(EQSRV.GLBDATA.uiCnt) + 1
		endif
		endif

                sv_l = sv_l+1
        do
	if(cdouble(EQSRV.GLBDATA.siCnt)>0)then
		sv_z = urhk_SetOrbOut("NumberOfSweepProcessed|" + EQSRV.GLBDATA.siCnt)
	else
		sv_z = urhk_SetOrbOut("NumberOfSweepProcessed|" + EQSRV.GLBDATA.siCnt)
	endif
	if(cdouble(EQSRV.GLBDATA.uiCnt)>0)then
		sv_z = urhk_SetOrbOut("NumberOfSweepFailed|" + EQSRV.GLBDATA.uiCnt)
	else
		sv_z = urhk_SetOrbOut("NumberOfSweepFailed|" + EQSRV.GLBDATA.uiCnt)
	endif
        exitscript
	
trace off
end-->
