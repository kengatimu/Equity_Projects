#------------------------------------------------------------------------------------------------
#   Name            : ebSearch.scr
#   Description     : This script is called to check search for corporate accounts
#   Date            : 20-01-2020
#   Author          : Edwin Zico
#   Input           : NA
#   Output          : NA
#   Called Script   : NA
#   Calling Script  : SRV
#   Menu Option     : HTM
#   Srl. No         Date            Author              Description.
#   -------         ------          ------              ------------
#   1.0             20-01-2020      Edwin Zico          Original Version
#-----------------------------------------------------------------------------------------------

<--START
CHECKSUM="b9922b3d30341e140cbe137606a7290925aa1e22f0ea5a4bbcb56801c8e43613"
TRACE ON

sv_a=urhk_B2k_PrintRepos("BANCS")
print(sv_a)
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif

EQSRV.GLBDATA.schmType 	=""
EQSRV.GLBDATA.cifId	=""
EQSRV.GLBDATA.errMsg	=""
EQSRV.GLBDATA.errFlg	=""
EQSRV.GLBDATA.acct	=""
EQSRV.GLBDATA.acctOpnDate	=""
EQSRV.GLBDATA.RetailOrCorp	=""
EQSRV.GLBDATA.count1		=""
EQSRV.GLBDATA.startDate		="01-02-2020"
#-------------------------------------------------------------------------------------------------------
# Get the trantype and transubtype
#-------------------------------------------------------------------------------------------------------

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	EQSRV.GLBDATA.tranType = BANCS.OUTPARAM.srvValue
	PRINT(EQSRV.GLBDATA.tranType)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Type")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	EQSRV.GLBDATA.tranSubType = BANCS.OUTPARAM.srvValue
	PRINT(EQSRV.GLBDATA.tranSubType)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Sub Type")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF

#-------------------------------------------------------------------------------------------------------
# Get the number of accounts entered from HTM menu option
#-------------------------------------------------------------------------------------------------------

sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
PRINT(sv_u)
IF(sv_u == 0) THEN
#{
	EQSRV.GLBDATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(EQSRV.GLBDATA.noOfRecords)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_l = 0
sv_m = ""
sv_n = 0
sv_a = "\n"
sv_x = 0
sv_z = 0
sv_c = 0
sv_e = 0


WHILE(sv_l < EQSRV.GLBDATA.noOfRecords)
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"
	
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		EQSRV.GLBDATA.serialnum = BANCS.OUTPARAM.srvValue
		PRINT(EQSRV.GLBDATA.serialnum)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serialnum")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		EQSRV.GLBDATA.acct = BANCS.OUTPARAM.srvValue
		PRINT(EQSRV.GLBDATA.acct)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Account Number")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refAmt")
	print(sv_u)
	if (sv_u == 0)then
	#{
		EQSRV.GLBDATA.refAmnt = BANCS.OUTPARAM.srvValue
		print(EQSRV.GLBDATA.refAmnt)
		EQSRV.GLBDATA.refAmnt = LEFT$(EQSRV.GLBDATA.refAmnt,GETPOSITION(EQSRV.GLBDATA.refAmnt,"|") - 1)
		print(EQSRV.GLBDATA.refAmnt)
	#}
	endif		 
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refCrncyCode.crncyCode")
	print(sv_u)
        if (sv_u == 0)then
        #{
		EQSRV.GLBDATA.refCrncy = BANCS.OUTPARAM.srvValue
		print(EQSRV.GLBDATA.refCrncy)
	#}
	endif
	
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." + sv_r +".partTranType.code")
                        EQSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.partTranType)

	
	sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.acct)
	IF (sv_u == 0)THEN
	#{
		EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
		PRINT(EQSRV.GLBDATA.schmType)
		EQSRV.GLBDATA.cifId = BANCS.OUTPARAM.cifId
		PRINT(EQSRV.GLBDATA.cifId)
		EQSRV.GLBDATA.OpnDate = BANCS.OUTPARAM.acctOpenDate
		EQSRV.GLBDATA.acctOpnDate = Mid$(BANCS.OUTPARAM.acctOpenDate,0,10)
		print(EQSRV.GLBDATA.acctOpnDate)
		EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(EQSRV.GLBDATA.schmCode)
		EQSRV.GLBDATA.AcctBal = BANCS.OUTPARAM.EffAvailableAmt
		print(EQSRV.GLBDATA.AcctBal)
	else
		EQSRV.GLBDATA.schmType = ""
		EQSRV.GLBDATA.cifId = ""
		EQSRV.GLBDATA.schmCode =""	
		EQSRV.GLBDATA.AcctBal = ""
	#}
	ENDIF
	#VP
	if((EQSRV.GLBDATA.schmCode=="OD541")and(EQSRV.GLBDATA.partTranType=="D"))then	
  		sv_u = urhk_SRV_SetErr("Transaction Not allowed-Agent OD541 Dr for" + " A/C NO:" + EQSRV.GLBDATA.acct + " SCHM_CODE " + EQSRV.GLBDATA.schmCode + " ,in PartTransrlnum " + EQSRV.GLBDATA.serialnum)

            	GOTO NEXTREC
	endif
#------------------Employee check
	if (BANCS.STDIN.menuId=="HTM") then
	#{

		if ((EQSRV.GLBDATA.schmCode=="SB190")and(EQSRV.GLBDATA.partTranType=="C"))then
		#{
			print(EQSRV.GLBDATA.acct)
			print(BANCS.STDIN.EmployeeId)

			sv_s = "empId|select emp_id  from tbaadm.gam where foracid =?SVAR  and bank_id =?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.acct + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d =  urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
				EQSRV.GLBDATA.empId = BANCS.OUTPARAM.empId
				PRINT(EQSRV.GLBDATA.empId)
				
				if ((BANCS.STDIN.EmployeeId) ==(EQSRV.GLBDATA.empId)) then
				#{
					sv_u = urhk_SRV_SetErr("Transaction Not allowed to own" + " A/C NO:" + EQSRV.GLBDATA.acct + " SCHM_CODE " + EQSRV.GLBDATA.schmCode + " ,in PartTransrlnum " + EQSRV.GLBDATA.serialnum)
					GOTO NEXTREC
				#}
				endif
			#}
			endif	
		#}
		endif
	#}
	endif
#----------------------End
	print(EQSRV.GLBDATA.startDate)
	BANCS.INPARAM.date1 = EQSRV.GLBDATA.startDate + " 00:00:00" 
	BANCS.INPARAM.date2 = EQSRV.GLBDATA.OpnDate 
	sv_a = urhk_B2k_dateDiff("")
	if(sv_a==0)then
		print(BANCS.OUTPARAM.dateDiff)
		EQSRV.GLBDATA.dateDiff = BANCS.OUTPARAM.dateDiff
	else
		EQSRV.GLBDATA.dateDiff = 0
	endif
	#VP
	sv_u = urhk_GetCustomerDetails (EQSRV.GLBDATA.cifId)
	IF(sv_u == 0) THEN
	#{
		EQSRV.GLBDATA.RetailOrCorp = BANCS.OUTPARAM.RetailOrCorp
		PRINT(EQSRV.GLBDATA.RetailOrCorp)
	#}
	ENDIF

	IF (EQSRV.GLBDATA.RetailOrCorp =="Corporate") THEN
	#{
		sv_s = "count1|select count(1)  from crmuser.corporate where corp_key =?SVAR and bank_id =?SVAR "	
		PRINT(sv_s)	
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.cifId + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
			EQSRV.GLBDATA.count1 = BANCS.OUTPARAM.count1
			PRINT(EQSRV.GLBDATA.count1)
			IF (cint(EQSRV.GLBDATA.count1)> 0) THEN

				##IF ((EQSRV.GLBDATA.schmType =="CAA") AND (cdouble(EQSRV.GLBDATA.acctOpnDate) >=(cdouble(EQSRV.GLBDATA.taate))  THEN
				#IF ((EQSRV.GLBDATA.schmType =="CAA") AND (cdouble(EQSRV.GLBDATA.dateDiff)<=0))  THEN
				IF (cdouble(EQSRV.GLBDATA.dateDiff)<=0)THEN	
				#{
					sv_a="value,value2|select STRUSERFIELD10,notes from crmuser.corporate where BANK_ID = ?SVAR AND CORP_KEY=?SVAR"
					print(sv_a)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.cifId
					print(BANCS.INPARAM.BINDVARS)
					sv_q = urhk_dbSelectWithBind(sv_a)
					print(sv_q)

					IF (sv_q==0) THEN
					#{
						EQSRV.GLBDATA.value =BANCS.OUTPARAM.value
						print(EQSRV.GLBDATA.value)
						EQSRV.GLBDATA.value2 =BANCS.OUTPARAM.value2
						print(EQSRV.GLBDATA.value2)
						#-----------------------------Amnt excemption added
						EQSRV.GLBDATA.parmId = "SEARCH" + EQSRV.GLBDATA.refCrncy	
						print(EQSRV.GLBDATA.parmId)
						BANCS.INPUT.moduleName = "TRANVAL"
						BANCS.INPUT.parameterId = EQSRV.GLBDATA.parmId 
						CALL("getcparamvalue.scr")
						PRINT(BANCS.OUTPUT.parameterVal)
						IF(BANCS.OUTPUT.parameterVal != "")THEN
						#{
							EQSRV.GLBDATA.AmtLimit = BANCS.OUTPUT.parameterVal
							print(EQSRV.GLBDATA.AmtLimit)
						#}
						ELSE
						#{
							EQSRV.GLBDATA.AmtLimit = 0
						#}
						ENDIF
						#--------------------------------Check Amount Balance after.
						if(EQSRV.GLBDATA.partTranType == "C")then
							print(EQSRV.GLBDATA.AcctBal)
							print(EQSRV.GLBDATA.refAmnt)
							EQSRV.GLBDATA.TotAmt = cdouble(EQSRV.GLBDATA.AcctBal) + cdouble(EQSRV.GLBDATA.refAmnt)
							print(EQSRV.GLBDATA.TotAmt)
						else
							EQSRV.GLBDATA.TotAmt = ""
						endif

						IF((EQSRV.GLBDATA.value =="001") or (EQSRV.GLBDATA.value2 =="001")) then
						#{
							print("ok")
							goto NEXTREC
						else

						if((cdouble(EQSRV.GLBDATA.refAmnt)>cdouble(EQSRV.GLBDATA.AmtLimit)) or (cdouble(EQSRV.GLBDATA.AcctBal)>cdouble(EQSRV.GLBDATA.AmtLimit)) or (cdouble(EQSRV.GLBDATA.TotAmt)>cdouble(EQSRV.GLBDATA.AmtLimit))) THEN
						#{
							IF ((EQSRV.GLBDATA.value=="002") or (EQSRV.GLBDATA.value2 =="002")) THEN
							#{		
								
								sv_m = sv_m  + EQSRV.GLBDATA.serialnum + ","+ "SEARCH PENDING" + sv_a
								sv_u = urhk_SRV_SetErr("Transaction Not allowed... SEARCH PENDING in CRM !!  for" + " A/C NO:" + EQSRV.GLBDATA.acct+ " SCHM_CODE " + EQSRV.GLBDATA.schmCode + " ,in PartTransrlnum " + EQSRV.GLBDATA.serialnum)	
								
								GOTO NEXTREC
							#}
							ENDIF
							IF ((EQSRV.GLBDATA.value =="003") or (EQSRV.GLBDATA.value2 =="003")) THEN
							#{									
								sv_m = sv_m  + EQSRV.GLBDATA.serialnum + ","+ "SEARCH NOT OK" + sv_a
								sv_u = urhk_SRV_SetErr("Transaction Not allowed... SEARCH NOT OK in CRM !!  for" + " A/C NO:" + EQSRV.GLBDATA.acct+ " SCHM_CODE " + EQSRV.GLBDATA.schmCode + " ,in PartTransrlnum " + EQSRV.GLBDATA.serialnum)	
											
								GOTO NEXTREC
							#}
							ENDIF
							IF ((EQSRV.GLBDATA.value =="") or (EQSRV.GLBDATA.value2 ==""))THEN
							#{											
								sv_m = sv_m  + EQSRV.GLBDATA.serialnum + ","+ "SEARCH NOT DONE" + sv_a
								sv_u = urhk_SRV_SetErr("Transaction Not allowed... SEARCH NOT DONE in CRM !!  for" + " A/C NO:" + EQSRV.GLBDATA.acct + " SCHM_CODE " + EQSRV.GLBDATA.schmCode + " ,in PartTransrlnum " + EQSRV.GLBDATA.serialnum)	
									
								GOTO NEXTREC
							#}
							ENDIF
						#}
						endif
						#}
						ENDIF					
					#}									
					ELSE
					#{							
						sv_m = sv_m  + EQSRV.GLBDATA.serialnum + ","+ "SEARCH NOT DONE" + sv_a
						sv_u = urhk_SRV_SetErr("Transaction Not allowed... SEARCH NOT DONE in CRM!!  for" + " A/C NO:" + EQSRV.GLBDATA.acct + " SCHM_CODE " + EQSRV.GLBDATA.schmCode + " ,in PartTransrlnum " + EQSRV.GLBDATA.serialnum)	
								
						GOTO NEXTREC
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	NEXTREC:
	PRINT(sv_m)	
	sv_l = sv_l + 1
	PRINT (sv_l)
#}
DO
PRINT(sv_m)
IF (sv_m != "") THEN 
#{
	BANCS.OUTPUT.successOrFailure = "F"
#}
ENDIF
TRACE OFF
EXITSCRIPT
END-->



