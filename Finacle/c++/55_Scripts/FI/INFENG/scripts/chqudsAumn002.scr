		CUST.CHQB.numUnused = BANCS.OUTPARAM.numUnused
		CUST.CHQB.numStoped = BANCS.OUTPARAM.numStoped
		CUST.CHQB.numDestroyed = BANCS.OUTPARAM.numDestroyed
		
		IF (CUST.CHQB.beginNum  != CUST.CHQB.beginChqNum) THEN
		#{
			CUST.CHQB.temp = CINT(CUST.CHQB.instNum) - CINT(CUST.CHQB.beginChqNum)
			print(CUST.CHQB.temp)
			#}
		ELSE
			#{
			CUST.CHQB.temp = "0"
			print(CUST.CHQB.temp)
		#}
		ENDIF
		
		sv_n = " SUBSTR(chq_lvs_stat,1," + CUST.CHQB.temp + "),"
		print(sv_n)
		
		# Second split(affected part) - small user input
		
		print(CUST.CHQB.temp)
		CUST.CHQB.temp = cint(CUST.CHQB.temp) + cint("1")
		print(CUST.CHQB.temp)
		
		sv_n = sv_n + "SUBSTR(chq_lvs_stat," + CUST.CHQB.temp + "," + CUST.CHQB.chqNumOfLvs + "),"
		print(sv_n)
		
		# Last split (end part)   - small user input
		
		CUST.CHQB.temp = cint(CUST.CHQB.temp) + cint(CUST.CHQB.chqNumOfLvs)
		print(CUST.CHQB.temp)
		
		sv_n = sv_n + "SUBSTR(chq_lvs_stat," + CUST.CHQB.temp + ","
		print(sv_n)
		
		CUST.CHQB.temp = cint(CUST.CHQB.chqNumOfLvs) - (cint(CUST.CHQB.temp) - cint("1"))
		print(CUST.CHQB.temp)
		
		IF (trim(CUST.CHQB.temp) == "") THEN
		#{
			CUST.CHQB.temp = "0"
			print(CUST.CHQB.temp)
		#}
		ENDIF
		
		sv_n = sv_n + CUST.CHQB.temp + ") "
		print(sv_n)
		
		
		sv_s = "firstPart,secondPart,lastPart "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT " + sv_n
		sv_s = sv_s + " FROM CUSTOM.C_CBT "
		sv_s = sv_s + " WHERE inst_type = ?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND TO_NUMBER(begin_chq_num) <= TO_NUMBER(?SVAR) "
		sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num)+chq_num_of_lvs-1) >= TO_NUMBER(?SVAR)"
		sv_s = sv_s + " AND (TO_NUMBER(?SVAR) BETWEEN TO_NUMBER(begin_chq_num) "
		sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num) + chq_num_of_lvs - 1)) "
		sv_s = sv_s + " AND del_flg != 'Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.instType + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.beginNum + "|" + CUST.CHQB.beginNum + "|" + CUST.CHQB.beginNum + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "No Record found"
			sv_m = "Err"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CHQB.firstPart = BANCS.OUTPARAM.firstPart
		CUST.CHQB.secondPart = BANCS.OUTPARAM.secondPart
		CUST.CHQB.lastPart = BANCS.OUTPARAM.lastPart
		
		CUST.CHQB.newSecondPart = trim(CUST.CHQB.currStatus)
		print(CUST.CHQB.newSecondPart)
		
		CUST.CHQB.newStatus1 = CUST.CHQB.firstPart + CUST.CHQB.newSecondPart + CUST.CHQB.lastPart
		print(CUST.CHQB.newStatus1)
		
		CUST.CHQB.newNumUnused = CUST.CHQB.numUnused
		CUST.CHQB.newNumPaid = CUST.CHQB.numPaid
		CUST.CHQB.newNumStoped = CUST.CHQB.numStoped
		CUST.CHQB.newNumDest = CUST.CHQB.numDestroyed
		
		IF (CUST.CHQB.currStatus == "U") THEN
		#{
			CUST.CHQB.newNumUnused = cint(CUST.CHQB.numUnused) - 1
			print(CUST.CHQB.newNumUnused)
		#}
		ENDIF
		
		IF (CUST.CHQB.currStatus == "P") THEN
		#{
			CUST.CHQB.newNumPaid = cint(CUST.CHQB.numPaid) - 1
			print(CUST.CHQB.newNumPaid)
		#}
		ENDIF
		
		IF (CUST.CHQB.currStatus == "S") THEN
		#{
			CUST.CHQB.newNumStoped = cint(CUST.CHQB.numStoped) - 1
			print(CUST.CHQB.newNumStoped)
		#}
		ENDIF
		
		IF (CUST.CHQB.currStatus == "D") THEN
		#{
			CUST.CHQB.newNumDest = cint(CUST.CHQB.numDestroyed) - 1
			print(CUST.CHQB.newNumDest)
		#}
		ENDIF
		
		IF (CUST.CHQB.newStatus == "U") THEN
		#{
			CUST.CHQB.newNumUnused = cint(CUST.CHQB.numUnused) + 1
			print(CUST.CHQB.newNumUnused)
		#}
		ENDIF
		IF (CUST.CHQB.newStatus == "P") THEN
		#{
			CUST.CHQB.newNumPaid = cint(CUST.CHQB.numPaid) + 1
			print(CUST.CHQB.newNumPaid)
		#}
		ENDIF
		
		IF (CUST.CHQB.newStatus == "S") THEN
		#{
			CUST.CHQB.newNumStoped = cint(CUST.CHQB.numStoped) + 1
			print(CUST.CHQB.newNumStoped)
		#}
		ENDIF
		
		IF (CUST.CHQB.newStatus == "D") THEN
		#{
			CUST.CHQB.newNumDest = cint(CUST.CHQB.numDestroyed) + 1
			print(CUST.CHQB.newNumDest)
		#}
		ENDIF
		
		IF (trim(CUST.CHQB.newNumUnused) == "") THEN
		#{
			CUST.CHQB.newNumUnused= "0"
		#}
		ENDIF
		
		IF (trim(CUST.CHQB.newNumPaid) == "") THEN
		#{
			CUST.CHQB.newNumPaid = "0"
		#}
		ENDIF
		
		IF (trim(CUST.CHQB.newNumStoped) == "") THEN
		#{
			CUST.CHQB.newNumStoped = "0"
		#}
		ENDIF
		
		IF (trim(CUST.CHQB.newNumDest) == "") THEN
		#{
			CUST.CHQB.newNumDest = "0"
		#}
		ENDIF
		
		#---------------------------------------
		# Updating C_CBT Table
		#---------------------------------------
		
		sv_s = "UPDATE CUSTOM.C_CBT SET chq_lvs_stat = ?SVAR ,"
		sv_s = sv_s + " num_unused = ?SVAR, "
		sv_s = sv_s + " num_paid = ?SVAR, "
		sv_s = sv_s + " num_stoped = ?SVAR, "
		sv_s = sv_s + " num_destroyed = ?SVAR, "
		sv_s = sv_s + " lchg_user_id = ?SVAR, "
		sv_s = sv_s + " lchg_time = sysdate "
		sv_s = sv_s + " WHERE "
		sv_s = sv_s + " begin_chq_num = ?SVAR "
		sv_s = sv_s + " AND inst_type = ?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND del_flg != 'Y'"
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.newStatus + "|" + CUST.CHQB.newNumUnused + "|" + CUST.CHQB.newNumPaid + "|" + CUST.CHQB.newNumStoped + "|" + CUST.CHQB.newNumDest + "|" + BANCS.STDIN.userId + "|" + CUST.CHQB.beginChqNum + "|"+ CUST.CHQB.instType + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			sv_e = "DataBase Error. Contact your DBA"
			sv_m = "Err"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_s = "UPDATE CUSTOM.C_CBT_MOD1 SET del_flg = 'Y' "
			sv_s = sv_s + "WHERE "
			sv_s = sv_s + "inst_type = ?SVAR "
			sv_s = sv_s + "AND foracid = ?SVAR "
			sv_s = sv_s + "AND del_flg != 'Y' "
			sv_s = sv_s + "AND bank_id = ?SVAR "
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CHQB.instType + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
			
			sv_d = urhk_dbSQLWithBind(sv_s)
			print(sv_d)
			IF (sv_d != 0) THEN
			#{
				sv_e = "DataBase Error. Contact your DBA"
				sv_m = "Err"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_d = urhk_dbSQLWithBind("COMMIT")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_a = urhk_SetOrbOut("RESULT_MSG|Record Verified Successfully for the account no"+CUST.CHQB.acctNum)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.CHQB.function == "X") THEN
