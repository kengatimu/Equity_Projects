<--START
CHECKSUM="6552b770f0a1bb7e5d71c7c3e0e02311ac78f737de5608c374d4c984a202b8bf"
	#TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "STFSALPRE") == 0) THEN
	#{
		CREATECLASS("CUST", "STFSALPRE", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.setId)
	PRINT(BANCS.INPUT.salDate)
	PRINT(BANCS.INPUT.remrks)
	
	
	CUST.STFSALPRE.userPass  = ""
	CUST.STFSALPRE.setId     = BANCS.INPUT.setId
	CUST.STFSALPRE.salDate   = BANCS.INPUT.salDate
	CUST.STFSALPRE.remrks    = BANCS.INPUT.remrks
	CUST.STFSALPRE.errorMsg	 = ""
	
	#---------------------------------------------------------------------------------
	#	Getting all the values from CPARAM
	#--------------------------------------------------------------------------------------------
	
	BANCS.INPUT.moduleName = "STAFFSAL"
	BANCS.INPUT.parameterId = "DATAFILENMAE"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STFSALPRE.datafilename = BANCS.OUTPUT.parameterVal
		
		#}
	ELSE
		#{
		CUST.STFSALPRE.errMsg = " Data File path setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	#-----------------------------------------------------------------------------------------------
	# All Path setting getting from the Environment
	#---------------------------------------------------------------------------------------------
	
	sv_u = urhk_getEnv("USER_PASS")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^User Id Password is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STFSALPRE.userPass = BANCS.OUTPARAM.envValue
		PRINT(CUST.STFSALPRE.userPass)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("CTL_PATH")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STFSALPRE.ctlPath = BANCS.OUTPARAM.envValue
		PRINT(CUST.STFSALPRE.ctlPath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("DATA_PATH")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Data file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STFSALPRE.dataPath = BANCS.OUTPARAM.envValue
		PRINT(CUST.STFSALPRE.dataPath)
		CUST.STFSALPRE.dataPath = CUST.STFSALPRE.dataPath + BANCS.STDIN.userId + "/"
		PRINT(CUST.STFSALPRE.dataPath)
	#}
	ENDIF
	
	#----------------------------------------------------------------------------
	# Deleteting custom table data
	#----------------------------------------------------------------------------
	
	sv_s = "DELETE CUSTOM.STAFFSAL "
	sv_s = sv_s + "WHERE bank_id = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_d = urhk_dbSQLWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0 ) THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		PRINT(sv_d)
	#}
	ENDIF
	
	sv_u = urhk_getFileLocation("COM|staffsaldp001.com")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		#----------------------------------------------------------------------------------
		#---    Setting Env variables
		#----------------------------------------------------------------------------------
		sv_a = "bankId|" + BANCS.STDIN.contextBankId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "setId|" + CUST.STFSALPRE.setId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "upldFileName|" + CUST.STFSALPRE.datafilename
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "salDate|" + CUST.STFSALPRE.salDate
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "remarks|" + CUST.STFSALPRE.remrks
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "onsUser|" + BANCS.STDIN.userId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "homeCrncy|" + BANCS.STDIN.homeCrncyCode
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------
		#---    Executing com file in background
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.scriptName = "staffsaldp001.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRE.errorMsg = "Upload process failed please retry"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.STFSALPRE.errorMsg = "Unable to load com file"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		IF (CUST.STFSALPRE.errorMsg != "") THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^"+CUST.STFSALPRE.errorMsg+"^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			#}
		ELSE
			#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|Upload/Process Initiated SuccessFully"
			sv_z = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
