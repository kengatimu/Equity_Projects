		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.API_NAME
		
		sv_d = urhk_dbSelectWithBind(sv_a)
		
		IF(sv_d == 0) THEN
		#{
			 CUST.INTERFACE.c_user  = BANCS.OUTPARAM.c_user
			 PRINT(CUST.INTERFACE.c_user)
		#}
		ELSE
		#{
			sv_a = "UserAdd.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd.ErrorMessage|Unable to fetch data"
			sv_u = urhk_SetOrbOut(sv_b)
			exitscript
		
		
		#}
		ENDIF
		
		IF(CUST.INTERFACE.c_user != "0") THEN
		#{
			IF(CUST.INTERFACE.c_user != "1") THEN
			#{
				sv_a = "UserAdd_Val.Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.ErrorMessage| failed to check record in status table"
				sv_u = urhk_SetOrbOut(sv_b)
				EXITSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		IF(CINT(CUST.INTERFACE.c_user) == 0)THEN
		#{
			CUST.INTERFACE.EFM_USER_FLG  = "NOT_FIRED"
			CUST.INTERFACE.EFM_REMARKS  = ""
			CUST.INTERFACE.CORE_USER_FLG  = "NOT_FIRED"
			CUST.INTERFACE.CORE_REMARKS  = ""
			CUST.INTERFACE.SSO_USER_FLG  = "NOT_FIRED"
			CUST.INTERFACE.SSO_REMARKS  = ""
			CUST.INTERFACE.CRM_USER_FLG  = "NOT_FIRED"
			CUST.INTERFACE.CRM_REMARKS  = ""
			CUST.INTERFACE.SVS_USER_FLG  = "NOT_FIRED"
			CUST.INTERFACE.SVS_REMARKS  = ""
			CUST.INTERFACE.RI_USER_FLG  = "NOT_FIRED"
			CUST.INTERFACE.RI_REMARKS  = ""		
			CUST.INTERFACE.RCRE_USERID  = BANCS.STDIN.userId
			CUST.INTERFACE.RCRE_TIME  = ""
			CUST.INTERFACE.LCHG_USERID  = BANCS.STDIN.userId
			CUST.INTERFACE.LCHG_TIME  = ""
		#}
		ENDIF
		IF(CUST.INTERFACE.c_user == "1") THEN
		#{
		
			sv_a = "USER_ID,EMP_ID,BANK_ID,API_NAME,EFM_USER_FLG,EFM_REMARKS,CORE_USER_FLG,CORE_REMARKS,SSO_USER_FLG,"
			sv_a = sv_a + "SSO_REMARKS,CRM_USER_FLG,CRM_REMARKS,SVS_USER_FLG,SVS_REMARKS,RI_USER_FLG,RI_REMARKS,LCHG_USER_ID,LCHG_TIME,RCRE_USER_ID,RCRE_TIME|"
			sv_a = sv_a + "SELECT USER_ID,EMP_ID,BANK_ID,API_NAME,EFM_USER_FLG,EFM_REMARKS,CORE_USER_FLG,CORE_REMARKS,SSO_USER_FLG,"
			sv_a = sv_a + "SSO_REMARKS,CRM_USER_FLG,CRM_REMARKS,SVS_USER_FLG,SVS_REMARKS,RI_USER_FLG,RI_REMARKS,LCHG_USER_ID,LCHG_TIME,RCRE_USER_ID,RCRE_TIME "
			sv_a = sv_a + " FROM CUSTOM.C_FINACLEUSER_STATUS_TBL WHERE USER_ID = ?SVAR AND EMP_ID = ?SVAR AND API_NAME = ?SVAR"
		
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.API_NAME
			sv_d = urhk_dbSelectWithBind(sv_a)
			
			IF(sv_d == 0) THEN
			#{
				CUST.INTERFACE.EFM_USER_FLG  = BANCS.OUTPARAM.EFM_USER_FLG
				CUST.INTERFACE.EFM_REMARKS  = BANCS.OUTPARAM.EFM_REMARKS
				CUST.INTERFACE.CORE_USER_FLG  = BANCS.OUTPARAM.CORE_USER_FLG
				CUST.INTERFACE.CORE_REMARKS  = BANCS.OUTPARAM.CORE_REMARKS
				CUST.INTERFACE.SSO_USER_FLG  = BANCS.OUTPARAM.SSO_USER_FLG
				CUST.INTERFACE.SSO_REMARKS  = BANCS.OUTPARAM.SSO_REMARKS
				CUST.INTERFACE.CRM_USER_FLG  = BANCS.OUTPARAM.CRM_USER_FLG
				CUST.INTERFACE.CRM_REMARKS  = BANCS.OUTPARAM.CRM_REMARKS
				CUST.INTERFACE.SVS_USER_FLG  = BANCS.OUTPARAM.SVS_USER_FLG
				CUST.INTERFACE.SVS_REMARKS  = BANCS.OUTPARAM.SVS_REMARKS
				CUST.INTERFACE.RI_USER_FLG  = BANCS.OUTPARAM.RI_USER_FLG
				CUST.INTERFACE.RI_REMARKS  = BANCS.OUTPARAM.RI_REMARKS
				CUST.INTERFACE.RCRE_USERID  = BANCS.OUTPARAM.RCRE_USER_ID
				CUST.INTERFACE.RCRE_TIME  = BANCS.OUTPARAM.RCRE_TIME
				CUST.INTERFACE.LCHG_USERID  = BANCS.OUTPARAM.LCHG_USER_ID
				CUST.INTERFACE.LCHG_TIME  = BANCS.OUTPARAM.LCHG_TIME
			#}
			ELSE
			#{
				sv_a = "UserAdd_Val.Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.ErrorMessage| failed to check record in status table"
				sv_u = urhk_SetOrbOut(sv_b)
				EXITSCRIPT
			#}
			ENDIF
			
			IF(CUST.INTERFACE.EFM_USER_FLG == "SUCCESS")THEN
			#{
				IF(CUST.INTERFACE.CORE_USER_FLG == "SUCCESS")THEN
				#{
					IF(CUST.INTERFACE.SSO_USER_FLG == "SUCCESS")THEN
					#{
						IF(CUST.INTERFACE.CRM_USER_FLG != "SUCCESS")THEN
						#{
							GOTO CRM
						#}
						ENDIF
					#}
					ELSE
					#{
						GOTO SSO
					#}
					ENDIF
				#}
				ELSE
				#{
					GOTO CORE
				#}
				ENDIF
			#}
			ELSE
			#{
				GOTO EFM
			#}
			ENDIF
		 
		
		#}
		ENDIF
		
		
	EFM:
	
	####################################################################
	# EFM - USER ADD
	####################################################################
		
		
		IF(CUST.INTERFACE.EFM_EXISTS == "Y") THEN
		#{
			GOTO CORE
		#}
		ENDIF
		
		CALL("UserAdd_EFM.scr")
		
		IF(CUST.INTERFACE.GOTO == "Y")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
	CORE:		
	
	####################################################################
	# CORE - USER ADD
	####################################################################
	
		IF(CUST.INTERFACE.CRE_ASSIGN_CORE_SERVER == "Y")THEN
		#{
			IF(CUST.INTERFACE.CORE_EXISTS == "Y") THEN
			#{
				GOTO SSO
			#}
			ENDIF
			CALL("UserAdd_CORE.scr")
			IF(CUST.INTERFACE.GOTO == "Y")THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ELSE
		#{
			CUST.INTERFACE.CORE_REMARKS  =  "CORE User Cannot be Created For this WorkClass and RoleID"
		#}
		ENDIF
	SSO:	
		
	####################################################################
	# SSO - USER ADD
	####################################################################
		IF(CUST.INTERFACE.SSO_EXISTS == "Y") THEN
		#{
			GOTO CRM
		#}
		ENDIF
		CALL("UserAdd_SSO.scr")
		IF(CUST.INTERFACE.GOTO == "Y")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	CRM:
	
	
	####################################################################
	# CRM - USER ADD
	####################################################################
		IF(CUST.INTERFACE.CRM_USER_FLG == "SUCCESS")THEN
		#{
			GOTO RI
		#}
		ENDIF
		IF(CUST.INTERFACE.CRM_EXISTS == "Y") THEN
		#{
			GOTO RI
		#}
		ENDIF
		
		
		IF(CUST.INTERFACE.CRE_ASSIGN_CRM_SERVER == "Y")THEN
		#{
			CALL("UserAdd_CRM.scr")
		
		#}
		ELSE
		#{
			CUST.INTERFACE.CRM_REMARKS  =  "CRM User Cannot be Created For this WorkClass and RoleID"
		#}
		ENDIF
		
	RI:	
	
	####################################################################
	# RI - USER ADD
	####################################################################
	
		IF(CUST.INTERFACE.RI_USER_FLG == "SUCCESS")THEN
		#{
			GOTO SVS
		#}
		ENDIF

		IF(CUST.INTERFACE.RI_EXISTS == "Y") THEN
		#{
			GOTO SVS
		#}
		ENDIF

		IF(CUST.INTERFACE.CRE_ASSIGN_REPORT_INFRA == "Y")THEN
		#{
			CALL("UserAdd_RI.scr")
		#}
		ELSE
		#{
			CUST.INTERFACE.RI_REMARKS  =  "RI User Cannot be Created For this WorkClass and RoleID"
		#}
		ENDIF
		
		
	SVS:
	

	####################################################################
	# SVS - USER ADD
	####################################################################
		
		
		IF(CUST.INTERFACE.SVS_USER_FLG == "SUCCESS")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF(CUST.INTERFACE.SVS_EXISTS == "Y") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF(CUST.INTERFACE.CRE_ASSIGN_SVSSERVER == "Y")THEN
		#{
			CALL("UserAdd_SVS.scr")
		#}
		ELSE
		#{
			CUST.INTERFACE.SVS_REMARKS  =  "SVS User Cannot be Created For this WorkClass and RoleID"
		#}
		ENDIF
		
	ENDOFSCRIPT:
		
	IF(CUST.INTERFACE.c_user == "0")THEN
	#{
		sv_a = "INSERT INTO CUSTOM.C_FINACLEUSER_STATUS_TBL(USER_ID,EMP_ID,BANK_ID,API_NAME,EFM_USER_FLG,EFM_REMARKS,CORE_USER_FLG,CORE_REMARKS,SSO_USER_FLG,"
		sv_a = sv_a +"SSO_REMARKS,CRM_USER_FLG,CRM_REMARKS,SVS_USER_FLG,SVS_REMARKS,RI_USER_FLG,RI_REMARKS,LCHG_USER_ID,LCHG_TIME,RCRE_USER_ID,RCRE_TIME)"
		sv_a = sv_a + "VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,sysdate,?SVAR,sysdate)"

		CUST.INTERFACE.RCRE_USER_ID = BANCS.STDIN.userId
		CUST.INTERFACE.LCHG_USERID = BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.bank_id + "|" + CUST.INTERFACE.API_NAME + "|" +  CUST.INTERFACE.EFM_USER_FLG
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.EFM_REMARKS  + "|" + CUST.INTERFACE.CORE_USER_FLG  + "|" + CUST.INTERFACE.CORE_REMARKS 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.SSO_USER_FLG + "|" + CUST.INTERFACE.SSO_REMARKS  + "|" +	CUST.INTERFACE.CRM_USER_FLG  
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.CRM_REMARKS  + "|" + CUST.INTERFACE.SVS_USER_FLG  + "|" + CUST.INTERFACE.SVS_REMARKS
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	CUST.INTERFACE.RI_USER_FLG + "|" + CUST.INTERFACE.RI_REMARKS + "|" + CUST.INTERFACE.LCHG_USERID 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	 CUST.INTERFACE.RCRE_USER_ID 
		PRINT(BANCS.INPARAM.BINDVARS)
		PRINT(CUST.INTERFACE.RI_REMARKS)
		sv_d = urhk_dbSqlWithBind(sv_a)
		IF(sv_d == 0) THEN
		#{
			print("inserted")
		#}
		ELSE
		#{
			sv_a = "STATUS_TABLE_UPDATE.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "STATUS_TABLE_UPDATE.ErrorMessage| FAILED TO UPDATE STATUS TABLE"
			sv_u = urhk_SetOrbOut(sv_b)
			EXITSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.INTERFACE.LCHG_USERID = BANCS.STDIN.userId
		sv_a = "UPDATE CUSTOM.C_FINACLEUSER_STATUS_TBL SET EFM_USER_FLG = ?SVAR,EFM_REMARKS = ?SVAR,CORE_USER_FLG = ?SVAR,CORE_REMARKS = ?SVAR,SSO_USER_FLG = ?SVAR,"
		sv_a = sv_a +"SSO_REMARKS = ?SVAR,CRM_USER_FLG = ?SVAR,CRM_REMARKS = ?SVAR,SVS_USER_FLG = ?SVAR,SVS_REMARKS = ?SVAR,RI_USER_FLG = ?SVAR,RI_REMARKS = ?SVAR,"
		sv_a = sv_a + "LCHG_USER_ID = ?SVAR,LCHG_TIME = sysdate WHERE USER_ID = ?SVAR AND EMP_ID = ?SVAR AND API_NAME = ?SVAR"
		
		BANCS.INPARAM.BINDVARS =  CUST.INTERFACE.EFM_USER_FLG
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.EFM_REMARKS  + "|" + CUST.INTERFACE.CORE_USER_FLG  + "|" + CUST.INTERFACE.CORE_REMARKS 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.SSO_USER_FLG + "|" + CUST.INTERFACE.SSO_REMARKS  + "|" +	CUST.INTERFACE.CRM_USER_FLG  
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.CRM_REMARKS  + "|" + CUST.INTERFACE.SVS_USER_FLG  + "|" + CUST.INTERFACE.SVS_REMARKS
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	CUST.INTERFACE.RI_USER_FLG + "|" + CUST.INTERFACE.RI_REMARKS + "|" + CUST.INTERFACE.LCHG_USERID 
		
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +	CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.API_NAME
	
		PRINT(CUST.INTERFACE.RI_REMARKS)
		print(sv_a)
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSqlWithBind(sv_a)
		IF(sv_d == 0) THEN
		#{
			print("updated")
		#}
		ELSE
		#{
			sv_a = "STATUS_TABLE_UPDATE.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "STATUS_TABLE_UPDATE.ErrorMessage| FAILED TO UPDATE STATUS TABLE"
			sv_u = urhk_SetOrbOut(sv_b)
			EXITSCRIPT
		#}
		ENDIF
	
	#}
	ENDIF
	#TRACE OFF
