                        print(FORMAT$(cdouble(EQSRV.GLBDATA.tmpChargeAmount),"%.2f"))
                        EQSRV.GLBDATA.tmpChargeAmount = FORMAT$(cdouble(EQSRV.GLBDATA.tmpChargeAmount),"%.2f")
                        print(EQSRV.GLBDATA.tmpChargeAmount)
