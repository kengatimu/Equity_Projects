<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	#BANCS.INPUT.CIFId = "54312489116"

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CIFId"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="please enter CIFId"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "MSG | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------
	CUST.EZB.schm_type = "LAA"

	#----------------------------------------------------------------------------------------------
	# validations
	#----------------------------------------------------------------------------------------------

	sv_q = "acct_crncy_code,loan_acct, schm_code,loan_amt,acct_cls_date,schm_desc,accrued_amt_dr,accrued_amt_cr, booked_upto_date_dr,loanBalance,country_code,paid_EMI,total_EMI |"
	sv_q = sv_q + "select * from (select  acct_crncy_code,foracid,schm_code,SANCT_LIM, acct_cls_date,"
	sv_q = sv_q + " (SELECT SCHM_DESC FROM TBAADM.GSP gsp WHERE gsp.SCHM_CODE=g.schm_code AND BANK_ID=?SVAR) schm_desc,"
	sv_q = sv_q + " (select NRML_ACCRUED_AMOUNT_DR from tbaadm.eit e where bank_id=?SVAR and e.entity_id = g.acid ) accrued_amt_dr, "
	sv_q = sv_q + " (select NRML_ACCRUED_AMOUNT_CR from tbaadm.eit e where bank_id=?SVAR and e.entity_id = g.acid ) accrued_amt_cr, "
	sv_q = sv_q + " (select BOOKED_UPTO_DATE_DR  from tbaadm.eit e where bank_id=?SVAR and e.entity_id = g.acid ) booked_upto_date_dr,"
	sv_q = sv_q + " (select (PRIN_DMD_OS + INT_DMD_OS)  from tbaadm.lam lam where lam.acid= g.acid ) loanBalance,"
	sv_q = sv_q + " (select a.COUNTRY  from crmuser.accounts a where a.orgkey=g.cif_id) country_code,"
	sv_q = sv_q + " (SELECT Count(*) / 2 as paidEMI  from tbaadm.ldt ldt where ldt.acid=g.acid) paid_EMI,"
	sv_q = sv_q + " (SELECT  SUM(TOT_ADJ_AMT)  FROM TBAADM.LDT l WHERE l.acid=g.acid AND DMD_FLOW_ID in ('PRDEM', 'INDEM') ) total_EMI"
	sv_q = sv_q + " from tbaadm.gam g where "
	sv_q = sv_q + " g.cif_id=?SVAR and g.schm_type=?SVAR )"
	print(sv_q)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId+"|"+BANCS.STDIN.contextBankId+"|"+BANCS.STDIN.contextBankId+"|"+BANCS.STDIN.contextBankId+"|"+BANCS.INPUT.CIFId+"|"+CUST.EZB.schm_type
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbcursorOpenWithBind(sv_q)
	PRINT(sv_c)

	IF (sv_c == 0)THEN
	#{
		CUST.EZB.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.EZB.cursor_number)

		sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
		print(sv_d)

		sv_q = 0
		print(sv_q)

		WHILE (sv_d == 0)
		#{
			sv_q = sv_q + 1
			print(sv_q)

			sv_v = "AcctCrnyCode_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.acct_crncy_code

			sv_v = "LoanAcct_" + FORMAT$(sv_q, "%d") 
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.loan_acct

			sv_v = "SchmCode_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.schm_code

			sv_v = "LoanAmt_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.loan_amt

			sv_v = "AcctClsDate_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.acct_cls_date

			sv_v = "SchmDesc_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.schm_desc

			sv_v = "AccruedAmtDr_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.accrued_amt_dr

			sv_v = "AccruedAmtCr_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.accrued_amt_cr

			sv_v = "BookedUptoDateDr_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.booked_upto_date_dr

			sv_v = "LoanBalance_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.loanBalance

			sv_v = "CountryCode_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.country_code

			sv_v = "PaidEMI_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.paid_EMI

			sv_v = "TotalEMI_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.total_EMI

			print(sv_v)

			sv_v = "AcctCrnyCode_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.AcctCrnyCode| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "LoanAcct_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.LoanAcct| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "SchmCode_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.SchmCode| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "LoanAmt_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.LoanAmt| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "AcctClsDate_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.AcctClsDate| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "SchmDesc_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.SchmDesc| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "AccruedAmtDr_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.AccruedAmtDr| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "AccruedAmtCr_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.AccruedAmtCr| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "BookedUptoDateDr_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.BookedUptoDateDr| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "LoanBalance_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.LoanBalance| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "CountryCode_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.CountryCode| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "PaidEMI_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.PaidEMI| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "TotalEMI_" + FORMAT$(sv_q, "%d")
			sv_t = "LoanSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.TotalEMI| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
			print(sv_d)

		#} 
		DO 

		sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
		print(sv_x)
		print(CUST.EZB.cursor_number)
	#}
	ENDIF


ENDSCRIPT:
trace off
END-->

