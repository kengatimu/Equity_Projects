########################################################################
# Report Name   :   Statement on of suit filed including Decreed Accounts and 
#					Non suit filed accounts as on a given date
# Template Name :   SuitNonSuitFiledCasesRpt.mri
# Description   :   To print the cases handled by the advocates.
#   
#	Modification log
#   ----------------
#   Srl.No.     Date        Author            Version
#   ------   ----------     ------------    --------------
#       1       23/11/04    Jaya Lakhsmi        1.0
#
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include SuitNonSuitFiledCasesRpt.mri
#
LOCALVARIABLES
srl_num 		numberType
local   		numberType
temp			numberType
localdate		numberType
localyears		numberType

numberA         numberType
numberB         numberType
numberC         numberType
numberTot       numberType

liabilityA      numberType
liabilityB      numberType
liabilityC      numberType
liabilityCD     numberType
liabilityCL     numberType
liabilityTot    numberType
#
GROUPANDSORT
CurrencyCode
liability  	
#
#IGNORERECORD
#	if ( pastDueFlg != "Y" )
PAGEFORMAT
linesperpage 60
columnsperline 142
pageheaderlines 22 
topMargin  2
bottomMargin 2
#
REPOSITORY argv4
errorMsg				 stringType						
PAGE_NUMBER              numberType
crit_reportTo            stringType
crit_solSetId            stringType
crit_acctNum             stringType
crit_custId			     stringType
crit_asOnDate            stringType
crit_fromDate            stringType
crit_toDate              stringType
crit_suitStatus          stringType
crit_courtOrTribunal     stringType
crit_rptCrncyCode        stringType
#
REPOSITORY bankRepos.rip
bankName            stringType
branchName          stringType
uniformBrCode       stringType
branchCity          stringType
branchPinCode       stringType
branchState         stringType
branchAddr1         stringType
branchAddr2         stringType
branchAddr3         stringType
localYearsToAdd        stringType
#

ONSTARTOFREPORT
#
set localyears = strToNum localYearsToAdd
set pageNumber = 1
set srl_num = 1 
set local = 0
if (errorMsg != "")
begin
	print " Error : "
	print errorMsg
	nextline
end
nextline
execute reportHeader
nextline
nextline
execute printCriteria
nextline
nextline
nextline
#nextpage

#
PAGEHEADER
	execute reportHeader
	execute pageheader
#
BEFOREBREAKOF CurrencyCode
	if ( liability < -2500000 )
		set local = 0
	else if (liability < -500000 )
		set local = 1
	else 
		set local = 2
	nextpage
	
	set srl_num 	= 1
	set numberA 	= 0
	set numberB 	= 0
	set numberC 	= 0
	set numberTot   = 0
	set liabilityA  = 0
	set liabilityB  = 0
	set liabilityC  = 0
	set liabilityCD = 0
	set liabilityCL = 0
	set liabilityTot= 0
#
AFTERBREAKOF CurrencyCode
#	nextline
	if (numberC != 0)
		execute groupC
	if (numberA !=0 or numberB !=0 or numberC !=0)
		execute Summary
#	nextpage
#

#==========================================================================
ONEVERYRECORD
#========================================================================
	set temp = local
	if ( liability < -2500000 )	
	begin
		set local = 0
		set numberA 	= numberA + 1
		set liabilityA 	= liabilityA + liability
		if temp != local
		begin
			set srl_num = 1
#			nextpage
			if (linesleftinpage < 30)
				nextpage
			else 
				execute pageheader
		end	
		if (linesleftinpage < 7)
			nextpage
		execute detailRecord
	end
	else if (liability < -500000)
	begin
		set local = 1
		set numberB 	= numberB + 1
		set liabilityB 	= liabilityB + liability
		if temp != local
		begin
			set srl_num = 1
#			nextpage
			if (linesleftinpage < 30)
				nextpage
			else 
				execute pageheader
		end	
		if (linesleftinpage < 7)
			nextpage
		execute detailRecord
	end
	else if (liability < 0)
	begin
		set local = 2
		set numberC 	= numberC + 1
		set liabilityC 	= liabilityC + liability
#Here an asset is classified as doubtful only when both main and subclassifications are "DOUBT". This has to be changed.
#Here an asset is classified as loss only when both main and subclassifications are "LOSS". This has to be changed.
		if ( Asset_main_classfn = "DOUBT" and Asset_sub_classfn = "DOUBT" )
        	set liabilityCD = liabilityCD + liability
    	if ( Asset_main_classfn  = "LOSS" and Asset_sub_classfn = "LOSS" )
        	set liabilityCL = liabilityCL + liability
	end
	set srl_num = srl_num + 1
#
#==========================================================================
ONENDOFREPORT
#==========================================================================
    if(srl_num = 1)
    begin
        nextline
        nextline
        print "-------  NO RECORDS SELECTED FOR PRINTING  ---- " column 24
        nextline
    end
    nextline
    nextline
    nextline
    nextline
	print "*** " column 24
	print pageNumber size 3 column 30 precision 0
	print " PAGE(S) PRINTED. ****END OF REPORT****" size 40 column 34
#
    set PAGE_NUMBER = pagenumber
#
#=========================================================================
PROCEDURE reportHeader
#=========================================================================
	set localdate = stringToDate  today 
	set localdate = periodAdd localdate localyears Y 
	print localdate DateFormat "" column 1 
	nextline
	print "Page: "  column 90
	print pageNumber column 96
	nextline
	print bankName column 35
	nextline
	print "From "   column 2
	print "To,	"   column 80
	nextline
	print branchName column 2
	nextline
	print branchAddr1 column 2
	nextline
	print branchAddr2 column 2
	nextline
	print branchAddr3 column 2
	nextline
	print branchCity column 2
	nextline
	print branchState column 2
	nextline
	print branchPinCode column 2
	nextline
	print uniformBrCode column 2
	nextline
	nextline 
	print "STATEMENT OF SUIT FILED INCLUDING DECREED ACCOUNTS AND " column 20
	nextline
	print "      NON SUIT FILED ACCOUNTS AS ON  ("                  column 20
  	set localdate = stringToDate  crit_fromDate
  	set localdate = periodAdd localdate localyears Y
  	print localdate DateFormat ""
	print ", " 
  	set localdate = stringToDate  crit_toDate
  	set localdate = periodAdd localdate localyears Y
  	print localdate DateFormat ""
	print ") "

#=========================================================================
PROCEDURE pageheader
#=========================================================================
begin 
  nextline
  nextline
  if ( local = 0 )
  	print "  GROUP A " column 45
  else if ( local = 1 )
  	print "  GROUP B " column 45
  nextline
  print "Currency code:" column 1
  print CurrencyCode size 3 column 15
  nextline
  if ( local != 2 )
  begin 
	separatorline
	print "S.No. LPD No.          Borrower Name   Category   Sector Subsector Secu Nature        Secu Value          Recovery    Borrower Worth"
	nextline
	print "      Guarantor Worth  Guar Claim Dt   Suit Dt    Decree Dt       EP File Dt   Claim Held(Susp)         Suit Claim     Decree Amount" 
	nextline
	print "      Provision Amount Asset Main Classfn         Asset Sub Classfn                          Liab. Outstanding"   
	nextline
	separatorline
  	nextline
  end 
end  	
  	
#==========================================================================
PROCEDURE detailRecord
#==========================================================================
	nextline
	print srl_num 			size 4 column 1
	print LPD_NO 			size 16 column 7
	print Borrower_name 	size 15 column 24
	print Category 			size 5 column 40
	print Sector 			size 5 column 51
	print Subsector 		size 5 column 58
	print Security_nature 	size 10 column 68
	print Security_value 	size 17 autocomma precision 2 column 80
	print Recovery 			size 17 autocomma precision 2 column 98
	print NetworthofBorrower size 17 autocomma precision 2 column 116
	nextline
	print NetworthofGuarantor 	size 17 autocomma precision 2 column 6
	print Credit_guar_claimed 	size  10 column 24
    set localdate = stringToDate  Date_of_filing
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 40
    set localdate = stringToDate  Decree_date
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 51
    set localdate = stringToDate  Date_of_EP_file
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 67
	print abs Credit_guar_suspense 	size  17 autocomma precision 2 column 78
	if (Credit_guar_suspense < 0)
		print "Dr"
	if (Credit_guar_suspense > 0)
		print "Cr"
	print Suit_claim 			size 17 autocomma precision 2 column 98
	if ( fnlDecreeAmount = 0 )
		print prelimDecreeAmount    size 17 autocomma precision 2 column 116
	else
		print fnlDecreeAmount 		size 17 autocomma precision 2 column 116
	nextline
	print abs Provision_amount 		size 17 autocomma precision 2 column 4
	if (Provision_amount < 0)
		print "Dr"
	if (Provision_amount > 0)
		print "Cr"
	print Asset_main_classfn 	size 5 column 24
	print Asset_sub_classfn 	size 5 column 51   
	print abs liability	    	size 20 autocomma precision 2 column 98
	if ( liability < 0 )
		print "Dr"
	if ( liability > 0)
		print "Cr"

PROCEDURE groupC
begin
  if ( linesleftinpage < 11 ) 
  	nextpage
  nextline
  nextline
  nextline
  if ( numberC != 0)
  begin
  print " GROUP C "  column 45
  nextline
  separatorline
  print "Total No of Accts" column 10
  print "Total Amt"         column 38
  print "Doubtful Amt"      column 62
  print "Loss Asset Amt"    column 86
  nextline	
  separatorline
  nextline
  print numberC             column 15
  print abs liabilityC      size 20 autocomma precision 2 column 34   
  if(liabilityC < 0) 
  	print "Dr"
  if(liabilityC > 0)
  	print "Cr"
  print abs liabilityCD     size 20 autocomma precision 2 column 58   
  if(liabilityCD < 0) 
  	print "Dr"
  if(liabilityCD > 0)
  	print "Cr"
  print abs liabilityCL     size 20 autocomma precision 2 column 82   
  if(liabilityCL < 0) 
  	print "Dr"
  if(liabilityCL > 0)
  	print "Cr"
  nextline
  nextline
  nextline
  end	
end	
PROCEDURE Summary
begin
  set liabilityTot = liabilityA + liabilityB + liabilityC
  set numberTot    = numberA + numberB + numberC
  
  nextline
  if ( linesleftinpage < 15 ) 
  	nextpage
  print "Summary"			column 50	
  nextline
  nextline
  separatorline
  print "Category "         column 10
  print "Total No of Accts" column 22
  print "Total Amt"         column 50	
  nextline
  separatorline
  nextline
  print "GROUP A"        column 10
  print numberA          column 26
  print abs liabilityA   size 20 autocomma precision 2 column 45   
  if(liabilityA < 0) 
  	print "Dr"
  if(liabilityA > 0)
  	print "Cr"
  nextline
  nextline
  print "GROUP B"        column 10
  print numberB          column 26
  print abs liabilityB   size 20 autocomma precision 2 column 45   
  if(liabilityB < 0) 
  	print "Dr"
  if(liabilityB > 0)
  	print "Cr"
  nextline
  nextline
  print "GROUP C"        column 10
  print numberC          column 26
  print abs liabilityC   size 20 autocomma precision 2 column 45   
  if(liabilityC < 0) 
  	print "Dr"
  if(liabilityC > 0)
  	print "Cr"
  nextline
  nextline
  print " TOTAL "   	column 10
  print numberTot       column 26
  print abs liabilityTot size 20 autocomma precision 2 column 45   
  if(liabilityTot < 0) 
  	print "Dr"
  if(liabilityTot > 0)
  	print "Cr"
  nextline
  nextline
end
#==========================================================================
PROCEDURE printCriteria
#==========================================================================
    nextLine
    nextLine
    separatorLine
    nextline
    nextline
    print   "SELECTION CRITERIA"              column 40
    nextline
    print   "-------------------"             column 40
    nextline
    nextline
    print   "Report To                : "     column 30
    print   crit_reportTo
    nextline
    print   "Set Id                   : "     column 30
    print   crit_solSetId
    nextLine
    print   "Account Num              : "     column 30
    print   crit_acctNum 
    nextline
    print   "CIF ID                   : "     column 30
    print   crit_custId
    nextline
    print   "As on date               : "     column 30
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "From Date                : "     column 30
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextLine
    print   "To Date                  : "     column 30
    set localdate = stringToDate  crit_toDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "Suit Status              : "     column 30
    print   crit_suitStatus
    nextline
    print   "Judicial Authority       : "     column 30
    print   crit_courtOrTribunal
    nextline
    print   "Report Currency Code     : "     column 30
    print   crit_rptCrncyCode
    nextline
    nextline
    separatorLine
#============================ End Of File ================================

