# ***************************************************************************


RECORDLAYOUT  
#############################################################################
#
#   RECORDLAYOUT (Mandatory Section) - 1st Section.
#   This section tells the record layout of the input ASCII file. This has
#   to be the  First Section in  the  template file, The  fields  datatype
#   can be either "stringType" or "numberType". It assumes that in the in-
#	coming records, the fields are separated by Pipe (i.e '|').
#
#############################################################################
$$$include AmortShdl.mri

LOCALVARIABLES
#############################################################################
#
#   LOCALVARIABLES (Mandatory Section) - 2nd Section.
#   This is the Second Mandatory Section in the Template File.The name of the
#   Section "LOCALVARIABLES" must be there even though there are no local var
#   -iables to be declared.Here also, the local variables must have a type as
#	either "stringType" or "numberType".
#
#############################################################################
count   numberType
recCount numberType
localdate		numberType
localyears		numberType
callscript     		stringtype

GROUPANDSORT
#############################################################################
#
#   GROUPANDSORT (Mandatory Section) - 3rd Section.
#   This has to be the Third Section (Mandatory) in the  template file.  Even 
#   though there are no fields(Sorting field),the Section name must be there.
#   This section  tells  how  the input file is to be sorted. All the  fields
#   present  in this section must have been defined in the RECORDLAYOUT sect-
#   ion.Further,the direction of sort(ASCENDING, DESCENDING or ALREADYSORTED)
#   can be set by typing the word to the right of the field.The Default  Sort
#   order is ASCENDING. If there are more than ONE sorting field, the records
#   are sorted first based on the first field, then within that based on  the 
#   second field and like-wise.... .  The Maximum No. of  Sorting  Fields  at  
#   present supported is 8 only.
#
#############################################################################
srlNum

#############################################################################
#
#	REPOSITORY (Optional Section) - Fixed-Type Repository.
#	This section tells about the Repository Information. A  Repository  is  a 
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#	Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#   
#############################################################################
REPOSITORY  bankRepos.rip 
	bankName 				    StringType
	branchName					StringType
	localYearsToAdd		stringType

#############################################################################
#
#	REPOSITORY (Optional Section) - Variable-Type Repository.
#	Variable-Type  Repository  differs from  the  Fixed-Type is that its name
#	(Repository File Name) is decided at RUN-TIME and can be substituted  for
#   argv4 in the Template File. Its Name Fields and Field Values is also  set
#   during RUN-TIME. However, Its Values can be used in the Template File.
#
#############################################################################
REPOSITORY argv4
	forAcid                 stringType
	acctOpnDate             stringType
	schmCode                stringType
	custId                  stringType
	loanAmt                 numberType
	shdlCreationDate        stringType
	eiSchmFlg               stringType
	advIntAcctFlg 			stringType
    dlAcctFlg 				stringType
	intRate                 numberType
	numOfAdvInstl           numberType
	upfrontInstlAmt         numberType
	upfrontInstlIntAmt      numberType
	advIntAmt               numberType
	discIntRate             numberType
	schmType				stringType
	defIntAmt				numberType
	maturityDate			stringType
	sbsdy_ind           	stringType
	prinSbsdyAmt        	numberType
	prinRcvdDate        	stringType
	islamicProductTypeFlg	stringType
	assetCode				stringType
	assetDesc				stringType
	purcQnty				numberType
	unitOfMsrt				stringType
	purcPerUnit				numberType
	custIda                                 stringType
	lv_CustomerName				stringType
	userid					stringType

MASSAGERECORD
#############################################################################
#
# 	MASSAGERECORD (Optional Section).
# 	The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#	later. This Block is executed every time a new record is read.
#
#############################################################################

#############################################################################
#
# 	IGNORERECORD (Optional Section).
# 	The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
# 	for input records), the record is Ignored.
#
#############################################################################
IGNORERECORD
	
PAGEFORMAT
#############################################################################
#
# 	PAGEFORMAT (Optional Section).
#   This section tells about the page Layout (Printed Page). Here  the  valid
#   pageformat keywords are Linesperpage, Leftmargin, Rightmargin, Topmargin, 
#   BottomMargin, ColumnsperLine, PageHeaderLines, PageFooterLines,noPageFeed
#   widowOrphanLines.
#
#############################################################################
	widowOrphanLines 	3
	LinesPerPage 		64
	LeftMargin 			0 
	rightMargin		 	0	
	Topmargin			2
	BottomMargin 		2
	columnsPerLine 		132
	pageHeaderLines     10
    pageFooterLines 	4

ONSTARTOFREPORT
#############################################################################
#
#	ONSTARTOFREPORT (Optional Section).
#	This Section  will be  executed  Only  Once  during the Processing of the 
#   the Report (i.e in the beginning of the Report).Here the valid statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#	NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#	If, Else, execute, DontFlushAfterSection.
#
#############################################################################
	set pageNumber = 1
	set count = 0
	set recCount = 0
	set localyears = strToNum localYearsToAdd
	nextline
	execute printReportHdr
	nextline
	execute printCriteria
PAGEHEADER 
#############################################################################
#
#	PAGEHEADER (Optional Section).
#	This Section is Called for whenver there is a PageBreak or NextPage. Here
#   the valid  Statements  are  Actions only, as described in ONSTARTOFREPORT 
#   section. However,the Number of lines printed through the action statement
#   can not exceed the value (no. of lines) specified for pageHeaderLines  in
#   in PAGEFORMAT Section.
#
#############################################################################
execute printHdr
nextline
nextline 
if (schmType = "CLA" AND eiSchmFlg = "N")
begin
	if (recCount = 0)
    begin
        print "Interest on actuals           :" column 5
        nextline
        print "Interest Frequency Details    :" column 5
    end
    else
    begin
        execute printDetailsHdrCLA
    end
end
else
begin
	separatorline
	execute printDetailsHdr
	separatorline
end

PAGEFOOTER
#############################################################################
#
#	PAGEFOOTER (Optional Section).
#	This Section is Called for whenver there is a PageBreak or NextPage. Here
#   the valid  Statements  are  Actions only, as described in ONSTARTOFREPORT 
#   section. However,the Number of lines printed through the action statement
#   can not exceed the value (no. of lines) specified for pageFooterLines  in
#   in PAGEFORMAT Section.
#
#############################################################################
separatorline

ONEVERYRECORD 
#############################################################################
#i
#	ONEVERYRECORD (Optional Section).
#   This section  is  executed  Once  for all input  records. Here, the valid 
#	Statements are Actions only as described in ONSTARTOFREPORT Section.
#
#############################################################################
if (schmType = "CLA" AND eiSchmFlg = "N")
begin
		execute printDetailsCLA
end
else
begin
	execute printDetails
end

ONENDOFREPORT
#############################################################################
#
#	ONENDOFREPORT (Optional Section).
#	This Section  will be  executed  Only  Once  during the Processing of the 
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#	NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#	If, Else, execute, DontFlushAfterSection.
#
#############################################################################
begin
	if (count = 0)
	print "*************** No record selected ***************" center size 132
	nextline
	nextline
end

#############################################################################
#
# 	PROCEDURE BLOCK.
#  	Procedure  itself is a Independent  Block  and  defined at the end of the 
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#	Template File, Makes  it  Structured  and  avoids burring the same set of 
#   codes at several places.
#
#############################################################################

PROCEDURE printHdr
#############################################################################
#
#	PROCEDURE printHdr
#   This procedure is called from PAGEHEADER Section and ONSTARTOFREPORT
#   Section. This prints the Header of the Report on EveryPage.
#
#############################################################################
begin
	nextline
	print "Page: " column 120
	print pageNumber column 126 precision 0
	nextline
end
PROCEDURE printReportHdr
#############################################################################
#
#	PROCEDURE printReportHdr
#   This procedure is called from ONSTARTOFREPORT Section. 
#
#############################################################################
begin
    set localdate = stringToDate  today
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 1
    print " " 
    set localdate = stringToDate  today 
    set localdate = periodAdd localdate localyears Y 
    print localdate DateFormat "HH24:NN:SS"
	print bankName column 35
	print "     "
	print branchName 
	nextline
	nextline
	print "AMORTIZATION SCHEDULE REPORT" size 128  center
	nextline
	print "----------------------------" size 128  center
end


PROCEDURE printCriteria
#############################################################################
#
#	PROCEDURE printCriteria
#   This procedure is called from ONSTARTOFREPORT Section. 
#
#############################################################################
	begin
		separatorline
		print	"ACCOUNT DETAILS" column 20 
		nextline
		nextline
		print	"---------------" column 20
		nextline
		nextline
		print "Account No                          : "  column 10
		print forAcid                                   
		nextline
		nextline
		print "A/C. Open Date / Rescheduling Date  : "  column 10
		set localdate = stringToDate  acctOpnDate
		set localdate = periodAdd localdate localyears Y
		print localdate DateFormat "" 
		nextline
		nextline
		print "Scheme                              : "  column 10
		print schmCode                                 
		nextline
		nextline
		print "CIF ID                              : "  column 10
		print custId                                  
		nextline
		nextline
		set custIda = custId
		set callscript = runscript "getcifname.scr" "custIda" "lv_CustomerName"
		nextline
		print "Customer Name                       : "  column 10
		print lv_CustomerName                                  
		nextline
		nextline
		print "Loan Amount / Rescheduling Princ.   : "  column 10
		print loanAmt                                  
		nextline
		nextline
		print "Schedule Creation Date              : "  column 10
		set localdate = stringToDate  shdlCreationDate
		set localdate = periodAdd localdate localyears Y
		print localdate DateFormat "" 
		nextline
		nextline
		print "Total deferred Interest Amount	     : " column 10
		print defIntAmt column 11
		nextline
        nextline
		print "Maturity Date			     : " column 10
		set localdate = stringToDate  maturityDate
		set localdate = periodAdd localdate localyears Y
		print localdate DateFormat ""   column 11                
		nextline
        nextline
		if (eiSchmFlg = "Y")
    	begin
        	print "Interest Rate                       : "  column 10
        	print intRate                                   
        	nextline
			nextline
        	print "No Of Upfront Instalments           : "  column 10
        	print numOfAdvInstl                             
        	nextline
			nextline
        	print "Upfront Instalment Principal Amount : "  column 10
        	print upfrontInstlAmt                           
        	nextline
			nextline
        	print "Upfront Instalment Interest Amount  : "  column 10
        	print upfrontInstlIntAmt                           
        	nextline
		nextline
		print "Customer Signature                  : "  column 10
		nextline
		nextline
		print "Prepared By                         : "  column 10
		print userid                                  
		nextline
			nextline
    	end
		else
    	begin
        	if (advIntAcctFlg = "Y")
        	begin
            	print "Interest Rate                       : "  column 10
            	print intRate                                   
            	nextline
				nextline
            	print "Advance Interest Amount             : "  column 10
            	print advIntAmt                                 
            	nextline
				nextline
            	if (dlAcctFlg = "Y")
            	begin
                	print "Discounted Interest Rate            : "  column 10
                	print discIntRate                           
                	nextline
					nextline
            	end
        	end
    	end
		nextline
        if(sbsdy_ind = "P")
        begin
        	print "Principal Subsidy Amt.                : " column 10
        	print prinSbsdyAmt
        	nextLine
        	print "Principal Subsidy Received Date       : " column 10
        	set localdate = stringToDate prinRcvdDate
        	set localdate = periodAdd localdate localyears Y
        	print localdate DateFormat ""
        end
		nextline
		if (islamicProductTypeFlg = "S") 
		begin
            print "Asset code                          : "  column 10
            print assetCode
            nextline
            nextline
            print "Asset Description                   : "  column 10
            print assetDesc
            nextline
            nextline
            print "Purchase Quantity                   : "  column 10
            print purcQnty
            nextline
            nextline
            print "Unit Of Measurement                 : "  column 10
            print unitOfMsrt
            nextline
            nextline
            print "Purchase price per Unit             : "  column 10
            print purcPerUnit
            nextline
            nextline
		end
		separatorline
		nextpage
	end

######################################################################################
PROCEDURE printDetailsHdr
######################################################################################
# To be printed after each page break
######################################################################################
begin
		print "Srl No"              column 5
		print "Instlmnt Dt"         column 15
		print "Instlmnt Amt."       column 30
		print "Prin. Amt."          column 50
		print "Interest Amt."       column 70
		print "Prin. Outstanding"   column 90
#	        print "Charges Amt."        column 90
        nextline
        if(sbsdy_ind = "I")
        begin
            print "Subsidy 1"       column 30 
            print "Subsidy 2"       column 50
            print "Subsidy 3"       column 70
            nextline
        end
	if(islamicProductTypeFlg = "U")
	begin	
		print "BankShare Pcnt"      column 5
		print "CustShare Pcnt"      column 15
		print "Prin. Outstanding"   column 30
		print "Cum. Prin."          column 45
		print "Cum. Interest"       column 60
		print "Cum. Charges"        column 75
		print "Flow Description"    column 90
	end
	else
	begin
#               print "Prin. Outstanding"   column 5
#               print "Cum. Prin."          column 30
#               print "Cum. Interest"       column 50
#               print "Cum. Charges"        column 70
#               print "Flow Description"        column 90
	end		
		if(islamicProductTypeFlg = "S")
		begin
			print "OutStQnty to be Dlvrd"	column 107
		end
	if(islamicProductTypeFlg = "M" OR islamicProductTypeFlg = "T" OR islamicProductTypeFlg = "B" OR islamicProductTypeFlg = "A")
    begin
		nextline
        print "Outstanding Selling Price"   column 5
    end
		nextline
end

######################################################################################
PROCEDURE printDetailsHdrCLA
######################################################################################
# To be printed after each page break
######################################################################################
separatorline
begin
        print "Srl No"              column 5
        print "Instlmnt Dt"         column 15
        print "Instlmnt Amt."       column 35
        print "Prin. Amt."          column 35
	print "Prin. Outstanding"   column 55
#       print "Charges Amt."        column 55
        nextline
	if(islamicProductTypeFlg = "U")
	begin
                print "BankShare Pcnt"      column 5
                print "CustShare Pcnt"      column 15
                print "Prin. Outstanding"   column 30
                print "Cum. Prin."          column 50
	        print "Cum. Charges"        column 70
                print "Flow Description"    column 90
	end
	else
	begin
#       print "Prin. Outstanding"   column 5
#       print "Cum. Prin."          column 30
#       print "Cum. Charges"        column 50
#	print "Flow Description"    column 70
	end
        nextline
end
separatorline
########################################################################################
PROCEDURE printDetails
######################################################################################
#
######################################################################################
begin
		set count = count + 1 
		print srlNum              	column 5  size 3
		set localdate = stringToDate  flowDate
		set localdate = periodAdd localdate localyears Y
		print localdate DateFormat "" column 15 

		print instlmntAmt        	column 30  size 17 autocomma rightjustify
		print princAmt           	column 50  size 17 autocomma rightjustify
		print intAmt             	column 70  size 17 autocomma rightjustify
		print princOutStanding          column 90 size 17   autocomma rightjustify
#		print fixedChargeAmt     	column 90  size 17 autocomma rightjustify
        nextline
		if(sbsdy_ind = "I")
		begin
        	print sbsdy1Amt         column 30  size 17 autocomma rightjustify
        	print sbsdy2Amt         column 50  size 17 autocomma rightjustify
        	print sbsdy3Amt         column 70  size 17 autocomma rightjustify
		nextline
		end
		if(islamicProductTypeFlg = "U")
	begin
		print bankSharePcnt		column 5 size 10   autocomma rightjustify 
		print custSharePcnt		column 15 size 10  autocomma rightjustify 
		print princOutStanding   	column 30 size 10   autocomma rightjustify
		print cummPrincAmt       	column 45 size 15  autocomma rightjustify
		print cummIntAmt         	column 60 size 15  autocomma rightjustify
		print cummFixedChargeAmt 	column 75 size 10  autocomma rightjustify
		print flowDesc				column 90 rightjustify 
	end
		else
	begin
#              print princOutStanding          column 5 size 17   autocomma rightjustify
#              print cummPrincAmt              column 30 size 17  autocomma rightjustify
#              print cummIntAmt                column 50 size 17  autocomma rightjustify
#              print cummFixedChargeAmt        column 70 size 17  autocomma rightjustify
#              print flowDesc                          column 90
	end		
	if(islamicProductTypeFlg = "S")
	begin
		print qntyOfAssetDlvd column 105 size 17 precision 0 
	end
	
	if(islamicProductTypeFlg = "M" OR islamicProductTypeFlg = "T" OR islamicProductTypeFlg = "B" OR islamicProductTypeFlg = "A")
	begin
		nextline
		print sellPriceAmt	 column 5  size 25 autocomma rightjustify
	end
		
		nextline
end

########################################################################################
PROCEDURE printDetailsCLA
######################################################################################
#
######################################################################################
if (freqInd = "Y")
begin
	execute printFreqDetails
end
else
begin
	if (recCount = 0)
	begin
		execute printDetailsHdrCLA
		set recCount = 1
	end
	begin
		nextline
        set count = count + 1
        print srlNum                column 5  size 3
        set localdate = stringToDate  flowDate
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 15 

        print instlmntAmt           column 30  size 17 autocomma rightjustify
        print princAmt              column 30  size 17 autocomma rightjustify
	print princOutStanding      column 50 size 17   autocomma rightjustify
#       print fixedChargeAmt        column 50  size 17 autocomma rightjustify
        nextline
        if(islamicProductTypeFlg = "U")
	begin
        print bankSharePcnt         column 5 size 10   autocomma rightjustify 
        print custSharePcnt         column 15 size 10  autocomma rightjustify 
        print princOutStanding      column 30 size 10   autocomma rightjustify
        print cummPrincAmt          column 50 size 15  autocomma rightjustify
        print cummFixedChargeAmt    column 70 size 10  autocomma rightjustify
	print flowDesc	        	column 90 rightjustify
	end
	else
	begin
#       print princOutStanding      column 5 size 17   autocomma rightjustify
#       print cummPrincAmt          column 30 size 17  autocomma rightjustify
#       print cummFixedChargeAmt    column 50 size 17  autocomma rightjustify
#       print flowDesc                          column 70
	end
        nextline
	end
end

########################################################################################
PROCEDURE printFreqDetails
######################################################################################
print "From Date : " column 10
set localdate = stringToDate  flowStartDate
set localdate = periodAdd localdate localyears Y
print localdate DateFormat ""

print "Frequency : " column 60
print freqType
print "/"
print freqWeekNum
print "/"
print freqWeekDay
print "/"
print freqStartDD
print "/"
print freqMonths
print "/"
print freqDays
print "/"
print freqHldyStat
########################################################################################
#end of Mrt #######


