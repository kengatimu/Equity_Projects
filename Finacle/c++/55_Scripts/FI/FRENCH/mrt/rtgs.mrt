# Template Name :		rtgs.mrt
# Description	:		unverified hlara 
# Author			E.G.KAROBIA,27-05-2006
# 
#########################################################################
RECORDLAYOUT

SOL_ID 	        stringtype
TRAN_ID	        stringtype
SENDER_REF_NUM  stringtype
TRAN_DATE       stringType
TRAN_AMT        stringType
PAYSYS_ID       stringType
RCRE_USER_ID    stringType


####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 70
columnsperline 89
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 93 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print SOL_ID    column 4
	print TRAN_ID   column 11
	print SENDER_REF_NUM  column 24
	print TRAN_DATE  column 40
	print TRAN_AMT column 52
	print PAYSYS_ID column 68
	print RCRE_USER_ID column 79
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL ID"   column 4
	print "TRAN ID"   column 12
	print "SENDER REF NUM " COLUMN 24
	print "TRAN DATE" column  40
	print "TRAN AMT"   column 52
	print "PAYSYS ID"   column 66
	print "ENTERER ID " COLUMN 78
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 89 center 
	nextline
	print branchName  size 89 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 89 center
	nextline
	print "UNVERIFIED RTGS REPORT" size 89 center 
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 88 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 2
	print "|"   column 10
	print "|"   column 22
	print "|"   column 38
	print "|"   column 50
	print "|"   column 64
	print "|"   column 76
	print "|"   column 89
end


