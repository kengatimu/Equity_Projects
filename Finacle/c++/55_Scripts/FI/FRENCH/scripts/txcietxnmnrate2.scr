ENDIF

IF(CUST.CIETXN.treaRate != "")THEN
#{
	sv_u = urhk_SetUrhkInp("treaRate|"+CUST.CIETXN.treaRate)
#}
ENDIF

sv_u = urhk_SetUrhkOut("rate|rate")
sv_u = urhk_SetUrhkOut("treaRate|treaRate")
