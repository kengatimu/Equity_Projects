########################################################################################################
# rate request
########################################################################################################
<--start
trace on

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

CUST.DATA.BankId=BANCS.STDIN.contextBankId
print(CUST.DATA.BankId)
CUST.DATA.from_cncy=CUST.CIETXN.drAcctNumCcy
print(CUST.DATA.from_cncy)


IF (FIELDEXISTS(CUST.CIETXN.crAcctNum)) THEN
	CUST.CIETXN.crAcctNum = CUST.CIETXN.crAcctNum
	print(CUST.CIETXN.crAcctNum)
	IF(FIELDEXISTS(CUST.CIETXN.creditEntity))THEN
		print(CUST.CIETXN.creditEntity)
		IF ((FIELDEXISTS(CUST.CIETXN.creditEntity)) AND (FIELDEXISTS(CUST.CIETXN.crAcctNum))) THEN
			BANCS.INPARAM.BINDVARS =  CUST.CIETXN.crAcctNum + "|" + CUST.CIETXN.creditEntity
			print(BANCS.INPARAM.BINDVARS)
			sv_u = "Acctcrncycode|SELECT acct_crncy_code FROM tbaadm.gam "
			sv_u = sv_u + " where  foracid= ?SVAR "
			sv_u = sv_u + " AND BANK_ID = ?SVAR and acct_cls_flg='N' "
			print(sv_u)
			sv_y=urhk_dbSelectWithBind(sv_u)
			print(sv_y)
			if (sv_y == "0") then
				CUST.DATA.Acctcrncycode=BANCS.OUTPARAM.Acctcrncycode
				print(CUST.DATA.Acctcrncycode)
				CUST.DATA.to_crncy=CUST.DATA.Acctcrncycode
				print(CUST.DATA.to_crncy)
				CUST.CIETXN.crAcctNumCcy = CUST.DATA.Acctcrncycode
				print(CUST.CIETXN.crAcctNumCcy)
			ELSE
				CUST.DATA.errMsg="Invalid credit Account"
				sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
				sv_e=urhk_SetOrbOut("StattusCode|2")
				GOTO End
			endif
		ENDIF
	ENDIF
ENDIF


CUST.DATA.tran_crncy=CUST.CIETXN.rateCode
print(CUST.DATA.tran_crncy)
CUST.DATA.rate_code=CUST.CIETXN.rateCode
print(CUST.DATA.rate_code)
CUST.DATA.refAmt=CUST.CIETXN.refAmt
print(CUST.DATA.refAmt)

IF (BANCS.STDIN.contextBankId!="99") THEN
	BANCS.INPARAM.BINDVARS =  CUST.DATA.rate_code + "|" +BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_u = "count|SELECT count(1) FROM tbaadm.rtl "
	sv_u = sv_u + " where  RATECODE= ?SVAR "
	sv_u = sv_u + " AND BANK_ID = ?SVAR and del_flg='N' "
	print(sv_u)
	sv_y=urhk_dbSelectWithBind(sv_u)
	print(sv_y)
	if (sv_y == "0") then
		CUST.DATA.count=BANCS.OUTPARAM.count
		print(CUST.DATA.count)
		if (CUST.DATA.count==0) then
			CUST.DATA.errMsg="Kindly Supply Valid rate_code"
			sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
			sv_e=urhk_SetOrbOut("StattusCode|2")
			GOTO End
		endif
	endif
ENDIF

############################################
# Fetching the value from table
############################################
		CUST.CIETXN.DccId=""
		sv_a = urhk_GetChannelInfo("")
		print(sv_a)
		if (sv_a!=0) then
		#{
			sv_u = urhk_SRV_SetErr("Error: Channel ID is not passed/Incorrect")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		else
		#{
			CUST.CIETXN.DccId = BANCS.OUTPARAM.DccId
			print(CUST.CIETXN.DccId)

			IF ((CUST.CIETXN.DccId=="FNT") OR (CUST.CIETXN.DccId=="COR") OR (CUST.CIETXN.DccId=="EAZ")) THEN
			IF (CUST.DATA.to_crncy == CUST.DATA.from_cncy) THEN
			CUST.DATA.rate="1"
			CUST.DATA.treaRate=""
			ENDIF
			ENDIF

BANCS.INPARAM.BINDVARS =CUST.DATA.from_cncy + "|" + CUST.DATA.to_crncy
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.rate_code + "|" +BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
sv_u = sv_u + " AND RATECODE= ?SVAR "
sv_u = sv_u + " AND BANK_ID = ?SVAR  and rownum<2 "
print(sv_u)
sv_y=urhk_dbSelectWithBind(sv_u)
print(sv_y)
if (sv_y == "0") then
	sv_k = BANCS.OUTPARAM.fxdcrncycode
	print(sv_k)
	sv_j = BANCS.OUTPARAM.ratecode
	print(sv_j)
	sv_p = BANCS.OUTPARAM.Rate
	print(sv_p)
	CUST.DATA.rate = sv_p
	print(CUST.DATA.rate)
	sv_x= BANCS.OUTPARAM.treaRate
	print(sv_x)
	CUST.DATA.treaRate = sv_x
	print(CUST.DATA.treaRate)
	CUST.DATA.fixed_crncy = CUST.DATA.from_cncy
	print(CUST.DATA.fixed_crncy)
	CUST.DATA.var_crncy = CUST.DATA.to_crncy
	print(CUST.DATA.var_crncy)
	IF ((CUST.CIETXN.DccId=="EBK") OR (CUST.CIETXN.DccId=="OMN")) THEN
		CUST.CIETXN.tranAmtCrEBK = CDOUBLE(CUST.DATA.refAmt) * CDOUBLE(CUST.DATA.rate)
		print(CUST.CIETXN.tranAmtCrEBK)
		CUST.CIETXN.tranAmtDrEBK = CDOUBLE(CUST.DATA.refAmt) * CDOUBLE(CUST.DATA.rate)
		print(CUST.CIETXN.tranAmtDrEBK)
		
	ENDIF
else
	BANCS.INPARAM.BINDVARS = CUST.DATA.to_crncy + "|" + CUST.DATA.from_cncy 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.rate_code + "|" +BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
	sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
	sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
	sv_u = sv_u + " AND RATECODE= ?SVAR "
	sv_u = sv_u + " AND BANK_ID = ?SVAR and rownum<2 "
	print(sv_u)
	sv_y=urhk_dbSelectWithBind(sv_u)
	print(sv_y)
	if (sv_y == "0") then
		sv_k = BANCS.OUTPARAM.fxdcrncycode
		print(sv_k)
		sv_j = BANCS.OUTPARAM.ratecode
		print(sv_j)
		sv_p = BANCS.OUTPARAM.Rate
		print(sv_p)
		CUST.DATA.rate = sv_p
		print(CUST.DATA.rate)
		sv_x= BANCS.OUTPARAM.treaRate
		print(sv_x)
		CUST.DATA.treaRate = sv_x
		print(CUST.DATA.treaRate)
		CUST.DATA.fixed_crncy = CUST.DATA.to_crncy
		print(CUST.DATA.fixed_crncy)
		CUST.DATA.var_crncy = CUST.DATA.from_cncy
		print(CUST.DATA.var_crncy)
		
		IF ((CUST.CIETXN.DccId=="EBK") OR (CUST.CIETXN.DccId=="OMN")) THEN
			print(BANCS.INPUT.refAmt)
			CUST.CIETXN.tranAmtCrEBK = CDOUBLE(CUST.DATA.refAmt) / CDOUBLE(CUST.DATA.rate)
			print(CUST.CIETXN.tranAmtCrEBK)
			CUST.CIETXN.tranAmtDrEBK = CDOUBLE(CUST.DATA.refAmt) / CDOUBLE(CUST.DATA.rate)
			print(CUST.CIETXN.tranAmtDrEBK)

			CUST.CIETXN.tranAmtDrEBK = FORMAT$(CDOUBLE(CUST.CIETXN.tranAmtDrEBK),"%.2f")
			print(CUST.CIETXN.tranAmtDrEBK)
		ENDIF
	ELSE
		IF (CUST.DATA.to_crncy != CUST.DATA.from_cncy) THEN
		#{
			CUST.DATA.errMsg="Rate Not Maintained"
			sv_e=urhk_SetOrbOut("StattusCode|2")
			sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		#}
		ELSE
		#{
		print("No conversion rate required")
		IF ((CUST.CIETXN.DccId=="EBK") OR (CUST.CIETXN.DccId=="OMN")) THEN
			print(BANCS.INPUT.refAmt)
			CUST.CIETXN.tranAmtCrEBK = CDOUBLE(CUST.DATA.refAmt)
			print(CUST.CIETXN.tranAmtCrEBK)
			CUST.CIETXN.tranAmtDrEBK = CDOUBLE(CUST.DATA.refAmt)
			print(CUST.CIETXN.tranAmtDrEBK)

			CUST.CIETXN.tranAmtDrEBK = FORMAT$(CDOUBLE(CUST.CIETXN.tranAmtDrEBK),"%.2f")
			print(CUST.CIETXN.tranAmtDrEBK)
		ENDIF

		#}
		ENDIF
		
	endif
endif


