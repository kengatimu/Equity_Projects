###########################################################################################
<--START
CHECKSUM="0f2717f224982e57f241387c5183ae8365ba6130b1d6ce5372279baaa53ba509"
	TRACE ON
	
	CUST.CIETXN.scriptSuccess = "Y"
	
	#-----------------------------------------------------------------------------------------
	# INPUTS TO THE SCRIPT
	#-----------------------------------------------------------------------------------------
	PRINT(BANCS.INPUT.initOrInterOrTargetEntity)
	PRINT(BANCS.INPUT.initEntity)
	PRINT(BANCS.INPUT.targetEntity)
	PRINT(BANCS.INPUT.foracid)
	PRINT(BANCS.INPUT.refCrncy)
	PRINT(BANCS.INPUT.refAmt)
	
	CUST.CIETXN.initOrInterOrTargetEntity = BANCS.INPUT.initOrInterOrTargetEntity
	CUST.CIETXN.initEntity = BANCS.INPUT.initEntity
	CUST.CIETXN.targetEntity = BANCS.INPUT.targetEntity
	CUST.CIETXN.foracid = BANCS.INPUT.foracid
	CUST.CIETXN.refCrncyTmp = BANCS.INPUT.refCrncy
	CUST.CIETXN.refAmtTmp = BANCS.INPUT.refAmt
	
	#-----------------------------------------------------------------------------------------
	# OUTPUTS FROM THE SCRIPT - Initialization
	#-----------------------------------------------------------------------------------------
	
	CUST.CIETXN.ieRateCode = " "
	CUST.CIETXN.ieRate = " "
	CUST.CIETXN.ieTreaRate = " "
	
	IF(CUST.CIETXN.initOrInterOrTargetEntity == "IE")THEN
	#{
		CUST.CIETXN.tranAmt = " "
		CUST.CIETXN.tranAmtCcy = " "
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------
	# GET ACCOUNT CCY
	#-----------------------------------------------------------------------------------------
	
	CUST.CIETXN.acctCrncy = ""
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.foracid
	lv_s = "acctCrncy|SELECT ACCT_CRNCY_CODE FROM TBAADM.GAM WHERE FORACID = ?SVAR"
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	
	IF(lv_d == 0)THEN
	#{
		CUST.CIETXN.acctCrncy = BANCS.OUTPARAM.acctCrncy
	#}
	ENDIF
	
	###########################################################################################
	# Rate is set to 1 for same currency txn
	###########################################################################################
	
	IF(CUST.CIETXN.refCrncyTmp == CUST.CIETXN.acctCrncy)THEN
	#{
		CUST.CIETXN.ieRate = "1.00"
		CUST.CIETXN.ieRateCode = " "
		CUST.CIETXN.ieTreaRate = "0.00"
		CUST.CIETXN.acctCrncy = CUST.CIETXN.refCrncyTmp
		
		IF(CUST.CIETXN.initOrInterOrTargetEntity == "IE")THEN
		#{
			CUST.CIETXN.tranAmt = CUST.CIETXN.refAmtTmp
			CUST.CIETXN.tranAmtCcy = CUST.CIETXN.refCrncyTmp
		#}
		ENDIF
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###########################################################################################
	# Get Inter Entity Cash Withdrawal Rate Code from CPARAM
	###########################################################################################
	CUST.CIETXN.ieRateCode = ""
	CUST.CIETXN.cparamIECWRateCode= ""
	
	IF(CUST.CIETXN.initOrInterOrTargetEntity == "I")THEN
	#{
		CUST.CIETXN.parameterId = "CW_RATE_CODE_" + CUST.CIETXN.initEntity + CUST.CIETXN.refCrncyTmp + CUST.CIETXN.initEntity + CUST.CIETXN.acctCrncy
		IF((CUST.CIETXN.refCrncyTmp == "USD") OR (CUST.CIETXN.refCrncyTmp == "GBP") OR (CUST.CIETXN.refCrncyTmp == "EUR"))THEN
		#{
			CUST.CIETXN.parameterId = "CW_RATE_CODE_" + CUST.CIETXN.initEntity + CUST.CIETXN.acctCrncy + CUST.CIETXN.initEntity + CUST.CIETXN.refCrncyTmp
		#}
		ENDIF
		
		IF((CUST.CIETXN.acctCrncy == "USD") OR (CUST.CIETXN.acctCrncy == "GBP") OR (CUST.CIETXN.acctCrncy == "EUR"))THEN
		#{
			CUST.CIETXN.parameterId = "CW_RATE_CODE_" + CUST.CIETXN.initEntity + CUST.CIETXN.refCrncyTmp + CUST.CIETXN.initEntity + CUST.CIETXN.acctCrncy
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.CIETXN.initOrInterOrTargetEntity == "IE")THEN
	#{
		CUST.CIETXN.parameterId = "CW_RATE_CODE_" + CUST.CIETXN.initEntity + CUST.CIETXN.refCrncyTmp + CUST.CIETXN.targetEntity + CUST.CIETXN.acctCrncy
	#}
	ENDIF
	
	IF (CUST.CIETXN.initOrInterOrTargetEntity == "T")  THEN
	#{
		CUST.CIETXN.parameterId = "CW_RATE_CODE_" + CUST.CIETXN.targetEntity + CUST.CIETXN.refCrncyTmp + CUST.CIETXN.targetEntity + CUST.CIETXN.acctCrncy
		
		IF (CUST.CIETXN.initEntity =="56") THEN
		#{
			IF (CUST.CIETXN.refCrncy == "KES") THEN
			#{
				
				CUST.CIETXN.parameterId = "CW_RATE_CODE1_" + CUST.CIETXN.targetEntity + CUST.CIETXN.refCrncyTmp + CUST.CIETXN.targetEntity + CUST.CIETXN.acctCrncy
				
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.CIETXN.parameterId)
	
	sv_s = "cparamIECWRateCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.initEntity + "|" + CUST.CIETXN.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.scriptSuccess = "N"
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Rate Code not set in " + CUST.CIETXN.initEntity + " Entity CPARAM for Inter Entity Cash Withdrawal. Parameter ID: " + CUST.CIETXN.parameterId
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.cparamIECWRateCode = BANCS.OUTPARAM.cparamIECWRateCode
	print(CUST.CIETXN.cparamIECWRateCode)
	
	IF(TRIM(CUST.CIETXN.cparamIECWRateCode) == "")THEN
	#{
		CUST.CIETXN.scriptSuccess = "N"
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Rate Code not set in " + CUST.CIETXN.initEntity + " Entity CPARAM for Inter Entity Cash Withdrawal. Parameter ID: " + CUST.CIETXN.parameterId
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.ieRateCode = CUST.CIETXN.cparamIECWRateCode
	PRINT(CUST.CIETXN.ieRateCode)
	
	#-----------------------------------------------------------------------------------------
	# GET RATE AND TREASURY RATE
	#-----------------------------------------------------------------------------------------
	
	IF((CUST.CIETXN.initOrInterOrTargetEntity == "I") OR (CUST.CIETXN.initOrInterOrTargetEntity == "IE"))THEN
	#{
		#No Context Switch Required
	#}
	ENDIF
	
	IF(CUST.CIETXN.initOrInterOrTargetEntity == "T")THEN
	#{
		CUST.CIETXN.entityId = CUST.CIETXN.targetEntity
		PRINT(CUST.CIETXN.entityId)
		CALL("cietxndp010.scr")
	#}
	ENDIF
	
	###########################################################################################
	# Get Rate From SRV
	###########################################################################################
	
	lv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.CIETXN.refCrncyTmp)
	lv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.CIETXN.acctCrncy)
	lv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.CIETXN.ieRateCode)
	lv_u = urhk_SetUrhkInp("fromAmt|"+CUST.CIETXN.refAmtTmp+"|"+CUST.CIETXN.refCrncyTmp)
	lv_u = urhk_SetUrhkOut("rate|ieRate")
	lv_u = urhk_SetUrhkOut("treaRate|ieTreaRate")
	lv_u = urhk_SetUrhkOut("toAmt|toAmt")
	
	lv_u = urhk_ExecSrvNoCommit("SRV_TieredConvCrncy")
	print(lv_u)
	
	IF(lv_u == 0)THEN
	#{
		CUST.CIETXN.ieRate = BANCS.OUTPARAM.ieRate
		PRINT(CUST.CIETXN.ieRate)
		
		CUST.CIETXN.ieTreaRate = BANCS.OUTPARAM.ieTreaRate
		PRINT(CUST.CIETXN.ieTreaRate)
		
		CUST.CIETXN.toAmt = BANCS.OUTPARAM.toAmt
		PRINT(CUST.CIETXN.toAmt)
		
		lv_p = GETPOSITION(CUST.CIETXN.toAmt,"|")
		print(lv_p)
		
		IF(lv_p > 0)THEN
		#{
			IF(CUST.CIETXN.initOrInterOrTargetEntity == "IE")THEN
			#{
				CUST.CIETXN.tranAmt = MID$(CUST.CIETXN.toAmt,0,lv_p-1)
				PRINT(CUST.CIETXN.tranAmt)
				CUST.CIETXN.tranAmtCcy = MID$(CUST.CIETXN.toAmt,lv_p,3)
				PRINT(CUST.CIETXN.tranAmtCcy)
			#}
			ENDIF
		#}
		ENDIF
		
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.Fatal_num)
		print(BANCS.OUTPARAM.Error_num)
		print(BANCS.OUTPARAM.Warning_num)
		print(BANCS.OUTPARAM.UserInfo_num)
		print(BANCS.OUTPARAM.Xcpn_num)
		print(BANCS.OUTPARAM.Xcpn_Err_num)
		print(BANCS.OUTPARAM.Xcpn_Xcpn_num)
		print(BANCS.OUTPARAM.Xcpn_Err_num)
		
		lv_d = 1
		lv_n = 1
		lv_c = CINT(BANCS.OUTPARAM.Error_num)
		WHILE (lv_d <= lv_c)
		#{
			lv_f = FORMAT$(lv_d,"%d")
			lv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+lv_f)
			print(lv_b)
			lv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+lv_f)
			print(lv_e)
			lv_a = ("BANCS").("OUTPARAM").("Tag_"+lv_f)
			print(lv_a)
			lv_d = lv_d + 1
			lv_n = lv_n + 1
			lv_d = lv_c + 1
		#}
		DO
		CUST.CIETXN.scriptSuccess = "N"
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = lv_b
		CUST.CIETXN.ieRate = " "
		CUST.CIETXN.tranAmt = " "
		CUST.CIETXN.tranAmtCcy = " "
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		IF(CUST.CIETXN.initOrInterOrTargetEntity == "T")THEN
		#{
			CUST.CIETXN.entityId = CUST.CIETXN.initEntity
			PRINT(CUST.CIETXN.entityId)
			CALL("cietxndp010.scr")
		#}
		ENDIF
		
		#-----------------------------------------------------------------------------------------
		# OUTPUTS FROM THE SCRIPT
		#-----------------------------------------------------------------------------------------
		
		PRINT(CUST.CIETXN.ieRateCode)
		PRINT(CUST.CIETXN.ieRate)
		PRINT(CUST.CIETXN.ieTreaRate)
		PRINT(CUST.CIETXN.tranAmt)
		PRINT(CUST.CIETXN.tranAmtCcy)
		
		
		
		
END-->
