<--start
trace on
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	EQSRV.GLBDATA.solId	= ""
	EQSRV.GLBDATA.glSubHeadCode	= ""
	EQSRV.GLBDATA.crncyCode	= ""
	EQSRV.GLBDATA.schmCode	= ""
	EQSRV.GLBDATA.Onforacid = ""
	EQSRV.GLBDATA.valerr = ""
	EQSRV.GLBDATA.MobileNumber = ""
	EQSRV.GLBDATA.activationMsg = ""	
	EQSRV.GLBDATA.schmType  =  "" 
	EQSRV.GLBDATA.acctClsFlg   = "" 
	EQSRV.GLBDATA.clearBalance = 0 
	if(fieldexists(BANCS.INPUT.jipangeAcct)==1)then
		EQSRV.GLBDATA.jipangeAcct = BANCS.INPUT.jipangeAcct
	else
		EQSRV.GLBDATA.jipangeAcct = ""
	endif
	if(fieldexists(BANCS.INPUT.sourceAcct)==1)then
		EQSRV.GLBDATA.sourceAcct = BANCS.INPUT.sourceAcct
	else
		EQSRV.GLBDATA.sourceAcct = ""
	endif
	if(fieldexists(BANCS.INPUT.cifId)==1)then
		EQSRV.GLBDATA.cifId = BANCS.INPUT.cifId
	else
		EQSRV.GLBDATA.cifId = ""
	endif
	if(fieldexists(BANCS.INPUT.durationMnths)==1)then
		EQSRV.GLBDATA.durationMnths = BANCS.INPUT.durationMnths
	else
		EQSRV.GLBDATA.durationMnths = "0"
	endif
	if(fieldexists(BANCS.INPUT.durationDays)==1)then
		EQSRV.GLBDATA.durationDays = BANCS.INPUT.durationDays
	else
		EQSRV.GLBDATA.durationDays = ""
	endif
	if(fieldexists(BANCS.INPUT.payoutDays)==1)then
		EQSRV.GLBDATA.payoutDays = BANCS.INPUT.payoutDays
	else
		EQSRV.GLBDATA.payoutDays = "0"
	endif
	EQSRV.GLBDATA.clearBalance = "0"
#Acct
	sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.jipangeAcct)
	if(sv_u ==0)then
		EQSRV.GLBDATA.glSubHeadCode	= BANCS.OUTPARAM.glSubHeadCode
		EQSRV.GLBDATA.solId	=	BANCS.OUTPARAM.acctSolId
		EQSRV.GLBDATA.schmType	=	BANCS.OUTPARAM.schmType
		EQSRV.GLBDATA.schmCode	=	BANCS.OUTPARAM.schmCode
		EQSRV.GLBDATA.crncyCode	=	BANCS.OUTPARAM.acctCrncyCode	
		EQSRV.GLBDATA.acctClsFlg	=	BANCS.OUTPARAM.acctCloseflg
		EQSRV.GLBDATA.clearBalance      = BANCS.OUTPARAM.clearBalance
	endif
	if(EQSRV.GLBDATA.schmType !="SBA")then
		EQSRV.GLBDATA.srvYN = "N"
		EQSRV.GLBDATA.valerr	=	"Account not related with Goals " +EQSRV.GLBDATA.jipangeAcct
		goto VAYU
	endif
	if(EQSRV.GLBDATA.acctClsFlg =="Y")then
		EQSRV.GLBDATA.srvYN = "N"
		EQSRV.GLBDATA.valerr	=	"Account is in Closed " +EQSRV.GLBDATA.jipangeAcct
		goto VAYU
	endif
	if(EQSRV.GLBDATA.sourceAcct!="")then
		sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.sourceAcct)
		if(sv_u !=0)then
			EQSRV.GLBDATA.srvYN = "N"
			EQSRV.GLBDATA.valerr= "Invalid Source Account"
			goto VAYU
		endif
	endif
#ContextSol
	print(BANCS.STDIN.mySolId)
	print(EQSRV.GLBDATA.solId)
	if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.solId ) then
		sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.solId)
		sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
		if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
			print(BANCS.OUTPARAM.successOrFailure)
			sv_s = BANCS.OUTPARAM.successOrFailure
		else
			sv_s = "X"
		endif
		if (( sv_u != 0 ) and ( sv_s != "S"))then
			EQSRV.GLBDATA.srvYN = "N"
			EQSRV.GLBDATA.valerr	=	"CCS Failed"
			goto VAYU
		endif
	endif
#stChange
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|0")
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + EQSRV.GLBDATA.jipangeAcct)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId|" + EQSRV.GLBDATA.solId)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.glSubHeadCode|" + EQSRV.GLBDATA.glSubHeadCode)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.solId|" + EQSRV.GLBDATA.solId)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.crncyCode|" + EQSRV.GLBDATA.crncyCode)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + EQSRV.GLBDATA.schmCode)
	if(EQSRV.GLBDATA.schmType == "SBA")then
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|SBA")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText1|sourceAcctId")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText2|durationMnths")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText3|durationDays")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText4|SalaryPayOutDays")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText5|goalExpiryDate")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText6|goalAprOctYN")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText10|actualgoalExpiryDate")
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctClassMISC.freeText11|MobileNumber")
		sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
	endif
	print(sv_u)
	if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
		print(BANCS.OUTPARAM.successOrFailure)
		sv_s = BANCS.OUTPARAM.successOrFailure
	else
		sv_s = "X"
	endif
	if (( sv_u == 0 ) and ( sv_s=="S") ) then
		print(BANCS.OUTPARAM.successOrFailure)
		EQSRV.GLBDATA.ssourceAcctId = BANCS.OUTPARAM.sourceAcctId
		EQSRV.GLBDATA.sdurationMnths = BANCS.OUTPARAM.durationMnths
		EQSRV.GLBDATA.sdurationDays = BANCS.OUTPARAM.durationDays
		EQSRV.GLBDATA.sSalaryPayOutDays = BANCS.OUTPARAM.SalaryPayOutDays
		EQSRV.GLBDATA.sgoalExpiryDate = BANCS.OUTPARAM.goalExpiryDate
		EQSRV.GLBDATA.goalAprOctYN = BANCS.OUTPARAM.goalAprOctYN
		EQSRV.GLBDATA.actualgoalExpiryDate = BANCS.OUTPARAM.actualgoalExpiryDate
		EQSRV.GLBDATA.MobileNumber = BANCS.OUTPARAM.MobileNumber
	else
		callscriptifexist("ebsrvHandler.scr")
		EQSRV.GLBDATA.srvYN = "N"
		EQSRV.GLBDATA.valerr	=	EQSRV.GLBDATA.SrvError	
		goto VAYU
	endif
	sv_a = urhk_CopyOutToIn("")
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + EQSRV.GLBDATA.jipangeAcct)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId|" + EQSRV.GLBDATA.solId)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.glSubHeadCode|" + EQSRV.GLBDATA.glSubHeadCode)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.solId|" + EQSRV.GLBDATA.solId)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.crncyCode|" + EQSRV.GLBDATA.crncyCode)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + EQSRV.GLBDATA.schmCode)
	if(EQSRV.GLBDATA.schmType == "SBA")then
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|SBA")
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.acctClassMISCEntered|1")
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.schmType|SBA")
	endif
	#SourceAcct
	print(EQSRV.GLBDATA.ssourceAcctId)
	print(EQSRV.GLBDATA.sourceAcct)
	if(EQSRV.GLBDATA.sourceAcct!="")then
	if(EQSRV.GLBDATA.ssourceAcctId != EQSRV.GLBDATA.sourceAcct)then
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText1|" + EQSRV.GLBDATA.sourceAcct ) 
	endif
	endif
	#Duration Months
	print(EQSRV.GLBDATA.sdurationMnths)
	print(EQSRV.GLBDATA.durationMnths)
	if(cint(EQSRV.GLBDATA.durationMnths)>0)then
	if(EQSRV.GLBDATA.sdurationMnths != EQSRV.GLBDATA.durationMnths)then
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText2|" + EQSRV.GLBDATA.durationMnths )
	endif
	endif
	#Duration Days
	print(EQSRV.GLBDATA.sdurationDays)
	print(EQSRV.GLBDATA.durationDays)
	##if(cint(EQSRV.GLBDATA.durationDays)>0)then
	if(EQSRV.GLBDATA.sdurationDays != EQSRV.GLBDATA.durationDays)then
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText3|" + EQSRV.GLBDATA.durationDays )
	endif
	##endif
	#Salary PayoutDays
	print(EQSRV.GLBDATA.sSalaryPayOutDays)
	print(EQSRV.GLBDATA.payoutDays)
	if(cint(EQSRV.GLBDATA.payoutDays)>0)then
	if(EQSRV.GLBDATA.sSalaryPayOutDays != EQSRV.GLBDATA.payoutDays)then
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText4|" + EQSRV.GLBDATA.payoutDays )
	endif
	endif
	#Goal Expiry Date
	print(EQSRV.GLBDATA.sdurationMnths)
	print(EQSRV.GLBDATA.durationMnths)
	print(EQSRV.GLBDATA.sdurationDays)
	print(EQSRV.GLBDATA.durationDays)
	if((cint(EQSRV.GLBDATA.durationMnths)>=1) or (cint(EQSRV.GLBDATA.durationDays)>=1))then
	if((EQSRV.GLBDATA.sdurationMnths != EQSRV.GLBDATA.durationMnths) or (EQSRV.GLBDATA.sdurationDays != EQSRV.GLBDATA.durationDays))then
		if(EQSRV.GLBDATA.goalAprOctYN =="OCT")then
			sv_d = left$(BANCS.STDIN.BODDate,10)
			print(sv_d)
			sv_y = mid$(sv_d,6,10)
			print(sv_y)
			sv_m = mid$(sv_d,3,2)
			print(sv_m)
			if(cint(sv_m)<=10)then
				##18-07-2019 00:00:00
				EQSRV.GLBDATA.actualfrmDate = "01-10-" +sv_y+ " 00:00:00"
				print(EQSRV.GLBDATA.actualfrmDate)
			endif
			if(cint(sv_m)>10)then
				BANCS.STDIN.inp1=sv_y
				BANCS.STDIN.inp2="1"
				BANCS.STDIN.inp3 = cint(BANCS.STDIN.inp1) + cint(BANCS.STDIN.inp2)
				print(BANCS.STDIN.inp3)
				EQSRV.GLBDATA.actualfrmDate = "01-10-" +BANCS.STDIN.inp3+ " 00:00:00"
				print(EQSRV.GLBDATA.actualfrmDate)
			endif
		endif
		if(EQSRV.GLBDATA.goalAprOctYN=="APR")then
			sv_d = left$(BANCS.STDIN.BODDate,10)
			print(sv_d)
			sv_y = mid$(sv_d,6,10)
			print(sv_y)
			sv_m = mid$(sv_d,3,2)
			print(sv_m)
			if(cint(sv_m)<=4)then
				EQSRV.GLBDATA.actualfrmDate = "01-04-" +sv_y+ " 00:00:00"
				print(EQSRV.GLBDATA.actualfrmDate)
			endif
			if(cint(sv_m)>4)then
				BANCS.STDIN.inp1=sv_y
				BANCS.STDIN.inp2="1"
				BANCS.STDIN.inp3 = cint(BANCS.STDIN.inp1) + cint(BANCS.STDIN.inp2)
				print(BANCS.STDIN.inp3)
				EQSRV.GLBDATA.actualfrmDate = "01-04-" +BANCS.STDIN.inp3+ " 00:00:00"
				print(EQSRV.GLBDATA.actualfrmDate)
			endif
		endif
		if(cdouble(EQSRV.GLBDATA.durationDays)>=1)then
			EQSRV.GLBDATA.durationDays = EQSRV.GLBDATA.durationDays
		else
			if(cint(EQSRV.GLBDATA.sdurationDays)>=1)then
				EQSRV.GLBDATA.durationDays = EQSRV.GLBDATA.sdurationDays 
			else
				EQSRV.GLBDATA.durationDays = "0"
			endif
		endif
		EQSRV.GLBDATA.newDate = (EQSRV.GLBDATA.actualfrmDate + "|" + EQSRV.GLBDATA.durationMnths + "|" + EQSRV.GLBDATA.durationDays)
		print(EQSRV.GLBDATA.newDate)
		sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.newDate)
		print(sv_u)
		if(sv_u != 0)then
			EQSRV.GLBDATA.goalExpiryDate = LEFT$(BANCS.STDIN.BODDate,10)
			print(EQSRV.GLBDATA.goalExpiryDate)
		else
			EQSRV.GLBDATA.goalExpiryDate = BANCS.OUTPARAM.MODIFIED_DATE
			print(EQSRV.GLBDATA.goalExpiryDate)
		endif
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText10|" + EQSRV.GLBDATA.goalExpiryDate )
	endif
	endif
	#Apr Pointer
		#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText7]
	#Oct Pointer
		#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText8]

	if(EQSRV.GLBDATA.schmType == "SBA")then	
		sv_u = urhk_SetUrhkOut("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|foracid")
		sv_u = urhk_ExecSrvNoCommit("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
	endif
	print(sv_u)
	if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
		print(BANCS.OUTPARAM.successOrFailure)
		sv_s = BANCS.OUTPARAM.successOrFailure
	else
		sv_s = "X"
	endif
	if (( sv_u == 0 ) and ( sv_s=="S") ) then
		EQSRV.GLBDATA.Onforacid	=	BANCS.OUTPARAM.foracid
		print(EQSRV.GLBDATA.Onforacid)
		EQSRV.GLBDATA.srvYN = "Y"
		EQSRV.GLBDATA.valerr	= "Goal Account Modified Successfully"
		##SMS Push	
                                sv_d = "refNum | SELECT TO_CHAR(SYSDATE,'YYMMDDMISS') FROM DUAL"
                                sv_u = urhk_dbSelectWithBind(sv_d)
                                if(sv_u==0)then
                                        EQSRV.GLBDATA.refNum =  BANCS.OUTPARAM.refNum
                                else
                                        EQSRV.GLBDATA.refNum = "XXXYYY"
                                endif
				print(EQSRV.GLBDATA.sSalaryPayOutDays)
				print(EQSRV.GLBDATA.payoutDays)
				if(cint(EQSRV.GLBDATA.payoutDays)>=1)then
					EQSRV.GLBDATA.msgPayoutDays = EQSRV.GLBDATA.payoutDays
				else
					EQSRV.GLBDATA.msgPayoutDays = EQSRV.GLBDATA.sSalaryPayOutDays
				endif
				print(EQSRV.GLBDATA.sdurationMnths)
				print(EQSRV.GLBDATA.durationMnths)
				if(cint(EQSRV.GLBDATA.durationMnths)>=1)then
					EQSRV.GLBDATA.msgPayoutMnths = EQSRV.GLBDATA.durationMnths
				else
					EQSRV.GLBDATA.msgPayoutMnths = EQSRV.GLBDATA.sdurationMnths
				endif
				if(cdouble(EQSRV.GLBDATA.clearBalance)>=1)then
					EQSRV.GLBDATA.msgSalAmt = cdouble(EQSRV.GLBDATA.clearBalance)/cint(EQSRV.GLBDATA.msgPayoutMnths)
				else
					EQSRV.GLBDATA.msgSalAmt = "0.00"
				endif
				sv_s = "msgSalAmt | select to_char("+EQSRV.GLBDATA.msgSalAmt+",99999999999999999999.99) from dual "
				sv_u = urhk_dbSelectWithBind(sv_s)
				if(sv_u==0)then
					EQSRV.GLBDATA.msgSalAmt = BANCS.OUTPARAM.msgSalAmt
				else
					EQSRV.GLBDATA.msgSalAmt = "0.00"
				endif
				print(EQSRV.GLBDATA.msgSalAmt)	
				EQSRV.GLBDATA.msgSalAmt = ltrim(EQSRV.GLBDATA.msgSalAmt)
				print(EQSRV.GLBDATA.msgSalAmt)
#Before Activation
####Jipange Jiinue is setup to pay on day XX for XX months from account XXX! It will activate when your bonus transfers. "
####We’ll notify you of the salary amount at that time
if(cdouble(EQSRV.GLBDATA.msgSalAmt)<=0)then
EQSRV.GLBDATA.activationMsg = "Jipange Jiinue is setup to pay on day " +EQSRV.GLBDATA.msgPayoutDays+ " for " +EQSRV.GLBDATA.msgPayoutMnths+ " months "
EQSRV.GLBDATA.activationMsg = EQSRV.GLBDATA.activationMsg + "from account " +EQSRV.GLBDATA.jipangeAcct+ "! It will activate when your bonus transfers."
endif
#After Activation
####Jipange Jiinue is setup to pay on day XX for XX months from account XXX! Your new monthly salary is (remaining balance/duration).
if(cdouble(EQSRV.GLBDATA.msgSalAmt)>0)then
EQSRV.GLBDATA.activationMsg = "Jipange Jiinue is setup to pay on day " +EQSRV.GLBDATA.msgPayoutDays+ " for " +EQSRV.GLBDATA.msgPayoutMnths+ " months" 
EQSRV.GLBDATA.activationMsg = EQSRV.GLBDATA.activationMsg + " from account " +EQSRV.GLBDATA.jipangeAcct+ " ! Your new monthly salary is" 
EQSRV.GLBDATA.activationMsg = EQSRV.GLBDATA.activationMsg + " Ksh: " +EQSRV.GLBDATA.msgSalAmt+ " " 
endif
                        print(EQSRV.GLBDATA.activationMsg)

                                sv_d = " INSERT INTO custom.mobee_push_sms ( "
                                sv_d = sv_d + " ref_no,"
                                    sv_d = sv_d + "language,"
                                    sv_d = sv_d + "institution_code,"
                                    sv_d = sv_d + "mobile_number,"
                                    sv_d = sv_d + "message_arrieved_date,"
                                    sv_d = sv_d + "message_priority,"
                                    sv_d = sv_d + "message_status,"
                                    sv_d = sv_d + "message_validity_period,"
                                    sv_d = sv_d + "department,"
                                    sv_d = sv_d + "message_text,"
                                    sv_d = sv_d + "retry_count,"
                                    sv_d = sv_d + "bank_id"
                                    sv_d = sv_d + ") VALUES ("
                                    sv_d = sv_d + "'"+EQSRV.GLBDATA.refNum+"',"
                                    sv_d = sv_d + "'EN',"
                                    sv_d = sv_d + "'068',"
                                        print(EQSRV.GLBDATA.MobileNumber)
                                    sv_d = sv_d + "'"+EQSRV.GLBDATA.MobileNumber+"',"
                                    sv_d = sv_d + "'19-JUL-19',"
                                    sv_d = sv_d + "'4',"
                                    sv_d = sv_d + "'1',"
                                    sv_d = sv_d + "'86400000',"
                                    sv_d = sv_d + "'Finacle',"
                                    sv_d = sv_d + "'"+EQSRV.GLBDATA.activationMsg+"',"
                                    sv_d = sv_d + "'0',"
                                    sv_d = sv_d + "'"+BANCS.STDIN.contextBankId+"')"
                                print(sv_d)
                                ###sv_u = urhk_dbSqlWithBind(sv_d)
                                ###if(sv_u==0)then
                                ###      sv_u = urhk_dbSqlWithBind("commit")
				###	EQSRV.GLBDATA.srvYN = "Y"
				###	EQSRV.GLBDATA.valerr	= "Goal Account Modified Successfully"
                                ###        goto VAYU
                                ###else
                                ###      sv_u = urhk_dbSqlWithBind("rollback")
				###	EQSRV.GLBDATA.srvYN = "N"
				###	EQSRV.GLBDATA.valerr	= "Goal Account Modification Failed"
                                ###      goto VAYU
                                ###endif

		goto VAYU
	else
		EQSRV.GLBDATA.Onforacid	= ""
		callscriptifexist("ebsrvHandler.scr")
		EQSRV.GLBDATA.valerr	=	EQSRV.GLBDATA.SrvError	
		goto VAYU
	endif
VAYU:
	print(EQSRV.GLBDATA.activationMsg)
	print(EQSRV.GLBDATA.valerr)
	print(EQSRV.GLBDATA.Onforacid)
	exitscript
trace off
end-->
