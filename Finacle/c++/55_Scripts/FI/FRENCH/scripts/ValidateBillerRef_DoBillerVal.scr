<--start
trace on
	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.accountID + "|" + CUST.INTERFACE.refNum
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N" + "|" + CUST.INTERFACE.bankID
	sv_s = "name|SELECT NAME FROM CUSTOM.C_CIC WHERE ACCTNUM = ?SVAR AND "
	sv_s = sv_s + " REFNUM = ?SVAR AND DEL_FLG = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.INTERFACE.name = BANCS.OUTPARAM.name
	#}
	ELSE
	#{
		CUST.INTERFACE.successOrFailure = "F"
		CUST.INTERFACE.errorCode = "ERR025"
		GOTO ERROREXIT
	#}
	ENDIF
	
#trace off
end-->
