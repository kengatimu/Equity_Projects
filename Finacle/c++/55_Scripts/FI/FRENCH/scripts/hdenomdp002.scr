#----------------------------------------------------------------------------------------------------------
# Filename              :       hdenomdp002.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to fetch Data for all mode other than add.
# Input                 :       crncyCode
# Output                :       all details field values.
# Called Script         :       None
# Calling Script        :       hdenommn002.scr, hdenommn003.scr, hdenommn004.scr, hdenommn006.scr
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           06-05-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="59ff2374fafae3b7c5e99db3f7aa4a35960da698b05f4140aff82851645fd724"
	TRACE ON
	# In rak bank Code
	# They are allowing user to inquire both Deleted and Undeleted currency Denomination.
	
	# But in this code flow, we are only allow user to inquire Deleted currency Denomination.
	# Fetching in other mode are same as RAK bank Code.
	
	CUST.DENOM.coinDenomCounter = "01"
	CUST.DENOM.noteDenomCounter = "01"
	#------------------------------------------------------------------------------
	#  Fetching data from Db on basis of Function
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.DENOM.bankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncyCode
	#BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.solID
	IF (CUST.DENOM.funcCode == "U") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|Y"
		#}
	ELSE
		#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|N"
	#}
	ENDIF
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "denomInd,denomValue|"
	sv_s = sv_s + " SELECT DENOM_IND,DENOM_VALUE"
	sv_s = sv_s + " FROM CUSTOM.C_MDNM "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR "
	sv_s = sv_s + " AND CRNCY_CODE = ?SVAR"
	#sv_s = sv_s + " AND SOL_ID = ?SVAR"
	IF (CUST.DENOM.funcCode == "U") THEN
	#{
		sv_s = sv_s + " AND DEL_FLG = ?SVAR"
		#}
	ELSE
		#{
		sv_s = sv_s + " AND DEL_FLG = ?SVAR"
	#}
	ENDIF
	sv_s = sv_s + " ORDER BY DENOM_VALUE DESC"
	print(sv_s)
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	IF (sv_c != 0) THEN
	#{
		# throwing error
		IF (CUST.DENOM.funcCode == "I") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Inquire."
			CUST.INTERFACE.errorCode = "DENOM_ERR_012"
		#}
		ENDIF
		IF (CUST.DENOM.funcCode == "M") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Modify."
			CUST.INTERFACE.errorCode = "DENOM_ERR_013"
		#}
		ENDIF
		IF (CUST.DENOM.funcCode == "D") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Delete."
			CUST.INTERFACE.errorCode = "DENOM_ERR_014"
		#}
		ENDIF
		IF (CUST.DENOM.funcCode == "U") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Undelete."
			CUST.INTERFACE.errorCode = "DENOM_ERR_011"
		#}
		ENDIF
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "abc"
		CUST.DENOM.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.DENOM.cursorNumber= BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(CUST.DENOM.cursorNumber)
	# Fetch data in a loop and assign it to output
	sv_c = urhk_dbCursorFetch(CUST.DENOM.cursorNumber)
	print(sv_c)
	IF (sv_c != 0) THEN
	#{
		# throwing error
		IF (CUST.DENOM.funcCode == "I") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Inquire."
			CUST.INTERFACE.errorCode = "DENOM_ERR_012"
		#}
		ENDIF
		IF (CUST.DENOM.funcCode == "M") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Modify."
			CUST.INTERFACE.errorCode = "DENOM_ERR_013"
		#}
		ENDIF
		IF (CUST.DENOM.funcCode == "D") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Delete."
			CUST.INTERFACE.errorCode = "DENOM_ERR_014"
		#}
		ENDIF
		IF (CUST.DENOM.funcCode == "U") THEN
		#{
			#CUST.DENOM.errorMsg = "Nothing to Undelete."
			CUST.INTERFACE.errorCode = "DENOM_ERR_011"
		#}
		ENDIF
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "abc"
		CUST.DENOM.successFlg = "F"
		sv_c = urhk_dbCursorClose(CUST.DENOM.cursorNumber)
		print(sv_c)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	WHILE (sv_c == 0)
	#{
		print(CUST.DENOM.coinDenomCounter)
		print(CUST.DENOM.noteDenomCounter)
		# adding values to repository variables
		CUST.DENOM.denomInd = TRIM(BANCS.OUTPARAM.denomInd)
		print(CUST.DENOM.denomInd)
		CUST.DENOM.denomValue = TRIM(BANCS.OUTPARAM.denomValue)
		print(CUST.DENOM.denomValue)
		
		IF (CUST.DENOM.denomInd == "N") THEN
		#{
			# sending data to FE.   (NoteDenomination)
			IF (CUST.DENOM.denomValue == "") THEN
			#{
				sv_o = "noteDenom" + CUST.DENOM.noteDenomCounter +"| " + CUST.DENOM.denomValue
				#}
			ELSE
				#{
				sv_o = "noteDenom" + CUST.DENOM.noteDenomCounter +"|" + CUST.DENOM.denomValue
			#}
			ENDIF
			print(sv_o)
			sv_u =urhk_SetOrbOut(sv_o)
			CUST.DENOM.noteDenomCounter = CINT(CUST.DENOM.noteDenomCounter) + 1
			print(CUST.DENOM.noteDenomCounter)
			sv_l = STRLEN(CUST.DENOM.noteDenomCounter)
			IF (sv_l != 2) THEN
			#{
				CUST.DENOM.noteDenomCounter = "0" + CUST.DENOM.noteDenomCounter
			#}
			ENDIF
			print(CUST.DENOM.noteDenomCounter)
			#}
		ELSE
			#{
			# sending data to FE.   (CoinDenomination)
			IF (CUST.DENOM.denomValue == "") THEN
			#{
				sv_o = "coinDenom" + CUST.DENOM.coinDenomCounter +"| " + CUST.DENOM.denomValue
				#}
			ELSE
				#{
				sv_o = "coinDenom" + CUST.DENOM.coinDenomCounter +"|" + CUST.DENOM.denomValue
			#}
			ENDIF
			print(sv_o)
			sv_u =urhk_SetOrbOut(sv_o)
			CUST.DENOM.coinDenomCounter = CINT(CUST.DENOM.coinDenomCounter) + 1
			print(CUST.DENOM.coinDenomCounter)
			sv_l = STRLEN(CUST.DENOM.coinDenomCounter)
			IF (sv_l != 2) THEN
			#{
				CUST.DENOM.coinDenomCounter = "0" + CUST.DENOM.coinDenomCounter
			#}
			ENDIF
			print(CUST.DENOM.coinDenomCounter)
		#}
		ENDIF
		# Fetching next record
		sv_c = urhk_dbCursorFetch(CUST.DENOM.cursorNumber)
		print(sv_c)
	#}
	DO
	sv_c = urhk_dbCursorClose(CUST.DENOM.cursorNumber)
	print(sv_c)
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
