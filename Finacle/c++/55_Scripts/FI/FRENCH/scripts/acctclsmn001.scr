<--START
CHECKSUM="7092fcd0c25d6b3ace72df12552fac8441d9a8dd8b65b8a16b3ea67f6f381ef0"
	TRACE ON
	
	#-----------------------------------------------------------------------------------------------
	# Creating Repository
	#-----------------------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","ACCTCLS") == 0) THEN
	#{
		CREATECLASS("CUST","ACCTCLS", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM", 5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# Initializing the variables
	#-----------------------------------------------------------------------------------------------
	CUST.ACCTCLS.errMsg = ""
	CUST.ACCTCLS.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
	PRINT(CUST.ACCTCLS.bodDate)
	
	#-----------------------------------------------------------------------------------------------
	# Getting all the values FROM CPARAM
	#-----------------------------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "ACCT_CLS"
	BANCS.INPUT.parameterId = "AC_CL_SCHM_CODE"
	CALL ("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.schmCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.schmCode)
		#}
	ELSE
		#{
		CUST.ACCTCLS.errMsg = "CPARAM setup not done Schm Code"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting total number of closed accounts from GAM where the scheme code
	# is SB102 (super junior) and closed date is bod date.
	# if the count is 0 then exiting
	#--------------------------------------------------------------------------
	sv_s =        " count|"
	sv_s = sv_s + " SELECT COUNT(1)"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE GAM.sol_id =?SVAR"
	sv_s = sv_s + " AND GAM.acct_ownership='C'"
	sv_s = sv_s + " AND GAM.del_flg='N'"
	sv_s = sv_s + " AND GAM.acct_cls_flg='Y'"
	sv_s = sv_s + " AND GAM.schm_code=?SVAR"
	sv_s = sv_s + " AND GAM.acct_crncy_code=?SVAR"
	sv_s = sv_s + " AND GAM.acct_cls_date=to_date(?SVAR,'dd-mm-yyyy')"
	sv_s = sv_s + " AND GAM.bank_id=?SVAR"
	
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +CUST.CPARAM.schmCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +BANCS.STDIN.homeCrncyCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +CUST.ACCTCLS.bodDate + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		CUST.ACCTCLS.recCount = BANCS.OUTPARAM.count
		PRINT(CUST.ACCTCLS.recCount)
		#}
	ELSE
		#{
		CUST.ACCTCLS.errMsg = "Error in Finding Total no.of Closed Accounts."
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CINT(CUST.ACCTCLS.recCount) == 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting closed account numbers from GAM where schm_code is SB102
	#--------------------------------------------------------------------------
	sv_s =        " foracid|"
	sv_s = sv_s + " SELECT GAM.foracid"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE  GAM.sol_id =?SVAR"
	sv_s = sv_s + " AND GAM.acct_ownership='C'"
	sv_s = sv_s + " AND GAM.del_flg='N'"
	sv_s = sv_s + " AND GAM.acct_cls_flg='Y'"
	sv_s = sv_s + " AND GAM.schm_code=?SVAR"
	sv_s = sv_s + " AND GAM.acct_crncy_code=?SVAR"
	sv_s = sv_s + " AND GAM.acct_cls_date=to_date(?SVAR,'dd-mm-yyyy')"
	sv_s = sv_s + " AND GAM.bank_id=?SVAR"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.schmCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.homeCrncyCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.ACCTCLS.bodDate + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUST.ACCTCLS.mainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(CUST.ACCTCLS.mainCursor)
	
	WHILE (sv_c == 0)
	#{
		sv_c = urhk_dbCursorFetch(CUST.ACCTCLS.mainCursor)
		PRINT(sv_c)
		IF (sv_c != 0) THEN
		#{
			sv_c = urhk_dbCursorClose(CUST.ACCTCLS.mainCursor)
			PRINT(sv_c)
			sv_c = 1
			#}
		ELSE
			#{
			CUST.ACCTCLS.custForacid = BANCS.OUTPARAM.foracid
			PRINT(CUST.ACCTCLS.custForacid)
			
			sv_s =        " sjaCount|"
			sv_s = sv_s + " SELECT COUNT(1)"
			sv_s = sv_s + " FROM CUSTOM.C_SJA"
			sv_s = sv_s + " WHERE C_SJA.sol_id=?SVAR"
			sv_s = sv_s + " AND C_SJA.foracid=?SVAR"
			sv_s = sv_s + " AND C_SJA.del_flg='N'"
			sv_s = sv_s + " AND C_SJA.bank_id=?SVAR"
			
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId+ "|" +CUST.ACCTCLS.custForacid+ "|" +BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d == 0) THEN
			#{
				CUST.ACCTCLS.custRecCn = BANCS.OUTPARAM.sjaCount
				PRINT(CUST.ACCTCLS.custRecCn)
				IF (CINT(CUST.ACCTCLS.custRecCn) > 0) THEN
				#{
					sv_s =        " UPDATE CUSTOM.C_SJA"
					sv_s = sv_s + " SET C_SJA.del_flg='Y'"
					sv_s = sv_s + " WHERE C_SJA.foracid=?SVAR"
					sv_s = sv_s + " AND C_SJA.del_flg='N'"
					sv_s = sv_s + " AND C_SJA.bank_id=?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.ACCTCLS.custForacid+ "|" +BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_d)
					sv_d = urhk_dbSQLWithBind("COMMIT")
					PRINT(sv_d)
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_u = SYSTEM("echo 'Error in Finding Total no.of Closed Accounts in Custom Table' >>ACCTCLS.log")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
	#}
	DO
	
	ENDOFSCRIPT:
		IF (CUST.ACCTCLS.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.ACCTCLS.errMsg+"' >>ACCTCLS.log")
			PRINT(sv_u)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
