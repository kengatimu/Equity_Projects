#######################################################################
#       Script Name:    hacmupl.scr
#       To Upload Office accounts using SRV, when webmode and acmupl.scr scripts are not available
#######################################################################
<--start
trace on
print("BEGIN")
IF (REPEXISTS("EBI") == 0 ) THEN
#{
                CREATEREP("EBI")
#}
ENDIF

IF (CLASSEXISTS("EBI","GLBDATA") == 0) THEN
#{
                CREATECLASS("EBI","GLBDATA",5)
#}
ENDIF

sv_f = "foracid, schm_code, gl_sub_head_code, acct_name,short_name, "
sv_f = sv_f + " crncy_code, bacid, sys_only_acct_flg, "
sv_f = sv_f + " anw_non_cust_alwd_flg, inter_sol_access_flg, "
sv_f = sv_f + " partitioned_flg, partitioned_type,upload_status,sol_id|"
sv_f = sv_f + " select act_num,schm_code, gl_sub_head_code, acct_name,acct_short_name, "
sv_f = sv_f + " crncy_code, bacid, sys_only_acct_flg, "
sv_f = sv_f + " ANW_NON_CUST_ALWD_FLG, INTER_SOL_ACCESS_FLG, "
sv_f = sv_f + " PARTITIONED_FLG, PARTITIONED_TYPE ,UPLOAD_STATUS,sol_id "
sv_f = sv_f + " from tbaadm.acm_upl where "
sv_f = sv_f + " upload_status='0' "
print(sv_f)
sv_r = urhk_dbCursorOpenwithbind(sv_f)

IF (sv_r!=0) THEN
#{
                sv_r=urhk_TBAF_DispMesg("could not open cursor")
                exitscript
#}
ENDIF

sv_f = ""
sv_s = ""
sv_c = ""
sv_g = ""
sv_n = ""
sv_u = ""

sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
sv_r = urhk_dbCursorFetch(sv_m)

WHILE(sv_r == 0)
#{
                #EBI.GLBDATA.foracid = BANCS.OUTPARAM.foracid
                #print(EBI.GLBDATA.foracid)
                EBI.GLBDATA.sol_id = BANCS.OUTPARAM.sol_id
                print(EBI.GLBDATA.sol_id)
                EBI.GLBDATA.schm_code = BANCS.OUTPARAM.schm_code
                print(EBI.GLBDATA.schm_code)
		EBI.GLBDATA.gl_sub_head_code = BANCS.OUTPARAM.gl_sub_head_code
		print(EBI.GLBDATA.gl_sub_head_code)
                EBI.GLBDATA.acct_name = BANCS.OUTPARAM.acct_name
                print(EBI.GLBDATA.acct_name)
                EBI.GLBDATA.short_name = BANCS.OUTPARAM.short_name
                print(EBI.GLBDATA.short_name)
                EBI.GLBDATA.crncy_code = BANCS.OUTPARAM.crncy_code
                print(EBI.GLBDATA.crncy_code)
                EBI.GLBDATA.bacid = BANCS.OUTPARAM.bacid
                print(EBI.GLBDATA.bacid)
                EBI.GLBDATA.sys_only_acct_flg = BANCS.OUTPARAM.sys_only_acct_flg
                print(EBI.GLBDATA.sys_only_acct_flg)
                EBI.GLBDATA.anw_non_cust_alwd_flg = BANCS.OUTPARAM.anw_non_cust_alwd_flg
                print(EBI.GLBDATA.anw_non_cust_alwd_flg)
                EBI.GLBDATA.inter_sol_access_flg = BANCS.OUTPARAM.inter_sol_access_flg
                print(EBI.GLBDATA.inter_sol_access_flg)
                EBI.GLBDATA.partitioned_flg = BANCS.OUTPARAM.partitioned_flg
                print(EBI.GLBDATA.partitioned_flg)
                EBI.GLBDATA.partitioned_type = BANCS.OUTPARAM.partitioned_type
                print(EBI.GLBDATA.partitioned_type)

                sv_u = BANCS.OUTPARAM.upload_status
                print(sv_u)

                ################################################################
                # Invoke CCS Menu
                ################################################################
                sv_a = urhk_SetUrhkInp("sol.solId|"+EBI.GLBDATA.sol_id)
                sv_a = urhk_SetUrhkOut("sol.solId|ContextSol")
                sv_z = urhk_ExecSrv("SRV_ModifyContextSol|retain_all_output=Y")
                print(sv_z)

                #sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.foracid|"+EBI.GLBDATA.foracid)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.solId.solId|"+EBI.GLBDATA.sol_id)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.schmCode.schmCode|"+EBI.GLBDATA.schm_code)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.glSubHeadCode.glSubHeadCode|"+EBI.GLBDATA.gl_sub_head_code)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.acctCrncyCode.crncyCode|"+EBI.GLBDATA.crncy_code)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.acctName|"+EBI.GLBDATA.acct_name)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.acctShortName|"+EBI.GLBDATA.short_name)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.anywhereTranAllwd|"+EBI.GLBDATA.anw_non_cust_alwd_flg)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.interSolAccessFlg|"+EBI.GLBDATA.inter_sol_access_flg)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.partitionedFlg|"+EBI.GLBDATA.partitioned_flg)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.sysOnlyAcctFlg|"+EBI.GLBDATA.sys_only_acct_flg)
                sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.acctRptCode|1")
		sv_a = urhk_SetUrhkInp("officeAcctDtls.acctPlaceHolder.id|"+EBI.GLBDATA.bacid)

                IF ( EBI.GLBDATA.partitioned_flg == "Y") THEN
                #{
                                sv_a = urhk_SetUrhkInp("officeAcctDtls.partitionedType|"+EBI.GLBDATA.partitioned_type)
                #}
                ENDIF


                sv_z = urhk_ExecSrv("SRV_AddOfficeAcct|retain_all_output = Y")
                #sv_y = BANCS.OUTPARAM.succcessOrFailure
                #print(sv_y)

                IF (sv_z != "0") THEN
                #{
                                sv_d = 1
                                WHILE (sv_d <= sv_z)
                                #{
                                                sv_f = FORMAT$(sv_d,"%d")
                                                sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
                                                print(sv_e)
                                                EBI.GLBDATA.messageField = sv_e
                                                EBI.GLBDATA.messageField =  EBI.GLBDATA.messageField +"~ErrorCode - "+ sv_e
                                                print(EBI.GLBDATA.messageField)
                                                sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
                                                print(sv_e)
                                                EBI.GLBDATA.messageField =  EBI.GLBDATA.messageField +"~Error - "+ sv_e
                                                print(EBI.GLBDATA.messageField)
                                                sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
                                                print(sv_e)
                                                EBI.GLBDATA.messageField =  EBI.GLBDATA.messageField +"~Tag - "+ sv_e
                                                print(EBI.GLBDATA.messageField)
                                                sv_d = sv_d + 1
                                #}
                                DO
				sv_r = urhk_dbCursorFetch(sv_m)	
				GOTO CONT
                #}
                ENDIF

                sv_z = urhk_CopyOutToIn("")
                sv_y = BANCS.OUTPARAM.successOrFailure
                print(sv_y)

                ################################################################
                # Invoke CCS Menu
                ################################################################
                #sv_a = urhk_SetUrhkInp("sol.solId|"+EBI.GLBDATA.sol_id)
                #sv_a = urhk_SetUrhkOut("sol.solId|ContextSol")
                #sv_z = urhk_ExecSrv("SRV_ModifyContextSol|retain_all_output=Y")
                #print(sv_z)

                sv_z = urhk_ExecSrv("SRV_FetchOfficeAcctForVerify|same_user_verify = Y|retain_all_output = Y")
                sv_z = urhk_CopyOutToIn("")
                sv_y = BANCS.OUTPARAM.successOrFailure
                print(sv_y)

                sv_a = urhk_ExecSrv("SRV_VerifyOfficeAcct|same_user_verify = Y")
                print(sv_a)
                IF (sv_a == "0") THEN
                #{
                                sv_x = "update tbaadm.acm_upl set upload_status=1 where ACCT_NAME = '"+EBI.GLBDATA.acct_name+"' and BACID = '"+ EBI.GLBDATA.bacid+"' and  crncy_code ='"+EBI.GLBDATA.crncy_code+"' "
                                sv_y = urhk_dbSQLwithBind(sv_x)
                                sv_y = urhk_dbSQLwithBind("commit")
                                sv_r = urhk_dbCursorFetch(sv_m)
                #}
                ENDIF

		CONT:

#}
DO

sv_r = urhk_dbCursorClose(sv_m)
print("END")
TRACE OFF
end-->
