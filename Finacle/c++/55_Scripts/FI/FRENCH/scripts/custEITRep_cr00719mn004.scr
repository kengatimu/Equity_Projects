	sv_s = sv_s + "              nrml_accrued_amount_dr, nrml_booked_amount_cr, "
	sv_s = sv_s + "              nrml_booked_amount_dr, nrml_interest_amount_cr, "
	sv_s = sv_s + "              nrml_interest_amount_dr, penal_accrued_amount_dr, "
	sv_s = sv_s + "              penal_booked_amount_dr, penal_interest_amount_dr, "
	sv_s = sv_s + "              penal_adv_int_amount_dr, addnl_accrued_amount_dr, "
	sv_s = sv_s + "              addnl_booked_amount_dr, addnl_interest_amount_dr, "
	sv_s = sv_s + "              qis_accrued_amount_dr, qis_booked_amount_dr, "
	sv_s = sv_s + "              qis_interest_amount_dr, stock_accrued_amount_dr, "
	sv_s = sv_s + "              stock_booked_amount_dr, stock_interest_amount_dr, "
	sv_s = sv_s + "              ovdu_accrued_amount_dr, ovdu_booked_amount_dr, "
	sv_s = sv_s + "              ovdu_interest_amount_dr, lchg_user_id, lchg_time, rcre_user_id, "
	sv_s = sv_s + "              rcre_time, bank_id) "
	sv_s = sv_s + "    (SELECT entity_id, entity_type,to_date(?SVAR,'dd-mm-yyyy'), "
	sv_s = sv_s + "            accrued_upto_date_cr, accrued_upto_date_dr, last_book_cr_tan_date, "
	sv_s = sv_s + "            last_book_dr_tan_date, last_book_cr_tran_id, last_book_dr_tran_id, "
	sv_s = sv_s + "            last_int_cr_tran_id, last_int_dr_tran_id, last_int_cr_tran_date, "
	sv_s = sv_s + "            last_int_dr_tran_date, interest_rate, nrml_accrued_amount_cr, "
	sv_s = sv_s + "            nrml_accrued_amount_dr, nrml_booked_amount_cr, "
	sv_s = sv_s + "            nrml_booked_amount_dr, nrml_interest_amount_cr, "
	sv_s = sv_s + "            nrml_interest_amount_dr, penal_accrued_amount_dr, "
	sv_s = sv_s + "            penal_booked_amount_dr, penal_interest_amount_dr, "
	sv_s = sv_s + "            penal_adv_int_amount_dr, addnl_accrued_amount_dr, "
	sv_s = sv_s + "            addnl_booked_amount_dr, addnl_interest_amount_dr, "
	sv_s = sv_s + "            qis_accrued_amount_dr, qis_booked_amount_dr, "
	sv_s = sv_s + "            qis_interest_amount_dr, stock_accrued_amount_dr, "
	sv_s = sv_s + "            stock_booked_amount_dr, stock_interest_amount_dr, "
	sv_s = sv_s + "            ovdu_accrued_amount_dr, ovdu_booked_amount_dr, "
	sv_s = sv_s + "            ovdu_interest_amount_dr, lchg_user_id, lchg_time, rcre_user_id, "
	sv_s = sv_s + "            rcre_time, bank_id "
	sv_s = sv_s + "       FROM TBAADM.eit e"
	sv_s = sv_s + "      WHERE bank_id = ?SVAR AND NOT EXISTS ( Select 1 from custom.c_eit_backup c where c.entity_id = e.entity_id "
	sv_s = sv_s + "      AND c.bank_id =  bank_id AND c.EIT_DATE =to_date(?SVAR,'dd-mm-yyyy') )"
	sv_s = sv_s + "      AND EXISTS(Select 1 from tbaadm.gam g where e.entity_id=g.acid AND g.schm_type in('TDA','TUA') AND g.bank_id=e.bank_id AND g.sol_id=?SVAR))"
	
	PRINT(sv_s)
	sv_u = urhk_dbSqlWithBind(sv_s)
	PRINT(sv_u)
	BANCS.INPARAM.BINDVARS = ""
	sv_u = urhk_dbSqlWithBind("COMMIT")
	PRINT(sv_u)
	TRACE OFF
