#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName       : ebGtJipFundEntryTranMtt.scr  
#Desc           : 
#MenuId         : NA
#CalledScript   :
#Module         : GtGoals
#Date           : 25/07/2019
#Author         : Vino Palani
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#+++++++++++++
#Rep/Class
#+++++++++++++
	if(repexists("EQGTG")==0)then
		createrep("EQGTG")
	endif
	if(classexists("EQGTG","GLBDATA")==0)then
		createclass("EQGTG","GLBDATA",5)
	endif
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	EQGTG.GLBDATA.errMsg	= ""
#+++++++++++++
#DeriveInputs
#+++++++++++++
	if(fieldexists(EQGTG.GLBDATA.ModuleId)==1)then
			print(EQGTG.GLBDATA.ModuleId)
	endif
	if(fieldexists(EQGTG.GLBDATA.foracid)==1)then
                EQGTG.GLBDATA.drAcct         = EQGTG.GLBDATA.foracid
        else
                EQGTG.GLBDATA.drAcct         = ""
        endif
        if(fieldexists(EQGTG.GLBDATA.trans_crncy)==1)then
                EQGTG.GLBDATA.SrcAcctIdCrncy    = EQGTG.GLBDATA.trans_crncy
        else
                EQGTG.GLBDATA.SrcAcctIdCrncy    = ""
        endif
	if(EQGTG.GLBDATA.ModuleId =="GTJIP")then
		if(fieldexists(EQGTG.GLBDATA.trans_amt)==1)then
			EQGTG.GLBDATA.tranAmt          = EQGTG.GLBDATA.trans_amt
		else
			EQGTG.GLBDATA.tranAmt          = 0
		endif
	endif
        if(fieldexists(EQGTG.GLBDATA.jipAcct)==1)then
                EQGTG.GLBDATA.crAcct       = EQGTG.GLBDATA.jipAcct
        else
                EQGTG.GLBDATA.crAcct       = ""
        endif
	if(fieldexists(BANCS.INPUT.wkbthlmt)==1)then
		print(BANCS.INPUT.wkbthlmt)
	endif
	if(fieldexists(BANCS.INPUT.wkbdeppcnt)==1)then
		print(BANCS.INPUT.wkbdeppcnt)
	endif
	if(fieldexists(BANCS.INPUT.wksDepPcnt)==1)then
		print(BANCS.INPUT.wksDepPcnt)
	endif
	if((EQGTG.GLBDATA.ModuleId =="GTWKB") and (cdouble(BANCS.INPUT.wkbthlmt)>0) and (cdouble(BANCS.INPUT.wkbdeppcnt)>0))then
		if(fieldexists(EQGTG.GLBDATA.trans_amt)==1)then
			EQGTG.GLBDATA.tranAmt          = EQGTG.GLBDATA.trans_amt
			print(EQGTG.GLBDATA.tranAmt)
			EQGTG.GLBDATA.tranAmt	= cdouble(EQGTG.GLBDATA.tranAmt) - cdouble(BANCS.INPUT.wkbthlmt)
			print(EQGTG.GLBDATA.tranAmt)
			EQGTG.GLBDATA.tranAmt   = cdouble(EQGTG.GLBDATA.tranAmt)/100 * cdouble(BANCS.INPUT.wkbdeppcnt)
			print(EQGTG.GLBDATA.tranAmt)
		else
			EQGTG.GLBDATA.tranAmt	= 0
		endif
	endif
	if((EQGTG.GLBDATA.ModuleId =="GTWKS") and (cdouble(BANCS.INPUT.wksDepPcnt)>0))then
		if(fieldexists(EQGTG.GLBDATA.trans_amt)==1)then
			EQGTG.GLBDATA.tranAmt          = EQGTG.GLBDATA.trans_amt
			print(EQGTG.GLBDATA.tranAmt)
			EQGTG.GLBDATA.tranAmt   = cdouble(EQGTG.GLBDATA.tranAmt)/100 * cdouble(BANCS.INPUT.wksDepPcnt)
			print(EQGTG.GLBDATA.tranAmt)
		else
			EQGTG.GLBDATA.tranAmt	= 0
		endif
	endif
	if(EQGTG.GLBDATA.ModuleId =="GTJIP")then
		EQGTG.GLBDATA.jipangeFundYN = "N"
		sv_d = left$(BANCS.STDIN.BODDate,10)
                print(sv_d)
                sv_y = mid$(sv_d,8,10)
                print(sv_y)
                sv_m = mid$(sv_d,3,2)
                print(sv_m)
		if((cint(sv_m) == 3) or (cint(sv_m) ==4 ))then
			print("april KTDA Salary Tran Ok, for funding to jipange")
			EQGTG.GLBDATA.jipangeFundYN = "Y"
		endif
		if((cint(sv_m) == 9) or (cint(sv_m) ==10 ))then
			print("october KTDA Salary Tran Ok, for funding to jipange")
			EQGTG.GLBDATA.jipangeFundYN = "Y"
		endif
		if(fieldexists(EQGTG.GLBDATA.TranAmt) ==1)then 
			EQGTG.GLBDATA.tranAmt = cdouble(EQGTG.GLBDATA.TranAmt)
		endif
		if(fieldexists(EQGTG.GLBDATA.trans_amt) ==1)then 
			EQGTG.GLBDATA.tranAmt = cdouble(EQGTG.GLBDATA.trans_amt)
		endif
		if(fieldexists(EQGTG.GLBDATA.CrAcctNum)==1)then
			EQGTG.GLBDATA.drAcct         = EQGTG.GLBDATA.CrAcctNum
		endif
		if(fieldexists(EQGTG.GLBDATA.foracid)==1)then
			EQGTG.GLBDATA.drAcct         = EQGTG.GLBDATA.foracid
		endif
		if(fieldexists(EQGTG.GLBDATA.TranCurrency)==1)then
			EQGTG.GLBDATA.TranCurrency    = EQGTG.GLBDATA.TranCurrency
		else
			EQGTG.GLBDATA.TranCurrency    = ""
		endif
        endif
	if(fieldexists(EQGTG.GLBDATA.tranDate)==1)then
		print(EQGTG.GLBDATA.tranDate)
	endif
	if(fieldexists(EQGTG.GLBDATA.tranId)==1)then
		print(EQGTG.GLBDATA.tranId)
	endif
	sv_c = "pstdCnt | select count(*) from tbaadm.dtd where bank_id=?SVAR and tran_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR')  and pstd_flg='Y' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQGTG.GLBDATA.tranId + "|" + mid$(EQGTG.GLBDATA.tranDate,0,10) 
	sv_u = urhk_dbSelectWithBind(sv_c)
	if(sv_u==0)then
		EQGTG.GLBDATA.pstdCnt = BANCS.OUTPARAM.pstdCnt
	else
		EQGTG.GLBDATA.pstdCnt = 0
	endif
	if((cint(EQGTG.GLBDATA.pstdCnt) <=0 ) and (EQGTG.GLBDATA.jipangeFundYN =="N"))then
		print("source tran not posted,so funding tran")	
		exitscript
	endif
#++++++++++++
#transaction
#++++++++++++
	sv_a = urhk_MTTS_Close("")
	if(repexists("MTT")==0)then
		createrep("MTT")
	endif
	if(classexists("MTT","TranDetails")==0)then
		createclass("MTT","TranDetails",5)
	endif
	if(classexists("MTT","PartTranDetails")==0)then
		createclass("MTT","PartTranDetails",5)
	endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif

	BANCS.INPARAM.PostTranFlg	= "Y"
	BANCS.INPARAM.CommitFlg		= "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
	BANCS.INPARAM.ValidationFlag	= "Y"
	BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw	="Y"

	sv_a = urhk_MTTS_Initialize("")
	MTT.TranDetails.TranDate	= "0"
	MTT.TranDetails.TranType	= "T"
	MTT.TranDetails.TranSubType	= "BI"
	MTT.TranDetails.Remarks		= "GeorgeTown Goals Funding"
	MTT.TranDetails.IgnoreExcp	= "Y"
	MTT.TranDetails.PrintAdviceInd	= "B"
	MTT.TranDetails.TranIdOnline	= "N"
	sv_u = urhk_MTTS_defineTransaction("JipangeFund")
	if(sv_u != 0) then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
		endif
		goto ENDSCR
	endif
	sv_u = urhk_MTTS_populateInputDetails("")
	if(sv_u != 0) then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
		endif
		goto ENDSCR
	endif
#Debit
	print(EQGTG.GLBDATA.drAcct)
	MTT.PartTranDetails.Account	= EQGTG.GLBDATA.drAcct 
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = "Dr.For " + EQGTG.GLBDATA.crAcct + " /Fund to Goals " 
	MTT.PartTranDetails.RefAmount	= -1 * cdouble(EQGTG.GLBDATA.tranAmt) 
	if(EQGTG.GLBDATA.ModuleId=="GTJIP")then
		MTT.PartTranDetails.Remarks	= "Fund to Jipange Goals"
	endif
	if(EQGTG.GLBDATA.ModuleId=="GTWKB")then
		MTT.PartTranDetails.Remarks	= "Fund to Wekeeza Bakshishi Goals"
	endif
	if(EQGTG.GLBDATA.ModuleId=="GTWKS")then
		MTT.PartTranDetails.Remarks	= "Fund to Wekeeza Sasa Goals"
	endif
	MTT.PartTranDetails.RefNum	= EQGTG.GLBDATA.crAcct 
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = "JipangeFund"
	##MTT.PartTranDetails.ReportCode = sv_z
	sv_u = urhk_MTTS_definePartTran("SettleDr")
	print(sv_u)
	if(sv_u!=0)then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQGTG.GLBDATA.errMsg	= MTT.Error.Description 
			goto ENDSCR
		endif
	endif
#Credit
	print(EQGTG.GLBDATA.crAcct)
	MTT.PartTranDetails.Account 	= EQGTG.GLBDATA.crAcct 
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = "Cr.From " + EQGTG.GLBDATA.drAcct 
	MTT.PartTranDetails.RefAmount 	= EQGTG.GLBDATA.tranAmt 
	MTT.PartTranDetails.Remarks 	= "TopUp Inflow"
	MTT.PartTranDetails.RefNum 	= EQGTG.GLBDATA.drAcct 
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = "JipangeFund"
	##MTT.PartTranDetails.ReportCode = sv_z
	sv_u = urhk_MTTS_definePartTran("SettleDr")
	print(sv_u)
	if(sv_u!=0)then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQGTG.GLBDATA.errMsg	= MTT.Error.Description 
			goto ENDSCR
		endif
	endif
#Res
	sv_u = urhk_MTTS_endDefinition("")
	if(sv_u!=0)then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQGTG.GLBDATA.errMsg	= MTT.Error.Description 
			goto ENDSCR
		endif
	else
		print(BANCS.OUTPARAM.MTTTranId)
		print(EQGTG.GLBDATA.crAcct)
		EQGTG.GLBDATA.fundTranId = BANCS.OUTPARAM.MTTTranId
	endif
	sv_u = urhk_MTTS_Close("")
	print(sv_u)
ENDSCR:
	print(EQGTG.GLBDATA.errMsg)
	sv_a = urhk_MTTS_Close("")
	##if(classexists("EQGTG","GLBDATA")==1)then
	##	deleteclass("EQGTG","GLBDATA")
	##endif
	##if(repexists("EQGTG")==1)then
	##	deleterep("EQGTG")
	##endif
	exitscript
trace off
end-->
