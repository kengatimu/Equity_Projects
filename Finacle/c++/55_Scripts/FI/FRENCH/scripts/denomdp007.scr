<--START
CHECKSUM="dfdcb82f1537f32ecfd16b3c0b867c7374df77134868f0b86561d257ced40dcc"
	TRACE ON
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST","DENOM",5)
	#}
	ENDIF
	
	#-----------GETTING THE VALUES OF THE FIELDS FROM THE FRONT END : START --------------
	
	sv_r=urhk_B2k_PrintRepos("BANCS")
	print(sv_r)
	
	CUST.DENOM.EmpId	= BANCS.STDIN.EmployeeId
	CUST.DENOM.SolId	= BANCS.STDIN.mySolId
	CUST.DENOM.bank_id	= BANCS.STDIN.contextBankId
	CUST.DENOM.retVal       = BANCS.INPUT.RetVal
	CUST.DENOM.CashExchange = BANCS.INPUT.CashExchange
	CUST.DENOM.receivedamt  = BANCS.INPUT.receivedAmt
	CUST.DENOM.tranDate 	= LEFT$(BANCS.STDIN.BODDate, 10)
	CUST.DENOM.ERRORMESSAGE=""
	
	print(CUST.DENOM.EmpId)
	print(CUST.DENOM.SolId)
	print(CUST.DENOM.tranDate)
	print(CUST.DENOM.CashExchange)
	print(CUST.DENOM.retVal)
	print(CUST.DENOM.receivedamt)
	print(CUST.DENOM.bank_id)
	print(CUST.DENOM.ERRORMESSAGE)
	
	
	IF(FIELDEXISTS(BANCS.INPUT.bopRefValue)) THEN
	#{
		CUST.DENOM.bopRefValue = BANCS.INPUT.bopRefValue
		#}
	ELSE
		#{
		CUST.DENOM.bopRefValue = ""
	#}
	ENDIF
	
	print(CUST.DENOM.bopRefValue)
	
	IF(FIELDEXISTS(BANCS.INPUT.bopFlg)) THEN
	#{
		CUST.DENOM.bopFlg = BANCS.INPUT.bopFlg
		#}
	ELSE
		#{
		CUST.DENOM.bopFlg = ""
	#}
	ENDIF
	
	print(CUST.DENOM.bopFlg)
	
	#---------------------------------#
	
	IF(CUST.DENOM.CashExchange == "D")THEN
	#{
		CUST.DENOM.exchgamt = BANCS.INPUT.refAmt
		CUST.DENOM.exchgamt = BANCS.INPUT.acctCrncyAmt
		CUST.DENOM.Rate_Code = toupper(BANCS.INPUT.rateCode)
		CUST.DENOM.refAmt = BANCS.INPUT.refAmt
		CUST.DENOM.rate = BANCS.INPUT.rate
	#}
	ENDIF
	
	
	CUST.DENOM.CrncyCode1 = toupper(BANCS.INPUT.acctCrncy)
	print(CUST.DENOM.CrncyCode1)
	
	IF(CUST.DENOM.CashExchange == "D")THEN
	#{
		CUST.DENOM.CrncyCode2 = toupper(BANCS.INPUT.refCrncy)
	#}
	ENDIF
	
	CUST.DENOM.MTTErrMsg = ""
	CUST.DENOM.value = "NULL"
	
	#-----------GETTING THE VALUES OF THE FIELDS FROM THE FRONT END : END --------------
	
	#-------------------------------------------------------------------------------------
	# GETTING THE DETAILS FOR THE FIRST ACCOUNT
	#-------------------------------------------------------------------------------------
	IF(CUST.DENOM.CashExchange == "D")THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DENOM.EmpId +"|"+ CUST.DENOM.SolId +"|"+ CUST.DENOM.bank_id +"|"+ CUST.DENOM.CrncyCode1
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_q = "ph1|SELECT emp_cash_acct "
		sv_q = sv_q + "FROM gec "
		sv_q = sv_q + "WHERE emp_id = TRIM(?SVAR) "
		sv_q = sv_q + "AND sol_id = TRIM(?SVAR) "
		sv_q = sv_q + "AND bank_id = TRIM(?SVAR) "
		sv_q = sv_q + "AND crncy_code = TRIM(?SVAR) "
		sv_q = sv_q + " AND entity_cre_flg = 'Y' AND del_flg != 'Y' "
		print(sv_q)
		
		sv_r = urhk_dbselectWithBind(sv_q)
		print(sv_r)
		print(BANCS.OUTPUT.successOrFailure)
		
		IF(sv_r == 0) THEN
		#{
			CUST.DENOM.ph1 = BANCS.OUTPARAM.ph1
			print(CUST.DENOM.ph1)
			IF(CUST.DENOM.ph1 == "0") THEN
			#{
				CUST.DENOM.MTTErrMsg = "Account does not exist (OR) not authorised"
				print(CUST.DENOM.MTTErrMsg)
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.DENOM.value = "IVL"
			print("Placeholder does not exist for this combination of solid,currency code AND account")
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.flag = BANCS.OUTPUT.successOrFailure
			print(CUST.DENOM.flag)
			CUST.DENOM.ErrMsg = "Placeholder does not exist for this combination of solid,currency code AND account"
			sv_u = urhk_setOrbOut("Message|Failure")
			sv_u = urhk_setOrbOut("Details|"+CUST.DENOM.ErrMsg)
			print(sv_u)
			GOTO FINISH
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------
		# GETTING THE DETAILS FOR THE SECOND ACCOUNT
		#-------------------------------------------------------------------------------------
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.EmpId +"|"+ CUST.DENOM.SolId +"|"+ CUST.DENOM.bank_id +"|"+ CUST.DENOM.CrncyCode2
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_a = "ph2|SELECT emp_cash_acct "
		sv_a = sv_a + "FROM gec "
		sv_a = sv_a + "WHERE emp_id = TRIM(?SVAR) "
		sv_a = sv_a + "AND sol_id = TRIM(?SVAR) "
		sv_a = sv_a + "AND bank_id = TRIM(?SVAR) "
		sv_a = sv_a + "AND crncy_code = TRIM(?SVAR) "
		sv_a = sv_a + " AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG != 'Y' "
		print(sv_a)
		
		sv_b = urhk_dbselectWithBind(sv_a)
		print(sv_b)
		
		print(BANCS.OUTPUT.successOrFailure)
		
		IF(sv_b ==0) THEN
		#{
			CUST.DENOM.ph2 = BANCS.OUTPARAM.ph2
			print(CUST.DENOM.ph2)
			IF(CUST.DENOM.ph2 == "0") THEN
			#{
				CUST.DENOM.MTTErrMsg = "Account does not exist (OR) not authorised"
				print(CUST.DENOM.MTTErrMsg)
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.DENOM.value = "IVL"
			print("Placeholder does not exist for this combination of solid,currency code AND account")
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.flag = BANCS.OUTPUT.successOrFailure
			print(CUST.DENOM.flag)
			CUST.DENOM.ErrMsg = "Placeholder does not exist for this combination of solid,currency code AND account"
			sv_u = urhk_setOrbOut("Message|Failure")
			sv_u = urhk_setOrbOut("Details|"+CUST.DENOM.ErrMsg)
			print(sv_u)
			GOTO FINISH
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------
		# GETTING THE OFFICE ACCT PLACE HOLDER FOR THE FIRST ACCOUNT
		#-------------------------------------------------------------------------------------
		
		sv_w = TRIM(CUST.DENOM.ph1) + "|" + CUST.DENOM.CrncyCode1 + "|" + CUST.DENOM.SolId
		print(sv_w)
		
		sv_r = urhk_B2k_BacidToAcctId(sv_w)
		print(sv_r)
		
		IF(sv_r == "0") THEN
		#{
			CUST.DENOM.ph1 = BANCS.OUTPARAM.AcctId
			print(CUST.DENOM.ph1)
			#}
		ELSE
			#{
			CUST.DENOM.value = "IVL"
			print("Foracid does not exist for this combination of sol id,currency code AND Placeholder account")
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.flag = BANCS.OUTPUT.successOrFailure
			print(CUST.DENOM.flag)
			CUST.DENOM.ErrMsg = "Foracid does not exist for this combination of sol id,currency code AND placeholder account"
			sv_u = urhk_setOrbOut("Message|Failure")
			sv_u = urhk_setOrbOut("Details|"+CUST.DENOM.ErrMsg)
			print(sv_u)
			GOTO FINISH
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------
		# CHECK THE BALANCE OF THE FIRST ACCOUNT
		#-------------------------------------------------------------------------------------
		
		sv_t = urhk_getAcctDetailsInRepository(CUST.DENOM.ph1)
		print(sv_t)
		
		CUST.DENOM.acctBal    =	BANCS.OUTPARAM.clearBalance
		print(CUST.DENOM.acctBal)
		print(CDOUBLE(BANCS.OUTPARAM.AvailableAmt))
		print(CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt))
		CUST.DENOM.SolId  = BANCS.STDIN.mySolId
		print(CUST.DENOM.SolId)
		
		IF(CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt) <= CDOUBLE(CUST.DENOM.exchgamt)) THEN
		#{
			CUST.DENOM.MTTErrMsg = "Not enough balance.Cannot Proceed."
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------
		# GETTING THE OFFICE ACCT PLACE HOLDER FOR THE SECOND ACCOUNT
		#-------------------------------------------------------------------------------------
		
		sv_w = TRIM(CUST.DENOM.ph2) + "|" + CUST.DENOM.CrncyCode2 + "|" + CUST.DENOM.SolId
		print(sv_w)
		
		sv_r = urhk_B2k_BacidToAcctId(sv_w)
		print(sv_r)
		
		IF(sv_r == "0") THEN
		#{
			CUST.DENOM.ph2 = BANCS.OUTPARAM.AcctId
			print(CUST.DENOM.ph2)
			#}
		ELSE
			#{
			CUST.DENOM.value = "IVL"
			print("Foracid does not exist for this combination of solid,currency code AND Placeholder account")
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.flag = BANCS.OUTPUT.successOrFailure
			print(CUST.DENOM.flag)
			CUST.DENOM.ErrMsg = "Foracid does not exist for this combination of sol id,currency code AND placeholder account"
			sv_u = urhk_setOrbOut("Message|Failure")
			sv_u = urhk_setOrbOut("Details|"+CUST.DENOM.ErrMsg)
			print(sv_u)
			GOTO FINISH
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------
		# CHECK THE BALANCE OF THE SECOND ACCOUNT
		#-------------------------------------------------------------------------------------
		
		sv_t = urhk_getAcctDetailsInRepository(CUST.DENOM.ph2)
		print(sv_t)
		
		CUST.DENOM.acctBal    =	BANCS.OUTPARAM.clearBalance
		print(CUST.DENOM.acctBal)
		print(CDOUBLE(BANCS.OUTPARAM.AvailableAmt))
		print(CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt))
		CUST.DENOM.SolId  = BANCS.STDIN.mySolId
		print(CUST.DENOM.SolId)
		
		IF(CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt) <= CDOUBLE(CUST.DENOM.exchgamt)) THEN
		#{
			CUST.DENOM.MTTErrMsg = "Not enough balance.Cannot Proceed."
		#}
		ENDIF
	#}
	ENDIF
	#-----------------------------------------------------------------------------------------
	# CALLING THE MTT SCRIPT FOR EXECUTION
	#-----------------------------------------------------------------------------------------
	IF(CUST.DENOM.CashExchange == "D")THEN
	#{
		#---------------------------------------------------------------------------------
		#  CALLING denomdp008.scr FOR MAKING TRANSACTIONS USING MTT FOR HCASHDX
		#---------------------------------------------------------------------------------
		CALL("denomdp008.scr")
		IF(CUST.DENOM.tranId == "")THEN
		#{
			print(CUST.DENOM.MTTErrMsg)
			CUST.DENOM.SuccessOrFailure = "Failure"
			CUST.DENOM.Details = "Transaction failed - " + CUST.DENOM.MTTErrMsg
			sv_u = urhk_setOrbOut("Message|"+ CUST.DENOM.SuccessOrFailure)
			sv_u = urhk_setOrbOut("Details|"+ CUST.DENOM.Details)
			print(sv_u)
			GOTO FINISH
		#}
		ENDIF
		
		BANCS.INPUT.tranId = CUST.DENOM.tranId
		BANCS.INPUT.tranDate = CUST.DENOM.tranDate
		BANCS.INPUT.bopRefValue = CUST.DENOM.bopRefValue
		BANCS.INPUT.bopFlg = CUST.DENOM.bopFlg
		BANCS.INPUT.menuId = "HCASHDX"
		CALL("S_btextrndp003.scr")
		#}
	ELSE
		#{
		#----------------- SELECTING NEXT COUNT FOR HCASHX---------------------------
		CUST.DENOM.EVENT = "X"
		sv_l = "count|SELECT LPAD(CUSTOM.CUST_DENOM_CASHX_SEQ.nextval,6,0) FROM dual"
		print(sv_l)
		sv_v = urhk_dbselectWithBind(sv_l)
		print(sv_v)
		IF(sv_v != 0) THEN
		#{
			CUST.DENOM.tranId = "CX000001"
			#}
		ELSE
			#{
			print(BANCS.OUTPARAM.count)
			IF(BANCS.OUTPARAM.count == "")THEN
			#{
				CUST.DENOM.tranId = "CX000001"
				#}
			ELSE
				#{
				CUST.DENOM.tranId = "CX" + BANCS.OUTPARAM.count
				print(CUST.DENOM.tranId)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	print(CUST.DENOM.tranId)
	sv_t = CUST.DENOM.tranId
	print(sv_t)
	sv_h = CUST.DENOM.retVal
	print(sv_h)
	sv_z = 1
	sv_w = 1
	#---------------------------FORMING INPUT REQUIRED FOR denomdp016.scr & denomdp015.scr--------
	WHILE(sv_w != 0)
	#{
		sv_z = sv_z + 1
		print(sv_z)
		sv_w=getposition(sv_h,"|")
		print(sv_w)
		IF(sv_w == 0)THEN
		#{
			("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_z,"%d")) = sv_h
			#}
		ELSE
			#{
			sv_y = left$(sv_h,(sv_w-1))
			print(sv_y)
			("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_z,"%d")) = sv_y
			print(("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_z,"%d")))
		#}
		ENDIF
		sv_h = RIGHT$(sv_h,(STRLEN(sv_h)-sv_w))
		print(sv_h)
	#}
	DO
	#--------------------------PARSING FORMED INPUT  -----------------------------------------------
	CUST.DENOM.cucycnt = BANCS.INPUT.tmdet_FIELD_2
	print(CUST.DENOM.cucycnt)
	sv_c = 3
	sv_k = 1
	print(BANCS.INPUT.tmdet_FIELD_3)
	WHILE(sv_k <= (CUST.DENOM.cucycnt))
	#{
		sv_l = STRLEN(("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d")))
		print(sv_l)
		IF(sv_l > 1)THEN
		#{
			#--GETTING TELLER ID---------------------------------
			
			("CUST").("DENOM").("pType"+ FORMAT$(sv_k,"%d"))=LEFT$(("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d")),1)
			print(("CUST").("DENOM").("pType"+ FORMAT$(sv_k,"%d")))
			CUST.DENOM.Acctid = RIGHT$(("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d")),(STRLEN(("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d")))-2))
			
			
			sv_c = sv_c + 1
			print(CUST.DENOM.Acctid)
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.bank_id +"|"+ CUST.DENOM.Acctid	+"|"+ CUST.DENOM.bank_id +"|"+ CUST.DENOM.Acctid
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_l = "empId,solId | SELECT emp_id,sol_id  "
			sv_l = sv_l + "FROM gec "
			sv_l = sv_l + "WHERE bank_id = ?SVAR "
			sv_l = sv_l + "AND emp_cash_acct = (SELECT bacid FROM gam "
			sv_l = sv_l + "WHERE foracid = ?SVAR) "
			sv_l = sv_l + "AND sol_id = (SELECT sol_id FROM gam "
			sv_l = sv_l + "WHERE bank_id = ?SVAR "
			sv_l = sv_l + "AND foracid = ?SVAR) "
			sv_l = sv_l + " AND entity_cre_flg = 'Y' AND del_flg != 'Y' "
			sv_v = urhk_dbselectWithBind(sv_l)
			print(sv_v)
			
			IF(sv_v == 0)THEN
			#{
				CUST.DENOM.tellerId = BANCS.OUTPARAM.empId
				CUST.DENOM.solId=BANCS.OUTPARAM.solId
				#}
			ELSE
				#{
				CUST.DENOM.tellerId = BANCS.STDIN.EmployeeId
				print(CUST.DENOM.tellerId)
				CUST.DENOM.solId = BANCS.STDIN.mySolId
				print(CUST.DENOM.solId)
			#}
			ENDIF
			#}
		ELSE
			#{
			("CUST").("DENOM").("pType"+ FORMAT$(sv_k,"%d"))=("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d"))
			print(("CUST").("DENOM").("pType"+ FORMAT$(sv_k,"%d")))
			sv_c = sv_c + 1
			CUST.DENOM.tellerId = BANCS.STDIN.EmployeeId
			print(CUST.DENOM.tellerId)
			CUST.DENOM.solId = BANCS.STDIN.mySolId
			print(CUST.DENOM.solId)
		#}
		ENDIF
		("CUST").("DENOM").("currency"+ FORMAT$(sv_k,"%d"))=("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d"))
		print(("CUST").("DENOM").("currency"+ FORMAT$(sv_k,"%d")))
		sv_c = sv_c + 1
		("CUST").("DENOM").("coinDenomValue"+ FORMAT$(sv_k,"%d"))=("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d"))
		print(("CUST").("DENOM").("coinDenomValue"+ FORMAT$(sv_k,"%d")))
		sv_c = sv_c + 1
		("CUST").("DENOM").("noteDenomValue"+ FORMAT$(sv_k,"%d"))=("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d"))
		print(("CUST").("DENOM").("noteDenomValue"+ FORMAT$(sv_k,"%d")))
		sv_c = sv_c + 1
		("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d"))=("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d"))
		print(("CUST").("DENOM").("totDen"+ FORMAT$(sv_k,"%d")))
		sv_c = sv_c + 1
		("CUST").("DENOM").("totDenPB"+ FORMAT$(sv_k,"%d"))=("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d"))
		print(("CUST").("DENOM").("totDenPB"+ FORMAT$(sv_k,"%d")))
		sv_c = sv_c + 1
		("CUST").("DENOM").("totDenGB"+ FORMAT$(sv_k,"%d"))=("BANCS").("INPUT").("tmdet_FIELD_"+ FORMAT$(sv_c,"%d"))
		print(("CUST").("DENOM").("totDenGB"+ FORMAT$(sv_k,"%d")))
		sv_c = sv_c + 1
		sv_k = sv_k + 1
	#}
	DO
	PRINT(sv_c)
	sv_k = 1
	
	WHILE(sv_k <= (CUST.DENOM.cucycnt))
	#{
		CUST.DENOM.serialno = sv_k
		#---------------------------------------------------------------------------
		#  CALLING denomdp016.scr FOR C_DENM UPDATE AND C_DETD TABLE VALUE INSERTION
		#---------------------------------------------------------------------------
		call("denomdp016.scr")
		#------------------------------------------------------------
		# Below code added to validate for -ve denom value
		# - Sandeep Patil
		#------------------------------------------------------------
		IF(CUST.DENOM.ERRORMESSAGE !="") THEN
		#{
			sv_w = urhk_DBSqlWithBind("rollback")
			print(sv_w)
			GOTO ERRORMESSAGE
		#}
		ENDIF
		#-----------------------------------------------
		#  CALLING denomdp015.scr FOR C_DERD TABLE UPDATE
		#-----------------------------------------------
		call("denomdp015.scr")
		
		sv_k = sv_k + 1
		sv_q = 1
	#}
	DO
	sv_l = "commit"
	sv_s = urhk_DBSqlWithBind(sv_l)
	print(sv_s)
	IF(sv_s != 0)THEN
	#{
		sv_u = urhk_setOrbOut("Message|N")
		print(sv_u)
		sv_u = urhk_setOrbOut("Details|Fail to commit")
		print(sv_u)
		GOTO FINISH
	#}
	ENDIF
	IF(CUST.DENOM.CashExchange != "D")THEN
	#{
		sv_u = urhk_setOrbOut("Message|Success")
		print(sv_u)
		sv_u = urhk_setOrbOut("Details|"+CUST.DENOM.tranId)
		print(sv_u)
	#}
	ENDIF
	
	#call("S_hcashrepdp001.scr")
	
	#################     SETTING RESULT MESSAGE TO RESULT PAGE      ###########################
	
	#sv_s = "RESULT_MSG|" + "TRANSACTION CREATED SUCESSFULLY WITH TRANID :" + CUST.DENOM.tranId
	#sv_z = urhk_SetOrbOut(sv_s)
	#print(sv_z)
	#sv_u = urhk_setOrbOut("Message|Success")
	#print(sv_u)
	
	
	CUST.DENOM.resultPageMsg = "TRANSACTION CREATED SUCESSFULLY WITH TRANID :" + CUST.DENOM.tranId
	BANCS.OUTPUT.SuccessOrFailure = "S"
	sv_w = ""
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_u = urhk_SetOrbOut("RESULT_MSG|<font color=black>" + CUST.DENOM.resultPageMsg)
	
	
	
	DELETEREP("CUST")
	GOTO FINISH
	
	ERRORMESSAGE:
		sv_u = urhk_setOrbOut("Message|ERROR")
		print(sv_u)
		sv_u = urhk_setOrbOut("Details|"+CUST.DENOM.ERRORMESSAGE)
		print(sv_u)
		sv_r = urhk_dbSqlWithBind("rollback")
		print(sv_r)
	FINISH:
		TRACE OFF
		exitscript
		
END-->
