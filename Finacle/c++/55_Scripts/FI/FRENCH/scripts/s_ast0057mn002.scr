<--START
CHECKSUM="98dc32f6436f61aaba1ab9ec7033c50764149bdbdebcca0992b2c64844abc7c4"
	TRACE ON
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	#	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	CUST.LADISB.errMsg = ""
	GOTO ENDOFSCRIPT
	#------------------------------------------------------------------------------
	# Exitscript if function code is Reversal
	#------------------------------------------------------------------------------
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.reversalTranId")
	CUST.LADISB.reversalTran = BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.reversalTran)
	IF (CUST.LADISB.reversalTran != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------
	# Getting foracid from from frontend
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.loanForacid = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.loanForacid)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "Error: urhk_SRV_GetVal failed for foracid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#sv_r = urhk_MTTS_Close("")
	#print(sv_r)
	
	GOTO SKIPCOM
	sv_u = urhk_getFileLocation("COM|ast0057dp001.com")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		#----------------------------------------------------------------------------------
		#---    Setting Env variables
		#----------------------------------------------------------------------------------
		sv_a = "loanForacid|" + CUST.LADISB.loanForacid
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.LADISB.errMsg = "Error in setting env variable loanForacid"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------
		#---    Executing com file in background
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.scriptName = "ast0057dp001.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.LADISB.errMsg = "Upload process failed please retry"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "Unable to load com file"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	SKIPCOM:
		sv_e = "babx4061 $B2K_SESSION_ID ast0057mn002.scr '"
		sv_e = sv_e + CUST.LADISB.loanForacid + "' &"
		print(sv_e)
		sv_r = system(sv_e)
		print(sv_r)
		
		
		#call("ast0057mn002.scr")
		
	ENDOFSCRIPT:
		IF(CUST.LADISB.errMsg != "") THEN
		#{
			print(CUST.LADISB.errMsg)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
