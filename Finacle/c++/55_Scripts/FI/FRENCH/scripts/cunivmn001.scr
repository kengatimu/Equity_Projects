<--START
CHECKSUM="a4f4b68be250f517ada28f2b528d0b83d4274437b76bf965adf329264a6f8e5d"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "STABI") == 0) THEN
	#{
		CREATECLASS("CUST", "STABI", 5)
	#}
	ENDIF
	#***************************************************************************
	# If function code is 'A'
	#***************************************************************************
	PRINT(BANCS.INPUT.funcCode)
	
	CUST.STABI.funcCode = BANCS.INPUT.funcCode
	
	
	IF (CUST.STABI.funcCode == "A") THEN
	#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#****************************************************************************
	#If function code is 'B'
	#****************************************************************************
	IF (CUST.STABI.funcCode == "B") THEN
	#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#****************************************************************************
	#new porting code for funcode D
	#If function code is 'D'
	#****************************************************************************
	IF (CUST.STABI.funcCode == "D") THEN
	#{
		print(BANCS.STDIN.userWorkClass)
		IF ( BANCS.STDIN.userWorkClass <= "510" ) THEN
		#{
			sv_e = "Insufficient workclass to delete"
			sv_m = "funcCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			#}
		ELSE
			#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		#}
		ENDIF
	#}
	ENDIF
	
	#****************************************************************************
	#If function code is 'M'
	#****************************************************************************
	IF (CUST.STABI.funcCode == "M") THEN
	#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		TRACE OFF
		EXITSCRIPT
END-->
