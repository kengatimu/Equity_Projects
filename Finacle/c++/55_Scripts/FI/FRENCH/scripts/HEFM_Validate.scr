<--start
#trace on

#--------------------------------------------------------------------
# Setting the value for the Hidden field on Modify for disabling of fields
#--------------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "m") then
    sv_r = urhk_VAL_SetVal("h_func_code|Y")
endif

#-----------------------------------------------------
# Executing Validation Function for Fetch for Add Mode
#-----------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "S") then
    sv_a=urhk_ExecVal("validateEmpIDWithDel|empId=&emp_id|MANDATORY|IGNORE_ERROR")
    if (sv_a=="0") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_id|ERR_TYPE=B|ERR_CODE=004")
    endif
endif
#----------------------------------------------------------------
# Executing the validation function ValidateEmpId in Add Mode.
# "Record Already Exist" Error is thrown if emp_id already exists.
#----------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "A") then
    sv_a=urhk_ExecVal("validateEmpIDWithDel|empId=&emp_id|MANDATORY|IGNORE_ERROR")
    if (sv_a=="0") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_id|ERR_TYPE=B|ERR_CODE=004")
    endif

    sv_b=urhk_VAL_GetVal("emp_name")
    if(BANCS.OUTPARAM.fldValue=="") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_name|ERR_TYPE=S|ERR_CODE=E3238")
    endif

    sv_b=urhk_VAL_GetVal("emp_short_name")
    if(BANCS.OUTPARAM.fldValue=="") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_short_name|ERR_TYPE=S|ERR_CODE=E3238")
    endif

    sv_d=urhk_ExecVal("valSolId|solId=&sol_id|MANDATORY")

    sv_d=urhk_ExecVal("validateRefCode|refCode=&emp_desig|refRecType=20")

    sv_d=urhk_ExecVal("validateIntString|spNumber=&emp_sign_power_num")
	
	sv_g=urhk_VAL_GetVal("emp_sign_power_amt")
	sv_f=BANCS.OUTPARAM.fldValue
	if (sv_f!="") then
		sv_q=getposition (sv_f,"|")
		if(sv_q != 0) then
			sv_t=sv_q - 1
			sv_f=LEFT$(sv_f,sv_t)
		endif
		if (CDOUBLE(sv_f)!=0) then
			sv_d=urhk_ExecVal("validateAmountString|sp_Amount=&emp_sign_power_amt")
		endif
	endif

	sv_b=urhk_ExecVal("validateYesNoFlag|teller=&is_head_teller")

    sv_e=urhk_VAL_GetVal("emp_stat")
    if(BANCS.OUTPARAM.fldValue!="")then
        if((BANCS.OUTPARAM.fldValue!="01") AND (BANCS.OUTPARAM.fldValue!="02")) then
            sv_c=urhk_VAL_SetErr("FLD_NAME=emp_stat|ERR_TYPE=B|ERR_CODE=095")
        endif
    endif
endif

#----------------------------------------------------------------
# Executing the validation function ExecVal for COPY
#----------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "C") then

    sv_a=urhk_ExecVal("validateEmpIDWithDel|empId=&emp_id|MANDATORY|IGNORE_ERROR")
    if (sv_a=="1") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_id|ERR_TYPE=B|ERR_CODE=005")
    endif
    sv_b=urhk_VAL_GetVal("to_emp_id")
    if(BANCS.OUTPARAM.fldValue=="") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=to_emp_id|ERR_TYPE=S|ERR_CODE=E3238")
    endif

    sv_d=urhk_ExecVal("validateEmpIDWithDel|empId=&to_emp_id|MANDATORY|IGNORE_ERROR")
    if (sv_d=="0") then
        sv_e=urhk_VAL_SetErr("FLD_NAME=to_emp_id|ERR_TYPE=B|ERR_CODE=004")
    endif
    sv_e=urhk_VAL_GetVal("emp_stat")
    if(sv_e!="")then
        if((sv_e!="01") AND (sv_e!="02")) then
            sv_c=urhk_VAL_SetErr("FLD_NAME=emp_stat|ERR_TYPE=B|ERR_CODE=095")
        endif
    endif
endif
#--------------------------------------------------------------
# Executing the validation function ExecVal for MODIFY
#--------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "M") then

    sv_b=urhk_VAL_GetVal("emp_name")
    if(BANCS.OUTPARAM.fldValue=="") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_name|ERR_TYPE=S|ERR_CODE=E3238")
    endif

    sv_b=urhk_VAL_GetVal("emp_short_name")
    if(BANCS.OUTPARAM.fldValue=="") then
        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_short_name|ERR_TYPE=S|ERR_CODE=E3238")
    endif

    sv_b=urhk_ExecVal("valSolId|solId=&sol_id|MANDATORY")

    sv_b=urhk_ExecVal("validateRefCode|refCode=&emp_desig|refRecType=20")

    sv_b=urhk_ExecVal("validateIntString|spNumber=&emp_sign_power_num")
	
	sv_g=urhk_VAL_GetVal("emp_sign_power_amt")
	sv_f=BANCS.OUTPARAM.fldValue
	if (sv_f!="") then
		sv_q=getposition (sv_f,"|")
		if(sv_q != 0) then
			sv_t=sv_q - 1
			sv_f=LEFT$(sv_f,sv_t)
		endif
		if (CDOUBLE(sv_f)!=0) then
    		sv_b=urhk_ExecVal("validateAmountString|sp_Amount=&emp_sign_power_amt")
		endif
	endif

	sv_b=urhk_ExecVal("validateYesNoFlag|teller=&is_head_teller")
    sv_e=urhk_VAL_GetVal("emp_stat")
    if(sv_e!="")then
        if((sv_e!="01") AND (sv_e!="02")) then
		        sv_c=urhk_VAL_SetErr("FLD_NAME=emp_stat|ERR_TYPE=B|ERR_CODE=095")
        endif
    endif

endif

#--------------------------------------------------------------
# Executing the validation function ExecVal for INQUIRE
#--------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "I") then
    sv_a=urhk_ExecVal("validateEmpIDWithDel|empId=&emp_id|MANDATORY")
endif
#--------------------------------------------------------------
# Executing the validation function ExecVal for Fetch for UNDELETE,UNDELETE
#--------------------------------------------------------------
if ((BANCS.INPUT.VAL_CALL_MODE == "f") OR (BANCS.INPUT.VAL_CALL_MODE =="U")) then
    sv_a=urhk_ExecVal("validateEmpIDWithDel|empId=&emp_id|MANDATORY|IGNORE_ERROR")
    if(sv_a=="1") then
        sv_b=urhk_VAL_SetErr("FLD_NAME=empId|ERR_TYPE=B|ERR_CODE=006")
    endif
endif
#--------------------------------------------------------------
# Executing the validation function ExecVal for DELETE
#--------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "e") then
    sv_a=urhk_ExecVal("validateEmpId|empId=&emp_id|MANDATORY")
endif

if (BANCS.INPUT.VAL_CALL_MODE == "D") then

sv_a = urhk_VAL_GetVal("emp_id")
sv_x = BANCS.OUTPARAM.fldValue 
sv_a = "count | SELECT COUNT(USER_ID) FROM TBA_USER_PROFILE_TBL WHERE USER_EMP_ID = ?SVAR AND DEL_FLG != 'Y'"
BANCS.INPARAM.BINDVARS=sv_x 
sv_d = urhk_dbSelectWithBind(sv_a)

if (BANCS.OUTPARAM.count != 0) then 
# While reconciling the same to base line, please create one message code
# in MMSG table with this literal and replace the same with hard coded
# message
sv_b=urhk_SRV_SetErr("User Ids are attached to this Employee Id. This Employee Id cannot be deleted.")
endif


sv_a = urhk_VAL_GetVal("emp_id")
sv_x = BANCS.OUTPARAM.fldValue
        sv_q = "count|select count(1) from tbaadm.ddc where prnt_flg='P' and "
        sv_q = sv_q + "print_user_id in (select user_id from tbaadm.upr where"
        sv_q = sv_q + " user_emp_id =?SVAR and del_flg='N') and del_flg ='N' "

BANCS.INPARAM.BINDVARS=sv_x
sv_d = urhk_dbSelectWithBind(sv_q)

if (BANCS.OUTPARAM.count != 0) then
# While reconciling the same to base line, please create one message code
# in MMSG table with this literal and replace the same with hard coded
# message
sv_b=urhk_SRV_SetErr("Employee has initiated DD printing but not completed")
endif
endif

#---------------------------------------------------------------------
# Executing the Validation function to check for unposted transactions
#---------------------------------------------------------------------
if ((BANCS.INPUT.VAL_CALL_MODE == "M") OR (BANCS.INPUT.VAL_CALL_MODE =="V")) then
	sv_a=urhk_VAL_GetVal("emp_id")
	sv_c=BANCS.OUTPARAM.fldValue
	
	sv_b=urhk_VAL_GetVal("sol_id")
	sv_d=BANCS.OUTPARAM.fldValue
	
	if ((sv_c != "") AND (sv_d != "")) then
	    BANCS.INPARAM.empId = sv_c
		BANCS.INPARAM.solId = sv_d
		
		sv_e = urhk_checkUnpstdTransForEmp("")
		sv_f = BANCS.OUTPARAM.recordsExist
		if (sv_f == "Y") then
			sv_g = BANCS.OUTPARAM.fromSolId
			sv_b = urhk_SetUserWarning("ERR_TYPE=S|ERR_CODE=W0327|" + sv_g)
		endif
	endif
endif

#--------------------------------------------------------------------- 
   # Special Characters Check for Employee ID and To Employee ID 
   #--------------------------------------------------------------------- 
    
   if (BANCS.INPUT.VAL_CALL_MODE == "C") then 
       sv_q = urhk_VAL_GetVal("to_emp_id") 
   else 
       sv_q = urhk_VAL_GetVal("emp_id") 
   endif 
   sv_e=BANCS.OUTPARAM.fldValue 
   print(sv_e) 
    
   sv_x  = "<>\`%*?=+':;~!@#$^&|()" 
   sv_l = strlen(sv_e) 
   sv_z = 0 
   while(sv_z < sv_l) 
       sv_c = MID$(sv_e,sv_z,1) 
       sv_p =  getposition(sv_x,sv_c) 
       print(sv_c)
       print(sv_p)
       if(sv_p != 0) then 
           sv_b=urhk_SRV_SetErr("Special Characters are not allowed") 
           GOTO endofscript 
       endif 
       sv_q = getposition(sv_e,'"')
       print(sv_q)
       if(sv_q != 0) then
          sv_b=urhk_SRV_SetErr("Special Characters are not allowed")
           GOTO endofscript 
       endif 
       sv_z = sv_z + 1 
   do 
    
   endofscript: 


#trace off
end-->
