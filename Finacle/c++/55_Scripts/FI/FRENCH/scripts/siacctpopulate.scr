<--START
	TRACE ON

#----------------------------------------------------
# Creating Repository
#----------------------------------------------------
	sv_r = REPEXISTS("SAL")

	IF (sv_r == 0) THEN
	#{
		CREATEREP("SAL")
	#}
	ENDIF

	sv_r = CLASSEXISTS("SAL", "VAR")

	IF (sv_r == 0) THEN
	#{
		CREATECLASS("SAL", "VAR", 5)
	#}
	ENDIF
		
	SAL.VAR.crncy = ""
	SAL.VAR.crncy = BANCS.INPUT.currency
	SAL.VAR.bacid = ""
		
		
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="SIBACID" 
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		SAL.VAR.bacid = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		sv_z = urhk_SetOrbOut("errMsg|Bacid setup has not done in CPARAM")
		print(sv_z)
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_s = "forAcid|SELECT"
	sv_s = sv_s + " foracid"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE acct_crncy_code = ?SVAR"
	sv_s = sv_s + "	AND sol_id= ?SVAR"
	sv_s = sv_s + " AND bacid = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR"
	sv_s = sv_s + " AND entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND del_flg = 'N'"

	BANCS.INPARAM.BINDVARS = SAL.VAR.crncy + "|" + BANCS.STDIN.mySolId + "|" + SAL.VAR.bacid + "|" +  BANCS.STDIN.contextBankId

	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)

	IF (sv_d != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	SAL.VAR.forAcid = BANCS.OUTPARAM.forAcid
	print(SAL.VAR.forAcid)
	sv_z = urhk_SetOrbOut("forAcid|"+SAL.VAR.forAcid)
	print(sv_z)
	 
ENDOFSCRIPT:
EXITSCRIPT
TRACE OFF
