	BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + CUST.DATA.startDate + "|" + CUST.DATA.endDate + "|" + BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId
	PRINT (BANCS.INPARAM.BINDVARS)
	sv_s ="insert into custom.date_from values (?SVAR,to_date(?SVAR,'dd-mm-yyyy'),to_date(?SVAR,'dd-mm-yyyy'),?SVAR,?SVAR)"
