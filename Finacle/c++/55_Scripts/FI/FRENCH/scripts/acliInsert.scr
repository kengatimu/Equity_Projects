	BANCS.INPARAM.BINDVARS=BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId
	sv_s = ""
	sv_s = sv_s + "DELETE FROM custom.DATE_FROM where USER_ID=?SVAR AND BANK_ID=?SVAR"
	PRINT(sv_s)
	sv_d = urhk_dbSQLWithBind(sv_s)
