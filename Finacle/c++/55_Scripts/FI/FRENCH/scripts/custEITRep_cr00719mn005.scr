<--START
CHECKSUM="40b0eea749a631e2fd90d1cc8c7a3d8eadc1557da5b3bda32967b3fce6d48723"
	TRACE ON
	#LIBNAME ABGMASTER
	LIBNAME CUSTOMSO
	#-------------------------------------------------------------------------------
	# Creating Repository and Class
	#-------------------------------------------------------------------------------
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r ==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	sv_s = " BODDate|select to_char(dc_cls_date,'dd-mm-yyyy') from tbaadm.gct  "
	sv_s = sv_s + " WHERE bank_id = ?SVAR "
	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	
	CUST.DATA.BODDate = BANCS.OUTPARAM.BODDate
	
	#----------------------
	#Initializing variables
	#----------------------
	CUST.DATA.tranId	=""
	CUST.DATA.tranDate	=""
	CUST.DATA.glAcctNo	=""
	CUST.DATA.tranAmt	=""
	CUST.DATA.tranCrncy	=""
	CUST.DATA.partTranType	=""
	CUST.DATA.custAcct	=""
	CUST.DATA.bankId	=BANCS.STDIN.contextBankId
	CUST.DATA.custAcid	=""
	CUST.DATA.schmCode	=""
	CUST.DATA.schmType	=""
	CUST.DATA.unclrbalamt	=""
	CUST.DATA.futbalamt	=""
	CUST.DATA.lienAmt	=""
	CUST.DATA.glSubCode	=""
	CUST.DATA.acctCrncy	=""
	CUST.DATA.solId		=""
	CUST.DATA.eodBal	=""
	CUST.DATA.freeCode7	=""
	CUST.DATA.segment	=""
	CUST.DATA.subSegment	=""
	CUST.DATA.partTranSrlNum=""
	CUST.DATA.tranPart	=""
	CUST.DATA.tranPart2	=""
	CUST.DATA.tranRmks	=""
	CUST.DATA.bkdappl_flg	=""
	#----------
	#To get PID
	#----------
	sv_r = urhk_B2k_pid("")
	IF (sv_r == 0) THEN
	#{
		CUST.DATA.pid = BANCS.OUTPARAM.PID
		PRINT(CUST.DATA.pid)
		#}
	ELSE
		#{
		CUST.DATA.pid=""
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS=CUST.DATA.BODDate+"|"+CUST.DATA.bankId
	sv_s="tranDate,glAcctNo,tranId,tranAmt,tranCrncy,partTranType,custAcct,intBookAppFlg|SELECT to_char(tran_date,'dd-mm-yyyy'),gl_acct_no,tran_id,tran_amt,tran_crncy,part_tran_type,customer_account_no,int_book_app_flg "
	sv_s=sv_s+" FROM custom.c_int_backup"
	sv_s=sv_s+" WHERE tran_date=to_date(?SVAR,'dd-mm-yyyy')"
	sv_s=sv_s+" AND bank_id=?SVAR"
	sv_u = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_u)
	IF(sv_u == 0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_m)
		sv_n = urhk_dbCursorFetch(sv_m)
		PRINT(sv_n)
		WHILE(sv_n == 0)
		#{
			CUST.DATA.tranId		=BANCS.OUTPARAM.tranId
			CUST.DATA.tranDate		=BANCS.OUTPARAM.tranDate
			CUST.DATA.glAcctNo		=BANCS.OUTPARAM.glAcctNo
			CUST.DATA.tranAmt		=CDOUBLE(BANCS.OUTPARAM.tranAmt)
			CUST.DATA.tranCrncy		=BANCS.OUTPARAM.tranCrncy
			CUST.DATA.partTranType		=BANCS.OUTPARAM.partTranType
			CUST.DATA.custAcct		=BANCS.OUTPARAM.custAcct
			CUST.DATA.intBookAppFlg		=BANCS.OUTPARAM.intBookAppFlg
			CUST.DATA.custAcid		=""
			CUST.DATA.schmCode		=""
			CUST.DATA.schmType		=""
			CUST.DATA.unclrbalamt		=""
			CUST.DATA.futbalamt		=""
			CUST.DATA.lienAmt		=""
			CUST.DATA.glSubCode		=""
			CUST.DATA.acctCrncy		=""
			CUST.DATA.solId			=""
			CUST.DATA.eodBal		=""
			CUST.DATA.freeCode7		=""
			CUST.DATA.segment		=""
			CUST.DATA.subSegment		=""
			CUST.DATA.partTranSrlNum	=""
			CUST.DATA.tranPart		=""
			CUST.DATA.tranPart2		=""
			CUST.DATA.tranRmks		=""
			CUST.DATA.accrUptoDateCr	=""
			CUST.DATA.accrUptoDateDr	=""
			CUST.DATA.accrUptoAmtCr		=""
			CUST.DATA.accrUptoAmrDr		=""
			CUST.DATA.bkdUptoDateCr		=""
			CUST.DATA.bkdUptoDateDr		=""
			CUST.DATA.bkdUptoAmtCr		=""
			CUST.DATA.bkdUptoAmtDr		=""
			CUST.DATA.appUptoDateCr		=""
			CUST.DATA.appUptoDateDr		=""
			CUST.DATA.appUptoAmtCr		=""
			CUST.DATA.appUptoAmtDr		=""
			CUST.DATA.glBacid		=""
			CUST.DATA.crdrflg		="N"
			CUST.DATA.accrUptoDate		=""
			CUST.DATA.accrUptoAmt		=""
			CUST.DATA.bkdUptoDate		=""
			CUST.DATA.bkdUptoAmt		=""
			CUST.DATA.appUptoDate		=""
			CUST.DATA.appUptoAmt		=""
			CUST.DATA.accrAmtToday		=""
			CUST.DATA.bkdAmtToday		=""
			CUST.DATA.appAmtToday		=""
			CUST.DATA.glAcid		=""
			
			
			#------------------------------------------
			#Fetching customer account details from GAM
			#------------------------------------------
			sv_s="custAcid,schmCode,schmType,unclrbalamt,futbalamt,lienAmt,glSubCode,acctCrncy,solId,intpdFlg,intcollFlg"
			sv_s=sv_s+"|SELECT acid,schm_code,schm_type,(un_clr_bal_amt + future_un_clr_bal_amt),future_bal_amt,lien_amt,gl_sub_head_code,"
			sv_s=sv_s+"acct_crncy_code,sol_id,int_coll_flg,int_paid_flg FROM tbaadm.gam"
			sv_s=sv_s+" WHERE foracid=?SVAR"
			sv_s=sv_s+" AND bank_id=?SVAR"
			sv_s=sv_s+" AND entity_cre_flg = 'Y'"
			sv_s=sv_s+" AND del_flg != 'Y'"
			
			BANCS.INPARAM.BINDVARS=CUST.DATA.custAcct+"|"+CUST.DATA.bankId
			sv_d=urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d != 0) THEN
			#{
				GOTO NEXTRECORD
				#}
			ELSE
				#{
				CUST.DATA.custAcid	=BANCS.OUTPARAM.custAcid
				CUST.DATA.schmCode	=BANCS.OUTPARAM.schmCode
				CUST.DATA.schmType	=BANCS.OUTPARAM.schmType
				CUST.DATA.unclrbalamt	=CDOUBLE(BANCS.OUTPARAM.unclrbalamt)
				CUST.DATA.futbalamt	=CDOUBLE(BANCS.OUTPARAM.futbalamt)
				CUST.DATA.lienAmt	=CDOUBLE(BANCS.OUTPARAM.lienAmt)
				CUST.DATA.glSubCode	=BANCS.OUTPARAM.glSubCode
				CUST.DATA.acctCrncy	=BANCS.OUTPARAM.acctCrncy
				CUST.DATA.solId		=BANCS.OUTPARAM.solId
				CUST.DATA.intpdFlg	=BANCS.OUTPARAM.intpdFlg
				CUST.DATA.intcollFlg	=BANCS.OUTPARAM.intcollFlg
			#}
			ENDIF
			
			IF(CUST.DATA.intpdFlg=="Y") THEN
			#{
				CUST.DATA.crdrflg="C"
			#}
			ENDIF
			
			IF(CUST.DATA.intcollFlg=="Y") THEN
			#{
				CUST.DATA.crdrflg="D"
			#}
			ENDIF
			#-----------------------------
			#Fetching EOD balance from EAB
			#-----------------------------
			BANCS.INPARAM.BINDVARS=CUST.DATA.custAcid+"|"+CUST.DATA.BODDate+"|"+CUST.DATA.bankId
			sv_s="eodBal|SELECT tran_date_bal"
			sv_s=sv_s+" FROM tbaadm.eab"
			sv_s=sv_s+" WHERE acid=?SVAR"
			sv_s=sv_s+" AND eod_date=to_date(?SVAR,'dd-mm-yyyy')"
			sv_s=sv_s+" AND bank_id=?SVAR"
			sv_d=urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0) THEN
			#{
				CUST.DATA.eodBal=CDOUBLE(BANCS.OUTPARAM.eodBal)
			#}
			ENDIF
			
			#---------------------------------------------------
			#Fetching free_code_7 from GAC for the customer acid
			#---------------------------------------------------
			BANCS.INPARAM.BINDVARS=CUST.DATA.custAcid+"|"+CUST.DATA.bankId
			sv_s="freeCode7|SELECT free_code_7"
			sv_s=sv_s+" FROM tbaadm.gac"
			sv_s=sv_s+" WHERE acid=?SVAR"
			sv_s=sv_s+" AND bank_id=?SVAR"
			sv_d=urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0) THEN
			#{
				CUST.DATA.freeCode7=BANCS.OUTPARAM.freeCode7
			#}
			ENDIF
			
			#------------------------------------------------------------
			#Fetching SEGMENT details from ACCOUNTS for the customer acid
			#------------------------------------------------------------
			BANCS.INPARAM.BINDVARS=CUST.DATA.custAcid+"|"+CUST.DATA.bankId+"|"+"Y|Y"
			sv_s="segment,subSegment|SELECT segmentation_class, subsegment"
			sv_s=sv_s+" FROM crmuser.accounts acc, tbaadm.gam"
			sv_s=sv_s+" WHERE gam.acid =?SVAR"
			sv_s=sv_s+" AND gam.bank_id =?SVAR"
			sv_s=sv_s+" AND gam.entity_cre_flg =?SVAR"
			sv_s=sv_s+" AND gam.del_flg !=?SVAR"
			sv_s=sv_s+" AND acc.orgkey = gam.cif_id"
			sv_d=urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0) THEN
			#{
				CUST.DATA.segment=BANCS.OUTPARAM.segment
				CUST.DATA.subSegment=BANCS.OUTPARAM.subSegment
			#}
			ENDIF
			
			#--------------------------
			#Fetching GL Bacid from GAM
			#--------------------------
			BANCS.INPARAM.BINDVARS=CUST.DATA.glAcctNo+"|"+CUST.DATA.bankId
			sv_s="glBacid,glAcid|SELECT bacid,acid from tbaadm.gam"
			sv_s=sv_s+" WHERE foracid=?SVAR"
			sv_s=sv_s+" AND bank_id=?SVAR"
			sv_s=sv_s+" AND entity_cre_flg = 'Y'"
			sv_s=sv_s+" AND del_flg != 'Y'"
			sv_d=urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0) THEN
			#{
				CUST.DATA.glBacid=BANCS.OUTPARAM.glBacid
				CUST.DATA.glAcid=BANCS.OUTPARAM.glAcid
			#}
			ENDIF
			#-------------------------------------------
			#Fetching transaction details from DCTD_ACLI
			#-------------------------------------------
			IF(CUST.DATA.tranId!="") THEN
			#{
				BANCS.INPARAM.BINDVARS=CUST.DATA.tranDate+"|"+CUST.DATA.tranId+"|"+CUST.DATA.partTranType
				BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.glAcid+"|"+CUST.DATA.bankId+"|"+CUST.DATA.tranAmt
				sv_s="partTranSrlNum,tranPart,tranPart2,tranRmks|SELECT part_tran_srl_num, tran_particular,"
				sv_s=sv_s+"tran_particular_2, tran_rmks"
				sv_s=sv_s+" FROM tbaadm.dctd_acli"
				sv_s=sv_s+" WHERE tran_date=to_date(?SVAR,'dd-mm-yyyy')"
				sv_s=sv_s+" AND tran_id=LPAD(?SVAR,9)"
				sv_s=sv_s+" AND part_tran_type=?SVAR"
				sv_s=sv_s+" AND acid=?SVAR"
				sv_s=sv_s+" AND pstd_flg = 'Y'"
				sv_s=sv_s+" AND del_flg!='Y'"
				sv_s=sv_s+" AND bank_id=?SVAR"
				sv_s=sv_s+" AND tran_amt=?NVAR"
				sv_s=sv_s+" AND ROWNUM<2"
				sv_d=urhk_dbSelectWithBind(sv_s)
				IF(sv_d==0) THEN
				#{
					CUST.DATA.partTranSrlNum=BANCS.OUTPARAM.partTranSrlNum
					CUST.DATA.tranPart=BANCS.OUTPARAM.tranPart
					CUST.DATA.tranPart2=BANCS.OUTPARAM.tranPart2
					CUST.DATA.tranRmks=BANCS.OUTPARAM.tranRmks
					
				#}
				ENDIF
			#}
			ENDIF
			CUST.DATA.uniqueId=CUST.DATA.pid+CUST.DATA.solId+MID$(CUST.DATA.BODDate,0,2)+MID$(CUST.DATA.BODDate,3,2)+MID$(CUST.DATA.BODDate,6,4)
			PRINT(CUST.DATA.uniqueId)
			
			#-------------------------
			#Fetching details from EIT
			#-------------------------
			BANCS.INPARAM.BINDVARS=CUST.DATA.custAcid+"|"+CUST.DATA.bankId
			sv_s="accrUptoDateCr,accrUptoDateDr,accrUptoAmtCr,accrUptoAmrDr,bkdUptoDateCr,bkdUptoDateDr,"
			sv_s=sv_s+"bkdUptoAmtCr,bkdUptoAmtDr,appUptoDateCr,appUptoDateDr,appUptoAmtCr,appUptoAmtDr,rcreUserId,rcreTime,lchgUserId,lchgTime,intRate|"
			sv_s=sv_s+"SELECT to_char(ACCRUED_UPTO_DATE_CR,'dd-mm-yyyy'),to_char(ACCRUED_UPTO_DATE_DR,'dd-mm-yyyy'),NRML_ACCRUED_AMOUNT_CR,NRML_ACCRUED_AMOUNT_DR,"
			sv_s=sv_s+" to_char(BOOKED_UPTO_DATE_CR,'dd-mm-yyyy'),to_char(BOOKED_UPTO_DATE_DR,'dd-mm-yyyy'),NRML_BOOKED_AMOUNT_CR,NRML_BOOKED_AMOUNT_DR,"
			sv_s=sv_s+" to_char(LAST_INT_CR_TRAN_DATE,'dd-mm-yyyy'),to_char(LAST_INT_DR_TRAN_DATE,'dd-mm-yyyy'),NRML_INTEREST_AMOUNT_CR,NRML_INTEREST_AMOUNT_DR,"
			sv_s=sv_s+" rcre_user_id,to_char(rcre_time,'ddmmyyyyhh24miss'),lchg_user_id,to_char(lchg_time,'ddmmyyyyhh24miss'),interest_rate"
			sv_s=sv_s+" FROM tbaadm.eit"
			sv_s=sv_s+" WHERE entity_id=?SVAR"
			sv_s=sv_s+" AND bank_id=?SVAR"
			sv_d=urhk_dbSelectWithBind(sv_s)
			
			IF(sv_d==0) THEN
			#{
				CUST.DATA.accrUptoDateCr	=BANCS.OUTPARAM.accrUptoDateCr
				CUST.DATA.accrUptoDateDr	=BANCS.OUTPARAM.accrUptoDateDr
				CUST.DATA.accrUptoAmtCr		=CDOUBLE(BANCS.OUTPARAM.accrUptoAmtCr)
				CUST.DATA.accrUptoAmtDr		=CDOUBLE(BANCS.OUTPARAM.accrUptoAmrDr)
				CUST.DATA.bkdUptoDateCr		=BANCS.OUTPARAM.bkdUptoDateCr
				CUST.DATA.bkdUptoDateDr		=BANCS.OUTPARAM.bkdUptoDateDr
				CUST.DATA.bkdUptoAmtCr		=CDOUBLE(BANCS.OUTPARAM.bkdUptoAmtCr)
				CUST.DATA.bkdUptoAmtDr		=CDOUBLE(BANCS.OUTPARAM.bkdUptoAmtDr)
				CUST.DATA.appUptoDateCr		=BANCS.OUTPARAM.appUptoDateCr
				CUST.DATA.appUptoDateDr		=BANCS.OUTPARAM.appUptoDateDr
				CUST.DATA.appUptoAmtCr		=CDOUBLE(BANCS.OUTPARAM.appUptoAmtCr)
				CUST.DATA.appUptoAmtDr		=CDOUBLE(BANCS.OUTPARAM.appUptoAmtDr)
				CUST.DATA.rcreUserId		=BANCS.OUTPARAM.rcreUserId
				CUST.DATA.rcreTime		=BANCS.OUTPARAM.rcreTime
				CUST.DATA.lchgUserId		=BANCS.OUTPARAM.lchgUserId
				CUST.DATA.lchgTime		=BANCS.OUTPARAM.lchgTime
				CUST.DATA.intRate		=BANCS.OUTPARAM.intRate
				
			#}
			ENDIF
			
			IF(CUST.DATA.crdrflg=="C") THEN
			#{
				CUST.DATA.accrUptoDate		=CUST.DATA.accrUptoDateCr
				CUST.DATA.accrUptoAmt		=CUST.DATA.accrUptoAmtCr
				CUST.DATA.bkdUptoDate		=CUST.DATA.bkdUptoDateCr
				CUST.DATA.bkdUptoAmt		=CUST.DATA.bkdUptoAmtCr
				CUST.DATA.appUptoDate		=CUST.DATA.appUptoDateCr
				CUST.DATA.appUptoAmt		=CUST.DATA.appUptoAmtCr
				#}
			ELSE
				#{
				CUST.DATA.accrUptoDate		=CUST.DATA.accrUptoDateDr
				CUST.DATA.accrUptoAmt		=CUST.DATA.accrUptoAmtDr
				CUST.DATA.bkdUptoDate		=CUST.DATA.bkdUptoDateDr
				CUST.DATA.bkdUptoAmt		=CUST.DATA.bkdUptoAmtDr
				CUST.DATA.appUptoDate		=CUST.DATA.appUptoDateDr
				CUST.DATA.appUptoAmt		=CUST.DATA.appUptoAmtDr
			#}
			ENDIF
			
			IF(CUST.DATA.intBookAppFlg=="A") THEN
			#{
				CUST.DATA.accrAmtToday		=CDOUBLE(CUST.DATA.tranAmt)
				CUST.DATA.bkdAmtToday		="0"
				CUST.DATA.appAmtToday		=CDOUBLE(CUST.DATA.tranAmt)
				#}
			ELSE
				#{
				CUST.DATA.accrAmtToday		=CDOUBLE(CUST.DATA.tranAmt)
				CUST.DATA.bkdAmtToday		=CDOUBLE(CUST.DATA.tranAmt)
				CUST.DATA.appAmtToday		="0"
			#}
			ENDIF
			
			PRINT(CUST.DATA.tranDate)
			PRINT(CUST.DATA.glBacid)
			PRINT(CUST.DATA.glAcctNo)
			PRINT(CUST.DATA.tranId)
			PRINT(CUST.DATA.partTranSrlNum)
			PRINT(CUST.DATA.tranAmt)
			PRINT(CUST.DATA.tranCrncy)
			PRINT(CUST.DATA.partTranType)
			#-------------------------------------
			#Inserting the record into C_EIT table
			#-------------------------------------
			BANCS.INPARAM.BINDVARS=CUST.DATA.tranDate+"|"+CUST.DATA.glBacid+"|"+CUST.DATA.glAcctNo
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.tranId+"|"+CUST.DATA.partTranSrlNum
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.tranAmt
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.tranCrncy
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.partTranType
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.tranPart
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.tranPart2
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.tranRmks
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.custAcct
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.solId
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.schmType
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.schmCode
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.eodBal
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.unclrbalamt
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.futbalamt
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.lienAmt
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.glSubCode
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.intpdFlg
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.intcollFlg
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.partTranType
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.intRate
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+"T"
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.accrUptoDate
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.accrUptoAmt
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.accrAmtToday
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.bkdUptoDate
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.bkdUptoAmt
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.bkdAmtToday
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.appUptoDate
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.appUptoAmt
			BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.appAmtToday
