 <--START
CHECKSUM="72cfea39df01ad866f594a9080210fd4b4bfdb3f818d390903b4d3f4e2a7d82d"
TRACE ON
IF (BANCS.STDIN.moduleIdentity != "FI") THEN

	IF(BANCS.STDIN.menuId == "HPORDM") THEN

		IF(REPEXISTS("CUST") == 0) THEN
			CREATEREP("CUST")
		ENDIF
		IF(CLASSEXISTS("CUST","DATA") == 0) THEN
			CREATECLASS("CUST","DATA",5)
		ENDIF

		sv_r=urhk_B2k_PrintRepos("BANCS")
		print (sv_r)

		sv_a = urhk_SRV_GetVal("pordCrit.pymtRefNum")
		CUST.DATA.pymtRefNum=BANCS.OUTPARAM.srvValue
		print(CUST.DATA.pymtRefNum)


		sv_s = " ORD_PARTY_ACCT,foracid,PYMT_REF_NUM |select ORD_PARTY_ACCT, foracid , PYMT_REF_NUM  from tbaadm.porh, tbaadm.gam  where  "  
		sv_s =  sv_s + "   porh.bank_id =?SVAR and  gam.bank_id  = ?SVAR and  gam.acid =porh.DR_ACCT and PYMT_REF_NUM = ?SVAR  "
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.pymtRefNum 
		print(sv_s)
		sv_u = urhk_dbselectWithBind(sv_s)
		IF (sv_u ==0) THEN
			CUST.DATA.ORD_PARTY_ACCT = BANCS.OUTPARAM.ORD_PARTY_ACCT
			CUST.DATA.foracid = BANCS.OUTPARAM.foracid
			CUST.DATA.PYMT_REF_NUM = BANCS.OUTPARAM.PYMT_REF_NUM
				Print (CUST.DATA.ORD_PARTY_ACCT)
				Print (CUST.DATA.foracid)
				Print (CUST.DATA.PYMT_REF_NUM)
			IF (CUST.DATA.ORD_PARTY_ACCT != CUST.DATA.foracid) THEN
				sv_a = urhk_SRV_SetErr("Ordering A/c and Debit A/c Mismatch. Maker to modifiy and visit reimbusment tab")
				GOTO ENDOFSCRIPT		
			ENDIF
		ELSE
			CUSTS.DATA.pymtrefnum = "INVALID PAYMENT ORDER NUMBER"
			sv_a = urhk_SRV_SetErr("INVALID PAYMENT ORDER NUMBER")
			GOTO ENDOFSCRIPT
		ENDIF
	ENDIF
ENDIF

ENDOFSCRIPT:
TRACE OFF

END-->  


