<--START
TRACE ON

#-----------------------------------------------------------------
# Initialise is used to Check whether Class ATM exists.
# If not then creates that class.
# 5 stands for String Type data.
#-----------------------------------------------------------------
Initialise:
#{
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
		CREATEREP("CUST")
	ENDIF

	sv_r = CLASSEXISTS("CUST", "ATM")
	IF (sv_r == 0) THEN
		CREATECLASS("CUST", "ATM", 5)
	ENDIF
#{

#--------------------------------------------
# getting the detail From CPARAM
#--------------------------------------------

CUST.ATM.errMsg = ""

BANCS.INPUT.moduleName  = "ATM"
BANCS.INPUT.parameterId = "CRACCT_2"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATM.crAcct2 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.ATM.errMsg = "CRACCT_2 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "CRACCT_3"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.ATM.crAcct3 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.ATM.errMsg = "CRACCT_3 setup not done CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "CRNCYCODE_1"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.ATM.crncyCode1 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.ATM.errMsg = "CRNCYCODE_1 setup not done CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

IF(BANCS.STDIN.contextBankId != "56" ) THEN
#{
	#################################################
	# Checking if the transaction exist 
	#################################################
	sv_a = "100"
	CUST.ATM.DubTranAmt = cdouble(BANCS.INPUT.TranAmt) / cdouble(sv_a)
	
	sv_z =" count|select count(1) from CUSTOM.C_POS_TRX where BANK_ID = ?SVAR AND MESSAGE_TYPE=?SVAR "
	sv_z = sv_z +" AND TRACE_AUDIT_NUMBER=?SVAR " 
	sv_z = sv_z +" AND DEVICEID =?SVAR " 
	sv_z = sv_z + " AND CARD_NUMBER=?SVAR "
	sv_z = sv_z + " AND ACCOUNT_NUMBER=?SVAR "
	sv_z = sv_z + " AND TRANSACTION_AMOUNT=?SVAR " 
	sv_z = sv_z + " AND PRIVATE_DATA_C_100=?SVAR " 
	#print(sv_z)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.Command + "|" + BANCS.INPUT.SerialNum
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.DeviceId + "|" + BANCS.INPUT.CustCardId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.Foracid + "|" + CUST.ATM.DubTranAmt
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.DccId
	sv_u = urhk_dbSelectWithBind(sv_z)
	IF ( sv_u != 0 ) then
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	ELSE
		CUST.ATM.count=BANCS.OUTPARAM.count
		#print(CUST.ATM.count)
		IF (CUST.ATM.count!="0")  then
			CUST.ATM.Amount = "0"   		
			GOTO Finish
		ENDIF
	ENDIF
#}
ENDIF
	
#------------------------------------------------------------------
#  Getting account to debit
# 
#------------------------------------------------------------------
#print(BANCS.OUTPUT.contraAccount)

IF (BANCS.OUTPUT.contraAccount == "") THEN
	CUST.ATM.Amount = "0"   		
	GOTO Finish
ELSE

#print(BANCS.INPUT.Command)

IF (BANCS.INPUT.Command == "") THEN
	CUST.ATM.Amount = "0"   		
	GOTO Finish
ELSE

	CUST.ATM.cmd=BANCS.INPUT.Command 
	
ENDIF

#--------------------------------------------------------------------------
# getting the amount to split
#--------------------------------------------------------------------------
##print(BANCS.INPUT.TranAmt)
##print(BANCS.INPUT.SerialNum)

IF (BANCS.INPUT.TranAmt == "0") THEN
	CUST.ATM.Amount = "0"   		
	GOTO Finish
ELSE
	IF (BANCS.INPUT.DccId =="NKI") THEN
		#---------------------------------------------------------
		# Total debit amount
		#---------------------------------------------------------
		BANCS.INPUT.DeviceId=trim(mid$(BANCS.INPUT.DeviceId,0,2))
		#print(BANCS.INPUT.DeviceId)
		IF ((BANCS.INPUT.DeviceId=="SM") OR (BANCS.INPUT.DeviceId=="WM")) THEN

			CUST.ATM.percent = "0.0225"
			sv_a = "100"
			##print(CUST.ATM.percent)
			CUST.ATM.TranAmt = cdouble(BANCS.INPUT.TranAmt) / cdouble(sv_a)
			CUST.ATM.Amount =cdouble(CUST.ATM.TranAmt) * cdouble(CUST.ATM.percent)
			##print(CUST.ATM.Amount)

			
		ENDIF

		IF ((BANCS.INPUT.DeviceId=="UC") OR (BANCS.INPUT.DeviceId=="NS") OR (BANCS.INPUT.DeviceId=="MA") )THEN

			CUST.ATM.percent = "0.02"
			sv_a = "100"
			##print(CUST.ATM.percent)
			CUST.ATM.TranAmt = cdouble(BANCS.INPUT.TranAmt) / cdouble(sv_a)
			CUST.ATM.Amount =cdouble(CUST.ATM.TranAmt) * cdouble(CUST.ATM.percent)
			##print(CUST.ATM.Amount)

			
		ENDIF

		IF ((BANCS.INPUT.DeviceId=="NK") OR (BANCS.INPUT.DeviceId=="TK") OR (BANCS.INPUT.DeviceId=="EK")) THEN

			CUST.ATM.percent = "0.015"
			sv_a = "100"
			##print(CUST.ATM.percent)
			CUST.ATM.TranAmt = cdouble(BANCS.INPUT.TranAmt) / cdouble(sv_a)
			CUST.ATM.Amount =cdouble(CUST.ATM.TranAmt) * cdouble(CUST.ATM.percent)
			##print(CUST.ATM.Amount)

		ENDIF
		CUST.ATM.AUTOSETTLE="N"	

	ELSE
		#---------------------------------------------------------
		# Total debit amount
		#---------------------------------------------------------
		sv_x = " CHANNEL,SETTLEMENT,comm|select  CHANNEL_ID, MERCH_SETTLEMENT_ACCOUNT,MERCH_PURCHASE_COMM "
		sv_x = sv_x + " from CUSTOMc_merchants where BANK_ID = ?SVAR AND MERCHANT_ID =?SVAR"
		sv_x = sv_x + " and ENTITY_CRE_FLG = 'Y' and DEL_FLG ='N' "
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.DeviceId
		sv_r =urhk_dbSelectWithBind(sv_x)
		IF (sv_r == "0") THEN

			IF(BANCS.STDIN.contextBankId != "56" ) THEN
			#{
				CUST.ATM.comm= BANCS.OUTPARAM.comm
				CUST.ATM.CHANNEL= BANCS.OUTPARAM.CHANNEL
				CUST.ATM.SETTLEMENT= BANCS.OUTPARAM.SETTLEMENT
				#print(CUST.ATM.comm)
				#print(CUST.ATM.CHANNEL)
				#print(CUST.ATM.SETTLEMENT)
			#}
			ENDIF	

			sv_a="100"
			CUST.ATM.percent=cdouble(CUST.ATM.comm)/cdouble(sv_a)
			CUST.ATM.TranAmt = cdouble(BANCS.INPUT.TranAmt) / cdouble(sv_a)
			CUST.ATM.Amount =cdouble(CUST.ATM.TranAmt) * cdouble(CUST.ATM.percent)
	
			IF(BANCS.STDIN.contextBankId != "56" ) THEN
            #{
				CUST.ATM.DistAmount =cdouble(CUST.ATM.TranAmt) - cdouble(CUST.ATM.Amount)
				#print(CUST.ATM.TranAmt)
				#print(CUST.ATM.Amount)
				#print(CUST.ATM.DistAmount)
			#}
			ENDIF
		ELSE
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			exitscript
		ENDIF

		IF(BANCS.STDIN.contextBankId != "56" ) THEN
		#{
			IF ( CUST.ATM.CHANNEL=="CLD") THEN
				CUST.ATM.AUTOSETTLE="Y"
			ELSE
				CUST.ATM.AUTOSETTLE="N"	
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	#---------------------------------------------------------
	# Rounding Off the amount to nearest five cents
	#---------------------------------------------------------
	BANCS.INPARAM.InputAmount=CUST.ATM.Amount
	BANCS.INPARAM.RoundOffAmt=.05
	BANCS.INPARAM.RoundOffFlag="N"
	sv_r=urhk_B2k_Roundoff("")
	IF (sv_r == 0) THEN
		CUST.ATM.Amount = BANCS.OUTPARAM.OutputAmount
	ENDIF
	IF(BANCS.STDIN.contextBankId != "56" ) THEN
	#{
		IF (CUST.ATM.AUTOSETTLE=="Y") THEN
			CUST.ATM.DistAmount =cdouble(CUST.ATM.TranAmt) - cdouble(CUST.ATM.Amount)
			#print(CUST.ATM.DistAmount)
		ENDIF
		#print(CUST.ATM.Amount)
	#}
	ENDIF

ENDIF
#print(CUST.ATM.AUTOSETTLE)
#------------------------------------------------------------------
#  Hardcoding the bacid for equity cashbck Income Account
#  & validation for the bacid. if the account is not exist then 
#  it will generate a report and send to PR menu
#------------------------------------------------------------------
IF(BANCS.STDIN.contextBankId != "56" ) THEN
#{
	IF (CUST.ATM.AUTOSETTLE=="N") THEN
		IF (CUST.ATM.cmd ==  "PRCR") THEN
			CUST.ATM.drAccount = BANCS.OUTPUT.contraAccount
			CUST.ATM.crAccount = CUST.ATM.crAcct2
		ELSE
			CUST.ATM.drAccount = CUST.ATM.crAcct2
			CUST.ATM.crAccount = BANCS.OUTPUT.contraAccount
		ENDIF
	ELSE
		IF (CUST.ATM.cmd ==  "PRCR") THEN
			CUST.ATM.drAccount = BANCS.OUTPUT.contraAccount
			CUST.ATM.crAccount = CUST.ATM.crAcct3
			CUST.ATM.crAccount2 = CUST.ATM.SETTLEMENT
			#print(CUST.ATM.drAccount)
			#print(CUST.ATM.crAccount)
			#print(CUST.ATM.crAccount2)
		ELSE
			CUST.ATM.drAccount = CUST.ATM.crAcct3
			CUST.ATM.crAccount2 = CUST.ATM.SETTLEMENT
			CUST.ATM.crAccount = BANCS.OUTPUT.contraAccount
			#print(CUST.ATM.crAccount)
			#print(CUST.ATM.drAccount)
			#print(CUST.ATM.drAccount2)
		ENDIF
	#}
	ENDIF
#}
ELSE
#{
	IF (CUST.ATM.cmd ==  "PRCR") THEN
		CUST.ATM.drAccount = BANCS.OUTPUT.contraAccount
		CUST.ATM.crAccount = CUST.ATM.crAcct2
	ELSE
		CUST.ATM.drAccount = CUST.ATM.crAcct2
		CUST.ATM.crAccount = BANCS.OUTPUT.contraAccount
	ENDIF
#}
ENDIF

#--------------------------------------------------------------------------
# Create the narration
#--------------------------------------------------------------------------
sv_e = mid$(BANCS.STDIN.BODDate,0,10)
##print(sv_e)
sv_s = "sysdate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') from dual"
BANCS.INPARAM.BINDVARS =  sv_e
sv_d = urhk_dbSelectWithBind(sv_s)
##print(sv_d)
IF (sv_d =="0") THEN
	CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate

	IF(BANCS.STDIN.contextBankId != "56" ) THEN
	#{	
	IF (CUST.ATM.AUTOSETTLE=="N") THEN
		IF (CUST.ATM.cmd == "PRCR") THEN
			CUST.ATM.narr1 ="PUR Comm. To " + CUST.ATM.crAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			CUST.ATM.narr2 ="PUR Comm. Frm " + CUST.ATM.drAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
		ELSE
			CUST.ATM.narr1 ="Rev Comm. To " + CUST.ATM.drAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			CUST.ATM.narr2 ="Rev Comm. Frm " + CUST.ATM.crAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
		ENDIF
	ELSE
		IF (CUST.ATM.cmd == "PRCR") THEN
			CUST.ATM.narr1 ="PUR Comm. To " + CUST.ATM.crAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			CUST.ATM.narr2 ="PUR Comm. Frm " + CUST.ATM.drAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			CUST.ATM.narr3 ="CASHLESS PURCHASE/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			#print(CUST.ATM.narr1)
			#print(CUST.ATM.narr2)
			#print(CUST.ATM.narr3)
		ELSE
			CUST.ATM.narr1 ="Rev Comm. To " + CUST.ATM.drAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			CUST.ATM.narr2 ="Rev Comm. Frm " + CUST.ATM.crAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			CUST.ATM.narr3 ="CASHLESS REVERSAL/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			#print(CUST.ATM.narr1)
			#print(CUST.ATM.narr2)
			#print(CUST.ATM.narr3)
		ENDIF
	ENDIF
	#}
	ELSE
	#{
		IF (CUST.ATM.cmd == "PRCR") THEN
            CUST.ATM.narr1 ="PUR Comm. To " + CUST.ATM.crAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
            CUST.ATM.narr2 ="PUR Comm. Frm " + CUST.ATM.drAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
        ELSE
			CUST.ATM.narr1 ="Rev Comm. To " + CUST.ATM.drAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
            CUST.ATM.narr2 ="Rev Comm. Frm " + CUST.ATM.crAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
		#}
		ENDIF
	#}
	ENDIF
ELSE
 GOTO Finish
ENDIF
#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------

        sv_r = REPEXISTS("MTT")
        IF (sv_r == 0) THEN
                CREATEREP("MTT")
        ENDIF

        sv_r = CLASSEXISTS("MTT","TranDetails")
        IF (sv_r == 0) THEN
                CREATECLASS("MTT","TranDetails",5)
        ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
        IF (sv_r == 0) THEN
                CREATECLASS("MTT","PartTranDetails",5)
        ENDIF

        sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        ENDIF

        sv_r = CLASSEXISTS("BANCS","INPARAM")
        IF (sv_r == 0) THEN
                CREATECLASS("BANCS","INPARAM",5)
        ENDIF

        BANCS.INPARAM.PostTranFlg = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg = "N"
        BANCS.INPARAM.CommitFlg="Y"
        BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw="Y"
        BANCS.INPARAM.CheckExceptions="N"
        MTT.TranDetails.TranDate="0"
        MTT.TranDetails.TranType = "T"
        MTT.TranDetails.TranSubType = "CI"
        MTT.TranDetails.IgnoreExcp = "I"
        MTT.TranDetails.Consolidate = "N"
        MTT.TranDetails.Remarks = CUST.ATM.narr1

        sv_r = urhk_MTTS_Initialize("")
        #print(sv_r)

        sv_v = "PurchaseComm"
        #print(sv_v)

        sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
	#print(sv_u)

        sv_u = urhk_MTTS_PopulateInputDetails("")
	#print(sv_u)

	#--------------------------------------------------------------------------
	# MTT code for creating tranxs  consolidated debit to the collection A/c and
	# individual credit to the income Account and settlement a/c.
	#--------------------------------------------------------------------------

	#--------------------------------------------------
        # Contra To EQUITY PURCHASES COMM A/C
        #--------------------------------------------------

                MTT.PartTranDetails.Account = CUST.ATM.crAccount
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.ATM.narr2
                MTT.PartTranDetails.RefAmount = cdouble(CUST.ATM.Amount)
                #print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = ""
                MTT.PartTranDetails.RefNum = ""
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_e = "PurchaseIncome"
                sv_r = urhk_MTTS_definePartTran(sv_e)
		##print(sv_r)

		IF(BANCS.STDIN.contextBankId != "56" ) THEN
		#{
		if(sv_r != 0) then
			CUST.ATM.Sucessfail1     = "N"
	
		ELSE
			CUST.ATM.Sucessfail1     = "Y"
		endif
	
	IF (CUST.ATM.AUTOSETTLE == "Y") THEN 
		#--------------------------------------------------
		# Contra To settlement Account
		#--------------------------------------------------
		MTT.PartTranDetails.Account = CUST.ATM.crAccount2
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.ATM.narr3
                MTT.PartTranDetails.RefAmount = cdouble(CUST.ATM.DistAmount)
                #print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = ""
                MTT.PartTranDetails.RefNum = ""
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_e = "PurchaseIncome"
                sv_r = urhk_MTTS_definePartTran(sv_e)
		#print(sv_r)
		if(sv_r != 0) then
			CUST.ATM.Sucessfail1     = "N"
	
		ELSE
			CUST.ATM.Sucessfail1     = "Y"
		endif
		#print(CUST.ATM.Sucessfail1)

		#------------------------------------------------------------------
		# Consolidated debit to collection A/c
		#------------------------------------------------------------------

                MTT.PartTranDetails.Account = CUST.ATM.drAccount
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.ATM.narr1
                sv_a = cdouble(CUST.ATM.TranAmt) 
		sv_a = -(sv_a)
		#print(sv_a)
                MTT.PartTranDetails.RefAmount = sv_a
                #print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = "" 
                MTT.PartTranDetails.RefNum = "" 
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_h = "D" + CUST.ATM.drAccount
                sv_u = urhk_MTTS_definePartTran(sv_h)
                sv_r = urhk_MTTS_EndDefinition("")
		#print(sv_r)
                sv_r = urhk_MTTS_Close("")
		#print(sv_r)
		if(sv_r != 0) then
			CUST.ATM.Sucessfail2     = "N"

		ELSE
			CUST.ATM.Sucessfail2     = "Y"
		endif
		#print(CUST.ATM.Sucessfail2)
	ELSE
	
		#------------------------------------------------------------------
		# Debit Partran To MERCHANT PURCHASES COMM A/C
		#------------------------------------------------------------------

                MTT.PartTranDetails.Account = CUST.ATM.drAccount
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.ATM.narr1
                sv_a = cdouble(CUST.ATM.Amount) 
		sv_a = -(sv_a)
		#print(sv_a)
                MTT.PartTranDetails.RefAmount = sv_a
                #print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = "" 
                MTT.PartTranDetails.RefNum = "" 
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_h = "D" + CUST.ATM.drAccount
                sv_u = urhk_MTTS_definePartTran(sv_h)
                sv_r = urhk_MTTS_EndDefinition("")
		#print(sv_r)
                sv_r = urhk_MTTS_Close("")
                #print(sv_r)
		if(sv_r != 0) then
			CUST.ATM.Sucessfail2     = "N"

		ELSE
			CUST.ATM.Sucessfail2     = "Y"
	endif
		#print(CUST.ATM.Sucessfail2)

        ENDIF

	#################################################
	# Inserting Values into Success/Failure Table 
	#################################################
	IF( (CUST.ATM.Sucessfail1 == "Y") AND (CUST.ATM.Sucessfail2 == "Y")) then
		sv_z = "insert into CUSTOM.C_POS_TRX(MESSAGE_TYPE, TRACE_AUDIT_NUMBER,DEVICEID, CARD_NUMBER, ACCOUNT_NUMBER,TRANSACTION_AMOUNT, "
		sv_z = sv_z + " TRANSACTION_FEE, PRIVATE_DATA_C_100, ORIGINAL_DATA_ELEMENTS,BANK_ID) values(?SVAR,"
		sv_z = sv_z + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
		#print(sv_z)

		BANCS.INPARAM.BINDVARS = BANCS.INPUT.Command + "|" + BANCS.INPUT.SerialNum + "|" + BANCS.INPUT.DeviceId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.CustCardId + "|" + BANCS.INPUT.Foracid
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +CUST.ATM.DubTranAmt + "|" + BANCS.INPUT.Fee
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.DccId + "|" + BANCS.INPUT.OrigDataElements
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.STDIN.contextBankId
		sv_z = urhk_dbSqlWithBind(sv_z)
		If (sv_z == 0) then
			sv_z = urhk_dbSqlWithBind("COMMIT")
		endif
	ENDIF
	#}
	ELSE
	#{
		 #------------------------------------------------------------------
        # Debit Partran To MERCHANT PURCHASES COMM A/C
        #------------------------------------------------------------------

                MTT.PartTranDetails.Account = CUST.ATM.drAccount
