<--START 
TRACE ON

#------------------------------------------------------------------------------
#	Creating repository and class
#	Initializing the variables
#	Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","ATMCHRG") == 0) THEN
#{
	CREATECLASS("CUST","ATMCHRG",5)
#}
ENDIF

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

CUST.ATMCHRG.errMsg = ""

#-----------------------------------------------------------------------------------------------
#Getting refCode from ATMCHRG values
#-----------------------------------------------------------------------------------------------
BANCS.INPUT.moduleName = "GENERAL"
BANCS.INPUT.parameterId = "NORRATECODE"

CALL ("getcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF (BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATMCHRG.refCode = BANCS.OUTPUT.parameterVal
	print(CUST.ATMCHRG.refCode)
#}
ELSE
#{
	CUST.ATMCHRG.errMsg = "NORRATECODE setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

#-----------------------------------------------------------------------------------------------
#Getting rownum from ATMCHRG values
#-----------------------------------------------------------------------------------------------
BANCS.INPUT.moduleName = "ATMCHARGES"
BANCS.INPUT.parameterId = "ROWNUM"

CALL ("getcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF (BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATMCHRG.rownum= BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.ATMCHRG.errMsg = "Rownum setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

#-----------------------------------------------------------------------------------------------
#Getting Tranrmks from ATMCHRG values
#-----------------------------------------------------------------------------------------------
BANCS.INPUT.moduleName = "ATMCHARGES"
BANCS.INPUT.parameterId = "TRANRMKS"

CALL ("getcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF (BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATMCHRG.tranrmks= BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.ATMCHRG.errMsg = "Tranrmks setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

#-----------------------------------------------------------------------------------------------
#Getting TRANNAR from ATMCHRG values
#-----------------------------------------------------------------------------------------------
BANCS.INPUT.moduleName = "ATMCHARGES"
BANCS.INPUT.parameterId = "TRANNAR"

CALL ("getcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF (BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATMCHRG.tranNar = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.ATMCHRG.errMsg = "TranNar setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

#-----------------------------------------------------------------
#Getting record counts from ATM_SHARE_TOTPOST table
#-----------------------------------------------------------------
sv_s = " count|"
sv_s = sv_s + " SELECT COUNT(1)" 
sv_s = sv_s + " FROM CUSTOM.ATM_SHARE_TOTPOST"
sv_s = sv_s + " WHERE process_flag='M'" 
sv_s = sv_s + " AND rownum < ?SVAR"
sv_s = sv_s + " and ATM_SOL_COMM !=0 AND  ATM_SHARE_TOTPOST.bank_id = ?SVAR"
print(sv_s)
BANCS.INPARAM.BINDVARS = CUST.ATMCHRG.rownum + "|" + BANCS.STDIN.contextBankId  		
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbselectWithBind(sv_s)

print(sv_d)

IF (sv_d == 0) THEN
#{
	CUST.ATMCHRG.count =BANCS.OUTPARAM.count
	print(CUST.ATMCHRG.count)
#}
ELSE
#{
	CUST.ATMCHRG.errMsg = "Error in getting count from ATM_SHARE_TOTPOST table " 
	GOTO ENDOFSCRIPT
#}
ENDIF

IF (CINT(CUST.ATMCHRG.count) == 0) THEN
#{
	print("Records are not available in ATM_SHARE_TOTPOST table ")
	GOTO ENDOFSCRIPT
#}
ENDIF

#--------------------------------------------------------------------------
# Selecting accounts from ATM_SHARE_TOTPOST
#--------------------------------------------------------------------------
sv_s = " mainsolcommacnt,atmsolcommacct,custsolcommacct,"
sv_s = sv_s + " total,atmsolcomm,custsolcomm,sequence,prodate|"
sv_s = sv_s + " SELECT main_sol_comm_acnt,"
sv_s = sv_s + " atm_sol_comm_acct,"
sv_s = sv_s + " cust_sol_comm_acct,"
sv_s = sv_s + " total,"
sv_s = sv_s + " atm_sol_comm,"
sv_s = sv_s + " cust_sol_comm,"
sv_s = sv_s + " sequence_no,"
sv_s = sv_s + " process_date" 
sv_s = sv_s + " FROM CUSTOM.ATM_SHARE_TOTPOST" 
sv_s = sv_s + " WHERE process_flag = 'M'" 
sv_s = sv_s + " AND rownum < ?SVAR"
sv_s = sv_s + " and ATM_SOL_COMM !=0 AND bank_id = ?SVAR"
print(sv_s)
BANCS.INPARAM.BINDVARS = CUST.ATMCHRG.rownum + "|" + BANCS.STDIN.contextBankId 		
print(BANCS.INPARAM.BINDVARS)
sv_c = urhk_dbcursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c != 0) THEN
#{
	CUST.ATMCHRG.errMsg = "Error in getting cursor rows from custom table" 
	GOTO ENDOFSCRIPT
#}
ENDIF

CUST.ATMCHRG.DB_CURSOR_NUMBER =BANCS.OUTPARAM.DB_CURSOR_NUMBER
print(CUST.ATMCHRG.DB_CURSOR_NUMBER)

#--------------------------------------------------------------------------	
# Initialise the Local Variables 
#--------------------------------------------------------------------------

	#------------------------------------------------------------------
	#  Variable Initialisation for counter. It should be Zero
	#------------------------------------------------------------------
		sv_z = 0

#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------
	    

	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.Remarks = "ATM Withdrw Comm "
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.PSTUpdateFlg ="N"

	sv_v = "bCashWithCrg"
	print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("bCashWithCrg")

#--------------------------------------------------------------------------
# MTT code for creating tranxs like individual debit from customer and 
# consolidated credit to the income Account. 


#--------------------------------------------------------------------------
# This code for creating tranxs like individual debit from customer and 
# consolidated credit to the income Account. 
#--------------------------------------------------------------------------
sv_k = urhk_dbCursorFetch(CUST.ATMCHRG.DB_CURSOR_NUMBER)
print(sv_k)
WHILE (sv_k == 0)
#{
	CUST.ATMCHRG.partSrlNo = "0"

	CUST.ATMCHRG.mainsolcommacnt	= BANCS.OUTPARAM.mainsolcommacnt
	CUST.ATMCHRG.atmsolcommacct	= BANCS.OUTPARAM.atmsolcommacct
	CUST.ATMCHRG.custsolcommacct 	= BANCS.OUTPARAM.custsolcommacct
	CUST.ATMCHRG.total 		= BANCS.OUTPARAM.total
	CUST.ATMCHRG.atmsolcomm		= BANCS.OUTPARAM.atmsolcomm
	CUST.ATMCHRG.custsolcomm 	= BANCS.OUTPARAM.custsolcomm
	CUST.ATMCHRG.sequence		= BANCS.OUTPARAM.sequence
	CUST.ATMCHRG.prodate 		= BANCS.OUTPARAM.prodate
	print(CUST.ATMCHRG.mainsolcommacnt)
	print(CUST.ATMCHRG.atmsolcommacct)
	print(CUST.ATMCHRG.custsolcommacct)
	print(CUST.ATMCHRG.total)
	print(CUST.ATMCHRG.atmsolcomm)
	print(CUST.ATMCHRG.custsolcomm)
	print(CUST.ATMCHRG.sequence)
	print(CUST.ATMCHRG.prodate)

	#------------------------------------------
	# counter setting for defining different PartTran
	#------------------------------------------
		sv_z = sv_z + 1
		CUST.ATMCHRG.Counter = sv_z

	#--------------------------------------------------------------------------
	# Create the narration for tran particulars
	#--------------------------------------------------------------------------
	CUST.ATMCHRG.narr = CUST.ATMCHRG.tranNar
	CUST.ATMCHRG.narr = CUST.ATMCHRG.narr + CUST.ATMCHRG.prodate
	CUST.ATMCHRG.narr = CUST.ATMCHRG.narr + " - "
	CUST.ATMCHRG.narr = CUST.ATMCHRG.narr + CUST.ATMCHRG.prodate
	print(CUST.ATMCHRG.narr)


	MTT.PartTranDetails.Account = CUST.ATMCHRG.atmsolcommacct
	print(MTT.PartTranDetails.Account)
	MTT.PartTranDetails.RefCurrency = "KES"
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATMCHRG.narr  
	MTT.PartTranDetails.RefAmount = cdouble(CUST.ATMCHRG.atmsolcomm)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = CUST.ATMCHRG.sequence
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	print(CUST.ATMCHRG.Counter)
	sv_e = "Credt" + CUST.ATMCHRG.Counter
	print(sv_e)
	sv_r = urhk_MTTS_definePartTran(sv_e)
	print(sv_r)
	
	#--------------------------------------------------
	# Income To vat fee Account
	#--------------------------------------------------

	MTT.PartTranDetails.Account = CUST.ATMCHRG.custsolcommacct
	print(MTT.PartTranDetails.Account)
	MTT.PartTranDetails.RefCurrency = "KES"
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATMCHRG.narr  
	MTT.PartTranDetails.RefAmount = cdouble(CUST.ATMCHRG.custsolcomm)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = CUST.ATMCHRG.sequence
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	print(CUST.ATMCHRG.Counter)
	sv_e = "Credt" + CUST.ATMCHRG.Counter
	print(sv_e)
	sv_r = urhk_MTTS_definePartTran(sv_e)
	print(sv_r)
	
	#------------------------------------------------------------------
	# Customer Debit Partran
	#------------------------------------------------------------------

	MTT.PartTranDetails.Account = CUST.ATMCHRG.mainsolcommacnt
	MTT.PartTranDetails.RefCurrency = "KES"
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATMCHRG.narr
	sv_a = cdouble(CUST.ATMCHRG.total)
	print(sv_a)
	sv_a = -(sv_a)
	print(sv_a)
	MTT.PartTranDetails.RefAmount = sv_a
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = CUST.ATMCHRG.sequence
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	print(CUST.ATMCHRG.Counter)
	sv_h = "Debit" + CUST.ATMCHRG.Counter
	print(sv_h)
	sv_u = urhk_MTTS_definePartTran(sv_h)
	print(sv_u)
	
	sv_r = urhk_MTTS_EndDefinition("")
	print(sv_r)
	IF (sv_r == 0) THEN
	#{
		IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
		#{
			print(BANCS.OUTPARAM.tranId)
		#}
		ENDIF
	#}
	ENDIF

	IF (sv_r != 0) THEN
	#{
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>atmcharges.log")
				print(sv_u)
			#}
			DO
		#}
		ENDIF
	#}
	ELSE
	#{

		#------------------------------------------------------------------
		# Update record status as processed
		#------------------------------------------------------------------
		sv_s = " UPDATE CUSTOM.ATM_SHARE_TOTPOST "
		sv_s = sv_s + " SET process_flag ='P'" 
		sv_s = sv_s + " WHERE sequence_no= ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ATMCHRG.sequence + "|" + BANCS.STDIN.contextBankId  		
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
	
		IF (sv_d == 0) THEN
		#{  
			print("The table ATM_SHARE_TOTPOST updated successfully")
			sv_d = urhk_dbSQLWithBind("COMMIT")
			print(sv_d)
		#}  
		ELSE
		#{
			CUST.EVCHRG.errMsg = CUST.EVCHRG.errMsg + "TABLE ATM_SHARE_TOTPOST Update Failed for Sequence No"+CUST.ATMCHRG.sequence
		#}
		ENDIF
	#}
	ENDIF
	sv_k = urhk_dbCursorFetch(CUST.ATMCHRG.DB_CURSOR_NUMBER)
	print(sv_k)
#}
DO

sv_c = urhk_dbCursorClose(CUST.ATMCHRG.DB_CURSOR_NUMBER)
print(sv_c)

ENDOFSCRIPT:
IF (CUST.ATMCHRG.errMsg != "") THEN
#{
	print(CUST.ATMCHRG.errMsg)
	sv_u = system("echo '"+CUST.ATMCHRG.errMsg+"' >>atmcharges.log")
#}
ENDIF

EXITSCRIPT
TRACE OFF
END-->
