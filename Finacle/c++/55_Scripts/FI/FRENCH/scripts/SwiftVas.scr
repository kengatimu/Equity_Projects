########################################################################################################
<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

IF( (FIELDEXISTS(("BANCS").("INPUT").("VASID"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply unique id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.VASID=BANCS.INPUT.VASID
	print(CUST.DATA.VASID)
ENDIF


############################################
# Fetching the valueS
############################################

sv_q = "Count|"
sv_q = sv_q + " select Count(*) from  custom.c_vas where vas_id = ?SVAR "
print(sv_q)
BANCS.INPARAM.BINDVARS =  CUST.DATA.VASID 
print(BANCS.INPARAM.BINDVARS)
sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.Count = BANCS.OUTPARAM.Count
		print (CUST.DATA.Count)
		IF (CINT(CUST.DATA.Count) > 0) THEN			
			sv_q = " foracid,billerid| "
			sv_q = sv_q + " select c.foracid,b.FREE_TEXT5 from  custom.c_vas c,tbaadm.brgt b where vas_id =?SVAR and c.foracid=b.free_text1 and b.del_flg !='Y'"
			print(sv_q)
			BANCS.INPARAM.BINDVARS =  CUST.DATA.VASID 
			print(BANCS.INPARAM.BINDVARS)
			sv_p= urhk_dbSelectWithBind(sv_q)
			print(sv_p)
				IF (sv_p==0) then
					
					CUST.DATA.foracid = BANCS.OUTPARAM.foracid
					CUST.DATA.billerid = BANCS.OUTPARAM.billerid

					IF ((CUST.DATA.foracid != "") AND (CUST.DATA.billerid != ""))  THEN
						sv_z = urhk_SetOrbOut("Foracid|"+CUST.DATA.foracid)
						print(sv_z)
						sv_z = urhk_SetOrbOut("billerid|"+CUST.DATA.billerid)
						print(sv_z)
					ENDIF
				ELSE
					CUST.DATA.errMsg="Data Error.A/C not a biller"
					sv_e=urhk_SetOrbOut("StattusCode|Error")
					sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
				ENDIF

		ELSE
			CUST.DATA.errMsg="No_Record_Found"
			sv_e=urhk_SetOrbOut("StattusCode|Error")
			sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)

		ENDIF
	ELSE
		CUST.DATA.errMsg="Data Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	ENDIF


END:
EXITSCRIPT
trace off
END-->
