#################################################################################################
<--start
trace on

LIBNAME CUSTOMSO

sv_u=urhk_B2k_PrintRepos("BANCS")
print(sv_u)

BANCS.STDIN.onlineOrBatch="B"
BANCS.INPUT.srvcallmode="E"


#sv_r = urhk_B2K_PrintRepos("BANCS")
#------------------------------------------------------------------------------
# Initializing the Local Repositories
#------------------------------------------------------------------------------
print(BANCS.STDIN.userId)
sv_r = REPEXISTS("CUST")
IF (sv_r == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF
sv_r = CLASSEXISTS("CUST", "INTERFACE")
IF (sv_r == 0) THEN
#{
	CREATECLASS("CUST", "INTERFACE", 5)
#}
ENDIF

CUST.INTERFACE.SuccessOrFailure="Y"

###### Setting Final LST path
#sv_r = urhk_getEnv("FILE_INPUT_FLDR")
BANCS.INPUT.moduleName  = "IGLS"
BANCS.INPUT.parameterId = "FILE_INPUT_FLDR"

CALL ("getcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.INTERFACE.upldPath = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.INTERFACE.SuccessOrFailure="N"
    CUST.INTERFACE.ErrorDesc="CPARAM SETUP IS NOT DONE"
    sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
    sv_z = "Error_01|ERROR^Environment Variable 'FILE_INPUT_FLDR' is not set!^FileName"
	CUST.INTERFACE.ErrorDesc = " Environment Variable 'FILE_INPUT_FLDR' is not set"
    print(sv_u)
    GOTO ENDOFSCRIPT
#}
ENDIF
print(CUST.INTERFACE.upldPath)

#sv_r = urhk_getEnv("FILE_STAGE")
BANCS.INPUT.moduleName  = "IGLS"
BANCS.INPUT.parameterId = "FILE_STAGE"

CALL ("getcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.INTERFACE.File_Stage = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.INTERFACE.SuccessOrFailure="N"
    CUST.INTERFACE.ErrorDesc="CPARAM SETUP IS NOT DONE"
    sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
    sv_z = "Error_01|ERROR^Environment Variable 'FILE_STAGE' is not set!^FileName"
    sv_u = urhk_SetOrbOut(sv_z)
    print(sv_u)
    GOTO ENDOFSCRIPT
#}
ENDIF
print(CUST.INTERFACE.File_Stage) 

sv_r = urhk_getEnv("ONS_LOG_DIR")
IF (sv_r != 0) THEN
#{
CUST.INTERFACE.SuccessOrFailure="N"
	CUST.INTERFACE.ErrorDesc="CPARAM SETUP IS NOT DONE"
    sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
    sv_z = "Error_01|ERROR^Environment Variable 'ONS_LOG_DIR' is not set!^FileName"
    CUST.INTERFACE.ErrorDesc = " Environment Variable 'ONS_LOG_DIR' is not set "
    sv_u = urhk_SetOrbOut(sv_z)
    print(sv_u)
    GOTO ENDOFSCRIPT
#}
ENDIF
CUST.INTERFACE.wdPath = BANCS.OUTPARAM.envValue 
print(CUST.INTERFACE.wdPath)

CUST.INTERFACE.wdPath = CUST.INTERFACE.wdPath + "/" + BANCS.STDIN.userId

#sv_r = urhk_getEnv("FILE_OUTPUT_FLDR")
BANCS.INPUT.moduleName  = "IGLS"
BANCS.INPUT.parameterId = "FILE_OUTPUT_FLDR"

CALL ("getcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.INTERFACE.Out_Path = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.INTERFACE.SuccessOrFailure="N"
    CUST.INTERFACE.ErrorDesc="CPARAM SETUP IS NOT DONE"
    sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
    sv_z = "Error_01|ERROR^Environment Variable 'FILE_OUTPUT_FLDR' is not set!^FileName"
    CUST.INTERFACE.ErrorDesc = "Environment Variable 'FILE_OUTPUT_FLDR' is not set"
    print(sv_u)
    GOTO ENDOFSCRIPT
#}
ENDIF
print(CUST.INTERFACE.Out_Path) 
sv_r = urhk_putEnv("FILE_OUTPUT_FLDR|"+CUST.INTERFACE.Out_Path)
print(sv_r)


sv_p = urhk_B2k_PID("")
print(BANCS.OUTPARAM.PID)
CUST.INTERFACE.myPID = BANCS.OUTPARAM.PID

#==================================
# Creating the file in ttum format
#==================================

sv_w = "TtumExec_REQ.FileName"
sv_x = "TtumExec_REQ.RunType"

print(("BANCS").("INPUT").(sv_w))
CUST.INTERFACE.inputFile = ("BANCS").("INPUT").(sv_w)

print(("BANCS").("INPUT").(sv_x))
CUST.INTERFACE.RunType = ("BANCS").("INPUT").(sv_x)


# Get the input file path
CUST.INTERFACE.InputFileWithPath = CUST.INTERFACE.upldPath + "/" + CUST.INTERFACE.inputFile

# Check whether the input file exists or not

sv_t = "test -f " + CUST.INTERFACE.InputFileWithPath 
print(sv_t)
sv_r = system(sv_t)
print(sv_r)
if (sv_r != 0) then
#{
		CUST.INTERFACE.SuccessOrFailure="N"
		CUST.INTERFACE.ErrorDesc="File is not accessible/Available : " + CUST.INTERFACE.inputFile
		print("File is not accessible/Available" + CUST.INTERFACE.inputFile)
		print(sv_r)
		GOTO ENDOFSCRIPT
#}
ENDIF
sv_x = "cp " + CUST.INTERFACE.InputFileWithPath  + " " + CUST.INTERFACE.wdPath
print(sv_x)
sv_y = system(sv_x)
print(sv_y)
if (sv_r != 0) then
#{
		CUST.INTERFACE.SuccessOrFailure="N"
		CUST.INTERFACE.ErrorDesc="Failed to Copy the input file to File Stage for processing : " + CUST.INTERFACE.inputFile
		print("Failed to Copy the input file to File Stage for processing" + CUST.INTERFACE.inputFile)
		print(sv_r)
		GOTO ENDOFSCRIPT
#}
ENDIF

sv_x = "mv " + CUST.INTERFACE.InputFileWithPath  + " " + CUST.INTERFACE.File_Stage + "/" + CUST.INTERFACE.inputFile 
print(sv_x)
sv_y = system(sv_x)
print(sv_y)
if (sv_r != 0) then
#{
		CUST.INTERFACE.SuccessOrFailure="N"
		CUST.INTERFACE.ErrorDesc="Failed to Copy the input file to File Stage for processing"
		print("Failed to Copy the input file to File Stage for processing" + CUST.INTERFACE.inputFile)
		print(sv_r)
		GOTO ENDOFSCRIPT
#}
ENDIF

CUST.INTERFACE.rptTo = "MANAGER"
CUST.INTERFACE.tranSubType = "BI"

CUST.INTERFACE.inputFileName =  CUST.INTERFACE.inputFile
CUST.INTERFACE.tranMode = CUST.INTERFACE.RunType
CUST.INTERFACE.remarks = "INTERFACE_BATCH_UPLOAD"
CUST.INTERFACE.renInpFileName = "E"
CUST.INTERFACE.scrName = "INTERFACE_Ttumupload.scr"
CUST.INTERFACE.mrtSucName = "INTERFACE_Ttumupload.mrt"
CUST.INTERFACE.mrtFaiName = "Ttumfail.mrt"

sv_r = urhk_putEnvForCallShellScript("IGLS_PPID|"+CUST.INTERFACE.myPID)

sv_c= urhk_GetChannelinfo("")
print(sv_c)
IF (sv_c == 0) THEN
	print(BANCS.OUTPARAM.DccId)
	print(BANCS.OUTPARAM.DccReqRefNum)
	print(BANCS.OUTPARAM.DccReqType)
	print(BANCS.OUTPARAM.DccReqOriginTime)
	CUST.INTERFACE.DccId = BANCS.OUTPARAM.DccId
	sv_r = urhk_putEnvForCallShellScript("INTERFACE_CHNL_ID|"+CUST.INTERFACE.DccId)
	print(sv_r)
ENDIF

CUST.INTERFACE.fileSuffix = CUST.INTERFACE.DccId + "_" + CUST.INTERFACE.myPID
CUST.INTERFACE.DATFLE = CUST.INTERFACE.File_Stage + "/" + "IGLSinpFle_" + CUST.INTERFACE.fileSuffix + ".DAT"
print(CUST.INTERFACE.DATFLE)

sv_l = "rm -f " + CUST.INTERFACE.DATFLE
print(sv_l)
sv_g = system(sv_l)
print(sv_g)

sv_l = "touch " + CUST.INTERFACE.DATFLE
print(sv_l)
sv_g = system(sv_l)
print(sv_g)

CUST.INTERFACE.write_msg = CUST.INTERFACE.rptTo + " " 
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.tranSubType + " " 
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.inputFileName + " " 
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.tranMode + " " 
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.remarks + " " 
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.renInpFileName + " "
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.scrName + " " 
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.mrtSucName + " " 
CUST.INTERFACE.write_msg = CUST.INTERFACE.write_msg + CUST.INTERFACE.mrtFaiName 
print(CUST.INTERFACE.write_msg)
sv_l = "echo '" +CUST.INTERFACE.write_msg+ "'"
sv_l = sv_l + " > " + CUST.INTERFACE.DATFLE
print(sv_l) 
sv_g = system(sv_l)
print(sv_g)

sv_u = urhk_getFileLocation("COM|IGLS_TtumExeExecdp002.com")
print(sv_u)
CUST.INTERFACE.sComLoc= BANCS.OUTPARAM.fileLocation
print(CUST.INTERFACE.sComLoc)

CUST.INTERFACE.INPARAMS = ""
CUST.INTERFACE.INPARAMS = CUST.INTERFACE.INPARAMS + " " + CUST.INTERFACE.DATFLE
CUST.INTERFACE.INPARAMS = CUST.INTERFACE.INPARAMS + " " + CUST.INTERFACE.File_Stage  + "/"  + CUST.INTERFACE.inputFileName 
print(CUST.INTERFACE.INPARAMS)

BANCS.INPARAM.scriptName = "IGLS_TtumExeExecdp002.com"
BANCS.INPARAM.arguments = CUST.INTERFACE.INPARAMS

sv_r = urhk_CallShellScript("F")
print(sv_r)

IF(sv_r == 0) THEN
#{
	CUST.INTERFACE.tranId = ""
	sv_z=CUST.INTERFACE.Out_Path+"/TMP"+CUST.INTERFACE.myPID + ".com"
	print(sv_z)
	sv_a = system(sv_z)
	print(sv_a)
	sv_a = CUST.INTERFACE.Out_Path+"/"+MID$(CUST.INTERFACE.inputFileName,0,GETPOSITION(CUST.INTERFACE.inputFileName,".")) + "LST"
	print(sv_a)
	
	sv_o = urtn_fileOpen(sv_a + "|r")
	print(sv_o)
	IF (sv_o >= 0) THEN
	#{
        	CUST.INTERFACE.fileindex = sv_o
        	print(CUST.INTERFACE.fileindex)

        	sv_x = urtn_fileRead(CUST.INTERFACE.fileindex + "|" + "BANCS.OUTPARAM.buffer")
        	IF(sv_x == 0) THEN
        	#{
			print(BANCS.OUTPARAM.buffer)
			CUST.INTERFACE.buffer = BANCS.OUTPARAM.buffer
			sv_s = STRLEN(CUST.INTERFACE.buffer)
			print(sv_s)
			sv_w = GETPOSITION(CUST.INTERFACE.buffer,"|")
			print(sv_w)
			CUST.INTERFACE.SuccessOrFailure=MID$(CUST.INTERFACE.buffer,0,(sv_w-1))
			print(CUST.INTERFACE.SuccessOrFailure)
			IF(CUST.INTERFACE.SuccessOrFailure != "S") THEN
			#{
				CUST.INTERFACE.SuccessOrFailure="N"
				CUST.INTERFACE.ErrorDesc="Transaction failed. "
 				sv_c = urtn_fileClose(CUST.INTERFACE.fileindex)
				print(sv_c)
				GOTO ENDOFSCRIPT
			#}
			ENDIF	
			CUST.INTERFACE.fileBuffer =MID$(CUST.INTERFACE.buffer,sv_w,sv_s)
			print(CUST.INTERFACE.fileBuffer)
			CUST.INTERFACE.tranId = MID$(CUST.INTERFACE.fileBuffer,0,(GETPOSITION(CUST.INTERFACE.fileBuffer,"|")-1))
			print(CUST.INTERFACE.tranId)
		#}
		ENDIF
		sv_c = urtn_fileClose(CUST.INTERFACE.fileindex)
                print(sv_c)

	#}	
	ELSE
	#{
		CUST.INTERFACE.SuccessOrFailure="N"
		CUST.INTERFACE.tranId = "Please refer Finacle Logs"
		CUST.INTERFACE.ErrorDesc = "Please refer Finacle logs" 
		GOTO ENDOFSCRIPT
	#}
	ENDIF


	sv_z = "TtumExec_RES.Status|SUCCESS"
	sv_u = urhk_SetOrbOut(sv_z)
	sv_z = "TtumExec_RES.TranId|"+ CUST.INTERFACE.tranId
	sv_u = urhk_SetOrbOut(sv_z)
	print(sv_u)
#}
ELSE
#{
	sv_z = "TtumExec_RES.Status|FAILURE"
	sv_u = urhk_SetOrbOut(sv_z)
	sv_z = "TtumExec_RES.ERROR|EXECUTION FAILED"
	sv_u = urhk_SetOrbOut(sv_z)
	print(sv_u)
#}
ENDIF

ENDOFSCRIPT:
if (CUST.INTERFACE.SuccessOrFailure == "N" ) THEN
#{
        #lv_r = urhk_SetOrbOut("FIBUSINESSEXCEPTION.ERRORDETAILS.<rec_0>.ErrorCode|ERR100")
        #lv_r = urhk_SetOrbOut("FIBUSINESSEXCEPTION.ERRORDETAILS.<rec_0>.ErrorDesc|"+CUST.INTERFACE.ErrorDesc)
        sv_z = "TtumExec_RES.Status|FAILURE"
        sv_u = urhk_SetOrbOut(sv_z)
        sv_z = "TtumExec_RES.ERROR|EXECUTION FAILED. "+CUST.INTERFACE.ErrorDesc
        sv_u = urhk_SetOrbOut(sv_z)
        print(sv_u)

#}
ENDIF
exitscript
trace off
end-->
