	IF ((FIELDEXISTS(("BANCS").("INPUT").(sv_y))== 1) OR (FIELDEXISTS(("BANCS").("INPUT").(sv_x))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_z))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_p))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_r))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_f))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_j))== 1) OR (FIELDEXISTS(("BANCS").("INPUT").(sv_c))== 1))THEN
		
