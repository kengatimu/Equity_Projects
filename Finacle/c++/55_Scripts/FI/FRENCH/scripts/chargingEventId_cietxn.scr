	#MTT.TranDetails.PostTranFlg = "X"
	#MTT.TranDetails.Remarks = "CURRENCY EXCHANGE"
	#MTT.TranDetails.PostFlag = "X"
	#MTT.TranDetails.ErrorCheckForLuw = "N"
	#MTT.TranDetails.CommitFlag = "N"
	
	#MTT.TranDetails.IgnoreExcp="Y"
	#MTT.TranDetails.Consolidate = "Y"
	#MTT.TranDetails.ReversalFlag="Y"
	
	CUST.CIETXNCHRG.tran_identifier = "IEXTFXCHRGE"
	
	sv_r = urhk_MTTS_DefineTransaction(CUST.CIETXNCHRG.tran_identifier)
	print(sv_r)
	
	#-----------POPULATE INPUT DETAILS : START ----------------------------------------
	
	sv_r = urhk_MTTS_PopulateInputDetails("")
	print(sv_r)
	
	IF (sv_r != "0") THEN
	#{
		sv_u = urhk_TBAF_DispMesg("Unable to Define MTT transaction")
		GOTO FINISH
	#}
	ENDIF
	
	
	IF ((CUST.CIETXNCHRG.ChrgEvntId != "") AND (CDOUBLE(CUST.CIETXNCHRG.chrgAmount) != "0.0")) THEN
	#{
		print(CUST.CIETXNCHRG.chrgAmount)
		
		MTT.ChargeDetails.EventType = "GCHRG"
		MTT.ChargeDetails.EventId = CUST.CIETXNCHRG.ChrgEvntId
		print(MTT.ChargeDetails.EventId)
		MTT.ChargeDetails.ChrgInpCrncy = CUST.CIETXNCHRG.chargeCrncy
		MTT.ChargeDetails.PartyAccount = ""
		MTT.ChargeDetails.ChrgInpAmount = CUST.CIETXNCHRG.chrgAmount
		MTT.ChargeDetails.CollectionCrncy = BANCS.STDIN.homeCrncyCode
		CUST.CIETXNCHRG.CrncyCode1 = CUST.CIETXNCHRG.chargeCrncy
		#print(CUST.CIETXNCHRG.CrncyCode1)
		print(MTT.ChargeDetails.ChrgInpAmount)
		print(MTT.ChargeDetails.PartyAccount)
		
		sv_a = urhk_MTTS_InitPtt("")
		print(sv_a)
		
		print(MTT.ChargeDetails.MultipleCrncyChrg)
		
		sv_u = urhk_MTTS_GetPttRec("")
		print(sv_u)
		
		MTT.PartTranDetails.TranIdentifier = CUST.CIETXNCHRG.tran_identifier
		print(MTT.PartTranDetails.TranIdentifier)
		IF ((BANCS.STDIN.contextBankId != "11") AND (BANCS.STDIN.contextBankId != "54")) THEN
		#{
			IF ((CUST.CIETXN.txnType == "CD") AND (CUST.CIETXN.refCrncy=="KES")) THEN
			#{
				print(CUST.CIETXN.chargeAmt)
				MTT.PartTranDetails.Amount = CUST.CIETXN.chargeAmt
				PRINT(MTT.PartTranDetails.Amount)
			else
				
				print(CUST.CIETXN.chargeAmt)
				MTT.PartTranDetails.Amount = CUST.CIETXN.chargeAmt
				PRINT(MTT.PartTranDetails.Amount)

			#}
			ENDIF
		#}
		ENDIF
		MTT.PartTranDetails.Amount = CUST.CIETXNCHRG.Charge
		print(MTT.PartTranDetails.Amount)
		print(MTT.PartTranDetails.Account)
		MTT.ChargeDetails.CollectionCrncy = CUST.CIETXNCHRG.CrncyCode1
		IF ((MTT.ChargeDetails.CollectionCrncy == "USD" ) OR (MTT.ChargeDetails.CollectionCrncy == "EUR" ) OR (MTT.ChargeDetails.CollectionCrncy == "GBP" ))THEN
			CUST.CIETXNCHRG.Rate_Code = "CNB"
		ELSE
			CUST.CIETXNCHRG.Rate_Code = "CNS"
		ENDIF
		MTT.ChargeDetails.RateCode1 = CUST.CIETXNCHRG.Rate_Code
		print(MTT.ChargeDetails.RateCode1)
		CUST.CIETXNCHRG.rate  = "1"
		MTT.PartTranDetails.Rate = CUST.CIETXNCHRG.rate

		IF ((CUST.CIETXNCHRG.CrncyCode1 == "USD") OR (CUST.CIETXNCHRG.CrncyCode1 == "GBP") OR (CUST.CIETXNCHRG.CrncyCode1 == "EUR")) THEN

			sv_k = "RateAmt |select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id = ?SVAR and ratecode = ?SVAR "
			sv_k = sv_k + "and FXD_CRNCY_CODE = ?SVAR and VAR_CRNCY_CODE= ?SVAR "
			PRINT (sv_k)
			BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId + "|" + MTT.ChargeDetails.RateCode1 + "|" + CUST.CIETXNCHRG.CrncyCode1 +"|" + BANCS.STDIN.homeCrncyCode
			print(BANCS.INPARAM.BINDVARS)
			sv_y = urhk_DBSelectWithBind(sv_k)
			PRINT(sv_y)
			IF (sv_y != 0) THEN
			#{
				print("Cannot delive to the Exchange Rate")
				CUST.CIETXNCHRG.errorFlg = "Y"
				GOTO FINISH
				#}
			ELSE
				#{
				MTT.PartTranDetails.Rate = BANCS.OUTPARAM.RateAmt
				print(MTT.PartTranDetails.Rate)

			#}
			ENDIF
		ENDIF
		print(MTT.ChargeDetails.CollectionCrncy)
		PRINT(MTT.ChargeDetails.RateCode1)
		print(MTT.PartTranDetails.Rate)
		MTT.PartTranDetails.Amount = MTT.PartTranDetails.Amount
		
		CUST.CIETXNCHRG.Charge = MTT.PartTranDetails.Amount

		CUST.CIETXNCHRG.chAcc = MTT.PartTranDetails.Account
		#CUST.CIETXNCHRG.chAcc = BANCS.OUTPARAM.acct_num
		
		print(CUST.CIETXNCHRG.chAcc)
		
		CUST.CIETXNCHRG.refCrncy = CUST.CIETXNCHRG.CrncyCode1
		print(CUST.CIETXNCHRG.refCrncy)
		
		MTT.PartTranDetails.RefCurrency = CUST.CIETXNCHRG.CrncyCode1
		print(MTT.PartTranDetails.RefCurrency)
		MTT.PartTranDetails.TranCurrency = CUST.CIETXNCHRG.crncyCode
		CUST.CIETXNCHRG.refCrncy = CUST.CIETXNCHRG.CrncyCode1
		CUST.CIETXNCHRG.rateCode = CUST.CIETXNCHRG.Rate_Code
		CUST.CIETXNCHRG.chRate = MTT.PartTranDetails.Rate
		print(CUST.CIETXNCHRG.chRate)
		MTT.PartTranDetails.RefAmount = MTT.PartTranDetails.Amount
		print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.RateCode = CUST.CIETXNCHRG.Rate_Code
		print(MTT.PartTranDetails.RateCode)
		sv_a = urhk_MTTS_DefineChargePartTran("CREDIT")
		print(sv_a)
		
		
		
		
		IF (sv_a != 0) THEN
		#{
			# changed by karthik for NAJAH00007489 #
			IF (FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.CIETXNCHRG.MTTErrMsg = MTT.Error.Description
				#}
			ELSE
				#{
				CUST.CIETXNCHRG.MTTErrMsg = "Could not define part Transaction"
				MTT.Error.Description = CUST.CIETXNCHRG.MTTErrMsg
			#}
			ENDIF
			#}
		ENDIF

		IF ((BANCS.STDIN.contextBankId != "11") AND (BANCS.STDIN.contextBankId != "54")) THEN
		#{
			IF ((CUST.CIETXN.txnType == "CD") AND (CUST.CIETXN.refCrncy=="KES")) THEN
			#{
				print(CUST.CIETXN.chargeAmt)
				CUST.CIETXNCHRG.Charge = CUST.CIETXN.chargeAmt
				PRINT(CUST.CIETXNCHRG.Charge)
			#}
			ENDIF
		#}
		ENDIF
			
		Print (CUST.CIETXNCHRG.Charge)
		print (CUST.CIETXNCHRG.Charge)
		Print (CUST.CIETXNCHRG.ph1)
		Print (CUST.CIETXNCHRG.refCrncy)
		
		MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.CIETXNCHRG.Charge)
		#MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.CIETXNCHRG.totChargeAmt)
		MTT.PartTranDetails.Amount = -CDOUBLE(CUST.CIETXNCHRG.Charge)
		#MTT.PartTranDetails.Amount = -CDOUBLE(CUST.CIETXNCHRG.totChargeAmt)
		print(MTT.PartTranDetails.RefAmount)
		print(MTT.PartTranDetails.Amount)
		#MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.CIETXNCHRG.Charge)
		#MTT.PartTranDetails.Amount = -CDOUBLE(CUST.CIETXNCHRG.Charge)
		MTT.PartTranDetails.Account = CUST.CIETXNCHRG.ph1
		MTT.PartTranDetails.RefCurrency = CUST.CIETXNCHRG.refCrncy
		MTT.PartTranDetails.TranCurrency = CUST.CIETXNCHRG.refCrncy
		
		MTT.PartTranDetails.RateCode = CUST.CIETXNCHRG.rateCode
		print(MTT.PartTranDetails.RateCode)
		MTT.PartTranDetails.Rate = CUST.CIETXNCHRG.chRate
		#MTT.PartTranDetails.Rate	= "0"
		
		MTT.PartTranDetails.CarveAmtFlg = "Y"
		MTT.PartTranDetails.Refnum = ""
		MTT.PartTranDetails.Remarks = "INTERFXCHRG"
		MTT.PartTranDetails.Particulars = "INTERFXCHRG"
		MTT.PartTranDetails.ParticularsCode = ""
		MTT.PartTranDetails.TranIdentifier = CUST.CIETXNCHRG.tran_identifier
		print(MTT.PartTranDetails.TranIdentifier)
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.TODRefType = "IC"
		MTT.PartTranDetails.ValueDateDiff = "0"
		MTT.PartTranDetails.ValueDate = "0"
		#MTT.PartTranDetails.PTranBusinessType = "CREDIT"
		MTT.PartTranDetails.Consolidate = "N"
		
		sv_r = urhk_MTTS_DefinePartTran("DEBIT")
		print(sv_r)
		IF (sv_r != 0) THEN
		#{
			IF (FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.CIETXNCHRG.MTTErrMsg = MTT.Error.Description
				#}
			ELSE
				#{
				CUST.CIETXNCHRG.MTTErrMsg = "Could not define part Transaction"
				MTT.Error.Description = CUST.CIETXNCHRG.MTTErrMsg
			#}
			ENDIF
			#IF(CUST.CIETXNCHRG.MTTErrMsg == "") THEN
			#	MTT.Error.Description = "Could not define part Transaction"
			#	CUST.CIETXNCHRG.MTTErrMsg = MTT.Error.Description
			#ELSE
			#	MTT.Error.Description =  CUST.CIETXNCHRG.MTTErrMsg
			#ENDIF
			#print(MTT.Error.Description)
		#}
		ENDIF
		
	#}
	ENDIF
		
	#-------------------------------------------------------------------------------------
	# CLOSE THE TRANSACTION
	#-------------------------------------------------------------------------------------
	sv_r = urhk_MTTS_EndDefinition("")
	print(sv_r)
	
	#print(sv_b)
	sv_b = urhk_B2k_PrintRepos("MTT")
	print(sv_b)
	sv_b = urhk_B2k_PrintRepos("BANCS")
	print(sv_b)
	
	
	IF (sv_r == 1) THEN
	#{
		IF (FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
			CUST.CIETXNCHRG.MTTErrMsg = MTT.Error.Description
			#}
		ELSE
			#{
			CUST.CIETXNCHRG.MTTErrMsg = "Could not create end definition"
			MTT.Error.Description = CUST.CIETXNCHRG.MTTErrMsg
		#}
		ENDIF
		sv_r = urhk_MTTS_ReportErrorCondition("")
		print(sv_r)
		#CUST.CIETXNCHRG.MTTErrMsg = MTT.Error.Description
		CUST.CIETXNCHRG.SuccessOrFailure = "Failure"
		CUST.CIETXNCHRG.Details = "Transaction generation failed"
		CUST.CIETXNCHRG.tranId = ""
		#}
	ELSE
		#{
		PRINT(MTT.XCPN.NumExceptions)
		CUST.CIETXNCHRG.NumExceptions = MTT.XCPN.NumExceptions
		IF (CUST.CIETXNCHRG.NumExceptions == "0") THEN
		#{
			sv_b = urhk_MTTS_HandleExceptions("ENTRY")
			#CUST.CIETXNCHRG.EVENT = "DX"
			#}
		ELSE
			#{
			sv_b = urhk_MTTS_HandleExceptions("ENTRY")
			#CUST.CIETXNCHRG.EVENT = "DX"
			
		#}
		ENDIF
	#}
	ENDIF
	sv_r = urhk_B2k_PrintRepos("MTT")
	print(sv_r)
	
	
	sv_u = urhk_MTTS_Close("")
	print(sv_u)
	#sv_b = urhk_MTTS_HandleExceptions("POST")
	#print(sv_b)
	
	sv_r = urhk_B2k_PrintRepos("MTT")
	print(sv_r)
	
	IF (BANCS.OUTPARAM.MTTPostingStatus == "S") THEN
	#{
		PRINT(BANCS.OUTPARAM.MTTTranId)
		CUST.CIETXNCHRG.tranId = BANCS.OUTPARAM.MTTTranId
		CUST.CIETXN.entity2TranId1 = CUST.CIETXNCHRG.tranId
		PRINT(CUST.CIETXN.entity2TranId1) 
