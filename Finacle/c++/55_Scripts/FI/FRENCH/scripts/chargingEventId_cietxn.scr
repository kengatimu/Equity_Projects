		#{
			CUST.CIETXNCHRG.SuccessOrFailure = "Success"
			CUST.CIETXNCHRG.Details = "&nbsp;<B><font color=red>Transaction Posted:" + BANCS.OUTPARAM.MTTTranId + "<BR>&nbsp;" + BANCS.OUTPARAM.MTTPostingError + "</font></B><BR>"
			#}
		ELSE
			#{
			CUST.CIETXNCHRG.SuccessOrFailure = "Failure"
			CUST.CIETXNCHRG.Details = "&nbsp;<B><font color=red>Exceptions encountered.<BR>&nbsp;Transaction in entered status:" + BANCS.OUTPARAM.MTTTranId + "<BR>&nbsp;" + BANCS.OUTPARAM.MTTPostingError + "</font></B><BR>"
		#}
		ENDIF
		PRINT(CUST.CIETXNCHRG.Details)
		#}
	ELSE
		#{
		CUST.CIETXNCHRG.tranId = ""
		CUST.CIETXNCHRG.SuccessOrFailure = "Failure"
		CUST.CIETXNCHRG.Details = "Transaction Failed"
