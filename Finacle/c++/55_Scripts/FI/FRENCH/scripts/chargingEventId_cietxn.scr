	PRINT(CUST.CIETXNCHRG.sol_id)
	print(CUST.CIETXNCHRG.crncyCode)
	print(CUST.CIETXNCHRG.bank_id)
	print(CUST.CIETXNCHRG.chargeTranId)
	
	
	#------------------------------------------------------------------------------------------------------------------------------
	# get the Teller cash account for the sol
	#------------------------------------------------------------------------------------------------------------------------------
	
	sv_l = "acct_num,teller_id|SELECT FORACID,B.EMP_ID FROM TBAADM.GAM A,TBAADM.GEC  B "
	sv_l = sv_l + " WHERE B.EMP_ID = ?SVAR "
	sv_l = sv_l + " AND A.SOL_ID = ?SVAR "
	sv_l = sv_l + " AND B.CRNCY_CODE  = ?SVAR "
	sv_l = sv_l + " AND A.BANK_ID = ?SVAR "
	sv_l = sv_l + " AND BACID  =  EMP_CASH_ACCT "
	sv_l = sv_l + " AND ACCT_CRNCY_CODE  = B.CRNCY_CODE "
	sv_l = sv_l + " AND A.SOL_ID  = B.SOL_ID "
	sv_l = sv_l + " AND A.BANK_ID  = B.BANK_ID "
	sv_l = sv_l + " AND A.ENTITY_CRE_FLG = 'Y' "
	sv_l = sv_l + " AND A.DEL_FLG  = 'N' "
	sv_l = sv_l + " AND A.ACCT_CLS_FLG  = 'N' "
	
	
	
	BANCS.INPARAM.BINDVARS= BANCS.STDIN.EmployeeId + "|" + BANCS.STDIN.mySolId + "|" + CUST.CIETXNCHRG.chargeCrncy +"|" + CUST.CIETXNCHRG.bank_id
	print(BANCS.INPARAM.BINDVARS)
	sv_x = urhk_DBSelectWithBind(sv_l)
	PRINT(sv_x)
	IF (sv_x != 0) THEN
	#{
		print("charge collection failed no teller id for this User id")
		CUST.CIETXNCHRG.errorFlg = "Y"
		GOTO FINISH
		#}
	ELSE
		#{
		CUST.CIETXNCHRG.ph1 = BANCS.OUTPARAM.acct_num
		CUST.CIETXNCHRG.teller_id = BANCS.OUTPARAM.teller_id
		print(CUST.CIETXNCHRG.ph1)
		
	#}
	ENDIF
	
	
	
	
	#-----------------------------------------------------------------------------------
	# DEFINE TRANSACTION
	#-----------------------------------------------------------------------------------
	
	MTT.TranDetails.TranDate = "0"
	MTT.TranDetails.TranType = "C"
	MTT.TranDetails.TranSubType = "CR"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Remarks = "CURRENCY EXCHANGE"
	MTT.TranDetails.PostFlag = "Y"
	MTT.TranDetails.CommitFlag = "N"
