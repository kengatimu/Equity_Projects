<--START
CHECKSUM="b0d1cb2bb0509cb549300450d239858ea15fc02f239dcecc81d0f10f0de98b70"
	TRACE ON
	
	sv_q = urhk_B2k_PrintRepos("BANCS")
	print(sv_q)
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CIETXNCHRG") == 0) THEN
