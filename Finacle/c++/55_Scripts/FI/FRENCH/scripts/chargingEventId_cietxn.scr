	CUST.CIETXNCHRG.chargeTranId= ""
	CUST.CIETXNCHRG.Rate_Code="CNB"
	CUST.CIETXNCHRG.Charge = CUST.CIETXN.chargeAmt
	print(CUST.CIETXNCHRG.Charge)
	
	
	IF(FIELDEXISTS(CUST.CIETXN.chargeRateCode))THEN
	#{
		IF(TRIM(CUST.CIETXN.chargeRateCode) != "")THEN
		#{
			CUST.CIETXNCHRG.Rate_Code = CUST.CIETXN.chargeRateCode
			print(CUST.CIETXNCHRG.Rate_Code)
		#}
		ENDIF
	#}
	ENDIF

	IF(FIELDEXISTS(CUST.CIETXN.refCrncy))THEN
	#{
		IF(TRIM(CUST.CIETXN.refCrncy) != "")THEN
		#{
			CUST.CIETXNCHRG.chargeCrncy = CUST.CIETXN.refCrncy
			print(CUST.CIETXNCHRG.chargeCrncy)
		else
			CUST.CIETXNCHRG.chargeCrncy = BANCS.STDIN.homeCrncyCode
			print(CUST.CIETXNCHRG.chargeCrncy)
		
		#}
		ENDIF
	else
		CUST.CIETXNCHRG.chargeCrncy = BANCS.STDIN.homeCrncyCode
		print(CUST.CIETXNCHRG.chargeCrncy)
	#}
	ENDIF


	
	
	print(CUST.CIETXNCHRG.ChrgEvntId)
	print(CUST.CIETXNCHRG.chrgAmount)
