	# SEND MESSAGE TO JSP
	#--------------------------------------------------------------------------------------
	
	sv_u = urhk_setOrbOut("Message|" + CUST.CIETXNCHRG.SuccessOrFailure)
	print(sv_u)
	sv_u = urhk_setOrbOut("Details|" + CUST.CIETXNCHRG.Details)
	print(sv_u)
	
	#------------------------------------------------------------------------------------------------------
	# Denom ADD
	#------------------------------------------------------------------------------------------------------
	
	IF (CUST.CIETXNCHRG.tranId== "") THEN
	#{
		print("Charge collection failed")
		CUST.CIETXNCHRG.errorFlg = "Y"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS=CUST.CIETXNCHRG.CrncyCode1 +"|"+CUST.CIETXNCHRG.teller_id+"|"+CUST.CIETXNCHRG.sol_id+"|"+ CUST.CIETXNCHRG.bank_id
	print(BANCS.INPARAM.BINDVARS)
	sv_l = "cnt|SELECT COUNT(*) "
	sv_l = sv_l + "FROM c_denm "
	sv_l = sv_l + "WHERE del_flg = 'N' "
	sv_l = sv_l + "AND crncy_code = ?SVAR "
	sv_l = sv_l + "AND teller_id = ?SVAR "
	sv_l = sv_l + "AND SOL_ID = ?SVAR "
	sv_l = sv_l + "AND denom_ind = 'N' "
	sv_l = sv_l + "AND bank_id = ?SVAR "
	PRINT(sv_l)
	
	sv_x = urhk_DBSelectWithBind(sv_l)
	PRINT(sv_x)
