		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		
		IF(sv_d==0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			sv_g = "RESULT_MSG|Set No :"+ CUST.DATA.setNo+" is verifyied."
			sv_z = urhk_SetOrbOut(sv_g)
			#}
		ELSE
			#{
			sv_g = "RESULT_MSG|Set No :"+ CUST.DATA.setNo+" could not be verified."
			sv_z = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
		
		sv_g = "RESULT_MSG|Set No :"+ CUST.DATA.setNo+" is Deleted."
		sv_z = urhk_SetOrbOut(sv_g)
		GOTO FINISH
	#}
	ENDIF
	
	sv_s = "count|SELECT count(*)"
	sv_s = sv_s + " FROM TBAADM.ICI "
	sv_s = sv_s + " WHERE inst_num = LPAD(?SVAR,16) "
	sv_s = sv_s + " AND zone_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
	sv_s = sv_s + " AND zone_code = ?SVAR "
	sv_s = sv_s + " AND sol_id = ?SVAR "
	sv_s = sv_s + " AND inst_amt = ?SVAR "
	sv_s = sv_s + " AND value_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND drawee_bank_code = ?SVAR "
	sv_s = sv_s + " AND drawee_br_code = ?SVAR "
	sv_s = sv_s + " AND drawee_sort_code = ?SVAR "
	sv_s = sv_s + " AND acid =(SELECT acid FROM TBAADM.GAM WHERE foracid=?SVAR "
	sv_s = sv_s + " AND entity_cre_flg = 'Y' "
	sv_s = sv_s + " AND del_flg = 'N') "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.instNo + "|" + CUST.DATA.zoneDate + "|" + CUST.DATA.zoneCode + "|" + CUST.DATA.solId + "|" + CUST.DATA.instAmt + "|" + CUST.DATA.valueDate + "|" + CUST.DATA.draweeBankCode + "|" + CUST.DATA.draweeBrCode + "|" + CUST.DATA.draweeSortCode + "|" + CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d==0) THEN
	#{
		CUST.DATA.count = BANCS.OUTPARAM.count
		print(CUST.DATA.count)
	#}
	ENDIF
	
	IF (CUST.DATA.count == 0) THEN
	#{
		CUST.DATA.Msg = "No Record found in ICI table."
		GOTO FINISH
	#}
	ENDIF
	
	IF (CINT(CUST.DATA.count)>1) THEN
	#{
		CUST.DATA.Msg = "More than one record found."
		GOTO FINISH
	#}
	ENDIF
	
	sv_s = "zoneSrlNum,acid|SELECT zone_srl_num,acid "
	sv_s = sv_s + " FROM TBAADM.ICI "
	sv_s = sv_s + " WHERE inst_num =LPAD(?SVAR,16) "
	sv_s = sv_s + " AND zone_date=TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND zone_code=?SVAR "
	sv_s = sv_s + " AND sol_id=?SVAR "
	sv_s = sv_s + " AND inst_amt=?SVAR "
	sv_s = sv_s + " AND value_date=TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND drawee_bank_code=?SVAR "
	sv_s = sv_s + " AND drawee_br_code=?SVAR "
	sv_s = sv_s + " AND drawee_sort_code=?SVAR "
	sv_s = sv_s + " AND acid =(SELECT acid FROM TBAADM.GAM WHERE foracid=?SVAR "
	sv_s = sv_s + " AND entity_cre_flg = 'Y' "
	sv_s = sv_s + " AND GAM.bank_id = ICI.bank_id "
	sv_s = sv_s + " AND del_flg = 'N') "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.instNo + "|" + CUST.DATA.zoneDate + "|" + CUST.DATA.zoneCode + "|" + CUST.DATA.solId + "|" + CUST.DATA.instAmt + "|" + CUST.DATA.valueDate + "|" + CUST.DATA.draweeBankCode + "|" + CUST.DATA.draweeBrCode + "|" + CUST.DATA.draweeSortCode + "|" + CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d==0) THEN
	#{
		CUST.DATA.zoneSrlNum = BANCS.OUTPARAM.zoneSrlNum
		print(CUST.DATA.zoneSrlNum)
		CUST.DATA.acid= BANCS.OUTPARAM.acid
		print(CUST.DATA.acid)
	#}
	ENDIF
	
	IF (CUST.DATA.funcCode=="V") THEN
	#{
		#---------------------------------------------------
		#Update ICI table
		#--------------------------------------------------
		#sv_s = "zoneDateD,valueDateD|select "
		#sv_s = sv_s + " TO_DATE(?SVAR,'DD-MM-YYYY'),"
		#sv_s = sv_s + " TO_DATE(?SVAR,'DD-MM-YYYY') from dual"
		#print(sv_s)
		#BANCS.INPARAM.BINDVARS =CUST.DATA.zoneDate + "|" + CUST.DATA.valueDate
		#PRINT(BANCS.INPARAM.BINDVARS)
		#sv_d = urhk_dbSelectWithBind(sv_s)
		#print(sv_d)
		
		#IF (sv_d==0) THEN
		#{
		#CUST.DATA.zoneDateD= BANCS.OUTPARAM.zoneDateD
		#CUST.DATA.valueDateD= BANCS.OUTPARAM.valueDateD
		#print(CUST.DATA.zoneDate)
		#print(CUST.DATA.valueDate)
		#}
		#ENDIF
		
		sv_s = "count|SELECT count(*)"
		sv_s = sv_s + " FROM TBAADM.ICI "
		sv_s = sv_s + " WHERE inst_num = LPAD(?SVAR,16) "
		sv_s = sv_s + " AND zone_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " AND zone_code = ?SVAR "
		sv_s = sv_s + " AND sol_id = ?SVAR "
		sv_s = sv_s + " AND inst_amt = ?SVAR "
		sv_s = sv_s + " AND value_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND drawee_bank_code = ?SVAR "
		sv_s = sv_s + " AND drawee_br_code = ?SVAR "
		sv_s = sv_s + " AND drawee_sort_code = ?SVAR "
		sv_s = sv_s + " AND acid =(SELECT acid FROM TBAADM.GAM WHERE foracid=?SVAR "
		sv_s = sv_s + " AND GAM.bank_id = ICI.bank_id "
		sv_s = sv_s + " AND entity_cre_flg = 'Y' "
		sv_s = sv_s + " AND del_flg = 'N') "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.instNo + "|" + CUST.DATA.zoneDate + "|" + CUST.DATA.zoneCode + "|" + CUST.DATA.solId + "|" + CUST.DATA.instAmt + "|" + CUST.DATA.valueDate + "|" + CUST.DATA.draweeBankCode + "|" + CUST.DATA.draweeBrCode + "|" + CUST.DATA.draweeSortCode + "|" + CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d==0) THEN
		#{
			CUST.DATA.count = BANCS.OUTPARAM.count
			print(CUST.DATA.count)
		#}
		ENDIF
		
		IF (CUST.DATA.count == 0) THEN
		#{
			CUST.DATA.Msg = "No Record found in ICI table."
			GOTO FINISH
		#}
		ENDIF
		
		IF (CINT(CUST.DATA.count)>1) THEN
		#{
			CUST.DATA.Msg = "More than one record found."
			GOTO FINISH
		#}
		ENDIF
		
		#---------------------------------------
		# Inward Reject Charge Collection based on reject code
		#---------------------------------------
		BANCS.INPUT.moduleName = "CLEARING"
		BANCS.INPUT.parameterId = "RJCODE"
		CALL("getcparamvalue.scr")
		
		IF (BANCS.OUTPUT.parameterVal != "")THEN
		#{
			print(BANCS.OUTPUT.parameterVal)
			CUST.DATA.rjCode =BANCS.OUTPUT.parameterVal
			print(CUST.DATA.rjCode)
			#}
		ELSE
			#{
			CUST.DATA.rjCode = ""
		#}
		ENDIF
		
		IF (CUST.DATA.rejCode == CUST.DATA.rjCode) THEN
		#{
			BANCS.INPUT.moduleName = "CLEARING"
			BANCS.INPUT.parameterId = "EVTAMT1"
			CALL ("getcparamvalue.scr")
			
			IF (BANCS.OUTPUT.parameterVal != "")THEN
			#{
				print(BANCS.OUTPUT.parameterVal)
				CUST.DATA.evtAmt =BANCS.OUTPUT.parameterVal
				print(CUST.DATA.evtAmt)
				#}
			ELSE
				#{
				CUST.DATA.Msg = "Parameter value not set in C_CPARAM"
				GOTO FINISH
			#}
			ENDIF
			#}
		ELSE
			#{
			BANCS.INPUT.moduleName = "CLEARING"
			BANCS.INPUT.parameterId = "EVTAMT2"
			
			CALL ("getcparamvalue.scr")
			IF (BANCS.OUTPUT.parameterVal != "")THEN
			#{
				print(BANCS.OUTPUT.parameterVal)
				CUST.DATA.evtAmt =BANCS.OUTPUT.parameterVal
				print(CUST.DATA.evtAmt)
				#}
			ELSE
				#{
				CUST.DATA.Msg = "Parameter value not set in C_CPARAM"
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		#----------------------------------------------
		#TRAN
		#-----------------------------------------------
		CUST.DATA.custForacid=CUST.DATA.foracid
		
		BANCS.INPUT.moduleName = "CLEARING"
		BANCS.INPUT.parameterId = "ICLGREJVERIFY"
		
		CALL ("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "")THEN
		#{
			print(BANCS.OUTPUT.parameterVal)
			CUST.DATA.AcctId_bacid=BANCS.OUTPUT.parameterVal
			#}
		ELSE
			#{
			CUST.DATA.Msg = "Parameter value not set in C_CPARAM"
			GOTO FINISH
		#}
		ENDIF
		
		BANCS.INPUT.moduleName = "GENERAL"
		BANCS.INPUT.parameterId = "NORRATECODE"
		
		CALL ("getcparamvalue.scr")
		print(BANCS.OUTPUT.parameterVal)
		
		IF (BANCS.OUTPUT.parameterVal != "")THEN
		#{
			CUST.DATA.refCode = BANCS.OUTPUT.parameterVal
			print(CUST.DATA.refCode)
		#}
		ENDIF
		
		sv_s = "INSERT into CUSTOM.CUST_INWREM_TABLE values ("
		sv_s = sv_s + "?SVAR, ?SVAR, ?SVAR, to_date(?SVAR,'dd-mm-yyyy'), ?SVAR, ?SVAR, LPAD(?SVAR,16), ?SVAR, ?SVAR, ?SVAR, ?SVAR, sysdate, ?SVAR)"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.acid + "|" + CUST.DATA.foracid + "|" + CUST.DATA.zoneCode + "|" + CUST.DATA.zoneDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.solId + "|" + CUST.DATA.zoneSrlNum + "|" + CUST.DATA.instNo
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.instAmt + "|" + "I" + "|" + CUST.DATA.rejCode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		sv_d = urhk_dbSQLWithBind("COMMIT")
		print(sv_d)
		#-------------------------------------------------------
		sv_u = 0
		#--------------------------------------------------------------------------------------------------------------
		# Printing the errors
		#--------------------------------------------------------------------------------------------------------------
		IF (sv_u != 0) THEN
		#{
			print("Error")
			sv_k = BANCS.OUTPARAM.Error_num
			print (sv_k)
			IF (sv_k > 0) THEN
			#{
				sv_l = 1
				sv_p = FORMAT$(sv_l,"%d")
				CUST.DATA.ErrMsg = ("BANCS").("OUTPARAM").("ErrorMesg_"+ sv_p)
				print(CUST.DATA.ErrMsg)
				CUST.DATA.ErrCode = ("BANCS").("OUTPARAM").("ErrorCode_"+ sv_p)
				print(CUST.DATA.ErrCode)
				CUST.DATA.Tag = ("BANCS").("OUTPARAM").("Tag_"+ sv_p)
				print(CUST.DATA.Tag)
				CUST.DATA.successFailure = "F"
				
				#sv_g = "RESULT_MSG|ICI table not updated"
				#sv_z = urhk_SetOrbOut(sv_g)
				
				sv_e = CUST.DATA.ErrMsg
				sv_m = "count"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			#}
			ENDIF
			#}
		ELSE
			#{
			
			#------------------------------------------------------------------
			# foracid for the bacid
			#------------------------------------------------------------------
			
			sv_i = CUST.DATA.AcctId_bacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
			sv_u = urhk_B2k_BacidToAcctId(sv_i)
			IF (sv_u == 1 ) THEN
			#{
				sv_g = "RESULT_MSG|Place Holder < PNLCHQUN > not present"
				sv_u = urhk_SetOrbOut(sv_g)
				GOTO FINISH
			#}
			ENDIF
			
			CUST.DATA.incomeForacid = BANCS.OUTPARAM.AcctId
			print(CUST.DATA.incomeForacid)
			CUST.DATA.BODDate=BANCS.STDIN.BODDate
			print(CUST.DATA.BODDate)
			#---------------------------------------------------------------
			# Passing transaction inputs to the service
			# Adding and Posting the transaction
			#---------------------------------------------------------------
			CUST.DATA.naration1="Inward Clearing Reject charge"
			CUST.DATA.naration2="Inward Clearing Charges"
			sv_l=CUST.DATA.evtAmt
			sv_m=CUST.DATA.evtAmt
			
			sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+CUST.DATA.BODDate)
			sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
			sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
			sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.DATA.tranRmks)
			sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
			sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
			
			#--------------------------------------------------
			# Credit
			#--------------------------------------------------
			CUST.DATA.cshAmt = sv_l
			sv_w = "tranDtl.partTranDetailLL.<rec_0>."
			sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|1")
			sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+CUST.DATA.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|C")
			sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.DATA.incomeForacid)
			sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.DATA.naration1)
			sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
			sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
			sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.DATA.cshAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.DATA.cshAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.DATA.refCode)
			print(sv_u)
			#-------------------
			#Debit
			#----------------------
			CUST.DATA.chargeAmt=sv_m
			sv_w = "tranDtl.partTranDetailLL.<rec_1>."
			sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|2")
			sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+CUST.DATA.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|D")
			sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.DATA.custForacid)
			sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.DATA.naration2)
			sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
			sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
			sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.DATA.chargeAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.DATA.chargeAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.DATA.chargeAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.DATA.refCode)
			print(sv_l)
			#---------------------
			#tran id
			#-----------------------
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
			print(sv_u)
			
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
				print(sv_u)
			#}
			ENDIF
			
			IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
			#{
				print(BANCS.OUTPARAM.tranId)
			#}
			ENDIF
			
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
				print(sv_u)
				IF (sv_u == 0) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
					print(sv_u)
					IF (sv_u != 0) THEN
					#{
						sv_u = urhk_CopyOutToIn("")
						sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
						print(sv_u)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				
				IF (sv_v > 0) THEN
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			#----------------------------------------------
			#Rev TRAN
			#-----------------------------------------------
			CUST.DATA.custForacid=CUST.DATA.foracid
			print(CUST.DATA.foracid)
			BANCS.INPUT.moduleName = "CLEARING"
			BANCS.INPUT.parameterId = "ICLGREJVERIFY1"
			
			CALL ("getcparamvalue.scr")
			IF (BANCS.OUTPUT.parameterVal != "")THEN
			#{
				print(BANCS.OUTPUT.parameterVal)
				CUST.DATA.AcctId_bacid=BANCS.OUTPUT.parameterVal
				#}
			ELSE
				#{
				sv_g = "RESULT_MSG|Parameter value not set in C_CPARAM"
				sv_z = urhk_SetOrbOut(sv_g)
			#}
			ENDIF
			
			CUST.DATA.naration1="Inward Clearing Reject charge"
			CUST.DATA.naration2="Inward Clearing Charges"
			sv_l=CUST.DATA.evtAmt
			sv_m=CUST.DATA.evtAmt
			
			BANCS.INPUT.moduleName = "GENERAL"
			BANCS.INPUT.parameterId = "NORRATECODE"
			
			CALL ("getcparamvalue.scr")
			print(BANCS.OUTPUT.parameterVal)
			
			IF (BANCS.OUTPUT.parameterVal != "")THEN
			#{
				CUST.DATA.refCode = BANCS.OUTPUT.parameterVal
				print(CUST.DATA.refCode)
				#}
			ELSE
				#{
				CUST.DATA.refCode = ""
			#}
			ENDIF
			#------------------------------------------------------------------
			# Foracid for bacid
			#------------------------------------------------------------------
			
			sv_i = CUST.DATA.AcctId_bacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
			sv_u = urhk_B2k_BacidToAcctId(sv_i)
			IF (sv_u == 1 ) THEN
			#{
				sv_g = "RESULT_MSG|Place Holder < BRCLG > not present"
				sv_u = urhk_SetOrbOut(sv_g)
				GOTO FINISH
			#}
			ENDIF
			CUST.DATA.clgForacid = BANCS.OUTPARAM.AcctId
			print(CUST.DATA.clgForacid)
			CUST.DATA.BODDate=BANCS.STDIN.BODDate
			print(CUST.DATA.BODDate)
			#---------------------------------------------------------------
			# Passing transaction inputs to the service
			# Adding and Posting the transaction
			#---------------------------------------------------------------
			sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+CUST.DATA.BODDate)
			sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
			sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
			sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.DATA.tranRmks)
			sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
			sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
			
			#--------------------------------------------------
			# Credit
			#--------------------------------------------------
			CUST.DATA.cshAmt = sv_l
			sv_w = "tranDtl.partTranDetailLL.<rec_0>."
			sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|1")
			sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+CUST.DATA.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|C")
			sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.DATA.custForacid)
			sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.DATA.naration1)
			sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
			sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
			sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.DATA.cshAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.DATA.cshAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.DATA.refCode)
			print(sv_u)
			
			#-------------------
			#Debit
			#----------------------
			CUST.DATA.chargeAmt=sv_m
			sv_w = "tranDtl.partTranDetailLL.<rec_1>."
			sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|2")
			sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+CUST.DATA.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|D")
			sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.DATA.clgForacid)
			sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.DATA.naration2)
			sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
			sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
			sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.DATA.chargeAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.DATA.chargeAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.DATA.chargeAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.DATA.refCode)
			print(sv_l)
			#---------------------
			#tran id
			#-----------------------
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
			print(sv_u)
			
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
				print(sv_u)
			#}
			ENDIF
			
			IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
			#{
				print(BANCS.OUTPARAM.tranId)
			#}
			ENDIF
			
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
				print(sv_u)
				IF (sv_u == 0) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
					print(sv_u)
					IF (sv_u != 0) THEN
					#{
						sv_u = urhk_CopyOutToIn("")
						sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
						print(sv_u)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				
				IF (sv_v > 0) THEN
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			#--------------------------------------------------------------------
			#Updating the set Number in C_IRT table (entity_cre_flg='Y')
			#--------------------------------------------------------------------
			print(CUST.DATA.foracid)
			sv_s = "UPDATE custom.CUST_INW_REJECT_TABLE  SET entity_cre_flg='Y' "
			sv_s = sv_s + " WHERE sol_id = ?SVAR "
			sv_s = sv_s + " AND set_num = ?SVAR "
			sv_s = sv_s + " AND zone_code = ?SVAR "
			sv_s = sv_s + " AND zone_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
			sv_s = sv_s + " AND foracid = ?SVAR "
			sv_s = sv_s + " AND instno = ?SVAR "
			sv_s = sv_s + " AND instamt = ?SVAR "
			sv_s = sv_s + " AND value_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
			sv_s = sv_s + " AND drawee_bank_code = ?SVAR "
			sv_s = sv_s + " AND drawee_br_code = ?SVAR "
			sv_s = sv_s + " AND drawee_sort_code = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS=CUST.DATA.solId +"|"+ CUST.DATA.setNo +"|"+ CUST.DATA.zoneCode +"|"+ CUST.DATA.zoneDate +"|"+ CUST.DATA.foracid +"|"+ CUST.DATA.instNo +"|"+  CUST.DATA.instAmt +"|"+ CUST.DATA.valueDate +"|"+ CUST.DATA.draweeBankCode +"|"+ CUST.DATA.draweeBrCode +"|"+ CUST.DATA.draweeSortCode +"|"+ BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSQLWithBind(sv_s)
			
			IF(sv_d==0) THEN
			#{
				sv_d =  urhk_dbSQLWithBind("COMMIT")
				sv_g = "RESULT_MSG|Set No :"+ CUST.DATA.setNo+" is verified."
				sv_z = urhk_SetOrbOut(sv_g)
				#}
			ELSE
				#{
				sv_g = "RESULT_MSG|Set No :"+ CUST.DATA.setNo+" could not be verified."
				sv_z = urhk_SetOrbOut(sv_g)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	FINISH:
		IF(CUST.DATA.Msg != "") THEN
		#{
			sv_m = "ERROR"
			sv_s = "Error_0|ERROR:^"+ CUST.DATA.Msg +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		#}
		ENDIF
		EXITSCRIPT
		#TRACE OFF
END-->
