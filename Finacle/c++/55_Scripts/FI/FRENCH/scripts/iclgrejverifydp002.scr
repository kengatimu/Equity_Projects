	CUST.DATA.instAmt		= BANCS.INPUT.instAmt
	CUST.DATA.valueDate		= BANCS.INPUT.valueDate
	CUST.DATA.draweeBankCode= BANCS.INPUT.draweeBankCode
	CUST.DATA.draweeBrCode	= BANCS.INPUT.draweeBrCode
	CUST.DATA.draweeSortCode= BANCS.INPUT.draweeSortCode
