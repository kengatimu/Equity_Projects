	#sv_a = urhk_B2K_printRepos("BANCS")
	#print(sv_a)
	
	CUST.DATA.Msg = ""
	CUST.DATA.ErrMsg = ""
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	
	CUST.DATA.funcCode		= TRIM(BANCS.INPUT.funcCode,' ')
	CUST.DATA.setNo			= BANCS.INPUT.setNo
	CUST.DATA.rejCode		= BANCS.INPUT.rejCode
	CUST.DATA.solId			= BANCS.INPUT.solId
	CUST.DATA.setNo			= BANCS.INPUT.setNo
	CUST.DATA.zoneCode		= BANCS.INPUT.zoneCode
	CUST.DATA.zoneDate		= BANCS.INPUT.zoneDate
	CUST.DATA.foracid		= BANCS.INPUT.foracid
