	IF (CUST.DATA.funcCode=="X") THEN
	#{
		sv_s = "UPDATE CUSTOM.CUST_INW_REJECT_TABLE SET del_flg='Y' "
		sv_s = sv_s + " WHERE sol_id = ?SVAR "
		sv_s = sv_s + " AND set_num = ?SVAR "
