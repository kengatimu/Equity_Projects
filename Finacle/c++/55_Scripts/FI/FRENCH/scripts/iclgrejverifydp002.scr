		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND instno = ?SVAR "
		sv_s = sv_s + " AND instamt = ?SVAR "
		sv_s = sv_s + " AND value_date=TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " AND drawee_bank_code = ?SVAR "
		sv_s = sv_s + " AND drawee_br_code = ?SVAR "
		sv_s = sv_s + " AND drawee_sort_code = ?SVAR "
