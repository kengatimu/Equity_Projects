<--start
trace on
	


	
	IF(CUST.INTERFACE.srvErrFlg == "Y") THEN
	#{
		sv_c = BANCS.OUTPARAM.Error_num
		print(sv_c)
		sv_d = 1
		IF (sv_c > 0) THEN
		#{
			sv_d = FORMAT$(sv_d, "%d")
			print(("BANCS").("OUTPARAM").("ErrorCode_" + sv_d))
			print(("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d))
            print(("BANCS").("OUTPARAM").("Tag_" + sv_d))
			CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_d)
			CUST.INTERFACE.errorDesc = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d)
                        
		#}
		ELSE
		#{
			sv_n = 1
			sv_d = 1
			sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
			WHILE (sv_d <= sv_c)
			#{
					CUST.INTERFACE.srvErrorType = "X"
					sv_f = FORMAT$(sv_d,"%d")
					sv_e = ("BANCS").("OUTPARAM").("XcpnDesc_"+sv_f)
					print(sv_e)
					("CUST").("INTERFACE").("XcpnCode_" + sv_f) = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
					sv_e = ("CUST").("INTERFACE").("XcpnCode_" + sv_f)
                                        CUST.INTERFACE.errorCode="EXP"
                                        CUST.INTERFACE.errorDesc=sv_e
					print(sv_e)
					sv_d = sv_d + 1
					sv_n = sv_n + 1
			#}
			DO
			IF(FIELDEXISTS(BANCS.INPUT.srvcallmode))THEN
				print(BANCS.INPUT.srvcallmode)
			ENDIF

			print(BANCS.STDIN.moduleIdentity)
			IF(BANCS.STDIN.moduleIdentity == "BJMS") THEN
			#{
				sv_n = 1
				sv_d = 1
				CUST.INTERFACE.srvcallmode="E"
				print(CUST.INTERFACE.srvcallmode)
				WHILE(sv_d <= sv_c)
				#{
					IF(CUST.INTERFACE.srvcallmode == "E")THEN
					#{
						sv_f = FORMAT$(sv_d,"%d")
						sv_e = ("CUST").("INTERFACE").("XcpnCode_" + sv_f)
						print(sv_e)
							sv_s = sv_e  + "|N"
							print(sv_s)
							sv_u = urhk_putCustomException(sv_s)
							print(sv_u)
							
							#sv_u = urhk_B2k_PutUserException(sv_e)
							#sv_u =	urhk_OWCLG_RaiseException(sv_e)
							print(sv_u)
						        CUST.INTERFACE.errorCode=""
                                                        CUST.INTERFACE.errorDesc=""
					#}
					ELSE
					#{
							CUST.INTERFACE.srvErrorType = "X"
							CUST.INTERFACE.srvError = "Y"
							sv_b = "Unable to ignore Exception Code "+sv_e
							sv_g = "Error_" + FORMAT$(sv_n,"%d") + "|SRV ERROR^" + sv_b + "^prodCode"
							print(sv_g)
							sv_u = urhk_SetOrbOut(sv_g)
							print(sv_u)
					#}
					ENDIF
                    
					sv_d = sv_d + 1
					sv_n = sv_n + 1
                #}
                DO
			#}
			ENDIF
		#}
		ENDIF
	#}
	ELSE
	#{
		print(CUST.INTERFACE.errorCode)	
		CALL("Common_Interface_GetErrorDesc.scr")
	
	#}
	ENDIF

	IF(FIELDEXISTS(CUST.INTERFACE.errorCode) == 1)THEN
	#{

	IF((CUST.INTERFACE.errorCode != "") AND (CUST.INTERFACE.errorDesc != "")) THEN
	#{
		IF(CUST.INTERFACE.srvErrFlg == "Y") THEN
		#{
			sv_c = CUST.INTERFACE.errorCode + "^" + CUST.INTERFACE.errorDesc + "^BE" 
			#sv_u = urhk_SRV_SetErr(sv_c)	
			sv_u = urhk_SetOrbErr(sv_c)	
			print(sv_u)	
		#}
		ELSE
		#{	
			sv_c = CUST.INTERFACE.errorCode + "|" + CUST.INTERFACE.errorDesc	
			sv_u = urhk_SetOrbWarning(sv_c)
		#}
		ENDIF	
	#}
	ENDIF
	#}
	ENDIF
	
#trace off
end-->
