<--START
TRACE ON

	IF (REPEXISTS("CUST")==0)THEN
		CREATEREP("CUST")
	ENDIF
	IF(CLASSEXISTS("CUST","DATA")==0)then
		CREATECLASS("CUST","DATA",5)
	ENDIF

	#-----------------------------
	## Variable Intialization
	#-----------------------------
		CUST.DATA.errMsg   = ""
		#CUST.DATA.CrChargeAcct   = "0006500104658"
		#CUST.DATA.CrChargeBacid = "TODLACE"
		CUST.DATA.LaceCharge = ""
		
		

	#---------------------------------
      # Populate MTT details
      #---------------------------------

		sv_r = urhk_MTTS_PopulateInputDetails("")
		Print(sv_r)

		IF (sv_r != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
			EXITSCRIPT      
		#}
		ENDIF

	#---------------------------------
        #  Closing of MTT if it is opened
        #---------------------------------

		sv_g = urhk_MTTS_Close("")
		print(sv_g)
	
		IF (sv_g != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
			EXITSCRIPT
		#}
		ENDIF


	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="Y"
	BANCS.INPARAM.RestrictModifyInd="FOURTH_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"

	sv_r = urhk_MTTS_Initialize("")
	print(sv_r)
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
	MTT.TranDetails.Remarks = "ODASM Sweep Of Accounts"
     	 MTT.TranDetails.ValidationFlag = "Y"
      	MTT.TranDetails.PostTranFlg = "Y"
      	MTT.TranDetails.CheckExceptions = "Y"
      	MTT.TranDetails.PostFlag        = "Y"
      	MTT.TranDetails.CommitFlg       = "Y"
   	
	#----------------------------Getting Charge Account start--------------------------------#
	CUST.DATA.CrChargeBacid = "LACE_OD548"
	print(CUST.DATA.CrChargeBacid)

	sv_a = CUST.DATA.CrChargeBacid+"|"+BANCS.STDIN.homeCrncyCode+"|"+BANCS.STDIN.mySolId
	sv_k =  urhk_B2k_BacidToAcctId(sv_a)
	print(sv_k)
				
	IF(sv_k == 0)THEN
	#{
		CUST.DATA.CrChargeAcct = BANCS.OUTPARAM.AcctId
		PRINT(CUST.DATA.CrChargeAcct)
	#}
	ENDIF
	#----------------------	Getting Charge Account End-------------------------------------#

	########################################
	#Fetch Operative Account			##
	########################################
	sv_s = "Crforacid,AccontName,ClrAmt,SchmCode,CifId|"
	sv_s = sv_s + " select foracid,acct_name,clr_bal_amt, schm_code,cif_id from tbaadm.gam where schm_type in('SBA','CAA') "
	sv_s = sv_s + " and bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and clr_bal_amt <= 0.00 and cif_id in(select cif_id from tbaadm.gam "
	sv_s = sv_s + " where schm_code IN('ODASM','OD548')) "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	
	sv_e = urhk_dbcursorOpenWithBind(sv_s)
	print(sv_e)
	
	IF(sv_e == 0) THEN
		#{

		CUST.DATA.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(CUST.DATA.CURSOR_NUMBER)
		sv_c = urhk_dbCursorFetch(CUST.DATA.CURSOR_NUMBER)
		print(sv_c)
		BANCS.INPUT.RECCOUNT=cint("1")
		print(BANCS.INPUT.RECCOUNT)
		
		WHILE(sv_c == "0")
		#{


		CUST.DATA.ClrAmt = BANCS.OUTPARAM.ClrAmt
		PRINT(CUST.DATA.ClrAmt)
		CUST.DATA.Crforacid = BANCS.OUTPARAM.Crforacid
		PRINT(CUST.DATA.Crforacid)
		CUST.DATA.CifId = BANCS.OUTPARAM.CifId
		PRINT(CUST.DATA.CifId)


		########################################
		#Fetch Overdraft Account			##
		########################################

		sv_s = "Drforacid,DrAccontName,DrSchmCode,CCifId|"
		sv_s = sv_s + " select foracid,acct_name, schm_code,cif_id from tbaadm.gam where schm_code in('ODASM','OD548') "
		sv_s = sv_s + " and bank_id=?SVAR and cif_id=?SVAR and entity_cre_flg='Y' and del_flg='N' "
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.CifId
		print(BANCS.INPARAM.BINDVARS)
	
		sv_e = urhk_dbSelectWithBind(sv_s)
		print(sv_e)

		IF(sv_e == 0) THEN
		#{
		CUST.DATA.Drforacid= BANCS.OUTPARAM.Drforacid
		PRINT(CUST.DATA.Drforacid)
		CUST.DATA.CCifId = BANCS.OUTPARAM.CCifId
		PRINT(CUST.DATA.CCifId)

		ENDIF

	
		IF((CUST.DATA.ClrAmt) < CDOUBLE("0.00")) THEN
			#{
			sv_u = urhk_MTTS_DefineTransaction("ODASMTrans")

			
			#Account to Credit
				
				MTT.PartTranDetails.Account 	= CUST.DATA.Crforacid
				MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
				MTT.PartTranDetails.RateCode 	="MEAN"
				MTT.PartTranDetails.Rate 	= "0"
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = "ODA Cr Sweep To " + CUST.DATA.Crforacid
				MTT.PartTranDetails.Particulars2 = CUST.DATA.Crforacid
				MTT.PartTranDetails.RefAmount = -(cdouble(CUST.DATA.ClrAmt)) 
				MTT.PartTranDetails.Amount   = -(cdouble(CUST.DATA.ClrAmt))
				MTT.PartTranDetails.Remarks = "Cr.from Overdraft Account" 
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = "ODASMTrans" 
				MTT.PartTranDetails.PstFlg = "Y"
				sv_r = urhk_MTTS_definePartTran("CustDr")
				print(sv_r)
				IF(fieldexists(MTT.Error.Description)) THEN
					print(MTT.Error.Description)
					CUST.DATA.MTTErrDesc = MTT.Error.Description
				ENDIF
			#Account to Debit
				MTT.PartTranDetails.Account 	= CUST.DATA.Drforacid
				MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
				MTT.PartTranDetails.RateCode 	="MEAN"
				MTT.PartTranDetails.Rate 	= "0"
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = "ODA Dr Sweep From " + CUST.DATA.Drforacid
				MTT.PartTranDetails.Particulars2 = CUST.DATA.Crforacid
				MTT.PartTranDetails.RefAmount = (cdouble(CUST.DATA.ClrAmt))  
				MTT.PartTranDetails.Remarks = "Sweep from:" + CUST.DATA.Drforacid
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = "ODASMTrans"
				MTT.PartTranDetails.PstFlg = "Y"
				sv_r = urhk_MTTS_definePartTran("CustDr")
				print(sv_r)

				IF(fieldexists(MTT.Error.Description)) THEN
					print(MTT.Error.Description)
					CUST.DATA.MTTErrDesc = MTT.Error.Description
				ENDIF

			##############################################################
			####Collect Ultilised limit charge during Sweeps
			##############################################################
				CUST.DATA.LacePercent="1"
				PRINT(CUST.DATA.ClrAmt)
				CUST.DATA.LaceCharge = ""
				CUST.DATA.LaceCharge = (CDOUBLE(CUST.DATA.LacePercent) * CDOUBLE(CUST.DATA.ClrAmt))/100
				PRINT(CUST.DATA.LaceCharge)
			#Account to Credit
				MTT.PartTranDetails.Account 	= CUST.DATA.CrChargeAcct
				MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
				MTT.PartTranDetails.RateCode 	="MEAN"
				MTT.PartTranDetails.Rate 	= "0"
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = "ODA Cr Lace Charge on Overdraft @ 1% of" + CUST.DATA.ClrAmt
				MTT.PartTranDetails.Particulars2 = CUST.DATA.CrChargeAcct
				MTT.PartTranDetails.RefAmount = -(cdouble(CUST.DATA.LaceCharge)) 
				MTT.PartTranDetails.Amount   = -(cdouble(CUST.DATA.LaceCharge))
				MTT.PartTranDetails.Remarks = "Cr.from Overdraft Account" 
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = "ODASMTrans" 
				MTT.PartTranDetails.PstFlg = "Y"
				sv_r = urhk_MTTS_definePartTran("CustDr")
				print(sv_r)
				IF(fieldexists(MTT.Error.Description)) THEN
					print(MTT.Error.Description)
					CUST.DATA.MTTErrDesc = MTT.Error.Description
				ENDIF
			#Account to Debit
				MTT.PartTranDetails.Account 	= CUST.DATA.Drforacid
				MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
				MTT.PartTranDetails.RateCode 	="MEAN"
				MTT.PartTranDetails.Rate 	= "0"
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = "ODA Dr Lace Charge on Overdraft @ 1% of " + CUST.DATA.ClrAmt
				MTT.PartTranDetails.Particulars2 = CUST.DATA.CrChargeAcct
				MTT.PartTranDetails.RefAmount = (cdouble(CUST.DATA.LaceCharge))  
				MTT.PartTranDetails.Remarks = "Sweep from:" + CUST.DATA.Drforacid
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = "ODASMTrans"
				MTT.PartTranDetails.PstFlg = "Y"
				sv_r = urhk_MTTS_definePartTran("CustDr")
				print(sv_r)

				IF(fieldexists(MTT.Error.Description)) THEN
					print(MTT.Error.Description)
					CUST.DATA.MTTErrDesc = MTT.Error.Description
				ENDIF
			#################################################################
			##End of Lace charge collection 
			#################################################################
				sv_r = urhk_MTTS_EndDefinition("")
				print(sv_r)
				IF(fieldexists(BANCS.OUTPARAM.MTTTranId)) THEN
				#{
				
					print(BANCS.OUTPARAM.MTTTranId)
					CUST.DATA.tranid = BANCS.OUTPARAM.MTTTranId
					print(CUST.DATA.tranid)
				#}
				ENDIF
			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)	

			GOTO NEXTREC

			BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
			PRINT(BANCS.INPUT.RECCOUNT)
				
			#sv_c = urhk_dbCursorFetch(CUST.DATA.CURSOR_NUMBER)
			#PRINT(sv_c)
		
			#}
			ENDIF		
			
		NEXTREC:
		sv_c = urhk_dbCursorFetch(CUST.DATA.CURSOR_NUMBER)
		print(sv_c)

		#sv_q = urhk_dbCursorFetch(sv_c)
		#print(sv_q)

		DO
		#sv_c = urhk_dbCursorClose(CUST.DATA.CURSOR_NUMBER)
		#print(sv_c)

		#}
	ENDIF
        sv_r = urhk_MTTS_Close("")
        print(sv_r)
ENDOFSCRIPT:
EXITSCRIPT
END-->
