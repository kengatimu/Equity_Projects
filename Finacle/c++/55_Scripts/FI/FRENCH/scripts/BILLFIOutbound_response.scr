	sv_s = sv_s + " AND BANK_ID=?SVAR"
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.UBP.count9 = BANCS.OUTPARAM.count9
		PRINT(CUST.UBP.count9)
		IF(CUST.UBP.count9=="0")THEN
