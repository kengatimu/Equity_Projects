		print(sv_a)
		sv_g = RIGHT$(CUST.UBP.namValConc, sv_z-sv_p)
		print(sv_g)
		sv_y = "<"+sv_a+">"
		sv_z = "</"+sv_a+">"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
