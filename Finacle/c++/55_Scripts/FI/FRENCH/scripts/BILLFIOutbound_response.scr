		#}
		ENDIF
	#}
	ENDIF
	#==============================================================================================================
	#Step2-getting template id from HBSR MENU
	#==============================================================================================================
	BANCS.INPARAM.BINDVARS =CUST.UBP.billerId+"|"+CUST.UBP.typOfServ+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "dynTempId|"
	sv_s = sv_s + " SELECT MANDATE_TEMPLATE_ID"
	sv_s = sv_s + " FROM TBAADM.BSRT"
	sv_s = sv_s + " WHERE BILLER_ID = ?SVAR"
	sv_s = sv_s + " AND BILLER_SERVICE_ID=?SVAR"
	sv_s = sv_s + " AND BANK_ID=?SVAR"
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.UBP.dynTempId = BANCS.OUTPARAM.dynTempId
		PRINT(CUST.UBP.dynTempId)
	#}
	ELSE
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		#CUST.INTERFACE.errorMsgDesc = "Error in fetching Template Id from HBSR"
		CUST.UBP.errorCode = "UBP_ERR058"
		CALL("ubpdp044.scr")
		CUST.INTERFACE.errorMsgDesc =CUST.UBP.errorDesc
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#==============================================================================================================
	#Step3-fetching the dynamic field details from HTEMPL
	#==============================================================================================================
	#========================================================
	# Fetching the Record count
	#========================================================
	BANCS.INPARAM.BINDVARS = "N|"+CUST.UBP.dynTempId+"|"+BANCS.STDIN.contextBankId+"|TEST"
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "recCount1|"
	sv_s = sv_s + " SELECT count(1)"
	sv_s = sv_s + " FROM TBAADM.TPDT "
	sv_s = sv_s + " WHERE DEL_FLG = ?SVAR"
	sv_s = sv_s + " AND TEMPLATE_ID = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND FIELD_NAME != ?SVAR"
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d ==0)THEN
	#{
		CUST.UBP.recCount1 = BANCS.OUTPARAM.recCount1
		IF(CUST.UBP.recCount1==0)THEN
		#{
			print("No dynamic fields to be displayed") 
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			BANCS.INPARAM.BINDVARS = "N|"+CUST.UBP.dynTempId+"|"+BANCS.STDIN.contextBankId+"|TEST"
			print(BANCS.INPARAM.BINDVARS)
			sv_s = "fieldName,litCode,style|"
			sv_s = sv_s + " SELECT lower(FIELD_NAME),LITERAL_CODE,STYLE"
			sv_s = sv_s + " FROM TBAADM.TPDT "
			sv_s = sv_s + " WHERE DEL_FLG = ?SVAR"
			sv_s = sv_s + " AND TEMPLATE_ID = ?SVAR"
			sv_s = sv_s + " AND BANK_ID = ?SVAR"
			sv_s = sv_s + " AND FIELD_NAME != ?SVAR"
			PRINT(sv_s)
			sv_c = urhk_dbCursorOpenWithBind(sv_s)
			PRINT(sv_c)
			IF(sv_c != 0)THEN
			#{
				#CUST.UBP.errorFlg = "Y"
				#CUST.UBP.errorMsg = "Error in fetching data"
				CUST.INTERFACE.errorMsgFlg = "Y"
				CUST.UBP.errorCode = "UBP_ERR061"
				CALL("ubpdp044.scr")
				CUST.INTERFACE.errorMsgDesc =CUST.UBP.errorDesc
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_n)
			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			sv_i = 1
			sv_k=""
			WHILE(sv_f == 0)
			#{
				
				CUST.UBP.fieldName = BANCS.OUTPARAM.fieldName
				PRINT(CUST.UBP.fieldName)
				CUST.UBP.litCode = BANCS.OUTPARAM.litCode
				PRINT(CUST.UBP.fieldName)
				CUST.UBP.style = BANCS.OUTPARAM.style
				PRINT(CUST.UBP.style)
				sv_t=CUST.UBP.fieldName+"!"
				sv_g=CUST.UBP.litCode+"!"
				sv_h=CUST.UBP.style+"!"
				#========================================================
				# Mapping the id with value which we got from response
				#and appending it with string
				#========================================================
				#lower case response
				#CUST.INTERFACE.respXMLMsg="<respStatus>SUCCESS</respStatus>,<bankCharges>2</bankCharges>,<currency>KES</currency>,<paymentStatus>P</paymentStatus>,<tourists>8</tourists>,<transactionRef>SWATI</transactionRef>"
				sv_x=TOLOWER(CUST.INTERFACE.respXMLMsg)
				#actual
				sv_p=CUST.INTERFACE.respXMLMsg
				#sv_x = "<respStatus>SUCCESS</respStatus>,<clientname></clientname>,<orderref>orderRef</orderref>,<response>respomse</response>,<status>status</status>,<totalpersons>4</totalpersons>,<dateadded></dateadded>"
				print(sv_x)
				#sv_y = "<respStatus>"
				#sv_z = "</respStatus>"
				sv_y="<"+CUST.UBP.fieldName+">"
				print(sv_y)
				sv_z = "</"+CUST.UBP.fieldName+">"
				print(sv_z)
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				print(sv_b)
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				print(sv_e)
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					#CUST.INTERFACE.dynFieldVal = MID$(sv_x, sv_b, (sv_e - sv_b))
					CUST.INTERFACE.dynFieldVal = MID$(sv_p, sv_b, (sv_e - sv_b))
					print(CUST.INTERFACE.dynFieldVal)
					IF(CUST.INTERFACE.dynFieldVal=="")THEN
					#{
						CUST.INTERFACE.dynFieldVal="No Value recieved"
						sv_o=CUST.INTERFACE.dynFieldVal+"!"
					#}
					ENDIF
					sv_o=CUST.INTERFACE.dynFieldVal+"!"
					
				#}
				ELSE
				#{
				
					sv_y = "<"+sv_a+"/>"
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.dynFieldVal = "No Value Recieved"
						print(CUST.INTERFACE.dynFieldVal)
						sv_o=CUST.INTERFACE.dynFieldVal+"!"
					#}
					ELSE
					#{
						
						#CUST.INTERFACE.errorMsgDesc = "Error in Response Recieved"
						
						CUST.INTERFACE.errorMsgFlg = "Y"
						CUST.UBP.errorCode = "UBP_ERR059"
						CALL("ubpdp044.scr")
						CUST.INTERFACE.errorMsgDesc =CUST.UBP.errorDesc
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
				#}
				ENDIF
				
				#========================================================
				# END---
				#========================================================
				sv_l=","
				print(sv_k)
				print(sv_t)
				print(sv_g)
				print(sv_h)
				print(sv_l)
				sv_k=sv_k+sv_t+sv_g+sv_h+sv_o+sv_l
				print(sv_k)
				sv_i = sv_i + 1
				sv_f = urhk_dbCursorFetch(sv_n)
				if(sv_f==1)then
				#{
					sv_k= rtrim(sv_k, ',')
					print(sv_k)
					sv_k= rtrim(sv_k, '!')
					print(sv_k)
					CUST.UBP.retStrngVal=sv_k
					
				#}
				endif
