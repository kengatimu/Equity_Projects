#{
IF((CUST.UBP.billerValReq=="N") AND (CUST.UBP.getServiceName1=="VAL"))THEN
#{
	#==============================================================================================================
	#- Logic for getting template Id(for display of dynamic fields)
	#Step1-getting template id from HBSR MENU(first checking the count if the setup is done at HBSR level or not.
	#==============================================================================================================
	BANCS.INPARAM.BINDVARS =CUST.UBP.billerId+"|"+CUST.UBP.typOfServ+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
