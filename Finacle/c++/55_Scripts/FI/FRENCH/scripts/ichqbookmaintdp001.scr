	CUST.CDDUM.recCount = BANCS.OUTPARAM.recCount
	print(CUST.CDDUM.recCount)
	
	sv_q = urhk_SetOrbOut("recCount|"+CUST.CDDUM.recCount)
	
	sv_s = "refCode,refDesc"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT rpad(INST_TYPE,6,' '),lpad(INST_DESC,30,' ') "
	sv_s = sv_s + " FROM CUSTOM.C_CBT_INT "
	sv_s = sv_s + " WHERE del_flg != 'Y' "
	sv_s = sv_s + " AND bank_id =?SVAR "
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(sv_s)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	
	IF( sv_c != 0) THEN
	#{
		sv_u = urhk_SRV_SetErr("No recods fetched for the entered Account Number")
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		
		WHILE( sv_c == 0)
		#{
			CUST.CDDUM.count = sv_a
			print(CUST.CDDUM.count)
			
			CUST.CDDUM.refCode = BANCS.OUTPARAM.refCode
			print(CUST.CDDUM.refCode)
			
			CUST.CDDUM.refDesc = BANCS.OUTPARAM.refDesc
			print(CUST.CDDUM.refDesc)
			
			sv_z = "instrNo_" + CUST.CDDUM.count
			sv_z = sv_z + "|" + CUST.CDDUM.refCode
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "refDesc_" + CUST.CDDUM.count
			sv_z = sv_z + "|" + CUST.CDDUM.refDesc
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_a = sv_a + 1
			sv_c = urhk_dbCursorFetch(sv_l)
			print(sv_c)
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
