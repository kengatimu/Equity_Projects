		BANCS.INPARAM.BINDVARS =  BANCS.INPUT.roleId  + "|" + BANCS.INPUT.currency + "|" + BANCS.STDIN.contextBankId
		sv_u=urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.DATA.lchgid1 = BANCS.OUTPARAM.lchgid1
			CUST.DATA.rcreid1 = BANCS.OUTPARAM.rcreid1
			PRINT(CUST.DATA.lchgid1)
			PRINT(BANCS.STDIN.userId)
			#}
		ELSE
			#{
			CUST.DATA.lchgid1 = ""
		#}
		ENDIF
		
		IF(CUST.DATA.lchgid1 != "") THEN
		#{
			IF (CUST.DATA.lchgid1 == BANCS.STDIN.userId) THEN
			#{
				sv_e = "Same user cannot Verify this record"
