	IF(BANCS.INPUT.funcCode=="I" OR BANCS.INPUT.funcCode=="M" OR BANCS.INPUT.funcCode=="V" OR BANCS.INPUT.funcCode=="D") THEN
	#{
		sv_s = "roleid,cashlmt,txfrlmt,clglmt,cashintsolmt,txfrintsolmt,clgintsolmt,currencycode,entcreflg|"
		sv_s = sv_s + "SELECT role_id,user_cash_cr_lim,user_xfer_cr_lim,user_clg_cr_lim,user_intersol_cash_cr_limit, "
