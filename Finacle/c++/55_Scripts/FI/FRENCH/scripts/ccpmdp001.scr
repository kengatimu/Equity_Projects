		IF ((BANCS.INPUT.funcCode =="A") OR (BANCS.INPUT.funcCode =="M")) THEN
		#{
			CUST.DATA.currencycode = BANCS.INPUT.currency
			sv_i = urhk_B2k_valCrncy(CUST.DATA.currencycode)
			PRINT(sv_i)
			IF (sv_i != 0) THEN
			#{
				sv_e = "Invalid Currency code!!"
				sv_m = "currency"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(BANCS.INPUT.funcCode == "A") THEN
	#{
		sv_s = "count|SELECT COUNT(1)"
		sv_s = sv_s + " FROM CUSTOM.CRCL    "
		sv_s = sv_s + " WHERE del_flg ='Y' AND  role_id = ?SVAR"
