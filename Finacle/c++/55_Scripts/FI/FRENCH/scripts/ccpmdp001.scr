		BANCS.INPARAM.BINDVARS =  BANCS.INPUT.roleId  + "|" + BANCS.INPUT.currency + "|" + BANCS.STDIN.contextBankId
		sv_u=urhk_dbSelectWithBind(sv_s)
		IF (sv_u==0) THEN
		#{
			CUST.DATA.roleid = BANCS.OUTPARAM.roleid
			CUST.DATA.cashlmt = BANCS.OUTPARAM.cashlmt
			CUST.DATA.clglmt = BANCS.OUTPARAM.clglmt
			CUST.DATA.txfrlmt = BANCS.OUTPARAM.txfrlmt
			CUST.DATA.cashintsolmt = BANCS.OUTPARAM.cashintsolmt
			CUST.DATA.clgintsolmt = BANCS.OUTPARAM.clgintsolmt
