	IF (BANCS.INPUT.funcCode=="V") THEN
	#{
		#---------------------------------------------------------------------------------
		# To check if the record exists or not for verification
		#---------------------------------------------------------------------------------
		sv_s = "count1|SELECT COUNT(1)"
		sv_s = sv_s + " FROM CUSTOM.CRCL   "
		sv_s = sv_s + " WHERE del_flg = 'N' "
		sv_s = sv_s + " AND  role_id = ?SVAR"
		sv_s = sv_s + " AND crncy_code = ?SVAR"
		sv_s = sv_s + " AND bank_id =?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.INPUT.roleId  + "|" + BANCS.INPUT.currency + "|" + BANCS.STDIN.contextBankId
		sv_u=urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		PRINT(BANCS.OUTPARAM.count1)
