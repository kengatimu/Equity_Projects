		IF (CINT(CUST.DATA.verCount1) == 0) THEN
		#{
			sv_e = "Record Does Not Exist. Use A as Function"
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#---------------------------------------------------------------------------------
		# To check if the record already verified or not for verification
		#---------------------------------------------------------------------------------
		sv_s = "count3|SELECT COUNT(1)"
		sv_s = sv_s + " FROM CUSTOM.CRCL   "
		sv_s = sv_s + " WHERE del_flg = 'N' AND  role_id = ?SVAR"
		sv_s = sv_s + " AND ent_cre_flg = 'Y'"
		sv_s = sv_s + " AND crncy_code = ?SVAR"
		sv_s = sv_s + " AND bank_id =?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.INPUT.roleId  + "|" + BANCS.INPUT.currency + "|" + BANCS.STDIN.contextBankId
		sv_u=urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		PRINT(BANCS.OUTPARAM.count3)
		CUST.DATA.vercount3 =  BANCS.OUTPARAM.count3
		
		IF (CINT(CUST.DATA.vercount3) == 1) THEN
		#{
			sv_e = "Record Already verified"
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#---------------------------------------------------------------------------------
		# User id validation for verification(Modified user cannot verify)
		#---------------------------------------------------------------------------------
		PRINT(BANCS.STDIN.userId)
		sv_s = "lchgid1,rcreid1|"
		sv_s = sv_s + "SELECT lchg_user_id,rcre_user_id   FROM CUSTOM.CRCL  "
		sv_s = sv_s + " WHERE del_flg!='Y' "
