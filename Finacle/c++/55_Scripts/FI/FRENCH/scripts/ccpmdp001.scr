	IF ((BANCS.INPUT.funcCode=="A") OR (BANCS.INPUT.funcCode=="M") OR (BANCS.INPUT.funcCode=="I") OR (BANCS.INPUT.funcCode=="D") OR (BANCS.INPUT.funcCode=="V")) THEN
	#{
