			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#------------------------------------------------------------------------------------------
	# If Function Value is "A" then INSERTING INTO TABLE CUSTOM.CRCL
	#------------------------------------------------------------------------------------------
	
	IF (BANCS.INPUT.funcCode=="I") THEN
	#{
		sv_s = "count|SELECT COUNT(1)"
		sv_s = sv_s + " FROM CUSTOM.CRCL   "
		sv_s = sv_s + " WHERE del_flg!='Y' "
		sv_s = sv_s + " AND  role_id = ?SVAR"
