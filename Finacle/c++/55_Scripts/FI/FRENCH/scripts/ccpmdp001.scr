			CUST.DATA.entcreflg = BANCS.OUTPARAM.entcreflg
			sv_u = urhk_SetOrbOut("cashCrLm|"+CUST.DATA.cashlmt)
			sv_u = urhk_SetOrbOut("ClrnCrLm|"+CUST.DATA.clglmt)
