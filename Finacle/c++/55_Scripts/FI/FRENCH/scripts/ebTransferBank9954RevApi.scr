#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName	: ebTransferBank9954RevApi.scr 
#Desc		: Creates Reversal Transaction of Charges/TranAmt in 99/54 entity 
#MenuId		: NA
#CalledScript	: 
#Module		: MKEY -API
#Date		: 17/12/2018
#Author		: Vino Palani
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#+++++++++++++
#Rep&Class
#+++++++++++++
	if(repexists("MKEY")==0)then
		createrep("MKEY")
	endif
	if(classexists("MKEY","GLBDATA")==0)then
		createclass("MKEY","GLBDATA",5)
	endif
	if(repexists("CUST")==0)then
		createrep("CUST")
	endif
	if(classexists("CUST","CIETXN")==0)then
		createclass("CUST","CIETXN",5)
	endif
#+++++++++++++
#Inputs
#+++++++++++++
	MKEY.GLBDATA.crBal = "0"
	MKEY.GLBDATA.drBal = "0"
	MKEY.GLBDATA.ChrgCnt = ""
	MKEY.GLBDATA.chrgYN	= ""
	MKEY.GLBDATA.crAcct  = "" 
	MKEY.GLBDATA.crtranAmt = ""
	MKEY.GLBDATA.drAcct = "" 
	MKEY.GLBDATA.drtranAmt = "" 
	MKEY.GLBDATA.fintechSucYN = ""
	MKEY.GLBDATA.valerr = ""
	MKEY.GLBDATA.ChrgMsg = ""
	MKEY.GLBDATA.RevChrgTranId = ""
	MKEY.GLBDATA.errChrgmsg = ""
	MKEY.GLBDATA.TranCnt = ""
	MKEY.GLBDATA.TranYN = ""
	MKEY.GLBDATA.TranMsg = ""
	MKEY.GLBDATA.RevTranTranId = ""
	MKEY.GLBDATA.errTranmsg = ""
	MKEY.GLBDATA.OthCnt = ""
	MKEY.GLBDATA.OthCntYN	= ""
	MKEY.GLBDATA.OthTranMsg = ""
	MKEY.GLBDATA.RevOthTranId = ""
	MKEY.GLBDATA.errOthmsg = ""
	if(fieldexists(BANCS.INPUT.Date)==1)then
		print(BANCS.INPUT.Date)
		MKEY.GLBDATA.otranDate	= BANCS.INPUT.Date 
	else
		MKEY.GLBDATA.otranDate	= ""
		MKEY.GLBDATA.errmsg	= "Input the tran Date !"
		goto ENDSCR
	endif
	if(fieldexists(BANCS.INPUT.RefNum)==1)then
		print(BANCS.INPUT.RefNum)
		MKEY.GLBDATA.oRefNum	= BANCS.INPUT.RefNum 
	else
		MKEY.GLBDATA.oRefNum	= ""
		MKEY.GLBDATA.errmsg	= "Input the reference number !" 
		goto ENDSCR
	endif
	if(fieldexists(BANCS.INPUT.drAcctNum)==1)then
		print(BANCS.INPUT.drAcctNum)
		MKEY.GLBDATA.odrAcctNum	= BANCS.INPUT.drAcctNum 
			sv_s = "drBankId | select bank_id from tbaadm.gam where foracid='"+ MKEY.GLBDATA.odrAcctNum +"' "
                        sv_u = urhk_dbSelectWithBind(sv_s)
                        if(sv_u !=0)then
                                MKEY.GLBDATA.errmsg="Invalid DebitAcctNumber for tranRefNum : " + MKEY.GLBDATA.oRefNum 
                                GOTO ENDSCR
                        else
                                MKEY.GLBDATA.drBankId = BANCS.OUTPARAM.drBankId
                        endif

	else
		MKEY.GLBDATA.odrAcctNum	= ""
		MKEY.GLBDATA.errmsg	= "Input the Debit Account Number !" 
		goto ENDSCR
	endif
	if(fieldexists(BANCS.INPUT.crAcctNum)==1)then
		print(BANCS.INPUT.crAcctNum)
		MKEY.GLBDATA.ocrAcctNum	= BANCS.INPUT.crAcctNum 
			sv_s = "crBankId | select bank_id from tbaadm.gam where foracid='"+ MKEY.GLBDATA.ocrAcctNum +"' "
                        sv_u = urhk_dbSelectWithBind(sv_s)
                        if(sv_u !=0)then
                                MKEY.GLBDATA.errmsg="Invalid CreditAcctNumber for tranRefNum : " + MKEY.GLBDATA.oRefNum 
                                GOTO ENDSCR
                        else
                                MKEY.GLBDATA.crBankId = BANCS.OUTPARAM.crBankId
                        endif
	else
		MKEY.GLBDATA.ocrAcctNum	= ""
		MKEY.GLBDATA.errmsg	= "Input the Credit Account Number !" 
		goto ENDSCR
	endif
	if(fieldexists(BANCS.INPUT.PhoneNum)==1)then
		print(BANCS.INPUT.PhoneNum)
		MKEY.GLBDATA.oPhoneNum	= BANCS.INPUT.PhoneNum 
	else
		MKEY.GLBDATA.oPhoneNum	= ""
	endif
	if(fieldexists(BANCS.INPUT.Charge_Amt)==1)then
		print(BANCS.INPUT.Charge_Amt)
		MKEY.GLBDATA.oChrgAmt	= BANCS.INPUT.Charge_Amt 
	else
		MKEY.GLBDATA.oChrgAmt	= 0 
		MKEY.GLBDATA.errmsg	= "Input the Charge Amount !" 
		goto ENDSCR
	endif
	if(fieldexists(BANCS.INPUT.Tran_Amt)==1)then
		print(BANCS.INPUT.Tran_Amt)
		MKEY.GLBDATA.otranAmt	= BANCS.INPUT.Tran_Amt 
	else
		MKEY.GLBDATA.otranAmt	= 0
		MKEY.GLBDATA.errmsg	= "Input the Transaction Amount !" 
		goto ENDSCR
	endif
	if(fieldexists(BANCS.INPUT.Service)==1)then
		print(BANCS.INPUT.Service)
		MKEY.GLBDATA.Service	= BANCS.INPUT.Service 
	else
		MKEY.GLBDATA.Service	= ""
		MKEY.GLBDATA.errmsg	= "Input the ServiceType  !" 
		goto ENDSCR
	endif
	print(BANCS.STDIN.contextBankId)
	print(MKEY.GLBDATA.otranDate)
	print(MKEY.GLBDATA.oRefNum)
	print(MKEY.GLBDATA.odrAcctNum)
	print(MKEY.GLBDATA.ocrAcctNum)
	print(MKEY.GLBDATA.oPhoneNum)
	print(MKEY.GLBDATA.oChrgAmt)
	print(MKEY.GLBDATA.otranAmt)
	print(MKEY.GLBDATA.Service)
	MKEY.GLBDATA.BodDate	= left$(BANCS.STDIN.BODDate,10) 
#99 Charges Reversal
	if((BANCS.STDIN.contextBankId!="99") and (cdouble(MKEY.GLBDATA.oChrgAmt)>0))then  
		sv_c = "ChrgCnt | select count(*) "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_c = sv_c + " from tbaadm.dtd " 
		else
			sv_c = sv_c + " from tbaadm.htd " 
		endif
		sv_c = sv_c + " where bank_id='99' and pstd_flg='Y' " 
		sv_c = sv_c + " and tran_date = to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_c = sv_c + " and tran_particular like '%REV_TRANSFER_BANK%' and ref_num='"+ MKEY.GLBDATA.oRefNum +"' "
		sv_c = sv_c + " and tran_rmks like '%CHRGREVCR%' "
		print(sv_c)
		sv_u = urhk_dbSelectWithBind(sv_c)
		if(sv_u==0)then
			MKEY.GLBDATA.ChrgCnt = BANCS.OUTPARAM.ChrgCnt 
		else
			MKEY.GLBDATA.ChrgCnt	= 0
		endif
		if(MKEY.GLBDATA.ChrgCnt >0)then
			MKEY.GLBDATA.chrgYN = "N"	
		else
			MKEY.GLBDATA.chrgYN = "Y"
		endif
		if(MKEY.GLBDATA.chrgYN =="Y")then
		MKEY.GLBDATA.particulars = "TRANSFER_BANK_CHARGES/" +MKEY.GLBDATA.oRefNum
		sv_d = "crAcct,tranAmt | select (case when part_tran_type='D' and bank_id='99'  then (select foracid from tbaadm.gam "
		sv_d = sv_d + " where bank_id='99' and acct_cls_flg='N' and entity_cre_flg='Y' and del_flg='N' and acid =dtd.acid) "
		sv_d = sv_d + " else null end) as revcrAcctNum ,tran_amt "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_d = sv_d + " from tbaadm.dtd where bank_id='99' and pstd_flg='Y' "
		else
			sv_d = sv_d + " from tbaadm.htd where bank_id='99' and pstd_flg='Y' "
		endif
		sv_d = sv_d + " and tran_date =to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_d = sv_d + " and tran_type='T'  and part_tran_type='D' "  
		sv_d = sv_d + " and pstd_user_id='FIVUSR99' and tran_particular ='"+ MKEY.GLBDATA.particulars +"' " 
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:CHRG%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:OTH%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:TRAN%' "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			MKEY.GLBDATA.crAcct  = BANCS.OUTPARAM.crAcct
			MKEY.GLBDATA.crtranAmt = BANCS.OUTPARAM.tranAmt
		else
			MKEY.GLBDATA.crAcct  = "" 
			MKEY.GLBDATA.crtranAmt = "" 
			MKEY.GLBDATA.errmsg	= "Reversal Failed ! fetching 99 Charge Data"
			goto ENDSCR
		endif
		sv_d = "drAcct,drtranAmt | select (case when part_tran_type='C' and bank_id='99'  then (select foracid from tbaadm.gam "
		sv_d = sv_d + " where bank_id='99' and acct_cls_flg='N' and entity_cre_flg='Y' and del_flg='N' and acid =dtd.acid) "
		sv_d = sv_d + " else null end) as revcrAcctNum ,tran_amt "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_d = sv_d + " from tbaadm.dtd where bank_id='99' and pstd_flg='Y' "
		else
			sv_d = sv_d + " from tbaadm.htd where bank_id='99' and pstd_flg='Y' "
		endif
		sv_d = sv_d + " and tran_date =to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_d = sv_d + " and tran_type='T'  and part_tran_type='C' "  
		sv_d = sv_d + " and pstd_user_id='FIVUSR99' and tran_particular ='"+ MKEY.GLBDATA.particulars +"' " 
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:CHRG%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:OTH%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:TRAN%' "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			MKEY.GLBDATA.drAcct  = BANCS.OUTPARAM.drAcct
			MKEY.GLBDATA.drtranAmt = BANCS.OUTPARAM.drtranAmt
		else
			MKEY.GLBDATA.drAcct  = "" 
			MKEY.GLBDATA.drtranAmt = "" 
			MKEY.GLBDATA.errmsg	= "Reversal Failed ! fetching 99 Charge Data"
			goto ENDSCR
		endif
		if((cdouble(MKEY.GLBDATA.drtranAmt) == cdouble(MKEY.GLBDATA.crtranAmt)) and (cdouble(MKEY.GLBDATA.crtranAmt) == cdouble(MKEY.GLBDATA.oChrgAmt)))then
			print(MKEY.GLBDATA.drAcct)
			print(MKEY.GLBDATA.crAcct)	
			print(MKEY.GLBDATA.drtranAmt)
			print(MKEY.GLBDATA.crtranAmt)
			call("ebTransferBank99ChrgRevApi.scr")
			print(MKEY.GLBDATA.fintechSucYN)
			print(MKEY.GLBDATA.valerr)
			MKEY.GLBDATA.ChrgMsg = MKEY.GLBDATA.valerr
			print(MKEY.GLBDATA.RevChrgTranId)
		endif
		else
			MKEY.GLBDATA.errChrgmsg     = "Charge Reversal Already Exists for refnum : " + MKEY.GLBDATA.oRefNum 
		endif
	else
		MKEY.GLBDATA.errmsg     = "No Charges to Reverse !" 
	endif
#99 Tran Amount
	if((BANCS.STDIN.contextBankId!="99") and (cdouble(MKEY.GLBDATA.otranAmt)>0))then  
		sv_c = "TranCnt | select count(*) "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_c = sv_c + " from tbaadm.dtd " 
		else
			sv_c = sv_c + " from tbaadm.htd " 
		endif
		sv_c = sv_c + " where bank_id='99' and pstd_flg='Y' " 
		sv_c = sv_c + " and tran_date = to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_c = sv_c + " and tran_particular like '%REV_TRANSFER_BANK%' and ref_num='"+ MKEY.GLBDATA.oRefNum +"' "
		sv_c = sv_c + " and tran_rmks like '%TRANREVCR%' "
		print(sv_c)
		sv_u = urhk_dbSelectWithBind(sv_c)
		if(sv_u==0)then
			MKEY.GLBDATA.TranCnt = BANCS.OUTPARAM.TranCnt 
		else
			MKEY.GLBDATA.TranCnt	= 0
		endif
		if(MKEY.GLBDATA.TranCnt >0)then
			MKEY.GLBDATA.TranYN = "N"	
		else
			MKEY.GLBDATA.TranYN = "Y"
		endif
		if(MKEY.GLBDATA.TranYN =="Y")then
		MKEY.GLBDATA.particulars = "TRANSFER_BANK_CHARGES/" +MKEY.GLBDATA.oRefNum
		sv_d = "crAcct,tranAmt | select (case when part_tran_type='D' and bank_id='99'  then (select foracid from tbaadm.gam "
		sv_d = sv_d + " where bank_id='99' and acct_cls_flg='N' and entity_cre_flg='Y' and del_flg='N' and acid =dtd.acid) "
		sv_d = sv_d + " else null end) as revcrAcctNum ,tran_amt "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_d = sv_d + " from tbaadm.dtd where bank_id='99' and pstd_flg='Y' "
		else
			sv_d = sv_d + " from tbaadm.htd where bank_id='99' and pstd_flg='Y' "
		endif
		sv_d = sv_d + " and tran_date =to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_d = sv_d + " and tran_type='T'  and part_tran_type='D' "  
		sv_d = sv_d + " and ref_num = '"+ MKEY.GLBDATA.oRefNum +"' "
		sv_d = sv_d + " and pstd_user_id='FIVUSR99' and tran_particular != '"+MKEY.GLBDATA.particulars+"' "  
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:CHRG%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:TRAN%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:OTH%' "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			MKEY.GLBDATA.crAcct  = BANCS.OUTPARAM.crAcct
			MKEY.GLBDATA.crtranAmt = BANCS.OUTPARAM.tranAmt
		else
			MKEY.GLBDATA.crAcct  = "" 
			MKEY.GLBDATA.crtranAmt = "" 
			MKEY.GLBDATA.errmsg	= "Reversal Failed ! fetching 99 InterBank Transaction Data"
			goto ENDSCR
		endif
		sv_d = "drAcct,drtranAmt | select (case when part_tran_type='C' and bank_id='99'  then (select foracid from tbaadm.gam "
		sv_d = sv_d + " where bank_id='99' and acct_cls_flg='N' and entity_cre_flg='Y' and del_flg='N' and acid =dtd.acid) "
		sv_d = sv_d + " else null end) as revcrAcctNum ,tran_amt "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_d = sv_d + " from tbaadm.dtd where bank_id='99' and pstd_flg='Y' "
		else
			sv_d = sv_d + " from tbaadm.htd where bank_id='99' and pstd_flg='Y' "
		endif
		sv_d = sv_d + " and tran_date =to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_d = sv_d + " and tran_type='T'  and part_tran_type='C' "  
		sv_d = sv_d + " and ref_num = '"+ MKEY.GLBDATA.oRefNum +"' "
		sv_d = sv_d + " and pstd_user_id='FIVUSR99' and tran_particular !='"+ MKEY.GLBDATA.particulars +"' " 
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:CHRG%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:TRAN%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:OTH%' "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			MKEY.GLBDATA.drAcct  = BANCS.OUTPARAM.drAcct
			MKEY.GLBDATA.drtranAmt = BANCS.OUTPARAM.drtranAmt
		else
			MKEY.GLBDATA.drAcct  = "" 
			MKEY.GLBDATA.drtranAmt = "" 
			MKEY.GLBDATA.errmsg	= "Reversal Failed ! fetching 99 InterBank Transaction Data"
			goto ENDSCR
		endif
		if((cdouble(MKEY.GLBDATA.drtranAmt) == cdouble(MKEY.GLBDATA.crtranAmt)) and (cdouble(MKEY.GLBDATA.crtranAmt) == cdouble(MKEY.GLBDATA.otranAmt)))then
			print(MKEY.GLBDATA.drAcct)
			print(MKEY.GLBDATA.crAcct)	
			print(MKEY.GLBDATA.drtranAmt)
			print(MKEY.GLBDATA.crtranAmt)
			print(MKEY.GLBDATA.otranAmt)
			call("ebTransferBank99TranRevApi.scr")
			print(MKEY.GLBDATA.fintechSucYN)
			print(MKEY.GLBDATA.valerr)
			MKEY.GLBDATA.TranMsg = MKEY.GLBDATA.valerr
			print(MKEY.GLBDATA.RevTranTranId)
		endif
		else
			MKEY.GLBDATA.errTranmsg     = "Reversal Transaction Already Exists for refnum : " + MKEY.GLBDATA.oRefNum
		endif
		
	else
		MKEY.GLBDATA.errmsg     = "No Inter-Bank Transactions  to Reverse !" 
	endif
#54 TranAmount rev
	if((BANCS.STDIN.contextBankId=="54") and (cdouble(MKEY.GLBDATA.otranAmt)>0))then  
		sv_c = "OthCnt | select count(*) "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_c = sv_c + " from tbaadm.dtd " 
		else
			sv_c = sv_c + " from tbaadm.htd " 
		endif
		sv_c = sv_c + " where bank_id='54' and pstd_flg='Y' " 
		sv_c = sv_c + " and tran_date = to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_c = sv_c + " and tran_particular like '%REV_TRANSFER_BANK%' and ref_num='"+ MKEY.GLBDATA.oRefNum +"' "
		sv_c = sv_c + " and tran_rmks like '%OTHREVCR%' "
		print(sv_c)
		sv_u = urhk_dbSelectWithBind(sv_c)
		if(sv_u==0)then
			MKEY.GLBDATA.OthCnt = BANCS.OUTPARAM.OthCnt 
		else
			MKEY.GLBDATA.OthCnt	= 0
		endif
		if(MKEY.GLBDATA.OthCnt >0)then
			MKEY.GLBDATA.OthCntYN = "N"	
		else
			MKEY.GLBDATA.OthCntYN = "Y"
		endif
		if(MKEY.GLBDATA.OthCntYN =="Y")then
		MKEY.GLBDATA.particulars = "TRANSFER_BANK_CHARGES/" +MKEY.GLBDATA.oRefNum
		sv_d = "crAcct,tranAmt | select (case when part_tran_type='D' and bank_id='54'  then (select foracid from tbaadm.gam "
		sv_d = sv_d + " where bank_id='54' and acct_cls_flg='N' and entity_cre_flg='Y' and del_flg='N' and acid =dtd.acid) "
		sv_d = sv_d + " else null end) as revcrAcctNum ,tran_amt "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_d = sv_d + " from tbaadm.dtd where bank_id='54' and pstd_flg='Y' "
		else
			sv_d = sv_d + " from tbaadm.htd where bank_id='54' and pstd_flg='Y' "
		endif
		sv_d = sv_d + " and tran_date =to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_d = sv_d + " and tran_type='T'  and part_tran_type='D' "  
		sv_d = sv_d + " and ref_num = '"+ MKEY.GLBDATA.oRefNum +"' "
		sv_d = sv_d + " and pstd_user_id='FIVUSR54' and tran_particular != '"+MKEY.GLBDATA.particulars+"' "  
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:CHRG%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:TRAN%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:OTH%' "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			MKEY.GLBDATA.crAcct  = BANCS.OUTPARAM.crAcct
			MKEY.GLBDATA.crtranAmt = BANCS.OUTPARAM.tranAmt
		else
			MKEY.GLBDATA.crAcct  = "" 
			MKEY.GLBDATA.crtranAmt = "" 
			MKEY.GLBDATA.errmsg	= "Reversal Failed ! fetching 54 InterBank Transaction Data"
			goto ENDSCR
		endif
		sv_d = "drAcct,drtranAmt | select (case when part_tran_type='C' and bank_id='54'  then (select foracid from tbaadm.gam "
		sv_d = sv_d + " where bank_id='54' and acct_cls_flg='N' and entity_cre_flg='Y' and del_flg='N' and acid =dtd.acid) "
		sv_d = sv_d + " else null end) as revcrAcctNum ,tran_amt "
		if(MKEY.GLBDATA.otranDate == MKEY.GLBDATA.BodDate)then
			sv_d = sv_d + " from tbaadm.dtd where bank_id='54' and pstd_flg='Y' "
		else
			sv_d = sv_d + " from tbaadm.htd where bank_id='54' and pstd_flg='Y' "
		endif
		sv_d = sv_d + " and tran_date =to_date('"+ MKEY.GLBDATA.otranDate +"','DD-MM-RR') "
		sv_d = sv_d + " and tran_type='T'  and part_tran_type='C' "  
		sv_d = sv_d + " and ref_num = '"+ MKEY.GLBDATA.oRefNum +"' "
		sv_d = sv_d + " and pstd_user_id='FIVUSR54' and tran_particular !='"+ MKEY.GLBDATA.particulars +"' " 
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:CHRG%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:TRAN%' "
		sv_d = sv_d + " and tran_particular not like '%REV_TRANSFER_BANK:OTH%' "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			MKEY.GLBDATA.drAcct  = BANCS.OUTPARAM.drAcct
			MKEY.GLBDATA.drtranAmt = BANCS.OUTPARAM.drtranAmt
		else
			MKEY.GLBDATA.drAcct  = "" 
			MKEY.GLBDATA.drtranAmt = "" 
			MKEY.GLBDATA.errmsg	= "Reversal Failed ! fetching 54 InterBank Transaction Data"
			goto ENDSCR
		endif
		if((cdouble(MKEY.GLBDATA.drtranAmt) == cdouble(MKEY.GLBDATA.crtranAmt)) and (cdouble(MKEY.GLBDATA.crtranAmt) == cdouble(MKEY.GLBDATA.otranAmt)))then
			print(MKEY.GLBDATA.drAcct)
			print(MKEY.GLBDATA.crAcct)	
			print(MKEY.GLBDATA.drtranAmt)
			print(MKEY.GLBDATA.crtranAmt)
			print(MKEY.GLBDATA.otranAmt)
			call("ebTransferBank54TranRevApi.scr")
			print(MKEY.GLBDATA.fintechSucYN)
			print(MKEY.GLBDATA.valerr)
			MKEY.GLBDATA.OthTranMsg = MKEY.GLBDATA.valerr
			print(MKEY.GLBDATA.RevOthTranId)
		endif
		else
			MKEY.GLBDATA.errOthmsg     = "Other Entity Reversal Transaction Already Exists for refnum : " +MKEY.GLBDATA.oRefNum 
		endif
	else
		MKEY.GLBDATA.errmsg     = "No Inter-Bank Transactions  to Reverse !" 
	endif
#Balance
	MKEY.GLBDATA.crBal = 0
	MKEY.GLBDATA.drBal = 0
	if((MKEY.GLBDATA.odrAcctNum != "") and (MKEY.GLBDATA.drBankId!=""))then
                CUST.CIETXN.AcctID = MKEY.GLBDATA.odrAcctNum 
                CUST.CIETXN.BankID = MKEY.GLBDATA.drBankId 
                call("effavlBalInq.scr")
                if(CUST.CIETXN.scriptSuccess == "N")then
                        print("Balance Inq get failed")
                        print(CUST.DATA.errorDesc)
			MKEY.GLBDATA.errmsg = CUST.DATA.errorDesc
                        MKEY.GLBDATA.drBal = 0
                else
                        print(CUST.DATA.BalType)
                        print(CUST.DATA.amountValue)
                        print(CUST.CIETXN.refAmt)
                        MKEY.GLBDATA.drBal = CUST.DATA.amountValue
                endif
	endif
	if((MKEY.GLBDATA.ocrAcctNum != "") and (MKEY.GLBDATA.crBankId!=""))then
                CUST.CIETXN.AcctID = MKEY.GLBDATA.ocrAcctNum 
                CUST.CIETXN.BankID = MKEY.GLBDATA.crBankId 
                call("effavlBalInq.scr")
                if(CUST.CIETXN.scriptSuccess == "N")then
                        print("Balance Inq get failed")
                        print(CUST.DATA.errorDesc)
                        MKEY.GLBDATA.crBal = 0
			MKEY.GLBDATA.errmsg = CUST.DATA.errorDesc
                else
                        print(CUST.DATA.BalType)
                        print(CUST.DATA.amountValue)
                        print(CUST.CIETXN.refAmt)
                        MKEY.GLBDATA.crBal = CUST.DATA.amountValue
                endif
	endif

ENDSCR:
	print(MKEY.GLBDATA.errmsg)
	print(MKEY.GLBDATA.errChrgmsg)
	print(MKEY.GLBDATA.ChrgMsg)
	print(MKEY.GLBDATA.RevChrgTranId)
	print(MKEY.GLBDATA.errTranmsg)
	print(MKEY.GLBDATA.TranMsg)
	print(MKEY.GLBDATA.RevTranTranId)
	print(MKEY.GLBDATA.errOthmsg)
	print(MKEY.GLBDATA.OthTranMsg)
 	print(MKEY.GLBDATA.RevOthTranId)	
	if((MKEY.GLBDATA.errChrgmsg!="") or ( MKEY.GLBDATA.errTranmsg != "") or (MKEY.GLBDATA.errOthmsg != ""))then
		MKEY.GLBDATA.failmsg = "InterBank Reversal Transaction Failed" 
		MKEY.GLBDATA.failmsg = MKEY.GLBDATA.failmsg + " " +MKEY.GLBDATA.errChrgmsg+ "/" +MKEY.GLBDATA.errTranmsg+ "/" +MKEY.GLBDATA.errOthmsg 
		exitscript
	endif
	if((MKEY.GLBDATA.RevChrgTranId!="") and (MKEY.GLBDATA.RevTranTranId!="") and (MKEY.GLBDATA.RevOthTranId!=""))then
		MKEY.GLBDATA.date = left$(BANCS.STDIN.BODDate,10)
	MKEY.GLBDATA.sucmsg = "InterBank Reversal Transaction Created Successfully.for Referencenumber " +MKEY.GLBDATA.oRefNum+ ":- 99ChargeTran:-" +MKEY.GLBDATA.RevChrgTranId+ "/" +MKEY.GLBDATA.date+ " 99Tran:-" +MKEY.GLBDATA.RevTranTranId+ "/" +MKEY.GLBDATA.date+ " 54Tran:-" +MKEY.GLBDATA.RevOthTranId+ "/" +MKEY.GLBDATA.date
		print(MKEY.GLBDATA.sucmsg)
		sv_u = urhk_SetOrbOut("RESULT_MSG|" +MKEY.GLBDATA.sucmsg)
		print(sv_u)
		print(MKEY.GLBDATA.drBal)
		if(MKEY.GLBDATA.drBal >0)then
			sv_u = urhk_SetOrbOut("DEBIT_ACCT_BALANCE|" +MKEY.GLBDATA.drBal)
		else
			sv_u = urhk_SetOrbOut("DEBIT_ACCT_BALANCE|Balance FetchFailed")
		endif
			print(sv_u)
		print(MKEY.GLBDATA.crBal)
		if(MKEY.GLBDATA.crBal >0)then
			sv_u = urhk_SetOrbOut("CREDIT_ACCT_BALANCE|" +MKEY.GLBDATA.crBal)
		else
			sv_u = urhk_SetOrbOut("CREDIT_ACCT_BALANCE| Balance FetchFailed")
		endif
			print(sv_u)
		exitscript
	endif
	if(MKEY.GLBDATA.errmsg != "") then
		sv_u = urhk_SetOrbOut("Error|" + MKEY.GLBDATA.errmsg)	
		exitscript
	endif
		exitscript
end-->
