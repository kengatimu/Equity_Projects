<--start
trace on
#Rep/Class
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                EQSRV.GLBDATA.CoreId = MTT.InputDetails.Argument1
		EQSRV.GLBDATA.Crforacid = MTT.InputDetails.Argument2
		EQSRV.GLBDATA.TranAmt = MTT.InputDetails.Argument3
		EQSRV.GLBDATA.TranParticular = MTT.InputDetails.Argument4
		EQSRV.GLBDATA.beneficiaryAcct = MTT.InputDetails.Argument5 
		EQSRV.GLBDATA.TranCrcy = MTT.InputDetails.Argument6 
		EQSRV.GLBDATA.batchId = MTT.InputDetails.Argument7 
		EQSRV.GLBDATA.benefName = MTT.InputDetails.Argument8 
		EQSRV.GLBDATA.benefBankCode = MTT.InputDetails.Argument9 
		EQSRV.GLBDATA.benefBrCode = MTT.InputDetails.Argument10
		EQSRV.GLBDATA.drAcctNum = MTT.InputDetails.Argument11 
		EQSRV.GLBDATA.userId = MTT.InputDetails.Argument12
		EQSRV.GLBDATA.gDrAcctNum = MTT.InputDetails.Argument13 
		EQSRV.GLBDATA.chargeAmount = MTT.InputDetails.Argument14 
		sv_e = urhk_B2k_PID("")
		EQSRV.GLBDATA.ppid = BANCS.OUTPARAM.PID
		
		print(EQSRV.GLBDATA.CoreId)
		print(EQSRV.GLBDATA.Crforacid)
		print(EQSRV.GLBDATA.TranAmt)
		print(EQSRV.GLBDATA.TranParticular)
		print(EQSRV.GLBDATA.beneficiaryAcct)
		print(EQSRV.GLBDATA.TranCrcy)
		print(EQSRV.GLBDATA.batchId)
		print(EQSRV.GLBDATA.benefName)
		print(EQSRV.GLBDATA.benefBankCode)
		print(EQSRV.GLBDATA.benefBrCode)
		print(EQSRV.GLBDATA.drAcctNum)
		print(EQSRV.GLBDATA.userId)
		print(EQSRV.GLBDATA.ppid)
		print(EQSRV.GLBDATA.gDrAcctNum)
		print(EQSRV.GLBDATA.chargeAmount)
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        endif
	EQSRV.GLBDATA.boddate = mid$(BANCS.STDIN.BODDate,0,10)
	sv_u = urhk_getFileLocation("COM|ebcpluplGag.com")
	if(sv_u ==0)then
	print(BANCS.OUTPARAM.fileLocation)
	EQSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "ebcpluplGag.com"
	if(cdouble(EQSRV.GLBDATA.chargeAmount)>0)then
	EQSRV.GLBDATA.chrgYN = "Y"
	EQSRV.GLBDATA.comfil = EQSRV.GLBDATA.comfil + " " +'"'+EQSRV.GLBDATA.CoreId+'"'+ " " +'"'+EQSRV.GLBDATA.Crforacid+ '"' + " " +'"'+EQSRV.GLBDATA.TranAmt+ '"' + " " +'"'+ EQSRV.GLBDATA.TranParticular + '"'+ " " +'"'+ EQSRV.GLBDATA.beneficiaryAcct +'"'+ " " +'"'+ EQSRV.GLBDATA.TranCrcy +'"'+ " " +'"'+ EQSRV.GLBDATA.batchId + '"'+ " " +'"'+EQSRV.GLBDATA.benefName+ '"'+ " " +'"'+ EQSRV.GLBDATA.benefBankCode + '"'+ " " +'"'+ EQSRV.GLBDATA.benefBrCode + '"'+" " +'"'+ EQSRV.GLBDATA.drAcctNum + '"' + " " + '"' + BANCS.STDIN.userId + '"' + " " + '"' + EQSRV.GLBDATA.ppid + '"' + " " + '"' + EQSRV.GLBDATA.gDrAcctNum + '"' + " " + '"' + EQSRV.GLBDATA.chargeAmount + '"' + " " +  '"' + EQSRV.GLBDATA.chrgYN + '"' + " " +'"' + EQSRV.GLBDATA.boddate + '"' + " "
	else
	EQSRV.GLBDATA.chrgYN = "N"
	EQSRV.GLBDATA.comfil = EQSRV.GLBDATA.comfil + " " +'"'+EQSRV.GLBDATA.CoreId+'"'+ " " +'"'+EQSRV.GLBDATA.Crforacid+ '"' + " " +'"'+EQSRV.GLBDATA.TranAmt+ '"' + " " +'"'+ EQSRV.GLBDATA.TranParticular + '"'+ " " +'"'+ EQSRV.GLBDATA.beneficiaryAcct +'"'+ " " +'"'+ EQSRV.GLBDATA.TranCrcy +'"'+ " " +'"'+ EQSRV.GLBDATA.batchId + '"'+ " " +'"'+EQSRV.GLBDATA.benefName+ '"'+ " " +'"'+ EQSRV.GLBDATA.benefBankCode + '"'+ " " +'"'+ EQSRV.GLBDATA.benefBrCode + '"'+" " +'"'+ EQSRV.GLBDATA.drAcctNum + '"' + " " + '"' + BANCS.STDIN.userId + '"' + " " + '"' + EQSRV.GLBDATA.ppid + '"' + " " + '"' + EQSRV.GLBDATA.gDrAcctNum + '"' + " " + '"' + EQSRV.GLBDATA.chargeAmount + '"' + " " + '"' + EQSRV.GLBDATA.chrgYN + '"' + " " +'"' +EQSRV.GLBDATA.boddate+ '"' + " " 
	endif
	else
		EQSRV.GLBDATA.comfil   = ""
	endif
	print(EQSRV.GLBDATA.comfil)
	if(EQSRV.GLBDATA.comfil != "")then
		sv_u = system(EQSRV.GLBDATA.comfil)
		if(sv_u ==0)then
			print("gg success")
		else
			print("failed gg")
		endif
	else
		goto VAYU
	endif

VAYU:
        if(classexists("EQSRV","GLBDATA")==1) then
                deleteclass("EQSRV","GLBDATA")
        endif
        if(repexists("EQSRV")==1) then
                deleterep("EQSRV")
        endif
        exitscript
##trace off
end-->
