<--START
TRACE ON

 if (REPEXISTS("CUST")==0)THEN
 #{
 CREATEREP("CUST")
 #}
 endif

 if (CLASSEXISTS("CUST","DATA")==0)THEN
 #{
 CREATECLASS("CUST","DATA",5)
 #}
 endif


	IF( (FIELDEXISTS(("BANCS").("INPUT").("FromCCY"))== 1) ) THEN
	#{
		CUST.DATA.FromCCY = BANCS.INPUT.FromCCY
		Print(CUST.DATA.FromCCY)
		
		ELSE
		#{
   		CUST.DATA.errMsg="Please Enter The Fixed Currency Code"
		sv_t = "ERROR| " +CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("ToCCY"))== 1) ) THEN
	#{
		CUST.DATA.ToCCY = BANCS.INPUT.ToCCY
		Print(CUST.DATA.ToCCY)
		
		ELSE
		#{
   		CUST.DATA.errMsg="Please Enter The Variable Currency Code"
		sv_t = "ERROR| " +CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
		sv_u = urhk_SetUrhkInp("genTieredRateDtl.fromCrncy.crncyCode|" +CUST.DATA.FromCCY )
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("genTieredRateDtl.toCrncy.crncyCode|" +CUST.DATA.ToCCY )
		PRINT(sv_u)
		#sv_u = urhk_SetUrhkInp("genTieredRateDtl.toAcct.foracid|0740179673101")
		#PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("genTieredRateDtl.rateCode.refCode|TTS")
		PRINT(sv_u)
		sv_u = urhk_SetUrhkOut("genTieredRateDtl.rate| Rate ")
		PRINT(sv_u)

		sv_u = urhk_ExecSrv("SRV_FetchTieredRateDtl|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)


		IF (sv_u == 0) THEN
		#{
			PRINT("SUCCESS SO FAR")
			#IF(BANCS.OUTPARAM.Rate !="")THEN
			CUST.DATA.Rate =BANCS.OUTPARAM.Rate
			PRINT(CUST.DATA.Rate)
			lv_b = urhk_SetOrbOut("RATE|" +CUST.DATA.Rate)

			#ENDIF
			#}
			ELSE
			#{
			lv_b = urhk_SetOrbOut("Rate could not be found for currency combination")
			GOTO REMCHECKERROR

			#}
			ENDIF	

		
		


	REMCHECKERROR:
	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error for Acct:"+CUST.AGENT.account+" '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>loanMgr.log")
				print(sv_u)
				
				#Error response
				sv_t = "executeFinacleScript_CustomData.ERROR | " +sv_e
				sv_u = urhk_SetOrbOut(sv_t)

			#}
			DO
			#}
		ENDIF
	#}
	ENDIF
	
	
	
ENDOFSCRIPT:
exitscript
TRACE OFF
END-->



