			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "reqid_" + CUST.CDDUM.count
			sv_z = sv_z + "|" + CUST.CDDUM.reqid
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "acctNum_" + CUST.CDDUM.count
			sv_z = sv_z + "|" +CUST.CDDUM.acctNum
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "numofchb_" + CUST.CDDUM.count
