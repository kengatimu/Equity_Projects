			print(CUST.CDDUM.count)
			
			CUST.CDDUM.status = BANCS.OUTPARAM.status
			print(CUST.CDDUM.status)
			
			CUST.CDDUM.reqid = BANCS.OUTPARAM.req_id
			print(CUST.CDDUM.reqid)
			
			CUST.CDDUM.acctNum = BANCS.OUTPARAM.acctNum
