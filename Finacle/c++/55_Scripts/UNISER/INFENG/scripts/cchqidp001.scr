	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	CUST.CDDUM.recCount = BANCS.OUTPARAM.recCount
	print(CUST.CDDUM.recCount)
	
	sv_q = urhk_SetOrbOut("recCount|"+CUST.CDDUM.recCount)
	
	sv_s = "status,req_id,acctNum,num_of_chb,num_of_chq_lvs,req_date"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT lpad(req_status,6,' '),rpad(req_id,7,' '),lpad(foracid,20,' '),lpad(num_of_chb,10,' '), lpad(num_of_chq_lvs,10,' '),lpad(req_date,16,' ') "
	sv_s = sv_s + " FROM CUSTOM.CUSTOM_CBR "
	sv_s = sv_s + " WHERE del_flg != 'Y' "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	sv_s = sv_s + " AND req_status = ?SVAR "
	sv_s = sv_s + " AND  foracid = ?SVAR "
	
