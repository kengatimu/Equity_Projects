<--start
TRACE ON
sv_k=""
sv_y=""
sv_w=""

sv_q="custId,acctBal|"
sv_q = sv_q + " SELECT foracid,clr_bal_amt from tbaadm.gam where schm_type='SBA' and BANK_ID='54' and ENTITY_CRE_FLG='Y' and acct_cls_flg='N' and clr_bal_amt<0 and foracid not in (select foracid from custom.INT_CHECK_ALL_OVER) "
print(sv_q)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

if(sv_e==0) then
       sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        sv_q = urhk_dbCursorFetch(sv_m)
        print(sv_q)
        if(sv_q == 1) then
               sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        endif
        print(sv_q)
        while(sv_q==0)
			##################
			# Get account balance as on BOD date.

			sv_a=BANCS.OUTPARAM.custId
			print(sv_a)
			sv_b=BANCS.OUTPARAM.acctBal
			print(sv_b)


			BANCS.INPUT.acctId = sv_a

			print(BANCS.INPUT.acctId)

			BANCS.INPARAM.acctId = BANCS.INPUT.acctId

			BANCS.INPARAM.asOnDate = BANCS.STDIN.BODDate

			sv_a = urhk_getAcctBalanceAsOnDate("")
			print(sv_a)

			# Populate the input repositories for getting interest rate

			print(BANCS.INPUT.acctId)
			print(BANCS.OUTPARAM.acctBal)


			BANCS.INPARAM.balance = BANCS.OUTPARAM.acctBal

			BANCS.INPARAM.acctNum = BANCS.INPUT.acctId

			BANCS.INPARAM.asOnDate = BANCS.STDIN.BODDate
			print(BANCS.INPARAM.asOnDate)

			sv_a = urhk_getInterestRateForAccount("")
			print(sv_a)

			print(BANCS.OUTPARAM.interestRate)

			sv_k = BANCS.OUTPARAM.interestRate
			print(sv_k)

			sv_w = BANCS.INPUT.acctId
			print(sv_w)


			##################
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)
			sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			BANCS.INPARAM.BINDVARS =  sv_h
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				print(BANCS.OUTPARAM.getboddate)
				sv_y = BANCS.OUTPARAM.getboddate
				print(sv_y)

				sv_x="A"
				
				BANCS.INPARAM.BINDVARS = sv_w + "|" + sv_k + "|" + BANCS.STDIN.contextBankId + "|" + sv_y + "|" + sv_x
				print(BANCS.INPARAM.BINDVARS)
				sv_j = "insert into custom.INT_CHECK_ALL_OVER values( ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR)"
				sv_w = urhk_dbSQLWithBind(sv_j)
				sv_w = urhk_dbSQLWithBind("COMMIT")
				print(sv_j)
			ENDIF

		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
        do
TRACE OFF
EXITSCRIPT

end-->
