<--START
CHECKSUM="4a8dc6cadea984e55ea9823fc0dd8b8844e18ec50677bdb9812371729495ac9d"
	TRACE ON
	#-------------------------------------------------------------------
	#Fetching the clear balance amount from the gam table
	#--------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.ASSETS.foracid + "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +"Y|N"
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_s = " clrBalAmt|SELECT CLR_BAL_AMT "
	sv_s = sv_s + "  FROM  TBAADM.GAM "
	sv_s = sv_s + "  WHERE  FORACID =?SVAR "
	sv_s = sv_s + "  AND BANK_ID =?SVAR "
	sv_s = sv_s + "  AND ENTITY_CRE_FLG =?SVAR "
	sv_s = sv_s + "  AND DEL_FLG =?SVAR "
	sv_d =  urhk_dbSelectWithBind(sv_s)
	IF  (sv_d ==0) THEN
	#{
		CUST.ASSETS.clrBalAmt= BANCS.OUTPARAM.clrBalAmt
	#}
	ENDIF
	
	
	#------------------------------------------------------------------
	# If record already exist in C_CAC then move the same into C_CACH
	# and update record in C_CAC
	#------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ASSETS.foracid
	sv_s = "recCount|SELECT COUNT(*) FROM CUSTOM.C_CAC WHERE"
	sv_s = sv_s + " BANK_ID = ?SVAR AND FORACID = ?SVAR"
	sv_d =  urhk_dbSelectWithBind(sv_s)
	IF(BANCS.OUTPARAM.recCount == 0) THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.ASSETS.foracid + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.lastAdjDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.rshdlDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.watchUpgrDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.normalUpgrDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.clrBalAmt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "0"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.currentDPD
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "0"
		
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_s = "INSERT INTO C_CAC VALUES"
		sv_s = sv_s + "(?SVAR, ?SVAR, ?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'),"
		sv_s = sv_s + " TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'), TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'),"
		sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR, ?SVAR,?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'),?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'),?SVAR)"
		PRINT(sv_s)
		sv_d = urhk_dbSqlWithBind(sv_s)
		print(sv_d)
		#}
	ELSE
		#{
		#-----------------------------------------------------------------------------
		# Select the record value from C_CAC and insert into C_CACH
		#-----------------------------------------------------------------------------
		CALL("astclsdp004.scr")
		IF(CUST.ASSETS.statusCACH == "Y") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.ASSETS.lastAdjDate + "|" + CUST.ASSETS.rshdlDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.watchUpgrDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.normalUpgrDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.clrBalAmt
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.currentDPD
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.cachSrlNum
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.foracid
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "UPDATE CUSTOM.C_CAC SET"
			sv_s = sv_s + " DEL_FLG = 'N',LAST_ADJ_DATE = ?SVAR,"
			sv_s = sv_s + " RSHDL_DATE = TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'),"
			sv_s = sv_s + " UPGR_WATCH_DATE = TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'),"
			sv_s = sv_s + " UPGR_NORMAL_DATE = TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss'),"
			sv_s = sv_s + " CLR_BAL_AMT = ?SVAR,"
			sv_s = sv_s + " CURRENT_DPD = ?SVAR,"
			sv_s = sv_s + " CACH_SRL_NUM = ?SVAR,"
			sv_s = sv_s + " LCHG_USER = ?SVAR,"
			sv_s = sv_s + " LCHG_DATE = TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss')"
			sv_s = sv_s + " WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR"
			PRINT(sv_s)
			sv_d = urhk_dbSqlWithBind(sv_s)
			print(sv_d)
		#}
		ENDIF
	#}
	ENDIF
	
