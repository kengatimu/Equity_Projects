	ENDIF

	BANCS.INPARAM.BINDVARS=COMMON.INPUT.ACID +"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_s ="accessCode|"
	sv_s = sv_s + "SELECT ACCT_ACCESS_CODE FROM TBAADM.AAC WHERE ACID = ?SVAR AND BANK_ID = ?SVAR"

	print (sv_s)
	
	sv_e = urhk_dbSelectWithBind(sv_s)
