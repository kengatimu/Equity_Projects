			PRINT(EBSRV.GLBDATA.CustCntry)

			if(EBSRV.GLBDATA.CustConst == "No Data Found") then
			#{
				EBSRV.GLBDATA.CustConst = ""
			#}
			endif
			#------------------Edwin Duplicate Check 
			lv_s = "UniqueID|select id_number from custom.caml where entity_cre_flg ='Y' and bank_id =?SVAR and del_flg ='N' and cif_id =?SVAR and rownum<=1 group by id_number "
			print(lv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.orgKey
			lv_r = urhk_dbSelectWithBind(lv_s)
			print(lv_r)
			if (lv_r == "0") then 
			#{
				EBSRV.GLBDATA.UniqueID = BANCS.OUTPARAM.UniqueID
			#}
			else
