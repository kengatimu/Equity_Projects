lv_d = "orgKey,idCnt|select orgkey,count(*) from crmuser.entitydocument where referencenumber=?SVAR and bank_id=?SVAR "
lv_d = lv_d + " and rownum<=1 group by orgkey"
BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
lv_u = urhk_dbSelectWithBind(lv_d)
if(lv_u==0)then
	EBSRV.GLBDATA.idCnt = BANCS.OUTPARAM.idCnt	
	EBSRV.GLBDATA.orgKey = BANCS.OUTPARAM.orgKey	
else
	EBSRV.GLBDATA.idCnt = 0
	EBSRV.GLBDATA.orgKey = ""
endif
