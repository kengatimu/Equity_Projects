<--START
	TRACE ON
	
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CCRRMV") == 0) THEN
	#{
		CREATECLASS("CUST", "CCRRMV", 5)
	#}
	ENDIF
	sv_a = 1
	print(sv_a)
	
	sv_s = "recCount"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT COUNT(*) FROM (SELECT DISTINCT REF_CODE,RCRE_USER_ID,trunc(RCRE_TIME) "
	sv_s = sv_s + " FROM CUSTOM.CCRRM WHERE status_code='V' AND bank_id='"+BANCS.STDIN.contextBankId+"' and RCRE_USER_ID!=?SVAR ) sub "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	CUST.CCRRMV.recCount = BANCS.OUTPARAM.recCount
	print(CUST.CCRRMV.recCount)
	
	sv_q = urhk_SetOrbOut("recCount|"+CUST.CCRRMV.recCount)
	
	sv_s = "refnumber,entryuser,entrydate"
	sv_s = sv_s + " | select DISTINCT REF_CODE,RCRE_USER_ID,trunc(RCRE_TIME) from CUSTOM.CCRRM where status_code='V' AND bank_id='"+BANCS.STDIN.contextBankId+"' and RCRE_USER_ID!=?SVAR order by trunc(RCRE_TIME) desc "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId
	print(sv_s)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	
	IF( sv_c != 0) THEN
	#{
		sv_u = urhk_SRV_SetErr("No records fetched for the entered Account Number")
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		
		WHILE( sv_c == 0)
		#{
			CUST.CCRRMV.count = sv_a
			print(CUST.CCRRMV.count)
			
			CUST.CCRRMV.refnumber= BANCS.OUTPARAM.refnumber
			print(CUST.CCRRMV.refnumber)
			
			CUST.CCRRMV.entryuser= BANCS.OUTPARAM.entryuser
			print(CUST.CCRRMV.entryuser)
			
			CUST.CCRRMV.entrydate= BANCS.OUTPARAM.entrydate
			print(CUST.CCRRMV.entrydate)
			
			sv_z = "refnumber_" + Format$(sv_a,"%d") + "|" + CUST.CCRRMV.refnumber
			print(sv_z)
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "entryuser_" + Format$(sv_a,"%d") + "|" + CUST.CCRRMV.entryuser
			print(sv_z)
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "entrydate_" + Format$(sv_a,"%d") + "|" + CUST.CCRRMV.entrydate
			print(sv_z)
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_a = sv_a + 1
			sv_c = urhk_dbCursorFetch(sv_l)
			print(sv_c)
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		exitscript
TRACE OFF		
END-->
