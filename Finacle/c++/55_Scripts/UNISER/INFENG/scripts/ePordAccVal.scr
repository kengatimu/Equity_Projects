<--start
trace on

sv_e = urhk_B2k_PrintRepos("BANCS")

IF(REPEXISTS("EBSRV")==0) THEN
#{
        CREATEREP("EBSRV")
#}
ENDIF

IF(CLASSEXISTS("EBSRV","GLBDATA")==0) THEN
#{
        CREATECLASS("EBSRV","GLBDATA",5)
#}
ENDIF

sv_b = urhk_getAcctDetailsInRepository(BANCS.INPUT.acctNum)
print(sv_b)
if(sv_b ==0)then
	sv_z=BANCS.OUTPARAM.schmCode
	print(sv_z)
	if(sv_z =="CA218")then
		EBSRV.GLBDATA.status="Y"
		sv_z = urhk_SetOrbOut("output|"+ EBSRV.GLBDATA.status)
		print(sv_z)
	else
		EBSRV.GLBDATA.status="N"
                sv_z = urhk_SetOrbOut("output|"+ EBSRV.GLBDATA.status)
                print(sv_z)	
	endif
endif

trace off
end-->
