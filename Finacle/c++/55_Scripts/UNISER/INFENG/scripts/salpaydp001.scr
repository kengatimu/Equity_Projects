		#{
			WHILE (sv_r == 0)
			#{
				CUST.DATA.counter = CINT(CUST.DATA.counter) + 1
				CUST.DATA.refcode = BANCS.OUTPARAM.refcode
				CUST.DATA.refdesc =BANCS.OUTPARAM.refdesc
				
