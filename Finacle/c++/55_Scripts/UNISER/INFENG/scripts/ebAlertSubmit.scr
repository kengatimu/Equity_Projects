EBSRV.GLBDATA.activateFlag = BANCS.INPUT.activateFlag
if(EBSRV.GLBDATA.phNum != "") then
#{
#}
endif
if(EBSRV.GLBDATA.email != "") then
#{
	lv_a = "EmailValidateCnt| select count(1) from dual "
	lv_a = lv_a + " where regexp_like(trim('"+EBSRV.GLBDATA.email+"'),'^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,6}$') "
	print(lv_a)
	lv_x = urhk_dbSelectWithBind(lv_a)
	print(lv_x)
	if (lv_x == 0) then
		EBSRV.GLBDATA.EmailValidateCnt = BANCS.OUTPARAM.EmailValidateCnt
		print(EBSRV.GLBDATA.EmailValidateCnt)
		if (CINT(EBSRV.GLBDATA.EmailValidateCnt) == 0) then
			EBSRV.GLBDATA.errMsg = "Invalid Email Address "
			print(EBSRV.GLBDATA.errMsg)
			GOTO ERR_RES
		endif
	else
		EBSRV.GLBDATA.EmailValidateCnt = "0"
	endif
#}
endif
if(EBSRV.GLBDATA.chrgAcc != "") then
#{
	lv_a = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.chrgAcc)
	print(lv_a)
	if(lv_a == 0) then
		EBSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
		print(EBSRV.GLBDATA.schmType)
	endif
	if((EBSRV.GLBDATA.schmType != "SBA") AND (EBSRV.GLBDATA.schmType != "CAA") AND (EBSRV.GLBDATA.schmType != "ODA")) then
