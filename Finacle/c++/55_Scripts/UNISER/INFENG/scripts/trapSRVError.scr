<--START
TRACE ON
	# Script body goes here
	#--------------------------------------------------------------------------------
	#Creating Error Repository and Class
	#--------------------------------------------------------------------------------
	IF (REPEXISTS("ERROR") == 0) THEN
	#{
		CREATEREP("ERROR")
	#}
	ENDIF
	IF (CLASSEXISTS("ERROR", "DATA") == 0) THEN
	#{
		CREATECLASS("ERROR", "DATA", 5)
	#}
	ENDIF
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.errorMsg = " "
	CUST.DATA.status = "F"
	CUST.DATA.messageSeperator = "\n"
	CUST.DATA.messageField = ""
	#------------------------------------------------------------------------------
	#Analysing the error and its statistics
	#------------------------------------------------------------------------------
	
	#sv_c = BANCS.OUTPARAM.Error_num
	
	#print(sv_c)
	PRINT(BANCS.OUTPARAM.Fatal_num)
	PRINT(BANCS.OUTPARAM.Error_num)
	PRINT(BANCS.OUTPARAM.Warning_num)
	PRINT(BANCS.OUTPARAM.UserInfo_num)
	PRINT(BANCS.OUTPARAM.Xcpn_num)
	PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
	PRINT(BANCS.OUTPARAM.Xcpn_Xcpn_num)
	PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
	
	
	#-------------------------------------------------------
	#printing the Error Messages
	#-------------------------------------------------------
	IF(FIELDEXISTS(("BANCS").("OUTPARAM").("Error_num"))== 1) THEN
	#{
		IF (CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
		#{
			
			#{
			sv_c = BANCS.OUTPARAM.Error_num
			sv_d = 1
			sv_i = 0
			WHILE(sv_d <= sv_c)
			#{
				PRINT(sv_d)
				PRINT(sv_c)
				sv_f = FORMAT$(sv_d, "%d")
				IF(FIELDEXISTS(("BANCS").("OUTPARAM").("ErrorMesg_" + sv_f))== 1) THEN
				#{
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_f)
					#}
				ELSE
					#{
					sv_e = " "
				#}
				ENDIF
				IF(FIELDEXISTS(("BANCS").("OUTPARAM").("ErrorCode_" + sv_f))== 1) THEN
				#{
					lv_e = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_f)
					#}
				ELSE
					#{
					lv_e = " "
				#}
				ENDIF
				PRINT(lv_e)
				PRINT(sv_e)
				ERROR.DATA.ErrorCode = lv_e
				#CUST.DATA.messageField = CUST.DATA.messageField + CUST.DATA.messageSeperator + lv_e
				IF(FIELDEXISTS(("BANCS").("OUTPARAM").("Tag_" + sv_f))== 1) THEN
				#{
					lv_e = ("BANCS").("OUTPARAM").("Tag_" + sv_f)
					#}
				ELSE
					#{
					lv_e = " "
				#}
				ENDIF
				PRINT(lv_e)
				PRINT(sv_e)
				#CUST.DATA.messageField = CUST.DATA.messageField + CUST.DATA.messageSeperator + sv_e
				
				
				PRINT(sv_e)
				CUST.DATA.messageField = sv_e
				CUST.DATA.errorMsg = CUST.DATA.errorMsg + CUST.DATA.messageSeperator + CUST.DATA.messageField
				sv_d = sv_d + 1
				sv_i = sv_i + 1
				
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	
	#------------------------------------------------------
	#printing the Warning Messages
	#-------------------------------------------------------
	IF(FIELDEXISTS(("BANCS").("OUTPARAM").("Warning_num"))== 1) THEN
	#{
		IF (CINT(BANCS.OUTPARAM.Warning_num) > 0) THEN
		#{
			sv_d = 1
			sv_i = 0
			WHILE(sv_d <= CINT(BANCS.OUTPARAM.Warning_num))
			#{
				sv_f = FORMAT$(sv_d, "%d")
				# Added as part of AutoLinking Of Margin Accounts SCR -- Start
				IF(FIELDEXISTS(("BANCS").("OUTPARAM").("WarningMesg_" + sv_f))== 1) THEN
				#{
					sv_e = ("BANCS").("OUTPARAM").("WarningMesg_" + sv_f)
					PRINT(sv_e)
					#}
				ELSE
					#{
					sv_e = " "
					PRINT(sv_e)
				#}
				ENDIF
				# Added as part of AutoLinking Of Margin Accounts SCR -- End
				
				CUST.DATA.messageField = sv_e
				CUST.DATA.errorMsg = CUST.DATA.errorMsg + CUST.DATA.messageSeperator + CUST.DATA.messageField
				
				sv_d = sv_d + 1
				sv_i = sv_i + 1
				
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	#-------------------------------------------------------
	#printing the User Information Messages
	#-------------------------------------------------------
	IF(FIELDEXISTS(("BANCS").("OUTPARAM").("UserInfo_num"))== 1) THEN
	#{
		IF (CINT(BANCS.OUTPARAM.UserInfo_num) > 0) THEN
		#{
			sv_d = 1
			WHILE(sv_d <= CINT(BANCS.OUTPARAM.UserInfo_num))
			#{
				sv_f = FORMAT$(sv_d, "%d")
				
				# Added as part of TO-401963/HD-920740 -- Start
				IF(FIELDEXISTS(("BANCS").("OUTPARAM").("UserInfoMesg_" + sv_f))== 1) THEN
				#{
					sv_e = ("BANCS").("OUTPARAM").("UserInfoMesg_" + sv_f)
					PRINT(sv_e)
					#}
				ELSE
					#{
					sv_e = " "
					PRINT(sv_e)
				#}
				ENDIF
				# Added as part of TO-401963/HD-920740 -- End
				
				CUST.DATA.messageField = sv_e
				CUST.DATA.errorMsg = CUST.DATA.errorMsg + CUST.DATA.messageSeperator + CUST.DATA.messageField
				
				sv_d = sv_d + 1
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	#-------------------------------------------------------
	#printing the Execption Messages
	#-------------------------------------------------------
	IF(FIELDEXISTS(("BANCS").("OUTPARAM").("Xcpn_num"))== 1) THEN
	#{
		IF (CINT(BANCS.OUTPARAM.Xcpn_num) > 0) THEN
		#{
			sv_d = 1
			WHILE(sv_d <= CINT(BANCS.OUTPARAM.Xcpn_num))
			#{
				sv_f = FORMAT$(sv_d, "%d")
				("CUST").("DATA").("XcpnCodeType" + sv_f) = ("BANCS").("OUTPARAM").("XcpnCodeType_" + sv_f)
				PRINT(("CUST").("DATA").("XcpnCodeType" + sv_f))
				("CUST").("DATA").("XcpnCode" + sv_f) = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
				PRINT(("CUST").("DATA").("XcpnCode" + sv_f))
				("CUST").("DATA").("XcpnDesc" + sv_f) = ("BANCS").("OUTPARAM").("XcpnDesc_" + sv_f)
				PRINT(("CUST").("DATA").("XcpnDesc" + sv_f))
				("CUST").("DATA").("XcpnAcctDesc" + sv_f) = ("BANCS").("OUTPARAM").("XcpnAcctDesc_" + sv_f)
				PRINT(("CUST").("DATA").("XcpnAcctDesc" + sv_f))
				("CUST").("DATA").("XcpnCondInd" + sv_f) = ("BANCS").("OUTPARAM").("XcpnCondInd_" + sv_f)
				PRINT(("CUST").("DATA").("XcpnCondInd" + sv_f))
				("CUST").("DATA").("XcpnContextInfo" + sv_f) = ("BANCS").("OUTPARAM").("XcpnContextInfo_" + sv_f)
				PRINT(("CUST").("DATA").("XcpnContextInfo" + sv_f))
				sv_e = ("BANCS").("OUTPARAM").("XcpnDesc_" + sv_f)
				PRINT(sv_e)
				CUST.DATA.messageField = sv_e
				CUST.DATA.errorMsg = CUST.DATA.errorMsg + CUST.DATA.messageSeperator + CUST.DATA.messageField
				sv_d = sv_d + 1
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	

EXITSCRIPT
END-->
