				sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CASH.WITH.Tod_Amt+"|"+ BANCS.STDIN.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_a + "refNum| "+CASH.WITH.tran_id)
