			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Security>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestHeader>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Header>"
			
			#-------------------------------------------------------------------------
			#- Forming the Body
			#-------------------------------------------------------------------------
			CUST.INTERFACE.bodyXMLMsg = ""
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Body>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<executeFinacleScriptRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ExecuteFinacleScriptInputVO>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<requestId>createPOthruFI.scr</requestId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</ExecuteFinacleScriptInputVO>"
