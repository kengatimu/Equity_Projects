ENDIF



####################
# default Values
# #################

CUST.DATA.VERSION="1"
CUST.DATA.STATUS="0"
CUST.DATA.CREATED_ON=BANCS.STDIN.sysDate
CUST.DATA.CREATED_BY=BANCS.STDIN.userId
CUST.DATA.MODIFIED_ON=BANCS.STDIN.sysDate
CUST.DATA.MODIFIED_BY =BANCS.STDIN.userId





####################
# Supplied  Values
# #################

CUST.DATA.BANK_CODE=BANCS.INPUT.BANK_CODE
CUST.DATA.SOL_ID=BANCS.INPUT.SOL_ID
CUST.DATA.DEBIT_ACCOUNT=BANCS.INPUT.DEBIT_ACCOUNT
CUST.DATA.TRAN_ACT_ENTITY_NICKNAME=BANCS.INPUT.TRAN_ACT_ENTITY_NICKNAME
CUST.DATA.TXN_ID=BANCS.INPUT.TXN_ID
CUST.DATA.REQ_ID=BANCS.INPUT.REQ_ID
CUST.DATA.PAYMENT_REF=BANCS.INPUT.PAYMENT_REF
CUST.DATA.PAYMENT_REF2=BANCS.INPUT.PAYMENT_REF2			
