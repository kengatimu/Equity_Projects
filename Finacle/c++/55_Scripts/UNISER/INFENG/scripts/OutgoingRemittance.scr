CUST.DATA.HASH=BANCS.INPUT.HASH
CUST.DATA.PAYMENT_ORIGINATING_REF = BANCS.INPUT.PAYMENT_ORIGINATING_REF	 



###################################
#Insert Record into the Database
###################################

   sv_u = "Insert into Custom.REM_OTHER_BANK_TBL (BANK_CODE,SOL_ID,DEBIT_ACCOUNT,TRAN_ACT_ENTITY_NICKNAME,TXN_ID,REQ_ID,PAYMENT_REF,PAYMENT_REF2,PAYMENT_ORIGINATING_REF,ENTRY_AMT,CREDIT_ACCT,CREDIT_ACCT_NAME,CREDIT_BANK,CREDIT_BRANCH,TXN_TYPE,TXN_DATE,VALUE_DATE,OTHR_BNK_FILE,PROCESS_STATE,STATUS,CREATED_ON,CREATED_BY,MODIFIED_ON,MODIFIED_BY,VERSION,HASH) Values ("
          sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') ,"
	  sv_u = sv_u + " to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR ,"
	  sv_u = sv_u + " ?SVAR )" 


BANCS.INPARAM.BINDVARS = CUST.DATA.BANK_CODE + "|" +  CUST.DATA.SOL_ID + "|" + CUST.DATA.DEBIT_ACCOUNT  + "|" + CUST.DATA.TRAN_ACT_ENTITY_NICKNAME + "|" + CUST.DATA.TXN_ID
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.REQ_ID  + "|" + CUST.DATA.PAYMENT_REF + "|" + CUST.DATA.PAYMENT_REF2 + "|" + CUST.DATA.PAYMENT_ORIGINATING_REF
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" +  CUST.DATA.ENTRY_AMT  + "|" + CUST.DATA.CREDIT_ACCT + "|" + CUST.DATA.CREDIT_ACCT_NAME + "|" +CUST.DATA.CREDIT_BANK
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.CREDIT_BRANCH  + "|" + CUST.DATA.TXN_TYPE  + "|" + CUST.DATA.TXN_DATE + "|" + CUST.DATA.VALUE_DATE
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.OTHR_BNK_FILE + "|" + CUST.DATA.PROCESS_STATE + "|" + CUST.DATA.STATUS + "|" + CUST.DATA.CREATED_ON
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.CREATED_BY  + "|" + CUST.DATA.MODIFIED_ON + "|" + CUST.DATA.MODIFIED_BY + "|" + CUST.DATA.VERSION + "|" + CUST.DATA.HASH


print(BANCS.INPARAM.BINDVARS)

  sv_e = urhk_dbSQLWithBind(sv_u)
  sv_f = urhk_dbSQLWithBind("commit")

print(sv_e)

if (sv_e==1) then
   CUST.DATA.errMsg="Database Error / BANK_CODE Number Already Exists"
   GOTO HandleError
else
  sv_u = urhk_SetOrbOut("status|Success")
endif



EXITSCRIPT



HandleError:
  sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 

EXITSCRIPT
trace off
end-->


  
