#  1.0             09-06-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
	sv_r = urhk_MTTS_PopulateInputDetails("")
	print(sv_r)
	if(sv_r==0)then
	#{
		EBSRV.GLBDATA.DrAcctId = MTT.InputDetails.Argument1
		EBSRV.GLBDATA.CifId = MTT.InputDetails.Argument2
		EBSRV.GLBDATA.ADmdAmt = cdouble(MTT.InputDetails.Argument3)
		EBSRV.GLBDATA.LiquidityModule = MTT.InputDetails.Argument4 
	else
		EBSRV.GLBDATA.DrAcctId = ""
		EBSRV.GLBDATA.CifId = ""
		EBSRV.GLBDATA.ADmdAmt = ""
		EBSRV.GLBDATA.LiquidityModule = ""
	#}
	endif
	if(EBSRV.GLBDATA.LiquidityModule=="MERNT-LM")then
		BANCS.INPUT.numDays = "7"
	else
		BANCS.INPUT.numDays = "3"
	endif
	BANCS.INPUT.numMonths = "0"
	BANCS.INPUT.addDays = (mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.INPUT.numMonths + "|" + BANCS.INPUT.numDays)
	sv_u = urhk_B2k_Add_MonthsDays_To_date(BANCS.INPUT.addDays)
	print(sv_u)
	if(sv_u != 0)then
		print("due date failed")
	else
		print(BANCS.OUTPARAM.MODIFIED_DATE)
		EBSRV.GLBDATA.dmdDate = BANCS.OUTPARAM.MODIFIED_DATE
	endif
	if(EBSRV.GLBDATA.LiquidityModule=="MERNT-LM")then
		BANCS.INPUT.numDays = "8"
	else
		BANCS.INPUT.numDays = "4"
	endif
	BANCS.INPUT.numMonths = "0"
	BANCS.INPUT.addDays = (mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.INPUT.numMonths + "|" + BANCS.INPUT.numDays)
	sv_u = urhk_B2k_Add_MonthsDays_To_date(BANCS.INPUT.addDays)
	print(sv_u)
	if(sv_u != 0)then
		print("over due date failed")
	else
		print(BANCS.OUTPARAM.MODIFIED_DATE)
		EBSRV.GLBDATA.dmdOvdDate = BANCS.OUTPARAM.MODIFIED_DATE
	endif
	sv_u = "SerialNum|select to_char(sysdate , 'DDMMYYYYHHMISS')from dual "
	sv_d = urhk_dbSelectWithBind(sv_u)
	if(sv_d==0)then
		EBSRV.GLBDATA.SerialNum = BANCS.OUTPARAM.SerialNum
	else
		EBSRV.GLBDATA.SerialNum	= ""
	endif
	EBSRV.GLBDATA.DccId = "BATCH"
	EBSRV.GLBDATA.Command = "CSWOP"
	EBSRV.GLBDATA.bclearBal = "0"
	EBSRV.GLBDATA.clearBal = "0"
	EBSRV.GLBDATA.TranId = "BATCH"
	print(EBSRV.GLBDATA.DrAcctId)
	print(EBSRV.GLBDATA.dmdDate)
	print(EBSRV.GLBDATA.dmdDate)
	print(EBSRV.GLBDATA.dmdOvdDate)
	print(EBSRV.GLBDATA.ADmdAmt)
	print(EBSRV.GLBDATA.TranId)
	print(EBSRV.GLBDATA.ADmdAmt)
	print(EBSRV.GLBDATA.DccId)
	print(EBSRV.GLBDATA.SerialNum)
	print(EBSRV.GLBDATA.Command)
	print(EBSRV.GLBDATA.bclearBal)
	print(EBSRV.GLBDATA.clearBal)
	print(EBSRV.GLBDATA.CifId)
	if(EBSRV.GLBDATA.LiquidityModule=="MERNT-LM")then
sv_d = "Insert into custom.mfddt (bank_id,foracid,sol_id,dmd_date,dmd_eff_date,dmd_ovdu_date,dmd_amt,tot_adj_amt,last_adj_date,dep_tran_id,dep_tran_amt,dep_dccid,dep_srl_num,dep_command,prev_acct_bal,aft_acct_bal,rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,entity_cre_flg,free_text1,free_text2,free_text3,free_text4,free_text5)"
	else
sv_d = "Insert into custom.agddt (bank_id,foracid,sol_id,dmd_date,dmd_eff_date,dmd_ovdu_date,dmd_amt,tot_adj_amt,last_adj_date,dep_tran_id,dep_tran_amt,dep_dccid,dep_srl_num,dep_command,prev_acct_bal,aft_acct_bal,rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,entity_cre_flg,free_text1,free_text2,free_text3,free_text4,free_text5)"
	endif
sv_d = sv_d + " values (?SVAR,?SVAR,?SVAR,to_date(?SVAR,'DD-MM-RR'),to_date(?SVAR,'DD-MM-RR'),to_date(?SVAR,'DD-MM-RR'),?NVAR,0,null,?SVAR,?NVAR,?SVAR,?SVAR,?SVAR,?NVAR,?NVAR,?SVAR,sysdate,?SVAR,sysdate,'N','Y',?SVAR,null,null,null,null) "
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.DrAcctId + "|" + BANCS.STDIN.mySolId + "|" + mid$(EBSRV.GLBDATA.dmdDate,0,10) + "|" + mid$(EBSRV.GLBDATA.dmdDate,0,10) + "|" + mid$(EBSRV.GLBDATA.dmdOvdDate,0,10)+ "|" + EBSRV.GLBDATA.ADmdAmt + "|" + EBSRV.GLBDATA.TranId + "|" + EBSRV.GLBDATA.ADmdAmt + "|" + EBSRV.GLBDATA.DccId + "|" + EBSRV.GLBDATA.SerialNum + "|" + EBSRV.GLBDATA.Command + "|" + EBSRV.GLBDATA.bclearBal + "|" + EBSRV.GLBDATA.clearBal + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EBSRV.GLBDATA.CifId
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSqlWithBind(sv_d)
	if(sv_u==0)then
		sv_u = urhk_dbSqlWithBind("commit")
		print(sv_u)
		exitscript
	else
		print("Agent & Merchant Liquidity Demand Creation Failed")
		exitscript
	endif
exitscript
trace off
end-->
