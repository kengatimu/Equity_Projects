<--START
CHECKSUM="5baae99099cd3621bccbaa04cec236cc0ffab372264400239f483140cd3763dc"
	TRACE ON
		sv_a = urhk_b2k_printRepos("BANCS")
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "SALPAY") == 0) THEN
	#{
		CREATECLASS("CUST", "SALPAY", 5)
	#}
	ENDIF
	CUST.SALPAY.errMsg = ""
	CUST.SALPAY.chgrcode = BANCS.INPUT.chgrcode
	PRINT(CUST.SALPAY.chgrcode)
	sv_s = ""
	sv_s = sv_s +" chrgCode|SELECT count(1) "
	sv_s = sv_s +" FROM  TBAADM.RCT "
	sv_s = sv_s +" WHERE ref_rec_type = '34' "
	sv_s = sv_s + " AND del_flg='N' "
	sv_s = sv_s + " AND bank_id= ?SVAR "
	sv_s = sv_s + " AND ref_code= ?SVAR "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.SALPAY.chgrcode
	PRINT(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d != 0) THEN
	#{
		CUST.SALPAY.errMsg = "Enter valid charge code"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF(BANCS.OUTPARAM.chrgCode == 0) THEN
		#{
			CUST.SALPAY.errMsg = "Enter valid charge code"
			GOTO ENDOFSCRIPT
			ELSE
				EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	ENDOFSCRIPT:
	sv_u = urhk_setOrbOut("Error|"+CUST.SALPAY.errMsg)
			print(sv_u)
	EXITSCRIPT
END-->
