<--START
CHECKSUM="ed67aeffa83e9507da48ac191f634f65a117f6add6537a1e60eccb12d8183d19"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","EODSETL") == 0) THEN
	#{
		CREATECLASS("CUST","EODSETL",5)
	#}
	ENDIF
	
	CUST.EODSETL.errMsg    = ""
	CUST.EODSETL.crAccount = ""
	CUST.EODSETL.drAccount = ""
	CUST.EODSETL.desc      = ""
	CUST.EODSETL.tranamt   = "0"
	CUST.EODSETL.Response = ""
	
	sv_a = BANCS.STDIN.mySolId
	CUST.EODSETL.solId = sv_a
	
	BANCS.INPUT.moduleName = "EODSETL"
	BANCS.INPUT.parameterId = "EODSETL_CRACCT"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EODSETL.crAccount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.EODSETL.errMsg = "Credit Account setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EODSETL"
	BANCS.INPUT.parameterId = "EODSETL_DESC"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EODSETL.desc = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.EODSETL.desc = ""
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EODSETL.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EODSETL.refCode)
		#}
	ELSE
		#{
		CUST.EODSETL.errMsg = "NORRATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_q="acid,bacid,drAccount,solId,bankId,balAmt|"
	sv_q = sv_q + "select acid,bacid,foracid,sol_id,bank_id,clr_bal_amt from tbaadm.gam where bank_id = ?SVAR AND sol_id = ?SVAR AND bacid in ('WESTUNSUB','WESTUNION2','WESTUNION1')"
	
	PRINT(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.EODSETL.solId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_q)
	PRINT(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUST.EODSETL.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUST.EODSETL.DbcursorNumber)
		PRINT(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUST.EODSETL.drAccount=BANCS.OUTPARAM.drAccount
			PRINT(CUST.EODSETL.drAccount)
			PRINT(CUST.EODSETL.crAccount)
			
			#------------------------------------------------------------------------------
			# Getting zoneDate, tranamt
			# Creating narration for tran remarks
			#------------------------------------------------------------------------------
			sv_s = "clearBalance |SELECT clr_bal_amt "
			sv_s = sv_s + "FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE bank_id = ?SVAR "
			sv_s = sv_s + "AND  foracid = ?SVAR "
			sv_s = sv_s + "AND entity_cre_flg ='Y' "
			sv_s = sv_s + "AND acct_cls_flg ='N' "
			sv_s = sv_s + "AND del_flg ='N' "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.EODSETL.drAccount
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d == 0) THEN
			#{
				CUST.EODSETL.amount = BANCS.OUTPARAM.clearBalance
				PRINT(CUST.EODSETL.amount)
				#}
				
			#}
			ELSE
				#{
				CUST.EODSETL.amount = "0"
			#}
			ENDIF
			
			IF (CINT(CUST.EODSETL.amount) == 0) THEN
			#{
				EXITSCRIPT
			#}
			ENDIF
			
			CUST.EODSETL.narr = CUST.EODSETL.desc
			PRINT(CUST.EODSETL.narr)
			
			#--------------------------------------------------------------------------
			# Initialise the MTT repository
			#--------------------------------------------------------------------------
			
			sv_r = REPEXISTS("MTT")
			IF (sv_r == 0) THEN
			#{
				CREATEREP("MTT")
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("MTT","TranDetails")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("MTT","TranDetails",5)
			#}
			ENDIF
			
			sv_r = REPEXISTS("BANCS")
			IF (sv_r == 0) THEN
			#{
				CREATEREP("BANCS")
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("BANCS","INPARAM")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("BANCS","INPARAM",5)
			#}
			ENDIF
			
			#===================================
			# STEP 1 : INITIALIZE THE MTT
			#===================================
			
			BANCS.INPARAM.PostTranFlg 		= "Y"
			BANCS.INPARAM.CommitFlg 		= "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg 	= "Y"
			BANCS.INPARAM.ValidationFlag 		= "Y"
			BANCS.INPARAM.RestrictModifyInd 	= "FIRST_GROUP"
			BANCS.INPARAM.ErrorCheckForLuw 		= "Y"
			BANCS.INPARAM.CheckExceptions 		= "N"
			
			
			
			#sv_r = urhk_MTTS_Initialize("")
			#print(sv_r)
			
			sv_u = urhk_MTTS_PopulateInputDetails("")
			
			PRINT(BANCS.STDIN.BODDate)
			#MTT.TranDetails.TranDate= "0"
			MTT.TranDetails.TranType = "T"
			MTT.TranDetails.TranSubType = "BI"
			MTT.TranDetails.IgnoreExcp = "I"
			MTT.TranDetails.Consolidate = "Y"
			MTT.TranDetails.Remarks = "PREMIUM COLLECTION"
			
			
			sv_v = "PurchaseComm"
			PRINT(sv_v)
			
			sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
			PRINT(sv_u)
			
			#sv_u = urhk_MTTS_PopulateInputDetails("")
			#--------------------------------------------------
			# Credit to HO
			#--------------------------------------------------
			
			MTT.PartTranDetails.Account = CUST.EODSETL.crAccount
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.EODSETL.narr
			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.EODSETL.amount)
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = ""
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_e = "PurchaseIncome"
			sv_r = urhk_MTTS_definePartTran(sv_e)
			PRINT(sv_r)
			
			#------------------------------------------------------------------
			# Debit From BR
			#------------------------------------------------------------------
			
			MTT.PartTranDetails.Account = CUST.EODSETL.drAccount
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.EODSETL.narr
			sv_a = CDOUBLE(CUST.EODSETL.amount )
			sv_a = -(sv_a)
			PRINT(sv_a)
			MTT.PartTranDetails.RefAmount = sv_a
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = ""
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			
			
			sv_h = "D" + CUST.EODSETL.drAccount
			sv_r = urhk_MTTS_definePartTran(sv_h)
			IF (sv_r == 1) THEN
			#{
				PRINT("Unable to create MTT Part transaction")
				CUST.EQUIF.errMsg = "Transaction creation Failed."
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#############################
			# Commit the transaction
			#############################
			sv_u = urhk_MTTS_EndDefinition("")
			PRINT(sv_u)
			
			CUST.EODSETL.TranId = BANCS.OUTPARAM.MTTTranId
			PRINT(CUST.EODSETL.TranId)
			
			##################################################
			# If any error tran id will not be created
			##################################################
			IF ((sv_u != 0)  OR (CUST.EODSETL.TranId==""))THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT (MTT.Error.Description)
				CUST.EODSETL.ResStatus = "F"
				CUST.EODSETL.Response = "Transaction creation Failed."
				BANCS.OUTPUT.successOrFailure = "F"
				#GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			
			
			sv_k = urhk_dbCursorFetch(CUST.EODSETL.DbcursorNumber)
			PRINT(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUST.EODSETL.DbcursorNumber)
		PRINT(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.EODSETL.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.EODSETL.errMsg+"' >>EODSETL122.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
