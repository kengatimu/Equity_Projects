<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(fieldexists(BANCS.INPUT.ODAcctId)==1)then
                EQSRV.GLBDATA.odAcctId = BANCS.INPUT.ODAcctId
        else
                EQSRV.GLBDATA.odAcctId = ""
        endif
        if(fieldexists(BANCS.INPUT.EventType)==1)then
                EQSRV.GLBDATA.EventType = BANCS.INPUT.EventType
        else
                EQSRV.GLBDATA.EventType = ""
        endif
	EQSRV.GLBDATA.dshdlNum = "" 
	EQSRV.GLBDATA.dFlowId = "" 
	EQSRV.GLBDATA.dodAcid = "" 
	EQSRV.GLBDATA.dOpAcid = "" 
	EQSRV.GLBDATA.dDmdDate = "" 
	EQSRV.GLBDATA.dDmdOvduDate = "" 
	EQSRV.GLBDATA.ddmdAmt = "" 
	EQSRV.GLBDATA.dtotAdjAmt = "" 
	EQSRV.GLBDATA.dDueAmt = "" 
	EQSRV.GLBDATA.cRepayAmt = "0"
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.odAcctId)
        if(sv_u==0)then
        #{
                print(BANCS.OUTPARAM.sanctionLimit)
                        EQSRV.GLBDATA.csanctionLimit = BANCS.OUTPARAM.sanctionLimit
                print(BANCS.OUTPARAM.cleanAdhocLimit)
