		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotOutstandingAmt |0")
		endif
		if(cdouble(EQSRV.GLBDATA.dDueAmt)>0)then
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.isDmdValid |Y")
		else 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.isDmdValid |N")
		endif
		if(EQSRV.GLBDATA.isOverdue!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.isOverDueYN |" + EQSRV.GLBDATA.isOverdue ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.isDmdOverdue |" + EQSRV.GLBDATA.isOverdue ) 
		else
