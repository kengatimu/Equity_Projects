                print(BANCS.OUTPARAM.ClearBalance)
                        EQSRV.GLBDATA.cClearBalance = BANCS.OUTPARAM.ClearBalance
                EQSRV.GLBDATA.cClearBalance1 = BANCS.OUTPARAM.ClearBalance
                print(EQSRV.GLBDATA.cClearBalance1)
                print(BANCS.OUTPARAM.DACCLimit)
                print(BANCS.OUTPARAM.FxFFDAvailableAmt)
                print(BANCS.OUTPARAM.FFDAvailableAmt)
                print(BANCS.OUTPARAM.lienAmt)
                print(BANCS.OUTPARAM.FxEffAvailableAmt)
                print(BANCS.OUTPARAM.EffAvailableAmt)
                print(BANCS.OUTPARAM.systemGeneratedLimit)
                print(BANCS.OUTPARAM.SystemReservedAmt)
                print(BANCS.OUTPARAM.singleTranLimit)
                print(BANCS.OUTPARAM.cleanSingleTranLimit)
                EBSRV.GLBDATA.odsolid = BANCS.OUTPARAM.acctSolId
                print(EBSRV.GLBDATA.odsolid)
                EBSRV.GLBDATA.OdAcctId=EQSRV.GLBDATA.odAcctId
                print(EBSRV.GLBDATA.OdAcctId)
                EBSRV.GLBDATA.odSchmCode = BANCS.OUTPARAM.schmCode
                EBSRV.GLBDATA.odcrncyCdoe = BANCS.OUTPARAM.acctCrncyCode
	#}
	else
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Account")
                exitscript
	#}
	endif
	print(EQSRV.GLBDATA.EventType)
        if(EQSRV.GLBDATA.EventType=="INTRUN")then
                goto LINTRUN
        endif
	lv_j = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.odAcctId)
	if(lv_j == 0) then
		EBSRV.GLBDATA.digitOdAcid = BANCS.OUTPARAM.Acid
	else
		EBSRV.GLBDATA.digitOdAcid = ""
	endif
	print(EBSRV.GLBDATA.digitOdAcid)
        lv_g = "cRepayAmt | select nvl(sum(tran_amt),0) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and pstd_flg='Y' and part_tran_type='C' and tran_date <= (select db_stat_date from tbaadm.gct where bank_id=?SVAR ) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.digitOdAcid  + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	print(lv_g)
        lv_r = urhk_dbSelectWithBind(lv_g)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.cRepayAmt = BANCS.OUTPARAM.cRepayAmt
	#}
        else
	#{
                EQSRV.GLBDATA.cRepayAmt = "0"
	#}
        endif
	print(EQSRV.GLBDATA.cRepayAmt)
	lv_h = "cumDrAmt,cumCrAmt |  select nvl(cum_dr_amt,0),nvl(cum_cr_amt,0) from tbaadm.gam where bank_id=?SVAR and acid=?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.digitOdAcid
	print(lv_h)
	print(BANCS.INPARAM.BINDVARS)
	lv_h = urhk_dbSelectWithBind(lv_h)
	if(lv_h==0)then
	#{
		EQSRV.GLBDATA.cumDrAmt = BANCS.OUTPARAM.cumDrAmt
		EQSRV.GLBDATA.cumCrAmt = BANCS.OUTPARAM.cumCrAmt
	else
		EQSRV.GLBDATA.cumDrAmt = "0"
		EQSRV.GLBDATA.cumCrAmt = "0"
	#}
	endif
	print(EQSRV.GLBDATA.cumDrAmt)
	print(EQSRV.GLBDATA.cumCrAmt)
        lv_g = "cDrAmt | select nvl(sum(tran_amt),0) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and pstd_flg='Y' and part_tran_type='D' and tran_date <= (select db_stat_date from tbaadm.gct where bank_id=?SVAR ) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.digitOdAcid  + "|" + BANCS.STDIN.contextBankId
        lv_r = urhk_dbSelectWithBind(lv_g)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.cDrAmt = BANCS.OUTPARAM.cDrAmt
	#}
        else
	#{
                EQSRV.GLBDATA.cDrAmt = "0"
	#}
        endif
	print(EQSRV.GLBDATA.cDrAmt)

	lv_b = " intDmdAmt |  select nvl(dmd_amt,0) from custom.odla_dmd_tbl where bank_id=?SVAR and od_acid=?SVAR and del_flg='N' and entity_cre_flg='Y' and flow_id='INDEM' and rownum<=1 "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.digitOdAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_b)
	lv_b = urhk_dbSelectWithBind(lv_b)
	if(lv_b==0)then
	#{
		EQSRV.GLBDATA.intDmdAmt = BANCS.OUTPARAM.intDmdAmt
	else
		EQSRV.GLBDATA.intDmdAmt = "0"
	#}
	endif
	print(EQSRV.GLBDATA.intDmdAmt)
	lv_b = " prinDmdAmt |  select nvl(dmd_amt,0) from custom.odla_dmd_tbl where bank_id=?SVAR and od_acid=?SVAR and del_flg='N' and entity_cre_flg='Y' and flow_id='PRDEM' and rownum<=1 "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.digitOdAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_b)
	lv_b = urhk_dbSelectWithBind(lv_b)
	if(lv_b==0)then
	#{
		EQSRV.GLBDATA.prinDmdAmt = BANCS.OUTPARAM.prinDmdAmt
	else
		EQSRV.GLBDATA.prinDmdAmt = "0"
	#}
	endif
	print(EQSRV.GLBDATA.prinDmdAmt)
        lv_i = " naccrAmt,nbookAmt,nappAmt,nintRate,inintFreqTy,nintFreqStD,accrDtDr,bookDtDr,calcDtDr,nxtDtDr | select nrml_accrued_amount_dr,nrml_booked_amount_dr,nrml_interest_amount_dr,interest_rate,int_freq_type_dr,int_freq_start_dd_dr,to_char(accrued_upto_date_dr,'DD-MM-RRRR'),to_char(booked_upto_date_cr,'DD-MM-RRRR'),to_char(interest_calc_upto_date_dr,'DD-MM-RRRR'),to_char(next_int_run_date_dr,'DD-MM-RRRR') from tbaadm.eit where bank_id=?SVAR and entity_id=?SVAR  "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.digitOdAcid 
        lv_b = urhk_dbSelectWithBind(lv_i)
        if(lv_b==0)then
	#{
                EQSRV.GLBDATA.naccrAmt = BANCS.OUTPARAM.naccrAmt
                EQSRV.GLBDATA.nbookAmt = BANCS.OUTPARAM.nbookAmt
                EQSRV.GLBDATA.nappAmt = BANCS.OUTPARAM.nappAmt
                EQSRV.GLBDATA.nintRate = BANCS.OUTPARAM.nintRate
                EQSRV.GLBDATA.inintFreqTy = BANCS.OUTPARAM.inintFreqTy
                EQSRV.GLBDATA.nintFreqStD = BANCS.OUTPARAM.nintFreqStD
                EQSRV.GLBDATA.accrDtDr = BANCS.OUTPARAM.accrDtDr
                EQSRV.GLBDATA.bookDtDr = BANCS.OUTPARAM.bookDtDr
                EQSRV.GLBDATA.calcDtDr = BANCS.OUTPARAM.calcDtDr
                EQSRV.GLBDATA.nxtDtDr = BANCS.OUTPARAM.nxtDtDr
	#}
        else
	#{
                EQSRV.GLBDATA.naccrAmt = ""
                EQSRV.GLBDATA.nbookAmt = ""
                EQSRV.GLBDATA.nappAmt = ""
                EQSRV.GLBDATA.nintRate = ""
                EQSRV.GLBDATA.inintFreqTy = ""
                EQSRV.GLBDATA.nintFreqStD = ""
                EQSRV.GLBDATA.accrDtDr = ""
                EQSRV.GLBDATA.bookDtDr = ""
                EQSRV.GLBDATA.calcDtDr = ""
                EQSRV.GLBDATA.nxtDtDr = ""
	#}
        endif
        if(cdouble(EQSRV.GLBDATA.nintRate)<=0)then
                EQSRV.GLBDATA.nintRate = -1 * cdouble(EQSRV.GLBDATA.nintRate)
        endif
        if(EQSRV.GLBDATA.accrDtDr!="")then
	#{
                BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10)
                BANCS.INPARAM.date2 = EQSRV.GLBDATA.accrDtDr
                sv_u = urhk_B2K_dateDiff("")
                print(sv_u)
                if(sv_u == 0 ) then
                        EQSRV.GLBDATA.migdatediff = BANCS.OUTPARAM.dateDiff
                        EQSRV.GLBDATA.futmigdatediff = BANCS.OUTPARAM.dateDiff
                else
                        EQSRV.GLBDATA.migdatediff = "0"
                        EQSRV.GLBDATA.futmigdatediff = "0"
                endif
	#}
        else
	#{
                EQSRV.GLBDATA.migdatediff = "1"
                EQSRV.GLBDATA.futmigdatediff = "1"
	#}
        endif
        if(cdouble(EQSRV.GLBDATA.migdatediff)<=0)then
                EQSRV.GLBDATA.migdatediff = -1 * cdouble(EQSRV.GLBDATA.migdatediff)
        endif


        lv_s = "lSanLim,lSanDate,lExpDate | select sanct_lim,lim_sanct_date,lim_exp_Date from tbaadm.lht where bank_id=?SVAR and acid=(select acid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR) and entity_cre_flg='Y' and del_flg='N' and status='A' and serial_num in (select max(serial_num)  from tbaadm.lht where bank_id=?SVAR and acid=(select acid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR) and entity_cre_flg='Y' and del_flg='N' and status='A') "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId
        print(lv_s)
        print(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSelectWithBind(lv_s)
        if(lv_r==0)then
        #{
                EQSRV.GLBDATA.lSanLim = BANCS.OUTPARAM.lSanLim
                EQSRV.GLBDATA.lSanDate = BANCS.OUTPARAM.lSanDate
                EQSRV.GLBDATA.lExpDate = BANCS.OUTPARAM.lExpDate
        #}
        else
        #{
                EQSRV.GLBDATA.lSanLim = ""
                EQSRV.GLBDATA.lSanDate = ""
                EQSRV.GLBDATA.lExpDate = ""
        #}
        endif
        print(EQSRV.GLBDATA.lSanLim)
        print(EQSRV.GLBDATA.lSanDate)
        print(EQSRV.GLBDATA.lExpDate)
        if(EQSRV.GLBDATA.odAcctId!="")then
	#{
                sv_u = urhk_SetOrbOut("ODAccountId|" + EQSRV.GLBDATA.odAcctId )
	#}
        endif
        if(EBSRV.GLBDATA.odSchmCode!="")then
	#{
                sv_u = urhk_SetOrbOut("ODSchmCode|" + EBSRV.GLBDATA.odSchmCode )
	#}
        endif
        if(EQSRV.GLBDATA.lSanLim!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSanctionLimit|" + EQSRV.GLBDATA.lSanLim )
	#}
        endif
        if(EQSRV.GLBDATA.lSanDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSanctionDate|" + EQSRV.GLBDATA.lSanDate )
	#}
        endif
        if(EQSRV.GLBDATA.lExpDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastExpiryDate|" + EQSRV.GLBDATA.lExpDate )
	#}
        endif
        if(EQSRV.GLBDATA.cClearBalance!="")then
	#{
                sv_u = urhk_SetOrbOut("TotalDue|" + EQSRV.GLBDATA.cClearBalance1 )
	#}
        endif
        if(EQSRV.GLBDATA.cDrAmt!="")then
	#{
                sv_u = urhk_SetOrbOut("TotalDisburseAmt|" + EQSRV.GLBDATA.cDrAmt )
	#}
        endif
        ##if(EQSRV.GLBDATA.odDisbDate!="")then
	#{
         ##       sv_u = urhk_SetOrbOut("LastDisburseDate|" + EQSRV.GLBDATA.lSanDate ) 
	#}
        ##endif
                ##sv_u = urhk_SetOrbOut("LastSchdlNum|" + EQSRV.GLBDATA.SchdlNum )
                sv_u = urhk_SetOrbOut("uptoDateInt|0") 
        print(EQSRV.GLBDATA.migdatediff)
        if(cdouble(EQSRV.GLBDATA.migdatediff)==cdouble("0"))then
        ##if(cdouble(EQSRV.GLBDATA.migdatediff)>=cdouble("0"))then
                sv_u = urhk_SetOrbOut("InterestRunDate|Y")
        else
                sv_u = urhk_SetOrbOut("InterestRunDate|N")
        endif
	print(EQSRV.GLBDATA.cRepayAmt)
	print(EQSRV.GLBDATA.cumDrAmt)
	print(EQSRV.GLBDATA.cumCrAmt)
                sv_u = urhk_SetOrbOut("TotalRepaidAmount|" + EQSRV.GLBDATA.cumCrAmt ) 
		if(cdouble(EQSRV.GLBDATA.cClearBalance1)>=0)then
                sv_u = urhk_SetOrbOut("NumberOfRepayment|0") 
		else
                sv_u = urhk_SetOrbOut("NumberOfRepayment|1") 
		endif
		if(cdouble(EQSRV.GLBDATA.cClearBalance1)>=0)then
			sv_u = urhk_SetOrbOut("InstallementAmount|0")
		else
			sv_u = urhk_SetOrbOut("InstallementAmount|" + EQSRV.GLBDATA.cumDrAmt )
		endif
		if(cdouble(EQSRV.GLBDATA.cClearBalance1)>=0)then
			sv_u = urhk_SetOrbOut("InterestInstallementAmount|0") 
		else
			sv_u = urhk_SetOrbOut("InterestInstallementAmount|" + EQSRV.GLBDATA.intDmdAmt )
		endif
		if(cdouble(EQSRV.GLBDATA.cClearBalance1)>=0)then
			sv_u = urhk_SetOrbOut("PrinInstallementAmount|0") 
		else
			sv_u = urhk_SetOrbOut("PrinInstallementAmount|" + EQSRV.GLBDATA.prinDmdAmt )
		endif
	lv_d = " dshdlNum,dFlowId,dodAcid,dOpAcid,dDmdDate,dDmdOvduDate,ddmdAmt,dtotAdjAmt,dDueAmt,isOverdue,dpdValue |  select shdl_num,flow_id,od_acid,op_acid,dmd_date,dmd_ovdu_date,dmd_amt,tot_adj_amt,dmd_amt-tot_adj_amt as totDue,(case when dmd_date< (select db_stat_date from tbaadm.gct where bank_id=?SVAR) and dmd_amt-tot_adj_amt >0 then 'Y' else 'N' end)isoverdue,(case when dmd_date< (select db_stat_date from tbaadm.gct where bank_id=?SVAR) and  dmd_amt-tot_adj_amt >0 then (select to_date(trunc(db_stat_date),'DD-MM-RRRR') from tbaadm.gct where bank_id=?SVAR) - to_date(trunc(dmd_date),'DD-MM-RRRR') else 0 end)as dpd from custom.odla_dmd_tbl where bank_id=?SVAR and od_acid=?SVAR and dmd_amt>0 and entity_cre_flg='Y' and del_flg='N' order by shdl_num,dmd_date "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.digitOdAcid 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_d)
        lv_u = urhk_dbCursorOpenWithBind(lv_d)
        if(lv_u == 0)then
	#{
                EQSRV.GLBDATA.drCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	#}
        else
	#{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Loan Demand Not Exists ,Demand Creation was Failed on Loan Creation")
                goto SIFNO
	#}
        endif
        EQSRV.GLBDATA.recNum = 0
        EQSRV.GLBDATA.dpdVal = 0
        lv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.drCurNum)
        if(lv_f !=0)then
	#{
                lv_f = urhk_dbCursorClose(EQSRV.GLBDATA.drCurNum)
                print(lv_f)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Loan Demand Not Exists ,Demand Creation was Failed on Loan Creation")
                EQSRV.GLBDATA.isRecYN="N"
                goto SIFNO
	#}
        else
	#{
                EQSRV.GLBDATA.isRecYN="Y"
	#}
        endif
        while(lv_f ==0)
	#{
		EQSRV.GLBDATA.dshdlNum = BANCS.OUTPARAM.dshdlNum
		EQSRV.GLBDATA.dFlowId = BANCS.OUTPARAM.dFlowId
		EQSRV.GLBDATA.dodAcid = BANCS.OUTPARAM.dodAcid
		EQSRV.GLBDATA.dOpAcid = BANCS.OUTPARAM.dOpAcid
		EQSRV.GLBDATA.dDmdDate = BANCS.OUTPARAM.dDmdDate
		EQSRV.GLBDATA.dDmdOvduDate = BANCS.OUTPARAM.dDmdOvduDate
		EQSRV.GLBDATA.ddmdAmt = BANCS.OUTPARAM.ddmdAmt
		EQSRV.GLBDATA.dtotAdjAmt = BANCS.OUTPARAM.dtotAdjAmt
		EQSRV.GLBDATA.dDueAmt = BANCS.OUTPARAM.dDueAmt
		EQSRV.GLBDATA.isOverdue = BANCS.OUTPARAM.isOverdue
		EQSRV.GLBDATA.dpdValue = BANCS.OUTPARAM.dpdValue
		if(EQSRV.GLBDATA.dshdlNum!="")then
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.SchdlNum |" + EQSRV.GLBDATA.dshdlNum )
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.SchdlNum |0")
		endif
		if(EQSRV.GLBDATA.dFlowId!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.FlowId |" + EQSRV.GLBDATA.dFlowId ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdFlowCode |" + EQSRV.GLBDATA.dFlowId ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdFlowCode |NA")
		endif
		if(EQSRV.GLBDATA.dDmdDate!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DemandDate |" + EQSRV.GLBDATA.dDmdDate ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdDate |" + EQSRV.GLBDATA.dDmdDate ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdDate |NA")
		endif
		if(EQSRV.GLBDATA.dDmdOvduDate!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DemandOverDueDate |" + EQSRV.GLBDATA.dDmdOvduDate ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdOverDueDate |" + EQSRV.GLBDATA.dDmdOvduDate ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdOverDueDate |NA")
		endif
		if(EQSRV.GLBDATA.ddmdAmt!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DemandAmount |" + EQSRV.GLBDATA.ddmdAmt ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdAmount  |" + EQSRV.GLBDATA.ddmdAmt ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdAmount  |0")
		endif
		if(EQSRV.GLBDATA.dtotAdjAmt!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.PaidAmount |" + EQSRV.GLBDATA.dtotAdjAmt ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotAdjAmt |" + EQSRV.GLBDATA.dtotAdjAmt ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotAdjAmt |0")
		endif
		if(EQSRV.GLBDATA.dDueAmt!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DueAmount |" + EQSRV.GLBDATA.dDueAmt ) 
