		endif
		if(EQSRV.GLBDATA.dpdValue!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DPDCnt |" + EQSRV.GLBDATA.dpdValue ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DPD  |" + EQSRV.GLBDATA.dpdValue ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DPD  |0")
		endif

                NXTREC:
                lv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.drCurNum)
                EQSRV.GLBDATA.recNum = cint(EQSRV.GLBDATA.recNum) + 1
	#}
        do
