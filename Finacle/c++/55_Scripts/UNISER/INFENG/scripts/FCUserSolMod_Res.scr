<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether INTERFACE Class exists else create it
	###########################################################################################
		
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	
	CUST.INTERFACE.status 			= ""
	CUST.INTERFACE.errorCode 		= ""
	CUST.INTERFACE.errorDesc 		= ""
	CUST.INTERFACE.core_respCode	= ""
	CUST.INTERFACE.core_mesg 		= ""
	CUST.INTERFACE.core_errorCode	= ""
	CUST.INTERFACE.core_errorDesc	= ""
	CUST.INTERFACE.core_errorMsgFlg = "" 
	CUST.INTERFACE.core_userId 		= ""
	CUST.INTERFACE.core_ErrorSource = "" 
	CUST.INTERFACE.core_ErrorType 	= ""

	
	
	sv_x = CUST.INTERFACE.respXMLMsg
	
	#--------------------------------------------------------------------------------------------------------
	# Fetching the status of the request
	#--------------------------------------------------------------------------------------------------------
	sv_y = "<HostTransaction>"
	sv_z = "</HostTransaction>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.ubusStuatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		sv_x = CUST.INTERFACE.ubusStuatus
		PRINT(sv_x)
		sv_y = "<Status>"
		sv_z = "</Status>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.status = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
			PRINT(CUST.INTERFACE.status)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.status = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.status)
	
	#--------------------------------------------------------------------------------------------------------
	# If Success the fetch other values from the response xml
	#--------------------------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.status == "SUCCESS") THEN
	#{
		CUST.INTERFACE.core_errorMsgFlg = "N"
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<FCUserProfileModResponse>"
		sv_z = "</FCUserProfileModResponse>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			
			sv_y = "<FCUserProfileModRs>"
			sv_z = "</FCUserProfileModRs>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<userId>"
				sv_z = "</userId>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.core_userId = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
				#}
				ENDIF	
			#}
			ENDIF
		#}
		ENDIF
		
		
		#}
	ELSE
		#{
		CUST.INTERFACE.core_errorMsgFlg = "Y"
		IF((CUST.INTERFACE.status == "FAILED") OR (CUST.INTERFACE.status == "FAILURE")) THEN
		#{
			sv_x = CUST.INTERFACE.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.core_errorCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
				PRINT(CUST.INTERFACE.errorCode)
			#}
			ENDIF
			IF(CUST.INTERFACE.core_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorDesc>"
				sv_z = "</ErrorDesc>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.core_errorDesc = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,80)
					PRINT(CUST.INTERFACE.core_errorDesc )
				#}
				ENDIF
				
			#}
			ENDIF
			IF(CUST.INTERFACE.core_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorSource>"
				sv_z = "</ErrorSource>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.core_ErrorSource = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,80)
					PRINT(CUST.INTERFACE.core_ErrorSource )
				#}
				ENDIF
				
			#}
			ENDIF
			IF(CUST.INTERFACE.core_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorType>"
				sv_z = "</ErrorType>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.core_ErrorType = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
					PRINT(CUST.INTERFACE.core_ErrorType)
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		IF((CUST.INTERFACE.core_errorCode == "") AND (CUST.INTERFACE.core_errorDesc == "")) THEN
		#{
			CUST.INTERFACE.core_errorCode = "SYSERR"
			CUST.INTERFACE.core_errorDesc = "Could not get response from server"
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.INTERFACE.core_errorMsgFlg)
	
	PRINT(CUST.INTERFACE.core_errorCode)
	PRINT(CUST.INTERFACE.core_errorDesc)

	
	
	
	#TRACE OFF
END-->
