			ENDIF
		ENDIF

	#}
# -------------------------------------------------------------------------------
#	The below if statement takes care of exiting from the script when key-exit
#	is pressed from bafi2020
# -------------------------------------------------------------------------------

	IF(STDWFS.GLBDATA.f3Pressed == "Y") THEN
		GOTO Complete
	ENDIF
	        sv_r = "mcfe3009.datablk.report_to|" + STDWFS.GLBDATA.reportto
                print (sv_r)
                sv_r = urhk_TBAF_SetValue(sv_r)
                sv_r = "mcfe3009.datablk.tran_sub_type|" +STDWFS.GLBDATA.transubtype
                print (sv_r)
                sv_r = urhk_TBAF_SetValue(sv_r)
