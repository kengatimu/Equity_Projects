	sv_a = urhk_TBAF_SetValue("aafe0002.datablk.field_6|" + STDWFS.GLBDATA.rename)

	sv_a = urhk_TBAF_SetAttrib("aafe0002.datablk.field_1|P")
	sv_a = urhk_TBAF_SetAttrib("aafe0002.datablk.field_2|P")
	sv_a = urhk_TBAF_SetAttrib("aafe0002.datablk.field_3|M")
	sv_a = urhk_TBAF_SetAttrib("aafe0002.datablk.field_4|M")
	sv_a = urhk_TBAF_SetAttrib("aafe0002.datablk.field_5|P")
	sv_a = urhk_TBAF_SetAttrib("aafe0002.datablk.field_6|P")

	sv_u = urhk_TBAF_SetKeyScript("aafe0002.datablk.key-help|EquiloanUpload_dp01.scr|0")
