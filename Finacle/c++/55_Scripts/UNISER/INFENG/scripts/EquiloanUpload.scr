<--start
trace on
sv_n = CINT(STDWFS.WFSINPUT.NextStep)

WHILE (1)
GOSUB Initialise
GOSUB ShowStartUpForm
GOTO Finish

#-----------------------------------------------------------------
# Initialise is used to Check whether Class GLBDATA exists.
# If not then creates that class.
# 5 stands for String Type data.
#-----------------------------------------------------------------
Initialise:
#{
	sv_r = REPEXISTS("STDWFS")
	IF (sv_r == 0) THEN
		CREATEREP("STDWFS")
	ENDIF

	sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
	IF (sv_r == 0) THEN
		CREATECLASS("STDWFS", "GLBDATA", 5)
	ENDIF

	sv_r = CLASSEXISTS("STDWFS", "WFSLIST")
	IF (sv_r == 0) THEN
		CREATECLASS("STDWFS", "WFSLIST", 5)
	ENDIF

	sv_r = CLASSEXISTS("STDWFS", "WFSTYPE")
	IF (sv_r == 0) THEN
		CREATECLASS("STDWFS", "WFSTYPE", 5)
	ENDIF

	STDWFS.GLBDATA.f3Pressed = "N"
	STDWFS.GLBDATA.upload = "N"
	
	IF (FIELDEXISTS(STDWFS.GLBDATA.Function)) THEN
		print("FIELDEXISTS")
	ELSE

	STDWFS.GLBDATA.reportto = "MANAGER" 
	STDWFS.GLBDATA.transubtype = "CI"
	STDWFS.GLBDATA.uploadfilename = ""
	STDWFS.GLBDATA.test = ""
	STDWFS.GLBDATA.remarks = "Equiloan Loan Recoveries"
	STDWFS.GLBDATA.rename = ""
	STDWFS.GLBDATA.file = "EquiloanUpload.txt"

		
	ENDIF

	RETURN
#}
#---------------------------------------------------------------------------
# ShowStartUpForm is used to show a param acceptance form for accepting
# a. Module Name
# It also validates the above fields on key-accept
#---------------------------------------------------------------------------
ShowStartUpForm:
#{

	sv_a = urhk_TBAF_SetValue("aafe0002.datablk.header_title|" + "EQUILOAN UPLOAD")
