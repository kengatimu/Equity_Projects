		print(sv_t)

		sv_u = urhk_TBAF_CallBatchExe(sv_t)
	#}
         
	 #{
	    #----sending the processed file to the user loaction


		sv_u="name|select substr('" + STDWFS.GLBDATA.uploadfilename + "',1,INSTR('" + STDWFS.GLBDATA.uploadfilename + "','.') - 1) from dual"
		print(sv_u)
		sv_d = urhk_dbSelect(sv_u)
		print(sv_d)
		IF (sv_d ==0) THEN
			STDWFS.GLBDATA.filename=BANCS.OUTPARAM.name
			print(STDWFS.GLBDATA.filename)
			sv_a="sysdate|select to_char(sysdate,'ddmmyy')  from dual"
			print(sv_a)
			sv_f = urhk_dbSelect(sv_a)
			IF (sv_f != 0 ) THEN
				print("hai")  
				sv_c = urhk_TBAF_DispMesg("A Database error has occured. Please contact your DBA.")
				EXITSCRIPT
			else
				sv_b = BANCS.OUTPARAM.sysdate
				print(sv_b)
