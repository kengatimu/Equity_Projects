	sv_u = urhk_TBAF_SetKeyScript("aafe0002.datablk.key-f2|EquiloanUpload_dp02.scr|1")
			       
        sv_a = urhk_B2K_ShowParamAcptFrm("aafe0002")

	If (STDWFS.WFSOUTPUT.ErrorCode=="-9999") THEN
	 goto complete
	endif


	#{
	    #----Sending upload  file to user loacation


		sv_x = urhk_getFileLocation("COM|EquiloanUpload.com")
		print(sv_x)

		sv_l = BANCS.OUTPARAM.fileLocation
