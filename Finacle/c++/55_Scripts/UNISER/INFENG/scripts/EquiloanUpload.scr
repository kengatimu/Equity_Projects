		print(STDWFS.GLBDATA.remarks)
                sv_r = "mcfe3009.datablk.inp_file_name|" + STDWFS.GLBDATA.file
                print (sv_r)
                sv_r = urhk_TBAF_SetValue(sv_r)
                IF (STDWFS.GLBDATA.test == "Y") THEN
                        STDWFS.GLBDATA.ttumsal_mod = "T"
			STDWFS.GLBDATA.Rename = ""
                ELSE
                        STDWFS.GLBDATA.ttumsal_mod = "P"
			STDWFS.GLBDATA.Rename = "Y"
                ENDIF
                print(STDWFS.GLBDATA.ttumsal_mod)
		print(STDWFS.GLBDATA.Rename)
                sv_r = "mcfe3009.datablk.fire_bfti_flg|" + STDWFS.GLBDATA.ttumsal_mod
                print (sv_r)
                sv_r = urhk_TBAF_SetValue(sv_r)
                sv_r = "mcfe3009.datablk.remarks|" + STDWFS.GLBDATA.remarks
                print (sv_r)
                sv_r = urhk_TBAF_SetValue(sv_r)
                sv_r = "mcfe3009.datablk.rename_inp_file|" + STDWFS.GLBDATA.Rename
                print (sv_r)
                sv_r = urhk_TBAF_SetValue(sv_r)
                sv_a = urhk_TBAF_SetReplayKey("mcfe3009.datablk.key-f2")
                sv_a = urhk_TBAF_SetReplayKey("bafe3021.headerblk.key-commit|Chq_FBmnu.scr|0")
                sv_a = urhk_TBAF_SetReplayKey("mcfe3009.datablk.key-f1")
                sv_r = urhk_WFS_CallMenuOption("TTUM|0|1")

		If (STDWFS.WFSOUTPUT.ErrorCode=="-9999") THEN
			goto complete
		endif

                IF (sv_r == 1 ) THEN
                        STDWFS.WFSINPUT.WfsStatus = "D"
                        exitscript
                ENDIF


		RETURN

	#}

