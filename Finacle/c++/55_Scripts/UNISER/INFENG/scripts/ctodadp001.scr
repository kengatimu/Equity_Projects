#----------------------------------------------------------------------------------------------------------
# Filename              :       ctodadp001.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script custom searcher of Availment request Id.
# Input                 :       func Code,Account Id
# Output                :       Populate seacher values
# Called Script         :       None
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           03-04-2013         Nitin Prabhakar   original Version          1.0
#  2           02-08-2013         Bharath			Modified for TOL 364759
#  3		04-09-2013	  Kalvin	   modified for fetching sold d in crit screen 1.3
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="b91a4332af5c5dd5663c273f2197e3e234951ddbbddc2fde22d8d06be17a9b6f"
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CTODA") == 0) THEN
	#{
		CREATECLASS("CUST", "CTODA", 5)
	#}
	ENDIF
	CUST.CTODA.solId = ""
	CUST.CTODA.solid = ""
	CUST.CTODA.status = ""
	#------------------------------------------------------------------------------
	#  Declaration of variables used in script
	#------------------------------------------------------------------------------
	CUST.CTODA.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.CTODA.bankId)
	CUST.CTODA.funcCode = TRIM(BANCS.INPUT.funcCode)
	print(CUST.CTODA.funcCode)
	CUST.CTODA.accNum = TRIM(BANCS.INPUT.accNum)
	print(CUST.CTODA.accNum)
	#------------------------------------------------------------------------------
	#  sold id added by Pankaj for CR 367775
	#------------------------------------------------------------------------------
	CUST.CTODA.solId = TRIM(BANCS.STDIN.mySolId)
	CUST.CTODA.recCount = "0"
	#========================================================
	# Fetching the Record count
	#========================================================
	BANCS.INPARAM.BINDVARS = CUST.CTODA.bankId
	IF (CUST.CTODA.accNum != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accNum
	#}
	ENDIF
	IF (CUST.CTODA.funcCode == "V") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" + CUST.CTODA.solId
	#}
	ENDIF
	
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "recCount|"
	sv_s = sv_s + " SELECT COUNT(REQUEST_ID)"
	sv_s = sv_s + " FROM CUSTOM.C_TODA "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR "
	IF (CUST.CTODA.accNum != "") THEN
	#{
		sv_s = sv_s + " AND ACCT_NUM = ?SVAR"
	#}
	ENDIF
	IF (CUST.CTODA.funcCode == "I") THEN
	#{
		sv_s = sv_s + " AND VERIFY_BY IS NOT NULL"
		#}
	ELSE
		#{
		sv_s = sv_s + " AND VERIFY_BY IS NULL"
	#}
	ENDIF
	IF (CUST.CTODA.funcCode == "V") THEN
	#{
		sv_s = sv_s + " AND SOL_ID = ?SVAR"
	#}
	ENDIF
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.CTODA.recCount = BANCS.OUTPARAM.recCount
		print(CUST.CTODA.recCount)
		#}
	ELSE
		#{
		CUST.CTODA.recCount = "0"
		print(CUST.CTODA.recCount)
	#}
	ENDIF
	sv_u = urhk_SetOrbOut("recCount|"+CUST.CTODA.recCount)
	print(sv_u)
	IF(CUST.CTODA.recCount=="0")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#  Fetching data for seracher from table C_TODA
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.CTODA.bankId
	IF (CUST.CTODA.accNum != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accNum
	#}
	ENDIF
	IF (CUST.CTODA.funcCode == "V") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" + CUST.CTODA.solId
	#}
	ENDIF
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "availReqId,accNumS,grantDate,expiryDate,createdBy,solid,status|"
	sv_s = sv_s + " SELECT REQUEST_ID,ACCT_NUM,GRANT_DATE,EXPIRY_DATE,created_by"
	sv_s = sv_s + " ,SOL_ID,STATUS_FLG "
	sv_s = sv_s + " FROM CUSTOM.C_TODA "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR "
	IF (CUST.CTODA.accNum != "") THEN
	#{
		sv_s = sv_s + " AND ACCT_NUM = ?SVAR"
	#}
	ENDIF
	IF (CUST.CTODA.funcCode == "I") THEN
	#{
		sv_s = sv_s + " AND VERIFY_BY IS NOT NULL"
		#}
	ELSE
		#{
		sv_s = sv_s + " AND VERIFY_BY IS NULL"
	#}
	ENDIF
	IF (CUST.CTODA.funcCode == "V") THEN
	#{
		sv_s = sv_s + " AND SOL_ID = ?SVAR"
	#}
	ENDIF
	print(sv_s)
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	IF (sv_c != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.CTODA.cursorNumber= BANCS.OUTPARAM.DB_CURSOR_NUMBER
	#--------------------------------------------------------------------------
	# Fetch data in a loop and assign it to output, sending it to searcher.
	#--------------------------------------------------------------------------
	sv_c = urhk_dbCursorFetch(CUST.CTODA.cursorNumber)
	IF (sv_c != 0) THEN
	#{
		sv_c = urhk_dbCursorClose(CUST.CTODA.cursorNumber)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_n = 0
	WHILE (sv_c == 0)
	#{
		CUST.CTODA.availReqId = BANCS.OUTPARAM.availReqId
		print(CUST.CTODA.availReqId)
		CUST.CTODA.accNumS = BANCS.OUTPARAM.accNumS
		print(CUST.CTODA.accNumS)
		CUST.CTODA.grantDate = BANCS.OUTPARAM.grantDate
		print(CUST.CTODA.grantDate)
		CUST.CTODA.expiryDate = BANCS.OUTPARAM.expiryDate
		print(CUST.CTODA.expiryDate)
		CUST.CTODA.createdBy = BANCS.OUTPARAM.createdBy
		print(CUST.CTODA.createdBy)
		
		CUST.CTODA.solid = BANCS.OUTPARAM.solid
		print(CUST.CTODA.solid)
		CUST.CTODA.status = BANCS.OUTPARAM.status
		print(CUST.CTODA.status)
		
		sv_n = sv_n + 1
		# sending data to custom seracher.   (availReqId)
		IF (CUST.CTODA.availReqId == "") THEN
		#{
			sv_o = "availReqId_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.availReqId
			#}
		ELSE
			#{
			sv_o = "availReqId_" + FORMAT$(sv_n,"%d")+"|" + CUST.CTODA.availReqId
		#}
		ENDIF
		sv_u =urhk_SetOrbOut(sv_o)
		# accNum
		IF (CUST.CTODA.accNum == "") THEN
		#{
			sv_o = "accNum_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.accNumS
			#}
		ELSE
			#{
			sv_o = "accNum_" + FORMAT$(sv_n,"%d")+"|" +  CUST.CTODA.accNumS
		#}
		ENDIF
		sv_u =urhk_SetOrbOut(sv_o)
		# grantDate
		IF (CUST.CTODA.accNum == "") THEN
		#{
			sv_o = "grantDate_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.grantDate
			#}
		ELSE
			#{
			sv_o = "grantDate_" + FORMAT$(sv_n,"%d")+"|" +  CUST.CTODA.grantDate
		#}
		ENDIF
		sv_u =urhk_SetOrbOut(sv_o)
		# expiryDate
		IF (CUST.CTODA.accNum == "") THEN
		#{
			sv_o = "expiryDate_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.expiryDate
			#}
		ELSE
			#{
			sv_o = "expiryDate_" + FORMAT$(sv_n,"%d")+"|" +  CUST.CTODA.expiryDate
		#}
		ENDIF
		sv_u =urhk_SetOrbOut(sv_o)
		# bankId
		IF (CUST.CTODA.accNum == "") THEN
		#{
			sv_o = "createdBy_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.createdBy
			#}
		ELSE
			#{
			sv_o = "createdBy_" + FORMAT$(sv_n,"%d")+"|" +  CUST.CTODA.createdBy
		#}
		ENDIF
		sv_u =urhk_SetOrbOut(sv_o)
		IF (CUST.CTODA.accNum == "") THEN
		#{
			sv_o = "TOD_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.status
			#}
		ELSE
			#{
			sv_o = "TOD_" + FORMAT$(sv_n,"%d")+"|" +  CUST.CTODA.status
		#}
		ENDIF
		sv_u =urhk_SetOrbOut(sv_o)
		
		IF (CUST.CTODA.accNum == "") THEN
		#{
			sv_o = "acctSolId_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.solid
			#}
		ELSE
			#{
			sv_o = "acctSolId_" + FORMAT$(sv_n,"%d")+"| " + CUST.CTODA.solid
		#}
		ENDIF
		sv_u =urhk_SetOrbOut(sv_o)
		# Fetching next record
		sv_c = urhk_dbCursorFetch(CUST.CTODA.cursorNumber)
	#}
	DO
	sv_c = urhk_dbCursorClose(CUST.CTODA.cursorNumber)
	ENDOFSCRIPT:
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","CTODA") != 0) THEN
		#{
			DELETECLASS ("CUST","CTODA")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
