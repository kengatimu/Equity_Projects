			CUST.KCBR.acctname = BANCS.OUTPARAM.acctname
			PRINT(CUST.KCBR.acctname)
			
			sv_z = sv_z + 1
			CUST.KCBR.Counter = sv_z
			
			CUST.GCHRG.tranType = "T"
			CUST.GCHRG.tranSubType = "BI"
			CUST.GCHRG.drAcctId = CUST.KCBR.foracid
			CUST.GCHRG.tot_amt1 = CUST.KCBR.tot_amt1
