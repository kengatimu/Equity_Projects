	sv_s = sv_s + "WHERE INSTR (?SVAR,CONCAT(CONCAT(',',SUBSTR(foracid,5,13)),',')) > 0 "
	sv_s = sv_s + "AND DTD.del_flg = 'N' AND GAM.acid = DTD.acid "
	sv_s = sv_s + "AND GAM.sol_id = DTD.sol_id AND DTD.sol_id = ?SVAR AND DTD.bank_id = GAM.bank_id AND DTD.bank_id = ?SVAR ) "
	sv_s = sv_s + "AND GAM.acct_ownership = 'O' AND GAM.acct_crncy_code = ?SVAR AND GAM.acct_cls_flg = 'N' "
