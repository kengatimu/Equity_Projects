			CALL("gchrgcommon.scr")
			
			IF( CUST.GCHRG.successOrFailure == "S" ) THEN
			#{
				sv_m ="echo '"+ CUST.KCBR.foracid + "|" + CUST.KCBR.tot_amt1 + "|" + CUST.KCBR.acctname + "|" + CUST.GCHRG.tranId + "| Chages collected SuccessFull' >>sucess.lst"
