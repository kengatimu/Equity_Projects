	#--------------------------------------------------------------------------
	# Selecting accounts from DTD
	#--------------------------------------------------------------------------
	
	sv_s = "foracid,tot_amt1,acctname|SELECT GAM.foracid,NVL(sum(decode(part_tran_type,'C',tran_amt)),0) - NVL(sum(decode(part_tran_type,'D',tran_amt)),0) AS tot_amt,GAM.acct_name "
	sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.DTD "
	sv_s = sv_s + "WHERE GAM.acid = DTD.acid "
	sv_s = sv_s + "AND GAM.sol_id = DTD.sol_id "
	sv_s = sv_s + "AND GAM.acct_ownership = 'O' "
	sv_s = sv_s + "AND GAM.acct_crncy_code = ?SVAR"
	sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
	sv_s = sv_s + "AND GAM.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND DTD.TRAN_PARTICULAR != 'Excise Duty Fee Collection'"
	sv_s = sv_s + "AND ((DTD.TRAN_RMKS != 'Excise Duty Fee Collection') OR (DTD.TRAN_RMKS IS NULL))"
	sv_s = sv_s + "AND DTD.del_flg = 'N' "
	sv_s = sv_s + "AND DTD.sol_id = ?SVAR "
	sv_s = sv_s + "AND DTD.bank_id = GAM.bank_id "
	sv_s = sv_s + "AND DTD.bank_id = ?SVAR "
	sv_s = sv_s + "AND DTD.acid IN (SELECT acid FROM TBAADM.GAM WHERE INSTR (?SVAR,CONCAT(CONCAT(',',SUBSTR(foracid,5,13)),',')) > 0 "
	sv_s = sv_s + "AND bank_id = ?SVAR AND del_flg = 'N' AND entity_cre_flg = 'Y') "
	sv_s = sv_s + "GROUP BY GAM.foracid,GAM.acct_name "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeCrncyCode + "|" + CUST.KCBR.solId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.KCBR.acct + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_o = urhk_dbCursorOpenWithBind(sv_s)
