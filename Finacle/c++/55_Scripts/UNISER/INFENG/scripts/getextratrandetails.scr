						sv_s ="freetext1,freetext2|select freetext1,freetext2 from tbaadm.ocp where bank_id =?SVAR and acid in (select acid  from tbaadm.gam where foracid =?SVAR)"
						sv_s = sv_s + "and CLG_ZONE_CODE =?SVAR and tran_amt = to_number (?SVAR) and SOL_ID=?SVAR and CLG_ZONE_DATE=to_date(?SVAR,'DD-MM-RR')"
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.Foracid + "|" + CUST.GETDATADRC.zoneC + "|" + CUST.GETDATADRC.tranAmt +"|" + CUST.GETDATADRC.ZoneSol + "|" + CUST.GETDATADRC.ZonDate 
						print(sv_s)
						print(BANCS.INPARAM.BINDVARS)
						sv_u = urhk_dbSelectWithBind(sv_s)
						if(sv_u==0)then		
							CUST.GETDATADRC.RefNo = BANCS.OUTPARAM.freetext1
							print(CUST.GETDATADRC.RefNo)
							CUST.GETDATADRC.Name = BANCS.OUTPARAM.freetext2
							print(CUST.GETDATADRC.Name)
							CUST.GETDATADRC.TranParticular="Outward Unpaid Cheque"
							CUST.GETDATADRC.TranParticular = CUST.GETDATADRC.TranParticular + "/" + CUST.GETDATADRC.RefNo + "-" + CUST.GETDATADRC.Name
							BANCS.OUTPUT.TranParticular = CUST.GETDATADRC.TranParticular
							print(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular = LEFT$(BANCS.OUTPUT.TranParticular,50)
							print(BANCS.OUTPUT.TranParticular)
						else
							CUST.GETDATADRC.TranParticular="Outward Unpaid Cheque"	
							BANCS.OUTPUT.TranParticular = CUST.GETDATADRC.TranParticular
							print(BANCS.OUTPUT.TranParticular)
						endif
				else
