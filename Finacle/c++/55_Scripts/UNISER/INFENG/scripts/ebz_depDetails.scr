#------------------------------------------------------------------------------------------------
#  Name            : ebz_depSummary.scr
#  Description     : fetchs Term Deposit accounts attached to a CIF
#  Date            : 05-09-2023
#  Author          : Harrison Ruiru
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             05-09-2023     Harrison Ruiru		Original Version
#-----------------------------------------------------------------------------------------------

#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	BANCS.INPUT.CIFId = "54307483357"

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CIFId"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="please enter CIFId"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "MSG | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------
	CUST.EZB.schm_type = "TDA"

	#----------------------------------------------------------------------------------------------
	# validations
	#----------------------------------------------------------------------------------------------

	sv_q = "acct_crncy_code,dep_acct_no,schm_code,schm_desc,accrued_amt_cr, accrued_amt_dr,booking_Date,rate_of_interest,deposit_amt,tenor_mths,tenor_dys,maturity_date,maturity_amt,deposit_bal |"
	sv_q = sv_q + "select * from (select acct_crncy_code,foracid,schm_code,"
	sv_q = sv_q + " (SELECT SCHM_DESC FROM TBAADM.GSP gsp WHERE gsp.SCHM_CODE=g.schm_code AND BANK_ID=?SVAR) schm_desc,"
	sv_q = sv_q + " (select NRML_ACCRUED_AMOUNT_CR from tbaadm.eit e where bank_id=?SVAR and e.entity_id = g.acid ) accrued_amt_cr, "
	sv_q = sv_q + " (select NRML_ACCRUED_AMOUNT_DR from tbaadm.eit e where bank_id=?SVAR and e.entity_id = g.acid ) accrued_amt_dr,"
	sv_q = sv_q + " (SELECT BOOKED_UPTO_DATE_CR FROM TBAADM.EIT e WHERE e.ENTITY_ID=g.acid) booking_Date, "
	sv_q = sv_q + " (SELECT INTEREST_RATE FROM TBAADM.EIT e WHERE e.ENTITY_ID=g.acid) rate_of_interest, "
	sv_q = sv_q + " (SELECT ORIGINAL_DEPOSIT_AMOUNT FROM TBAADM.TAM t WHERE t.ACID=g.acid) deposit_amt, "
	sv_q = sv_q + " (SELECT DEPOSIT_PERIOD_MTHS FROM TBAADM.TAM t WHERE t.ACID=g.acid) tenor_mths, "
	sv_q = sv_q + " (SELECT DEPOSIT_PERIOD_DAYS FROM TBAADM.TAM t WHERE t.ACID=g.acid) tenor_dys,"
	sv_q = sv_q + " (SELECT MATURITY_DATE FROM TBAADM.TAM t WHERE t.ACID=g.acid) maturity_date, "
	sv_q = sv_q + " (SELECT MATURITY_AMOUNT FROM TBAADM.TAM t WHERE t.ACID=g.acid) maturity_amt, "
	sv_q = sv_q + " (SELECT CUMULATIVE_INSTL_PAID FROM TBAADM.TAM t WHERE t.ACID=g.acid) deposit_bal "
	sv_q = sv_q + " from tbaadm.gam g where "
	sv_q = sv_q + " g.cif_id=?SVAR and g.schm_type=?SVAR )"
	print(sv_q)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId+"|"+BANCS.STDIN.contextBankId+"|"+BANCS.STDIN.contextBankId+"|"+BANCS.INPUT.CIFId+"|"+CUST.EZB.schm_type
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbcursorOpenWithBind(sv_q)
	PRINT(sv_c)

	IF (sv_c == 0)THEN
	#{
		CUST.EZB.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.EZB.cursor_number)

		sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
		print(sv_d)

		sv_q = 0
		print(sv_q)

		WHILE (sv_d == 0)
		#{
			sv_q = sv_q + 1
			print(sv_q)

			sv_v = "DepAcctNo_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.dep_acct_no

			sv_v = "DepSchmCode_" + FORMAT$(sv_q, "%d") 
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.schm_code

			sv_v = "DepAmount_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.deposit_amt

			sv_v = "BookingDate_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.booking_Date

			sv_v = "Currency_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.acct_crncy_code

			sv_v = "TenorMths_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.tenor_mths

			sv_v = "TenorDys_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.tenor_dys

			sv_v = "MaturityDate_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.maturity_date

			sv_v = "MaturityAmount_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.maturity_amt

			sv_v = "RateOfInterest_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.rate_of_interest

			sv_v = "DepositBalance_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.deposit_bal

			sv_v = "DepositDescription_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.schm_desc

			sv_v = "AccrDrInterest_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.accrued_amt_dr

			sv_v = "AccrCrInterest_" + FORMAT$(sv_q, "%d")
			("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.accrued_amt_cr

			print(sv_v)

			sv_v = "DepAcctNo_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DepositAccountNumber| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "DepSchmCode_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DepositTypeCode| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "DepAmount_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DepositAmount| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "BookingDate_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.BookingDate| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "Currency_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.Currency| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "TenorMths_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.TenorMonths| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "TenorDys_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.TenorDays| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "MaturityDate_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.MaturityDate| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "MaturityAmount_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.MaturityAmount| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "RateOfInterest_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.RateOfInterest| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "DepositBalance_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DepositBalance| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "DepositDescription_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DepositDescription| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "AccrDrInterest_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.accrdrinterest| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_v = "AccrCrInterest_" + FORMAT$(sv_q, "%d")
			sv_t = "DepositSummary_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.accrcrinterest| " + ("CUST").("EZB").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)

			sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
			print(sv_d)

		#} 
		DO 

		sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
		print(sv_x)
		print(CUST.EZB.cursor_number)
	#}
	ENDIF


ENDSCRIPT:
trace off
END-->

