TRACE ON

CUST.INTERFACE.showError = ""
CUST.INTERFACE.callFlg = ""
CUST.INTERFACE.parameterId = ""

print(CUST.INTERFACE.DrAcct)
print(CUST.INTERFACE.CrAcct)

#-------------------------------------------------------------------------------
# Converting the TranDate into the rquired format
#-------------------------------------------------------------------------------

CUST.INTERFACE.TranDate = BANCS.STDIN.BODDate

IF(CUST.INTERFACE.InstrType == "CHQ") THEN
#{
	#-------------------------------------------------------------------------------
	# Setting inputs and outputs for SRV_AddTransferTran.
	#-------------------------------------------------------------------------------
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_a = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")
	sv_a = urhk_SetUrhkInp("tranDtl.remarks|" + CUST.INTERFACE.TranRefNum) 
	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	sv_a = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_a = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
	sv_a = urhk_SetUrhkInp("tranDtl.deliveryChannelId|" + CUST.INTERFACE.ChannelId)

	#-------------------------------------------------------------------------------
	# Debit Leg.
	#-------------------------------------------------------------------------------
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + CUST.INTERFACE.TranDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|" + CUST.INTERFACE.DrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|" + CUST.INTERFACE.DrTranAmt + "|" + CUST.INTERFACE.DrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranAmt|" + CUST.INTERFACE.DrTranAmt + "|" + CUST.INTERFACE.DrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|" + CUST.INTERFACE.DrAcct)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|" + BANCS.STDIN.BODDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|" + CUST.INTERFACE.DrTranPart)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars2|" + CUST.INTERFACE.DrTranPart2)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|" + CUST.INTERFACE.DrRemarks)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refNum|" + CUST.INTERFACE.TranRefNum)
	

	CUST.INTERFACE.srNo = CINT("2")
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_a = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")
	sv_a = urhk_SetUrhkInp("tranDtl.remarks|" + CUST.INTERFACE.TranRefNum) 
	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	sv_a = urhk_SetUrhkInp("tranDtl.remarks|" + CUST.INTERFACE.TranRefNum) 
	
	#-------------------------------------------------------------------------------
	# Credit Leg.
	#-------------------------------------------------------------------------------
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|" + CUST.INTERFACE.srNo)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + CUST.INTERFACE.TranDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|" + CUST.INTERFACE.CrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|" + CUST.INTERFACE.CrTranAmt + "|" + CUST.INTERFACE.CrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranAmt|" + CUST.INTERFACE.CrTranAmt + "|" + CUST.INTERFACE.CrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|" + CUST.INTERFACE.CrAcct)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|" + BANCS.STDIN.BODDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|" + CUST.INTERFACE.CrTranPart)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars2|" + CUST.INTERFACE.CrTranPart2)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|" + CUST.INTERFACE.CrRemarks)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|" + CUST.INTERFACE.TranRefNum)
	

	#-------------------------------------------------------------------------------
	# Execution of Service.
	#-------------------------------------------------------------------------------
	sv_a = urhk_ExecSrvNoCommit("SRV_AddTransferTran|retain_all_output = Y")
	print(sv_a)
	IF(sv_a != "0") THEN
	#{
		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ELSE
	#{
		CUST.INTERFACE.tranId = BANCS.OUTPARAM.tranId
		CUST.INTERFACE.tranDate = BANCS.OUTPARAM.tranDate
	#}
	ENDIF
	
	print(CUST.INTERFACE.tranId)
	print(CUST.INTERFACE.tranDate)

	#-------------------------------------------------------------------------------
	# Calling the service to copy all details.
	#-------------------------------------------------------------------------------
	  sv_a = urhk_CopyOutToIn("")
	  print(sv_a)
	  CUST.INTERFACE.tranDate = MID$(CUST.INTERFACE.tranDate,0,10)
	  CUST.INTERFACE.tranId = lpad(CUST.INTERFACE.tranId, 9, ' ')

	  sv_a = urhk_SetUrhkInp("tranDtl.tranIdentifier.tranDate|" +CUST.INTERFACE.tranDate)
	  sv_a = urhk_SetUrhkInp("tranDtl.tranIdentifier.tranId|"+CUST.INTERFACE.tranId)

	#-------------------------------------------------------------------------------
	# Calling the service to fetch the details.
	#-------------------------------------------------------------------------------
	  sv_a = urhk_ExecSrvNoCommit("SRV_FetchTransferTranForPost|retain_all_output = Y")
	  print(sv_a)
	  IF(sv_a != "0") THEN
	  #{
		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	  #}
	  ENDIF

	  sv_s = BANCS.OUTPARAM.successOrFailure
	  sv_a = urhk_CopyOutToIn("")

	  sv_a = urhk_SetUrhkInp("tranDtl.tranIdentifier.tranDate|" +CUST.INTERFACE.tranDate)
	  sv_a = urhk_SetUrhkInp("tranDtl.tranIdentifier.tranId|" +CUST.INTERFACE.tranId)

	#-------------------------------------------------------------------------------
	# Calling the service to Post the transaction.
	#-------------------------------------------------------------------------------
	  sv_d = urhk_ExecSrvNoCommit("SRV_PostTransferTran|same_user_verify = Y|retain_all_output = Y|call_mode = N")
	  print(sv_d) 
	  IF(sv_d != "0") THEN
	  #{
		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	  #}
	  ENDIF
#}
