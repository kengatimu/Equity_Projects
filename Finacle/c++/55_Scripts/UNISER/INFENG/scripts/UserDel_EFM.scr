<--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
	####################################################################
	# EFM ADD
	####################################################################
	CUST.INTERFACE.efm_EFMErrors = " "
	CALL("EFMDel_Req.scr")
	CALL("finacleUserAdd_urhk.scr")
	CALL("EFMDel_Res.scr")
	
	

	IF(CUST.INTERFACE.efm_errorMsgFlg != "N")THEN
	#{
		sv_a = "EFMDel_RES.Status|ERROR"
		IF((CUST.INTERFACE.efm_errorCode=="") AND (CUST.INTERFACE.efm_errorDesc==""))THEN
		#{
			CUST.INTERFACE.efm_errorCode = "SYSERR"
			CUST.INTERFACE.efm_errorDesc = "Could not get response from server"
		#}
		ENDIF	
		sv_z = "EFMDel_RES.efm_errorDesc| " + CUST.INTERFACE.efm_errorDesc 
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
		
		CUST.INTERFACE.EFM_USER_FLG  = "FAILURE"
		CUST.INTERFACE.EFM_REMARKS  = CUST.INTERFACE.efm_errorDesc 		
		CUST.INTERFACE.GOTO = "Y"
		
	#}
	ELSE
	#{
		IF(CUST.INTERFACE.efm_respStatus == "SUCCESS")THEN
		#{
			PRINT(CUST.INTERFACE.efm_respStatus)
			sv_z = "EFMDel_RES.Status|SUCCESS"
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
			CUST.INTERFACE.EFM_USER_FLG  = "SUCCESS"
			CUST.INTERFACE.EFM_REMARKS = CUST.INTERFACE.efm_mesg
			
		#}
		ELSE
		#{
			
			PRINT(CUST.INTERFACE.efm_respStatus)
			sv_z = "EFMDel_RES.Status|FAILURE"
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
			
			IF(TRIM(CUST.INTERFACE.efm_EFMErrors) == "")THEN
			#{
				CUST.INTERFACE.efm_EFMErrors = CUST.INTERFACE.efm_respErrorMessage
				PRINT(CUST.INTERFACE.efm_EFMErrors)
			#}
			ENDIF
			
			BANCS.INPUT.InpString = CUST.INTERFACE.efm_EFMErrors
			BANCS.INPUT.replace = "&"
			BANCS.INPUT.replaceWith = ""
			PRINT(BANCS.INPUT.InpString)
			BANCS.INPUT.OutputString = ""
			CALL("Replacecharacter.scr")
			CUST.INTERFACE.efm_EFMErrors = BANCS.INPUT.OutputString
			
			sv_a = "l_err|select replace(?SVAR,'lt;','<') from dual"
			
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.efm_EFMErrors
			sv_d = urhk_dbSelectWithBind(sv_a)
			
			IF(sv_d == 0) THEN
			#{
				CUST.INTERFACE.efm_EFMErrors  = BANCS.OUTPARAM.l_err
				
			#}
			ENDIF
			
			sv_a = "r_err|select replace(?SVAR,'gt;','>') from dual"
			
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.efm_EFMErrors
			sv_d = urhk_dbSelectWithBind(sv_a)
			
			IF(sv_d == 0) THEN
			#{
				CUST.INTERFACE.efm_EFMErrors  = BANCS.OUTPARAM.r_err
				
			#}
			ENDIF
			sv_z = "EFMDel_RES.ErrDesc| "+CUST.INTERFACE.efm_EFMErrors
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
			IF(STRLEN(CUST.INTERFACE.efm_EFMErrors) > 80)THEN
			#{
				CUST.INTERFACE.efm_EFMErrors = LEFT$(CUST.INTERFACE.efm_EFMErrors,79)
			#}
			ENDIF
			PRINT(CUST.INTERFACE.efm_EFMErrors)
			CUST.INTERFACE.efm_errorDesc = CUST.INTERFACE.efm_EFMErrors
			CUST.INTERFACE.EFM_USER_FLG  = "FAILURE"
			CUST.INTERFACE.EFM_REMARKS  = CUST.INTERFACE.efm_errorDesc 
			#GOTO ENDOFSCRIPT
			CUST.INTERFACE.GOTO = "Y"
		#}
		ENDIF
	#}
	ENDIF
	IF(CUST.INTERFACE.efm_respStatus != "SUCCESS")THEN
	#{
		sv_z = "EFMDel_RES.Status|FAILURE"
		sv_u = urhk_SetOrbOut(sv_z)
		#sv_z = "EFMDel_RES.EMP_ID| "+ CUST.INTERFACE.EmployeeID 
		#sv_u = urhk_SetOrbOut(sv_z)
		PRINT(CUST.INTERFACE.efm_EFMErrors)
		IF(TRIM(CUST.INTERFACE.efm_EFMErrors)!= "")THEN
		#{
			sv_z = "EFMDel_RES.MESSAGE| "+  CUST.INTERFACE.EmployeeID  +" "+ CUST.INTERFACE.efm_EFMErrors
			CUST.INTERFACE.EFM_REMARKS  = CUST.INTERFACE.EmployeeID  + " " + CUST.INTERFACE.efm_EFMErrors
		#}
		ELSE
		#{
			sv_z = "EFMDel_RES.MESSAGE| "+  CUST.INTERFACE.EmployeeID  + " user is not Deleted."
			CUST.INTERFACE.EFM_REMARKS  = CUST.INTERFACE.EmployeeID  + " user is not Deleted."
		#}
		ENDIF
		
		sv_u = urhk_SetOrbOut(sv_z)
		CUST.INTERFACE.EFM_USER_FLG  = "FAILURE"
		
		CUST.INTERFACE.GOTO = "Y"
	#}
	ENDIF

	
	#TRACE OFF
end-->
