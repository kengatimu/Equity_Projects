        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

        #---------------------------------------------------------
        #       Bancs Repository Printing
        #---------------------------------------------------------
        sv_x = urhk_B2k_PrintRepos("BANCS")
        PRINT(sv_x)

        CUST.DATA.succFail="F"
        CUST.DATA.count = "0"
        CUST.DATA.tranId = ""

        #CUST.DATA.acctNo = BANCS.INPUT.acctNo
        #PRINT(CUST.DATA.acctNo)

        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
        print(BANCS.INPARAM.BINDVARS)

        sv_a = "tran_date,tran_id,tran_amt,part_tran_type,acct_num,DEST_ACCT|SELECT TRAN_DATE, TRAN_ID , TRAN_AMT , part_tran_type,"
		sv_a = sv_a +"CASE part_tran_type"
		sv_a = sv_a +"WHEN 'C' THEN (SELECT foracid FROM TBAADM.gam WHERE  acid = H1.acid and part_tran_type='C')"
		sv_a = sv_a +"WHEN 'D' THEN (SELECT foracid FROM TBAADM.gam WHERE acid =H1.acid and part_tran_type='D')"
		sv_a = sv_a +"ELSE 'OTHERS'"
		sv_a = sv_a +"END AS Acct_num,"
		sv_a = sv_a +"CASE part_tran_type"
		sv_a = sv_a +"WHEN 'C' THEN (SELECT foracid FROM TBAADM.gam WHERE  acid = (select acid from tbaadm.dtd where tran_id = H1.tran_id and part_tran_type='D' and rownum<2))"
		sv_a = sv_a +"WHEN 'D' THEN (SELECT foracid FROM TBAADM.gam WHERE acid=(select acid from tbaadm.dtd where tran_id = H1.tran_id and part_tran_type='C' and rownum<2))"
		sv_a = sv_a +"ELSE 'OTHERS'"
		sv_a = sv_a +"END AS DEST_ACCT"
		sv_a = sv_a +"FROM TBAADM.DTD H1, TBAADM.GAM G1 WHERE G1.ACID = H1.ACID and G1.ACCT_CLS_FLG = 'N'" 
		sv_a = sv_a +"AND (DECODE(UPPER('ALL'), 'ALL', 'ALL', SUBSTR(foracid, -10)) = DECODE(UPPER('ALL'),'ALL', 'ALL', 'ALL'))"
		sv_a = sv_a +"and G1.bank_id =H1.bank_id and G1.bank_id = ?SVAR"
        print(sv_a)

        sv_d = urhk_dbCursorOpenWithBind(sv_a)
        print(sv_d)

        IF(sv_d!=0) THEN
        #{
                sv_u = urhk_dbCursorClose(sv_a)
                print(sv_u)

                sv_u = urhk_SetOrbOut("Status| No record found")
                print(sv_u)
        #}
        ELSE
        #{
                CUST.DATA.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(CUST.DATA.DB_CURSOR_NUMBER)


                sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
                print(sv_c)

                IF(sv_c != "0")THEN
                #{
                        #sv_e = urhk_SetOrbOut("SuccessorFailure|Sucess")
                        #sv_u = urhk_SetOrbOut("CifId| "+CUST.DATA.cifId)
                        #sv_u = urhk_SetOrbOut("CustFirstName| "+CUST.DATA.custFirstName)
                        #sv_u = urhk_SetOrbOut("CustLastName| "+CUST.DATA.custLastName)
                        #sv_u = urhk_SetOrbOut("CustPhoneNo| "+CUST.DATA.custPoneNo)
                        sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
                        sv_u = urhk_SetOrbOut("Failure| No record found")
                        print(sv_u)
                #}
                ENDIF

                while(sv_c ==0)
                #{
                        CUST.DATA.tran_date = BANCS.OUTPARAM.tran_date
                        print(CUST.DATA.tran_date)
                        CUST.DATA.tran_id = BANCS.OUTPARAM.tran_id
                        print(CUST.DATA.tran_id)
                        CUST.DATA.tran_amt = BANCS.OUTPARAM.tran_amt
                        print(CUST.DATA.tran_amt)
                        CUST.DATA.part_tran_type = BANCS.OUTPARAM.part_tran_type
                        print(CUST.DATA.part_tran_type)
                        CUST.DATA.acct_num = BANCS.OUTPARAM.acct_num
                        print(CUST.DATA.acct_num)
                        CUST.DATA.DEST_ACCT = BANCS.OUTPARAM.DEST_ACCT
                        print(CUST.DATA.DEST_ACCT)

                        CUST.DATA.count = CINT(CUST.DATA.count)+ 1
                        print(CUST.DATA.count)

                        #sv_c = urhk_SetOrbOut("recordCount|" +CUST.DATA.count)
                        #print(sv_c)

                        sv_c = urhk_SetOrbOut("transactionDetails.<rec_"+CUST.DATA.count+">.tran_date"+"| "+CUST.DATA.tran_date)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("transactionDetails.<rec_"+CUST.DATA.count+">.tran_id"+"| "+CUST.DATA.tran_id)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("transactionDetails.<rec_"+CUST.DATA.count+">.tran_amt"+"| "+CUST.DATA.tran_amt)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("transactionDetails.<rec_"+CUST.DATA.count+">.part_tran_type"+"| "+CUST.DATA.part_tran_type)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("transactionDetails.<rec_"+CUST.DATA.count+">.acct_num"+"| "+CUST.DATA.acct_num)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("transactionDetails.<rec_"+CUST.DATA.count+">.DEST_ACCT"+"| "+CUST.DATA.DEST_ACCT)
                        print(sv_c)
                        sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
                        print(sv_c)

                        #CUST.DATA.count = CINT(CUST.DATA.count)+ 1
                #}
                do
                sv_c = urhk_dbCursorClose(CUST.DATA.DB_CURSOR_NUMBER)
                print(sv_c)
        #}
        ENDIF

EXITSCRIPT

