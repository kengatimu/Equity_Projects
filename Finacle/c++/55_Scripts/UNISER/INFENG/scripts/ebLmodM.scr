<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("ONS")==0)then
                createrep("ONS")
        endif
        if(classexists("ONS","CUSTOM")==0)then
                createclass("ONS","CUSTOM",5)
        endif
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
	if(fieldexists(BANCS.INPUT.schmCode)==1)then
		EQSRV.GLBDATA.schmCode = BANCS.INPUT.schmCode 
	else
		EQSRV.GLBDATA.schmCode = ""
	endif
	if(EQSRV.GLBDATA.schmCode=="")then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Enter scheme code in tag schmCode")
		exitscript
	endif
	if(fieldexists(BANCS.INPUT.PerdMths)==1)then
		EQSRV.GLBDATA.PerdMths = BANCS.INPUT.PerdMths 
	else
		EQSRV.GLBDATA.PerdMths = ""
	endif
	if(EQSRV.GLBDATA.PerdMths=="")then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Enter Loan Period Months in tag PerdMths")
		exitscript
	endif
	if(fieldexists(BANCS.INPUT.PerdDays)==1)then
		EQSRV.GLBDATA.PerdDays = BANCS.INPUT.PerdDays 
	else
		EQSRV.GLBDATA.PerdMths = "0"
	endif
	if(fieldexists(BANCS.INPUT.loanAmount)==1)then
		EQSRV.GLBDATA.loanAmount = BANCS.INPUT.loanAmount 
	else
		EQSRV.GLBDATA.loanAmount = "0"
	endif
	if(cdouble(EQSRV.GLBDATA.loanAmount)<=0)then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Enter Loan Amount in tag loanAmount")
		exitscript
	endif
	if(cdouble(EQSRV.GLBDATA.loanAmount)<1000)then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Loan amount must be 1000KES or more")
		exitscript
	endif
	if(fieldexists(BANCS.INPUT.noOfInstalmnts)==1)then
		EQSRV.GLBDATA.noOfInstalmnts = BANCS.INPUT.noOfInstalmnts 
	else
		EQSRV.GLBDATA.noOfInstalmnts = ""
	endif
	if(cdouble(EQSRV.GLBDATA.noOfInstalmnts)<=0)then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Enter Number of Installements in tag noOfInstalmnts")
		exitscript
	endif
	if(fieldexists(BANCS.INPUT.intRate)==1)then
		EQSRV.GLBDATA.intRate = BANCS.INPUT.intRate 
	else
		EQSRV.GLBDATA.intRate = ""
	endif
	if(cdouble(EQSRV.GLBDATA.intRate)<=0)then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Enter InterestRate in tag intRate")
		exitscript
	endif
	if(fieldexists(BANCS.INPUT.crncyCode)==1)then
		EQSRV.GLBDATA.crncyCode = BANCS.INPUT.crncyCode 
	else
		EQSRV.GLBDATA.crncyCode = ""
	endif
	if(EQSRV.GLBDATA.crncyCode=="")then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Enter currency code in tag crncyCode")
		exitscript
	endif
	if(fieldexists(BANCS.INPUT.crncyCode)==1)then
	EQSRV.GLBDATA.schmType = "LAA"
	callscriptifexist("ebLmod.scr")
	if(EQSRV.GLBDATA.schmCode!="")then
		sv_z = urhk_SetOrbOut("SchmCode|" + EQSRV.GLBDATA.schmCode )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(EQSRV.GLBDATA.schmType!="")then
		sv_z = urhk_SetOrbOut("SchmType|" + EQSRV.GLBDATA.schmType )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(EQSRV.GLBDATA.crncyCode!="")then
		sv_z = urhk_SetOrbOut("CurrencyCode|" + EQSRV.GLBDATA.crncyCode )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(EQSRV.GLBDATA.PerdMths!="")then
		sv_z = urhk_SetOrbOut("PeriodMnths|" + EQSRV.GLBDATA.PerdMths )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(EQSRV.GLBDATA.PerdDays!="")then
		sv_z = urhk_SetOrbOut("PeriodDays|" + EQSRV.GLBDATA.PerdDays )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(cdouble(EQSRV.GLBDATA.loanAmount)>=1)then
		sv_z = urhk_SetOrbOut("LoanAmount|" + EQSRV.GLBDATA.loanAmount )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(EQSRV.GLBDATA.noOfInstalmnts!="")then
		sv_z = urhk_SetOrbOut("NoOfInstallements|" + EQSRV.GLBDATA.noOfInstalmnts )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(EQSRV.GLBDATA.matDate!="")then
		sv_z = urhk_SetOrbOut("MaturityDate|" + EQSRV.GLBDATA.matDate )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	if(EQSRV.GLBDATA.effIntRate!="")then
		sv_z = urhk_SetOrbOut("EffectiveInterestRate|" + EQSRV.GLBDATA.effIntRate )
	else
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("ErrorMsg|Invalid Loan Modelling Data")
		exitscript
	endif
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
        EQSRV.GLBDATA.counter_2 = "0"
        while(cint(EQSRV.GLBDATA.counter_2) < cint(EQSRV.GLBDATA.noOfInstalmnts))
                EQSRV.GLBDATA.counter_1 =       EQSRV.GLBDATA.counter_2
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.InstallmentDate |" + ("EQSRV").("GLBDATA").("flowDate_" + EQSRV.GLBDATA.counter_1) )
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.Installment |" + ("EQSRV").("GLBDATA").("instlAmt_" + EQSRV.GLBDATA.counter_1) )
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.PrincipalAmt |" + ("EQSRV").("GLBDATA").("princAmt_" + EQSRV.GLBDATA.counter_1) )
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.InterestAmt |" + ("EQSRV").("GLBDATA").("intAmt_" + EQSRV.GLBDATA.counter_1) )
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.CumulativePrincipalAmt |" + ("EQSRV").("GLBDATA").("cummPrincAmt_" + EQSRV.GLBDATA.counter_1) )
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.CumulativeInterestAmt |" + ("EQSRV").("GLBDATA").("cummIntAmt_" + EQSRV.GLBDATA.counter_1) )
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.PrincipalOutstanding |" + ("EQSRV").("GLBDATA").("princOutStanding_" + EQSRV.GLBDATA.counter_1) )
		sv_u = urhk_SetOrbOut("AmortizationSchedule.<rec_" + EQSRV.GLBDATA.counter_1 + ">.flowDesc |" + ("EQSRV").("GLBDATA").("flowDesc_" + EQSRV.GLBDATA.counter_1) )
                EQSRV.GLBDATA.counter_2 = cint(EQSRV.GLBDATA.counter_2) + 1
        do

VAYU:
        print(EQSRV.GLBDATA.srvErrMsg)
        print(EQSRV.GLBDATA.srvErrCode)
        print(EQSRV.GLBDATA.srvSucFail)
        if(classexists("EQSRV","GLBDATA")==1)then
                deleteclass("EQSRV","GLBDATA")
        endif
        if(repexists("EQSRV")==1)then
                deleterep("EQSRV")
        endif
        exitscript
trace off
end-->
