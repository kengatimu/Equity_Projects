#------------------------------------------------------------------------------------------------
#  Name            : vpEcoLaData.scr 
#  Description     : This script will be called to insert Ecosystem anchor Details in finacle 
#  Date            : 10-02-2022
#  Author          : Edwin Zico
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : NA 
#  Menu Option     : NA 
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             10-02-2022     Edwin Zico           Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="79d88fe523681d9cabfe2a2abf55e24a9a318916800c44bfa85fd2e2bbc5df2b"
trace on

sv_u = urhk_B2K_PrintRepos("BANCS")
print(sv_u)
if(repexists("EQSRV") == 0) then
#{
    createrep("EQSRV")
#}
endif
if(classexists("EQSRV","GLBDATA") == 0)then
#{
    createclass("EQSRV","GLBDATA",5)
#}
endif
if(fieldexists(BANCS.INPUT.ECOCODE)==1)then
        EQSRV.GLBDATA.ECOCODE = BANCS.INPUT.ECOCODE
        print(EQSRV.GLBDATA.ECOCODE)
else
        EQSRV.GLBDATA.ECOCODE = ""
endif
if(fieldexists(BANCS.INPUT.ANCHORNAME)==1)then
        EQSRV.GLBDATA.ANCHORNAME = BANCS.INPUT.ANCHORNAME
        print(EQSRV.GLBDATA.ANCHORNAME)
else
        EQSRV.GLBDATA.ANCHORNAME = ""
endif
if(fieldexists(BANCS.INPUT.EMAILID)==1)then
        EQSRV.GLBDATA.EMAILID = BANCS.INPUT.EMAILID
        print(EQSRV.GLBDATA.EMAILID)
else
        EQSRV.GLBDATA.EMAILID = ""
endif
if(fieldexists(BANCS.INPUT.CHRGRATE)==1)then
        EQSRV.GLBDATA.CHRGRATE = BANCS.INPUT.CHRGRATE
        print(EQSRV.GLBDATA.CHRGRATE)
else
        EQSRV.GLBDATA.CHRGRATE = ""
endif
if(fieldexists(BANCS.INPUT.TENURE)==1)then
        EQSRV.GLBDATA.TENURE = BANCS.INPUT.TENURE
        print(EQSRV.GLBDATA.TENURE)
else
        EQSRV.GLBDATA.TENURE = ""
endif
if(fieldexists(BANCS.INPUT.FUNCTION)==1)then
        EQSRV.GLBDATA.FUNCTION = BANCS.INPUT.FUNCTION
        print(EQSRV.GLBDATA.FUNCTION)
else
        EQSRV.GLBDATA.FUNCTION = ""
endif
if(fieldexists(BANCS.INPUT.ANCHORACCTID)==1)then
        EQSRV.GLBDATA.ANCHORACCTID = BANCS.INPUT.ANCHORACCTID
        print(EQSRV.GLBDATA.ANCHORACCTID)
else
        EQSRV.GLBDATA.ANCHORACCTID = ""
endif
if(EQSRV.GLBDATA.FUNCTION!="DELETE")then
	sv_b = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.ANCHORACCTID)
	if(sv_b != 0) then
		sv_o=urhk_SetOrbOut("ErrorCode|Invalid AccountID")
		exitscript
	endif
endif
if(EQSRV.GLBDATA.ECOCODE=="")then
		sv_o=urhk_SetOrbOut("ErrorCode|Invalid Ecosystem Code")
		exitscript
endif
#---------Record Count
sv_s ="count|select COUNT(*) from CUSTOM.ODLA_ECOSYSTEM_TBL where ECO_CODE =?SVAR "
sv_s =sv_s + "and ENTITY_CRE_FLG ='Y' and DEL_FLG ='N' and bank_id=?SVAR "
print(sv_s)
BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.ECOCODE + "|" + BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
if(sv_d == 0)then
	EQSRV.GLBDATA.count = BANCS.OUTPARAM.count
	print(EQSRV.GLBDATA.count)
endif
if(EQSRV.GLBDATA.FUNCTION=="ADD")then
	if(cdouble(EQSRV.GLBDATA.count) >0)then
		sv_o=urhk_SetOrbOut("ErrorCode|Anchor Details Exists!!!Use Modify Function")
		exitscript
	else
		sv_i = "insert into CUSTOM.ODLA_ECOSYSTEM_TBL(BANK_ID,ECO_CODE,ANCHOR_ACCT_ID,ANCHOR_NAME,EMAIL_ID,CHRG_RAT,TENURE,FACTOR,"
		sv_i = sv_i + " RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,ENTITY_CRE_FLG,DEL_FLG,FREE_TEXT_1,FREE_TEXT_2,FREE_TEXT_3,FREE_TEXT_4,FREE_TEXT_5) "
		sv_i = sv_i + " values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,NULL,?SVAR,sysdate,?SVAR,sysdate,'Y','N',NULL,NULL,NULL,NULL,NULL) "	
		print(sv_i)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.ECOCODE + "|" + EQSRV.GLBDATA.ANCHORACCTID + "|" + EQSRV.GLBDATA.ANCHORNAME + "|" + EQSRV.GLBDATA.EMAILID
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQSRV.GLBDATA.CHRGRATE + "|" + EQSRV.GLBDATA.TENURE + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSqlWithBind(sv_i)
		if(sv_d==0)then
			sv_d = urhk_dbSqlWithBind("Commit")
			print(sv_d)
			sv_o=urhk_SetOrbOut("MSG|Anchor Details Maintained successfully")
			sv_z = "SuccessOrFailure|S"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		else
			sv_o=urhk_SetOrbOut("MSG|Anchor Details Maintenance Failed!!!")
			sv_z = "SuccessOrFailure|F"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		endif
	endif
endif
if(EQSRV.GLBDATA.FUNCTION=="MODIFY")then
	if(cdouble(EQSRV.GLBDATA.count) ==0)then
		sv_o=urhk_SetOrbOut("ErrorCode|Anchor Details Does Not Exist!!!Use Add Function")
		exitscript
	else
		lv_f = " insert into CUSTOM.ODLA_ECOSYSTEM_HIST_TBL select * from CUSTOM.ODLA_ECOSYSTEM_TBL where bank_id=?SVAR and eco_code=?SVAR and anchor_acct_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.ECOCODE + "|" + EQSRV.GLBDATA.ANCHORACCTID
		print(BANCS.INPARAM.BINDVARS)
		print(lv_f)
		sv_d = urhk_dbSqlWithBind(lv_f)
		print(sv_d)
		sv_u = "update CUSTOM.ODLA_ECOSYSTEM_TBL set ANCHOR_ACCT_ID =?SVAR,EMAIL_ID =?SVAR,CHRG_RAT =?SVAR,LCHG_USER_ID =?SVAR,LCHG_TIME =sysdate "
		sv_u = sv_u + " where ECO_CODE =?SVAR and ENTITY_CRE_FLG ='Y' and DEL_FLG ='N' and bank_id =?SVAR "
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.ANCHORACCTID + "|" + EQSRV.GLBDATA.EMAILID + "|" + EQSRV.GLBDATA.CHRGRATE
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" +  EQSRV.GLBDATA.ECOCODE + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
                print(sv_u)
                sv_d = urhk_dbSqlWithBind(sv_u)
                if(sv_d==0)then
                        sv_d = urhk_dbSqlWithBind("Commit")
                        print(sv_d)
			sv_o=urhk_SetOrbOut("MSG|Anchor Details Modified successfully")
                        sv_z = "SuccessOrFailure|S"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
		else
			sv_o=urhk_SetOrbOut("MSG|Anchor Details Modification Failed!!!")
                        sv_z = "SuccessOrFailure|F"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
		endif		
	endif
endif
if(EQSRV.GLBDATA.FUNCTION=="DELETE")then
        if(cdouble(EQSRV.GLBDATA.count) ==0)then
                sv_o=urhk_SetOrbOut("ErrorCode|Anchor Details Does Not Exist!!!")
                exitscript
        else
		sv_u = "update CUSTOM.ODLA_ECOSYSTEM_TBL set DEL_FLG ='Y',LCHG_USER_ID =?SVAR,LCHG_TIME =sysdate where ECO_CODE =?SVAR and ENTITY_CRE_FLG ='Y' and DEL_FLG ='N' and bank_id =?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.ECOCODE + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		print(sv_u)
		sv_d = urhk_dbSqlWithBind(sv_u)
                if(sv_d==0)then
                        sv_d = urhk_dbSqlWithBind("Commit")
                        print(sv_d)
                        sv_o=urhk_SetOrbOut("MSG|Anchor Details Deleted successfully")
                        sv_z = "SuccessOrFailure|S"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
		else
			sv_o=urhk_SetOrbOut("MSG|Anchor Details Delete Failed!!!")
                        sv_z = "SuccessOrFailure|F"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
		endif
	endif
endif	

trace off
end-->
