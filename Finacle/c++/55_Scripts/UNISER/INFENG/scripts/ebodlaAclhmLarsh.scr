                print(BANCS.OUTPARAM.MODIFIED_DATE)
                EQSRV.GLBDATA.nxtDmdDate = mid$(BANCS.OUTPARAM.MODIFIED_DATE,0,10)
        #}
        endif

        lv_i = " drIntPcnt | select nrml_int_pcnt from tbaadm.ivs where bank_id=?SVAR and int_tbl_code=?SVAR  and crncy_code=?SVAR and int_slab_dr_cr_flg='D' and int_tbl_ver_num in (select  max(int_tbl_ver_num) from tbaadm.icv where bank_id=?SVAR and int_tbl_code=?SVAR and crncy_code=?SVAR and entity_cre_flg='Y' and del_flg='N' and int_slab_dr_cr_flg='D' and int_slab_srl_num in (select max(int_slab_srl_num) from tbaadm.icv where bank_id=?SVAR and int_tbl_code=?SVAR and crncy_code=?SVAR and entity_cre_flg='Y' and del_flg='N' and int_slab_dr_cr_flg='D')) and entity_cre_flg='Y' and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId +"|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode
        print(lv_i)
        print(BANCS.INPARAM.BINDVARS)
        lv_d = urhk_dbSelectWithBind(lv_i)
        if(lv_d==0)then
        #{
                EQSRV.GLBDATA.drIntPcnt = BANCS.OUTPARAM.drIntPcnt
        #}
        else
        #{
                EQSRV.GLBDATA.drIntPcnt = 13
        #}
        endif
        print(EQSRV.GLBDATA.drIntPcnt)
        BANCS.INPARAM.date1 = EQSRV.GLBDATA.expiryDate
        BANCS.INPARAM.date2 = EQSRV.GLBDATA.sanctDate
        sv_u = urhk_B2K_dateDiff("")
        print(sv_u)
        if(sv_u == 0 ) then
        #{
                BANCS.INPUT.migdatediff = BANCS.OUTPARAM.dateDiff
        #}
        else
        #{
                BANCS.INPUT.migdatediff = 365
        #}
        endif
        print(BANCS.INPUT.migdatediff)
        EQSRV.GLBDATA.numofMnths = cdouble(BANCS.INPUT.migdatediff) /30
        print(EQSRV.GLBDATA.numofMnths)
        lv_u = "numMonths,numofWeeks | select to_char(months_between(to_date(?SVAR,'DD-MM-RR'),to_date(?SVAR,'DD-MM-RR')),99),floor((to_date(?SVAR,'DD-MM-RR') - to_date(?SVAR,'DD-MM-RR'))/7)  from dual "
        BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.expiryDate + "|" + EQSRV.GLBDATA.sanctDate + "|" + EQSRV.GLBDATA.expiryDate + "|" + EQSRV.GLBDATA.sanctDate
        print(lv_u)
        print(BANCS.INPARAM.BINDVARS)
        lv_o = urhk_dbSelectWithBind(lv_u)
        if(lv_o==0)then
        #{
                BANCS.INPUT.numofMnths = BANCS.OUTPARAM.numMonths
                EQSRV.GLBDATA.numofWeeks = BANCS.OUTPARAM.numofWeeks
                EQSRV.GLBDATA.numofMnths = BANCS.INPUT.numofMnths
                print(BANCS.INPUT.numofMnths)
                print(EQSRV.GLBDATA.numofWeeks)
                print(EQSRV.GLBDATA.numofMnths)
        #}
        endif
        #+++++++++++++++++++++++++++++++++++++++++++++++++
        ##lv_r = " pemiAmt,pemiIntamt,pemiPrAmt,pNuofPy,ptotEmiamt | "
        ##lv_r = lv_r + " select emi_amt,emi_int_amt,emi_principal_amt,number_of_payments ,emi_amt*number_of_payments "
        ##lv_r = lv_r + " from custom.odla_schl_tbl where bank_id=?SVAR "
        ##lv_r = lv_r + " and od_acct_id=?SVAR "
        ##lv_r = lv_r + " and op_acct_id=?SVAR "
        ##lv_r = lv_r + " and entity_cre_flg='Y' "
        ##lv_r = lv_r + " and del_flg='Y' "
        ##lv_r = lv_r + " and schl_number in (select max(schl_number) from custom.odla_schl_tbl where bank_id=?SVAR "
        ##lv_r = lv_r + " and od_acct_id=?SVAR "
        ##lv_r = lv_r + " and op_acct_id=?SVAR "
        ##lv_r = lv_r + " and entity_cre_flg='Y' and del_flg='Y') "
        ##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId
        ##print(BANCS.INPARAM.BINDVARS)
        ##print(lv_r)
        ##lv_w=urhk_dbSelectWithBind(lv_r)
        ##if(lv_w==0)then
        #{
        ##        EQSRV.GLBDATA.pemiAmt = BANCS.OUTPARAM.pemiAmt
        ##        EQSRV.GLBDATA.pemiIntamt = BANCS.OUTPARAM.pemiIntamt
        ##        EQSRV.GLBDATA.pemiPrAmt = BANCS.OUTPARAM.pemiPrAmt
        ##        EQSRV.GLBDATA.pNuofPy = BANCS.OUTPARAM.pNuofPy
        ##        EQSRV.GLBDATA.ptotEmiamt = BANCS.OUTPARAM.ptotEmiamt
        #}
        ##else
        #{
        ##        EQSRV.GLBDATA.pemiAmt = 0
        ##        EQSRV.GLBDATA.pemiIntamt = 0
        ##        EQSRV.GLBDATA.pemiPrAmt = 0
        ## ##       EQSRV.GLBDATA.pNuofPy = 0
        ##        EQSRV.GLBDATA.ptotEmiamt = 0
        #}
        ##endif
        ##lv_t = " totOutStanAmt,totAdjAmt | select sum(dmd_amt)-sum(tot_adj_amt),sum(tot_adj_amt) from custom.odla_dmd_tbl "
        ##lv_t = lv_t + " where bank_id=?SVAR and op_sol_id=?SVAR and flow_id in ('PRDEM','INDEM') "
        ##lv_t = lv_t + " and shdl_num in (select max(shdl_num) from custom.odla_dmd_tbl "
        ##lv_t = lv_t + " where bank_id=?SVAR and flow_id in ('PRDEM','INDEM') "
        ##lv_t = lv_t + " and op_sol_id=?SVAR and od_acid=?SVAR and shdl_num is not null) "
        ##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.opsolid + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.opsolid + "|" + EQSRV.GLBDATA.odAcid
        ##lv_u = urhk_dbSelectWithBind(lv_t)
        ##if(lv_u == 0)then
        #{
        ##        EQSRV.GLBDATA.totOutStanAmt = BANCS.OUTPARAM.totOutStanAmt
        ##        EQSRV.GLBDATA.totAdjAmt = BANCS.OUTPARAM.totAdjAmt
        #}
        ##else
        #{
        ##        EQSRV.GLBDATA.totOutStanAmt = 0
        ##        EQSRV.GLBDATA.totAdjAmt = 0
        #}
        ##endif
        ##print(EQSRV.GLBDATA.ptotEmiamt)
        ##print(EQSRV.GLBDATA.totAdjAmt)
        ##EQSRV.GLBDATA.prevOutStanAmt = cdouble(EQSRV.GLBDATA.ptotEmiamt) - cdouble(EQSRV.GLBDATA.totAdjAmt)
        ##if(cdouble(EQSRV.GLBDATA.prevOutStanAmt)<=0)then
        #{
        ##        EQSRV.GLBDATA.prevOutStanAmt = -1 * cdouble(EQSRV.GLBDATA.prevOutStanAmt)
        #}
        ##endif
        ###print(EQSRV.GLBDATA.prevOutStanAmt)
        print(EQSRV.GLBDATA.sanLim)
        ###EQSRV.GLBDATA.sanLim = cdouble(EQSRV.GLBDATA.sanLim) + cdouble(EQSRV.GLBDATA.prevOutStanAmt)
        ##print(EQSRV.GLBDATA.sanLim)
        #++++++++++++++++++
        print(EQSRV.GLBDATA.cClearBalance)
        if(cdouble(EQSRV.GLBDATA.cClearBalance)<0)then
        #{
                EQSRV.GLBDATA.cClearBalance = -1 * cdouble(EQSRV.GLBDATA.cClearBalance)
        #}
        else
        #{
                EQSRV.GLBDATA.cClearBalance = "0"
        #}
        endif
        ###EQSRV.GLBDATA.sanLim = cdouble(EQSRV.GLBDATA.sanLim) + cdouble(EQSRV.GLBDATA.cClearBalance)
        print(EQSRV.GLBDATA.sanLim)
        #+++++++++++++++++++++++++++++++++++++++++++++++++
#Derive IntPcnt & Numof Emi
        EQSRV.GLBDATA.fIntPcnt = cdouble(EQSRV.GLBDATA.drIntPcnt)/100
        print(EQSRV.GLBDATA.fIntPcnt)
#Monthly
        if(EQSRV.GLBDATA.repayFeq=="M")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/12
                EQSRV.GLBDATA.emiPyCnt = BANCS.INPUT.numofMnths
        #}
        endif
#Quaterly
        if(EQSRV.GLBDATA.repayFeq=="Q")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/3
                EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths)/3
        #}
        endif
#Half-Yearly
        if(EQSRV.GLBDATA.repayFeq=="H")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/6
                EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths)/6
        #}
        endif
#Yearly
        if(EQSRV.GLBDATA.repayFeq=="Y")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/12
                EQSRV.GLBDATA.emiPyCnt =  cdouble(BANCS.INPUT.numofMnths)/12
        #}
        endif
#Weekly
        if(EQSRV.GLBDATA.repayFeq=="W")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/52
                EQSRV.GLBDATA.emiPyCnt = EQSRV.GLBDATA.numofWeeks
        #}
        endif
#BiWeekly
        if(EQSRV.GLBDATA.repayFeq=="B")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/26
                EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths) * 2
        #}
        endif
#Daily
        if(EQSRV.GLBDATA.repayFeq=="D")then
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/26
                EQSRV.GLBDATA.emiPyCnt = cdouble("1")
        endif
        if(cdouble(EQSRV.GLBDATA.emiPyCnt)<=0)then
        #{
                EQSRV.GLBDATA.emiPyCnt = cdouble("1")
        #}
        endif
        print(EQSRV.GLBDATA.fiIntPcnt)
        print(EQSRV.GLBDATA.emiPyCnt)

        lv_p = "pmtamt | select to_char(custom.fn_pmt_val(?NVAR,?NVAR,?NVAR,0),999999999999999.99) as pmtamt from dual "
        ##BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.fiIntPcnt + "|" + BANCS.INPUT.numofMnths + "|" +  EQSRV.GLBDATA.sanLim
        BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.fiIntPcnt + "|" + EQSRV.GLBDATA.emiPyCnt + "|" +  EQSRV.GLBDATA.sanLim
        print(lv_p)
        print(BANCS.INPARAM.BINDVARS)
        lv_o = urhk_dbSelectWithBind(lv_p)
        if(lv_o==0)then
        #{
                EQSRV.GLBDATA.pmtamt = BANCS.OUTPARAM.pmtamt
                if(cdouble(EQSRV.GLBDATA.pmtamt)<=0)then
                #{
                        EQSRV.GLBDATA.pmtamt = -1 * cdouble(EQSRV.GLBDATA.pmtamt)
                #}
                endif
        #}
        else
        #{
                EQSRV.GLBDATA.pmtamt = 0
        #}
        endif
        print(EQSRV.GLBDATA.fiIntPcnt)
        print(cint(EQSRV.GLBDATA.fiIntPcnt))
        print(cdouble(EQSRV.GLBDATA.fiIntPcnt))
        EQSRV.GLBDATA.IntAmt = cdouble(EQSRV.GLBDATA.sanLim) * cdouble(EQSRV.GLBDATA.fiIntPcnt)
        print(EQSRV.GLBDATA.IntAmt)
        EQSRV.GLBDATA.IntAmt = FORMAT$(cdouble(EQSRV.GLBDATA.IntAmt),"%.2f")
        print(EQSRV.GLBDATA.IntAmt)
        EQSRV.GLBDATA.PrinAmt = cdouble(EQSRV.GLBDATA.pmtamt) - cdouble(EQSRV.GLBDATA.IntAmt)
        print(EQSRV.GLBDATA.PrinAmt)
        if(cdouble(EQSRV.GLBDATA.PrinAmt)<0)then
        #{
                EQSRV.GLBDATA.PrinAmt = -1 * cdouble(EQSRV.GLBDATA.PrinAmt)
        #}
        endif
        EQSRV.GLBDATA.PrinAmt = FORMAT$(cdouble(EQSRV.GLBDATA.PrinAmt),"%.2f")
        print(EQSRV.GLBDATA.PrinAmt)
	IF(EQSRV.GLBDATA.schmCcode != "OD542") THEN
        lv_d = "mxSchdlNum | select max(schl_number)+1 from custom.odla_schl_tbl where bank_id=?SVAR "
        lv_d = lv_d + " and od_acct_id=?SVAR and od_acid=?SVAR "
        lv_d = lv_d + " and op_acct_id=?SVAR and op_acid=?SVAR "
        lv_d = lv_d + " and entity_cre_flg='Y' "
        #####and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.odAcid + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OperAcid
        print(lv_d)
        print(BANCS.INPARAM.BINDVARS)
        lv_g = urhk_dbSelectWithBind(lv_d)
        if(lv_g==0)then
        #{
                EQSRV.GLBDATA.mxSchdlNum = BANCS.OUTPARAM.mxSchdlNum
        #}
        else
        #{
                EQSRV.GLBDATA.mxSchdlNum = 1
        #}
        endif
	ENDIF
	IF(EQSRV.GLBDATA.schmCcode == "OD542") THEN
        lv_d = "mxSchdlNum | select max(schl_number)+1 from custom.odla_schl_tbl where bank_id=?SVAR "
        lv_d = lv_d + " and od_acct_id=?SVAR and od_acid=?SVAR "
        lv_d = lv_d + " and entity_cre_flg='Y' "
        #####and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.odAcid
        print(lv_d)
        print(BANCS.INPARAM.BINDVARS)
        lv_g = urhk_dbSelectWithBind(lv_d)
        if(lv_g==0)then
        #{
                EQSRV.GLBDATA.mxSchdlNum = BANCS.OUTPARAM.mxSchdlNum
        #}
        else
        #{
                EQSRV.GLBDATA.mxSchdlNum = 1
        #}
        endif
	ENDIF
