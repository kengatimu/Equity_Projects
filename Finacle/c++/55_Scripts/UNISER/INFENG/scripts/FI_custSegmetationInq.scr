#------------------------------------------------------------------------------------------------
#  Name            : FI_custSegmentationInq.scr
#  Description     : Fetch customer segmentation description
#  Date            : 30-06-2023
#  Author          : James Maina
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             30-06-2023      James Maina		Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "CSEG")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "CSEG", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)
	IF( (FIELDEXISTS(("BANCS").("INPUT").("cifid"))== 0) ) THEN
	#{
   		CUST.CSEG.errMsg="please enter cifid"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|failed")
		sv_t = "Msg | " +CUST.CSEG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	#-----------------------------------------------------
	#--variable initialization
	#-----------------------------------------------------
	CUST.CSEG.cifid= BANCS.INPUT.cifid
	PRINT(CUST.CSEG.cifid)
	CUST.CSEG.sector=" "
	CUST.CSEG.subsector=" "
	CUST.CSEG.segment=" "
	CUST.CSEG.subsegment=" "
	CUST.CSEG.isic1=" "
	CUST.CSEG.isic2=" "
	CUST.CSEG.demand1=" "
	CUST.CSEG.demand2=" "
	CUST.CSEG.Sectordesc=" "
	CUST.CSEG.subsectordesc=" "
	CUST.CSEG.segmentdesc=" "
	CUST.CSEG.subsegmentdesc=" "
	CUST.CSEG.isic1desc=" "
	CUST.CSEG.isic2desc=" "
	CUST.CSEG.demand1desc=" "
	CUST.CSEG.demand2desc=" "
	CUST.CSEG.ecosystem=" "
	CUST.CSEG.climatecat=" "
	CUST.CSEG.environcat=" "
	CUST.CSEG.ecosystemDesc=" "
	CUST.CSEG.climatecatDesc=" "
	CUST.CSEG.environcatDesc=" "

	CUST.CSEG.secsector=" "
	CUST.CSEG.secsubsector=" "
	CUST.CSEG.secisic1=" "
	CUST.CSEG.secisic2=" "
	CUST.CSEG.secdemand1=" "
	CUST.CSEG.secdemand2=" "
	CUST.CSEG.secsectorDesc=" "
	CUST.CSEG.secsubsectorDesc=" "
	CUST.CSEG.secisic1Desc=" "
	CUST.CSEG.secisic2Desc=" "
	CUST.CSEG.secdemand1Desc=" "
	CUST.CSEG.secdemand2Desc=" "

	sv_s = "sector,subsector,segment,subsegment,isic1,isic2,demand1,demand2, secsector,secsubsector,secisic1,secisic2,secdemand1,secdemand2,ecosystem,climatecat,environcat| "
	sv_s = sv_s + "select sector,subsector,segment,subsegment,StrUserField1,StrUserField13,StrUserField15,StrUserField16,StrUserField22,StrUserField23,StrUserField2, "
	sv_s = sv_s + "StrUserField11,StrUserField20,StrUserField21,StrUserField28,StrUserField26,StrUserField25 from crmuser.corporate where bank_id=?SVAR and corp_key=?SVAR "

	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.CSEG.cifid
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	IF(sv_r==1)THEN
	#{
		GOTO INDIV
	#}
	ELSE
	#{
		GOTO VAR
	#}
	ENDIF
	
        INDIV:
	sv_s = "sector,subsector,segment,subsegment,isic1,isic2,demand1,demand2, secsector,secsubsector,secisic1,secisic2,secdemand1,secdemand2,ecosystem,climatecat,environcat| "
	sv_s = sv_s + "select Sector,SubSector,segmentation_class,SubSegment,StrField16,StrField18,StrField19,StrField21,StrUserField6,StrUserField7,StrUserField2, "
	sv_s = sv_s + "StrUserField23,StrUserField3,StrUserField9,StrUserField26,StrUserField25,StrUserField24 from crmuser.accounts where bank_id=?SVAR and orgkey=?SVAR "

	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.CSEG.cifid
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	IF (sv_r ==0) THEN
	#{
		VAR:
		sv_a= BANCS.OUTPARAM.sector
		sv_y= BANCS.OUTPARAM.subsector
		sv_c= BANCS.OUTPARAM.segment
		sv_d= BANCS.OUTPARAM.subsegment
		sv_e= BANCS.OUTPARAM.isic1
		sv_f= BANCS.OUTPARAM.isic2
		sv_g= BANCS.OUTPARAM.demand1
		sv_h= BANCS.OUTPARAM.demand2
		sv_z= BANCS.OUTPARAM.secsector
		sv_j= BANCS.OUTPARAM.secsubsector
		sv_k= BANCS.OUTPARAM.secisic1
		sv_l= BANCS.OUTPARAM.secisic2
		sv_m= BANCS.OUTPARAM.secdemand1
		sv_n= BANCS.OUTPARAM.secdemand2
		sv_p= BANCS.OUTPARAM.ecosystem
		sv_q= BANCS.OUTPARAM.climatecat
		sv_r= BANCS.OUTPARAM.environcat


		sv_s="value, desc,catType|"
		sv_s=sv_s + "select value, localetext,categorytype from crmuser.categories c, crmuser.category_lang l where c.bank_id=?SVAR and l.bank_id=c.bank_id  and "
		sv_s=sv_s + " VALUE in (?SVAR, ?SVAR,?SVAR, ?SVAR, ?SVAR,?SVAR,?SVAR,?SVAR,?SVAR, ?SVAR,?SVAR, ?SVAR, ?SVAR,?SVAR,?SVAR,?SVAR,?SVAR) and "
		sv_s=sv_s + " c.categoryid=l.categoryid and" 
		sv_s=sv_s + " categorytype in ('SECTOR_CODE','SUB_SECTOR_CODE','SEGMENTATION_CLASS','SUB_SEGMENT','ISICP1','ISICP2','ISIC_DEMAND1' "
		sv_s=sv_s + " ,'ISIC_DEMAND2','ECO_SYSTEM','CLIMATE_CATEGORIZATION','CATEGORIZATION')" 
		print(sv_s)

		BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId+"|"+sv_a+"|"+sv_y+"|"+sv_c+"|"+sv_d+"|"+sv_e+"|"+sv_f+"|"+sv_g+"|"+sv_h+"|"+sv_z+"|"+sv_j+"|"
		BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + sv_k+"|"+sv_l+"|"+sv_m+"|"+sv_n+"|"+sv_p+"|"+sv_q+"|"+sv_r

		print(BANCS.INPARAM.BINDVARS)

		sv_v = urhk_dbcursorOpenWithBind(sv_s)
     	  	PRINT(sv_v)

		IF(sv_v == 0) THEN
      		#{
        		CUST.CSEG.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       			print(CUST.CSEG.CURSOR_NUMBER)
       			sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
        		print(sv_b)
			sv_i=1
			print(sv_i)
			WHILE(sv_b == "0")
        		#{
				CUST.CSEG.value= BANCS.OUTPARAM.value
				print(CUST.CSEG.value)
				CUST.CSEG.desc= BANCS.OUTPARAM.desc
				print(CUST.CSEG.desc)
				CUST.CSEG.catType= BANCS.OUTPARAM.catType
				print(CUST.CSEG.catType)

				IF((CUST.CSEG.value==sv_a) and (CUST.CSEG.catType !="ECO_SYSTEM"))THEN
				#{
					CUST.CSEG.sector = CUST.CSEG.value
					CUST.CSEG.Sectordesc= CUST.CSEG.desc
				#}
				ENDIF	
				IF(CUST.CSEG.value==sv_y)THEN
				#{
					CUST.CSEG.subsector= CUST.CSEG.value
					CUST.CSEG.subsectordesc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_c)THEN
				#{
					CUST.CSEG.segment= CUST.CSEG.value
					CUST.CSEG.segmentdesc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_d)THEN
				#{
					CUST.CSEG.subsegment= CUST.CSEG.value
					CUST.CSEG.subsegmentdesc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_e)THEN
				#{
					CUST.CSEG.isic1= CUST.CSEG.value
					CUST.CSEG.isic1desc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_f)THEN
				#{
					CUST.CSEG.isic2= CUST.CSEG.value
					CUST.CSEG.isic2desc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_g)THEN
				#{
					CUST.CSEG.demand1= CUST.CSEG.value
					CUST.CSEG.demand1desc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_h)THEN
				#{
					CUST.CSEG.demand2= CUST.CSEG.value
					CUST.CSEG.demand2desc= CUST.CSEG.desc
				#}
				ENDIF
				IF((CUST.CSEG.value==sv_z) and (CUST.CSEG.catType !="ECO_SYSTEM"))THEN
				#{
					CUST.CSEG.secsector= CUST.CSEG.value
					CUST.CSEG.secsectorDesc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_j)THEN
				#{
					CUST.CSEG.secsubsector= CUST.CSEG.value
					CUST.CSEG.secsubsectorDesc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_k)THEN
				#{
					CUST.CSEG.secisic1= CUST.CSEG.value
					CUST.CSEG.secisic1Desc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_l)THEN
				#{
					CUST.CSEG.secisic2= CUST.CSEG.value
					CUST.CSEG.secisic2Desc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_m)THEN
				#{
					CUST.CSEG.secdemand1= CUST.CSEG.value
					CUST.CSEG.secdemand1Desc= CUST.CSEG.desc
				#}
				ENDIF
				IF(CUST.CSEG.value==sv_n)THEN
				#{
					CUST.CSEG.secdemand2= CUST.CSEG.value
					CUST.CSEG.secdemand2Desc= CUST.CSEG.desc
				#}
				ENDIF   
				IF(CUST.CSEG.value==sv_p)THEN
				#{
					CUST.CSEG.ecosystem= CUST.CSEG.value
					CUST.CSEG.ecosystemDesc= CUST.CSEG.desc
				#}
				ENDIF				
				IF(CUST.CSEG.value==sv_q)THEN
				#{
					CUST.CSEG.climatecat= CUST.CSEG.value
					CUST.CSEG.climatecatDesc= CUST.CSEG.desc
				#}
				ENDIF				
				IF(CUST.CSEG.value==sv_r)THEN
				#{
					CUST.CSEG.environcat= CUST.CSEG.value
					CUST.CSEG.environcatDesc= CUST.CSEG.desc
				#}
				ENDIF

				sv_i = sv_i + 1 
       				sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
       				print(sv_b)
			#}
			DO
				sv_x = urhk_dbCursorClose(CUST.CSEG.CURSOR_NUMBER)

		#}
		ENDIF

		#----------------------------------
		#sending response
		#----------------------------------
		sv_u = urhk_SetOrbOut("SuccessOrFailure|success")
		sv_u = urhk_SetOrbOut("Ecosystem|" +CUST.CSEG.ecosystem)
		sv_u = urhk_SetOrbOut("EcosystemDesc|" +CUST.CSEG.ecosystemDesc)
		sv_u = urhk_SetOrbOut("EnvironCat|" + CUST.CSEG.environcat)
		sv_u = urhk_SetOrbOut("EnvironCatDesc|" + CUST.CSEG.environcatDesc)
		sv_u = urhk_SetOrbOut("ClimateCat|" + CUST.CSEG.climatecat)
		sv_u = urhk_SetOrbOut("ClimateCatDesc|" + CUST.CSEG.climatecatDesc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.segment|" +CUST.CSEG.segment)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.segmentdesc|" +CUST.CSEG.segmentdesc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.subsegment|" +CUST.CSEG.subsegment)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.subsegmentdesc|" +CUST.CSEG.subsegmentdesc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.Sector|" +CUST.CSEG.sector)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.Sectordesc|" +CUST.CSEG.Sectordesc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.subsector|" +CUST.CSEG.subsector)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.subsectordesc|" +CUST.CSEG.subsectordesc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.isic1|" +CUST.CSEG.isic1)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.isic1desc|" +CUST.CSEG.isic1desc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.isic2|" +CUST.CSEG.isic2)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.isic2desc|" +CUST.CSEG.isic2desc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.demand1|" +CUST.CSEG.demand1)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.demand1desc|" +CUST.CSEG.demand1desc)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.demand2|" +CUST.CSEG.demand2)
		sv_t = urhk_SetOrbOut("Main.<rec_0>.demand2desc|" +CUST.CSEG.demand2desc)

		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.Sector|" +CUST.CSEG.secsector)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.Sectordesc|" +CUST.CSEG.secsectorDesc)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.subsector|" +CUST.CSEG.secsubsector)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.subsectordesc|" +CUST.CSEG.secsubsectorDesc)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.isic1|" +CUST.CSEG.secisic1)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.isic1desc|" +CUST.CSEG.secisic1Desc)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.isic2|" +CUST.CSEG.secisic2)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.isic2desc|" +CUST.CSEG.secisic2Desc)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.demand1|" +CUST.CSEG.secdemand1)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.demand1desc|" +CUST.CSEG.secdemand1Desc)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.demand2|" +CUST.CSEG.secdemand2)
		sv_t = urhk_SetOrbOut("Secondary.<rec_0>.demand2desc|" +CUST.CSEG.secdemand2Desc)
	#}
	ELSE
	#{
   		CUST.CSEG.errMsg="Invalid cifid passed"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|failed")
		sv_t = "Msg | " +CUST.CSEG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF


ENDOFSCRIPT:
END-->

