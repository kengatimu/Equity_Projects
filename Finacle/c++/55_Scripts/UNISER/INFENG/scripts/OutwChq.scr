									sv_p = "ACCTLISTStruct.<rec_" + CUST.DATA.number + ">.Acct.br_code|" + CUST.DATA.varValue11
									print(sv_p)
									sv_u = urhk_SetOrbOut(sv_p)
								
								
							ENDIF
							IF (CUST.DATA.varValue12 != "") THEN
								#{
									sv_p = "ACCTLISTStruct.<rec_" + CUST.DATA.number + ">.Acct.BR_NAME|" + CUST.DATA.varValue12
									print(sv_p)
									sv_u = urhk_SetOrbOut(sv_p)
								
								
							ENDIF
							IF (CUST.DATA.varValue13 != "") THEN
								#{
									sv_p = "ACCTLISTStruct.<rec_" + CUST.DATA.number + ">.Acct.CLG_ZONE|" + CUST.DATA.varValue13
									print(sv_p)
									sv_u = urhk_SetOrbOut(sv_p)
								
								
							ENDIF
							IF (CUST.DATA.varValue14 != "") THEN
								#{
									sv_p = "ACCTLISTStruct.<rec_" + CUST.DATA.number + ">.Acct.set_num|" + CUST.DATA.varValue14
									print(sv_p)
									sv_u = urhk_SetOrbOut(sv_p)
								
								
							ENDIF
							IF (CUST.DATA.varValue15 != "") THEN
								#{
									sv_p = "ACCTLISTStruct.<rec_" + CUST.DATA.number + ">.Acct.sol_id|" + CUST.DATA.varValue15
									print(sv_p)
									sv_u = urhk_SetOrbOut(sv_p)
								
								
							ENDIF
							IF (CUST.DATA.varValue16 != "") THEN
								#{
									sv_p = "ACCTLISTStruct.<rec_" + CUST.DATA.number + ">.Acct.status|" + CUST.DATA.varValue16
									print(sv_p)
									sv_u = urhk_SetOrbOut(sv_p)
								
								
							ENDIF
							sv_n = urhk_dbCursorFetch(sv_m)
							sv_g = sv_g + 1
							CUST.DATA.number = sv_g
							print(CUST.DATA.number)
						
						DO

						IF(sv_g ==0)THEN
							print(sv_g)
							sv_a = "count|select count(1) FROM tbaadm.OCP,tbaadm.OCI,tbaadm.BKC,tbaadm.bct  WHERE ocp.del_flg! ='Y' AND acid = (select acid from tbaadm.gam where foracid = ?SVAR ) AND OCP.CLG_ZONE_DATE >= to_date(?SVAR ,'DD-MM-YYYY HH24:MI:SS')AND  OCP.CLG_ZONE_DATE >= to_date(?SVAR ,'DD-MM-YYYY HH24:MI:SS') AND OCP.bank_id =?SVAR  AND OCI.bank_id =?SVAR  and OCI.BANK_ID = OCP.bank_id and OCI.CLG_ZONE_CODE = OCP.CLG_ZONE_CODE and OCI.CLG_ZONE_DATE = OCP.clg_zone_date and OCI.SET_NUM = OCP.set_num and OCI.SOL_ID = OCP.sol_id AND BKC.BANK_CODE = OCI.bank_code aND bct.br_code = OCI.br_code AND OCI.BANK_CODE = bct.bank_code and BKC.BANK_CODE = bct.BANK_CODE and bkc.bank_id = ?SVAR and bct.bank_id = ?SVAR "
							print(sv_a)
							BANCS.INPARAM.BINDVARS = BANCS.INPUT.ACCOUNT  + "|" + BANCS.INPUT.FROM_DATE + "|" + BANCS.INPUT.TO_DATE + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId
						        print(BANCS.INPARAM.BINDVARS)
							sv_q= urhk_dbSelectWithBind(sv_a)
							print(sv_q)
							
							IF (BANCS.OUTPARAM.count==0) THEN
							
							  print("NO Data found")	 
							  sv_u=urhk_SetOrbOut("description|NO data found")
							  
							 ENDIF
						ENDIF
						sv_n = urhk_dbCursorClose(sv_m)

						exitscript
						#$$$$$$$$$$$$$$$
					
				ENDIF
			ENDIF
	ELSE
		print("No Input details received")
		CUST.DATA.successOrFailure="F"
		CUST.DATA.errorCode="ERR008"
		GOTO ERROREXIT
	ENDIF
EXITSCRIPT
trace off
