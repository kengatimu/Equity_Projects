				CUST.DATA.ACCOUNT =BANCS.INPUT.ACCOUNT
				CUST.DATA.FROM_INSTR_AMT =BANCS.INPUT.FROM_INSTR_AMT
				CUST.DATA.TO_INSTR_AMT =BANCS.INPUT.TO_INSTR_AMT
							
				print(BANCS.INPUT.ACCOUNT)
