							sv_n = urhk_dbCursorFetch(sv_m)
							sv_g = sv_g + 1
							CUST.DATA.number = sv_g
							print(CUST.DATA.number)
						
						DO

						IF(sv_g ==0)THEN
							print(sv_g)
							sv_a = "count|select count(1) FROM tbaadm.OCP,tbaadm.OCI,tbaadm.BKC,tbaadm.bct  WHERE ocp.del_flg! ='Y' AND acid = (select acid from tbaadm.gam where foracid = ?SVAR )  AND OCI.INSTRMNT_ID =  ?SVAR  AND OCP.bank_id =?SVAR  AND OCI.bank_id =?SVAR  and OCI.BANK_ID = OCP.bank_id and OCI.CLG_ZONE_CODE = OCP.CLG_ZONE_CODE and OCI.CLG_ZONE_DATE = OCP.clg_zone_date and OCI.SET_NUM = OCP.set_num and OCI.SOL_ID = OCP.sol_id AND BKC.BANK_CODE = OCI.bank_code aND bct.br_code = OCI.br_code AND OCI.BANK_CODE = bct.bank_code and BKC.BANK_CODE = bct.BANK_CODE and bkc.bank_id = ?SVAR and bct.bank_id = ?SVAR "
							print(sv_a)
							BANCS.INPARAM.BINDVARS = BANCS.INPUT.ACCOUNT  + "|" + BANCS.INPUT.INSTR_NUM  + "|" +BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId 
							print(BANCS.INPARAM.BINDVARS)
