sv_y=0

sv_a = urhk_GetChannelInfo("")
print(sv_a)
CUST.DATA.DccId =BANCS.OUTPARAM.DccId
print(CUST.DATA.DccId)

	#========================================================	
	# Checking if the Inputs are provided in Resquest
	#========================================================
	sv_x="ACCOUNT"
	sv_J="INSTR_NUM"
	sv_y="FROM_DATE"
	sv_z="TO_DATE"
	sv_c="FROM_INSTR_AMT"
	sv_p="TO_INSTR_AMT"
	
	

	IF ((FIELDEXISTS(("BANCS").("INPUT").(sv_x))== 1) OR (FIELDEXISTS(("BANCS").("INPUT").(sv_J))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_y))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_z))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_c))== 1)OR (FIELDEXISTS(("BANCS").("INPUT").(sv_p))== 1))THEN
		
		#========================================================
		#---Checking if the Instrument exists or not-------
		#========================================================
			IF (((FIELDEXISTS(("BANCS").("INPUT").(sv_x))== "1"))  and ((FIELDEXISTS(("BANCS").("INPUT").(sv_J))== "1"))) THEN
				
				CUST.DATA.ACCOUNT =BANCS.INPUT.ACCOUNT
				CUST.DATA.INSTR_NUM =BANCS.INPUT.INSTR_NUM
				
			
				print(BANCS.INPUT.ACCOUNT)
				print(BANCS.INPUT.INSTR_NUM)
				sv_q = "instrmnt_id,ZONE_DATE,CRNCY,instrmnt_amt,status_flg,rej_code_1,tran_value, VALUE_DATE,bank_code,BANK_NAME, br_code,BR_NAME,CLG_ZONE,set_num,sol_id,status| "                
				sv_q = sv_q + " SELECT OCI.instrmnt_id,TO_CHAR(OCP.CLG_ZONE_DATE,'DD-MM-YYYY'),OCP.CRNCY_CODE,OCI.instrmnt_amt,OCI.status_flg,OCI.rej_code_1,to_char(OCI.tran_value_date,'DD-MM-YYYY')," 
				sv_q = sv_q + " to_char(OCI.VALUE_DATE,'DD-MM-YYYY'),OCI.bank_code,BANK_NAME,OCI.br_code,BR_NAME,OCP.CLG_ZONE_code,OCP.set_num,OCP.sol_id,(CASE WHEN OCI.status_flg = 'G' THEN 'Regularised' when OCI.status_flg = 'P' then 'Pending' when OCI.status_flg = 'R' then 'Released to Shadow Balance' when OCI.status_flg = 'W' then 'Pending and Rejected' when OCI.status_flg = 'O' then 'Released And Rejected' when OCI.status_flg = 'J' then 'Regularised And Rejected' end)status "
				sv_q = sv_q + " FROM tbaadm.OCP,tbaadm.OCI,tbaadm.BKC,tbaadm.bct " 
				sv_q = sv_q + " WHERE ocp.del_flg! ='Y' AND acid = (select acid from tbaadm.gam where foracid = ?SVAR )  AND trim(OCI.INSTRMNT_ID)= ?SVAR  AND OCP.bank_id =?SVAR  AND OCI.bank_id =?SVAR  and OCI.BANK_ID = OCP.bank_id " 
				sv_q = sv_q + " and OCI.CLG_ZONE_CODE = OCP.CLG_ZONE_CODE and OCI.CLG_ZONE_DATE = OCP.clg_zone_date and OCI.SET_NUM = OCP.set_num and OCI.SOL_ID = OCP.sol_id " 
				sv_q = sv_q + " AND BKC.BANK_CODE = OCI.bank_code aND bct.br_code = OCI.br_code AND OCI.BANK_CODE = bct.bank_code and BKC.BANK_CODE = bct.BANK_CODE and bkc.bank_id = ?SVAR and bct.bank_id = ?SVAR " 
				sv_q = sv_q + " ORDER BY  OCP.CLG_ZONE_DATE,OCI.INSTRMNT_ID "
				
				  print (sv_q)
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.ACCOUNT  + "|" + BANCS.INPUT.INSTR_NUM  + "|" +BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId 
				print(BANCS.INPARAM.BINDVARS)
				sv_e = urhk_dbCursorOpenWithBind(sv_q)
				IF( sv_e == 0 ) THEN
					sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
					print(sv_m)
					sv_n = urhk_dbCursorFetch(sv_m)

						#$$$$$$$$$$$$$$$$

						sv_g = 0
						CUST.DATA.number = "0"
						WHILE(sv_n == 0)
						#{
							CUST.DATA.varValue1 = BANCS.OUTPARAM.instrmnt_id
							  print (CUST.DATA.varValue1)
