<--START
TRACE ON

	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	sv_r = REPEXISTS("MTT")
	IF (sv_r == 0) THEN
		CREATEREP("MTT")
	ENDIF

	sv_r = CLASSEXISTS("MTT","TranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","TranDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","PartTranDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
	print(sv_r)
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","PartTranDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","InputDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","InputDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","LAAddnlDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","LAAddnlDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","Error")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","Error",5)
	ENDIF

	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
		CREATEREP("BANCS")
	ENDIF

	sv_r = CLASSEXISTS("BANCS","INPARAM")
	IF (sv_r == 0) THEN
		CREATECLASS("BANCS","INPARAM",5)
	ENDIF

	IF (REPEXISTS("CUST")==0)THEN
		CREATEREP("CUST")
	ENDIF

	IF(CLASSEXISTS("CUST","LADISB")==0)then
		CREATECLASS("CUST","LADISB",5)
	ENDIF
	#vp
	CUST.LADISB.loanCifId = ""
	CUST.LADISB.loanRefNum = ""
	CUST.LADISB.frmPartyName = ""
	CUST.LADISB.loanAmt = ""
	CUST.LADISB.partyName = ""
	CUST.LADISB.patyAcctNum = ""
	CUST.LADISB.productCode = "" 
	CUST.LADISB.tranid = ""
	#vp

	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="Y"
	BANCS.INPARAM.RestrictModifyInd="FOURTH_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"

	sv_r = urhk_MTTS_Initialize("")
	print(sv_r)

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
        MTT.TranDetails.ValidationFlag = "Y"
        MTT.TranDetails.PostTranFlg = "Y"
	MTT.TranDetails.Remarks = "Echo Loan Sweep"
        MTT.TranDetails.CheckExceptions = "Y"
        MTT.TranDetails.PostFlag        = "Y"
        MTT.TranDetails.CommitFlg       = "Y"
        MTT.TranDetails.PrintAdviceInd  = "B"

	sv_a = urhk_MTTS_PopulateInputDetails("")
	print(sv_a)

	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.transferAcctNum.foracid")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.operAcct = BANCS.OUTPARAM.srvValue
		PRINT(CUST.LADISB.operAcct)
	#}
	ENDIF
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	if (sv_a == 0) THEN
	#{
		CUST.LADISB.loanAcctId = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.loanAcctId)
	#}
	endif
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.schmCode.schmCode")
	if (sv_a == 0) THEN
	#{
		CUST.LADISB.laSchmCode=BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.laSchmCode)
	#}
	endif
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
	if (sv_a == 0) THEN
	#{
		CUST.LADISB.disbursAmt  = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.disbursAmt)
		sv_a=getPosition(CUST.LADISB.disbursAmt,"|")
		sv_b=strlen(CUST.LADISB.disbursAmt)
		CUST.LADISB.disbursAmt =LEFT$(CUST.LADISB.disbursAmt,sv_a-1)
		print(CUST.LADISB.disbursAmt)
	#}
	endif

	sv_u = urhk_getAdvanceDetailsForAccount(CUST.LADISB.loanAcctId)
	print(sv_u)
	if(sv_u==0)then
	#{
		CUST.LADISB.MerAcct = BANCS.OUTPARAM.gacFreeText4
		print(CUST.LADISB.MerAcct)
		##CUST.LADISB.EcoCode =	BANCS.OUTPARAM.FreeCode6
		CUST.LADISB.EcoCode = BANCS.OUTPARAM.gacFreeText5
		print(CUST.LADISB.EcoCode)
		CUST.LADISB.RefNumber = BANCS.OUTPARAM.gacFreeText6
		print(CUST.LADISB.RefNumber)
		#full/partial loan amount
		CUST.LADISB.SweepString = BANCS.OUTPARAM.gacFreeText7
		print(CUST.LADISB.SweepString)
		if(CUST.LADISB.SweepString !="")then
			CUST.LADISB.loanType = ""
			CUST.LADISB.FullLoanAmt = ""
			CUST.LADISB.PartailLoanAmt = ""
			print(CUST.LADISB.SweepString)
			sv_l = strlen(CUST.LADISB.SweepString)
			sv_f = mid$(CUST.LADISB.SweepString,0,sv_l)
			sv_p = getposition(sv_f,"|")
			CUST.LADISB.loanType  = mid$(sv_f,0,(sv_p-1))
			print(CUST.LADISB.loanType)
			CUST.LADISB.SweepString = mid$(sv_f,sv_p,sv_l)
			print(CUST.LADISB.SweepString)
			sv_l = strlen(CUST.LADISB.SweepString)
			sv_f = mid$(CUST.LADISB.SweepString,0,sv_l)
			sv_p = getposition(sv_f,"|")
			CUST.LADISB.FullLoanAmt  = mid$(sv_f,0,(sv_p-1))
			print(CUST.LADISB.FullLoanAmt)
			CUST.LADISB.PartailLoanAmt = mid$(sv_f,sv_p,sv_l)
			print(CUST.LADISB.PartailLoanAmt)
			if(CUST.LADISB.loanType=="F")then
				print(CUST.LADISB.disbursAmt)
			endif
			if(CUST.LADISB.loanType=="P")then
				CUST.LADISB.disbursAmt = cdouble(CUST.LADISB.disbursAmt) + cdouble(CUST.LADISB.PartailLoanAmt)
				print(CUST.LADISB.disbursAmt)
			endif 
		else
			print(CUST.LADISB.disbursAmt)
		endif	

	else

		CUST.LADISB.MerAcct = ""
		CUST.LADISB.EcoCode = ""
		CUST.LADISB.RefNumber = ""
	endif
	#sv_b = urhk_getAcctDetailsInRepository(BANCS.INPUT.accountNumber)


IF((CUST.LADISB.disbursAmt > 0)  and (CUST.LADISB.operAcct!="") and (CUST.LADISB.MerAcct!= ""))THEN
	sv_u = urhk_MTTS_DefineTransaction("EcosystemTran")

#CustomerDebit
	MTT.PartTranDetails.Account 	= CUST.LADISB.operAcct 
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.RateCode 	="MEAN"
	MTT.PartTranDetails.Rate 	= "0"
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = "Ecosystem loan sweep to " + CUST.LADISB.MerAcct 
	MTT.PartTranDetails.Particulars2 = CUST.LADISB.loanAcctId 
	MTT.PartTranDetails.RefAmount = -(cdouble(CUST.LADISB.disbursAmt)) 
	MTT.PartTranDetails.Amount   = -(cdouble(CUST.LADISB.disbursAmt))
	MTT.PartTranDetails.Remarks = "Dr.for Ecosystem Loan" 
	MTT.PartTranDetails.Refnum = CUST.LADISB.RefNumber
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = "EcosystemTran" 
	MTT.PartTranDetails.PstFlg = "Y"
	sv_r = urhk_MTTS_definePartTran("CustDr")
	print(sv_r)
	IF(fieldexists(MTT.Error.Description)) THEN
		print(MTT.Error.Description)
		CUST.LADISB.MTTErrDesc = MTT.Error.Description
	ENDIF
#Ecosystem
	MTT.PartTranDetails.Account 	= CUST.LADISB.MerAcct
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.RateCode 	="MEAN"
	MTT.PartTranDetails.Rate 	= "0"
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = "Cr from EazzyStock RefNum " + CUST.LADISB.RefNumber + "/" + CUST.LADISB.operAcct 
	MTT.PartTranDetails.Particulars2 = CUST.LADISB.loanAcctId
	MTT.PartTranDetails.RefAmount = (cdouble(CUST.LADISB.disbursAmt))  
	MTT.PartTranDetails.Remarks = "Cr from:" + CUST.LADISB.operAcct 
	MTT.PartTranDetails.Refnum = CUST.LADISB.RefNumber
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = "EcosystemTran" 
	MTT.PartTranDetails.PstFlg = "Y"
	sv_r = urhk_MTTS_definePartTran("CustDr")
	print(sv_r)

       IF(fieldexists(MTT.Error.Description)) THEN
                print(MTT.Error.Description)
                CUST.LADISB.MTTErrDesc = MTT.Error.Description
        ENDIF

        sv_r = urhk_MTTS_EndDefinition("")
        print(sv_r)
        IF(fieldexists(BANCS.OUTPARAM.MTTTranId)) THEN

                print(BANCS.OUTPARAM.MTTTranId)
                CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
                print(CUST.LADISB.tranid)

        ENDIF

        sv_r = urhk_MTTS_Close("")
        print(sv_r)

	ENDOFSCRIPT:
END-->
