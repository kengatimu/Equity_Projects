<--START
CHECKSUM="169cbf5d736974a6b30d86d6c4b39e2f2f4234b2c5a7c44c3ed907de905f66d1"
	TRACE ON
	sv_u = urhk_SRV_GetVal("payerSubGenDet.dbtAcctNum.acid")
	IF(sv_u == 0) THEN
	#{
		CUST.HCBSU.acid = BANCS.OUTPARAM.srvValue
		print(CUST.HCBSU.acid)
	#}
	ENDIF
	sv_u = urhk_SRV_GetVal("payerSubGenDet.dbtAcctNum.foracid")
	IF(sv_u == 0) THEN
	#{
		CUST.HCBSU.acctId = BANCS.OUTPARAM.srvValue
		print(CUST.HCBSU.acctId)
	#}
	ENDIF
	#sv_u = urhk_SRV_GetVal("payerSubGenDet.dbtAcctNum.crncyCode")
	#IF(sv_u == 0) THEN
	#    CUST.HCBSU.crncyCode = BANCS.OUTPARAM.srvValue
	#    print(CUST.HCBSU.crncyCode)
	#ENDIF
	sv_u = urhk_SRV_GetVal("payerSubGenDet.freeText1")
	IF(sv_u == 0) THEN
	#{
		CUST.HCBSU.chrgEventID = BANCS.OUTPARAM.srvValue
		print(CUST.HCBSU.chrgEventID)
	#}
	ENDIF
	IF(CUST.HCBSU.chrgEventID == "") THEN
	#{
		print("no charge collection")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_a = urhk_getAcctDetailsInRepository(CUST.HCBSU.acctId)
	IF(sv_a == 0) THEN
	#{
		CUST.HCBSU.currencyCode=BANCS.OUTPARAM.acctCrncyCode
		PRINT(CUST.HCBSU.currencyCode)
	#}
	ENDIF
	BANCS.INPARAM.BINDVARS = "GCHRG|" + CUST.HCBSU.chrgEventID + "|N|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "noOfPttRecords|select count(*) from tbaadm.ptt"
	sv_s = sv_s + " where event_type = ?SVAR"
	sv_s = sv_s + " AND event_id = ?SVAR"
	sv_s = sv_s + " AND del_flg = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(BANCS.OUTPARAM.noOfPttRecords != 0)THEN
	#{
		CUST.HCBSU.noOfPttRecords = BANCS.OUTPARAM.noOfPttRecords
		PRINT(CUST.HCBSU.noOfPttRecords)
		#}
	ELSE
		#{
		CUST.HCBSU.errorMsg = "Error : Invalid GCHRG type of Event ID entered in Free Text 1"
		sv_u = urhk_SRV_SetErr(CUST.HCBSU.errorMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|T")
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" + CUST.HCBSU.currencyCode)
	sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.HCBSU.acctId)
	sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" + CUST.HCBSU.chrgEventID)
	sv_u = urhk_SetUrhkOut("genChrgLL.<rec_0>.crAcct.foracid|foracid")
	
	sv_n = 0
	print(CUST.HCBSU.noOfPttRecords)
	WHILE(sv_n < CINT(CUST.HCBSU.noOfPttRecords))
	#{
		sv_s = "genChrgLL.<rec_" + FORMAT$(sv_n,"%d") + ">.actualAmt|actualAmt_" + FORMAT$(sv_n,"%d")
		print(sv_s)
		sv_u = urhk_SetUrhkOut(sv_s)
		PRINT(sv_u)
		
		sv_n = sv_n + 1
		print(sv_n)
	#}
	DO
	
	sv_n = 0
	print(CUST.HCBSU.noOfPttRecords)
	WHILE(sv_n < CINT(CUST.HCBSU.noOfPttRecords))
	#{
		sv_s = "genChrgLL.<rec_" + FORMAT$(sv_n,"%d") + ">.calcAmt|calcAmt_" + FORMAT$(sv_n,"%d")
		print(sv_s)
		sv_u = urhk_SetUrhkOut(sv_s)
		PRINT(sv_u)
		
		sv_n = sv_n + 1
		print(sv_n)
	#}
	DO
	
	#----------------------------------------------------------------------
	# Execution of service
	#----------------------------------------------------------------------
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltGenChrgDtl |retain_all_output = Y")
	
	#----------------------------------------------------------------------
	# If service calling fails, then capture the error, exception and warnings
	# and throw an error message
	#----------------------------------------------------------------------
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_c = BANCS.OUTPARAM.Error_num
		print(sv_c)
		sv_d = 1
		IF (sv_c > 0) THEN
		#{
			sv_d = FORMAT$(sv_d, "%d")
			print(("BANCS").("OUTPARAM").("ErrorCode_" + sv_d))
			print(("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d))
			print(("BANCS").("OUTPARAM").("Tag_" + sv_d))
			CUST.HCBSU.errorMsg = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_d)+"^" + ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d)
			sv_u = urhk_SRV_SetErr(CUST.HCBSU.errorMsg)
		#}
		ENDIF
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.HCBSU.crAcct = BANCS.OUTPARAM.foracid
		print(CUST.HCBSU.crAcct)
		sv_n = 0
		WHILE(sv_n < CINT(CUST.HCBSU.noOfPttRecords))
		#{
			PRINT(sv_n)
			CUST.HCBSU.ChrgAmt = ("BANCS").("OUTPARAM").("actualAmt_" + FORMAT$(sv_n,"%d"))
			PRINT(CUST.HCBSU.ChrgAmt)
			sv_m = GETPOSITION(CUST.HCBSU.ChrgAmt,"|")
			CUST.HCBSU.ChrgAmt = MID$(CUST.HCBSU.ChrgAmt,0,sv_m-1)
			print(CUST.HCBSU.ChrgAmt)
			IF(CDOUBLE(CUST.HCBSU.ChrgAmt) > CDOUBLE("0")) THEN
			#{
				CUST.HCBSU.actualAmt = CUST.HCBSU.ChrgAmt
				print(CUST.HCBSU.actualAmt)
				sv_n = CINT(CUST.HCBSU.noOfPttRecords)
			#}
			ENDIF
			
			sv_n = sv_n + 1
			print(sv_n)
		#}
		DO
	#}
	ENDIF
	print(CUST.HCBSU.crAcct)
	print(CUST.HCBSU.actualAmt)
	IF(CDOUBLE(CUST.HCBSU.actualAmt) != CDOUBLE("0")) THEN
	#{
		sv_a = urhk_CopyOutToIn("")
		print(sv_a)
		sv_u = urhk_SetUrhkInp("genChrgLL.<rec_0>.tranRmks|" + "HCBSU Registration Charges")
		#----------------------------------------------------------------------
		# Calling SRV_AddGenChrgDtl for charge calculation
		#----------------------------------------------------------------------
		print(CUST.HCBSU.chrgEventID)
		sv_u = urhk_ExecSrvNoCommit("SRV_AddGenChrgDtl |same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#----------------------------------------------------------------------
		# If service calling fails, then capture the error, exception and warnings
		# and throw an error message
		#----------------------------------------------------------------------
		IF (sv_u != 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.Error_num
			print(sv_c)
			sv_d = 1
			IF (sv_c > 0) THEN
			#{
				sv_d = FORMAT$(sv_d, "%d")
				print(("BANCS").("OUTPARAM").("ErrorCode_" + sv_d))
				print(("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d))
				print(("BANCS").("OUTPARAM").("Tag_" + sv_d))
				CUST.HCBSU.errorMsg = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_d)+"^" + ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d)
				sv_u = urhk_SRV_SetErr(CUST.HCBSU.errorMsg)
			#}
			ENDIF
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		#----------------------------------------------------------------------
		# Calling SRV_FetchGenChrgDtlForVerify for charge calculation
		#----------------------------------------------------------------------
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
		#----------------------------------------------------------------------
		# If service calling fails, then capture the error, exception and warnings
		# and throw an error message
		#----------------------------------------------------------------------
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.Error_num
			print(sv_c)
			sv_d = 1
			IF (sv_c > 0) THEN
			#{
				sv_d = FORMAT$(sv_d, "%d")
				print(("BANCS").("OUTPARAM").("ErrorCode_" + sv_d))
				print(("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d))
				print(("BANCS").("OUTPARAM").("Tag_" + sv_d))
				CUST.HCBSU.errorMsg = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_d)+"^" + ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d)
				sv_u = urhk_SRV_SetErr(CUST.HCBSU.errorMsg)
			#}
			ENDIF
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		
		sv_a = urhk_SetUrhkOut("genChrgCrit.tranId|tranId")
		sv_a = urhk_SetUrhkOut("genChrgCrit.tranDate|tranDate")
		
		#----------------------------------------------------------------------
		# Calling SRV_VerifyGenChrgDtl for Verifying the general charge details
		#----------------------------------------------------------------------
		sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|call_mode = N")
		
		#----------------------------------------------------------------------
		# If service calling fails, then capture the error, exception and warnings
		# and throw an error message ELSE fetch tranId and tranDate
		#----------------------------------------------------------------------
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			print(sv_u)
			sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|call_mode = N")
			print(sv_u)
			IF (sv_u != 0) THEN
			#{
				sv_c = BANCS.OUTPARAM.Error_num
				print(sv_c)
				sv_d = 1
				IF (sv_c > 0) THEN
				#{
					sv_d = FORMAT$(sv_d, "%d")
					print(("BANCS").("OUTPARAM").("ErrorCode_" + sv_d))
					print(("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d))
					print(("BANCS").("OUTPARAM").("Tag_" + sv_d))
					CUST.HCBSU.errorMsg = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_d)+"^" + ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d)
					sv_u = urhk_SRV_SetErr(CUST.HCBSU.errorMsg)
				#}
				ENDIF
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.HCBSU.chrgTranID = BANCS.OUTPARAM.tranId
				CUST.HCBSU.chrgTranDate = BANCS.OUTPARAM.tranDate
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.HCBSU.chrgTranID = BANCS.OUTPARAM.tranId
			CUST.HCBSU.chrgTranDate = BANCS.OUTPARAM.tranDate
		#}
		ENDIF
		
		print(CUST.HCBSU.chrgTranID)
		print(CUST.HCBSU.chrgTranDate)
		ONS.CUSTOM.custDataOut = "~commonresultpage|" + TRIM(CUST.HCBSU.chrgTranID)
		CUST.HCBSU.chrgTranDate = MID$(CUST.HCBSU.chrgTranDate,0,10)
		print(CUST.HCBSU.chrgTranDate)
	#}
	ENDIF
	ENDOFSCRIPT:
END-->
