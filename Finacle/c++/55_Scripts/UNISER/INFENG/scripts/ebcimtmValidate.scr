<--start
trace on
        if(repexists("CPLTM")==0)then
                createrep("CPLTM")
        endif
        if(classexists("CPLTM","GLBDATA")==0)then
                createclass("CPLTM","GLBDATA",5)
        endif

CPLTM.GLBDATA.errMsg = ""
CPLTM.GLBDATA.resMsg = ""

CPLTM.GLBDATA.funcCode = BANCS.INPUT.funcCode
PRINT(CPLTM.GLBDATA.funcCode)
ERROR:
	if(CPLTM.GLBDATA.errMsg != "") then
		lv_e = urhk_setOrbErr(CPLTM.GLBDATA.errMsg)
		PRINT(lv_e)
	endif

ENDOFSCRIPT:
        EXITSCRIPT

trace off
end-->
