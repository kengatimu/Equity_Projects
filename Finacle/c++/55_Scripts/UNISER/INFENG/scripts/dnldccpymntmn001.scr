<--START
CHECKSUM="c8bf11a4b1d4e17f4fcd793461469b04a145a8e22724157fd7c28e9eeec56edf"
	TRACE ON
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.reportTo)
	PRINT(BANCS.INPUT.tranSub)
	PRINT(BANCS.INPUT.date)
	#---------------------------------------------------------------------------------
	# ACID  is fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "CARDPAYMNT"
	BANCS.INPUT.parameterId = "ACID"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.vacid = BANCS.OUTPUT.parameterVal
		#    CUST.DATA.vacid = "PA2776"
		#}
	ELSE
		#{
		CUST.DATA.vacid = ""
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	#file name fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "CARDPAYMNT"
	BANCS.INPUT.parameterId = "FILENAME"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.file = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.file = ""
	#}
	ENDIF
	#---------------------------------------------------------------------------------
	#file name fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "CARDPAYMNT"
	BANCS.INPUT.parameterId = "ACCT"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.acct = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.acct = ""
	#}
	ENDIF
	#---------------------------------------------------------------------------
	#The following step is for date validation.
	#---------------------------------------------------------------------------
	
	IF ( BANCS.INPUT.date == "" ) THEN
	#{
		sv_e = "Transactions date should be entred in format dd-mm-yyyy"
		sv_m = "date_ui"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_u=urhk_B2k_valDate(BANCS.INPUT.date)
		PRINT(sv_u)
		IF( sv_u != 0 ) THEN
		#{
			sv_e = "Invalid Date given for field Date"
			sv_m = "date_ui"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_s = "count|SELECT COUNT(1) FROM TBAADM.HTD"
			sv_s = sv_s + " WHERE acid= ?SVAR"
			sv_s = sv_s + " AND ref_num IS NOT NULL"
			sv_s = sv_s + " AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
			sv_s = sv_s + " AND bank_id = ?SVAR"
			sv_s = sv_s + " AND del_flg = 'N'"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.DATA.vacid + "|" + BANCS.INPUT.date + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_u =  urhk_dbSelectWithBind(sv_s)
			IF( sv_u != 0 ) THEN
			#{
				sv_e = "System Error contact support"
				sv_m = "date_ui"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.DATA.count = BANCS.OUTPARAM.count
				PRINT(CUST.DATA.count)
				IF (CUST.DATA.count == 0) THEN
				#{
					sv_e = "No Payments for date : " + BANCS.INPUT.date
					sv_m = "date_ui"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#---------------------------------------------------------------------------
		#The following step is file name creation.
		#---------------------------------------------------------------------------
		sv_s = "filenumber|SELECT  CUSTOM.WAY4CCARDPAYMENTS.nextval FROM DUAL"
		print(sv_s)
		sv_u =  urhk_dbSelectWithBind(sv_s)
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.DATA.filenumber = BANCS.OUTPARAM.filenumber
			PRINT(CUST.DATA.filenumber)
			CUST.DATA.filedate =MID$(BANCS.STDIN.BODDate,0,10)
			PRINT(CUST.DATA.filedate)
			sv_b = CUST.DATA.file
			sv_b = sv_b + lpad(CUST.DATA.filenumber,2,'0')
			PRINT(sv_b)
			sv_b = sv_b + "."
			PRINT(sv_b)
			sv_s = "filedatenu|SELECT TO_CHAR(TO_DATE(?SVAR,'DD-MM-YYYY'), 'ddd') FROM DUAL "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.DATA.filedate
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_u =  urhk_dbSelectWithBind(sv_s)
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				CUST.DATA.filedatenu = BANCS.OUTPARAM.filedatenu
				PRINT(CUST.DATA.filedatenu)
				sv_a = LPAD(CUST.DATA.filedatenu,3,'0')
				PRINT(sv_a)
				CUST.DATA.filename = sv_b + sv_a
				print(CUST.DATA.filename)
				#---------------------------------------------------------------------------
				#--- Check is file already exist
				#---------------------------------------------------------------------------
				sv_a = "test -f " + CUST.DATA.filename
				sv_r = SYSTEM(sv_a)
				PRINT(sv_r)
				IF (sv_r == 0) THEN
				#{
					sv_e = "The file Already exists"
					sv_m = "date"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#Processing the settlement file.
	#---------------------------------------------------------------------------
	
	CUST.DATA.comfile="CCardPay.com"
	PRINT(CUST.DATA.comfile)
	
	sv_u = urhk_getFileLocation("COM|" + CUST.DATA.comfile)
	PRINT(sv_u)
	
	sv_l = BANCS.OUTPARAM.fileLocation
	PRINT(sv_l)
	
	sv_t  =  sv_l + CUST.DATA.comfile + " " + CUST.DATA.filename + "/" + BANCS.INPUT.date +"/" + CUST.DATA.filenumber + " " + BANCS.STDIN.contextBankId + " " + CUST.DATA.vacid + " " + CUST.DATA.acct
	PRINT(sv_t)
	
	#sv_u = urhk_TBAF_CallBatchExe(sv_t)
	sv_u = SYSTEM(sv_t)
	PRINT(sv_u)
	
	#--------------------------------------------------------------------------
	# Transfering processed file to location
	#--------------------------------------------------------------------------
	
	
	#sv_a = "sendpc -a -d C:/PAYMENTS/KENYA " + CUST.DATA.filename
	#PRINT(sv_a)
	
	#sv_r = urhk_TBAF_CallBatchExe(sv_r)
	#sv_r = SYSTEM(sv_a)
	#PRINT(sv_r)
	IF (sv_u == 0) THEN
	#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|The File Generation Process Initiated."
		sv_z = urhk_SetOrbOut(sv_g)
		GOTO ENDOFSCRIPT
		
		#}
	ELSE
		#{
		sv_e = "The File has not been Generated."
		sv_m = "date"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		TRACE OFF
		EXITSCRIPT
END-->
