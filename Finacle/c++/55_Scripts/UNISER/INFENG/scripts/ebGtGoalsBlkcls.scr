#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
	if(repexists("EQSRV") ==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV", "GLBDATA")==0)then
		createclass("EQSRV", "GLBDATA", 5)
	endif
	sv_p = urhk_B2k_PrintRepos("BANCS")
	print(sv_p)
	EQSRV.GLBDATA.depositAcctId	= ""
	EQSRV.GLBDATA.depAvailAmt	= 0
	EQSRV.GLBDATA.datafile		= ""
	EQSRV.GLBDATA.srvYN 	= ""
	EQSRV.GLBDATA.valerr	= ""
	EQSRV.GLBDATA.tamgamCurNum = ""
	EQSRV.GLBDATA.depositClsDate	= MID$(BANCS.STDIN.BODDate,0,10)
	EQSRV.GLBDATA.depositClsDate	= EQSRV.GLBDATA.depositClsDate + " 00:00:00"
	print(EQSRV.GLBDATA.depositClsDate)
	sv_d = "depositAcctId,repayAcctId,repayCrncy,depOpnDate,depMatDate,depAvailAmt,maturityAmt,gSolId,gclrBalAmt | "
	sv_d = sv_d + " select gam.foracid,(select foracid from tbaadm.gam "
	sv_d = sv_d + " where acid=tam.repayment_acid )as repayacct,tam.tam_crncy_code, "
	sv_d = sv_d + " tam.open_effective_date,tam.maturity_date,tam.deposit_amount,tam.maturity_amount,gam.sol_id,round(gam.clr_bal_Amt) "
	sv_d = sv_d + " from tbaadm.gam ,tbaadm.tam "
	sv_d = sv_d + " where tam.acid = gam.acid "
	sv_d = sv_d + " and gam.bank_id= '"+BANCS.STDIN.contextBankId+"' "
	sv_d = sv_d + " and gam.schm_code='TU400' " 
	sv_d = sv_d + " and gam.acct_cls_flg='N' " 
	sv_d = sv_d + " and gam.del_flg='N' " 
	sv_d = sv_d + " and gam.entity_cre_flg='Y' " 
	sv_d = sv_d + " and gam.acct_cls_date is null "
	sv_d = sv_d + " and tam.maturity_date <= (select db_stat_date from tbaadm.gct where bank_id ='"+BANCS.STDIN.contextBankId+"' ) "
	##sv_d = sv_d + " and gam.sol_id ='"+BANCS.STDIN.mySolId+"' "
	##sv_d = sv_d + " and rownum<=3 "
	##sv_d = sv_d + " and gam.foracid in ('0340377605504') "
	sv_d = sv_d + " order by gam.sol_id,gam.foracid " 
	print(sv_d)
	sv_u = urhk_dbCursorOpenWithBind(sv_d)
	if ( sv_u == 0 ) then
		EQSRV.GLBDATA.tamgamCurNum	= BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		print(BANCS.OUTPARAM.DB_ERRCODE)
		print(BANCS.OUTPARAM.DB_ERRMSG)
		EQSRV.GLBDATA.srvYN	= "N"	
		EQSRV.GLBDATA.valerr	= "repayment fetch failed" 
		goto VAYU
	endif
		EQSRV.GLBDATA.tamgamrec = 0
		print(EQSRV.GLBDATA.tamgamCurNum)
		sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.tamgamCurNum)
		if(sv_z!=0)then
			print(BANCS.OUTPARAM.DB_ERRCODE)
			print(BANCS.OUTPARAM.DB_ERRMSG)
			EQSRV.GLBDATA.srvYN	= "N"	
			EQSRV.GLBDATA.valerr	= "repayment fetch failed" 
			goto VAYU
		endif
		print(sv_z)
		while(sv_z ==0)
		#{
			print("inside loop")

			EQSRV.GLBDATA.depositAcctId	= BANCS.OUTPARAM.depositAcctId
			EQSRV.GLBDATA.repayAcctId	= BANCS.OUTPARAM.repayAcctId
			EQSRV.GLBDATA.repayCrncy	= BANCS.OUTPARAM.repayCrncy
			EQSRV.GLBDATA.depOpnDate	= BANCS.OUTPARAM.depOpnDate
			EQSRV.GLBDATA.depMatDate	= BANCS.OUTPARAM.depMatDate
			EQSRV.GLBDATA.depAvailAmt	= BANCS.OUTPARAM.depAvailAmt
			EQSRV.GLBDATA.maturityAmt	= BANCS.OUTPARAM.maturityAmt
			EQSRV.GLBDATA.gSolId	= BANCS.OUTPARAM.gSolId
			EQSRV.GLBDATA.gclrBalAmt	= BANCS.OUTPARAM.gclrBalAmt
			#ContextSol
			print(BANCS.STDIN.mySolId)
			print(EQSRV.GLBDATA.gSolId)
			if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.gSolId ) then
				sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.gSolId)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
					print(BANCS.OUTPARAM.successOrFailure)
					sv_s = BANCS.OUTPARAM.successOrFailure
				else
					sv_s = "X"
				endif
				if (( sv_u != 0 ) and ( sv_s != "S"))then
					EQSRV.GLBDATA.valerr    =       "CCS Failed"
					EQSRV.GLBDATA.srvYN     = "N"
					goto NXTLP
				endif
			endif
			print(EQSRV.GLBDATA.depositAcctId)
			print(EQSRV.GLBDATA.repayAcctId)
			print(EQSRV.GLBDATA.depOpnDate)
			print(EQSRV.GLBDATA.depMatDate)
			print(EQSRV.GLBDATA.depAvailAmt)
			print(EQSRV.GLBDATA.gclrBalAmt)
			print(EQSRV.GLBDATA.maturityAmt)


			sv_a = urhk_SetUrhkInp("tdAcctId.foracid|" + EQSRV.GLBDATA.depositAcctId)
			sv_a = urhk_SetUrhkInp("clsValDt|" + EQSRV.GLBDATA.depositClsDate)
			sv_a = urhk_SetUrhkOut("withdrwlAmt|withdrwlAmt")
			sv_s = urhk_ExecSrv("SRV_FetchDfltTDClsrDtls|same_user_verify = Y|retain_all_output = Y")	
			print(sv_s)
			if(sv_s != 0)then
				callscriptifexist("ebsrvHandler.scr")
				EQSRV.GLBDATA.srvYN	= "N"	
				EQSRV.GLBDATA.valerr	= "fetch srv failed"
				goto NXTLP
			else
				EQSRV.GLBDATA.withdrwlAmt	=	BANCS.OUTPARAM.withdrwlAmt
				print(EQSRV.GLBDATA.withdrwlAmt)
				sv_j = strlen(EQSRV.GLBDATA.withdrwlAmt)
				print(sv_j)
				sv_y = mid$(EQSRV.GLBDATA.withdrwlAmt,0,sv_j)
				sv_e = strlen(EQSRV.GLBDATA.withdrwlAmt)
				sv_p = getposition(sv_y,"|")
				EQSRV.GLBDATA.trans_amt   = mid$(sv_y,0,(sv_p-1))
				EQSRV.GLBDATA.trans_crncy = mid$(sv_y,sv_p,sv_e)
				print(EQSRV.GLBDATA.trans_amt)
				print(EQSRV.GLBDATA.trans_crncy)
				print(cdouble("0"))
				if(cdouble(EQSRV.GLBDATA.trans_amt) <= cdouble("0"))then
					EQSRV.GLBDATA.srvYN	= "N"	
					EQSRV.GLBDATA.valerr	= "withdrawal amount is lessthan zero for " + EQSRV.GLBDATA.depositAcctId
					goto NXTLP
				endif
			endif
			sv_a = urhk_SetUrhkInp("tdAcctClsrCrit.tdAcctId.foracid|"+EQSRV.GLBDATA.depositAcctId)
			sv_a = urhk_SetUrhkInp("tdAcctClsrCrit.clsValDt|"+EQSRV.GLBDATA.depositClsDate)
			sv_a = urhk_SetUrhkInp("tdAcctClsrCrit.withdrwlAmt|"+EQSRV.GLBDATA.trans_amt+ "|" + EQSRV.GLBDATA.repayCrncy)
			sv_a = urhk_SetUrhkInp("tdAcctClsrDtls.tdAcctClsrRpmtDtl.repAcctFlg|Y")
			sv_a = urhk_SetUrhkInp("tdAcctClsrDtls.tdAcctClsrRpmtDtl.repAcctId.foracid|"+EQSRV.GLBDATA.repayAcctId)
			sv_a = urhk_SetUrhkInp("tdAcctClsrDtls.satisfyLoanAcctflg|N")
			sv_a = urhk_SetUrhkInp("clsrRmks|Force Close of Goals")
			sv_a = urhk_SetUrhkInp("clsrReason.refCode|DPCLS")
			sv_a = urhk_SetUrhkOut("tdAcctClsrDtls.GAMCookie|GAMCookie")
			sv_a = urhk_SetUrhkOut("tdAcctClsrDtls.TAMCookie|TAMCookie")
			sv_s = urhk_ExecSrv("SRV_FetchTDAcctForClsr|same_user_verify = Y|retain_all_output = Y")
			print(sv_s)
			if(sv_s != 0)then
				callscriptifexist("ebsrvHandler.scr")
				EQSRV.GLBDATA.srvYN	= "N"	
				EQSRV.GLBDATA.valerr	= "fetch srv failed"
				goto NXTLP
			else
				EQSRV.GLBDATA.gamcookie	=	BANCS.OUTPARAM.GAMCookie
				print(EQSRV.GLBDATA.gamcookie)
				EQSRV.GLBDATA.tamcookie	=	BANCS.OUTPARAM.TAMCookie
				print(EQSRV.GLBDATA.tamcookie)
			endif
			sv_a = urhk_CopyOutToIn("")
			sv_s = urhk_ExecSrv("SRV_ValidateTDAcctForClsr|same_user_verify = Y|retain_all_output = Y")
			print(sv_s)
			sv_f = BANCS.OUTPARAM.successOrFailure
			print(sv_f)
			if ((sv_s == 0 ) AND (sv_f == "S")) then
				print(BANCS.OUTPARAM.successOrFailure)
			else
				callscriptifexist("ebsrvHandler.scr")
				EQSRV.GLBDATA.srvYN	= "N"	
				EQSRV.GLBDATA.valerr	= "validate srv failed"
				goto NXTLP
			endif
			sv_a = urhk_CopyOutToIn("")
			sv_a = urhk_SetUrhkOut("tdAcctClsrDtls.GAMCookie|GAMCookie")
			sv_a = urhk_SetUrhkOut("tdAcctClsrDtls.TAMCookie|TAMCookie")
			sv_a = urhk_SetUrhkOut("tdAcctClsrOutStndFeeDtls.dsaPenalDtls.GEMCookie|GEMCookie")
			sv_a = urhk_SetUrhkOut("clsrRmks|clsrRmks")
			sv_a = urhk_SetUrhkOut("tdAcctClsrInfo.depAmt|depAmt")
			sv_a = urhk_SetUrhkOut("tdAcctClsrInfo.acctBal|acctBal")
			sv_a = urhk_SetUrhkOut("tdAcctClsrInfo.effIntPcnt|effIntPcnt")
			sv_a = urhk_SetUrhkOut("tdAcctClsrInfo.normalIntAmt|normalIntAmt")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_0>.key.serial_num|serial_num")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_0>.acctId|acctId")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_0>.acctCrncy|acctCrncy")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_0>.tranId|tranId")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_0>.partTranType|partTranType")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_0>.tranAmt|tranAmt")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_0>.tranParticulars|tranParticulars")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_1>.key.serial_num|serial_num")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_1>.acctId|acctId")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_1>.acctCrncy|acctCrncy")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_1>.tranId|tranId")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_1>.partTranType|partTranType")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_1>.tranAmt|tranAmt")
			sv_a = urhk_SetUrhkOut("tdClsrTranDtlLL.<rec_1>.tranParticulars|tranParticulars")
			sv_s = urhk_ExecSrv("SRV_CloseTDAcct|same_user_verify = Y|retain_all_output = Y")
			print(sv_s)
			if (sv_s == 0 )then
				#print(BANCS.OUTPARAM.successOrFailure)
				#EQSRV.GLBDATA.gamcookie1	=	BANCS.OUTPARAM.GAMCookie
				#EQSRV.GLBDATA.tamcookie1	=	BANCS.OUTPARAM.TAMCookie
				#EQSRV.GLBDATA.gemcookie1	=	BANCS.OUTPARAM.GEMCookie
			else
				callscriptifexist("ebsrvHandler.scr")
				EQSRV.GLBDATA.srvYN	= "N"	
				EQSRV.GLBDATA.valerr	= "clsoe srv failed"
				goto NXTLP
			endif
			sv_a = urhk_CopyOutToIn("")
			sv_s = urhk_ExecSrv("NAPI_VerifyTDAcctClsr|ignore_excp_flg=I|same_user_verify = Y|retain_all_output = Y")
			print(sv_s)
			sv_f = BANCS.OUTPARAM.successOrFailure
			print(sv_f)
			if ((sv_s == 0 ) AND (sv_f == "S")) then
				print(BANCS.OUTPARAM.successOrFailure)	
				EQSRV.GLBDATA.datafile  = "DepCls_" + EQSRV.GLBDATA.depositAcctId + ".DAT"
				print(EQSRV.GLBDATA.datafile)
				sv_r=SYSTEM("echo '"+'"'+EQSRV.GLBDATA.gSolId+'"'+"' > " + EQSRV.GLBDATA.datafile)
				sv_r=SYSTEM("echo '"+'"'+EQSRV.GLBDATA.depositAcctId+'"'+"' > " + EQSRV.GLBDATA.datafile)
				sv_r=SYSTEM("echo '"+'"'+EQSRV.GLBDATA.depositAcctId+'"'+"' > " + EQSRV.GLBDATA.datafile)
				sv_r=SYSTEM("echo ' ' > " + EQSRV.GLBDATA.datafile)
				sv_s="exebatch babx4465 $B2K_SESSION_ID < " + EQSRV.GLBDATA.datafile 
				sv_c=system(sv_s)
				print(sv_c) 
				if ( sv_c == 0 ) then
					EQSRV.GLBDATA.srvYN	= "Y"	
					EQSRV.GLBDATA.valerr	= "closed successfully" 
					goto NXTLP
				else
					EQSRV.GLBDATA.srvYN	= "N"	
					EQSRV.GLBDATA.valerr	= "closed but status failed" 
					goto NXTLP
				endif
				
			else
				callscriptifexist("ebsrvHandler.scr")
				EQSRV.GLBDATA.srvYN	= "N"	
				EQSRV.GLBDATA.valerr	= " verify srv failed"
				goto NXTLP
			endif
			NXTLP:
				sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.tamgamCurNum)
				print(sv_u)
				if(sv_u!=0)then
					print("fetch failed")
					sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.tamgamCurNum)
					print(sv_u)
					goto VAYU
				endif
				EQSRV.GLBDATA.tamgamrec = cint(EQSRV.GLBDATA.tamgamrec) + 1 
				EQSRV.GLBDATA.recmsg	= "Processing Record Num: " + EQSRV.GLBDATA.tamgamrec 	
				print(EQSRV.GLBDATA.recmsg)
		#}
		do
		sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.tamgamCurNum)
		print(sv_u)
VAYU:
	print(EQSRV.GLBDATA.srvYN)
	print(EQSRV.GLBDATA.valerr)
	exitscript
trace off
end-->
