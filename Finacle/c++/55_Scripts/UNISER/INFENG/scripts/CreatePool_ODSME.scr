	sv_a = sv_a +" FROM TBAADM.GAM WHERE bank_id='54' and schm_type in ('SBA','CAA') "
	sv_a = sv_a +"and cif_id in (select cif_id from tbaadm.gam where foracid=?SVAR) "
	sv_a = sv_a +"and acct_cls_flg='N' and acid in (select acid from tbaadm.smt where acct_status='A') "
	sv_a = sv_a +"and del_flg='N' and entity_cre_flg='Y' and rownum=1 "

	BANCS.INPARAM.BINDVARS = CUST.DATA.foracid
        PRINT(BANCS.INPARAM.BINDVARS)
