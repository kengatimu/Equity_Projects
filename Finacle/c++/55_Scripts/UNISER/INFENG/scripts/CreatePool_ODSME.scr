        #{
		CUST.DATA.poolid = BANCS.OUTPARAM.poolid
		print(CUST.DATA.poolid)
		
	#}
	ENDIF

	sv_a = urhk_SetUrhkInp("poolInfo.pool.ptype|S")
	sv_a = urhk_SetUrhkInp("poolInfo.pool.reglflag|Y")
	sv_a = urhk_SetUrhkInp("poolInfo.pool.id|" + CUST.DATA.poolid)
	sv_a = urhk_SetUrhkInp("poolInfo.cust.cifId|" + CUST.DATA.cifid)
	sv_a = urhk_SetUrhkInp("poolInfo.poolBalance|               0")

	sv_a = urhk_SetUrhkOut("poolInfo.PFTCookie|cookies")
	sv_a = urhk_SetUrhkOut("poolLL.<rec_0>.GAMCookie|cookie1")
	sv_a = urhk_SetUrhkOut("poolLL.<rec_0>.PARCookie|cookie2")

	#sv_u = urhk_ExecSrv("SRV_FetchPoolForVerify|retain_all_output = Y")
	sv_u = urhk_ExecSrv("SRV_FetchPoolForVerify|same_user_verify = Y|retain_all_output = Y")
	print(sv_u)

	IF(sv_u == 0) THEN
	PRINT("Success")
	print(BANCS.OUTPARAM.cookies)
	print(BANCS.OUTPARAM.cookie1)
	print(BANCS.OUTPARAM.cookie2)
	CUST.DATA.cookies = BANCS.OUTPARAM.cookies
	CUST.DATA.cookie1= BANCS.OUTPARAM.cookie1
	CUST.DATA.cookie2= BANCS.OUTPARAM.cookie2

	ELSE
	GOTO ERRORCHECK
	ENDIF

#########################################################################
#########Verify Pool Details
#########################################################################
	sv_a = urhk_SetUrhkInp("poolInfo.pool.ptype|S")
	sv_a = urhk_SetUrhkInp("poolInfo.pool.reglflag|Y")
	sv_a = urhk_SetUrhkInp("poolInfo.pool.id|" + CUST.DATA.poolid)
	sv_a = urhk_SetUrhkInp("poolInfo.cust.cifId|" + CUST.DATA.cifid)
	sv_a = urhk_SetUrhkInp("poolInfo.poolBalance|0")
	sv_a = urhk_SetUrhkInp("poolInfo.suspFlg|N")
	sv_a = urhk_SetUrhkInp("poolInfo.collSweepChrgInd|N")
	sv_a = urhk_SetUrhkInp("poolInfo.collModChrgInd|N")
	sv_a = urhk_SetUrhkInp("poolInfo.PFTCookie|" +CUST.DATA.cookies)
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.GAMCookie|" +CUST.DATA.cookie1)
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.PARCookie|" +CUST.DATA.cookie2)

	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.allowSweeps|Y")
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.key.serial_num|0")
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.acct.foracid|" + CUST.DATA.foracidSBA)
	#sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.scheme.schmCode|SB100")
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.scheme.schmCode|" +CUST.DATA.schmCodeSBA)
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.delFlg|N")
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.availBalance|" + CUST.DATA.availBalance)
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.acctPoaAsRecType|M")
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.nonContribBal|" + CUST.DATA.ffdContribution)
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.ffdContribution|" + CUST.DATA.nonContribBal)
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.orderOfUtilization|1")
############################################################################
######Setting out the parameters for SRV
############################################################################
	sv_u = urhk_ExecSrv("SRV_VerifyPool|same_user_verify = Y|retain_all_output = Y")
	print(sv_u)

	IF(sv_u == 0) THEN
	PRINT("Success")
	#EXITSCRIPT
	ELSE
