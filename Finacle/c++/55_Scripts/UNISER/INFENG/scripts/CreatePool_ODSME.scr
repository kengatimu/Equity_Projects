#CREATEPOOL:
##--------------------------------------------------------->
	 #CUST.DATA.foracid1 = "3005111156081"
	 #CUST.DATA.availBalance1 = "10.00|TZS"
	 #CUST.DATA.ffdContribution1 = "0.00|TZS"
	 #CUST.DATA.nonContribBal1 = "0.00|TZS"
	 #CUST.DATA.cifid1 = "55600051613"
	 #CUST.DATA.availBalance1 = "438518.01|TZS"

	#########################################
	######### Criteria page
	#########################################
	sv_a = urhk_SetUrhkInp("poolInfo.pool.ptype|S")
	sv_a = urhk_SetUrhkInp("poolInfo.pool.reglflag|Y")
	sv_a = urhk_SetUrhkInp("poolInfo.acct.foracid|" + CUST.DATA.foracidSBA)
	sv_a = urhk_SetUrhkInp("poolInfo.poolDesc|Ok")
	sv_u = urhk_ExecSrv("SRV_FetchPoolForCreate|retain_all_output = Y")
	print(sv_u)

	IF(sv_u == 0) THEN
	PRINT("Success")
	ELSE
	GOTO ERRORCHECK
	ENDIF
####--------------------------------------------------------------Record One Start---------------------------------------------------------------------------->
	########################################
	###### Detailed page
	########################################
	sv_a = urhk_SetUrhkInp("poolInfo.pool.ptype|S")
	sv_a = urhk_SetUrhkInp("poolInfo.pool.reglflag|Y")
	sv_a = urhk_SetUrhkInp("poolInfo.acct.foracid|" + CUST.DATA.foracidSBA)
	sv_a = urhk_SetUrhkInp("poolInfo.poolDesc|Ok")
	sv_a = urhk_SetUrhkInp("poolInfo.collSweepChrgInd|N")
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.key.serial_num|    0")
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.acct.foracid|" + CUST.DATA.foracidSBA)
	#sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.scheme.schmCode|SB100")
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.scheme.schmCode|" + CUST.DATA.schmCodeSBA)
	sv_a = urhk_SetUrhkInp("poolLL.<rec_0>.allowSweeps|Y")
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.delFlg|N")
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.availBalance|" + CUST.DATA.availBalance)
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.acctPoaAsRecType|M")
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.nonContribBal|" + CUST.DATA.ffdContribution)
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.ffdContribution|" + CUST.DATA.nonContribBal)
	sv_a =  urhk_SetUrhkInp("poolLL.<rec_0>.orderOfUtilization|1")
	
	sv_u = urhk_ExecSrv("SRV_CreatePool|same_user_verify = Y|retain_all_output = Y")
	print(sv_u)

	IF(sv_u == 0) THEN
	PRINT("Success")
	ELSE
	GOTO ERRORCHECK
	ENDIF

################################################################
##########Fectch details for verify
################################################################

	#sv_q = "poolid|select pool_id from tbaadm.ga0 where foracid=?SVAR"
	sv_q = "poolid|select pool_id from tbaadm.PFT where pool_id in(select pool_id from tbaadm.ga0 where foracid=?SVAR)"
	BANCS.INPARAM.BINDVARS = CUST.DATA.foracidSBA
        PRINT(BANCS.INPARAM.BINDVARS)
        sv_d = urhk_dbSelectWithBind(sv_q)
        PRINT(sv_d)
