	BANCS.INPARAM.BINDVARS = CUST.DATA.foracidSBA
        PRINT(BANCS.INPARAM.BINDVARS)
        sv_f = urhk_dbSqlWithBind(sv_c)
        PRINT(sv_f)
	sv_f = urhk_dbSqlWithBind("commit")

	sv_q = "availBalanceOD|select clr_bal_amt from tbaadm.gam where  foracid=?SVAR"
