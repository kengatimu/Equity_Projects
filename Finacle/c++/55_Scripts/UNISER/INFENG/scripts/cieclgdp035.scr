	######################################################################################
	# Clearing Amount Limit Check
	######################################################################################
	
	CALL("cieclgdp005.scr")
	
	IF(CUST.CIECLG.scriptSuccess == "N")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Get Bank Id, Branch Id, Sort Code from CPARAM
	######################################################################################
	
	IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
	#{
		CUST.CIECLG.parameterId = "DEFAULT_BANK_CODE_" + CUST.CIECLG.instrumentEntity
		#}
	ELSE
		#{
		CUST.CIECLG.parameterId = "DEFAULT_BANK_CODE_" + CUST.CIECLG.creditEntity
	#}
	ENDIF
	
	print(CUST.CIECLG.parameterId)
	
	sv_s = "defaultBankCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Bank Code to lodge instrument in " + CUST.CIECLG.creditEntity + " is not set in CPARAM^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.defaultBankCode = BANCS.OUTPARAM.defaultBankCode
	print(CUST.CIECLG.defaultBankCode)
	
	IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
	#{
		CUST.CIECLG.parameterId = "DEFAULT_BRANCH_CODE_" + CUST.CIECLG.instrumentEntity
		#}
	ELSE
		#{
		CUST.CIECLG.parameterId = "DEFAULT_BRANCH_CODE_" + CUST.CIECLG.creditEntity
	#}
	ENDIF
	
	print(CUST.CIECLG.parameterId)
	
	sv_s = "defaultBranchCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Branch Code to lodge instrument in " + CUST.CIECLG.creditEntity + " is not set in CPARAM^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.defaultBranchCode = BANCS.OUTPARAM.defaultBranchCode
	print(CUST.CIECLG.defaultBranchCode)
	
	CUST.CIECLG.defaultSortCode = "100200300"
	
	######################################################################################
	# Lodge Instrument as Outward Reject in current entity
	######################################################################################
	
	CALL("cieclgdp036.scr")
	
	IF(CUST.CIECLG.scriptSuccess == "N")THEN
	#{
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Lodge Instrument as Outward Reject in Other Entity
	######################################################################################
	
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
	#{
		sv_a = CUST.CIECLG.vostroAcct
		print(sv_a)
		CUST.CIECLG.foracid = CUST.CIECLG.vostroAcct
		CUST.CIECLG.bankId = CUST.CIECLG.instrumentEntity
		CUST.CIECLG.presentingBankCode = CUST.CIECLG.instrumentBankCode
		CUST.CIECLG.presentingBranchCode = CUST.CIECLG.instrumentBranchCode
		CUST.CIECLG.presentingSortCode = CUST.CIECLG.instrumentSortCode
		#}
	ELSE
		#{
		sv_a = CUST.CIECLG.crAcctNum
		print(sv_a)
		CUST.CIECLG.foracid = CUST.CIECLG.crAcctNum
		CUST.CIECLG.bankId = CUST.CIECLG.creditEntity
		CUST.CIECLG.presentingBankCode = CUST.CIECLG.defaultBankCode
		CUST.CIECLG.presentingBranchCode = CUST.CIECLG.defaultBranchCode
		CUST.CIECLG.presentingSortCode = " "
	#}
	ENDIF
	
	print(BANCS.STDIN.sysDate)
	
	sv_s = "RequestID|SELECT CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0)THEN
	#{
		CUST.CIECLG.RequestID = BANCS.OUTPARAM.RequestID
		print(CUST.CIECLG.RequestID)
		#}
	ELSE
		#{
		CUST.CIECLG.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(CUST.CIECLG.RequestID)
	#}
	ENDIF
	
	CUST.INTERFACE.funcCode = "OR"
	CUST.INTERFACE.RequestID = CUST.CIECLG.RequestID
	CUST.INTERFACE.channelID = "COR"
	CUST.INTERFACE.bankID = CUST.CIECLG.bankId
	CUST.INTERFACE.zoneCode = CUST.CIECLG.targetZoneCode
	CUST.INTERFACE.zoneDate = CUST.CIECLG.targetZoneDate
	CUST.INTERFACE.solId = CUST.CIECLG.targetSolId
	CUST.INTERFACE.setNum = CUST.CIECLG.targetSetNum
	CUST.INTERFACE.acctId = CUST.CIECLG.foracid
	CUST.INTERFACE.instrumentAmt = CUST.CIECLG.instrumentAmt
	CUST.INTERFACE.instrumentAmtCcy = CUST.CIECLG.instrumentAmtCcy
	CUST.INTERFACE.sortCode = CUST.CIECLG.presentingSortCode
	CUST.INTERFACE.bankCode = CUST.CIECLG.presentingBankCode
	CUST.INTERFACE.branchCode = CUST.CIECLG.presentingBranchCode
	CUST.INTERFACE.instrumentNum = CUST.CIECLG.instrumentNum
	CUST.INTERFACE.instrumentDate = CUST.CIECLG.instrumentDate
	CUST.INTERFACE.valueDate = CUST.CIECLG.valueDate
	CUST.INTERFACE.payingAcct = CUST.CIECLG.payingAcct
	CUST.INTERFACE.rejectReasonCode = CUST.CIECLG.rejectReasonCode
	CUST.INTERFACE.errorCode = ""
	CUST.INTERFACE.errorMsg = ""
	CUST.INTERFACE.errorDesc = ""
	CUST.INTERFACE.errorMsgFlg = "N"
	
	CALL("cieclgmn004.scr")
	
	IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
	#{
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Unable to mark instrument as outward reject in the target entity^creditEntity"
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		sv_s = "Error_2|Error^" + CUST.INTERFACE.errorDesc + "^creditEntity"
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Update status in IECD Custom Table
	######################################################################################
	
	sv_s = "UPDATE CUSTOM.IECD SET "
	sv_s = sv_s + " STATUS_FLG = 'O',"
	sv_s = sv_s + " REJECT_REASON_CODE = ?SVAR" + ","
	sv_s = sv_s + " LCHG_USER_ID = ?SVAR" + ","
	sv_s = sv_s + " LCHG_TIME = sysdate"
	sv_s = sv_s + " WHERE ZONE_CODE = ?SVAR"
	sv_s = sv_s + " AND ZONE_DATE = to_date(?SVAR,'DD-MM-YYYY')"
	sv_s = sv_s + " AND SOL_ID = ?SVAR"
	sv_s = sv_s + " AND TRIM(SET_NUM) = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND REVERSE_FLG = 'N'"
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.rejectReasonCode	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId 		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.zoneCode 		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.zoneDate 		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId 		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + TRIM(CUST.CIECLG.setNum) 	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		CUST.CIECLG.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Database Update Operation Failed ON Custom Table^funcCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Result Message
	######################################################################################
	
	sv_s = "RESULT_MSG|Instrument Marked as Outward Reject Successfully"
	sv_s = sv_s + "!" + CUST.CIECLG.funcCode + "!" + CUST.CIECLG.zoneCode + "!" + CUST.CIECLG.zoneDate + "!" + BANCS.STDIN.mySolId + "!" + CUST.CIECLG.setNum
	sv_s = sv_s + "!" + CUST.CIECLG.targetZoneCode + "!" + CUST.CIECLG.targetZoneDate + "!" + CUST.CIECLG.targetSolId + "!" + CUST.CIECLG.targetSetNum
	
	print(sv_s)
	sv_u = urhk_SetOrbOut(sv_s)
	print(sv_u)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	print(sv_u)
	
	ENDOFSCRIPT:
END-->
