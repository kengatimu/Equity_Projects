#----------------------------------------------------------------------------------------------------------
# Filename              :       hdenomdp003.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to insert data in table at add mode.
# Input                 :       Frontend field values
# Output                :       None
# Called Script         :       None
# Calling Script        :       hdenommn005.scr
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           07-05-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="f760aaba4c0b647520b8223a72b86dea14dda68db14f0703cd583232583d3f2a"
	TRACE ON
	# In rak bank Code
	# In add mode, they are allowed the user add Denomination for Delete Currency also.
	# For that,
	# If the NOTE/COIN Denomonation value is same as the already NOTE/COIN Denomonation value
	# present for currency with DEL_FLG as "Y", then they skip the insert statement and record
	# with del_flg 'Y' will be there.
	
	# For record which didnt match with any existing NOTE/COIN Denomonation value with DEL_FLG as
	# "Y", they insert new record with del_flg as 'N'.
	
	# For other existing records NOTE/COIN Denomonation value with DEL_FLG as 'Y' which doesnt match
	# with any enter value by user, they are delete these record physically.
	
	# In this code flow, If user adding Denomination for Delete Currency
	# First, we are Deleteing all record physically present in table with Del_flg as 'Y'
	# and then insert all the new record entered by user with del_flg as 'N'.
	#--------------------------------------------------------------------------------------
	# Checking for currency Denomination already present with DEL_FLG as 'Y'.
	#--------------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.DENOM.crncyCode
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|Y"+ "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "counter|"
	sv_s = sv_s + " SELECT count(*)"
	sv_s = sv_s + " FROM CUSTOM.C_MDNM "
	sv_s = sv_s + " WHERE CRNCY_CODE = ?SVAR "
	sv_s = sv_s + " AND DEL_FLG = ?SVAR AND bank_id = ?SVAR"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# throwing error
		#CUST.DENOM.errorMsg = "Oracle Error - Try after sometime."
		CUST.INTERFACE.errorCode = "DENOM_ERR_002"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "abc"
		CUST.DENOM.successFlg = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DENOM.counter = BANCS.OUTPARAM.counter
		print(CUST.DENOM.counter)
	#}
	ENDIF
	IF (CUST.DENOM.counter != "0") THEN
	#{
		#------------------------------------------------------------------------------
		# Delete the old records from table CUSTOM.C_MDNM with DEL_FLG as 'Y'
		#------------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = CUST.DENOM.crncyCode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|Y" + "|" + BANCS.STDIN.contextBankId
		sv_s = "DELETE FROM CUSTOM.C_MDNM "
		sv_s = sv_s + " WHERE CRNCY_CODE = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG = ?SVAR AND bank_id = ?SVAR"
		print(sv_s)
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		IF(sv_d != 0)THEN
		#{
			# throwing error
			#CUST.DENOM.errorMsg = "Oracle Error - Try after sometime."
			CUST.INTERFACE.errorCode = "DENOM_ERR_002"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.DENOM.fieldName = "abc"
			CUST.DENOM.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	#------------------------------------------------------------------------------
	# Initializing the counter values
	#------------------------------------------------------------------------------
	CUST.DENOM.coinDenomCounter = "01"
	CUST.DENOM.noteDenomCounter = "01"
	#------------------------------------------------------------------------------
	# Loop for inserting the value for Note Denomination
	#------------------------------------------------------------------------------
	WHILE (CINT(CUST.DENOM.noteDenomCounter) < 16)
	#{
		print(CUST.DENOM.noteDenomCounter)
		CUST.DENOM.denomInd = "N"
		CUST.DENOM.denomValue = ("CUST").("DENOM").("noteDenom" + CUST.DENOM.noteDenomCounter)
		print(CUST.DENOM.denomValue)
		
		IF (TRIM(CUST.DENOM.denomValue) != "") THEN
		#{
			#------------------------------------------------------------------------------
			# Inserting data into table C_MDNM
			#------------------------------------------------------------------------------
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncyCode
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.denomInd
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.denomValue
			
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.userId
			
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "INSERT INTO CUSTOM.C_MDNM"
			sv_s = sv_s + " NAME("
			sv_s = sv_s + "SOL_ID,CRNCY_CODE,DENOM_IND,DENOM_VALUE,"
			sv_s = sv_s + "RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,"
			sv_s = sv_s + "DEL_FLG,BANK_ID"
			sv_s = sv_s + ") VALUES("
			
			sv_s = sv_s + "?SVAR,?SVAR,?SVAR,?SVAR,"
			sv_s = sv_s + "?SVAR,SYSDATE,?SVAR,SYSDATE,"
			sv_s = sv_s + "?SVAR,?SVAR"
			
			sv_s = sv_s + ")"
			print(sv_s)
			sv_d = urhk_dbSQLWithBind(sv_s)
			print(sv_d)
			IF(sv_d != 0)THEN
			#{
				# throwing error
				#CUST.DENOM.errorMsg = "Unable to insert in table CUSTOM.C_MDNM."
				CUST.INTERFACE.errorCode = "DENOM_ERR_015"
				CALL("Common_Interface_GetErrorDesc.scr")
				CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
				CUST.DENOM.fieldName = "abc"
				CUST.DENOM.successFlg = "F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		#------------------------------------------------------------------------------
		# increasing counter value
		#------------------------------------------------------------------------------
		CUST.DENOM.noteDenomCounter = CINT(CUST.DENOM.noteDenomCounter) + 1
		print(CUST.DENOM.noteDenomCounter)
		sv_l = STRLEN(CUST.DENOM.noteDenomCounter)
		IF (sv_l != 2) THEN
		#{
			CUST.DENOM.noteDenomCounter = "0" + CUST.DENOM.noteDenomCounter
		#}
		ENDIF
		print(CUST.DENOM.noteDenomCounter)
	#}
	DO
	
	#------------------------------------------------------------------------------
	# Loop for inserting the value for Coin Denomination
	#------------------------------------------------------------------------------
	WHILE (CINT(CUST.DENOM.coinDenomCounter) < 16)
	#{
		print(CUST.DENOM.coinDenomCounter)
		CUST.DENOM.denomInd = "C"
		CUST.DENOM.denomValue = ("CUST").("DENOM").("coinDenom" + CUST.DENOM.coinDenomCounter)
		print(CUST.DENOM.denomValue)
		IF (TRIM(CUST.DENOM.denomValue) != "") THEN
		#{
			#------------------------------------------------------------------------------
			# Inserting data into table C_MDNM
			#------------------------------------------------------------------------------
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncyCode
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.denomInd
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.denomValue
			
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.userId
			
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "INSERT INTO CUSTOM.C_MDNM"
			sv_s = sv_s + " NAME("
			sv_s = sv_s + "SOL_ID,CRNCY_CODE,DENOM_IND,DENOM_VALUE,"
			sv_s = sv_s + "RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,"
			sv_s = sv_s + "DEL_FLG,BANK_ID"
			sv_s = sv_s + ") VALUES("
			
			sv_s = sv_s + "?SVAR,?SVAR,?SVAR,?SVAR,"
			sv_s = sv_s + "?SVAR,SYSDATE,?SVAR,SYSDATE,"
			sv_s = sv_s + "?SVAR,?SVAR"
			
			sv_s = sv_s + ")"
			print(sv_s)
			sv_d = urhk_dbSQLWithBind(sv_s)
			print(sv_d)
			IF(sv_d != 0)THEN
			#{
				# throwing error
				#CUST.DENOM.errorMsg = "Unable to insert in table CUSTOM.C_MDNM."
				CUST.INTERFACE.errorCode = "DENOM_ERR_015"
				CALL("Common_Interface_GetErrorDesc.scr")
				CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
				CUST.DENOM.fieldName = "abc"
				CUST.DENOM.successFlg = "F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		#------------------------------------------------------------------------------
		# increasing counter value
		#------------------------------------------------------------------------------
		CUST.DENOM.coinDenomCounter = CINT(CUST.DENOM.coinDenomCounter) + 1
		print(CUST.DENOM.coinDenomCounter)
		sv_l = STRLEN(CUST.DENOM.coinDenomCounter)
		IF (sv_l != 2) THEN
		#{
			CUST.DENOM.coinDenomCounter = "0" + CUST.DENOM.coinDenomCounter
		#}
		ENDIF
		print(CUST.DENOM.coinDenomCounter)
	#}
	DO
	# setting message for result page
	CUST.DENOM.resultPageMsg = "Denomination details are added successfully"
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
END-->
