	lv_r = urhk_dbSQLWithBind(lv_d)
	print(lv_r)
	if(lv_r == 0) then
		EBSRV.GLBDATA.resMsg = "BlackList Details Cancelled Successfully"
		GOTO ENDOFSCRIPT
	else
		EBSRV.GLBDATA.errMsg = "No-Modification History "
		GOTO ENDOFSCRIPT
	endif
#}
endif

if(EBSRV.GLBDATA.recVerType == "MOD") then
#{
	lv_d = " DELETE FROM CUSTOM.caml_mod "
	lv_d = lv_d + " WHERE id_number =?SVAR " 
