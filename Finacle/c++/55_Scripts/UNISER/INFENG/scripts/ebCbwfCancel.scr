<--start
trace on
callscriptifexist("ebRepClass.scr")
sv_u=urhk_B2K_PrintRepos("BANCS")
print(sv_u)
EBSRV.GLBDATA.recVerType = BANCS.INPUT.RecVerifyType
print(EBSRV.GLBDATA.recVerType)
if(EBSRV.GLBDATA.funcCode=="D")then
	lv_d = "update custom.caml set del_flg='N' ,entity_cre_flg='X' " 
	lv_d = lv_d + " WHERE id_number = ?SVAR " 
	lv_d = lv_d + " AND BANK_ID = ?SVAR "
	lv_d = lv_d + " AND DEL_FLG <> 'Y' "
	print(lv_d)
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
        print(BANCS.INPARAM.BINDVARS)
	
	lv_r = urhk_dbSQLWithBind(lv_d)
	print(lv_r)
	if(lv_r == 0) then
		EBSRV.GLBDATA.resMsg = "BlackList Details Deleted Successfully Please Verify"
		GOTO ENDOFSCRIPT
	else
		EBSRV.GLBDATA.errMsg = "No-Modification History "
		GOTO ENDOFSCRIPT
	endif
endif
if(EBSRV.GLBDATA.recVerType == "MAIN") then
#{
	lv_d = " DELETE FROM CUSTOM.caml "
