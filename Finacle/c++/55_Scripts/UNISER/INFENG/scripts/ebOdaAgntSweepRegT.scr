#------------------------------------------------------------------------------------------------
#  Name            : ebAgentSweepRegT.scr 
#  Description     : Tran
#  Date            : 01-04-2020
#  Author          : Vino Palani
#  Menu Option     : CSWOP/MSWOP(daily job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             01-04-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON
if(repexists("MTT")==0)then
	createrep("MTT")
endif
if(classexists("MTT","TranDetails")==0)then
	createclass("MTT","TranDetails",5)
endif
if(classexists("MTT","PartTranDetails")==0)then
	createclass("MTT","PartTranDetails",5)
endif
MTT.TranDetails.TranDateDiff    = "0"
MTT.TranDetails.TranType        = "T"
MTT.TranDetails.TranSubType     = "CI"
MTT.TranDetails.IgnoreExcp      = "I"
MTT.TranDetails.Consolidate     = "Y"
MTT.TranDetails.PostFlag        = "Y"
#MTT.TranDetails.ReversalFlg     = "Y"
MTT.TranDetails.PrintAdviceInd  = "B"
if(EBSRV.GLBDATA.LiquidityModule != "MERNT-LM")then
MTT.TranDetails.Remarks         = "Agnt Sweeps Transactions"
endif
if(EBSRV.GLBDATA.LiquidityModule == "MERNT-LM")then
MTT.TranDetails.Remarks         = "Merchant Sweeps Tran"
endif
EBSRV.GLBDATA.remark = "TEST"
EBSRV.GLBDATA.ref_num = "765876t"
sv_a = urhk_MTTS_PopulateInputDetails("")
print(sv_a)
sv_r = urhk_MTTS_DefineTransaction("BGAMORT")
print(sv_r)

IF (sv_r != 0)THEN
        MTT.Error.Description = "Error encountered in Define Transaction"
        sv_r = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ENDIF
#Creation of Debit leg
MTT.PartTranDetails.Account             = EBSRV.GLBDATA.drAcct 
print(MTT.PartTranDetails.Account)
MTT.PartTranDetails.RefCurrency         = EBSRV.GLBDATA.drCrncy 
MTT.PartTranDetails.TranCurrency        = EBSRV.GLBDATA.drCrncy  
MTT.PartTranDetails.Particulars         = "Sweep Trf From:" + EBSRV.GLBDATA.crAcct 
print(MTT.PartTranDetails.Particulars)
if(EBSRV.GLBDATA.LiquidityModule != "MERNT-LM")then
MTT.PartTranDetails.RefAmount           = -(cdouble(EBSRV.GLBDATA.drTranAmt))
print(MTT.PartTranDetails.RefAmount)
MTT.PartTranDetails.Amount              = -(cdouble(EBSRV.GLBDATA.drTranAmt))
print(MTT.PartTranDetails.Amount)
endif
if(EBSRV.GLBDATA.LiquidityModule == "MERNT-LM")then
MTT.PartTranDetails.RefAmount           = -(cdouble(EBSRV.GLBDATA.eodOverAmt))
print(MTT.PartTranDetails.RefAmount)
MTT.PartTranDetails.Amount              = -(cdouble(EBSRV.GLBDATA.eodOverAmt))
print(MTT.PartTranDetails.Amount)
endif
MTT.PartTranDetails.Refnum              = EBSRV.GLBDATA.PoolId 
print(MTT.PartTranDetails.Refnum)
MTT.PartTranDetails.RateCode            = ""
print(MTT.PartTranDetails.RateCode)
MTT.PartTranDetails.Rate                = "" 
print(MTT.PartTranDetails.Rate)
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "Y"
MTT.PartTranDetails.ReportCode  	= "AGNTPOL"
MTT.PartTranDetails.ValueDateDiff       = "0"
MTT.PartTranDetails.Remarks             = EBSRV.GLBDATA.PoolId 
print(MTT.PartTranDetails.Remarks)
MTT.PartTranDetails.PstFlg              = "Y"
sv_r = urhk_MTTS_DefinePartTran("AMORT")
print(sv_r)
IF (sv_r!=0)THEN
        MTT.Error.Description = "Unable to define debit part tran"
        sv_r = urhk_MTTS_ReportErrorCondition("DEBIT")
        goto VAYU
ENDIF
# Creation of credit leg
MTT.PartTranDetails.Account             = EBSRV.GLBDATA.crAcct 
print(MTT.PartTranDetails.Account)
MTT.PartTranDetails.RefCurrency         = EBSRV.GLBDATA.drCrncy 
print(MTT.PartTranDetails.RefCurrency)
MTT.PartTranDetails.TranCurrency        = EBSRV.GLBDATA.drCrncy 
print(MTT.PartTranDetails.TranCurrency)
MTT.PartTranDetails.Particulars         = "Sweep Trf For POOL Regul"
print(MTT.PartTranDetails.Particulars)
if(EBSRV.GLBDATA.LiquidityModule != "MERNT-LM")then
MTT.PartTranDetails.RefAmount           = (cdouble(EBSRV.GLBDATA.drTranAmt))
print(MTT.PartTranDetails.RefAmount)
MTT.PartTranDetails.Amount              = (cdouble(EBSRV.GLBDATA.drTranAmt))
print(MTT.PartTranDetails.Amount)
endif
if(EBSRV.GLBDATA.LiquidityModule == "MERNT-LM")then
MTT.PartTranDetails.RefAmount           = (cdouble(EBSRV.GLBDATA.eodOverAmt))
print(MTT.PartTranDetails.RefAmount)
MTT.PartTranDetails.Amount              = (cdouble(EBSRV.GLBDATA.eodOverAmt))
print(MTT.PartTranDetails.Amount)
endif
MTT.PartTranDetails.Refnum              = EBSRV.GLBDATA.PoolId 
print(MTT.PartTranDetails.Refnum)
MTT.PartTranDetails.RateCode            = ""
MTT.PartTranDetails.Rate                = "" 
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "Y"
MTT.PartTranDetails.ReportCode  	= "AGNTPOL"
MTT.PartTranDetails.ValueDateDiff       = "0"
MTT.PartTranDetails.Remarks             = EBSRV.GLBDATA.PoolId 
MTT.PartTranDetails.PstFlg              = "Y"

sv_t = urhk_MTTS_DefinePartTran("AMORT")
print(sv_t)
IF(sv_t!=0)THEN
        MTT.Error.Description = "Unable to define credit part tran"
        sv_t = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ENDIF
#Tran Status
MTT.Error.Description   = ""
BANCS.INPUT.TranStatus  = "S"
sv_r = urhk_MTTS_EndDefinition("")
print(sv_r)
IF(sv_r!=0)THEN
        MTT.Error.Description = "Unable to end definition"
        sv_r = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ELSE
        EBSRV.GLBDATA.MTTTranId = BANCS.OUTPARAM.MTTTranId
        print(EBSRV.GLBDATA.MTTTranId)
        goto VAYU
ENDIF
VAYU:
exitscript
TRACE OFF
END-->

