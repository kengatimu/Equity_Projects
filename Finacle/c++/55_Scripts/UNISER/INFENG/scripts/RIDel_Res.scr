<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether INTERFACE Class exists else create it
	###########################################################################################
		
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	
	CUST.INTERFACE.status = ""
	

	CUST.INTERFACE.ri_mesg = ""
	CUST.INTERFACE.ri_errorCode = ""
	CUST.INTERFACE.ri_errorDesc = ""
	CUST.INTERFACE.ri_msg= ""
	CUST.INTERFACE.ri_errMsg= ""
	CUST.INTERFACE.ri_respStatus = ""
	CUST.INTERFACE.ri_errorMsgFlg = ""
	
	sv_x = CUST.INTERFACE.respXMLMsg
	
	#--------------------------------------------------------------------------------------------------------
	# Fetching the status of the request
	#--------------------------------------------------------------------------------------------------------
	sv_y = "HostTransaction>"
	sv_z = "</HostTransaction>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.ubusStuatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		sv_x = CUST.INTERFACE.ubusStuatus
		PRINT(sv_x)
		sv_y = "<Status>"
		sv_z = "</Status>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.status = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
			PRINT(CUST.INTERFACE.status)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.status = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.status)
	
	#--------------------------------------------------------------------------------------------------------
	# If Success the fetch other values from the response xml
	#--------------------------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.status == "SUCCESS") THEN
	#{
		CUST.INTERFACE.ri_errorMsgFlg = "N"
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<executeFinacleScriptResponse>"
		sv_z = "</executeFinacleScriptResponse>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			
			sv_y = "<executeFinacleScript_CustomData>"
			sv_z = "</executeFinacleScript_CustomData>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				
				sv_y = "<RIDel_RES>"
				sv_z = "</RIDel_RES>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF(GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<RIStatus>"
					sv_z = "</RIStatus>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.ri_respStatus = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
						print(CUST.INTERFACE.ri_respStatus)
					#}
					ENDIF
					
					IF(CUST.INTERFACE.ri_respStatus == "SUCCESS")THEN
					#{
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<MESSAGE>"
						sv_z = "</MESSAGE>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.ri_msg = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,100)
							print(CUST.INTERFACE.ri_msg)
						#}
						ENDIF
						
					#}
					ELSE
					#{
						print("inelse err")
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<ErrorMessage>"
						sv_z = "</ErrorMessage>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.ri_errMsg= MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,80)
							print(CUST.INTERFACE.ri_errMsg)
						#}
						ENDIF
						
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		
	#}
	ELSE
	#{
		CUST.INTERFACE.ri_errorMsgFlg = "Y"
		IF(CUST.INTERFACE.status == "FAILURE") THEN
		#{
			sv_x = CUST.INTERFACE.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.ri_errorCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
				PRINT(CUST.INTERFACE.ri_errorCode)
			#}
			ENDIF
			IF(CUST.INTERFACE.ri_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorDesc>"
				sv_z = "</ErrorDesc>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.ri_errorDesc = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,120)
					PRINT(CUST.INTERFACE.ri_errorDesc)
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		IF((CUST.INTERFACE.ri_errorCode == "") AND (CUST.INTERFACE.ri_errorDesc == "")) THEN
		#{
			CUST.INTERFACE.ri_errorCode = "SYSERR"
			CUST.INTERFACE.ri_errorDesc = "Could not get response from server"
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.INTERFACE.ri_errorMsgFlg)
	
	PRINT(CUST.INTERFACE.ri_errorCode)
	PRINT(CUST.INTERFACE.ri_errorDesc)

	
	
	
	#TRACE OFF
END-->
