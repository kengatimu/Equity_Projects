<--START
CHECKSUM="c91f8ac6ce3ba58f6d034bbe16ccde5b6a239a2bf4a1f88af21ec8f8bda203f4"
	TRACE ON
	
	########################################
	# Create the necessary repos and classes
	########################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.bankId = BANCS.STDIN.contextBankId
	CUST.DATA.pageSize = CINT(BANCS.INPUT.pageSize)
	CUST.DATA.pageNumber = CINT(BANCS.INPUT.pageNumber)
	CUST.DATA.telId = TOUPPER(BANCS.INPUT.telId)
	CUST.DATA.solId = BANCS.INPUT.solId
	
	print(CUST.DATA.bankId)
	print(CUST.DATA.pageSize)
	print(CUST.DATA.pageNumber)
	print(CUST.DATA.telId)
	print(CUST.DATA.solId)
	
	CUST.DATA.min =  (CINT(CUST.DATA.pageNumber)*CINT(CUST.DATA.pageSize)) - CINT(CUST.DATA.pageSize) + 1
	print(CUST.DATA.min)
	
	CUST.DATA.max = CINT(CUST.DATA.pageNumber)*CINT(CUST.DATA.pageSize)
	print(CUST.DATA.max)
	
	sv_s = "recCount|select count(1) "
	sv_s = sv_s + "FROM ( select a.*,rownum rnum "
	sv_s = sv_s + "FROM (select distinct emp_id "
	sv_s = sv_s + "FROM gec WHERE bank_id = '"+ CUST.DATA.bankId +"'  AND "
	IF(CUST.DATA.telId != "")THEN
	#{
		sv_s = sv_s + " emp_id like '"+ CUST.DATA.telId +"%'   AND del_flg != 'Y' "
		#}
	ELSE
		#{
		#Added by Ansa for QC Id: 3367
		IF(CUST.DATA.solId != "")THEN
		#{
			sv_s = sv_s + " sol_id = '"+ CUST.DATA.solId +"' AND del_flg != 'Y' "
			#}
		ELSE
			#{
			sv_s = sv_s + " del_flg !='Y'"
		#}
		ENDIF
		#End
	#}
	ENDIF
	sv_s = sv_s + " ) a where rownum <=  " + CUST.DATA.max + " ) b "
	sv_s = sv_s + " where rnum >= " + CUST.DATA.min
	print(sv_s)
	sv_c = urhk_dbSelectWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c != 0) THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("Error_01|SQL ERROR")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.recCount = BANCS.OUTPARAM.recCount
		print(CUST.DATA.recCount)
		sv_d = urhk_SetOrbOut("recCount|" + CUST.DATA.recCount)
		
	#}
	ENDIF
	
	IF(CINT(CUST.DATA.recCount) != 0) THEN
	#{
		sv_s = "emp_id |select emp_id from ( select a.*,rownum rnum from (select distinct "
		sv_s = sv_s + " emp_id from gec where  bank_id = '"+ CUST.DATA.bankId +"'  AND "
		IF(CUST.DATA.telId != "")THEN
		#{
			sv_s = sv_s + " emp_id like '"+ CUST.DATA.telId +"%'  AND del_flg != 'Y'"
			#}
		ELSE
			#{
			#Added by Ansa for QC Id: 3367
			IF(CUST.DATA.solId != "")THEN
			#{
				sv_s = sv_s + " sol_id = '"+ CUST.DATA.solId +"' AND del_flg != 'Y' "
				#}
			ELSE
				#{
				sv_s = sv_s + " del_flg !='Y'"
			#}
			ENDIF
			#End
		#}
		ENDIF
		sv_s = sv_s + " ) a where rownum <=  " + CUST.DATA.max + " ) b "
		sv_s = sv_s + " where rnum >= " + CUST.DATA.min
		sv_e = urhk_dbCursorOpenWithBind(sv_s)
		print(sv_e)
		
		IF (sv_e != 0) THEN
		#{
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			
			sv_f = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(sv_f)
			
			sv_e = urhk_dbCursorFetch(sv_f)
			print(sv_e)
			sv_z = 1
			
			WHILE(sv_e == 0)
			#{
				CUST.DATA.emp_id = BANCS.OUTPARAM.emp_id
				print(CUST.DATA.emp_id)
				IF(CUST.DATA.emp_id == "")THEN
				#{
					CUST.DATA.emp_id = "  "
				#}
				ENDIF
				
				sv_y = format$(sv_z, "%d")
				
				sv_s = "telId_" + sv_y + "|" + CUST.DATA.emp_id
				print(sv_s)
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				sv_z = sv_z + 1
				sv_e = urhk_dbCursorFetch(sv_f)
				print(sv_e)
			#}
			DO
			sv_d = urhk_dbCursorClose(sv_f)
			print(sv_d)
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
