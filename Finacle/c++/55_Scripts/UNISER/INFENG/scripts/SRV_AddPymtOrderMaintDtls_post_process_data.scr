<--START
CHECKSUM="dd8d8a06d960fe41842828cffec2c69729e09f0781dcced728f644c1b2a20240"
	TRACE ON
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF(REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUSTS","DATA") == 0) THEN
	#{
		CREATECLASS("CUSTS","DATA",5)
	#}
	ENDIF
	
	sv_a=urhk_B2k_PrintRepos("BANCS")
	
	sv_a = urhk_SRV_GetVal("pordHeaderDtls.drAcct.foracid")
	CUSTS.DATA.foracid=BANCS.OUTPARAM.srvValue
	print(CUSTS.DATA.foracid)

	sv_a = urhk_SRV_GetVal("pordHeaderDtls.tresExchRefNo")
	CUSTS.DATA.ExchRefNo=BANCS.OUTPARAM.srvValue
	print(CUSTS.DATA.ExchRefNo)
	
	IF (BANCS.STDIN.contextBankId=="54") THEN
	#{
		sv_u = urhk_getAcctDetailsInRepository(CUSTS.DATA.foracid)
		print(sv_u)
		IF (sv_u==0) THEN
		#{
			
			print(BANCS.OUTPARAM.acctOwnerShip)
			
			CUSTS.DATA.ownership=BANCS.OUTPARAM.acctOwnerShip
			print(CUSTS.DATA.ownership)
			
			IF (CUSTS.DATA.ownership=="O")  THEN
			#{
				
				IF  ((BANCS.INPUT.drAcct!="0003000103538") AND (BANCS.INPUT.drAcct!="0001100105046") AND (BANCS.INPUT.drAcct!="0003000104380") AND (BANCS.INPUT.drAcct!="0003000104381") AND(BANCS.INPUT.drAcct!="0001100305020") AND (BANCS.INPUT.drAcct!="0541100404593") AND (BANCS.INPUT.drAcct!="0541100404433") AND (BANCS.INPUT.drAcct!="0003000104380") AND (BANCS.INPUT.drAcct!="0003001501766")  AND (BANCS.INPUT.drAcct!="0003001503066") AND (BANCS.INPUT.drAcct!="0003001102700") AND (BANCS.INPUT.drAcct!="0001100301765") AND (BANCS.INPUT.drAcct!="0001100304099") AND (BANCS.INPUT.drAcct!="0541100405249") AND (BANCS.INPUT.drAcct!="0001100405021") AND (BANCS.INPUT.drAcct!="0001900402980") AND (BANCS.INPUT.drAcct!="0001900402982") AND (BANCS.INPUT.drAcct!="0001900402981") AND (BANCS.INPUT.drAcct!="0001900406468"))  THEN
				#{
					
					sv_c = urhk_SRV_SetErr("Cannot debit GL")
					print(sv_c)
					exitscript
					
				#}
				ENDIF
				
			#}
			ENDIF
			
			
		#}
		ENDIF
	#}
	ENDIF

	IF (CUSTS.DATA.ExchRefNo!="") THEN
	
			
		CUST.DATA.Channel = ""

		IF  (BANCS.STDIN.moduleIdentity== "FI") THEN 
			sv_o = urhk_GetChannelInfo("")
			print(sv_o)
			IF (FIELDEXISTS(BANCS.OUTPARAM.DccId)) THEN
				print(BANCS.OUTPARAM.DccId)
				IF (BANCS.OUTPARAM.DccId != "") THEN
					CUST.DATA.Channel = BANCS.OUTPARAM.DccId
				ELSE
					CUST.DATA.Channel = ""
				ENDIF
			ELSE
				CUST.DATA.Channel = ""		
			ENDIF
		ENDIF
		
		IF (CUST.DATA.Channel != "POL") THEN
		
			BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId +"|" + CUSTS.DATA.ExchRefNo
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_s = "count1|"
			sv_s = sv_s + " select count(1)  from tbaadm.dtd where bank_id =?SVAR "
			sv_s = sv_s + " and TREA_REF_NUM=?SVAR and del_flg!='Y' "
			PRINT(sv_s)
			sv_d =  urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0 ) THEN
				CUSTS.DATA.count1 = BANCS.OUTPARAM.count1
				PRINT(CUSTS.DATA.count1)
				IF (cint(CUSTS.DATA.count1)> 0) THEN
					sv_u = urhk_SRV_SetErr("The Deal Reference Number is Used " )	
					EXITSCRIPT
				ENDIF
			ENDIF

		ENDIF

	ENDIF
call("b_pordseqs.scr")
	
	
	exitscript
	TRACE OFF
