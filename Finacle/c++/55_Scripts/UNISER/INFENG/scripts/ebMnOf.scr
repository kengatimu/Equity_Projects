<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
	if((BANCS.STDIN.mySolId!="122") AND (BANCS.STDIN.mySolId!="047")) then
		exitscript
	endif
	print(BANCS.STDIN.mySolId)
	IF (BANCS.STDIN.mySolId=="122") THEN
		EBSRV.GLBDATA.MAcct = "1220299727755"
		EBSRV.GLBDATA.MRecD = "-1"
		EBSRV.GLBDATA.MSolId = BANCS.STDIN.mySolId 
		sv_p = urhk_B2k_PrintRepos("BANCS")
		print(sv_p)
		sv_u = urhk_getFileLocation("COM|ebMnOf.com")
		if(sv_u ==0)then
			print(BANCS.OUTPARAM.fileLocation)
			EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "ebMnOf.com"
			print(EBSRV.GLBDATA.comfil)
		EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " "+ EBSRV.GLBDATA.MSolId + " " + EBSRV.GLBDATA.MAcct + " " + EBSRV.GLBDATA.MRecD 
		else
			EBSRV.GLBDATA.comfil   = ""
		endif
		print(EBSRV.GLBDATA.comfil)
		if(EBSRV.GLBDATA.comfil != "")then
			sv_u = system(EBSRV.GLBDATA.comfil)
			if(sv_u ==0)then
				print("smtp success")
			else
				print("failed smtp")
			endif
		else
			exitscript
		endif
	ENDIF
	IF (BANCS.STDIN.mySolId=="047") THEN
		EBSRV.GLBDATA.MAcct = "0470298041416"
		EBSRV.GLBDATA.MRecD = "-1"
		EBSRV.GLBDATA.MSolId = BANCS.STDIN.mySolId 
		sv_p = urhk_B2k_PrintRepos("BANCS")
		print(sv_p)
		sv_u = urhk_getFileLocation("COM|ebKrc.com")
		if(sv_u ==0)then
			print(BANCS.OUTPARAM.fileLocation)
			EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "ebKrc.com"
			print(EBSRV.GLBDATA.comfil)
		EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " "+ EBSRV.GLBDATA.MSolId + " " + EBSRV.GLBDATA.MAcct + " " + EBSRV.GLBDATA.MRecD 
		else
			EBSRV.GLBDATA.comfil   = ""
		endif
		print(EBSRV.GLBDATA.comfil)
		if(EBSRV.GLBDATA.comfil != "")then
			sv_u = system(EBSRV.GLBDATA.comfil)
			if(sv_u ==0)then
				print("smtp success")
			else
				print("failed smtp")
			endif
		else
			exitscript
		endif
	ENDIF
trace off
end-->
