# Template Name :		DuplicateUniqueIDs.mrt
# Description	:		unverified closed accounts
# Author			E.G.KAROBIA,27-05-2006
# 
#########################################################################
RECORDLAYOUT

PRIMARY_SOL_ID	 stringType
ORGKEY		 stringtype
CUST_FIRST_NAME	 stringtype
CUST_LAST_NAME	 stringType
UNIQUEID	 stringtype

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 72
columnsperline 72
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 72 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
 begin
        execute pipe	
	print PRIMARY_SOL_ID  column 4
	print ORGKEY      column 12
	print CUST_FIRST_NAME  column 27
	print CUST_LAST_NAME   column 42		
	print UNIQUEID  column 59
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL ID" column  3
	print "CIF ID"     COLUMN 12	
	print "FIRST NAME"   column 27
	print "LAST NAME"   column  42		
	print "DUPLICATE ID" column  59
	Separatorline
end 
	
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 70 center 
	nextline
	print branchName  size 70 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 72 center
	nextline
	print " DUPLICATE UNIQUE ID(S) REPORT "  size 72 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 72 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 2
	print "|"   column 10
	print "|"   column 25
	print "|"   column 40
	print "|"  column 57
	print "|"  column 72
end


