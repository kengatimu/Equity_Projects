D_SANCTION_TABLE_RCRE_USER%java.lang.String%15::CATOD_SANCTION_TABLE%RCRE_DATE%CATOD_SANCTION_TABLE_RCRE_DATE%java.sql.Timestamp%7::CATOD_SANCTION_TABLE%LCHG_USER%CATOD_SANCTION_TABLE_LCHG_USER%java.lang.String%15::CATOD_SANCTION_TABLE%LCHG_DATE%CATOD_SANCTION_TABLE_LCHG_DATE%java.sql.Timestamp%7::CATOD_SANCTION_TABLE%E_TYPE%CATOD_SANCTION_TABLE_E_TYPE%java.lang.String%2::CATOD_SANCTION_TABLE%EXT_REQ%CATOD_SANCTION_TABLE_EXT_REQ%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%EXT_APP%CATOD_SANCTION_TABLE_EXT_APP%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%ENC_REQ%CATOD_SANCTION_TABLE_ENC_REQ%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%ENC_APP%CATOD_SANCTION_TABLE_ENC_APP%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%MSG_IND%CATOD_SANCTION_TABLE_MSG_IND%java.lang.String%1::CATOD_SANCTION_TABLE%EMAIL_FLG%CATOD_SANCTION_TABLE_EMAIL_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%SMS_FLG%CATOD_SANCTION_TABLE_SMS_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%IS_DELETED%CATOD_SANCTION_TABLE_IS_DELETED%java.lang.String%1::CATOD_SANCTION_TABLE%ADM_FEES%CATOD_SANCTION_TABLE_ADM_FEES%java.lang.String%1::CATOD_SANCTION_TABLE%CLS_FLG%CATOD_SANCTION_TABLE_CLS_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%BANK_ID%CATOD_SANCTION_TABLE_BANK_ID%java.lang.String%10::CATOD_SANCTION_TABLE%ENTITY_CRE_FLG%CATOD_SANCTION_TABLE_ENTITY_CRE_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%DEL_FLG%CATOD_SANCTION_TABLE_DEL_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%FEE%CATOD_SANCTION_TABLE_FEE%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%FEE_TRAN_ID%CATOD_SANCTION_TABLE_FEE_TRAN_ID%java.lang.String%8::CATOD_MASTER_TABLE%ACCT_NUM%CATOD_MASTER_TABLE_ACCT_NUM%java.lang.String%30::CATOD_MASTER_TABLE%BRANCH_ID%CATOD_MASTER_TABLE_BRANCH_ID%java.math.BigDecimal%22::CATOD_MASTER_TABLE%CONTRACT_AMT%CATOD_MASTER_TABLE_CONTRACT_AMT%java.math.BigDecimal%22::CATOD_MASTER_TABLE%CUST_ID%CATOD_MASTER_TABLE_CUST_ID%java.lang.String%20::CATOD_MASTER_TABLE%DEPARTMENT%CATOD_MASTER_TABLE_DEPARTMENT%java.lang.String%40::CATOD_MASTER_TABLE%EMPLOYER%CATOD_MASTER_TABLE_EMPLOYER%java.lang.String%40::CATOD_MASTER_TABLE%KEY_SEQ%CATOD_MASTER_TABLE_KEY_SEQ%java.lang.String%50::CATOD_MASTER_TABLE%MAX_CNTRT_AMT%CATOD_MASTER_TABLE_MAX_CNTRT_AMT%java.math.BigDecimal%22::CATOD_MASTER_TABLE%MAX_CNTRT_PERIOD%CATOD_MASTER_TABLE_MAX_CNTRT_PERIOD%java.math.BigDecimal%22::CATOD_MASTER_TABLE%REC_TIMESTAMP%CATOD_MASTER_TABLE_REC_TIMESTAMP%java.sql.Timestamp%7::CATOD_MASTER_TABLE%SCORE%CATOD_MASTER_TABLE_SCORE%java.math.BigDecimal%22::CATOD_MASTER_TABLE%BANK_ID%CATOD_MASTER_TABLE_BANK_ID%java.lang.String%8::CATOD_MASTER_TABLE%ENTITY_CRE_FLG%CATOD_MASTER_TABLE_ENTITY_CRE_FLG%java.lang.String%1::CATOD_MASTER_TABLE%DEL_FLG%CATOD_MASTER_TABLE_DEL_FLG%java.lang.String%1::|!NULL!|CATOD_MASTER_TABLE%ACCT_NUM%CATOD_MASTER_TABLE_ACCT_NUM%java.lang.String%30::CATOD_MASTER_TABLE%CUST_ID%CATOD_MASTER_TABLE_CUST_ID%java.lang.String%20::|!NULL!|CATOD_MASTER_TABLE%ACCT_NUM%CATOD_MASTER_TABLE_ACCT_NUM%java.lang.String%30::CATOD_MASTER_TABLE%CUST_ID%CATOD_MASTER_TABLE_CUST_ID%java.lang.String%20::|where%CATOD_MASTER_TABLE.BRANCH_ID%=%$P{P_SOL_ID}%Parameter%Number::and%CATOD_MASTER_TABLE.REC_TIMESTAMP%between%$P{P_FROMDATE}%Parameter%Date::and%CATOD_MASTER_TABLE.REC_TIMESTAMP%=%$P{P_TODATE}%Parameter%Date::|P_SOL_ID%java.lang.String%100%!NULL!%SOL ID@DBQUERY%PRODUCT!@!SolID_List#@#N%java.lang.String!@!DEFAULT!@!0!@!100%CONSTANT%N%N::P_FROMDATE%java.sql.Timestamp%10%!NULL!%CREATION FROM DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::P_TODATE%java.sql.Timestamp%10%!NULL!%CREATION TO DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::|!NULL!|!NULL!|!NULL!|select     CATOD_MASTER_TABLE.ACCT_NUM as *CATOD_MASTER_TABLE_ACCT_NUM* ,     CATOD_MASTER_TABLE.CUST_ID as *CATOD_MASTER_TABLE_CUST_ID* from     CUSTOM.CATOD_SANCTION_TABLE CATOD_SANCTION_TABLE ,     CUSTOM.CATOD_MASTER_TABLE CATOD_MASTER_TABLE  where    CATOD_MASTER_TABLE.BRANCH_ID = $P{P_SOL_ID}     and CATOD_MASTER_TABLE.REC_TIMESTAMP between TO_DATE( CAST ( $P{P_FROMDATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )     and CATOD_MASTER_TABLE.REC_TIMESTAMP = TO_DATE( CAST ( $P{P_TODATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )|SELECT DISTINCT D.SOL_ID GAM_SOL_ID ,LPAD(A.BRANCH_ID,3,0)SCORE_SOL_ID ,A.CUST_ID ,A.ACCT_NUM ,C.CUST_NAME ,A.EMPLOYER ,A.MAX_CNTRT_AMT ,A.CONTRACT_AMT ,B.SANCT_AMT ,E.PHONENO PHONE1 ,TO_CHAR(A.REC_TIMESTAMP,'DD/MM/YYYY')UPLOAD_DATE     FROM   CUSTOM.CATOD_MASTER_TABLE A,   CUSTOM.CATOD_SANCTION_TABLE B,  TBAADM.CMG C,   TBAADM.GAM D,  TBAADM.CPHONE E    WHERE  C.CIF_ID = A.CUST_ID AND C.CIF_ID = E.PHONE_B2KID AND D.FORACID = A.ACCT_NUM AND A.ACCT_NUM = B.ACCT_NUM(+)  AND (A.CUST_ID ='' OR NVL('','ALL')='ALL')  AND (A.ACCT_NUM = '' OR NVL('','ALL')='ALL') AND (LPAD(A.BRANCH_ID,3,0) = $P{P_SOL_ID} OR NVL($P{P_SOL_ID},'ALL')='ALL')  AND A.REC_TIMESTAMP  BETWEEN TO_DATE(NVL($P{P_FROMDATE},'01-01-1900'),'DD-MM-YYYY') AND TO_DATE(NVL($P{P_TODATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY') AND E.PREFERREDFLAG = 'Y'|true"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT DISTINCT D.SOL_ID GAM_SOL_ID
,LPAD(A.BRANCH_ID,3,0)SCORE_SOL_ID
,A.CUST_ID
,A.ACCT_NUM
,C.CUST_NAME
,A.EMPLOYER
,A.MAX_CNTRT_AMT
,A.CONTRACT_AMT
,B.SANCT_AMT
,E.PHONENO PHONE1
,TO_CHAR(A.REC_TIMESTAMP,'DD/MM/YYYY')UPLOAD_DATE
  
 FROM 
 CUSTOM.CATOD_MASTER_TABLE A, 
 CUSTOM.CATOD_SANCTION_TABLE B,
 TBAADM.CMG C, 
 TBAADM.GAM D,
 TBAADM.CPHONE E
 
 WHERE
 C.CIF_ID = A.CUST_ID
AND C.CIF_ID = E.PHONE_B2KID
AND D.FORACID = A.ACCT_NUM
AND A.ACCT_NUM = B.ACCT_NUM(+) 
AND (A.CUST_ID ='' OR NVL('','ALL')='ALL') 
AND (A.ACCT_NUM = '' OR NVL('','ALL')='ALL')
AND (LPAD(A.BRANCH_ID,3,0) = $P{P_SOL_ID} OR NVL($P{P_SOL_ID},'ALL')='ALL') 
AND A.REC_TIMESTAMP 
BETWEEN TO_DATE(NVL($P{P_FROMDATE},'01-01-1900'),'DD-MM-YYYY') AND TO_DATE(NVL($P{P_TODATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY')
AND E.PREFERREDFLAG = 'Y']]></queryString>

