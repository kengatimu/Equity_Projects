###########################################################################################
<--START
CHECKSUM="88121e7ede0d9b748ba49b21fce3ac175735e710e271ac86f9688d940332fb53"
	TRACE ON
	
	###########################################################################################
	print(CUST.HLASPAYREV.srlNum)
	print(CUST.HLASPAYREV.revTranId)
	print(CUST.HLASPAYREV.revTranDate)
	###########################################################################################
	
	sv_s = "UPDATE CUSTOM.LSPRV SET "
	sv_s = sv_s + " STATUS_FLG = 'S',"
	sv_s = sv_s + " REV_TRAN_ID = ?SVAR" + ","
	sv_s = sv_s + " REV_TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_s = sv_s + " FAILURE_MSG = '',"
	sv_s = sv_s + " LCHG_USER_ID = ?SVAR" + ","
	sv_s = sv_s + " LCHG_TIME = sysdate"
	sv_s = sv_s + " WHERE SRL_NUM = ?SVAR"
	
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.HLASPAYREV.revTranId		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + MID$(CUST.HLASPAYREV.revTranDate,0,10)+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId                    + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.HLASPAYREV.srlNum
	
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.HLASPAYREV.errMsg = "Database Update Operation Failed ON Custom Table"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	ENDOFSCRIPT:
		
END-->
