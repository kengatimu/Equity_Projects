TRACE ON
	#========================================================	
	# Validating the User Access Codes from UAC table for a
	# particular user
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|"+CUST.INTERFACE.accessCode+"|"+CUST.INTERFACE.hmeEntityId+"|Y"
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "valAccssCode|"
	sv_s = sv_s + " SELECT COUNT(5)"
	sv_s = sv_s + " FROM TBAADM.UAC"
	sv_s = sv_s + " WHERE USER_ID=?SVAR"
	sv_s = sv_s + " AND ACCT_ACCESS_CODE =?SVAR"
	sv_s = sv_s + " AND BANK_ID =?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0 ) THEN
