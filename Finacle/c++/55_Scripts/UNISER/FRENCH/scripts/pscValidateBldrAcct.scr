	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.PSC.parameterId = "OIFA_BLDR_ACCT%"
	CUST.PSC.recordCount = "0"
	
	sv_s = "recordCount|SELECT COUNT(*) FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'OIFA'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID LIKE ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND NVL(V.PARAMETER_VALUE,'X') = ?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.PSC.parameterId + "|" + CUST.PSC.bldrAcctNum
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.PSC.recordCount = BANCS.OUTPARAM.recordCount
