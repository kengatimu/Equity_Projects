	#---------------------------------------------------------------------
	# Obtaining the value of credit a/c
	#---------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("assetPaymentTranLA.DisbPartTranLL.<rec_0>.crAcct.foracid")
	PRINT(sv_u)
	IF(sv_u == 0)THEN
	#{
		CUST.PSC.crAcct = BANCS.OUTPARAM.srvValue
		PRINT(CUST.PSC.crAcct)
