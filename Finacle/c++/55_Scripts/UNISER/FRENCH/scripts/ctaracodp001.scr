<--START
	TRACE ON
	
	###########################################################################################
	# Check whether EQT Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("EQT")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("EQT")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CTAR Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("EQT","CTAR")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("EQT","CTAR",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	EQT.CTAR.acctNum = " "
	EQT.CTAR.errorFlg = "N"
	EQT.CTAR.errorMsg = " "
	EQT.CTAR.acctEntityId = " "
	EQT.CTAR.acctSolId = " "
	EQT.CTAR.acctCrncy = " "
	EQT.CTAR.acctName = " "
	EQT.CTAR.entityCreFlg = " "
	EQT.CTAR.acctClsFlg = " "
	EQT.CTAR.opacctNum = " "
	EQT.CTAR.opacctEntityId = " "
	EQT.CTAR.opacctSolId = " "
	EQT.CTAR.opacctCrncy = " "
	EQT.CTAR.opacctName = " "
	EQT.CTAR.placctNum = " "
	EQT.CTAR.placctEntityId = " "
	EQT.CTAR.placctSolId = " "
	EQT.CTAR.placctCrncy = " "
	EQT.CTAR.placctName = " "
	EQT.CTAR.plbacid = " "
	EQT.CTAR.intrstAmt = "0"
	
	#sv_u = urhk_b2k_printrepos("BANCS")
	#print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
		#{
			EQT.CTAR.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
			PRINT(EQT.CTAR.acctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		EQT.CTAR.errorFlg = "Y"
		EQT.CTAR.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctEntityId,acctSolId,acctCrncy,acctName,entityCreFlg,acctClsFlg,schmType,schmCode,acctacid|"
	sv_s = sv_s + " SELECT BANK_ID,SOL_ID,ACCT_CRNCY_CODE,ACCT_NAME,ENTITY_CRE_FLG,ACCT_CLS_FLG,SCHM_TYPE,SCHM_CODE,ACID"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR AND BANK_ID= ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = EQT.CTAR.acctNum + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		EQT.CTAR.acctEntityId = BANCS.OUTPARAM.acctEntityId
		PRINT(EQT.CTAR.acctEntityId)
		EQT.CTAR.acctSolId = BANCS.OUTPARAM.acctSolId
		PRINT(EQT.CTAR.acctSolId)
		EQT.CTAR.acctCrncy = BANCS.OUTPARAM.acctCrncy
		PRINT(EQT.CTAR.acctCrncy)
		EQT.CTAR.acctName = BANCS.OUTPARAM.acctName
		PRINT(EQT.CTAR.acctName)
		EQT.CTAR.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		PRINT(EQT.CTAR.entityCreFlg)
		EQT.CTAR.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
		PRINT(EQT.CTAR.acctClsFlg)
		EQT.CTAR.schmType = BANCS.OUTPARAM.schmType
		PRINT(EQT.CTAR.schmType)
		EQT.CTAR.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(EQT.CTAR.schmCode)
		EQT.CTAR.acctacid = BANCS.OUTPARAM.acctacid
		PRINT(EQT.CTAR.acctacid)
		
		IF(EQT.CTAR.entityCreFlg == "N")THEN
		#{
			EQT.CTAR.errorFlg = "Y"
			EQT.CTAR.errorMsg = "Account Creation is Not yet Authorised"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(EQT.CTAR.acctClsFlg == "Y")THEN
		#{
			EQT.CTAR.errorFlg = "Y"
			EQT.CTAR.errorMsg = "Account is closed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(EQT.CTAR.schmType !="ODA") THEN
		#{
			EQT.CTAR.errorFlg = "Y"
			EQT.CTAR.errorMsg = "Only ODA type of Account should be entered."
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		sv_s = "opacctNum,opacctEntityId,opacctSolId,opacctCrncy,opacctName,entityCreFlg,acctClsFlg|"
		sv_s = sv_s + " SELECT FORACID,BANK_ID,SOL_ID,ACCT_CRNCY_CODE,ACCT_NAME,ENTITY_CRE_FLG,ACCT_CLS_FLG"
		sv_s = sv_s + " FROM TBAADM.GAM WHERE ACID IN (SELECT INT_DR_ACID FROM TBAADM.GAC "
		sv_s = sv_s + " WHERE ACID = ?SVAR AND BANK_ID= ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y')"
		sv_s = sv_s + " AND BANK_ID=?SVAR AND DEL_FLG='N'"
		PRINT(sv_s)
	
		BANCS.INPARAM.BINDVARS = EQT.CTAR.acctacid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
	
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
	
		IF(sv_d == 0)THEN
		#{
			EQT.CTAR.opacctNum = BANCS.OUTPARAM.opacctNum
			PRINT(EQT.CTAR.opacctNum)
			EQT.CTAR.opacctEntityId = BANCS.OUTPARAM.opacctEntityId
			PRINT(EQT.CTAR.opacctEntityId)
			EQT.CTAR.opacctSolId = BANCS.OUTPARAM.opacctSolId
			PRINT(EQT.CTAR.opacctSolId)
			EQT.CTAR.opacctCrncy = BANCS.OUTPARAM.opacctCrncy
			PRINT(EQT.CTAR.opacctCrncy)
			EQT.CTAR.opacctName = BANCS.OUTPARAM.opacctName
			PRINT(EQT.CTAR.opacctName)
			EQT.CTAR.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
			PRINT(EQT.CTAR.entityCreFlg)
			EQT.CTAR.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
			PRINT(EQT.CTAR.acctClsFlg)
	
			IF(EQT.CTAR.entityCreFlg == "N")THEN
			#{
				EQT.CTAR.errorMsg = "Operative Account: "+EQT.CTAR.opacctNum+"mapped to enter ODA account is Not yet Authorised"
			#}
			ENDIF

			IF(EQT.CTAR.acctClsFlg == "Y")THEN
			#{
				EQT.CTAR.errorMsg = "Operative Account: "+EQT.CTAR.opacctNum+"mapped to enter ODA account is closed"
			#}
			ENDIF
		#}
		ENDIF	

		sv_s = "PLbacid|SELECT INT_PANDL_BACID_DR FROM TBAADM.GSP WHERE BANK_ID=?SVAR AND SCHM_CODE=?SVAR"
		BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId +"|"+ EQT.CTAR.schmCode
		PRINT(sv_s)
		print(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
	
		IF(sv_d == 0)THEN
		#{
                        EQT.CTAR.plbacid = BANCS.OUTPARAM.PLbacid
                        PRINT(EQT.CTAR.plbacid)
		#}
		ENDIF		
		IF(TRIM(EQT.CTAR.plbacid) != "")THEN
		#{
        		sv_a = EQT.CTAR.plbacid +"|"+EQT.CTAR.acctCrncy+"|"+EQT.CTAR.acctSolId
        		sv_k =  urhk_B2k_BacidToAcctId(sv_a)
		        IF(sv_k == 0)THEN
        		#{
                		EQT.CTAR.placctNum = BANCS.OUTPARAM.AcctId
				PRINT(EQT.CTAR.placctNum)
			#}
        		ELSE
                	#{
				EQT.CTAR.placctNum = " "
        		#}
			ENDIF
                #}
        	ELSE
                #{
			EQT.CTAR.placctNum = " "
        	#}
        	ENDIF
		
		IF(TRIM(EQT.CTAR.placctNum) == "")THEN
		#{
			EQT.CTAR.errorFlg = "Y"
			EQT.CTAR.errorMsg = "No P&L account mapped to the scheme code: "+EQT.CTAR.schmCode
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		sv_s = "acctCrncy,solId,acctname|SELECT ACCT_CRNCY_CODE,SOL_ID,ACCT_NAME FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR"
		BANCS.INPARAM.BINDVARS=EQT.CTAR.placctNum +"|"+ BANCS.STDIN.contextBankId
                PRINT(sv_s)
                print(BANCS.INPARAM.BINDVARS)

                sv_d = urhk_dbSelectWithBind(sv_s)
                PRINT(sv_d)

                IF(sv_d == 0)THEN
                #{
                        EQT.CTAR.placctCrncy = BANCS.OUTPARAM.acctCrncy
                        PRINT(EQT.CTAR.placctCrncy)
			EQT.CTAR.placctSolId = BANCS.OUTPARAM.solId
			PRINT(EQT.CTAR.placctSolId)
			EQT.CTAR.placctName = BANCS.OUTPARAM.acctname
			PRINT(EQT.CTAR.placctName)
			EQT.CTAR.placctEntityId = BANCS.STDIN.contextBankId
                #}
                ENDIF

		sv_s = "intrstAmt|SELECT PENDING_INTEREST FROM CUSTOM.TA_COT WHERE BANK_ID=?SVAR AND ACID=?SVAR"
		BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId +"|"+ EQT.CTAR.acctacid
		PRINT(sv_s)
		print(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
	
		IF(sv_d == 0)THEN
		#{
                        EQT.CTAR.intrstAmt = BANCS.OUTPARAM.intrstAmt
                        PRINT(EQT.CTAR.intrstAmt)
		#}
		ENDIF		
	
		IF((EQT.CTAR.intrstAmt == "0") OR (TRIM(EQT.CTAR.intrstAmt) == ""))THEN
		#{
			EQT.CTAR.errorFlg = "Y"
			EQT.CTAR.errorMsg = "No interest Amount pending for recovery"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	
	
	#}
	ELSE
	#{
		EQT.CTAR.errorFlg = "Y"
		EQT.CTAR.errorMsg = "Invalid Account ID"
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+EQT.CTAR.errorFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+EQT.CTAR.errorMsg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("acctEntityId|"+EQT.CTAR.acctEntityId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("acctSolId|"+EQT.CTAR.acctSolId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("acctCrncy|"+EQT.CTAR.acctCrncy)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("acctName|"+EQT.CTAR.acctName)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("acctNum|"+EQT.CTAR.acctNum)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("opacctEntityId|"+EQT.CTAR.opacctEntityId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("opacctSolId|"+EQT.CTAR.opacctSolId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("opacctCrncy|"+EQT.CTAR.opacctCrncy)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("opacctName|"+EQT.CTAR.opacctName)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("opacctNum|"+EQT.CTAR.opacctNum)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("placctEntityId|"+EQT.CTAR.placctEntityId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("placctSolId|"+EQT.CTAR.placctSolId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("placctCrncy|"+EQT.CTAR.placctCrncy)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("placctName|"+EQT.CTAR.placctName)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("placctNum|"+EQT.CTAR.placctNum)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("intrstAmt|"+EQT.CTAR.intrstAmt)
		PRINT(sv_u)
		
END-->
