<--START
CHECKSUM="b8e82460bb2502d66f32db00a435c8e5638cee03f60028362577343a62895e88"
	TRACE ON
	
	#==============================================================================================================
	#- If there is any error then there will be resphdr.ubustranstatus^=^FAILED5/27/2011
	#- GETPOSITION (Var1, Var2) Usage is given below -
	#- Returns the first position of Var2 in Var1.
	#- Var1 is String and Var2 is String/Char. Case Sensitive.
	#==============================================================================================================
	sv_l = GETPOSITION(CUST.INTERFACE.respXMLMsg, "resphdr.ubustranstatus^=^FAILED")
	print(sv_l)
	IF(sv_l != 0) THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = "Error occured in making connection with third party"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#==============================================================================================================
	#- Fetching various tags from the Response XML
	#- The status variable is populated by the service provider with SUCCESS/FAILURE
	#- Depending on whether it success of failure, the values are extracted
	#==============================================================================================================
	sv_x = CUST.INTERFACE.respXMLMsg
	sv_y = "<Status>"
	sv_z = "</Status>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.statusOfConn = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
	ELSE
		#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = "Third party Processing failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#==============================================================================================================
	#- We check the statusOfConn value and then fetch result from third party from Response XML.
	#==============================================================================================================
	IF((CUST.INTERFACE.statusOfConn == "SUCCESS") AND (CUST.HOCCM.outboundId == "REPRESENTMENT")) THEN
	#{
		sv_y = "<REPRESULT>"
		sv_z = "</REPRESULT>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.representDtl = MID$(sv_x, sv_b, (sv_e - sv_b))
			print(CUST.INTERFACE.representDtl)
			#}
		ELSE
			#{
			CUST.INTERFACE.errorMsgFlg = "Y"
			CUST.INTERFACE.errorMsgDesc = "Third party Processing failed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		##}
		#ELSE
		##{
		#	CUST.INTERFACE.errorMsgFlg = "Y"
		#	CUST.INTERFACE.errorMsgDesc = "Third party Processing failed"
	#}
	ENDIF
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
