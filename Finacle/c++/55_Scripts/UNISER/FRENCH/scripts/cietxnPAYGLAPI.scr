                                IF(sv_d ==0) THEN
                                #{
                                        CUST.PAYGLAPI.rateCode = BANCS.OUTPARAM.rateCode
                                        PRINT(CUST.PAYGLAPI.rateCode)
                                #}
                                ENDIF

	###############################################
	#To Fetch the rate for the rate code
	##############################################
	sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.PAYGLAPI.tranCrncy)
	sv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.PAYGLAPI.refCrncy)
	sv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.PAYGLAPI.rateCode)
	
	sv_u = urhk_SetUrhkOut("rate|rate")
	sv_u = urhk_SetUrhkOut("treaRate|treaRate")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_TieredConvCrncy")
	PRINT(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.PAYGLAPI.rate = BANCS.OUTPARAM.rate
		PRINT(CUST.PAYGLAPI.rate)
		
		CUST.PAYGLAPI.treaRate = BANCS.OUTPARAM.treaRate
		PRINT(CUST.PAYGLAPI.treaRate)
	#}
	ENDIF
	
	
	#################################################################################
	# Transaction for debiting the Pay GL account and crediting the Agent Account
	#################################################################################
	
	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.CommitFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
	BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw = "Y"
	BANCS.INPARAM.CheckExceptions = "Y"
	sv_r = urhk_MTTS_Initialize("")
	PRINT(sv_r)
	IF(sv_r != "0")THEN
	#{
		CUST.PAYGLAPI.errorMsg = CUST.PAYGLAPI.errorMsg + "  " + "Not able to initiate the MTT"
		sv_a = urhk_SetOrbOut("STATUS|FAILED")
		sv_a = urhk_SetOrbOut("Message|"+CUST.PAYGLAPI.errorMsg)
		
	#}
	ENDIF
	############################################
	#Define Transaction  2
	#############################################
	MTT.TranDetails.TranID 					= ""
	MTT.TranDetails.TranDate                = "0"
	MTT.TranDetails.TranType                = "T"
	MTT.TranDetails.PostFlag                = "Y"
	MTT.TranDetails.TranSubType             = "BI"
	MTT.TranDetails.ReversalFlag            = "N"
	MTT.TranDetails.IgnoreExcp              = "I"
	MTT.TranDetails.Consolidate             = "Y"
	MTT.TranDetails.Remarks                 = " PAY TO GL Payment to Agent"
	sv_t = urhk_MTTS_DefineTransaction("PAYGL")
	IF(sv_t !="0")THEN
	#{
		#CUST.PAYGLAPI.errorMsg = "Unable to define the transaction.."
		#PRINT(CUST.PAYGLAPI.errorMsg)
                sv_r = urhk_MTTS_ReportErrorCondition("")
                PRINT (MTT.Error.Description)
		CUST.PAYGLAPI.errorMsg = MTT.Error.Description
		sv_a = urhk_SetOrbOut("STATUS|FAILED")
		sv_a = urhk_SetOrbOut("Message|"+CUST.PAYGLAPI.errorMsg)

		GOTO ENDOFSCRIPT
	#}
	ENDIF
	################################################
	#Debiting Recievable account
	################################################
	MTT.PartTranDetails.Account     = CUST.PAYGLAPI.nostroAcct
	MTT.PartTranDetails.RefCurrency = CUST.PAYGLAPI.tranCrncy
	MTT.PartTranDetails.Particulars = CUST.PAYGLAPI.tranParticular
	MTT.PartTranDetails.Remarks = CUST.PAYGLAPI.tranRmks
	MTT.PartTranDetails.RefAmount = - CDOUBLE(CUST.PAYGLAPI.tranAmt)
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Consolidate = "Y"
	MTT.PartTranDetails.TranIdentifier = "PAYGL"
	MTT.PartTranDetails.CarveAmtFlg="Y"
	sv_r = urhk_MTTS_DefinePartTran("PAYGL1")
	PRINT(sv_r)
	IF(sv_r !="0")THEN
	#{
		#CUST.PAYGLAPI.errorMsg = "Unable to define the Debit part transaction.."
		#PRINT(CUST.PAYGLAPI.errorMsg)
		sv_r = urhk_MTTS_ReportErrorCondition("")
                PRINT (MTT.Error.Description)
		CUST.PAYGLAPI.errorMsg = MTT.Error.Description
		sv_a = urhk_SetOrbOut("STATUS|FAILED")
		sv_a = urhk_SetOrbOut("Message|"+CUST.PAYGLAPI.errorMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	###############################################
	#Crediting the Agent Account
	###############################################
	
	MTT.PartTranDetails.Account     = CUST.PAYGLAPI.Agentaccnt
	#MTT.PartTranDetails.RefCurrency = CUST.PAYGLAPI.refCrncy
	MTT.PartTranDetails.RefCurrency = CUST.PAYGLAPI.tranCrncy
	MTT.PartTranDetails.Particulars = CUST.PAYGLAPI.tranParticular
	MTT.PartTranDetails.Remarks = CUST.PAYGLAPI.tranRmks
	#MTT.PartTranDetails.RefAmount = CUST.PAYGLAPI.refAmt
	MTT.PartTranDetails.RefAmount = CUST.PAYGLAPI.tranAmt
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.RateCode = CUST.PAYGLAPI.rateCode
	MTT.PartTranDetails.Rate = CUST.PAYGLAPI.rate
	MTT.PartTranDetails.TreaRate = CUST.PAYGLAPI.treaRate
	MTT.PartTranDetails.TreaRefNum = ""
	MTT.PartTranDetails.Consolidate = "Y"
	MTT.PartTranDetails.TranIdentifier = "PAYGL"
	
	sv_r = urhk_MTTS_DefinePartTran("PAYGL2")
	IF(sv_r !="0")THEN
	#{
		#CUST.PAYGLAPI.errorMsg = "Unable to define the Credit part transaction.."
		#PRINT(CUST.PAYGLAPI.errorMsg)
		sv_r = urhk_MTTS_ReportErrorCondition("")
                PRINT (MTT.Error.Description)
		CUST.PAYGLAPI.errorMsg = MTT.Error.Description
		sv_a = urhk_SetOrbOut("STATUS|FAILED")
		sv_a = urhk_SetOrbOut("Message|"+CUST.PAYGLAPI.errorMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_r = urhk_MTTS_EndDefinition("")
	PRINT(sv_r)
	IF(sv_r !="0")THEN
	#{
		#CUST.PAYGLAPI.errorMsg = "Unable to End the transaction Definition.."
		#PRINT(CUST.PAYGLAPI.errorMsg)
		sv_r = urhk_MTTS_ReportErrorCondition("")
                PRINT (MTT.Error.Description)
		CUST.PAYGLAPI.errorMsg = MTT.Error.Description
		sv_a = urhk_SetOrbOut("STATUS|FAILED")
		sv_a = urhk_SetOrbOut("Message|"+CUST.PAYGLAPI.errorMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(BANCS.OUTPARAM.MTTTranId)
	CUST.PAYGLAPI.tranid = BANCS.OUTPARAM.MTTTranId
	IF(CUST.PAYGLAPI.tranid =="")THEN
	#{
		CUST.PAYGLAPI.errorMsg = "Transaction generation has failed."
		PRINT(CUST.PAYGLAPI.errorMsg)
		sv_a = urhk_SetOrbOut("STATUS|FAILED")
		sv_a = urhk_SetOrbOut("Message|"+CUST.PAYGLAPI.errorMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_z = urhk_MTTS_Close("")
	PRINT(sv_z)
	
	CALL("cietxnPAYGLAPI001.scr")
	IF(CUST.PAYGLAPI.scriptSuccess == "N")THEN
	#{
		sv_a = urhk_SetOrbOut("STATUS|FAILED")
		sv_a = urhk_SetOrbOut("Message|"+CUST.PAYGLAPI.errorMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_a = urhk_SetOrbOut("STATUS|SUCCESS")
	sv_a = urhk_SetOrbOut("TRANID|"+CUST.PAYGLAPI.tranid)
	sv_a = urhk_SetOrbOut("Message|Transaction was successful")
	
	ENDOFSCRIPT:
		TRACE OFF
END-->

