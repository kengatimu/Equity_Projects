#  Menu Option     : NA CSWOP(daily job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             01-04-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
	sv_p = urhk_B2k_PrintRepos("BANCS")
	print(sv_p)
	EBSRV.GLBDATA.crAcct = ""
#fetch
	sv_l = "drAcct,isSweepsYN,PoolId,poolCif,drSchmCode,drTranAmt,drCrncy,crAcct | "
	sv_l = sv_l + " select gam.foracid,gam.allow_sweeps,gam.pool_id,gam.cif_id,"
	sv_l = sv_l + " gam.schm_code,gam.clr_bal_Amt,gam.acct_crncy_code, "
	sv_l = sv_l + " (select od.foracid from tbaadm.gam od where od.bank_id=gam.bank_id "
	sv_l = sv_l + " and od.schm_type='ODA' and od.schm_code='OD541' and od.cif_id=gam.cif_id "
	sv_l = sv_l + " and od.acct_cls_flg='N' and od.del_flg='N' and od.entity_cre_flg='Y' ) DrAcct "
        sv_l = sv_l + " from tbaadm.gam gam where gam.bank_id=?SVAR "
        sv_l = sv_l + " and gam.entity_cre_flg='Y' and gam.del_flg='N' "
        sv_l = sv_l + " and gam.acct_cls_flg<>'Y' "
        sv_l = sv_l + " and gam.schm_code in ('SB126','CA207') "
        ##sv_l = sv_l + " and gam.cif_id='54305077183' "
	sv_l = sv_l + " and gam.sol_id in (select sol_id from tbaadm.sst where bank_id=?SVAR and set_id =?SVAR ) "
        sv_l = sv_l + " and gam.clr_bal_amt <0 "
        sv_l = sv_l + " order by gam.foracid "
	print(sv_l)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId 
	###BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	sv_c = urhk_dbCursorOpenWithBind(sv_l)
	print(sv_c)
	if(sv_c != 0)then
		print("fetching failed")
		goto VAYU
	endif
	sv_p = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_p)
	sv_r = urhk_dbCursorFetch(sv_p)
	print(sv_r)
	if(sv_r != 0)then
	    goto VAYU
	endif
	EBSRV.GLBDATA.record_count = 0
	while(sv_r == 0)
		EBSRV.GLBDATA.drAcct	=	BANCS.OUTPARAM.drAcct
		EBSRV.GLBDATA.isSweepsYN	=	BANCS.OUTPARAM.isSweepsYN		
		EBSRV.GLBDATA.PoolId	=	BANCS.OUTPARAM.PoolId	
		EBSRV.GLBDATA.poolCif	=	BANCS.OUTPARAM.poolCif	
		EBSRV.GLBDATA.drSchmCode	=	BANCS.OUTPARAM.drSchmCode	
		EBSRV.GLBDATA.drTranAmt	=	BANCS.OUTPARAM.drTranAmt	
		EBSRV.GLBDATA.drCrncy	=	BANCS.OUTPARAM.drCrncy	
		EBSRV.GLBDATA.crAcct	=	BANCS.OUTPARAM.crAcct	
		if((EBSRV.GLBDATA.PoolId!="") and (EBSRV.GLBDATA.isSweepsYN=="Y"))then
			if(cdouble(EBSRV.GLBDATA.drTranAmt)<0)then
				callscriptifexist("ebOdaAgntSweepRegT.scr")
			else
				goto NXTL
			endif
		else
			goto NXTL
		endif
	NXTL:
        sv_r = urhk_dbCursorFetch(sv_p)
        do
        sv_r = urhk_dbCursorClose(sv_p)	
VAYU:
	exitscript
trace off
end-->
