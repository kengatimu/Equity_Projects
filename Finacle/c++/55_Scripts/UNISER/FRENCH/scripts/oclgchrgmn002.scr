				CUST.OCI.evtAmt = (CDOUBLE(CUST.OCI.evtAmt) * CDOUBLE(CUST.OCI.amt3))
				print(CUST.OCI.evtAmt)
				
				CUST.OCI.totAmt = CDOUBLE(CUST.OCI.totAmt) + CDOUBLE(CUST.OCI.evtAmt)
				print(CUST.OCI.totAmt)
				
