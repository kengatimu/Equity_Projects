			#}
		ELSE
			#{
			CUST.OCI.bankCode 		= BANCS.OUTPARAM.bankCode
			CUST.OCI.brCode 		= BANCS.OUTPARAM.brCode
			CUST.OCI.sortCode 		= BANCS.OUTPARAM.sortCode
			CUST.OCI.instAmt 		= BANCS.OUTPARAM.instAmt
			CUST.OCI.tranCode 		= BANCS.OUTPARAM.tranCode
			CUST.OCI.instId 		= TRIM(BANCS.OUTPARAM.instId)
			CUST.OCI.payingAcctId 	= BANCS.OUTPARAM.payingAcctId
			
			sv_s = "type|SELECT free_code_1 "
			sv_s = sv_s + " FROM TBAADM.BCT  "
			sv_s = sv_s + " WHERE br_Code=?SVAR "
			sv_s = sv_s + " AND bank_Code=?SVAR "
			sv_s = sv_s + " AND del_flg='N' "
			sv_s = sv_s + " AND bank_id=?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.OCI.brCode+"|"+CUST.OCI.bankCode+"|"+BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF (sv_d == 0) THEN
			#{
				CUST.OCI.type = trim(BANCS.OUTPARAM.type)
				print(CUST.OCI.type)
			#}
			ENDIF
			
			CUST.OCI.evtAmt = CDOUBLE("0")
			
			#======================================================================
			#Type L
			#======================================================================
			
			IF (CUST.OCI.type == CUST.OCI.setType1) THEN
			#{
				CUST.OCI.evtAmt = CDOUBLE("0")
				print(CUST.OCI.evtAmt)
				CUST.OCI.totAmt = CDOUBLE(CUST.OCI.totAmt) + CDOUBLE(CUST.OCI.evtAmt)
				print(CUST.OCI.totAmt)
			#}
			ENDIF
			
			#======================================================================
			#Type U
			#======================================================================
			
			IF (CUST.OCI.type == CUST.OCI.setType2) THEN
			#{
				CUST.OCI.evtAmt = (CDOUBLE(CUST.OCI.instAmt) * CDOUBLE(CUST.OCI.amt))
				print(CUST.OCI.evtAmt)
				
				
				IF (CDOUBLE(CUST.OCI.evtAmt) < CDOUBLE(CUST.OCI.amt1)) THEN
				#{
					CUST.OCI.evtAmt=CUST.OCI.amt1
				#}
				ENDIF
				
				
				IF (CDOUBLE(CUST.OCI.evtAmt) > CDOUBLE(CUST.OCI.amt2)) THEN
				#{
					CUST.OCI.evtAmt=CUST.OCI.amt2
				#}
				ENDIF
				
				CUST.OCI.evtAmt = (CDOUBLE(CUST.OCI.evtAmt) * CDOUBLE(CUST.OCI.amt3))
				print(CUST.OCI.evtAmt)
				
				CUST.OCI.totAmt = CDOUBLE(CUST.OCI.totAmt) + CDOUBLE(CUST.OCI.evtAmt)
				print(CUST.OCI.totAmt)
				
				
				IF (BANCS.STDIN.serviceName==CUST.OCI.srv) THEN
				#{
					sv_q = "INSERT INTO CUSTOM.C_EFT VALUES ("
					sv_q = sv_q + "?SVAR"
					sv_q = sv_q + ",TO_DATE(?SVAR,'DD-MM-YYYY')"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",sysdate"
					sv_q = sv_q + ",?SVAR"
					sv_q = sv_q + ",sysdate"
					sv_q = sv_q + ",?SVAR)"
					print(sv_q)
					
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.ClgZoneSolId +"|"+ MID$(BANCS.INPUT.ClgZoneDate,0,10) +"|"+ BANCS.INPUT.ClgZoneCode +"|"+ BANCS.INPUT.SetNum +"|"+ CUST.OCI.bankCode +"|"+ CUST.OCI.brCode +"|"+ CUST.OCI.instId +"|"+ CUST.OCI.instAmt +"|"+ CUST.OCI.tranCode +"|"+ CUST.OCI.payingAcctId +"|"+ CUST.OCI.evtAmt +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
					sv_q = urhk_dbSqlWithBind(sv_q)
					IF (sv_q == 0) THEN
					#{
						#Modifyed 20-06
						#						sv_q = urhk_dbSqlWithBind("commit")
						print("commit")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			#======================================================================
			#Type R
			#======================================================================
			
			IF (CUST.OCI.type == CUST.OCI.setType3) THEN
			#{
				CUST.OCI.evtAmt = (CDOUBLE(CUST.OCI.instAmt) * CDOUBLE(CUST.OCI.amt4))
				print(CUST.OCI.evtAmt)
				
				IF (CDOUBLE(CUST.OCI.evtAmt) < CDOUBLE(CUST.OCI.amt1)) THEN
				#{
					CUST.OCI.evtAmt=CUST.OCI.amt1
