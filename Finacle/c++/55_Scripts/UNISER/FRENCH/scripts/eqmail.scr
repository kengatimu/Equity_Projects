#+++++++++++++++++++++++++++++++++
<--start
trace on
#Reps&Class
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("EQMAIL")==0)then
                createrep("EQMAIL")
        endif
        if(classexists("EQMAIL","GLBDATA")==0)then
                createclass("EQMAIL","GLBDATA",5)
        endif
	if(fieldexists(CUST.ALERTS.name)==1)then
		EQMAIL.GLBDATA.cusName = CUST.ALERTS.name		
	else
		EQMAIL.GLBDATA.cusName = ""
	endif
	if(fieldexists(CUST.ALERTS.transactiontype)==1)then
		EQMAIL.GLBDATA.transactiontype = CUST.ALERTS.transactiontype		
	else
		EQMAIL.GLBDATA.transactiontype = ""
	endif
	if(fieldexists(CUST.ALERTS.transactionAmount)==1)then
		EQMAIL.GLBDATA.cusAmt = CUST.ALERTS.transactionAmount 
	else
		EQMAIL.GLBDATA.cusAmt = ""
	endif
	if(fieldexists(CUST.ALERTS.narraction1)==1)then
		EQMAIL.GLBDATA.narraction1 = CUST.ALERTS.narraction1 
	else
		EQMAIL.GLBDATA.narraction1 = ""
	endif
	if(fieldexists(CUST.ALERTS.transacAccount)==1)then
		EQMAIL.GLBDATA.cusAcct = CUST.ALERTS.transacAccount 
	else
		EQMAIL.GLBDATA.cusAcct = ""
	endif
	if(fieldexists(CUST.ALERTS.mailAccount)==1)then
		EQMAIL.GLBDATA.gamAcct = CUST.ALERTS.mailAccount 
	else
		EQMAIL.GLBDATA.gamAcct = ""
	endif
	if(fieldexists(CUST.ALERTS.narractionreff)==1)then
		EQMAIL.GLBDATA.tranId = CUST.ALERTS.narractionreff 
	else
		EQMAIL.GLBDATA.tranId = ""
	endif
	if(fieldexists(CUST.ALERTS.narraction2)==1)then
		EQMAIL.GLBDATA.narraction2 = CUST.ALERTS.narraction2 
	else
		EQMAIL.GLBDATA.narraction2 = ""
	endif
	if(fieldexists(CUST.ALERTS.sysDatesys)==1)then
		EQMAIL.GLBDATA.sysDatesys = CUST.ALERTS.sysDatesys 
	else
		EQMAIL.GLBDATA.sysDatesys = ""
	endif
	if(fieldexists(CUST.ALERTS.narraction3)==1)then
		EQMAIL.GLBDATA.narraction3 = CUST.ALERTS.narraction3 
	else
		EQMAIL.GLBDATA.narraction3 = ""
	endif
	if(fieldexists(BANCS.INPUT.partTranType)==1)then
		EQMAIL.GLBDATA.drcrCD	= BANCS.INPUT.partTranType
	else
		EQMAIL.GLBDATA.drcrCD   = "NA"
	endif
	if(fieldexists(BANCS.INPUT.tranCrncyCode)==1)then
		EQMAIL.GLBDATA.tranCrncy   = BANCS.INPUT.tranCrncyCode
	else
		EQMAIL.GLBDATA.tranCrncy   = "NA" 
	endif
	if(fieldexists(BANCS.INPUT.acctCrncyCode)==1)then
		EQMAIL.GLBDATA.acctCrncy   = BANCS.INPUT.acctCrncyCode
	else
		EQMAIL.GLBDATA.acctCrncy   = "NA" 
	endif
	if(EQMAIL.GLBDATA.acctCrncy == EQMAIL.GLBDATA.tranCrncy)then
		EQMAIL.GLBDATA.tCrncy = EQMAIL.GLBDATA.acctCrncy 
	else
		EQMAIL.GLBDATA.tCrncy = EQMAIL.GLBDATA.tranCrncy  
	endif
#fetch custname
	##sv_s = "salutation,custFirstName,custLastNAme | select salutation,(case when instrc(cust_first_name,' ',1,1) >0  "
	##sv_s = sv_s + " then substr(cust_first_name,1,instrc(cust_first_name,' ',1,1)) else cust_first_name end) as firstName, "
	##sv_s = sv_s + " (case when instrc(cust_last_name,' ',1,1) >0 then substr(cust_last_name,1,instrc(cust_last_name,' ',1,1)) "
	##sv_s = sv_s + " else cust_last_name end) as LastName "
 	##sv_s = sv_s + "  from crmuser.accounts where orgkey in (select cif_id from tbaadm.gam where foracid= '"+ EQMAIL.GLBDATA.cusAcct +"' and entity_cre_flg='Y' " 
	##sv_s = sv_s + " and del_flg='N' and acct_cls_flg='N' ) "
	sv_s = " custFirstName,custLastNAme | "
	sv_s = sv_s + " select (case when instrc(Acct_Name,' ',1,1) >0 then substr(Acct_Name,1,instrc(Acct_Name,' ',1,1)) "
	sv_s = sv_s + " else Acct_Name end) as firstName, "
	sv_s = sv_s + " (case when instrc(acct_short_name,' ',1,1) >0 then substr(acct_short_name,1,instrc(acct_short_name,' ',1,1)) "
	sv_s = sv_s + " else acct_short_name end) as custLastNAme "
	sv_s = sv_s + " from tbaadm.gam where foracid= '"+ EQMAIL.GLBDATA.gamAcct +"' and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg='N' "
	print(sv_s)
	sv_u = urhk_dbSelectWithBind(sv_s)
	if(sv_u == 0)then
			EQMAIL.GLBDATA.custFirstName	= BANCS.OUTPARAM.custFirstName	
			EQMAIL.GLBDATA.custLastNAme	= BANCS.OUTPARAM.custLastNAme	
	else
			EQMAIL.GLBDATA.custFirstName	= "" 
			EQMAIL.GLBDATA.custLastNAme	= "" 
	endif
	print(EQMAIL.GLBDATA.custFirstName)
	if(EQMAIL.GLBDATA.custFirstName == EQMAIL.GLBDATA.custLastNAme)then
		EQMAIL.GLBDATA.custFirstName = EQMAIL.GLBDATA.custLastNAme
		EQMAIL.GLBDATA.custLastNAme = "NA"
	endif
#fetching tomail
	sv_s = " toAddr |select email from tbaadm.cemail where email_b2kid in (select cif_id from tbaadm.gam where foracid='"+ EQMAIL.GLBDATA.gamAcct +"' ) "
	sv_s = sv_s + " and preferredflag='Y' "	
	print(sv_s)
	sv_u = urhk_dbSelectWithBind(sv_s)
	if(sv_u==0)then
		EQMAIL.GLBDATA.toAddr = BANCS.OUTPARAM.toAddr
	else
		EQMAIL.GLBDATA.toAddr = "charles.ndirangu@equitybank.co.ke"
	endif
	print(EQMAIL.GLBDATA.toAddr)
#Inputs/Outputs
        EQMAIL.GLBDATA.frmAddr  = "Customer.care@equitybank.co.ke"
        ##EQMAIL.GLBDATA.toAddr   = "charles.ndirangu@equitybank.co.ke"
        ##EQMAIL.GLBDATA.toAddr   = "john.wamai@equitybank.co.ke"
        ##EQMAIL.GLBDATA.toAddr   = "vino.palani@simbatech.biz"
        ##EQMAIL.GLBDATA.ccAddr   = "vino.palani@simbatech.biz"
        ##EQMAIL.GLBDATA.ccAddr   = "charles.ndirangu@equitybank.co.ke"
	##EQMAIL.GLBDATA.ccAddr   = "ndirangucharlesg@gmail.com"
	EQMAIL.GLBDATA.tranDate	= MID$(BANCS.STDIN.sysDate,0,10) 
	EQMAIL.GLBDATA.adviceFile = ""
	EQMAIL.GLBDATA.advFil 	  = ""
	EQMAIL.GLBDATA.comfil	  = ""
	BANCS.OUTPARAM.tstamp	  = ""

	print(EQMAIL.GLBDATA.toAddr)
	print(EQMAIL.GLBDATA.tranDate)
	print(EQMAIL.GLBDATA.cusAcct)
	print(EQMAIL.GLBDATA.cusAmt)
	print(EQMAIL.GLBDATA.cusName)
	print(EQMAIL.GLBDATA.transactiontype)
	print(EQMAIL.GLBDATA.narraction1)
	print(EQMAIL.GLBDATA.narraction2)
	print(EQMAIL.GLBDATA.sysDatesys)
	print(EQMAIL.GLBDATA.narraction3)

#Advice File
	sv_o = urhk_B2k_PID("")
	if(sv_o==0)then
		EQMAIL.GLBDATA.adviceFile = "TransactionAdvice"+TRIM(BANCS.OUTPARAM.PID)+".txt" 
	else
		sv_s = "tstamp|SELECT TO_CHAR(sysdate,'DDMMYYHH24MISS') FROM DUAL"
        	sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u ==0)then
			EQMAIL.GLBDATA.tstmp	= BANCS.OUTPARAM.tstamp
			EQMAIL.GLBDATA.adviceFile = "TransactionAdvice"+BANCS.OUTPARAM.tstamp+".txt"
		else
			EQMAIL.GLBDATA.adviceFile = "TransactionAdvice.txt"
		endif
	endif
#getPdf
	##EQMAIL.GLBDATA.inpFile = "TransactionAdvice"+BANCS.OUTPARAM.tstamp+".lst"	
	##sv_i = EQMAIL.GLBDATA.cusAcct+ "!" +EQMAIL.GLBDATA.cusAmt+ "!" +EQMAIL.GLBDATA.tranId
	##sv_c = "exebatch spbx4001 TBAADM.FIN_EQUITY_TRANADV_PACK.FIN_EQUITY_TRANADV_PROC '" 4004100224745!5645.00!S98687'
	##sv_c = "exebatch spbx4001 TBAADM.FIN_EQUITY_TRANADV_PACK.FIN_EQUITY_TRANADV_PROC '" +sv_i+ "'"  ">" +EQMAIL.GLBDATA.inpFile  

	##EQMAIL.GLBDATA.tranAmt = "1000"
	##EQMAIL.GLBDATA.drcr = "Dr"
	##EQMAIL.GLBDATA.bnk = "Equity Bank"
	##sv_o = "echo " + '"' + EQMAIL.GLBDATA.tranAmt + '"' + ">>" + EQMAIL.GLBDATA.adviceFile 
	##sv_u = system(sv_o)
	##sv_o = "echo " + '"' + EQMAIL.GLBDATA.drcr + '"' + ">>" + EQMAIL.GLBDATA.adviceFile 
	##sv_u = system(sv_o)
	##sv_o = "echo " + '"' + EQMAIL.GLBDATA.bnk + '"' + ">>" + EQMAIL.GLBDATA.adviceFile 
	##sv_u = system(sv_o)
        ##sv_u = urhk_getEnv("TBA_PROD_ROOT")
        ##EQMAIL.GLBDATA.filPath = BANCS.OUTPARAM.envValue
        ##EQMAIL.GLBDATA.advFil  =  EQMAIL.GLBDATA.filPath + "/" + "CDCI_LOGS" + "/" + BANCS.STDIN.userId + "/" + EQMAIL.GLBDATA.adviceFile 
	##print(EQMAIL.GLBDATA.advFil)
	##EQMAIL.GLBDATA.advFil  = "/export/home/kgatimu/vino.palani/eazzy.pdf"

        sv_u = urhk_getFileLocation("COM|eqmail.com")
        if(sv_u ==0)then
                print(BANCS.OUTPARAM.fileLocation)
                EQMAIL.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "eqmail.com"
		####EQMAIL.GLBDATA.comfil = EQMAIL.GLBDATA.comfil + " " + EQMAIL.GLBDATA.toAddr + " " + EQMAIL.GLBDATA.advFil + " " + EQMAIL.GLBDATA.custFirstName + " " + EQMAIL.GLBDATA.custLastNAme+ " " + EQMAIL.GLBDATA.cusAmt + " " + EQMAIL.GLBDATA.cusAcct + " " + EQMAIL.GLBDATA.tranId + " " + EQMAIL.GLBDATA.drcrCD + " " + EQMAIL.GLBDATA.tCrncy 
		#++++++++++++++
		##with pdf/name
		#++++++++++++++
		###EQMAIL.GLBDATA.comfil = EQMAIL.GLBDATA.comfil + " " + EQMAIL.GLBDATA.toAddr + " " + EQMAIL.GLBDATA.advFil + " " + EQMAIL.GLBDATA.custFirstName + " " + EQMAIL.GLBDATA.cusAmt + " " + EQMAIL.GLBDATA.cusAcct + " " + EQMAIL.GLBDATA.tranId + " " + EQMAIL.GLBDATA.drcrCD + " " + EQMAIL.GLBDATA.tCrncy 
		#++++++++++++++
		##without pdf/name
		#++++++++++++++
		EQMAIL.GLBDATA.comfil = EQMAIL.GLBDATA.comfil + " " + EQMAIL.GLBDATA.toAddr + " " + EQMAIL.GLBDATA.custFirstName + " " + EQMAIL.GLBDATA.cusAmt + " " + EQMAIL.GLBDATA.cusAcct + " " + EQMAIL.GLBDATA.tranId + " " + EQMAIL.GLBDATA.drcrCD + " " + EQMAIL.GLBDATA.tCrncy 
		print(EQMAIL.GLBDATA.comfil)
	else
		EQMAIL.GLBDATA.comfil	= ""
        endif
	if(EQMAIL.GLBDATA.comfil != "")then
		sv_u = system(EQMAIL.GLBDATA.comfil)
		if(sv_u ==0)then
			print("smtp success")
			exitscript
		else
			print("failed smtp")
			exitscript
		endif
	endif
#CleanUp
	if(classexists("EQMAIL","GLBDATA")==1)then
		deleteclass("EQMAIL","GLBDATA")
	endif
	if(repexists("EQMAIL")==1)then
		deleterep("EQMAIL")
	endif
        exitscript
trace off
end-->
