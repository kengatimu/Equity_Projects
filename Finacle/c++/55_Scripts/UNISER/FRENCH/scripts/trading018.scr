#=================================================
# IMPORTANT: Auto Generated Header. DO NOT CHANGE MANUALLY.
# category: Event Based
# script: FundAndPost.scr
# script that is used to fund a cdsc account and post the order  details
#=================================================

<--START
CHECKSUM="fc70716ebdc73037387c22ffb35a9751a75c63e4b2e42a2c9e47ebe5014637db"
	TRACE ON
	
	
	#####################################################
	
	IF(REPEXISTS("CUST")==0) THEN
	#{
		
		CREATEREP("CUST")
		
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","TRADE")==0) THEN
	#{
		
		CREATECLASS("CUST","TRADE",5)
		
	#}
	ENDIF
	
	
	
	
	#######################################################
	
	
	############################Setting the input Parameter #########################
	#Getting the time-stamp from sysDate
	BANCS.INPARAM.Day = LEFT$(BANCS.STDIN.sysDate,2)
	print(BANCS.INPARAM.Day)
	BANCS.INPARAM.Month = MID$(BANCS.STDIN.sysDate,3,2)
	print(BANCS.INPARAM.Month)
	BANCS.INPARAM.Year = MID$(BANCS.STDIN.sysDate,8,2)
	print(BANCS.INPARAM.Year)
	BANCS.INPARAM.Hour = MID$(BANCS.STDIN.sysDate,11,2)
	print(BANCS.INPARAM.Hour)
	BANCS.INPARAM.Minute = MID$(BANCS.STDIN.sysDate,14,2)
	print(BANCS.INPARAM.Minute)
	BANCS.INPARAM.Second = MID$(BANCS.STDIN.sysDate,17,2)
	print(BANCS.INPARAM.Second)
	
	BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second
	
	
	BANCS.INPARAM.REQUESTUUID           = "reqUUID"+"CSHAPU"+BANCS.INPARAM.SYSDATE
	BANCS.INPARAM.BANKID                = "54"
	BANCS.INPARAM.SERVICEREQUESTID      = "FundAndPost"
	BANCS.INPARAM.MESSAGEDATETIME       = "BANCS.STDIN.sysDate"
	BANCS.INPARAM.CHANNELID             = "FNP"
	BANCS.INPARAM.SERVICEREQUESTVERSION = "10.2"
	BANCS.INPARAM.TIMEZONE              = "GMT+01:30"
	#Setting the Service Name to FIJCA. This should not be changed.
	BANCS.INPARAM.SERVICE_NAME="FIJCA"
	#you can change the value of following flag to "R" if user needs the response back
	BANCS.INPARAM.SEND_RECV_FLG="R"
	
	CUST.TRADE.header="MSG_TYPE=NVPSTR,MSG_SUB_TYPE=FINVP###reqhdr.requestuuid^=^"+BANCS.INPARAM.REQUESTUUID+"^|^reqhdr.servicerequestid^=^"+BANCS.INPARAM.SERVICEREQUESTID+"^|^reqhdr.servicerequestversion^=^"+BANCS.INPARAM.SERVICEREQUESTVERSION
	CUST.TRADE.header=CUST.TRADE.header+"^|^reqhdr.origchannelid^=^"+BANCS.INPARAM.CHANNELID+"^|^reqhdr.languageid^=^en_US^|^reqhdr.messagedatetime^=^"+BANCS.STDIN.sysDate+"^|^reqhdr.bankid^=^"+BANCS.INPARAM.BANKID+"^|^reqhdr.timezone^=^"+BANCS.INPARAM.TIMEZONE+"^|^"
	
	print(CUST.TRADE.header)
	
	########################
	########################Funding strings
	#CUST.TRADE.URL="http://10.1.5.36:9003/SharePurchaseService/SharePurchaseService"
	#CUST.TRADE.URL="http://10.3.26.74:8080/SharePurchaseService/SharePurchaseService"
	CUST.TRADE.URL="http://10.1.5.46:7002/SharePurchaseService/SharePurchaseService"
	
	CUST.TRADE.ordType="1"
	#This will be in the verification page
	CUST.TRADE.tid=BANCS.INPARAM.SYSDATE
	CUST.TRADE.funding="0"
	CUST.TRADE.createorder="0"
	
	#####Hard Coding
	BANCS.INPARAM.BINDVARS=CUST.TRADE.dc
	PRINT(CUST.TRADE.dc)
	############ Selecting the tran id from the database
	#############String for creating an order
	
	####Some hardcoding
	CUST.TRADE.solid=BANCS.STDIN.mySolId
	########
	
	
	
	####Setting the narrative from the database
	
	sv_q="tran_id|select tran_id from custom.share_purchase_master where ID_KEY=?SVAR"
	sv_q=urhk_dbSelectWithBind(sv_q)
	PRINT(sv_q)
	
	CUST.TRADE.paymentnarrative=BANCS.OUTPARAM.tran_id+":FINDEBIT"
	CUST.TRADE.dc2=BANCS.OUTPARAM.tran_id
	PRINT(CUST.TRADE.paymentnarrative)
	
	CUST.TRADE.paymentreference=CUST.TRADE.dc2
	PRINT(CUST.TRADE.paymentreference)
	
	
	CUST.TRADE.ErrorMessage=""
	
	######################################
	
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_q="TRAN_ID,TRAN_AMOUNT,CREATED_BY_ID,CDSC_NUMBER,CDSC_ACCOUNT_IS_FUNDED|select TRAN_ID,TRAN_AMOUNT,CREATED_BY_ID,CDSC_NUMBER,CDSC_ACCOUNT_IS_FUNDED from custom.share_purchase_master where  trim(ID_KEY)=?SVAR AND rownum=1"
	PRINT(sv_q)
	sv_d=urhk_dbSelectWithBind(sv_q)
	PRINT(sv_d)
	print(BANCS.OUTPARAM.CDSC_ACCOUNT_IS_FUNDED)
	
	####If the  cdsc account is already funded then do not attempt to fund the account
	
	
	IF(sv_d==0) THEN
	#{
		IF(CINT(BANCS.OUTPARAM.CDSC_ACCOUNT_IS_FUNDED)==0) THEN
		#{
			sv_e=BANCS.OUTPARAM.TRAN_ID
			sv_e=TRIM(sv_e)
			PRINT(sv_e)
			sv_f=BANCS.OUTPARAM.TRAN_AMOUNT
			sv_f=TRIM(sv_f)
			PRINT(sv_f)
			sv_g=BANCS.OUTPARAM.CREATED_BY_ID
			
			###Some hardcoding
			###sv_g="AG01342"
			#############
			
			sv_g=TRIM(sv_g)
			PRINT(sv_g)
			sv_h=BANCS.OUTPARAM.CDSC_NUMBER
			PRINT(sv_h)
			sv_h=TRIM(sv_h)
			sv_i=CUST.TRADE.paymentnarrative
			PRINT(sv_i)
			
			
			CUST.TRADE.paymentAmount=sv_f
			PRINT(CUST.TRADE.paymentAmount)
			CUST.TRADE.userName1=sv_g
			PRINT(CUST.TRADE.userName1)
			CUST.TRADE.userName2=BANCS.STDIN.userId
			PRINT(CUST.TRADE.userName2)
			CUST.TRADE.CLIENTCDSCNUMBER=sv_h
			PRINT(CUST.TRADE.CLIENTCDSCNUMBER)
			
			
			######Checking both the creator and verifier exist in the custodial system
			
			CUST.TRADE.validationMessage=CUST.TRADE.header+"body^=^checkUsersExist^|^opCode^=^7^|^Url^=^"+CUST.TRADE.URL+"^|^userName1^=^"+CUST.TRADE.userName1+"^|^userName2^=^"+CUST.TRADE.userName2+"^|^"
			PRINT(CUST.TRADE.validationMessage)
			
			sv_l=urhk_ConnectToFIAndSendMsg(CUST.TRADE.validationMessage)
			print(sv_l)
			IF(sv_l!=0) THEN
			#{
				IF(BANCS.OUTPARAM.ErrMsg!="") THEN
				#{
					print("Error thrown from the user hook is ["+BANCS.OUTPARAM.ErrMsg+"]")
					
					CUST.TRADE.ErrorMessage="Database Error ocurred"+BANCS.OUTPARAM.ErrMsg
					BANCS.OUTPARAM.successOrFailure="F"
					GOTO EXITEXECUTION
				#}
				ENDIF
			#}
			ENDIF
			IF(BANCS.OUTPARAM.RespMesg!="") THEN
			#{
				PRINT(BANCS.OUTPARAM.RespMesg)
				##Parsing the response
				sv_y=BANCS.OUTPARAM.RespMesg
				sv_z=(GETPOSITION(sv_y,"RsMessage"))
				sv_y=MID$(sv_y,sv_z,13)
				#sMessage^=^0^
				sv_z=MID$(sv_y,11,1)
				PRINT(sv_z)
				IF(CINT(sv_z)==0) THEN
				#{
					CUST.TRADE.ErrorMessage=" EITHER THE USER ID "+CUST.TRADE.userName1+ "  OR "+CUST.TRADE.userName2+" ARE NOT MAINTAINED IN THE EXTERNAL SYSTEM"
					GOTO EXITEXECUTION
					
				#}
				ENDIF
				
				
				
			#}
			ENDIF
			
			
			
			####Setting the message to be sent for funding an account
			## this is not now used with the new pcs custodial system
			CUST.TRADE.msg=CUST.TRADE.header+"body^=^FundAccount^|^opCode^=^1^|^Url^=^"+CUST.TRADE.URL+"^|^PaymentAmount^=^"+CUST.TRADE.paymentAmount+"^|^PaymentRef^=^"+CUST.TRADE.paymentreference+"^|^PaymentNarative^=^"+CUST.TRADE.paymentnarrative+"^|^ChangedBy^=^"+CUST.TRADE.userName1+"^|^ClientCDSCNo^=^"+CUST.TRADE.CLIENTCDSCNUMBER+"^|^"
			
			PRINT(CUST.TRADE.msg)
			
			
			
			
			###################### Setting the connection parameters END ######################
			
			#Calling the userhook to connect to FI
			sv_l=urhk_ConnectToFIAndSendMsg(CUST.TRADE.msg)
			print(sv_l)
			IF(sv_l!=0) THEN
			#{
				IF(BANCS.OUTPARAM.ErrMsg!="") THEN
				#{
					print("Error thrown from the user hook is ["+BANCS.OUTPARAM.ErrMsg+"]")
					
					CUST.TRADE.ErrorMessage="Database Error ocurred"
					BANCS.OUTPARAM.successOrFailure="F"
					GOTO EXITEXECUTION
				#}
				ENDIF
			#}
			ENDIF
			IF(BANCS.OUTPARAM.RespMesg!="") THEN
			#{
				###Extractingthe code from the string
				
				CUST.TRADE.RespMessage=BANCS.OUTPARAM.RespMesg
				PRINT(CUST.TRADE.RespMessage)
				
				sv_y=CUST.TRADE.RespMessage
				sv_z=(GETPOSITION(sv_y,"RsMessage"))
				sv_y=MID$(sv_y,sv_z,13)
				#sMessage^=^0^
				sv_z=MID$(sv_y,11,1)
				PRINT(sv_z)
				####TODO exit if the funding could not happen
				IF(sv_z!=1) THEN
				#{
					CUST.TRADE.ErrorMessage="There was an error in Funding CDSC Account. Please Contact Custodial Services!"
					GOTO EXITEXECUTION
					
				#}
				ENDIF
				
				IF(sv_z==1) THEN
				#{
					##If the funding happened then  update the flag for sent to external system to 1
					
					###Updating the funding flag
					CUST.TRADE.funding="1"
					
					sv_q="update CUSTOM.SHARE_PURCHASE_MASTER set SENT_TO_EXT=1,CDSC_ACCOUNT_IS_FUNDED=1 where trim(ID_KEY)=?SVAR"
					
					BANCS.INPARAM.BINDVARS=CUST.TRADE.dc
					
					sv_q=urhk_dbSQLWithBind(sv_q)
					
					PRINT(sv_q)
					
					
					
				#}
				ENDIF
				
				
				
				
			#}
			ENDIF
		#}
		ENDIF
		#}
		
		#}
	ELSE
		#{
		
		CUST.TRADE.ErrorMessage="Database Error ocurred"
		BANCS.OUTPARAM.successOrFailure="F"
		GOTO EXITEXECUTION
		
	#}
	ENDIF
	
	
	
	
	#######Selecting the count of the records
	
	
	sv_n="REC_COUNT|select count (*) as rec_count from CUSTOM.SHARE_PURCHASE_DETAILS where trim(FOREIGN_KEY_SEQKEY)=?SVAR AND IS_VERIFIED=0"
	
	
	sv_n=urhk_dbSelectWithBind(sv_n)
	
	
	print(sv_n)
	
	IF(sv_n!=0) THEN
	#{
		##Exit if no records
		
		PRINT("There are no records for the Tran Id")
		CUST.TRADE.ErrorMessage="There are no records in details"
		GOTO EXITEXECUTION
		
		
		#}
	ELSE
		#{
		
		##Set the repository field count
		
		CUST.TRADE.rec_count=BANCS.OUTPARAM.REC_COUNT
		PRINT(CUST.TRADE.rec_count)
		##########Getting the date in selected format
		
		sv_q="TRANDATE|select to_char(sysdate,'DD/MM/YYYY') as trandate from dual"
		
		sv_q=urhk_dbSelectWithBind(sv_q)
		
		IF(sv_q==0) THEN
		#{
			CUST.TRADE.trandate=BANCS.OUTPARAM.TRANDATE
			PRINT(CUST.TRADE.trandate)
			
			###Setting the order contact
			CUST.TRADE.ordercontact="DC"+CUST.TRADE.dc2+":"+CUST.TRADE.trandate
			
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	
	
	
	######################STEP 1 Setting rep variables in a loop
	
	sv_n="DETAILS_KEY,TRAN_ID,TRAN_SOL_ID,CDSC_NUMBER,ACCOUNT_NUMBER,SECURITY_CODE,NO_OF_SHARES,ASKING_PRICE,CREATED_BY_ID,VERIFIED_BY_ID|select d.DETAILS_KEY,m.TRAN_ID,m.TRAN_SOL_ID,m.CDSC_NUMBER,m.ACCOUNT_NUMBER,d.SECURITY_NAME,d.NO_OF_SHARES,D.ASKING_PRICE,m.CREATED_BY_ID,M.VERIFIED_BY_ID from CUSTOM.SHARE_PURCHASE_MASTER m,CUSTOM.SHARE_PURCHASE_DETAILS d where M.ID_KEY=D.FOREIGN_KEY_SEQKEY AND d.IS_VERIFIED=0 AND trim(M.ID_KEY)=?SVAR"
	print(sv_n)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	
	sv_n=urhk_dbCursorOpenWithBind(sv_n)
	PRINT(sv_n)
	
	sv_m=BANCS.OUTPARAM.DB_CURSOR_NUMBER
	
	
	
	IF(sv_n!=0) THEN
	#{
		##Exit if the record fetch could not happen
		PRINT("There are no records for the tran Id")
		sv_o=urhk_dbCursorClose(sv_m)
		
		
		#}
	ELSE
		#{
		
		##Set rep variables
		
		##Setting the tran id
		
		
		PRINT(sv_m)
		
		sv_n=CINT(CUST.TRADE.rec_count)
		
		PRINT(sv_n)
		
		###Initializing the counter
		
		CUST.TRADE.counter="0"
		
		WHILE(CINT(CUST.TRADE.counter)<sv_n)
		#{
			
			sv_a=urhk_dbCursorFetch(sv_m)
			PRINT(sv_a)
			PRINT(CUST.TRADE.counter)
			
			
			
			
			("CUST").("TRADE").("tranid")=TRIM(BANCS.OUTPARAM.TRAN_ID)
			PRINT(CUST.TRADE.tranid)
			("CUST").("TRADE").("solid")=TRIM(BANCS.OUTPARAM.TRAN_SOL_ID)
			PRINT(CUST.TRADE.solid)
			("CUST").("TRADE").("cdscid")=TRIM(BANCS.OUTPARAM.CDSC_NUMBER)
			PRINT(CUST.TRADE.cdscid)
			("CUST").("TRADE").("acid")=TRIM(BANCS.OUTPARAM.ACCOUNT_NUMBER)
			PRINT(CUST.TRADE.acid)
			
			
			sv_u="secid_"+CUST.TRADE.counter
			PRINT(sv_u)
			("CUST").("TRADE").(sv_u)=TRIM(BANCS.OUTPARAM.SECURITY_CODE)
			PRINT(("CUST").("TRADE").(sv_u))
			
			
			####The details key has unique key for each record selected
			sv_u="detkey_"+CUST.TRADE.counter
			print(sv_u)
			("CUST").("TRADE").(sv_u)=TRIM(BANCS.OUTPARAM.DETAILS_KEY)
			PRINT(("CUST").("TRADE").(sv_u))
			
			
			
			
			sv_u="shareno_"+CUST.TRADE.counter
			PRINT(sv_u)
			("CUST").("TRADE").(sv_u)=TRIM(BANCS.OUTPARAM.NO_OF_SHARES)
			PRINT(("CUST").("TRADE").(sv_u))
			
			
			
			sv_u="askingprice_"+CUST.TRADE.counter
			("CUST").("TRADE").(sv_u)=TRIM(BANCS.OUTPARAM.ASKING_PRICE)
			PRINT(("CUST").("TRADE").(sv_u))
			
			
			
			
			("CUST").("TRADE").("createdby")=TRIM(BANCS.OUTPARAM.CREATED_BY_ID)
			PRINT(CUST.TRADE.createdby)
			
			
			######Some hardcoding
			#("CUST").("TRADE").("createdby")="AG01342"
			##################
			
			
			
			("CUST").("TRADE").("verifiedby")=TRIM(BANCS.OUTPARAM.VERIFIED_BY_ID)
			
			
			########Some hardcoding
			("CUST").("TRADE").("verifiedby")=BANCS.STDIN.userId
			#("CUST").("TRADE").("verifiedby")="GN00418"
			##############
			PRINT(CUST.TRADE.verifiedby)
			
			
			CUST.TRADE.counter=CINT(CUST.TRADE.counter)+1
			
			PRINT(CUST.TRADE.counter)
			
		#}
		DO
		
		sv_m=urhk_dbCursorClose(sv_m)
		
	#}
	ENDIF
	
	
	
	#########################STEP 2  Iterating over the repository fields and sending to FI
	
	sv_n=CINT(CUST.TRADE.rec_count)
	
	PRINT(sv_n)
	
	CUST.TRADE.counter="0"
	
	##setting the currency code
	
	
	
	sv_u="ACCT_CRNCY_CODE|select ACCT_CRNCY_CODE from tbaadm.gam where foracid =?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.TRADE.acid
	print(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbSelectWithBind(sv_u)
	
	
	
	IF (sv_r==0) THEN
	#{
		print(BANCS.OUTPARAM.ACCT_CRNCY_CODE)
		CUST.TRADE.acctCurrency=BANCS.OUTPARAM.ACCT_CRNCY_CODE
		#}
	ELSE
		#{
		# default currency code
		CUST.TRADE.acctCurrency=""
	#}
	ENDIF
	
	
	
	WHILE(CINT(CUST.TRADE.counter)<sv_n)
	#{
		
		
		PRINT(CUST.TRADE.counter)
		PRINT(sv_n)
		print(CUST.TRADE.URL)
		print(CUST.TRADE.solid)
		
		#######Forming the details key for each record
		sv_u="detkey_"+CUST.TRADE.counter
		PRINT(("CUST").("TRADE").(sv_u))
		CUST.TRADE.reckey=("CUST").("TRADE").(sv_u)
		
		
		###Forming the security id field
		sv_u="secid_"+CUST.TRADE.counter
		PRINT(("CUST").("TRADE").(sv_u))
		CUST.TRADE.securityid2=("CUST").("TRADE").(sv_u)
		
		####Forming the number of shares field
		sv_u="shareno_"+CUST.TRADE.counter
		PRINT(("CUST").("TRADE").(sv_u))
		CUST.TRADE.noshares2=("CUST").("TRADE").(sv_u)
		
		#####Forming the asking price
		sv_u="askingprice_"+CUST.TRADE.counter
		PRINT(("CUST").("TRADE").(sv_u))
		CUST.TRADE.askingprice2=("CUST").("TRADE").(sv_u)
		
		
		print(CUST.TRADE.acid)
		
		CUST.TRADE.msg=CUST.TRADE.header+"body^=^CreateOrder^|^opCode^=^2^|^Url^=^"+CUST.TRADE.URL+"^|^BranchCode^=^"+CUST.TRADE.solid+"^|^ClientCDSCNo^=^"+CUST.TRADE.cdscid+"^|^OrderType^=^"+CUST.TRADE.ordType+"^|^userName^=^"+CUST.TRADE.createdby+"^|^OrderQuantity^=^"+CUST.TRADE.noshares2+"^|^OrderPrice^=^"+CUST.TRADE.askingprice2+"^|^SecurityId^=^"+CUST.TRADE.securityid2+"^|^OrderRef^=^"+CUST.TRADE.tranid+"^|^ApprovedBy^=^"+CUST.TRADE.verifiedby+"^|^OrderContact^=^"+CUST.TRADE.tranid+":"+CUST.TRADE.acid+","+CUST.TRADE.acctCurrency +":"+ CUST.TRADE.trandate
		
		PRINT(CUST.TRADE.msg)
		
		#Calling the userhook to connect to FI
		
		sv_x=urhk_ConnectToFIAndSendMsg(CUST.TRADE.msg)
		PRINT(sv_x)
		IF(sv_x!=0) THEN
		#{
			IF(BANCS.OUTPARAM.ErrMsg!="") THEN
			#{
				print("Error thrown from the user hook in create order is ["+BANCS.OUTPARAM.ErrMsg+"]")
				CUST.TRADE.ErrorMessage=BANCS.OUTPARAM.ErrMsg
				GOTO EXITEXECUTION
				
			#}
			ENDIF
			
		#}
		ENDIF
		
		IF(BANCS.OUTPARAM.RespMesg!="") THEN
		#{
			PRINT(BANCS.OUTPARAM.RespMesg)
			
			###Parsing the response string
			
			sv_y=BANCS.OUTPARAM.RespMesg
			sv_z=(GETPOSITION(sv_y,"RsMessage"))
			sv_y=MID$(sv_y,sv_z,13)
			PRINT(sv_y)
			#sMessage^=^0^
			sv_z=MID$(sv_y,11,1)
			PRINT(sv_z)
			####TODO exit if the creation of the order could not happen
			IF(sv_z!=1) THEN
			#{
				
				##If funding happened
				sv_x=" "
				IF(CUST.TRADE.funding=="1") THEN
				#{
					sv_x=" Order not created, Contact Custodial Services!"
					
					
				#}
				ENDIF
				CUST.TRADE.ErrorMessage="There was an error creating the order in custodiknow "+sv_x
				GOTO EXITEXECUTION
				
			#}
			ENDIF
			IF(sv_z==1) THEN
			#{
				###Updating the is_verified and sent to external flags for the record
				
				sv_q="update custom.share_purchase_details set SENT_TO_EXTERNAL=1,IS_VERIFIED=1 where trim(DETAILS_KEY)=?SVAR"
				
				BANCS.INPARAM.BINDVARS=TRIM(CUST.TRADE.reckey)
				
				sv_q=urhk_dbSQLWithBind(sv_q)
				
				PRINT(sv_q)
				
				
			#}
			ENDIF
			
		#}
		ENDIF
		
		
		CUST.TRADE.counter=CINT(CUST.TRADE.counter)+1
		
	#}
	DO
	
	
	
	
	EXITEXECUTION:
		
		EXITSCRIPT
		TRACE OFF
END-->
