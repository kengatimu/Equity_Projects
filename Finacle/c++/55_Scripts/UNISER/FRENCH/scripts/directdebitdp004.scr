	#{
		CREATECLASS("CUST", "CUDDS", 5)
	#}
	ENDIF
	sv_a = 1
	print(BANCS.INPUT.Originator)
	
	sv_s = "recCount"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT COUNT(*) "
	sv_s = sv_s + " FROM TBAADM.EMRM "
