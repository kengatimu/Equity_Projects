	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	CUST.CUDDS.recCount = BANCS.OUTPARAM.recCount
	print(CUST.CUDDS.recCount)
	
	sv_q = urhk_SetOrbOut("recCount|"+CUST.CUDDS.recCount)
	
	sv_s = "empId,empName"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT replace(EMPLOYER_ID,'''',' '),rpad(replace(EMPLOYER_NAME,'''',' '),35,' ') "
	sv_s = sv_s + " FROM TBAADM.EMRM "
	sv_s = sv_s + " WHERE del_flg != 'Y' "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	#sv_s = sv_s + " AND rownum < 50 "
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	
	print(sv_s)
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	
	IF( sv_c != 0) THEN
	#{
		sv_u = urhk_SRV_SetErr("No recods fetched for the entered Account Number")
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		
		WHILE( sv_c == 0)
		#{
			CUST.CUDDS.count = sv_a
			print(CUST.CUDDS.count)
			
			CUST.CUDDS.empId= BANCS.OUTPARAM.empId
			print(CUST.CUDDS.empId)
			
			CUST.CUDDS.empName= BANCS.OUTPARAM.empName
			print(CUST.CUDDS.empName)
			
			sv_z = "Originator_" + CUST.CUDDS.count
			sv_z = sv_z + "|" + CUST.CUDDS.empId
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "empName_" + CUST.CUDDS.count
			sv_z = sv_z + "|" + CUST.CUDDS.empName
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_a = sv_a + 1
			sv_c = urhk_dbCursorFetch(sv_l)
			print(sv_c)
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
