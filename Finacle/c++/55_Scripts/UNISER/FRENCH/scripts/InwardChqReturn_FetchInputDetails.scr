        ENDIF
        
        
	sv_v = "ICR_REQ.OrgTranID"
        IF(FIELDEXISTS(("BANCS").("INPUT").(sv_v))) THEN
        #{

                CUST.INTERFACE.OrgTranID =("BANCS").("INPUT").(sv_v)
		CUST.INTERFACE.OrgTranID = LPAD(CUST.INTERFACE.OrgTranID,9,' ')
		print(CUST.INTERFACE.OrgTranID)
        #}
        ELSE
        #{
                CUST.INTERFACE.errorCode = "ERR073"
                CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
        #}
        ENDIF
        
        sv_v = "ICR_REQ.OrgTranDate"
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_v))) THEN
	#{

		CUST.INTERFACE.OrgTranDate =("BANCS").("INPUT").(sv_v)
	#}
	ELSE
	#{
		CUST.INTERFACE.errorCode = "ERR074"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	#}
        ENDIF
        
        sv_v = "ICR_REQ.RejResCode"
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_v))) THEN
	#{

		CUST.INTERFACE.RejResCode =("BANCS").("INPUT").(sv_v)
	#}
	ELSE
	#{
		CUST.INTERFACE.errorCode = "ERR075"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	#}
        ENDIF
        
        
	#-------------------------------------------------------------------------------
	# Converting the InstrumentDate and TranDate into the rquired formats
	#-------------------------------------------------------------------------------
	lv_a = "instdate|SELECT to_char(to_date('"+ CUST.INTERFACE.InstDate + "','DD-MM-YYYY HH24:MI:SS'),'DD-MM-YYYY HH24:MI:SS') from dual"
	print(lv_a)
	lv_b = urhk_dbSelectWithBind(lv_a)
	
	IF(lv_b == 0) THEN
	#{
		CUST.INTERFACE.InstDate = BANCS.OUTPARAM.instdate
		print(CUST.INTERFACE.InstDate)
	#}
	ENDIF

	#-------------------------------------------------------------------------------
	#
	# Fetching multirec data for the Part Transactions
	#
	#-------------------------------------------------------------------------------
	
	CUST.INTERFACE.recNum = "0"

	
	WHILE(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.AcctNum")))
	#-------------------------------------------------------------------------------
	#
	# Check on the existence of the field containing Dr/Cr Indicator
	#
	#-------------------------------------------------------------------------------
	IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.DrCrI")) != 0) THEN
		("CUST").("INTERFACE").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.DrCrI") = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.DrCrI")
	ELSE
		CUST.INTERFACE.errorCode = "ERR076"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	ENDIF


 IF(("CUST").("INTERFACE").("ICR_REQ.ptTrDtl.<rec_"+ CUST.INTERFACE.recNum + ">.DrCrI") == "D") THEN
 #{
	   #-------------------------------------------------------------------------------
	   # Check on the existence of the field containing AcctNum
	   #-------------------------------------------------------------------------------
	   IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.AcctNum")) != 0) THEN
		CUST.INTERFACE.DrAcct = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.AcctNum")
		BANCS.INPUT.mapAcctNum = CUST.INTERFACE.DrAcct

	   ELSE
		CUST.INTERFACE.errorCode = "ERR077"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	   ENDIF


	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction amount.
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TranAmt")) != 0) THEN
		CUST.INTERFACE.DrTranAmt = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TranAmt")
	  ELSE
		CUST.INTERFACE.errorCode = "ERR078"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	  ENDIF

	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction Currency Code
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrCrncy")) != 0) THEN
		CUST.INTERFACE.DrTrCrncy = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrCrncy")
	  ELSE
		CUST.INTERFACE.errorCode = "ERR079"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	  ENDIF

	  #-------------------------------------------------------------------------------
          # Check on the existence of the field containing Transaction Remarks
          #-------------------------------------------------------------------------------
          IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrRemarks")) != 0) THEN
                CUST.INTERFACE.DrRemarks = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrRemarks")
          ELSE
                CUST.INTERFACE.DrRemarks = ""
          ENDIF

	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction Particular.
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart")) != 0) THEN
		CUST.INTERFACE.DrTranPart = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart")
	  ELSE
		CUST.INTERFACE.DrTranPart = ""
	  ENDIF

	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction Particular 2.
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart2")) != 0) THEN
		CUST.INTERFACE.DrTranPart2 = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart2")
	  ELSE
		CUST.INTERFACE.DrTranPart2 = ""
	  ENDIF

 #}
 ELSE
 #{
	   #-------------------------------------------------------------------------------
	   # Check on the existence of the field containing AcctNum
	   #-------------------------------------------------------------------------------
	   IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.AcctNum")) != 0) THEN
		CUST.INTERFACE.CrAcct = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.AcctNum")

	   ELSE
		CUST.INTERFACE.errorCode = "ERR077"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	   ENDIF


	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction amount.
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TranAmt")) != 0) THEN
		CUST.INTERFACE.CrTranAmt = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TranAmt")
	  ELSE
		CUST.INTERFACE.errorCode = "ERR078"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	  ENDIF

	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction Currency Code
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrCrncy")) != 0) THEN
		CUST.INTERFACE.CrTrCrncy = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrCrncy")
	  ELSE
		CUST.INTERFACE.errorCode = "ERR079"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	  ENDIF

	  #-------------------------------------------------------------------------------
          # Check on the existence of the field containing Transaction Remarks
          #-------------------------------------------------------------------------------
          IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrRemarks")) != 0) THEN
                CUST.INTERFACE.CrRemarks = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrRemarks")
          ELSE
                CUST.INTERFACE.CrRemarks = ""
          ENDIF

	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction Particular.
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart")) != 0) THEN
		CUST.INTERFACE.CrTranPart = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart")
	  ELSE
		CUST.INTERFACE.CrTranPart = ""

	  ENDIF

	  #-------------------------------------------------------------------------------
	  # Check on the existence of the field containing Transaction Particular 2.
	  #-------------------------------------------------------------------------------
	  IF(FIELDEXISTS(("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart2")) != 0) THEN
		CUST.INTERFACE.CrTranPart2 = ("BANCS").("INPUT").("ICR_REQ.ptTrDtl.<rec_" + CUST.INTERFACE.recNum + ">.TrPart2")
	  ELSE
		CUST.INTERFACE.CrTranPart2 = ""

	  ENDIF

    #}
    ENDIF
    
	CUST.INTERFACE.recNum = CINT(CUST.INTERFACE.recNum) + CINT("1")
DO

	CUST.INTERFACE.recNum = CINT(CUST.INTERFACE.recNum)
	IF (CUST.INTERFACE.recNum != 2) THEN
	#{
		CUST.INTERFACE.errorCode = "ERR082"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	#}
	ENDIF
	
	IF(CUST.INTERFACE.DrTrCrncy != CUST.INTERFACE.CrTrCrncy) THEN
	#{
		CUST.INTERFACE.errorCode = "ERR080"
		CUST.INTERFACE.successOrFailure = "F"
				
		GOTO FINISH
	#}
	ENDIF


#trace off
