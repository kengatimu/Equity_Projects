<--start
trace on
	
	
        sv_v = "ICR_REQ.InstNum"
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_v))) THEN
	#{

		CUST.INTERFACE.InstNum =("BANCS").("INPUT").(sv_v)
	        print(CUST.INTERFACE.InstNum)
                CUST.INTERFACE.InstNum = CINT(CUST.INTERFACE.InstNum)
	
	#}
	ELSE
	#{
		CUST.INTERFACE.errorCode = "ERR071"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
