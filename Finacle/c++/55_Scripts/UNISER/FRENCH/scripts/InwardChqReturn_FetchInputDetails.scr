        ENDIF
        
        
	sv_v = "ICR_REQ.InstDate"
	IF(FIELDEXISTS(("BANCS").("INPUT").(sv_v))) THEN
	#{

		CUST.INTERFACE.InstDate =("BANCS").("INPUT").(sv_v)
