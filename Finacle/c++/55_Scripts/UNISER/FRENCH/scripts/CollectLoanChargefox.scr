	sv_s = "admratecode|select adm.RATE_CODE from tbaadm.ptt,tbaadm.adm where ptt.AMT_DERV_SRL_NUM=adm.AMT_DRV_SRL_NUM "
	sv_s = sv_s + " and  ptt.bank_id=adm.bank_id and ptt.bank_id=?SVAR and adm.bank_id=?SVAR and ptt.EVENT_TYPE =?SVAR   "
	sv_s = sv_s + " and ptt.EVENT_ID=?SVAR and adm.del_flg='N' and ptt.del_flg='N' "
