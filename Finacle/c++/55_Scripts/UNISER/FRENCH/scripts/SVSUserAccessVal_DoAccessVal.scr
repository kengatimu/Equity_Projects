<--start
trace on

CUST.INTERFACE.errorDesc = "User does not belong to the account SOL. Hence verification is not possible"
BANCS.INPARAM.BINDVARS = CUST.INTERFACE.accountID + "|" + CUST.INTERFACE.bankID + "|Y|N"
sv_s = "acctSolId|SELECT SOL_ID "
sv_s = sv_s + "FROM TBAADM.GAM "
sv_s = sv_s + "WHERE FORACID  = ?SVAR AND "
sv_s = sv_s + "BANK_ID  = ?SVAR AND ENTITY_CRE_FLG = ?SVAR AND DEL_FLG = ?SVAR"
print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
	CUST.INTERFACE.acctSolId = BANCS.OUTPARAM.acctSolId
#}
ELSE
#{
	CUST.INTERFACE.successOrFailure = "F"
	CUST.INTERFACE.errorCode = "ERR003"
	GOTO ERROREXIT
#}
ENDIF

BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userID + "|Y|N"
sv_s = "userSolId|SELECT sol_id "
sv_s = sv_s + "FROM TBAADM.UPR "
sv_s = sv_s + "WHERE user_id  = ?SVAR AND ENTITY_CRE_FLG = ?SVAR AND DEL_FLG = ?SVAR"
print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
	CUST.INTERFACE.userSolId = BANCS.OUTPARAM.userSolId
#}
ELSE
#{
	CUST.INTERFACE.successOrFailure = "F"
	CUST.INTERFACE.errorCode = "ERR009"
	GOTO ERROREXIT
#}
ENDIF

BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userID
sv_s = "cntxtSolId|SELECT CONTEXT_SOL_ID FROM (SELECT CONTEXT_SOL_ID FROM TBAADM.LGI"
sv_s = sv_s + " WHERE USER_ID = ?SVAR ORDER BY LAST_FORM_ACTIVITY_TIME DESC) WHERE ROWNUM<2"
print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
	CUST.INTERFACE.cntxtSolId = BANCS.OUTPARAM.cntxtSolId
#}
ELSE
#{
	CUST.INTERFACE.cntxtSolId = ""
#}
ENDIF
print(CUST.INTERFACE.acctSolId)
print(CUST.INTERFACE.userSolId)
print(CUST.INTERFACE.cntxtSolId)
IF((CUST.INTERFACE.acctSolId == CUST.INTERFACE.userSolId) OR (CUST.INTERFACE.acctSolId == CUST.INTERFACE.cntxtSolId)) THEN
#{
	sv_t = "SVSUserAccessVal_RES.ValStatus|S"
    sv_u = urhk_SetOrbOut(sv_t)	
#}
ELSE
#{
	sv_c = "SVSERR" + "|" + CUST.INTERFACE.errorDesc
	sv_u = urhk_SetOrbOut(sv_c)
    sv_t = "SVSUserAccessVal_RES.ValStatus|F"
	sv_u = urhk_SetOrbOut(sv_t)
#}	
ENDIF
	
#trace off
end-->
