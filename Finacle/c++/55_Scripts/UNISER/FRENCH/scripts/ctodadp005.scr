#----------------------------------------------------------------------------------------------------------
# Filename              :       ctodadp005.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to do Add functionality of the CTODA menu on submit click.
# Input                 :       Criteria page values.
# Output                :       Details page values.
# Called Script         :       ctodadp010.scr
# Calling Script        :       ctodamn006.scr
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           15-04-2013         Nitin Prabhakar   original Version          1.0
#  2           25-07-2013         Bharath   	     Modified period months to period days
#  3	       27-08-2013	  Kalvin	     Modified for TO361667  1.3
#  4	       29-08-2013	  kalvin	     Modfied for TO:370372
#-----------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="cff52ae8d51e775e773ed452b3e6b02061afea2ca06f45652b5a593576c5ea18"
	TRACE ON
	#------------------------------------------------------------------------------
	# Fetching Account details for add modes from table C_TODA
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.CTODA.accNum
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "custId,solId,schmType|"
	sv_s = sv_s + " SELECT CUST_ID,SOL_ID,SCHM_TYPE"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		CUST.CTODA.custId = ""
		CUST.CTODA.solId = ""
		CUST.CTODA.schmType = ""
		#}
	ELSE
		#{
		CUST.CTODA.custId = BANCS.OUTPARAM.custId
		print(CUST.CTODA.custId)
		CUST.CTODA.solId = BANCS.OUTPARAM.solId
		print(CUST.CTODA.solId)
		CUST.CTODA.schmType = BANCS.OUTPARAM.schmType
		print(CUST.CTODA.schmType)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	# Grant date is equal to BOD date.
	#------------------------------------------------------------------------------
	CUST.CTODA.grantDate = MID$(BANCS.STDIN.BODDate,0,10)
	print(CUST.CTODA.grantDate)
	#------------------------------------------------------------------------------
	# Caculating the Expiry Date.
	#------------------------------------------------------------------------------
	CUST.CTODA.expiryDate = CUST.CTODA.expDate
	print(CUST.CTODA.expiryDate)
	
	#------------------------------------------------------------------------------
	# Getting Permitted User Id for account scheme Type.
	#------------------------------------------------------------------------------
	CUST.INTERFACE.errorCode = TRIM(CUST.CTODA.schmType) + "_PERM_UID"
	CALL("CATOD_GetParameterDesc.scr")
	IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
	#{
		CUST.CTODA.errorMsg = "Could not fetch parameter value for " +  CUST.INTERFACE.errorCode
		CUST.CTODA.fieldName = "abc"
		CUST.CTODA.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.CTODA.permiterUser = CUST.INTERFACE.errorDesc
	print(CUST.CTODA.permiterUser)
	#----------------------------------------------------------------------------------
	# calling script to generate Availment Request Id from sequence CUSTOM.AVAIL_SEQ_GEN.
	#----------------------------------------------------------------------------------
	call("ctodadp010.scr")
	IF (CUST.CTODA.successFlg == "F") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#------------------------------------------------------------------------------
	# Inserting data into table C_TODA
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.CTODA.availReqId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.contractId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accNum
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.custId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accName
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.solId
	#BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.netTodAmount
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.availAmt
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.availPeriodMM
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "A"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.remarks
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.userId
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.userId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.grantDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.expiryDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.userId
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.userId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.bankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.chrgAmt
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "INSERT INTO CUSTOM.C_TODA"
	sv_s = sv_s + " NAME("
	sv_s = sv_s + "REQUEST_ID,SANCT_ID,ACCT_NUM,CUST_ID,ACCT_NAME,SOL_ID,REQ_AMT,PERIOD,STATUS_FLG,"
	sv_s = sv_s + "REMARKS,CREATED_BY,CREATED_DATE,"
	sv_s = sv_s + "PERMITTED_USER,GRANT_DATE,EXPIRY_DATE,"
	sv_s = sv_s + "RCRE_USER,RCRE_DATE,LCHG_USER,LCHG_DATE,EMAIL_FLG,SMS_FLG,IS_DELETED,BANK_ID,CHARGE_AMT"
	sv_s = sv_s + ") VALUES("
	
	sv_s = sv_s + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
	sv_s = sv_s + "?SVAR,SYSDATE,?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY'),TO_DATE(?SVAR,'DD-MM-YYYY'),?SVAR,SYSDATE,?SVAR,SYSDATE,"
	sv_s = sv_s + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR"
	
	sv_s = sv_s + ")"
	print(sv_s)
	sv_d = urhk_dbSQLWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		CUST.INTERFACE.errorCode = "CTODA_ERR_008"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
		CUST.CTODA.fieldName = "abc"
		CUST.CTODA.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#------------------changed for TO :361667-----------------------------#
	CALL("ctodadp017.scr")
	#------------------changed for TO :361667-----------------------------#
	#------------------changed for TO :370372-----------------------------#
	CALL("ctodadp007.scr")
	#------------------changed for TO :370372 -----------------------------#
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
