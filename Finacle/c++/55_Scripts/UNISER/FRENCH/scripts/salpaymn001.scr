	IF (lv_a == 0) THEN
	#{
		ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataOut + "~commonresultpage"
	#}
	ENDIF
	
	sv_a=urhk_SRV_GetVal("salPayDet.transactionId")
        PRINT(sv_a)

      	IF(BANCS.OUTPARAM.srvValue == "")THEN
        #{
                BANCS.OUTPUT.successOrFailure = "F"
                GOTO ENDOFSCRIPT 
        #}
        ENDIF

        CUST.SALPAY.tranid=BANCS.OUTPARAM.srvValue
