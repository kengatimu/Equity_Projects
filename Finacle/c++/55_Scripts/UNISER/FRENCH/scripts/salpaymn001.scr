	#sv_z = "10~salpaydet|vat||"
	#PRINT(sv_z)
	
	sv_g = GETPOSITION(sv_z,"~salpaydet")
	PRINT(sv_g)
	sv_n = MID$(sv_z,sv_g+10,STRLEN(sv_z))
	print(sv_n)
	
	sv_m = GETPOSITION(sv_n,"|")
	PRINT(sv_m)
	
	sv_x = MID$(sv_n,0,sv_m-1)
	PRINT(sv_x)

	BANCS.INPUT.chgrcode = TOUPPER(sv_x)
	PRINT(BANCS.INPUT.chgrcode)
	
	if(BANCS.INPUT.chgrcode == "NA")THEN
		GOTO ENDOFSCRIPT
	ENDIF

	IF (FIELDEXISTS(ONS.CUSTOM.custDataOut) == 0) THEN
	#{
		ONS.CUSTOM.custDataOut = ""
