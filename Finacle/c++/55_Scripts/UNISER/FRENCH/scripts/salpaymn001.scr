	CUST.SALPAY.failure = ""
	CUST.SALPAY.acctcrncycode = ""
	CUST.SALPAY.ChrgAmt = ""
	CUST.SALPAY.errMsg = ""

	IF(FIELDEXISTS(ONS.CUSTOM.custDataIn))THEN
