<--START
CHECKSUM="5baae99099cd3621bccbaa04cec236cc0ffab372264400239f483140cd3763dc"
	TRACE ON
		sv_a = urhk_b2k_printRepos("BANCS")
	#------------------------------------------------------------------------------
	#       Creating repository and class
