        ENDIF

        CUST.SALPAY.trandate=BANCS.OUTPARAM.srvValue
        PRINT(CUST.SALPAY.trandate)

	sv_a=urhk_SRV_GetVal("salPayDet.debitAcctNo.solId")
        PRINT(sv_a)

      	IF(BANCS.OUTPARAM.srvValue == "")THEN
        #{
                BANCS.OUTPUT.successOrFailure = "F"
                GOTO ENDOFSCRIPT 
        #}
        ENDIF

        CUST.SALPAY.solId=BANCS.OUTPARAM.srvValue
        PRINT(CUST.SALPAY.solId)

	CUST.SALPAY.chgrcode  = TRIM(BANCS.INPUT.chgrcode)
	CUST.SALPAY.chgrcode  = TOUPPER(CUST.SALPAY.chgrcode)
	#CUST.SALPAY.trandate = TRIM(BANCS.INPUT.trandate)
	CUST.SALPAY.trandate  = TOUPPER(CUST.SALPAY.trandate)
	CUST.SALPAY.trandate  = MID$(CUST.SALPAY.trandate,0,10)
	PRINT(CUST.SALPAY.trandate)
	#CUST.SALPAY.tranid = TRIM(BANCS.INPUT.tranid)
	CUST.SALPAY.tranid  = TOUPPER(CUST.SALPAY.tranid)
	CUST.GCHRG.chgrcode  = TRIM(BANCS.INPUT.chgrcode)
	CUST.GCHRG.chgrcode  = TOUPPER(CUST.GCHRG.chgrcode)
	
	
	BANCS.INPUT.moduleName = "SALPAY"
	BANCS.INPUT.parameterId = "EVENTID"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.SALPAY.eventid = BANCS.OUTPUT.parameterVal
		
		#}
	ELSE
		#{
		CUST.SALPAY.errMsg = " Evevt Id setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = ""
	sv_s = sv_s +" chrgCode|SELECT count(1) "
	sv_s = sv_s +" FROM  TBAADM.RCT "
	sv_s = sv_s +" WHERE ref_rec_type = '34' "
	sv_s = sv_s + " AND del_flg='N' "
	sv_s = sv_s + " AND bank_id= ?SVAR "
	sv_s = sv_s + " AND ref_code= ?SVAR "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.SALPAY.chgrcode
	PRINT(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d != 0) THEN
	#{
		CUST.SALPAY.errMsg = "Enter valid charge code"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF(BANCS.OUTPARAM.chrgCode == 0) THEN
		#{
			CUST.SALPAY.errMsg = "Enter valid charge code"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_u = urhk_getFileLocation("COM|salpaydp002.com")
	print(sv_u)
	print(BANCS.OUTPARAM.fileLocation)
	
	CUST.SALPAY.fileLocation = BANCS.OUTPARAM.fileLocation
	IF (sv_u == 0) THEN
	#{
		#----------------------------------------------------------------------------------
		#---    Setting Env variables
		#----------------------------------------------------------------------------------
	#	sv_a = "chgrcode|" + CUST.SALPAY.chgrcode
	#	sv_u = urhk_putEnvForCallShellScript(sv_a)
	#	PRINT(sv_u)
	#	IF (sv_u != 0) THEN
		#{
	#		CUST.SALPAY.errMsg = "Error in setting env variable fileName"
	#		GOTO ENDOFSCRIPT
		#}
	#	ENDIF
		
	#	sv_a = "trandate|" + CUST.SALPAY.trandate
	#	sv_u = urhk_putEnvForCallShellScript(sv_a)
	#	PRINT(sv_u)
	#	IF (sv_u != 0) THEN
		#{
		#	CUST.SALPAY.errMsg = "Error in setting env variable fileName"
			#GOTO ENDOFSCRIPT
		#}
		#ENDIF
		
		#sv_a = "tranid|" + CUST.SALPAY.tranid
		#sv_u = urhk_putEnvForCallShellScript(sv_a)
		#PRINT(sv_u)
		#IF (sv_u != 0) THEN
		#{
		#	CUST.SALPAY.errMsg = "Error in setting env variable fileName"
			#GOTO ENDOFSCRIPT
		#}
		#ENDIF
		
		#sv_a = "eventid|" + CUST.SALPAY.eventid
		#sv_u = urhk_putEnvForCallShellScript(sv_a)
		#PRINT(sv_u)
		#IF (sv_u != 0) THEN
		#{
			#CUST.SALPAY.errMsg = "Error in setting env variable fileName"
			#GOTO ENDOFSCRIPT
		#}
		#ENDIF
		
		#----------------------------------------------------------------------------------
		#---    Executing com file in background
		#----------------------------------------------------------------------------------
		#BANCS.INPARAM.scriptName = "salpaydp002.com"
		#BANCS.INPARAM.arguments = ""
		#sv_u = urhk_CallShellScript("b")
		#print(sv_u)

		CUST.SALPAY.com = "salpaydp002.com"
		sv_s = CUST.SALPAY.fileLocation + CUST.SALPAY.com + " " + CUST.SALPAY.chgrcode + " " + CUST.SALPAY.trandate + " " + CUST.SALPAY.tranid + " " + CUST.SALPAY.eventid
		 print(sv_s)
        sv_u = SYSTEM(sv_s + " &" )
        print (sv_u)

		IF (sv_u != 0) THEN
		#{
			CUST.SALPAY.errMsg = "Com execution failed. Please check with admin"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.SALPAY.errMsg = "Unable to load com file"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.SALPAY.errMsg != "") THEN
		#{
			print(CUST.SALPAY.errMsg)
			sv_u = urhk_setOrbOut("Error|"+CUST.SALPAY.errMsg)
			print(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_setOrbOut("Succ|Charges Collected Sucessfully. Please Check HPR.")
			print(sv_u)
			ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataOut + "|" + "Charges Collected Successfully"
		#}
