<--START
CHECKSUM="02324cb34a03663795799c4a4e33c4b8b0f11dc2d9ab39390f01662e1b9ab444"
	TRACE ON
	
	CUST.CIECLG.scriptSuccess = "Y"
	
	sv_s = "UPDATE CUSTOM.IECD SET "
	sv_s = sv_s + "CREDIT_ENTITY = ?SVAR" + ","
	sv_s = sv_s + "CR_ACCOUNT_ID = ?SVAR" + ","
	sv_s = sv_s + "INSTRMNT_ENTITY = ?SVAR" + ","
	sv_s = sv_s + "INSTRMNT_ALPHA = ?SVAR" + ","
	sv_s = sv_s + "INSTRMNT_DATE = TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_s = sv_s + "INSTRMNT_NUM = ?SVAR" + ","
	sv_s = sv_s + "INSTRMNT_AMT = ?SVAR" + ","
	sv_s = sv_s + "INSTRMNT_BANK_CODE = ?SVAR" + ","
	sv_s = sv_s + "INSTRMNT_BR_CODE = ?SVAR" + ","
	sv_s = sv_s + "INSTRMNT_SORT_CODE = ?SVAR" + ","
	sv_s = sv_s + "CHARGE_EVENT_ID = ?SVAR" + ","
	sv_s = sv_s + "CHARGE_AMT = ?SVAR" + ","
	sv_s = sv_s + "CHARGE_CRNCY_CODE = ?SVAR" + ","
	sv_s = sv_s + "VALUE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_s = sv_s + "TARGET_ZONE_CODE = ?SVAR" + ","
	sv_s = sv_s + "TARGET_SOL_ID = ?SVAR" + ","
	sv_s = sv_s + "BANK_CODE = ?SVAR" + ","
	sv_s = sv_s + "BR_CODE = ?SVAR" + ","
	sv_s = sv_s + "SORT_CODE = ?SVAR" + ","
	sv_s = sv_s + "NOSTRO_ACCOUNT_ID = ?SVAR" + ","
	sv_s = sv_s + "VOSTRO_ACCOUNT_ID = ?SVAR" + ","
	sv_s = sv_s + "PAYING_ACCOUNT_ID = ?SVAR" + ","
	sv_s = sv_s + "TRAN_PARTICULAR = ?SVAR" + ","
	sv_s = sv_s + "TRAN_RMKS = ?SVAR" + ","
	sv_s = sv_s + "LCHG_USER_ID = ?SVAR" + ","
	sv_s = sv_s + "LCHG_TIME = sysdate"
	sv_s = sv_s + " WHERE ZONE_CODE = ?SVAR"
	sv_s = sv_s + " AND ZONE_DATE = to_date(?SVAR,'DD-MM-YYYY')"
	sv_s = sv_s + " AND SOL_ID = ?SVAR"
	sv_s = sv_s + " AND TRIM(SET_NUM) = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND REVERSE_FLG = 'N'"
	
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.creditEntity		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.crAcctNum		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentEntity		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentAlpha		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentDate		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentNum		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentAmt		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentBankCode       + "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentBranchCode     + "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.instrumentSortCode       + "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.chargeEventId		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.chargeAmt		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.chargeAmtCcy		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.valueDate		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.targetZoneCode		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.targetSolId		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.defaultBankCode		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.defaultBranchCode	+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.defaultSortCode		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.nostroAcct		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.vostroAcct		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.payingAcct		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.tranParticular		+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.tranRmks			+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId			+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.zoneCode			+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.zoneDate			+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId			+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + CUST.CIECLG.setNum			+ "|"
	BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
