#------------------------------------------------------------------------------------------------
#  Name            : ebOdaDmdGenT.scr 
#  Description     : Tran
#  Date            : 03-04-2020
#  Author          : Vino Palani
#  Menu Option     : Agent Demand Generation 
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             03-04-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON
if(repexists("MTT")==0)then
	createrep("MTT")
endif
if(repexists("EBSRV")==0)then
	createrep("EBSRV")
endif
if(classexists("EBSRV","GLBDATA")==0)then
	createclass("EBSRV","GLBDATA",5)
endif
if(classexists("MTT","TranDetails")==0)then
	createclass("MTT","TranDetails",5)
endif
if(classexists("MTT","PartTranDetails")==0)then
	createclass("MTT","PartTranDetails",5)
endif
EBSRV.GLBDATA.MTTTranId = ""
MTT.TranDetails.TranDateDiff    = "0"
MTT.TranDetails.TranType        = "T"
MTT.TranDetails.TranSubType     = "CI"
MTT.TranDetails.IgnoreExcp      = "I"
MTT.TranDetails.Consolidate     = "N"
MTT.TranDetails.PostFlag        = "Y"
#MTT.TranDetails.ReversalFlg     = "Y"
MTT.TranDetails.PrintAdviceInd  = "B"
####MTT.TranDetails.TranIdOnline="Y"
MTT.TranDetails.Remarks         = "Agent Demand Satisfy OD"
##BANCS.INPARAM.PostTranFlg="Y"
##BANCS.INPARAM.CommitFlg="Y"
##BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
##BANCS.INPARAM.ErrorCheckForLuw="Y"
##BANCS.INPARAM.CheckExceptions="N"
##BANCS.INPARAM.InsertTranWithValidnFlg="Y"
#sv_r = urhk_MTTS_Initialize("")
#print(sv_r)
sv_a = urhk_MTTS_PopulateInputDetails("")
print(sv_a)
if(sv_a==0)then
                EBSRV.GLBDATA.trSting = MTT.InputDetails.Argument1
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.drAcct  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.drAcct)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.crAcct  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.crAcct)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdAmt  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdAmt)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdsrlNum  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdsrlNum)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdAcct  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdAcct)
                #--
                EBSRV.GLBDATA.drBalance = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.drBalance)

else
	EBSRV.GLBDATA.drAcct   = "" 
	EBSRV.GLBDATA.crAcct   = "" 
	EBSRV.GLBDATA.dmdAmt   = "" 
	EBSRV.GLBDATA.dmdsrlNum = ""
	EBSRV.GLBDATA.dmdAcct  = "" 
	EBSRV.GLBDATA.drBalance = ""
endif
print(EBSRV.GLBDATA.drAcct)
sv_b = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.drAcct)
if(sv_b == 0) then
         EBSRV.GLBDATA.drclBalance= BANCS.OUTPARAM.ClearBalance
else
	EBSRV.GLBDATA.drclBalance = 0 
endif
print(EBSRV.GLBDATA.drclBalance)
if(cdouble(EBSRV.GLBDATA.drclBalance)<=0)then
	exitscript
endif

sv_r = urhk_MTTS_DefineTransaction("BGAMORT")
print(sv_r)

IF (sv_r != 0)THEN
        MTT.Error.Description = "Error encountered in Define Transaction"
        sv_r = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ENDIF
#Creation of Debit leg
MTT.PartTranDetails.Account             = EBSRV.GLBDATA.drAcct 
MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode 
MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode 
MTT.PartTranDetails.Particulars         = "Dmd Dr For: " + EBSRV.GLBDATA.crAcct 
if(cdouble(EBSRV.GLBDATA.drclBalance)>= cdouble(EBSRV.GLBDATA.dmdAmt))then
	MTT.PartTranDetails.RefAmount           = -(cdouble(EBSRV.GLBDATA.dmdAmt))
	MTT.PartTranDetails.Amount              = -(cdouble(EBSRV.GLBDATA.dmdAmt))
else
	MTT.PartTranDetails.RefAmount           = -(cdouble(EBSRV.GLBDATA.drclBalance))
	MTT.PartTranDetails.Amount              = -(cdouble(EBSRV.GLBDATA.drclBalance))
endif
MTT.PartTranDetails.Refnum              = EBSRV.GLBDATA.dmdsrlNum 
MTT.PartTranDetails.RateCode            = ""
MTT.PartTranDetails.Rate                = "" 
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "N"
MTT.PartTranDetails.ReportCode  	= "AGNTDMD"
MTT.PartTranDetails.ValueDateDiff       = "0"
MTT.PartTranDetails.Remarks             = EBSRV.GLBDATA.crAcct 
MTT.PartTranDetails.PstFlg              = "Y"
sv_r = urhk_MTTS_DefinePartTran("AMORT")
print(sv_r)
IF (sv_r!=0)THEN
        MTT.Error.Description = "Unable to define debit part tran"
        sv_r = urhk_MTTS_ReportErrorCondition("DEBIT")
        goto VAYU
ENDIF
# Creation of credit leg
MTT.PartTranDetails.Account             = EBSRV.GLBDATA.crAcct 
MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode 
MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode 
MTT.PartTranDetails.Particulars         = "Dmd Cr For: " + EBSRV.GLBDATA.drAcct  
if(cdouble(EBSRV.GLBDATA.drclBalance)>= cdouble(EBSRV.GLBDATA.dmdAmt))then
	MTT.PartTranDetails.RefAmount           = cdouble(EBSRV.GLBDATA.dmdAmt)
	MTT.PartTranDetails.Amount              = cdouble(EBSRV.GLBDATA.dmdAmt)
else
	MTT.PartTranDetails.RefAmount           = cdouble(EBSRV.GLBDATA.drclBalance)
	MTT.PartTranDetails.Amount              = cdouble(EBSRV.GLBDATA.drclBalance)
endif
MTT.PartTranDetails.Refnum              = EBSRV.GLBDATA.dmdsrlNum 
MTT.PartTranDetails.RateCode            = ""
MTT.PartTranDetails.Rate                = "" 
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "N"
MTT.PartTranDetails.ReportCode  	= "AGNTDMD"
MTT.PartTranDetails.ValueDateDiff       = "0"
MTT.PartTranDetails.Remarks             = EBSRV.GLBDATA.drAcct 
MTT.PartTranDetails.PstFlg              = "Y"

sv_t = urhk_MTTS_DefinePartTran("AMORT1")
print(sv_t)
IF(sv_t!=0)THEN
        MTT.Error.Description = "Unable to define credit part tran"
        sv_t = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ENDIF
#Tran Status
MTT.Error.Description   = ""
BANCS.INPUT.TranStatus  = "S"
sv_r = urhk_MTTS_EndDefinition("")
print(sv_r)
##sv_p = urhk_MTTS_HandleExceptions("POST")
##print(sv_p)
IF(sv_r!=0)THEN
        MTT.Error.Description = "Unable to end definition"
        sv_r = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ELSE
        EBSRV.GLBDATA.MTTTranId = BANCS.OUTPARAM.MTTTranId
        print(EBSRV.GLBDATA.MTTTranId)
        goto VAYU
ENDIF
sv_r = urhk_MTTS_Close("")
print(sv_r)

VAYU:
	if(EBSRV.GLBDATA.MTTTranId!="")then
		sv_d = "update custom.agddt set tot_adj_amt=tot_adj_amt+ ?NVAR,"
		sv_d = sv_d + " last_adj_date=to_date(?SVAR,'DD-MM-RR'),free_text2=?SVAR "	
		sv_d = sv_d + " where bank_id=?SVAR and foracid=?SVAR  and dep_srl_num=?SVAR " 
		if(cdouble(EBSRV.GLBDATA.drclBalance)>= cdouble(EBSRV.GLBDATA.dmdAmt))then
			BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.dmdAmt + "|" +mid$(BANCS.STDIN.BODDate,0,10) + "|" + EBSRV.GLBDATA.MTTTranId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.dmdAcct + "|" + EBSRV.GLBDATA.dmdsrlNum
		else
			BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.drclBalance + "|" +mid$(BANCS.STDIN.BODDate,0,10)+ "|" + EBSRV.GLBDATA.MTTTranId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.dmdAcct + "|" + EBSRV.GLBDATA.dmdsrlNum
		endif
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlWithBind(sv_d)
		if(sv_u==0)then
			sv_u = urhk_dbSqlWithBind("commit")
			print(sv_u)
		endif
	endif

exitscript
TRACE OFF
END-->

