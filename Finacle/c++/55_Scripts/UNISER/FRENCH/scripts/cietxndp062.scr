	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.acctNumEntityId = BANCS.OUTPARAM.acctNumEntityId
		print(CUST.CIETXN.acctNumEntityId)
		
		IF(CUST.CIETXN.txnType == "TF")THEN
