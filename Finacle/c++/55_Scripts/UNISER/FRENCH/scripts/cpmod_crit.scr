								GOTO FINISH
								#}
							ELSE
								#{
								lv_p="moduleId,moduleDesc|SELECT MODULE_ID,MODULE_DESC FROM CUSTOM.MODULE_DETAILS"
								lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID =?SVAR"
								lv_p=lv_p + " AND DEL_FLG='N'"
								print(lv_p)
								BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
								print(BANCS.INPARAM.BINDVARS)
								
								lv_q = urhk_dbSelectWithBind(lv_p)
								
								IF(lv_q==0) THEN
								#{
									CUST.CPMOD.moduleId=BANCS.OUTPARAM.moduleId
									CUST.CPMOD.moduleDesc=BANCS.OUTPARAM.moduleDesc
									
									lv_u=urhk_SetOrbOut("moduleId|" +CUST.CPMOD.moduleId)
									lv_u=urhk_SetOrbOut("moduleDesc|" +CUST.CPMOD.moduleDesc)
									lv_z=urhk_SetOrbOut("SuccessOrFailure|Y")
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
						#}
					ELSE
						#{
						IF(CUST.CPMOD.modcount!=0) THEN
						#{
							PRINT("IN MOD TABLE")
							IF(CUST.CPMOD.funccode=="M") THEN
							#{
								lv_p="moduleId,moduleDesc|"
								lv_p=lv_p + "SELECT MODULE_ID,MODULE_DESC"
								lv_p=lv_p + " FROM CUSTOM.MODULEDET_MOD"
								lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
								lv_p=lv_p + " AND DEL_FLG='N'"
								print(lv_p)
								BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
								print(BANCS.INPARAM.BINDVARS)
								
								lv_q=urhk_dbSelectWithBind(lv_p)
								
								IF(lv_q==0) THEN
								#{
									CUST.CPMOD.moduleId=BANCS.OUTPARAM.moduleId
									CUST.CPMOD.moduleDesc=BANCS.OUTPARAM.moduleDesc
									
									#------------------------------------------------------------------------------#
									#Only same user can modify the data
									#------------------------------------------------------------------------------#
									lv_u=urhk_SetOrbOut("moduleId|" +CUST.CPMOD.moduleId)
									lv_u=urhk_SetOrbOut("moduleDesc|" +CUST.CPMOD.moduleDesc)
									lv_z=urhk_SetOrbOut("SuccessOrFailure|Y")
								#}
								ENDIF
							#}
							ENDIF
							#}
						ELSE
							#{
							print("in main table")
							IF((CUST.CPMOD.funccode=="A") OR (CUST.CPMOD.funccode=="M")) THEN
							#{
								print(CUST.CPMOD.funccode)
								lv_p="moduleId,moduleDesc|SELECT MODULE_ID,MODULE_DESC FROM CUSTOM.MODULE_DETAILS"
								lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID =?SVAR"
								lv_p=lv_p + " AND DEL_FLG='N'"
								print(lv_p)
								BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
								print(BANCS.INPARAM.BINDVARS)
								
								lv_q = urhk_dbSelectWithBind(lv_p)
								
								IF(lv_q==0) THEN
								#{
									CUST.CPMOD.moduleId=BANCS.OUTPARAM.moduleId
									CUST.CPMOD.moduleDesc=BANCS.OUTPARAM.moduleDesc
									
									lv_u=urhk_SetOrbOut("moduleId|" +CUST.CPMOD.moduleId)
									lv_u=urhk_SetOrbOut("moduleDesc|" +CUST.CPMOD.moduleDesc)
									lv_z=urhk_SetOrbOut("SuccessOrFailure|Y")
								#}
								ENDIF
							#}
