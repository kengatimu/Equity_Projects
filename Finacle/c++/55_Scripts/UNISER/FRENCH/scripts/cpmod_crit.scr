					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#------------------------------------------------------------------------------#
	#If the funcCode is for verify,check in main table for its existence
	#------------------------------------------------------------------------------#
	
	IF(CUST.CPMOD.funcCode=="V") THEN
	#{
		lv_s="count|"
		lv_s=lv_s + "SELECT COUNT(*)"
		lv_s=lv_s + " FROM CUSTOM.MODULE_DETAILS"
		lv_s=lv_s + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
		print(BANCS.INPARAM.BINDVARS)
		
		lv_d=urhk_dbSelectWithBind(lv_s)
		
		
		CUST.CPMOD.count=BANCS.OUTPARAM.count
		print(CUST.CPMOD.count)
		IF(CUST.CPMOD.count==0) THEN
		#{
			lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
			lv_t = urhk_SetOrbOut("Error_1|ERROR:^"+"Record does not exist"+"^moduleId")
			GOTO FINISH
			#}
		ELSE
			#{
			lv_s="lastuserid,encflg,delflg|"
			lv_s=lv_s + "SELECT LCHG_USER_ID,ENTITY_CRE_FLG,DEL_FLG FROM CUSTOM.MODULE_DETAILS"
			lv_s=lv_s + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
			print(BANCS.INPARAM.BINDVARS)
			
			lv_d=urhk_dbSelectWithBind(lv_s)
			
			print(lv_d)
			CUST.CPMOD.lstusrid=BANCS.OUTPARAM.lastuserid
			print(CUST.CPMOD.lstusrid)
			
			CUST.CPMOD.encflg=BANCS.OUTPARAM.encflg
			print(CUST.CPMOD.encflg)
			
			CUST.CPMOD.delflg=BANCS.OUTPARAM.delflg
			print(CUST.CPMOD.delflg)
		#}
		ENDIF
		#------------------------------------------------------------------------------#
		#Check entity creation flag to check whether it is already verified or not
		#------------------------------------------------------------------------------#
		
		IF(CUST.CPMOD.encflg=="N") THEN
		#{
			lv_p="moduleId,moduleDesc|"
			lv_p=lv_p + "SELECT MODULE_ID,MODULE_DESC"
			lv_p=lv_p + " FROM CUSTOM.MODULE_DETAILS"
			lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
			print(lv_p)
