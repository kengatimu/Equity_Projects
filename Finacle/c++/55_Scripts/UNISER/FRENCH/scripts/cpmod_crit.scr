						#}
					ELSE
						#{
						lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
						lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"Verification pending for moduleId"+"^moduleId")
						GOTO FINISH
					#}
					ENDIF
				#}
				ENDIF
				#}
			ELSE
				#{
				
				lv_p="funccode|"
				lv_p=lv_p + "SELECT FUNC_CODE"
				lv_p=lv_p + " FROM TBAADM.ADT"
				lv_p=lv_p + " WHERE TABLE_NAME=?SVAR"
				lv_p=lv_p + " AND BANK_ID=?SVAR"
				lv_p=lv_p + " AND TABLE_KEY=?SVAR"
				lv_p=lv_p + " AND AUDIT_DATE=(SELECT MAX(AUDIT_DATE) FROM TBAADM.ADT"
				lv_p=lv_p + " WHERE TABLE_NAME=?SVAR"
				lv_p=lv_p + " AND BANK_ID=?SVAR"
				lv_p=lv_p + " AND TABLE_KEY=?SVAR)"
				print(lv_p)
				BANCS.INPARAM.BINDVARS = CUST.CPMOD.table + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CPMOD.table_key
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CPMOD.table + "|" + BANCS.STDIN.contextBankId
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CPMOD.table_key
				print(BANCS.INPARAM.BINDVARS)
				
				lv_q=urhk_dbSelectWithBind(lv_p)
				
				print(lv_q)
				IF(lv_p==0) THEN
				#{
					CUST.CPMOD.funccode=BANCS.OUTPARAM.funccode
					print(CUST.CPMOD.funccode)
					IF(CUST.CPMOD.funccode=="D") THEN
					#{
						lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
						lv_t = urhk_SetOrbOut("Error_1|ERROR:^"+"Verfication pending for Module Id in audit table"+"^moduleId")
						GOTO FINISH
					#}
					ENDIF
					
					IF(CUST.CPMOD.encflg=="N") THEN
					#{
						PRINT("IN MAIN TABLE")
						IF((CUST.CPMOD.funccode=="A") OR (CUST.CPMOD.funccode=="M")) THEN
						#{
							PRINT(CUST.CPMOD.funccode)
							IF(CUST.CPMOD.lstusrid!=BANCS.STDIN.userId) THEN
							#{
								lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
