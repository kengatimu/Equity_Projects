	#-------------------------------------------------------------------------------------#
	#If funcCode is A then check whether the given module id already present in the table
	#-------------------------------------------------------------------------------------#
	
	IF(CUST.CPMOD.funcCode=="A") THEN
	#{
		print("Add new Module")
		
		IF(CINT(CUST.CPMOD.count)==0) THEN
		#{
			lv_z=urhk_SetOrbOut("SuccessOrFailure|Y")
			GOTO FINISH
			#}
		ELSE
			#{
			lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
			lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"Module Id already exist"+"^moduleId")
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	#------------------------------------------------------------------------------#
	#Checking whether the funcCode is for inquire,modify,delete or cancel
	#------------------------------------------------------------------------------#
	
	IF((CUST.CPMOD.funcCode=="I")OR(CUST.CPMOD.funcCode=="M")OR(CUST.CPMOD.funcCode=="D")OR(CUST.CPMOD.funcCode=="X")) THEN
	#{
		
		#------------------------------------------------------------------------------#
		#Checking whether the record is present in the main table or not
		#------------------------------------------------------------------------------#
		
		
		IF(CUST.CPMOD.count==0) THEN
		#{
			lv_t = urhk_SetOrbOut("Error_1|ERROR:^"+"Record does not exist"+"^moduleId")
			lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO FINISH
		#}
		ENDIF
		IF(CINT(CUST.CPMOD.count)!=0) THEN
		#{
			
			#------------------------------------------------------------------------------#
			#If the funcCode is for inquire,delete or cancel
			#------------------------------------------------------------------------------#
			
			IF(CUST.CPMOD.funcCode!="M") THEN
			#{
				
				IF(CUST.CPMOD.funcCode=="D") THEN
				#{
					
					#--------------------------------------------------------------------------------------------#
					#If record is present in the mod table ,then verification is pending,else validate lastuserid
					#aginst current userid ,if both are not equal then delete the entry from main table
					#--------------------------------------------------------------------------------------------#
					
					print("IN DELETE MODE")
					BANCS.INPARAM.BINDVARS = ""
					
					IF(CUST.CPMOD.modcount!=0) THEN
					#{
						lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
						lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"verification pending"+"^moduleId")
						#}
					ELSE
						#{
						print("IN DELETE MODE")
						lv_p="moduleId,moduleDesc|"
						lv_p=lv_p + "SELECT MODULE_ID,MODULE_DESC"
						lv_p=lv_p + " FROM CUSTOM.MODULE_DETAILS"
						lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
						lv_p=lv_p + " AND ENTITY_CRE_FLG='Y'"
						lv_p=lv_p + " AND DEL_FLG='N'"
						print(lv_p)
						BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
						print(BANCS.INPARAM.BINDVARS)
						
						lv_q=urhk_dbSelectWithBind(lv_p)
						
						print(lv_q)
						IF(lv_q==0) THEN
						#{
							CUST.CPMOD.moduleId=BANCS.OUTPARAM.moduleId
							CUST.CPMOD.moduleDesc=BANCS.OUTPARAM.moduleDesc
							
							lv_u=urhk_SetOrbOut("moduleId|" +CUST.CPMOD.moduleId)
							lv_u=urhk_SetOrbOut("moduleDesc|" +CUST.CPMOD.moduleDesc)
							lv_z=urhk_SetOrbOut("SuccessOrFailure|Y")
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				
				IF(CUST.CPMOD.funcCode=="X") THEN
				#{
					IF(CUST.CPMOD.modcount!=0) THEN
					#{
						#--------------------------------------------------------------------------------#
						#If present in mod table then check for lastuserid in mod table
						#--------------------------------------------------------------------------------#
						
						IF(CUST.CPMOD.modlastusrid==BANCS.STDIN.userId) THEN
						#{
							lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
							lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"Same user cannot cancel"+"^moduleId")
							GOTO FINISH
							#}
						ELSE
							#{
							lv_p="moduleId,moduleDesc|"
							lv_p=lv_p + "SELECT MODULE_ID,MODULE_DESC"
							lv_p=lv_p + " FROM CUSTOM.MODULEDET_MOD"
							lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
							lv_p=lv_p + " AND DEL_FLG='N'"
							print(lv_p)
							BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
							print(BANCS.INPARAM.BINDVARS)
							
							lv_q=urhk_dbSelectWithBind(lv_p)
							
							IF(lv_q==0) THEN
							#{
								CUST.CPMOD.moduleId=BANCS.OUTPARAM.moduleId
								CUST.CPMOD.moduleDesc=BANCS.OUTPARAM.moduleDesc
								
								lv_u=urhk_SetOrbOut("moduleId|" +CUST.CPMOD.moduleId)
								lv_u=urhk_SetOrbOut("moduleDesc|" +CUST.CPMOD.moduleDesc)
								lv_z=urhk_SetOrbOut("SuccessOrFailure|Y")
							#}
							ENDIF
						#}
						ENDIF
						#}
					ELSE
						#{
						IF(CUST.CPMOD.count!=0) THEN
						#{
							#--------------------------------------------------------------------------------#
							#Validation of lastuserid and currentuserid in main table
							#--------------------------------------------------------------------------------#
							
							IF(CUST.CPMOD.lstusrid==BANCS.STDIN.userId) THEN
							#{
								lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
								lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"Same user cannot cancel"+"^moduleId")
								GOTO FINISH
								#}
							ELSE
								#{
								print("IN CANCEL MODE")
								lv_p="moduleId,moduleDesc|"
								lv_p=lv_p + "SELECT MODULE_ID,MODULE_DESC"
								lv_p=lv_p + " FROM CUSTOM.MODULE_DETAILS"
								lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
								lv_p=lv_p + " AND ENTITY_CRE_FLG='N'"
								lv_p=lv_p + " AND DEL_FLG='N'"
								print(lv_p)
								BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
								print(BANCS.INPARAM.BINDVARS)
								
								lv_q=urhk_dbSelectWithBind(lv_p)
								
								print(lv_q)
								IF(lv_q==0) THEN
								#{
									CUST.CPMOD.moduleId=BANCS.OUTPARAM.moduleId
									CUST.CPMOD.moduleDesc=BANCS.OUTPARAM.moduleDesc
									
									lv_u=urhk_SetOrbOut("moduleId|" +CUST.CPMOD.moduleId)
									lv_u=urhk_SetOrbOut("moduleDesc|" +CUST.CPMOD.moduleDesc)
									lv_z=urhk_SetOrbOut("SuccessOrFailure|Y")
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				
				IF(CUST.CPMOD.funcCode=="I") THEN
				#{
					print("IN INQUIRE MODE")
					IF(CUST.CPMOD.modcount==0) THEN
					#{
						IF(CUST.CPMOD.encflg=="Y") THEN
						#{
							lv_p="moduleId,moduleDesc|"
							lv_p=lv_p + "SELECT MODULE_ID,MODULE_DESC"
							lv_p=lv_p + " FROM CUSTOM.MODULE_DETAILS"
							lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
							lv_p=lv_p + " AND ENTITY_CRE_FLG='Y'"
							lv_p=lv_p + " AND DEL_FLG='N'"
							print(lv_p)
							BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
