# Title                 :   Customization for requirement OPS-0185
# Description           :   This script gets called from dormant.mrt to upade a column of a table
#                       :
# Modification History  :
# <Serial No.>      <Date>          <Author Name>       <Description>
# 		1           15-05-2013       Samrat saha          Original version
#		2	    03-06-2013       Samrat saha          Added Entity id in query
#----------------------------------------------------------------------------------------------
<--START
CHECKSUM="5f25a9b5d0ec9fb53f2f58f671ad395948d9ead8e3a48c950c6dbbbaa532f854"
	TRACE ON
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","OPS0185") == 0) THEN
	#{
		CREATECLASS("CUST","OPS0185",5)
	#}
	ENDIF
	
	#============================================================================*
	# Below INPUTS are passed from MRT
	#============================================================================*
	print(BANCS.INPUT.mrtForacid)
	CUST.OPS0185.mrtForacid  = BANCS.INPUT.mrtForacid
	
	#============================================================================*
	# Below OUTPUT are sent back to MRT
	#============================================================================*
	BANCS.OUTPUT.setDesc = "updated"
	
	#============================================================================*
	# Updating the table SVSUSER.SIGNMAINTENANCE column to  'N'
	#============================================================================*
	sv_s =""
	sv_s = sv_s + " UPDATE SVSUSER.SIGNMAINTENANCE"
	sv_s = sv_s + " SET SIGNMAINTENANCE.active ='N'"
	sv_s = sv_s + " WHERE SIGNMAINTENANCE.signid IN "
	sv_s = sv_s + 								" (SELECT SIGNOTHERINFO.signid"
	sv_s = sv_s +								" FROM SVSUSER.SIGNOTHERINFO"
	sv_s = sv_s +								" WHERE SIGNOTHERINFO.acctid=?SVAR"
	sv_s = sv_s +								" AND   SIGNOTHERINFO.entityid=?SVAR)"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS	= ""
	BANCS.INPARAM.BINDVARS	= BANCS.INPARAM.BINDVARS + CUST.OPS0185.mrtForacid + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSQLWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d==0)THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		PRINT(sv_d)
		#}
	ELSE
		#{
		exitscript
	#}
	ENDIF
	
	TRACE OFF
END-->
