#CUST.INTERFACE.accountID = BANCS.INPUT.CustomerID 

print(CUST.INTERFACE.customerID)

#sv_s = " Memos |select  memos  from custom.c_mop unpivot ( Memos   for state_code in ("MSG_TEXT_4", " 
#sv_s = sv_s + " "MSG_TEXT_1","MSG_TEXT_2","MSG_TEXT_3","MSG_TEXT_5","MSG_TEXT_6","MSG_TEXT_7","MSG_TEXT_8") )  "
#sv_s = sv_s + " where foracid =?SVAR  and del_flg ='N' and bank_id = ?SVAR and (memos !=' ' or memos !='') order by  state_code "
sv_s = " Memos | select MSG_TEXT_1 from (select MSG_TEXT_1 from custom.c_mop where foracid  =?SVAR and del_flg ='N' union select MSG_TEXT_2 from custom.c_mop where foracid  =?SVAR and del_flg ='N' union "
sv_s = sv_s + " select MSG_TEXT_3 from custom.c_mop where foracid  =?SVAR and del_flg ='N' union select MSG_TEXT_4 from custom.c_mop where foracid  =?SVAR and del_flg ='N' union "
sv_s = sv_s + " select MSG_TEXT_5 from custom.c_mop where foracid  =?SVAR and del_flg ='N' union select MSG_TEXT_6 from custom.c_mop where foracid  =?SVAR and del_flg ='N' union "
sv_s = sv_s + " select MSG_TEXT_7 from custom.c_mop where foracid  =?SVAR and del_flg ='N' union select MSG_TEXT_8 from custom.c_mop where foracid  =?SVAR ) where MSG_TEXT_1 ! =' ' "
print(sv_s)
BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.customerID
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbCursorOpenWithBind(sv_s)
if(sv_d == 0)then
	sv_c = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_c)
	sv_z = urhk_dbCursorFetch(sv_c)
	sv_q = 0
	while(sv_z == 0)
		sv_q = sv_q + 1
		sv_v = "Memos_" + FORMAT$(sv_q, "%d")
		print(sv_v)
                ("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.Memos

		sv_z = urhk_dbCursorFetch(sv_c)
	DO
	sv_z = urhk_dbCursorClose(sv_c)
	CUST.INTERFACE.accountCount = sv_q
	print(CUST.INTERFACE.accountCount)
endif
sv_q = 0 
print(sv_q)
print(CINT(CUST.INTERFACE.accountCount))
WHILE(sv_q < CINT(CUST.INTERFACE.accountCount))
	sv_q = sv_q + 1

	sv_v = "Memos_" + FORMAT$(sv_q, "%d")
	#sv_v = "Memos_" + sv_q
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.Memos.<rec_" + FORMAT$(sv_q,"%d") + ">.Memo| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

print(sv_q)
#sv_q = sv_q + 1
print(sv_q)
#}
DO

