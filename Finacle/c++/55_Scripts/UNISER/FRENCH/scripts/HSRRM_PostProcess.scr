<--start
#trace on

#---------------------------------------------------------------------
# To populate the Default Language and current Language along with
# description in the searcher page
#---------------------------------------------------------------------
sv_b = BANCS.INPUT.title
sv_c = BANCS.INPUT.gender
sv_g = BANCS.STDIN.contextBankId
sv_d = "langCode | (select crmuser.func_getlangmapping((select base_lang_code from GCT where bank_id = ?NVAR)) from dual)"
sv_z = "baseLang|(select crmuser.func_getlangmapping((select base_lang_code from GCT where bank_id = ?SVAR)) from dual)"
BANCS.INPARAM.BINDVARS = sv_g
sv_a =  urhk_dbSelectWithBind (sv_z)
if (fieldexists(BANCS.OUTPARAM.baseLang)) then
	sv_f = BANCS.OUTPARAM.baseLang
else
	sv_f = ""
endif
sv_a = urhk_dbSelectWithBind(sv_d)
if (fieldexists(BANCS.OUTPARAM.langCode)) then
	BANCS.OUTPUT.langCode = BANCS.OUTPARAM.langCode
else
	BANCS.OUTPARAM.langCode = " "
endif
#--------------------------------------------------------------------------
# Getting the salutation value corresponding to lang_code format 
#--------------------------------------------------------------------------
if(sv_b != "") then
	sv_d = "title| select crmuser.fn_categorylookup(?SVAR,'PERSONSALUTATION',?NVAR,?NVAR) from dual"
	BANCS.INPARAM.BINDVARS= sv_b + "|" + BANCS.OUTPUT.langCode + "|" + sv_g
	sv_a = urhk_dbSelectWithBind(sv_d)
	if (fieldexists(BANCS.OUTPARAM.title)) then
		BANCS.OUTPUT.title = BANCS.OUTPARAM.title
	else
	BANCS.OUTPUT.title = " "
	endif
endif

#--------------------------------------------------------------------------
# Getting the gender value corresponding to lang_code format 
#--------------------------------------------------------------------------
if(sv_c != "") then
	sv_e = "gender| select crmuser.fn_categorylookup(?SVAR,'GENDER',?NVAR,?NVAR) from dual"
	BANCS.INPARAM.BINDVARS= sv_c + "|" + BANCS.OUTPUT.langCode + "|" + sv_g
	sv_a = urhk_dbSelectWithBind(sv_e)
	if (fieldexists(BANCS.OUTPARAM.gender)) then
		BANCS.OUTPUT.gender = BANCS.OUTPARAM.gender
	else
		BANCS.OUTPUT.gender = " " 
	endif
endif

#trace off
end-->
