###########################################################################################
<--START
CHECKSUM="b458c522fe280742f0b87dd0937b1498c51080c3ab044d8a2685d5e1e3141520"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIECLG Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIECLG")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIECLG",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	sv_u = urhk_b2k_printrepos("BANCS")
	
	CUST.CIECLG.crAcctNum = " "
	CUST.CIECLG.crAcctNumEntityId = " "
	CUST.CIECLG.instrumentEntity = " "
	CUST.CIECLG.targetEntity = " "
	CUST.CIECLG.errorFlg = "N"
	CUST.CIECLG.errorMsg = " "
	CUST.CIECLG.chargeAmt = " "
	CUST.CIECLG.chargeAmtFlg = "N"
	CUST.CIECLG.chargeAmtCcy = " "
	CUST.CIECLG.chargeAmtCcyFlg = "N"
	CUST.CIECLG.chargeEventId = " "
	CUST.CIECLG.chargeEventIdFlg = "N"
	CUST.CIECLG.nostroAcct = " "
	CUST.CIECLG.nostroAcctFlg = "N"
	CUST.CIECLG.vostroAcct = " "
	CUST.CIECLG.vostroAcctFlg = "N"
	CUST.CIECLG.targetZoneCode = " "
	CUST.CIECLG.targetZoneCodeFlg = "N"
	CUST.CIECLG.targetSolId = " "
	CUST.CIECLG.targetSolIdFlg = "N"
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.crAcctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.crAcctNum) != "")THEN
		#{
			CUST.CIECLG.crAcctNum = TOUPPER(TRIM(BANCS.INPUT.crAcctNum))
			print(CUST.CIECLG.crAcctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.crAcctNumEntityId))THEN
	#{
		IF(TRIM(BANCS.INPUT.crAcctNumEntityId) != "")THEN
		#{
			CUST.CIECLG.crAcctNumEntityId = TOUPPER(TRIM(BANCS.INPUT.crAcctNumEntityId))
			print(CUST.CIECLG.crAcctNumEntityId)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentEntity) != "")THEN
		#{
			CUST.CIECLG.instrumentEntity = TOUPPER(TRIM(BANCS.INPUT.instrumentEntity))
			print(CUST.CIECLG.instrumentEntity)
		#}
		ENDIF
	#}
	ENDIF
	
	IF((CUST.CIECLG.crAcctNumEntityId == CUST.CIECLG.instrumentEntity) AND (CUST.CIECLG.crAcctNumEntityId == BANCS.STDIN.contextBankId))THEN
	#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Both Credit Account ID AND Instrument belong to Init Entity. Please use HOCTM Menu;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(TRIM(CUST.CIECLG.instrumentEntity) == "")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CIECLG.crAcctNumEntityId == BANCS.STDIN.contextBankId)THEN
	#{
		CUST.CIECLG.targetEntity = CUST.CIECLG.instrumentEntity
		#}
	ELSE
		#{
		CUST.CIECLG.targetEntity = CUST.CIECLG.crAcctNumEntityId
	#}
	ENDIF
	
	###########################################################################################
	# Get the Charge Event Id
	###########################################################################################
	
	CUST.CIECLG.parameterId = "CL_CHRG_EVT_ID_" + CUST.CIECLG.targetEntity
	print(CUST.CIECLG.parameterId)
	
	sv_s = "chargeEventId|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = CUST.CIECLG.errorMsg + "  " + "Charge Event Id not set in CPARAM;"
		GOTO NOSTRO
	#}
	ENDIF
	
	CUST.CIECLG.chargeEventId = BANCS.OUTPARAM.chargeEventId
	print(CUST.CIECLG.chargeEventId)
	
	CUST.CIECLG.chargeEventIdFlg = "Y"
	
	CUST.CIECLG.chargeAmtCcy = BANCS.STDIN.homeCrncyCode
	print(CUST.CIECLG.chargeAmtCcy)
	###########################################################################################
	# Get the Charge Amt
	###########################################################################################
	
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|C")
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|CR")
	sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" +CUST.CIECLG.chargeEventId)
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" +CUST.CIECLG.chargeAmtCcy)
	sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.CIECLG.chargeAmtCcy)
	sv_u = urhk_SetUrhkOut("genChrgDtl.calcAmt|calcAmt")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltGenChrgDtl|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = CUST.CIECLG.errorMsg + "  " + "Unable to get Charge Details;"
		GOTO NOSTRO
	#}
	ENDIF
	
	CUST.CIECLG.calcAmt = BANCS.OUTPARAM.calcAmt
	print(CUST.CIECLG.calcAmt)
	
	sv_p = GETPOSITION(CUST.CIECLG.calcAmt,"|")
	print(sv_p)
	
	IF(sv_p > 0)THEN
	#{
		sv_a = MID$(CUST.CIECLG.calcAmt,0,sv_p-1)
		print(sv_a)
		CUST.CIECLG.chargeAmt = sv_a
		print(CUST.CIECLG.chargeAmt)
		
		sv_c = MID$(CUST.CIECLG.calcAmt,sv_p,3)
		print(sv_c)
		CUST.CIECLG.chargeAmtCcy = sv_c
		print(CUST.CIECLG.chargeAmtCcy)
		#}
	ELSE
		#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = CUST.CIECLG.errorMsg + "  " + "Unable to get Charge Details;"
		GOTO NOSTRO
	#}
	ENDIF
	
	CUST.CIECLG.chargeAmtFlg = "Y"
	CUST.CIECLG.chargeAmtCcyFlg = "Y"
	
	###########################################################################################
	# Get the Nostro Account Id
	###########################################################################################
	
	NOSTRO:
		CUST.CIECLG.parameterId = "CL_NOSTRO_" + CUST.CIECLG.targetEntity
		print(CUST.CIECLG.parameterId)
		
		sv_s = "nostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIECLG.errorFlg = "Y"
			CUST.CIECLG.errorMsg = CUST.CIECLG.errorMsg + "  " + "Nostro Account Id not set in CPARAM;"
			GOTO VOSTRO
		#}
		ENDIF
		
		CUST.CIECLG.nostroAcct = BANCS.OUTPARAM.nostroAcct
		print(CUST.CIECLG.nostroAcct)
		
		CUST.CIECLG.nostroAcctFlg = "Y"
		
		###########################################################################################
		# Get the Vostro Account Id
		###########################################################################################
		
	VOSTRO:
		CUST.CIECLG.parameterId = "CL_VOSTRO_" + CUST.CIECLG.targetEntity
		print(CUST.CIECLG.parameterId)
		
		sv_s = "vostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIECLG.errorFlg = "Y"
			CUST.CIECLG.errorMsg = CUST.CIECLG.errorMsg + "  " + "Vostro Account Id not set in CPARAM;"
			GOTO ZONECODE
		#}
		ENDIF
		
		CUST.CIECLG.vostroAcct = BANCS.OUTPARAM.vostroAcct
		print(CUST.CIECLG.vostroAcct)
		
		CUST.CIECLG.vostroAcctFlg = "Y"
		
		###########################################################################################
		# Get the Target Zone Code
		###########################################################################################
		
	ZONECODE:
		CUST.CIECLG.parameterId = "TARGET_ZONE_CODE_" + CUST.CIECLG.targetEntity
		print(CUST.CIECLG.parameterId)
		
		sv_s = "targetZoneCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIECLG.errorFlg = "Y"
			CUST.CIECLG.errorMsg = CUST.CIECLG.errorMsg + "  " + "Target Zone Code is not set in CPARAM;"
			GOTO SOLID
		#}
		ENDIF
		
		CUST.CIECLG.targetZoneCode = BANCS.OUTPARAM.targetZoneCode
		print(CUST.CIECLG.targetZoneCode)
		
		CUST.CIECLG.targetZoneCodeFlg = "Y"
		
		###########################################################################################
		# Get the Target Sol Id
		###########################################################################################
		
	SOLID:
		CUST.CIECLG.parameterId = "TARGET_SOL_ID_" + CUST.CIECLG.targetEntity
		print(CUST.CIECLG.parameterId)
		
		sv_s = "targetSolId|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIECLG.errorFlg = "Y"
			CUST.CIECLG.errorMsg = CUST.CIECLG.errorMsg + "  " + "Target Sol Id is not set in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIECLG.targetSolId = BANCS.OUTPARAM.targetSolId
		print(CUST.CIECLG.targetSolId)
		
		CUST.CIECLG.targetSolIdFlg = "Y"
		
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIECLG.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIECLG.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmt|"+CUST.CIECLG.chargeAmt)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmtFlg|"+CUST.CIECLG.chargeAmtFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmtCcy|"+CUST.CIECLG.chargeAmtCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmtCcyFlg|"+CUST.CIECLG.chargeAmtCcyFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeEventId|"+CUST.CIECLG.chargeEventId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeEventIdFlg|"+CUST.CIECLG.chargeEventIdFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("nostroAcct|"+CUST.CIECLG.nostroAcct)
		print(sv_u)
		sv_u = urhk_SetOrbOut("nostroAcctFlg|"+CUST.CIECLG.nostroAcctFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("vostroAcct|"+CUST.CIECLG.vostroAcct)
		print(sv_u)
		sv_u = urhk_SetOrbOut("vostroAcctFlg|"+CUST.CIECLG.vostroAcctFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetZoneCode|"+CUST.CIECLG.targetZoneCode)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetZoneCodeFlg|"+CUST.CIECLG.targetZoneCodeFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetSolId|"+CUST.CIECLG.targetSolId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetSolIdFlg|"+CUST.CIECLG.targetSolIdFlg)
		print(sv_u)
		
		
END-->
