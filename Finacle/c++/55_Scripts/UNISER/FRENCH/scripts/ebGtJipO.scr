<--start
trace on
#reps
	sv_r = repexists("EQSRV")
	if(sv_r == 0)then
		createrep("EQSRV")
	endif
	sv_c = classexists("EQSRV","GLBDATA")
	if (sv_c == 0) then
		createclass("EQSRV","GLBDATA",5)
	endif
#inp/out
	if(fieldexists(BANCS.INPUT.cifId)==1)then
		EQSRV.GLBDATA.cifId	= BANCS.INPUT.cifId 
	else
		EQSRV.GLBDATA.cifId	= ""
	endif
	if(fieldexists(BANCS.INPUT.jipangeCode)==1)then
		EQSRV.GLBDATA.schmCode	= BANCS.INPUT.jipangeCode 
	else
		EQSRV.GLBDATA.schmCode	= ""
	endif
	if(fieldexists(BANCS.INPUT.sourceAcct)==1)then
		EQSRV.GLBDATA.freeText1	= BANCS.INPUT.sourceAcct 
	else
		EQSRV.GLBDATA.freeText1	= ""
	endif
	if(fieldexists(BANCS.INPUT.durationMnths)==1)then
		EQSRV.GLBDATA.freeText2	= BANCS.INPUT.durationMnths 
	else
		EQSRV.GLBDATA.freeText2	= "0"
	endif
	if(fieldexists(BANCS.INPUT.durationDays)==1)then
		EQSRV.GLBDATA.freeText3	= BANCS.INPUT.durationDays 
	else
		EQSRV.GLBDATA.freeText3	= "0"
	endif

	if(fieldexists(BANCS.INPUT.payoutDays)==1)then
		EQSRV.GLBDATA.freeText4	= BANCS.INPUT.payoutDays 
	else
		EQSRV.GLBDATA.freeText4	= "0"
	endif
	if(fieldexists(BANCS.INPUT.freeTxt1)==1)then
		EQSRV.GLBDATA.freeText5	= BANCS.INPUT.freeTxt1 
		EQSRV.GLBDATA.freeTexts5 = EQSRV.GLBDATA.freeText5
	else
		EQSRV.GLBDATA.freeText5	= ""
	endif
	if(fieldexists(BANCS.INPUT.freeTxt2)==1)then
		EQSRV.GLBDATA.mobileNumber	= BANCS.INPUT.freeTxt2 
	else
		EQSRV.GLBDATA.mobileNumber	= "XXXXXXXXXX"
	endif
	if(fieldexists(BANCS.INPUT.freeTxt3)==1)then
		EQSRV.GLBDATA.freeText9	= BANCS.INPUT.freeTxt3 
	else
		EQSRV.GLBDATA.freeText9	= ""
	endif

	EQSRV.GLBDATA.acctRptCode  	= "SBJRP"
	EQSRV.GLBDATA.acctTurnoverDetFlg = "N"
	EQSRV.GLBDATA.relativeFlg       = "N"
	EQSRV.GLBDATA.allowSweeps       = "N"
	EQSRV.GLBDATA.pbpscode		= "N"
	EQSRV.GLBDATA.langCode		= "INFENG"
	EQSRV.GLBDATA.langName		= "ENGLISH"
	EQSRV.GLBDATA.ecsEnabled	= "N"
	EQSRV.GLBDATA.schmType		= "SBA"
	EQSRV.GLBDATA.intPaidFlg	= "Y"
	EQSRV.GLBDATA.intCrAcctFlgCode	= "S"
	EQSRV.GLBDATA.intCollFlg	= "N"
	EQSRV.GLBDATA.wtaxAmtScopeFlg   = "P"
	EQSRV.GLBDATA.wtaxflgCode 	= "N"
	EQSRV.GLBDATA.wtaxlvlFlgCode    = "S"
	EQSRV.GLBDATA.wtaxPcnt 		= "0"
	EQSRV.GLBDATA.peggedFlg		= "N"
	EQSRV.GLBDATA.nextIntRunDateCr	= BANCS.STDIN.BODDate
	EQSRV.GLBDATA.peginDays  	= "0"
	EQSRV.GLBDATA.peginMths  	= "0"
	EQSRV.GLBDATA.pegReviewDate 	= "31-12-2099 00:00:00"
	EQSRV.GLBDATA.custCrPrefPcnt	= "0"
	EQSRV.GLBDATA.chanCrPrefPcnt	= "0"
	EQSRV.GLBDATA.acctCrPrefPcnt	= "0"
	EQSRV.GLBDATA.limitExpDate	= ""
	EQSRV.GLBDATA.srvYN	= ""
	EQSRV.GLBDATA.Onforacid	= ""
	EQSRV.GLBDATA.Onvforacid	= ""
#validation
	print(EQSRV.GLBDATA.schmCode)
	#sv_u = urhk_getSchemeDetailsInRepository(EQSRV.GLBDATA.schmCode)
	#if ( sv_u != 0 ) then
	#	EQSRV.GLBDATA.valerr	=	"SchemeCode is Invalid to Open Account"
		#EQSRV.GLBDATA.srvYN	= "N"
		#goto VAYU
#	else
#		EQSRV.GLBDATA.intPaidFlg	=	BANCS.OUTPARAM.InterestPaidFlg
#		EQSRV.GLBDATA.intCollFlg = 	BANCS.OUTPARAM.InterestCollectedFlg
#		EQSRV.GLBDATA.StaffSchemeFlg = 	BANCS.OUTPARAM.StaffSchemeFlg
#		EQSRV.GLBDATA.NreFlg	=	BANCS.OUTPARAM.NRE_SchemeFlg
#		EQSRV.GLBDATA.FcnrFlg	=	BANCS.OUTPARAM.IsFCNR
#		EQSRV.GLBDATA.SchmChqYN	=	BANCS.OUTPARAM.SchmChequeAllowed
#		EQSRV.GLBDATA.schmType	=	BANCS.OUTPARAM.SchemeType
#	endif
	##EQSRV.GLBDATA.intPaidFlg	= "N"	
	EQSRV.GLBDATA.intCollFlg =  "N"	
	EQSRV.GLBDATA.StaffSchemeFlg =  "N"	
	EQSRV.GLBDATA.NreFlg	= "N"	
	EQSRV.GLBDATA.FcnrFlg	= "N"
	EQSRV.GLBDATA.SchmChqYN	= "N"
	EQSRV.GLBDATA.schmType	= "SBA"
	sv_s = "gmcnt,srcifId,srcSolId | select count(*),cif_id,sol_id from tbaadm.gam where foracid= '" +EQSRV.GLBDATA.freeText1+ "' "
	sv_s = sv_s + " and bank_id='"+ BANCS.STDIN.contextBankId +"' group by cif_id,sol_id"
	print(sv_s)
	sv_u = urhk_dbSelectWithBind(sv_s)
	if(sv_u==0)then
		EQSRV.GLBDATA.gmcnt = BANCS.OUTPARAM.gmcnt
		EQSRV.GLBDATA.srcifId = BANCS.OUTPARAM.srcifId
		EQSRV.GLBDATA.srcSolId = BANCS.OUTPARAM.srcSolId
	else
		EQSRV.GLBDATA.gmcnt	= 0
		EQSRV.GLBDATA.srcifId	= ""
		EQSRV.GLBDATA.srcSolId	= ""
	endif
	if(EQSRV.GLBDATA.gmcnt<=0)then
		EQSRV.GLBDATA.valerr	=	"Source Account is Invalid " + EQSRV.GLBDATA.freeText1
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	print(EQSRV.GLBDATA.cifId)
	print(EQSRV.GLBDATA.srcifId)
	if(EQSRV.GLBDATA.srcifId != EQSRV.GLBDATA.cifId )then
		EQSRV.GLBDATA.valerr	= "CifId Mismatch between source account and jipange request"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	print(EQSRV.GLBDATA.freeText5)
	if(EQSRV.GLBDATA.freeText5 =="")then
		EQSRV.GLBDATA.valerr	= "Tag Value Must be OCT/APR freeTxt1"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	if((EQSRV.GLBDATA.freeText5 != "APR") and (EQSRV.GLBDATA.freeText5!="OCT"))then
		EQSRV.GLBDATA.valerr	= "Tag Value Must be OCT/APR freeTxt1"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	if(EQSRV.GLBDATA.freeTexts5 =="")then
		EQSRV.GLBDATA.valerr	= "Tag Value Must be OCT/APR freeTxt1"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	if((EQSRV.GLBDATA.freeTexts5 != "APR") and (EQSRV.GLBDATA.freeTexts5!="OCT"))then
		EQSRV.GLBDATA.valerr	= "Tag Value Must be OCT/APR freeTxt1"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	sv_u = "aprCnt | select count(*) from tbaadm.gac,tbaadm.gam where gam.acid=gac.acid "
	sv_u = sv_u + " and gam.bank_id=?SVAR  and gac.bank_id=?SVAR " 
	sv_u = sv_u + " and gam.cif_id ='"+ EQSRV.GLBDATA.cifId +"' "
	sv_u = sv_u + " and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acct_cls_flg<>'Y' " 
	sv_u = sv_u + " and gam.schm_type='SBA' and gam.schm_code='"+EQSRV.GLBDATA.schmCode+"' "
	sv_u = sv_u + " and gac.free_text_7 is not null "
	sv_u = sv_u + " and gac.free_text_8 is null "
	##sv_u = sv_u + " and gac.free_text_7 like '%APR%' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	sv_u = urhk_dbSelectWithBind(sv_u)
	if(sv_u ==0)then
		EQSRV.GLBDATA.aprCnt	= BANCS.OUTPARAM.aprCnt
	else
		EQSRV.GLBDATA.aprCnt	= "0" 
	endif
	sv_u = "OctCnt | select count(*) from tbaadm.gac,tbaadm.gam where gam.acid=gac.acid "
	sv_u = sv_u + " and gam.bank_id=?SVAR  and gac.bank_id=?SVAR " 
	sv_u = sv_u + " and gam.cif_id ='"+ EQSRV.GLBDATA.cifId +"' "
	sv_u = sv_u + " and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acct_cls_flg='N' " 
	sv_u = sv_u + " and gam.schm_type='SBA' and gam.schm_code='"+EQSRV.GLBDATA.schmCode+"' "
	sv_u = sv_u + " and gac.free_text_8 is not null "
	sv_u = sv_u + " and gac.free_text_7 is  null "
	##sv_u = sv_u + " and gac.free_text_8 like '%OCT%' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	sv_u = urhk_dbSelectWithBind(sv_u)
	if(sv_u ==0)then
		EQSRV.GLBDATA.OctCnt	= BANCS.OUTPARAM.OctCnt
	else
		EQSRV.GLBDATA.OctCnt	= "0" 
	endif
	if((cint(EQSRV.GLBDATA.aprCnt)>=1) and (cint(EQSRV.GLBDATA.OctCnt)>=1))then
		EQSRV.GLBDATA.valerr	=	"Jipange Account exists for both April/October Bonuses"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	if((cint(EQSRV.GLBDATA.aprCnt)>=1)  and (EQSRV.GLBDATA.freeText5=="APR"))then
		EQSRV.GLBDATA.valerr	=	"Jipange Account exists for April" 
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
	if((cint(EQSRV.GLBDATA.OctCnt)>=1)  and (EQSRV.GLBDATA.freeText5=="OCT"))then
		EQSRV.GLBDATA.valerr	=	"Jipange Account exists for October" 
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif

	sv_d = left$(BANCS.STDIN.BODDate,10)
	print(sv_d)
	sv_y = mid$(sv_d,8,10)
	print(sv_y)
	sv_m = mid$(sv_d,3,2)
	print(sv_m)
	if(cdouble(sv_m)<=4)then
		EQSRV.GLBDATA.aprSal = "APR" +sv_y
	else
		EQSRV.GLBDATA.aprSal    = ""
	endif
	if((cdouble(sv_m) >= 3) and (cdouble(sv_m) <=10))then
		EQSRV.GLBDATA.octSal = "OCT" +sv_y
	else
		EQSRV.GLBDATA.octSal    = ""
	endif
	sv_u = "jpCnt | select count(*) "
	##sv_u = sv_u + ",gac.acid,gac.free_text_7,gac.free_text_8 "
	sv_u = sv_u + " from tbaadm.gam,tbaadm.gac "
	sv_u = sv_u + " where gam.cif_id ='"+ EQSRV.GLBDATA.cifId +"' and gam.bank_id ='"+ BANCS.STDIN.contextBankId +"' "
	sv_u = sv_u + " and gam.acid = gac.acid and gam.bank_id = gac.bank_id "
	sv_u = sv_u + " and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acct_cls_flg='N' "
	sv_u = sv_u + " and gam.schm_type='SBA' and gam.schm_code='"+EQSRV.GLBDATA.schmCode+"' "
##	if(EQSRV.GLBDATA.aprSal !="")then
##		sv_u = sv_u + " and (gac.free_text_7 ='"+EQSRV.GLBDATA.aprSal+"' or gac.free_text_7 is null) "
##	endif
##	if(EQSRV.GLBDATA.octSal !="")then
##		sv_u = sv_u + " and (gac.free_text_8 ='"+EQSRV.GLBDATA.octSal+"' or gac.free_text_8 is null) "
##	endif
##	sv_u = sv_u + " group by gac.acid,gac.free_text_7,gac.free_text_8 "
	print(sv_u)
	sv_u = urhk_dbSelectWithBind(sv_u)
	if(sv_u ==0)then
		EQSRV.GLBDATA.jpCnt	= BANCS.OUTPARAM.jpCnt
		##EQSRV.GLBDATA.jpAcid	= BANCS.OUTPARAM.jpAcid
		##EQSRV.GLBDATA.aprVal	= BANCS.OUTPARAM.aprVal
		##EQSRV.GLBDATA.octVal	= BANCS.OUTPARAM.octVal
	else
		EQSRV.GLBDATA.jpCnt	= 0
		##EQSRV.GLBDATA.jpAcid	= "" 
		##EQSRV.GLBDATA.aprVal	= "" 
		##EQSRV.GLBDATA.octVal	= "" 
	endif
	##if((EQSRV.GLBDATA.jpCnt==0) and (EQSRV.GLBDATA.aprSal !="") and (EQSRV.GLBDATA.octSal==""))then
	##	EQSRV.GLBDATA.freeText7	= EQSRV.GLBDATA.aprSal 
	##else
	##	EQSRV.GLBDATA.freeText7 = ""
	##endif
	##if((EQSRV.GLBDATA.jpCnt==0) and (EQSRV.GLBDATA.aprSal =="") and (EQSRV.GLBDATA.octSal!=""))then
	##	EQSRV.GLBDATA.freeText8	= EQSRV.GLBDATA.octSal 
	##else
	##	EQSRV.GLBDATA.freeText8 = ""
	##endif
	##if((EQSRV.GLBDATA.jpCnt==1) and (EQSRV.GLBDATA.aprSal =="") and (EQSRV.GLBDATA.octSal!="") and (EQSRV.GLBDATA.octVal!=""))then
	##	EQSRV.GLBDATA.valerr	=	"Jipange Account exists for Oct Bonuses"
	##	EQSRV.GLBDATA.srvYN	= "N"
		##goto VAYU
	##endif
	##if((EQSRV.GLBDATA.jpCnt==1) and (EQSRV.GLBDATA.aprSal !="") and (EQSRV.GLBDATA.octSal=="") and (EQSRV.GLBDATA.aprVal!=""))then
	##	EQSRV.GLBDATA.valerr	=	"Jipange Account exists for April Bonuses"
	##	EQSRV.GLBDATA.srvYN	= "N"
		##goto VAYU
	##endif
	##if((cdouble(EQSRV.GLBDATA.jpCnt)>=2) and (EQSRV.GLBDATA.aprSal !="") and (EQSRV.GLBDATA.octSal!="") and (EQSRV.GLBDATA.aprVal!="") and(EQSRV.GLBDATA.octVal!=""))then
	if(cdouble(EQSRV.GLBDATA.jpCnt)>=2)then 
		EQSRV.GLBDATA.valerr	=	"Jipange Account exists for both April/October Bonuses"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif

	sv_s = "glSubHeadCode,crncyCode,intTblCode,acctRptCode,wtaxflgCode,wtaxPcnt,MaxIntPcntCr,MinIntPcntCr | "
	sv_s = sv_s + " select gss.gl_sub_head_code,csp.crncy_code,csp.int_tbl_code,csp.acct_rpt_code,csp.wtax_flg,csp.wtax_pcnt, "
	sv_s = sv_s + " csp.max_int_pcnt_cr,csp.min_int_pcnt_cr "
	sv_s = sv_s + " from  tbaadm.csp,tbaadm.gss "
	sv_s = sv_s + " where csp.schm_code=gss.schm_code and gss.default_flg = 'Y'"
	sv_s = sv_s + " and exists (select 1 from tbaadm.ssp where bank_id='"+ BANCS.STDIN.contextBankId +"' and del_flg='N' "
	sv_s = sv_s + " and crncy_code=csp.crncy_code and schm_code=csp.schm_code and schm_code = gss.schm_code) "
	sv_s = sv_s + " and csp.schm_code = '"+EQSRV.GLBDATA.schmCode+"' " 
	sv_s = sv_s + " and gss.del_flg='N' and gss.bank_id='"+ BANCS.STDIN.contextBankId +"' "
	sv_s = sv_s + " and csp.crncy_code='KES' "
	sv_s = sv_s + " and csp.del_flg='N' and csp.bank_id='"+ BANCS.STDIN.contextBankId +"' " 
	print(sv_s)
	sv_u = urhk_dbSelectWithBind(sv_s)
	if ( sv_u != 0 ) then
		EQSRV.GLBDATA.valerr	=	"SchemeCode is Invalid to Open Account"
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
		EQSRV.GLBDATA.glSubHeadCode	=	BANCS.OUTPARAM.glSubHeadCode
		EQSRV.GLBDATA.crncyCode		=	BANCS.OUTPARAM.crncyCode
		EQSRV.GLBDATA.intTblCode		=	BANCS.OUTPARAM.intTblCode
		EQSRV.GLBDATA.acctRptCode	=	BANCS.OUTPARAM.acctRptCode
		EQSRV.GLBDATA.wtaxflgCode	=	BANCS.OUTPARAM.wtaxflgCode
		EQSRV.GLBDATA.wtaxPcnt		=	BANCS.OUTPARAM.wtaxPcnt
		EQSRV.GLBDATA.MaxIntPcntCr	=	BANCS.OUTPARAM.MaxIntPcntCr
		EQSRV.GLBDATA.MinIntPcntCr	=	BANCS.OUTPARAM.MinIntPcntCr
	sv_u = "solId | select primary_sol_id from crmuser.cmg where cif_id = '"+ EQSRV.GLBDATA.cifId +"' " 
	sv_u = sv_u + " and entity_cre_flg='Y' and del_flg='N' and bank_id= '"+ BANCS.STDIN.contextBankId +"'  "
	sv_u = urhk_dbSelectWithBind(sv_u)	
	if(sv_u==0)then
		EQSRV.GLBDATA.solId	= BANCS.OUTPARAM.solId 
	else
		EQSRV.GLBDATA.solId	= ""
	endif
#ContextSol
	print(BANCS.STDIN.mySolId)
	print(EQSRV.GLBDATA.solId)
	print(EQSRV.GLBDATA.srcSolId)
	if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.srcSolId ) then
		sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.srcSolId)
		sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
		if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
			print(BANCS.OUTPARAM.successOrFailure)
			sv_s = BANCS.OUTPARAM.successOrFailure
		else
			sv_s = "X"
		endif
		if (( sv_u != 0 ) and ( sv_s != "S"))then
			EQSRV.GLBDATA.valerr	=	"CCS Failed"
			EQSRV.GLBDATA.srvYN	= "N"
			goto VAYU
		endif
	endif
#FiledMapInp
	sv_u = urhk_SetUrhkInp("acctCriteria.custId.cifId|" +EQSRV.GLBDATA.cifId)
	sv_u = urhk_SetUrhkInp("acctCriteria.schmCode.schmCode|" +EQSRV.GLBDATA.schmCode)
	sv_u = urhk_SetUrhkInp("acctCriteria.schmCode.schmType|SBA")
	sv_u = urhk_SetUrhkInp("acctCriteria.crncyCode.crncyCode|" +EQSRV.GLBDATA.crncyCode)
	sv_u = urhk_SetUrhkInp("acctCriteria.solId.solId|" +EQSRV.GLBDATA.srcSolId)
	sv_u = urhk_SetUrhkInp("acctCriteria.glSubHeadCode.glSubHeadCode|" +EQSRV.GLBDATA.glSubHeadCode)
	sv_u = urhk_SetUrhkInp("acctCriteria.glSubHeadCode.solId|" +EQSRV.GLBDATA.srcSolId)
	sv_u = urhk_SetUrhkInp("acctCriteria.glSubHeadCode.crncyCode|" +EQSRV.GLBDATA.crncyCode)
#output
	sv_u = urhk_SetUrhkOut("acctCriteria.custId.custTitleCode|custTitleCode")
	sv_u = urhk_SetUrhkOut("acctCriteria.custId.custName|custName")
	sv_u = urhk_SetUrhkOut("acctCriteria.custId.custShortName|custShortName")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.acctName|acctName")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.acctShortName|acctShortName")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.acctOpnDate|acctOpnDate")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.acctRptCode|acctRptCode")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.cashExcpAmtLim|cashExcpAmtLim")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.cashCrExcpAmtLim|cashCrExcpAmtLim")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.clgExcpAmtLim|clgExcpAmtLim")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.clgCrExcpAmtLim|clgCrExcpAmtLim")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.xferExcpAmtLim|xferExcpAmtLim")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.xferCrExcpAmtLim|xferCrExcpAmtLim")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctBasic.acctTurnoverDetFlg|acctTurnoverDetFlg")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctCustInfo.servChrgCollFlg|servChrgCollFlg")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctCustInfo.relativeFlg|relativeFlg")
	sv_u = urhk_SetUrhkOut("dfltSBAcctDtl.acctCommonInfo.acctGeneralInfo.acctCustInfo.pbPsCode.code|pbpscode")
