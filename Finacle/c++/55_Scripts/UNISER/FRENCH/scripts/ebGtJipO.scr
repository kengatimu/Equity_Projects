					BANCS.STDIN.inp3 = cint(BANCS.STDIN.inp1) + cint(BANCS.STDIN.inp2)
					print(BANCS.STDIN.inp3)
					EQSRV.GLBDATA.actualfrmDate = "01-10-" +BANCS.STDIN.inp3+ " 00:00:00"	
					print(EQSRV.GLBDATA.actualfrmDate)
				endif
			endif
			if(EQSRV.GLBDATA.freeTexts5=="APR")then
				sv_d = left$(BANCS.STDIN.BODDate,10)
				print(sv_d)
				sv_y = mid$(sv_d,6,10)
				print(sv_y)
				sv_m = mid$(sv_d,3,2)
				print(sv_m)
				if(cint(sv_m)<=4)then
					EQSRV.GLBDATA.actualfrmDate = "01-04-" +sv_y+ " 00:00:00"	
					print(EQSRV.GLBDATA.actualfrmDate)
				endif
				if(cint(sv_m)>4)then
					BANCS.STDIN.inp1=sv_y
					BANCS.STDIN.inp2="1"
					BANCS.STDIN.inp3 = cint(BANCS.STDIN.inp1) + cint(BANCS.STDIN.inp2)
					print(BANCS.STDIN.inp3)
					EQSRV.GLBDATA.actualfrmDate = "01-04-" +BANCS.STDIN.inp3+ " 00:00:00"	
					print(EQSRV.GLBDATA.actualfrmDate)
				endif
			endif
			EQSRV.GLBDATA.newDate = (EQSRV.GLBDATA.actualfrmDate + "|" + EQSRV.GLBDATA.freeText2 + "|" + EQSRV.GLBDATA.freeText3)
			print(EQSRV.GLBDATA.newDate)
			sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.newDate)
			print(sv_u)
			if(sv_u != 0)then
				EQSRV.GLBDATA.goalExpiryDate = LEFT$(BANCS.STDIN.BODDate,10)
				print(EQSRV.GLBDATA.goalExpiryDate)
			else
				EQSRV.GLBDATA.goalExpiryDate = BANCS.OUTPARAM.MODIFIED_DATE
				print(EQSRV.GLBDATA.goalExpiryDate)
			endif
		endif
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText10|" + EQSRV.GLBDATA.goalExpiryDate ) 
	#for goal Mobile Number 
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText11|" + EQSRV.GLBDATA.mobileNumber) 
	#Goal Start Date 
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText12|" + EQSRV.GLBDATA.actualfrmDate )
	#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText13
	#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText14
	#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText15

	sv_u = urhk_SetUrhkOut("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|foracid")
	print(sv_u)
	sv_u = urhk_ExecSrvNoCommit("SRV_OpenSBAcct|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
	print(sv_u)
	if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
		print(BANCS.OUTPARAM.successOrFailure)
		sv_s = BANCS.OUTPARAM.successOrFailure
	else
		sv_s = "X"
	endif
	if (( sv_u == 0 ) and ( sv_s=="S") ) then
		EQSRV.GLBDATA.Onforacid	=	BANCS.OUTPARAM.foracid
		print(EQSRV.GLBDATA.Onforacid)
		EQSRV.GLBDATA.valerr	= "Jipange Account Opend Successfully!,Yet To Vaerify"
		EQSRV.GLBDATA.srvYN	= "Y"
	else
		EQSRV.GLBDATA.Onforacid	= ""
		callscriptifexist("ebsrvHandler.scr")
		EQSRV.GLBDATA.valerr	=	EQSRV.GLBDATA.SrvError	
		EQSRV.GLBDATA.srvYN	= "N"
		goto VAYU
	endif
#verify
	if(EQSRV.GLBDATA.Onforacid!="")then
                sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|"+EQSRV.GLBDATA.Onforacid)
                sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId|"+EQSRV.GLBDATA.srcSolId)
                sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctCrncyCode.crncyCode|"+EQSRV.GLBDATA.crncyCode)
                print(sv_a)
                sv_a = urhk_SetUrhkOut("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|foracid")
                sv_s = urhk_ExecSrv("SRV_FetchSBAcctOpenDtlForVerify|same_user_verify = Y|retain_all_output = Y|ignore_excp_flg=Y")
                print(sv_s)
                sv_a = urhk_CopyOutToIn("")
                Print(sv_a)
                sv_a = urhk_SetUrhkOut("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|foracid")
                sv_s = urhk_ExecSrvNoCommit("SRV_VerifySBAcct|same_user_verify = Y|retain_all_output = Y|ignore_excp_flg=Y")
                Print(sv_s)
                EQSRV.GLBDATA.Onvforacid=BANCS.OUTPARAM.foracid
                print(EQSRV.GLBDATA.Onvforacid)
                if((EQSRV.GLBDATA.Onvforacid!= "") and ( sv_s  == "0") and ( BANCS.OUTPARAM.successOrFailure != "F")) then
                        print(EQSRV.GLBDATA.Onvforacid)
			##print(EQSRV.GLBDATA.freeText7)
			##if(EQSRV.GLBDATA.freeText7 !="")then
			if(EQSRV.GLBDATA.freeTexts5 =="APR")then
				EQSRV.GLBDATA.valerr	=	"APR : Jipange Account Opend and Authenticated Successfully"
			endif
			##print(EQSRV.GLBDATA.freeText8)
			##if(EQSRV.GLBDATA.freeText8 !="")then
			if(EQSRV.GLBDATA.freeTexts5 =="OCT")then
				EQSRV.GLBDATA.valerr	=	"OCT : Jipange Account Opend and Authenticated Successfully"
			endif
			EQSRV.GLBDATA.srvYN	= "Y"
			goto VAYU
		else
				if(fieldexists(BANCS.OUTPARAM.Warning_num) != 0) then
        				print(BANCS.OUTPARAM.Warning_num)
					sv_x = BANCS.OUTPARAM.Warning_num
				endif
				if(fieldexists(BANCS.OUTPARAM.Xcpn_num) != 0) then
					print(BANCS.OUTPARAM.Xcpn_num)
					sv_x = BANCS.OUTPARAM.Xcpn_num
                                endif
				sv_e = 0
				while ( sv_e <= sv_x) 
				print(sv_x)
				print(sv_e)
				sv_a = urhk_CopyOutToIn("")
				print(sv_a)
				sv_a = urhk_SetUrhkOut("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|foracid")
				sv_s = urhk_ExecSrvNoCommit("SRV_VerifySBAcct|same_user_verify = Y|retain_all_output = Y|ignore_excp_flg=Y")
				if(sv_s == 0) then
					EQSRV.GLBDATA.Onvforacid=BANCS.OUTPARAM.foracid
					print(EQSRV.GLBDATA.Onvforacid)
					##print(EQSRV.GLBDATA.freeText7)
					##if(EQSRV.GLBDATA.freeText7 !="")then
					if(EQSRV.GLBDATA.freeTexts5 =="APR")then
						EQSRV.GLBDATA.valerr	=	"APR : Jipange Account Opend and Authenticated Successfully"
					endif
					##print(EQSRV.GLBDATA.freeText8)
					##if(EQSRV.GLBDATA.freeText8 !="")then
					if(EQSRV.GLBDATA.freeTexts5 =="OCT")then
						EQSRV.GLBDATA.valerr	=	"OCT : Jipange Account Opend and Authenticated Successfully"
					endif
					EQSRV.GLBDATA.srvYN	= "Y"
					goto VAYU
				endif
				sv_e = sv_e +1
				print(sv_e)
				do
                endif
	else
		EQSRV.GLBDATA.valerr = "Jipange Account Open Failed "
		EQSRV.GLBDATA.srvYN	= "Y"
		goto VAYU
	endif
VAYU:
	print(EQSRV.GLBDATA.valerr)
	print(EQSRV.GLBDATA.srvYN)
	print(EQSRV.GLBDATA.Onvforacid)
	print(EQSRV.GLBDATA.Onforacid)
	exitscript
trace off
end-->
