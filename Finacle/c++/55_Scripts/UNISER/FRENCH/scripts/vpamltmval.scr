<--start
trace on
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("CUST","DATA")==0)then
                createclass("CUST","DATA",5)
        endif
	CUST.DATA.eqAmt = cdouble("1")
	if(fieldexists(BANCS.INPUT.acctCrncy)==1)then
		print(BANCS.INPUT.acctCrncy)
		CUST.DATA.acctCrncy = BANCS.INPUT.acctCrncy
	else
		CUST.DATA.acctCrncy = ""
	endif
	if(fieldexists(BANCS.INPUT.refCrncy)==1)then
		print(BANCS.INPUT.refCrncy)
		CUST.DATA.refCrncy = BANCS.INPUT.refCrncy
	else
		CUST.DATA.refCrncy = ""
	endif
	if(fieldexists(BANCS.INPUT.ratecodein)==1)then
		print(BANCS.INPUT.ratecodein)
		CUST.DATA.ratecodein = BANCS.INPUT.ratecodein
	else
		CUST.DATA.ratecodein = ""
	endif
	if(fieldexists(BANCS.INPUT.ratein)==1)then
		print(BANCS.INPUT.ratein)
		CUST.DATA.ratein = BANCS.INPUT.ratein
	else
		CUST.DATA.ratein = ""
	endif
	if(fieldexists(BANCS.INPUT.refAmt)==1)then
		print(BANCS.INPUT.refAmt)
		CUST.DATA.refAmt = BANCS.INPUT.refAmt
	else
		CUST.DATA.refAmt = ""
	endif
	if(cdouble(CUST.DATA.refAmt)>=1)then
		BANCS.INPARAM.InputAmount  = cdouble(CUST.DATA.refAmt) 
	else
		BANCS.INPARAM.InputAmount  = cdouble("1") 
	endif
	if(CUST.DATA.refCrncy!="")then
		BANCS.INPARAM.FromCurrency = CUST.DATA.refCrncy 
	else
		BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode 
	endif
	if(CUST.DATA.acctCrncy!="")then
		BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode 
	else
		BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode 
	endif
	if(CUST.DATA.ratecodein!="")then
		BANCS.INPARAM.RateCode     = CUST.DATA.ratecodein 
	else
		BANCS.INPARAM.RateCode     = "MEAN" 
	endif
	if(CUST.DATA.ratein!="")then
		BANCS.INPARAM.Rate         = CUST.DATA.ratein 
	else
		BANCS.INPARAM.Rate         = CDOUBLE("0.0")
	endif
        sv_u = urhk_B2k_ConvertAmount("")
        CUST.DATA.eqAmt = BANCS.OUTPARAM.OutputAmount
	print(CUST.DATA.eqAmt)
	sv_u = urhk_SetOrbOut("eqAmt|"+CUST.DATA.eqAmt)
trace off
end-->
