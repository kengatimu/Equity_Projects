sv_q = sv_q + " (select pool_id , count (pool_id) xx  from tbaadm.gam where pool_id in  ( select  pool_id  "
sv_q = sv_q + " from tbaadm.gam where schm_code ='SB144' and bank_id ='54') "
sv_q = sv_q + "  group by pool_id) where xx ='2') and schm_code ='SB144' AND clr_bal_amt > 0 "

print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
