		CUST.MOBIL.ResStatus = "F"
		CUST.MOBIL.Response = "Transaction creation Failed."
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO EndOfScript
	#}
	ENDIF

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	DO
#}
ENDIF

