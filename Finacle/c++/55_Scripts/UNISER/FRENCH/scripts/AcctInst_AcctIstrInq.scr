BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankId + "|Y|" + CUST.INTERFACE.AcctNum
print(BANCS.INPARAM.BINDVARS)
sv_s = "InstId,AcctNum,InstType,ClientCode,InstDate,ms1,ms2,ms3,ms4,ms5,ms6,ms7,Action|"
sv_s = sv_s + " SELECT gam.foracid, gam.foracid,'ACCMEMO', gam.sol_id,gam.acct_opn_date,"
