#***************************************************************************************
#	Author		:       P.Senthil kumar		
#
#***************************************************************************************

#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
group           numbertype
cnt          	numbertype
amt		numbertype 
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
callscript      stringType
lv_setid        stringType
lv_setdesc      stringType
tot_cnt		numbertype 
tot_amt		numbertype 
flag 		numbertype
flag1		numbertype
#--------------------------------------------------------------------------------------T
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
group 
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
#bankName        stringType
#branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId 		stringtype
asondate	stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg 
set tot_cnt = 0
set tot_amt = 0
set flag = 0
set flag1 = 0 
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   5000 
columnsperline 110 
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13 
pagefooterlines 4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
execute Line 
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
begin
execute pipe
nextline
execute pipe

if (flag = 0)
begin
print "0 - 50,000" column 2
set flag1 = 0
set flag = flag + 1
end

if(flag = 2)
begin
print "50,000 - 100,000" column 2
set flag1 = 0
set flag = flag + 1
end

if(flag = 4)
begin
print "100,001 - 500,000" column 2 
set flag1 = 0
set flag = flag + 1
end

if(flag = 6)
begin
print "500,001 - 1,000,000" column 2
set flag1 = 0 
set flag = flag + 1
end

if(flag = 8)
begin
print "Over 1,000,000" column 2 
set flag1 = 0 
set flag = flag + 1
end

execute onEveryRecord
#print group column 10
print cnt  column 58 size 10 autocomma
print amt column 74 size 20  autocomma precision 2
nextline
set tot_cnt = tot_cnt + cnt
set tot_amt = tot_amt + amt
end
#**************************************************************************************
ONENDOFREPORT
begin
execute line
execute pipe
nextline
execute pipe
print "Total" column 6
print tot_cnt column 58 size 10 autocomma 
print tot_amt column 74 size 20 autocomma precision 2
nextline
execute line
nextline
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:______________________________________" column 20 
nextline
end 
#**************************************************************************************
PROCEDURE Line

begin
    print "---------------------------------------------------------------------------------------------------------------------------" column 2

end
#***************************************************************************************

PROCEDURE pipe

begin
        print "|"               column 1
        print "|"               column 29 
        print "|"               column 56 
        print "|"               column 72 
        print "|"               column 94 
	print "|" 		column 110

end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
print "EXM22" column 90
nextline
print "INSTITUTION:  EQUITY BANK LIMITED " column 5 
print "DATE:" column  90 
print asondate column 95 size 10
nextline
nextline
print  "BRANCH    :"  column 5 
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc size 20
nextline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
print "DISTRIBUTION OF DEPOSITS" size 100 center 
nextline
print "____________________________" size 100 center 
nextline
nextline
execute pipe
execute Line
nextline
execute pipe
print "RANK" column 3 size 25
print "TYPE OF DEPOSITS" column 30  center size 25 
print "NO.OF " column 57 size 15 center 
print "AMOUNTS" column 73 size 20 center 
print "REMARKS" column 95 size 15 center
nextline
execute pipe
print "ACCOUNTS" column 57 size 15 center 
nextline
execute pipe
execute line
end
#****************************************************************************************

procedure onEveryRecord
begin
if (flag1 = 0)
begin
print "i) Demand Accounts" column 30
end

if (flag1 = 1)
begin
print "ii) Savings" column 30
end

if (flag1 = 2)
begin
print "iii) Call" column 30
end

if (flag1 = 3)
begin
print "iv) Fixed" column 30
set flag = flag + 1
end

set flag1 = flag1 + 1 
end
#*****************************************************************************

