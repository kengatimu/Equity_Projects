# Template Name :		daily_dr53.mrt
# Description	:		Customer Arrears Rpt{ principal}
# Author			E.G.KAROBIA, 09/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr35.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		 stringType
lv_setdesc		stringType
lv_userId		stringType 

tot_acct_name_cntr      numberType
tot_advnd_amt           numberType
tot_instl_amt           numberType
tot_pric_amt            numberType
tot_arrears             numberType
tot_upto30		numberType
tot_upto60		numberType
tot_upto90		numberType
tot_upto120		numberType
tot_upto150		numberType
tot_upto210		numberType
tot_upto270		numberType
tot_upto360		numberType
tot_over360		numberType
tot_upto180   		numberType
grnd_acct_name_cntr     numberType
grnd_advnd_amt           numberType
grnd_instl_amt           numberType
grnd_pric_amt            numberType
grnd_arrears             numberType
grnd_upto30		numberType
grnd_upto60		numberType
grnd_upto90		numberType
grnd_upto120		numberType
grnd_upto150		numberType
grnd_upto180            numberType
grnd_upto210		numberType
grnd_upto270		numberType
grnd_upto360		numberType
grnd_over360		numberType
#
GROUPANDSORT
schm_code ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 180
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
if total_arreas = 0 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF schm_code
    print "Product : " 
    print " "
    print schm_code     
    nextline
    nextline
#
AFTERBREAKOF schm_code
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	set tot_acct_name_cntr=groupcount acct_name
	set tot_advnd_amt=groupsum adv_amt
	set tot_instl_amt=groupsum installment_amt          
	set tot_pric_amt=groupsum principal           
	set tot_arrears=groupsum total_arreas           
	set tot_upto30=groupsum upto30		
	set tot_upto60=groupsum upto60		
	set tot_upto90=groupsum upto90		
	set tot_upto120=groupsum upto120			
	set tot_upto150=groupsum upto150		
	set tot_upto210=groupsum upto210		
	set tot_upto270=groupsum upto270
	set tot_upto360=groupsum upto360		
	set tot_over360=groupsum over360		
	set tot_upto180=groupsum upto180
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
        print acc_number     column 3
	print acct_name          column 16   
	print principal  column 30 format "#,###,###,###.##"
	print adv_amt  column 51 format "#,###,###,###.##"
	print total_arreas   column 67 format "#,###,###,###.##"
	print upto30  column 83  format "#,###,###,###.##"  
	print upto90  column 99 format "#,###,###,###.##"
	print upto150 column 115 format "#,###,###,###.##"
	print upto210 column 131 format "#,###,###,###.##"
	print upto360 column 147 format "#,###,###,###.##"
	nextline
	print overdue_days   column 4
	print disburse_date  column  15
	print installment_amt  column 28 format "#,###,###,###.##"
	print upto60   column 81 format "#,###,###,###.##"
	print upto120  column 97 format "#,###,###,###.##"
	print upto180  column 113 format "#,###,###,###.##"
	print upto270  column 129 format "#,###,###,###.##"
	print over360  column 145 format "#,###,###,###.##"
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "A/c # "     column 5
	print "  A/c Name "   column 18
	print "  Princpal"    column 38
	print "  Amt advanced" column 51
	Print "  Tot.Arrears "  column 72
	print "  1-30"    column 95
	print "  61-90"   column 111
	print "  121-150" column 127
	print "  181-210" column 143
	print "  271-360"  column 159
	nextline
	print "Days in Arr."  column 1
	print "Dis.Date"   column 18
	print "Instl.Amnt " column 38
	print "31-60"   column 95
	print "91-120"  column 111
	print "151-180" column 127 
	print "211-270" column 143
	print "Over 360" column 159
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
separatorline
        print "Grand Total" column 1
	set grnd_acct_name_cntr=totalcount acct_name
        set grnd_advnd_amt=totalsum adv_amt
        set grnd_instl_amt=totalsum installment_amt
        set grnd_pric_amt=totalsum principal
        set grnd_arrears=totalsum total_arreas
        set grnd_upto30=totalsum upto30
        set grnd_upto60=totalsum upto60
        set grnd_upto90=totalsum upto90
        set grnd_upto120=totalsum upto120
        set grnd_upto150=totalsum upto150
        set grnd_upto180=totalsum upto180
        set grnd_upto210=totalsum upto210
        set grnd_upto270=totalsum upto270
        set grnd_upto360=totalsum upto360
        set grnd_over360=totalsum over360
	print grnd_acct_name_cntr column 16
        print grnd_pric_amt  column 30 format "#,###,###,###.##"
	print grnd_advnd_amt column 51 format "#,###,###,###.##"
	print grnd_arrears  column 67 format "#,###,###,###.##"
	print grnd_upto30  column 83 format "#,###,###,###.##"
	print grnd_upto90  column 99 format "#,###,###,###.##"
	print grnd_upto150  column 115 format "#,###,###,###.##"
	print grnd_upto210  column 131 format "#,###,###,###.##"
	print grnd_upto360  column 147 format "#,###,###,###.##"
	nextline
        print grnd_instl_amt  column 28 format "#,###,###,###.##"
        print grnd_upto60   column 81 format "#,###,###,###.##"
        print grnd_upto120  column 97 format "#,###,###,###.##"
        print grnd_upto180  column 113 format "#,###,###,###.##"
        print grnd_upto270  column 129 format "#,###,###,###.##"
        print grnd_over360  column 145 format "#,###,###,###.##"
separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	separatorline
	print "Subtotal" column 1
	print tot_acct_name_cntr column 16
	print tot_pric_amt   column 30 format "#,###,###,###.##"
	print tot_advnd_amt  column 51 format "#,###,###,###.##"
        print tot_arrears  column 67 format "#,###,###,###.##"
        print tot_upto30   column 83 format "#,###,###,###.##"
        print tot_upto90   column 99 format "#,###,###,###.##"
        print tot_upto150  column 115 format "#,###,###,###.##"
        print tot_upto210  column 131 format "#,###,###,###.##"
        print tot_upto360   column 147 format "#,###,###,###.##"
        nextline
        print tot_instl_amt column 28 format "#,###,###,###.##"
        print tot_upto60  column 81 format "#,###,###,###.##"
        print tot_upto120  column 97 format "#,###,###,###.##"
        print tot_upto180  column 113 format "#,###,###,###.##"
        print tot_upto270  column 129 format "#,###,###,###.##"
        print tot_over360  column 145 format "#,###,###,###.##"
	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "CUSTOMER ARREARS REPORT [PRINCIPAL] "  column 60
	nextline
	nextline
	print "AS AT :" column 70
	print " "
	print date
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end

