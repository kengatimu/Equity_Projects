#*********************************************************************
#       Author          :      Mabel Gichengo
#
#**********************************************************************
#  DESC   :    Monthly Credit Report 
######################################################################
RECORDLAYOUT
####################################################################
sol_id			    stringtype
emp_name            stringtype 
portfolioLastMnth   numbertype 										   	
portfoliocurrMth    numbertype 
portVolChange       numbertype 
portPctChange       numbertype 
parlastmonth        numbertype 
parcurentamt        numbertype 
parchangepct        numbertype
free_text           stringtype 

LOCALVARIABLES
####################################################################
GRAND_total_plm  numbertype
GRAND_TOTAL_pcm  numbertype
GRAND_total_pvc  numbertype
GRAND_TOTAL_ppc  numbertype
GRAND_total_palm numbertype
GRAND_TOTAL_pacm numbertype
GRAND_TOTAL_papc numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType 
GROUPANDSORT
####################################################################
emp_name ascending

REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
branchName      stringtype

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
PAGEFORMAT
####################################################################
#
linesperpage	    70
pageheaderlines      5 
pagefooterlines      2 
topmargin	     1
bottommargin         1
leftmargin           2 
rightmargin          2 
columnsperline     180
#
ONSTARTOFREPORT
####################################################################  
execute brBankHdg 
execute pageHdg
#
#
PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg

PAGEFOOTER
####################################################################
separatorline

ONEVERYRECORD 
####################################################################
#on every record
####################################################################
set GRAND_total_plm  = GRAND_total_plm  + portfolioLastMnth
PRINT emp_name 		            COLUMN 5
PRINT SOL_ID                    COLUMN 33
PRINT portfolioLastMnth         COLUMN 45 	  format "###,###,###.##"			  	
PRINT portfoliocurrMth          COLUMN 65     format "###,###,###.##" 
PRINT portVolChange             COLUMN 90     format "###,###,###.##" 
PRINT portPctChange             COLUMN 110 
PRINT parlastmonth              COLUMN 120    format "###,###,###.##" 
PRINT parcurentamt              COLUMN 140    format "###,###,###.##" 
PRINT parchangepct              COLUMN 160    
PRINT free_text                 column 170    
#
####################################################################
# After break 
####################################################################
#
#
ONENDOFREPORT
#############################################################################

begin
    separatorline
    print "TOTAL FOR BRANCH:" column 5
    print GRAND_total_plm column 45
    separatorline
    nextline
    nextline
    print "Comments by Credit Administartor on:"
    nextline
    print "a) Volume:"
    nextline
    print "b) PAR:"
    nextline
    print "Comments by Branch Manager on:"
    nextline
    print "a) Volume:"
    nextline
    print "b) PAR:"
    nextline
    print "   Printed By:  " column 20  
    print  lv_userId 
    print "------------------------------" column 20
    nextline
    print "Branch Manager" column 20
    nextline
end
#
procedure  pageHdg
#############################################################################

begin
	print "MONTHLY CREDIT REPORT  " size 180 center
	nextline
	print "From  " column 75
        print ipFrmDate 
	print "  &  "
	print ipToDate
	nextline
	nextline
	separatorline
        PRINT "P/FOLIO OWNR"            COLUMN 5
	PRINT "BRANCH"                  COLUMN 33
	PRINT "P/FOLIO LST MNTH"        COLUMN 45
	PRINT "P/FOLIO CRNT MNTH"       COLUMN 65
	PRINT "P/FOLIO VOL CHG"         COLUMN 90
	PRINT "P/FOLIO % CHG"           COLUMN 109
	PRINT "PAR LST MNTH"            COLUMN 123
	PRINT "PAR CRNT MNTH"           COLUMN 140
	PRINT "PAR % CHG"               COLUMN 160
	PRINT "COMMENTS"                column 172
	separatorline

end
PROCEDURE brBankHdg
##############################################################################
begin
print "Page No. "   column 110
print page_number precision 0
nextline
print today column 110
nextline
nextline
print "EQUITY BANK LIMITED" size 180 center
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print lv_setdesc size 180 center
set page_number= page_number+1
nextline
end

#############################################################################
# End of File
#############################################################################

