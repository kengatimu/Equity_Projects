						CUST.MESSAGING.MESSAGETEXT= CUST.LADISB.Dear + CUST.LADISB.name + CUST.LADISB.repay + CUST.LADISB.FLOW_AMT + CUST.LADISB.repayloan + CUST.LADISB.NEXT_DMD_DATE 
