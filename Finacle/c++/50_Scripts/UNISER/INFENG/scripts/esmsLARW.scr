					sv_s = sv_s + " TO_CHAR(NEXT_DMD_DATE, 'DD-Mon-RRRR'), gam.bank_id  "
					sv_s = sv_s + " FROM TBAADM.lrs,tbaadm.cphone c,tbaadm.gam,tbaadm.gac WHERE lrs.ACID=gam.acid  AND gam.cif_id=c.PHONE_B2KID  "
					sv_s = sv_s + " AND c.PREFERREDFLAG='Y'   AND gam.bank_id=c.bank_id AND gam.bank_id=gac.bank_id AND lrs.bank_id=gam.bank_id AND  gac.ACID=gam.acid AND lrs.bank_id=c.bank_id  "
					sv_s = sv_s + " AND gac.bank_id='50'  AND GAM.ACCT_CLS_FLG='N' AND lrs.FLOW_ID='EIDEM' AND lrs.LAST_REC_FLG='Y' AND gam.foracid= ?SVAR  AND gam.bank_id= ?SVAR  "
