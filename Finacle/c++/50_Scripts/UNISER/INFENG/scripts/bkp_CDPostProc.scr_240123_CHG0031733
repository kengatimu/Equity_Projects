                                sv_s = sv_s + " AND system_date_time = to_date('" + CUST.ATM.SysDateTime + "','YYYYMMDDHH24MISS')"
                                sv_s = sv_s + " AND dcc_id           = '" + CUST.ATM.DccId               + "'"
                                sv_s = sv_s + " AND sno              = '" + TRIM(CUST.ATM.SerialNum)     + "'"
                                sv_s = sv_s + " AND bank_id = ?SVAR "
                                print(sv_s)
                                BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
                                sv_r =  urhk_dbSelectWithBind(sv_s)
                                print(sv_r)
                                IF(sv_r != 0) THEN
                                        BANCS.OUTPUT.RespCode = "99"
                                        BANCS.OUTPUT.successOrFailure="F"
                                        GOTO FINISH
                                ENDIF

                                BANCS.OUTPUT.ReservedField1=BANCS.OUTPARAM.TRAN_ID
                        #}
                        ENDIF
                #}
                ENDIF

                #------------------------------------------------------------------------------
                # Query to fetch Sacntion amount and Lien Amount
                #------------------------------------------------------------------------------
                IF (CUST.ATM.Command == "BLIS")  THEN
                #{
                        sv_s = "SANCT_LIM,LIEN_AMT|"
                        sv_s = sv_s + " SELECT sanct_lim,lien_amt "
                        sv_s = sv_s + " FROM tbaadm.GAM WHERE "
                        sv_s = sv_s + " foracid = '" + CUST.ATM.Foracid + "'"
                        sv_s = sv_s + " AND bank_id = ?SVAR "
                        print(sv_s)
                        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
                        sv_r = urhk_dbSelectWithBind(sv_s)
                        print(sv_r)

                        IF(sv_r != 0) THEN
                                BANCS.OUTPUT.RespCode = "99"
                                BANCS.OUTPUT.successOrFailure="F"
                                GOTO FINISH
                        ENDIF

                        BANCS.OUTPUT.ReservedField2 = BANCS.OUTPARAM.SANCT_LIM
                        BANCS.OUTPUT.ReservedField3 = BANCS.OUTPARAM.LIEN_AMT
                #}
                ENDIF
        #}
        ENDIF
                #------------------------------------------------------------------------------------------------
                # Finacle Treasury customization for online transacions of bank customers
                # Populating the BANCS.OUTPUT.ReservedField3 with Tran Date,Tran ID and Tran Status for DCC id "FT"
                # This field should be shown in Response Message field of Host Message Management: Deepak:13102009
                #-------------------------------------------------------------------------------------------------

        print (BANCS.INPUT.DccId)
        print (BANCS.INPUT.CustCardId)
        print (BANCS.INPUT.SysDateTime)
        print (BANCS.INPUT.SerialNum)
        print (BANCS.INPUT.Command)
        print (BANCS.INPUT.ReservedField3)

        # Customisation is required only for those transactions where DccId is FT.
        if (TRIM(BANCS.INPUT.DccId) == "FT") then
        #{
                # Customisation is required only for those transactions where command not in
                # PATS (Lien Marking), PARS ( Lein Reversal) and ACIS ( Check Balance)
                if ((TRIM(BANCS.INPUT.Command) != "PATS") and (TRIM(BANCS.INPUT.Command) != "PARS") and (TRIM(BANCS.INPUT.Command) != "ACIS")) then
                #{
                        #Changing the Response Command into Request Command.
                        sv_a = mid$(BANCS.INPUT.Command,0,3)
                        sv_a = sv_a + "R"

                        sv_b = BANCS.INPUT.CustCardId
                        sv_c = BANCS.INPUT.SysDateTime
                        sv_d = BANCS.INPUT.DccId
                        sv_e = BANCS.INPUT.SerialNum
                        sv_s =  "tran_date,tran_id|select tran_date,tran_id  "
                        sv_s = sv_s + " from tbaadm.RTT "
                        sv_s = sv_s + " where  cmd = '"+sv_a+"' "
                        sv_s = sv_s + " and cust_or_card_id = '"+sv_b+"' "
                        sv_s = sv_s + " and to_char( system_date_time,'yyyymmddhh24miss') = '"+sv_c+"' "
                        sv_s = sv_s + " and dcc_id = '"+sv_d+"' "
                        sv_s = sv_s + " and sno = '"+sv_e+"' "
                        sv_s = sv_s + " AND bank_id = ?SVAR "
                        print(sv_s)
                        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
                        sv_r =  urhk_dbSelectWithBind(sv_s)
                        if (sv_r == 0) then
                        #{
                                print (BANCS.OUTPARAM.tran_date)
                                print (BANCS.OUTPARAM.tran_id)

                                sv_f = BANCS.OUTPARAM.tran_date
                                sv_g = BANCS.OUTPARAM.tran_id

                                sv_o = "count_id | select count(1) from tbaadm.DTD"
                                sv_o = sv_o + " where tran_date = '"+BANCS.OUTPARAM.tran_date+"' "
                                sv_o = sv_o + " and tran_id = '"+BANCS.OUTPARAM.tran_id+"' "
                                sv_o = sv_o + " and pstd_flg = 'N' "
                                print(sv_o)
                                sv_o = sv_o + " AND bank_id = ?SVAR "
                                print(sv_o)
                                BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
                                sv_t = urhk_dbSelectWithBind(sv_o)
                                if ( sv_t == 0) then
                                #{
                                        sv_h = BANCS.OUTPARAM.count_id
                                        print(sv_h)
                                        if ( sv_h == 0) then
                                                BANCS.OUTPUT.ReservedField3 = sv_g + " - " + sv_f + " - POSTED"
                                                print ("Posted Transaction")
                                        else
                                                BANCS.OUTPUT.ReservedField3 = sv_g + " - " + sv_f + " - UNPOSTED"
                                                print ("Un Posted Transaction")
                                        endif
                                #}
                                endif
                        #}
                        endif
                #}
                endif

                print (BANCS.OUTPUT.DccId)
                print (BANCS.OUTPUT.CustCardId)
                print (BANCS.OUTPUT.SysDateTime)
                print (BANCS.OUTPUT.SerialNum)
                print (BANCS.OUTPUT.Command)
                print (BANCS.OUTPUT.ReservedField3)

        #}
        endif
ENDIF
#########}
	
