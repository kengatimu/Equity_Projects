CHECKSUM="d8c05512472894622d444f3e4a11a48826e4b70ce46a207b8b610e211c712a3a"
	TRACE ON
	
	####### Added for granting Online TOD through Channells ########
	################################################################
	
	IF (REPEXISTS("OTOD") == 0) THEN
	#{
		CREATEREP("OTOD")
	#}
	ENDIF
	
	IF (CLASSEXISTS("OTOD", "VARS") == 0) THEN
	#{
		CREATECLASS("OTOD", "VARS", 5)
	#}
	ENDIF
	
	BANCS.INPUT.ReservedField1 = trim(BANCS.INPUT.ReservedField1)
	print(BANCS.INPUT.ReservedField1)
	
	BANCS.INPUT.ReservedField2 = trim(BANCS.INPUT.ReservedField2)
	print(BANCS.INPUT.ReservedField2)
	
	## main if AUTOTOD chk starts ##
	IF (MID$(BANCS.INPUT.ReservedField2,0,7) == "AUTOTOD") THEN
	#{
		
		OTOD.VARS.todTxnType = ""
		IF (MID$(BANCS.INPUT.ReservedField2,7,6) == "TXNREQ") THEN
		#{
			OTOD.VARS.todTxnType = trim(MID$(BANCS.INPUT.ReservedField2,7,6))
			#}
		ELSE
			#{
			IF (MID$(BANCS.INPUT.ReservedField2,7,8) == "AVAILREQ") THEN
			#{
				OTOD.VARS.todTxnType = trim(MID$(BANCS.INPUT.ReservedField2,7,8))
			#}
			ENDIF
		#}
		ENDIF
		
		## def TOD Input Variables ##
		OTOD.VARS.todDccId = trim(BANCS.INPUT.DccId)
		OTOD.VARS.todCommand = trim(BANCS.INPUT.Command)
		OTOD.VARS.todSolId = trim(sv_s)
		OTOD.VARS.todForacid = trim(BANCS.INPUT.Foracid)
		OTOD.VARS.todTranAmt = trim(BANCS.INPUT.TranAmt)
		OTOD.VARS.todFee = trim(BANCS.INPUT.Fee)
		OTOD.VARS.todTranCrncy = trim(BANCS.OUTPUT.TranCrncy)
		OTOD.VARS.todReservedField1 = trim(BANCS.INPUT.ReservedField1)
		OTOD.VARS.todReservedField2 = trim(BANCS.INPUT.ReservedField2)
		OTOD.VARS.todCustCardId = ""
		OTOD.VARS.todCustId = ""
		OTOD.VARS.todMinLimitAmt = ""
		OTOD.VARS.todCreAmt = ""
		OTOD.VARS.todChargeAmt = ""
		OTOD.VARS.todAcctStatus = ""
		OTOD.VARS.todAcctSancId = ""
		OTOD.VARS.todAcctAvailId = ""
		OTOD.VARS.todAvailReqPeriod = ""
		OTOD.VARS.todCreDate = ""
		OTOD.VARS.toddbStatDate = ""
		OTOD.VARS.todMaxAvailAmt = ""
		
		## print TOD Input Variables ##
		print(OTOD.VARS.todDccId)
		print(OTOD.VARS.todCommand)
		print(OTOD.VARS.todSolId)
		print(OTOD.VARS.todForacid)
		print(OTOD.VARS.todTranAmt)
		print(OTOD.VARS.todFee)
		print(OTOD.VARS.todReservedField1)
		print(OTOD.VARS.todReservedField2)
		print(OTOD.VARS.todTxnType)
		print(OTOD.VARS.todCustCardId)
		print(OTOD.VARS.todCustId)
		print(OTOD.VARS.todMaxAvailAmt)
		
		print(sv_t)
		print(sv_f)
		print(sv_y)
		print(sv_b)
		print(sv_v)
		
		## TOD minimum limit amount request ##
		sv_q = "schmTyp|select code_desc from CUSTOM.CATOD_CODE_TABLE where BANK_ID = ?SVAR AND code_type = 'AM' AND code_value = ?SVAR"
		print(sv_q)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + sv_v
		sv_r = urhk_dbSelectWithBind(sv_q)
		IF (sv_r == "0") THEN
		#{
			OTOD.VARS.todMinLimitAmt = BANCS.OUTPARAM.schmTyp
			print(OTOD.VARS.todMinLimitAmt)
			sv_l = cint(OTOD.VARS.todMinLimitAmt)
			#}
		ELSE
			#{
			sv_l = cint("500")
		#}
		ENDIF
		print(sv_l)
		
		IF ( (BANCS.INPUT.DccId == "SWT") OR (BANCS.INPUT.DccId == "BWY") ) THEN
		#{
			IF ( (BANCS.INPUT.Command == "DBTR") OR (BANCS.INPUT.Command == "TRTR") ) THEN
			#{
				IF (OTOD.VARS.todTxnType == "TXNREQ") THEN
				#{
					sv_o = sv_t - sv_b
					sv_c = (sv_o * 0.10)
					print(sv_c)
					IF (sv_c < 200) THEN
					#{
						sv_c = cdouble("200")
						print(sv_c)
					#}
					ENDIF
					OTOD.VARS.todChargeAmt = FORMAT$(sv_c,"%016.0f")
					print(OTOD.VARS.todChargeAmt)
					sv_p = CINT(OTOD.VARS.todChargeAmt)
					print(sv_p)
					sv_x = sv_o + sv_f + sv_p
					print(sv_x)
					OTOD.VARS.todChargeAmt = OTOD.VARS.todTranCrncy + "D" + mid$(OTOD.VARS.todChargeAmt,2,14) + "0002"
					print(OTOD.VARS.todChargeAmt)
					OTOD.VARS.todChargeAmt = mid$(BANCS.INPUT.Fee,0,20) + "01" + OTOD.VARS.todChargeAmt
					print(OTOD.VARS.todChargeAmt)
					BANCS.OUTPUT.Fee = OTOD.VARS.todChargeAmt
					print(BANCS.OUTPUT.Fee)
					#}
				ELSE
					#{
					IF (OTOD.VARS.todTxnType == "AVAILREQ") THEN
					#{
						sv_c = (sv_t * 0.10)
						print(sv_c)
						IF (sv_c < 200) THEN
						#{
							sv_c = cdouble("200")
							print(sv_c)
						#}
						ENDIF
						OTOD.VARS.todChargeAmt = FORMAT$(sv_c,"%016.0f")
						print(OTOD.VARS.todChargeAmt)
						sv_p = CINT(OTOD.VARS.todChargeAmt)
						print(sv_p)
						## tod charge amt is greater then eff avail bal ##
						IF (sv_p > sv_b) THEN
						#{
							sv_p = sv_p - sv_b
							sv_x = sv_t + sv_p
							#}
						ELSE
							#{
							sv_x = sv_t
						#}
						ENDIF
						print(sv_x)
						BANCS.OUTPUT.TranAmt = mid$(OTOD.VARS.todChargeAmt,2,14) + "00"
						print(BANCS.OUTPUT.TranAmt)
						#}
					ELSE
						#{
						BANCS.OUTPUT.ReservedField1 = "Invalid TOD request"
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure="F"
						exitscript
					#}
					ENDIF
				#}
				ENDIF
				## cmd if else chk ##
				#}
			ELSE
				#{
				BANCS.OUTPUT.ReservedField1 = "Invalid TOD request command"
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				exitscript
			#}
			ENDIF
			## DccId if chk end ##
		#}
		ENDIF
		#--- Inculusion for Eazzy
		IF ((BANCS.INPUT.DccId == "EAZ") AND (BANCS.INPUT.Command == "CBKR")) THEN
		#{
			IF (OTOD.VARS.todTxnType == "AVAILREQ") THEN
			#{
				sv_c = (sv_t * 0.10)
				print(sv_c)
				IF (sv_c < 200) THEN
				#{
					sv_c = cdouble("200")
					print(sv_c)
				#}
				ENDIF
				OTOD.VARS.todChargeAmt = FORMAT$(sv_c,"%016.0f")
				print(OTOD.VARS.todChargeAmt)
				sv_p = CINT(OTOD.VARS.todChargeAmt)
				print(sv_p)
				## tod charge amt is greater then eff avail bal ##
				IF (sv_p > sv_b) THEN
				#{
					sv_p = sv_p - sv_b
					sv_x = sv_t + sv_p
					#}
				ELSE
					#{
					sv_x = sv_t
				#}
				ENDIF
				print(sv_x)
				BANCS.OUTPUT.TranAmt = mid$(OTOD.VARS.todChargeAmt,2,14) + "00"
				print(BANCS.OUTPUT.TranAmt)
				#}
			ELSE
				#{
				BANCS.OUTPUT.ReservedField1 = "Invalid TOD request"
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				exitscript
			#}
			ENDIF
			
			## DccId if chk end ##
		#}
		ENDIF
		
		## tod amt chk ##
		IF (sv_x >= sv_l) THEN
		#{
			
			OTOD.VARS.todCreAmt = sv_x
			OTOD.VARS.todCreAmt = CINT(OTOD.VARS.todCreAmt)
			print(OTOD.VARS.todCreAmt)
			
			## chking acct status ##
			sv_q = "acctstat| select CUSTOM.AUTH_TOD_REQ(?SVAR,?SVAR,?SVAR) from dual"
			print(sv_q)
			
			BANCS.INPARAM.BINDVARS =  BANCS.INPUT.Foracid + "|" + OTOD.VARS.todCreAmt + "|" + BANCS.STDIN.contextBankId
			
			sv_r = urhk_dbSelectWithBind(sv_q)
			OTOD.VARS.todAcctStatus = BANCS.OUTPARAM.acctstat
			print(OTOD.VARS.todAcctStatus)
			print(BANCS.OUTPARAM.acctstat)
			
			IF(BANCS.OUTPARAM.acctstat == "SUCCESS") THEN
			#{
				
				## for creation of online TOD ##
				sv_m = FORMAT$(sv_x, "%19.6f")
				print(sv_m)
				
				## cre of tod ##
				sv_z = urhk_createUserDefndTOD(sv_m)
				print(sv_z)
				
				IF(sv_z != 0) THEN
				#{
					BANCS.OUTPUT.ReservedField1 = "TOD creation failed ON account"
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					exitscript
					#}
				ELSE
					#{
					IF(sv_z == 0) THEN
					#{
						
						sv_q = "AvailReqId| SELECT LPAD(CUSTOM.AVAIL_SEQ_GEN.NEXTVAL,7,0) FROM DUAL"
						sv_r = urhk_dbSelectWithBind(sv_q)
						print(BANCS.OUTPARAM.AvailReqId)
						OTOD.VARS.todAcctAvailId = trim(BANCS.OUTPARAM.AvailReqId)
						
						sv_q ="todDate,dbStatDate| SELECT TO_CHAR(DB_STAT_DATE,'DDMMYY'), DB_STAT_DATE FROM GCT WHERE bank_id = ?SVAR"
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
						sv_r = urhk_dbSelectWithBind(sv_q)
						
						OTOD.VARS.todCreDate = trim(BANCS.OUTPARAM.todDate)
						OTOD.VARS.toddbStatDate = trim(BANCS.OUTPARAM.dbStatDate)
						
						sv_q = "sancId,acctname| select REQUEST_ID, ACCT_NAME from CUSTOM.CATOD_SANCTION_TABLE"
						sv_q = sv_q + " where BANK_ID = ?SVAR AND SANCT_DATE <= ?SVAR AND EXPIRY_DATE >= ?SVAR"
						sv_q = sv_q + " AND ACCT_NUM = ?SVAR AND STATUS_FLG = 'A'"
						
						print(sv_q)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + OTOD.VARS.toddbStatDate + "|" + OTOD.VARS.toddbStatDate
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.Foracid
						sv_r = urhk_dbSelectWithBind(sv_q)
						print(sv_r)
						
						OTOD.VARS.todAcctSancId = trim(BANCS.OUTPARAM.sancId)
						OTOD.VARS.todAcctName = trim(BANCS.OUTPARAM.acctname)
						
						OTOD.VARS.todAcctAvailId = OTOD.VARS.todCreDate + "A" + OTOD.VARS.todAcctAvailId
						print(OTOD.VARS.todAcctAvailId)
						
						IF(BANCS.INPUT.DccId == "BWY") THEN
						#{
							OTOD.VARS.todCustId = trim(BANCS.INPUT.CustCardId)
							#}
						ELSE
							#{
							IF(BANCS.INPUT.DccId == "SWT") THEN
							#{
								OTOD.VARS.todCustCardId = trim(BANCS.INPUT.CustCardId)
							#}
							ENDIF
						#}
						ENDIF
						
						sv_q = "balTodLimitAmt| select CATOD.GET_MAX_AVL_AMT(?SVAR,?SVAR,?SVAR) from dual"
						print(sv_q)
						
						BANCS.INPARAM.BINDVARS = OTOD.VARS.todAcctSancId + "|"+ OTOD.VARS.todAcctName + "|" + BANCS.STDIN.contextBankId
						sv_r = urhk_dbSelectWithBind(sv_q)
						print(BANCS.OUTPARAM.balTodLimitAmt)
						OTOD.VARS.todMaxAvailAmt = BANCS.OUTPARAM.balTodLimitAmt
						
						sv_i = "INSERT INTO CATOD_AVAILMENT_TABLE (REQUEST_ID,SANCT_ID,ACCT_NUM,CUST_ID,CARD_NUM,ACCT_NAME,SOL_ID,REQ_AMT,PERIOD,STATUS_FLG,REMARKS,
						sv_i = sv_i + " CREATED_BY,CREATED_DATE,ADV_AMT,UPLOAD_STATUS,MAX_LIMIT,RCRE_USER,RCRE_DATE,BANK_ID) "
						sv_i = sv_i + " VALUES (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR, 'A', 'M0017',?SVAR,SYSDATE,?SVAR,'03',?SVAR,'CDCI',SYSDATE,?SVAR)"
						
						print(sv_i)
						BANCS.INPARAM.BINDVARS = OTOD.VARS.todAcctSancId + "|" + BANCS.INPUT.Foracid + "|" + OTOD.VARS.todAcctAvailId
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +OTOD.VARS.todAcctSancId + "|" + BANCS.INPUT.Foracid
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +OTOD.VARS.todCustId + "|" + OTOD.VARS.todCustCardId
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +OTOD.VARS.todAcctName + "|" + OTOD.VARS.todSolId
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +OTOD.VARS.todCreAmt + "|" + OTOD.VARS.todAvailReqPeriod
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.DccId + "|" + OTOD.VARS.todCreAmt
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +OTOD.VARS.todMaxAvailAmt + "|" + BANCS.STDIN.contextBankId
						sv_r = urhk_dbSqlWithBind(sv_i)
						IF (sv_r == 0) THEN
						#{
							sv_r = urhk_dbSqlWithBind("COMMIT")
							sv_q = "INSERT INTO CATOD_AVAILMENT_HIST_TABLE SELECT * FROM CUSTOM.CATOD_AVAILMENT_TABLE WHERE BANK_ID = ?SVAR AND REQUEST_ID = ?SVAR"
							print(sv_q)
							BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + OTOD.VARS.todAcctAvailId
							sv_i = urhk_dbSqlWithBind(sv_q)
							IF (sv_i == 0) THEN
							#{
								sv_i = urhk_dbSqlWithBind("COMMIT")
							#}
							ENDIF
						#}
						ENDIF
						
						BANCS.OUTPUT.ReservedField1 = OTOD.VARS.todAcctStatus + " TOD created sucessfully"
						BANCS.OUTPUT.RespCode = "00"
						BANCS.OUTPUT.successOrFailure="S"
						
					#}
					ENDIF
					## tod userhk end if ##
				#}
				ENDIF
				
				## validations if chk ##
				#}
			ELSE
				#{
				print(BANCS.OUTPARAM.acctstat)
				IF(mid$(BANCS.OUTPARAM.acctstat,0,2) == "81") THEN
				#{
					BANCS.OUTPUT.ReservedField1 = OTOD.VARS.todAcctStatus
					BANCS.OUTPUT.RespCode = "81"
					BANCS.OUTPUT.successOrFailure="F"
					exitscript
				#}
				ENDIF
				IF(mid$(BANCS.OUTPARAM.acctstat,0,2) == "82") THEN
				#{
					BANCS.OUTPUT.ReservedField1 = OTOD.VARS.todAcctStatus
					BANCS.OUTPUT.RespCode = "82"
					BANCS.OUTPUT.successOrFailure="F"
					exitscript
				#}
				ENDIF
				IF(mid$(BANCS.OUTPARAM.acctstat,0,2) == "83") THEN
				#{
					BANCS.OUTPUT.ReservedField1 = OTOD.VARS.todAcctStatus
					BANCS.OUTPUT.RespCode = "83"
					BANCS.OUTPUT.successOrFailure="F"
					exitscript
				#}
				ENDIF
				BANCS.OUTPUT.ReservedField1 = OTOD.VARS.todAcctStatus
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				exitscript
			#}
			ENDIF
			
			## tod amt if chk ##
			#}
		ELSE
			#{
			BANCS.OUTPUT.ReservedField1 = "TOD requested amount is less THEN minimum amount limit"
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure="F"
		#}
		ENDIF
		
		#}
	ELSE
		#{
		BANCS.OUTPUT.ReservedField1 = "Not a valid TOD request call"
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure="F"
		
		# main if AUTOTOD chk end if ##
	#}
	ENDIF
	
	print(BANCS.OUTPUT.ReservedField1)
	print(BANCS.OUTPUT.RespCode)
	print(BANCS.OUTPUT.successOrFailure)
	
	## Rep OTOD & Class VARS is deleted ##
	
	ENDOFSCRIPT:
		IF(CUST.ATM.errMsg != "" ) THEN
		#{
			print(CUST.ATM.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
			BANCS.OUTPUT.RespCode = "99"
		#}
		ENDIF
		
		TRACE OFF
		
		exitscript
