########Cash Cloud Charge Collection Logic: CHG0034907 ##########
IF(BANCS.INPUT.DccId == "POL") THEN
	IF (BANCS.INPUT.ReservedField2 !="") THEN
		IF ( (BANCS.INPUT.ReservedField2 =="EAZYBIZ") OR (BANCS.INPUT.ReservedField2 =="EAZYBIZEFT") ) THEN
			IF ((fieldexists(BANCS.INPUT.RespCode)==1) and (fieldexists(BANCS.OUTPUT.TranId)==1) and (fieldexists(CUST.ATM.LowBalInd)==1)) THEN
				IF (BANCS.OUTPUT.TranId !="") THEN
					PRINT(CUST.ATM.LowBalInd)
					CUST.ATM.chrgFlg =""
					CUST.ATM.refNum =""
					CUST.ATM.narrDrChrg =""
					CUST.ATM.narrCrChrg=""
					CUST.ATM.TranId = BANCS.OUTPUT.TranId

					#VALIDATING THE TRAN_ID 
					sv_z ="count|select count(*) from tbaadm.dtd where tran_id =?SVAR and tran_date =to_date(?SVAR, 'dd-mm-yyyy HH24:MI:SS') "
					sv_z =sv_z + " and del_flg='N' and pstd_flg='Y' and bank_id= ?SVAR and pstd_user_id =?SVAR  "
					print(sv_z)
					BANCS.INPARAM.BINDVARS = CUST.ATM.TranId + "|" + BANCS.STDIN.BODDate + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId  
					print(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_z)
					print(sv_d)
					IF (sv_d == 0) THEN
						CUST.ATM.count = BANCS.OUTPARAM.count
						print(CUST.ATM.count)
						IF (CUST.ATM.count< 1) THEN
							CUST.ATM.chrgFlg = "N"
						ELSE
							CUST.ATM.chrgFlg = "Y"
						ENDIF
					ENDIF

					IF(CUST.ATM.chrgFlg == "Y")THEN
						IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum) == 1) THEN
						#{
							IF (BANCS.INPUT.ConsumerNum !="") THEN 
							#{
								sv_p = getposition(BANCS.INPUT.ConsumerNum,"|")
								print (sv_p)
								IF (sv_p ==0 ) THEN
									sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.ConsumerNum)
									IF (sv_u == 0) THEN
										IF (BANCS.OUTPARAM.schmCode=="INCOM") THEN
											CUST.ATM.TranFeeContraAcct1 = BANCS.INPUT.ConsumerNum
										ELSE
											BANCS.OUTPUT.RespCode = "99"
											BANCS.OUTPUT.ReservedField3 = "Income Account Defined is not INCOM Type GL:Field 63"
											BANCS.OUTPUT.successOrFailure="F"
										ENDIF
									ELSE
										BANCS.OUTPUT.RespCode = "99"
										BANCS.OUTPUT.ReservedField3 = "Income Account Defined is invalid:Field 63"
										BANCS.OUTPUT.successOrFailure="F"
									ENDIF
								ELSE
									sv_m = MID$(BANCS.INPUT.ConsumerNum, 0, sv_p-1)
									PRINT(sv_m)
									sv_u = urhk_getAcctDetailsInRepository(sv_m)
									IF (sv_u == 0) THEN
										CUST.ATM.TranFeeCustAcct1 = sv_m			
									ELSE
										BANCS.OUTPUT.RespCode = "99"
										BANCS.OUTPUT.ReservedField3 = "Debit Fee Acct Defined is invalid:Field 63"
										BANCS.OUTPUT.successOrFailure="F"			
									ENDIF
									sv_m = MID$(BANCS.INPUT.ConsumerNum,sv_p, 16)
									PRINT(sv_m)	
									sv_u = urhk_getAcctDetailsInRepository(sv_m)
									IF (sv_u == 0) THEN
										IF (BANCS.OUTPARAM.schmCode=="INCOM") THEN				
											CUST.ATM.TranFeeContraAcct1 = sv_m
										ELSE
											BANCS.OUTPUT.RespCode = "99"
											BANCS.OUTPUT.ReservedField3 = "Income Account Defined is not INCOM Type GL:Field 63"
											BANCS.OUTPUT.successOrFailure="F"
										ENDIF
									ELSE
										BANCS.OUTPUT.RespCode = "99"
										BANCS.OUTPUT.ReservedField3 = "Income Account Defined is invalid:Field 63"
										BANCS.OUTPUT.successOrFailure="F"
									ENDIF
								ENDIF

								#---------------------------------
								#  Narrations
								#-----------------------------------

								IF((fieldexists(BANCS.INPUT.CardAcceptorName)==1) )THEN
									IF(BANCS.INPUT.CardAcceptorName !="")THEN
										PRINT(BANCS.INPUT.CardAcceptorName)
										CUST.ATM.refNum = BANCS.INPUT.CardAcceptorName
									ELSE
										CUST.ATM.refNum = ""
									ENDIF
								ELSE
									CUST.ATM.refNum = ""
								ENDIF

								IF( (fieldexists(CUST.ATM.narrDrFee)==1) ) THEN 
									IF(CUST.ATM.narrDrFee !="")THEN
										PRINT(CUST.ATM.narrDrFee)
										CUST.ATM.narrDrChrg = CUST.ATM.narrDrFee
									ELSE
										IF((fieldexists(CUST.ATM.narration)==1) ) THEN
											IF(CUST.ATM.narration !="")THEN
												CUST.ATM.narrDrChrg="CHARGES: " + CUST.ATM.narration
											ELSE
												CUST.ATM.narrDrChrg="CHARGES " + CUST.ATM.refNum
											ENDIF 
										ELSE
											CUST.ATM.narrDrChrg="CHARGES " + CUST.ATM.refNum
										ENDIF
									ENDIF
								ELSE
									CUST.ATM.narrDrChrg="CHARGES " + CUST.ATM.refNum
								ENDIF

								IF( (fieldexists(CUST.ATM.narrCrFee)==1) ) THEN 
									IF(CUST.ATM.narrCrFee !="")THEN
										PRINT(CUST.ATM.narrCrFee)
										CUST.ATM.narrCrChrg = CUST.ATM.narrCrFee
									ELSE
										IF((fieldexists(CUST.ATM.narration)==1) ) THEN
											IF(CUST.ATM.narration !="")THEN
												CUST.ATM.narrCrChrg="CHARGES: " + CUST.ATM.narration
											ELSE
												CUST.ATM.narrCrChrg="CHARGES " + CUST.ATM.refNum
											ENDIF 
										ELSE
											CUST.ATM.narrCrChrg="CHARGES " + CUST.ATM.refNum
										ENDIF
									ENDIF
								ELSE
									CUST.ATM.narrCrChrg="CHARGES " + CUST.ATM.refNum
								ENDIF 

								print(CUST.ATM.TranFeeCustAcct1)
								print(CUST.ATM.TranFeeContraAcct1)
								print(CUST.ATM.feeAmt)
								print(CUST.ATM.narrDrChrg)
								print(CUST.ATM.narrCrChrg)

								call("copyBancsToCustC24.scr")
								call("CC_SalUPLCharge.scr")
								call("copyCust24ToBancs.scr")

								IF( (fieldexists(CUST.ATM.errMsg)==1) ) THEN
									IF(CUST.ATM.errMsg !="") THEN
										BANCS.OUTPUT.RespCode = "99"
										BANCS.OUTPUT.ReservedField3 = CUST.ATM.errMsg
										BANCS.OUTPUT.successOrFailure="F"
										EXITSCRIPT
									ENDIF
								ENDIF 
							#}
							ENDIF
						#}
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
######## END OF Cash Cloud Charge Collection Logic: CHG0034907 ##########

	IF ((BANCS.INPUT.DccId=="ESC") OR (BANCS.INPUT.DccId=="PVT") ) then
		IF (fieldexists(BANCS.INPUT.Foracid) == 1) THEN 
			Print (BANCS.INPUT.Foracid)
			IF  ( STRLEN(BANCS.INPUT.Foracid) > 16 ) THEN
				BANCS.INPARAM.iban_number =BANCS.INPUT.Foracid
				sv_u = urhk_getForacidFromIBANnumber("")
				PRINT(sv_u)
				IF(sv_u!=0) THEN
					BANCS.OUTPUT.ReservedField3="Coge Accts invalid"
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					exitscript
				ELSE
					BANCS.INPUT.Foracid = BANCS.OUTPARAM.foracid
					print (BANCS.INPUT.Foracid)
				ENDIF
			ENDIF
		ENDIF
		IF (fieldexists(BANCS.INPUT.CrForacid) == 1) THEN 
			Print (BANCS.INPUT.CrForacid)
			IF  ( STRLEN(BANCS.INPUT.CrForacid) > 16 ) THEN
				BANCS.INPARAM.iban_number =BANCS.INPUT.CrForacid
				sv_u = urhk_getForacidFromIBANnumber("")
				PRINT(sv_u)
				IF(sv_u!=0) THEN
					BANCS.OUTPUT.ReservedField3="Coge Accts invalid"
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					exitscript
				ELSE
					BANCS.INPUT.CrForacid = BANCS.OUTPARAM.foracid
					print (BANCS.INPUT.CrForacid)
				ENDIF
			ENDIF
		ENDIF
	ENDIF

	#-------------------------------------------------Edwin IMT/C2B
	#------------------------------edwin zico for C2B TPG CTASK0013354 CHG0031543 24112022+CTASK0013441_30112022
	if(fieldexists(BANCS.OUTPUT.CardAcceptorName)==1)then
		print(BANCS.OUTPUT.CardAcceptorName)
		CUST.ATM.CardAcceptor = MID$(BANCS.OUTPUT.CardAcceptorName,0,6)
		print(CUST.ATM.CardAcceptor)

	else
		CUST.ATM.CardAcceptor = ""
		BANCS.OUTPUT.CardAcceptorName = ""
	endif
	if(fieldexists(BANCS.INPUT.ReservedField1)==1)then
		if(MID$(BANCS.INPUT.ReservedField1,0,6) == "RTXINQ")THEN
			call("c2bTranCheck.scr")
			exitscript
		endif
	endif
		
	if(fieldexists(BANCS.INPUT.Foracid)==1)then
		sv_b = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
		if(sv_b == 0) then
			CUST.ATM.acctSolId = BANCS.OUTPARAM.acctSolId
			print(CUST.ATM.acctSolId)
			CUST.ATM.schmCode = BANCS.OUTPARAM.schmCode
			print(CUST.ATM.schmCode)
			CUST.ATM.acctName = BANCS.OUTPARAM.acctName
			print(CUST.ATM.acctName)
			CUST.ATM.cifId = BANCS.OUTPARAM.cifId
			print(CUST.ATM.cifId)
			CUST.ATM.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
			print(CUST.ATM.acctCrncyCode)
			CUST.ATM.freezeCode = BANCS.OUTPARAM.freezeCode
			print(CUST.ATM.freezeCode)
			CUST.ATM.freezeReasonCode = BANCS.OUTPARAM.freezeReasonCode
			print(CUST.ATM.freezeReasonCode)
			CUST.ATM.schmType = BANCS.OUTPARAM.schmType
			print(CUST.ATM.schmType)
		else
			CUST.ATM.acctSolId = ""
			CUST.ATM.schmCode = ""
			CUST.ATM.acctName = ""
			CUST.ATM.cifId = ""
			CUST.ATM.acctCrncyCode = ""
			CUST.ATM.freezeCode = ""
			CUST.ATM.freezeReasonCode = ""	
			CUST.ATM.schmType = ""
		endif
	else
		CUST.ATM.acctSolId = ""
		CUST.ATM.schmCode = ""
		CUST.ATM.acctName = ""
		CUST.ATM.cifId = ""
		CUST.ATM.acctCrncyCode = ""
		CUST.ATM.freezeCode = ""
		CUST.ATM.freezeReasonCode = ""
		CUST.ATM.schmType = ""
	endif	
	
	if(BANCS.INPUT.DccId == "TPG")then
		if((fieldexists(BANCS.INPUT.RespCode)==1) and (fieldexists(BANCS.OUTPUT.TranId)==1))then
			CUST.ATM.TranId = BANCS.OUTPUT.TranId
		else
			CUST.ATM.TranId = "NA"
		endif
		BANCS.OUTPUT.ReservedField3 = CUST.ATM.TranId
	endif

	if (BANCS.INPUT.DccId == "ESC") then
		IF (BANCS.INPUT.Command != "FSIS") THEN		
			if((fieldexists(BANCS.INPUT.RespCode)==1) and (fieldexists(BANCS.OUTPUT.TranId)==1))then
				CUST.ATM.TranId = BANCS.OUTPUT.TranId
			else
				CUST.ATM.TranId = "NA"
			endif
			BANCS.OUTPUT.ReservedField3 = CUST.ATM.TranId
		ENDIF
	ENDIF
	
	
	if((BANCS.OUTPUT.CardAcceptorName=="TPG") and (BANCS.INPUT.DeviceId=="CAMPAIGN"))then
	
		#-------muthokinjo/Biller direct transfer block Edwin Zico
		sv_z ="CountBill|select count(*) from tbaadm.brgt where free_text1 =?SVAR and del_flg ='N' and bank_id =?SVAR and entity_cre_flg ='Y' and FREE_TEXT4 in ('R','L','LR','N')and rownum <2 "
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.Foracid + "|" + BANCS.STDIN.contextBankId
		print(sv_z)
		sv_d = urhk_dbSelectWithBind(sv_z)
		print(sv_d)
		if(sv_d == 0)then
			CUST.ATM.CountBill = BANCS.OUTPARAM.CountBill
		else
			CUST.ATM.CountBill = 0
		endif
		if(cdouble(CUST.ATM.CountBill) >=1)then
			CUST.ATM.freezeCode="C"
		endif

		sv_z = "phonenum,natid|select PHONENO,nat_id_card_num FROM tbaadm.cphone c, tbaadm.cmg g where c.PREFERREDFLAG ='Y' and PHONE_B2KID = g.cif_id and g.cif_id =?SVAR "
		sv_z = sv_z + " and g.bank_id =?SVAR and g.bank_id = c.bank_id and rownum <2 "
		BANCS.INPARAM.BINDVARS = CUST.ATM.cifId + "|" + BANCS.STDIN.contextBankId
		lv_d = urhk_dbSelectWithBind(sv_z)
		if(lv_d==0)then
			CUST.ATM.phonenum = BANCS.OUTPARAM.phonenum
			print(CUST.ATM.phonenum)
			CUST.ATM.natid = BANCS.OUTPARAM.natid
			print(CUST.ATM.natid)
		else
			CUST.ATM.phonenum = ""
			CUST.ATM.natid = ""
		endif

		lv_b="name,idnum|select regexp_replace (?SVAR, '/', '') name,regexp_replace (?SVAR, '/', '') idnum from dual "
		BANCS.INPARAM.BINDVARS = CUST.ATM.acctName + "|" + CUST.ATM.natid
		lv_c = urhk_dbSelectWithBind(lv_b)
		if(lv_c==0)then
			sv_n = BANCS.OUTPARAM.name
			sv_d = BANCS.OUTPARAM.idnum
		else
			sv_n = ""
			sv_d = ""
		endif

		lv_j = urhk_B2k_ForacidToAcid(BANCS.INPUT.Foracid)
		if(lv_j == 0) then
			lv_g = BANCS.OUTPARAM.Acid
		else
			lv_g = ""
		endif
		BANCS.INPARAM.acid = lv_g
		print(BANCS.INPARAM.acid)
		if(lv_g != "") then
			lv_n = urhk_getAcctStatus("")
			if (lv_n == 0) then
				CUST.ATM.acctStatus = BANCS.OUTPARAM.acctStatus
				print(CUST.ATM.acctStatus)
			else
				CUST.ATM.acctStatus = ""
			endif
		else
			CUST.ATM.acctStatus = ""
		endif
		IF(CUST.ATM.CardAcceptor=="TPG")THEN
			BANCS.OUTPUT.ReservedField1=sv_n+"/"+sv_d+"/"+CUST.ATM.phonenum +"/"+CUST.ATM.schmType+"/"+CUST.ATM.freezeCode+"/"+CUST.ATM.acctStatus+"/"+CUST.ATM.acctCrncyCode
			PRINT(BANCS.OUTPUT.ReservedField1)
		ELSE
			BANCS.OUTPUT.ReservedField1=sv_n+"/"+sv_d+"/"+CUST.ATM.phonenum +"/"+CUST.ATM.schmType+"/"+CUST.ATM.freezeCode+"/"+CUST.ATM.acctStatus
			PRINT(BANCS.OUTPUT.ReservedField1)
		ENDIF
	endif
	#-------------------------------------------------
	
	IF ((BANCS.INPUT.DccId == "SMS" ) AND (BANCS.INPUT.DeviceId=="CAMPAIGN") AND (BANCS.OUTPUT.Command=="ACIS") and (CUST.ATM.CardAcceptor!="IMTINQ") and (CUST.ATM.CardAcceptor!="TPG") ) THEN
	#{
		PRINT(BANCS.INPUT.Foracid)
		sv_s = "name,custId,number,id "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT RPAD(GAM.acct_name,80,' '),GAM.cif_id,PHONENO,CMG.nat_id_card_num "
		sv_s = sv_s + " FROM tbaadm.cphone cphone,TBAADM.GAM , TBAADM.CMG "
		sv_s = sv_s + " WHERE cphone.PHONE_B2KID=GAM.cif_id AND cphone.PHONE_B2KID=CMG.cif_id  AND CMG.cif_id=GAM.cif_id "
		sv_S = sv_s + " AND cphone.PREFERREDFLAG='Y' "
		sv_s = sv_s + " AND GAM.foracid = ?SVAR "
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
		sv_s = sv_s + " AND GAM.bank_id = cphone.bank_id AND CMG.bank_id = cphone.bank_id   AND GAM.bank_id = CMG.bank_id AND rownum<2 "
		BANCS.INPARAM.BINDVARS = CUST.ATM.acctnt + "|" + BANCS.STDIN.contextBankId
		PRINT(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.name)
			PRINT(BANCS.OUTPARAM.id)
			PRINT(BANCS.OUTPARAM.custId)
			PRINT(BANCS.OUTPARAM.number)
			BANCS.OUTPUT.ReservedField1=BANCS.OUTPARAM.name+"/"+BANCS.OUTPARAM.id+"/"+BANCS.OUTPARAM.number
			PRINT(BANCS.OUTPUT.ReservedField1)
		#}
		ELSE
		#{
			PRINT(BANCS.INPUT.Foracid)
			sv_s = "name,custId,number,id "
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT RPAD(GAM.acct_name,80,' '),GAM.cif_id,gam.del_flg,CMG.nat_id_card_num "
			sv_s = sv_s + " FROM TBAADM.GAM , TBAADM.CMG "
			sv_s = sv_s + " WHERE CMG.cif_id=GAM.cif_id "
			sv_s = sv_s + " AND GAM.foracid = ?SVAR "
			sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
			sv_s = sv_s + " AND GAM.bank_id = CMG.bank_id AND rownum<2 "
			BANCS.INPARAM.BINDVARS = CUST.ATM.acctnt + "|" + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				PRINT(BANCS.OUTPARAM.name)
				PRINT(BANCS.OUTPARAM.id)
				PRINT(BANCS.OUTPARAM.custId)
				BANCS.OUTPARAM.number=""
				PRINT(BANCS.OUTPARAM.number)
				BANCS.OUTPUT.ReservedField1=BANCS.OUTPARAM.name+"/"+BANCS.OUTPARAM.id+"/"+BANCS.OUTPARAM.number
				PRINT(BANCS.OUTPUT.ReservedField1)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (BANCS.INPUT.DccId == "WPD")  THEN
	#{
		IF (BANCS.OUTPUT.ReservedField1 !="") THEN
		#{
			PRINT(BANCS.OUTPUT.ReservedField1)
			sv_u = urhk_getAcctDetailsInRepository(BANCS.OUTPUT.ReservedField1)
			IF (sv_u == 0) THEN
			#{
				PRINT(BANCS.OUTPARAM.acctSolId)
				PRINT(BANCS.OUTPARAM.acctName)
				PRINT(BANCS.OUTPARAM.custId)
				
				PRINT(BANCS.OUTPUT.ReservedField1)
				sv_k = MID$(BANCS.OUTPARAM.acctName,0,45)
				PRINT(sv_k)
				BANCS.OUTPUT.ReservedField1 = sv_k
				PRINT(BANCS.OUTPUT.ReservedField1)
				BANCS.OUTPUT.ReservedField2 =""
				
				IF (BANCS.OUTPUT.DeviceId != "") THEN
				#{
					
					sv_s = "solId,account "
					sv_s = sv_s + " | "
					sv_s = sv_s + " SELECT AGT.sol_id,GAM.foracid "
					sv_s = sv_s + " FROM TBAADM.AGT,TBAADM.GAM "
					sv_s = sv_s + " WHERE AGT.oper_credit_acid = GAM.acid "
					sv_s = sv_s + " AND GAM.acct_cls_flg != 'Y'"
					sv_s = sv_s + " AND agent_code = ?SVAR"
					sv_s = sv_s + " AND GAM.bank_id = ?SVAR AND rownum<2"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|"+ BANCS.STDIN.contextBankId
					sv_d =urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF  (sv_d == "0") THEN
					#{
						CUST.ATM.Agentaccount=BANCS.OUTPARAM.account
						PRINT(CUST.ATM.Agentaccount)
						sv_o = CUST.ATM.Agentaccount
						PRINT(sv_o)
						IF (sv_o !="") THEN
						#{
