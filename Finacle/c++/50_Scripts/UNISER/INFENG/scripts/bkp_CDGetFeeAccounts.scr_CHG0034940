		IF (BANCS.INPUT.ReservedField2=="SAI") THEN
			BANCS.OUTPUT.TranFeeCustAcct1 = BANCS.INPUT.CrForacid
			BANCS.OUTPUT.TranFeeCustAcct2 = BANCS.INPUT.CrForacid
			BANCS.OUTPUT.TranFeeCustAcct3 = BANCS.INPUT.CrForacid
		ENDIF
	ENDIF
	IF (FIELDEXISTS(BANCS.OUTPUT.TranFeeContraAcct1)) THEN
		BANCS.OUTPUT.TranFeeContraAcct1 = BANCS.OUTPUT.TranFeeContraAcct1
		print(BANCS.OUTPUT.TranFeeContraAcct1)
		BANCS.OUTPUT.TranFeeContraAcct2= BANCS.OUTPUT.TranFeeContraAcct1
		print(BANCS.OUTPUT.TranFeeContraAcct2)
		BANCS.OUTPUT.TranFeeContraAcct3 = BANCS.OUTPUT.TranFeeContraAcct1
		print(BANCS.OUTPUT.TranFeeContraAcct3)
	ENDIF
ENDIF

IF ((BANCS.INPUT.DccId == "EFR") OR (BANCS.INPUT.DccId == "EFI")) THEN
	IF (BANCS.INPUT.CardAcceptorName=="Efront Withdrawal") THEN
		print("amin")
		CUST.ATM.bacid="PNLCAC"
		print(CUST.ATM.bacid)
		IF (FIELDEXISTS(BANCS.INPUT.SolId)) THEN
			CUST.ATM.solid = BANCS.INPUT.SolId
			print(CUST.ATM.solid)
		ELSE
			CUST.ATM.solid ="4000"
			print(CUST.ATM.solid)
		ENDIF
		sv_x = "contra|select foracid from tbaadm.GAM where BANK_ID = ?SVAR AND sol_id = ?SVAR"
		sv_x = sv_x + " and BACID = ?SVAR"
		sv_x = sv_x + " and DEL_FLG ='N' "
		sv_x = sv_x + " AND acct_crncy_code = ?SVAR "
		print(sv_x)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.ATM.solid + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.homeCrncyCode
		sv_r =urhk_dbSelectWithBind(sv_x)
		print(sv_r)
		IF (sv_r == "0") THEN
			BANCS.OUTPUT.TranFeeContraAcct1= BANCS.OUTPARAM.contra
			print(BANCS.OUTPUT.TranFeeContraAcct1)
		ENDIF
	ENDIF
ENDIF



IF (BANCS.INPUT.DccId=="PVT") THEN
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
	
		#BANCS.OUTPUT.TranFeeContraAcct1 = "4000650010082"
		#Print (CUST.ATM.solid)
		
		IF (BANCS.INPUT.ReservedField2== "PVATM") THEN			
			BANCS.OUTPUT.TranFeeContraAcct1 = "4000650013379"
			print(BANCS.OUTPUT.TranFeeContraAcct1) 			
			BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.solid + "650013379"
			print (BANCS.OUTPUT.TranFeeContraAcct1)			                       
                ENDIF
		IF (BANCS.INPUT.ReservedField2== "PVBAL") THEN			
			BANCS.OUTPUT.TranFeeContraAcct1 = "4000650013380"
			print(BANCS.OUTPUT.TranFeeContraAcct1)    
			BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.solid + "650013380"
			print (BANCS.OUTPUT.TranFeeContraAcct1)
                ENDIF
		IF (BANCS.INPUT.ReservedField2== "PVMIN") THEN			
			BANCS.OUTPUT.TranFeeContraAcct1 = "4000650013341"
			print(BANCS.OUTPUT.TranFeeContraAcct1)
			BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.solid + "650013341"
			print (BANCS.OUTPUT.TranFeeContraAcct1)

                ENDIF
		IF (BANCS.INPUT.ReservedField2== "MSCATM") THEN			
			BANCS.OUTPUT.TranFeeContraAcct1 = "4000650013411"
			print(BANCS.OUTPUT.TranFeeContraAcct1)                        
                ENDIF
		IF (BANCS.INPUT.ReservedField2== "RSWATM") THEN			
			BANCS.OUTPUT.TranFeeContraAcct1 = "4000650013401"
			print(BANCS.OUTPUT.TranFeeContraAcct1)                        
                ENDIF
        ENDIF
ENDIF

IF (BANCS.INPUT.DccId=="ESC") THEN
	BANCS.OUTPUT.TranFeeContraAcct1 = "4000650013356"
	BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.solid + "650013356"
	print (BANCS.OUTPUT.TranFeeContraAcct1)
	IF (FIELDEXISTS(BANCS.INPUT.DeviceId)) THEN
		BANCS.INPUT.DeviceId= trim(BANCS.INPUT.DeviceId)
		IF (BANCS.INPUT.DeviceId=="Ebank" ) THEN
			BANCS.OUTPUT.TranFeeContraAcct1 = "4000650013358"
			BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.solid + "650013358"
			print (BANCS.OUTPUT.TranFeeContraAcct1)
		ENDIF
	ENDIF
ENDIF

IF  (BANCS.INPUT.DccId == "VER") THEN
	IF (FIELDEXISTS(BANCS.INPUT.CrForacid) == 1) THEN
		CUST.ATM.bacid="RTGSCOMM"
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
		print(sv_u)
		IF (sv_u != 0) THEN
			BANCS.OUTPUT.RespCode = "03"
			BANCS.OUTPUT.successOrFailure = "F"
			BANCS.OUTPUT.ReservedField3 = "CR acct is invalid"
			GOTO ENDOFSCRIPT
		ELSE
			CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
		ENDIF

		sv_s = "contra "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT foracid "
		sv_s = sv_s + " FROM GAM "
		sv_s = sv_s + " WHERE sol_id = ?SVAR "
		sv_s = sv_s + " AND bacid = ?SVAR "
		sv_s = sv_s + " AND del_flg ='N' "
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
		sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
		sv_d =urhk_dbSelectWithBind(sv_s)
		IF (sv_d == "0") THEN
			BANCS.OUTPUT.TranFeeContraAcct1 = BANCS.OUTPARAM.contra
			BANCS.OUTPUT.TranFeeCustAcct1 = BANCS.INPUT.CrForacid
		else
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.ReservedField3 = "Income Account could not be Arrived"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		endif
	ENDIF
ENDIF


ENDOFSCRIPT:
IF(CUST.ATM.errMsg != "" ) THEN
#{
    print(CUST.ATM.errMsg)
    BANCS.OUTPUT.successOrFailure = "F"
    BANCS.OUTPUT.RespCode = "99"
#}
ENDIF

