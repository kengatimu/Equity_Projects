				GOTO ENDOFSCRIPT
			ELSE
			 CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
			ENDIF
		ENDIF
		IF ((BANCS.INPUT.ReservedField2=="P2PIntraMer") OR (BANCS.INPUT.ReservedField2=="P2PIntraMerPayBill")) THEN
			IF (FIELDEXISTS(BANCS.INPUT.DeviceId) == 1) THEN
				CUST.ATM.solid = mid$(BANCS.INPUT.DeviceId,0,4)
				print(CUST.ATM.solid)
				sv_k = "Countsolid| SELECT count(1) "
				sv_k = sv_k + " from tbaadm.sol "
				sv_k = sv_k + " where sol_id = ?SVAR "
				sv_k = sv_k + " AND BANK_ID = ?SVAR "
				sv_k = sv_k + " AND del_flg = 'N' "
				BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				PRINT(sv_k)
				sv_h = urhk_dbselectWithBind(sv_k)
				PRINT(sv_h)
				IF (sv_h  == 0) THEN
					CUST.ATM.Countsolid = BANCS.OUTPARAM.Countsolid
					PRINT(CUST.ATM.Countsolid)
					IF (CINT(CUST.ATM.Countsolid)<1) THEN
						BANCS.OUTPUT.ReservedField3 = "Please Supply Valid Sol_id "
						print(BANCS.OUTPUT.ReservedField3)
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						EXITSCRIPT
					ENDIF
				ELSE
					BANCS.OUTPUT.ReservedField3 = "Please Supply Valid Sol_id "
					print(BANCS.OUTPUT.ReservedField3)
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					EXITSCRIPT
				ENDIF
			ENDIF
