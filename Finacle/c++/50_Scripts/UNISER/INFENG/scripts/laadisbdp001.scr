<--START
CHECKSUM="18b0b0f158c6b8cc13e1eb93f0bb75cb41ac00e9f8a9aa3b7fde45039ec70ec7"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	#Initializing Required variables
	#-------------------------------------------------------------------------------
	sv_u = urhk_Setorbout("Error|dummy")
	sv_u = urhk_Setorbout("formTypeFlg|dummy")
	sv_u = urhk_Setorbout("loanAmt|dummy")
	sv_u = urhk_Setorbout("laceAmt|dummy")
	sv_u = urhk_Setorbout("insuAmt|dummy")
	sv_u = urhk_Setorbout("contribution|dummy")
	sv_u = urhk_Setorbout("loanFee|dummy")
	sv_u = urhk_Setorbout("crAcctId|dummy")
	
	#------------------------------------------------------------------------------
	# Getting acctId code from front end
	#------------------------------------------------------------------------------
	CUST.LADISB.loanAcctId = BANCS.INPUT.loanAcctId
	CUST.LADISB.disbAmt = BANCS.INPUT.disbAmt
	print(CUST.LADISB.loanAcctId)
	print(CUST.LADISB.disbAmt)
	
	#------------------------------------------------------------------------------
	# Calling common script for common values
	#------------------------------------------------------------------------------
	print(CUST.LADISB.loanAcctId)
	CALL("laadisbdp004.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	print(CUST.LADISB.laSchmCode)
	print(CUST.CPARAM.stSchmCode)
	#print(CUST.CPARAM.ipoSchmCode)
	
	IF (CUST.LADISB.loanType == "S" ) THEN
	#{
		sv_u = urhk_Setorbout("formTypeFlg|"+CUST.LADISB.loanType)
		sv_u = urhk_Setorbout("loanAmt|"+CUST.LADISB.loanAmt)
		sv_u = urhk_Setorbout("laceAmt|"+CUST.LADISB.laceAmt)
		sv_u = urhk_Setorbout("insuAmt|"+CUST.LADISB.insuAmt)
		sv_u = urhk_Setorbout("contribution|"+CUST.LADISB.contribution)
		sv_u = urhk_Setorbout("crAcctId|"+CUST.LADISB.crAcctId)
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
