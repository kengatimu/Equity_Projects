	#}
	ENDIF
	
	COLL.GLBDATA.tranDate = LEFT$(COLL.GLBDATA.tranDate,10)
	PRINT(COLL.GLBDATA.tranDate)
	IF (FIELDEXISTS(CASH.WITH.type) AND FIELDEXISTS(CASH.WITH.stype)) THEN
	#{
		PRINT(CASH.WITH.type)
		PRINT(CASH.WITH.stype)
		PRINT(BANCS.STDIN.mySolId)
		PRINT(CUST.CPARAM.mySolId1)
		IF (BANCS.STDIN.contextBankId != "56") THEN
		#{
			IF ((CASH.WITH.type == "T") AND (CASH.WITH.stype == "CI") AND (BANCS.STDIN.mySolId != CUST.CPARAM.mySolId1)) THEN
			#{
				sv_s = "owner,schmtype|"
				sv_s = sv_s + " SELECT GAM.acct_ownership,GAM.schm_type"
				sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
				sv_s = sv_s + " WHERE GAM.acid = DTD.acid"
				sv_s = sv_s + " AND DTD.tran_id = LPAD(?SVAR,9)"
				sv_s = sv_s + " AND DTD.part_tran_type='C'"
				sv_s = sv_s + " AND DTD.del_flg != 'Y'"
				sv_s = sv_s + " AND GAM.bank_id = DTD.bank_id"
				#sv_s = sv_s + " AND part_tran_srl_num = LPAD(?SVAR,4) "
				sv_s = sv_s + " AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
				sv_s = sv_s + " AND rownum < 2"
				print(sv_s)
				#BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.serialnum + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
				BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d=urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d != 0) THEN
				#{
					CUST.TMCHRG.errMMsg = "Error in selecting records"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CASH.WITH.nocharge = BANCS.OUTPARAM.owner
					CASH.WITH.stype = BANCS.OUTPARAM.schmtype
					print(CASH.WITH.nocharge)
					print(CASH.WITH.stype)
				#}
				ENDIF
				
				IF ((CASH.WITH.Trf_Flg == "Y") AND ((CASH.WITH.stype == "CAA") OR (CASH.WITH.stype == "SBA")))THEN
				#{
					CASH.WITH.tfee = "200"
					print(CASH.WITH.tfee)
					
					CASH.WITH.negat ="-1"
					CASH.WITH.Tot_Amt = cdouble(CASH.WITH.tfee)* cdouble(CASH.WITH.negat)
					CASH.WITH.with_amt = CASH.WITH.tfee
					print (CASH.WITH.Tot_Amt)
					print (CASH.WITH.with_amt)
					#CALL("trfchargedp001.scr")
					
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(COLL.GLBDATA.trfevent)
					#CUST.GCHRG.eventId = "TMTRF1"
					CUST.GCHRG.eventId = COLL.GLBDATA.trfevent
					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
						#}
					ELSE
						#{
						PRINT("Failure")
					#}
					ENDIF
					#}
				ELSE
					#{
					CASH.WITH.Tot_Amt = "0"
				#}
				ENDIF
				#}
			ELSE
				#{
				CASH.WITH.Tot_Amt = "0"
			#}
			ENDIF
		#}
		ENDIF
		
		IF ((CASH.WITH.type == "C") AND (CASH.WITH.stype == "NP")) THEN
		#{
			IF (CASH.WITH.Int_Flg == "Y") THEN
			#{
				sv_s = "fxdcrncycode,ratecode,Rate|SELECT fxd_crncy_code,ratecode,var_crncy_units "
				sv_s = sv_s + "FROM TBAADM.RTL "
				sv_s = sv_s + "WHERE fxd_crncy_code = ?SVAR "
				sv_s = sv_s + "AND var_crncy_code = ?SVAR "
				sv_s = sv_s + "AND ratecode = ?SVAR "
				sv_s = sv_s + "AND fxd_crncy_code != ?SVAR "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CASH.WITH.CrncyCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + CASH.WITH.refCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CASH.WITH.fxdcrncycode = BANCS.OUTPARAM.fxdcrncycode
					PRINT(CASH.WITH.fxdcrncycode)
					
					CASH.WITH.ratecode = BANCS.OUTPARAM.ratecode
					PRINT(CASH.WITH.ratecode)
					
					CASH.WITH.Rate = BANCS.OUTPARAM.Rate
					PRINT(CASH.WITH.Rate)
					#}
				ELSE
					#{
					CASH.WITH.Rate = "1"
				#}
				ENDIF
				
				sv_p = CASH.WITH.tran_amt
				BANCS.INPARAM.InputAmount = sv_p
				BANCS.INPARAM.CurrencyCode = CASH.WITH.CrncyCode
				IF (CASH.WITH.CrncyCode == BANCS.STDIN.homeCrncyCode) THEN
				#{
					sv_s = "schmCode|SELECT schm_code FROM tbaadm.gam "
					sv_s = sv_s + "WHERE bank_id = ?SVAR "
					sv_s = sv_s + "AND FORACID = ?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CASH.WITH.Ac_Number
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CASH.WITH.schmCode=BANCS.OUTPARAM.schmCode
						print(CASH.WITH.schmCode)
						
						IF ((BANCS.STDIN.contextBankId== "50") AND ((CASH.WITH.schmCode == "CA200") OR (CASH.WITH.schmCode == "CA203"))) THEN
						#{
							BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode3
							#}
						ELSE
							#{
							BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode1
						#}
						ENDIF
					#}
					ENDIF
					#}
				ELSE
					#{
					BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode2
				#}
				ENDIF
				PRINT(BANCS.INPARAM.AmountTableCode)
				sv_u = urhk_B2k_GetASTMAmount ("")
				IF (sv_u == 1) THEN
				#{
					CASH.WITH.errMsg = "Invalid AmountTableCode"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				sv_q = BANCS.OUTPARAM.OutputAmount
				PRINT(sv_q)

				IF (CASH.WITH.Ac_Number == "4012200501111") THEN
				#{
					sv_q = "5.00"
					print (sv_q)
				#}
				ENDIF
				
				#sv_q contains the charge amount
				sv_m = (CDOUBLE(sv_q) * CDOUBLE(CASH.WITH.Rate))
				#CASH.WITH.negat = CASH.WITH.neg1
				CASH.WITH.negat = "-1"
				CASH.WITH.Tot_Amt = ((sv_m) * CDOUBLE(CASH.WITH.negat))
				CASH.WITH.with_amt = (sv_m)
				PRINT(sv_m)
				
				CASH.WITH.with_desc = CASH.WITH.withDesc2
				PRINT(CASH.WITH.Tot_Amt)
				PRINT(sv_m)
				
				CASH.WITH.With_Flg = "N"
				PRINT(CASH.WITH.With_Flg)
				#}
			ELSE
				#{
				IF (CASH.WITH.With_Flg == "Y") THEN
				#{
					
					sv_s = "fxdcrncycode,ratecode,Rate|SELECT fxd_crncy_code,ratecode,var_crncy_units "
					sv_s = sv_s + "FROM TBAADM.RTL "
					sv_s = sv_s + "WHERE fxd_crncy_code = ?SVAR "
					sv_s = sv_s + "AND var_crncy_code = ?SVAR "
					sv_s = sv_s + "AND ratecode = ?SVAR "
					sv_s = sv_s + "AND fxd_crncy_code != ?SVAR "
					sv_s = sv_s + "AND bank_id = ?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CASH.WITH.CrncyCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + CASH.WITH.refCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CASH.WITH.fxdcrncycode = BANCS.OUTPARAM.fxdcrncycode
						PRINT(CASH.WITH.fxdcrncycode)
						
						CASH.WITH.ratecode = BANCS.OUTPARAM.ratecode
						PRINT(CASH.WITH.ratecode)
						
						CASH.WITH.Rate = BANCS.OUTPARAM.Rate
						PRINT(CASH.WITH.Rate)
						#}
					ELSE
						#{
						CASH.WITH.Rate = "1"
					#}
					ENDIF
					
					sv_p = CASH.WITH.tran_amt
					BANCS.INPARAM.InputAmount = sv_p
					BANCS.INPARAM.CurrencyCode = CASH.WITH.CrncyCode
					IF (CASH.WITH.CrncyCode == BANCS.STDIN.homeCrncyCode) THEN
					#{
						sv_s = "schmCode|SELECT schm_code FROM tbaadm.gam "
						sv_s = sv_s + "WHERE bank_id = ?SVAR "
						sv_s = sv_s + "AND FORACID = ?SVAR"
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CASH.WITH.Ac_Number
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						IF (sv_d == 0) THEN
						#{
							CASH.WITH.schmCode=BANCS.OUTPARAM.schmCode
							print(CASH.WITH.schmCode)
							
							IF ((BANCS.STDIN.contextBankId== "50") AND ((CASH.WITH.schmCode == "CA200") OR (CASH.WITH.schmCode == "CA203"))) THEN
							#{
								BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode3
								#}
							ELSE
								#{
								BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode1
							#}
							ENDIF
						#}
						ENDIF
						#}
					ELSE
						#{
						BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode2
					#}
					ENDIF
					PRINT(BANCS.INPARAM.AmountTableCode)
					sv_u = urhk_B2k_GetASTMAmount ("")
					IF (sv_u == 1) THEN
					#{
						CASH.WITH.errMsg = "Invalid AmountTableCode"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					sv_q = BANCS.OUTPARAM.OutputAmount
					PRINT(sv_q)
					
					#sv_q contains the charge amount
					sv_m = (CDOUBLE(sv_q) * CDOUBLE(CASH.WITH.Rate))
					#CASH.WITH.negat = CASH.WITH.neg1
					CASH.WITH.negat = "-1"
					CASH.WITH.Tot_Amt = ((sv_m) * CDOUBLE(CASH.WITH.negat))
					CASH.WITH.with_amt = (sv_m)
					PRINT(sv_m)
					
					CASH.WITH.with_desc = CASH.WITH.withDesc3
					PRINT(CASH.WITH.Tot_Amt)
					PRINT(sv_m)
					#}
				ELSE
					#{
					CASH.WITH.Tot_Amt = "0"
					PRINT(CASH.WITH.Tot_Amt)
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			CASH.WITH.With_Flg = "N"
			PRINT(CASH.WITH.With_Flg)
			CASH.WITH.Int_Flg = "N"
		#}
		ENDIF
		
		IF (BANCS.STDIN.mySolId == CASH.WITH.solId1) THEN
		#{
			IF (CASH.WITH.ac_sol != CASH.WITH.solId1) THEN
			#{
				CASH.WITH.Tot_Amt = CASH.WITH.totAmt5
				CASH.WITH.with_amt = CASH.WITH.totAmt6
				CASH.WITH.with_desc = CASH.WITH.withDesc2
			#}
			ENDIF
			
			IF (BANCS.STDIN.mySolId == CASH.WITH.solId1) THEN
			#{
				CASH.WITH.Tot_Amt = CASH.WITH.totAmt5
				CASH.WITH.with_amt = CASH.WITH.totAmt6
				CASH.WITH.with_desc = CASH.WITH.withDesc3
			#}
			ENDIF
		#}
		ENDIF
		
		IF (CASH.WITH.Min_Flg == "Y") THEN
		#{
			
			IF (CASH.WITH.schmCode == CUST.CPARAM.schmCode2) THEN
			#{
				CASH.WITH.Min_Amt = cdouble(CASH.WITH.minAmt1)
				#}
			ELSE
				#{
				CASH.WITH.Min_Amt = cdouble(CASH.WITH.minAmt2)
			#}
			ENDIF
			
			IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol1) THEN
			#{
				CASH.WITH.Min_Amt = cdouble(CUST.CPARAM.amt2)
			#}
			ENDIF
			
			IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol3) THEN
			#{
				CASH.WITH.Min_Amt = -1 * cdouble(CUST.CPARAM.amt3)
			#}
			ENDIF
			IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol5) THEN
			#{
				CASH.WITH.Min_Amt = -1 * cdouble(CUST.CPARAM.amt3)
			#}
			ENDIF
			
			IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol4) THEN
			#{
				CASH.WITH.Min_Amt = -1 * cdouble(CUST.CPARAM.amt3)
			#}
			ENDIF
			
			print(CASH.WITH.Min_Amt)
		#}
		ENDIF
		
		IF (CASH.WITH.Shd_Flg == "Y") THEN
		#{
			CASH.WITH.Shd_Amt = (cdouble(CASH.WITH.Shd_Amt) * cdouble(CUST.CPARAM.amt8))  / cdouble(CUST.CPARAM.amt1)
			print(CASH.WITH.Shd_Amt)
			
			IF (cdouble(CASH.WITH.Shd_Amt) < cdouble(CASH.WITH.totAmt8)) THEN
			#{
				CASH.WITH.Shd_Amt = cdouble(CASH.WITH.totAmt8)
				print(CASH.WITH.Shd_Amt)
			#}
			ENDIF
			#print(CASH.WITH.Shd_Amt)
			
			CASH.WITH.Shd_Amt = cint(CASH.WITH.Shd_Amt)
		#}
		ENDIF
		
		
		#--------------------------------------------------------------------------
		# Transaction
		#--------------------------------------------------------------------------
		
		IF ((CASH.WITH.Int_Flg == "Y") OR (CASH.WITH.Min_Flg == "Y") OR (CASH.WITH.Stmp_Flg == "Y") OR (CASH.WITH.Shd_Flg == "Y") OR (CASH.WITH.With_Flg == "Y") ) THEN
		#{
			CUST.GCHRG.tranType = "T"
			CUST.GCHRG.tranSubType = "BI"
			CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
			CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
			
			
			IF (CASH.WITH.With_Flg == "Y") THEN
			#{
				PRINT(COLL.GLBDATA.withevent)
				#CUST.GCHRG.eventId = "TMWITH1"
				CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.eventId = COLL.GLBDATA.withevent
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
					#}
				ELSE
					#{
					PRINT("Failure")
				#}
				ENDIF
			#}
			ENDIF
			
			#--------------------------------------------------
			# Income To intersol cashwith chrg Account(Script based)
			#--------------------------------------------------
			
			IF (CASH.WITH.Int_Flg == "Y") THEN
			#{
				CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(COLL.GLBDATA.intevent)
				#CUST.GCHRG.eventId = "TMINT1"
				CUST.GCHRG.eventId = COLL.GLBDATA.intevent
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
					#}
				ELSE
					#{
					PRINT("Failure")
				#}
				ENDIF
			#}
			ENDIF
			
			#--------------------------------------------------
			# Income To cashwith stamp chrg Account
			#--------------------------------------------------
			
			#IF (CASH.WITH.Stmp_Flg == "Y") THEN
			#{
			#PRINT(COLL.GLBDATA.stmpevent)
			#CUST.GCHRG.eventId = "TMSTMP1"
			#CUST.GCHRG.eventId = COLL.GLBDATA.stmpevent
			#CALL("gchrgcommon.scr")
			#IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
			#	PRINT("Charge collected")
			#}
			#ELSE
			#{
			#	PRINT("Failure")
			#}
			#ENDIF
			#}
			#ENDIF
			
			#--------------------------------------------------
			# Income To shadow balance chrg Account(Script based)
			#--------------------------------------------------
			
			IF (CASH.WITH.Shd_Flg == "Y") THEN
			#{
				CUST.GCHRG.chrgAmt = CASH.WITH.Shd_Amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(COLL.GLBDATA.shdwevent)
				#CUST.GCHRG.eventId = "TMSHDW1"
				CUST.GCHRG.eventId = COLL.GLBDATA.shdwevent
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
					#}
				ELSE
					#{
					PRINT("Failure")
				#}
				ENDIF
			#}
			ENDIF
			
			#--------------------------------------------------
			# Income To MinBal chrg Account(Script based)
			#--------------------------------------------------
			
			IF (CASH.WITH.Min_Flg == "Y") THEN
			#{
				CUST.GCHRG.chrgAmt = CASH.WITH.Min_Amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(COLL.GLBDATA.minevent)
				#CUST.GCHRG.eventId = "TMMIN1"
				CUST.GCHRG.eventId = COLL.GLBDATA.minevent
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
					#}
				ELSE
					#{
					PRINT("Failure")
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		EXITSCRIPT
		#TRACE OFF
END-->
