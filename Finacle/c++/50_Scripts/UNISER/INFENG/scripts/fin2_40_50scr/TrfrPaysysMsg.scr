<--START
CHECKSUM="18bfba05b32d515a65febe654e28a65a10fc654fd9dd2f01701765b65ec13543"
	# For the scripts Some fields from SMH are dumped and Formetted message will be atken as output from script.
	# Based on field values dumped ,customer can FORMAT the message for any PAYMENT SYSTEM.
	
	#Input to the script includes :-
	#-------------------------------
	#		BANCS.INPUT.PaysysId						BANCS.INPUT.RelatedSwSrlNum
	#	    BANCS.INPUT.MTNum							BANCS.INPUT.RelatedMTNum
	#		BANCS.INPUT.SwSrlNum						BANCS.INPUT.RecvrBIC
	#		BANCS.INPUT.SolId							BANCS.INPUT.SenderBIC
	#		BANCS.INPUT.EntityType						BANCS.INPUT.ValueDate
	#		BANCS.INPUT.EntityId						BANCS.INPUT.TxnCrncy
	#		BANCS.INPUT.Status							BANCS.INPUT.TranAmt
	#		BANCS.INPUT.PDEFlag							BANCS.INPUT.SenderRefNum
	#		BANCS.INPUT.STPFlag							BANCS.INPUT.PaysysMsg
	#		BANCS.INPUT.TypeOfMessage
	#
	#Output from the script :-
	#-------------------------------
	#		BANCS.OUTPUT.FormattedPaysysMsg
	#
	#--------------------------------------------------------------------------
	#	Create  Class of some global variables which could be used within diff. functions
	
	TRACE ON
	LIBNAME USRHKSO
	#sv_r=urhk_B2k_PrintRepos("BANCS")
	#PRINT(sv_r)
	PRINT(BANCS.INPUT.PaysysMsg)
	
	IF (REPEXISTS("PAYSYS") == 0) THEN
	#{
		CREATEREP("PAYSYS")
	#}
	ENDIF
	IF (CLASSEXISTS("PAYSYS", "GLBDATA") == 0) THEN
	#{
		CREATECLASS("PAYSYS","GLBDATA",5)
	#}
	ENDIF
	#Following variables are used -
	PAYSYS.GLBDATA.MsgToSplit	=""
	PAYSYS.GLBDATA.CurrTagNum	=""
	PAYSYS.GLBDATA.PrevTagNum	=""
	PAYSYS.GLBDATA.TagSubNum	=""
	PAYSYS.GLBDATA.TagValue 	=""
	PAYSYS.GLBDATA.TagLiteral	=""
	PAYSYS.GLBDATA.PrevTagLiteral=""
	PAYSYS.GLBDATA.CurrRecNum	=""
	PAYSYS.GLBDATA.PrevRecNum	=""
	PAYSYS.GLBDATA.MsgToken		=""
	PAYSYS.GLBDATA.date		=""
	#---------------------------------------------------------------------------
	
	BANCS.OUTPUT.FormattedPaysysMsg = ""
	BANCS.OUTPUT.successOrFailure = "S"
	BANCS.OUTPUT.ErrorDesc = ""
	
	IF((BANCS.INPUT.PaysysId == "SWIFT") OR (BANCS.INPUT.PaysysId == "RTGS")) THEN
	#{
		IF(FIELDEXISTS(BANCS.INPUT.RecvrBIC))THEN
		#{
			sv_a = BANCS.INPUT.RecvrBIC
			PRINT(sv_a)
			sv_l = STRLEN(BANCS.INPUT.RecvrBIC)
			IF(sv_l < 12) THEN
			#{
				WHILE(sv_l < 11)
				#{
					# Padding the Receiver BIC with X if BIC is less than 12 characters to make the BIC 12 characters long
					sv_a = sv_a + 'X'
					sv_l = sv_l + 1
				#}
				DO
			#}
			ENDIF
			sv_b = Mid$(sv_a,0,8) + 'X' + Mid$(sv_a,8,STRLEN(sv_a) - 8)
			PRINT(sv_b)
			BANCS.INPUT.RecvrBIC = sv_b
		#}
		ENDIF
		
		#------------------------------------------------------------------------
		# Changes for SenderBic append
		#------------------------------------------------------------------------
		
		
		IF(FIELDEXISTS(BANCS.INPUT.SenderBIC))THEN
		#{
			
			sv_b = Mid$(BANCS.INPUT.SenderBIC,0,8) + 'A' + Mid$(BANCS.INPUT.SenderBIC,9,STRLEN(BANCS.INPUT.SenderBIC) - 9)
			PRINT(sv_b)
			BANCS.INPUT.SenderBIC = sv_b
			
			sv_a = BANCS.INPUT.SenderBIC
			sv_l = STRLEN(BANCS.INPUT.SenderBIC)
			IF(sv_l < 12) THEN
			#{
				WHILE(sv_l < 12)
				#{
					# Padding the Sender BIC with X if BIC is less than 12 characters to make the BIC 12 characters long
					sv_a = sv_a + 'X'
					sv_l = sv_l + 1
				#}
				DO
			#}
			ENDIF
			BANCS.INPUT.SenderBIC = sv_a
			PRINT(BANCS.INPUT.SenderBIC)
		#}
		ENDIF
		
		
		
		
		
		###############################################
		#changes done as part of porting-2
		###############################################
		IF((BANCS.STDIN.contextBankId != "54")  AND (BANCS.STDIN.contextBankId != "55")  AND (BANCS.STDIN.contextBankId != "50")) THEN
		#{
			IF(BANCS.INPUT.TypeOfMessage != "M") THEN
			#{
				BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0001000001}{2:I" + BANCS.INPUT.MessageId + BANCS.INPUT.RecvrBIC + BANCS.INPUT.MsgPriority + "}{4:"
				#}
			ELSE
				#{
				BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0001000001}{2:I" + "999" + BANCS.INPUT.RecvrBIC + BANCS.INPUT.MsgPriority + "}{4:"
			#}
			ENDIF
			#}
		ELSE
			#{
			IF(BANCS.INPUT.TypeOfMessage != "M") THEN
			#{
				BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0000000000}{2:I" + BANCS.INPUT.MessageId + BANCS.INPUT.RecvrBIC + BANCS.INPUT.MsgPriority
				#}
			ELSE
				#{
				BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0000000000}{2:I" + "999" + BANCS.INPUT.RecvrBIC + BANCS.INPUT.MsgPriority
			#}
			ENDIF
		#}
		ENDIF
		###############################################
		#changes ends here
		###############################################
		IF ((BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50")) THEN
		#{
			#sv_m = BANCS.INPUT.EntityId
			IF(FIELDEXISTS(BANCS.INPUT.tag201))THEN
			#{
				sv_m = BANCS.INPUT.tag201
				PRINT(sv_m)
				#}
			ELSE
				#{
				sv_m = ""
			#}
			ENDIF
			IF(FIELDEXISTS(BANCS.INPUT.SenderRefNum))THEN
			#{
				sv_n  = BANCS.INPUT.SenderRefNum
				PRINT(sv_n)
				#}
			ELSE
				#{
				sv_n = ""
			#}
			ENDIF
			sv_m = MID$(sv_m,0,3)
			PRINT(sv_m)
			
			IF(sv_m == "RTO") THEN
			#{
				IF (BANCS.INPUT.TypeOfMessage != "M") THEN
				#{
					BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0001000001}{2:I" + BANCS.INPUT.MessageId + "BNRWRWRPXXXX" + BANCS.INPUT.MsgPriority
					#}
				ELSE
					#{
					BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0001000001}{2:I" + "999" + "BNRWRWRPXXXX" + BANCS.INPUT.MsgPriority
				#}
				ENDIF
				#}
			ELSE
				#{
				IF(BANCS.INPUT.TypeOfMessage != "M") THEN
				#{
					BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0000000000}{2:I" + BANCS.INPUT.MessageId + BANCS.INPUT.RecvrBIC + BANCS.INPUT.MsgPriority
					#}
				ELSE
					#{
					BANCS.OUTPUT.MessageHeader = "{1:F01" + BANCS.INPUT.SenderBIC + "0000000000}{2:I" + "999" + BANCS.INPUT.RecvrBIC + BANCS.INPUT.MsgPriority
				#}
				ENDIF
			#}
			ENDIF
			
			IF(sv_m == "RTO") THEN
			#{
				BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "}{3:{113:0020}{108:"+BANCS.INPUT.tag201 + "}}{4:"
				#}
			ELSE
				#{
				#BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "}{4:"
				BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "}{3:"
				PRINT(BANCS.OUTPUT.MessageHeader)
				 
				BANCS.INPARAM.inpCommand = "uetrexe"
				sv_r = urtn_execSysCmd("")
				print(sv_r)
				sv_b = BANCS.OUTPUT.sysOutput_0
				print(sv_b)
				sv_b = GETPOSITION(BANCS.OUTPUT.sysOutput_0,"[")
				print(sv_b)
				sv_c = MID$(BANCS.OUTPUT.sysOutput_0,sv_b,36)
				print(sv_c)
				#BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader +"{121:" + sv_c +"}"
				BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader +"{121:" + sv_c +"}}" +"{4:"
				print(BANCS.OUTPUT.MessageHeader)
				BANCS.OUTPUT.UETR = sv_c
				print(BANCS.OUTPUT.UETR)
			#}
			ENDIF
			
			PRINT(BANCS.OUTPUT.MessageHeader)
		#}
		ENDIF
		###############################################
		#changes done as part of porting-2
		###############################################
		IF(BANCS.STDIN.contextBankId == "54") THEN
		#{
			#sv_m = BANCS.INPUT.EntityId
			IF(FIELDEXISTS(BANCS.INPUT.tag201))THEN
			#{
				sv_m = BANCS.INPUT.tag201
				PRINT(sv_m)
				#}
			ELSE
				#{
				sv_m = ""
			#}
			ENDIF
			IF(FIELDEXISTS(BANCS.INPUT.SenderRefNum))THEN
			#{
				sv_n  = BANCS.INPUT.SenderRefNum
				PRINT(sv_n)
				#}
			ELSE
				#{
				sv_n = ""
			#}
			ENDIF
			sv_m = MID$(sv_m,0,3)
			PRINT(sv_m)
			
			IF(sv_m == "RTO") THEN
			#{
				#BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "}{3:{103:KPS}}{4:"
				BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "}{3:{103:KPS}"
				BANCS.INPARAM.inpCommand = "uetrexe"
				sv_r = urtn_execSysCmd("")
				print(sv_r)
				sv_b = BANCS.OUTPUT.sysOutput_0
				print(sv_b)
				sv_b = GETPOSITION(BANCS.OUTPUT.sysOutput_0,"[")
				print(sv_b)
				sv_c = MID$(BANCS.OUTPUT.sysOutput_0,sv_b,36)
				print(sv_c)
				#BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader +"{121:" + sv_c +"}"
				BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader +"{121:" + sv_c +"}}" +"{4:"
				print(BANCS.OUTPUT.MessageHeader)
				BANCS.OUTPUT.UETR = sv_c
				print(BANCS.OUTPUT.UETR)
				PRINT(BANCS.OUTPUT.MessageHeader)
			#}
			ELSE
			#{
				#BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "}{4:"
				BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "}{3:"
				PRINT(BANCS.OUTPUT.MessageHeader)
				 
				BANCS.INPARAM.inpCommand = "uetrexe"
				sv_r = urtn_execSysCmd("")
				print(sv_r)
				sv_b = BANCS.OUTPUT.sysOutput_0
				print(sv_b)
				sv_b = GETPOSITION(BANCS.OUTPUT.sysOutput_0,"[")
				print(sv_b)
				sv_c = MID$(BANCS.OUTPUT.sysOutput_0,sv_b,36)
				print(sv_c)
				#BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader +"{121:" + sv_c +"}"
				BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader +"{121:" + sv_c +"}}" +"{4:"
				print(BANCS.OUTPUT.MessageHeader)
				BANCS.OUTPUT.UETR = sv_c
				print(BANCS.OUTPUT.UETR)
			#}
			ENDIF
			PRINT(BANCS.OUTPUT.MessageHeader)
		#}
		ENDIF
		###############################################
		#RTGS
		###############################################
		
		IF (BANCS.INPUT.PaysysId == "RTGS") THEN
		#{
			sv_q="date|"
			sv_q = sv_q + "select to_char(sysdate,'yymmdd') from dual"
			PRINT(sv_q)
			sv_e = urhk_dbselectWithBind(sv_q)
			
			IF(sv_e==0) THEN
			#{
				PAYSYS.GLBDATA.date = BANCS.OUTPARAM.date
			#}
			ENDIF
			
			
			BANCS.OUTPUT.MessageHeader = "<SWIFT_msg_fields>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_format>S</msg_format>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_sub_format>I</msg_sub_format>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_sender>"+ "EQBLRWR0CXXX" + "</msg_sender>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_receiver>"+"ZYAARWR0XXXX"+"</msg_receiver>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_type>"+ BANCS.INPUT.MessageId + "</msg_type>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_priority>"+"N"+"</msg_priority>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_del_notif_rq>N</msg_del_notif_rq>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_user_priority>"+"0020"+"</msg_user_priority>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_user_reference>"+BANCS.INPUT.tag701+"</msg_user_reference>"
			#BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_net_mir>"+ PAYSYS.GLBDATA.date+ "EQBLRWR0CXXX" +"0000000000"+"</msg_net_mir>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <msg_mac_result></msg_mac_result>"
			BANCS.OUTPUT.MessageHeader = BANCS.OUTPUT.MessageHeader + "| <block4>:20:" + BANCS.INPUT.tag201
			
		#}
		ENDIF
		###############################################
		#changes ends here
		###############################################
		
		IF(BANCS.INPUT.PDEFlag == "Y") THEN
		#{
			BANCS.OUTPUT.MessageFooter = "-} {5:{PDE:Y}}"
			#}
		ELSE
			#{
			BANCS.OUTPUT.MessageFooter = "-}"
		#}
		ENDIF
		IF (BANCS.INPUT.PaysysId == "RTGS") THEN
		#{
			BANCS.OUTPUT.MessageFooter ="</SWIFT_msg_fields>"
		#}
		ENDIF
		
		PAYSYS.GLBDATA.MsgToSplit = BANCS.INPUT.PaysysMsg
		
		#!!!! Check whether SMH message format is in current format (FiNACLE 7.0 ) or old format !!!!!
		# If its in old format return FAILURE
		# This could be tested by existance of field :201: i.r. TAG20
		
		sv_k = GETPOSITION(BANCS.INPUT.PaysysMsg,":201:")
		#check Presence of Tag 20 in multirec e.g. for 420 series
		IF(sv_k == 0) THEN
		#{
			sv_k = GETPOSITION(BANCS.INPUT.PaysysMsg,":201_1:")
		#}
		ENDIF
		
		IF (BANCS.INPUT.PaysysId == "RTGS") THEN
		#{
			sv_x=""
			sv_x = GETPOSITION(BANCS.INPUT.PaysysMsg,":23b1")
			PRINT (sv_x)
			sv_b = MID$(BANCS.INPUT.PaysysMsg,(sv_x - 1),600)
			PRINT (sv_b)
			BANCS.INPUT.PaysysMsg =sv_b
		#}
		ENDIF
		
		
		IF(sv_k != 0 ) THEN
		#{
			CALL("TrfrSwiftMsg.scr")
			#}
		ELSE
			#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_m = "Message is in old format for MessageId=[" + BANCS.INPUT.MessageId +"]" + "EntityType=["
			sv_m = sv_m + BANCS.INPUT.EntityType +"], EntityId=["+BANCS.INPUT.EntityId+"].Hence skipping this message."
			BANCS.OUTPUT.ErrorDesc = sv_m
		#}
		ENDIF
		
		#}
	ELSE
		#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.ErrorDesc = "No formating script found for Payment SYSTEM [" + BANCS.INPUT.PaysysId +"]. Hence not formatted."
		
	#}
	ENDIF
	EXITSCRIPT
	TRACE OFF
END-->
