<--START
CHECKSUM="fe5325cb1433607be6ee1ddb990ce4887155844b02441ddb7e01d6a8b1c42818"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","ORM") == 0) THEN
	#{
		CREATECLASS("CUST","ORM",5)
	#}
	ENDIF
	
	
	CUST.ORM.base = BANCS.INPUT.base
	PRINT(CUST.ORM.base)
	CUST.ORM.rate = BANCS.INPUT.rate
	PRINT(CUST.ORM.rate)
	
	#####################################################################
	# Calling getcparamvalue.scr script for tolpcnt
	#####################################################################
	
	BANCS.INPUT.moduleName = "TRADE_FINANCE"
	BANCS.INPUT.parameterId = "TOTLPCNT1"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ORM.tolpcnt = BANCS.OUTPUT.parameterVal
		sv_b = "val4|" +  CUST.ORM.tolpcnt
		sv_z = urhk_SetOrbOut(sv_b)
		PRINT(sv_z)
		#}
	ELSE
		#{
		CUST.ORM.errMsg = "TOTLPCNT IS NOT SET"
		GOTO FINISH
	#}
	ENDIF
	
	#####################################################################
	# Calling getcparamvalue.scr script for negat
	#####################################################################
	BANCS.INPUT.moduleName = "TRADE_FINANCE"
	BANCS.INPUT.parameterId = "NEGATIVE"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ORM.negat= BANCS.OUTPUT.parameterVal
		sv_b = "val5|" +  CUST.ORM.negat
		sv_z = urhk_SetOrbOut(sv_b)
		PRINT(sv_z)
		#}
	ELSE
		#{
		CUST.ORM.errMsg = "NEGATIVE IS NOT SET"
		GOTO FINISH
	#}
	ENDIF
	
	CUST.ORM.chkrate=cdouble(CUST.ORM.tolpcnt) * cdouble(CUST.ORM.base)
	PRINT(CUST.ORM.chkrate)
	CUST.ORM.diff= cdouble(CUST.ORM.rate) - cdouble(CUST.ORM.base)
	PRINT(CUST.ORM.diff)
	
	
	IF (cdouble(CUST.ORM.diff)< 0 ) THEN
	#{
		CUST.ORM.diff= cdouble(CUST.ORM.diff)* cdouble(CUST.ORM.negat)
		#}
	ELSE
		#{
		CUST.ORM.diff=CUST.ORM.diff
	#}
	ENDIF
	
	print(CUST.ORM.diff)
	IF (cdouble(CUST.ORM.chkrate) < cdouble(CUST.ORM.diff)) THEN
	#{
		sv_b = "status1|" +  "Y"
		sv_z = urhk_SetOrbOut(sv_b)
		PRINT(sv_z)
	#}
	ENDIF
	
	FINISH :
		TRACE OFF
		EXITSCRIPT
END-->
