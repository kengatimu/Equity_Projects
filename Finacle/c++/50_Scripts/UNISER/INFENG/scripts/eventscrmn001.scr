#------------------------------------------------------------------------------------------------    
#  Name            : EVNTSCRmn001.scr
#  Description     : This HPTTM script based event which is executed for calculating loans insurance fee
#  Date            : 16-01-2013
#  Author          : Samrat Saha
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :
#  Srl. No         Date            Author          Description.   
#  -------         ------          ------          ------------
#  1.0             16-01-2013      Samrat Saha     Original Version
#  2.0			   21-02-2013	   Samrat Saha	   Deleted the repositories ans classes
#												   And removed the hard coding
#  3.0			   30-03-2013	   Samrat Saha	   Condition for other entity is added
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

#-----------------------------------------------------------------------------------------------
# Creating Repository 
#-----------------------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","EVNTSCR") == 0) THEN
#{
	CREATECLASS("CUST","EVNTSCR", 5)
#}
ENDIF

IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
#{
	CREATECLASS("CUST","CPARAM", 5)
#}
ENDIF

#sv_q = urhk_B2k_PrintRepos("BANCS")
#print(sv_q)

PRINT(BANCS.INPUT.inputAmount)
PRINT(BANCS.INPUT.inputCrncy)

IF(FIELDEXISTS(BANCS.INPUT.AccountNum) == 1) THEN
#{
		print(BANCS.INPUT.AccountNum)
		CUST.EVNTSCR.foracid           = BANCS.INPUT.AccountNum
#}
ENDIF

IF(FIELDEXISTS(BANCS.INPUT.Foracid) == 1) THEN
#{
		print(BANCS.INPUT.Foracid)
		CUST.EVNTSCR.foracid           = BANCS.INPUT.Foracid
#}
ENDIF

#------------------------------------------------------------------------------------------
# Initializing the variables
#------------------------------------------------------------------------------------------
print(CUST.EVNTSCR.foracid)
CUST.EVNTSCR.inputAmount       = BANCS.INPUT.inputAmount
CUST.EVNTSCR.inputCrncy        = BANCS.INPUT.inputCrncy
CUST.EVNTSCR.errMsg            = ""
CUST.EVNTSCR.company           = ""
CUST.EVNTSCR.freeCode3         = ""
CUST.EVNTSCR.pattrns           = ""
CUST.EVNTSCR.ttlFee            = "0"
CUST.EVNTSCR.freeCode1         = ""
CUST.EVNTSCR.freeCode2         = ""

#---------------------------------------------------------------------------------------
#Getting the Scheme Code 
#---------------------------------------------------------------------------------------
sv_s = ""
sv_s = sv_s +   " schmCode|"
sv_s = sv_s +	" SELECT GAM.schm_code"
sv_s = sv_s +	" FROM TBAADM.GAM"
sv_s = sv_s +	" WHERE GAM.foracid=?SVAR"
sv_s = sv_s +	" AND GAM.bank_id =?SVAR"

PRINT(sv_s)
BANCS.INPARAM.BINDVARS = CUST.EVNTSCR.foracid + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)

sv_d = urhk_dbselectWithBind(sv_s)

IF (sv_d == 0) THEN
#{
	CUST.EVNTSCR.schmCode=BANCS.OUTPARAM.schmCode
	PRINT(CUST.EVNTSCR.schmCode)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "Error in getting schmcode for account"
	GOTO ENDOFSCRIPT
#}
ENDIF

#-----------------------------------------------------------------------------------------
# Getting all the values FROM CPARAM
#-----------------------------------------------------------------------------------------
BANCS.INPUT.moduleName = "EVENT_SCR"
BANCS.INPUT.parameterId = "ES_" + CUST.EVNTSCR.schmCode 
CALL ("getcparamvalue.scr")

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.schmCode = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.schmCode)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "CPARAM setup not done for schmCode"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName = "EVENT_SCR"
BANCS.INPUT.parameterId = "ES_" + CUST.EVNTSCR.schmCode + "_MPP"
CALL ("getcparamvalue.scr")

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.mpp = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.mpp)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "CPARAM setup not done for MPP"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName = "EVENT_SCR"
BANCS.INPUT.parameterId = "ES_" + CUST.EVNTSCR.schmCode + "_FIRE"
CALL ("getcparamvalue.scr")

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.fire = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.fire)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "CPARAM setup not done for FIRE"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName = "EVENT_SCR"
BANCS.INPUT.parameterId = "ES_" + CUST.EVNTSCR.schmCode +"_LFIRE"
CALL ("getcparamvalue.scr")

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.leviesonfire = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.leviesonfire)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "CPARAM setup not done for LEVIESONFIRE"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName = "EVENT_SCR"
BANCS.INPUT.parameterId = "ES_" + CUST.EVNTSCR.schmCode +"_DISCT"
CALL ("getcparamvalue.scr")

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.discount = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.discount)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "CPARAM setup not done for Discount"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName = "EVENT_SCR"
BANCS.INPUT.parameterId = "ES_" + CUST.EVNTSCR.schmCode +"_LAAMT"
CALL ("getcparamvalue.scr")

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.laAnt = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.laAnt)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "CPARAM setup not done for Loan Amount"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName = "EVENT_SCR"
BANCS.INPUT.parameterId = "ES_" + CUST.EVNTSCR.schmCode +"_AMMT1"
CALL ("getcparamvalue.scr")

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.amount1 = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.amount1)
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "CPARAM setup not done for amount1"
	GOTO ENDOFSCRIPT
#}
ENDIF


#-------------------------------------------------------------------------
# Selecting the Free TEXT 1  in table gac
#--------------------------------------------------------------------------
sv_s =""
sv_s =sv_s+ " freeText1,freeText2,freeText3|"
sv_s =sv_s+ " SELECT GAC.free_text_1,GAC.free_text_2,GAC.free_text_3" 
sv_s =sv_s+ " FROM TBAADM.GAC "
sv_s =sv_s+ " WHERE GAC.bank_id = ?SVAR" 
sv_s =sv_s+ " AND EXISTS " 
sv_s =sv_s+             "( SELECT 1 " 
sv_s =sv_s+             " FROM TBAADM.GAM" 
sv_s =sv_s+             " WHERE GAM.foracid= ?SVAR"
sv_s =sv_s+             " AND GAM.acid = GAC.acid"
sv_s =sv_s+             " AND GAM.bank_id = ?SVAR)"

PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.EVNTSCR.foracid +"|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)

sv_d = urhk_dbselectWithBind(sv_s)

IF (sv_d == 0) THEN
#{
	CUST.EVNTSCR.freeCode1 	= BANCS.OUTPARAM.freeText1
	CUST.EVNTSCR.freeCode2 	= BANCS.OUTPARAM.freeText2
	CUST.EVNTSCR.freeCode3 	= BANCS.OUTPARAM.freeText3
	PRINT(CUST.EVNTSCR.freeCode1)
	PRINT(CUST.EVNTSCR.freeCode2)
	PRINT(CUST.EVNTSCR.freeCode3)
	IF (CDOUBLE(CUST.EVNTSCR.freeCode1) > 0 ) THEN
	#{
		CUST.EVNTSCR.pattrns = CUST.EVNTSCR.freeCode1
	#}
	ENDIF
	
	IF (CUST.EVNTSCR.freeCode2 !="" ) THEN
	#{
		CUST.EVNTSCR.company = CUST.EVNTSCR.freeCode2
	#}
	ENDIF

	IF (BANCS.STDIN.contextBankId == "54" ) THEN
	#{	
		IF (CUST.EVNTSCR.freeCode3 != "") THEN
		#{
			IF (CDOUBLE(CUST.EVNTSCR.freeCode1) > 0 ) THEN
			#{
				CUST.EVNTSCR.insuranceVal = CUST.EVNTSCR.freeCode3
				PRINT(CUST.EVNTSCR.insuranceVal)
			#}
			ELSE
			#{
				CUST.EVNTSCR.insuranceVal = "0"
				PRINT(CUST.EVNTSCR.insuranceVal)
			#}
			ENDIF
		#}
		ELSE
		#{ 
			CUST.EVNTSCR.insuranceVal = "0"
			PRINT(CUST.EVNTSCR.insuranceVal)
		#}
		ENDIF
	#}
	ELSE
	#{
		IF (CDOUBLE(CUST.EVNTSCR.freeCode1) > 0 ) THEN
		#{
			CUST.EVNTSCR.insuranceVal = CUST.EVNTSCR.freeCode3
		#}
		ELSE
		#{ 
			CUST.EVNTSCR.insuranceVal = "0"
			PRINT(CUST.EVNTSCR.insuranceVal)
		#}
		ENDIF
	#}
	ENDIF
#}
ELSE
#{
	CUST.EVNTSCR.errMsg = "Unable to fetch freeText1,freeText2,freeText3"
	GOTO ENDOFSCRIPT
#}
ENDIF


#-------------------------------------------------------------------------
# Selecting the period in table lam
# if the period is 0 then exiting
#--------------------------------------------------------------------------
sv_s =      " period,schmCode|"
sv_s =sv_s+ " SELECT LAM.rep_perd_mths, GAM.schm_code"
sv_s =sv_s+ " FROM TBAADM.LAM, TBAADM.GAM"
sv_s =sv_s+ " WHERE LAM.acid = GAM.acid"
sv_s =sv_s+ " AND LAM.bank_id=GAM.bank_id"
sv_s =sv_s+ " AND LAM.del_flg='N'"
sv_s =sv_s+ " AND LAM.entity_cre_flg='Y'"
sv_s =sv_s+ " AND GAM.del_flg='N'"
sv_s =sv_s+ " AND GAM.entity_cre_flg='Y'"
sv_s =sv_s+ " AND GAM.acct_cls_flg='N'"
sv_s =sv_s+ " AND GAM.foracid =?SVAR"
sv_s =sv_s+ " AND GAM.bank_id = ?SVAR"

PRINT(sv_s)
BANCS.INPARAM.BINDVARS = CUST.EVNTSCR.foracid + "|" + BANCS.STDIN.contextBankId 
PRINT(BANCS.INPARAM.BINDVARS)

sv_d = urhk_dbselectWithBind(sv_s)

IF (sv_d == 0) THEN
#{
	CUST.EVNTSCR.period	= BANCS.OUTPARAM.period
	CUST.EVNTSCR.schmCode	= BANCS.OUTPARAM.schmCode
#}
ELSE
#{
	GOTO ENDOFSCRIPT
#}
ENDIF

IF (CUST.EVNTSCR.schmCode == CUST.CPARAM.schmCode) THEN
#{
	CUST.EVNTSCR.mpp   = CUST.CPARAM.mpp
	CUST.EVNTSCR.fire  = CUST.CPARAM.fire
#} 
ELSE
#{
	CUST.EVNTSCR.mpp	= "0"
	CUST.EVNTSCR.fire	= "0"
#}
ENDIF

CUST.EVNTSCR.amnt = CUST.EVNTSCR.inputAmount

IF (CDOUBLE(CUST.EVNTSCR.amnt) > CDOUBLE(CUST.CPARAM.laAnt) ) THEN
#{
	CUST.EVNTSCR.amnt 		= CUST.CPARAM.laAnt
	print(CUST.EVNTSCR.amnt)
#}
ENDIF
print(CUST.EVNTSCR.amnt)
print(CUST.EVNTSCR.mpp)

if ((CINT(CUST.EVNTSCR.amnt) >= 1) and (CINT(CUST.EVNTSCR.amnt) <= 69000000)) then 
	IF (CINT(CUST.EVNTSCR.period) <= 60) THEN
		CUST.EVNTSCR.mpp ="0.007"
		print(CUST.EVNTSCR.mpp)
		IF (CINT(CUST.EVNTSCR.pattrns) > 1 ) THEN
			CUST.EVNTSCR.mpp ="0.012"
			print(CUST.EVNTSCR.mpp)
		ENDIF
	ENDIF

	IF ((CINT(CUST.EVNTSCR.period) > 60) and (CINT(CUST.EVNTSCR.period) <= 120)) THEN
		CUST.EVNTSCR.mpp ="0.01"
		print(CUST.EVNTSCR.mpp)
		IF (CINT(CUST.EVNTSCR.pattrns) > 1 ) THEN
			CUST.EVNTSCR.mpp ="0.019"
			print(CUST.EVNTSCR.mpp)
		ENDIF
	ENDIF

	IF ((CINT(CUST.EVNTSCR.period) > 120) and (CINT(CUST.EVNTSCR.period) <= 240)) THEN
		CUST.EVNTSCR.mpp ="0.0045"
		print(CUST.EVNTSCR.mpp)
		IF (CINT(CUST.EVNTSCR.pattrns) > 1 ) THEN
			CUST.EVNTSCR.mpp ="0.0060"
			print(CUST.EVNTSCR.mpp)
		ENDIF
	ENDIF
endif


CUST.EVNTSCR.mpppr = CDOUBLE(CUST.EVNTSCR.amnt) * CDOUBLE(CUST.EVNTSCR.mpp)
PRINT(CUST.EVNTSCR.mpppr)


IF (FIELDEXISTS(CUST.EVNTSCR.pattrns)) THEN
#{
	IF (CDOUBLE(CUST.EVNTSCR.pattrns) > CDOUBLE(CUST.CPARAM.amount1)) THEN
	#{
		CUST.EVNTSCR.discount	= CUST.CPARAM.discount       
		CUST.EVNTSCR.ttlFee		= CDOUBLE(CUST.EVNTSCR.ttlFee) * CDOUBLE(CUST.EVNTSCR.pattrns) * CDOUBLE(CUST.EVNTSCR.discount)
		PRINT(CUST.EVNTSCR.ttlFee)
	#}  
	ENDIF
#}
ENDIF

IF (CUST.EVNTSCR.company == "Y") THEN
#{
	CUST.EVNTSCR.ttlFee = "0"
#}
ENDIF

IF (CUST.EVNTSCR.schmCode == CUST.CPARAM.schmCode) THEN
#{
	PRINT(CUST.EVNTSCR.ttlFee)
	CUST.EVNTSCR.ttlFee = CUST.EVNTSCR.mpppr
	PRINT(CUST.EVNTSCR.ttlFee)
#}
ELSE
#{
	CUST.EVNTSCR.ttlFee = "0"
#}
ENDIF



ENDOFSCRIPT:
IF (CUST.EVNTSCR.errMsg != "") THEN
#{
	sv_u = system("echo '"+CUST.EVNTSCR.errMsg+"' >>EVNTSCR.log")
#}
ENDIF

CUST.EVNTSCR.ttlFee = CUST.EVNTSCR.mpppr
PRINT(CUST.EVNTSCR.ttlFee)

BANCS.OUTPUT.collAmount				= CDOUBLE(CUST.EVNTSCR.ttlFee)
BANCS.OUTPUT.AmountWithNoDiscount	= CDOUBLE(CUST.EVNTSCR.ttlFee)
BANCS.OUTPUT.collCrncy				= CUST.EVNTSCR.inputCrncy
EXITSCRIPT
END-->
