<--start
trace on
#Rep/Class
        libname CUSTOMSO
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0) then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_u = urhk_B2k_PrintRepos("BANCS")
        print(sv_u)
        EQSRV.GLBDATA.machineId = ""
        sv_u = urhk_getEnv("HOST_NAME")
        print(BANCS.OUTPARAM.envValue)
        EQSRV.GLBDATA.machineId = BANCS.OUTPARAM.envValue


	lv_s = " billAcctId,billerCode,billAmt,billRefNum,bankCode,branchCode,drAcctNum,drName,tranDate,tranId,billRemarks,billServiceName,tranCrncy,partTranType,phoneNum,endPoint,refNum | "
	lv_s = lv_s + " select biller_acct,biller_code,bill_amt,bill_ref_num,bank_code,branch_code,dr_acct_num,replace(dr_cust_name,' ','/'),tran_date,tran_id,remarks,service_name,tran_crncy,part_tran_type,phone_num,end_point,CONCAT(CONCAT('EQED',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) "
	lv_s = lv_s + " from custom.edst "
	lv_s = lv_s + " where bank_id=?SVAR "
	lv_s = lv_s + " and del_flg='N' "
	lv_s = lv_s + " and ed_status='I' " 
	lv_s = lv_s + " and ed_status<>'P' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
        lv_u = urhk_dbCursorOpenWithBind(lv_s)
        if(lv_u == 0)then
        #{
                EQSRV.GLBDATA.edCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        #}
        else
        #{
        	print("fetch failed")
        	exitscript
        #}
        endif
        EQSRV.GLBDATA.recNum = 0
        sv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.edCurNum)
        if(sv_f !=0)then
	#{
		sv_f = urhk_dbCursorClose(EQSRV.GLBDATA.edCurNum)
                print(sv_f)
		exitscript
	#}
	endif
        while(sv_f ==0)
        #{
      		EQSRV.GLBDATA.billAcctId = BANCS.OUTPARAM.billAcctId
		EQSRV.GLBDATA.billerCode = BANCS.OUTPARAM.billerCode
		EQSRV.GLBDATA.billAmt = BANCS.OUTPARAM.billAmt
		EQSRV.GLBDATA.billRefNum = BANCS.OUTPARAM.billRefNum
		EQSRV.GLBDATA.bankCode = BANCS.OUTPARAM.bankCode
		EQSRV.GLBDATA.branchCode = BANCS.OUTPARAM.branchCode
		EQSRV.GLBDATA.drAcctNum = BANCS.OUTPARAM.drAcctNum
		EQSRV.GLBDATA.drName = BANCS.OUTPARAM.drName
		EQSRV.GLBDATA.tranDate = BANCS.OUTPARAM.tranDate
		EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
		EQSRV.GLBDATA.billRemarks = BANCS.OUTPARAM.billRemarks
		EQSRV.GLBDATA.billServiceName = BANCS.OUTPARAM.billServiceName
		EQSRV.GLBDATA.tranCrncy = BANCS.OUTPARAM.tranCrncy
		EQSRV.GLBDATA.partTranType = BANCS.OUTPARAM.partTranType
		EQSRV.GLBDATA.phoneNum = BANCS.OUTPARAM.phoneNum
		EQSRV.GLBDATA.endPoint = BANCS.OUTPARAM.endPoint
		EQSRV.GLBDATA.refNum = BANCS.OUTPARAM.refNum 
        
        

		EQSRV.GLBDATA.edResp = EQSRV.GLBDATA.refNum + ".dat"
		EQSRV.GLBDATA.acctNum = EQSRV.GLBDATA.billAcctId 
		EQSRV.GLBDATA.acctName = EQSRV.GLBDATA.billerCode 
		EQSRV.GLBDATA.bankCode = "068" 
		EQSRV.GLBDATA.billamt = EQSRV.GLBDATA.billAmt 
		EQSRV.GLBDATA.billno = EQSRV.GLBDATA.billRefNum 
		EQSRV.GLBDATA.branchCode = "1000" 
		EQSRV.GLBDATA.Channel = "COR" 
		EQSRV.GLBDATA.CountryCode = "XX" 
		EQSRV.GLBDATA.DrAcctId = "XXXX"
		EQSRV.GLBDATA.DrCustName = EQSRV.GLBDATA.drName 
		EQSRV.GLBDATA.TranDate = mid$(EQSRV.GLBDATA.tranDate,0,10) 
		EQSRV.GLBDATA.TranId = trim(EQSRV.GLBDATA.tranId)
		EQSRV.GLBDATA.Remarks = "BillPayment" 
		EQSRV.GLBDATA.rrnNum = trim(EQSRV.GLBDATA.tranId)
		EQSRV.GLBDATA.ServiceName = EQSRV.GLBDATA.billerCode 
		EQSRV.GLBDATA.TranCrncy = EQSRV.GLBDATA.tranCrncy 
		EQSRV.GLBDATA.partTranType = "Otherbill" 
		EQSRV.GLBDATA.phoneNum = "XXXXXXXXXXXX" 
		##EQSRV.GLBDATA.EdUrl = "http://10.11.6.110:7003/edmqservice/payments/ws/v1" 
		##EQSRV.GLBDATA.EdUrl = "http://pgwprodcore.ebsafrica.com:80/edmqservice/payments/ws/v1"
		####EQSRV.GLBDATA.EdUrl = "http://10.9.64.92:8080/ws/notification"
		####EQSRV.GLBDATA.EdUrl = "http://10.9.96.47:8080/ws/notification"
		EQSRV.GLBDATA.EdUrl = "http://10.9.64.92:8080/ws/notification"
		if((EQSRV.GLBDATA.TranId!="") and (EQSRV.GLBDATA.TranDate!=""))then
			sv_s = "dtdCnt | select count(*) from tbaadm.dctd_acli where tran_id = lpad(?SVAR,9,' ') "
			sv_s = sv_s + " and bank_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR') and pstd_flg='Y' "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.TranId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.TranDate
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_s)
			if(sv_u==0)then
				EQSRV.GLBDATA.dtdCnt = BANCS.OUTPARAM.dtdCnt
			else
				EQSRV.GLBDATA.dtdCnt = 0
			endif
		endif
		if(cdouble(EQSRV.GLBDATA.dtdCnt)<=0)then
				goto NXTREC
		endif
	EQSRV.GLBDATA.jInp = EQSRV.GLBDATA.acctNum + " " + EQSRV.GLBDATA.acctName + " " + EQSRV.GLBDATA.bankCode + " " + EQSRV.GLBDATA.billamt + " " + EQSRV.GLBDATA.billno + " " + EQSRV.GLBDATA.branchCode + " " + EQSRV.GLBDATA.Channel + " " + EQSRV.GLBDATA.CountryCode + " " + EQSRV.GLBDATA.DrAcctId + " " + EQSRV.GLBDATA.DrCustName + " " + EQSRV.GLBDATA.TranDate + " " + EQSRV.GLBDATA.TranId + " " + EQSRV.GLBDATA.Remarks + " " + EQSRV.GLBDATA.rrnNum + " " + EQSRV.GLBDATA.ServiceName + " " + EQSRV.GLBDATA.TranCrncy + " " + EQSRV.GLBDATA.partTranType + " " + EQSRV.GLBDATA.phoneNum + " " + EQSRV.GLBDATA.EdUrl
        print(EQSRV.GLBDATA.jInp)
	##sv_r=system("java -cp /equity_be/EQUAT/BackEnd/Finacle/FC/app/cust/INFENG com.cubpEquityDirect.cubpUp.cubpEdUp "+ EQSRV.GLBDATA.jInp + " >> " +EQSRV.GLBDATA.edResp )  
	sv_r=system("java -cp /finacle/equity_be/Finacle/FC/app/cust/INFENG com.cubpEquityDirect.cubpUp.cubpEdUp "+ EQSRV.GLBDATA.jInp + " >> " +EQSRV.GLBDATA.edResp )  
        print(sv_r)
        sv_a = urhk_getEnv("ONS_LOG_DIR")
        print(BANCS.OUTPARAM.envValue)
        print(sv_a)
        if(sv_a == 1)then
                print("Env variable ONS/log not found")
		goto VAYU
        endif
	lv_u = "update custom.edst set ed_status='P',ED_STATUS_DESC='Processed',HOST_MACHINE_ID=?SVAR,FREE_TEXT1=?SVAR where bank_id=?SVAR and biller_code=?SVAR and bill_ref_num=?SVAR and tran_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RRRR') and ed_status='I' "
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.machineId + "|" + EQSRV.GLBDATA.refNum + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.billerCode + "|" + EQSRV.GLBDATA.billRefNum + "|" +  EQSRV.GLBDATA.tranId + "|" + EQSRV.GLBDATA.TranDate 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_u)
	lv_u = urhk_dbSqlWithBind(lv_u)
	if(lv_u==0)then
		print("processed")
	else
		print("failed")
	endif
	NXTREC:
                sv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.edCurNum)
                EQSRV.GLBDATA.recNum = cint(EQSRV.GLBDATA.recNum) + 1
		print(EQSRV.GLBDATA.recNum)
        #}
        do
	sv_f = urhk_dbCursorClose(EQSRV.GLBDATA.edCurNum)
	print(sv_f)
       
VAYU:
	exitscript
trace off
end-->

