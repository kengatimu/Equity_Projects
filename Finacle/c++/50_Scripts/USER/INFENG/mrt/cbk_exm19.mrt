#********************************************************************************
#    Report Name                        :       cbk_exm21.mrt                   *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    GENERAL REPORT DESCRIPTION                                                 *
#    --------------------------                                                 *
#     DEPOSITS FROM INSTITUTIONS                                                *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    MODIFICATION LOG                                                           *
#    ----------------                                                           *
#                                                                               *
#    Sr.no.  Date           Author                 Description                  *
#    ------  --------       ------------           -----------                  *
#    1.0     25-07-2005     P.Senthil kumar        Original Version             *
#                                                                               *
#################################################################################
#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
recnum                  stringType
Acctname                stringType
depamt			numberType
accint                  numberType
opendate                stringType
matdate                 stringType
period_m                numberType
period_d                numberType
intrate                 numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
callscript		stringType
lv_setid       	        stringType
lv_setdesc      	stringType
principal               numberType
totint                  numberType
total                   numberType
total1			numberType
grandtot                numberType
period                  numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
alreadysorted
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
#bankName        stringType
#branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg
set totint = 0
set total = 0
set grandtot = 0
set intrate = 0
set period = 0

#***************************************************************************************
IGNORERECORD
#***********************************************************************************
#*************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   55
columnsperline 175
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines  5
pagefooterlines 4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
#execute header
execute pageHdg
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#**************************************************************************************
ONEVERYRECORD
#***************************************************************************************
set total = depamt + accint 
set total1  = total1 + depamt 
set totint = totint + accint
set grandtot = grandtot + total
begin
execute pipe
print   recnum          column  2       size   9 
print   Acctname        column  13      size   25
print   depamt          column  41      size   18  autocomma precision 2
print   accint          column  64      size   17  autocomma precision 2
print   total           column  85      size   17  autocomma precision 2
print   opendate        column 107      size   10
print   matdate         column 120      size    10
print   period_m        column 134      size    3
print "/" column 137 size 1
print   period_d        column 138      size    3
print   intrate         column 148      size    5
end
#**************************************************************************************
ONENDOFREPORT
#**************************************************************************************
begin
#execute Line
separatorline
execute pipe
print "Total :" column 5
print  total1  autocomma precision 2 column 41 size 20 
print totint   autocomma precision 2 column 65 size 16
print grandtot  autocomma precision 2 column 85 size 20
nextline
separatorline
nextline
nextline
nextline
print "*DEPOSITS FROM BANKS,FINANCIAL INSTITUTIONS,BUILDING SOCIETIES" column 5
nextline
print " AND MORTGAGE FINANCE COMPANIES REPORTED IN FORM EXM21" column 5
nextline
#print "CBK/BSD/EXM/19. Highlight or list Separately the dormant accounts" column 5
nextline
nextline
nextline
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:_______________________________________" column 20
nextline
end
#***************************************************************************************
PROCEDURE pipe

begin
        print "|"               column 1
        print "|"               column 12 
        print "|"               column 40 
        print "|"               column 63
        print "|"               column 84 
        print "|"               column 106 
        print "|"               column 119 
        print "|"               column 133
        print "|"               column 145
        print "|"               column 156
        print "|"               column 175
end

#***************************************************************************************

#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
print "EXM19" column 165
nextline
print "INSTITUTION:  EQUITY BANK LIMITED " column 5
print "DATE:" column 165
print asondate column 170
nextline
nextline
print " BRANCH    :"  column 5
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc size 20
print "(SHS)" column 166
nextline
nextline
print "CALL/FIXED DEPOSITS" size 105 center
nextline
print "___________________" size 105 center
nextline
end

#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
separatorline
print "|" column 1
print "FDR NO." column 2
print "|"  column 12
print "NAME OF" column 13 size 25 center
print "|" column 40
print "PRINCIPAL" column 42 size 20 center
print "|" column 63
print "ACCRUED" column 64 size 19 center
print "|" column 84
print "TOTAL" column 85  size 20 center
print "|" column 106
print "DATE OF" column 107
print "|" column 119
print "DATE OF" column 120
print "|" column 133
print "TERM" column 134
print "|" column 145
print "RATE OF" column 146
print "|" column 156
print "REMARK" column 158
print "|" column 173
nextline
print "|" column 1 
print "|"  column 12
print "DEPOSITOR" column 13 size 25 center
print "|" column 40 
print "|" column 63 
print "INTEREST" column 64 size 19 center
print "|" column 84 
print "|" column 106
print "PLACEMENT" column 107
print "|" column 119
print "MATURITY"  column 120   
print "|" column 133
print "|" column 145
print "INTEREST" column 146
print "|" column 156
print "|" column 173 
separatorline
end
#****************************************************************************************


