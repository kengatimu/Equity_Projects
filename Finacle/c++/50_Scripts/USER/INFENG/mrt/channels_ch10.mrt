#  DESC   :  ATM Commissions For Transactions 
######################################################################
RECORDLAYOUT
####################################################################
#   
####################################################################

sol_id 			stringType
tran_id 		stringType
foracid 		stringType
acct_name 		stringType
tran_amt 		numberType
clr_bal_amt 		numberType
tran_rmks	 	stringType
tran_particular 	stringType


LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################

total_bal		numberType
gr_total_bal		numberType
total_tran		numberType
gr_total_tran		numberType

total_transactions	numberType
gr_total_transactions	numberType

total_pages		numberType
totalpages		numberType

page_number             numberType
lv_setid                stringtype  
callscript              stringType
lv_setdesc     	        stringType
lv_userId       	stringType


GROUPANDSORT
####################################################################
sol_id ascending

REPOSITORY  argv4
############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType

#############################################################################
#
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
pageformat
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################

widowOrphanLines 3
LinesPerPage 64
Topmargin       2
BottomMargin 2
columnsPerLine  200 
pageHeaderLines 8
pageFooterLines 2
#
ONSTARTOFREPORT
####################################################################  

set total_bal = 0
set gr_total_bal = 0

execute brBankHdg 
execute pageHdg

#
PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
print "Pg:" column 2
print pagenumber column 5
print "of" column 7
print "<<TOP>>" column 10
nextline
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################

set total_bal = total_bal + tran_amt

print tran_id 		column 2
print tran_rmks		column 34
print foracid 		column 16
print acct_name 	column 57
print tran_amt 		column 87
print clr_bal_amt 	column 102
print tran_particular 	column 122
nextline

AFTERBREAKOF sol_id
####################################################################
# After break of sol id
####################################################################

set total_transactions = groupcount tran_id
print "Total Branch Transactions  "column 2
print total_transactions column 30
nextline
print "TOTAL :" column 2
print total_bal column 87
separatorline
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
     set gr_total_transactions = totalcount tran_id
     print "TOTAL TRANSACTIONS: " column 2
     print gr_total_transactions column 25
     nextline 
     set gr_total_bal = totalsum tran_amt
     print "Grand Total : " column 2
     print gr_total_bal column 87
     separatorline
     nextline
end

begin
     print "printed by:" column 80 
     print  lv_userId
     nextline
     print "verified by:" column  80 
     print "............" column  93 
     nextline
     print "*************************END OF REPORT****************************" size 200 center
     nextline
     nextline 
     nextline
end 
# 
#
#############################################################################
Procedure  pageHdg
###############################################################################
begin
     print " ATM Reversed Transactions Report  "  size 200 center 
     nextline
     print "  FROM  " column  80 
     print ipFrmDate  
     print " TO "
     print ipToDate 
     separatorline
end

begin
     print "TRAN ID" column 2
     print "CARD NUMBER" column 16
     print "A/C NO" column 34
     print "ACCOUNT NAME" column 57
     print "TRAN AMT" column 87
     print "A/C BAL" column 102
     print "TRAN PARTICULARS" column 122 
     separatorline 
end
########################################################################
PROCEDURE brBankHdg
##############################################################################
begin
     print "Page No. "   column   150  
     print page_number precision 0
     nextline
     print today column  150 
     nextline
     print "EQUITY BANK LIMITED"  size 200 center 
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 200 center 
     nextline 
end     
####################################################################
# End of File
######################################################################
