#
<--START
TRACE ON
	
#--------------------------------------------------------------------
#	Creating Repository and class
#--------------------------------------------------------------------

	IF(REPEXISTS("CUST") == "0") THEN
	#{
		CREATEREP("CUST")	
	#}
	ENDIF

	IF(CLASSEXISTS("CUST","DATA") == "0") THEN
	#{
		CREATECLASS("CUST","DATA",5)	
	#}
	ENDIF

	IF(CLASSEXISTS("CUST","CIETXN") == "0") THEN
        #{
                CREATECLASS("CUST","CIETXN",5)
        #}
        ENDIF
	#-------------------------------------
	#printing bank_repos
	#-------------------------------------
	sv_x= urhk_B2k_PrintRepos("BANCS")
	print(sv_x)

	CUST.DATA.balInq = "650013197"

#--------------------------------------------------------------------
#	Variable initialization
#--------------------------------------------------------------------
IF(FIELDEXISTS(BANCS.STDIN.menuId) == 0)THEN
#{
	exitscript
#}
ENDIF

IF(BANCS.STDIN.menuId == "HACCBAL")THEN
#{
	IF(BANCS.STDIN.menuId == "HACCBAL")THEN
	#{
		CUST.DATA.drAcctNum   = BANCS.INPUT.acctNum
		CUST.DATA.crAcctNum   = BANCS.STDIN.homeSolId +""+ CUST.DATA.balInq
		PRINT(CUST.DATA.crAcctNum)
	#}
	ENDIF

	CUST.DATA.drRefCrncy =""
	sv_s= "crncy_code,clearBalance| select acct_crncy_code,clr_bal_amt from tbaadm.gam where foracid=?SVAR"
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.DATA.drAcctNum
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_s)
	print(sv_u)
	if(sv_u == 0) then
	#{
		CUST.DATA.drRefCrncy = BANCS.OUTPARAM.crncy_code
		print(CUST.DATA.drRefCrncy)
		CUST.DATA.acctBal = BANCS.OUTPARAM.clearBalance
                print(CUST.DATA.acctBal)
	#}
	ENDIF

	CUST.DATA.tranParticular = "Account Balance Inquery Fee"
	CUST.DATA.drRefAmt    = "500"

	CUST.DATA.rate = "1"
	CUST.DATA.crRefCrncy  = "RWF" 

IF(CDOUBLE(CUST.DATA.acctBal) < CDOUBLE(CUST.DATA.drRefAmt))THEN
#{
	CALLSCRIPTIFEXIST("markLienCoge.scr")	
	GOTO ENDOFSCRIPT
#}
ENDIF

IF(CUST.DATA.drRefCrncy != CUST.DATA.crRefCrncy)THEN
#{
	CUST.CIETXN.drAcctNumCcy = CUST.DATA.drRefCrncy
	CUST.CIETXN.crAcctNumCcy = CUST.DATA.crRefCrncy
	CALLSCRIPTIFEXIST("coge_fetchRateCode.scr")
	PRINT(CUST.RATE.rate)
	CUST.DATA.rate = CUST.RATE.rate
#}
endif 

#--------------------------------------------------------------------
#       MTT Close
#--------------------------------------------------------------------

        lv_u = urhk_MTTS_Close("")
        print(lv_u)

#--------------------------------------------------------------------
#	MTT initialization
#--------------------------------------------------------------------

	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.CommitFlg   = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
	BANCS.INPARAM.RestrictModifyInd   = "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw   = "Y"

	BANCS.INPARAM.ValidationFlag            = "N"
	BANCS.INPARAM.CheckExceptions           = "Y"

	lv_u = urhk_MTTS_Initialize("")
	print(lv_u)

	IF(lv_u == "0") THEN
	#{
		print("Mtt initialized successfully")
	#}
	ELSE
	#{
		print("Mtt initialization failed")

		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			PRINT(MTT.Error.Description)	
		#}
		ENDIF

		GOTO ENDOFSCRIPT
	#}
	ENDIF


#--------------------------------------------------------------------
#	MTT Definition
#--------------------------------------------------------------------

	MTT.TranDetails.TranDate    = "0"
	MTT.TranDetails.TranType    = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.PostFlag        = "Y"
	MTT.TranDetails.CommitFlg       = "Y"
	MTT.TranDetails.ValidationFlag  = "N"
	MTT.TranDetails.IgnoreExcp      = "I"

	lv_u = urhk_MTTS_DefineTransaction("TEST_TRAN")
	print(lv_u)

	IF(lv_u == "0") THEN
	#{
		print("Mtt defined successfully")
	#}
	ELSE
	#{
		print("Mtt definition failed")

		lv_u = urhk_MTTS_ReportErrorCondition("")
		print(lv_u)

		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			PRINT(MTT.Error.Description)
		#}
		ENDIF

		GOTO ENDOFSCRIPT
	#}
	ENDIF

#--------------------------------------------------------------------
#	MTT Dr part tran Definition
#--------------------------------------------------------------------

	MTT.PartTranDetails.Account = CUST.DATA.drAcctNum
	MTT.PartTranDetails.RefCurrency = CUST.DATA.crRefCrncy 
	MTT.PartTranDetails.RefAmount   = -1 * CDOUBLE(CUST.DATA.drRefAmt)
	MTT.PartTranDetails.ValueDate   = "0"
	MTT.PartTranDetails.Particulars = CUST.DATA.tranParticular
	MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
	MTT.PartTranDetails.Consolidate    = "N"
        #MTT.PartTranDetails.Remarks = CUST.DATA.refaNum  
	MTT.PartTranDetails.PostFlag      = "Y"

	MTT.PartTranDetails.RateCode = "TTB"

	lv_u = urhk_MTTS_DefinePartTran("DR_TRAN1")
	print(lv_u)

	IF(lv_u == "0") THEN
	#{
		print("Mtt DR part tran defined successfully")
	#}
	ELSE
	#{
		print("Mtt DR part tran definition failed")

		lv_u = urhk_MTTS_ReportErrorCondition("")
		print(lv_u)

		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			PRINT(MTT.Error.Description)
		#}
		ENDIF

		GOTO ENDOFSCRIPT
	#}
	ENDIF

#--------------------------------------------------------------------
#       MTT Cr part tran Definition
#--------------------------------------------------------------------

        MTT.PartTranDetails.Account = CUST.DATA.crAcctNum
	MTT.PartTranDetails.RefCurrency = CUST.DATA.crRefCrncy
        MTT.PartTranDetails.RefAmount   = CUST.DATA.drRefAmt 
	MTT.PartTranDetails.ValueDate   = "0"
	MTT.PartTranDetails.Particulars = CUST.DATA.tranParticular
	MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
	MTT.PartTranDetails.Consolidate    = "N"
        #MTT.PartTranDetails.Remarks = CUST.DATA.refaNum

	MTT.PartTranDetails.PostFlag      = "Y"
	MTT.PartTranDetails.RateCode = "TTB"
	MTT.PartTranDetails.Rate = CUST.DATA.rate 

        lv_u = urhk_MTTS_DefinePartTran("CR_TRAN1")
        print(lv_u)

        IF(lv_u == "0") THEN
        #{
                print("Mtt CR part tran defined successfully")
        #}
        ELSE
        #{
                print("Mtt CR part tran definition failed")

                lv_u = urhk_MTTS_ReportErrorCondition("")
                print(lv_u)

                IF(FIELDEXISTS(MTT.Error.Description)) THEN
                #{
                        PRINT(MTT.Error.Description)
                #}
                ENDIF

                GOTO ENDOFSCRIPT
        #}
        ENDIF

#--------------------------------------------------------------------
#       MTT end definition
#--------------------------------------------------------------------

        lv_u = urhk_MTTS_EndDefinition("")
        print(lv_u)

	IF(FIELDEXISTS(MTT.Error.Description)) THEN
	#{
		print(MTT.Error.Description)
		lv_u = urhk_MTTS_ReportErrorCondition("")
		print(lv_u)
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
	#{
		CUST.DATA.tranId = TRIM(BANCS.OUTPARAM.MTTTranId)
		PRINT(CUST.DATA.tranId)
	#}
	ENDIF

#--------------------------------------------------------------------
#       MTT Close
#--------------------------------------------------------------------

        lv_u = urhk_MTTS_Close("")
        print(lv_u)
#}
ENDIF
ENDOFSCRIPT:

END-->

