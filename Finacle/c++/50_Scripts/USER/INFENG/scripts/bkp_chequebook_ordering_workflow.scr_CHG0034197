			sv_b=sv_b+"<Header>"
			sv_b=sv_b+"<RequestHeader>"
			sv_b=sv_b+"<MessageKey>"
			sv_b=sv_b+"<RequestUUID>"+CUST.DATA.requestUUID+"</RequestUUID>"
			sv_b=sv_b+"<ServiceRequestId>"+CUST.DATA.serviceRequestId+"</ServiceRequestId>"	
			sv_b=sv_b+"<ServiceRequestVersion>10.2</ServiceRequestVersion>"
			sv_b=sv_b+"<ChannelId>OMN</ChannelId>"
			sv_b=sv_b+"<LanguageId></LanguageId>"
			sv_b=sv_b+"</MessageKey>"
			sv_b=sv_b+"<RequestMessageInfo>"
			sv_b=sv_b+"<BankId>"+BANCS.STDIN.contextBankId+"</BankId>"
			sv_b=sv_b+"<TimeZone></TimeZone>"
			sv_b=sv_b+"<EntityId></EntityId>"
			sv_b=sv_b+"<EntityType></EntityType>"
			sv_b=sv_b+"<ArmCorrelationId></ArmCorrelationId>"
			sv_b=sv_b+"<MessageDateTime>"+CUST.DATA.sysTimestamp+"</MessageDateTime>"
			sv_b=sv_b+"</RequestMessageInfo>"
			sv_b=sv_b+"<Security>"
			sv_b=sv_b+"<Token>"
			sv_b=sv_b+"<PasswordToken>"
			sv_b=sv_b+"<UserId></UserId>"
			sv_b=sv_b+"<Password></Password>"
			sv_b=sv_b+"</PasswordToken>"
			sv_b=sv_b+"</Token>"
			sv_b=sv_b+"<FICertToken></FICertToken>"
			sv_b=sv_b+"<RealUserLoginSessionId></RealUserLoginSessionId>"
			sv_b=sv_b+"<RealUser></RealUser>"
			sv_b=sv_b+"<RealUserPwd>"
			sv_b=sv_b+"</RealUserPwd>"
			sv_b=sv_b+"<SSOTransferToken>"
			sv_b=sv_b+"</SSOTransferToken>"
			sv_b=sv_b+"</Security>"
			sv_b=sv_b+"</RequestHeader>"
			sv_b=sv_b+"</Header>"
			sv_b=sv_b+ CUST.DATA.inputXmlMsg
			sv_b=sv_b+"</FIXML>"
			PRINT(sv_b)
			sv_a=urhk_ConnectToFIAndSendMsg(sv_b)
			print(sv_a)
			IF (sv_a != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.ErrMsg)==1) THEN
				#{
					sv_x=BANCS.OUTPARAM.ErrMsg
					print(BANCS.OUTPARAM.ErrMsg)
					#sv_u =urhk_SetOrbOut("RESULT|"+sv_x)
				#}
				ENDIF		

				GOTO NextRec
			#}
			ENDIF
			IF(FIELDEXISTS(BANCS.OUTPARAM.RespMesg)==1) THEN 
			#{
				CUST.DATA.RespMesg=BANCS.OUTPARAM.RespMesg
				PRINT(CUST.DATA.RespMesg)	
				## Status	
				CUST.DATA.statPos1 = GETIPOSITION(CUST.DATA.RespMesg, "<Status>")
				print(CUST.DATA.statPos1)
				CUST.DATA.statPos2 = GETIPOSITION(CUST.DATA.RespMesg, "</Status>")	
				print(CUST.DATA.statPos2)
				sv_a = MID$(CUST.DATA.RespMesg,cint(CUST.DATA.statPos1)+7,cint(CUST.DATA.statPos2) - cint(CUST.DATA.statPos1) - 8)
				print(sv_a)
				CUST.DATA.ResStat = sv_a
				print(CUST.DATA.ResStat)
				IF(CUST.DATA.ResStat =="SUCCESS") THEN
				#{
					print(CUST.DATA.RespMesg)
					CUST.DATA.custidPos1 = GETIPOSITION(CUST.DATA.RespMesg, "<RESULT_MSG>")
					print(CUST.DATA.custidPos1)
					CUST.DATA.custidPos2 = GETIPOSITION(CUST.DATA.RespMesg, "</RESULT_MSG>")	
					print(CUST.DATA.custidPos2)
					CUST.DATA.remarks = MID$(CUST.DATA.RespMesg,cint(CUST.DATA.custidPos1)+11,cint(CUST.DATA.custidPos2) - cint(CUST.DATA.custidPos1) - 12)
					print(CUST.DATA.remarks)
					CUST.DATA.ErrMsg               = ""
				ELSE
					print(CUST.DATA.RespMesg)
					CUST.DATA.custidPos1 = GETIPOSITION(CUST.DATA.RespMesg, "<ErrorDesc>")
					print(CUST.DATA.custidPos1)
					CUST.DATA.custidPos2 = GETIPOSITION(CUST.DATA.RespMesg, "</ErrorDesc>")	
					print(CUST.DATA.custidPos2)
					CUST.DATA.remarks = MID$(CUST.DATA.RespMesg,cint(CUST.DATA.custidPos1)+10,cint(CUST.DATA.custidPos2) - cint(CUST.DATA.custidPos1) - 11)
					CUST.DATA.ErrMsg = CUST.DATA.remarks
					print(CUST.DATA.ErrMsg)
					IF(CUST.DATA.ErrMsg=="")THEN
					#{
						CUST.DATA.ErrMsg = CUST.DATA.ResStat	
					#}	
					ENDIF	
				#}
				ENDIF		
			#}
			ELSE
			#{
				CUST.DATA.ErrMsg               = "Finacle System Error."
			#}
			ENDIF

			Update:
			
			print(CUST.DATA.ErrMsg)
			
			lv_a = ""
			lv_a = lv_a + " UPDATE CUSTOM.chequebook_ordering_workflow "
			lv_a = lv_a + " SET PROCESS_FLG = 'Y',"
				IF(CUST.DATA.ResStat =="SUCCESS") THEN
				#{
					lv_a = lv_a + " remarks = '"+CUST.DATA.remarks+"'"
				ELSE
					lv_a = lv_a + " remarks = '"+CUST.DATA.ErrMsg+"'"
				#}
				ENDIF	
			lv_a = lv_a + " WHERE PROCESS_FLG = 'N' "
			lv_a = lv_a + " AND seq_num = '"+CUST.DATA.seq_num+"' "
			lv_a = lv_a + " and solid = '"+BANCS.STDIN.mySolId+"'  "
			lv_a = lv_a + " and bank_id = '"+BANCS.STDIN.contextBankId+"'  "
			PRINT(lv_a)		
			lv_a = urhk_dbSQLWithBind(lv_a)
			PRINT(lv_a)	
			IF (lv_a == "0") THEN
		    	#{
				lv_a = urhk_dbSQLWithBind("COMMIT")
				print(lv_a)
			#}
			ENDIF
	
			NextRec:

			sv_z = urhk_dbCursorFetch(sv_m)
			print(sv_z)
		#}
		do
		sv_z = urhk_dbCursorClose(sv_m)			
	#}	 
	ELSE
	#{
		print("Record Not found")
		exitscript
	#}
	ENDIF
			
TRACE OFF
exitscript
