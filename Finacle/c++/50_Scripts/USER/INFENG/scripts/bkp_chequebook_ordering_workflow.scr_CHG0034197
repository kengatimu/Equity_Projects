<--START
TRACE ON

	#------------------------------
	# Create Repository
	#------------------------------

	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
		
	CUST.DATA.BodDate  		= MID$(BANCS.STDIN.BODDate,0,10)
	CUST.DATA.UserId 	    	= BANCS.STDIN.userId
	CUST.DATA.serviceRequestId  	= "executeFinacleScript"
	CUST.DATA.respMesg 		= ""
	CUST.DATA.TODFLG 		= "N"
	CUST.DATA.ErrMsg               	= ""
	
	sv_s = ""
	sv_s = sv_s + " seq_num,acctno,solid,leaves,startchqno,endchqno,noofchqs|"
	sv_s = sv_s + " select seq_num,acctno,solid,leaves,startchqno,endchqno,noofchqs "
	sv_s = sv_s + " from custom.chequebook_ordering_workflow"
	sv_s = sv_s + " where  PROCESS_FLG <> 'Y' "
	sv_s = sv_s + " and solid = '"+BANCS.STDIN.mySolId+"'  "
	sv_s = sv_s + " and bank_id = '"+BANCS.STDIN.contextBankId+"'  "

	#sv_s = sv_s + " and rownum <11  "
	print(sv_s)
	sv_d = urhk_dbcursorOpenWithBind(sv_s)
	IF(sv_d == 0)THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_z = urhk_dbCursorFetch(sv_m)
		if (sv_z != 0) then
		#{
			exitscript
		#}
		ENDIF

		while( sv_z == 0)
		#{
			CUST.DATA.seq_num	  = BANCS.OUTPARAM.seq_num
			CUST.DATA.acctno          = BANCS.OUTPARAM.acctno
			CUST.DATA.solid           = BANCS.OUTPARAM.solid
			CUST.DATA.leaves          = BANCS.OUTPARAM.leaves
			CUST.DATA.startchqno      = BANCS.OUTPARAM.startchqno
			CUST.DATA.endchqno        = BANCS.OUTPARAM.endchqno
			CUST.DATA.noofchqs        = BANCS.OUTPARAM.noofchqs	

			print(CUST.DATA.seq_num)       
			print(CUST.DATA.acctno)       
			print(CUST.DATA.solid)       
			print(CUST.DATA.leaves)       
			print(CUST.DATA.startchqno)       
			print(CUST.DATA.endchqno)       
			print(CUST.DATA.noofchqs)       
			

			#sv_a = urhk_getAcctDetailsInRepository(CUST.DATA.acctno)
			#print(sv_a)
			#CUST.DATA.EffAvailableAmt 	= cdouble(BANCS.OUTPARAM.EffAvailableAmt)
			#CUST.DATA.schmCode 	   	=  BANCS.OUTPARAM.schmCode
			#CUST.DATA.DEBIT_ACCTNAME  	=  MID$(BANCS.OUTPARAM.acctName,0,35)
			#CUST.DATA.acctOwnerShip   	=  BANCS.OUTPARAM.acctOwnerShip
			#print(CUST.DATA.schmCode)
			#print(CUST.DATA.EffAvailableAmt)
			#print(CUST.DATA.acctOwnerShip)

			CUST.DATA.Flag = "F"
			CUST.DATA.Msg = ""
			#--------------------------------
			# Fetching the timestamp 
			#---------------------------------
			sv_s = ""
			sv_s = sv_s + "sysDate,timestamp,reqTime| "
			sv_s = sv_s + " SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'), "
			sv_s = sv_s + " TO_CHAR(SYSTIMESTAMP,'HH24:MI:SS.FF3'), "
			sv_s = sv_s + " TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS') FROM DUAL"
			sv_s = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_s)
			IF(sv_s ==0)THEN
			#{
				CUST.DATA.sysDate   = BANCS.OUTPARAM.sysDate
				CUST.DATA.timestamp = BANCS.OUTPARAM.timestamp
				CUST.DATA.reqTime   = BANCS.OUTPARAM.reqTime
			#}
			ENDIF
			CUST.DATA.sysTimestamp = CUST.DATA.sysDate +"T"+CUST.DATA.timestamp

			## XML BODY 

			CUST.DATA.inputXmlMsg = ""
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<Body>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<executeFinacleScriptRequest>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<ExecuteFinacleScriptInputVO>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<requestId>FI_chqbook_ordering.scr</requestId>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "</ExecuteFinacleScriptInputVO>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<executeFinacleScript_CustomData>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<SolId>"+CUST.DATA.solid+"</SolId>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<reqStat>A</reqStat>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<acctNo>"+CUST.DATA.acctno+"</acctNo>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<funcCode>A</funcCode>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<leaves>"+CUST.DATA.leaves+"</leaves>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<endChqNo>"+CUST.DATA.endchqno+"</endChqNo>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<startChqNo>"+CUST.DATA.startchqno+"</startChqNo>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "<noOfChqs>"+CUST.DATA.noofchqs+"</noOfChqs>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "</executeFinacleScript_CustomData>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "</executeFinacleScriptRequest>"
			CUST.DATA.inputXmlMsg = CUST.DATA.inputXmlMsg + "</Body>"

			## XML BODY END 	

			print(CUST.DATA.inputXmlMsg)
			BANCS.INPARAM.SERVICE_NAME="FIJCA"
			BANCS.INPARAM.SEND_RECV_FLG="R"
			CUST.DATA.requestUUID = "CHQ_" +CUST.DATA.sysTimestamp+ CUST.DATA.seq_num	
			sv_b= ""
			sv_b=sv_b+"<?xml version='1.0' encoding='UTF-8'?>"
