#
<--START
TRACE ON
        #--------------------------------------------------------
        #create repository
        #--------------------------------------------------------

        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF
        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

	IF (CLASSEXISTS("CUST","CIETXN") == 0) THEN
        #{
                CREATECLASS("CUST","CIETXN",5)
        #}
        ENDIF

        #----------------------------------------------------------------------
        # Printing Bancs Repository
        #----------------------------------------------------------------------

	CUST.DATA.period = ""
	CUST.DATA.acctNum = ""
	CUST.DATA.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
	
	CUST.DATA.tranDate = BANCS.STDIN.BODDate
	CUST.DATA.tranType = "T"
	CUST.DATA.tranSubType ="BI"

	CUST.DATA.glDate = BANCS.STDIN.BODDate
	CUST.DATA.valueDate = BANCS.STDIN.BODDate

	CUST.DATA.dbSerial_num ="1"						
	CUST.DATA.debitPartTranType="D"
	CUST.DATA.laAcct = ""
	CUST.DATA.opCrncy= ""
	CUST.DATA.debitTranParticular="Anual Charges"

	CUST.DATA.crSerial_num ="2"
	CUST.DATA.creditPartTranType ="C" 
	CUST.DATA.opAcct = "" 
	CUST.DATA.creditRefCrncy=""
	CUST.DATA.creditTranParticular="Anual Charges"
	CUST.DATA.tranId=""
	CUST.DATA.refCrncy = "RWF"

	CUST.DATA.laAcct = "650020089"
	CUST.DATA.laAcct = BANCS.STDIN.mySolId +""+ CUST.DATA.laAcct
	
    
	#--------------------------------------------------------------------- 
	#Operative Account
	#---------------------------------------------------------------------
	
	lv_q = " laAcid | select acid from tbaadm.ldt where DMD_FLOW_ID in ('PIDEM','PRDEM') and DMD_DATE = TO_DATE(?SVAR,'DD-MM-RRRR') AND BANK_ID = ?SVAR "
	PRINT(lv_q)

	BANCS.INPARAM.BINDVARS = CUST.DATA.BODDate +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	lv_u = urhk_dbCursorOpenWithBind(lv_q)
	PRINT(lv_u)

	if(lv_u == 0)then
	#{
		CUST.DATA.CursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        print(CUST.DATA.CursorNum)

		sv_c=urhk_dbCursorFetch(CUST.DATA.CursorNum)

		WHILE(sv_c==0)
		#{
			CUST.DATA.laAcid = BANCS.OUTPARAM.laAcid
			PRINT(CUST.DATA.laAcid)
			
				lv_q = "opAcid |select OP_ACID from tbaadm.lam where acid = ?SVAR"
				print(lv_q)

				BANCS.INPARAM.BINDVARS = CUST.DATA.laAcid 
				PRINT(BANCS.INPARAM.BINDVARS)

				lv_u = urhk_dbSelectWithBind(lv_q)
				PRINT(lv_u)

				IF(lv_u ==0)THEN
				#{
					CUST.DATA.opAcid = BANCS.OUTPARAM.opAcid
					print(CUST.DATA.opAcid)
				#}
				endif	

				lv_q = " laAcct,lCrncy,laBal,opAcct,opCrncy,opBal | select "
				lv_q = lv_q + " (select foracid from tbaadm.gam where acid = ?SVAR) as L_ACCT, "
				lv_q = lv_q + " (SELECT ACCT_CRNCY_CODE FROM tbaadm.gam where acid =?SVAR ) AS L_CRNCY, "
				lv_q = lv_q + " (select CLR_BAL_AMT from tbaadm.gam where acid = ?SVAR) as LA_BAL, "
				lv_q = lv_q + " (select foracid from tbaadm.gam where acid = ?SVAR) as OP_ACCT, "
				lv_q = lv_q + " (select ACCT_CRNCY_CODE from tbaadm.gam where acid = ?SVAR) as OP_CRNCY, "
				lv_q = lv_q + " (select CLR_BAL_AMT from tbaadm.gam where acid = ?SVAR) as OP_BAL "
				lv_q = lv_q + "  from dual "
				PRINT(lv_q)

				BANCS.INPARAM.BINDVARS = CUST.DATA.laAcid +"|"+ CUST.DATA.laAcid +"|"+ CUST.DATA.laAcid +"|"+ CUST.DATA.opAcid +"|"+ CUST.DATA.opAcid +"|"+ CUST.DATA.opAcid
				PRINT(BANCS.INPARAM.BINDVARS)
				
				lv_u = urhk_dbSelectWithBind(lv_q)
				print(lv_u)

				if(lv_u == 0)then
				#{
					#CUST.DATA.laAcct = BANCS.OUTPARAM.laAcct
					#PRINT(CUST.DATA.laAcct)
					CUST.DATA.lCrncy = BANCS.OUTPARAM.lCrncy
					PRINT(CUST.DATA.lCrncy)
					CUST.DATA.creditRefCrncy = CUST.DATA.lCrncy
					PRINT(CUST.DATA.creditRefCrncy)
					CUST.DATA.laBal = (-1*(CDOUBLE(BANCS.OUTPARAM.laBal)))
					PRINT(CUST.DATA.laBal)
					CUST.DATA.opAcct = BANCS.OUTPARAM.opAcct
					CUST.DATA.drAcctNum = CUST.DATA.opAcct
					PRINT(CUST.DATA.opAcct)
					CUST.DATA.opCrncy = BANCS.OUTPARAM.opCrncy
					PRINT(CUST.DATA.opCrncy)
					CUST.DATA.opBal = BANCS.OUTPARAM.opBal
					PRINT(CUST.DATA.opBal)

					lv_q = "intrestAmt | select round(0.1 * SUM(?SVAR * 31/36500),2) as intrest from dual "
					PRINT(lv_q)

					BANCS.INPARAM.BINDVARS = CUST.DATA.laBal 

					lv_u = urhk_dbSelectWithBind(lv_q)
					PRINT(lv_u)

					if(lv_u == 0)then
					#{
						CUST.DATA.intreshAmt = BANCS.OUTPARAM.intrestAmt
						PRINT(CUST.DATA.intreshAmt)
						CUST.DATA.tranAmt = CUST.DATA.intreshAmt
						CUST.DATA.drRefAmt = CUST.DATA.tranAmt
					#}
					ENDIF	
				#}
				ENDIF

				
			
			if(CUST.DATA.intreshAmt > CUST.DATA.opBal)then
			#{
				CUST.DATA.remarks = "Monthly Fee"
				CALLSCRIPTIFEXIST("markLienCoge.scr")
				EXITSCRIPT
			#}
			ENDIF

			IF(CUST.DATA.opCrncy != CUST.DATA.refCrncy)THEN
			#{
				CUST.CIETXN.drAcctNumCcy = CUST.DATA.opCrncy 
				CUST.CIETXN.crAcctNumCcy = CUST.DATA.refCrncy 
				CALLSCRIPTIFEXIST("coge_fetchRateCode.scr")
				PRINT(CUST.RATE.rate)
				CUST.DATA.rate = CUST.RATE.rate
			#}
			ENDIF

			#--------------------------------------------------------------------
			#       MTT Close
			#--------------------------------------------------------------------

				lv_u = urhk_MTTS_Close("")
				print(lv_u)

			#--------------------------------------------------------------------
			#       MTT initialization
			#--------------------------------------------------------------------

				BANCS.INPARAM.PostTranFlg = "Y"
				BANCS.INPARAM.CommitFlg   = "Y"
				BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
				BANCS.INPARAM.RestrictModifyInd   = "FIRST_GROUP"
				BANCS.INPARAM.ErrorCheckForLuw   = "Y"

				BANCS.INPARAM.ValidationFlag            = "N"
				BANCS.INPARAM.CheckExceptions           = "Y"

				lv_u = urhk_MTTS_Initialize("")
				print(lv_u)

				IF(lv_u == "0") THEN
				#{
					print("Mtt initialized successfully")
				#}
				ELSE
				#{
					print("Mtt initialization failed")

					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						PRINT(MTT.Error.Description)
					#}
					ENDIF

					GOTO ENDOFSCRIPT
				#}
				ENDIF


			#--------------------------------------------------------------------
			#       MTT Definition
			#--------------------------------------------------------------------

				MTT.TranDetails.TranDate    = "0"
				MTT.TranDetails.TranType    = "T"
				MTT.TranDetails.TranSubType = "BI"
				MTT.TranDetails.PostFlag        = "Y"
				MTT.TranDetails.CommitFlg       = "Y"
				MTT.TranDetails.ValidationFlag  = "N"
				MTT.TranDetails.IgnoreExcp      = "I"

				lv_u = urhk_MTTS_DefineTransaction("TEST_TRAN")
				print(lv_u)

				IF(lv_u == "0") THEN
				#{
					print("Mtt defined successfully")
				#}
				ELSE
				#{
					print("Mtt definition failed")

					lv_u = urhk_MTTS_ReportErrorCondition("")
					print(lv_u)

					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						PRINT(MTT.Error.Description)
					#}
					ENDIF

					GOTO ENDOFSCRIPT
				#}
				ENDIF

			#--------------------------------------------------------------------
			#       MTT Dr part tran1 Definition
			#--------------------------------------------------------------------

				MTT.PartTranDetails.Account = CUST.DATA.opAcct 
				MTT.PartTranDetails.RefCurrency = CUST.DATA.refCrncy
				MTT.PartTranDetails.RefAmount   = -1 * CDOUBLE(CUST.DATA.tranAmt)
				MTT.PartTranDetails.ValueDate   = "0"
				MTT.PartTranDetails.Particulars = "Monthly Fee"
				MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
				MTT.PartTranDetails.Consolidate    = "N"

				MTT.PartTranDetails.PostFlag      = "Y"

				MTT.PartTranDetails.RateCode = "TTB"

				lv_u = urhk_MTTS_DefinePartTran("DR_TRAN")
				print(lv_u)

				IF(lv_u == "0") THEN
				#{
					print("Mtt DR part tran defined successfully")
				#}
				ELSE
				#{
					print("Mtt DR part tran definition failed")

					lv_u = urhk_MTTS_ReportErrorCondition("")
					print(lv_u)

					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						PRINT(MTT.Error.Description)
					#}
					ENDIF

					GOTO ENDOFSCRIPT
				#}
				ENDIF

			#--------------------------------------------------------------------
			#       MTT Cr part tran Definition
			#--------------------------------------------------------------------

				MTT.PartTranDetails.Account = CUST.DATA.laAcct 
				MTT.PartTranDetails.RefCurrency = CUST.DATA.refCrncy
				MTT.PartTranDetails.RefAmount   =  CUST.DATA.tranAmt 
				MTT.PartTranDetails.ValueDate   = "0"
				MTT.PartTranDetails.Particulars = "Monthly Fee"
				MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
				MTT.PartTranDetails.Consolidate    = "N"

				MTT.PartTranDetails.PostFlag      = "Y"

				MTT.PartTranDetails.RateCode = "TTB"
				MTT.PartTranDetails.Rate = CUST.DATA.rate

				lv_u = urhk_MTTS_DefinePartTran("CR_TRAN")
				print(lv_u)

				IF(lv_u == "0") THEN
				#{
					print("Mtt CR part tran defined successfully")
				#}
				ELSE
				#{
					print("Mtt CR part tran definition failed")

					lv_u = urhk_MTTS_ReportErrorCondition("")
					print(lv_u)

					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						PRINT(MTT.Error.Description)
					#}
					ENDIF

					GOTO ENDOFSCRIPT
				#}
				ENDIF

			#--------------------------------------------------------------------
			#       MTT end definition
			#--------------------------------------------------------------------

				lv_u = urhk_MTTS_EndDefinition("")
				print(lv_u)

				IF(FIELDEXISTS(MTT.Error.Description)) THEN
				#{
					print(MTT.Error.Description)
					lv_u = urhk_MTTS_ReportErrorCondition("")
					print(lv_u)
				#}
				ENDIF

				IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
				#{
					CUST.DATA.tranId = TRIM(BANCS.OUTPARAM.MTTTranId)
					PRINT(CUST.DATA.tranId)
				#}
				ENDIF

			#--------------------------------------------------------------------
			#       MTT Close
			#--------------------------------------------------------------------

				lv_u = urhk_MTTS_Close("")
				print(lv_u)
			sv_c=urhk_dbCursorFetch(CUST.DATA.CursorNum)
		#}
		DO

		sv_c=urhk_dbCursorClose(CUST.DATA.CursorNum)
	#}
	ENDIF
TRACE OFF
END-->
