<--START
TRACE ON
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF

	#----------------------------------------------------------------------
	# STEP1.0: initial variable values
	#----------------------------------------------------------------------
	CUST.DATA.payOffValueDate = BANCS.STDIN.BODDate
	CUST.DATA.laAcctforacid = CUST.MESSAGING.loan_acct 
	CUST.DATA.tranSubType = "BI"
	CUST.DATA.tranType = "T"
	CUST.DATA.collAcctforacid = CUST.MESSAGING.loan_op_acct 
	CUST.DATA.prePaymentType = "V"
	
	#----------------------------------------------------------------------
	# STEP2: invoke SRV_FetchLaAcctDtlForPayOff service
	#----------------------------------------------------------------------


	sv_b = urhk_SetUrhkInp("payOffCrit.funcCode|I")
	PRINT(sv_b)
	#----------------------------------------------------------------------
	#set input
	#----------------------------------------------------------------------
	PRINT(CUST.DATA.laAcctforacid)
	sv_b = urhk_SetUrhkInp("payOffCrit.laAcct.foracid|" + CUST.DATA.laAcctforacid)
	PRINT(sv_b)
	PRINT(CUST.DATA.payOffValueDate)
	sv_b = urhk_SetUrhkInp("payOffCrit.payOffValueDate|" + CUST.DATA.payOffValueDate)
	PRINT(sv_b)
	#----------------------------------------------------------------------
	#Payoff type: V-Voluntary/M-Mandatory
	#----------------------------------------------------------------------
	PRINT(CUST.DATA.prePaymentType)
	sv_b = urhk_SetUrhkInp("payOffCrit.prePaymentType|" + CUST.DATA.prePaymentType)
	PRINT(sv_b)
	#----------------------------------------------------------------------
	#Tran type: C-Cash/T-Transfer
	#----------------------------------------------------------------------
	PRINT(CUST.DATA.tranType)
	sv_b = urhk_SetUrhkInp("payOffCrit.tranType.tranType|" + CUST.DATA.tranType)
	PRINT(sv_b)
	sv_b = urhk_SetUrhkInp("payOffCrit.tranType.tranSubType|" + CUST.DATA.tranSubType)
	PRINT(sv_b)
	PRINT(CUST.DATA.collAcctforacid)
	sv_b = urhk_SetUrhkInp("payOffCrit.collAcct.foracid|" + CUST.DATA.collAcctforacid)
	PRINT(sv_b)
	#----------------------------------------------------------------------
	#out
	#----------------------------------------------------------------------
	sv_a = urhk_SetUrhkOut("payOffDtl.netPayOffAmtAdj|payOffAmount")
	PRINT(sv_a)
	#----------------------------------------------------------------------
	#invoke SRV
	#----------------------------------------------------------------------
	sv_u = urhk_ExecSrv("SRV_FetchLaAcctDtlForPayOff|same_user_verify = Y|retain_all_output = Y")
	IF (sv_u != 0) THEN
	#{
		CUST.DATA.srvErrFlg ="Y"
		CUST.DATA.successOrFailure = "F"
		exitscript
		#GOTO ERROREXIT
	#}
	ENDIF
	
	CUST.DATA.payOffAmount = BANCS.OUTPARAM.payOffAmount
	PRINT(CUST.DATA.payOffAmount)
	CUST.DATA.position = GETPOSITION(CUST.DATA.payOffAmount, "|")
	CUST.DATA.position = CINT(CUST.DATA.position) - 1
	PRINT(CUST.DATA.position)
	CUST.DATA.payOffAmount = MID$(CUST.DATA.payOffAmount, 0, CINT(CUST.DATA.position))
	PRINT(CUST.DATA.payOffAmount)
	
	
	ENDOFSCRIPT:
		
#trace off
END-->
