#	Input			: NA
#	Output			: NA
#	Called Script		: 
#	Menu Option		: FI(API)
#----------------------------------------------------------------------------------

<--START
TRACE ON
#---------------------------------------------------------------------------------  
# CREATING NEW REPOSITORY AND CLASS
#---------------------------------------------------------------------------------  

		IF (REPEXISTS("CUST") == 0) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF

		IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
		#{
			CREATECLASS("CUST", "CHQB", 5)
		#}
		ENDIF

		IF(CLASSEXISTS("CUST","GCHRG")==0) THEN
		#{
			CREATECLASS("CUST","GCHRG",5)
		#}
		ENDIF

		sv_u = urhk_B2k_PrintRepos("BANCS")
		PRINT(sv_u)

		CUST.GCHRG.requestId = ""
		CUST.CHQB.SolId = BANCS.INPUT.SolId
		IF(FIELDEXISTS(BANCS.INPUT.requestId))THEN
		CUST.CHQB.requestId = BANCS.INPUT.requestId
		ELSE 
		BANCS.INPUT.requestId = ""
		ENDIF
		IF(BANCS.INPUT.funcCode =="A")THEN
		#{
			CUST.CHQB.startChqNo = BANCS.INPUT.startChqNo
			print(CUST.CHQB.startChqNo)
			BANCS.INPUT.startChqNo = ""
			print(BANCS.INPUT.startChqNo)
			BANCS.INPUT.endChqNo=""
			BANCS.INPUT.reqStat ="A"
		#}
		ENDIF
		IF(BANCS.INPUT.funcCode =="V")THEN
		BANCS.INPUT.startChqNo = ""
		BANCS.INPUT.endChqNo=""
		BANCS.INPUT.reqStat ="E"
		ENDIF

		PRINT(BANCS.INPUT.funcCode)
		PRINT(BANCS.INPUT.acctNo)
		PRINT(BANCS.INPUT.noOfChqs)
		PRINT(BANCS.INPUT.leaves)
		PRINT(BANCS.INPUT.startChqNo)
		PRINT(BANCS.INPUT.endChqNo)
		PRINT(BANCS.INPUT.reqStat)
		#Print(BANCS.INPUT.instType)

		#---------------------------------------------------------------------------------
		# Initilization
		#---------------------------------------------------------------------------------
		CUST.CHQB.schmCode2= ""
		CUST.CHQB.schmCode3= ""
		CUST.CHQB.schmCode4= ""
		CUST.CHQB.schmCode5= ""
		CUST.CHQB.schmCode6= ""
		CUST.CHQB.schmCode7= ""
		CUST.CHQB.schmCode8= ""
		CUST.CHQB.schmCode9= ""
		CUST.CHQB.schmCode10= ""
		CUST.CHQB.schmCode13= ""
		CUST.CHQB.schmCode14= ""
		CUST.CHQB.schmCode15= ""
		CUST.CHQB.schmCode16= ""
		CUST.CHQB.schmCode17= ""
		CUST.CHQB.AmountTableCode1 = ""
		CUST.CHQB.crncyCode1 = ""
		CUST.CHQB.amount = "0"
		CUST.CHQB.AmountTableCode = ""
		CUST.CHQB.tot_amt = "0"
		CUST.CHQB.income_amt = "0"
		CUST.CHQB.stamp_amt = "0"
		CUST.GCHRG.successOrFailure =""
		CUST.GCHRG.gchrgErrMsg = ""
		sv_y=" "

		#---------------------------------------------------------------------------------
		# CPARAM set up
		#---------------------------------------------------------------------------------

		BANCS.INPUT.moduleName  = "CHQB"
		BANCS.INPUT.parameterId = "CHQNO"
		CALL ("getcparamvalue.scr")

		IF(BANCS.OUTPUT.parameterVal != "")THEN
		#{
			CUST.CHQB.chqNo = BANCS.OUTPUT.parameterVal
		#}
		ELSE
		#{
			sv_e = "ChqNO setup not done in CPARAM"
			sv_m = "count"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		#####################################################

		sv_p = urhk_B2k_PID("")
		IF(sv_p == 0 ) THEN
		#{
			CUST.CHQB.pid = TRIM(BANCS.OUTPARAM.PID)
			print(CUST.CHQB.pid)
		#}
		ELSE
		#{
			CUST.CHQB.pid = "123" 
			print(CUST.CHQB.pid)				
		#}
		ENDIF

		#--------------------------------------------------------------------------------- 
		# Check if directory exists and create
		#--------------------------------------------------------------------------------- 
		sv_p = system("test -d ${UPLOAD_INPUT_FILE_PATH}/"+ BANCS.STDIN.userId)
		IF(sv_p != 0 ) THEN
		#{
			sv_p = system("mkdir ${UPLOAD_INPUT_FILE_PATH}"+"/"+ BANCS.STDIN.userId)
			print(sv_p)
		#}
		ENDIF

		#--------------------------------------------------------------------------------- 
		# check if account no filed is blank.
		#--------------------------------------------------------------------------------- 
		CUST.CHQB.function 			= BANCS.INPUT.funcCode
		CUST.CHQB.requestId     	= BANCS.INPUT.requestId
		CUST.CHQB.acctNum   		= BANCS.INPUT.acctNo
		CUST.CHQB.noOfChq   		= BANCS.INPUT.noOfChqs
		CUST.CHQB.leaves    		= BANCS.INPUT.leaves
		CUST.CHQB.chqStartSrlNum    = BANCS.INPUT.startChqNo
		CUST.CHQB.chqEndSrlNum      = BANCS.INPUT.endChqNo
		CUST.CHQB.reqStatus 		= BANCS.INPUT.reqStat

	IF (fieldexists(CUST.CHQB.acctNum)) THEN
	#{
	IF (TRIM(CUST.CHQB.acctNum) == "") THEN
	#{
		sv_e = "Please enter account no"
		sv_m = "acctNo"
		sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		sv_x = "ValidateAccout|Select count(*) from tbaadm.gam where foracid = ?SVAR "
		sv_x = sv_x + " and schm_type in ('CAA','ODA','SBA') and entity_cre_flg = 'Y' and del_flg !='Y' and acct_cls_flg !='Y'" 
		sv_x = sv_x + " and bank_id = ?SVAR "
		print(sv_x)
		BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum   + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_x = urhk_dbSelectWithBind(sv_x)
		print(sv_x)
		IF (sv_x != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.CHQB.valAcct = BANCS.OUTPARAM.ValidateAccout
			print(BANCS.OUTPARAM.ValidateAccout)	
		#}
		ENDIF
	
			
		IF (CUST.CHQB.valAcct <= 0) THEN
		#{
			sv_e = "Incorrect Account No. / Accounts of schm other than (SBA,CAA,ODA) are "
			sv_m = "acctNo"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = urhk_getAcctDetailsInRepository(CUST.CHQB.acctNum)
		PRINT(sv_a)
		IF (sv_a == 0) THEN
		#{
			print(BANCS.OUTPARAM.freezeCode)
			IF (BANCS.OUTPARAM.freezeCode != " ") THEN
			#{
				sv_e = "Frozen Account ,Cheque Book request cannot be processed"
				sv_m = "acctNo"
				sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			print(CUST.CHQB.SolId)
			print(BANCS.OUTPARAM.acctSolId)
			print(BANCS.OUTPARAM.schmCode)
			print(BANCS.OUTPARAM.acctCrncyCode)
			CUST.CHQB.schmCode = BANCS.OUTPARAM.schmCode
			PRINT(CUST.CHQB.schmCode)
			CUST.CHQB.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
			PRINT(CUST.CHQB.EffAvailableAmt)
			CUST.CHQB.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
			print(CUST.CHQB.acctCrncyCode)
						
			#IF (CUST.CHQB.SolId != BANCS.OUTPARAM.acctSolId) THEN
			#{
				#sv_e = "Account belongs to different SOL"
				#sv_m = "acctNo"
				#sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
				#sv_u = urhk_SetOrbOut(sv_e)
				#sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				#GOTO ENDOFSCRIPT
			#}
			#ENDIF

			IF (BANCS.OUTPARAM.acctSolId=="777") THEN
			#{
				sv_e = "Chequebook not Allowed for this Branch"
				sv_m = "acctNo"
				sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF ((CUST.CHQB.schmCode == CUST.CHQB.schmCode9) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode10) OR (CUST.CHQB.schmCode == "VA300")) THEN
			#{
				sv_e = "Chq Book issue is not Allowed for this scheme"
				sv_m = "acctNo"
				sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF



		sv_x = "ACCT_STATUS|Select ACCT_STATUS from tbaadm.SMT where acid = (select acid from tbaadm.gam where foracid= ?SVAR and bank_id = ?SVAR) and bank_id = ?SVAR"
		print(sv_x)
		BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_x = urhk_dbSelectWithBind(sv_x)
		PRINT(sv_x)
		
		IF (sv_x != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			IF (BANCS.STDIN.contextBankId=="54") THEN
			#{
				IF (BANCS.OUTPARAM.ACCT_STATUS == "D") THEN
				#{
					sv_e = "Account is not active"
					sv_m = "acctNo"
					sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ELSE
			#{
				IF ((BANCS.OUTPARAM.ACCT_STATUS == "I") OR (BANCS.OUTPARAM.ACCT_STATUS == "D")) THEN
				#{
				sv_e = "Account is not active"
				sv_m = "acctNo"
				sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
				ENDIF

			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
#}
ENDIF

#---------------------------------------------------------------------------------
#  Validation For No. Of Cheque Books Required Field
#             1) Only No. of cheque books between 1-99 is permitted.
#---------------------------------------------------------------------------------
IF (fieldexists(CUST.CHQB.noOfChq)) THEN
#{
	IF (trim(CUST.CHQB.noOfChq) == "") THEN
	#{
		sv_e = "Please Enter No. Of Cheque Books Required between 1 - 99"
		sv_m = "noOfChqs"
		sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		IF ((CUST.CHQB.leaves==1) AND (CUST.CHQB.noOfChq!=1)) THEN
		#{
			sv_e = " Number Of Cheque Book Qty should be 1 if Cheque leaves quantity is 1"
			sv_m = "noOfChqs"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF ((CUST.CHQB.noOfChq < 1) OR (CUST.CHQB.noOfChq > 99 )) THEN
		#{
			sv_e = "Please Enter Cheque book quantity between 1-99"
			sv_m = "noOfChqs"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
#}
ENDIF				

#---------------------------------------------------------------------------------
#  Validation For No. Of Cheque Leaves Required Field
#              1) Only values 50 or 100 are accepted
#---------------------------------------------------------------------------------
IF (fieldexists(CUST.CHQB.leaves)) THEN
#{
	IF(trim(CUST.CHQB.leaves) == "") THEN
	#{
		sv_e = "Please Enter No. leaves per Cheque Book Required"
		sv_m = "leaves"
		sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		IF((CUST.CHQB.leaves != 50) AND (CUST.CHQB.leaves !=100 ) AND (CUST.CHQB.leaves != 25)) THEN
		#{
			sv_e = "Please Enter Cheque leaves quantity 25 or 50 or 100 only"
			sv_m = "leaves"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
#}
ENDIF
#--------------------------------------------------------------------------------
# Check for the start serial number.
#--------------------------------------------------------------------------------
#IF (fieldexists(CUST.CHQB.chqStartSrlNum)) THEN
IF (CUST.CHQB.chqStartSrlNum != "") THEN
#{
	IF (CUST.CHQB.chqStartSrlNum == "") THEN
	#{
		sv_e = "Please Enter a valid start serial number."
		sv_m = "startChqNo"
		sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		sv_x = "ValidateAllowed|SELECT NVL(COUNT(*),0) FROM tbaadm.GAM,tbaadm.GSP WHERE "
		sv_x = sv_x + "GAM.FORACID = ?SVAR "  
		sv_x = sv_x + "AND GAM.SCHM_CODE = GSP.SCHM_CODE "
		sv_x = sv_x + "AND GSP.CHQ_ALWD_FLG = 'Y' "
		sv_x = sv_x + "AND GAM.BANK_ID = ?SVAR "
		print(sv_x)
		BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum   + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS )
		sv_x = urhk_dbSelectWithBind(sv_x)
		PRINT(sv_x)
		CUST.CHQB.ValidateAllowed=BANCS.OUTPARAM.ValidateAllowed
		PRINT(CUST.CHQB.ValidateAllowed)
		PRINT(sv_x)
		IF (sv_x != 0) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (CUST.CHQB.ValidateAllowed == 0 ) THEN
		#{
			sv_e = "Cheques cannot be issued to this account."
			sv_m = "acctNo"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		sv_s = "srlNo "
        sv_s = sv_s + " | "
        sv_s = sv_s + " SELECT NVL(MAX(TO_NUMBER(NVL(CBT.begin_chq_num,0)) + CBT.chq_num_of_lvs),1) "
        sv_s = sv_s + " FROM TBAADM.CBT ,TBAADM.GAM "
        sv_s = sv_s + " WHERE GAM.foracid = ?SVAR "
        sv_s = sv_s + " AND GAM.acid = CBT.acid "
        sv_s = sv_s + " AND GAM.bank_id = CBT.bank_id "
        sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
        print(sv_s)

        BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
        print(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        print(sv_d)

        IF(sv_d == 0 ) THEN
        #{
                CUST.CHQB.start_srl_no = BANCS.OUTPARAM.srlNo
                CUST.CHQB.END_srl_no = cint(CUST.CHQB.start_srl_no) + (cint(CUST.CHQB.noOfChq)*cint(CUST.CHQB.leaves)) - 1
        #}
        ELSE
        #{
                sv_u = urhk_SetOrbOut("Error_01|ERROR:^A Database error has occured. Please contact your DBA.")
        		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
        		GOTO ENDOFSCRIPT
        #}
        ENDIF
	

		print(CUST.CHQB.chqStartSrlNum)
		print(CUST.CHQB.leaves)
		print(CUST.CHQB.noOfChq)
		
		sv_x = "ValidateStart|SELECT NVL(COUNT(*),0) FROM CUSTOM.CUSTOM_CBR WHERE "
		sv_x = sv_x + " (BEGIN_CHQ_NUM + (NUM_OF_CHB * NUM_OF_CHQ_LVS)) >= ?SVAR "
		sv_x = sv_x + " AND FORACID = ?SVAR "
		#sv_x = sv_x + " AND REQ_STATUS = 'S'"
		sv_x = sv_x + " AND REQ_STATUS = 'A'"
		sv_x = sv_x + " AND NUM_OF_CHQ_LVS = ?SVAR "
		sv_x = sv_x + " AND BANK_ID =?SVAR "
		print(sv_x)
		BANCS.INPARAM.BINDVARS =  CUST.CHQB.start_srl_no  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_x = urhk_dbSelectWithBind(sv_x)
		PRINT(sv_x)
		CUST.CHQB.ValidateStart=BANCS.OUTPARAM.ValidateStart
		PRINT(CUST.CHQB.ValidateStart)
		print(CUST.CHQB.chqEndSrlNum )
		
		sv_z = "ValidateEnd|SELECT NVL(COUNT(*),0) FROM CUSTOM.CUSTOM_CBR WHERE "
		sv_z = sv_z + " (BEGIN_CHQ_NUM + (NUM_OF_CHB * NUM_OF_CHQ_LVS)) >= ?SVAR "
		sv_z = sv_z + " AND FORACID = ?SVAR "
		#sv_z = sv_z + " AND REQ_STATUS = 'S'"
		sv_z = sv_z + " AND REQ_STATUS = 'A'"
		sv_z = sv_z + " AND NUM_OF_CHQ_LVS = ?SVAR "
		sv_z = sv_z + " AND bank_id = ?SVAR "
		print(sv_z)
		BANCS.INPARAM.BINDVARS =  CUST.CHQB.END_srl_no  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_z = urhk_dbSelectWithBind(sv_z)
		PRINT(sv_z)
		CUST.CHQB.ValidateEnd=BANCS.OUTPARAM.ValidateEnd
		PRINT(CUST.CHQB.ValidateEnd)
		
		IF ((sv_x != 0) or (sv_z != 0)) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF ((CUST.CHQB.ValidateStart == 0 ) OR (CUST.CHQB.ValidateEnd == 0)) THEN
		#{
			sv_e = "No. of Cheque Books/Leaves Does not match with request entered"
			sv_m = "count"
			sv_e = "RESULT_MSG|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_x = "crncyCode|SELECT ACCT_CRNCY_CODE FROM TBAADM.GAM WHERE FORACID =?SVAR "
		print(sv_x)
		sv_x = sv_x + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_x = urhk_dbSelectWithBind(sv_x)
		PRINT(sv_x)
		IF ((sv_x != 0 )) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
