	print(sv_s)

		###############update schedule
		IF((EQOD.GLBDATA.schmCode == "OD542") OR (EQOD.GLBDATA.schmCode == "OD543") OR (EQOD.GLBDATA.schmCode == "OD544") OR (EQOD.GLBDATA.schmCode == "OD545") OR (EQOD.GLBDATA.schmCode == "OD546") OR (EQOD.GLBDATA.schmCode == "OD549") OR (EQOD.GLBDATA.schmCode == "DL002")  OR (EQOD.GLBDATA.schmCode == "OD552")) THEN
		#{
			call("updateScheduleOnReversal.scr")
		#}
		ENDIF

		lv_i = "update CUSTOM.OD_REV_TBL set TRAN_DATE = to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') , TRAN_ID = ?SVAR , REVERSAL_FLG = 'V' , ENTITY_CRE_FLG = 'Y' , LCHG_USER_ID = ?SVAR , LCHG_TIME = sysdate , REVERSAL_COMMENTS = 'Complete' "
		lv_i = lv_i + " where OD_ACID = ?SVAR and CONT_TRAN_DATE = to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') and CONT_TRAN_ID = lpad(?SVAR,9) and bank_id = ?SVAR and ENTITY_CRE_FLG = 'N' "
		print(lv_i)

		BANCS.INPARAM.BINDVARS = BANCS.STDIN.BODDate + "|" + EQOD.GLBDATA.tranid + "|" + BANCS.STDIN.userId + "|" + EQOD.GLBDATA.acidOD + "|" + mid$(EQOD.GLBDATA.lstAdjDate2,0,10) + "|" + EQOD.GLBDATA.tranId + "|" + BANCS.STDIN.contextBankId
        	print(BANCS.INPARAM.BINDVARS)

        	lv_d = urhk_dbSqlWithBind(lv_i)
        	if(lv_d==0)then
			lv_u = urhk_dbSqlWithBind("commit")
        		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
        		EQOD.GLBDATA.msg = "Reversal Verified Successfully. Tran ID " + EQOD.GLBDATA.tranid
        		sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
        		print(sv_c)
		else
			lv_u = urhk_dbSqlWithBind("rollback")
        		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
        		EQOD.GLBDATA.msg = "Reversal Verified Successfully But table update failed. Tran ID " + EQOD.GLBDATA.tranid
        		sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
        		print(sv_c)
		endif
#}
ENDIF

IF(EQOD.GLBDATA.funcCode == "X") THEN
#{
		lv_i = "update CUSTOM.OD_REV_TBL set REVERSAL_FLG = 'X' , ENTITY_CRE_FLG = 'Y' , LCHG_USER_ID = ?SVAR , LCHG_TIME = sysdate , REVERSAL_COMMENTS = 'Canceled' "
		lv_i = lv_i + " where OD_ACID = ?SVAR and CONT_TRAN_DATE = to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') and CONT_TRAN_ID = lpad(?SVAR,9) and bank_id = ?SVAR and ENTITY_CRE_FLG = 'N' "
		print(lv_i)

		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + EQOD.GLBDATA.acidOD + "|" + EQOD.GLBDATA.lstAdjDate + "|" + EQOD.GLBDATA.tranId + "|" + BANCS.STDIN.contextBankId
        	print(BANCS.INPARAM.BINDVARS)

        	lv_d = urhk_dbSqlWithBind(lv_i)
        	if(lv_d==0)then
			lv_u = urhk_dbSqlWithBind("commit")
        		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
        		EQOD.GLBDATA.msg = "Reversal Canceled Successfully."
        		sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
        		print(sv_c)
		else
			lv_u = urhk_dbSqlWithBind("rollback")
        		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
        		EQOD.GLBDATA.msg = "Reversal Cancel Failed"
        		sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
        		print(sv_c)
		endif
#}
ENDIF

