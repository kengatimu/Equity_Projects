#--------------------------------------------------------------------------------------------------------------------
#  Name            : getAcctBalance.scr
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             14-10-2024      Dennis Chirchir      Original Version - Get Agency balance
#---------------------------------------------------------------------------------------------------------------------
<--start
#trace on

#populating Balance, account name and acid
#-------------------
sv_c = "crncyCode,clrBalAmt,unclrBalAmt,futClrBalAmt,futUnClrBalAmt,acctCrncyCode,fxClrBalAmt,acName,acid "
sv_c = sv_c +"| select crncy_code, clr_bal_amt, un_clr_bal_amt, "
sv_c = sv_c +"future_clr_bal_amt, future_un_clr_bal_amt, acct_crncy_code, fx_clr_bal_amt,acct_name,acid "
sv_c = sv_c +"from gam where gam.bank_id = ?SVAR and foracid = ?SVAR "
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.foracid
sv_d = urhk_dbSelectWithBind(sv_c)
if(sv_d == 0) then
        sv_e = BANCS.OUTPARAM.crncyCode
        sv_f = BANCS.OUTPARAM.clrBalAmt
        sv_g = BANCS.OUTPARAM.unclrBalAmt
        sv_h = BANCS.OUTPARAM.futClrBalAmt
        sv_i = BANCS.OUTPARAM.futUnClrBalAmt
        sv_j = BANCS.OUTPARAM.acctCrncyCode
        sv_k = BANCS.OUTPARAM.fxClrBalAmt
        BANCS.OUTPUT.acct_name = BANCS.OUTPARAM.acName
        sv_s = BANCS.OUTPARAM.acid
    if(BANCS.OUTPARAM.crncyCode == "") then
        if(fieldexists(BANCS.INPARAM.futValDate)) then
           sv_n = BANCS.INPARAM.futValDate
        else
        	sv_l = "futValDate|select future_value_dt_cr_flg from gct where BANK_ID = ?SVAR "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
        	sv_m = urhk_dbSelectWithBind(sv_l)
        	if(sv_m == 0) then
                sv_n = BANCS.OUTPARAM.futValDate
            endif
        endif
        if(sv_n == 'Y') then
            sv_p = (cdouble(sv_f)) + (cdouble(sv_g)) + (cdouble(sv_h)) + (cdouble(sv_i))
        else
            sv_p = (cdouble(sv_f)) + (cdouble(sv_g))
        endif
        sv_o = sv_j
    else
        sv_p = sv_k
        sv_o = sv_e
    endif
else
    sv_p = 0.00
	exitscript
endif
sv_p = Format$(sv_p, "%.2f")
print(sv_p)
if (sv_p < 0) then
	sv_q = LTRIM(sv_p, '-')
	#Agent Float 
	if(fieldexists(BANCS.INPUT.oAvailableAmt)==1)then
		sv_q = cdouble(sv_q) + cdouble(BANCS.INPUT.oAvailableAmt)
		print(sv_q)
	endif
	BANCS.INPARAM.InputAmount =sv_q
	BANCS.INPARAM.FromCurrency =sv_o
	BANCS.INPARAM.AmountWidth = 25
	sv_z = urhk_B2k_floatWithComma("")
	sv_a = BANCS.OUTPARAM.OutputAmount
	if((sv_a == "") OR (sv_a == 0)) then
	    sv_a = "0.00"
		endif
    sv_q = sv_a + " Dr"
else
	#Agent Float 
	if(fieldexists(BANCS.INPUT.oAvailableAmt)==1)then
		sv_p = cdouble(sv_p) + cdouble(BANCS.INPUT.oAvailableAmt)
		print(sv_p)
	endif
   	BANCS.INPARAM.InputAmount =sv_p
    BANCS.INPARAM.FromCurrency =sv_o
    BANCS.INPARAM.AmountWidth = 25
    sv_z = urhk_B2k_floatWithComma("")
    sv_a = BANCS.OUTPARAM.OutputAmount
    if((sv_a == "") OR (sv_a == 0)) then
        sv_a = "0.00"
        endif
	sv_q = sv_a + " Cr"
endif
print(sv_q)
BANCS.OUTPUT.balance = sv_q
	sv_r = urhk_GetDesc("checkUsrAccessOnAcct|acid="+sv_s+"|foracid=BANCS.INPUT.foracid")
	if(sv_r != 0) then
    	BANCS.OUTPUT.balance = "XXXX"
	endif

#trace off
end-->
