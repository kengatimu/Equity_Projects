#
<--START
TRACE ON

        ################################################################################
        #   Checking whether Repository CUST exists or not and creating, if it does
        #   not exists
        ################################################################################
        IF ((REPEXISTS("CUST")) == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        ################################################################################
        #   Checking whether Class DATA exists or not and creating, if it does
        #   not exists
        ################################################################################
        IF((CLASSEXISTS("CUST","DATA")) == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF
        PRINT(CUST.DATA.remarks)
        CUST.DATA.foracid = CUST.DATA.drAcctNum
        CUST.DATA.leinAmt = CUST.DATA.drRefAmt
        CUST.DATA.frmDate = MID$(BANCS.STDIN.BODDate,0,10)
        CUST.DATA.toDate = "31-12-2099"
        CUST.DATA.reasonCode = "LIEN"
        CUST.DATA.chgdFlg = "L"
        #CUST.DATA.remarks = "Balance Inquery Lien"

        #------------------------------------------------------------------------------
        # get list of  account
        #------------------------------------------------------------------------------

        BANCS.INPARAM.acctNum       =   CUST.DATA.foracid
        BANCS.INPARAM.blockMode     =   "A"
        BANCS.INPARAM.lienAmt       =   cdouble(CUST.DATA.leinAmt)
        BANCS.INPARAM.remarks       =   CUST.DATA.remarks
        BANCS.INPARAM.bodDate       =   CUST.DATA.frmDate
        BANCS.INPARAM.expiryDate    =   CUST.DATA.toDate
        BANCS.INPARAM.reasonCode    =   CUST.DATA.reasonCode
        BANCS.INPARAM.lienValueDate =   CUST.DATA.frmDate

        lv_u = urhk_updateLien("")
        print(lv_u)

        If(lv_u == 0)THEN
        #{
                CUST.DATA.MSG = "Lein amount has been Marked for this Account " +CUST.DATA.foracid+ " Number"
                print("successfully")
                CUST.DATA.succFail = "S"
                GOTO RESPONSE
        #}
        ELSE
        #{
                CUST.DATA.MSG = "Lein amount has not Marked for this Account " +CUST.DATA.foracid+ " Number"
                CUST.DATA.succFail = "F"
                GOTO RESPONSE
        #}
        ENDIF


RESPONSE:

        IF(CUST.DATA.succFail == "S")THEN
        #{
                sv_e = urhk_SetOrbOut("SuccessorFailure|Sucess")
                sv_e = urhk_SetOrbOut("AccountStatus| "+CUST.DATA.MSG)
        #}
        ELSE
        #{
                sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
                sv_e = urhk_SetOrbOut("Failed| "+CUST.DATA.MSG)
        #}
        ENDIF
        GOTO ENDOFSCRIPT

ENDOFSCRIPT:
EXITSCRIPT

END-->
