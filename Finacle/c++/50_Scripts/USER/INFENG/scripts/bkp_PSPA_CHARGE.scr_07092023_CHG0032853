<--START
TRACE ON
	
	sv_a = urhk_b2k_printRepos("BANCS")
	print(sv_a)

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","CHRG") == 0) THEN
        #{
                CREATECLASS("CUST","CHRG",5)
        #}
        ENDIF

	IF (fieldexists(BANCS.OUTPARAM.DccId) == 1) THEN
        #{
                CUST.CHRG.ChannelId     = BANCS.OUTPARAM.DccId 
        ELSE
                CUST.CHRG.ChannelId     = "" 
        #}
        ENDIF

	print(BANCS.INPUT.Foracid)
	print(BANCS.STDIN.contextBankId)
	print(BANCS.INPUT.pspNumOfCopies)
	print(BANCS.INPUT.totNumOfLines)
	print(BANCS.INPUT.pspCritFromDate)
	print(BANCS.INPUT.pspCritToDate)
	print(BANCS.INPUT.pspGlbTranCount)
	print(BANCS.INPUT.pspPrncAcctProc)
	print(BANCS.INPUT.pspNoOfRelPartyProc)

	sv_a = "count|"			
	sv_a = sv_a + " select count(*) from tbaadm.cxl "
	sv_a = sv_a + " where target_acid  =  (select acid from tbaadm.gam where gam.bank_id = cxl.bank_id and foracid = '"+BANCS.INPUT.Foracid+"')"
	sv_a = sv_a + " and bank_id ='"+BANCS.STDIN.contextBankId+"' "
	sv_a = sv_a + " and  event_type = '"+BANCS.INPUT.eventType+"' " 
	sv_a = sv_a + " and event_id = '"+BANCS.INPUT.eventId+"'  "
	sv_a = sv_a + " and end_date between to_date('01-01-"+MID$(BANCS.STDIN.BODDate,6,4)+"','DD-MM-YYYY')"
	sv_a = sv_a + " and  to_date('31-12-"+MID$(BANCS.STDIN.BODDate,6,4)+"','DD-MM-YYYY') "

	PRINT(sv_a)
	sv_d = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_d)

	IF(sv_d == 0)THEN
	#{
		CUST.CHRG.count = BANCS.OUTPARAM.count
		PRINT(CUST.CHRG.count)
		IF(CINT(CUST.CHRG.count) < CINT("1"))THEN
		#{
			BANCS.OUTPUT.AmountWithNoDiscount       = CDOUBLE("1000")
			BANCS.OUTPUT.collAmount                 = CDOUBLE("0")
			BANCS.OUTPUT.collCrncy                  = "RWF"
		ELSE
			sv_a = "chrg_amt|select ceil("+BANCS.INPUT.totNumOfLines+"/34) * 1000 from dual "	
			PRINT(sv_a)
			sv_d = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_d)
			IF(sv_d == 0)THEN
			#{
				BANCS.OUTPUT.AmountWithNoDiscount = BANCS.OUTPARAM.chrg_amt 
			ELSE
				BANCS.OUTPUT.AmountWithNoDiscount = CDOUBLE("1000")
			#}
			ENDIF

			BANCS.OUTPUT.collAmount 		= BANCS.OUTPUT.AmountWithNoDiscount 
			BANCS.OUTPUT.collCrncy			= "RWF"
		#}
		ENDIF
	#}
	ENDIF

	PRINT(BANCS.OUTPUT.AmountWithNoDiscount)
	PRINT(BANCS.OUTPUT.collCrncy)
	PRINT(BANCS.OUTPUT.collAmount)

TRACE OFF
END-->

