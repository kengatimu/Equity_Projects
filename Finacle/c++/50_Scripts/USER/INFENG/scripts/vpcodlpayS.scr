#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#  Name            : vpcodlpayS.scr
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#  Description     :
#  Date            : 11-11-2021
#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             11-11-2021      Vino Palani          Original Version
#  2.0             15-10-2024      Dennis Chirchir      DRC entity multischedule add - CHG0034702
#  3.0             06-05-2025      Dennis Chirchir      Adding reversal function
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
        lv_b = urhk_B2K_PrintRepos("BANCS")
        print(lv_b)
        if(repexists("EQOD")==0)then
                createrep("EQOD")
        endif
        if(classexists("EQOD","GLBDATA")==0)then
                createclass("EQOD","GLBDATA",5)
        endif
        EQOD.GLBDATA.isrecovYN = "N"
        if(fieldexists(BANCS.INPUT.accNum)==1)then
                print(BANCS.INPUT.accNum)
                EQOD.GLBDATA.accNum = BANCS.INPUT.accNum
        else
                EQOD.GLBDATA.accNum = ""
        endif
        if(fieldexists(BANCS.INPUT.OperaccNum)==1)then
                print(BANCS.INPUT.OperaccNum)
                EQOD.GLBDATA.OperaccNum = BANCS.INPUT.OperaccNum
        else
                EQOD.GLBDATA.OperaccNum = ""
        endif
        if(fieldexists(BANCS.INPUT.refCrncy)==1)then
                print(BANCS.INPUT.refCrncy)
                EQOD.GLBDATA.refCrncy = BANCS.INPUT.refCrncy
        else
                EQOD.GLBDATA.refCrncy = ""
        endif
        if(fieldexists(BANCS.INPUT.refAmt)==1)then
                print(BANCS.INPUT.refAmt)
                EQOD.GLBDATA.refAmt = BANCS.INPUT.refAmt
        else
                EQOD.GLBDATA.refAmt = ""
        endif
        if(fieldexists(BANCS.INPUT.funcCode)==1)then
                print(BANCS.INPUT.funcCode)
                EQOD.GLBDATA.funcCode = BANCS.INPUT.funcCode
        else
                EQOD.GLBDATA.funcCode = ""
        endif
        if(fieldexists(BANCS.INPUT.reshDate)==1)then
                print(BANCS.INPUT.reshDate)
                EQOD.GLBDATA.reshDate = BANCS.INPUT.reshDate
        else
                EQOD.GLBDATA.reshDate = ""
        endif
#----------------------------------------------------------------------------------->OD548 collection update start by silvester
	sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.accNum)
	IF(sv_u ==0)then
	#{
		EQOD.GLBDATA.opglSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
		EQOD.GLBDATA.opsolId     =       BANCS.OUTPARAM.acctSolId
		EQOD.GLBDATA.opschmType  =       BANCS.OUTPARAM.schmType
		EQOD.GLBDATA.odschmCode=       BANCS.OUTPARAM.schmCode
	#}
	ENDIF
	sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.OperaccNum)
	IF(sv_u ==0)then
	#{
		EQOD.GLBDATA.opglSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
		EQOD.GLBDATA.opsolId     =       BANCS.OUTPARAM.acctSolId
		EQOD.GLBDATA.opschmType  =       BANCS.OUTPARAM.schmType
		EQOD.GLBDATA.opschmCode=       BANCS.OUTPARAM.schmCode
	#}
	ENDIF

	IF((EQOD.GLBDATA.funcCode == "Z") OR (EQOD.GLBDATA.funcCode == "V") OR (EQOD.GLBDATA.funcCode == "X")) THEN
		callscriptifexist("vpCodlpayReversalsTransfer.scr")
		exitscript
	ENDIF

        sv_a = ""
        sv_a = sv_a + " chrge_off_flg|"
        sv_a = sv_a + " select chrge_off_flg "
        sv_a = sv_a + " from tbaadm.gam,tbaadm.gac"
        sv_a = sv_a + " where gam.bank_id = '"+BANCS.STDIN.contextBankId+"' "
        sv_a = sv_a + " and gam.bank_id = gac.bank_id "
        sv_a = sv_a + " and gam.acid = gac.acid "
        sv_a = sv_a + " and gam.foracid = '"+EQOD.GLBDATA.accNum+"' "
        print(sv_a)

        lv_z = urhk_dbSelectWithBind(sv_a)
        print(lv_z)
        IF(lv_z==0) THEN
        #{
                EQOD.GLBDATA.chrge_off_flg   = BANCS.OUTPARAM.chrge_off_flg
                print(EQOD.GLBDATA.chrge_off_flg)
        ELSE
                EQOD.GLBDATA.chrge_off_flg   = "N"
        #}
        endif

        IF(EQOD.GLBDATA.chrge_off_flg == "Y")THEN
        #{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Account is Charged Off. Use HTARACO Menu^refAmt"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
        #}
        ENDIF

	if(EQOD.GLBDATA.odschmCode=="OD548")then 
	#{
		callscriptifexist("ODSME_collected.scr")
		exitscript
	#}
	endif  
#----------------------------------------------------------------------------------->OD548 collection update ends by silvester
#Amount Format
        BANCS.INPUT.FinAmt = ltrim(EQOD.GLBDATA.refAmt, ' ')
        sv_t = getposition(BANCS.INPUT.FinAmt, ',')
        if(sv_t != 0) then
                sv_l = mid$(BANCS.INPUT.FinAmt,sv_t,strlen(BANCS.INPUT.FinAmt)-sv_t)
                if (CDOUBLE(sv_l) == 0 ) then
                        EQOD.GLBDATA.refAmt  = mid$(BANCS.INPUT.FinAmt,0,sv_t - 1)
                        print(EQOD.GLBDATA.refAmt)
                else
                        EQOD.GLBDATA.refAmt  = mid$(BANCS.INPUT.FinAmt,0,sv_t - 1) + "" + mid$(BANCS.INPUT.FinAmt,sv_t,strlen(BANCS.INPUT.FinAmt)-sv_t)
                        print(EQOD.GLBDATA.refAmt)
                endif
        else
                EQOD.GLBDATA.refAmt  = BANCS.INPUT.FinAmt
                print(EQOD.GLBDATA.refAmt)
        endif
	IF((EQOD.GLBDATA.funcCode=="R") and (EQOD.GLBDATA.refAmt == "")) then
	#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Amount Cannot Be null for Partial Payment^refAmt"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
	#}
	ENDIF
        if(cdouble(EQOD.GLBDATA.refAmt)<0)then
        #{
                        BANCS.STDIN.msg = "Error_1|Error.1 ^Negative Amount Not Allowed^refAmt"
                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                        sv_z = "SuccessOrFailure|N"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
        #}
        endif
#both loan and operative account validation
	if((EQOD.GLBDATA.funcCode=="P")or(EQOD.GLBDATA.funcCode=="R"))then
	#{
		if(EQOD.GLBDATA.OperaccNum=="")then
		#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account^OperaccNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		#}
		else
		#{
			sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.OperaccNum)
			if(sv_u ==0)then
			#{
				EQOD.GLBDATA.opglSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
				EQOD.GLBDATA.opacid		= BANCS.OUTPARAM.acid
				print(EQOD.GLBDATA.opacid)
				EQOD.GLBDATA.opsolId     =       BANCS.OUTPARAM.acctSolId
				EQOD.GLBDATA.opschmType  =       BANCS.OUTPARAM.schmType
				EQOD.GLBDATA.opschmCode  =       BANCS.OUTPARAM.schmCode
				EQOD.GLBDATA.opcrncyCode =       BANCS.OUTPARAM.acctCrncyCode
				EQOD.GLBDATA.opacctClsFlg        =       BANCS.OUTPARAM.acctCloseflg
				EQOD.GLBDATA.opclearBalance      = BANCS.OUTPARAM.clearBalance
				EQOD.GLBDATA.opEffAmt = BANCS.OUTPARAM.EffAvailableAmt 
				EQOD.GLBDATA.opcustid = BANCS.OUTPARAM.custId 
				if((EQOD.GLBDATA.opschmType=="SBA")or(EQOD.GLBDATA.opschmType=="CAA")or(EQOD.GLBDATA.opschmType=="CCA"))then
				#{
					print("valid oper account")
				#}
				else
				#{
					BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account Scheme Not Allowed^OperaccNum"
					sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
					sv_z = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_z)
					exitscript
				#}
				endif
				if((EQOD.GLBDATA.opschmCode=="VA300")or(EQOD.GLBDATA.opschmCode=="SB113")or(EQOD.GLBDATA.opschmCode=="SB114")or(EQOD.GLBDATA.opschmCode=="SB101"))then
				#{	
					BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account Scheme Not Allowed^OperaccNum"
					sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
					sv_z = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_z)
					exitscript
				#}
				endif
				if((EQOD.GLBDATA.opacctClsFlg!="")and(EQOD.GLBDATA.opacctClsFlg!="N"))then
				#{
					BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account!Closed Account^OperaccNum"
					sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
					sv_z = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_z)
					exitscript
				#}
				endif
				if(cdouble(EQOD.GLBDATA.opEffAmt)<=0)then
				#{
					BANCS.STDIN.msg = "Error_1|Error.1 ^Insufficient Fund^OperaccNum"
					sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
					sv_z = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_z)
					exitscript
				#}
				endif
			#}
			else
			#{
				BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account^OperaccNum"
				sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
				sv_z = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_z)
				exitscript
			#}
			endif
		#}
		endif
		if(EQOD.GLBDATA.accNum=="")then
		#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Loan Account^accNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		#}
		else
		#{
			sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.accNum)
		        
			print(EQOD.GLBDATA.accNum)	
			if(sv_u ==0)then
			#{
				EQOD.GLBDATA.glSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
				EQOD.GLBDATA.acid		= BANCS.OUTPARAM.acid
				EQOD.GLBDATA.solId     =       BANCS.OUTPARAM.acctSolId
				EQOD.GLBDATA.schmType  =       BANCS.OUTPARAM.schmType
				EQOD.GLBDATA.schmCode  =       BANCS.OUTPARAM.schmCode
				EQOD.GLBDATA.crncyCode =       BANCS.OUTPARAM.acctCrncyCode
				EQOD.GLBDATA.acctClsFlg        =       BANCS.OUTPARAM.acctCloseflg
				EQOD.GLBDATA.laclearBalance      = BANCS.OUTPARAM.clearBalance
				EQOD.GLBDATA.laEffAmt = BANCS.OUTPARAM.EffAvailableAmt 
				EQOD.GLBDATA.lacustid = BANCS.OUTPARAM.custId 
					EQOD.GLBDATA.mdrsanLim = BANCS.OUTPARAM.sanctionLimit
                                        EQOD.GLBDATA.mdrdrawingPower = BANCS.OUTPARAM.drawingPower
                                        EQOD.GLBDATA.mdravalAmt = BANCS.OUTPARAM.AvailableAmt
                                        EQOD.GLBDATA.mdrlienamt = BANCS.OUTPARAM.lienAmt
				print(EQOD.GLBDATA.laclearBalance)
				print(EQOD.GLBDATA.laEffAmt)
				print(EQOD.GLBDATA.mdrsanLim)
				print(EQOD.GLBDATA.mdrdrawingPower)
				print(EQOD.GLBDATA.mdravalAmt)
				print(EQOD.GLBDATA.mdrlienamt)
				print(EQOD.GLBDATA.acid)
				if(cdouble(EQOD.GLBDATA.refAmt)==cdouble("0"))then
					EQOD.GLBDATA.refAmt = cdouble(EQOD.GLBDATA.laclearBalance)
				endif
				if(cdouble(EQOD.GLBDATA.refAmt)<0)then
					EQOD.GLBDATA.refAmt = -1 * cdouble(EQOD.GLBDATA.refAmt)
				endif
				if((EQOD.GLBDATA.schmCode=="OD541") or (EQOD.GLBDATA.schmCode=="OD542")or(EQOD.GLBDATA.schmCode=="OD543")or(EQOD.GLBDATA.schmCode=="OD544")or(EQOD.GLBDATA.schmCode=="OD545")or(EQOD.GLBDATA.schmCode=="OD546")or(EQOD.GLBDATA.schmCode=="OD550")or(EQOD.GLBDATA.schmCode=="OD549") or(EQOD.GLBDATA.schmCode=="ML001")or(EQOD.GLBDATA.schmCode=="DL002")or(EQOD.GLBDATA.schmCode=="OD552") or(EQOD.GLBDATA.schmCode=="TBL00")or(EQOD.GLBDATA.schmCode=="OD112"))then
				#{
					EQOD.GLBDATA.isrecovYN = "Y"
				#}
				else
				#{
					BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Loan Account^accNum"
					sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
					sv_z = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_z)
					exitscript
				#}
				endif
			#}
			else
			#{
				BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Loan Account^accNum"
				sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
				sv_z = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_z)
				exitscript
			#}
			endif
		#}
		endif
	#}
	endif
#cif validation
        print(EQOD.GLBDATA.lacustid)
        print(EQOD.GLBDATA.opcustid)
        if(EQOD.GLBDATA.lacustid!=EQOD.GLBDATA.opcustid)then
        #{
                BANCS.STDIN.msg = "Error_1|Error.1 ^CifId Mismatch Recovery Not Allowed^accNum"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
        #}
        endif
#due amount validation
	print(EQOD.GLBDATA.laclearBalance)
	print(EQOD.GLBDATA.laEffAmt)
	if(cdouble(EQOD.GLBDATA.laEffAmt)>=0)then
	#{
		##BANCS.STDIN.msg = "Error_1|Error.1 ^No due for the Loan^accNum"
		##sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		##sv_z = "SuccessOrFailure|N"
		##sv_u = urhk_SetOrbOut(sv_z)
		##exitscript
	#}
	endif
	if(cdouble(EQOD.GLBDATA.laclearBalance)>=0)then
	#{
		BANCS.STDIN.msg = "Error_1|Error.1 ^No due for the Loan^accNum"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	#}
	endif
	
	print(EQOD.GLBDATA.accNum)
	print(EQOD.GLBDATA.OperaccNum)
	print(EQOD.GLBDATA.refCrncy)
	print(EQOD.GLBDATA.refAmt)
	print(EQOD.GLBDATA.funcCode)
	print(EQOD.GLBDATA.reshDate)
	
	if((EQOD.GLBDATA.schmCode =="DL002") or (EQOD.GLBDATA.schmCode == "OD552") or (EQOD.GLBDATA.schmCode == "OD549"))then
	#{
		 print(EQOD.GLBDATA.funcCode)
		 print(EQOD.GLBDATA.refAmt)
			EQOD.GLBDATA.lllaclearBalance = -1*cdouble(EQOD.GLBDATA.laclearBalance)
		 print(EQOD.GLBDATA.laclearBalance)
		if((cdouble(EQOD.GLBDATA.lllaclearBalance ) < cdouble(EQOD.GLBDATA.refAmt)) and (EQOD.GLBDATA.funcCode =="R"))then
					BANCS.STDIN.msg = "Error_1|Error.1 ^Partial Payment amount is Greater than Loan balance. Use Payoff Instead^OperaccNum"
					sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
					sv_z = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_z)
					exitscript
		endif
		IF((EQOD.GLBDATA.schmCode =="OD549") and ((BANCS.STDIN.contextBankId =="56") OR (BANCS.STDIN.contextBankId =="43") OR (BANCS.STDIN.contextBankId =="54")))then
		 callscriptifexist("EcoSysCODLPayLienRec.scr")
		else
		 callscriptifexist("vpDlCODLPayLienRec.scr")
		ENDIF
		 IF(BANCS.OUTPUT.successOrFailure=="F") THEN
			exitscript
		 ENDIF
		 sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
                                EQOD.GLBDATA.msg = "Loan Payment Initiated Successfully. Please Visit HPR Menu in While"
                                sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
                                print(sv_c)

		exitscript
	#}
	endif	
#Agent Float Recovery
        if(EQOD.GLBDATA.schmCode=="OD541")then
        #{
                callscriptifexist("vpcodlpayAgentFloat.scr")
                exitscript
        #}
        endif
#Ecosystem/Merchant Loan Recovery
        if((EQOD.GLBDATA.schmCode=="OD549")or(EQOD.GLBDATA.schmCode=="ML001") or(EQOD.GLBDATA.schmCode=="DL001")or(EQOD.GLBDATA.schmCode=="TBL00"))then
        #{
                callscriptifexist("vpcodlpayEcoMerloan.scr")
                exitscript
        #}
        endif
#Oper avail amount validation
	if(cdouble(EQOD.GLBDATA.opEffAmt)<cdouble(EQOD.GLBDATA.refAmt))then
	#{
		BANCS.STDIN.msg = "Error_1|Error.1 ^Recovery amount is more than available amount^refAmt"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	#}
	endif
	if(EQOD.GLBDATA.isrecovYN=="Y")then
	#{
		sv_q = urhk_B2k_ForacidToAcid(EQOD.GLBDATA.accNum)
		if(sv_q==0)then
		#{
			EQOD.GLBDATA.LoanAcid = BANCS.OUTPARAM.Acid
		#}
		else
		#{
			EQOD.GLBDATA.LoanAcid = ""
		#}
		endif
		
		  if((EQOD.GLBDATA.schmCode=="DL002")or(EQOD.GLBDATA.schmCode=="OD552"))then
                lv_d = " dmdCnt | select count(*) from custom.dlla_dmd_tbl where bank_id=?SVAR "
                else
                lv_d = " dmdCnt | select count(*) from custom.odla_dmd_tbl where bank_id=?SVAR "
                endif

		lv_d = lv_d + " and od_acid = ?SVAR "
		lv_d = lv_d + " and dmd_amt-tot_adj_amt <> 0 "
		lv_d = lv_d + " and entity_cre_flg='Y' and del_flg='N' "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQOD.GLBDATA.LoanAcid 
		print(BANCS.INPARAM.BINDVARS)
		print(lv_d)
		lv_s = urhk_dbSelectWithBind(lv_d)
		if(lv_s==0)then
		#{
			EQOD.GLBDATA.dmdCnt = BANCS.OUTPARAM.dmdCnt
		#}
		else
		#{
			EQOD.GLBDATA.dmdCnt = "0"
		#}
		endif
		if((cdouble(EQOD.GLBDATA.dmdCnt)<=0)and(cdouble(EQOD.GLBDATA.laclearBalance)>=0))then
		#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Loan Recovery not allowed ! No Active demamds for the account^accNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		#}
		endif
		
                sv_u = urhk_getFileLocation("COM|vpcodlpay.com")
                print(sv_u)
                print(BANCS.OUTPARAM.fileLocation)
                if(sv_u == 0)then
                #{
                        sv_a = "LoanAcctId|" + EQOD.GLBDATA.accNum
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "OperAcctNum|" + EQOD.GLBDATA.OperaccNum
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "RecoverAmt|" + EQOD.GLBDATA.refAmt
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "FunctionC|" + EQOD.GLBDATA.funcCode
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "stuserId|" + BANCS.STDIN.userId
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "bankId|" + BANCS.STDIN.contextBankId
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "EventType|ONSPAY"
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        BANCS.INPARAM.scriptName = "vpcodlpay.com"
                        BANCS.INPARAM.arguments = ""
                        sv_u = urhk_CallShellScript("b")
                        print(sv_u)
                        if(sv_u != 0)then
                        #{
                                print("failed")
                        #}
                        else
                        #{
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
                                EQOD.GLBDATA.msg = "Loan Payment Initiated Successfully. Please Visit HPR Menu in While"
                                sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
                                print(sv_c)
                                exitscript
                        #}
                        endif
                #}
                endif
        #}
        endif

trace off
end-->
