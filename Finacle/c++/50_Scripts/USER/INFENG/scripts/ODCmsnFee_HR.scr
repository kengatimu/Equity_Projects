#-----------------------------------------------------------------------------------------------
<--start
trace on
    if(repexists("ODACCT")==0)then
            createrep("ODACCT")
    endif
    if(classexists("ODACCT","GLBDATA")==0)then
            createclass("ODACCT","GLBDATA",5)
    endif
    
    #---Variables init

    ODACCT.GLBDATA.insurancePrcnt = "0.700000"
    ODACCT.GLBDATA.vatPrcnt = "18.000000"
    BANCS.OUTPUT.successOrFailure="S"

    IF (FIELDEXISTS(ODACCT.GLBDATA.DrActNum) == 1) THEN
    #{
        IF(ODACCT.GLBDATA.DrActNum != "")THEN
        #{
            ODACCT.GLBDATA.DrActNum = ODACCT.GLBDATA.DrActNum
            PRINT(ODACCT.GLBDATA.DrActNum)
        ELSE
            BANCS.OUTPUT.successOrFailure="F"
            exitscript
        #}
        ENDIF
    ELSE
        BANCS.OUTPUT.successOrFailure="F"
        exitscript
    #}
    ENDIF


    IF (FIELDEXISTS(ODACCT.GLBDATA.sanctionLimit) == 1) THEN
    #{
        IF(ODACCT.GLBDATA.sanctionLimit != "")THEN
        #{
            ODACCT.GLBDATA.sanctionLimit = ODACCT.GLBDATA.sanctionLimit
            PRINT(ODACCT.GLBDATA.sanctionLimit)
        ELSE
            BANCS.OUTPUT.successOrFailure="F"
            exitscript
        #}
        ENDIF
    ELSE
        BANCS.OUTPUT.successOrFailure="F"
        exitscript
    #}
    ENDIF

    IF (FIELDEXISTS(ODACCT.GLBDATA.feePrcnt) == 1) THEN
    #{
        IF(ODACCT.GLBDATA.feePrcnt != "")THEN
        #{
            ODACCT.GLBDATA.feePrcnt = ODACCT.GLBDATA.feePrcnt
            PRINT(ODACCT.GLBDATA.feePrcnt)
        ELSE
            BANCS.OUTPUT.successOrFailure="F"
            exitscript
        #}
        ENDIF
    ELSE
        BANCS.OUTPUT.successOrFailure="F"
        exitscript
    #}
    ENDIF

    IF (FIELDEXISTS(ODACCT.GLBDATA.eventId) == 1) THEN
    #{
        IF(ODACCT.GLBDATA.eventId != "")THEN
        #{
            ODACCT.GLBDATA.eventId = ODACCT.GLBDATA.eventId
            PRINT(ODACCT.GLBDATA.eventId)
        ELSE
            ODACCT.GLBDATA.eventId =""
            BANCS.OUTPUT.successOrFailure="F"
            exitscript
        #}
        ENDIF
    ELSE
        BANCS.OUTPUT.successOrFailure="F"
        exitscript
    #}
    ENDIF

    ODACCT.GLBDATA.drAmt = ODACCT.GLBDATA.sanctionLimit
    print(ODACCT.GLBDATA.drAmt)

    sv_c =  GETPOSITION(ODACCT.GLBDATA.drAmt, "|") - 1
    print(sv_c)
    sv_b = MID$(ODACCT.GLBDATA.drAmt,0,sv_c)
    print(sv_b)
    ODACCT.GLBDATA.drAmt = sv_b

    #-- Calculate LACEINCOME

    ODACCT.GLBDATA.laceAmt = cdouble(ODACCT.GLBDATA.drAmt) * (cdouble(ODACCT.GLBDATA.feePrcnt) / 100)
    print(ODACCT.GLBDATA.laceAmt)

    #-- Calculate VAT

    ODACCT.GLBDATA.vatAmt = cdouble(ODACCT.GLBDATA.laceAmt) * (cdouble(ODACCT.GLBDATA.vatPrcnt) / 100)
    print(ODACCT.GLBDATA.vatAmt)

     #-- Calculate INSURANCE

    ODACCT.GLBDATA.insuranceAmt = cdouble(ODACCT.GLBDATA.drAmt) * (cdouble(ODACCT.GLBDATA.insurancePrcnt) / 100)
    print(ODACCT.GLBDATA.insuranceAmt)

    sv_u = urhk_getAcctDetailsInRepository(ODACCT.GLBDATA.DrActNum)
    print(sv_u)

    if(sv_u == 0)then
        ODACCT.GLBDATA.sol_id = BANCS.OUTPARAM.acctSolId
        print(ODACCT.GLBDATA.sol_id)
    else
        ODACCT.GLBDATA.sol_id = ""
        BANCS.OUTPUT.successOrFailure="F"
        exitscript
    endif

    if(ODACCT.GLBDATA.eventId == "LIMODL")then
        ODACCT.GLBDATA.sol_id = "4000" #No replication of a/c
        sv_a = "LACEINCOM|"+BANCS.STDIN.homeCrncyCode+"|"+ ODACCT.GLBDATA.sol_id
        print (sv_a)
    else
        sv_a = ""
    endif

    sv_r = urhk_B2k_BacidToAcctId(sv_a)
    print(sv_r)
    if(sv_r ==0)then
        print (BANCS.OUTPARAM.AcctId)
        ODACCT.GLBDATA.CrActNum = BANCS.OUTPARAM.AcctId
        print (ODACCT.GLBDATA.CrActNum)
    else
        ODACCT.GLBDATA.CrActNum = ""
        print (ODACCT.GLBDATA.CrActNum)
        BANCS.OUTPUT.successOrFailure="F"
        exitscript
    endif

    #mtt
    sv_r = urhk_MTTS_Close("")
    print(sv_r)

    BANCS.INPARAM.PostTranFlg               = "Y"
    BANCS.INPARAM.CommitFlg                 = "Y"
    BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
    BANCS.INPARAM.ValidationFlag            = "Y"
    BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
    BANCS.INPARAM.ErrorCheckForLuw          = "Y"
    BANCS.INPARAM.CheckExceptions           = "N"

    sv_u = urhk_MTTS_Initialize("")
    print(sv_u)

    if(sv_u !=0)then
        GOTO ERRORHANDLER
    endif

    sv_r = repexists("MTT")
    if(sv_r == 0)then
        createrep("MTT")
    endif
    sv_r = classexists("MTT","TranDetails")
    if(sv_r == 0)then
        createclass("MTT","TranDetails",5)
    endif

    MTT.TranDetails.TranDate="0"
    MTT.TranDetails.TranType = "T"
    MTT.TranDetails.TranSubType = "BI"
    MTT.TranDetails.IgnoreExcp = "I"
    MTT.TranDetails.Consolidate = "N"
    MTT.TranDetails.Remarks = ""
    MTT.TranDetails.ValidationFlag = "N"
    MTT.TranDetails.PostTranFlg = "Y"
    MTT.TranDetails.CheckExceptions = "N"
    MTT.TranDetails.PostFlag        = "Y"
    MTT.TranDetails.CommitFlg       = "Y"


    #--FEE 0NE

    sv_u = urhk_MTTS_DefineTransaction("ODCmsn")
    print(sv_u)
    if(sv_u != 0 ) then
        GOTO ERRORHANDLER
    endif

    MTT.PartTranDetails.Account = ODACCT.GLBDATA.DrActNum
    MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.ValueDate   =  "0"
    ODACCT.GLBDATA.drPart = "fees"
    MTT.PartTranDetails.Particulars =  ODACCT.GLBDATA.drPart
    MTT.PartTranDetails.RefAmount = -1*cdouble(ODACCT.GLBDATA.laceAmt)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "Dr"
    MTT.PartTranDetails.RefNum = ODACCT.GLBDATA.DrActNum
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = "ODCmsn"
    print(MTT.PartTranDetails.TranIdentifier)
    MTT.PartTranDetails.PstFlg = "Y"
    sv_r = urhk_MTTS_definePartTran("laceDr")
    print(sv_r)

    if (sv_r != 0) then
        GOTO ERRORHANDLER
    endif

    MTT.PartTranDetails.Account = ODACCT.GLBDATA.CrActNum
    MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.ValueDate     =  "0"

    ODACCT.GLBDATA.drPart = "fees"
    MTT.PartTranDetails.Refnum = ODACCT.GLBDATA.CrActNum

    MTT.PartTranDetails.Particulars = ODACCT.GLBDATA.drPart
    MTT.PartTranDetails.RefAmount = 1*cdouble(ODACCT.GLBDATA.laceAmt)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "Cr"
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = "ODCmsn"
    MTT.PartTranDetails.PstFlg = "Y"
    sv_r = urhk_MTTS_definePartTran("laceCr")
    print(sv_r)

    if (sv_r != 0) then
        GOTO ERRORHANDLER
    endif


    #--FEE TWO - VAT

    MTT.PartTranDetails.Account = ODACCT.GLBDATA.DrActNum
    MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.ValueDate   =  "0"
    ODACCT.GLBDATA.drPart = "VAT"
    MTT.PartTranDetails.Particulars =  ODACCT.GLBDATA.drPart
    MTT.PartTranDetails.RefAmount = -1*cdouble(ODACCT.GLBDATA.vatAmt)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "Dr"
    MTT.PartTranDetails.RefNum = ODACCT.GLBDATA.DrActNum
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = "ODCmsn"
    print(MTT.PartTranDetails.TranIdentifier)
    MTT.PartTranDetails.PstFlg = "Y"
    sv_r = urhk_MTTS_definePartTran("vatDr")
    print(sv_r)

    if (sv_r != 0) then
        GOTO ERRORHANDLER
    endif

    MTT.PartTranDetails.Account = ODACCT.GLBDATA.CrActNum
    MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.ValueDate     =  "0"

    ODACCT.GLBDATA.drPart = "VAT"
    MTT.PartTranDetails.Refnum = ODACCT.GLBDATA.CrActNum

    MTT.PartTranDetails.Particulars = ODACCT.GLBDATA.drPart
    MTT.PartTranDetails.RefAmount = 1*cdouble(ODACCT.GLBDATA.vatAmt)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "Cr"
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = "ODCmsn"
    MTT.PartTranDetails.PstFlg = "Y"
    sv_r = urhk_MTTS_definePartTran("vatCr")
    print(sv_r)

    if (sv_r != 0) then
        GOTO ERRORHANDLER
    endif

    #--FEE THREE - INSURANCE

    MTT.PartTranDetails.Account = ODACCT.GLBDATA.DrActNum
    MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.ValueDate   =  "0"
    ODACCT.GLBDATA.drPart = "credit life insurance"
    MTT.PartTranDetails.Particulars =  ODACCT.GLBDATA.drPart
    MTT.PartTranDetails.RefAmount = -1*cdouble(ODACCT.GLBDATA.insuranceAmt)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "Dr"
    MTT.PartTranDetails.RefNum = ODACCT.GLBDATA.DrActNum
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = "ODCmsn"
    print(MTT.PartTranDetails.TranIdentifier)
    MTT.PartTranDetails.PstFlg = "Y"

    sv_r = urhk_MTTS_definePartTran("insDr")
    print(sv_r)

    if (sv_r != 0) then
        GOTO ERRORHANDLER
    endif

    MTT.PartTranDetails.Account = ODACCT.GLBDATA.CrActNum
    MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.ValueDate     =  "0"

    ODACCT.GLBDATA.drPart = "credit life insurance"
    MTT.PartTranDetails.Refnum = ODACCT.GLBDATA.CrActNum

    MTT.PartTranDetails.Particulars = ODACCT.GLBDATA.drPart
    MTT.PartTranDetails.RefAmount = 1*cdouble(ODACCT.GLBDATA.insuranceAmt)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "Cr"
    #MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = "ODCmsn"
    MTT.PartTranDetails.PstFlg = "Y"
    sv_r = urhk_MTTS_definePartTran("insCr")
    print(sv_r)

    if (sv_r != 0) then
        GOTO ERRORHANDLER
    endif

    sv_u = urhk_MTTS_EndDefinition("")
    print(sv_u)

    if(sv_u != 0)then
    #{
        GOTO ERRORHANDLER
    else
        IF(fieldexists(BANCS.OUTPARAM.MTTTranId)) THEN
        #{
            print(BANCS.OUTPARAM.MTTTranId)
            ODACCT.GLBDATA.TranId = BANCS.OUTPARAM.MTTTranId
            BANCS.OUTPUT.successOrFailure="S"
            ODACCT.GLBDATA.chargeTranId = ODACCT.GLBDATA.TranId
            ODACCT.GLBDATA.chargeTranDate = BANCS.STDIN.BODDate

            sv_r = urhk_MTTS_Close("")
            print(sv_r)
            exitscript
        else
            GOTO ERRORHANDLER
        #}
        ENDIF
    #}
    endif

    print(MTT.XCPN.NumExceptions)
    print(MTT.XCPN.NumWarnings)

    if((MTT.XCPN.NumExceptions >= 1) or (MTT.XCPN.NumWarnings >= 1)) then
        sv_u = urhk_MTTS_HandleExceptions("POST")
        print("exceptions")
        if (sv_u != 0) then
            sv_r = urhk_MTTS_ReportErrorCondition("")
            print (MTT.Error.Description)
            GOTO ERRORHANDLER
        endif
    else
        sv_u = urhk_MTTS_HandleExceptions("POST")
        print("No exceptions")
        if (sv_u != 0) then
            sv_r = urhk_MTTS_ReportErrorCondition("")
            print (MTT.Error.Description)
            GOTO ERRORHANDLER
        endif
    endif

    #sv_r = urhk_MTTS_Close("")
    #print(sv_r)
    

    ERRORHANDLER:
        IF(fieldexists(MTT.Error.Description)==1) THEN
        #{
            print(MTT.Error.Description)
            ODACCT.GLBDATA.MTTErrDesc = MTT.Error.Description
            BANCS.OUTPUT.successOrFailure="F"
            ODACCT.GLBDATA.chargeTranId = ""
            ODACCT.GLBDATA.chargeTranDate = BANCS.STDIN.BODDate

            sv_r = urhk_MTTS_Close("")
            print(sv_r)
            exitscript
        else
            print("Error occurred")
            BANCS.OUTPUT.successOrFailure="F"
            sv_r = urhk_MTTS_Close("")
            print(sv_r)
            exitscript
        #}
        ENDIF


trace off
end-->

