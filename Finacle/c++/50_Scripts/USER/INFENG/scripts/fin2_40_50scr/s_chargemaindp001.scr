#------------------------------------------------------------------------------------------------    
#   Name			: s_chargemaindp001.scr
#   Description		:
#   Date			: 17-03-2013
#   Author			:
#   Input			: NA
#   Output			: NA
#   Called Script	:
#   Calling Script	: getcparamvalue.scr
#   Menu Option		:
#	Srl. No         Date            Author          	Description.
#	-------         ------          ------          	------------
#   1.0             17-03-2013      					Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="44bf6c3e682f3329788367a201a916847a4e15a4fff8aed92ba2c0edf521b556"
	TRACE ON
	
	
	sv_a = REPEXISTS("COLL")
	IF (sv_a == 0) THEN
	#{
		CREATEREP("COLL")
	#}
	ENDIF
	
	sv_a = CLASSEXISTS("COLL", "GLBDATA")
	IF (sv_a == 0) THEN
	#{
		CREATECLASS("COLL", "GLBDATA", 5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","TMCHRG") == 0) THEN
	#{
		CREATECLASS("CUST","TMCHRG",5)
	#}
	ENDIF
	
	sv_a = REPEXISTS("CASH")
	IF (sv_a == 0) THEN
	#{
		CREATEREP("CASH")
	#}
	ENDIF
	
	sv_a = CLASSEXISTS("CASH","WITH")
	IF (sv_a == 0) THEN
	#{
		CREATECLASS("CASH","WITH",5)
	#}
	ENDIF
	
	#-----------------------------------------------------------
	#Initializing required variables
	#----------------------------------------------------------
	CUST.TMCHRG.errMsg = ""
	CUST.TMCHRG.stepVal = "2"
	CALL("cparamsetup.scr")
	
	#----------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		COLL.GLBDATA.tran_type = BANCS.OUTPARAM.srvValue
		PRINT(COLL.GLBDATA.tran_type)
		#}
	ELSE
		#{
		CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for tran type"
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		COLL.GLBDATA.sub_type = BANCS.OUTPARAM.srvValue
		PRINT(COLL.GLBDATA.sub_type)
		#}
	ELSE
		#{
		CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for part tran type"
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		COLL.GLBDATA.noOfRecords = BANCS.OUTPARAM.srvValue
		PRINT(COLL.GLBDATA.noOfRecords)
		#}
	ELSE
		#{
		CUST.TMCHRG.errMsg = "Error:urhk_SRV_NumOfRecs failed"
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_m = 0
	sv_a = "\n"
	sv_l = 0
	PRINT(sv_l)
	WHILE(sv_l < COLL.GLBDATA.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		#-------------------------------------------------------------------------------------------
		# Fetch serial num
		#-------------------------------------------------------------------------------------------
		
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			COLL.GLBDATA.serialnum = BANCS.OUTPARAM.srvValue
			PRINT(COLL.GLBDATA.serialnum)
			#}
		ELSE
			#{
			CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for serialnum"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch A/c - foracid
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			COLL.GLBDATA.account = BANCS.OUTPARAM.srvValue
			PRINT(COLL.GLBDATA.account)
			#}
		ELSE
			#{
			CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for Account Number"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch PartTranType
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			COLL.GLBDATA.partTrantype = BANCS.OUTPARAM.srvValue
			PRINT(COLL.GLBDATA.partTrantype)
			#}
		ELSE
			#{
			CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for PartTranType"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Tran Amount
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".tranAmt")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			COLL.GLBDATA.tran_amt = BANCS.OUTPARAM.srvValue
			PRINT(COLL.GLBDATA.tran_amt)
			#}
		ELSE
			#{
			CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for Ref Amount"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch instrmnt type
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".instrmnt.instrmntType")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			COLL.GLBDATA.instrmnt = BANCS.OUTPARAM.srvValue
			PRINT(COLL.GLBDATA.instrmnt)
			#}
		ELSE
			#{
			CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for Ref Amount"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch instrmnt num
		#-------------------------------------------------------------------------------------------
		
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".instrmnt.instrmntNum")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			COLL.GLBDATA.instrmntNum = BANCS.OUTPARAM.srvValue
			PRINT(COLL.GLBDATA.instrmntNum)
			#}
		ELSE
			#{
			CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for Ref Amount"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch instrmnt date
		#-------------------------------------------------------------------------------------------
		
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".instrmnt.instrmntDate")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			COLL.GLBDATA.instrmntDate = BANCS.OUTPARAM.srvValue
			PRINT(COLL.GLBDATA.instrmntDate)
			#}
		ELSE
			#{
			CUST.TMCHRG.errMsg = "Error: urhk_SRV_GetVal failed for Ref Amount"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ((COLL.GLBDATA.tran_type == "T") AND (COLL.GLBDATA.partTrantype == "C")) THEN
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		IF (COLL.GLBDATA.sub_type == "NR") THEN
		#{
			#sv_a = urhk_TBAF_ChangeFieldValue("datablk.prnt_advc_ind|O")
			#PRINT(sv_a)
			GOTO NEXTREC
		#}
		ENDIF
		
		IF (((COLL.GLBDATA.sub_type == "CR") AND (COLL.GLBDATA.partTrantype == "D")) OR ((COLL.GLBDATA.sub_type == "CP") AND (COLL.GLBDATA.partTrantype == "D")))  THEN
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		IF ((COLL.GLBDATA.account == "") OR (COLL.GLBDATA.tran_amt == "") OR (COLL.GLBDATA.partTrantype == "")) THEN
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		
		IF (COLL.GLBDATA.instrmnt != "") THEN
		#{
			IF ((COLL.GLBDATA.instrmntNum == "") OR (COLL.GLBDATA.instrmntDate == "")) THEN
			#{
				GOTO NEXTREC
			#}
			ENDIF
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Code from collect.scr script
		#-------------------------------------------------------------------------------------------
		CUST.TMCHRG.stepVal = "2"
		CALL("cparamsetup.scr")
		#-----Stop Reversal on DSTV account from other Sol
		IF (COLL.GLBDATA.account == CUST.CPARAM.acctNum2) THEN
		#{
			IF (COLL.GLBDATA.partTrantype == "D") THEN
			#{
				print(BANCS.STDIN.homeSolId)
				IF (BANCS.STDIN.homeSolId != CUST.CPARAM.homeSolId1) THEN
				#{
					print("not equity center branch")
					sv_m = sv_m + 1
					sv_u = urhk_SRV_SetErr("Reversal ON this account is not allowed, Contact Equity Center Branch " + " ,for PartTransrlnum " + COLL.GLBDATA.parttrnNum)
					GOTO NEXTREC
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		#----Inclusion for Safaricom Dealership
		IF (COLL.GLBDATA.account == CUST.CPARAM.acctNum27) THEN
		#{
			COLL.GLBDATA.Product = "DEALERSHIP"
			IF (COLL.GLBDATA.Product == "DEALERSHIP") THEN
			#{
				IF (COLL.GLBDATA.partTrantype == "D") THEN
				#{
					IF (BANCS.STDIN.homeSolId != CUST.CPARAM.homeSolId1) THEN
					#{
						print("not equity center branch")
						sv_m = sv_m + 1
						sv_u = urhk_SRV_SetErr("Reversal ON this account is not allowed, Contact Equity Center Branch " + " ,for PartTransrlnum " + COLL.GLBDATA.parttrnNum)
						GOTO NEXTREC
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		#----Inclusion for Shares Investments ---IPOS
		
		#*************** start safcom laptop account *******************
		IF ((COLL.GLBDATA.account == CUST.CPARAM.acctNum28) AND (COLL.GLBDATA.partTrantype == "D")) THEN
		#{
			IF (BANCS.STDIN.homeSolId != CUST.CPARAM.homeSolId1) THEN
			#{
				print ("not equity center branch")
				sv_m = sv_m + 1
				sv_u = urhk_SRV_SetErr("Reversal ON this account is not allowed, Contact Equity Center Branch " + " ,for PartTransrlnum " + COLL.GLBDATA.parttrnNum)
				GOTO NEXTREC
			#}
			ENDIF
		#}
		ENDIF
		
		### BILLERS START ###
		#----Inclusion for Billers
		sv_s = "countbiller|"
		sv_s = sv_s + "SELECT collection_type FROM CUSTOM.EXTERNAL_SERVICES_ACCNT  "
		sv_s = sv_s + "WHERE foracid = ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = COLL.GLBDATA.account + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			COLL.GLBDATA.countbiller = BANCS.OUTPARAM.countbiller
			PRINT(COLL.GLBDATA.countbiller)
			IF (COLL.GLBDATA.countbiller == "BILL") THEN
			#{
				COLL.GLBDATA.countbiller = "Y"
				IF (COLL.GLBDATA.partTrantype == "D") THEN
				#{
					PRINT(BANCS.STDIN.homeSolId)
					IF (BANCS.STDIN.homeSolId != CUST.CPARAM.homeSolId2) THEN
					#{
						PRINT("not harambee branch")
						sv_m = sv_m + 1
						sv_u = urhk_SRV_SetErr("Reversal ON this account is not allowed, Contact Harambee Branch " + " ,for PartTransrlnum " + COLL.GLBDATA.parttrnNum)
						GOTO NEXTREC
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		### BILLERS END ###
		
		NEXTREC:
			sv_l = sv_l + 1
			PRINT(sv_l)
		#}
		DO
		
		PRINT(sv_m)
		IF (sv_m != "") THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
	ENDOFSCRIPT:
		IF (CUST.TMCHRG.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.TMCHRG.errMsg)
			GOTO NEXTREC
		#}
		ENDIF
		#TRACE OFF
		
		EXITSCRIPT
END-->
