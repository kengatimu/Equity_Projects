					lv_a = ""
					lv_a = lv_a + " update  custom.managment_fee_tbl "
					lv_a = lv_a + " set last_coll_date = to_date ('"+CUST.DATA.flow_date+"','DD-MM-YYYY'),"
					lv_a = lv_a + " flow_date =  to_date ('"+CUST.DATA.next_flow_date+"','DD-MM-YYYY') "
					lv_a = lv_a + " where bank_id = '"+BANCS.STDIN.contextBankId+"' "
					lv_a = lv_a + " and loan_foracid = '"+CUST.DATA.loan_foracid+"' "
					lv_a = lv_a + " and del_flg = 'N' "	

					print(lv_a)
					sv_a = urhk_dbSQLWithBind(lv_a)
