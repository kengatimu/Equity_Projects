		while( sv_z == 0)
		#{
			CUST.DATA.loan_foracid  = BANCS.OUTPARAM.loan_foracid
			CUST.DATA.loan_schm_code= BANCS.OUTPARAM.loan_schm_code
			CUST.DATA.loan_crncy_code= BANCS.OUTPARAM.loan_crncy_code
			CUST.DATA.op_foracid    = BANCS.OUTPARAM.op_foracid
			CUST.DATA.op_acid    	= BANCS.OUTPARAM.op_acid
			CUST.DATA.tot_comm 	= BANCS.OUTPARAM.tot_comm
			CUST.DATA.flow_date	= BANCS.OUTPARAM.flow_date
			CUST.DATA.next_flow_date= BANCS.OUTPARAM.next_flow_date

			print(CUST.DATA.loan_foracid)
			print(CUST.DATA.loan_schm_code)
			print(CUST.DATA.loan_crncy_code)
			print(CUST.DATA.op_foracid)
			print(CUST.DATA.op_acid)
			print(CUST.DATA.tot_comm)
			print(CUST.DATA.flow_date)
			print(CUST.DATA.next_flow_date)
			
			### checking the account should not charged before on the same day ######
			CUST.DATA.tran_particular = "MANAGEMENT-FEE-"+CUST.DATA.loan_foracid+"-"+CUST.DATA.flow_date	
			
			sv_s = ""
			sv_s = sv_s + " cnt |"
			sv_s = sv_s + " SELECT  count(*) "
			sv_s = sv_s + " FROM tbaadm.dtd "
			sv_s = sv_s + " where tran_date = to_Date(?SVAR,'DD-MM-YYYY') "
