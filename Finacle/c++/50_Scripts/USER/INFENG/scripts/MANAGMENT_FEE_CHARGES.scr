				print(CUST.DATA.cnt)
			#}
			ENDIF
			
			IF (CUST.DATA.cnt > 0) THEN
			#{
				GOTO nextrec
			#}
			ENDIF

			CUST.DATA.chargeTranId = ""	
					
			CUST.DATA.eventId = "MANAGEMENT-FEE-"+CUST.DATA.loan_schm_code
			CUST.DATA.eventId = "MANAGEMENT-FEE-MG592"
			CUST.DATA.acctCrncyCode = CUST.DATA.loan_crncy_code 
			CUST.DATA.TotalAmt = CUST.DATA.tot_comm +"|"+CUST.DATA.loan_crncy_code 
			print(CUST.DATA.TotalAmt)	
			CUST.DATA.Narration = "MANAGEMENT-FEE-"+CUST.DATA.loan_foracid+"-"+CUST.DATA.flow_date

                        CUST.DATA.tranType      = "T"
                        CUST.DATA.tranSubType   = "BI"
                        CUST.DATA.tranDate      = CUST.DATA.BODDate 
                        CUST.DATA.drAcctId      = CUST.DATA.op_foracid

			call("CogeChgCollgchrgRW.scr")
			
			if(fieldexists(CUST.DATA.chargeTranId)) then
			#{
			
				lv_a = ""
				lv_a = lv_a + "lien_b2k_id,system_calc_amt,actual_amt_coll,pending_chrg_amt|"
				lv_a = lv_a + " select "
				lv_a = lv_a + " (select lien_b2k_id from tbaadm.pclt p where p.bank_id = cxl.bank_id "
				lv_a = lv_a + " and p.cxl_srl_num = cxl.cxl_srl_num and  p.acid = cxl.target_acid  "
				lv_a = lv_a + " and p.pttm_event_type = cxl.event_type  and  p.pttm_event_id = cxl.event_id "
				lv_a = lv_a + "  ) lien_b2k_id, "
				lv_a = lv_a + " system_calc_amt,"
				lv_a = lv_a + " actual_amt_coll, "
				lv_a = lv_a + " pending_chrg_amt "
				lv_a = lv_a + " from tbaadm.cxl  "
				lv_a = lv_a + " where bank_id = '"+BANCS.STDIN.contextBankId+"' "
				lv_a = lv_a + " and event_type = 'GCHRG' "
				lv_a = lv_a + " and event_id = '"+CUST.DATA.eventId+"'"
				lv_a = lv_a + " and chrg_gl_date = to_date ('"+CUST.DATA.BODDate+"','DD-MM-YYYY') "
				lv_a = lv_a + " and target_acid  = '"+CUST.DATA.op_acid+"' "
				lv_a = lv_a + " and comp_b2kid= '"+CUST.DATA.gchSrlNum+"' "
				print(lv_a)

				sv_d=urhk_dbSelectWithBind(lv_a)
				print(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.DATA.lien_b2k_id		= BANCS.OUTPARAM.lien_b2k_id
					CUST.DATA.system_calc_amt	= BANCS.OUTPARAM.system_calc_amt
					CUST.DATA.actual_amt_coll	= BANCS.OUTPARAM.actual_amt_coll
					CUST.DATA.pending_chrg_amt	= BANCS.OUTPARAM.pending_chrg_amt
					print(CUST.DATA.lien_b2k_id)
					print(CUST.DATA.system_calc_amt)
					print(CUST.DATA.actual_amt_coll)
					print(CUST.DATA.pending_chrg_amt)
				ELSE
					CUST.DATA.lien_b2k_id           = ""
					CUST.DATA.system_calc_amt       = CDOUBLE("0")
					CUST.DATA.actual_amt_coll       = CDOUBLE("0") 
					CUST.DATA.pending_chrg_amt      = CDOUBLE("0") 
					print(CUST.DATA.lien_b2k_id)
					print(CUST.DATA.system_calc_amt)
					print(CUST.DATA.actual_amt_coll)
					print(CUST.DATA.pending_chrg_amt)
				#}
				ENDIF

				IF((CUST.DATA.lien_b2k_id == "") AND ( CUST.DATA.pending_chrg_amt == CDOUBLE("0")))THEN
				#{
					CUST.DATA.status ="Charges collected fully "+ CUST.DATA.actual_amt_coll
				#}
				ENDIF

				IF((CUST.DATA.lien_b2k_id != "") AND (CUST.DATA.system_calc_amt == CUST.DATA.pending_chrg_amt))THEN
				#{
					CUST.DATA.status ="Lien Marked For Full Charge Amount " + CUST.DATA.pending_chrg_amt
					CUST.DATA.chargeTranId = ""
				#}
				ENDIF

				IF((CUST.DATA.lien_b2k_id != "") AND (CUST.DATA.pending_chrg_amt < CUST.DATA.system_calc_amt))THEN
				#{
					CUST.DATA.status ="Charge Collected "+CUST.DATA.actual_amt_coll+ " and Lien Marked "+CUST.DATA.pending_chrg_amt
				#}
				ENDIF
			

				#if (CUST.DATA.chargeTranId != "") then
				#{
					sv_u = system("echo ' Charge tran id :"+CUST.DATA.chargeTranId+"  Account Id : "+CUST.DATA.loan_foracid+" managment fee Amount :"+CUST.DATA.tot_comm+"' >>" + CUST.DATA.extractFile)

					lv_a = ""
					lv_a = lv_a + " insert into custom.managment_fee_coll_tbl "
					lv_a = lv_a + " (bank_id, "
					lv_a = lv_a + " loan_foracid, "
					lv_a = lv_a + " op_foracid, "
					lv_a = lv_a + " charg_tran_id, "
					lv_a = lv_a + " charg_tran_date, "
					lv_a = lv_a + " lien_b2k_id, "
