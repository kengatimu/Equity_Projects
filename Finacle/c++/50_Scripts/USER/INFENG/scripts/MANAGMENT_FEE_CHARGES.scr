		print(CUST.DATA.from_date)
	#}
	ENDIF

	CUST.DATA.extractFile = CUST.DATA.fileStr + CUST.DATA.currentDateTime + ".lst"
	print(CUST.DATA.extractFile)

	sv_s = "> "+  CUST.DATA.extractFile
	sv_a = SYSTEM(sv_s)
	print(sv_a)

	

	lv_q = ""
	lv_q = lv_q + " update custom.managment_fee_tbl m "
	lv_q = lv_q + " set flow_date =  (select "
	lv_q = lv_q + " case "
	lv_q = lv_q + " when  frequency = 'M' then add_months(flow_date,1) "
	lv_q = lv_q + " when  frequency = 'Q' then add_months(flow_date,3) "
	lv_q = lv_q + " when  frequency = 'T' then add_months(flow_date,4) "
	lv_q = lv_q + " when  frequency = 'H' then add_months(flow_date,6) "
	lv_q = lv_q + " when  frequency = 'Y' then add_months(flow_date,12)" 
	lv_q = lv_q + " else flow_date "
	lv_q = lv_q + " end next_flow_date   "
	lv_q = lv_q + " from custom.managment_fee_tbl c "
	lv_q = lv_q + " where c.loan_foracid = m.loan_foracid ) "
	lv_q = lv_q + " where m.bank_id = '"+BANCS.STDIN.contextBankId+"' "
	lv_q = lv_q + " and m.del_flg = 'N' "
	lv_q = lv_q + " and m.flow_date between TO_DATE('"+CUST.DATA.from_date+"','DD-MM-YYYY') AND TO_DATE('"+CUST.DATA.BODDate+"','DD-MM-YYYY') "
	lv_q = lv_q + " and m.loan_foracid in  ( "
	lv_q = lv_q + " select foracid  from tbaadm.gam,tbaadm.gac "
	lv_q = lv_q + " where gam.bank_id = gac.bank_id   "
	lv_q = lv_q + " and gam.acid = gac.acid  "
	lv_q = lv_q + " and chrge_off_flg = 'Y' "
	lv_q = lv_q + " and gam.bank_id = '"+BANCS.STDIN.contextBankId+"' "
	lv_q = lv_q + " and gam.sol_id = '"+BANCS.STDIN.mySolId+"' "
	lv_q = lv_q + " and acct_ownership != 'O' "
	lv_q = lv_q + " and acct_cls_date is null  "
	lv_q = lv_q + " and schm_type = 'LAA') "

	print(lv_q)
	sv_a = urhk_dbSQLWithBind(lv_q)
	PRINT(sv_a)

	IF(sv_a == 0)THEN
	#{
		sv_a = urhk_dbSQLWithBind("COMMIT")
		PRINT(sv_a)
	ELSE
		PRINT("FAILED TO UPDATE")
	#}
	ENDIF

	sv_a = ""
	sv_a = sv_a + " loan_foracid,loan_schm_code,loan_crncy_code,op_foracid,op_acid,tot_comm,flow_date,next_flow_date|"
	sv_a = sv_a + " select loan_foracid,"
	sv_a = sv_a + " gam.schm_code loan_schm_code,"
	sv_a = sv_a + " gam.acct_crncy_code loan_crncy_code,"
	sv_a = sv_a + " (select (select foracid from tbaadm.gam g where g.bank_id = lam.bank_id and g.acid = lam.op_acid) from tbaadm.lam "
	sv_a = sv_a + " where lam.bank_id = m.bank_id and lam.acid =  gam.acid ) as op_foracid ,"
	sv_a = sv_a + " (select op_acid from tbaadm.lam "
	sv_a = sv_a + " where lam.bank_id = m.bank_id and lam.acid =  gam.acid ) as op_acid ,"
	sv_a = sv_a + " (comm_amt+tax_amt) as tot_comm,"
	sv_a = sv_a + " to_char(flow_date,'DD-MM-YYYY'),"
	sv_a = sv_a + " to_char(case "
	sv_a = sv_a + " when frequency = 'M' then add_months(flow_date,1)  "
	sv_a = sv_a + " when frequency = 'Q' then add_months(flow_date,3)  "
	sv_a = sv_a + " when frequency = 'T' then add_months(flow_date,4)  "
	sv_a = sv_a + " when frequency = 'H' then add_months(flow_date,6)  "
	sv_a = sv_a + " when frequency = 'Y' then add_months(flow_date,12)  "
	sv_a = sv_a + " else flow_date end ,'DD-MM-YYYY') next_flow_date   "
	sv_a = sv_a + " from custom.managment_fee_tbl m,tbaadm.gam,tbaadm.gac "
	sv_a = sv_a + " where gam.bank_id = m.bank_id  "
	sv_a = sv_a + " and gam.bank_id = gac.bank_id  "
	sv_a = sv_a + " and gam.acid = gac.acid  "
	sv_a = sv_a + " and gam.foracid = m.loan_foracid  "
	sv_a = sv_a + " and gam.bank_id = '"+BANCS.STDIN.contextBankId+"' "
	sv_a = sv_a + " and gam.sol_id = '"+BANCS.STDIN.mySolId+"' "
	sv_a = sv_a + " and m.del_flg = 'N' "
	sv_a = sv_a + " and chrge_off_flg != 'Y' "
	sv_a = sv_a + " and gam.acct_cls_date is  null "
	sv_a = sv_a + " and clr_bal_amt < 0  "
	sv_a = sv_a + " and m.flow_date between TO_DATE('"+CUST.DATA.from_date+"','DD-MM-YYYY') AND TO_DATE('"+CUST.DATA.BODDate+"','DD-MM-YYYY') "
	
	print(sv_a)
	sv_d = urhk_dbcursorOpenWithBind(sv_a)
	IF(sv_d == 0)THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_m)
