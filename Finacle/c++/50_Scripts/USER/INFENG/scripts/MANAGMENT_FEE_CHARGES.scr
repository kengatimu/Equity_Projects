			sv_s = sv_s + " and tran_particular ='"+CUST.DATA.tran_particular+"' "
			sv_s = sv_s + " and bank_id = '"+BANCS.STDIN.contextBankId+"'"
			
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS =  CUST.DATA.BODDate + "|" + CUST.DATA.op_acid
			
			print(BANCS.INPARAM.BINDVARS)
