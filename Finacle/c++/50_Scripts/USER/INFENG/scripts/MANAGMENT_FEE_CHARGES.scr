	CUST.DATA.Status = ""
	CUST.DATA.fileStr = "MANAGMENT_FEE_"
	CUST.DATA.extractFile = ""
	CUST.DATA.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
	#CUST.DATA.BODDate = "17-03-2025"
	
	
	sv_s = "currentDateTime,from_date,|SELECT TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),to_char(dc_cls_date+1,'DD-MM-YYYY') FROM TBAADM.GCT "
	sv_s = sv_s + "WHERE BANK_ID = '"+BANCS.STDIN.contextBankId+"'"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.DATA.currentDateTime = BANCS.OUTPARAM.currentDateTime
		CUST.DATA.from_date = BANCS.OUTPARAM.from_date
