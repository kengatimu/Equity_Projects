					lv_a = lv_a + " flow_date) "
					lv_a = lv_a + " values ('"+BANCS.STDIN.contextBankId+"', "
					lv_a = lv_a + " '"+CUST.DATA.loan_foracid+"', "
					lv_a = lv_a + " '"+CUST.DATA.op_foracid+"', "
					lv_a = lv_a + " '"+CUST.DATA.chargeTranId+"', "
					lv_a = lv_a + " to_date ('"+CUST.DATA.BODDate+"','DD-MM-YYYY'), "
					lv_a = lv_a + " '"+CUST.DATA.lien_b2k_id+"', "
					lv_a = lv_a + " sysdate, "
					lv_a = lv_a + " '"+BANCS.STDIN.userId+"', "
					lv_a = lv_a + " '"+CUST.DATA.status+"',"
					lv_a = lv_a + " to_date ('"+CUST.DATA.flow_date+"','DD-MM-YYYY'))"	

					print(lv_a)
					sv_a = urhk_dbSQLWithBind(lv_a)
					PRINT(sv_a)

					IF(sv_a == 0)THEN
					#{
						sv_a = urhk_dbSQLWithBind("COMMIT")
