        ENDIF

        IF (CLASSEXISTS("CUST","CIETXN") == 0) THEN
        #{
                CREATECLASS("CUST","CIETXN",5)
        #}
        ENDIF

	IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
        #{
                CREATECLASS("CUST","GCHRG",5)
        #}
        ENDIF

        #----------------------------------------------------------------------
        # Printing Bancs Repository
        #----------------------------------------------------------------------

        CUST.DATA.period = ""
        CUST.DATA.acctNum = ""
        CUST.DATA.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
        PRINT(CUST.DATA.BODDate)
	CUST.DATA.lienSerialNum = ""
        CUST.DATA.tranDate = BANCS.STDIN.BODDate
        CUST.DATA.tranType = "T"
        CUST.DATA.tranSubType ="BI"

        CUST.DATA.glDate = BANCS.STDIN.BODDate
        CUST.DATA.valueDate = BANCS.STDIN.BODDate

        CUST.DATA.dbSerial_num ="1"
        CUST.DATA.debitPartTranType="D"
        CUST.DATA.laAcct = ""
        CUST.DATA.opCrncy= ""

        CUST.DATA.crSerial_num ="2"
        CUST.DATA.creditPartTranType ="C"
        CUST.DATA.opAcct = ""
        CUST.DATA.creditRefCrncy=""
        CUST.DATA.creditTranParticular="Commission And Anual Fee"
        CUST.DATA.tranId=""
        CUST.DATA.refCrncy = "RWF"

	CUST.DATA.balAmt = "0.00"
	CUST.DATA.taxAmt = "0.00"
        CUST.DATA.tranAmt = ""

        CUST.DATA.laAcct = "4012100605409"
        #CUST.DATA.laAcct = "4021650013678"
        #CUST.DATA.laAcct = BANCS.STDIN.mySolId +""+ CUST.DATA.laAcct
        CUST.DATA.rate = "1"
