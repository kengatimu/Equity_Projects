	PRINT(BANCS.OUTPARAM.srvValue)		
	CUST.DATA.chngSolId = BANCS.OUTPARAM.srvValue

	#------------------------------------------------------------------------
        #
        #------------------------------------------------------------------------

	CUST.DATA.userSolId = BANCS.STDIN.homeSolId


	IF((BANCS.STDIN.userId== "UBSADMIN50") OR (BANCS.STDIN.userId== "COGEMIGR01") OR (BANCS.STDIN.userId== "COGEMIGR02") OR (BANCS.STDIN.userId== "JI16825"))THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	lv_q = " count | SELECT COUNT(*) FROM TBAADM.SST WHERE SOL_ID = ?SVAR AND BANK_ID = ?SVAR AND SET_ID = 'COGE' "
	print(lv_q)

	BANCS.INPARAM.BINDVARS = CUST.DATA.userSolId +"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	lv_u = urhk_dbSelectWithBind(lv_q)
	PRINT(lv_u)

	if(lv_u == 0)then
	#{
		CUST.DATA.count = BANCS.OUTPARAM.count
		PRINT(CUST.DATA.count)

		IF(CUST.DATA.count == 1)THEN
		#{
			CUST.DATA.usrSetId = "COGE"
		#}
		ELSE
		#{
			CUST.DATA.usrSetId = "EQUITY"
		#}
		ENDIF
	#}
	ENDIF

	lv_q = " count | SELECT COUNT(*) FROM TBAADM.SST WHERE SOL_ID = ?SVAR AND BANK_ID = ?SVAR AND SET_ID = 'COGE' "
	print(lv_q)

	BANCS.INPARAM.BINDVARS = CUST.DATA.chngSolId +"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	lv_u = urhk_dbSelectWithBind(lv_q)
	PRINT(lv_u)

	if(lv_u == 0)then
	#{
		CUST.DATA.count = BANCS.OUTPARAM.count
		PRINT(CUST.DATA.count)

		IF(CUST.DATA.count == 1)THEN
		#{
			CUST.DATA.userSetId = "COGE"
		#}
		ELSE
		#{
			CUST.DATA.userSetId = "EQUITY"
		#}
		ENDIF

		IF(CUST.DATA.usrSetId == "COGE")THEN
		#{
			IF(CUST.DATA.usrSetId == CUST.DATA.userSetId)THEN
			#{
				PRINT("Success")
			#}
			ELSE
			#{
				lv_e = urhk_SRV_SetErr("Invalid Sol Id")
			#}
			ENDIF
		#}
		ELSE
		#{
			IF(CUST.DATA.usrSetId == CUST.DATA.userSetId)THEN
			#{
				PRINT("Success")
			#}
			ELSE
			#{
				lv_e = urhk_SRV_SetErr("Invalid Sol Id")
			#}
			ENDIF	
		#}
		ENDIF
	#}
	ENDIF

