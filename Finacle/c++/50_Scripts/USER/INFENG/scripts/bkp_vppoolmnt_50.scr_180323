<--start
trace on
	if(repexists("ODACCT")==0)then
                createrep("ODACCT")
        endif
        if(classexists("ODACCT","GLBDATA")==0)then
                createclass("ODACCT","GLBDATA",5)
        endif
	if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("CUST","GCHRG")==0)then
                createclass("CUST","GCHRG",5)
        endif
        ODACCT.GLBDATA.srvErrCode = ""
        ODACCT.GLBDATA.srvErrMsg = ""
        ODACCT.GLBDATA.srvSucFail = ""
        ODACCT.GLBDATA.PoolAcct  = ""

        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctLimits.sanctionLimit")
        ODACCT.GLBDATA.sanctionLimit=BANCS.OUTPARAM.srvValue
        print(ODACCT.GLBDATA.sanctionLimit)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctLimits.sanctDate")
        ODACCT.GLBDATA.sanctDate=BANCS.OUTPARAM.srvValue
        print(ODACCT.GLBDATA.sanctDate)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctLimits.expiryDate")
        ODACCT.GLBDATA.expiryDate=BANCS.OUTPARAM.srvValue
        print(ODACCT.GLBDATA.expiryDate)

	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.foracid")
	ODACCT.GLBDATA.DrActNum = TRIM(BANCS.OUTPARAM.srvValue)
	print(ODACCT.GLBDATA.DrActNum)
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.acid")
	ODACCT.GLBDATA.Dracid = TRIM(BANCS.OUTPARAM.srvValue)
	print(ODACCT.GLBDATA.Dracid)
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.freeText")
	ODACCT.GLBDATA.DrActNum = TRIM(BANCS.OUTPARAM.srvValue)
	print(ODACCT.GLBDATA.DrActNum)
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.crncyCode")
	ODACCT.GLBDATA.DrcrncyCode = TRIM(BANCS.OUTPARAM.srvValue)
	print(ODACCT.GLBDATA.DrcrncyCode)
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.solId")
	ODACCT.GLBDATA.DrsolId = TRIM(BANCS.OUTPARAM.srvValue)
	print(ODACCT.GLBDATA.DrsolId)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.foracid")
        ODACCT.GLBDATA.foracid = TRIM(BANCS.OUTPARAM.srvValue)
        print(ODACCT.GLBDATA.foracid)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.acid")
        ODACCT.GLBDATA.acid = TRIM(BANCS.OUTPARAM.srvValue)
        print(ODACCT.GLBDATA.acid)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId")
        ODACCT.GLBDATA.solId = TRIM(BANCS.OUTPARAM.srvValue)
        print(ODACCT.GLBDATA.solId)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode")
        ODACCT.GLBDATA.schmCode = TRIM(BANCS.OUTPARAM.srvValue)
        print(ODACCT.GLBDATA.schmCode)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.acctCrncyCode.crncyCode")
        ODACCT.GLBDATA.crncyCode = TRIM(BANCS.OUTPARAM.srvValue)
        print(ODACCT.GLBDATA.crncyCode)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.custId.cifId")
        ODACCT.GLBDATA.cifId = TRIM(BANCS.OUTPARAM.srvValue)
        print(ODACCT.GLBDATA.cifId)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps")
        ODACCT.GLBDATA.allowSweeps = TRIM(BANCS.OUTPARAM.srvValue)
        print(ODACCT.GLBDATA.allowSweeps)
        ODACCT.GLBDATA.srvcallmode = BANCS.INPUT.srvcallmode
        print(ODACCT.GLBDATA.srvcallmode)
	if(ODACCT.GLBDATA.DrActNum=="")then
		exitscript
	endif
	sv_d = "sweepYN,cStmtreq,poCeilCy| select allow_sweeps,combined_stmt_reqd,po_stp_ceil_crncy from tbaadm.ccmg "
	sv_d = sv_d + " where cif_id=?SVAR and bank_id=?SVAR "
	sv_d = sv_d + "  and entity_cre_flg='Y' "
	BANCS.INPARAM.BINDVARS = ODACCT.GLBDATA.cifId + "|" + BANCS.STDIN.contextBankId
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		ODACCT.GLBDATA.sweepYN = BANCS.OUTPARAM.sweepYN
		ODACCT.GLBDATA.cStmtreq = BANCS.OUTPARAM.cStmtreq
		ODACCT.GLBDATA.poCeilCy = BANCS.OUTPARAM.poCeilCy
	else
		ODACCT.GLBDATA.sweepYN = "0"
		ODACCT.GLBDATA.cStmtreq = "N"
		ODACCT.GLBDATA.poCeilCy = ""
	endif
	if((ODACCT.GLBDATA.sweepYN=="N") or (ODACCT.GLBDATA.sweepYN==""))then
		sv_d = "update tbaadm.ccmg set allow_sweeps='Y' where bank_id=?SVAR "
		sv_d = sv_d + " and cif_id=?SVAR "
		print(sv_d)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + ODACCT.GLBDATA.cifId
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlWithBind(sv_d)
		if(sv_u==0)then
			sv_u = urhk_dbSqlWithBind("commit")
			print("ccfm success")
		endif
	endif
	if(ODACCT.GLBDATA.allowSweeps!="Y")then
		lv_s = "update tbaadm.gam set allow_sweeps='Y' where bank_id=?SVAR and foracid=?SVAR " 
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + ODACCT.GLBDATA.foracid 
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlWithBind(lv_s)
		if(sv_u==0)then
			sv_u = urhk_dbSqlWithBind("commit")
			print("sweep success")
		endif
	endif
#pool
	print(ODACCT.GLBDATA.foracid)
	print(ODACCT.GLBDATA.DrActNum)
	ODACCT.GLBDATA.PoolAcct = ODACCT.GLBDATA.DrActNum 
        sv_o= ""
        sv_t= ""
        sv_r= ""
        sv_f= ""
        sv_a=urhk_SetUrhkInp("poolInfo.pool.ptype|S")
        sv_a=urhk_SetUrhkInp("poolInfo.pool.reglflag|Y")
        ######sv_a=urhk_SetUrhkInp("poolInfo.pool.reglflag|N")
        sv_a=urhk_SetUrhkInp("poolInfo.poolDesc|OD POOL")
        sv_a=urhk_SetUrhkInp("poolInfo.acct.foracid|" + ODACCT.GLBDATA.foracid )
        sv_u = urhk_ExecSrvNoCommit("SRV_FetchPoolForCreate|same_user_verify = Y|retain_all_output = Y")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
        #{
                #loop
                sv_u = urhk_GetUrhkNum("poolLL")
                if(sv_u != 0)then
                        goto VAYU
                endif
                sv_j = cint(BANCS.OUTPARAM.srvValue)
                print(sv_j)
                sv_b = 0
                while(sv_b < sv_j)
                #{
                        sv_d = "poolLL.<rec_" + FORMAT$(sv_b, "%d") + ">.acct.foracid"
                        sv_u = urhk_GetUrhkOut(sv_d)
                        ODACCT.GLBDATA.swpAcctO = BANCS.OUTPARAM.srvValue
                        sv_d = "poolLL.<rec_" + FORMAT$(sv_b, "%d") + ">.scheme.schmCode"
                        sv_u = urhk_GetUrhkOut(sv_d)
                        ODACCT.GLBDATA.swpAcctOSchm = BANCS.OUTPARAM.srvValue
			if(ODACCT.GLBDATA.PoolAcct==ODACCT.GLBDATA.swpAcctO)then
				ODACCT.GLBDATA.swpAO = ODACCT.GLBDATA.swpAcctO
				print(ODACCT.GLBDATA.swpAO)
				sv_o = sv_b
			endif
			if(ODACCT.GLBDATA.foracid==ODACCT.GLBDATA.swpAcctO)then
				ODACCT.GLBDATA.swpAT = ODACCT.GLBDATA.swpAcctO
				print(ODACCT.GLBDATA.swpAT)
				sv_t = sv_b
			endif
                        print(sv_b)
                        sv_b = sv_b + 1
                #}
                do
        else
                ODACCT.GLBDATA.srvAcctId = ODACCT.GLBDATA.PoolAcct
                callscriptifexist("ebsrvHandler.scr")
		if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
			print(EQSRV.GLBDATA.SrvError)
		endif
                ODACCT.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError 
                ODACCT.GLBDATA.srvErrCode = "SRV_FetchDfltODAcctDtls"
                ODACCT.GLBDATA.srvSucFail = "F"
		sv_u = urhk_SetOrbOut("poolMsg|"+ODACCT.GLBDATA.srvErrMsg)
                goto VAYU
        #}
        endif
        sv_u = urhk_CopyOutToIn("")
        sv_a = urhk_SetUrhkOut("poolInfo.pool.id|PoolId")
        sv_b = 0
        while(sv_b < sv_j)
        #{
                sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_b, "%d") + ">.allowSweeps|N")
                sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_b, "%d") + ">.delFlg|Y")
                sv_b = sv_b + 1
        #}
        do
        print(sv_o)
	print(ODACCT.GLBDATA.swpAO)
        ##if(sv_o!="")then
	if(ODACCT.GLBDATA.swpAO!="")then
                sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_o, "%d") + ">.allowSweeps|Y")
                sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_o, "%d") + ">.delFlg|N")
                #sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_o, "%d") + ">.orderOfUtilization|2")
        endif
        print(sv_t)
        if(sv_t!="")then
                sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_t, "%d") + ">.allowSweeps|Y")
                sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_t, "%d") + ">.delFlg|N")
                #sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_o, "%d") + ">.orderOfUtilization|3")
        endif
        sv_u = urhk_ExecSrvNoCommit("SRV_CreatePoolAndVerify|same_user_verify = Y|retain_all_output = Y")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
        #{
                ODACCT.GLBDATA.PoolId = BANCS.OUTPARAM.PoolId
                ODACCT.GLBDATA.srvErrMsg = "Pool Created Successfully : " + ODACCT.GLBDATA.PoolId
                ODACCT.GLBDATA.srvSucFail = "S"
        else
                ODACCT.GLBDATA.srvAcctId = ODACCT.GLBDATA.PoolAcct
                callscriptifexist("ebsrvHandler.scr")
		if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
			print(EQSRV.GLBDATA.SrvError)
		endif
                ODACCT.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError 
                ODACCT.GLBDATA.srvErrCode = "SRV_CreatePoolAndVerify"
                ODACCT.GLBDATA.srvSucFail = "F"
		sv_u = urhk_SetOrbOut("poolMsg|"+ODACCT.GLBDATA.srvErrMsg)
                ###goto VAYU
        #}
        endif
#Charge
	if((cdouble(ODACCT.GLBDATA.sanctionLimit)>0) and (ODACCT.GLBDATA.foracid!="") and (ODACCT.GLBDATA.DrActNum!=""))then
	#{
		print(ODACCT.GLBDATA.schmCode)
		if(ODACCT.GLBDATA.schmCode=="OD504")then
		#{
			exitscript
		#}
		endif
		if(ODACCT.GLBDATA.schmCode=="OD505")then
		#{
			exitscript
		#}
		endif
		if(ODACCT.GLBDATA.schmCode=="OD501")then
		#{
			sv_u = urhk_getAcctDetailsInRepository(ODACCT.GLBDATA.DrActNum)
			if(sv_u == 0)then
			#{
				ODACCT.GLBDATA.DrcrncyCode = BANCS.OUTPARAM.acctCrncyCode
				print(ODACCT.GLBDATA.DrcrncyCode)
				
			#}
			else
			#{
				ODACCT.GLBDATA.DrcrncyCode = ""
				
			#}
			endif
			#3% of limit amount  as lace + VAT 18% of lace amount =3.54%
                        ODACCT.GLBDATA.eventId = "LIMODL"
			print("charge")	
			CUST.GCHRG.drAcctId                     = ODACCT.GLBDATA.DrActNum 
			CUST.GCHRG.acctCrncyCode        = ODACCT.GLBDATA.DrcrncyCode 
			CUST.GCHRG.eventId                      = ODACCT.GLBDATA.eventId 
			CUST.GCHRG.chrgAmt                      = ODACCT.GLBDATA.sanctionLimit 
			CUST.GCHRG.tranType                     = "T"
			CUST.GCHRG.tranSubType          = "BI"
			CALL("gchrgcommon.scr")
			IF(CUST.GCHRG.successOrFailure == "S") THEN
			#{
				print(CUST.GCHRG.tranId)
				exitscript
			#}
			ELSE
			#{
				exitscript	
			#}
			ENDIF
		#}
		ENDIF

		IF(ODACCT.GLBDATA.schmCode=="OD503")then
		#{
			sv_u = urhk_getAcctDetailsInRepository(ODACCT.GLBDATA.DrActNum)
			if(sv_u == 0)then
			#{
				ODACCT.GLBDATA.DrcrncyCode = BANCS.OUTPARAM.acctCrncyCode
				print(ODACCT.GLBDATA.DrcrncyCode)
				
			#}
			else
			#{
				ODACCT.GLBDATA.DrcrncyCode = ""
				
			#}
			endif
			#ODACCT.GLBDATA.tranAmt = cdouble(ODACCT.GLBDATA.sanctionLimit) * 10 /100
                        ODACCT.GLBDATA.eventId = "LIMTOD"
			print("charge")	
			CUST.GCHRG.drAcctId                     = ODACCT.GLBDATA.DrActNum 
			CUST.GCHRG.acctCrncyCode        = ODACCT.GLBDATA.DrcrncyCode 
			CUST.GCHRG.eventId                      = ODACCT.GLBDATA.eventId 
			CUST.GCHRG.chrgAmt                      = ODACCT.GLBDATA.sanctionLimit 
			CUST.GCHRG.tranType                     = "T"
			CUST.GCHRG.tranSubType          = "BI"
			CALL("gchrgcommon.scr")
			IF(CUST.GCHRG.successOrFailure == "S") THEN
			#{
				print(CUST.GCHRG.tranId)
				exitscript
			#}
			ELSE
			#{
				exitscript	
			#}
			ENDIF
		#}
		ENDIF

		if(ODACCT.GLBDATA.schmCode=="XXX")then
		#{
                        #10% of TOD amount marked
                        ODACCT.GLBDATA.eventId = "LIMTOD"
		print(ODACCT.GLBDATA.sanctionLimit)
		ODACCT.GLBDATA.tranAmt = cdouble(ODACCT.GLBDATA.sanctionLimit) * 10 /100
		print(ODACCT.GLBDATA.tranAmt)
		print(ODACCT.GLBDATA.DrActNum)
		print(ODACCT.GLBDATA.foracid)
		sv_u = urhk_getAcctDetailsInRepository(ODACCT.GLBDATA.DrActNum)
		if(sv_u == 0)then
		#{
			ODACCT.GLBDATA.EffBal = BANCS.OUTPARAM.EffAvailableAmt
			ODACCT.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
			ODACCT.GLBDATA.sanLim = BANCS.OUTPARAM.sanctionLimit
			ODACCT.GLBDATA.drawingPower = BANCS.OUTPARAM.drawingPower
			ODACCT.GLBDATA.avalAmt = BANCS.OUTPARAM.AvailableAmt
			ODACCT.GLBDATA.oacctSolId = BANCS.OUTPARAM.acctSolId
		#}
		else
		#{
			ODACCT.GLBDATA.avalAmt = ""
			ODACCT.GLBDATA.oacctSolId = ""
		#}
		endif
		#if(cdouble(ODACCT.GLBDATA.tranAmt)>cdouble(ODACCT.GLBDATA.avalAmt))then
		#{
			#ODACCT.GLBDATA.DrActNum = ODACCT.GLBDATA.foracid
			#ODACCT.GLBDATA.oacctSolId = ODACCT.GLBDATA.solId
		#}
		#endif
		ODACCT.GLBDATA.crChrBacid = "TODCHGS"
		sv_t = ODACCT.GLBDATA.crChrBacid +"|"+ BANCS.STDIN.homeCrncyCode +"|"+ ODACCT.GLBDATA.oacctSolId 
		print(sv_t)
		sv_u = urhk_B2k_BacidToAcctId(sv_t)
		if(sv_u == 0 )then
			ODACCT.GLBDATA.EcoAcctId =BANCS.OUTPARAM.AcctId
			print(ODACCT.GLBDATA.EcoAcctId)
		else
			ODACCT.GLBDATA.EcoAcctId = "4001650020098"
		endif
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
		sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")
		sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate )
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+ODACCT.GLBDATA.tranAmt+"|"+ BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+ ODACCT.GLBDATA.DrActNum ) 
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+ BANCS.STDIN.BODDate)
		ODACCT.GLBDATA.drRmks = "chrg"
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+ ODACCT.GLBDATA.drRmks )
		ODACCT.GLBDATA.drPart = "Chrg Dr:for " + ODACCT.GLBDATA.EcoAcctId
		ODACCT.GLBDATA.drPart = mid$(ODACCT.GLBDATA.drPart,0,50)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+ ODACCT.GLBDATA.drPart )

		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+ BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+ODACCT.GLBDATA.tranAmt+"|"+ BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+ ODACCT.GLBDATA.EcoAcctId )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
		ODACCT.GLBDATA.drRmks = "Chrg"
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|"+ ODACCT.GLBDATA.drRmks )
		ODACCT.GLBDATA.drPart = "Chrg Cr:from " + ODACCT.GLBDATA.DrActNum 
		ODACCT.GLBDATA.drPart = mid$(ODACCT.GLBDATA.drPart,0,50)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+ ODACCT.GLBDATA.drPart )
		sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
		sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
		sv_u = urhk_ExecSrvNoCommit("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
		#{
		       print(BANCS.OUTPARAM.successOrFailure)
			if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
			#{
				callscriptifexist("ebsrvHandler.scr")
				if(fieldexists(ODACCT.GLBDATA.SrvError)==1)then
				#{
					ODACCT.GLBDATA.srvMsg    = ODACCT.GLBDATA.SrvError
					ODACCT.GLBDATA.srvErrorCode = "E0012"
					ODACCT.GLBDATA.srvSF     = "F"
					goto SRVEND
				#}
				endif
			#}
			endif
			if((BANCS.OUTPARAM.successOrFailure=="S") and (sv_u==0))then
