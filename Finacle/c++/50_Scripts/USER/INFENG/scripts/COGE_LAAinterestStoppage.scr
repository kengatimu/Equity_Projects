        #------------------------------------------------------------------------------------------------------------------------

        lv_q = " Foracid,acctpref | select FORACID,INTREST_RATE from CUSTOM.COGE_INTREST_CHANGE WHERE INTREST_UPDATED_FLAG = 'N' "
        PRINT(lv_q)

        lv_u = urhk_dbcursorOpenWithBind(lv_q)
        PRINT(lv_q)

        IF(lv_u == 0)THEN
        #{
                CUST.LAA.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(CUST.LAA.CURSOR_NUMBER)
                sv_b = urhk_dbCursorFetch(CUST.LAA.CURSOR_NUMBER)
                print(sv_b)

                WHILE(sv_b == "0")
                #{

                        CUST.LAA.Foracid = BANCS.OUTPARAM.Foracid
                        print(CUST.LAA.Foracid)
                        CUST.LAA.acctpref = BANCS.OUTPARAM.acctpref
                        PRINT(CUST.LAA.acctpref)

                        sv_s="pegged |"
                        sv_s = sv_s + " SELECT PEGGED_FLG FROM TBAADM.ITC WHERE "
                        sv_s = sv_s + " BANK_ID=?SVAR AND ENTITY_ID=(SELECT ACID FROM TBAADM.GAM WHERE FORACID = ?SVAR) order by INT_TBL_CODE_SRL_NUM desc "
                        sv_s = sv_s + " OFFSET 0 ROWS FETCH NEXT 1 ROWS ONLY "
                        print(sv_s)

                        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.LAA.Foracid
                        print(BANCS.INPARAM.BINDVARS)

                        sv_d = urhk_dbSelectWithBind(sv_s)
                        IF(sv_d==0)THEN
                        #{
                                CUST.LAA.pegged= BANCS.OUTPARAM.pegged
                                print(CUST.LAA.pegged)
                        #}
                        ENDIF

