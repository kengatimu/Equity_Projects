#
<--START
TRACE ON
        #--------------------------------------------------------
        #create repository
        #--------------------------------------------------------

        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF
        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

        #----------------------------------------------------------------------
        # Printing Bancs Repository
        #----------------------------------------------------------------------

        sv_x = urhk_B2k_PrintRepos("BANCS")
        print(sv_x)

        CUST.DATA.acctNum = BANCS.INPUT.acct_from
	CUST.DATA.chgDate = BANCS.INPUT.flowDate

        #------------------------------------------------------------------------
        #
        #------------------------------------------------------------------------
	
	lv_q =  "acctNum | SELECT IBAN_NUMBER FROM TBAADM.GAM WHERE FORACID = ?SVAR "
        print(lv_q)

        BANCS.INPARAM.BINDVARS = CUST.DATA.acctNum
        print(BANCS.INPARAM.BINDVARS)

        lv_u = urhk_dbSelectWithBind(lv_q)
        PRINT(lv_u)

        if(lv_u == 0)then
        #{
                CUST.DATA.acctNum = BANCS.OUTPARAM.acctNum
                PRINT(CUST.DATA.acctNum)

		sv_a = GETPOSITION(CUST.DATA.acctNum,'_')
		CUST.DATA.acctNum = MID$(CUST.DATA.acctNum,0,sv_a - 1)
        #}
        ENDIF

        lv_q =  "chgAmt | SELECT (COMMISSIONS + TAX) AS CHARGE FROM CUSTOM.COGE_COMM_COLL_NEW WHERE LOAN_ACCOUNT = ?SVAR AND DVA = TO_DATE(?SVAR,'DD-MM-YYYY')"
        print(lv_q)

        BANCS.INPARAM.BINDVARS = CUST.DATA.acctNum +"|"+ CUST.DATA.chgDate
        print(BANCS.INPARAM.BINDVARS)

        lv_u = urhk_dbSelectWithBind(lv_q)
        PRINT(lv_u)

        if(lv_u == 0)then
        #{
		CUST.DATA.chgAmt = BANCS.OUTPARAM.chgAmt
                PRINT(CUST.DATA.chgAmt)
        #}
        ELSE
	#{
		CUST.DATA.chgAmt = "0"
	#}
        ENDIF

        BANCS.OUTPUT.charge = CUST.DATA.chgAmt

TRACE OFF
END-->
