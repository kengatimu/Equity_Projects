	sv_s = sv_s + " AND LHT.SERIAL_NUM = ?SVAR "
	sv_s = sv_s + " AND LHT.SANCT_LIM = ?SVAR "
	sv_s = sv_s + " AND GAM.BANK_ID = LHT.BANK_ID AND GAM.SANCT_LIM = LHT.SANCT_LIM "
	sv_s = sv_s + "AND LHT.BANK_ID = ?SVAR "
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	
