	##########################################################################################
	# To check if sanction limit of the account is modified or not
	##########################################################################################
	
	BANCS.INPARAM.BINDVARS = CUST.LMTCHRG.acid +"|"+ CUST.LMTCHRG.acctCrncyCode + "|" +CUST.LMTCHRG.lhtSrlNum + "|" + CUST.LMTCHRG.sanctLimit + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_s ="count|"
	sv_s = sv_s + " SELECT COUNT (1) FROM TBAADM.GAM GAM, TBAADM.LHT  LHT "
	sv_s = sv_s + " WHERE GAM.ACID = LHT. ACID AND GAM.SOL_ID = LHT.SOL_ID  "
	sv_s = sv_s + " AND GAM.DEL_FLG ='N' AND LHT.ENTITY_CRE_FLG ='N' AND GAM.ENTITY_CRE_FLG ='Y' "
	sv_s = sv_s + " AND GAM.BANK_ID = LHT.BANK_ID AND LHT.ACID = ?SVAR "
