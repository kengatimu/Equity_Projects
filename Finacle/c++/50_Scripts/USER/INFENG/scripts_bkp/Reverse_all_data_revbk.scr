<--START
TRACE ON

#--------------------------------------------------------------------------
#  Creation of MISS repository and CHRG class
#--------------------------------------------------------------------------

	sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        endif

	sv_r = REPEXISTS("MISS")
        IF (sv_r == 0) THEN
                CREATEREP("MISS")
        endif

	sv_r = CLASSEXISTS("MISS", "CHRG")
	IF (sv_r == 0) THEN
		CREATECLASS("MISS", "CHRG", 5)
	ENDIF

#--------------------------------------------------------------------------
# Selecting total number of accounts which are not charged 
#--------------------------------------------------------------------------

	sv_s = "getboddate|select to_char((db_stat_date-1),'DD-MM-YYYY') from tbaadm.gct where bank_id=?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbselectWithBind(sv_s)
			IF (sv_d =="0") THEN
				MISS.CHRG.getboddate = BANCS.OUTPARAM.getboddate
				print(MISS.CHRG.getboddate)
			ENDIF
        

	print(BANCS.STDIN.mySolId)

	sv_s = "dtd_Count|"
	sv_s = sv_s + "select  count(*) from  CUSTOM.TRANS_REVERSAL where "
	sv_s = sv_s + "  PROCESSFLG='N' "
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)

	sv_q = BANCS.OUTPARAM.dtd_Count
	print(sv_q)

	IF (sv_q == "0") THEN
		GOTO Finish
	ENDIF

#--------------------------------------------------------------------------
# Selecting accounts from DTD 
#--------------------------------------------------------------------------


sv_s = "foracid_cr,foracid_dr,tran_amt,acct_crncy_code,tran_particular,tran_particular2,tran_rmks, ref_num,free_text,processflg,sequence_no| select FORACID_CR,FORACID_DR,TRAN_AMT,ACCT_CRNCY_CODE,TRAN_PARTICULAR,TRAN_PARTICULAR2,TRAN_RMKS, REF_NUM,FREE_TEXT,PROCESSFLG,SEQUENCE_NO from CUSTOM.TRANS_REVERSAL where PROCESSFLG='N' "
	PRINT(sv_s)

	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_o)

	print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	MISS.CHRG.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(MISS.CHRG.MainCursor)

#--------------------------------------------------------------------------	
# Initialise the Local Variables 
#--------------------------------------------------------------------------

	#------------------------------------------------------------------
	#  Variable Initialisation for counter. It should be Zero
	#------------------------------------------------------------------
		sv_z = 0
        #------------------------------------------------------------------
        #  Variable Initialisation for credit amount to the bank income
	#  account. It should be Zero. 
        #------------------------------------------------------------------
		MISS.CHRG.done = "N"


#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------
	    

	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.Remarks = "Rversal trans "
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.PSTUpdateFlg ="N"

	sv_v = "bCashWithCrg"
	print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("bCashWithCrg")

#--------------------------------------------------------------------------
# MTT code for creating tranxs like individual debit from customer and 
# consolidated credit to the income Account. 
#--------------------------------------------------------------------------

	while (sv_o == 0)
		sv_c = urhk_dbCursorFetch(MISS.CHRG.MainCursor)
		print(sv_c)
		IF (sv_c != 0) THEN
		#{ 
				sv_r = urhk_MTTS_EndDefinition("")
                                print(sv_r)


            		print(sv_c)
	    		sv_o = 1	

		#}
		ELSE 
		#{
			MISS.CHRG.foracid_cr = BANCS.OUTPARAM.foracid_cr 
			print(MISS.CHRG.foracid_cr)
			MISS.CHRG.foracid_dr = BANCS.OUTPARAM.foracid_dr
			print(MISS.CHRG.foracid_dr)
			MISS.CHRG.tran_amt = BANCS.OUTPARAM.tran_amt
			print(MISS.CHRG.tran_amt)
			MISS.CHRG.acct_crncy_code = BANCS.OUTPARAM.acct_crncy_code
			print(MISS.CHRG.acct_crncy_code)
			MISS.CHRG.tran_particular = BANCS.OUTPARAM.tran_particular
			print(MISS.CHRG.tran_particular)
			MISS.CHRG.tran_particular2 = BANCS.OUTPARAM.tran_particular2
			print(MISS.CHRG.tran_particular2)
			MISS.CHRG.tran_rmks = BANCS.OUTPARAM.tran_rmks
			print(MISS.CHRG.tran_rmks)
			MISS.CHRG.ref_num = BANCS.OUTPARAM.ref_num
			print(MISS.CHRG.ref_num)
			MISS.CHRG.free_text = BANCS.OUTPARAM.free_text
			print(MISS.CHRG.free_text)
			MISS.CHRG.processflg = BANCS.OUTPARAM.processflg
			print(MISS.CHRG.processflg)
			MISS.CHRG.sequence_no = BANCS.OUTPARAM.sequence_no
			print(MISS.CHRG.sequence_no)
	
			
			MISS.CHRG.stamp = "Y"

		

			#------------------------------------------
                        # counter setting for defining different PartTran
                        #------------------------------------------
                        	sv_z = sv_z + 1
                                MISS.CHRG.Counter = sv_z

			#--------------------------------------------------------------------------
			# Create the narration
			#--------------------------------------------------------------------------

			

			MISS.CHRG.wtax_amt = ""
			print(MISS.CHRG.wtax_amt)
				

			#--------------------------------------------------
        		# Withholding Tax Account
        		#--------------------------------------------------

        		IF (MISS.CHRG.stamp == "Y") THEN

                		MTT.PartTranDetails.Account = MISS.CHRG.foracid_cr
				print(MTT.PartTranDetails.Account)
                		MTT.PartTranDetails.RefCurrency = "KES"
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.tran_particular 
				MTT.PartTranDetails.Particulars2 = MISS.CHRG.tran_particular2
                		MTT.PartTranDetails.RefAmount = cdouble(MISS.CHRG.tran_amt)
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.tran_rmks
                		MTT.PartTranDetails.RefNum = MISS.CHRG.ref_num 
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_e = "Credt" + MISS.CHRG.Counter
				print(sv_e)
                		sv_r = urhk_MTTS_definePartTran(sv_e)
                		print(sv_r)

        		ENDIF


			#------------------------------------------------------------------
        		# Customer Debit Partran
        		#------------------------------------------------------------------

               			MTT.PartTranDetails.Account = MISS.CHRG.foracid_dr
                		MTT.PartTranDetails.RefCurrency = "KES"
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.tran_particular
				MTT.PartTranDetails.Particulars2 = MISS.CHRG.tran_particular2
                		sv_a = cdouble(MISS.CHRG.tran_amt)
				print(sv_a)
				sv_a = -(sv_a)
				print(sv_a)
                		MTT.PartTranDetails.RefAmount = sv_a
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.tran_rmks
                		MTT.PartTranDetails.RefNum = MISS.CHRG.ref_num 
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_h = "Debit" + MISS.CHRG.Counter
				print(sv_h)
                		sv_u = urhk_MTTS_definePartTran(sv_h)
				print(sv_u)

		#}
			#######

			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)

			MISS.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
			print(MISS.CHRG.tranid)

			print(BANCS.STDIN.userId)

			print(BANCS.STDIN.sysDate)

			print(BANCS.STDIN.BODDate)

			sv_g = mid$(BANCS.STDIN.sysDate,0,10) 
			print(sv_g)
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)

						
			sv_s = "update CUSTOM.TRANS_REVERSAL set PROCESSFLG ='P' where REF_NUM=?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = MISS.CHRG.ref_num
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSQLWithBind(sv_s)
			print(sv_d)
			sv_d = urhk_dbSQLWithBind("COMMIT")
			print(sv_d)
			########
		ENDIF
	DO

	sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor) 

