IF (CDCI.Request8583.Field123 == "SWT") THEN
	IF (FIELDEXISTS(CDCI.Request8583.Field2) == 1) THEN
		sv_a= MID$(CDCI.Request8583.Field2,0,6)
		print(sv_a)
		IF ((sv_a !="604975") AND (sv_a !="486061") AND (sv_a !="505415") AND (sv_a !="457669")) THEN
			print ("LORO")
			IF (FIELDEXISTS(CDCI.Request8583.Field102) == 0) THEN
				CDCI.Response8583.Field102=" "
				print(CDCI.Response8583.Field102)
			ENDIF
			IF (FIELDEXISTS(CDCI.Request8583.Field24) == 1) THEN
				IF (CDCI.Request8583.Field24=="200" ) THEN
					CDCI.Response8583.Field24="290"
					print(CDCI.Response8583.Field24)
				ENDIF
			ENDIF			
		ENDIF
		IF (FIELDEXISTS(CDCI.Request8583.Field127) == 1) THEN
			print(CDCI.Request8583.Field127)
			sv_v = MID$(CDCI.Request8583.Field127,0,1)
			print(sv_v)
			IF (sv_v =="Z") THEN
				sv_v ="Z"
			ELSE	
				sv_v ="O"
			ENDIF
		ELSE
			sv_v ="O"
		ENDIF

		sv_b= MID$(CDCI.Request8583.Field41,0,3) 
		print(sv_b)
		IF (((sv_a =="457669") OR (sv_a =="505415") OR (sv_v =="Z")) AND (sv_b=="EBR")) THEN
			print(sv_a)
			IF (FIELDEXISTS(CDCI.Response8583.Field5) == 1) THEN
				print(CDCI.Request8583.Field4)
				print(CDCI.Request8583.Field5)

				sv_j=CDCI.Request8583.Field5
				print(sv_j)

				sv_j = lpad(sv_j,14,'0')
				print(sv_j)

				sv_j=mid$(sv_j,0,12)
				print(sv_j)

				CDCI.Request8583.Field5 = sv_j
				print(CDCI.Request8583.Field5)

				CDCI.Response8583.Field4=CDCI.Request8583.Field5
				CDCI.Response8583.Field5=CDCI.Response8583.Field4
				print(CDCI.Response8583.Field4)
				print(CDCI.Response8583.Field5)
			ENDIF
			IF (sv_v =="Z") THEN
				IF (FIELDEXISTS(CDCI.Response8583.Field4) == 1) THEN
					sv_j=CDCI.Request8583.Field4
					print(sv_j)

					sv_j=mid$(sv_j,2,12)
					print(sv_j)

					CDCI.Request8583.Field4 = sv_j
					print(CDCI.Request8583.Field4)			
					CDCI.Response8583.Field5=CDCI.Request8583.Field4
					CDCI.Response8583.Field4=CDCI.Response8583.Field5
					print(CDCI.Response8583.Field4)
					print(CDCI.Response8583.Field5)
				ENDIF
			ENDIF

		ENDIF
		IF (FIELDEXISTS(CDCI.Request8583.Field2) == 1) THEN
			sv_a= MID$(CDCI.Request8583.Field2,0,6) 
			print(sv_a) 
			IF ((sv_a !="604975") and (sv_a !="486061") and (sv_v !="Z") and (sv_a !="505415") and (sv_a !="457669")and (sv_a !="604975") and (sv_a != "669932" ) and (sv_a != "627851") and (sv_a !="447815") and (sv_a !="486061") and (sv_a !="420345") and (sv_a !="420346")) THEN
				IF (FIELDEXISTS(CDCI.Response8583.Field5) == 1) THEN		
					CDCI.Response8583.Field4=CDCI.Request8583.Field5
					CDCI.Response8583.Field5=CDCI.Request8583.Field4
					print(CDCI.Response8583.Field4)
					print(CDCI.Response8583.Field5)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

