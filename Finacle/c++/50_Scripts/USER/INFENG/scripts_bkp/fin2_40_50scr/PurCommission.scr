						CUST.ATM.narr1 ="PUR Comm. To " + CUST.ATM.crAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
						CUST.ATM.narr2 ="PUR Comm. Frm " + CUST.ATM.drAccount + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
