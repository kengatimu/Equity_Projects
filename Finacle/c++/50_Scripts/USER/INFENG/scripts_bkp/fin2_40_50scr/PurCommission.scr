			#--------------------------------------------------------------------------
			# MTT code for creating tranxs  consolidated debit to the collection A/c and
			# individual credit to the income Account and settlement a/c.
			#--------------------------------------------------------------------------
			
			#--------------------------------------------------
			# Contra To EQUITY PURCHASES COMM A/C
			#--------------------------------------------------
			
			MTT.PartTranDetails.Account = CUST.ATM.crAccount
			MTT.PartTranDetails.RefCurrency = CUST.ATM.crncyCode1
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.ATM.narr2
			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.ATM.Amount)
