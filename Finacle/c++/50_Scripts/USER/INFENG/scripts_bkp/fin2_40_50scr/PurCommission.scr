				sv_z = "insert into CUSTOM.C_POS_TRX(MESSAGE_TYPE, TRACE_AUDIT_NUMBER,DEVICEID, CARD_NUMBER, ACCOUNT_NUMBER,TRANSACTION_AMOUNT, "
				sv_z = sv_z + " TRANSACTION_FEE, PRIVATE_DATA_C_100, ORIGINAL_DATA_ELEMENTS,BANK_ID) values(?SVAR,"
				sv_z = sv_z + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
				#print(sv_z)
				
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.Command + "|" + BANCS.INPUT.SerialNum + "|" + BANCS.INPUT.DeviceId
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.CustCardId + "|" + BANCS.INPUT.Foracid
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +CUST.ATM.DubTranAmt + "|" + BANCS.INPUT.Fee
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.INPUT.DccId + "|" + BANCS.INPUT.OrigDataElements
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.STDIN.contextBankId
				sv_z = urhk_dbSqlWithBind(sv_z)
				IF (sv_z == 0) THEN
				#{
					#sv_z = urhk_dbSqlWithBind("COMMIT")
				#}
				ENDIF
			#}
			ENDIF
			
		Finish:
			
		ENDOFSCRIPT:
			IF(CUST.ATM.errMsg != "" ) THEN
			#{
				PRINT(CUST.ATM.errMsg)
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.RespCode = "99"
			#}
			ENDIF
			
			EXITSCRIPT
			TRACE OFF
	END-->
	
