<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("AGFIX")==0)then
        #{
                createrep("AGFIX")
        #}
        endif
        if(classexists("AGFIX","GLBDATA")==0)then
        #{
                createclass("AGFIX","GLBDATA",5)
        #}
        endif
	AGFIX.GLBDATA.srvErrCode = ""
	AGFIX.GLBDATA.srvErrMsg = ""
	AGFIX.GLBDATA.srvSucFail = ""
        print(BANCS.STDIN.BODDate)
        AGFIX.GLBDATA.boddate = left$(BANCS.STDIN.BODDate,10)
        lv_a = AGFIX.GLBDATA.boddate
        print(lv_a)
        print(BANCS.STDIN.mySolId)
        lv_x = BANCS.STDIN.mySolId + "|" + lv_a
        print(lv_x)
        sv_e = urhk_GetNextWorkingDate(lv_x)
        print(sv_e)
        if(sv_e==0)then
        #{
                print(BANCS.OUTPARAM.NextWorkingDate)
                print(BANCS.OUTPARAM.PrevWorkingDate)
                print(BANCS.OUTPARAM.NextDataCentreWorkingDate)
                print(BANCS.OUTPARAM.PrevDataCentreWorkingDate)
                AGFIX.GLBDATA.commissionDate = left$(BANCS.OUTPARAM.PrevDataCentreWorkingDate,10)
        #}
        else
        #{
                AGFIX.GLBDATA.commissionDate = ""
                exitscript
        #}
        endif

	lv_a = " aCifId,aOdAcctId,aAcid,aSchmCode,aClrBalAmt,aSanctLim,aAcctOpnDate,aAllowSweepsYN,aeabBal,apoolId | select cif_id,foracid,acid,schm_code,clr_bal_amt,sanct_lim,acct_opn_date,allow_sweeps, "
	lv_a = lv_a + " tbaadm.commonpackage.eabbal(gam.bank_id,gam.acid,to_date(?SVAR,'DD-MM-YYYY')) as eabbal,pool_id "
	lv_a = lv_a + " from tbaadm.gam where bank_id=?SVAR and schm_code='OD541' and sol_id=?SVAR " 
	lv_a = lv_a + " and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg='N' "
	##lv_a = lv_a + " and allow_sweeps='N' "
	lv_a = lv_a + " and acct_cls_date is null "
	lv_a = lv_a + " and cif_id in (select cif_id from tbaadm.gam where acid in "
	lv_a = lv_a + " (select acid from tbaadm.fcftt where bank_id=?SVAR and fcftt.free_code_18='AGENT-FLOAT')) "
	print(lv_a)
	BANCS.INPARAM.BINDVARS = AGFIX.GLBDATA.commissionDate + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(lv_a)
        if(sv_u==0)then
        #{
                AGFIX.GLBDATA.agdmdcur = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        #}
        else
        #{
                AGFIX.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                AGFIX.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                AGFIX.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        AGFIX.GLBDATA.ddaRec = 0
        sv_z = urhk_dbCursorFetch(AGFIX.GLBDATA.agdmdcur)
        if(sv_z!=0)then
        #{
                AGFIX.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                AGFIX.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                AGFIX.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
		AGFIX.GLBDATA.aCifId = BANCS.OUTPARAM.aCifId
		AGFIX.GLBDATA.aOdAcctId = BANCS.OUTPARAM.aOdAcctId
		AGFIX.GLBDATA.aAcid = BANCS.OUTPARAM.aAcid
		AGFIX.GLBDATA.aSchmCode = BANCS.OUTPARAM.aSchmCode
		AGFIX.GLBDATA.aClrBalAmt = BANCS.OUTPARAM.aClrBalAmt
		AGFIX.GLBDATA.aSanctLim =   BANCS.OUTPARAM.aSanctLim
		AGFIX.GLBDATA.aAcctOpnDate = BANCS.OUTPARAM.aAcctOpnDate 
		AGFIX.GLBDATA.aAllowSweepsYN = BANCS.OUTPARAM.aAllowSweepsYN
		AGFIX.GLBDATA.aeabBal = BANCS.OUTPARAM.aeabBal
		AGFIX.GLBDATA.apoolId = BANCS.OUTPARAM.apoolId

		print(AGFIX.GLBDATA.aCifId)
		print(AGFIX.GLBDATA.aOdAcctId)
		print(AGFIX.GLBDATA.aAcid)
		print(AGFIX.GLBDATA.aSchmCode)
		print(AGFIX.GLBDATA.aClrBalAmt)
		print(AGFIX.GLBDATA.aSanctLim)
		print(AGFIX.GLBDATA.aAcctOpnDate)
		print(AGFIX.GLBDATA.aAllowSweepsYN)
		print(AGFIX.GLBDATA.aeabBal)
		print(AGFIX.GLBDATA.apoolId)
		if(cdouble(AGFIX.GLBDATA.aeabBal)==cdouble("0"))then
		#{
			goto NXTREC
		else
			if(cdouble(AGFIX.GLBDATA.aeabBal)<0)then
			#{
				AGFIX.GLBDATA.aeabBal = -1 * cdouble(AGFIX.GLBDATA.aeabBal)
			#}
			endif
		#}
		endif
		print(AGFIX.GLBDATA.aeabBal)

		BANCS.INPUT.numDays = "5"
		BANCS.INPUT.numMonths = "0"
		###BANCS.INPUT.addDays = (mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.INPUT.numMonths + "|" + BANCS.INPUT.numDays)
		BANCS.INPUT.addDays = (mid$(AGFIX.GLBDATA.commissionDate,0,10) + "|" + BANCS.INPUT.numMonths + "|" + BANCS.INPUT.numDays)
		sv_u = urhk_B2k_Add_MonthsDays_To_date(BANCS.INPUT.addDays)
		print(sv_u)
		if(sv_u != 0)then
		#{
			print("due date failed")
		#}
		else
		#{
			print(BANCS.OUTPARAM.MODIFIED_DATE)
			AGFIX.GLBDATA.dmdDate = BANCS.OUTPARAM.MODIFIED_DATE
		#}
		endif
		BANCS.INPUT.numDays = "6"
		BANCS.INPUT.numMonths = "0"
		###BANCS.INPUT.addDays = (mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.INPUT.numMonths + "|" + BANCS.INPUT.numDays)
		BANCS.INPUT.addDays = (mid$(AGFIX.GLBDATA.commissionDate,0,10) + "|" + BANCS.INPUT.numMonths + "|" + BANCS.INPUT.numDays)
		sv_u = urhk_B2k_Add_MonthsDays_To_date(BANCS.INPUT.addDays)
		print(sv_u)
		if(sv_u != 0)then
		#{
			print("over due date failed")
		#}
		else
		#{
			print(BANCS.OUTPARAM.MODIFIED_DATE)
			AGFIX.GLBDATA.dmdOvdDate = BANCS.OUTPARAM.MODIFIED_DATE
		#}
		endif
		AGFIX.GLBDATA.DccId = "BATCH"
		AGFIX.GLBDATA.Command = "CSWOP"
		AGFIX.GLBDATA.bclearBal = "0"
		AGFIX.GLBDATA.clearBal = "0"
		AGFIX.GLBDATA.TranId = "BATCH"
		if(AGFIX.GLBDATA.aAllowSweepsYN=="")then
		#{
			goto NXTREC
		#}
		endif
		##if(AGFIX.GLBDATA.aAllowSweepsYN=="N")then
		#{
			AGFIX.GLBDATA.SerialNum = "NOSWEEPDIRECT_CREDIT"
		#}
		##endif
		if(AGFIX.GLBDATA.aAllowSweepsYN=="Y")then
		#{
			##sv_u = "SerialNum|select to_char(systimestamp,'DDMMYYYYHH24MISSFF3') from dual "
			##sv_d = urhk_dbSelectWithBind(sv_u)
			##if(sv_d==0)then
			##	AGFIX.GLBDATA.SerialNum = BANCS.OUTPARAM.SerialNum
			##else
			##	AGFIX.GLBDATA.SerialNum = ""
			##endif
		#}
		endif
		AGFIX.GLBDATA.CifId = AGFIX.GLBDATA.aCifId 
		AGFIX.GLBDATA.TranAmt = cdouble(AGFIX.GLBDATA.aeabBal)
		AGFIX.GLBDATA.ADmdAmt = cdouble(AGFIX.GLBDATA.aeabBal)
		##if(AGFIX.GLBDATA.aAllowSweepsYN=="N")then
		#{
			lv_j = " drAcctId | select gam.foracid from tbaadm.gam,tbaadm.fcftt where gam.bank_id=?SVAR and fcftt.bank_id=?SVAR and fcftt.free_code_18='AGENT-FLOAT' and gam.acid=fcftt.acid and gam.cif_id=?SVAR and gam.allow_sweeps<>'Y' and gam.schm_code in ('SB126','CA207') and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acct_cls_flg<>'Y' and fcftt.entity_cre_flg='Y' and fcftt.del_flg='N' and rownum<=1 "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + AGFIX.GLBDATA.CifId 
		##else
		##	lv_j = " drAcctId | select gam.foracid from tbaadm.gam where gam.bank_id=?SVAR and gam.cif_id=?SVAR and gam.allow_sweeps='Y' and gam.schm_code in ('SB126','CA207') and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acct_cls_flg<>'Y' and rownum<=1 "
		##	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + AGFIX.GLBDATA.CifId 
		#}
		##endif
		print(BANCS.INPARAM.BINDVARS)
		print(lv_j)
		lv_b = urhk_dbSelectWithBind(lv_j)
		if(lv_b==0)then
		#{
			AGFIX.GLBDATA.drAcctId = BANCS.OUTPARAM.drAcctId
		else
			AGFIX.GLBDATA.drAcctId = ""
			goto NXTREC
		#}
		endif

	sv_d = "Insert into custom.agddt (bank_id,foracid,sol_id,dmd_date,dmd_eff_date,dmd_ovdu_date,dmd_amt,tot_adj_amt,last_adj_date,dep_tran_id,dep_tran_amt,dep_dccid,dep_srl_num,dep_command,prev_acct_bal,aft_acct_bal,rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,entity_cre_flg,free_text1,free_text2,free_text3,free_text4,free_text5)"
	sv_d = sv_d + " values (?SVAR,?SVAR,?SVAR,to_date(?SVAR,'DD-MM-RR'),to_date(?SVAR,'DD-MM-RR'),to_date(?SVAR,'DD-MM-RR'),?NVAR,0,null,?SVAR,?NVAR,?SVAR,?SVAR,?SVAR,?NVAR,?NVAR,?SVAR,sysdate,?SVAR,sysdate,'N','Y',?SVAR,null,null,?SVAR,null) "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + AGFIX.GLBDATA.drAcctId + "|" + BANCS.STDIN.mySolId + "|" + mid$(AGFIX.GLBDATA.dmdDate,0,10) + "|" + mid$(AGFIX.GLBDATA.dmdDate,0,10) + "|" + mid$(AGFIX.GLBDATA.dmdOvdDate,0,10)+ "|" + AGFIX.GLBDATA.ADmdAmt + "|" + AGFIX.GLBDATA.TranId + "|" + AGFIX.GLBDATA.ADmdAmt + "|" + AGFIX.GLBDATA.DccId + "|" + AGFIX.GLBDATA.SerialNum + "|" + AGFIX.GLBDATA.Command + "|" + AGFIX.GLBDATA.bclearBal + "|" + AGFIX.GLBDATA.clearBal + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + AGFIX.GLBDATA.CifId + "|" + AGFIX.GLBDATA.aOdAcctId
        print(sv_d)
        print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbSqlWithBind(sv_d)
        if(sv_u==0)then
                sv_u = urhk_dbSqlWithBind("commit")
                print(sv_u)
                goto NXTREC
        else
                print("Agent Demand Creation Failed")
                goto NXTREC
        endif


	
                NXTREC:
                        print(AGFIX.GLBDATA.srvErrMsg)
                        print(AGFIX.GLBDATA.srvErrCode)
                        print(AGFIX.GLBDATA.srvSucFail)
                        sv_u = urhk_dbCursorFetch(AGFIX.GLBDATA.agdmdcur)
                        print(sv_u)
                        if(sv_u!=0)then
                        #{
                                print("fetch failed")
                                sv_u = urhk_dbCursorClose(AGFIX.GLBDATA.agdmdcur)
                                print(sv_u)
                                AGFIX.GLBDATA.srvErrMsg =  "Demand Cursor Fetch Failed"
                                AGFIX.GLBDATA.srvErrCode = "DBCursor"
                                AGFIX.GLBDATA.srvSucFail = "F"
                                goto Endofscript
                        #}
                        endif
                        AGFIX.GLBDATA.ddaRec = cint(AGFIX.GLBDATA.ddaRec) + 1
                        AGFIX.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + AGFIX.GLBDATA.ddaRec
                        print(AGFIX.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(AGFIX.GLBDATA.agdmdcur)
        print(sv_u)
Endofscript:
        print(AGFIX.GLBDATA.srvErrCode)
        print(AGFIX.GLBDATA.srvErrMsg)
        print(AGFIX.GLBDATA.srvSucFail)
        exitscript
trace off
end-->
