	IF (CUST.CDMM.funcCode == "M") THEN
	#{
                sv_s = "UPDATE CUSTOM.C_FINACLEUSER_MAPPING_TBL SET DESCRIPTION=?SVAR,PROXY_POST_ALLWD=?SVAR,"
                sv_s = sv_s + "REMOTE_ACCESS_FLG=?SVAR,VIRTUAL_FLG=?SVAR,PRIMARY_GROUP_ID=?SVAR,USER_GROUP_NAME=?SVAR,IS_GLOBAL_ADMIN=?SVAR"
                sv_s = sv_s + ",SSO_ROLE_ID=?SVAR,SSO_ROLE_NAME=?SVAR,ASSIGN_SSOADMIN=?SVAR,CRE_ASSIGN_SVSSERVER=?SVAR,CRE_ASSIGN_REPORT_INFRA=?SVAR,"
                sv_s = sv_s + "ASSIGN_ADMIN_WORKFLOW=?SVAR,ASSIGN_FCSE=?SVAR,ASSIGN_FINACLE_INTEGRATOR=?SVAR,CRE_ASSIGN_CORE_SERVER=?SVAR,"
                sv_s = sv_s + "ASSIGN_CRM_SERVICE=?SVAR,CRE_ASSIGN_CRM_SERVER=?SVAR WHERE ROLE_ID=?SVAR AND USER_WORK_CLASS=?SVAR"

                BANCS.INPARAM.BINDVARS = CUST.CDMM.DESCRIPTION
