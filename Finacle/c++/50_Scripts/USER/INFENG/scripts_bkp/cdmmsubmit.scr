	########################################################################################
	# Validation of funcCode Code
	########################################################################################
	IF (CUST.CDMM.funcCode == "A") THEN
	#{

		sv_s = "Insert into CUSTOM.C_FINACLEUSER_MAPPING_TBL (ROLE_ID,USER_WORK_CLASS,DESCRIPTION,PROXY_POST_ALLWD"
		sv_s = sv_s + ",REMOTE_ACCESS_FLG,VIRTUAL_FLG,PRIMARY_GROUP_ID,USER_GROUP_NAME,IS_GLOBAL_ADMIN,SSO_ROLE_ID,"
		sv_s = sv_s + "SSO_ROLE_NAME,ASSIGN_SSOADMIN,CRE_ASSIGN_SVSSERVER,CRE_ASSIGN_REPORT_INFRA,ASSIGN_ADMIN_WORKFLOW,"
		sv_s = sv_s + "ASSIGN_FCSE,ASSIGN_FINACLE_INTEGRATOR,CRE_ASSIGN_CORE_SERVER,ASSIGN_CRM_SERVICE,CRE_ASSIGN_CRM_SERVER,DEL_FLG)"
		sv_s = sv_s + "values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
		sv_s = sv_s + "?SVAR,?SVAR,?SVAR,?SVAR,'N')"
		
		BANCS.INPARAM.BINDVARS = CUST.CDMM.roleId + "|" + CUST.CDMM.usrwrkcls +"|"+ CUST.CDMM.DESCRIPTION
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.PROXY_POST_ALLWD +"|"+ CUST.CDMM.REMOTE_ACCESS_FLG
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.VIRTUAL_FLG +"|"+ CUST.CDMM.PRIMARY_GROUP_ID
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.USER_GROUP_NAME +"|"+ CUST.CDMM.isGlobalAdmin
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.ssoroleId +"|"+ CUST.CDMM.RoleName
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.ASSIGN_SSOADMIN +"|"+ CUST.CDMM.CRE_ASSIGN_SVSSERVER
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.CRE_ASSIGN_REPORT_INFRA +"|"+ CUST.CDMM.ASSIGN_ADMIN_WORKFLOW
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.ASSIGN_FCSE +"|"+ CUST.CDMM.ASSIGN_FINACLE_INTEGRATOR
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.CRE_ASSIGN_CORE_SERVER +"|"+ CUST.CDMM.ASSIGN_CRM_SERVICE
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CDMM.CRE_ASSIGN_CRM_SERVER
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
            	sv_q = urhk_dbSQLWithBind(sv_s)
            	PRINT(sv_q)
            	IF(sv_q != 0)THEN
            	#{
                    CUST.DATA.errorMsg ="Database Insertion Failed"
                    PRINT(CUST.DATA.errorMsg)
		    sv_u = urhk_SetOrbOut("Error|"+CUST.DATA.errorMsg)	
                    GOTO ENDOFSCRIPT

            	#}
		ELSE
		#{
			sv_u = urhk_SetOrbOut("RESULT_MSG|Record Added Successfully")
                	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		#}
            	ENDIF

	#}
