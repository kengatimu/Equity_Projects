                                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.drAcct + "|" + EBSRV.GLBDATA.drCif
                                        lv_d = urhk_dbSqlWithBind(lv_d)
                                        if(lv_d==0)then
