<--START
TRACE ON
sv_a = urhk_B2k_PrintRepos("BANCS")
print(sv_a)

BANCS.OUTPUT.lv_tranrmks = " "
BANCS.OUTPUT.lv_billerrefnum = " "
BANCS.OUTPUT.lv_billeracctid = " "
BANCS.OUTPUT.lv_freetext1 = " "
BANCS.OUTPUT.lv_freetext2 = " "
BANCS.OUTPUT.lv_freetext3 = " "
BANCS.OUTPUT.lv_freetext4 = " "
BANCS.OUTPUT.lv_freetext5 = " "
BANCS.OUTPUT.lv_freetext6 = " "
BANCS.OUTPUT.lv_freetext7 = " "
BANCS.OUTPUT.lv_solname = " "
print(BANCS.STDIN.mySolDesc)


BANCS.INPUT.lv_trandate = MID$(BANCS.STDIN.BODDate,0,10)
PRINT(BANCS.INPUT.lv_trandate)
PRINT(BANCS.INPUT.lv_instrfour)

sv_s = "tranrmks,billerrefnum,billeracctid,freetext1,freetext2,freetext3,freetext4,freetext5,freetext6,freetext7| "
sv_s = sv_s + "select  NAME,BILLER_REF_NUM,BILLER_ID, FREETEXT1,FREETEXT2,FREETEXT3,FREETEXT4,FREETEXT5,FREETEXT6,FREETEXT7 "
sv_s = sv_s + " FROM custom.c_ubp_hoccmmod"
sv_s = sv_s + " WHERE APP_CATEGORY =?SVAR "
BANCS.INPARAM.BINDVARS = BANCS.INPUT.lv_instrfour 
PRINT(BANCS.INPARAM.BINDVARS)
PRINT(sv_s)
sv_u = urhk_dbSelectWithBind(sv_s)
PRINT(sv_u)
IF (sv_u == 0) THEN
	BANCS.OUTPUT.lv_tranrmks = TRIM(BANCS.OUTPARAM.tranrmks)
	print(BANCS.OUTPUT.lv_tranrmks)
	IF (BANCS.OUTPUT.lv_tranrmks == "") THEN
		BANCS.OUTPUT.lv_tranrmks =" "
	ENDIF
	BANCS.OUTPUT.lv_billerrefnum = TRIM(BANCS.OUTPARAM.billerrefnum)
	print(BANCS.OUTPUT.lv_billerrefnum)
	IF (BANCS.OUTPUT.lv_billerrefnum == "") THEN
		BANCS.OUTPUT.lv_billerrefnum =" "
	ENDIF
	BANCS.OUTPUT.lv_billeracctid = TRIM(BANCS.OUTPARAM.billeracctid)
	print(BANCS.OUTPUT.lv_billeracctid)
	IF (BANCS.OUTPUT.lv_billeracctid == "") THEN
		BANCS.OUTPUT.lv_billeracctid =" "
	ENDIF
	BANCS.OUTPUT.lv_freetext1 = TRIM(BANCS.OUTPARAM.freetext1)
	print(BANCS.OUTPUT.lv_freetext1)
	IF (BANCS.OUTPUT.lv_freetext1 == "") THEN
		BANCS.OUTPUT.lv_freetext1 =" "
	ENDIF
	BANCS.OUTPUT.lv_freetext2 = TRIM(BANCS.OUTPARAM.freetext2)
	print(BANCS.OUTPUT.lv_freetext2)
	IF (BANCS.OUTPUT.lv_freetext2 == "") THEN
		BANCS.OUTPUT.lv_freetext2 =" "
	ENDIF
	BANCS.OUTPUT.lv_freetext3 = TRIM(BANCS.OUTPARAM.freetext3)
	print(BANCS.OUTPUT.lv_freetext3)
	IF (BANCS.OUTPUT.lv_freetext3 == "") THEN
		BANCS.OUTPUT.lv_freetext3 =" "
	ENDIF
	BANCS.OUTPUT.lv_freetext4 = TRIM(BANCS.OUTPARAM.freetext4)
	print(BANCS.OUTPUT.lv_freetext4)
	IF (BANCS.OUTPUT.lv_freetext4 == "") THEN
		BANCS.OUTPUT.lv_freetext4 =" "
	ENDIF
	BANCS.OUTPUT.lv_freetext5 = TRIM(BANCS.OUTPARAM.freetext5)
	print(BANCS.OUTPUT.lv_freetext5)
	IF (BANCS.OUTPUT.lv_freetext5 == "") THEN
		BANCS.OUTPUT.lv_freetext5 =" "
	ENDIF
	BANCS.OUTPUT.lv_freetext6 = TRIM(BANCS.OUTPARAM.freetext6)
	print(BANCS.OUTPUT.lv_freetext6)
	IF (BANCS.OUTPUT.lv_freetext6 == "") THEN
		BANCS.OUTPUT.lv_freetext6 =" "
	ENDIF
	BANCS.OUTPUT.lv_freetext7 = TRIM(BANCS.OUTPARAM.freetext7)
	print(BANCS.OUTPUT.lv_freetext7)
	IF (BANCS.OUTPUT.lv_freetext7 == "") THEN
		BANCS.OUTPUT.lv_freetext7 =" "
	ENDIF

ELSE
	BANCS.OUTPUT.lv_tranrmks = " "
	BANCS.OUTPUT.lv_billerrefnum = " "
	BANCS.OUTPUT.lv_billeracctid = " "
	BANCS.OUTPUT.lv_freetext1 = " "
	BANCS.OUTPUT.lv_freetext2 = " "
	BANCS.OUTPUT.lv_freetext3 = " "
	BANCS.OUTPUT.lv_freetext4 = " "
	BANCS.OUTPUT.lv_freetext5 = " "
	BANCS.OUTPUT.lv_freetext6 = " "
	BANCS.OUTPUT.lv_freetext7 = " "
	
ENDIF

	BANCS.OUTPUT.lv_solname=BANCS.STDIN.mySolDesc
	print(BANCS.OUTPUT.lv_solname)

TRACE OFF
EXITSCRIPT
END-->

