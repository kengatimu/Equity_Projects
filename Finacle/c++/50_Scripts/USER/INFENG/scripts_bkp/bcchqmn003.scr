<--START
CHECKSUM="5fdee62f34cde9f4ae32d44e6855e431e21a9afe6fea69fd66926cda7450dec1"
	TRACE ON
	#---------------------------------------------------------------------------------
	# CREATING NEW REPOSITORY AND CLASS
	#---------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
	#{
		CREATECLASS("CUST", "CHQB", 5)
	#}
	ENDIF
	
	#-----------------------------------------------------
	#Input from criteria
	#-----------------------------------------------------
	CUST.CHQB.requestId = BANCS.INPUT.requestId
	print(CUST.CHQB.requestId)
	CUST.CHQB.func	= BANCS.INPUT.funcCode
	print(CUST.CHQB.func)
	CUST.CHQB.foracid = BANCS.INPUT.acctNo
	print(CUST.CHQB.foracid)
	
	#---------------------------------------------------------------------------
	# Request Id Validation
	#---------------------------------------------------------------------------
	IF (trim(CUST.CHQB.requestId) == "") THEN
	#{
		sv_e = "Please Enter Request ID OR press Seracher ON Request ID field to see the list"
		sv_m = "requestId"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	IF ((CUST.CHQB.func == "D") OR (CUST.CHQB.func == "V")) THEN
	#{
		
		sv_s = "Count|SELECT count(*) "
		sv_s = sv_s + " FROM CUSTOM.C_BCHQ  "
		sv_s = sv_s + " WHERE req_id = ?SVAR "
		sv_s = sv_s + " AND REQ_STATUS !='E' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND branch_code =?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CHQB.requestId + "|" +  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + CUST.CHQB.foracid
		PRINT(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d==0) THEN
		#{
			CUST.CHQB.count = BANCS.OUTPARAM.Count
			print(CUST.CHQB.count)
		#}
		ENDIF
		
		IF (CINT(CUST.CHQB.count) > 0 ) THEN
		#{
			sv_e = "Request already authorized/Deleted"
			sv_m = "funcCode"
			sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#IF ((CUST.CHQB.func == "I") OR (CUST.CHQB.func == "D") OR (CUST.CHQB.func == "V")) THEN
	
	IF (CUST.CHQB.func == "I")  THEN
	#{
		IF (trim(CUST.CHQB.requestId) != "") THEN
		#{
			sv_s = "count|"
			sv_s = sv_s + " SELECT count(*)"
			sv_s = sv_s + " FROM CUSTOM.C_BCHQ"
			sv_s = sv_s + " WHERE req_id = ?SVAR"
			sv_s = sv_s + " AND bank_id = ?SVAR"
			sv_s = sv_s + " AND del_flg = 'N'"
			
			IF(CUST.CHQB.foracid != "") THEN
			#{
				sv_s = sv_s + " AND foracid = ?SVAR"
			#}
			ENDIF
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CHQB.requestId + "|" +  BANCS.STDIN.contextBankId
			
			
			IF(CUST.CHQB.foracid != "") THEN
			#{
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.CHQB.foracid
			#}
			ENDIF
			
			
			
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF (sv_d == 0) THEN
			#{
				CUST.CHQB.count = BANCS.OUTPARAM.count
				print(CUST.CHQB.count)
			#}
			ENDIF
			IF (CUST.CHQB.count <= 0) THEN
			#{
				sv_e = "Please Enter a Valid Request ID OR use Searcher/Request may belong to different Sol."
				sv_m = "requestId"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(BANCS.INPUT.funcCode== "V") THEN
	#{
		sv_s = "ChequeBooks,ReqStatus,foracid,begin_num,rcreid|SELECT num_of_chb,"
		sv_s = sv_s + " req_status,foracid,begin_chq_num,rcre_user_id FROM CUSTOM.C_BCHQ WHERE "
		sv_s = sv_s + " req_id = ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND branch_code =?SVAR "
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.requestId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CHQB.no_of_chkbooks = BANCS.OUTPARAM.ChequeBooks
		CUST.CHQB.Request_status = BANCS.OUTPARAM.ReqStatus
		CUST.CHQB.rcreid = trim(BANCS.OUTPARAM.rcreid)
		CUST.CHQB.fldNoChBk = BANCS.OUTPARAM.ChequeBooks
		CUST.CHQB.fldAcctNo = BANCS.OUTPARAM.foracid
		CUST.CHQB.fldReqStatus = BANCS.OUTPARAM.ReqStatus
		CUST.CHQB.fldChqStNo = BANCS.OUTPARAM.begin_num
		
		
		sv_s = "rcreclass|SELECT USER_WORK_CLASS FROM TBAADM.UPR WHERE user_id = ?SVAR "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CHQB.rcreid
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d != 0) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.CHQB.rcreclass = BANCS.OUTPARAM.rcreclass
		PRINT(CUST.CHQB.rcreclass)
		
		#----------------------------------------------------------------------------------
		# Check for the user cannot authorize his own account
		#----------------------------------------------------------------------------------
		IF (TRIM(BANCS.STDIN.userId) == TRIM(CUST.CHQB.rcreid)) THEN
		#{
			sv_e = "Cannot authorize your own request."
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	#---------------------------------------------------------------------------
	# Fetching Record
	#---------------------------------------------------------------------------
	sv_s = "foracid,NoOfChq,reqStatus,beginNum"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT FORACID,NUM_OF_CHB,REQ_STATUS,BEGIN_CHQ_NUM"
	sv_s = sv_s + " FROM CUSTOM.C_BCHQ "
	sv_s = sv_s + " WHERE req_id = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CHQB.requestId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0 ) THEN
	#{
		#sv_e = "A Database error has occured. Please contact your DBA."
		sv_e = "Please Enter a valid Request ID"
		sv_m = "requestId"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.CHQB.foracid = BANCS.OUTPARAM.foracid
		print(CUST.CHQB.foracid)
		
		CUST.CHQB.NoOfChq = BANCS.OUTPARAM.NoOfChq
		print(CUST.CHQB.NoOfChq)
		
		CUST.CHQB.reqStatus = BANCS.OUTPARAM.reqStatus
		print(CUST.CHQB.reqStatus)
		
		CUST.CHQB.foracid = BANCS.OUTPARAM.foracid
		print(CUST.CHQB.foracid)
		
		CUST.CHQB.beginNum = BANCS.OUTPARAM.beginNum
		print(CUST.CHQB.beginNum)
		
		IF(trim(CUST.CHQB.beginNum) != "") THEN
		#{
			CUST.CHQB.endNo = cint(BANCS.OUTPARAM.beginNum) + (CINT(BANCS.OUTPARAM.NoOfChq)* 100) - 1
			PRINT(CUST.CHQB.endNo)
		#}
		ENDIF
		
		
		sv_u = urhk_SetOrbOut("noOfChqs| "+CUST.CHQB.NoOfChq)
		print(sv_u)
		
		sv_u = urhk_SetOrbOut("reqStat| "+CUST.CHQB.reqStatus)
		print(sv_u)
		print(CUST.CHQB.foracid)
		sv_u = urhk_SetOrbOut("acctNum| "+CUST.CHQB.foracid)
		print(sv_u)
		
		sv_u = urhk_SetOrbOut("startChqNo| "+CUST.CHQB.beginNum)
		print(sv_u)
		
		sv_u = urhk_SetOrbOut("endChqNo| "+CUST.CHQB.endNo)
		print(sv_u)
		
	#}
	ENDIF
	
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	
	ENDOFSCRIPT:
		#TRACE OFF
		EXITSCRIPT
