<--START
CHECKSUM="266b20f5f29b58c1fd3977f99cc2cbbb80d228b3cb53652b5165eaab1314ca7d"
	TRACE ON
	
	IF (REPEXISTS("TRAD") == 0) THEN
	#{
		CREATEREP("TRAD")
	#}
	ENDIF
	
	IF (CLASSEXISTS("TRAD","INTERFACE") == 0) THEN
	#{
		CREATECLASS ("TRAD","INTERFACE",5)
	#}
	ENDIF
	
	sv_a = urhk_b2k_printRepos("BANCS")
	sv_b=1
	sv_a=BANCS.INPUT.orderid
	print(sv_a)
	
	sv_s = "numRec"
	sv_s = sv_s + " | "
	sv_s = sv_s + " select count(*) from custom.sale_details where TRANS_DATE like (select to_char(sysdate) from dual) AND SOL_ID=?SVAR"
	
	BANCS.INPARAM.BINDVARS=BANCS.STDIN.mySolId
	sv_d = urhk_dbSelectWithBind(sv_s)
	sv_c = BANCS.OUTPARAM.numRec
	
	
	sv_q = urhk_SetOrbOut("recCount|"+sv_c)
	
	
	sv_s = "REF_NUM,CDSC_NUMBER,CUSTOMERNAMES,TRANS_STATUS,CODE,SHARES_TRADED"
	sv_s = sv_s + " | "
	sv_s = sv_s + " select REF_NUM,CDSC_NUMBER,CUSTOMERNAMES,TRANS_STATUS,CODE,SHARES_TRADED from custom.sale_details where TRANS_DATE like (select to_char(sysdate) from dual) AND SOL_ID=?SVAR"
	
	BANCS.INPARAM.BINDVARS=BANCS.STDIN.mySolId
	sv_d = urhk_dbCursorOpenWithBind(sv_s)
	sv_m=BANCS.OUTPARAM.DB_CURSOR_NUMBER
	IF(sv_d == 0) THEN
	#{
		sv_a=urhk_dbCursorFetch(sv_m)
		
		WHILE(sv_a == 0)
		#{
			
			
			
			TRAD.INTERFACE.REFNUM =BANCS.OUTPARAM.REF_NUM
			TRAD.INTERFACE.CDSCNUMBER =BANCS.OUTPARAM.CDSC_NUMBER
			TRAD.INTERFACE.CUSTOMERNAMES = BANCS.OUTPARAM.CUSTOMERNAMES
			TRAD.INTERFACE.TRANSSTATUS =BANCS.OUTPARAM.TRANS_STATUS
			TRAD.INTERFACE.CODE =BANCS.OUTPARAM.CODE
			TRAD.INTERFACE.SHARESTRADED =BANCS.OUTPARAM.SHARES_TRADED
			
			TRAD.INTERFACE.count=sv_b
			
			sv_z = "orderid_" + TRAD.INTERFACE.count
			sv_z = sv_z + "|" + TRAD.INTERFACE.REFNUM
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "cdsc_" + TRAD.INTERFACE.count
			sv_z = sv_z + "|" + TRAD.INTERFACE.CDSCNUMBER
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "custnames_" + TRAD.INTERFACE.count
			sv_z = sv_z + "|" + TRAD.INTERFACE.CUSTOMERNAMES
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "status_" + TRAD.INTERFACE.count
			sv_z = sv_z + "|" + TRAD.INTERFACE.TRANSSTATUS
			sv_u = urhk_SetOrbOut(sv_z)
			
			
			sv_z = "code_" + TRAD.INTERFACE.count
			sv_z = sv_z + "|" + TRAD.INTERFACE.CODE
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "sharetraded_" + TRAD.INTERFACE.count
			sv_z = sv_z + "|" + TRAD.INTERFACE.SHARESTRADED
			sv_u = urhk_SetOrbOut(sv_z)
			
			
			sv_a=urhk_dbCursorFetch(sv_m)
			sv_b = sv_b+ 1
		#}
		DO
		sv_x=urhk_dbCursorClose(sv_m)
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("No Record Fetched")
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		exitscript
		TRACE OFF
END-->
