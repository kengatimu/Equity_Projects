#---------------------------------------------------------------------------
<--start
trace on
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	if(repexists("MCNT") == 0)then
		createrep("MCNT")
	endif
	if(classexists("MCNT","EFTD") == 0)then
		createclass("MCNT","EFTD",5)
	endif
	if(repexists("EQSRV") == 0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA") == 0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	MCNT.EFTD.tranType = "T"
	MCNT.EFTD.solid = "000"
	MCNT.EFTD.foracid = ""
	MCNT.EFTD.tranCode = ""
	MCNT.EFTD.date = BANCS.STDIN.BODDate 
	MCNT.EFTD.rateCode = ""
	MCNT.EFTD.rate = ""
	MCNT.EFTD.eventId = ""
	MCNT.EFTD.netOrGrossFlg = "N"
	###############MCNT.EFTD.suspenseAcct = "0001100200414"
	MCNT.EFTD.suspenseAcct = "0003000106511"
	MCNT.EFTD.destAcct = ""
	MCNT.EFTD.chargeamt = "0"
     	sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                MCNT.EFTD.trSting = MTT.InputDetails.Argument1
                sv_l = strlen(MCNT.EFTD.trSting)
                sv_f = mid$(MCNT.EFTD.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                MCNT.EFTD.foracid  = mid$(sv_f,0,(sv_p-1))
                #--
                MCNT.EFTD.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(MCNT.EFTD.trSting)
                sv_f = mid$(MCNT.EFTD.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                MCNT.EFTD.destAcct  = mid$(sv_f,0,(sv_p-1))
                #--
                MCNT.EFTD.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(MCNT.EFTD.trSting)
                sv_f = mid$(MCNT.EFTD.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                MCNT.EFTD.benefBkBrCode  = mid$(sv_f,0,(sv_p-1))
		MCNT.EFTD.uplbatchId = mid$(sv_f,sv_p,sv_l)
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
		goto VAYU
        endif
	sv_d = "srlNum,drAcctId,benefAcctId,benefName,benefBkBrCode,paymentAmt,paymentAmtN,purposeCode,TranCrncy,tranCode,additionalRef,bankCode,branchcode | "
	sv_d = sv_d + " select srl_num,dr_acct_id,beneficiary_acct_num,beneficiary_name,beneficiary_bank_br_code,payment_amt,to_number(trim(payment_amt),999999999999999.9999) as paymentAmt,purpose_code_remarks,tran_crncy,tran_code,additional_ref,substr(beneficiary_bank_br_code,0,2)bankCode,substr(beneficiary_bank_br_code,3,3)as branchcode from custom.cust_merchant_eft_tbl where bank_id=?SVAR "
	sv_d = sv_d + " and entity_cre_flg='Y' "
	sv_d = sv_d + " and del_flg='N' "
	sv_d = sv_d + " and process_status='U' "
	sv_d = sv_d + " and dr_acct_id=?SVAR "
	sv_d = sv_d + " and beneficiary_acct_num=?SVAR "
	sv_d = sv_d + " and beneficiary_bank_br_code=?SVAR "
	sv_d = sv_d + " and upl_batch_id=?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.foracid + "|" + MCNT.EFTD.destAcct + "|" + MCNT.EFTD.benefBkBrCode + "|" + MCNT.EFTD.uplbatchId 
        print(BANCS.INPARAM.BINDVARS)
        print(sv_d)
        sv_u = urhk_dbCursorOpenWithBind(sv_d)
        if(sv_u==0)then
                MCNT.EFTD.eftCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                MCNT.EFTD.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                MCNT.EFTD.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                MCNT.EFTD.srvSucFail = "F"
                goto VAYU
        endif
        MCNT.EFTD.eftRec = 0
        print(MCNT.EFTD.eftCurNum)
        sv_z = urhk_dbCursorFetch(MCNT.EFTD.eftCurNum)
        if(sv_z!=0)then
                MCNT.EFTD.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                MCNT.EFTD.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                MCNT.EFTD.srvSucFail = "F"
                goto VAYU
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{ vploop starts
        #+++++++++++++++++
	MCNT.EFTD.srlNum = BANCS.OUTPARAM.srlNum
	MCNT.EFTD.drAcctId = BANCS.OUTPARAM.drAcctId
	MCNT.EFTD.benefAcctId = BANCS.OUTPARAM.benefAcctId
	MCNT.EFTD.benefName = BANCS.OUTPARAM.benefName
	MCNT.EFTD.benefBkBrCode = BANCS.OUTPARAM.benefBkBrCode
	MCNT.EFTD.paymentAmt = BANCS.OUTPARAM.paymentAmt
	MCNT.EFTD.paymentAmtN = BANCS.OUTPARAM.paymentAmtN
	MCNT.EFTD.purposeCode = BANCS.OUTPARAM.purposeCode
	MCNT.EFTD.TranCrncy = BANCS.OUTPARAM.TranCrncy
	MCNT.EFTD.tranCode = BANCS.OUTPARAM.tranCode
	MCNT.EFTD.additionalRef = BANCS.OUTPARAM.additionalRef
	MCNT.EFTD.bankCode = BANCS.OUTPARAM.bankCode
	MCNT.EFTD.branchcode = BANCS.OUTPARAM.branchcode
	print(MCNT.EFTD.srlNum)
	print(MCNT.EFTD.drAcctId)
	print(MCNT.EFTD.benefAcctId)
	print(MCNT.EFTD.benefName)
	print(MCNT.EFTD.benefBkBrCode)
	print(MCNT.EFTD.paymentAmt)
	print(MCNT.EFTD.paymentAmtN)
	print(MCNT.EFTD.purposeCode)
	print(MCNT.EFTD.TranCrncy)
	print(MCNT.EFTD.tranCode)
	print(MCNT.EFTD.additionalRef)
	print(MCNT.EFTD.bankCode)
	print(MCNT.EFTD.branchcode)
	lv_i = MCNT.EFTD.bankCode + "|" + MCNT.EFTD.branchcode 
	lv_r = urhk_B2k_valBankBranchCode(lv_i)
	if(lv_r == 0) then
		BANCS.INPUT.OrderingCustomerName     =  BANCS.OUTPARAM.BranchName
		print(BANCS.INPUT.OrderingCustomerName)
		BANCS.INPUT.OrderingCustomerAddress1 =  BANCS.OUTPARAM.Addr1
		print(BANCS.INPUT.OrderingCustomerAddress1)
		BANCS.INPUT.OrderingCustomerAddress2 =  BANCS.OUTPARAM.Addr2
		print(BANCS.INPUT.OrderingCustomerAddress2)
		BANCS.INPUT.OrderingCustomerAddress3 =  BANCS.OUTPARAM.CityCode
		print(BANCS.INPUT.OrderingCustomerAddress3)
	else
		lv_u = "update custom.cust_merchant_eft_tbl set process_status='F',process_desc='The branch or the bank and branch combination is invalid.',lchg_user_id=?SVAR,lchg_time=sysdate,free_text1='EFT Failed' where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and process_status='U' and dr_acct_id=?SVAR and beneficiary_acct_num=?SVAR and beneficiary_bank_br_code=?SVAR and upl_batch_id=?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.drAcctId + "|" + MCNT.EFTD.benefAcctId + "|" + MCNT.EFTD.benefBkBrCode + "|" + MCNT.EFTD.uplbatchId 
		print(lv_u)
		print(BANCS.INPARAM.BINDVARS)
		lv_p = urhk_dbSqlWithBind(lv_u)
		print(lv_p)
		exitscript
	endif
	MCNT.EFTD.paymentAmtN = MCNT.EFTD.paymentAmtN + "|" + MCNT.EFTD.TranCrncy
	print(MCNT.EFTD.paymentAmtN)

	sv_u = urhk_SetUrhkInp("ecsTranCrit.tranType|" + MCNT.EFTD.tranType)
	sv_u = urhk_SetUrhkInp("ecsTranCrit.solId.solId|" + MCNT.EFTD.solid)
	sv_u = urhk_SetUrhkInp("ecsTranCrit.paysysId.refCode|ECS")
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.custAcct.foracid|" + MCNT.EFTD.drAcctId ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.tranCode.refCode|" + MCNT.EFTD.tranCode ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.settlementDate|" + BANCS.STDIN.BODDate ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.remitAmt|" + MCNT.EFTD.paymentAmtN ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.remitCrncy|" + MCNT.EFTD.TranCrncy ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.rateCode.refCode|" + MCNT.EFTD.rateCode)
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.rate|" + MCNT.EFTD.rate)
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.chrgEventId.eventId|" + MCNT.EFTD.eventId)
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.chrgAcct.foracid|" + MCNT.EFTD.drAcctId ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.tranRmks|" + mid$(MCNT.EFTD.purposeCode,0,30) ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.netOrGrossFlg|" + MCNT.EFTD.netOrGrossFlg)
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.suspenseAcct.foracid|" + MCNT.EFTD.suspenseAcct)
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.destAcct|" + MCNT.EFTD.benefAcctId )
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.destCustName|" + mid$(MCNT.EFTD.benefName,0,35) )
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.destBankBranch.brCode|" + MCNT.EFTD.branchcode ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.destBankBranch.bankCode|" + MCNT.EFTD.bankCode ) 
	###sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText4|" + MCNT.EFTD.srlNum ) 
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText5|" + MCNT.EFTD.drAcctId ) 
	###sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText2|" + mid$(MCNT.EFTD.freeText2,0,35) )
	###sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText3|" + MCNT.EFTD.chargeamt)
	sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText1|" + MCNT.EFTD.uplbatchId ) 
	sv_u = urhk_SetUrhkOut("ecsTranCrit.refNum|refNum")
	sv_u = urhk_SetUrhkOut("ecsTranGenDet.tranId|tranId")
	sv_u = urhk_SetUrhkOut("ecsTranGenDet.tranDate|tranDate")
	sv_u = urhk_ExecSrv("SRV_AddEcsTranDtlsAndVerify|retain_all_output = Y|same_user_verify = Y")
	print(sv_u)
	if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
	       print(BANCS.OUTPARAM.successOrFailure)
		if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
			EQSRV.GLBDATA.srvAcctId = MCNT.EFTD.drAcctId + " " + MCNT.EFTD.benefAcctId + " " + MCNT.EFTD.uplbatchId
			callscriptifexist("ebsrvHandler.scr")
			if(fieldexists(EQSRV.GLBDATA.ErrorMsg)==1)then
				print(EQSRV.GLBDATA.ErrorMsg)
				lv_u = "update custom.cust_merchant_eft_tbl set process_status='F',process_desc=?SVAR,lchg_user_id=?SVAR,lchg_time=sysdate,free_text1='EFT Failed' where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and process_status='U' and dr_acct_id=?SVAR and beneficiary_acct_num=?SVAR and beneficiary_bank_br_code=?SVAR and upl_batch_id=?SVAR "
				BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.ErrorMsg + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.drAcctId + "|" + MCNT.EFTD.benefAcctId + "|" + MCNT.EFTD.benefBkBrCode + "|" + MCNT.EFTD.uplbatchId 
				print(lv_u)
				print(BANCS.INPARAM.BINDVARS)
				lv_p = urhk_dbSqlWithBind(lv_u)
				print(lv_p)
				exitscript
			endif
		endif
		if((BANCS.OUTPARAM.successOrFailure=="S") and (sv_u==0))then
			print(BANCS.OUTPARAM.refNum)
			print(BANCS.OUTPARAM.tranDate)
			print(BANCS.OUTPARAM.tranId)
			MCNT.EFTD.refNum = BANCS.OUTPARAM.refNum
			MCNT.EFTD.tranDate = BANCS.OUTPARAM.tranDate
			MCNT.EFTD.tranId = BANCS.OUTPARAM.tranId
			if((MCNT.EFTD.refNum!="") and (MCNT.EFTD.tranDate!="") and (MCNT.EFTD.tranId!=""))then
				lv_u = "update custom.cust_merchant_eft_tbl set process_status='P',process_desc='EFT Processed',process_tran_id=?SVAR,process_date=to_date(?SVAR,'DD-MM-RRRR'),lchg_user_id=?SVAR,lchg_time=sysdate,free_text1=?SVAR where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and process_status='U' and dr_acct_id=?SVAR and beneficiary_acct_num=?SVAR and beneficiary_bank_br_code=?SVAR and upl_batch_id=?SVAR "
				BANCS.INPARAM.BINDVARS = MCNT.EFTD.tranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + MCNT.EFTD.refNum + "|" + BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.drAcctId + "|" + MCNT.EFTD.benefAcctId + "|" + MCNT.EFTD.benefBkBrCode + "|" + MCNT.EFTD.uplbatchId 
				print(lv_u)
				print(BANCS.INPARAM.BINDVARS)
				lv_p = urhk_dbSqlWithBind(lv_u)
				print(lv_p)
				exitscript
			endif
		endif
	endif
                sv_u = urhk_dbCursorFetch(MCNT.EFTD.eftCurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(MCNT.EFTD.eftCurNum)
                        print(sv_u)
                        MCNT.EFTD.srvErrMsg =  "taraco Cursor Fetch Failed"
                        MCNT.EFTD.srvErrCode = "DBCursor"
                        MCNT.EFTD.srvSucFail = "F"
                        goto VAYU
                endif
                MCNT.EFTD.eftRec = cint(MCNT.EFTD.eftRec) + 1
                MCNT.EFTD.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + MCNT.EFTD.eftRec
                print(MCNT.EFTD.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(MCNT.EFTD.eftCurNum)
        print(sv_u)

VAYU:
exitscript
trace off
end-->
