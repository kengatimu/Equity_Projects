#-------------------------------------------------------------------------------------
#    Name				: s_acctxfrschmmn001.scr
#    Description     	: The script is used to validate lan scheme formula
#    Date            	: 15-11-2013
#    Author          	: Bharath
#    Called Script		: SRV_XferAcctBtwnSchms_validate_data.scr
#    Calling Script		: NA
#    Menu Option		: HACXFRSC
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0			15-11-2013		Bharath	 		Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="d6207ff1e400bc805539867b5b3a4f91a967778c2ddbfff34e57bb11e54d8eb5"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Initialize Required variables
	#------------------------------------------------------------------------------
	CUST.DATA.errMsg     = ""
	
	sv_u = urhk_SRV_GetVal("xferAcct.foracid")
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.foracid = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.foracid)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Error in finding account foracid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("xferAcct.acid")
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.acid = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.acid)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Error in finding account acid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("xferAcct.crncyCode")
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.acctCrncy = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.acctCrncy)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Error in finding account crncy"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("sourceSchm.schmCode")
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.srcSchmCode = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.srcSchmCode)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Error in finding schmCode"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("sourceSchm.schmType")
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.srcSchmType = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.srcSchmType)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Error in finding schmType"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("targetSchm.schmCode")
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.trgSchmCode = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.trgSchmCode)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Error in finding schmCode"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("targetSchm.schmType")
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.trgSchmType = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.trgSchmType)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Error in finding schmType"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
	sv_s = "solid,srcSchmType,acctCrncy,cifid|SELECT GAM.SOL_ID,GAM.schm_type,GAM.acct_crncy_code,GAM.cif_id FROM TBAADM.GAM WHERE GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND GAM.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND GAM.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.DATA.srcSchmType = BANCS.OUTPARAM.srcSchmType
		print(CUST.DATA.srcSchmType)
		CUST.DATA.acctCrncy = BANCS.OUTPARAM.acctCrncy
		print(CUST.DATA.acctCrncy)
		CUST.DATA.cifid = BANCS.OUTPARAM.cifid
		print(CUST.DATA.cifid)
		CUST.DATA.solid = BANCS.OUTPARAM.solid
		print(CUST.DATA.solid)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Invalid account Id"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF (CUST.DATA.cifid == "54314448840") THEN
	#{
		CUST.DATA.errMsg     = "Attach customer cif to the Account"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF (CUST.DATA.solid =="4777" ) THEN
                CUST.DATA.errMsg     = "ACCOUNT TRANSFER NOT ALLOWED WHILE IN 4777"
                GOTO ENDOFSCRIPT

        ENDIF

	
	IF (CUST.DATA.srcSchmType != "LAA") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = CUST.DATA.srcSchmCode + "|" + CUST.DATA.acctCrncy + "|" + BANCS.STDIN.contextBankId
	sv_s = "srcFormula|SELECT LSP.ei_formula_flg FROM TBAADM.LSP WHERE LSP.schm_code = ?SVAR "
	sv_s = sv_s + "AND LSP.crncy_code= ?SVAR AND LSP.BANK_ID = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.DATA.srcFormula = BANCS.OUTPARAM.srcFormula
		print(CUST.DATA.srcFormula)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Invalid Scheme Code for account currency"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = CUST.DATA.trgSchmCode + "|" + CUST.DATA.acctCrncy + "|" + BANCS.STDIN.contextBankId
	sv_s = "trgFormula|SELECT LSP.ei_formula_flg FROM TBAADM.LSP WHERE LSP.schm_code = ?SVAR "
	sv_s = sv_s + "AND LSP.crncy_code= ?SVAR AND LSP.BANK_ID = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.DATA.trgFormula = BANCS.OUTPARAM.trgFormula
		print(CUST.DATA.trgFormula)
		#}
	ELSE
		#{
		CUST.DATA.errMsg     = "Invalid Scheme Code for account currency"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.DATA.trgFormula != CUST.DATA.srcFormula ) THEN
	#{
		CUST.DATA.errMsg     = "Account can't be transfered between schemes with different EI Formula"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.DATA.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.DATA.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
		EXITSCRIPT
END-->
