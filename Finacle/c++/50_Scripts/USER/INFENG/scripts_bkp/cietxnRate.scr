<--START
CHECKSUM="f68004ef11c31e7eac153b467c82ef84709c3757262555d7d7d688e188fa9ae2"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#   Creating repository and class
	#   Initializing the variables
	#   Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","UPR") == 0) THEN
	#{
		CREATECLASS("CUST","UPR",5)
	#}
	ENDIF
	
	CUST.UPR.userWorkClass = BANCS.STDIN.userWorkClass
	CUST.UPR.work_classval = "240"
	CUST.UPR.errMsg = ""
	
	PRINT(CUST.UPR.work_classval)
	PRINT(CUST.UPR.userWorkClass)
	
	#----------------------------------------------------------------------------------
	# If the workclass is less or equal to 240
	#----------------------------------------------------------------------------------
	IF(CINT(CUST.UPR.userWorkClass) != CINT(CUST.UPR.work_classval)) THEN
	#{
		CUST.UPR.errMsg = "err"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_b = "SUC|Y"
	sv_z = urhk_SetOrbOut(sv_b)
	
	ENDOFSCRIPT:
		IF (CUST.UPR.errMsg != "") THEN
		#{
			sv_b = "err|" + CUST.UPR.errMsg
			sv_z = urhk_SetOrbOut(sv_b)
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
