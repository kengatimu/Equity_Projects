#-------------------------------------------------------------------------------------------------------------
#    Name            : c2b_TranValidate.scr
#    Description     : Validate Mpesa Transaction
#    Date            : 19-08-2022
#    Author          : SUNDAR
#    Input           : NA
#    Output          : NA
#    Calling Script  : NA
#    Menu Option     : C2BMN
#---------------------------------------------------------------------------------------------------------------
<--start
trace on
        sv_r=urhk_B2k_PrintRepos("BANCS")
        print (sv_r)

        if(repexists("CUST")==0)then
        #{
            createrep("CUST")
        #}
        endif

        if(classexists("CUST","MPESA")==0)then
        #{
            createclass("CUST","MPESA",5)
        #}
        endif


        CUST.MPESA.AccountNo = BANCS.INPUT.AccountNo
        CUST.MPESA.Amount = BANCS.INPUT.Amount
	CUST.MPESA.TranId = TOUPPER(BANCS.INPUT.TranId)
        CUST.MPESA.counter  = "0"
	CUST.MPESA.IsFound = "N"
	CUST.MPESA.STATUS="N"
        print(CUST.MPESA.AccountNo)
        print(CUST.MPESA.Amount)
	print (CUST.MPESA.TranId)

        CUST.MPESA.BODDate = mid$(BANCS.STDIN.BODDate,0,10)

        sv_a ="tranid,date,remarks,postedflg|select tran_id,value_date,nvl(tran_particular,'NA'),pstd_flg from tbaadm.dtd where "
        sv_a = sv_a+ " acid= (select acid from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR and del_flg='N') "
        sv_a = sv_a+ " and TRAN_PARTICULAR_2 = ?SVAR and  VALUE_DATE between to_date(?SVAR,'DD-MM-YYYY')-5 "
        sv_a = sv_a+ " and to_date(?SVAR,'DD-MM-YYYY')  and bank_id=?SVAR "
        print(sv_a)
        BANCS.INPARAM.BINDVARS=CUST.MPESA.AccountNo+"|"+BANCS.STDIN.contextBankId+"|"+CUST.MPESA.TranId+"|"+CUST.MPESA.BODDate+"|"+CUST.MPESA.BODDate+"|"+BANCS.STDIN.contextBankId 
        sv_b = urhk_dbCursorOpenWithBind(sv_a)
        Print(sv_b)
        IF(sv_b!=0) Then
        #{
                CUST.MPESA.resMsg = "No Transaction Found on Finacle End"
		CUST.MPESA.STATUS = "N"
        #}
        ENDIF
	CUST.MPESA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        sv_c = urhk_dbCursorFetch(CUST.MPESA.cursorNum)
        IF(sv_c !=0) Then
        #{
                CUST.MPESA.resMsg = "No Transaction Found on Finacle End"
		CUST.MPESA.STATUS = "N"
        #}
        ENDIF
        CUST.MPESA.tranidorg    = ""
        CUST.MPESA.dateorg              = ""
        CUST.MPESA.remarksorg   = ""
        CUST.MPESA.postedflgorg = ""
        WHILE(sv_c == 0)
        #{
                CUST.MPESA.counter = CINT(CUST.MPESA.counter)+1
                print(CUST.MPESA.counter)
                CUST.MPESA.tranid               = BANCS.OUTPARAM.tranid
                CUST.MPESA.date                 = BANCS.OUTPARAM.date
                CUST.MPESA.remarks      = BANCS.OUTPARAM.remarks
                CUST.MPESA.postedflg    = BANCS.OUTPARAM.postedflg
                print(CUST.MPESA.tranid)
                print(CUST.MPESA.date)
                print(CUST.MPESA.remarks)
                print(CUST.MPESA.postedflg)
		CUST.MPESA.IsFound = "Y"
		CUST.MPESA.STATUS = "Y"

                sv_c = urhk_dbCursorFetch(CUST.MPESA.cursorNum)
        #}
        DO
        sv_r = urhk_dbCursorClose(CUST.MPESA.cursorNum)
        Print(sv_r)

	IF(CUST.MPESA.IsFound=="N")THEN
	#{
		sv_a ="tranid,date,remarks,postedflg|select tran_id,value_date,nvl(tran_particular,'NA'),pstd_flg from tbaadm.htd where "
		sv_a = sv_a+ " acid= (select acid from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR and del_flg='N') "
		sv_a = sv_a+ " and TRAN_PARTICULAR_2 = ?SVAR and  VALUE_DATE between to_date(?SVAR,'DD-MM-YYYY')-5 "
		sv_a = sv_a+ " and to_date(?SVAR,'DD-MM-YYYY')  and bank_id=?SVAR "
		print(sv_a)
		BANCS.INPARAM.BINDVARS=CUST.MPESA.AccountNo+"|"+BANCS.STDIN.contextBankId+"|"+CUST.MPESA.TranId+"|"+CUST.MPESA.BODDate+"|"+CUST.MPESA.BODDate+"|"+BANCS.STDIN.contextBankId
		sv_b = urhk_dbCursorOpenWithBind(sv_a)
		Print(sv_b)
		IF(sv_b!=0) Then
		#{
			CUST.MPESA.resMsg = "No Transaction Found on Finacle End"
			CUST.MPESA.STATUS= "N"

		#}
		ENDIF
		CUST.MPESA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_c = urhk_dbCursorFetch(CUST.MPESA.cursorNum)
		IF(sv_c !=0) Then
		#{
			CUST.MPESA.resMsg = "No Transaction Found on Finacle End"
			CUST.MPESA.STATUS = "N"
		#}
		ENDIF
		CUST.MPESA.tranidorg    = ""
		CUST.MPESA.dateorg              = ""
		CUST.MPESA.remarksorg   = ""
		CUST.MPESA.postedflgorg = ""
		WHILE(sv_c == 0)
		#{
			CUST.MPESA.counter = CINT(CUST.MPESA.counter)+1
			print(CUST.MPESA.counter)
			CUST.MPESA.tranid               = BANCS.OUTPARAM.tranid
			CUST.MPESA.date                 = BANCS.OUTPARAM.date
			CUST.MPESA.remarks      = BANCS.OUTPARAM.remarks
			CUST.MPESA.postedflg    = BANCS.OUTPARAM.postedflg
			print(CUST.MPESA.tranid)
			print(CUST.MPESA.date)
			print(CUST.MPESA.remarks)
			print(CUST.MPESA.postedflg)
			CUST.MPESA.IsFound = "Y"
			CUST.MPESA.STATUS ="Y"

			sv_c = urhk_dbCursorFetch(CUST.MPESA.cursorNum)
		#}
		DO
		sv_r = urhk_dbCursorClose(CUST.MPESA.cursorNum)
		Print(sv_r)
	#}
	ENDIF
	IF(CUST.MPESA.STATUS=="Y")THEN
	#{
		CUST.MPESA.resMsg = CUST.MPESA.tranid+"!"+CUST.MPESA.date+"!"+CUST.MPESA.remarks+"!"+CUST.MPESA.postedflg
		lv_b = urhk_SetOrbOut("Y|" +CUST.MPESA.resMsg)
	#}
	ELSE
	#{
		lv_b = urhk_SetOrbOut("N|" +CUST.MPESA.resMsg)
	#}
	ENDIF

ENDOFSCRIPT:
EXITSCRIPT
trace off
end-->

