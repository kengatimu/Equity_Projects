<--start
trace on
#Reps/Class
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_a = urhk_MTTS_Close("")
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","XCPN")==0)then
                createclass("MTT","XCPN",5)
        endif
        if(classexists("MTT","Error")==0)then
                createclass("MTT","Error",5)
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        if(classexists("MTT","TranDetails")==0)then
                createclass("MTT","TranDetails",5)
        endif
        if(classexists("MTT","PartTranDetails")==0)then
                createclass("MTT","PartTranDetails",5)
        endif
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                EQSRV.GLBDATA.trSting = MTT.InputDetails.Argument1
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.DrAcctNum  = mid$(sv_f,0,(sv_p-1))
                #--
                EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.benefName  = mid$(sv_f,0,(sv_p-1))
                #--
                EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.benefBank  = mid$(sv_f,0,(sv_p-1))
                #--
                EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.benefBranch  = mid$(sv_f,0,(sv_p-1))
                #--
                EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.benefAcct  = mid$(sv_f,0,(sv_p-1))
                #--
                EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.tranAmt  = mid$(sv_f,0,(sv_p-1))
                #--
                EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.tranRemks  = mid$(sv_f,0,(sv_p-1))
                #--
                EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.uplSol  = mid$(sv_f,0,(sv_p-1))
		#--
		EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.trSting)
                sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.uplRefNum  = mid$(sv_f,0,(sv_p-1))
                EQSRV.GLBDATA.ChargeAmt = mid$(sv_f,sv_p,sv_l)
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        endif

	EQSRV.GLBDATA.bankID =BANCS.STDIN.contextBankId
	EQSRV.GLBDATA.channelID = "COR"
	EQSRV.GLBDATA.startdate = MID$(BANCS.STDIN.BODDate,0,10)
	EQSRV.GLBDATA.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
	EQSRV.GLBDATA.CRNCY  ="KES"
	EQSRV.GLBDATA.RATE_CODE ="MEAN"
	print(EQSRV.GLBDATA.ChargeAmt)
	if (cdouble(EQSRV.GLBDATA.ChargeAmt)>0) then
		EQSRV.GLBDATA.WAIVE  ="N"
	else
		EQSRV.GLBDATA.WAIVE  ="Y"
	endif
	EQSRV.GLBDATA.CHRG_AMT  ="0"

	sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0) then
		EQSRV.GLBDATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
		print(EQSRV.GLBDATA.msgDateTime)
	endif
	sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0)then
		EQSRV.GLBDATA.RequestID1 = BANCS.OUTPARAM.RequestID
		print(EQSRV.GLBDATA.RequestID1)
	else
		EQSRV.GLBDATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(EQSRV.GLBDATA.RequestID1)
	endif
	EQSRV.GLBDATA.headerXML = ""
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Header>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RequestHeader>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<MessageKey>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RequestUUID>"+ EQSRV.GLBDATA.RequestID1 +"</RequestUUID>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<ServiceRequestId>executeFinacleScript</ServiceRequestId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<ChannelId>" + EQSRV.GLBDATA.channelID + "</ChannelId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</MessageKey>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RequestMessageInfo>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<BankId>" + EQSRV.GLBDATA.bankID + "</BankId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<TimeZone>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</TimeZone>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<EntityId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</EntityId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<EntityType>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</EntityType>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<MessageDateTime>" + EQSRV.GLBDATA.msgDateTime + "</MessageDateTime>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RequestMessageInfo>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Security>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Token>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<PasswordToken>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<UserId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</UserId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Password>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Password>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</PasswordToken>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Token>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<FICertToken>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</FICertToken>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUserLoginSessionId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RealUserLoginSessionId>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUser>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RealUser>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUserPwd>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RealUserPwd>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<SSOTransferToken>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</SSOTransferToken>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Security>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RequestHeader>"
	EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Header>"

	EQSRV.GLBDATA.bodyXMLMsg = ""
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Body>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<executeFinacleScriptRequest>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<ExecuteFinacleScriptInputVO>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<requestId>EftAdd</requestId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</ExecuteFinacleScriptInputVO>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<executeFinacleScript_CustomData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<remitCrncy>" + EQSRV.GLBDATA.CRNCY  + "</remitCrncy>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<rate>1.0</rate>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<destCustName>" + EQSRV.GLBDATA.benefName  + "</destCustName>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<destAcct>" + EQSRV.GLBDATA.benefAcct  + "</destAcct>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<eventId>PLEFT</eventId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<foracid>" + EQSRV.GLBDATA.DrAcctNum + "</foracid>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<tranCode>58</tranCode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<amount>" + EQSRV.GLBDATA.tranAmt + "</amount>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<bankCode>" + EQSRV.GLBDATA.benefBank + "</bankCode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<solid>" + EQSRV.GLBDATA.uplSol + "</solid>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<rateCode>" +EQSRV.GLBDATA.RATE_CODE + "</rateCode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<brCode>" + EQSRV.GLBDATA.benefBranch + "</brCode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<waiveflg>" + EQSRV.GLBDATA.WAIVE + "</waiveflg>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<chargecrny>" + EQSRV.GLBDATA.CRNCY  + "</chargecrny>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<chargeamt>" + EQSRV.GLBDATA.CHRG_AMT  + "</chargeamt>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<freeText2>PSA</freeText2>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</executeFinacleScript_CustomData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</executeFinacleScriptRequest>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</Body>"

	EQSRV.GLBDATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "<FIXML>"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.headerXML 
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.bodyXMLMsg
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "</FIXML>"

	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	print(BANCS.INPARAM.SERVICE_NAME)
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	sv_a = EQSRV.GLBDATA.reqXMLMsg
	print(sv_a)

	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	if (sv_l != 0) then
		print(BANCS.OUTPARAM.ErrMsg)
		EQSRV.GLBDATA.errorMsgFlg = "Y"
		EQSRV.GLBDATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		EQSRV.GLBDATA.errorMsgCode = "FIERR"  
		GOTO ENDOFSCRIPT
	endif
	if (BANCS.OUTPARAM.ErrMsg != "") then
	#{
		EQSRV.GLBDATA.errorMsgFlg = "Y"
		EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
		EQSRV.GLBDATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg 
		EQSRV.GLBDATA.errorMsgCode = "FIERR" 
		GOTO ENDOFSCRIPT
	else
		EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
		print(EQSRV.GLBDATA.respXMLMsg)
		EQSRV.GLBDATA.errorMsgFlg = ""
		EQSRV.GLBDATA.errorMsgDesc = ""
		EQSRV.GLBDATA.errorCode = ""
		EQSRV.GLBDATA.errorDesc = ""
		sv_x = EQSRV.GLBDATA.respXMLMsg

		sv_y = "<Status>"
		sv_z = "</Status>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		if (GETPOSITION(sv_x, sv_y) != 0) then
			EQSRV.GLBDATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		else
			EQSRV.GLBDATA.tranStatus = ""
		endif
		print(EQSRV.GLBDATA.tranStatus)
		if (EQSRV.GLBDATA.tranStatus =="SUCCESS")  then
		#{
			EQSRV.GLBDATA.errorMsgFlg = "N"
			sv_x = EQSRV.GLBDATA.respXMLMsg
			sv_y = "<TranId>"
			sv_z = "</TranId>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			if (GETPOSITION(sv_x, sv_y) != 0) then
				EQSRV.GLBDATA.TranId = MID$(sv_x, sv_b, (sv_e - sv_b))
				print(EQSRV.GLBDATA.TranId)
			endif
			sv_s = "update custom.plmt  "
			sv_s = sv_s + " set process_staus  = 'TFE', core_tran_id = ?SVAR"
			sv_s = sv_s + " where benef_account_num = ?SVAR  and  tran_amt  = ?SVAR   "
			sv_s = sv_s + " and bank_id = ?SVAR and process_staus ='EFT'   and upl_ref_num=?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.TranId + "|" + EQSRV.GLBDATA.benefAcct + "|" +  EQSRV.GLBDATA.tranAmt  + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.uplRefNum 
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSQLWithBind(sv_s)
			if (sv_d == 0) then
				sv_c = urhk_dbSQLWithBind("commit")
				print(sv_c)
			endif
	
		else
			EQSRV.GLBDATA.errorMsgFlg = "Y"
			if(EQSRV.GLBDATA.tranStatus != "SUCCESS") then
				sv_x = EQSRV.GLBDATA.respXMLMsg
				sv_y = "<ErrorCode>"
				sv_z = "</ErrorCode>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				if (GETPOSITION(sv_x, sv_y) != 0) then
					EQSRV.GLBDATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
				endif
				sv_x = EQSRV.GLBDATA.respXMLMsg
				sv_y = "<ErrorDesc>"
				sv_z = "</ErrorDesc>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				if (GETPOSITION(sv_x, sv_y) != 0) then
					EQSRV.GLBDATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
				endif
				if((EQSRV.GLBDATA.errorCode == "") AND (EQSRV.GLBDATA.errorDesc == "")) then
					EQSRV.GLBDATA.errorCode = "SYSERR"
					EQSRV.GLBDATA.errorDesc = "Could not get response from server"
				endif
				sv_s = "update custom.plmt  "
				sv_s = sv_s + " set process_staus  = 'ERR',free_text2 =?SVAR  "
				sv_s = sv_s + " where benef_account_num = ?SVAR  and  tran_amt  = ?SVAR  "
				sv_s = sv_s + " and bank_id = ?SVAR and process_staus ='EFT'  and upl_ref_num=?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.errorDesc + "|" + EQSRV.GLBDATA.benefAcct + "|" +  EQSRV.GLBDATA.tranAmt  + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.uplRefNum
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSQLWithBind(sv_s)
				if (sv_d == 0) then
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				endif
			endif
		#}
		endif
				if((EQSRV.GLBDATA.errorCode == "") AND (EQSRV.GLBDATA.errorDesc == "")) then
					EQSRV.GLBDATA.errorCode = "SYSERR"
					EQSRV.GLBDATA.errorDesc = "Could not get response from server"
				endif
	#}
	endif
exitscript
trace off
end-->
