#-------------------------------------------------------------------------------------    
#	Name		: ast0057dp002.scr
#	Description	: This script is used for Calculating whether total outstnding amt
#			: is greater than disbursement amount in HLADISB menu
#	Date		: 13-06-2013
#	Author		: Prashanth
#	Input		: NA
#	Output		: NA
#	Called JSP	: ladisb_tran_details_custom.jsp
#	Calling Script	:
#	Menu Option	:
#	Srl. No		Date			Author			Description.
#	-------		----			------			----------------
#	1.0			13-06-2013		Prashanth		Original Version
#	2.0			26-06-2013		Prashanth		Made logical changes in the script
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="9d95aad74bdbc781c79efd116e7d5c88381f04f7852da1f59b1d0737244cef2f"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	#	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_u = urhk_Setorbout("Error|dummy")
	CUST.LADISB.errMsg       	= ""
	CUST.LADISB.countt 	    	= "0"
	CUST.LADISB.newLoanForacid	= TOUPPER(BANCS.INPUT.foracid)
	CUST.LADISB.disbamount1		= BANCS.INPUT.disbamount1
	print(CUST.LADISB.disbamount1)
	CUST.LADISB.totOsAmt = 0
	
	sv_s = ""
	sv_s = sv_s + "disbAmt1|SELECT REPLACE(?SVAR "
	sv_s = sv_s + ",',','') FROM DUAL"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.disbamount1
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in removing ','"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.disbAmt1= CDOUBLE(BANCS.OUTPARAM.disbAmt1)
		print(BANCS.OUTPARAM.disbAmt1)
	#}
	ENDIF
	#--------------------------------------------------------------------
	#Getting new loan account currency code
	#--------------------------------------------------------------------
	sv_s = ""
	sv_s = "newLoanCrncyCode|SELECT GAM.acct_crncy_code "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE GAM.foracid = ?SVAR "
	sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
	sv_s = sv_s + "AND GAM.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y'"
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.newLoanForacid + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in calculating new loan account currency code"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.newLoanCrncyCode= BANCS.OUTPARAM.newLoanCrncyCode
		print(BANCS.OUTPARAM.newLoanCrncyCode)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	#Getting rateCode from CPARAM values--'NOR'
	#-----------------------------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	print(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.LADISB.limitRateCode = BANCS.OUTPUT.parameterVal
		print(CUST.LADISB.limitRateCode)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "NORRATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#--------------------------------------------------------------------
	#getting scheme code
	#--------------------------------------------------------------------
	sv_s = ""
	sv_s = "schmCode|SELECT GAM.schm_code "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE GAM.foracid = ?SVAR "
	sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
	sv_s = sv_s + "AND GAM.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.newLoanForacid + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in calculating schm code"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.schmCode= BANCS.OUTPARAM.schmCode
		print(BANCS.OUTPARAM.schmCode)
	#}
	ENDIF
	
	sv_a = 1
	#---------------------------------------------------------------
	#getting old loan account number and currrency code
	#---------------------------------------------------------------
	sv_s = ""
	sv_s = "oldForacid,oldAccntCrncyCode|"
	sv_s = sv_s + " SELECT GAM.foracid,GAM.acct_crncy_code"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE GAM.schm_code = ?SVAR"
	sv_s = sv_s + " AND GAM.cif_id = ("
	sv_s = sv_s +			   " SELECT GAM.cif_id"
	sv_s = sv_s +	           " FROM TBAADM.GAM"
	sv_s = sv_s +			   " WHERE GAM.foracid = ?SVAR"
	sv_s = sv_s +			   " AND GAM.bank_id = ?SVAR"
	sv_s = sv_s +			   " AND GAM.acct_cls_flg = 'N'"
	sv_s = sv_s +			   " AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s + 			   " AND GAM.del_flg = 'N')"
	sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
	sv_s = sv_s + " AND GAM.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	sv_s = sv_s + " AND GAM.foracid != ?SVAR"
	sv_s = sv_s + " AND GAM.clr_bal_amt != 0"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.schmCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.newLoanForacid  + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.newLoanForacid
	print(BANCS.INPARAM.BINDVARS)
	
	print(BANCS.INPARAM.BINDVARS)
	sv_d  = urhk_dbcursorOpenWithBind(sv_s)
	print(sv_d)
	
	IF( sv_d != 0) THEN
	#{
		CUST.LADISB.errMsg = "No records fetched for the entered Account Number"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		
		WHILE( sv_c == 0)
		#{
			print(sv_a)
			CUST.LADISB.oldForacid=BANCS.OUTPARAM.oldForacid
			print(CUST.LADISB.oldForacid)
			
			CUST.LADISB.oldAccntCrncyCode = BANCS.OUTPARAM.oldAccntCrncyCode
			print(CUST.LADISB.oldAccntCrncyCode)
			
			#--------------------------------------------------------------------------------------
			# getting Int route flag from LAM table
			#--------------------------------------------------------------------------------------
			sv_s = ""
			sv_s = sv_s + " intRoute|"
			sv_s = sv_s + " SELECT LAM.int_route_flg"
			sv_s = sv_s + "	FROM TBAADM.LAM"
			sv_s = sv_s + " WHERE LAM.acid ="
			sv_s = sv_s + 			" (SELECT GAM.ACID"
			sv_s = sv_s + 			" FROM TBAADM.GAM"
			sv_s = sv_s + 			" WHERE GAM.FORACID = ?SVAR"
			sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
			sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
			sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
			sv_s = sv_s + 			" AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.del_flg='N'"
			sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			
			print(sv_s)
			BANCS.INPARAM.BINDVARS = ""
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldForacid + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
			
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			
			IF ( sv_d != 0 ) THEN
			#{
				CUST.LADISB.errMsg = "Error occured in calculating old Loan O/S amount"
				print(CUST.LADISB.errMsg)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.LADISB.intRoute = BANCS.OUTPARAM.intRoute
				print(CUST.LADISB.intRoute)
			#}
			ENDIF
			
			#--------------------------------------------------------------------------------------
			#getting total outstanding amount except new loan a/c under same scheme code and cifId
			#--------------------------------------------------------------------------------------
			IF(CUST.LADISB.intRoute == "L") THEN
			#{
				sv_s = ""
				sv_s = sv_s + " outStndAmt|"
				sv_s = sv_s + " SELECT (nvl(GAM.clr_bal_amt,0)"
				sv_s = sv_s + " +nvl((EIT.nrml_interest_amount_dr"
				sv_s = sv_s + " - EIT.nrml_booked_amount_dr),0)"
				sv_s = sv_s + " +nvl((EIT.penal_interest_amount_dr"
				sv_s = sv_s + " - EIT.penal_booked_amount_dr),0))"
				sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.EIT"
				sv_s = sv_s + " WHERE GAM.schm_code = ?SVAR"
				sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
				sv_s = sv_s + " AND GAM.del_flg = 'N'"
				sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
				sv_s = sv_s + " AND GAM.foracid = ?SVAR"
				sv_s = sv_s + " AND EIT.entity_id = GAM.ACID"
				sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
				sv_s = sv_s + " AND EIT.bank_id = GAM.bank_id"
				
				print(sv_s)
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.schmCode + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldForacid
				
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				print(sv_d)
				
				IF ( sv_d != 0 ) THEN
				#{
					CUST.LADISB.errMsg = "Error occured in calculating old Loan O/S amount"
					print(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CUST.LADISB.outStndAmt= CDOUBLE(BANCS.OUTPARAM.outStndAmt)
					print(CUST.LADISB.outStndAmt)
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_s = ""
				sv_s = sv_s + " outStndAmt|"
				sv_s = sv_s + " SELECT (nvl(gam.clr_bal_amt,0)"
				sv_s = sv_s + " +nvl((EIT.nrml_interest_amount_dr"
				sv_s = sv_s + " - EIT.nrml_booked_amount_dr),0)"
				sv_s = sv_s + " +nvl((EIT.penal_interest_amount_dr"
				sv_s = sv_s + " - EIT.penal_booked_amount_dr),0)"
				sv_s = sv_s + " + nvl(LAM.INT_DMD_OS,0) "
				sv_s = sv_s + " + nvl(LAM.BCHG_DMD_OS,0)"
				sv_s = sv_s + " + nvl(LAM.OCHG_DMD_OS,0))"
				sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.EIT,TBAADM.LAM"
				sv_s = sv_s + " WHERE GAM.schm_code = ?SVAR"
				sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
				sv_s = sv_s + " AND GAM.del_flg = 'N'"
				sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
				sv_s = sv_s + " AND GAM.foracid = ?SVAR"
				sv_s = sv_s + " AND EIT.entity_id = GAM.ACID"
				sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
				sv_s = sv_s + " AND EIT.bank_id = GAM.bank_id"
				sv_s = sv_s + " AND LAM.acid = GAM.acid"
				sv_s = sv_s + " AND LAM.del_flg='N'"
				sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
				
				print(sv_s)
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.schmCode + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldForacid + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				print(sv_d)
				
				IF ( sv_d != 0 ) THEN
				#{
					CUST.LADISB.errMsg = "Error occured in calculating old Loan O/S amount"
					print(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CUST.LADISB.outStndAmt= CDOUBLE(BANCS.OUTPARAM.outStndAmt)
					print(CUST.LADISB.outStndAmt)
				#}
				ENDIF
			#}
			ENDIF
			
			IF(CDOUBLE(CUST.LADISB.outStndAmt) < 0) THEN
			#{
				CUST.LADISB.outStndAmt = -1 * CDOUBLE(CUST.LADISB.outStndAmt)
				print(CUST.LADISB.outStndAmt)
			#}
			ENDIF
			
			#--------------------------------
			# for testing
			#--------------------------------
			#CUST.LADISB.newLoanCrncyCode = "USD"
			
			#------------------------------------------------------------------------------
			#	If currency codes are different, Convert Amount
			#------------------------------------------------------------------------------
			IF(CUST.LADISB.oldAccntCrncyCode != CUST.LADISB.newLoanCrncyCode) THEN
			#{
				BANCS.INPARAM.InputAmount = CUST.LADISB.outStndAmt
				BANCS.INPARAM.FromCurrency = CUST.LADISB.oldAccntCrncyCode
				BANCS.INPARAM.ToCurrency = CUST.LADISB.newLoanCrncyCode
				BANCS.INPARAM.RateCode = CUST.LADISB.limitRateCode
				BANCS.INPARAM.Rate = 0.00
				BANCS.INPARAM.CustId = ""
				
				sv_u = urhk_B2k_ConvertAmount("")
				print(sv_u)
				
				IF(sv_u == 0)THEN
				#{
					CUST.LADISB.oldAcntConvOsAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
					print(CUST.LADISB.oldAcntConvOsAmt)
					
					IF(CDOUBLE(CUST.LADISB.oldAcntConvOsAmt) < 0) THEN
					#{
						CUST.LADISB.oldAcntConvOsAmt = -1 * CDOUBLE(CUST.LADISB.oldAcntConvOsAmt)
						print(CUST.LADISB.oldAcntConvOsAmt)
						#}
					ELSE
						#{
						print(CUST.LADISB.oldAcntConvOsAmt)
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.LADISB.errMsg = "Error occured in converting the Amount"
					print(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.LADISB.oldAcntConvOsAmt = CUST.LADISB.outStndAmt
				print(CUST.LADISB.oldAcntConvOsAmt)
			#}
			ENDIF
			
			CUST.LADISB.totOsAmt = CDOUBLE(CUST.LADISB.totOsAmt) + CDOUBLE(CUST.LADISB.oldAcntConvOsAmt)
			print(CUST.LADISB.totOsAmt)
			sv_a = sv_a + 1
			
			sv_c = urhk_dbCursorFetch(sv_l)
			print(sv_c)
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
	#}
	ENDIF
	
	print(CUST.LADISB.disbAmt1)
	print(CUST.LADISB.totOsAmt)
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "") THEN
		#{
			sv_u = urhk_Setorbout("Error|" + CUST.LADISB.errMsg)
			#}
		ELSE
			#{
			IF(CDOUBLE(CUST.LADISB.disbAmt1) >= CDOUBLE(CUST.LADISB.totOsAmt)) THEN
			#{
				CUST.LADISB.flagg = "Y"
				sv_u = urhk_Setorbout("flagg|" + CUST.LADISB.flagg)
				print(CUST.LADISB.disbAmt1)
				print(CUST.LADISB.totOsAmt)
				#}
				
				#}
			ELSE
				#{
				CUST.LADISB.flagg = "N"
				sv_u = urhk_Setorbout("flagg|" + CUST.LADISB.flagg)
				print(CUST.LADISB.disbAmt1)
				print(CUST.LADISB.totOsAmt)
			#}
			ENDIF
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
END-->
