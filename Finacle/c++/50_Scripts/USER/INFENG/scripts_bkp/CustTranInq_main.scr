#----------------------------------------------------------------------------------------------------------
# Filename              :       CustTranInq_main.scr
# Author                :       Eshan Babbar
# Description           :       This script gets called from FI url executeFinacleScript and displays the 
#                               Transaction details.
# Input                 :       Request XML
# Output                :       Response XML
# Called Script         :       Common_Interface_CreateRepos.scr, CustTranInq_FetchAndValInpDtls.scr,
#                               CustTranInq_GetTranDtlsAndSendResp.scr
# Calling Script        :       None                                                            
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           14-03-2013         Eshan Babbar      Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
TRACE ON
#========================================================	
# Create Repository
#========================================================
CALL("Common_Interface_CreateRepos.scr")

#========================================================	
# Initialization
#========================================================
CUST.INTERFACE.successOrFailure="S"

#========================================================	
# Calling script for validating the inputs
#========================================================

CALL("CustTranInq_FetchAndValInpDtls.scr")

#========================================================	
# Calling script to Get the details as a part of response
#========================================================

CALL("CustTranInq_GetTranDtlsAndSendResp.scr")

#========================================================	
# Error Handling
#========================================================
ERROREXIT:
	IF(CUST.INTERFACE.successOrFailure=="F")THEN
	#{
		CUST.INTERFACE.srvErrFlg="N"
		CALL("Common_Interface_ErrorExit.scr")
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF


ENDOFSCRIPT:
TRACE OFF
EXITSCRIPT
end-->
