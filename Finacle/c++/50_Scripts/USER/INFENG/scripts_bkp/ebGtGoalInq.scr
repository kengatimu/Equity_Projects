#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Name                   : ebGtGoalInq.scr 
#   Date                   : 19-Jul-2019
#   Description            :
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
	EQGTG.GLBDATA.GoalAccountId = ""
	EQGTG.GLBDATA.goalCrncy = ""
	EQGTG.GLBDATA.gSourceAcct = ""
	EQGTG.GLBDATA.gGoalMonths = ""
	EQGTG.GLBDATA.gGoalDays = ""
	EQGTG.GLBDATA.gPayoutDays = ""
	EQGTG.GLBDATA.gExpiryDate = ""
	EQGTG.GLBDATA.cgMobileNumber = "XXXXXXXXXX"
	if(fieldexists(BANCS.INPUT.GoalAccountId)==1)then
		EQGTG.GLBDATA.GoalAccountId = BANCS.INPUT.GoalAccountId	
	else
		EQGTG.GLBDATA.GoalAccountId = ""
	endif
	if(EQGTG.GLBDATA.GoalAccountId == "")then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Invalid Goal Account " + EQGTG.GLBDATA.GoalAccountId ) 
		exitscript
	else
		sv_u = urhk_getAcctDetailsInRepository(EQGTG.GLBDATA.GoalAccountId)
		if(sv_u==0)then
			EQGTG.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance	
			EQGTG.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt
			EQGTG.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
			EQGTG.GLBDATA.goalCrncy = BANCS.OUTPARAM.acctCrncyCode
			EQGTG.GLBDATA.goalSchmType = BANCS.OUTPARAM.schmType
			sv_u = urhk_B2k_ForacidToAcid(EQGTG.GLBDATA.GoalAccountId)
			if(sv_u==0)then
				EQGTG.GLBDATA.goalacid = BANCS.OUTPARAM.Acid	
			else
				sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
				sv_u = urhk_SetOrbOut("Message|Invalid Goal Account " + EQGTG.GLBDATA.GoalAccountId ) 
				exitscript
			endif
		else
			sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
			sv_u = urhk_SetOrbOut("Message|Invalid Goal Account " + EQGTG.GLBDATA.GoalAccountId ) 
			exitscript
		endif
	endif
        sv_u = urhk_getAdvanceDetailsForAccount(EQGTG.GLBDATA.GoalAccountId)
        if(sv_u==0)then
                EQGTG.GLBDATA.gSourceAcct = BANCS.OUTPARAM.gacFreeText1
                EQGTG.GLBDATA.gGoalMonths = BANCS.OUTPARAM.gacFreeText2
                EQGTG.GLBDATA.gGoalDays = BANCS.OUTPARAM.gacFreeText3
                EQGTG.GLBDATA.gPayoutDays = BANCS.OUTPARAM.gacFreeText4
                EQGTG.GLBDATA.gdummyExpiryDate = BANCS.OUTPARAM.gacFreeText5
                EQGTG.GLBDATA.gAprYN = BANCS.OUTPARAM.gacFreeText7
                EQGTG.GLBDATA.gOctYN = BANCS.OUTPARAM.gacFreeText8
                EQGTG.GLBDATA.gActiveDate = BANCS.OUTPARAM.gacFreeText9
                EQGTG.GLBDATA.gExpiryDate = BANCS.OUTPARAM.gacFreeText10
                EQGTG.GLBDATA.gMobileNumber = BANCS.OUTPARAM.gacFreeText11
                if(EQGTG.GLBDATA.gSourceAcct != "")then
                        sv_u = urhk_getAcctDetailsInRepository(EQGTG.GLBDATA.gSourceAcct)
                        if(sv_u!=0)then
                                EQGTG.GLBDATA.valerr    = "Invalid SOurce Account for Goal " + EQGTG.GLBDATA.GoalAccountId
                                EQGTG.GLBDATA.scrValYN     = "N"
                                goto VAYU
                        endif
                endif
        else
                EQGTG.GLBDATA.valerr    = "Invalid Goal Account " + EQGTG.GLBDATA.GoalAccountId
                EQGTG.GLBDATA.scrValYN     = "N"
                goto VAYU
        endif
	

	sv_u = urhk_SetOrbOut("SuccessOrFailure|S")	
	if(EQGTG.GLBDATA.GoalAccountId!="")then
		sv_u = urhk_SetOrbOut("GoalAccountId|" + EQGTG.GLBDATA.GoalAccountId )
	endif
	if(EQGTG.GLBDATA.goalCrncy!="")then
		sv_u = urhk_SetOrbOut("GoalCurrency|" + EQGTG.GLBDATA.goalCrncy )
	endif
	if(EQGTG.GLBDATA.gSourceAcct!="")then
		sv_u = urhk_SetOrbOut("SourceAcctId|" + EQGTG.GLBDATA.gSourceAcct ) 
	endif
	if(cdouble(EQGTG.GLBDATA.clearBalance)>0)then
		sv_u = urhk_SetOrbOut("GoalAvailableBalance|" + EQGTG.GLBDATA.clearBalance ) 
	else
		sv_u = urhk_SetOrbOut("GoalAvailableBalance|0.00")
	endif
	if(EQGTG.GLBDATA.gGoalMonths!="")then
		sv_u = urhk_SetOrbOut("GoalPeriodMonths|" + EQGTG.GLBDATA.gGoalMonths ) 
	endif
	if(EQGTG.GLBDATA.gGoalDays!="")then
		sv_u = urhk_SetOrbOut("GoalPeriodDays|" + EQGTG.GLBDATA.gGoalDays ) 
	endif
	if(EQGTG.GLBDATA.gPayoutDays!="")then
		sv_u = urhk_SetOrbOut("SalaryPayoutDays|" + EQGTG.GLBDATA.gPayoutDays )
	endif
	if(EQGTG.GLBDATA.gExpiryDate!="")then
		sv_u = urhk_SetOrbOut("GoalExpiryDate|" + EQGTG.GLBDATA.gExpiryDate ) 
	endif
	if(EQGTG.GLBDATA.gMobileNumber!="")then
		sv_u = urhk_SetOrbOut("GoalMobileNumber|" + EQGTG.GLBDATA.gMobileNumber )
	else
		sv_u = urhk_SetOrbOut("GoalMobileNumber|" + EQGTG.GLBDATA.cgMobileNumber )
	endif
	if(EQGTG.GLBDATA.gAprYN != "")then
		sv_u = urhk_SetOrbOut("BonusMonthYear|" + EQGTG.GLBDATA.gAprYN )
	endif
	if(EQGTG.GLBDATA.gOctYN != "")then
		sv_u = urhk_SetOrbOut("BonusMonthYear|" + EQGTG.GLBDATA.gOctYN )
	endif
	exitscript
trace off
end-->
