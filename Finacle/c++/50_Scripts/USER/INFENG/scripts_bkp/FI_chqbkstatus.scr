				CUST.DATA.NofBooks=BANCS.OUTPARAM.NofBooks
				print(CUST.DATA.NofBooks)
				CUST.DATA.Nofchqlvs=BANCS.OUTPARAM.Nofchqlvs
				print(CUST.DATA.Nofchqlvs)
				CUST.DATA.BegChqinNo=BANCS.OUTPARAM.BegChqinNo
				print(CUST.DATA.BegChqinNo)
				CUST.DATA.EndChqNo=BANCS.OUTPARAM.EndChqNo
				print(CUST.DATA.EndChqNo)
				CUST.DATA.Descstatus=BANCS.OUTPARAM.Descstatus
				print(CUST.DATA.Descstatus)
				CUST.DATA.DateRequested=BANCS.OUTPARAM.DateRequested
				print(CUST.DATA.DateRequested)
		
			print("printing the values in the request")
		 sv_u = urhk_SetOrbOut("BRANCHID|"+ CUST.DATA.BranchId)
		 sv_u = urhk_SetOrbOut("ACCTNO|"+ CUST.DATA.Accountnumber)
		 sv_u = urhk_SetOrbOut("ACCOUNTNAME|"+ CUST.DATA.Accountname)
		 sv_u = urhk_SetOrbOut("REQUESTID|"+ CUST.DATA.ChqRequestId)
