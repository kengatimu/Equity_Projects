		 sv_u = urhk_SetOrbOut("NOOFCHQLVS|"+  CUST.DATA.Nofchqlvs)
         		 sv_u = urhk_SetOrbOut("CHQBEGINNO|"+ CUST.DATA.BegChqinNo)
		 sv_u = urhk_SetOrbOut("CHQENDNO|"+ CUST.DATA.EndChqNo)        
        	 	 sv_u = urhk_SetOrbOut("STATUS|"+ CUST.DATA.Reqstatus)
         		 sv_u = urhk_SetOrbOut("STTUSDESCRIPTION|"+ CUST.DATA.Descstatus)
		 sv_u = urhk_SetOrbOut("DATEREQUESTED|"+ CUST.DATA.DateRequested)		
