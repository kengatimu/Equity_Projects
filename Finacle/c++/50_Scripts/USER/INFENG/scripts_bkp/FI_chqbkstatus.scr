		print(CUST.DATA.foracid)
		print(CUST.DATA.RequestId)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.RequestId+"|"+CUST.DATA.foracid +"|"+BANCS.STDIN.contextBankId
		sv_d = "ChqRequestId, BranchId, Accountnumber, Accountname, NofBooks, Nofchqlvs, BegChqinNo, EndChqNo, Reqstatus,Descstatus, DateRequested|SELECT "
		sv_d = sv_d + "req_id, branch_id,c.foracid,g.acct_name, c.NUM_OF_CHB ,c.NUM_OF_CHQ_LVS, begin_chq_num,(begin_chq_num+num_of_chq_lvs-1)end_chq_num ,req_status, "
		sv_d = sv_d+ " decode(req_status, 'D' ,'Destroyed','A', 'Issued', 'S', 'Sent', 'E', 'Requested')ChqBookStatus ,req_date  "
		sv_d = sv_d + " FROM custom.custom_cbr  c, tbaadm.gam g  where g.foracid=c.foracid AND c.del_flg ='N' AND c.req_id=?SVAR AND c.foracid= ?SVAR  AND c.bank_id=?SVAR "
		PRINT(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_d)
		IF(sv_b==0)then
		#{
				CUST.DATA.Reqstatus = BANCS.OUTPARAM.Reqstatus
