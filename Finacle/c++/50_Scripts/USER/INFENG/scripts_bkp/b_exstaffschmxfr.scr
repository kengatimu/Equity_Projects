	ENDIF
	
	sv_o=BANCS.STDIN.BODDate
	print(sv_o)

	sv_b = BANCS.STDIN.mySolId
	print(sv_b)

		sv_a="foracid,empid | select a.foracid, emp_id  from custom.int_change a , tbaadm.gam " 
