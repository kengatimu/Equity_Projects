<--START
CHECKSUM="b6285f794d2b8580d7e0595c68cab4e11614030c4512294f49df0b4a4fdaf2d9"
	TRACE ON
	#------------------------------------------------------------------------------
	# Logically Undeleting the records in table C_MDNM.
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = "N"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.userId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "Y"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncyCode + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "UPDATE CUSTOM.C_MDNM SET "
	sv_s = sv_s + " DEL_FLG = ?SVAR,"
	sv_s = sv_s + " LCHG_USER_ID = ?SVAR,"
	sv_s = sv_s + " LCHG_TIME = SYSDATE "
	sv_s = sv_s + " WHERE DEL_FLG = ?SVAR"
	sv_s = sv_s + " AND CRNCY_CODE = ?SVAR AND bank_id = ?SVAR"
	print(sv_s)
	sv_d = urhk_dbSQLWithBind(sv_s)
	print(sv_d)
	IF (sv_d != 0) THEN
	#{
		# throwing error
		#CUST.DENOM.errorMsg = "Oracle Error - Try after sometime."
		CUST.INTERFACE.errorCode = "DENOM_ERR_002"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "abc"
		CUST.DENOM.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	# setting message for result page
	CUST.DENOM.resultPageMsg = "Denomination details are retrieved successfully"
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
END-->
