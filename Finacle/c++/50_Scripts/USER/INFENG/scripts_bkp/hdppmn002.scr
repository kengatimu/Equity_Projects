##hdppmn002.scr
<--start
trace on
        if(repexists("EQSRV") == 0) then
            createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0)then
            createclass("EQSRV","GLBDATA",5)
        endif
	EQSRV.GLBDATA.acctNo = TRIM(BANCS.INPUT.acctNo)
	print(EQSRV.GLBDATA.acctNo)
	EQSRV.GLBDATA.gacFreeText19 = ""
	EQSRV.GLBDATA.consStat1 = "N"
	EQSRV.GLBDATA.consStat2 = "N"
	EQSRV.GLBDATA.consStat3 = "N"
	EQSRV.GLBDATA.consStat4 = "N"
	#sv_u = urhk_getAdvanceDetailsForAccount(EQSRV.GLBDATA.acctNo)
	#if(sv_u==0)then
	#	if(fieldexists(BANCS.OUTPARAM.gacFreeText15)==1)then
	#		EQSRV.GLBDATA.gdprVal = BANCS.OUTPARAM.gacFreeText19
	#	else
	#		EQSRV.GLBDATA.gdprVal = "N"
	#	endif
	#else
	#	EQSRV.GLBDATA.gdprVal = "N"
	#endif
	sv_d = "gdprVal | select free_text_19 from tbaadm.gac "
	sv_d = sv_d + " where acid in (select acid from tbaadm.gam where foracid='"+EQSRV.GLBDATA.acctNo+"' "
	sv_d = sv_d + " and bank_id='"+BANCS.STDIN.contextBankId+"')" 
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.gdprVal = BANCS.OUTPARAM.gdprVal
	else
		EQSRV.GLBDATA.gdprVal = "N"
	endif
	if(EQSRV.GLBDATA.gdprVal=="")then
		EQSRV.GLBDATA.gdprVal = "N"
	endif
	lv_c = "consStat1,consStat2,consStat3,consStat4| select nvl(consent_status1,'N'),nvl(consent_status2,'N'),nvl(consent_status3,'N'),nvl(consent_status4,'N') from custom.gdpr where bank_id=?SVAR  and foracid =?SVAR and entity_cre_flg='Y' and del_flg='N' and rownum<=1"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acctNo
	print(lv_c)
	print(BANCS.INPARAM.BINDVARS)
	lv_s = urhk_dbSelectWithBind(lv_c)
	if(lv_s==0)then
		EQSRV.GLBDATA.consStat1 = BANCS.OUTPARAM.consStat1
		EQSRV.GLBDATA.consStat2 = BANCS.OUTPARAM.consStat2
		EQSRV.GLBDATA.consStat3 = BANCS.OUTPARAM.consStat3
		EQSRV.GLBDATA.consStat4 = BANCS.OUTPARAM.consStat4
	else
		EQSRV.GLBDATA.consStat1 = "N"
		EQSRV.GLBDATA.consStat2 = "N"
		EQSRV.GLBDATA.consStat3 = "N"
		EQSRV.GLBDATA.consStat4 = "N"
	endif
	sv_c = "gaO|" + EQSRV.GLBDATA.gdprVal 
	sv_z = urhk_SetOrbOut(sv_c)
	sv_c = "consStat1|" + EQSRV.GLBDATA.consStat1 
	sv_z = urhk_SetOrbOut(sv_c)
	sv_c = "consStat2|" + EQSRV.GLBDATA.consStat2 
	sv_z = urhk_SetOrbOut(sv_c)
	sv_c = "consStat3|" + EQSRV.GLBDATA.consStat3 
	sv_z = urhk_SetOrbOut(sv_c)
	sv_c = "consStat4|" + EQSRV.GLBDATA.consStat4 
	sv_z = urhk_SetOrbOut(sv_c)
	exitscript
trace off
end-->
