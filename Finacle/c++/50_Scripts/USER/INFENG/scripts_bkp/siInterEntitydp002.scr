<--START
CHECKSUM="33a4104b321462c2a82748b8d4dd448ecee5e1693df64b4d632a518856af67bd"
	#TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CSIIET Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CSIIET")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CSIIET",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CSIIET.acctNum = " "
	CUST.CSIIET.errorFlg = "N"
	CUST.CSIIET.errorMsg = " "
	CUST.CSIIET.acctNumEntityId = " "
	CUST.CSIIET.acctNumEntityIdDesc = " "
	CUST.CSIIET.acctNumSolId = " "
	CUST.CSIIET.acctNumCcy = " "
	CUST.CSIIET.acctName = " "
	CUST.CSIIET.entityCreFlg = " "
	CUST.CSIIET.acctClsFlg = " "
	CUST.CSIIET.schmType = " "
	
	#sv_u = urhk_b2k_printrepos("BANCS")
	#print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
		#{
			CUST.CSIIET.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
			print(CUST.CSIIET.acctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CSIIET.errorFlg = "Y"
		CUST.CSIIET.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctNumEntityId,acctNumSolId,acctNumCcy,acctName,entityCreFlg,acctClsFlg,schmType|"
	sv_s = sv_s + " SELECT BANK_ID,SOL_ID,ACCT_CRNCY_CODE,ACCT_NAME,ENTITY_CRE_FLG,ACCT_CLS_FLG,SCHM_TYPE"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CSIIET.acctNum
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CSIIET.acctNumEntityId = BANCS.OUTPARAM.acctNumEntityId
		print(CUST.CSIIET.acctNumEntityId)
		CUST.CSIIET.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
		print(CUST.CSIIET.acctNumSolId)
		CUST.CSIIET.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
		print(CUST.CSIIET.acctNumCcy)
		CUST.CSIIET.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CSIIET.acctName)
		CUST.CSIIET.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		print(CUST.CSIIET.entityCreFlg)
		CUST.CSIIET.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
		print(CUST.CSIIET.acctClsFlg)
		CUST.CSIIET.schmType = BANCS.OUTPARAM.schmType
		print(CUST.CSIIET.schmType)
		
		IF(CUST.CSIIET.entityCreFlg == "N")THEN
		#{
			CUST.CSIIET.errorFlg = "Y"
			CUST.CSIIET.errorMsg = "Account Creation Not Authorised"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.CSIIET.acctClsFlg == "Y")THEN
		#{
			CUST.CSIIET.errorFlg = "Y"
			CUST.CSIIET.errorMsg = "Account is closed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.CSIIET.schmType != "SBA") AND (CUST.CSIIET.schmType != "CAA") AND (CUST.CSIIET.schmType != "CCA") AND (CUST.CSIIET.schmType != "ODA"))THEN
		#{
			CUST.CSIIET.errorFlg = "Y"
			CUST.CSIIET.errorMsg = "Only SBA/CAA/CCA/ODA Type of Accounts are allowed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CSIIET.errorFlg = "Y"
		CUST.CSIIET.errorMsg = "Invalid Account ID"
	#}
	ENDIF
	
	sv_s = "acctNumEntityIdDesc|"
	sv_s = sv_s + " SELECT GROUP_DESC "
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CSIIET.acctNumEntityId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CSIIET.acctNumEntityIdDesc = TOUPPER(BANCS.OUTPARAM.acctNumEntityIdDesc)
		PRINT(CUST.CSIIET.acctNumEntityIdDesc)
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CSIIET.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CSIIET.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetEntity|"+CUST.CSIIET.acctNumEntityId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetEntityDesc|"+CUST.CSIIET.acctNumEntityIdDesc)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetAcctIdSolId|"+CUST.CSIIET.acctNumSolId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetAcctIdCcy|"+CUST.CSIIET.acctNumCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetAcctIdName|"+CUST.CSIIET.acctName)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetEntityAcctId|"+CUST.CSIIET.acctNum)
		print(sv_u)
		
END-->
