# List of services called :
# 1. SRV_AddFileMaint
#       Generic service to Add for Single table file maintenance.
# 2. SRV_FetchFileMaintForVerify
#		Generic service to Fetch FileMaint For Verify for Single
#		table file maintenance.
# 3. SRV_VerifyFileMaint
#		Generic service to Verify for Single table file maintenance.
# ======================================================================
# This script makes use of the following user hooks for calling a
# service :
# urhk_SetUrhkInp
# urhk_SetUrhkOut
# urhk_ExecFwkSrv
# urhk_CopyOutToIn
# For more details about these, refer to CustFeatRelNotes.doc in VSS
# =======================================================================
#                  History Of Changes
# =======================================================================
#  Ver     Date        Who?          	  Description
#  ===     =========   =============      =================
#
#
# =======================================================================
<--START
	TRACE ON
	# ----------------------------------------------------------------------
	# Setting the Inputs for SRV_AddFileMaint.
	# ----------------------------------------------------------------------
	#
	# urhk_SetUrhkInp is used to set inputs.
	# Usage : urhk_SetUrhkInp("<field_id>|<field_value>")
	#
	# ----------------------------------------------------------------------
	        
        #============================================================================
        # Create the necessary Repositories and Classes
        #============================================================================
        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ELSE
        #{
                DELETEREP("CUST")
                CREATEREP("CUST")
        #}
        ENDIF
        IF (CLASSEXISTS("CUST", "FIEFM") == 0) THEN
        #{
                CREATECLASS("CUST", "FIEFM", 5)
                #}
        ELSE
                #{
                DELETECLASS("CUST", "FIEFM")
                CREATECLASS("CUST", "FIEFM", 5)
 #}
        ENDIF
        
	    IF (FIELDEXISTS(("BANCS").("INPUT").("EFMAdd_REQ.EmployeeID")) == 1) THEN
        #{
                CUST.FIEFM.v_emp_id = ("BANCS").("INPUT").("EFMAdd_REQ.EmployeeID")
		print("emp_id is")
		print(CUST.FIEFM.v_emp_id)
                
        #}
		ELSE
				CUST.FIEFM.v_emp_id = " "
			
		ENDIF
		
		IF (FIELDEXISTS(("BANCS").("INPUT").("EFMAdd_REQ.EmployeeName")) == 1) THEN
        #{
                 CUST.FIEFM.v_emp_name = ("BANCS").("INPUT").("EFMAdd_REQ.EmployeeName")
                
        #}
		ELSE
				CUST.FIEFM.v_emp_name = " "
		ENDIF
		IF (FIELDEXISTS(("BANCS").("INPUT").("EFMAdd_REQ.EmpShortName")) == 1) THEN
