        #{
                CUST.FIEFM.v_emp_desig = ("BANCS").("INPUT").("EFMAdd_REQ.EmpDesig")
                
        #}
		ELSE
				CUST.FIEFM.v_emp_desig = " "
        #}
		ENDIF
		IF (FIELDEXISTS(("BANCS").("INPUT").("EFMAdd_REQ.IsHeadTeller")) == 1) THEN
        #{
                CUST.FIEFM.v_is_head_teller = ("BANCS").("INPUT").("EFMAdd_REQ.IsHeadTeller")
                
        #}
		ELSE
				CUST.FIEFM.v_is_head_teller = " "
        #}
		ENDIF
		
        CUST.FIEFM.v_crncy_code=  " "
        CUST.FIEFM.v_alt1_emp_name = " "
		CUST.FIEFM.v_alt1_emp_short_name = " "
		CUST.FIEFM.v_emp_desig_desc = " "
        CUST.FIEFM.v_emp_stat = " "
        CUST.FIEFM.v_emp_stat_desc = " "
        CUST.FIEFM.v_emp_sign_power_num = " "
        CUST.FIEFM.v_emp_sign_power_amt = " "

		sv_p = STRLEN(CUST.FIEFM.v_emp_id)
			PRINT(sv_p)
		IF (sv_p > 10 ) THEN
			PRINT("Emp Id cannot be greate than 10")
			    sv_a = "EFMAdd_RES.Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "EFMAdd_RES.ErrorMessage|Employee ID cannot be greater than 10 characters"
				sv_u = urhk_SetOrbOut(sv_b)
				EXITSCRIPT
		ELSE
			PRINT(sv_p)	
		ENDIF
	
		sv_a = urhk_SetUrhkInp("emp_id|" +  CUST.FIEFM.v_emp_id)
		sv_a = urhk_SetUrhkInp("h_func_code|" +  CUST.FIEFM.v_h_func_code)
		sv_a = urhk_SetUrhkInp("emp_name|" +  CUST.FIEFM.v_emp_name)
		sv_a = urhk_SetUrhkInp("emp_short_name|" +  CUST.FIEFM.v_emp_short_name)
		sv_a = urhk_SetUrhkInp("emp_intls|" +  CUST.FIEFM.v_emp_intls)
		sv_a = urhk_SetUrhkInp("sol_id|" +  CUST.FIEFM.v_sol_id)
		sv_a = urhk_SetUrhkInp("sol_id_desc|" +  CUST.FIEFM.v_sol_id_desc)
		sv_a = urhk_SetUrhkInp("emp_email_id|" +  CUST.FIEFM.v_emp_email_id)
		sv_a = urhk_SetUrhkInp("emp_desig|" +  CUST.FIEFM.v_emp_desig)
		sv_a = urhk_SetUrhkInp("emp_desig_desc|" +  CUST.FIEFM.v_emp_desig_desc)
		sv_a = urhk_SetUrhkInp("emp_stat|" +  CUST.FIEFM.v_emp_stat)
		sv_a = urhk_SetUrhkInp("emp_stat_desc|" +  CUST.FIEFM.v_emp_stat_desc)
		sv_a = urhk_SetUrhkInp("emp_sign_power_num|" +  CUST.FIEFM.v_emp_sign_power_num)
		sv_a = urhk_SetUrhkInp("emp_sign_power_amt|" +  CUST.FIEFM.v_emp_sign_power_amt)
		sv_a = urhk_SetUrhkInp("is_head_teller|" +  CUST.FIEFM.v_is_head_teller)
		sv_a = urhk_SetUrhkInp("crncy_code|" +  CUST.FIEFM.v_crncy_code)
		sv_a = urhk_SetUrhkInp("alt1_emp_name|" +  CUST.FIEFM.v_alt1_emp_name)
		sv_a = urhk_SetUrhkInp("alt1_emp_short_name|" +  CUST.FIEFM.v_alt1_emp_short_name)
	
	
	sv_a = urhk_SetUrhkOut("emp_id|EMP_ID")
	
	sv_a = urhk_ExecFwkSrv("HEFM|Add")
	print(sv_a)
	# The status of the service is stored in BANCS.OUTPARAM.successOrFailure
	sv_c = BANCS.OUTPARAM.successOrFailure
	IF (sv_c != "S") THEN
	#{
		print("Error")
		print(sv_c)
			
			
		sv_c = BANCS.OUTPARAM.Error_num
		print(sv_c)
		
		
		IF (sv_c > 0) THEN
		#{
			sv_d = 1
			
			WHILE (sv_d <= sv_c)
			#{
				# ----------------------------------------------------------------------
				# Error Handling
				# ----------------------------------------------------------------------
				
				sv_f = FORMAT$(sv_d,"%d")
				sv_x = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				print(sv_x)
				sv_y = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_y)
				sv_z = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				print(sv_z)
			
									
				("CUST").("FIEFM").("Error_" + sv_f) = "EFMAdd_RES.EFMErrors.ErrorMessage_"+sv_f + "|" +sv_x
				("CUST").("FIEFM").("FieldName_" + sv_f) = "EFMAdd_RES.EFMErrors.FieldName_"+sv_f + "|" +sv_z
								
				sv_d = sv_d + 1
			#}
			DO
			
				
			sv_a = "EFMAdd_RES.EFMStatus|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)
				
			sv_d = 1
			WHILE (sv_d <= sv_c)
				
				sv_f = FORMAT$(sv_d,"%d")
				sv_u = urhk_SetOrbOut(("CUST").("FIEFM").("Error_" + sv_f))
				
				IF (("CUST").("FIEFM").("FieldName_" + sv_f) != "") THEN
				#{	
						sv_u = urhk_SetOrbOut(("CUST").("FIEFM").("FieldName_" + sv_f))
				#}
				ENDIF
			
			sv_d = sv_d + 1
			DO
			
			EXITSCRIPT
		#}
		ENDIF
	#}
	ELSE 
	#{
		sv_z = "EFMAdd_RES.EFMStatus|SUCCESS"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "EFMAdd_RES.EMP_ID| "+CUST.FIEFM.v_emp_id 
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "EFMAdd_RES.MESSAGE| "+CUST.FIEFM.v_emp_id +" ADDED SUCCESSFULLY. "
		sv_u = urhk_SetOrbOut(sv_z)
		
	#}	
	ENDIF

	
	# Result available in the registered repository variable.
	#print(BANCS.OUTPARAM.EMP_NAME)
	print(CUST.FIEFM.v_emp_id)
	
	# Fetching the added data for verification
	sv_c = urhk_SetUrhkInp("emp_id|" + CUST.FIEFM.v_emp_id)
	sv_c = urhk_ExecFwkSrv("HEFM|FetchForVerify|same_user_verify =Y|retain_all_output = Y")
	print(sv_c)
	
	sv_c = BANCS.OUTPARAM.successOrFailure
	IF (sv_c != "S") THEN
	#{
		print("Error")
		sv_c = BANCS.OUTPARAM.Error_num
		print(sv_c)
		IF (sv_c > 0) THEN
		#{
			sv_d = 1
			
			WHILE (sv_d <= sv_c)
			#{
				# ----------------------------------------------------------------------
				# Error Handling
				# ----------------------------------------------------------------------
				
				sv_f = FORMAT$(sv_d,"%d")
				sv_x = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				print(sv_x)
				sv_y = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_y)
				sv_z = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				print(sv_z)
			
									
				("CUST").("FIEFM").("Error_" + sv_f) = "EFMAdd_RES.EFMErrors.ErrorMessage_"+sv_f + "|" +sv_x
				("CUST").("FIEFM").("FieldName_" + sv_f) = "EFMAdd_RES.EFMErrors.FieldName_"+sv_f + "|" +sv_z
								
				sv_d = sv_d + 1
			#}
			DO
			
				
			sv_a = "EFMAdd_RES.EFMStatus|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)
				
			sv_d = 1
			WHILE (sv_d <= sv_c)
				
				sv_f = FORMAT$(sv_d,"%d")
				sv_u = urhk_SetOrbOut(("CUST").("FIEFM").("Error_" + sv_f))
				
				IF (("CUST").("FIEFM").("FieldName_" + sv_f) != "") THEN
				#{	
						sv_u = urhk_SetOrbOut(("CUST").("FIEFM").("FieldName_" + sv_f))
				#}
				ENDIF
			
			sv_d = sv_d + 1
			DO
			
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	# Copying the fetched data as input to verufy service using urhk_CopyOutToIn hook
	sv_c = urhk_CopyOutToIn("")
	print (sv_c)
	sv_c = urhk_SetUrhkInp("emp_id|" +  CUST.FIEFM.v_emp_id)
	sv_c = urhk_ExecFwkSrv("HEFM|Verify|same_user_verify = Y|retain_all_output =Y")
	print (sv_c)
	sv_c = BANCS.OUTPARAM.successOrFailure
	IF (sv_c != "S") THEN
	#{
		print("Error")
		sv_c = BANCS.OUTPARAM.Error_num
		print (sv_c)
		IF (sv_c > 0) THEN
		#{
			sv_d = 1
			
			WHILE (sv_d <= sv_c)
			#{
				# ----------------------------------------------------------------------
				# Error Handling
				# ----------------------------------------------------------------------
				
				sv_f = FORMAT$(sv_d,"%d")
				sv_x = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				print(sv_x)
				sv_y = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_y)
				sv_z = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				print(sv_z)
			
									
				("CUST").("FIEFM").("Error_" + sv_f) = "EFMAdd_RES.EFMErrors.ErrorMessage_"+sv_f + "|" +sv_x
				("CUST").("FIEFM").("FieldName_" + sv_f) = "EFMAdd_RES.EFMErrors.FieldName_"+sv_f + "|" +sv_z
								
				sv_d = sv_d + 1
			#}
			DO
			
				
			sv_a = "EFMAdd_RES.EFMStatus|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)
				
			sv_d = 1
			WHILE (sv_d <= sv_c)
				
				sv_f = FORMAT$(sv_d,"%d")
				sv_u = urhk_SetOrbOut(("CUST").("FIEFM").("Error_" + sv_f))
				
				IF (("CUST").("FIEFM").("FieldName_" + sv_f) != "") THEN
				#{	
						sv_u = urhk_SetOrbOut(("CUST").("FIEFM").("FieldName_" + sv_f))
				#}
				ENDIF
			
			sv_d = sv_d + 1
			DO
			
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF


	EXITSCRIPT	
	TRACE OFF
