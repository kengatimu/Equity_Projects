#-------------------------------------------------------------------------------------------------------
# Source Name           :   dcchrgmn006.scr
# Date                  :   05-01-2013
# Author                :   Manoj
# Title                 :   DCCharges
# Description           :	It is event based script for event type DCISS, event id DCCHGLO and bacid SWIFTCOMM.
#							If the estabModeCode is 'SWIF' then it hardcodes  charge amount as "3000" else it is 0.
# Called Scripts		: 	NA
# Calling Script		:	getcparamvalue.scr
# Modification History  :
# <Serial No.>      <Date>          <Author Name>       <Description>
# 1.0            23-01-2013     	Manoj        Original version
# 2.0			 20-20-2013			Manoj		 Repository removed and exit script added
# 3.0			 01-10-2013			Bharath				Modified as per porting3 scripts
#-------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="3cf0dd41493371edc6c1fe9d2895b6d987586bd214aad7369f536acff389adaf"
	#TRACE ON
	
	#--------------------------------------------------------------------------
	# Initialise the CHRG repository
	#--------------------------------------------------------------------------
	sv_r = REPEXISTS("CHRG")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CHRG")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CHRG","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CHRG","DATA",5)
	#}
	ENDIF
	
	CHRG.DATA.calAmt		= CDOUBLE("0")
	CHRG.DATA.estabModeCode = ""
	
	BANCS.INPUT.moduleName	= "TRADE_FINANCE"
	BANCS.INPUT.parameterId	= "ESTAB_MOD_COUR"
	call("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CHRG.DATA.estabModeCode = BANCS.OUTPUT.parameterVal
		print(CHRG.DATA.estabModeCode)
		#}
	ELSE
		#{
		CUST.CLRREST.errMsg = "estabModeCode is not set in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId	= "CHRG_COUR"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CHRG.DATA.calAmt = BANCS.OUTPUT.parameterVal
		print(CHRG.DATA.calAmt)
		#}
	ELSE
		#{
		CHRG.DATA.errMsg = "Amount setup is not set in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	
	print(BANCS.INPUT.estabModeCode)
	IF (BANCS.INPUT.estabModeCode == CHRG.DATA.estabModeCode) THEN
	#{
		sv_a = CHRG.DATA.calAmt
		print(sv_a)
		#}
	ELSE
		#{
		sv_a = "0"
		print(sv_a)
	#}
	ENDIF
	
	FINISH:
		BANCS.OUTPUT.collAmount = CDOUBLE(sv_a) + (CDOUBLE(sv_a) * CDOUBLE("0.1"))
		print(BANCS.OUTPUT.collAmount)
		BANCS.OUTPUT.AmountWithNoDiscount = CHRG.DATA.calcAmt
		BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
		
		#TRACE OFF
		EXITSCRIPT
END-->
