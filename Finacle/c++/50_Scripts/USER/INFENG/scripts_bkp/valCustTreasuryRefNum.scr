<--START
TRACE ON
#INPUT TO THE SCRIPT

#BANCS.INPUT.trRefNum
#BANCS.INPUT.cifId
#BANCS.INPUT.eventId
#BANCS.INPUT.toCrncy
#BANCS.INPUT.fromCrncy
#BANCS.INPUT.custRate
#BANCS.INPUT.treasuryRate
#BANCS.INPUT.rateCode
#BANCS.INPUT.valueDate
#BANCS.INPUT.requestDate
#BANCS.INPUT.eventAmt
#BANCS.INPUT.mode
#BANCS.INPUT.eventType

sv_u = urhk_B2K_PrintRepos("BANCS")
print(sv_u)

#CIF_ID
IF (BANCS.INPUT.cifId == "") THEN
#{
	#MSG0007313 = The CIF ID is invalid.
	sv_f = urhk_getMSGCodeErrDesc("MSG0007313")
	BANCS.OUTPUT.errMesg = BANCS.OUTPARAM.errDesc
    EXITSCRIPT
    
#}
ENDIF


#FC_REF_NUM
sv_p = "fcRefNum,requestDate,status|SELECT FC_REF_NUM, TO_CHAR(REQUEST_DATE,'DD-MM-YYYY HH24:MI:SS'),STATUS"
sv_p = sv_p + " FROM FTRT WHERE FTRT.BANK_ID = ?SVAR AND DEL_FLG = 'N' "
sv_p = sv_p + " AND CIF_ID = ?SVAR AND TR_REF_NUM = ?SVAR "

print(sv_p)

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.cifId + "|" + BANCS.INPUT.trRefNum

IF (FIELDEXISTS(BANCS.INPUT.requestDate)) THEN
#{
	IF (BANCS.INPUT.requestDate != "") THEN
	#{
		sv_p = sv_p + " AND REQUEST_DATE = TO_DATE(?SVAR, 'DD-MM-YYYY HH24:MI:SS') "
		print(sv_p)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.cifId + "|" + BANCS.INPUT.trRefNum + "|" + BANCS.INPUT.requestDate
	#}
	ENDIF
#}
ENDIF
#print(sv_p)
sv_d = urhk_dbSelectWithBind(sv_p)
#print(sv_d)

IF (sv_d != 0) THEN
#{
	#Invalid CIF - Treasury Number Combination
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid CIF - Treasury Number Combination"
	EXITSCRIPT
#}
ENDIF

#print(BANCS.OUTPARAM.requestDate)
#print(BANCS.OUTPARAM.fcRefNum)
#print(BANCS.OUTPARAM.status)

#MODE
IF (BANCS.INPUT.mode == "A") THEN
#{
	IF (BANCS.OUTPARAM.status != "C") THEN
	#{
		#MSG0019165 = This treasury reference number [%s] cannot be used as it is already utilized.
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.errMesg = "This treasury reference number ["+ BANCS.INPUT.trRefNum +"]cannot be used as it is already utilized."
		EXITSCRIPT
	#}
	ENDIF
#}
ENDIF
IF (BANCS.INPUT.mode == "M") THEN
#{
	IF (BANCS.OUTPARAM.status == "B") THEN
	#{
		#MSG0019165 = This treasury reference number [%s] cannot be used as it is already utilized.
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.errMesg = "This treasury reference number ["+ BANCS.INPUT.trRefNum +"]cannot be used as it is already utilized."
		EXITSCRIPT
	#}
	ENDIF
#}
ENDIF

sv_p= ""
print(sv_p)
sv_p= "fromCrncy,toCrncy,eventId,valueDate,eventAmt,eventType,custRate,treasuryRate,rateCode|SELECT "
sv_p = sv_p + "FROM_CRNCY_CODE,TO_CRNCY_CODE,EVENT_ID,TO_CHAR(FUNDS_DELIVERY_DATE,'DD-MM-YYYY HH24:MI:SS'),"
sv_p = sv_p + "REF_AMT,BUY_OR_SELL,CUST_RATE,TREASURY_RATE,RATECODE FROM "
sv_p = sv_p + " FTRT WHERE FTRT.BANK_ID = ?SVAR AND DEL_FLG = 'N' "
sv_p = sv_p + " AND CIF_ID = ?SVAR AND FC_REF_NUM = ?SVAR "

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.cifId + "|" + BANCS.OUTPARAM.fcRefNum
print(sv_p)
sv_d = urhk_dbSelectWithBind(sv_p)
print(sv_d)

IF (sv_d != 0) THEN
#{
	#SAFE CODE
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "This treasury reference number in not maintained in FTRT."
	EXITSCRIPT
#}
ENDIF


print(BANCS.OUTPARAM.eventId)
#print(BANCS.OUTPARAM.toCrncy)
#print(BANCS.OUTPARAM.fromCrncy)
print(BANCS.OUTPARAM.custRate)
print(BANCS.OUTPARAM.treasuryRate)
#print(BANCS.OUTPARAM.rateCode)
#print(BANCS.OUTPARAM.valueDate)
print(BANCS.OUTPARAM.eventAmt)
print(BANCS.OUTPARAM.eventType)
#FROM CCY CODE
IF (BANCS.INPUT.fromCrncy != BANCS.OUTPARAM.fromCrncy) THEN
#{
	#MSG0019166 = Invalid crncy combination [%s-%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid crncy combination ["+BANCS.INPUT.fromCrncy+"-"+BANCS.INPUT.toCrncy+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF
#TO CCY CODE
IF (BANCS.INPUT.toCrncy != BANCS.OUTPARAM.toCrncy) THEN
#{
	#MSG0019166 = Invalid crncy combination [%s-%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid crncy combination ["+BANCS.INPUT.fromCrncy+"-"+BANCS.INPUT.toCrncy+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF
#EVENT ID
IF (BANCS.INPUT.eventId != BANCS.OUTPARAM.eventId) THEN
#{
	#MSG0019167 = Invalid Event Id [%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid Event Id ["+BANCS.INPUT.eventId+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF

#VALUE DATE
IF (BANCS.INPUT.valueDate != BANCS.OUTPARAM.valueDate) THEN
#{
	#MSG0019168 = Invalid Value Date [%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid Value Date ["+BANCS.INPUT.valueDate+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF

#EVENT AMT

BANCS.OUTPARAM.eventAmt = FORMAT$(CDOUBLE(BANCS.OUTPARAM.eventAmt),"%.2f")

print(TRIM(BANCS.INPUT.eventAmt))

print(BANCS.OUTPARAM.eventAmt)
IF (trim(BANCS.INPUT.eventAmt) != BANCS.OUTPARAM.eventAmt) THEN
#{
	#MSG0019169 = Invalid Reference Amount [%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid Reference Amount ["+BANCS.INPUT.eventAmt+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF
#EVENT TYPE
#IF (BANCS.INPUT.eventType != BANCS.OUTPARAM.eventType) THEN
#{
	#MSG0019170 = The purchase or sale type is invalid for the entered treasury reference number. Purchase/Sale Type: [%c]
	#BANCS.OUTPUT.successOrFailure = "F"
#	BANCS.OUTPUT.errMesg = "The purchase or sale type is invalid for the entered treasury reference number. Purchase/Sale Type: ["+BANCS.INPUT.eventType+"]"
#	EXITSCRIPT
#}
#ENDIF

#CUST RATE
BANCS.OUTPARAM.custRate = FORMAT$(CDOUBLE(BANCS.OUTPARAM.custRate),"%.4f")

PRINT(trim(BANCS.INPUT.custRate))
PRINT(BANCS.OUTPARAM.custRate)
IF (trim(BANCS.INPUT.custRate) != BANCS.OUTPARAM.custRate) THEN
#{
	#MSG0019171 = Invalid Customer rate [%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid Customer rate ["+BANCS.INPUT.custRate+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF
#TREASURY RATE
BANCS.OUTPARAM.treasuryRate = FORMAT$(CDOUBLE(BANCS.OUTPARAM.treasuryRate),"%.4f")

print(trim(BANCS.INPUT.treasuryRate))
print(BANCS.OUTPARAM.treasuryRate)
IF (trim(BANCS.INPUT.treasuryRate) != BANCS.OUTPARAM.treasuryRate) THEN
#{
	#MSG0019172 = Invalid Treasury rate [%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid Treasury rate ["+BANCS.INPUT.treasuryRate+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF
#RATE CODE
print(BANCS.INPUT.rateCode)
print(BANCS.OUTPARAM.rateCode)
IF (BANCS.INPUT.rateCode != BANCS.OUTPARAM.rateCode) THEN
#{
	#MSG0019173 = Invalid Rate code [%s] for the given treasury reference number.
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.errMesg = "Invalid Rate code ["+BANCS.INPUT.rateCode+"] for the given treasury reference number."
	EXITSCRIPT
#}
ENDIF

#OUTPUT FROM THE SCRIPT
BANCS.OUTPUT.successOrFailure = "S"
print(BANCS.OUTPUT.successOrFailure)
#BANCS.OUTPUT.errMesg = "Error message"

TRACE OFF
END-->
