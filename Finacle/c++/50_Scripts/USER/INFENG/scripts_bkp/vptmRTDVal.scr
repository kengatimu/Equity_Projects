			sv_l = strlen(EBRT.GLBDATA.tran_amt)
			sv_f = mid$(EBRT.GLBDATA.tran_amt,0,sv_l)
			sv_l = strlen(EBRT.GLBDATA.tran_amt)
			sv_p = getposition(sv_f,"|")
			EBRT.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
			EBRT.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
