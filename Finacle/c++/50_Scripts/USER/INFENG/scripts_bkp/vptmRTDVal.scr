		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.crncyCode")
			EBRT.GLBDATA.acctCrncy=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.acctCrncy)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBRT.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBRT.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
