		#}
		endif
		exitscript
	#}
	endif


	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBRT.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBRT.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	if((EBRT.GLBDATA.tranSubType=="CI") or (EBRT.GLBDATA.tranSubType=="BI"))then
	#{
