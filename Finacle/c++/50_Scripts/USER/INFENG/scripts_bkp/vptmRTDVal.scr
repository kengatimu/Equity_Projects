				EBRT.GLBDATA.Ratert = BANCS.OUTPARAM.Ratert	
				EBRT.GLBDATA.TreaRate = BANCS.OUTPARAM.TreaRate	
			#}
			else
			#{
				lv_t = " rrateCode,Ratert,TreaRate | select ratecode,var_crncy_units,cust_var_crncy_units from tbaadm.rtl where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and fxd_crncy_code=?SVAR and var_crncy_code=?SVAR and ratecode=?SVAR and rtlist_num in (select max(rtlist_num) from tbaadm.rtl where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and fxd_crncy_code=?SVAR and var_crncy_code=?SVAR and ratecode=?SVAR) "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBRT.GLBDATA.refCrncyCode + "|" + EBRT.GLBDATA.tranCrncyCode + "|" + EBRT.GLBDATA.rateCode + "|" + BANCS.STDIN.contextBankId + "|" + EBRT.GLBDATA.refCrncyCode + "|" + EBRT.GLBDATA.tranCrncyCode + "|" + EBRT.GLBDATA.rateCode
				print(BANCS.INPARAM.BINDVARS)
				print(lv_t)
				lv_s = urhk_dbSelectWithBind(lv_t)
				if(lv_s==0)then
				#{
					EBRT.GLBDATA.rrateCode = BANCS.OUTPARAM.rrateCode	
					EBRT.GLBDATA.Ratert = BANCS.OUTPARAM.Ratert	
					EBRT.GLBDATA.TreaRate = BANCS.OUTPARAM.TreaRate	
				#}
				endif
			#}
			endif
			if((EBRT.GLBDATA.TreaRate!="")and(cdouble(EBRT.GLBDATA.treaRate)<=0))then
			#{
				sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.treaRate|" + EBRT.GLBDATA.TreaRate ) 
			#}
			endif
		#}
		endif
		if(EBRT.GLBDATA.screvnt=="SRV_AddAndPostXferTran_pre_process_data.scr")then
		#{
			if((EBRT.GLBDATA.foracid!="") and (EBRT.GLBDATA.partTranType=="D"))then
			#{
				EBRT.GLBDATA.isDrAcctId = EBRT.GLBDATA.foracid
				sv_u = urhk_getAcctDetailsInRepository(EBRT.GLBDATA.foracid)
				if(sv_u==0)then
				#{
					EBRT.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
					EBRT.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
