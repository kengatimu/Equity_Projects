				EBRT.GLBDATA.failureReason = ""
			#}
			endif
			lv_u = " update custom.cust_treasury_deal_tbl set tran_amount=?NVAR,tran_crncy=?SVAR,ref_crncy=?SVAR,"
			lv_u = lv_u + " rate_code=?SVAR,cust_rate=?SVAR,trea_rate=?SVAR,free_text_1=?SVAR,free_text_2=?SVAR,free_text_3=?SVAR,failue_desc=?SVAR "
			lv_u = lv_u + " where bank_id=?SVAR and req_channel_id=?SVAR and req_uuid=?SVAR and foracid=?SVAR and part_tran_type=?SVAR "
			BANCS.INPARAM.BINDVARS = EBRT.GLBDATA.trans_amt + "|" + EBRT.GLBDATA.tranCrncyCode + "|" + EBRT.GLBDATA.refCrncyCode +"|" + EBRT.GLBDATA.rateCode +"|" +EBRT.GLBDATA.rate + "|" + EBRT.GLBDATA.treaRate + "|" + EBRT.GLBDATA.arefAmt + "|" + EBRT.GLBDATA.arefCrncy + "|" + EBRT.GLBDATA.failureReason + "|" + EBRT.GLBDATA.failureDesc + "|" + BANCS.STDIN.contextBankId + "|" + EBRT.GLBDATA.DccId + "|" + EBRT.GLBDATA.DccReqRefNum + "|" + EBRT.GLBDATA.foracid + "|" + EBRT.GLBDATA.partTranType 
			print(lv_u)
			print(BANCS.INPARAM.BINDVARS)
			lv_p = urhk_dbSqlWithBind(lv_u)
			print(lv_p)
			if(lv_p==0)then
				lv_p = urhk_dbSqlWithBind("commit")
			endif
		#}
		endif
		if(EBRT.GLBDATA.screvnt=="SRV_AddAndPostXferTran_validate_data.scr")then
		#{
			EBRT.GLBDATA.dealType = ""
			EBRT.GLBDATA.dealDesc = ""
			EBRT.GLBDATA.tranId = ""
			lv_d = "insert into custom.cust_treasury_deal_tbl (BANK_ID,DEAL_TYPE,DEAL_DESC,REQ_CHANNEL_ID,REQ_UUID,REQ_DATE_TIME,HOST_MACHINE_ID,FORACID,TRAN_TYPE,TRAN_SUB_TYPE,PART_TRAN_TYPE,PART_TRAN_SRL_NUM,TRAN_ID,TRAN_AMOUNT,TRAN_CRNCY,REF_CRNCY,RATE_CODE,CUST_RATE,TREA_RATE,TRAN_PARTICULARS,TRAN_REMARKS,REF_NUM,PSTD_FLG,PSTD_DATE,VALUE_DATE,GL_DATE,PSTD_USER_ID,ENTERED_USER_ID,ENTITY_CRE_FLG,DEL_FLG,FAILUE_DESC,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,FREE_TEXT_1,FREE_TEXT_2,FREE_TEXT_3,FREE_TEXT_4,FREE_TEXT_5,FREE_TEXT_6) values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?NVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,'N',null,to_date(?SVAR,'DD-MM-RRRR'),to_date(?SVAR,'DD-MM-RRRR'),null,?SVAR,'N','N',null,?SVAR,sysdate,?SVAR,sysdate,null,null,null,null,null,null) "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBRT.GLBDATA.dealType + "|" + EBRT.GLBDATA.dealDesc + "|" + EBRT.GLBDATA.DccId + "|" +  EBRT.GLBDATA.DccReqRefNum + "|" + left$(EBRT.GLBDATA.DccReqOriginTime,10) + "|" + EBRT.GLBDATA.machineId + "|" + EBRT.GLBDATA.foracid + "|" + EBRT.GLBDATA.tranType + "|" + EBRT.GLBDATA.tranSubType + "|" + EBRT.GLBDATA.partTranType + "|" +  EBRT.GLBDATA.serialnum + "|" + EBRT.GLBDATA.tranId + "|" + EBRT.GLBDATA.trans_amt + "|" + EBRT.GLBDATA.trans_crncy + "|" + EBRT.GLBDATA.acctCrncy + "|" + EBRT.GLBDATA.rateCode + "|" +  EBRT.GLBDATA.rate + "|" + EBRT.GLBDATA.treaRate + "|" + EBRT.GLBDATA.tranParticulars + "|" + EBRT.GLBDATA.tran_rmks + "|" + EBRT.GLBDATA.refNum + "|" +  left$(EBRT.GLBDATA.valueDate,10) + "|" + left$(EBRT.GLBDATA.glDate,10) + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId 
			print(lv_d)
			print(BANCS.INPARAM.BINDVARS)
			lv_p = urhk_dbSqlWithBind(lv_d)
			print(lv_p)
			if(lv_p==0)then
				lv_p = urhk_dbSqlWithBind("commit")
			endif
		#}
