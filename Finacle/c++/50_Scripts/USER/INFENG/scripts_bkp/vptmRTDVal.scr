			sv_l = strlen(EBRT.GLBDATA.refAmt)
			sv_f = mid$(EBRT.GLBDATA.refAmt,0,sv_l)
			sv_l = strlen(EBRT.GLBDATA.refAmt)
			sv_p = getposition(sv_f,"|")
			EBRT.GLBDATA.arefAmt   = mid$(sv_f,0,(sv_p-1))
			EBRT.GLBDATA.arefCrncy = mid$(sv_f,sv_p,sv_l)
		#}
		endif	
		print(EBRT.GLBDATA.trans_amt)
		print(EBRT.GLBDATA.trans_crncy)
		print(EBRT.GLBDATA.acctCrncy)
