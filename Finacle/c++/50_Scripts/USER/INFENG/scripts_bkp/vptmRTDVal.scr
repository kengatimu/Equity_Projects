		print(EBRT.GLBDATA.tranCrncyCode)
		if((EBRT.GLBDATA.tranCrncyCode!=EBRT.GLBDATA.refCrncyCode) and (cdouble(EBRT.GLBDATA.rate)>0))then
		#{
			lv_t = " rrateCode,Ratert,TreaRate | select ratecode,var_crncy_units,cust_var_crncy_units from tbaadm.rtl where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and fxd_crncy_code=?SVAR and var_crncy_code=?SVAR and ratecode=?SVAR and rtlist_num in (select max(rtlist_num) from tbaadm.rtl where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and fxd_crncy_code=?SVAR and var_crncy_code=?SVAR and ratecode=?SVAR) "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBRT.GLBDATA.tranCrncyCode + "|" + EBRT.GLBDATA.refCrncyCode + "|" + EBRT.GLBDATA.rateCode + "|" + BANCS.STDIN.contextBankId + "|" + EBRT.GLBDATA.tranCrncyCode + "|" + EBRT.GLBDATA.refCrncyCode + "|" + EBRT.GLBDATA.rateCode
			print(BANCS.INPARAM.BINDVARS)
			print(lv_t)
