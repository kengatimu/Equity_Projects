			BANCS.INPARAM.BINDVARS = EBRT.GLBDATA.DealTranId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EBRT.GLBDATA.DccId + "|" + EBRT.GLBDATA.DccReqRefNum 
