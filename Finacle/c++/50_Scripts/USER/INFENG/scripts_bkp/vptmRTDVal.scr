					print(EBRT.GLBDATA.clearBalance)
					EBRT.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
					print(EBRT.GLBDATA.EffAvailableAmt)
				#}
				endif
				if(cdouble(EBRT.GLBDATA.trans_amt)>cdouble(EBRT.GLBDATA.clearBalance))then
				#{
					EBRT.GLBDATA.failureReason = "Insufficient Fund"
					EBRT.GLBDATA.failureDesc = "DRBalance"
