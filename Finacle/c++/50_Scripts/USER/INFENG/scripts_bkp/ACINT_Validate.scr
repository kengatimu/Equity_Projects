<--start
##trace on
#-------------------------------------------------------------------------------
# Executing the validation function valSetId for sol_set_id
#-------------------------------------------------------------------------------

sv_n=urhk_ExecVal("valSetId|setId=&sol_set_id|setIdDesc=&sol_set_id_desc|MANDATORY")

#-------------------------------------------------------------------------------
# Executing the validation function validateCrncyCode for crncy_code
#-------------------------------------------------------------------------------

sv_o=urhk_ExecVal("validateCrncyCode|crncyCode=&crncy_code|crncyCodeDesc=&crncy_desc")

#-------------------------------------------------------------------------------
# Executing the validation function validateAcctId for account fields
#-------------------------------------------------------------------------------

sv_c=urhk_VAL_GetVal("from_acct_num")
sv_a=BANCS.OUTPARAM.fldValue
print(sv_a)
BANCS.INPUT.odintacctid = sv_a
sv_c=urhk_VAL_GetVal("to_acct_num")
sv_b=BANCS.OUTPARAM.fldValue
print(sv_b)
	if((BANCS.INPUT.odintacctid!="")and(BANCS.STDIN.contextBankId=="54"))then
        lv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.odintacctid)
        if(lv_u==0)then
                print(BANCS.OUTPARAM.sanctionLimit)
                print(BANCS.OUTPARAM.cleanAdhocLimit)
                print(BANCS.OUTPARAM.drawingPower)
                print(BANCS.OUTPARAM.usedUnclearOverDACC)
                print(BANCS.OUTPARAM.FXClearBalance)
                print(BANCS.OUTPARAM.FxAvailableAmt)
                print(BANCS.OUTPARAM.AvailableAmt)
                print(BANCS.OUTPARAM.ClearBalance)
		print(BANCS.OUTPARAM.schmCode)
		if((BANCS.OUTPARAM.schmCode=="OD542")or(BANCS.OUTPARAM.schmCode=="OD543")or(BANCS.OUTPARAM.schmCode=="OD544")or(BANCS.OUTPARAM.schmCode=="OD545")or(BANCS.OUTPARAM.schmCode=="OD546"))then
			if(cdouble(BANCS.OUTPARAM.ClearBalance)>=0)then
				sv_z=urhk_VAL_SetErr("FLD_NAME=from_acct_num|ERR_TYPE=M|ERR_CODE=MSG0006993")
			endif
		endif
	endif
	endif

sv_p=urhk_ExecVal("validateAcctId|foracid=&from_acct_num|solId=&sol1|crncyCode=&crncy1|acctName=&from_acct_name")
sv_o=sv_p

sv_q=urhk_ExecVal("validateAcctId|foracid=&to_acct_num|solId=&sol2|crncyCode=&crncy2|acctName=&to_acct_name")

if((sv_p==0) AND (sv_q==0) AND (sv_a != "") AND (sv_b != "")) then
         if((sv_b != "") AND (sv_b < sv_a)) then
                sv_c=urhk_VAL_SetErr("FLD_NAME=to_acct_num|ERR_TYPE=B|ERR_CODE=528")
         endif
endif

#------------------------------------------------------------------------------
# Check if the entered account id is of murabah type
#------------------------------------------------------------------------------

sv_c=urhk_VAL_GetVal("from_acct_num")
sv_a=BANCS.OUTPARAM.fldValue

if(sv_p == 0) then
    #if from_acct_num is not null
    if(sv_a != "") then
        sv_y = "schmCode|SELECT 1 FROM GAM G, GSP S WHERE G.FORACID = ?SVAR "
        sv_y = sv_y + "AND S.SCHM_CODE = G.SCHM_CODE "
        sv_y = sv_y + "AND (S.ISLAMIC_SCHEME_PRODUCT != 'R' OR S.ISLAMIC_SCHEME_PRODUCT IS NULL) "
        sv_y = sv_y + "AND G.ENTITY_CRE_FLG = 'Y' "
        sv_y = sv_y + "AND G.DEL_FLG != 'Y' "
        sv_y = sv_y + "AND S.DEL_FLG != 'Y' "
        sv_y = sv_y + "AND G.BANK_ID = ?SVAR "
        sv_y = sv_y + "AND S.BANK_ID = ?SVAR "
        BANCS.INPARAM.BINDVARS = sv_a + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId

        sv_r = urhk_dbSelectWithBind(sv_y)

        if(sv_r != 0 ) then
            #MSG0337981 This operation is not supported for murabha accounts.
            sv_g = urhk_VAL_SetErr("FLD_NAME=from_acct_num|ERR_TYPE=M|ERR_CODE=MSG0337981")
        endif
    endif
endif

sv_c=urhk_VAL_GetVal("to_acct_num")
sv_b=BANCS.OUTPARAM.fldValue

if(sv_q == 0) then
    #if from_acct_num is not null
    if(sv_b != "") then
        sv_y = "schmCode|SELECT 1 FROM GAM G, GSP S WHERE G.FORACID = ?SVAR "
        sv_y = sv_y + "AND S.SCHM_CODE = G.SCHM_CODE "
        sv_y = sv_y + "AND (S.ISLAMIC_SCHEME_PRODUCT != 'R' OR S.ISLAMIC_SCHEME_PRODUCT IS NULL) "
        sv_y = sv_y + "AND G.ENTITY_CRE_FLG = 'Y' "
        sv_y = sv_y + "AND G.DEL_FLG != 'Y' "
        sv_y = sv_y + "AND S.DEL_FLG != 'Y' "
        sv_y = sv_y + "AND G.BANK_ID = ?SVAR "
        sv_y = sv_y + "AND S.BANK_ID = ?SVAR "
        BANCS.INPARAM.BINDVARS = sv_b + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId

        sv_r = urhk_dbSelectWithBind(sv_y)

        if(sv_r != 0 ) then
            #MSG0337981 This operation is not supported for murabha accounts.
            sv_g = urhk_VAL_SetErr("FLD_NAME=to_acct_num|ERR_TYPE=M|ERR_CODE=MSG0337981")
        endif
    endif
endif

#-------------------------------------------------------------------------------
# Executing the validation function validateSchmCodeWithDel for Scheme code
# fields
#-------------------------------------------------------------------------------


sv_c=urhk_VAL_GetVal("from_schm_code")
sv_f=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_schm_code")
sv_g=BANCS.OUTPARAM.fldValue

sv_u=urhk_ExecVal("validateSchmCodeWithDel|schmCode=&from_schm_code|schmCodeDesc=&from_schm_code_desc")
###from_schm_code_desc is the hidden field present in the bcfg.

sv_w=urhk_ExecVal("validateSchmCodeWithDel|schmCode=&to_schm_code|schmCodeDesc=&to_schm_code_desc")
###to_schm_code_desc is the hidden field present in the bcfg.

if((sv_u==0) AND (sv_w==0)) then
  if((sv_g != "") AND (sv_g < sv_f)) then
       sv_c=urhk_VAL_SetErr("FLD_NAME=from_schm_code|ERR_TYPE=B|ERR_CODE=J77")
  endif
endif

#-------------------------------------------------------------------------------
# Executing the validation function validateRefCodeWithDel for schm_type
#-------------------------------------------------------------------------------

sv_r= urhk_ExecVal("validateRefCodeWithDel|refCode=&schm_type|refRecType=46|refDesc=&schm_type_desc")

#-------------------------------------------------------------------------------
# Executing the validation function for date fields
#-------------------------------------------------------------------------------

sv_y=urhk_ExecVal("valDate|dateStr=&from_date")

sv_z=urhk_ExecVal("valDate|dateStr=&to_date|MANDATORY")

sv_d=urhk_ExecVal("valDate|dateStr=&value_date")

sv_c=urhk_VAL_GetVal("from_date")
BANCS.INPARAM.date1=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_date")
BANCS.INPARAM.date2=BANCS.OUTPARAM.fldValue

if ((sv_y==0) AND (sv_z==0))then
   sv_a = urhk_B2k_dateDiff("")
   sv_b = BANCS.OUTPARAM.dateDiff
   if (sv_b > 0)then
		sv_c=urhk_VAL_SetErr("FLD_NAME=to_date|ERR_TYPE=M|ERR_CODE=MSG0319479")
   endif
endif

sv_c=urhk_VAL_GetVal("to_date")
BANCS.INPARAM.date1=BANCS.OUTPARAM.fldValue 

sv_c=urhk_VAL_GetVal("value_date") 
BANCS.INPARAM.date2=BANCS.OUTPARAM.fldValue 

if ((sv_d==0) AND (sv_z==0))then 
sv_a = urhk_B2k_dateDiff("") 
sv_b = BANCS.OUTPARAM.dateDiff 
if (sv_b > 0)then 
sv_c=urhk_VAL_SetErr("FLD_NAME=value_date|ERR_TYPE=B|ERR_CODE=BXE") 
endif 
endif 

sv_c=urhk_VAL_GetVal("to_date") 

sv_f=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("adhoc_mode")
sv_j=BANCS.OUTPARAM.fldValue

if (sv_z == 0) then
    BANCS.INPARAM.date1=sv_f
	BANCS.INPARAM.date2=BANCS.STDIN.BODDate
	sv_s=urhk_B2k_dateDiff("")
	sv_t=BANCS.OUTPARAM.dateDiff
	if (sv_t > 0) then
		sv_v = BANCS.STDIN.mySolId
	    BANCS.INPARAM.date1 = sv_f

	    #This is to check if the to date is maintained in HOL table or not
        sv_x = sv_v + "|" + sv_f
        #print(sv_x)
        sv_z = urhk_GetHolidayStatus(sv_x)
        sv_b=BANCS.OUTPARAM.holidayStatus
        #print(sv_b)
        if (sv_b == "X") then
           #Calendar not maintained for this month & year combination
           sv_d=urhk_VAL_SetErr("FLD_NAME=to_date|ERR_TYPE=M|ERR_CODE=MSG0018599")
    	   exitscript	  
	    endif
	  
	  	#Find the getNextworking date only when the end date is not a holiday
	    BANCS.INPARAM.inputDate = sv_f

		sv_a = urhk_checkFutureDates("")
		if(sv_a != 0) then
			if(FIELDEXISTS(BANCS.OUTPARAM.workingDayPresent)) then
				sv_p = BANCS.OUTPARAM.workingDayPresent

				if(sv_p == "Y") then
					# BC9 End date can't be after BOD date unless all days
					# in between are holidays
					sv_d=urhk_VAL_SetErr("FLD_NAME=to_date|ERR_TYPE=B|ERR_CODE=BC9")
				endif
			endif
		endif	
	endif
endif
#-------------------------------------------------------------------------------
# Executing the validation function for Cif Id
#-------------------------------------------------------------------------------

sv_c=urhk_VAL_GetVal("from_cif_id")
sv_h=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_cif_id")
sv_i=BANCS.OUTPARAM.fldValue

sv_n=urhk_ExecVal("validateVfdCustId|cifId=&from_cif_id|custName=&from_cust_name")
#####from_cust_name is hidden type in the bcfg

sv_p=urhk_ExecVal("validateVfdCustId|cifId=&to_cif_id|custName=&to_cust_name")
#####to_cust_name is hidden in the bcfg

if((sv_n==0) AND (sv_p==0)) then
  if((sv_i != "") AND (sv_i < sv_h)) then
         sv_c=urhk_VAL_SetErr("FLD_NAME=from_cif_id|ERR_TYPE=B|ERR_CODE=Z43")
  endif
endif

#-------------------------------------------------------------------------------
#Executing the validation function validateGlSubHeadWithoutSol for GlSubHeadCode
#-------------------------------------------------------------------------------

sv_c=urhk_VAL_GetVal("from_gl_sub_head_code")
sv_d=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_gl_sub_head_code")
sv_e=BANCS.OUTPARAM.fldValue

if(sv_d != "") then
	sv_r=urhk_ExecVal("validateGlSubHeadWithoutSol|glSubHeadCode=&from_gl_sub_head_code|glSubHeadCodeDesc=&from_gl_sub_head_code_desc|FLD_CHK_NOT_REQ")
endif

if(sv_e != "") then
	sv_s=urhk_ExecVal("validateGlSubHeadWithoutSol|glSubHeadCode=&to_gl_sub_head_code|glSubHeadCodeDesc=&to_gl_sub_head_code_desc|FLD_CHK_NOT_REQ")
endif

if((sv_d != "") AND (sv_e != "")) then
	if((sv_r==0) AND (sv_s==0)) then     
       if(sv_e < sv_d) then
                sv_c=urhk_VAL_SetErr("FLD_NAME=from_gl_sub_head_code|ERR_TYPE=B|ERR_CODE=K10")
       endif
    endif
endif

#------------------------------------------------------------------------------
# Executing the validation function ExecVal -  product_group
#------------------------------------------------------------------------------

sv_j=urhk_ExecVal("validateRefCode|refCode=&product_group|refRecType=BZ|refDesc=&product_group_desc")
#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for post_flg
#-------------------------------------------------------------------------------

sv_t=urhk_ExecVal("validateYesNoFlag|flag=&post_flg")

#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for freq_int_run_flg
#-------------------------------------------------------------------------------

sv_u=urhk_ExecVal("validateYesNoFlag|flag=&freq_int_run_flg|MANDATORY")

#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for dr_cr_int_flg
#-------------------------------------------------------------------------------

sv_v=urhk_ExecVal("validateDrCrIntInd|code=&dr_cr_int_flg|MANDATORY")

#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for print_int_advc_flg
#-------------------------------------------------------------------------------

sv_q=urhk_ExecVal("validateYesNoFlag|flag=&print_int_advc_flg")

#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for include_npa_acct
#-------------------------------------------------------------------------------

sv_s=urhk_ExecVal("validateEioFlg|fieldVal=&include_npa_acct|MANDATORY")

#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for include_dormant_acct
#-------------------------------------------------------------------------------

sv_u=urhk_ExecVal("validateEioFlg|fieldVal=&include_dormant_acct|MANDATORY") 

#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for include_frozen_acct
#-------------------------------------------------------------------------------

sv_v=urhk_ExecVal("validateEioFlg|fieldVal=&include_frozen_acct|MANDATORY") 
#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for book_for_reversal_flg
#-------------------------------------------------------------------------------

sv_p=urhk_ExecVal("validateYesNoFlag|flag=&book_for_reversal_flg")

#-------------------------------------------------------------------------------
# Executing the validation function for adhoc_mode
#-------------------------------------------------------------------------------

sv_w=urhk_ExecVal("validateInterestType|code=&adhoc_mode|MANDATORY") 

sv_c=urhk_VAL_GetVal("adhoc_mode") 
sv_j=BANCS.OUTPARAM.fldValue
sv_c=urhk_VAL_GetVal("post_flg") 
sv_q=BANCS.OUTPARAM.fldValue


if ((sv_j=="A") AND (sv_q!="N")) then
       sv_c=urhk_VAL_SetErr("FLD_NAME=post_flg|ERR_TYPE=B|ERR_CODE=531")
endif
if (sv_j=="A") then
       sv_q=urhk_VAL_SetVal("post_flg|N") 
endif

sv_c=urhk_VAL_GetVal("from_date")
sv_l=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("include_closed_acct")
sv_m=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("include_disabled_acct")
sv_n=BANCS.OUTPARAM.fldValue

if ((sv_j == "A") AND ( sv_l == ""))then
    ###From date is mandatory for ADHOC run#########
    sv_c=urhk_VAL_SetErr("FLD_NAME=from_date|ERR_TYPE=S|ERR_CODE=E5516")
endif

if ((sv_m == "I") OR ( sv_m == "O"))then
   if (sv_j != "A") then
           sv_c=urhk_VAL_SetErr("FLD_NAME=adhoc_mode|ERR_TYPE=M|ERR_CODE=MSG0010381")
   endif
endif
  
if ((sv_n == "I") OR ( sv_n == "O"))then
   if (sv_j != "A") then
           sv_c=urhk_VAL_SetErr("FLD_NAME=adhoc_mode|ERR_TYPE=M|ERR_CODE=MSG0010382")
   endif       
endif

if (sv_j == "I") then

endif

#-------------------------------------------------------------------------------
# Executing the validation function for print_int_advc_flg
#-------------------------------------------------------------------------------

sv_q=urhk_ExecVal("validateYesNoFlag|flag=&print_int_advc_flg")

#-------------------------------------------------------------------------------
# Executing the validation function for print_int_detail_flg
#-------------------------------------------------------------------------------

sv_c=urhk_VAL_GetVal("print_int_detail_flg")
sv_k=BANCS.OUTPARAM.fldValue

if ((sv_k != "S") AND (sv_k != "D")) then
         if ((sv_k != "D") AND (sv_k != "N")) then 
                  ####Valid values are: S-Summary, D-Detail and N-No Report###
                  sv_c=urhk_VAL_SetErr("FLD_NAME=print_int_detail_flg|ERR_TYPE=S|ERR_CODE=E5515")
         endif 
endif


#-------------------------------------------------------------------------------
# Executing the validation function ExecVal for include_closed_acct 
#and include_disabled_acct
#-------------------------------------------------------------------------------

sv_r=urhk_ExecVal("validateEioFlg|fieldVal=&include_closed_acct|MANDATORY")    

sv_t=urhk_ExecVal("validateEioFlg|fieldVal=&include_disabled_acct|MANDATORY")

sv_c=urhk_VAL_GetVal("include_closed_acct")
sv_m=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("include_disabled_acct")
sv_n=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("inp_file_name")
sv_s=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("schm_type")
sv_r=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("from_schm_code")
sv_f=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_schm_code")
sv_g=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("from_acct_num")
sv_a=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("adhoc_mode")
sv_j=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_acct_num")
sv_b=BANCS.OUTPARAM.fldValue

sv_z=urhk_ExecVal("validateUploadFileNameIfEntered|fileName=&inp_file_name")

if((sv_r=="") AND (sv_s=="")) then
  if((sv_a=="") AND (sv_b=="")) then
      if((sv_f=="") AND (sv_g=="")) then
           sv_c=urhk_VAL_SetErr("FLD_NAME=schm_type|ERR_TYPE=M|ERR_CODE=MSG0005455")
      endif   
      if(sv_f!=sv_g) then
           sv_c=urhk_VAL_SetErr("FLD_NAME=schm_type|ERR_TYPE=M|ERR_CODE=MSG0005455")
      endif
	  if((sv_f == sv_g) AND (sv_f != ""))then
	  	  sv_z=urhk_ExecVal("validateSchmCode|schmCode=&from_schm_code|schmType=&schm_type")
	  endif	   
  endif
endif

if((sv_a!=sv_b) AND ((sv_r=="") AND (sv_s==""))) then
   sv_c=urhk_VAL_SetErr("FLD_NAME=schm_type|ERR_TYPE=M|ERR_CODE=MSG0005455")
endif

if((sv_a==sv_b) AND (sv_a!="") AND ((sv_r=="") AND (sv_s=="")) AND (sv_o==0)) then
    sv_p=urhk_ExecVal("validateForacidAndGetSchmType|id=&from_acct_num|desc=&schm_type")
    if(sv_p!=0) then
        sv_c=urhk_VAL_SetErr("FLD_NAME=from_acct_num|ERR_TYPE=B|ERR_CODE=753")
    endif
endif

sv_c=urhk_VAL_GetVal("from_cif_id")
sv_x=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_cif_id")
sv_y=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("from_gl_sub_head_code")
sv_k=BANCS.OUTPARAM.fldValue

sv_c=urhk_VAL_GetVal("to_gl_sub_head_code")
sv_l=BANCS.OUTPARAM.fldValue

if ((sv_s != "") AND ((sv_x != "") OR (sv_y != "") OR (sv_k != "") OR (sv_l !="") OR (sv_f != "") OR (sv_g != "") OR (sv_r != "") OR (sv_a != "") OR (sv_b!= ""))) then
    sv_c = urhk_VAL_SetErr("FLD_NAME=inp_file_name|ERR_TYPE=S|ERR_CODE=E5606")
endif

end-->
