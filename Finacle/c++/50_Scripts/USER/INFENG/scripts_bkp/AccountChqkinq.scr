        ENDIF
		sv_s=0
		sv_c =1
WHILE(sv_q == 0)
#{
        sv_j = sv_c 
        CUST.DATA.OPLoop = "CHKBOOkRequest_" + format$(sv_j,"%d") + "."
		
		CUST.DATA.RequestId = BANCS.OUTPARAM.RequestId
		CUST.DATA.BranchId = BANCS.OUTPARAM.BranchId
        		CUST.DATA.Accountnumber = BANCS.OUTPARAM.Accountnumber
		CUST.DATA.Accountname = BANCS.OUTPARAM.Accountname
        		CUST.DATA.NofBooks = BANCS.OUTPARAM.NofBooks
       	 	CUST.DATA.Nofchqlvs = BANCS.OUTPARAM.Nofchqlvs
        		CUST.DATA.BegChqinNo = BANCS.OUTPARAM.BegChqinNo
		CUST.DATA.EndChqNo = BANCS.OUTPARAM.EndChqNo
		CUST.DATA.Reqstatus = BANCS.OUTPARAM.Reqstatus
		CUST.DATA.Descstatus = BANCS.OUTPARAM.Descstatus
		CUST.DATA.DateRequested = BANCS.OUTPARAM.DateRequested

         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"REQUESTID|" + CUST.DATA.RequestId)
         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"BRANCHID|" + CUST.DATA.BranchId)
		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"ACCTNO|" + CUST.DATA.Accountnumber)
