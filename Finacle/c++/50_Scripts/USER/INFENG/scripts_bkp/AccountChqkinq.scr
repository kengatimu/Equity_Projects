	ENDIF

    	sv_k = " RequestId, BranchId, Accountnumber, Accountname, NofBooks, Nofchqlvs, BegChqinNo, EndChqNo, Reqstatus,Descstatus, DateRequested|SELECT "
		sv_k = sv_k + "req_id, branch_id,c.foracid,g.acct_name, c.NUM_OF_CHB ,c.NUM_OF_CHQ_LVS, begin_chq_num,(begin_chq_num+num_of_chq_lvs-1)end_chq_num ,req_status, "
		sv_k = sv_k + " decode(req_status, 'D' ,'Destroyed','A', 'Issued', 'S', 'Sent', 'E', 'Requested')ChqBookStatus ,req_date  "
		sv_k = sv_k + " FROM custom.custom_cbr  c, tbaadm.gam g  where g.foracid=c.foracid AND c.del_flg ='N' AND c.foracid= ?SVAR  AND c.bank_id=?SVAR "
		PRINT(sv_k)
     BANCS.INPARAM.BINDVARS = CUST.DATA.Foracid + "|" + BANCS.STDIN.contextBankId
     PRINT(BANCS.INPARAM.BINDVARS)

	sv_r = urhk_dbCursorOpenWithBind(sv_k)
	print(sv_r)

IF(sv_r==0) THEN
#{
        sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_m)
        sv_q = urhk_dbCursorFetch(sv_m)
