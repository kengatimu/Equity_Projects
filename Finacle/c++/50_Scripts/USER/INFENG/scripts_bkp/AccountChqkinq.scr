		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"CHQENDNO|" + CUST.DATA.EndChqNo)        
         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"STATUS|" + CUST.DATA.Reqstatus)
         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"STTUSDESCRIPTION|" + CUST.DATA.Descstatus)
		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"DATEREQUESTED|" + CUST.DATA.DateRequested)
		 
		sv_q = urhk_dbCursorFetch(sv_m)
