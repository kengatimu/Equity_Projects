		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"NOFBOOKS|" + CUST.DATA.NofBooks)
		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"NOOFCHQLVS|" + CUST.DATA.Nofchqlvs)
