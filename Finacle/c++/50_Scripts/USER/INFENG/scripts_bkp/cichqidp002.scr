<--START
CHECKSUM="6f48ded74d90f1ea9d6c0f80d8b90bb95ab71740a5f56bb58ff051429007e91c"
	TRACE ON
	
	######################################################
	# Creating Custom Repository
	######################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "PORT")
	
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "PORT", 5)
	#}
	ENDIF
	
	CUST.PORT.acctNum = BANCS.INPUT.acctNum
	PRINT(CUST.PORT.acctNum)
	
	########################################################
	## Acct Validation
	#######################################################
	sv_s = "count|"
	sv_s = sv_s + "SELECT count(*) "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE foracid = ?SVAR "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND acct_ownership != 'O' "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND acct_cls_flg = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	sv_s = sv_s + "AND  schm_type  in ('CAA','ODA','SBA')"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.PORT.acctNum + "|" + BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	CUST.PORT.count = BANCS.OUTPARAM.count
	print(CUST.PORT.count)
	IF (CUST.PORT.count == 0) THEN
	#{
		sv_e = "Incorrect Account No.Accounts of schm other than SBA,CAA,ODA are not allowed"
		sv_m = "RESULT_MSG|"
		sv_s = sv_m+sv_e
		sv_u = urhk_SetOrbOut(sv_s)
		#}
	ELSE
		#{
		sv_e = "Valid Account Number"
		sv_m = "MSG|"
		sv_s = sv_m+sv_e
		sv_u = urhk_SetOrbOut(sv_s)
	#}
	ENDIF
	
	TRACE OFF
	EXITSCRIPT
END-->
