<--START
TRACE ON


	#==============================================================================
	#       Intialising Variables
	#=============================================================================

	CUST.DATA.SOURCEFILE = CUST.DATA.FilePath
	print(CUST.DATA.SOURCEFILE)

	sv_r = urtn_fileAccess(CUST.DATA.SOURCEFILE)
	print(sv_r)
	IF ( sv_r != 0 ) THEN
		sv_r = urhk_TBAF_DispMesg("Unable to Access FILE_LIST")
		sv_v = "UNABLE TO ACCESS THE LIST OF FILES"
		GOTO ENDOFSCRIPT
	ENDIF

	#--------------------------
	#	OPENING THE FILE
	#--------------------------

	sv_t = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	print(sv_t)
	IF (sv_t < 0) THEN
		print("Unable to open the file")
		GOTO ENDOFSCRIPT
	ELSE
		print("File Opened SuccessFully")
		CUST.DATA.succIndex = sv_t
	ENDIF

	#===================================================================================================================
	#       Read The File Data
	#===================================================================================================================

	CUST.DATA.fileRec = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	PRINT(CUST.DATA.fileRec)
	sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
	PRINT(sv_t)
	IF(sv_t != 0) THEN
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "Error_03|ERROR^Upload file is empty^fileName"
		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
	ENDIF

	sv_z = 0
	sv_y = 0
	CUST.DATA.RECCNT = 0
	#=======================================================================================
	#       Split And Storage Of data in file
	#=======================================================================================

	WHILE(sv_t == 0)
	#{

		
		sv_y =format$(sv_z,"%d")
		CUST.DATA.RECCNT = cint(CUST.DATA.RECCNT)+1
		CUST.DATA.inputRecord         =       TOUPPER(CUST.DATA.inputRecord)
		sv_k = CUST.DATA.inputRecord
		print(sv_k)
		sv_q = getposition(sv_k,",")
		print(sv_q)
		if(sv_q == 0) then
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^Enter an Valid file^upldFile"
			sv_u = urhk_SetOrbOut(sv_z)
			EXITSCRIPT
		ENDIF
	
		sv_g = 0
		sv_n = 1

		sv_l = STRLEN (CUST.DATA.inputRecord)
		sv_c = CUST.DATA.inputRecord
		print(sv_c)
		sv_q = getposition(sv_c,",")
		print(sv_q)
		CUST.DATA.FORACID= Left$(sv_c,sv_q - 1)
		CUST.DATA.FORACID = TRIM(CUST.DATA.FORACID)
		print(CUST.DATA.FORACID)


		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		#sv_q = getposition(sv_c,",")
		CUST.DATA.SCHM = sv_c 
		CUST.DATA.SCHM = TRIM(CUST.DATA.SCHM)
		print(CUST.DATA.SCHM)
		

		#===================================================================================================
		#       STORAGE OF DATA INTO CUSTOM TABLE
		#===================================================================================================
			
		sv_s = " INSERT INTO custom.CUST_AUTO_ACCT_SCHM (FORACID, SCHMCODE, RCRE_USER_ID,FILE_NAME,RCRE_TIME, ENTITY_CRE_FLG, PROCESSED_FLG,FREE_TEXT2, BANK_ID ) "
		sv_s = sv_s + "  VALUES (?SVAR,?SVAR,?SVAR,?SVAR,sysdate,'N','N',?SVAR, ?SVAR)"
		BANCS.INPARAM.BINDVARS  = CUST.DATA.FORACID +"|"+ CUST.DATA.SCHM +"|"+ BANCS.STDIN.userId  + "|" + CUST.DATA.file_name  + "|" + CUST.DATA.RECCNT + "|" +  BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_r =  urhk_dbSQLwithbind(sv_s)
		print(sv_r)
		if(sv_r == 0)then
			sv_r = urhk_dbSQLwithbind("commit")
			print(sv_r)
			if(sv_r == 0)then
				CUST.DATA.sucess = "UPDATE SUCCESSFULL"
				CUST.DATA.scnt="1"
			else
				CUST.DATA.errorMsg  = " UPDATE FAILED"
				sv_r = urhk_dbSQLwithbind("ROLLBACK")
				GOTO NEXTREC1
			endif
		else
			CUST.DATA.errorMsg  = "UPDATE SOME ERROR IN THIS"
			sv_w =CUST.DATA.errorMsg+"  "+CUST.DATA.SOURCEFILE
			print(sv_w)
			sv_r = urhk_dbSQLwithbind("ROLLBACK")
			GOTO NEXTREC1
		endif
		
	

		NEXTREC1:
		sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
		PRINT(sv_t)
		sv_z = sv_z + 1


		CUST.DATA.recCount = sv_z
		print(CUST.DATA.recCount)
		sv_y = format$(sv_z,"%d")
		PRINT(sv_y)

	

	DO
	#===================================================================================#
	# Closing the files                                                                 #
	#===================================================================================#
	sv_j = urtn_fileClose(CUST.DATA.SOURCEFILE)
	print(sv_j)
	sv_t = urtn_fileClose(CUST.DATA.fileRec)
	PRINT(sv_t)
	sv_e = system("mv "+CUST.DATA.FilePath+" "+CUST.DATA.FilePath+"_Done")
	print(sv_e)
	
	
	##SCHME_CHANGE

	sv_s = "UPDATE CUSTOM.CUST_AUTO_ACCT_SCHM SET FREE_TEXT3 = 'X' where PROCESSED_FLG ='N' and FILE_NAME =?SVAR  and Bank_id =?SVAR "
	BANCS.INPARAM.BINDVARS =  CUST.DATA.file_name +"|"+  BANCS.STDIN.contextBankId 
	PRINT(sv_s)
	PRINT(sv_s)
	sv_d = urhk_dbSqlWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d==0)THEN
		sv_d = urhk_dbSqlWithBind("COMMIT")
	ENDIF

	CUST.DATA.Rec ="X"

	sv_s = "FORACID,SCHMCODE, ROW|select  FORACID,SCHMCODE, FREE_TEXT2 from CUSTOM.CUST_AUTO_ACCT_SCHM where   FILE_NAME= ?SVAR "
	sv_s = sv_s + " AND ENTITY_CRE_FLG = 'N' and PROCESSED_FLG ='N' and bank_id =?SVAR and FREE_TEXT3 =?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.DATA.file_name +"|"+  BANCS.STDIN.contextBankId  +"|"+  CUST.DATA.Rec
	sv_k = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_k)
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(sv_m)
	sv_c = urhk_dbCursorFetch(sv_m)
	PRINT(sv_c)
	IF(sv_c != 0)THEN
		CUST.DATA.messg="No records found "
		sv_c=urhk_dbCursorClose(sv_m)
		GOTO ENDOFSCRIPT
	ELSE
		sv_j = 0
		PRINT(sv_j)

		WHILE (sv_c == 0)

			CUST.DATA.FORACID =  BANCS.OUTPARAM.FORACID
			CUST.DATA.ROW = BANCS.OUTPARAM.ROW
			CUST.DATA.SCHMCODE = BANCS.OUTPARAM.SCHMCODE

			sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.FORACID)
			IF (sv_u == 0) THEN
				CUST.DATA.acctSolId  = BANCS.OUTPARAM.acctSolId

				CUST.DATA.schmType  = BANCS.OUTPARAM.schmType
				PRINT(CUST.DATA.schmType)
				CUST.DATA.schmcode  = BANCS.OUTPARAM.schmCode
				PRINT(CUST.DATA.schmcode)
				PRINT(CUST.DATA.SCHMCODE)	
				CUST.DATA.ClearBalance  = BANCS.OUTPARAM.ClearBalance
				PRINT(CUST.DATA.ClearBalance)
				CUST.DATA.CRNCY =  BANCS.OUTPARAM.acctCrncyCode
				Print (CUST.DATA.CRNCY)

				IF ( CUST.DATA.SCHMCODE == CUST.DATA.schmcode ) THEN					
					CUST.DATA.InfoRes = "Source N Destiantion Scheme are same_" + CUST.DATA.FORACID 
					CUST.DATA.Proc = "N"
					GOTO NEXTREC
				ENDIF

				IF ((CUST.DATA.schmType =="SBA") OR  (CUST.DATA.schmType =="CAA")) THEN
					
					PRINT(CUST.DATA.acctSolId)
					PRINT(BANCS.STDIN.mySolId)
					
					IF(CUST.DATA.acctSolId != BANCS.STDIN.mySolId)THEN
						sv_u = urhk_SetUrhkInp("sol.solId|" + CUST.DATA.acctSolId)
						print(sv_u)
						sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
						print(sv_u)
					ENDIF

					PRINT(BANCS.STDIN.mySolId)
					PRINT(CUST.DATA.FORACID)
					PRINT(CUST.DATA.CRNCY)
					PRINT(CUST.DATA.schmcode)
					PRINT(CUST.DATA.SCHMCODE)
					
					sv_a=urhk_SetUrhkInp("xferAcct.foracid|"+ CUST.DATA.FORACID)
					sv_a=urhk_SetUrhkInp("crncy.crncyCode|"+ CUST.DATA.CRNCY)
					sv_a=urhk_SetUrhkInp("sourceSchm.schmCode|"+ CUST.DATA.schmcode)
					sv_a=urhk_SetUrhkInp("targetSchm.schmCode|"+ CUST.DATA.SCHMCODE)
					sv_u = urhk_ExecSrv("SRV_XferAcctBtwnSchmsAndVerify|retain_all_output = Y|same_user_verify = Y")	
					PRINT(sv_u)
					IF (sv_u == 0 ) THEN							
								
						CUST.DATA.InfoRes = "Acct Schm change Success_" + CUST.DATA.FORACID 
						CUST.DATA.Proc = "Y"								
					ELSE
						if(repexists("EQSRV")==0)then
							createrep("EQSRV")
						endif
						if(classexists("EQSRV","GLBDATA")==0)then
							createclass("EQSRV","GLBDATA",5)
						endif
						EQSRV.GLBDATA.srvAcctId = CUST.DATA.FORACID 
						callscriptifexist("ebsrvHandler.scr")
						CUST.DATA.InfoRes = EQSRV.GLBDATA.SrvError							
						
						CUST.DATA.InfoRes = CUST.DATA.InfoRes +"_"+ CUST.DATA.FORACID 
						CUST.DATA.Proc = "N"							
					ENDIF		
				ELSE
					CUST.DATA.InfoRes = "Acct Not SBA/CAA" + CUST.DATA.FORACID 
					CUST.DATA.Proc = "N"
				ENDIF
			ELSE
				CUST.DATA.InfoRes = "Invalid Acct_" + CUST.DATA.FORACID 
				CUST.DATA.Proc = "N"
			ENDIF
	
			NEXTREC:

			Print (BANCS.STDIN.userId)
			Print (CUST.DATA.InfoRes)
			Print (CUST.DATA.Proc)
			Print (CUST.DATA.file_name)
			Print (CUST.DATA.ROW)

			sv_s = "  update  CUSTOM.CUST_AUTO_ACCT_SCHM set LCHG_USER_ID = ?SVAR , LCHG_TIME = sysdate , FREE_TEXT1 = ?SVAR  , ENTITY_CRE_FLG ='Y', PROCESSED_FLG =?SVAR where FILE_NAME = ?SVAR  and  FREE_TEXT2 =?SVAR and foracid =?SVAR and FREE_TEXT3 =?SVAR  "
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.userId + "|" + CUST.DATA.InfoRes +"|"+  CUST.DATA.Proc +"|"+  CUST.DATA.file_name + "|" + CUST.DATA.ROW  + "|" + CUST.DATA.FORACID  +"|"+ CUST.DATA.Rec
			print(BANCS.INPARAM.BINDVARS)
			print(sv_s)
			sv_d=urhk_dbSqlWithBind(sv_s)
			IF (sv_d == 0)  THEN
				sv_d = urhk_dbSQLWithBind("COMMIT")
			ENDIF

			sv_c = urhk_dbCursorFetch(sv_m)
			PRINT(sv_c)
		DO
		sv_c = urhk_dbCursorClose(sv_m)
		PRINT(sv_c)
	ENDIF	 


ENDOFSCRIPT:
EXITSCRIPT
#TRACE OFF
END-->
