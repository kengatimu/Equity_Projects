<--START
CHECKSUM="a07654d7db6e7787b1f0d896e2324f245c35838c10e8a14c33ccf9b6c38df4b9"
	TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
	#{
		CREATECLASS("CUST", "CHQB", 5)
	#}
	ENDIF
	CUST.CHQB.schmCode2= ""
	CUST.CHQB.schmCode3= ""
	
	CUST.CHQB.function 	= BANCS.INPUT.funcCode
	CUST.CHQB.requestId 	= BANCS.INPUT.requestId
	CUST.CHQB.acctNum	= BANCS.INPUT.acctNo
	
	IF((CUST.CHQB.function != "A" ) AND (CUST.CHQB.function != "D") AND (CUST.CHQB.function != "I") AND (CUST.CHQB.function != "V") AND (CUST.CHQB.function != "U") ) THEN
	#{
		sv_e = "The Valid choice Are A-Add,D-Delete,V-Verify,I-Inquiry AND U-Issue "
		sv_m = "funcCode"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# CPARAM set up
	#---------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "CHQB"
	BANCS.INPUT.parameterId = "SCHMCODE2"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CHQB.schmCode2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_e = "Schm code setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SCHMCODE3"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CHQB.schmCode3 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_e = "Schm code setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SCHMCODE9"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CHQB.schmCode9 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_e = "Schm code setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SCHMCODE10"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CHQB.schmCode10 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_e = "Schm code setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	IF((CUST.CHQB.function == "A") OR (CUST.CHQB.function == "U")) THEN
	#{
		IF (TRIM(CUST.CHQB.acctNum) == "") THEN
		#{
			sv_e = "Please enter account no"
			sv_m = "acctNo"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_x = "ValidateAccout|Select count(*) from tbaadm.gam where foracid = ?SVAR "
			sv_x = sv_x + " AND schm_type in ('CAA','ODA','SBA') AND entity_cre_flg = 'Y' AND del_flg !='Y' AND acct_cls_flg !='Y'"
			sv_x = sv_x + " AND bank_id = ?SVAR "
			print(sv_x)
			BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum   + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_x = urhk_dbSelectWithBind(sv_x)
			print(sv_x)
			IF (sv_x != 0 ) THEN
			#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.CHQB.valAcct = BANCS.OUTPARAM.ValidateAccout
				print(BANCS.OUTPARAM.ValidateAccout)
			#}
			ENDIF
			
			
			IF (CUST.CHQB.valAcct <= 0) THEN
			#{
				sv_e = "Incorrect Account No. / Accounts of schm other than (SBA,CAA,ODA) are not allowed"
				sv_m = "acctNo"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = urhk_getAcctDetailsInRepository(CUST.CHQB.acctNum)
			PRINT(sv_a)
			IF (sv_a == 0) THEN
			#{
				print(BANCS.OUTPARAM.freezeCode)
				IF (BANCS.OUTPARAM.freezeCode != " ") THEN
				#{
					sv_e = "Frozen Account ,Cheque Book request cannot be processed"
					sv_m = "acctNo"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				print(BANCS.STDIN.mySolId)
				print(BANCS.OUTPARAM.acctSolId)
				print(BANCS.OUTPARAM.schmCode)
				CUST.CHQB.schmCode = BANCS.OUTPARAM.schmCode
				PRINT(CUST.CHQB.schmCode)
				CUST.CHQB.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
				PRINT(CUST.CHQB.EffAvailableAmt)
				
				IF (BANCS.STDIN.mySolId != BANCS.OUTPARAM.acctSolId) THEN
				#{
					sv_e = "Account belongs to different SOL"
					sv_m = "acctNo"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				IF ((CUST.CHQB.schmCode == CUST.CHQB.schmCode9) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode10)) THEN
				#{
					sv_e = "Chq Book issue is not Allowed for this scheme"
					sv_m = "acctNo"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			IF(CUST.CHQB.function == "V" ) THEN
			#{
				sv_x = "MinBal|Select min_bal_for_chq_book from tbaadm.ssp where schm_code = ?SVAR "
				sv_x = sv_x + " AND crncy_code = ?SVAR AND del_flg !='Y' AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.CHQB.schmCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
				sv_x = urhk_dbselectWithBind(sv_x)
				
				IF (sv_x != 0 ) THEN
				#{
					sv_e = "A Database error has occured. Please contact your DBA."
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				print(BANCS.OUTPARAM.MinBal)
				
				IF (cdouble(CUST.CHQB.EffAvailableAmt) < cdouble(BANCS.OUTPARAM.MinBal)) THEN
				#{
					sv_e = "Account Balance is not sufficient to issue the Chq Book"
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			sv_x = "ACCT_STATUS|Select ACCT_STATUS from tbaadm.SMT where acid = (select acid from tbaadm.gam where foracid= ?SVAR AND bank_id = ?SVAR) AND bank_id = ?SVAR "
			print(sv_x)
			BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_x = urhk_dbSelectWithBind(sv_x)
			PRINT(sv_x)
			
			IF (sv_x != 0 ) THEN
			#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
			#{
				IF (BANCS.STDIN.contextBankId=="54") THEN
				#{

					IF (BANCS.OUTPARAM.ACCT_STATUS == "D") THEN
					#{
						sv_e = "Account is not active"
						sv_m = "acctNo"
						sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ELSE
				#{
					IF ((BANCS.OUTPARAM.ACCT_STATUS == "I") OR (BANCS.OUTPARAM.ACCT_STATUS == "D")) THEN
					#{
						sv_e = "Account is not active"
						sv_m = "acctNo"
						sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF( CUST.CHQB.function == "A" ) THEN
	#{
		BANCS.INPUT.moduleName  = "CHQB"
		BANCS.INPUT.parameterId = "CHQNO"
		CALL ("getcparamvalue.scr")
		
		IF(BANCS.OUTPUT.parameterVal != "")THEN
		#{
			CUST.CHQB.chqNo = BANCS.OUTPUT.parameterVal
			#}
		ELSE
			#{
			sv_e = "ChqNO setup not done in CPARAM"
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_s = "bcChqNo "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT NVL(MAX(TO_NUMBER(NVL(CBT.begin_chq_num,0)) + CBT.chq_num_of_lvs),1) "
		sv_s = sv_s + " FROM TBAADM.CBT,TBAADM.GAM "
		sv_s = sv_s + " WHERE GAM.foracid = ?SVAR "
		sv_s = sv_s + " AND GAM.acid = CBT.acid "
		sv_s = sv_s + " AND GAM.bank_id = CBT.bank_id "
		sv_s = sv_s + " AND TO_NUMBER(NVL(CBT.begin_chq_num,0)) < ?SVAR "
		sv_s = sv_s + " AND gam.bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + CUST.CHQB.chqNo + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.bcChqNo = BANCS.OUTPARAM.bcChqNo
			print(CUST.CHQB.bcChqNo)
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------
		# Validating account id if unverified record exists
		#-------------------------------------------------------------------------------
		sv_s = "reqId"
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT REQ_ID "
		sv_s = sv_s + " FROM CUSTOM.CUSTOM_CBR "
		sv_s = sv_s + " WHERE foracid = ?SVAR "
		sv_s = sv_s + " AND req_status IN ('A','E') "
		sv_s = sv_s + " AND BEGIN_CHQ_NUM = ?SVAR "
		sv_s = sv_S + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND rownum<2 "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + CUST.CHQB.bcChqNo + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0 ) THEN
		#{
			sv_e = "Cheque pending to be downloaded AND issued. Request Id " +  BANCS.OUTPARAM.reqId
			sv_e = "Error_2|ERROR:^"+ sv_e +".^acctNo"
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.CHQB.function!="") THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
