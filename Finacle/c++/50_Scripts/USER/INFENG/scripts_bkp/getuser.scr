<--START
CHECKSUM="7c035e771ff279c9240e686f62acfaf1a851f1b83c0a292d3312af8b07429365"
	TRACE ON
	
	BANCS.OUTPUT.lv_userId = BANCS.STDIN.EmployeeId
	
	sv_a = BANCS.STDIN.EmployeeId
	PRINT(sv_a)
	
	sv_s = "lv_username|"
	sv_s = sv_s + "SELECT emp_short_name "
	sv_s = sv_s + "FROM  TBAADM.GET "
	sv_s = sv_s + "WHERE emp_id = ?SVAR "
	sv_s = sv_s + "AND GET.del_flg = 'N' "
	sv_s = sv_s + "AND GET.entity_cre_flg = 'Y' "
	BANCS.INPARAM.BINDVARS = sv_a
	sv_u = urhk_dbselectWithBind(sv_s)
	PRINT(sv_u)
	
	IF ( sv_u == "0" ) THEN
	#{
		BANCS.OUTPUT.lv_username = TRIM(BANCS.OUTPARAM.lv_username)
		PRINT (BANCS.OUTPUT.lv_username)
		#}
	ELSE
		#{
		BANCS.OUTPUT.lv_username = " "
	#}
	ENDIF
	
	
	TRACE OFF
	EXITSCRIPT
END-->
