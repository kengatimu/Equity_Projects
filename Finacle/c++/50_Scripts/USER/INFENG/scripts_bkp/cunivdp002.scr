<--START
CHECKSUM="acb1a96c115541471c8b489b8e59b8fabee7c20faaad70ea098e2d7b61a634e4"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "STABI") == 0) THEN
	#{
		CREATECLASS("CUST", "STABI", 5)
	#}
	ENDIF
	
	CUST.STABI.funcCode = BANCS.INPUT.funcCode
	CUST.STABI.acctNum = BANCS.INPUT.foracid
	CUST.STABI.refNum = BANCS.INPUT.regNo
	CUST.STABI.name = BANCS.INPUT.stdName
	
	CUST.STABI.acctnum1 = ""
	CUST.STABI.acctnum2 = ""
	CUST.STABI.workclass = ""
	CUST.STABI.schmcode1 = ""
	CUST.STABI.schmcode2 = ""
	CUST.STABI.schmcode3 = ""
	CUST.STABI.errMsg    = ""
	CUST.STABI.solId     = ""
	
	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43")) THEN
	#{
		BANCS.INPUT.moduleName = "STUDANDBILL"
		BANCS.INPUT.parameterId = "ACCTNUM1"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.STABI.acctnum1 = BANCS.OUTPUT.parameterVal
			#}
		ELSE
			#{
			CUST.STABI.errMsg = "Account No 1 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		BANCS.INPUT.moduleName = "STUDANDBILL"
		BANCS.INPUT.parameterId = "ACCTNUM2"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.STABI.acctnum2 = BANCS.OUTPUT.parameterVal
			#}
		ELSE
			#{
			CUST.STABI.errMsg = "Account No 2 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		BANCS.INPUT.moduleName = "STUDANDBILL"
		BANCS.INPUT.parameterId = "SCHCODE3"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.STABI.schmcode3 = BANCS.OUTPUT.parameterVal
			#}
		ELSE
			#{
			CUST.STABI.errMsg = "Scheme Code 3 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		BANCS.INPUT.moduleName = "STUDANDBILL"
		BANCS.INPUT.parameterId = "SCHCODE2"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.STABI.schmcode2 = BANCS.OUTPUT.parameterVal
			#}
		ELSE
			#{
			CUST.STABI.errMsg = "Scheme Code 2 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	IF ((BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50"))THEN
	#{
		
		BANCS.INPUT.moduleName = "STUDANDBILL"
		BANCS.INPUT.parameterId = "SCHCODE2"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.STABI.schmcode2 = BANCS.OUTPUT.parameterVal
