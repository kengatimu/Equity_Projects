			#{
			CUST.STABI.errMsg = "Scheme Code 2 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "STUDANDBILL"
	BANCS.INPUT.parameterId = "SCHCODE1"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.STABI.schmcode1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.STABI.errMsg = "Scheme Code 1 setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	#-----------------------------------------------------------------------------
	# check if account no filed is blank.
	#-----------------------------------------------------------------------------
	IF(TRIM(CUST.STABI.acctNum) == "") THEN
	#{
		sv_e = "Please Enter account no."
		sv_m = "acctNum"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(CUST.STABI.acctNum)
		sv_z = TRIM(CUST.STABI.acctNum)
		sv_s = "ValidateAccout|SELECT count(1) "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE bank_id = ?SVAR "
		sv_s = sv_s + "AND foracid = ?SVAR "
		IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43")) THEN
		#{
			sv_s = sv_s + "AND schm_code IN (?SVAR,?SVAR,?SVAR) "
		#}
		ENDIF
		IF ((BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55")) THEN
		#{
			sv_s = sv_s + "AND schm_code IN (?SVAR,?SVAR)"
		#}
		ENDIF
		IF (BANCS.STDIN.contextBankId == "11")  THEN
		#{
			sv_s = sv_s + "AND schm_code = ?SVAR "
		#}
		ENDIF
		IF (BANCS.STDIN.contextBankId == "56") THEN
		#{
			sv_s = sv_s + "AND schm_type in ('CAA','SBA') "
		#}
		ENDIF
		
		sv_s = sv_s + "AND entity_cre_flg = 'Y' "
		sv_s = sv_s + "AND del_flg = 'N' "
		sv_s = sv_s + "AND acct_cls_flg = 'N' "
		
		IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43")) THEN
		#{
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.schmcode1 + "|" + CUST.STABI.schmcode2 + "|" + CUST.STABI.schmcode3
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
		IF ((BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55")) THEN
		#{
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.schmcode1 + "|" + CUST.STABI.schmcode2
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
		IF (BANCS.STDIN.contextBankId == "11") THEN
		#{
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.schmcode1
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
			IF (BANCS.STDIN.contextBankId == "56") THEN
		#{
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum 
			PRINT(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
		
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF (sv_d != 0) THEN
		#{
			STDWFS.WFSINPARAMVAL.ErrorMesg = "A Database error has occured. Please contact your DBA."
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43")) THEN
		#{
			IF ((CINT(BANCS.OUTPARAM.ValidateAccout)<= 0) AND (CUST.STABI.acctNum != CUST.STABI.acctnum1) AND (CUST.STABI.acctNum != CUST.STABI.acctnum1)) THEN
			#{
				sv_e = "Incorrect Account No. / Accounts of schm other than " + CUST.STABI.schmcode1 + ", " + CUST.STABI.schmcode2 +  ", " + CUST.STABI.schmcode3 + " are not allowed"
				sv_m = "acctNum"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF ((BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55")) THEN
		#{
			IF (CINT(BANCS.OUTPARAM.ValidateAccout) <= 0) THEN
			#{
				sv_e = "Incorrect Account No. / Accounts of schm other than " + CUST.STABI.schmcode1 + " , " + CUST.STABI.schmcode2 + " are not allowed"
				sv_m = "foracid"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.STABI.Position = 2
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId == "11")  THEN
		#{
			IF (CINT(BANCS.OUTPARAM.ValidateAccout) <= 0) THEN
			#{
				sv_e = "Incorrect Account No. / Accounts of schm other than "+ CUST.STABI.schmcode1 + " are not allowed"
				sv_m = "foracid"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.STABI.Position = 2
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF

		IF (BANCS.STDIN.contextBankId == "56") THEN
		#{
			IF (CINT(BANCS.OUTPARAM.ValidateAccout) <= 0) THEN
			#{
				sv_e = "Only accounts of scheme type CAA/SBA are allowed"
				sv_m = "foracid"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.STABI.Position = 2
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s = "solId|SELECT sol_id "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id  = ?SVAR "
	sv_s = sv_s + "AND foracid = ?SVAR "
	sv_s = sv_s + "AND acct_cls_flg = 'N' "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.STABI.acctNum
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.STABI.solId = BANCS.OUTPARAM.solId
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------
	#  Validation For STDNT Ref No
	#-----------------------------------------------------------------------------
	
	IF(TRIM(CUST.STABI.refNum) == "") THEN
	#{
		sv_e = "Please Enter Biller Code "
		sv_m = "refNum"
		sv_e = "Error_3|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_r = TRIM(CUST.STABI.refNum)
		print(sv_r)
		
		sv_s = "count|SELECT count(1) "
		sv_s = sv_s + "FROM CUSTOM.C_CIC_BILLS "
		sv_s = sv_s + "WHERE bank_id = ?SVAR "
		sv_s = sv_s + "AND acctNum = ?SVAR "
		sv_s = sv_s + "AND refNum = ?SVAR "
		sv_s = sv_s + "AND del_flg = 'N' "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.refNum
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.STABI.count = BANCS.OUTPARAM.count
			PRINT(CUST.STABI.count)
			IF (CINT(CUST.STABI.count) >= 1) THEN
			#{
				sv_s = "refNum,name|SELECT refNum,name "
				sv_s = sv_s + "FROM CUSTOM.C_CIC_BILLS "
				sv_s = sv_s + "WHERE bank_id = ?SVAR "
				sv_s = sv_s + "AND acctNum = ?SVAR "
				sv_s = sv_s + "AND refNum = ?SVAR "
				sv_s = sv_s + "AND del_flg = 'N' "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.refNum
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.STABI.refNum = BANCS.OUTPARAM.refNum
					PRINT(CUST.STABI.refNum)
					CUST.STABI.name = BANCS.OUTPARAM.name
					PRINT(CUST.STABI.name)
					sv_e = "Biller Code Already Exist: <b>" + CUST.STABI.refNum + " , " + CUST.STABI.name + "</b>"
					sv_m = "ref name"
					sv_e = "Error_3|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (FIELDEXISTS(CUST.STABI.name)) THEN
	#{
		PRINT(CUST.STABI.name)
		
		IF (TRIM(CUST.STABI.name) == "") THEN
		#{
			sv_e = " Please Enter The Biller name"
			sv_m = "name"
			sv_e = "Error_4|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_n = CUST.STABI.name
			PRINT(sv_n)
		#}
		ENDIF
	#}
	ENDIF
	
	#****************************************************************************
	#If function code is 'B'
	#****************************************************************************
	IF (CUST.STABI.funcCode == "B") THEN
	#{
		sv_s = "INSERT INTO CUSTOM.C_CIC_BILLS VALUES("
		sv_s = sv_s + "?SVAR, "
		sv_s = sv_s + "?SVAR, "
		sv_s = sv_s + "?SVAR, "
		sv_s = sv_s + "?SVAR, "
		sv_s = sv_s + "'N', "
		sv_s = sv_s + "?SVAR)"
		BANCS.INPARAM.BINDVARS = CUST.STABI.solId + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.refNum + "|" + CUST.STABI.name + "|" + BANCS.STDIN.contextBankId
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		
		IF (sv_d != 0) THEN
		#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|Record Exist <b>" + CUST.STABI.refNum + "</b>" + ". Database error has occured."
			sv_z = urhk_SetOrbOut(sv_g)
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_s = "INSERT INTO CUSTOM.C_UNIV(ACCTNUM,REFNUM,NAME,ENTERER_ID,AUDIT_DATE,AUDIT_BOD_DATE,FUNC,bank_id) VALUES("
			sv_s = sv_s + "?SVAR, "
			sv_s = sv_s + "?SVAR, "
			sv_s = sv_s + "?SVAR, "
			sv_s = sv_s + "?SVAR, "
			sv_s = sv_s + "sysdate, "
			sv_s = sv_s + "to_date(?SVAR, 'dd-mm-yyyy hh24:mi:ss'), "
			sv_s = sv_s + "?SVAR, "
			sv_s = sv_s + "?SVAR)"
			BANCS.INPARAM.BINDVARS = CUST.STABI.acctNum  	+ "|" + CUST.STABI.refNum
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.STABI.name
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.STABI.funcCode
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d != 0) THEN
			#{
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Record Exist <b>" + CUST.STABI.refNum + "</b>" + ". Database error has occured."
				sv_z = urhk_SetOrbOut(sv_g)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_d = urhk_dbSQLWithBind("COMMIT")
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Record Added Successfully <b>" + CUST.STABI.refNum + " , " + CUST.STABI.name + "</b>"
				sv_z = urhk_SetOrbOut(sv_g)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		IF(CUST.STABI.errMsg != "") THEN
		#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|" + CUST.STABI.errMsg
			PRINT(sv_g)
			sv_z = urhk_SetOrbOut(sv_g)
			PRINT(sv_z)
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
