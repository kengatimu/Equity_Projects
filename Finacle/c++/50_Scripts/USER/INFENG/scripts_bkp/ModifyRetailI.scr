					PRINT  (CUST.INTERFACE.PHONEPRE)
					CUST.INTERFACE.PHONESUF = MID$(CUST.INTERFACE.PHONE,3,14)
					PRINT (CUST.INTERFACE.PHONESUF)
					
					<PhoneEmailModData>                                                          
						<PhoneEmailTypeModData>                                                      
						<HiddenCustId>" + CUST.INTERFACE.CIF + "</HiddenCustId>                      
						<CustAttributeId>UPDATE</CustAttributeId>                                    
						</PhoneEmailTypeModData>                                                     
						<PhoneOrEmail>PHONE</PhoneOrEmail>                                         
						<PhoneEmailtType>CELLPH</PhoneEmailtType>     
						<PhoneNumCountryCode>" + CUST.INTERFACE.PHONEPRE + "</PhoneNumCountryCode>                                 
						<PhoneNumLocalCode>" + CUST.INTERFACE.PHONESUF + "</PhoneNumLocalCode>
						<PrefFlag>Y</PrefFlag>                                                
						<PhoneEmailID>" + CUST.INTERFACE.PHONEIDx + "</PhoneEmailID>             
					</PhoneEmailModData>  
				ENDIF
					
					
					IF (CUST.INTERFACE.EMAILMOD =="ADD") THEN
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailModData>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailTypeModData>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<HiddenCustId>" + CUST.INTERFACE.CIF + "</HiddenCustId>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustAttributeId>ADD</CustAttributeId>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PhoneEmailTypeModData>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneOrEmail>EMAIL</PhoneOrEmail>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailtType>" + CUST.INTERFACE.PHONEEMAILTYPE + "</PhoneEmailtType>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PrefFlag>Y</PrefFlag>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<email>" + CUST.INTERFACE.EMAIL + "</email>"
                                                CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PhoneEmailModData>"
                                        ENDIF
                                       


					IF (CUST.INTERFACE.EMAILMOD =="MODADD") THEN
						
						
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailDtls>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailType>CELLPH</PhoneEmailType>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneNumCountryCode>" + CUST.INTERFACE.PHONEPRE+ "</PhoneNumCountryCode>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneNumLocalCode>" + CUST.INTERFACE.PHONESUF+ "</PhoneNumLocalCode>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneOrEmail>PHONE</PhoneOrEmail>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PrefFlag>Y</PrefFlag>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PhoneEmailDtls>"

						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailModData>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailTypeModData>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<HiddenCustId>" + CUST.INTERFACE.CIF + "</HiddenCustId>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustAttributeId>UPDATE</CustAttributeId>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PhoneEmailTypeModData>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneOrEmail>EMAIL</PhoneOrEmail>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PhoneEmailtType>" + CUST.INTERFACE.PHONEEMAILTYPE2 + "</PhoneEmailtType>"
