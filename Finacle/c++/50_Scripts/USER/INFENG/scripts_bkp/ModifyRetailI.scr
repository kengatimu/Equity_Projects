						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Country>" + CUST.INTERFACE.COUNTRYx + "</Country>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<State>" + CUST.INTERFACE.STATEx + "</State>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PostalCode>" + CUST.INTERFACE.ZIPx + "</PostalCode>"				
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<StartDt>" + CUST.INTERFACE.msgDateTime + "</StartDt>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetAddrModDtls>"
					ENDIF
CUST.INTERFACE.EMAILMOD = ""

				IF (CUST.INTERFACE.EMAILMOD =="ADD") THEN
				
					CUST.INTERFACE.PHONE=BANCS.OUTPARAM.PHONE
					PRINT (CUST.INTERFACE.PHONE)
