<--start
trace on
#Rep/Class
	if(repexists("OCLG")==0)then
		createrep("OCLG")
	endif
	if(classexists("OCLG","GLBDATA")==0)then
		createclass("OCLG","GLBDATA",5)
	endif
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
#####exitscript
#SrvValues
	OCLG.GLBDATA.trans_amt ="" 
	OCLG.GLBDATA.trans_crncy = ""
	sv_u = urhk_SRV_GetVal("ocSet.zoneHeader.solId.solId")
	OCLG.GLBDATA.zsolId=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("ocSet.zoneHeader.zoneDate")
	OCLG.GLBDATA.zzoneDate=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("ocSet.zoneHeader.zoneCode")
	OCLG.GLBDATA.zzoneCode=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("ocSet.zoneHeader.zoneCrncyCode.crncyCode")
	OCLG.GLBDATA.zcrncyCode=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_NumOfRecs("ocSet.instrLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	if(cint(sv_i)==0)then
		sv_u = urhk_SRV_SetErr("Function Not Allowed")
		BANCS.OUTPUT.successOrFailure="F"
		##BANCS.OUTPUT.fatalErrorFlg=""
		BANCS.OUTPUT.fatalErrorMsg="Regularize Not Allowed"
		exitscript
	endif
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("ocSet.instrLL.<rec_" + sv_j + ">.payingAcctId")
			OCLG.GLBDATA.payingAcctId=BANCS.OUTPARAM.srvValue
			print(OCLG.GLBDATA.payingAcctId)
		sv_u = urhk_SRV_GetVal("ocSet.instrLL.<rec_" + sv_j + ">.instrmntAmt")
			OCLG.GLBDATA.instrmntAmt=BANCS.OUTPARAM.srvValue
			print(OCLG.GLBDATA.instrmntAmt)
		sv_u = urhk_SRV_GetVal("ocSet.instrLL.<rec_" + sv_j + ">.delFlg")
			OCLG.GLBDATA.delFlg=BANCS.OUTPARAM.srvValue
			print(OCLG.GLBDATA.delFlg)
                sv_l = strlen(OCLG.GLBDATA.instrmntAmt)
                sv_f = mid$(OCLG.GLBDATA.instrmntAmt,0,sv_l)
                sv_l = strlen(OCLG.GLBDATA.instrmntAmt)
                sv_p = getposition(sv_f,"|")
                OCLG.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
                OCLG.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
                print(OCLG.GLBDATA.trans_amt)
                print(OCLG.GLBDATA.trans_crncy)
                print(OCLG.GLBDATA.instrmntAmt)
		if(OCLG.GLBDATA.payingAcctId!="")then
			sv_u = urhk_getAcctDetailsInRepository(OCLG.GLBDATA.payingAcctId)
			if(sv_u==0)then
				OCLG.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
				OCLG.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
				OCLG.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance   
				print(OCLG.GLBDATA.clearBalance)
				OCLG.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
				print(OCLG.GLBDATA.EffAvailableAmt)
				OCLG.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt 
				print(OCLG.GLBDATA.AvailableAmt)
				###if(cdouble(OCLG.GLBDATA.trans_amt)>cdouble(OCLG.GLBDATA.EffAvailableAmt))then
				##if(cdouble(OCLG.GLBDATA.clearBalance)<0)then
				##	sv_u = urhk_SRV_SetErr("Insufficient Fund in PayingAccount :"+ OCLG.GLBDATA.payingAcctId )
				##	BANCS.OUTPUT.successOrFailure="F"
				##	##BANCS.OUTPUT.fatalErrorFlg=""
				##	BANCS.OUTPUT.fatalErrorMsg="Regularize Not Allowed"
				##	exitscript
				##endif
                                if(cdouble(OCLG.GLBDATA.AvailableAmt)<=0)then
                                        sv_u = urhk_SRV_SetErr("Insufficient Fund in PayingAccount :"+ OCLG.GLBDATA.payingAcctId )
                                        BANCS.OUTPUT.successOrFailure="F"
                                        ##BANCS.OUTPUT.fatalErrorFlg=""
                                        BANCS.OUTPUT.fatalErrorMsg="Regularize Not Allowed"
                                        exitscript
                                endif
                                if(cdouble(OCLG.GLBDATA.EffAvailableAmt)<=0)then
                                        sv_u = urhk_SRV_SetErr("Insufficient Fund in PayingAccount :"+ OCLG.GLBDATA.payingAcctId )
                                        BANCS.OUTPUT.successOrFailure="F"
                                        ##BANCS.OUTPUT.fatalErrorFlg=""
                                        BANCS.OUTPUT.fatalErrorMsg="Regularize Not Allowed"
                                        exitscript
                                endif
			endif
		endif
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
VAYU:	
	if(classexists("OCLG","GLBDATA")==1) then
		deleteclass("OCLG","GLBDATA")
	endif
	if(repexists("OCLG")==1) then
		deleterep("OCLG")
	endif
	exitscript
##trace off
end-->

