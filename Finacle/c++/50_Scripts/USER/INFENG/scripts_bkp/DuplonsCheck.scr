#DuplonsCheck.scr
<--START
	# Script body goes here

	TRACE ON

	sv_r=urhk_B2k_PrintRepos("BANCS")
	print(sv_r)
	
	#==================================================================================================
	# Repository and Class Creation
	#==================================================================================================
	IF (REPEXISTS("CUST")== 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST" , "DATA",5)
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","RATE") == 0) THEN
	#{
		CREATECLASS("CUST" , "RATE",5)
	#}
	ENDIF


CUST.DATA.errFlg = "N"
CUST.DATA.MSG = "No tran found"
CUST.DATA.tran_id = " "

CUST.DATA.TranAcct=BANCS.INPUT.TranAcct
CUST.DATA.TranAmt =BANCS.INPUT.TranAmt
CUST.DATA.TranDate=BANCS.INPUT.TranDate
CUST.DATA.RefNum = BANCS.INPUT.RefNum



Print (CUST.DATA.TranAcct)
Print (CUST.DATA.TranAmt)
Print (CUST.DATA.TranDate)
Print (CUST.DATA.RefNum)



CUST.DATA.BodDate =  mid$(CUST.DATA.TranDate,0,10)
print(CUST.DATA.BodDate)


sv_d = "StartDate| select to_char (to_date(?SVAR,'YYYY-MM-DD'),'DD-MON-YYYY')  as StartDate FROM dual"
BANCS.INPARAM.BINDVARS = CUST.DATA.BodDate
print(sv_d)
print(BANCS.INPARAM.BINDVARS)
sv_u = urhk_dbSelectWithBind(sv_d)
if(sv_u==0)then
    CUST.DATA.StartDate =BANCS.OUTPARAM.StartDate
    print(CUST.DATA.StartDate)
endif




IF (FIELDEXISTS(BANCS.INPUT.TranAcct)) THEN
	sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.TranAcct)
	PRINT(sv_u)

	IF(sv_u == 0)THEN
	#{

	#Dtd Check
		sv_a = " count|select count  (*) from tbaadm.dtd a , tbaadm.gam b  where  foracid = ?SVAR and b.bank_id=?SVAR  "
		sv_a = sv_a + " and  b.acid  = a.acid and REF_AMT = ?SVAR and b.bank_id = a.bank_id  and REF_NUM =?SVAR " 
		print(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.DATA.TranAcct + "|" +  BANCS.STDIN.contextBankId + "|" + CUST.DATA.TranAmt    + "|" + CUST.DATA.RefNum 
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_a)
		print(sv_b)
		IF(sv_b == 0)THEN
			PRINT(BANCS.OUTPARAM.count)
			IF(BANCS.OUTPARAM.count > 0) THEN
				sv_a = " tran_id |select tran_id  from tbaadm.dtd a , tbaadm.gam b  where  foracid = ?SVAR and b.bank_id=?SVAR  "
				sv_a = sv_a + " and  b.acid  = a.acid and REF_AMT = ?SVAR and b.bank_id = a.bank_id  and REF_NUM =?SVAR and rownum=1 " 
				print(sv_a)
				BANCS.INPARAM.BINDVARS = CUST.DATA.TranAcct  + "|" +  BANCS.STDIN.contextBankId + "|" + CUST.DATA.TranAmt    + "|" + CUST.DATA.RefNum 
				print(BANCS.INPARAM.BINDVARS)
				sv_b = urhk_dbSelectWithBind(sv_a)
				print(sv_b)				
				IF(sv_b == 0)THEN
					CUST.DATA.tran_id = BANCS.OUTPARAM.tran_id
					CUST.DATA.MSG="Transaction Exist for "+CUST.DATA.TranAcct+" Amount "+CUST.DATA.TranAmt+" And refnum "+CUST.DATA.RefNum  
					CUST.DATA.errFlg = "Y"
					Print (CUST.DATA.MSG)
					GOTO ENDOFSCRIPT
				ENDIF
			ENDIF
		ENDIF

	#Htd Check		
		sv_a = " count|select count  (*) from tbaadm.htd a , tbaadm.gam b  where  foracid = ?SVAR and b.bank_id=?SVAR and  b.acid  = a.acid  "
		sv_a = sv_a + "  and tran_amt = ?SVAR and b.bank_id = a.bank_id and  REF_NUM =?SVAR  and a.tran_date >= '"+CUST.DATA.StartDate+"'    " 
		print(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.DATA.TranAcct   + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.DATA.TranAmt + "|" + CUST.DATA.RefNum 
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_a)
		print(sv_b)
		IF(sv_b == 0)THEN
			PRINT(BANCS.OUTPARAM.count)
			IF(BANCS.OUTPARAM.count > 0) THEN				
				sv_a = " tran_id |select  tran_id  from tbaadm.htd a , tbaadm.gam b  where  foracid = ?SVAR and b.bank_id=?SVAR and  b.acid  = a.acid  "
				sv_a = sv_a + "  and tran_amt = ?SVAR and b.bank_id = a.bank_id and  REF_NUM =?SVAR  and a.tran_date >= '"+CUST.DATA.StartDate+"'    " 
				print(sv_a)
				BANCS.INPARAM.BINDVARS = CUST.DATA.TranAcct   + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.DATA.TranAmt + "|" + CUST.DATA.RefNum 
				print(BANCS.INPARAM.BINDVARS)
				sv_b = urhk_dbSelectWithBind(sv_a)
				print(sv_b)
				IF(sv_b == 0)THEN
					CUST.DATA.tran_id = BANCS.OUTPARAM.tran_id
					CUST.DATA.MSG="Transaction Exist for "+CUST.DATA.TranAcct+" Amount "+CUST.DATA.TranAmt+" And refnum "+CUST.DATA.RefNum  
					CUST.DATA.errFlg = "Y"
					Print (CUST.DATA.MSG)
					GOTO ENDOFSCRIPT					
				ENDIF
			ENDIF
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.MSG ="Customer Account Not Valid"
		GOTO ENDOFSCRIPT
	ENDIF
ELSE
	CUST.DATA.errFlg = "Y"
	CUST.DATA.MSG = "Customer Account Not Entered"
	GOTO ENDOFSCRIPT
ENDIF


ENDOFSCRIPT:

        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.MSG)
	sv_u = urhk_SetOrbOut("TranId|"+CUST.DATA.tran_id)
EXITSCRIPT
END-->


