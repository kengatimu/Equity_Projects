<--START
TRACE ON

#-----------------------------------------------------------------------------------------------
# Creating Repositories and classes
#-----------------------------------------------------------------------------------------------
sv_u = REPEXISTS("CUST")
IF (sv_u == 0) THEN
	CREATEREP("CUST")
ENDIF

sv_u = CLASSEXISTS("CUST", "DATA")
IF (sv_u == 0) THEN
	CREATECLASS("CUST", "DATA", 5)
ENDIF

#-----------------------------------------------------------------------------------------------
# Initializing Out Variables
#-----------------------------------------------------------------------------------------------
sv_u = urhk_SetOrbOut("intRate| ")
print(sv_u)

#-----------------------------------------------------------------------------------------------
# Getting inputs from frond end
#-----------------------------------------------------------------------------------------------
CUST.DATA.crncyCode 		= TOUPPER(TRIM(BANCS.INPUT.crncyCode))
CUST.DATA.schmCode 			= TOUPPER(TRIM(BANCS.INPUT.schmCode))
CUST.DATA.loanAmt 			= TOUPPER(TRIM(BANCS.INPUT.loanAmt))
CUST.DATA.loanTenorMonths 	= TOUPPER(TRIM(BANCS.INPUT.loanTenorMonths))
CUST.DATA.loanTenorDays 	= TOUPPER(TRIM(BANCS.INPUT.loanTenorDays))
CUST.DATA.originDate 		= TOUPPER(TRIM(BANCS.INPUT.originDate))

#-----------------------------------------------------------------------------------------------
# Getting BIC code of bank and branch
#-----------------------------------------------------------------------------------------------
sv_s = ""
sv_s = sv_s + " intTblCode,minIntRate,maxIntRate|"
sv_s = sv_s + " SELECT CSP.int_tbl_code,nvl(CSP.MIN_INT_PCNT_DR,0),nvl(CSP.MAX_INT_PCNT_DR,0) " 
sv_s = sv_s + " FROM TBAADM.CSP"
sv_s = sv_s + " WHERE CSP.crncy_code = ?SVAR "
sv_s = sv_s + " AND CSP.schm_code = ?SVAR"
sv_s = sv_s + " AND CSP.bank_id = ?SVAR"
print(sv_s)
BANCS.INPARAM.BINDVARS =  CUST.DATA.crncyCode  	+ "|" + CUST.DATA.schmCode
BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS 	+ "|" + BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbselectWithBind(sv_s)
print(sv_d)

IF (sv_d == 0) THEN
#{
	CUST.DATA.intTblCode = BANCS.OUTPARAM.intTblCode
	print(CUST.DATA.intTblCode)
	CUST.DATA.minIntRate = BANCS.OUTPARAM.minIntRate
	print(CUST.DATA.minIntRate)
	CUST.DATA.maxIntRate = BANCS.OUTPARAM.maxIntRate
	print(CUST.DATA.maxIntRate)

	sv_s = ""
	sv_s = sv_s + " intTblVerNum|"
	sv_s = sv_s + " SELECT MAX(ICV.int_version)" 
	sv_s = sv_s + " FROM TBAADM.ICV"
	sv_s = sv_s + " WHERE ICV.int_tbl_code = ?SVAR "
	sv_s = sv_s + " AND ICV.crncy_code = ?SVAR"
	sv_s = sv_s + " AND ICV.bank_id = ?SVAR"
	sv_s = sv_s + " AND ICV.del_flg = 'N'"
	sv_s = sv_s + " AND ICV.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND TO_DATE(?SVAR,'dd-mm-yyyy') BETWEEN start_date AND end_date"

#	sv_s = sv_s + " SELECT MAX(LAVS.int_tbl_ver_num)"
#	sv_s = sv_s + " FROM TBAADM.LAVS"
#	sv_s = sv_s + " WHERE LAVS.int_tbl_code = ?SVAR "
#	sv_s = sv_s + " AND LAVS.crncy_code = ?SVAR"
#	sv_s = sv_s + " AND LAVS.bank_id = ?SVAR"
#	sv_s = sv_s + " AND LAVS.int_slab_dr_cr_flg = 'D'"
#	sv_s = sv_s + " AND LAVS.del_flg = 'N'"
#	sv_s = sv_s + " AND LAVS.entity_cre_flg = 'Y'"

	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.intTblCode  		+ "|" + CUST.DATA.crncyCode
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS 	+ "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS 	+ "|" + CUST.DATA.originDate
	print(BANCS.INPARAM.BINDVARS)

	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)

	IF (sv_d == 0) THEN
	#{
		CUST.DATA.intTblVerNum = BANCS.OUTPARAM.intTblVerNum
		print(CUST.DATA.intTblVerNum)

		sv_s = ""
		sv_s = sv_s + " intRate|"
		sv_s = sv_s + " SELECT tbaadm.CommonPackage.loanschminterest(?SVAR, ?SVAR, 'D', ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR) " 
		sv_s = sv_s + " FROM DUAL"

		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.intTblCode 	+ "|" + CUST.DATA.intTblVerNum
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.loanAmt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.loanTenorMonths
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.loanTenorDays
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.crncyCode
		print(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)

		IF (sv_d == 0) THEN
		#{
			CUST.DATA.intRate = BANCS.OUTPARAM.intRate
			print(CUST.DATA.intRate)
			IF (CUST.DATA.intRate != "") THEN
			#{
				IF (CDOUBLE(CUST.DATA.intRate) < CDOUBLE(CUST.DATA.minIntRate)) THEN
				#{
					CUST.DATA.intRate = CUST.DATA.minIntRate
				#}
				ENDIF

				IF (CDOUBLE(CUST.DATA.intRate) > CDOUBLE(CUST.DATA.maxIntRate)) THEN
				#{
					CUST.DATA.intRate = CUST.DATA.maxIntRate
				#}
				ENDIF

				sv_u = urhk_SetOrbOut("intRate|"+CUST.DATA.intRate)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
#}
ENDIF

EXITSCRIPT
END-->
