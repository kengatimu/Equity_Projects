<--START
TRACE ON

        #---------------------------------
        # Rep and Class Creation
        #---------------------------------
        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF(CLASSEXISTS("CUST","DATA") == 0)THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF
		
		IF(BANCS.STDIN.contextBankId !="54") THEN
		#{
				GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.DATA.Errormsg = ""
		IF((FIELDEXISTS(BANCS.INPUT.AccountNumber) == 1) AND (FIELDEXISTS(BANCS.INPUT.Instrumentnum)==1))THEN
		#{
				CUST.DATA.foracid = BANCS.INPUT.AccountNumber
				CUST.DATA.Instrumentnum = BANCS.INPUT.Instrumentnum
		#}
		ELSE
		#{
				CUST.DATA.Errormsg = "Kindly pass Account Number And Instrument Number"
				GOTO ERRORBLOCK
		#}
		ENDIF
		IF((FIELDEXISTS(BANCS.INPUT.InstrumentDate) == 1) AND (FIELDEXISTS(BANCS.INPUT.InstrumentType)==1))THEN
		#{
				CUST.DATA.InstrumentDate = BANCS.INPUT.InstrumentDate
				CUST.DATA.InstrumentType = BANCS.INPUT.InstrumentType
		#}
		ENDIF
		sv_a = urhk_valAcctNumber(CUST.DATA.foracid)
		if(sv_a!=0)then
		#{
				CUST.DATA.Errormsg = "Account Number Not Valid"
				GOTO ERRORBLOCK
		#}
		endif
	
		print(CUST.DATA.foracid)
		print(CUST.DATA.Instrumentnum)
	
		BANCS.INPARAM.BINDVARS = CUST.DATA.Instrumentnum+"|"+CUST.DATA.foracid +"|"+CUST.DATA.Instrumentnum
		sv_d = "chqstatus|SELECT SUBSTR(CBT.CHQ_LVS_STAT,TO_NUMBER(?SVAR) - TO_NUMBER(LTRIM(CBT.BEGIN_CHQ_NUM)) + 1,1) FROM tbaadm.CBT  "
		sv_d = sv_d + " where acid=(select acid from tbaadm.gam where foracid =?SVAR and  bank_id ='54' and entity_cre_flg='Y' and DEL_FLG ='N' and ACCT_CLS_FLG = 'N' and acct_cls_date is null and chq_alwd_flg='Y' ) "
		sv_d = sv_d + " AND ?SVAR BETWEEN TO_NUMBER(LTRIM(BEGIN_CHQ_NUM)) AND TO_NUMBER(LTRIM(BEGIN_CHQ_NUM)) + CHQ_NUM_OF_LVS - 1 "
		PRINT(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_d)
		IF(sv_b==0)then
		#{
				CUST.DATA.chqstatus = BANCS.OUTPARAM.chqstatus
				print(CUST.DATA.chqstatus)	
		#}
		ELSE
		#{
				CUST.DATA.Errormsg = "Enter Valid  Account For Fetching Cheque status  ..!"
				GOTO ERRORBLOCK
		#}
		ENDIF
		print(CUST.DATA.chqstatus)
		IF(CUST.DATA.chqstatus!="")then
		#{
			CUST.DATA.chequestatus = CUST.DATA.chqstatus
			IF(CUST.DATA.chqstatus=="U")THEN
					CUST.DATA.chequestatus ="UnUsed"
			ENDIF
			IF(CUST.DATA.chqstatus=="P")THEN
					CUST.DATA.chequestatus ="Passed"
			ENDIF
			IF(CUST.DATA.chqstatus=="S")THEN
					CUST.DATA.chequestatus ="Stopped"
			ENDIF
			IF(CUST.DATA.chqstatus=="C")THEN
					CUST.DATA.chequestatus ="Cautioned"
			ENDIF
			IF(CUST.DATA.chqstatus=="D")THEN
					CUST.DATA.chequestatus ="Destroyed"
			ENDIF
			IF(CUST.DATA.chqstatus=="R")THEN
					CUST.DATA.chequestatus ="Returned"
			ENDIF
			IF(CUST.DATA.chqstatus=="T")THEN
					CUST.DATA.chequestatus ="Transferred"
			ENDIF
			sv_u = urhk_SetOrbOut("AccountNumber|"+ CUST.DATA.foracid)
			sv_u = urhk_SetOrbOut("ChequeNumber|"+ CUST.DATA.Instrumentnum)
			sv_u = urhk_SetOrbOut("ChequeStatus|"+ CUST.DATA.chequestatus)
			GOTO ENDOFSCRIPT
		#}
		else
		#{
				CUST.DATA.Errormsg ="COULDN'T FETCH CHEQUE STATUS"
		#}
		ENDIF
	
		ERRORBLOCK:
                        sv_u = urhk_SetOrbOut("STATUS|"+CUST.DATA.Errormsg)


ENDOFSCRIPT:
EXITSCRIPT
TRACE OFF
END-->

