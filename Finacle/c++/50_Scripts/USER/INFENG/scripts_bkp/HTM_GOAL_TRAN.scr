        else
                CPLTM.GLBDATA.crChrCrncy        = ""
                CPLTM.GLBDATA.drChrgSolId       = ""
        #}
        endif

##Fetching Remittance commission account
    CPLTM.GLBDATA.crChrBacid = "REMITCOMM"
    sv_t = CPLTM.GLBDATA.crChrBacid +"|"+ CPLTM.GLBDATA.crChrCrncy +"|"+ BANCS.STDIN.mySolId
    print(sv_t)
    sv_u = urhk_B2k_BacidToAcctId(sv_t)
    if(sv_u == 0 )then
            CPLTM.GLBDATA.crChrgAcctId =BANCS.OUTPARAM.AcctId
            print(CPLTM.GLBDATA.crChrgAcctId)
    else
            CPLTM.GLBDATA.crChrgAcctId = ""
    endif

        CPLTM.GLBDATA.TranParticulars ="GOALSVGAC"
#       CPLTM.GLBDATA.refAmt = "10"
        CPLTM.GLBDATA.refCrncy = "KES"

CPLTM.GLBDATA.Date = BANCS.STDIN.BODDate
##Main Transaction
        ### Debit Transaction
                sv_i = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
                sv_i = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|CI")
                sv_i = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+CPLTM.GLBDATA.Date )
                sv_i = urhk_SetUrhkInp("tranHdr.tranRmks|CALL DEPOSIT")
                sv_i = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
                sv_i = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")

                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + CPLTM.GLBDATA.Date  )
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + CPLTM.GLBDATA.Date  )
                sv_i = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")

                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranCrncyCode.crncyCode|KES")
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|" + CPLTM.GLBDATA.refCrncy )
