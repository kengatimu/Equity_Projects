BANCS.INPUT.srvErrorCode        = ""

        sv_u = urhk_SRV_GetVal("tranInpDtl.tranInp.acctDr.foracid")
        print(sv_u)
        CPLTM.GLBDATA.Dracno= BANCS.OUTPARAM.srvValue
        print(CPLTM.GLBDATA.Dracno)

        sv_u = urhk_SRV_GetVal("acctSchmTD.tdGenSchmDtl.tdBasicSchmDtl.depositAmt")
        CPLTM.GLBDATA.Dramt= BANCS.OUTPARAM.srvValue
        print(CPLTM.GLBDATA.Dramt)
        CPLTM.GLBDATA.refAmt = CPLTM.GLBDATA.Dramt

        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.foracid")
        CPLTM.GLBDATA.QResproviderGL= BANCS.OUTPARAM.srvValue
        print(CPLTM.GLBDATA.QResproviderGL)

#chrg Amt
        sv_u = urhk_getAcctDetailsInRepository(CPLTM.GLBDATA.Dracno)
