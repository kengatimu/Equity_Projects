                #sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rate|" + CPLTM.GLBDATA.rate)
                #sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRate|" + CPLTM.GLBDATA.rate)
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|" +CPLTM.GLBDATA.refAmt+ "|" + CPLTM.GLBDATA.crChrCrncy)
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|" + CPLTM.GLBDATA.Dracno )

                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|" + CPLTM.GLBDATA.Date  )
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refNum|" + CPLTM.GLBDATA.QResproviderGL )
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|" + CPLTM.GLBDATA.TranParticulars )
                sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|Goal ACC" )
                #sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars2|GOALSVGACC ")

        ##Credit Transaction Details
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + CPLTM.GLBDATA.Date  )
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + CPLTM.GLBDATA.Date  )
                        sv_i = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|" + CPLTM.GLBDATA.refCrncy )
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|" + CPLTM.GLBDATA.refAmt + "|" + CPLTM.GLBDATA.refCrncy )
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|" + CPLTM.GLBDATA.QResproviderGL)
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+CPLTM.GLBDATA.Date  )
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|" + CPLTM.GLBDATA.QResproviderGL )
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|" + CPLTM.GLBDATA.TranParticulars )
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|GOAL Saving")
                        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars2|GOAL")


                sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
                sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
                sv_u = urhk_ExecSrv("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y")



    print(sv_u)
    if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
        #{
        print(BANCS.OUTPARAM.successOrFailure)
                if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
                #{
                        callscriptifexist("trapSRVerror.scr")
                        if(fieldexists(CUST.DATA.errorMsg)==1)then
                                CPLTM.GLBDATA.srvMsg            = CUST.DATA.errorMsg
