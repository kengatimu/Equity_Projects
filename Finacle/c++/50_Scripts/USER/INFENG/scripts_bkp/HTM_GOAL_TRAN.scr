                        endif
                #}
                endif

                if((BANCS.OUTPARAM.successOrFailure=="S") and (sv_u==0))then
                #{
                        print(BANCS.OUTPARAM.tranId)
                        print(BANCS.OUTPARAM.tranDate)
                        BANCS.INPUT.linkTranId          = BANCS.OUTPARAM.tranId
                        CPLTM.GLBDATA.tranId = BANCS.OUTPARAM.tranId
