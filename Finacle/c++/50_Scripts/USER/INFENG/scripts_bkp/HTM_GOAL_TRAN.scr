 PRINT(ONS.CUSTOM.custDataOut)


CPLTM.GLBDATA.srvMsg            = ""
CPLTM.GLBDATA.srvErrorCode      = ""
CPLTM.GLBDATA.srvSF             = ""
CPLTM.GLBDATA.tranId            = ""
CPLTM.GLBDATA.tranDate          = ""
BANCS.INPUT.linkTranId          = ""
