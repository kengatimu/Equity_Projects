                        BANCS.INPUT.linktranDate        = BANCS.OUTPARAM.tranDate
                        BANCS.INPUT.srvMsg                      = "Call Deposit Transaction Created "
                        BANCS.INPUT.srvErrorCode        = "000"
                #}
                endif
        #}
        endif
