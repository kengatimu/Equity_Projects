	#--------------------------------------------------------------------------
	# Code for creating tranxs like individual debit from customer and
	# consolidated credit to the income Account.
	#--------------------------------------------------------------------------
	WHILE (sv_c == 0)
	#{
		sv_c = urhk_dbCursorFetch(MISS.CHRG.MainCursor)
		PRINT(sv_c)
		IF (sv_c != 0) THEN
		#{
			sv_s = "DELETE FROM CUSTOM.C_MOC "
			sv_s = sv_s + " WHERE sol_id = ?SVAR "
			sv_s = sv_s + " AND tran_date = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + MISS.CHRG.date + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSQLWithBind(sv_s)
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			sv_c = 1
			#}
		ELSE
			#{
			MISS.CHRG.foracid           = BANCS.OUTPARAM.foracid
			MISS.CHRG.schm_code         = BANCS.OUTPARAM.schm_code
			MISS.CHRG.schm_type         = BANCS.OUTPARAM.schm_type
			MISS.CHRG.acct_crncy_code   = BANCS.OUTPARAM.acct_crncy_code
			MISS.CHRG.tran_id           = BANCS.OUTPARAM.tran_id
			MISS.CHRG.part_tran_srl_num = BANCS.OUTPARAM.part_tran_srl_num
			MISS.CHRG.tran_amt          = BANCS.OUTPARAM.tran_amt
			MISS.CHRG.clr_bal_amt       = BANCS.OUTPARAM.clr_bal_amt
			
			PRINT(MISS.CHRG.foracid)
			PRINT(MISS.CHRG.schm_code)
			PRINT(MISS.CHRG.schm_type)
			PRINT(MISS.CHRG.tran_id)
			PRINT(MISS.CHRG.part_tran_srl_num)
			PRINT(MISS.CHRG.tran_amt)
			PRINT(MISS.CHRG.clr_bal_amt)
			
			
			MISS.CHRG.with  = "Y"
			MISS.CHRG.stamp = "N"
			MISS.CHRG.Min   = "N"
			
			#------------------------------------------------------
			# Checking for Stamp Duty
			#------------------------------------------------------
			IF (MISS.CHRG.schm_type == "SBA") THEN
			#{
				MISS.CHRG.stamp = "Y"
				#}
			ELSE
				#{
				MISS.CHRG.stamp = "N"
				PRINT(MISS.CHRG.stamp)
			#}
			ENDIF
			
			#------------------------------------------------------
			# Checking for Minimum Balance
			#------------------------------------------------------
			MISS.CHRG.EffAvailableAmt = CDOUBLE(MISS.CHRG.clr_bal_amt) + CDOUBLE(MISS.CHRG.tran_amt)
			PRINT(MISS.CHRG.EffAvailableAmt)
			
			IF ((MISS.CHRG.schm_type == "SBA") AND (CDOUBLE(MISS.CHRG.EffAvailableAmt) > CDOUBLE("0")) ) THEN
			#{
				IF (MISS.CHRG.schm_code != MISS.CHRG.schmcode2) THEN
				#{
					sv_s = "min_bal|SELECT ACCT_MIN_BALANCE "
					sv_s = sv_s + "FROM TBAADM.CSP "
					sv_s = sv_s + "WHERE schm_code = ?SVAR "
					sv_s = sv_s + "AND crncy_code = ?SVAR "
					sv_s = sv_s + "AND bank_id = ?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = MISS.CHRG.schm_code + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d != 0 ) THEN
					#{
						PRINT("hai")
						sv_u = urhk_SRV_SetErr("A Database error has occured.")
						#}
					ELSE
						#{
						MISS.CHRG.min_bal = BANCS.OUTPARAM.min_bal
						PRINT(MISS.CHRG.min_bal)
						
						IF ((BANCS.STDIN.mySolId == MISS.CHRG.custSolid1) AND (MISS.CHRG.schm_code == MISS.CHRG.schmcode3)) THEN
						#{
							MISS.CHRG.min_bal = MISS.CHRG.minbal1
						#}
						ENDIF
						IF ((BANCS.STDIN.mySolId == MISS.CHRG.custSolid1) AND (MISS.CHRG.schm_code == MISS.CHRG.schmcode4)) THEN
						#{
							MISS.CHRG.min_bal = MISS.CHRG.minbal1
						#}
						ENDIF
						IF ((BANCS.STDIN.mySolId == MISS.CHRG.custSolid2) AND (MISS.CHRG.schm_code == MISS.CHRG.schmcode3)) THEN
						#{
							MISS.CHRG.min_bal = MISS.CHRG.minbal2
						#}
						ENDIF
						IF ((BANCS.STDIN.mySolId == MISS.CHRG.custSolid2) AND (MISS.CHRG.schm_code == MISS.CHRG.schmcode4)) THEN
						#{
							MISS.CHRG.min_bal = MISS.CHRG.minbal3
						#}
						ENDIF
						PRINT(MISS.CHRG.min_bal)
						
						MISS.CHRG.var3 = CDOUBLE(MISS.CHRG.EffAvailableAmt) - CDOUBLE(MISS.CHRG.tran_amt)
						PRINT(MISS.CHRG.var3)
						
						IF (MISS.CHRG.var3 < CDOUBLE("0")) THEN
						#{
							PRINT("No min bal charge")
							#}
						ELSE
							#{
							IF (CDOUBLE(MISS.CHRG.min_bal) > MISS.CHRG.var3) THEN
							#{
								MISS.CHRG.Min = "Y"
								PRINT(MISS.CHRG.Min)
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			PRINT(MISS.CHRG.with)
			PRINT(MISS.CHRG.Min)
			
			MISS.CHRG.tot_amt = "0"
			
			MISS.CHRG.tot_amt = CDOUBLE(MISS.CHRG.tot_amt) + CDOUBLE("1500")
			PRINT(MISS.CHRG.tot_amt)
			
			#--------------------------------------------------
			# Income To cashwith chrg Account
			#--------------------------------------------------
			
			IF (MISS.CHRG.with == "Y") THEN
			#{
				#--Getting mean rate
				sv_s = " fxdcrncycode,ratecode,Rate|"
				sv_s = sv_s + "SELECT fxd_crncy_code,ratecode,var_crncy_units "
				sv_s = sv_s + "FROM TBAADM.RTL "
				sv_s = sv_s + "WHERE fxd_crncy_code = ?SVAR "
				sv_s = sv_s + "AND var_crncy_code = ?SVAR "
				sv_s = sv_s + "AND ratecode = ?SVAR "
				sv_s = sv_s + "AND fxd_crncy_code != 'UGX' "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = MISS.CHRG.acct_crncy_code + "|" + BANCS.STDIN.homeCrncyCode + "|" + MISS.CHRG.refCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == "0") THEN
				#{
					MISS.CHRG.fxdcrncycode = BANCS.OUTPARAM.fxdcrncycode
					PRINT(MISS.CHRG.fxdcrncycode)
					
					MISS.CHRG.ratecode = BANCS.OUTPARAM.ratecode
					PRINT(MISS.CHRG.ratecode)
					
					MISS.CHRG.Rate = BANCS.OUTPARAM.Rate
					PRINT(MISS.CHRG.Rate)
					#}
				ELSE
					#{
					MISS.CHRG.Rate = "1"
				#}
				ENDIF
				
				#------------------------------------------
				PRINT(MISS.CHRG.tran_amt)
				BANCS.INPARAM.InputAmount = MISS.CHRG.tran_amt
				BANCS.INPARAM.CurrencyCode = MISS.CHRG.acct_crncy_code
				IF (MISS.CHRG.acct_crncy_code == BANCS.STDIN.homeCrncyCode) THEN
				#{
					BANCS.INPARAM.AmountTableCode = MISS.CHRG.tableCode1
					#}
				ELSE
					#{
					BANCS.INPARAM.AmountTableCode = MISS.CHRG.tableCode2
				#}
				ENDIF
				PRINT(BANCS.INPARAM.AmountTableCode)
				sv_u = urhk_B2k_GetASTMAmount("")
				IF (sv_u == 1) THEN
				#{
					sv_u = urhk_SRV_SetErr("Invalid AmountTableCode")
					BANCS.OUTPUT.successOrFailure = "F"
					GOTO Finish
				#}
				ENDIF
				PRINT(BANCS.OUTPARAM.OutputAmount)
				
				MISS.CHRG.var4 = (CDOUBLE(BANCS.OUTPARAM.OutputAmount) * CDOUBLE(MISS.CHRG.Rate))
				MISS.CHRG.negat = "-1"
				MISS.CHRG.Tot_Amt = ((MISS.CHRG.var4) * CDOUBLE(MISS.CHRG.negat))
				MISS.CHRG.with_amt = (MISS.CHRG.var4)
				PRINT(MISS.CHRG.var4)
				
				MISS.CHRG.with_desc = "Cash Withdrawal charge"
				PRINT(MISS.CHRG.Tot_Amt)
				PRINT(MISS.CHRG.var4)
				
				PRINT(MISS.CHRG.With_Account)
				
				#---------------------------------------------------------------
				# Passing transaction inputs to the service
				# Adding and Posting the transaction
				#---------------------------------------------------------------
				sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
				sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
				sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.CUSREG.narr)
				sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
				sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
				
				sv_w = "tranDtl.partTranDetailLL.<rec_0>."
				sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|1")
				sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|C")
				sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|" + MISS.CHRG.With_Account)
				sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|" + MISS.CHRG.tranPart1)
				sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
				sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
				sv_u = urhk_SetUrhkInp(sv_w + "valueDate|" + BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_w + "glDate|" + BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|" + MISS.CHRG.var4 + "|" + BANCS.STDIN.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_w + "refAmt|" + MISS.CHRG.var4 + "|" + BANCS.STDIN.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + MISS.CHRG.refCode)
				
				MISS.CHRG.Tot_Amt = CDOUBLE(MISS.CHRG.Tot_Amt)
				PRINT(MISS.CHRG.Tot_Amt)
				sv_w = "tranDtl.partTranDetailLL.<rec_1>."
				sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|2")
				sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|D")
				sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|" + MISS.CHRG.foracid)
				sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|" + MISS.CHRG.tranPart2)
				sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
				sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
				sv_u = urhk_SetUrhkInp(sv_w + "valueDate|" + BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_w + "glDate|" + BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|" + MISS.CHRG.Tot_Amt + "|" + BANCS.STDIN.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_w + "refAmt|" + MISS.CHRG.Tot_Amt + "|" + BANCS.STDIN.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + MISS.CHRG.refCode)
				
				sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
				PRINT(sv_u)
				IF (sv_u != 0) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
					PRINT(sv_u)
				#}
				ENDIF
				
				IF (sv_u == 0) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
					PRINT(sv_u)
					IF (sv_u == 0) THEN
					#{
						sv_u = urhk_CopyOutToIn("")
						sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
						sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
						sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
						PRINT(sv_u)
						IF (sv_u != 0) THEN
						#{
							sv_u = urhk_CopyOutToIn("")
							sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
							sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
							sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
							PRINT(sv_u)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				
				IF (sv_u != 0) THEN
				#{
					IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						PRINT(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) THEN
					#{
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							PRINT(sv_e)
							sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							PRINT(sv_e)
							sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							PRINT(sv_e)
							sv_i = sv_i + 1
						#}
						DO
					#}
					ENDIF
				#}
				ENDIF
				
				IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.tranId)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	DO
	
	sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor)
	PRINT(sv_c)
	
	Finish:
		IF (MISS.CHRG.errMsg != "") THEN
		#{
			PRINT(MISS.CHRG.errMsg)
			sv_u = SYSTEM("echo '"+MISS.CHRG.errMsg+"' >>RGZN1.log")
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
