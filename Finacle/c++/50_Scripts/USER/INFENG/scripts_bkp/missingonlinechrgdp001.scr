	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.homeCrncyCode + "|" + MISS.CHRG.schmcode1 + "|" + MISS.CHRG.schmcode2 + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
