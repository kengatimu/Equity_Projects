	MISS.CHRG.vBacid = MISS.CHRG.custBacid1
	MISS.CHRG.var2 = MISS.CHRG.vBacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
