			BANCS.INPARAM.BINDVARS =  CUST.DATA.frmDate  + "|" + CUST.DATA.toDate
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_k = urhk_dbSelectWithBind(sv_q)
