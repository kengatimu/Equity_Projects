		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# Check if the duplicate filed value is invalid. i.e not "Y" or "N".
	#---------------------------------------------------------------------------------
	
	IF ((CUST.DATA.duplicate != "Y")  AND  (CUST.DATA.duplicate != "N")) THEN
	#{
		sv_e = "Only Y AND N are valid "
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------------
	# Check for the validity of Download ID.
	#---------------------------------------------------------------------------------
	IF (fieldexists(CUST.DATA.dnldID)) THEN
	#{
		IF (CUST.DATA.dnldID == "") THEN
		#{
			IF(CUST.DATA.duplicate == "Y") THEN
			#{
				sv_e = "DownLoad Id must be entered"
				sv_m = "dnldID"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_s ="count|SELECT COUNT(*) FROM CUSTOM.C_ICBM WHERE download_id = ?SVAR "
			sv_s = sv_s +  " AND  branch_id = trim(?SVAR) "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS =  CUST.DATA.dnldID + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_s = urhk_dbSelectWithBind(sv_s)
			IF (sv_s != 0 ) THEN
			#{
				sv_e = "Error occured. Contact DBA."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				IF (CINT(BANCS.OUTPARAM.count) == 0) THEN
				#{
					
					sv_e = "Given Down Load Id does not Belong to your Branch"
					sv_m = "dnldID"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	PRINT(BANCS.INPUT.duplicate)
	IF (BANCS.INPUT.duplicate == "N") THEN
	#{
		CUST.DATA.SolId   =   trim(BANCS.STDIN.mySolId)
		sv_a = "brcode|SELECT br_code FROM TBAADM.sol WHERE sol_id = ?SVAR "
		sv_a = sv_a +  " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.DATA.SolId + "|"  + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_s = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_s)
		IF (sv_s != 0 ) THEN
		#{
			sv_e = "Error Occured. Contact DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		PRINT(BANCS.OUTPARAM.brcode)
		CUST.DATA.brcode = lpad(MID$(BANCS.OUTPARAM.brcode,0,3),3,'0')
		PRINT(CUST.DATA.brcode)
		#---------------------------------------------------------------------------------
		# Generating the Download sequence number.
		#---------------------------------------------------------------------------------
		
		#sv_t="DownSeq|SELECT CUSTOM.IChqBookDownLoad_Seq.nextval FROM DUAL"
		sv_t="DownSeq|SELECT CUSTOM.IChqBookDownLoad_Seq_" + BANCS.STDIN.contextBankId + ".nextval FROM DUAL"
		sv_t=urhk_dbSelectWithBind(sv_t)
		PRINT(sv_t)
		IF (sv_t != 0 ) THEN
		#{
			sv_e = "Error Occured. Contact DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.DATA.DownSeq = trim(BANCS.OUTPARAM.DownSeq)
		PRINT(CUST.DATA.DownSeq)
		#---------------------------------------------------------------------------------
		# Forming the file name.
		#---------------------------------------------------------------------------------
		CUST.DATA.lst1    = CUST.DATA.dnldfile1 + CUST.DATA.brcode+ "_" + lpad(CUST.DATA.DownSeq,6,'0') + ".txt"
		print(CUST.DATA.lst1)
		CUST.DATA.lst2    = CUST.DATA.dnldfile2 + CUST.DATA.brcode + "_" + lpad(CUST.DATA.DownSeq,6,'0') + ".txt"
		print(CUST.DATA.lst2)
		
		
		CUST.DATA.sql_param	= CUST.DATA.frmDate + "!" + CUST.DATA.toDate + "!" + CUST.DATA.SolId + "!" + CUST.DATA.DownSeq +"!" + CUST.DATA.schmType1 + "!" + CUST.DATA.crncy1 + "!" + CUST.DATA.crncy2 + "!" + CUST.DATA.crncy3 + "!" + CUST.DATA.crncy4 + "!" +CUST.DATA.schmCode1 + "!" + CUST.DATA.crncy5 + "!" + CUST.DATA.crncy6 + "!" + CUST.DATA.crncy7 + "!" + CUST.DATA.crncy8 + "!" + CUST.DATA.schmType1 + "!" + CUST.DATA.schmCode2 + "!" + CUST.DATA.crncy9 + "!" + CUST.DATA.crncy10 + "!" +  CUST.DATA.crncy11 + "!" + CUST.DATA.crncy12 + "!" + CUST.DATA.crncy13 + "!" + CUST.DATA.crncy14 + "!" + CUST.DATA.crncy15 + "!" + CUST.DATA.crncy16 + "!" + BANCS.STDIN.contextBankId
		
		PRINT(CUST.DATA.sql_param)
		
		#---------------------------------------------------------------------------------
		# Executing a package which fetches the required data and writes it to the file.
		#---------------------------------------------------------------------------------
		sv_a = "spbx4001" + " " + "CUSTOM.GETICHQDETAILDWNLD.GETICHQDETAILDWNLD" + " '" + CUST.DATA.sql_param +"'>" + CUST.DATA.lst1
		PRINT(sv_a)
		sv_a = SYSTEM(sv_a)
		PRINT(sv_a)
		sv_a = "spbx4001" + " " + "CUSTOM.GETICHQDETAILDWNLDCAA.GETICHQDETAILDWNLDCAA1" + " '" + CUST.DATA.sql_param +"'>" + CUST.DATA.lst2
		PRINT(sv_a)
		sv_a = SYSTEM(sv_a)
		PRINT(sv_a)
		#---------------------------------------------------------------------------------
		# Moving the File to  HPR menu
		#---------------------------------------------------------------------------------
		CUST.DATA.Repdesc = "INHOUSE CHEQUE DETAIL DOWNLOAD"
		sv_t = "Report Generation"
		sv_x = "babx4040 $B2K_SESSION_ID  " + CUST.DATA.lst1
		sv_x = sv_x + " '" + CUST.DATA.Repdesc + "' MANAGER 1 N"
		PRINT (sv_x)
		
		sv_h = SYSTEM (sv_x)
		PRINT(sv_h)
		
		IF (sv_h == 0)THEN
		#{
			sv_v = "RPT Generated Successfully"
			print(sv_v)
		#}
		ENDIF
		
		CUST.DATA.Repdesc = "INHOUSE CAA CHEQUE DETAIL DOWNLOAD"
		sv_t = "Report Generation"
		sv_x = "babx4040 $B2K_SESSION_ID  "  + CUST.DATA.lst2
		sv_x = sv_x + " '" + CUST.DATA.Repdesc + "' MANAGER 1 N"
		PRINT (sv_x)
		
		sv_h = SYSTEM (sv_x)
		PRINT(sv_h)
		
		IF (sv_h == 0)THEN
		#{
			sv_v = "RPT Generated Successfully"
			print(sv_v)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.DATA.DWNLOADID 	=TRIM(CUST.DATA.dnldID)
		PRINT(CUST.DATA.DWNLOADID)
		CUST.DATA.SolId	=	BANCS.STDIN.mySolId
		PRINT(CUST.DATA.SolId)
		sv_a = "brcode|SELECT br_code FROM TBAADM.sol WHERE sol_id = ?SVAR "
		sv_a = sv_a +  " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.DATA.SolId + "|"  + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_s = urhk_dbSelectWithBind(sv_a)
		IF (sv_s != 0 ) THEN
		#{
			sv_e = "Error Occured. Contact DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		PRINT(BANCS.OUTPARAM.brcode)
		CUST.DATA.brcode = lpad(MID$(BANCS.OUTPARAM.brcode,0,3),3,'0')
		PRINT(CUST.DATA.brcode)
		#---------------------------------------------------------------------------------*
		# Forming the name of the data file that is to be generated.
		#---------------------------------------------------------------------------------
		
		CUST.DATA.lst    = CUST.DATA.dnldfile3 + CUST.DATA.brcode + "_" + lpad(CUST.DATA.DWNLOADID,6,'0') + ".txt"
		CUST.DATA.sql_param	=	CUST.DATA.DWNLOADID + "!" + CUST.DATA.SolId + "!" + BANCS.STDIN.contextBankId
		PRINT(CUST.DATA.sql_param)
		#---------------------------------------------------------------------------------*
		# Execute the package that will download all the data into a flat file for the given
		# download ID.
		#---------------------------------------------------------------------------------*
		sv_a = "spbx4001" + " " + "CUSTOM.GETICHQDETAILDUPDWNLD.GETICHQDETAILDUPDWNLD" + " " + CUST.DATA.sql_param +" > " + CUST.DATA.lst
		PRINT(sv_a)
		sv_a = SYSTEM(sv_a)
		PRINT(sv_a)
		#---------------------------------------------------------------------------------
		# Moving the File to  HPR menu
		#---------------------------------------------------------------------------------
		
		CUST.DATA.Repdesc = "INHOUSE CHEQUE DETAIL DOWNLOAD"
		sv_t = "Report Generation"
		sv_x = "babx4040 $B2K_SESSION_ID  " + CUST.DATA.lst
		sv_x = sv_x + " '" + CUST.DATA.Repdesc + "' MANAGER 1 N"
		PRINT (sv_x)
		
		sv_h = SYSTEM (sv_x)
		PRINT(sv_h)
		
		IF (sv_h == 0)THEN
		#{
			sv_v = "RPT Generated Successfully"
			print(sv_v)
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Download process Initiated SuccessFully"
		sv_z = urhk_SetOrbOut(sv_g)
		
		
		TRACE OFF
		EXITSCRIPT
END-->
