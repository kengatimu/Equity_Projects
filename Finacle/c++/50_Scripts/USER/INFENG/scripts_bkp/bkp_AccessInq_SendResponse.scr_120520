	sv_t = "AccessInq_RES.UserPasswdExpDate| " + CUST.INTERFACE.usrPwExpDate
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "AccessInq_RES.UserApplName| " + CUST.INTERFACE.usrAppNam
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "AccessInq_RES.DBStatDate| " + CUST.INTERFACE.dbStatDate
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "AccessInq_RES.RoleID| " + CUST.INTERFACE.rolId
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "AccessInq_RES.CustomerID| " + CUST.INTERFACE.cifId
	sv_u = urhk_SetOrbOut(sv_t)
