	sv_t = "AccessInq_RES.SolDesc| " + CUST.INTERFACE.solDesc
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "AccessInq_RES.CityCode| " + CUST.INTERFACE.cityCode
	sv_u = urhk_SetOrbOut(sv_t)
