<--start
trace on
#Rep/Class
	if(repexists("VPRT")==0)then
		createrep("VPRT")
	endif
	if(classexists("VPRT","GLBDATA")==0)then
		createclass("VPRT","GLBDATA",5)
	endif
	VPRT.GLBDATA.drAcctstat = ""
	VPRT.GLBDATA.trans_amt ="" 
	VPRT.GLBDATA.trans_crncy = ""
	VPRT.GLBDATA.totCAmt = 0
	VPRT.GLBDATA.totDAmt = 0
	VPRT.GLBDATA.chrgDrYN = ""
	VPRT.GLBDATA.usertCode = ""
	VPRT.GLBDATA.clearBalance = ""
	VPRT.GLBDATA.EffAvailableAmt = ""
	VPRT.GLBDATA.isDrAcctId = ""
	VPRT.GLBDATA.acctOwnerShip = ""
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	VPRT.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	VPRT.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.addlTranCritPtr.tranParticularCode.refCode")
	VPRT.GLBDATA.usertCode=BANCS.OUTPARAM.srvValue
	print(VPRT.GLBDATA.usertCode)
	if ((VPRT.GLBDATA.tranSubType == "CI") or (VPRT.GLBDATA.tranSubType=="BI") or (VPRT.GLBDATA.tranSubType=="NR") or (VPRT.GLBDATA.tranSubType=="NP") or (VPRT.GLBDATA.tranSubType =="I")) then

	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			("VPRT").("GLBDATA").("foracid_"+sv_j)=BANCS.OUTPARAM.srvValue
			print(("VPRT").("GLBDATA").("foracid_"+sv_j))
			VPRT.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.crncyCode")
			VPRT.GLBDATA.acrncyCode=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.acrncyCode)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranCrncyCode.crncyCode")
			VPRT.GLBDATA.tcrncyCode=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.tcrncyCode)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.refCrncyCode.crncyCode")
			VPRT.GLBDATA.rcrncyCode=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.rcrncyCode)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			VPRT.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			VPRT.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			VPRT.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
			VPRT.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.tranParticulars)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
			VPRT.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.tranParticulars2)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg")
			VPRT.GLBDATA.recDelYN=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.recDelYN)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rateCode.refCode")
			VPRT.GLBDATA.rateCode=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.rateCode)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rate")
			VPRT.GLBDATA.rate=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.rate)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.treaRate")
			VPRT.GLBDATA.treaRate=BANCS.OUTPARAM.srvValue
			print(VPRT.GLBDATA.treaRate)
			if((VPRT.GLBDATA.foracid!="") and ((VPRT.GLBDATA.partTranType=="D")or(VPRT.GLBDATA.partTranType=="C")))then
			#{
				print(VPRT.GLBDATA.foracid)
				sv_u = urhk_getAcctDetailsInRepository(VPRT.GLBDATA.foracid)
				if(sv_u==0)then
				#{
					VPRT.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
					VPRT.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
					VPRT.GLBDATA.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
					VPRT.GLBDATA.drEffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
					VPRT.GLBDATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
				else
					VPRT.GLBDATA.acctCrncyCode = ""
					exitscript
				#}
				endif
				print(VPRT.GLBDATA.rcrncyCode)
				print(VPRT.GLBDATA.acctCrncyCode)
				print(BANCS.STDIN.homeCrncyCode)
				if(VPRT.GLBDATA.rcrncyCode!=VPRT.GLBDATA.acctCrncyCode)then
				#{
					print(VPRT.GLBDATA.rateCode)
					print(VPRT.GLBDATA.rate)
					print(VPRT.GLBDATA.treaRate)
						lv_h = "rtdtls |  select custom.FN_VER_RTPOP_CHK(?SVAR,?SVAR,?SVAR,'T','HTM')from dual " 
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + VPRT.GLBDATA.rcrncyCode + "|" + VPRT.GLBDATA.acctCrncyCode 
						print(BANCS.INPARAM.BINDVARS)
						print(lv_h)
						lv_p = urhk_dbSelectWithBind(lv_h)
						if(lv_p==0)then
							VPRT.GLBDATA.rtdtls = BANCS.OUTPARAM.rtdtls
						else
							VPRT.GLBDATA.rtdtls = ""
						endif
						print(VPRT.GLBDATA.rtdtls)
						if(VPRT.GLBDATA.rtdtls!="")then
						#{
							sv_l = strlen(VPRT.GLBDATA.rtdtls)
							sv_f = mid$(VPRT.GLBDATA.rtdtls,0,sv_l)
							sv_p = getposition(sv_f,"|")
							VPRT.GLBDATA.crateCode = mid$(sv_f,0,(sv_p-1))
							print(VPRT.GLBDATA.crateCode)
							VPRT.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
							print(VPRT.GLBDATA.trSting)
							sv_l = strlen(VPRT.GLBDATA.trSting)
							sv_f = mid$(VPRT.GLBDATA.trSting,0,sv_l)
							sv_p = getposition(sv_f,"|")
							VPRT.GLBDATA.crate  = mid$(sv_f,0,(sv_p-1))
							print(VPRT.GLBDATA.crate)
							VPRT.GLBDATA.ctreaRate = mid$(sv_f,sv_p,sv_l)
							print(VPRT.GLBDATA.ctreaRate)
							if(VPRT.GLBDATA.rateCode!=VPRT.GLBDATA.crateCode)then
							#{
								print("Invalid Rate Code by Channel")
								sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rateCode.refCode|" + VPRT.GLBDATA.crateCode )
								sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rate|" + VPRT.GLBDATA.crate )
								sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.treaRate|" + VPRT.GLBDATA.ctreaRate )
							else
								print("Correct Rate by Channel")
							#}
							endif
						#}
						endif
				#}
				endif
			#}
			endif
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif
VAYU:	
	if(classexists("VPRT","GLBDATA")==1) then
		deleteclass("VPRT","GLBDATA")
	endif
	if(repexists("VPRT")==1) then
		deleterep("VPRT")
	endif
	exitscript
##trace off
end-->

