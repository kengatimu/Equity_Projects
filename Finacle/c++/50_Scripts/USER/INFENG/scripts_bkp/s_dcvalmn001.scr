######################################################################################################################
# Source Name						: s_dcvalmn001.scr
# Date								: 17-01-2013
# Description						: This script is for making the place of expiry and shipment code mandatory.
# Input Values						: None
# Output Values						: To display the error message when the place of expiry and shipment code fields are not entered.
# Called Scripts					: SRV_IssueOutwardDcDtl_validate_data.scr
# Calling Script					: none
# Author     						: chandrasekhar
# Bank								: Equity Bank,KENYA
# Modification History				:
#		< Version No.> 		<Date>		<Author Name> 		<Description>
#		 	0.1				17-01-2013 	chandrasekhar		Original Version
#			0.2			21-02-2013 		Chandrasekhar		Pointing error field
########################################################################################################################
<--START
CHECKSUM="a65f7f1b8dd7c60713bea8cb0e955bbf1f1a5eed1c250afa29542a92e00fb1f4"
	TRACE ON
	
	#############################################################################
	#Custom Repository creation
	#############################################################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","MAND") == 0) THEN
	#{
		CREATECLASS("CUST","MAND",5)
	#}
	ENDIF
	############################################################################
	#Getting the place of expiry and shipment mode
	############################################################################
	sv_u=urhk_SRV_GetVal("dcAddlnDtl.dcPlaceOfExp")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		GOTO FINISH
	#}
	ENDIF
	
	print(sv_u)
	CUST.MAND.placeofExp=BANCS.OUTPARAM.srvValue
	print(CUST.MAND.placeofExp)
	sv_u=urhk_SRV_GetVal("dcAddlnDtl.dcShipmentDtl.shipModeCode.refCode")
	print(sv_u)
	CUST.MAND.shipmode=BANCS.OUTPARAM.srvValue
	print(CUST.MAND.shipmode)
	
	IF ( CUST.MAND.placeofExp == ""  ) THEN
	#{
		sv_a = urhk_SRV_SetErr("dcAddlnDtl.dcPlaceOfExp|Place of expiry field is mandatory(In DC Details tab)")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO FINISH
	#}
	ENDIF
	
	IF (CUST.MAND.shipmode == "" ) THEN
	#{
		sv_a = urhk_SRV_SetErr("dcAddlnDtl.dcShipmentDtl.shipModeCode.refCode|Shipment mode is mandatory(In DC Details tab)")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO FINISH
	#}
	ENDIF
	
	FINISH:
		EXITSCRIPT
		TRACE OFF
END-->
