						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
								CUST.DATA.tranId3 = MID$(sv_x, sv_b, (sv_e - sv_b))
						CUST.DATA.tranId3 = CUST.DATA.tranId3 
				#}
						ENDIF
						IF(CUST.DATA.tranId3 == "") THEN
						#{
								CUST.DATA.errorMsgFlg = "Y"
								CUST.DATA.errorCode = "SYSERR"
								CUST.DATA.errorDesc = "Could not get response from server"
						#}
						ENDIF
				#}
				ELSE
				#{
						CUST.DATA.errorMsgFlg = "Y"
						IF(CUST.DATA.tranStatus == "FAILED") THEN
						#{
							sv_x = CUST.DATA.respXMLMsg
							sv_y = "<ErrorCode>"
							sv_z = "</ErrorCode>"
							sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
							sv_e = GETPOSITION(sv_x, sv_z) - 1
							IF (GETPOSITION(sv_x, sv_y) != 0) THEN
							#{
									CUST.DATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
							#}
							ENDIF
							sv_x = CUST.DATA.respXMLMsg
							sv_y = "<ErrorDesc>"
							sv_z = "</ErrorDesc>"
							sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
							sv_e = GETPOSITION(sv_x, sv_z) - 1
							IF (GETPOSITION(sv_x, sv_y) != 0) THEN
							#{
									CUST.DATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
							#}
							ENDIF
						#}
						ENDIF
						IF((CUST.DATA.errorCode == "") AND (CUST.DATA.errorDesc == "")) THEN
						#{
								CUST.DATA.errorCode = "SYSERR"
								CUST.DATA.errorDesc = "Could not get response from server"
						#}
						ENDIF
				#}
				ENDIF
				
				IF(CUST.DATA.errorMsgFlg == "Y")THEN
				#{
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						print(sv_u)
						sv_u = urhk_SetOrbOut("Error_1|Error^Could not create transaction in the other entity^prodCode")
						print(sv_u)
						exitscript
				#}
				ENDIF

				IF(FIELDEXISTS(CUST.DATA.tranId3 ))THEN
				#{
						IF(TRIM(CUST.DATA.tranId3 ) != "")THEN
						#{
								CUST.DATA.tranId3 = TOUPPER(CUST.DATA.tranId3 )
								print(CUST.DATA.tranId3)
								
						#}
						ENDIF
				#}
				ENDIF
			#}
			endif
			
			sv_z = urhk_dbCursorFetch(sv_n)
			print(sv_z)
		#}
		do
		sv_z = urhk_dbCursorClose(sv_n)			
	#}	 
	ELSE
	#{
		print("transaction not found")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#+++++++++
#Balance
#+++++++++
        sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.crAcctNum)
        if(sv_u ==0)then
                CUST.DATA.crEffBal      = BANCS.OUTPARAM.EffAvailableAmt
                CUST.DATA.cracctOwner     = BANCS.OUTPARAM.acctOwnerShip
        else
                CUST.DATA.crEffBal      = 0
                CUST.DATA.cracctOwner   = ""
        endif
        sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.drAcctNum)
        if(sv_u ==0)then
                CUST.DATA.drEffBal      = BANCS.OUTPARAM.EffAvailableAmt
                CUST.DATA.dracctOwner     = BANCS.OUTPARAM.acctOwnerShip
        else
                CUST.DATA.drEffBal      = 0
                CUST.DATA.dracctOwner   = ""
        endif
	
ENDOFSCRIPT:

	IF ((CUST.DATA.TranID2 !="") OR (CUST.DATA.tranId3!="")) THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_t = "CHARGE_TRAN_ID|Reversal Transaction Done Successfully. Transaction Reference No: " + CUST.DATA.TranID2 
		sv_t = sv_t + "!" + CUST.DATA.tranId3
		sv_u = urhk_SetOrbOut(sv_t)
		if(CUST.DATA.cracctOwner =="C")then
                        sv_u = urhk_SetOrbOut("CreditAccountBal|" + CUST.DATA.crEffBal )
                else
                        sv_u = urhk_SetOrbOut("CreditAccountBal|No Balance for GL ")
                endif
	#}
	else
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		CUST.DATA.errMsg="No charge"
		sv_e=urhk_SetOrbOut("CHARGE_TRAN_ID|"+CUST.DATA.errMsg)
	#}
	endif

IF ((CUST.DATA.TranID1!="") OR (CUST.DATA.tranId!="")) THEN
#{
	
    	print(sv_u)
	sv_s = "RESULT_MSG|Reversal Transaction Done Successfully. Transaction Reference No: " + CUST.DATA.TranID1
	sv_s = sv_s + "!" + CUST.DATA.tranId 
	print(sv_s)
	sv_u = urhk_SetOrbOut(sv_s)
	print(sv_u)
	if(CUST.DATA.dracctOwner =="C")then
		sv_u = urhk_SetOrbOut("DebitAccountBal|" + CUST.DATA.drEffBal )
	else
		sv_u = urhk_SetOrbOut("DebitAccountBal|No Balance for GL ")
	endif	
#}
else
#{
	CUST.DATA.errMsg="No Tran is generated"
	sv_f=urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.errMsg)
#}
ENDIF


exitscript
TRACE OFF
end-->
