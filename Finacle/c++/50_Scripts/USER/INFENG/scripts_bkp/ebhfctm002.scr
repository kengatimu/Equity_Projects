<--start
trace on
        if(repexists("EQSRV") == 0) then
            createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0)then
            createclass("EQSRV","GLBDATA",5)
        endif
        EQSRV.GLBDATA.CIFId = TRIM(BANCS.INPUT.CIFId)
        print(EQSRV.GLBDATA.CIFId)
        sv_d = "iCnt,delYn | select count(*),del_flg from custom.irml "
        sv_d = sv_d + " where bank_id='"+BANCS.STDIN.contextBankId+"' and cif_id='"+EQSRV.GLBDATA.CIFId+"' group by del_flg"
        print(sv_d)
        sv_u = urhk_dbSelectWithBind(sv_d)
        if(sv_u==0)then
                EQSRV.GLBDATA.iCnt = BANCS.OUTPARAM.iCnt
                EQSRV.GLBDATA.delYn = BANCS.OUTPARAM.delYn
        else
                EQSRV.GLBDATA.iCnt = 0 
                EQSRV.GLBDATA.delYn = "N" 
        endif
	if((cint(EQSRV.GLBDATA.iCnt)>=1) and (EQSRV.GLBDATA.delYn=="N"))then
		print("in")
		EQSRV.GLBDATA.gdprVal = "Y"
		sv_c = "gaO|" + EQSRV.GLBDATA.gdprVal
		sv_z = urhk_SetOrbOut(sv_c)
		exitscript
	endif
	if((cint(EQSRV.GLBDATA.iCnt)>=1) and (EQSRV.GLBDATA.delYn=="Y"))then
		EQSRV.GLBDATA.gdprVal = "D"
		sv_c = "gaO|" + EQSRV.GLBDATA.gdprVal
		sv_z = urhk_SetOrbOut(sv_c)
		exitscript
	endif
	if(cint(EQSRV.GLBDATA.iCnt)<=0)then
		EQSRV.GLBDATA.gdprVal = "N"
		sv_c = "gaO|" + EQSRV.GLBDATA.gdprVal
		sv_z = urhk_SetOrbOut(sv_c)
		exitscript
	endif
trace off
end-->

