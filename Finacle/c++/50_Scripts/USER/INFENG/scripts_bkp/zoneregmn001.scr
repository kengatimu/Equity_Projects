	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.CUSREG.narr)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
