#-------------------------------------------------------------------------------------
#    Name				: sys_asset_classfn_caa.scr
#    Description     	: This scripts classifies the assets based on the overdue period.
#    Date            	: 12-02-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: NA
#    Menu Option		:
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0		12-02-2013			Divya	 		Original Version
#	 2.0		30-04-2013			Divya			Removed hardcoded foracid used for testing
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="5f282d66c0beb4634001ca365f2df002146156f1832983b438e947de9e9a1c34"
	TRACE ON
	
	#sv_u = urhk_B2k_PrintRepos("BANCS")
	
	#PRINT(BANCS.INPUT.b2kId)
	#PRINT(BANCS.INPUT.solId)
	#PRINT(BANCS.INPUT.foracid)
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","ASSTCLASS") == 0) THEN
	#{
		CREATECLASS("CUST","ASSTCLASS",5)
	#}
	ENDIF
	
	CUST.ASSTCLASS.mainClassificationSystem = ""
	CUST.ASSTCLASS.subClassificationSystem  = ""
	CUST.ASSTCLASS.oldDate   	 			= ""
	CUST.ASSTCLASS.newDate    				= ""
	CUST.ASSTCLASS.Last_Month 				= ""
	CUST.ASSTCLASS.Op_Month   				= ""
	CUST.ASSTCLASS.acctNumLmon				= ""
	CUST.ASSTCLASS.newDate1                 = ""
	CUST.ASSTCLASS.currDrBal1				= ""
	CUST.ASSTCLASS.currDrBal2				= ""
	
	
	BANCS.INPUT.moduleName = "ASSTCLS"
	BANCS.INPUT.parameterId = "MONTH1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.month1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Month1 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MONTH2"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.month2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Month2 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MONTH3"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.month3 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Month3 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MAINCLASSNPA"
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.mainClassNPA = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Main classification1 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MAINCLASSPA"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.mainClassPA = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Main classification2 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SUBCLASSLOSS"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.subClassLOSS = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Sub classification1 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SUBCLASSSUBS"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.subClassSUBS = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Sub classification2 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SUBCLASSDBTL"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.subClassDBTL = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Sub classification3 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SUBCLASSWATC"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.subClassWATC = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Sub classification4 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SUBCLASSNORM"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ASSTCLASS.subClassNORM = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ASSTCLASS.errMsg = "Sub classification4 setup not done CPARAM"
		GOTO finish
	#}
	ENDIF
	
	
	sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.foracid)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ASSTCLASS.sanctionLimit = BANCS.OUTPARAM.sanctionLimit
		PRINT(CUST.ASSTCLASS.sanctionLimit)
		
		CUST.ASSTCLASS.clearBalance = BANCS.OUTPARAM.clearBalance
		PRINT(CUST.ASSTCLASS.clearBalance)
		CUST.ASSTCLASS.clearBalance = CDOUBLE(CUST.ASSTCLASS.clearBalance)
		PRINT (CUST.ASSTCLASS.clearBalance)
		IF (CUST.ASSTCLASS.clearBalance >= 0) THEN
		#{
			GOTO finish
		#}
		ENDIF
		CUST.ASSTCLASS.Op_Month = BANCS.OUTPARAM.acctOpenDate
		PRINT(CUST.ASSTCLASS.Op_Month)
		CUST.ASSTCLASS.oldDate = LEFT$(BANCS.STDIN.BODDate,10)
		PRINT(CUST.ASSTCLASS.oldDate)
		CUST.ASSTCLASS.newDate = (CUST.ASSTCLASS.oldDate + "|" + "-1" + "|" + "0")
		PRINT(CUST.ASSTCLASS.newDate)
		sv_u = urhk_B2k_Add_MonthsDays_To_date(CUST.ASSTCLASS.newDate)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.ASSTCLASS.Last_Month = LEFT$(BANCS.STDIN.BODDate,10)
			PRINT(CUST.ASSTCLASS.Last_Month)
			#}
		ELSE
			#{
			CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.MODIFIED_DATE
			PRINT(CUST.ASSTCLASS.Last_Month)
		#}
		ENDIF
		
		CUST.ASSTCLASS.Op_Month = LEFT$(CUST.ASSTCLASS.Op_Month,10)
		PRINT(CUST.ASSTCLASS.Op_Month)
		CUST.ASSTCLASS.Last_Month = LEFT$(CUST.ASSTCLASS.Last_Month,10)
		PRINT(CUST.ASSTCLASS.Last_Month)
		
		sv_s = (CUST.ASSTCLASS.Op_Month + "|" + CUST.ASSTCLASS.Last_Month + "|" + "NO")
		PRINT(sv_s)
		sv_u = urhk_B2k_getMonthDayDiff(sv_s)
		PRINT(sv_u)
		IF (sv_u == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.errorMesg)
			GOTO COMPLETE
			#}
		ELSE
			#{
			CUST.ASSTCLASS.NumOfMonths = BANCS.OUTPARAM.NumOfMonths
			PRINT(CUST.ASSTCLASS.NumOfMonths)
			
			IF (CINT(CUST.ASSTCLASS.NumOfMonths) >= CINT(CUST.ASSTCLASS.month1)) THEN
			#{
				GOTO STEPLOSS
			#}
			ENDIF
			
			IF (CINT(CUST.ASSTCLASS.NumOfMonths) >= CINT(CUST.ASSTCLASS.month2)) THEN
			#{
				GOTO STEPDBTS
			#}
			ENDIF
			
			IF (CINT(CUST.ASSTCLASS.NumOfMonths) >= CINT(CUST.ASSTCLASS.month3)) THEN
			#{
				GOTO STEPSUB1
			#}
			ENDIF
			
			IF (CINT(CUST.ASSTCLASS.NumOfMonths) < CINT(CUST.ASSTCLASS.month3)) THEN
			#{
				GOTO STEPNRWA
			#}
			ENDIF
		#}
		ENDIF
		
		STEPLOSS:
			
			#------------------------------------------------------------------------------------
			# LOSS CLASSIFICATION
			#------------------------------------------------------------------------------------
			#---------------------------------
			# GENERAL CALCULATION FOR STEPLOSS
			#---------------------------------
			
			#-------------------------
			# Avg Trn Over Cr&Dr Bal
			#-------------------------
			sv_e = 6
			CUST.ASSTCLASS.Tot_trn_cr_amt = 0
			CUST.ASSTCLASS.Tot_trn_dr_amt = 0
			PRINT(CUST.ASSTCLASS.Last_Month)
			WHILE (sv_e != 0)
			#{
				CUST.ASSTCLASS.acctNumLmon = BANCS.INPUT.foracid + "|" + CUST.ASSTCLASS.Last_Month
				PRINT(CUST.ASSTCLASS.acctNumLmon)
				#sv_u = urhk_getAcctTurnoverDetails(CUST.ASSTCLASS.acctNumLmon)
				#PRINT(sv_u)
				sv_s = "Last_Month|SELECT LAST_DAY(TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS')) FROM DUAL"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.Last_Month
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				sv_s = "eabBal|SELECT EAB.tran_date_bal "
				sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.EAB "
				sv_s = sv_s + "WHERE GAM.del_flg = 'N' "
				sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
				sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
				sv_s = sv_s + "AND GAM.acid =  EAB.acid "
				sv_s = sv_s + "AND GAM.bank_id = EAB.bank_id "
				sv_s = sv_s + "AND ?SVAR BETWEEN eod_date AND end_eod_date "
				sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
				sv_s = sv_s + "AND GAM.foracid = ?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.foracid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.eabBal = BANCS.OUTPARAM.eabBal
					PRINT(CUST.ASSTCLASS.eabBal)
					IF (CUST.ASSTCLASS.eabBal < 0) THEN
					#{
						BANCS.OUTPARAM.totDrBal = CUST.ASSTCLASS.eabBal
						BANCS.OUTPARAM.totCrBal = 0
						PRINT(BANCS.OUTPARAM.totDrBal)
						PRINT(CUST.ASSTCLASS.eabBal)
						#}
					ELSE
						#{
						BANCS.OUTPARAM.totCrBal = CUST.ASSTCLASS.eabBal
						PRINT(CUST.ASSTCLASS.eabBal)
						PRINT(BANCS.OUTPARAM.totCrBal)
						BANCS.OUTPARAM.totDrBal = 0
					#}
					ENDIF
				#}
				ENDIF
				
				IF (sv_d != 0) THEN
				#{
					CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE("0")
					PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
					CUST.ASSTCLASS.Tot_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) + CDOUBLE("0")
					PRINT(CUST.ASSTCLASS.Tot_trn_dr_amt)
					#}
				ELSE
					#{
					CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE(BANCS.OUTPARAM.totCrBal)
					PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
					CUST.ASSTCLASS.Tot_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) + CDOUBLE(BANCS.OUTPARAM.totDrBal)
					PRINT(CUST.ASSTCLASS.Tot_trn_dr_amt)
				#}
				ENDIF
				
				sv_s = "Last_Month|SELECT TO_CHAR(TO_DATE(?SVAR,'DD-MM-RRRR'),'DD-MM-RRRR') FROM DUAL"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.Last_Month
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				CUST.ASSTCLASS.newDate1 = (CUST.ASSTCLASS.Last_Month + "|" + "-1" + "|" + "0")
				PRINT(CUST.ASSTCLASS.newDate1)
				sv_u = urhk_B2k_Add_MonthsDays_To_date(CUST.ASSTCLASS.newDate1)
				IF (sv_u == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.MODIFIED_DATE
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				sv_e = sv_e - CINT("1")
				PRINT(sv_e)
			#}
			DO
			
			CUST.ASSTCLASS.Avg_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) / CDOUBLE("6")
			PRINT(CUST.ASSTCLASS.Avg_trn_cr_amt)
			
			CUST.ASSTCLASS.Avg_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) / CDOUBLE("6")
			PRINT(CUST.ASSTCLASS.Avg_trn_dr_amt)
			
			#----------------------------------------------
			# SUB CONDITIONS
			#----------------------------------------------
			
			#-------------------------------------------------------------------------------------
			# 1. Current debit balance is between 90%-110% of the six months average debit balance
			#-------------------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.ASSTCLASS.clearBalance) < CDOUBLE("0")) THEN
			#{
				CUST.ASSTCLASS.currDrBal1 = (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) * CDOUBLE("90")) / CDOUBLE("100")
				CUST.ASSTCLASS.currDrBal2 = (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) * CDOUBLE("110")) / CDOUBLE("100")
				PRINT(CUST.ASSTCLASS.currDrBal1)
				PRINT(CUST.ASSTCLASS.currDrBal2)
				
				IF ((CDOUBLE(CUST.ASSTCLASS.clearBalance) >= CUST.ASSTCLASS.currDrBal1) AND (CDOUBLE(CUST.ASSTCLASS.clearBalance) <= CUST.ASSTCLASS.currDrBal2)) THEN
				#{
					CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
					CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassLOSS
					GOTO COMPLETE
				#}
				ENDIF
			#}
			ENDIF
			
			
			#-------------------------------------------------------------------------------------
			# 2. Past 6 months average credit turnover is below 10% of the approved limit
			#-------------------------------------------------------------------------------------
			
			CUST.ASSTCLASS.avgCrTurnOver = (CDOUBLE(CUST.ASSTCLASS.sanctionLimit) * CDOUBLE("10")) / CDOUBLE("100")
			PRINT(CUST.ASSTCLASS.avgCrTurnOver)
			
			IF (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) < CUST.ASSTCLASS.avgCrTurnOver) THEN
			#{
				CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
				CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassLOSS
				GOTO COMPLETE
			#}
			ENDIF
			
			
			#-------------------------------------------------------------------------------------
			# 3. Past 6 months average credit turnover is less than the average
			#    debit turnover over the same period.
			#-------------------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) < CDOUBLE(CUST.ASSTCLASS.Avg_trn_dr_amt)) THEN
			#{
				CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
				CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassLOSS
				GOTO COMPLETE
			#}
			ENDIF
			
			
			#---------------------------------------
			# Next Step
			#---------------------------------------
			
			GOTO STEPDBTS
			
		STEPDBTS:
			
			#------------------------------------------------------------------------------------
			# DOUBTS CLASSIFICATION
			#------------------------------------------------------------------------------------
			
			# GENERAL CALCULATION FOR STEPDBTS
			#---------------------------------
			
			#-------------------------
			# Avg Trn Over Cr&Dr Bal
			#-------------------------
			sv_e = 4
			CUST.ASSTCLASS.Tot_trn_cr_amt = 0
			CUST.ASSTCLASS.Tot_trn_dr_amt = 0
			
			WHILE (sv_e != 0)
			#{
				CUST.ASSTCLASS.acctNumLmon = BANCS.INPUT.foracid + "|" + CUST.ASSTCLASS.Last_Month
				PRINT(CUST.ASSTCLASS.acctNumLmon)
				
				sv_s = "Last_Month|SELECT LAST_DAY(TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS')) FROM DUAL"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.Last_Month
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				sv_s = "eabBal|SELECT EAB.tran_date_bal "
				sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.EAB "
				sv_s = sv_s + "WHERE GAM.del_flg = 'N' "
				sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
				sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
				sv_s = sv_s + "AND GAM.acid =  EAB.acid "
				sv_s = sv_s + "AND GAM.bank_id = EAB.bank_id "
				sv_s = sv_s + "AND ?SVAR BETWEEN eod_date AND end_eod_date "
				sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
				sv_s = sv_s + "AND GAM.foracid = ?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.foracid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.eabBal = BANCS.OUTPARAM.eabBal
					PRINT(CUST.ASSTCLASS.eabBal)
					IF (CUST.ASSTCLASS.eabBal < 0) THEN
					#{
						BANCS.OUTPARAM.totDrBal = CUST.ASSTCLASS.eabBal
						BANCS.OUTPARAM.totCrBal = 0
						PRINT(BANCS.OUTPARAM.totDrBal)
						PRINT(CUST.ASSTCLASS.eabBal)
						#}
					ELSE
						#{
						BANCS.OUTPARAM.totCrBal = CUST.ASSTCLASS.eabBal
						PRINT(CUST.ASSTCLASS.eabBal)
						PRINT(BANCS.OUTPARAM.totCrBal)
						BANCS.OUTPARAM.totDrBal = 0
					#}
					ENDIF
				#}
				ENDIF
				
				#sv_u = urhk_getAcctTurnoverDetails(CUST.ASSTCLASS.acctNumLmon)
				#PRINT(sv_u)
				IF (sv_d != 0) THEN
				#{
					CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE("0")
					PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
					CUST.ASSTCLASS.Tot_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) + CDOUBLE("0")
					PRINT(CUST.ASSTCLASS.Tot_trn_dr_amt)
					#}
				ELSE
					#{
					CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE(BANCS.OUTPARAM.totCrBal)
					PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
					CUST.ASSTCLASS.Tot_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) + CDOUBLE(BANCS.OUTPARAM.totDrBal)
					PRINT(CUST.ASSTCLASS.Tot_trn_dr_amt)
				#}
				ENDIF
				
				sv_s = "Last_Month|SELECT TO_CHAR(TO_DATE(?SVAR,'DD-MM-RRRR'),'DD-MM-RRRR') FROM DUAL"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.Last_Month
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				CUST.ASSTCLASS.newDate1 = (CUST.ASSTCLASS.Last_Month + "|" + "-1" + "|" + "0")
				PRINT(CUST.ASSTCLASS.newDate1)
				sv_u = urhk_B2k_Add_MonthsDays_To_date(CUST.ASSTCLASS.newDate1)
				IF (sv_u == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.MODIFIED_DATE
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				sv_e = sv_e - CINT("1")
				PRINT(sv_e)
			#}
			DO
			
			CUST.ASSTCLASS.Avg_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) / CDOUBLE("4")
			PRINT(CUST.ASSTCLASS.Avg_trn_cr_amt)
			
			CUST.ASSTCLASS.Avg_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) / CDOUBLE("4")
			PRINT(CUST.ASSTCLASS.Avg_trn_dr_amt)
			
			
			#----------------------------------------------
			# SUB CONDITIONS
			#----------------------------------------------
			
			#--------------------------------------------------------------------------------------
			# 1. Current debit balance is between 75%-125% of the four months average debit balance
			#--------------------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.ASSTCLASS.clearBalance) < CDOUBLE("0")) THEN
			#{
				CUST.ASSTCLASS.currDrBal1 = (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) * CDOUBLE("75")) / CDOUBLE("100")
				CUST.ASSTCLASS.currDrBal2 = (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) * CDOUBLE("125")) / CDOUBLE("100")
				PRINT(CUST.ASSTCLASS.currDrBal1)
				PRINT(CUST.ASSTCLASS.currDrBal2)
				
				IF ((CDOUBLE(CUST.ASSTCLASS.clearBalance) >= CUST.ASSTCLASS.currDrBal1) AND (CDOUBLE(CUST.ASSTCLASS.clearBalance) <= CUST.ASSTCLASS.currDrBal2)) THEN
				#{
					CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
					CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassDBTL
					GOTO COMPLETE
				#}
				ENDIF
			#}
			ENDIF
			
			
			#-------------------------------------------------------------------------------------
			# 2. Past 4 months average credit turnover is between 30-10% of the approved limit
			#-------------------------------------------------------------------------------------
			
			CUST.ASSTCLASS.currDrBal1 = (CDOUBLE(CUST.ASSTCLASS.sanctionLimit) * CDOUBLE("10")) / CDOUBLE("100")
			PRINT(CUST.ASSTCLASS.currDrBal1)
			CUST.ASSTCLASS.currDrBal2 = (CDOUBLE(CUST.ASSTCLASS.sanctionLimit) * CDOUBLE("30")) / CDOUBLE("100")
			PRINT(CUST.ASSTCLASS.currDrBal2)
			
			IF ((CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) >= CUST.ASSTCLASS.currDrBal1) AND (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) <= CUST.ASSTCLASS.currDrBal2)) THEN
			#{
				CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
				CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassDBTL
				GOTO COMPLETE
			#}
			ENDIF
			
			
			#-------------------------------------------------------------------------------------
			# 3. Past 4 months average credit turnover is less than the average
			#    debit turnover over the same period.
			#-------------------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) < CDOUBLE(CUST.ASSTCLASS.Avg_trn_dr_amt)) THEN
			#{
				CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
				CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassDBTL
				GOTO COMPLETE
			#}
			ENDIF
			
			
			#---------------------------------------
			# Next Step
			#---------------------------------------
			
			GOTO STEPSUB1
			
		STEPSUB1:
			
			
			#------------------------------------------------------------------------------------
			# SUBSTANDARD1 CLASSIFICATION
			#------------------------------------------------------------------------------------
			
			# GENERAL CALCULATION FOR STEPSUB1
			#---------------------------------
			
			#-------------------------
			# Avg Trn Over Cr&Dr Bal
			#-------------------------
			sv_e = 3
			CUST.ASSTCLASS.Tot_trn_cr_amt = 0
			CUST.ASSTCLASS.Tot_trn_dr_amt = 0
			
			WHILE(sv_e != 0)
			#{
				CUST.ASSTCLASS.acctNumLmon = BANCS.INPUT.foracid + "|" + CUST.ASSTCLASS.Last_Month
				PRINT(CUST.ASSTCLASS.acctNumLmon)
				
				sv_s = "Last_Month|SELECT LAST_DAY(TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS')) FROM DUAL"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.Last_Month
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				sv_s = "eabBal|SELECT EAB.tran_date_bal "
				sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.EAB "
				sv_s = sv_s + "WHERE GAM.del_flg = 'N' "
				sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
				sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
				sv_s = sv_s + "AND GAM.acid =  EAB.acid "
				sv_s = sv_s + "AND GAM.bank_id = EAB.bank_id "
				sv_s = sv_s + "AND ?SVAR BETWEEN eod_date AND end_eod_date "
				sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
				sv_s = sv_s + "AND GAM.foracid = ?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.foracid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.eabBal = BANCS.OUTPARAM.eabBal
					PRINT(CUST.ASSTCLASS.eabBal)
					IF (CUST.ASSTCLASS.eabBal < 0) THEN
					#{
						BANCS.OUTPARAM.totDrBal = CUST.ASSTCLASS.eabBal
						BANCS.OUTPARAM.totCrBal = 0
						PRINT(BANCS.OUTPARAM.totDrBal)
						PRINT(CUST.ASSTCLASS.eabBal)
						#}
					ELSE
						#{
						BANCS.OUTPARAM.totCrBal = CUST.ASSTCLASS.eabBal
						PRINT(CUST.ASSTCLASS.eabBal)
						PRINT(BANCS.OUTPARAM.totCrBal)
						BANCS.OUTPARAM.totDrBal = 0
					#}
					ENDIF
				#}
				ENDIF
				
				#sv_u = urhk_getAcctTurnoverDetails(CUST.ASSTCLASS.acctNumLmon)
				IF (sv_d != 0) THEN
				#{
					CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE("0")
					PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
					CUST.ASSTCLASS.Tot_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) + CDOUBLE("0")
					PRINT(CUST.ASSTCLASS.Tot_trn_dr_amt)
					#}
				ELSE
					#{
					CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE(BANCS.OUTPARAM.totCrBal)
					PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
					CUST.ASSTCLASS.Tot_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) + CDOUBLE(BANCS.OUTPARAM.totDrBal)
					PRINT(CUST.ASSTCLASS.Tot_trn_dr_amt)
				#}
				ENDIF
				
				sv_s = "Last_Month|SELECT TO_CHAR(TO_DATE(?SVAR,'DD-MM-RRRR'),'DD-MM-RRRR') FROM DUAL"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.Last_Month
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.Last_Month
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				CUST.ASSTCLASS.newDate1 = (CUST.ASSTCLASS.Last_Month + "|" + "-1" + "|" + "0")
				PRINT(CUST.ASSTCLASS.newDate1)
				sv_u = urhk_B2k_Add_MonthsDays_To_date(CUST.ASSTCLASS.newDate1)
				IF (sv_u == 0) THEN
				#{
					CUST.ASSTCLASS.Last_Month = BANCS.OUTPARAM.MODIFIED_DATE
					PRINT(CUST.ASSTCLASS.Last_Month)
				#}
				ENDIF
				
				sv_e = sv_e - CINT("1")
				PRINT(sv_e)
			#}
			DO
			
			CUST.ASSTCLASS.Avg_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) / CDOUBLE("3")
			PRINT(CUST.ASSTCLASS.Avg_trn_cr_amt)
			
			CUST.ASSTCLASS.Avg_trn_dr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_dr_amt) / CDOUBLE("3")
			PRINT(CUST.ASSTCLASS.Avg_trn_dr_amt)
			
			#-------------------------------------------------------------------------------------
			# 1. Past 3 months average credit turnover is 75% of the approved limit
			#-------------------------------------------------------------------------------------
			
			CUST.ASSTCLASS.avgCrTurnOver = (CDOUBLE(CUST.ASSTCLASS.sanctionLimit) * CDOUBLE("75")) / CDOUBLE("100")
			PRINT(CUST.ASSTCLASS.avgCrTurnOver)
			
			IF (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) < CUST.ASSTCLASS.avgCrTurnOver) THEN
			#{
				CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
				CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassSUBS
				GOTO COMPLETE
			#}
			ENDIF
			
			#-------------------------------------------------------------------------------------
			# 2. Past 3 months average credit turnover less than Past 3 months average debit turnover
			#-------------------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.ASSTCLASS.Avg_trn_cr_amt) < CDOUBLE(CUST.ASSTCLASS.Avg_trn_dr_amt)) THEN
			#{
				CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassNPA
				CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassSUBS
				GOTO COMPLETE
			#}
			ENDIF
			
		STEPNRWA:
			
			
			#------------------------------------------------------------------------------------
			# NORMAL & WATCH CLASSIFICATION
			#------------------------------------------------------------------------------------
			
			# GENERAL CALCULATION FOR STEPNRWA
			#---------------------------------
			
			CUST.ASSTCLASS.Tot_trn_cr_amt = "0"
			CUST.ASSTCLASS.Tot_trn_dr_amt = "0"
			PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
			PRINT(CUST.ASSTCLASS.Tot_trn_dr_amt)
			
			CUST.ASSTCLASS.acctNumLmon = BANCS.INPUT.foracid + "|" + LEFT$(BANCS.STDIN.BODDate,10)
			PRINT(CUST.ASSTCLASS.acctNumLmon)
			
			sv_s = "eabBal|SELECT EAB.tran_date_bal "
			sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.EAB "
			sv_s = sv_s + "WHERE GAM.del_flg = 'N' "
			sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
			sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
			sv_s = sv_s + "AND GAM.acid =  EAB.acid "
			sv_s = sv_s + "AND GAM.bank_id = EAB.bank_id "
			sv_s = sv_s + "AND tran_date_bal > 0 "
			sv_s = sv_s + "AND ?SVAR BETWEEN eod_date AND end_eod_date "
			sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
			sv_s = sv_s + "AND GAM.foracid = ?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = LEFT$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.foracid
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d == 0) THEN
			#{
				BANCS.OUTPARAM.totCrBal = CUST.ASSTCLASS.eabBal
				PRINT(CUST.ASSTCLASS.eabBal)
				PRINT(BANCS.OUTPARAM.totCrBal)
			#}
			ENDIF
			
			#sv_u = urhk_getAcctTurnoverDetails(CUST.ASSTCLASS.acctNumLmon)
			IF (sv_d != 0) THEN
			#{
				CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE("0")
				PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
				#}
			ELSE
				#{
				CUST.ASSTCLASS.Tot_trn_cr_amt = CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) + CDOUBLE(BANCS.OUTPARAM.totCrBal)
				PRINT(CUST.ASSTCLASS.Tot_trn_cr_amt)
			#}
			ENDIF
			
			
			#-------------------------
			# 1. WATCH CLASSIFICATION
			#-------------------------
			
			#-------------------------------------------------------------------------
			# 1. Account operating within limit & Monthly credit turnover is between
			#    150%-75% of the approved limit
			#-------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.ASSTCLASS.clearBalance) < CDOUBLE(CUST.ASSTCLASS.sanctionLimit)) THEN
			#{
				CUST.ASSTCLASS.currDrBal1 = (CDOUBLE(CUST.ASSTCLASS.sanctionLimit) * CDOUBLE("75")) / CDOUBLE("100")
				PRINT(CUST.ASSTCLASS.currDrBal1)
				CUST.ASSTCLASS.currDrBal2 = (CDOUBLE(CUST.ASSTCLASS.sanctionLimit) * CDOUBLE("150")) / CDOUBLE("100")
				PRINT(CUST.ASSTCLASS.currDrBal2)
				
				IF ((CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) >= CUST.ASSTCLASS.currDrBal1) AND (CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) <= CUST.ASSTCLASS.currDrBal2)) THEN
				#{
					CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassPA
					CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassWATC
					GOTO COMPLETE
				#}
				ENDIF
			#}
			ENDIF
			
			#-------------------------
			# 1. NORMAL CLASSIFICATION
			#-------------------------
			
			#-------------------------------------------------------------------------
			# 1. Account operating within limit & Monthly credit turnover should be
			#    more than 150% the approved overdraft limit
			#-------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.ASSTCLASS.clearBalance) < CDOUBLE(CUST.ASSTCLASS.sanctionLimit)) THEN
			#{
				CUST.ASSTCLASS.avgCrTurnOver = (CDOUBLE(CUST.ASSTCLASS.sanctionLimit) * CDOUBLE("150")) / CDOUBLE("100")
				PRINT(CUST.ASSTCLASS.avgCrTurnOver)
				
				IF (CDOUBLE(CUST.ASSTCLASS.Tot_trn_cr_amt) > CUST.ASSTCLASS.avgCrTurnOver) THEN
				#{
					CUST.ASSTCLASS.mainClassificationSystem = CUST.ASSTCLASS.mainClassPA
					CUST.ASSTCLASS.subClassificationSystem  = CUST.ASSTCLASS.subClassNORM
					GOTO COMPLETE
				#}
				ENDIF
			#}
			ENDIF
			
		COMPLETE:
			
			PRINT(CUST.ASSTCLASS.mainClassificationSystem)
			PRINT(CUST.ASSTCLASS.subClassificationSystem)
			
			BANCS.OUTPUT.mainClassificationSystem = CUST.ASSTCLASS.mainClassificationSystem
			PRINT(BANCS.OUTPUT.mainClassificationSystem)
			BANCS.OUTPUT.subClassificationSystem  = CUST.ASSTCLASS.subClassificationSystem
			PRINT(BANCS.OUTPUT.subClassificationSystem)
			BANCS.OUTPUT.sysCustSubClass 		  = BANCS.OUTPUT.subClassificationSystem
			PRINT(BANCS.OUTPUT.sysCustSubClass)
			BANCS.OUTPUT.sysCustMainClass         = BANCS.OUTPUT.mainClassificationSystem
			PRINT(BANCS.OUTPUT.sysCustMainClass)
			BANCS.OUTPUT.sysCustSubClass          = BANCS.OUTPUT.subClassificationSystem
			PRINT(BANCS.OUTPUT.sysCustSubClass)
			BANCS.OUTPUT.assetClsReasonCode       = "."
			PRINT(BANCS.OUTPUT.assetClsReasonCode)
			#BANCS.OUTPUT.percolateToAllAssets = "N"
			BANCS.OUTPUT.trgEntityId = ""
			BANCS.OUTPUT.trgEntityType = ""
			
			
		#}
		ENDIF
	finish:
		
		EXITSCRIPT
		
		TRACE OFF
END-->
