#---------------------------------------------------------------------------------    
#	Name			: CcrrmMain.scr
#	Description		: Main Script for CCRRM Custom Menu
#	Date			: 03-10-2023
#	Author			: JAMES GICHIRI
#	Input			: NA
#	Output			: NA
#	Called Script	: jsp
#	Menu Option		: CCRRM
#----------------------------------------------------------------------------------

<--START
TRACE ON
LIBNAME CUSTOMSO


	if (REPEXISTS("CUST")==0)THEN
	#{
	CREATEREP("CUST")
	#}
	endif

	if (CLASSEXISTS("CUST","CCRRM")==0)THEN
	#{
	CREATECLASS("CUST","CCRRM",5)
	#}
	endif
	
	
	sv_a = urhk_b2k_printRepos("BANCS")
	print(sv_a)
	
	print("UPLOAD START")
	
	CUST.CCRRM.funCode=BANCS.INPUT.funCode
	PRINT(CUST.CCRRM.funCode)
		
	#====================VERIFICATION SECTION
	
	IF(CUST.CCRRM.funCode =="V")THEN
	#{
		print("verification starts")
		
		CUST.CCRRM.refcode = BANCS.INPUT.refnumber
		
		# ----- Report Generation
		
		CUST.CCRRM.reportfile = "RPT_CIFMODE_"+CUST.CCRRM.refcode+".lst"
		
		sv_r = system("echo '\n\t\tVERIFICATION REPORT FOR RISK RATING\n\n\t\tFILENAME:\t\n' >> "+CUST.CCRRM.reportfile)
		print(sv_r)
		
		# --- End
		
		sv_s= " entryuserid | select RCRE_USER_ID from custom.ccrrm where ref_code=?SVAR and rownum='1' and bank_id=?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CCRRM.refcode +"|"+BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_q = urhk_dbselectWithBind(sv_s)
		print(sv_q)
		IF(sv_q != 0) THEN
		#{
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_02|ERROR^Invalid  Reference number^"
			sv_u = urhk_SetOrbOut(sv_z)
			EXITSCRIPT
		#}
		ELSE
		#{
			CUST.CCRRM.entryuser = BANCS.OUTPARAM.entryuserid
			print(CUST.CCRRM.entryuser)
			IF(CUST.CCRRM.entryuser==BANCS.STDIN.userId)THEN
			#{
				sv_z = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_z)
				sv_z = "Error_02|ERROR^Entry user cannnot verify^"
				sv_u = urhk_SetOrbOut(sv_z)
				EXITSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Verification successful for : "+CUST.CCRRM.refcode+" code. Check status in HPR"
		sv_z = urhk_SetOrbOut(sv_g)

		PRINT(sv_z)
		
		#=======================   Fetch data for verification  START
		
		sv_s = "customerid,customertype | select CIF_ID,CUST_TYPE from custom.ccrrm where ref_code=?SVAR and bank_id='"+BANCS.STDIN.contextBankId+"' and ENTITY_CRE_FLG='N' and VALID_FLG='Y' "
		BANCS.INPARAM.BINDVARS = CUST.CCRRM.refcode
		print(BANCS.INPARAM.BINDVARS)
        sv_k = urhk_dbCursorOpenWithBind(sv_s)
        PRINT(sv_k)
        sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        PRINT(sv_m)
        sv_c = urhk_dbCursorFetch(sv_m)
        PRINT(sv_c)
        IF(sv_c != 0)THEN
		#{
				CUST.CCRRM.SorFmessage = "No records found in the upload table for verification"
                sv_c=urhk_dbCursorClose(sv_m)
				
				sv_r = system("echo '\t"+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
				print(sv_r)
				
				GOTO VERREPORTSECTION
				
				
		#}		
        ELSE
		#{
            sv_j = 0
            PRINT(sv_j)
						
			WHILE (sv_c == 0)
				
				
				CUST.CCRRM.cust_id    = BANCS.OUTPARAM.customerid
				CUST.CCRRM.customertype    = BANCS.OUTPARAM.customertype
				CUST.CCRRM.verifyflg  = "F"
				CUST.CCRRM.entitycreflg = "N"
				#--------------------------------------------------------------------------------------------------------------
				# Inputs for Account Modify services
				# urhk_SetUrhkInp is used to set inputs
				#--------------------------------------------------------------------------------------------------------------
				
				call("ccrrVerifyReq.scr")
				
				IF(FIELDEXISTS(CUST.CRRMVER.SuccessOrFailure) == 1)THEN	
				#{
						print(CUST.CRRMVER.SuccessOrFailure)
						IF(trim(CUST.CRRMVER.SuccessOrFailure) == "S")THEN
						#{
							CUST.CCRRM.ModSuccessflg ="M"
							CUST.CCRRM.verifyflg = "P"
							CUST.CCRRM.entitycreflg = "Y"
							CUST.CCRRM.SorFmessage = "CIF Verified successfully"
								
						#}
						ELSE
						#{
							IF(FIELDEXISTS(CUST.CRRMVER.errorDesc) == 1)THEN
							#{
								CUST.CCRRM.SorFmessage = CUST.CRRMVER.errorDesc
							#}
							ELSE
							#{
								CUST.CCRRM.SorFmessage = "CIF Verification failed,Manual verification required"
							#}
							ENDIF
							CUST.CCRRM.verifyflg = "F"
						#}
						ENDIF
				#}
				ENDIF
				
				CUST.CCRRM.SorFmessage = CUST.CCRRM.cust_id +"   "+CUST.CCRRM.SorFmessage 
				print(CUST.CCRRM.SorFmessage)
				
				sv_r = system("echo '   "+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
				print(sv_r)
				
				
				#++++++++++Update the records after verification
				
				#------------------------------------------------------------
				#-- Updating the CCRRM table on the success condition  ---
				#-- status U - uploaded no modifification done yet-----------
				#-- status F - Failed to do modifification ------------------
				#-- status V - modification done, pending verification ------
				#-- status P - uploaded , modified done and verified --------
				#------------------------------------------------------------
				
				
				sv_s = "update CUSTOM.CCRRM set ENTITY_CRE_FLG=?SVAR,STATUS_CODE=?SVAR,LCHG_USER_ID=?SVAR,LCHG_TIME=sysdate where CIF_ID=?SVAR  and REF_CODE=?SVAR and bank_id=?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CCRRM.entitycreflg +"|"+  CUST.CCRRM.verifyflg +"|"+ BANCS.STDIN.userId +"|"+ CUST.CCRRM.cust_id  +"|"+ CUST.CCRRM.refcode +"|"+BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				print(sv_s)
				sv_d=urhk_dbSqlWithBind(sv_s)
				IF (sv_d == 0)THEN
					sv_d = urhk_dbSQLWithBind("COMMIT")
				ENDIF
				
				sv_c = urhk_dbCursorFetch(sv_m)
				PRINT(sv_c)
				
			DO
			
			sv_c = urhk_dbCursorClose(sv_m)
			PRINT(sv_c)
			
		
		# ====================== END
		ENDIF
		
		
		#==================Report compilation 
		
		VERREPORTSECTION:
		
		sv_r = system("sleep 5")
		#********* START 
		
		sv_a=urhk_getEnv("B2K_SESSION_ID")
		IF(sv_a== 0)THEN
		#{
			CUST.CCRRM.session_id = BANCS.OUTPARAM.envValue
			print(CUST.CCRRM.session_id)
			
		#}
		ELSE
		#{
			CUST.CCRRM.errorMsg = "No sesion available"
			EXITSCRIPT
		#}
		ENDIF
		
		sv_r = system("sleep 5")
		print(sv_r)
		
		sv_u = urhk_getFileLocation("COM|ccrrm.com")
		IF(sv_u==0)THEN
		#{
			#Setting env variable
			#Session Id
			sv_a = "sessionid|" + CUST.CCRRM.session_id
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF
			
			#userId
			print(BANCS.STDIN.userId)
			sv_a = "userid|" + BANCS.STDIN.userId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF
			
			#Success file name
			sv_a = "successfile|" + CUST.CCRRM.reportfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF

			#Execute the com file
			BANCS.INPARAM.scriptName = "ccrrm.com"
			BANCS.INPARAM.arguments = ""
  			sv_u = urhk_CallShellScript("b")
  			print(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Could not execute com file: Report generation failed"
  				EXITSCRIPT
  			#}
  			ENDIF
			
			
			
			sv_r=system("rm -f"+ CUST.CCRRM.reportfile)
		#}
		ELSE
		#{
			CUST.CCRRM.errorMsg = "Unable to load the com file"
  				 exitscript
		#}
		ENDIF
		
		
		#********* END
		
		
		EXITSCRIPT
		
		
	#}
	ENDIF
	
	print("Breakpoint 1")
	
	IF(CUST.CCRRM.funCode == "U")THEN
	#{
	
		#====================== Sequence Generation for Ref code
		
		
		#------------------------------------------------
		# Fetching a unique ref for uploadFileName
		#------------------------------------------------
		sv_m = "refnum|select CUSTOM.CCRRM_SEQ_54.NEXTVAL FROM DUAL"
		print(sv_m)
		sv_q = urhk_dbselectWithBind(sv_m)
		print(sv_q)
		IF(sv_q != 0) THEN
		#{
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_02|ERROR^Unable to generate Ref number.Chech sequence.^"
			sv_u = urhk_SetOrbOut(sv_z)
			EXIT
		#}
		ELSE
		#{
			CUST.CCRRM.refnumber = "REF" + BANCS.OUTPARAM.refnum
			print(CUST.CCRRM.refnumber)
		#}
		ENDIF


		print("Start file upload")
		
		IF (FIELDEXISTS(BANCS.INPUT.uploadFileName)) THEN
		#{
			PRINT(BANCS.INPUT.uploadFileName)
			CUST.CCRRM.UPLOADFILENAME=BANCS.INPUT.uploadFileName
			
			call("upldvat.scr")
		#}
		else
		#{
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^Unable to get filename.^"
			sv_u = urhk_SetOrbOut(sv_z)
			EXITSCRIPT
			
		#}
		endif
		
		
		sv_s = "uplfilename |"
		sv_s = sv_s + " select substr('"+ CUST.CCRRM.UPLOADFILENAME +"',instr('"+ CUST.CCRRM.UPLOADFILENAME +"' ,'/',-1)+1) "
		sv_s = sv_s + " from dual "
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		if(sv_d == 0) then
		#{
			CUST.CCRRM.workfile = BANCS.OUTPARAM.uplfilename
			print(CUST.CCRRM.workfile)
			
			
		#}ENDIF
		
		
		#Sleep 5 seconds to allow file download
		sv_r=system("sleep 10")
		print(sv_r)
		
		#Access the file

		sv_a = "test -f "+ CUST.CCRRM.workfile
		PRINT(sv_a)
		sv_r = SYSTEM(sv_a)
		PRINT(sv_r)
		IF(sv_r !=0 )THEN
		#{
			print("Error in gettting the file name")
			EXITSCRIPT
		#}
		endif
		
		

		CUST.CCRRM.uploadPath1=""
		CUST.CCRRM.uploadPath=""
		print(CUST.CCRRM.workfile)

		sv_b = urhk_getEnv("ONS_LOG_DIR")
		PRINT(sv_b)
		IF(sv_b ==0) THEN
		#{
			CUST.CCRRM.uploadPath1=BANCS.OUTPARAM.envValue
			PRINT(CUST.CCRRM.uploadPath1)
			
			CUST.CCRRM.uploadPath = CUST.CCRRM.uploadPath1+"/"+BANCS.STDIN.userId+"/"+CUST.CCRRM.workfile
			PRINT(CUST.CCRRM.uploadPath)
		#}
		ENDIF
		print(CUST.CCRRM.uploadPath)	


		
		CUST.CCRRM.reportfile = "RPT_CIFMODE_"+CUST.CCRRM.refnumber+".lst"
		
		#Create a file to spool the modification report success and fail.
		
		sv_r = system("echo '\n\t\tREPORT FOR RISK RATING\n\n\t\tFILENAME:\t"+CUST.CCRRM.workfile+"\n' >> "+CUST.CCRRM.reportfile)
		print(sv_r)
		#GOTO  ENDOFSCRIPT
		
		sv_r = urtn_fileAccess(CUST.CCRRM.uploadPath)
		print(sv_r)
		IF ( sv_r != 0 ) THEN
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^Unable to Access the file^fileName"
			sv_u = urhk_SetOrbOut(sv_z)
			EXITSCRIPT
		ENDIF

		
		#Read the file 
		
		sv_t = urtn_fileOpen(CUST.CCRRM.uploadPath+"|r")
		print(sv_t)
		IF (sv_t < 0) THEN
		
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^Unable to open the file^fileName"
			sv_u = urhk_SetOrbOut(sv_z)
			GOTO ENDOFSCRIPT
		ELSE
			print("File Opened SuccessFully")
			CUST.CCRRM.succIndex = sv_t
		ENDIF

		print(CUST.CCRRM.succIndex)
		
		#Read file
		CUST.CCRRM.fileRec = urtn_fileOpen(CUST.CCRRM.uploadPath + "|r")
		PRINT(CUST.CCRRM.fileRec)
		
		sv_t = urtn_fileRead(CUST.CCRRM.fileRec + "|CUST.CCRRM.inputdata")
		print(sv_t)
		print(CUST.CCRRM.inputdata)
		IF(sv_t != 0) THEN
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^Upload file is empty^fileName"
			sv_u = urhk_SetOrbOut(sv_z)
			GOTO ENDOFSCRIPT
		ENDIF
		
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Fileupload successful. Proceed with verification "+CUST.CCRRM.refnumber+" code. Check status in HPR"
		sv_z = urhk_SetOrbOut(sv_g)

		PRINT(sv_z)

		#=============================================
		# Parsing the inputdata
		#==============================================
		CUST.CCRRM.CIF_ID 				= ""
		CUST.CCRRM.ACCT_NAME 			= ""
		CUST.CCRRM.RISK_SCORE			= ""
		CUST.CCRRM.RISK_RATING			= ""
		CUST.CCRRM.VALID				= ""
		CUST.CCRRM.STATUS_CODE			= ""
		CUST.CCRRM.fileRead=sv_t
		sv_a= CUST.CCRRM.fileRead
		print(sv_a)
		############################################################################################
		#success report
		############################################################################################
		sv_b = 0
		sv_d = 0
		WHILE(sv_a  == 0)

			IF(sv_d=="0")THEN
			#{
				print(sv_d)
				GOTO NEXTREC
			#}
			ENDIF
			sv_m = CUST.CCRRM.inputdata+"|"
				print(sv_m)
			
			PRINT(CUST.CCRRM.inputdata)
			CUST.CCRRM.uploadstring = CUST.CCRRM.inputdata
			print(CUST.CCRRM.uploadstring)

			#1
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			sv_b = GETPOSITION(CUST.CCRRM.inputdata, '|')
			print(sv_b)
			sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			CUST.CCRRM.CIF_ID = sv_a
			print(CUST.CCRRM.CIF_ID)


			#2
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			sv_b = GETPOSITION(CUST.CCRRM.inputdata, '|')
			print(sv_b)
			sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			CUST.CCRRM.ACCT_NAME = sv_a
			print(CUST.CCRRM.ACCT_NAME)

			#3
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			sv_b = GETPOSITION(CUST.CCRRM.inputdata, '|')
			print(sv_b)
			sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			CUST.CCRRM.RISK_SCORE = sv_a
			print(CUST.CCRRM.RISK_SCORE)
			
			#4
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			CUST.CCRRM.RISK_RATING = CUST.CCRRM.inputdata
			print(CUST.CCRRM.RISK_RATING)
			#sv_b = GETPOSITION(CUST.CCRRM.inputdata, '')
			#print(sv_b)
			#sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			#CUST.CCRRM.RISK_RATING = sv_a
			#print(CUST.CCRRM.RISK_RATING)

			#--------------------------------------------------------
			#call the script for inserting data
			#--------------------------------------------------------
				CALLSCRIPTIFEXIST("Ccrrm_insert.scr")

			#--------------------------------------------------------
			#--------------------------------------------------------


			NEXTREC:
			
				sv_d = sv_d + 1
				print(sv_d)
				
			
			sv_a = urtn_fileRead(CUST.CCRRM.fileRec + "|CUST.CCRRM.inputdata")
			CUST.CCRRM.fileread = sv_a
			print(sv_a)
		#}
		Do
	

		# --------------  Closing the file
		
		#sv_j = urtn_fileClose(CUST.CCRRM.FilePath)
		#print(sv_j)
		sv_t = urtn_fileClose(CUST.CCRRM.fileRec)
		PRINT(sv_t)
		
		#====================  FETCHING RECORDS FROM THE TABLE Start
		
			#Start of acct Modification
			print(CUST.CCRRM.refnumber)
			
			sv_s = "CIF_ID,RISK_SCORE,RISK_RATING,CUST_TYPE| select CIF_ID,risk_score,risk_rating,cust_type from custom.ccrrm  where ENTITY_CRE_FLG='N' "
			sv_s = sv_s + " and VALID_FLG ='Y' and RCRE_USER_ID=?SVAR and bank_id=?SVAR and ref_code=?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+BANCS.STDIN.contextBankId+"|"+CUST.CCRRM.refnumber
			print(BANCS.INPARAM.BINDVARS)
			sv_k = urhk_dbCursorOpenWithBind(sv_s)
			PRINT(sv_k)
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_m)
			sv_c = urhk_dbCursorFetch(sv_m)
			PRINT(sv_c)
			IF(sv_c != 0)THEN
			#{
					CUST.CCRRM.SorFmessage = "No records found in the upload table"
					print(CUST.CCRRM.SorFmessage)
					sv_c=urhk_dbCursorClose(sv_m)
					
					sv_r = system("echo '\t"+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
					print(sv_r)
					GOTO UPDATERPT
			#}		
			ELSE
			#{
				sv_j = 0
				PRINT(sv_j)

				WHILE (sv_c == 0)

					CUST.CCRRM.customer_id  	= BANCS.OUTPARAM.CIF_ID
					CUST.CCRRM.riskscore		= BANCS.OUTPARAM.RISK_SCORE
					CUST.CCRRM.riskrating		= BANCS.OUTPARAM.RISK_RATING
					CUST.CCRRM.customertype		= BANCS.OUTPARAM.CUST_TYPE				
					CUST.CCRRM.ModSuccessflg 	= "F"
					CUST.CCRRM.SorFmessage      = ""
					CUST.CCRRM.Statuscode    	= "U"
					
					print(CUST.CCRRM.customer_id)
					print(CUST.CCRRM.riskscore)
					print(CUST.CCRRM.riskrating)
					print(CUST.CCRRM.customertype)
					
					IF ((CUST.CCRRM.customertype=="I") OR (CUST.CCRRM.customertype=="C") )THEN
					#{
						IF(CUST.CCRRM.customertype=="I")THEN
						#{
							PRINT("MODIFY RETAIL CIF")
							call("ccrrRetModReq.scr")	
							
						#}
						ELSE
						#{
							PRINT("MODIFY COPRERATE CIF")
							call("ccrrCorpModReq.scr")
							
							
						#}
						ENDIF
						
					#}
					ELSE
					#{
						print("Invalid customer cif id")
						#Create a report for the failed and invalid cif_id
						CUST.CCRRM.SorFmessage = "Invalid CIF"
						CUST.CCRRM.ModSuccessflg = "F"
						CUST.CCRRM.Statuscode = "F"
						
						GOTO UPDATERPT
						
						
						
					#}
					ENDIF
					
					IF(FIELDEXISTS(CUST.CRMREQ.SuccessOrFailure) == 1)THEN
					#{
						print(CUST.CRMREQ.SuccessOrFailure)
						IF(trim(CUST.CRMREQ.SuccessOrFailure) == "S")THEN
						#{
							CUST.CCRRM.ModSuccessflg ="M"
							CUST.CCRRM.Statuscode = "V"
							CUST.CCRRM.SorFmessage = "CIF Modified successfully"
							
								
						#}ss
						ELSE
						#{
							IF(FIELDEXISTS(CUST.CRMREQ.errorDesc) == 1)THEN
							#{
								CUST.CCRRM.SorFmessage = CUST.CRMREQ.errorDesc
							#}
							ELSE
							#{
								CUST.CCRRM.SorFmessage = "CIF Modification failed,Manual update required"
							#}
							ENDIF
							CUST.CCRRM.Statuscode = "F"
						#}
						ENDIF	
					ENDIF
					
					# ============================== UPDATE THE MODIFCATION FLAGS
					UPDATERPT: 
					
						print(CUST.CCRRM.ModSuccessflg)
						CUST.CCRRM.SorFmessage = CUST.CCRRM.customer_id+"   "+CUST.CCRRM.SorFmessage 
						print(CUST.CCRRM.SorFmessage)
						
						sv_r = system("echo '   "+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
						print(sv_r)
						
						
						#++++++++++ Start Update 
						
						#------------------------------------------------------------
						#------Updating the CCRRM table on the success condition  ---
						#------status U - uploaded no modifification done yet----------
						#------status F - Failed to do modifification 			  ---
						#------status V - modification done, pending verification ---
						#------status P - uploaded , modified done and verified -----
						#------------------------------------------------------------
						
						
						sv_s = "update CUSTOM.CCRRM set STATUS_CODE=?SVAR,"
						sv_s = sv_s + "REMARKS= substr(replace (q'["+CUST.CCRRM.SorFmessage+"]',q'[|]',q'[ ]'),0,200) "
						sv_s = sv_s + "where CIF_ID=?SVAR "
						sv_s = sv_s + "and REF_CODE=?SVAR "
						sv_s = sv_s + "and bank_id=?SVAR"
						print(sv_s)
						BANCS.INPARAM.BINDVARS =  CUST.CCRRM.Statuscode + "|" + CUST.CCRRM.customer_id +"|"+  CUST.CCRRM.refnumber +"|"+ BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						print(sv_s)
						sv_d=urhk_dbSqlWithBind(sv_s)
						IF (sv_d == 0)  THEN
							sv_d = urhk_dbSQLWithBind("COMMIT")
						ENDIF
								
						#++++++++++ End update 
				
					sv_c = urhk_dbCursorFetch(sv_m)
					PRINT(sv_c)
					
				DO
				sv_c = urhk_dbCursorClose(sv_m)
				PRINT(sv_c)
			
		
		#====================   END ============================
		
		ENDOFSCRIPT:
		
		#================ Report compilation
		sv_a=urhk_getEnv("B2K_SESSION_ID")
		IF(sv_a== 0)THEN
		#{
			CUST.CCRRM.session_id = BANCS.OUTPARAM.envValue
			print(CUST.CCRRM.session_id)
			
		#}
		ELSE
		#{
			CUST.CCRRM.errorMsg = "No sesion available"
			EXITSCRIPT
		#}
		ENDIF
		
		sv_r = system("sleep 5")
		print(sv_r)
		
		sv_u = urhk_getFileLocation("COM|ccrrm.com")
		IF(sv_u==0)THEN
		#{
			#Setting env variable
			#Session Id
			sv_a = "sessionid|" + CUST.CCRRM.session_id
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF
			
			#userId
			print(BANCS.STDIN.userId)
			sv_a = "userid|" + BANCS.STDIN.userId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF
			
			#Success file name
			sv_a = "successfile|" + CUST.CCRRM.reportfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF

			#Execute the com file
			BANCS.INPARAM.scriptName = "ccrrm.com"
			BANCS.INPARAM.arguments = ""
  			sv_u = urhk_CallShellScript("b")
  			print(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Could not execute com file: Report generation failed"
  				EXITSCRIPT
  			#}
  			ENDIF
			
			
			
			sv_r=system("rm -f"+ CUST.CCRRM.reportfile)
		#}
		ELSE
		#{
			CUST.CCRRM.errorMsg = "Unable to load the com file"
  				 exitscript
		#}
		ENDIF
		
		
	
	#}
	ENDIF
	
	print("Processing Ends")

 

exitscript
TRACE OFF
END-->



