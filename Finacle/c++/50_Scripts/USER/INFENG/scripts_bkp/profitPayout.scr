							MTT.PartTranDetails.Consolidate = "N"
							MTT.PartTranDetails.Particulars = "Acct Payout/" + MTT.InputDetails.custAcNumber + "/" + sv_a + " to " + sv_e
							MTT.PartTranDetails.TranIdentifier = sv_z
							MTT.PartTranDetails.PTranBusinessType = "PO SUNDRY CR"
							MTT.PartTranDetails.ReportCode=""
							sv_s = urhk_MTTS_DefinePartTran("CR")
							IF (sv_s != 0) THEN
							#{
								BANCS.OUTPUT.successOrFailure = "F"
								BANCS.OUTPUT.scriptError = "urhk_MTTS_DefinePartTran returns FAILURE"
								EXITSCRIPT
							#}
							ENDIF
						#}
						ENDIF
						#}
						#if recoverableAmt is equal to zero
						#}
					ELSE
						#{
						#credit part tran for cust Acct
						PRINT(sv_w)
						#sv_i= sv_w*0.15
						#sv_w = sv_w - sv_i
						
						
						MTT.PartTranDetails.RefAmount =  sv_w
						MTT.PartTranDetails.RateCode = MTT.InputDetails.profitRateCode
						MTT.PartTranDetails.Account = sv_h
						MTT.PartTranDetails.RefCurrency =MTT.InputDetails.custAcCrncy
						MTT.PartTranDetails.ValueDate = sv_v
						MTT.PartTranDetails.Consolidate = "N"
						IF(MTT.InputDetails.ageEligible == "N") THEN
						#{
							MTT.PartTranDetails.Particulars = "Parked Sundry, Criteria not met/" + MTT.InputDetails.custAcNumber + "/" + sv_a + " to " + sv_e
							#}
						ELSE
							#{
							MTT.PartTranDetails.Particulars = "Acct Payout/" + MTT.InputDetails.custAcNumber + "/" + sv_a + " to " + sv_e
						#}
						ENDIF
						MTT.PartTranDetails.TranIdentifier = sv_z
						MTT.PartTranDetails.PTranBusinessType = "PO CUST CR"
						MTT.PartTranDetails.ReportCode=""
						
						# Populate Distribution tran report code
						BANCS.INPARAM.CustAcct=sv_h
						BANCS.INPARAM.DrCrInd="C"
