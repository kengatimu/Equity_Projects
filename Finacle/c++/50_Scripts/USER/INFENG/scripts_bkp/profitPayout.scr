						###############################################################################
						# As its a II type so before crediting into cust account we can substract the wth tax amount
						# and credit the same into the placeholder account set at scheme level
						PRINT(MTT.InputDetails.ageEligible)
						IF(MTT.InputDetails.ageEligible != "N") THEN
						#{
							CUST.WITHTAX.drAccount 				= 	sv_h
							CUST.WITHTAX.wthFlgChkAcct			=   MTT.InputDetails.custAcNumber
							CUST.WITHTAX.tranAmt 				= 	sv_w
							#CUST.WITHTAX.RateCode				=   MTT.InputDetails.profitRateCode
							CUST.WITHTAX.RateCode				=   ""
							CUST.WITHTAX.tranIdentifier			=	sv_z
							IF(CDOUBLE(CUST.WITHTAX.tranAmt)>0) THEN
							#{
								CALL("wthmn037.scr")
								IF(CUST.WITHTAX.successOrFailure == "F") THEN
								#{
									BANCS.OUTPUT.successOrFailure = "F"
									BANCS.OUTPUT.scriptError = CUST.WITHTAX.scriptError
									EXITSCRIPT
