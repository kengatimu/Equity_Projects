		#------------------------------ TRANSACTION FOR PRE-RENEWAL PROFIT DISTRIBUTION -----------------------------------#
		PRINT(MTT.InputDetails.schmType)
		PRINT(BANCS.OUTPUT.profitSplitReq)
		PRINT(MTT.InputDetails.prodType)
		
		IF( ( MTT.InputDetails.schmType == "TUA" ) AND ( BANCS.OUTPUT.profitSplitReq == "Y" ) AND  (MTT.InputDetails.prodType != "I")) THEN
		#{
			#Debit Sundry Accnt #
			sv_n = MTT.PartTranDetails.pref_amt_before_renewal
			sv_b = CDOUBLE( MTT.PartTranDetails.prft_amt_bfre_frst_renewal ) + CDOUBLE( sv_n )
			
			PRINT(sv_b)
			
			MTT.PartTranDetails.RefAmount           = - sv_b
			MTT.PartTranDetails.RateCode            = MTT.InputDetails.profitRateCode
			MTT.PartTranDetails.Account             = MTT.InputDetails.sundryAcct
			MTT.PartTranDetails.RefCurrency         = MTT.InputDetails.custAcCrncy
			MTT.PartTranDetails.ValueDate           = sv_v
			MTT.PartTranDetails.Consolidate         = "N"
			MTT.PartTranDetails.Particulars         = sv_i + MTT.InputDetails.sundryAcct + "/" + sv_a + "/" + sv_e
			MTT.PartTranDetails.TranIdentifier      = "PRE RENEWAL TRAN"
			MTT.PartTranDetails.PTranBusinessType   = "PO SUNDRY DR"
			MTT.PartTranDetails.ReportCode          = ""
			MTT.PartTranDetails.Remarks             = "PRE-RENEWAL PROFIT DR. SUNDRY"
			
			sv_s = urhk_MTTS_DefinePartTran("DR")
			PRINT(sv_s)
			IF (sv_s != 0) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.scriptError      = "urhk_MTTS_DefinePartTran returns FAILURE"
				EXITSCRIPT
			#}
			ENDIF
			
			# Credit TU Account #
			MTT.PartTranDetails.RefAmount           = sv_b
			MTT.PartTranDetails.RateCode            = MTT.InputDetails.profitRateCode
			MTT.PartTranDetails.Account             = MTT.InputDetails.distrAcct
			MTT.PartTranDetails.RefCurrency         = MTT.InputDetails.custAcCrncy
			MTT.PartTranDetails.ValueDate           = sv_v
			MTT.PartTranDetails.Consolidate         = "N"
			MTT.PartTranDetails.Particulars         = sv_i + MTT.InputDetails.custAcNumber + "/" + sv_a + "/" + sv_e
			MTT.PartTranDetails.TranIdentifier      = "PRE RENEWAL TRAN"
			MTT.PartTranDetails.PTranBusinessType   = "PAYOUT PAYABLE CR"
			MTT.PartTranDetails.ReportCode          = ""
			MTT.PartTranDetails.Remarks             = "PRE-RENEWAL PROFIT CR. CUST."
			
			sv_s = urhk_MTTS_DefinePartTran("CR")
			###############################################################################
