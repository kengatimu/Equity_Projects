										EXITSCRIPT
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
							
							###############################################################################
							# Customization for collection of With Holding Tax Ends-10
							###############################################################################
							
						#}
						ENDIF
						
						#If recoverableAmt == TotalProfit
						IF (sv_x == sv_w) THEN
						#{
							#credit part tran for sundry/recoverable Acct
							MTT.PartTranDetails.RefAmount =sv_w
							MTT.PartTranDetails.RateCode = MTT.InputDetails.profitRateCode
							MTT.PartTranDetails.Account =MTT.InputDetails.recoveryAcct
							MTT.PartTranDetails.RefCurrency = MTT.InputDetails.custAcCrncy
