#----------------------------------------------------------------------------------------------------------
# Filename              :       CTODA_GetParameterDesc.scr
# Author                :       Hari Mohan Verma
# Description           :       This script fetches the description of error code from CATOD_PARAMETER_TABLE
# Input                 :       None
# Output                :       None
# Called Script         :       All scripts that require parameter to be set
# Calling Script        :       None
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           28-05-2013          Hari               Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="e2af151aba0d16bedcfc6d2fa85a85bc22cd107eaecb2aac37495e38e0b67fdb"
	TRACE ON
	CUST.INTERFACE.SuccessFlag = "0"
	print(CUST.INTERFACE.errorCode)
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.errorCode + "|" + "Y" + "|" + "N"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "ALL" + "|CATOD|" + BANCS.STDIN.contextBankId
	sv_s = "errorDesc|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPARAM_VALUE_TABLE"
	sv_s = sv_s + " WHERE PARAMETER_ID = ?SVAR AND ENTITY_CRE_FLG = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG = ?SVAR AND LEVELCODE_1 = ?SVAR"
	sv_s = sv_s + " AND MODULE_NAME = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	print(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.INTERFACE.errorDesc = BANCS.OUTPARAM.errorDesc
		#}
	ELSE
		#{
		CUST.INTERFACE.SuccessFlag = "1"
		CUST.INTERFACE.errorDesc = "Could not fetch error description: " + CUST.INTERFACE.errorCode
	#}
	ENDIF
	print(CUST.INTERFACE.errorDesc)
	#trace off
END-->
