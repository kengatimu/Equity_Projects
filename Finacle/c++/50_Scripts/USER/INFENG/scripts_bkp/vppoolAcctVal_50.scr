<--START
	TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","ACCOPEN") == 0) THEN
	#{
		CREATECLASS("CUST","ACCOPEN",5)
	#}
	ENDIF
	
	CUST.ACCOPEN.errMsg         = ""
	######################################################
	# Inputs from jsp
	######################################################
	CUST.ACCOPEN.loanCifId = ""	
	CUST.ACCOPEN.cifId = ""
	CUST.ACCOPEN.polAcctId = ""
	PRINT(BANCS.INPUT.polAcctId)
	CUST.ACCOPEN.polAcctId  = BANCS.INPUT.polAcctId
	
	PRINT(BANCS.INPUT.cifId)
	CUST.ACCOPEN.cifId  = BANCS.INPUT.cifId 
	sv_u = urhk_getAcctDetailsInRepository(CUST.ACCOPEN.polAcctId)
	if(sv_u != 0)then
	#{
		sv_u = urhk_SetOrbOut("ValYN|E")
		exitscript
	#}
	else
	#{
		CUST.ACCOPEN.loanCifId = BANCS.OUTPARAM.cifId
	#}
	endif
	print(CUST.ACCOPEN.loanCifId)
	print(CUST.ACCOPEN.cifId)
	if(CUST.ACCOPEN.loanCifId!=CUST.ACCOPEN.cifId)then
		sv_u = urhk_SetOrbOut("ValYN|N")
	else
		sv_u = urhk_SetOrbOut("ValYN|Y")
	endif
	TRACE OFF
	EXITSCRIPT
END-->
