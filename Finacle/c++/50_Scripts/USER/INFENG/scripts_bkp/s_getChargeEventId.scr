CHECKSUM="e6155e2a14f5aa51439e4e88e68896aab1e9842b74e095ab9eab7ffb4b78f23b"
	#trace on
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CHRG") == 0) THEN
	#{
		CREATECLASS("CUST","CHRG",5)
	#}
	ENDIF
	
	#sv_q=urhk_B2k_PrintRepos("BANCS")
	#print(sv_q)
	
	CUST.CHRG.chrgEvtId     =       " "
	BANCS.INPUT.moduleName  =       "TRADE_FINANCE"
	BANCS.INPUT.parameterId =       "OCTMCHRGEVT"
	
	call("getcparamvalue.scr")
	print(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CHRG.chrgEvtId = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.CHRG.errMsg = "Charge event ID setup not done in CPARAM"
