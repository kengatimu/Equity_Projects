	sv_s = sv_s + "DOCUMENT_RECIEVED, STAFFFLAG,STAFFEMPLOYEEID, MANAGER, CUSTOMERNREFLAG, to_char(DATEOFBECOMINGNRE,'yyyy-mm-dd'), CUSTOMERMINOR, MINORGAURDIANID," 
	sv_s = sv_s + "MINOR_GUARD_CODE, MINOR_GUARD_NAME, REGION,PRIMARY_SERVICE_CENTRE, to_char(RELATIONSHIPOPENINGDATE,'yyyy-mm-dd'), CRNCY_CODE_RETAIL, TFPARTYFLAG," 
	sv_s = sv_s + "PRIMARY_SOL_ID " 
