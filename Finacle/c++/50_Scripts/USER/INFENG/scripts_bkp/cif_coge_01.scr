<--start
trace on
#################################################################
# Repository Creation For Cif-test | CIFs
#################################################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_r = CLASSEXISTS("CUST","DATA")
