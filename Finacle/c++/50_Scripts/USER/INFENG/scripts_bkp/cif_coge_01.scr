	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	sv_u = urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_u)
	
	#call("cif_test_05.scr")
	#GOTO ENDOFSCRIPT	
	
	
	sv_s = "orgkey|"
	sv_s = sv_s + " select ORGKEY ,count(ORGKEY) from CUSTOM.COGE_RETAIL  "
	sv_s = sv_s + " where processed='N' and primary_sol_id=?SVAR"
	#sv_s = sv_s + " where orgkey ='0039363'"
	sv_s = sv_s + " group by ORGKEY"
	sv_s = sv_s + " order by orgkey" 
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.mySolId
	sv_x = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_x)
	
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(sv_m)
	sv_r = urhk_dbCursorFetch(sv_m)
	print(sv_r)
	
	while (sv_r == 0)
	#{
	CUST.DATA.orgkey = BANCS.OUTPARAM.orgkey
	print(CUST.DATA.orgkey)
	
	sv_s = "ENTITYTYPE, SALUTATION_CODE, CUST_FIRST_NAME, CUST_LAST_NAME, PREFERREDNAME, SHORT_NAME, CUST_DOB, GENDER, NATIONALITY, "
