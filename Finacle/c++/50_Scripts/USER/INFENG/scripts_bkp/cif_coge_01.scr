	#sv_s = sv_s + "select  ADDRESS_TYPE,initcap(ADDRESS_CATGRY), to_char(START_DATE,'yyyy-mm-dd'),CITY_CODE, STATE_CODE, ZIP_CODE, CTRY_CODE, #ADDRESS_1,ADDRESS_2,ADDRESS_3 "
