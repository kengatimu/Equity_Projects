<--START
CHECKSUM="eab9b87ce1fb48064c53a3a929be41a1861c0f56afcb51a4b0452546a7504a54"
	#TRACE ON
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	# 	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","TRNMN") == 0) THEN
	#{
		CREATECLASS("CUST","TRNMN",5)
	#}
	ENDIF
	
	CUST.TRNMN.errMsg      = ""
	CUST.TRNMN.tranType    = ""
	CUST.TRNMN.tranSubType = ""
	CUST.TRNMN.noOfRecords = ""
	CUST.TRNMN.foracid	   = ""
	CUST.TRNMN.schmType    = ""
	CUST.TRNMN.schmCode    = ""
	CUST.TRNMN.acctSolId   = ""
	
	#-------------------------------------------------------------------------------------------------------
	# Get the trantype and transubtype
	#-------------------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.TRNMN.tranType = BANCS.OUTPARAM.srvValue
		PRINT(CUST.TRNMN.tranType)
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Type")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.TRNMN.tranSubType = BANCS.OUTPARAM.srvValue
		PRINT(CUST.TRNMN.tranSubType)
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran SUB Type")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_n = 0
	IF (((CUST.TRNMN.tranType == "T")AND(CUST.TRNMN.tranSubType == "CI"))OR((CUST.TRNMN.tranType == "C")AND(CUST.TRNMN.tranSubType == "NP"))) THEN
	#{
		#-------------------------------------------------------------------------------------------------------
		# Get the number of accounts entered from HTM menu option
		#-------------------------------------------------------------------------------------------------------
		
		sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
		PRINT(sv_u)
		IF(sv_u == 0) THEN
		#{
			CUST.TRNMN.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.TRNMN.noOfRecords)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_l = 0
		sv_m = ""
		sv_n = 0
		
		WHILE(sv_l < CUST.TRNMN.noOfRecords)
		#{
			sv_v = Format$(sv_l,"%d")
			sv_r = "<rec_"+sv_v+">"
			#-------------------------------------------------------------------------------------------
			# Fetch A/c - foracid
			#-------------------------------------------------------------------------------------------
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				CUST.TRNMN.foracid = BANCS.OUTPARAM.srvValue
				PRINT(CUST.TRNMN.foracid)
				IF(CUST.TRNMN.foracid == "") THEN
				#{
        				sv_u = urhk_SRV_SetErr("Error: Account Number should not be NULL")
        				BANCS.OUTPUT.successOrFailure="F"
        				GOTO ENDOFSCRIPT
				#}
				ENDIF	
				#}
			ELSE
				#{
				sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for foracid")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_u = urhk_getAcctDetailsInRepository(CUST.TRNMN.foracid)
			CUST.TRNMN.schmType = BANCS.OUTPARAM.schmType
			PRINT(CUST.TRNMN.schmType)
			
			IF (CUST.TRNMN.schmType == "SBA") THEN
			#{
				CUST.TRNMN.acctSolId = BANCS.OUTPARAM.acctSolId
				CUST.TRNMN.schmCode = BANCS.OUTPARAM.schmCode
				PRINT(CUST.TRNMN.acctSolId)
				PRINT(CUST.TRNMN.schmCode)
				PRINT(BANCS.STDIN.BODDate)
				
				sv_s = "cnt|SELECT COUNT(*) "
				sv_s = sv_s + "FROM CUSTOM.C_MBM "
				sv_s = sv_s + "WHERE sol_id = ?SVAR "
				sv_s = sv_s + "AND schm_code = ?SVAR "
				sv_s = sv_s + "AND mbm_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
				sv_s = sv_s + "AND mbm_status = 'B' "
				sv_s = sv_s + "AND del_flg = 'N'"
				sv_s = sv_s + "AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.TRNMN.acctSolId + "|" + CUST.TRNMN.schmCode + "|" +  LEFT$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				PRINT(sv_s)
				sv_d = urhk_dbselectWithBind(sv_s)
				PRINT(sv_d)
				PRINT(sv_s)
				PRINT(BANCS.OUTPARAM.cnt)
				
				IF (CINT(BANCS.OUTPARAM.cnt) != 0) THEN
				#{
					sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
					PRINT(sv_u)
					IF (sv_u == 0) THEN
					#{
						sv_m = sv_m  + BANCS.OUTPARAM.srvValue + ","
					#}
					ENDIF
					PRINT(sv_m)
					sv_n = sv_n + 1
				#}
				ENDIF
			#}
			ENDIF
			
			sv_l = sv_l + 1
			PRINT (sv_l)
		#}
		DO
	#}
	ENDIF
	PRINT(sv_n)
	IF (sv_n > 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		sv_m = RTRIM(sv_m ,',')
		sv_m = "This Scheme is blocked for the part tran srl no : "+  sv_m
		sv_u = urhk_SRV_SetErr(sv_m)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		
		EXITSCRIPT
		
		#TRACE OFF
END-->
