<--start
trace on
	callscriptifexist("ebRepClass.scr")
	if(EBSRV.GLBDATA.funcCode == "V")then
	#{
		lv_s = " ModUnvRecCnt|select count(1) from custom.caml_mod where id_number  =?SVAR "
		lv_s = lv_s + " and bank_id = ?SVAR "
		print(lv_s)
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		lv_r = urhk_dbSelectWithBind(lv_s)
		if ( lv_r == "0") then
		#{	
			EBSRV.GLBDATA.ModUnvRecCnt = BANCS.OUTPARAM.ModUnvRecCnt
			print(EBSRV.GLBDATA.ModUnvRecCnt)
			if (EBSRV.GLBDATA.ModUnvRecCnt != 0) then
				lv_s = " LchgUser|select lchg_user_id from custom.caml_mod where id_number  =?SVAR "
				lv_s = lv_s + " and bank_id = ?SVAR "
				print(lv_s)
				BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				lv_r = urhk_dbSelectWithBind(lv_s)
				print(lv_r)
				if (lv_r == "0") then
					EBSRV.GLBDATA.LchgUser = BANCS.OUTPARAM.LchgUser
					print(EBSRV.GLBDATA.LchgUser)
					if (BANCS.STDIN.userId == EBSRV.GLBDATA.LchgUser) then
						EBSRV.GLBDATA.errMsg = "Same User Cannot Verify!!!"
						GOTO ERROR
					endif
				endif
			endif
		#}
		endif
		lv_s = " UnvRecCnt | select count(1) from custom.caml where id_number  =?SVAR "
		lv_s = lv_s + " and bank_id = ?SVAR "
		lv_s = lv_s + " and del_flg <> 'Y' "
		lv_s = lv_s + " and entity_cre_flg in ('X','N') "
		print(lv_s)
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		lv_r = urhk_dbSelectWithBind(lv_s)
		if ( lv_r == "0") then
			EBSRV.GLBDATA.UnvRecCnt = BANCS.OUTPARAM.UnvRecCnt
			print(EBSRV.GLBDATA.UnvRecCnt)
		endif
		if (( EBSRV.GLBDATA.ModUnvRecCnt == "0" ) AND ( EBSRV.GLBDATA.UnvRecCnt != "0" ) ) then
			lv_s = "LchgUser|select lchg_user_id from custom.caml where id_number  =?SVAR "
			lv_s = lv_s + " and bank_id = ?SVAR "
			lv_s = lv_s + " and del_flg <> 'Y' "
			lv_s = lv_s + " and entity_cre_flg in ('X','N') "
			print(lv_s)
			BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			lv_r = urhk_dbSelectWithBind(lv_s)
			if ( lv_r == "0") then
				EBSRV.GLBDATA.LchgUser = BANCS.OUTPARAM.LchgUser
				print(EBSRV.GLBDATA.LchgUser)
				if (BANCS.STDIN.userId == EBSRV.GLBDATA.LchgUser) then
					EBSRV.GLBDATA.errMsg = "Same User Cannot Verify!!!"
					GOTO ERROR
				endif
			endif
		endif
		if ((EBSRV.GLBDATA.ModUnvRecCnt == "0" ) AND ( EBSRV.GLBDATA.UnvRecCnt == "0")) then
			EBSRV.GLBDATA.errMsg = "Nothing to Verify"
			GOTO ERROR
		endif	
	#}
	endif
	if (EBSRV.GLBDATA.orgKey !="") then

	lv_s = "CustName,CustBranch,CustConst,CustDob,CustCntry|"
	lv_s = lv_s + " select name,cs.sol_desc,custom.fn_ref_desc(a.bank_id,constitution_ref_code,'44'),"
	lv_s = lv_s + " to_char(to_date(a.cust_dob,'DD-MM-RRRR'),'DD-MM-YYYY'),   "
	lv_s = lv_s + " (select d.localetext from crmuser.categories m,crmuser.category_lang d "
	lv_s = lv_s + " where m.bank_id=d.bank_id  "
	lv_s = lv_s + " and m.categorytype ='COUNTRY' "
	lv_s = lv_s + " and m.categoryid=d.categoryid "
	lv_s = lv_s + " and m.value=a.country "
	lv_s = lv_s + " and m.bank_id=a.bank_id "
	lv_s = lv_s + " and d.bank_id=a.bank_id and rownum <2) "
	lv_s = lv_s + " from crmuser.accounts a,tbaadm.sol cs "
	lv_s = lv_s + " where a.orgkey=?SVAR "
	lv_s = lv_s + " and a.primary_sol_id=cs.sol_id "
	lv_s = lv_s + " and a.bank_id = cs.bank_id "
	lv_s = lv_s + " and a.bank_id = ?SVAR "
	lv_s = lv_s + " and cs.bank_id = ?SVAR "
	print(lv_s)
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.orgKey + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	lv_r = urhk_dbSelectWithBind(lv_s)
	print(lv_r)
	if (lv_r == "0") then
                        EBSRV.GLBDATA.CustName = BANCS.OUTPARAM.CustName
                        print(EBSRV.GLBDATA.CustName)
                        EBSRV.GLBDATA.CustBranch = BANCS.OUTPARAM.CustBranch
                        print(EBSRV.GLBDATA.CustBranch)
                        EBSRV.GLBDATA.CustConst = BANCS.OUTPARAM.CustConst
                        print(EBSRV.GLBDATA.CustConst)
                        EBSRV.GLBDATA.CustDob = BANCS.OUTPARAM.CustDob
                        print(EBSRV.GLBDATA.CustDob)
                        EBSRV.GLBDATA.CustCntry = BANCS.OUTPARAM.CustCntry
                        print(EBSRV.GLBDATA.CustCntry)
                        if(EBSRV.GLBDATA.CustConst == "No Data Found") then
                                EBSRV.GLBDATA.CustConst = ""
                        endif
	endif
	endif
	lv_s = " ModUnvRecCnt | select count(1) from custom.caml_mod where id_number = ?SVAR "
	lv_s = lv_s + " and bank_id = ?SVAR "
	print(lv_s)
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.UniqIdNum + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	lv_r = urhk_dbSelectWithBind(lv_s)
	print(lv_r)
	if ( lv_r == "0") then
		EBSRV.GLBDATA.ModUnvRecCnt = BANCS.OUTPARAM.ModUnvRecCnt
		print(EBSRV.GLBDATA.ModUnvRecCnt)
		if ( EBSRV.GLBDATA.ModUnvRecCnt != "0" ) then
			lv_s = "cifId,custName,custDob,custConst,custBranch,IdType,IdNumber,backlistCode,lchgUser,backlistEvi,"
			lv_s = lv_s + " WatchList,WatchListReson|"
			lv_s = lv_s + " select cif_id,cust_name,cust_dob,cust_const,cust_branch,id_type,"
			lv_s = lv_s + " id_number,backlist_code,lchg_user_id,backlist_evidence, "
			lv_s = lv_s + " free_text1,free_text2 from custom.caml_mod "
			lv_s = lv_s + " where bank_id=?SVAR "
			lv_s = lv_s + " and id_number=?SVAR "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.UniqIdNum
			print(BANCS.INPARAM.BINDVARS)
			lv_r = urhk_dbSelectWithBind(lv_s)
			print(lv_r)
			if ( lv_r == "0") then
				EBSRV.GLBDATA.orgKey = BANCS.OUTPARAM.cifId
				EBSRV.GLBDATA.CustName = BANCS.OUTPARAM.custName
				EBSRV.GLBDATA.CustDob = BANCS.OUTPARAM.custDob
				EBSRV.GLBDATA.CustConst = BANCS.OUTPARAM.custConst
				EBSRV.GLBDATA.CustBranch = BANCS.OUTPARAM.custBranch
				EBSRV.GLBDATA.IdType = BANCS.OUTPARAM.IdType
				EBSRV.GLBDATA.IdNumber = BANCS.OUTPARAM.IdNumber
				EBSRV.GLBDATA.backlistCode = BANCS.OUTPARAM.backlistCode
				EBSRV.GLBDATA.backlistEvi = BANCS.OUTPARAM.backlistEvi
				EBSRV.GLBDATA.LchgUser = BANCS.OUTPARAM.lchgUser
				EBSRV.GLBDATA.WatchList = BANCS.OUTPARAM.WatchList
				EBSRV.GLBDATA.WatchListReson = BANCS.OUTPARAM.WatchListReson
				print(EBSRV.GLBDATA.LchgUser)
				EBSRV.GLBDATA.RecVerifyType = "MOD"
				print(EBSRV.GLBDATA.RecVerifyType)
				GOTO RES
			endif
		endif
	endif
	lv_s = " UnvRecCnt | select count(1) from custom.caml "
	lv_s = lv_s + " where bank_id = ?SVAR "
	lv_s = lv_s + " and del_flg <> 'Y' "
	lv_s = lv_s + " and entity_cre_flg in ('X','N') and "
	if (EBSRV.GLBDATA.orgKey !="")then
		lv_s = lv_s + " cif_id =?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.orgKey
	else
		lv_s = lv_s + " id_number =?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.UniqIdNum
	endif
	print(lv_s)
	print(BANCS.INPARAM.BINDVARS)
	lv_r = urhk_dbSelectWithBind(lv_s)
	print(lv_r)
	if ( lv_r == "0") then
		EBSRV.GLBDATA.UnvRecCnt = BANCS.OUTPARAM.UnvRecCnt
		print(EBSRV.GLBDATA.UnvRecCnt)
	endif
	###if (((EBSRV.GLBDATA.ModUnvRecCnt == "0") AND (EBSRV.GLBDATA.UnvRecCnt != "0")) or (EBSRV.GLBDATA.funcCode=="X") ) then
	if (((EBSRV.GLBDATA.ModUnvRecCnt == "0") AND (EBSRV.GLBDATA.UnvRecCnt != "0")) or (EBSRV.GLBDATA.funcCode=="X") or (EBSRV.GLBDATA.funcCode=="D")) then
      lv_s = "cifId,custName,custDob,custConst,custBranch,IdType,IdNumber,backlistCode,lchgUser,backlistEvi,WatchList,WatchListReson,CustCntry|"
                lv_s = lv_s + " select cif_id,cust_name,cust_dob,cust_const,cust_branch,id_type,"
                lv_s = lv_s + " id_number,backlist_code,lchg_user_id,backlist_evidence,free_text1,free_text2,cust_country from custom.caml "
		lv_s = lv_s + " where bank_id=?SVAR and del_flg <> 'Y' and "
		if (EBSRV.GLBDATA.orgKey !="")then
			lv_s = lv_s + " cif_id =?SVAR "	
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.orgKey 
		else
			lv_s = lv_s + " id_number =?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.UniqIdNum
		endif
                print(BANCS.INPARAM.BINDVARS)

                lv_r = urhk_dbSelectWithBind(lv_s)
                print(lv_r)
                if ( lv_r == "0") then
                        EBSRV.GLBDATA.orgKey = BANCS.OUTPARAM.cifId
                        EBSRV.GLBDATA.CustName = BANCS.OUTPARAM.custName
                        EBSRV.GLBDATA.CustDob = BANCS.OUTPARAM.custDob
                        EBSRV.GLBDATA.CustConst = BANCS.OUTPARAM.custConst
                        EBSRV.GLBDATA.CustBranch = BANCS.OUTPARAM.custBranch
                        EBSRV.GLBDATA.IdType = BANCS.OUTPARAM.IdType
                        EBSRV.GLBDATA.IdNumber = BANCS.OUTPARAM.IdNumber
                        EBSRV.GLBDATA.backlistCode = BANCS.OUTPARAM.backlistCode
                        EBSRV.GLBDATA.backlistEvi = BANCS.OUTPARAM.backlistEvi
			EBSRV.GLBDATA.WatchList = BANCS.OUTPARAM.WatchList
			EBSRV.GLBDATA.WatchListReson = BANCS.OUTPARAM.WatchListReson
                        EBSRV.GLBDATA.LchgUser = BANCS.OUTPARAM.lchgUser
                        print(EBSRV.GLBDATA.LchgUser)
			EBSRV.GLBDATA.CustCntry = BANCS.OUTPARAM.CustCntry
                        EBSRV.GLBDATA.RecVerifyType = "MAIN"
                        print(EBSRV.GLBDATA.RecVerifyType)
                        GOTO RES
                else 
			EBSRV.GLBDATA.errMsg = "No Data"
                        GOTO ENDOFSCRIPT
		endif
	endif
RES:
	if(EBSRV.GLBDATA.funcCode == "V") then
		if ( BANCS.STDIN.userId == EBSRV.GLBDATA.LchgUser ) then
			EBSRV.GLBDATA.errMsg = "Same User Cannot Verify"
			GOTO ENDOFSCRIPT
		endif
	endif
ENDOFSCRIPT:
        exitscript
trace off
end-->



