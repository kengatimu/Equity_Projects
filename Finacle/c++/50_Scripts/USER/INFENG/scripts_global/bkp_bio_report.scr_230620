<--START
	# Script body goes here
	TRACE ON
	#--------------------------------------
	#Creating repository and classes
	#--------------------------------------
	
	IF(REPEXISTS("BIO") == 0) THEN
	#{
		CREATEREP("BIO")
	#}
	ENDIF
	
	IF(CLASSEXISTS("BIO", "DATA") == 0) THEN
	#{
		CREATECLASS("BIO", "DATA", 5)
	#}
	ENDIF
	
	IF(REPEXISTS("COMMON") == 0) THEN
	#{
		CREATEREP("COMMON")
		#}
	ELSE
		#{
		DELETEREP("COMMON")
		CREATEREP("COMMON")
	#}
	ENDIF
	
	IF(CLASSEXISTS("COMMON", "INPUT") == 0) THEN
	#{
		CREATECLASS("COMMON", "INPUT", 5)
	#}
	ENDIF
	
	IF(CLASSEXISTS("COMMON", "OUTPUT") == 0) THEN
	#{
		CREATECLASS("COMMON", "OUTPUT", 5)
	#}
	ENDIF
	
	IF(CLASSEXISTS("BANCS", "INPARAM") == 0) THEN
	#{
		CREATECLASS("BANCS", "INPARAM", 5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","INTERFACE") == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	#---------------------------------------------
	#	Variable Initialization
	#---------------------------------------------
	BANCS.OUTPUT.successorFailure="S"
	BIO.DATA.date = MID$(BANCS.STDIN.BODDate,0,10)
	PRINT(BIO.DATA.date)
	CUST.INTERFACE.errorMsgDesc="NA"
	BIO.DATA.intent         = "report"
	BIO.DATA.code		= "ER10"
	#BIO.DATA.date		= "12-04-2019"
	BIO.DATA.branchid	= BANCS.STDIN.mySolId
	#BIO.DATA.branchid="017"
	BIO.DATA.entityid	= BANCS.STDIN.contextBankId
	BIO.DATA.exportFormat	= "pdf"
	#-----------------------------------------------
	#	Initializing the input variables
	#-----------------------------------------------
	
	COMMON.INPUT.srvReqId = "Bio_Report"
	
	CALL("common_business_XMLHeader.scr")
	PRINT(COMMON.OUTPUT.XMLHeader)
	
	BIO.DATA.XMLHeader = COMMON.OUTPUT.XMLHeader
	
	#------------------------------
	#Forming the body xml tags
	#------------------------------
	sv_v = ""
	sv_v = sv_v + "<Body>"
	sv_v = sv_v + "<MSG>"
	sv_v = sv_v + BIO.DATA.intent + "|" + BIO.DATA.code + "|" + BIO.DATA.date + "|"
	sv_v = sv_v + BIO.DATA.branchid + "|" + BIO.DATA.entityid + "|" + BIO.DATA.exportFormat
	sv_v = sv_v + "</MSG>"
	sv_v = sv_v + "</Body>"
	sv_v = sv_v + "</FIXML>"
	
	PRINT(sv_v)
	#------------------------------------------------
	#Appending the Header and Body tag xml
	#------------------------------------------------
	BIO.DATA.XMLBody = sv_v
	sv_s = BIO.DATA.XMLHeader + BIO.DATA.XMLBody
	PRINT(sv_s)
	
	#==============================================================================================================
	#- BANCS.INPARAM.SERVICE_NAME is used as a identifier for fitcpip adapter. So always set this value to FIJCA
	#==============================================================================================================
	BANCS.INPARAM.SERVICE_NAME= "FIJCA"
	#==============================================================================================================
	#- Send_RECV_FLG flag is used to determine the mode of operation. The Possible values can be S or R
	#- S for async communication and R for sync communication
	#==============================================================================================================
	BANCS.INPARAM.SEND_RECV_FLG 	= "R"
	BANCS.INPARAM.IsRespReqd 	= "Y"
	
	#-----------------------------------------------------
	#Sending the request xml to FI service provider class
	#-----------------------------------------------------
	sv_l = urhk_ConnectToFIAndSendMsg(sv_s)
	PRINT(sv_l)
	
	PRINT(BANCS.OUTPARAM.RespMesg)
	PRINT(BANCS.OUTPARAM.ErrMsg)
	
	IF (sv_l != 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.ErrMsg)
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		CUST.INTERFACE.errorMsgCode = "FIERR"
		BANCS.OUTPUT.successorFailure = "E"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF (BANCS.OUTPARAM.ErrMsg != "") THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
		CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		CUST.INTERFACE.errorMsgCode = "FIERR"
		BANCS.OUTPUT.successorFailure = "E"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
		PRINT(CUST.INTERFACE.respXMLMsg)
		CUST.INTERFACE.errorMsgFlg = ""
		CUST.INTERFACE.errorMsgDesc = ""
	#}
	ENDIF
	
	sv_x = CUST.INTERFACE.respXMLMsg
	sv_y = "<Status>"
	sv_z = "</Status>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
	ELSE
		#{
		CUST.INTERFACE.tranStatus = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.tranStatus)
	
	IF (CUST.INTERFACE.tranStatus == "FAILED") THEN
	#{
		BANCS.OUTPUT.successorFailure = "E"
		CUST.INTERFACE.errorMsgDesc="BIO Unverified Enrollments - BIO Error"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------------------------------------
	# If Success fetching tran id else fetching error code and description
	#--------------------------------------------------------------------------------------------------------
	
	sv_u = GETPOSITION(sv_x,"<Body>") + STRLEN("<Body>") - 1
	IF(sv_u != 0) THEN
	#{
		sv_v  = GETPOSITION(sv_x,"</Body>") - 1
		CUST.INTERFACE.responseString = Mid$(sv_x,sv_u,(sv_v-sv_u))
	#}
	ENDIF
	
	sv_i = CUST.INTERFACE.responseString
	sv_l = STRLEN(CUST.INTERFACE.responseString)
	PRINT(sv_i)
	sv_i = Mid$(sv_i,1,sv_l-3)
	PRINT(sv_i)
	sv_i = sv_i + ","
	PRINT(sv_i)
	
	sv_x = 0
	
	WHILE(1)
	#{
		#(
		sv_x = sv_x + 1
		sv_j = GETPOSITION(sv_i,',')
		
		IF(sv_j==0) THEN
		#{
			#(
			sv_m = sv_i
			BANCS.INPUT.tempStr=sv_x
			GOTO LASTFIELD
			#}
		ELSE
			#{
			sv_m = Mid$(sv_i,0,sv_j-1)
			PRINT(sv_m)
			sv_l = STRLEN(sv_i)
			sv_i = Mid$(sv_i,sv_j,sv_l-sv_j)
		#}
		ENDIF
		
		BANCS.INPUT.tempStr=sv_x
		sv_s = GETPOSITION(sv_m,":")
		sv_r = Mid$(sv_m,1,sv_s-3)
		sv_t = STRLEN(sv_m)
		PRINT(sv_r)
		("CUST").("INTERFACE").("bio_"+sv_r) = Mid$(sv_m,sv_s+1,sv_t-2)
		sv_c = Mid$(sv_m,sv_s+1,sv_t-1)
		sv_d = STRLEN(sv_c)
		PRINT(sv_c)
		IF(sv_r == "status")THEN
		#{
			CUST.INTERFACE.statusCode = Mid$(sv_c,0,sv_d-1)
			PRINT(CUST.INTERFACE.statusCode)
		#}
		ENDIF
		
		IF(sv_r == "data")THEN
		#{
			sv_g = GETPOSITION(sv_c, "COUNT")
			CUST.INTERFACE.count = Mid$(sv_c,sv_g+8,sv_d-1)
			PRINT(CUST.INTERFACE.count)
		#}
		ENDIF
		#)
	#}
	DO
	
	#{"status":"000","message":"1 record(s) found","report":{"headers":["COUNT","BRANCH ID"],"data":[{"COUNT":"1","BRANCH_ID":"017"}],"title":"Unverified Enrollments"}}
	
	LASTFIELD:
		
		IF (FIELDEXISTS(CUST.INTERFACE.bio_status)) THEN
		#{
			
			PRINT(CUST.INTERFACE.bio_status)
			sv_l = STRLEN(CUST.INTERFACE.bio_status)
			CUST.INTERFACE.bio_status = Mid$(CUST.INTERFACE.bio_status,0,sv_l-1)
			PRINT(CUST.INTERFACE.bio_status)
			
			IF(CUST.INTERFACE.bio_status == "000")THEN
			#{
				
				IF (FIELDEXISTS(CUST.INTERFACE.bio_message)) THEN
				#{
					PRINT(CUST.INTERFACE.bio_message)
					sv_l = STRLEN(CUST.INTERFACE.bio_message)
					CUST.INTERFACE.bio_message = Mid$(CUST.INTERFACE.bio_message,0,sv_l-1)
					PRINT(CUST.INTERFACE.bio_message)
					IF(MID$(CUST.INTERFACE.bio_message,0,1) != "0")THEN
					#{
						BANCS.OUTPUT.successorFailure="F"
						CUST.INTERFACE.errorMsgDesc="Unverified Enrollments exists for Branch "+BIO.DATA.branchid +": "
						CUST.INTERFACE.bio_message=CUST.INTERFACE.errorMsgDesc+CUST.INTERFACE.bio_message
						PRINT(CUST.INTERFACE.bio_message)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		
		
	ENDOFSCRIPT:
		PRINT(BANCS.OUTPUT.successorFailure)
		PRINT(CUST.INTERFACE.errorMsgDesc)
		EXITSCRIPT
		
		TRACE OFF
END-->
