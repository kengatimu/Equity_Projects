#----------------------------------------------------------------------------------------------------------
# Filename              :       CustInfo_main.scr
# Description           :       This is the main script that gets triggered when CustInfo is called
# Input                 :       Request XML
# Output                :       Response XML
# Called Script         :       None
# Calling Script        :       Common_CreateRepos.scr, CustInfo_FetchInputDetails.scr, 
#				CustInfo_ValidateInputDetails.scr,
#				CustInfo_SendResponse.scr,Common_ErrorExit.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           12-08-2013      	   Anik Soni         Original Version         1.0
#-----------------------------------------------------------------------------------------------------------
<--start
#trace on

	#sv_l = urhk_B2k_printrepos("BANCS")
#	print(sv_l)

	#-------------------------------------------------------------------------------
	# Calling create repository script
	#-------------------------------------------------------------------------------
	CALL("Common_Interface_CreateRepos.scr")
	CUST.INTERFACE.successOrFailure = "S"
	CUST.INTERFACE.srvErrFlg = "N"
	CUST.INTERFACE.errorCode = ""
	
	#-------------------------------------------------------------------------------
	# Getting Channel Information
	#-------------------------------------------------------------------------------
	
	lv_a = urhk_GetChannelInfo("")
	IF (FIELDEXISTS(BANCS.OUTPARAM.DccId)) THEN
	#{
	        CUST.INTERFACE.ChannelId = BANCS.OUTPARAM.DccId
	        print(CUST.INTERFACE.ChannelId)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	# Defaulting some Input variables for the Interface
	#-------------------------------------------------------------------------------
	
	CUST.INTERFACE.ErrorFlg = "N"
	CUST.INTERFACE.solId = ""
	CUST.INTERFACE.BODDate = ""
	CUST.INTERFACE.errorDesc = ""	
	#-------------------------------------------------------------------------------
	# Fetching Input Fields from FI
	#-------------------------------------------------------------------------------
	CALL("CustInfo_FetchInputDetails.scr")
	
	#-------------------------------------------------------------------------------
	# Validating Input Fields
	#-------------------------------------------------------------------------------
	CALL("CustInfo_ValidateInputDetails.scr")
		
	#-------------------------------------------------------------------------------
	# Posting the Cheque details
	#-------------------------------------------------------------------------------
	CALL("CustInfo_FetchCustDetails.scr")
	
	
	#-------------------------------------------------------------------------------
	# Send Response
	#-------------------------------------------------------------------------------
	
	FINISH:
	
	CALL("CustInfo_SendResponse.scr")
	
	SKIPFINISH:
	IF(CUST.INTERFACE.successOrFailure == "E") THEN
	#{
	        sv_c = CUST.INTERFACE.errorCode + "|" + CUST.INTERFACE.errorDesc	
		sv_u = urhk_SetOrbWarning(sv_c)
	#}
	ENDIF

trace off
end-->
