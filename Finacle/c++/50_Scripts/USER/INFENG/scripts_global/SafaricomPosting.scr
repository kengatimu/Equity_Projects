				sv_l=sv_b-sv_c - 4
				print(sv_l)
				sv_k =right$(CUST.INTERFACE.respXMLMsg,sv_l)
				print(sv_k)
				CUST.UBP.errorMsg=sv_k
				
				#========================================================
				#impliment script to save the details to db to retry posting late - CUBP entry is made refer that
				#=========================================================
				
				#}
			ELSE
				#{
				# {
				CUST.INTERFACE.errorMsgFlg="N"
			#}
			ENDIF
			
			#}
