		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u==0)then
			CUST.INTERFACE.dtdCnt = BANCS.OUTPARAM.dtdCnt
			print(CUST.INTERFACE.dtdCnt)
			IF (CINT(CUST.INTERFACE.dtdCnt)>0 ) THEN
				print("ok proceed")
			ELSE
			################ force post start
				IF ((FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1)  AND (FIELDEXISTS(BANCS.OUTPARAM.tranDate) == 1)) THEN
					print(BANCS.OUTPARAM.tranId)
					print(BANCS.OUTPARAM.tranDate)
					sv_u = urhk_CopyOutToIn("")
					print(sv_u)
					sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
					sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")

					IF(CUST.UBP.srvcallmode == "E")THEN
					#{
						sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
						print(sv_u)
					#}
					ELSE
					#{
						sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
						print(sv_u)

						IF(sv_u != 0)THEN
						#{
							sv_u = urhk_CopyOutToIn("")
							print(sv_u)

							sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
							sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")

							sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
							print(sv_u)
						#}
						ENDIF
					#}
					ENDIF
					##### check again start
					sv_s = "dtdCnt | select count(*) from tbaadm.dtd where tran_id = lpad(?SVAR,9,' ') "
					sv_s = sv_s + " and bank_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR') and pstd_flg='Y' "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.INTERFACE.PAymentRefNumber + "|" + BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.TranDate
					print(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbSelectWithBind(sv_s)
					if(sv_u==0)then
						CUST.INTERFACE.dtdCnt = BANCS.OUTPARAM.dtdCnt
						print(CUST.INTERFACE.dtdCnt)
						IF (CINT(CUST.INTERFACE.dtdCnt)>0 ) THEN
							print("ok proceed")
						ELSE
						     CUST.UBP.srvSuccess="N"
						     CUST.INTERFACE.errorMsgFlg="N"
						     BANCS.OUTPARAM.ErrMsg="Transaction not posted contact IT"
						     print(BANCS.OUTPARAM.ErrMsg)
						     BANCS.OUTPARAM.ErrMsg="Transaction not posted contact IT"
						     print(BANCS.OUTPARAM.ErrMsg)
						     CUST.UBP.errorMsg =BANCS.OUTPARAM.ErrMsg
						     print(CUST.UBP.errorMsg)
						     CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
						     print(CUST.INTERFACE.errorMsgDesc)
						     GOTO ENDOFSCRIPT
						ENDIF
					endif
					##### check again end
				ELSE
					##### check again start once
					sv_s = "dtdCnt | select count(*) from tbaadm.dtd where tran_id = lpad(?SVAR,9,' ') "
					sv_s = sv_s + " and bank_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR') and pstd_flg='Y' "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.INTERFACE.PAymentRefNumber + "|" + BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.TranDate
					print(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbSelectWithBind(sv_s)
					if(sv_u==0)then
						CUST.INTERFACE.dtdCnt = BANCS.OUTPARAM.dtdCnt
						print(CUST.INTERFACE.dtdCnt)
						IF (CINT(CUST.INTERFACE.dtdCnt)>0 ) THEN
							print("ok proceed")
						ELSE
						     CUST.UBP.srvSuccess="N"
						     CUST.INTERFACE.errorMsgFlg="N"
						     BANCS.OUTPARAM.ErrMsg="Transaction not posted contact IT"
						     print(BANCS.OUTPARAM.ErrMsg)
						     BANCS.OUTPARAM.ErrMsg="Transaction not posted contact IT"
						     print(BANCS.OUTPARAM.ErrMsg)
						     CUST.UBP.errorMsg =BANCS.OUTPARAM.ErrMsg
						     print(CUST.UBP.errorMsg)
						     CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
						     print(CUST.INTERFACE.errorMsgDesc)
						     GOTO ENDOFSCRIPT
						ENDIF
					endif
					##### check again end once
				ENDIF
			################ force post end
			ENDIF
		else
		     CUST.UBP.srvSuccess="N"
		     CUST.INTERFACE.errorMsgFlg="N"
		     BANCS.OUTPARAM.ErrMsg="Transaction not posted contact IT"
		     print(BANCS.OUTPARAM.ErrMsg)
		     BANCS.OUTPARAM.ErrMsg="Transaction not posted contact IT"
		     print(BANCS.OUTPARAM.ErrMsg)
