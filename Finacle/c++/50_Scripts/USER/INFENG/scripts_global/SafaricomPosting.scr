			sv_k =left$(CUST.INTERFACE.respXMLMsg,2)
			print(sv_k)
			
			#check to see if the posting went thru
			
			
			IF (sv_k==99) THEN
			#{
				#for testing set errorMsgFlg="N"
				
				CUST.INTERFACE.errorMsgFlg="N"
				sv_c=strlen(CUST.UBP.billRefNum)
				print(sv_c)
				sv_b=strlen(CUST.INTERFACE.respXMLMsg)
