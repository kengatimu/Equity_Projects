	CUST.INTERFACE.DealerCode=CUST.UBP.billRefNum
	print(CUST.INTERFACE.DealerCode)
	CUST.INTERFACE.Amount=CUST.UBP.billAmt
	print(CUST.INTERFACE.Amount)
	CUST.INTERFACE.DealerAcctNumber=CUST.UBP.billAcctId
	print(CUST.INTERFACE.DealerAcctNumber)
