	sv_b=sv_b +"</dealer>"
	sv_b=sv_b +"</ws:finRequest>"
	sv_b=sv_b +"</soapenv:Body>"
	sv_b=sv_b +"</soapenv:Envelope>"
	
	if((CUST.INTERFACE.PAymentRefNumber!="") and (CUST.INTERFACE.TranDate!=""))then
		sv_s = "dtdCnt | select count(*) from tbaadm.dtd where tran_id = lpad(?SVAR,9,' ') "
