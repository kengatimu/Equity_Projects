	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	
	
	
	sv_b="<soapenv:Envelope xmlns:soapenv='http://schemas.xmlsoap.org/soap/envelope/' xmlns:ws='http://ws.equitybank/'>"
	sv_b=sv_b +"<soapenv:Header/>"
	sv_b=sv_b +"<soapenv:Body>"
	sv_b=sv_b +"<ws:finRequest>"
