		sv_a = CUST.INTERFACE.reqXMLMsg
		PRINT(sv_a)
		PRINT("before urhk")
		sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
		print("after urhk")
		print(sv_l)
		
		
		IF (sv_l==0) THEN
		#{
			
			#CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
			CUST.INTERFACE.respXMLMsg = "00:D-T027:Transaction posted Successful!"
			
			##  The response Returned is in format.. ResponseCode|Dealer Code | Dealer Name
			##  ResponseCode of 00 means its OK to Proceed
