	CUST.DATA.COUNTRY=BANCS.INPUT.COUNTRY
	print(CUST.DATA.COUNTRY)

 	IF( (FIELDEXISTS(("BANCS").("INPUT").("TYPE"))== 0) ) THEN
	#{
