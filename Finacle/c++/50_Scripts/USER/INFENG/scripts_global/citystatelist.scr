      	print("executing the list query")

   	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+CUST.DATA.TYPE
   	sv_k=" Code,NAME |SELECT c.value, l.localetext FROM CRMUSER.CATEGORIES c, CRMUSER.CATEGORY_LANG l "
   	sv_k= sv_k + " WHERE c.bank_id=?SVAR and c.categorytype=?SVAR and l.categoryid=c.categoryid and l.bank_id=c.bank_id "  
    	sv_r = urhk_dbCursorOpenWithBind(sv_k)
     	print(sv_r)

	IF(sv_r==0) THEN
	#{
       	 	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_m)
        	sv_q = urhk_dbCursorFetch(sv_m)
        	print(sv_q)

        	IF(sv_q != 0) THEN
        	#{
               	 	sv_x = urhk_dbCursorClose(sv_m)
                	print(sv_x)
                	exitscript
        	#}
        	ENDIF
		
		sv_s=0
		sv_c =1
		WHILE(sv_q == 0)
		#{
        		sv_j = sv_c 
        		CUST.DATA.OPLoop = CUST.DATA.TYPE+"_"	+ format$(sv_j,"%d") + "."
        		CUST.DATA.Code = BANCS.OUTPARAM.Code
	    		print(CUST.DATA.Code)
        		CUST.DATA.NAME = BANCS.OUTPARAM.NAME
      
         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"CODE|" +CUST.DATA.Code)
         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"NAME|" +CUST.DATA.NAME)
		 
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			print(sv_j)
			sv_c=sv_c+1
		 #}
		 DO
		 sv_x = urhk_dbCursorClose(sv_m)

        	print(sv_x)
	
	#}
	ENDIF

	if(sv_r=="1")then
	#{
		lv_b = urhk_SetOrbOut("Message|Record is Not Present")
		GOTO ENDOFSCRIPT
	#}
	endif

	SUBCOUNTY:

	print("subcounty or towns list")

   	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
   	sv_k=" Code,NAME |SELECT c.value, l.localetext FROM CRMUSER.CATEGORIES c, CRMUSER.CATEGORY_LANG l "
   	sv_k= sv_k + " WHERE c.bank_id=?SVAR and c.categorytype='CITY' and l.categoryid=c.categoryid and l.bank_id=c.bank_id"  
   	sv_k= sv_k+ " and NOT REGEXP_LIKE(c.value, '^-?[0-9]+(\.[0-9]+)?$')"
   	sv_r = urhk_dbCursorOpenWithBind(sv_k)
     	print(sv_r)

	IF(sv_r==0) THEN
	#{
        	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_m)
        	sv_q = urhk_dbCursorFetch(sv_m)
        	print(sv_q)

        	IF(sv_q != 0) THEN
        	#{
               	 	sv_x = urhk_dbCursorClose(sv_m)
                	print(sv_x)
                	GOTO CITY2
        	#}
        	ENDIF
		
		sv_s=0
		sv_c =1
		WHILE(sv_q == 0)
		#{
        		sv_j = sv_c 
        		CUST.DATA.OPLoop = CUST.DATA.TYPE+"_"	+ format$(sv_j,"%d") + "."
        		CUST.DATA.Code = BANCS.OUTPARAM.Code
	    		print(CUST.DATA.Code)
        		CUST.DATA.NAME = BANCS.OUTPARAM.NAME
      
         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"CODE|" +CUST.DATA.Code)
         		lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"NAME|" +CUST.DATA.NAME)
		 
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			print(sv_j)
			sv_c=sv_c+1
		 #}
		 DO

		sv_x = urhk_dbCursorClose(sv_m)
        	print(sv_x)

	#}
	ENDIF

	if(sv_r=="1")then
	#{
		lv_b = urhk_SetOrbOut("Message|Record is Not Present")
		GOTO ENDOFSCRIPT
	#}
	endif

	CITY2:
	lv_b = urhk_SetOrbOut("Message|No Data found")

ENDOFSCRIPT:
exitscript
