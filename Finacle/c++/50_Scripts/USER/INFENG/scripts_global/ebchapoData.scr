<--start
trace on
#Rep
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	if(fieldexists(EQSRV.GLBDATA.NatIdNum)==1)then
		print(EQSRV.GLBDATA.NatIdNum)
	endif
	EQSRV.GLBDATA.AcctName = ""
	EQSRV.GLBDATA.AddrLine1 = ""
	EQSRV.GLBDATA.AddrLine2 = ""
