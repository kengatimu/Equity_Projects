	EQSRV.GLBDATA.SubSegment = ""
	EQSRV.GLBDATA.TaxDeductionTable = ""
	EQSRV.GLBDATA.TertiaryRMId = ""
	EQSRV.GLBDATA.EmploymentStatus = ""
	EQSRV.GLBDATA.MaritalStatus = ""
	EQSRV.GLBDATA.Nationality = ""
	EQSRV.GLBDATA.IDCntyIssue = ""
	EQSRV.GLBDATA.IDDocCode = ""
	EQSRV.GLBDATA.IDDocDesc = ""
	EQSRV.GLBDATA.IDIssueDate = ""
	EQSRV.GLBDATA.IDTypeCode = ""
	EQSRV.GLBDATA.IDTypeDesc = ""
	EQSRV.GLBDATA.IDPlaceOfIssue = ""
	EQSRV.GLBDATA.IDRefNum = ""
	EQSRV.GLBDATA.IDIssueOrg = ""
	EQSRV.GLBDATA.CrncyCode = ""
	sv_d = "ipFirstName,ipLastName,ipMiddleName,ipDob,ipGender,ipNationality,ipOccup,ipNatIdNum,ipIdType,ipIdIssuDate,ipIdIssuLoc,ipIdIssueAuth,obMobileNum,obAdder1,obAdder2,obMailId,obCrncyCode,obKraPin,obBranch,obRecUser | "
	sv_d = sv_d + " select iprst.first_name,iprst.last_name,iprst.middle_name,iprst.date_of_birth,iprst.gender_code, "
	sv_d = sv_d + " iprst.nationality,iprst.occupation,iprst.nat_id_num,iprst.id_type, "
	sv_d = sv_d + " iprst.id_issue_date,iprst.id_issue_location,iprst.id_issue_authority, "
	sv_d = sv_d + " obmt.mobile_number,obmt.address_line1,obmt.address_line2,obmt.mail_id, "
	sv_d = sv_d + " obmt.currency_code,obmt.karpin_code,obmt.free_text1,obmt.rcre_user_id "
	sv_d = sv_d + " from custom.obmt,custom.iprst "
	sv_d = sv_d + " where obmt.bank_id=?SVAR "
	sv_d = sv_d + " and iprst.bank_id=?SVAR "
	sv_d = sv_d + " and obmt.national_id=iprst.reg_nat_idnum "
	sv_d = sv_d + " and module_id='CU-HAPO' "
	sv_d = sv_d + " and obmt.national_id=?SVAR "
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.NatIdNum
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.ipFirstName = BANCS.OUTPARAM.ipFirstName
		EQSRV.GLBDATA.ipLastName = BANCS.OUTPARAM.ipLastName
		EQSRV.GLBDATA.ipMiddleName = BANCS.OUTPARAM.ipMiddleName
		EQSRV.GLBDATA.ipDob = BANCS.OUTPARAM.ipDob
		EQSRV.GLBDATA.ipGender = BANCS.OUTPARAM.ipGender
		EQSRV.GLBDATA.ipNationality = BANCS.OUTPARAM.ipNationality
		EQSRV.GLBDATA.ipOccup = BANCS.OUTPARAM.ipOccup
		EQSRV.GLBDATA.ipNatIdNum = BANCS.OUTPARAM.ipNatIdNum
		EQSRV.GLBDATA.ipIdType = BANCS.OUTPARAM.ipIdType
		EQSRV.GLBDATA.ipIdIssuDate = BANCS.OUTPARAM.ipIdIssuDate
		EQSRV.GLBDATA.ipIdIssuLoc = BANCS.OUTPARAM.ipIdIssuLoc
		EQSRV.GLBDATA.ipIdIssueAuth = BANCS.OUTPARAM.ipIdIssueAuth
		EQSRV.GLBDATA.obMobileNum = BANCS.OUTPARAM.obMobileNum
		EQSRV.GLBDATA.obAdder1 = BANCS.OUTPARAM.obAdder1
		EQSRV.GLBDATA.obAdder2 = BANCS.OUTPARAM.obAdder2
		EQSRV.GLBDATA.obMailId = BANCS.OUTPARAM.obMailId
		EQSRV.GLBDATA.obCrncyCode = BANCS.OUTPARAM.obCrncyCode
		EQSRV.GLBDATA.obKraPin = BANCS.OUTPARAM.obKraPin
		EQSRV.GLBDATA.obBranch = BANCS.OUTPARAM.obBranch
		EQSRV.GLBDATA.obRecUser = BANCS.OUTPARAM.obRecUser
	else
                EQSRV.GLBDATA.ipFirstName = "" 
                EQSRV.GLBDATA.ipLastName = "" 
                EQSRV.GLBDATA.ipMiddleName = "" 
		EQSRV.GLBDATA.ipDob = "" 
                EQSRV.GLBDATA.ipGender = "" 
                EQSRV.GLBDATA.ipNationality = "" 
                EQSRV.GLBDATA.ipOccup = "" 
                EQSRV.GLBDATA.ipNatIdNum = "" 
                EQSRV.GLBDATA.ipIdType = "" 
                EQSRV.GLBDATA.ipIdIssuDate = "" 
                EQSRV.GLBDATA.ipIdIssuLoc = "" 
                EQSRV.GLBDATA.ipIdIssueAuth = "" 
                EQSRV.GLBDATA.obMobileNum = "" 
                EQSRV.GLBDATA.obAdder1 = "" 
                EQSRV.GLBDATA.obAdder2 = "" 
                EQSRV.GLBDATA.obMailId = "" 
                EQSRV.GLBDATA.obCrncyCode = "" 
                EQSRV.GLBDATA.obKraPin = "" 
		EQSRV.GLBDATA.obBranch = "" 
		EQSRV.GLBDATA.obRecUser = "" 
	endif
	EQSRV.GLBDATA.startdate = MID$(BANCS.STDIN.BODDate,0,10)
	EQSRV.GLBDATA.TStmp ="T00:00:00.000"
	EQSRV.GLBDATA.sign ="-"
	print(mid$(BANCS.STDIN.BODDate,0,2))
	print(mid$(BANCS.STDIN.BODDate,3,2))
	print(mid$(BANCS.STDIN.BODDate,6,4))
	EQSRV.GLBDATA.dtDay = mid$(BANCS.STDIN.BODDate,0,2)
	EQSRV.GLBDATA.dtMon = mid$(BANCS.STDIN.BODDate,3,2)
	EQSRV.GLBDATA.dtY = mid$(BANCS.STDIN.BODDate,6,4)
	EQSRV.GLBDATA.toDay = EQSRV.GLBDATA.dtY + EQSRV.GLBDATA.sign + EQSRV.GLBDATA.dtMon + EQSRV.GLBDATA.sign + EQSRV.GLBDATA.dtDay + EQSRV.GLBDATA.TStmp 
	print(EQSRV.GLBDATA.toDay)
	print(mid$(EQSRV.GLBDATA.ipDob,0,4))
	print(mid$(EQSRV.GLBDATA.ipDob,5,2))
	print(mid$(EQSRV.GLBDATA.ipDob,8,2))
	EQSRV.GLBDATA.dobY = mid$(EQSRV.GLBDATA.ipDob,0,4)
	EQSRV.GLBDATA.dobM = mid$(EQSRV.GLBDATA.ipDob,5,2)
	EQSRV.GLBDATA.dobD = mid$(EQSRV.GLBDATA.ipDob,8,2)
	EQSRV.GLBDATA.dobTst = EQSRV.GLBDATA.dobY + EQSRV.GLBDATA.sign + EQSRV.GLBDATA.dobM + EQSRV.GLBDATA.sign + EQSRV.GLBDATA.dobD + EQSRV.GLBDATA.TStmp 
	print(mid$(EQSRV.GLBDATA.ipIdIssuDate,0,4))
	print(mid$(EQSRV.GLBDATA.ipIdIssuDate,5,2))
	print(mid$(EQSRV.GLBDATA.ipIdIssuDate,8,2))
	EQSRV.GLBDATA.didY = mid$(EQSRV.GLBDATA.ipIdIssuDate,0,4)
	EQSRV.GLBDATA.didM = mid$(EQSRV.GLBDATA.ipIdIssuDate,5,2)
	EQSRV.GLBDATA.didD = mid$(EQSRV.GLBDATA.ipIdIssuDate,8,2)
	EQSRV.GLBDATA.didTst = EQSRV.GLBDATA.didY + EQSRV.GLBDATA.sign + EQSRV.GLBDATA.didM + EQSRV.GLBDATA.sign + EQSRV.GLBDATA.didD + EQSRV.GLBDATA.TStmp 
	if(EQSRV.GLBDATA.ipFirstName!="")then
		EQSRV.GLBDATA.AcctName = EQSRV.GLBDATA.ipFirstName 
	else
		EQSRV.GLBDATA.AcctName = ""
	endif
	if(EQSRV.GLBDATA.obAdder1!="")then
		EQSRV.GLBDATA.AddrLine1 = EQSRV.GLBDATA.obAdder1 
	else
		EQSRV.GLBDATA.AddrLine1 = ""
	endif
	if(EQSRV.GLBDATA.obAdder2!="")then
		EQSRV.GLBDATA.AddrLine2 = EQSRV.GLBDATA.obAdder2 
	else
		EQSRV.GLBDATA.AddrLine2 = ""
	endif
	EQSRV.GLBDATA.AddrLine3 = ""
	EQSRV.GLBDATA.City = "223"
	EQSRV.GLBDATA.Country = "KE"
	EQSRV.GLBDATA.FreeTextLabel = "Email address"
	EQSRV.GLBDATA.StartDt = EQSRV.GLBDATA.toDay 
	EQSRV.GLBDATA.State = "KEN"
	EQSRV.GLBDATA.PostalCode = "30200"
	if(EQSRV.GLBDATA.dobD!="")then
		EQSRV.GLBDATA.BirthDt = EQSRV.GLBDATA.dobD 
	else
		EQSRV.GLBDATA.BirthDt = ""
	endif
	if(EQSRV.GLBDATA.dobM!="")then
		EQSRV.GLBDATA.BirthMonth = EQSRV.GLBDATA.dobM 
	else
		EQSRV.GLBDATA.BirthMonth = ""
	endif
	if(EQSRV.GLBDATA.dobY!="")then
		EQSRV.GLBDATA.BirthYear = EQSRV.GLBDATA.dobY 
	else
		EQSRV.GLBDATA.BirthYear = ""
	endif
	if(EQSRV.GLBDATA.dobTst!="")then
		EQSRV.GLBDATA.DateOfBirth = EQSRV.GLBDATA.dobTst 
	else
		EQSRV.GLBDATA.DateOfBirth = ""
	endif
	if(EQSRV.GLBDATA.ipLastName!="")then
		EQSRV.GLBDATA.LastName = EQSRV.GLBDATA.ipLastName 
	else
		EQSRV.GLBDATA.LastName = ""
	endif
	if(EQSRV.GLBDATA.ipFirstName!="")then
		EQSRV.GLBDATA.FirstName = EQSRV.GLBDATA.ipFirstName 
	else
		EQSRV.GLBDATA.FirstName = ""
	endif
	EQSRV.GLBDATA.IsMinor = "N"
	EQSRV.GLBDATA.IsCustNRE = "N"
	if(EQSRV.GLBDATA.ipGender!="")then
		EQSRV.GLBDATA.Gender = EQSRV.GLBDATA.ipGender 
	else
		EQSRV.GLBDATA.Gender = ""
	endif
	if(EQSRV.GLBDATA.obRecUser!="")then
		EQSRV.GLBDATA.Manager = EQSRV.GLBDATA.obRecUser 
	else
		EQSRV.GLBDATA.Manager = ""
	endif
	if(EQSRV.GLBDATA.ipOccup!="")then
		##EQSRV.GLBDATA.Occupation = EQSRV.GLBDATA.ipOccup 
		EQSRV.GLBDATA.Occupation = "FARM" 
	else
		EQSRV.GLBDATA.Occupation = ""
	endif
	EQSRV.GLBDATA.PhoneEmailType = "CELLPH"
	EQSRV.GLBDATA.PhoneCityCode = ""
	EQSRV.GLBDATA.PhoneCountryCode = "254"
	if(EQSRV.GLBDATA.obMobileNum!="")then
		print(mid$(EQSRV.GLBDATA.obMobileNum,1,3))
		print(mid$(EQSRV.GLBDATA.obMobileNum,4,6))
		EQSRV.GLBDATA.PhoneCityCode = mid$(EQSRV.GLBDATA.obMobileNum,1,3)
		EQSRV.GLBDATA.PhoneLocalCode = mid$(EQSRV.GLBDATA.obMobileNum,4,6) 
	else
		EQSRV.GLBDATA.PhoneLocalCode = ""
		EQSRV.GLBDATA.PhoneCityCode = "" 
	endif
	if(EQSRV.GLBDATA.FirstName!="")then
		EQSRV.GLBDATA.PrefName = EQSRV.GLBDATA.FirstName 
	else
		EQSRV.GLBDATA.PrefName = ""
	endif
	if(EQSRV.GLBDATA.obBranch!="")then
		EQSRV.GLBDATA.PrimarySolId = EQSRV.GLBDATA.obBranch 
	else
		EQSRV.GLBDATA.PrimarySolId = ""
	endif
	EQSRV.GLBDATA.Region = "001"
	if(EQSRV.GLBDATA.toDay!="")then
		EQSRV.GLBDATA.RelationshipOpeningDt = EQSRV.GLBDATA.toDay 
	else
		EQSRV.GLBDATA.RelationshipOpeningDt = ""
	endif
	EQSRV.GLBDATA.Salutation = "MR"
	EQSRV.GLBDATA.SegmentationClass = "MICRO"
	if(EQSRV.GLBDATA.FirstName!="")then
		EQSRV.GLBDATA.ShortName = mid$(EQSRV.GLBDATA.FirstName,0,9) 
	else
		EQSRV.GLBDATA.ShortName = ""
	endif
	EQSRV.GLBDATA.StaffFlag = "N"
	EQSRV.GLBDATA.SubSegment = "MICRB"
	EQSRV.GLBDATA.TaxDeductionTable = "ZERO"
	if(EQSRV.GLBDATA.obRecUser!="")then
		EQSRV.GLBDATA.TertiaryRMId = EQSRV.GLBDATA.obRecUser 
	else
		EQSRV.GLBDATA.obRecUser = ""
	endif
	EQSRV.GLBDATA.EmploymentStatus = "Salaried"
	EQSRV.GLBDATA.MaritalStatus = "001"
	EQSRV.GLBDATA.Nationality = "KE"
	EQSRV.GLBDATA.IDCntyIssue = "KE"
	EQSRV.GLBDATA.IDDocCode = "DOC03"
	EQSRV.GLBDATA.IDDocDesc = "NATIONAL I.D"
	if(EQSRV.GLBDATA.didTst!="")then
		EQSRV.GLBDATA.IDIssueDate = EQSRV.GLBDATA.didTst 
	else
		EQSRV.GLBDATA.IDIssueDate = ""
	endif
	EQSRV.GLBDATA.IDTypeCode = "INDIV"
	EQSRV.GLBDATA.IDTypeDesc = "IDENTIFICATION PROOF FOR INDIVIDUALS"
	EQSRV.GLBDATA.IDPlaceOfIssue = "223"
	if(EQSRV.GLBDATA.ipNatIdNum!="")then
		##EQSRV.GLBDATA.IDRefNum = EQSRV.GLBDATA.ipNatIdNum 
		EQSRV.GLBDATA.IDRefNum = EQSRV.GLBDATA.NatIdNum 
	else
		EQSRV.GLBDATA.IDRefNum = ""
	endif
	EQSRV.GLBDATA.IDIssueOrg = "001"
	if(EQSRV.GLBDATA.obCrncyCode!="")then
		EQSRV.GLBDATA.CrncyCode = EQSRV.GLBDATA.obCrncyCode 
	else
		EQSRV.GLBDATA.CrncyCode = ""
	endif
	if((EQSRV.GLBDATA.AcctName!="")and(EQSRV.GLBDATA.AddrLine1!="")and(EQSRV.GLBDATA.AddrLine2!="")and(EQSRV.GLBDATA.DateOfBirth!="") and (EQSRV.GLBDATA.LastName!="") and (EQSRV.GLBDATA.FirstName!="") and (EQSRV.GLBDATA.Gender!="") and (EQSRV.GLBDATA.Manager!="")and(EQSRV.GLBDATA.Occupation!="") and (EQSRV.GLBDATA.PhoneLocalCode!="") and (EQSRV.GLBDATA.PrimarySolId!="")and(EQSRV.GLBDATA.TertiaryRMId!="")and(EQSRV.GLBDATA.IDIssueDate!="")and(EQSRV.GLBDATA.IDRefNum!="")and(EQSRV.GLBDATA.CrncyCode!=""))then
		EQSRV.GLBDATA.isCifYN = "Y"
	else
		EQSRV.GLBDATA.isCifYN = "N"
	endif
##trace off 
end-->
