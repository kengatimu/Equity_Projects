<--START
CHECKSUM="39ebc81da56cca4a73f81f4b55077596b84835b72c8190b4f0b37f5317261406"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	    sv_r = CLASSEXISTS("CUST","INTERFACE")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","INTERFACE",5)
        #}
        ENDIF
		
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.acctNum = " "
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.acctNumEntityId = " "
	CUST.CIETXN.acctNumSolId = " "
	CUST.CIETXN.acctNumCcy = " "
	CUST.CIETXN.acctName = " "
	CUST.CIETXN.entityCreFlg = " "
	CUST.CIETXN.acctClsFlg = " "
	CUST.CIETXN.schmType = " "
	CUST.CIETXN.cifIdForSig = " "
	CUST.CIETXN.txnType=" "	
	

	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
		#{
			CUST.CIETXN.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
			print(CUST.CIETXN.acctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
		IF(FIELDEXISTS(BANCS.INPUT.targetEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.targetEntity) != "")THEN
		#{
			CUST.CIETXN.targetEntity = TOUPPER(TRIM(BANCS.INPUT.targetEntity))
			print(CUST.CIETXN.targetEntity)
			IF(CUST.CIETXN.targetEntity =="NA")THEN
			#{
				CUST.CIETXN.targetEntity=BANCS.STDIN.contextBankId	
			#}
			ENDIF			
		#}
		ELSE
		#{
			CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Select Entity Id before entering Account ID"
		GOTO ENDOFSCRIPT

		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Select Entity Id before entering Account ID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF(FIELDEXISTS(BANCS.INPUT.txnType))THEN
	#{
		CUST.CIETXN.txnType=BANCS.INPUT.txnType
		PRINT(CUST.CIETXN.txnType)
	#}
	ENDIF
	CUST.INTERFACE.bankID=CUST.CIETXN.targetEntity	
		CALL("getBoxType.scr")
	
	PRINT(CUST.CIETXN.boxType)
	PRINT(CUST.CIETXN.errorFlg)
	PRINT(CUST.CIETXN.errorMsg)
	
		IF((CUST.CIETXN.errorFlg == "N") AND (CUST.CIETXN.boxType == "I")) THEN
	#{
		CALL("getEndPoint.scr")
		
		
		IF (CUST.CIETXN.errorFlg!="Y") THEN
		#{
			CUST.INTERFACE.endPointUrl = CUST.CIETXN.endPointUrl
			CUST.INTERFACE.callScript="cietxndp111.scr"
			CUST.INTERFACE.inputData = CUST.CIETXN.acctNum

			CALL("cietxndp111_fi.scr")
		IF(CUST.CIETXN.errorFlg == "Y")THEN
#{
GOTO ENDOFSCRIPT
#}
ENDIF	
			#}
		ELSE
			#{
			PRINT("END POINT URL not fetched")
			
		#}
		ENDIF
		PRINT(CUST.INTERFACE.endPointUrl)
		#}
	ELSE
		#{
		CALL("cietxndp111.scr")
	#}
	ENDIF
	
	
		IF(CUST.CIETXN.acctNumEntityId== BANCS.STDIN.contextBankId)THEN
		#{
			IF(CUST.CIETXN.txnType != "TF")THEN
			#{  
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Same Entity Account Not Allowed"
			GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		IF(CUST.CIETXN.acctNumEntityId != CUST.CIETXN.targetEntity)THEN
		#{
			
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Account does not belong to Target Entity"
			GOTO ENDOFSCRIPT
			
		#}
		ENDIF

	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumEntityId|"+CUST.CIETXN.acctNumEntityId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumSolId|"+CUST.CIETXN.acctNumSolId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumCcy|"+CUST.CIETXN.acctNumCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctName|"+CUST.CIETXN.acctName)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNum|"+CUST.CIETXN.acctNum)
		print(sv_u)
		
		IF(CUST.CIETXN.cifIdForSig != "")THEN
		#{
			sv_u = urhk_SetOrbOut("cifIdForSig|"+CUST.CIETXN.cifIdForSig)
			print(sv_u)
		#}
		ENDIF
		
