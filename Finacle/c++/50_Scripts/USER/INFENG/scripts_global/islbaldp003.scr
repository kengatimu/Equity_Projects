	#---------------------------------------------------------------
	# Depending on the differenet in Dr and Cr amount the drAcctId
	# and crAcctId is assigned accordingly
	#---------------------------------------------------------------
	CUST.ISLAMIC.diffAmt = CDOUBLE(CUST.ISLAMIC.totalDrAmtForIslamic) - CDOUBLE(CUST.ISLAMIC.totalCrAmtForIslamic)
	PRINT(CUST.ISLAMIC.diffAmt)
	
