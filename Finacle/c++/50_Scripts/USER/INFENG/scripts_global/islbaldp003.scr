	BANCS.INPARAM.BINDVARS = CUST.ISLAMIC.solId + "|" + CUST.ISLAMIC.crncyCode + "|D"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|Y|I"
