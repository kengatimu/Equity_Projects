#----------------------------------------------------------------------------------------------------------
# Filename              :       ctrmmn001.scr
# Author                :       Venki
# Description           :       This is the script that gets called on click of Go in CTRM
#
# Input                 :       NA
# Output                :       NA
# Called Script         :       None
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           27-08-2013         Venkatesh          original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="67b74899712712bac6778e8e54a56c93b0b385d5ce56c6bd6331394bdccc20ea"
	TRACE ON
	
	#----------------------------------------------------------------------
	# Create the necessary repositories and Classes
	#----------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","UPM") == 0) THEN
	#{
		CREATECLASS("CUST","UPM",5)
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.userId))THEN
	#{
		CUST.UPM.userId = BANCS.INPUT.userId
		PRINT(CUST.UPM.userId)
	#}
	ENDIF
	
	#----------------------------------------------------
	# validating the user id entered in criteria page
	#----------------------------------------------------
	IF(CUST.UPM.userId == "") THEN
	#{
		CUST.UPM.failureMessage = "User ID must be entered"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^userId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		BANCS.INPARAM.BINDVARS = CUST.UPM.userId +"|Y|N"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "usrSolId,actualRoleId,userID,Workclass|"
		sv_s = sv_s + " SELECT SOL_ID,ROLE_ID,USER_ID,USER_WORK_CLASS"
		sv_s = sv_s + " FROM TBAADM.UPR"
		sv_s = sv_s + " WHERE USER_ID =?SVAR"
		sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.UPM.actualRoleId = BANCS.OUTPARAM.actualRoleId
			CUST.UPM.usrSolId = BANCS.OUTPARAM.usrSolId
			CUST.UPM.Workclass = BANCS.OUTPARAM.Workclass
			print(CUST.UPM.actualRoleId)
			print(CUST.UPM.usrSolId)
			print(CUST.UPM.Workclass)
			#}
		ELSE
			#{
			CUST.UPM.failureMessage = "Enter a Valid User ID"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^userId"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF (BANCS.STDIN.userId==CUST.UPM.userId) THEN
	#{
		CUST.UPM.failureMessage = "Cannot grant temporary rights to own user id"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^userId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------
	# Validating whether the current user Sol and Sol id of the user
	# entered in criteria page are same
	#---------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|Y|N"
	sv_s = "solID,roleID,userID|"
	sv_s = sv_s + " SELECT SOL_ID,ROLE_ID,USER_ID"
	sv_s = sv_s + " FROM TBAADM.UPR"
	sv_s = sv_s + " WHERE USER_ID =?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.UPM.rcreSolID = BANCS.OUTPARAM.solID
		CUST.UPM.rcreRoleID = BANCS.OUTPARAM.roleID
		print(CUST.UPM.rcreSolID)
		print(CUST.UPM.rcreRoleID)
	#}
	ENDIF
	
	#-------------------------------------------------------------
	# The role id of the user invoking CTRM should be BRM
	#-------------------------------------------------------------
	print(MID$(CUST.UPM.rcreRoleID,0,3))
	IF(MID$(CUST.UPM.rcreRoleID,0,3) != "BRM") THEN
	#{
		CUST.UPM.failureMessage = "Only user with BRM,BRM2,BRM3 Role can grant temporary role rights to other users"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^userId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	#-------------------------------------------------------------
	# Temp Role can be granted to users of same sol only
	#-------------------------------------------------------------
	IF(CUST.UPM.usrSolId != CUST.UPM.rcreSolID) THEN
	#{
		CUST.UPM.failureMessage = "Granting of  temporary role rights can be done only to a user belonging to same SOL"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^userId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------------------
	# Temp Role can be granted to only users with current role as AMO
	#-----------------------------------------------------------------
	print(MID$(CUST.UPM.actualRoleId,0,3))
	IF(((MID$(CUST.UPM.actualRoleId,0,3) == "AMO") AND (CUST.UPM.Workclass=="150")) OR (MID$(CUST.UPM.actualRoleId,0,3) == "BRM")) THEN
	#{
		print("OK")
		#}
	ELSE
		#{
		CUST.UPM.failureMessage = "Temp Role can be granted to only users with current role as AMO,AMO2,AMO3,BRM,BRM2,BRM3"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^userId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#-------------------------------------------------------------
	# If validation is successful fetching the Temp Role ID and
	# Expiry date
	#-------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.UPM.userId +"|N"
	sv_s = "tempRoleId,expiryDate|SELECT TEMPORARY_ROLE_ID,TO_CHAR((TO_DATE(EXPIRY_DATE,'DD-MON-YY HH:MI:SS')), 'DD-MM-YYYY') FROM CUSTOM.C_UAD WHERE"
	sv_s = sv_s + " USER_ID = ?SVAR AND ROLLBACK = ?SVAR"
	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0) THEN
	#{
		CUST.UPM.tempRoleId = BANCS.OUTPARAM.tempRoleId
		CUST.UPM.expiryDate = BANCS.OUTPARAM.expiryDate
		#}
	ELSE
		#{
		CUST.UPM.tempRoleId = " "
		CUST.UPM.expiryDate = " "
	#}
	ENDIF
	
	print(CUST.UPM.actualRoleId)
	print(CUST.UPM.tempRoleId)
	print(CUST.UPM.expiryDate)
	
	IF(CUST.UPM.actualRoleId == "")THEN
	#{
		CUST.UPM.actualRoleId = " "
	#}
	ENDIF
	
	IF(CUST.UPM.tempRoleId == "")THEN
	#{
		CUST.UPM.tempRoleId = " "
	#}
	ENDIF
	
	IF(CUST.UPM.expiryDate == "")THEN
	#{
		CUST.UPM.expiryDate = " "
	#}
	ENDIF
	
	sv_u = urhk_SetOrbOut("currRolId|"+ CUST.UPM.actualRoleId)
	print(sv_u)
	sv_u = urhk_SetOrbOut("tempRolId|"+ CUST.UPM.tempRoleId)
	print(sv_u)
	sv_u = urhk_SetOrbOut("expDate|"+ CUST.UPM.expiryDate)
	print(sv_u)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	print(sv_u)
	
	ENDOFSCRIPT:
		
		#trace off
END-->
