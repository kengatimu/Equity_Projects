<--start
trace on
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	#sv_u = urhk_GetChannelInfo("")
	#if(sv_u==0)then
	#	EBSRV.GLBDATA.chnlId = BANCS.OUTPARAM.DccId
	#else
	#	exitscript	
	#endif
#SrvValues
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
	BANCS.INPUT.intranId = TRIM(BANCS.OUTPARAM.srvValue)
	print(BANCS.INPUT.intranId)
	if ((EBSRV.GLBDATA.tranSubType == "CI") or (EBSRV.GLBDATA.tranSubType=="BI") or (EBSRV.GLBDATA.tranSubType=="NP") or (EBSRV.GLBDATA.tranSubType=="NR"))then
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EBSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EBSRV.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
			EBSRV.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
			EBSRV.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars2)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg")
			EBSRV.GLBDATA.recDelYN=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.recDelYN)
		if(EBSRV.GLBDATA.foracid!="")then
		sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.foracid)
		if(sv_u==0)then
			EBSRV.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
			EBSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		endif
		endif
		if((EBSRV.GLBDATA.schmCode=="SB167")and(EBSRV.GLBDATA.partTranType=="C"))then
			sv_a = "nohup babx4061 $B2K_SESSION_ID ebSafaricomFloatTran.scr  "+trim(BANCS.INPUT.intranId)+" &"
                        print(sv_a)
                        sv_a = system(sv_a)
		else
			goto NXTLP
		endif
	NXTLP:
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif
VAYU:	
