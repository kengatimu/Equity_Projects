<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","LEDGR") == 0) THEN
#{
	CREATECLASS("CUST","LEDGR",5)
#}
ENDIF

IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
#{
	CREATECLASS("CUST","GCHRG",5)
#}
ENDIF

BANCS.INPUT.moduleName  = "TMCHARGES"
BANCS.INPUT.parameterId = "WITHCHRG2"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.LEDGR.withevent = BANCS.OUTPUT.parameterVal
    PRINT(CUST.LEDGR.withevent)
#}
ELSE
#{
    CUST.LEDGR.errMsg = "WITH event setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

