PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.LEDGR.tmtrfchrg = BANCS.OUTPUT.parameterVal
    PRINT(CUST.LEDGR.tmtrfchrg)
#}
ELSE
#{
    CUST.LEDGR.errMsg = "Transfer Charge Amount setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

sv_b = "FromDate|select to_char(sysdate,'MON-yyyy') from dual "
print (sv_b)
sv_d = urhk_dbselectWithBind(sv_b)
print(sv_d)

IF (sv_d == 0) THEN
#{
CUST.LEDGR.fromdate = "01" + "-" + BANCS.OUTPARAM.FromDate 
print(CUST.LEDGR.fromdate)

#}
ENDIF

sv_q="acct|"
sv_q = sv_q + "select a.foracid from custom.acct_exemption_table a, tbaadm.gam b where a.bank_id=b.bank_id "
sv_q = sv_q + "and a.bank_id =?SVAR "
sv_q = sv_q + "and a.foracid =b.foracid "
sv_q = sv_q + "and a.foracid != '1410262516061' "
sv_q = sv_q + "and a.exempt_code ='LDFEE' and a.del_flg != 'Y' "
sv_q = sv_q + "and b.ACCT_CLS_FLG != 'Y' "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
	    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	    sv_q = urhk_dbCursorFetch(sv_m)
	    print(sv_q)

	   IF(sv_q == 1) THEN
		 sv_x = urhk_dbCursorClose(sv_m)
		 print(sv_x)
		 exitscript
	   ENDIF
	  print(sv_q)

	WHILE (sv_q==0)
		CUST.LEDGR.acct=BANCS.OUTPARAM.acct
		print(CUST.LEDGR.acct)

		#CUST.LEDGR.acct="0440197164244"

		BANCS.INPARAM.BINDVARS = CUST.LEDGR.acct + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_a = "acctSolId|select sol_id from tbaadm.gam "
		sv_a = sv_a + "where foracid = ?SVAR "
		sv_a = sv_a + "and bank_id = ?SVAR"

		sv_b = urhk_dbselectWithBind(sv_a)
		print(sv_b)
		IF (sv_b == 0) THEN
		#{
		CUST.LEDGR.acctSolId = BANCS.OUTPARAM.acctSolId
		print(CUST.LEDGR.acctSolId)
		#}
		ENDIF


		####----------------------------------------------------------------------####
		#Collecting cumulative charges for transfers during the month
		####----------------------------------------------------------------------####
			
			BANCS.INPARAM.BINDVARS = CUST.LEDGR.acct + "|" + BANCS.STDIN.contextBankId + "|" + CUST.LEDGR.fromdate
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = "count|select count(*) from tbaadm.htd where acid in "
			sv_q = sv_q + "(select acid from tbaadm.gam where foracid = ?SVAR " 
			sv_q = sv_q + "and bank_id = ?SVAR) "
			sv_q = sv_q + "and PART_TRAN_TYPE = 'D' "
			sv_q = sv_q + "and ((TRAN_PARTICULAR not like 'ChequeNo%') "
			sv_q = sv_q + "and (TRAN_PARTICULAR not like 'Loan Recovery For%')) "
			sv_q = sv_q + "and TRAN_TYPE = 'T' "
			sv_q = sv_q + "and TRAN_SUB_TYPE = 'CI' "
			sv_q = sv_q + "and tran_date between ?SVAR " 
			sv_q = sv_q + "and to_date(sysdate, 'dd-mm-yy') "
			print(sv_q)

			sv_r = urhk_dbselectWithBind(sv_q)
			print(sv_r)

			IF (sv_r == 0) THEN
			#{
				
				CUST.LEDGR.count = BANCS.OUTPARAM.count
				print(CUST.LEDGR.count)

				IF (CUST.LEDGR.count > 0) THEN
				#{
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.tmtrfchrg)
					PRINT(CUST.LEDGR.amt)
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.amt)* cdouble(CUST.LEDGR.count)
					PRINT(CUST.LEDGR.amt)
						
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CUST.LEDGR.acct
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CUST.LEDGR.amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(CUST.LEDGR.trfevent)
					#CUST.GCHRG.eventId = "TRFCHRG"
					CUST.GCHRG.eventId = CUST.LEDGR.trfevent

					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
					#}
					ELSE
					#{
						PRINT("Failure")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		####----------------------------------------------------------------------####
		#Collecting cumulative charges for inward clearing during the month.
		#First count check if there has been any unpaid cheque so that no charges are collected for these transactions.
		# The difference betwwen the two counts will give the total txns to be charged.
		####----------------------------------------------------------------------####
			
			BANCS.INPARAM.BINDVARS = CUST.LEDGR.acct + "|" + BANCS.STDIN.contextBankId + "|" + CUST.LEDGR.fromdate
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = "count1|select count(*) from tbaadm.htd where acid in "
			sv_q = sv_q + "(select acid from tbaadm.gam where foracid = ?SVAR " 
			sv_q = sv_q + "and bank_id = ?SVAR) "
			sv_q = sv_q + "and PART_TRAN_TYPE = 'C' "
			sv_q = sv_q + "and TRAN_PARTICULAR like 'Unpaid ChequeNo%' "
			sv_q = sv_q + "and TRAN_TYPE = 'T' "
			sv_q = sv_q + "and TRAN_SUB_TYPE in ('BI') "
			sv_q = sv_q + "and tran_date between ?SVAR " 
			sv_q = sv_q + "and to_date(sysdate, 'dd-mm-yy') "
			print(sv_q)

			sv_s = urhk_dbselectWithBind(sv_q)
			print(sv_s)

			IF (sv_s == 0) THEN
			#{
				CUST.LEDGR.count1 = BANCS.OUTPARAM.count1
				print(CUST.LEDGR.count1)
			ENDIF


			BANCS.INPARAM.BINDVARS = CUST.LEDGR.acct + "|" + BANCS.STDIN.contextBankId + "|" + CUST.LEDGR.fromdate
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = "count2|select count(*) from tbaadm.htd where acid in "
			sv_q = sv_q + "(select acid from tbaadm.gam where foracid = ?SVAR " 
			sv_q = sv_q + "and bank_id = ?SVAR) "
			sv_q = sv_q + "and PART_TRAN_TYPE = 'D' "
			sv_q = sv_q + "and TRAN_PARTICULAR like 'ChequeNo%' "
			sv_q = sv_q + "and TRAN_TYPE = 'T' "
			sv_q = sv_q + "and TRAN_SUB_TYPE in ('CI','BI') "
			sv_q = sv_q + "and tran_date between ?SVAR " 
			sv_q = sv_q + "and to_date(sysdate, 'dd-mm-yy') "

			sv_r = urhk_dbselectWithBind(sv_q)
			print(sv_r)

			IF (sv_r == 0) THEN
			#{
				CUST.LEDGR.count2 = BANCS.OUTPARAM.count2
				print(CUST.LEDGR.count2)
				CUST.LEDGR.count = cint(CUST.LEDGR.count2) - cint(CUST.LEDGR.count1)
				print(CUST.LEDGR.count)
				IF (CUST.LEDGR.count > 0) THEN
				#{
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.tminwchrg)
					PRINT(CUST.LEDGR.amt)
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.amt)* cdouble(CUST.LEDGR.count)
					PRINT(CUST.LEDGR.amt)
				
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CUST.LEDGR.acct
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CUST.LEDGR.amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(CUST.LEDGR.tminwevent)
					#CUST.GCHRG.eventId = "INWCHRG"
					CUST.GCHRG.eventId = CUST.LEDGR.tminwevent

					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
					#}
					ELSE
					#{
						PRINT("Failure")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		
		####----------------------------------------------------------------------####
		#Collecting cumulative charges for Inhouse cheques during the month
		####----------------------------------------------------------------------####
			
			BANCS.INPARAM.BINDVARS = CUST.LEDGR.acct + "|" + BANCS.STDIN.contextBankId + "|" + CUST.LEDGR.fromdate
			PRINT(BANCS.INPARAM.BINDVARS)
		
			sv_q = "count|select count(*) from tbaadm.htd where acid in "
			sv_q = sv_q + "(select acid from tbaadm.gam where foracid = ?SVAR " 
			sv_q = sv_q + "and bank_id = ?SVAR) "
			sv_q = sv_q + "and PART_TRAN_TYPE = 'D' "
			sv_q = sv_q + "and TRAN_TYPE = 'T' "
			sv_q = sv_q + "and TRAN_SUB_TYPE = 'I' "
			sv_q = sv_q + "and INSTRMNT_TYPE = 'CHQ' "
			sv_q = sv_q + "and tran_date between ?SVAR " 
			sv_q = sv_q + "and to_date(sysdate, 'dd-mm-yy') "
			print(sv_q)

			sv_r = urhk_dbselectWithBind(sv_q)
			print(sv_r)

			IF (sv_r == 0) THEN
			#{
				CUST.LEDGR.count = BANCS.OUTPARAM.count
				print(CUST.LEDGR.count)
				IF (CUST.LEDGR.count > 0) THEN
				#{
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.tminwchrg)
					PRINT(CUST.LEDGR.amt)
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.amt)* cdouble(CUST.LEDGR.count)
					PRINT(CUST.LEDGR.amt)
						
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CUST.LEDGR.acct
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CUST.LEDGR.amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(CUST.LEDGR.tminwevent)
					#CUST.GCHRG.eventId = "INWCHRG"
					CUST.GCHRG.eventId = CUST.LEDGR.tminhevent

					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
					#}
					ELSE
					#{
						PRINT("Failure")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF

		####----------------------------------------------------------------------####
		#Collecting cumulative charges for Withdrawals during the month(Same Sol)
		####----------------------------------------------------------------------####
			
			BANCS.INPARAM.BINDVARS = CUST.LEDGR.acct + "|" + BANCS.STDIN.contextBankId + "|" + CUST.LEDGR.acctSolId + "|" + CUST.LEDGR.fromdate
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = "count|select count(*) from tbaadm.htd where acid in "
			sv_q = sv_q + "(select acid from tbaadm.gam where foracid = ?SVAR " 
			sv_q = sv_q + "and bank_id = ?SVAR) "
			sv_q = sv_q + "and PART_TRAN_TYPE = 'D' "
			sv_q = sv_q + "and TRAN_TYPE = 'C' "
			sv_q = sv_q + "and TRAN_SUB_TYPE = 'NP' "
			sv_q = sv_q + "and DTH_INIT_SOL_ID = ?SVAR "
			sv_q = sv_q + "and tran_date between ?SVAR " 
			sv_q = sv_q + "and to_date(sysdate, 'dd-mm-yy') "
			print(sv_q)

			sv_r = urhk_dbselectWithBind(sv_q)
			print(sv_r)

			IF (sv_r == 0) THEN
			#{
				CUST.LEDGR.count = BANCS.OUTPARAM.count
				print(CUST.LEDGR.count)
				IF (CUST.LEDGR.count > 0) THEN
				#{
						CUST.LEDGR.amt = cdouble(CUST.LEDGR.tmwithchrg)
						PRINT(CUST.LEDGR.amt)
						CUST.LEDGR.amt = cdouble(CUST.LEDGR.amt)* cdouble(CUST.LEDGR.count)
						PRINT(CUST.LEDGR.amt)
				
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CUST.LEDGR.acct
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CUST.LEDGR.amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(CUST.LEDGR.withevent)
					#CUST.GCHRG.eventId = "TRFCHRG"
					CUST.GCHRG.eventId = CUST.LEDGR.withevent

					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
					#}
					ELSE
					#{
						PRINT("Failure")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF



		####----------------------------------------------------------------------####
		#Collecting cumulative charges for Withdrawals during the month(Intersol)
		####----------------------------------------------------------------------####
			
			BANCS.INPARAM.BINDVARS = CUST.LEDGR.acct + "|" + BANCS.STDIN.contextBankId + "|" + CUST.LEDGR.acctSolId + "|" + CUST.LEDGR.fromdate
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = "count|select count(*) from tbaadm.htd where acid in "
			sv_q = sv_q + "(select acid from tbaadm.gam where foracid = ?SVAR " 
			sv_q = sv_q + "and bank_id = ?SVAR) "
			sv_q = sv_q + "and PART_TRAN_TYPE = 'D' "
			sv_q = sv_q + "and TRAN_TYPE = 'C' "
			sv_q = sv_q + "and TRAN_SUB_TYPE = 'NP' "
			sv_q = sv_q + "and DTH_INIT_SOL_ID !=?SVAR "
			sv_q = sv_q + "and tran_date between ?SVAR " 
			sv_q = sv_q + "and to_date(sysdate, 'dd-mm-yy') "
			print(sv_q)

			sv_r = urhk_dbselectWithBind(sv_q)
			print(sv_r)

			IF (sv_r == 0) THEN
			#{
				CUST.LEDGR.count = BANCS.OUTPARAM.count
				print(CUST.LEDGR.count)
				IF (CUST.LEDGR.count > 0) THEN
				#{
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.tmintchrg)
					PRINT(CUST.LEDGR.amt)
					CUST.LEDGR.amt = cdouble(CUST.LEDGR.amt)* cdouble(CUST.LEDGR.count)
					PRINT(CUST.LEDGR.amt)
						
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CUST.LEDGR.acct
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CUST.LEDGR.amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(CUST.LEDGR.intevent)
					#CUST.GCHRG.eventId = ""
					CUST.GCHRG.eventId = CUST.LEDGR.intevent

					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
					#}
					ELSE
					#{
						PRINT("Failure")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	DO
#}
ENDIF

