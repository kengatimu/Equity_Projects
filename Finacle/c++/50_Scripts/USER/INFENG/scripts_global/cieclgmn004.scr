#*******************************************************************************************************
# Filename              : cieclgmn004.scr
# Description           : This is the main script for lodging cheque in another entity
# Input                 : This script calls child script cieclgdp040.scr to form the request xml
# Output                : This script calls child script cieclgdp041.scr to extract the data from response xml
# Called Script         : cieclgdp040.scr, cieclgdp041.scr
# Calling Script        :

# Modification History
# Sl. #           Date             Author             Modification           Version
# -----          -----            --------          ----------------        ---------
#  1           19-04-2013         Venkatesh          Original Version          1.0
#********************************************************************************************************

<--START
CHECKSUM="027f7ce40fe94be7192b86e30e5994e19872e5735ce2ad5c045655841675aa4d"
	TRACE ON
	
	CALL("Common_Interface_CreateRepos.scr")
	
	print(CUST.INTERFACE.funcCode)
	print(CUST.INTERFACE.RequestID)
	print(CUST.INTERFACE.channelID)
	print(CUST.INTERFACE.bankID)
	print(CUST.INTERFACE.zoneCode)
	print(CUST.INTERFACE.zoneDate)
	print(CUST.INTERFACE.solId)
	print(CUST.INTERFACE.acctId)
	print(CUST.INTERFACE.instrumentAmt)
	print(CUST.INTERFACE.instrumentAmtCcy)
	print(CUST.INTERFACE.sortCode)
	print(CUST.INTERFACE.bankCode)
	print(CUST.INTERFACE.branchCode)
	print(CUST.INTERFACE.instrumentNum)
	print(CUST.INTERFACE.instrumentDate)
	print(CUST.INTERFACE.valueDate)
	print(CUST.INTERFACE.setNum)
	print(CUST.INTERFACE.payingAcct)
	print(CUST.INTERFACE.rejectReasonCode)
	
	#--------------------------------------------------------------------------------------------------------
	#- Calling cieclgdp040.scr to create the Request xml.
	#--------------------------------------------------------------------------------------------------------
	CALL("cieclgdp040.scr")
	
	#-------------------------------------------------------------------------
	#Appending the header XML and body XML.
	#-------------------------------------------------------------------------
	CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"
	
	#-------------------------------------------------------------------------------
	# Setting input values for urhk_ConnectToFIAndSendMsg userhook
	#-------------------------------------------------------------------------------
	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	sv_a = CUST.INTERFACE.reqXMLMsg
	PRINT(sv_a)
	
	#-------------------------------------------------------------------------
	#- Executing the userhook to make the Outbound Call
	#-------------------------------------------------------------------------
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	IF (sv_l != 0) THEN
	#{
		print(BANCS.OUTPARAM.ErrMsg)
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		CUST.INTERFACE.errorMsgCode = "FIERR"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (BANCS.OUTPARAM.ErrMsg != "") THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
		CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		CUST.INTERFACE.errorMsgCode = "FIERR"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
		print(CUST.INTERFACE.respXMLMsg)
		CUST.INTERFACE.errorMsgFlg = ""
		CUST.INTERFACE.errorMsgDesc = ""
		CALL("cieclgdp041.scr")
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
		#trace off
END-->
