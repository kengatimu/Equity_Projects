	sv_a = ""
	
	sv_a = sv_a + "ccardSchms|select parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER "
	sv_a = sv_a + " WHERE C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
	sv_a = sv_a + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
	sv_a = sv_a + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
	sv_a = sv_a + " C_CPVALUE.del_flg != 'Y' AND "
	sv_a = sv_a + " C_CPVALUE.entity_cre_flg = 'Y' AND "
	sv_a = sv_a + " C_CPMASTER.bank_id = ?SVAR AND "
	sv_a = sv_a + " C_CPMASTER.module_name = ?SVAR AND "
	sv_a = sv_a + " C_CPVALUE.parameter_id = ?SVAR"
	
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CCARD.moduleName + "|" + CUST.CCARD.parameterId
	
	sv_d = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_a)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.ccardSchms)
		CUST.CCARD.paramVal = BANCS.OUTPARAM.ccardSchms
		#}
	ELSE
		#{
		CUST.CCARD.errMsg = "CPARAM not maintained for Parameter Id: "+CUST.CCARD.parameterId + " for OD in Entity: "+ BANCS.STDIN.contextBankId
		PRINT(CUST.CCARD.errMsg)
		BANCS.OUTPUT.ErrorDesc = CUST.CCARD.errMsg
		sv_u = urhk_SRV_SetErr(BANCS.OUTPUT.ErrorDesc)
		BANCS.OUTPUT.successOrFailure = "F"
		EXITSCRIPT
		
	#}
	ENDIF
	PRINT(CUST.CCARD.paramVal)
	
	#####################################################
	##fetching the partrans of the transaction
	#####################################################
	
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		PRINT("no records available!!")
		EXITSCRIPT
	#}
	ENDIF
	
	sv_j = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(sv_j)
	
	sv_n = 0
	
	WHILE(sv_n < sv_j)
	#{
		
		######################################################
		#fetching the part tran type
		######################################################
		
		CUST.CCARD.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.partTranType.code"
		sv_u = urhk_SRV_GetVal(CUST.CCARD.msgStr)
		IF(sv_u != 0) THEN
		#{
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.CCARD.partTranType = BANCS.OUTPARAM.srvValue
		
		###############################################
		#fetching the foracid of the part tran
		###############################################
		CUST.CCARD.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.acctId.foracid"
		sv_u = urhk_SRV_GetVal(CUST.CCARD.msgStr)
		IF(sv_u != 0) THEN
		#{
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.CCARD.foracid = BANCS.OUTPARAM.srvValue
		
		CUST.CCARD.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.tranParticulars"
		sv_u = urhk_SRV_GetVal(CUST.CCARD.msgStr)
		IF(sv_u != 0) THEN
		#{
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.CCARD.tranParticular = TOUPPER(BANCS.OUTPARAM.srvValue)

	        CUST.CCARD.COUNT = GETPOSITION(CUST.CCARD.tranParticular,"BILL COLLECTION")
                print(CUST.CCARD.COUNT)

                IF(CUST.CCARD.COUNT != 0) THEN
                #{
			GOTO NEXTFETCH
                #}
                ENDIF
		
		###################################################
		#fetching schmCode of the tran account
		####################################################
		
		sv_r = urhk_getAcctDetailsInRepository(CUST.CCARD.foracid)
		
		IF(sv_r == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.schmCode)
			CUST.CCARD.schmCode = BANCS.OUTPARAM.schmCode
			
			PRINT(BANCS.OUTPARAM.schmType)
			CUST.CCARD.schmType = BANCS.OUTPARAM.schmType
			#}
		ELSE
			#{
			PRINT("Invalid acct")
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(CUST.CCARD.schmCode)
		PRINT(CUST.CCARD.schmType)
		PRINT(CUST.CCARD.paramVal)
		
		IF(CUST.CCARD.schmType == "ODA")THEN
		#{
			
			
			###################################################################
			# checking if the schm code belongs to Credit card schemes
			###################################################################
			
			sv_c = "avail|select decode(count(1),0,'N','Y') from dual where INSTR(?SVAR,?SVAR) != 0"
			
			PRINT(sv_c)
			BANCS.INPARAM.BINDVARS = CUST.CCARD.paramVal + "|" + CUST.CCARD.schmCode
			
			sv_l = urhk_dbSelectWithBind(sv_c)
			
			PRINT(sv_l)
			
			IF(sv_l != 0)THEN
			#{
				PRINT("Error in query")
			#}
			ENDIF
			
			PRINT(BANCS.OUTPARAM.avail)
			
			IF(BANCS.OUTPARAM.avail == "Y")THEN
			#{
				
				PRINT(BANCS.STDIN.userId)
				
				
				########################################################################################
				# To restrict system from doing manual debit transaction on the credit card account.
				# On this account the debit should be allowed only via Channels/FI/ATM/POS etc.
				#######################################################################################
				IF(CUST.CCARD.partTranType == "D")THEN
				#{
					IF((BANCS.STDIN.userId != "CDCI") OR (BANCS.STDIN.userId != "FIVUSR"))THEN
					#{
						CUST.CCARD.errorMsg = "Direct debit transactions of Credit Card accounts allowed only via Channels/FI/ATM/POS !!"
						sv_u = urhk_SRV_SetErr(CUST.CCARD.errorMsg)
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				
				PRINT(CUST.CCARD.partTranType)
				
				###################################################################
				# check whether billing is due or not for the given account.
				# for this fetching bill amount and total adjustment amt from ROBT
				###################################################################
				
				sv_u = ""
				
				sv_u = sv_u + "billAmt,adjAmt|select bill_amt,TOT_ADJ_AMT from tbaadm.robt "
				sv_u = sv_u + " where ACID = (select acid from tbaadm.gam where foracid = ?SVAR"
				sv_u = sv_u + " AND bank_id = ?SVAR AND entity_cre_flg = 'Y' AND del_flg = 'N' "
				sv_u = sv_u + " AND acct_cls_flg != 'Y') AND bank_id = ?SVAR "
				
				BANCS.INPARAM.BINDVARS = CUST.CCARD.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
				
				sv_v = urhk_dbSelectWithBind(sv_u)
				PRINT(sv_u)
				
				PRINT(sv_v)
				
				IF(sv_v!=0)THEN
				#{
					
					PRINT("Error in fetching the bill details from Billing table!!")
					CUST.CCARD.errMsg = "Error in fetching the bill details from Billing table!!"
					PRINT(CUST.CCARD.errMsg)
					BANCS.OUTPUT.ErrorDesc = CUST.CCARD.errMsg
					sv_u = urhk_SRV_SetErr(BANCS.OUTPUT.ErrorDesc)
					BANCS.OUTPUT.successOrFailure = "F"
					GOTO NEXTFETCH
				#}
				ENDIF
				
				PRINT(BANCS.OUTPARAM.billAmt)
				
				PRINT(BANCS.OUTPARAM.adjAmt)
				
				CUST.CCARD.billAmt = BANCS.OUTPARAM.billAmt
				CUST.CCARD.adjAmt = BANCS.OUTPARAM.adjAmt
				
				################################################################
				# sv_z have value of amount remaining beyond the billing amt
				################################################################
				
				sv_z = CDOUBLE(CUST.CCARD.billAmt) - CDOUBLE(CUST.CCARD.adjAmt)
				
				PRINT(sv_z)
				
				################################################################################################################
				#To restrict system from doing manual credit transaction on the credit card account ONLY if any billing is due.
				# If so, then it has to be ONLY satisfied using the batch HODBLCOL.
				################################################################################################################
				
				IF((sv_z > 0) AND (CUST.CCARD.partTranType == "C"))THEN
				#{
					CUST.CCARD.errorMsg = "Direct Credit not permitted into CreditCard Accounts as billing is due. Please satisfy using HODBLCOL!"
					sv_u = urhk_SRV_SetErr(CUST.CCARD.errorMsg)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				######################################################################################
				# if billing amount is not due and part tran type is credit,
				# then user can directly credit into his Credit card account
				######################################################################################
				
				IF((sv_z <= 0) AND (CUST.CCARD.partTranType == "C"))THEN
				#{
					
					GOTO NEXTFETCH
					
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		NEXTFETCH:
			
			sv_n = sv_n + 1
		#}
		DO
		
	ENDOFSCRIPT:
		EXITSCRIPT
END-->

