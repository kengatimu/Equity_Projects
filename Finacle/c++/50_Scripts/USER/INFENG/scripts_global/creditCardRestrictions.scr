	CUST.CCARD.billAmt = ""
	CUST.CCARD.adjAmt = ""
	CUST.CCARD.ccardschms = ""
	CUST.CCARD.schmCode = ""
	CUST.CCARD.schmType = ""
	
	sv_r = urhk_B2k_PrintRepos("BANCS")
