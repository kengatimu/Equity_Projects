			sv_s = sv_s + " WHERE a.acid=b.acid and a.bank_id=b.bank_id and foracid= ?SVAR"
			sv_s = sv_s + " AND b.bank_id= ?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d == 0) THEN
			#{
				CUSTS.GLBDATA.currency	= BANCS.OUTPARAM.currency
				PRINT(CUSTS.GLBDATA.currency)
				CUSTS.GLBDATA.glsubheadcode	= BANCS.OUTPARAM.glsubheadcode
				PRINT(CUSTS.GLBDATA.glsubheadcode)
				CUSTS.GLBDATA.schmcode	= BANCS.OUTPARAM.schmcode
				PRINT(CUSTS.GLBDATA.schmcode)
				CUSTS.GLBDATA.sweeps	= BANCS.OUTPARAM.sweeps
				PRINT(CUSTS.GLBDATA.sweeps)
				CUSTS.GLBDATA.solid	= BANCS.OUTPARAM.solid
				PRINT(CUSTS.GLBDATA.solid)
				CUSTS.GLBDATA.status	= BANCS.OUTPARAM.status
				PRINT(CUSTS.GLBDATA.status)
				
				IF (CUSTS.GLBDATA.sweeps == "") THEN
				#{
					CUSTS.GLBDATA.sweeps = "N"
				#}
				ENDIF
	
			#}
			ENDIF
			
			IF(CUSTS.GLBDATA.solid != BANCS.STDIN.mySolId)THEN
			#{
				sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.GLBDATA.solid)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
			#}
			ENDIF
			
			
			sv_a=urhk_SetUrhkInp("fromSol.solId|" + CUSTS.GLBDATA.solid)
			print(sv_a)
			
			sv_a=urhk_SetUrhkInp("toSol.solId|" + CUSTS.GLBDATA.tosolid)
			print(sv_a)
			
			sv_a=urhk_SetUrhkInp("xferAcct.foracid|" + CUSTS.GLBDATA.foracid)
			print(sv_a)
			
			sv_a=urhk_SetUrhkInp("acctStat.code|" + CUSTS.GLBDATA.status)
			print(sv_a)
			
			sv_a=urhk_SetUrhkInp("xferAcct.crncyCode|" + CUSTS.GLBDATA.currency)
			print(sv_a)
			
			sv_a=urhk_SetUrhkInp("schm.schmCode|" + CUSTS.GLBDATA.schmcode)
			print(sv_a)
			
			sv_a=urhk_SetUrhkInp("glSubHead.glSubHeadCode|" + CUSTS.GLBDATA.glsubheadcode)
			print(sv_a)
			
			sv_a=urhk_SetUrhkInp("verifyStat|Y")
			print(sv_a)
			
			sv_u = urhk_ExecSrv("SRV_XferAcctBtwnSolAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			
			IF(sv_u == 0) THEN
			#{
				#print (BANCS.OUTPARAM.foracid)
