	CPLTM.GLBDATA.sendercountry		    = BANCS.OUTPARAM.sendercountry
	print(CPLTM.GLBDATA.sendercountry)
	CPLTM.GLBDATA.senderdob			    = BANCS.OUTPARAM.senderdob
