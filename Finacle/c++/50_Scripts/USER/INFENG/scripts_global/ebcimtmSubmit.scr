			if(fieldexists(CPLTM.GLBDATA.ResCode)==1)then
			#{
				if(CPLTM.GLBDATA.ResCode!="200")then
				#{
					print(CPLTM.GLBDATA.OresponseDesc)
					CPLTM.GLBDATA.errMsg = CPLTM.GLBDATA.OresponseDesc 
					print(CPLTM.GLBDATA.errMsg)
					goto ERR_RES
				#}
				else
				#{
					print(CPLTM.GLBDATA.OresponseDesc)
					CPLTM.GLBDATA.errMsg = CPLTM.GLBDATA.OresponseDesc 
					print(CPLTM.GLBDATA.errMsg)
					if(fieldexists(CPLTM.GLBDATA.Ostatus)==1)then
					#{
						print(CPLTM.GLBDATA.Ostatus)
						if(CPLTM.GLBDATA.Ostatus=="CREATED")then
						#{
							if(CPLTM.GLBDATA.OresponseCode=="00")then
							#{
								print(CPLTM.GLBDATA.OinternalPaymentRef)
								CPLTM.GLBDATA.entity_cre_flg ="Y"
								sv_a = " update  custom.CUST_CIMTM_MASTER_TABLE set vfd_user_id =?SVAR ,vfd_time=sysdate ,Transaction_status= ?SVAR, "
								sv_a = sv_a + " Transaction_responseCode=?SVAR , Transaction_responseDesc='CLOUDPOST',internal_pymnt_refnum=?SVAR , entity_cre_flg='Y' "
								sv_a = sv_a + " where bank_id=?SVAR  "
								sv_a = sv_a + " and PymntRefNum = ?SVAR  "
								print(sv_a)
								BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + CPLTM.GLBDATA.Ostatus + "|" +  CPLTM.GLBDATA.OresponseCode + "|" +  CPLTM.GLBDATA.OinternalPaymentRef + "|" +  BANCS.STDIN.contextBankId + "|" + CPLTM.GLBDATA.PymntRefNum
								print(BANCS.INPARAM.BINDVARS)
								sv_b =  urhk_dbSqlWithBind(sv_a)
								print(sv_b)	
								IF(sv_b =="0") THEN
								#{
									sv_d = urhk_dbSqlWithBind("COMMIT")
									print(sv_d)
									CPLTM.GLBDATA.resMsg = "IMT Request Created and Posted Successfully! IMT Number: " + CPLTM.GLBDATA.PymntRefNum
									print(CPLTM.GLBDATA.resMsg)						
									lv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
									lv_b = urhk_SetOrbOut("RESULT_MSG|" +CPLTM.GLBDATA.resMsg)
									exitscript
								#}
								ELSE
								#{
									sv_d = urhk_dbSqlWithBind("ROLLBACK")
									print(sv_d)
									CPLTM.GLBDATA.resMsg = "IMT Request Failed"
									print(CPLTM.GLBDATA.errMsg)
									GOTO ERR_RES
								#}
								ENDIF
							#}
							endif
						#}
						else
						#{
									print(CPLTM.GLBDATA.errMsg)
									GOTO ERR_RES

						#}
						endif
					#}
					endif
					goto ERR_RES
				#}
				endif
			#}
			else
			#{
					CPLTM.GLBDATA.errMsg = "Gag Imt Cloud Service Not Available." 
					print(CPLTM.GLBDATA.errMsg)
					goto ERR_RES
			#}
			endif
		#}
		endif
		print(CPLTM.GLBDATA.TResresponseCode)
		print(CPLTM.GLBDATA.TResresponseStat)
		print(CPLTM.GLBDATA.TResresponseDesc)
		#++++++Response Check
		if((CPLTM.GLBDATA.TResresponseCode=="907") and (CPLTM.GLBDATA.TResresponseStat=="NA") and (CPLTM.GLBDATA.TResresponseDesc=="ISO Request Failed "))then
			print(CPLTM.GLBDATA.rrn)
			print(CPLTM.GLBDATA.Field74)
			print(CPLTM.GLBDATA.Dracno)
			sv_q = urhk_B2k_ForacidToAcid(CPLTM.GLBDATA.Dracno)
			if(sv_q==0)then
				CPLTM.GLBDATA.opAcid = BANCS.OUTPARAM.Acid
				print(CPLTM.GLBDATA.opAcid)
			else
				sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
				sv_u = urhk_SetOrbOut("Message|Invalid Debit account ISO Transaction Failed ")
				BANCS.OUTPUT.successOrFailure="F"
				exitscript
			endif
			print(CPLTM.GLBDATA.Field8)
			if((CPLTM.GLBDATA.Field8!="")and(CPLTM.GLBDATA.Field8!="NA"))then
			#{
				if(CPLTM.GLBDATA.Field8=="COMPLETED")then
					CPLTM.GLBDATA.TResresponseCode = "00"
					CPLTM.GLBDATA.TResresponseStat = "POSTED"
					CPLTM.GLBDATA.TResresponseDesc = "COMPLETED"
				else
					#==HARRISON Check for response error n send to UI

					if(fieldexists(("CPLTM").("GLBDATA").("Field"+CPLTM.GLBDATA.tempStr))==1)then
					#{	
						IF( ( ("CPLTM").("GLBDATA").("Field"+CPLTM.GLBDATA.tempStr) !="") AND ( ("CPLTM").("GLBDATA").("Field"+CPLTM.GLBDATA.tempStr) !="NA") )THEN
						#{
							
							lv_a = ("CPLTM").("GLBDATA").("Field"+CPLTM.GLBDATA.tempStr)
							print(lv_a)

							lv_n = getposition(lv_a,"{")
							print(lv_n)

							IF(lv_n > 0)THEN
							#{
								print("exists")

								lv_c = STRLEN(lv_a)
								print(lv_c)
								lv_x = getposition(lv_a, "Description") -2
								print(lv_x)

								IF( lv_x > 0)THEN
								#{
									lv_e = lv_c - lv_x
									print(lv_e)
									lv_d = mid$(lv_a, lv_x, lv_e)
									print(lv_d)

									lv_f = getposition(lv_d, ",") -1
									print(lv_f)

									IF(lv_f > 0)THEN
									#{
										lv_d = mid$(lv_d, 0, lv_f)
										print(lv_d)
										CPLTM.GLBDATA.errMsg = lv_d
									#}
									ENDIF 
								#}
								ENDIF

								lv_x = getposition(lv_a, "Source") -2
								print(lv_x)

								IF(lv_x > 0)THEN
								#{
									lv_e = lv_c - lv_x
									print(lv_e)
									lv_m = mid$(lv_a, lv_x, lv_e)
									print(lv_m)

									lv_f = getposition(lv_m, ",") -1
									print(lv_f)

									IF(lv_f > 0)THEN
									#{
										lv_m= mid$(lv_m, 0, lv_f)
										print(lv_m)

										CPLTM.GLBDATA.errMsg = CPLTM.GLBDATA.errMsg +" "+ lv_m
										print(CPLTM.GLBDATA.errMsg)
										
									#}
									ENDIF 
								
								#}
								ENDIF 

							ELSE 
								print(lv_a)
								CPLTM.GLBDATA.resMsg = lv_a
							#}
							ENDIF 

							IF(fieldexists(CPLTM.GLBDATA.errMsg)==1)THEN
							#{
								IF(CPLTM.GLBDATA.errMsg !="")THEN
								#{
									print(CPLTM.GLBDATA.errMsg)
									GOTO ERR_RES
								#}
								ENDIF 
							#}
							ENDIF 

						ELSE 
							CPLTM.GLBDATA.TResresponseCode = "RX"
							CPLTM.GLBDATA.TResresponseStat = "Failed"
							CPLTM.GLBDATA.TResresponseDesc = CPLTM.GLBDATA.Field8
						#}
						ENDIF 
					ELSE 
						CPLTM.GLBDATA.TResresponseCode = "RX"
						CPLTM.GLBDATA.TResresponseStat = "Failed"
						CPLTM.GLBDATA.TResresponseDesc = CPLTM.GLBDATA.Field8
					#}
					endif

				endif
			#}
			endif
			lv_m = "gagisoTCnt| select count(*) from tbaadm.dtd where bank_id=?SVAR and acid=?SVAR "
			##lv_m = lv_m + " and tran_date =to_date(?SVAR,'DD-MM-RRRR') "
			lv_m = lv_m + " and value_date =to_date(?SVAR,'DD-MM-RRRR') "
			lv_m = lv_m + " and tran_particular like '%"+CPLTM.GLBDATA.rrn+"%'"
			##lv_m = lv_m + " and ref_num=?SVAR "
			lv_m = lv_m + " and tran_rmks like '%"+CPLTM.GLBDATA.rrn+"%'"
			lv_m = lv_m + " and pstd_flg='Y' "
			lv_m = lv_m + " and del_flg='N' and module_id='DCI' "
			###BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CPLTM.GLBDATA.opAcid + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + CPLTM.GLBDATA.rrn  
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CPLTM.GLBDATA.opAcid + "|" + mid$(BANCS.STDIN.BODDate,0,10) 
			print(BANCS.INPARAM.BINDVARS)
			print(lv_m)
			lv_d = urhk_dbSelectWithBind(lv_m)
			print(lv_d)
			if(lv_d==0)then
				CPLTM.GLBDATA.gagisoTCnt = BANCS.OUTPARAM.gagisoTCnt 
			else
				CPLTM.GLBDATA.gagisoTCnt = 0
			endif
			if(cdouble(CPLTM.GLBDATA.gagisoTCnt)>=1)then
				CPLTM.GLBDATA.TResresponseCode = "00"
				CPLTM.GLBDATA.TResresponseStat = "POSTED"
				CPLTM.GLBDATA.TResresponseDesc = "COMPLETED"
			endif
			
		else
			print(CPLTM.GLBDATA.TResresponseCode)
			print(CPLTM.GLBDATA.TResresponseStat)
			print(CPLTM.GLBDATA.TResresponseDesc)
		endif
			
		IF(CPLTM.GLBDATA.TResresponseCode =="-2") THEN
		#{
			CPLTM.GLBDATA.TResresponseDesc = "Quote for this transaction Not found"
		#}
		ENDIF
		IF(CPLTM.GLBDATA.TResresponseCode =="-3") THEN
		#{
			CPLTM.GLBDATA.TResresponseDesc = "error description from Mastercard or Finacle ISO Transaction not posted reversal completed"
		#}
		ENDIF		
		IF(CPLTM.GLBDATA.TResresponseCode =="-9") THEN
		#{
			CPLTM.GLBDATA.TResresponseDesc = "KES 100.00 Minimum transaction limit not reached "
		#}
		ENDIF				
		IF(CPLTM.GLBDATA.TResresponseCode =="-10") THEN
		#{
			CPLTM.GLBDATA.TResresponseDesc = "KES 140000.00 Maximum transaction limit exceeded "
		#}
		ENDIF
		
		IF(CPLTM.GLBDATA.TResresponseCode =="00") THEN
		#{
			IF(CPLTM.GLBDATA.funcCode =="P") THEN
			#{
				CPLTM.GLBDATA.entity_cre_flg ="Y"
				sv_a = " update  custom.CUST_CIMTM_MASTER_TABLE set vfd_user_id =?SVAR ,vfd_time=sysdate ,Transaction_status= ?SVAR, "
				sv_a = sv_a + " Transaction_responseCode=?SVAR , Transaction_responseDesc=?SVAR , entity_cre_flg=?SVAR "
				sv_a = sv_a + " where bank_id=?SVAR  "
				sv_a = sv_a + " and PymntRefNum = ?SVAR  "
				print(sv_a)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + CPLTM.GLBDATA.TResresponseStat + "|" +  CPLTM.GLBDATA.TResresponseCode + "|" + CPLTM.GLBDATA.TResresponseDesc + "|" + CPLTM.GLBDATA.entity_cre_flg + "|" + BANCS.STDIN.contextBankId + "|" + CPLTM.GLBDATA.PymntRefNum
				print(BANCS.INPARAM.BINDVARS)
				sv_b =  urhk_dbSqlWithBind(sv_a)
				print(sv_b)	
				IF(sv_b =="0") THEN
				#{
					sv_d = urhk_dbSqlWithBind("COMMIT")
					print(sv_d)
					CPLTM.GLBDATA.resMsg = "IMT Request Created Successfully! IMT Number: " + CPLTM.GLBDATA.PymntRefNum
					print(CPLTM.GLBDATA.resMsg)						
				#}
				ELSE
				#{
					sv_d = urhk_dbSqlWithBind("ROLLBACK")
					print(sv_d)
					CPLTM.GLBDATA.resMsg = "IMT Request Failed"
					print(CPLTM.GLBDATA.errMsg)
					GOTO ERR_RES						
				#}
				ENDIF
			#}
			ENDIF
			CPLTM.GLBDATA.resMsg = "IMT Request Created Successfully! IMT Number: " + CPLTM.GLBDATA.PymntRefNum
		#}
		ELSE
		#{
			IF(CPLTM.GLBDATA.funcCode =="P") THEN
			#{
				CPLTM.GLBDATA.entity_cre_flg ="Y"
				sv_a = " update  custom.CUST_CIMTM_MASTER_TABLE set vfd_user_id =?SVAR ,vfd_time=sysdate ,Transaction_status= ?SVAR, "
				sv_a = sv_a + " Transaction_responseCode=?SVAR , Transaction_responseDesc=?SVAR , entity_cre_flg=?SVAR "
				sv_a = sv_a + " where bank_id=?SVAR  "
				sv_a = sv_a + " and PymntRefNum = ?SVAR  "
				print(sv_a)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + CPLTM.GLBDATA.TResresponseStat + "|" +  CPLTM.GLBDATA.TResresponseCode + "|" + CPLTM.GLBDATA.TResresponseDesc + "|" + CPLTM.GLBDATA.entity_cre_flg + "|" + BANCS.STDIN.contextBankId + "|" + CPLTM.GLBDATA.PymntRefNum
				print(BANCS.INPARAM.BINDVARS)
				sv_b =  urhk_dbSqlWithBind(sv_a)
				print(sv_b)	
				IF(sv_b =="0") THEN
				#{
					sv_d = urhk_dbSqlWithBind("COMMIT")
					print(sv_d)

					IF(CPLTM.GLBDATA.TResresponseStat == "Failed")THEN
					#{
						CPLTM.GLBDATA.resMsg = "The Request has Failed " + CPLTM.GLBDATA.PymntRefNum 
					ELSE 
						CPLTM.GLBDATA.resMsg = CPLTM.GLBDATA.TResresponseDesc
						CPLTM.GLBDATA.errMsg = CPLTM.GLBDATA.TResresponseDesc
					#}
					ENDIF 

					print(CPLTM.GLBDATA.errMsg)
					GOTO ERR_RES						
				#}
				ELSE
				#{
					sv_d = urhk_dbSqlWithBind("ROLLBACK")
					print(sv_d)
					CPLTM.GLBDATA.resMsg = "IMT Request Failed"
					print(CPLTM.GLBDATA.errMsg)
					GOTO ERR_RES						
				#}
				ENDIF
			#}
			ENDIF
			if(CPLTM.GLBDATA.TResresponseDesc!="")then
				CPLTM.GLBDATA.errMsg 	= CPLTM.GLBDATA.TResresponseDesc 
				print(CPLTM.GLBDATA.errMsg)
				GOTO ERR_RES
			else
				CPLTM.GLBDATA.errMsg 	= "ISO Tran Creation Failed"
				print(CPLTM.GLBDATA.errMsg)
				GOTO ERR_RES
			endif
		#}
		ENDIF	
	#}
	ENDIF	
	
	if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
	#{
		print(BANCS.OUTPARAM.successOrFailure)
		sv_s = BANCS.OUTPARAM.successOrFailure
	else
		sv_s = "X"
	#}
	endif
	

	if(CPLTM.GLBDATA.funcCode =="X")then
	#{
		sv_a = "UPDATE custom.CUST_CIMTM_MASTER_TABLE set del_flg='Y' "
		sv_a = sv_a + " WHERE PymntRefNum  = '" + CPLTM.GLBDATA.PymntRefNum + "'  and  ENTITY_CRE_FLG = 'N' and TRANSACTION_RESPONSECODE is null "
		print(sv_a)
		sv_a = urhk_dbSQLWithBind(sv_a)
		print(sv_a)
		IF (sv_a == "0") THEN
		#{
			sv_u = urhk_dbSqlWithBind("Commit")
			print(sv_u)
			CPLTM.GLBDATA.resMsg = "IMT Transaction Canceled Successfully! " + CPLTM.GLBDATA.PymntRefNum 
			print(CPLTM.GLBDATA.resMsg )
		#}
		ELSE
		#{
			CPLTM.GLBDATA.errMsg = " IMT Transaction Cannot Cancel !! " + CPLTM.GLBDATA.PymntRefNum + " Due to request posted already or post failed "
			GOTO ERR_RES
		#}
		ENDIF
	#}
	endif

#}
endif

ERR_RES:
	if((CPLTM.GLBDATA.errMsg != "")AND(CPLTM.GLBDATA.errMsg!="null")) then
	#{
		lv_e = urhk_SetOrbErr(CPLTM.GLBDATA.errMsg)
		GOTO ENDOFSCRIPT
	else
		if(CPLTM.GLBDATA.resMsg != "") then
		#{
			lv_a = urhk_dbSQLWithBind("COMMIT")
			print(lv_a)
			if(lv_a == 0) then
			#{
				lv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
				lv_b = urhk_SetOrbOut("RESULT_MSG|" +CPLTM.GLBDATA.resMsg)
			else
				lv_e = urhk_SetOrbErr("Error in Saving Data")
				GOTO ENDOFSCRIPT
			#}
			endif
		#}
		endif
	#}
	endif
ENDOFSCRIPT:
    EXITSCRIPT
trace off
