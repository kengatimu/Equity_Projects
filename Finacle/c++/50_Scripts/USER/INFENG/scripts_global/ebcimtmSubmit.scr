## Post and Cancel Approach 
if((CPLTM.GLBDATA.funcCode == "P") or (CPLTM.GLBDATA.funcCode=="X")) then
#{
	###########################################################3333
		sv_s = " " 
		sv_s = "QRestransactionId,cloudQuoteId"
