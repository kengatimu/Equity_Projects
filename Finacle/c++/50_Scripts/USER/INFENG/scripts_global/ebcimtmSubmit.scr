##Val
if((CPLTM.GLBDATA.funcCode=="AP") or (CPLTM.GLBDATA.funcCode=="A"))then
#{
    sv_u = urhk_getAcctDetailsInRepository(CPLTM.GLBDATA.Dracno)
    if(sv_u == 0)then
	#{
        CPLTM.GLBDATA.schmType 		= BANCS.OUTPARAM.schmType
        CPLTM.GLBDATA.cifId 		= BANCS.OUTPARAM.cifId
        CPLTM.GLBDATA.OpnDate 		= BANCS.OUTPARAM.acctOpenDate
        CPLTM.GLBDATA.acctOpnDate 	= Mid$(BANCS.OUTPARAM.acctOpenDate,0,10)
        CPLTM.GLBDATA.schmCode 		= BANCS.OUTPARAM.schmCode
        PRINT(CPLTM.GLBDATA.schmCode)
		print(CPLTM.GLBDATA.schmType)
		print(CPLTM.GLBDATA.cifId)
		print(CPLTM.GLBDATA.acctOpnDate)
    else
		CPLTM.GLBDATA.errMsg 		= "Invalid Debit Account Number "
        print(CPLTM.GLBDATA.errMsg)
        GOTO ERR_RES
	#}
	endif
	
	sv_c = CPLTM.GLBDATA.bbankCode + "|" + CPLTM.GLBDATA.bbrCode 
	sv_r = urhk_B2k_valBankBranchCode (sv_c)
    if (sv_r != 0) then
	#{
		##CPLTM.GLBDATA.errMsg 		= "Invalid Beneficiary Bank/Branch Codes" 
        ##print(CPLTM.GLBDATA.errMsg)
        ##GOTO ERR_RES
	#}
	endif
	
	sv_b = urhk_B2k_valCrncy(CPLTM.GLBDATA.refCrncy)
    if(sv_b != 0)THEN
	#{
		CPLTM.GLBDATA.errMsg 		= "Invalid Tran Currency Code"
        print(CPLTM.GLBDATA.errMsg)
        GOTO ERR_RES
	#}
	endif
	
	sv_b = urhk_B2k_valCrncy(CPLTM.GLBDATA.ChrgCrncy)
    if(sv_b != 0)THEN
	#{
		CPLTM.GLBDATA.errMsg 		= "Invalid Charge Currency Code"
        print(CPLTM.GLBDATA.errMsg)
        GOTO ERR_RES
	#}
	endif
	
	sv_c = CPLTM.GLBDATA.refAmt + "|" + CPLTM.GLBDATA.refCrncy 
	sv_r = urhk_B2k_validateAmtWithCrncy(sv_c)
	if(sv_r != 0)then
	#{
		CPLTM.GLBDATA.errMsg 		= "Invalid Tran Amount"
        print(CPLTM.GLBDATA.errMsg)
        GOTO ERR_RES
	#}
	endif
	
    sv_l = getposition(CPLTM.GLBDATA.refAmt,'.')
    if(sv_l > 0)then
	#{
        sv_k = sv_l - 1
        BANCS.INPUT.firstpart 		= mid$(CPLTM.GLBDATA.refAmt, 0,sv_k)
        BANCS.INPUT.secondpart 		= mid$(CPLTM.GLBDATA.refAmt, sv_l,2)
        sv_e = urhk_B2k_isStringNumeric(BANCS.INPUT.firstpart)
        if(sv_e != 0)then
		#{
			CPLTM.GLBDATA.errMsg 	= "Enter valid Amount" 
			print(CPLTM.GLBDATA.errMsg)
			GOTO ERR_RES
		#}
        endif
		
        sv_e = urhk_B2k_isStringNumeric(BANCS.INPUT.secondpart)
        if(sv_e != 0)then
		#{
			CPLTM.GLBDATA.errMsg 	= "Enter valid Amount" 
			print(CPLTM.GLBDATA.errMsg)
			GOTO ERR_RES
		#}
        endif
		
        CPLTM.GLBDATA.refAmt = BANCS.INPUT.firstpart + "." + BANCS.INPUT.secondpart
    else
        sv_e = urhk_B2k_isStringNumeric(CPLTM.GLBDATA.refAmt)
        if(sv_e != 0)then
		#{
			CPLTM.GLBDATA.errMsg 	= "Enter valid Amount" 
			print(CPLTM.GLBDATA.errMsg)
			GOTO ERR_RES
		#}
        endif
	#}
    endif
	
    sv_c = CPLTM.GLBDATA.ChrgAmt + "|" + CPLTM.GLBDATA.ChrgCrncy
    sv_r = urhk_B2k_validateAmtWithCrncy(sv_c)
    if(sv_r != 0)then
	#{
        CPLTM.GLBDATA.errMsg 		= "Invalid Charge Amount"
        print(CPLTM.GLBDATA.errMsg)
        GOTO ERR_RES
	#}
    endif
	
    sv_l = getposition(CPLTM.GLBDATA.ChrgAmt,'.')
    if(sv_l > 0)then
	#{
        sv_k = sv_l - 1
        BANCS.INPUT.firstpart 		= mid$(CPLTM.GLBDATA.ChrgAmt, 0,sv_k)
        BANCS.INPUT.secondpart 		= mid$(CPLTM.GLBDATA.ChrgAmt, sv_l,2)
        sv_e = urhk_B2k_isStringNumeric(BANCS.INPUT.firstpart)
        if(sv_e != 0)then
		#{
            CPLTM.GLBDATA.errMsg 	= "Enter valid Amount"
            print(CPLTM.GLBDATA.errMsg)
            GOTO ERR_RES
		#}
        ENDIf
        sv_e = urhk_B2k_isStringNumeric(BANCS.INPUT.secondpart)
        if(sv_e != 0)then
		#{
            CPLTM.GLBDATA.errMsg 	= "Enter valid Amount"
            print(CPLTM.GLBDATA.errMsg)
            GOTO ERR_RES
		#}
        endif
		
        CPLTM.GLBDATA.ChrgAmt = BANCS.INPUT.firstpart + "." + BANCS.INPUT.secondpart
    else
        sv_e = urhk_B2k_isStringNumeric(CPLTM.GLBDATA.ChrgAmt)
        if(sv_e != 0)then
		#{
            CPLTM.GLBDATA.errMsg 	= "Enter valid Charge Amount"
            print(CPLTM.GLBDATA.errMsg)
            GOTO ERR_RES
		#}
        endif
	#}
    endif

	if(cdouble(CPLTM.GLBDATA.refAmtLCY)<=100)then
	#{
		CPLTM.GLBDATA.errMsg = "Minimum Transaction Amount is 100.00 Ksh"
		print(CPLTM.GLBDATA.errMsg)
		GOTO ERR_RES
	#}
	endif
	if(cdouble(CPLTM.GLBDATA.refAmtLCY)>140000)then
	#{
		##CPLTM.GLBDATA.errMsg = "Maximum transaction limit exceeded 140000.00KSH"
		##print(CPLTM.GLBDATA.errMsg)
		##GOTO ERR_RES
	#}
	endif
	
	if(CPLTM.GLBDATA.pymntRefDate!="")then
	#{
		sv_r=urhk_B2k_valDate(CPLTM.GLBDATA.pymntRefDate)
		if(sv_r != 0)then
		#{
			CPLTM.GLBDATA.errMsg = "Invalid Payment Ref Date"
			print(CPLTM.GLBDATA.errMsg)
			GOTO ERR_RES
		#}
        endif
	#}
	endif
#}
endif

