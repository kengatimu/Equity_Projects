###### Getting Sender Details 
sv_u="senderaddress1,senderaddress2,sendercity,sendercountry,senderdob,senderemail,senderFname,senderMname,senderLname,SenderMobile,senderpostal,senderstate|"
sv_u= sv_u + " select distinct nvl(c.address_line1,'NAA'),  "
sv_u= sv_u + " nvl(c.address_line2,'NAA'),		"
sv_u= sv_u + " nvl((select ref_desc from tbaadm.rct where ref_code = c.city    and ref_rec_type='01' AND bank_id = '" + BANCS.STDIN.contextBankId + "' ),'NAA'),	"
sv_u= sv_u + " nvl((select ref_desc from tbaadm.rct where ref_code = c.country and ref_rec_type='03' AND bank_id = '" + BANCS.STDIN.contextBankId + "'),'NAA'),	"
sv_u= sv_u + " nvl(to_char(c.cust_dob,'YYYY-MM-DD'),'1900-01-01') ,	"
##sv_u= sv_u + " nvl(to_char(c.cust_dob,'DD-MM-YYYY'),'01-01-1900') ,	"
sv_u= sv_u + " nvl(c.email,'TEST@gmail.com') ,				"
sv_u= sv_u + " nvl(c.cust_first_name ,'NAA'),				"
sv_u= sv_u + " nvl(c.cust_middle_name ,' '),				"
sv_u= sv_u + " nvl(c.cust_last_name ,	'NAA'),				"
sv_u= sv_u + " nvl((select PHONENO from crmuser.PHONEEMAIL where PHONEEMAIL.orgkey=b.cif_id and phoneoremail='PHONE' and PREFERREDFLAG='Y'  and rownum <2),'1234567890'), "
sv_u= sv_u + " nvl((select ZIP from CRMUSER.address  where address.orgkey=b.cif_id and rownum <2),'123456') ,"
sv_u= sv_u + " c.state 				"
sv_u= sv_u + " from tbaadm.cmg a,tbaadm.gam b,crmuser.accounts c,tbaadm.bkc d"
sv_u= sv_u + " where b.foracid= ?SVAR "
sv_u= sv_u + " AND b.bank_id= ?SVAR "
sv_u= sv_u + " AND a.cust_id=b.cust_id "
sv_u= sv_u + " AND a.cif_id=c.orgkey "
sv_u= sv_u + " AND b.bank_id=d.bank_id  and rownum <2"
print(sv_u)
BANCS.INPARAM.BINDVARS = CPLTM.GLBDATA.Dracno + "|" +  BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_r =  urhk_dbSelectWithBind(sv_u)
print(sv_r)
IF(sv_r =="0") THEN
#{                                     
	CPLTM.GLBDATA.addrline1			    = BANCS.OUTPARAM.senderaddress1
	print(CPLTM.GLBDATA.addrline1)
