#----------------------------------------------------------------------------------------------------------
# Filename              :       ctodadp015.scr
# Author                :       Priya K
# Description           :       This is the script is to get  Availment request Id when account number is given.
# Input                 :       Account Id
# Output                :       Return availment req id
# Called Script         :       None
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           22-08-2013         Priya K		original Version          1.0
#-----------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="5ec0a80074efdf00b2a312f254b1421d32639651f0cd6f40ee1c31e411cc08cb"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CTODA") == 0) THEN
	#{
		CREATECLASS("CUST", "CTODA", 5)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#  Declaration of variables used in script
	#------------------------------------------------------------------------------
	CUST.CTODA.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.CTODA.bankId)
	CUST.CTODA.accNum = TRIM(BANCS.INPUT.accNum)
	print(CUST.CTODA.accNum)
	CUST.CTODA.recCount = "0"
	
	#------------------------------------------------------------------------------
	#  Fetching data  from table C_TODA
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.CTODA.bankId
	IF (CUST.CTODA.accNum != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accNum
	#}
	ENDIF
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "availReqId|"
	sv_s = sv_s + " SELECT REQUEST_ID"
	sv_s = sv_s + " FROM CUSTOM.C_TODA "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR "
	sv_s = sv_s + " AND ACCT_NUM = ?SVAR"
	sv_s = sv_s + " AND VERIFY_BY IS NULL"
	print(sv_s)
	sv_c = urhk_dbSelectWithBind(sv_s)
	IF (sv_c != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CTODA.availReqId = BANCS.OUTPARAM.availReqId
	print(CUST.CTODA.availReqId)
	
	sv_u = urhk_SetOrbOut("availReqId|"+CUST.CTODA.availReqId)
	print(sv_u)
	
	
	
	ENDOFSCRIPT:
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","CTODA") != 0) THEN
		#{
			DELETECLASS ("CUST","CTODA")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
