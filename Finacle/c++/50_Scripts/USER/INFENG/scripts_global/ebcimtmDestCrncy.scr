<--start
trace on
	#sv_u = urhk_B2K_PrintRepos("BANCS")
	#print(sv_u)

	if(repexists("CPLTM")==0)then
	#{
	    createrep("CPLTM")
	#}
	endif

	if(classexists("CPLTM","GLBDATA")==0)then
	#{
	    createclass("CPLTM","GLBDATA",5)
	#}
	endif

	if(fieldexists(BANCS.INPUT.benefCntryCode)==1)then
	#{
		CPLTM.GLBDATA.benefCntry = toupper(BANCS.INPUT.benefCntryCode)
	else
		CPLTM.GLBDATA.benefCntry = ""
	#}
	endif

	IF (CPLTM.GLBDATA.benefCntry !="") THEN
	#{
		if(CPLTM.GLBDATA.benefCntry=="UK")then
		#{
			CPLTM.GLBDATA.benefCntry = "GB"
		#}
		endif
		sv_s = "iso_cntry_code"
		sv_s = sv_s + "|"
		sv_s = sv_s + "select trim(iso_cntry_code) "
		sv_s = sv_s + " from custom.CUST_CIMTM_COUNTRY_TABLE "
		sv_s = sv_s + " WHERE fin_cntry_code = upper('"+ CPLTM.GLBDATA.benefCntry +"') "
		PRINT(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF (sv_d == "0") THEN
		#{
			print(CPLTM.GLBDATA.benefCntry)
			CPLTM.GLBDATA.benefCntry = BANCS.OUTPARAM.iso_cntry_code
			print(CPLTM.GLBDATA.benefCntry)
		#}
		ELSE
		#{
			CPLTM.GLBDATA.errMsg 		= "Error Occured" 
	        print(CPLTM.GLBDATA.errMsg)
			CPLTM.GLBDATA.ErrorFlg		= "Y"
	        exitscript	
		#}
		ENDIF	
	#}
	ENDIF
	
	sv_d = "tblcount | select count(*) "
	sv_d = sv_d + " from tbaadm.cnc "
	sv_d = sv_d + " where entity_cre_flg='Y' and del_flg='N' and (cntry_code like '%"+CPLTM.GLBDATA.benefCntry+"%' OR cntry_code='"+CPLTM.GLBDATA.benefCntry+"') AND bank_id='"+BANCS.STDIN.contextBankId+"'"
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
	#{
		BANCS.INPUT.tblcount = BANCS.OUTPARAM.tblcount
		print(BANCS.INPUT.tblcount)
	else
		BANCS.INPUT.tblcount = 0
		print(BANCS.INPUT.tblcount)
	#}
	endif
	
	#sv_h = urhk_SetOrbOut("recCount|" +BANCS.INPUT.tblcount)
	sv_s = "recordCount|"+BANCS.INPUT.tblcount
	sv_u = urhk_SetOrbOut(sv_s)


	sv_d = "crncy_code,crncy_name,cntry_code | select crncy_code,crncy_name,cntry_code "
	sv_d = sv_d + " from tbaadm.cnc "
	sv_d = sv_d + " where entity_cre_flg='Y' and del_flg='N' and (cntry_code like '%"+CPLTM.GLBDATA.benefCntry+"%' OR cntry_code='"+CPLTM.GLBDATA.benefCntry+"') AND bank_id='"+BANCS.STDIN.contextBankId+"'"
	print(sv_d)

	sv_c = urhk_dbCursorOpenWithBind(sv_d)
	
	if(sv_c==0)then
	#{
		BANCS.INPUT.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		BANCS.INPUT.cursorNum = ""
	#}
	endif
	
	sv_r = urhk_dbCursorFetch(BANCS.INPUT.cursorNum)
	print(sv_r)
	sv_z = 0
	sv_n = 1
	while(sv_r == 0)
	#{
			BANCS.INPUT.crncy_code	= BANCS.OUTPARAM.crncy_code
			BANCS.INPUT.crncy_name	= BANCS.OUTPARAM.crncy_name
			BANCS.INPUT.cntry_code	= BANCS.OUTPARAM.cntry_code

			BANCS.INPUT.count = sv_n
			
			if(BANCS.INPUT.crncy_code=="")then
			#{
				BANCS.INPUT.crncy_code = " "
			#}
			endif
			
			if(BANCS.INPUT.crncy_name=="")then
			#{
				BANCS.INPUT.crncy_name = " "
			#}
			endif

			if(BANCS.INPUT.cntry_code=="")then
			#{
				BANCS.INPUT.cntry_code = " "
			#}
			endif
			
			sv_s = "CurrencyCode_" + BANCS.INPUT.count + "|" + BANCS.INPUT.crncy_code 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "CurrencyName_" + BANCS.INPUT.count + "|" + BANCS.INPUT.crncy_name
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "CountryCode_" + BANCS.INPUT.count + "|" + BANCS.INPUT.cntry_code 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			if(sv_r == 0)then
			#{
				sv_r = urhk_dbCursorFetch(BANCS.INPUT.cursorNum)
			#}
			endif
			
			sv_n = sv_n + 1
			print(sv_n)
	#}
	do
        sv_r = urhk_dbCursorClose(BANCS.INPUT.cursorNum)
trace off
end-->
