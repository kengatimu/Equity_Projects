<--start
trace on
IF  (BANCS.INPUT.DccId == "FT")  THEN
        ##############################################################################################
        # For Cash Management Services the Field 43 should be populated to the Tran Particulars Field
        ##############################################################################################

        IF (BANCS.INPUT.DccId == "FT") THEN
                IF (FIELDEXISTS(BANCS.INPUT.CardAcceptorName) != 0) THEN
                        BANCS.OUTPUT.TranParticulars  = RIGHT$(BANCS.INPUT.CustCardId, 4) + BANCS.INPUT.CardAcceptorName
                ENDIF
        ENDIF

        ##############################################################################################
        # For FINACLE TREASURY CUSTOMISATION ---
        ##############################################################################################

        sv_a = BANCS.INPUT.Command
        sv_b = BANCS.INPUT.PartTranType
        sv_x = BANCS.INPUT.DeviceId
        print(sv_x)
        sv_y = BANCS.INPUT.DccId
        print(sv_y)
        sv_z = BANCS.INPUT.ReservedField1
        sv_d = BANCS.INPUT.SerialNum
        sv_p = ""
        IF (FIELDEXISTS(BANCS.INPUT.Foracid)) THEN
                sv_f = BANCS.INPUT.Foracid
                print(sv_f)
        ELSE
                sv_f = ""
                print(sv_f)
        ENDIF
        IF (FIELDEXISTS(BANCS.INPUT.CrForacid)) THEN
                sv_c = BANCS.INPUT.CrForacid
                print(sv_c)
        ELSE
                sv_c = ""
                print(sv_c)
        ENDIF
        if ( BANCS.INPUT.DccId == "FT" ) then
                sv_t = BANCS.INPUT.ReservedField3
                sv_c = trim(sv_t)
                sv_l = strlen(sv_c)
                sv_u = mid$(trim(sv_c),0,3)

                        if (sv_u != "AEP")  then
                                        sv_p = getposition(sv_c,"DEAL_NUM=")
                                        print (sv_p)
                                        sv_q = ltrim(mid$(sv_c,(sv_p+8),8))
                                        print (sv_q)
                                        sv_p=getposition(sv_c,"DEAL_TYPE=")
                                        print (sv_p)
                                        sv_v=getposition(sv_c,"|DEAL_NUM")
                                        print (sv_v)
                                        sv_w=ltrim(mid$(sv_c,(sv_p+9),(sv_v-sv_p)))
                                        print (sv_w)
                                        sv_x=sv_q+"-"
                                        print (sv_x)

                                        sv_x="FT-"+sv_x
                                        print (sv_x)
                                        #####Section for adding status in case of deleted deals##########
                                BANCS.OUTPUT.TranParticulars=sv_x
                                #BANCS.OUTPUT.RefNum=sv_q
                                BANCS.OUTPUT.successOrFailure="S"
                                BANCS.OUTPUT.TranRemarks=sv_x
                        endif

        ###################################
        ## To remove pipe from the Tran Particulars, Tran Remarks & RefNum for FT Txns
        ##### Tran Particulars #####

                sv_x = BANCS.OUTPUT.TranParticulars
                sv_y = STRLEN(sv_x)
                sv_z = GETPOSITION(sv_x, "|")
                sv_w = ""
                WHILE ((sv_y > 0) AND (sv_z > 0))
                        sv_w = MID$(sv_x, 0, sv_z-1) + "/" + MID$(sv_x, sv_z, sv_y-sv_z)
                        sv_x = sv_w
                        sv_y = STRLEN(sv_x)
                        sv_z = GETPOSITION(sv_x, "|")
                        sv_v = "2"
                DO
                BANCS.OUTPUT.TranParticulars = sv_x

        ##### Tran Remarks #####
                sv_x = BANCS.OUTPUT.TranRemarks
                sv_y = STRLEN(sv_x)
                sv_z = GETPOSITION(sv_x, "|")
                sv_w = ""
                WHILE ((sv_y > 0) AND (sv_z > 0))
                        sv_w = MID$(sv_x, 0, sv_z-1) + "/" + MID$(sv_x, sv_z, sv_y-sv_z)
                        sv_x = sv_w
                        sv_y = STRLEN(sv_x)
                        sv_z = GETPOSITION(sv_x, "|")
                        sv_v = "2"
                DO
                BANCS.OUTPUT.TranRemarks = sv_x
        endif
ENDIF
##trace off
end-->
