<--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
	
	####################################################################
	# VARIABLE INITAILIZATION
	####################################################################
	
		CUST.INTERFACE.EFM_USER_FLG  = ""
		CUST.INTERFACE.EFM_REMARKS  = ""
		CUST.INTERFACE.CORE_USER_FLG  = ""
		CUST.INTERFACE.CORE_REMARKS  = ""
		CUST.INTERFACE.SSO_USER_FLG  = ""
		CUST.INTERFACE.SSO_REMARKS  = ""
		CUST.INTERFACE.CRM_USER_FLG  = ""
		CUST.INTERFACE.CRM_REMARKS  = ""
		CUST.INTERFACE.SVS_USER_FLG  = ""
		CUST.INTERFACE.SVS_REMARKS  = ""
		CUST.INTERFACE.RI_USER_FLG  = ""
		CUST.INTERFACE.RI_REMARKS  = ""		
		CUST.INTERFACE.RCRE_USERID  = ""
		CUST.INTERFACE.RCRE_TIME  = ""
		CUST.INTERFACE.LCHG_USERID  = ""
		CUST.INTERFACE.LCHG_TIME  = ""
		CUST.INTERFACE.API_NAME  = "FinacleUserAdd"
		
			
	
	
	####################################################################
	# USERiD - VALIDATION
	####################################################################
	
	IF(CUST.INTERFACE.EMP_ID_CUSTOM == "Y")THEN
	#{
		#GET DATA FROM TABLE AND WRK ACC
		
		sv_a = "c_user|SELECT COUNT(1) FROM "
		sv_a = sv_a + " CUSTOM.C_FINACLEUSER_STATUS_TBL WHERE USER_ID = ?SVAR  AND EMP_ID = ?SVAR AND API_NAME = 'FinacleUserAdd'"
	
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID 
		
		sv_d = urhk_dbSelectWithBind(sv_a)
		
		IF(sv_d == 0) THEN
		#{
			 CUST.INTERFACE.c_user  = BANCS.OUTPARAM.c_user
		#}
		ELSE
		#{
			
			GOTO USERID_CORE
		
		#}
		ENDIF
		
		IF(CUST.INTERFACE.c_user != "0") THEN
		#{
			IF(CUST.INTERFACE.c_user != "1")THEN
			#{
				
				sv_a = "UserAdd_Val.Status_UserId|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.ErrorMessage_UserId|could not complete userId validation due to ambiguity in custom table"
				sv_u = urhk_SetOrbOut(sv_b)
				EXITSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
			IF(CINT(CUST.INTERFACE.c_user) != 0)THEN
			#{
				sv_a = "USER_ID,EMP_ID,BANK_ID,API_NAME,EFM_USER_FLG,EFM_REMARKS,CORE_USER_FLG,CORE_REMARKS,SSO_USER_FLG,"
				sv_a = sv_a + "SSO_REMARKS,CRM_USER_FLG,CRM_REMARKS,SVS_USER_FLG,SVS_REMARKS,RI_USER_FLG,RI_REMARKS,LCHG_USER_ID,LCHG_TIME,RCRE_USER_ID,RCRE_TIME|"
				sv_a = sv_a + "SELECT USER_ID,EMP_ID,BANK_ID,API_NAME,EFM_USER_FLG,EFM_REMARKS,CORE_USER_FLG,CORE_REMARKS,SSO_USER_FLG,"
				sv_a = sv_a + "SSO_REMARKS,CRM_USER_FLG,CRM_REMARKS,SVS_USER_FLG,SVS_REMARKS,RI_USER_FLG,RI_REMARKS,LCHG_USER_ID,LCHG_TIME,RCRE_USER_ID,RCRE_TIME "
				sv_a = sv_a + " FROM CUSTOM.C_FINACLEUSER_STATUS_TBL WHERE USER_ID = ?SVAR AND EMP_ID = ?SVAR AND API_NAME = ?SVAR"
			
				BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.API_NAME
				sv_d = urhk_dbSelectWithBind(sv_a)
				
				IF(sv_d == 0) THEN
				#{
					CUST.INTERFACE.EFM_USER_FLG  = BANCS.OUTPARAM.EFM_USER_FLG
					CUST.INTERFACE.EFM_REMARKS  = BANCS.OUTPARAM.EFM_REMARKS
					CUST.INTERFACE.CORE_USER_FLG  = BANCS.OUTPARAM.CORE_USER_FLG
					CUST.INTERFACE.CORE_REMARKS  = BANCS.OUTPARAM.CORE_REMARKS
					CUST.INTERFACE.SSO_USER_FLG  = BANCS.OUTPARAM.SSO_USER_FLG
					CUST.INTERFACE.SSO_REMARKS  = BANCS.OUTPARAM.SSO_REMARKS
					CUST.INTERFACE.CRM_USER_FLG  = BANCS.OUTPARAM.CRM_USER_FLG
					CUST.INTERFACE.CRM_REMARKS  = BANCS.OUTPARAM.CRM_REMARKS
					CUST.INTERFACE.SVS_USER_FLG  = BANCS.OUTPARAM.SVS_USER_FLG
					CUST.INTERFACE.SVS_REMARKS  = BANCS.OUTPARAM.SVS_REMARKS
					CUST.INTERFACE.RI_USER_FLG  = BANCS.OUTPARAM.RI_USER_FLG
					CUST.INTERFACE.RI_REMARKS  = BANCS.OUTPARAM.RI_REMARKS
					CUST.INTERFACE.RCRE_USERID  = BANCS.OUTPARAM.RCRE_USERID
					CUST.INTERFACE.RCRE_TIME  = BANCS.OUTPARAM.RCRE_TIME
					CUST.INTERFACE.LCHG_USERID  = BANCS.OUTPARAM.LCHG_USERID
					CUST.INTERFACE.LCHG_TIME  = BANCS.OUTPARAM.LCHG_TIME
				#}
				ELSE
				#{
					sv_a = "UserAdd_Val.Status_UserId|ERROR"
					sv_u = urhk_SetOrbOut(sv_a)	
					sv_b = "UserAdd_Val.ErrorMessage_UserId|could not complete userId validation"
					sv_u = urhk_SetOrbOut(sv_b)
					EXITSCRIPT
				#}
				ENDIF
				
				IF(CUST.INTERFACE.EFM_USER_FLG == "SUCCESS")THEN
				#{
					IF(CUST.INTERFACE.CORE_USER_FLG == "SUCCESS")THEN
					#{
						IF(CUST.INTERFACE.SSO_USER_FLG == "SUCCESS")THEN
						#{
							IF(CUST.INTERFACE.CRM_USER_FLG != "SUCCESS")THEN
							#{
								GOTO USERID_CRM
							#}
							ENDIF
						#}
						ELSE
						#{
							GOTO USERID_SSO 
						#}
						ENDIF
					#}
					ELSE
					#{
						GOTO USERID_CORE
					#}
					ENDIF
				#}
				ELSE
				#{
					GOTO USERID_EFM
				#}
				ENDIF
			 
			#}
			ENDIF
		
		#}
		ENDIF
		
	#}
	ELSE
	#{
		IF(CUST.INTERFACE.EMP_ID_PRODUCT == "Y")THEN
		#{
			GOTO USERID_CORE
		#}
		ELSE
		#{
			GOTO USERID_EFM
		#}
		ENDIF
	#}
	ENDIF
	
	USERID_EFM:
		
		sv_s = "c_empId|SELECT COUNT(1) FROM TBAADM.GET WHERE EMP_ID = ?SVAR AND SOL_ID = ?SVAR AND DEL_FLG ='N'"
		
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.SolID 
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF(sv_d == 0)THEN
		#{
			CUST.INTERFACE.c_empId = BANCS.OUTPARAM.c_empId
			IF(CUST.INTERFACE.c_empId != "0")THEN
			#{
				CUST.INTERFACE.EMP_ID_PRODUCT = "Y"
				CUST.INTERFACE.EFM_EXISTS = "Y"
				PRINT("EMPLOYEE ID already exists")
				
				sv_a = "UserAdd_Val.EmployeeID_Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.EmployeeID_ErrorMessage|"+CUST.INTERFACE.EmployeeID+ " already exists"
				sv_u = urhk_SetOrbOut(sv_b)
				
				#GOTO USERID_CORE
				
			#}
			ENDIF
		#}
		ELSE
		#{
			PRINT("EMPLOYEE ID validation could not be processed ")
			sv_a = "UserAdd_Val.EmployeeID_Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.EmployeeID_ErrorMessage|"+"EMPLOYEE ID validation could not be processed "
			sv_u = urhk_SetOrbOut(sv_b)
			#EXITSCRIPT
		#}
		ENDIF
		
		
	USERID_CORE:
	
		sv_s = "c_userId|SELECT COUNT(1) FROM TBAADM.UPR WHERE USER_ID = ?SVAR AND SOL_ID = ?SVAR AND DEL_FLG ='N'"
		
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.SolID 
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF(sv_d == 0)THEN
		#{
			CUST.INTERFACE.c_userId = BANCS.OUTPARAM.c_userId
			IF(CUST.INTERFACE.c_userId != "0")THEN
			#{
				CUST.INTERFACE.USER_ID_PRODUCT_CORE = "Y"
				CUST.INTERFACE.CORE_EXISTS = "Y"
				PRINT("USER ID already exists")
				
				sv_a = "UserAdd_Val.CORE_USER_ID_Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.CORE_USER_ID_ErrorMessage|"+CUST.INTERFACE.userId+ " already exists"
				sv_u = urhk_SetOrbOut(sv_b)
				
				
				
			#}
			ENDIF
		#}
		ELSE
		#{
			PRINT("USER ID validation could not be processed ")
			sv_a = "UserAdd_Val.CORE_USER_ID_Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.CORE_USER_ID_ErrorMessage|"+"USER ID validation could not be processed "
			sv_u = urhk_SetOrbOut(sv_b)
			#EXITSCRIPT
		#}
		ENDIF
		
	USERID_SSO:
	
		sv_s = "c_userId|SELECT COUNT(1) FROM SSOADM.USER_PROFILE_TBL WHERE USER_ID = ?SVAR AND DEL_FLG ='N'"
		
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF(sv_d == 0)THEN
		#{
			CUST.INTERFACE.c_userId = BANCS.OUTPARAM.c_userId
			IF(CUST.INTERFACE.c_userId != "0")THEN
			#{
				CUST.INTERFACE.USER_ID_PRODUCT_SSO = "Y"
				CUST.INTERFACE.SSO_EXISTS = "Y"
				PRINT("USER ID already exists")
				
				sv_a = "UserAdd_Val.SSO_USER_ID_Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.SSO_USER_ID_ErrorMessage|"+CUST.INTERFACE.userId+ " already exists"
				sv_u = urhk_SetOrbOut(sv_b)
				
				
				
			#}
			ENDIF
		#}
		ELSE
		#{
			PRINT("USER ID validation could not be processed ")
			sv_a = "UserAdd_Val.SSO_USER_ID_Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.SSO_USER_ID_ErrorMessage|"+"USER ID validation could not be processed "
			sv_u = urhk_SetOrbOut(sv_b)
			#EXITSCRIPT
		#}
		ENDIF
	
	USERID_CRM:
	
		sv_s = "c_userId|SELECT COUNT(1) FROM CRMUSER.USERS WHERE LOGINID = ?SVAR AND ACTIVE = 'Y'"
		
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.loginId
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF(sv_d == 0)THEN
		#{
			CUST.INTERFACE.c_userId = BANCS.OUTPARAM.c_userId
			IF(CUST.INTERFACE.c_userId != "0")THEN
			#{
				CUST.INTERFACE.USER_ID_PRODUCT_CRM = "Y"
				CUST.INTERFACE.CRM_EXISTS = "Y"
				PRINT("USER ID already exists")
				
				sv_a = "UserAdd_Val.CRM_USER_ID_Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.CRM_USER_ID_ErrorMessage|"+CUST.INTERFACE.userId+ " already exists"
				sv_u = urhk_SetOrbOut(sv_b)
				
				
				
			#}
			ENDIF
		#}
		ELSE
		#{
			PRINT("USER ID validation could not be processed ")
			sv_a = "UserAdd_Val.CRM_USER_ID_Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.CRM_USER_ID_ErrorMessage|"+"USER ID validation could not be processed "
			sv_u = urhk_SetOrbOut(sv_b)
			#EXITSCRIPT
		#}
		ENDIF
		
	USERID_RI:
	
		IF(CUST.INTERFACE.RI_USER_FLG != "SUCCESS")THEN
		#{
		
			sv_s = "c_userId|SELECT COUNT(1) FROM FINRIADM.UDT WHERE UPPER(USER_ID) = UPPER(?SVAR) AND  BANK_ID = ?SVAR"
			
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId + "|" + CUST.INTERFACE.bank_id
			
			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			
			IF(sv_d == 0)THEN
			#{
				CUST.INTERFACE.c_userId = BANCS.OUTPARAM.c_userId
				IF(CUST.INTERFACE.c_userId != "0")THEN
				#{
					CUST.INTERFACE.USER_ID_PRODUCT_RI = "Y"
					CUST.INTERFACE.RI_EXISTS = "Y"
					PRINT("USER ID already exists")
					
					sv_a = "UserAdd_Val.RI_USER_ID_Status|ERROR"
					sv_u = urhk_SetOrbOut(sv_a)	
					sv_b = "UserAdd_Val.RI_USER_ID_ErrorMessage|"+CUST.INTERFACE.userId+ " already exists"
					sv_u = urhk_SetOrbOut(sv_b)
					
					
					
				#}
				ENDIF
			#}
			ELSE
			#{
				PRINT("USER ID validation could not be processed ")
				sv_a = "UserAdd_Val.RI_USER_ID_Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.RI_USER_ID_ErrorMessage|"+"USER ID validation could not be processed "
				sv_u = urhk_SetOrbOut(sv_b)
				#EXITSCRIPT
			#}
			ENDIF
	
		
		#}
		ENDIF
		
		
	USERID_SVS:
	
		IF(CUST.INTERFACE.SVS_USER_FLG != "SUCCESS")THEN
		#{
		
			sv_s = "c_userId|SELECT COUNT(1) FROM SVSUSER.USERMASTER WHERE USERNAME = ?SVAR AND DELETED = 'N' AND VERIFIED = 'Y'"
			
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId
			
			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			
			IF(sv_d == 0)THEN
			#{
				CUST.INTERFACE.c_userId = BANCS.OUTPARAM.c_userId
				IF(CUST.INTERFACE.c_userId != "0")THEN
				#{
					CUST.INTERFACE.USER_ID_PRODUCT_SVS = "Y"
					CUST.INTERFACE.SVS_EXISTS = "Y"	
					PRINT("USER ID already exists")
					
					sv_a = "UserAdd_Val.SVS_USER_ID_Status|ERROR"
					sv_u = urhk_SetOrbOut(sv_a)	
					sv_b = "UserAdd_Val.SVS_USER_ID_ErrorMessage|"+CUST.INTERFACE.userId+ " already exists"
					sv_u = urhk_SetOrbOut(sv_b)
					
					
					
				#}
				ENDIF
			#}
			ELSE
			#{
				PRINT("USER ID validation could not be processed ")
				sv_a = "UserAdd_Val.SVS_USER_ID_Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "UserAdd_Val.SVS_USER_ID_ErrorMessage|"+"USER ID validation could not be processed "
				sv_u = urhk_SetOrbOut(sv_b)
				#EXITSCRIPT
			#}
			ENDIF

	
		
		#}
		ENDIF
		
	
		#TRACE OFF
END-->