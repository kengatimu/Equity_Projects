<--START
CHECKSUM="abbf0646dd560636dad9f646dd926eff45b37e5b18783f36d54ec5e6794bc291"
	trace on
	
	#call("astclsdp000.scr")
	
	#------------------------------------------------------------------------
	# Create required repositories
	#------------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
