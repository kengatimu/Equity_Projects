	print(BANCS.INPUT.mainClassificationSystem)
	print(BANCS.INPUT.subClassificationSystem)
	print(BANCS.INPUT.mainClassificationUser)
	print(BANCS.INPUT.subClassificationUser)
	print(BANCS.INPUT.setupMainClassificationSystem)
	print(BANCS.INPUT.setupSubClassificationSystem)
	print(BANCS.INPUT.liability)
	print(BANCS.INPUT.foracid)
	
	CUST.ASSETS.mainClassificationSystem = BANCS.INPUT.setupMainClassificationSystem
	CUST.ASSETS.subClassificationSystem = BANCS.INPUT.setupSubClassificationSystem
	
	#-------------------------------------------------------------------------
	#Fetch the intereset and non interest overdue periods
	#----------------------------------------------------------------------------
	BANCS.INPARAM.b2kId=BANCS.INPUT.b2kId
	BANCS.INPARAM.b2kType= BANCS.INPUT.b2kType
	BANCS.INPARAM.schmType = BANCS.INPUT.schmType
