	print(CUST.ASSETS.nonIntOverduePeriod)
	print(CUST.ASSETS.intOverduePeriod)
	
	IF(BANCS.INPUT.b2kType != "ACCNT") THEN
	#{
		CUST.ASSETS.mainClassificationSystem = BANCS.INPUT.setupMainClassificationSystem
		CUST.ASSETS.subClassificationSystem = BANCS.INPUT.setupSubClassificationSystem
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------
	# Initializing variables
	#------------------------------------------------------------------------
	CUST.ASSETS.mainClassificationUser = BANCS.INPUT.mainClassificationUser
	CUST.ASSETS.subClassificationUser = BANCS.INPUT.subClassificationUser
	CUST.ASSETS.mainClassificationSystem = BANCS.INPUT.mainClassificationSystem
	CUST.ASSETS.subClassificationSystem = BANCS.INPUT.subClassificationSystem
	CUST.ASSETS.mainClassificationSystem1 = CUST.ASSETS.mainClassificationSystem
	CUST.ASSETS.subClassificationSystem1 = CUST.ASSETS.subClassificationSystem
