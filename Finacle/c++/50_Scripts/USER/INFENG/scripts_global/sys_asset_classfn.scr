	CUST.ASSETS.upgradeNrmlPrd = ""
	CUST.ASSETS.upgradeWatchPrd = ""
	CUST.ASSETS.getWatchUpgrDate = "N"
	CUST.ASSETS.getNrmlUpgrDate = "N"
	CUST.ASSETS.lastAdjDate = ""
