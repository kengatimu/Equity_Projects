	sv_s=sv_s + "TBA_REFERENCE_CODE_TBL.BANK_ID = ?SVAR  AND  (1=1)  AND REF_REC_TYPE = '01' AND DEL_FLG = 'N' ORDER BY REF_CODE"
	print(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_v = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_v)	

	IF(sv_v == 0) THEN
       	 #{
        	CUST.CSEG.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       		print(CUST.CSEG.CURSOR_NUMBER)
       		sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
        	print(sv_b)
		BANCS.INPUT.RECCOUNT = CINT("1")
        	print(BANCS.INPUT.RECCOUNT)

		sv_i=1
		print(sv_i)

		WHILE(sv_b == "0")
        	#{
			CUST.CSEG.CODE= BANCS.OUTPARAM.REF_CODE
			print(CUST.CSEG.CODE)

			CUST.CSEG.DESC= BANCS.OUTPARAM.REF_DESC
			print(CUST.CSEG.DESC)

			sv_s="CITYCODE_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.CODE
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="CITYDESC_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.DESC
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)


       			GOTO NEXTREC

      			BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
        		PRINT(BANCS.INPUT.RECCOUNT)

        		NEXTREC:
			sv_i = sv_i + 1 
       			sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
       			print(sv_b)
		#}
		DO
	#}
	ENDIF
ENDOFSCRIPT:
