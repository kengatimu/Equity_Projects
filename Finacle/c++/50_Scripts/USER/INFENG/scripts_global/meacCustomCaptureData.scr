						###########################################################
						
					sv_q = ""
                        sv_q = sv_q + "NRML_INTEREST_AMOUNT_DR, NRML_BOOKED_AMOUNT_DR, NRML_ACCRUED_AMOUNT_DR,"
                        sv_q = sv_q + "PENAL_ACCRUED_AMOUNT_DR,PENAL_BOOKED_AMOUNT_DR,PENAL_INTEREST_AMOUNT_DR,"
                        sv_q = sv_q + "NRML_INT_SUSPENSE_AMT_DR, PENAL_INT_SUSPENSE_AMT_DR|SELECT NRML_INTEREST_AMOUNT_DR,NRML_BOOKED_AMOUNT_DR, NRML_ACCRUED_AMOUNT_DR, "
                        sv_q = sv_q + "PENAL_ACCRUED_AMOUNT_DR,PENAL_BOOKED_AMOUNT_DR,PENAL_INTEREST_AMOUNT_DR,NRML_INT_SUSPENSE_AMT_DR, PENAL_INT_SUSPENSE_AMT_DR FROM TBAADM.EIT "
                        sv_q = sv_q + "WHERE ENTITY_ID = ?SVAR AND ENTITY_TYPE = 'ACCNT' AND BANK_ID = ?SVAR "	
						BANCS.INPARAM.BINDVARS = CUST.MEAC.acid +"|"+ BANCS.STDIN.contextBankId
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
						IF(sv_b == 0)THEN
						#{
						
							PRINT(BANCS.OUTPARAM.NRML_INTEREST_AMOUNT_DR)
                                			PRINT(BANCS.OUTPARAM.NRML_BOOKED_AMOUNT_DR)
                                			PRINT(BANCS.OUTPARAM.NRML_ACCRUED_AMOUNT_DR)
                                			PRINT(BANCS.OUTPARAM.PENAL_ACCRUED_AMOUNT_DR)
                                			PRINT(BANCS.OUTPARAM.PENAL_BOOKED_AMOUNT_DR)
                                			PRINT(BANCS.OUTPARAM.PENAL_INTEREST_AMOUNT_DR)
                                			PRINT(BANCS.OUTPARAM.NRML_INT_SUSPENSE_AMT_DR)
                                			PRINT(BANCS.OUTPARAM.PENAL_INT_SUSPENSE_AMT_DR)

                                			CUST.MEAC.NRML_INTEREST_AMOUNT_DR = BANCS.OUTPARAM.NRML_INTEREST_AMOUNT_DR
                                			CUST.MEAC.NRML_BOOKED_AMOUNT_DR = BANCS.OUTPARAM.NRML_BOOKED_AMOUNT_DR
                                			CUST.MEAC.NRML_ACCRUED_AMOUNT_DR = BANCS.OUTPARAM.NRML_ACCRUED_AMOUNT_DR
                                			CUST.MEAC.PENAL_ACCRUED_AMOUNT_DR = BANCS.OUTPARAM.PENAL_ACCRUED_AMOUNT_DR
                                			CUST.MEAC.PENAL_BOOKED_AMOUNT_DR = BANCS.OUTPARAM.PENAL_BOOKED_AMOUNT_DR
                                			CUST.MEAC.PENAL_INTEREST_AMOUNT_DR = BANCS.OUTPARAM.PENAL_INTEREST_AMOUNT_DR
                                			CUST.MEAC.NRML_INT_SUSPENSE_AMT_DR = BANCS.OUTPARAM.NRML_INT_SUSPENSE_AMT_DR
                                			CUST.MEAC.PENAL_INT_SUSPENSE_AMT_DR = BANCS.OUTPARAM.PENAL_INT_SUSPENSE_AMT_DR	
							#}
						ELSE
							#{
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						#############################################################
						# getting outStanding Amt from LRH
						###########################################################
						
						sv_q = ""
						sv_q = sv_q + "capIntAmt|SELECT CAPITALIZED_INT_AMOUNT FROM TBAADM.LRH "
						sv_q = sv_q + "WHERE ACID = ?SVAR AND SHDL_TYPE = 'R' AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N' AND BANK_ID = ?SVAR "
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.acid +"|"+ BANCS.STDIN.contextBankId
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
						IF(sv_b == 0)THEN
						#{
							PRINT(BANCS.OUTPARAM.capIntAmt)
							
							CUST.MEAC.capIntAmt = BANCS.OUTPARAM.capIntAmt
							
							#}
						ELSE
							#{
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						#######################################################
						#getting classification details from ACD
						########################################################
						
						sv_q = ""
						sv_q = sv_q + "mainClsfnSys,subClsfnSys,mainClsfnUser,subClsfnUser|SELECT MAIN_CLASSIFICATION_SYSTEM, SUB_CLASSIFICATION_SYSTEM, MAIN_CLASSIFICATION_USER, SUB_CLASSIFICATION_USER FROM TBAADM.ACD "
						sv_q = sv_q + "WHERE b2k_type = 'ACCNT' AND B2K_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N' AND BANK_ID = ?SVAR "
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.acid +"|"+ BANCS.STDIN.contextBankId
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
