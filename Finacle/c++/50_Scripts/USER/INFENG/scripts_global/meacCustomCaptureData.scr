		IF (sv_a == 0) THEN
		#{
			CUST.MEAC.foracid = BANCS.OUTPARAM.srvValue
			PRINT(CUST.MEAC.foracid)
		#}
		ENDIF
		
		#############################################################
		# getting values for the account
		###########################################################
		sv_q = ""
		sv_q = sv_q + "schmCode,schmType,ccyCode,sol, acid|select SCHM_CODE, SCHM_TYPE, ACCT_CRNCY_CODE, SOL_ID, ACID FROM TBAADM.GAM "
		sv_q = sv_q + "WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR "
		
		BANCS.INPARAM.BINDVARS = CUST.MEAC.foracid +"|"+ BANCS.STDIN.contextBankId
		
		PRINT(sv_q)
		
		sv_b = urhk_dbSelectWithBind(sv_q)
		
		PRINT(sv_b)
		
		IF(sv_b == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.schmCode)
			PRINT(BANCS.OUTPARAM.schmType)
			PRINT(BANCS.OUTPARAM.ccyCode)
			PRINT(BANCS.OUTPARAM.sol)
			PRINT(BANCS.OUTPARAM.acid)
			
			CUST.MEAC.solId = BANCS.OUTPARAM.sol
			CUST.MEAC.repaySchmCode = BANCS.OUTPARAM.schmCode
			CUST.MEAC.schmType = BANCS.OUTPARAM.schmType
			CUST.MEAC.repayCcyCode = BANCS.OUTPARAM.ccyCode
