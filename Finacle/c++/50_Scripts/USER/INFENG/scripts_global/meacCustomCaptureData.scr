						#{
							PRINT(BANCS.OUTPARAM.mainClsfnSys)
							PRINT(BANCS.OUTPARAM.subClsfnSys)
							PRINT(BANCS.OUTPARAM.mainClsfnUser)
							PRINT(BANCS.OUTPARAM.subClsfnUser)
							
							CUST.MEAC.mainClsfnSys = BANCS.OUTPARAM.mainClsfnSys
							CUST.MEAC.subClsfnSys = BANCS.OUTPARAM.subClsfnSys
							CUST.MEAC.mainClsfnUser = BANCS.OUTPARAM.mainClsfnUser
							CUST.MEAC.subClsfnUser = BANCS.OUTPARAM.subClsfnUser
							
							#}
						ELSE
							#{
							GOTO ENDOFSCRIPT
						#}
						ENDIF
				
				#############################################################
				# getting values from GAC
				###########################################################
				
				sv_q = ""
				sv_q = sv_q + "pdFlg,dpdCntr|SELECT PD_FLG, DPD_CNTR FROM TBAADM.GAC "
