						sv_b = urhk_dbSQLWithBind(sv_q)
						
						PRINT(sv_b)
						
						IF(sv_b == 0)THEN
						#{
							PRINT("insert successful")
							sv_b= urhk_dbSqlWithBind("COMMIT")
