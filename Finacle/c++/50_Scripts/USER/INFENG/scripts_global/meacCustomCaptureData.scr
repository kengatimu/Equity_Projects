					###########################################################
					
					IF(CUST.MEAC.pdFlg == "Y")THEN
					#{
						
						#############################################################
						# getting values from COT
						###########################################################
						
						sv_q = ""
						sv_q = sv_q + "intSuspAmt,penalIntSuspAmt|SELECT INT_SUSPENSE_AMT, PENAL_INT_SUSPENSE_AMT FROM TBAADM.COT "
						sv_q = sv_q + "WHERE ACID = ?SVAR AND BANK_ID = ?SVAR "
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.acid +"|"+ BANCS.STDIN.contextBankId
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
						IF(sv_b == 0)THEN
						#{
							PRINT(BANCS.OUTPARAM.intSuspAmt)
							PRINT(BANCS.OUTPARAM.penalIntSuspAmt)
							
							CUST.MEAC.intSuspAmt = BANCS.OUTPARAM.intSuspAmt
							CUST.MEAC.penalIntSuspAmt = BANCS.OUTPARAM.penalIntSuspAmt
							
							#}
						ELSE
							#{
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						
						###################################################################
						# getting interest suspence bacid from AIP for given scheme code
						###################################################################
						
						sv_q = ""
						sv_q = sv_q + "intSuspBacid|SELECT distinct INT_SUSP_BACID FROM TBAADM.AIP "
						sv_q = sv_q + "WHERE b2k_type = 'ACCNT' AND SCHM_CODE = ?SVAR AND BANK_ID = ?SVAR AND INT_SUSP_BACID is not null"
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.repaySchmCode +"|"+ BANCS.STDIN.contextBankId
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
						IF(sv_b == 0)THEN
						#{
							PRINT(BANCS.OUTPARAM.intSuspBacid)
							
							CUST.MEAC.intSuspBacid = BANCS.OUTPARAM.intSuspBacid
							#}
						ELSE
							#{
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						###################################################################
						# getting interest suspence account from GAM for fetched bacid
						###################################################################
						
						sv_q = ""
						sv_q = sv_q + "suspForacid,suspAcid|SELECT FORACID,ACID FROM TBAADM.GAM "
						sv_q = sv_q + "WHERE BACID = ?SVAR AND SOL_ID = ?SVAR AND acct_CRNCY_CODE = ?SVAR AND BANK_ID = ?SVAR"
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.intSuspBacid +"|"+ CUST.MEAC.solId +"|"+ CUST.MEAC.repayCcyCode +"|"+ BANCS.STDIN.contextBankId
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
						IF(sv_b == 0)THEN
						#{
							PRINT(BANCS.OUTPARAM.suspForacid)
							PRINT(BANCS.OUTPARAM.suspAcid)
							
							CUST.MEAC.suspForacid = BANCS.OUTPARAM.suspForacid
							CUST.MEAC.suspAcid = BANCS.OUTPARAM.suspAcid
							
							#}
						ELSE
							#{
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						
						
						############################################################
						# getting CRAmt from ACPART
						###########################################################
						
						sv_q = ""
						sv_q = sv_q + "crAmt|SELECT SUM(TRAN_AMT) FROM TBAADM.ACPART "
						sv_q = sv_q + "WHERE PART_TRAN_TYPE = 'C' "
						sv_q = sv_q + "AND PARTITIONED_ACID  = ?SVAR AND BANK_ID = ?SVAR "
						sv_q = sv_q + "AND b2k_type = 'ACCNT' AND b2k_id = ?SVAR AND PSTD_FLG = 'Y' "
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.suspAcid +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.MEAC.acid
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
						IF(sv_b == 0)THEN
						#{
							PRINT(BANCS.OUTPARAM.crAmt)
							
							CUST.MEAC.crAmt = BANCS.OUTPARAM.crAmt
							
							#}
						ELSE
							#{
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						
						#############################################################
						# getting DrAmt from ACPART
						###########################################################
						
						sv_q = ""
						sv_q = sv_q + "drAmt|SELECT SUM(TRAN_AMT) FROM TBAADM.ACPART "
						sv_q = sv_q + "WHERE PART_TRAN_TYPE = 'D' "
						sv_q = sv_q + "AND PARTITIONED_ACID  = ?SVAR AND BANK_ID = ?SVAR "
						sv_q = sv_q + "AND b2k_type = 'ACCNT' AND b2k_id = ?SVAR AND PSTD_FLG = 'Y' "
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.suspAcid +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.MEAC.acid
						
