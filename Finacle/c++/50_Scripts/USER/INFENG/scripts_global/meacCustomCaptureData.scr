				sv_a = urhk_dbSelectWithBind(sv_q)
				
				PRINT(sv_a)
				
				IF(sv_a == 0)THEN
				#{
					PRINT(BANCS.OUTPARAM.pdFlg)
					PRINT(BANCS.OUTPARAM.dpdCntr)
					
					CUST.MEAC.pdFlg = BANCS.OUTPARAM.pdFlg
