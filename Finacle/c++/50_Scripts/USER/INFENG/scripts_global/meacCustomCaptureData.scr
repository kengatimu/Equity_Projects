	IF (sv_a == 0) THEN
	#{
		CUST.MEAC.mode = BANCS.OUTPARAM.srvValue
		PRINT(CUST.MEAC.mode)
	#}
	ENDIF
	
	PRINT(CUST.MEAC.mode)
	
	#############################################################
	# checking for 'A/c' mode
	###########################################################
	
	IF(CUST.MEAC.mode != "A")THEN
	#{
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		
		sv_a = urhk_SRV_GetVal("assetCritStruct.acctNum.foracid")
