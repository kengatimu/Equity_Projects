			IF(CUST.MEAC.schmType != "LAA")THEN
			#{
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				
				#############################################################
						# getting outStanding Amt from LAM
						###########################################################
						
						sv_q = ""
						sv_q = sv_q + "outstandingAmt|SELECT INT_DMD_OS FROM TBAADM.LAM "
						sv_q = sv_q + "WHERE ACID = ?SVAR AND BANK_ID = ?SVAR "
						
						BANCS.INPARAM.BINDVARS = CUST.MEAC.acid +"|"+ BANCS.STDIN.contextBankId
						
						PRINT(sv_q)
						
						sv_b = urhk_dbSelectWithBind(sv_q)
						
						PRINT(sv_b)
						
