						ELSE
							#{
							PRINT("error in insert query")
							sv_b = urhk_dbSqlWithBind("ROLLBACK")
							PRINT(sv_b)
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						#}
					ELSE
						#{
						BANCS.INPARAM.BINDVARS = CUST.MEAC.foracid + "|" + CUST.MEAC.repaySchmCode +"|"+ CUST.MEAC.repayCcyCode +"|"+ CUST.MEAC.solId
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MEAC.pdFlg +"|"+ CUST.MEAC.dpdCntr +"|" + CUST.MEAC.intSuspAmt
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MEAC.penalIntSuspAmt + "|" + CUST.MEAC.crAmt + "|" + CUST.MEAC.drAmt
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MEAC.outstandingAmt +"|"+ CUST.MEAC.NRML_INTEREST_AMOUNT_DR +"|"+ CUST.MEAC.NRML_BOOKED_AMOUNT_DR +"|"+ CUST.MEAC.NRML_ACCRUED_AMOUNT_DR
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MEAC.PENAL_ACCRUED_AMOUNT_DR + "|" + CUST.MEAC.PENAL_BOOKED_AMOUNT_DR +"|" + CUST.MEAC.PENAL_INTEREST_AMOUNT_DR
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MEAC.NRML_INT_SUSPENSE_AMT_DR + "|" + CUST.MEAC.PENAL_INT_SUSPENSE_AMT_DR + "|" + CUST.MEAC.capIntAmt
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MEAC.capIntFlg +"|"+ CUST.MEAC.mainClsfnSys +"|"+ CUST.MEAC.subClsfnSys +"|"+ CUST.MEAC.mainClsfnUser +"|"+ CUST.MEAC.subClsfnUser
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MEAC.event_type + "|"+ BANCS.STDIN.contextBankId
	
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_q = ""
						sv_q = "INSERT INTO CUSTOM.MEACCAPTURE VALUES("
						sv_q = sv_q + "?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, "
						sv_q = sv_q + "?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, "
						sv_q = sv_q + "?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, "
						sv_q = sv_q + "?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, "
						sv_q = sv_q + "?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, "
						sv_q = sv_q + "?SVAR, ?SVAR)"
						
