				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MAPD.mainClsfnSys +"|"+ CUST.MAPD.subClsfnSys +"|"+ CUST.MAPD.mainClsfnUser +"|"+ CUST.MAPD.subClsfnUser
