				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"+ CUST.MAPD.NRML_ACCRUED_AMOUNT_DR + "|" + CUST.MAPD.PENAL_ACCRUED_AMOUNT_DR +"|" + CUST.MAPD.PENAL_BOOKED_AMOUNT_DR
