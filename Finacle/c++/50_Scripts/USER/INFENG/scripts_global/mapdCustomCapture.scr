				#############################################################
				# getting values from EIT
				###########################################################
				
				sv_q = ""
				sv_q = sv_q + "NRML_INTEREST_AMOUNT_DR, NRML_BOOKED_AMOUNT_DR, NRML_ACCRUED_AMOUNT_DR, PENAL_ACCRUED_AMOUNT_DR, PENAL_BOOKED_AMOUNT_DR,"
				sv_q = sv_q + "PENAL_INTEREST_AMOUNT_DR, NRML_INT_SUSPENSE_AMT_DR,PENAL_INT_SUSPENSE_AMT_DR|SELECT NRML_INTEREST_AMOUNT_DR, NRML_BOOKED_AMOUNT_DR, NRML_ACCRUED_AMOUNT_DR, PENAL_ACCRUED_AMOUNT_DR, "
				sv_q = sv_q + "PENAL_BOOKED_AMOUNT_DR, PENAL_INTEREST_AMOUNT_DR, NRML_INT_SUSPENSE_AMT_DR, PENAL_INT_SUSPENSE_AMT_DR  FROM TBAADM.EIT "
				sv_q = sv_q + "WHERE ENTITY_ID = ?SVAR AND ENTITY_TYPE = 'ACCNT' AND BANK_ID = ?SVAR "
				
				BANCS.INPARAM.BINDVARS = CUST.MAPD.acid +"|"+ BANCS.STDIN.contextBankId
				
