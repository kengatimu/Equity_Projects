					CUST.MAPD.PENAL_BOOKED_AMOUNT_DR = BANCS.OUTPARAM.PENAL_BOOKED_AMOUNT_DR
					CUST.MAPD.PENAL_INTEREST_AMOUNT_DR = BANCS.OUTPARAM.PENAL_INTEREST_AMOUNT_DR
