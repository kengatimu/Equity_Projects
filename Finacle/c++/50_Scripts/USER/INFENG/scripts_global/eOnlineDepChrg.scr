<--START
CHECKSUM="b9922b3d30341e140cbe137606a7290925aa1e22f0ea5a4bbcb56801c8e43613"
TRACE ON

sv_a=urhk_B2k_PrintRepos("BANCS")
print(sv_a)
if(repexists("EQSRV")==0)then
	createrep("EQSRV")
endif
if(classexists("EQSRV","GLBDATA")==0)then
	createclass("EQSRV","GLBDATA",5)
endif

IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
#{
	CREATECLASS("CUST","GCHRG",5)
#}
ENDIF

#-------------------------------------------------------------------------------------------------------
# Get the trantype and transubtype
#-------------------------------------------------------------------------------------------------------

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	EQSRV.GLBDATA.tranType = BANCS.OUTPARAM.srvValue
	PRINT(EQSRV.GLBDATA.tranType)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Type")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	EQSRV.GLBDATA.tranSubType = BANCS.OUTPARAM.srvValue
	PRINT(EQSRV.GLBDATA.tranSubType)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Sub Type")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF
sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
PRINT(sv_u)
IF(sv_u == 0) THEN
#{
        EQSRV.GLBDATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
        PRINT(EQSRV.GLBDATA.noOfRecords)
#}
ELSE
#{
        sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
        BANCS.OUTPUT.successOrFailure="F"
        GOTO ENDOFSCRIPT
#}
ENDIF

sv_l = 0
sv_m = ""
sv_n = 0
sv_a = "\n"
sv_x = 0
sv_z = 0
sv_c = 0
sv_e = 0


WHILE(sv_l < EQSRV.GLBDATA.noOfRecords)
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"
	
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		EQSRV.GLBDATA.serialnum = BANCS.OUTPARAM.srvValue
		PRINT(EQSRV.GLBDATA.serialnum)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serialnum")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		EQSRV.GLBDATA.acct = BANCS.OUTPARAM.srvValue
		PRINT(EQSRV.GLBDATA.acct)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Account Number")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refAmt")
	print(sv_u)
	if (sv_u == 0)then
	#{
		EQSRV.GLBDATA.refAmnt = BANCS.OUTPARAM.srvValue
		print(EQSRV.GLBDATA.refAmnt)
		EQSRV.GLBDATA.refAmnt = LEFT$(EQSRV.GLBDATA.refAmnt,GETPOSITION(EQSRV.GLBDATA.refAmnt,"|") - 1)
		print(EQSRV.GLBDATA.refAmnt)
	#}
	endif		 
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refCrncyCode.crncyCode")
	print(sv_u)
        if (sv_u == 0)then
        #{
		EQSRV.GLBDATA.refCrncy = BANCS.OUTPARAM.srvValue
		print(EQSRV.GLBDATA.refCrncy)
	#}
	endif
	
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." + sv_r +".partTranType.code")
	EQSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
	print(EQSRV.GLBDATA.partTranType)
	sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.acct)
	IF (sv_u == 0)THEN
	#{
		EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
		PRINT(EQSRV.GLBDATA.schmType)
		EQSRV.GLBDATA.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
		PRINT(EQSRV.GLBDATA.acctOwnerShip)
		EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(EQSRV.GLBDATA.schmCode)
		EQSRV.GLBDATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		print(EQSRV.GLBDATA.acctCrncyCode)
		
	else
		EQSRV.GLBDATA.schmType = ""
		EQSRV.GLBDATA.acctOwnerShip = ""
		EQSRV.GLBDATA.schmCode =""	
		EQSRV.GLBDATA.acctCrncyCode = ""
		
	#}
	ENDIF
	if((EQSRV.GLBDATA.tranSubType == "NR") and (EQSRV.GLBDATA.tranType == "C"))then
	#{
		if((EQSRV.GLBDATA.acctCrncyCode =="USD") or (EQSRV.GLBDATA.acctCrncyCode =="GBP") or (EQSRV.GLBDATA.acctCrncyCode =="EUR"))then
			#EQSRV.GLBDATA.chrgAmt = cdouble(EQSRV.GLBDATA.refAmnt) * 0.35	
			EQSRV.GLBDATA.chrgAmt = EQSRV.GLBDATA.refAmnt
			print(EQSRV.GLBDATA.chrgAmt)
			CUST.GCHRG.tranType = "T"
			CUST.GCHRG.tranSubType = "BI"
			CUST.GCHRG.acctCrncyCode = EQSRV.GLBDATA.acctCrncyCode 
			CUST.GCHRG.chrgAmt = EQSRV.GLBDATA.chrgAmt + "|" + EQSRV.GLBDATA.acctCrncyCode 
			CUST.GCHRG.eventId = "CASHDEP"		
			CUST.GCHRG.drAcctId = EQSRV.GLBDATA.acct
			print(CUST.GCHRG.drAcctId)
			CALL("gchrgcommon.scr")
			IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
				PRINT("Charge collected")
				#}
			ELSE
				#{
				PRINT("Failure")
			#}
			ENDIF
			GOTO ENDOFSCRIPT
		endif
	
	#}
	endif
	nextrec:
	PRINT(sv_m)	
	sv_l = sv_l + 1
	PRINT (sv_l)
#}
DO


TRACE OFF
EXITSCRIPT
END-->
