############################################
#query to select data from DB
############################################ 


sv_b="ACID,DMD_SATISFY_MTHD,REP_PERD_MTHS,REP_PERD_DAYS,PAYOFF_FLG,"
sv_b=sv_b+"chrge_off_flg,CUST_ID,EMP_ID,GL_SUB_HEAD_CODE,SCHM_CODE,"
sv_b= sv_b+"UN_CLR_BAL_AMT,LAST_TRAN_DATE_CR,clr_bal_amt,SANCT_LIM"
sv_b= sv_b+ "|"
sv_b= sv_b+ "select l.acid,l.DMD_SATISFY_MTHD,l.REP_PERD_MTHS,l.REP_PERD_DAYS,"
sv_b= sv_b+ "l.PAYOFF_FLG,l.chrge_off_flg,g.CUST_ID,g.EMP_ID,g.GL_SUB_HEAD_CODE,"
sv_b=  sv_b+ "g.SCHM_CODE,(g.un_clr_bal_amt + g.future_un_clr_bal_amt + g.future_clr_bal_amt),g.LAST_TRAN_DATE_CR,g.clr_bal_amt,"
sv_b=  sv_b+" g.SANCT_LIM  from tbaadm.lam l,TBAADM.GAM g  where l.acid=g.acid AND  g.FORACID= ?SVAR"

  BANCS.INPARAM.BINDVARS = CUST.DATA.AcctNumber

 sv_e=urhk_dbSelectWithBind(sv_b)
 print(sv_e)



if(sv_e!=0) then		
		CUST.DATA.success="N"
		BANCS.OUTPUT.successOrFailure="F"
		sv_o=urhk_SetOrbOut("ErrorCode|Database Error")
		GOTO ENDOFSCRIPT				
ELSE
  
  ############################################
