####
#bank_id,cif_id,foracid,part_tran_srl_num,tran_date,tran_type,tran_id,part_tran_type,tran_amt,tran_particular,instrmnt_num,phoneno,massage,status_flg,sequenceno,part_tran_srl_nummm

sv_s = "bank_id,cif_id,foracid,part_tran_srl_num,tran_date,tran_type,tran_id,part_tran_type,tran_amt,tran_particular,instrmnt_num,phoneno,massage,status_flg,sequenceno,part_tran_srl_nummm|"
sv_s = sv_s + " SELECT gam.bank_id,gam.cif_id,gam.foracid,PART_TRAN_SRL_NUM,TRAN_DATE,TRAN_TYPE,TRAN_ID,PART_TRAN_TYPE,TRAN_AMT,TRAN_PARTICULAR,INSTRMNT_NUM,(case when substr(PHONENO,1,1)='+' then substr(PHONENO,2) else PHONENO end) as PHONENO ,  "
sv_s = sv_s + " (case when part_tran_type ='D' and INSTRMNT_TYPE is null and tran_type='C' then  " 
sv_s = sv_s + " concat(concat(concat(concat(concat(concat(concat(concat( 'Dear ', SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)), ', You have withdrawn '), tran_crncy_code ),' '), TRAN_AMT),' On: '), TO_CHAR(ENTRY_DATE, 'DD-Mon-YY HH:MI:SS')),' Thank you for banking with us')   "
sv_s = sv_s + " when part_tran_type ='D' and INSTRMNT_TYPE='CHQ' then  " 
sv_s = sv_s + " concat(concat(concat(concat(concat(concat(concat(concat( 'Dear ', SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)),', You have paid out a cheque of ' ), tran_crncy_code),' '),  TRAN_AMT),' Cheque No: '),trim(INSTRMNT_NUM) ),'. Thank you for banking with us' ) "
sv_s = sv_s + " when part_tran_type ='D' and tran_type ='T' and entry_user_id !='CDCI50' and trim(PART_TRAN_SRL_NUM) !='3' then  "
sv_s = sv_s + " concat(concat(concat(concat(concat(concat(concat(concat('Dear ',  SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)),', You have been debited with ' ), tran_crncy_code ),' '), TRAN_AMT),' On: '), TO_CHAR(ENTRY_DATE, 'DD-Mon-YY HH:MI:SS')),' Thank you for banking with us' ) "
sv_s = sv_s + " when part_tran_type ='C' and tran_type='L' then   "
sv_s = sv_s + " concat(concat(concat(concat(concat(concat(concat(concat( 'Dear ', SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)),',You have deposited a cheque of ' ),tran_crncy_code),' '), TRAN_AMT),' maturing On:'),VALUE_DATE),' Thank you for banking with us'  ) "
sv_s = sv_s + " when part_tran_type ='C' and TRAN_SUB_TYPE='NR' and tran_type='C' then  "
sv_s = sv_s + " concat(concat(concat(concat(concat(concat(concat(concat( 'Dear ', SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)),',You have deposited ' ), tran_crncy_code ),' '), TRAN_AMT ),' On: '), TO_CHAR(ENTRY_DATE, 'DD-Mon-YY HH:MI:SS') ),' Thank you for banking with us' ) "
sv_s = sv_s + " when tran_type='T' and part_tran_type ='C' and TRAN_SUB_TYPE in ('CI','BI') then   "
sv_s = sv_s + " concat(concat(concat(concat(concat(concat(concat(concat( 'Dear ', SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)),',You have been credited with ' ), tran_crncy_code ),' '), TRAN_AMT ),' On: '), TO_CHAR(ENTRY_DATE, 'DD-Mon-YY HH:MI:SS') ),' Thank you for banking with us' ) "
sv_s = sv_s + " when tran_type='T' and part_tran_type ='D' and TRAN_SUB_TYPE in ('CI','BI') then  "
sv_s = sv_s + " concat(concat(concat(concat(concat(concat(concat(concat( 'Dear ', SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)),',You have been debited with ' ), tran_crncy_code ),' '), TRAN_AMT ),' On: '), TO_CHAR(ENTRY_DATE, 'DD-Mon-YY HH:MI:SS') ),' Thank you for banking with us'  ) "
sv_s = sv_s + " end) as MASSAGE,'N' as STATUS_FLG, CUSTOM.SMS_STAGE_SEQUENCE.nextval as SEQUENCENO,PART_TRAN_SRL_NUM as PART_TRAN_SRL_NUMMM   "
sv_s = sv_s + " FROM tbaadm.dtd,crmuser.PHONEEMAIL c,tbaadm.gam  WHERE dtd.acid=gam.acid and gam.cif_id=c.ORGKEY and c.PREFERREDFLAG='Y'  and c.PHONEOREMAIL = 'PHONE' and gam.bank_id=c.bank_id   "
sv_s = sv_s + " and dtd.bank_id=gam.bank_id and dtd.bank_id=c.bank_id and gam.bank_id='50' and dtd.del_flg='N' and dtd.PSTD_FLG='Y' and gam.schm_type not in ('LAA','TDA') "
sv_s = sv_s + " and gam.acid not in (select acid from tbaadm.gac where bank_id='50' and FREE_CODE_8 = 'SMS') and gam.acct_ownership in ('C','E')   "
sv_s = sv_s + " and entry_user_id !='CDCI50' and tran_particular not like '%Int.Coll%' and tran_particular not like '%Payoff%' and tran_particular not like '%Charge%' and tran_particular not like '%charge%'   "
sv_s = sv_s + " and tran_particular not like '%CHARGE%' and ((dtd.TRAN_RMKS not like '%SYSTEM:INSTRMNT VALUEDATE CHNG%') OR (dtd.TRAN_RMKS is null))   "
##sv_s = sv_s + " and gam.foracid=?SVAR  and rownum<2 "
sv_s = sv_s + " and gam.foracid=?SVAR and dtd.tran_id=LPAD(?SVAR,9) and dtd.tran_date= ?SVAR and gam.bank_id=?SVAR and dtd.PART_TRAN_SRL_NUM=?SVAR "
print(sv_s)
CUST.ALERTS.AcctNum="4002211642252"
##BANCS.INPARAM.BINDVARS = CUST.ALERTS.AcctNum
###print(BANCS.INPARAM.BINDVARS)
CUST.ALERTS.TranId="   502786"
CUST.ALERTS.TranId=trim(CUST.ALERTS.TranId)
print(CUST.ALERTS.TranId)
CUST.ALERTS.PartTranSrlNum="   1"
BANCS.INPARAM.BINDVARS = CUST.ALERTS.AcctNum + "|" + CUST.ALERTS.TranId + "|" + CUST.ALERTS.BODDaterw  + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.ALERTS.PartTranSrlNum 
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF (sv_d =="0") THEN
	CUST.ALERTS.bank_id = BANCS.OUTPARAM.bank_id
	print(CUST.ALERTS.bank_id)
	CUST.ALERTS.cif_id = BANCS.OUTPARAM.cif_id
	print(CUST.ALERTS.cif_id)
	CUST.ALERTS.foracid = BANCS.OUTPARAM.foracid
	print(CUST.ALERTS.foracid)
	CUST.ALERTS.part_tran_srl_num = BANCS.OUTPARAM.part_tran_srl_num
	print(CUST.ALERTS.part_tran_srl_num)
	CUST.ALERTS.tran_date = BANCS.OUTPARAM.tran_date
	print(CUST.ALERTS.tran_date)
	CUST.ALERTS.tran_type = BANCS.OUTPARAM.tran_type
	print(CUST.ALERTS.tran_type)
	CUST.ALERTS.tran_id = BANCS.OUTPARAM.tran_id
	print(CUST.ALERTS.tran_id)
	CUST.ALERTS.part_tran_type = BANCS.OUTPARAM.part_tran_type
	print(CUST.ALERTS.part_tran_type)
	CUST.ALERTS.tran_amt = BANCS.OUTPARAM.tran_amt
	print(CUST.ALERTS.tran_amt)
	CUST.ALERTS.tran_particular = BANCS.OUTPARAM.tran_particular
	print(CUST.ALERTS.tran_particular)
	CUST.ALERTS.instrmnt_num = BANCS.OUTPARAM.instrmnt_num
	print(CUST.ALERTS.instrmnt_num)
	CUST.ALERTS.phoneno = BANCS.OUTPARAM.phoneno
	print(CUST.ALERTS.phoneno)
	CUST.ALERTS.massage = BANCS.OUTPARAM.massage
	print(CUST.ALERTS.massage)
	CUST.ALERTS.status_flg = BANCS.OUTPARAM.status_flg
	print(CUST.ALERTS.status_flg)
	CUST.ALERTS.sequenceno = BANCS.OUTPARAM.sequenceno
	print(CUST.ALERTS.sequenceno)
	CUST.ALERTS.part_tran_srl_nummm = BANCS.OUTPARAM.part_tran_srl_nummm
	print(CUST.ALERTS.part_tran_srl_nummm)
	IF ((CUST.ALERTS.phoneno!="") AND  (CUST.ALERTS.massage!="")) THEN
		###################################################################################################
		# Insert into CUSTOM.MOBEE_PUSH_SMS TABLE
		###################################################################################################,
		CUST.ALERTS.phoneno="254722395534"
		CUST.ALERTS.massage="TESTS_RW_SMS"
		BANCS.STDIN.contextBankId="50"
		sv_s = "  Insert into CUSTOM.MOBEE_PUSH_SMS "
                sv_s = sv_s + " (REF_NO, LANGUAGE, INSTITUTION_CODE, MOBILE_NUMBER, MESSAGE_ARRIEVED_DATE, MESSAGE_PRIORITY, MESSAGE_STATUS, MESSAGE_VALIDITY_PERIOD, DEPARTMENT, MESSAGE_TEXT,retry_count, BANK_ID)  "
                sv_s = sv_s + " Values  (CUSTOM.MOBEE_PUSH_SMS_SEQUENCE.nextval, 'EN', '192', ?SVAR  , ?SVAR ,9, 0,'86400000', 'FinacleRW', ?SVAR , 0,?SVAR ) "
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  CUST.ALERTS.phoneno + "|" + CUST.ALERTS.BODDaterw + "|" + CUST.ALERTS.massage + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSqlWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0)THEN
			print("SMS_OKAY")
		ENDIF
	ENDIF
ENDIF
