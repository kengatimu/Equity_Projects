                                sv_v = "DPD_" + FORMAT$(sv_q, "%d")
                                print(sv_v)
                                sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.DPD| " + ("CUST").("INTERFACE").(sv_v)
