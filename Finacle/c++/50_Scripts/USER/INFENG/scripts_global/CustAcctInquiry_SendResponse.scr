                                print(sv_v)
                                sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.EcosystemCode| " + ("CUST").("INTERFACE").(sv_v)
                                sv_u = urhk_SetOrbOut(sv_t)
                                sv_v = "OperAcctId_" + FORMAT$(sv_q, "%d")
