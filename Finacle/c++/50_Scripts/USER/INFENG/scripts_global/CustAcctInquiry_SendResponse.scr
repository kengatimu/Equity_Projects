                                sv_u = urhk_SetOrbOut(sv_t)
                        endif
			if((CUST.INTERFACE.schemeType=="LAA")and (CUST.INTERFACE.schemeCode=="LA571"))then
                                sv_v = "EcoCode_" + FORMAT$(sv_q, "%d")
