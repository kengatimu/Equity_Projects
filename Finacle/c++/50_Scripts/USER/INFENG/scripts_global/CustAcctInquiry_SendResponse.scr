                        sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.DisbursementAmt| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
