        sv_u = urhk_SetOrbOut(sv_t)

	IF  (((CUST.INTERFACE.DccId =="NGN") OR (CUST.INTERFACE.DccId =="SME") OR (CUST.INTERFACE.DccId =="RLS")) AND (BANCS.STDIN.contextBankId=="50")) THEN
	#{
		sv_t = "CustAcctInquiry_RES.SegmentCode| " + CUST.INTERFACE.SegmentCode
		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "CustAcctInquiry_RES.Segmentation| " + CUST.INTERFACE.Segmentation
