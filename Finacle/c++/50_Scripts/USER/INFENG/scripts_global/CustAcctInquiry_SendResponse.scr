                sv_v = "foracid_" + FORMAT$(sv_q, "%d")
               #++++++++++++++++++++ vino palani POL changes 4th feb 2020
                CUST.INTERFACE.AcctId = ("CUST").("INTERFACE").(sv_v)
                sv_u = urhk_getAcctDetailsInRepository(CUST.INTERFACE.AcctId)
                if(sv_u == 0)then
                        CUST.INTERFACE.EffBAl=BANCS.OUTPARAM.EffAvailableAmt
                else
                        CUST.INTERFACE.EffBAl= 0
                endif
                #+++++++++++++++++++++ ends
                sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountID| " + ("CUST").("INTERFACE").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)
                IF (FIELDEXISTS(CUST.INTERFACE.accountIDIBAN) == 1) THEN
                                print(CUST.INTERFACE.accountIDIBAN)
                                sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountID| " + CUST.INTERFACE.accountIDIBAN
                                sv_u = urhk_SetOrbOut(sv_t)
                                #sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountIDIBAN| " + ("CUST").("INTERFACE").(sv_v)
                                #sv_u = urhk_SetOrbOut(sv_t)
                ENDIF

                sv_v = "acid_" + FORMAT$(sv_q, "%d")
                sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.Acid| " + ("CUST").("INTERFACE").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "acctOpenDate_" + FORMAT$(sv_q, "%d")
