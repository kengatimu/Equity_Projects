                                        sv_u = urhk_SetOrbOut(sv_t)
                                ELSE
                                        sv_v = "EffAvailBal_" + FORMAT$(sv_q, "%d")
                                        #sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.EffAvailBal| " + ("CUST").("INTERFACE").(sv_v)
                                        sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.EffectiveBalance| " + ("CUST").("INTERFACE").(sv_v)
                                        sv_u = urhk_SetOrbOut(sv_t)
                                ENDIF
                        ENDIF
                ENDIF

		IF  ((CUST.INTERFACE.DccId =="EXP") OR (CUST.INTERFACE.DccId =="SME") )THEN
                #{
                        IF((CUST.INTERFACE.schemeType == "SBA") OR (CUST.INTERFACE.schemeType == "CAA"))THEN
                        #{
                                sv_v = "CustSeg_" + FORMAT$(sv_q, "%d")
                                sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.CustSeg| " + ("CUST").("INTERFACE").(sv_v)
