        sv_u = urhk_SetOrbOut(sv_t)
        sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.PinCode| " + CUST.INTERFACE.custPrefPinCode
        sv_u = urhk_SetOrbOut(sv_t)
