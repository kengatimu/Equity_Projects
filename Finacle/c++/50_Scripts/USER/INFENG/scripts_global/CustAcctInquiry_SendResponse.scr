<--start
#trace on
sv_a = urhk_GetChannelInfo("")
        print(sv_a)
        CUST.INTERFACE.DccId =BANCS.OUTPARAM.DccId
        print(CUST.INTERFACE.DccId)

        #--------------------------------------------------------------------------------
        # Setting Customer Details in Response XML
        #--------------------------------------------------------------------------------
        sv_t = "CustAcctInquiry_RES.CustomerID| " + CUST.INTERFACE.customerID
        sv_u = urhk_SetOrbOut(sv_t)
        #++++++++
        if(CUST.INTERFACE.DccId == "FNT")then
        sv_t = "CustAcctInquiry_RES.CustVerifyStatus| " + CUST.INTERFACE.CustVerifyStatus
        sv_u = urhk_SetOrbOut(sv_t)
        endif
        #++++++++
	#++++++++
	if ((CUST.INTERFACE.DccId == "NGN") OR (CUST.INTERFACE.DccId == "SME") OR (CUST.INTERFACE.DccId == "RLS"))then
		IF(CUST.INTERFACE.custMaritalStatus !="")THEN
			IF(CUST.INTERFACE.custMaritalStatus =="001")THEN
				CUST.INTERFACE.custMaritalStatus = "SIN"
			ENDIF
			IF(CUST.INTERFACE.custMaritalStatus =="002")THEN
				CUST.INTERFACE.custMaritalStatus = "MAR"
			ENDIF
			IF(CUST.INTERFACE.custMaritalStatus =="003")THEN
				CUST.INTERFACE.custMaritalStatus = "SEP"
			ENDIF
			IF(CUST.INTERFACE.custMaritalStatus =="004")THEN
				CUST.INTERFACE.custMaritalStatus = "DIV"
			ENDIF
			IF(CUST.INTERFACE.custMaritalStatus =="005")THEN
				CUST.INTERFACE.custMaritalStatus = "WID"
			ENDIF
		PRINT(CUST.INTERFACE.custMaritalStatus)
		ENDIF

	endif
	#++++++++
        sv_t = "CustAcctInquiry_RES.CustomerName| " + CUST.INTERFACE.custName
        sv_u = urhk_SetOrbOut(sv_t)
        sv_t = "CustAcctInquiry_RES.CustomerFirstName| " + CUST.INTERFACE.custFirstName
        sv_u = urhk_SetOrbOut(sv_t)
        sv_t = "CustAcctInquiry_RES.CustomerLastName| " + CUST.INTERFACE.custLastName
        sv_u = urhk_SetOrbOut(sv_t)
