		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "CustAcctInquiry_RES.Location| " + CUST.INTERFACE.Location
		sv_u = urhk_SetOrbOut(sv_t)
	#}
	ENDIF
##########----Adding channel ID RLS------- CHG0031643 ------- By Karemeri
	IF  ((CUST.INTERFACE.DccId =="EXP") OR (CUST.INTERFACE.DccId =="RLS") OR (CUST.INTERFACE.DccId =="SME") OR (CUST.INTERFACE.DccId =="NGN") OR (CUST.INTERFACE.DccId =="CRS"))THEN
