        NXTL:
        sv_r = urhk_dbCursorFetch(sv_p)
        if(sv_r!=0)then
        #{
                print("fetch failed")
                sv_u = urhk_dbCursorClose(sv_p)
                print(sv_u)
                goto VAYURUN
        #}
