                                sv_d = "ldrAcct,ldrBalance | select foracid ,clr_bal_amt from tbaadm.gam where bank_id=?SVAR "
                                sv_d = sv_d + " and acct_ownership<>'O' "
                                sv_d = sv_d + " and cif_id = ?SVAR "
                                sv_d = sv_d + " and schm_code in ('SB100','SB126','CA207') "
                                sv_d = sv_d + " and schm_type in ('SBA','CAA') "
                                sv_d = sv_d + " and entity_cre_flg='Y' and del_flg='N' "
                                sv_d = sv_d + " and acct_cls_flg<>'Y' "
                                sv_d = sv_d + " and acct_cls_date is null "
                                sv_d = sv_d + " and clr_bal_Amt >=1 "
                                ####sv_d = sv_d + " and clr_bal_Amt >=?NVAR "
                                sv_d = sv_d + " and FREZ_CODE <>'D' "
                                if(EBSRV.GLBDATA.recA!="")then
                                #{
                                        sv_d = sv_d + " and foracid in (?SVAR) "
                                #}
                                endif
                                sv_d = sv_d + " and rownum<=1 "
                                sv_d = sv_d + " order by schm_type desc "
                                if(EBSRV.GLBDATA.recA!="")then
                                #{
                                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +EBSRV.GLBDATA.drCif + "|" + EBSRV.GLBDATA.recA
                                #}
                                else
                                #{
                                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +EBSRV.GLBDATA.drCif
                                #}
                                endif
                                ####BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +EBSRV.GLBDATA.drCif + "|" + EBSRV.GLBDATA.dmdAmt
                                goto NXTL
                        #}
                        endif
                        if(EBSRV.GLBDATA.dmdsrlNum == "NOSWEEPDIRECT_CREDIT")then
                        #{
                                #Fetch only allowed recovery accounts for agent float financing
                                sv_d = "ldrAcct,ldrBalance | select gam.foracid,gam.clr_bal_amt from tbaadm.gam,tbaadm.fcftt where gam.bank_id=?SVAR and fcftt.bank_id=?SVAR"
                                sv_d = sv_d + " and gam.acct_ownership<>'O' "
                                sv_d = sv_d + " and gam.cif_id = ?SVAR "
                                sv_d = sv_d + " and gam.acid = fcftt.acid "
                                sv_d = sv_d + " and gam.schm_code in ('SB100','SB126','CA207') "
                                sv_d = sv_d + " and gam.schm_type in ('SBA','CAA') "
                                sv_d = sv_d + " and gam.entity_cre_flg='Y' and gam.del_flg='N' "
                                sv_d = sv_d + " and fcftt.entity_cre_flg='Y' and fcftt.del_flg='N' "
                                sv_d = sv_d + " and fcftt.free_code_18='AGENT-FLOAT' "
                                sv_d = sv_d + " and gam.acct_cls_flg<>'Y' "
                                sv_d = sv_d + " and gam.acct_cls_date is null "
                                sv_d = sv_d + " and gam.clr_bal_Amt >=1 "
                                sv_d = sv_d + " and gam.frez_code <>'D' "
                                sv_d = sv_d + " and rownum<=1 "
                                sv_d = sv_d + " order by schm_type desc "
                                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.drCif
                        #}
                        endif
                        print(sv_d)
                        print(BANCS.INPARAM.BINDVARS)
                        sv_u = urhk_dbSelectWithBind(sv_d)
                        if(sv_u==0)then
                        #{
                                EBSRV.GLBDATA.ldrBalance = BANCS.OUTPARAM.ldrBalance
                                EBSRV.GLBDATA.ldrAcct = BANCS.OUTPARAM.ldrAcct
                        #}
                        else
                        #{
                                EBSRV.GLBDATA.ldrBalance = 0
                                EBSRV.GLBDATA.ldrAcct =""
                        #}
                        endif
                        if(cdouble(EBSRV.GLBDATA.ldrBalance) >= 1)then
                        #{
                                EBSRV.GLBDATA.drBalance = EBSRV.GLBDATA.ldrBalance
                                EBSRV.GLBDATA.drAcct = EBSRV.GLBDATA.ldrAcct
				sv_a = EBSRV.GLBDATA.drAcct +"|" +EBSRV.GLBDATA.crAcct+"|"+EBSRV.GLBDATA.dmdAmt+"|"+EBSRV.GLBDATA.dmdsrlNum+"|"+EBSRV.GLBDATA.dmdAcct+"|"+EBSRV.GLBDATA.drBalance + "|" + EBSRV.GLBDATA.dmdDate + "|" + EBSRV.GLBDATA.dmdOvduDate + "|" + EBSRV.GLBDATA.orgDmdAmt
                                sv_q = "echo '" + sv_a + "' >> AGDSR.DAT"
                                print(sv_q)
                                sv_s = system(sv_q)
                                print(sv_s)
                        #}
                        else
                        #{
                                if(cdouble(EBSRV.GLBDATA.drBalance) >= 1)then
                                #{
                                        ###EBSRV.GLBDATA.drAcct = EBSRV.GLBDATA.ldrAcct
                                ######        sv_a = EBSRV.GLBDATA.drAcct +"|" +EBSRV.GLBDATA.crAcct+"|"+EBSRV.GLBDATA.dmdAmt+"|"+EBSRV.GLBDATA.dmdsrlNum+"|"+EBSRV.GLBDATA.dmdAcct+"|"+EBSRV.GLBDATA.drBalance
				sv_a = EBSRV.GLBDATA.drAcct +"|" +EBSRV.GLBDATA.crAcct+"|"+EBSRV.GLBDATA.dmdAmt+"|"+EBSRV.GLBDATA.dmdsrlNum+"|"+EBSRV.GLBDATA.dmdAcct+"|"+EBSRV.GLBDATA.drBalance + "|" + EBSRV.GLBDATA.dmdDate + "|" + EBSRV.GLBDATA.dmdOvduDate + "|" + EBSRV.GLBDATA.orgDmdAmt
                                        sv_q = "echo '" + sv_a + "' >> AGDSR.DAT"
                                        print(sv_q)
                                        sv_s = system(sv_q)
                                        print(sv_s)
                                #}
                                else
                                #{
                                        goto NXTL
                                #}
                                endif
                        #}
                        endif
                #}
                else
                #{
