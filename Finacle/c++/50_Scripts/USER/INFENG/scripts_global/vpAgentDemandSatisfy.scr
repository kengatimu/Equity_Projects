<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        sv_p = urhk_B2k_PrintRepos("BANCS")
        print(sv_p)
#fetch
        sv_a = "rm -f AGDSR.DAT"
        sv_a = system(sv_a)
        sv_a = "touch AGDSR.DAT"
        sv_a = system(sv_a)
        sv_l = "dmdsrlNum,drAcct,dmdDate,dmdOvduDate,orgDmdAmt,dmdAmt,solidagddt|"
        sv_l = sv_l + " select dep_srl_num,foracid,to_char(dmd_date,'DD-MM-YYYY'),to_char(dmd_ovdu_date,'DD-MM-YYYY'),dmd_amt,sum(dmd_amt-tot_adj_amt)as outstandingAmt,sol_id "
        sv_l = sv_l + " from custom.agddt "
        sv_l = sv_l + " where bank_id=?SVAR "
        sv_l = sv_l + " and sol_id in (select sol_id from tbaadm.sst where set_id=?SVAR and bank_id=?SVAR) "
        sv_l = sv_l + " and to_date(dmd_date,'DD-MM-RR') <= to_date(?SVAR,'DD-MM-RR')"
        sv_l = sv_l + " and dep_command='CSWOP' "
        sv_l = sv_l + " and dep_dccid='BATCH' "
        sv_l = sv_l + " and dep_srl_num='NOSWEEPDIRECT_CREDIT' "
        sv_l = sv_l + " and del_flg='N' "
        sv_l = sv_l + " and entity_cre_flg='Y' "
	sv_l = sv_l + " and dmd_amt-tot_adj_amt >0   "
	sv_l = sv_l + " group by dep_srl_num,foracid,dmd_date,dmd_ovdu_date,dmd_amt,tot_adj_amt,sol_id  "
        sv_l = sv_l + " order by dmd_ovdu_date"
        print(sv_l)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + mid$(BANCS.STDIN.BODDate,0,10)
        sv_c = urhk_dbCursorOpenWithBind(sv_l)
        print(sv_c)
        if(sv_c != 0)then
        #{
                print("fetching failed")
                goto VAYU
        #}
        endif
        sv_p = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        print(sv_p)
        sv_r = urhk_dbCursorFetch(sv_p)
        print(sv_r)
        if(sv_r != 0)then
        #{
            goto VAYU
        #}
        endif
        EBSRV.GLBDATA.record_count = 0
        while(sv_r == 0)
        #{
                EBSRV.GLBDATA.dmdsrlNum =       BANCS.OUTPARAM.dmdsrlNum
                EBSRV.GLBDATA.drAcct    =       BANCS.OUTPARAM.drAcct
                EBSRV.GLBDATA.dmdAcct   =       BANCS.OUTPARAM.drAcct
                EBSRV.GLBDATA.dmdAmt    =       BANCS.OUTPARAM.dmdAmt
                EBSRV.GLBDATA.solidagddt=       BANCS.OUTPARAM.solidagddt
                EBSRV.GLBDATA.dmdDate   =       BANCS.OUTPARAM.dmdDate
                EBSRV.GLBDATA.dmdOvduDate=      BANCS.OUTPARAM.dmdOvduDate
                EBSRV.GLBDATA.orgDmdAmt =       BANCS.OUTPARAM.orgDmdAmt
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.drAcct)
                print(sv_u)
                if(sv_u==0)then
                #{
                        EBSRV.GLBDATA.drBalance = BANCS.OUTPARAM.ClearBalance
                        EBSRV.GLBDATA.drCif  = BANCS.OUTPARAM.cifId
                        print(EBSRV.GLBDATA.drBalance)
                        print(EBSRV.GLBDATA.dmdAmt)
                        sv_d = "CrAcct,CrActBal|select foracid,clr_bal_amt from tbaadm.gam  where bank_id=?SVAR "
                        sv_d = sv_d + " and schm_type='ODA' and schm_code='OD541' and cif_id=?SVAR " 
			######and clr_bal_amt <> 0 "
                        sv_d = sv_d + " and acct_cls_flg='N' and del_flg='N' and entity_cre_flg='Y' and rownum<=1 "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.drCif
                        sv_u = urhk_dbSelectWithBind(sv_d)
                        if(sv_u==0)then
                        #{
                                EBSRV.GLBDATA.crAcct = BANCS.OUTPARAM.CrAcct
                                EBSRV.GLBDATA.CrActBal = BANCS.OUTPARAM.CrActBal
                        #}
                        else
                        #{
                                EBSRV.GLBDATA.crAcct = ""
                                EBSRV.GLBDATA.CrActBal = ""
                        #}
                        endif
                        if(EBSRV.GLBDATA.crAcct=="")then
                        #{
                                        goto NXTL
                        #}
                        else
                        #{
                                if(cdouble(EBSRV.GLBDATA.CrActBal)>=0)then
                                #{
                                        lv_d = " update custom.agddt set del_flg='Y',free_text3='Deleted For CR Balance' where bank_id=?SVAR and foracid=?SVAR and free_text1=?SVAR "
                                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.drAcct + "|" + EBSRV.GLBDATA.drCif
                                        lv_d = urhk_dbSqlWithBind(lv_d)
                                        if(lv_d==0)then
                                        #{
                                                lv_d = urhk_dbSqlWithBind("commit")
                                                print(lv_d)
                                        #}
                                        endif
                                        goto NXTL
                                #}
                                endif
                                sv_u = urhk_getAdvanceDetailsForAccount(EBSRV.GLBDATA.crAcct)
                                print(sv_u)
                                if(sv_u==0)then
                                #{
                                        EBSRV.GLBDATA.rec1 = BANCS.OUTPARAM.gacFreeText1
                                        EBSRV.GLBDATA.rec2 = BANCS.OUTPARAM.gacFreeText2
                                        EBSRV.GLBDATA.rec3 = BANCS.OUTPARAM.gacFreeText3
                                        EBSRV.GLBDATA.rec4 = BANCS.OUTPARAM.gacFreeText4
                                        EBSRV.GLBDATA.rec5 = BANCS.OUTPARAM.gacFreeText5
                                #}
                                else
                                #{
                                        EBSRV.GLBDATA.rec1 = ""
                                        EBSRV.GLBDATA.rec2 = ""
                                        EBSRV.GLBDATA.rec3 = ""
                                        EBSRV.GLBDATA.rec4 = ""
                                        EBSRV.GLBDATA.rec5 = ""
                                #}
                                endif
                                EBSRV.GLBDATA.recA = ""
                                if(EBSRV.GLBDATA.rec1!="")then
                                #{
                                        EBSRV.GLBDATA.recA = EBSRV.GLBDATA.rec1
                                #}
                                endif
                                if(EBSRV.GLBDATA.rec2!="")then
                                #{
                                        EBSRV.GLBDATA.recA = EBSRV.GLBDATA.recA + "," + EBSRV.GLBDATA.rec2
                                #}
                                endif
                                if(EBSRV.GLBDATA.rec3!="")then
                                #{
                                        EBSRV.GLBDATA.recA = EBSRV.GLBDATA.recA + "," + EBSRV.GLBDATA.rec3
                                #}
                                endif
                                if(EBSRV.GLBDATA.rec4!="")then
                                #{
                                        EBSRV.GLBDATA.recA = EBSRV.GLBDATA.recA + "," + EBSRV.GLBDATA.rec4
                                #}
                                endif
                                if(EBSRV.GLBDATA.rec5!="")then
                                #{
                                        EBSRV.GLBDATA.recA = EBSRV.GLBDATA.recA + "," + EBSRV.GLBDATA.rec5
                                #}
                                endif
                        #}
                        endif
                        if(EBSRV.GLBDATA.dmdsrlNum!="NOSWEEPDIRECT_CREDIT")then
