<--START
CHECKSUM="e40ba2d7806290484779cf047ff83877652669a35e2e3ed9fe9fe8fa0aab5066"
	TRACE ON
	BANCS.OUTPUT.SuccessOrFailure = "S"
	BANCS.OUTPUT.ReasonForFailure = ""
	BANCS.OUTPUT.OtherBankRefNum = BANCS.INPUT.tag201
	BANCS.OUTPUT.RealiseValueDate=MID$(BANCS.INPUT.tag32a1,0,10)
	BANCS.OUTPUT.NostroCrncy=BANCS.INPUT.tag32a2
	BANCS.OUTPUT.NostroAmt=BANCS.INPUT.tag32a3
	BANCS.OUTPUT.RemitCrncy=BANCS.INPUT.tag32a2
	BANCS.OUTPUT.RemitAmt=BANCS.INPUT.tag32a3
	BANCS.OUTPUT.OtherPartyName= ""
	BANCS.OUTPUT.OtherPartyAddr1= ""
	BANCS.OUTPUT.OtherPartyAddr2= ""
	BANCS.OUTPUT.OtherPartyAddr3= ""
	BANCS.OUTPUT.EefcAcct   = ""
	BANCS.OUTPUT.EefcRealisationAmt = ""
	BANCS.OUTPUT.SenderCorresBIC=BANCS.INPUT.tag53a2
	BANCS.OUTPUT.RecvCorresBIC=BANCS.INPUT.tag54a2
	BANCS.OUTPUT.OperAcct           = ""
	BANCS.OUTPUT.PartyName = BANCS.INPUT.tag592
	BANCS.OUTPUT.PartyAddr1 = BANCS.INPUT.tag593
	BANCS.OUTPUT.PartyAddr2 = BANCS.INPUT.tag594
	BANCS.OUTPUT.PartyAddr3 = BANCS.INPUT.tag595
	
	sv_a = 0
	#############################################
	#tag33b is remit amount
	##############################################
	#	BANCS.INPUT.tag33b2 = "100000"
	sv_a = CDOUBLE(BANCS.INPUT.tag33b2)
	
	IF (sv_a < 0) THEN
	#{
		BANCS.OUTPUT.SuccessOrFailure = "F"
		BANCS.OUTPUT.ReasonForFailure = "Remit amount is less than the criteria amount"
		EXITSCRIPT
		#}
	ELSE
		#{
		BANCS.OUTPUT.SuccessOrFailure = "S"
	#}
	ENDIF
	#########################################################
	#tag591    operative account
	#########################################################
	#	BANCS.INPUT.tag591 = "2343/10290367100101"
	sv_k = BANCS.INPUT.tag591
	sv_p =GETPOSITION(BANCS.INPUT.tag591, "/")
	print(sv_p)
	sv_w = MID$(BANCS.INPUT.tag591,sv_p, 14)
	print(sv_w)
	sv_b=urhk_valAcctNumber(sv_w)
	print(sv_b)
	
	IF (sv_b==1) THEN
	#{
		BANCS.OUTPUT.SuccessOrFailure = "S"
		BANCS.OUTPUT.ReasonForFailure = "Invalid Account specified"
		EXITSCRIPT
		#}
	ELSE
		#{
		sv_b=urhk_getAcctDetailsInRepository(sv_w)
		print(sv_b)
		IF (sv_b== 1 ) THEN
		#{
			BANCS.OUTPUT.SuccessOrFailure = "S"
			BANCS.OUTPUT.ReasonForFailure = "Invalid Account specified"
			print(BANCS.OUTPUT.ReasonForFailure)
			#}
		ELSE
			#{
			sv_k="Y"
			IF (BANCS.OUTPARAM.acctCloseflg==sv_k) THEN
			#{
				BANCS.OUTPUT.SuccessOrFailure = "S"
				BANCS.OUTPUT.ReasonForFailure = "account closed "
				print(BANCS.OUTPUT.ReasonForFailure)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	TRACE OFF
END-->
