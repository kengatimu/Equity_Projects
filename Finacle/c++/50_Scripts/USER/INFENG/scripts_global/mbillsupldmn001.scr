	#sv_a = sv_a + " &"
	#print(sv_a)
	#
	#sv_b = SYSTEM(sv_a)
	#print(sv_b)
	#
	#IF(sv_b != 0 ) THEN
	##{
	#    CUST.BILLS.errMsg = "Technical Error - Com file for generating a file"
	#    GOTO ENDOFSCRIPT
	##}
	#ELSE
	##{
	#	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	#	sv_g = "RESULT_MSG|Upload Initiated successfully "
	#	sv_z = urhk_SetOrbOut(sv_g)
	##}
	#ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.BILLS.errMsg != "") THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^"+CUST.BILLS.errMsg+"^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			#}
		ELSE
			#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|Upload/Process Initiated SuccessFully"
			sv_z = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
		
		exitscript
		
