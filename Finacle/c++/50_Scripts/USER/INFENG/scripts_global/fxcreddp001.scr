#------------------------------------------------------------------------------------------------    
#    Name			 : fxcreddp001.scr
#    Description     :
#    Date            : 01-04-2013
#    Author          : Divya
#    Input           : NA
#    Output			 : NA
#    Called Script	 :
#    Calling Script	 : getcparamvalue.scr
#    Menu Option	 : HTM, HCASHDEP, HCASHWD, HXFR
#    Srl. No			Date			Author			Description.
#    ------			----------			-------			---------------
#    1.0			01-04-2013			Divya			Original Version
#	 2.0            02-07-2013          Bharath         repository name changed
#	 3.0            31-07-2013          Bharath         Modified for TOL 363787
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="2a1bcd4e83f96bc54932e8c90b255f9b4c0b9ecb9bad256bbb9b67413915b0e3"
	TRACE ON
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	# 	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","GLBDATA") == 0) THEN
	#{
		CREATECLASS("CUST","GLBDATA",5)
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","GCHRG")==0) THEN
	#{
		CREATECLASS("CUST","GCHRG",5)
	#}
	ENDIF
	
	CUST.GLBDATA.errMsg = ""
	CUST.GLBDATA.var1   = ""
	CUST.GLBDATA.var2   = ""
	CUST.GLBDATA.chargeamt = "0"
	
	BANCS.INPUT.moduleName = "CHARGE"
	BANCS.INPUT.parameterId = "FXRATECODE"
	
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.GLBDATA.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.GLBDATA.refCode)
		#}
	ELSE
		#{
		CUST.GLBDATA.errMsg = "FXRATECODE set up not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "CHARGE"
	BANCS.INPUT.parameterId = "FXEVENTID"
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.GLBDATA.fxEventId = BANCS.OUTPUT.parameterVal
		PRINT(CUST.GLBDATA.fxEventId)
		#}
	ELSE
		#{
		CUST.GLBDATA.errMsg = "Cparam set up not done for FXEVENTID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------------
	# Get the number of accounts
	#-------------------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.GLBDATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.GLBDATA.noOfRecords)
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_p = 0
	sv_b = ""
	sv_c = 0
	WHILE (sv_p < CINT(CUST.GLBDATA.noOfRecords))
	#{
		sv_v = Format$(sv_p,"%d")
		sv_r = "<rec_"+sv_v+">"
		PRINT(sv_r)
		
		#-------------------------------------------------------------------------------------------
		# Fetch Tran Amt
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refAmt")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.GLBDATA.refAmt = BANCS.OUTPARAM.srvValue
			CUST.GLBDATA.refAmt = LEFT$(CUST.GLBDATA.refAmt,GETPOSITION(CUST.GLBDATA.refAmt,"|") - 1)
			PRINT(CUST.GLBDATA.refAmt)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Amt")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO NEXTREC
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Foracid
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.GLBDATA.account = BANCS.OUTPARAM.srvValue
			PRINT(CUST.GLBDATA.account)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Account Number")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO NEXTREC
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Tran ID
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".pTranIdentifier.tranId")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.GLBDATA.tranid = TRIM(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.GLBDATA.tranid)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Id")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO NEXTREC
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Key serial number
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.GLBDATA.srlNum = BANCS.OUTPARAM.srvValue
			PRINT(CUST.GLBDATA.srlNum)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serial number")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO NEXTREC
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Tran Sub Type
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".tranTypeSubType.tranSubType")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.GLBDATA.sub_type = BANCS.OUTPARAM.srvValue
			PRINT(CUST.GLBDATA.sub_type)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Sub Type")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO NEXTREC
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Part Tran Type
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.GLBDATA.pTranType = BANCS.OUTPARAM.srvValue
			PRINT(CUST.GLBDATA.pTranType)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Part Tran Type")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO NEXTREC
		#}
		ENDIF
		
		sv_u = urhk_getAcctDetailsInRepository(CUST.GLBDATA.account)
		IF (sv_u == 0) THEN
		#{
			CUST.GLBDATA.CrncyCode = BANCS.OUTPARAM.acctCrncyCode
			PRINT(CUST.GLBDATA.CrncyCode)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error in find acct currency code")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO NEXTREC
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Getting mean rate
		#-------------------------------------------------------------------------------------------
		sv_s = " fxdcrncycode,ratecode,Rate|"
		sv_s = sv_s + "SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS "
		sv_s = sv_s + "FROM TBAADM.RTL "
		sv_s = sv_s + "WHERE FXD_CRNCY_CODE = ?SVAR "
		sv_s = sv_s + "AND VAR_CRNCY_CODE = ?SVAR "
		sv_s = sv_s + "AND RATECODE = ?SVAR "
		sv_s = sv_s + "AND FXD_CRNCY_CODE != ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.GLBDATA.CrncyCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + CUST.GLBDATA.refCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.GLBDATA.fxdcrncycode = BANCS.OUTPARAM.fxdcrncycode
			PRINT(CUST.GLBDATA.fxdcrncycode)
			
			CUST.GLBDATA.ratecode = BANCS.OUTPARAM.ratecode
			PRINT(CUST.GLBDATA.ratecode)
			
			CUST.GLBDATA.Rate = BANCS.OUTPARAM.Rate
			PRINT(CUST.GLBDATA.Rate)
			#}
		ELSE
			#{
			CUST.GLBDATA.Rate = "1"
			GOTO NEXTREC
		#}
		ENDIF
		
		IF ( (CUST.GLBDATA.CrncyCode != BANCS.STDIN.homeCrncyCode) AND (CUST.GLBDATA.pTranType == "C" ) ) THEN
		#{
			IF (CUST.GLBDATA.sub_type == "NR") THEN
			#{
				BANCS.INPARAM.InputAmount  = CUST.GLBDATA.refAmt
				BANCS.INPARAM.CurrencyCode = CUST.GLBDATA.CrncyCode
				IF (CUST.GLBDATA.CrncyCode != BANCS.STDIN.homeCrncyCode) THEN
				#{
					BANCS.INPARAM.AmountTableCode = "CDFCY"
					PRINT(BANCS.INPARAM.AmountTableCode)
				#}
				ENDIF
				
				sv_u = urhk_B2k_GetASTMAmount("")
				IF (sv_u == 1) THEN
				#{
					CUST.GLBDATA.errMsg = "CDFCY setup is available not available for currency " + CUST.GLBDATA.CrncyCode
					sv_u = urhk_SRV_SetErr(CUST.GLBDATA.errMsg)
					print(sv_u)
					GOTO NEXTREC
					#}
				ELSE
					#{
					CUST.GLBDATA.chargeamt = BANCS.OUTPARAM.OutputAmount
					PRINT(CUST.GLBDATA.chargeamt)
				#}
				ENDIF
				
				CUST.GLBDATA.chargeamt = CDOUBLE(CUST.GLBDATA.chargeamt) * CDOUBLE(CUST.GLBDATA.Rate)
				PRINT(CUST.GLBDATA.chargeamt)
				
			#}
			ENDIF
			
			IF ((CUST.GLBDATA.sub_type == "BI") OR (CUST.GLBDATA.sub_type == "CI") ) THEN
			#{
				BANCS.INPUT.moduleName = "CHARGE"
				BANCS.INPUT.parameterId = "CIFXEVENTID"
				CALL ("getcparamvalue.scr")
				PRINT(BANCS.OUTPUT.parameterVal)
				
				IF (BANCS.OUTPUT.parameterVal != "")THEN
				#{
					CUST.GLBDATA.fxEventId = BANCS.OUTPUT.parameterVal
					PRINT(CUST.GLBDATA.fxEventId)
					#}
				ELSE
					#{
					CUST.GLBDATA.errMsg = "Cparam set up not done for CIFXEVENTID"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				CUST.GLBDATA.chargeamt = CDOUBLE(CUST.GLBDATA.refAmt) * CDOUBLE(CUST.GLBDATA.Rate)
				PRINT(CUST.GLBDATA.chargeamt)
			#}
			ENDIF
			
			IF (CDOUBLE(CUST.GLBDATA.chargeamt) == 0) THEN
			#{
				GOTO NEXTREC
			#}
			ENDIF
			
			#-------------------------------------------------------------------------------------------------
			#  Handling Trading a/c
			#-------------------------------------------------------------------------------------------------
			sv_u = urhk_getAcctDetailsInRepository(CUST.GLBDATA.account)
			print(sv_u)
			IF(sv_u==0) THEN
			#{
				CUST.GLBDATA.schmType = BANCS.OUTPARAM.schmType
				print(CUST.GLBDATA.schmType)
				
				IF (CDOUBLE(CUST.GLBDATA.schmType) == "OAB") THEN
				#{
					GOTO NEXTREC
				#}
				ENDIF
			#}
			ENDIF
			
			
			#------------------------------------------------------------------
			#  Calling gcharge common services for charge collection
			#------------------------------------------------------------------
			CUST.GCHRG.drAcctId			= CUST.GLBDATA.account
			CUST.GCHRG.acctCrncyCode	= BANCS.STDIN.homeCrncyCode
			CUST.GCHRG.eventId			= CUST.GLBDATA.fxEventId
			CUST.GCHRG.chrgAmt			= CUST.GLBDATA.chargeamt + "|" + BANCS.STDIN.homeCrncyCode
			CUST.GCHRG.tranType			= "T"
			CUST.GCHRG.tranSubType		= "BI"
			
			CALL("gchrgcommon.scr")
			
			IF(CUST.GCHRG.successOrFailure == "S") THEN
			#{
				print(CUST.GCHRG.tranId)
				#}
			ELSE
				#{
				CUST.GLBDATA.errMsg = CUST.GCHRG.gchrgErrMsg
				GOTO NEXTREC
			#}
			ENDIF
		#}
		ENDIF
		NEXTREC:
			sv_p = sv_p + 1
			PRINT(sv_p)
		#}
		DO
		
	ENDOFSCRIPT:
		IF ( CUST.GLBDATA.errMsg != "" ) THEN
		#{
			print(CUST.GLBDATA.errMsg)
			sv_u = urhk_SRV_SetErr(CUST.GLBDATA.errMsg)
			print(sv_u)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
