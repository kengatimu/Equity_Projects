<--START
CHECKSUM="a9718bdb4dcf340cf14a9f982b9847297c6414f09f6b0e46cbc870db44f3bc11"
	TRACE ON
	LIBNAME CUSTOMSO
	
	#================================================
	# Repository creation
	#================================================
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	#================================================
	# Calling com file to write product rpt into temp file
	#================================================
	CUST.DATA.record = ""
	#sv_r = urhk_getEnv("TBA_PROD_ROOT")
	#sv_a = BANCS.OUTPARAM.envValue
	#print(sv_a)
	
	sv_r = urhk_getEnv("FIN_REPORTS_DIR")
	print(sv_r)
	sv_a = BANCS.OUTPARAM.envValue
	print(sv_a)
	CUST.DATA.filePath =  sv_a + "/" + BANCS.STDIN.userId + "/"
	
	sv_x = urhk_getFileLocation("COM|psp1.com")
	print(sv_x)
	
	sv_f = "pspmn002.log"
	print(BANCS.OUTPARAM.fileLocation)
	sv_a = BANCS.OUTPARAM.fileLocation + "psp1.com"
