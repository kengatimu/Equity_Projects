	sv_c = sv_a
	print(sv_c)
	sv_r = SYSTEM(sv_c)
	print(sv_r)
	
	sv_b = "pspmn002.log"
	sv_t = urtn_fileOpen(sv_b+"|r")
	print(sv_t)
	sv_y = sv_t
	print(sv_y)
	sv_t = urtn_fileRead(sv_y + "|CUST.DATA.record")
	print(sv_t)
	sv_u = urtn_fileClose(sv_y)
	BANCS.OUTPUT.fileoutput = CUST.DATA.record
	
	sv_a = "rm -f "+ sv_f
	sv_c = SYSTEM(sv_a)
	print(sv_a)
	
