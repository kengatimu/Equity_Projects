#-----------------------------------------------------------------------
# Description       : This script is called on click of Accept
# Input             : crncy,amtRcvd
# Output            : field value to front end
# Menu Option       : HCASHX
# Called script     : None
# Calling script    : None
# Modification History  : None
#  SLN       Date         Author             Changes Summary
#  0.1     06-May-2013   Eshan Babbar         0.0
#-----------------------------------------------------------------------
<--START
CHECKSUM="14ecaf5896bc80a3211f72662d0ec80d1b7a5bb7e96057f1dd8f7993652a6c3e"
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CASHX") == 0) THEN
	#{
		CREATECLASS("CUST", "CASHX", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#  Declaration of variables used in script
	#------------------------------------------------------------------------------
	CUST.CASHX.crncy =  TOUPPER(TRIM(BANCS.INPUT.crncy))
	#------------------------------------------------------------------------------
	#  validating currency
	#------------------------------------------------------------------------------
	IF(CUST.CASHX.crncy == "") THEN
	#{
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
		CUST.CASHX.errorMsg = "Enter Currency"
		sv_z = "Error_0|ERROR^" + CUST.CASHX.errorMsg + "^crncy"
		sv_u = urhk_SetOrbOut(sv_z)
		CUST.CASHX.successFlg = "F"
		GOTO STEP1
		#}
	ELSE
		#{
		sv_r = urhk_B2k_valCrncy(CUST.CASHX.crncy)
		IF(sv_r !=0) THEN
		#{
			sv_w = "SUCCESSORFAILURE|N"
			sv_u = urhk_SetOrbOut(sv_w)
			CUST.CASHX.errorMsg = "Enter Valid Currency"
			sv_z = "Error_0|ERROR^" + CUST.CASHX.errorMsg + "^crncy"
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CASHX.successFlg = "F"
			GOTO STEP1
		#}
		ENDIF
	#}
	ENDIF
	BANCS.OUTPUT.SuccessOrFailure = "S"
	sv_w = ""
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	STEP1:
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","CASHX") != 0) THEN
		#{
			DELETECLASS ("CUST","CASHX")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
