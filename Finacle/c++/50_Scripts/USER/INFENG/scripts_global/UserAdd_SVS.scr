<--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
	####################################################################
	# RI ADD
	####################################################################


		CALL("SVSUserAdd_Req.scr")
		CALL("finacleUserAdd_urhk.scr")
		CALL("SVSUserAdd_Res.scr")
		
		IF(CUST.INTERFACE.svs_errorMsgFlg== "N")THEN
		#{
			
			sv_z = "SVSAdd_RES.Status|SUCCESS"
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
			
			sv_z = "SVSAdd_RES.svs_mesg|" + CUST.INTERFACE.svs_Mesg
		
			CUST.INTERFACE.SVS_USER_FLG  = "SUCCESS"
			CUST.INTERFACE.SVS_REMARKS  = "USER CREATED SUCCESSFULLY"
		#}
		ELSE
		#{
			sv_a = "SVSAdd_RES.Status|ERROR"
			IF(((CUST.INTERFACE.svs_errorCode=="") AND (CUST.INTERFACE.svs_errorDesc=="")) OR (CUST.INTERFACE.svs_errorCode=="SYSERR"))THEN
			#{
				CUST.INTERFACE.svs_errorCode= "SYSERR"
				CUST.INTERFACE.svs_errorDesc= "Could not get response from server"
				sv_z = "SVSAdd_RES.svs_errorCode|" + CUST.INTERFACE.svs_errorCode
				sv_u = urhk_SetOrbOut(sv_z)
				PRINT(sv_u)
				
				sv_z = "SVSAdd_RES.svs_errorDesc|" + CUST.INTERFACE.svs_errorDesc
				sv_u = urhk_SetOrbOut(sv_z)
				PRINT(sv_u)

				CUST.INTERFACE.SVS_USER_FLG  = "FAILURE"
				CUST.INTERFACE.SVS_REMARKS  = CUST.INTERFACE.svs_errorDesc

				GOTO ENDOFSCRIPT
			#}
			ENDIF	
			sv_z = "SVSAdd_RES.svs_errorCode|" + CUST.INTERFACE.svs_errorCode
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
			
			sv_z = "SVSAdd_RES.svs_errorDesc|" + CUST.INTERFACE.svs_errorDesc
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
	
			CUST.INTERFACE.SVS_USER_FLG  = "FAILURE"
			CUST.INTERFACE.SVS_REMARKS  = CUST.INTERFACE.svs_errorDesc
		#}
		ENDIF
		
		#TRACE OFF
end-->