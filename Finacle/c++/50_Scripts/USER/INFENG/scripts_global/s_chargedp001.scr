									BANCS.INPARAM.ToCurrency   = CASH.WITH.CrncyCode
									BANCS.INPARAM.InputAmount  = CDOUBLE(COLL.GLBDATA.minBal5)
									BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode 
									BANCS.INPARAM.RateCode     = COLL.GLBDATA.refCode
									BANCS.INPARAM.Rate         = CDOUBLE(COLL.GLBDATA.tmRate)
									sv_u = urhk_B2k_ConvertAmount("") 
									IF (sv_u == 1) THEN
									#{
										PRINT("hai")
										sv_m = sv_m + 1
										#sv_u = urhk_SRV_SetErr("Checking for minimum balance charge failed" + " ,for PartTransrlnum " + COLL.GLBDATA.serialnum )
										GOTO NEXTREC
									#}
									ELSE
									#{
									   CASH.WITH.min_bal = BANCS.OUTPARAM.OutputAmount 
									   PRINT(CASH.WITH.min_bal)
									#}
									ENDIF
								#}
								ENDIF
								IF ((CASH.WITH.ac_sol == COLL.GLBDATA.acSol4) AND (CASH.WITH.schmCode == COLL.GLBDATA.schemeCode16)) THEN
								#{
									BANCS.INPARAM.ToCurrency   = CASH.WITH.CrncyCode
									BANCS.INPARAM.InputAmount  = CDOUBLE(COLL.GLBDATA.minBal3)
									BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode 
									BANCS.INPARAM.RateCode     = COLL.GLBDATA.refCode
									BANCS.INPARAM.Rate         = CDOUBLE(COLL.GLBDATA.tmRate)
									sv_u = urhk_B2k_ConvertAmount("") 
									IF (sv_u == 1) THEN
									#{
										PRINT("hai")
										sv_m = sv_m + 1
										#sv_u = urhk_SRV_SetErr("Checking for minimum balance charge failed" + " ,for PartTransrlnum " + COLL.GLBDATA.serialnum )
										GOTO NEXTREC
									#}
									ELSE
									#{
									   CASH.WITH.min_bal = BANCS.OUTPARAM.OutputAmount 
									   PRINT(CASH.WITH.min_bal)
									#}
									ENDIF
								#}
								ENDIF
								#new porting code
								IF ((BANCS.STDIN.contextBankId == "54" ) OR (BANCS.STDIN.contextBankId == "43"))THEN
								#{
									#new porting changes
									#changes done as per porting3
									IF (((CASH.WITH.ac_sol == "018") OR (CASH.WITH.ac_sol == "081") OR (CASH.WITH.ac_sol == "140") OR (CASH.WITH.ac_sol == "141") OR (CASH.WITH.ac_sol == "147") OR (CASH.WITH.ac_sol == "151")) AND ((CASH.WITH.schmType == "SBA") OR (CASH.WITH.schmType == "CAA")) ) THEN 
									#{
										BANCS.INPARAM.ToCurrency = CASH.WITH.CrncyCode 
										BANCS.INPARAM.InputAmount =cdouble("200000") 
										BANCS.INPARAM.FromCurrency = "KES"  
										BANCS.INPARAM.RateCode="MEAN" 
										BANCS.INPARAM.Rate=cdouble("0") 
										Sv_r = urhk_B2k_ConvertAmount("")  
										if (sv_r ==1) then  
										#{
											COLL.GLBDATA.errMsg = "A Database error has occured. Please contact your DBA."
											BANCS.OUTPUT.successOrFailure = "F"
											GOTO ENDOFSCRIPT
										#}
										ELSE
										#{
											CASH.WITH.min_bal = BANCS.OUTPARAM.OutputAmount
											print(CASH.WITH.min_bal)
										#}
										ENDIF
									#}
									ENDIF
								#}
								ENDIF
								#end of new porting code
								
								PRINT(CASH.WITH.EffAvailableAmt)
								PRINT(CASH.WITH.Tran_Amt)
								CASH.WITH.diff = CDOUBLE(CASH.WITH.EffAvailableAmt) - CDOUBLE(CASH.WITH.Tran_Amt)
								PRINT(CASH.WITH.diff)

								IF (CDOUBLE(CASH.WITH.diff) < CDOUBLE("0")) THEN
								#{
									PRINT("No min bal charge")
								#}
								ELSE
								#{
									IF (CDOUBLE(CASH.WITH.min_bal) > CASH.WITH.diff) THEN
									#{
										CASH.WITH.Min_Flg = "Y"
										PRINT(CASH.WITH.Min_Flg)
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				
				#---------------------------------------------------------------------
				# Checking for Stamp Duty charge
				#---------------------------------------------------------------------
				IF ((BANCS.STDIN.contextBankId != "50") AND (BANCS.STDIN.contextBankId != "55") AND (BANCS.STDIN.contextBankId != "56")) THEN
				#{
					IF (CASH.WITH.schmType == "SBA") THEN
					#{
						BANCS.INPARAM.ToCurrency   = CASH.WITH.CrncyCode
						BANCS.INPARAM.InputAmount  = CDOUBLE(COLL.GLBDATA.dutyChrg)
						BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode 
						BANCS.INPARAM.RateCode     = COLL.GLBDATA.refCode
						BANCS.INPARAM.Rate         = CDOUBLE(COLL.GLBDATA.tmRate)
						sv_u = urhk_B2k_ConvertAmount("") 
						IF (sv_u == 1) THEN
						#{
							PRINT("hai")
							sv_m = sv_m + 1
							#sv_u = urhk_SRV_SetErr("Checking for Stamp Duty charge" + " ,for PartTransrlnum " + COLL.GLBDATA.serialnum )
							GOTO NEXTREC
						#}
						ELSE
						#{
							CASH.WITH.Stmp_amt = BANCS.OUTPARAM.OutputAmount 
							PRINT(CASH.WITH.Stmp_amt)
						#}
						ENDIF
						PRINT(CASH.WITH.Tran_Amt)
						PRINT(CASH.WITH.Stmp_amt)	 
						IF (CDOUBLE(CASH.WITH.Tran_Amt) > CDOUBLE(CASH.WITH.Stmp_amt)) THEN
						#{
							IF (BANCS.STDIN.contextBankId == "54") THEN
							#{
								#CASH.WITH.Stmp_Flg = "N"
								CASH.WITH.Stmp_Flg = "Y"	
								PRINT(CASH.WITH.Stmp_Flg)
							#}
							ELSE
							#{
								CASH.WITH.Stmp_Flg = "Y"
								PRINT(CASH.WITH.Stmp_Flg)
							#}
							ENDIF
							IF(BANCS.STDIN.contextBankId == "43") THEN
							#{
								CASH.WITH.Stmp_Flg = "N"
								PRINT(CASH.WITH.Stmp_Flg)
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF

				#---------------------------------------------------------------------
				# Checking for shadow balance charge
				#---------------------------------------------------------------------
				CASH.WITH.multishdwflg = "N"
				IF ((CASH.WITH.schmType == "CAA") OR (CASH.WITH.schmType == "SBA")) THEN
				#{
					PRINT(CASH.WITH.schmCode)
					PRINT(COLL.GLBDATA.schemeCode3)
					PRINT(COLL.GLBDATA.schemeCode4)
					PRINT(COLL.GLBDATA.schemeCode5)
					PRINT(CASH.WITH.unclearBalance)	
					
					IF ((BANCS.STDIN.contextBankId == "54")  OR (BANCS.STDIN.contextBankId == "43"))THEN
					#{
						IF ((CASH.WITH.schmCode != COLL.GLBDATA.schemeCode3) AND (CASH.WITH.schmCode != COLL.GLBDATA.schemeCode4) AND (CASH.WITH.schmCode != COLL.GLBDATA.schemeCode5)) THEN     
						#{
							CASH.WITH.multishdwflg = "Y"
							PRINT(CASH.WITH.multishdwflg)
						#}
						ENDIF
					#}
					ENDIF
					
					IF ((BANCS.STDIN.contextBankId == "11") OR (BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "56")) THEN
					#{
						IF ((CASH.WITH.schmCode != COLL.GLBDATA.schemeCode3) AND (CASH.WITH.schmCode != COLL.GLBDATA.schemeCode4)) THEN     
						#{
							CASH.WITH.multishdwflg = "Y"
						#}
						ENDIF
					#}
					ENDIF
					
					IF (CASH.WITH.multishdwflg == "Y") THEN
					#{
						IF (FIELDEXISTS((("CUST").("RATE").("EB"+CASH.WITH.Ac_Number))) == 1) THEN
						#{
								CASH.WITH.preEffAvailableAmt = (("CUST").("RATE").("EB"+CASH.WITH.Ac_Number))
								print(CASH.WITH.preEffAvailableAmt)
						#}
						ELSE
						#{
								CASH.WITH.preEffAvailableAmt = CASH.WITH.EffAvailableAmt
						#}
						ENDIF

						#PRINT(CASH.WITH.EffAvailableAmt)
						PRINT(CASH.WITH.preEffAvailableAmt)
						PRINT(CASH.WITH.Tran_Amt)
						#CASH.WITH.diff = CDOUBLE(CASH.WITH.EffAvailableAmt) - CDOUBLE(CASH.WITH.Tran_Amt)
						CASH.WITH.diff = CDOUBLE(CASH.WITH.preEffAvailableAmt) - CDOUBLE(CASH.WITH.Tran_Amt)
						PRINT(CASH.WITH.diff)
						#CASH.WITH.diff = CDOUBLE("-1")
						IF (CASH.WITH.diff < CDOUBLE("0")) THEN
						#{
							PRINT(CASH.WITH.diff)
							CASH.WITH.diff = -(CDOUBLE(CASH.WITH.diff))
							PRINT(CASH.WITH.diff)
							PRINT(CASH.WITH.unclearBalance)

							#---------------------------------------------------------------------
							#--Extra Amt is <= shadow balance
							#---------------------------------------------------------------------
							PRINT(CASH.WITH.unclearBalance)	
							#CASH.WITH.unclearBalance = "10"
							IF (CASH.WITH.diff <= CDOUBLE(CASH.WITH.unclearBalance)) THEN
							#{
								CASH.WITH.Shd_Flg = "Y"
								CASH.WITH.Shd_Amt = CASH.WITH.diff
								PRINT(CASH.WITH.Shd_Flg)
								PRINT(CASH.WITH.Shd_Amt)
							#}
							ELSE
							#{
								IF (CDOUBLE(CASH.WITH.unclearBalance) != CDOUBLE("0")) THEN
								#{
									CASH.WITH.Shd_Flg = "Y"
									CASH.WITH.Shd_Amt = CASH.WITH.unclearBalance
									PRINT(CASH.WITH.Shd_Amt)
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				NEXTREC:
 					
						CALL("onlinechargesdp001.scr")	
			            
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	EXITREC:
	sv_l = sv_l + 1
	PRINT(sv_l)
#}
DO
PRINT(sv_m)
IF (sv_m != "") THEN 
#{
	BANCS.OUTPUT.successOrFailure = "F"
#}
ENDIF

IF (BANCS.STDIN.contextBankId == "56") THEN
#{
	#CALL("fxcreddp001.scr")
#}
ENDIF

ENDOFSCRIPT:
IF (COLL.GLBDATA.errMsg != "") THEN
#{
	sv_u = urhk_SRV_SetErr(COLL.GLBDATA.errMsg)
	PRINT(sv_u)
#}
ENDIF
#TRACE OFF
EXITSCRIPT
END-->
