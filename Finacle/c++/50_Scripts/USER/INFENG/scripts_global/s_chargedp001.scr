		IF ((BANCS.STDIN.contextBankId == "56") AND (BANCS.STDIN.userWorkClass == "060")) THEN
		#{
			IF((COLL.GLBDATA.acctownership == "O") AND (COLL.GLBDATA.sub_type =="NR")) THEN
			#{
			CALL ("TellerLimitCheck.scr")
			
			#}
			ENDIF

		#}
		ENDIF
	#}
	ELSE
