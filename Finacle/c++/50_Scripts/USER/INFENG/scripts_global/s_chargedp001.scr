				GOTO ENDOFSCRIPT
			#}
			ENDIF 
		#}
		ENDIF 

	#}
	ENDIF

#-------------------Adding charges for Deposits through Sol 2011 ----------------#

	IF (((BANCS.STDIN.contextBankId == "11") OR (BANCS.STDIN.contextBankId == "50")) AND (BANCS.STDIN.menuId == "HTM")) THEN
	#{
		IF (COLL.GLBDATA.sub_type == "NR") THEN 
		#{
			CASH.WITH.type		= COLL.GLBDATA.tran_type
			CASH.WITH.stype  	= COLL.GLBDATA.sub_type
			CASH.WITH.ac_num    = COLL.GLBDATA.account
			CASH.WITH.tran_amt  = COLL.GLBDATA.tran_amt
			print(COLL.GLBDATA.account)

			sv_s = "ac_sol,CrncyCode|"
			sv_s = sv_s + "SELECT sol_id,ACCT_CRNCY_CODE "
			sv_s = sv_s + "FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE foracid = ?SVAR "
			sv_s = sv_s + "AND acct_cls_flg != 'Y' "
			sv_s = sv_s + "AND del_flg = 'N' "
			sv_s = sv_s + "AND bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = COLL.GLBDATA.account + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{	
				COLL.GLBDATA.account1 = COLL.GLBDATA.account
				print (COLL.GLBDATA.account1)
				COLL.GLBDATA.ac_sol = BANCS.OUTPARAM.ac_sol
				PRINT(COLL.GLBDATA.ac_sol)
				COLL.GLBDATA.CrncyCode = BANCS.OUTPARAM.CrncyCode
				PRINT(COLL.GLBDATA.CrncyCode)
			ENDIF
			
		CALL("onlinechargesdp001.scr")
		#}
		ENDIF 
	#}
	ENDIF

#-------------End of Adding charges for Deposits through Sol 2011 ----------------#
########################################################################################################
#-----------------Adding charges for inward clearing in bank_id 54 11 & bank_id 56 ----------------#
########################################################################################################

	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "56") OR (BANCS.STDIN.contextBankId == "11") OR (BANCS.STDIN.contextBankId == "43")) THEN
	#{
		IF ((COLL.GLBDATA.tran_type == "T") AND (COLL.GLBDATA.sub_type == "I") AND (COLL.GLBDATA.partTrantype == "D")) THEN 
		#{
			CASH.WITH.type = COLL.GLBDATA.tran_type
			CASH.WITH.stype = COLL.GLBDATA.sub_type
			CASH.WITH.ac_num = COLL.GLBDATA.account
			CASH.WITH.tran_amt = COLL.GLBDATA.tran_amt
			print(COLL.GLBDATA.account)
						
			sv_s = "ac_sol,CrncyCode|"
			sv_s = sv_s + "SELECT sol_id,ACCT_CRNCY_CODE "
			sv_s = sv_s + "FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE foracid = ?SVAR "
			sv_s = sv_s + "AND acct_cls_flg != 'Y' "
			sv_s = sv_s + "AND del_flg = 'N' "
			sv_s = sv_s + "AND bank_id = ?SVAR"
			sv_s = sv_s + "AND acct_ownership !='O' "
			sv_s = sv_s + "AND schm_code not in ('CA217','CA218','SB190','CA219') "

			PRINT(sv_s)

			BANCS.INPARAM.BINDVARS = COLL.GLBDATA.account + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)

			IF (sv_d == 0) THEN
			#{
				COLL.GLBDATA.account1 = COLL.GLBDATA.account
				print (COLL.GLBDATA.account1)
				COLL.GLBDATA.ac_sol = BANCS.OUTPARAM.ac_sol
				PRINT(COLL.GLBDATA.ac_sol)
				COLL.GLBDATA.CrncyCode = BANCS.OUTPARAM.CrncyCode
				PRINT(COLL.GLBDATA.CrncyCode)
						
				COLL.GLBDATA.exemptflg = "N"
				sv_s = "COUNT|SELECT COUNT(1) FROM CUSTOM.ACCT_EXEMPTION_TABLE "
				sv_s = sv_s + " WHERE FORACID = ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR"
				sv_s = sv_s + " AND del_flg = 'N' "
				sv_s = sv_s + " AND EXEMPT_CODE in('ACCT','LDFEE','INWARD') "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = COLL.GLBDATA.account + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_u =  urhk_dbSelectWithBind(sv_s)
				IF(sv_u == 0) THEN
				#{ 
					PRINT(BANCS.OUTPARAM.COUNT)
					IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
					#{
						COLL.GLBDATA.exemptflg = "Y"
					#}
					ELSE
					#{
						COLL.GLBDATA.exemptflg = "N"
					#}
					ENDIF
					IF (COLL.GLBDATA.exemptflg == "N") THEN
					#{
						CALL("onlinechargesdp001.scr")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF 
	#}
	ENDIF

########################################################################################################
#-------------End of Adding charges for inward clearing in bank_id 54, 11 & bank_id 56----------------#
########################################################################################################

	IF (BANCS.STDIN.contextBankId == "56") THEN
	#{
		##################START control X###################################Ewin.zico
		COLL.GLBDATA.limitacc="N"
		IF (CDOUBLE(COLL.GLBDATA.tranAmount) > CDOUBLE("9999999999")) THEN
		#{
				IF (BANCS.STDIN.userWorkClass == "350") THEN
				#{
					IF (CDOUBLE(COLL.GLBDATA.tranAmount) > CDOUBLE("15000000000")) THEN
					#{

						COLL.GLBDATA.limitacc="Y"
					#}	print(COLL.GLBDATA.limitacc)
					ELSE
					#{
						COLL.GLBDATA.limitacc="N"
						print(COLL.GLBDATA.limitacc)
					#}
					ENDIF
				#}
				ELSE
				#{
					COLL.GLBDATA.limitacc="Y"
					print(COLL.GLBDATA.limitacc)
				#}
				ENDIF


			IF ((COLL.GLBDATA.acctownership!="O") AND (COLL.GLBDATA.limitacc=="Y")) THEN
			#{
				COLL.GLBDATA.errMsg = "INVALID AMOUNT.....confirm "
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		##################END control X#####################################Edwin.zico
	#}
	ENDIF

	IF (BANCS.STDIN.contextBankId == "50") THEN
	#{
		### TERM DEPOSIT RESTRICT ### 
		IF ((COLL.GLBDATA.schmType == "TDA")) THEN 
		#{
			IF ((COLL.GLBDATA.partTrantype =="D") AND (BANCS.STDIN.userWorkClass != "999")) THEN 
			#{
				COLL.GLBDATA.errMsg = "only worklass 600 allowed."
				BANCS.OUTPUT.successOrFailure="F" 
				GOTO ENDOFSCRIPT
			#}
			ENDIF 
		#}
		ENDIF 

		#*************START ATM Tfr Transaction by only 110 and above 
		IF ((COLL.GLBDATA.bacid == "CDCISTLMNT") OR (COLL.GLBDATA.bacid == "ATMTELLER1") OR (COLL.GLBDATA.bacid == "ATMTELLER")) THEN 
		#{
			IF (BANCS.STDIN.userWorkClass < "110" ) THEN 
			#{
				COLL.GLBDATA.errMsg = "Insufficent Workclass For ATM GLs( >110 )."
				BANCS.OUTPUT.successOrFailure="F" 
				GOTO ENDOFSCRIPT
			#}
			ENDIF 
		#}
		ENDIF 
		#*************END ATM Tfr Transaction by only 110 and above 

		IF (COLL.GLBDATA.bacid == "RESERVE") THEN 
		#{
			IF ((BANCS.STDIN.roleId=="NTL") OR (BANCS.STDIN.roleId=="RTL") OR (BANCS.STDIN.roleId=="CTL") OR (BANCS.STDIN.roleId=="TELLER2") OR (BANCS.STDIN.roleId=="TELLER3")OR (BANCS.STDIN.roleId=="TELLER4")) THEN      
			#{
				IF (COLL.GLBDATA.solId != BANCS.STDIN.mySolId) THEN 
				#{
					COLL.GLBDATA.errMsg = "Intersol Transcation into this account not allowed"
					BANCS.OUTPUT.successOrFailure="F" 
					GOTO ENDOFSCRIPT
				#}
				ENDIF 
			#}
			ELSE 
			#{
				IF (BANCS.STDIN.userWorkClass < 110) THEN 
				#{
					COLL.GLBDATA.errMsg = "Insufficent Workclass ( >110 )"
					BANCS.OUTPUT.successOrFailure="F" 
					GOTO ENDOFSCRIPT
				#}
				ENDIF 
			#}
			ENDIF 
		#}
		ENDIF 
	#}
	ENDIF
	####END of new porting changes

	IF ((COLL.GLBDATA.sub_type == "NP") AND (BANCS.STDIN.contextBankId != "56")) THEN
	#{		
		sv_s = "schmCode|"
    	sv_s = sv_s + "SELECT schm_code "
    	sv_s = sv_s + "FROM TBAADM.GAM "
    	sv_s = sv_s + "WHERE foracid = ?SVAR "
    	sv_s = sv_s + "AND acct_cls_flg != 'Y' "
    	#sv_s = sv_s + "AND entity_cre_flg = 'Y' "
    	sv_s = sv_s + "AND del_flg = 'N' "
    	sv_s = sv_s + "AND bank_id = ?SVAR"
    	PRINT(sv_s)
    	BANCS.INPARAM.BINDVARS = COLL.GLBDATA.account + "|" + BANCS.STDIN.contextBankId
    	PRINT(BANCS.INPARAM.BINDVARS)
    	sv_d = urhk_dbSelectWithBind(sv_s)
    	PRINT(sv_d)
    	IF (sv_d == 0) THEN
    	#{
			COLL.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
			PRINT(COLL.GLBDATA.schmCode)
			IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43"))THEN
			#{
				IF ((COLL.GLBDATA.myBrCode == COLL.GLBDATA.branchCode) AND ((COLL.GLBDATA.schmCode == COLL.GLBDATA.schmCode1) OR (COLL.GLBDATA.schmCode == COLL.GLBDATA.schmCode2))) THEN				
				#{
					PRINT("TRANDETAILS")
					CALL("trandetailsdp001.scr")
				#}
				ENDIF
			#}
			ELSE
			#{
				CALL("trandetailsdp001.scr")
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF	

	IF (BANCS.STDIN.contextBankId == "56") THEN
	#{
