		COLL.GLBDATA.errMsg = COLL.GLBDATA.account + " Account is Closed/Unverified"
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43"))THEN
	#{
		IF (COLL.GLBDATA.schmCode == "SB128" ) THEN 
		#{
			IF (COLL.GLBDATA.partTrantype=="D") THEN 
			#{
