<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "CAT")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "CAT", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CATEGORYTYPE"))== 0) ) THEN
	#{
   		CUST.CAT.errMsg="please enter CATEGORYTYPE"
		sv_t = "ERROR | " +CUST.CAT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CATEGORYTYPE2"))== 0) ) THEN
	#{
   		CUST.CAT.errMsg="please enter CATEGORYTYPE2"
		sv_t = "ERROR | " +CUST.CAT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CATEGORYTYPE3"))== 0) ) THEN
	#{
   		CUST.CAT.errMsg="please enter CATEGORYTYPE3"
		sv_t = "ERROR | " +CUST.CAT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#-----------------------------------------------------------------------------------------------------
	#ENVIRONMENTAL CATEGORIZATION
	#-----------------------------------------------------------------------------------------------------
	

	sv_s="EValue, EDescription|SELECT c.value, l.localetext"
	sv_s=sv_s + " FROM crmuser.categories c, crmuser.category_lang l "
	sv_s=sv_s + "WHERE C.categorytype =?SVAR AND l.categoryid=c.categoryid "
	sv_s=sv_s + "AND c.bank_id=?SVAR AND l.BANK_ID=?SVAR" 
	print(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.INPUT.CATEGORYTYPE2 + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	IF(sv_c !=0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF


	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	sv_i=1
	WHILE(sv_f==0)
	#{
		CUST.CAT.EValue= BANCS.OUTPARAM.EValue
		print(CUST.CAT.EValue)
		CUST.CAT.EDescription= BANCS.OUTPARAM.EDescription
		print(CUST.CAT.EDescription)

		sv_t = "ENVIRONMENTAL_CATEGORIZATION_STARTS| " + ""
		sv_u = urhk_SetOrbOut(sv_t)


		sv_s="EVALUE"+Format$(sv_i,"%d")+ "|"+ CUST.CAT.EValue
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)

		sv_s="EDESCRIPTION"+Format$(sv_i, "%d")+ "|" + CUST.CAT.EDescription
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)


		sv_i = sv_i + 1 
		sv_f = urhk_dbCursorFetch(sv_n)			
		PRINT(sv_f)

		#}
		DO
		sv_t = "ENVIRONMENTAL_CATEGORIZATION_ENDS| " + ""
		sv_u = urhk_SetOrbOut(sv_t)

		sv_c = urhk_dbCursorClose(sv_n)

	#-----------------------------------------------------------------------------------------------------
	#CLIMATE CATEGORIZATION
	#-----------------------------------------------------------------------------------------------------

	sv_s="CValue, CDescription|SELECT c.value, l.localetext"
	sv_s=sv_s + " FROM crmuser.categories c, crmuser.category_lang l "
	sv_s=sv_s + "WHERE C.categorytype =?SVAR AND l.categoryid=c.categoryid "
	sv_s=sv_s + "AND c.bank_id=?SVAR AND l.BANK_ID=?SVAR" 
	print(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.INPUT.CATEGORYTYPE + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	IF(sv_c !=0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF


	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	sv_i=1
	WHILE(sv_f==0)
	#{
		CUST.CAT.CValue= BANCS.OUTPARAM.CValue
		print(CUST.CAT.CValue)
		CUST.CAT.CDescription= BANCS.OUTPARAM.CDescription
		print(CUST.CAT.CDescription)

		sv_t = "CLIMATE_CATEGORIZATION_STARTS| " + ""
		sv_u = urhk_SetOrbOut(sv_t)


		sv_s="CVALUE"+Format$(sv_i,"%d")+ "|"+ CUST.CAT.CValue
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)

		sv_s="CDESCRIPTION"+Format$(sv_i, "%d")+ "|" + CUST.CAT.CDescription
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)


		sv_i = sv_i + 1 
		sv_f = urhk_dbCursorFetch(sv_n)			
		PRINT(sv_f)

		#}
		DO
		sv_t = "CLIMATE_CATEGORIZATION_ENDS| " + ""
		sv_u = urhk_SetOrbOut(sv_t)

		sv_c = urhk_dbCursorClose(sv_n)


	#-----------------------------------------------------------------------------------------------------
	#ECOSYSTEM
	#-----------------------------------------------------------------------------------------------------	

	sv_s="Value, Description|SELECT c.value, l.localetext"
	sv_s=sv_s + " FROM crmuser.categories c, crmuser.category_lang l "
	sv_s=sv_s + "WHERE C.categorytype =?SVAR AND l.categoryid=c.categoryid "
	sv_s=sv_s + "AND c.bank_id=?SVAR AND l.BANK_ID=?SVAR" 
	print(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.INPUT.CATEGORYTYPE3 + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	IF(sv_c !=0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF


	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	sv_i=1
	WHILE(sv_f==0)
	#{
		CUST.CAT.Value= BANCS.OUTPARAM.Value
		print(CUST.CAT.Value)
		CUST.CAT.Description= BANCS.OUTPARAM.Description
		print(CUST.CAT.Description)

		sv_t = "ECOSYSTEM_STARTS| " + ""
		sv_u = urhk_SetOrbOut(sv_t)


		sv_s="VALUE"+Format$(sv_i,"%d")+ "|"+ CUST.CAT.Value
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)

		sv_s="DESCRIPTION"+Format$(sv_i, "%d")+ "|" + CUST.CAT.Description
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)


		sv_i = sv_i + 1 
		sv_f = urhk_dbCursorFetch(sv_n)			
		PRINT(sv_f)

		#}
		DO
		sv_t = "ECOSYSTEM_ENDS| " + ""
		sv_u = urhk_SetOrbOut(sv_t)

		sv_c = urhk_dbCursorClose(sv_n)



ENDOFSCRIPT:
END-->

