<--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
	####################################################################
	# CRM ADD
	####################################################################

	CALL("CRMUserDel_Req.scr")
	CALL("finacleUserAdd_urhk.scr")
	CALL("CRMUserDel_Res.scr")
	IF(CUST.INTERFACE.crm_errorMsgFlg== "N")THEN
	#{
		
		sv_z = "CRMDel_RES.Status|SUCCESS"
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
		CUST.INTERFACE.CRM_USER_FLG  = "SUCCESS"
		print(CUST.INTERFACE.crm_desc)
		BANCS.INPUT.InpString = CUST.INTERFACE.crm_desc
		BANCS.INPUT.replace = "|"
		BANCS.INPUT.replaceWith = ""
		PRINT(BANCS.INPUT.InpString)
		BANCS.INPUT.OutputString = ""
		CALL("Replacecharacter.scr")
		CUST.INTERFACE.crm_desc = BANCS.INPUT.OutputString
		
		print(CUST.INTERFACE.crm_desc)
		CUST.INTERFACE.crm_desc = LEFT$(CUST.INTERFACE.crm_desc, 80)
		CUST.INTERFACE.CRM_REMARKS  = CUST.INTERFACE.crm_desc
	#}
	ELSE
	#{
		sv_a = "CRMDel_RES.Status|ERROR"
		IF(((CUST.INTERFACE.crm_errorCode=="") AND (CUST.INTERFACE.crm_errorDesc=="")) OR (CUST.INTERFACE.crm_errorCode=="SYSERR"))THEN
		#{
			CUST.INTERFACE.crm_errorCode= "SYSERR"
			CUST.INTERFACE.crm_errorDesc= "Could not get response from server"
			sv_z = "CRMDel_RES.crm_errorCode|" + CUST.INTERFACE.crm_errorCode
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
			
			sv_z = "CRMDel_RES.crm_errorDesc|" + CUST.INTERFACE.crm_errorDesc
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
			CUST.INTERFACE.CRM_USER_FLG  = "FAILURE"
			
			
			print(CUST.INTERFACE.crm_errorDesc)
			BANCS.INPUT.InpString = CUST.INTERFACE.crm_errorDesc
			BANCS.INPUT.replace = "|"
			BANCS.INPUT.replaceWith = ""
			PRINT(BANCS.INPUT.InpString)
			BANCS.INPUT.OutputString = ""
			CALL("Replacecharacter.scr")
			CUST.INTERFACE.crm_errorDesc = BANCS.INPUT.OutputString
			
			print(CUST.INTERFACE.crm_errorDesc)
			CUST.INTERFACE.crm_errorDesc = LEFT$(CUST.INTERFACE.crm_errorDesc, 80)
			CUST.INTERFACE.CRM_REMARKS  = CUST.INTERFACE.crm_errorDesc
			#GOTO ENDOFSCRIPT
		#}
		ENDIF	
		
		sv_z = "CRMDel_RES.crm_errorCode| " + CUST.INTERFACE.crm_errorCode
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
		
		sv_z = "CRMDel_RES.crm_errorDesc| " + CUST.INTERFACE.crm_errorDesc
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)

		
		CUST.INTERFACE.CRM_USER_FLG  = "FAILURE"
		print(CUST.INTERFACE.crm_errorDesc)
		BANCS.INPUT.InpString = CUST.INTERFACE.crm_errorDesc
		BANCS.INPUT.replace = "|"
		BANCS.INPUT.replaceWith = ""
		PRINT(BANCS.INPUT.InpString)
		BANCS.INPUT.OutputString = ""
		CALL("Replacecharacter.scr")
		CUST.INTERFACE.crm_errorDesc = BANCS.INPUT.OutputString
		
		print(CUST.INTERFACE.crm_errorDesc)
		CUST.INTERFACE.crm_errorDesc = LEFT$(CUST.INTERFACE.crm_errorDesc, 80)
		CUST.INTERFACE.CRM_REMARKS  = CUST.INTERFACE.crm_errorDesc
		#GOTO ENDOFSCRIPT
	#}
	ENDIF

	#TRACE OFF
end-->
