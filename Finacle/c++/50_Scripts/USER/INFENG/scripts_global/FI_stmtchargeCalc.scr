<--START
TRACE ON
        #------------------------------------#
        #-- Repository And Class Creation  --#
        #------------------------------------#



		IF(REPEXISTS("CUST") == 0) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF

		IF (CLASSEXISTS("CUST", "STMT") == 0) THEN
		#{
			CREATECLASS("CUST", "STMT", 5)
		#}
		ENDIF	


		sv_q = urhk_B2k_PrintRepos("BANCS")
		print(sv_q)	



	IF( (FIELDEXISTS(("BANCS").("INPUT").("NOPGS"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg="Please enter the Pagess "
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("FORACID"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg="please enter the Account number"
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CERTIFYFLAG"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg=" Please indicate if Certify or not "
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	
		IF( (FIELDEXISTS(("BANCS").("INPUT").("COMMFLAG"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg=" Please indicate if commissioned is charged  or not "
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF




	#----------------------------------------------------------------------------------------------
	# CHARGE CALCULATION
	#----------------------------------------------------------------------------------------------

		CUST.STMT.CHARGEAMT =CINT(BANCS.INPUT.NOPGS) * 180
		print(CUST.STMT.CHARGEAMT)
		
		CUST.STMT.CERTIFYFLAG=BANCS.INPUT.CERTIFYFLAG
		print(CUST.STMT.CERTIFYFLAG)
		
		IF(CUST.STMT.CERTIFYFLAG == "Y") THEN
		#{
		CUST.STMT.CERTFEE=1000
		#}
		ELSE
		#{
		CUST.STMT.CERTFEE=0
		#}
        ENDIF
		
		CUST.STMT.COMMFLAG=BANCS.INPUT.COMMFLAG
		IF(CUST.STMT.COMMFLAG == "Y") THEN
		#{
		#CUST.STMT.COMMFEE=(CINT(CUST.STMT.CHARGEAMT) +CINT(CUST.STMT.CERTFEE))*0.1
		CUST.STMT.COMMFEE=0.00

		#}
		ELSE
		#{
		CUST.STMT.COMMFEE=0.00
		#}
        ENDIF
		
		#CUST.STMT.exduty = (CINT(CUST.STMT.CHARGEAMT) +CINT(CUST.STMT.CERTFEE))*0.2
		CUST.STMT.exduty="0.00"
		print(CUST.STMT.exduty)
		CUST.STMT.exdutyC = CINT(CUST.STMT.exduty)
		PRINT(CUST.STMT.exdutyC)
	
	CUST.STMT.totaldeductions = (CINT(CUST.STMT.CHARGEAMT)) + CINT(CUST.STMT.exduty)+ CINT(CUST.STMT.CERTFEE)+CINT(CUST.STMT.COMMFEE)
	print(CUST.STMT.totaldeductions)

     if(CUST.STMT.CERTFEE =="") then
                CUST.STMT.CERTFEE="0"
       endif

	#----------------------------------------------------------------------------------------------
	# SENDING RESPONSE
	#----------------------------------------------------------------------------------------------
	sv_t = "CHARGE| " +CUST.STMT.CHARGEAMT
	sv_u = urhk_SetOrbOut(sv_t)

	sv_t = "EXCISEFEE| " + CUST.STMT.exduty
	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_t="CertificationFee|"+ CUST.STMT.CERTFEE
	sv_u=urhk_SetOrbOut(sv_t)
	
    sv_t="CommissionFee|"+ CUST.STMT.COMMFEE
	sv_u=urhk_SetOrbOut(sv_t)

	sv_t = "TOTALCHARGE| " + CUST.STMT.totaldeductions 
	sv_u = urhk_SetOrbOut(sv_t)


TRACE OFF
END-->
