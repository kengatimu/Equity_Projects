#-------------------------------------------------------------------------------------
#    Name               : formatacctdp003.scr
#    Description        : This script is used for validation
#    Date               : 22-02-2013
#    Author             : Farhan
#    Called Script      : tmdet_custom.jsp
#    Calling Script     : NA
#    Menu Option        : HTM
#    Srl. No            Date                  Author              Description.
#    -------            ----                  ------              ----------------
#    1.0               22-02-2013             Farhan              Original Version
#-------------------------------------------------------------------------------------
<--START
#TRACE ON

#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","FOAT") == 0) THEN
#{
        CREATECLASS("CUST","FOAT",5)
#}
ENDIF

IF( FIELDEXISTS(BANCS.INPUT.funcCode)) THEN
#{
        CUST.FOAT.function = BANCS.INPUT.funcCode
		PRINT(CUST.FOAT.function)
#}
ENDIF

CUST.FOAT.errMsg = ""
CUST.FOAT.ref = ""
CUST.FOAT.ref = BANCS.INPUT.refNum

IF( FIELDEXISTS(BANCS.INPUT.acctnum)) THEN
#{
	CUST.FOAT.account = BANCS.INPUT.acctnum
	PRINT(CUST.FOAT.account)
#}
ENDIF

sv_a = CUST.FOAT.account
sv_u = urhk_getAcctDetailsInRepository(sv_a)
print(sv_u)
IF (sv_u != 0) THEN
#{
	CUST.FOAT.errMsg = "Enter valid account number. "
	sv_b = "Val1|" + CUST.FOAT.errMsg
	sv_z = urhk_SetOrbOut(sv_b)
	EXITSCRIPT
#}
ENDIF

# Kim Start-Displaying ref code in entity 50:
IF ((BANCS.STDIN.contextBankId  == "54") OR (BANCS.STDIN.contextBankId == "50")OR (BANCS.STDIN.contextBankId == "56")) THEN
#{


		sv_s = "bacid,solid,schmCode,glheadcode,acctowner,custid,acctcrncycode|SELECT bacid,sol_id,schm_Code,gl_sub_head_code,acct_ownership,cif_id,acct_crncy_code "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE foracid = ?SVAR " 
		sv_s = sv_s + "AND acct_cls_flg ='N' "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		sv_s = sv_s + "AND del_flg = 'N' "
		BANCS.INPARAM.BINDVARS = CUST.FOAT.account + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
			
				
		CUST.FOAT.glheadcode = BANCS.OUTPARAM.glheadcode
		PRINT(CUST.FOAT.glheadcode)

		CUST.FOAT.bacid = BANCS.OUTPARAM.bacid
		PRINT(CUST.FOAT.bacid)

		CUST.FOAT.solid = BANCS.OUTPARAM.solid

		PRINT(CUST.FOAT.solid)

		CUST.FOAT.acctownership = BANCS.OUTPARAM.acctowner
		PRINT(CUST.FOAT.acctownership)

		CUST.FOAT.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(CUST.FOAT.schmCode)

		CUST.FOAT.custid = BANCS.OUTPARAM.custid
		PRINT(CUST.FOAT.custid)

		CUST.FOAT.acctcrncycode = BANCS.OUTPARAM.acctcrncycode
		PRINT(CUST.FOAT.acctcrncycode)


		BANCS.INPUT.moduleName = "NEWFORMACCT"

		BANCS.INPUT.parameterId = "GLSUB1"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.FOAT.glsub1 = BANCS.OUTPUT.parameterVal
		#}
		ELSE
		#{
			CUST.FOAT.errMsg = "gl sub head 1 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		BANCS.INPUT.parameterId = "GLSUB2"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.FOAT.glsub2 = BANCS.OUTPUT.parameterVal
		#}
		ELSE
		#{
			CUST.FOAT.errMsg = "gl sub head 2 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		BANCS.INPUT.parameterId = "GLSUB3"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.FOAT.glsub3 = BANCS.OUTPUT.parameterVal
		#}
		ELSE
		#{
			CUST.FOAT.errMsg = "gl sub head 3 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		BANCS.INPUT.parameterId = "GLSUB4"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.FOAT.glsub4 = BANCS.OUTPUT.parameterVal
		#}
		ELSE
		#{
			CUST.FOAT.errMsg = "gl sub head 4 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		BANCS.INPUT.parameterId = "ACSOL"
		CALL("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.FOAT.acsol = BANCS.OUTPUT.parameterVal
		#}
		ELSE
		#{
			CUST.FOAT.errMsg = "Account sol Id setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF


		IF (((CUST.FOAT.glheadcode >= CUST.FOAT.glsub1) AND (CUST.FOAT.glheadcode <= CUST.FOAT.glsub2)) OR ((CUST.FOAT.glheadcode == CUST.FOAT.glsub3) OR (CUST.FOAT.glheadcode == CUST.FOAT.glsub4))) THEN
		#{				
			IF (CUST.FOAT.solid == CUST.FOAT.acsol) THEN
			#{
				IF (CUST.FOAT.ref == "") THEN
				#{
					CUST.FOAT.errMsg = "ENTER DEPT CODE in REF NO FIELD........."
					GOTO ENDOFSCRIPT
				#}
				ELSE
				#{
					sv_s = "REFNUM,DESC|SELECT ref_code,ref_desc "
					sv_s = sv_s + "FROM TBAADM.RCT "
					sv_s = sv_s + "WHERE ref_code = ?SVAR "
					sv_s = sv_s + "AND REF_rec_type = 'AK' "
					sv_s = sv_s + "AND DEL_FLG = 'N' "
					sv_s = sv_s + "AND bank_id = ?SVAR "
					sv_s = sv_s + "AND del_flg = 'N' "
					BANCS.INPARAM.BINDVARS = CUST.FOAT.ref + "|" + BANCS.STDIN.contextBankId
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d !=0) THEN
					#{  
						CUST.FOAT.errMsg = "INVALID CODE"
						GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						CUST.FOAT.refnum = BANCS.OUTPARAM.REFNUM
						CUST.FOAT.desc = BANCS.OUTPARAM.DESC
						
						sv_a = " DEPT CODE :  "
						sv_a = sv_a + CUST.FOAT.refnum + "    DEPT : "
						sv_a = sv_a + CUST.FOAT.desc 
						
						sv_b = "refnum|"+ CUST.FOAT.refnum
						sv_z = urhk_SetOrbOut(sv_b)

						sv_b = "desc|"+CUST.FOAT.desc
						sv_z = urhk_SetOrbOut(sv_b)	

						# Kim-  Trimming ref Desc to 30 character Max.

						sv_b = "desc|"+ LEFT$(CUST.FOAT.desc,30)
						sv_z = urhk_SetOrbOut(sv_b)	
					
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

#}
ENDIF

ENDOFSCRIPT:
IF (CUST.FOAT.errMsg != "") THEN
#{
	sv_b = "Error|" + CUST.FOAT.errMsg
	sv_z = urhk_SetOrbOut(sv_b)
#}
ENDIF

TRACE OFF
EXITSCRIPT
END-->
