<--start
trace on
	sv_r =  REPEXISTS("EBRPT")
	if (sv_r == 0) then
		CREATEREP("EBRPT")
	endif
	sv_r = CLASSEXISTS("EBRPT", "DATA")
	if (sv_r == 0) then
		CREATECLASS("EBRPT", "DATA", 5)
	endif
	
	sv_u = urhk_B2k_PrintRepos("BANCS")
	print(sv_u)
	
	EBRPT.DATA.rptModule = BANCS.INPUT.rptModule
	EBRPT.DATA.rptDiv = BANCS.INPUT.rptDiv
	EBRPT.DATA.rptCode = BANCS.INPUT.rptName
	
	
	sv_m = "moduleDesc,divDesc,rptCode,rptDesc |"
	sv_m = sv_m + " select decode(report_module,'L','Liabilities',report_module),"
	sv_m = sv_m + " report_division,report_code,report_desc "
	sv_m = sv_m + " from custom.c_ebrpt "
	sv_m = sv_m + " Where report_code = '"+ EBRPT.DATA.rptCode +"' "
	sv_m = sv_m + " AND report_module = '"+ EBRPT.DATA.rptModule +"' "
	sv_m = sv_m + " AND report_division = '"+ EBRPT.DATA.rptDiv +"' "
	sv_m = sv_m + " AND del_flg = 'N'"
	
	sv_n = urhk_dbSelectWithBind(sv_m)
	
	if (sv_n == 0) then
		EBRPT.DATA.moduleDesc = BANCS.OUTPARAM.moduleDesc
		EBRPT.DATA.divDesc = BANCS.OUTPARAM.divDesc
		EBRPT.DATA.rptCode = BANCS.OUTPARAM.rptCode
		EBRPT.DATA.rptDesc = BANCS.OUTPARAM.rptDesc
	else
		EBRPT.DATA.moduleDesc = ""
		EBRPT.DATA.divDesc = ""
		EBRPT.DATA.rptCode = ""
		EBRPT.DATA.rptDesc = ""
	endif
	
	print(EBRPT.DATA.moduleDesc)
	print(EBRPT.DATA.rptCode)
	
	if (EBRPT.DATA.moduleDesc != "") then
		sv_a = urhk_setOrbOut("rptModule1|" + EBRPT.DATA.moduleDesc)
		print(sv_a)
	else
		sv_a = urhk_setOrbOut("rptModule1| ")
		print(sv_a)
	endif
	if (EBRPT.DATA.divDesc != "") then
		sv_a = urhk_setOrbOut("rptDiv|" + EBRPT.DATA.divDesc)
		print(sv_a)
	else
		sv_a = urhk_setOrbOut("rptDiv| ")
		print(sv_a)
	endif
	if (EBRPT.DATA.rptCode != "") then
		sv_a = urhk_setOrbOut("rptName|" + EBRPT.DATA.rptCode)
		print(sv_a)
	else
		sv_a = urhk_setOrbOut("rptName| ")
		print(sv_a)
	endif
	if (EBRPT.DATA.rptDesc != "") then
		sv_a = urhk_setOrbOut("rptTitle|" + EBRPT.DATA.rptDesc)
		print(sv_a)
	else
		sv_a = urhk_setOrbOut("rptTitle| ")
		print(sv_a)
	endif
	
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	
trace off
end-->


