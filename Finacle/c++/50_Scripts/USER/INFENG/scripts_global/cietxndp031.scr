<--START
CHECKSUM="7519b012b8cce5616914b098ad0113e713fa0c98da838d71e4d1472408ffdc89"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.mode = " "
	CUST.CIETXN.recordCount = "0"
	CUST.CIETXN.entityId = " "
	CUST.CIETXN.acctNum = " "
	CUST.CIETXN.acid = " "
	CUST.CIETXN.mpTopic = " "
	CUST.CIETXN.mpMemoText = " "
	CUST.CIETXN.mpExceptionCode = " "
	CUST.CIETXN.mpExceptionCodeDesc = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.mode))THEN
	#{
		IF(TRIM(BANCS.INPUT.mode) != "")THEN
		#{
			CUST.CIETXN.mode = TOUPPER(TRIM(BANCS.INPUT.mode))
			print(CUST.CIETXN.mode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.CIETXN.mode == "R")THEN
	#{
		GOTO RAISE_MODE
	#}
	ENDIF
	
	IF(CUST.CIETXN.mode == "C")THEN
	#{
		IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
		#{
			IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
			#{
				CUST.CIETXN.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
				print(CUST.CIETXN.acctNum)
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = CUST.CIETXN.acctNum
		sv_z = urhk_B2k_ForacidToAcid(sv_s)
		print(sv_z)
		
		IF(sv_z == 0)THEN
		#{
			CUST.CIETXN.acid = BANCS.OUTPARAM.Acid
			PRINT(CUST.CIETXN.acid)
		#}
		ENDIF
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.acid
		sv_s = "recordCount|"
		sv_s = sv_s + " SELECT COUNT(*)"
		sv_s = sv_s + " FROM TBAADM.MPT"
		sv_s = sv_s + " WHERE ACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG ='N'"
		sv_s = sv_s + " AND ENTITY_CRE_FLG ='Y'"
		sv_s = sv_s + " AND MEMO_PAD_EXCP_CODE IS NOT NULL"
		print(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.recordCount = BANCS.OUTPARAM.recordCount
			PRINT(CUST.CIETXN.recordCount)
		#}
		ENDIF
		
		sv_u = urhk_SetOrbOut("recordCount|"+CUST.CIETXN.recordCount)
		print(sv_u)
		
	#}
	ENDIF
	
	GOTO ENDOFSCRIPT
	
	###########################################################################################
	# MEMO PAD RAISE MODE
	###########################################################################################
	
	RAISE_MODE:
		
		IF(FIELDEXISTS(BANCS.INPUT.recordCount))THEN
		#{
			IF(TRIM(BANCS.INPUT.recordCount) != "")THEN
			#{
				CUST.CIETXN.recordCount = TOUPPER(TRIM(BANCS.INPUT.recordCount))
				print(CUST.CIETXN.recordCount)
			#}
			ENDIF
		#}
		ENDIF
		
		sv_u = urhk_SetOrbOut("recordCount|"+CUST.CIETXN.recordCount)
		print(sv_u)
		
		IF(FIELDEXISTS(BANCS.INPUT.entityId))THEN
		#{
			IF(TRIM(BANCS.INPUT.entityId) != "")THEN
			#{
				CUST.CIETXN.entityId = TOUPPER(TRIM(BANCS.INPUT.entityId))
				print(CUST.CIETXN.entityId)
			#}
			ENDIF
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
		#{
			IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
			#{
				CUST.CIETXN.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
				print(CUST.CIETXN.acctNum)
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = CUST.CIETXN.acctNum
		sv_z = urhk_B2k_ForacidToAcid(sv_s)
		print(sv_z)
		
		IF(sv_z == 0)THEN
		#{
			CUST.CIETXN.acid = BANCS.OUTPARAM.Acid
			PRINT(CUST.CIETXN.acid)
		#}
		ENDIF
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.acid
		sv_s = "mpTopic,mpMemoText,mpExceptionCode|"
		sv_s = sv_s + " SELECT MP_TOPIC,MP_MEMO_TEXT,MEMO_PAD_EXCP_CODE"
		sv_s = sv_s + " FROM TBAADM.MPT"
		sv_s = sv_s + " WHERE ACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG ='N'"
		sv_s = sv_s + " AND ENTITY_CRE_FLG ='Y'"
		sv_s = sv_s + " AND MEMO_PAD_EXCP_CODE IS NOT NULL"
		print(sv_s)
		
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		print(sv_c)
		
		IF(sv_c != 0)THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_n)
		
		sv_f = urhk_dbCursorFetch(sv_n)
		print(sv_f)
		
		sv_i = 1
		
		WHILE(sv_f == 0)
		#{
			CUST.CIETXN.mpTopic = BANCS.OUTPARAM.mpTopic
			print(CUST.CIETXN.mpTopic)
			
			CUST.CIETXN.mpMemoText = BANCS.OUTPARAM.mpMemoText
			print(CUST.CIETXN.mpMemoText)
			
			CUST.CIETXN.mpExceptionCode = BANCS.OUTPARAM.mpExceptionCode
			print(CUST.CIETXN.mpExceptionCode)
			
			CUST.CIETXN.mpExceptionCodeDesc = " "
			
			sv_s = "mpExceptionCodeDesc|"
			sv_s = sv_s + " SELECT MSG_LITERAL"
			sv_s = sv_s + " FROM TBAADM.MMSG"
			sv_s = sv_s + " WHERE MSG_ID = ?SVAR"
			sv_s = sv_s + " AND DEL_FLG ='N'"
			sv_s = sv_s + " AND SOURCE_FILE = 'EXCEPTIONS'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = "EXT" + CUST.CIETXN.entityId + CUST.CIETXN.mpExceptionCode
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				IF(CUST.CIETXN.mpExceptionCodeDesc != "")THEN
				#{
					CUST.CIETXN.mpExceptionCodeDesc = BANCS.OUTPARAM.mpExceptionCodeDesc
					PRINT(CUST.CIETXN.mpExceptionCodeDesc)
				#}
				ENDIF
			#}
			ENDIF
			
			sv_s = "mpTopic_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.mpTopic
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			
			sv_s = "mpMemoText_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.mpMemoText
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			
			sv_s = "mpExceptionCode_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.mpExceptionCode
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			
			sv_s = "mpExceptionCodeDesc_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.mpExceptionCodeDesc
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			
			sv_i = sv_i + 1
			
			sv_f = urhk_dbCursorFetch(sv_n)
			print(sv_f)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(sv_n)
		print(sv_c)
		
		
	ENDOFSCRIPT:
		
END-->
