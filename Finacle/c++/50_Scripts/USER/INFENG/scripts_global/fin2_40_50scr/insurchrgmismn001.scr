<--START
CHECKSUM="8a52653006b948f9289d059d728fd93441ea760838d9306aa5031ad3257b452c"
	TRACE ON
	
	#-----------------------------------------------------------------------------------------------
	# Creating Repository
	#-----------------------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CHRGMIS") == 0) THEN
	#{
		CREATECLASS("CUST","CHRGMIS", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM", 5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# Initializing the variables
	#-----------------------------------------------------------------------------------------------
	CUST.CHRGMIS.errMsg 	= ""
	CUST.CHRGMIS.partSrlNo 	= "0"
	
	#-----------------------------------------------------------------------------------------------
	# Getting all the values FROM CPARAM
	#-----------------------------------------------------------------------------------------------
	CALL("insurchrgmisdp001.scr")
	
	#--------------------------------------------------------------------------
	# Selecting total number of accounts which are not charged
	#--------------------------------------------------------------------------
	CUST.CHRGMIS.BODDate = LEFT$(BANCS.STDIN.BODDate,10)
	PRINT(CUST.CHRGMIS.BODDate)
	
	sv_s =        " dtdCount|"
	sv_s = sv_s + " SELECT count(1)"
	sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
	sv_s = sv_s + " WHERE GAM.acid=DTD.acid"
	sv_s = sv_s + " AND GAM.bank_id =DTD.bank_id"
	sv_s = sv_s + " AND GAM.sol_id=?SVAR"
	sv_s = sv_s + " AND GAM.acct_ownership='C' "
	sv_s = sv_s + " AND GAM.acct_crncy_code=?SVAR"
	sv_s = sv_s + " AND GAM.schm_type IN ('CAA','SBA')"
	sv_s = sv_s + " AND INSTR(?SVAR,CONCAT(CONCAT('!',GAM.schm_code),'!')) = 0"
	sv_s = sv_s + " AND GAM.acct_cls_flg!='Y'"
	sv_s = sv_s + " AND GAM.del_flg ='N'"
	sv_s = sv_s + " AND DTD.del_flg ='N'"
	sv_s = sv_s + " AND DTD.tran_id LIKE '%" + BANCS.STDIN.contextBankId + "%'"
	sv_s = sv_s + " AND DTD.tran_type='C'"
	sv_s = sv_s + " AND DTD.tran_sub_type='NP'"
	sv_s = sv_s + " AND DTD.part_tran_type='D'"
	sv_s = sv_s + " AND DTD.sol_id=GAM.sol_id"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	sv_s = sv_s + " AND NOT EXISTS( "
	sv_s = sv_s +                   " SELECT 1 "
	sv_s = sv_s +                   " FROM TBAADM.DTD"
	sv_s = sv_s +                   " WHERE DTD.acid=GAM.acid "
	sv_s = sv_s +                   " AND GAM.bank_id =DTD.bank_id"
	sv_s = sv_s +                   " AND DTD.del_flg ='N'"
	sv_s = sv_s +                   " AND DTD.tran_type='T'"
	sv_s = sv_s +                   " AND DTD.tran_sub_type='BI'"
	sv_s = sv_s +                   " AND DTD.part_tran_type='D'"
	sv_s = sv_s +                   " AND DTD.sol_id=GAM.sol_id"
	sv_s = sv_s +                   " AND INSTR(?SVAR,CONCAT(CONCAT('!',DTD.tran_amt),'!')) > 0)"
	
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS	=""
	BANCS.INPARAM.BINDVARS	=BANCS.INPARAM.BINDVARS+ BANCS.STDIN.mySolId  + "|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ BANCS.STDIN.homeCrncyCode +"|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ CUST.CPARAM.schmCodeI + "|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ CUST.CPARAM.tranAmtI
	
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.CHRGMIS.recCount = BANCS.OUTPARAM.dtdCount
		PRINT(CUST.CHRGMIS.recCount)
		#}
	ELSE
		#{
		CUST.CHRGMIS.errMsg= "Error in getting count from DTD"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CINT(CUST.CHRGMIS.recCount) == 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------
	#  The bacid for Cashwithdrawal Cahrge Income Account
	#  & validation for the bacid.
	#------------------------------------------------------------------
	sv_i = CUST.CPARAM.cashWthdBacid+ "|" +BANCS.STDIN.homeCrncyCode+ "|" +BANCS.STDIN.mySolId
	PRINT(sv_i)
	sv_u = urhk_B2k_BacidToAcctId(sv_i)
	
	IF (sv_u == 0 ) THEN
	#{
		CUST.CHRGMIS.cashWthdAcctNo = BANCS.OUTPARAM.AcctId
		PRINT(CUST.CHRGMIS.cashWthdAcctNo)
		#}
	ELSE
		#{
		CUST.CHRGMIS.errMsg = "Convertion  for  Cash Withdrawal Bacid to  account number failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	#--------------------------------------------------------------------------
	# Selecting accounts from DTD
	#--------------------------------------------------------------------------
	sv_s =        " foracid,schmCode,schmType,tranId,partTranSrlNum,tranAmt,clrBalAmt|"
	sv_s = sv_s + " SELECT GAM.foracid,"
	sv_s = sv_s + " GAM.schm_code,"
	sv_s = sv_s + " GAM.schm_type,"
	sv_s = sv_s + " DTD.tran_id,"
	sv_s = sv_s + " DTD.part_tran_srl_num,"
	sv_s = sv_s + " DTD.tran_amt,"
	sv_s = sv_s + " GAM.clr_bal_amt"
	sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
	sv_s = sv_s + " WHERE GAM.acid=DTD.acid"
	sv_s = sv_s + " AND GAM.bank_id =DTD.bank_id"
	sv_s = sv_s + " AND GAM.sol_id=?SVAR"
	sv_s = sv_s + " AND GAM.acct_ownership='C' "
	sv_s = sv_s + " AND GAM.acct_crncy_code=?SVAR"
	sv_s = sv_s + " AND GAM.schm_type IN ('CAA','SBA')"
	sv_s = sv_s + " AND INSTR(?SVAR,CONCAT(CONCAT('!',GAM.schm_code),'!')) = 0"
	sv_s = sv_s + " AND GAM.acct_cls_flg!='Y'"
	sv_s = sv_s + " AND GAM.del_flg ='N'"
	sv_s = sv_s + " AND DTD.del_flg ='N'"
	sv_s = sv_s + " AND DTD.tran_id LIKE '%" + BANCS.STDIN.contextBankId + "%'"
	sv_s = sv_s + " AND DTD.tran_type='C'"
	sv_s = sv_s + " AND DTD.tran_sub_type='NP'"
	sv_s = sv_s + " AND DTD.part_tran_type='D'"
	sv_s = sv_s + " AND DTD.sol_id=GAM.sol_id"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	sv_s = sv_s + " AND NOT EXISTS( "
	sv_s = sv_s +                   " SELECT 1 "
	sv_s = sv_s +                   " FROM TBAADM.DTD"
	sv_s = sv_s +                   " WHERE DTD.acid=GAM.acid "
	sv_s = sv_s +                   " AND GAM.bank_id =DTD.bank_id"
	sv_s = sv_s +                   " AND DTD.del_flg ='N'"
	sv_s = sv_s +                   " AND DTD.tran_type='T'"
	sv_s = sv_s +                   " AND DTD.tran_sub_type='BI'"
	sv_s = sv_s +                   " AND DTD.part_tran_type='D'"
	sv_s = sv_s +                   " AND DTD.sol_id=GAM.sol_id"
	sv_s = sv_s +                   " AND INSTR(?SVAR,CONCAT(CONCAT('!',DTD.tran_amt),'!')) > 0)"
	
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS	=""
	BANCS.INPARAM.BINDVARS	=BANCS.INPARAM.BINDVARS+ BANCS.STDIN.mySolId  + "|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ BANCS.STDIN.homeCrncyCode +"|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ CUST.CPARAM.schmCodeI + "|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS 	=BANCS.INPARAM.BINDVARS+ CUST.CPARAM.tranAmtI
	
	PRINT(BANCS.INPARAM.BINDVARS)
	
	#-----------------------------------------------------------------------------------
	#---opening cursor
	#-----------------------------------------------------------------------------------
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF (sv_c != 0) THEN
	#{
		CUST.CHRGMIS.errMsg = "Cursor opening failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUST.CHRGMIS.mainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(CUST.CHRGMIS.mainCursor)
	
	#---------------------------------------------------------------
	# Passing transaction inputs to the service
	# Adding AND Posting the transaction
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_u = urhk_SetUrhkInp("tranDtl.remarks|"+CUST.CPARAM.tranHdRmks)
	
	#-------------------------------------------------------------------------------------
	#---CURSOR FETCH
	#-------------------------------------------------------------------------------------
	WHILE (sv_c == 0)
	#{
		sv_c = urhk_dbCursorFetch(CUST.CHRGMIS.mainCursor)
		PRINT(sv_c)
		IF (sv_c != 0) THEN
		#{
			sv_s =          " DELETE FROM CUSTOM.C_MOC"
			sv_s = sv_s +   " WHERE C_MOC.sol_id= ?SVAR"
			sv_s = sv_s +   " AND C_MOC.tran_date= to_date(?SVAR,'dd-mm-yyyy')"
			sv_s = sv_s +   " AND C_MOC.bank_id =?SVAR"
			
			BANCS.INPARAM.BINDVARS= BANCS.STDIN.mySolId+ "|"
			BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + CUST.CHRGMIS.BODDate + "|"
			BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			sv_c = urhk_dbCursorClose(CUST.CHRGMIS.mainCursor)
			PRINT(sv_c)
			sv_c = 1
			#}
		ELSE
			#{
			CUST.CHRGMIS.foracid			= BANCS.OUTPARAM.foracid
			CUST.CHRGMIS.schmCode			= BANCS.OUTPARAM.schmCode
			CUST.CHRGMIS.schmType			= BANCS.OUTPARAM.schmType
			CUST.CHRGMIS.tranId				= BANCS.OUTPARAM.tranId
			CUST.CHRGMIS.partTranSrlNum		= BANCS.OUTPARAM.partTranSrlNum
			CUST.CHRGMIS.tranAmt			= BANCS.OUTPARAM.tranAmt
			CUST.CHRGMIS.clrBalAmt			= BANCS.OUTPARAM.clrBalAmt
			
			PRINT(CUST.CHRGMIS.foracid)
			PRINT(CUST.CHRGMIS.schmCode)
			PRINT(CUST.CHRGMIS.schmType)
			PRINT(CUST.CHRGMIS.tranId)
			PRINT(CUST.CHRGMIS.partTranSrlNum)
			PRINT(CUST.CHRGMIS.tranAmt)
			PRINT(CUST.CHRGMIS.clrBalAmt)
			
			CUST.CHRGMIS.min   = "N"
			
			CUST.CHRGMIS.totAmt 	= "0"
			#------------------------------------------------------
			# Checking for Minimum Balance
			#------------------------------------------------------
			CUST.CHRGMIS.effAvailableAmt = CDOUBLE(CUST.CHRGMIS.clrBalAmt) + CDOUBLE(CUST.CHRGMIS.tranAmt)
			PRINT(CUST.CHRGMIS.effAvailableAmt)
			IF ((CUST.CHRGMIS.schmType == "SBA") AND (CDOUBLE(CUST.CHRGMIS.effAvailableAmt) > CDOUBLE(CUST.CPARAM.amount3)) ) THEN
			#{
				IF (CUST.CHRGMIS.schmCode != CUST.CPARAM.schmCode) THEN
				#{
					sv_s =        " minBal|"
					sv_s = sv_s + " SELECT CSP.acct_min_balance"
					sv_s = sv_s + " FROM TBAADM.CSP"
					sv_s = sv_s + " WHERE CSP.schm_code=?SVAR"
					sv_s = sv_s + " AND CSP.crncy_code=?SVAR"
					sv_s = sv_s + " AND CSP.bank_id=?SVAR"
					
					BANCS.INPARAM.BINDVARS= CUST.CHRGMIS.schmCode+ "|"
					BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + BANCS.STDIN.homeCrncyCode+ "|"
					BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					PRINT(sv_s)
					sv_d = urhk_dbselectWithBind(sv_s)
					PRINT(sv_d)
					
					IF (sv_d != 0 ) THEN
					#{
						CUST.CHRGMIS.errMsg = "A Database error has occured"
						GOTO NEXTREC
					#}
					ENDIF
					
					CUST.CHRGMIS.minBal = BANCS.OUTPARAM.minBal
					PRINT(CUST.CHRGMIS.minBal)
					
					BANCS.INPUT.moduleName = "INSUR_CHRG_MIS"
					BANCS.INPUT.parameterId =  CUST.CHRGMIS.schmCode+ "_" +BANCS.STDIN.mySolId
					PRINT(BANCS.INPUT.parameterId)
					
					CALL ("getcparamvalue.scr")
					
					IF (BANCS.OUTPUT.parameterVal != "") THEN
					#{
						CUST.CHRGMIS.minBal = BANCS.OUTPUT.parameterVal
						PRINT(CUST.CHRGMIS.minBal)
						#}
					ELSE
						#{
						CUST.CHRGMIS.errMsg = "CPARAM setup not done for Minimum Balance"
						GOTO NEXTREC
					#}
					ENDIF
					
					CUST.CHRGMIS.calAmt = CDOUBLE(CUST.CHRGMIS.effAvailableAmt) - CDOUBLE(CUST.CHRGMIS.tranAmt)
					PRINT(CUST.CHRGMIS.calAmt)
					
					IF (CDOUBLE(CUST.CHRGMIS.calAmt) < CDOUBLE(CUST.CPARAM.amount4)) THEN
					#{
						CUST.CHRGMIS.errMsg ="No min bal charge"
						GOTO NEXTREC
						#}
					ELSE
						#{
						IF (CDOUBLE(CUST.CHRGMIS.minBal) > CDOUBLE(CUST.CHRGMIS.calAmt)) THEN
						#{
							CUST.CHRGMIS.min = "Y"
							PRINT(CUST.CHRGMIS.min)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			PRINT(CUST.CHRGMIS.min)
			
			CUST.CHRGMIS.totAmt = CDOUBLE(CUST.CHRGMIS.totAmt) + CDOUBLE(CUST.CPARAM.amount1)
			PRINT(CUST.CHRGMIS.totAmt)
			
			
			#-----------------------------------------------------
			# Add partTran0 (credit)Income To cashwith chrg Account
			#-----------------------------------------------------
			CUST.CHRGMIS.partSrlNo = CINT(CUST.CHRGMIS.partSrlNo) + 1
			PRINT(CUST.CHRGMIS.partSrlNo)
			CUST.CHRGMIS.recVal=FORMAT$(CINT(CUST.CHRGMIS.partSrlNo) - 1,"%d")
			PRINT(CUST.CHRGMIS.recVal)
			sv_a = "tranDtl.partTranDetailLL.<rec_"+CUST.CHRGMIS.recVal+">."
			sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+CUST.CHRGMIS.partSrlNo)
			sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|C")
			sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.CHRGMIS.cashWthdAcctNo)
			sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.CPARAM.cashWithCredit+"|"+ BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|"+CUST.CPARAM.tranParts1)
			sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.CPARAM.cashWithCredit+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.CPARAM.refCode)
			
			#---------------------------------------------------------
			# Add partTran1  (debit)
			#---------------------------------------------------------
			CUST.CHRGMIS.partSrlNo = CINT(CUST.CHRGMIS.partSrlNo) + 1
			PRINT(CUST.CHRGMIS.partSrlNo)
			CUST.CHRGMIS.recVal=FORMAT$(CINT(CUST.CHRGMIS.partSrlNo) - 1,"%d")
			sv_b = "tranDtl.partTranDetailLL.<rec_"+CUST.CHRGMIS.recVal+">."
			sv_u = urhk_SetUrhkInp(sv_b + "key.serial_num|"+CUST.CHRGMIS.partSrlNo)
			sv_u = urhk_SetUrhkInp(sv_b + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "partTranType.code|D")
			sv_u = urhk_SetUrhkInp(sv_b + "acctId.foracid|"+CUST.CHRGMIS.foracid)
			sv_u = urhk_SetUrhkInp(sv_b + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "tranAmt|"+CUST.CHRGMIS.totAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "tranParticulars|"+CUST.CPARAM.tranParts4)
			sv_u = urhk_SetUrhkInp(sv_b + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "refAmt|"+CUST.CHRGMIS.totAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_b + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_b + "rateCode.refCode|" + CUST.CPARAM.refCode)
		#}
		ENDIF
		NEXTREC:
			IF (CUST.CHRGMIS.errMsg != "") THEN
			#{
				sv_u = SYSTEM("echo '"+CUST.CHRGMIS.errMsg+"' >>CHRGMIS.log")
				CUST.CHRGMIS.errMsg = ""
			#}
			ENDIF
		#}
		DO
		
		#-------------------------------------------------------------------------
		#--Adding  the tansaction
		#-------------------------------------------------------------------------
		sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
		sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
		sv_u = urhk_ExecSrv("SRV_AddTransferTran|retain_all_output = Y")
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_ExecSrv("SRV_AddTransferTran|retain_all_output = Y")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF (sv_u == 0) THEN
		#{
			IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
			#{
				CUST.CHRGMIS.tranId = BANCS.OUTPARAM.tranId
				CUST.CHRGMIS.tranDate = BANCS.OUTPARAM.tranDate
				PRINT(CUST.CHRGMIS.tranId)
				PRINT(CUST.CHRGMIS.tranDate)
			#}
			ENDIF
			
			#----------------------------------------------------------------------------
			#EXECUTION OF SERVICE POST TRANSFER TRANSACTIONS
			#----------------------------------------------------------------------------
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_PostTransferTran|retain_all_output = Y")
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_PostTransferTran|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
		
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				PRINT(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
				#}
			ELSE
				#{
				sv_v = 0
			#}
			ENDIF
			IF (sv_v > 0) THEN
			#{
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					PRINT(sv_e)
					sv_i = sv_i + 1
					sv_u = SYSTEM("echo '"+sv_e+"' >>CHRGMIS.log")
					PRINT(sv_u)
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF
		
	ENDOFSCRIPT :
		IF (CUST.CHRGMIS.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.CHRGMIS.errMsg+"' >>CHRGMIS.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
