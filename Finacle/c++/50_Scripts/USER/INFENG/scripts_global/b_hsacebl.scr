<--start
trace on
	# Script body goes here

	sv_a = urhk_B2k_PrintRepos("BANCS")
	print(sv_a)

	sv_z = urhk_SetOrbOut("output|"+ BANCS.STDIN.userWorkClass)
	print(sv_z)

	sv_z = urhk_SetOrbOut("output2|"+ BANCS.STDIN.mySolId)
	print(sv_z)
	
	
	
	sv_r = REPEXISTS("STDWFS")
        IF (sv_r == 0) THEN
                CREATEREP("STDWFS")
        ENDIF

        sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
        IF (sv_r == 0) THEN
                CREATECLASS("STDWFS", "GLBDATA", 5)
        ENDIF
	 STDWFS.GLBDATA.EodTeam ="NO"

	 IF (FIELDEXISTS(BANCS.INPUT.dcco) == 1) THEN
		STDWFS.GLBDATA.dcco=TOUPPER(TRIM(BANCS.INPUT.dcco))
		print(STDWFS.GLBDATA.dcco)


		sv_s = "solidupr,dccoWc| SELECT sol_id,user_work_class "
		sv_s = sv_s + "FROM tbaadm.upr "
		sv_s = sv_s + "WHERE user_id = ?SVAR " 
		sv_s = sv_s + "AND HOME_BANK_ID = ?SVAR "
		BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.dcco  + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		sv_u = urhk_dbselectWithBind(sv_s)

		IF (sv_u ==0) THEN
		#{
			STDWFS.GLBDATA.solidupr = TRIM(BANCS.OUTPARAM.solidupr)
			print (STDWFS.GLBDATA.solidupr)	
			STDWFS.GLBDATA.dccoWc= BANCS.OUTPARAM.dccoWc
			PRINT (STDWFS.GLBDATA.dccoWc)
				
		#}
		ELSE
		#{
			STDWFS.GLBDATA.solidupr = " "
			STDWFS.GLBDATA.dccoWc = " "
		#}
		ENDIF

		sv_z = urhk_SetOrbOut("output3|"+ STDWFS.GLBDATA.solidupr)
		print(sv_z)
			##katumo INC0143636 ###
		if (BANCS.INPUT.dcco != "") then 
			STDWFS.GLBDATA.bankid=BANCS.STDIN.contextBankId
			print(STDWFS.GLBDATA.bankid)

			sv_a=" home_bank_id,dccoWc|select home_bank_id,user_work_class from tbaadm.upr where user_id=?SVAR "
			BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.dcco
			sv_b = urhk_dbselectWithBind(sv_a)
			if (sv_b==0) then
				STDWFS.GLBDATA.home_bank_id= BANCS.OUTPARAM.home_bank_id
				print (STDWFS.GLBDATA.home_bank_id)
				STDWFS.GLBDATA.dccoWc= BANCS.OUTPARAM.dccoWc
				PRINT (STDWFS.GLBDATA.dccoWc)
			else 
				STDWFS.GLBDATA.home_bank_id= " "
				STDWFS.GLBDATA.dccoWc= " "
			endif
			
			if (STDWFS.GLBDATA.bankid!="54") then
				if ((STDWFS.GLBDATA.dccoWc > 509) and (STDWFS.GLBDATA.home_bank_id =="54")) then
					STDWFS.GLBDATA.EodTeam = "YES"
				endif
			else

				if ((STDWFS.GLBDATA.dccoWc) > 509 )THEN
					STDWFS.GLBDATA.EodTeam = "YES"
				ENDIF
			endif
			
			
		endif
			##katumo##
		sv_z = urhk_SetOrbOut("output4|"+ STDWFS.GLBDATA.EodTeam)
		print(sv_z)
		
		
		
	ENDIF

trace off
end-->
