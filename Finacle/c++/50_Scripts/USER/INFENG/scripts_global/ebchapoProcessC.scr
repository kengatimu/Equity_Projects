	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</EntityDoctData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<PsychographicData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<preferred_Locale>en-US</preferred_Locale>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<PsychographMiscData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<StrText10>"+EQSRV.GLBDATA.CrncyCode+"</StrText10>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Type>CURRENCY</Type>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</PsychographMiscData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</PsychographicData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<TradeFinData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CustNative/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<InlandTradeAllowed/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Rmks/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<TradeAuthorityCode/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</TradeFinData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</RelatedDtls>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</RetCustAddRq>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<RetCustAdd_CustomData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<custStatus/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<custCaste/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</RetCustAdd_CustomData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</RetCustAddRequest>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</Body>"
	print(EQSRV.GLBDATA.bodyXMLMsg)
	EQSRV.GLBDATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "<FIXML>"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.headerXML
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.bodyXMLMsg
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "</FIXML>"

	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	sv_a = EQSRV.GLBDATA.reqXMLMsg
	PRINT(sv_a)
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	if(sv_l != 0)then
	print(BANCS.OUTPARAM.ErrMsg)
	EQSRV.GLBDATA.scrValYN = "N"
	EQSRV.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
	if(BANCS.OUTPARAM.ErrMsg != "") then
		EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
                        goto ENDSCR
                endif
        else
                        EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                        print(EQSRV.GLBDATA.respXMLMsg)
                        EQSRV.GLBDATA.scrValYN = "Y"
                        EQSRV.GLBDATA.valerr = ""
        endif
        sv_x = EQSRV.GLBDATA.respXMLMsg
        sv_y = "<Status>"
        sv_z = "</Status>"
        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
        sv_e = GETPOSITION(sv_x, sv_z) - 1
        if (GETPOSITION(sv_x, sv_y) != 0) then
                EQSRV.GLBDATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
        else
                EQSRV.GLBDATA.tranStatus = ""
        endif
        print(EQSRV.GLBDATA.tranStatus)
        if(EQSRV.GLBDATA.tranStatus == "SUCCESS") then
                sv_x = EQSRV.GLBDATA.respXMLMsg
                sv_y = "<CustId>"
                sv_z = "</CustId>"
                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                sv_e = GETPOSITION(sv_x, sv_z) - 1
                if (GETPOSITION(sv_x, sv_y) != 0) then
                        EQSRV.GLBDATA.CustId = MID$(sv_x, sv_b, (sv_e - sv_b))
                endif
                if(EQSRV.GLBDATA.CustId == "") then
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = "Could Not Get Response from Server"
                        goto ENDSCR
                else
                        print(EQSRV.GLBDATA.CustId)
                endif
        else
                if(EQSRV.GLBDATA.tranStatus == "FAILED") then
                        sv_x = EQSRV.GLBDATA.respXMLMsg
                        sv_y = "<ErrorCode>"
                        sv_z = "</ErrorCode>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1
                        if(GETPOSITION(sv_x, sv_y) != 0) then
                                EQSRV.GLBDATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
                        endif
                        sv_x = EQSRV.GLBDATA.respXMLMsg
                        sv_y = "<ErrorDesc>"
                        sv_z = "</ErrorDesc>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1
                        if(GETPOSITION(sv_x, sv_y) != 0) then
                                EQSRV.GLBDATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
                        endif
                endif
                if((EQSRV.GLBDATA.errorCode == "") AND (EQSRV.GLBDATA.errorDesc == "")) then
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = "Could Not Get Response from Server"
                        goto ENDSCR
                else
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = EQSRV.GLBDATA.errorCode + ":" + EQSRV.GLBDATA.errorDesc
                        goto ENDSCR
                endif
        endif
	if(EQSRV.GLBDATA.CustId!="")then
		sv_d = "cifCnt,CifId|select count(*),orgkey from crmuser.accounts "
		sv_d = sv_d + " where bank_id=?SVAR and orgkey=?SVAR "
		sv_d = sv_d + " group by orgkey "
		print(sv_d)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.CustId
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		print(sv_u)
		if(sv_u==0)then
			EQSRV.GLBDATA.cifCnt = BANCS.OUTPARAM.cifCnt
			EQSRV.GLBDATA.CifId = BANCS.OUTPARAM.CifId
		else
			EQSRV.GLBDATA.cifCnt = 0
			EQSRV.GLBDATA.CifId = ""
		endif
	endif
	if((cdouble(EQSRV.GLBDATA.cifCnt)>=1) and (EQSRV.GLBDATA.CifId!=""))then
		callscriptifexist("ebchapoProcessCV.scr")
		if(fieldexists(EQSRV.GLBDATA.scrValYN)==1)then
			print(EQSRV.GLBDATA.scrValYN)
		endif
		if(fieldexists(EQSRV.GLBDATA.valerr)==1)then
			print(EQSRV.GLBDATA.valerr)
		endif
		if(fieldexists(EQSRV.GLBDATA.cifVerifyYN)==1)then
			print(EQSRV.GLBDATA.cifVerifyYN)
		endif
		if(fieldexists(EQSRV.GLBDATA.iscrmCcfmYN)==1)then
			print(EQSRV.GLBDATA.iscrmCcfmYN)
		endif
		if((EQSRV.GLBDATA.cifVerifyYN=="Y")and(EQSRV.GLBDATA.iscrmCcfmYN=="Y"))then
			callscriptifexist("ebchapoProcessAV.scr")
			if(fieldexists(EQSRV.GLBDATA.scrValYN)==1)then
				print(EQSRV.GLBDATA.scrValYN)
			endif
			if(fieldexists(EQSRV.GLBDATA.valerr)==1)then
				print(EQSRV.GLBDATA.valerr)
			endif
		endif
	endif
ENDSCR:
	print(EQSRV.GLBDATA.scrValYN)
	print(EQSRV.GLBDATA.valerr)
	print(EQSRV.GLBDATA.cifVerifyYN)
	print(EQSRV.GLBDATA.iscrmCcfmYN)
	##if(classexists("EQSRV","GLBDATA")==1)then
	##	deleteclass("EQSRV","GLBDATA")
	##endif
	##if(repexists("EQSRV")==1)then
	##	deleterep("EQSRV")
	##endif
	exitscript
trace off
end-->
