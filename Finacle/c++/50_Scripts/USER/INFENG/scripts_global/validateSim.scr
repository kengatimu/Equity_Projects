					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.opAcct + "|" + CUST.DATA.nationalId 
					print (BANCS.INPARAM.BINDVARS)

					sv_s = "LastDebitAmt| "
