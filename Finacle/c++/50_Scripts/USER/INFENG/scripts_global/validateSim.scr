					sv_s = sv_s + " where  NAT_ID_CARD_NUM = ?SVAR ))  AND PART_TRAN_TYPE ='D' "
					sv_s = sv_s + " and TRAN_SUB_TYPE = 'CI'  group by tran_amt,tran_date order by tran_date desc)where rownum<2  "
					sv_s = sv_s + " union "
