			if((EBSRV.GLBDATA.CrDrType=="C") and (cdouble(EBSRV.GLBDATA.lntCnt)>=1))then
			#{
				EBSRV.GLBDATA.eventId           = "DCAMD"
				EBSRV.GLBDATA.amtInd            = "M"
			#}
			endif
