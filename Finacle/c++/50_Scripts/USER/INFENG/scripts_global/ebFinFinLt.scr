        ##Usance payment
        print(EBSRV.GLBDATA.moduleType)
        print(EBSRV.GLBDATA.CrDrType)
        print(EBSRV.GLBDATA.limitSuffix)
        print(EBSRV.GLBDATA.foracid)
        print(EBSRV.GLBDATA.tranAmt)
        ###if((EBSRV.GLBDATA.moduleType=="US") and (EBSRV.GLBDATA.CrDrType=="C") and (EBSRV.GLBDATA.limitSuffix=="PAY"))then
	if((EBSRV.GLBDATA.moduleType=="US") and (EBSRV.GLBDATA.CrDrType=="C") and (EBSRV.GLBDATA.limitSuffix=="PAY") and (mid$(EBSRV.GLBDATA.tranParti,0,2)=="US"))then
                        EBSRV.GLBDATA.moduleType = "LC"
                        BANCS.INPARAM.limitSuffix       = "LC"
                        EBSRV.GLBDATA.entityType        = "DOCCR"
        endif
        ###if((EBSRV.GLBDATA.moduleType=="00") and (EBSRV.GLBDATA.CrDrType=="D") and (EBSRV.GLBDATA.limitSuffix==""))then
	  if((EBSRV.GLBDATA.moduleType=="00") and (EBSRV.GLBDATA.CrDrType=="D") and (EBSRV.GLBDATA.limitSuffix=="") and (mid$(EBSRV.GLBDATA.tranParti,0,2)))then

                print(BANCS.INPARAM.limitPrefix)
                print(BANCS.INPARAM.limitSuffix)
