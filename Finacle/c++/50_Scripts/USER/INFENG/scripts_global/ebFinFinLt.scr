<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
	EBSRV.GLBDATA.srvErrCode = ""
	EBSRV.GLBDATA.srvErrMsg  = ""
	EBSRV.GLBDATA.srvSucFail = ""

	EBSRV.GLBDATA.tranId	= ""
	EBSRV.GLBDATA.CrDrType	= ""
	EBSRV.GLBDATA.foracid	= "" 
	EBSRV.GLBDATA.schmCode	= ""
	EBSRV.GLBDATA.schmType	= ""
	EBSRV.GLBDATA.tranCy	= ""
	EBSRV.GLBDATA.tranAmt	= ""
	EBSRV.GLBDATA.refCy	= ""
	EBSRV.GLBDATA.refAmt 	= ""
	EBSRV.GLBDATA.tranParti	= ""
	EBSRV.GLBDATA.tranRemks	= ""
	EBSRV.GLBDATA.moduleType	= ""
	EBSRV.GLBDATA.avblType	= ""
	EBSRV.GLBDATA.lcType	= ""
	EBSRV.GLBDATA.lcNum	= ""
	EBSRV.GLBDATA.fundedType	= ""
	EBSRV.GLBDATA.cifId	= ""
	EBSRV.GLBDATA.custId	= ""
	EBSRV.GLBDATA.limitSuffix	= ""
	BANCS.INPARAM.limitPrefix	= ""
	EBSRV.GLBDATA.entityType	= ""
