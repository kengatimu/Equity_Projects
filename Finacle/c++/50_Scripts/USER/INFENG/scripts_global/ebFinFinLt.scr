		EBSRV.GLBDATA.refAmt =  BANCS.OUTPARAM.refAmt
		EBSRV.GLBDATA.tranParti =       BANCS.OUTPARAM.tranParti
		EBSRV.GLBDATA.tranRemks =       BANCS.OUTPARAM.tranRemks
		EBSRV.GLBDATA.moduleType =      BANCS.OUTPARAM.moduleType
		EBSRV.GLBDATA.avblType =        BANCS.OUTPARAM.avblType
		EBSRV.GLBDATA.lcType =  BANCS.OUTPARAM.lcType
		EBSRV.GLBDATA.lcNum =   BANCS.OUTPARAM.lcNum
		EBSRV.GLBDATA.fundedType =      BANCS.OUTPARAM.fundedType
		EBSRV.GLBDATA.cifId =   BANCS.OUTPARAM.cifId
		EBSRV.GLBDATA.custId =  BANCS.OUTPARAM.custId
		EBSRV.GLBDATA.limitSuffix =     BANCS.OUTPARAM.limitSuffix
		if(EBSRV.GLBDATA.tranId!="")then
			print(EBSRV.GLBDATA.tranId)
		endif
		BANCS.INPARAM.limitPrefix       = EBSRV.GLBDATA.cifId 
		if(EBSRV.GLBDATA.moduleType=="GT")then
		#{
			BANCS.INPARAM.limitSuffix       = "BG"
			EBSRV.GLBDATA.entityType        = "BNKGR"
		#}
		endif
		if(EBSRV.GLBDATA.moduleType=="LC")then
		#{
			BANCS.INPARAM.limitSuffix       = "LC"
			EBSRV.GLBDATA.entityType        = "DOCCR"
		#}
		endif
		if(EBSRV.GLBDATA.moduleType=="AV")then
