			#}
			endif
			#bgamend down
			#if((EBSRV.GLBDATA.CrDrType=="C") and (cint(EBSRV.GLBDATA.lntCnt)>=1))then
			#       EBSRV.GLBDATA.eventId           = "BGAMD"
			#endif
		#}
		endif
		if(EBSRV.GLBDATA.moduleType=="LC")then
		#{
			#lcissue
			if((EBSRV.GLBDATA.CrDrType=="D") and (cdouble(EBSRV.GLBDATA.lntCnt)==0))then
			#{
				EBSRV.GLBDATA.eventId           = "DCISS"
				EBSRV.GLBDATA.amtInd            = "A"
			#}
			endif
			#if lc exists and enhance the lc amount
			if((EBSRV.GLBDATA.CrDrType=="D") and (cdouble(EBSRV.GLBDATA.lntCnt)>=1))then
			#{
