		print(EBSRV.GLBDATA.cifId)
		print(EBSRV.GLBDATA.custId)
		print(EBSRV.GLBDATA.tranId)
                #limitConversion
                EBSRV.GLBDATA.quotee = "'/'"
                sv_u = "limSuffix,limCrncy | select listagg(limit_suffix,"+EBSRV.GLBDATA.quotee+") "
                sv_u = sv_u + " within group(order by limit_suffix), "
                sv_u = sv_u + " listagg(crncy_code,"+EBSRV.GLBDATA.quotee+") within group(order by crncy_code) "
                sv_u = sv_u + " from tbaadm.llt "
                sv_u = sv_u + " where bank_id=?SVAR "
                sv_u = sv_u + " and limit_prefix=?SVAR "
