			goto NXTLP 
		#}
		endif
		sv_u = "lntCnt | select count(*) from tbaadm.lnt "
		sv_u = sv_u + " where bank_id=?SVAR "
		sv_u = sv_u + " and entity_type=?SVAR "
		##sv_u = sv_u + " and entity_id=?SVAR "
		sv_u = sv_u + " and regexp_substr(remarks,'[^/]+') = ?SVAR "
		sv_u = sv_u + " and limit_b2kid=?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.entityType + "|" + EBSRV.GLBDATA.foracid + "|" + EBSRV.GLBDATA.limitB2kId
		print(sv_u)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_u)
		if(sv_u==0)then
		#{
			EBSRV.GLBDATA.lntCnt = BANCS.OUTPARAM.lntCnt
		else
			EBSRV.GLBDATA.lntCnt = 0
		#}
		endif
                if((cdouble(EBSRV.GLBDATA.lntCnt) >=1) and (EBSRV.GLBDATA.CrDrType=="C") and (mid$(EBSRV.GLBDATA.foracid,0,2)=="LC"))then
                        goto NXTLP
                endif
                if((cdouble(EBSRV.GLBDATA.lntCnt) >=1) and (EBSRV.GLBDATA.CrDrType=="D") and (mid$(EBSRV.GLBDATA.foracid,0,2)=="US"))then
                        goto NXTLP
                endif
		if(EBSRV.GLBDATA.moduleType=="GT")then
		#{
			#bgadd
			if((EBSRV.GLBDATA.CrDrType=="D") and (cdouble(EBSRV.GLBDATA.lntCnt)==0))then
			#{
				EBSRV.GLBDATA.eventId           = "BGADD"
				EBSRV.GLBDATA.amtInd            = "A"
			#}
			endif
