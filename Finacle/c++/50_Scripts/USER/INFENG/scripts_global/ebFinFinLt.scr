        endif
        ##
		print(BANCS.INPARAM.limitPrefix)
		print(BANCS.INPARAM.limitSuffix)
		if((BANCS.INPARAM.limitPrefix=="") or (BANCS.INPARAM.limitSuffix==""))then
			goto NXTLP 
		endif
		sv_u = urhk_GET_LimitB2kIdfromLimPfxSfx("")
		if(sv_u==0)then
		#{
			EBSRV.GLBDATA.limitB2kId        = BANCS.OUTPARAM.limitB2kId
		else
