                                sv_j = sv_j + " and limit_suffix in ('FBGD') "
                                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.cifId
                                print(BANCS.INPARAM.BINDVARS)
                                print(sv_j)
                                sv_u = urhk_dbSqlWithBind(sv_j)
