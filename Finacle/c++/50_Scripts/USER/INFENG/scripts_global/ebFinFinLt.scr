                sv_f = mid$(EBSRV.GLBDATA.limSuffix,0,sv_l)
                print(sv_f)
                sv_p = getposition(sv_f,"/")
                print(sv_p)
                EBSRV.GLBDATA.limSo  = mid$(sv_f,0,(sv_p-1))
