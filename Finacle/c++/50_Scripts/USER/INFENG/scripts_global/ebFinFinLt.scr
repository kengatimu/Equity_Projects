	EBSRV.GLBDATA.amtInd 	= ""
	EBSRV.GLBDATA.limCrncy	= ""
	EBSRV.GLBDATA.limSo	= ""
	EBSRV.GLBDATA.limsT	= ""
	EBSRV.GLBDATA.limsR	= ""
	EBSRV.GLBDATA.limCo	= ""
	EBSRV.GLBDATA.limCt	= ""
	EBSRV.GLBDATA.limCr	= ""
	EBSRV.GLBDATA.libConvAmt	= ""
	EBSRV.GLBDATA.limYN	= ""
	BANCS.INPARAM.limitSuffix = ""


	EBSRV.GLBDATA.tranDate = ""
	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	if(sv_u == 0)then
		print(MTT.InputDetails.Argument1)
		EBSRV.GLBDATA.tranId = trim(MTT.InputDetails.Argument1)
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        endif
#data
	sv_d = "tranId,CrDrType,foracid,schmCode,schmType,tranCy,tranAmt,refCy,refAmt,"
	sv_d = sv_d + " tranParti,tranRemks,moduleType,avblType,lcType,lcNum,fundedType,cifId,custId,limitSuffix|"
	sv_d = sv_d + " select tran_id,part_tran_type,gam.foracid,gam.schm_code,gam.schm_type,dtd.tran_crncy_code,"
	sv_d = sv_d + " dtd.tran_amt,dtd.ref_crncy_code,"
	sv_d = sv_d + " dtd.ref_amt,dtd.tran_particular,"
	sv_d = sv_d + " dtd.tran_rmks,"
        sv_d = sv_d + " substr(gam.foracid,0,2)moduleType,"
        sv_d = sv_d + " substr(dtd.tran_rmks,0,2)avblType,"
        sv_d = sv_d + " substr(dtd.tran_particular, 1, Instr(dtd.tran_particular, '-', -1, 1) -1) lcType,"
        sv_d = sv_d + " substr(dtd.tran_particular, Instr(dtd.tran_particular, '-', -1, 1) +1) lcNum,"
        sv_d = sv_d + " substr(substr(dtd.tran_particular, instr(dtd.tran_particular, '-', -1, 1) +1),0,3) fundedType,"
        sv_d = sv_d + " gam.cif_id,"
        sv_d = sv_d + " gam.cust_id,"
        sv_d = sv_d + " (case when substr(gam.foracid,0,2)='GT' then 'BG'"
        sv_d = sv_d + " when substr(gam.foracid,0,2)='LC' then 'LC'"
        sv_d = sv_d + " when substr(gam.foracid,0,2)='AV' then 'AVBL'"
        sv_d = sv_d + " when substr(gam.foracid,0,2)='BP' then 'FBGD'"
	sv_d = sv_d + " when substr(gam.foracid,0,2)='US' then 'PAY'"
        sv_d = sv_d + " else null end)limitSuffix"
        sv_d = sv_d + " from tbaadm.dtd,tbaadm.gam where dtd.bank_id=?SVAR " 
        sv_d = sv_d + " and gam.bank_id=?SVAR "
        sv_d = sv_d + " and dtd.tran_id=lpad(?SVAR,9,' ') "
        sv_d = sv_d + " and dtd.tran_date=to_date(?SVAR,'DD-MM-RR') "
        sv_d = sv_d + " and dtd.acid =gam.acid "
        sv_d = sv_d + " and dtd.PSTD_FLG='Y' "
        sv_d = sv_d + " and dtd.del_flg='N' "
        sv_d = sv_d + " and gam.del_flg='N' "
        sv_d = sv_d + " and gam.entity_cre_flg='Y' "
        sv_d = sv_d + " order by dtd.part_tran_srl_num "
	EBSRV.GLBDATA.tranDate = mid$(BANCS.STDIN.BODDate,0,10)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.tranId + "|" + EBSRV.GLBDATA.tranDate 
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(sv_d)
        if(sv_u==0)then
                EBSRV.GLBDATA.dtdCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                EBSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EBSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EBSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif
        EBSRV.GLBDATA.dtdRec = 0
        print(EBSRV.GLBDATA.dtdCurNum)
        sv_z = urhk_dbCursorFetch(EBSRV.GLBDATA.dtdCurNum)
        if(sv_z!=0)then
                EBSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EBSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EBSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{ vploop starts
        #+++++++++++++++++
		EBSRV.GLBDATA.tranId =  BANCS.OUTPARAM.tranId
		EBSRV.GLBDATA.CrDrType =        BANCS.OUTPARAM.CrDrType
		EBSRV.GLBDATA.foracid =         BANCS.OUTPARAM.foracid
		EBSRV.GLBDATA.schmCode =        BANCS.OUTPARAM.schmCode
		EBSRV.GLBDATA.schmType =        BANCS.OUTPARAM.schmType
		EBSRV.GLBDATA.tranCy =  BANCS.OUTPARAM.tranCy
		EBSRV.GLBDATA.tranAmt =         BANCS.OUTPARAM.tranAmt
