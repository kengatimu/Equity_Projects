						CUST.DATA.Warning_num = BANCS.OUTPARAM.Warning_num
						PRINT(CUST.DATA.Warning_num)
						CUST.DATA.UserInfo_num = BANCS.OUTPARAM.UserInfo_num
						PRINT(CUST.DATA.UserInfo_num)
						CUST.DATA.Xcpn_num = BANCS.OUTPARAM.Xcpn_num
						PRINT(CUST.DATA.Xcpn_num)
						sv_y = BANCS.OUTPARAM.Xcpn_num
						IF (sv_c > 0) THEN
						#{
							sv_d = 1
							WHILE (sv_d <= sv_c)
							#{
								sv_f = FORMAT$(sv_d,"%d")
								sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
								PRINT(sv_e)
								sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
								PRINT(sv_e)
								sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
								PRINT(sv_e)
								("CUST").("DATA").("Index_"+sv_f) = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
								("CUST").("DATA").("errorMsg_"+sv_f) = "Error_"+sv_f+"|ERROR^"+("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)+"^"
								PRINT(("CUST").("DATA").("errorMsg_"+sv_f))
								sv_d = sv_d + 1
							#}
							DO
						#}
						ENDIF
						IF (sv_y > 0) THEN
						#{
							sv_d = 1
							
							
							WHILE (sv_d <= sv_y)
							#{
								#Printing all the Exceptions.
								sv_f = FORMAT$(sv_d,"%d")
								sv_e = ("BANCS").("OUTPARAM").("XcpnDesc_"+sv_f)
								PRINT(sv_e)
								sv_m = ("BANCS").("OUTPARAM").("XcpnCode_"+sv_f)
								PRINT(sv_m)
								sv_n = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
								PRINT(sv_n)
								sv_d = sv_d + 1
								CUST.DATA.failReason = sv_e
								PRINT(CUST.DATA.failReason)
							#}
							DO
						#}
						ENDIF
						#}
					ELSE
						#{
						sv_s = "UPDATE TBAADM.TAM SET CUMULATIVE_INT_PAID = (CUMULATIVE_INT_PAID + ?NVAR ),"
						sv_s = sv_s + "CUMULATIVE_INT_CREDITED = (CUMULATIVE_INT_CREDITED - ?NVAR ) "
						sv_s = sv_s + " WHERE ACID = ?SVAR "
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.DATA.TranAmt + "|" + CUST.DATA.TranAmt + "|" + CUST.DATA.debitAcctAcid
						sv_d = urhk_dbSQLWithBind(sv_s)
						PRINT(sv_d)
						IF(sv_d == 0) THEN
						#{
							sv_d = urhk_dbSQLWithBind("commit")
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				
				#}
			ELSE
				#{
				
				sv_s = "UPDATE TBAADM.TAM SET CUMULATIVE_INT_PAID = (CUMULATIVE_INT_PAID + ?NVAR ),"
				sv_s = sv_s + "CUMULATIVE_INT_CREDITED = (CUMULATIVE_INT_CREDITED - ?NVAR ) "
				sv_s = sv_s + " WHERE ACID = ?SVAR "
				PRINT(sv_s)
				
				BANCS.INPARAM.BINDVARS = CUST.DATA.TranAmt + "|" + CUST.DATA.TranAmt + "|" + CUST.DATA.debitAcctAcid
				sv_d = urhk_dbSQLWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d == 0) THEN
				#{
					sv_d = urhk_dbSQLWithBind("commit")
				#}
				ENDIF
				
				#)
			#}
			ENDIF
			
			sv_b = "bankName,solDesc|select group_desc,sol_desc "
			sv_b = sv_b + " from TBAADM.sol, TBAADM.gct where sol.bank_id=gct.bank_id"
			sv_b = sv_b + " AND sol_id = ?SVAR "
			sv_b = sv_b + " AND sol.del_flg = 'N' AND gct.del_flg = 'N'"
			BANCS.INPARAM.BINDVARS = CUST.DATA.solId
			sv_g = urhk_dbSelectWithBind(sv_b)
			IF(sv_g == 0) THEN
			#{
				CUST.DATA.bankName= BANCS.OUTPARAM.bankName
				CUST.DATA.solDesc=BANCS.OUTPARAM.solDesc
				PRINT(CUST.DATA.bankName)
				PRINT(CUST.DATA.solDesc)
			#}
			ENDIF
			
			
			CUST.DATA.tranAmt = CDOUBLE(CUST.DATA.TranAmt)
			
			sv_z = CUST.DATA.solId + "|"
			sv_z = sv_z + CUST.DATA.debitAccount + "|"
			sv_z = sv_z + CUST.DATA.schmCode + "|"
			sv_z = sv_z + CUST.DATA.crncyCode + "|"
			sv_z = sv_z + CUST.DATA.tranAmt + "|"
			sv_z = sv_z + CUST.DATA.tranId + "|"
			sv_z = sv_z + CUST.DATA.TranDate + "|"
			sv_z = sv_z +  CUST.DATA.solDesc + "|"
			sv_z = sv_z +  CUST.DATA.bankName + "|"
			sv_z = sv_z + CUST.DATA.userId
			sv_a = "echo '" + sv_z + "' >> " + CUST.DATA.succFileName
			PRINT(sv_a)
			sv_b = SYSTEM(sv_a)
			PRINT(sv_b)
			#}
		ELSE
			#{
			sv_z = CUST.DATA.solid + "|||||||"
			PRINT(sv_z)
			sv_a = "echo '" + sv_z + "' >> " + CUST.DATA.succFileName
			PRINT(sv_a)
		#}
		ENDIF
		
		sv_d = "mrbx4001 IslamicUpfrontTran.mrt " + CUST.DATA.succFileName + " " + CUST.DATA.succRptFileName
		PRINT(sv_d)
		sv_b = SYSTEM(sv_d)
		PRINT(sv_b)
		
		
		IF (sv_b == 0) THEN
		#{
			BANCS.OUTPUT.tranId = CUST.DATA.tranId
			
			sv_d = "babx4040 ${B2K_SESSION_ID} " + CUST.DATA.succRptFileName + " 'Islamic Upfront Tran.' Manager 1 N"
			sv_b = SYSTEM(sv_d)
			PRINT(sv_b)
		#}
		ENDIF
		
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
		
