		PRINT(sv_a)
		
		##### credit transaction ####
		
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|UPFRONT PROFIT TRAN")
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|"+CUST.DATA.TranDate)
