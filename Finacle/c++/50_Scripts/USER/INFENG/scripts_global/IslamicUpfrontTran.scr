		PRINT(CUST.DATA.ValueDate)
		CUST.DATA.TranDate = BANCS.OUTPARAM.TranDate + " 00:00:00"
		PRINT(CUST.DATA.TranDate)
		
		
		
		
		### fetching the interest credit acid ###
		sv_j = "crdtAccount|select foracid from TBAADM.gam"
		sv_j = sv_j + " where acid in (select int_cr_acid from TBAADM.gac"
		sv_j = sv_j + " where acid = ?SVAR )"
		sv_j = sv_j + " AND del_flg = 'N' AND entity_cre_flg = 'Y'"
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.debitAcctAcid
