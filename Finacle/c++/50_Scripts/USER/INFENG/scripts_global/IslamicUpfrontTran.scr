	CUST.DATA.succRptFileName = CUST.DATA.solid + "_IslamicUpfront_" + CUST.DATA.sysDate +".rpt"
	
	
	### fetching the foracid ###
	sv_i = "foracid,TranAmt,schmCode,solId,crncyCode,acctDate,TranDate,ValueDate|select foracid,CUMULATIVE_INT_CREDITED,"
	sv_i = sv_i + " schm_code,gam.sol_id,acct_crncy_code,acct_opn_date,to_char(tran_date,'DD-MM-YYYY'),to_char(value_date,'DD-MM-YYYY')"
