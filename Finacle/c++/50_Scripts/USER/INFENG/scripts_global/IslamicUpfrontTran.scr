		### debit transaction ####
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
		PRINT(sv_a)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|"+CUST.DATA.TranDate)
