		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|"+ CUST.DATA.ValueDate)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|"+ LPAD("2",4,' '))
