		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|" + CUST.DATA.crncyCode)
		#sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rateCode.refCode|CUB")
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.crncyCode|" + CUST.DATA.crncyCode)
		#sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|PO")
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.entryUserId.userId|SYSTEM")
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pstdUserId.userId|SYSTEM")
		
		#sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rptCode.refCode|")
		#print(sv_a)
		
		CUST.DATA.CurrAmt = CUST.DATA.TranAmt + "|" + CUST.DATA.crncyCode
