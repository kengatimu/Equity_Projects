				sv_b = sv_b + " AND del_flg = 'N' AND entity_cre_flg = 'Y'"
				BANCS.INPARAM.BINDVARS = CUST.DATA.schmCode + "|" + CUST.DATA.solId + "|" + CUST.DATA.crncyCode
				sv_g = urhk_dbSelectWithBind(sv_b)
				PRINT(sv_b)
