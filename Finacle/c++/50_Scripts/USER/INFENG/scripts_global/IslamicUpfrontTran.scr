		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.DATA.CurrAmt)
		PRINT(CUST.DATA.creditAccount)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|" + CUST.DATA.creditAccount)
