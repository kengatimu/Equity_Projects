<--START
CHECKSUM="61c3444d07d3fe97f9de8f3391c8db6aa1c7388fc1792449b9941379f5192074"
	TRACE ON
	
	CUST.CIETXN.BankID  = "43"
	CUST.CIETXN.LIMACCTID = CUST.CIETXN.drAcctNum
	Print (CUST.CIETXN.LIMACCTID)

	CUST.CIETXN.DCW = "0"
	CUST.CIETXN.DTF = "0"
	CUST.CIETXN.DDP = "0"
	
	CUST.CIETXN.MCW = "0"
	CUST.CIETXN.MTF = "0"
	CUST.CIETXN.MDP = "0"

	IF(CUST.CIETXN.refCrncy != "USD")THEN
		BANCS.INPARAM.InputAmount  = CUST.CIETXN.refAmt
		BANCS.INPARAM.FromCurrency = CUST.CIETXN.refCrncy
		BANCS.INPARAM.ToCurrency   = "USD"
		BANCS.INPARAM.RateCode     = "NOR"
		BANCS.INPARAM.Rate         = CDOUBLE("0.0")

		sv_u = urhk_B2k_ConvertAmount("")

		CUST.CIETXN.CRefAmt = BANCS.OUTPARAM.OutputAmount
		PRINT(CUST.CIETXN.CRefAmt)

	ELSE
		CUST.CIETXN.CRefAmt  = CUST.CIETXN.refAmt
	ENDIF

	Print (CUST.CIETXN.CRefAmt)

	sv_s=" BanK_id, LimCrncy | select bank_id  , acct_crncy_code from tbaadm.gam a where   foracid   =?SVAR   "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.CIETXN.LIMACCTID
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
		CUST.CIETXN.BanK_id = BANCS.OUTPARAM.BanK_id
		CUST.CIETXN.LimCrncy  = BANCS.OUTPARAM.LimCrncy

		IF (CUST.CIETXN.BanK_id  != "43") THEN
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE		
		GOTO ENDOFSCRIPT
	ENDIF


#Daily
	sv_s=" DCW | select case when sum (TRAN_AMT) is null then 0 else sum (TRAN_AMT)  end tran   from CUSTOM.IECWD  a where   TARGET_ENTITY_ID =?SVAR  "
	sv_s = sv_s + " and DR_ACCOUNT_ID  =?SVAR  and  ENTITY1_TRAN_DATE = trunc (sysdate) -3  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.CIETXN.BankID  + "|" + CUST.CIETXN.LIMACCTID
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
		CUST.CIETXN.DCW = BANCS.OUTPARAM.DCW
	ELSE
		CUST.CIETXN.DCW ="0"
	ENDIF


	sv_s=" DTF | select   case when sum (REF_AMT) is null then 0 else sum (REF_AMT)  end tran  from  CUSTOM.IETD  a  where  INIT_ENTITY_ID =?SVAR  "
	sv_s = sv_s + " and DR_ACCOUNT_ID  =?SVAR  and  ENTITY1_TRAN_DATE = trunc (sysdate)-3  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.CIETXN.BankID  + "|" + CUST.CIETXN.LIMACCTID
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
		CUST.CIETXN.DTF = BANCS.OUTPARAM.DTF
	ELSE
		CUST.CIETXN.DTF ="0"
	ENDIF


#	sv_s=" DDP | select  case when sum (TRAN_AMT) is null then 0 else sum (TRAN_AMT)  end tran  from  CUSTOM.IETD a where  TARGET_ENTITY_ID =?SVAR and   "
#	sv_s = sv_s + " and CR_ACCOUNT_ID  =?SVAR  and  ENTITY1_TRAN_DATE = trunc (sysdate)  "
#	print(sv_s)
#	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  + "|" + CUST.CIETXN.LIMACCTID
#	print(BANCS.INPARAM.BINDVARS)
#	sv_d = urhk_dbSelectWithBind(sv_s)
#	IF (sv_d == 0) THEN
#		CUST.CIETXN.DDP = BANCS.OUTPARAM.DDP
#	ELSE
#		CUST.CIETXN.DDP ="0"
#	ENDIF



	Print (CUST.CIETXN.DCW)	
	Print (CUST.CIETXN.DTF)


	CUST.CIETXN.TDLIM = cdouble (CUST.CIETXN.DDP) + cdouble(CUST.CIETXN.DTF) + cdouble(CUST.CIETXN.DCW)
	print (CUST.CIETXN.TDLIM)

	IF(CUST.CIETXN.LimCrncy != "USD")THEN
		BANCS.INPARAM.InputAmount  = CUST.CIETXN.TDLIM
		BANCS.INPARAM.FromCurrency = CUST.CIETXN.LimCrncy
		BANCS.INPARAM.ToCurrency   = "USD"
		BANCS.INPARAM.RateCode     = "NOR"
		BANCS.INPARAM.Rate         = CDOUBLE("0.0")

		sv_u = urhk_B2k_ConvertAmount("")

		CUST.CIETXN.DAILYLIMIT = BANCS.OUTPARAM.OutputAmount
		PRINT(CUST.CIETXN.DAILYLIMIT)
	ELSE

		CUST.CIETXN.DAILYLIMIT  = CUST.CIETXN.TDLIM
	ENDIF


#Monthly
	sv_s=" MCW | select case when sum (TRAN_AMT) is null then 0 else sum (TRAN_AMT)  end tran   from CUSTOM.IECWD  a where   TARGET_ENTITY_ID =?SVAR  "
	sv_s = sv_s + " and DR_ACCOUNT_ID  =?SVAR  and  ENTITY1_TRAN_DATE between  trunc (sysdate) -30   and trunc (sysdate)  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.CIETXN.BankID  + "|" + CUST.CIETXN.LIMACCTID
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
		CUST.CIETXN.MCW = BANCS.OUTPARAM.MCW
	ELSE
		CUST.CIETXN.MCW ="0"
	ENDIF


	sv_s=" MTF | select   case when sum (REF_AMT) is null then 0 else sum (REF_AMT)  end tran  from  CUSTOM.IETD  a  where  INIT_ENTITY_ID =?SVAR  "
	sv_s = sv_s + " and DR_ACCOUNT_ID  =?SVAR  and  ENTITY1_TRAN_DATE between  trunc (sysdate) -30   and trunc (sysdate)  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.CIETXN.BankID  + "|" + CUST.CIETXN.LIMACCTID
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
		CUST.CIETXN.MTF = BANCS.OUTPARAM.MTF
	ELSE
		CUST.CIETXN.MTF ="0"
	ENDIF


#	sv_s=" MDP | select  case when sum (TRAN_AMT) is null then 0 else sum (TRAN_AMT)  end tran  from  CUSTOM.IETD a where  TARGET_ENTITY_ID =?SVAR and   "
#	sv_s = sv_s + " and CR_ACCOUNT_ID  =?SVAR  and  ENTITY1_TRAN_DATE between  trunc (sysdate) -30   and trunc (sysdate)   "
#	print(sv_s)
#	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  + "|" + CUST.CIETXN.LIMACCTID
#	print(BANCS.INPARAM.BINDVARS)
#	sv_d = urhk_dbSelectWithBind(sv_s)
#	IF (sv_d != 0) THEN
#		CUST.CIETXN.MDP = BANCS.OUTPARAM.MDP
#	ELSE
#		CUST.CIETXN.MDP ="0"
#	ENDIF


	Print (CUST.CIETXN.MCW)	
	Print (CUST.CIETXN.MTF)

	CUST.CIETXN.TMLIM = cdouble (CUST.CIETXN.MDP) + cdouble(CUST.CIETXN.MTF) + cdouble(CUST.CIETXN.MCW)
	print (CUST.CIETXN.TMLIM)


	IF(CUST.CIETXN.LimCrncy != "USD")THEN
		BANCS.INPARAM.InputAmount  = CUST.CIETXN.TMLIM
		BANCS.INPARAM.FromCurrency = CUST.CIETXN.LimCrncy
		BANCS.INPARAM.ToCurrency   = "USD"
		BANCS.INPARAM.RateCode     = "NOR"
		BANCS.INPARAM.Rate         = CDOUBLE("0.0")

		sv_u = urhk_B2k_ConvertAmount("")

		CUST.CIETXN.MONLIMIT = BANCS.OUTPARAM.OutputAmount
		PRINT(CUST.CIETXN.MONLIMIT)
	ELSE
		CUST.CIETXN.MONLIMIT  = CUST.CIETXN.TMLIM
	ENDIF


	Print (CUST.CIETXN.MONLIMIT)
	Print (CUST.CIETXN.DAILYLIMIT)


CUST.CIETXN.MONLIMIT =  cdouble (CUST.CIETXN.CRefAmt) + cdouble (CUST.CIETXN.MONLIMIT)
CUST.CIETXN.DAILYLIMIT =  cdouble (CUST.CIETXN.CRefAmt) + cdouble (CUST.CIETXN.DAILYLIMIT)

	Print (CUST.CIETXN.MONLIMIT)
	Print (CUST.CIETXN.DAILYLIMIT)

	CUST.CIETXN.SETDLIMIT ="2500"
	CUST.CIETXN.SETMLIMIT ="10000"

	IF(CDOUBLE(CUST.CIETXN.MONLIMIT) > CDOUBLE(CUST.CIETXN.SETMLIMIT))THEN
		CUST.CIETXN.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Monthly limit exceeded^prodCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	ENDIF

	IF(CDOUBLE(CUST.CIETXN.DAILYLIMIT) > CDOUBLE(CUST.CIETXN.SETDLIMIT))THEN
		CUST.CIETXN.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Daily limit exceeded^prodCode")
		print(sv_u)
		GOTO ENDOFSCRIPT

	ENDIF
		
	ENDOFSCRIPT:
END-->

