<--START
CHECKSUM="d24e95e7718342acf32e641bbe97e61719499adbb752d202783f4d1a042b52e8"
	TRACE ON
	LIBNAME CUSTOMSO
	sv_u=urhk_B2k_PrintRepos("BANCS")
	print(sv_u)
	
	#--------------------------------------------------------------------------------------------------
	# Creating the log File
	#--------------------------------------------------------------------------------------------------
	sv_s = "startTime|"
	sv_s = sv_s + " SELECT TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') "
	sv_s = sv_s + " FROM DUAL"
	print(sv_s)
	sv_r = urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	
	CUST.CATOD.startTime = BANCS.OUTPARAM.startTime
	CUST.CATOD.successlogFile = "Upload_Success_" + CUST.CATOD.startTime + ".log"
	CUST.CATOD.failurelogFile = "Upload_Failure_" + CUST.CATOD.startTime + ".log"
	print(CUST.CATOD.startTime)
	print(CUST.CATOD.successlogFile)
	print(CUST.CATOD.successlogFile)
	
	#--------------------------------------------------------------------------------------------------
	# Creating the Sucess and Failure report files
	#--------------------------------------------------------------------------------------------------
	sv_s = "touch " + CUST.CATOD.successlogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	
	sv_s = "touch " + CUST.CATOD.failurelogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	#=================================================================================*
	#	Start Reading the CSV file
	#=================================================================================*
	
	sv_o = urtn_fileOpen(CUST.CATOD.fileName + "|r")
	print(sv_o)
	IF (sv_o == 0) THEN
	#{
		CUST.CATOD.fileindex = sv_o
		print(CUST.CATOD.fileindex)
		print(CUST.CATOD.selectedRec)
		
		sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")

		IF(sv_x == 0) THEN
		#{
			sv_n = "1"
			sv_v = "Y"
			WHILE(sv_x==0)
			#{
				sv_c = 0
				print(CUST.CATOD.selectedRec)
				print(BANCS.OUTPARAM.buffer)
				CUST.CATOD.selectedRec = BANCS.OUTPARAM.buffer
				CUST.CATOD.recBackUp = CUST.CATOD.selectedRec
				print(CUST.CATOD.selectedRec)
				print(CUST.CATOD.recBackUp)
				#=================================================================================*
				# Reading the data from CSV file
				#=================================================================================*
				#sv_l = STRLEN(CUST.CATOD.selectedRec)
				#print(sv_l)

				CUST.CATOD.selectedRec = ltrim(rtrim(CUST.CATOD.selectedRec))
				print(CUST.CATOD.selectedRec)
				sv_l = STRLEN(CUST.CATOD.selectedRec)
				print(sv_l)
				IF (sv_l == 0)THEN
					GOTO NEXTREC
				ENDIF
				CUST.CATOD.selectedRec = CUST.CATOD.selectedRec + "|"
				print(CUST.CATOD.selectedRec)
				sv_z=CUST.CATOD.selectedRec
				sv_h="1"
				sv_t = 0
				WHILE(sv_l > 0)
				#{
					sv_l = STRLEN(sv_z)
					print(sv_l)
					sv_p = GETPOSITION(sv_z, "|")
					print(sv_p)
					sv_t = sv_t + 1
					print(sv_t)
					CUST.CATOD.numOfValues = sv_t
					print(CUST.CATOD.numOfValues)
					
					IF(sv_p==0)THEN
					#{
						sv_l=-1
						print(sv_l)
					#}
					ENDIF
					
					sv_a = LEFT$(sv_z, sv_p - 1)
					print(sv_a)
					CUST.CATOD.num=sv_h
					print(CUST.CATOD.num)
					("CUST").("CATOD").("fieldData" + CUST.CATOD.num) = sv_a
					print(sv_a)
					
					IF (CUST.CATOD.num=="1") THEN
					#{
						CUST.CATOD.ACCTNUM=sv_a
						print(CUST.CATOD.ACCTNUM)
					#}
					ENDIF
					IF (CUST.CATOD.num=="2") THEN
					#{
						CUST.CATOD.REFNUM=sv_a
						print(CUST.CATOD.REFNUM)
					#}
					ENDIF
					IF (CUST.CATOD.num=="3") THEN
					#{
						CUST.CATOD.NAME=sv_a
						print(CUST.CATOD.NAME)
					#}
					ENDIF
					sv_h=CINT(CUST.CATOD.num)+1
					print(sv_h)
					
					sv_z = RIGHT$(sv_z, STRLEN(sv_z) - sv_p)
					print(sv_z)
					sv_l=sv_l-sv_p
					print(sv_l)
					
					IF((sv_l == 0)AND(sv_h < 4))THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "Invalid Record Structure"
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
				#}
				DO
				Print (CUST.CATOD.numOfValues)

				IF (CINT(CUST.CATOD.numOfValues) != 3) THEN
				#{				

					IF (CINT(CUST.CATOD.numOfValues) > 3) THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						GOTO RECORDSEXCEED
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
					
				#}
				ENDIF

				
				#--------------- Get Account number from the file ------------------------


				IF(FIELDEXISTS(CUST.CATOD.ACCTNUM))THEN
					IF (CUST.CATOD.ACCTNUM=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "ACCTNUM  is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF
					sv_u = urhk_getAcctDetailsInRepository(CUST.CATOD.ACCTNUM)
					print(sv_u)			
					IF (sv_u != 0) THEN
			
						CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "ACCTNUM  Account is Invalid"
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					else 
						sv_a= " schmcode|select schm_code from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR "
						BANCS.INPARAM.BINDVARS =  CUST.CATOD.ACCTNUM +"|"+ BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						sv_b = urhk_dbSelectWithBind(sv_a)
							if (sv_b==0) then
								CUST.CATOD.schmcode=BANCS.OUTPARAM.schmcode
								print (CUST.CATOD.schmcode)
							endif

						sv_a= " valtype|select free_text4 from tbaadm.brgt where free_text1=?SVAR and bank_id=?SVAR "
						BANCS.INPARAM.BINDVARS =  CUST.CATOD.ACCTNUM +"|"+ BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						sv_b = urhk_dbSelectWithBind(sv_a)
							if (sv_b==0) then
								CUST.CATOD.valtype=BANCS.OUTPARAM.valtype
								print (CUST.CATOD.valtype)

								if (((CUST.CATOD.schmcode != "CA203") or  (CUST.CATOD.schmcode != "SB106")) and (CUST.CATOD.valtype !="L" ))  then
									CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + " Ensure a/c is schm CA203/SB106 & validation is local "
									sv_v = "N"
									sv_c = sv_c + 1
									GOTO INVALID
								endif
							else 
								CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + " validation type is null! "
								sv_v = "N"
								sv_c = sv_c + 1
								GOTO INVALID
							endif

					
					ENDIF
				 ENDIF
				 IF(FIELDEXISTS(CUST.CATOD.NAME))THEN
					IF (CUST.CATOD.NAME=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "NAME is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF
					sv_s = "name|select regexp_replace(?SVAR,'[^0-9a-zA-Z ]') FROM dual  "
					BANCS.INPARAM.BINDVARS =  CUST.CATOD.NAME
					sv_u = urhk_dbSelectWithBind(sv_s)
					IF (sv_d == 0) THEN
					CUST.CATOD.name=BANCS.OUTPARAM.name
					PRINT(CUST.CATOD.name)
					CUST.CATOD.name = TOUPPER(CUST.CATOD.name)
					Print (CUST.CATOD.name)
					
					ENDIF
				 ENDIF
				  IF(FIELDEXISTS(CUST.CATOD.REFNUM))THEN
					CUST.CATOD.REFNUM = TOUPPER(CUST.CATOD.REFNUM)
					Print (CUST.CATOD.REFNUM)
					IF (CUST.CATOD.REFNUM=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "REFNUM is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF					
				 ENDIF				


				 CALL("cicupload.scr")	
					print(CUST.CATOD.numOfValues)
					print(sv_c)
					IF ((CINT(CUST.CATOD.numOfValues) == 3 ) AND (sv_c == 0)) THEN
					#{
						sv_s = "echo" + " '" +  CUST.CATOD.recBackUp + "' >>" + " " + CUST.CATOD.successlogFile
						sv_d = system(sv_s)
						print(sv_d)
						#}
					ELSE
						#{
						GOTO INVALID
					#}
					ENDIF

					IF (CUST.CATOD.errColl != "") THEN
					#{
						GOTO INVALID
					#}
					ENDIF
				INVALID:
					print(sv_c)
					IF (sv_c  != 0 ) THEN
					#{
						
						CUST.CATOD.error = CUST.CATOD.recBackUp + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				RECORDSEXCEED:
					IF (sv_c  != 0 ) THEN
					#{
						CUST.CATOD.error = CUST.CATOD.fieldData1 + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				NEXTREC:
					#=================================================================================*
					# Reading the data from CSV file
					#=================================================================================*
					print(CUST.CATOD.fileindex)
					sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")
					print(sv_x)
					print(sv_n)
					CUST.CATOD.recCnt = sv_n
					sv_n = CINT(CUST.CATOD.recCnt) + 1
					CUST.CATOD.recCnt = sv_n
					sv_n = CUST.CATOD.recCnt
					print(sv_n)
				#}
				DO
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Upload Process Initiated Success fully - Check status in HPR after some time "
				print(sv_g)
				sv_z = urhk_SetOrbOut(sv_g)
				print(sv_z)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_e = "File Opened but Unable to Read."
				sv_m = "fileName"
				CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				GOTO FAILURE
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_e = "Not able to open the file for upload."
			sv_m = "fileName"
			CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
			GOTO FAILURE
		#}
		ENDIF
		
	FAILURE:
		sv_z = "SuccessOrFailure|N"
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		sv_z = CUST.CATOD.errMsg
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		
		
	ENDOFSCRIPT:
		
		IF (CUST.CATOD.errMsg == "") THEN
		#{
			#==========================================================================*
			#Pushing the Reports to HPR menu
			#==========================================================================*
			#-----------------------------------
			# Report Generation
			#-----------------------------------
			
			sv_b = urhk_getEnv("FIN_REPORTS_DIR")
			print(sv_b)
			IF (sv_b==0) THEN
			#{
				CUST.CATOD.envValue = BANCS.OUTPARAM.envValue
				print(CUST.CATOD.envValue)
			#}
			ENDIF
			
			CUST.CATOD.envValue =CUST.CATOD.envValue
			print(CUST.CATOD.envValue)
			
			#sv_a = urhk_B2K_printRepos("CUST")
			#print(sv_a)
			
			#-----------------------------------
			# Success Report
			#-----------------------------------
			sv_s = "mrbx4004 $B2K_SESSION_ID cicUploadSuc.mrt " + CUST.CATOD.successlogFile + " " + CUST.CATOD.successlogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.successlogFile = CUST.CATOD.successlogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/" + BANCS.STDIN.userId  +"/" + CUST.CATOD.successlogFile+  " 'SUCCESS CIC UPLD Report' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			#-----------------------------------
			# Failure Report
			#-----------------------------------
			
			sv_s = "mrbx4004 $B2K_SESSION_ID cicUploadFai.mrt " + CUST.CATOD.failurelogFile + " " + CUST.CATOD.failurelogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.failurelogFile = CUST.CATOD.failurelogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/"+ BANCS.STDIN.userId +"/"+CUST.CATOD.failurelogFile+" 'FAILURE CIC UPLD Report' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			
		#}
		ENDIF
	trace off
		EXITSCRIPT

end-->