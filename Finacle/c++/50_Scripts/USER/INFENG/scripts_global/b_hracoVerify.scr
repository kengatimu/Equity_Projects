<--start
trace on
#Reps/Class
#++++++++++
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("ONS")==0)then
		createrep("ONS")
	endif
	if(classexists("ONS","CUSTOM")==0)then
		createclass("ONS","CUSTOM",5)
	endif
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
#Inp
#+++

	EQSRV.GLBDATA.srvErrCode = ""
	EQSRV.GLBDATA.srvErrMsg = "" 
	EQSRV.GLBDATA.srvSucFail = ""
	EQSRV.GLBDATA.recoveryAcctId = ""
	EQSRV.GLBDATA.foracidO = ""
	EQSRV.GLBDATA.foracidT = "" 
	EQSRV.GLBDATA.foracidR = ""
	EQSRV.GLBDATA.foracidF = ""
	EQSRV.GLBDATA.foracidI = ""
	EQSRV.GLBDATA.foracidS = ""	
	BANCS.INPUT.solId = BANCS.STDIN.mySolId 
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                BANCS.INPUT.AcctNumbers = MTT.InputDetails.Argument1
                print(BANCS.INPUT.AcctNumbers)
		#BANCS.INPUT.AcctNumbers = 1200562092507|0130175809858
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        endif
			sv_l = strlen(BANCS.INPUT.AcctNumbers)
			sv_f = mid$(BANCS.INPUT.AcctNumbers,0,sv_l)
			sv_l = strlen(BANCS.INPUT.AcctNumbers)
			sv_p = getposition(sv_f,"|")
			EQSRV.GLBDATA.AcctNum= mid$(sv_f,0,(sv_p-1))
			print(EQSRV.GLBDATA.AcctNum)
			EQSRV.GLBDATA.opAcctNum = mid$(sv_f,sv_p,sv_l)
			print(EQSRV.GLBDATA.opAcctNum)

	callscriptifexist("ebRacoDataIn.scr")

	sv_d = "chargeOffAcct,loanBal,solId, opAcctNo, cifId, clrBalAmt,lienAmt |"
	sv_d = sv_d +  "select b.foracid,b.clr_bal_amt, b.sol_id, a.foracid,a.cif_id, a.clr_bal_amt,a.lien_amt from "
	sv_d = sv_d +  "(select foracid,cif_id,clr_bal_amt,lien_amt from tbaadm.gam where bank_id =?SVAR "
	sv_d = sv_d +  "and  schm_type in('SBA', 'CAA') and clr_bal_amt >0 and acct_cls_flg != 'Y')a, "
	sv_d = sv_d +  "(select gam.foracid,cif_id,clr_bal_amt,sol_id from tbaadm.gam where  acct_cls_flg != 'Y' "
	sv_d = sv_d +  "and gam.acid in (select acid from tbaadm.cot where bank_id=?SVAR "
	sv_d = sv_d +  "and entity_cre_flg='Y' and del_flg='N' and chrge_off_date is not null "
	sv_d = sv_d +  "and (chrge_off_principal <> principal_recovery or interest_recovery=0)) "
	sv_d = sv_d +  "and gam.bank_id=?SVAR "
	sv_d = sv_d +  "and gam.sol_id =?SVAR) "
	sv_d = sv_d +  "b where a.cif_id = b.cif_id "
	sv_d = sv_d +  "and (a.lien_amt < a.clr_bal_amt) "
	sv_d = sv_d +  "and b.foracid = ?SVAR and a.foracid = ?SVAR "

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId +"|"+ EQSRV.GLBDATA.AcctNum +"|"+ EQSRV.GLBDATA.opAcctNum
	print(BANCS.INPARAM.BINDVARS)

	sv_u = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.racoCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE	
		EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG 
		EQSRV.GLBDATA.srvSucFail = "F"
		goto VAYU
	endif	
	EQSRV.GLBDATA.racoRec = 0
	print(EQSRV.GLBDATA.racoCurNum)
	sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.racoCurNum)
	if(sv_z!=0)then
		EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE	
		EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG 
		EQSRV.GLBDATA.srvSucFail = "F"
		goto VAYU
	endif
	print(sv_z)
	while(sv_z ==0)
	##{ vploop starts
	#+++++++++++++++++
		print("traco loop in")
		EQSRV.GLBDATA.solId = BANCS.OUTPARAM.solId
		print(EQSRV.GLBDATA.solId)
		EQSRV.GLBDATA.foracid = BANCS.OUTPARAM.chargeOffAcct
		print(EQSRV.GLBDATA.foracid)
		EQSRV.GLBDATA.loanBal = BANCS.OUTPARAM.loanBal
		print(EQSRV.GLBDATA.loanBal) 
		EQSRV.GLBDATA.loanBal = cdouble(BANCS.OUTPARAM.loanBal) * -1
		print(EQSRV.GLBDATA.loanBal) 
		EQSRV.GLBDATA.cifId = BANCS.OUTPARAM.cifId
		print(EQSRV.GLBDATA.cifId)
		EQSRV.GLBDATA.recoveryAmt = BANCS.OUTPARAM.clrBalAmt
		print(EQSRV.GLBDATA.recoveryAmt) 
		EQSRV.GLBDATA.recoveryAcctId = BANCS.OUTPARAM.opAcctNo
		print(EQSRV.GLBDATA.recoveryAcctId) 
		EQSRV.GLBDATA.lienAmt = BANCS.OUTPARAM.lienAmt
		print(EQSRV.GLBDATA.lienAmt)
		
		sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.recoveryAcctId)
                PRINT(sv_u)
                IF (sv_u ==0) THEN
                #{
                        EQSRV.GLBDATA.preEffAvailableAmt= BANCS.OUTPARAM.EffAvailableAmt
                        PRINT(EQSRV.GLBDATA.preEffAvailableAmt)
                #}
                ENDIF

		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ EQSRV.GLBDATA.foracid
		print(BANCS.INPARAM.BINDVARS)
		sv_d = "normalIntAmt,penalIntAmt |"
		sv_d = sv_d +  "select (INT_SUSPENSE_AMT-INTEREST_RECOVERY)OutSuspInt, (PENAL_INT_SUSPENSE_AMT-PENAL_INT_RECOVERY) OutPenalInt "
		sv_d = sv_d +  "from tbaadm.cot where bank_id = ?SVAR "
		sv_d = sv_d +  "and acid in (select acid from tbaadm.gam where bank_id = ?SVAR and foracid = ?SVAR) "
		PRINT(sv_d)

		sv_u = urhk_dbSelectWithBind(sv_d)
		PRINT(sv_u)			
		IF (sv_u == 0) THEN
		#{
		EQSRV.GLBDATA.normalIntAmt= BANCS.OUTPARAM.normalIntAmt
		PRINT(EQSRV.GLBDATA.normalIntAmt)
		EQSRV.GLBDATA.penalIntAmt= BANCS.OUTPARAM.penalIntAmt
		PRINT(EQSRV.GLBDATA.penalIntAmt)
		#}
		ELSE
		#{
		EQSRV.GLBDATA.normalIntAmt = 0
		EQSRV.GLBDATA.penalIntAmt = 0
		#}
		ENDIF

		EQSRV.GLBDATA.OutLoanBal = EQSRV.GLBDATA.loanBal
		print(EQSRV.GLBDATA.OutLoanBal)

		IF (CDOUBLE(EQSRV.GLBDATA.OutLoanBal) > CDOUBLE(EQSRV.GLBDATA.preEffAvailableAmt)) THEN
			EQSRV.GLBDATA.recoveryAmt = EQSRV.GLBDATA.preEffAvailableAmt
			PRINT(EQSRV.GLBDATA.recoveryAmt)
		ELSE
			EQSRV.GLBDATA.recoveryAmt = EQSRV.GLBDATA.OutLoanBal
			PRINT(EQSRV.GLBDATA.recoveryAmt)
		ENDIF

		#ContextSol
		#++++++++++
			print(BANCS.STDIN.mySolId)
			print(EQSRV.GLBDATA.solId)
			if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.solId ) then
				sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.solId)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
					print(BANCS.OUTPARAM.successOrFailure)
					sv_s = BANCS.OUTPARAM.successOrFailure
				else
					sv_s = "X"
				endif
				if (( sv_u != 0 ) and ( sv_s != "S"))then
					EQSRV.GLBDATA.srvErrMsg	=	"CCS Failed"
					EQSRV.GLBDATA.srvErrCode = "Failed : SRV_ModifyContextSol " 
					EQSRV.GLBDATA.srvSucFail = "F"
					goto NXTLP
				endif
			endif
			if(cdouble(EQSRV.GLBDATA.recoveryAmt) <=0 )then
					EQSRV.GLBDATA.srvErrMsg	="Recovery After Charge-Off Amount is Zero"
					EQSRV.GLBDATA.srvErrCode = "Failed : Recovery " 
					EQSRV.GLBDATA.srvSucFail = "F"
					goto NXTLP
			endif
			#+++++++++++++++++++++++++++++++++++++++++++++++++	
			#To get Recovery Amounts
			#+++++++++++++++++++++++++++++++++++++++++++++++++	
			callscriptifexist("ebRacoFetch.scr")
			if(fieldexists(EQSRV.GLBDATA.srvSucFail)==1)then
				if(EQSRV.GLBDATA.srvSucFail =="F")then
					goto NXTLP
				endif
				if(EQSRV.GLBDATA.srvSucFail =="S")then
					print(EQSRV.GLBDATA.recoveryAmt)
				endif
			endif
			#+++++++++++++++++++++++++++++++++++++++++++++++++	
		#FiledMapInp
		#++++++++++
			#EQSRV.GLBDATA.recoveryAmt = EQSRV.GLBDATA.clrBalAmt
			print(EQSRV.GLBDATA.recoveryAmt)
			#EQSRV.GLBDATA.recoveryAcctId = EQSRV.GLBDATA.opAcctNo
			print(EQSRV.GLBDATA.recoveryAcctId)
			print(EQSRV.GLBDATA.foracid)

			EQSRV.GLBDATA.recoveryAmt1 = EQSRV.GLBDATA.recoveryAmt
			EQSRV.GLBDATA.recoveryAmt2 = EQSRV.GLBDATA.recoveryAmt
			sv_u = urhk_SetUrhkInp("recovCrit.laAcct.foracid|" + EQSRV.GLBDATA.foracid)
			sv_u = urhk_SetUrhkInp("recovCrit.tranType.code|T")
			sv_u = urhk_SetUrhkInp("recovCrit.tranSubType|BI")
			sv_u = urhk_SetUrhkInp("recovCrit.valueDate|" + BANCS.STDIN.BODDate )
			sv_u = urhk_SetUrhkInp("recovCrit.glDate|" + BANCS.STDIN.BODDate )
			print(EQSRV.GLBDATA.recoveryAmt)
			sv_u = urhk_SetUrhkInp("recovCrit.netRecovAmt|" +EQSRV.GLBDATA.recoveryAmt + "|" + BANCS.STDIN.homeCrncyCode )
			print(EQSRV.GLBDATA.recoveryAcctId)
			sv_u = urhk_SetUrhkInp("recovCrit.srcAcct.foracid|" + EQSRV.GLBDATA.recoveryAcctId )
			sv_u = urhk_SetUrhkInp("recovCrit.funcCode|C")
			sv_u = urhk_SetUrhkInp("recovCrit.modeOfOper|C")
		#FieldMapOut
		#++++++++++
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.loanAmt|loanAmt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.disbAmt|disbAmt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.principal|oprincipal ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.interest|ointerest ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.bankChrg|obankChrg ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.otherChrg|otherChrg ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.fee|ofee ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.accrInt|oaccrInt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.accrPenalInt|oaccrPenalInt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.penalInterest|openalInterest ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.chrgOfPrincipal|ochrgOfPrincipal ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.bookedInt|obookedInt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.outstanding.bookedPenalInt|obookedPenalInt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.chrgOffDate|chrgOffDate ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.laPmtAmt|laPmtAmt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.chrgCrncyCode|chrgCrncyCode ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.bookedInt|bookedInt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.accrInt|accrInt ")
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.cotCookie|cotCookie ") 
                        sv_u = urhk_SetUrhkOut("recovAcctDtl.bookedPenalInt|bookedPenalInt ")

			sv_u = urhk_SetUrhkOut("recoveryAmt.principal| rprincipal ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.interest| rinterest ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.bankChrg| rbankChrg ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.otherChrg| rotherChrg ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.fee| rfee ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.accrInt| raccrInt ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.accrPenalInt| raccrPenalInt ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.penalInterest| rpenalInterest ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.chrgOfPrincipal| rchrgOfPrincipal ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.bookedInt| rbookedInt ")
			sv_u = urhk_SetUrhkOut("recoveryAmt.bookedPenalInt| rbookedPenalInt ")
		#fetchSrv
		#++++++++++
			sv_u = urhk_ExecSrv("SRV_FetchAcctDtlForRecov|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
			print(sv_u)

			if (sv_u == 0)  then
				EQSRV.GLBDATA.loanAmt=BANCS.OUTPARAM.loanAmt
				EQSRV.GLBDATA.disbAmt=BANCS.OUTPARAM.disbAmt
				EQSRV.GLBDATA.oprincipal=BANCS.OUTPARAM.oprincipal
				EQSRV.GLBDATA.ointerest=BANCS.OUTPARAM.ointerest
				print(EQSRV.GLBDATA.ointerest)
				EQSRV.GLBDATA.obankChrg=BANCS.OUTPARAM.obankChrg
				EQSRV.GLBDATA.otherChrg=BANCS.OUTPARAM.otherChrg
