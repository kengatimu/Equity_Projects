				print(EQSRV.GLBDATA.rchrgOfPrincipal)
				print(EQSRV.GLBDATA.rbookedInt)
				print(EQSRV.GLBDATA.rbookedPenalInt)

			else
				print(EQSRV.GLBDATA.foracid)
				EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.foracid
				callscriptifexist("ebsrvHandler.scr") 
				EQSRV.GLBDATA.srvErrMsg	= EQSRV.GLBDATA.SrvError 
				EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctDtlForRecov " 
				EQSRV.GLBDATA.srvSucFail = "F"
				goto NXTLP
			endif
		#FiledMapInp
		#++++++++++
			print(EQSRV.GLBDATA.foracid)
			sv_u = urhk_SetUrhkInp("recovCrit.laAcct.foracid|" + EQSRV.GLBDATA.foracid)
			sv_u = urhk_SetUrhkInp("recovCrit.tranType.code|T")
			sv_u = urhk_SetUrhkInp("recovCrit.tranSubType|BI")
			sv_u = urhk_SetUrhkInp("recovCrit.valueDate|" + BANCS.STDIN.BODDate )
			sv_u = urhk_SetUrhkInp("recovCrit.glDate|" + BANCS.STDIN.BODDate )
			print(EQSRV.GLBDATA.recoveryAmt)
			sv_u = urhk_SetUrhkInp("recovCrit.netRecovAmt|" +EQSRV.GLBDATA.recoveryAmt1 + "|" + BANCS.STDIN.homeCrncyCode )
			print(EQSRV.GLBDATA.recoveryAcctId)
			sv_u = urhk_SetUrhkInp("recovCrit.srcAcct.foracid|" + EQSRV.GLBDATA.recoveryAcctId )
			sv_u = urhk_SetUrhkInp("recovCrit.funcCode|C")
			sv_u = urhk_SetUrhkInp("recovCrit.modeOfOper|C")
                #FieldMapOut
                #++++++++++
		print(EQSRV.GLBDATA.ochrgOfPrincipal)
		print(EQSRV.GLBDATA.ointerest)
		print(EQSRV.GLBDATA.openalInterest)

			sv_l = strlen(EQSRV.GLBDATA.ochrgOfPrincipal)
			sv_f = mid$(EQSRV.GLBDATA.ochrgOfPrincipal,0,sv_l)
			sv_l = strlen(EQSRV.GLBDATA.ochrgOfPrincipal)
			sv_p = getposition(sv_f,"|")
