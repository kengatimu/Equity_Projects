				print(EQSRV.GLBDATA.loanAmt)
				print(EQSRV.GLBDATA.disbAmt)
				print(EQSRV.GLBDATA.oprincipal)
				print(EQSRV.GLBDATA.ointerest)
				print(EQSRV.GLBDATA.obankChrg)
				print(EQSRV.GLBDATA.otherChrg)
				print(EQSRV.GLBDATA.ofee)
				print(EQSRV.GLBDATA.oaccrInt)
				print(EQSRV.GLBDATA.oaccrPenalInt)
				print(EQSRV.GLBDATA.openalInterest)
				print(EQSRV.GLBDATA.ochrgOfPrincipal)
				print(EQSRV.GLBDATA.obookedInt)
				print(EQSRV.GLBDATA.obookedPenalInt)
				print(EQSRV.GLBDATA.chrgOffDate)
				print(EQSRV.GLBDATA.laPmtAmt)
				print(EQSRV.GLBDATA.chrgCrncyCode)
				print(EQSRV.GLBDATA.bookedInt)
				print(EQSRV.GLBDATA.accrInt)
				print(EQSRV.GLBDATA.cotCookie)
				print(EQSRV.GLBDATA.bookedPenalInt)
				print(EQSRV.GLBDATA.rprincipal)
				print(EQSRV.GLBDATA.rinterest)
