				EQSRV.GLBDATA.ochrgOfPrincipal=BANCS.OUTPARAM.ochrgOfPrincipal
				EQSRV.GLBDATA.obookedInt=BANCS.OUTPARAM.obookedInt
				EQSRV.GLBDATA.obookedPenalInt=BANCS.OUTPARAM.obookedPenalInt
				EQSRV.GLBDATA.chrgOffDate=BANCS.OUTPARAM.chrgOffDate
				EQSRV.GLBDATA.laPmtAmt=BANCS.OUTPARAM.laPmtAmt
				EQSRV.GLBDATA.chrgCrncyCode=BANCS.OUTPARAM.chrgCrncyCode
				EQSRV.GLBDATA.bookedInt=BANCS.OUTPARAM.bookedInt
				EQSRV.GLBDATA.accrInt=BANCS.OUTPARAM.accrInt
				EQSRV.GLBDATA.cotCookie=BANCS.OUTPARAM.cotCookie
				EQSRV.GLBDATA.bookedPenalInt=BANCS.OUTPARAM.bookedPenalInt
