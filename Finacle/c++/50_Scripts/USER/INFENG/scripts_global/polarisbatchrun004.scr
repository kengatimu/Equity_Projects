								print(BANCS.STDIN.sysDate)
								
								print(BANCS.STDIN.BODDate)
								
								
								sv_g = mid$(BANCS.STDIN.sysDate,0,10)
								print(sv_g)
								sv_h = mid$(BANCS.STDIN.BODDate,0,10)
								print(sv_h)
								#}
							ELSE
								#{
								
								MISS.CHRG.tranid="NULL"
							#}
							ENDIF
							
							
							print(MISS.CHRG.getboddate)


						#+365
						sv_s = "getboddatenx|select to_char((to_date(?SVAR,'DD-MM-YYYY') +365),'DD-MON-YYYY') from dual"
						BANCS.INPARAM.BINDVARS =  MISS.CHRG.getboddate
						sv_d = urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF (sv_d =="0") THEN
						#{
							MISS.CHRG.getboddatenx = BANCS.OUTPARAM.getboddatenx
							print(MISS.CHRG.getboddatenx)
						#}
						ENDIF



							
		
							
							sv_h = mid$(BANCS.STDIN.BODDate,0,10)
							print(sv_h)
							sv_s = "getboddatenow|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
							BANCS.INPARAM.BINDVARS =  sv_h
							sv_d = urhk_dbSelectWithBind(sv_s)
							print(sv_d)
							IF (sv_d =="0") THEN
							#{
								MISS.CHRG.getboddatenow = BANCS.OUTPARAM.getboddatenow
								print(MISS.CHRG.getboddatenow)
							#}
							ENDIF
							
							sv_s = " update CUSTOM.POLARIS_CHARGES set NEXT_RUN_DATE=?SVAR, LAST_UPDATED=?SVAR, LAST_RUN_DATE=?SVAR "
							sv_s = sv_s + "  where  ENTITY_CRE_FLG='Y' AND CHARGE_TYPE='ANNUAL' AND CHARGE_ACC=?SVAR AND NEXT_RUN_DATE=?SVAR AND bank_id=?SVAR   "
							PRINT(sv_s)
							BANCS.INPARAM.BINDVARS =  MISS.CHRG.getboddatenx + "|" + MISS.CHRG.getboddatenow + "|" + MISS.CHRG.getboddatenow + "|" +  MISS.CHRG.charge_acc + "|" + MISS.CHRG.getboddate + "|" + BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							
							sv_d = urhk_dbSQLWithBind(sv_s)
							print(sv_d)
							sv_d = urhk_dbSQLWithBind("COMMIT")
							print(sv_d)
							########
							STEP3:
							#}
							ENDIF
						#}
