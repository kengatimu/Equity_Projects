<--start
	trace on
        libname CUSTOMSO
	if(repexists("CUST") == 0) then
		CREATEREP("CUST")
	endif
	if (CLASSEXISTS("CUST", "HOCCM") == 0) then
		CREATECLASS("CUST", "HOCCM", 5)
	endif
	if (CLASSEXISTS("CUST", "INTERFACE") == 0) then
		CREATECLASS("CUST", "INTERFACE", 5)
	endif
	CUST.HOCCM.Record1 = ""
	CUST.HOCCM.status = ""
	CUST.HOCCM.respD = ""
	CUST.HOCCM.fails = ""
	CUST.HOCCM.ServiceStatus = ""
	CUST.HOCCM.ProcessStatus = ""
	CUST.HOCCM.ErrorCode = ""
	CUST.HOCCM.DataStatus = ""
	CUST.HOCCM.ScanVal = ""
	CUST.HOCCM.OScanVal = ""
	CUST.HOCCM.ODataStatus = ""
	CUST.HOCCM.OErrorCode = ""
	CUST.HOCCM.ODataStatus = ""
	CUST.HOCCM.OServiceStatus = ""
	CUST.HOCCM.OProcessStatus = ""
	######BANCS.INPUT.UniqueString = "PK077711607591738"
	######BANCS.INPUT.ModuleId = "SCANCALLBACK" 
	CUST.HOCCM.UniqueString = TOUPPER(TRIM(BANCS.INPUT.UniqueString))
	print(CUST.HOCCM.UniqueString)
	CUST.HOCCM.ModuleId = TOUPPER(TRIM(BANCS.INPUT.ModuleId))
	print(CUST.HOCCM.ModuleId)
	CUST.INTERFACE.errorMsgFlg = ""
 	CUST.INTERFACE.errorMsgDesc = ""	
	if(CUST.HOCCM.UniqueString=="")then
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = "Input Param Not Exists for Third Party Call Failed"
		goto ENDOFSCRIPT
	endif
        sv_a = urhk_getEnv("FIN_REPORTS_DIR")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
                CUST.INTERFACE.errorMsgFlg = "Y"
                CUST.INTERFACE.errorMsgDesc = "System Param Not Exists for Third Party Call Failed"
                goto ENDOFSCRIPT
	else
		CUST.HOCCM.ReptPath = BANCS.OUTPARAM.envValue		
		CUST.HOCCM.ReptPath = CUST.HOCCM.ReptPath + "/" + BANCS.STDIN.userId 
        endif
        sv_a = urhk_getEnv("TBA_PROD_ROOT")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
                CUST.HOCCM.rootpath = "/finacle/EQPROD/BackEnd/Finacle/FC/app/cust/INFENG"
                ###CUST.HOCCM.rootpath = "/finacle/EQPROD/Fin10218/APP/Finacle/FC/app/cust/INFENG"
        else
                CUST.HOCCM.rootpath = BANCS.OUTPARAM.envValue
                CUST.HOCCM.rootpath = CUST.HOCCM.rootpath + "/cust/INFENG"
        endif
        print(CUST.HOCCM.rootpath)
        sv_s = "refNum|SELECT CONCAT(CONCAT('EQVPH',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5)))"
        sv_s = sv_s + " FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        if(sv_d == 0)then
                CUST.HOCCM.refNum = BANCS.OUTPARAM.refNum
                print(CUST.HOCCM.refNum)
        endif
        CUST.HOCCM.edResp =  CUST.HOCCM.ReptPath +"/" + CUST.HOCCM.refNum + ".dat"
	print(CUST.HOCCM.edResp)
        if(CUST.HOCCM.ModuleId=="SCANCALLBACK")then
                sv_d = "httpURL | select lower(v.parameter_value) from custom.c_cpvalue  v,custom.c_cpmaster m "
                sv_d = sv_d + " where m.parameter_id=v.parameter_id "
                sv_d = sv_d + " and m.module_name =v.module_name "
                sv_d = sv_d + " and m.module_name='CBSPRIMARY' "
                sv_d = sv_d + " and m.parameter_level='BNKL' "
                sv_d = sv_d + " and v.parameter_id=?SVAR "
                sv_d = sv_d + " and m.entity_cre_flg='Y' "
                sv_d = sv_d + " and v.entity_cre_flg='Y' "
                sv_d = sv_d + " and m.del_flg='N' "
                sv_d = sv_d + " and v.del_flg='N' "
                sv_d = sv_d + " and m.bank_id=?SVAR "
                sv_d = sv_d + " and v.bank_id=?SVAR "
                BANCS.INPARAM.BINDVARS = "EPURL|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u==0)then
                        CUST.HOCCM.httpURL = BANCS.OUTPARAM.httpURL
                endif
        endif
        CUST.HOCCM.jInp = CUST.HOCCM.httpURL + " " +  CUST.HOCCM.UniqueString
        print(CUST.HOCCM.jInp)
        if(CUST.HOCCM.ModuleId=="SCANCALLBACK")then
        sv_r=system("java -cp /finacle/jdk1.7.0_80/lib:/finacle/jdk1.7.0_80/custom:/finacle/jdk1.7.0_80/custom/json-simple-1.1.jar:" +CUST.HOCCM.rootpath+ " com.cubpEquityDirect.EBChequeScanResp.EBChequeScanResp "+ CUST.HOCCM.jInp + " >> " +CUST.HOCCM.edResp )
        ###print(sv_r)
        endif
        sv_a = urhk_getEnv("ONS_LOG_DIR")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = "System Param Not Exists for Third Party Call Failed"
		goto ENDOFSCRIPT
        endif
        CUST.HOCCM.ONS_path = BANCS.OUTPARAM.envValue
        print(CUST.HOCCM.ONS_path)
        ##CUST.HOCCM.fileLoc = CUST.HOCCM.ONS_path +"/"+BANCS.STDIN.userId + "/" + CUST.HOCCM.edResp
        ##print(CUST.HOCCM.fileLoc)
        CUST.HOCCM.fileLoc = CUST.HOCCM.edResp 
        print(CUST.HOCCM.fileLoc)
	lv_u = system("chmod 755 " + CUST.HOCCM.fileLoc )
	print(lv_u)
        sv_r = urtn_fileAccess(CUST.HOCCM.fileLoc)
        print(sv_r)
        if(sv_r != 0)then
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = "Third Party Call Failed"
		goto ENDOFSCRIPT
        else
                CUST.HOCCM.fileopen = "Y"
		#####sv_r=system("sed 's/\\//g' " +CUST.HOCCM.fileLoc+ " >> " + CUST.HOCCM.edResp )
		#####print(sv_r)
        endif
        print(CUST.HOCCM.fileopen)
        sv_s = urtn_fileOpen(CUST.HOCCM.fileLoc + "|r")
	print(sv_s)
        if(sv_s < 0)then
                print("error in openning file")
                ##CUST.INTERFACE.errorMsgFlg = "Y"
                ##CUST.INTERFACE.errorMsgDesc = "Reading Response from Return file Failed!!!"
                ##goto ENDOFSCRIPT
        else
        sv_k = urtn_fileRead(sv_s+"|CUST.HOCCM.Record1")
	print(sv_k)
        CUST.HOCCM.recNum =1
        while(sv_k == 0)
        #{
                if(CUST.HOCCM.Record1 =="")then
                        goto NEXTRECORD
                else
                        print(CUST.HOCCM.Record1)
                endif
		if(mid$(CUST.HOCCM.Record1,0,2)=="SS")then
			CUST.HOCCM.ServiceStatus = CUST.HOCCM.Record1
			print(CUST.HOCCM.ServiceStatus)
			sv_l = strlen(CUST.HOCCM.ServiceStatus)
			sv_f = mid$(CUST.HOCCM.ServiceStatus,0,sv_l)
			sv_p = getposition(sv_f,"|")
			CUST.HOCCM.OType  = mid$(sv_f,0,(sv_p-1))
			print(CUST.HOCCM.OType)
			CUST.HOCCM.OServiceStatus = mid$(sv_f,sv_p,sv_l)
			print(CUST.HOCCM.OServiceStatus)
		endif
		if(mid$(CUST.HOCCM.Record1,0,2)=="PS")then
			CUST.HOCCM.ProcessStatus = CUST.HOCCM.Record1
			sv_l = strlen(CUST.HOCCM.ProcessStatus)
			sv_f = mid$(CUST.HOCCM.ProcessStatus,0,sv_l)
			sv_p = getposition(sv_f,"|")
			CUST.HOCCM.OType  = mid$(sv_f,0,(sv_p-1))
			print(CUST.HOCCM.OType)
			CUST.HOCCM.OProcessStatus = mid$(sv_f,sv_p,sv_l)
			print(CUST.HOCCM.OProcessStatus)
		endif
		if(mid$(CUST.HOCCM.Record1,0,2)=="EC")then
			CUST.HOCCM.ErrorCode = CUST.HOCCM.Record1
			sv_l = strlen(CUST.HOCCM.ErrorCode)
			sv_f = mid$(CUST.HOCCM.ErrorCode,0,sv_l)
			sv_p = getposition(sv_f,"|")
			CUST.HOCCM.OType  = mid$(sv_f,0,(sv_p-1))
			print(CUST.HOCCM.OType)
			CUST.HOCCM.OErrorCode = mid$(sv_f,sv_p,sv_l)
			print(CUST.HOCCM.OErrorCode)
		endif
		if(mid$(CUST.HOCCM.Record1,0,2)=="DS")then
			CUST.HOCCM.DataStatus = CUST.HOCCM.Record1
			sv_l = strlen(CUST.HOCCM.DataStatus)
			sv_f = mid$(CUST.HOCCM.DataStatus,0,sv_l)
			sv_p = getposition(sv_f,"|")
			CUST.HOCCM.OType  = mid$(sv_f,0,(sv_p-1))
			print(CUST.HOCCM.OType)
			CUST.HOCCM.ODataStatus = mid$(sv_f,sv_p,sv_l)
			print(CUST.HOCCM.ODataStatus)
		endif
		if(mid$(CUST.HOCCM.Record1,0,2)=="SV")then
			CUST.HOCCM.ScanVal = CUST.HOCCM.Record1
			sv_l = strlen(CUST.HOCCM.ScanVal)
			sv_f = mid$(CUST.HOCCM.ScanVal,0,sv_l)
			sv_p = getposition(sv_f,"|")
			CUST.HOCCM.OType  = mid$(sv_f,0,(sv_p-1))
			print(CUST.HOCCM.OType)
			CUST.HOCCM.OScanVal = mid$(sv_f,sv_p,sv_l)
			print(CUST.HOCCM.OScanVal)
		endif
                NEXTRECORD:
                sv_k = urtn_fileRead(sv_s+"|CUST.HOCCM.Record1")
                print(CUST.HOCCM.recNum)
                CUST.HOCCM.recNum = CINT(CUST.HOCCM.recNum) +1
                print(CUST.HOCCM.recNum)
        #}
        do
        endif
	if((CUST.HOCCM.ScanVal!="")and(CUST.HOCCM.DataStatus=="DS|SUCCESS")and(CUST.HOCCM.ErrorCode!=""))then
	if(strlen(CUST.HOCCM.OScanVal)>=5)then
		sv_w = "SuccessOrFailure|Y"
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
		###CUST.INTERFACE.ScanResp = "068~1323~002~200.00~343433~9200870001~234245~11"
		sv_w = "ScanResp|" + CUST.HOCCM.OScanVal 
		print(sv_w)
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
	endif
	endif
	print(strlen(CUST.HOCCM.ErrorCode))
	if(strlen(CUST.HOCCM.ErrorCode)>=4)then
		sv_w = "SuccessOrFailure|F"
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
		sv_w = "ScanResp|" + CUST.HOCCM.OErrorCode 
		print(sv_w)
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
	endif
	if((CUST.HOCCM.DataStatus!="DS|SUCCESS") and (CUST.HOCCM.DataStatus!=""))then
		if(strlen(CUST.HOCCM.ODataStatus)>=6)then
		sv_w = "SuccessOrFailure|F"
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
		sv_w = "ScanResp|" + CUST.HOCCM.ODataStatus 
		print(sv_w)
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
		endif
	endif
	if((CUST.HOCCM.ServiceStatus!="SS|SUCCESS") and (CUST.HOCCM.ServiceStatus!=""))then
	if(strlen(CUST.HOCCM.OServiceStatus)>=1)then
		sv_w = "SuccessOrFailure|F"
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
		sv_w = "ScanResp|" + CUST.HOCCM.OServiceStatus 
		print(sv_w)
		sv_u = urhk_SetOrbOut(sv_w)
		print(sv_u)
	endif
	endif
ENDOFSCRIPT:
	print(CUST.INTERFACE.errorMsgFlg)
	print(CUST.INTERFACE.errorMsgDesc)
	if(CUST.INTERFACE.errorMsgFlg == "Y") then
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
		sv_z = "Error_0|" + CUST.INTERFACE.errorMsgDesc
		sv_u = urhk_SetOrbOut(sv_z)
		CUST.HOCCM.successFlg = "F"
	endif
	####sv_s = system("rm -f " + CUST.HOCCM.fileLoc)
        #####print(sv_s)
	if(classexists("CUST","HOCCM") != 0) then
		DELETECLASS ("CUST","HOCCM")
	endif
	if(classexists("CUST","INTERFACE") != 0) then
		deleteclass("CUST","INTERFACE")
	endif
	if(repexists("CUST") != 0)then
		deleterep("CUST")
	endif
	exitscript
	trace off
end-->
