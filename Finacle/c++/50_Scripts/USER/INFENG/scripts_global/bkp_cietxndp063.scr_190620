	CUST.CIETXN.scriptSuccess = "Y"
	
	#CALL("cietxndp008.scr")
	
	IF(CUST.CIETXN.scriptSuccess == "N")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Get Charge Details
	######################################################################################
	
	CUST.CIETXN.tranParticularForFICall = "DEBIT TRANSFER THRU " + MID$(BANCS.STDIN.homeCrncyCode,0,2) + " - " + BANCS.STDIN.mySolDesc
	
	CUST.CIETXN.scriptSuccess = "Y"
	CALL("cietxndp054.scr")
	IF(CUST.CIETXN.scriptSuccess == "N")THEN
	#{
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Create Transaction in the Current Entity
	######################################################################################
	
	CUST.CIETXN.scriptSuccess = "Y"
	CALL("cietxndp064.scr")
	
	IF(CUST.CIETXN.scriptSuccess == "N")THEN
	#{
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.entity1 = BANCS.STDIN.contextBankId
	CUST.CIETXN.entity1TranDate = MID$(CUST.CIETXN.entity1TranDate,0,10)
	
	######################################################################################
	# Obtain the IE_TXN_REF_NO
	######################################################################################
	
	CUST.CIETXN.seqNextVal = ""
	CUST.CIETXN.ieTxnRefNo = ""
	
	sv_s = "seqNextVal|SELECT LPAD(CUSTOM.IE_TXN_REF_NO_SEQ.NEXTVAL,'6','0') FROM DUAL"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.seqNextVal = BANCS.OUTPARAM.seqNextVal
		PRINT(CUST.CIETXN.seqNextVal)
		#}
	ELSE
		#{
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Could not get Inter Entity Transaction Reference Number^prodCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Create Transaction in the Other Entity Through FI Call
	######################################################################################
	
	CUST.CIETXN.entity2 = CUST.CIETXN.drAcctNumEntityId
	CUST.CIETXN.ieTxnRefNo = CUST.CIETXN.entity1 + CUST.CIETXN.entity2 + CUST.CIETXN.seqNextVal
	PRINT(CUST.CIETXN.ieTxnRefNo)
	
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	print(BANCS.STDIN.sysDate)
	
	sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.RequestID = BANCS.OUTPARAM.RequestID
		print(CUST.CIETXN.RequestID)
		#}
	ELSE
		#{
		CUST.CIETXN.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(CUST.CIETXN.RequestID)
	#}
	ENDIF
	
	#####################################################################
	# Code To Replace Special Characters before FI Call
	# 1. For CUST.CIETXN.tranParticular1
	# 2. For CUST.CIETXN.drAcctName
	#####################################################################
	
	lv_a = CUST.CIETXN.tranParticular1
	
	lv_l = STRLEN(lv_a)
	lv_n = 0
	lv_s = ""
	WHILE(lv_n < lv_l)
	#{
		PRINT(lv_a)
		PRINT(lv_n)
		lv_c = ""
		lv_c = MID$(lv_a,lv_n,1)
		print(lv_c)
		
		IF(lv_c == "&")THEN
		#{
			PRINT("IF")
			lv_s = lv_s + " "
			PRINT(lv_s)
			GOTO NEXT_CHAR1
		#}
		ENDIF
		
		IF(lv_c == "|")THEN
		#{
			PRINT("IF")
			lv_s = lv_s + " - "
			PRINT(lv_s)
			GOTO NEXT_CHAR1
		#}
		ENDIF
		
		IF(lv_c == "'")THEN
		#{
			PRINT("IF")
			lv_s = lv_s + ""
			PRINT(lv_s)
			GOTO NEXT_CHAR1
		#}
		ENDIF
		
		lv_s = lv_s + lv_c
		PRINT(lv_s)
		
		NEXT_CHAR1:
			
			lv_n = lv_n + 1
		#}
		DO
		
		PRINT(lv_a)
		PRINT(lv_s)
		
		CUST.CIETXN.tranParticular1 = lv_s
		
		#----------------------------------------------------------------------
		
		lv_a = CUST.CIETXN.drAcctName
		
		lv_l = STRLEN(lv_a)
		lv_n = 0
		lv_s = ""
		WHILE(lv_n < lv_l)
		#{
			PRINT(lv_a)
			PRINT(lv_n)
			lv_c = ""
			lv_c = MID$(lv_a,lv_n,1)
			print(lv_c)
			
			IF(lv_c == "&")THEN
			#{
				PRINT("IF")
				lv_s = lv_s + " "
				PRINT(lv_s)
				GOTO NEXT_CHAR2
			#}
			ENDIF
			
			IF(lv_c == "|")THEN
			#{
				PRINT("IF")
				lv_s = lv_s + " - "
				PRINT(lv_s)
				GOTO NEXT_CHAR2
			#}
			ENDIF
			
			IF(lv_c == "'")THEN
			#{
				PRINT("IF")
				lv_s = lv_s + ""
				PRINT(lv_s)
				GOTO NEXT_CHAR2
			#}
			ENDIF
			
			lv_s = lv_s + lv_c
			PRINT(lv_s)
			
		NEXT_CHAR2:
			
			lv_n = lv_n + 1
		#}
		DO
		
		PRINT(lv_a)
		PRINT(lv_s)
		
		CUST.CIETXN.drAcctName  = lv_s
		
		#----------------------------------------------------------------------
		# Get Rate Code For Target Entity Transaction
		#----------------------------------------------------------------------
		
		BANCS.INPUT.initOrInterOrTargetEntity = "T"
		BANCS.INPUT.initEntity = CUST.CIETXN.contextBankId
		BANCS.INPUT.targetEntity = CUST.CIETXN.drAcctNumEntityId
		BANCS.INPUT.foracid = CUST.CIETXN.vostroAcct
		BANCS.INPUT.refCrncy = CUST.CIETXN.drAcctNumCcy
		BANCS.INPUT.refAmt = CUST.CIETXN.tranAmt
		
		CUST.CIETXN.ieRateCode = ""
		CUST.CIETXN.ieRate = ""
		CUST.CIETXN.ieTreaRate = ""
		
		CALL("cietxndp067.scr")
		
		PRINT(CUST.CIETXN.ieRateCode)
		PRINT(CUST.CIETXN.ieRate)
		PRINT(CUST.CIETXN.ieTreaRate)
		
		IF((TRIM(CUST.CIETXN.ieRateCode) == "") AND (CDOUBLE(CUST.CIETXN.ieRate) != 1))THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^" + CUST.CIETXN.errorMsg + "^funcCode"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			CUST.CIETXN.scriptSuccess  = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.INTERFACE.interfaceRequestID = "XferTrnAdd"
		CUST.INTERFACE.interfaceRequestVersion = "10.2"
		CUST.INTERFACE.RequestID = CUST.CIETXN.RequestID
		CUST.INTERFACE.bankID = CUST.CIETXN.entity2
		CUST.INTERFACE.channelID = "COR"
		CUST.INTERFACE.tranType = "T"
		CUST.INTERFACE.tranSubType = "CI"
		CUST.INTERFACE.crAcctID = CUST.CIETXN.vostroAcct
		CUST.INTERFACE.drAcctID = CUST.CIETXN.drAcctNum
		CUST.INTERFACE.tranAmtCr = CDOUBLE(CUST.CIETXN.tranAmt)
		CUST.INTERFACE.tranCcyCr = CUST.CIETXN.tranAmtCcy
		CUST.INTERFACE.tranAmtDr = CDOUBLE(CUST.CIETXN.tranAmt)
		CUST.INTERFACE.tranCcyDr = CUST.CIETXN.tranAmtCcy
		CUST.CIETXN.tranParticular1 = CUST.CIETXN.tranParticularForFICall
		CUST.INTERFACE.tranParticularsCr = MID$(CUST.CIETXN.tranParticular1,0,50)
		CUST.INTERFACE.tranParticularsDr = MID$(CUST.CIETXN.tranParticular1,0,50)
		CUST.INTERFACE.tranRmksCr = MID$(CUST.CIETXN.drAcctName,0,30)
		CUST.INTERFACE.tranRmksDr = CUST.CIETXN.refCrncy + " / " + CUST.CIETXN.refAmt + " @ " + CUST.CIETXN.rate
		CUST.INTERFACE.tranRmksDr = MID$(CUST.INTERFACE.tranRmksDr,0,30)
		CUST.INTERFACE.tranParticulars2Dr = ""
		CUST.INTERFACE.tranParticulars2Cr = ""
		CUST.INTERFACE.refNumDr = CUST.CIETXN.ieTxnRefNo
		CUST.INTERFACE.refNumCr = CUST.CIETXN.ieTxnRefNo
		CUST.INTERFACE.drValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.rateCode = CUST.CIETXN.ieRateCode
		CUST.INTERFACE.drRate = CUST.CIETXN.ieRate
		CUST.INTERFACE.crRate = CUST.CIETXN.ieRate
		CUST.INTERFACE.chkInstDetails = CUST.CIETXN.chkInstDetails
		CUST.INTERFACE.instDate = CUST.CIETXN.instrumentDate
		CUST.INTERFACE.instAlpha = CUST.CIETXN.instrumentAlpha
		CUST.INTERFACE.instNum = CUST.CIETXN.instrumentNum
		CUST.INTERFACE.instType = CUST.CIETXN.instrumentType
		
		CUST.INTERFACE.chargeAmtPartTran = "Y"
		CUST.INTERFACE.cwCharge = "Y"
		
		CUST.INTERFACE.chargeDrAcctID = CUST.CIETXN.drAcctNum
		CUST.INTERFACE.chargeCrAcctID = CUST.CIETXN.chargeCrAcctID
		CUST.INTERFACE.chargeTranAmt = CUST.CIETXN.chargeTranAmt
		CUST.INTERFACE.chargeTranCcy = CUST.CIETXN.chargeTranCcy
		CUST.INTERFACE.chargeRateCode = CUST.CIETXN.chargeRateCode
		CUST.INTERFACE.chargeRate = CUST.CIETXN.chargeRate
		CUST.INTERFACE.chargeTranParticulars = "INTER COUNTRY TRANSFER CHARGE"
		CUST.INTERFACE.chargeTranRmks = CUST.CIETXN.chargeTranRmks
		
		CUST.INTERFACE.errorMsgFlg = "N"
		CUST.INTERFACE.errorMsgCode = " "
		CUST.INTERFACE.errorMsgDesc = " "
		CUST.INTERFACE.errorDesc = " "
		CUST.INTERFACE.errorCode = " "
		
		CALL("cietxnmn003.scr")
		
		IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Could not create transaction in the other entity^prodCode")
			print(sv_u)
			
			lv_a = CUST.INTERFACE.errorDesc
			
			lv_l = STRLEN(lv_a)
			lv_n = 0
			lv_s = ""
			WHILE(lv_n < lv_l)
			#{
				PRINT(lv_a)
				PRINT(lv_n)
				lv_c = ""
				lv_c = MID$(lv_a,lv_n,1)
				print(lv_c)
				
				IF(lv_c == "|")THEN
				#{
					PRINT("IF")
					lv_s = lv_s + " - "
					PRINT(lv_s)
					GOTO NEXT_CHAR
				#}
				ENDIF
				
				IF(lv_c == "'")THEN
				#{
					PRINT("IF")
					lv_s = lv_s + ""
					PRINT(lv_s)
					GOTO NEXT_CHAR
				#}
				ENDIF
				
				lv_s = lv_s + lv_c
				PRINT(lv_s)
				
			NEXT_CHAR:
				
				lv_n = lv_n + 1
			#}
			DO
			
			PRINT(lv_a)
			PRINT(lv_s)
			
			CUST.INTERFACE.errorDesc = lv_s
			CUST.INTERFACE.errorDesc = CUST.INTERFACE.errorCode + " - " + CUST.INTERFACE.errorDesc
			PRINT(CUST.INTERFACE.errorDesc)
			
			sv_s = "Error_2|Error^"+ CUST.INTERFACE.errorDesc + "^prodCode"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			
			####################################################################################################
			# To clear entry in the Referral Initiator Inbox
			####################################################################################################
			
			#IF(TRIM(CUST.CIETXN.referralid) != "")THEN
			#{
			#	sv_u = urhk_SetUrhkInp("cmnGrp.referral_id|"+CUST.CIETXN.referralid)
			#	print(sv_u)
			#	sv_u = urhk_ExecSrvNoCommit("SRV_MoveRefDtlsToHistTables|retain_all_output = Y")
			#	print(sv_u)
			#}
			#ENDIF
			
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.entity2TranId = CUST.INTERFACE.tranId
		CUST.CIETXN.entity2TranDate = MID$(CUST.INTERFACE.tranDate,0,10)
		
		######################################################################################
		# Insert data into the IETD Custom Table
		######################################################################################
		
		CALL("cietxndp065.scr")
		
		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		######################################################################################
		# Insert data into the IECWD Custom Table
		######################################################################################
		
		CALL("cietxndp059.scr")
		
		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		####################################################################################################
		# To clear entry in the Referral Initiator Inbox
		####################################################################################################
		
		#IF(TRIM(CUST.CIETXN.referralid) != "")THEN
		#{
		#	sv_u = urhk_SetUrhkInp("cmnGrp.referral_id|"+CUST.CIETXN.referralid)
		#	print(sv_u)
		#	sv_u = urhk_ExecSrvNoCommit("SRV_MoveRefDtlsToHistTables|retain_all_output = Y")
		#	print(sv_u)
		#}
		#ENDIF
		
		sv_s = "RESULT_MSG|Inter Entity Transaction For Receiving Funds From Other Entity A/c. Done Successfully. Transaction Reference No: " + CUST.CIETXN.ieTxnRefNo
		sv_s = sv_s + "!" + CUST.CIETXN.ieTxnRefNo + "!" + CUST.CIETXN.entity1 + "!" + CUST.CIETXN.entity1TranId + "!" + CUST.CIETXN.entity1TranDate + "!" + CUST.CIETXN.entity2 + "!" + CUST.CIETXN.entity2TranId + "!" + CUST.CIETXN.entity2TranDate + "!" + CUST.CIETXN.chargeTranId + "!" + CUST.CIETXN.chargeTranDate
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_u)
		
	ENDOFSCRIPT:
END-->
