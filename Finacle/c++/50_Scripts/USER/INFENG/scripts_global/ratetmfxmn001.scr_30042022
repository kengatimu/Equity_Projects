						sv_s = sv_s + "AND GAM.del_flg = 'N' "
						sv_s = sv_s + "AND GAM.bank_id = ?SVAR) "
						sv_s = sv_s + "AND DTD.part_tran_type = 'C' "
						sv_s = sv_s + "AND del_flg != 'Y' "
						sv_s = sv_s + "AND bank_id = ?SVAR)"
					#}
					ELSE
					#{
						sv_s = "count|SELECT COUNT(1) FROM DUAL WHERE EXISTS ("
						sv_s = sv_s + "SELECT 1 FROM TBAADM.HTD "
						sv_s = sv_s + "WHERE TRIM(HTD.tran_id) = TRIM(?SVAR) "
						sv_s = sv_s + "AND HTD.tran_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
						sv_s = sv_s + "AND HTD.tran_amt = ?SVAR "
						sv_s = sv_s + "AND EXISTS (SELECT GAM.acid "
						sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.DTD "
						sv_s = sv_s + "WHERE bacid = ?SVAR "
						sv_s = sv_s + "AND GAM.acid = HTD.acid "
						sv_s = sv_s + "AND GAM.sol_id = ?SVAR "
						sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
						sv_s = sv_s + "AND GAM.del_flg = 'N' "
						sv_s = sv_s + "AND GAM.bank_id = ?SVAR) "
						sv_s = sv_s + "AND HTD.part_tran_type = 'C' "
						sv_s = sv_s + "AND del_flg != 'Y' "
						sv_s = sv_s + "AND bank_id = ?SVAR )"
						PRINT(sv_s)
					#}
					ENDIF
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.RATE.refNo1 + "|" + CUST.RATE.tranRmks + "|" + CUST.RATE.amt + "|" + CUST.RATE.iglsBacid3 + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
