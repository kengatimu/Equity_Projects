	sv_u = urhk_getAcctDetailsInRepository(CUST.RATE.foracid)
	PRINT(sv_u)
	IF (sv_u ==0) THEN
	#{
		CUST.RATE.clearBalance = BANCS.OUTPARAM.clearBalance
		PRINT(CUST.RATE.clearBalance)
		CUST.RATE.schmCode     = BANCS.OUTPARAM.schmCode
		PRINT(CUST.RATE.schmCode)
		CUST.RATE.schmType     = BANCS.OUTPARAM.schmType
		PRINT(CUST.RATE.schmType)
		CUST.RATE.acctCrncyCode     = BANCS.OUTPARAM.acctCrncyCode
		PRINT(CUST.RATE.acctCrncyCode)
		("CUST").("RATE").("EB"+CUST.RATE.foracid) = BANCS.OUTPARAM.EffAvailableAmt
		CUST.RATE.preEffAvailableAmt = ("CUST").("RATE").("EB"+CUST.RATE.foracid)
		print(CUST.RATE.preEffAvailableAmt)
	#}
	ELSE
	#{
		CUST.RATE.clearBalance = ""
		CUST.RATE.schmCode     = ""
		CUST.RATE.schmType     = ""
	#}
	ENDIF


	#---------------------------=
	#EQUILOANS RESTRICTIONS
	#----------------------------
	IF (BANCS.STDIN.contextBankId == "54") THEN
	sv_n = mid$(CUST.RATE.foracid,3,10)
	print(sv_n)
		IF (sv_n =="3000103920") THEN
		print(sv_n)
			IF ((CUST.RATE.partTrantype == "D") AND (CUST.RATE.foracid !="0003000103920"))THEN
				PRINT(CDOUBLE(CUST.RATE.refAmt))
				PRINT(CDOUBLE(CUST.RATE.clearBalance))
				IF (CDOUBLE(CUST.RATE.refAmt) > CDOUBLE(CUST.RATE.clearBalance)) THEN
						sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Cannot Overdraw this account" + sv_a
						sv_u = urhk_SRV_SetErr("Cannot Overdraw this account " + " ,for PartTransrlnum " + CUST.RATE.serialnum )	
						GOTO NEXTREC
				ENDIF
			ENDIF

			IF (CUST.RATE.partTrantype == "C") THEN
					
						CUST.RATE.equiflg="Y"
						print(CUST.RATE.equiflg)			
			ENDIF
		ENDIF
		
		IF ((CUST.RATE.partTrantype == "D") AND (CUST.RATE.schmType=="SBA") OR (CUST.RATE.schmType=="CAA")) THEN

				CUST.RATE.equiflg1="Y"
				print(CUST.RATE.equiflg1)
		ENDIF 
	ENDIF

	#---------------------------=
	#IMPREST RESTRICTIONS
	#----------------------------
	IF (BANCS.STDIN.contextBankId == "54") THEN
	sv_n = mid$(CUST.RATE.foracid,3,10)
	print(sv_n)
		IF (sv_n =="1300100814") THEN
		print(sv_n)
			IF ((CUST.RATE.partTrantype == "D") AND (CUST.RATE.foracid !="0001300100814"))THEN
				PRINT(CDOUBLE(CUST.RATE.refAmt))
				PRINT(CDOUBLE(CUST.RATE.clearBalance))
				CUST.RATE.Balance=(CDOUBLE(CUST.RATE.refAmt))-(CDOUBLE(CUST.RATE.clearBalance))
				PRINT(CDOUBLE(CUST.RATE.Balance))
				CUST.RATE.resAmt="50000"
				PRINT(CDOUBLE(CUST.RATE.resAmt))
				IF (CDOUBLE(CUST.RATE.Balance) > CDOUBLE(CUST.RATE.resAmt)) THEN
						sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Cannot Overdraw this account" + sv_a
						sv_u = urhk_SRV_SetErr("Cannot Overdraw this account " + " ,for PartTransrlnum " + CUST.RATE.serialnum )	
						GOTO NEXTREC
				ENDIF
			ENDIF

			
		ENDIF
		
		
	ENDIF
	#+++++++++++++++++++++++++++++++++++++++++++++Katumo M
	#---------------------------=
	#IMPREST RESTRICTIONS checking parttran sum.
	#----------------------------
	IF (BANCS.STDIN.contextBankId == "54") THEN
		sv_n = mid$(CUST.RATE.foracid,3,10)
	    	print(sv_n)
		IF (sv_n =="1300100814") THEN
			print(sv_n)
			IF ((CUST.RATE.partTrantype == "D") AND (CUST.RATE.foracid !="0001300100814"))THEN
				PRINT(CDOUBLE(CUST.RATE.refAmt))
				CUST.RATE.IMP=((CDOUBLE(CUST.RATE.IMP))+(CDOUBLE(CUST.RATE.refAmt)))
				print (cdouble(CUST.RATE.IMP))
				CUST.RATE.resAmt="50000.00"
				PRINT(CDOUBLE(CUST.RATE.resAmt))
				IF (cdouble(CUST.RATE.IMP) > CDOUBLE(CUST.RATE.resAmt)) THEN
					sv_s = urhk_SRV_SetErr("PartTran sum exceeds set limit ")
					print (sv_s)
					GOTO NEXTREC
				ENDIF
			ENDIF

			
		ENDIF
		
		
	ENDIF
	#+++++++++++++++++++++++++++++++++++++++++++++Katumo M
	
	IF (BANCS.STDIN.contextBankId == "54") THEN
	#{
		#-------------------------------------------------------------------------------------------
		#--Start equity center accounts restriction(bafe3012Preload_dp02.scr)
		#-------------------------------------------------------------------------------------------
		PRINT(CUST.RATE.foracid)
		PRINT(CUST.RATE.acctNo1)
		IF ((CUST.RATE.foracid == CUST.RATE.acctNo1) OR (CUST.RATE.foracid == CUST.RATE.acctNo2) OR (CUST.RATE.foracid == CUST.RATE.acctNo3) OR (CUST.RATE.foracid == CUST.RATE.acctNo4) OR (CUST.RATE.foracid == CUST.RATE.acctNo5) OR (CUST.RATE.foracid == CUST.RATE.acctNo6) OR (CUST.RATE.foracid == CUST.RATE.acctNo7) OR (CUST.RATE.foracid == CUST.RATE.acctNo8) OR (CUST.RATE.foracid == CUST.RATE.acctNo9) OR (CUST.RATE.foracid == CUST.RATE.acctNo10) OR (CUST.RATE.foracid == CUST.RATE.acctNo11) OR (CUST.RATE.foracid == CUST.RATE.acctNo12) OR (CUST.RATE.foracid == CUST.RATE.acctNo13) OR (CUST.RATE.foracid == CUST.RATE.acctNo14) OR (CUST.RATE.foracid == CUST.RATE.acctNo15) OR (CUST.RATE.foracid == CUST.RATE.acctNo23)) THEN
		#{
			IF (CUST.RATE.partTrantype == "D") THEN
			#{
				PRINT(CDOUBLE(CUST.RATE.refAmt))
				PRINT(CDOUBLE(CUST.RATE.clearBalance))
				IF (CDOUBLE(CUST.RATE.refAmt) > CDOUBLE(CUST.RATE.clearBalance)) THEN
				#{
					PRINT(BANCS.STDIN.userWorkClass)
					PRINT(CUST.RATE.userWorkClass1)
					PRINT(CUST.RATE.userWorkClass2)
					IF ((CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass1)) AND (CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass2))) THEN
					#{
						sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Insufficent Workclass to Overdraw this account" + sv_a
						sv_u = urhk_SRV_SetErr("Insufficent Workclass to Overdraw this account " + " ,for PartTransrlnum " + CUST.RATE.serialnum )	
						GOTO NEXTREC
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		#--End equity center accounts restriction
		#-------------------------------------------------------------------------------------------
	#}
	ENDIF

	IF (BANCS.STDIN.contextBankId == "50") THEN
		IF (BANCS.STDIN.userWorkClass == "240") THEN
			IF ((CUST.RATE.schmType=="SBA") OR (CUST.RATE.schmType=="CAA")) THEN

				sv_m = sv_m  + CUST.RATE.serialnum + ","+ "WorkClass 240 Not allowed to transact on customer Account" + sv_a
				sv_u = urhk_SRV_SetErr("WorkClass 240 Not allowed to transact on customer Account" + CUST.RATE.schmCode + " ,in PartTransrlnum " + CUST.RATE.serialnum + "A/C NO:" + CUST.RATE.foracid)	
				GOTO NEXTREC
			ENDIF
		ENDIF
	ENDIF
	
	IF (BANCS.STDIN.contextBankId == "54") THEN
	#{
		#-------------------------------------------------------------------------------------------
		#--Start scheme restriction
		#-------------------------------------------------------------------------------------------
		PRINT(CUST.RATE.foracid)
		PRINT(CUST.RATE.schmCode)
		#CUST.RATE.schmcode = "LA215"
		IF (CUST.RATE.schmCode == CUST.RATE.schmcode) THEN
		#{
			IF (CUST.RATE.partTrantype == "D") THEN
			#{
				IF ((CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass3)) AND (CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass4))) THEN
				#{
					sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Insufficent Workclass to Debit this Scheme Contact Branch Credit Admin" + sv_a
					sv_u = urhk_SRV_SetErr("Insufficent Workclass to Debit this Scheme Contact Branch Credit Admin " + " ,for PartTransrlnum " + CUST.RATE.serialnum )	
					GOTO NEXTREC
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#-------------------------------------------------------------------------------------------
		#--End scheme restriction
		#-------------------------------------------------------------------------------------------
	#}
	ENDIF

	IF (BANCS.STDIN.contextBankId == "11") THEN
	#{
		#-------------------------------------------------------------------------------------------Edwin Zico
		#--Start scheme restriction
		#-------------------------------------------------------------------------------------------
		PRINT(CUST.RATE.foracid)
		PRINT(CUST.RATE.schmCode)
		print(BANCS.STDIN.userWorkClass)

		IF ((BANCS.STDIN.userWorkClass != "260") AND (BANCS.STDIN.userWorkClass != "350")) THEN
		#{
			IF ((CUST.RATE.schmCode == "SB120") OR (CUST.RATE.schmCode == "CA220")) THEN
			#{
				IF (CUST.RATE.partTrantype == "C") THEN
				#{
						sv_m = sv_m  + CUST.RATE.serialnum + ","+ "OTC credits not allowed for the SCHM" + sv_a
						sv_u = urhk_SRV_SetErr("OTC credits not allowed for the SCHM" + CUST.RATE.schmCode + " ,in PartTransrlnum " + CUST.RATE.serialnum + "A/C NO:" + CUST.RATE.foracid)	
						GOTO NEXTREC
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF





		#-------------------------------------------------------------------------------------------
		#--End scheme restriction
		#-------------------------------------------------------------------------------------------Edwin Zico
	#}
	ENDIF

	#CUST.RATE.treaRefNum
	IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1) THEN
		IF (BANCS.STDIN.menuId!="CIETXN") THEN
			IF (CUST.RATE.treaRefNum!="") THEN
				BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId +"|" + CUST.RATE.treaRefNum
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_s = "count1|"
				sv_s = sv_s + " select count(1)  from tbaadm.dtd where bank_id =?SVAR "
				sv_s = sv_s + " and TREA_REF_NUM=?SVAR and del_flg!='Y' "
				PRINT(sv_s)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0 ) THEN
					CUST.RATE.count1 = BANCS.OUTPARAM.count1
					PRINT(CUST.RATE.count1)
					IF (cint(CUST.RATE.count1)> 0) THEN
						sv_r=urhk_B2k_PrintRepos("BANCS")
						print(sv_r)
						IF (FIELDEXISTS(BANCS.STDIN.funcName) == 1) THEN
							print(BANCS.STDIN.funcName)
							IF ((BANCS.STDIN.funcName!="SRV_PostTran") AND (BANCS.STDIN.funcName!="INQ_GetTranInqDtls")) THEN
								IF (BANCS.STDIN.menuId=="HCASHDX") THEN
									IF (cint(CUST.RATE.count1)> 2) THEN
										sv_u = urhk_SRV_SetErr("The Deal Reference Number is Used " + " ,for PartTransrlnum " + CUST.RATE.serialnum )
										GOTO NEXTREC
									ENDIF
								ELSE
									sv_u = urhk_SRV_SetErr("The Deal Reference Number is Used " + " ,for PartTransrlnum " + CUST.RATE.serialnum )
									GOTO NEXTREC
								ENDIF
							ENDIF
						ELSE
							IF (BANCS.STDIN.menuId=="HCASHDX") THEN
								IF (cint(CUST.RATE.count1)> 2) THEN
									sv_u = urhk_SRV_SetErr("The Deal Reference Number is Used " + " ,for PartTransrlnum " + CUST.RATE.serialnum )
									GOTO NEXTREC
								ENDIF
							ELSE
								sv_u = urhk_SRV_SetErr("The Deal Reference Number is Used " + " ,for PartTransrlnum " + CUST.RATE.serialnum )
								GOTO NEXTREC
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF

	IF (BANCS.STDIN.contextBankId == "54") THEN
	#{
		#-------------------------------------------------------------------------------------------
		#--Start Term Deposit Restrict
		#-------------------------------------------------------------------------------------------
		PRINT(CUST.RATE.schmType)
		IF ((CUST.RATE.schmType == "TDA")) THEN
		#{
			IF ((CUST.RATE.partTrantype == "D") AND (CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass2))) THEN
			#{
				sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Only worklass 600 allowed" + sv_a
				sv_u = urhk_SRV_SetErr("only worklass 600 allowed " + " ,for PartTransrlnum " + CUST.RATE.serialnum )	
				GOTO NEXTREC
			#}
			ENDIF

			IF (CUST.RATE.partTrantype == "C") THEN
			#{
				print(CUST.RATE.refAmt)
				PRINT(CUST.RATE.foracid)

				sv_s = "amount|"
				sv_s = sv_s + "select DEPOSIT_AMOUNT from tbaadm.tam where acid in (select acid from tbaadm.gam "
				sv_s = sv_s + "where bank_id =?SVAR and foracid =?SVAR) "
				sv_s = sv_s + "and deposit_status !='R' "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.RATE.foracid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN 
					CUST.RATE.amount = BANCS.OUTPARAM.amount	
					print(CUST.RATE.amount)
					IF (CDOUBLE(CUST.RATE.amount)!=CDOUBLE(CUST.RATE.refAmt)) THEN
					#{
						sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Amount entered not equivalent to the Deposit amount" + sv_a
						sv_u = urhk_SRV_SetErr("Amount entered not equivalent to the Deposit amount" + " ,for PartTransrlnum " + CUST.RATE.serialnum )	
						GOTO NEXTREC
					
					#}
					ENDIF

				#}
				ENDIF

			#}
			ENDIF
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		#--End Term Deposit Restrict
		#-------------------------------------------------------------------------------------------
	#}
	ENDIF

	IF (CUST.RATE.tranSubType == "CT") THEN
	#{
		#-------------------------------------------------------------------------------------------Edwin.Z
		#--Start teller GLS Restrict
		#-------------------------------------------------------------------------------------------
		PRINT(CUST.RATE.foracid)
		sv_u = urhk_getAcctDetailsInRepository(CUST.RATE.foracid)
		print(sv_u)
			IF (sv_u == 0) THEN
			#{
				CUST.RATE.acctownership = BANCS.OUTPARAM.acctOwnerShip
				print(CUST.RATE.acctownership)
				CUST.RATE.schmCode = BANCS.OUTPARAM.schmCode
				PRINT(CUST.RATE.schmCode)
				CUST.RATE.bacid = BANCS.OUTPARAM.acctPlaceHolder
				PRINT(CUST.RATE.bacid)
			  #}
			ELSE
			#{
				CUST.RATE.errMsg = "Account number is Invalid"
				sv_e = CUST.RATE.errMsg
				sv_m = "foracid"
				sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF (CUST.RATE.bacid !="") THEN
			#{
				sv_s = "count|"
				sv_s = sv_s + "select count (*) from tbaadm.gam where ACCT_NAME not like'ATM%' and schm_code ='CASH' "
				sv_s = sv_s + "and ACCT_OWNERSHIP ='O' and bank_id =?SVAR and bacid is not null and INTER_SOL_ACCESS_FLG ='N' and foracid =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.RATE.foracid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.RATE.count = BANCS.OUTPARAM.count
					PRINT(CUST.RATE.count)

					IF (CUST.RATE.count =="0") THEN
					#{
						GOTO NEXTREC
					ELSE
						sv_s = "count|"
						sv_s = sv_s + "SELECT count (*)  FROM TBAADM.GAM g,TBAADM.GEC c WHERE g.BANK_ID = ?SVAR AND g.GL_SUB_HEAD_CODE = '10001' "
						sv_s = sv_s + "AND g.BACID  IN (SELECT EMP_CASH_ACCT FROM TBAADM.GEC   WHERE BANK_ID = ?SVAR) AND "
						sv_s = sv_s + "FORACID = ?SVAR and g.sol_id = c.sol_id and "
						sv_s = sv_s + "g.bank_id =c.bank_id and c.EMP_CASH_ACCT=g.bacid "
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.RATE.foracid
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						IF (sv_d == 0) THEN
						#{
							CUST.RATE.count = BANCS.OUTPARAM.count
							PRINT(CUST.RATE.count)
							IF (CUST.RATE.count =="0") THEN			
							#{
								sv_m = sv_m  + CUST.RATE.serialnum + ","+ "GL " + sv_a
								sv_u = urhk_SRV_SetErr("GL " + CUST.RATE.foracid + " ,not assigned to any teller " + " ,for PartTransrlnum " + CUST.RATE.serialnum )	
								GOTO NEXTREC
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#-------------------------------------------------------------------------------------------
		#--End Teller GLS Restrict
		#-------------------------------------------------------------------------------------------Edwin.Z
	#}
	ENDIF

	IF (BANCS.STDIN.contextBankId == "54") THEN
	#{
		#-------------------------------------------------------------------------------------------
		#--START ERP DISBURSEMENT A/CS RESTRICTION
		#-------------------------------------------------------------------------------------------
		PRINT(CUST.RATE.foracid)
		IF ((CUST.RATE.foracid == CUST.RATE.acctNo1) OR (CUST.RATE.foracid == CUST.RATE.acctNo2) OR (CUST.RATE.foracid == CUST.RATE.acctNo3) OR (CUST.RATE.foracid == CUST.RATE.acctNo4) OR (CUST.RATE.foracid == CUST.RATE.acctNo5) OR (CUST.RATE.foracid == CUST.RATE.acctNo6) OR (CUST.RATE.foracid == CUST.RATE.acctNo7) OR	(CUST.RATE.foracid == CUST.RATE.acctNo8) OR (CUST.RATE.foracid == CUST.RATE.acctNo9) OR (CUST.RATE.foracid == CUST.RATE.acctNo10) OR (CUST.RATE.foracid == CUST.RATE.acctNo11) OR (CUST.RATE.foracid == CUST.RATE.acctNo12) OR (CUST.RATE.foracid == CUST.RATE.acctNo13) OR (CUST.RATE.foracid == CUST.RATE.acctNo14) OR (CUST.RATE.foracid == CUST.RATE.acctNo15) OR (CUST.RATE.foracid == CUST.RATE.acctNo23)) THEN
			#{
				IF ( (CUST.RATE.partTrantype == "D") AND (CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass2)) AND (CINT(BANCS.STDIN.userWorkClass) != "084"))THEN
				#{
					IF (BANCS.STDIN.homeSolId!="081") THEN
						sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Posting allowed from erp " + sv_a
						sv_u = urhk_SRV_SetErr("Posting allowed from erp " + " ,for PartTransrlnum " + CUST.RATE.serialnum )
						GOTO NEXTREC
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

		sv_s = "bacid,solid,schmCode,glheadcode,acctowner,acctcrncycode,freetext|"
		sv_s = sv_s + "SELECT bacid,sol_id,schm_Code,gl_sub_head_code,acct_ownership,acct_crncy_code,free_text "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE foracid = ?SVAR "
		sv_s = sv_s + "AND acct_cls_flg != 'Y' "
		sv_s = sv_s + "AND entity_cre_flg = 'Y' "
		sv_s = sv_s + "AND del_flg = 'N' "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.RATE.foracid + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.RATE.glheadcode = BANCS.OUTPARAM.glheadcode
			PRINT(CUST.RATE.glheadcode)

			CUST.RATE.bacid = BANCS.OUTPARAM.bacid
			PRINT(CUST.RATE.bacid)

			CUST.RATE.solid = BANCS.OUTPARAM.solid
			PRINT(CUST.RATE.solid)

			CUST.RATE.acctownership = BANCS.OUTPARAM.acctowner
			PRINT(CUST.RATE.acctownership)

			CUST.RATE.schemeCode = BANCS.OUTPARAM.schmCode
			PRINT(CUST.RATE.schemeCode)

			CUST.RATE.accnt = MID$(CUST.RATE.foracid,3,13)
			PRINT (CUST.RATE.accnt)
			
			CUST.RATE.acctcrncycode = BANCS.OUTPARAM.acctcrncycode
			PRINT(CUST.RATE.acctcrncycode)

			CUST.RATE.freetext = BANCS.OUTPARAM.freetext
			PRINT(CUST.RATE.freetext)

			IF ((BANCS.STDIN.contextBankId !="50") AND (CUST.RATE.schemeCode=="VA300")) THEN
				sv_u = urhk_SRV_SetErr("Transaction not allowed on this Account " + CUST.RATE.foracid + " ,for PartTransrlnum " + CUST.RATE.serialnum )
				GOTO NEXTREC
			ENDIF
			IF ((CUST.RATE.partTrantype == "D") and (CUST.RATE.schemeCode=="SB777") and (BANCS.STDIN.contextBankId=="56"))then
				#sv_u = urhk_SRV_SetErr(" Debit Transactions not allowed on this Scheme " + CUST.RATE.schemeCode + " ,for PartTransrlnum " + CUST.RATE.serialnum )
				CUST.RATE.DailYDebitLimit = "500000"
				sv_z = urhk_B2k_ForacidToAcid(CUST.RATE.foracid)
				if(sv_z == 0)then
					CUST.RATE.AcctAcid = BANCS.OUTPARAM.Acid
				endif

				sv_z ="sum|select sum(tran_amt) from tbaadm.dtd where bank_id ='56' and part_tran_type ='D' and pstd_flg ='Y' and acid =?SVAR"
				sv_z = sv_z + " and tran_date =  (select to_char(db_stat_date ,'DD-MON-RRRR')  from tbaadm.gct where  Bank_id='56' ) "
				print(sv_z)
				BANCS.INPARAM.BINDVARS = CUST.RATE.AcctAcid
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_z)
				print(sv_d)
				if(sv_d == 0)then
					CUST.RATE.DailySum = BANCS.OUTPARAM.sum
					print(CUST.RATE.DailySum)
				else
					CUST.RATE.DailySum = "0"
				endif

				print(CUST.RATE.refAmt)
				CUST.RATE.TotDailyAmt = cdouble(CUST.RATE.DailySum) + cdouble(CUST.RATE.refAmt)
				print(CUST.RATE.TotDailyAmt)
				print(CUST.RATE.DailYDebitLimit)

				if(cdouble(CUST.RATE.TotDailyAmt)> cdouble(CUST.RATE.DailYDebitLimit))then
					sv_u = urhk_SRV_SetErr("Please Update KYC!!! Daily limit exceeded for this Scheme " + CUST.RATE.schemeCode + " ,for PartTransrlnum " + CUST.RATE.serialnum )
					GOTO NEXTREC
				else
					CUST.RATE.MonthlyDebitLimit = "1000000"
					sv_z ="sum|select sum(tran_amt) from tbaadm.htd where bank_id ='56' and part_tran_type ='D' "
					sv_z =sv_z +"and pstd_flg ='Y' and acid =?SVAR and CEIL(sysdate - tran_date) > 30"
					print(sv_z)
					BANCS.INPARAM.BINDVARS = CUST.RATE.AcctAcid
					print(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_z)
					print(sv_d)
					if(sv_d == 0)then
						CUST.RATE.MonthlySum = BANCS.OUTPARAM.sum
						print(CUST.RATE.MonthlySum)
					else
						CUST.RATE.MonthlySum = "0"
					endif
					print(CUST.RATE.TotDailyAmt)
					print(CUST.RATE.MonthlySum)
					CUST.RATE.TotMonthlyAmt = cdouble(CUST.RATE.TotDailyAmt) + cdouble(CUST.RATE.MonthlySum)
					print(CUST.RATE.TotMonthlyAmt)
					if(cdouble(CUST.RATE.TotMonthlyAmt)>cdouble(CUST.RATE.MonthlyDebitLimit))then
						sv_u = urhk_SRV_SetErr("Please Update KYC!!! Monthly limit exceeded for this Scheme " + CUST.RATE.schemeCode + " ,for PartTransrlnum " + CUST.RATE.serialnum )
						GOTO NEXTREC
					endif

				endif
			ENDIF
		#}
		ELSE
		#{
			CUST.RATE.acctowner = ""
			CUST.RATE.acctcrncycode = ""
			CUST.RATE.schmCode = ""
			CUST.RATE.glheadcode    = ""
			CUST.RATE.bacid         = ""
			CUST.RATE.solid         = ""
			CUST.RATE.acctownership = ""
			CUST.RATE.schemeCode    = ""
			CUST.RATE.accnt         = ""
			CUST.RATE.freetext	= ""
		#}
		ENDIF
	
	IF ((BANCS.STDIN.contextBankId == "55") AND (CUST.RATE.acctownership == "O"))  THEN
	#{
		#-------------------------------------------------------------------------------------------
		#--Imprest Accounts Restriction for TZ
		#-------------------------------------------------------------------------------------------
		print(CUST.RATE.imprestAcc)
		CUST.RATE.imprestAcc2 = MID$(CUST.RATE.foracid,4,13)
		print(CUST.RATE.imprestAcc2)
		
		IF ((BANCS.STDIN.homeSolId!="3000") AND (CUST.RATE.imprestAcc == CUST.RATE.imprestAcc2)) THEN
		#{
			sv_m = sv_m  + "Transactions in GL " + " CUST.RATE.foracid " + "Can Only be Intiated from H/O"
			sv_u = urhk_SRV_SetErr("Transactions in GL " +  CUST.RATE.foracid + " Can Only be Intiated from H/O" )	
			GOTO NEXTREC
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		#--End of Imprest Accounts Restriction for TZ
		#-------------------------------------------------------------------------------------------
	#}
	ENDIF


	IF (BANCS.STDIN.contextBankId == "54") THEN
	#{
		IF ((CUST.RATE.acctownership=="O") OR (CUST.RATE.acctownership!="O"))  THEN
		#{
			
			IF (CUST.RATE.partTrantype == "D") THEN
			#{
				############################################
				# Fetching the value from table
				############################################
				CUST.RATE.rate_code="MEAN"
				print(CUST.RATE.rate_code)
				CUST.RATE.from_cncy = TOUPPER(CUST.RATE.acctCrncyCode)
				print(CUST.RATE.from_cncy)

		#-------------------------------------------------------------------------------------------------Edwin.Z
				IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1) THEN
				#{
					print(BANCS.STDIN.menuId)				
					IF ((CUST.RATE.tranSubType == "PI") AND (BANCS.STDIN.menuId != "CIETXN")) THEN
					#{
						CUST.RATE.to_crncy = CUST.RATE.fxblkfxcrncy
						print(CUST.RATE.to_crncy)
					#}
					ELSE
					#{
						CUST.RATE.to_crncy = BANCS.STDIN.homeCrncyCode
						print(CUST.RATE.to_crncy)
					#}
					ENDIF
				#}
				ELSE
				#{
				
					CUST.RATE.to_crncy = BANCS.STDIN.homeCrncyCode
					print(CUST.RATE.to_crncy)
				#}
				ENDIF
		#--------------------------------------------------------------------------------------------------Edwin.Z


				IF (CUST.RATE.acctCrncyCode != BANCS.STDIN.homeCrncyCode) THEN
					
						BANCS.INPARAM.BINDVARS = CUST.RATE.from_cncy + "|" + CUST.RATE.to_crncy
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.RATE.rate_code + "|" + BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
						sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
						sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
						sv_u = sv_u + " AND RATECODE= ?SVAR "
						sv_u = sv_u + " AND BANK_ID = ?SVAR  and rownum<2 "
						print(sv_u)
						sv_y=urhk_dbSelectWithBind(sv_u)
						print(sv_y)
						if (sv_y == "0") then
							sv_p = BANCS.OUTPARAM.Rate
							print(sv_p)
							CUST.RATE.rate = sv_p
							print(CUST.RATE.rate)
							print(CDOUBLE(CUST.RATE.rate))
							print(CDOUBLE(CUST.RATE.refAmt))
							CUST.RATE.refAmthtm =  CDOUBLE(CUST.RATE.refAmt) *  CDOUBLE(CUST.RATE.rate)
							print(CUST.RATE.refAmthtm)
						else
							BANCS.INPARAM.BINDVARS = CUST.RATE.to_crncy + "|" + CUST.RATE.from_cncy 
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.RATE.rate_code + "|" +BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
