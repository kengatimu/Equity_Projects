<--START
CHECKSUM="9c20f7bdadd02b587ea229adabcab9105b65db698f2001b131e60f6d6f3e10f0"
	TRACE ON
	#==========================================================
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CUDDS") == 0) THEN
	#{
		CREATECLASS("CUST", "CUDDS", 5)
	#}
	ENDIF
	
	CUST.CUDDS.Function = BANCS.INPUT.Function
	print(CUST.CUDDS.Function)
	CUST.CUDDS.ChargeCode = BANCS.INPUT.ChargeCode
	print(CUST.CUDDS.ChargeCode)
	CUST.CUDDS.FileName= BANCS.INPUT.FileName
	print(CUST.CUDDS.FileName)
	CUST.CUDDS.Dracno= BANCS.INPUT.Dracno
	print(CUST.CUDDS.Dracno)
	CUST.CUDDS.Originator = BANCS.INPUT.Originator
	print(CUST.CUDDS.Originator)
	CUST.CUDDS.Test = BANCS.INPUT.Test
	print(CUST.CUDDS.Test )
	
	########################################################################################
	# Validation of Function Code
	########################################################################################
	IF (CUST.CUDDS.Function == "") THEN
	#{
		print("HAI")
		sv_e = "Enter the function"
		sv_m = "Function"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF ((CUST.CUDDS.Function != "") AND(CUST.CUDDS.Function != "P") AND (CUST.CUDDS.Function != "U")) THEN
	#{
		sv_e = "Inavlid Function codeValid codes P-Process,U-Upload"
		sv_m = "Function"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	########################################################################################
	# Validation of Originator  Code
	########################################################################################
	IF (CUST.CUDDS.Originator == "") THEN
	#{
		sv_e = "Enter the Originator"
		sv_m = "Originator"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_s = "Count|SELECT count(1) "
		sv_s = sv_s + " FROM TBAADM.EMRM  "
		sv_s = sv_s + " WHERE EMPLOYER_ID = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND del_flg!='Y'"
		BANCS.INPARAM.BINDVARS = CUST.CUDDS.Originator + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		
		sv_q = BANCS.OUTPARAM.Count
		print(sv_q)
		
		IF (sv_q == 0) THEN
		#{
			sv_e = "Invalid orginator code"
			sv_m = "Originator"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	########################################################################################
	# Validation of Filename
	########################################################################################
	IF (CUST.CUDDS.FileName== "") THEN
	#{
		sv_e = "Upload file name should be entered"
		sv_m = "FileName"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#########################################################################
	# Upload file
	###########################################################################
	
	sv_u = urhk_getEnv("CTL_PATH")
	PRINT(sv_u)
	#sv_u = 0
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.envValue)
		CUST.CUDDS.ctlFilePath = BANCS.OUTPARAM.envValue
		PRINT(CUST.CUDDS.ctlFilePath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("DATA_PATH")
	PRINT(sv_u)
	sv_u = 0
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Data file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.envValue)
		CUST.CUDDS.dataPath = BANCS.OUTPARAM.envValue
		CUST.CUDDS.FilePath = CUST.CUDDS.dataPath + CUST.CUDDS.FileName
		PRINT(CUST.CUDDS.dataPath)
		
		#----------TOL - 367144-------------#
		BANCS.INPUT.upldPath = CUST.CUDDS.dataPath
		#---------------------------------------------------------------
		# Calling common script to append userId to upload file path
		#---------------------------------------------------------------
		CALL("appendUserId.scr")
		CUST.CUDDS.dataPath = BANCS.INPUT.upldPath
		PRINT(CUST.CUDDS.dataPath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("FIN_REPORTS_DIR")
	print(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CUDDS.rptPath = BANCS.OUTPARAM.envValue
		print(CUST.CUDDS.rptPath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("USER_PASS")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		print("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^User Id Password is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.CUDDS.userPass = BANCS.OUTPARAM.envValue
		print(CUST.CUDDS.userPass)
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "CUDDS"
	BANCS.INPUT.parameterId = "CRNCYCODE"
	
	CALL ("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CUDDS.crncyCode = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.BILLS.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Cntrol file Path setup not done in CPARAM")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "CUDDS"
	BANCS.INPUT.parameterId = "BACID"
	
	CALL ("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CUDDS.bacid = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.BILLS.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Cntrol file Path setup not done in CPARAM")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "CUDDS"
	BANCS.INPUT.parameterId = "AMOUNT"
	
	CALL ("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CUDDS.amount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.BILLS.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Cntrol file Path setup not done in CPARAM")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------
	# checking if the upload file exists
	#------------------------------------------------------------
	
	sv_a = "test -f " + CUST.CUDDS.FilePath
	print(sv_a)
	sv_r = SYSTEM(sv_a)
	PRINT(sv_r)
	IF (sv_r != 0) THEN
	#{
		sv_e = "Invalid File Name"
		sv_m = "FileName"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	########################################################################################
	#  validating account number
	########################################################################################
	
	IF ((CUST.CUDDS.Function == "U") AND (CUST.CUDDS.Dracno == "")) THEN
	#{
		sv_e = "Enter Account Number"
		sv_m = "Dracno"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF (CUST.CUDDS.Dracno != "" ) THEN
	#{
		sv_s = "count|SELECT count(1) "
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE foracid = ?SVAR"
		sv_s = sv_s + " AND del_flg ='N'"
		sv_s = sv_s + " AND entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND acct_cls_flg ='N'"
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CUDDS.Dracno + "|" + BANCS.STDIN.contextBankId
		sv_r = urhk_dbselectWithBind(sv_s)
		print(BANCS.INPARAM.BINDVARS)
		print (sv_r)
		sv_q = BANCS.OUTPARAM.count
		print(sv_q)
		
		IF (sv_q == 0) THEN
		#{
			sv_e = "Invalid account number"
			sv_m = "Dracno"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#############################################################################################
	# Validation of fiele
	################################################################################################
	IF ((CUST.CUDDS.Function == "U") AND (CUST.CUDDS.Test == "")) THEN
	#{
		sv_e = "Test Mode Flag should be entered"
		sv_m = "Test"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ((CUST.CUDDS.Function == "U") AND (CUST.CUDDS.Test != "Y") AND (CUST.CUDDS.Test != "N")) THEN
	#{
		sv_e = "Inavlid Test Mode flag.'Y' OR 'N'"
		sv_m = "Test"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	###################################################################################
	# Validatio of charge Code
	#################################################################################
	
	IF ((CUST.CUDDS.Function == "U") AND (CUST.CUDDS.ChargeCode == "")) THEN
	#{
		sv_e = "Charge Code should be entered"
		sv_m = "ChargeCode"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF (CUST.CUDDS.Function == "U") THEN
		#{
			BANCS.INPARAM.InputAmount = CUST.CUDDS.amount
			BANCS.INPARAM.CurrencyCode = CUST.CUDDS.crncyCode
			BANCS.INPARAM.AmountTableCode =trim(CUST.CUDDS.ChargeCode)
			PRINT(CUST.CUDDS.ChargeCode)
			
			sv_u = urhk_B2k_GetASTMAmount("")
			print(sv_u)
			sv_u = 0
			
			IF (sv_u == 1) THEN
			#{
				sv_e = "Invalid charge code"
				sv_m = "ChargeCode"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.CUDDS.ChrgAmt = TRIM(BANCS.OUTPARAM.OutputAmount)
				print(CUST.CUDDS.ChrgAmt)
				
				IF (CUST.CUDDS.ChrgAmt  != "0") THEN
				#{
					print(CUST.CUDDS.ChrgAmt)
					CUST.CUDDS.Chrg_flg = "Y"
					CUST.CUDDS.Chrg_upl_flg = "Y"
					#}
				ELSE
					#{
					print(CUST.CUDDS.ChrgAmt)
					CUST.CUDDS.Chrg_flg = "N"
					CUST.CUDDS.Chrg_upl_flg = "N"
				#}
				ENDIF
			#}
			ENDIF
			
			
			#####################################################################################
			#The foll step is to Validate Charge code
			####################################################################################
			sv_s = "Count|SELECT count(1) "
			sv_s = sv_s + " FROM TBAADM.RCT  "
			sv_s = sv_s + " WHERE REF_CODE = ?SVAR "
			sv_s = sv_s + " AND ref_rec_type='34' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND del_flg!='Y'"
			BANCS.INPARAM.BINDVARS = CUST.CUDDS.ChargeCode + "|" + BANCS.STDIN.contextBankId
			print(sv_s)
			
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_s)
			
			sv_q = BANCS.OUTPARAM.Count
			print(sv_q)
			
			IF (sv_q == 0) THEN
			#{
				sv_e = "Invalid Charge code"
				sv_m = "ChargeCode"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.CUDDS.Function == "P") THEN
	#{
		CUST.CUDDS.Chrg_flg = "N"
		CUST.CUDDS.Chrg_upl_flg = "N"
	#}
	ENDIF
	print(CUST.CUDDS.Chrg_flg)
	print(CUST.CUDDS.Chrg_upl_flg)
	
	#-------------------------------------------------------------------
	# Insert the record into the Upload Status table
	#-------------------------------------------------------------------
	
	sv_s = " filSrlNum "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT NVL(MAX(upld_srl_num),0) + 1 "
	sv_s = sv_s + " FROM CUSTOM.C_UPLD_EQT_TBL "
	sv_s = sv_s + " WHERE upld_file_name = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CUDDS.FileName + "|" + BANCS.STDIN.contextBankId
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0 ) THEN
	#{
		CUST.CUDDS.fileSrlNum = BANCS.OUTPARAM.filSrlNum
		print(CUST.CUDDS.fileSrlNum)
		#}
	ELSE
		#{
		CUST.BILLS.fileSrlNum = "1"
		print(CUST.CUDDS.fileSrlNum)
	#}
	ENDIF
	
	sv_s = " INSERT INTO CUSTOM.C_UPLD_EQT_TBL "
	sv_s = sv_s + " ( "
	sv_s = sv_s + " upld_file_name, "
	sv_s = sv_s + " upld_srl_num, "
	sv_s = sv_s + " status, "
	sv_s = sv_s + " status_desc,"
	sv_s = sv_s + " tran_id, "
	sv_s = sv_S + " bank_id, "
	sv_s = sv_s + " rcre_time, "
	sv_s = sv_s + " rcre_user_id, "
	sv_s = sv_s + " del_flg "
	sv_s = sv_s + " ) "
	sv_s = sv_s + " VALUES "
	sv_s = sv_s + " ( "
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "'P',"
	sv_s = sv_s + "'Initial insertionion',"
	sv_s = sv_s + " '', "
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "sysdate,"
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "'N'"
	sv_s = sv_s + " ) "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CUDDS.FileName + "|" + CUST.CUDDS.fileSrlNum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSQLWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		print(sv_d)
	#}
	ENDIF
	
	sv_c = urhk_getFileLocation("COM|uddsdirectdebitdp003.com")
	print(sv_c)
	IF(sv_c == 0) THEN
	#{
		CUST.CUDDS.comFileLocation = BANCS.OUTPARAM.fileLocation
		print(CUST.CUDDS.comFileLocation)
		#}
	ELSE
		#{
		CUST.CUDDS.errMsg = "Technical Error - Com file Not exists"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_a = CUST.CUDDS.comFileLocation + "uddsdirectdebitdp003.com"
	print(sv_a)
	
	sv_d = urex(sv_a,"file.dat",CUST.CUDDS.FilePath+"|"+BANCS.STDIN.contextBankId+"|" + CUST.CUDDS.FileName)
	print(sv_d)
	print(CUST.CUDDS.fileExist)
	
	IF(CUST.CUDDS.fileExist != "Y" ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^File Does not Exists in the Specific path^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#####################################################################
	# delete from C_CDDS
	######################################################################
	IF(CUST.CUDDS.Function == "P") THEN
	#{
		
		#---------------------------------------------------------------------------
		#Changing file name to 'Directdebit.TXT' for process/upload
		#---------------------------------------------------------------------------
		
		CUST.CUDDS.txtfile = "Directdebit.TXT"
		PRINT(CUST.CUDDS.FileName)
		sv_s = "cp " + CUST.CUDDS.FilePath + " " + CUST.CUDDS.txtfile
		print(sv_s)
		sv_r = system(sv_s)
		print(sv_r)
		PRINT(CUST.CUDDS.FileName)
		
		sv_s = "delete from custom.C_DDS "
		sv_s = sv_s + " WHERE bank_id = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		sv_d = urhk_dbSQLwithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			print(sv_d)
		#}
		ENDIF
		
		CUST.CUDDS.ctlFilePath = CUST.CUDDS.ctlFilePath + "Directdebit.ctl"
		print(CUST.CUDDS.FileName)
		
		sv_b = "sqlldr " + CUST.CUDDS.userPass + "  control=" + CUST.CUDDS.ctlFilePath + " data=" + CUST.CUDDS.FileName
		print(sv_b)
		
		sv_a = SYSTEM(sv_b)
		print(sv_a)
		
		IF(sv_a != 0 ) THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Technical Error - Com file for loading a file^upldFileName")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#---------------------------------------------------------------------------
		# Updating the user name and orignator code and divides the amount by 100
		#---------------------------------------------------------------------------
		
		sv_s = "UPDATE  CUSTOM.C_DDS "
		sv_S = sv_s + " SET Originator_code = ?SVAR "
		sv_s = sv_s + ", RCRE_USER_ID = ?SVAR "
		sv_s = sv_s + ", amount=(amount/100) "
		sv_s = sv_s + " WHERE bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.CUDDS.Originator + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		sv_d = urhk_dbSQLWithBind(sv_s)
		IF(sv_d == 0 ) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
		#}
		ENDIF
		
		#####################################################################
		# Calling uddsdirectdebitdp002.scr
		######################################################################
		CALL("uddsdirectdebitdp002.scr")
	#}
	ENDIF
	
	#####################################################################
	# Calling uddsdirectdebitdp002.scr
	######################################################################
	
	
	IF (CUST.CUDDS.Function == "U") THEN
	#{
		CALL("uddsdirectdebitdp001.scr")
	#}
	ENDIF
	
	sv_s = "Count|select count(1) "
	sv_s = sv_s + "from CUSTOM.C_DDS where "
	sv_s = sv_s + "Originator_code = ?SVAR "
	sv_s = sv_s + "AND RCRE_USER_ID = ?SVAR "
	sv_s = sv_s + "AND UPL_STATUS ='P' "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	sv_s = sv_s + "AND DEL_FLG='N' "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CUDDS.Originator + "|" + BANCS.STDIN.userId + "|" +BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	sv_q = BANCS.OUTPARAM.Count
	print(sv_q)
	
	IF (sv_q == "0") THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_u = urhk_SetOrbOut("RESULT_MSG|Upload Completed for the remmiter  " + CUST.CUDDS.Originator)
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_u = urhk_SetOrbOut("RESULT_MSG|" + sv_q + " Records are pending for upload for the Remmiter " + CUST.CUDDS.Originator)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_u = urhk_SetOrbOut("RESULT_MSG|Upload/Process Initiated Successfully  ")
		TRACE OFF
		exitscript
END-->
