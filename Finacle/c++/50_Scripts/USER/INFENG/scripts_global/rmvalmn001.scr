		#}
	ELSE
		#{
		CUST.ORMVAL.errMsg = "ACCTTYPE IS NOT SET"
		GOTO ENDSCRIPT
	#}
	ENDIF
	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50")) THEN
	#{
