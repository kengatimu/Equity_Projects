#-----------------------------------------------------------------------------------------------
<--start
trace on

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
	sv_r = REPEXISTS("CUSTS")
	IF (sv_r == 0) THEN
		CREATEREP("CUSTS")
	ENDIF

	sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
	IF (sv_r == 0) THEN
		 CREATECLASS("CUSTS", "GLBDATA", 5)
	ENDIF


sv_b = BANCS.STDIN.mySolId
print(sv_b)

sv_q="foracid,solid,tosolid|"
sv_q = sv_q + "select foracid,sol_id,CUST_PREF from CUSTOM.INT_CHANGE where bank_id = ?SVAR AND sol_id=?SVAR and ENTITY_CRE_FLG='N'"
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  sv_b
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
    sv_q = urhk_dbCursorFetch(sv_m)
    print(sv_q)

	while(sv_q==0)
		CUSTS.GLBDATA.foracid=BANCS.OUTPARAM.foracid
		print (CUSTS.GLBDATA.foracid)
		CUSTS.GLBDATA.solid=BANCS.OUTPARAM.solid
		print (CUSTS.GLBDATA.solid)
		CUSTS.GLBDATA.tosolid=BANCS.OUTPARAM.tosolid
		print (CUSTS.GLBDATA.tosolid)

		IF(CUSTS.GLBDATA.solid != BANCS.STDIN.mySolId)THEN
		#{
			sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.GLBDATA.solid)
			print(sv_u)
			sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			print(sv_u)
		#}
		ENDIF
	
		
		sv_a=urhk_SetUrhkInp("fromSol.solId|" + BANCS.OUTPARAM.solid)
		print(sv_a)

		sv_a=urhk_SetUrhkInp("toSol.solId|" + CUSTS.GLBDATA.tosolid)
		print(sv_a)

		sv_a=urhk_SetUrhkInp("xferAcct.foracid|" + CUSTS.GLBDATA.foracid)
		print(sv_a)	

		sv_a=urhk_SetUrhkInp("acctStat.code|A")
		print(sv_a)

		sv_a=urhk_SetUrhkInp("xferAcct.crncyCode|UGX")
		print(sv_a)

		sv_a=urhk_SetUrhkInp("schm.schmCode|SB100")
		print(sv_a)

		sv_a=urhk_SetUrhkInp("glSubHead.glSubHeadCode|35001")
		print(sv_a)

		sv_a=urhk_SetUrhkInp("verifyStat|Y")
		print(sv_a)

		sv_u = urhk_ExecSrv("SRV_XferAcctBtwnSolAndVerify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)

	IF(sv_u == 0) THEN
	#{
		#print (BANCS.OUTPARAM.foracid)
		sv_s = "UPDATE CUSTOM.INT_CHANGE "
		sv_s = sv_s + " SET entity_cre_flg = 'P' "
		sv_s = sv_s + " WHERE foracid= ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR"	
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		IF (sv_d == 0) THEN
		#{
			sv_c = urhk_dbSQLWithBind("commit")
			print(sv_c)
		#}
		ENDIF
	#}
	ENDIF
	
		IF (sv_u != 0) THEN
			#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}
				ELSE
				#{
					sv_v = 0
				#}
			ENDIF

					IF (sv_v > 0) THEN
					#{
						sv_u = system("echo 'Error for Acct:"+CUSTS.GLBDATA.foracid+" ' >>transfer.log")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>transfer.log")
							print(sv_u)
						#}
						DO
					#}
					ENDIF
			#}
		ENDIF


	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)

	do
                print("ALL ACCOUNTS ARE TRANSFERED")
		sv_e = urhk_dbCursorClose(sv_q)
		print(sv_e)
ENDIF


trace off
exitscript
end-->
