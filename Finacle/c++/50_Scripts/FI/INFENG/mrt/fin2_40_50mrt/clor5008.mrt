###############################################################################
# File Name : clor5008.mrt
#Description: Template for summary of PWO
#Developed By: PAlit,30-11-95
##############################################################################
RECORDLAYOUT
$$$include clor5007.mri
#
##############################################################################
LOCALVARIABLES
##############################################################################
sum				numberType
count			numberType
sol_sum			numberTYpe
sol_count		numberType
tcount			numberType
tsum			numberType
#
##############################################################################
GROUPANDSORT
##############################################################################
from_sol_id
gl_sub_head_code
part_trn_srl_num
#
##############################################################################
REPOSITORY bankRepos.rip
##############################################################################
bankName		stringType
branchName		stringType
#
##############################################################################
REPOSITORY argv4
##############################################################################
report_to			stringType
clg_zone_date		stringType
pg0_clg_zone_code	stringType
clg_zone_desc		stringType
extn_cntr_code_desc	stringType
page_number			numberType
#
##############################################################################
PAGEFORMAT
##############################################################################
pageheaderlines 12
topMargin 2
bottomMargin 4
linesperpage 64
columnsperline 132
#
##############################################################################
PAGEHEADER
##############################################################################
execute head
separatorline
nextline
print "CONTROL DETAILS FOR MINI WASTE"  size 132 center
nextline
nextline
separatorline
print "GL SUB HEAD CODE "  column 1
print "CODE DESCRIPTION "  column 25
print "SERVICE OUTLET" column 80
print "#CR.PART TRANS" column 95
print "AMOUNT"      column 110
separatorline
#
##############################################################################
ONSTARTOFREPORT
##############################################################################
nextpage
##############################################################################
ONENDOFREPORT
##############################################################################
separatorline
print "TOTAL"   column 30
print tcount   column 95 format "####"
print tsum column 110 autocomma size 15 
separatorline
nextline
nextline
print "MANAGER/ACCOUNTANT" column 100 
#
##############################################################################
IGNORERECORD
##############################################################################
#
AFTERBREAKOF part_trn_srl_num
set count = count + 1 
set sum = sum +  part_tran_crncy_amt 
#
AFTERBREAKOF gl_sub_head_code
print gl_sub_head_code  column 10 
print gl_sub_head_desc	column 25 size 50
print from_sol_id		column 80
print count   column 95 format "####"
print sum column 110 autocomma size 15 
set sol_count = sol_count + count 
set sol_sum = sol_sum + sum  
set count = 0
set sum = 0
#
AFTERBREAKOF from_sol_id
begin
	separatorline
	print "TOTAL FOR SERVICE OUTLET "   column 10
	print from_sol_id column 50
	print sol_count   column 95 format "####"
	print sol_sum column 110 autocomma size 15 
	separatorline
	set tsum = tsum + sol_sum
	set tcount = tcount + sol_count
	set sol_count = 0
	set sol_sum = 0
end
#
ONEVERYRECORD
#
##############################################################################
PROCEDURE head
#########################################################################
begin
	set page_number = page_number+1
	print "EQUITY BANK LIMITED" size 132 center
	print "PAGE NO." column 115
	print page_number column 125 precision 0
	nextline
	print branchName size 132 center
	print today column 115
	print "OUTWARD CLEARING REGISTER"  size 132 center
	nextline
	print "ZONE CODE/DATE : "  column 50
	print pg0_clg_zone_code
	print " "
	print "/"
	print clg_zone_date size 10
	print " "
	nextline
end
###########################################################################

