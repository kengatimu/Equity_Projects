# Template Name :		custid.mrt
# Description	:		unverified customer id
# Author			E.G.KAROBIA,27-05-2006
# 
#########################################################################
RECORDLAYOUT
sol_id		 stringType
foracid		 stringtype
acct_name	 stringtype
AUDIT_BOD_DATE	 stringType
RECORDSTATUS     stringType
LOGINID		 stringType

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 70
columnsperline 70
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId				stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 70 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print sol_id      column 4
	print foracid     column 11
	print acct_name   column 25
	print AUDIT_BOD_DATE column 45
	print RECORDSTATUS column 58
	print LOGINID  column 63

end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL ID"     column  3	
	print "CUSTOMER ID"   column 11
	print "CUSTOMER NAME"   column 25
	print "DATE" column  47
	print "STATUS" column 55
	print "MAKER" column 63
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 70 center 
	nextline
	print branchName  size 70 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 70 center
	nextline
	print " UNVERIFIED CUSTOMER ID REPORT "  size 70 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 120 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 1
	print "|"   column 10
	print "|"   column 23
	print "|"  column 44
	print "|"  column 54
	print "|"  column 61
	print "|"  column 70
	
	
end




