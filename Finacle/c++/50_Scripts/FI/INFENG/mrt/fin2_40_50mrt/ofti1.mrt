######################################################################
#  PROCEDURE BLOCK
######################################################################

PROCEDURE page_hdr
if (pagenumber = 1) 
begin
	if(postEmailInd = "EMAIL")
	begin
    	print "REPORT!MAILID#"
		nextline
	end
end
print bankname size 40 center
nextline
print branchname size 40 center
nextline
IF tranType ="T"																			       	
begin																					       	
 print "FUNDS TRANSFER" size 40 center																	       	
end																					       	
Else																					       
Begin
if tranSubType = "NR"
	print "CASH DEPOSIT" size 40 center
else
	print "CASH WITHDRAWAL" size 40 center
end
nextline
nextline
print "TRANSACTION NO: " column 1
print tran_id
nextline
nextline
print "TRANSACTION DATE: " column 1
print tranDate size 10
nextline
nextline
##############################################################################
PROCEDURE tran_details

set lv_foracid = foracid
set lv_tranid = tran_id
set lv_srlnum = part_tran_srl_num
set lv_userid = posted_user_id
set lv_trandate= tranDate
set lv_parttrantype = partTranType 
set callscript = runscript "getmoreinfo.scr" "lv_foracid|lv_tranid|lv_srlnum|tranAmt|lv_userid|lv_trandate|lv_parttrantype" "lv_bacid|refnum|lv_datetime|lv_username|lv_userlogedon|lv_printid|lv_benename|lv_beneid|lv_benePhone|lv_Billnum|lv_senderName|lv_senderPhone"

set recipttype =  "0"

IF schmcode="CA203" or schmcode="SB106"
begin
  set recipttype = "1"
 end
set lv_bacid = ltrim lv_bacid " "
set lv_bacid = rtrim lv_bacid " "

set sb_bacid = substr lv_bacid 1,5

IF sb_bacid =  "INTER"
begin
 set recipttype = "1"
end

#---For normal receipt
If recipttype = "0"
begin
	print "ACCOUNT NO :" column 1
	print foracid 
	nextline
	nextline
	print "NAME: " column 1
	print acct_name
	nextline
	nextline
	if tranSubType = "NP"
	begin
		print "CHEQUE NO: " column 1
		print " "
		print inst_num
		nextline
		nextline
	end
	print "REMARKS: " column 1 
	print tranparticulars 
	nextline
	nextline
	if tranSubType = "NR"
		begin
			print "Deposited the sum of " column 1
			nextline
			nextline
		end
	else
		begin
			print "Received the sum of " column 1
			nextline
			nextline
		end
end
#---For collection A/c
If recipttype = "1"
Begin
	if partTranType  = "C"
	begin
	print "BEING PAYMENT TO A/C:" column 1 
	print foracid
	nextline
	nextline
	print "NAME:" column 1 
	print acct_name
	nextline
	nextline
	print "FOR ONWARD CREDIT TO A/C:" column 1 
	nextline
	print refnum
	nextline
	nextline
	print "CLIENT NAME:" column 1
	print remarks
	nextline
	nextline
	end

end
print "AMOUNT:" column 1
print tranAmt autocomma size 20 
print " "
print tranCrncyCode
print "AMOUNT:" column 1
print tranAmt autocomma size 20 
print " "
print tranCrncyCode
print "AMOUNT:" column 1
print tranAmt autocomma size 20 
print " "
print tranCrncyCode
nextLine
nextline
set amtInWords = numTOWords tranAmt
set amtlen = strlen amtInWords
set amtStr = splitstring amtInWords 1 55
set amtlen1 = strlen amtStr
execute print_amount_in_words
set amtlen1 = amtlen1 + 1
set amtStr = splitstring amtInWords amtlen1 55
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
	execute print_amount_in_words
end
set amtStr = splitstring amtInWords amtlen1 55
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
	execute print_amount_in_words
end
##############################################################################
PROCEDURE page_footer

if ( endofrecord = 1)
begin
    print "!"
    print email_id
    print "#"
	set endofrecord = 0
end

##############################################################################
#PROCEDURE endofreport
##############################################################################
PROCEDURE endofreport
begin
if partTranType  = "C" 
	begin
	 nextline
	 print "To the credit of my or our account" column 1
	 nextline
	 nextline
	 print "DEPOSITED BY:____________________  " column 1
	 nextline
	 nextline	
	 print "THANK YOU FOR YOUR CONTINUED SUPPORT" column 1
	 nextline
#	 nextline
#	 print "** PAY YOUR ELECTRICITY BILL AT ANY **" column 1
#	 nextline
#	 print "     **  EQUITY BRANCH **  " column 1
#	 nextline
#	 nextline
	end
else
	begin
	 nextline
	 print "To the debit of my or our account"
	 nextline
	 nextline
         print "CUSTOMER SIGNATURE :________________" column 1
	 nextline
	 nextline
	 print "AUTHORISED BY :____________________" column 1
	 nextline
	 nextline
	 print "THANK YOU FOR YOUR CONTINUED SUPPORT" column 1
	 nextline
#	 nextline
#	 print "** PAY YOUR ELECTRICITY BILL AT ANY **" column 1
#	 nextline
#	 print "     **  EQUITY BRANCH **  " column 1
#	 nextline
#	 nextline
#	 print "Sdg 1.5/- Stamp Duty Paid" column 1
#	 nextline
#	 print "for withdrawal above 40/-"
#        nextline
         nextline
        end

	 print "POSTED  BY :" column 1
	 print posted_user_id 
	 print " "
	 print lv_username 
	 nextline
	 print "PRINTED BY :" column 1
	 print lv_printid
	 print " "
	 print lv_userlogedon
	 nextline
	 print "PRINT TIME " column 1
	 print date 
	 nextline
         nextline
         nextline
         nextline
         print "   "
end
##############################################################################
# PROCEDURE print_amount_in_words 
##############################################################################
PROCEDURE print_amount_in_words
begin
	print amtStr column 1
   if (amtlen1 >= amtlen)
	begin
		print "Only."
	end
	nextLine
end
##############################################################################
# PROCEDURE denom_print
##############################################################################
PROCEDURE denom_print
begin
	set callscript = runscript "denomprint.scr" "lv_tranid" "lv_denstatus|lv_var1|lv_var2|lv_var3|lv_var4|lv_var5|lv_var6|lv_var7|lv_var8|lv_var9|lv_var10|lv_var11|lv_var12|lv_var13|lv_var14|lv_var15|PBchk|lv_PBvalue"
	if lv_denstatus = "Y"  
		begin
		print "DENOMINATION CURRENCY:" column 1
		print tranCrncyCode size 3
		nextline
		nextline
		print "DENOM" column 1
		print "NOTE/COIN" column 8 size 10
		print "COUNT" column 19 size 6
		print "TOTAL" column 31 size 6
		nextline
		
		if((lv_var8 != "") AND (lv_var8 != "0"))
		begin
			set var2 = getPos lv_var8 "!"
			set var3 = getPos lv_var8 "-"
			set var4 = getPos lv_var8 "|"
			set var5 = strlen lv_var8
			set var7 = var2-1
			set var6 = substr lv_var8 1  var7
			print var6 column 1
			set var7 = var3-var2-1
			set var8 = var2+1
			set var6 = substr lv_var8 var8 var7
			print var6 column 11 size 10
			set var7 = var4-var3-1
			set var8 = var3+1
			set var6 = substr lv_var8 var8  var7
			print var6  column 19 size 6
			set var7 = var5-var4
			set var8 = var4+1
			set var6 = substr lv_var8 var8  var7 
			print var6 size 15 rightjustify 
			nextline
		end

		if((lv_var9 != "") AND (lv_var9 != "0"))
		begin
			set var2 = getPos lv_var9 "!"
			set var3 = getPos lv_var9 "-"
			set var4 = getPos lv_var9 "|"
