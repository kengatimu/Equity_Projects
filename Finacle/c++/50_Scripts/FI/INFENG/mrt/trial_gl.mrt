#  This is the Mahareport for Detailed Balance Sheet Branchwise 
###############################################################################
RECORDLAYOUT
###############################################################################
foracid					     stringtype
acct_name                                    stringtype
hom_cny                                      numbertype
gl_sub_head_code			     numbertype
gl_code                                      numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript    			               stringType
lv_setid       				       stringType  
lv_setdesc    				       stringType
total_cr   					numbertype
total_dr					numbertype
diff						numbertype
tot_inc						numberType
tot_exp						numberType
tot_ass						numberType
tot_lia						numberType
################################################################################
GROUPANDSORT
###############################################################################
gl_code
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
############################################################################
#IGNORERECORD
###########################################################################
###############################################################################
PAGEFORMAT
##############################################################################
ColumnsPerLine   120
LinesPerPage     55 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "EQUITY BANK LIMITED"  column 1 size 80 center
nextline
print  "Branch: "   column 1 size 80 center
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 1 size 80 center  
nextline
nextline
print   "TRIAL BALANCE"  column 1 size 80 center  
nextline
nextline
print asondate column 1 size 80 center   
nextline
nextline
separatorline 
print "ACCOUNT NUMBER"	column 01
print "ACCOUNT DESCRIPTION"  column 20 
print "CLASS"		column 40
print "Dr BALANCE" column 75
print "Cr BALANCE" column 90
set total_cr  = 0
set total_dr = 0
set diff = 0
set tot_inc = 0                                        
set tot_exp = 0                                        
set tot_ass = 0                                       
set tot_lia = 0                                       
separatorline
end
#############################################################################
ONEVERYRECORD
#############################################################################
begin
execute onEveryRecord
end

###############################################################################
ONENDOFREPORT
###############################################################################
nextline
separatorline
#set total_dr = total_cr
#set total_dr = 0 - total_dr
print "TOTAL Dr. Balance"  column 70
print "TOTAL Cr. Balance" column 90
nextline
print total_dr	column 70 size 20 autocomma precision 2 
print total_cr	column 90 size 20 autocomma precision 2 
separatorline
nextline
print "Difference" column 80
nextline
set diff = total_dr + total_cr
print diff column 80 size 20 autocomma precision 2 
nextline
nextline
separatorline
################################################################################
PROCEDURE onEveryRecord
################################################################################
#begin
#if (hom_cny != 0)
begin
print	foracid column 01
print  acct_name  column 15
if(gl_code < 30)
begin
	print "ASSET" column 60 
	set tot_ass = hom_cny + tot_ass
end
if(gl_code > 29)
begin
	if(gl_code < 60)
	begin
		print "LIABILITIES"  column 60 
		set tot_lia = hom_cny + tot_lia
	end
end

if(gl_code > 59)
begin
	if(gl_code < 80)
	begin
		print "INCOME" column 60
		set tot_inc = hom_cny + tot_inc
	end
end
if(gl_code >79)
begin	
	if(gl_code < 84)
	begin
		print "EXPENSE" column 60
		set tot_exp = hom_cny + tot_exp
	end
end

	
        if (hom_cny < 0)
                begin
                print   hom_cny   column 70  size 20 autocomma precision 2
		set total_dr = total_dr + hom_cny 
                end
        if(hom_cny > 0)
                begin
                print hom_cny   column 90 size 20 autocomma precision 2
		set total_cr = total_cr + hom_cny
                end
end
#end
