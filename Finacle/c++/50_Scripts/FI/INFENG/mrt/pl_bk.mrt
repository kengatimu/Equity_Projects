#  This is the Mahareport for Profit & Loss Consolidated 
###############################################################################
RECORDLAYOUT
###############################################################################
acct_name                                    stringtype
fgn_cny                                      numbertype
hom_cny                                      numbertype
gl_sub_head_code	                     numbertype 
gl_code                                      numbertype
foracid					     numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript    			               stringType
lv_setid   	    			       stringType  
lv_setdesc    				       stringType
total						numbertype
inc_tot						numberType
exp_tot						numberType
netinc						numberType
flag 						numbertype
flag1						numberType
flag2						numberType
flag3						numberType
flag4						numberType
################################################################################
GROUPANDSORT
###############################################################################
gl_code,gl_sub_head_code,foracid
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
############################################################################
#IGNORERECORD
###########################################################################
###############################################################################
PAGEFORMAT
##############################################################################
#ColumnsPerLine   84 
ColumnsPerLine   120 
LinesPerPage     55 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "EQUITY BANK LIMITED"  column 1 size 80 center
nextline
print  "Branch: "   column 1 size 80 center
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 1 size 80 center  
nextline
nextline
print   "Profit & Loss Consolidated"  column 1 size 80 center  
nextline
nextline
print asondate column 1 size 80 center   
nextline
nextline
separatorline 
print "ACCOUNT DESCRIPTION"  column 09
#print "FCY BALANCE" column 57 
print "LCY BALANCE" column 73 
separatorline
set total  = 0      
set flag =  0                       
set flag1 = 0
set flag2 = 0
set flag3 = 0
set flag4 = 0
end
#############################################################################
AFTERBREAKOF foracid
#############################################################################
execute afterBreakof
#############################################################################
ONEVERYRECORD
#############################################################################
if( gl_code) = 1
	begin
        	execute onEveryRecord
	end

if(gl_code = 2)
	begin
          if (flag = 0)
             begin
        	nextline
        	separatorline
        	print "Total Interest Income" column 03
        	print total column 63 size 20 autocomma
		set inc_tot = total
        	set total = 0
        	set flag = 1
		nextline
        	separatorline
	      end
        	execute onEveryRecord
	 end
if((gl_code = 3) or (gl_code = 4))
	begin
           if(flag2 = 0)
              begin
        	nextline
        	separatorline
	        print "Total Interest Expense" column 03
	        print total column 63 size 20 autocomma precision 2
		set exp_tot = total
		set total = 0 
	        set flag2  = 1 
	        nextline
	        separatorline
		nextline
		separatorline
		print "Net Interest income" column 03
		set netinc = inc_tot + exp_tot
		print netinc column 63 size 20 autocomma precision 2	
		separatorline
		nextline
		print "Commission Fees" column 03
             end
        	execute onEveryRecord
        end
if(gl_code = 5)
	begin
           if(flag3 = 0)
              begin
        	nextline
	        separatorline
	        print "Total Commission Fees" column 03
	        print total column 63 size 20 autocomma precision 2
		set netinc = netinc + total
	        set total = 0
	        set flag3 = 1
	        nextline
	        separatorline
		nextline
		print "Other Income" column 03
	     end
        	execute onEveryRecord
	end
if((gl_code = 81) or (gl_code = 82) or (gl_code = 83))
	begin
           if(flag4 = 0)
             begin
        	nextline
	        separatorline
	        print "Total Income" column 03
		set netinc = netinc + total
	        print netinc column 63 size 20 autocomma precision 2
		set total = 0
	        set flag4 = 1
	        nextline
	        separatorline
	     end
        	execute onEveryRecord
	end
###############################################################################
ONENDOFREPORT
###############################################################################
begin
nextline
print "TOTAL EXPENSE" column 03
print total column 63 size 20 autocomma precision 2 
nextline
separatorline
print   "TOTAL PROFIT & LOSS"   column 03
set netinc = netinc + total
print netinc column 63 size 20 autocomma precision 2
separatorline
end
#############################################################################
PROCEDURE afterBreakof
#00##############################################################################
begin
print  acct_name  column 03 
#print groupSum hom_cny column 63 size 20 autocomma precision 2
print groupSum hom_cny column 63 size 20 autocomma
#print gl_code column 85
#print gl_sub_head_code column 90
#print total column 105 size 15 autocomma
nextline
end

#############################################################################
PROCEDURE onEveryRecord
###############################################################################
begin
	set total = total + hom_cny
end
