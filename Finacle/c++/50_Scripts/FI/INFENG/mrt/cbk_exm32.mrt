#********************************************************************************
#    Report Name                        :        cbk_exm32.mrt                  *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    GENERAL REPORT DESCRIPTION                                                 *
#    --------------------------                                                 *
#    SCHEDULE OF 20 LARGEST DEPOSITORS                                          *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    MODIFICATION LOG                                                           *
#    ----------------                                                           *
#                                                                               *
#    Sr.no.  Date           Author                 Description                  *
#    ------  --------       ------------           -----------                  *
#    1.0     10-08-2005     P.Senthil kumar        Original Version             *
#                                                                               *
#################################################################################
#********************************************************************************
RECORDLAYOUT
#********************************************************************************
sol_id          stringType
schm_type       stringType
foracid         numberType
acopdate        stringType
acctname        stringType
amount          numbertype
intrate         numberType
mdate           stringType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
callscript	stringType
lv_setid        stringType
lv_setdesc      stringType
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#*************************************************************************************
alreadySorted
#***************************************************************************************
#*************************************************************************************
IGNORERECORD
#*************************************************************************************
#**************************************************************************************
#REPOSITORY bankRepos.rip
#*************************************************************************************
#bankName        stringType
#branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   55
columnsperline 156
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13
pagefooterlines 4
#---------------------------------------------------------------------------------------
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg
#***************************************************************************************
PAGEHEADER
#***************************************************************************************
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
begin
execute pipe
print  sol_id column 3 size 5
print schm_type column 26 size 5
print foracid column 37 size 16
print acopdate column 55 size 10
print acctname column  66 size 25
print amount column 94 size 20 autocomma  precision 2
print intrate column 118
print mdate column 126 size 10
nextline
end
#**************************************************************************************
#***************************************************************************************

PROCEDURE pipe

begin
        print "|"               column 1
        print "|"               column 24
        print "|"               column 35
        print "|"               column 53
        print "|"               column 65
        print "|"               column 92
        print "|"               column 114
        print "|"               column 124
        print "|"               column 138
        print "|"               column 155
end

#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
print "EXM32" column 125
nextline
print "NAME OF INSTITUTION:  EQUITY BANK LIMITED " column 5
print "DATE:" column 125
print asondate column 131 size 10
nextline
nextline
print "BRANCH:" column 5
print "CONSOLIDATED" column 20
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc size 20
nextline
nextline
print "SCHEDULE OF 20 LARGEST DEPOSITORS AS AT " column 5
print asondate column 48 
nextline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
nextline
nextline
separatorline
print "|" column 1
print "BRANCH" column 3 size 20
print "|" column 24
print "PRODUCT" column 26  center size 8
print "|" column 35
print "ACCOUNT NO" column 36 size 16  center
print "|" column 53
print "DATE OF" column 54  size 10 center
print "|" column 65
print "NAME" column 66 size 25 center
print "|" column 92
print "BALANCE" column 93 size 20 center
print "|" column 114
print "INTEREST" column 115 size 10
print "|" column 124
print "MATURITY DATE" column 125 size 14
print "|" column  138
print "REMARKS" column 141 size 15
print "|" column 155
nextline
print "|" column 1
print "|" column 24
print "|" column 35
print "|" column 53
print "ACCOUNT" column 54 size 10 center
print "|" column 65
print "|" column 92
print "|" column 114
print "RATE" column 115 size 10 center
print "|" column 124
print "|" column 138
print "|" column 155
nextline
separatorline
end
#****************************************************************************************
ONENDOFREPORT
#**************************************************************************************
begin
separatorline
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:_______________________________________" column 20
nextline
end
#**************************************************************************************

