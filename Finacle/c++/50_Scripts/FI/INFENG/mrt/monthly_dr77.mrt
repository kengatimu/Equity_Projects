#*********************************************************************
#       Author          :      Mabel Gichengo
#
#**********************************************************************
#  DESC   :  Listing of MOnthly Credit Report 
######################################################################
RECORDLAYOUT
####################################################################
####################################################################
sol_id		    stringtype
schm_code           stringtype	
emp_name            stringtype 
dis_amt             numbertype 				   	
DIS_SHDL_DATE       stringtype 
num_of_inst         numbertype 
total_paid          numbertype 
total_due           numbertype 
rescheduleAmt       numbertype 
reschd_date         stringtype
comments            stringtype 

LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
grand_total_ag    numbertype
sub_total_ag      numbertype
grand_total_ar    numbertype
sub_total_ar      numbertype
grand_total_ao    numbertype 
sub_total_ao      numbertype
grand_total_ra    numbertype
sub_total_ra      numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType 

GROUPANDSORT
#################################################################### 
emp_name ascending

REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
#branchName      stringtype

REPOSITORY  argv4
#############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperpage        70
pageheaderlines      5 
pagefooterlines      2 
topmargin            1
bottommargin         1
leftmargin           2 
rightmargin          2 
columnsperline     175
#
ONSTARTOFREPORT
####################################################################  
execute brBankHdg 
execute pageHdg

PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg

PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################
NEXTLINE
PRINT emp_name 		   COLUMN 5
PRINT dis_amt              COLUMN 35   format "###,###,###.##" 
PRINT DIS_SHDL_DATE        COLUMN 55   
PRINT num_of_inst          COLUMN 80     
PRINT total_paid           COLUMN 90   format "###,###,###.##"  
PRINT total_due            COLUMN 110  format "###,###,###.##" 
PRINT rescheduleAmt        COLUMN 130  format "###,###,###.##" 
PRINT reschd_date          COLUMN 150    
PRINT comments             COLUMN 167        
#

AFTERBREAKOF emp_name
####################################################################
separatorline
print "SUB TOTAL FOR BRANCH:" column 5 
set sub_total_ag = groupsum dis_amt
print sub_total_ag column 35          format "###,###,###.##"
set sub_total_ar = groupsum total_paid 
print sub_total_ar column 90          format "###,###,###.##"
set sub_total_ao = groupsum total_due 
print sub_total_ao column 110         format "###,###,###.##"
set sub_total_ra = groupsum rescheduleAmt
print sub_total_ra column 130         format "###,###,###.##"
separatorline
####################################################################
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################

begin

    separatorline
    print "TOTAL FOR BRANCH:" column 5         
    set grand_total_ag = totalsum dis_amt
    print grand_total_ag column 35              format "###,###,###.##"
    set grand_total_ar = totalsum total_paid 
    print grand_total_ar column 90              format "###,###,###.##"
    set grand_total_ao = totalsum total_due 
    print grand_total_ao column 110             format "###,###,###.##"
    set grand_total_ra = totalsum rescheduleAmt
    print grand_total_ra column 130             format "###,###,###.##"
    separatorline
    nextline
end

begin
     print "printed by:"  size  50 center
     print  lv_userId
     nextline
     nextline
     nextline
     print "verified by:" size 50 center
     nextline
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 175 center
end
#
#############################################################################
Procedure  pageHdg
#############################################################################

begin
     nextline
     print "RESCHEDULED LOANS LISTINGS  "  size  175 center 
     nextline
     nextline
     print " From  " column 70
     print ipFrmDate  
     print "  &  "
     print ipToDate   
     nextline
     nextline
  end
begin
     separatorline
     PRINT "PORT. OWNR"                         COLUMN 5
     PRINT "AMT GRNTD"                  COLUMN 37
     PRINT "DATE GRNTD"                 COLUMN 55
     PRINT "TERM OF LOAN(MTHS)"         COLUMN 70
     PRINT "AMT REPAID"                 COLUMN 93
     PRINT "OUTST AMT"                  COLUMN 113
     PRINT "AMT RSHDLED"                COLUMN 133
     PRINT "DATE OF RSHDLE"             COLUMN 150
     PRINT "REASON FOR RESCHEDULE"      COLUMN 167
     separatorline
     nextline
end
###############################################################################
PROCEDURE brBankHdg
##############################################################################

begin
     print "Page No. "   column  110
     print page_number precision 0
     nextline
     print today column  110
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size  175 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 175 center 
     end
####################################################################
# End of File
######################################################################
