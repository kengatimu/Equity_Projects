####################################################################
##########################################################
RECORDLAYOUT										     
##########################################################
cash_ind				numberType
cash_acct_num 				stringType
cash_crncy_code				stringType
cash_sol_id				stringType
cash_ptran_type				stringType
tran_id					stringType
tran_date				stringType
cash_ptran_num				stringType	
part_tran_num				stringType	
foracid					stringType
custName				stringType
tran_crncy_code				stringType
ws_sol_id				stringType
ptran_type				stringType
tran_amt				numberType
ref_crncy				stringType
ref_amt					numberType
closing_bal				numberType
rate_code				stringType
rate					numberType
entry_user_id				stringType
pstd_flg				stringType
pstd_user_id				StringType
vfd_user_id				stringType
instrmnt_num				stringType
tran_particulars			stringType
del_flg					stringType
part_tran_type				stringType
gl_date                     stringType
alt1_custName               stringType
##########################################################
LOCALVARIABLES
##########################################################
open_bal					numberType
clos_bal					numberType
srl_num						numberType
num_entry					numberType
num_pstd					numberType
num_verified			        	numberType
num_deleted					numberType
status						stringType
tranidcnt					numberType
tranidcnt2					numberType
total1						numberType
total2						numberType
##########################################################
GROUPANDSORT
##########################################################
cash_acct_num, cash_ptran_type, tran_id, tran_date, cash_ptran_num, cash_ind 
##########################################################
REPOSITORY bankRepos.rip
##########################################################
bankName		stringType
branchName		stringType
##########################################################
##########################################################
REPOSITORY argv4
##########################################################
cash_entry_emp_id				stringType
contra_entry_emp_id				stringType
contra_pstd_emp_id				stringType
sol_id						stringType
crncy_code					stringType
paymnt_recpt_flg				stringType
page_number					numberType
##########################################################
PAGEFORMAT
##########################################################
LinesPerPage     66
LeftMargin        2
rightMargin       2
Topmargin   2 
BottomMargin  2 
columnsPerLine  132
pageHeaderLines  9
pageFooterLines 0  
##########################################################
ONSTARTOFREPORT
##########################################################
#Added for font reduction
print "</pre>"
nextline
print "<br/>"
nextline
print "<pre>"
nextline
print "<font size='1'>"
nextline

execute PrintRptHeader
execute HeaderDetail
set open_bal = 0.0
set srl_num = 1
set num_entry = 0
set num_pstd = 0
set num_verified = 0
set num_deleted = 0
set tranidcnt =0
set total1=0
set total2=0
##########################################################
ONENDOFREPORT 
##########################################################
nextline
nextline
nextline
print "Signature  :"
nextline
nextline
print "***  " column 40
print pageNumber size 3 precision 0
print "  pages printed. End of report *** " 
set PAGE_NUMBER = pageNumber
#Added for font reduction
print "</font>"
##########################################################
PAGEHEADER 
##########################################################
execute PrintRptHeader
execute HeaderDetail
##########################################################
PAGEFOOTER
##########################################################
separatorline
##########################################################
ONEVERYRECORD
##########################################################
set status = ""
execute prntDetails
##########################################################
BEFOREBREAKOF cash_ptran_type
##########################################################
if cash_ptran_type = "D"
begin
set tranidcnt=0
print "CASH Receipt Details" column 3
nextline
nextline
end
if cash_ptran_type = "C"
begin
set tranidcnt=0
print "CASH Payment Details" column 3
nextline
nextline

end
##########################################################
AFTERBREAKOF cash_ptran_type
##########################################################
separatorline
print "Sub Totals" column 3
print  tranidcnt column 30
print total1 autocomma size 21 column 92
separatorLine
set srl_num = 1
set num_entry = 0
set num_pstd  = 0
set num_verified = 0
set num_deleted = 0
#h_acct_num cash_acct_num ########################################################
BEFOREBREAKOF cash_acct_num
##########################################################
set open_bal = closing_bal
set clos_bal = closing_bal
##########################################################
AFTERBREAKOF cash_acct_num
##########################################################
nextline
print "For Cash Account :" column 10
print cash_acct_num
print "/"
print cash_crncy_code
print "/"
print cash_sol_id
nextline
nextline
set open_bal = 0.0
set clos_bal = 0.0
nextline
nextline
##########################################################
PROCEDURE prntDetails
##########################################################
if(cash_ind = 0)
begin
 set srl_num = srl_num + 1
 set num_entry = num_entry + 1
 if pstd_flg = "Y"
 begin
  set num_pstd = num_pstd + 1
  if vfd_user_id != ""
  begin
   set num_verified = num_verified + 1
  end
 end
 if del_flg = "Y"
 begin
  set num_deleted = num_deleted + 1
 end
 if cash_ptran_type = "D"
 begin
  if pstd_flg = "Y"
  begin
   set open_bal = open_bal + tran_amt
  end
 end
 if cash_ptran_type = "C"
 begin
  if pstd_flg = "Y"
  begin
   set open_bal = open_bal - tran_amt
  end
 end
end
if cash_acct_num != foracid
begin
set tran_id = ltrim tran_id " "
print tran_id column 8
set tranidcnt=tranidcnt + 1
set tranidcnt2=tranidcnt2+tranidcnt
print substr tran_date 1 10 column 18
print foracid column 30
print custName column 45 size 40
print tran_crncy_code column 89

print tran_amt autocomma size 21 column 92
set total1= total1+tran_amt
set total2=total2+total1
 set status = "E"
 if pstd_flg = "Y"
 begin
  set status = "P"
  if vfd_user_id != ""
  begin
   set status = "V"
  end
 end
 if del_flg = "Y"
 begin
  set status = "D"
 end
 print status column 117
 print part_tran_type column 125
end
##############################################################
PROCEDURE PrintRptHeader
################################################################
print "Page : " column 80
print pageNumber size 3 precision 0
nextline
print today  column 80
nextline
print "EQUITY BANK LIMITED" size 100 center
nextline
print branchName size 100 center
nextline
print "TELLER TRANSCATION REGISTER "size 100 center
nextline
nextline

##############################################################
PROCEDURE HeaderDetail
################################################################

separatorLine
print "  Tran Id" column 3
print "Tran Date" column 18
print " A/c Num" column 30
print " A/c Name" column 47
print " Crncy   " column 89
print "        Amount" column 99
print "Status" column 115
print "TrnTyp" column 122
separatorLine
