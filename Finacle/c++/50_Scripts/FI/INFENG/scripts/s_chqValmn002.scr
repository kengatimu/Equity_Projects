#--------------------------------------------------------------
# Input from zone header
#--------------------------------------------------------------
sv_u = urhk_SRV_GetVal("zoneHeader.zoneCrncyCode.crncyCode")
CUST.DATA.zoneCcy = BANCS.OUTPARAM.srvValue
print(CUST.DATA.zoneCcy)

sv_u = urhk_SRV_GetVal("zoneHeader.zoneCode")
CUST.DATA.zoneCode = BANCS.OUTPARAM.srvValue
print(CUST.DATA.zoneCode)

#--------------------------------------------------------------
# Input from instrument details
#--------------------------------------------------------------
sv_u = urhk_SRV_NumOfRecs("instrLL")
CUST.DATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
PRINT(CUST.DATA.noOfRecords)

sv_l = 0
WHILE(sv_l < CUST.DATA.noOfRecords)
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"

	sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".instrmntId")
	CUST.DATA.instrNum = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.instrNum)

	sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".bankBranchCode.brCode")
	CUST.DATA.brCode = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.brCode)	
	
	sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".bankBranchCode.bankCode")
	CUST.DATA.bankCode = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.bankCode)

	sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".instrmntDate")
	CUST.DATA.instDate = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.instDate)
	
	IF ((CUST.DATA.bankCode == CUST.DATA.chqValBankCd1) AND (CUST.DATA.instDate == "")) THEN
	#{
		sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntDate|Error:Instrument Date is Mandatory")
		print("Instrument Date is Mandatory") 
		print(sv_u)
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT	
	#}	
	ENDIF

#-----------------------------------------
#Instrument no check
#------------------------------------------
	sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".instrmntId")
	CUST.DATA.instNo = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.instNo)
	
	IF (CUST.DATA.instNo!="") THEN
	#{
		CUST.DATA.instNo=trim(CUST.DATA.instNo)
		sv_a=STRLEN(CUST.DATA.instNo)
		IF (sv_a>8) THEN
		#{
			print("Instrument Number can not be greater than 6 in length")
			sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Instrument Number can not be greater than 6 in length")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

#-----------------------------------------------
#Inst Amt check
#-----------------------------------------------
	sv_u = urhk_SRV_GetVal("instrLL."+sv_r+".instrmntAmt")
	CUST.DATA.instAmt = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.instAmt)
	sv_a=STRLEN(CUST.DATA.instAmt)
	print(sv_a)
	sv_c=4
	sv_b=sv_a-sv_c
	print(sv_b)
	sv_a=LEFT$(CUST.DATA.instAmt,sv_b)
	print(sv_a)
	CUST.DATA.instAmt=sv_a
	sv_s= "amt|SELECT SUBSTR(?SVAR ,1,LENGTH(?SVAR)-1) FROM dual" 
	BANCS.INPARAM.BINDVARS = CUST.DATA.instAmt + "|" + CUST.DATA.instAmt
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		CUST.DATA.amt= BANCS.OUTPARAM.amt
		print(CUST.DATA.amt)
	#}
	ENDIF
		
	sv_g = CUST.DATA.amt
	sv_g = cdouble(sv_g)
	print(sv_g)

	#CUST.DATA.instAmt=sv_g
	sv_s= "oddcent|SELECT SUBSTR( ?SVAR,-1,1) FROM dual"
	BANCS.INPARAM.BINDVARS = CUST.DATA.instAmt
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		CUST.DATA.oddcent= BANCS.OUTPARAM.oddcent
		print(CUST.DATA.oddcent)
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("instrLL."+sv_r+".payingAcctId")
        CUST.DATA.acctNo = BANCS.OUTPARAM.srvValue
        PRINT(CUST.DATA.acctNo)
	
	sv_h = CUST.DATA.oddcent
	print(CUST.DATA.oddcent)

	IF ((sv_h != CINT("0")) AND (sv_h !=CINT("5"))) THEN
	#{
		sv_h=CINT(sv_h)
		IF (sv_h <5) THEN
		#{
			sv_h = 0
		#}
		ELSE
		#{
			sv_h = 5
		#}
		ENDIF
		CUST.DATA.last = sv_h
		sv_h = cdouble(CUST.DATA.last)
		sv_h = (sv_h /100)
		CUST.DATA.last = sv_h
		sv_i = sv_g + sv_h 
		CUST.DATA.amount1 = sv_i 	
		sv_j = STRLEN(CUST.DATA.amount1)
		CUST.DATA.amount1 = MID$(CUST.DATA.amount1,0,(sv_j -4))
		print(CUST.DATA.amount1)
		CUST.DATA.instAmt=CUST.DATA.amount1
		IF((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "56")) THEN
                #{
                                IF(CUST.DATA.zoneCcy == BANCS.STDIN.homeCrncyCode) THEN
                                #{
                                        sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".instrmntAmt|The Instr Amount is incorrect, odd cents")
                                        sv_u = urhk_SRV_SetVal("instrLL."+sv_r+".instrmntAmt|"+CUST.DATA.instAmt)
                                        BANCS.OUTPUT.successOrFailure="F"
                                        GOTO ENDOFSCRIPT
                                #}
                                ENDIF
                #}
                ENDIF
	#}
	ENDIF
#----------------------------------------------
#Payee acct Id check
#-----------------------------------------------
	sv_u = urhk_SRV_GetVal("instrLL."+sv_r+".payingAcctId")
	CUST.DATA.payAcctId = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.payAcctId)

	IF (CUST.DATA.payAcctId == "") THEN
	#{
		print("Enter The Account ID")
                sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Enter Paying A/c ID")
                BANCS.OUTPUT.successOrFailure="F"
                GOTO ENDOFSCRIPT
	#}
	ENDIF	
	IF ((CUST.DATA.payAcctId == CUST.DATA.chqValAcctId) OR (CUST.DATA.payAcctId == "")) THEN
	#{
		print("Invalid Paying A/c ID")
		sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Invalid Paying A/c ID")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT	
	#}
	ENDIF

#----------------------------------------	
#Tran code check
#----------------------------------------
	sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".tranCode.clgTranCode")
	CUST.DATA.tranCode = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.tranCode)
	IF  (CUST.DATA.tranCode == "") THEN
	#{
		print("Tran code is mandatory")
		sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".tranCode.clgTranCode|Tran code is mandatory")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT	
	#}
	ENDIF
#--------------------------------------------
#Value Capping for EQBOWZ upto 1 M 
#--------------------------------------------
#	IF (((CUST.DATA.zoneCode ==CUST.DATA.) OR (CUST.DATA.zoneCode == CUST.DATA.) OR (CUST.DATA.zoneCode == "CTSBOWZ")) AND (CDOUBLE(CUST.DATA.instAmt)>CDOUBLE(999999.95))) THEN
#	#{
#		print("Amount cannot exceed 1m...")
#		sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".instrmntAmt|Amount cannot exceed 1m...")
#		BANCS.OUTPUT.successOrFailure="F"
#		GOTO ENDOFSCRIPT
#	#}
#	ENDIF

#-----------------------------------------
#Stopped check validation modifications
#------------------------------------------
	sv_a=LPAD(CUST.DATA.instNo,8,' ')
	print(sv_a)
	CUST.DATA.instNoP=sv_a
	sv_s = "count|SELECT count(*) FROM TBAADM.SPT "
	sv_s = sv_s + " WHERE acid in "
	sv_s = sv_s + 		" (SELECT acid FROM TBAADM.GAM "
	sv_s = sv_s + 		" WHERE foracid=?SVAR"
	sv_s = sv_s + 		" AND del_flg!='Y' "
	sv_s = sv_s + 		" AND entity_cre_flg='Y' "
	sv_s = sv_s + 		" AND bank_id=?SVAR)" 
	sv_s = sv_s + " AND begin_chq_num=?SVAR "
	sv_s = sv_s + " AND del_flg='N' "
	sv_s = sv_s + " AND rec_type='S'"
	sv_s = sv_s + " AND bank_id=?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.payAcctId +"|"+ BANCS.STDIN.contextBankId + "|" + CUST.DATA.instNoP + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d == 0)THEN
	#{
		CUST.DATA.count = BANCS.OUTPARAM.count
		IF ( CUST.DATA.count!=0 ) THEN
		#{
			print("Cheque Stopped ....cannot proceed")
			sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Cheque Stopped ....cannot proceed")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
		print("A Database error has occured. Please contact your DBA.")
		sv_u = urhk_SRV_SetErr("A Database error has occured. Please contact your DBA.")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	#--------------------------------
	#Blocking capturing of Bankers Cheques in EQBOWZ Zone 4 Outwards
	#--------------------------------
	IF ((CUST.DATA.bankCode == CUST.DATA.chqValBankCd) AND (CUST.DATA.zoneCode ==CUST.DATA.chqValZoneCd1)) THEN
	#{
		print("For Own Chqs, use INHSE Zones")
		sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|For Own Chqs, use INHSE Zones")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF (CUST.DATA.zoneCode==CUST.DATA.chqValZoneCd2) THEN
	#{
		IF ((CUST.DATA.tranCode  != CUST.DATA.chqValTranCd1) AND (CUST.DATA.tranCode != CUST.DATA.chqValTranCd2)) THEN	
		#{
			print("Not a Bankers Cheque...")
			sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Not a Bankers Cheque...")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF	
		#------------------------------------------------------------
		#Ensuring other outward cheques are not lodged in this zone
		#------------------------------------------------------------
		IF ((CUST.DATA.bankCode!= CUST.DATA.chqValBankCd) AND (CUST.DATA.zoneCode ==CUST.DATA.chqValZoneCd2)) THEN
		#{
			print("For Outward Cheques use EQBOWZ...")
			sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|For Outward Cheques use EQBOWZ...")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF		

		IF (((CUST.DATA.zoneCode == CUST.DATA.chqValZoneCd3) OR (CUST.DATA.zoneCode == CUST.DATA.chqValZoneCd4)) AND (CUST.DATA.bankCode != CUST.DATA.chqValBankCd1)) THEN		
		#{
			print("Only Cheques Drawn On Equity and Paid In Equity allowed...")   
			sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Only Cheques Drawn On Equity and Paid In Equity allowed...")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF	
	#-------------------------------------------
	#Validating Currencies AND Respective Zones
	#-------------------------------------------

	IF ((CUST.DATA.zoneCode ==CUST.DATA.chqValZoneCd5) AND (CUST.DATA.tranCode!=CUST.DATA.chqValTranCd3)) THEN
	#{
		print("Not a US DOllar cheque...")
		sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Not a US DOllar cheque...")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF ((CUST.DATA.zoneCode ==CUST.DATA.chqValZoneCd6) AND (CUST.DATA.tranCode!=CUST.DATA.chqValTranCd5)) THEN
	#{
		print("Not a Euro cheque...")
		sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Not a Euro cheque...")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF ((CUST.DATA.zoneCode ==CUST.DATA.chqValZoneCd7) AND (CUST.DATA.tranCode!=CUST.DATA.chqValTranCd4)) THEN
	#{
		print("Not a Sterling Pound cheque...")
		sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Not a Sterling Pound cheque...")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF	

	IF ((CUST.DATA.zoneCode ==CUST.DATA.chqValZoneCd1) AND ((CUST.DATA.tranCode == CUST.DATA.chqValTranCd3) OR (CUST.DATA.tranCode == CUST.DATA.chqValTranCd4) OR (CUST.DATA.tranCode == CUST.DATA.chqValTranCd5))) THEN
	#{
		print("For DFCC Cheques Contact Central Clearing...")
		sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|For DFCC Cheques Contact Central Clearing...")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

#---------------------------------------------
#Br Code Validation
#-------------------------------------------------
	sv_s = "branchexist|SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.BCT "
	sv_s = sv_s + " WHERE TRIM(BANK_CODE)=?SVAR "
	sv_s = sv_s + " AND TRIM(BR_CODE)= ?SVAR  "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.bankCode + "|" + CUST.DATA.brCode +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		CUST.DATA.branchexist= BANCS.OUTPARAM.branchexist	
		print(CUST.DATA.branchexist)
	#}
	ENDIF

	IF (CUST.DATA.branchexist !=1) THEN
	#{
		print("The Bank AND Branch combination does not exist")
		sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".bankBranchCode.bankCode|The Bank AND Branch combination does not exist")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF 

	#-----------------------------------------------
	IF (TRIM(CUST.DATA.bankCode) == CUST.DATA.chqValBankCd1) THEN
	#{
		CUST.DATA.sol = CUST.DATA.brCode 

		sv_s = "Count|SELECT count(*) "
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE foracid =?SVAR"
		sv_s = sv_s + " AND acct_cls_flg != 'Y' "
		sv_s = sv_s + " AND del_flg !='Y' "
		sv_s = sv_s + " AND entity_cre_FLG ='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.payAcctId + "|" +BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d==0) THEN
		#{
			CUST.DATA.countPayId= BANCS.OUTPARAM.Count
			print(CUST.DATA.countPayId)
		#}
		ENDIF

		#-----------------------------------------------
		#----Validating Dormant Accounts for Drawer
		#-----------------------------------------------
		sv_s = "count|SELECT count(*) FROM TBAADM.SMT WHERE acid in "
		sv_s = sv_s + "(SELECT acid FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE foracid=?SVAR "
		sv_s = sv_s + " AND del_flg !='Y' "
		sv_s = sv_s + " AND entity_cre_FLG ='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR )" 
		sv_s = sv_s + " AND  acct_status!='A'"
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.payAcctId +"|"+ BANCS.STDIN.contextBankId +"|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF ( sv_d == 0)THEN
		#{
			CUST.DATA.count = BANCS.OUTPARAM.count
			IF ( CUST.DATA.count!=0 ) THEN
			#{
				print("Drawer A/C Dormant....cannot proceed")
				sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Drawer A/C Dormant....cannot proceed")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
			print("DB ERROR CONTACT FINACLE SUPPORT ")
			sv_u = urhk_SRV_SetErr("Error:DB ERROR CONTACT FINACLE SUPPORT")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	#-----------------------------------------------
	#----Validating Drawers Accounts-Frozen Status
	#-----------------------------------------------	
		sv_s = "count|SELECT count(*) FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE foracid=?SVAR" 
		sv_s = sv_s + " AND del_flg !='Y' "
		sv_s = sv_s + " AND entity_cre_FLG ='Y' "
		sv_s = sv_s + " AND bank_id =?SVAR "
		sv_s = sv_s + " AND frez_code!=' '"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.payAcctId +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_p = urhk_dbSelectWithBind(sv_s)
		print(sv_p)
		
		IF ( sv_p == 0)THEN
		#{
			CUST.DATA.count = BANCS.OUTPARAM.count
			IF ( CUST.DATA.count!=0 ) THEN
			#{
				print("Drawer A/C Frozen....cannot proceed")
				sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Error:Drawer A/C Frozen....cannot proceed")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
			print("DB ERROR CONTACT FINACLE SUPPORT ")
			sv_u = urhk_SRV_SetErr("DB ERROR CONTACT FINACLE SUPPORT")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		IF (CUST.DATA.countPayId == "0") THEN
		#{
			sv_s = "foracid|SELECT foracid FROM CUSTOM.OLD_ACCT_MAP "
			sv_s = sv_s + " WHERE old_num = ?SVAR"
			sv_s = sv_s + " AND sol_id = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.DATA.payAcctId +"|"+CUST.DATA.sol+"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = urhk_dbSelectWithBind(sv_s)
			print(sv_q)

			IF (sv_q == 0) THEN
			#{
				CUST.DATA.foracid= BANCS.OUTPARAM.foracid
				print(CUST.DATA.foracid)
				sv_u = urhk_SRV_SetVal("instrLL."+sv_r+".payingAcctId|Error:"+CUST.DATA.foracid)
				goto Finish
			#}
			ELSE
			#{
				print("Drawer Acc does not exist..Cant proceed")
				sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Error:Drawer Acc does not exist..Cant proceed")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
			sv_u = urhk_SRV_SetVal("instrLL."+sv_r+".payingAcctId|Error:"+ CUST.DATA.payAcctId)
		 	GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_l = sv_l + 1
	PRINT (sv_l)
#}
DO

ENDOFSCRIPT :
EXIT
TRACE OFF
