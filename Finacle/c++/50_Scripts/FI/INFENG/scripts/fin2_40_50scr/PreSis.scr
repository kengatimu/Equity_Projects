<--start
trace on
print(CDCI.Request.command)
print(CDCI.Request.dccId)

sv_l = urhk_SIS_GetAcctDetails("")
#-Addtion for Eazzy 24/7 
IF (CDCI.Request.dccId !="EAZ") THEN 
	IF ((CDCI.Request.crForacid=="0560291999093") OR (CDCI.Request.crForacid == "0550293271157")) then
		CDCI.Request.ModeOfAction = "F"
		CDCI.Request.respCode = "99"
		exitscript
	ENDIF
ENDIF
#-Restriction for M-KESHO 

IF (CDCI.Request.dccId == "SMS") THEN 
	CDCI.Request.ModeOfAction = "F"
	CDCI.Request.respCode = "99"
	exitscript
ENDIF
if (CDCI.Request.usrhkRet == "F") then
#{
	print(CDCI.Request.usrhkErr)
	CDCI.Request.ModeOfAction = "F"
	CDCI.Request.respCode = "99"
	exitscript
#}
endif
if (CDCI.Request.solId != "") then
#{
	print(CDCI.Request.solId)
	print(CDCI.Request.foracid)
	print(CDCI.Request.debitSolId)
	if(CDCI.Request.solId != CDCI.Request.debitSolId) then
	#{
		CDCI.Request.solId = CDCI.Request.debitSolId
	#}
	endif
#}
endif
if (CDCI.Request.crForacid != "") then
#{
	print(CDCI.Request.crForacid)
	print(CDCI.Request.crSolId)
	print(CDCI.Request.creditSolId)
	if(CDCI.Request.crSolId != CDCI.Request.creditSolId) then
	#{
		CDCI.Request.crSolId = CDCI.Request.creditSolId
	#}
	endif
#}
endif
if (CDCI.Request.command=="MSCR") then
    sv_l=urhk_SIS_HandleBwayMiscMesg("")
    if (CDCI.Request.usrhkRet == "F") then
        #print(CDCI.Request.usrhkErr)
        CDCI.Request.ModeOfAction = "F"
        CDCI.Request.respCode = "22"
        exitscript
    endif
endif

## for rejecting AUTODTOD requests from chanells ##
if (mid$(CDCI.Request.reservedField2,0,7) == "AUTOTOD") then
        CDCI.Request.ModeOfAction = "F"
        CDCI.Request.respCode = "99"
        exitscript
endif

trace off
exitscript
end-->
