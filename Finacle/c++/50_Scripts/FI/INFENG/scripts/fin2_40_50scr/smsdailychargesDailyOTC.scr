#----------------------------------------------------------------------------------------------------------
# Filename              :       smsdailychargesOTC  -- Sunday
# Author                :       charles
# Description           :       This script to collection sms charges
# Input                 :       NA
# Output                :       NA
# Called Script         :       NA
# Calling Script        :       NA
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="35ef993767e7445a51387f01ccc5a6c126b96ac4998dc7656b64b651a4790271"
	TRACE ON
	
	#--------------------------------------------------------------------------
	#  Creation of MISS repository and CHRG class
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("BANCS")
	#}
	ENDIF
	
	sv_r = REPEXISTS("MISS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("MISS")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MISS", "CHRG")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MISS", "CHRG", 5)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting total number of accounts which are not charged
	#--------------------------------------------------------------------------
	
	sv_s = "getboddate|select to_char((db_stat_date-1),'DD-MM-YYYY') from tbaadm.gct where bank_id=?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d =="0") THEN
	#{
		MISS.CHRG.getboddate = BANCS.OUTPARAM.getboddate
		PRINT(MISS.CHRG.getboddate)
	#}
	ENDIF
	
	
	PRINT(BANCS.STDIN.mySolId)
	
	sv_s = "dtd_Count|"
	sv_s = sv_s + "select count(1) from CUSTOM.SMS_STAGE_TABLE s ,tbaadm.gam where s.bank_id='50' and STATUS_FLG='Y' and TRAN_DATE=(select to_char(db_stat_date -1,'DD-MON-RRRR') "
	sv_s = sv_s + "  from tbaadm.gct where  DC_alias='50') and s.foracid=gam.foracid and s.bank_id=gam.bank_id and gam.schm_type in ('SBA','CAA') and gam.schm_code not in ('SB135','VA300','SB103','CA202','SB190','SB126') "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	
	sv_q = BANCS.OUTPARAM.dtd_Count
	PRINT(sv_q)
	
	IF (sv_q == "0") THEN
	#{
		GOTO Finish
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting accounts from DTD
	#--------------------------------------------------------------------------
	
	
	sv_s = " solid,foracid, sequenceno,tran_id,tran_date,tran_particular| select gam.sol_id,s.FORACID, SEQUENCENO,TRAN_ID,TO_CHAR(TRAN_DATE, 'DD-Mon-RRRR')  "
	sv_s = sv_s + " TRANDATE,TRAN_PARTICULAR  from CUSTOM.SMS_STAGE_TABLE s ,tbaadm.gam where s.bank_id='50' and STATUS_FLG='Y' and TRAN_DATE=(select to_char(db_stat_date -1,'DD-MON-RRRR') "
	sv_s = sv_s + " from tbaadm.gct where  DC_alias='50')  and s.foracid=gam.foracid and s.bank_id=gam.bank_id and gam.schm_type in ('SBA','CAA') and gam.schm_code not in ('SB135','VA300','SB103','CA202','SB190','SB126') "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_o)
	
	PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	MISS.CHRG.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(MISS.CHRG.MainCursor)
	
	#--------------------------------------------------------------------------
	# Initialise the Local Variables
	#--------------------------------------------------------------------------
	
	#------------------------------------------------------------------
	#  Variable Initialisation for counter. It should be Zero
	#------------------------------------------------------------------
	sv_z = 0
	#------------------------------------------------------------------
	#  Variable Initialisation for credit amount to the bank income
	#  account. It should be Zero.
	#------------------------------------------------------------------
	MISS.CHRG.done = "N"
	
	
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	
	
	sv_u = urhk_MTTS_PopulateInputDetails("")
	PRINT(sv_u)
	
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.Remarks = "SMS charges "
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.PSTUpdateFlg ="N"
	
	sv_v = "bCashWithCrg"
	PRINT(sv_v)
	
	sv_u = urhk_MTTS_DefineTransaction("bCashWithCrg")
	
	#--------------------------------------------------------------------------
	# MTT code for creating tranxs like individual debit from customer and
	# consolidated credit to the income Account.
	#--------------------------------------------------------------------------
	
	WHILE (sv_o == 0)
	#{
		sv_c = urhk_dbCursorFetch(MISS.CHRG.MainCursor)
		PRINT(sv_c)
		IF (sv_c != 0) THEN
		#{
			sv_r = urhk_MTTS_EndDefinition("")
			PRINT(sv_r)
			
			
			PRINT(sv_c)
			sv_o = 1
			
			#}
		ELSE
			#{
			#solid,foracid, sequenceno,tran_id,tran_date,tran_particular
			MISS.CHRG.solid = BANCS.OUTPARAM.solid
			PRINT(MISS.CHRG.solid)
			MISS.CHRG.foracid = BANCS.OUTPARAM.foracid
			PRINT(MISS.CHRG.foracid)
			MISS.CHRG.sequenceno = BANCS.OUTPARAM.sequenceno
			PRINT(MISS.CHRG.sequenceno)
			MISS.CHRG.tran_id = BANCS.OUTPARAM.tran_id
			PRINT(MISS.CHRG.tran_id)
			MISS.CHRG.tran_date = BANCS.OUTPARAM.tran_date
			PRINT(MISS.CHRG.tran_date)
			MISS.CHRG.tran_particular = BANCS.OUTPARAM.tran_particular
			PRINT(MISS.CHRG.tran_particular)

			MISS.CHRG.percntamount="30"
			print(MISS.CHRG.percntamount)

			MISS.CHRG.smsincomegl="650012925"
			MISS.CHRG.excisedutyacc = MISS.CHRG.solid + MISS.CHRG.smsincomegl
			print(MISS.CHRG.excisedutyacc)

			PRINT(MISS.CHRG.foracid)

			sv_h = urhk_getAcctDetailsInRepository(MISS.CHRG.foracid)
			print(sv_h)
			IF (sv_h==0) THEN
				MISS.CHRG.EffAvailableAmttr  = BANCS.OUTPARAM.EffAvailableAmt
				print(MISS.CHRG.EffAvailableAmttr)
				IF (CINT(MISS.CHRG.EffAvailableAmttr) < CINT(MISS.CHRG.percntamount)) THEN
					GOTO Finish
				ENDIF
			ENDIF
			MISS.CHRG.stamp = "Y"
			
			
			
			#------------------------------------------
			# counter setting for defining different PartTran
			#------------------------------------------
			sv_z = sv_z + 1
			MISS.CHRG.Counter = sv_z
			
			#--------------------------------------------------------------------------
			# Create the narration
			#--------------------------------------------------------------------------
			
			
			sv_m = "SMS Charge-"
			PRINT(sv_m)
			sv_y = MISS.CHRG.tran_id
			sv_x = " "
			sv_k = MISS.CHRG.tran_date
			PRINT(sv_k)
			
			sv_w = sv_m + sv_y + sv_x + sv_k
			PRINT(sv_w)
			
			MISS.CHRG.narr1 = sv_w
			PRINT(MISS.CHRG.narr1)
			
			MISS.CHRG.narrexc = "SMS Charge"
			PRINT(MISS.CHRG.narrexc)
			MISS.CHRG.excisedutyaccnar = MISS.CHRG.excisedutyacc
			PRINT(MISS.CHRG.excisedutyaccnar)
			MISS.CHRG.excdutynma = "SMS Charge"
			PRINT(MISS.CHRG.excdutynma)
			
			MISS.CHRG.narr2 = MISS.CHRG.narrexc + " " +MISS.CHRG.foracid+" "+ MISS.CHRG.tran_id +" "+ MISS.CHRG.tran_date
			PRINT(MISS.CHRG.narr2)
			
			MISS.CHRG.startdatennarr = MISS.CHRG.tran_id
			PRINT(MISS.CHRG.startdatennarr)
			MISS.CHRG.startdatennarre = MISS.CHRG.tran_date
			PRINT(MISS.CHRG.startdatennarre)
			
			MISS.CHRG.narr3 = MISS.CHRG.startdatennarr +" "+ MISS.CHRG.startdatennarre +" "+ MISS.CHRG.sequenceno
			PRINT(MISS.CHRG.narr3)
			
			
			MISS.CHRG.wtax_amt = ""
			PRINT(MISS.CHRG.wtax_amt)
			
			
			#--------------------------------------------------
			# Withholding Tax Account
			#--------------------------------------------------
			
			IF (MISS.CHRG.stamp == "Y") THEN
			#{	
				
				MTT.PartTranDetails.Account = MISS.CHRG.excisedutyacc
				PRINT(MTT.PartTranDetails.Account)
				MTT.PartTranDetails.RefCurrency = "RWF"
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = MISS.CHRG.narr2
				MTT.PartTranDetails.Particulars2 = MISS.CHRG.tran_particular
				MTT.PartTranDetails.RefAmount = CDOUBLE(MISS.CHRG.percntamount)
				PRINT(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = MISS.CHRG.narr3 
				MTT.PartTranDetails.RefNum = MISS.CHRG.foracid +" " +MISS.CHRG.sequenceno 
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				PRINT(MISS.CHRG.Counter)
				sv_e = "Credt" + MISS.CHRG.Counter
				PRINT(sv_e)
				sv_r = urhk_MTTS_definePartTran(sv_e)
				PRINT(sv_r)
				
			#}
			ENDIF
			
			
			#------------------------------------------------------------------
			# Customer Debit Partran
			#------------------------------------------------------------------
			

			MTT.PartTranDetails.Account = MISS.CHRG.foracid
			MTT.PartTranDetails.RefCurrency = "RWF"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = MISS.CHRG.narr1
			MTT.PartTranDetails.Particulars2 = MISS.CHRG.tran_particular
			######
			
			sv_h = urhk_getAcctDetailsInRepository(MISS.CHRG.foracid)
			print(sv_h)
			IF (sv_h==0) THEN
				MISS.CHRG.solidsh = BANCS.OUTPARAM.acctSolId
				print(MISS.CHRG.solidsh)
				MISS.CHRG.schmcodesh = BANCS.OUTPARAM.schmCode
				print(MISS.CHRG.schmcodesh)
				MISS.CHRG.schmType = BANCS.OUTPARAM.schmType
				print(MISS.CHRG.schmType)
				MISS.CHRG.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
				print(MISS.CHRG.EffAvailableAmttr)
				IF (CINT(MISS.CHRG.EffAvailableAmttr) < CINT(MISS.CHRG.percntamount)) THEN 
					MTT.PartTranDetails.TODRefType      = "IN"
					MTT.PartTranDetails.TodEntityType   = "TODIN"
					MTT.PartTranDetails.TodEntityId     = MISS.CHRG.foracid
					MTT.PartTranDetails.TodLevIntFlg    = "N"
					MTT.PartTranDetails.TodExpiryDate   = BANCS.STDIN.BODDate
					MTT.PartTranDetails.TodPenalDate    = BANCS.STDIN.BODDate
					MTT.PartTranDetails.TodPermittedBy  = "SYSTEM"
					MTT.PartTranDetails.TodRemarks      = "Charges TOD"
				ENDIF
			ENDIF
			######
			sv_a = CDOUBLE(MISS.CHRG.percntamount)
			PRINT(sv_a)
			sv_a = -(sv_a)
			PRINT(sv_a)
			MTT.PartTranDetails.RefAmount = sv_a
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = MISS.CHRG.narr3
			MTT.PartTranDetails.RefNum = MISS.CHRG.foracid +" " +MISS.CHRG.sequenceno
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			PRINT(MISS.CHRG.Counter)
			sv_h = "Debit" + MISS.CHRG.Counter
			PRINT(sv_h)
			sv_u = urhk_MTTS_definePartTran(sv_h)
			PRINT(sv_u)
			
			#}
			#######
			
			sv_r = urhk_MTTS_EndDefinition("")
			PRINT(sv_r)
			
	
			sv_s = "update CUSTOM.SMS_STAGE_TABLE set STATUS_FLG ='P' where SEQUENCENO=?SVAR AND bank_id=?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = MISS.CHRG.sequenceno + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			########
		#}
		ENDIF
	#}
	DO
	
	sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor)
	
	Finish:
		
		EXITSCRIPT
END-->
