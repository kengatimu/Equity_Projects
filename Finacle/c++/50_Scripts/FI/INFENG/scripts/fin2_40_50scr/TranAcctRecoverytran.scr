	MTT.PartTranDetails.Refnum = MTT.InputDetails.oapRefNum
	MTT.OAPAddnlDetails.OffsetAmount = sv_n
	MTT.OAPAddnlDetails.OrgTranID = MTT.InputDetails.oapRefTranId
	MTT.OAPAddnlDetails.OrgTranDate = MTT.InputDetails.oapRefTranDate
	MTT.OAPAddnlDetails.OrgPartTran = MTT.InputDetails.oapRefPartTranSrlNum
endif
MTT.PartTranDetails.sysPartTranCode = "PTRN00581"

sv_z = urhk_MTTS_DefinePartTran("DR")
#if(MTT.InputDetails.transferAcctCrncy == MTT.InputDetails.tranCrncy) then
#{
		sv_p = sv_s + sv_a + sv_c + sv_d + sv_h + sv_q
