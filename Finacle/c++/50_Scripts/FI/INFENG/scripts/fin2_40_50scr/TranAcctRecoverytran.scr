				MTT.PartTranDetails.sysPartTranCode = "PTRN00582"

				sv_z = urhk_MTTS_DefinePartTran("CR")
		endif
		sv_l = sv_d + sv_i + sv_o + sv_b
		if(sv_l!=0) then 
		
	 

		#---------------------------------------------------------------------------- 
		# Interest recover on account
		#---------------------------------------------------------------------------- 
				MTT.PartTranDetails.Account=MTT.InputDetails.tranAcct
				MTT.PartTranDetails.RefAmount=-sv_L
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
				MTT.PartTranDetails.Particulars="Dr Recovery of Interest"
