			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			MTT.PartTranDetails.TranIdentifier="TranAcctRecovery"
			MTT.PartTranDetails.PTranBusinessType="TranS"
			MTT.PartTranDetails.sysPartTranCode = "PTRN00590"

		sv_z = urhk_MTTS_DefinePartTran("PARKDR")
	endif
#}
#----------------------------------------------------------------------------  
# Credit Recovery Line A/c 
#----------------------------------------------------------------------------  
sv_p = sv_a + sv_c
if(sv_p!=0) then 	
		MTT.PartTranDetails.Account=MTT.InputDetails.RecoveryLine
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.RefAmount=sv_p
		MTT.PartTranDetails.Particulars="Cr Recovery A/c" 

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "TAREC"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="TranAcctRecovery"
		MTT.PartTranDetails.PTranBusinessType="TranS"
		MTT.PartTranDetails.sysPartTranCode = "PTRN00591"
	sv_z = urhk_MTTS_DefinePartTran("RECCR")
endif
#----------------------------------------------------------------------------  
# Debit Charge Off A/c 
#----------------------------------------------------------------------------  
if(sv_p!=0) then 	
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeOffLine
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		# Ref Currencty will be the Tran A/c Currency
		MTT.PartTranDetails.RefAmount=-sv_p
		MTT.PartTranDetails.Particulars="Dr ChargeOff A/c"

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAREC"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="TranAcctRecovery"
		MTT.PartTranDetails.PTranBusinessType="TranS"
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.sysPartTranCode = "PTRN00592"	
	sv_z = urhk_MTTS_DefinePartTran("RECDR")
endif
#----------------------------------------------------------------------------
# Creating Accrued Interest Amount Part Tran..
#----------------------------------------------------------------------------
if (sv_e != 0) then
	
	if(sv_t == "Y")then 
		MTT.PartTranDetails.Account=MTT.InputDetails.RecoveryLine
        #MSG0309872="Cr Recovery for Interest A/c"
        sv_u = urhk_getMSGCodeErrDesc("MSG0309872")
        if(sv_u == 0) then
        	MTT.PartTranDetails.Particulars = BANCS.OUTPARAM.errDesc
        endif
    else
        MTT.PartTranDetails.Account=MTT.InputDetails.chargeOffLine
        #MSG0319697 ="Cr Recovery for Interest Suspense A/c"
        sv_u = urhk_getMSGCodeErrDesc("MSG0319697")
        if(sv_u == 0) then
        	MTT.PartTranDetails.Particulars = BANCS.OUTPARAM.errDesc
        endif	
    endif  
	
    MTT.PartTranDetails.RefAmount=sv_e
    MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
	MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode

	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LAREC"
	sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	if (sv_m == 0) then
		call("getMTTTranPart.scr")
	endif

    MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
    MTT.PartTranDetails.TranIdentifier="TranAcctRecovery"
    MTT.PartTranDetails.PTranBusinessType="TranS"
    MTT.ChargeDetails.EventType = "ACCR"
    MTT.ChargeDetails.EventId = MTT.InputDetails.accrEventId
    MTT.ChargeDetails.CalculatedAmount = sv_f
    MTT.ChargeDetails.ActualAmount = sv_e
    MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.tranCrncy
    MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
    MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.tranAcct
    MTT.ChargeDetails.ServiceSolId  = BANCS.STDIN.mySolId
	MTT.PartTranDetails.sysPartTranCode = "PTRN00593"
    sv_z = urhk_MTTS_DefineChargePartTran("ACCR")
endif

#----------------------------------------------------------------------------
# Creating Accrued Penal Interest Amount Part Tran..
#----------------------------------------------------------------------------
if (sv_k != 0) then
    
	if (sv_t == "Y") then 
		MTT.PartTranDetails.Account=MTT.InputDetails.RecoveryLine
        #MSG0318889 ="Cr Recovery for Penal Interest A/c"
        sv_u = urhk_getMSGCodeErrDesc("MSG0318889")
        if(sv_u == 0) then
        	MTT.PartTranDetails.Particulars = BANCS.OUTPARAM.errDesc
        endif
    else
        MTT.PartTranDetails.Account=MTT.InputDetails.chargeOffLine
        #MSG0319698="Cr Recovery for Penal Interest Suspense A/c"
        sv_u = urhk_getMSGCodeErrDesc("MSG0319698")
        if(sv_u == 0) then
        	MTT.PartTranDetails.Particulars = BANCS.OUTPARAM.errDesc
        endif	
    endif

    MTT.PartTranDetails.RefAmount=sv_k
    MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
	MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LAREC"
	sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	if (sv_m == 0) then
		call("getMTTTranPart.scr")
	endif

    MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
    MTT.PartTranDetails.TranIdentifier="TranAcctRecovery"
    MTT.PartTranDetails.PTranBusinessType="TranS"
    MTT.ChargeDetails.EventType = "ACCR"
    MTT.ChargeDetails.EventId = MTT.InputDetails.accrEventId
    #MTT.ChargeDetails.CalculatedAmount = sv_f
    MTT.ChargeDetails.ActualAmount = sv_k
    MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.tranCrncy
    MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
    MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.tranAcct
    MTT.ChargeDetails.ServiceSolId  = BANCS.STDIN.mySolId
	MTT.PartTranDetails.sysPartTranCode = "PTRN00594"
    sv_z = urhk_MTTS_DefineChargePartTran("ACCR")
endif

sv_z = urhk_MTTS_EndDefinition("")
trace off
end-->

