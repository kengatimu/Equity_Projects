					MTT.PartTranDetails.PTranBusinessType="TranS"
					MTT.PartTranDetails.sysPartTranCode = "PTRN00583"	
					sv_z = urhk_MTTS_DefinePartTran("TACR")
		endif

	#{
		sv_l = sv_h + sv_j + sv_r
