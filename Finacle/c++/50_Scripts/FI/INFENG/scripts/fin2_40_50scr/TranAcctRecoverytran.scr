sv_k = CDOUBLE(MTT.InputDetails.AccrPIntToBeMoved)
sv_q = CDOUBLE(MTT.InputDetails.ExcessCr)
sv_f = CDOUBLE(MTT.InputDetails.SysCalAccrInt)
sv_g = MTT.InputDetails.colFromCollateral
sv_t = MTT.InputDetails.RecogIntSuspFlg

#----------------------------------------------------------------------------  
#	Transaction defination starts here...
#----------------------------------------------------------------------------  
#---------------------------------------------------------------------------- 
# Debit Source of fund account
#---------------------------------------------------------------------------- 
MTT.PartTranDetails.Account=MTT.InputDetails.sourceFundAcct
MTT.PartTranDetails.RefCurrency=MTT.InputDetails.transferAcctCrncy 
MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
MTT.PartTranDetails.ReportCode="6400"
MTT.PartTranDetails.Particulars="Dr SourceFund A/c"

# Call to common script to modify tran particulars if script is present
MTT.PartTranDetails.ScriptEventType = "TAREC"
sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
if (sv_m == 0) then
	call("getMTTTranPart.scr")
endif

MTT.PartTranDetails.RefAmount=-sv_n
MTT.PartTranDetails.Consolidate="N"
MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
MTT.PartTranDetails.TranIdentifier="TranAcctRecovery"
