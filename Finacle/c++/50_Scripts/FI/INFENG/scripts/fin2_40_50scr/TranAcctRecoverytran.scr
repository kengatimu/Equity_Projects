<--start
trace on
BANCS.OUTPUT.scriptError = ""
sv_a = urhk_MTTS_PopulateInputDetails("")

sv_z = "" 
sv_z = MTT.InputDetails.errorMsg 
if(sv_z != "") then 
MTT.Error.Description= "" +sv_z 
sv_z = urhk_MTTS_ReportErrorCondition("") 
exitscript 
endif 

MTT.TranDetails.TranDate="0"
MTT.TranDetails.TranType=MTT.InputDetails.TranType
MTT.TranDetails.TranSubType=MTT.InputDetails.tranSubType
MTT.TranDetails.Remarks="Recovery After Charge Off transaction"
MTT.TranDetails.IgnoreExcp="N"
MTT.TranDetails.Consolidate="Y"
MTT.TranDetails.PrintAdviceInd="B"
MTT.TranDetails.EntryUserId=MTT.InputDetails.EntryUserId
MTT.TranDetails.EntryTime=MTT.InputDetails.EntryTime
MTT.TranDetails.sysTranCode = "LOANAA009"
	
sv_z = urhk_MTTS_DefineTransaction("TranAcctRecovery")
if(sv_z != 0) then
    MTT.Error.Description="Transaction definition could not be created"
    sv_z = urhk_MTTS_ReportErrorCondition("")
    exitscript
endif

sv_n = CDOUBLE(MTT.InputDetails.netAmtEntered)
sv_s = CDOUBLE(MTT.InputDetails.NonChrgOffPrincipal)
sv_a = CDOUBLE(MTT.InputDetails.ChrgOffPrincipal)
sv_b = CDOUBLE(MTT.InputDetails.ChrgOffAppliedInt)
