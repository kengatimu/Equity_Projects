sv_j = CDOUBLE(MTT.InputDetails.ChrgOffBookedPenalInt)
sv_o = CDOUBLE(MTT.InputDetails.BookedIntInSuspense)
sv_r = CDOUBLE(MTT.InputDetails.BookedPenalIntInSuspense)
