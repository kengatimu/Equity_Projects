#
<--START
TRACE ON
        #--------------------------------------------------------
        #create repository
        #--------------------------------------------------------

        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF
        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

	sv_s = urhk_B2k_PrintRepos("BANCS")
	print(sv_s)

        #----------------------------------------------------------------------
        # Printing Bancs Repository
        #----------------------------------------------------------------------
	CUST.DATA.error = ""
	CUST.DATA.intrestRate = "0.1"
	CUST.DATA.period = ""
	CUST.DATA.acctNum = ""
	CUST.DATA.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
	
	CUST.DATA.tranDate = BANCS.STDIN.BODDate
	CUST.DATA.tranType = "T"
	CUST.DATA.tranSubType ="BI"

	CUST.DATA.partTranDetail_LowLimit="1"

	CUST.DATA.glDate = BANCS.STDIN.BODDate
	CUST.DATA.valueDate = BANCS.STDIN.BODDate

	CUST.DATA.dbSerial_num ="1"						
	CUST.DATA.debitPartTranType="D"
	CUST.DATA.drAcct = BANCS.INPUT.foracid 
	CUST.DATA.drTran = "Transfer/"+BANCS.INPUT.destCustName
	CUST.DATA.drChgTran = CUST.DATA.drTran +"/Charges"
	CUST.DATA.drCrncy= BANCS.INPUT.remitCrncy 

	CUST.DATA.crSerial_num ="2"
	CUST.DATA.creditPartTranType ="C" 
	CUST.DATA.crAcct = BANCS.INPUT.destAcct
	CUST.DATA.crCrncy = BANCS.INPUT.remitCrncy 
	CUST.DATA.tranAmt = BANCS.INPUT.amount 
	CUST.DATA.chrgAmt = "200"
	CUST.DATA.refNum = BANCS.INPUT.cRefNum
	CUST.DATA.chrgFlg = BANCS.INPUT.waiveflg
	PRINT(CUST.DATA.refNum)

	CUST.DATA.tranId=""

	sv_s = "spire_acct | select spire_acct from custom.coge_acct_map where substr(spire_acct,0,16)=?SVAR"
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.DATA.crAcct 

	sv_u = urhk_dbSelectWithBind(sv_s)
	print(sv_u)

	if(sv_u ==0) then
	#{
		CUST.DATA.crAcct= BANCS.OUTPARAM.spire_acct
		print(CUST.DATA.crAcct)
	#}
	endif	

	IF  ( STRLEN(CUST.DATA.crAcct) > 16 ) THEN
	#{
		BANCS.INPARAM.iban_number =CUST.DATA.crAcct
		sv_u = urhk_getForacidFromIBANnumber("")
		PRINT(sv_u)
		IF(sv_u!=0) THEN
		#{
			lv_q = "acctNum | SELECT FORACID FROM TBAADM.GAM WHERE FORACID = "
			lv_q = lv_q + "(SELECT FORACID FROM custom.coge_acct_map where SPIRE_ACCT = ?SVAR) "
			PRINT(lv_q)

			BANCS.INPARAM.BINDVARS = CUST.DATA.crAcct
			print(BANCS.INPARAM.BINDVARS)

			lv_u = urhk_dbSelectWithBind(lv_q)
			PRINT(lv_u)

			IF(lv_u ==0 )THEN
			#{
				CUST.DATA.crAcct = BANCS.OUTPARAM.acctNum
			#}
			ELSE
			#{
				lv_e = urhk_SRV_SetErr("Coge Accts invalid")
				exitscript
			#}
			ENDIF
		ELSE
			PRINT(BANCS.OUTPARAM.foracid)

			CUST.DATA.crAcct = BANCS.OUTPARAM.foracid
			BANCS.INPUT.uAccount = BANCS.OUTPARAM.foracid

			IF (BANCS.INPUT.uAccount=="")THEN
			#{
				lv_q = "acctNum | SELECT FORACID FROM TBAADM.GAM WHERE FORACID = "
				lv_q = lv_q + "(SELECT FORACID FROM custom.coge_acct_map where SPIRE_ACCT = ?SVAR) "
				PRINT(lv_q)

				BANCS.INPARAM.BINDVARS = CUST.DATA.acctNum
				print(BANCS.INPARAM.BINDVARS)

				lv_u = urhk_dbSelectWithBind(lv_q)
				PRINT(lv_u)

				IF(lv_u ==0 )THEN
				#{
					CUST.DATA.crAcct = BANCS.OUTPARAM.acctNum
				#}
				ELSE
				#{
					lv_e = urhk_SRV_SetErr("Coge Accts invalid")
					exitscript
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF

	sv_h = urhk_getAcctDetailsInRepository(CUST.DATA.drAcct)
	IF (sv_h != 0) THEN
	#{
		CUST.DATA.error  = CUST.DATA.drAcct + " Does Not Exist"
		GOTO ENDOFSCRIPT
	ELSE
		CUST.DATA.clrBalAmt = BANCS.OUTPARAM.EffAvailableAmt
	#}
	ENDIF

        IF(CDOUBLE(CUST.DATA.clrBalAmt) < CDOUBLE(CUST.DATA.tranAmt))THEN
        #{
                CUST.DATA.error = "INSUFFICIENT BALANCE IN THE DEBIT ACCOUNT"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	#--------------------------------------------------------------------
	#       MTT Close
	#--------------------------------------------------------------------

		lv_u = urhk_MTTS_Close("")
		print(lv_u)

	#--------------------------------------------------------------------
	#       MTT initialization
	#--------------------------------------------------------------------

		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.CommitFlg   = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
		BANCS.INPARAM.RestrictModifyInd   = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw   = "Y"

		BANCS.INPARAM.ValidationFlag            = "N"
		BANCS.INPARAM.CheckExceptions           = "Y"

		lv_u = urhk_MTTS_Initialize("")
		print(lv_u)

		IF(lv_u == "0") THEN
		#{
			print("Mtt initialized successfully")
		#}
		ELSE
		#{
			print("Mtt initialization failed")

			IF(FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				PRINT(MTT.Error.Description)
				CUST.DATA.error = MTT.Error.Description
			#}
			ENDIF

			GOTO ENDOFSCRIPT
		#}
		ENDIF


	#--------------------------------------------------------------------
	#       MTT Definition
	#--------------------------------------------------------------------

		MTT.TranDetails.TranDate    = "0"
		MTT.TranDetails.TranType    = "T"
		MTT.TranDetails.TranSubType = "BI"
		MTT.TranDetails.PostFlag        = "Y"
		MTT.TranDetails.CommitFlg       = "Y"
		MTT.TranDetails.ValidationFlag  = "N"
		MTT.TranDetails.IgnoreExcp      = "I"

		lv_u = urhk_MTTS_DefineTransaction("TEST_TRAN")
		print(lv_u)

		IF(lv_u == "0") THEN
		#{
			print("Mtt defined successfully")
		#}
		ELSE
		#{
			print("Mtt definition failed")

			lv_u = urhk_MTTS_ReportErrorCondition("")
			print(lv_u)

			IF(FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				PRINT(MTT.Error.Description)
				CUST.DATA.error = MTT.Error.Description
			#}
			ENDIF

			GOTO ENDOFSCRIPT
		#}
		ENDIF

	#--------------------------------------------------------------------
	#       MTT Dr part tran1 Definition
	#--------------------------------------------------------------------

		MTT.PartTranDetails.Account = CUST.DATA.drAcct 
		MTT.PartTranDetails.RefCurrency = CUST.DATA.drCrncy
		MTT.PartTranDetails.RefAmount   = -1 * CDOUBLE(CUST.DATA.tranAmt)
		MTT.PartTranDetails.ValueDate   = "0"
		MTT.PartTranDetails.Particulars = CUST.DATA.drTran
		MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
		MTT.PartTranDetails.Consolidate    = "N"
		MTT.PartTranDetails.Refnum = CUST.DATA.refNum

		MTT.PartTranDetails.PostFlag      = "Y"

		#MTT.PartTranDetails.RateCode = "TTB"

		lv_u = urhk_MTTS_DefinePartTran("DR_TRAN")
		print(lv_u)

		IF(lv_u == "0") THEN
		#{
			print("Mtt DR part tran defined successfully")
		#}
		ELSE
		#{
			print("Mtt DR part tran definition failed")

			lv_u = urhk_MTTS_ReportErrorCondition("")
			print(lv_u)

			IF(FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				PRINT(MTT.Error.Description)
				CUST.DATA.error = MTT.Error.Description
			#}
			ENDIF

			GOTO ENDOFSCRIPT
		#}
		ENDIF

	#--------------------------------------------------------------------
	#       MTT Cr part tran Definition
	#--------------------------------------------------------------------

		MTT.PartTranDetails.Account = CUST.DATA.crAcct 
		MTT.PartTranDetails.RefCurrency = CUST.DATA.crCrncy
		MTT.PartTranDetails.RefAmount   =  CUST.DATA.tranAmt 
		MTT.PartTranDetails.ValueDate   = "0"
		MTT.PartTranDetails.Particulars = CUST.DATA.drTran 
		MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
		MTT.PartTranDetails.Consolidate    = "N"
		MTT.PartTranDetails.Refnum = CUST.DATA.refNum

		MTT.PartTranDetails.PostFlag      = "Y"


		lv_u = urhk_MTTS_DefinePartTran("CR_TRAN")
		print(lv_u)

		IF(lv_u == "0") THEN
		#{
			print("Mtt CR part tran defined successfully")
		#}
		ELSE
		#{
			print("Mtt CR part tran definition failed")

			lv_u = urhk_MTTS_ReportErrorCondition("")
			print(lv_u)

			IF(FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				PRINT(MTT.Error.Description)
				CUST.DATA.error = MTT.Error.Description
			#}
			ENDIF

			GOTO ENDOFSCRIPT
		#}
		ENDIF
IF(CUST.DATA.chrgFlg == "N")THEN
#{	
	#--------------------------------------------------------------------
        #       MTT Dr part tran1 Definition
        #--------------------------------------------------------------------

                MTT.PartTranDetails.Account = CUST.DATA.drAcct
                MTT.PartTranDetails.RefCurrency = CUST.DATA.drCrncy
                MTT.PartTranDetails.RefAmount   = -1 * CDOUBLE(CUST.DATA.chrgAmt)
                MTT.PartTranDetails.ValueDate   = "0"
                MTT.PartTranDetails.Particulars = CUST.DATA.drChgTran 
                MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
                MTT.PartTranDetails.Consolidate    = "N"
		MTT.PartTranDetails.Refnum = CUST.DATA.refNum

                MTT.PartTranDetails.PostFlag      = "Y"

                #MTT.PartTranDetails.RateCode = "TTB"

                lv_u = urhk_MTTS_DefinePartTran("DR_TRAN2")
                print(lv_u)

                IF(lv_u == "0") THEN
                #{
                        print("Mtt DR part tran defined successfully")
                #}
                ELSE
                #{
                        print("Mtt DR part tran definition failed")

                        lv_u = urhk_MTTS_ReportErrorCondition("")
                        print(lv_u)

                        IF(FIELDEXISTS(MTT.Error.Description)) THEN
                        #{
                                PRINT(MTT.Error.Description)
                                CUST.DATA.error = MTT.Error.Description
                        #}
                        ENDIF

                        GOTO ENDOFSCRIPT
                #}
                ENDIF

	#--------------------------------------------------------------------
        #       MTT Cr part tran Definition
        #--------------------------------------------------------------------

                MTT.PartTranDetails.Account = "4000650010085" 
                MTT.PartTranDetails.RefCurrency = CUST.DATA.crCrncy
                MTT.PartTranDetails.RefAmount   = CUST.DATA.chrgAmt 
                MTT.PartTranDetails.ValueDate   = "0"
                MTT.PartTranDetails.Particulars = CUST.DATA.drChgTran 
                MTT.PartTranDetails.TranIdentifier = "TEST_TRAN"
                MTT.PartTranDetails.Consolidate    = "N"
		MTT.PartTranDetails.Refnum = CUST.DATA.refNum

                MTT.PartTranDetails.PostFlag      = "Y"


                lv_u = urhk_MTTS_DefinePartTran("CR_TRAN2")
                print(lv_u)

                IF(lv_u == "0") THEN
                #{
                        print("Mtt CR part tran defined successfully")
                #}
                ELSE
                #{
                        print("Mtt CR part tran definition failed")

                        lv_u = urhk_MTTS_ReportErrorCondition("")
                        print(lv_u)

                        IF(FIELDEXISTS(MTT.Error.Description)) THEN
                        #{
                                PRINT(MTT.Error.Description)
                                CUST.DATA.error = MTT.Error.Description
                        #}
                        ENDIF

                        GOTO ENDOFSCRIPT
                #}
                ENDIF
#}
ENDIF
	#--------------------------------------------------------------------
	#       MTT end definition
	#--------------------------------------------------------------------

		lv_u = urhk_MTTS_EndDefinition("")
		print(lv_u)

		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
			CUST.DATA.error = MTT.Error.Description
			lv_u = urhk_MTTS_ReportErrorCondition("")
			print(lv_u)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			CUST.DATA.tranId = TRIM(BANCS.OUTPARAM.MTTTranId)
			PRINT(CUST.DATA.tranId)
		#}
		ENDIF

	#--------------------------------------------------------------------
	#       MTT Close
	#--------------------------------------------------------------------

		lv_u = urhk_MTTS_Close("")
		print(lv_u)

ENDOFSCRIPT:	
		PRINT(CUST.DATA.error)
		PRINT(CUST.DATA.tranId)


TRACE OFF
END-->
