		#{
		sv_u = urhk_SRV_SetErr("Err|arameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.DATA.chqValCcy=BANCS.STDIN.homeCrncyCode
	#--------------------------------------------------------------
	# Input from zone header
	#--------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("zoneHeader.zoneCrncyCode.crncyCode")
	CUST.DATA.zoneCcy = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.zoneCcy)
	
	#--------------------------------------------------------------
	# Input from ptran
	#--------------------------------------------------------------
	sv_u = urhk_SRV_NumOfRecs("ptranLL")
	CUST.DATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.DATA.noOfRecords)
	
	sv_l = 0
	WHILE(sv_l < CUST.DATA.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		
		sv_u = urhk_SRV_GetVal("ptranLL." +sv_r+ ".ptranAcctId.foracid")
		CUST.DATA.acctNo = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.acctNo)
		
		sv_u = urhk_SRV_GetVal("ptranLL." +sv_r+ ".partTranAmtInInstCrncy")
		CUST.DATA.pTranAmt = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.pTranAmt)
		sv_y = CUST.DATA.pTranAmt
		sv_x=GETPOSITION(sv_y,"|")
		sv_x=sv_x-1
		sv_w=MID$(sv_y,0,sv_x)
		print(sv_w)
		CUST.DATA.pTranAmt=sv_w
		sv_u = urhk_SRV_GetVal("ptranLL." +sv_r+ ".tranRmks")
		CUST.DATA.tranRmk = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.tranRmk)
		
		sv_u = urhk_SRV_GetVal("ptranLL."+sv_r+".partcls")
		CUST.DATA.particulars= BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.tranRmk)
		
		IF ((CUST.DATA.zoneCcy==CUST.DATA.chqValCcy1) AND (CDOUBLE(CUST.DATA.pTranAmt)>CDOUBLE(CUST.DATA.chqValCAmt1))) THEN
		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Amount cannot exceed 35000")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ((CUST.DATA.zoneCcy==CUST.DATA.chqValCcy2) AND (CDOUBLE(CUST.DATA.pTranAmt)>CDOUBLE(CUST.DATA.chqValCAmt2))) THEN
		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Amount cannot exceed 30000")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ((CUST.DATA.zoneCcy==CUST.DATA.chqValCcy3) AND (CDOUBLE(CUST.DATA.pTranAmt) >CDOUBLE(CUST.DATA.chqValCAmt3))) THEN
		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Amount cannot exceed 15000")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (CUST.DATA.pTranAmt =="" ) THEN
		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Amount should be entered")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			IF (CUST.DATA.zoneCcy==CUST.DATA.chqValCcy) THEN
			#{
				
				print(CUST.DATA.pTranAmt)
				sv_b = "."
				sv_c = getposition(CUST.DATA.pTranAmt, sv_b)
				print(sv_c)
				IF (sv_c!=CINT("0")) THEN
				#{
					sv_d = STRLEN(CUST.DATA.pTranAmt )
					print(sv_d)
					sv_e = MID$(CUST.DATA.pTranAmt ,sv_c,sv_d)
					print(sv_e)
					
					IF (sv_e < CINT("9")) THEN
					#{
						sv_e = sv_e+"0"
					#}
					ENDIF
					
					sv_a = CINT(sv_e)/5
					print(sv_a)
					sv_c = CDOUBLE(sv_e)/5
					print(sv_c)
					IF (sv_c > sv_a) THEN
					#{
						IF((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "56")) THEN
						#{
							sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Decimal value should be multiple of 5 cents")
							print(sv_u)
							sv_u = urhk_SRV_SetVal("instrLL."+sv_r+".instrmntAmt| ")
							BANCS.OUTPUT.successOrFailure="F"
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		sv_m = GETPOSITION(CUST.DATA.chqValAcctLst1,"|"+CUST.DATA.acctNo+"|")
		print(sv_m)
		IF (sv_m>0) THEN
		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".ptranAcctId.foracid|Error: Cheque Deposits not allowed in this account")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#-------------------------------------------------
		#Finding Schm Code
		#--------------------------------------------------
		sv_s = "schmCode|SELECT schm_code "
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE foracid=?SVAR"
		sv_s = sv_s + " AND del_flg='N'"
		sv_s = sv_s + " AND entity_cre_flg='Y'"
		sv_s = sv_s + " AND bank_id=?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.acctNo +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d==0) THEN
		#{
			CUST.DATA.schmCode= BANCS.OUTPARAM.schmCode
			print(CUST.DATA.schmCode)
		#}
		ENDIF
		
		sv_m = GETPOSITION(CUST.DATA.chqValSchmLst,"|"+CUST.DATA.schmCode+"|")
		print(sv_m)
		IF (sv_m>0) THEN
		#{
			
			sv_s = "count|"
			sv_s = sv_s + "SELECT count(*) from CUSTOM.C_CIC "
			sv_s = sv_s + " WHERE ACCTNUM = ?SVAR "
			sv_s = sv_s + " AND bank_id= ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.DATA.acctNo +"|"+BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_w = urhk_dbSelectWithBind(sv_s)
			print(sv_w)
			IF (sv_w == 0) THEN
			#{
				CUST.DATA.count = BANCS.OUTPARAM.count
				print(CUST.DATA.count)
				IF (CUST.DATA.count !=0) THEN
				#{
					CUST.DATA.name = CUST.DATA.particulars
					#print(CUST.DATA.name)
					print(CUST.DATA.tranRmk)
					IF (FIELDEXISTS(BANCS.INPUT.refNumHidden)) THEN
						IF (BANCS.INPUT.refNumHidden!="") THEN
							CUST.DATA.tranRmk = BANCS.INPUT.refNumHidden
							print(CUST.DATA.tranRmk)
						ENDIF
					ENDIF
					IF (FIELDEXISTS(BANCS.INPUT.d1MRFreeText1_1)) THEN
						IF (BANCS.INPUT.d1MRFreeText1_1!="") THEN
							CUST.DATA.tranRmk = BANCS.INPUT.d1MRFreeText1_1
							print(CUST.DATA.tranRmk)
						ENDIF
					ENDIF
					IF (CUST.DATA.tranRmk=="") THEN
						#{
						print("ENTER THE ADMIN/REG/BILL/REF NO IN THE Tran. Remarks FIELD.........")
						sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".tranRmks|Error:ENTER THE ADMIN/REG/BILL/REF NO IN THE Tran. Remarks FIELD.........")
						print(sv_u)
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						sv_s = "REFNUM,NAME|"
						sv_s = sv_s + "SELECT refnum,name FROM CUSTOM.C_CIC "
						sv_s = sv_s + " WHERE ACCTNUM = ?SVAR "
						sv_s = sv_s + " AND REFNUM = ?SVAR "
						sv_s = sv_s + " AND DEL_FLG = 'N' "
						sv_s = sv_s + " AND bank_id = ?SVAR "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.DATA.acctNo+"|"+CUST.DATA.tranRmk +"|"+BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_w = urhk_dbselectWithBind(sv_s)
						print(sv_w)
						IF ( sv_w != 0 ) THEN
						#{
							print("INVALID ADMIN/REG/BILL/REF NUMBER...")
							sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".tranRmks|Error:INVALID ADMIN/REG/BILL/REF NUMBER...")
							GOTO ENDOFSCRIPT
							#}
						ELSE
							#{
							CUST.DATA.refnum = BANCS.OUTPARAM.REFNUM
							CUST.DATA.name = BANCS.OUTPARAM.NAME
							
							sv_a = " REG NO :  "
							sv_a = sv_a +CUST.DATA.refnum + "    NAME : "
							sv_a = sv_a + CUST.DATA.name
							print(sv_a)
							#sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".tranRmks|Error:"+sv_a)
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ENDIF
					#}
				ELSE
					#{
					print(CUST.DATA.tranRmk)
					IF (CUST.DATA.tranRmk=="") THEN
					#{
						print("ENTER THE ADMIN/REG/BILL/REF NO IN THE Tran. Remarks FIELD.........")
						sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".tranRmks|Error:ENTER THE ADMIN/REG/BILL/REF NO IN THE Tran. Remarks FIELD.........")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		sv_l = sv_l + 1
		PRINT (sv_l)
	#}
	DO
	
	EXITSCRIPT
