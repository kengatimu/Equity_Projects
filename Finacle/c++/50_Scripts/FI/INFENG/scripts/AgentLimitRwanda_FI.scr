<--start
CHECKSUM="b9922b3d30341e140cbe137606a7290925aa1e22f0ea5a4bbcb56801c8e43613"
TRACE ON

	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		EQSRV.GLBDATA.tranType = BANCS.OUTPARAM.srvValue
		PRINT(EQSRV.GLBDATA.tranType)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Type")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		EQSRV.GLBDATA.tranSubType = BANCS.OUTPARAM.srvValue
		PRINT(EQSRV.GLBDATA.tranSubType)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Sub Type")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	IF(sv_u == 0) THEN
	#{
			EQSRV.GLBDATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
			PRINT(EQSRV.GLBDATA.noOfRecords)
	#}
	ELSE
	#{
			sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_l = 0
	sv_m = ""
	sv_n = 0
	sv_a = "\n"
	sv_x = 0
	sv_z = 0
	sv_c = 0
	sv_e = 0	
	WHILE(sv_l < EQSRV.GLBDATA.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		
		#-------------------------------------------------------------------------------------------
		# Fetch A/c - foracid
		#-------------------------------------------------------------------------------------------
		
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			EQSRV.GLBDATA.serialnum = BANCS.OUTPARAM.srvValue
			PRINT(EQSRV.GLBDATA.serialnum)
		#}
		ELSE
		#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serialnum")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch A/c - foracid
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			EQSRV.GLBDATA.acct = BANCS.OUTPARAM.srvValue
			BANCS.INPUT.Foracid = EQSRV.GLBDATA.acct
			PRINT(EQSRV.GLBDATA.acct)
		#}
		ELSE
		#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Account Number")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refAmt")
		print(sv_u)
		if (sv_u == 0)then
		#{
			EQSRV.GLBDATA.refAmnt = BANCS.OUTPARAM.srvValue
			print(EQSRV.GLBDATA.refAmnt)
			EQSRV.GLBDATA.refAmnt = LEFT$(EQSRV.GLBDATA.refAmnt,GETPOSITION(EQSRV.GLBDATA.refAmnt,"|") - 1)
			print(EQSRV.GLBDATA.refAmnt)
			BANCS.INPUT.TranAmt = EQSRV.GLBDATA.refAmnt
		#}
		endif		 
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refCrncyCode.crncyCode")
		print(sv_u)
			if (sv_u == 0)then
			#{
			EQSRV.GLBDATA.refCrncy = BANCS.OUTPARAM.srvValue
			print(EQSRV.GLBDATA.refCrncy)
		#}
		endif
		
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." + sv_r +".partTranType.code")
		EQSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
		print(EQSRV.GLBDATA.partTranType)
		sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.acct)
		IF (sv_u == 0)THEN
		#{
			EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
			PRINT(EQSRV.GLBDATA.schmType)
			EQSRV.GLBDATA.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
			PRINT(EQSRV.GLBDATA.acctOwnerShip)
			EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
			PRINT(EQSRV.GLBDATA.schmCode)
			EQSRV.GLBDATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
			print(EQSRV.GLBDATA.acctCrncyCode)
			EQSRV.GLBDATA.effbalamt = BANCS.OUTPARAM.EffAvailableAmt 
			print(EQSRV.GLBDATA.effbalamt)
			EQSRV.GLBDATA.AcctSolId = BANCS.OUTPARAM.acctSolId
			print(EQSRV.GLBDATA.AcctSolId)
			EQSRV.GLBDATA.CrncyCode = BANCS.OUTPARAM.acctCrncyCode
			print(EQSRV.GLBDATA.CrncyCode)
			EQSRV.GLBDATA.drCifId = BANCS.OUTPARAM.cifId
			print(EQSRV.GLBDATA.drCifId)
			
		else
			EQSRV.GLBDATA.schmType = ""
			EQSRV.GLBDATA.acctOwnerShip = ""
			EQSRV.GLBDATA.schmCode =""	
			EQSRV.GLBDATA.acctCrncyCode = ""
			EQSRV.GLBDATA.effbalamt ="0"
			EQSRV.GLBDATA.AcctSolId = ""
			EQSRV.GLBDATA.CrncyCode = ""
			EQSRV.GLBDATA.drCifId=""
			
		#}
		ENDIF
		if((EQSRV.GLBDATA.schmCode =="CA207") or (EQSRV.GLBDATA.schmCode=="SB126"))then
		#{
				if((EQSRV.GLBDATA.acctOwnerShip !="O")  and (EQSRV.GLBDATA.tranType=="T") and (EQSRV.GLBDATA.tranSubType=="CI") and (EQSRV.GLBDATA.partTranType =="D"))then
				#{
							EQSRV.GLBDATA.allowAgentFloatCnt = "0"
							lv_p = " activePoolCnt | select count(*) from tbaadm.gam,tbaadm.pft where gam.bank_id=?SVAR and pft.bank_id=?SVAR and gam.cif_id=?SVAR and gam.schm_code in ('OD541','SB126','CA207') and gam.acct_cls_flg<>'Y' and gam.del_flg<>'Y' and gam.entity_cre_flg='Y' and gam.allow_sweeps='Y' and pft.pool_id=gam.pool_id and pft.suspend_flg<>'Y' "
							BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.drCifId
							lv_i = urhk_dbSelectWithBind(lv_p)
							if(lv_i==0)then
							#{
									EQSRV.GLBDATA.activePoolCnt = BANCS.OUTPARAM.activePoolCnt
							else
									EQSRV.GLBDATA.activePoolCnt = "0"
							#}
							endif
							BANCS.INPUT.AgentDmd = "Y"
									lv_b = "allowAgentFloatCnt | select count(*) from tbaadm.fcftt,tbaadm.gam where  gam.bank_id=?SVAR and fcftt.bank_id=?SVAR and gam.acid=fcftt.acid and gam.foracid=?SVAR and fcftt.FREE_CODE_18='AGENT-FLOAT' and gam.entity_cre_flg='Y' and gam.del_flg='N' and fcftt.entity_cre_flg='Y' and fcftt.del_flg='N' "
									BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acct
									lv_b = urhk_dbSelectWithBind(lv_b)
									if(lv_b==0)then
									#{
											EQSRV.GLBDATA.allowAgentFloatCnt = BANCS.OUTPARAM.allowAgentFloatCnt
									#}
									else
									#{
											EQSRV.GLBDATA.allowAgentFloatCnt = "0"
									#}
									endif
									if(cdouble(EQSRV.GLBDATA.allowAgentFloatCnt)>=1)then
									#{
											callscriptifexist("vpAgentLimitCrRW_FI.scr")
									#}
									endif
	
							if(fieldexists(BANCS.OUTPUT.agntValYN)==1)then
							#{
									#Zero Limit or No OD Limit
									print(BANCS.OUTPUT.agntValYN)
									if(BANCS.OUTPUT.agntValYN=="ZEROLIMIT")then
									#{
											BANCS.OUTPUT.ReservedField3 = "Transaction Not Allowed -Zero Limit"
											BANCS.OUTPUT.successOrFailure = "F"
											exitscript
									#}
									endif
									#Related Loan is DPD
									if(BANCS.OUTPUT.agntValYN=="DPD")then
									#{
											BANCS.OUTPUT.ReservedField3 = "Transaction Not Allowed -Agent Related Loans are Due "
											BANCS.OUTPUT.successOrFailure = "F"
											exitscript
									#}
									endif
									#Agent Related OD has insufficient Fund
									if(BANCS.OUTPUT.agntValYN=="NOCR")then
									#{
											BANCS.OUTPUT.ReservedField3 = "Transaction Not Allowed -Agent Od Limit Exceeds "
											BANCS.OUTPUT.successOrFailure = "F"
											exitscript
									#}
									endif
									if(BANCS.OUTPUT.agntValYN=="F")then
									#{
											BANCS.OUTPUT.ReservedField3 = "Transaction Not Allowed -Agent Od Transaction Failed "
											BANCS.OUTPUT.successOrFailure = "F"
											exitscript
									#}
									endif
									if(BANCS.OUTPUT.agntValYN=="N")then
									#{
											BANCS.OUTPUT.ReservedField3 = "Transaction Not Allowed -Agent Limit Exceeds "
											BANCS.OUTPUT.successOrFailure = "F"
											exitscript
									#}
									endif
							#}
							endif
							if(fieldexists(BANCS.OUTPUT.agntValYN)==1)then
							#{
									if(BANCS.OUTPUT.agntValYN=="O")then
									#{
											BANCS.OUTPUT.ReservedField3 = "Transaction Not Allowed -Agent Overdue Exist "
											BANCS.OUTPUT.successOrFailure = "F"
											exitscript
									#}
									endif
									if(BANCS.OUTPUT.agntValYN=="C")then
									#{
											BANCS.OUTPUT.ReservedField3 = "Transaction Not Allowed -Limit Exceeds for tran&charge amount"
											BANCS.OUTPUT.successOrFailure = "F"
											exitscript
									#}
									endif
							#}
							endif
					#}
					endif
			#}
			endif
	sv_l = sv_l + 1
	print(sv_l)
	#}
	DO

ENDOFSCRIPT:
#######trace off
end-->