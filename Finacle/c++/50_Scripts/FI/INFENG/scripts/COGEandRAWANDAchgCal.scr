CHRGCAL:	

	########################################################################################################
	# Fetching of Charge Amount for respective EventId from the custom table
	########################################################################################################

	sv_s="chrgType|SELECT CHARGE_TYPE FROM CUSTOM.CHG_COGE WHERE EVENT_TYPE=?SVAR AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
	sv_s = sv_s + " AND CRNCY_CODE=?SVAR AND BANK_ID=?SVAR AND SRL_NUM=?SVAR AND BANK =?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.DATA.eventType + "|" + CUST.DATA.eventId + "|" + CUST.DATA.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.srlNum +"|"+ CUST.DATA.bank
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d=urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != "0")THEN

		sv_e="Charge details not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
		sv_u = urhk_SetOrbErr(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT

	ELSE

		CUST.DATA.chrgType=BANCS.OUTPARAM.chrgType
		print(CUST.DATA.chrgType)

	ENDIF

	IF(CUST.DATA.chrgType == "F")THEN

		sv_s="chrgAmt|SELECT CHRG_AMT FROM CUSTOM.CHG_COGE WHERE EVENT_TYPE=?SVAR AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
		sv_s = sv_s + " AND CRNCY_CODE=?SVAR AND BANK_ID=?SVAR AND SRL_NUM=?SVAR AND BANK = ?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.DATA.eventType + "|" + CUST.DATA.eventId + "|" + CUST.DATA.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.srlNum +"|"+ CUST.DATA.bank
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		IF(sv_d != "0")THEN
			sv_e="Charge Amount not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
			sv_u = urhk_SetOrbErr(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		ELSE
			CUST.DATA.chrgAmt=BANCS.OUTPARAM.chrgAmt
		ENDIF
	ENDIF	

	IF(CUST.DATA.chrgType == "P")THEN
	#{
		sv_s="chrgpcnt,minAmt,maxAmt|SELECT PRCNT,MIN_AMT,MAX_AMT FROM CUSTOM.CHG_COGE WHERE EVENT_TYPE=?SVAR AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
		sv_s = sv_s + " AND CRNCY_CODE=?SVAR AND BANK_ID=?SVAR AND SRL_NUM=?SVAR AND BANK = ?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.DATA.eventType + "|" + CUST.DATA.eventId + "|" + CUST.DATA.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.srlNum +"|"+ CUST.DATA.bank
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		IF(sv_d != "0")THEN
			sv_e="Charge percentage not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
			sv_u = urhk_SetOrbErr(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		ELSE
			CUST.DATA.chrgpcnt=BANCS.OUTPARAM.chrgpcnt	
			CUST.DATA.minAmt=CDOUBLE(BANCS.OUTPARAM.minAmt)
			CUST.DATA.maxAmt=CDOUBLE(BANCS.OUTPARAM.maxAmt)

			PRINT(CUST.DATA.chrgpcnt)
			PRINT(CUST.DATA.minAmt)
			PRINT(CUST.DATA.maxAmt)
			CUST.DATA.chrgAmt = CDOUBLE(CUST.DATA.inputAmt) * CDOUBLE(CUST.DATA.chrgpcnt) * (0.01)
			PRINT(CUST.DATA.chrgAmt)
		
			## PAY OFF CHANGES: Add 1% of Remaining Capital				
				IF(CUST.DATA.eventType == "PYOFF")THEN
					IF(FIELDEXISTS(BANCS.INPUT.prinOutstanding))THEN
						print(BANCS.INPUT.prinOutstanding)
						CUST.DATA.tempAmt = CDOUBLE(BANCS.INPUT.prinOutstanding) * (0.01)
						print(CUST.DATA.tempAmt)
						CUST.DATA.chrgAmt = CDOUBLE(CUST.DATA.chrgAmt) + CDOUBLE(CUST.DATA.tempAmt)
						print(CUST.DATA.chrgAmt)
					ENDIF
				ENDIF
				
			## END OF PAYOFF CHANGES ##

			IF(CDOUBLE(CUST.DATA.chrgAmt) < CDOUBLE(CUST.DATA.minAmt))THEN
				CUST.DATA.chrgAmt = CUST.DATA.minAmt
				print(CUST.DATA.chrgAmt)
			ENDIF

			IF(CDOUBLE(CUST.DATA.chrgAmt) > CDOUBLE(CUST.DATA.maxAmt))THEN
				CUST.DATA.chrgAmt = CUST.DATA.maxAmt
				print(CUST.DATA.chrgAmt)
			ENDIF
		ENDIF
	ENDIF	

	IF(CUST.DATA.chrgType == "S")THEN
	#{
		sv_s="slabCode|SELECT SLAB_CODE FROM CUSTOM.CHG_COGE WHERE EVENT_TYPE=?SVAR AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
		sv_s = sv_s + " AND CRNCY_CODE=?SVAR AND BANK_ID=?SVAR AND SRL_NUM=?SVAR and BANK = ?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.DATA.eventType + "|" + CUST.DATA.eventId + "|" + CUST.DATA.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.srlNum +"|"+ CUST.DATA.bank
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
