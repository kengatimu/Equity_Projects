			sv_e="Charge slab code not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
			sv_u = urhk_SetOrbErr(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		ELSE		
			CUST.DATA.slabCode=BANCS.OUTPARAM.slabCode
		ENDIF

		IF(CUST.DATA.slabCode == "")THEN
			sv_e="Charge slab code not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
			sv_u = urhk_SetOrbErr(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		ENDIF
		BANCS.INPARAM.CurrencyCode = CUST.DATA.crncy
		BANCS.INPARAM.AmountTableCode = CUST.DATA.slabCode	
		BANCS.INPARAM.InputAmount = CUST.DATA.inputAmt
		PRINT(BANCS.INPARAM.AmountTableCode)
		PRINT(BANCS.INPARAM.CurrencyCode)
		PRINT(BANCS.INPARAM.InputAmount)

		# -----------------------------------------------------------------------------
		# Amount slab Userhook to determine the COT amount
		# -----------------------------------------------------------------------------        


		sv_r = urhk_B2k_GetASTMAmount("")
		print(sv_r)
		IF (sv_r != 0) THEN

			sv_e="Unable to determine the charge Amount for the table Code:"+CUST.DATA.slabCode
			sv_u = urhk_SetOrbErr(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		ENDIF

		# -----------------------------------------------------------------------------
		# COT amount for the account
		# -----------------------------------------------------------------------------
		
		CUST.DATA.chrgAmt = BANCS.OUTPARAM.OutputAmount
		print(CUST.DATA.chrgAmt)
	#}
	ENDIF	

	ENDOFSCRIPT:		
		CUST.DATA.srlNum=1
		BANCS.OUTPUT.collAmount = CUST.DATA.chrgAmt
		BANCS.OUTPUT.collCrncy = BANCS.INPUT.chrgCollCrncy
		BANCS.OUTPUT.AmountWithNoDiscount = CUST.DATA.chrgAmt
