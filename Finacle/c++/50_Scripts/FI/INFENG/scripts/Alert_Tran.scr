	#==============================================================================
	# Changed logic to put deatils in stage table custom.mobee_push_sms_stage
	# And sending alter after 5 minutes after charge transaction completed
	# CR - CHG0032898 Transactions notification to include balance, charges , 
	# contact Centre number, reference as customer protection requirement 
	#==============================================================================
	sv_s = urhk_getAcctDetailsInRepository(CUST.ALERTS.AcctNum)
	print(sv_s)
		
	print(BANCS.OUTPARAM.EffAvailableAmt)

	lv_t = ""
	lv_t = lv_t + " insert into custom.mobee_push_sms_stage"
	lv_t = lv_t + " ( "
	lv_t = lv_t + " select "
	lv_t = lv_t + " gam.bank_id, "
	lv_t = lv_t + " gam.foracid, "
	lv_t = lv_t + " tran_id, "
	lv_t = lv_t + " tran_date,"
	lv_t = lv_t + " tran_type,"
	lv_t = lv_t + " tran_sub_type,"
	lv_t = lv_t + " part_tran_type,"
	lv_t = lv_t + " part_tran_srl_num,"
	lv_t = lv_t + " "+BANCS.OUTPARAM.EffAvailableAmt+" EffAvailableAmt,"
	lv_t = lv_t + " 'N' as alert_status "
	lv_t = lv_t + " from tbaadm.dtd, tbaadm.gam " 
	lv_t = lv_t + " where dtd.acid=gam.acid "
	lv_t = lv_t + " and dtd.bank_id=gam.bank_id "
	lv_t = lv_t + " and dtd.del_flg='N' "
	lv_t = lv_t + " and gam.schm_type not in ('LAA','TDA') "
	lv_t = lv_t + " and dtd.acid not in (select acid from tbaadm.gac where bank_id= '"+BANCS.STDIN.contextBankId+"' and free_code_8 = 'SMS') "
	lv_t = lv_t + " and gam.acct_ownership in ('C','E') "
	lv_t = lv_t + " and entry_user_id !='CDCI50' " 
	lv_t = lv_t + " and tran_particular not like '%Int.Coll%' " 
	lv_t = lv_t + " and tran_particular not like '%Payoff%' "
	lv_t = lv_t + " and tran_particular not like '%Charge%' "
	lv_t = lv_t + " and tran_particular not like '%charge%' "
	lv_t = lv_t + " and tran_particular not like '%CHARGE%' "
	lv_t = lv_t + " and ((dtd.tran_rmks not like '%SYSTEM:INSTRMNT VALUEDATE CHNG%') or (dtd.tran_rmks is null)) "
	lv_t = lv_t + " and gam.foracid =  '"+CUST.ALERTS.AcctNum+"' "
	lv_t = lv_t + " and dtd.tran_id =  '"+BANCS.INPUT.TranId+"' "
	lv_t = lv_t + " and dtd.tran_date = to_date('"+MID$(CUST.ALERTS.TranDate,0,10)+"','DD-MM-YYYY') "
	lv_t = lv_t + " and dtd.part_tran_srl_num = '"+CUST.ALERTS.PartTranSrlNum+"' "
	lv_t = lv_t + " and gam.bank_id =  '"+BANCS.STDIN.contextBankId+"' "
	lv_t = lv_t + " ) "

	print(lv_t)

	sv_d = urhk_dbSqlWithBind(lv_t)
	print(sv_d)
	IF(sv_d == 0) THEN
	#{
		CUST.ALERTS.opt = "Y"
	ELSE
		CUST.ALERTS.opt = "N"
	#}
	ENDIF

