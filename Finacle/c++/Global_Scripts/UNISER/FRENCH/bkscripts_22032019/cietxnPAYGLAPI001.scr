	CUST.CIETXN.entity1TranDate = MID$(BANCS.STDIN.BODDate,0,10)
	PRINT(CUST.CIETXN.entity1TranDate)
	
	CUST.CIETXN.nostroAcct = CUST.PAYGLAPI.nostroAcct
	PRINT(CUST.CIETXN.nostroAcct)
	
	######################################################################################
	# Get Current Txn Ref Amt and Ref Crncy to Compare with Original Ref Amt and Ref Crncy
	######################################################################################
	
	CUST.CIETXN.refAmt = ""
	CUST.CIETXN.refCrncy = ""
	
	
	CUST.CIETXN.refAmt =  CUST.PAYGLAPI.tranAmt
	PRINT(CUST.CIETXN.refAmt)
	CUST.CIETXN.refCrncy = CUST.PAYGLAPI.tranCrncy
	PRINT(CUST.CIETXN.refCrncy)
	
	
	######################################################################################
	# Create Transaction in the Other Entity Through FI Call
	######################################################################################
	
	PRINT(CUST.PAYGLAPI.ieRefNo)
	CUST.CIETXN.ieTxnRefNo = CUST.PAYGLAPI.ieRefNo
	PRINT(CUST.CIETXN.ieTxnRefNo)
	CUST.CIETXN.entity2 = MID$(CUST.PAYGLAPI.ieRefNo,0,2)
	CUST.CIETXN.ieTxnInitEntity = CUST.CIETXN.entity2
	CUST.CIETXN.ieRefAmt = ""
	CUST.CIETXN.ieRefCrncy = ""
	
	BANCS.INPARAM.BINDVARS = CUST.PAYGLAPI.ieRefNo
	sv_s = "crAcctNum,ieRefAmt,ieRefCrncy|"
	sv_s = sv_s + " SELECT CR_ACCOUNT_ID,REF_AMT,REF_CRNCY_CODE"
	sv_s = sv_s + " FROM TBAADM.IEPAGL "
	sv_s = sv_s + " WHERE STATUS_FLG = 'I'"
	sv_s = sv_s + " AND IE_TXN_REF_NO = ?SVAR"
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.crAcctNum = BANCS.OUTPARAM.crAcctNum
		PRINT(CUST.CIETXN.crAcctNum)
