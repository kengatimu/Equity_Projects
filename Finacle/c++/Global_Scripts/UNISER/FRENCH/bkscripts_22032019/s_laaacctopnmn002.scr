			sv_s = sv_s + " ONLINE_APPS.statusflag,ONLINE_APPS.loanamount"
			sv_s = sv_s + " FROM CUSTOM.ONLINE_APPS"
			sv_s = sv_s + " WHERE STATUSFLAG= ?SVAR"
			sv_s = sv_s + " AND ONLINE_APPS.bank_id = ?SVAR"
			sv_s = sv_s + " AND nationalid = ("
			sv_s = sv_s + 					" SELECT nat_id_card_num"
			sv_s = sv_s + 					" FROM TBAADM.CMG"
			sv_s = sv_s + 					" WHERE CMG.cif_id= ?SVAR "
			sv_s = sv_s + 					" AND CMG.bank_id = ONLINE_APPS.bank_id)"
