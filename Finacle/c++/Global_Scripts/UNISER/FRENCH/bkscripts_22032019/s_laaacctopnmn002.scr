				#}
				ENDIF
				
				sv_u =  urhk_SRV_GetVal("acctPDCDtls.pdcLL.<rec_1>.flowId")
				IF(sv_u == 0)THEN
				#{
					CUST.LAOPN.flowId_2 = BANCS.OUTPARAM.srvValue
