#=================================================
# IMPORTANT: Auto Generated Header. DO NOT CHANGE MANUALLY.
# category: Event Based
# script: FundAndPost.scr
# script that is used to fund a cdsc account and post the details
#=================================================

<--start
	trace on
	
	
	#####################################################
	
	if(REPEXISTS("CUST")==0) then
		
		CREATEREP("CUST")
		
	endif
	
	IF(CLASSEXISTS("CUST","TRADE")==0) then
		
		CREATECLASS("CUST","TRADE",5)
		
	endif
	
	
	
	
	#######################################################
	
	
	############################Setting the input Parameter #########################
	#Getting the time-stamp from sysDate
	BANCS.INPARAM.Day = LEFT$(BANCS.STDIN.sysDate,2)
	print(BANCS.INPARAM.Day)
	BANCS.INPARAM.Month = MID$(BANCS.STDIN.sysDate,3,2)
	print(BANCS.INPARAM.Month)
	BANCS.INPARAM.Year = MID$(BANCS.STDIN.sysDate,8,2)
	print(BANCS.INPARAM.Year)
	BANCS.INPARAM.Hour = MID$(BANCS.STDIN.sysDate,11,2)
	print(BANCS.INPARAM.Hour)
	BANCS.INPARAM.Minute = MID$(BANCS.STDIN.sysDate,14,2)
	print(BANCS.INPARAM.Minute)
	BANCS.INPARAM.Second = MID$(BANCS.STDIN.sysDate,17,2)
	print(BANCS.INPARAM.Second)
	
	BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second
	
	
	BANCS.INPARAM.REQUESTUUID           = "reqUUID"+"CSHAPU"+BANCS.INPARAM.SYSDATE
	BANCS.INPARAM.BANKID                = "54"
	BANCS.INPARAM.SERVICEREQUESTID      = "FundAndPost"
	BANCS.INPARAM.MESSAGEDATETIME       = "BANCS.STDIN.sysDate"
	BANCS.INPARAM.CHANNELID             = "FNP"
	BANCS.INPARAM.SERVICEREQUESTVERSION = "10.2"
	BANCS.INPARAM.TIMEZONE              = "GMT+01:30"
	
	CUST.TRADE.header="MSG_TYPE=NVPSTR,MSG_SUB_TYPE=FINVP###reqhdr.requestuuid^=^"+BANCS.INPARAM.REQUESTUUID+"^|^reqhdr.servicerequestid^=^"+BANCS.INPARAM.SERVICEREQUESTID+"^|^reqhdr.servicerequestversion^=^"+BANCS.INPARAM.SERVICEREQUESTVERSION
	CUST.TRADE.header=CUST.TRADE.header+"^|^reqhdr.origchannelid^=^"+BANCS.INPARAM.CHANNELID+"^|^reqhdr.languageid^=^en_US^|^reqhdr.messagedatetime^=^"+BANCS.STDIN.sysDate+"^|^reqhdr.bankid^=^"+BANCS.INPARAM.BANKID+"^|^reqhdr.timezone^=^"+BANCS.INPARAM.TIMEZONE+"^|^"
	
	print(CUST.TRADE.header)
	
	########################
	########################Funding strings
	CUST.TRADE.URL="http://10.1.5.46:7002/SharePurchaseService/SharePurchaseService"
	CUST.TRADE.ordType="1"
	#This will be in the verification page	
	CUST.TRADE.tid=BANCS.INPARAM.SYSDATE
	CUST.TRADE.uId1="AG01342"
	CUST.TRADE.uId2="GN00418"
	CUST.TRADE.uId3="FN01047"
	CUST.TRADE.funding="0"
	CUST.TRADE.createorder="0"
	
	#####Hard Coding	
	BANCS.INPARAM.BINDVARS=CUST.TRADE.dc	
	############ Selecting the tran id from the database
	#############String for creating an order
	
	####Some hardcoding
	CUST.TRADE.solid=BANCS.STDIN.mySolId
	########
	
	CUST.TRADE.paymentreference=CUST.TRADE.dc
	PRINT(CUST.TRADE.paymentreference)
	CUST.TRADE.paymentnarrative=CUST.TRADE.dc+":FINDEBIT"
	PRINT(CUST.TRADE.paymentnarrative)	

	
	CUST.TRADE.ErrorMessage=""
	
	######################################
	
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_q="TRAN_ID,TRAN_AMOUNT,CREATED_BY_ID,CDSC_NUMBERCLIENT|select TRAN_ID,TRAN_AMOUNT,CREATED_BY_ID,CDSC_NUMBER from custom.share_purchase_master where  trim(tran_id)=?SVAR AND rownum=1"	
	PRINT(sv_q)
	sv_d=urhk_dbSelectWithBind(sv_q)
	PRINT(BANCS.OUTPARAM.DB_ERRMSG)
	PRINT(BANCS.OUTPARAM.DB_ERRCODE)
	PRINT(sv_d)	
	
	if(sv_d==0) then
	#{
		
		sv_e=BANCS.OUTPARAM.TRAN_ID
		sv_e=TRIM(sv_e)
		PRINT(sv_e)
		sv_f=BANCS.OUTPARAM.TRAN_AMOUNT
		sv_f=TRIM(sv_f)
		PRINT(sv_f)
		sv_g=BANCS.OUTPARAM.CREATED_BY_ID
		
		###Some hardcoding
		##sv_g="AG01342"
		#############
		
		sv_g=TRIM(sv_g)
		PRINT(sv_g)
		sv_h=BANCS.OUTPARAM.CDSC_NUMBERCLIENT
		PRINT(sv_h)
		sv_h=TRIM(sv_h)
		sv_i=CUST.TRADE.paymentnarrative
		PRINT(sv_i)
		
		
		
		####Setting the message to be sent for funding an account
		
		CUST.TRADE.msg=CUST.TRADE.header+"body^=^FundAccount^|^opCode^=^1^|^Url^=^"+CUST.TRADE.URL+"^|^PaymentAmount^=^"+sv_f+"^|^PaymentRef^=^"+CUST.TRADE.paymentreference+"^|^PaymentNarative^=^"+sv_i+"^|^ChangedBy^=^"+sv_g+"^|^ClientCDSCNo^=^"+sv_h+"^|^"
		
		PRINT(CUST.TRADE.msg)
		
		
		#Setting the Service Name to FIJCA. This should not be changed.
		BANCS.INPARAM.SERVICE_NAME="FIJCA"
		#you can change the value of following flag to "R" if user needs the response back
		BANCS.INPARAM.SEND_RECV_FLG="R"
		
		
		###################### Setting the connection parameters END ######################
		
		#Calling the userhook to connect to FI
		sv_l=urhk_ConnectToFIAndSendMsg(CUST.TRADE.msg)
		print(sv_l)
		if(sv_l!=0) then
		#{
			if(BANCS.OUTPARAM.ErrMsg!="") then
			#{
				print("Error thrown from the user hook is ["+BANCS.OUTPARAM.ErrMsg+"]")
				
				CUST.TRADE.ErrorMessage="Database Error ocurred"
				BANCS.OUTPARAM.successOrFailure="F"
				GOTO EXITEXECUTION
			#}
			endif
		#}
		endif
		if(BANCS.OUTPARAM.RespMesg!="") then
		#{
			###Extractingthe code from the string
			
			CUST.TRADE.RespMessage=BANCS.OUTPARAM.RespMesg
			PRINT(CUST.TRADE.RespMessage)
			
			sv_y=CUST.TRADE.RespMessage
			sv_z=(GETPOSITION(sv_y,"RsMessage"))
			sv_y=MID$(sv_y,sv_z,13)
			#sMessage^=^0^
			sv_z=MID$(sv_y,11,1)
			PRINT(sv_z)
			####TODO exit if the funding could not happen
			if(sv_z!=1) then
			#{
				CUST.TRADE.ErrorMessage="Could not fund the account please Contact Custodial!"
				GOTO EXITEXECUTION
				
			#}
			endif
			
			if(sv_z==1) then
			#{
				##If the funding happened then  update the flag for sent to external system to 1
				
				###Updating the funding flag
				CUST.TRADE.funding="1"
				
				sv_q="update CUSTOM.SHARE_PURCHASE_MASTER set SENT_TO_EXT=1 where trim(tran_id)=?SVAR"
				
				BANCS.INPARAM.BINDVARS=CUST.TRADE.dc
				
				sv_q=urhk_dbSQLWithBind(sv_q)
				
				PRINT(sv_q)
				
				
				
			#}
			endif
			
			
			
			
		#}
		endif
		#}
		
	else
		#{
		
		CUST.TRADE.ErrorMessage="Database Error ocurred"
		BANCS.OUTPARAM.successOrFailure="F"
		GOTO EXITEXECUTION
		
	#}
	endif
	
	
	
	
	#######Selecting the count of the records
	
	
	sv_n="REC_COUNT|select count (*) as rec_count from CUSTOM.SHARE_PURCHASE_DETAILS where trim(foreign_key_tran_id)=?SVAR"
	
	
	sv_n=urhk_dbSelectWithBind(sv_n)
	
	
	print(sv_n)
	
	if(sv_n!=0) then
	#{
		##Exit if no records
		
		PRINT("There are no records for the Tran Id")
		CUST.TRADE.ErrorMessage="There are no records in details"
		goto EXITEXECUTION
		
		
		#}
	else
		#{
		
		##Set the repository field count
		
		CUST.TRADE.rec_count=BANCS.OUTPARAM.REC_COUNT
		PRINT(CUST.TRADE.rec_count)
		##########Getting the date in selected format
		
		sv_q="TRANDATE|select to_char(to_date(sysdate,'dd-Mon-YY')) as trandate from dual"
		
		sv_q=urhk_dbSelectWithBind(sv_q)
		
		if(sv_q==0) then
		#{
			CUST.TRADE.trandate=BANCS.OUTPARAM.TRANDATE
			PRINT(CUST.TRADE.trandate)
			
			###Setting the order contact
			CUST.TRADE.ordercontact="DC"+CUST.TRADE.dc+":"+CUST.TRADE.trandate
			
		#}
		endif
		
	#}
	endif
	
	
	
	
	
	######################STEP 1 Setting rep variables in a loop
	
	sv_n="TRAN_ID,TRAN_SOL_ID,CDSC_NUMBER,ACCOUNT_NUMBER,SECURITY_CODE,NO_OF_SHARES,ASKING_PRICE,CREATED_BY_ID,VERIFIED_BY_ID|select m.TRAN_ID,m.TRAN_SOL_ID,m.CDSC_NUMBER,m.ACCOUNT_NUMBER,d.SECURITY_CODE,d.NO_OF_SHARES,D.ASKING_PRICE,m.CREATED_BY_ID,M.VERIFIED_BY_ID from CUSTOM.SHARE_PURCHASE_MASTER m,CUSTOM.SHARE_PURCHASE_DETAILS d where M.TRAN_ID=D.FOREIGN_KEY_TRAN_ID and trim(m.TRAN_ID)=?SVAR"
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_n)
	
	sv_n=urhk_dbCursorOpenWithBind(sv_n)
	PRINT(sv_n)	
	
	sv_m=BANCS.OUTPARAM.DB_CURSOR_NUMBER	
	
	
	
	if(sv_n!=0) then
	#{
		##Exit if the record fetch could not happen
		PRINT("There are no records for the tran Id")		
		sv_o=urhk_dbCursorClose(sv_m)
		
		
		#}
	else
		#{
		
		##Set rep variables
		
		##Setting the tran id	
		
		
		PRINT(sv_m)		
		
		sv_n=CINT(CUST.TRADE.rec_count)
		
		PRINT(sv_n)
		
		###Initializing the counter
		
		CUST.TRADE.counter="0"
		
		while(CINT(CUST.TRADE.counter)<sv_n)
		#{
			
			sv_a=urhk_dbCursorFetch(sv_m)
			PRINT(sv_a)
			PRINT(CUST.TRADE.counter)			
			
			
			
			
			("CUST").("TRADE").("tranid")=TRIM(BANCS.OUTPARAM.TRAN_ID)
			PRINT(CUST.TRADE.tranid)
			("CUST").("TRADE").("solid")=TRIM(BANCS.OUTPARAM.TRAN_SOL_ID)
			PRINT(CUST.TRADE.solid)
			("CUST").("TRADE").("cdscid")=TRIM(BANCS.OUTPARAM.CDSC_NUMBER)
			PRINT(CUST.TRADE.cdscid)
			("CUST").("TRADE").("acid")=TRIM(BANCS.OUTPARAM.ACCOUNT_NUMBER)
			PRINT(CUST.TRADE.acid)
			
			
			sv_u="secid_"+CUST.TRADE.counter
			PRINT(sv_u)
			("CUST").("TRADE").(sv_u)=TRIM(BANCS.OUTPARAM.SECURITY_CODE)
			PRINT(("CUST").("TRADE").(sv_u))
			
			
			
			sv_u="shareno_"+CUST.TRADE.counter
			PRINT(sv_u)
			("CUST").("TRADE").(sv_u)=TRIM(BANCS.OUTPARAM.NO_OF_SHARES)
			PRINT(("CUST").("TRADE").(sv_u))
			
			
			
			sv_u="askingprice_"+CUST.TRADE.counter
			("CUST").("TRADE").(sv_u)=TRIM(BANCS.OUTPARAM.ASKING_PRICE)
			PRINT(("CUST").("TRADE").(sv_u))
			
			
			
			
			("CUST").("TRADE").("createdby")=TRIM(BANCS.OUTPARAM.CREATED_BY_ID)
			PRINT(CUST.TRADE.createdby)
			
			
			######Some hardcoding
			######("CUST").("TRADE").("createdby")="AG01342"
			##################
			
			
			
			("CUST").("TRADE").("verifiedby")=TRIM(BANCS.OUTPARAM.VERIFIED_BY_ID)
			
			
			########Some hardcoding
			##sv_u="GN00418"
			("CUST").("TRADE").("verifiedby")=BANCS.STDIN.userId
			##############
			PRINT(CUST.TRADE.verifiedby)
			
			
			CUST.TRADE.counter=CINT(CUST.TRADE.counter)+1
			
			PRINT(CUST.TRADE.counter)
			
		#}
		do
		
		sv_m=urhk_dbCursorClose(sv_m)
		
	#}
	endif
	
	
	
	#########################STEP 2  Iterating over the repository fields and sending to FI
	
	sv_n=CINT(CUST.TRADE.rec_count)
	
	PRINT(sv_n)
	
	CUST.TRADE.counter="0"
	
	while(CINT(CUST.TRADE.counter)<sv_n)
	#{
		
	  
	  PRINT(CUST.TRADE.counter)
	  PRINT(sv_n)
	  print(CUST.TRADE.URL)
	  print(CUST.TRADE.solid)
	  
	  ###Forming the security id field
	  sv_u="secid_"+CUST.TRADE.counter
	  PRINT(("CUST").("TRADE").(sv_u))
	  CUST.TRADE.securityid2=("CUST").("TRADE").(sv_u)
	  
	  ####Forming the number of shares field
	  sv_u="shareno_"+CUST.TRADE.counter
	  PRINT(("CUST").("TRADE").(sv_u))
	  CUST.TRADE.noshares2=("CUST").("TRADE").(sv_u)
	  
	  #####Forming the asking price
	  sv_u="askingprice_"+CUST.TRADE.counter
	  PRINT(("CUST").("TRADE").(sv_u))
	  CUST.TRADE.askingprice2=("CUST").("TRADE").(sv_u)	
	  
	  
	  CUST.TRADE.msg=CUST.TRADE.header+"body^=^CreateOrder^|^opCode^=^2^|^Url^=^"+CUST.TRADE.URL+"^|^BranchCode^=^"+CUST.TRADE.solid+"^|^ClientCDSCNo^=^"+CUST.TRADE.cdscid+"^|^OrderType^=^"+CUST.TRADE.ordType+"^|^userName^=^"+CUST.TRADE.createdby+"^|^OrderQuantity^=^"+CUST.TRADE.noshares2+"^|^OrderPrice^=^"+CUST.TRADE.askingprice2+"^|^SecurityId^=^"+CUST.TRADE.securityid2+"^|^OrderRef^=^"+BANCS.STDIN.homeSolId+"/"+CUST.TRADE.tranid+"/"+CUST.TRADE.counter+"^|^ApprovedBy^=^"+CUST.TRADE.verifiedby+"^|^OrderContact^=^"+CUST.TRADE.tranid+":"+CUST.TRADE.trandate
		
	  PRINT(CUST.TRADE.msg)
	  
	  #Calling the userhook to connect to FI
	  sv_x=urhk_ConnectToFIAndSendMsg(CUST.TRADE.msg)
	  PRINT(sv_x)
	  if(sv_x!=0) then
		#{
			if(BANCS.OUTPARAM.ErrMsg!="") then
			#{
				print("Error thrown from the user hook in create order is ["+BANCS.OUTPARAM.ErrMsg+"]")
				CUST.TRADE.ErrorMessage=BANCS.OUTPARAM.ErrMsg				
				GOTO EXITEXECUTION
				
			#}
			endif
			
		#}
		endif
	  	
	  	if(BANCS.OUTPARAM.RespMesg!="") then
		#{
			PRINT(BANCS.OUTPARAM.RespMesg)
			
			###Parsing the response string
			
			sv_y=BANCS.OUTPARAM.RespMesg
			sv_z=(GETPOSITION(sv_y,"RsMessage"))
			sv_y=MID$(sv_y,sv_z,13)
			PRINT(sv_y)
			#sMessage^=^0^
			sv_z=MID$(sv_y,11,1)
			PRINT(sv_z)
			####TODO exit if the creation of the order could not happen
			if(sv_z!=1) then
			#{
				
				##If funding happened
				sv_x=" "
				if(CUST.TRADE.funding=="1") then
				#{
					sv_x="Funding Ok, Order not created, Contact Custodial!"
					
					
				#}
				endif
				CUST.TRADE.ErrorMessage="There was an error creating the order in custodiknow "+sv_x				
				#GOTO EXITEXECUTION
				
			#}
			endif
			
		#}
		endif
		
	
	  CUST.TRADE.counter=CINT(CUST.TRADE.counter)+1	
		
	#}
	do
	
		
	
	
EXITEXECUTION:		
		
		
trace off
end-->
