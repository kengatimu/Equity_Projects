	#  Validation For No. Of Cheque Leaves Required Field
	#              1) Only values 50 or 100 are accepted
	#---------------------------------------------------------------------------------
	IF (fieldexists(CUST.CHQB.leaves)) THEN
	#{
		IF(trim(CUST.CHQB.leaves) == "") THEN
		#{
			sv_e = "Please Enter No. leaves per Cheque Book Required"
			sv_m = "leaves"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
