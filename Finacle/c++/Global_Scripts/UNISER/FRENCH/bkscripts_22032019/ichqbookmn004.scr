		sv_s = sv_s + " FROM CUSTOM.C_ICBM "
		sv_s = sv_s + " WHERE foracid = ?SVAR "
		sv_s = sv_s + " AND req_status != 'D' "
		sv_s = sv_s + " AND inst_type = ?SVAR "
		#sv_s = sv_s + " AND inst_type is null "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + CUST.CHQB.instType + "|" + BANCS.STDIN.contextBankId
		#BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.lastSrlNum = BANCS.OUTPARAM.lastSrlNum
			print(CUST.CHQB.lastSrlNum)
		#}
		ENDIF
		
		sv_s = "bcChqNo "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT NVL(MAX(TO_NUMBER(NVL(C_CBT.begin_chq_num,0)) + C_CBT.chq_num_of_lvs),1) "
		sv_s = sv_s + " FROM CUSTOM.C_CBT,TBAADM.GAM "
		sv_s = sv_s + " WHERE GAM.foracid = ?SVAR "
		sv_s = sv_s + " AND GAM.acid = C_CBT.acid "
		sv_s = sv_s + " AND inst_type = ?SVAR "
		#sv_s = sv_s + " AND inst_type is null "
		sv_s = sv_s + " AND GAM.bank_id = C_CBT.bank_id "
		sv_s = sv_s + " AND TO_NUMBER(NVL(C_CBT.begin_chq_num,0)) < ?SVAR "
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + CUST.CHQB.instType + "|" + CUST.CHQB.chqNo + "|" + BANCS.STDIN.contextBankId
		#	BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + CUST.CHQB.chqNo + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.bcChqNo = BANCS.OUTPARAM.bcChqNo
			print(CUST.CHQB.bcChqNo)
		#}
		ENDIF
		print(CUST.CHQB.lastSrlNum)
		
		IF (CUST.CHQB.lastSrlNum > CUST.CHQB.bcChqNo ) THEN
		#{
			CUST.CHQB.srlNum = CUST.CHQB.lastSrlNum
			#}
		ELSE
			#{
			CUST.CHQB.srlNum = CUST.CHQB.bcChqNo
		#}
		ENDIF
		print(CUST.CHQB.srlNum)
		
		#---------------------------------------------------------------
		# Status and end chq no and instr type validation
		#---------------------------------------------------------------
		#	IF (CUST.CHQB.instType  == "") THEN
		#{
		#		sv_e = "Please Enter a valid instrument type."
		#		sv_m = "instType"
		#		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		#		sv_u = urhk_SetOrbOut(sv_e)
		#		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		#		GOTO ENDOFSCRIPT
		#}
		#	ENDIF
		
		#****************************************************************************
		# Select the next value for the Req Id from the sequence generated by ChqBookReq_Seq
		#****************************************************************************
		sv_s = "reqestId "
		sv_s = sv_s + "|"
		sv_s = sv_s + " SELECT CUSTOM.IChqBookReq_Seq_" + BANCS.STDIN.contextBankId + ".nextval "
		sv_s = sv_s + " FROM DUAL "
		print(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.reqestId = BANCS.OUTPARAM.reqestId
			print(CUST.CHQB.reqestId)
		#}
		ENDIF
		
		sv_s = "INSERT INTO CUSTOM.C_ICBM "
		#sv_s = sv_s + "("
		#sv_s = sv_s + " request_id,"
		#sv_s = sv_s + " acct_num, "
		#sv_s = sv_s + " sol_id , "
		#sv_s = sv_s + " inst_type, "
		#sv_s = sv_s + " start_srl_num , "
		#sv_s = sv_s + " no_of_chqbook, "
		#sv_s = sv_s + " no_of_chkleaves, "
		#sv_s = sv_s + " , "
		#sv_s = sv_s + " status, "
		#sv_s = sv_s + " date, "
		#sv_s = sv_s + " ,"
		#sv_s = sv_s + " ,"
		#sv_s = sv_s + " rcre_user_id,"
		#sv_s = sv_s + " rcre_time, "
		#sv_s = sv_s + " lchg_user_id, "
		#sv_s = sv_s + " lchg_timw, "
		#sv_s = sv_s + " , "
		#sv_s = sv_s + " bank_id "
		#sv_s = sv_s + " ) "
		sv_s = sv_s + " VALUES "
		sv_s = sv_s + " ( "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " '', "
		sv_s = sv_s + " 'E', "
		sv_s = sv_s + " to_date(?SVAR,'DD-MM-YYYY'), "
		sv_s = sv_s + " '', "
		sv_s = sv_s + " '', "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'), "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'), "
		sv_s = sv_s + " 'N', "
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " '',"
		sv_s = sv_s + "?SVAR"
		sv_s = sv_s + " ) "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.reqestId + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.mySolId + "|" + CUST.CHQB.srlNum + "|" + CUST.CHQB.noOfChq + "|" + CUST.CHQB.leaves + "|" + mid$(BANCS.STDIN.BODDate,0,10) +"|"+ BANCS.STDIN.userId  + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" +  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.instType
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			print(sv_d)
			sv_u = urhk_SetOrbOut("RESULT_MSG|Request Recorded Successfully . Request Id is " + CUST.CHQB.reqestId)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT :
		TRACE OFF
