				print(CUST.CHQB.FORACID)
				print(CUST.CHQB.BRANCH_ID)
				print(CUST.CHQB.INST_TYPE)
				print(CUST.CHQB.BEGIN_CHQ_NUM)
				print(CUST.CHQB.NUM_OF_CHB)
				print(CUST.CHQB.NUM_OF_CHQ_LVS)
				print(CUST.CHQB.AUTH_USER_ID)
				
