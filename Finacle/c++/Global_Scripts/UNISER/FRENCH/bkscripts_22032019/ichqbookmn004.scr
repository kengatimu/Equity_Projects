				CUST.CHQB.FORACID = BANCS.OUTPARAM.FORACID
				CUST.CHQB.BRANCH_ID = BANCS.OUTPARAM.BRANCH_ID
				CUST.CHQB.INST_TYPE = BANCS.OUTPARAM.INST_TYPE
				CUST.CHQB.BEGIN_CHQ_NUM = BANCS.OUTPARAM.BEGIN_CHQ_NUM
				CUST.CHQB.NUM_OF_CHB = BANCS.OUTPARAM.NUM_OF_CHB
				CUST.CHQB.NUM_OF_CHQ_LVS = BANCS.OUTPARAM.NUM_OF_CHQ_LVS
