			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		# -------------------------------------------------------------------------------
		# Insert into C_CBT table
		# -------------------------------------------------------------------------------
		
		sv_x = "FORACID,BRANCH_ID,INST_TYPE,BEGIN_CHQ_NUM,NUM_OF_CHB,NUM_OF_CHQ_LVS,AUTH_USER_ID|"
		sv_x = sv_x + "select FORACID,BRANCH_ID,INST_TYPE,BEGIN_CHQ_NUM,NUM_OF_CHB,NUM_OF_CHQ_LVS,AUTH_USER_ID"
		sv_x = sv_x + " FROM CUSTOM.C_ICBM WHERE "
		sv_x = sv_x + " REQ_STATUS='S' "
		sv_x = sv_x + " AND DEL_FLG!='Y' "
		sv_x = sv_x + " AND FORACID= ?SVAR "
		sv_x = sv_x + " AND bank_id = ?SVAR "
		
