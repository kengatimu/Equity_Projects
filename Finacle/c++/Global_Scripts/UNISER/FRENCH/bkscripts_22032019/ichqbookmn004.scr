		#}
	ELSE
		#{
		sv_e = "ChqNO setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_p = urhk_B2k_PID("")
	IF(sv_p == 0 ) THEN
	#{
		CUST.CHQB.pid = TRIM(BANCS.OUTPARAM.PID)
		print(CUST.CHQB.pid)
		#}
	ELSE
		#{
		CUST.CHQB.pid = "123"
		print(CUST.CHQB.pid)
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# Check if directory exists and create
	#---------------------------------------------------------------------------------
	sv_p = system("test -d ${UPLOAD_INPUT_FILE_PATH}/"+ BANCS.STDIN.userId)
	IF(sv_p != 0 ) THEN
	#{
		sv_p = system("mkdir ${UPLOAD_INPUT_FILE_PATH}"+ BANCS.STDIN.userId)
		print(sv_p)
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# check if account no filed is blank.
	#---------------------------------------------------------------------------------
	CUST.CHQB.function 	= BANCS.INPUT.funcCode
	CUST.CHQB.requestId1     = BANCS.INPUT.requestId1
	CUST.CHQB.acctNum   = BANCS.INPUT.acctNo
	CUST.CHQB.noOfChq   = BANCS.INPUT.noOfChqs
	CUST.CHQB.leaves    = BANCS.INPUT.leaves
	CUST.CHQB.chqStartSrlNum    = BANCS.INPUT.startChqNo
	CUST.CHQB.chqEndSrlNum      = BANCS.INPUT.endChqNo
	#CUST.CHQB.chqEndSrlNum      = 25
	CUST.CHQB.reqStatus = BANCS.INPUT.reqStat
	CUST.CHQB.instType = BANCS.INPUT.instType
	
	#---------------------------------------------------------------------------------
	# For Delete operation.
	#---------------------------------------------------------------------------------
	
	IF (CUST.CHQB.function == "D") THEN
	#{
		IF (CUST.CHQB.reqStatus == "D") THEN
		#{
			sv_u = urhk_SetOrbOut("RESULT_MSG|Request has been authorized/Deleted, So can not be deleted")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF( CUST.CHQB.reqStatus == "E" ) THEN
		#{
			sv_s = "UPDATE CUSTOM.C_ICBM "
			sv_s = sv_s + " SET lchg_user_id = ?SVAR, "
			sv_s = sv_s + " lchg_time = TO_DATE(?SVAR,'DD-MM-YYYY'), "
			sv_s = sv_s + " req_status = 'D' "
			sv_s = sv_s + " WHERE req_id = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + MID$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.CHQB.requestId1 + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSQLWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0 ) THEN
			#{
				sv_d = urhk_dbSQLWithBind("COMMIT")
				print(sv_d)
				#}
			ELSE
				#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_u = urhk_SetOrbOut("RESULT_MSG|Request has been deleted")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#**************************************************************************************
	# Entered Option is 'V' i.e Authorizing a request that has been lodged
	#**************************************************************************************
	IF ( CUST.CHQB.function == "V" ) THEN
	#{
		sv_s = "chqBook,chqLeaves,reqStatus,foracid,beginNum,rcreId,instType "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT num_of_chb,num_of_chq_lvs,req_status,foracid,begin_chq_num,rcre_user_id,inst_type "
		sv_s = sv_s + " FROM CUSTOM.C_ICBM "
		sv_s = sv_s + " WHERE req_id = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.requestId1 +"|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.chqBook = BANCS.OUTPARAM.chqBook
			print(CUST.CHQB.chqBook)
			CUST.CHQB.chqLeaves = BANCS.OUTPARAM.chqLeaves
			print(CUST.CHQB.chqLeaves)
			CUST.CHQB.reqStatus = BANCS.OUTPARAM.reqStatus
			print(CUST.CHQB.reqStatus)
			CUST.CHQB.foracid = BANCS.OUTPARAM.foracid
			print(CUST.CHQB.foracid)
			CUST.CHQB.beginNum = BANCS.OUTPARAM.beginNum
			print(CUST.CHQB.beginNum)
			CUST.CHQB.rcreId = BANCS.OUTPARAM.rcreId
			print(CUST.CHQB.rcreId)
			CUST.CHQB.instTypw = BANCS.OUTPARAM.instType
			print(CUST.CHQB.instTypw)
		#}
		ENDIF
		
		IF(TRIM(CUST.CHQB.beginNum) != "" ) THEN
		#{
			CUST.CHQB.chqEndNo = CINT(CUST.CHQB.beginNum) + CINT(CUST.CHQB.chqBook) + CINT(CUST.CHQB.chqLeaves) - 1
		#}
		ENDIF
		
		#******************************************************************************************************
		#  Check IF the authorizers work class is the same or greater than or equal to the customers class.
		#******************************************************************************************************
		
		sv_s = " rcreclass "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT user_work_class "
		sv_s = sv_s + " FROM TBAADM.UPR "
		sv_s = sv_s + " WHERE user_id = ?SVAR "
		sv_s = sv_s + " AND del_flg != 'Y' "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.rcreId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbselectWIthBind(sv_s)
		IF (sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.rcreclass = BANCS.OUTPARAM.rcreclass
			print(CUST.CHQB.rcreclass)
		#}
		ENDIF
		
		CUST.CHQB.authClass = BANCS.STDIN.userWorkClass
		
		IF(CUST.CHQB.authClass >= CUST.CHQB.rcreclass) THEN
		#{
			IF((CUST.CHQB.reqStatus == "E")) THEN
			#{
				#*****************************************************************************
				# Check for the user cannot authorize his own account
				#******************************************************************************
				
				IF (trim(BANCS.STDIN.userId) == trim(CUST.CHQB.rcreId)) THEN
				#{
					sv_e = "Cannot authorize your own request."
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					#******************************************************************************
					# Update the request status value to "A" in C_ICBM table to mark it as authorized.
					#******************************************************************************
					IF(CUST.CHQB.chqLeaves == 1) THEN
					#{
						CUST.CHQB.status = "S"
						#}
					ELSE
						#{
						CUST.CHQB.status = "A"
					#}
					ENDIF
					
					sv_s = "UPDATE CUSTOM.C_ICBM "
					sv_s = sv_s + " SET auth_user_id = ?SVAR, "
					sv_s = sv_s + " lchg_user_id = ?SVAR, "
					sv_s = sv_s + " lchg_time = TO_DATE(?SVAR,'DD-MM-YYYY'), "
					sv_s = sv_s + " req_status = ?SVAR "
					sv_s = sv_s + " WHERE req_id = ?SVAR "
					sv_s = sv_s + " AND bank_id = ?SVAR "
					print(sv_s)
					
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + BANCS.STDIN.userId  + "|"  + MID$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.CHQB.status + "|" +  CUST.CHQB.requestId1 +"|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					print(sv_d)
					
					IF(sv_d != 0 ) THEN
					#{
						sv_e = "A Database error has occured. Please contact your DBA."
						sv_m = "count"
						sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						sv_d = urhk_dbSQLWithBind("COMMIT")
						print(sv_d)
						sv_u = urhk_SetOrbOut("RESULT_MSG|Request has been authorized")
						sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_u = urhk_SetOrbOut("RESULT_MSG|Request has already been authorized/Deleted")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("RESULT_MSG|Authorizer work class should be greater than OR equal to record created user work class")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	IF (fieldexists(CUST.CHQB.acctNum)) THEN
	#{
		
		IF (TRIM(CUST.CHQB.acctNum) == "") THEN
		#{
			sv_e = "Please enter account no"
			sv_m = "acctNo"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_x = "ValidateAccout|Select count(*) from tbaadm.gam where foracid = ?SVAR "
			sv_x = sv_x + " AND schm_type = 'SBA' AND entity_cre_flg = 'Y' AND del_flg !='Y' AND acct_cls_flg !='Y'"
			sv_x = sv_x + " AND bank_id = ?SVAR "
			print(sv_x)
			BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum   + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_x = urhk_dbSelectWithBind(sv_x)
			print(sv_x)
			IF (sv_x != 0 ) THEN
			#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.CHQB.valAcct = BANCS.OUTPARAM.ValidateAccout
				print(BANCS.OUTPARAM.ValidateAccout)
			#}
			ENDIF
			
			
			IF (CUST.CHQB.valAcct <= 0) THEN
			#{
				sv_e = "Incorrect Account No. / Accounts of schm other than SBA are not allowed"
				sv_m = "acctNo"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = urhk_getAcctDetailsInRepository(CUST.CHQB.acctNum)
			PRINT(sv_a)
			PRINT(BANCS.OUTPARAM.freezeCode)
			IF (sv_a == 0) THEN
			#{
				print(BANCS.OUTPARAM.freezeCode)
				IF (BANCS.OUTPARAM.freezeCode != " ") THEN
				#{
					sv_e = "Frozen Account ,Cheque Book request cannot be processed"
					sv_m = "acctNo"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				print(BANCS.STDIN.mySolId)
				print(BANCS.OUTPARAM.acctSolId)
				print(BANCS.OUTPARAM.schmCode)
				CUST.CHQB.schmCode = BANCS.OUTPARAM.schmCode
				PRINT(CUST.CHQB.schmCode)
				CUST.CHQB.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
				PRINT(CUST.CHQB.EffAvailableAmt)
				
				IF (BANCS.STDIN.mySolId != BANCS.OUTPARAM.acctSolId) THEN
				#{
					sv_e = "Account belongs to different SOL"
					sv_m = "acctNo"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				IF ((CUST.CHQB.schmCode == CUST.CHQB.schmCode6) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode7)) THEN
				#{
					sv_e = "Chq Book issue is not Allowed for this scheme"
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			IF(CUST.CHQB.function == "U" ) THEN
			#{
				sv_x = "MinBal|Select min_bal_for_chq_book from ssp where schm_code = ?SVAR "
				sv_x = sv_x + " AND crncy_code = ?SVAR AND del_flg !='Y'"
				sv_x = sv_x + " AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.CHQB.schmCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
				sv_x = urhk_dbselectWithBind(sv_x)
				
				IF (sv_x != 0 ) THEN
				#{
					sv_e = "A Database error has occured. Please contact your DBA."
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				print(BANCS.OUTPARAM.MinBal)
				
				IF (cdouble(CUST.CHQB.EffAvailableAmt) < cdouble(BANCS.OUTPARAM.MinBal)) THEN
				#{
					sv_e = "Account Balance is not sufficient to issue the Chq Book"
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			sv_x = "ACCT_STATUS|Select ACCT_STATUS from tbaadm.SMT where acid = (select acid from tbaadm.gam where foracid= ?SVAR AND bank_id = ?SVAR)"
			sv_x = sv_x + " AND smt.bank_id = ?SVAR "
			print(sv_x)
			BANCS.INPARAM.BINDVARS =  CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_x = urhk_dbSelectWithBind(sv_x)
			PRINT(sv_x)
			
			IF (sv_x != 0 ) THEN
			#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
