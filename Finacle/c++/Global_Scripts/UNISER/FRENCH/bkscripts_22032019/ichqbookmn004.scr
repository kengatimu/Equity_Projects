					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				
				
				sv_x = "ValidateStart|SELECT NVL(COUNT(*),0) FROM CUSTOM.C_ICBM WHERE "
				sv_x = sv_x + " (BEGIN_CHQ_NUM + (NUM_OF_CHB * NUM_OF_CHQ_LVS)) >= ?SVAR "
				sv_x = sv_x + " AND FORACID = ?SVAR "
				sv_x = sv_x + " AND REQ_STATUS = 'S'"
				sv_x = sv_x + " AND NUM_OF_CHQ_LVS = ?SVAR "
				sv_x = sv_x + " AND BANK_ID =?SVAR "
				print(sv_x)
				BANCS.INPARAM.BINDVARS =  CUST.CHQB.start_srl_no  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves + "|" + BANCS.STDIN.contextBankId
				#        		BANCS.INPARAM.BINDVARS =  CUST.CHQB.chqStartSrlNum  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves + "|" + BANCS.STDIN.contextBankId
				#       		BANCS.INPARAM.BINDVARS =  CUST.CHQB.chqStartSrlNum  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_x = urhk_dbSelectWithBind(sv_x)
				PRINT(sv_x)
				CUST.CHQB.ValidateStart=BANCS.OUTPARAM.ValidateStart
				PRINT(CUST.CHQB.ValidateStart)
				
				sv_z = "ValidateEnd|SELECT NVL(COUNT(*),0) FROM CUSTOM.C_ICBM WHERE "
				sv_z = sv_z + " (BEGIN_CHQ_NUM + (NUM_OF_CHB * NUM_OF_CHQ_LVS)) >= ?SVAR "
				sv_z = sv_z + " AND FORACID = ?SVAR "
				sv_z = sv_z + " AND REQ_STATUS = 'S'"
				sv_z = sv_z + " AND NUM_OF_CHQ_LVS = ?SVAR "
				sv_z = sv_z + " AND bank_id = ?SVAR "
				print(sv_z)
				BANCS.INPARAM.BINDVARS =  CUST.CHQB.END_srl_no  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves + "|" + BANCS.STDIN.contextBankId
				#        		BANCS.INPARAM.BINDVARS =  CUST.CHQB.chqEndSrlNum  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves + "|" + BANCS.STDIN.contextBankId
				#       		BANCS.INPARAM.BINDVARS =  CUST.CHQB.chqEndSrlNum  + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.leaves
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_z = urhk_dbSelectWithBind(sv_z)
				PRINT(sv_z)
				CUST.CHQB.ValidateEnd=BANCS.OUTPARAM.ValidateEnd
				PRINT(CUST.CHQB.ValidateEnd)
				
				IF ((sv_x != 0) OR (sv_z != 0)) THEN
