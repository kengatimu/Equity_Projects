					sv_e = "A Database error has occured. Please contact your DBA."
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				IF ((CUST.CHQB.ValidateStart == 0 ) OR (CUST.CHQB.ValidateEnd == 0)) THEN
				#{
					sv_e = "No. of Cheque Books/Leaves Does not match with request entered"
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				sv_x = "crncyCode|SELECT ACCT_CRNCY_CODE FROM TBAADM.GAM WHERE FORACID =?SVAR "
				print(sv_x)
