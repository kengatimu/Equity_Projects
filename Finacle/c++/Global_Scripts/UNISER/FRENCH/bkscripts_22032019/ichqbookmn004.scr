	#{
		CUST.CHQB.AmountTableCode = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_e = "ChqNO setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
