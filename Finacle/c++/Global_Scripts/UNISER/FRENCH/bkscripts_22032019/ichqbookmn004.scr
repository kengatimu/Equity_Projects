	ENDIF
	
	
	#**************************************************************************************
	# Entered Option is 'U'
	#**************************************************************************************
	
	IF ( CUST.CHQB.function == "U" ) THEN
	#{
		sv_s = "srlNo "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT NVL(MAX(TO_NUMBER(NVL(CBT.begin_chq_num,0)) + CBT.chq_num_of_lvs),1) "
		sv_s = sv_s + " FROM CUSTOM.C_CBT CBT,TBAADM.GAM "
