<--START
CHECKSUM="202c22ea98a5d8852b079499a01215fd111c6aeee85847bac646e9f1486aeb1a"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","CSHDCHR") == 0) THEN
	#{
		CREATECLASS("CUST","CSHDCHR",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM", 5)
	#}
	ENDIF
	#------------------------------------------
	# Initizilising the Variables
	#------------------------------------------
	CUST.CSHDCHR.errMsg 	= ""
	CUST.CSHDCHR.partSrlNo 	= "0"
	CUST.CSHDCHR.refAmtCr	= "0"
	
	sv_l = LEFT$(BANCS.STDIN.BODDate,10)
	CUST.CSHDCHR.year = MID$(sv_l,6,4)
	PRINT(CUST.CSHDCHR.year)
	
	#------------------------------------------------------------------------------
	# Getting NORRATECODE values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.refCode)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "NORRATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_BACID values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "CSHD_CHRGS"
	BANCS.INPUT.parameterId = "CSHDCHR_BACID"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.bacid1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.bacid1)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Bacid "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_TRXNS values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_TRXNS"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.trxns = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.trxns)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Transaction"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_RMKS values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_RMKS"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.tranRmks = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tranRmks)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Remark "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_PART values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_PART"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.tranpart = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tranpart)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Particular "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_PART1 values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_PART1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.tranpart1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tranpart1)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Particular1 "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_SMCD values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_SMCD"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.schmCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.schmCode)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for SchmCode"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_AMT values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_AMT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.inpAmt = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.inpAmt)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Amount "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_AMT1 values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_AMT1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.inpAmt1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.inpAmt1)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Amount1 "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_TBE values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_TBE"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.amtTblecde = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.amtTblecde)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Amount Table Code "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting CSHDCHR_TBE1 values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "CSHDCHR_TBE1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.amtTblecde1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.amtTblecde1)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "CPARAM setup not done for Amount Table Code1 "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting total number of accounts from C_SJA where num_dr_trxns > 4
	# if the count is 0 then exiting
	#--------------------------------------------------------------------------
	sv_s = "cSjaCount|"
	sv_s = sv_s + " SELECT COUNT(1) "
	sv_s = sv_s + " FROM CUSTOM.C_SJA "
	sv_s = sv_s + " WHERE C_SJA.sol_id= ?SVAR"
	sv_s = sv_s + " AND C_SJA.tran_year= ?SVAR"
	sv_s = sv_s + " AND C_SJA.num_dr_trxns > ?SVAR"
	sv_s = sv_s + " AND C_SJA.del_flg='N' "
	sv_s = sv_s + " AND C_SJA.bank_id = ?SVAR"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId  + "|"
	BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + CUST.CSHDCHR.year +"|"
	BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + CUST.CPARAM.trxns + "|"
	BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.CSHDCHR.cSjaCount = BANCS.OUTPARAM.cSjaCount
		PRINT(CUST.CSHDCHR.cSjaCount)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg ="Error in finding count of records"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CINT(CUST.CSHDCHR.cSjaCount)== 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting accounts from C_SJA where num_dr_trxns > 4
	#--------------------------------------------------------------------------
	sv_s = "foracid,sol_id,tran_year,numDrTrxns|"
	sv_s = sv_s + " SELECT C_SJA.foracid,C_SJA.sol_id,C_SJA.tran_year,C_SJA.num_dr_trxns "
	sv_s = sv_s + " FROM CUSTOM.C_SJA "
	sv_s = sv_s + " WHERE C_SJA.sol_id= ?SVAR"
	sv_s = sv_s + " AND C_SJA.tran_year= ?SVAR"
	sv_s = sv_s + " AND C_SJA.num_dr_trxns > ?SVAR"
	sv_s = sv_s + " AND C_SJA.del_flg='N'"
	sv_s = sv_s + " AND C_SJA.bank_id = ?SVAR"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId  + "|"
	BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + CUST.CSHDCHR.year +"|"
	BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + CUST.CPARAM.trxns + "|"
	BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	IF (sv_c == 0) THEN
	#{
		CUST.CSHDCHR.DB_CURSOR_NUMBER =BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.CSHDCHR.DB_CURSOR_NUMBER)
		#}
	ELSE
		#{
		CUST.CSHDCHR.errMsg = "Error in opening cursor"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------------------
	# Getting an Account from BACID
	#-----------------------------------------------------------------
	sv_i = CUST.CPARAM.bacid1 +"|"+BANCS.STDIN.homeCrncyCode +"|"+ BANCS.STDIN.mySolId
	sv_u = urhk_B2k_BacidToAcctId(sv_i)
	IF (sv_u == 1 ) THEN
	#{
		CUST.CSHDCHR.errMsg = "Error in finding account id for given bacid: "+ CUST.CPARAM.bacid1
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CSHDCHR.AcctIBacid = BANCS.OUTPARAM.AcctId
	PRINT(CUST.CSHDCHR.AcctIBacid)
	
	#---------------------------------------------------------------
	# Passing transaction inputs to the service
	# Adding AND Posting the transaction
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_u = urhk_SetUrhkInp("tranDtl.remarks|"+CUST.CPARAM.tranRmks)
	
	#--------------------------------------------------------------------------
	# Consolidated credit to the Income Account.
	#--------------------------------------------------------------------------
	WHILE (sv_c == 0)
	#{
		sv_c = urhk_dbCursorFetch(CUST.CSHDCHR.DB_CURSOR_NUMBER)
		PRINT(sv_c)
		
		IF (sv_c != 0) THEN
		#{
			sv_c = urhk_dbCursorClose(CUST.CSHDCHR.DB_CURSOR_NUMBER)
			PRINT(sv_c)
			sv_c = 1
			
			#--------------------------------------------------
			# Income Account credit part transaction(cshwith chrg)
			#--------------------------------------------------
			CUST.CSHDCHR.partSrlNo = CINT(CUST.CSHDCHR.partSrlNo) + 1
			PRINT(CUST.CSHDCHR.partSrlNo)
			CUST.CSHDCHR.recVal=FORMAT$(CINT(CUST.CSHDCHR.partSrlNo) - 1,"%d")
			PRINT(CUST.CSHDCHR.recVal)
			sv_b = "tranDtl.partTranDetailLL.<rec_"+CUST.CSHDCHR.recVal+">."
			PRINT(sv_b)
			sv_u = urhk_SetUrhkInp(sv_b + "key.serial_num|"+CUST.CSHDCHR.partSrlNo)
			sv_u = urhk_SetUrhkInp(sv_b + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "partTranType.code|C")
			sv_u = urhk_SetUrhkInp(sv_b + "acctId.foracid|"+CUST.CSHDCHR.AcctIBacid)
			sv_u = urhk_SetUrhkInp(sv_b + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "tranAmt|"+CUST.CSHDCHR.refAmtCr+"|"+ BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "tranParticulars|"+CUST.CPARAM.tranpart)
			sv_u = urhk_SetUrhkInp(sv_b + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "refAmt|"+CUST.CSHDCHR.refAmtCr+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_b + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_b + "rateCode.refCode|" + CUST.CPARAM.refCode)
			
			#-------------------------------------------------------------------------
			#--Adding  the tansaction
			#-------------------------------------------------------------------------
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_AddTransferTran|retain_all_output = Y")
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_AddTransferTran|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
			
			IF (sv_u == 0) THEN
			#{
				IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
				#{
					CUST.CSHDCHR.tranId = BANCS.OUTPARAM.tranId
					CUST.CSHDCHR.tranDate = BANCS.OUTPARAM.tranDate
					PRINT(CUST.CSHDCHR.tranId)
					PRINT(CUST.CSHDCHR.tranDate)
				#}
				ENDIF
				
				#############################################################
				#EXECUTION OF SERVICE POST TRANSFER TRANSACTIONS
				#############################################################
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				sv_u = urhk_ExecSrv("SRV_PostTransferTran|retain_all_output = Y")
				PRINT(sv_u)
				IF (sv_u != 0) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_ExecSrv("SRV_PostTransferTran")
					PRINT(sv_u)
				#}
				ENDIF
			#}
			ENDIF
			
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_i = sv_i + 1
						sv_u = SYSTEM("echo '"+sv_e+"' >>CSHDCHR.log")
						PRINT(sv_u)
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			#------------------------------------------------------------------
			# Cashwithdrawal Charge. This amount will debit from the customer
			# account and credit into income account. This amount is derived
			# from the amount table code. the code for the cash withdrawal chrg
			# is SUCHR.
			#------------------------------------------------------------------
			CUST.CSHDCHR.foracid 	= BANCS.OUTPARAM.foracid
			CUST.CSHDCHR.solId 		= BANCS.OUTPARAM.sol_id
			CUST.CSHDCHR.tranYear  	= BANCS.OUTPARAM.tran_year
			CUST.CSHDCHR.numDrTran 	= BANCS.OUTPARAM.numDrTrxns
			
			IF ( BANCS.STDIN.contextBankId == "54" ) THEN
			#{
				sv_s = "schmCode|"
				sv_s = sv_s + " SELECT GAM.schm_code"
				sv_s = sv_s + " FROM TBAADM.GAM "
				sv_s = sv_s + " WHERE GAM.foracid= ?SVAR"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
				
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CSHDCHR.foracid  + "|"
				BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				PRINT(sv_d)
				
				IF (sv_d == 0) THEN
				#{
					CUST.CSHDCHR.schmCode = BANCS.OUTPARAM.schmCode
					PRINT(CUST.CSHDCHR.schmCode)
					#}
				ELSE
					#{
					CUST.CSHDCHR.errMsg ="Error in getting Schmcode"
					GOTO NEXTREC
				#}
				ENDIF
				
				IF (CUST.CSHDCHR.schmCode==CUST.CPARAM.schmCode) THEN
				#{
					BANCS.INPARAM.InputAmount 		= CUST.CPARAM.inpAmt
					BANCS.INPARAM.CurrencyCode 		= BANCS.STDIN.homeCrncyCode
					BANCS.INPARAM.AmountTableCode 	= CUST.CPARAM.amtTblecde
					sv_u = urhk_B2k_GetASTMAmount("")
					PRINT(sv_u)
					
					IF (sv_u == 1) THEN
					#{
						CUST.CSHDCHR.errMsg = CUST.CPARAM.amtTblecde + " Amount Slab Code is incorrect "
						GOTO NEXTREC
						#}
					ELSE
						#{
						CUST.CSHDCHR.outputAmtt = BANCS.OUTPARAM.OutputAmount
						PRINT(CUST.CSHDCHR.outputAmtt)
					#}
					ENDIF
					CUST.CSHDCHR.outputAmtt = CDOUBLE(CUST.CSHDCHR.outputAmtt) * (CDOUBLE(CUST.CSHDCHR.numDrTran) - CDOUBLE(CUST.CPARAM.trxns))
					PRINT(CUST.CSHDCHR.outputAmtt)
					#}
				ELSE
					#{
					BANCS.INPARAM.InputAmount 		= CUST.CPARAM.inpAmt1
					BANCS.INPARAM.CurrencyCode 		= BANCS.STDIN.homeCrncyCode
					BANCS.INPARAM.AmountTableCode 	= CUST.CPARAM.amtTblecde1
					sv_u = urhk_B2k_GetASTMAmount("")
					PRINT(sv_u)
					
					IF (sv_u == 1) THEN
					#{
						CUST.CSHDCHR.errMsg = CUST.CPARAM.amtTblecde1 + " Amount Slab Code is incorrect "
						GOTO NEXTREC
						#}
					ELSE
						#{
						CUST.CSHDCHR.outputAmtt = BANCS.OUTPARAM.OutputAmount
						PRINT(CUST.CSHDCHR.outputAmtt)
					#}
					ENDIF
					
					CUST.CSHDCHR.outputAmtt = CDOUBLE(CUST.CSHDCHR.outputAmtt) *  ( CDOUBLE(CUST.CSHDCHR.numDrTran) - CDOUBLE(CUST.CPARAM.trxns))
					PRINT(CUST.CSHDCHR.outputAmtt)
				#}
				ENDIF
				#}
			ELSE
				#{
				BANCS.INPARAM.InputAmount 		= CUST.CPARAM.inpAmt1
				BANCS.INPARAM.CurrencyCode 		= BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.AmountTableCode 	= CUST.CPARAM.amtTblecde1
				sv_u = urhk_B2k_GetASTMAmount("")
				PRINT(sv_u)
				
				IF (sv_u == 1) THEN
				#{
					CUST.CSHDCHR.errMsg = CUST.CPARAM.amtTblecde1 + " Amount Slab Code is incorrect "
					GOTO NEXTREC
					#}
				ELSE
					#{
					CUST.CSHDCHR.outputAmtt = BANCS.OUTPARAM.OutputAmount
					PRINT(CUST.CSHDCHR.outputAmtt)
				#}
				ENDIF
				
				CUST.CSHDCHR.outputAmtt = CDOUBLE(CUST.CSHDCHR.outputAmtt) *  ( CDOUBLE(CUST.CSHDCHR.numDrTran) - CDOUBLE(CUST.CPARAM.trxns))
				PRINT(CUST.CSHDCHR.outputAmtt)
			#}
			ENDIF
			
			#--------------------------------------------------
			# Customer Debit part transaction
			#--------------------------------------------------
			
			CUST.CSHDCHR.partSrlNo = CINT(CUST.CSHDCHR.partSrlNo) + 1
			PRINT(CUST.CSHDCHR.partSrlNo)
			CUST.CSHDCHR.recVal=FORMAT$(CINT(CUST.CSHDCHR.partSrlNo) - 1,"%d")
			PRINT(CUST.CSHDCHR.recVal)
			sv_a = "tranDtl.partTranDetailLL.<rec_"+CUST.CSHDCHR.recVal+">."
			PRINT(sv_a)
			sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+CUST.CSHDCHR.partSrlNo)
			sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|D")
			sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.CSHDCHR.foracid)
			sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|" + CUST.CSHDCHR.outputAmtt + "|" +BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|"+CUST.CPARAM.tranpart1)
			sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.CSHDCHR.outputAmtt +"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.CPARAM.refCode)
			
			#------------------------------------------
			# Increment for total credit amount to the
			# income account(cash wihdrawal chrg)
			#------------------------------------------
			CUST.CSHDCHR.refAmtCr = CDOUBLE(CUST.CSHDCHR.refAmtCr) + CDOUBLE(CUST.CSHDCHR.outputAmtt)
			PRINT(CUST.CSHDCHR.refAmtCr)
			
			#-------------------------------------------------------
			# Once its collected charges for extra cash withdrawal,
			# system will update the NUM_DR_TRXNS into 4 in C_SJA.
			#-------------------------------------------------------
			sv_s = "UPDATE CUSTOM.C_SJA SET C_SJA.num_dr_trxns=?SVAR"
			sv_s = sv_s + " WHERE C_SJA.foracid = ?SVAR"
			sv_s = sv_s + " AND C_SJA.tran_year = ?SVAR"
			sv_s = sv_s + " AND C_SJA.del_flg='N'"
			sv_s = sv_s + " AND C_SJA.bank_id = ?SVAR"
			
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CPARAM.trxns +"|"
			BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + CUST.CSHDCHR.foracid +"|"
			BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + CUST.CSHDCHR.year +"|"
			BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSQLWithBind(sv_s)
			IF ( sv_d != 0 ) THEN
			#{
				CUST.CSHDCHR.errMsg ="Update is not Successfull "
				GOTO NEXTREC
			#}
			ENDIF
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
		#}
		ENDIF
		
		NEXTREC:
			IF (CUST.CSHDCHR.errMsg != "") THEN
			#{
				sv_u = SYSTEM("echo '"+ CUST.CSHDCHR.errMsg +"' >>cashwdchrg.log")
				CUST.CSHDCHR.errMsg = ""
			#}
			ENDIF
			
		#}
		DO
		
	ENDOFSCRIPT:
		IF (CUST.CSHDCHR.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+ CUST.CSHDCHR.errMsg +"' >>cashwdchrg.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
