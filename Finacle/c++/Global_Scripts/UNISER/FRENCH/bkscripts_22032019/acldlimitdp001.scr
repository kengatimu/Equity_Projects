<--start
trace on

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","ACL") == 0) THEN
#{
	CREATECLASS("CUST","ACL",5)
#}
ENDIF
#--------------------------------------------------------------------------
# Initialize variables
#--------------------------------------------------------------------------

#print(BANCS.INPUT.acctId)
CUST.ACL.acctId = BANCS.INPUT.acctId
CUST.ACL.limPrefix  = ""
CUST.ACL.limSuffix  = ""
CUST.ACL.curr  = ""
CUST.ACL.orgSanctLimit  = ""
CUST.ACL.sanctLimit  = ""
CUST.ACL.drwngPower  = ""
CUST.ACL.liab  = ""
CUST.ACL.delFlg  = ""
CUST.ACL.recordCount ="0"
sv_s = "1"

#--------------------------------------------------------------------------
# Get record Count
#--------------------------------------------------------------------------
sv_a =  "count | SELECT COUNT(*) "
sv_a = sv_a + " FROM TBAADM.LLT  WHERE DEL_FLG != 'Y' "
sv_a = sv_a + " AND BANK_ID = ?SVAR "
sv_a = sv_a + " AND CUST_ID = (SELECT CUST_ID FROM "
sv_a = sv_a + " TBAADM.GAM WHERE FORACID = ?SVAR  AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N')"
sv_a = sv_a +" AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N' "
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.ACL.acctId

print(sv_a)

sv_d = urhk_dbSelectWithBind(sv_a)
print(sv_d)

CUST.ACL.recordCount = BANCS.OUTPARAM.count
print(CUST.ACL.recordCount)

sv_u = urhk_SetOrbOut("recordCount|" + CUST.ACL.recordCount)


#--------------------------------------------------------------------------
# Fetch records from DB
#--------------------------------------------------------------------------

sv_a =  "limPrefix,limSuffix,curr,orgSanctLimit,sanctLimit,drwngPower,liab,delFlg| "
sv_a = sv_a + " SELECT limit_prefix,limit_suffix,crncy_code,orig_sanct_lim,sanct_lim,drwng_power,liab,del_flg "
sv_a = sv_a + " FROM TBAADM.LLT  WHERE DEL_FLG != 'Y' "
sv_a = sv_a + " AND BANK_ID = ?SVAR "
sv_a = sv_a + " AND CUST_ID = ( SELECT CUST_ID FROM "
sv_a = sv_a + " TBAADM.GAM WHERE FORACID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N')"
sv_a = sv_a +" AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N' "
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.ACL.acctId

print(sv_a)

sv_u = urhk_dbCursorOpenWithBind(sv_a)

IF (sv_u == 0) THEN
#{
	sv_b = (BANCS.OUTPARAM.DB_CURSOR_NUMBER) 
	print(sv_b)
	sv_r = urhk_dbCursorFetch(sv_b)
	print(sv_r)
	# Else fetch details from cursor
		CUST.ACL.count = sv_s
	WHILE(sv_r == 0)
	#{
		IF(TRIM(BANCS.OUTPARAM.limPrefix) != "") THEN
		#{
			CUST.ACL.limPrefix = BANCS.OUTPARAM.limPrefix
			print(CUST.ACL.limPrefix)
		#}
		ENDIF
		IF(TRIM(BANCS.OUTPARAM.limSuffix) != "") THEN
		#{
			CUST.ACL.limSuffix = BANCS.OUTPARAM.limSuffix
			print(CUST.ACL.limSuffix)
		#}
		ENDIF
		IF(TRIM(BANCS.OUTPARAM.curr) != "") THEN
		#{
			CUST.ACL.curr = BANCS.OUTPARAM.curr
			print(CUST.ACL.curr)
		#}
		ENDIF
		IF(TRIM(BANCS.OUTPARAM.orgSanctLimit) != "") THEN
		#{
			CUST.ACL.orgSanctLimit = BANCS.OUTPARAM.orgSanctLimit
			print(CUST.ACL.orgSanctLimit)
		#}
		ENDIF
		IF(TRIM(BANCS.OUTPARAM.sanctLimit) != "") THEN
		#{
			CUST.ACL.sanctLimit = BANCS.OUTPARAM.sanctLimit
			print(CUST.ACL.sanctLimit)
		#}
		ENDIF
		IF(TRIM(BANCS.OUTPARAM.drwngPower) != "") THEN
		#{
			CUST.ACL.drwngPower = BANCS.OUTPARAM.drwngPower
			print(CUST.ACL.drwngPower)
		#}
		ENDIF
		IF(TRIM(BANCS.OUTPARAM.liab) != "") THEN
		#{
			CUST.ACL.liab = BANCS.OUTPARAM.liab
			print(CUST.ACL.liab)
		#}
		ENDIF
		IF(TRIM(BANCS.OUTPARAM.delFlg) != "") THEN
		#{
			CUST.ACL.delFlg = BANCS.OUTPARAM.delFlg
			print(CUST.ACL.delFlg)
		#}
		ENDIF
	
		# Set the values to front end   
		sv_z = "limPrefix_" + CUST.ACL.count + "|" + CUST.ACL.limPrefix
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)

		sv_z = "limSuffix_" + CUST.ACL.count + "|" + CUST.ACL.limSuffix
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)
	
		sv_z = "curr_" + CUST.ACL.count + "|" + CUST.ACL.curr
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)		

		sv_z = "orgSanctLimit_" + CUST.ACL.count + "|" + CUST.ACL.orgSanctLimit
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)

		sv_z = "sanctLimit_" + CUST.ACL.count + "|" + CUST.ACL.sanctLimit
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)

		sv_z = "drwngPower_" + CUST.ACL.count + "|" + CUST.ACL.drwngPower
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)
	
		sv_z = "liab_" + CUST.ACL.count + "|" + CUST.ACL.liab
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)

		sv_z = "delFlg_" + CUST.ACL.count + "|" + CUST.ACL.delFlg
		sv_m = urhk_SetOrbOut(sv_z)
		print(sv_z)
		print(sv_m)
		
		# Fetch next record
	
		CUST.ACL.count = CINT(CUST.ACL.count) + 1  
		print(CUST.ACL.count)
		sv_r = urhk_dbCursorFetch(sv_b)
	DO
	sv_x = urhk_dbCursorClose(sv_b)
#}
ENDIF	

EXITSCRIPT
