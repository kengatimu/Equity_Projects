#------------------------------------------------------------------------------------------------
#   Name            : s_upmWorkclassdp001.scr
#   Description     : This script is used to check if the user can grant Temp rights.
#   Date            : 08-02-2013
#   Author          : Prakash
#   Input           : NA
#   Outpu           : NA
#   Called          : SRV_FetchUsrProfileForModify_validate_data.scr
#   Calling script  : getcparamvalue.scr
#   Menu Option     : HUPM
#   Srl. No         Date            Author          Description.
#   ------         ----------      -------         ---------------
#   1.0            08-02-2013       Prakash         Original Version
#   2.0            29-08-2013       Vijaya V         for TOL: 370708
#-----------------------------------------------------------------------------------------------

<--START
CHECKSUM="ab7db72caadc841d8d437cf80809a9555ca189cfddc7c9eef678802e54ce52b6"
	TRACE ON
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "UPMWC") == 0) THEN
	#{
		CREATECLASS("CUST", "UPMWC", 5)
	#}
	ENDIF
	
	CUST.UPMWC.work_classval10 = ""
	CUST.UPMWC.count           = ""
	CUST.UPMWC.errMsg		   = ""
	
	BANCS.INPUT.moduleName = "UPMWORKCLASS"
	BANCS.INPUT.parameterId = "WORK_CLASSVAL10"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.work_classval10 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for workclss"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.UPMWC.work_classval10)
	
	BANCS.INPUT.parameterId = "PARACOUNT"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.paraCount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "Para count setup not done for workclss"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.UPMWC.paraCount)
	
	CUST.UPMWC.userWorkClass = BANCS.STDIN.userWorkClass
	PRINT(CUST.UPMWC.userWorkClass)
	
	IF( (BANCS.STDIN.contextBankId == "54" ) OR (BANCS.STDIN.contextBankId == "55" ) OR (BANCS.STDIN.contextBankId == "50" )) THEN
	#{
		IF (CINT(CUST.UPMWC.userWorkClass) < CINT(CUST.UPMWC.work_classval10)) THEN
		#{
			
			sv_s = "count | SELECT count(*) "
			sv_s = sv_s + "FROM C_CPMASTER,CUSTOM.C_CPVALUE "
			sv_s = sv_s + "WHERE C_CPMASTER.bank_id = C_CPVALUE.bank_id "
			sv_s = sv_s + "AND C_CPMASTER.module_name = C_CPVALUE.module_name "
			sv_s = sv_s + "AND C_CPMASTER.parameter_id = C_CPVALUE.parameter_id  "
			sv_s = sv_s + "AND C_CPMASTER.module_name = 'UPMWORKCLASS' "
			sv_s = sv_s + "AND C_CPVALUE.parameter_id like 'ROLE_ID%' "
			sv_s = sv_s + "AND C_CPVALUE.parameter_value = ?SVAR "
			sv_s = sv_s + "AND C_CPMASTER.bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.roleId + "|" + BANCS.STDIN.contextBankId
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			PRINT(BANCS.STDIN.roleId)
			IF( sv_d == 0 ) THEN
			#{
				CUST.UPMWC.count = BANCS.OUTPARAM.count
				PRINT(CUST.UPMWC.count)
				IF (CINT(CUST.UPMWC.count) < 1) THEN
				#{
					CUST.UPMWC.errMsg = "Cannot Grant Temp Rights"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.UPMWC.errMsg = "Select statement failed"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT :
		IF (CUST.UPMWC.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.UPMWC.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
