<--START
CHECKSUM="433a97f60ce6e9e33322e93bc793d0e43f45cef198d2ca44c241aba587f0e8cf"
	TRACE ON
	LIBNAME CUSTOMSO
	IF (REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","HLINTM")==0) THEN
	#{
		CREATECLASS("CUST","HLINTM",5)
	#}
	ENDIF
	
	CUST.HLINTM.fileName			=	"/finacle/anoop/LZERO_11.txt"
	print(CUST.HLINTM.fileName)
	CUST.HLINTM.logFile			=	"HLINTM.log"
	#---------------------
	# Access the file
	#---------------------
	sv_a = urtn_fileAccess(CUST.HLINTM.fileName)
	sv_d = urtn_fileOpen(CUST.HLINTM.logFile + "|a")
	IF (sv_d < 0) THEN
	#{
		print("Error in Reading the file")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	print(sv_a)
	IF (sv_a != 0) THEN
	#{
		print(" Input file File Not Accessible")
		sv_w = urtn_fileWrite(sv_d + "|Input file File Not Accessible" )
		
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#---------------------
	# Open the file
	#---------------------
	
	sv_b = urtn_fileOpen(CUST.HLINTM.fileName + "|r")
	print(sv_b)
	IF (sv_b < 0) THEN
	#{
		print("Unable To Open File")
		sv_w = urtn_fileWrite(sv_d + "|Unable To Open Upload File" )
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#---------------------
	# Read record FROM the file
	#---------------------
	sv_c = urtn_fileRead(sv_b + "|CUST.HLINTM.inputRecord")
	print(sv_c)
	IF (sv_c != 0) THEN
	#{
		print("Upload File has no records")
		sv_w = urtn_fileWrite(sv_d + "|Upload File has no records" )
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_w = urtn_fileWrite(sv_d + "|The Below A/c are processed" )
	sv_w = urtn_fileWrite(sv_d + "|Foracid          | Old Min Int    | New Min Int" )
	WHILE ( sv_c == 0)
	#{
		print(sv_c)
		CUST.HLINTM.foracid = CUST.HLINTM.inputRecord
		print(CUST.HLINTM.foracid)
		sv_e = urhk_SetUrhkInp("loanIntTblCrit.laAcct.foracid|" + CUST.HLINTM.foracid)
		sv_e = urhk_SetUrhkInp("loanIntTblCrit.funcCode|M")
		sv_e = urhk_SetUrhkOut("loanIntTblDtlLL.<rec_0>.minInt|oldMinInt")
		sv_e = urhk_ExecSrv("SRV_FetchLoanIntTblDtl|same_user_verify = Y|retain_all_output = Y")
		print(sv_e)
		IF ( sv_e == 0) THEN
		#{
			#sv_w = urtn_fileWrite(sv_d + "|" + CUST.HLINTM.foracid + "    | " + BANCS.OUTPARAM.oldMinInt)
			
			CUST.HLINTM.newMinInt = "0.000000"
			print(CUST.HLINTM.newMinInt)
			IF(FIELDEXISTS(BANCS.OUTPARAM.oldMinInt))THEN
			#{
				CUST.HLINTM.oldMinInt = BANCS.OUTPARAM.oldMinInt
				#}
			ELSE
				#{
				sv_w = urtn_fileWrite(sv_d + "|" + CUST.HLINTM.foracid + "    | " + "000000"  + "    | Verification pending" )
				GOTO CONT
			#}
			ENDIF
			print(CUST.HLINTM.oldMinInt)
			sv_f = urhk_CopyOutToIn("")
			PRINT(sv_f)
			IF ( CUST.HLINTM.oldMinInt != "0.000000") THEN
			#{
				sv_f = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.minInt|0.000000" )
				sv_f = urhk_ExecSrv("SRV_processLoanIntTblDtlAndVerify|same_user_verify = Y|retain_all_output = Y")
				IF ( sv_f == 0) THEN
				#{
					sv_w = urtn_fileWrite(sv_d + "|" + CUST.HLINTM.foracid + "    | " + CUST.HLINTM.oldMinInt + "    | " +  CUST.HLINTM.newMinInt)
					#}
				ELSE
					#{
					
					sv_w = urtn_fileWrite(sv_d + "|" + CUST.HLINTM.foracid + "    | " + CUST.HLINTM.oldMinInt + "    | " + BANCS.OUTPARAM.ErrorMesg_1)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_w = urtn_fileWrite(sv_d + "|" + CUST.HLINTM.foracid + "    | " + CUST.HLINTM.oldMinInt + "    | Already ZERO" )
			#}
			ENDIF
			
			#}
		ELSE
			#{
			sv_w = urtn_fileWrite(sv_d + "|" + CUST.HLINTM.foracid + "    | " + CUST.HLINTM.oldMinInt + "    | " + BANCS.OUTPARAM.ErrorMesg_1)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CONT:
			sv_c = urtn_fileRead(sv_b + "|CUST.HLINTM.inputRecord")
			
		#}
		DO
		
		
		
	ENDOFSCRIPT:
		sv_u = urtn_fileClose(sv_d)
		print(sv_u)
		sv_u = urtn_fileClose(sv_b)
		print(sv_u)
		
		IF(CLASSEXISTS("CUST", "HLINTM")) THEN
		#{
			DELETECLASS("CUST", "HLINTM")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
