	BANCS.OUTPUT.otherPartyAcctID		= PAYSYS.PORD.benCustAcctId
	BANCS.OUTPUT.otherPartyName			= PAYSYS.PORD.benCustName
	BANCS.OUTPUT.otherPartyAddr1		= PAYSYS.PORD.benCustAddr1
	BANCS.OUTPUT.otherPartyAddr2		= PAYSYS.PORD.benCustAddr2
	BANCS.OUTPUT.otherPartyAddr3		= PAYSYS.PORD.benCustAddr3
	BANCS.OUTPUT.otherPartyCntryCode    = PAYSYS.PORD.BenefPartyCntryCode
	IF(PAYSYS.PORD.benInstBIC != "") THEN
	#{
		BANCS.OUTPUT.otherPartyCntryCode = mid$(PAYSYS.PORD.benInstBIC,4,2)
	#}
	ENDIF
	
	#====================
	BANCS.OUTPUT.rcvrBankCode 			= PAYSYS.PORD.mappedRCBankCode
	BANCS.OUTPUT.rcvrBranchCode 		= PAYSYS.PORD.mappedRCBrCode
	BANCS.OUTPUT.rcvrName				= PAYSYS.PORD.mappedRCName
	BANCS.OUTPUT.rcvrAddr1	     		= PAYSYS.PORD.mappedRCAddr1
	BANCS.OUTPUT.rcvrAddr2			    = PAYSYS.PORD.mappedRCAddr2
	BANCS.OUTPUT.rcvrAddr3			    = PAYSYS.PORD.mappedRCAddr3
	BANCS.OUTPUT.rcvrCntryCode			= ""
	IF(PAYSYS.PORD.mappedRCBIC != "") THEN
	#{
		BANCS.OUTPUT.rcvrCntryCode = mid$(PAYSYS.PORD.mappedRCBIC,4,2)
	#}
	ENDIF
	#############################
	BANCS.OUTPUT.localBankCode			= ""
	BANCS.OUTPUT.localBranchCode	    = ""
	#====================
	BANCS.OUTPUT.triBIC              = PAYSYS.PORD.ThirdPartBIC
	BANCS.OUTPUT.triBankCode         = PAYSYS.PORD.ThirdPartBankCode
	BANCS.OUTPUT.triBrCode           = PAYSYS.PORD.ThirdPartBrCode
	BANCS.OUTPUT.triAcct             = PAYSYS.PORD.ThirdPartAcct
	BANCS.OUTPUT.triName             = PAYSYS.PORD.ThirdPartName
	BANCS.OUTPUT.triAddr1            = PAYSYS.PORD.ThirdPartAddr1
	BANCS.OUTPUT.triAddr2            = PAYSYS.PORD.ThirdPartAddr2
	BANCS.OUTPUT.triAddr3            = PAYSYS.PORD.ThirdPartAddr3
	BANCS.OUTPUT.triReimbCntryCode   = PAYSYS.PORD.ThirdReimCntryCode
	#====================
	BANCS.OUTPUT.interMediaryBIC                = PAYSYS.PORD.mappedIntBIC
	BANCS.OUTPUT.interMediaryBankCode           = PAYSYS.PORD.mappedIntBankCode
	BANCS.OUTPUT.interMediaryBranchCode         = PAYSYS.PORD.mappedIntBrCode
	BANCS.OUTPUT.interMediaryAcct               = PAYSYS.PORD.mappedIntAcct
	BANCS.OUTPUT.interMediaryName               = PAYSYS.PORD.mappedIntName
	BANCS.OUTPUT.interMediaryAddr1              = PAYSYS.PORD.mappedIntAddr1
	BANCS.OUTPUT.interMediaryAddr2              = PAYSYS.PORD.mappedIntAddr2
	BANCS.OUTPUT.interMediaryAddr3              = PAYSYS.PORD.mappedIntAddr3
	BANCS.OUTPUT.interMediaryCntryCode          = PAYSYS.PORD.mappedIntCntryCode
	#=====================
	BANCS.OUTPUT.payeeBIC               = PAYSYS.PORD.mappedAWIBIC
	BANCS.OUTPUT.payeeBankCode			= PAYSYS.PORD.mappedAWIBankCode
	BANCS.OUTPUT.payeeBranchCode       	= PAYSYS.PORD.mappedAWIBrCode
	BANCS.OUTPUT.payeeName				= PAYSYS.PORD.mappedAWIName
	BANCS.OUTPUT.payeeAddr1				= PAYSYS.PORD.mappedAWIAddr1
	BANCS.OUTPUT.payeeAddr2				= PAYSYS.PORD.mappedAWIAddr2
	BANCS.OUTPUT.payeeAddr3				= PAYSYS.PORD.mappedAWIAddr3
	BANCS.OUTPUT.payeeCntryCode 		= ""
	IF(PAYSYS.PORD.mappedAWIBIC != "") THEN
	#{
		BANCS.OUTPUT.payeeCntryCode = mid$(PAYSYS.PORD.mappedAWIBIC,4,2)
	#}
	ENDIF
	#====================
	# Now populate other fields based on serial cover flag
	IF(PAYSYS.PORD.serialCoverFlg == "S") THEN
	#{
		IF(PAYSYS.PORD.recvBIC == PAYSYS.PORD.mappedAWIBIC) THEN
		#{
			BANCS.OUTPUT.corrCollBankCode   = PAYSYS.PORD.mappedAWIBankCode
			BANCS.OUTPUT.corrCollBranchCode = PAYSYS.PORD.mappedAWIBrCode
			BANCS.OUTPUT.payeeBankCode      = PAYSYS.PORD.mappedAWIBankCode
			BANCS.OUTPUT.payeeBranchCode    = PAYSYS.PORD.mappedAWIBrCode
			BANCS.OUTPUT.payeeBIC           = PAYSYS.PORD.mappedAWIBIC
			#}
		ELSE
			#{
			#consider the case of Serail Payment where Receiver &  AWI are different
			BANCS.OUTPUT.corrCollBankCode   = PAYSYS.PORD.mappedOCBankCode
			BANCS.OUTPUT.corrCollBranchCode = PAYSYS.PORD.mappedOCBrCode
			BANCS.OUTPUT.payeeBankCode      = PAYSYS.PORD.mappedAWIBankCode
			BANCS.OUTPUT.payeeBranchCode    = PAYSYS.PORD.mappedAWIBrCode
			BANCS.OUTPUT.payeeBIC           = PAYSYS.PORD.mappedAWIBIC
		#}
		ENDIF
		#}
	ELSE
		#{
		IF(PAYSYS.PORD.recvBIC == PAYSYS.PORD.mappedAWIBIC) THEN
		#{
			BANCS.OUTPUT.payeeBankCode      = PAYSYS.PORD.mappedAWIBankCode
			BANCS.OUTPUT.payeeBranchCode    = PAYSYS.PORD.mappedAWIBrCode
			BANCS.OUTPUT.payeeBIC           = PAYSYS.PORD.mappedAWIBIC
			BANCS.OUTPUT.corrCollBankCode   = PAYSYS.PORD.mappedOCBankCode
			BANCS.OUTPUT.corrCollBranchCode = PAYSYS.PORD.mappedOCBrCode
			BANCS.OUTPUT.localBankCode      = ""
			BANCS.OUTPUT.localBranchCode    = ""
			#}
		ELSE
			#{
			BANCS.OUTPUT.localBankCode      = PAYSYS.PORD.recvBankCode
			BANCS.OUTPUT.localBranchCode    = PAYSYS.PORD.recvBranchCode
			BANCS.OUTPUT.corrCollBankCode   = PAYSYS.PORD.mappedOCBankCode
			BANCS.OUTPUT.corrCollBranchCode = PAYSYS.PORD.mappedOCBrCode
			BANCS.OUTPUT.payeeBankCode      = PAYSYS.PORD.mappedAWIBankCode
			BANCS.OUTPUT.payeeBranchCode    = PAYSYS.PORD.mappedAWIBrCode
			BANCS.OUTPUT.payeeBIC           = PAYSYS.PORD.mappedAWIBIC
		#}
		ENDIF
	#}
	ENDIF
	#End of Serail Cover check
	BANCS.OUTPUT.successOrFailure 	= "S"
	BANCS.OUTPUT.PaymentMessage 	= ""
	BANCS.OUTPUT.MsgId				= ""
	
	BANCS.OUTPUT.senderBankChrgCrncy	= PAYSYS.PORD.senderBankChrgCrncy
	BANCS.OUTPUT.senderBankChrgAmt		= PAYSYS.PORD.senderBankChrgAmt
	BANCS.OUTPUT.recvrBankChrgCrncy		= PAYSYS.PORD.recvrBankChrgCrncy
	BANCS.OUTPUT.recvrBankChrgAmt		= PAYSYS.PORD.recvrBankChrgAmt
	BANCS.OUTPUT.totalChrgCrncy			= PAYSYS.PORD.totalChrgCrncy
	BANCS.OUTPUT.totalChrgAmt			= PAYSYS.PORD.totalChrgAmt
	#====================
	BANCS.OUTPUT.rerouteCrncy		= PAYSYS.PORD.rerouteCrncy
	BANCS.OUTPUT.rerouteAmt			= PAYSYS.PORD.rerouteAmt
	BANCS.OUTPUT.instructedAmtCrncy	= PAYSYS.PORD.instructedAmtCrncy
	BANCS.OUTPUT.instructedAmt		= PAYSYS.PORD.instructedAmt
	
	#====================
	BANCS.OUTPUT.senderToRecvInfo1	= PAYSYS.PORD.senderToRecvInfo1
	BANCS.OUTPUT.senderToRecvInfo2	= PAYSYS.PORD.senderToRecvInfo2
	BANCS.OUTPUT.senderToRecvInfo3	= PAYSYS.PORD.senderToRecvInfo3
	BANCS.OUTPUT.senderToRecvInfo4	= PAYSYS.PORD.senderToRecvInfo4
	BANCS.OUTPUT.senderToRecvInfo5	= PAYSYS.PORD.senderToRecvInfo5
	BANCS.OUTPUT.senderToRecvInfo6	= PAYSYS.PORD.senderToRecvInfo6
	#====================
	BANCS.OUTPUT.remittInfo1 = PAYSYS.PORD.paymentDet1
	BANCS.OUTPUT.remittInfo2 = PAYSYS.PORD.paymentDet2
	BANCS.OUTPUT.remittInfo3 = PAYSYS.PORD.paymentDet3
	BANCS.OUTPUT.remittInfo4 = PAYSYS.PORD.paymentDet4
	#====================
	BANCS.OUTPUT.ordInstBIC = PAYSYS.PORD.orderingInstBIC
	BANCS.OUTPUT.ordInstName = PAYSYS.PORD.orderingInstName
	BANCS.OUTPUT.ordInstAddr1 = PAYSYS.PORD.orderingInstAddr1
	BANCS.OUTPUT.ordInstAddr2 = PAYSYS.PORD.orderingInstAddr2
	BANCS.OUTPUT.ordInstAddr3 = PAYSYS.PORD.orderingInstAddr3
	#====================
	BANCS.OUTPUT.regRepInfo1 = PAYSYS.PORD.regulatoryRepInfo1
	BANCS.OUTPUT.regRepInfo2 = PAYSYS.PORD.regulatoryRepInfo2
	BANCS.OUTPUT.regRepInfo3 = PAYSYS.PORD.regulatoryRepInfo3
	
	BANCS.OUTPUT.rcvrCorrBankCode      = PAYSYS.PORD.RecvrCorrespBankCode
	BANCS.OUTPUT.rcvrCorrBranchCode    = PAYSYS.PORD.RecvrCorrespBrCode
	BANCS.OUTPUT.rcvrCorrName          = PAYSYS.PORD.RecvrCorrespName
	BANCS.OUTPUT.rcvrCorrAddr1         = PAYSYS.PORD.RecvrCorrespAddr1
	BANCS.OUTPUT.rcvrCorrAddr2         = PAYSYS.PORD.RecvrCorrespAddr2
	BANCS.OUTPUT.rcvrCorrAddr3         = PAYSYS.PORD.RecvrCorrespAddr3
	BANCS.OUTPUT.rcvrCorrCntryCode     = PAYSYS.PORD.RecvrCorrespCntryCode
	BANCS.OUTPUT.pFreeText  = BANCS.INPUT.pFreeText
	
	print(ONS.CUSTOM.custDataIn)
	ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataIn + "~commonresultpage|" + BANCS.INPUT.tranId + "|" + BANCS.INPUT.tranDate
	print(ONS.CUSTOM.custDataOut)
	
	TRACE OFF
	ENDOFSCRIPT:
		exitscript
END-->
