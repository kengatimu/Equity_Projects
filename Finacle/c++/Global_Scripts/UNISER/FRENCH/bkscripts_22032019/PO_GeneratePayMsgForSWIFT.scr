	# assign the value of the mapped Awi Country Code. if neither is present then
	# remit country is kept as null. Please note that the corresponding check in
	# the cxx to check / validate the country code has been changed and now
	# validates the same only if the remit country is present. In case the bank
	# decides that remit country is mandatory, then the same mandatory checked
	# will have to be implemented via scripts. If a check is introduced in this
	# script then it will only do the validations at time of verification or at
	# time of runnning pmssrv. A corresponding check will be needed in the
	# validation script for payment order details to ensure that the check is
	# available during submit/validate modes also.
	
	BANCS.OUTPUT.remitCntry = ""
