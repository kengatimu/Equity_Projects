#-------------------------------------------------------------------------------------
#    Name				: sharedtmdp002.scr
#    Description     	: For the given account,bacid is selected.Func code is "A" and
#						: bacid is "INTER", userWorkClass less than 600, error message displayed.
#    Date            	: 21-03-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: getcparamvalue.scr
#    Menu Option		:
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0			21-03-2013		Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="2747de86ead0a59c4505ad80232b160952a551dc60ec4f21c891e3adc4c628a5"
	TRACE ON
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("TMSS") == 0) THEN
	#{
		CREATEREP("TMSS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("TMSS","GLBDATA") == 0) THEN
	#{
		CREATECLASS("TMSS","GLBDATA",5)
	#}
	ENDIF
	
	TMSS.GLBDATA.errMsg = ""
	PRINT(BANCS.INPUT.acctnum)
	TMSS.GLBDATA.acctnum = BANCS.INPUT.acctnum
	PRINT(TMSS.GLBDATA.acctnum)
	TMSS.GLBDATA.amnt = BANCS.INPUT.amt
	PRINT(TMSS.GLBDATA.amnt)
	TMSS.GLBDATA.confirm = BANCS.INPUT.confirm
	PRINT(TMSS.GLBDATA.confirm)
	TMSS.GLBDATA.part_tran_type = BANCS.INPUT.partTranType
	PRINT(TMSS.GLBDATA.part_tran_type)
	TMSS.GLBDATA.FREZ_CODE = ""
	TMSS.GLBDATA.status = ""
	TMSS.GLBDATA.EFFAVAIl_AMT = ""
	TMSS.GLBDATA.totalamt = ""
	PRINT(BANCS.INPUT.trType)
	TMSS.GLBDATA.tran_type = BANCS.INPUT.trType
	PRINT(TMSS.GLBDATA.tran_type)
	
	BANCS.INPUT.moduleName  = "TRANDETAIL"
	BANCS.INPUT.parameterId = "REMARKS1"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCTDTL.rmks1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ACCTDTL.errMsg = "Remarks 1 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "REMARKS2"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCTDTL.rmks2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ACCTDTL.errMsg = "Remarks 2 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "REMARKS3"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCTDTL.rmks3 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ACCTDTL.errMsg = "Remarks 3 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "REMARKS4"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCTDTL.rmks4 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ACCTDTL.errMsg = "Remarks 4 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------
	#--Checking inter Account status
	#---------------------------------------------------------------------------
	sv_s = "foracid,msg_text_1,msg_text_2,msg_text_3,msg_text_4,msg_text_5,msg_text_6,msg_text_7|"
	sv_s = sv_s + "SELECT foracid,msg_text_1,msg_text_2,msg_text_3,msg_text_4,msg_text_5,msg_text_6,msg_text_7 "
	sv_s = sv_s + "FROM CUSTOM.C_MOP "
	sv_s = sv_s + "WHERE foracid = ("
	sv_s = sv_s + "SELECT cust_id FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE foracid = ?SVAR "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N')"
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.acctnum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d != 0) THEN
	#{
		PRINT("memo pad")
		#}
	ELSE
		#{
		sv_a = "-"
		IF (STRLEN(BANCS.OUTPARAM.msg_text_1) != 0 ) THEN
		#{
			sv_a = sv_a + "(1)" + BANCS.OUTPARAM.msg_text_1
		#}
		ENDIF
		IF (STRLEN(BANCS.OUTPARAM.msg_text_2) != 0 ) THEN
		#{
			sv_a = sv_a + " (2)" + BANCS.OUTPARAM.msg_text_2
		#}
		ENDIF
		IF (STRLEN(BANCS.OUTPARAM.msg_text_3) != 0 ) THEN
		#{
			sv_a = sv_a + " (3)" + BANCS.OUTPARAM.msg_text_3
		#}
		ENDIF
		IF (STRLEN(BANCS.OUTPARAM.msg_text_4) != 0 ) THEN
		#{
			sv_a = sv_a + " (4)" + BANCS.OUTPARAM.msg_text_4
		#}
		ENDIF
		IF (STRLEN(BANCS.OUTPARAM.msg_text_5) != 0 ) THEN
		#{
			sv_a = sv_a + " (5)" + BANCS.OUTPARAM.msg_text_5
		#}
		ENDIF
		IF (STRLEN(BANCS.OUTPARAM.msg_text_6) != 0 ) THEN
		#{
			sv_a = sv_a + " (6)" + BANCS.OUTPARAM.msg_text_6
		#}
		ENDIF
		IF (STRLEN(BANCS.OUTPARAM.msg_text_7) != 0 ) THEN
		#{
			sv_a = sv_a  + " (7)" + BANCS.OUTPARAM.msg_text_7
		#}
		ENDIF
		TMSS.GLBDATA.errMsg = sv_a
		#	GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#--The foll step is to Validate remark
	#---------------------------------------------------------------------------
	IF ((TMSS.GLBDATA.tran_type == "T") OR (TMSS.GLBDATA.tran_type == "C")) THEN
	#{
		IF (TMSS.GLBDATA.tran_type == "T") THEN
		#{
			IF (TMSS.GLBDATA.part_tran_type == "C") THEN
			#{
				TMSS.GLBDATA.Remarks = CUST.ACCTDTL.rmks1 + " - " + BANCS.STDIN.mySolDesc
				PRINT(TMSS.GLBDATA.Remarks)
				#}
			ELSE
				#{
				TMSS.GLBDATA.Remarks = CUST.ACCTDTL.rmks2 + " - " + BANCS.STDIN.mySolDesc
				PRINT(TMSS.GLBDATA.Remarks)
			#}
			ENDIF
			#}
		ELSE
			#{
			IF (TMSS.GLBDATA.part_tran_type == "C") THEN
			#{
				TMSS.GLBDATA.Remarks = CUST.ACCTDTL.rmks3 + " - " + BANCS.STDIN.mySolDesc
				PRINT(TMSS.GLBDATA.Remarks)
				#}
			ELSE
				#{
				TMSS.GLBDATA.Remarks = CUST.ACCTDTL.rmks4 + " - " + BANCS.STDIN.mySolDesc
				PRINT(TMSS.GLBDATA.Remarks)
			#}
			ENDIF
		#}
		ENDIF
		#}
	ELSE
		#{
		TMSS.GLBDATA.Remarks = " "
		PRINT(TMSS.GLBDATA.Remarks)
	#}
	ENDIF
	
	sv_a = "remark| " + TMSS.GLBDATA.Remarks
	sv_b = urhk_SetOrbOut(sv_a)
	
	IF (TMSS.GLBDATA.confirm == "Y") THEN
	#{
		IF (FIELDEXISTS(TMSS.GLBDATA.Continue) == 0) THEN
		#{
			#---------------------------------------------------------------------------
			#-Excemptions
			#---------------------------------------------------------------------------
			IF ((TMSS.GLBDATA.part_tran_type == "D") AND (TMSS.GLBDATA.FREZ_CODE == "Total Freeze")) THEN
			#{
				TMSS.GLBDATA.errMsg = "ACCOUNT FROZEN "
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF ((TMSS.GLBDATA.part_tran_type == "D") AND (TMSS.GLBDATA.FREZ_CODE == "Debit Freeze")) THEN
			#{
				TMSS.GLBDATA.errMsg = "ACCOUNT FROZEN "
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF ((TMSS.GLBDATA.part_tran_type == "C")AND (TMSS.GLBDATA.FREZ_CODE == "Total Freeze")) THEN
			#{
				TMSS.GLBDATA.errMsg = "ACCOUNT FROZEN "
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF ((TMSS.GLBDATA.part_tran_type == "C") AND (TMSS.GLBDATA.FREZ_CODE == "Credit Freeze")) THEN
			#{
				TMSS.GLBDATA.errMsg = "ACCOUNT FROZEN "
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF ((TMSS.GLBDATA.part_tran_type == "D") AND (TMSS.GLBDATA.status == "Dormant A/c")) THEN
			#{
				TMSS.GLBDATA.errMsg = "DORMANT ACCOUNT"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF ((TMSS.GLBDATA.part_tran_type == "D") AND (TMSS.GLBDATA.status == "Inactive A/c")) THEN
			#{
				TMSS.GLBDATA.errMsg = "INACTIVE ACCOUNT"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			PRINT (TMSS.GLBDATA.EFFAVAIl_AMT)
			PRINT (TMSS.GLBDATA.totalamt)
			
			sv_s = "foracid,acct_name,clr_bal_amt|"
			sv_s = sv_s + "SELECT foracid,acct_name,clr_bal_amt "
			sv_s = sv_s + "FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE foracid = ?SVAR "
			sv_s = sv_s + "AND entity_cre_flg = 'Y' "
			sv_s = sv_s + "AND del_flg = 'N' "
			sv_s = sv_s + "AND bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = TMSS.GLBDATA.acctnum + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				PRINT("Account exist")
				TMSS.GLBDATA.foracid = BANCS.OUTPARAM.foracid
				PRINT(TMSS.GLBDATA.foracid)
				TMSS.GLBDATA.acct_name = LEFT$(BANCS.OUTPARAM.acct_name,29)
				PRINT(TMSS.GLBDATA.acct_name)
				TMSS.GLBDATA.Continue = ""
				#}
			ELSE
				#{
				PRINT("hai")
				TMSS.GLBDATA.errMsg = "DB Error contact System Admin"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF (TMSS.GLBDATA.part_tran_type == "D") THEN
			#{
				IF (CDOUBLE(TMSS.GLBDATA.totalamt) > CDOUBLE(TMSS.GLBDATA.EFFAVAIl_AMT)) THEN
				#{
					TMSS.GLBDATA.errMsg = "Insufficent Fund"
					TMSS.GLBDATA.amount = ""
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#}
	ELSE
		#{
		TMSS.GLBDATA.account     = ""
		PRINT(TMSS.GLBDATA.account)
		TMSS.GLBDATA.amount      = ""
		PRINT(TMSS.GLBDATA.amount)
		TMSS.GLBDATA.Remark      = ""
		PRINT(TMSS.GLBDATA.Remark)
		TMSS.GLBDATA.foracid     = ""
		PRINT(TMSS.GLBDATA.foracid)
		TMSS.GLBDATA.acct_name   = ""
		PRINT(TMSS.GLBDATA.acct_name)
		TMSS.GLBDATA.clr_bal_amt = ""
		PRINT(TMSS.GLBDATA.clr_bal_amt)
	#}
	ENDIF
	
	sv_a = "foracid| " + TMSS.GLBDATA.foracid
	sv_b = urhk_SetOrbOut(sv_a)
	
	sv_a = "acctName| " + TMSS.GLBDATA.acct_name
	sv_b = urhk_SetOrbOut(sv_a)
	
	
	ENDOFSCRIPT:
		IF(TMSS.GLBDATA.errMsg != "") THEN
		#{
			sv_a = "Error|" + TMSS.GLBDATA.errMsg
			sv_b = urhk_SetOrbOut(sv_a)
		#}
		ENDIF
		
		
		TRACE OFF
		EXITSCRIPT
END-->
