			#}
		ELSE
			#{
			CUST.RATE.errMsg = " SCHMCODE18 setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF (BANCS.INPUT.rateCode != "" ) THEN
	#{
		IF (BANCS.INPUT.oldValue != "" ) THEN
		#{
			PRINT(BANCS.INPUT.oldValue)
			CUST.RATE.treaRate = BANCS.INPUT.oldValue
			PRINT(CUST.RATE.treaRate)
		#}
		ELSE
		#{
			CUST.RATE.errMsg = "Customer rate cannot be null"
			GOTO ENDOFSCRIPT
		
		#}
		ENDIF

		CUST.RATE.fromCrncy = TOUPPER(BANCS.INPUT.fixedCrncy)
		CUST.RATE.toCrncy = TOUPPER(BANCS.INPUT.varCrncy)
		CUST.RATE.bank_id = BANCS.STDIN.contextBankId
		
		PRINT(CUST.RATE.fromCrncy)
		PRINT(CUST.RATE.toCrncy)
		
		BANCS.INPARAM.BINDVARS = CUST.RATE.fromCrncy +"|"+ CUST.RATE.toCrncy +"|"+ CUST.RATE.bank_id
		sv_q = "count|select count(distinct fxd_crncy_code)  "
		sv_q = sv_q + "FROM tbaadm.rtl "
		sv_q = sv_q + "WHERE fxd_crncy_code= ?SVAR "
		sv_q = sv_q + "AND var_crncy_code = ?SVAR "
		sv_q = sv_q + "AND var_crncy_units > 1 "
		sv_q = sv_q + "AND del_flg != 'Y' "
		sv_q = sv_q + "AND bank_id = ?SVAR "
		sv_q = sv_q + "AND rownum <2 "
		PRINT(sv_q)
		sv_u = urhk_dbSelectWithBind(sv_q)
		PRINT(sv_u)
		IF (sv_u!=0) THEN
		#{
			CUST.RATE.resultMsg ="E"
			#}
		ELSE
			#{
			CUST.RATE.fxCount = BANCS.OUTPARAM.count
			
		#}
		ENDIF
		#####
			BANCS.INPARAM.BINDVARS = CUST.RATE.fromCrncy +"|"+ CUST.RATE.toCrncy +"|"+ CUST.RATE.bank_id
			sv_q = "count,existrate|select count(distinct fxd_crncy_code), VAR_CRNCY_UNITS "
			sv_q = sv_q + "FROM tbaadm.rtl "
			sv_q = sv_q + "WHERE fxd_crncy_code= ?SVAR "
			sv_q = sv_q + "AND var_crncy_code = ?SVAR "
			##sv_q = sv_q + "AND var_crncy_units > 1 "
			sv_q = sv_q + "AND del_flg != 'Y' "
			sv_q = sv_q + "AND bank_id = ?SVAR "
			sv_q = sv_q + "AND rownum <2 group by VAR_CRNCY_UNITS "
			PRINT(sv_q)
			sv_u = urhk_dbSelectWithBind(sv_q)
			PRINT(sv_u)
			IF (sv_u!=0) THEN
			#{
				####
					BANCS.INPARAM.BINDVARS = CUST.RATE.toCrncy  +"|"+ CUST.RATE.fromCrncy +"|"+ CUST.RATE.bank_id
					sv_q = "count,existrate|select count(distinct fxd_crncy_code), VAR_CRNCY_UNITS "
					sv_q = sv_q + "FROM tbaadm.rtl "
					sv_q = sv_q + "WHERE fxd_crncy_code= ?SVAR "
					sv_q = sv_q + "AND var_crncy_code = ?SVAR "
					##sv_q = sv_q + "AND var_crncy_units > 1 "
					sv_q = sv_q + "AND del_flg != 'Y' "
					sv_q = sv_q + "AND bank_id = ?SVAR "
					sv_q = sv_q + "AND rownum <2 group by VAR_CRNCY_UNITS "
					PRINT(sv_q)
					sv_u = urhk_dbSelectWithBind(sv_q)
					PRINT(sv_u)
					IF (sv_u!=0) THEN
					#{
						CUST.RATE.resultMsg ="E"
						GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						CUST.RATE.existrate = BANCS.OUTPARAM.existrate
						print(CUST.RATE.existrate)
					#}
					ENDIF
				####
			#}
			ELSE
			#{
				CUST.RATE.existrate = BANCS.OUTPARAM.existrate
				print(CUST.RATE.existrate)
			#}
			ENDIF
		#####

		PRINT(CUST.RATE.tolpcnt)
		PRINT(CUST.RATE.treaRate)
		
		CUST.RATE.negat = "-1"
		CUST.RATE.chkrate = CDOUBLE(CUST.RATE.tolpcnt) * CDOUBLE(CUST.RATE.treaRate)
		PRINT(CUST.RATE.chkrate)

		CUST.RATE.existcheck=CDOUBLE(CUST.RATE.existrate) * CDOUBLE("2")
		print(CUST.RATE.existcheck)
		
		PRINT(BANCS.INPUT.newValue)
		CUST.RATE.rate = BANCS.INPUT.newValue
		PRINT(CUST.RATE.rate)
		
		CUST.RATE.diff = CDOUBLE(CUST.RATE.rate) - CDOUBLE(CUST.RATE.treaRate)
		PRINT(CUST.RATE.diff)
		
		print(BANCS.INPUT.treasuryExRate)
		CUST.RATE.diff2 = CDOUBLE(BANCS.INPUT.treasuryExRate) - CDOUBLE(CUST.RATE.treaRate)
		PRINT(CUST.RATE.diff2)
		

		CUST.RATE.diffrate100 = CDOUBLE(CUST.RATE.existcheck) - CDOUBLE(CUST.RATE.treaRate)
		PRINT(CUST.RATE.diffrate100)


		
		IF (CDOUBLE(CUST.RATE.diff2)< 0 ) THEN
		#{
			CUST.RATE.diff2 = CDOUBLE(CUST.RATE.diff2)* CDOUBLE(CUST.RATE.negat)
			PRINT(CUST.RATE.diff2)
			#}
		ELSE
			#{
			CUST.RATE.diff2 = CUST.RATE.diff2
			PRINT(CUST.RATE.diff2)
		#}
		ENDIF

		IF (CDOUBLE(CUST.RATE.chkrate) < CDOUBLE(CUST.RATE.diff2)) THEN
		#{
			CUST.RATE.resultMsg ="N"
		#}

		ELSE

		#{
			CUST.RATE.resultMsg ="Y"
			
		#}
		ENDIF

	
		IF (CDOUBLE(CUST.RATE.diff)< 0 ) THEN
		#{
			CUST.RATE.diff = CDOUBLE(CUST.RATE.diff)* CDOUBLE(CUST.RATE.negat)
			PRINT(CUST.RATE.diff)
			#}
		ELSE
			#{
			CUST.RATE.diff = CUST.RATE.diff
			PRINT(CUST.RATE.diff)
		#}
		ENDIF
		
		PRINT(CUST.RATE.diff)
		
		IF (BANCS.STDIN.contextBankId == "54") THEN
		#{
			PRINT(CUST.RATE.chkrate)
			IF (CDOUBLE(CUST.RATE.chkrate) < CDOUBLE(CUST.RATE.diff)) THEN
			#{

				IF (CDOUBLE(CUST.RATE.diffrate100) < CDOUBLE(CUST.RATE.existcheck)) THEN
				#{

					IF ((CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass1)) AND (CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass2))) THEN
					#{
						
						CUST.RATE.resultMsg ="N"
						#}
					ELSE
						#{
						CUST.RATE.resultMsg ="Y"
					#}
					ENDIF
				#}
				ELSE
				#{

				CUST.RATE.resultMsg ="N"

				#}
				ENDIF

			#}
			ENDIF
		#}
		ENDIF
		
		IF ((BANCS.STDIN.contextBankId == "56") OR (BANCS.STDIN.contextBankId == "11") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50")) THEN
		#{
			IF (CDOUBLE(CUST.RATE.chkrate) < CDOUBLE(CUST.RATE.diff)) THEN
			#{
				IF (CDOUBLE(CUST.RATE.diffrate100) < CDOUBLE(CUST.RATE.existcheck)) THEN
				#{

					IF ((CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass1)) AND (CINT(BANCS.STDIN.userWorkClass) != CINT(CUST.RATE.userWorkClass2))) THEN
					#{
						CUST.RATE.resultMsg ="N"
						#}
					ELSE
						#{
						CUST.RATE.resultMsg ="Y"
					#}
					ENDIF
				#}
				ELSE
				#{

				CUST.RATE.resultMsg ="N"

				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		IF (CUST.RATE.resultMsg != "") THEN
		#{
			sv_g = "RESULT_MSG|" + CUST.RATE.resultMsg
			sv_z = urhk_SetOrbOut(sv_g)
			PRINT(sv_z)
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
