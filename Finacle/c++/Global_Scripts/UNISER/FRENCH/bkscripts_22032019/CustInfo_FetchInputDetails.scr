        #{

                CUST.INTERFACE.solId =("BANCS").("INPUT").(sv_v)
        #}
        ELSE
        #{
                CUST.INTERFACE.errorCode = "ERR091"
                CUST.INTERFACE.successOrFailure = "F"

                GOTO FINISH
        #}
        ENDIF        

        sv_v = "CustInfo_REQ.PaymentType"
