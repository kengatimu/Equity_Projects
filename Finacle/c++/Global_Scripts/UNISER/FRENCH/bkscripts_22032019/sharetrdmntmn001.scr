			PRINT("User Id Password is not set, taking default value")
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			
			print(BANCS.OUTPARAM.envValue)
			CUST.DATA.upldPath = BANCS.OUTPARAM.envValue
			#		CUST.DATA.upldPath = "/database2/EQUITY/DATFILES/"
			PRINT(CUST.DATA.upldPath)
			BANCS.INPUT.upldPath = CUST.DATA.upldPath
			## TOL - 367144
			#---------------------------------------------------------------
			# Calling common script to append userId to upload file path
			#---------------------------------------------------------------
			CALL("appendUserId.scr")
			CUST.DATA.upldPath = BANCS.INPUT.upldPath
			PRINT(CUST.DATA.upldPath)
			
		#}
		ENDIF
		#------------------------------------------------------------
		# checking if the upload file exists
		#------------------------------------------------------------
		sv_s = "sysdate|"
		sv_s = sv_s + "SELECT TO_CHAR(sysdate,'ddmmyyyyHH24MISS') "
		sv_s = sv_s + "FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d == 0) THEN
		#{
			
			CUST.DATA.sysdate = BANCS.OUTPARAM.sysdate
		#}
		ENDIF
		print(sv_d)
		print(BANCS.INPUT.upldFile)
		sv_a = "test -f " + CUST.DATA.upldPath + BANCS.INPUT.upldFile
		sv_r = SYSTEM(sv_a)
		PRINT(sv_r)
		sv_a = "sed 's/$/|'" + BANCS.STDIN.contextBankId + "'/g' " + CUST.DATA.upldPath + "/" + BANCS.INPUT.upldFile  + " > sharetmp_" + CUST.DATA.sysdate + ".txt "
		print(sv_a)
		sv_r = SYSTEM(sv_a)
		PRINT(sv_r)
		IF (sv_r != 0) THEN
		#{
			sv_e = "The Upload File name does not exist OR the wrong uploadfile name"
			sv_m = "upldFile"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.DATA.fileNameNew = "sharetmp_" + CUST.DATA.sysdate + ".txt "
		print(CUST.DATA.fileNameNew)
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The following step is to Validate test flag
	#---------------------------------------------------------------------------
	PRINT(BANCS.INPUT.test)
	IF (BANCS.INPUT.test=="") THEN
