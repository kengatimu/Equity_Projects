	PRINT(sv_t)
	
	sv_u = SYSTEM(sv_t)
	PRINT(sv_u)
	#---------------------------------------------------------------------------
	#Processing the uploaded file
	#---------------------------------------------------------------------------
	sv_u="name|SELECT SUBSTR('" + BANCS.INPUT.upldFile + "',1,INSTR('" + BANCS.INPUT.upldFile + "','.') - 1) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_u)
	PRINT(sv_d)
	IF (sv_d ==0) THEN
	#{
		#---------------------------------------------------------------------------
		# Adding sysdate to the file name
		# Changes done by Pankaj
		#---------------------------------------------------------------------------
