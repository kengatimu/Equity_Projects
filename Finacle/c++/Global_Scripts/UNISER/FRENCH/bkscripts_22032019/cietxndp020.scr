					#}
					ENDIF
					#}
				ELSE
					#{
					sv_s = sv_e + "|N"
					sv_u = urhk_putCustomException(sv_s)
					PRINT(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.CIETXN.srvErrorType = "X"
				CUST.CIETXN.srvError = "Y"
				sv_b = "Unable to ignore Exception Code "+sv_e
				sv_g = "Error_" + FORMAT$(sv_n,"%d") + "|SRV ERROR^" + sv_b + "^prodCode"
				PRINT(sv_g)
				sv_u = urhk_SetOrbOut(sv_g)
				PRINT(sv_u)
			#}
			ENDIF
			
			sv_d = sv_d + 1
			sv_n = sv_n + 1
		#}
		DO
	#}
	ENDIF
	
	IF(CUST.CIETXN.srvErrorType == "X")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.OUTPARAM.Warning_num) == 1)THEN
	#{
		sv_n = 1
		sv_d = 1
		sv_c = CINT(BANCS.OUTPARAM.Warning_num)
		WHILE (sv_d <= sv_c)
		#{
			CUST.CIETXN.srvErrorType = "W"
			sv_f = FORMAT$(sv_d,"%d")
			("CUST").("CIETXN").("WarningCode_" + sv_f) = ("BANCS").("OUTPARAM").("WarningCode_" + sv_f)
			sv_e = ("CUST").("CIETXN").("WarningCode_" + sv_f)
			PRINT(sv_e)
			sv_d = sv_d + 1
			sv_n = sv_n + 1
		#}
		DO
		
		sv_d = 1
		sv_c = CINT(BANCS.OUTPARAM.Warning_num)
		WHILE (sv_d <= sv_c)
		#{
			CUST.CIETXN.srvErrorType = "W"
			sv_f = FORMAT$(sv_d,"%d")
			sv_e = ("BANCS").("OUTPARAM").("WarningCode_" + sv_f)
			PRINT(sv_e)
			
			IF(CUST.CIETXN.srvcallmode == "E")THEN
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_e = ("CUST").("CIETXN").("WarningCode_" + sv_f)
				PRINT(sv_e)
				sv_s = sv_e + "|N"
				sv_u = urhk_putCustomException(sv_s)
				PRINT(sv_u)
				#}
			ELSE
				#{
				CUST.CIETXN.srvErrorType = "W"
				CUST.CIETXN.srvError = "Y"
				sv_b = "Unable to ignore Warning Code "+sv_e
				sv_g = "Error_" + FORMAT$(sv_n,"%d") + "|SRV ERROR^" + sv_b + "^prodCode"
				PRINT(sv_g)
				sv_u = urhk_SetOrbOut(sv_g)
				PRINT(sv_u)
			#}
			ENDIF
			
			sv_d = sv_d + 1
			sv_n = sv_n + 1
		#}
		DO
	#}
	ENDIF
	
	IF(CUST.CIETXN.srvErrorType == "W")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.srvError = "N"
	
	ENDOFSCRIPT:
		
END-->
