		sv_s = sv_s + "  USER_WORK_CLASS,TO_CHAR(USER_TMP_WRK_CLASS_EFF_UPTO,'DD-MM-YYYY'),USER_TEMP_WORK_CLASS,a.USER_ID,EMP_NAME,HOME_BANK_ID,a.SOL_ID,cif_id"
