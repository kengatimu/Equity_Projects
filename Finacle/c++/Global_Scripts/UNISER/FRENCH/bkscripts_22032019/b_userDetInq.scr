		sv_s = sv_s + " AND d.CUST_EMP_ID = c.EMP_ID"
		sv_s = sv_s + " AND a.USER_EMP_ID=d.CUST_EMP_ID"
		sv_s = sv_s + " AND a.user_id = b.user_id"
