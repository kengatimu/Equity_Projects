			print(CUST.DATA.USER_TMP_WRK_CLASS_EFF_UPTO)
			CUST.DATA.USER_TEMP_WORK_CLASS 		= BANCS.OUTPARAM.USER_TEMP_WORK_CLASS
			print(CUST.DATA.USER_TEMP_WORK_CLASS)
			
			
			IF  (CUST.DATA.DccId =="MDE")THEN
			#{
				CUST.DATA.USER_ID 		= BANCS.OUTPARAM.USER_ID
				CUST.DATA.EMP_NAME  		= BANCS.OUTPARAM.FULL_NAME
				CUST.DATA.HOME_BANK_ID 		= BANCS.OUTPARAM.BANK_ID
				CUST.DATA.SOL_ID 	= BANCS.OUTPARAM.BRANCH_ID
				CUST.DATA.CIF 		        = BANCS.OUTPARAM.CIF
			#}
			ENDIF
			
			
			#				print(CUST.DATA.DEL_FLG)
			#				print(CUST.DATA.USER_ACCT_EXPY_DATE)
			#				print(CUST.DATA.ENTITY_CRE_FLG)
			#				print(CUST.DATA.USER_DISABLED_UPTO_DATE)
			#				print(CUST.DATA.USER_WORK_CLASS)
			#				print(CUST.DATA.USER_TMP_WRK_CLASS_EFF_UPTO)
			#				print(CUST.DATA.USER_TEMP_WORK_CLASS)
			#				print(CUST.DATA.USER_ID)
			#				print(CUST.DATA.EMP_NAME)
			#				print(CUST.DATA.HOME_BANK_ID)
			#				print(CUST.DATA.SOL_ID)
			#				print(CUST.DATA.CIF)
			
			
			IF (CUST.DATA.DccId=="EXP") THEN
			#{
				# added by robert
				sv_z = urhk_SetOrbOut("code|1")
				
				IF (CUST.DATA.DEL_FLG !="N") THEN
				#{
