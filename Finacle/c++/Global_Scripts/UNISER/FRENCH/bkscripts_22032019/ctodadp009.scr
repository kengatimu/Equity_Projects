#----------------------------------------------------------------------------------------------------------
# Filename              :       ctodadp009.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to check that userId is valid for selected mode or not.
# Input                 :       User ID
# Output                :       None
# Called Script         :       None
# Calling Script        :       ctodamn001.scr, ctodamn004.scr, ctodamn005.scr
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           24-04-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="d1ef18cbf8b8fa8c52cca067cbdf0035723009a12fe092ce6d5cfbc77cb0159a"
	TRACE ON
	print(CUST.CTODA.userId)
	#------------------------------------------------------------------------------
	# Selecting user id class.
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.CTODA.userId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "userIdClass|"
	sv_s = sv_s + " SELECT USER_WORK_CLASS"
	sv_s = sv_s + " FROM TBAADM.UPR "
	sv_s = sv_s + " WHERE USER_ID = ?SVAR"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		CUST.INTERFACE.errorCode = "CTODA_ERR_012"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
		CUST.CTODA.fieldName = "abc"
		CUST.CTODA.successFlg = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.CTODA.userIdClass = TRIM(BANCS.OUTPARAM.userIdClass)
		print(CUST.CTODA.userIdClass)
		
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# fetching user Id classes allowed on basis of funcCode.
	#------------------------------------------------------------------------------
	IF (CUST.CTODA.funcCode == "A") THEN
	#{
		# CATOD Maker users class fetch
		CUST.INTERFACE.errorCode = "CTODA_MAKER"
		CALL("CATOD_GetParameterDesc.scr")
		IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
		#{
			CUST.CTODA.errorMsg = "Could not fetch parameter value for " +  CUST.INTERFACE.errorCode
			CUST.CTODA.fieldName = "abc"
			CUST.CTODA.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.CTODA.userClasses = CUST.INTERFACE.errorDesc
		print(CUST.CTODA.userClasses)
		GOTO USERCHECK
	#}
	ENDIF
	IF ((CUST.CTODA.funcCode == "V") OR (CUST.CTODA.funcCode == "X")) THEN
	#{
		# CATOD Checker users class fetch
		CUST.INTERFACE.errorCode = "CTODA_CHECKER"
		CALL("CATOD_GetParameterDesc.scr")
		IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
		#{
			CUST.CTODA.errorMsg = "Could not fetch parameter value for " +  CUST.INTERFACE.errorCode
			CUST.CTODA.fieldName = "abc"
			CUST.CTODA.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.CTODA.userClasses = CUST.INTERFACE.errorDesc
		print(CUST.CTODA.userClasses)
		GOTO USERCHECK
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	USERCHECK:
		
		# CPARAM value cant be blank.
		IF ( TRIM(CUST.CTODA.userClasses) == "") THEN
		#{
			CUST.CTODA.errorMsg = "Parameter value for " +  CUST.INTERFACE.errorCode + " is blank."
			CUST.CTODA.fieldName = "abc"
			CUST.CTODA.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		print(CUST.CTODA.userClasses)
		#sv_a = 1
		sv_l = STRLEN(CUST.CTODA.userClasses)
		print(sv_l)
		WHILE(sv_l > 0)
		#{
			sv_g = GETPOSITION(CUST.CTODA.userClasses,",")
			print(sv_g)
			IF (sv_g == 0) THEN
			#{
				CUST.CTODA.classValue = TRIM(CUST.CTODA.userClasses)
				print(CUST.CTODA.classValue)
				CUST.CTODA.userClasses = ""
				#}
			ELSE
				#{
				CUST.CTODA.classValue = TRIM(MID$(CUST.CTODA.userClasses,0,sv_g - 1))
				CUST.CTODA.userClasses = MID$(CUST.CTODA.userClasses,sv_g,sv_l)
			#}
			ENDIF
			print(CUST.CTODA.classValue)
			IF (CUST.CTODA.userIdClass == CUST.CTODA.classValue) THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			print(CUST.CTODA.userClasses)
			sv_l = STRLEN(CUST.CTODA.userClasses)
			print(sv_l)
			IF (sv_l == 0) THEN
			#{
				CUST.INTERFACE.errorCode = "CTODA_ERR_013"
				CALL("Common_Interface_GetErrorDesc.scr")
				CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
				CUST.CTODA.fieldName = "abc"
				CUST.CTODA.successFlg = "F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		DO
		
		
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
