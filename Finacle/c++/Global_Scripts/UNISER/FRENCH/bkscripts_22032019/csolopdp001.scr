	#-----------------------------------------------------------------------------------------------
	# Validation for unposted transactions
	#-----------------------------------------------------------------------------------------------
	sv_s = "Count|select COUNT(distinct tran_id) from tbaadm.DTD "
	sv_s = sv_s + " WHERE DTD.dth_init_sol_id = ?SVAR "
	sv_s = sv_s + " AND DTD.pstd_flg != 'Y' "
	sv_s = sv_s + " AND DTD.del_flg = 'N'"
	sv_s = sv_s + " AND DTD.bank_id= ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
