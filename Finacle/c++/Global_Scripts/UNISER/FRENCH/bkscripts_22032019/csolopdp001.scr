		sv_s = "echo 'CUMMs WITH SHARED NATIONAL ID exist' >>"+CUST.DATA.fileName
		print(sv_s)
		sv_a = system(sv_s)
		print(sv_a)
		sv_y = 1
	#}
	ENDIF
	### end start cumm shared IDS ####
	
	
	#-----------------------------------------------------------------------------------------------
	# Validation of proxy accounts zeroization
	#-----------------------------------------------------------------------------------------------
	sv_s = "Count|SELECT count(1) from GAM where CLR_BAL_AMT !=0 "
	sv_s = sv_s + " AND bacid='PROXY' "
	sv_s = sv_s + " AND GAM.sol_id = ?SVAR "
	sv_s = sv_s + " AND GAM.acct_cls_flg='N' "
	sv_s = sv_s + " AND GAM.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND GAM.bank_id= ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0 ) THEN
	#{
		sv_k = BANCS.OUTPARAM.Count
		print(sv_k)
		IF (CINT(BANCS.OUTPARAM.Count) > 1000 ) THEN
		#{
			BANCS.INPUT.RET = "1"
			BANCS.OUTPUT.successOrFailure = "F"
			sv_s = "echo 'Unzerolised Proxy Account Exist for the sol' >>"+CUST.DATA.fileName
			print(sv_s)
			sv_a = system(sv_s)
			print(sv_a)
			sv_y = 1
		#}
		ENDIF
		#}
	ELSE
		#{
		BANCS.INPUT.RET = "1"
		BANCS.OUTPUT.successOrFailure = "F"
		sv_s = "echo 'Unzerolised Proxy Account Exist for the sol' >>"+CUST.DATA.fileName
		print(sv_s)
		sv_a = system(sv_s)
		print(sv_a)
		sv_y = 1
	#}
	ENDIF
	
	SKIP4:
		
		IF ( sv_y == 1 ) THEN
		#{
			#--------------------------------------------------------------------------------------------------------------
			# For HPR Entry
			#--------------------------------------------------------------------------------------------------------------
			sv_s = "babx4040 ${B2K_SESSION_ID} "+CUST.DATA.fileName+' '+'"'+"EOD Validation Failure Report" + '"' + " MANAGER 1 N"
			print(sv_s)
