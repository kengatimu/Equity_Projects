#------------------------------------------------------------------------------
#    Name			: ast0057dp001.scr
#    Description	: This script is used for the simple validation
#					: count in HLADISB menu.
#    Date			: 13-06-2013
#    Author			: prashanth
#    Input			: NA
#    Output			: NA
#    Called jsp		: ladisb_tran_details_custom.jsp
#    Calling Script	: NA
#    Menu Option	: HLADISB
#    Srl. No			Date		Author		Description.
#    ------			----------	-------			---------------
#    1.0			13-06-2013	prashanth		Original Version
#    2.0			27-06-2013	prashanth		made some logical changes.
#    3.0			10-07-2013	Bharath			Trim command added.
#------------------------------------------------------------------------------
<--START
CHECKSUM="f100a72892c3a9b97fc8d9501abf42777c34b275aaeb40e3347ca45b1b01321c"
	TRACE ON
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	# 	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	CUST.LADISB.errMsg       = ""
	
	sv_u = urhk_Setorbout("Error|dummy")
	sv_u = urhk_Setorbout("count|dummy")
	sv_u = urhk_Setorbout("osAmt|dummy")
	
	CUST.LADISB.foracid= TRIM(BANCS.INPUT.foracid)
	print(CUST.LADISB.foracid)
	
	#-------------------------------------------------------------------------------------------
	# Getting schmCode
	#-------------------------------------------------------------------------------------------
	sv_s = ""
	sv_s = "schmCode|SELECT SCHM_CODE "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE GAM.FORACID = ?SVAR "
	sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
	sv_s = sv_s + "AND GAM.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y'"
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in calculating schm code"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.schmCode= BANCS.OUTPARAM.schmCode
		print(BANCS.OUTPARAM.schmCode)
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------------------------
	#calculating count of acids for the given cif id
	#--------------------------------------------------------------------------------------------
	sv_s = ""
	sv_s = "countAcid|SELECT count(acid) "
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE GAM.schm_code = ?SVAR "
	sv_s = sv_s + " AND GAM.cif_id = ( "
	sv_s = sv_s +			     	" SELECT GAM.cif_id "
	sv_s = sv_s +	                   	" FROM TBAADM.GAM "
	sv_s = sv_s +			     	" WHERE GAM.foracid = ?SVAR "
	sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N' "
	sv_s = sv_s + 			" AND GAM.del_flg = 'N' "
	sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + 			" AND GAM.bank_id = ?SVAR) "
	sv_s = sv_s + " AND GAM.acct_cls_flg = 'N' "
	sv_s = sv_s + " AND GAM.del_flg = 'N' "
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + " AND GAM.CLR_BAL_AMT != 0 "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND GAM.foracid != ?SVAR "
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.schmCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid  + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in calculating no. of accounts"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.countAcid= BANCS.OUTPARAM.countAcid
		print(CUST.LADISB.countAcid)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.LADISB.errMsg != "") THEN
		#{
			sv_u = urhk_Setorbout("Error|"+CUST.LADISB.errMsg)
			PRINT(CUST.LADISB.errMsg)
			#}
		ELSE
			#{
			sv_u = urhk_Setorbout("count|"+CUST.LADISB.countAcid)
			PRINT(CUST.LADISB.countAcid)
		#}
		ENDIF
		
		EXITSCRIPT
		
		TRACE OFF
END-->
