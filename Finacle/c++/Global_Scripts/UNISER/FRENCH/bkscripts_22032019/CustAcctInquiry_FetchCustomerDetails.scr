#----------------------------------------------------------------------------------------------------------
# Filename              :       CustAcctInquiry_FetchCustomerDetails.scr
# Author                :       Venkatesh T R
# Description           :       This script fetches the values of a given Customer ID
# Input                 :       Customer ID
# Output                :       Success or Failure
# Called Script         :       CustAcctInquiry_FetchCustAddress.scr
# Calling Script        :       CustAcctInquiry_main.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Venkatesh          Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
#trace on

	#++++++++++++++++++++++++++++++++++ Ken +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	sv_a = urhk_GetChannelInfo("")
        print(sv_a)
        CUST.INTERFACE.DccId =BANCS.OUTPARAM.DccId
        print(CUST.INTERFACE.DccId)
	IF(CUST.INTERFACE.DccId=="FNT") THEN
		CUST.INTERFACE.CustVerifyStatus	= ""
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankID + "|" + CUST.INTERFACE.customerID
		sv_s = "recordstatus | select recordstatus from crmuser.accounts where bank_id=?SVAR and orgkey=?SVAR "
		sv_d = urhk_dbSelectWithBind(sv_s)
		if(sv_d==0)then
			CUST.INTERFACE.recStatus	= BANCS.OUTPARAM.recordstatus
		else
			CUST.INTERFACE.recStatus	= "" 
		endif
		if(CUST.INTERFACE.recStatus == "I")then
			CUST.INTERFACE.CustVerifyStatus = "N"
		endif
		if(CUST.INTERFACE.recStatus == "A")then
			CUST.INTERFACE.CustVerifyStatus = "Y"
		endif
	ENDIF
	#++++++++++++++++++++++++++++++++++ Ken +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	#---------------------------------------------------------------------------------
	# Fetch the Customer Details from CMG table
	#---------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID
	sv_s = "custID,custShortName,custTitleCode,custName,custSex,custCommuCode,custMinorFlg,custNREFlg,"
	sv_s = sv_s + "custNationalID,custDOB,custPassportNo,custFirstName,custLastName,custCorpID,custHlth|"
	sv_s = sv_s + "SELECT CUST_ID,CUST_SHORT_NAME,CUST_TITLE_CODE,CUST_NAME,CUST_SEX,CUST_COMMU_CODE,"
	sv_s = sv_s + "CUST_MINOR_FLG,CUST_NRE_FLG,NAT_ID_CARD_NUM,to_char(DATE_OF_BIRTH,'DD-MM-YYYY'),PSPRT_NUM,"
	sv_s = sv_s + "CUST_FIRST_NAME,CUST_LAST_NAME,CORP_ID,CUST_HLTH_CODE"
	sv_s = sv_s + " FROM TBAADM.CMG WHERE CIF_ID = ?SVAR AND BANK_ID = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.INTERFACE.custID = BANCS.OUTPARAM.custID
		CUST.INTERFACE.custShortName = BANCS.OUTPARAM.custShortName
		CUST.INTERFACE.custTitleCode = BANCS.OUTPARAM.custTitleCode
		CUST.INTERFACE.custName = BANCS.OUTPARAM.custName
		CUST.INTERFACE.custSex = BANCS.OUTPARAM.custSex
		CUST.INTERFACE.custCommuCode = BANCS.OUTPARAM.custCommuCode
		CUST.INTERFACE.custMinorFlg = BANCS.OUTPARAM.custMinorFlg
		CUST.INTERFACE.custNREFlg = BANCS.OUTPARAM.custNREFlg
		CUST.INTERFACE.custNationalID = BANCS.OUTPARAM.custNationalID
		CUST.INTERFACE.custDOB = BANCS.OUTPARAM.custDOB
		CUST.INTERFACE.custPassportNo = BANCS.OUTPARAM.custPassportNo
		CUST.INTERFACE.custFirstName = BANCS.OUTPARAM.custFirstName
		CUST.INTERFACE.custLastName = BANCS.OUTPARAM.custLastName
		CUST.INTERFACE.custCorpID = BANCS.OUTPARAM.custCorpID
		CUST.INTERFACE.custHlth = BANCS.OUTPARAM.custHlth
		print(CUST.INTERFACE.custID)
		print(CUST.INTERFACE.custShortName)
		print(CUST.INTERFACE.custTitleCode)
		print(CUST.INTERFACE.custName)
		print(CUST.INTERFACE.custSex)
		print(CUST.INTERFACE.custCommuCode)
		print(CUST.INTERFACE.custMinorFlg)
		print(CUST.INTERFACE.custNREFlg)
		print(CUST.INTERFACE.custNationalID)
		print(CUST.INTERFACE.custDOB)
		print(CUST.INTERFACE.custPassportNo)
		print(CUST.INTERFACE.custFirstName)
		print(CUST.INTERFACE.custLastName)
		print(CUST.INTERFACE.custCorpID)
		print(CUST.INTERFACE.custHlth)
	#}
	ELSE
	#{
		CUST.INTERFACE.successOrFailure = "F"
		CUST.INTERFACE.errorCode = "ERR002"
		GOTO ERROREXIT
	#}
	ENDIF


        #---------------------------------------------------------------------------------
        # Set Retail corporate flag
        #---------------------------------------------------------------------------------
        IF(CUST.INTERFACE.custCorpID != "") THEN
        #{
		CUST.INTERFACE.retCorpFlg = "C"
	#}
	ELSE
	#{
		CUST.INTERFACE.retCorpFlg = "R"
	#}
	ENDIF

        #---------------------------------------------------------------------------------
        # Fetch date of incorporation of the corporate customer
        #---------------------------------------------------------------------------------
        IF(CUST.INTERFACE.custCorpID != "") THEN
        #{
                BANCS.INPARAM.BINDVARS = CUST.INTERFACE.custCorpID + "|" + CUST.INTERFACE.bankID
                sv_s = "dateOfIncorp,constCode,compRegNo,secRegNo|" 
		sv_s = sv_s + " SELECT to_char(DATE_OF_INCORPORATION,'DD-MM-YYYY'),CUST_CONST_CODE,REGISTRATION_NUMBER,SECTOR "
		sv_s = sv_s + " FROM CRMUSER.CORPORATE WHERE"
                sv_s = sv_s + " CORP_ID = ?SVAR AND BANK_ID = ?SVAR"
                sv_d = urhk_dbSelectWithBind(sv_s)
                IF(sv_d == 0) THEN
                #{
                        CUST.INTERFACE.dateOfIncorp= BANCS.OUTPARAM.dateOfIncorp
                        CUST.INTERFACE.constCode= BANCS.OUTPARAM.constCode
                        CUST.INTERFACE.compRegNo= BANCS.OUTPARAM.compRegNo
                        CUST.INTERFACE.secRegNo= BANCS.OUTPARAM.secRegNo
                #}
                ELSE
                #{
                        CUST.INTERFACE.dateOfIncorp= ""
                        CUST.INTERFACE.constCode= ""
                        CUST.INTERFACE.compRegNo= ""
                        CUST.INTERFACE.secRegNo= ""
                #}
                ENDIF
        #}
        ELSE
        #{
                CUST.INTERFACE.dateOfIncorp= ""
                CUST.INTERFACE.constCode= ""
                CUST.INTERFACE.compRegNo= ""
                CUST.INTERFACE.secRegNo= ""
        #}
        ENDIF


	#---------------------------------------------------------------------------------
	# Fetch Marital Status of the customer of the customer
	#---------------------------------------------------------------------------------
	IF(CUST.INTERFACE.custCorpID == "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID
		sv_s = "custMaritalStatus,nationality|SELECT MARITAL_STATUS,NATIONALITY FROM CRMUSER.DEMOGRAPHIC WHERE"
		sv_s = sv_s + " ORGKEY = ?SVAR AND BANK_ID = ?SVAR AND rownum<2"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.custMaritalStatus = BANCS.OUTPARAM.custMaritalStatus
			CUST.INTERFACE.nationality = BANCS.OUTPARAM.nationality
		#}
		ELSE
		#{
			CUST.INTERFACE.custMaritalStatus = ""
			CUST.INTERFACE.nationality = ""
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.INTERFACE.custMaritalStatus = ""
		CUST.INTERFACE.nationality = ""
	#}
	ENDIF
        #---------------------------------------------------------------------------------
	# Fetch Financial card number of the customer of the customer
	#---------------------------------------------------------------------------------
	IF(CUST.INTERFACE.custCorpID == "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID 
		sv_s = "fincardno|select FREE_TEXT_1   from crmuser.coreinterface  where"
		sv_s = sv_s + " ORGKEY = ?SVAR AND BANK_ID = '56'"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.fincardno = BANCS.OUTPARAM.fincardno
		#}
		ELSE
		#{
			CUST.INTERFACE.fincardno = ""
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.INTERFACE.fincardno = ""
	#}
	ENDIF	
	#---------------------------------------------------------------------------------
	# Get Asset Classification Details
	#---------------------------------------------------------------------------------	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.custID + "|" + CUST.INTERFACE.bankID
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "CUSTR" + "|" + "Y" + "|" + "N"	
	sv_s = "userSubClassification|SELECT SUB_CLASSIFICATION_USER FROM TBAADM.ACD WHERE"
	sv_s = sv_s + " B2K_ID = ?SVAR AND BANK_ID = ?SVAR AND B2K_TYPE = ?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG = ?SVAR AND DEL_FLG = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN	
	#{
		CUST.INTERFACE.userSubClassification = BANCS.OUTPARAM.userSubClassification
	#}
	ELSE
	#{
		CUST.INTERFACE.userSubClassification = ""
	#}
	ENDIF	

	#---------------------------------------------------------------------------------
	# Fetch Customer Permanent and Communication Address
	#---------------------------------------------------------------------------------
	CALL("CustAcctInquiry_FetchCustAddress.scr")
	
#trace off
end-->
