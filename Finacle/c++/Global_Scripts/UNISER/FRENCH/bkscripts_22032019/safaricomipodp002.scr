<--START
CHECKSUM="edc2012764fa0a3abfa25164513f4b7efc2fb23438e78ff2b7da1d9772a299c0"
	TRACE ON
	
	IF(BANCS.STDIN.contextBankId == "11" ) THEN
	#{
		
		#--------------------------------------------------------------------------------
		# Creating repos and class
		#--------------------------------------------------------------------------------
		IF (REPEXISTS("CUST") == 0) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF
		
