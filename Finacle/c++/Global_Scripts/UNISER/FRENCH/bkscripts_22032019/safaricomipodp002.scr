		#{
			PRINT(BANCS.OUTPARAM.bacid)
			CUST.TMCHARGES.acctBacid = BANCS.OUTPARAM.bacid
			#}
		ELSE
			#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_f = GETPOSITION(CUST.TMCHARGES.bacid,"!"+CUST.TMCHARGES.acctBacid+"!")
		PRINT(sv_f)
		
		IF( sv_f > 0 ) THEN
		#{
			sv_b = "Sucess|" + " "
			sv_z = urhk_SetOrbOut(sv_b)
			
		#}
		ENDIF
		
		
		ENDOFSCRIPT:
			
			IF (CUST.TMCHARGES.errMsg != "") THEN
			#{
				sv_b = "Error|" + CUST.TMCHARGES.errMsg
				sv_z = urhk_SetOrbOut(sv_b)
			#}
			ENDIF
			
			#}
		ELSE
			#{
			sv_b = "DIF|SUDAN"
			sv_z = urhk_SetOrbOut(sv_b)
		#}
		ENDIF
		
		
