<--START
CHECKSUM="67273dc028e499be4e84dd038f430478360308465bb367974efb36bf6d31b49e"
	#TRACE ON
	#============================================================
	# Creating Repository
	#============================================================
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	#sv_u = urhk_B2k_printRepos("BANCS")
	#============================================================
	# Values From Front End
	#============================================================
	sv_z = urhk_SRV_GetVal("instrmntDtl.instrmntNum")
	print(sv_z)
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.instNum=BANCS.OUTPARAM.srvValue
	sv_b = LTRIM(CUST.DATA.instNum,' ')
	CUST.DATA.instNum=sv_b
	
	sv_z = urhk_SRV_GetVal("instrmntDtl.instrmntAmt")
	print(sv_z)
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.insAmt=BANCS.OUTPARAM.srvValue
	
	sv_z = urhk_SRV_GetVal("instrmntDtl.instrmntType.type")
	print(sv_z)
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.instType=BANCS.OUTPARAM.srvValue
	
	sv_z = urhk_SRV_GetVal("instrmntDtl.instrmntDate")
	print(sv_z)
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.instDate=BANCS.OUTPARAM.srvValue
	
	sv_z = urhk_SRV_GetVal("instrmntDtl.acct.foracid")
	print(sv_z)
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.acctNo=BANCS.OUTPARAM.srvValue
	
	sv_z = urhk_SRV_GetVal("instrmntDtl.acct.solId")
	print(sv_z)
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.solID=BANCS.OUTPARAM.srvValue
	
	sv_z = urhk_SRV_GetVal("instrmntDtl.acct.crncyCode")
	print(sv_z)
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.acctCcy=BANCS.OUTPARAM.srvValue
	
	CUST.DATA.funcCode = ""
	
	IF (FIELDEXISTS(CUST.DATA.functionCode) == 1) THEN
	#{
		CUST.DATA.funcCode = CUST.DATA.functionCode
		print(CUST.DATA.funcCode)
	#}
	ENDIF
	#==========================================================
	#Validation for InstNum and InstAmt
	#==========================================================
	sv_b = "|"
	sv_c = GETPOSITION(CUST.DATA.insAmt , sv_b)-1
	sv_e = MID$(CUST.DATA.insAmt,0,sv_c)
	print(sv_e)
	CUST.DATA.insAmt = sv_e
	
	sv_b = "."
	sv_c = GETPOSITION(CUST.DATA.insAmt , sv_b)
	print(sv_c)
	sv_d = STRLEN(CUST.DATA.insAmt)
	print(sv_d)
	sv_e = MID$(CUST.DATA.insAmt,sv_c,sv_d)
	print(sv_e)
	sv_a = CINT(sv_e)/5
	print(sv_a)
	sv_c = CDOUBLE(sv_e)/5
	print(sv_c)
	
	IF (sv_c > sv_a) THEN
	#{
		IF((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "56")) THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.acctNo + "|" + BANCS.STDIN.contextBankId
			sv_s = "schmType|SELECT SCHM_TYPE FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
			#{
				CUST.DATA.schmType = BANCS.OUTPARAM.schmType
				#}
			ELSE
				#{
				CUST.DATA.schmType = ""
			#}
			ENDIF
			print(CUST.DATA.schmType)
			IF(CUST.DATA.schmType != "DDA") THEN
			#{
				IF(CUST.DATA.acctCcy == BANCS.STDIN.homeCrncyCode) THEN
				#{
					print("Decimal value should be multiple of 5 cents")
					sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntAmt|Decimal value should be multiple of 5 cents")
					GOTO ENDSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	sv_r = urhk_B2k_isStringNumeric(CUST.DATA.instNum)
	print(sv_r)
	IF (sv_r == 1) THEN
	#{
		sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|Only Numerics allowed in instr No")
		GOTO ENDSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="ICLG_MAXLEN"
	call("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.maxLen = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ECS.errMsg = BANCS.INPUT.parameterId+" setup is not done in CPARAM"
		sv_u = urhk_SRV_SetErr(CUST.ECS.errMsg)
		GOTO ENDSCRIPT
	#}
	ENDIF
	
	print(CUST.DATA.instNum)
	sv_b = LTRIM(CUST.DATA.instNum,' ')
	print(sv_b)
	sv_q = STRLEN(sv_b)
	print(sv_q)
	IF (sv_q > CINT(CUST.DATA.maxLen)) THEN
	#{
		sv_a="Instrument Number can not be greater than "+CUST.DATA.maxLen+" in length"
		print("Instrument Number can not be greater than "+CUST.DATA.maxLen+" in length")
		sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|"+sv_a)
		GOTO ENDSCRIPT
	#}
	ENDIF
	
	
	IF ((CUST.DATA.funcCode == "A") OR (CUST.DATA.funcCode == "M")) THEN
	#{
		#============================================================
		#Cheque validation
		#============================================================
		
		IF (CUST.DATA.instType == "") THEN
		#{
			GOTO ENDSCRIPT
		#}
		ENDIF
		
		sv_s = "count|SELECT count(1) "
		sv_s = sv_s + " FROM CUSTOM.C_CBT_INT "
		sv_s = sv_s + " WHERE INST_TYPE = ?SVAR "
		sv_s = sv_s + " AND del_flg!='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		print(BANCS.OUTPARAM.count)
		
		IF (CINT(BANCS.OUTPARAM.count) != 0) THEN
		#{
			IF (CUST.DATA.instDate == "") THEN
			#{
				print("Instrument Date should be enterd")
				sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntDate|Instrument Date should be enterd")
				GOTO ENDSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			GOTO ENDSCRIPT
		#}
		ENDIF
		
		sv_s = "acid,chqIssuDate,beginChqNum,chqNumOfLvs,chqLvsStat,"
		sv_s = sv_s + " numPaid,numUnused,numStoped,numDestroyed|"
		sv_s = sv_s + " SELECT acid,chq_issu_date,begin_chq_num,chq_num_of_lvs, "
		sv_s = sv_s + " chq_lvs_stat,num_paid,num_unused,num_stoped,num_destroyed"
		sv_s = sv_s + " FROM CUSTOM.C_CBT "
		sv_S = sv_S + " WHERE inst_type = ?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND TO_NUMBER(begin_chq_num) <= TO_NUMBER(?SVAR) "
		sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num)+chq_num_of_lvs-1) >= TO_NUMBER(?SVAR)"
		sv_s = sv_s + " AND (TO_NUMBER(?SVAR) BETWEEN TO_NUMBER(begin_chq_num) "
		sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num) + chq_num_of_lvs - 1)) "
		sv_s = sv_s + " AND chq_issu_date <= TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND del_flg!='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + CUST.DATA.acctNo + "|" + CUST.DATA.instNum + "|" + CUST.DATA.instNum + "|" + CUST.DATA.instNum + "|" + MID$(CUST.DATA.instDate,0,10) + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d != 0) THEN
		#{
			print("cheque not issued")
			sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|Cheque not issued")
			GOTO ENDSCRIPT
		#}
		ENDIF
		
		CUST.DATA.acid = BANCS.OUTPARAM.acid
		CUST.DATA.chqIssuDate = BANCS.OUTPARAM.chqIssuDate
		CUST.DATA.beginChqNum = BANCS.OUTPARAM.beginChqNum
		CUST.DATA.chqNumOfLvs = BANCS.OUTPARAM.chqNumOfLvs
		CUST.DATA.chqLvsStat = BANCS.OUTPARAM.chqLvsStat
		CUST.DATA.numPaid = BANCS.OUTPARAM.numPaid
		CUST.DATA.numUnused = BANCS.OUTPARAM.numUnused
		CUST.DATA.numStoped = BANCS.OUTPARAM.numStoped
		CUST.DATA.numDestroyed = BANCS.OUTPARAM.numDestroyed
		
		print(CUST.DATA.beginChqNum)
		print(CUST.DATA.chqNumOfLvs)
		print(CUST.DATA.chqLvsStat)
		print(CUST.DATA.numPaid)
		print(CUST.DATA.numUnused)
		print(CUST.DATA.numStoped)
		print(CUST.DATA.numDestroyed)
		
		#============================================================
		# Finding The status of the field
		#============================================================
		print(CUST.DATA.instNum)
		
		IF (CUST.DATA.instNum != CUST.DATA.beginChqNum) THEN
		#{
			CUST.DATA.temp = CINT(CUST.DATA.instNum) - CINT(CUST.DATA.beginChqNum)
			print(CUST.DATA.temp)
			#}
		ELSE
			#{
			CUST.DATA.temp = "0"
			print(CUST.DATA.temp)
		#}
		ENDIF
		
		print(CUST.DATA.temp)
		CUST.DATA.temp = CINT(CUST.DATA.temp) + CINT("1")
		print(CUST.DATA.temp)
		CUST.DATA.numLvs = "1"
		sv_n = "substr(CHQ_LVS_STAT," + CUST.DATA.temp + "," + CUST.DATA.numLvs + ")"
		print(sv_n)
		
		sv_s = "currentStatus|"
		sv_s = sv_s + " SELECT " + sv_n
		sv_s = sv_s + " FROM CUSTOM.C_CBT "
		sv_S = sv_S + " WHERE inst_type = ?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND TO_NUMBER(begin_chq_num) <= TO_NUMBER(?SVAR) "
		sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num)+chq_num_of_lvs-1) >= TO_NUMBER(?SVAR)"
		sv_s = sv_s + " AND (TO_NUMBER(?SVAR) BETWEEN TO_NUMBER(begin_chq_num) "
		sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num) + chq_num_of_lvs - 1)) "
		sv_s = sv_s + " AND chq_issu_date <= TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND del_flg!='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + CUST.DATA.acctNo + "|" + CUST.DATA.instNum + "|" + CUST.DATA.instNum + "|" + CUST.DATA.instNum + "|" + MID$(CUST.DATA.instDate,0,10) + "|" + BANCS.STDIN.contextBankId
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d != 0) THEN
		#{
			print("DataBase Error. Contact your DBA")
			sv_u = urhk_SRV_SetErr("DataBase Error. Contact your DBA")
			GOTO ENDSCRIPT
		#}
		ENDIF
		
		CUST.DATA.currentStatus = TRIM(BANCS.OUTPARAM.currentStatus)
		print(CUST.DATA.currentStatus)
		
		IF (CUST.DATA.currentStatus == "P") THEN
		#{
			print("Cheque already paid")
			sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|Cheque already paid")
			GOTO ENDSCRIPT
		#}
		ENDIF
		
		IF (CUST.DATA.currentStatus == "S") THEN
		#{
			print("Cheque stoped")
			sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|Cheque stoped")
			GOTO ENDSCRIPT
		#}
		ENDIF
		
		IF (CUST.DATA.currentStatus == "D") THEN
		#{
			print("Cheque destroyed")
			sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|Cheque destroyed")
			GOTO ENDSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	ENDSCRIPT :
		#TRACE OFF
END-->
