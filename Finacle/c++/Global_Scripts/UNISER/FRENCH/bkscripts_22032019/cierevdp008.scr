	sv_s = sv_s + " AND IE_TXN_REF_NO = ?SVAR"
	sv_s = sv_s + " AND NVL(ENTITY1_TRAN_DATE,CHARGE_TRAN_DATE) = TO_DATE(?SVAR,'DD-MM-YYYY')"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIEREV.ieTxnRefNo + "|" + CUST.CIEREV.entity1TranDate
	print(BANCS.INPARAM.BINDVARS)
	
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
