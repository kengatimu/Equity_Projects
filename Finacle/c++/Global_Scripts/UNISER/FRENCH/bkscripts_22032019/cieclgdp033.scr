	CUST.CIECLG.instrumentEntity = " "
	
	CUST.CIECLG.errorFlg = "N"
	CUST.CIECLG.errorMsg = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentBankCode))THEN
	#{
