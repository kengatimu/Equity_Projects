	sv_s = "instrumentBankCode,instrumentBankName,delFlg|"
	sv_s = sv_s + " SELECT BANK_CODE,NVL(BANK_NAME,'-'),DEL_FLG"
	sv_s = sv_s + " FROM TBAADM.BANK_CODE_TABLE"
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
	sv_s = sv_s + " AND BANK_CODE = ?SVAR"
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
