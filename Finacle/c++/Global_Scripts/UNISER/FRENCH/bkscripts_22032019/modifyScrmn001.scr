	ENDIF
	
	CUST.ACCT.foracid = ""
	sv_a = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.foracid")
	CUST.ACCT.foracid = BANCS.OUTPARAM.srvValue
	print(CUST.ACCT.foracid)
	
	print(BANCS.STDIN.menuId)
	print(BANCS.STDIN.contextBankId)
	IF(FIELDEXISTS(BANCS.STDIN.menuId)) THEN
	#{
		IF((BANCS.STDIN.menuId == "HOAACMSB") OR (BANCS.STDIN.menuId == "HOAACMCA") OR (BANCS.STDIN.menuId == "HOAACMLA") OR  (BANCS.STDIN.menuId == "HOAACMCL") OR (BANCS.STDIN.menuId == "HOAACMTD") OR (BANCS.STDIN.menuId == "HOAACMOD")) THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.ACCT.foracid + "|" + BANCS.STDIN.contextBankId
			sv_d = ""
			sv_d = sv_d + "creUser|SELECT RCRE_USER_ID FROM TBAADM.GAM "
			sv_d = sv_d + " WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR"
			print(sv_d)
			sv_u = urhk_dbSelectWithBind(sv_d)
			print(sv_u)
			IF(sv_u !=0) THEN
			#{
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				print(BANCS.STDIN.userId)
				CUST.ACCT.creUser = BANCS.OUTPARAM.creUser
				print(CUST.ACCT.creUser)
				IF(CUST.ACCT.creUser != BANCS.STDIN.userId) THEN
				#{
					sv_u = urhk_SRV_SetErr("Only Opened User can modify the account")
					print(sv_u)
				#}
				ENDIF
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	ENDOFSCRIPT:
END-->
