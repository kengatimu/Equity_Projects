	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_v = "lienAmt_" + FORMAT$(sv_q, "%d")
	sv_t = "CustAcctInquiry_RES.<rec_" + FORMAT$(sv_p,"%d") + ">." + "AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.LienAmount| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_v = "drawingPower_" + FORMAT$(sv_q, "%d")
	sv_t = "CustAcctInquiry_RES.<rec_" + FORMAT$(sv_p,"%d") + ">." + "AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.DrawingPower| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
	sv_u = urhk_SetOrbOut(sv_t)
	
