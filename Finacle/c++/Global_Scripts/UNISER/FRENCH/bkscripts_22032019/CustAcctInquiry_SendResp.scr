	sv_t = "CustAcctInquiry_RES.<rec_" + FORMAT$(sv_p,"%d") + ">." + "AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ModeOfOperation| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)
	
	IF  (CUST.INTERFACE.DccId =="EFR")THEN
