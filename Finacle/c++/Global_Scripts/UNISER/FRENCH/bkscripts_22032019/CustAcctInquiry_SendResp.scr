		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "flowAmt_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.<rec_" + FORMAT$(sv_p,"%d") + ">." + "AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.FlowAmount| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "flowStartDate_" + FORMAT$(sv_q, "%d")
