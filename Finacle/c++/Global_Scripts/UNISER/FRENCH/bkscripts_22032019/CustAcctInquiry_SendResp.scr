	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_v = "acctOpenDate_" + FORMAT$(sv_q, "%d")
	#-----------------------------------------------------
	# Converting to Gerigorian format
	#-----------------------------------------------------
	IF(("CUST").("INTERFACE").(sv_v) != "") THEN
	#{
		COMMON.INPUT.dateFmt = "DD-MM-YYYY"
