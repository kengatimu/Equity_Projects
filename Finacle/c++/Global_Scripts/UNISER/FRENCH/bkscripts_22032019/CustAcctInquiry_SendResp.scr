	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_v = "accountStatus_" + FORMAT$(sv_q, "%d")
	sv_t = "CustAcctInquiry_RES.<rec_" + FORMAT$(sv_p,"%d") + ">." + "AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountStatus| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)
	
