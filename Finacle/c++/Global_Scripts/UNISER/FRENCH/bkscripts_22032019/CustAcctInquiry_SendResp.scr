		sv_t = "CustAcctInquiry_RES.<rec_" + FORMAT$(sv_p,"%d") + ">." + "AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.MaturityDate| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
	#}
	ENDIF
	#--------------------------------------------------------------------------------
	# Following details are only applicable for LAA/CLA accounts
	#--------------------------------------------------------------------------------
	IF((CUST.INTERFACE.schemeType == "LAA") OR (CUST.INTERFACE.schemeType == "CLA")) THEN
