<--START
CHECKSUM="e991786535099b0a33f5815e4e93da1bbd99b5e61796566cc3aece61de578cf7"
	#TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","FOAT") == 0) THEN
	#{
		CREATECLASS("CUST","FOAT",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","SHORD") == 0) THEN
	#{
		CREATECLASS("CUST","SHORD",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","TMCHARGES") == 0) THEN
	#{
		CREATECLASS("CUST","TMCHARGES",5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.acctNum)
	IF (FIELDEXISTS(BANCS.INPUT.acctNum)) THEN
	#{
		CUST.FOAT.uAccount = BANCS.INPUT.acctNum
		PRINT(CUST.FOAT.uAccount)
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("tt| ")
		PRINT(sv_u)
		EXITSCRIPT
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.partTranType)
	IF (FIELDEXISTS(BANCS.INPUT.partTranType)) THEN
	#{
		CUST.FOAT.partTranType = BANCS.INPUT.partTranType
		PRINT(CUST.FOAT.partTranType)
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("tt| ")
		PRINT(sv_u)
		EXITSCRIPT
	#}
	ENDIF
	
	
	CUST.FOAT.msg_text_1 = ""
	CUST.FOAT.msg_text_2 = ""
	CUST.FOAT.msg_text_3 = ""
	CUST.FOAT.msg_text_4 = ""
	CUST.FOAT.msg_text_5 = ""
	CUST.FOAT.msg_text_6 = ""
	CUST.FOAT.msg_text_7 = ""
	
	
	sv_s = "foracid,msg_text_1,msg_text_2,msg_text_3,msg_text_4,msg_text_5,msg_text_6,msg_text_7|"
	sv_s = sv_s + "SELECT foracid,msg_text_1,msg_text_2,msg_text_3,msg_text_4,msg_text_5,msg_text_6,msg_text_7 "
	sv_s = sv_s + "FROM CUSTOM.C_MOP "
	sv_s = sv_s + "WHERE C_MOP.foracid = ( "
	sv_s = sv_s + "SELECT GAM.cif_id FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE GAM.bank_id = ?SVAR "
	sv_s = sv_s + "AND GAM.foracid = ?SVAR "
	sv_s = sv_s + "AND GAM.del_flg = 'N' "
	sv_s = sv_s + ") "
	sv_s = sv_s + "AND C_MOP.bank_id = ?SVAR "
	sv_s = sv_s + "AND C_MOP.del_flg = 'N' "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.FOAT.uAccount + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d != 0) THEN
	#{
		CUST.FOAT.var = "N"
		PRINT("memo pad ")
		sv_u = urhk_SetOrbOut("tt| ")
		#}
	ELSE
		#{
		CUST.FOAT.var = "-"
		
		IF (STRLEN(BANCS.OUTPARAM.msg_text_1) != "") THEN
		#{
			PRINT(CUST.FOAT.msg_text_1)
			CUST.FOAT.var = CUST.FOAT.var + "(1)" + BANCS.OUTPARAM.msg_text_1
			PRINT(CUST.FOAT.var)
		#}
		ENDIF
		
		IF (STRLEN(BANCS.OUTPARAM.msg_text_2) != 0) THEN
		#{
			CUST.FOAT.var = CUST.FOAT.var + " (2)" + BANCS.OUTPARAM.msg_text_2
		#}
		ENDIF
		
		IF (STRLEN(BANCS.OUTPARAM.msg_text_3) != 0) THEN
		#{
			CUST.FOAT.var = CUST.FOAT.var + " (3)" + BANCS.OUTPARAM.msg_text_3
		#}
		ENDIF
		
		IF (STRLEN(BANCS.OUTPARAM.msg_text_4) != 0) THEN
		#{
			CUST.FOAT.var = CUST.FOAT.var + " (4)" + BANCS.OUTPARAM.msg_text_4
		#}
		ENDIF
		
		IF (STRLEN(BANCS.OUTPARAM.msg_text_5) != 0) THEN
		#{
			CUST.FOAT.var = CUST.FOAT.var + " (5)" + BANCS.OUTPARAM.msg_text_5
		#}
		ENDIF
		
		IF (STRLEN(BANCS.OUTPARAM.msg_text_6) != 0) THEN
		#{
			CUST.FOAT.var = CUST.FOAT.var + " (6)" + BANCS.OUTPARAM.msg_text_6
		#}
		ENDIF
		
		IF (STRLEN(BANCS.OUTPARAM.msg_text_7) != 0) THEN
		#{
			CUST.FOAT.var = CUST.FOAT.var  + " (7)" + BANCS.OUTPARAM.msg_text_7
		#}
		ENDIF
		PRINT(CUST.FOAT.var)
		sv_u = urhk_SetOrbOut("MSG|"+CUST.FOAT.var)
		PRINT(sv_u)
	#}
	ENDIF
	
	
	IF(CUST.FOAT.partTranType == "C")THEN
	#{
		
		IF((BANCS.STDIN.contextBankId == "54" )  OR (BANCS.STDIN.contextBankId == "11" )) THEN
		#{
			
			
			#--------------------------------------------------------------------------------
			# Intializing the variables
			#--------------------------------------------------------------------------------
			
			CUST.SHORD.bacid = ""
			CUST.SHORD.acctSolid = ""
			CUST.SHORD.errMsg = ""
			
			PRINT(BANCS.INPUT.acctNum)
			CUST.SHORD.acctid = BANCS.INPUT.acctNum
			PRINT(CUST.SHORD.acctid)
			
			#--------------------------------------------------------------------------------
			# Getting values from CPARAM
			#--------------------------------------------------------------------------------
			BANCS.INPUT.moduleName = "SHAREORDERING"
			BANCS.INPUT.parameterId = "SR_BACID"
			CALL ("getcparamvalue.scr")
			IF (BANCS.OUTPUT.parameterVal != "") THEN
			#{
				CUST.SHORD.bacid = BANCS.OUTPUT.parameterVal
				PRINT(CUST.SHORD.bacid)
				#}
			ELSE
				#{
				CUST.SHORD.errMsg = "Bacid setup not done CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			BANCS.INPUT.parameterId = "SR_SHTEXT"
			CALL ("getcparamvalue.scr")
			IF ( BANCS.OUTPUT.parameterVal != "" ) THEN
			#{
				CUST.SHORD.shtext = BANCS.OUTPUT.parameterVal
				#}
			ELSE
				#{
				CUST.SHORD.errMsg = "Bacid setup not done CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#--------------------------------------------------------------------------------
			# Getting bacid from GAM for acid
			#--------------------------------------------------------------------------------
			sv_s = " bacid,solid|SELECT bacid,sol_id "
			sv_s = sv_s + "FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE foracid =  ?SVAR "
			sv_s = sv_s + "AND bank_id = ?SVAR "
			BANCS.INPARAM.BINDVARS = CUST.SHORD.acctid  + "|" + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF ( sv_d ==0 ) THEN
			#{
				PRINT(BANCS.OUTPARAM.bacid)
				CUST.SHORD.acctBacid = BANCS.OUTPARAM.bacid
				CUST.SHORD.acctSolid = BANCS.OUTPARAM.solid
				#}
			ELSE
				#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			IF ((CUST.SHORD.bacid == CUST.SHORD.acctBacid) AND (CUST.SHORD.acctSolid == BANCS.STDIN.mySolId)) THEN
			#{
				sv_b = "Y|" +  CUST.SHORD.shtext
				sv_z = urhk_SetOrbOut(sv_b)
				#}
			ELSE
				#{
				sv_b = "N|" +  CUST.SHORD.shtext
				sv_z = urhk_SetOrbOut(sv_b)
			#}
			ENDIF
			
			
			#}
		ELSE
			#{
			sv_b = "DIF|KENYSUDAN"
			sv_z = urhk_SetOrbOut(sv_b)
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	IF(CUST.FOAT.partTranType == "D")THEN
	#{
		
		IF(BANCS.STDIN.contextBankId == "11" ) THEN
		#{
			
			
			BANCS.INPUT.moduleName = "TMCHRG"
			BANCS.INPUT.parameterId = "TM_CHG_BACID1"
			CALL ("getcparamvalue.scr")
			IF (BANCS.OUTPUT.parameterVal != "") THEN
			#{
				CUST.TMCHARGES.bacid = BANCS.OUTPUT.parameterVal
				PRINT(CUST.TMCHARGES.bacid)
				#}
			ELSE
				#{
				CUST.TMCHARGES.errMsg = "Bacid setup not done CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			PRINT(BANCS.INPUT.acctNum)
			CUST.TMCHARGES.acctNum = BANCS.INPUT.acctNum
			CUST.TMCHARGES.errMsg = ""
			
			#--------------------------------------------------------------------------------
			# Getting bacid from GAM for acid
			#--------------------------------------------------------------------------------
			sv_s = " bacid|SELECT bacid "
			sv_s = sv_s + "FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE foracid =  ?SVAR "
			sv_s = sv_s + "AND bank_id = ?SVAR "
			BANCS.INPARAM.BINDVARS = CUST.TMCHARGES.acctNum  + "|" + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF ( sv_d ==0 ) THEN
			#{
				PRINT(BANCS.OUTPARAM.bacid)
				CUST.TMCHARGES.acctBacid = BANCS.OUTPARAM.bacid
				#}
			ELSE
				#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_f = GETPOSITION(CUST.TMCHARGES.bacid,"!"+CUST.TMCHARGES.acctBacid+"!")
			PRINT(sv_f)
			
			IF( sv_f > 0 ) THEN
			#{
				sv_b = "Sucess|" + " "
				sv_z = urhk_SetOrbOut(sv_b)
				
			#}
			ENDIF
			
			
			
			#}
		ELSE
			#{
			sv_b = "DIF|SUDAN"
			sv_z = urhk_SetOrbOut(sv_b)
		#}
		ENDIF
		
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		IF (FIELDEXISTS(CUST.SHORD.errMsg) == 1) THEN
		#{
			IF (CUST.SHORD.errMsg != "") THEN
			#{
				sv_b = "Error|" + CUST.SHORD.errMsg
				sv_z = urhk_SetOrbOut(sv_b)
			#}
			ENDIF
		#}
		ENDIF
		
		IF (FIELDEXISTS(CUST.TMCHARGES.errMsg) == 1) THEN
		#{
			IF (CUST.TMCHARGES.errMsg != "") THEN
			#{
				sv_b = "Error|" + CUST.TMCHARGES.errMsg
				sv_z = urhk_SetOrbOut(sv_b)
			#}
			ENDIF
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
