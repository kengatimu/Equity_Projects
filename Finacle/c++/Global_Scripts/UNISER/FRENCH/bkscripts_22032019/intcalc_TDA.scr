#============================================================
# IMPORTANT: Auto Generated Header. DO NOT CHANGE MANUALLY.
# Product: Finacle Core
# Category: script name based
# Script: tdintcalc.scr
# Type: tdintcalc|default
# Description: This script is triggered when the transaction needs to be created for crediting or debiting the customer with the actual interest amount during interest calculation (HACINT / HBICN / Account Closure). The script event allows the Bank to customize the complete transaction and also introduce additional part transactions for bank specific charges.See Apply Interest for Accounts in the Interest Calculation module for HACINT menu option details.See Calculate and Collect Interest in the Foreign Bills module for HBICN menu option details.Script:The script name mentioned in the field Interest Trans script in HGSPM (for account) or Int Trans Scr (for bills) in FBRM should be present in the TBA_SCRIPTS directory.See Maintain General Scheme Parameters in the Cash Credit and Overdraft Account module for HGSPM menu option details.
# Author:
# Date:
# Modification Log:
#============================================================

<--START
#CHECKSUM="bf97328da23cf09006b4739b090feeced37bc3dfac2416f5f4f86dfba7dc1bd1"
	TRACE ON
	#Changes for CR122 in 10.2.04 for RI Direct
	sv_s = urhk_getEnv("ROUTE_WTAX_VIA_TD")
	sv_p = BANCS.OUTPARAM.envValue
	#Changes for CR122 in 10.2.04 for RI Direct
	
	
	sv_r = urhk_MTTS_PopulateInputDetails("")
	#MTT.TranDetails.TranDate=MTT.InputDetails.tranDate
	MTT.PartTranDetails.Refnum = ""
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType="T"
	MTT.TranDetails.TranSubType=MTT.InputDetails.tranSubType
	MTT.TranDetails.Remarks=MTT.InputDetails.headerRmks
	MTT.TranDetails.IgnoreExcp=MTT.InputDetails.ignoreExcp
	MTT.TranDetails.Consolidate=MTT.InputDetails.consolidate
	MTT.TranDetails.ReversalFlg=MTT.InputDetails.reversalFlag
	MTT.TranDetails.ReversalDate=MTT.InputDetails.reversalDate
	MTT.TranDetails.sysTranCode="GNRLAA060"
	# ----------------------------------------------------------
	# DON'T DELETE the code enclosed between "<START>" to "<END>"
	# ----------------------------------------------------------
	# <START>
	#if ( MTT.TranDetails.PrintAdviceInd == "Y" ) THEN
	#	MTT.TranDetails.PrintAdviceInd="B"
	#ENDIF
	# <END>
	
	sv_r = urhk_MTTS_DefineTransaction("InterestRun")
	sv_a = urhk_B2k_printRepos("MTT")
	
	WHILE(sv_r < 1)
	#{
		#Overdue Amount from Pand L
		sv_a = CDOUBLE(MTT.InputDetails.OvduIntAmtPandL)
		#Penal Amort Amt
		sv_b = CDOUBLE(MTT.InputDetails.PenalAmortAmt) + CDOUBLE(MTT.InputDetails.AddnlAmortAmt) + CDOUBLE(MTT.InputDetails.QISAmortAmt) + CDOUBLE(MTT.InputDetails.StkStAmortAmt)
		#Normal Amount from Pand L
		sv_c = CDOUBLE(MTT.InputDetails.NormalIntAmtPandL)
		#Penal Amount  from Pand L
		sv_d = CDOUBLE(MTT.InputDetails.PenalIntAmtPandL)+CDOUBLE(MTT.InputDetails.AddnlIntAmtPandL)+CDOUBLE(MTT.InputDetails.QISIntAmtPandL)+CDOUBLE(MTT.InputDetails.StkStIntAmtPandL)
		#PK
		#sv_e = sv_c + sv_d + sv_a
		
		sv_e = sv_c + sv_d
		#Re calc Amount
		sv_f = CDOUBLE(MTT.InputDetails.NormalRecalcAmt)+CDOUBLE(MTT.InputDetails.PenalRecalcAmt)+CDOUBLE(MTT.InputDetails.AddnlRecalcAmt)+CDOUBLE(MTT.InputDetails.QISRecalcAmt)+CDOUBLE(MTT.InputDetails.StkStRecalcAmt) + CDOUBLE(MTT.InputDetails.OvduRecalcAmt)
		# int amount from pay recv
		sv_g = CDOUBLE(MTT.InputDetails.NormalIntAmtPayRecv)+CDOUBLE(MTT.InputDetails.PenalIntAmtPayRecv)+CDOUBLE(MTT.InputDetails.AddnlIntAmtPayRecv)+CDOUBLE(MTT.InputDetails.QISIntAmtPayRecv)+CDOUBLE(MTT.InputDetails.StkStIntAmtPayRecv)  + CDOUBLE(MTT.InputDetails.OvduIntAmtPayRecv)
		#effective system adjustment
		sv_h = CDOUBLE(MTT.InputDetails.effSysAdjAmt)
		#effective manual adjustment
		sv_i = CDOUBLE(MTT.InputDetails.adjAmt)
		#transferred interest
		sv_j = CDOUBLE(MTT.InputDetails.transferAmt)
		
		#previous shortfall
		#Note : If the bank does not want to adjust any tds shortfall from the
		#interest amount then force previousShortfallAmount (variable sv_m) to zero by
		#removing the commnet in the following line.
		#
		#   if ( MTT.InputDetails.tdFlowId == "II") then
		#       sv_m = CDOUBLE("0.0")
		#   endif
		
		sv_m = CDOUBLE(MTT.InputDetails.previousShortfallAmount)
		#total interest
		sv_k = sv_g + sv_h + sv_i + sv_j + sv_f + sv_e + sv_a
		
		IF(sv_k >0) THEN
		#{
			
			IF(MTT.InputDetails.tdsElgFlg == "Y")THEN
			#{
				sv_l = MTT.InputDetails.tdsParkForacid
				#}
			ELSE
				#{
				sv_l = MTT.InputDetails.firstCustomerAcct
			#}
			ENDIF
			
			#Changes for CR122 in 10.2.04 for RI Direct
			# Take a safe copy of TDS or Repayment A/c
			sv_s = sv_l
			#Changes for CR122 in 10.2.04 for RI Direct
			# Checking whether the previousShortfallAmount is less than zero. If it is
			# so, making it zero as is there in the default logic.
			
			IF (sv_m < 0) THEN
			#{
				sv_m = 0
			#}
			ENDIF
			
			#Normal amortization part tran
			IF(CDOUBLE(MTT.InputDetails.NormalAmortAmt) != 0)THEN
			#{
				MTT.PartTranDetails.Account=MTT.InputDetails.advIntAcct
				print(MTT.PartTranDetails.Account)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.refCrncyCode
				MTT.PartTranDetails.Refnum=""
				MTT.PartTranDetails.RateCode=MTT.InputDetails.TdContraRateCode
				MTT.PartTranDetails.Rate=MTT.InputDetails.TdContraRate
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Remarks="Amort Interest "
				MTT.PartTranDetails.Particulars="Consolidated Amort Interest"
				IF(MTT.InputDetails.interestInd == "C")THEN
				#{
					MTT.PartTranDetails.RefAmount = CDOUBLE(MTT.InputDetails.NormalAmortAmt)
					MTT.PartTranDetails.sysPartTranCode ="PTRN02850"
					#}
				ELSE
					#{
					MTT.PartTranDetails.RefAmount = -(CDOUBLE(MTT.InputDetails.NormalAmortAmt))
					MTT.PartTranDetails.sysPartTranCode ="PTRN02851"
				#}
				ENDIF
				MTT.PartTranDetails.Consolidate="Y"
				MTT.PartTranDetails.TranIdentifier="InterestRun"
				MTT.PartTranDetails.PTranBusinessType="AMORT"
				IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
				#{
					MTT.PartTranDetails.PrintAdviceInd="B"
				#}
				ENDIF
				
				sv_r = urhk_MTTS_DefinePartTran("ADV_INT")
				
				MTT.PartTranDetails.Account=MTT.InputDetails.normalPandLAcct
				print(MTT.PartTranDetails.Account)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.refCrncyCode
				MTT.PartTranDetails.Refnum=""
				IF(MTT.InputDetails.interestInd == "D")THEN
				#{
					MTT.PartTranDetails.RefAmount = CDOUBLE(MTT.InputDetails.NormalAmortAmt)
					MTT.PartTranDetails.sysPartTranCode ="PTRN02853"
					#}
				ELSE
					#{
					MTT.PartTranDetails.RefAmount = -(CDOUBLE(MTT.InputDetails.NormalAmortAmt))
					MTT.PartTranDetails.sysPartTranCode ="PTRN02852"
				#}
				ENDIF
				MTT.PartTranDetails.PTranBusinessType="AMORT"
				IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
				#{
					MTT.PartTranDetails.PrintAdviceInd="B"
				#}
				ENDIF
				
				sv_r = urhk_MTTS_DefinePartTran("NCONADV")
			#}
			ENDIF
			
			#Penal amortization part tran
			IF(sv_b != 0) THEN
			#{
				MTT.PartTranDetails.Account=MTT.InputDetails.advIntAcct
				print(MTT.PartTranDetails.Account)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.refCrncyCode
				MTT.PartTranDetails.Refnum=""
				MTT.PartTranDetails.RateCode=MTT.InputDetails.TdContraRateCode
				MTT.PartTranDetails.Rate=MTT.InputDetails.TdContraRate
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Remarks="Amort Interest "
				MTT.PartTranDetails.Particulars="Consolidated Amort Interest"
				IF(MTT.InputDetails.interestInd == "C")THEN
				#{
					MTT.PartTranDetails.RefAmount=sv_b
					MTT.PartTranDetails.sysPartTranCode ="PTRN02854"
					#}
				ELSE
					#{
					MTT.PartTranDetails.RefAmount=-sv_b
					MTT.PartTranDetails.sysPartTranCode ="PTRN02855"
				#}
				ENDIF
				MTT.PartTranDetails.Consolidate="Y"
				MTT.PartTranDetails.TranIdentifier="InterestRun"
				MTT.PartTranDetails.PTranBusinessType="AMORT"
				IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
				#{
					MTT.PartTranDetails.PrintAdviceInd="B"
				#}
				ENDIF
				
				sv_r = urhk_MTTS_DefinePartTran("ADV_INT")
				
				IF(MTT.InputDetails.penalPandLAcct == " ")THEN
				#{
					MTT.PartTranDetails.Account=MTT.InputDetails.normalPandLAcct
					print(MTT.PartTranDetails.Account)
					#}
				ELSE
					#{
					MTT.PartTranDetails.Account=MTT.InputDetails.penalPandLAcct
					print(MTT.PartTranDetails.Account)
				#}
				ENDIF
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.refCrncyCode
				MTT.PartTranDetails.Refnum=""
				MTT.PartTranDetails.Particulars="Amort int for -"+MTT.InputDetails.ActualEntity+" "
				IF(MTT.InputDetails.interestInd == "D")THEN
				#{
					MTT.PartTranDetails.RefAmount=sv_b
					MTT.PartTranDetails.sysPartTranCode ="PTRN02861"
					#}
				ELSE
					#{
					MTT.PartTranDetails.RefAmount=-sv_b
					MTT.PartTranDetails.sysPartTranCode ="PTRN02860"
				#}
				ENDIF
				MTT.PartTranDetails.Consolidate= "Y"
				IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
				#{
					MTT.PartTranDetails.PrintAdviceInd="B"
				#}
				ENDIF
				
				sv_r = urhk_MTTS_DefinePartTran("PCONADV")
			#}
			ENDIF
			
			IF(MTT.InputDetails.interestInd == "C") THEN
			#{
				IF(sv_k>sv_m) THEN
				#{
					sv_k = sv_k - sv_m
					sv_w = CDOUBLE(MTT.InputDetails.WithHoldingTax)
					IF (sv_p != "Y") THEN
					#{
						#Changes for CR122 in 10.2.04 for RI Direct
						IF (sv_w<sv_k) THEN
						#{
							sv_q = sv_k - sv_w
							#}
						ELSE
							#{
							sv_q = 0
						#}
						ENDIF
						#Changes for CR122 in 10.2.04 for RI Direct
						#}
					ELSE
						#{
						sv_q = sv_k
					#}
					ENDIF
					#}
				ELSE
					#{
					sv_m = sv_k
					sv_q = 0
				#}
				ENDIF
			#}
			ENDIF
			
			sv_o = left$(MTT.InputDetails.startDate,10)
			sv_n = left$(MTT.InputDetails.endDate,10)
			# Do processing based on merge part tran Yes or no flag
			#Please dont tamper with PTranBusinessType as it is used for data Update
			IF (sv_q > 0) THEN
			#{
				
				IF(MTT.InputDetails.tdsElgFlg=="Y")THEN
				#{
					MTT.PartTranDetails.Remarks="Temporary credit for TDS"
					MTT.PartTranDetails.Particulars="Temporary credit for TDS"
					#}
				ELSE
					#{
					MTT.PartTranDetails.Remarks="Interest run "
					MTT.PartTranDetails.Particulars="Cons. Int. for "+MTT.InputDetails.ActualEntity+" Pd:"+sv_o +" to "+sv_n+""
				#}
				ENDIF
				
				MTT.PartTranDetails.Account=sv_l
				print(MTT.PartTranDetails.Account)
				#Changes for CR122 in 10.2.04 for RI Direct
				IF ((MTT.InputDetails.tdFlowId == "IO") AND (sv_p == "Y"))  THEN
				#{
					MTT.PartTranDetails.Account = MTT.InputDetails.ActualEntity
					print(MTT.PartTranDetails.Account)
					sv_l = MTT.InputDetails.ActualEntity
				#}
				ENDIF
				#Changes for CR122 in 10.2.04 for RI Direct
				
				IF(MTT.InputDetails.interestInd == "C")THEN
				#{
					MTT.PartTranDetails.RefAmount=sv_q
					MTT.PartTranDetails.sysPartTranCode ="PTRN02878"
					#}
				ELSE
					#{
					MTT.PartTranDetails.RefAmount=-sv_q
					MTT.PartTranDetails.sysPartTranCode ="PTRN02879"
				#}
				ENDIF
				# To get GAM record
				sv_t=urhk_getAcctDetailsInRepository(sv_l)
				IF(sv_t!=0) THEN
				#{
					MTT.Error.Description="Unable To Get GAM record"
					sv_r = urhk_MTTS_ReportErrorCondition("")
					GOTO GET_NEXT_REC
				#}
				ENDIF
				IF (BANCS.OUTPARAM.acctOwnerShip == "O") THEN
				#{
					MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.ActualEntity
					MTT.PartTranDetails.ACPARTB2kType=MTT.InputDetails.entityType
				#}
				ENDIF
				MTT.PartTranDetails.CifId=BANCS.OUTPARAM.cifId
				
				IF (STRICMP(sv_l,MTT.InputDetails.ActualEntity))THEN
				#{
					MTT.TDAddnlDetails.TDFlowCode = MTT.InputDetails.tdFlowId
				#}
				ENDIF
				
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.refCrncyCode
				MTT.PartTranDetails.RateCode=MTT.InputDetails.NormalRateCode
				MTT.PartTranDetails.Rate=MTT.InputDetails.NormalRate
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Particulars=MTT.InputDetails.ActualEntity+" : "+sv_o+" to "+sv_n+""
				IF(sv_l != MTT.InputDetails.ActualEntity) THEN
				#{
					MTT.PartTranDetails.Refnum=MTT.InputDetails.ActualEntity+MTT.InputDetails.tdFlowId+""
				#}
				ENDIF
				
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="InterestRun"
				IF(MTT.InputDetails.tdsElgFlg !="Y") THEN
				#{
					MTT.PartTranDetails.PTranBusinessType="TDDTT"
				#}
				ENDIF
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.contraReportCode
				IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
				#{
					MTT.PartTranDetails.PrintAdviceInd="B"
				#}
				ENDIF
				sv_u=""
				sv_v=""
				sv_x = "acid|select acid from gam where foracid = ?SVAR"
				sv_x = sv_x + " AND BANK_ID = ?SVAR "
				BANCS.INPARAM.BINDVARS =MTT.InputDetails.ActualEntity + "|"	+ BANCS.STDIN.contextBankId
				sv_y=urhk_dbSelectWithBind(sv_x)
				IF (BANCS.OUTPARAM.DB_ERRCODE == "0") THEN
				#{
					sv_u=BANCS.OUTPARAM.acid
				#}
				ENDIF
				sv_z=MTT.InputDetails.tdsElgFlg
				IF( (MTT.InputDetails.custInstFlgForTdAcct == "Y") and (MTT.InputDetails.tdsElgFlg != "Y") and (MTT.InputDetails.tdFlowId!="IO") ) THEN
				#{
					MTT.PayCollDetails.PayCollCrncy = MTT.InputDetails.refCrncyCode
					MTT.PayCollDetails.AccountNo = MTT.InputDetails.ActualEntity
					MTT.PayCollDetails.PayCollAmount = MTT.PartTranDetails.RefAmount
					MTT.PartTranDetails.TranIdentifier="InterestRun"
					MTT.PayCollDetails.TranIdentifier="InterestRun"
					MTT.PayCollDetails.PrB2kType = MTT.InputDetails.tdFlowId
					MTT.PayCollDetails.RemTranPartclrs = MTT.PartTranDetails.Particulars
					MTT.PayCollDetails.RemPTranRemarks = MTT.PartTranDetails.Remarks
					MTT.PayCollDetails.RemPTranRefNum = MTT.PartTranDetails.Refnum
					MTT.PayCollDetails.RemainAmtAccountNo = MTT.InputDetails.firstCustomerAcct
					sv_r = urhk_MTTS_DefineAsPerCustomerInstruction("PAY1")
					#}
				ELSE
					#{
					sv_r = urhk_MTTS_DefinePartTran("CUST")
				#}
				ENDIF
				
				#===========================================
				# Changes for CR122 in 10.2.04 for RI Direct
				#===========================================
				# Define a new part tran for the sv_w if > 0
				IF(sv_p == "Y") THEN
				#{
					IF (sv_w > 0) THEN
					#{
						IF (MTT.InputDetails.tdsElgFlg == "Y") THEN
						#{
							MTT.PartTranDetails.Remarks = "Temporary credit for TDS"
							MTT.PartTranDetails.Particulars = "Temporary credit for TDS"
							#}
						ELSE
							#{
							MTT.PartTranDetails.Remarks = "Interest run"
							MTT.PartTranDetails.Particulars = "Cons. Int. for " + MTT.InputDetails.ActualEntity + " Pd:" + sv_o + " to " + sv_n + ""
						#}
						ENDIF
						
						MTT.PartTranDetails.Account = sv_l
						print(MTT.PartTranDetails.Account)
						IF (MTT.InputDetails.interestInd == "C") THEN
						#{
							MTT.PartTranDetails.RefAmount = -1*sv_w
							#}
						ELSE
							#{
							MTT.PartTranDetails.RefAmount = sv_w
						#}
						ENDIF
						# To get GAM record
						sv_t = urhk_getAcctDetailsInRepository(sv_l)
						IF (sv_t != 0) THEN
						#{
							MTT.Error.Description = "Unable To Get GAM record"
							sv_r = urhk_MTTS_ReportErrorCondition("")
							GOTO GET_NEXT_REC
						#}
						ENDIF
						IF (BANCS.OUTPARAM.acctOwnerShip == "O") THEN
						#{
							MTT.PartTranDetails.ACPARTB2kId = MTT.InputDetails.ActualEntity
							MTT.PartTranDetails.ACPARTB2kType = MTT.InputDetails.entityType
						#}
						ENDIF
						MTT.PartTranDetails.CifId = BANCS.OUTPARAM.cifId
						
						#if (STRICMP(sv_l, MTT.InputDetails.ActualEntity)) THEN
						#{
						#MTT.TDAddnlDetails.TDFlowCode = MTT.InputDetails.tdFlowId
						MTT.TDAddnlDetails.TDFlowCode = "TD"
						#}
						#ENDIF
						
						MTT.PartTranDetails.RefCurrency = MTT.InputDetails.refCrncyCode
						MTT.PartTranDetails.RateCode = MTT.InputDetails.NormalRateCode
						MTT.PartTranDetails.Rate = MTT.InputDetails.NormalRate
						MTT.PartTranDetails.ValueDate = MTT.InputDetails.valueDateDiff
						MTT.PartTranDetails.Particulars = MTT.InputDetails.ActualEntity + " : " + sv_o + " to " + sv_n + " : TDS"
						#if (sv_l != MTT.InputDetails.ActualEntity) THEN
						#{
						#MTT.PartTranDetails.Refnum = MTT.InputDetails.ActualEntity + MTT.InputDetails.tdFlowId + ""
						MTT.PartTranDetails.Refnum = MTT.InputDetails.ActualEntity + "TD"
						#}
						#ENDIF
						
						MTT.PartTranDetails.Consolidate = "N"
						MTT.PartTranDetails.TranIdentifier = "InterestRun"
						IF (MTT.InputDetails.tdsElgFlg != "Y") THEN
						#{
							MTT.PartTranDetails.PTranBusinessType = "TDDTT"
						#}
						ENDIF
						MTT.PartTranDetails.ReportCode = MTT.InputDetails.contraReportCode
						IF (MTT.InputDetails.printIntAdvcFlg == "Y") THEN
						#{
							MTT.PartTranDetails.PrintAdviceInd = "B"
						#}
						ENDIF
						sv_u = ""
						sv_v = ""
						sv_x = "acid|select acid from gam where foracid = '" + MTT.InputDetails.ActualEntity + "'"
						sv_x = sv_x + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "' "
						sv_y = urhk_dbSelectWithBind(sv_x)
						IF (BANCS.OUTPARAM.DB_ERRCODE == "0") THEN
						#{
							sv_u = BANCS.OUTPARAM.acid
						#}
						ENDIF
						sv_z = MTT.InputDetails.tdsElgFlg
						IF ((MTT.InputDetails.custInstFlgForTdAcct == "Y") and (MTT.InputDetails.tdsElgFlg !="Y") and (MTT.InputDetails.tdFlowId!="IO")) THEN
						#{
							MTT.PayCollDetails.PayCollCrncy = MTT.InputDetails.refCrncyCode
							MTT.PayCollDetails.AccountNo = MTT.InputDetails.ActualEntity
							MTT.PayCollDetails.PayCollAmount = MTT.PartTranDetails.RefAmount
							MTT.PartTranDetails.TranIdentifier = "InterestRun"
							MTT.PayCollDetails.TranIdentifier="InterestRun"
							#MTT.PayCollDetails.PrB2kType = MTT.InputDetails.tdFlowId
							MTT.PayCollDetails.PrB2kType = "TD"
							MTT.PayCollDetails.RemTranPartclrs = MTT.PartTranDetails.Particulars
							MTT.PayCollDetails.RemPTranRemarks = MTT.PartTranDetails.Remarks
							MTT.PayCollDetails.RemPTranRefNum = MTT.PartTranDetails.Refnum
							MTT.PayCollDetails.RemainAmtAccountNo = MTT.InputDetails.firstCustomerAcct
							sv_r = urhk_MTTS_DefineAsPerCustomerInstruction("PAY1")
							#}
						ELSE
							#{
							sv_r = urhk_MTTS_DefinePartTran("CUST")
						#}
						ENDIF
					#}
					ENDIF
					IF (MTT.InputDetails.tdFlowId == "IO")  THEN
					#{
						IF (MTT.InputDetails.tdsElgFlg == "Y") THEN
						#{
							MTT.PartTranDetails.Remarks = "Temporary credit for TDS"
							MTT.PartTranDetails.Particulars = "Temporary credit for TDS"
							#}
						ELSE
							#{
							MTT.PartTranDetails.Remarks = "Interest run"
							MTT.PartTranDetails.Particulars = "Cons. Int. for " + MTT.InputDetails.ActualEntity + " Pd:" + sv_o + " to " + sv_n + ""
						#}
						ENDIF
						
						MTT.PartTranDetails.Account = sv_l
						print(MTT.PartTranDetails.Account)
						
						IF (MTT.InputDetails.interestInd == "C") THEN
						#{
							MTT.PartTranDetails.RefAmount = -1 * (sv_q - sv_w)
							#}
						ELSE
							#{
							MTT.PartTranDetails.RefAmount = sv_q - sv_w
						#}
						ENDIF
						
						
						# To get GAM record
						sv_t = urhk_getAcctDetailsInRepository(sv_l)
						IF (sv_t != 0) THEN
						#{
							MTT.Error.Description = "Unable To Get GAM record"
							sv_r = urhk_MTTS_ReportErrorCondition("")
							GOTO GET_NEXT_REC
