				MTT.PartTranDetails.LienForacid=MTT.InputDetails.ActualEntity
				MTT.PartTranDetails.LienType="SHFLN"
				MTT.PartTranDetails.LienAmount = sv_m
				MTT.PartTranDEtails.LienRemarks="Lien due to TDS shortfall -"+MTT.InputDetails.ActualEntity+" "
				MTT.PartTranDetails.PTranBusinessType="INT"
				IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
				#{
					MTT.PartTranDetails.PrintAdviceInd="B"
				#}
				ENDIF
				
				sv_r = urhk_MTTS_DefinePartTran("SHF")
			#}
			ENDIF
			MTT.PartTranDetails.ACPARTB2KID=""
			MTT.PartTranDetails.PTranBusinessType=""
			
			#Booking Adjustment
			IF(MTT.InputDetails.bookAdjReqdFlg == "Y")THEN
			#{
				IF(sv_e < 0) THEN
				#{
					MTT.PartTranDetails.Account=MTT.InputDetails.normalPandLAcct
					print(MTT.PartTranDetails.Account)
					IF(MTT.InputDetails.interestInd == "C")THEN
					#{
						MTT.PartTranDetails.RefAmount= sv_e
						#}
					ELSE
						#{
						MTT.PartTranDetails.RefAmount= -sv_e
					#}
					ENDIF
					MTT.PartTranDetails.Refnum=""
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.refCrncyCode
					MTT.PartTranDetails.RateCode=MTT.InputDetails.NormalRateCode
					MTT.PartTranDetails.Rate=MTT.InputDetails.NormalRate
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.Remarks="Interest run "
					MTT.PartTranDetails.Particulars="Book Adjustment  for -"+MTT.InputDetails.ActualEntity+" "
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="InterestRun"
					MTT.PartTranDetails.PTranBusinessType="INT"
					IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
					#{
						MTT.PartTranDetails.PrintAdviceInd="B"
					#}
					ENDIF
					
					sv_r = urhk_MTTS_DefinePartTran("BKAD")
					
					
					MTT.PartTranDetails.Account=MTT.InputDetails.normalPayRecvAcct
					print(MTT.PartTranDetails.Account)
					IF(MTT.InputDetails.interestInd == "C")THEN
					#{
						MTT.PartTranDetails.RefAmount= -sv_e
						#}
					ELSE
						#{
						MTT.PartTranDetails.RefAmount= sv_e
					#}
					ENDIF
					MTT.PartTranDetails.Refnum=""
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.refCrncyCode
					MTT.PartTranDetails.RateCode=MTT.InputDetails.NormalRateCode
					MTT.PartTranDetails.Rate=MTT.InputDetails.NormalRate
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.Particulars="Book Adjustment  for -"+MTT.InputDetails.ActualEntity+" "
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="InterestRun"
					MTT.PartTranDetails.PTranBusinessType="INT"
					IF(MTT.InputDetails.printIntAdvcFlg == "Y")THEN
					#{
						MTT.PartTranDetails.PrintAdviceInd="B"
					#}
					ENDIF
					
					sv_r = urhk_MTTS_DefinePartTran("CBKAD")
				#}
				ENDIF
			#}
			ENDIF
			sv_r = urhk_MTTS_EndDefinition("")
			#}
		ELSE
			#{
			BANCS.INPARAM.totalnterest=sv_k
			BANCS.INPARAM.ActualEntity=MTT.InputDetails.ActualEntity
