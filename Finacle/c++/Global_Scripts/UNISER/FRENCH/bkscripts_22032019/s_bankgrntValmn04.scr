		print(sv_u)
	#}
	ENDIF
	
	# MODIFICATION ENDS HERE
	
	#####################################################################
	# checking effective date
	#####################################################################
	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "55"))THEN
	#{
		sv_a = urhk_SRV_GetVal("bgEffectiveDate")
		PRINT(sv_a)
		IF (sv_a == 0) THEN
		#{
			CUST.DATA.bgeffDate= BANCS.OUTPARAM.srvValue
			PRINT(CUST.DATA.bgeffDate)
		#}
		ENDIF
		
		
		IF (CUST.DATA.bgeffDate != "" ) THEN
		#{
			CUST.DATA.bgeffDate = MID$(CUST.DATA.bgeffDate,0,10)
			sv_s = urhk_B2K_getDateDiffFromBODDate(CUST.DATA.bgeffDate)
			PRINT(sv_s)
			CUST.DATA.DIFF = CINT(BANCS.OUTPARAM.DateDiff)
			PRINT(CUST.DATA.DIFF)
			
			IF (CUST.DATA.DIFF != CINT("0") ) THEN
			#{
				sv_u=urhk_SRV_SetErr("bgEffectiveDate|Effective date should be equal to BOD date")
				PRINT(sv_u)
				#}
			ELSE
