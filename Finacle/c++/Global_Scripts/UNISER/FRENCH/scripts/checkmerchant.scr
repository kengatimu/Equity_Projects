<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Bank id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Bankid=BANCS.INPUT.Bankid
	print(CUST.DATA.Bankid)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("MerchantAccount"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Merchant Account Number "
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.MerchantAccount=trim(BANCS.INPUT.MerchantAccount)
	print(CUST.DATA.MerchantAccount)
ENDIF


############################################
# Fetching the value from table
############################################

sv_q = "Merchantname,Merchantaccountt,merchnatcodew| "
sv_q = sv_q + " SELECT RCT.ref_desc,LONG_REF_CODE,ref_code  FROM TBAADM.RCT  where  RCT.del_flg='N' and  RCT.ref_rec_type='AG' AND RCT.bank_id=?SVAR  and RCT.LONG_REF_CODE=?SVAR and rownum<2  "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.MerchantAccount

sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

if (sv_p==0) then

	CUST.DATA.Merchantname = BANCS.OUTPARAM.Merchantname
	print (CUST.DATA.Merchantname)
	CUST.DATA.Merchantaccountt = BANCS.OUTPARAM.Merchantaccountt
	print (CUST.DATA.Merchantaccountt)
	CUST.DATA.merchnatcodew = BANCS.OUTPARAM.merchnatcodew
	print (CUST.DATA.merchnatcodew)

	sv_z = urhk_SetOrbOut("MERCHANT_CODE|"+CUST.DATA.merchnatcodew)
	print(sv_z)
	sv_z = urhk_SetOrbOut("MERCHANT_ACCOUNT|"+CUST.DATA.Merchantaccountt)
	print(sv_z)
	sv_z = urhk_SetOrbOut("MERCHANT_NAME|"+CUST.DATA.Merchantname)
	print(sv_z)
	sv_e=urhk_SetOrbOut("StattusCode|1")
else
	CUST.DATA.errMsg="Merchant Does Not Exist "
	sv_e=urhk_SetOrbOut("StattusCode|2")
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
endif

End:
EXITSCRIPT
trace off
end-->

