#     DESCRIPTION     : This script performs the validation for the SOL ID
#                       that is been entered by the user in HDENRO menu option
#     MENU OPTION     : HDENRO
#     CALLING JSP     : denommn004.jsp
#     AUTHOR NAME     : Sandeep Patil
#     MODULE CODE     :	DENOM
#     MODIFICATION
#     HISTORY         :
#                       Serial.No       Date	   AuthorName      Description
#-------------------------------------------------------------------------------------

<--START
CHECKSUM="2ce7c3e437b7f9b5a71133371da194e4e320c3493bb39bc3ff90754b77e8f12c"
	TRACE ON
	
	sv_r = urhk_B2k_PrintRepos("BANCS")
	#print(sv_r)
	
	#-------------------------------------------------------------------------------------
	# CREATION OF REPOSITORIES
	#-------------------------------------------------------------------------------------
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST","DENOM",5)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------
	# INITIALIZE THE VARIABLES
	#-------------------------------------------------------------------------------------
	
	#-----------GETTING THE VALUES OF THE FIELD FROM THE FRONT END : START --------------
	
	#print(BANCS.INPUT.SolId)
	CUST.DENOM.SolId = toupper(BANCS.INPUT.SolId)
	#print (CUST.DENOM.SolId)
	CUST.DENOM.flag1 = "IVL"
	
	#-----------GETTING THE VALUES OF THE FIELD FROM THE FRONT END :END--------------
	
	#-------------------------------------------------------------------------------------
	# VALIDATE IF THE ENTERED SOL ID IS VALID OR NOT
	#-------------------------------------------------------------------------------------
	
	#-----------QUERY IN SOL TABLE IF THE ENTERED SOLID IS VALID OR NOT : START --------
	
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.SolId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_a = "count | SELECT count(*) "
	sv_a = sv_a + "FROM sol "
	sv_a = sv_a + "WHERE del_flg!='Y' "
	sv_a = sv_a + "AND sol_id = ?SVAR AND bank_id = ?SVAR"
	print(sv_a)
	
	sv_q = urhk_dbSelectWithBind(sv_a)
	print(sv_q)
	
	IF(sv_q == 0) THEN
	#{
		CUST.DENOM.count = BANCS.OUTPARAM.count
		#print(CUST.DENOM.count)
		IF(CUST.DENOM.count == 0) THEN
		#{
			CUST.DENOM.flag1 = "IVL"
			#}
		ELSE
			#{
			CUST.DENOM.ErrMsg = "Valid Sol Id"
			sv_u = urhk_setOrbOut("Success|"+CUST.DENOM.ErrMsg)
			#print(sv_u)
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------QUERY IN SOL TABLE IF THE ENTERED SOLID IS DELETED OR NOT  : START -------------------------
	
	IF(CUST.DENOM.flag1 == "IVL") THEN
	#{
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.SolId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_a = "count1 | SELECT count(*) "
		sv_a = sv_a + "FROM sol "
		sv_a = sv_a + "WHERE sol_id = ?SVAR AND bank_id = ?SVAR"
		#print(sv_a)
		
		sv_q = urhk_dbSelectWithBind(sv_a)
		#print(sv_q)
		
		IF(sv_q == 0) THEN
		#{
			CUST.DENOM.count1 = BANCS.OUTPARAM.count1
			#print(CUST.DENOM.count1)
			IF(CUST.DENOM.count1 != 0) THEN
			#{
				CUST.DENOM.flag1 = "DEL"
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------QUERY IN SOL TABLE IF THE ENTERED SOLID IS DELETED OR NOT  : END ----------------------------
	
	#-----------QUERY IN SOL TABLE IF THE SOLID IS NOT ENTERED AND TO BE TAKEN AS ALL: START ----------------
	
	IF(CUST.DENOM.SolId == "ALL") THEN
	#{
		
		sv_a = "count2| SELECT count(*) "
		sv_a = sv_a + "FROM sol "
		sv_a = sv_a + "WHERE del_flg!='Y' AND bank_id = ?SVAR"
		#print(sv_a)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
		sv_q = urhk_dbSelectWithBind(sv_a)
		#print(sv_q)
		
		IF(sv_q == 0) THEN
		#{
			CUST.DENOM.count2 = BANCS.OUTPARAM.count2
			#print(CUST.DENOM.count2)
			IF(CUST.DENOM.count2 != 0) THEN
			#{
				CUST.DENOM.ErrMsg = "Valid Sol Id"
				sv_u = urhk_setOrbOut("Success|"+CUST.DENOM.ErrMsg)
				#print(sv_u)
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	#-----------QUERY IN SOL TABLE IF THE SOLID IS NOT ENTERED AND TO BE TAKEN AS ALL: END ------------------
	
	#-----------QUERY IN SOL TABLE IF THE ENTERED SOLID IS VALID OR NOT  : END ------------------------------
	
	#-----------SEND THE OUTPUT TO THE FRONT END : START-----------------------------------------------------
	
	print(CUST.DENOM.flag1)
	
	IF (CUST.DENOM.flag1 == "IVL") THEN
	#{
		CUST.DENOM.ErrMsg = "Enter a Valid Sol Id"
		sv_u = urhk_setOrbOut("IVL|"+CUST.DENOM.ErrMsg)
		#print(sv_u)
		GOTO FINISH
	#}
	ENDIF
	
	IF(CUST.DENOM.flag1 == "DEL") THEN
	#{
		CUST.DENOM.ErrMsg = "This Sol Id is deleted..Please Re-Enter"
		sv_u = urhk_setOrbOut("DEL|"+CUST.DENOM.ErrMsg)
		#print(sv_u)
		GOTO FINISH
	#}
	ENDIF
	
	#-----------SEND THE OUTPUT TO THE FRONT END : END--------------------------------------------------------
	
	#---------------------------------------------------------------------------------------------------------
	# THIS STEP IS TO EXIT FROM THE SCRIPT
	#---------------------------------------------------------------------------------------------------------
	
	FINISH:
		TRACE OFF
		exitscript
END-->
