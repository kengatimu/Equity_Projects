#--------------------------------------------------------------------------------------------------
# Name			: denomdp014.scr
# Date			: 15-07-2010
# Description		: This script file gets the input SolId from HDENRO menu and gets the total
#			  round off amount for all the teller accounts in that particular Sol
#			  and calls the MTT script to perform the transaction between the
#			  teller accounts and the PandL account and records it to a report.
# Menu Option		: HDENRO
# Calling JSP		: denommn004.jsp
# Author 		: Sandeep Patil
# Bank			: STANDARD BANK
# Module Code		: DENOM
# Menu Name		: HDENRO
# Modification History	:
#	<Serial.No>	<Date>		<Author>		<Description>
#	0.1		15-07-2010	Sandeep Patil		Draft Version
#----------------------------------------------------------------------------------------------------
<--START
CHECKSUM="88bc0387db53983b5958aecc07385b59d6103d47e6fa4d2bbabc531f2f654eeb"
	TRACE ON
	sv_r = urhk_B2k_PrintRepos("BANCS")
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	CUST.DENOM.setId = BANCS.INPUT.setId
	print(CUST.DENOM.setId)
	CUST.DENOM.tellerId = BANCS.INPUT.tellerId
	print(CUST.DENOM.tellerId)
	CUST.DENOM.bank_id = BANCS.STDIN.contextBankId
	print(CUST.DENOM.bank_id)
	
	IF((CUST.DENOM.setId !="") OR (CUST.DENOM.setId != "ALL"))THEN
	#{
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.setId +"|"+ CUST.DENOM.bank_id
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_q = "cnt1|select count(1) "
		sv_q = sv_q + "FROM stid "
		sv_q = sv_q + "where SET_ID = ?SVAR "
		sv_q = sv_q + "AND BANK_ID = ?SVAR "
		print(sv_q)
		sv_s = urhk_dbselectWithBind(sv_q)
		print(sv_s)
		IF(sv_s ==0)THEN
		#{
			IF(BANCS.OUTPARAM.cnt1 == 0)THEN
			#{
				sv_z = urhk_SetOrbOut("Error_10|Error:^Invalid set ID^AccNo")
				print(sv_z)
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		IF(CUST.DENOM.tellerId  !="")THEN
		#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.tellerId +"|"+ CUST.DENOM.bank_id +"|"+ CUST.DENOM.setId +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = "cnt|select count(1) "
			sv_q = sv_q + "FROM C_DENM "
			sv_q = sv_q + "WHERE teller_id = ?SVAR "
			sv_q = sv_q + "AND sol_id in ( "
			sv_q = sv_q + "SELECT distinct sol_id  "
			sv_q = sv_q + "FROM stid "
			sv_q = sv_q + "WHERE BANK_ID = ?SVAR "
			sv_q = sv_q + "AND set_id = ?SVAR) "
			sv_q = sv_q + "AND BANK_ID = ?SVAR "
			print(sv_q)
			sv_s = urhk_dbselectWithBind(sv_q)
			print(sv_s)
			IF(sv_s == 0)THEN
			#{
				print(BANCS.OUTPARAM.cnt)
				IF(BANCS.OUTPARAM.cnt == 0)THEN
				#{
					sv_z = urhk_SetOrbOut("Error_10|Error:^Invalid teller Id for given sol^AccNo")
					print(sv_z)
					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#---    CALLING ANOTHER SCRIPT IN BACKGROUND ---#
	sv_z = "sSetId|" + CUST.DENOM.setId
	sv_b = urhk_putEnvForCallShellScript(sv_z)
	print(sv_b)
	sv_z = "sTellerId|" + CUST.DENOM.tellerId
	sv_b = urhk_putEnvForCallShellScript(sv_z)
	print(sv_b)
	
	BANCS.INPARAM.scriptName = "denomdp001.com"
	BANCS.INPARAM.arguments = "denom.DAT"
	
	sv_x = system("echo denomdp049.scr > denom.DAT")
	print(sv_x)
	
	sv_a = urhk_CallShellScript("b")
	print(sv_a)
	IF (sv_a != 0) THEN
	#{
		sv_w = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_d = urhk_SetOrbOut("RESULT_MSG|Transaction Round OFF  Process Initiation failed ")
		#}
	ELSE
		#{
		sv_w = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_d = urhk_SetOrbOut("RESULT_MSG|Transaction Round OFF Process Initiated Succesfully")
	#}
	ENDIF
	
	FINISH:
		TRACE OFF
		EXITSCRIPT
END-->
