<--start
	# Script body goes here
TRACE ON
	#========================================================	
	# Validating the Menu Id Codes from MOD table
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.INTERFACE.mopId+"|"+CUST.INTERFACE.hmeEntityId+"|Y|N"
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "valMopId|"
	sv_s = sv_s + " SELECT COUNT(4)"
	sv_s = sv_s + " FROM TBAADM.MOD"
	sv_s = sv_s + " WHERE MOP_ID=?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.INTERFACE.valMopId = BANCS.OUTPARAM.valMopId
		print(CUST.INTERFACE.valMopId)
		IF(CUST.INTERFACE.valMopId=="0")THEN
		#{
			print("Enter a valid MenuId")
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.errorCode="ERR013"
			GOTO ERROREXIT
		#}
		ENDIF
	#}
	ELSE
	#{
		print("Enter a valid MenuId")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR013"
		GOTO ERROREXIT
		
	#}
	ENDIF
	
end-->
