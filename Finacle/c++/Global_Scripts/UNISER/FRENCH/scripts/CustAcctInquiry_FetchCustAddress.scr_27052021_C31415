#----------------------------------------------------------------------------------------------------------
# Filename              :       CustAcctInquiry_FetchCustAddress.scr
# Author                :       Venkatesh T R
# Description           :       This script fetches the preferred address/email/phone of a given Customer ID
# Input                 :       Customer ID
# Output                :       None 
# Called Script         :       None
# Calling Script        :       CustAcctInquiry_FetchCustomerDetails.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Venkatesh          Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
#trace on
	#---------------------------------------------------------------------------------
        # Fetch Preferred Email id of the customer
        #---------------------------------------------------------------------------------
        BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID + "|" + "Y"
        sv_s = "prefEmailID|SELECT EMAIL FROM TBAADM.CEMAIL WHERE EMAIL_B2KID = ?SVAR AND"
        sv_s = sv_s + " BANK_ID = ?SVAR AND PREFERREDFLAG = ?SVAR"
        sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN
        #{
                CUST.INTERFACE.prefEmailID = BANCS.OUTPARAM.prefEmailID
                print(CUST.INTERFACE.prefEmailID)
        #}
        ELSE
        #{
                CUST.INTERFACE.prefEmailID = ""
        #}
        ENDIF
	
	#---------------------------------------------------------------------------------
	# Fetch Preferred Phone Number
	#---------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID + "|" + "Y"
	sv_s = "prefPhoneNo|SELECT PHONENO FROM TBAADM.CPHONE WHERE PHONE_B2KID = ?SVAR AND"
	sv_s = sv_s + " BANK_ID = ?SVAR AND PREFERREDFLAG = ?SVAR"
        sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN
        #{
		CUST.INTERFACE.prefPhoneNo = BANCS.OUTPARAM.prefPhoneNo
	#}
	ELSE
	#{
		CUST.INTERFACE.prefPhoneNo = ""
	#}
	ENDIF
 
	#---------------------------------------------------------------------------------
	# Fetch Communication Address of the customer.
	#---------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "Y" + "|" + MID$(BANCS.STDIN.BODDate,0,10) + "|" +  MID$(BANCS.STDIN.BODDate,0,10) 
	sv_s = "custPrefAddr1,custPrefAddr2,custPrefCityCode,custPrefStateCode,custPrefCntyCode,custPrefPinCode|"
	sv_s = sv_s + "SELECT ADDRESS1,ADDRESS2,CITY_CODE,STATE_CODE,CNTRY_CODE,PIN_CODE FROM TBAADM.CNMA"
	sv_s = sv_s + " WHERE ADDR_B2KID = ?SVAR AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND PREFERREDADDRESS = ?SVAR AND TO_DATE(?SVAR,'DD-MM-YYYY') > START_DATE AND TO_DATE(?SVAR,'DD-MM-YYYY') < END_DATE"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0)THEN
	#{
		CUST.INTERFACE.custPrefAddr1 = BANCS.OUTPARAM.custPrefAddr1
		CUST.INTERFACE.custPrefAddr2 = BANCS.OUTPARAM.custPrefAddr2
		CUST.INTERFACE.custPrefCityCode = BANCS.OUTPARAM.custPrefCityCode
		CUST.INTERFACE.custPrefStateCode = BANCS.OUTPARAM.custPrefStateCode
		CUST.INTERFACE.custPrefCntyCode = BANCS.OUTPARAM.custPrefCntyCode
		CUST.INTERFACE.custPrefPinCode = BANCS.OUTPARAM.custPrefPinCode
		print(CUST.INTERFACE.custPrefAddr1)
		print(CUST.INTERFACE.custPrefAddr2)
		print(CUST.INTERFACE.custPrefCityCode)
		print(CUST.INTERFACE.custPrefStateCode)
		print(CUST.INTERFACE.custPrefCntyCode)
		print(CUST.INTERFACE.custPrefPinCode)
	#}
	ELSE
	#{
		CUST.INTERFACE.custPrefAddr1 = ""
		CUST.INTERFACE.custPrefAddr2 = ""
		CUST.INTERFACE.custPrefCityCode = ""
		CUST.INTERFACE.custPrefStateCode = ""
		CUST.INTERFACE.custPrefCntyCode = ""
		CUST.INTERFACE.custPrefPinCode = ""
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# Fetch City Code Description
	#---------------------------------------------------------------------------------
	CUST.INTERFACE.custPrefCityCodeDesc = ""
	IF(CUST.INTERFACE.custPrefCityCode != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankID + "|" + CUST.INTERFACE.custPrefCityCode
		sv_s = "custPrefCityCodeDesc|SELECT * FROM (SELECT LOCALETEXT FROM CRMUSER.CATEGORY_LANG"
	 	sv_s = sv_s + " WHERE CATEGORYID = (SELECT CATEGORYID FROM CRMUSER.CATEGORIES "
	 	sv_s = sv_s + " WHERE CATEGORYTYPE ='CITY' AND BANK_ID= ?SVAR"
	 	sv_s = sv_s + " AND VALUE = ?SVAR)"
	 	sv_s = sv_s + " ORDER BY LOCALECODE desc) WHERE rownum < 2"
	 	print(sv_s)
	 	sv_d = urhk_dbSelectWithBind(sv_s)
	 	IF(sv_d == 0)THEN
	 	#{
	 		CUST.INTERFACE.custPrefCityCodeDesc = BANCS.OUTPARAM.custPrefCityCodeDesc
	 		print(CUST.INTERFACE.custPrefCityCodeDesc)
	 	#}
	 	ENDIF
	#}
	ENDIF

#trace off
end-->
