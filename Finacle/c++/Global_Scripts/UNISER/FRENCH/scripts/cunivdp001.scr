	BANCS.INPUT.moduleName = "STUDANDBILL"
	BANCS.INPUT.parameterId = "ACCTNUM5"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.STABI.acctnum5 = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.STABI.errMsg = "Account No 5 setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	BANCS.INPUT.moduleName = "STUDANDBILL"
	BANCS.INPUT.parameterId = "ACCTNUM6"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.STABI.acctnum6 = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.STABI.errMsg = "Account No 6 setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "STUDANDBILL"
	BANCS.INPUT.parameterId = "WORKCLS"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.STABI.workclass = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.STABI.errMsg = "Work Class setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	#Getting Bacid value form cparam --'PAGRPREC'
	BANCS.INPUT.moduleName = "STUDANDBILL"
	BANCS.INPUT.parameterId = "BACID"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.STABI.bacid = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
