	BANCS.INPUT.moduleName = "STUDANDBILL"
	BANCS.INPUT.parameterId = "ACCTNUM4"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.STABI.acctnum4 = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.STABI.errMsg = "Account No 4 setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
