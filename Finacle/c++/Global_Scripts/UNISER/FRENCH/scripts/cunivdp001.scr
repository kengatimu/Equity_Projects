	ELSE
	#{
		CUST.STABI.errMsg = "Scheme Code 2 setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF

IF ((BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "11"))THEN
