#***************************************************************************
# If function code is 'A'
#***************************************************************************
PRINT(CUST.STABI.funcCode)

IF (CUST.STABI.funcCode == "A") THEN
#{
        sv_s = "INSERT INTO CUSTOM.C_CIC VALUES("
        sv_s = sv_s + "?SVAR, "
        sv_s = sv_s + "?SVAR, "
        sv_s = sv_s + "?SVAR, "
        sv_s = sv_s + "'N',"
        sv_s = sv_s + "?SVAR)"
		BANCS.INPARAM.BINDVARS = CUST.STABI.acctNum + "|" + CUST.STABI.refNum + "|" + CUST.STABI.name + "|"  + BANCS.STDIN.contextBankId
        sv_d = urhk_dbSQLWithBind(sv_s)
        PRINT(sv_d)
		
        IF (sv_d != 0) THEN
        #{
                sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
                sv_g = "RESULT_MSG|Record Exist " + CUST.STABI.refNum + " " + " Database error has occured."
                sv_z = urhk_SetOrbOut(sv_g)
                GOTO ENDOFSCRIPT
        #}
        ELSE
        #{
			sv_s = "INSERT INTO CUSTOM.C_UNIV(ACCTNUM,REFNUM,NAME,ENTERER_ID,AUDIT_DATE,AUDIT_BOD_DATE,FUNC,bank_id) VALUES("
			sv_s = sv_s + "?SVAR, "
