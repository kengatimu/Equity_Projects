#---------------------------------------------------------------------------
# check if account no filed is blank.
#---------------------------------------------------------------------------
IF (TRIM(CUST.STABI.acctNum) == "") THEN
#{
	sv_e = "Please Enter account no."
	sv_m = "acctNum"
	sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
	sv_u = urhk_SetOrbOut(sv_e)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|N") 
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	PRINT(CUST.STABI.acctNum)
	sv_z = TRIM(CUST.STABI.acctNum)
	sv_s = "ValidateAccout|SELECT count(1) "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND foracid = ?SVAR "

	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "43"))THEN
	#{
		sv_s = sv_s + "AND (schm_code IN (?SVAR,?SVAR) OR bacid = ?SVAR ) "
	#}
	ENDIF
	IF ((BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "11")) THEN
	#{
		sv_s = sv_s + "AND schm_code IN (?SVAR,?SVAR)"
	#}
	ENDIF
	IF (BANCS.STDIN.contextBankId == "56") THEN
	#{
		sv_s = sv_s + "AND schm_type in ( 'CAA','SBA')"
	#}
	ENDIF

	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND acct_cls_flg = 'N' " 
	PRINT(sv_s)
	
	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "43")) THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.schmcode1 + "|" + CUST.STABI.schmcode2 + "|" + CUST.STABI.bacid
		PRINT(BANCS.INPARAM.BINDVARS)
	#}
	ENDIF
	IF ((BANCS.STDIN.contextBankId == "50")  OR (BANCS.STDIN.contextBankId == "11")) THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum + "|" + CUST.STABI.schmcode1 + "|" + CUST.STABI.schmcode2
		PRINT(BANCS.INPARAM.BINDVARS)
	#}
	ENDIF
	IF (BANCS.STDIN.contextBankId == "56") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum 
		PRINT(BANCS.INPARAM.BINDVARS)
	#}
	ENDIF
	
	
	sv_d = urhk_dbSelectWithBind(sv_s)
			
	IF (sv_d != 0) THEN
	#{
		sv_e = "A Database error has occured. Please contact your DBA."
		sv_m = "acct"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N") 
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		PRINT(BANCS.OUTPARAM.ValidateAccout)
	#}
	ENDIF

	IF ((BANCS.STDIN.contextBankId == "54")OR (BANCS.STDIN.contextBankId == "43")) THEN
	#{
		IF ((CINT(BANCS.OUTPARAM.ValidateAccout) <= 0) AND (CUST.STABI.acctNum != CUST.STABI.acctnum1) AND (CUST.STABI.acctNum != CUST.STABI.acctnum2) AND (CUST.STABI.acctNum != "0001300104071")) THEN
		#{
			sv_e = "Incorrect Account No. / Accounts of schm other than " + CUST.STABI.schmcode1 + " , " + CUST.STABI.schmcode2 + " are not allowed"
			sv_m = "foracid"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.STABI.Position = 2
			GOTO ENDOFSCRIPT
		#}
		ENDIF


		sv_a ="billerCount|"
		sv_a = sv_a + "select count(*) from tbaadm.brgt where bank_id = ?SVAR "
		sv_a = sv_a + "and free_text1 = ?SVAR and del_flg ='N' "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_a)
		print(sv_b)
		IF (sv_b == 0)THEN
		#{
			CUST.STABI.billerCount = BANCS.OUTPARAM.billerCount
			print(CUST.STABI.billerCount)
		#}
		ENDIF

		IF (CUST.STABI.billerCount == "1") THEN
			#{
				sv_f="Vald|"
				sv_f = sv_f + "select FREE_TEXT4 from tbaadm.brgt where bank_id = ?SVAR "
				sv_f = sv_f + "and free_text1 = ?SVAR and del_flg ='N' "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.STABI.acctNum
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_z = urhk_dbSelectWithBind(sv_f)
				print(sv_z)
				
					IF (sv_z == 0)THEN
						#{
							CUST.STABI.VTYPE = BANCS.OUTPARAM.Vald
							print(CUST.STABI.VTYPE)
						#}
							IF (CUST.STABI.VTYPE == "R") THEN
								#{
								sv_e = "Biller Validation is Remote"
								sv_m = "foracid"
								sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
								sv_u = urhk_SetOrbOut(sv_e)
								sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
								GOTO ENDOFSCRIPT
								#}						
							ENDIF

					ENDIF


			#}
		ELSE
			#{
				IF  (CUST.STABI.billerCount > "1") THEN

					sv_e = "Multiple biller Id for the Account. BillerCount =  " + CUST.STABI.billerCount 
					sv_m = "foracid"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
					#}						
			
				Else
					sv_e = "Account is not Maintained as Biller"
					sv_m = "foracid"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
			
				ENDIF
			#}

		ENDIF

		PRINT(BANCS.STDIN.userWorkClass)
		PRINT(CUST.STABI.workclass)
		PRINT(CUST.STABI.acctNum)
		PRINT(CUST.STABI.acctnum3)
		PRINT(CUST.STABI.acctnum4)
		sv_w = getPosition(CUST.STABI.acctnum3,"!" +  CUST.STABI.acctNum + "!")
		print(sv_w)

		IF ((CINT(BANCS.STDIN.userWorkClass) < CINT(CUST.STABI.workclass)) AND (sv_w > 0)) THEN
		#{
			sv_e = "insufficient workclass " + CUST.STABI.workclass + " to Add data in this Account."
			sv_m = "userworkclass"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF ((BANCS.STDIN.userWorkClass < "515") AND ((CUST.STABI.acctNum == "0550296119836") OR (CUST.STABI.acctNum == "0550293271157") OR (CUST.STABI.acctNum == "0810269849061") OR (CUST.STABI.acctNum == "0810294880883") OR (CUST.STABI.acctNum == "0430263787755") OR (CUST.STABI.acctNum == "0870264044111") OR (CUST.STABI.acctNum == "0870295346647") OR (CUST.STABI.acctNum == "0010201200681") OR (CUST.STABI.acctNum == "0180294130211") OR (CUST.STABI.acctNum == "0870260668087") OR (CUST.STABI.acctNum == "0180291347977") OR (CUST.STABI.acctNum == "0110268693174") OR (CUST.STABI.acctNum == "0180293054495") OR (CUST.STABI.acctNum == "0110279076857") OR (CUST.STABI.acctNum == "0180261520046")))THEN
		#{
			sv_e = "insufficient workclass to Add data in this Account."
			sv_m = "userworkclass"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF

	#}
	ENDIF

	IF ((BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "11")) THEN
	#{
		IF (CINT(BANCS.OUTPARAM.ValidateAccout) <= 0) THEN
		#{
			sv_e = "Incorrect Account No. / Accounts of schm other than " + CUST.STABI.schmcode1 + " , " + CUST.STABI.schmcode2 + " are not allowed"
			sv_m = "foracid"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.STABI.Position = 2
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	IF (BANCS.STDIN.contextBankId == "56") THEN
	#{
		IF  (CINT(BANCS.OUTPARAM.ValidateAccout) <= 0)  THEN
		#{
			sv_e = "Only accounts of scheme type CAA/SBA are allowed"
			sv_m = "foracid"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.STABI.Position = 2
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ((BANCS.STDIN.userWorkClass < "515") AND (CUST.STABI.acctNum == "1039200875951")) THEN
		#{
			sv_e = "insufficient workclass to Add data in this Account."
			sv_m = "userworkclass"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	IF ((BANCS.STDIN.contextBankId == "50") AND (CUST.STABI.acctNum == "4002200438251")) THEN
	#{
		sv_e = "Data maintenance in this account not allowed through CUNIV"
		sv_m = "foracid"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		CUST.STABI.Position = 2
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}	
ENDIF



#---------------------------------------------------------------------------
#  Validation For STDNT Ref No          
#---------------------------------------------------------------------------

IF (TRIM(CUST.STABI.refNum) == "") THEN 
#{
	sv_e = "Please Enter STDNT Ref No"
	sv_m = "refNum"
	sv_e = "Error_3|ERROR:^"+ sv_e +".^"+ sv_m +""
	sv_u = urhk_SetOrbOut(sv_e)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
	GOTO ENDOFSCRIPT
#}    
ELSE
#{
	sv_r = TRIM(CUST.STABI.refNum)
	PRINT(sv_r)

	sv_s = "count|SELECT count(1) "
	sv_s = sv_s + "FROM CUSTOM.C_CIC "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND acctNum = ?SVAR "
	sv_s = sv_s + "AND refNum = ?SVAR "
	sv_s = sv_s + "AND del_flg = 'N' " 
