			sv_s = sv_s + "?SVAR, "
			sv_s = sv_s + "sysdate, " 
			sv_s = sv_s + "to_date(?SVAR, 'dd-mm-yyyy hh24:mi:ss'), "
			sv_s = sv_s + "?SVAR, "
			sv_s = sv_s + "?SVAR)"
			BANCS.INPARAM.BINDVARS = CUST.STABI.acctNum  	+ "|" + CUST.STABI.refNum 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.STABI.name 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.STABI.funcCode
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)

			IF (sv_d != 0) THEN
			#{
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Record Exist <b>" + CUST.STABI.refNum + "</b>" + ". Database error has occured."
				sv_z = urhk_SetOrbOut(sv_g)
				GOTO ENDOFSCRIPT
			#}
			ELSE
			#{
				sv_d = urhk_dbSQLWithBind("COMMIT")
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Record Added Successfully <b>" + CUST.STABI.refNum + " , " + CUST.STABI.name + "</b>"
				sv_z = urhk_SetOrbOut(sv_g)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
        #}
        ENDIF
#}
ENDIF

