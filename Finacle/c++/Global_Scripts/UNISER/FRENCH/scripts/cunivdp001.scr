CUST.STABI.workclass = ""
CUST.STABI.schmcode1 = ""
CUST.STABI.schmcode2 = ""
CUST.STABI.errMsg    = ""


IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43")) THEN
