<--START
CHECKSUM="3a2ce68dad5402e39aa295784312015800096f30a995c1ba9d59c6cd86b02def"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
	#{
		CREATECLASS("CUST", "CHQB", 5)
	#}
	ENDIF
	
	CUST.CHQB.function 	= BANCS.INPUT.funcCode
	CUST.CHQB.requestId 	= BANCS.INPUT.requestId
	
	IF((CUST.CHQB.function != "A" ) AND (CUST.CHQB.function != "D") AND (CUST.CHQB.function != "I") AND (CUST.CHQB.function != "V") ) THEN
	#{
		sv_e = "The Valid choice Are A-Add,D-Delete,V-Verify,I-Inquiry  "
		sv_m = "funcCode"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF (CUST.CHQB.function != "") THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	#}
	ENDIF
	
	#***************************************************************************
	# check if account no filed is blank when function == A.
	#***************************************************************************
	IF (CUST.CHQB.function == "A") THEN
	#{
		CUST.CHQB.account_no1 =	BANCS.INPUT.acctNo
		PRINT(CUST.CHQB.account_no1)
		IF (FIELDEXISTS(CUST.CHQB.account_no1)) THEN
		#{
			sv_s = "ValidateAccout|SELECT COUNT(*) FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE foracid = ?SVAR "
			sv_s = sv_s + " AND schm_type = 'DDA'"
			sv_s = sv_s + " AND entity_cre_flg = 'Y' "
			sv_s = sv_s + " AND del_flg != 'Y' "
			sv_s = sv_s + " AND acct_cls_flg !='Y' "
			sv_s = sv_s + " AND sol_id  = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CHQB.account_no1 + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d != 0 ) THEN
			#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "funcode"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.CHQB.succsflg = "N"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.CHQB.ValidateAccout = BANCS.OUTPARAM.ValidateAccout
				PRINT(CUST.CHQB.ValidateAccout)
			#}
			ENDIF
			
			IF (CINT(BANCS.OUTPARAM.ValidateAccout) <= 0) THEN
			#{
				sv_e = "Incorrect Bankers Cheque Account/ Account belongs to another branch"
				sv_m = "acctNo"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.CHQB.succsflg = "N"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			##		#---------------------------------------------------------------------
			##		#---Check if they is unverifed record
			##		#---------------------------------------------------------------------
			
			sv_s = "Unverified|SELECT COUNT(1) FROM CUSTOM.C_BCHQ "
			sv_s = sv_s + "WHERE foracid = ?SVAR "
			#sv_s = sv_s + "AND req_status in ('E','A') "
			sv_s = sv_s + "AND req_status in ('E') "
			sv_s = sv_s + "AND del_flg != 'Y' "
			sv_s = sv_s + "AND bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CHQB.account_no1 + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d != 0) THEN
			#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "funcode"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.CHQB.succsflg = "N"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.CHQB.Unverified = BANCS.OUTPARAM.Unverified
				PRINT(CUST.CHQB.Unverified)
				IF (CINT(CUST.CHQB.Unverified) > 0) THEN
				#{
					sv_e = "Unverified record / Unrequested record exist"
					sv_m = "acctNo"
					sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					CUST.CHQB.succsflg = "N"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		#TRACE OFF
		EXITSCRIPT
END-->
