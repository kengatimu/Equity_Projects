#**************************************************************************************************************
# Filename              : cierevdp010.scr
# Description           : This script fetches the value from response
# Input                 : NA
# Output                : Tran id, Tran date, Error Code, Error Desc
# Called Script         : NA
# Calling Script        : NA

# Modification History
# Sl. #           Date             Author             Modification           Version
# -----          ------           --------          ----------------        ---------
#   1          20-03-2013       Nitin Prabhakar     Original Version          1.0
#   2          21-03-2013	Kalvin Joseph       Modified Version	      1.01
#**************************************************************************************************************
#---------------------------------------------------------------------------------------------------------------
# Version 1.01 Description : Changes made to the TrnId tag to RevTrnId  and the  Fetching of TranDate is removed
# and modification were made to the validations which included tranDate in its conditions
#---------------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="4c50740c5d6794c808ffd2abd6ed3dda67218f8e0d165d6d979cbc887f348667"
	TRACE ON
	
	CUST.INTERFACE.tranDate = ""
	CUST.INTERFACE.tranId = ""
	CUST.INTERFACE.errorCode = ""
	CUST.INTERFACE.errorDesc = ""
	sv_x = CUST.INTERFACE.respXMLMsg
	
	#--------------------------------------------------------------------------------------------------------
	# Fetching the status of the request
	#--------------------------------------------------------------------------------------------------------
	sv_y = "<Status>"
	sv_z = "</Status>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
	ELSE
		#{
		CUST.INTERFACE.tranStatus = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.tranStatus)
	#--------------------------------------------------------------------------------------------------------
	# If Success fetching tran id else fetching error code and description
	#--------------------------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.tranStatus == "SUCCESS") THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "N"
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<RevTrnId>"
		sv_z = "</RevTrnId>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.tranId = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
		ENDIF
		
		
		
		IF(CUST.INTERFACE.tranId == "") THEN
		#{
			CUST.INTERFACE.errorMsgFlg = "Y"
			CUST.INTERFACE.errorCode = "SYSERR"
			CUST.INTERFACE.errorDesc = "Could not get response from server"
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		IF(CUST.INTERFACE.tranStatus == "FAILED") THEN
		#{
			sv_x = CUST.INTERFACE.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
			#}
			ENDIF
			sv_x = CUST.INTERFACE.respXMLMsg
			sv_y = "<ErrorDesc>"
			sv_z = "</ErrorDesc>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
			#}
			ENDIF
		#}
		ENDIF
		IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
		#{
			CUST.INTERFACE.errorCode = "SYSERR"
			CUST.INTERFACE.errorDesc = "Could not get response from server"
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.INTERFACE.errorMsgFlg)
	PRINT(CUST.INTERFACE.tranId)
	PRINT(CUST.INTERFACE.tranDate)
	PRINT(CUST.INTERFACE.errorCode)
	PRINT(CUST.INTERFACE.errorDesc)
	
	#TRACE OFF
END-->
