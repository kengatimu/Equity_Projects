<--START
CHECKSUM="43ad4330c066cad4f9f7fe2b22e9bbcb09d01686da99dc8dc496e1a31080c96c"
	#TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CSIIET Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CSIIET")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CSIIET",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CSIIET.targetEntity = " "
	CUST.CSIIET.errorFlg = "N"
	CUST.CSIIET.errorMsg = " "
	CUST.CSIIET.targetEntityDesc = " "
	CUST.CSIIET.bankId = BANCS.STDIN.contextBankId
	#sv_u = urhk_b2k_printrepos("BANCS")
	#print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.targetEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.targetEntity) != "")THEN
		#{
			CUST.CSIIET.targetEntity = TOUPPER(TRIM(BANCS.INPUT.targetEntity))
			print(CUST.CSIIET.targetEntity)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CSIIET.errorFlg = "Y"
		CUST.CSIIET.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "targetEntity,targetEntityDesc|"
	sv_s = sv_s + " SELECT BANK_ID,GROUP_DESC"
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CSIIET.targetEntity
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CSIIET.targetEntity = BANCS.OUTPARAM.targetEntity
		print(CUST.CSIIET.targetEntity)
		CUST.CSIIET.targetEntityDesc = BANCS.OUTPARAM.targetEntityDesc
		print(CUST.CSIIET.targetEntityDesc)
		
		#}
	ELSE
		#{
		CUST.CSIIET.errorFlg = "Y"
		CUST.CSIIET.errorMsg = "Invalid Entity ID"
	#}
	ENDIF
	
	CUST.CSIIET.targetEntityDesc = TOUPPER(CUST.CSIIET.targetEntityDesc)
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CSIIET.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CSIIET.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetEntity|"+CUST.CSIIET.targetEntity)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetEntityDesc|"+CUST.CSIIET.targetEntityDesc)
		print(sv_u)
		
		
END-->
