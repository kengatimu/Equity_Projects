<--START
TRACE ON

sv_n = CINT(INTBAF.INTBAFC.TbafEventStep)

IF (sv_n == 0) THEN
	GOTO STEP0
ENDIF

IF (sv_n == 1) THEN
	GOTO STEP1
ENDIF

IF (sv_n == 2) THEN
	GOTO STEP2
ENDIF

GOTO Finish1


STEP0:
#{

	STDWFS.WFSINPUT.WfsStatus 	= 	"D"
	STDWFS.GLBDATA.f3Pressed 	= 	"Y"
	STDWFS.GLBDATA.fresh            =       "N"
	STDWFS.GLBDATA.ddadv		=	"N" 

	GOTO Finish1
#}

STEP1:

#---------------------------------------------------------------------------
#The foll step is to Validate Upload file name
#---------------------------------------------------------------------------
#{

sv_u = urhk_TBAF_InquireFieldValue("datablk.field_3")
STDWFS.GLBDATA.uploadfilename = TRIM(B2KTEMP.TEMPSTD.TBAFRESULT)
print(STDWFS.GLBDATA.uploadfilename)

IF (STDWFS.GLBDATA.uploadfilename == "") THEN
        sv_u = urhk_TBAF_DispMesg("The upload file name should be entered")
        BANCS.OUTPUT.successOrFailure = "F"
        GOTO Finish1
ELSE
	#---checking if the upload file exists 

	sv_a = "test -f " + STDWFS.GLBDATA.uploadfilename 
	sv_r = system(sv_a)
	print(sv_r)

	If (sv_r != 0) then 
		sv_u = urhk_TBAF_DispMesg("The Upload File name does not exist or the wrong uploadfile name ")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO Finish1
	Endif

ENDIF
	

#---------------------------------------------------------------------------
#The foll step is to Validate test flag
#---------------------------------------------------------------------------
#{

sv_u = urhk_TBAF_InquireFieldValue("datablk.field_4")
STDWFS.GLBDATA.test = TRIM(B2KTEMP.TEMPSTD.TBAFRESULT)
print(STDWFS.GLBDATA.test)

IF (STDWFS.GLBDATA.test == "") THEN
        sv_u = urhk_TBAF_DispMesg("The test flag should be entered")
        BANCS.OUTPUT.successOrFailure = "F"
        GOTO Finish1
ELSE
       IF ((STDWFS.GLBDATA.test != "Y") AND (STDWFS.GLBDATA.test != "N")) THEN
                sv_u = urhk_TBAF_DispMesg("Inavlid test flag  'Y' or 'N' ")
                BANCS.OUTPUT.successOrFailure = "F"
                GOTO Finish1
        ENDIF

ENDIF



#---------------------------------------------------------------------------
#CONFIRMATION
#---------------------------------------------------------------------------
#{

sv_u = urhk_TBAF_Confirm("Do you want to continue")
print(sv_u)

IF (sv_u == 1) THEN
	BANCS.OUTPUT.successOrFailure = "F"
	GOTO Finish1   
ENDIF

If (STDWFS.WFSOUTPUT.ErrorCode=="-9999") THEN
	goto complete
endif


#}

Finish1:

TRACE OFF
END-->
