<--START
CHECKSUM="f46ac908170d438ff4609201d2cbcf32b0e6c19189a2f9ef0eefedc6945ee670"
	TRACE ON
	sv_u=urhk_b2k_PrintRepos("BANCS")
	print (sv_u)
	IF(FIELDEXISTS(BANCS.INPUT.tranId)) THEN
	#{
		sv_a = TOUPPER(LPAD(BANCS.INPUT.tranId,9))
		sv_b = BANCS.INPUT.tranDate
		#}
	ELSE
		#{
		sv_m = "F"
		GOTO FINISH
	#}
	ENDIF
	sv_m = ""
	sv_p = 1
	
	BANCS.INPARAM.BINDVARS = sv_a + "|" + sv_b + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_q = "tranType,tranSubType|SELECT tran_type,tran_sub_type "
	sv_q = sv_q + "FROM dctd_acli "
	sv_q = sv_q + "WHERE tran_id = ?SVAR "
	sv_q = sv_q + "AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_q = sv_q + "AND part_tran_srl_num = 1 "
	sv_q = sv_q + "AND bank_id = ?SVAR "
	print(sv_q)
	sv_r = urhk_dbSelectWithBind(sv_q)
	print(sv_r)
	IF (sv_r == 0) THEN
	#{
		sv_m = BANCS.OUTPARAM.tranType + BANCS.OUTPARAM.tranSubType
	#}
	ELSE
	#{
		sv_m = "F"
	#}
	ENDIF
	PRINT(sv_m)
	
	FINISH:
		PRINT(sv_m)
		sv_u = urhk_setOrbOut("Message|" + sv_m)
		EXITSCRIPT
		TRACE OFF
END-->
