#----------------------------------------------------------------------------------------------------------
# Filename              :       BankBranchInq_ValidateInputDetails.scr
# Author                :       Kalvin Joseph
# Description           :       This script validates the value passed in Request XML
# Input                 :       paySysID,localClearingFlg
# Output                :       Success or Failure
# Called Script         :       BankBranchInq_main.scr
# Calling Script        :       None
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           07-03-2013	Kalvin          Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
TRACE ON

	#-------------------------------------------------------------------------------------
	#Checking if any one of the field out of three is sent in request
	#-------------------------------------------------------------------------------------
	print(CUST.INTERFACE.paySysID)
	print(CUST.INTERFACE.localClearingFlg)
	print(CUST.INTERFACE.bankCode)
	PRINT(CUST.INTERFACE.bankId)
	CUST.INTERFACE.count=""

	IF((CUST.INTERFACE.paySysID == "") AND (CUST.INTERFACE.localClearingFlg == "") AND(CUST.INTERFACE.bankCode== "")AND (CUST.INTERFACE.bankId == ""))THEN
	#{
		CUST.INTERFACE.successOrFailure = "F"
		CUST.INTERFACE.errorCode = "ERR001"
		GOTO ERROREXIT
	ENDIF
	#-------------------------------------------------------------------------------------------------
	# Validating if the given BankId is valid one or not 
	#--------------------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.bankId == "") THEN
	#{
		CUST.INTERFACE.successOrFailure = "F"
		CUST.INTERFACE.errorCode = "ERR032"
		GOTO ERROREXIT
	#}
	ELSE
	#{		
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankId + "|" + "N"
	
		sv_s= "count|"
		sv_s = sv_s + "SELECT  COUNT(1) FROM  TBAADM.GCT "
		sv_s = sv_s + "WHERE BANK_ID = ?SVAR "
		sv_s = sv_s + "AND DEL_FLG = ?SVAR "
	
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)	
		IF (sv_d==0) THEN
 		#{
 			CUST.INTERFACE.count=BANCS.OUTPARAM.count
			PRINT(CUST.INTERFACE.count)
 			IF (CUST.INTERFACE.count== "0") THEN
 	 		#{
 	 			CUST.INTERFACE.successOrFailure = "F"
 	 			CUST.INTERFACE.errorCode = "ERR033"
				GOTO ERROREXIT
 	 		#}
 			ENDIF
 		#}
 		ENDIF
		PRINT(CUST.INTERFACE.count)
	#}	
	ENDIF
	# Checking conditionIF paysysid is entered then local clearing flag must be entered and vice versa
	#--------------------------------------------------------------------------------------------------
	IF(((CUST.INTERFACE.paySysID != "") AND (CUST.INTERFACE.localClearingFlg == "")) OR ((CUST.INTERFACE.localClearingFlg!="") AND (CUST.INTERFACE.paySysID == "")))THEN
	#{
		CUST.INTERFACE.successOrFailure = "F"
		CUST.INTERFACE.errorCode = "ERR026"
		GOTO ERROREXIT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------------------------
	#Checking condition if Bank code is entered then paysys id and local clearing flg must not be entered
	#----------------------------------------------------------------------------------------------------
	IF((CUST.INTERFACE.bankCode != "") AND ((CUST.INTERFACE.paySysID != "") OR (CUST.INTERFACE.localClearingFlg != ""))) THEN
	#{
		CUST.INTERFACE.successOrFailure = "F"
		CUST.INTERFACE.errorCode = "ERR027"
		GOTO ERROREXIT
	#}
	ENDIF
	
	
	#-------------------------------------------------------------------------------------
	#Validating the possible values for Local clearing flag to be  Y and N
	#-------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.localClearingFlg != "") THEN
	#{
		IF((CUST.INTERFACE.localClearingFlg == "Y") OR (CUST.INTERFACE.localClearingFlg == "N" )) THEN
		#{
			print("Validation successful")
		#}
		ELSE
		#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR028"
			GOTO ERROREXIT
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------
	#Validating the value passed in paysys id if its not null. ITs a ref code with ref_rec_type as "CK"
	# use userhook urhk_B2k_valRefCode
	#-------------------------------------------------------------------------------------
	print(CUST.INTERFACE.paySysID)	
	sv_m = STRLEN(CUST.INTERFACE.paySysID)
	IF (sv_m > 5 ) THEN 
	#{
		CUST.INTERFACE.successOrFailure="F"
	  	CUST.INTERFACE.errorCode = "ERR031"	
		GOTO ERROREXIT	
	#}
	ENDIF 

	IF(CUST.INTERFACE.paySysID != "") THEN
	#{
		sv_z = "CK|" +CUST.INTERFACE.paySysID
		sv_u = urhk_B2k_valRefCode(sv_z)
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR029"
			GOTO ERROREXIT
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------
	# IF Bank code is passed then validate it using urhk_B2k_valBankCode
	#-------------------------------------------------------------------------------------
	IF (CUST.INTERFACE.bankCode!="")THEN
	#{
		sv_u = urhk_B2k_valBankCode(CUST.INTERFACE.bankCode)
		IF( sv_u != 0 ) THEN
		#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR030"
			GOTO ERROREXIT
		#}
		ENDIF
	#}
	ENDIF

#TRACE OFF
END-->
