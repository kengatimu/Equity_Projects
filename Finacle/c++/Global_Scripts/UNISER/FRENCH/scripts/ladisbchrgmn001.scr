<--START
CHECKSUM="4b7da562efc6b3bc4a8ce45bbf04b8a0488b6f3174e95010f4380eef98880019"
	TRACE ON
	
	#----------------------------------------------------------------------
	# Create the necessary repositories and Classes
	#----------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	#-------------------------------------------------------------------
	# Getting fields from SRV structure
	#-------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.loanAcctId = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.loanAcctId)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.tranType.code")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.tranType = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.tranType)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.grossNetDisbt.code")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.isGrossDisb = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.isGrossDisb)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.chargeRateCode.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.rateCode = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.rateCode)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.transferAcctNum.foracid")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.transferAcctNum= BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.transferAcctNum)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranMesg.tranDetail.tranIdentifier.tranDate")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.disbTranId = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.disbTranId)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranMesg.tranDetail.tranIdentifier.tranId")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.disbTranDate = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.disbTranDate)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.disburseAmt = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.disburseAmt)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.valueDate")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.valueDate = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.valueDate)
	#}
	ENDIF
	
	#############################################################
	#checking whether the disb dat and bod date are same
	#############################################################
	CUST.LADISB.BodDate = LEFT$(BANCS.STDIN.BODDate,10)
	
	BANCS.INPARAM.date1 = CUST.LADISB.valueDate
	BANCS.INPARAM.date2 = CUST.LADISB.BodDate
	sv_e = urhk_B2k_dateDiff("")
	print(sv_e)
	
	print(BANCS.OUTPARAM.dateDiff)
	CUST.LADISB.valueDateDiff = CINT(BANCS.OUTPARAM.dateDiff)
	print(CUST.LADISB.valueDateDiff)
	
	sv_a = GETPOSITION(CUST.LADISB.disburseAmt,"|")
	sv_u = MID$(CUST.LADISB.disburseAmt,0,sv_a-1)
	print(sv_u)
	CUST.LADISB.disburseAmt = sv_u
	#add the condition to see whether charge needs to be collected here.
	IF((CUST.LADISB.isGrossDisb == "G") AND (CUST.LADISB.tranType == "T")) THEN
	#{
		
		#-------------------------------------------------------------------
		# Fetching Values from custom table
		#-------------------------------------------------------------------
		sv_s = ""
		sv_s = sv_s + "acctId,acctName,tranPrac,crncy,chargeAmt,drcrInd,srlNo,eventId,eventType|"
		sv_s = sv_s + " SELECT ACCT_ID,ACCT_NAME,TRAN_PARTICULARS,CCY,TRAN_AMT,INDICATOR,"
		sv_s = sv_s + " SRL_NO,EVENT_ID,EVENT_TYPE FROM CUSTOM.DISRT WHERE LOAN_ACCT_ID = ?SVAR"
		sv_s = sv_s + " AND BANK_ID = ?SVAR AND INDICATOR = ?SVAR ORDER BY SRL_NO"
		BANCS.INPARAM.BINDVARS = CUST.LADISB.loanAcctId + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "C"
		
		sv_d = urhk_dbCursorOpenWithBind(sv_s)
		print(sv_d)
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		sv_n = 0
		WHILE(sv_c == 0)
		#{
			sv_n = sv_n + 1
			sv_v = "acctId_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.acctId
			print(("CUST").("LADISB").(sv_v))
			sv_v = "acctName_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.acctName
			print(("CUST").("LADISB").(sv_v))
			sv_v = "tranPrac_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.tranPrac
			print(("CUST").("LADISB").(sv_v))
			sv_v = "crncy_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.crncy
			print(("CUST").("LADISB").(sv_v))
			sv_v = "chargeAmt_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.chargeAmt
			print(("CUST").("LADISB").(sv_v))
			sv_v = "drcrInd_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.drcrInd
			print(("CUST").("LADISB").(sv_v))
			sv_v = "srlNo_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.srlNo
			print(("CUST").("LADISB").(sv_v))
			sv_v = "eventId_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.eventId
			print(("CUST").("LADISB").(sv_v))
			sv_v = "eventType_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.eventType
			print(("CUST").("LADISB").(sv_v))
			sv_v = "tranPrac_" + FORMAT$(sv_n, "%d")
			("CUST").("LADISB").(sv_v) = BANCS.OUTPARAM.tranPrac
			print(("CUST").("LADISB").(sv_v))
			
			sv_c = urhk_dbCursorFetch(sv_l)
		#}
		DO
		sv_u = urhk_dbCursorClose(sv_l)
		print(sv_u)
		
		print(sv_n)
		CUST.LADISB.recCount = sv_n
		IF(CINT(CUST.LADISB.recCount) > 0) THEN
		#{
			
			#--------------------------------------------------------------------------
			# Initialise the MTT repository
			#--------------------------------------------------------------------------
			sv_r = REPEXISTS("MTT")
			IF (sv_r == 0) THEN
			#{
				CREATEREP("MTT")
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("MTT","TranDetails")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("MTT","TranDetails",5)
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("MTT","PartTranDetails")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("MTT","PartTranDetails",5)
			#}
			ENDIF
			sv_r = CLASSEXISTS("MTT","InputDetails")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("MTT","InputDetails",5)
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("MTT","LAAddnlDetails")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("MTT","LAAddnlDetails",5)
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("MTT","Error")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("MTT","Error",5)
			#}
			ENDIF
			
			sv_r = REPEXISTS("BANCS")
			IF (sv_r == 0) THEN
			#{
				CREATEREP("BANCS")
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("BANCS","INPARAM")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("BANCS","INPARAM",5)
			#}
			ENDIF
			#-------------------------------------------------------------------------------
			# Initialising the MTT.
			#-------------------------------------------------------------------------------
			
			BANCS.INPARAM.PostTranFlg = "X"
			BANCS.INPARAM.CommitFlg = "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
			BANCS.INPARAM.ValidationFlag = "N"
			BANCS.INPARAM.RestrictModifyInd = "FOURTH_GROUP"
			BANCS.INPARAM.ErrorCheckForLuw="N"
			BANCS.INPARAM.CheckExceptions="N"
			#BANCS.INPARAM.proxyPostFlg = "Y"
			
			
			MTT.TranDetails.TranDate = "0"
			MTT.TranDetails.TranType = "T"
			MTT.TranDetails.TranSubType = "BI"
			MTT.TranDetails.IgnoreExcp = "I"
			MTT.TranDetails.Remarks="Disbursement Charge Collection"
			MTT.TranDetails.PostFlag = "X"
			MTT.TranDetails.CommitFlag = "Y"
			MTT.TranDetails.Consolidate = "N"
			#MTT.TranDetails.ReversalFlg = "N"
			
			sv_k = urhk_MTTS_Initialize("")
			print(sv_k)
			IF(sv_k != 0) THEN
			#{
				sv_u = urhk_SRV_SetErr("MTT initialized failed")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_k = urhk_MTTS_DefineTransaction("charges")
			print(sv_k)
			IF(sv_k != 0) THEN
			#{
				sv_u = urhk_SRV_SetErr("MTT transaction definition failed")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_u = urhk_MTTS_PopulateInputDetails("")
			
		#}
		ENDIF
		
		
		sv_n = 1
		WHILE(sv_n <= CINT(CUST.LADISB.recCount))
		#{
			sv_v = "eventId_" + FORMAT$(sv_n, "%d")
			CUST.LADISB.eventId = ("CUST").("LADISB").(sv_v)
			sv_v = "eventType_" + FORMAT$(sv_n, "%d")
			CUST.LADISB.eventType = ("CUST").("LADISB").(sv_v)
			sv_v = "chargeAmt_" + FORMAT$(sv_n, "%d")
			CUST.LADISB.chargeAmt = ("CUST").("LADISB").(sv_v)
			sv_v = "crncy_" + FORMAT$(sv_n, "%d")
			CUST.LADISB.crncyCode = ("CUST").("LADISB").(sv_v)
			sv_v = "tranPrac_" + FORMAT$(sv_n, "%d")
			CUST.LADISB.tranParticulars = ("CUST").("LADISB").(sv_v)
			sv_v = "acctId_" + FORMAT$(sv_n, "%d")
			CUST.LADISB.crAcctId = ("CUST").("LADISB").(sv_v)
			
			IF(CDOUBLE(CUST.LADISB.chargeAmt) != CDOUBLE("0")) THEN
			#{
				#------------------------------------------------------
				# Debit for charge amount from Customer oper a/c
				#------------------------------------------------------
				CUST.LADISB.tempChargeAmt = "-" + CUST.LADISB.chargeAmt
				MTT.PartTranDetails.Account = CUST.LADISB.transferAcctNum
				MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.LADISB.tempChargeAmt)
				MTT.PartTranDetails.RefCurrency = CUST.LADISB.crncyCode
				MTT.PartTranDetails.RateCode = CUST.LADISB.rateCode
				MTT.PartTranDetails.Particulars = CUST.LADISB.tranParticulars
				MTT.PartTranDetails.Remarks = "Charges for " + CUST.LADISB.loanAcctId + ".Event ID " + CUST.LADISB.eventId
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = "charges"
				#MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.ValueDate = CUST.LADISB.valueDateDiff
				print(MTT.PartTranDetails.RefAmount)
				print(MTT.PartTranDetails.Account)
				print(MTT.PartTranDetails.RateCode)
				print(MTT.PartTranDetails.RefCurrency)
				sv_u = urhk_MTTS_DefinePartTran("DEBIT")
				print(sv_u)
				IF (sv_u != 0) THEN
				#{
					#throw error
					IF (FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						print(MTT.Error.Description)
					#}
					ENDIF
					sv_u = urhk_SRV_SetErr("Debit leg failed")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				#------------------------------------------------------
				# Credit to placeholder mentioned in HPTTM
				#------------------------------------------------------
				MTT.PartTranDetails.Account=CUST.LADISB.crAcctId
				MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.LADISB.chargeAmt)
				MTT.PartTranDetails.Particulars=CUST.LADISB.tranParticulars
				MTT.PartTranDetails.RefCurrency=CUST.LADISB.crncyCode
				MTT.PartTranDetails.RateCode = CUST.LADISB.rateCode
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="charges"
				#MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.ValueDate = CUST.LADISB.valueDateDiff
				MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
				MTT.PartTranDetails.EntryUserId=BANCS.STDIN.userId
				MTT.PartTranDetails.EntryTime=BANCS.STDIN.BODDate
				MTT.PartTranDetails.Remarks = "Charges for " + CUST.LADISB.loanAcctId + "Event ID " + CUST.LADISB.eventId
				MTT.ChargeDetails.EventType = CUST.LADISB.eventType
				MTT.ChargeDetails.EventId = CUST.LADISB.eventId
				MTT.ChargeDetails.CompB2kId = CUST.LADISB.disbTranId + "/" + CUST.LADISB.disbTranDate
				MTT.ChargeDetails.CalculatedAmount = CDOUBLE(CUST.LADISB.chargeAmt)
				MTT.ChargeDetails.ActualAmount = CDOUBLE(CUST.LADISB.chargeAmt)
				MTT.ChargeDetails.CollectionCrncy = CUST.LADISB.crncyCode
				MTT.ChargeDetails.TargetAcctId = CUST.LADISB.loanAcctId
				print(MTT.PartTranDetails.RefCurrency)
				print(MTT.PartTranDetails.Account)
				print(MTT.PartTranDetails.RefAmount)
				
				sv_z = urhk_MTTS_DefineChargePartTran("CREDIT")
				print(sv_z)
			#}
			ENDIF
			
			sv_n = sv_n + 1
		#}
		DO
		
		#------------------------------------------------------------------------------
		# End of the MTT definition
		#------------------------------------------------------------------------------
		
		IF(CINT(CUST.LADISB.recCount) != 0) THEN
		#{
			sv_u = urhk_MTTS_EndDefinition("")
			print(sv_u)
			
			sv_b = urhk_MTTS_HandleExceptions("POST")
			print(sv_b)
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
			#{
				print(BANCS.OUTPARAM.MTTTranId)
				CUST.LADISB.MTTTranId = BANCS.OUTPARAM.MTTTranId
				print(CUST.LADISB.MTTTranId)
			#}
			ENDIF
			
			#		IF (sv_u== 0) THEN
			#		#{
			#			IF(FIELDEXISTS(MTT.XCPN.NumExceptions)) THEN
			#			#{
			#				PRINT(MTT.XCPN.NumExceptions)
			#				IF (MTT.XCPN.NumExceptions != 0) THEN
			#				#{
			#					sv_b = urhk_MTTS_HandleExceptions("POST")
			#					print(sv_b)
			#				#}
			#				ENDIF
			#			#}
			#			ENDIF
			#		#}
			#		ENDIF
			
			sv_u = urhk_MTTS_Close("")
			print(sv_u)
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
			#{
				print(BANCS.OUTPARAM.MTTTranId)
				CUST.LADISB.MTTTranId = BANCS.OUTPARAM.MTTTranId
				print(CUST.LADISB.MTTTranId)
			#}
			ENDIF
			
			IF(sv_u != 0) THEN
			#{
				IF (FIELDEXISTS(MTT.Error.Description)) THEN
				#{
					print(MTT.Error.Description)
					sv_u = urhk_SRV_SetErr(MTT.Error.Description)
				#}
				ENDIF
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.LADISB.MTTTranId = ""
				CUST.LADISB.MTTTranId = BANCS.OUTPARAM.MTTTranId
				print(CUST.LADISB.MTTTranId)
				IF(CUST.LADISB.MTTTranId == "") THEN
				#{
					sv_u = urhk_SRV_SetErr("Transaction creation failed")
					#}
				ELSE
					#{
					print(BANCS.STDIN.serviceName)
					#IF(BANCS.STDIN.serviceName == "SRV_DisbLoanAcct") THEN
					#{
					sv_c = "echo '" + CUST.LADISB.MTTTranId + "' > LadisbChrg.txt"
					print(sv_c)
					sv_a = system(sv_c)
					print(sv_a)
					#}
					#ENDIF
					#ONS.CUSTOM.custDataOut = "~ladisbres|"+CUST.LADISB.MTTTranId
					
				#}
				ENDIF
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		#=============================================
		# Delete the created Repositories and Classes
		#=============================================
		#IF (REPEXISTS("CUST") == 1) THEN
		#{
		#       DELETEREP("CUST")
