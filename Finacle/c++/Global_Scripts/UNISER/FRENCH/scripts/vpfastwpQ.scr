<--start
trace on
        if(repexists("EQSRV")==0)then
	#{
                createrep("EQSRV")
	#}
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
	#{
                createclass("EQSRV","GLBDATA",5)
	#}
        endif
        ##sv_p = urhk_B2k_PrintRepos("BANCS")
        ##print(sv_p)
	EQSRV.GLBDATA.addtnlData = ""
        sv_u = urhk_GetChannelInfo("")
        if(sv_u==0)then
	#{
                EQSRV.GLBDATA.chnlId = BANCS.OUTPARAM.DccId
		EQSRV.GLBDATA.dcreqid = BANCS.OUTPARAM.DccReqRefNum
	#}
        else
	#{
		EQSRV.GLBDATA.chnlId = ""
		EQSRV.GLBDATA.dcreqid = "VPP" 
	#}
        endif
        if(fieldexists(BANCS.INPUT.acid)==1)then
	#{
                EQSRV.GLBDATA.AcctId = trim(BANCS.INPUT.acid)
	#}
        else
	#{
               	EQSRV.GLBDATA.AcctId = "" 
	#}
        endif
