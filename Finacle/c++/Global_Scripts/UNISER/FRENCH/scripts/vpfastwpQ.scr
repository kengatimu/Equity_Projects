        if(sv_u == 0)then
                EQSRV.GLBDATA.odsolid = BANCS.OUTPARAM.acctSolId
	else
		EQSRV.GLBDATA.odsolid = ""
	endif
        if(fieldexists(BANCS.INPUT.branchId)==1)then
	#{
                EQSRV.GLBDATA.branchId = trim(BANCS.INPUT.branchId)
	#}
        else
	#{
               	EQSRV.GLBDATA.branchId = "" 
	#}
        endif
        if(fieldexists(BANCS.INPUT.fromDate)==1)then
	#{
                EQSRV.GLBDATA.fromDate = left$(BANCS.INPUT.fromDate,10)
                EQSRV.GLBDATA.eabfromDate = left$(BANCS.INPUT.fromDate,10)
		EQSRV.GLBDATA.fromDate = EQSRV.GLBDATA.fromDate + " 00:00:00"
	#}
        else
	#{
               	EQSRV.GLBDATA.fromDate = "" 
	#}
        endif
        if(fieldexists(BANCS.INPUT.toDate)==1)then
	#{
                EQSRV.GLBDATA.toDate = left$(BANCS.INPUT.toDate,10)
                EQSRV.GLBDATA.eabtoDate = left$(BANCS.INPUT.toDate,10)
		EQSRV.GLBDATA.toDate = EQSRV.GLBDATA.toDate + " 00:00:00"
	#}
        else
	#{
               	EQSRV.GLBDATA.toDate = "" 
	#}
        endif
	#A,D
        if(fieldexists(BANCS.INPUT.sortIn)==1)then
	#{
                EQSRV.GLBDATA.sortIn = trim(BANCS.INPUT.sortIn)
	#}
        else
	#{
               	EQSRV.GLBDATA.sortIn = "" 
	#}
        endif
	#D,C,B
        if(fieldexists(BANCS.INPUT.txnType)==1)then
	#{
                EQSRV.GLBDATA.txnType = trim(BANCS.INPUT.txnType)
	#}
        else
	#{
               	EQSRV.GLBDATA.txnType = "" 
	#}
        endif
        if(fieldexists(BANCS.INPUT.numOfTxns)==1)then
	#{
                EQSRV.GLBDATA.numOfTxns = trim(BANCS.INPUT.numOfTxns)
		EQSRV.GLBDATA.recordsGenerated = trim(BANCS.INPUT.numOfTxns)
	#}
        else
	#{
               	EQSRV.GLBDATA.numOfTxns = "" 
	#}
        endif
	if(fieldexists(BANCS.INPUT.lastPstdDate)==1)then
	#{
		EQSRV.GLBDATA.lastPstdDate = left$(BANCS.INPUT.lastPstdDate,10)
	#}
	else
	#{
		EQSRV.GLBDATA.lastPstdDate = "" 
	#}
	endif
	if(fieldexists(BANCS.INPUT.lastTxnDate)==1)then
	#{
		EQSRV.GLBDATA.lastTxnDate = left$(BANCS.INPUT.lastTxnDate,10)
	#}
	else
	#{
		EQSRV.GLBDATA.lastTxnDate = "" 
	#}
	endif
	if(fieldexists(BANCS.INPUT.lastTxnId)==1)then
	#{
		EQSRV.GLBDATA.lastTxnId = BANCS.INPUT.lastTxnId 
	#}
	else
	#{
		EQSRV.GLBDATA.lastTxnId = "" 
	#}
	endif
	if(fieldexists(BANCS.INPUT.lastTxnSrlNo)==1)then
	#{
		EQSRV.GLBDATA.lastTxnSrlNo = BANCS.INPUT.lastTxnSrlNo 
	#}
	else
	#{
		EQSRV.GLBDATA.lastTxnSrlNo = "" 
	#}
	endif
	if(fieldexists(BANCS.INPUT.backendRefNum)==1)then
	#{
		EQSRV.GLBDATA.backendRefNum = BANCS.INPUT.backendRefNum 
	#}
	else
	#{
		EQSRV.GLBDATA.backendRefNum = "" 
	#}
	endif
	if(fieldexists(BANCS.INPUT.hasMoreData)==1)then
	#{
		EQSRV.GLBDATA.hasMoreData = BANCS.INPUT.hasMoreData 
	#}
	else
	#{
		EQSRV.GLBDATA.hasMoreData = "" 
	#}
	endif
	if(EQSRV.GLBDATA.hasMoreData=="Y")then
	#{
		if(EQSRV.GLBDATA.backendRefNum=="")then
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
			sv_u = urhk_SetOrbOut("ErrorCode|E9999")
			sv_u = urhk_SetOrbOut("Message|Input backendRefNum tag")
			goto SIFNO
		#}
		endif
	#}
	endif
        EQSRV.GLBDATA.srvErrorCode = ""
#get closing bal
	print(EQSRV.GLBDATA.eabfromDate)
	lv_y = mid$(EQSRV.GLBDATA.eabfromDate,0,4)
	lv_m = mid$(EQSRV.GLBDATA.eabfromDate,5,2)
	lv_d = mid$(EQSRV.GLBDATA.eabfromDate,8,2)
	lv_a = lv_d + "-" + lv_m + "-" + lv_y
	print(lv_a)
	print(EQSRV.GLBDATA.odsolid)
	lv_x = EQSRV.GLBDATA.odsolid + "|" + lv_a
	print(lv_x)
	sv_e = urhk_GetNextWorkingDate(lv_x)
	print(sv_e)
	if(sv_e==0)then
	#{
		print(BANCS.OUTPARAM.NextWorkingDate)
		print(BANCS.OUTPARAM.PrevWorkingDate)
		print(BANCS.OUTPARAM.NextDataCentreWorkingDate)
		print(BANCS.OUTPARAM.PrevDataCentreWorkingDate)
		EQSRV.GLBDATA.opndatedc = BANCS.OUTPARAM.PrevDataCentreWorkingDate
	#}
	endif
	EQSRV.GLBDATA.tempclsBal = "0"
	lv_e = " opnBal,clsBal,daytrans | select to_char(nvl(sum(tran_date_bal),0),9999999999999999.99) as opnBal, "
	lv_e = lv_e + " to_char(nvl(sum(VALUE_DATE_BAL),0),9999999999999999.99) as clsBal,  " 
	##lv_e = lv_e + " to_char(nvl(sum(VALUE_DATE_TOT_TRAN),0),9999999999999999.99) as daytrans "
	lv_e = lv_e + " to_char(nvl(sum(TRAN_DATE_TOT_TRAN),0),9999999999999999.99) as daytrans "
	lv_e = lv_e + " from tbaadm.eab where acid =?SVAR "
	##lv_e = lv_e + " and eod_date <= to_date(?SVAR,'YYYY-MM-DD') "
	##lv_e = lv_e + " and end_eod_date >= to_date(?SVAR,'YYYY-MM-DD') "
	lv_e = lv_e + " and eod_date <= to_date(?SVAR ,'DD-MM-YYYY HH24:MI:SS') "
	lv_e = lv_e + " and end_eod_date >= to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
	lv_e = lv_e + " and bank_id = ?SVAR "
	##BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.InpAcid + "|" + EQSRV.GLBDATA.eabfromDate + "|" + EQSRV.GLBDATA.eabfromDate + "|" + BANCS.STDIN.contextBankId 
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.InpAcid + "|" + EQSRV.GLBDATA.opndatedc + "|" + EQSRV.GLBDATA.opndatedc + "|" + BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_e)
	lv_b  = urhk_dbSelectWithBind(lv_e)
	if(lv_b==0)then
		EQSRV.GLBDATA.opnBal = BANCS.OUTPARAM.opnBal
		EQSRV.GLBDATA.clsBal = BANCS.OUTPARAM.clsBal
		EQSRV.GLBDATA.daytrans = BANCS.OUTPARAM.daytrans
		print(EQSRV.GLBDATA.daytrans)
	else
		EQSRV.GLBDATA.opnBal = "0"
		EQSRV.GLBDATA.clsBal = "0"
	endif
	print(EQSRV.GLBDATA.opnBal)
	print(EQSRV.GLBDATA.clsBal)
	print(EQSRV.GLBDATA.daytrans)
	if(cdouble(EQSRV.GLBDATA.daytrans) <0)then
		EQSRV.GLBDATA.daytrans = -1 * cdouble(EQSRV.GLBDATA.daytrans)
		print(EQSRV.GLBDATA.daytrans)
		##EQSRV.GLBDATA.opnBal = (cdouble(EQSRV.GLBDATA.opnBal) + cdouble(EQSRV.GLBDATA.daytrans))
		##print(EQSRV.GLBDATA.opnBal)
	endif
	EQSRV.GLBDATA.opnBal = FORMAT$(cdouble(EQSRV.GLBDATA.opnBal),"%.2f")
	print(EQSRV.GLBDATA.opnBal)
	lv_e = " topnBal,tclsBal | select to_char(nvl(sum(tran_date_bal),0),9999999999999999.99) as opnBal, "
	lv_e = lv_e + " to_char(nvl(sum(VALUE_DATE_BAL),0),9999999999999999.99) as clsBal  " 
	lv_e = lv_e + " from tbaadm.eab where acid =?SVAR "
	lv_e = lv_e + " and eod_date <= to_date(?SVAR,'YYYY-MM-DD') "
	lv_e = lv_e + " and end_eod_date >= to_date(?SVAR,'YYYY-MM-DD') "
	lv_e = lv_e + " and bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.InpAcid + "|" + EQSRV.GLBDATA.eabtoDate + "|" + EQSRV.GLBDATA.eabtoDate + "|" + BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_e)
	lv_b  = urhk_dbSelectWithBind(lv_e)
	if(lv_b==0)then
		EQSRV.GLBDATA.topnBal = BANCS.OUTPARAM.topnBal
		EQSRV.GLBDATA.tclsBal = BANCS.OUTPARAM.tclsBal
	else
		EQSRV.GLBDATA.topnBal = "0"
		EQSRV.GLBDATA.tclsBal = "0"
	endif
	print(EQSRV.GLBDATA.topnBal)
	print(EQSRV.GLBDATA.tclsBal)
#get Tot Rec	
	print(EQSRV.GLBDATA.chnlId)
	print(EQSRV.GLBDATA.dcreqid)
	EQSRV.GLBDATA.dcReqNum = EQSRV.GLBDATA.dcreqid 
	EQSRV.GLBDATA.offsetCnt = "0"
	EQSRV.GLBDATA.endRecCnt = "0"
	EQSRV.GLBDATA.reqDate = mid$(BANCS.STDIN.BODDate,0,10)
	if(EQSRV.GLBDATA.backendRefNum!="")then
	#{
		lv_n = "lstOfstCnt,balanceRecs,lastClsBal | select offset_cnt,end_rec_cnt,last_cls_bal from custom.eb_faswp_tbl where bank_id=?SVAR "
		lv_n = lv_n + " and backend_req_num=?SVAR and acct_id=?SVAR and entity_cre_flg='Y' and del_flg='N' " 
		print(lv_n)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.backendRefNum + "|" + EQSRV.GLBDATA.AcctId
		print(BANCS.INPARAM.BINDVARS)
		lv_b = urhk_dbSelectWithBind(lv_n)
		if(lv_b==0)then
		#{
			EQSRV.GLBDATA.lstOfstCnt = BANCS.OUTPARAM.lstOfstCnt		
			EQSRV.GLBDATA.balanceRecs = BANCS.OUTPARAM.balanceRecs
			EQSRV.GLBDATA.lastClsBal = BANCS.OUTPARAM.lastClsBal
		#}
		else
		#{
			EQSRV.GLBDATA.lstOfstCnt = "0"
		#}
		endif
		print(EQSRV.GLBDATA.lstOfstCnt)
		print(EQSRV.GLBDATA.numOfTxns)
		EQSRV.GLBDATA.offsetCnt = cdouble(EQSRV.GLBDATA.lstOfstCnt) + cdouble(EQSRV.GLBDATA.numOfTxns)
	#}
	else
	#{
		EQSRV.GLBDATA.lastClsBal = ""
		EQSRV.GLBDATA.offsetCnt = EQSRV.GLBDATA.numOfTxns 
	#}
	endif
	lv_p = "ptrn,tmstmp,rdstr |  select 'VPFASWP',to_char(systimestamp,'SSSSSFF'),dbms_random.string('a', 7) from dual " 
	lv_o = urhk_dbSelectWithBind(lv_p)
	if(lv_o==0)then
	#{
		EQSRV.GLBDATA.ptrn = BANCS.OUTPARAM.ptrn
		EQSRV.GLBDATA.tmstmp = BANCS.OUTPARAM.tmstmp
		EQSRV.GLBDATA.rdstr  = BANCS.OUTPARAM.rdstr 
	#}
	else
	#{
		EQSRV.GLBDATA.ptrn = ""
		EQSRV.GLBDATA.tmstmp = ""
		EQSRV.GLBDATA.rdstr = ""
	#}
	endif
	EQSRV.GLBDATA.bckNdRefNum = EQSRV.GLBDATA.ptrn + "" + EQSRV.GLBDATA.tmstmp + "" + EQSRV.GLBDATA.rdstr
	lv_f = "totRecCnt|select count(*) from tbaadm.dctd_acli where bank_id =?SVAR " 
	lv_f = lv_f + " and ((acid =?SVAR) "
	lv_f = lv_f + " and (gl_date >= to_date( ?SVAR ,'YYYY-MM-DD HH24:MI:SS')) " 
	lv_f = lv_f + " and (gl_date <= to_date( ?SVAR ,'YYYY-MM-DD HH24:MI:SS')) " 
	lv_f = lv_f + " and (tran_date >= to_date( ?SVAR , 'YYYY-MM-DD HH24:MI:SS')) "
	lv_f = lv_f + " and (tran_date <= to_date( ?SVAR , 'YYYY-MM-DD HH24:MI:SS')) ) " 
	lv_f = lv_f + " and pstd_flg = 'Y' " 
	lv_f = lv_f + " and (REF_NUM is NULL OR REF_NUM LIKE '%' ) " 
	if(EQSRV.GLBDATA.txnType!="B")then
	#{
		lv_f = lv_f + " and part_tran_type=?SVAR " 
	#}
	endif
	lv_f = lv_f + " order by gl_date ASC,pstd_date ASC, tran_id ASC ,part_tran_srl_num ASC "
	if(EQSRV.GLBDATA.txnType!="B")then
	#{
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.InpAcid + "|" + EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate + "|" + EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate + "|" + EQSRV.GLBDATA.txnType 
	#}
	else
	#{
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.InpAcid + "|" + EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate + "|" + EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate 
	#}
	endif
	print(lv_f)
	print(BANCS.INPARAM.BINDVARS)
	lv_h = urhk_dbSelectWithBind(lv_f)
	if(lv_h==0)then
	#{
		EQSRV.GLBDATA.totRecCnt = BANCS.OUTPARAM.totRecCnt
	#}
	else
	#{
		EQSRV.GLBDATA.totRecCnt = "0" 
	#}
	endif
	if(cdouble(EQSRV.GLBDATA.totRecCnt)>cdouble(EQSRV.GLBDATA.numOfTxns))then
        #{
                EQSRV.GLBDATA.hasMoreYN = "Y"
        #}
        else
        #{
                EQSRV.GLBDATA.hasMoreYN = "N"
        #}
        endif

	#---------------------------------------------------Add Record remaining Edwin Zico
	if(EQSRV.GLBDATA.backendRefNum=="")then
                print(EQSRV.GLBDATA.totRecCnt)
                print(EQSRV.GLBDATA.recordsGenerated)
                EQSRV.GLBDATA.endRecCnt = cdouble(EQSRV.GLBDATA.totRecCnt) - cdouble(EQSRV.GLBDATA.recordsGenerated)
                print(EQSRV.GLBDATA.endRecCnt)
	else
		print(EQSRV.GLBDATA.recordsGenerated)
		print(EQSRV.GLBDATA.balanceRecs)
		EQSRV.GLBDATA.endRecCnt = cdouble(EQSRV.GLBDATA.balanceRecs) - cdouble(EQSRV.GLBDATA.recordsGenerated)
		print(EQSRV.GLBDATA.endRecCnt)
		if(cdouble(EQSRV.GLBDATA.endRecCnt)>0)then
			EQSRV.GLBDATA.hasMoreYN = "Y"
		else
			EQSRV.GLBDATA.hasMoreYN = "N"
		endif
	endif
			
	#---------------------------------------------------End
#stmt Data
	sv_s = "soId,tranId,partSrlNum,tranType,tranSubType,ptranType,pstdDate,refNum,ValueDate,tranDate,tranAmount,tranCrncy,tranParticular,tranParticular2,tranRmks,instemntType,instDate,instNum,instAlpha,fxTranAmt,fxCrncyCode,Crncycode,tranCrncyCode | "
	sv_s = sv_s + " select  sol_id,tran_id,part_tran_srl_num,tran_type,tran_sub_type,part_tran_type,to_char(pstd_date, 'YYYY-MM-DD HH24:MI:SS' ),ref_num,to_char(value_date, 'YYYY-MM-DD HH24:MI:SS' ),to_char(tran_date, 'YYYY-MM-DD HH24:MI:SS' ),tran_amt,tran_crncy_code,tran_particular,tran_particular_2,tran_rmks,instrmnt_type,to_char(instrmnt_date, 'YYYY-MM-DD HH24:MI:SS' ),instrmnt_num,instrmnt_alpha,fx_tran_amt,crncy_code,crncy_code,tran_crncy_code  "
	sv_s = sv_s + " from tbaadm.dctd_acli " 
	sv_s = sv_s + " where bank_id = ?SVAR "  
	sv_s = sv_s + " and ((acid = ?SVAR) "
	sv_s = sv_s + " and (gl_date >= to_date( ?SVAR ,'YYYY-MM-DD HH24:MI:SS')) " 
	sv_s = sv_s + " and (gl_date <= to_date( ?SVAR ,'YYYY-MM-DD HH24:MI:SS')) " 
	sv_s = sv_s + " and (tran_date >= to_date( ?SVAR , 'YYYY-MM-DD HH24:MI:SS')) "
	sv_s = sv_s + " and (tran_date <= to_date( ?SVAR , 'YYYY-MM-DD HH24:MI:SS')) ) " 
	if(EQSRV.GLBDATA.txnType!="B")then
	#{
	sv_s = sv_s + " and part_tran_type='"+EQSRV.GLBDATA.txnType+"' " 
	#}
	endif
	sv_s = sv_s + " and pstd_flg = 'Y' " 
	sv_s = sv_s + " and (ref_num is null or ref_num like '%' ) " 
	if(EQSRV.GLBDATA.sortIn=="D")then
	#{
	sv_s = sv_s + " order by  gl_date desc,pstd_date desc,tran_id desc,part_tran_srl_num desc " 
	#}
	endif
	if(EQSRV.GLBDATA.sortIn=="A")then
	#{
	sv_s = sv_s + " order by  gl_date asc,pstd_date asc,tran_id asc,part_tran_srl_num asc " 
	#}
	endif
	if(EQSRV.GLBDATA.backendRefNum=="")then
	#{
	sv_s = sv_s + " fetch first " +EQSRV.GLBDATA.numOfTxns+ " rows only "
	#}
	endif
	if(EQSRV.GLBDATA.backendRefNum!="")then
	#{
	sv_s = sv_s + " offset " +EQSRV.GLBDATA.lstOfstCnt+ " rows fetch next " +EQSRV.GLBDATA.numOfTxns + " rows only " 
	#}
	endif
	print(EQSRV.GLBDATA.InpAcid)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.InpAcid + "|" +  EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate + "|" + EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_s)
        sv_u = urhk_dbCursorOpenWithBind(sv_s)
        if(sv_u == 0)then
	#{
                EQSRV.GLBDATA.aclCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	#}
        else
	#{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Database Error ")
                goto SIFNO
	#}
        endif
        EQSRV.GLBDATA.recNum = 0
	EQSRV.GLBDATA.trnrecNum = "1"
        sv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.aclCurNum)
        if(sv_f !=0)then
	#{
                sv_f = urhk_dbCursorClose(EQSRV.GLBDATA.aclCurNum)
                print(sv_f)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                ###sv_u = urhk_SetOrbOut("Message|Database Error ")
		sv_u = urhk_SetOrbOut("Message|No More Records Exist for the backendRefNum: " + EQSRV.GLBDATA.backendRefNum )
                goto SIFNO
	#}
        endif
        while(sv_f ==0)
	#{
		EQSRV.GLBDATA.soId = BANCS.OUTPARAM.soId
		EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
		EQSRV.GLBDATA.partSrlNum = BANCS.OUTPARAM.partSrlNum
		EQSRV.GLBDATA.tranType = BANCS.OUTPARAM.tranType
		print(EQSRV.GLBDATA.tranType)
		EQSRV.GLBDATA.tranSubType = BANCS.OUTPARAM.tranSubType
		print(EQSRV.GLBDATA.tranSubType)
	        EQSRV.GLBDATA.tranTypeCat = EQSRV.GLBDATA.tranType + "" + EQSRV.GLBDATA.tranSubType 
		EQSRV.GLBDATA.ptranType = BANCS.OUTPARAM.ptranType
		EQSRV.GLBDATA.pstdDate = BANCS.OUTPARAM.pstdDate 
		EQSRV.GLBDATA.refNum = BANCS.OUTPARAM.refNum 
		EQSRV.GLBDATA.ValueDate = BANCS.OUTPARAM.ValueDate
		EQSRV.GLBDATA.tranDate = BANCS.OUTPARAM.tranDate
