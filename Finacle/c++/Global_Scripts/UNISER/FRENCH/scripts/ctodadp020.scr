<--START
CHECKSUM="94a61840f8081488205a8595ecf0040466a27e1693af57d1b0c6d2bdda62cd12"
	
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CTODA") == 0) THEN
	#{
		CREATECLASS("CUST", "CTODA", 5)
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "INTERFACE") == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# Getting Input at Backend
	#--------------------------------------------------------------------------
	CUST.CTODA.availReqId =  TRIM(BANCS.INPUT.availReqId)
	print(CUST.CTODA.availReqId)
	BANCS.INPARAM.BINDVARS = CUST.CTODA.availReqId + "|N|" + BANCS.STDIN.contextBankId
	sv_s = " acctNum|SELECT  acct_num  "
	sv_s = sv_s + " FROM CUSTOM.C_TODA "
	sv_s = sv_s + "  WHERE  request_id =?SVAR  "
	sv_s = sv_s + " AND IS_DELETED = ?SVAR"
	sv_s = sv_s + " AND VERIFY_BY IS NOT NULL"
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		sv_w = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_w)
		GOTO FINISH
		#}
	ELSE
		#{
		CUST.CTODA.accNum = BANCS.OUTPARAM.acctNum
	#}
	ENDIF
	
	#CUST.CTODA.accNum =  TRIM(BANCS.INPUT.acctNum)
	print(CUST.CTODA.accNum)
	
	BANCS.INPARAM.BINDVARS = CUST.CTODA.accNum + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "crncyCode,acctName,solId|"
	sv_s = sv_s + " SELECT ACCT_CRNCY_CODE,ACCT_NAME,SOL_ID"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		CUST.CTODA.crncyCode = ""
		CUST.CTODA.acctName = ""
		CUST.CTODA.solId = ""
		#}
	ELSE
		#{
		CUST.CTODA.crncyCode = BANCS.OUTPARAM.crncyCode
		print(CUST.CTODA.crncyCode)
		CUST.CTODA.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CTODA.acctName)
		CUST.CTODA.solId = BANCS.OUTPARAM.solId
		print(CUST.CTODA.solId)
		
	#}
	ENDIF
	
	
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctCrncy|" + CUST.CTODA.crncyCode
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctSolId|" + CUST.CTODA.solId
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctName|" + CUST.CTODA.acctName
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "accNum|" + CUST.CTODA.accNum
	sv_u = urhk_SetOrbOut(sv_w)
	
	
	FINISH:
		EXITSCRIPT
		
END-->
