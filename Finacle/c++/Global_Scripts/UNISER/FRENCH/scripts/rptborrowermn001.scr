			BANCS.INPARAM.BINDVARS = CUST.RPBU.cif_id + "|" + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				sv_q = CINT(BANCS.OUTPARAM.gam_count)
