					#{
						sv_s = "recordstatus|SELECT recordstatus FROM CRMUSER.ACCOUNTS "
						sv_s = sv_s + "WHERE bank_id = ?SVAR "
						sv_s = sv_s + "AND orgkey = ?SVAR "
