							sv_s = sv_s + "WHERE bank_id = ?SVAR "
							sv_s = sv_s + "AND corp_key = ?SVAR "
							BANCS.INPARAM.BINDVARS = CUST.RPBU.remarks + "|" + BANCS.STDIN.contextBankId + "|" + CUST.RPBU.cif_id
