<--START
TRACE ON

	#-------------------------------------------------------------------------------------
	#Setting the value to the response XML
	#-------------------------------------------------------------------------------------
	sv_q = 1
	WHILE(sv_q <= CINT(CUST.INTERFACE.recordCount))
	#{
		sv_v = "bankCode_" + FORMAT$(sv_q, "%d")
		sv_t = "BankBranchInq_RES.BankBranchArray.<rec_" + FORMAT$(sv_q,"%d") + ">.BankCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "branchCode_" + FORMAT$(sv_q, "%d")
		sv_t = "BankBranchInq_RES.BankBranchArray.<rec_" + FORMAT$(sv_q,"%d") + ">.BranchCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		IF (CUST.INTERFACE.paySysID != "") THEN
		#{
			sv_v = "bankIdentifier_" + FORMAT$(sv_q, "%d")
			sv_t = "BankBranchInq_RES.BankBranchArray.<rec_" + FORMAT$(sv_q,"%d") + ">.BankIdentifier| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF
		sv_v = "branchName_" + FORMAT$(sv_q, "%d")
		sv_t = "BankBranchInq_RES.BankBranchArray.<rec_" + FORMAT$(sv_q,"%d") + ">.BranchName| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		sv_q = sv_q + 1
	#}
	DO	

#TRACE OFF
END-->
