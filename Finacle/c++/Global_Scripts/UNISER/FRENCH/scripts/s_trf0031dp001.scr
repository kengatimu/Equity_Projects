<--START
CHECKSUM="a963fb4f65d432ddf399f7c6b9a2e9f672af92668cea3389214c54e2075e805b"
	TRACE ON
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","TRF0031") == 0) THEN
	#{
		CREATECLASS("CUST","TRF0031",5)
	#}
	ENDIF
	#---------------------------------------------------------------------------------------------
	# Getting Remittance id from front end
	#---------------------------------------------------------------------------------------------
	CUST.TRF0031.msg = ""
	CUST.TRF0031.remtId = TOUPPER(BANCS.INPUT.remitId)
	PRINT(CUST.TRF0031.remtId)
	
	
	#############################################################################
	# Fetching Fed Wire/Sort Code
	#############################################################################
	sv_s =""
	sv_s = sv_s + " cnt|"
	sv_s = sv_s + " SELECT COUNT(*)"
	sv_s = sv_s + " FROM CUSTOM.C_PTYDTL"
	sv_s = sv_s + " WHERE C_PTYDTL.remt_id = ?SVAR"
	sv_s = sv_s + " AND C_PTYDTL.entity_cre_flg IN('N','Y')"
	sv_s = sv_s + " AND C_PTYDTL.del_flg = 'N'"
	sv_s = sv_s + " AND C_PTYDTL.bank_id = ?SVAR"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS	=""
	BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
	BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d ==0) THEN
	#{
		CUST.TRF0031.recordCnt=BANCS.OUTPARAM.cnt
		print(CUST.TRF0031.recordCnt)
		IF (CINT(BANCS.OUTPARAM.cnt) > 0) THEN
		#{
			sv_s =""
			sv_s = sv_s + " msg|"
			sv_s = sv_s + " SELECT 	C_PTYDTL.fed_sort_num"
			sv_s = sv_s + " FROM 	CUSTOM.C_PTYDTL"
			sv_s = sv_s + " WHERE 	C_PTYDTL.remt_id = ?SVAR"
			sv_s = sv_s + " AND 	C_PTYDTL.entity_cre_flg IN('N','Y')"
			sv_s = sv_s + " AND 	C_PTYDTL.del_flg = 'N'"
			sv_s = sv_s + " AND 	C_PTYDTL.bank_id = ?SVAR"
			
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS	=""
			BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
			BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			
			IF(sv_d ==0) THEN
			#{
				IF(BANCS.OUTPARAM.msg == "") THEN
				#{
					CUST.TRF0031.msg = "nvl"
					PRINT(CUST.TRF0031.msg)
					#}
				ELSE
					#{
					CUST.TRF0031.msg = BANCS.OUTPARAM.msg
					PRINT(CUST.TRF0031.msg)
				#}
				ENDIF
				
				sv_a = urhk_SetOrbOut("msg|"+CUST.TRF0031.msg)
				PRINT(sv_a)
				#}
			ELSE
				#{
				sv_o = urhk_SetOrbOut("stat|Err")
				PRINT(sv_o)
			#}
			ENDIF
			#}
		ELSE
			#{
			
			sv_o = urhk_SetOrbOut("stat|Err")
			PRINT(sv_o)
		#}
		ENDIF
		#}
	ELSE
		#{
		
		sv_o = urhk_SetOrbOut("stat|Err")
		PRINT(sv_o)
	#}
	ENDIF
	
	TRACE OFF
END-->
