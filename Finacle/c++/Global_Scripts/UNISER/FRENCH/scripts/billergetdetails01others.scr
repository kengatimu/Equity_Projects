
<--START
	TRACE ON

	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)

	#========================================================
	# Check whether CUST Repository exists else create it
	#========================================================
	sv_r = REPEXISTS("CUST")
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	#========================================================
	# Check whether UBP Class exists else create it
	#========================================================
	sv_r = CLASSEXISTS("CUST","UBP")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","UBP",5)
	#}
	ENDIF
	#========================================================
	# Initialize the variables
	#========================================================
	
	CUST.UBP.sscName=" "
	CUST.UBP.errorFlg="N"
	CUST.UBP.errorMsg=" "
	#========================================================
	# Validating Ref. Num
	#========================================================
	IF(FIELDEXISTS(BANCS.INPUT.billRefNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.billRefNum) != "")THEN
		#{
			CUST.UBP.billRefNum = TOUPPER(TRIM(BANCS.INPUT.billRefNum))
			PRINT(CUST.UBP.billRefNum)
			
			#}
		ELSE
			#{
			CUST.UBP.billRefNum=""
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.UBP.billRefNum=""
	#}
	ENDIF
	IF(FIELDEXISTS(BANCS.INPUT.billerId))THEN
	#{
			IF(TRIM(BANCS.INPUT.billerId) != "")THEN
			#{
				CUST.UBP.billerId = TOUPPER(TRIM(BANCS.INPUT.billerId))
				PRINT(CUST.UBP.billerId)
				
			#}
			ELSE
			#{
				CUST.UBP.billerId=""
			#}
			ENDIF
	#}
	ELSE
	#{
		CUST.UBP.billerId=""
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.billercode))THEN
	#{
		IF(TRIM(BANCS.INPUT.billercode) != "")THEN
		#{
			CUST.UBP.billercode = TOUPPER(TRIM(BANCS.INPUT.billercode))
			PRINT(CUST.UBP.billercode)
			
			#}
		ELSE
			#{
			CUST.UBP.billercode=""
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.UBP.billercode=""
	#}
	ENDIF
	IF(FIELDEXISTS(BANCS.INPUT.billeramount))THEN
	#{
		IF(TRIM(BANCS.INPUT.billeramount) != "")THEN
		#{
			CUST.UBP.billeramount = TOUPPER(TRIM(BANCS.INPUT.billeramount))
			PRINT(CUST.UBP.billeramount)
			
			#}
		ELSE
			#{
			CUST.UBP.billeramount="0"
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.UBP.billeramount="0"
	#}
	ENDIF
	#========================================================
	# Validating the account Id for fetching bank id
	#========================================================
	IF(FIELDEXISTS(BANCS.INPUT.billAcctId))THEN
	#{
		IF(TRIM(BANCS.INPUT.billAcctId) != "")THEN
		#{
			CUST.UBP.billAcctId = TOUPPER(TRIM(BANCS.INPUT.billAcctId))
			PRINT(CUST.UBP.billAcctId)
			#Change starts
			BANCS.INPARAM.BINDVARS = CUST.UBP.billerId+"|"+CUST.UBP.billAcctId+"|Y|N|" + BANCS.STDIN.contextBankId
			sv_s = "billerBnkId|"
			sv_s = sv_s + " SELECT FREE_TEXT2"
			sv_s = sv_s + " FROM TBAADM.BRGT "
			sv_s = sv_s + " WHERE BILLER_ID=?SVAR"
			sv_s = sv_s + " AND FREE_TEXT1=?SVAR"
			sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
			sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
			sv_s = sv_s + " AND BANK_ID = ?SVAR"
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0)THEN
			#{
				CUST.UBP.billerBnkId = BANCS.OUTPARAM.billerBnkId
				PRINT(CUST.UBP.billerBnkId)
			#}
			ELSE
			#{
				CUST.UBP.billerBnkId=""
			#}
			ENDIF
					
		#change-ends
			BANCS.INPARAM.BINDVARS = CUST.UBP.billAcctId+"|N|Y|"+CUST.UBP.billerBnkId
			sv_s = "count1|"
			sv_s = sv_s + " SELECT COUNT(1)"
			sv_s = sv_s + " FROM TBAADM.GAM "
			sv_s = sv_s + " WHERE FORACID=?SVAR"
			sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
			sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'N') = ?SVAR"
			sv_s = sv_s + " AND BANK_ID = ?SVAR"
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d!=0)THEN
			#{
				CUST.UBP.errorFlg = "Y"
				#CUST.UBP.errorMsg = "Invalid account linked to biller Id"
				
				CUST.UBP.errorCode = "UBP_ERR038"
				CALL("ubpdp044.scr")
				CUST.UBP.errorMsg =CUST.UBP.errorDesc
				##CUST.UBP.insertTableFlg ="N"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.UBP.count1 = BANCS.OUTPARAM.count1
				PRINT(CUST.UBP.count1)
				IF(CUST.UBP.count1==0)THEN
				#{
					CUST.UBP.errorFlg = "Y"
					#CUST.UBP.errorMsg = "Invalid account linked to biller Id"
					
					CUST.UBP.errorCode = "UBP_ERR038"
					CALL("ubpdp044.scr")
					CUST.UBP.errorMsg =CUST.UBP.errorDesc
					#CUST.UBP.insertTableFlg ="N"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.UBP.billAcctId=""
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.UBP.billAcctId=""
	#}
	ENDIF
	#========================================================
	# Validating the biller account Id for fetching bank id
	#========================================================
	IF(CUST.UBP.billAcctId!="")THEN
	#{
		#Change starts
		BANCS.INPARAM.BINDVARS = CUST.UBP.billerId+"|"+CUST.UBP.billAcctId+"|Y|N|" + BANCS.STDIN.contextBankId
		sv_s = "billerBnkId,freetextflg|"
		sv_s = sv_s + " SELECT FREE_TEXT2,trim(FREE_TEXT4)"
		sv_s = sv_s + " FROM TBAADM.BRGT "
		sv_s = sv_s + " WHERE BILLER_ID=?SVAR"
		sv_s = sv_s + " AND FREE_TEXT1=?SVAR"
		sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		sv_s = sv_s + " AND BANK_ID = ?SVAR"
		PRINT(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d==0)THEN
		#{
			CUST.UBP.billerBnkId = BANCS.OUTPARAM.billerBnkId
			PRINT(CUST.UBP.billerBnkId)
			CUST.UBP.freetextflg = BANCS.OUTPARAM.freetextflg
			PRINT(CUST.UBP.freetextflg)
		#}
		ELSE
		#{
			CUST.UBP.billerBnkId=""
			CUST.UBP.freetextflg = ""
		#}
		ENDIF
							
		#change-ends
		BANCS.INPARAM.BINDVARS = CUST.UBP.billAcctId+"|N|Y|"+CUST.UBP.billerBnkId
		sv_s = "bankId|"
		sv_s = sv_s + " SELECT BANK_ID"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE FORACID=?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'N') = ?SVAR"
		sv_s = sv_s + " AND BANK_ID = ?SVAR"
		PRINT(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d != 0)THEN
		#{
			CUST.UBP.errorFlg = "Y"
			#CUST.UBP.errorMsg = "Enter a valid Ref. Num"
			
			CUST.UBP.errorCode = "UBP_ERR039"
			CALL("ubpdp044.scr")
			CUST.UBP.errorMsg =CUST.UBP.errorDesc
			#CUST.UBP.insertTableFlg ="N"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.UBP.bankId = BANCS.OUTPARAM.bankId
			PRINT(CUST.UBP.bankId)
		#}
		ENDIF
	#}
	ENDIF
	#========================================================
	# Validating Ref. Num and fetching Name from C_CIC TABLE
	#========================================================
	IF(CUST.UBP.billRefNum!="")THEN
	#{
		IF(CUST.UBP.billAcctId=="0130261954816")THEN
		#{
		CALL("b_acctdetailsval.scr")

		ELSE
			BANCS.INPARAM.BINDVARS = CUST.UBP.billAcctId+"|"+CUST.UBP.billRefNum+"|"+CUST.UBP.bankId+"|N"
			sv_s = "count|"
			sv_s = sv_s + " SELECT COUNT(1)"
			sv_s = sv_s + " FROM CUSTOM.C_CIC "
			sv_s = sv_s + " WHERE ACCTNUM=?SVAR"
			sv_s = sv_s + " AND REFNUM=?SVAR"
			sv_s = sv_s + " AND BANK_ID=?SVAR"
			sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d != 0)THEN
			#{
				CUST.UBP.errorFlg = "Y"
				#CUST.UBP.errorMsg = "Enter a valid Ref. Num"
				CUST.UBP.errorCode = "UBP_ERR039"
				CALL("ubpdp044.scr")
				CUST.UBP.errorMsg =CUST.UBP.errorDesc
				#CUST.UBP.insertTableFlg ="N"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.UBP.count = BANCS.OUTPARAM.count
				PRINT(CUST.UBP.count)
				IF (CUST.UBP.freetextflg=="L") THEN
					IF(CUST.UBP.count=="0")THEN
					#{
						CUST.UBP.errorFlg = "Y"
						#CUST.UBP.errorMsg = "Record not found in C_CIC. please enter Name."
						
						CUST.UBP.errorCode = "UBP_ERR040"
						CALL("ubpdp044.scr")
						CUST.UBP.errorMsg =CUST.UBP.errorDesc
						#CUST.UBP.insertTableFlg ="N"
						GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						BANCS.INPARAM.BINDVARS = CUST.UBP.billAcctId+"|"+CUST.UBP.billRefNum+"|N|"+CUST.UBP.bankId
						sv_s = "name|"
						sv_s = sv_s + " SELECT NAME"
						sv_s = sv_s + " FROM CUSTOM.C_CIC "
						sv_s = sv_s + " WHERE ACCTNUM=?SVAR"
						sv_s = sv_s + " AND REFNUM=?SVAR"
						sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
						sv_s = sv_s + " AND BANK_ID = ?SVAR"
						PRINT(sv_s)
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						IF(sv_d != 0)THEN
						#{
							CUST.UBP.errorFlg = "Y"
							#CUST.UBP.errorMsg = "Enter a valid Ref. Num"
							CUST.UBP.errorCode = "UBP_ERR039"
							CALL("ubpdp044.scr")
							CUST.UBP.errorMsg =CUST.UBP.errorDesc
							#CUST.UBP.insertTableFlg ="N"
							GOTO ENDOFSCRIPT
						#}
						ELSE
						#{
							CUST.UBP.sscName = BANCS.OUTPARAM.name
							PRINT(CUST.UBP.sscName)
						#}
						ENDIF
					#}
					ENDIF
				ENDIF
				IF (CUST.UBP.freetextflg=="R") THEN
					print(CUST.UBP.billerId)
					PRINT(CUST.UBP.billRefNum)
					PRINT(CUST.UBP.billercode)
					PRINT(CUST.UBP.billAcctId)
					PRINT(CUST.UBP.billeramount)
					#####
						sv_q = " Eslipdetails| select custom.tpb_pkg.callupgbvwsfunction(?SVAR,?SVAR,?SVAR) from dual"
						print(sv_q)
						BANCS.INPARAM.BINDVARS=CUST.UBP.billercode + "|"+ CUST.UBP.billRefNum +"|"+ CUST.UBP.billeramount
						print(BANCS.INPARAM.BINDVARS)
						sv_w=urhk_dbSelectWithBind(sv_q)
						print(sv_w)
						IF ( sv_w != 0 ) then
							CUST.UBP.errorFlg = "Y"
							CUST.UBP.errorMsg = "Enter a valid Ref. Num"
						ELSE
							CUST.UBP.Eslipdetails = BANCS.OUTPARAM.Eslipdetails
							print(CUST.UBP.Eslipdetails)
							IF (CUST.UBP.Eslipdetails=="") THEN
								CUST.UBP.errorFlg = "Y"
								CUST.UBP.errorMsg = "Enter a valid Ref. Num"
							ELSE
								sv_s = CUST.UBP.Eslipdetails
								print(sv_s)
								sv_u = "statusbill,EslipDetails1|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.UBP.statusbill = BANCS.OUTPARAM.statusbill
								print(CUST.UBP.statusbill)
								CUST.UBP.EslipDetails1 = BANCS.OUTPARAM.EslipDetails1
								print(CUST.UBP.EslipDetails1)

								sv_s = CUST.UBP.EslipDetails1
								print(sv_s)
								sv_u = "statusbil2,EslipDetails2|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.UBP.statusbil2 = BANCS.OUTPARAM.statusbil2
								print(CUST.UBP.statusbil2)
								CUST.UBP.EslipDetails2 = BANCS.OUTPARAM.EslipDetails2
								print(CUST.UBP.EslipDetails2)

								sv_s = CUST.UBP.EslipDetails2
								print(sv_s)
								sv_u = "statusbil3,EslipDetails3|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.UBP.statusbil3 = BANCS.OUTPARAM.statusbil3
								print(CUST.UBP.statusbil3)
								CUST.UBP.EslipDetails3 = BANCS.OUTPARAM.EslipDetails3
								print(CUST.UBP.EslipDetails3)

								sv_s = CUST.UBP.EslipDetails3
								print(sv_s)
								sv_u = "statusbil4,EslipDetails4|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.UBP.statusbil4 = BANCS.OUTPARAM.statusbil4
								print(CUST.UBP.statusbil4)
								CUST.UBP.EslipDetails4 = BANCS.OUTPARAM.EslipDetails4
								print(CUST.UBP.EslipDetails4)

								sv_s = CUST.UBP.EslipDetails4
								print(sv_s)
								sv_u = "statusbil5,EslipDetails5|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.UBP.statusbil5 = BANCS.OUTPARAM.statusbil5
								print(CUST.UBP.statusbil5)
								CUST.UBP.EslipDetails5 = BANCS.OUTPARAM.EslipDetails5
								print(CUST.UBP.EslipDetails5)

								print(CUST.UBP.statusbil5)
								BANCS.OUTPUT.TranParticulars2=CUST.UBP.statusbil5
								print(BANCS.OUTPUT.TranParticulars2)

								IF (CUST.UBP.statusbill=="false") THEN
									CUST.UBP.errorFlg = "Y"
									CUST.UBP.errorMsg = "Enter a valid Ref. Num"
								ENDIF
							ENDIF
						ENDIF
					#####
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	ENDOFSCRIPT:
		sv_s = "errorFlg|" + CUST.UBP.errorFlg
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		sv_s = "errorMsg|" + CUST.UBP.errorMsg
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		sv_s = "billerId|" + BANCS.INPUT.billerId
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)

		sv_s = "billAcctId|" + BANCS.INPUT.billAcctId
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)

		sv_s = "billRefNum|" + BANCS.INPUT.billRefNum
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		sv_s = "namefld|" + CUST.UBP.sscName
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		
		sv_s = "billercode|" + CUST.UBP.billercode
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
		sv_s = "billeramount|" + CUST.UBP.billeramount
		PRINT(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		PRINT(sv_u)
END-->
