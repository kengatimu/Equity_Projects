<--START
CHECKSUM="a986f3d1040a1cb248d7db7015dc58a901122cd2fac038915db64f290b28cb86"
	TRACE ON
	#--------------------------------------------------
	#Creating Repository
	#--------------------------------------------------
	IF (REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA")==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	#--------------------------------------------------
	#Initializing
	#--------------------------------------------------
	CUST.DATA.count		= 1
	CUST.DATA.srlNum	= " "
	CUST.DATA.free1 	= " "
	CUST.DATA.amount 	= " "
	
	#--------------------------------------------------
	#Finding the no of records
	#--------------------------------------------------
	sv_s = "cnt|SELECT count(*)"
	sv_s = sv_s + " FROM CUSTOM.CREM "
	sv_s = sv_s	+ " WHERE bank_id = ?SVAR "
	print(sv_s)
	
	print(BANCS.STDIN.contextBankId)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(BANCS.OUTPARAM.cnt)
	sv_s = urhk_SetOrbOut("reccount|"+BANCS.OUTPARAM.cnt)
	
	#--------------------------------------------------
	#Curser to fetch data
	#--------------------------------------------------
	sv_s = "slrno,free1|"
	sv_s = sv_s + " SELECT LPAD(crem.bway_sequenceno,10,' '),LPAD(crem.free_text_1,30,' ')"
	sv_s = sv_s + " FROM CUSTOM.CREM "
	sv_s = sv_s	+ " WHERE bank_id = ?SVAR "
	sv_s = sv_s + " ORDER BY crem_seq "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(sv_s)
	sv_d = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d != 0) THEN
	#{
		sv_u = urhk_SRV_SetErr("No Record")
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		WHILE( sv_c == 0)
		#{
			CUST.DATA.srlNum=BANCS.OUTPARAM.slrno
			print(CUST.DATA.srlNum)
			
			CUST.DATA.free1=BANCS.OUTPARAM.free1
			print(CUST.DATA.free1)
			
			
			sv_z = "srlNum_"+ CUST.DATA.count + "|" +CUST.DATA.srlNum + "|"
			print(sv_z)
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "free1_"+ CUST.DATA.count + "|" + CUST.DATA.free1 + "|"
			print(sv_z)
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_c = urhk_dbCursorFetch(sv_l)
			CUST.DATA.count=CINT(CUST.DATA.count)+1
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
		print(sv_c)
	#}
	ENDIF
	EXITSCRIPT
	TRACE OFF
END-->
