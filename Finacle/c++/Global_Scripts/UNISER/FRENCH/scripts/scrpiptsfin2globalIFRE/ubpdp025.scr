	#========================================================
	# Fetching tthe values from BRGT table and populating
	# the searcher list
	#========================================================
	BANCS.INPARAM.BINDVARS = CUST.UBP.billerId+"|Y|N|"+ BANCS.STDIN.contextBankId
	sv_s = "billerId,billAcctId,bankId,chgEvetId,valType,billerCode|"
	sv_s = sv_s + " SELECT BILLER_ID,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,FREE_TEXT4,FREE_TEXT5"
	sv_s = sv_s + " FROM TBAADM.BRGT "
	sv_s = sv_s + " WHERE BILLER_ID=?SVAR"
	sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
	sv_s = sv_s + " AND FREE_TEXT1 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT2 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT4 IS NOT NULL"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
