#----------------------------------------------------------------------------------------------------------
# Filename              :       hdenommn005.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to call the scripts for implement detail page functionality for diffrent modes.
# Input                 :       funcCode, FE values
# Output                :       Result message or error message
# Called Script         :       hdenomdp003.scr, hdenomdp004.scr, hdenomdp005.scr, hdenomdp006.scr
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           03-05-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="5b090ce4aa5099d38a14b66a44ae0b3bb3c04a16a7242e482991840ad764f719"
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "INTERFACE") == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#  Declaration of variables used in script
	#------------------------------------------------------------------------------
	CUST.DENOM.userId = TRIM(BANCS.STDIN.userId)
	print(CUST.DENOM.userId)
	CUST.DENOM.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.DENOM.bankId)
	
	CUST.DENOM.resultPageMsg = ""
	CUST.DENOM.successFlg = "S"
	
	# Taking FE fields values in Repository variable.
	CUST.DENOM.funcCode = TRIM(BANCS.INPUT.funcCode)
	print(CUST.DENOM.funcCode)
	CUST.DENOM.crncyCode = TRIM(BANCS.INPUT.crncyCode)
	print(CUST.DENOM.crncyCode)
	CUST.DENOM.crncyName = TRIM(BANCS.INPUT.crncyName)
	print(CUST.DENOM.crncyName)
	CUST.DENOM.decimalPointAllow = TRIM(BANCS.INPUT.decimalPointAllow)
	print(CUST.DENOM.decimalPointAllow)
	# note denomination values
	CUST.DENOM.noteDenom01 = TRIM(BANCS.INPUT.noteDenom01)
	print(CUST.DENOM.noteDenom01)
	CUST.DENOM.noteDenom02 = TRIM(BANCS.INPUT.noteDenom02)
	print(CUST.DENOM.noteDenom02)
	CUST.DENOM.noteDenom03 = TRIM(BANCS.INPUT.noteDenom03)
	print(CUST.DENOM.noteDenom03)
	CUST.DENOM.noteDenom04 = TRIM(BANCS.INPUT.noteDenom04)
	print(CUST.DENOM.noteDenom04)
	CUST.DENOM.noteDenom05 = TRIM(BANCS.INPUT.noteDenom05)
	print(CUST.DENOM.noteDenom05)
	CUST.DENOM.noteDenom06 = TRIM(BANCS.INPUT.noteDenom06)
	print(CUST.DENOM.noteDenom06)
	CUST.DENOM.noteDenom07 = TRIM(BANCS.INPUT.noteDenom07)
	print(CUST.DENOM.noteDenom07)
	CUST.DENOM.noteDenom08 = TRIM(BANCS.INPUT.noteDenom08)
	print(CUST.DENOM.noteDenom08)
	CUST.DENOM.noteDenom09 = TRIM(BANCS.INPUT.noteDenom09)
	print(CUST.DENOM.noteDenom09)
	CUST.DENOM.noteDenom10 = TRIM(BANCS.INPUT.noteDenom10)
	print(CUST.DENOM.noteDenom10)
	CUST.DENOM.noteDenom11 = TRIM(BANCS.INPUT.noteDenom11)
	print(CUST.DENOM.noteDenom11)
	CUST.DENOM.noteDenom12 = TRIM(BANCS.INPUT.noteDenom12)
	print(CUST.DENOM.noteDenom12)
	CUST.DENOM.noteDenom13 = TRIM(BANCS.INPUT.noteDenom13)
	print(CUST.DENOM.noteDenom13)
	CUST.DENOM.noteDenom14 = TRIM(BANCS.INPUT.noteDenom14)
	print(CUST.DENOM.noteDenom14)
	CUST.DENOM.noteDenom15 = TRIM(BANCS.INPUT.noteDenom15)
	print(CUST.DENOM.noteDenom15)
	# coin denomination values
	CUST.DENOM.coinDenom01 = TRIM(BANCS.INPUT.coinDenom01)
	print(CUST.DENOM.coinDenom01)
	CUST.DENOM.coinDenom02 = TRIM(BANCS.INPUT.coinDenom02)
	print(CUST.DENOM.coinDenom02)
	CUST.DENOM.coinDenom03 = TRIM(BANCS.INPUT.coinDenom03)
	print(CUST.DENOM.coinDenom03)
	CUST.DENOM.coinDenom04 = TRIM(BANCS.INPUT.coinDenom04)
	print(CUST.DENOM.coinDenom04)
	CUST.DENOM.coinDenom05 = TRIM(BANCS.INPUT.coinDenom05)
	print(CUST.DENOM.coinDenom05)
	CUST.DENOM.coinDenom06 = TRIM(BANCS.INPUT.coinDenom06)
	print(CUST.DENOM.coinDenom06)
	CUST.DENOM.coinDenom07 = TRIM(BANCS.INPUT.coinDenom07)
	print(CUST.DENOM.coinDenom07)
	CUST.DENOM.coinDenom08 = TRIM(BANCS.INPUT.coinDenom08)
	print(CUST.DENOM.coinDenom08)
	CUST.DENOM.coinDenom09 = TRIM(BANCS.INPUT.coinDenom09)
	print(CUST.DENOM.coinDenom09)
	CUST.DENOM.coinDenom10 = TRIM(BANCS.INPUT.coinDenom10)
	print(CUST.DENOM.coinDenom10)
	CUST.DENOM.coinDenom11 = TRIM(BANCS.INPUT.coinDenom11)
	print(CUST.DENOM.coinDenom11)
	CUST.DENOM.coinDenom12 = TRIM(BANCS.INPUT.coinDenom12)
	print(CUST.DENOM.coinDenom12)
	CUST.DENOM.coinDenom13 = TRIM(BANCS.INPUT.coinDenom13)
	print(CUST.DENOM.coinDenom13)
	CUST.DENOM.coinDenom14 = TRIM(BANCS.INPUT.coinDenom14)
	print(CUST.DENOM.coinDenom14)
	CUST.DENOM.coinDenom15 = TRIM(BANCS.INPUT.coinDenom15)
	print(CUST.DENOM.coinDenom15)
	
	#----------------------------------------------------------------------------------
	# Calling Inserting/updating the value in the tables as per function code.
	#----------------------------------------------------------------------------------
	IF (CUST.DENOM.funcCode=="A") THEN
	#{
		call("hdenomdp003.scr")
	#}
	ENDIF
	IF (CUST.DENOM.funcCode=="M") THEN
	#{
		call("hdenomdp004.scr")
	#}
	ENDIF
	IF (CUST.DENOM.funcCode=="D") THEN
	#{
		call("hdenomdp005.scr")
	#}
	ENDIF
	IF (CUST.DENOM.funcCode=="U") THEN
	#{
		call("hdenomdp006.scr")
	#}
	ENDIF
	IF (CUST.DENOM.successFlg == "F") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#----------------------------------------------------------------------------------
	# Moving to result page and setting result message.
	#----------------------------------------------------------------------------------
	BANCS.OUTPUT.SuccessOrFailure = "S"
	sv_w = ""
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_u = urhk_SetOrbOut("RESULT_MSG|<font color=black>" + CUST.DENOM.resultPageMsg)
	ENDOFSCRIPT:
		#----------------------------------------------------------------------------------
		# Displaying error message in FE.
		#----------------------------------------------------------------------------------
		IF (CUST.DENOM.successFlg == "F") THEN
		#{
			sv_w = "SUCCESSORFAILURE|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_z = "Error_0|ERROR^" + CUST.DENOM.errorMsg + "^" + CUST.DENOM.fieldName
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.DENOM.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","DENOM") != 0) THEN
		#{
			DELETECLASS ("CUST","DENOM")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
