<--START
CHECKSUM="104cdaf13e246cb3760a1396e5b8445cf77496ec8493ce4e208449bcbd0cabb9"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIECLG Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIECLG")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIECLG",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIECLG.rejectReasonCode = " "
	CUST.CIECLG.errorFlg = "N"
	CUST.CIECLG.errorMsg = " "
	CUST.CIECLG.rejectReasonCodeDesc = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.rejectReasonCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.rejectReasonCode) != "")THEN
		#{
			CUST.CIECLG.rejectReasonCode = TOUPPER(TRIM(BANCS.INPUT.rejectReasonCode))
			print(CUST.CIECLG.rejectReasonCode)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "rejectReasonCode,rejectReasonCodeDesc|"
	sv_s = sv_s + " SELECT CLG_REJ_CODE,NVL(ALT1_CLG_REJ_DESC,CLG_REJ_DESC)"
	sv_s = sv_s + " FROM TBAADM.CRC "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
	sv_s = sv_s + " AND CLG_REJ_CODE = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.rejectReasonCode
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIECLG.rejectReasonCode = BANCS.OUTPARAM.rejectReasonCode
		print(CUST.CIECLG.rejectReasonCode)
		CUST.CIECLG.rejectReasonCodeDesc = BANCS.OUTPARAM.rejectReasonCodeDesc
		print(CUST.CIECLG.rejectReasonCodeDesc)
		
		#}
	ELSE
		#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Invalid Reject Reason Code"
	#}
	ENDIF
	
	CUST.CIECLG.rejectReasonCodeDesc = TOUPPER(CUST.CIECLG.rejectReasonCodeDesc)
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIECLG.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIECLG.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("rejectReasonCode|"+CUST.CIECLG.rejectReasonCode)
		print(sv_u)
		sv_u = urhk_SetOrbOut("rejectReasonCodeDesc|"+CUST.CIECLG.rejectReasonCodeDesc)
		print(sv_u)
		
		
END-->
