		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "inpFileName|" + CUST.STMTCHRG.fileName
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "onsUser|" + BANCS.STDIN.userId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.STMTCHRG.statementPostage == "S" ) THEN
		#{
			sv_a = "acctNo1|" + CUST.STMTCHRG.acctNo1
			#}
		ELSE
			#{
			sv_a = "acctNo1|" + CUST.STMTCHRG.acctNo2
