	#-----------------------------------------------------------
	CUST.STMTCHRG.ctlFilePath = CUST.STMTCHRG.ctlFilePath + "stmtchrg.ctl"
	print(CUST.STMTCHRG.fileName)
	
	sv_a = "sed 's/$/," + BANCS.STDIN.contextBankId + "/g' " + CUST.STMTCHRG.CMFilePath + CUST.STMTCHRG.fileName  + " > "  + CUST.STMTCHRG.tmpfilename
	print(sv_a)
	sv_r = SYSTEM(sv_a)
	PRINT(sv_r)
	sv_b = "$ORACLE_HOME/bin/sqlldr " + CUST.STMTCHRG.userPass + "  control=" + CUST.STMTCHRG.ctlFilePath + " data=" + CUST.STMTCHRG.tmpfilename
	print(sv_b)
	
	sv_a = SYSTEM(sv_b)
	print(sv_a)
	
	IF(sv_a != 0 ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Upload process failed please retry^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
