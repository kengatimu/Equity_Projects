	# Getting sysdate from dual table
	#-----------------------------------------------------------
	sv_s = "tmpname|SELECT to_char(sysdate,'ddmmyyhhmmss')"
	sv_s = sv_s + " FROM DUAL"
	
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
