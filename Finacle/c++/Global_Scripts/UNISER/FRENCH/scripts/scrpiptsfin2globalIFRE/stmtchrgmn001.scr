		sv_a = "testFlg|" + CUST.STMTCHRG.testMode
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "fileNamePath|" + CUST.STMTCHRG.fileNamePath
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------
		#---    Executing com file in background
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.scriptName = "stmtchrgmn001.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Upload process failed please retry"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.STMTCHRG.errMsg = "Unable to load com file"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.STMTCHRG.errMsg != "") THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^"+CUST.STMTCHRG.errMsg+"^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			#}
		ELSE
			#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|Upload/Process Initiated SuccessFully"
			sv_z = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
		
		exitscript
