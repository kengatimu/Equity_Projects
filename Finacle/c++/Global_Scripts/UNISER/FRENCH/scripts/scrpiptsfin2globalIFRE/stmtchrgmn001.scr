		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "solId1|" + CUST.STMTCHRG.solId1
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "solId2|" + CUST.STMTCHRG.solId2
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STMTCHRG.errMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
