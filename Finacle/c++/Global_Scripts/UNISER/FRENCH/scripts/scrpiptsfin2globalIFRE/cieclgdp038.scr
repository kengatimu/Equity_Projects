<--START
CHECKSUM="ec72a8b100fba9e890232c54153d11ddbef55070e7f8009261ac8482f1428c06"
	TRACE ON
	
	PRINT(CUST.CIECLG.instrumentEntity)
	PRINT(BANCS.STDIN.contextBankId)
	PRINT(CUST.CIECLG.payingAcct)
	PRINT(CUST.CIECLG.nostroAcct)
	PRINT(CUST.CIECLG.vostroAcct)
	PRINT(CUST.CIECLG.instrumentAmt)
	PRINT(CUST.CIECLG.instrumentAmtCcy)
	PRINT(CUST.CIECLG.instrumentDate)
	PRINT(CUST.CIECLG.instrumentAlpha)
	PRINT(CUST.CIECLG.instrumentNum)
	
	###########################################################################################
	# Set inputs for XferTranAdd FI API Call
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	print(BANCS.STDIN.sysDate)
	
	sv_s = "RequestID|SELECT CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0)THEN
	#{
		CUST.CIECLG.RequestID = BANCS.OUTPARAM.RequestID
		print(CUST.CIECLG.RequestID)
		#}
	ELSE
		#{
		CUST.CIECLG.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(CUST.CIECLG.RequestID)
	#}
	ENDIF
	
	CUST.INTERFACE.interfaceRequestID = "XferTrnAdd"
	CUST.INTERFACE.interfaceRequestVersion = "10.2"
	CUST.INTERFACE.RequestID = CUST.CIECLG.RequestID
	CUST.INTERFACE.bankID = CUST.CIECLG.instrumentEntity
	CUST.INTERFACE.channelID = "COR"
	CUST.INTERFACE.tranType = "T"
	CUST.INTERFACE.tranSubType = "BI"
	CUST.INTERFACE.drAcctID = CUST.CIECLG.payingAcct
	
	IF(CUST.CIECLG.instrumentEntity == BANCS.STDIN.contextBankId)THEN
	#{
		CUST.INTERFACE.crAcctID = CUST.CIECLG.nostroAcct
		CUST.INTERFACE.entity1 = CUST.CIECLG.instrumentEntity
		CUST.INTERFACE.entity2 = CUST.CIECLG.creditEntity
		#}
	ELSE
		#{
		CUST.INTERFACE.crAcctID = CUST.CIECLG.vostroAcct
		CUST.INTERFACE.entity1 = CUST.CIECLG.creditEntity
		CUST.INTERFACE.entity2 = CUST.CIECLG.instrumentEntity
	#}
	ENDIF
	
	CUST.INTERFACE.tranAmt = CUST.CIECLG.instrumentAmt
	CUST.INTERFACE.tranCcy = CUST.CIECLG.instrumentAmtCcy
	CUST.INTERFACE.tranParticulars = "Inter Entity Clearing Txn"
	CUST.INTERFACE.tranRmks = ""
	CUST.INTERFACE.drValueDate = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.INTERFACE.rateCode = "MEAN"
	CUST.INTERFACE.drRate = ""
	CUST.INTERFACE.crRate = ""
	CUST.INTERFACE.chkInstDetails = "Y"
	CUST.INTERFACE.instDate = CUST.CIECLG.instrumentDate
	CUST.INTERFACE.instAlpha = CUST.CIECLG.instrumentAlpha
	CUST.INTERFACE.instNum = CUST.CIECLG.instrumentNum
	CUST.INTERFACE.instType = "CHQ"
	
	CUST.INTERFACE.errorMsgFlg = "N"
	CUST.INTERFACE.errorMsgCode = " "
	CUST.INTERFACE.errorMsgDesc = " "
	
	CALL("cietxnmn003.scr")
	
	IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Could not debit fund from Paying Account ID^prodCode")
		print(sv_u)
		sv_s = "Error_2|Error^"+ CUST.INTERFACE.errorDesc + "^prodCode"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CIECLG.instrumentEntity == BANCS.STDIN.contextBankId)THEN
	#{
		CUST.CIECLG.entity1TranId = CUST.INTERFACE.tranId
		CUST.CIECLG.entity1TranDate = MID$(CUST.INTERFACE.tranDate,0,10)
		PRINT(CUST.CIECLG.entity1TranId)
		PRINT(CUST.CIECLG.entity1TranDate)
		#}
	ELSE
		#{
		CUST.CIECLG.entity2TranId = CUST.INTERFACE.tranId
		CUST.CIECLG.entity2TranDate = MID$(CUST.INTERFACE.tranDate,0,10)
		PRINT(CUST.CIECLG.entity2TranId)
		PRINT(CUST.CIECLG.entity2TranDate)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
END-->
