	CUST.DATA.rate = ""
	
	sv_a = urhk_SRV_GetVal("bgCritDtl.bgSrlNum")
	print(sv_a)
	CUST.DATA.bgNum = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.bgNum)
	
	sv_a = urhk_SRV_GetVal("bgGeneralDtl.bgStatus")
	print(sv_a)
	CUST.DATA.bgStatus  = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.bgStatus )
	
	sv_a = urhk_SRV_GetVal("bgCritDtl.bgSolId.solId")
	print(sv_a)
	CUST.DATA.bgSol = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.bgSol)
	
	sv_a = urhk_SRV_GetVal("bgCritDtl.bgType.type")
	print(sv_a)
	CUST.DATA.bgTyp = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.bgTyp)
	
	sv_s = "rateCode|"
	sv_s = sv_s + " SELECT RATE_CODE "
	sv_s = sv_s + " FROM TBAADM.BGM"
	sv_s = sv_s + " WHERE SOL_ID = ?SVAR "
	sv_s = sv_s + " AND BG_SRL_NUM = ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.bgSol + "|" + CUST.DATA.bgNum + "|" + BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	
	
	CUST.DATA.rate = BANCS.OUTPARAM.rateCode
	print(CUST.DATA.rate)
	
	IF(CUST.DATA.bgStatus == "R") THEN
	#{
		#----------------------------------------------------------------------------------------------------
		# To fetch the bg
		#----------------------------------------------------------------------------------------------------
		sv_u = urhk_SetUrhkInp("bgCritDtl.bgSrlNum|" + CUST.DATA.bgNum)
		print(sv_u)
		
		sv_u = urhk_SetUrhkInp("bgCritDtl.bgSolId.solId|" + CUST.DATA.bgSol)
		print(sv_u)
		
		sv_u = urhk_SetUrhkInp("bgCritDtl.bgFuncCode|Z")
		print(sv_u)
		
		sv_u = urhk_SetUrhkInp("bgCritDtl.inOutInd|O")
		print(sv_u)
		
		sv_u = urhk_SetUrhkInp("bgCritDtl.bgType.type|" + CUST.DATA.bgTyp)
		print(sv_u)
		
		sv_u = urhk_ExecSrv("SRV_FetchBGDtlsForClose|retain_all_output = Y")
		print(sv_u)
		IF ((sv_u != 0)) THEN
		#{
			sv_m = "Fetch failed for bg: " + CUST.DATA.bgNum + " due to :"
			print(sv_m)
			GOTO SRVERROR
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		
		sv_u = urhk_SetUrhkInp("bgInstDtls.bgInstHeader.rateCode.refCode|"+CUST.DATA.rate)
		print(sv_u)
		
		sv_u = urhk_ExecSrv("SRV_CloseOutwardBGDtls|retain_all_output = Y|same_user_verify = Y")
		print(sv_u)
		
		IF ((sv_u != 0)) THEN
		#{
			sv_m = "Close failed for bg: " + CUST.DATA.bgNum + " due to :"
			print(sv_m)
			GOTO SRVERROR
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		
		#--------------------------------------------------------------------------------------------------------------
		# Verifying the close
		#--------------------------------------------------------------------------------------------------------------
		sv_u = urhk_SetUrhkInp("bgCritDtl.bgSrlNum|" + CUST.DATA.bgNum)
		print(sv_u)
		
		sv_u = urhk_ExecSrv("SRV_FetchBGDtlsForVerify|retain_all_output = Y")
		print(sv_u)
		
		IF ((sv_u != 0)) THEN
		#{
			sv_m = "Fetch for verify failed for bg: " + CUST.DATA.bgNum + " due to :"
			print(sv_m)
			GOTO SRVERROR
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		
		sv_u = urhk_ExecSrv("SRV_VerifyOutwardBGDtls|retain_all_output = Y|same_user_verify = Y")
		print(sv_u)
		
		IF ((sv_u != 0)) THEN
		#{
			sv_m = "Verification failed for bg: " + CUST.DATA.bgNum + " due to :"
			print(sv_m)
		#}
		ENDIF
		
