					CUST.DATA.ErrMsg = sv_m + CUST.DATA.ErrMsg
					sv_m = ""
					print(CUST.DATA.ErrMsg)
					CUST.DATA.ErrCode = ("BANCS").("OUTPARAM").("ErrorCode_"+ sv_p)
					print(CUST.DATA.ErrCode)
					CUST.DATA.Tag = ("BANCS").("OUTPARAM").("Tag_"+ sv_p)
					print(CUST.DATA.Tag)
					CUST.DATA.successFailure = "F"
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		TRACE OFF
