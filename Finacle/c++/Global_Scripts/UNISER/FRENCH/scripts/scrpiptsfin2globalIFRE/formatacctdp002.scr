			ENDIF
			
			
			#Tm Charges Part moved here---charge_off.scr
			
			IF ((CUST.FOAT.subType == "NR") OR (CUST.FOAT.subType == "CI") OR (CUST.FOAT.subType == "BI")) THEN
			#{
				
				sv_s = "chrge_off_flg|SELECT chrge_off_flg FROM TBAADM.GAC "
				sv_s = sv_s + "WHERE acid = (SELECT acid "
				sv_s = sv_s + "FROM TBAADM.GAM "
				sv_s = sv_s + "WHERE foracid = ?SVAR "
				sv_s = sv_s + "AND bank_id = ?SVAR "
				sv_s = sv_s + "AND del_flg = 'N' "
				sv_s = sv_s + ")"
				sv_s = sv_s + "AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.FOAT.account + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				PRINT(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				
				PRINT(sv_d)
				IF (sv_d != 0) THEN
				#{
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				sv_y = BANCS.OUTPARAM.chrge_off_flg
				PRINT(sv_y)
				
				IF (sv_y == "Y") THEN
				#{
					CUST.FOAT.errMsg = "Charged OFF Account use menu option RACO"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
		#}
		ENDIF
		
		ENDOFSCRIPT:
			IF(CUST.FOAT.errMsg != "" )THEN
			#{
				sv_b = "Error|" + CUST.FOAT.errMsg
				sv_z = urhk_SetOrbOut(sv_b)
			#}
			ENDIF
			
			TRACE OFF
	END-->
	
