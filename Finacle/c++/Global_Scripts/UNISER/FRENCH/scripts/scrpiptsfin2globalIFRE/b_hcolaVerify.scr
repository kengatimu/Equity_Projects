#		sv_d = sv_d + " where foracid=?SVAR and bank_id=?SVAR and module_id='COFF'"
		sv_d = "update CUSTOM.INT_CHANGE set ENTITY_CRE_FLG ='C', FREE_TEXT1='Loan Charge-off done', "
		sv_d = sv_d + " INT_CHANGE.acct_opn_date= SYSDATE "
		sv_d = sv_d + " where foracid=?SVAR and bank_id=?SVAR and CUST_PREF='COFF'"
		print(sv_d)
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlWithBind(sv_d)
		if(sv_u==0)then
			sv_u = urhk_dbSqlWithBind("commit")
		else
			sv_u = urhk_dbSqlWithBind("rollback")
		endif
	endif
	if((EQSRV.GLBDATA.srvSucFail=="F") and (EQSRV.GLBDATA.srvErrCode!="000"))then
