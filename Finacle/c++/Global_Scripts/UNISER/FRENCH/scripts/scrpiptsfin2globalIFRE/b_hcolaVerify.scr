				EQSRV.GLBDATA.gacCookie              = BANCS.OUTPARAM.gacCookie 
				EQSRV.GLBDATA.eitCookie              = BANCS.OUTPARAM.eitCookie 
				EQSRV.GLBDATA.collateralValue             = BANCS.OUTPARAM.collateralValue
				EQSRV.GLBDATA.provisionAmt             = BANCS.OUTPARAM.provisionAmt
				EQSRV.GLBDATA.multChrgOffFlg             = BANCS.OUTPARAM.multChrgOffFlg
				EQSRV.GLBDATA.alrdyChrgdOffAmt             = BANCS.OUTPARAM.alrdyChrgdOffAmt
				EQSRV.GLBDATA.totalChrgOffAmt             = BANCS.OUTPARAM.totalChrgOffAmt
				EQSRV.GLBDATA.chargeOfftype             = BANCS.OUTPARAM.chargeOfftype
				EQSRV.GLBDATA.usrChrgOffAmt             = BANCS.OUTPARAM.usrChrgOffAmt
				EQSRV.GLBDATA.provisionEntryAmt             = BANCS.OUTPARAM.provisionEntryAmt
				EQSRV.GLBDATA.penalIntOutSt             = BANCS.OUTPARAM.penalIntOutSt
				EQSRV.GLBDATA.penalBookedInt             = BANCS.OUTPARAM.penalBookedInt
				EQSRV.GLBDATA.isReversalAllowed             = BANCS.OUTPARAM.isReversalAllowed
			else
			        print(EQSRV.GLBDATA.foracid)
                                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.foracid
				callscriptifexist("ebsrvHandler.scr") 
				EQSRV.GLBDATA.srvErrMsg	=  EQSRV.GLBDATA.SrvError 
				EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctDtlForChrgOff " 
				EQSRV.GLBDATA.srvSucFail = "F"
				goto NXTLP
			endif
			print(EQSRV.GLBDATA.prinOutSt)
			print(EQSRV.GLBDATA.intOutSt)
			print(EQSRV.GLBDATA.totalChrgOffAmt)
			sv_l = strlen(EQSRV.GLBDATA.totalChrgOffAmt)
			sv_f = mid$(EQSRV.GLBDATA.totalChrgOffAmt,0,sv_l)
			sv_l = strlen(EQSRV.GLBDATA.totalChrgOffAmt)
			sv_p = getposition(sv_f,"|")
			EQSRV.GLBDATA.tlChrgOffAmt= mid$(sv_f,0,(sv_p-1))
			EQSRV.GLBDATA.tlChrgCrncy = mid$(sv_f,sv_p,sv_l)
			print(EQSRV.GLBDATA.tlChrgOffAmt)
			print(EQSRV.GLBDATA.tlChrgCrncy)
			print(EQSRV.GLBDATA.totalChrgOffAmt)
			###if((cdouble(EQSRV.GLBDATA.prinOutSt)<=0) and (cdouble(EQSRV.GLBDATA.intOutSt)<=0)) then
			if(EQSRV.GLBDATA.tlChrgOffAmt<=0)then
			        print(EQSRV.GLBDATA.foracid)
                                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.foracid
				##callscriptifexist("ebsrvHandler.scr") 
				EQSRV.GLBDATA.srvErrMsg	=  "No Outstandings !! do Charge off Manually" 
				EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctDtlForChrgOff " 
				EQSRV.GLBDATA.srvSucFail = "F"
				goto NXTLP
			endif
                #FiledMapInp
                #++++++++++
                        sv_u = urhk_SetUrhkInp("chrgOffCrit.laAcct.foracid|" + EQSRV.GLBDATA.foracid)
                        sv_u = urhk_SetUrhkInp("chrgOffCrit.laAcct.solId|" + EQSRV.GLBDATA.solId)
			sv_u = urhk_SetUrhkInp("chrgOffCrit.laAcct.acid|" + EQSRV.GLBDATA.laacid )
                        sv_u = urhk_SetUrhkInp("chrgOffCrit.reason.refCode|" + EQSRV.GLBDATA.COReasonCode )
                        sv_u = urhk_SetUrhkInp("chrgOffCrit.reason.refRecType|" + EQSRV.GLBDATA.CORefType )
                        sv_u = urhk_SetUrhkInp("chrgOffCrit.chargeOffType|" + EQSRV.GLBDATA.chargeOffType)
                        sv_u = urhk_SetUrhkInp("chrgOffCrit.modeOfOper|" + EQSRV.GLBDATA.modeOfOper)

                #FieldMapOut
                #++++++++++
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.loanAmt|" + EQSRV.GLBDATA.loanAmt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.disbAmt|" + EQSRV.GLBDATA.disbAmt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.loanPerdDays|" + EQSRV.GLBDATA.loanPerdDays )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.loanPerdMnths|" + EQSRV.GLBDATA.loanPerdMnths )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.daysPastDue|" + EQSRV.GLBDATA.daysPastDue )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.prinOutSt|" + EQSRV.GLBDATA.prinOutSt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.intOutSt|" + EQSRV.GLBDATA.intOutSt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.chrgOutSt|" + EQSRV.GLBDATA.chrgOutSt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.feeOutSt|" + EQSRV.GLBDATA.feeOutSt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.assetClassfnMain|" + EQSRV.GLBDATA.assetClassfnMain )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.assetClassfnSub|" + EQSRV.GLBDATA.assetClassfnSub )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.bookedInt|" + EQSRV.GLBDATA.bookedInt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.cotCookie|" + EQSRV.GLBDATA.cotCookie )
