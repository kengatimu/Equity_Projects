	if((cdouble(EQSRV.GLBDATA.cotPenalIntSuspAmt)>0) and (cdouble(EQSRV.GLBDATA.bookedInt)>0))then
			sv_u = urhk_SetUrhkOut("laChrgOffTranLL.<rec_5>.key.serial_num|srlNumJ")
