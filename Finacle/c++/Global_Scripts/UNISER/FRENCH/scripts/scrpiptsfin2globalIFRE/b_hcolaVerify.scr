                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.isReversalAllowed|" + EQSRV.GLBDATA.isReversalAllowed )
	
			sv_u = urhk_SetUrhkOut("laChrgOffTranLL.<rec_0>.key.serial_num|srlNumO")
			sv_u = urhk_SetUrhkOut("laChrgOffTranLL.<rec_0>.tranAcct.foracid|foracidO")
