					else
						sv_u = urhk_dbSqlWithBind("rollback")
					endif
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>hcola.log")
				print(sv_u)
			#}
			DO
		#}
		ENDIF
		print("faill")
