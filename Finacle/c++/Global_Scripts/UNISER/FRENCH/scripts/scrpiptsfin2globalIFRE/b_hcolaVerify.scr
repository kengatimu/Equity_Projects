<--start
trace on
#Reps/Class
#++++++++++
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("ONS")==0)then
		createrep("ONS")
	endif
	if(classexists("ONS","CUSTOM")==0)then
		createclass("ONS","CUSTOM",5)
	endif
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                BANCS.INPUT.AcctNum = MTT.InputDetails.Argument1 
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU 
        endif
	callscriptifexist("ebColaDataIn.scr")
#Inp
#+++
	BANCS.INPUT.solId = BANCS.STDIN.mySolId
	EQSRV.GLBDATA.modeOfOper = "C"
	EQSRV.GLBDATA.srvErrCode = ""
	EQSRV.GLBDATA.srvErrMsg = "" 
	EQSRV.GLBDATA.srvSucFail = ""
	EQSRV.GLBDATA.COReasonCode = "WQ"
	EQSRV.GLBDATA.CORefType = "CY"
	EQSRV.GLBDATA.chargeOffType = "F"
#Data 
#++++
	sv_d = "solId,chargeOffAcct,cifId,laacid,cotPenalIntSuspAmt | "
	sv_d = sv_d + "  select gam.sol_id,gam.foracid,gam.cif_id,gam.acid,cot.penal_int_suspense_amt "
	sv_d = sv_d + " from tbaadm.gam,tbaadm.cot  "
	sv_d = sv_d + " where gam.bank_id=?SVAR "
	sv_d = sv_d + " and gam.acid = cot.acid "
	sv_d = sv_d + " and gam.foracid =?SVAR "
	sv_d = sv_d + " and cot.entity_cre_flg='Y' "
	sv_d = sv_d + " and cot.del_flg='N' "
	sv_d = sv_d + " and cot.chrge_off_date is null "
	sv_d = sv_d + " and cot.bank_id=?SVAR "
	###sv_d = sv_d + " and gam.sol_id in (select sol_id from tbaadm.sst where set_id=?SVAR and bank_id=?SVAR ) " 
	sv_d = sv_d + " and gam.entity_cre_flg='Y' and gam.del_flg='N'  and gam.clr_bal_amt <=1 "
	sv_d = sv_d + " and gam.schm_type = 'LAA' " 
	sv_d = sv_d + " and gam.acct_cls_flg <> 'Y' "
	sv_d = sv_d + " and gam.acct_cls_date is null "	
	##sv_d = sv_d + " and exists (select 1 from tbaadm.cot where cot.acid=gam.acid and cot.entity_cre_flg='Y' and cot.del_flg='N' "
	##sv_d = sv_d + " and cot.chrge_off_date is null and bank_id=?SVAR) "
	###sv_d = sv_d + " and gam.foracid not in ('0240575839625') "
	###sv_d = sv_d + " and rownum<5"
	###BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|"  + BANCS.STDIN.mySolId 
	###BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.AcctNum + "|" +  BANCS.STDIN.contextBankId + "|" +  BANCS.INPUT.solId + "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.AcctNum + "|" +  BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.colaCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE	
		EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG 
		EQSRV.GLBDATA.srvSucFail = "F"
		goto VAYU
	endif	
	EQSRV.GLBDATA.colarec = 0
	print(EQSRV.GLBDATA.colaCurNum)
	sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.colaCurNum)
	if(sv_z!=0)then
		EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE	
		EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG 
		EQSRV.GLBDATA.srvSucFail = "F"
		goto VAYU
	endif
	print(sv_z)
	while(sv_z ==0)
	##{ vploop starts
	#+++++++++++++++++
		print("cola loop in")
		EQSRV.GLBDATA.solId = BANCS.OUTPARAM.solId
		EQSRV.GLBDATA.foracid = BANCS.OUTPARAM.chargeOffAcct
		EQSRV.GLBDATA.cifId = BANCS.OUTPARAM.cifId
		EQSRV.GLBDATA.laacid = BANCS.OUTPARAM.laacid
		EQSRV.GLBDATA.cotPenalIntSuspAmt = BANCS.OUTPARAM.cotPenalIntSuspAmt
		#ContextSol
		#++++++++++
			print(BANCS.STDIN.mySolId)
			print(EQSRV.GLBDATA.solId)
			if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.solId ) then
				sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.solId)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
					print(BANCS.OUTPARAM.successOrFailure)
					sv_s = BANCS.OUTPARAM.successOrFailure
				else
					sv_s = "X"
				endif
				if (( sv_u != 0 ) and ( sv_s != "S"))then
					EQSRV.GLBDATA.srvErrMsg	=	"CCS Failed"
					EQSRV.GLBDATA.srvErrCode = "Failed : SRV_ModifyContextSol " 
					EQSRV.GLBDATA.srvSucFail = "F"
					goto NXTLP
				endif
			endif
		#FiledMapInp
		#++++++++++
		EQSRV.GLBDATA.recmsg    = "Cola for :" + EQSRV.GLBDATA.foracid 
		print(EQSRV.GLBDATA.recmsg)
			sv_u = urhk_SetUrhkInp("chrgOffCrit.laAcct.foracid|" + EQSRV.GLBDATA.foracid )
			sv_u = urhk_SetUrhkInp("chrgOffCrit.laAcct.solId|" + EQSRV.GLBDATA.solId )
			sv_u = urhk_SetUrhkInp("chrgOffCrit.laAcct.acid|" + EQSRV.GLBDATA.laacid )
			sv_u = urhk_SetUrhkInp("chrgOffCrit.reason.refCode|" + EQSRV.GLBDATA.COReasonCode )
			sv_u = urhk_SetUrhkInp("chrgOffCrit.reason.refRecType|" + EQSRV.GLBDATA.CORefType )
			sv_u = urhk_SetUrhkInp("chrgOffCrit.chargeOffType|" + EQSRV.GLBDATA.chargeOffType)
			sv_u = urhk_SetUrhkInp("chrgOffCrit.modeOfOper|" + EQSRV.GLBDATA.modeOfOper)

		#FieldMapOut
		#++++++++++
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.loanAmt| loanAmt ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.disbAmt| disbAmt ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.loanPerdDays| loanPerdDays ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.loanPerdMnths| loanPerdMnths ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.daysPastDue| daysPastDue ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.prinOutSt| prinOutSt ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.intOutSt| intOutSt ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.chrgOutSt| chrgOutSt ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.feeOutSt| feeOutSt ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.assetClassfnMain| assetClassfnMain ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.assetClassfnSub| assetClassfnSub ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.bookedInt| bookedInt ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.cotCookie| cotCookie ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.gacCookie| gacCookie ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.eitCookie| eitCookie ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.collateralValue| collateralValue ")
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.provisionAmt| provisionAmt ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.multChrgOffFlg| multChrgOffFlg ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.alrdyChrgdOffAmt| alrdyChrgdOffAmt ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.totalChrgOffAmt| totalChrgOffAmt ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.chargeOfftype| chargeOfftype ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.usrChrgOffAmt| usrChrgOffAmt ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.provisionEntryAmt| provisionEntryAmt ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.penalIntOutSt| penalIntOutSt ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.penalBookedInt| penalBookedInt ") 
			sv_u = urhk_SetUrhkOut("chrgOffAcctDtl.isReversalAllowed| isReversalAllowed ") 
		#fetchSrv
		#++++++++++
			sv_u = urhk_ExecSrv("SRV_FetchAcctDtlForChrgOff|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
			print(sv_u)
			if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
				print(BANCS.OUTPARAM.successOrFailure)
				sv_s = BANCS.OUTPARAM.successOrFailure
			else
				sv_s = "X"
			endif
			if (( sv_u == 0 ) and ( sv_s=="S") ) then
				EQSRV.GLBDATA.loanAmt             = BANCS.OUTPARAM.loanAmt
				EQSRV.GLBDATA.disbAmt             = BANCS.OUTPARAM.disbAmt
				EQSRV.GLBDATA.loanPerdDays             = BANCS.OUTPARAM.loanPerdDays
				EQSRV.GLBDATA.loanPerdMnths             = BANCS.OUTPARAM.loanPerdMnths
				EQSRV.GLBDATA.daysPastDue             = BANCS.OUTPARAM.daysPastDue
				EQSRV.GLBDATA.prinOutSt             = BANCS.OUTPARAM.prinOutSt
