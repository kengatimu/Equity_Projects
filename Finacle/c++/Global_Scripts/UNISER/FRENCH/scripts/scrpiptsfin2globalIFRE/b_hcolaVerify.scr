					sv_d = sv_d + " where foracid=?SVAR and bank_id=?SVAR and CUST_PREF='COFF'"
					print(sv_d)
					BANCS.INPARAM.BINDVARS = sv_e  + "|" + EQSRV.GLBDATA.foracid  + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_u = urhk_dbSqlWithBind(sv_d)
