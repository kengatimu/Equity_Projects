                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.totalChrgOffAmt|" + EQSRV.GLBDATA.totalChrgOffAmt )
                        sv_u = urhk_SetUrhkInp("chrgOffAcctDtl.chargeOfftype|" + EQSRV.GLBDATA.chargeOfftype )
