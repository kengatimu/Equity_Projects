#-------------------------------------------------------------------------------------------------------
# Source Name           :   dcchrgmn001.scr
# Date                  :   23-01-2013
# Author                :   Manoj
# Title                 :   DCCharges
# Description           :	It is event based script for event type - DCADV, event id - DCCHGEXP, DCCHGEXPLO
#							and bacid EXPLCCONFM.It gets thedc open date and dc expiry date  for that DC.It
#							gets getMonthDayDiff between bill date and due date and converts it into quarter.
#							If the bill currency is KES based on the quarter count it calculates  charge amount
#							and if the bill currency is not KES it considers the notional rate also for charge calculation.
# Sources called        :   NA
# Sources called from   :	NA
# Modification History  :
# <Serial No.>      <Date>          <Author Name>       <Description>
# 1.0            23-01-2013     	Manoj        Original version
# 2.0			 20-20-2013			Manoj		 Repository removed and exit script added
#-------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="51cde0b38c02ccaa8c22d139d5764b23f157defe03b7a1290f03f054ac21a4de"
	#TRACE ON
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	#--------------------------------------------------------------------------
	# Initialise the CHRG repository
	#--------------------------------------------------------------------------
	sv_r = REPEXISTS("CHRG")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CHRG")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CHRG","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CHRG","DATA",5)
	#}
	ENDIF
	
	IF (BANCS.INPUT.confReqdFlg != "Y") THEN
	#{
		CHRG.DATA.calcAmt = "0"
		GOTO FINISH
	#}
	ENDIF
	
	CHRG.DATA.dcOpnDate		= ""
	CHRG.DATA.dcExpDate		= ""
	CHRG.DATA.numQrt 		= CDOUBLE("1")
	CHRG.DATA.dcTolPcnt		= CDOUBLE("0")
	CHRG.DATA.inputAmt		= CDOUBLE("0")
	CHRG.DATA.totAmt		= CDOUBLE("0")
	CHRG.DATA.calcAmt 		= CDOUBLE("0")
	CHRG.DATA.Rate 			= CDOUBLE("0")
	CHRG.DATA.convAmt       = CDOUBLE("0")
	
	#--------------------------------------------------------------------------
	# Charge Calculation
	#--------------------------------------------------------------------------
	print(BANCS.INPUT.dcOpnDate)
	print(BANCS.INPUT.dcExpDate)
	CHRG.DATA.dcOpnDate = LEFT$(BANCS.INPUT.dcOpnDate,10)
	CHRG.DATA.dcExpDate = LEFT$(BANCS.INPUT.dcExpDate,10)
	print(CHRG.DATA.dcOpnDate)
	print(CHRG.DATA.dcExpDate)
	
	#sv_s = (CHRG.DATA.dcOpnDate + "|" + CHRG.DATA.dcExpDate + "|" + "NO")
	#sv_u = urhk_B2k_getMonthDayDiff(sv_s)
	
	BANCS.INPARAM.date1 = CHRG.DATA.dcOpnDate
	BANCS.INPARAM.date2 = CHRG.DATA.dcExpDate
	
	sv_e=urhk_B2k_dateDiff("")
	
	IF (sv_e != 0) THEN
	#{
		print(BANCS.OUTPARAM.errorMesg)
		GOTO FINISH
		#}
	ELSE
		#{
		sv_d = CINT(BANCS.OUTPARAM.dateDiff)
		
		IF (sv_d < 0) THEN
		#{
			sv_d = sv_d * CINT("-1")
		#}
		ENDIF
		
		CHRG.DATA.numOfMonths = (sv_d)/CINT("30")
		CHRG.DATA.numOfDays = (sv_d) - CINT(CHRG.DATA.numOfMonths)*CINT("30")
		
		#	CHRG.DATA.numOfMonths 	= BANCS.OUTPARAM.numOfMonths
		#	CHRG.DATA.numOfDays 	= BANCS.OUTPARAM.numOfDays
		#---------------------------------------------------------------------------
		# Total Number of Days
		#---------------------------------------------------------------------------
		CHRG.DATA.numQrt = (CINT(CHRG.DATA.numOfMonths) * CINT("30")) + CINT(CHRG.DATA.numOfDays)
		print(CHRG.DATA.numQrt)
		
		#---------------------------------------------------------------------------
		# Total Number of Quarter
		#---------------------------------------------------------------------------
		CHRG.DATA.numQrt = CDOUBLE(CHRG.DATA.numQrt) / CDOUBLE("90")
		print(CHRG.DATA.numQrt)
		sv_c = "."
		sv_p = GETPOSITION(CHRG.DATA.numQrt,sv_c)
		print(sv_p)
		sv_o = MID$(CHRG.DATA.numQrt,sv_p,2)
		IF (sv_o != "00") THEN
		#{
			CHRG.DATA.numQrt = CINT(CHRG.DATA.numQrt) + CINT("1")
			print(CHRG.DATA.numQrt)
			CHRG.DATA.numQrt = CDOUBLE(CHRG.DATA.numQrt) / CDOUBLE("2")
			print(CHRG.DATA.numQrt)
		#}
		ENDIF
	#}
	ENDIF
	
	CHRG.DATA.dcTolPcnt = BANCS.INPUT.dcTolPcnt
	IF (TRIM(BANCS.INPUT.inputCrncy) == BANCS.STDIN.homeCrncyCode) THEN
	#{
		print(BANCS.INPUT.inputAmount)
		CHRG.DATA.inputAmt = BANCS.INPUT.inputAmount
		
		IF (CDOUBLE(CHRG.DATA.dcTolPcnt) == CDOUBLE("0")) THEN
		#{
			CHRG.DATA.inputAmt = BANCS.INPUT.inputAmount
			print(CHRG.DATA.inputAmt)
			#}
		ELSE
			#{
			CHRG.DATA.inputAmt = BANCS.INPUT.inputAmount
			CHRG.DATA.totAmt = (CDOUBLE(CHRG.DATA.inputAmt) * CDOUBLE(CHRG.DATA.dcTolPcnt)) / CDOUBLE("100")
			print(CHRG.DATA.totAmt)
			CHRG.DATA.inputAmt = CDOUBLE(CHRG.DATA.inputAmt) + CDOUBLE(CHRG.DATA.totAmt)
			print(CHRG.DATA.inputAmt)
		#}
		ENDIF
		
		CHRG.DATA.calcAmt = (CDOUBLE(CHRG.DATA.inputAmt) * CDOUBLE(CHRG.DATA.numQrt)) / CDOUBLE("100")
		print(CHRG.DATA.calcAmt)
		print(BANCS.INPUT.minimumChargeAmount)
		IF (CDOUBLE(CHRG.DATA.calcAmt) < CDOUBLE(BANCS.INPUT.minimumChargeAmount)) THEN
		#{
			CHRG.DATA.calcAmt = BANCS.INPUT.minimumChargeAmount
			BANCS.OUTPUT.collAmount = CHRG.DATA.calcAmt
			BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
			GOTO FINISH
		#}
		ENDIF
		
		BANCS.OUTPUT.collAmount = CHRG.DATA.calcAmt
		BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
		GOTO FINISH
		#}
	ELSE
		#{
		print(BANCS.INPUT.inputAmount)
		print(BANCS.INPUT.inputCrncy)
		print(BANCS.INPUT.rateCode)
		CHRG.DATA.Rate = BANCS.INPUT.dcRate
		CHRG.DATA.inputAmt = BANCS.INPUT.inputAmount
		
		IF (CDOUBLE(CHRG.DATA.dcTolPcnt) == CDOUBLE("0")) THEN
		#{
			CHRG.DATA.inputAmt = BANCS.INPUT.inputAmount
			print(CHRG.DATA.inputAmt)
			#}
		ELSE
			#{
			CHRG.DATA.inputAmt = BANCS.INPUT.inputAmount
			CHRG.DATA.totAmt = (CDOUBLE(CHRG.DATA.inputAmt) * CDOUBLE(CHRG.DATA.dcTolPcnt)) / CDOUBLE("100")
			print(CHRG.DATA.totAmt)
			CHRG.DATA.inputAmt = CDOUBLE(CHRG.DATA.inputAmt) + CDOUBLE(CHRG.DATA.totAmt)
			print(CHRG.DATA.inputAmt)
		#}
		ENDIF
		
		CHRG.DATA.convAmt =  CDOUBLE(CHRG.DATA.Rate) * CDOUBLE(CHRG.DATA.inputAmt)
		print(CHRG.DATA.convAmt)
		CHRG.DATA.calcAmt = (CDOUBLE(CHRG.DATA.convAmt) * CDOUBLE(CHRG.DATA.numQrt)) / CDOUBLE("100")
		print(CHRG.DATA.calcAmt)
		print(BANCS.INPUT.minimumChargeAmount)
		
		IF (CDOUBLE(CHRG.DATA.calcAmt) < CDOUBLE(BANCS.INPUT.minimumChargeAmount)) THEN
		#{
			CHRG.DATA.calcAmt = BANCS.INPUT.minimumChargeAmount
			BANCS.OUTPUT.collAmount = CHRG.DATA.calcAmt
			BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
			GOTO FINISH
		#}
		ENDIF
		
		BANCS.OUTPUT.collAmount = CHRG.DATA.calcAmt
		BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
	#}
	ENDIF
	
	FINISH:
		print(CHRG.DATA.calcAmt)
		BANCS.OUTPUT.collAmount = CHRG.DATA.calcAmt
		BANCS.OUTPUT.AmountWithNoDiscount = CHRG.DATA.calcAmt
		BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
		
		#TRACE OFF
		EXITSCRIPT
END-->
