<--START
CHECKSUM="0a13f95f54a86bb60f4187736d0a14ce15ac20dd33f521a37e6a3ca19c99dd79"
	TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
	#{
		CREATECLASS("CUST", "CHQB", 5)
	#}
	ENDIF
	
	CUST.CHQB.function 	= BANCS.INPUT.funcCode
	CUST.CHQB.acctNum 	= BANCS.INPUT.acctId
	CUST.CHQB.instType	= BANCS.INPUT.instType
	CUST.CHQB.instNum	= BANCS.INPUT.instNum
	
	#-----------------------------------------------------------
	# Checking for Input Validation
	#-----------------------------------------------------------
	
	IF(CUST.CHQB.function == "" ) THEN
	#{
		sv_e = "Enter valida function code"
		sv_m = "funcCode"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CHQB.acctNum == "") THEN
	#{
		sv_e = "Enter the Account Number"
		sv_m = "acctId"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "countGam"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT COUNT(*) "
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE foracid = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	CUST.CHQB.countGam = BANCS.OUTPARAM.countGam
	print(CUST.CHQB.countGam)
	
	IF(CUST.CHQB.countGam == 0) THEN
	#{
		sv_e = "Invalid Account Number"
		sv_m = "acctId"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CHQB.instType == "" ) THEN
	#{
		sv_e = "Instrument Type should be entered"
		sv_m = "instType"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.CHQB.instType == "CHQ") THEN
	#{
		sv_e = "CHQ Type Instrumnet Not allowded"
		sv_m = "instType"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CHQB.instType != "" ) THEN
	#{
		sv_s = " countinst "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT COUNT(*) "
		sv_s = sv_s + " FROM CUSTOM.C_CBT_INT "
		sv_s = sv_s + " WHERE del_flg != 'Y' "
		sv_s = sv_s + " AND inst_type = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.instType + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		CUST.CHQB.countinst = BANCS.OUTPARAM.countinst
		print(CUST.CHQB.countinst)
		
		IF( CINT(CUST.CHQB.countinst ) == 0 ) THEN
		#{
			sv_e = "Invalid Instrument Type"
			sv_m = "instType"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.CHQB.instNum == "" ) THEN
	#{
		sv_e = "Begin Chq Number should be entered"
		sv_m = "instNum"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.CHQB.acctNum)
	print(sv_u)
	
	IF(sv_u == 0 ) THEN
	#{
		CUST.CHQB.solId = BANCS.OUTPARAM.acctSolId
		print(CUST.CHQB.solId)
		IF (CUST.CHQB.function != "I") THEN
		#{
			IF(CUST.CHQB.solId != BANCS.STDIN.mySolId) THEN
			#{
				sv_e = "Account belongs to different SOL"
				sv_m = "acctId"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		#}
		ENDIF
		
		IF (CUST.CHQB.function == "M") THEN
		#{
			#----------------------------------------------
			# Checking for pending verification
			#----------------------------------------------
			sv_s = "count| select count(1) "
			sv_s = sv_s + " FROM CUSTOM.C_CBT_MOD1 WHERE "
			sv_s = sv_s + " INST_TYPE= ?SVAR "
			sv_s = sv_s + " AND FORACID= ?SVAR "
			sv_s = sv_s + " AND DEL_FLG != 'Y' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CHQB.instType + "|" + CUST.CHQB.acctNum +"|" +BANCS.STDIN.contextBankId
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			CUST.CHQB.count = BANCS.OUTPARAM.count
			print(CUST.CHQB.count)
			IF (cint(CUST.CHQB.count) != 0) THEN
			#{
				sv_e = "Verification Pending"
				sv_m = "acctId"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF (CUST.CHQB.function == "M") THEN
		#{
			sv_s = " acid,chqIssuDate,beginChqNum,chqNumOfLvs,chqLvsStat,numPaid,numUnused,numStoped,numDestroyed"
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT acid,chq_issu_date,begin_chq_num,chq_num_of_lvs,chq_lvs_stat,num_paid,"
			sv_s = sv_s + " num_unused,num_stoped,num_destroyed "
			sv_s = sv_s + " FROM CUSTOM.C_CBT "
			sv_s = sv_s + " WHERE inst_type = ?SVAR "
			sv_s = sv_s + " AND foracid = ?SVAR "
			sv_s = sv_s + " AND TO_NUMBER(begin_chq_num) <= TO_NUMBER(?SVAR) "
			sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num)+chq_num_of_lvs-1) >= TO_NUMBER(?SVAR)"
			sv_s = sv_s + " AND (TO_NUMBER(?SVAR) BETWEEN TO_NUMBER(begin_chq_num) "
			sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num) + chq_num_of_lvs - 1)) "
			sv_s = sv_s + " AND del_flg!='Y' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CHQB.instType + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.instNum + "|" + CUST.CHQB.instNum + "|" + CUST.CHQB.instNum + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0 ) THEN
			#{
				sv_e = "No Record found"
				sv_m = "Err"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CHQB.acid = BANCS.OUTPARAM.acid
			CUST.CHQB.chqIssuDate = BANCS.OUTPARAM.chqIssuDate
			CUST.CHQB.beginChqNum = BANCS.OUTPARAM.beginChqNum
			CUST.CHQB.chqNumOfLvs = BANCS.OUTPARAM.chqNumOfLvs
			CUST.CHQB.chqLvsStat = BANCS.OUTPARAM.chqLvsStat
			CUST.CHQB.numPaid = BANCS.OUTPARAM.numPaid
			CUST.CHQB.numUnused = BANCS.OUTPARAM.numUnused
			CUST.CHQB.numStoped = BANCS.OUTPARAM.numStoped
			CUST.CHQB.numDestroyed = BANCS.OUTPARAM.numDestroyed
			
			#---------------------------------
			# Finding The status of the field
			#---------------------------------
			IF (CUST.CHQB.instNum  != CUST.CHQB.beginChqNum) THEN
			#{
				CUST.CHQB.temp = CINT(CUST.CHQB.instNum) - CINT(CUST.CHQB.beginChqNum)
				print(CUST.CHQB.temp)
				#}
			ELSE
				#{
				CUST.CHQB.temp = 0
				print(CUST.CHQB.temp)
			#}
			ENDIF
			
			print(CUST.CHQB.temp)
			CUST.CHQB.temp = cint(CUST.CHQB.temp) + cint("1")
			print(CUST.CHQB.temp)
			
			sv_n = "SUBSTR(chq_lvs_stat," + CUST.CHQB.temp + "," + CUST.CHQB.chqNumOfLvs + ")"
			print(sv_n)
			
			sv_s = "currentStatus "
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT " + sv_n
			sv_s = sv_s + " FROM CUSTOM.C_CBT "
			sv_s = sv_s + " WHERE inst_type = ?SVAR "
			sv_s = sv_s + " AND foracid = ?SVAR "
			sv_s = sv_s + " AND TO_NUMBER(begin_chq_num) <= TO_NUMBER(?SVAR) "
			sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num)+chq_num_of_lvs-1) >= TO_NUMBER(?SVAR)"
			sv_s = sv_s + " AND (TO_NUMBER(?SVAR) BETWEEN TO_NUMBER(begin_chq_num) "
			sv_s = sv_s + " AND (TO_NUMBER(begin_chq_num) + chq_num_of_lvs - 1)) "
			sv_s = sv_s + " AND del_flg != 'Y' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CHQB.instType + "|" + CUST.CHQB.acctNum + "|" + CUST.CHQB.instNum + "|" + CUST.CHQB.instNum + "|" + CUST.CHQB.instNum + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0 ) THEN
			#{
				sv_e = "No Record found"
				sv_m = "Err"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CHQB.currentStatus = BANCS.OUTPARAM.currentStatus
			print(CUST.CHQB.currentStatus)
			
			print(CUST.CHQB.beginChqNum)
			sv_z = "beginNum" + "|" + CUST.CHQB.beginChqNum + "|"
			sv_g = urhk_SetOrbOut(sv_z)
			print(sv_g)
			#sv_z = "numLeaves" +"|"+ CUST.CHQB.chqNumOfLvs + "|"
			#sv_g = urhk_SetOrbOut(sv_z)
			#print(sv_g)
			sv_z = "currStatus" +"|"+ CUST.CHQB.currentStatus + "|"
			sv_g = urhk_SetOrbOut(sv_z)
			print(sv_g)
			
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		#}
		ENDIF
		
		IF (CUST.CHQB.function == "I") THEN
		#{
			#----------------------------------------------------------
			# I  OF INHOUSE CHQ BOOKS
			#----------------------------------------------------------
			
			sv_s = " beginChqNum,oldStatus,newStatus,rcreUserId|"
			sv_s = sv_s + " SELECT BEGIN_CHQ_NUM,OLD_STATUS,NEW_STATUS,RCRE_USER_ID "
			sv_s = sv_s + " FROM CUSTOM.C_CBT_MOD1 "
			sv_s = sv_s + " WHERE inst_type = ?SVAR "
			sv_s = sv_s + " AND foracid = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND del_flg != 'Y' "
			BANCS.INPARAM.BINDVARS = CUST.CHQB.instType + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF (sv_d != 0) THEN
			#{
				sv_e = "No Record Found"
				sv_m = "Err"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CHQB.beginChqNum   = BANCS.OUTPARAM.beginChqNum
			print(CUST.CHQB.beginChqNum)
			CUST.CHQB.oldStatus     = BANCS.OUTPARAM.oldStatus
			print(CUST.CHQB.oldStatus)
			CUST.CHQB.newStatus     = BANCS.OUTPARAM.newStatus
			print(CUST.CHQB.newStatus)
			CUST.CHQB.rcreUserId    = BANCS.OUTPARAM.rcreUserId
			print(CUST.CHQB.rcreUserId)
			
			sv_z = "beginNum" + "|" + CUST.CHQB.beginChqNum + "|"
			sv_g = urhk_SetOrbOut(sv_z)
			print(sv_g)
			#sv_z = "numLeaves" +"|"+ CUST.CHQB.chqNumOfLvs + "|"
			#sv_g = urhk_SetOrbOut(sv_z)
			#print(sv_g)
			sv_z = "currStatus" +"|"+ CUST.CHQB.oldStatus + "|"
			sv_g = urhk_SetOrbOut(sv_z)
			print(sv_g)
			sv_z = "newStatus" +"|"+ CUST.CHQB.newStatus
			sv_g = urhk_SetOrbOut(sv_z)
			print(sv_g)
			
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		#}
		ENDIF
		
		ENDOFSCRIPT:
			TRACE OFF
			EXITSCRIPT
	END-->
	
	
