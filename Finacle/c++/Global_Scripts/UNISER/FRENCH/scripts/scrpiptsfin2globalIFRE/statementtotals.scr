<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Bank id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Bankid=BANCS.INPUT.Bankid
	print(CUST.DATA.Bankid)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("Acctnum"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Account Number"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	sv_e=urhk_SetOrbOut("StattusCode|Error")
	GOTO End
ELSE
	CUST.DATA.Acctnum=BANCS.INPUT.Acctnum
	print(CUST.DATA.Acctnum)
ENDIF


IF( (FIELDEXISTS(("BANCS").("INPUT").("Fromdate"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply  From Date ...Note date format DD-MON-YYYY"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Fromdate=BANCS.INPUT.Fromdate
	print(CUST.DATA.Fromdate)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("todate"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply todate Date ...Note date format DD-MON-YYYY"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.todate=BANCS.INPUT.todate
	print(CUST.DATA.todate)
ENDIF

############################################
# Fetching the value from table
############################################

sv_q = "ncredit,tcredit| "
sv_q = sv_q + " SELECT count (*) as ncredit , SUM(TRAN_AMT)  as tcredit FROM TBAADM.CTD_DTD_ACLI_VIEW WHERE bank_id= ?SVAR   " 
sv_q = sv_q + " and acid IN (SELECT acid FROM tbaadm.gam   WHERE  bank_id = ?SVAR and del_flg='N'  and foracid = ?SVAR )   and PART_TRAN_TYPE ='C'   " 
sv_q = sv_q + " AND tran_date>=?SVAR AND  tran_date<= ?SVAR   " 
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum + "|" + CUST.DATA.Fromdate + "|" + CUST.DATA.todate 
print(BANCS.INPARAM.BINDVARS)

sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

if (sv_p==0) then


	CUST.DATA.ncredit = BANCS.OUTPARAM.ncredit
	print (CUST.DATA.ncredit)
	CUST.DATA.tcredit = BANCS.OUTPARAM.tcredit
	print (CUST.DATA.tcredit)

        IF (CUST.DATA.ncredit != "") THEN
	sv_z = urhk_SetOrbOut("NUM_CREDIT|"+CUST.DATA.ncredit)
	print(sv_z)
	endif
	 IF (CUST.DATA.tcredit != "") THEN
	sv_z = urhk_SetOrbOut("TOTAL_CREDIT|"+CUST.DATA.tcredit)
	print(sv_z)
       Endif

	#####

sv_q = "ndebit,tdebit| "
sv_q = sv_q + " SELECT count (*) as ndebit, SUM(TRAN_AMT) as tdebit  FROM TBAADM.CTD_DTD_ACLI_VIEW  WHERE bank_id= ?SVAR  " 
sv_q = sv_q + " and acid IN (SELECT acid FROM tbaadm.gam   WHERE  bank_id = ?SVAR and del_flg='N'  and foracid = ?SVAR )  and PART_TRAN_TYPE ='D'   " 
sv_q = sv_q + " AND tran_date>=?SVAR AND  tran_date<= ?SVAR   " 
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum + "|" + CUST.DATA.Fromdate + "|" + CUST.DATA.todate 
print(BANCS.INPARAM.BINDVARS)

	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)

	if (sv_p==0) then


		CUST.DATA.ndebit = BANCS.OUTPARAM.ndebit
		print (CUST.DATA.ndebit)
		CUST.DATA.tdebit = BANCS.OUTPARAM.tdebit
		print (CUST.DATA.tdebit)
                 
		  IF (CUST.DATA.ndebit != "") THEN
		sv_z = urhk_SetOrbOut("NUM_DEBIT|"+CUST.DATA.ndebit)
		print(sv_z)
                 Endif
		 IF (CUST.DATA.tdebit != "") THEN
		sv_z = urhk_SetOrbOut("TOTAL_DEBIT|"+CUST.DATA.tdebit)
		print(sv_z)
                 Endif
		#sv_e=urhk_SetOrbOut("StattusCode|SUCCESS")
	else
		CUST.DATA.errMsg="Data Error ...Note date format DD-MON-YYYY"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	endif
	####

	#####
sv_q = "Trecords| "
sv_q = sv_q + " SELECT count(*) FROM TBAADM.CTD_DTD_ACLI_VIEW WHERE bank_id= ?SVAR   " 
sv_q = sv_q + " and acid IN (SELECT acid FROM tbaadm.gam   WHERE  bank_id = ?SVAR and del_flg='N'  and foracid = ?SVAR )   "  
sv_q = sv_q + " AND tran_date>=?SVAR AND  tran_date<= ?SVAR   "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum + "|" + CUST.DATA.Fromdate + "|" + CUST.DATA.todate 
print(BANCS.INPARAM.BINDVARS)

	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)

	if (sv_p==0) then


		CUST.DATA.Trecords = BANCS.OUTPARAM.Trecords
		print (CUST.DATA.Trecords)
		
                 
		  IF (CUST.DATA.Trecords != "") THEN
		sv_z = urhk_SetOrbOut("TOT_RECS|"+CUST.DATA.Trecords)
		print(sv_z)
                 Endif
		
		sv_e=urhk_SetOrbOut("StattusCode|SUCCESS")
	else
		CUST.DATA.errMsg="Data Error ...Note date format DD-MON-YYYY"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	endif
	####

	sv_e=urhk_SetOrbOut("StattusCode|Success")
else
	CUST.DATA.errMsg="Data Error ...Note date format DD-MON-YYYY"
	sv_e=urhk_SetOrbOut("StattusCode|Error")
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
endif



End:
EXITSCRIPT
trace off
end-->


