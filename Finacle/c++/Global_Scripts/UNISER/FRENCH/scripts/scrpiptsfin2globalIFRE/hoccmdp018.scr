CHECKSUM="789777a036a42873c2fd4648d5f26b3734b3873ebe0908994b02e69f746fb287"
	#==============================================================================================================
	#- Calling request.scr to create the Body of Request xml. This child script should have the logic implemented
	#- to form the request xml as per the wsdl shared
	#==============================================================================================================
	call("hoccmdp019.scr")
	
	#==============================================================================================================
	#- Getting the time-stamp component from Oracle SYSDATE
	#==============================================================================================================
	sv_s = "sysDate|SELECT SYSDATE FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.INTERFACE.sysDate = BANCS.OUTPARAM.sysDate
		#}
	ELSE
		#{
		CUST.INTERFACE.sysDate = BANCS.STDIN.sysDate
	#}
	ENDIF
	BANCS.INPARAM.Day   	= LEFT$(CUST.INTERFACE.sysDate,2)
	BANCS.INPARAM.Month 	= MID$(CUST.INTERFACE.sysDate,3,2)
	BANCS.INPARAM.Year  	= MID$(CUST.INTERFACE.sysDate,8,2)
	BANCS.INPARAM.Hour  	= MID$(CUST.INTERFACE.sysDate,11,2)
	BANCS.INPARAM.Minute    = MID$(CUST.INTERFACE.sysDate,14,2)
	BANCS.INPARAM.Second    = MID$(CUST.INTERFACE.sysDate,17,2)
	BANCS.INPARAM.SYSDATE   = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour
	BANCS.INPARAM.SYSDATE	= BANCS.INPARAM.SYSDATE + BANCS.INPARAM.Minute + BANCS.INPARAM.Second
	print(BANCS.INPARAM.SYSDATE)
	
	#==============================================================================================================
	#- Assigning appropriate values for the input varaibles that are required for urhk_ConnectToFIAndSendMsg
	#- userhook.
	#- The value for CUST.INTERFACE.interfaceRequestID & CUST.INTERFACE.interfaceRequestVersion is assigned in
	#- request.scr
	#- The values for UserApplId, CHANNELID, TIMEZONE, SERVICE_NAME needs to be set in customenv.com and to be
	#- fetched using the userhook urhk_getEnv inorder to avoid hard coding
	#==============================================================================================================
	BANCS.INPARAM.UserApplId                = "FINCORE"
	BANCS.INPARAM.MESSAGEDATETIME       	= MID$(CUST.INTERFACE.sysDate,6,4)+"-" + BANCS.INPARAM.Month + "-" + BANCS.INPARAM.Day + "T"
	BANCS.INPARAM.MESSAGEDATETIME           = BANCS.INPARAM.MESSAGEDATETIME + BANCS.INPARAM.Hour + ":" + BANCS.INPARAM.Minute + ":"
	BANCS.INPARAM.MESSAGEDATETIME		= BANCS.INPARAM.MESSAGEDATETIME + BANCS.INPARAM.Second + ".000"
	BANCS.INPARAM.RequestUUID               = BANCS.INPARAM.UserApplId + BANCS.INPARAM.SYSDATE
	BANCS.INPARAM.CHANNELID                 = "COR"
	BANCS.INPARAM.TIMEZONE                  = "GMT+05:30"
	BANCS.INPARAM.BANKID                    = BANCS.STDIN.contextBankId
	BANCS.INPARAM.ServiceReqId              = CUST.INTERFACE.interfaceRequestID
	BANCS.INPARAM.SERVICEREQUESTVERSION     = CUST.INTERFACE.interfaceRequestVersion
	
	#==============================================================================================================
	#- BANCS.INPARAM.SERVICE_NAME is used as a identifier for fitcpip adapter. So always set this value to FIJCA
	#==============================================================================================================
	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	#==============================================================================================================
	#- SEND_RECV_FLG flag is used to determine the mode of operation. The Possible values can be S or R.
	#- S for async communication and R for sync communication
	#==============================================================================================================
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	
	#==============================================================================================================
	#Appending the header XML and body XML.
	#==============================================================================================================
	CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=NVPSTR,MSG_SUB_TYPE=FINVP###"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "reqhdr.servicerequestversion^=^"+CUST.INTERFACE.interfaceRequestVersion+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.requestuuid^=^"+BANCS.INPARAM.RequestUUID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.servicerequestid^=^"+CUST.INTERFACE.interfaceRequestID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.origchannelid^=^"+BANCS.INPARAM.CHANNELID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.bankid^=^"+BANCS.INPARAM.BANKID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.messagedatetime^=^"+BANCS.INPARAM.MESSAGEDATETIME+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^body^=^"+CUST.INTERFACE.bodyXMLMsg
	sv_a = CUST.INTERFACE.reqXMLMsg
	PRINT(sv_a)
	
	#==============================================================================================================
	#- Executing the userhook to make the Outbound Call
	#==============================================================================================================
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	IF (sv_l != 0) THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		GOTO ENDOFSCRIPT
	#}
	ENDIF
