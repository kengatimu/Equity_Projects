<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
ENDIF

IF (CLASSEXISTS("CUST","MOBIL") == 0) THEN
	#{
		CREATECLASS("CUST","MOBIL",5)
	#}
ENDIF

BANCS.INPUT.moduleName  = "MBCHARGES"
BANCS.INPUT.parameterId = "MBCRACCT"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.MOBIL.CRACCT = BANCS.STDIN.mySolId + BANCS.OUTPUT.parameterVal
    PRINT( CUST.MOBIL.CRACCT)
#}
ELSE
#{
    CUST.MOBIL.Response = "Credit A/c setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "MBDRAMT"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.MOBIL.DRAMT = BANCS.OUTPUT.parameterVal
    PRINT(CUST.MOBIL.DRAMT)
#}
ELSE
#{
    CUST.MOBIL.Response = "Debit amount setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF


sv_b = "MBDate|select to_char(sysdate,'MON-yyyy') from dual "
print (sv_b)
sv_d = urhk_dbselectWithBind(sv_b)
print(sv_d)

IF (sv_d == 0) THEN
#{
CUST.MOBIL.MBDATE =  BANCS.OUTPARAM.MBDate 
print(CUST.MOBIL.MBDATE)

#}
ENDIF


BANCS.INPUT.parameterId = "MBNARRCODE"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.MOBIL.NARRATION = CUST.MOBIL.MBDATE + " " + BANCS.OUTPUT.parameterVal
    PRINT(CUST.MOBIL.NARRATION)
#}
ELSE
#{
    CUST.MOBIL.Response = "Tran Narration setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF


sv_q="acct|"
sv_q = sv_q + " select foracid from tbaadm.gam where  "
sv_q = sv_q + " schm_code in ('SM155','SM156','SM158','SM151','SM152','SM153','SM154') "
sv_q = sv_q + " and acct_cls_flg !='Y' "
sv_q = sv_q + " and FREZ_CODE != any ('T','D','C') "
sv_q = sv_q + " and clr_bal_amt>='110' "
sv_q = sv_q + " and sol_id = ?SVAR "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
			IF(sv_q == 1) THEN
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
				exitscript
			ENDIF
		print(sv_q)

WHILE (sv_q==0)
	CUST.MOBIL.acct=BANCS.OUTPARAM.acct
	print(CUST.MOBIL.acct)


		#--------------------------------------------------------------------------
		# Initialise the MTT repository
		#--------------------------------------------------------------------------
	
				sv_r = REPEXISTS("MTT")
				IF (sv_r == 0) THEN
				#{
					CREATEREP("MTT")
				#}
				ENDIF
				
				sv_r = CLASSEXISTS("MTT","TranDetails")
				IF (sv_r == 0) THEN
				#{
					CREATECLASS("MTT","TranDetails",5)
				#}
				ENDIF
				
				sv_r = REPEXISTS("BANCS")
				IF (sv_r == 0) THEN
				#{
					CREATEREP("BANCS")
				#}
				ENDIF
				
				sv_r = CLASSEXISTS("BANCS","INPARAM")
				IF (sv_r == 0) THEN
				#{
					CREATECLASS("BANCS","INPARAM",5)
				#}
				ENDIF
	
		#===================================
		# STEP 1 : INITIALIZE THE MTT
		#===================================
		
				BANCS.INPARAM.PostTranFlg 		= "Y"
				BANCS.INPARAM.CommitFlg 		= "Y"
				BANCS.INPARAM.InsertTranWithValidnFlg 	= "Y"
				BANCS.INPARAM.ValidationFlag 		= "Y"
				BANCS.INPARAM.RestrictModifyInd 	= "FIRST_GROUP"
				BANCS.INPARAM.ErrorCheckForLuw 		= "Y"
				BANCS.INPARAM.CheckExceptions 		= "N"
							
				sv_u = urhk_MTTS_PopulateInputDetails("")
								
				
				MTT.TranDetails.TranType = "T"
				MTT.TranDetails.TranSubType = "CI"
				MTT.TranDetails.IgnoreExcp = "I"
				MTT.TranDetails.Consolidate = "N"
				MTT.TranDetails.Remarks = CUST.MOBIL.NARRATION
				
				sv_v = "PurchaseComm"
				PRINT(sv_v)
				
				
				sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
	
		
	#--------------------------------------------------
	# Credit to Branch Mobile Charges A/c
	#--------------------------------------------------
	
				MTT.PartTranDetails.Account = CUST.MOBIL.CRACCT
				MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = CUST.MOBIL.NARRATION
				MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.MOBIL.DRAMT)
				PRINT(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = ""
				MTT.PartTranDetails.RefNum = ""
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				sv_e = "PurchaseIncome"
				sv_r = urhk_MTTS_definePartTran(sv_e)
				PRINT(sv_r)
	
	#------------------------------------------------------------------
	# Debit From Customer A/c
	#------------------------------------------------------------------
	
			MTT.PartTranDetails.Account = CUST.MOBIL.acct
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars =  CUST.MOBIL.NARRATION
			sv_a = CDOUBLE(CUST.MOBIL.DRAMT)
			sv_a = -(sv_a)
			PRINT(sv_a)
			MTT.PartTranDetails.RefAmount = sv_a
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = ""
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_h = "D" + CUST.MOBIL.acct
			
			
			sv_r = urhk_MTTS_definePartTran(sv_h)
			IF (sv_r == 1) THEN
			#{
				PRINT("Unable to create MTT Part transaction")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
	#############################
	# Commit the transaction
	#############################
	sv_u = urhk_MTTS_EndDefinition("")
	PRINT(sv_u)
	
	CUST.MOBIL.TranId = BANCS.OUTPARAM.MTTTranId
	PRINT(CUST.MOBIL.TranId)
	
	
	##################################################
	# If any error tran id will not be created
	##################################################
	IF ((sv_u != 0)  OR (CUST.MOBIL.TranId==""))THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		PRINT (MTT.Error.Description)
		CUST.MOBIL.ResStatus = "F"
		CUST.MOBIL.Response = "Transaction creation Failed."
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO EndOfScript
	#}
	ENDIF

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	DO
#}
ENDIF

ENDOFSCRIPT:

trace off
end-->