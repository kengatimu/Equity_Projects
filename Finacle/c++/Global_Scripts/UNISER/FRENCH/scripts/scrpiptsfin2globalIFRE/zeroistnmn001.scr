<--START
CHECKSUM="2cd203f69f83e782dbb5b00e5ee3e9ef398780862984249e1b1ac50dace14cc0"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","CUSFXTR") == 0) THEN
	#{
		CREATECLASS("CUST","CUSFXTR",5)
	#}
	ENDIF
	
	CUST.CUSFXTR.Response    = ""
	CUST.CUSFXTR.crAccount = ""
	CUST.CUSFXTR.drAccount = ""
	CUST.CUSFXTR.desc      = ""
	CUST.CUSFXTR.amount    = "0"
	CUST.CUSFXTR.crDr1 	  = ""
	CUST.CUSFXTR.crDr2     = ""
	CUST.CUSFXTR.refCode	  = ""
	
	
	BANCS.INPUT.moduleName = "ZEROISTN"
	BANCS.INPUT.parameterId = "CUSFXTR_CRACCT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CUSFXTR.crAccount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.CUSFXTR.errMsg = "Credit Account setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CUSFXTR_DRACCT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CUSFXTR.drAccount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.CUSFXTR.errMsg = "Debit Account setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CUSFXTR_DESC"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CUSFXTR.desc = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.CUSFXTR.desc = ""
	#}
	ENDIF
	
	sv_a = BANCS.STDIN.mySolId
	CUST.CUSFXTR.drAccount = sv_a + CUST.CUSFXTR.drAccount
	PRINT(CUST.CUSFXTR.drAccount)
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CUSFXTR.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CUSFXTR.refCode)
		#}
	ELSE
		#{
		CUST.CUSFXTR.errMsg = "Ratecode set up not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#------------------------------------------------------------------
	#  Getting account to credit/debit and amount
	#
	#------------------------------------------------------------------
	sv_a = BANCS.STDIN.mySolId
	
	sv_s = "amount|SELECT clr_bal_amt "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CUSFXTR.drAccount
	sv_r =  urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	IF (sv_r == 0) THEN
	#{
		CUST.CUSFXTR.Amount=BANCS.OUTPARAM.amount
		PRINT(CUST.CUSFXTR.Amount)
		
	#}
	ELSE
	#{
		CUST.CUSFXTR.Amount = "0"
		GOTO Finish
	#}
	ENDIF
	
	PRINT(CUST.CUSFXTR.crAccount)
	PRINT(CUST.CUSFXTR.drAccount)
	
	#--------------------------------------------------------------------------
	# Create the narration
	#--------------------------------------------------------------------------
	
	CUST.CUSFXTR.narr1= "REVALUATION FROM BRANCH -> " + BANCS.STDIN.mySolId
	
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("MTT")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT","TranDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT","TranDetails",5)
	#}
	ENDIF
	
	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("BANCS")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("BANCS","INPARAM")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("BANCS","INPARAM",5)
	#}
	ENDIF
	
	#===================================
	# STEP 1 : INITIALIZE THE MTT
	#===================================
	
	BANCS.INPARAM.PostTranFlg 		= "Y"
	BANCS.INPARAM.CommitFlg 		= "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg 	= "Y"
	BANCS.INPARAM.ValidationFlag 		= "Y"
	BANCS.INPARAM.RestrictModifyInd 	= "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw 		= "Y"
	BANCS.INPARAM.CheckExceptions 		= "N"
	
	
	sv_u = urhk_MTTS_PopulateInputDetails("")
	
	
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
	MTT.TranDetails.Remarks = CUST.CUSFXTR.narr1
	
	sv_v = "PurchaseComm"
	PRINT(sv_v)
	
	
	sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
	
	
	
	
	#--------------------------------------------------
	# Credit to HO
	#--------------------------------------------------
	
	MTT.PartTranDetails.Account = CUST.CUSFXTR.crAccount
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.CUSFXTR.narr1
	MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.CUSFXTR.Amount)
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_e = "PurchaseIncome"
	sv_r = urhk_MTTS_definePartTran(sv_e)
	PRINT(sv_r)
	
	#------------------------------------------------------------------
	# Debit From BR
	#------------------------------------------------------------------
	
	MTT.PartTranDetails.Account = CUST.CUSFXTR.drAccount
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.CUSFXTR.narr1
	sv_a = CDOUBLE(CUST.CUSFXTR.Amount )
	sv_a = -(sv_a)
	PRINT(sv_a)
	MTT.PartTranDetails.RefAmount = sv_a
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = "D" + CUST.CUSFXTR.drAccount
	
	
	sv_r = urhk_MTTS_definePartTran(sv_h)
	IF (sv_r == 1) THEN
	#{
		PRINT("Unable to create MTT Part transaction")
		GOTO Finish
	#}
	ENDIF
	
	#############################
	# Commit the transaction
	#############################
	sv_u = urhk_MTTS_EndDefinition("")
	PRINT(sv_u)
	
	CUST.CUSFXTR.TranId = BANCS.OUTPARAM.MTTTranId
	PRINT(CUST.CUSFXTR.TranId)
	
	
	##################################################
	# If any error tran id will not be created
	##################################################
	IF ((sv_u != 0)  OR (CUST.CUSFXTR.TranId==""))THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		PRINT (MTT.Error.Description)
		CUST.CUSFXTR.ResStatus = "F"
		CUST.CUSFXTR.Response = "Transaction creation Failed."
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO EndOfScript
	#}
	ENDIF
	#sv_r = urhk_MTTS_Close("")
	#print(sv_r)
	
	Finish:
		IF(CUST.CUSFXTR.Response != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.CUSFXTR.Response+"' >>ZNFXT1.log")
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
END-->
