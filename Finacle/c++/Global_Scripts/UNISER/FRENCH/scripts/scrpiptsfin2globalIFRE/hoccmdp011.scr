	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# Getting Input at Backend
	#--------------------------------------------------------------------------
	CUST.HOCCM.zoneCode =  TOUPPER(TRIM(BANCS.INPUT.zoneCode))
	print(CUST.HOCCM.zoneCode)
	CUST.HOCCM.setNum =  TOUPPER(TRIM(BANCS.INPUT.setNum))
	print(CUST.HOCCM.setNum)
	CUST.HOCCM.zoneDate =  TOUPPER(TRIM(BANCS.INPUT.zoneDate))
	print(CUST.HOCCM.zoneDate)
	CUST.HOCCM.solId = TRIM(BANCS.STDIN.mySolId)
	print(CUST.HOCCM.solId)
	CUST.HOCCM.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.HOCCM.bankId)
	##UBP##
	CUST.HOCCM.billPayYes="N"
	CUST.HOCCM.billerId=" "
	CUST.HOCCM.typOfServ=" "
	CUST.HOCCM.valType=" "
	##UBP
	#--------------------------------------------------------------------------
	# selecting noOfChq, totalCrAmt
	#--------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.HOCCM.zoneCode + "|" + CUST.HOCCM.zoneDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.solId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.bankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "noOfChq,totalCrAmt|"
	sv_s = sv_s + " SELECT COUNT(SET_NUM),SUM(INSTRMNT_AMT)"
	sv_s = sv_s + " FROM TBAADM.OCI "
	sv_s = sv_s + " WHERE CLG_ZONE_CODE = ?SVAR "
	sv_s = sv_s + " AND trim(SET_NUM) = '" + CUST.HOCCM.setNum + "' "
	sv_s = sv_s + " AND CLG_ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND SOL_ID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# error
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
		sv_m = "Set Num is not valid for Zone Code."
		sv_z = "Error|" + sv_m
		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.HOCCM.noOfChq = BANCS.OUTPARAM.noOfChq
		print(CUST.HOCCM.noOfChq)
		CUST.HOCCM.totalCrAmt = BANCS.OUTPARAM.totalCrAmt
		CUST.HOCCM.totalCrAmt = FORMAT$(CDOUBLE(CUST.HOCCM.totalCrAmt),"%.2f")
		print(CUST.HOCCM.totalCrAmt)
	#}
	ENDIF
	IF(CINT(CUST.HOCCM.noOfChq) == 0)THEN
	#{
		# error
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
		sv_m = "Set Num is not valid for Zone Code."
		sv_z = "Error|" + sv_m
		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# selecting critCrAcctNum
	#--------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.HOCCM.zoneCode + "|" + CUST.HOCCM.zoneDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.solId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.bankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "critCrAcctNum|"
	sv_s = sv_s + " SELECT DISTINCT(g.Foracid)"
	sv_s = sv_s + " FROM TBAADM.OCP p, TBAADM.GAM g "
	sv_s = sv_s + " WHERE p.CLG_ZONE_CODE = ?SVAR "
	sv_s = sv_s + " AND trim(p.SET_NUM) = '" + CUST.HOCCM.setNum + "' "
	sv_s = sv_s + " AND p.CLG_ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND p.SOL_ID = ?SVAR "
	sv_s = sv_s + " AND p.BANK_ID = ?SVAR "
	sv_s = sv_s + " AND g.ACID = p.ACID "
	sv_s = sv_s + " AND g.BANK_ID = p.BANK_ID "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# error
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
		sv_m = "Error in fetching Cr. Account Id for SetNum."
		sv_z = "Error|" + sv_m
		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.HOCCM.critCrAcctNum = BANCS.OUTPARAM.critCrAcctNum
		print(CUST.HOCCM.critCrAcctNum)
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# Start-UBP-Calling scr to Check if its a bill payment against UBP table
	#--------------------------------------------------------------------------
	call("ubpdp062.scr")
	#--------------------------------------------------------------------------
	# END-UBP-Calling scr to Check if its a bill payment against UBP table
	#--------------------------------------------------------------------------
	#--------------------------------------------------------------------------
	# sending values to FE.
	#--------------------------------------------------------------------------
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "critCrAcctNum|" + CUST.HOCCM.critCrAcctNum
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "noOfChq|" + CUST.HOCCM.noOfChq
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "totalCrAmt|" + CUST.HOCCM.totalCrAmt
	sv_u = urhk_SetOrbOut(sv_w)
	#################UBP CHANGE#############
	sv_w = "billPayYes|" + CUST.HOCCM.billPayYes
	sv_u = urhk_SetOrbOut(sv_w)
	IF(CUST.HOCCM.billPayYes=="Y")THEN
	#{
		IF(CUST.HOCCM.billerId=="")THEN
		#{
			CUST.HOCCM.billerId=" "
		#}
		ENDIF
		sv_w = "billerId|" + CUST.HOCCM.billerId
		sv_u = urhk_SetOrbOut(sv_w)
		IF(CUST.HOCCM.typOfServ=="")THEN
		#{
			CUST.HOCCM.typOfServ=" "
		#}
		ENDIF
		sv_w = "typOfServ|" + CUST.HOCCM.typOfServ
		sv_u = urhk_SetOrbOut(sv_w)
		IF(CUST.HOCCM.valType=="")THEN
		#{
			CUST.HOCCM.valType=" "
		#}
		ENDIF
		sv_w = "valType|" + CUST.HOCCM.valType
		sv_u = urhk_SetOrbOut(sv_w)
	#}
	ENDIF
	#################UBP CHANGE#############
	ENDOFSCRIPT:
		#----------------------------------------
		# deleting repositories and calsses.
