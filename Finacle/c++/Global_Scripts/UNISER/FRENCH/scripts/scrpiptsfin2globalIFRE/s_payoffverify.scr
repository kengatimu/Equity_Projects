						IF(sv_m == 0 ) then
						#{	
						## To check whetehr any ADT with unverified status is there. If it there after hpayoff, that will be marked as verified##
						
						BANCS.INPARAM.BINDVARS = ""
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.BODDate +  "|" + BANCS.STDIN.contextBankId +  "|" + CUST.DATA.acid +  "|" + CUST.DATA.acid +  "|" + BANCS.STDIN.contextBankId + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS     + BANCS.STDIN.contextBankId +  "|" + CUST.DATA.acid +  "|" + BANCS.STDIN.contextBankId +  "|" + CUST.DATA.acid
						print(BANCS.INPARAM.BINDVARS)
			
			
						sv_s = "update tbaadm.adt set AUTH_ID= ENTERER_ID ,rmks='RECORD AUTHORIZED',AUTH_DATE=sysdate , "
						sv_s = sv_s + "  AUTH_BOD_DATE= to_date( ?SVAR   ,'dd-mm-yyyy HH24:MI:SS')  "
						sv_s = sv_s + "  where  bank_id=?SVAR and adt.acid= ?SVAR and adt.table_name='CLTT' "
						sv_s = sv_s + "  and adt.AUTH_ID='!' "
						sv_s = sv_s + "  and adt.table_key=?SVAR||'/PYOFF/001/'||?SVAR "
						sv_s = sv_s + "  and not exists (select 1 from tbaadm.cltt where cltt.bank_id=?SVAR  "
						sv_s = sv_s + "  and cltt.EVENT_ID='PYOFF'  and cltt.acid=?SVAR ) "
						sv_s = sv_s + "  and exists (select 1 from tbaadm.lam where lam.bank_id=?SVAR "
						sv_s = sv_s + "  and lam.acid=?SVAR  and lam.payoff_flg='Y') "
						
											
						print(sv_s)	
						sv_d = urhk_dbSqlWithBind(sv_s)
