			sv_s = " DELETE FROM TBAADM.CLTT "
			sv_s = sv_s + "  WHERE ACID = ?SVAR"
			sv_s = sv_s + "  AND SOURCE_DR_ACID = ?SVAR"
			sv_s = sv_s + "  AND EVENT_ID ='PYOFF'"
			sv_s = sv_s + "  AND FUNC_CODE='P'"
			sv_s = sv_s + "  AND bank_id = ?SVAR"
			sv_s = sv_s + "  AND RCRE_USER_ID = ?SVAR"
			print(sv_s)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			print(sv_d)
			sv_d = urhk_dbSqlWithBind("COMMIT")
			print(sv_d)
			
			## Since we are removing CLTT record, same unverified record needs to be removed from ADT as well##
			
			BANCS.INPARAM.BINDVARS =  CUST.DATA.acid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId + "|" + CUST.DATA.acid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
            sv_s = " DELETE FROM TBAADM.ADT "
            sv_s = sv_s + "  WHERE ACID = ?SVAR"
            sv_s = sv_s + "  AND FUNC_CODE='A'"
            sv_s = sv_s + "  AND TABLE_NAME ='CLTT'"
            sv_s = sv_s + "  AND AUTH_ID='!'"
            sv_s = sv_s + "  AND bank_id = ?SVAR"
            sv_s = sv_s + "  AND ENTERER_ID = ?SVAR"
			sv_s = sv_s + "  and table_key=?SVAR||'/PYOFF/001/'||?SVAR "

			sv_d = urhk_dbSqlWithBind(sv_s)
