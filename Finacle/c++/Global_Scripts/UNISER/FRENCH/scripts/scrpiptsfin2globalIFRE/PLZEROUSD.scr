#    -------		----			------			----------------
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="866098f74c30edfcad8deed31da47fb9da23365f2e895bfb82880cc91d32f541"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	#===================================
	# STEP 1 : INITIALIZE THE MTT
	#===================================
	sv_r = urhk_MTTS_Close("")
	PRINT(sv_r)
	
	
	BANCS.INPARAM.PostTranFlg 		= "Y"
	BANCS.INPARAM.CommitFlg 		= "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg 	= "Y"
	BANCS.INPARAM.ValidationFlag 		= "Y"
	BANCS.INPARAM.RestrictModifyInd 	= "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw 		= "Y"
	BANCS.INPARAM.CheckExceptions 		= "N"
	
	sv_u = urhk_MTTS_Initialize("")
	PRINT(sv_u)
	IF(sv_u != 0 ) THEN
	#{
		CUST.PLZERO.errMsg = "MTT Initialize Failed"
		GOTO Finish
	#}
	ENDIF
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","PLZERO") == 0) THEN
	#{
		CREATECLASS("CUST","PLZERO",5)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("MTT")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT","TranDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT","TranDetails",5)
	#}
	ENDIF
	
	#===================================
	#Initializing variables
	#===================================
	CUST.PLZERO.narration= "EOY PL BAL TRANSFER 2018 TO HO"
	
	IF(BANCS.STDIN.contextBankId == "11")THEN
	#{
		CUST.PLZERO.HOAccount = "2000500021667"
	#}
	ENDIF
	
	
	#=================================
	#Report Initialization
	#=================================
	sv_d = "Today|SELECT to_char(sysdate,'ddmmyyyyhhmiss') FROM dual"
	PRINT(sv_d)
	
	sv_p = urhk_dbSelectWithBind(sv_d)
	
	IF (BANCS.OUTPARAM.DB_ERRCODE == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.Today)
		CUST.PLZERO.Today = BANCS.OUTPARAM.Today
		#}
	ELSE
		#{
		CUST.PLZERO.Today = ""
	#}
	ENDIF
	
	CUST.PLZERO.ExpenseReport = "Expense_PLZERO_" + CUST.PLZERO.Today + ".lst"
	sv_a = "PNL EXPENSE ACCOUNTS ZEROISATION"
	sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.ExpenseReport
	PRINT(sv_c)
	sv_d = SYSTEM(sv_c)
	PRINT(sv_d)
	
	sv_a = "foracid!currencycode!indictor!partitionflag!partitiontype!amount"
	sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.ExpenseReport
	PRINT(sv_c)
	sv_d = SYSTEM(sv_c)
	PRINT(sv_d)
	
	CUST.PLZERO.IncomeReport = "Income_PLZERO_" + CUST.PLZERO.Today + ".lst"
	sv_a = "PNL INCOME ACCOUNTS ZEROISATION"
	sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.IncomeReport
	PRINT(sv_c)
	sv_d = SYSTEM(sv_c)
	PRINT(sv_d)
	
	sv_a = "foracid!currencycode!indictor!partitionflag!partitiontype!amount"
	sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.IncomeReport
	PRINT(sv_c)
	sv_d = SYSTEM(sv_c)
	PRINT(sv_d)
	
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "Y"
	MTT.TranDetails.Remarks = CUST.PLZERO.narration
	MTT.TranDetails.ValidationFlag = "Y"
	MTT.TranDetails.PostTranFlg = "Y"
	MTT.TranDetails.CheckExceptions = "Y"
	
	sv_u = urhk_MTTS_DefineTransaction("plzeroisation")
	PRINT(sv_u)
	IF(sv_u != 0 ) THEN
	#{
		CUST.PLZERO.errMsg = "MTT Initialize Failed"
		GOTO Finish
	#}
	ENDIF
	
	
	#------------------------------------------------------------------
	#  EXPENSE ACCOUNT ZEROISATION
	#------------------------------------------------------------------
	
	
	CUST.PLZERO.usdCrncyCode = "USD"
	print(CUST.PLZERO.usdCrncyCode)

	sv_s = "foracid,balance,indicator,partitionFlag,partitionType|SELECT foracid,TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018'),"
	sv_s = sv_s + "decode(sign(TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')),-1,'C','D'),PARTITIONED_FLG,PARTITIONED_TYPE "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + " AND gam.ACCT_OWNERSHIP='O' "
	sv_s = sv_s + " AND TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')!=0 "
	sv_s = sv_s + " AND substr(GL_SUB_HEAD_CODE,1,2) in ('80','81','82','83','85') "
	sv_s = sv_s + " AND gam.acct_crncy_code=?SVAR AND gam.sol_id= ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" + CUST.PLZERO.usdCrncyCode + "|" + BANCS.STDIN.mySolId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_r)
	IF (sv_r == 0) THEN
	#{
		CUST.PLZERO.expCount = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.PLZERO.expCount)
		#}
	ELSE
		#{
		CUST.PLZERO.expErrMsg = "No Records fetched."
		GOTO Income
	#}
	ENDIF
	
	sv_c = urhk_dbCursorFetch(CUST.PLZERO.expCount)
	PRINT(sv_c)
	
	IF(sv_c !=0)THEN
	#{
		CUST.PLZERO.expErrMsg = "No Records fetched."
		GOTO Income
	#}
	ENDIF
	
	sv_c = 0
	WHILE (sv_c == 0)
	#{
		CUST.PLZERO.foracid = BANCS.OUTPARAM.foracid
		CUST.PLZERO.balance = BANCS.OUTPARAM.balance
		CUST.PLZERO.indicator = BANCS.OUTPARAM.indicator
		CUST.PLZERO.partitionFlag = BANCS.OUTPARAM.partitionFlag
		CUST.PLZERO.PartitionType = BANCS.OUTPARAM.partitionType
		
		#--------------------------------------------------
		# expense/income account
		#--------------------------------------------------
		
		MTT.PartTranDetails.Account = CUST.PLZERO.foracid
		MTT.PartTranDetails.RefCurrency = CUST.PLZERO.usdCrncyCode
		MTT.PartTranDetails.ValueDateDiff = "0"
		MTT.PartTranDetails.ValueDate           =     "0"
		MTT.PartTranDetails.Particulars = CUST.PLZERO.narration
		MTT.PartTranDetails.RefAmount = -cdouble(CUST.PLZERO.balance)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Remarks = ""
		MTT.PartTranDetails.RefNum = ""
		MTT.PartTranDetails.IgnoreExcp = "I"
		MTT.PartTranDetails.Consolidate = "Y"
		MTT.PartTranDetails.TranIdentifier = "plzeroisation"
		PRINT(MTT.PartTranDetails.TranIdentifier)
		sv_r = urhk_B2k_PrintRepos("MTT")
		IF(CUST.PLZERO.partitionFlag == "Y")THEN
		#{
			MTT.PartTranDetails.ACPARTB2kId = CUST.PLZERO.foracid
			MTT.PartTranDetails.ACPARTB2kType = CUST.PLZERO.PartitionType
		#}
		ENDIF
		sv_e = "PurchaseIncome"
		sv_r = urhk_MTTS_definePartTran(sv_e)
		PRINT(sv_r)
		
		IF (sv_r != 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			PRINT(MTT.Error.Description)
			MTT.Error.Description="Could not Create Part tran for collection of WTH"
			sv_r = urhk_MTTS_ReportErrorCondition("")
			PRINT(sv_r)
			sv_r = BANCS.OUTPARAM.MTTErrorDesc
			PRINT(sv_r)
			GOTO Finish
		#}
		ENDIF
		
		sv_h = -cdouble(CUST.PLZERO.balance)
		PRINT(sv_h)
		sv_q = sv_h
		PRINT(sv_q)
		PRINT(CUST.PLZERO.foracid)
		PRINT(CUST.PLZERO.usdCrncyCode)
		PRINT(CUST.PLZERO.indicator)
		sv_a = CUST.PLZERO.foracid + "!" + CUST.PLZERO.usdCrncyCode + "!" + CUST.PLZERO.indicator + "!" +  CUST.PLZERO.partitionFlag + "!" + CUST.PLZERO.PartitionType + "!" + CUST.PLZERO.balance
		PRINT(sv_a)
		sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.ExpenseReport
		PRINT(sv_c)
		sv_d = SYSTEM(sv_c)
		
		sv_c = urhk_dbCursorFetch(CUST.PLZERO.expCount)
		PRINT(sv_c)
	#}
	DO
	sv_c = urhk_dbCursorClose(CUST.PLZERO.expCount)
	PRINT(sv_c)
	
	sv_s = "foracid,balance,indicator|SELECT ?SVAR,sum(TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')),"
	sv_s = sv_s + "sum(TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')) "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + " AND gam.ACCT_OWNERSHIP='O' "
	sv_s = sv_s + " AND TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')!=0 "
	sv_s = sv_s + " AND substr(GL_SUB_HEAD_CODE,1,2) in ('80','81','82','83','85') "
	sv_s = sv_s + " AND gam.acct_crncy_code=?SVAR AND gam.sol_id= ?SVAR"
	
	BANCS.INPARAM.BINDVARS = CUST.PLZERO.HOAccount + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.PLZERO.usdCrncyCode + "|" + BANCS.STDIN.mySolId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	IF (sv_r == 0) THEN
	#{
		CUST.PLZERO.hoForacid = BANCS.OUTPARAM.foracid
		CUST.PLZERO.hoBalance = BANCS.OUTPARAM.balance
		CUST.PLZERO.hoIndicator = BANCS.OUTPARAM.indicator
		
		MTT.PartTranDetails.Account = CUST.PLZERO.hoForacid
		MTT.PartTranDetails.RefCurrency = CUST.PLZERO.usdCrncyCode
		MTT.PartTranDetails.ValueDateDiff = "0"
		MTT.PartTranDetails.ValueDate           =  "0"
		MTT.PartTranDetails.Particulars = CUST.PLZERO.narration
		MTT.PartTranDetails.RefAmount = CUST.PLZERO.hoBalance
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Remarks = ""
		MTT.PartTranDetails.RefNum = ""
		MTT.PartTranDetails.IgnoreExcp = "I"
		MTT.PartTranDetails.Consolidate = "Y"
		MTT.PartTranDetails.TranIdentifier = "plzeroisation"
		
		
		sv_r = urhk_MTTS_definePartTran("plzeroisation")
		IF (sv_r == 1) THEN
		#{
			CUST.PLZERO.expErrMsg = "Unable to define part-tran."
			GOTO Income
		#}
		ENDIF
		
		sv_a = CUST.PLZERO.hoForacid + "!" + CUST.PLZERO.usdCrncyCode + "!" + CUST.PLZERO.hoIndicator + "!" + CUST.PLZERO.hoBalance
		sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.ExpenseReport
		PRINT(sv_c)
		sv_d = SYSTEM(sv_c)
		
		#############################
		# Commit the transaction
		#############################
		sv_u = urhk_MTTS_EndDefinition("")
		PRINT(sv_u)
		
		CUST.PLZERO.TranId = BANCS.OUTPARAM.MTTTranId
		PRINT(CUST.PLZERO.TranId)
		
		
		PRINT(MTT.XCPN.NumExceptions)
		IF((MTT.XCPN.NumExceptions >= 1) OR (MTT.XCPN.NumWarnings >= 1)) THEN
		#{
			sv_u = urhk_MTTS_HandleExceptions("POST")
			IF (sv_u != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT (MTT.Error.Description)
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_u = urhk_MTTS_HandleExceptions("POST")
			IF (sv_u != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT (MTT.Error.Description)
			#}
			ENDIF
		#}
		ENDIF
		
		#}
	ELSE
		#{
		CUST.PLZERO.expErrMsg = "Unable to fetch HO Account details."
		GOTO Income
	#}
	ENDIF
	
	Income:
		#################################################
		#Income PNL zeroisation
		#################################################
		#------------------------------------------------------------------
		#  Getting account to credit/debit and amount
		#
		#------------------------------------------------------------------
		
		sv_s = "foracid,balance,indicator,partitionFlag,partitionType|SELECT foracid,TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018'),"
		sv_s = sv_s + "decode(sign(TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')),-1,'C','D'),PARTITIONED_FLG,PARTITIONED_TYPE "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE bank_id = ?SVAR "
		sv_s = sv_s + " AND gam.ACCT_OWNERSHIP='O' "
		sv_s = sv_s + " AND TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')!=0 "
		sv_s = sv_s + " AND substr(GL_SUB_HEAD_CODE,1,2) in ('60','62','65','67') "
		sv_s = sv_s + " AND gam.acct_crncy_code=?SVAR AND gam.sol_id= ?SVAR AND  ACCT_NAME not like '%PROXY%' "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" + CUST.PLZERO.usdCrncyCode + "|" + BANCS.STDIN.mySolId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_r =  urhk_dbcursorOpenWithBind(sv_s)
		PRINT(sv_r)
		IF (sv_r == 0) THEN
		#{
			CUST.PLZERO.incCount = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(CUST.PLZERO.incCount)
			#}
		ELSE
			#{
			CUST.PLZERO.incErrMsg = "No Records fetched."
			GOTO Finish
		#}
		ENDIF
		
		sv_c = urhk_dbCursorFetch(CUST.PLZERO.incCount)
		PRINT(sv_c)
		
		IF(sv_c !=0)THEN
		#{
			CUST.PLZERO.incErrMsg = "No Records fetched."
			GOTO Finish
		#}
		ENDIF
		
		sv_c = 0
		WHILE (sv_c == 0)
		#{
			CUST.PLZERO.foracid = BANCS.OUTPARAM.foracid
			CUST.PLZERO.balance = BANCS.OUTPARAM.balance
			CUST.PLZERO.indicator = BANCS.OUTPARAM.indicator
			CUST.PLZERO.partitionFlag = BANCS.OUTPARAM.partitionFlag
			CUST.PLZERO.PartitionType = BANCS.OUTPARAM.partitionType
			
			#--------------------------------------------------
			# expense/income account
			#--------------------------------------------------
			
			MTT.PartTranDetails.Account = CUST.PLZERO.foracid
			MTT.PartTranDetails.RefCurrency = CUST.PLZERO.usdCrncyCode
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.ValueDate           =  "0"
			MTT.PartTranDetails.Particulars = CUST.PLZERO.narration
			MTT.PartTranDetails.RefAmount = -cdouble(CUST.PLZERO.balance)
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = ""
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "plzeroisation"
			sv_e = "PurchaseIncome"
			IF(CUST.PLZERO.partitionFlag == "Y")THEN
			#{
				MTT.PartTranDetails.ACPARTB2kId = CUST.PLZERO.foracid
				MTT.PartTranDetails.ACPARTB2kType = CUST.PLZERO.PartitionType
			#}
			ENDIF
			
			sv_r = urhk_MTTS_definePartTran(sv_e)
			PRINT(sv_r)
			
			
			sv_h = -cdouble(CUST.PLZERO.balance)
			PRINT(sv_h)
			sv_q = sv_h
			PRINT(sv_q)
			sv_a = CUST.PLZERO.foracid + "!" + CUST.PLZERO.usdCrncyCode + "!" + CUST.PLZERO.indicator + "!" + CUST.PLZERO.partitionFlag + "!" + CUST.PLZERO.PartitionType + "!" + CUST.PLZERO.balance
			sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.IncomeReport
			PRINT(sv_c)
			sv_d = SYSTEM(sv_c)
			
			sv_c = urhk_dbCursorFetch(CUST.PLZERO.incCount)
			PRINT(sv_c)
		#}
		DO
		sv_c = urhk_dbCursorClose(CUST.PLZERO.incCount)
		PRINT(sv_c)
		
		sv_s = "foracid,balance,indicator|SELECT ?SVAR,sum(TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')),"
		sv_s = sv_s + "sum(TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')) "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE bank_id = ?SVAR "
		sv_s = sv_s + " AND gam.ACCT_OWNERSHIP='O' "
		sv_s = sv_s + " AND TBAADM.commonpackage.eabbal(?SVAR,gam.acid,'31-DEC-2018')!=0 "
		sv_s = sv_s + " AND substr(GL_SUB_HEAD_CODE,1,2) in ('60','62','65','67') "
		sv_s = sv_s + " AND gam.acct_crncy_code=?SVAR AND gam.sol_id= ?SVAR AND  ACCT_NAME not like '%PROXY%' "
		
		BANCS.INPARAM.BINDVARS = CUST.PLZERO.HOAccount + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.PLZERO.usdCrncyCode + "|" + BANCS.STDIN.mySolId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_r =  urhk_dbSelectWithBind(sv_s)
		PRINT(sv_r)
		IF (sv_r == 0) THEN
		#{
			CUST.PLZERO.hoForacid = BANCS.OUTPARAM.foracid
			CUST.PLZERO.hoBalance = BANCS.OUTPARAM.balance
			CUST.PLZERO.hoIndicator = BANCS.OUTPARAM.indicator
			
			MTT.PartTranDetails.Account = CUST.PLZERO.hoForacid
			MTT.PartTranDetails.RefCurrency = CUST.PLZERO.usdCrncyCode
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.ValueDate           =  "0"
			MTT.PartTranDetails.Particulars = CUST.PLZERO.narration
			MTT.PartTranDetails.RefAmount = CUST.PLZERO.hoBalance
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = ""
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "plzeroisation"
			
			
			
			sv_r = urhk_MTTS_definePartTran("plzeroisation")
			IF (sv_r == 1) THEN
			#{
				PRINT("Unable to create MTT Part transaction")
				GOTO Finish
			#}
			ENDIF
			
			sv_a = CUST.PLZERO.hoForacid + "!" + CUST.PLZERO.usdCrncyCode + "!" + CUST.PLZERO.hoIndicator + "!" + CUST.PLZERO.hoBalance
			sv_c = "echo " + sv_a + " >> " + CUST.PLZERO.IncomeReport
			PRINT(sv_c)
			sv_d = SYSTEM(sv_c)
			
			#############################
			# Commit the transaction
			#############################
			sv_u = urhk_MTTS_EndDefinition("")
			PRINT(sv_u)
			
			CUST.PLZERO.TranId = BANCS.OUTPARAM.MTTTranId
			PRINT(CUST.PLZERO.TranId)
			
			PRINT(MTT.XCPN.NumExceptions)
			IF((MTT.XCPN.NumExceptions >= 1) OR (MTT.XCPN.NumWarnings >= 1)) THEN
			#{
				sv_u = urhk_MTTS_HandleExceptions("POST")
				IF (sv_u != 0) THEN
				#{
					sv_r = urhk_MTTS_ReportErrorCondition("")
					PRINT (MTT.Error.Description)
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_u = urhk_MTTS_HandleExceptions("POST")
				IF (sv_u != 0) THEN
				#{
					sv_r = urhk_MTTS_ReportErrorCondition("")
					PRINT (MTT.Error.Description)
				#}
				ENDIF
			#}
			ENDIF
			
			sv_r = urhk_MTTS_Close("")
			PRINT(sv_r)
			
			IF (sv_r == 1) THEN
			#{
				PRINT("Unable to Close MTT ")
				GOTO Finish
			#}
			ENDIF
			
			#}
		ELSE
			#{
			CUST.PLZERO.incErrMsg = "Unable to fetch HO Account details"
			GOTO Finish
		#}
		ENDIF
		
		
	Finish:
		sv_a = "exebatch babx4040 $B2K_SESSION_ID " + CUST.PLZERO.ExpenseReport + " 'PNL Expense Account Zeroisation Report' 'MANAGER' '1' N"
		PRINT(sv_a)
		sv_x = SYSTEM(sv_a)
		PRINT(sv_x)
		IF (sv_x != 0) THEN
		#{
			CUST.PLZERO.SuccessReport = "N"
		#}
		ENDIF
		
		sv_a = "exebatch babx4040 $B2K_SESSION_ID " + CUST.PLZERO.IncomeReport + " 'PNL Income Account Zeroisation Report' 'MANAGER' '1' N"
		PRINT(sv_a)
		sv_x = SYSTEM(sv_a)
		PRINT(sv_x)
		IF (sv_x != 0) THEN
		#{
			CUST.PLZERO.SuccessReport = "N"
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
