<--START
TRACE ON

	############################################################
	#Custom Repository creation
	############################################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CLG") == 0) THEN
	#{
		CREATECLASS("CUST","CLG",5)
	#}
	ENDIF

	CUST.CLG.errMsg = ""
	CUST.CLG.wclass1 = ""

	###################################################################
	# Inputs from jsp
	###################################################################
	sv_z = BANCS.STDIN.userWorkClass
	print(sv_z)
	print(BANCS.INPUT.funcCode)
	sv_y = BANCS.INPUT.funcCode

	#####################################################################
	# Calling getcparamvalue.scr script
	#####################################################################
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "WCLASS_999"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CLG.wclass1 = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLG.errMsg = "Work Class is not set in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF (((sv_y == "A") or (sv_y == "C")) and (sv_z != CUST.CLG.wclass1)) THEN
	#{
			print("true")
			sv_u = urhk_SetOrbOut("Msg|Your Work Class does not allow you to Add/Copy a Zone!")
			print(sv_u)
			GOTO ENDOFSCRIPT
	#}
	ENDIF 
	
	ENDOFSCRIPT:
	IF (CUST.CLG.errMsg != "") THEN
	#{
		print("false2")
		sv_u = urhk_SetOrbOut("Error|"+CUST.CLG.errMsg)
	#}
	ENDIF

EXITSCRIPT
TRACE OFF
END-->
