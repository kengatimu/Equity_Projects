<--START
CHECKSUM="4f9b1b4970ff9c8e712a12fd23de1224185e4d4462d2bb24f38793465378ff79"
TRACE ON

sv_l = urhk_B2k_printrepos("BANCS")
        print(sv_l)

#------------------------------------------------------------------------------
# Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
        CREATECLASS("CUST","DATA",5)
#}
ENDIF
if (BANCS.STDIN.menuId =="HCCS") then
#{

	sv_a = urhk_SRV_GetVal("sol.solId")
	CUST.DATA.toSolId = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.toSolId)
	CUST.DATA.homeSolId = BANCS.STDIN.homeSolId 
	print(CUST.DATA.homeSolId)
#}
else
#{
	if (BANCS.STDIN.menuId =="HCSE") then
	#{
		sv_a = urhk_SRV_GetVal("fromSolId.solId")
		CUST.DATA.homeSolId = BANCS.OUTPARAM.srvValue
		print(CUST.DATA.homeSolId) 
		sv_a = urhk_SRV_GetVal("toSolId.solId")
		CUST.DATA.toSolId = BANCS.OUTPARAM.srvValue
		print(CUST.DATA.toSolId)
	#}
	endif
#}
endif
if (BANCS.STDIN.contextBankId =="43") then
#{ 
	sv_s = "setid,solId|select set_id,sol_id from tbaadm.sst where sol_id =?SVAR and set_id in ('EBC','BCDC') and bank_id =?SVAR"
	BANCS.INPARAM.BINDVARS=CUST.DATA.homeSolId + "|" + BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)
        IF (sv_d == 0) THEN
        #{
		CUST.DATA.setid1 = BANCS.OUTPARAM.setid
		print(CUST.DATA.setid1)
		CUST.DATA.solId1 = BANCS.OUTPARAM.solId
		print(CUST.DATA.solId1)
	#}
	endif
	
	sv_s = "setid,solId|select set_id,sol_id from tbaadm.sst where sol_id =?SVAR and set_id in ('EBC','BCDC') and bank_id =?SVAR"
        BANCS.INPARAM.BINDVARS=CUST.DATA.toSolId + "|" + BANCS.STDIN.contextBankId
        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)
        IF (sv_d == 0) THEN
        #{
                CUST.DATA.setid2 = BANCS.OUTPARAM.setid
                print(CUST.DATA.setid2)
                CUST.DATA.solId2 = BANCS.OUTPARAM.solId
                print(CUST.DATA.solId2)
        #}
        endif
	
	print(CUST.DATA.setid1)
	print(CUST.DATA.setid2)	

	if (CUST.DATA.setid1 != CUST.DATA.setid2) then
	#{
		sv_u = urhk_SRV_SetErr("Context Sol change to " + CUST.DATA.setid2 + " Not Allowed")
		exitscript
	#}
	endif	
#}
endif
TRACE OFF
exitscript
END-->
