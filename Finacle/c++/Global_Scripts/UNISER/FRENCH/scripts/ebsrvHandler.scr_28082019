#   Name                   : ebsrvHandler.scr 
#   Date                   : 07-Mar-2019
#   Description            :
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
	EQSRV.GLBDATA.ErrorDesc  	= ""
	EQSRV.GLBDATA.ErrorMsg 	= ""
	EQSRV.GLBDATA.WarnMsg		= ""
	EQSRV.GLBDATA.XcpnMsg		= ""
	EQSRV.GLBDATA.CompMsg		= ""
	EQSRV.GLBDATA.Quote		= "'"
	EQSRV.GLBDATA.SrvError = ""
	EQSRV.GLBDATA.ErrorDet = ""
	EQSRV.GLBDATA.LogFile = "ebsrvHandler.rpt" 
	BANCS.OUTPARAM.UserInfo_num = ""
	BANCS.OUTPARAM.Xcpn_Err_num = ""
	
	if(fieldexists(BANCS.OUTPARAM.Fatal_num) != 0) then
	#{
		print(BANCS.OUTPARAM.Fatal_num)
	else
		BANCS.OUTPARAM.Error_num = "0"
	#}
	endif
	if(fieldexists(BANCS.OUTPARAM.Fatal_num) != 0) then
	#{
		print(BANCS.OUTPARAM.Fatal_num)
	else
		BANCS.OUTPARAM.Fatal_num = "0"
	#}
	endif
	if(fieldexists(BANCS.OUTPARAM.Error_num) != 0) then
	#{
		print(BANCS.OUTPARAM.Error_num)
	else
		BANCS.OUTPARAM.Error_num = "0"
	#}
	endif
	if(fieldexists(BANCS.OUTPARAM.Warning_num) != 0) then
	#{
		print(BANCS.OUTPARAM.Warning_num)
	else
		BANCS.OUTPARAM.Warning_num = "0"
	#}
	endif
	if(fieldexists(BANCS.OUTPARAM.Xcpn_num) != 0) then
	#{
		print(BANCS.OUTPARAM.Xcpn_num)
	else
		BANCS.OUTPARAM.Xcpn_num = "0"
	#}
	endif
	
	
	sv_g = "echo '\n ~~~~~~~~~~~~~~~~~SRV execution Failed~~~~~~~~~~~~~~~~~ \n"
	sv_g = "echo '\n Encountered errors! \n"
	sv_g = sv_g + "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ \n"
	sv_g = sv_g + "Number of Error(s) : " + BANCS.OUTPARAM.Error_num + " \n"
	sv_g = sv_g + "Number of Fatal Error(s) : "  + BANCS.OUTPARAM.Fatal_num + " \n"
	sv_g = sv_g + "Number of Warning(s) : " + BANCS.OUTPARAM.Warning_num + " \n"
	sv_g = sv_g + "Number of UserInfo msg(s) : " + BANCS.OUTPARAM.UserInfo_num + " \n"
	sv_g = sv_g + "Number of Exception(s) : " + BANCS.OUTPARAM.Xcpn_num + " \n"
	sv_g = sv_g + "Number of Exception Error(s) : " + BANCS.OUTPARAM.Xcpn_Err_num + " \n'"
	sv_g = sv_g + "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ "
	sv_g = sv_g + " >> " + EQSRV.GLBDATA.LogFile
	print(sv_g)
	
	sv_a = SYSTEM(sv_g)
	print(sv_a)
	if(sv_a != 0) then
	#{
		sv_g = "echo 'Unable to capture the warning message. Please check the trace files!' >> " + EQSRV.GLBDATA.LogFile
		print(sv_g)
		sv_x = SYSTEM(sv_g)
		print(sv_x)
	#}
	endif
	#########################
	# For handling of errors
	#########################
	sv_c = BANCS.OUTPARAM.Error_num
	print(sv_c)
	IF(sv_c > 0) THEN
	#{
		sv_d = 1
		WHILE (sv_d <= sv_c)
		#{
			sv_f = FORMAT$(sv_d,"%d")
			#=====================================
			# Printing the Error Message
			#=====================================
			("EQSRV").("GLBDATA").("ErrorMesg_"+sv_f) = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
			print(("EQSRV").("GLBDATA").("ErrorMesg_"+sv_f))
			
			#=====================================
			# Printing the Error Code
			#=====================================
			("EQSRV").("GLBDATA").("ErrorCode_"+sv_f) = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
			print(("EQSRV").("GLBDATA").("ErrorCode_"+sv_f))
			
			#=====================================
			# Printing the Error Tag
			#=====================================
			("EQSRV").("GLBDATA").("ErrorTag_"+sv_f) = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
			print(("EQSRV").("GLBDATA").("ErrorTag_"+sv_f))
			
			#===================================================
			# Removing the ">" and "<" charachers from Error tag.
			#===================================================
			sv_p = 1
			sv_q = 1
			sv_e = ("EQSRV").("GLBDATA").("ErrorTag_"+sv_f)
			#trace off
			
			while((sv_p != 0) or (sv_q != 0))
			#{
				sv_p = getposition(sv_e,">")
				print(sv_p)
				if(sv_p != 0) then
				#{
					EQSRV.GLBDATA.str_1 = mid$(sv_e,0,sv_p-1)
					EQSRV.GLBDATA.str_2 = mid$(sv_e,sv_p,strlen(sv_e))
					print(EQSRV.GLBDATA.str_1)
					print(EQSRV.GLBDATA.str_2)
					sv_e = EQSRV.GLBDATA.str_1 + EQSRV.GLBDATA.str_2
					print(sv_e)
				#}
				endif
				sv_q = getposition(sv_e,"<")
				print(sv_q)
				if(sv_q != 0 )then
				#{
					EQSRV.GLBDATA.str_1 = mid$(sv_e,0,sv_q-1)
					EQSRV.GLBDATA.str_2 = mid$(sv_e,sv_q,strlen(sv_e))
					print(EQSRV.GLBDATA.str_1)
					print(EQSRV.GLBDATA.str_2)
					sv_e = EQSRV.GLBDATA.str_1 + EQSRV.GLBDATA.str_2
					print(sv_e)
				#}
				endif
			#}
			do
			
			("EQSRV").("GLBDATA").("ErrorTag_"+sv_f) = sv_e
			
			#=====================================
			# Writing Error Details in log file.
			#=====================================
			
			
			EQSRV.GLBDATA.ErrorDet = "The error Tag is :" + EQSRV.GLBDATA.Quote +  ("EQSRV").("GLBDATA").("ErrorTag_"+sv_f) + "\n"
			EQSRV.GLBDATA.ErrorDet = EQSRV.GLBDATA.ErrorDet + "The error code is :" +("EQSRV").("GLBDATA").("ErrorCode_"+sv_f) + "\n"
			EQSRV.GLBDATA.ErrorDet = EQSRV.GLBDATA.ErrorDet + "The error message is :"  + ("EQSRV").("GLBDATA").("ErrorMesg_"+sv_f) + EQSRV.GLBDATA.Quote
			EQSRV.GLBDATA.ErrorMsg = "echo " + EQSRV.GLBDATA.ErrorDet + " >> " + EQSRV.GLBDATA.LogFile
			print(EQSRV.GLBDATA.ErrorMsg)
			
			sv_x = SYSTEM(EQSRV.GLBDATA.ErrorMsg)
			print(sv_x)
			if(sv_x != 0) then
			#{
				sv_g = "echo 'Unable to capture the warning message. Please check the trace files!' >> " + EQSRV.GLBDATA.LogFile
				print(sv_g)
				sv_x = SYSTEM(sv_g)
				print(sv_x)
			#}
			endif
			
			sv_d = sv_d + 1
		#}
		DO
		#}
	ELSE
		#{
		sv_f = "0"
	#}
	ENDIF
	
	
	#print(EQSRV.GLBDATA.ErrorDet)
	EQSRV.GLBDATA.ErrorCnt = cint(sv_f)
	#=====================================
	# For handling of warnings
	#=====================================
	sv_a = cint(BANCS.OUTPARAM.Warning_num)
	print(sv_a)
	
	IF(sv_a > 0) THEN
	#{
		sv_d = 1
		WHILE (sv_d <= sv_a)
		#{
			sv_f = FORMAT$(sv_d,"%d")
			
			if(fieldexists(("BANCS").("OUTPARAM").("WarningMesg_"+sv_f)) == 1) then
			#{
				sv_e = ("BANCS").("OUTPARAM").("WarningMesg_"+sv_f)
				print(sv_e)
				#}
			else
				#{
				EQSRV.GLBDATA.WarnMsg	=	EQSRV.GLBDATA.WarnMsg	 + " Unable to print warning."
				print(EQSRV.GLBDATA.WarnMsg)
			#}
			endif
			
			#{
			sv_g = "echo The Warning message is :" + EQSRV.GLBDATA.Quote + sv_e + EQSRV.GLBDATA.Quote
			sv_q = sv_g + " >> " + EQSRV.GLBDATA.LogFile
			print(sv_g)
			sv_a = SYSTEM(sv_g)
			print(sv_a)
			if(sv_a != 0) then
			#{
				sv_g = "echo 'Unable to capture the warning message. Please check the trace files!' >> " + EQSRV.GLBDATA.LogFile
				print(sv_g)
				sv_x = SYSTEM(sv_g)
				print(sv_x)
			#}
			endif
			#}
			EQSRV.GLBDATA.WarnMsg = EQSRV.GLBDATA.WarnMsg + ":"  + sv_e
			sv_d = sv_d + 1
		#}
		DO
	#}
	ENDIF
	
	#=====================================
	# For handling of Exception
	#=====================================
	
	IF(BANCS.OUTPARAM.Xcpn_num >= 1) THEN
	#{
		sv_q = ""
		sv_d = 1
		sv_x = BANCS.OUTPARAM.Xcpn_num
		
		#Changed for MB Compatibility
		EQSRV.GLBDATA.length = "0"
		
		WHILE((sv_d <= sv_x) AND (EQSRV.GLBDATA.length <= 1000))
		#{
			sv_f = FORMAT$(sv_d,"%d")
			sv_q = ("BANCS").("OUTPARAM").("XcpnCode_"+sv_f) + ":" +("BANCS").("OUTPARAM").("XcpnCodeType_"+sv_f)
			
			IF(("BANCS").("OUTPARAM").("XcpnCodeType_"+sv_f) == "E")THEN
			#{
				sv_q = sv_q + ":" + ("BANCS").("OUTPARAM").("XcpnDesc_"+sv_f)
			#}
			ENDIF
			
			sv_g = "echo The Exception message is :" + sv_q + " >> " + EQSRV.GLBDATA.LogFile
			print(sv_g)
			sv_a = SYSTEM(sv_g)
			print(sv_a)
			if(sv_a != 0) then
			#{
				sv_g = "echo 'Unable to capture the warning message. Please check the trace files!' >> " + EQSRV.GLBDATA.LogFile
				print(sv_g)
				sv_x = SYSTEM(sv_g)
				print(sv_x)
			#}
			endif
			
			sv_d = sv_d + 1
			
			EQSRV.GLBDATA.XcpnMsg = EQSRV.GLBDATA.XcpnMsg + ":" + sv_q
			EQSRV.GLBDATA.length = STRLEN(sv_q)
		#}
		DO
		
	#}
	ENDIF
	
	
	#======================================================
	# Accumilating the Error , Warning and XcnpMsg.
	#======================================================
	
	EQSRV.GLBDATA.SrvError= EQSRV.GLBDATA.SrvError + " Errors: " + EQSRV.GLBDATA.ErrorDet +  "|Warnings: " + EQSRV.GLBDATA.WarnMsg
	EQSRV.GLBDATA.SrvError = EQSRV.GLBDATA.SrvError + " '|XcpnMsg: " + EQSRV.GLBDATA.XcpnMsg
	print(EQSRV.GLBDATA.SrvError)
	
	ENDOFSCRIPT:
		
end-->
