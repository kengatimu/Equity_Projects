			sv_q = sv_q + "WHERE teller_id = ?SVAR "
			sv_q = sv_q + "AND sol_id = ?SVAR "
			sv_q = sv_q + "AND crncy_code =  ?SVAR "
			sv_q = sv_q + "AND denom_count IS NULL "
			sv_q = sv_q + "AND bank_id = ?SVAR "
			PRINT(sv_q)
			sv_z = urhk_dbSqlWithBind(sv_q)
			PRINT(sv_z)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + CUST.DENOM.tellerId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.solId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncy
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = "UPDATE custom.c_denm_mod "
			sv_q = sv_q + "SET denom_count = 0, "
			sv_q = sv_q + " lchg_time = sysdate, "
			sv_q = sv_q + " lchg_user_id = ?SVAR "
			sv_q = sv_q + "WHERE teller_id = ?SVAR "
			sv_q = sv_q + "AND sol_id = ?SVAR "
			sv_q = sv_q + "AND crncy_code = ?SVAR "
			sv_q = sv_q + "AND denom_count IS NULL "
			sv_q = sv_q + "AND bank_id =?SVAR "
			
			PRINT(sv_q)
			sv_z = urhk_dbSqlWithBind(sv_q)
			PRINT(sv_z)
			sv_z = urhk_dbSqlWithBind("commit")
			PRINT(CUST.DENOM.totalCash)
			PRINT(CUST.DENOM.cab)
			CUST.DENOM.difference = CDOUBLE(CUST.DENOM.totalCash) - (-CDOUBLE(CUST.DENOM.cab))
			PRINT(CUST.DENOM.difference)
			IF (CUST.DENOM.difference > 0) THEN
			#{
				PRINT("debit cash account AND credit suspense account")
				CUST.DENOM.Parttran = "D"
				CUST.DENOM.round_off_amt = CDOUBLE(CUST.DENOM.difference)
				#}
			ELSE
				#{
				IF (CUST.DENOM.difference < 0) THEN
				#{
					PRINT("credit cash account AND debit suspense account")
					CUST.DENOM.Parttran = "C"
					CUST.DENOM.round_off_amt = -(CDOUBLE(CUST.DENOM.difference))
					#}
				ELSE
					#{
					CUST.DENOM.round_off_amt = "0"
				#}
				ENDIF
			#}
			ENDIF
			
			PRINT(CUST.DENOM.round_off_amt)
			CUST.DENOM.value_date = LEFT$(BANCS.STDIN.BODDate, 10)
			PRINT(CUST.DENOM.value_date)
			
			IF (CUST.DENOM.round_off_amt == "0") THEN
			#{
				#CUST.DENOM.MESSAGE = urtn_getMsg("V201163")
				#print(CUST.DENOM.MESSAGE)
				CUST.DENOM.MESSAGE = "Successfully Modified"
				sv_c = urhk_SetOrbOut("RESULT_MSG|"+CUST.DENOM.MESSAGE)
				PRINT(sv_c)
				GOTO AUDIT
