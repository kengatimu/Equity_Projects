#---------------------------------------------------------------------------------    
#	Name			: cfansmn001.scr
#	Description		: It validates the sol id and old number fields.
#					: and gets the new account number for the old account number
#					: passed through frontend.
#	Date			: 04-02-2013
#	Author			: GOKULKRISHNA
#	Input			: NA
#	Output			: NA
#	Called Script		:
#	Calling Scrip		: NA
#	Menu Option		: CFANS
#	Srl. No			Date			Author			Description.
#	-------			---------		-------			---------------
#	1.0				04-02-2013		GOKULKRISHNA			Original Version
#----------------------------------------------------------------------------------
<--START
CHECKSUM="3701e3a93d8fe8b053eff06acf81f8ccba2f28c87945412550f5ac38a5ffdd3f"
	TRACE ON
	
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	print(BANCS.INPUT.solID)
	print(BANCS.INPUT.OldNumber)
	print(BANCS.INPUT.userID)
	
	IF (BANCS.INPUT.solID == "") THEN
	#{
		sv_e = "Please Enter Sol Id "
		sv_m = "solID"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate old number field
	#---------------------------------------------------------------------------
	IF (BANCS.INPUT.OldNumber == "") THEN
	#{
		sv_e = "Please Enter Old Account Number"
		sv_m = "OldNumber"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	# -------------------------------------------------------------------------------
	#	Serching for the finacle account
	# -------------------------------------------------------------------------------
	sv_s = "finAcctNum|SELECT foracid "
	sv_s = sv_s + " FROM CUSTOM.OLD_ACCT_MAP "
	sv_s = sv_s + " WHERE old_num = ?SVAR "
	sv_s = sv_s + " AND sol_id = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.OldNumber + "|" + BANCS.INPUT.solID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0) THEN
	#{
		print("old acct num")
		CUST.DATA.finAcctNum = BANCS.OUTPARAM.finAcctNum
		sv_s = "finAcctName|SELECT ACCT_NAME "
		sv_s = sv_s + " FROM tbaadm.gam "
		sv_s = sv_s + " WHERE foracid = ?SVAR"
		sv_s = sv_s + " AND del_flg ='N'"
		#sv_s = sv_s + " AND entity_cre_flg = 'Y'"
		#sv_s = sv_s + " AND acct_cls_flg ='N'"
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.finAcctNum + "|" + BANCS.STDIN.contextBankId
		sv_r = urhk_dbselectWithBind(sv_s)
		print (sv_r)
		IF (sv_r == 0) THEN
		#{
			CUST.DATA.finAcctName = BANCS.OUTPARAM.finAcctName
			sv_g = "RESULT_MSG|THE NEW FINACLE NO. FOR "+ BANCS.INPUT.OldNumber + " IS: <b>"+CUST.DATA.finAcctNum+ "</b> ACCOUNT NAME : <b>" + CUST.DATA.finAcctName +"</b>"
			print(sv_g)
			sv_z = urhk_SetOrbOut(sv_g)
			print(sv_z)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			#}
		ELSE
			#{
			sv_e = "No Matching Record In GAM"
			sv_m = "OldNumber"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		#}
		ENDIF
		
		#}
	ELSE
		#{
		sv_e = "No Matching Record for the Old Account Number"
		sv_m = "OldNumber"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------------
	# Deleting the Class and Repository
	#-------------------------------------------------------------------------------------------------------
	IF (CLASSEXISTS("CUST","DATA") == 1) THEN
	#{
		DELETECLASS("CUST","DATA")
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 1) THEN
	#{
		DELETEREP("CUST")
	#}
	ENDIF
	
	TRACE OFF
END-->
