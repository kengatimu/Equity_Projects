					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			sv_s = "ACCT_OWNERSHIP|SELECT ACCT_OWNERSHIP FROM tbaadm.gam "
			sv_s = sv_s + "WHERE bank_id = ?SVAR "
			sv_s = sv_s + "AND FORACID = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.HOCCM.critCrAcctNum
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				CUST.HOCCM.ACCT_OWNERSHIP=BANCS.OUTPARAM.ACCT_OWNERSHIP
				print(CUST.HOCCM.ACCT_OWNERSHIP)
				IF ((CUST.HOCCM.ACCT_OWNERSHIP == "O") AND (BANCS.STDIN.mySolId != "000")) THEN
				#{
					IF ((BANCS.STDIN.userWorkClass != "150") AND (BANCS.STDIN.userWorkClass != "200")) THEN
					#{
						CUST.HOCCM.errorMsg = "User work class not allowed to release cheques in Office A/cs "
						CUST.HOCCM.fieldName = "abc"
						CUST.HOCCM.successFlg = "F"
						CUST.INTERFACE.srvErrFlg ="N"
						sv_u = urhk_dbSqlWithBind("ROLLBACK")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
		#}
		ENDIF
		
		IF (((BANCS.STDIN.contextBankId == "54")OR (BANCS.STDIN.contextBankId == "43")) AND ((BANCS.STDIN.roleId=="BAC3") OR (BANCS.STDIN.roleId=="BAC1")OR (BANCS.STDIN.roleId=="BAC2"))) THEN
		#{
			CUST.HOCCM.errorMsg = "User Role Not Allowed to Release Cheques"
			CUST.HOCCM.fieldName = "abc"
			CUST.HOCCM.successFlg = "F"
			CUST.INTERFACE.srvErrFlg ="N"
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			call("hoccmdp009.scr")
		#}
		ENDIF
	#}
	ENDIF
	# Representment mode
	IF (CUST.HOCCM.funcCode=="P") THEN
	#{
		call("hoccmdp003.scr")
	#}
	ENDIF
	IF (CUST.HOCCM.successFlg == "F") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.OUTPUT.SuccessOrFailure = "S"
	sv_w = ""
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_u = urhk_SetOrbOut("RESULT_MSG|<font color=black>" + CUST.HOCCM.resultPageMsg)
	ENDOFSCRIPT:
		IF ((CUST.HOCCM.successFlg == "F") AND (CUST.INTERFACE.srvErrFlg !="Y")) THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			sv_w = "SUCCESSORFAILURE|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_z = "Error_0|ERROR^" + CUST.HOCCM.errorMsg + "^" + CUST.HOCCM.fieldName
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.HOCCM.successFlg = "F"
		#}
		ENDIF
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","HOCCM") != 0) THEN
		#{
			DELETECLASS ("CUST","HOCCM")
		#}
		ENDIF
		IF (CLASSEXISTS("CUST","INTERFACE") != 0) THEN
		#{
			DELETECLASS ("CUST","INTERFACE")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
