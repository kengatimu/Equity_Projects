	#{
		CUST.HOCCM.limAmt = "500000"
		CUST.HOCCM.limAmt =  FORMAT$(CDOUBLE(CUST.HOCCM.limAmt),"%.2f")
		PRINT(CUST.HOCCM.limAmt)
		CUST.HOCCM.totalCrAmt =  FORMAT$(CDOUBLE(CUST.HOCCM.totalCrAmt),"%.2f")
		print(CUST.HOCCM.totalCrAmt)
		
		IF ((BANCS.STDIN.contextBankId == "54")  OR (BANCS.STDIN.contextBankId == "43"))THEN
		#{
			IF ((BANCS.STDIN.userWorkClass == "110") AND ((BANCS.STDIN.roleId=="CAO1") OR (BANCS.STDIN.roleId=="CAO2")OR (BANCS.STDIN.roleId=="CAO3"))) THEN
			#{
				IF (cdouble(CUST.HOCCM.totalCrAmt) > cdouble(CUST.HOCCM.limAmt)) THEN
				#{
					CUST.HOCCM.errorMsg = "User WorkClass not allowed to Release cheques above Kes. 500000"
