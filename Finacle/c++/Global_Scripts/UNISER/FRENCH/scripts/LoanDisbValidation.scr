#----------------------------------------------------------------------------------------------------------
# Filename              :       LoanDisbValidation.scr
# Author                :       Dileep Rajan
# Description           :       This script will validate the credit account
# Input                 :       Account ID
# Output                :
# Called Script         :       None
# Calling Script        :
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="dc4fe6389b6fa0c7b594e9565882942d9843bfd7431712240eb49a15ffeb82fc"
	
	TRACE ON
	
	#sv_a = urhk_b2k_printRepos("BANCS")
	sv_a = urhk_b2k_printRepos("CUST")
	
	#######--------------------------------------------------------------##########
	#### Getting the currencyLoan and scheme code for the Credit account no ##
	#######--------------------------------------------------------------##########
	sv_s = "currencyCrId,crSolId,custIDCR,crSchmType,crschmcode "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT acct_crncy_code,sol_id,cif_id,schm_type,schm_code "
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE foracid = ?SVAR "
	sv_s = sv_s + " AND entity_cre_flg='Y' "
	sv_s = sv_s + " AND del_flg='N'"
	sv_s = sv_s + " AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.LADIS.CrId + "|" + BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0) THEN
	#{
		print(BANCS.OUTPARAM.currencyCrId)
		print(BANCS.OUTPARAM.crSolId)
		print(BANCS.OUTPARAM.custIDCR)
		print(BANCS.OUTPARAM.crSchmType)
		print(BANCS.OUTPARAM.crschmcode)
		CUST.LADIS.crSolId = BANCS.OUTPARAM.crSolId
		CUST.LADIS.custIDCR = BANCS.OUTPARAM.custIDCR
		CUST.LADIS.currencyCrId = BANCS.OUTPARAM.currencyCrId
		CUST.LADIS.crSchmType = BANCS.OUTPARAM.crSchmType
		CUST.LADIS.crschmcode = BANCS.OUTPARAM.crschmcode
		
	IF(BANCS.STDIN.contextBankId !="43") THEN
		IF((CUST.LADIS.laSolId != CUST.LADIS.crSolId) AND (CUST.LADIS.crschmcode!="SB190"))THEN
		#{
			sv_a = " Credit account should be of same sol as Loan account sol "
			sv_u = urhk_SRV_SetErr(sv_a)
			exitscript
			
		#}
		ENDIF
	ENDIF

		IF(CUST.LADIS.laCifId != CUST.LADIS.custIDCR ) THEN
		#{
			sv_a = " Credit account belongs to different customer "
			sv_u = urhk_SRV_SetErr(sv_a)
			exitscript
		#}
		ENDIF
		
		
		IF((CUST.LADIS.crSchmType == "LAA") OR (CUST.LADIS.crSchmType == "BIA") OR (CUST.LADIS.crSchmType == "FBA") OR (CUST.LADIS.crSchmType == "HOC") OR (CUST.LADIS.crSchmType == "OSP") OR (CUST.LADIS.crSchmType == "PCA") OR (	CUST.LADIS.crSchmType == "TDA")) THEN
		#{
			sv_a = "The account is not in the required Scheme List "
			sv_a = sv_a + " [SBA','CAA','ODA','CCA','DDA','OAB','OAP] OR it does not exist."
			sv_u = urhk_SRV_SetErr("Invalid Account Number ["+ sv_a + "]")
			exitscript
			
		#}
		ENDIF
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Invalid Account Number ["+ CUST.LADIS.CrId + "]")
		exitscript
		
	#}
	ENDIF
	
END-->
