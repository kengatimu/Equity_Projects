#  This is the Mahareport for Balance Sheet Consolidated 
###############################################################################
RECORDLAYOUT
###############################################################################
hom_cny                                      numbertype
gl_sub_head_code	                     numbertype 
gl_code                                      numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript    			               stringType
lv_setid       				       stringType  
lv_setdesc    				       stringType
total						numbertype
flag 						numbertype
flag1                                            numbertype
flag2                                            numbertype
flag3                                            numbertype
flag4                                            numbertype
flag5                                            numbertype
flag6                                            numbertype
flag7                                            numbertype
flag8                                            numbertype
flag9                                            numbertype
flag10                                            numbertype
flag11                                           numbertype
flag12                                            numbertype
flag13                                            numbertype
flag14                                            numbertype
flag15                                            numbertype
flag16                                            numbertype
flag17                                            numbertype
flag18                                            numbertype
flag19                                            numbertype
flag20                                            numbertype
flag21                                            numbertype
flag22                                            numbertype
flag23						  numbertype
flag24                                            numbertype
flag25						  numbertype 
################################################################################
GROUPANDSORT
###############################################################################
gl_code,gl_sub_head_code
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
############################################################################
#IGNORERECORD
###########################################################################
###############################################################################
PAGEFORMAT
##############################################################################
ColumnsPerLine   84 
LinesPerPage     55 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "EQUITY BANK LIMITED"  column 1 size 80 center
nextline
print  "Branch: "   column 1 size 80 center
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 1 size 80 center  
nextline
nextline
print   "Balance Sheet Summary"  column 1 size 80 center  
nextline
nextline
print asondate column 1 size 80 center   
nextline
nextline
separatorline 
print "Particulars"  column 09
print "Balance (KES)" column 70 
separatorline
print "ASSETS"		column 09
separatorline
set total   = 0      
set flag = 0        
set flag1 = 0 
set flag2 = 0 
set flag3 = 0 
set flag4 = 0 
set flag5 = 0 
set flag6 = 0 
set flag7 = 0 
set flag8 = 0 
set flag9 = 0 
set flag10 = 0 
set flag11 = 0 
set flag12 = 0 
set flag13 = 0 
set flag14 = 0      
set flag15 = 0 
set flag16 = 0 
set flag17 = 0 
set flag18 = 0 
set flag19 = 0 
set flag20 = 0 
set flag21 = 0 
set flag22 = 0 
set flag23 = 0
set flag24 = 0
set flag25 = 0
end
#############################################################################
AFTERBREAKOF gl_code 
#############################################################################
execute afterBreakof
#############################################################################
ONEVERYRECORD
#############################################################################
set total = total + hom_cny
if (flag23 = 0)
begin
        if(gl_code = 30.1)
        begin
                separatorline
                print "TOTAL ASSETS" column 03
                print total column 63 size 20 autocomma precision 2
		set total = 0
                separatorline
                nextline
                separatorline
                print "LIABILITIES" column 03
                separatorline

		set flag23 = 1
        end
end

###############################################################################
ONENDOFREPORT
###############################################################################
begin
nextline
separatorline
print   "TOTAL LIABILITIES & CAPITAL"   column 03
print total  column 63 size 20 autocomma precision 2
separatorline
end
##############################################################################
PROCEDURE afterBreakof
###############################################################################
begin
print groupSum hom_cny column 63 size 20 autocomma precision 2
if (flag = 0)
begin
	if(gl_code = 10)
	begin
        	print "CASH" column 03
		set flag = 1
	end
end

if (flag1 = 0)
begin
        if(gl_code = 11)
        begin
                print "BANK  BALANCES" column 03
                set flag1 = 1
        end
end

if (flag2 = 0)
begin
        if(gl_code = 12)
        begin
                print "INVESTMENTS" column 03
                set flag2 = 1
        end
end

if (flag3 = 0)
begin
        if(gl_code = 13.1)
        begin
                print "DEBTORS / PREPAYMENTS" column 03
                set flag3 = 1
        end
end

if (flag4 = 0)
begin
        if(gl_code = 13.2)
        begin
                print "INTEREST RECEIVABLE" column 03
                set flag4 = 1
        end
end

if (flag5 = 0)
begin
        if(gl_code = 14)
        begin
                print "STOCKS" column 03
                set flag5 = 1
        end
end

if (flag6 = 0)
begin
        if(gl_code = 15)
        begin
                print "ADVANCES" column 03
                set flag6 = 1
        end
end

if (flag7 = 0)
begin
        if(gl_code = 16)
        begin
                print "CONTIGENT ASSETS" column 03
                set flag7 = 1
        end
end

if (flag8 = 0)
begin
        if(gl_code = 17)
        begin
                print "INTANGIBLE ASSETS" column 03
                set flag8 = 1
        end
end

if (flag9 = 0)
begin
        if(gl_code = 18)
        begin
                print "Fixed Assets" column 03
                set flag9 = 1
        end
end

if (flag10 = 0)
begin
        if(gl_code = 19)
        begin
                print "OTHER ASSETS" column 03
                set flag10 = 1
        end
end

if (flag11 = 0)
begin
        if(gl_code = 30.1)
        begin
		print "CURRENT LIABILITIES" column 03
                set flag11 = 1
        end
end

if (flag12 = 0)
begin
        if(gl_code = 30.2)
        begin
                print "MARGINS HELD" column 03
                set flag12 = 1
        end
end

if (flag13 = 0)
begin
        if(gl_code = 31.1)
        begin
                print "ACCRUED INTEREST ON DEPOSITS" column 03
                set flag13 = 1
        end
end

if (flag14 = 0)
begin
        if(gl_code = 31.2)
        begin
                print "UNEARNED INTEREST INCOME" column 03
                set flag14 = 1
        end
end

if (flag24 = 0)
begin
        if(gl_code = 31.3)
        begin
                print "BANKER's CHEQUES" column 03
                set flag14 = 1
        end
end


if (flag15 = 0)
begin
        if(gl_code = 32.1)
        begin
                print "PROVISIONS" column 03
                set flag15 = 1
        end
end

if (flag16 = 0)
begin
        if(gl_code = 32.2)
        begin
                print "PROVISION ON DEPRECIATION" column 03
                set flag16 = 1
        end
end

if (flag17 = 0)
begin
        if(gl_code = 33)
        begin
                print "SUSPENDED INTEREST" column 03
                set flag17 = 1
        end
end

if (flag18 = 0)
begin
        if(gl_code = 34)
        begin
                print "Taxes" column 03
                set flag18 = 1
        end
end


if (flag19 = 0)
begin
        if(gl_code = 35)
        begin
                print "DEPOSITS" column 03
                set flag19 = 1
        end
end

if (flag20 = 0)
begin
        if(gl_code = 36)
        begin
                print "Contigent Liabilities" column 03
                set flag20 = 1
        end
end

if (flag21 = 0)
begin
        if(gl_code = 50.1)
        begin
                print "CORE CAPITAL & RESERVES" column 03
                set flag21 = 1
        end
end

if (flag22 = 0)
begin
        if(gl_code = 50.2)
        begin
                print "GRANTS/OTHER RESERVES" column 03
                set flag22 = 1
        end
end

if (flag25 = 0)
begin
        if(gl_code = 100)
        begin
                print "Profit & Loss Control Account" column 03
                set flag25 = 1
        end
end

end
