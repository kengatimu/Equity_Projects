###############################################
ONEVERYRECORD
###############################################
# REPORT FLAG A - LOANS
if (rptflg="A") and (class="NORM1")
begin
set normcnt = normcnt + 1
set normamt = normamt + accbal
end

if (rptflg="A") and (class="WATCH")
begin
set watchcnt = watchcnt + 1
set watchamt = watchamt + accbal
end

if (rptflg="A") and (class="SUB2")
begin
set substcnt = substcnt + 1
set substamt = substamt + accbal
end

if (rptflg ="A") and (class = "DBT1")
begin
set doubtcnt = doubtcnt + 1
set doubtamt = doubtamt + accbal
end

#REPORT FLAG B - DISCOUNTED BILLS

if (rptflg ="B") and (class ="WATCH")
begin
set watchcntb = watchcntb + 1
set watchamtb = watchamtb + accbal
end

if (rptflg ='B') and (class ="SUB2")
begin
set substcntb = substcntb + 1
set substamtb = substamtb + accbal
end

if (rptflg ="B") and (class ="DBT1")
begin
set doubtcntb = doubtcntb + 1
set doubtamtb = doubtamtb + accbal
end

if (rptflg ="B") and (class ="LOSS")
begin
set losscntb = losscntb + 1
set lossamtb = lossamtb + accbal
end

if (rptflg ="B") and (class ="NORM1")
begin
set normcntb = normcntb + 1
set normamtb = normamtb + accbal
end

#REPORT FLAG C - OVERDRAFTS

if (rptflg ="C") and (class ="WATCH")
begin
set watchcnto = watchcnto + 1
set watchamto = watchamto + accbal
end

if (rptflg ="C") and (class ="SUB2")
begin
set substcnto = substcnto + 1
set substamto = substamto + accbal
end

if (rptflg ="C") and (class ="DBT1")
begin
set doubtcnto = doubtcnto + 1
set doubtamto = doubtamto + accbal
end

if (rptflg ="C") and (class ="LOSS")
begin
set losscnto = losscnto + 1
set lossamto = lossamto + accbal
end


