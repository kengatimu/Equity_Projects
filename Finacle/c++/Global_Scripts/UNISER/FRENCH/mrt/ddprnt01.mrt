nextline
nextline
nextline
print "                           " 
print amt_str  column 135 size 20  rightjustify
nextline
print payee_name_1 column 7 
nextline
print payee_name_2 column 7 
nextline
nextline
if ( dd_amt < 1 )
 begin
  print "NIL" column 21
  print s1 column 25
 end
else
 begin
# nextline
print "                           "
 print s1 column 35
end
if ( deplen1 <= 40 )
begin
 if ( deplen2 = 0 )
  begin
   if ( deplen1 < 35 )
    begin
     print "Only"
    end
   else
   begin
    nextline
    print "Only"
   end
  end
end
nextline
nextline
print s2 column 10
if ( deplen2 > 0 )
begin
 if ( deplen3 = 0 )
 begin
  if ( deplen2 < 40 )
  begin
   print "Only"
  end
  else
  begin
   nextline
   print "Only"
  end
 end
end
nextline
print s3 column 10
if ( deplen3 > 0 )
begin
 print "Only"
end	
