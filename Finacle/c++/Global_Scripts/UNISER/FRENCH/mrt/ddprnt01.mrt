RECORDLAYOUT
$$$include ddprnt.mri

LOCALVARIABLES
amt_in_words    stringType
s1              stringType
s2              stringType
s3              stringType
deplen0         numberType
deplen1         numberType
deplen2         numberType
deplen3         numberType
loclen          numberType	

GROUPANDSORT
alreadySorted
    
PAGEFORMAT
LinesPerPage 22 
Topmargin	0
BottomMargin 2
columnsPerLine 200
pageHeaderLines 0 
pageFooterLines 0

REPOSITORY argv4
PAGE_NUMBER					numberType

ONSTARTOFREPORT
set pageNumber = 1

PAGEHEADER

PAGEFOOTER
	

ONEVERYRECORD
#Added for font reduction
print "</pre>"
nextline
print "<br/>"
nextline
print "<pre>"
nextline
print "<font face ='Arial'  size='2'>"
set amt_in_words = crncyNumToWords dd_amt decimal_desc
set s1 = splitstring amt_in_words 1 60
set deplen1 = strlen s1
set deplen0 = deplen1 + 1
set s2 = splitstring amt_in_words deplen0 70
set deplen2 = strlen s2
set deplen0 = deplen1 + deplen2 + 1
set s3 = splitstring amt_in_words deplen0 76
set deplen3 = strlen s3	
