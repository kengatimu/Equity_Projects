###############################################################################
RECORDLAYOUT
###############################################################################
sol_id              stringtype
foracid             stringtype
amt                 stringtype
ind                 stringtype
crncy               stringtype
tran_part_1         stringtype
bodDate             stringtype

###############################################################################
LOCALVARIABLES
###############################################################################
sol_lpad                stringtype
for_lpad                stringtype
clr_lpad                stringtype
takataka                stringtype
taka_lp                 stringtype
trap_lpad               stringtype
tran_part_2             stringtype
part_amt                numbertype
part_amt_str            stringtype
amt_2                   numbertype
off_acct_1              stringtype 
off_acct_2              stringtype
indrev                  stringtype
intDeff                 stringtype

##############################################################################
GROUPANDSORT
###############################################################################
###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine              98
LinesPerPage                100000 
LeftMargin                   00
RightMargin                  00
Topmargin                    00
BottomMargin                 00
pageHeaderLines              00
pageFooterLines              00

##############################################################################
ONEVERYRECORD
##############################################################################
set for_lpad = rpad foracid 16 " "
print for_lpad size 16 column 1

print crncy column 17

set clr_lpad = rpad amt 17 " "
print clr_lpad size 17 column 20

print bodDate size 10 column 37

set trap_lpad = rpad tran_part_1 30 "~"
print trap_lpad size 30 column 47

set intDeff = "N"
print intDeff size 1 column 97

##############################################################################
ONSTARTOFREPORT
##############################################################################
#set crncy = "KES"
set takataka = "~" 
#set tran_part_1 = "KPLC APRIL BILL COLLECTION FEE" 
##############################################################################
ONENDOFREPORT
##############################################################################
##############################################################################
PAGEHEADER
##############################################################################

