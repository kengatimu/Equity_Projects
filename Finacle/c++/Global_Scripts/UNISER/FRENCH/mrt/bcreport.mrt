##########################################################################
#	Report Name			: DDDTL
#	Template File Name	: dstDetail.mrt
#	Description 		: This MRT File will be used to print the Banker's 
#						  cheque Details. This will generate either 
#						  Reconcilied Banker's Cheque or Unpaid Banker's 
#						  Cheque details.
#	Modification log
#	----------------
#	Srl. No.	Date	Author	Description
#	-------		----	------	-----------
#	1.	     15-4-98	HVM	        Original version
#       2.	     03-01-2005 E.G.Karobia     Modification	 
##########################################################################
RecordLayout
##########################################################################
$$$include bcreport.mri
##########################################################################
LOCALVARIABLES
##########################################################################
GROUPANDSORT
##########################################################################
dd_status	
##########################################################################
REPOSITORY bankRepos.rip readonly
##########################################################################
bankName                stringType
branchName              stringType
##########################################################################
REPOSITORY argv4
##########################################################################
report_to               stringType
bc_flag					stringType
paid_flag				stringType
from_date				stringType
to_date					stringType
issue_bank_code			stringType
issue_br_code			stringType
#pye_bank_code			stringType
#pye_br_code				stringType
page_number     		numberType
##########################################################################
MASSAGERECORD
##########################################################################

##########################################################################
IGNORERECORD
##########################################################################

##########################################################################
PAGEFORMAT
##########################################################################
LinesPerPage 64
LeftMargin 2
rightMargin 2
Topmargin   2
BottomMargin 2
columnsPerLine 132
pageHeaderLines 12
pageFooterLines 2
IgnoreBlankRecord
##########################################################################
ONSTARTOFREPORT
##########################################################################
set pageNumber = 1
execute pageHeader
nextline
nextline
##########################################################################
PAGEHEADER
##########################################################################
execute pageHeader
##########################################################################
PAGEFOOTER
##########################################################################
separatorLine
##########################################################################
BEFOREBREAKOF dd_status
##########################################################################
	if dd_status = "P"
		begin
			print " DETAILS OF PAID DD's/BC's "	column 1 size 80 center
			nextline
			print " ------------------------- "	column 1 size 80 center
		end
	if dd_status = "U"
		begin
			print " DETAILS OF UNPAID DD's/BC's "   column 1 size 80 center
 			nextline
			print " --------------------------- "   column 1 size 80 center
		end
##########################################################################
ONEVERYRECORD
##########################################################################
set dd_num = ltrim dd_num " "
execute prntDetails
##########################################################################
ONENDOFREPORT
##########################################################################
execute prntEndOfReport
##########################################################################
PROCEDURE commonPageHdr
##########################################################################
print today     column 1
print bankName 	column 35 
print "Page:" column 65
print pageNumber column 71  precision 0
nextline
print branchName column 37 
nextLine
print "DD's/Banker's Cheque Reconciliation/Unpaid Report" column 20
nextline
print   "From date :  "  column 20
print	from_date size 10
print   "   "
print   "To  date :  " 	
print	to_date  size 10
nextline
##########################################################################
PROCEDURE pageHeader
##########################################################################
	execute commonPageHdr
	nextline
	separatorline
	nextline
	print "ISSUE"				column 17
#       print "PAYEE"				column 31
	nextline
	print "DD NUM"	 			column 1
	print "BANK/BRANCH"	 		column 14
#	print "PAYEE NAME"	 		column 29
	print "AMOUNT" 				column 80 
	print "CRN"         	    column 92
	print "ISSUE DATE"			column 97
	nextline
	separatorline
##########################################################################
PROCEDURE prntEndOfReport
##########################################################################
	if totalCount dd_amt = 0
		begin
			nextline
			print " *********   No Records Selected   ********" column 1 size 80 center
			nextline
		end
	nextLine
	print "********* END OF REPORT*********" 	column 1 size 80 center
	nextline
	print "Signature" 							size 12 column 80
	set page_number = pageNumber
##########################################################################
##########################################################################
PROCEDURE prntDetails
##########################################################################
	if (paid_flag != "N") 
		begin
			execute	prntPaidDetails
		end
	if (paid_flag != "Y") 
		begin
			execute prntUnpaidDetails
		end
##########################################################################
PROCEDURE prntPaidDetails
##########################################################################
	if dd_status = "P"
		begin
			print dd_num			size 10	column 1
			print issu_bank_code	size 6  rightJustify column 12
			print issu_br_code		size 6  leftJustify column 19
#			print payee_bank_code	size 6  rightJustify column 27
#			print payee_br_code		size 6  leftJustify column 34
			print payee_name	        column 24 size 40	
			print dd_amt			autocomma size 20 column 70
			print dd_crncy_code     size 3  column 92
			print issue_date		size 10	column 97
			nextline
		end
##########################################################################
PROCEDURE prntUnpaidDetails
##########################################################################
	if dd_status = "U"
		begin
			print dd_num			size 10	column 1
			print issu_bank_code	size 6  rightJustify column 12
			print issu_br_code		size 6  leftJustify column 19
#			print payee_bank_code	size 6  rightJustify column 27
#			print payee_br_code		size 6  leftJustify column 34
			print payee_name	        column 24 size 40	
			print dd_amt			autocomma size 20 column 70
			print dd_crncy_code     size 3  column 92
			print issue_date		size 10	column 97
			nextline
		end 
##########################################################################
#PROCEDURE printCriteria
##########################################################################
