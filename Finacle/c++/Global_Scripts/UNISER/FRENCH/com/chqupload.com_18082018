#Set POI_API_PATH to CLASSPATH
#echo $CLASSPATH
set -vx
#export CLASSPATH=./:$POI_API_PATH:$CLASSPATH
callType=$1
	# $2-xlsfile, $3-xmlfile, $4-datfile $5-resultxls
        $JAVA_HOME/bin/java upload.service.ExcelConvertor $2 $3 $4 $5 $6

i=`wc -l $4`
j=1
while [ $j -le $i ]
do
req=`head -$j $4|tail -1|cut -c1-11`
start=`head -$j $4|tail -1|cut -c128-137`
end=`head -$j $4|tail -1|cut -c138-147`
echo "UPDATE CUSTOM.CUSTOM_CBR SET REQ_STATUS='R',BEGIN_CHQ_NUM=rtrim('$start'),END_CHQ_NUM=rtrim('$end') WHERE BANK_ID='$7' AND REQ_ID=rtrim('$req');">>uploadxls.sql
echo "commit;">>uploadxls.sql
let j=$j+1
done

if [ -s uploadxls.sql ]
then
        echo "inside execute script">>file1.txt
                exebatch bauu9151 uploadxls.sql >>file1.txt
fi

