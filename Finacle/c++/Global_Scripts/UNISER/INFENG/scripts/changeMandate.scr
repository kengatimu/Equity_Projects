#------------------------------------------------------------------------------------------------
#  Name            : changeMandate.scr
#  Description     : add and remove signatory
#  Date            : 14-02-2022
#  Author          : James Maina
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             14-02-2022      James Maina		Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","SIG") == 0) THEN
        #{
                CREATECLASS("CUST","SIG",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)


	IF( (FIELDEXISTS(("BANCS").("INPUT").("FORACID"))== 0) ) THEN
   		CUST.SIG.errMsg="ACCOUNT TO CHANGE IS NULL"
		#sv_t = "executeFinacleScript_CustomData.ERROR | " +CUST.SIG.errMsg
		sv_t="ERROR| " + CUST.SIG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("SIGNATORYCIF"))== 0) ) THEN
   		CUST.SIG.errMsg="CIF OF THE SIGNATORY IS NULL"
		#sv_t = "executeFinacleScript_CustomData.ERROR | " +CUST.SIG.errMsg
		sv_t="ERROR| " + CUST.SIG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("FUNCTION"))== 0) ) THEN
	#{
		#Error response
   		CUST.SIG.errMsg="Kindly enter the function (ADD/REMOVE)"
		#sv_t = "executeFinacleScript_CustomData.ERROR | " +CUST.SIG.errMsg
		sv_t="ERROR| " + CUST.SIG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("USERID"))== 0) ) THEN
	#{
		#Error response
   		CUST.SIG.errMsg="Kindly enter the USERID"
		sv_t="ERROR| " + CUST.SIG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("checkerUSERID"))== 1) ) THEN
	#{
		CUST.SIG.checkerUSERID= BANCS.INPUT.checkerUSERID
		PRINT(CUST.SIG.checkerUSERID)


	#}
	ELSE
	#{
		CUST.SIG.checkerUSERID=""
		PRINT(CUST.SIG.checkerUSERID)

	#}
	ENDIF


	CUST.SIG.function = BANCS.INPUT.FUNCTION
	#CUST.SIG.function = "ADD"
	CUST.SIG.account = BANCS.INPUT.FORACID
	#CUST.SIG.account = "0120160597045"
	CUST.SIG.flag = "Y"
	CUST.SIG.code = "A"
	CUST.SIG.cif = BANCS.INPUT.SIGNATORYCIF
	#CUST.SIG.cif = "54300860583"
	CUST.SIG.USERID= BANCS.INPUT.USERID

	print(CUST.SIG.function)

	IF((CUST.SIG.function =="ADD") OR (CUST.SIG.function =="REMOVE"))THEN
	#{
		PRINT("OKEY")
	#}
	ELSE
	#{		
	   	CUST.SIG.errMsg="Function must be ADD or REMOVE"
		sv_t="ERROR| " + CUST.SIG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#-----------------------------------------------------------------------------
	#Check if userid is valid
	#-----------------------------------------------------------------------------
	sv_s="USERID|"
	sv_s = sv_s + " SELECT USER_ID FROM TBAADM.UPR WHERE  "
	sv_s = sv_s + " USER_ID=?SVAR "
	print(sv_s)

	BANCS.INPARAM.BINDVARS =  CUST.SIG.USERID
	print(BANCS.INPARAM.BINDVARS)

	sv_d = urhk_dbSelectWithBind(sv_s)

	IF(sv_d==0)THEN
	#{
		PRINT("valid user")
	#}
	ELSE
	#{
		CUST.SIG.errMsg="INVALID USERID " + CUST.SIG.USERID
		sv_t = "ERROR| " +CUST.SIG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT

	#}
	ENDIF

	IF(CUST.SIG.checkerUSERID !="")THEN
	#{

		#-----------------------------------------------------------------------------
		#Check if checker userid is valid
		#-----------------------------------------------------------------------------
		sv_s="count1|"
		sv_s = sv_s + " SELECT count(1) FROM TBAADM.UPR WHERE  "
		sv_s = sv_s + " USER_ID=?SVAR "
		print(sv_s)

		BANCS.INPARAM.BINDVARS =  CUST.SIG.checkerUSERID
		print(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d==0)THEN
		#{
			CUST.SIG.count1 = BANCS.OUTPARAM.count1
			PRINT(CUST.SIG.count1)
			IF (cint(CUST.SIG.count1)== 0) THEN
			#{
				CUST.SIG.errMsg="INVALID checkerUSERID " + CUST.SIG.checkerUSERID
				sv_t = "ERROR| " +CUST.SIG.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDOFSCRIPT
			#}
			ENDIF

		#}
		ENDIF	
	#}
	ENDIF



	#----------------------------------------------------------------------------------------------------------------------------
	#get refnum
	#-----------------------------------------------------------------------------------------------------------------------------
	sv_s = "refnum |"
	sv_s = sv_s + " SELECT TO_CHAR(TBAADM.TBA_ADT_REF_NUM_SEQ_54.NEXTVAL) FROM DUAL "

	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d==0)THEN
	#{
		PRINT(BANCS.OUTPARAM.refnum)	
		CUST.SIG.refnum= BANCS.OUTPARAM.refnum 
	#}
	ELSE
	#{
	   	GOTO ENDOFSCRIPT
	#}
	ENDIF

	

#################################REMOVE SIGNATORY####################################

	IF(CUST.SIG.function == "REMOVE")THEN
	#{
		sv_s = "ACID,STYPE, SOL,GLSUB|"
		sv_s = sv_s + " SELECT ACID,SCHM_TYPE,SOL_ID,GL_SUB_HEAD_CODE FROM TBAADM.GAM WHERE "
		sv_s = sv_s + "FORACID=?SVAR AND BANK_ID=?SVAR"

		BANCS.INPARAM.BINDVARS = CUST.SIG.account +"|"+ BANCS.STDIN.contextBankId
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d ==0) THEN
		#{
			PRINT(BANCS.OUTPARAM.ACID)	
			CUST.SIG.acid = BANCS.OUTPARAM.ACID

			PRINT(BANCS.OUTPARAM.STYPE)	
			CUST.SIG.STYPE= BANCS.OUTPARAM.STYPE

			PRINT(BANCS.OUTPARAM.SOL)	
			CUST.SIG.SOL= BANCS.OUTPARAM.SOL

			PRINT(BANCS.OUTPARAM.GLSUB)	
			CUST.SIG.GLSUB= BANCS.OUTPARAM.GLSUB

			sv_s = "COUNT|"
			sv_s = sv_s + " SELECT COUNT(*) FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "ACID=?SVAR AND BANK_ID=?SVAR AND ACCT_POA_AS_REC_TYPE='A'"

			BANCS.INPARAM.BINDVARS = CUST.SIG.acid +"|"+ BANCS.STDIN.contextBankId
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)		
			print(BANCS.OUTPARAM.COUNT)	
			CUST.SIG.count = BANCS.OUTPARAM.COUNT

			IF(CUST.SIG.count == 0)THEN
			#{
				CUST.SIG.msg1 = "No signatory for account " + CUST.SIG.account

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.SIG.msg1
				sv_t="MSG| " + CUST.SIG.msg1
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT	
			#}		
			ENDIF	

			#####Handle next print not null
			sv_s = "nextPrintDate|"
			sv_s = sv_s + " SELECT PS_NEXT_DUE_DATE FROM TBAADM.AST WHERE "
			sv_s = sv_s + " ACID=?SVAR AND BANK_ID=?SVAR"

			BANCS.INPARAM.BINDVARS = CUST.SIG.acid +"|"+ BANCS.STDIN.contextBankId		
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0)THEN
			#{
				PRINT(BANCS.OUTPARAM.nextPrintDate)	
				CUST.SIG.nextPrintDate= BANCS.OUTPARAM.nextPrintDate

			#}
			ELSE
			#{
				CUST.SIG.nextPrintDate=""
			#}
			ENDIF
	#}
	ENDIF	

	##############################################SBA ACCOUNTS##############################	
	IF(CUST.SIG.STYPE == "SBA")THEN
	#{

		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.SIG.account)
		PRINT(sv_u)
			
		sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)


		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)

			sv_s = "SERIALNUM|"
			sv_s = sv_s + " SELECT ACCT_POA_AS_SRL_NUM-1 FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "NMA_KEY_ID=?SVAR AND BANK_ID=?SVAR AND ACID=?SVAR AND DEL_FLG='N'"

			BANCS.INPARAM.BINDVARS = CUST.SIG.cif +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.SIG.acid

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				print(BANCS.OUTPARAM.SERIALNUM)	
				CUST.SIG.sn = BANCS.OUTPARAM.SERIALNUM
				print(CUST.SIG.sn)
				sv_e = CUST.SIG.sn
			#}
			ELSE
			#{
				#sending response to the user
				CUST.SIG.msg = "Signatory " + CUST.SIG.cif + " for account " +CUST.SIG.account + " is not found."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.SIG.msg
				sv_t="MSG| " + CUST.SIG.msg
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			ENDIF	

		
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.delFlg|"+ CUST.SIG.flag)
			#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.prefLangPoaAuthRemarks|"+ CUST.SIG.REMARKS)
			IF(CUST.SIG.nextPrintDate!="")THEN
			#{
				sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psNextPrintDate|"+BANCS.STDIN.BODDate)

			#}
			ENDIF
					
			sv_u = urhk_ExecSrv("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)

			IF (sv_u == 0) THEN
			#{
				print("SUCCESS")			
				#sending response to the user
				CUST.SIG.msg = "Signatory " + CUST.SIG.cif + " for account " +CUST.SIG.account + " has been removed successfully."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.SIG.msg
				sv_t="MSG| " + CUST.SIG.msg
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ELSE
			#{
					GOTO REMCHECKERROR
			#}
			ENDIF
 			CUST.SIG.tablekey = CUST.SIG.acid +"/" +BANCS.STDIN.mySolId + "/" + BANCS.STDIN.contextBankId
			PRINT(CUST.SIG.tablekey)

			IF(CUST.SIG.checkerUSERID !="")THEN
			#{
                		sv_a = "INSERT INTO TBAADM.TBA_AUDIT_TBL (ref_num,table_name,table_key,audit_srl_num,bank_id,audit_sol_id,acid,gl_sub_head_code,enterer_id,auth_id,rmks,audit_date, "
               			sv_a =sv_a+ " modified_fields_data,func_code,init_sol_id,audit_bod_date,caller_module,referral_id,auth_date,auth_bod_date,mop_id,calling_func_name,entity_id) "
                		sv_a =sv_a+ " VALUES ( ?SVAR , 'AAS' , ?SVAR , '002' , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , 'Record Deleted' ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'RECORD LOGICALLY DELETED|||' , 'D' , ?SVAR ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'O' , '' , "
                		sv_a =sv_a+ " TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'),TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'), '' , 'NAPI_ExecOrbScr' , '!' )"	
				PRINT(sv_a)		

                		BANCS.INPARAM.BINDVARS = CUST.SIG.refnum +"|"+CUST.SIG.tablekey +"|"+BANCS.STDIN.contextBankId+"|"+CUST.SIG.SOL +"|"+CUST.SIG.acid+"|"+CUST.SIG.GLSUB+"|"+CUST.SIG.USERID+"|"+CUST.SIG.checkerUSERID+"|"+BANCS.STDIN.sysDate+"|"+BANCS.STDIN.mySolId+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate
				PRINT(BANCS.INPARAM.BINDVARS)
                		sv_v = urhk_dbSQLWithBind(sv_a)   
                		IF(sv_v == 0)then
               	 		#{
					sv_x = urhk_dbSQLWithBind("COMMIT")
                		#}
				ELSE
				#{
					PRINT("FAILED TO INSERT RECORD TO ADT")
					GOTO ENDSCRIPT
				#}
               	 		ENDIF


			#}
			ELSE
			#{

                		sv_a = "INSERT INTO TBAADM.TBA_AUDIT_TBL (ref_num,table_name,table_key,audit_srl_num,bank_id,audit_sol_id,acid,gl_sub_head_code,enterer_id,auth_id,rmks,audit_date, "
               			sv_a =sv_a+ " modified_fields_data,func_code,init_sol_id,audit_bod_date,caller_module,referral_id,auth_date,auth_bod_date,mop_id,calling_func_name,entity_id) "
                		sv_a =sv_a+ " VALUES ( ?SVAR , 'AAS' , ?SVAR , '002' , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , 'Record Deleted' ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'RECORD LOGICALLY DELETED|||' , 'D' , ?SVAR ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'O' , '' , "
                		sv_a =sv_a+ " TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'),TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'), '' , 'NAPI_ExecOrbScr' , '!' )"	
				PRINT(sv_a)		

                		BANCS.INPARAM.BINDVARS = CUST.SIG.refnum +"|"+CUST.SIG.tablekey +"|"+BANCS.STDIN.contextBankId+"|"+CUST.SIG.SOL +"|"+CUST.SIG.acid+"|"+CUST.SIG.GLSUB+"|"+CUST.SIG.USERID+"|"+CUST.SIG.checkerUSERID+"|"+BANCS.STDIN.sysDate+"|"+BANCS.STDIN.mySolId+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate
				PRINT(BANCS.INPARAM.BINDVARS)
                		sv_v = urhk_dbSQLWithBind(sv_a)
                		IF(sv_v == 0)then
               	 		#{
					sv_x = urhk_dbSQLWithBind("COMMIT")
                		#}
				ELSE
				#{
					PRINT("FAILED TO INSERT RECORD TO ADT")
					GOTO ENDSCRIPT
				#}
               	 		ENDIF

			#}
			ENDIF


 

		#}
		ENDIF


	#}
	ENDIF


	#####################################################CAA ACCOUNT#############################################
	IF(CUST.SIG.STYPE == "CAA")THEN
	#{

		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.SIG.account)
		PRINT(sv_u)
			
		sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)


		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)

			sv_s = "SERIALNUM|"
			sv_s = sv_s + " SELECT ACCT_POA_AS_SRL_NUM-1 FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "NMA_KEY_ID=?SVAR AND BANK_ID=?SVAR AND ACID=?SVAR AND DEL_FLG='N'"

			BANCS.INPARAM.BINDVARS = CUST.SIG.cif +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.SIG.acid
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				print(BANCS.OUTPARAM.SERIALNUM)	
				CUST.SIG.sn = BANCS.OUTPARAM.SERIALNUM
				print(CUST.SIG.sn)
				sv_e = CUST.SIG.sn
			#}
			ELSE
			#{
				#sending response to the user
				CUST.SIG.msg = "Signatory " + CUST.SIG.cif + " for account " +CUST.SIG.account + " is not found."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.SIG.msg
				sv_t="MSG| " + CUST.SIG.msg
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			ENDIF	

		
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.delFlg|"+ CUST.SIG.flag)
			#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.prefLangPoaAuthRemarks|"+ CUST.SIG.REMARKS)
				
			sv_u = urhk_ExecSrv("SRV_ModifyCAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)

			IF (sv_u == 0) THEN
			#{
				print("SUCCESS")			
				#sending response to the user
				CUST.SIG.msg = "Signatory " + CUST.SIG.cif + " for account " +CUST.SIG.account + " has been removed successfully."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.SIG.msg
				sv_t="MSG| " + CUST.SIG.msg
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ELSE
			#{
					GOTO REMCHECKERROR
			#}
			ENDIF

 			CUST.SIG.tablekey = CUST.SIG.acid +"/" +BANCS.STDIN.mySolId + "/" + BANCS.STDIN.contextBankId
			PRINT(CUST.SIG.tablekey)

			IF(CUST.SIG.checkerUSERID !="")THEN
			#{
                		sv_a = "INSERT INTO TBAADM.TBA_AUDIT_TBL (ref_num,table_name,table_key,audit_srl_num,bank_id,audit_sol_id,acid,gl_sub_head_code,enterer_id,auth_id,rmks,audit_date, "
               			sv_a =sv_a+ " modified_fields_data,func_code,init_sol_id,audit_bod_date,caller_module,referral_id,auth_date,auth_bod_date,mop_id,calling_func_name,entity_id) "
                		sv_a =sv_a+ " VALUES ( ?SVAR , 'AAS' , ?SVAR , '002' , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , 'Record Deleted' ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'RECORD LOGICALLY DELETED|||' , 'D' , ?SVAR ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'O' , '' , "
                		sv_a =sv_a+ " TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'),TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'), '' , 'NAPI_ExecOrbScr' , '!' )"	
				PRINT(sv_a)		

                		BANCS.INPARAM.BINDVARS = CUST.SIG.refnum +"|"+CUST.SIG.tablekey +"|"+BANCS.STDIN.contextBankId+"|"+CUST.SIG.SOL +"|"+CUST.SIG.acid+"|"+CUST.SIG.GLSUB+"|"+CUST.SIG.USERID+"|"+CUST.SIG.checkerUSERID+"|"+BANCS.STDIN.sysDate+"|"+BANCS.STDIN.mySolId+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate
				PRINT(BANCS.INPARAM.BINDVARS)
                		sv_v = urhk_dbSQLWithBind(sv_a)
                		IF(sv_v == 0)then
               	 		#{
					sv_x = urhk_dbSQLWithBind("COMMIT")
                		#}
				ELSE
				#{
					PRINT("FAILED TO INSERT RECORD TO ADT")
					GOTO ENDSCRIPT
				#}
               	 		ENDIF


			#}
			ELSE
			#{

                		sv_a = "INSERT INTO TBAADM.TBA_AUDIT_TBL (ref_num,table_name,table_key,audit_srl_num,bank_id,audit_sol_id,acid,gl_sub_head_code,enterer_id,auth_id,rmks,audit_date, "
               			sv_a =sv_a+ " modified_fields_data,func_code,init_sol_id,audit_bod_date,caller_module,referral_id,auth_date,auth_bod_date,mop_id,calling_func_name,entity_id) "
                		sv_a =sv_a+ " VALUES ( ?SVAR , 'AAS' , ?SVAR , '002' , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , ?SVAR , 'Record Deleted' ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'RECORD LOGICALLY DELETED|||' , 'D' , ?SVAR ,TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS'), 'O' , '' , "
                		sv_a =sv_a+ " TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'),TO_DATE( ?SVAR ,'DD-MM-YYYY HH24:MI:SS'), '' , 'NAPI_ExecOrbScr' , '!' )"	
				PRINT(sv_a)		

                		BANCS.INPARAM.BINDVARS = CUST.SIG.refnum +"|"+CUST.SIG.tablekey +"|"+BANCS.STDIN.contextBankId+"|"+CUST.SIG.SOL +"|"+CUST.SIG.acid+"|"+CUST.SIG.GLSUB+"|"+CUST.SIG.USERID+"|"+CUST.SIG.checkerUSERID+"|"+BANCS.STDIN.sysDate+"|"+BANCS.STDIN.mySolId+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate+"|"+BANCS.STDIN.BODDate
				PRINT(BANCS.INPARAM.BINDVARS)
                		sv_v = urhk_dbSQLWithBind(sv_a)
                		IF(sv_v == 0)then
               	 		#{
					sv_x = urhk_dbSQLWithBind("COMMIT")
                		#}
				ELSE
				#{
					PRINT("FAILED TO INSERT RECORD TO ADT")
					GOTO ENDSCRIPT
				#}
               	 		ENDIF

			#}
			ENDIF

		#}
		ENDIF
		



	#}
	ENDIF


	REMCHECKERROR:
	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
