#----------------------------------------------------------------------------------------------------------
# Filename              :       Enroll.scr
# Author                :       Robert 
# Description           :       This script Inserts Student/Customer Details in custom.C_CIC table
# Input                 :       ACCTNUM, REFNUM, NAME, DEL_FLG, BANK_ID
                                                       
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           11-01-2014         Robert      Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
TRACE ON


####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository CUST and
#              creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
 #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class DATA in the
#repository and create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
#ELSE
	#{
	#	DELETECLASS("CUST","DATA")
	#	CREATECLASS("CUST","DATA",5)}
	#ENDIF
#}
ENDIF



IF( (FIELDEXISTS(("BANCS").("INPUT").("AcctNum"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Account Number"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("RefNum"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Reference Number"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)  
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("Names"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Client Names"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("DelFlag"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Flag Either  N or Y"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)  
   GOTO End
ENDIF



CUST.DATA.AcctNum=BANCS.INPUT.AcctNum
CUST.DATA.RefNum=BANCS.INPUT.RefNum
CUST.DATA.Names=BANCS.INPUT.Names
CUST.DATA.DelFlag=BANCS.INPUT.DelFlag
CUST.DATA.BankID=BANCS.STDIN.contextBankId




##############################################################
#Check to see if Account Number passed is Valid Finacle Account
###############################################################

  sv_s ="count|select  count(FORACID)  from tbaadm.gam where FORACID =?SVAR and bank_id=?SVAR"
  BANCS.INPARAM.BINDVARS=CUST.DATA.AcctNum + "|" + CUST.DATA.BankID
  print(BANCS.INPARAM.BINDVARS)
  sv_d = urhk_dbSelectWithBind(sv_s)

IF (BANCS.OUTPARAM.count !=1) THEN
   sv_e=urhk_SetOrbOut("Status|03") 
   sv_e=urhk_SetOrbOut("ErrMsg|Invalid Account")
   GOTO ENDOFSCRIPT
ENDIF



##############################################################
#Check to see if Ref Number Already Exist
###############################################################

  sv_s ="REFNUM|select  count(REFNUM)  from CUSTOM.C_CIC where REFNUM =?SVAR and bank_id=?SVAR and acctnum=?SVAR"
  BANCS.INPARAM.BINDVARS=CUST.DATA.RefNum + "|" + CUST.DATA.BankID + "|" + CUST.DATA.AcctNum
  print(BANCS.INPARAM.BINDVARS)
  sv_d = urhk_dbSelectWithBind(sv_s)

IF (BANCS.OUTPARAM.REFNUM !=0) THEN
   sv_e=urhk_SetOrbOut("Status|04") 
   sv_e=urhk_SetOrbOut("ErrMsg|Reference Number Already Exist")
   GOTO ENDOFSCRIPT
ENDIF

##############################################################
#Check to see if Flag passed is Valid i.e Either Y or N
###############################################################

IF ((CUST.DATA.DelFlag =="N") OR (CUST.DATA.DelFlag =="Y")) THEN
   GOTO continue
ELSE
   sv_e=urhk_SetOrbOut("Status|02") 
   sv_e=urhk_SetOrbOut("ErrMsg|Invalid DelFlag")
   GOTO ENDOFSCRIPT
ENDIF  

##############################################################
#IF all check are Success then Proceed to Insert
###############################################################

continue:
   sv_u = "Insert into CUSTOM.C_CIC (ACCTNUM, REFNUM, NAME, DEL_FLG, BANK_ID)"
   sv_u=sv_u + " Values ("
   sv_u = sv_u + " ?SVAR ,"
   sv_u = sv_u + " ?SVAR ,"
   sv_u = sv_u + " ?SVAR ,"
   sv_u = sv_u + " ?SVAR ,"
   sv_u = sv_u + " ?SVAR )" 


    BANCS.INPARAM.BINDVARS = CUST.DATA.AcctNum + "|" + CUST.DATA.RefNum + "|" + CUST.DATA.Names + "|" + CUST.DATA.DelFlag + "|" + CUST.DATA.BankID

 print(BANCS.INPARAM.BINDVARS)
 sv_e = urhk_dbSQLWithBind(sv_u)
 sv_f = urhk_dbSQLWithBind("commit")


  sv_e=urhk_SetOrbOut("Status|01")  
  sv_e=urhk_SetOrbOut("Msg|Success")  

ENDOFSCRIPT:
TRACE OFF
EXITSCRIPT
END-->
