                CREATECLASS("CUST", "RIMOD", 5)
                #}
        ELSE
                #{
                DELETECLASS("CUST", "RIMOD")
                CREATECLASS("CUST", "RIMOD", 5)
		#}
       ENDIF
        
		sv_q = urhk_B2k_PRINTRepos("BANCS")
		print(sv_q)
		
		
	 IF (FIELDEXISTS(("BANCS").("INPUT").("RIMOD_REQ.UserID")) == 1) THEN
        #{
                CUST.RIMOD.v_userid = ("BANCS").("INPUT").("RIMOD_REQ.UserID")
		print("Userid is")
		print(CUST.RIMOD.v_userid)
			
		sv_p = STRLEN(CUST.RIMOD.v_userid)
		PRINT(sv_p)
		IF (sv_p > 15 ) THEN
			PRINT("User Id cannot be greate than 15")
			sv_a = "RIMod_RES.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "RIMod_RES.ErrorMessage|User ID cannot be greater than 15 characters"
			sv_u = urhk_SetOrbOut(sv_b)
			EXITSCRIPT
		ENDIF
                
        #}
	ELSE
		sv_a = "RIMod_RES.Status|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "RIMod_RES.ErrorMessage|User ID is mandatory"
		sv_u = urhk_SetOrbOut(sv_b)
		EXITSCRIPT
			
	ENDIF
		
		
		
	IF (FIELDEXISTS(("BANCS").("INPUT").("RIMOD_REQ.BankID")) == 1) THEN
        #{
                CUST.RIMOD.v_BankID = ("BANCS").("INPUT").("RIMOD_REQ.BankID")
		print("Bank Id is")
		print(CUST.RIMOD.v_BankID)
				
		BANCS.INPARAM.BINDVARS = CUST.RIMOD.v_BankID 
		sv_s = "valBankID|"
		sv_s = sv_s + " SELECT bank_id"
		sv_s = sv_s + " FROM FINRIADM.BANK_MASTER_TABLE"
		sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
				
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
				
		IF (sv_d != 0) THEN
			
			sv_a = "RIMod_RES.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "RIMod_RES.ErrorMessage|Bank ID "+CUST.RIMOD.v_BankID +" is not a valid Bank ID "
			sv_u = urhk_SetOrbOut(sv_b)
					
			EXITSCRIPT
		ENDIF
                
        #}
	ELSE
			sv_a = "RIMod_RES.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "RIMod_RES.ErrorMessage|Bank ID is mandatory"
			sv_u = urhk_SetOrbOut(sv_b)
			EXITSCRIPT
			
	ENDIF
			
		
	IF (FIELDEXISTS(("BANCS").("INPUT").("RIMOD_REQ.RoleName")) == 1) THEN
        #{
				
		CUST.RIMOD.v_RoleName = ("BANCS").("INPUT").("RIMOD_REQ.RoleName")
		print("RoleName is")
		print(CUST.RIMOD.v_RoleName)
				
		##########  CHECK IF ROLE NAME EXISTS IN RDT TABLE  ##############
				
		BANCS.INPARAM.BINDVARS = CUST.RIMOD.v_RoleName + "|" + CUST.RIMOD.v_BankID
		sv_s = "valRoleName|"
		sv_s = sv_s + " SELECT role_name"
		sv_s = sv_s + " FROM FINRIADM.RDT"
		sv_s = sv_s + " WHERE UPPER(ROLE_NAME) =UPPER(?SVAR)"
		sv_s = sv_s + " AND BANK_ID = ?SVAR"
				
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
				
		IF (sv_d != 0) THEN
			
			sv_a = "RIMod_RES.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "RIMod_RES.ErrorMessage|No Role exists for this Role Name for Bank Id " +CUST.RIMOD.v_BankID 
			sv_u = urhk_SetOrbOut(sv_b)
					
			EXITSCRIPT
		ENDIF
				
		##########  GET ROLE_ID FOR PASSED ROLE_NAME AND BANK_ID  ##############
				
		BANCS.INPARAM.BINDVARS = CUST.RIMOD.v_RoleName + "|" + CUST.RIMOD.v_BankID
		sv_s = "valRoleID|"
		sv_s = sv_s + " SELECT role_id"
		sv_s = sv_s + " FROM FINRIADM.RDT"
		sv_s = sv_s + " WHERE UPPER(ROLE_NAME) =UPPER(?SVAR)"
		sv_s = sv_s + " AND BANK_ID = ?SVAR"
				
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
				
		IF (sv_d != 0) THEN
			sv_a = "RIMod_RES.Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "RIMod_RES.ErrorMessage|No Role exists for this Role Name and Bank Id combination"
			sv_u = urhk_SetOrbOut(sv_b)
			EXITSCRIPT
		ELSE
			CUST.RIMOD.v_RoleID = BANCS.OUTPARAM.valRoleID
				
		ENDIF
                
		print("RoleID is")
		print(CUST.RIMOD.v_RoleID)
                
        #}
	ELSE
		sv_a = "RIMod_RES.Status|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "RIMod_RES.ErrorMessage|Role Name is mandatory"
		sv_u = urhk_SetOrbOut(sv_b)
		EXITSCRIPT
			
	ENDIF
		
		
	################################ MODIFY VALUES IN UDT ##################################

	BANCS.INPARAM.BINDVARS = CUST.RIMOD.v_RoleID + "|" + CUST.RIMOD.v_userid  + "|" + CUST.RIMOD.v_BankID
	sv_s = "UPDATE FINRIADM.UDT SET ROLE_ID=?SVAR,TS_CNT = TS_CNT + 1 WHERE USER_ID=?SVAR AND BANK_ID=?SVAR"
        PRINT(sv_s)
        sv_d = urhk_dbSqlWithBind(sv_s)
        PRINT(sv_d)
        IF (sv_d != 0) THEN
        #{
		BANCS.OUTPUT.successOrFailure = "F"
		sv_a = "RIMod_RES.RIStatus|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "RIMod_RES.ErrorMessage|Update to UDT Failed"
		sv_u = urhk_SetOrbOut(sv_b)
		EXITSCRIPT
        #}
	ELSE
		sv_z = "RIMod_RES.RIStatus|SUCCESS"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "RIMod_RES.MESSAGE| "+ CUST.RIMOD.v_userid +" MODIFIED SUCCESSFULLY. "
		sv_u = urhk_SetOrbOut(sv_z)
	#}
	ENDIF
			
				
