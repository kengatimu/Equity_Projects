	sv_a = urhk_SetUrhkInp("custBuySellLimDet.isCustBuySellLimDetEntered|0")
	
		sv_u = urhk_ExecSrv("SRV_ModifyCoreCustomer|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)


	
	

	IF(sv_u == 0) THEN
	PRINT("Success")
	ELSE
