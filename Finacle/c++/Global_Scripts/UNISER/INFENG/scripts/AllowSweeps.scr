	IF(sv_u == 0) THEN
	PRINT("Success")
	print(BANCS.OUTPARAM.cookie1)
	CUST.CCFM.cookie1 = BANCS.OUTPARAM.cookie1
	print(CUST.CCFM.cookie1)

	print(BANCS.OUTPARAM.custFirstAcctDates)
	CUST.CCFM.custFirstAcctDates= BANCS.OUTPARAM.custFirstAcctDates
	print(CUST.CCFM.custFirstAcctDates)


	ELSE
	GOTO ERRORCHECK
	ENDIF
	
	
	########################################
	###### Detailed page
	########################################

	sv_a = urhk_SetUrhkInp("custGeneralDet.custId.cifId|"+CUST.CCFM.CIFID)
