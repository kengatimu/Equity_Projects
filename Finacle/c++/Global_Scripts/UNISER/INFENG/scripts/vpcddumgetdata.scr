<--start
trace on
if(repexists("CUST")==0)then
	createrep("CUST")
endif
if(classexists("CUST","DATA")==0)then
	createclass("CUST","DATA",5)
endif

CUST.DATA.errorFlg 		= "N"
CUST.DATA.errorMsg 		= " "
CUST.DATA.CrAcctId 		= ""
CUST.DATA.acctId = ""

sv_u = urhk_b2k_printrepos("BANCS")
print(sv_u)
if(fieldexists(BANCS.INPUT.Originator)==1)then
#{
	CUST.DATA.OrgCode = BANCS.INPUT.Originator 
else
	CUST.DATA.errorFlg = "Y"
	CUST.DATA.errorMsg = "Invalid Input for fnExecuteScript"
	GOTO ENDOFSCRIPT
#}
endif
if(fieldexists(BANCS.INPUT.functionCode)==1)then
#{
	CUST.DATA.functionCode = BANCS.INPUT.functionCode 
else
	CUST.DATA.errorFlg = "Y"
	CUST.DATA.errorMsg = "Invalid Input for fnExecuteScript"
	GOTO ENDOFSCRIPT
#}
endif

sv_s = "acctId,NameI | select acct_number,name from custom.CUST_EFTINOW_TBL where bank_id=?SVAR and del_flg='N' and entity_cre_flg='Y' and org_Code=?SVAR and rownum<=1 "
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.OrgCode  
print(BANCS.INPARAM.BINDVARS)

sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
if(sv_d == 0)then
#{
	CUST.DATA.acctId 	= BANCS.OUTPARAM.acctId
	CUST.DATA.NameI 		= BANCS.OUTPARAM.NameI
else
	CUST.DATA.errorFlg = "Y"
	CUST.DATA.errorMsg = "Invalid Account ID"
#}
endif


ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.DATA.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.DATA.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("CrAcctId|"+CUST.DATA.acctId)
		print(sv_u)
		
end-->
