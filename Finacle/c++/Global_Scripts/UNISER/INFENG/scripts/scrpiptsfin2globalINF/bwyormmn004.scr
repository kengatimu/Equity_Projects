		sv_g = "RESULT_MSG|Lodged bills uploaded successfully"
		sv_z = urhk_SetOrbOut(sv_g)
		
	#}
	ENDIF
	
	#--------------------------------------------------------------------
	#Updating the set Number in CREM table (entity_cre_flg='Y')
	#--------------------------------------------------------------------
	IF(CUST.DATA.funcCode=="I") THEN
	#{
		sv_g = "RESULT_MSG|Serial Number :"+ CUST.DATA.srlNum+" is Inquired."
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	IF(CUST.DATA.funcCode=="M") THEN
