		IF(sv_d==0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			sv_g = "RESULT_MSG|Serial Number :"+ CUST.DATA.srlNum+" is modified."
			sv_z = urhk_SetOrbOut(sv_g)
			#}
		ELSE
			#{
			sv_g = "RESULT_MSG|Serial Number :"+ CUST.DATA.srlNum+" could not be modified."
			sv_z = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------
	#deleting the set Number in CREM table
	#--------------------------------------------------------------------
	IF (CUST.DATA.funcCode=="D") THEN
	#{
		sv_s = "DELETE FROM CUSTOM.CREM"
		sv_s = sv_s + " WHERE bway_sequenceno = trim('" + CUST.DATA.srlNum + "')"
		sv_s = sv_s + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
		sv_d = urhk_dbSQLWithBind(sv_s)
		
		IF(sv_d==0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
