				sv_u="insert into custom.C_AMERCHANTS (CHANNEL_ID, MERCHANT_DESC, MERCHANT_ID,MERCH_PURCHASE_PAYABLE,"
				sv_u=sv_u + " MERCH_CASHBACK_PAYABLE, MERCH_COMM_PAYABLE,MERCH_SETTLEMENT_ACCOUNT,MERCH_CASHBACK_COMM, MERCH_PURCHASE_COMM, ENTERER_ID, "
				sv_u=sv_u + " ENTERER_DATE,VFD_USER_ID, VFD_DATE, AUDIT_BOD_DATE, AUDIT_SRL_NUM,FUNC_CODE,BANK_ID)"
				sv_u=sv_u + " select CHANNEL_ID, MERCHANT_DESC, MERCHANT_ID,MERCH_PURCHASE_PAYABLE,MERCH_CASHBACK_PAYABLE, MERCH_COMM_PAYABLE, MERCH_SETTLEMENT_ACCOUNT,"
				sv_u=sv_u + " MERCH_CASHBACK_COMM, MERCH_PURCHASE_COMM, ENTERER_ID, ENTERER_DATE, VFD_USER_ID, "
				sv_u=sv_u + " VFD_DATE, AUDIT_BOD_DATE, AUDIT_SRL_NUM,'A',BANK_ID   from custom.C_MODMERCHANTS Where BANK_ID = ?SVAR AND "
				sv_u=sv_u + " CHANNEL_ID =?SVAR"
				sv_u=sv_u + " AND MERCHANT_ID =?SVAR"
				sv_u=sv_u + " AND ENTITY_CRE_FLG='N' "
				print(sv_u)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.STABI.channeld + "|" +  CUST.STABI.posId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_w=urhk_dbsqlWithBind(sv_u)
				
				sv_w=urhk_dbsqlWithBind("COMMIT")
				print(sv_u)
				IF (sv_w != 0 ) THEN
				#{
					sv_e = "A Database error has occured. Please contact your DBA."
					sv_m = "RESULT_MSG|"
					sv_s = sv_m+sv_e
					sv_u = urhk_SetOrbOut(sv_s)
					exitscript
				#}
				ENDIF
				CUST.STABI.sysdate="sysdate"
				sv_u="update custom.C_MERCHANTS set VFD_USER_ID=?SVAR,"
				sv_u=sv_u + "VFD_DATE = " + CUST.STABI.sysdate + " "
				sv_u=sv_u + " Where CHANNEL_ID in ('CLD','HPD')"
				sv_u=sv_u + " AND MERCHANT_ID =?SVAR"
				sv_u=sv_u + " AND ENTITY_CRE_FLG='Y' "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" +  CUST.STABI.posId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_w=urhk_dbsqlWithBind(sv_u)
				
				sv_w=urhk_dbsqlWithBind("COMMIT")
				print(sv_u)
				BANCS.INPARAM.BINDVARS = ""
				
				IF (sv_w == 0 ) THEN
				#{
					sv_u="update custom.C_AMERCHANTS set VFD_USER_ID=?SVAR,"
					sv_u=sv_u + "VFD_DATE = " + CUST.STABI.sysdate + " "
					sv_u=sv_u + " Where CHANNEL_ID in ('CLD','HPD')"
					sv_u=sv_u + " AND MERCHANT_ID =?SVAR"
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" +  CUST.STABI.posId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_w=urhk_dbsqlWithBind(sv_u)
					
					print(BANCS.INPARAM.BINDVARS)
