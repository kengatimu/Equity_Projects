						print(sv_u)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.STABI.channeld + "|" +  CUST.STABI.posId
						print(BANCS.INPARAM.BINDVARS)
						
						sv_w=urhk_dbsqlWithBind(sv_u)
						sv_w=urhk_dbsqlWithBind("COMMIT")
						IF (sv_w != 0 ) THEN
