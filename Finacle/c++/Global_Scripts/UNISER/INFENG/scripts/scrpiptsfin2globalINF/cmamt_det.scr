		sv_u = sv_u + "select CHANNEL_ID, MERCHANT_DESC, MERCHANT_ID, MERCH_PURCHASE_PAYABLE, MERCH_CASHBACK_PAYABLE, MERCH_COMM_PAYABLE, MERCH_SETTLEMENT_ACCOUNT, MERCH_CASHBACK_COMM, MERCH_PURCHASE_COMM ,ENTERER_ID,  ENTERER_DATE, AUDIT_BOD_DATE, AUDIT_SRL_NUM from custom.C_MODMERCHANTS "
		sv_u = sv_u + " Where BANK_ID = ?SVAR AND CHANNEL_ID in ('CLD','HPD')"
		sv_u = sv_u + " AND MERCHANT_ID =?SVAR"
		sv_u = sv_u + " AND ENTITY_CRE_FLG='N' "
		print(sv_u)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.STABI.posId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_u)
		
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			sv_e = "Record verified OR doesn't exists......."
			sv_m = "TerminalPosId"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			exitscript
			
			#}
		ELSE
			#{
			
			CUST.STABI.ChannelD = BANCS.OUTPARAM.CHANNELID
			CUST.STABI.MerchantName = BANCS.OUTPARAM.MERCHANTDESC
			CUST.STABI.MerchantID = BANCS.OUTPARAM.MERCHANTID
			CUST.STABI.PurPayAccount = BANCS.OUTPARAM.MERCHPURCHASEPAYABLE
			CUST.STABI.CshPayAccount = BANCS.OUTPARAM.MERCHCASHBACKPAYABLE
			CUST.STABI.CshcomAccount = BANCS.OUTPARAM.MERCHCOMMPAYABLE
			CUST.STABI.SettlementAcnt = BANCS.OUTPARAM.MERCHSETTLEMENTACCOUNT
			CUST.STABI.Cashbackcomm = BANCS.OUTPARAM.MERCHCASHBACKCOMM
			CUST.STABI.Purchasecomm = BANCS.OUTPARAM.MERCHPURCHASECOMM
			CUST.STABI.ENTERERID = BANCS.OUTPARAM.ENTERERID
			CUST.STABI.ENTERERDATE = BANCS.OUTPARAM.ENTERERDATE
			CUST.STABI.AUDITBODDATE = BANCS.OUTPARAM.AUDITBODDATE
			CUST.STABI.AUDITSRLNUM = BANCS.OUTPARAM.AUDITSRLNUM
			
			
			sv_z = urhk_SetOrbOut("Channeld|"+ CUST.STABI.ChannelD)
			sv_z = urhk_SetOrbOut("Merchantsname|"+ CUST.STABI.MerchantName)
			sv_z = urhk_SetOrbOut("Purchasepayable|"+ CUST.STABI.PurPayAccount)
			sv_z = urhk_SetOrbOut("Cashbackpayable|"+ CUST.STABI.CshPayAccount)
			sv_z = urhk_SetOrbOut("Cashbackcommac|"+ CUST.STABI.CshcomAccount)
			sv_z = urhk_SetOrbOut("Settlement|"+ CUST.STABI.SettlementAcnt)
			sv_z = urhk_SetOrbOut("Cashbackcomm|"+ CUST.STABI.Cashbackcomm)
			sv_z = urhk_SetOrbOut("Purchasecomm|"+ CUST.STABI.Purchasecomm)
			
		#}
		ENDIF
		
		
		
		
		IF (CUST.STABI.confirm== "") THEN
		#{
			sv_e = "Enter Y OR N.."
			sv_m = "Confirm"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			exitscript
		#}
		ENDIF
		IF (CUST.STABI.confirm == "Y") THEN
		#{
			sv_u="insert into custom.C_MERCHANTS (CHANNEL_ID, MERCHANT_DESC, MERCHANT_ID, MERCH_PURCHASE_PAYABLE, "
			sv_u=sv_u + " MERCH_CASHBACK_PAYABLE, MERCH_COMM_PAYABLE,"
			sv_u=sv_u + " MERCH_SETTLEMENT_ACCOUNT,	MERCH_CASHBACK_COMM, MERCH_PURCHASE_COMM, ENTERER_ID, "
			sv_u=sv_u + " ENTERER_DATE, ENTITY_CRE_FLG, VFD_USER_ID, VFD_DATE, AUDIT_BOD_DATE, AUDIT_SRL_NUM, DEL_FLG,BANK_ID)"
			sv_u=sv_u + " select CHANNEL_ID, MERCHANT_DESC, MERCHANT_ID,  MERCH_PURCHASE_PAYABLE,MERCH_CASHBACK_PAYABLE, MERCH_COMM_PAYABLE, MERCH_SETTLEMENT_ACCOUNT,"
			sv_u=sv_u + " MERCH_CASHBACK_COMM, MERCH_PURCHASE_COMM, ENTERER_ID, ENTERER_DATE, 'Y', VFD_USER_ID, "
