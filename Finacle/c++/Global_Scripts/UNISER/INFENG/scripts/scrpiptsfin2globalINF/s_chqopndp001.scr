#-----------------------------------------------------------------------------------
#    Name				: s_chqopnmn001.scr
#    Description     	: In this script,during add and modify mode in TM, picks the details from dtd table
#						: for the instrument type present in c_cbt_int. then it picks the record from c_cbt for those cheques
#						: and updates the details for the cheque status for that record in C_CBT table.
#    Date            	: 15-03-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: NA
#    Menu Option		: HTM
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0			15-03-2013		Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="3ad5812a3f8d5eaf83c20b128a708e298e479ae22635fea5d17daa24699a19af"
	TRACE ON
	
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("ICHQ") == 0) THEN
	#{
		CREATEREP("ICHQ")
	#}
	ENDIF
	
	IF (CLASSEXISTS("ICHQ","UPDT") == 0) THEN
	#{
		CREATECLASS("ICHQ","UPDT",5)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
	ICHQ.UPDT.tran_id = BANCS.OUTPARAM.srvValue
	PRINT(ICHQ.UPDT.tran_id)
	
	BANCS.INPUT.moduleName  = "CHQOPN"
	BANCS.INPUT.parameterId = "NUMOFLVS"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		ICHQ.UPDT.noOflvs = BANCS.OUTPUT.parameterVal
		PRINT(ICHQ.UPDT.noOflvs)
		
		#}
	ELSE
		#{
		ICHQ.UPDT.errMsg = "Num of leaves setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------------
	# Get the number of accounts entered from HTM menu option
	#-------------------------------------------------------------------------------------------------------
	
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	IF(sv_u == 0) THEN
	#{
		ICHQ.UPDT.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(ICHQ.UPDT.noOfRecords)
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_l = 0
	sv_m = ""
	sv_n = 0
	sv_a = "\n"
	sv_e = ""
	sv_c = 0
	
	WHILE(sv_l < ICHQ.UPDT.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		
		#-------------------------------------------------------------------------------------------
		# Fetch Instrument Type
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".instrmnt.instrmntType")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			ICHQ.UPDT.instrmnt_type = BANCS.OUTPARAM.srvValue
			PRINT(ICHQ.UPDT.instrmnt_type)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Instr Type.")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Instrument Type
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".pTranIdentifier.partTranSrlNum")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			ICHQ.UPDT.parttransrlnum = BANCS.OUTPARAM.srvValue
			PRINT(ICHQ.UPDT.parttransrlnum)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Part tran.")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (FIELDEXISTS(ICHQ.UPDT.tran_id)) THEN
		#{
			PRINT(ICHQ.UPDT.tran_id)
			IF (ICHQ.UPDT.instrmnt_type != "") THEN
			#{
				PRINT(ICHQ.UPDT.instrmnt_type)
				sv_s = "acid,instrmnt_type,instrmnt_num,instrmnt_date|"
				sv_s = sv_s + "SELECT acid,instrmnt_type,instrmnt_num,instrmnt_date "
				sv_s = sv_s + "FROM TBAADM.DTD "
				sv_s = sv_s + "WHERE tran_type IN ('C','T') "
				sv_s = sv_s + "AND tran_sub_type IN ('NP','CI','BI') "
				sv_s = sv_s + "AND instrmnt_type IN (SELECT DISTINCT inst_type FROM CUSTOM.C_CBT_INT WHERE del_flg != 'Y' AND bank_id = ?SVAR) "
				sv_s = sv_s + "AND tran_id = LPAD(?SVAR,9) "
				sv_s = sv_s + "AND tran_date = (SELECT DISTINCT db_stat_date FROM TBAADM.GCT WHERE bank_id = ?SVAR) "
				sv_s = sv_s + "AND part_tran_srl_num = LPAD(?SVAR,4) "
				sv_s = sv_s + "AND pstd_flg != 'N' "
				sv_s = sv_s + "AND del_flg != 'Y' "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + ICHQ.UPDT.tran_id + "|" + BANCS.STDIN.contextBankId + "|" + ICHQ.UPDT.parttransrlnum + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d != 0) THEN
				#{
					#sv_e = sv_e + ICHQ.UPDT.parttransrlnum + ","
					#                PRINT(sv_e)
					#
					#                sv_c = sv_c + 1
					#                PRINT(sv_c)
					#                GOTO NEXTREC
					PRINT("No Inhouse Chq Book")
					GOTO Finish
					
					#}
				ELSE
					#{
					ICHQ.UPDT.acid          = BANCS.OUTPARAM.acid
					PRINT(ICHQ.UPDT.acid)
					ICHQ.UPDT.instrmnt_type = TRIM(BANCS.OUTPARAM.instrmnt_type)
					PRINT(ICHQ.UPDT.instrmnt_type)
					ICHQ.UPDT.instrmnt_num  = TRIM(BANCS.OUTPARAM.instrmnt_num)
					PRINT(ICHQ.UPDT.instrmnt_num)
					ICHQ.UPDT.instrmnt_date = TRIM(BANCS.OUTPARAM.instrmnt_date)
					PRINT(ICHQ.UPDT.instrmnt_date)
				#}
				ENDIF
				
				sv_s = "foracid|SELECT foracid "
				sv_s = sv_s + "FROM TBAADM.GAM "
				sv_s = sv_s + "WHERE acid = ?SVAR "
				sv_s = sv_s + "AND entity_cre_flg = 'Y' "
				sv_s = sv_s + "AND del_flg = 'N' "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = ICHQ.UPDT.acid + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d != 0) THEN
				#{
					PRINT("Invalid Account Number")
					GOTO Finish
					#}
				ELSE
					#{
					ICHQ.UPDT.foracid = BANCS.OUTPARAM.foracid
					PRINT(ICHQ.UPDT.foracid)
				#}
				ENDIF
				ICHQ.UPDT.num_lvs = ICHQ.UPDT.noOflvs
				
				#-----------------------------
				# selecting count
				#-----------------------------
				sv_s = "acid,chq_issu_date,begin_chq_num,chq_num_of_lvs,chq_lvs_stat,num_paid,num_unused,num_stoped,num_destroyed|"
				sv_s = sv_s + "SELECT acid,chq_issu_date,begin_chq_num,chq_num_of_lvs,chq_lvs_stat,num_paid,"
				sv_s = sv_s + "num_unused,num_stoped,num_destroyed "
				sv_s = sv_s + "FROM CUSTOM.C_CBT "
				sv_s = sv_s + "WHERE "
				sv_s = sv_s + "inst_type = ?SVAR "
				sv_s = sv_s + "AND foracid = ?SVAR "
				sv_s = sv_s + "AND begin_chq_num <= ?SVAR "
				sv_s = sv_s + "AND (begin_chq_num + chq_num_of_lvs - 1) >= ?SVAR "
				sv_s = sv_s + "AND ( ?SVAR BETWEEN begin_chq_num "
				sv_s = sv_s + "AND (begin_chq_num + chq_num_of_lvs - 1)) "
				sv_s = sv_s + "AND chq_issu_date <= ?SVAR "
				sv_s = sv_s + "AND del_flg != 'Y' "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = ICHQ.UPDT.instrmnt_type + "|" + ICHQ.UPDT.foracid + "|" + ICHQ.UPDT.instrmnt_num + "|" + ICHQ.UPDT.instrmnt_num + "|" + ICHQ.UPDT.instrmnt_num + "|" + ICHQ.UPDT.instrmnt_date + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d != 0) THEN
				#{
					PRINT("No Record Found" )
					GOTO Finish
				#}
				ENDIF
				
				ICHQ.UPDT.acid           = BANCS.OUTPARAM.acid
				PRINT(ICHQ.UPDT.acid)
				ICHQ.UPDT.chq_issu_date  = BANCS.OUTPARAM.chq_issu_date
				PRINT(ICHQ.UPDT.chq_issu_date)
				ICHQ.UPDT.begin_chq_num  = BANCS.OUTPARAM.begin_chq_num
				PRINT(ICHQ.UPDT.begin_chq_num)
				ICHQ.UPDT.chq_num_of_lvs = BANCS.OUTPARAM.chq_num_of_lvs
				PRINT(ICHQ.UPDT.chq_num_of_lvs)
				ICHQ.UPDT.chq_lvs_stat   = BANCS.OUTPARAM.chq_lvs_stat
				PRINT(ICHQ.UPDT.chq_lvs_stat)
				ICHQ.UPDT.num_paid       = BANCS.OUTPARAM.num_paid
				PRINT(ICHQ.UPDT.num_paid)
				ICHQ.UPDT.num_unused     = BANCS.OUTPARAM.num_unused
				PRINT(ICHQ.UPDT.num_unused)
				ICHQ.UPDT.num_stoped     = BANCS.OUTPARAM.num_stoped
				PRINT(ICHQ.UPDT.num_stoped)
				ICHQ.UPDT.num_destroyed  = BANCS.OUTPARAM.num_destroyed
				PRINT(ICHQ.UPDT.num_destroyed)
				
				#----------------------------------------
				#--selecting spilted status from C_CBT
				#--First split - small user input
				#----------------------------------------
				PRINT(ICHQ.UPDT.instrmnt_num)
				PRINT(ICHQ.UPDT.begin_chq_num)
				
				IF (ICHQ.UPDT.instrmnt_num != ICHQ.UPDT.begin_chq_num) THEN
				#{
					ICHQ.UPDT.temp = CINT(ICHQ.UPDT.instrmnt_num) - CINT(ICHQ.UPDT.begin_chq_num)
					PRINT(ICHQ.UPDT.temp)
					#}
				ELSE
					#{
					ICHQ.UPDT.temp = "0"
					PRINT(ICHQ.UPDT.temp)
				#}
				ENDIF
				
				ICHQ.UPDT.status = "SUBSTR(chq_lvs_stat,1," + ICHQ.UPDT.temp + "),"
				PRINT(ICHQ.UPDT.status)
				
				#--------------------------------------------------
				#--Second split(affected part) - small user input
				#--------------------------------------------------
				PRINT(ICHQ.UPDT.temp)
				ICHQ.UPDT.temp = CINT(ICHQ.UPDT.temp) + CINT("1")
				PRINT(ICHQ.UPDT.temp)
				
				ICHQ.UPDT.status = ICHQ.UPDT.status + "SUBSTR(chq_lvs_stat," + ICHQ.UPDT.temp + "," + ICHQ.UPDT.num_lvs + "),"
				PRINT(ICHQ.UPDT.status)
				
				#---------------------------------------------
				# Last split (end part)   - small user input
				#---------------------------------------------
				ICHQ.UPDT.temp = CINT(ICHQ.UPDT.temp) + CINT(ICHQ.UPDT.num_lvs)
				PRINT(ICHQ.UPDT.temp)
				
				ICHQ.UPDT.status = ICHQ.UPDT.status + "SUBSTR(chq_lvs_stat," + ICHQ.UPDT.temp + ","
				PRINT(ICHQ.UPDT.status)
				
				ICHQ.UPDT.temp = CINT(ICHQ.UPDT.chq_num_of_lvs) - (CINT(ICHQ.UPDT.temp) - CINT("1"))
				PRINT(ICHQ.UPDT.temp)
				
				IF (TRIM(ICHQ.UPDT.temp) == "") THEN
				#{
					ICHQ.UPDT.temp = "0"
					PRINT(ICHQ.UPDT.temp)
				#}
				ENDIF
				
				ICHQ.UPDT.status = ICHQ.UPDT.status + ICHQ.UPDT.temp + ") "
				PRINT(ICHQ.UPDT.status)
				
				sv_s = "first_part,second_part,last_part|"
				sv_s = sv_s + "SELECT "
				sv_s = sv_s + ICHQ.UPDT.status
				sv_s = sv_s + "FROM CUSTOM.C_CBT "
				sv_s = sv_s + "WHERE "
				sv_s = sv_s + "inst_type = ?SVAR "
				sv_s = sv_s + "AND foracid = ?SVAR "
				sv_s = sv_s + "AND begin_chq_num <= ?SVAR "
				sv_s = sv_s + "AND (begin_chq_num + chq_num_of_lvs - 1) >= ?SVAR "
				sv_s = sv_s + "AND ( ?SVAR between begin_chq_num "
				sv_s = sv_s + "AND (begin_chq_num + chq_num_of_lvs - 1)) "
				sv_s = sv_s + "AND chq_issu_date <= ?SVAR "
				sv_s = sv_s + "AND DEL_FLG != 'Y' "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = ICHQ.UPDT.instrmnt_type + "|" + ICHQ.UPDT.foracid + "|" + ICHQ.UPDT.instrmnt_num + "|" + ICHQ.UPDT.instrmnt_num + "|" + ICHQ.UPDT.instrmnt_num + "|" + ICHQ.UPDT.instrmnt_date + "|" +  BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d != 0) THEN
				#{
					PRINT("DataBase Error.")
					GOTO Finish
				#}
				ENDIF
				
				ICHQ.UPDT.first_part = BANCS.OUTPARAM.first_part
				PRINT(ICHQ.UPDT.first_part)
				ICHQ.UPDT.second_part = BANCS.OUTPARAM.second_part
				PRINT(ICHQ.UPDT.second_part)
				ICHQ.UPDT.last_part = BANCS.OUTPARAM.last_part
				PRINT(ICHQ.UPDT.last_part)
				
				sv_a = STRLEN(ICHQ.UPDT.first_part)
				PRINT(sv_a)
				sv_b = STRLEN(ICHQ.UPDT.second_part)
				PRINT(sv_b)
				sv_c = STRLEN(ICHQ.UPDT.last_part)
				PRINT(sv_c)
				ICHQ.UPDT.old_status = "U"
				ICHQ.UPDT.new_status = "P"
				
				ICHQ.UPDT.new_second_part = TRIM(ICHQ.UPDT.new_status)
				PRINT(ICHQ.UPDT.new_second_part)
				
				ICHQ.UPDT.new_status = ICHQ.UPDT.first_part + ICHQ.UPDT.new_second_part + ICHQ.UPDT.last_part
				PRINT(ICHQ.UPDT.new_status)
				
				ICHQ.UPDT.new_num_unused = ICHQ.UPDT.num_unused
				PRINT(ICHQ.UPDT.new_num_unused)
				ICHQ.UPDT.new_num_paid   = ICHQ.UPDT.num_paid
				PRINT(ICHQ.UPDT.new_num_paid)
				ICHQ.UPDT.new_num_stoped = ICHQ.UPDT.num_stoped
				PRINT(ICHQ.UPDT.new_num_stoped)
				ICHQ.UPDT.new_num_dest = ICHQ.UPDT.num_destroyed
				PRINT(ICHQ.UPDT.new_num_dest)
				
				IF (ICHQ.UPDT.old_status == "U") THEN
				#{
					ICHQ.UPDT.new_num_unused = CINT(ICHQ.UPDT.num_unused) - 1
					PRINT(ICHQ.UPDT.new_num_unused)
				#}
				ENDIF
				IF (ICHQ.UPDT.old_status == "P") THEN
				#{
					ICHQ.UPDT.new_num_paid = CINT(ICHQ.UPDT.num_paid) - 1
					PRINT(ICHQ.UPDT.new_num_paid)
				#}
				ENDIF
				IF (ICHQ.UPDT.old_status == "S") THEN
				#{
					ICHQ.UPDT.new_num_stoped = CINT(ICHQ.UPDT.num_stoped) - 1
					PRINT(ICHQ.UPDT.new_num_stoped)
				#}
				ENDIF
				IF (ICHQ.UPDT.old_status == "D") THEN
				#{
					ICHQ.UPDT.new_num_dest = CINT(ICHQ.UPDT.num_destroyed) - 1
					PRINT(ICHQ.UPDT.new_num_dest)
				#}
				ENDIF
				
				IF (ICHQ.UPDT.new_status == "U") THEN
				#{
					ICHQ.UPDT.new_num_unused = CINT(ICHQ.UPDT.num_unused) + 1
					PRINT(ICHQ.UPDT.new_num_unused)
				#}
				ENDIF
				IF (ICHQ.UPDT.new_status == "P") THEN
				#{
					ICHQ.UPDT.new_num_paid = CINT(ICHQ.UPDT.num_paid) + 1
					PRINT(ICHQ.UPDT.new_num_paid)
				#}
				ENDIF
				IF (ICHQ.UPDT.new_status == "S") THEN
				#{
					ICHQ.UPDT.new_num_stoped = CINT(ICHQ.UPDT.num_stoped) + 1
					PRINT(ICHQ.UPDT.new_num_stoped)
				#}
				ENDIF
				IF (ICHQ.UPDT.new_status == "D") THEN
				#{
					ICHQ.UPDT.new_num_dest = CINT(ICHQ.UPDT.num_destroyed) + 1
					PRINT(ICHQ.UPDT.new_num_dest)
				#}
				ENDIF
				
				PRINT(ICHQ.UPDT.num_unused)
				PRINT(ICHQ.UPDT.num_paid)
				PRINT(ICHQ.UPDT.num_stoped)
				PRINT(ICHQ.UPDT.num_destroyed)
				
				IF (TRIM(ICHQ.UPDT.new_num_unused) == "") THEN
				#{
					ICHQ.UPDT.new_num_unused = "0"
					PRINT(ICHQ.UPDT.new_num_unused)
				#}
				ENDIF
				IF (TRIM(ICHQ.UPDT.new_num_paid) == "") THEN
				#{
					ICHQ.UPDT.new_num_paid = "0"
					PRINT(ICHQ.UPDT.new_num_paid)
				#}
				ENDIF
				IF (TRIM(ICHQ.UPDT.new_num_stoped) == "") THEN
				#{
					ICHQ.UPDT.new_num_stoped = "0"
					PRINT(ICHQ.UPDT.new_num_stoped)
				#}
				ENDIF
				IF (TRIM(ICHQ.UPDT.new_num_dest) == "") THEN
				#{
					ICHQ.UPDT.new_num_dest = "0"
					PRINT(ICHQ.UPDT.new_num_dest)
				#}
				ENDIF
				
				PRINT(ICHQ.UPDT.new_status)
				
				#---------------------------------------
				# Updating C_CBT Table
				#---------------------------------------
				ICHQ.UPDT.systemDate = MID$(BANCS.STDIN.sysDate,0,10)
				PRINT(ICHQ.UPDT.systemDate)
				sv_s = "UPDATE CUSTOM.C_CBT "
				sv_s = sv_s + "SET chq_lvs_stat = ?SVAR,"
				sv_s = sv_s + "num_unused = ?SVAR,"
				sv_s = sv_s + "num_paid = ?SVAR,"
				sv_s = sv_s + "num_stoped = ?SVAR,"
				sv_s = sv_s + "num_destroyed = ?SVAR,"
				sv_s = sv_s + "lchg_user_id = ?SVAR,"
				sv_s = sv_s + "lchg_time = TO_DATE(?SVAR,'DD-MM-YYYY') "
				sv_s = sv_s + "WHERE "
				sv_s = sv_s + "begin_chq_num = ?SVAR "
				sv_s = sv_s + "AND inst_type = ?SVAR "
				sv_s = sv_s + "AND foracid = ?SVAR "
				sv_s = sv_s + "AND del_flg != 'Y'"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = ICHQ.UPDT.new_status + "|" + ICHQ.UPDT.new_num_unused + "|" + ICHQ.UPDT.new_num_paid + "|" + ICHQ.UPDT.new_num_stoped + "|" + ICHQ.UPDT.new_num_dest + "|" + BANCS.STDIN.userId + "|" + ICHQ.UPDT.systemDate + "|" + ICHQ.UPDT.begin_chq_num + "|" + ICHQ.UPDT.instrmnt_type + "|" + ICHQ.UPDT.foracid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSQLWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d != 0) THEN
				#{
					PRINT("DataBase Error." )
					GOTO Finish
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		NEXTREC:
			PRINT(sv_m)
			sv_l = sv_l + 1
			PRINT (sv_l)
		#}
		DO
		PRINT(sv_m)
		IF (sv_m != "") THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
	Finish:
		#IF (sv_c > 0) THEN
		##{
		#    BANCS.OUTPUT.successOrFailure = "F"
		#    sv_e = RTRIM(sv_e,',')
		#    sv_e = "No Inhouse Chq Book for the part tran serial no :  " + sv_e
		#    PRINT(sv_e)
		#    sv_u = urhk_SRV_SetErr(sv_e)
		##}
		#ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
