<--start
trace on
	callscriptifexist("ebRepClass.scr")
	EBSRV.GLBDATA.errMsg = ""
	EBSRV.GLBDATA.resMsg = ""
	EBSRV.GLBDATA.ModRecCnt = 0
	EBSRV.GLBDATA.RecCnt = 0
	EBSRV.GLBDATA.UnvRecCnt = 0
	EBSRV.GLBDATA.DupRecCnt = 0
	EBSRV.GLBDATA.ModUnvRecCnt = 0
	EBSRV.GLBDATA.UnvRecCnt = 0
	EBSRV.GLBDATA.RecCnt = 0

	EBSRV.GLBDATA.CustName = ""
	EBSRV.GLBDATA.CustBranch = ""
	EBSRV.GLBDATA.CustConst = ""
	EBSRV.GLBDATA.AcctNo = ""
	EBSRV.GLBDATA.AcctName = ""
	EBSRV.GLBDATA.AcctBranch = ""
	EBSRV.GLBDATA.AcctSchm = ""
	EBSRV.GLBDATA.AcctModeOfOper = ""
	EBSRV.GLBDATA.AcctStatus = ""
	EBSRV.GLBDATA.AcctACY = ""
	EBSRV.GLBDATA.RecVerifyType = ""
	EBSRV.GLBDATA.RecType = ""

	EBSRV.GLBDATA.funcCode = BANCS.INPUT.funcCode
	print(EBSRV.GLBDATA.funcCode)
	EBSRV.GLBDATA.custId = BANCS.INPUT.cifId
	print(EBSRV.GLBDATA.custId)
	EBSRV.GLBDATA.accNo = BANCS.INPUT.accNo
	print(EBSRV.GLBDATA.accNo)
##Cif ID Validation
	lv_a = urhk_getCustomerDetails(EBSRV.GLBDATA.custId)
	print(lv_a)
	if(lv_a != 0) then
		EBSRV.GLBDATA.errMsg = "Enter Valid Customer ID"
		GOTO ERROR
	endif
##Account Validation
	lv_a = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.accNo)
	print(lv_a)
	if(lv_a != 0) then
		EBSRV.GLBDATA.errMsg = "Enter Valid Account Number"
		GOTO ERROR
	#}
	endif
## Records Count 
	lv_s = " RecCnt | select count(1) from tbaadm.gam,crmuser.accounts A "
	lv_s = lv_s + " where gam.entity_cre_flg='Y' and gam.del_flg <> 'Y' "
	lv_s = lv_s + " and a.entity_cre_flag='Y' and a.suspended <> 'Y' "
	lv_s = lv_s + " and a.orgkey = ?SVAR "
	lv_s = lv_s + " and a.orgkey = gam.cif_id "
	lv_s = lv_s + " and gam.foracid=?SVAR "
	print(lv_s)
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.custId +"|"+ EBSRV.GLBDATA.accNo
	print(BANCS.INPARAM.BINDVARS)
	lv_d = urhk_dbSelectWithBind(lv_s)
	if (lv_d ==0) then
		EBSRV.GLBDATA.RecCnt = BANCS.OUTPARAM.RecCnt
		print(EBSRV.GLBDATA.RecCnt)
		if(EBSRV.GLBDATA.RecCnt == 0) then
			EBSRV.GLBDATA.errMsg = "Customer ID and Account Number Doesnt Match!!!"
			GOTO ERROR 
		endif		
	else
		EBSRV.GLBDATA.errMsg = "Customer ID and Account Number Doesnt Match!!!"
		GOTO ERROR
	endif

	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.custId +"|"+ EBSRV.GLBDATA.accNo
	print(BANCS.INPARAM.BINDVARS)
	lv_s = " ModRecCnt | select count(1) from custom.cust_alert_mod_tbl "
	lv_s = lv_s + " where cust_id = trim(?SVAR) "
	lv_s = lv_s + " and foracid = ?SVAR "
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	if (lv_d ==0) then
		EBSRV.GLBDATA.ModRecCnt = BANCS.OUTPARAM.ModRecCnt
		print(EBSRV.GLBDATA.ModRecCnt)
	endif
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.custId +"|"+ EBSRV.GLBDATA.accNo
	print(BANCS.INPARAM.BINDVARS)
	lv_s = " UnvRecCnt | select count(1) from custom.cust_alerts_tbl "
	##lv_s = lv_s + " where cust_id = lpad('"+trim(EBSRV.GLBDATA.custId)+"',9,' ') "
	lv_s = lv_s + " where cust_id = trim(?SVAR) "
	lv_s = lv_s + " and entity_cre_flg = 'N' "
	lv_s = lv_s + " and foracid = ?SVAR "
	lv_s = lv_s + " and del_flg <> 'Y' "
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	if (lv_d ==0) then
		EBSRV.GLBDATA.UnvRecCnt = BANCS.OUTPARAM.UnvRecCnt
		print(EBSRV.GLBDATA.UnvRecCnt)

	endif
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.custId +"|"+ EBSRV.GLBDATA.accNo
	print(BANCS.INPARAM.BINDVARS)
	lv_s = " DupRecCnt | select count(1) from custom.cust_alerts_tbl "
	##lv_s = lv_s + " where cust_id = lpad('"+trim(EBSRV.GLBDATA.custId)+"',9,' ') "
	lv_s = lv_s + " where cust_id = trim(?SVAR) "
	lv_s = lv_s + " and foracid = ?SVAR "
	print(lv_s)

	lv_d = urhk_dbSelectWithBind(lv_s)
	if (lv_d ==0) then
		EBSRV.GLBDATA.DupRecCnt = BANCS.OUTPARAM.DupRecCnt
		print(EBSRV.GLBDATA.DupRecCnt)
	endif
	if((EBSRV.GLBDATA.funcCode == "R") OR (EBSRV.GLBDATA.funcCode == "M")) then
		if(EBSRV.GLBDATA.ModRecCnt != 0) then
			EBSRV.GLBDATA.errMsg = "Unverified Record Exist for this Customer ID!!"
			GOTO ERROR
		endif
		if(EBSRV.GLBDATA.UnvRecCnt != 0) then
			EBSRV.GLBDATA.errMsg = "Unverified Record Exist for this Customer ID!!"
			GOTO ERROR
		endif
	endif
	if((EBSRV.GLBDATA.funcCode == "V") OR (EBSRV.GLBDATA.funcCode == "X")) then
		if((EBSRV.GLBDATA.ModRecCnt  == "0" ) and (EBSRV.GLBDATA.UnvRecCnt == "0") ) then	
			if(EBSRV.GLBDATA.funcCode == "V") then
				EBSRV.GLBDATA.errMsg = "Nothing to Verify"
			else
				EBSRV.GLBDATA.errMsg = "Nothing to Cancel"
			endif
			GOTO ERROR
		endif
	endif
	if(EBSRV.GLBDATA.funcCode == "R") then
		if(EBSRV.GLBDATA.DupRecCnt != "0") then
			EBSRV.GLBDATA.errMsg = "Record Already Exist with Entered Customer ID and Account Number!!!"
			GOTO ERROR
		endif
	endif
	if((EBSRV.GLBDATA.funcCode != "R") and (EBSRV.GLBDATA.funcCode != "X")) then
		if ( EBSRV.GLBDATA.DupRecCnt == "0" ) then
			EBSRV.GLBDATA.errMsg = "No Record Exist with Entered Customer ID and Account Number"
			GOTO ERROR
		endif
	endif
	if(EBSRV.GLBDATA.funcCode == "R") then
		if((EBSRV.GLBDATA.custId != "") and (EBSRV.GLBDATA.accNo != "")) then
			lv_s = "CustName,CustBranch,CustConst,AcctNo,AcctName,AcctBranch,AcctSchm, "
			lv_s = lv_s + " AcctModeOfOper,AcctStatus,AcctACY|"
			lv_s = lv_s + " select name,cs.sol_desc, custom.fn_ref_desc(gam.bank_id, constitution_ref_code,'44') ,  "
			lv_s = lv_s + " foracid ,acct_name, acs.sol_desc,gsp.schm_desc, "
			lv_s = lv_s + " custom.fn_ref_desc(gam.bank_id,mode_of_oper_code,'27') as modeofopr , "
			lv_s = lv_s + " custom.fn_acct_status(gam.bank_id,foracid) as accountstatus,gam.acct_crncy_code "
			lv_s = lv_s + " from crmuser.accounts a,tbaadm.sol cs,tbaadm.gam,tbaadm.sol acs,tbaadm.gsp  "
			lv_s = lv_s + " where A.orgkey=?SVAR "
			lv_s = lv_s + " and a.primary_sol_id=cs.sol_id "
			lv_s = lv_s + " and gam.foracid=?SVAR "
			lv_s = lv_s + " and gam.bank_id=?SVAR "
			lv_s = lv_s + " and gsp.bank_id=?SVAR "
			lv_s = lv_s + " and gam.schm_code=gsp.schm_code "
			lv_s = lv_s + " and gam.sol_id=acs.sol_id "
			print(lv_s)
			BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.custId +"|"+ EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId 
			print(BANCS.INPARAM.BINDVARS)
			lv_r = urhk_dbSelectWithBind(lv_s)
			print(lv_r)
			if (lv_r == "0") then
				EBSRV.GLBDATA.CustName = BANCS.OUTPARAM.CustName
				print(EBSRV.GLBDATA.CustName)
				EBSRV.GLBDATA.CustBranch = BANCS.OUTPARAM.CustBranch
				print(EBSRV.GLBDATA.CustBranch)
				EBSRV.GLBDATA.CustConst = BANCS.OUTPARAM.CustConst
				print(EBSRV.GLBDATA.CustConst)
				if(EBSRV.GLBDATA.CustConst == "No Data Found") then
					EBSRV.GLBDATA.CustConst = ""
				endif
				EBSRV.GLBDATA.AcctNo = BANCS.OUTPARAM.AcctNo
				print(EBSRV.GLBDATA.AcctNo)
				EBSRV.GLBDATA.AcctName = BANCS.OUTPARAM.AcctName
				print(EBSRV.GLBDATA.AcctName)
				EBSRV.GLBDATA.AcctBranch = BANCS.OUTPARAM.AcctBranch
				print(EBSRV.GLBDATA.AcctBranch)
				EBSRV.GLBDATA.AcctSchm = BANCS.OUTPARAM.AcctSchm
				print(EBSRV.GLBDATA.AcctSchm)
				EBSRV.GLBDATA.AcctModeOfOper = BANCS.OUTPARAM.AcctModeOfOper
				print(EBSRV.GLBDATA.AcctModeOfOper)
				if(EBSRV.GLBDATA.AcctModeOfOper == "No Data Found") then
					EBSRV.GLBDATA.AcctModeOfOper = ""
				endif
				EBSRV.GLBDATA.AcctStatus = BANCS.OUTPARAM.AcctStatus
				print(EBSRV.GLBDATA.AcctStatus)
				if(EBSRV.GLBDATA.AcctStatus == "No Data Found") then
					EBSRV.GLBDATA.AcctStatus = "" 
				endif
				EBSRV.GLBDATA.AcctACY = BANCS.OUTPARAM.AcctACY
				print(EBSRV.GLBDATA.AcctACY)
				GOTO ERROR
			else
				EBSRV.GLBDATA.errMsg = "Invalid Account!!!"
				GOTO ERROR
			endif		
		endif
	endif
	if((EBSRV.GLBDATA.funcCode == "V") OR (EBSRV.GLBDATA.funcCode == "X")) then
		callscriptifexist("ebAlertdp001.scr")	
		GOTO ERROR
	endif
	if((EBSRV.GLBDATA.funcCode == "I") OR (EBSRV.GLBDATA.funcCode == "M")) then
		callscriptifexist("ebAlertdp002.scr")
		GOTO ERROR
	endif
ERROR:
		if(EBSRV.GLBDATA.errMsg != "") then
			lv_e = urhk_SetOrbErr(EBSRV.GLBDATA.errMsg)
			GOTO ENDOFSCRIPT
		else
			if(EBSRV.GLBDATA.funcCode == "R") then
				if(EBSRV.GLBDATA.custId == "") then
					lv_a = urhk_SetOrbOut("custId| ")
				else
					lv_a = urhk_SetOrbOut("custId|" +EBSRV.GLBDATA.custId)
				endif
				if(EBSRV.GLBDATA.CustName == "") then
					lv_a = urhk_SetOrbOut("custName| ") 
				else
					lv_a = urhk_SetOrbOut("custName|" +EBSRV.GLBDATA.CustName)
					print(lv_a)
				endif
				if(EBSRV.GLBDATA.CustBranch == "") then
					lv_a = urhk_SetOrbOut("custBranch| ")
				else
					lv_a = urhk_SetOrbOut("custBranch|" +EBSRV.GLBDATA.CustBranch)
				endif
				if(EBSRV.GLBDATA.CustConst == "") then
					lv_a = urhk_SetOrbOut("custConst| ")
				else
					lv_a = urhk_SetOrbOut("custConst|" +EBSRV.GLBDATA.CustConst)
				endif
				if(EBSRV.GLBDATA.AcctNo == "") then
					lv_a = urhk_SetOrbOut("accNum| ")
				else
					lv_a = urhk_SetOrbOut("accNum|" +EBSRV.GLBDATA.AcctNo)
				endif
				if(EBSRV.GLBDATA.AcctACY == "") then
					lv_a = urhk_SetOrbOut("accCrncy| ")
				else
					lv_a = urhk_SetOrbOut("accCrncy|" +EBSRV.GLBDATA.AcctACY)
				endif
				if(EBSRV.GLBDATA.AcctName == "") then
					lv_a = urhk_SetOrbOut("accName| ")
				else
					lv_a = urhk_SetOrbOut("accName|" +EBSRV.GLBDATA.AcctName)
				endif
				if(EBSRV.GLBDATA.AcctBranch == "") then
					lv_a = urhk_SetOrbOut("accBranch| ")
				else				
					lv_a = urhk_SetOrbOut("accBranch|" +EBSRV.GLBDATA.AcctBranch)
				endif
				if(EBSRV.GLBDATA.AcctSchm == "") then
					lv_a = urhk_SetOrbOut("accScheme| ")
				else
					lv_a = urhk_SetOrbOut("accScheme|" +EBSRV.GLBDATA.AcctSchm)
				endif
				if(EBSRV.GLBDATA.AcctStatus == "") then
					lv_a = urhk_SetOrbOut("accStatus| ")
				else
					lv_a = urhk_SetOrbOut("accStatus|" +EBSRV.GLBDATA.AcctStatus)
				endif
				if(EBSRV.GLBDATA.AcctModeOfOper == "") then 
					lv_a = urhk_SetOrbOut("modeOfOper| ")
				else
					lv_a = urhk_SetOrbOut("modeOfOper|" +EBSRV.GLBDATA.AcctModeOfOper)
				endif
				if(EBSRV.GLBDATA.AcctNo == "") then
					lv_a = urhk_SetOrbOut("chrgAcc| ")
				else
					lv_a = urhk_SetOrbOut("chrgAcc|" +EBSRV.GLBDATA.AcctNo)
				endif
				if(EBSRV.GLBDATA.AcctACY == "") then
					lv_a = urhk_SetOrbOut("chrgAccCrncy| ")
				else
					lv_a = urhk_SetOrbOut("chrgAccCrncy|" +EBSRV.GLBDATA.AcctACY)
				endif

				lv_b = urhk_SetOrbOut("SuccessOrFailure|Y")
			endif
			if((EBSRV.GLBDATA.funcCode == "V") OR (EBSRV.GLBDATA.funcCode == "X")) then
				if(EBSRV.GLBDATA.custId == "") then
					lv_a = urhk_SetOrbOut("custId| ")
				else
					lv_a = urhk_SetOrbOut("custId|" +EBSRV.GLBDATA.custId)
				endif
				if(EBSRV.GLBDATA.CustName == "") then
					lv_a = urhk_SetOrbOut("custName| ") 
				else
					lv_a = urhk_SetOrbOut("custName|" + EBSRV.GLBDATA.CustName)
				endif
				if(EBSRV.GLBDATA.CustBranch == "") then
					lv_a = urhk_SetOrbOut("custBranch| ")
				else
					lv_a = urhk_SetOrbOut("custBranch|" +EBSRV.GLBDATA.CustBranch)
				endif
				if(EBSRV.GLBDATA.CustConst == "") then
					lv_a = urhk_SetOrbOut("custConst| ")
				else
					lv_a = urhk_SetOrbOut("custConst|" +EBSRV.GLBDATA.CustConst)
				endif
				if(EBSRV.GLBDATA.AcctNo == "") then
					lv_a = urhk_SetOrbOut("accNum| ")
				else
					lv_a = urhk_SetOrbOut("accNum|" +EBSRV.GLBDATA.AcctNo)
				endif
				if(EBSRV.GLBDATA.AcctCCY == "") then
					lv_a = urhk_SetOrbOut("accCrncy| ")
				else
					lv_a = urhk_SetOrbOut("accCrncy|" +EBSRV.GLBDATA.AcctCCY)
				endif
				if(EBSRV.GLBDATA.AcctName == "") then
					lv_a = urhk_SetOrbOut("accName| ")
				else
					lv_a = urhk_SetOrbOut("accName|" +EBSRV.GLBDATA.AcctName)
				endif
				if(EBSRV.GLBDATA.AcctBranch == "") then
					lv_a = urhk_SetOrbOut("accBranch| ")
				else
					lv_a = urhk_SetOrbOut("accBranch|" +EBSRV.GLBDATA.AcctBranch)
				endif
				if(EBSRV.GLBDATA.AcctSchm == "") then
					lv_a = urhk_SetOrbOut("accScheme| ")
				else
					lv_a = urhk_SetOrbOut("accScheme|" +EBSRV.GLBDATA.AcctSchm)
				endif
				if(EBSRV.GLBDATA.AcctStatus == "") then
					lv_a = urhk_SetOrbOut("accStatus| ")
				else
					lv_a = urhk_SetOrbOut("accStatus|" +EBSRV.GLBDATA.AcctStatus)
				endif
				if(EBSRV.GLBDATA.AcctModeOfOper == "") then
					lv_a = urhk_SetOrbOut("modeOfOper| ")
				else
					lv_a = urhk_SetOrbOut("modeOfOper|" +EBSRV.GLBDATA.AcctModeOfOper)
				endif
				if(EBSRV.GLBDATA.ChargeAccountNo == "") then
					lv_a = urhk_SetOrbOut("chrgAcc| ")
				else 
					lv_a = urhk_SetOrbOut("chrgAcc|" +EBSRV.GLBDATA.ChargeAccountNo)
				endif
				if(EBSRV.GLBDATA.ChargeAccountCCY == "") then
					lv_a = urhk_SetOrbOut("chrgAccCrncy| ")
				else
					lv_a = urhk_SetOrbOut("chrgAccCrncy|" +EBSRV.GLBDATA.ChargeAccountCCY)
				endif
				if(EBSRV.GLBDATA.DrAlertFlag == "") then
					lv_a = urhk_SetOrbOut("drAlerts| ")
				else
					lv_a = urhk_SetOrbOut("drAlerts|" +EBSRV.GLBDATA.DrAlertFlag)
				endif
				if(EBSRV.GLBDATA.MinDrAmount == "") then
					lv_a = urhk_SetOrbOut("minDrAmt| ")
				else
					lv_a = urhk_SetOrbOut("minDrAmt|" +EBSRV.GLBDATA.MinDrAmount)
				endif
				if(EBSRV.GLBDATA.CrAlertFlag == "") then
					lv_a = urhk_SetOrbOut("crAlerts| ")
				else
					lv_a = urhk_SetOrbOut("crAlerts|" +EBSRV.GLBDATA.CrAlertFlag)
				endif
				if(EBSRV.GLBDATA.MinCrAmount == "") then
					lv_a = urhk_SetOrbOut("minCrAmt| ")
				else
					lv_a = urhk_SetOrbOut("minCrAmt|" +EBSRV.GLBDATA.MinCrAmount)
				endif
				if(EBSRV.GLBDATA.MobileNo == "") then
					lv_a = urhk_SetOrbOut("phNum| ")
				else
					lv_a = urhk_SetOrbOut("phNum|" +EBSRV.GLBDATA.MobileNo)
				endif
				if(EBSRV.GLBDATA.EmailAddress == "") then
					lv_a = urhk_SetOrbOut("email| ")
				else
					lv_a = urhk_SetOrbOut("email|" +EBSRV.GLBDATA.EmailAddress)
				endif
				if(EBSRV.GLBDATA.AlertStatus == "") then
					lv_a = urhk_SetOrbOut("activateFlag| ")
				else
					lv_a = urhk_SetOrbOut("activateFlag|" +EBSRV.GLBDATA.AlertStatus)
				endif
				if(EBSRV.GLBDATA.RecVerifyType == "") then
					lv_a = urhk_SetOrbOut("RecVerifyType| ")
				else
					lv_a = urhk_SetOrbOut("RecVerifyType|" +EBSRV.GLBDATA.RecVerifyType)
				endif
				lv_b = urhk_SetOrbOut("SuccessOrFailure|Y")
				#sv_z = urhk_SetOrbOut("ChargeAcctClsFlg|" + EBSRV.GLBDATA.ChargeAcctClsFlg)
				#sv_z = urhk_SetOrbOut("ChargeAcctStatus|" + EBSRV.GLBDATA.ChargeAcctStatus)
			endif	
			if((EBSRV.GLBDATA.funcCode == "I") OR (EBSRV.GLBDATA.funcCode == "M")) then
				if(EBSRV.GLBDATA.custId == "") then
					lv_a = urhk_SetOrbOut("custId| ")
				else
					lv_a = urhk_SetOrbOut("custId|" +EBSRV.GLBDATA.custId)
				endif
				if(EBSRV.GLBDATA.CustName == "") then
					lv_a = urhk_SetOrbOut("custName| ") 
				else
					lv_a = urhk_SetOrbOut("custName|" + EBSRV.GLBDATA.CustName)
				endif
				if(EBSRV.GLBDATA.CustBranch == "") then
					lv_a = urhk_SetOrbOut("custBranch| ")
				else
					lv_a = urhk_SetOrbOut("custBranch|" +EBSRV.GLBDATA.CustBranch)
				endif
				if(EBSRV.GLBDATA.CustConst == "") then
