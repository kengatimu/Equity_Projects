		#{
			sv_w = urhk_DBSqlWithBind("rollback")
			print(sv_w)
			GOTO ERRORMESSAGE
		#}
		ENDIF
		#-----------------------------------------------
		#  CALLING denomdp015.scr FOR C_DERD TABLE UPDATE
		#-----------------------------------------------
		call("denomdp015.scr")
		
		sv_k = sv_k + 1
		sv_q = 1
	#}
	DO
	sv_l = "commit"
	sv_s = urhk_DBSqlWithBind(sv_l)
	print(sv_s)
	IF (sv_s != 0) THEN
	#{
		sv_u = urhk_setOrbOut("Message|N")
		print(sv_u)
		sv_u = urhk_setOrbOut("Details|Fail to commit")
		print(sv_u)
		GOTO FINISH
		#}
	ELSE
		#{
		IF (((CUST.DENOM.statusFlag =="N") AND (CUST.DENOM.custName !="") AND (CUST.DENOM.idNum !="") AND (CUST.DENOM.phoneNo !="")) OR ((CUST.DENOM.statusFlag == "Y") AND (CUST.DENOM.docDetails !=""))) THEN
		#{
			sv_s = " Insert into CUSTOM.CASHDX_CUSTOM (CUSTOMER_NAME, ID_NUM, PHONE_NUM, SUPPORTING_DETAILS,rcre_time,BANK_ID,USER_ID,SOL_ID,NATIONALITY)  "
			sv_s = sv_s + "Values(?SVAR,"
			sv_s = sv_s + "?SVAR,"
			sv_s = sv_s + "?SVAR,"
			sv_s = sv_s + "?SVAR,"
			sv_s = sv_s + "to_date(?SVAR,'dd-mm-yyyy HH24:MI:SS'),"
			sv_s = sv_s + "?SVAR,"
			sv_s = sv_s + "?SVAR,"
			sv_s = sv_s + "?SVAR,"
			sv_s = sv_s + "?SVAR)"
			#sv_s = sv_s + "order by RCRE_TIME desc)"
			PRINT(sv_s)
			
			CUST.DENOM.sysdate = BANCS.STDIN.sysDate
			print(CUST.DENOM.sysdate)
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.custName + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DENOM.idNum + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DENOM.phoneNo + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DENOM.docDetails + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DENOM.sysdate + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.myBrCode + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DENOM.nationDet
			
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_f = urhk_dbSQLWithBind(sv_s)
			IF (sv_f == 0) THEN
			#{
				sv_c = urhk_dbSQLWithBind("commit")
				print(sv_c)
				#}
			ELSE
				#{
				sv_c = urhk_dbSqlWithBind("ROLLBACK")
				print(sv_c)
			#}
			ENDIF
			
		#}
		ELSE
			#{
			CUST.DENOM.errMsg = "Enter all mandatory Fields"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		call("hcashdx_report.scr")
		
		IF(FIELDEXISTS(CUST.DENOM.PATH))THEN
		#{
			
			
			PRINT(CUST.DENOM.PATH)
			sv_s = "RESULT_MSG|" + "TRANSACTION CREATED SUCESSFULLY WITH TRANID :" + CUST.DENOM.tranId + "*" + CUST.DENOM.PATH
			sv_z = urhk_SetOrbOut(sv_s)
			sv_s = "Path|" + CUST.DENOM.PATH
			sv_z = urhk_SetOrbOut(sv_s)
			print(sv_z)
			#}
		ELSE
			#{
			print("inside ELSE")
			CUST.DENOM.Message = "TRANSACTION CREATED SUCESSFULLY WITH TRANID :"
			sv_s = "RESULT_MSG|" + CUST.DENOM.Message + CUST.DENOM.tranId
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
		#}
		ENDIF
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_z)
		GOTO FINISH
		
	#}
	ENDIF
	
	GOTO FINISH
	
	
	
	
	ERRORMESSAGE:
		sv_u = urhk_setOrbOut("Message|ERROR")
		print(sv_u)
		sv_u = urhk_setOrbOut("Details|" + CUST.DENOM.ERRORMESSAGE)
		print(sv_u)
		sv_r = urhk_dbSqlWithBind("rollback")
		print(sv_r)
	FINISH:
		
