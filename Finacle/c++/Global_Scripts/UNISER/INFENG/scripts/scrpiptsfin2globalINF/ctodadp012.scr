<--START
CHECKSUM="07d803e5eeac63e5903ce0c1d201ded8e90268c2975d9795638df086b835d61f"
	TRACE ON
	#------------------------------------------------------------------------------
	#  Fetching data from table C_TODA for making entry into History table.
