	BANCS.INPARAM.BINDVARS = CUST.CTODA.bankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accNum
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.availReqId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "contractId,custId,accName,solId,netTodAmount,availPeriodMM,remarks,"
	sv_s = sv_s + "createdBy,createdOn,modifiedBy,ModifiedOn,"
	sv_s = sv_s + "permiterUser,grantDate,expiryDate,"
	sv_s = sv_s + "rchgUserId,rchgDate,"
	sv_s = sv_s + "msgInd,emailFlag,smsFlag,isDeleted,chargeAmt|"
	sv_s = sv_s + " SELECT SANCT_ID,CUST_ID,ACCT_NAME,SOL_ID,REQ_AMT,PERIOD,REMARKS,"
	sv_s = sv_s + "CREATED_BY,TO_CHAR(CREATED_DATE,'DD-MM-YYYY HH24:MI:SS'),MODIFIED_BY,TO_CHAR(MODIFIED_DATE,'DD-MM-YYYY HH24:MI:SS'),"
	sv_s = sv_s + "PERMITTED_USER,TO_CHAR(GRANT_DATE,'DD-MM-YYYY'),TO_CHAR(EXPIRY_DATE,'DD-MM-YYYY'),"
