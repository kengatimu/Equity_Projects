		print(CUST.CTODA.expiryDate)
		
		CUST.CTODA.rchgUserId = BANCS.OUTPARAM.rchgUserId
		print(CUST.CTODA.rchgUserId)
		CUST.CTODA.rchgDate = BANCS.OUTPARAM.rchgDate
		print(CUST.CTODA.rchgDate)
		
		CUST.CTODA.msgInd = BANCS.OUTPARAM.msgInd
		print(CUST.CTODA.msgInd)
		CUST.CTODA.emailFlag = BANCS.OUTPARAM.emailFlag
		print(CUST.CTODA.emailFlag)
