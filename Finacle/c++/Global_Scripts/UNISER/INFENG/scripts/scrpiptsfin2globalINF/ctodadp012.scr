	#------------------------------------------------------------------------------
	# Inserting data into history table CATOD_AVAILMENT_HIST_TABLE
	#------------------------------------------------------------------------------
	#------------------changed for TO :361667-----------------------------#
	
	CUST.CTODA.remarks = "TOD CREATED AND VERIFIED"
	#------------------changed for TO :361667-----------------------------#
	
	BANCS.INPARAM.BINDVARS = CUST.CTODA.bankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accNum
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.availReqId
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.contractId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.custId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accName
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.solId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.netTodAmount
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.availPeriodMM
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.remarks
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "A"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.userId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.userId
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.createdBy
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.createdOn
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.modifiedBy
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.ModifiedOn
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.permiterUser
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.grantDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.expiryDate
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.rchgUserId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.rchgDate
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.msgInd
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.emailFlag
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.smsFlag
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.isDeleted
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.chargeAmt
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "INSERT INTO CUSTOM.CATOD_AVAILMENT_HIST_TABLE"
	sv_s = sv_s + " NAME("
	sv_s = sv_s + "BANK_ID,ACCT_NUM,REQUEST_ID,"
	sv_s = sv_s + "SANCT_ID,CUST_ID,ACCT_NAME,SOL_ID,REQ_AMT,PERIOD,REMARKS,"
	sv_s = sv_s + "STATUS_FLG,VERIFY_BY,VERIFY_DATE,LCHG_USER,LCHG_DATE,"
	sv_s = sv_s + "CREATED_BY,CREATED_DATE,MODIFIED_BY,MODIFIED_DATE,"
	sv_s = sv_s + "PERMITTED_USER,GRANT_DATE,EXPIRY_DATE,"
	sv_s = sv_s + "RCRE_USER,RCRE_DATE,"
	sv_s = sv_s + "MSG_IND,EMAIL_FLG,SMS_FLG,IS_DELETED,CHARGE_AMT"
	sv_s = sv_s + ") VALUES("
	sv_s = sv_s + "?SVAR,?SVAR,?SVAR,"
	sv_s = sv_s + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
	sv_s = sv_s + "?SVAR,?SVAR,SYSDATE,?SVAR,SYSDATE,"
	sv_s = sv_s + "?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'),?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'),"
	sv_s = sv_s + "?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY'),TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_s = sv_s + "?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'),"
	sv_s = sv_s + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR"
	sv_s = sv_s + ")"
	print(sv_s)
	sv_d = urhk_dbSQLWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		CUST.INTERFACE.errorCode = "CTODA_ERR_008"
		CALL("Common_Interface_GetErrorDesc.scr")
