<--START
CHECKSUM="68e523760c8f1205ecf9dc347ce66bea436d915eb4ee7bf19c14db332341e4be"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
