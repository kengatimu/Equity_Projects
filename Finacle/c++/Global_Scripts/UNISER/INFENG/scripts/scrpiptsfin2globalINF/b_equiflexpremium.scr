		CREATECLASS("CUSTS","EQUIF",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUSTS","CPARAM", 5)
	#}
	ENDIF
	
	CUSTS.EQUIF.errMsg = ""
	CUSTS.EQUIF.annual = ""
	
	sv_s="year,month|"
	sv_s = sv_s + "select substr( ?SVAR,7, 4),substr( ?SVAR,4, 2) from dual "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.BODDate +  "|" + BANCS.STDIN.BODDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d==0) THEN
	#{
		CUSTS.EQUIF.year= BANCS.OUTPARAM.year
		PRINT(CUSTS.EQUIF.year)
		
		CUSTS.EQUIF.month= BANCS.OUTPARAM.month
		PRINT(CUSTS.EQUIF.month)
	#}
	ENDIF
	
	IF (CUSTS.EQUIF.month<="06") THEN
	#{
		
		CUSTS.EQUIF.year1=CINT(CUSTS.EQUIF.year)
		PRINT(CUSTS.EQUIF.year)
		
	#}
	ELSE
	#{
		
		CUSTS.EQUIF.year1=CINT(CUSTS.EQUIF.year) +1
		PRINT(CUSTS.EQUIF.year1)
	#}
	ENDIF
	
	
	
	BANCS.INPUT.moduleName = "INSURANCE"
	BANCS.INPUT.parameterId = "STARTDATE"
	CALL("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUSTS.EQUIF.START = BANCS.OUTPUT.parameterVal+ CUSTS.EQUIF.year
		PRINT(CUSTS.EQUIF.START)
		#}
	ELSE
		#{
		CUSTS.EQUIF.errMsg = "CPARAM setup not done for credit account number"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "INSURANCE"
	BANCS.INPUT.parameterId = "ENDDATE"
	CALL("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUSTS.EQUIF.enddate = BANCS.OUTPUT.parameterVal + CUSTS.EQUIF.year1
		PRINT(CUSTS.EQUIF.enddate)
		#}
	ELSE
		#{
		CUSTS.EQUIF.errMsg = "CPARAM setup not done for credit account number"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	
	PRINT(BANCS.STDIN.sysDate)
	BANCS.STDIN.sysDate1 = MID$(BANCS.STDIN.sysDate,0,10)
	PRINT(BANCS.STDIN.sysDate1)
	
	BANCS.INPARAM.date1 = CUSTS.EQUIF.enddate
	BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
	sv_a = urhk_B2k_dateDiff("")
	PRINT(BANCS.OUTPARAM.dateDiff)
	
	IF (BANCS.OUTPARAM.dateDiff<="0") THEN
	#{
		
		CUSTS.EQUIF.errMsg = "Kindly Set Up the new Year"
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	PRINT(BANCS.STDIN.BODDate)
	BANCS.STDIN.BODDate1 = MID$(BANCS.STDIN.BODDate,0,10)
	PRINT(BANCS.STDIN.BODDate1)
	
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="foracid,clrbal|"
	sv_s = sv_s + " select foracid,clr_bal_amt from tbaadm.gam where schm_code='SB127' AND sol_id= ?SVAR"
	sv_s = sv_s + " AND acct_opn_date=to_date(?SVAR,'dd-mm-yyyy') AND bank_id= ?SVAR AND clr_bal_amt>='500' "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.BODDate1 + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.EQUIF.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.EQUIF.DbcursorNumber)
		PRINT(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUSTS.EQUIF.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.EQUIF.clrbal	= BANCS.OUTPARAM.clrbal
			
			PRINT(CUSTS.EQUIF.foracid)
			PRINT(CUSTS.EQUIF.clrbal)
			
			BANCS.INPARAM.date1 = CUSTS.EQUIF.enddate
			BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
			sv_e = urhk_B2k_dateDiff("")
			PRINT(BANCS.OUTPARAM.dateDiff)
			
			
			CUSTS.EQUIF.clrbal1=(CDOUBLE(CUSTS.EQUIF.clrbal)*3)
			PRINT(CUSTS.EQUIF.clrbal1)
			
			
			IF ((CDOUBLE(CUSTS.EQUIF.clrbal1)<="50000.0000") AND (CDOUBLE(CUSTS.EQUIF.clrbal1)>"500.0000")) THEN
			#{
				
				CUSTS.EQUIF.annual="375"
				PRINT(CUSTS.EQUIF.annual)
				
			#}
			ELSE
			#{
				IF ((CDOUBLE(CUSTS.EQUIF.clrbal1)>"50000.0000") AND (CDOUBLE(CUSTS.EQUIF.clrbal1)<="30000000.0000"))  THEN
				#{
					
					CUSTS.EQUIF.annual=(CDOUBLE(CUSTS.EQUIF.clrbal1)*0.0075)
					PRINT(CUSTS.EQUIF.annual)
					
				#}
				ELSE
				#{
					IF (CDOUBLE(CUSTS.EQUIF.clrbal1)>"30000000.0000") THEN
					#{
						
						CUSTS.EQUIF.annual=(30000000*0.0075)
						PRINT(CUSTS.EQUIF.annual)
					#}
					ENDIF
					
				#}
				ENDIF
				
				
			#}
			ENDIF
			
			CUSTS.EQUIF.tfee=(CDOUBLE(CUSTS.EQUIF.annual) * CDOUBLE(BANCS.OUTPARAM.dateDiff))/365
			PRINT (CUSTS.EQUIF.tfee)
			
			
			#--------------------------------------------------------------------------
			# Initialise the MTT repository
			#--------------------------------------------------------------------------
			
			sv_r = REPEXISTS("MTT")
			IF (sv_r == 0) THEN
			#{
				CREATEREP("MTT")
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("MTT","TranDetails")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("MTT","TranDetails",5)
			#}
			ENDIF
			
			sv_r = REPEXISTS("BANCS")
			IF (sv_r == 0) THEN
			#{
				CREATEREP("BANCS")
			#}
			ENDIF
			
			sv_r = CLASSEXISTS("BANCS","INPARAM")
			IF (sv_r == 0) THEN
			#{
				CREATECLASS("BANCS","INPARAM",5)
			#}
			ENDIF
			
			#===================================
			# STEP 1 : INITIALIZE THE MTT
			#===================================
			
			BANCS.INPARAM.PostTranFlg 		= "Y"
			BANCS.INPARAM.CommitFlg 		= "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg 	= "Y"
			BANCS.INPARAM.ValidationFlag 		= "Y"
			BANCS.INPARAM.RestrictModifyInd 	= "FIRST_GROUP"
			BANCS.INPARAM.ErrorCheckForLuw 		= "Y"
			BANCS.INPARAM.CheckExceptions 		= "N"
			
			
			
			#sv_r = urhk_MTTS_Initialize("")
			#print(sv_r)
			
			sv_u = urhk_MTTS_PopulateInputDetails("")
			
			PRINT(BANCS.STDIN.BODDate)
			#MTT.TranDetails.TranDate= "0"
			MTT.TranDetails.TranType = "T"
			MTT.TranDetails.TranSubType = "BI"
			MTT.TranDetails.IgnoreExcp = "I"
			MTT.TranDetails.Consolidate = "Y"
			MTT.TranDetails.Remarks = "PREMIUM COLLECTION"
			
			
			sv_v = "PurchaseComm"
			PRINT(sv_v)
			
			sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
			PRINT(sv_u)
			
			#sv_u = urhk_MTTS_PopulateInputDetails("")
			#--------------------------------------------------
			# Credit to GL
			#--------------------------------------------------
			
			MTT.PartTranDetails.Account = "0180294058928"
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.RateCode ="MEAN"
			MTT.PartTranDetails.Rate = "0"
			MTT.PartTranDetails.Particulars = "PREMIUM COLLECTION"
			MTT.PartTranDetails.RefAmount = CDOUBLE(CUSTS.EQUIF.tfee)
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = ""
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_e = "PurchaseIncome"
			sv_r = urhk_MTTS_definePartTran(sv_e)
			PRINT(sv_r)
			
			#------------------------------------------------------------------
			# Debit From BR
			#------------------------------------------------------------------
			
			MTT.PartTranDetails.Account = CUSTS.EQUIF.foracid
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.RateCode ="MEAN"
			MTT.PartTranDetails.Rate = "0"
			MTT.PartTranDetails.Particulars = "PREMIUM COLLECTION"
			sv_a = CDOUBLE(CUSTS.EQUIF.tfee)
			sv_a = -(sv_a)
			PRINT(sv_a)
			MTT.PartTranDetails.RefAmount = sv_a
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = ""
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_h = "D" + CUSTS.EQUIF.foracid
			
			sv_r = urhk_MTTS_definePartTran(sv_h)
			PRINT(sv_r)
			IF (sv_r == 1) THEN
			#{
				PRINT("Unable to create MTT Part transaction")
				CUST.EQUIF.errMsg = "Transaction creation Failed."
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#############################
			# Commit the transaction
			#############################
			sv_u = urhk_MTTS_EndDefinition("")
			PRINT(sv_u)
			
			CUSTS.EQUIF.TranId = BANCS.OUTPARAM.MTTTranId
			PRINT(CUSTS.EQUIF.TranId)
			
			
			##################################################
			# If any error tran id will not be created
			##################################################
			IF ((sv_u != 0)  OR (CUSTS.EQUIF.TranId==""))THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT (MTT.Error.Description)
				CUSTS.EQUIF.ResStatus = "F"
				CUSTS.EQUIF.Response = "Transaction creation Failed."
				BANCS.OUTPUT.successOrFailure = "F"
				#GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUSTS.EQUIF.DbcursorNumber)
			PRINT(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.EQUIF.DbcursorNumber)
		PRINT(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.EQUIF.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUSTS.EQUIF.errMsg+"' >>equiflex.log")
		#}
		ENDIF
		
		EXITSCRIPT
