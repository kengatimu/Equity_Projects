<--START
CHECKSUM="721e0b27f4f1abddc5ab38bd22507b0a197e15f6239104c2fadd5314662b658e"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("UPM") == 0) THEN
	#{
		CREATEREP("UPM")
	#}
	ENDIF
	
	IF (CLASSEXISTS("UPM","STRDATA") == 0) THEN
	#{
		CREATECLASS("UPM","STRDATA",5)
	#}
	ENDIF
	
	UPM.STRDATA.errMsg = ""
	
	BANCS.INPUT.moduleName  = "UPMWORKCLASS"
	BANCS.INPUT.parameterId = "WORK_CLASSVAL12"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		UPM.STRDATA.work_classval12 = BANCS.OUTPUT.parameterVal
		PRINT(UPM.STRDATA.work_classval12)
		#}
	ELSE
		#{
		UPM.STRDATA.errMsg = "CPARAM setup not done for workclss"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "WORK_CLASSVAL9"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		UPM.STRDATA.work_class9 = BANCS.OUTPUT.parameterVal
		PRINT(UPM.STRDATA.work_class9)
		#}
	ELSE
		#{
		UPM.STRDATA.errMsg = "CPARAM setup not done for workclss"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "WORK_CLASSVAL16"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		UPM.STRDATA.work_classval16 = BANCS.OUTPUT.parameterVal
		PRINT(UPM.STRDATA.work_classval16)
		#}
	ELSE
		#{
		UPM.STRDATA.errMsg = "CPARAM setup not done for workclss"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "ROLE_ID1"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		UPM.STRDATA.role_id1 = BANCS.OUTPUT.parameterVal
		PRINT(UPM.STRDATA.role_id1)
		#}
	ELSE
		#{
		UPM.STRDATA.errMsg = "CPARAM setup not done for Role ID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "ROLEID7"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		UPM.STRDATA.role_id7 = BANCS.OUTPUT.parameterVal
		PRINT(UPM.STRDATA.role_id7)
		#}
	ELSE
		#{
		UPM.STRDATA.errMsg = "CPARAM setup not done for roleID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("usrGenDtl.workClass.refCode")
	UPM.STRDATA.WorkClass = BANCS.OUTPARAM.srvValue
	PRINT(UPM.STRDATA.WorkClass)
	
	UPM.STRDATA.WorkClass	  = CINT(UPM.STRDATA.WorkClass)
	PRINT(UPM.STRDATA.WorkClass)
	UPM.STRDATA.UserWorkClass = CINT(BANCS.STDIN.userWorkClass)
	PRINT(UPM.STRDATA.UserWorkClass)
	
	PRINT(UPM.STRDATA.work_classval12)
	IF (CINT(UPM.STRDATA.UserWorkClass) != CINT(UPM.STRDATA.work_classval12)) THEN
	#{
		PRINT("AM IN")
		PRINT(BANCS.STDIN.roleId)
		PRINT(UPM.STRDATA.role_id7)
		PRINT(UPM.STRDATA.role_id1)
		
		IF ((BANCS.STDIN.roleId != UPM.STRDATA.role_id1) AND (BANCS.STDIN.roleId != UPM.STRDATA.role_id7)) THEN
		#{
			PRINT(UPM.STRDATA.WorkClass)
			PRINT(UPM.STRDATA.work_class9)
			PRINT(UPM.STRDATA.work_classval16)
			
			IF ((CINT(UPM.STRDATA.WorkClass) > CINT(UPM.STRDATA.work_class9)) AND (CINT(UPM.STRDATA.WorkClass) != CINT(UPM.STRDATA.work_classval16))) THEN
			#{
				UPM.STRDATA.errMsg = "User Work Class Cannot cannot be granted Contact Admin"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(UPM.STRDATA.WorkClass)
	
	ENDOFSCRIPT:
		IF (UPM.STRDATA.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(UPM.STRDATA.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
