<--START
CHECKSUM="8ee9bdcebba812e0d46afcf882ab10f6004e3fe936fc8b319b5e51fd4e4a40de"
	#************************************************************************
	# Formatting of date from Finacle message format  to Paysys date format
	#********************************************************************
	# Input  :
	#       	BANCS.INPUT.PaysysId   --> Give PaysysId here as formatting may differ for dif. Payment System
	# 			BANCS.INPUT.FinDate --> Give Input date here.
	# Output :
	#			BANCS.OUTPUT.PaysysDate   --> Script gives back formatted date here.
	#
	#********************************************************************
	TRACE ON
	BANCS.OUTPUT.PaysysDate = ""
	IF(BANCS.INPUT.FinDate != "") THEN
	#{
		IF( (BANCS.INPUT.PaysysId == "SWIFT")  OR ( BANCS.INPUT.PaysysId =="RTGS")) THEN
		#{
			BANCS.INPUT.FinDate = ltrim(BANCS.INPUT.FinDate, ' ')
			# SWIFT date formate is YYMMDD and FiNACLE format is DD-MM-YYYY
			BANCS.OUTPUT.PaysysDate = mid$(BANCS.INPUT.FinDate, 8, 2) + mid$(BANCS.INPUT.FinDate, 3, 2) + mid$(BANCS.INPUT.FinDate, 0, 2)
			
			# The below code is added to handle Tag13D for FCXSCH.
			IF((BANCS.INPUT.CurrLocalTag == 13) AND (BANCS.INPUT.CurrLocalTagLit == "D")) THEN
			#{
				BANCS.INPUT.FinTime = mid$(BANCS.INPUT.FinDate,11, 8)
				call("FinToPaysysTime.scr")
				BANCS.OUTPUT.PaysysDate = BANCS.OUTPUT.PaysysDate + BANCS.OUTPUT.PaysysTime
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	TRACE OFF
END-->
