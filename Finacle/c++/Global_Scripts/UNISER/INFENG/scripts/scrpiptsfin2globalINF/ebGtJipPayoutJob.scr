#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Rep/Class
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	EQSRV.GLBDATA.glSubHeadCode = ""
	EQSRV.GLBDATA.acctCloseDate = ""
	EQSRV.GLBDATA.acctSolId = ""
	EQSRV.GLBDATA.schmCode = ""
	EQSRV.GLBDATA.clearBalance = ""
	EQSRV.GLBDATA.AvailableAmt = ""
	EQSRV.GLBDATA.EffAvailableAmt = ""
	EQSRV.GLBDATA.goalCrncy = ""
	EQSRV.GLBDATA.goalacid = ""
	EQSRV.GLBDATA.valerr = ""
	EQSRV.GLBDATA.gSourceAcct = ""
	EQSRV.GLBDATA.gGoalMonths = ""
	EQSRV.GLBDATA.gGoalDays = ""
	EQSRV.GLBDATA.gPayoutDays = ""
	EQSRV.GLBDATA.gdummyExpiryDate = ""
	EQSRV.GLBDATA.gAprYN = ""
	EQSRV.GLBDATA.gOctYN = ""
	EQSRV.GLBDATA.gActiveDate = ""
	EQSRV.GLBDATA.gExpiryDate = ""
	EQSRV.GLBDATA.gMobileNumber  = ""
	EQSRV.GLBDATA.gStartDate = ""
	EQSRV.GLBDATA.firstCnt = ""
	EQSRV.GLBDATA.goalIntBal = ""
	EQSRV.GLBDATA.nxtPayoutDate  = ""
	EQSRV.GLBDATA.addmnths = ""
	EQSRV.GLBDATA.firstpayoutDate = ""
	EQSRV.GLBDATA.dateDiff = ""
	EQSRV.GLBDATA.payoutAmt = ""
	EQSRV.GLBDATA.nxtPayoutDate = ""
	EQSRV.GLBDATA.isTranYN = ""
	EQSRV.GLBDATA.payYN = ""
	EQSRV.GLBDATA.payoutDate = ""
	EQSRV.GLBDATA.payoutTranId = ""
	EQSRV.GLBDATA.goalType = ""
	EQSRV.GLBDATA.payMode = ""
        #sv_u = urhk_MTTS_PopulateInputDetails("")
        #print(sv_u)
        #if(sv_u == 0)then
        #        print(MTT.InputDetails.Argument1)
	#	EQSRV.GLBDATA.goalAcctId = MTT.InputDetails.Argument1
        #else
        #        sv_u = urhk_MTTS_Close("")
        #        print(sv_u)
                #goto VAYU
        #endif
	##EQSRV.GLBDATA.goalAcctId = "1100171223102"
	##DV
	##EQSRV.GLBDATA.goalAcctId = "0740171223104"
	EQSRV.GLBDATA.goalAcctId = "1230171223114"
#GoalData
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.goalAcctId)
        if(sv_u==0)then
		EQSRV.GLBDATA.glSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
                EQSRV.GLBDATA.acctCloseDate = BANCS.OUTPARAM.acctCloseDate
                EQSRV.GLBDATA.acctSolId = BANCS.OUTPARAM.acctSolId
                EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
                EQSRV.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
                EQSRV.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt
                EQSRV.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
                EQSRV.GLBDATA.goalCrncy = BANCS.OUTPARAM.acctCrncyCode
                sv_u = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.goalAcctId)
                if(sv_u==0)then
                        EQSRV.GLBDATA.goalacid = BANCS.OUTPARAM.Acid
                else
                        EQSRV.GLBDATA.valerr    = "Invalid Goal Account " + EQSRV.GLBDATA.goalAcctId
                        EQSRV.GLBDATA.payYN     = "N"
                        goto VAYU
                endif
        endif
        sv_u = urhk_getAdvanceDetailsForAccount(EQSRV.GLBDATA.goalAcctId)
        if(sv_u==0)then
                EQSRV.GLBDATA.gSourceAcct = BANCS.OUTPARAM.gacFreeText1
                EQSRV.GLBDATA.gGoalMonths = BANCS.OUTPARAM.gacFreeText2
                EQSRV.GLBDATA.gGoalDays = BANCS.OUTPARAM.gacFreeText3
                EQSRV.GLBDATA.gPayoutDays = BANCS.OUTPARAM.gacFreeText4
                EQSRV.GLBDATA.gdummyExpiryDate = BANCS.OUTPARAM.gacFreeText5
                EQSRV.GLBDATA.gAprYN = BANCS.OUTPARAM.gacFreeText7
                EQSRV.GLBDATA.gOctYN = BANCS.OUTPARAM.gacFreeText8
                EQSRV.GLBDATA.gActiveDate = BANCS.OUTPARAM.gacFreeText9
                EQSRV.GLBDATA.gExpiryDate = BANCS.OUTPARAM.gacFreeText10
                EQSRV.GLBDATA.gMobileNumber = BANCS.OUTPARAM.gacFreeText11
                EQSRV.GLBDATA.gStartDate = BANCS.OUTPARAM.gacFreeText12
                if(EQSRV.GLBDATA.gSourceAcct != "")then
                        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.gSourceAcct)
                        if(sv_u!=0)then
                                EQSRV.GLBDATA.valerr    = "Invalid SOurce Account for Goal " + EQSRV.GLBDATA.goalAcctId
                                EQSRV.GLBDATA.payYN     = "N"
                                goto VAYU
                        endif
                endif
        else
                EQSRV.GLBDATA.valerr    = "Invalid Goal Account " + EQSRV.GLBDATA.goalAcctId
                EQSRV.GLBDATA.payYN     = "N"
                goto VAYU
        endif
	#++++++++++++++++++++
	#get next payout date
	#++++++++++++++++++++
	sv_d = " firstCnt,goalIntBal,nxtPayoutDate| select count(*),goal_int_bal,to_char(nxt_payout_date,'DD-MM-YYYY') from  custom.ebgtgoal_jjpayout "
	sv_d = sv_d + " where bank_id=?SVAR "
	sv_d = sv_d + " and goal_acctid=?SVAR "
	sv_d = sv_d + " and first_payout_date is not null "
	sv_d = sv_d + " and first_payout_tranid is not null "
	sv_d = sv_d + " and del_flg='N' "
	sv_d = sv_d + " group by goal_int_bal,nxt_payout_date "
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ EQSRV.GLBDATA.goalAcctId 	
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.firstCnt = BANCS.OUTPARAM.firstCnt
		EQSRV.GLBDATA.goalIntBal = BANCS.OUTPARAM.goalIntBal
		EQSRV.GLBDATA.nxtPayoutDate = BANCS.OUTPARAM.nxtPayoutDate
	else
		EQSRV.GLBDATA.firstCnt = "0"
		EQSRV.GLBDATA.goalIntBal = "0"
		EQSRV.GLBDATA.nxtPayoutDate = ""
	endif
	#++++++++++++++++++++++++++
	#First Payout Logic Starts
	#++++++++++++++++++++++++++
	if(cint(EQSRV.GLBDATA.firstCnt)<=0)then
	##{
		EQSRV.GLBDATA.addmnths  = "1"
		if(EQSRV.GLBDATA.gStartDate !="")then
			print(EQSRV.GLBDATA.gStartDate)
			print(EQSRV.GLBDATA.gPayoutDays)
			EQSRV.GLBDATA.firstpayoutDate = (EQSRV.GLBDATA.gStartDate + "|" + EQSRV.GLBDATA.addmnths + "|" + EQSRV.GLBDATA.gPayoutDays)
			print(EQSRV.GLBDATA.firstpayoutDate)
			sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.firstpayoutDate)
			print(sv_u)
			if(sv_u != 0)then
				##EQSRV.GLBDATA.limitExpDate = LEFT$(BANCS.STDIN.BODDate,10)
			else
				EQSRV.GLBDATA.firstpayoutDate = BANCS.OUTPARAM.MODIFIED_DATE
				print(EQSRV.GLBDATA.firstpayoutDate)
			endif
		endif
		print(EQSRV.GLBDATA.firstpayoutDate)
		print(BANCS.STDIN.BODDate)
		BANCS.INPARAM.date1 = EQSRV.GLBDATA.firstpayoutDate
		BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
		sv_a = urhk_B2k_dateDiff("")
		if(sv_a==0)then
			print(BANCS.OUTPARAM.dateDiff)
			EQSRV.GLBDATA.dateDiff = BANCS.OUTPARAM.dateDiff
		endif
		if(EQSRV.GLBDATA.dateDiff==0)then
			print(EQSRV.GLBDATA.clearBalance)
			print(EQSRV.GLBDATA.gGoalMonths)
			EQSRV.GLBDATA.payoutAmt = cdouble(EQSRV.GLBDATA.clearBalance) / cint(EQSRV.GLBDATA.gGoalMonths)
		else
			EQSRV.GLBDATA.valerr    = "No Salary Payout"
			EQSRV.GLBDATA.payYN     = "N"
			goto VAYU
		endif
	else
		##EQSRV.GLBDATA.payoutAmt = cdouble(EQSRV.GLBDATA.goalIntBal) / cint(EQSRV.GLBDATA.gGoalMonths)
		EQSRV.GLBDATA.payoutAmt = cdouble(EQSRV.GLBDATA.clearBalance) / cint(EQSRV.GLBDATA.gGoalMonths)
		print(BANCS.STDIN.BODDate)
		EQSRV.GLBDATA.nxtPayoutDate = EQSRV.GLBDATA.nxtPayoutDate + " 00:00:00"
		print(EQSRV.GLBDATA.nxtPayoutDate)
		BANCS.INPARAM.date1 = EQSRV.GLBDATA.nxtPayoutDate
		BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
		sv_a = urhk_B2k_dateDiff("")
		if(sv_a==0)then
			print(BANCS.OUTPARAM.dateDiff)
			EQSRV.GLBDATA.dateDiff = BANCS.OUTPARAM.dateDiff
		endif
		print(EQSRV.GLBDATA.dateDiff)
		if(EQSRV.GLBDATA.dateDiff!=0)then
			EQSRV.GLBDATA.valerr    = "No Salary Payout"
			EQSRV.GLBDATA.payYN     = "N"
			goto VAYU
		endif
	##}
	endif
	#++++++++++++++++++++++++++
	#First Payout Logic Ends
	#++++++++++++++++++++++++++
	#Salary Payout Logic	
	#++++++++++++++++++++++++++
	if((cdouble(EQSRV.GLBDATA.payoutAmt)>0) and (cdouble(EQSRV.GLBDATA.payoutAmt) <= cdouble(EQSRV.GLBDATA.clearBalance)) and (EQSRV.GLBDATA.gSourceAcct!=""))then
		EQSRV.GLBDATA.payYN = "Y"	
	else
		EQSRV.GLBDATA.valerr    = "No Salary Payout"
		EQSRV.GLBDATA.payYN     = "N"
		goto VAYU
	endif
        sv_a = urhk_MTTS_Close("")
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","TranDetails")==0)then
                createclass("MTT","TranDetails",5)
        endif
        if(classexists("MTT","PartTranDetails")==0)then
                createclass("MTT","PartTranDetails",5)
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif

        BANCS.INPARAM.PostTranFlg       = "Y"
        BANCS.INPARAM.CommitFlg         = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
        BANCS.INPARAM.ValidationFlag    = "Y"
        BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw  ="Y"

        sv_a = urhk_MTTS_Initialize("")
        MTT.TranDetails.TranDate        = "0"
        MTT.TranDetails.TranType        = "T"
        MTT.TranDetails.TranSubType     = "BI"
        MTT.TranDetails.Remarks         = "GeorgeTown Goals JJPayOut"
        MTT.TranDetails.IgnoreExcp      = "Y"
        MTT.TranDetails.PrintAdviceInd  = "B"
        MTT.TranDetails.TranIdOnline    = "N"
        sv_u = urhk_MTTS_defineTransaction("JipangePayOut")
        if(sv_u != 0) then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.valerr    = MTT.Error.Description
                        EQSRV.GLBDATA.payYN     = "N"
                endif
                goto VAYU
        endif
        sv_u = urhk_MTTS_populateInputDetails("")
        if(sv_u != 0) then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.valerr    = MTT.Error.Description
                        EQSRV.GLBDATA.payYN     = "N"
                endif
                goto VAYU
        endif
#Debit
        print(EQSRV.GLBDATA.goalAcctId)
        MTT.PartTranDetails.Account     = EQSRV.GLBDATA.goalAcctId 
        MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
        MTT.PartTranDetails.ValueDateDiff = "0"
        MTT.PartTranDetails.Particulars = "Dr.For " + EQSRV.GLBDATA.gSourceAcct + " / Goals "
        MTT.PartTranDetails.RefAmount   = -1 * cdouble(EQSRV.GLBDATA.payoutAmt)
	if(EQSRV.GLBDATA.firstpayoutDate!="")then
		MTT.PartTranDetails.Remarks     = "PayOut for:" + EQSRV.GLBDATA.firstpayoutDate
	endif
	if(EQSRV.GLBDATA.nxtPayoutDate!="")then
		MTT.PartTranDetails.Remarks     = "PayOut for:" + EQSRV.GLBDATA.nxtPayoutDate
	endif
        MTT.PartTranDetails.RefNum      = EQSRV.GLBDATA.gSourceAcct
        MTT.PartTranDetails.Consolidate = "N"
        MTT.PartTranDetails.TranIdentifier = "JipangePayOut"
        ##MTT.PartTranDetails.ReportCode = sv_z
        sv_u = urhk_MTTS_definePartTran("SettleDr")
        print(sv_u)
        if(sv_u!=0)then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.valerr    = MTT.Error.Description
                        EQSRV.GLBDATA.payYN     = "N"
                        goto VAYU
                endif
        endif
#Credit
        print(EQSRV.GLBDATA.gSourceAcct)
        MTT.PartTranDetails.Account     = EQSRV.GLBDATA.gSourceAcct
        MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
        MTT.PartTranDetails.ValueDateDiff = "0"
        MTT.PartTranDetails.Particulars = "Cr.From " + EQSRV.GLBDATA.goalAcctId 
        MTT.PartTranDetails.RefAmount   = 1 * cdouble(EQSRV.GLBDATA.payoutAmt)
	if(EQSRV.GLBDATA.firstpayoutDate != "")then
		MTT.PartTranDetails.Remarks     = "PayOut for:" + EQSRV.GLBDATA.firstpayoutDate
	endif
	if(EQSRV.GLBDATA.nxtPayoutDate!="")then
		MTT.PartTranDetails.Remarks     = "PayOut for:" + EQSRV.GLBDATA.nxtPayoutDate
	endif
        MTT.PartTranDetails.RefNum      = EQSRV.GLBDATA.goalAcctId
        MTT.PartTranDetails.Consolidate = "N"
        MTT.PartTranDetails.TranIdentifier = "JipangePayOut"
        ##MTT.PartTranDetails.ReportCode = sv_z
        sv_u = urhk_MTTS_definePartTran("SettleDr")
        print(sv_u)
        if(sv_u!=0)then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.valerr    = MTT.Error.Description
                        EQSRV.GLBDATA.payYN     = "N"
                        goto VAYU
                endif
        endif
        sv_u = urhk_MTTS_endDefinition("")
        if(sv_u!=0)then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.valerr    = MTT.Error.Description
			EQSRV.GLBDATA.payYN = "N"
                        goto VAYU
                endif
        else
                print(BANCS.OUTPARAM.MTTTranId)
                EQSRV.GLBDATA.payoutTranId = BANCS.OUTPARAM.MTTTranId
		EQSRV.GLBDATA.valerr    = "Success" 
		EQSRV.GLBDATA.payYN = "Y"
        endif
        sv_u = urhk_MTTS_Close("")
        print(sv_u)
	#+++++++++++++++++++++++++
	#Next Payout Logic Starts
	#+++++++++++++++++++++++++
	if((cint(EQSRV.GLBDATA.firstCnt)<=0) and (EQSRV.GLBDATA.payYN=="Y") and (EQSRV.GLBDATA.payoutTranId!=""))then
		print(EQSRV.GLBDATA.firstpayoutDate)
		EQSRV.GLBDATA.addmnths = "1"
		EQSRV.GLBDATA.payoutDate = (EQSRV.GLBDATA.firstpayoutDate + "|" + EQSRV.GLBDATA.addmnths + "|" +EQSRV.GLBDATA.gPayoutDays)
	endif
	if((cint(EQSRV.GLBDATA.firstCnt)>=1) and (EQSRV.GLBDATA.payYN=="Y") and (EQSRV.GLBDATA.payoutTranId!=""))then
		print(EQSRV.GLBDATA.nxtPayoutDate)
		EQSRV.GLBDATA.addmnths = "1"
		EQSRV.GLBDATA.payoutDate = (EQSRV.GLBDATA.nxtPayoutDate + "|" + EQSRV.GLBDATA.addmnths + "|" +EQSRV.GLBDATA.gPayoutDays)
	endif
	sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.payoutDate)
	print(sv_u)
	if(sv_u != 0)then
		##EQSRV.GLBDATA.limitExpDate = LEFT$(BANCS.STDIN.BODDate,10)
	else
		EQSRV.GLBDATA.nxtPayoutDate = BANCS.OUTPARAM.MODIFIED_DATE
		print(EQSRV.GLBDATA.nxtPayoutDate)
	endif
	#+++++++++++++++++++++++++
	#Next Payout Logic  Ends
	#+++++++++++++++++++++++++
	##Payout Data
	if((cint(EQSRV.GLBDATA.firstCnt)<=0) and (EQSRV.GLBDATA.payYN=="Y") and (EQSRV.GLBDATA.payoutTranId!=""))then
	##{
	if(EQSRV.GLBDATA.gAprYN!="")then
		EQSRV.GLBDATA.goalType = EQSRV.GLBDATA.gAprYN
	endif
	if(EQSRV.GLBDATA.gOctYN!="")then
		EQSRV.GLBDATA.goalType = EQSRV.GLBDATA.gOctYN
	endif
	EQSRV.GLBDATA.payMode = "BATCH"
	EQSRV.GLBDATA.gStartDate = mid$(EQSRV.GLBDATA.gStartDate,0,10)
	EQSRV.GLBDATA.gdummyExpiryDate = mid$(EQSRV.GLBDATA.gdummyExpiryDate,0,10)
	EQSRV.GLBDATA.gExpiryDate = mid$(EQSRV.GLBDATA.gExpiryDate,0,10)
	EQSRV.GLBDATA.firstpayoutDate	= mid$(EQSRV.GLBDATA.firstpayoutDate,0,10)	
	EQSRV.GLBDATA.nxtPayoutDate = mid$(EQSRV.GLBDATA.nxtPayoutDate,0,10)
	sv_i = " INSERT INTO custom.ebgtgoal_jjpayout ("
	    sv_i = sv_i + "bank_id,"
	    sv_i = sv_i + "goal_module,"
	    sv_i = sv_i + "goal_acctid,"
	    sv_i = sv_i + "goal_int_bal,"
	    sv_i = sv_i + "source_acctid,"
	    sv_i = sv_i + "goal_start_date,"
	    sv_i = sv_i + "goal_dummyexp_dt,"
	    sv_i = sv_i + "goal_expiry_date,"
	    sv_i = sv_i + "first_payout_date,"
	    sv_i = sv_i + "first_payout_amt,"
	    sv_i = sv_i + "first_payout_tranid,"
	    sv_i = sv_i + "last_payout_date,"
	    sv_i = sv_i + "last_payout_amt,"
	    sv_i = sv_i + "last_payout_tranid,"
	    sv_i = sv_i + "nxt_payout_date,"
	    sv_i = sv_i + "payout_sucyn,"
	    sv_i = sv_i + "payout_msg,"
	    sv_i = sv_i + "payout_mode,"
	    sv_i = sv_i + "rcre_user_id,"
	    sv_i = sv_i + "rcre_time,"
	    sv_i = sv_i + "lchg_user_id,"
	    sv_i = sv_i + "lchg_time,"
	    sv_i = sv_i + "del_flg"
	sv_i = sv_i + ") VALUES ("
	    sv_i = sv_i + "'"+BANCS.STDIN.contextBankId+"',"
	    sv_i = sv_i + "'GTJIP',"
	    sv_i = sv_i + "'"+EQSRV.GLBDATA.goalAcctId+"',"
	    sv_i = sv_i + ""+EQSRV.GLBDATA.clearBalance+","
	    sv_i = sv_i + "'"+EQSRV.GLBDATA.gSourceAcct+"',"
	    sv_i = sv_i + "TO_DATE('"+EQSRV.GLBDATA.gStartDate+"','DD-MM-RR'),"
	    sv_i = sv_i + "TO_DATE('"+EQSRV.GLBDATA.gdummyExpiryDate+"','DD-MM-RR'),"
	    sv_i = sv_i + "TO_DATE('"+EQSRV.GLBDATA.gExpiryDate+"','DD-MM-RR'),"
	    sv_i = sv_i + "TO_DATE('"+EQSRV.GLBDATA.firstpayoutDate+"','DD-MM-RR'),"
	    sv_i = sv_i + ""+EQSRV.GLBDATA.payoutAmt+","
	    sv_i = sv_i + "'"+EQSRV.GLBDATA.payoutTranId+"',"
	    sv_i = sv_i + "TO_DATE('"+EQSRV.GLBDATA.firstpayoutDate+"','DD-MM-RR'),"
	    sv_i = sv_i + ""+EQSRV.GLBDATA.payoutAmt+","
	    sv_i = sv_i + "'"+EQSRV.GLBDATA.payoutTranId+"',"
	    sv_i = sv_i + "TO_DATE('"+EQSRV.GLBDATA.nxtPayoutDate+"','DD-MM-RR'),"
	    sv_i = sv_i + "'"+EQSRV.GLBDATA.payYN+"',"
	    sv_i = sv_i + "'"+EQSRV.GLBDATA.valerr+"',"
	    sv_i = sv_i + "'"+EQSRV.GLBDATA.payMode+"',"
	    sv_i = sv_i + "'"+BANCS.STDIN.userId+"',"
	    sv_i = sv_i + "SYSDATE,"
	    sv_i = sv_i + "'"+BANCS.STDIN.userId+"',"
	    sv_i = sv_i + "SYSDATE,"
    	    sv_i = sv_i + "'N')"
	print(BANCS.INPARAM.BINDVARS)
	print(sv_i)
	sv_u = urhk_dbSqlWithBind(sv_i)
	if(sv_u==0)then
		sv_u = urhk_dbSqlWithBind("commit")
	else
		sv_u = urhk_dbSqlWithBind("rollback")
	endif
	##}
	endif
	if((cint(EQSRV.GLBDATA.firstCnt)>=1) and (EQSRV.GLBDATA.payYN=="Y") and (EQSRV.GLBDATA.payoutTranId!=""))then
	##{
	sv_u = "update custom.ebgtgoal_jjpayout set " 
	sv_u = sv_u + " last_payout_date = sysdate," 
	sv_u = sv_u + " last_payout_amt = ?NVAR ," 
	sv_u = sv_u + " last_payout_tranid = ?SVAR ," 
	sv_u = sv_u + " nxt_payout_date = to_date(?SVAR,'DD-MM-RR') ," 
	sv_u = sv_u + " payout_sucyn = 'Y' ,"
	sv_u = sv_u + " lchg_user_id = ?SVAR, "
	sv_u = sv_u + " lchg_time = sysdate " 
	sv_u = sv_u + " where bank_id=?SVAR "
	sv_u = sv_u + " and goal_acctid=?SVAR "
	sv_u = sv_u + " and first_payout_date is not null "
	sv_u = sv_u + " and first_payout_amt is not null "
	sv_u = sv_u + " and first_payout_tranid is not null "
	EQSRV.GLBDATA.nxtPayoutDate = mid$(EQSRV.GLBDATA.nxtPayoutDate,0,10)
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.payoutAmt +"|"+EQSRV.GLBDATA.payoutTranId+"|"+EQSRV.GLBDATA.nxtPayoutDate+"|"+BANCS.STDIN.userId+"|"+BANCS.STDIN.contextBankId+"|"+EQSRV.GLBDATA.goalAcctId 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_u)
	sv_u = urhk_dbSqlWithBind(sv_u)
	if(sv_u==0)then
		sv_u = urhk_dbSqlWithBind("commit")
	else
		sv_u = urhk_dbSqlWithBind("rollback")
	endif
	##}
	endif
VAYU:
	print(EQSRV.GLBDATA.payYN)
	print(EQSRV.GLBDATA.payoutTranId)
	print(EQSRV.GLBDATA.valerr)
	exitscript
trace off
end-->
