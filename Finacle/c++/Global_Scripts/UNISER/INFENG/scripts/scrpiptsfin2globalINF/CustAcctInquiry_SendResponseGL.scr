<--start
#trace on
sv_a = urhk_GetChannelInfo("")
	print(sv_a)
	CUST.INTERFACE.DccId =BANCS.OUTPARAM.DccId
	print(CUST.INTERFACE.DccId)

	#--------------------------------------------------------------------------------
	# Setting Account Details in Response XML
	#--------------------------------------------------------------------------------
	sv_q = 1
	print(CINT(CUST.INTERFACE.accountCount))
	WHILE(sv_q <= CINT(CUST.INTERFACE.accountCount))
	#{
		sv_v = "foracid_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountID| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acid_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.Acid| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acctOpenDate_" + FORMAT$(sv_q, "%d")
		#-----------------------------------------------------
                # Converting to Gerigorian format
                #-----------------------------------------------------
                IF(("CUST").("INTERFACE").(sv_v) != "") THEN
                #{
                	   COMMON.INPUT.dateFmt = "DD-MM-YYYY"
                        COMMON.INPUT.date = ("CUST").("INTERFACE").(sv_v)
                        CALL("Common_Interface_ConvertDateToGregorian.scr")
                        ("CUST").("INTERFACE").(sv_v) = COMMON.OUTPUT.outDate
                        print(("CUST").("INTERFACE").(sv_v))
                #}
                ENDIF
	
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AcctOpenDate| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "solID_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.BranchCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "schemeCode_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.SchemeCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "schemeType_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.SchemeType| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		CUST.INTERFACE.schemeType = ("CUST").("INTERFACE").(sv_v)
		sv_v = "acctName_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountName| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "crncyCode_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.Currency| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "accountStatus_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountStatus| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acctOwnership_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountOwnership| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acctClosureFlg_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountClosureFlag| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "freezeCode_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.FreezeCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "clrBalAmt_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ClearBalance| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f") 
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "unClearBalAmt_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.UnclearBalance| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f") 
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "sanctLimit_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.SanctionLimit| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f") 
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "lienAmt_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.LienAmount| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f") 
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "drawingPower_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.DrawingPower| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f") 
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "modeOfOperation_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ModeOfOperation| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
##trace off
end-->
