<--START
CHECKSUM="ba3d708c18a62c22824d14eafdd9b7cc3e42c72dcf6a46648a1a77b7e23d867d"
	TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "TFMARGIN") == 0) THEN
	#{
		CREATECLASS("CUST", "TFMARGIN", 5)
	#}
	ENDIF
	
	CUST.TFMARGIN.schmType	=	" "
	CUST.TFMARGIN.operativeAccnt	=	" "
	
	#########################################################
	#Inputs from jsp
	#########################################################
	print(BANCS.INPUT.operativeAccnt)
	
	CUST.TFMARGIN.operativeAccnt = BANCS.INPUT.operativeAccnt
	
	sv_s = "schmType|SELECT SCHM_TYPE FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE DEL_FLG !='Y' "
	sv_s = sv_s + "AND ACCT_CLS_FLG !='Y' "
	sv_s = sv_s + "AND ENTITY_CRE_FLG = 'Y' "
	sv_s = sv_s + "AND FORACID = ?SVAR "
	sv_s = sv_s + "AND BANK_ID = ?SVAR "
	
	BANCS.INPARAM.BINDVARS = CUST.TFMARGIN.operativeAccnt  + "|"  + BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.TFMARGIN.schmType = BANCS.OUTPARAM.schmType
		print(CUST.TFMARGIN.schmType)
		
		IF (CUST.TFMARGIN.schmType == "TDA") THEN
		#{
			sv_u = urhk_SetOrbOut("paramV1|PASS")
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("paramV1|FAIL")
		#}
		ENDIF
	#}
	ENDIF
	ENDOFSCRIPT:
		TRACE OFF
		EXITSCRIPT
END-->
