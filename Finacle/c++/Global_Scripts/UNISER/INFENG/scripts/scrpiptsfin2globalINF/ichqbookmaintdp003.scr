<--START
CHECKSUM="e29415907f5a99847eecfcf5470a15275108727a2cc80806689080cf273b3c61"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CHM") == 0) THEN
	#{
		CREATECLASS("CUST","CHM",5)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Initialize variables
	#--------------------------------------------------------------------------
	
	CUST.CHM.instType = ""
	CUST.CHM.instDesc = ""
	CUST.CHM.recordCount ="0"
	sv_s = "1"
	#--------------------------------------------------------------------------
	# Get record Count
	#--------------------------------------------------------------------------
	sv_a =  "count | SELECT COUNT(*) "
	sv_a = sv_a + " FROM CUSTOM.C_CBT_INT WHERE DEL_FLG != 'Y' "
	sv_a = sv_a + " AND BANK_ID = ?SVAR "
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	
	print(sv_a)
	
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	
	CUST.CHM.recordCount = BANCS.OUTPARAM.count
	print(CUST.CHM.recordCount)
	
	sv_u = urhk_SetOrbOut("recordCount|" + CUST.CHM.recordCount)
	
	#--------------------------------------------------------------------------
	# Fetch records from DB
	#--------------------------------------------------------------------------
	
	sv_a =  "instType,instDesc | SELECT INST_TYPE,INST_DESC "
	sv_a = sv_a + " FROM CUSTOM.C_CBT_INT WHERE DEL_FLG != 'Y' "
	sv_a = sv_a + " AND BANK_ID = ?SVAR "
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	
	print(sv_a)
	
	sv_u = urhk_dbCursorOpenWithBind(sv_a)
	
	IF (sv_u == 0) THEN
	#{
		sv_b = (BANCS.OUTPARAM.DB_CURSOR_NUMBER)
		print(sv_b)
		sv_r = urhk_dbCursorFetch(sv_b)
		print(sv_r)
		# Else fetch details from cursor
		CUST.CHM.count = sv_s
		WHILE(sv_r == 0)
		#{
			IF(TRIM(BANCS.OUTPARAM.instType) != "") THEN
			#{
				CUST.CHM.instType = BANCS.OUTPARAM.instType
				print(CUST.CHM.instType)
			#}
			ENDIF
			IF(TRIM(BANCS.OUTPARAM.instDesc) != "") THEN
			#{
				CUST.CHM.instDesc = BANCS.OUTPARAM.instDesc
				print(CUST.CHM.instDesc)
			#}
			ENDIF
			# Set the values to front end
			sv_z = "instrNo_" + CUST.CHM.count + "|" + CUST.CHM.instType
			sv_m = urhk_SetOrbOut(sv_z)
			print(sv_z)
			print(sv_m)
			
			sv_z = "instDesc_" + CUST.CHM.count + "|" + CUST.CHM.instDesc
			sv_m = urhk_SetOrbOut(sv_z)
			print(sv_z)
			print(sv_m)
			
			# Fetch next record
			
			CUST.CHM.count = CINT(CUST.CHM.count) + 1
			print(CUST.CHM.count)
			sv_r = urhk_dbCursorFetch(sv_b)
		#}
		DO
		sv_x = urhk_dbCursorClose(sv_b)
		
	#}
	ENDIF
	
	EXITSCRIPT
END-->
