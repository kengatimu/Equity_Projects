<--START
CHECKSUM="93a8c1a21116eccd38570b7e7bece5d70ccf77723574c44ec382a3bcf7d68cbd"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIEREV Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIEREV")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIEREV",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIEREV.acctNum = " "
	CUST.CIEREV.errorFlg = "N"
	CUST.CIEREV.errorMsg = " "
	CUST.CIEREV.acctNumEntityId = " "
	CUST.CIEREV.acctNumSolId = " "
	CUST.CIEREV.acctNumCcy = " "
	CUST.CIEREV.acctName = " "
	CUST.CIEREV.entityCreFlg = " "
	CUST.CIEREV.acctClsFlg = " "
	CUST.CIEREV.schmType = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
		#{
			CUST.CIEREV.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
			print(CUST.CIEREV.acctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIEREV.errorFlg = "Y"
		CUST.CIEREV.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctNumEntityId,acctNumSolId,acctNumCcy,acctName,entityCreFlg,acctClsFlg,schmType|"
	sv_s = sv_s + " SELECT BANK_ID,SOL_ID,ACCT_CRNCY_CODE,ACCT_NAME,ENTITY_CRE_FLG,ACCT_CLS_FLG,SCHM_TYPE"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIEREV.acctNum
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIEREV.acctNumEntityId = BANCS.OUTPARAM.acctNumEntityId
		print(CUST.CIEREV.acctNumEntityId)
		CUST.CIEREV.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
		print(CUST.CIEREV.acctNumSolId)
		CUST.CIEREV.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
		print(CUST.CIEREV.acctNumCcy)
		CUST.CIEREV.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CIEREV.acctName)
		CUST.CIEREV.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		print(CUST.CIEREV.entityCreFlg)
		CUST.CIEREV.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
		print(CUST.CIEREV.acctClsFlg)
		CUST.CIEREV.schmType = BANCS.OUTPARAM.schmType
		print(CUST.CIEREV.schmType)
		
		IF(CUST.CIEREV.entityCreFlg == "N")THEN
		#{
			CUST.CIEREV.errorFlg = "Y"
			CUST.CIEREV.errorMsg = "Account Creation Not Authorised"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.CIEREV.acctClsFlg == "Y")THEN
		#{
			CUST.CIEREV.errorFlg = "Y"
			CUST.CIEREV.errorMsg = "Account is closed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.CIEREV.schmType != "SBA") AND (CUST.CIEREV.schmType != "CAA") AND (CUST.CIEREV.schmType != "CCA") AND (CUST.CIEREV.schmType != "ODA"))THEN
		#{
			CUST.CIEREV.errorFlg = "N"
			CUST.CIEREV.errorMsg = "Only SBA/CAA/CCA/ODA Type of Accounts are allowed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		#}
	ELSE
		#{
		CUST.CIEREV.errorFlg = "Y"
		CUST.CIEREV.errorMsg = "Invalid Account ID"
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIEREV.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIEREV.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumEntityId|"+CUST.CIEREV.acctNumEntityId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumSolId|"+CUST.CIEREV.acctNumSolId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumCcy|"+CUST.CIEREV.acctNumCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctName|"+CUST.CIEREV.acctName)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNum|"+CUST.CIEREV.acctNum)
		print(sv_u)
		
		
END-->
