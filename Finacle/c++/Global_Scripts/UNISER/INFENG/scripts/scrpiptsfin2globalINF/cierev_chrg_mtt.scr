<--START
CHECKSUM="5fc76c88c049d7dbf9bd12eb181782cdab75c8f89dc64ecb6e2a0985fc988419"
	TRACE ON
	
	IF (REPEXISTS("MTT") == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	IF (CLASSEXISTS("MTT", "TranDetails") == 0) THEN
	#{
		CREATECLASS("MTT", "TranDetails", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("MTT", "PartTranDetails") == 0) THEN
	#{
		CREATECLASS("MTT", "PartTranDetails", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("MTT", "Error") == 0) THEN
	#{
		CREATECLASS("MTT", "Error", 5)
	#}
	ENDIF
	
	PRINT(CUST.CIEREV.chargeEventId)
	PRINT(CUST.CIEREV.chargeAmtCcy)
	PRINT(CUST.CIEREV.chargeTranId)
	PRINT(CUST.CIEREV.chargeTranDate)
	PRINT(CUST.CIEREV.chrgAmtTran)
	PRINT(CUST.CIEREV.crChrgAc)
	PRINT(CUST.CIEREV.drChrgAc)
	
	CUST.CIEREV.TranId = ""
	
	print("All initializations over")
	
	#===================================
	# STEP 1 : INITIALIZE THE MTT
	#===================================
	
	BANCS.INPARAM.PostTranFlg 		= "Y"
	BANCS.INPARAM.CommitFlg 		= "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg 	= "Y"
	BANCS.INPARAM.ValidationFlag 		= "Y"
	BANCS.INPARAM.RestrictModifyInd 	= "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw 		= "Y"
	BANCS.INPARAM.CheckExceptions 		= "N"
	
	sv_u = urhk_MTTS_Initialize("")
	print (sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_c = "Initialisation of MTT Failed"
		MTT.Error.Description = sv_c
		sv_u = urhk_MTTS_ReportErrorCondition("")
		GOTO EndofScript
	#}
	ENDIF
	
	#######################################################################
	## Populate the details required for Transaction header		     ##
	#######################################################################
	sv_u = urhk_MTTS_PopulateInputDetails("")
	
	MTT.TranDetails.TranDate                = "0"
	MTT.TranDetails.TranType                = "C"
	MTT.TranDetails.TranSubType		= "CP"
	MTT.TranDetails.IgnoreExcp              = "I"
	MTT.TranDetails.Consolidate             = "N"
	MTT.TranDetails.ReversalFlag            = "N"
	MTT.TranDetails.PostFlag                = "Y"
	MTT.TranDetails.PostTranFlg             = "Y"
	MTT.TranDetails.CommitFlg               = "Y"
	MTT.TranDetails.Remarks                 = "ZERO"
	MTT.TranDetails.ValidationFlag		= "N"
	
	sv_u = urhk_MTTS_DefineTransaction("CHRGREV")
	print(sv_u)
	IF (sv_u != "0") THEN
	#{
		GOTO EndOfScript
	#}
	ENDIF
	
	
	##################################################
	# Debiting the income account
	##################################################
	
	MTT.PartTranDetails.Account                     =  CUST.CIEREV.crChrgAc
	MTT.PartTranDetails.RefAmount                   =  CDOUBLE(CUST.CIEREV.chrgAmtTran)*-1
	MTT.PartTranDetails.RefCurrency                 =  BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDate                   =  "0"
	MTT.PartTranDetails.Particulars                 =  "Inter-Country Charge Reversal"
	MTT.PartTranDetails.TranIdentifier              =  "CHRGREV"
	MTT.PartTranDetails.Consolidate                 =  "N"
	MTT.PartTranDetails.CarveAmtFlg                 =  "Y"
	MTT.PartTranDetails.Refnum                      =  ""
	MTT.PartTranDetails.Remarks                     =  "Inter-Country Charge Reversal"
	MTT.PartTranDetails.PTranBusinessType           =  ""
	
	
	sv_r = urhk_MTTS_DefinePartTran("CHRGREV1")
	print(sv_r)
	
	IF (sv_r != "0") THEN
	#{
		GOTO EndOfScript
	#}
	ENDIF
	
	
	################################################################
	# Crediting the customer account
	################################################################
	
	MTT.PartTranDetails.Account                     =   CUST.CIEREV.drChrgAc
	MTT.PartTranDetails.RefAmount                   =   CDOUBLE(CUST.CIEREV.chrgAmtTran)
	MTT.PartTranDetails.RefCurrency         	=   BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDate                   =   "0"
	MTT.PartTranDetails.Particulars                 =   "Inter-Country Charge Reversal"
	MTT.PartTranDetails.TranIdentifier              =   "CHRGREV"
	MTT.PartTranDetails.Consolidate                 =   "N"
	MTT.PartTranDetails.Refnum                      =    ""
	MTT.PartTranDetails.Remarks                     =   "Inter-Country Charge Reversal"
	#MTT.PartTranDetails.RateCode = "NOR"
	print(MTT.PartTranDetails.Account)
	
	sv_r = urhk_MTTS_DefinePartTran("CHRGREV2")
	print(sv_r)
	
	IF (sv_r == 1) THEN
	#{
		print("Unable to create MTT Part transaction")
		GOTO EndOfScript
	#}
	ENDIF
	
	#############################
	# Commit the transaction
	#############################
	sv_u = urhk_MTTS_EndDefinition("")
	print(sv_u)
	
	CUST.CIEREV.TranId = BANCS.OUTPARAM.MTTTranId
	print(CUST.CIEREV.TranId)
	
	
	##################################################
	# If any error tran id will not be created
	##################################################
	IF ((sv_u != 0)  OR (CUST.CIEREV.TranId==""))THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		print (MTT.Error.Description)
		CUST.CIEREV.ResStatus = "F"
		CUST.CIEREV.Response = "Transaction creation Failed."
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO EndOfScript
	#}
	ENDIF
	
	##########################################
	# Close the MTT
	##########################################
	sv_r = urhk_MTTS_Close("")
	print(sv_r)
	
	EndOfScript:
		############################
		## Exiting the script ##
		############################
		print("end of script")
		
		exitscript
		
		
		TRACE OFF
		
END-->

#################################################################################################
# EndOfScript
