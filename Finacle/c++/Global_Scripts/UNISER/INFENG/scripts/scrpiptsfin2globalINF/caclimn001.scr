		#{
			CUST.CACLI.crAmt  = CUST.CACLI.tran_amt
			CUST.CACLI.crAmt = FORMAT$(CDOUBLE(CUST.CACLI.crAmt),"%.2f")
			CUST.CACLI.wdAmt  = ""
			CUST.CACLI.wdAmt = FORMAT$(CDOUBLE(CUST.CACLI.wdAmt),"%.2f")
		#}
		ENDIF
		IF(sv_r == 1) THEN
		#{
			print(sv_r)
			CUST.CACLI.latestBal = CUST.CACLI.closingBal
		#}
		ENDIF
		
		print(CUST.CACLI.latestBal)
		PRINT(CUST.CACLI.crAmt)
		PRINT(CUST.CACLI.wdAmt)
		
		#----------------------------------------------------------------------#
		# Setting the values in multirec
		#----------------------------------------------------------------------#
		
		sv_y = FORMAT$(CINT(CUST.CACLI.count), "%d")
		
		IF(CUST.CACLI.gl_date != "") THEN
		#{
			CUST.CACLI.message = ""
			CUST.CACLI.message = CUST.CACLI.message + "MRM_glDate_" + sv_y + "|" + CUST.CACLI.gl_date
