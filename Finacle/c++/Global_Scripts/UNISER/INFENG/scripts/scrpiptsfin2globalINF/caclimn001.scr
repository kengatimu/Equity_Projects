		print(CUST.CACLI.bankId)
	#}
	ENDIF
	
	IF(CUST.CACLI.bankId != CUST.CACLI.targetEntity)THEN
	#{
		CUST.CACLI.errorMsg = "Target Bank mismatch"
		CUST.CACLI.fieldName = "targetEntity"
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
