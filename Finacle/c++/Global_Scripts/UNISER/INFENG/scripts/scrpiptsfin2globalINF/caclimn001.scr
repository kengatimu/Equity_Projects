	#}
	ENDIF
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "instrmnt_num,value_Date,gl_date,part_tran_type,tran_amt,tran_particular|"
	sv_s = sv_s + " SELECT INSTRMNT_NUM,TO_CHAR(VALUE_DATE,'DD-MM-YYYY'),TO_CHAR(GL_DATE,'DD-MM-YYYY'),PART_TRAN_TYPE,TRAN_AMT,TRAN_PARTICULAR"
	sv_s = sv_s + " from CUSTOM.C_HTD WHERE acid= ?SVAR AND PSTD_FLG = 'Y'"
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	
	IF(CUST.CACLI.fromDate != "") THEN
	#{
		sv_s = sv_s + " AND TRAN_DATE >= TO_DATE(?SVAR,'DD-MM-YYYY')"
	#}
	ENDIF
	
	IF(CUST.CACLI.toDate != "") THEN
	#{
		sv_s = sv_s + " AND TRAN_DATE <= TO_DATE(?SVAR,'DD-MM-YYYY')"
	#}
	ENDIF
	
	IF((CUST.CACLI.fromAmt != "") AND (CUST.CACLI.toAmt != "")) THEN
	#{
		sv_s = sv_s + "  AND TRAN_AMT >= ?SVAR AND TRAN_AMT <= ?SVAR"
	#}
	ENDIF
	
	IF((CUST.CACLI.fromAmt == "") AND (CUST.CACLI.toAmt != "")) THEN
	#{
		sv_s = sv_s + " AND TRAN_AMT <= ?SVAR"
	#}
	ENDIF
	
	IF((CUST.CACLI.fromInstrumentNo != "") AND (CUST.CACLI.toInstrumentNo != "")) THEN
	#{
		sv_s = sv_s + "  AND INSTRMNT_NUM > ?SVAR AND INSTRMNT_NUM < ?SVAR"
	#}
	ENDIF
	
	IF(CUST.CACLI.orderBy == "T") THEN
	#{
		sv_s = sv_s + " ORDER BY  gl_date desc, pstd_date desc, tran_id desc ,part_tran_srl_num desc"
		#}
	ELSE
		#{
		sv_s = sv_s + " ORDER BY  value_date desc, pstd_date desc, tran_id desc ,part_tran_srl_num desc"
