		#}
		ENDIF
		
		IF(CUST.CACLI.value_Date != "") THEN
		#{
			CUST.CACLI.message = ""
			CUST.CACLI.message = CUST.CACLI.message + "MRM_valueDate_" + sv_y + "|" + CUST.CACLI.value_Date
			sv_u = urhk_SetOrbOut(CUST.CACLI.message)
		#}
		ENDIF
		
		IF(CUST.CACLI.instrmnt_num != "") THEN
		#{
			CUST.CACLI.message = ""
			CUST.CACLI.message = CUST.CACLI.message + "MRM_instrNo_" + sv_y + "|" + CUST.CACLI.instrmnt_num
			sv_u = urhk_SetOrbOut(CUST.CACLI.message)
		#}
		ENDIF
		
		IF(CUST.CACLI.wdAmt != "") THEN
		#{
			CUST.CACLI.message = ""
			CUST.CACLI.message = CUST.CACLI.message + "MRM_withdrawalAmt_" + sv_y + "|" + CUST.CACLI.wdAmt
			sv_u = urhk_SetOrbOut(CUST.CACLI.message)
