				CALL("caclidp002.scr")
				CUST.CACLI.latestBal1 = CUST.CACLI.outputAmt
				PRINT(CUST.CACLI.latestBal1)
				
				CUST.CACLI.message = CUST.CACLI.message + "MRM_balanceAmt_" + sv_y + "|" + CUST.CACLI.latestBal1
			#}
			ENDIF
			
			sv_u = urhk_SetOrbOut(CUST.CACLI.message)
		#}
		ENDIF
		
		IF(CUST.CACLI.tran_particular != "") THEN
		#{
			CUST.CACLI.message = ""
			CUST.CACLI.message = CUST.CACLI.message + "MRM_narrative_" + sv_y + "|" + CUST.CACLI.tran_particular
			sv_u = urhk_SetOrbOut(CUST.CACLI.message)
		#}
		ENDIF
		
		
		IF(CUST.CACLI.part_tran_type == "D") THEN
		#{
			CUST.CACLI.latestBal = CDOUBLE(CUST.CACLI.latestBal) +  CDOUBLE(CUST.CACLI.tran_amt)
		#}
		ENDIF
		
		IF(CUST.CACLI.part_tran_type == "C") THEN
		#{
			CUST.CACLI.latestBal = CDOUBLE(CUST.CACLI.latestBal) - CDOUBLE(CUST.CACLI.tran_amt)
		#}
		ENDIF
		
		print(CUST.CACLI.count)
		CUST.CACLI.count = CINT(CUST.CACLI.count) + CINT("1")
		print(CUST.CACLI.count)
		sv_r= sv_r + 1
		print(sv_r)
		print(CUST.CACLI.lastNTran)
		print(CUST.CACLI.count)
		IF( CINT(CUST.CACLI.lastNTran) ==  CINT(CUST.CACLI.count)) THEN
		#{
			GOTO NOMOREFETCH
		#}
		ENDIF
		sv_c  = urhk_dbCursorFetch(CUST.CACLI.cursorNumber)
	#}
	DO
	NOMOREFETCH:
		sv_c = urhk_dbCursorClose(CUST.CACLI.cursorNumber)
		PRINT(CUST.CACLI.count)
		sv_a = urhk_SetOrbOut("cacli_det.setSize|" + CUST.CACLI.count)
		sv_a = urhk_SetOrbOut("cacli_det.MaxRecsPerPage|"+CUST.CACLI.count)
		
	NEXT:
		#sv_a = urhk_SetOrbOut("cacli_det.totalRecords|2")
		#v_a = urhk_SetOrbOut("cacli_det.MaxRecsPerPage|"+CUST.CACLI.count)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_u)
		
		
	ENDOFSCRIPT:
		#############################################################################
		# Deleting the custom repository and class
		############################################################################
		
		IF (CLASSEXISTS("CUST", "CACLI") != 0) THEN
		#{
			DELETECLASS("CUST", "CACLI")
		#}
		ENDIF
		
		IF (REPEXISTS("CUST") != 0) THEN
		#{
			DELETEREP("CUST")
		#}
		ENDIF
		#trace off
		
