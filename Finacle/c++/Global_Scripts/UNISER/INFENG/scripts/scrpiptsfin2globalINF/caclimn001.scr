	#------------------------------------------------------------------------------#
	# Getting Acid from Foracid
	#------------------------------------------------------------------------------#
	
	CUST.CACLI.bankId = ""
	BANCS.INPARAM.BINDVARS = "" + CUST.CACLI.acctID
	sv_s = ""
	sv_s = sv_s + "acid,bankId|Select Acid,Bank_Id from tbaadm.gam "
	sv_s = sv_s + " where foracid = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0) THEN
	#{
		CUST.CACLI.acid = BANCS.OUTPARAM.acid
