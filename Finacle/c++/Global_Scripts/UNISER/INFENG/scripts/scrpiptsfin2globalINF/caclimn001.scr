			sv_u = urhk_SetOrbOut(CUST.CACLI.message)
		#}
		ENDIF
		
		IF(CUST.CACLI.latestBal != "") THEN
		#{
			CUST.CACLI.message = ""
			IF(sv_r == 1) THEN
			#{
				CUST.CACLI.message = CUST.CACLI.message + "MRM_balanceAmt_" + sv_y + "|" + CUST.CACLI.closingBal
				#}
			ELSE
				#{
				CUST.CACLI.inputAmt = CUST.CACLI.latestBal
