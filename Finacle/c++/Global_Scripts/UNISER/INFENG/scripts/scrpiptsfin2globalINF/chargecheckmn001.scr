			CUST.CPARAM.acctCrncyCode = BANCS.OUTPUT.parameterVal
			PRINT(CUST.CPARAM.acctCrncyCode)
			CUST.CHRG.acctCrncyCode = CUST.CPARAM.acctCrncyCode
			#}
		ELSE
			#{
			CUST.CHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
