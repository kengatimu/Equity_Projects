		CUST.CHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
	#}
	ENDIF
	
	#------------------------------------------------------------------
	# Creating an error report file
	#------------------------------------------------------------------
	sv_s = "RPTfileName|SELECT to_char(sysdate,'ddmmyyyyhhmiss') "
	sv_s = sv_s + " FROM DUAL "
	PRINT(sv_s)
	sv_a = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_a)
	
	IF(sv_a == 0 ) THEN
	#{
		CUST.CHRG.RPTfileName	= BANCS.OUTPARAM.RPTfileName
		PRINT(CUST.CHRG.RPTfileName)
	#}
	ENDIF
	
	CUST.CHRG.RPTfileName		= CUST.CHRG.RPTfileName + ".RPT"
	PRINT(CUST.CHRG.RPTfileName)
	
	#--------------------------------------------------------------------------
	# Selecting total number of accounts which are not charged
	#--------------------------------------------------------------------------
	sv_s = "dtdCount|"
	sv_s = sv_s + " SELECT count(1) "
	sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD "
	sv_s = sv_s + " WHERE GAM.acid=DTD.acid "
	sv_s = sv_s + " AND GAM.bank_id=DTD.bank_id "
	sv_s = sv_s + " AND GAM.sol_id= ?SVAR "
	sv_s = sv_s + " AND GAM.acct_ownership='C' "
	sv_s = sv_s + " AND GAM.acct_crncy_code= ?SVAR"
	sv_s = sv_s + " AND GAM.clr_bal_amt < ?SVAR"
	sv_s = sv_s + " AND GAM.schm_type in ('CAA','SBA') "
	sv_s = sv_s + " AND INSTR(?SVAR,CONCAT(CONCAT('!',GAM.schm_code),'!')) = 0"
	sv_s = sv_s + " AND GAM.acct_cls_flg='N' "
	sv_s = sv_s + " AND GAM.del_flg='N' "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND DTD.del_flg='N' "
	sv_s = sv_s + " AND DTD.tran_id LIKE '%" + BANCS.STDIN.contextBankId + "%'"
	sv_s = sv_s + " AND DTD.tran_type='C' "
	sv_s = sv_s + " AND DTD.tran_sub_type='NP' "
	sv_s = sv_s + " AND DTD.part_tran_type='D' "
	sv_s = sv_s + " AND DTD.sol_id= ?SVAR"
	sv_s = sv_s +			" AND DTD.acid NOT IN  ( "
	sv_s = sv_s +			" SELECT DISTINCT dtd.acid "
	sv_s = sv_s + 			" FROM TBAADM.DTD "
	sv_s = sv_s + 			" WHERE DTD.acid=GAM.acid "
	sv_s = sv_s + 			" AND DTD.bank_id=GAM.bank_id "
	sv_s = sv_s +			" AND DTD.del_flg='N' "
	sv_s = sv_s + 			" AND DTD.tran_type='T' "
	sv_s = sv_s + 			" AND DTD.tran_sub_type='BI' "
	sv_s = sv_s + 			" AND DTD.part_tran_type='D' "
	sv_s = sv_s + 			" AND DTD.sol_id = GAM.sol_id "
	sv_s = sv_s + 			" AND INSTR(?SVAR,CONCAT(CONCAT('!',DTD.tran_amt),'!')) > 0) "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CHRG.acctCrncyCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.balAmt + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.schmCod + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId  + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.tranAmt
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CHRG.dtdCount=BANCS.OUTPARAM.dtdCount
		PRINT(CUST.CHRG.dtdCount)
		#}
	ELSE
		#{
		CUST.CHRG.errMsg = "Error in finding dtd record count "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CINT(CUST.CHRG.dtdCount) == 0) THEN
	#{
		sv_s = SYSTEM("echo Missing Online charges Report >> " +CUST.CHRG.RPTfileName)
		sv_s = SYSTEM("echo ----------------------------- >> " +CUST.CHRG.RPTfileName)
		sv_s = SYSTEM("echo ----------No Record found---------- >> " +CUST.CHRG.RPTfileName)
		sv_s = "babx4040 ${B2K_SESSION_ID} "+CUST.CHRG.RPTfileName + " " + '"' + "Missing Online Charge Report"  + '"' + " MANAGER 1 N"
		PRINT(sv_s)
		sv_u = SYSTEM(sv_s)
		PRINT(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting accounts from DTD
	#--------------------------------------------------------------------------
	sv_s = "foracid,schmCode,schmType,tranId,partTransrlNum,tranAmt,clrBalAmt,drwngPower|"
	sv_s = sv_s + " SELECT GAM.foracid,GAM.schm_code,GAM.schm_type,DTD.tran_id,"
	sv_s = sv_s + " DTD.part_tran_srl_num,DTD.tran_amt,GAM.clr_bal_amt,GAM.drwng_power "
	sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD "
	sv_s = sv_s + " WHERE GAM.acid=DTD.acid "
	sv_s = sv_s + " AND GAM.bank_id=DTD.bank_id "
	sv_s = sv_s + " AND GAM.sol_id= ?SVAR "
	sv_s = sv_s + " AND GAM.acct_ownership='C' "
	sv_s = sv_s + " AND GAM.acct_crncy_code= ?SVAR"
	sv_s = sv_s + " AND GAM.clr_bal_amt < ?SVAR"
	sv_s = sv_s + " AND GAM.schm_type in ('CAA','SBA') "
	sv_s = sv_s + " AND INSTR(?SVAR,CONCAT(CONCAT('!',GAM.schm_code),'!')) = 0"
	sv_s = sv_s + " AND GAM.acct_cls_flg='N' "
	sv_s = sv_s + " AND GAM.del_flg='N' "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND DTD.del_flg='N' "
	sv_s = sv_s + " AND DTD.tran_id LIKE '%" + BANCS.STDIN.contextBankId + "%'"
	sv_s = sv_s + " AND DTD.tran_type='C' "
	sv_s = sv_s + " AND DTD.tran_sub_type='NP' "
	sv_s = sv_s + " AND DTD.part_tran_type='D' "
	sv_s = sv_s + " AND DTD.sol_id= ?SVAR"
	sv_s = sv_s +			" AND DTD.acid NOT IN  ( "
	sv_s = sv_s +			" SELECT DISTINCT dtd.acid "
	sv_s = sv_s + 			" FROM TBAADM.DTD "
	sv_s = sv_s + 			" WHERE DTD.acid=GAM.acid "
	sv_s = sv_s + 			" AND DTD.bank_id=GAM.bank_id "
	sv_s = sv_s +			" AND DTD.del_flg='N' "
	sv_s = sv_s + 			" AND DTD.tran_type='T' "
	sv_s = sv_s + 			" AND DTD.tran_sub_type='BI' "
	sv_s = sv_s + 			" AND DTD.part_tran_type='D' "
	sv_s = sv_s + 			" AND DTD.sol_id = GAM.sol_id "
	sv_s = sv_s + 			" AND INSTR(?SVAR,CONCAT(CONCAT('!',DTD.tran_amt),'!')) > 0) "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CHRG.acctCrncyCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.balAmt + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.schmCod + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.tranAmt
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUST.CHRG.mainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(CUST.CHRG.mainCursor)
	
	#------------------------------------------------------------------
	# Creating an error report file
	#------------------------------------------------------------------
	sv_s = "RPTfileName|SELECT to_char(sysdate,'ddmmyyyyhhmiss') "
	sv_s = sv_s + " FROM DUAL "
	PRINT(sv_s)
	sv_a = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_a)
	
	IF(sv_a == 0 ) THEN
	#{
		CUST.CHRG.RPTfileName	= BANCS.OUTPARAM.RPTfileName
		PRINT(CUST.CHRG.RPTfileName)
	#}
	ENDIF
	
	CUST.CHRG.RPTfileName		= CUST.CHRG.RPTfileName + ".RPT"
	PRINT(CUST.CHRG.RPTfileName)
	
	sv_s = SYSTEM("echo Missing Online charges Report >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo ----------------------------- >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo  >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo  >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo Following Accounts are not charged for Instant Tod/Withdrawal Against Shadow balance >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo Analyse the account AND collect the required charge using TM menu. >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo Note: Use Transfer/Bank Induced to collect the charges from the following accounts >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo SYSTEM will collect Cashwithdrawal/Minimum blanace/Stamp duty charges from the following accounts during ABH process >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo  >> " +CUST.CHRG.RPTfileName)
	sv_s = SYSTEM("echo ==================================================================================================================== >> " +CUST.CHRG.RPTfileName)
	
	WHILE (sv_c == 0)
	#{
		sv_c = urhk_dbCursorFetch(CUST.CHRG.mainCursor)
		PRINT(sv_c)
		IF (sv_c != 0) THEN
		#{
			sv_c = urhk_dbCursorClose(CUST.CHRG.mainCursor)
			PRINT(sv_c)
			sv_c = 1
			sv_s = "babx4040 ${B2K_SESSION_ID} "+CUST.CHRG.RPTfileName + " " + '"' + "Missing Online Charge Report"  + '"' + " MANAGER 1 N"
			PRINT(sv_s)
			sv_u = SYSTEM(sv_s)
			PRINT(sv_u)
			#}
		ELSE
			#{
			CUST.CHRG.foracid			= BANCS.OUTPARAM.foracid
			CUST.CHRG.schmCode			= BANCS.OUTPARAM.schmCode
			CUST.CHRG.schmType			= BANCS.OUTPARAM.schmType
			CUST.CHRG.tranId 			= BANCS.OUTPARAM.tranId
			CUST.CHRG.partTransrlNum	= BANCS.OUTPARAM.partTransrlNum
			CUST.CHRG.tranAmt 			= BANCS.OUTPARAM.tranAmt
			CUST.CHRG.clrBalAmt 		= BANCS.OUTPARAM.clrBalAmt
			CUST.CHRG.drwngPower 		= BANCS.OUTPARAM.drwngPower
			
			PRINT(CUST.CHRG.foracid)
			PRINT(CUST.CHRG.schmCode)
			PRINT(CUST.CHRG.schmType)
			PRINT(CUST.CHRG.tranId)
			PRINT(CUST.CHRG.partTransrlNum)
			PRINT(CUST.CHRG.tranAmt)
			PRINT(CUST.CHRG.clrBalAmt)
			PRINT(CUST.CHRG.drwngPower)
			##Directly given value for  drwngPrblm
			CUST.CHRG.drwngPrblm = "N"
			PRINT(CUST.CHRG.drwngPrblm)
			
			
			#-----------------------------------------
			# Checking for drwngPower
			#------------------------------------------
			
			IF (CDOUBLE(CUST.CHRG.drwngPower) > 0 ) THEN
			#{
				CUST.CHRG.tempAmt = CDOUBLE(CUST.CHRG.drwngPower) - CDOUBLE(CUST.CHRG.clrBalAmt)
				
				IF (CDOUBLE(CUST.CHRG.tempAmt) < CDOUBLE(CUST.CHRG.tranAmt)) THEN
				#{
					CUST.CHRG.drwngPrblm = "N"
					#}
				ELSE
					#{
					CUST.CHRG.drwngPrblm = "Y"
				#}
				ENDIF
			#}
			ENDIF
			
			IF (CUST.CHRG.drwngPrblm == "N") THEN
			#{
				#--------------------------------------------------------
				# Checking Tod/shadow already collected or not
				#--------------------------------------------------------
				sv_s = "dtdCount|"
				sv_s = sv_s + " SELECT COUNT(1) FROM TBAADM.DTD "
				sv_s = sv_s + " WHERE "
				sv_s = sv_s + " DTD.del_flg='N' "
				sv_s = sv_s + " AND DTD.tran_type='T' "
				sv_s = sv_s + " AND DTD.tran_sub_type='BI' "
				sv_s = sv_s + " AND DTD.part_tran_type='D' "
				sv_s = sv_s + " AND DTD.bank_id = ?SVAR "
				sv_s = sv_s + " AND DTD.tran_particular in ('CHARGE FOR UNCLEARED CHEQUE','Instant TOD Charge') "
				sv_s = sv_s + " AND DTD.acid in (select GAM.acid FROM TBAADM.GAM WHERE GAM.foracid=?SVAR "
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR )"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CHRG.foracid + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSelectWithBind(sv_s)
				
				CUST.CHRG.dtdCount = BANCS.OUTPARAM.dtdCount
				PRINT(CUST.CHRG.dtdCount)
				IF (CDOUBLE(CUST.CHRG.dtdCount) == 0) THEN
				#{
					#----------------------------------------------
					# No charge collected
					#----------------------------------------------
					sv_s = "cMocount|"
					sv_s = sv_s + " SELECT COUNT(1) FROM CUSTOM.C_MOC "
					sv_s = sv_s + " WHERE  "
					sv_s = sv_s + " C_MOC.foracid= ?SVAR "
					sv_s = sv_s + " AND C_MOC.sol_id= ?SVAR "
					sv_s = sv_s + " AND C_MOC.tran_date=to_date(?SVAR,'dd-mm-yyyy')"
					sv_s = sv_s + " AND C_MOC.bank_id = ?SVAR "
					sv_s = sv_s + " AND C_MOC.del_flg = 'N' "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.CHRG.foracid +"|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CHRG.BODDate + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					
					CUST.CHRG.cMocount = BANCS.OUTPARAM.cMocount
					PRINT(CUST.CHRG.cMocount)
					
					IF (CDOUBLE(CUST.CHRG.cMocount) == 0) THEN
					#{
						#------------------------------------
						# Total Number of BI debits
						#------------------------------------
						sv_s = "dtdCount|"
						sv_s = sv_s + " SELECT COUNT(1) from TBAADM.DTD "
						sv_s = sv_s + " WHERE "
						sv_s = sv_s + " DTD.del_flg='N' "
						sv_s = sv_s + " AND DTD.tran_type='T' "
						sv_s = sv_s + " AND DTD.tran_sub_type='BI' "
						sv_s = sv_s + " AND DTD.part_tran_type='D' "
						sv_s = sv_s + " AND DTD.bank_id = ?SVAR "
						sv_s = sv_s + " AND DTD.acid in (select GAM.acid from TBAADM.GAM "
						sv_s = sv_s + 					" WHERE GAM.foracid = ?SVAR "
						sv_s = sv_s + 					" AND GAM.bank_id = DTD.bank_id )"
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|" + CUST.CHRG.foracid
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						
						CUST.CHRG.dtdCount = BANCS.OUTPARAM.dtdCount
						PRINT(CUST.CHRG.dtdCount)
						
						#-------------------------------------
						# First Time. Insert into c_moc table
						#-------------------------------------
						sv_s = "INSERT INTO CUSTOM.C_MOC(foracid,sol_id,tran_date,tran_count,del_flg,bank_id) values ("
						sv_s = sv_s + "?SVAR,"
						sv_s = sv_s + "?SVAR,"
						sv_s = sv_s + "to_date(?SVAR,'dd-mm-yyyy'),"
						sv_s = sv_s + "?SVAR,"
						sv_s = sv_s + "'N',"
						sv_s = sv_s + "?SVAR)"
						
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.CHRG.foracid + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CHRG.BODDate + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CHRG.dtdCount + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_d = urhk_dbSQLWithBind(sv_s)
						sv_d = urhk_dbSQLWithBind("COMMIT")
						
						#-------------------------------------
						# Setting Error Flag =Y
						# Insert the a/c no into report file
						#-------------------------------------
						sv_s = SYSTEM("echo " + CUST.CHRG.foracid + "  >> " +CUST.CHRG.RPTfileName)
						#}
					ELSE
						#{
						#------------------------------------
						# Checking New DTD count for the a/c
						#------------------------------------
						sv_s = "dtdCount|"
						sv_s = sv_s + " SELECT COUNT(1) "
						sv_s = sv_s + " FROM TBAADM.DTD"
						sv_s = sv_s + " WHERE DTD.del_flg='N'"
						sv_s = sv_s + " AND DTD.tran_type='T' "
						sv_s = sv_s + " AND DTD.tran_sub_type='BI' "
						sv_s = sv_s + " AND DTD.part_tran_type='D' "
						sv_s = sv_s + " AND DTD.bank_id = ?SVAR "
						sv_s = sv_s + " AND DTD.acid in (SELECT GAM.acid FROM TBAADM.GAM "
						sv_s = sv_s + 					" WHERE GAM.foracid= ?SVAR "
						sv_s = sv_s + 					" AND GAM.bank_id = DTD.bank_id )"
						PRINT(sv_s)
						
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|" + CUST.CHRG.foracid
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						
						CUST.CHRG.dtdCount = BANCS.OUTPARAM.dtdCount
						PRINT(CUST.CHRG.dtdCount)
						
						#------------------------------------
						# Checking New C_MOC tran count
						#------------------------------------
						sv_s = "tranCount|"
						sv_s = sv_s + "SELECT SUM(C_MOC.tran_count) "
						sv_s = sv_s + " FROM CUSTOM.C_MOC"
						sv_s = sv_s + " WHERE C_MOC.foracid = ?SVAR "
						sv_s = sv_s + " AND C_MOC.sol_id = ?SVAR "
						sv_s = sv_s + " AND C_MOC.tran_date = to_date(?SVAR,'dd-mm-yyyy') "
						sv_s = sv_s + " AND C_MOC.bank_id = ?SVAR "
						sv_s = sv_s + " AND C_MOC.del_flg = 'N' "
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.CHRG.foracid +"|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CHRG.BODDate +"|"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						
						CUST.CHRG.tranCount = BANCS.OUTPARAM.tranCount
						PRINT(CUST.CHRG.tranCount)
						
						IF (CDOUBLE(CUST.CHRG.dtdCount) <= CDOUBLE(CUST.CHRG.tranCount)) THEN
						#{
							sv_s = SYSTEM("echo " + CUST.CHRG.foracid + "  >> " +CUST.CHRG.RPTfileName)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = "echo 'Account: "+CUST.CHRG.foracid
		sv_s = sv_s +" |Transaction Amount: "+CUST.CHRG.tranAmt
		sv_s = sv_s +" |Transaction Id: "+CUST.CHRG.tranId + "' >> " + CUST.CHRG.fileName
		PRINT(sv_s)
		sv_a = SYSTEM(sv_s)
		PRINT(sv_a)
	#}
	DO
	
	
	
	#--------------------------------------------------------------------------------------------------------------
	# For HPR Entry
	#--------------------------------------------------------------------------------------------------------------
	sv_s = "babx4040 ${B2K_SESSION_ID} "+ CUST.CHRG.fileName+' '+'"'+"Success OR Failure Report for Charges"+'"'+" MANAGER 1 N"
	PRINT(sv_s)
	sv_u = SYSTEM(sv_s)
	PRINT(sv_u)
	
	ENDOFSCRIPT:
		#---------------------------------------------------------------------
		# Error Logging
		#---------------------------------------------------------------------
		IF (CUST.CHRG.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.CHRG.errMsg+"' >>chrgcheck.log")
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
