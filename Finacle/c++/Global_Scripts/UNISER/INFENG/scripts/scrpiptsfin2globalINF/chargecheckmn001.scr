		PRINT("DB stat code is invalid")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ( (BANCS.STDIN.contextBankId == "56")  OR  (BANCS.STDIN.contextBankId  == "11") ) THEN
