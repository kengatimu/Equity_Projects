<--START
CHECKSUM="952e0c106b5e03f4affd559faa1960680148ff84c05bdc848bca22776eaf1c96"
	#TRACE ON
	LIBNAME CUSTOMSO
	#sv_u=urhk_B2k_PrintRepos("BANCS")
	#print(sv_u)
	
	#-----------------------------------------------------------------
	# Creating Repository and classes
	#-----------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CATOD") == 0) THEN
	#{
		CREATECLASS("CUST","CATOD",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------
	# Initialiizing required variables
	#-----------------------------------------------------------------
	CUST.CATOD.selectedRec = ""
	CUST.CATOD.Function = ""
	CUST.CATOD.errColl =""
	CUST.CATOD.errMsg = ""
	#-----------------------------------------------------------------
	# Getting Input Parameters
	#-----------------------------------------------------------------
	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CATOD.fileName = MTT.InputDetails.Argument1
		print(CUST.CATOD.fileName)
		CUST.CATOD.functionCode = MTT.InputDetails.Argument2
		print(CUST.CATOD.functionCode)
		#}
	ELSE
		#{
		sv_u = urhk_MTTS_Close("")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.CATOD.Function = CUST.CATOD.functionCode
	print(CUST.CATOD.Function)
	#--------------------------------------------------------------------------------------------------
	# Creating the log File
	#--------------------------------------------------------------------------------------------------
	sv_s = "startTime|"
	sv_s = sv_s + " SELECT TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') "
	sv_s = sv_s + " FROM DUAL"
	print(sv_s)
	sv_r = urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	
	CUST.CATOD.startTime = BANCS.OUTPARAM.startTime
	CUST.CATOD.successlogFile = "Upload_Success_" + CUST.CATOD.startTime + ".log"
	CUST.CATOD.failurelogFile = "Upload_Failure_" + CUST.CATOD.startTime + ".log"
	print(CUST.CATOD.startTime)
	print(CUST.CATOD.successlogFile)
	print(CUST.CATOD.successlogFile)
	
	#--------------------------------------------------------------------------------------------------
	# Creating the Sucess and Failure report files
	#--------------------------------------------------------------------------------------------------
	sv_s = "touch " + CUST.CATOD.successlogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	
	sv_s = "touch " + CUST.CATOD.failurelogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	
	#=================================================================================*
	#	Start Reading the CSV file
	#=================================================================================*
	
	sv_o = urtn_fileOpen(CUST.CATOD.fileName + "|r")
	print(sv_o)
	IF (sv_o == 0) THEN
	#{
		CUST.CATOD.fileindex = sv_o
		print(CUST.CATOD.fileindex)
		
		sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")
		IF(sv_x == 0) THEN
		#{
			sv_n = "1"
			sv_v = "Y"
			WHILE(sv_x==0)
			#{
				sv_c = 0
				print(CUST.CATOD.selectedRec)
				print(BANCS.OUTPARAM.buffer)
				CUST.CATOD.selectedRec = BANCS.OUTPARAM.buffer
				CUST.CATOD.recBackUp = CUST.CATOD.selectedRec
				print(CUST.CATOD.selectedRec)
				print(CUST.CATOD.recBackUp)
				#=================================================================================*
				# Reading the data from CSV file
				#=================================================================================*
				sv_l = STRLEN(CUST.CATOD.selectedRec)
				print(sv_l)
				print(CUST.CATOD.selectedRec)
				CUST.CATOD.selectedRec = CUST.CATOD.selectedRec + "|"
				print(CUST.CATOD.selectedRec)
				sv_z=CUST.CATOD.selectedRec
				sv_h="1"
				sv_t = 0
				WHILE(sv_l > 0)
				#{
					sv_l = STRLEN(sv_z)
					print(sv_l)
					sv_p = GETPOSITION(sv_z, "|")
					print(sv_p)
					sv_t = sv_t + 1
					print(sv_t)
					CUST.CATOD.numOfValues = sv_t
					print(CUST.CATOD.numOfValues)
					
					IF(sv_p==0)THEN
					#{
						sv_l=-1
						print(sv_l)
					#}
					ENDIF
					
					sv_a = LEFT$(sv_z, sv_p - 1)
					print(sv_a)
					CUST.CATOD.num=sv_h
					print(CUST.CATOD.num)
					("CUST").("CATOD").("fieldData" + CUST.CATOD.num) = sv_a
					print(sv_a)
					
					sv_h=CINT(CUST.CATOD.num)+1
					print(sv_h)
					
					sv_z = RIGHT$(sv_z, STRLEN(sv_z) - sv_p)
					print(sv_z)
					sv_l=sv_l-sv_p
					print(sv_l)
					
					IF((sv_l == 0)AND(sv_h < 3))THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
				#}
				DO
				IF (CINT(CUST.CATOD.numOfValues) != 3) THEN
				#{
					IF (CINT(CUST.CATOD.numOfValues) > 3) THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						GOTO RECORDSEXCEED
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
					
				#}
				ENDIF
				
				
				
				#--------------- Get Account number from the file ------------------------
				
				IF (CUST.CATOD.fieldData1 != "") THEN
				#{
					print(CUST.CATOD.fieldData1)
					CUST.CATOD.foracid = MID$(CUST.CATOD.fieldData1,0,16)
					CUST.CATOD.foracid = trim(CUST.CATOD.foracid)
					print(CUST.CATOD.foracid)
					sv_u = urhk_getAcctDetailsInRepository(CUST.CATOD.foracid)
					print(sv_u)
					IF(sv_u !=0)THEN
					#{
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Account Number is Invalid"
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
						#}
					ELSE
						#{
						CUST.CATOD.custId = BANCS.OUTPARAM.custId
						CUST.CATOD.acctSolId  = BANCS.OUTPARAM.acctSolId
					#}
					ENDIF
					sv_s = "schm_type,schm_code,acid|"
					sv_s = sv_s + " SELECT GAM.schm_type,GAM.schm_code,GAM.acid"
					sv_s = sv_s + " FROM TBAADM.GAM"
					sv_s = sv_s + " WHERE GAM.foracid = ?SVAR"
					sv_s = sv_s + " AND GAM.del_flg = 'N'"
					sv_s = sv_s + " AND GAM.acct_cls_flg != 'Y'"
					sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
					sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
					print(sv_s)
					
					BANCS.INPARAM.BINDVARS = CUST.CATOD.foracid + "|" + BANCS.STDIN.contextBankId
					sv_d=urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					
					IF (sv_d == 0)  THEN
					#{
						CUST.CATOD.schmType = BANCS.OUTPARAM.schm_type
						print(CUST.CATOD.schmType)
						CUST.CATOD.schmCode = BANCS.OUTPARAM.schm_code
						print(CUST.CATOD.schmCode)
						CUST.CATOD.acid = BANCS.OUTPARAM.acid
						print(CUST.CATOD.acid)
					#}
					ENDIF
					IF (CUST.CATOD.schmType == "SBA") THEN
					#{
						sv_s = "acct_status|"
						sv_s = sv_s + " SELECT SMT.acct_status"
						sv_s = sv_s + " FROM TBAADM.SMT"
						sv_s = sv_s + " WHERE SMT.acid = ?SVAR"
						sv_s = sv_s + " AND SMT.bank_id = ?SVAR"
						print(sv_s)
						
						BANCS.INPARAM.BINDVARS = CUST.CATOD.acid + "|" + BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						sv_d=urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF (sv_d == 0)  THEN
						#{
							CUST.CATOD.acctStatus = BANCS.OUTPARAM.acct_status
							print(CUST.CATOD.acctStatus)
						#}
						ENDIF
						IF (CUST.CATOD.acctStatus != "A")  THEN
						#{
							sv_v = "N"
							sv_c = sv_c + 1
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Account is invalid, dormant, freezed OR blocked "
							GOTO INVALID
						#}
						ENDIF
					#}
					ENDIF
					IF (CUST.CATOD.schmType == "ODA") THEN
					#{
						sv_s = "acct_status|"
						sv_s = sv_s + " SELECT CAM.acct_status"
						sv_s = sv_s + " FROM TBAADM.CAM"
						sv_s = sv_s + " WHERE CAM.acid = ?SVAR"
						sv_s = sv_s + " AND CAM.bank_id = ?SVAR"
						print(sv_s)
						
						BANCS.INPARAM.BINDVARS = CUST.CATOD.acid + "|" + BANCS.STDIN.contextBankId
						sv_d=urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF (sv_d == 0)  THEN
						#{
							CUST.CATOD.acctStatus = BANCS.OUTPARAM.acct_status
						#}
						ENDIF
						IF (CUST.CATOD.acctStatus == "A")  THEN
						#{
							sv_v = "N"
							sv_c = sv_c + 1
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Account is invalid, dormant, freezed OR blocked "
							GOTO INVALID
						#}
						ENDIF
					#}
					ENDIF
					IF (CUST.CATOD.schmType == "TDA") THEN
					#{
						sv_s = "acct_status|"
						sv_s = sv_s + " SELECT TAM.acct_status"
						sv_s = sv_s + " FROM TBAADM.TAM"
						sv_s = sv_s + " WHERE TAM.acid = ?SVAR"
						sv_s = sv_s + " AND TAM.bank_id = ?SVAR"
						print(sv_s)
						
						BANCS.INPARAM.BINDVARS = CUST.CATOD.acid + "|" + BANCS.STDIN.contextBankId
						sv_d=urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF (sv_d == 0)  THEN
						#{
							CUST.CATOD.acctStatus = BANCS.OUTPARAM.acct_status
						#}
						ENDIF
						IF (CUST.CATOD.acctStatus == "A")  THEN
						#{
							sv_v = "N"
							sv_c = sv_c + 1
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Account is invalid, dormant, freezed OR blocked "
							GOTO INVALID
						#}
						ENDIF
					#}
					ENDIF
					
					# Added for restricting the allowed scheme codes = TO369221
					
					#-----------------------------------------------------------
					#               Fetching valid schmecode:
					#-----------------------------------------------------------
					BANCS.INPUT.moduleName = "CATODSCORE"
					BANCS.INPUT.parameterId = "ALWDSCHM"
					CALL("getcparamvalue.scr")
					
					IF (BANCS.OUTPUT.parameterVal != "")THEN
					#{
						print(BANCS.OUTPUT.parameterVal)
						sv_l = STRLEN(BANCS.OUTPUT.parameterVal)
						print(sv_l)
						CUST.CATOD.sType=BANCS.OUTPUT.parameterVal
						print(CUST.CATOD.sType)
						WHILE(sv_l > 0)
						#{
							sv_g = GETPOSITION(CUST.CATOD.sType,",")
							print(sv_g)
							IF (sv_g == 0) THEN
							#{
								CUST.CATOD.alwSchmType = CUST.CATOD.sType
								print(CUST.CATOD.alwSchmType)
								CUST.CATOD.sType = ""
								#}
							ELSE
								#{
								CUST.CATOD.alwSchmType = TRIM(MID$(CUST.CATOD.sType,0,sv_g - 1))
								CUST.CATOD.sType = MID$(CUST.CATOD.sType,sv_g,sv_l)
							#}
							ENDIF
							print(CUST.CATOD.alwSchmType)
							IF (CUST.CATOD.schmCode ==CUST.CATOD.alwSchmType) THEN
							#{
								GOTO LABEL1
							#}
							ENDIF
							print(CUST.CATOD.sType)
							sv_l = STRLEN(CUST.CATOD.sType)
							print(sv_l)
							IF (sv_l == 0) THEN
							#{
								sv_v = "N"
								sv_c = sv_c + 1
								CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Account scheme is not allowed."
								GOTO INVALID
							#}
							ENDIF
							# }
						#}
						DO
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Account scheme is not allowed."
						GOTO INVALID
						
						# }
					#}
					ENDIF
					
					LABEL1:
						
						
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Account Number is Missing"
						GOTO INVALID
					#}
					ENDIF
					
					#----- EMPLOYER
					IF (CUST.CATOD.fieldData2 != "") THEN
					#{
						print(CUST.CATOD.fieldData2)
						CUST.CATOD.fieldData2 = MID$(CUST.CATOD.fieldData2,0,15)
						CUST.CATOD.employr = CUST.CATOD.fieldData2
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "field2 is Missing"
						GOTO INVALID
					#}
					ENDIF
					
					
					#----- CONTRACT_AMT
					IF (CUST.CATOD.fieldData3 != "") THEN
					#{
						#Changes done by Priya K
						print(CUST.CATOD.fieldData3)
						CUST.CATOD.recordLen = ""
						CUST.CATOD.recordLen = STRLEN(CUST.CATOD.fieldData3)
						IF("0" != CUST.CATOD.recordLen ) THEN
						#{
							sv_p = GETPOSITION(CUST.CATOD.fieldData3,".")
							print(sv_p)
							sv_f = MID$(CUST.CATOD.fieldData3,0,sv_p-1)
							print(sv_f)
						#}
						ENDIF
						CUST.CATOD.feildDataTemp1 = TRIM(sv_f)
						
						sv_r = MID$(CUST.CATOD.fieldData3,sv_p,CINT(CUST.CATOD.recordLen))
						print(sv_r)
						
						CUST.CATOD.cntrctAmt = sv_f + sv_r
						print(CUST.CATOD.cntrctAmt)
						sv_u = urhk_B2k_isStringNumeric (CUST.CATOD.cntrctAmt)
						print(sv_u)
						IF(sv_u != 0) THEN
						#{
							sv_v = "N"
							sv_c = sv_c + 1
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "field3 is not in numeric format"
							GOTO INVALID
						#}
						ENDIF
						CUST.CATOD.cntrctAmt=CUST.CATOD.fieldData3
						print(CUST.CATOD.cntrctAmt)
						#Changes ends here
						
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "field3 is Missing"
						GOTO INVALID
					#}
					ENDIF
					
					# Defualting fields as per TO
					
					#----- Score
					CUST.CATOD.score = ""
					
					#----- MaxContract Amount
					CUST.CATOD.maxCntrctAmt = ""
					
					#-------------------------------------------------------------------------
					# CALCULATING THE MAX CONTRACT AMOUNT
					# MAX_CNTRT_AMT  will be the sum of CONTRACT_AMT and the following charges
					# 2% of CONTRACT_AMT or 200 KES (whichever is higher)  -- Contract Fees
					# 10% of CONTRACT_AMT or 200 KES (whichever is higher) . Availment fees
					# 50 KES . Withdrawal charge
					#---------------------------------------------------------------------------
					
					print(CUST.CATOD.cntrctAmt)
					lv_t = CDOUBLE(CUST.CATOD.cntrctAmt) * 2/100
					lv_u = CDOUBLE(CUST.CATOD.cntrctAmt) * 10/100
					lv_w = 50
					
					print(lv_t)
					print(lv_u)
					
					IF ( lv_t < 200 ) THEN
					#{
						lv_t = 200
					#}
					ENDIF
					IF (BANCS.STDIN.contextBankId == "55") THEN
					#{
						IF ( lv_u < 5000 ) THEN
						#{
							lv_u = 5000
						#}
						ENDIF
						#}
					ELSE
						#{
						IF ( lv_u < 200 ) THEN
						#{
							lv_u = 200
						#}
						ENDIF
					#}
					ENDIF
					
					CUST.CATOD.maxCntrctAmt = CDOUBLE(CUST.CATOD.cntrctAmt) + lv_t + lv_u + 50
					
					
					#----- MAX_CNTRT_PERIOD
					CUST.CATOD.maxCntrctPeriod="12"
					
					#----- DEPARTMENT
					CUST.CATOD.dept=""
					
					
					#			IF(CUST.CATOD.acctSolId == BANCS.STDIN.homeSolId) THEN
					#			#{
					CALL("catodscoredp003.scr")
					print(CUST.CATOD.numOfValues)
					print(sv_c)
					IF ((CINT(CUST.CATOD.numOfValues) == 3) AND (sv_c == 0)) THEN
					#{
						sv_s = "echo" + " '" +  CUST.CATOD.recBackUp + "||||' >>" + " " + CUST.CATOD.successlogFile
						sv_d = system(sv_s)
						print(sv_d)
						#}
					ELSE
						#{
						GOTO INVALID
					#}
					ENDIF
					#{
					#			ELSE
					#			#{
					#				sv_v = "N"
					#				sv_c = sv_c + 1
					#				CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Users can only upload accounts belonging to their Sols"
					#				GOTO INVALID
					#			#}
					#			ENDIF
					IF (CUST.CATOD.errColl != "") THEN
					#{
						GOTO INVALID
					#}
					ENDIF
				INVALID:
					print(sv_c)
					IF (sv_c  != 0 ) THEN
					#{
						
						CUST.CATOD.error = CUST.CATOD.recBackUp + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				RECORDSEXCEED:
					IF (sv_c  != 0 ) THEN
					#{
						CUST.CATOD.error = CUST.CATOD.fieldData1 + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				NEXTREC:
					#=================================================================================*
					# Reading the data from CSV file
					#=================================================================================*
					print(CUST.CATOD.fileindex)
					sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")
					print(sv_x)
					print(sv_n)
					CUST.CATOD.recCnt = sv_n
					sv_n = CINT(CUST.CATOD.recCnt) + 1
					CUST.CATOD.recCnt = sv_n
					sv_n = CUST.CATOD.recCnt
					print(sv_n)
				#}
				DO
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Upload Process Initiated Success fully - Check status in HPR after some time "
				print(sv_g)
				sv_z = urhk_SetOrbOut(sv_g)
				print(sv_z)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_e = "File Opened but Unable to Read."
				sv_m = "fileName"
				CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				GOTO FAILURE
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_e = "Not able to open the file for upload."
			sv_m = "fileName"
			CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
			GOTO FAILURE
		#}
		ENDIF
		
	FAILURE:
		sv_z = "SuccessOrFailure|N"
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		sv_z = CUST.CATOD.errMsg
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		
		
	ENDOFSCRIPT:
		
		IF (CUST.CATOD.errMsg == "") THEN
		#{
			#==========================================================================*
			#Pushing the Reports to HPR menu
			#==========================================================================*
			#-----------------------------------
			# Report Generation
			#-----------------------------------
			
			sv_b = urhk_getEnv("FIN_REPORTS_DIR")
			print(sv_b)
			IF (sv_b==0) THEN
			#{
				CUST.CATOD.envValue = BANCS.OUTPARAM.envValue
				print(CUST.CATOD.envValue)
			#}
			ENDIF
			
			CUST.CATOD.envValue =CUST.CATOD.envValue
			print(CUST.CATOD.envValue)
			
			#sv_a = urhk_B2K_printRepos("CUST")
			#print(sv_a)
			
			#-----------------------------------
			# Success Report
			#-----------------------------------
			sv_s = "mrbx4004 $B2K_SESSION_ID catodscoredp002.mrt " + CUST.CATOD.successlogFile + " " + CUST.CATOD.successlogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.successlogFile = CUST.CATOD.successlogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/" + BANCS.STDIN.userId  +"/" + CUST.CATOD.successlogFile+  " 'SUCCESS UPLOAD REPORT FOR CATODAPP' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			#-----------------------------------
			# Failure Report
			#-----------------------------------
			
			sv_s = "mrbx4004 $B2K_SESSION_ID catodscoredp001.mrt " + CUST.CATOD.failurelogFile + " " + CUST.CATOD.failurelogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.failurelogFile = CUST.CATOD.failurelogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/"+ BANCS.STDIN.userId +"/"+CUST.CATOD.failurelogFile+" 'FAILURE UPLOAD REPORT FOR CATODAPP' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			
		#}
		ENDIF
		
		EXITSCRIPT
