<--START
CHECKSUM="55ecb5f3b3b07b09dba2d51cca0122961799f236695a15ffe3ba4b0299ad26f7"
	# Script body goes here
	TRACE ON
	PRINT("e")
	sv_u = urhk_B2k_PRINTRepos("BANCS")
	PRINT(sv_u)
	
	#------------------------------------------
	# Repository creation
	#------------------------------------------
	
	sv_r = REPEXISTS("DPD")
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("DPD")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("DPD","CHRG")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("DPD","CHRG",5)
	#}
	ENDIF
	
	DPD.CHRG.foracid = BANCS.INPUT.Foracid
	
	DPD.CHRG.schmCode = BANCS.INPUT.schmCode
	
	DPD.CHRG.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
	
	DPD.CHRG.custCnt = 0
	
	DPD.CHRG.custDPDCnt = 0
	
	DPD.CHRG.collAmt = 0.00
	
	DPD.CHRG.taxPcnt = 0.00
	
	DPD.CHRG.clrBalAmt = 0.00
	
	DPD.CHRG.prfmFlgCnt = 0

	DPD.CHRG.LoanBal = 0.00

	IF ( DPD.CHRG.foracid != "") THEN
	#{
		sv_h = urhk_getAcctDetailsInRepository(DPD.CHRG.foracid)
			
		IF(sv_h == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.clearBalance)
			DPD.CHRG.LoanBal = TRIM(BANCS.OUTPARAM.clearBalance)
			Print (DPD.CHRG.LoanBal)
		#}
		ELSE
		#{
			PRINT("Error in fetching repository values for the foracid!!")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	ELSE
	#{
		PRINT("Error in gettign value for the foracid!")
		GOTO ENDOFSCRIPT

	#}
	ENDIF
	
	#------------------------------------------------------------------------
	# checking in the scheme code of the account belongs to LA527 or LA529.
	# if not, exit script
	#------------------------------------------------------------------------

	IF (DPD.CHRG.LoanBal < -100) THEN
	#{
		PRINT (DPD.CHRG.LoanBal)

	IF((DPD.CHRG.schmCode != "LA527") AND (DPD.CHRG.schmCode != "LA529"))THEN
	#{
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		
		#--------------------------------------------------------------
		# checking in the scheme code belongs to LA527 or LA529.
		# Check the record in GAC table and get the DPD counter.
		#--------------------------------------------------------------
		
		sv_a = ""
		
		sv_a = sv_a + "cnt|SELECT COUNT(1) FROM TBAADM.GAC "
		sv_a = sv_a + " WHERE ACID = (SELECT ACID FROM TBAADM.GAM "
		sv_a = sv_a + " WHERE FORACID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N' AND BANK_ID = ?SVAR) "
		sv_a = sv_a + " AND BANK_ID = ?SVAR "
		
		BANCS.INPARAM.BINDVARS = DPD.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		
		PRINT(BANCS.INPARAM.BINDVARS)
		
		PRINT(sv_a)
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		
		IF(sv_b == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.cnt)
			#--------------------------------------------------------------
			# Check the record in GAC table and get the DPD counter.
			# if no DPD counter, then exit script
			#--------------------------------------------------------------
			IF(BANCS.OUTPARAM.cnt == 0)THEN
			#{
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				
				#--------------------------------------------------------------
				# getting DPD counter, DPD_AS_ON_DATE from GAC table
				#--------------------------------------------------------------
				
				sv_c = ""
				sv_c = sv_c + "acid,dpdCntr,dpdAsOnDate|SELECT ACID, DPD_CNTR, DPD_ASON_DATE FROM TBAADM.GAC "
				sv_c = sv_c + " WHERE ACID = (SELECT ACID FROM TBAADM.GAM "
				sv_c = sv_c + " WHERE FORACID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N' AND BANK_ID = ?SVAR) "
				sv_c = sv_c + " AND BANK_ID = ?SVAR AND to_date(DPD_ASON_DATE,'DD-MON-YY') <= to_date(?SVAR,'DD-MM-YYYY') "
				
				BANCS.INPARAM.BINDVARS = DPD.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + DPD.CHRG.BODDate
				
				PRINT(BANCS.INPARAM.BINDVARS)
				
				PRINT(sv_c)
				sv_d = urhk_dbSelectWithBind(sv_c)
				PRINT(sv_d)
				
				IF(sv_d == 0)THEN
				#{
					PRINT(BANCS.OUTPARAM.acid)
					PRINT(BANCS.OUTPARAM.dpdCntr)
					PRINT(BANCS.OUTPARAM.dpdAsOnDate)
					
					DPD.CHRG.dpdCntr = BANCS.OUTPARAM.dpdCntr
					DPD.CHRG.dpdAsOnDate = BANCS.OUTPARAM.dpdAsOnDate
					DPD.CHRG.acid = BANCS.OUTPARAM.acid
					
					#------------------------------------------------------------------------------------------
					# based on DPD counter value, check if tax is applicable for given account in custom table
					#------------------------------------------------------------------------------------------
					
					#IF((DPD.CHRG.dpdCntr == 1) OR (DPD.CHRG.dpdCntr == 31) OR (DPD.CHRG.dpdCntr == 61))THEN
					IF(DPD.CHRG.dpdCntr > 0)THEN
					#{
						
						#------------------------------------------------------------------------
						# check for entry in CUSTOM.DCDT table to check if charges are collected
						# As the entry in CUSTOM.DCDT ensures charges collected,
						# checking the for entry in this custom table
						#------------------------------------------------------------------------
						
						sv_e = ""
						
						sv_e = sv_e + "custCnt|SELECT COUNT(1) FROM CUSTOM.DCDT "
						sv_e = sv_e + " WHERE ACID = ?SVAR "
						sv_e = sv_e + " AND BANK_ID = ?SVAR"
						
						BANCS.INPARAM.BINDVARS = DPD.CHRG.acid + "|" + BANCS.STDIN.contextBankId
						
						PRINT(sv_e)
						
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_l = urhk_dbSelectWithBind(sv_e)
						
						PRINT(sv_l)
						
						IF(sv_l != 0)THEN
						#{
							
							PRINT("error in fetching data from CUSTOM.DCDT!!")
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						PRINT(BANCS.OUTPARAM.custCnt)
						DPD.CHRG.custCnt = BANCS.OUTPARAM.custCnt
						
						#------------------------------------------------------------------------
						# if entry in CUSTOM.DCDT table exists,
						# get count of records for the acid from the same
						#------------------------------------------------------------------------
						
						IF(DPD.CHRG.custCnt != 0)THEN
						#{
							sv_e = ""
							
							sv_e = sv_e + "custDPDCnt,custAsOnDate|SELECT dpd_cntr,DPD_ASON_DATE from CUSTOM.DCDT "
							sv_e = sv_e + " WHERE ACID = ?SVAR "
							sv_e = sv_e + " AND BANK_ID = ?SVAR "
							sv_e = sv_e + " AND  DPD_ASON_DATE = (select max(DPD_ASON_DATE) from custom.dcdt where acid = ?SVAR "
							sv_e = sv_e + " AND BANK_ID = ?SVAR)"
							
							BANCS.INPARAM.BINDVARS = DPD.CHRG.acid + "|" + BANCS.STDIN.contextBankId + "|" + DPD.CHRG.acid + "|" + BANCS.STDIN.contextBankId
							
							PRINT(sv_e)
							
							PRINT(BANCS.INPARAM.BINDVARS)
							
							sv_m = urhk_dbSelectWithBind(sv_e)
							
							PRINT(sv_m)
							
							IF(sv_m != 0)THEN
							#{
								PRINT("Error in fetching max dpd counter from CUSTOM.DCDT!!")
								GOTO ENDOFSCRIPT
							#}
							ENDIF
							
							PRINT(BANCS.OUTPARAM.custDPDCnt)
							DPD.CHRG.custDPDCnt = BANCS.OUTPARAM.custDPDCnt
							
							PRINT(BANCS.OUTPARAM.custAsOnDate)
							
							PRINT(DPD.CHRG.dpdCntr)
							PRINT(DPD.CHRG.custDPDCnt)
							
							sv_q = "dateDiff|select to_date(?SVAR,'DD-MON-YYYY')-to_date(?SVAR,'DD-MON-YYYY') from dual"
							BANCS.INPARAM.BINDVARS = DPD.CHRG.dpdAsOnDate + "|" +  BANCS.OUTPARAM.custAsOnDate
							PRINT(BANCS.INPARAM.BINDVARS)
							
							sv_q = urhk_dbSelectWithBind(sv_q)
							PRINT(sv_q)
							PRINT(BANCS.OUTPARAM.dateDiff)
							
							IF((DPD.CHRG.dpdCntr <= DPD.CHRG.custDPDCnt) AND (BANCS.OUTPARAM.dateDiff >=28))THEN
							#{
								#------------------------------------------------------------------------
								# get max of performance counter and update with next greater value
								# this is included for to know if the account becomes performing again
								#-------------------------------------------------------------------------
								
								sv_e = ""
								sv_e = sv_e + "prfmCnt|SELECT max(ACCT_PERFORMANCE_FLG) from CUSTOM.DCDT "
								sv_e = sv_e + " WHERE ACID = ?SVAR "
								sv_e = sv_e + " AND BANK_ID = ?SVAR GROUP BY ACID"
								
								BANCS.INPARAM.BINDVARS = DPD.CHRG.acid + "|" + BANCS.STDIN.contextBankId
								
								PRINT(sv_e)
								
								PRINT(BANCS.INPARAM.BINDVARS)
								
								sv_n = urhk_dbSelectWithBind(sv_e)
								
								IF(sv_n == 0)THEN
								#{
									PRINT(BANCS.OUTPARAM.prfmCnt)
									
									DPD.CHRG.prfmFlgCnt = BANCS.OUTPARAM.prfmCnt
									
									IF((DPD.CHRG.prfmFlgCnt != "null") OR (DPD.CHRG.prfmFlgCnt != ""))THEN
									#{
										
										DPD.CHRG.newPrfm = CINT(DPD.CHRG.prfmFlgCnt) + 1
										PRINT(DPD.CHRG.newPrfm)
										
										sv_e = ""
										sv_e = sv_e + "UPDATE CUSTOM.DCDT SET ACCT_PERFORMANCE_FLG = ?SVAR "
										sv_e = sv_e + " WHERE ACID = ?SVAR "
										sv_e = sv_e + " AND BANK_ID = ?SVAR AND ACCT_PERFORMANCE_FLG = 0"
										
										BANCS.INPARAM.BINDVARS = DPD.CHRG.newPrfm + "|" + DPD.CHRG.acid +"|"+ BANCS.STDIN.contextBankId
										
										sv_f = urhk_dbSQLWithBind(sv_e)
										
										PRINT(sv_f)
										
										IF(sv_f!=0)THEN
										#{
											PRINT("error in updating data into custom table")
										#}
										ENDIF
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
						
						PRINT(DPD.CHRG.dpdCntr)
						PRINT(DPD.CHRG.custDPDCnt)
						
						#-----------------------------------------------------------------
						# getting custom data for the present non performing accounts
						#-----------------------------------------------------------------
						
						sv_e = ""
						
						sv_e = sv_e + "custCnt|SELECT COUNT(1) FROM CUSTOM.DCDT "
						sv_e = sv_e + " WHERE ACID = ?SVAR "
						sv_e = sv_e + " AND BANK_ID = ?SVAR AND ACCT_PERFORMANCE_FLG = 0 "
						
						BANCS.INPARAM.BINDVARS = DPD.CHRG.acid + "|" + BANCS.STDIN.contextBankId
						
						PRINT(sv_e)
						
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_l = urhk_dbSelectWithBind(sv_e)
						
						PRINT(sv_l)
						
						IF(sv_l != 0)THEN
						#{
							
							PRINT("error in fetching data from CUSTOM.DCDT!!")
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						PRINT(BANCS.OUTPARAM.custCnt)
						DPD.CHRG.custCnt = BANCS.OUTPARAM.custCnt
						
						IF(DPD.CHRG.custCnt > 0)THEN
						#{
							
							sv_e = ""
							
							sv_e = sv_e + "custDPDCnt|SELECT max(dpd_cntr) FROM CUSTOM.DCDT "
							sv_e = sv_e + " WHERE ACID = ?SVAR "
							sv_e = sv_e + " AND BANK_ID = ?SVAR AND ACCT_PERFORMANCE_FLG = 0  GROUP BY ACID"
							
							BANCS.INPARAM.BINDVARS = DPD.CHRG.acid + "|" + BANCS.STDIN.contextBankId
							
							PRINT(sv_e)
							
							PRINT(BANCS.INPARAM.BINDVARS)
							
							sv_l = urhk_dbSelectWithBind(sv_e)
							
							PRINT(sv_l)
							
							IF(sv_l != 0)THEN
							#{
								
								PRINT("error in fetching data from CUSTOM.DCDT!!")
								GOTO ENDOFSCRIPT
							#}
							ENDIF
							
							PRINT(BANCS.OUTPARAM.custDPDCnt)
							DPD.CHRG.custDPDCnt = BANCS.OUTPARAM.custDPDCnt
						#}
						ENDIF
						
						IF(DPD.CHRG.custCnt == 0)THEN
						#{
							DPD.CHRG.custDPDCnt = 0
						#}
						ENDIF
						
						PRINT(DPD.CHRG.dpdCntr)
						PRINT(DPD.CHRG.custCnt)
						PRINT(DPD.CHRG.custDPDCnt)
						
						#-------------------------------------------------------------------------
						# the below logic is to include the holiday impact on DPD counter
						# if dpdCntr > 60, check is done if charges are calculated for DPD >60
						# custCnt is record count from DCDT corresponding to charges collected.
						# if only 2 recs exist and DPD > 60 => charges to be collected for >60 bucket
						#-------------------------------------------------------------------------
						
						IF(DPD.CHRG.dpdCntr>60)THEN
						#{
							PRINT(DPD.CHRG.dpdCntr)
							PRINT(DPD.CHRG.custCnt)
							PRINT(DPD.CHRG.custDPDCnt)
							PRINT(DPD.CHRG.prfmFlgCnt)
							
							IF((DPD.CHRG.dpdCntr >= DPD.CHRG.custDPDCnt) AND (DPD.CHRG.custCnt == 2)  AND (DPD.CHRG.prfmFlgCnt == 0))THEN
							#{
								GOTO TAXPCNTCALC
								#}
							ELSE
								#{
								GOTO ENDOFSCRIPT
							#}
							ENDIF
							#}
						ELSE
							#{
							
							#-------------------------------------------------------------------------
							# the below logic is to include the holiday impact on DPD counter
							# if dpdCntr > 30, check is done if charges are calculated for DPD >30
							# custCnt is record count from DCDT corresponding to charges collected.
							# if only 1 recs exist and DPD > 30 => charges to be collected for >30 bucket
							#-------------------------------------------------------------------------
							
							IF(DPD.CHRG.dpdCntr>30)THEN
							#{
								PRINT(DPD.CHRG.dpdCntr)
								PRINT(DPD.CHRG.custCnt)
								PRINT(DPD.CHRG.custDPDCnt)
								PRINT(DPD.CHRG.prfmFlgCnt)
								
								IF((DPD.CHRG.dpdCntr >= DPD.CHRG.custDPDCnt) AND (DPD.CHRG.custCnt == 1) AND (DPD.CHRG.prfmFlgCnt == 0))THEN
								#{
									GOTO TAXPCNTCALC
									#}
								ELSE
									#{
									GOTO ENDOFSCRIPT
								#}
								ENDIF
								
								#}
							ELSE
								#{
								
								#-------------------------------------------------------------------------
								# the below logic is to include the holiday impact on DPD counter
								# if dpdCntr > 0, check is done if charges are calculated for DPD >0
								# custCnt is record count from DCDT corresponding to charges collected.
								# if no recs exist and DPD > 0 => charges to be collected for >0 bucket
								#-------------------------------------------------------------------------
								IF(DPD.CHRG.dpdCntr>0)THEN
								#{
									PRINT(DPD.CHRG.dpdCntr)
									PRINT(DPD.CHRG.custCnt)
									PRINT(DPD.CHRG.custDPDCnt)
									PRINT(DPD.CHRG.prfmFlgCnt)
									
									IF((DPD.CHRG.dpdCntr >= DPD.CHRG.custDPDCnt) AND (DPD.CHRG.custCnt == 0) AND (DPD.CHRG.prfmFlgCnt == 0))THEN
									#{
										GOTO TAXPCNTCALC
										#}
									ELSE
										#{
										GOTO ENDOFSCRIPT
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
							
						#}
						ENDIF
						
						#}
					ELSE
						#{
						PRINT("DPD counter is 0!!")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					#}
				ELSE
					#{
					
					PRINT("error in GAC query OR no records found!!")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			
			PRINT("Error in the GAC query")
		#}
		ENDIF
		
	#}
	ENDIF

	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	TAXPCNTCALC:
		#--------------------------------------------------------------
		# check for entry in CUSTOM.CLTFM table for tax pcnt
		#--------------------------------------------------------------
		
		sv_e = ""
		
		sv_e = sv_e + "cnt1|SELECT COUNT(1) FROM CUSTOM.CLTFM "
		sv_e = sv_e + " WHERE ACCOUNT_NUMBER = ?SVAR OR SCHEME_CODE = ?SVAR "
		sv_e = sv_e + " OR CIF_ID = (SELECT CIF_ID FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR "
		sv_e = sv_e + " AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N') AND TAX_APPLICABLE = 'Y' "
		sv_e = sv_e + " AND ENTITY_CRE_FLAG = 'Y' AND DEL_FLG = 'N' AND TAX_PERCENTAGE > 0 "
		sv_e = sv_e + " AND BANK_ID = ?SVAR "
		
		BANCS.INPARAM.BINDVARS = DPD.CHRG.foracid +"|"+ DPD.CHRG.schmCode + "|" + DPD.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		
		PRINT(sv_e)
		
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_f = urhk_dbSelectWithBind(sv_e)
		
		PRINT(sv_f)
		
		IF(sv_f == 0)THEN
		#{
			
			PRINT(BANCS.OUTPARAM.cnt1)
			
			#--------------------------------------------------------------------------------
			# if the count is 0, then no record exists, so set collAmt as 0 and exit script
			# if the count is 1, then the available tax pcnt is taken.
			# if count > 1, then, the below is the order of priority
			# ACCT > CIF > SCHM
			#---------------------------------------------------------------------------------
			
			IF(BANCS.OUTPARAM.cnt1 == 0)THEN
			#{
				DPD.CHRG.collAmt = 0
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			IF(BANCS.OUTPARAM.cnt1 == 1)THEN
			#{
				sv_g = ""
				sv_g = sv_g + "taxPcnt|SELECT TAX_PERCENTAGE FROM CUSTOM.CLTFM "
				sv_g = sv_g + " WHERE ACCOUNT_NUMBER = ?SVAR OR SCHEME_CODE = ?SVAR "
				sv_g = sv_g + " OR CIF_ID = (SELECT CIF_ID FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR "
				sv_g = sv_g + " AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N') AND TAX_APPLICABLE = 'Y' "
				sv_g = sv_g + " AND ENTITY_CRE_FLAG = 'Y' AND DEL_FLG = 'N' "
				sv_g = sv_g + " AND BANK_ID = ?SVAR "
				
				BANCS.INPARAM.BINDVARS = DPD.CHRG.foracid +"|"+ DPD.CHRG.schmCode + "|" + DPD.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
				
				PRINT(sv_g)
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_h = urhk_dbSelectWithBind(sv_g)
				
				IF(sv_h == 0)THEN
				#{
					PRINT(BANCS.OUTPARAM.taxPcnt)
					
					DPD.CHRG.taxPcnt = BANCS.OUTPARAM.taxPcnt
					
					GOTO CHARGECALC
					
					#}
				ELSE
					#{
					PRINT("error in fetching tax percent from custom.CLTFM !!")
					DPD.CHRG.collAmt = 0
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_g = ""
				sv_g = sv_g + "taxPcnt|SELECT TAX_PERCENTAGE FROM CUSTOM.CLTFM "
				sv_g = sv_g + " WHERE ACCOUNT_NUMBER = ?SVAR AND TAX_APPLICABLE = 'Y' "
				sv_g = sv_g + " AND ENTITY_CRE_FLAG = 'Y' AND DEL_FLG = 'N' "
				sv_g = sv_g + " AND BANK_ID = ?SVAR "
				
				BANCS.INPARAM.BINDVARS = DPD.CHRG.foracid + "|" + BANCS.STDIN.contextBankId
				
				PRINT(sv_g)
				sv_h = urhk_dbSelectWithBind(sv_g)
				IF(sv_h == 0)THEN
				#{
					PRINT(BANCS.OUTPARAM.taxPcnt)
					DPD.CHRG.taxPcnt = BANCS.OUTPARAM.taxPcnt
					
					GOTO CHARGECALC
					#}
				ELSE
					#{
					
					sv_g = ""
					sv_g = sv_g + "taxPcnt|SELECT TAX_PERCENTAGE FROM CUSTOM.CLTFM "
					sv_g = sv_g + " WHERE CIF_ID = (SELECT CIF_ID FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR "
					sv_g = sv_g + " AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N') AND TAX_APPLICABLE = 'Y' "
					sv_g = sv_g + " AND ENTITY_CRE_FLAG = 'Y' AND DEL_FLG = 'N' "
					sv_g = sv_g + " AND BANK_ID = ?SVAR "
					
					BANCS.INPARAM.BINDVARS = DPD.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
					
					sv_j = urhk_dbSelectWithBind(sv_g)
					
					IF(sv_j == 0)THEN
					#{
						PRINT(BANCS.OUTPARAM.taxPcnt)
						DPD.CHRG.taxPcnt = BANCS.OUTPARAM.taxPcnt
						
						GOTO CHARGECALC
						#}
					ELSE
						#{
						
						sv_g = ""
						sv_g = sv_g + "taxPcnt|SELECT TAX_PERCENTAGE FROM CUSTOM.CLTFM "
						sv_g = sv_g + " WHERE SCHEME_CODE = ?SVAR AND TAX_APPLICABLE = 'Y' "
						sv_g = sv_g + " AND ENTITY_CRE_FLAG = 'Y' AND DEL_FLG = 'N' "
						sv_g = sv_g + " AND BANK_ID = ?SVAR "
						
						BANCS.INPARAM.BINDVARS = DPD.CHRG.schmCode + "|" + BANCS.STDIN.contextBankId
						
						sv_k = urhk_dbSelectWithBind(sv_g)
						
						IF(sv_k == 0)THEN
						#{
							PRINT(BANCS.OUTPARAM.taxPcnt)
							DPD.CHRG.taxPcnt = BANCS.OUTPARAM.taxPcnt
							
							GOTO CHARGECALC
							#}
						ELSE
							#{
							PRINT("Error in fetching tax percent from Custom table")
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			PRINT("Error in fetching data from custom CLTFM table")
			
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		GOTO ENDOFSCRIPT
		
		
	CHARGECALC:
		
		PRINT(DPD.CHRG.schmCode)
		
		IF(DPD.CHRG.schmCode == "LA527")THEN
		#{
			sv_h = urhk_getAcctDetailsInRepository(DPD.CHRG.foracid)
			
			IF(sv_h == 0)THEN
			#{
				PRINT(BANCS.OUTPARAM.clearBalance)
				DPD.CHRG.clrBalAmt = TRIM(BANCS.OUTPARAM.clearBalance)
				
				#----------------------------------------------------------------------------
				# multiplied by -1 to convert the amount into positive value
				# as negative value is throwing error while returning collAmt from script
				#----------------------------------------------------------------------------
				
				IF(DPD.CHRG.clrBalAmt < 0)THEN
				#{
					DPD.CHRG.clrBalAmt = CDOUBLE(DPD.CHRG.clrBalAmt) * (-1)
				#}
				ENDIF
				
				#}
			ELSE
				#{
				PRINT("Error in fetching repository values for the foracid!!")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF(DPD.CHRG.schmCode == "LA529")THEN
		#{
			sv_h = ""
			sv_h = sv_h + "dmdAmt|SELECT (PRIN_DMD_OS + INT_DMD_OS + BCHG_DMD_OS + OCHG_DMD_OS) FROM TBAADM.LAM "
			sv_h = sv_h + " WHERE ACID = (SELECT ACID from TBAADM.GAM where FORACID = ?SVAR AND BANK_ID = ?SVAR) "
			sv_h = sv_h + " AND BANK_ID = ?SVAR "
			
			BANCS.INPARAM.BINDVARS = DPD.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
			
			sv_i = urhk_dbSelectWithBind(sv_h)
			
			PRINT(sv_i)
			
			IF(sv_i == 0)THEN
			#{
				PRINT(BANCS.OUTPARAM.dmdAmt)
				DPD.CHRG.clrBalAmt = TRIM(BANCS.OUTPARAM.dmdAmt)
				#}
			ELSE
				#{
				PRINT("error in fetching demand amounts for given foracid!!")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF
		
		PRINT(DPD.CHRG.clrBalAmt)
		PRINT(DPD.CHRG.taxPcnt)
		
		#sv_p = CDOUBLE(DPD.CHRG.clrBalAmt)
		DPD.CHRG.taxPcnt = CDOUBLE(DPD.CHRG.taxPcnt)/100
		PRINT(DPD.CHRG.taxPcnt)
		
		DPD.CHRG.coll = CDOUBLE(DPD.CHRG.clrBalAmt) * CDOUBLE(DPD.CHRG.taxPcnt)
		
		PRINT(DPD.CHRG.coll)
		
		DPD.CHRG.collAmt =  DPD.CHRG.coll
		
		PRINT(DPD.CHRG.collAmt)
		
		sv_e = ""
		sv_e = sv_e + "INSERT INTO CUSTOM.DCDT(acid, dpd_cntr, dpd_ason_date, chrg_amt, bank_id, acct_performance_flg) "
		sv_e = sv_e + " Values (?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR,0)"
		
		BANCS.INPARAM.BINDVARS = DPD.CHRG.acid +"|"+ DPD.CHRG.dpdCntr +"|"+ DPD.CHRG.dpdAsOnDate +"|"+ DPD.CHRG.collAmt +"|"+ BANCS.STDIN.contextBankId
		
		sv_f = urhk_dbSQLWithBind(sv_e)
		
		PRINT(sv_f)
		
		IF(sv_f!=0)THEN
		#{
			PRINT("error in inserting data into custom table")
		#}
		ENDIF
		GOTO ENDOFSCRIPT
		
		
	ENDOFSCRIPT:
		PRINT(DPD.CHRG.collAmt)
		BANCS.OUTPUT.collAmount = DPD.CHRG.collAmt
		BANCS.OUTPUT.collCrncy = BANCS.INPUT.chrgCollCrncy
		BANCS.OUTPUT.AmountWithNoDiscount = DPD.CHRG.collAmt
		EXITSCRIPT
		
END-->
