			print(CUST.INTERFACE.instrumentDate)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.valueDate))THEN
	#{
		IF(TRIM(BANCS.INPUT.valueDate) != "")THEN
		#{
			CUST.INTERFACE.valueDate = BANCS.INPUT.valueDate
			print(CUST.INTERFACE.valueDate)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.setNum))THEN
	#{
