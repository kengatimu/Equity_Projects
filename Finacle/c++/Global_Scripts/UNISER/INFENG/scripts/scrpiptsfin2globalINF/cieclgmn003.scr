			CUST.INTERFACE.instrumentAmt = BANCS.INPUT.instrumentAmt
			print(CUST.INTERFACE.instrumentAmt)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentAmtCcy))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentAmtCcy) != "")THEN
		#{
			CUST.INTERFACE.instrumentAmtCcy = BANCS.INPUT.instrumentAmtCcy
			print(CUST.INTERFACE.instrumentAmtCcy)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.bankCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.bankCode) != "")THEN
