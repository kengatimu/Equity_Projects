<--START
CHECKSUM="4bd2951bb8bed921975514d0048f9572bc48c6d47f9a20f232c1acf5c9df6b2c"
	TRACE ON
	
	CALL("Common_Interface_CreateRepos.scr")
	
	CUST.INTERFACE.funcCode 	= ""
	CUST.INTERFACE.zoneCode 	= ""
	CUST.INTERFACE.zoneDate 	= ""
	CUST.INTERFACE.solId 		= ""
	CUST.INTERFACE.acctId 		= ""
	CUST.INTERFACE.instrumentAmt 	= ""
	CUST.INTERFACE.instrumentAmtCcy = ""
	CUST.INTERFACE.bankCode 	= ""
	CUST.INTERFACE.branchCode 	= ""
	CUST.INTERFACE.instrumentNum 	= ""
	CUST.INTERFACE.instrumentDate 	= ""
	CUST.INTERFACE.valueDate 	= ""
	CUST.INTERFACE.setNum 		= ""
	CUST.INTERFACE.rejectReasonCode = ""
	CUST.INTERFACE.payingAcct	= ""
	
	CUST.INTERFACE.errorMsg 	= ""
	CUST.INTERFACE.errorCode 	= ""
	CUST.INTERFACE.errorDesc 	= ""
	
	CUST.INTERFACE.tranId		= ""
	CUST.INTERFACE.tranDate		= ""
	CUST.INTERFACE.tranPstFlg	= ""
	
	IF(FIELDEXISTS(BANCS.INPUT.funcCode))THEN
	#{
