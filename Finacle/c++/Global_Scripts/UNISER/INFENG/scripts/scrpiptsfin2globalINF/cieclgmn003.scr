		#{
			CUST.INTERFACE.branchCode = BANCS.INPUT.branchCode
			print(CUST.INTERFACE.branchCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentNum) != "")THEN
		#{
			CUST.INTERFACE.instrumentNum = BANCS.INPUT.instrumentNum
			print(CUST.INTERFACE.instrumentNum)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentDate))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentDate) != "")THEN
		#{
