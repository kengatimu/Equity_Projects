			print(CUST.INTERFACE.payingAcct)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.rejectReasonCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.rejectReasonCode) != "")THEN
		#{
			CUST.INTERFACE.rejectReasonCode = BANCS.INPUT.rejectReasonCode
			print(CUST.INTERFACE.rejectReasonCode)
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.INTERFACE.funcCode)
	PRINT(CUST.INTERFACE.zoneCode)
	PRINT(CUST.INTERFACE.zoneDate)
	PRINT(CUST.INTERFACE.solId)
	PRINT(CUST.INTERFACE.acctId)
	PRINT(CUST.INTERFACE.instrumentAmt)
	PRINT(CUST.INTERFACE.instrumentAmtCcy)
	PRINT(CUST.INTERFACE.bankCode)
	PRINT(CUST.INTERFACE.branchCode)
	PRINT(CUST.INTERFACE.instrumentNum)
	PRINT(CUST.INTERFACE.instrumentDate)
	PRINT(CUST.INTERFACE.valueDate)
	PRINT(CUST.INTERFACE.setNum)
	PRINT(CUST.INTERFACE.payingAcct)
	PRINT(CUST.INTERFACE.rejectReasonCode)
	
	IF(CUST.INTERFACE.funcCode == "V")THEN
	#{
		GOTO LODGE_VERIFY
	#}
	ENDIF
	
	IF(CUST.INTERFACE.funcCode == "R")THEN
	#{
		GOTO RELEASE
	#}
	ENDIF
	
	IF(CUST.INTERFACE.funcCode == "IR")THEN
	#{
		GOTO INWARD_REJECT
	#}
	ENDIF
	
	IF(CUST.INTERFACE.funcCode == "OR")THEN
	#{
		GOTO OUTWARD_REJECT
	#}
	ENDIF
	
	IF(CUST.INTERFACE.funcCode == "G")THEN
	#{
		GOTO REGULARISE
	#}
	ENDIF
	
	###########################################################################################
	# Lodge Instrument
	###########################################################################################
	
	LODGE_VERIFY:
		
		sv_u = urhk_SetUrhkInp("zoneCode|"+CUST.INTERFACE.zoneCode)
		sv_u = urhk_SetUrhkOut("settlementToAcctCrncyRateCode.refCode|sttlToAcctCrncyRateCode")
		sv_u = urhk_ExecSrvNoCommit("SRV_InquireOcZoneTmpl|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		CUST.INTERFACE.sttlToAcctCrncyRateCode = BANCS.OUTPARAM.sttlToAcctCrncyRateCode
		PRINT(CUST.INTERFACE.sttlToAcctCrncyRateCode)
		
		IF(TRIM(CUST.INTERFACE.sttlToAcctCrncyRateCode) == "")THEN
		#{
			CUST.INTERFACE.sttlToAcctCrncyRateCode = "MEAN"
		#}
		ENDIF
		
		CUST.INTERFACE.sttlToAcctCrncyRate = ""
		
		sv_s = "acctCrncyCode|SELECT ACCT_CRNCY_CODE FROM TBAADM.GAM WHERE FORACID = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.acctId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d != 0)THEN
		#{
			CUST.INTERFACE.errorMsg = "Invalid Account Id"
			CUST.INTERFACE.errorCode = "10000"
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		CUST.INTERFACE.crAcctNumCcy = BANCS.OUTPARAM.acctCrncyCode
		PRINT(CUST.INTERFACE.crAcctNumCcy)
		
		BANCS.INPARAM.InputAmount = 1
		BANCS.INPARAM.FromCurrency = CUST.INTERFACE.crAcctNumCcy
		BANCS.INPARAM.ToCurrency = CUST.INTERFACE.instrumentAmtCcy
		BANCS.INPARAM.RateCode = CUST.INTERFACE.sttlToAcctCrncyRateCode
		BANCS.INPARAM.Rate = 0.00
		BANCS.INPARAM.CustId = ""
		sv_u = urhk_B2k_ConvertAmount("")
		print(sv_u)
		
		IF(sv_u == 0)THEN
		#{
			CUST.INTERFACE.sttlToAcctCrncyRate = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			print(CUST.INTERFACE.sttlToAcctCrncyRate)
			#}
		ELSE
			#{
			CUST.INTERFACE.errorMsg = "Could not get rate value for currency pair " + CUST.INTERFACE.crAcctNumCcy + " AND " + CUST.INTERFACE.instrumentAmtCcy
			CUST.INTERFACE.errorCode = "10000"
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		##################################################################################
		# Set SRV Input
		##################################################################################
		
		sv_u = urhk_SetUrhkInp("zoneHeader.zoneCode|"+CUST.INTERFACE.zoneCode)
		sv_s = CUST.INTERFACE.zoneDate + " 00:00:00"
		sv_u = urhk_SetUrhkInp("zoneHeader.zoneDate|"+sv_s)
		sv_u = urhk_SetUrhkInp("zoneHeader.solId.solId|"+CUST.INTERFACE.solId)
		
		sv_u = urhk_SetUrhkInp("zoneHeader.crAcctId.foracid|"+CUST.INTERFACE.acctId)
		sv_u = urhk_SetUrhkInp("zoneHeader.totCrPartTranAmt|"+CUST.INTERFACE.instrumentAmt + "|" + CUST.INTERFACE.instrumentAmtCcy)
		sv_u = urhk_SetUrhkInp("zoneHeader.totInstrmntAmt|"+CUST.INTERFACE.instrumentAmt + "|" + CUST.INTERFACE.instrumentAmtCcy)
		
		sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.key.serial_num|1")
		sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.ptranAcctId.foracid|"+CUST.INTERFACE.acctId)
		#sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.tranAmt|"+CUST.INTERFACE.instrumentAmt + "|" + CUST.INTERFACE.instrumentAmtCcy)
		sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.partTranAmtInInstCrncy|"+CUST.INTERFACE.instrumentAmt + "|" + CUST.INTERFACE.instrumentAmtCcy)
		
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.key.serial_num|1")
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.bankBranchCode.bankCode|"+CUST.INTERFACE.bankCode)
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.bankBranchCode.brCode|"+CUST.INTERFACE.branchCode)
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.instrmntId|"+CUST.INTERFACE.instrumentNum)
		sv_s = CUST.INTERFACE.instrumentDate + " 00:00:00"
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.instrmntDate|"+sv_s)
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.instrmntAmt|"+CUST.INTERFACE.instrumentAmt + "|" + CUST.INTERFACE.instrumentAmtCcy)
		sv_s = CUST.INTERFACE.valueDate + " 00:00:00"
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.valueDate|"+sv_s)
		sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.payingAcctId|"+CUST.INTERFACE.payingAcct)
		
		sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.sttlToAcctCrncyRateCode.refCode|"+CUST.INTERFACE.sttlToAcctCrncyRateCode)
		sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.sttlToAcctCrncyRate|"+CUST.INTERFACE.sttlToAcctCrncyRate)
		
		sv_u = urhk_SetUrhkOut("setInfo.setNum|setNum")
		
		sv_u = urhk_ExecSrvNoCommit("SRV_LodgeOcSetAndVerify|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		print(BANCS.OUTPARAM.setNum)
		CUST.INTERFACE.setNum = BANCS.OUTPARAM.setNum
		
		GOTO ENDOFFISCRIPT
		
		##################################################################################
		# Release OC Set
		##################################################################################
		
	RELEASE:
		
		sv_u = urhk_SetUrhkInp("zoneHeader.zoneCode|"+CUST.INTERFACE.zoneCode)
		sv_s = CUST.INTERFACE.zoneDate + " 00:00:00"
		sv_u = urhk_SetUrhkInp("zoneHeader.zoneDate|"+sv_s)
		sv_u = urhk_SetUrhkInp("zoneHeader.solId.solId|"+BANCS.STDIN.mySolId)
		sv_u = urhk_SetUrhkInp("setInfo.setNum|"+CUST.INTERFACE.setNum)
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchOcSetForRelReg|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		##################################################################################
		# Copy Out To In With Diff Struct
		##################################################################################
		
		BANCS.INPARAM.SourceStr= ""
		BANCS.INPARAM.ReplaceStr= "ocSet"
		
		sv_u = urhk_CopyOutToInDiffStruct("")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		sv_u = urhk_SetUrhkOut("tranObject.tranIdentifier.tranId|tranId")
		sv_u = urhk_SetUrhkOut("tranObject.tranIdentifier.tranDate|tranDate")
		sv_u = urhk_SetUrhkOut("tranObject.pstFlg|tranPstFlg")
		sv_u = urhk_ExecSrvNoCommit("SRV_ReleaseOcSet|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		CUST.INTERFACE.tranId = BANCS.OUTPARAM.tranId
		PRINT(CUST.INTERFACE.tranId)
		CUST.INTERFACE.tranDate = BANCS.OUTPARAM.tranDate
		PRINT(CUST.INTERFACE.tranDate)
		CUST.INTERFACE.tranPstFlg = BANCS.OUTPARAM.tranPstFlg
		PRINT(CUST.INTERFACE.tranPstFlg)
		
		##################################################################################
		# Fetch Tran Details for Posting
		##################################################################################
		
		sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranId|" + CUST.INTERFACE.tranId)
		sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + CUST.INTERFACE.tranDate)
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchTranDtlsForPost|retain_all_output = Y")
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		##################################################################################
		# Post Tran
		##################################################################################
		
		sv_u = urhk_SetUrhkOut("tranHdr.status|status")
		sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y|call_mode = N")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		GOTO ENDOFFISCRIPT
		
		##################################################################################
		# Outward Reject
		##################################################################################
		
	OUTWARD_REJECT:
		
		CUST.INTERFACE.iZoneCode = ""
		CUST.INTERFACE.iZoneDate = MID$(BANCS.STDIN.BODDate,0,10)
		
		CUST.INTERFACE.parameterId = "CL_OUTREJ_INW_ZONE_CODE_" + BANCS.STDIN.contextBankId
		print(CUST.INTERFACE.parameterId)
		sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.INTERFACE.errorMsg = "Inward Clearing Zone Code not set in CPARAM for marking Outward Reject"
			CUST.INTERFACE.errorCode = "10000"
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		CUST.INTERFACE.parameterValue = BANCS.OUTPARAM.parameterValue
		PRINT(CUST.INTERFACE.parameterValue)
		
		CUST.INTERFACE.iZoneCode = CUST.INTERFACE.parameterValue
		PRINT(CUST.INTERFACE.iZoneCode)
		
		IF(TRIM(CUST.INTERFACE.iZoneCode) == "")THEN
		#{
			CUST.INTERFACE.errorMsg = "Inward Clearing Zone Code not set in CPARAM for marking Outward Reject"
			CUST.INTERFACE.errorCode = "10000"
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		sv_u = urhk_SetUrhkInp("zoneDtl.zone.zoneCode|"+CUST.INTERFACE.iZoneCode)
		sv_s = CUST.INTERFACE.iZoneDate + " 00:00:00"
		sv_u = urhk_SetUrhkInp("zoneDtl.zoneDate|"+sv_s)
		sv_u = urhk_SetUrhkInp("zoneDtl.sol.solId|"+BANCS.STDIN.mySolId)
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltIcTranDtl|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		
		sv_u = urhk_SetUrhkInp("instrmntDtl.acct.foracid|"+CUST.INTERFACE.acctId)
		sv_u = urhk_SetUrhkInp("instrmntDtl.instrmntNum|"+CUST.INTERFACE.instrumentNum)
		sv_u = urhk_SetUrhkInp("instrmntDtl.instrmntAmt|"+CUST.INTERFACE.instrumentAmt+"|"+CUST.INTERFACE.instrumentAmtCcy)
		sv_u = urhk_SetUrhkInp("instrmntDtl.rejType.code|O")
		sv_u = urhk_SetUrhkInp("instrmntRejDtl.rejType.code|O")
		sv_u = urhk_SetUrhkInp("instrmntRejDtl.rejCode1.rejectCode|"+CUST.INTERFACE.rejectReasonCode)
		sv_u = urhk_SetUrhkInp("instrmntDtl.carveFlg|N")
		#sv_u = urhk_SetUrhkInp("instrmntDtl.presSortCode|"+CUST.INTERFACE.presentingSortCode)
		sv_u = urhk_SetUrhkInp("instrmntDtl.presBr.bankCode|"+CUST.INTERFACE.bankCode)
		sv_u = urhk_SetUrhkInp("instrmntDtl.presBr.brCode|"+CUST.INTERFACE.branchCode)
		
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltOutRejDtl|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		
		sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZone.zoneCode|"+CUST.INTERFACE.zoneCode)
		sv_s = CUST.INTERFACE.zoneDate + " 00:00:00"
		sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneDate|"+sv_s)
		sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSol.solId|"+CUST.INTERFACE.solId)
		sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSetNum|"+CUST.INTERFACE.setNum)
		sv_u = urhk_SetUrhkInp("instrmntRejDtl.outRejInstrmntSrlNum|1")
		sv_u = urhk_ExecSrvNoCommit("SRV_AddIcTranDtlAndVerify|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			IF(CINT(BANCS.OUTPARAM.Error_num) > 0) THEN
			#{
				CUST.INTERFACE.errorMsg = ("BANCS").("OUTPARAM").("ErrorMesg_" + FORMAT$(1,"%d"))
				CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + FORMAT$(1,"%d"))
				print(("BANCS").("OUTPARAM").("Tag_" + FORMAT$(1,"%d")))
			#}
			ENDIF
			GOTO ENDOFFISCRIPT
		#}
		ENDIF
		
		GOTO ENDOFFISCRIPT
		
		##################################################################################
		
	ENDOFFISCRIPT:
		print(CUST.INTERFACE.setNum)
		print(CUST.INTERFACE.tranId)
		CUST.INTERFACE.tranDate = MID$(CUST.INTERFACE.tranDate,0,10)
		print(CUST.INTERFACE.tranDate)
		print(CUST.INTERFACE.errorCode)
		print(CUST.INTERFACE.errorMsg)
		
		IF(CUST.INTERFACE.errorCode != "") THEN
		#{
			sv_c = CUST.INTERFACE.errorCode + "-" + CUST.INTERFACE.errorMsg
			sv_u = urhk_SetOrbErr(sv_c)
			print(sv_u)
			#}
		ELSE
			#{
			sv_c = "setNum| " + CUST.INTERFACE.setNum
			sv_u = urhk_SetOrbOut(sv_c)
			print(sv_u)
			
			sv_c = "tranId| " + CUST.INTERFACE.tranId
			sv_u = urhk_SetOrbOut(sv_c)
			print(sv_u)
			
			sv_c = "tranDate| " + CUST.INTERFACE.tranDate
			sv_u = urhk_SetOrbOut(sv_c)
			print(sv_u)
		#}
		ENDIF
		
		#trace off
END-->
