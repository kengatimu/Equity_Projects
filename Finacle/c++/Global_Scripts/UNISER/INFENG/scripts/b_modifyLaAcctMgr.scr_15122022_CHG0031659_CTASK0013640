<--START
CHECKSUM="376a4842becc2f38aa040510b5fc803910a8cf19fa388eb59b9aa57ccdfb1121"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","ACMLA") == 0) THEN
	#{
		CREATECLASS("CUSTS","ACMLA",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","ACMLA") == 0) THEN
	#{
		CREATECLASS("CUSTS","ACMLA", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.ACMLA.errMsg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
