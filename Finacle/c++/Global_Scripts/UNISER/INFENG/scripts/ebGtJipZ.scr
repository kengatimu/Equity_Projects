#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Name                   : ebGtJipZ.scr 
#   Date                   : 19-Jul-2019
#   Description            :
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#reps
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(repexists("EQSURE")==0)then
                createrep("EQSURE")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        if(classexists("EQSURE","GLBDATA")==0)then
                createclass("EQSURE","GLBDATA",5)
        endif

	if(fieldexists(BANCS.INPUT.jipangeAcct)==1)then
		EQSRV.GLBDATA.jipGoalAcct = BANCS.INPUT.jipangeAcct
	else
		EQSRV.GLBDATA.jipGoalAcct = ""
	endif
	##if(fieldexists(BANCS.INPUT.SourceAcct)==1)then
	##	EQSRV.GLBDATA.SourceAcct = BANCS.INPUT.SourceAcct
	##else
	##	EQSRV.GLBDATA.SourceAcct = ""
	##endif
	EQSRV.GLBDATA.srvSF = ""
	EQSRV.GLBDATA.tranId = ""
	EQSRV.GLBDATA.tranDate = ""
	EQSRV.GLBDATA.batchYN = ""
	EQSRV.GLBDATA.valerr = ""
	EQSRV.GLBDATA.scrValYN = ""
	EQSRV.GLBDATA.SourceAcct = ""
	if(fieldexists(EQSRV.GLBDATA.closeMode)==1)then
		EQSRV.GLBDATA.batchYN = "N"	
	else
		EQSRV.GLBDATA.batchYN = "Y"
	endif
	if(EQSRV.GLBDATA.batchYN!="Y")then
		sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.jipGoalAcct)
		if(sv_u ==0)then
			EQSRV.GLBDATA.glSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
			EQSRV.GLBDATA.solId     =       BANCS.OUTPARAM.acctSolId
			EQSRV.GLBDATA.schmType  =       BANCS.OUTPARAM.schmType
			EQSRV.GLBDATA.schmCode  =       BANCS.OUTPARAM.schmCode
			EQSRV.GLBDATA.crncyCode =       BANCS.OUTPARAM.acctCrncyCode
			EQSRV.GLBDATA.acctClsFlg        =       BANCS.OUTPARAM.acctCloseflg
			EQSRV.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
			EQSRV.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt
			EQSRV.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
			EQSRV.GLBDATA.goalCrncy = BANCS.OUTPARAM.acctCrncyCode
		endif
		if((EQSRV.GLBDATA.acctClsFlg!= "N" ) and (EQSRV.GLBDATA.acctClsFlg!=""))then
			EQSRV.GLBDATA.valerr    =    "Account has been closed already " + EQSRV.GLBDATA.jipGoalAcct 
			EQSRV.GLBDATA.scrValYN     = "N"
			goto VAYU
		endif
	endif
	if(EQSRV.GLBDATA.batchYN=="Y")then
		sv_u = urhk_MTTS_PopulateInputDetails("")
		print(sv_u)
		if(sv_u == 0)then
			print(MTT.InputDetails.Argument1)
			sv_l = strlen(MTT.InputDetails.Argument1)
			sv_f = mid$(MTT.InputDetails.Argument1,0,sv_l)
			sv_l = strlen(MTT.InputDetails.Argument1)
			sv_p = getposition(sv_f,"|")
			EQSRV.GLBDATA.jipGoalAcct   = mid$(sv_f,0,(sv_p-1))
			EQSRV.GLBDATA.ExpiryDate = mid$(sv_f,sv_p,sv_l)
			print(EQSRV.GLBDATA.jipGoalAcct)
			print(EQSRV.GLBDATA.ExpiryDate)
			sv_u = urhk_B2k_valDate(EQSRV.GLBDATA.ExpiryDate)
			if(sv_u!=0)then
				print("goal expiry date not found")	
				goto VAYU
			endif
			BANCS.INPARAM.date1 = EQSRV.GLBDATA.ExpiryDate 
			BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
			sv_a = urhk_B2k_dateDiff("")
			if(sv_a==0)then
				print(BANCS.OUTPARAM.dateDiff)
				EQSRV.GLBDATA.datediff = BANCS.OUTPARAM.dateDiff
			else
				EQSRV.GLBDATA.datediff = ""
			endif
			if(cint(EQSRV.GLBDATA.datediff) <= 0)then
				EQSRV.GLBDATA.batchYN = "Y"
			else
				EQSRV.GLBDATA.batchYN = "N"
				goto VAYU
			endif

		else
			sv_u = urhk_MTTS_Close("")
			print(sv_u)
			goto VAYU
		endif
	endif
#GoalData
	sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.jipGoalAcct)
	if(sv_u==0)then
		EQSRV.GLBDATA.acctCloseDate = BANCS.OUTPARAM.acctCloseDate
		EQSRV.GLBDATA.acctSolId = BANCS.OUTPARAM.acctSolId
		EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		EQSRV.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
		EQSRV.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt
		EQSRV.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
		EQSRV.GLBDATA.goalCrncy = BANCS.OUTPARAM.acctCrncyCode
		sv_u = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.jipGoalAcct)
		if(sv_u==0)then
			EQSRV.GLBDATA.goalacid = BANCS.OUTPARAM.Acid
		else
			EQSRV.GLBDATA.valerr    = "Invalid Goal Account " + EQSRV.GLBDATA.jipGoalAcct 
			EQSRV.GLBDATA.scrValYN     = "N"
			goto VAYU
		endif
	endif
	sv_u = urhk_getAdvanceDetailsForAccount(EQSRV.GLBDATA.jipGoalAcct)
	if(sv_u==0)then
		EQSRV.GLBDATA.gSourceAcct = BANCS.OUTPARAM.gacFreeText1
		print (EQSRV.GLBDATA.gSourceAcct)
		EQSRV.GLBDATA.gGoalMonths = BANCS.OUTPARAM.gacFreeText2	
		EQSRV.GLBDATA.gGoalDays = BANCS.OUTPARAM.gacFreeText3	
		EQSRV.GLBDATA.gPayoutDays = BANCS.OUTPARAM.gacFreeText4	
		EQSRV.GLBDATA.gExpiryDate = BANCS.OUTPARAM.gacFreeText5	
		EQSRV.GLBDATA.gAprYN = BANCS.OUTPARAM.gacFreeText7	
		EQSRV.GLBDATA.gOctYN = BANCS.OUTPARAM.gacFreeText8	
		if(EQSRV.GLBDATA.gSourceAcct != "")then
			sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.gSourceAcct)
			if(sv_u!=0)then
				EQSRV.GLBDATA.valerr    = "Invalid SOurce Account for Goal " + EQSRV.GLBDATA.jipGoalAcct
				EQSRV.GLBDATA.scrValYN     = "N"
				goto VAYU
			endif
		endif
	else
                EQSRV.GLBDATA.valerr    = "Invalid Goal Account " + EQSRV.GLBDATA.jipGoalAcct 
                EQSRV.GLBDATA.scrValYN     = "N"
                goto VAYU
	endif
	if(EQSRV.GLBDATA.batchYN!="Y")then
		if(EQSRV.GLBDATA.gSourceAcct != "")then
			sv_u = urhk_getAdvanceDetailsForAccount(EQSRV.GLBDATA.gSourceAcct)
			if(sv_u!=0)then
				EQSRV.GLBDATA.valerr    = "Invalid SOurce Account for Goal,Modify the SOurce Account then Close " + EQSRV.GLBDATA.jipGoalAcct 
				EQSRV.GLBDATA.scrValYN     = "N"
				goto VAYU
			else
				sv_d = "sourceAcct | select foracid from tbaadm.gam where bank_id=?SVAR "
				sv_d = sv_d + " and del_flg='N' and entity_cre_flg='Y' and acct_cls_flg<>'Y' "
				sv_d = sv_d + " and cif_id in (select cif_id from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR )"
				sv_d = sv_d + " and acct_ownership<>'O' and schm_type not in ('LAA','CLA','PCA','FBA')" 
				sv_d = sv_d + " and rownum<=1 "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+EQSRV.GLBDATA.jipGoalAcct+"|"+BANCS.STDIN.contextBankId
				print(sv_d)
				print(BANCS.INPARAM.BINDVARS)
				sv_u = urhk_dbSelectWithBind(sv_d)
				if(sv_u==0)then
					EQSRV.GLBDATA.gSourceAcct = BANCS.OUTPARAM.sourceAcct
				else
					EQSRV.GLBDATA.gSourceAcct = ""
				endif
			endif
		endif
		if(EQSRV.GLBDATA.gSourceAcct =="")then
			EQSRV.GLBDATA.valerr    = "Invalid SOurce Account in tag SourceAcct " + EQSRV.GLBDATA.jipGoalAcct 
			EQSRV.GLBDATA.scrValYN     = "N"
			goto VAYU
		endif
		###EQSRV.GLBDATA.gSourceAcct = EQSRV.GLBDATA.SourceAcct
	endif
	if(EQSRV.GLBDATA.gSourceAcct != "")then
		sv_u = urhk_getAdvanceDetailsForAccount(EQSRV.GLBDATA.jipGoalAcct)
		if(sv_u!=0)then
			EQSRV.GLBDATA.valerr    = "Invalid SOurce Account for Goal,Modify the SOurce Account then Close " + EQSRV.GLBDATA.jipGoalAcct 
			EQSRV.GLBDATA.scrValYN     = "N"
			goto VAYU
		endif
	else
		EQSRV.GLBDATA.valerr    = "Invalid SOurce Account for Goal,Modify the SOurce Account then Close " + EQSRV.GLBDATA.jipGoalAcct 
		EQSRV.GLBDATA.scrValYN     = "N"
		goto VAYU
	endif
#ContextSol
        print(BANCS.STDIN.mySolId)
        print(EQSRV.GLBDATA.acctSolId)
        if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.acctSolId ) then
                sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.acctSolId)
                sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
                if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                        print(BANCS.OUTPARAM.successOrFailure)
                        sv_s = BANCS.OUTPARAM.successOrFailure
                else
                        sv_s = "X"
                endif
                if (( sv_u != 0 ) and ( sv_s != "S"))then
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr    =       "CCS Failed"
                        goto VAYU
                endif
        endif
#closUreTran
	if((cdouble(EQSRV.GLBDATA.clearBalance)>=1) and (EQSRV.GLBDATA.gSourceAcct != "") and (EQSRV.GLBDATA.jipGoalAcct!=""))then
		callscriptifexist("ebGtJipTran.scr")
		print(EQSRV.GLBDATA.srvSF)
		print(EQSRV.GLBDATA.tranId)
		print(EQSRV.GLBDATA.tranDate)
	endif
#Srv
	sv_i= urhk_SetUrhkInp("acctBasic.foracid|" + EQSRV.GLBDATA.jipGoalAcct ) 
	sv_i= urhk_SetUrhkInp("acctBasic.solId.solId|" + EQSRV.GLBDATA.acctSolId ) 
	sv_i= urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
	sv_i= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + EQSRV.GLBDATA.gSourceAcct )
	sv_i= urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")
	##if(cdouble(EQSRV.GLBDATA.clearBalance)>0)then
		##sv_i= urhk_SetUrhkInp("clsrProcCrit.xferAmt|" +EQSRV.GLBDATA.clearBalance+ "|" + EQSRV.GLBDATA.goalCrncy)
	##endif
	sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refCode|CLSCH")
	sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refRecType|10")
	sv_u = urhk_ExecSrv("SRV_FetchOperAcctDtlForClosure|retain_all_output = Y")
	print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
		print("fetch success")
        else
                callscriptifexist("ebsrvHandler.scr")
                EQSRV.GLBDATA.valerr    =       EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.scrValYN     = "N"
                goto VAYU
	endif
	sv_u = urhk_CopyOutToIn("")
	print(sv_u)
	sv_i = urhk_SetUrhkInp("acctBasic.foracid|" + EQSRV.GLBDATA.jipGoalAcct ) 
	sv_i = urhk_SetUrhkInp("acctBasic.acid|" + EQSRV.GLBDATA.goalacid ) 
	sv_i = urhk_SetUrhkInp("acctBasic.schmCode.schmCode|" + EQSRV.GLBDATA.schmCode ) 
	sv_i = urhk_SetUrhkInp("acctBasic.solId.solId|" + EQSRV.GLBDATA.acctSolId ) 
	sv_i = urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
	sv_i= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + EQSRV.GLBDATA.gSourceAcct )
	sv_i = urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")
	sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refCode|CLSCH")
	sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refRecType|10")
	sv_u = urhk_ExecSrvNoCommit("SRV_CloseOperAcct|retain_all_output = Y|same_user_verify = Y")
	print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
		EQSRV.GLBDATA.valerr = "CLOSED" 	
                EQSRV.GLBDATA.scrValYN     = "Y"
        else
                callscriptifexist("ebsrvHandler.scr")
                EQSRV.GLBDATA.valerr    =       EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.scrValYN     = "N"
                goto VAYU
	endif
	if((EQSRV.GLBDATA.scrValYN =="Y") and (EQSRV.GLBDATA.valerr=="CLOSED"))then
		sv_i= urhk_SetUrhkInp("acctBasic.foracid|" + EQSRV.GLBDATA.jipGoalAcct ) 
		sv_i = urhk_SetUrhkInp("acctBasic.solId.solId|" + EQSRV.GLBDATA.acctSolId ) 
		sv_i= urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
		sv_i= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + EQSRV.GLBDATA.gSourceAcct )
		sv_i= urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")
		sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refCode|CLSCH")
		sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refRecType|10")
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchOperAcctClsrDtlForVerify|retain_all_output = Y|same_user_verify = Y")
		print(sv_u)
		if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
			print(BANCS.OUTPARAM.successOrFailure)
			sv_s = BANCS.OUTPARAM.successOrFailure
		else
			sv_s = "X"
		endif
		if (( sv_u == 0 ) and ( sv_s=="S") ) then
			print("fetch success")
		else
			callscriptifexist("ebsrvHandler.scr")
			EQSRV.GLBDATA.valerr    =       EQSRV.GLBDATA.SrvError
			EQSRV.GLBDATA.scrValYN     = "N"
			goto VAYU
		endif
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		sv_i = urhk_SetUrhkInp("acctBasic.foracid|" + EQSRV.GLBDATA.jipGoalAcct ) 
		sv_i = urhk_SetUrhkInp("acctBasic.acid|" + EQSRV.GLBDATA.goalacid ) 
		sv_i = urhk_SetUrhkInp("acctBasic.schmCode.schmCode|" + EQSRV.GLBDATA.schmCode ) 
		sv_i = urhk_SetUrhkInp("acctBasic.solId.solId|" + EQSRV.GLBDATA.acctSolId ) 
		sv_i = urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
		sv_i= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + EQSRV.GLBDATA.gSourceAcct )
		sv_i = urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")
		sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refCode|CLSCH")
		sv_i= urhk_SetUrhkInp("clsrProcCrit.rptCode.refRecType|10")
		sv_u = urhk_ExecSrvNoCommit("SRV_VerifyOperAcctClsrDtl|retain_all_output = Y|same_user_verify = Y")
		print(sv_u)
		if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
			print(BANCS.OUTPARAM.successOrFailure)
			sv_s = BANCS.OUTPARAM.successOrFailure
		else
			sv_s = "X"
		endif
		if (( sv_u == 0 ) and ( sv_s=="S") ) then
			EQSRV.GLBDATA.valerr = "CLOSED" 	
			EQSRV.GLBDATA.scrValYN     = "Y"
		else
			callscriptifexist("ebsrvHandler.scr")
			EQSRV.GLBDATA.valerr    =       EQSRV.GLBDATA.SrvError
			EQSRV.GLBDATA.scrValYN     = "N"
			goto VAYU
		endif
	endif
VAYU:
	print(EQSRV.GLBDATA.scrValYN)	
	print(EQSRV.GLBDATA.valerr)
	exitscript
trace off
end-->
