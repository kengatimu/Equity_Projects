								PRINT(BANCS.OUTPUT.TranParticular2)
								BANCS.OUTPUT.TranRmks =  sv_n + " " + CUST.GETDATADRC.htmcreditaccD
								print(BANCS.OUTPUT.TranRmks)
							ENDIF
						#}
						ELSE
						#{
							IF (FIELDEXISTS(BANCS.INPUT.TranParticular) == 1) THEN
							#{
								BANCS.OUTPUT.TranParticular = BANCS.INPUT.TranParticular
								PRINT(BANCS.OUTPUT.TranParticular)
							#}
							ENDIF
							BANCS.OUTPUT.TranParticular = "Transfert au sein de Equity, De"
							
							IF (BANCS.INPUT.TranSubType == "CI") THEN
								BANCS.OUTPUT.TranParticular = "Virement Interne, "
							ENDIF
							
							PRINT(BANCS.OUTPUT.TranParticular)
							sv_n = " vers "
							print(sv_n)
							IF ((FIELDEXISTS(CUST.GETDATADRC.htmdebitaccD) == 1) AND (FIELDEXISTS(CUST.GETDATADRC.htmcreditaccD) == 1)) THEN 
								BANCS.OUTPUT.TranParticular2 = BANCS.OUTPUT.TranParticular + " " + CUST.GETDATADRC.htmdebitaccD 
								PRINT(BANCS.OUTPUT.TranParticular2)
								BANCS.OUTPUT.TranRmks =  sv_n + " " + CUST.GETDATADRC.htmcreditaccD
								print(BANCS.OUTPUT.TranRmks)
							ENDIF
						#}
						ENDIF
						##### end transfer
						
						IF (BANCS.INPUT.TranSubType == "NP") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Retrait en cash"
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular = BANCS.OUTPUT.TranParticular +"/"+ BANCS.INPUT.TranParticular
							PRINT(BANCS.OUTPUT.TranParticular)
							IF (FIELDEXISTS(BANCS.INPUT.TranParticular) == 1) THEN
							#{
								BANCS.OUTPUT.TranParticular2 = BANCS.INPUT.TranParticular
								PRINT(BANCS.OUTPUT.TranParticular2)
							#}
							ENDIF
						#}
						ENDIF
						
						IF (BANCS.INPUT.TranSubType == "NR") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Depot en cash"
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular = BANCS.OUTPUT.TranParticular +"/"+ BANCS.INPUT.TranParticular
							PRINT(BANCS.OUTPUT.TranParticular)
							IF (FIELDEXISTS(BANCS.INPUT.TranParticular) == 1) THEN
							#{
								BANCS.OUTPUT.TranParticular2 = BANCS.INPUT.TranParticular
								PRINT(BANCS.OUTPUT.TranParticular2)
							#}
							ENDIF
						#}
						ENDIF
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		IF (BANCS.STDIN.menuId == "HCDEP") THEN
		#{
			IF (BANCS.INPUT.TranSubType == "CR") THEN
			#{
				BANCS.OUTPUT.TranParticular = "Cash Deposit from " + BANCS.STDIN.mySolDesc
				PRINT(BANCS.OUTPUT.TranParticular)
			#}
			ENDIF
		#}
		ENDIF
		IF (BANCS.STDIN.menuId == "HBPAD") THEN
		#{
			IF (BANCS.STDIN.funcName != "SRV_CancelPayment") THEN
			#{
				IF (FIELDEXISTS(CUST.BILL.lateFeeAmt) == 1) THEN
				#{
					IF (CUST.BILL.billDateDiff > 0) THEN
					#{
						IF (CUST.BILL.billDusDateDiff > 0) THEN
						#{
							BANCS.OUTPUT.TranRmks = "Late Payment Fee:" + CUST.BILL.lateFeeAmt
							print(BANCS.OUTPUT.TranRmks)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	IF (BANCS.STDIN.contextBankId=="43") THEN
		IF (FIELDEXISTS(BANCS.INPUT.TranSubType) == 1) THEN
			IF (BANCS.INPUT.TranSubType=="SI") THEN
				IF (BANCS.INPUT.PartTranType=="C") THEN
					sv_d = ""
					print(sv_d)
					sv_c = ""
					print(sv_c)
				ELSE
					IF (FIELDEXISTS(sv_d) == 1) THEN
						print(sv_d)
					ELSE
						sv_d =""
						print(sv_d)
					ENDIF
					IF (FIELDEXISTS(sv_c) == 1) THEN
						print(sv_c)
					ELSE
						sv_c =""
						print(sv_c)
					ENDIF
				ENDIF
				sv_g = "Virement permanent, De "
				print(sv_g)
				sv_k = " vers "
				print(sv_k)
				IF (FIELDEXISTS(BANCS.INPUT.PartTranType) == 1) THEN
					IF (BANCS.INPUT.PartTranType=="C") THEN
						sv_d = BANCS.INPUT.uAccount
						print(sv_d)
						CUST.GETDATADRC.sidebitaccC = sv_d
						print(CUST.GETDATADRC.sidebitaccC)
						sv_c = BANCS.INPUT.Foracid
						print(sv_c)
						CUST.GETDATADRC.sicreditaccC = sv_c
						print(CUST.GETDATADRC.sicreditaccC)
					ENDIF
					print(BANCS.INPUT.TranParticular)
					print(BANCS.INPUT.TranParticular2)
					print(BANCS.INPUT.TranCrncyCode)
					IF (BANCS.INPUT.PartTranType=="C") THEN
						BANCS.OUTPUT.TranParticular = sv_g + sv_d 
						print(BANCS.OUTPUT.TranParticular)
						BANCS.OUTPUT.TranParticular2 = sv_k + sv_c + "/" + BANCS.INPUT.TranParticular 
						print(BANCS.OUTPUT.TranParticular2)
					ELSE
						IF ((FIELDEXISTS(CUST.GETDATADRC.sidebitaccC) == 1) AND (FIELDEXISTS(CUST.GETDATADRC.sicreditaccC) == 1)) THEN
							BANCS.OUTPUT.TranParticular = sv_g + CUST.GETDATADRC.sidebitaccC 
							print(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular2 = sv_k + CUST.GETDATADRC.sicreditaccC + "/" + BANCS.INPUT.TranParticular 
							print(BANCS.OUTPUT.TranParticular2)
						ENDIF
					ENDIF
						IF (FIELDEXISTS(BANCS.OUTPUT.TranParticular) == 1) THEN
							BANCS.OUTPUT.TranParticular = MID$(BANCS.OUTPUT.TranParticular,0,50)
							print(BANCS.OUTPUT.TranParticular)
						ENDIF
						IF (FIELDEXISTS(BANCS.OUTPUT.TranParticular2) == 1) THEN
							BANCS.OUTPUT.TranParticular2 = MID$(BANCS.OUTPUT.TranParticular2,0,50)
							print(BANCS.OUTPUT.TranParticular2)
						ENDIF
						####
						IF ((FIELDEXISTS(BANCS.OUTPUT.TranParticular) == 1) AND (BANCS.INPUT.PartTranType=="D")) THEN
							print(BANCS.OUTPUT.TranParticular)
							######
							sv_h = mid$(BANCS.STDIN.BODDate,0,10)
							sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
							BANCS.INPARAM.BINDVARS =  sv_h
							sv_d = urhk_dbSelectWithBind(sv_s)
							##print(sv_d)
							IF (sv_d =="0") THEN
								CUST.GETDATADRC.getboddate = BANCS.OUTPARAM.getboddate
								print(CUST.GETDATADRC.getboddate)
							ENDIF
							sv_s = "countsis|select count(1) from  TBAADM.DTD WHERE TRAN_ID = LPAD(?SVAR,9)"
							sv_s = sv_s + " AND TRAN_DATE = ?SVAR "
							sv_s = sv_s + " AND BANK_ID = ?SVAR "
							print(sv_s)
							BANCS.INPARAM.BINDVARS = BANCS.INPUT.TranId + "|" + CUST.GETDATADRC.getboddate
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_w = urhk_dbSelectWithBind(sv_s)
							print(sv_w)
							IF(sv_w == 0)THEN
								print(BANCS.OUTPARAM.countsis)
								IF (BANCS.OUTPARAM.countsis!="0") THEN
							######
									CUST.GETDATADRC.SISrlNum = ""
									IF (FIELDEXISTS(BANCS.INPUT.SISrlNum) == 1) THEN
										CUST.GETDATADRC.SISrlNum = BANCS.INPUT.SISrlNum
										print(CUST.GETDATADRC.SISrlNum)
									ELSE
										CUST.GETDATADRC.SISrlNum = ""
										print(CUST.GETDATADRC.SISrlNum)
									ENDIF
									sv_s = "UPDATE TBAADM.DTD SET TRAN_PARTICULAR = ?SVAR, TRAN_RMKS = ?SVAR WHERE TRAN_ID = LPAD(?SVAR,9)"
									sv_s = sv_s + " AND TRAN_DATE = ?SVAR "
									sv_s = sv_s + " AND BANK_ID = ?SVAR "
									print(sv_s)
									BANCS.INPARAM.BINDVARS = BANCS.OUTPUT.TranParticular + "|" + CUST.GETDATADRC.SISrlNum + "|" + BANCS.INPUT.TranId + "|" + CUST.GETDATADRC.getboddate
									BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
									print(BANCS.INPARAM.BINDVARS)
									sv_w = urhk_dbSQLWithBind(sv_s)
									print(sv_w)
									IF(sv_w != 0)THEN
										sv_w = urhk_dbSQLWithBind(sv_s)
										print(sv_w)
											IF(sv_w != 0)THEN
												sv_w = urhk_dbSQLWithBind(sv_s)
												print(sv_w)
													IF(sv_w != 0)THEN
														sv_w = urhk_dbSQLWithBind(sv_s)
														print(sv_w)
													ENDIF
											ENDIF
									ENDIF
										#sv_w = urhk_dbSQLWithBind("COMMIT")
										#print(sv_w)
										#IF(sv_w != 0)THEN
										#{
											#sv_d = urhk_dbSqlWithBind("COMMIT")
											#print(sv_d)
										#}
										#ENDIF
								ENDIF
							ENDIF
						ENDIF
						####
					##GOTO EODOFSCRIPT
				ENDIF
			ENDIF
		ENDIF
	ENDIF

EODOFSCRIPT:

if (BANCS.INPUT.TranSubType=="CI") then
	sv_x = "0"
	sv_y = "0"
	IF (BANCS.INPUT.TranParticular!="") THEN
		print(BANCS.INPUT.TranParticular)
