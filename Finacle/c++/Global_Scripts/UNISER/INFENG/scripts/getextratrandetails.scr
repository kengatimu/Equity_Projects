			PRINT(BANCS.OUTPUT.RefNum)
			BANCS.OUTPUT.TranRmks = ""
			PRINT(BANCS.OUTPUT.TranRmks)
		#}
		ENDIF
	ENDIF
	sv_x = "0"
	sv_y = "0"
	IF (BANCS.INPUT.TranParticular!="") THEN
		print(BANCS.INPUT.TranParticular)
		sv_x = GETPOSITION(BANCS.INPUT.TranParticular,"FRAIS SUR RETRAIT EN CASH")
		print(sv_x)
		IF (sv_x >0)THEN
		#{
			BANCS.OUTPUT.TranParticular2 = ""
			print(BANCS.OUTPUT.TranParticular2)
			BANCS.OUTPUT.RefNum = ""
			PRINT(BANCS.OUTPUT.RefNum)
			BANCS.OUTPUT.TranRmks = ""
			PRINT(BANCS.OUTPUT.TranRmks)
		#}
		ENDIF
	ENDIF
endif
if ((BANCS.INPUT.TranSubType=="NP") OR (BANCS.INPUT.TranSubType=="NR")) then
	BANCS.OUTPUT.TranParticular2 = ""
	print(BANCS.OUTPUT.TranParticular2)
	BANCS.OUTPUT.RefNum = ""
	PRINT(BANCS.OUTPUT.RefNum)
	BANCS.OUTPUT.TranRmks = ""
	PRINT(BANCS.OUTPUT.TranRmks)
endif
	EXITSCRIPT
