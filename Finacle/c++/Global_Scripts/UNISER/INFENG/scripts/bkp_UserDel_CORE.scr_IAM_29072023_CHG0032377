<--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
	####################################################################
	# CORE ADD
	####################################################################
	
	CALL("FCUserDel_Req.scr")
	CALL("finacleUserAdd_urhk.scr")
	call("FCUserDel_Res.scr")
	IF(CUST.INTERFACE.core_errorMsgFlg == "N")THEN
	#{
		sv_z = "COREDel_RES.Status|SUCCESS"
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
		
		
		CUST.INTERFACE.CORE_USER_FLG  = "SUCCESS"
		CUST.INTERFACE.CORE_REMARKS  = "User Deleted successfully"
		
		sv_s = "UPDATE TBAADM.UPR SET ROLE_ID='DEL',USER_WORK_CLASS='011' WHERE USER_ID=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.userId
		
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSqlWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			print("updated")
		#}
		ELSE
		#{
			sv_z = "COREDel_RES.Status|FAILURE"
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
		
			sv_z = "COREDel_RES.core_errorDesc |User Deleted but RoleID,Work Class update failed."
			sv_u = urhk_SetOrbOut(sv_z)
			PRINT(sv_u)
		#}
		ENDIF
	#}
	ELSE
	#{
		sv_z = "COREDel_RES.Status|FAILURE"
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
		
		sv_z = "COREDel_RES.core_errorDesc |" + CUST.INTERFACE.core_errorDesc 
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
		
		sv_z = "COREDel_RES.core_ErrorSource |" + CUST.INTERFACE.core_ErrorSource 
		sv_u = urhk_SetOrbOut(sv_z)
		PRINT(sv_u)
		
		
		CUST.INTERFACE.CORE_USER_FLG  = "FAILURE"
		CUST.INTERFACE.CORE_REMARKS  = CUST.INTERFACE.core_errorDesc 
		#GOTO ENDOFSCRIPT
		CUST.INTERFACE.GOTO = "Y"
	#}
	ENDIF

	
	
	#TRACE OFF
end-->