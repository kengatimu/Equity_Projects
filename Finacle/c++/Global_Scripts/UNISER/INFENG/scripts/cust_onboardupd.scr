<--START
CHECKSUM="923f22fe0ad0dcd2e1a79039a2b47c057b9be70a4cc404bb8a0b38801345a275"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("cifid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply cifid"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.cifid=BANCS.INPUT.cifid
		print(CUST.DATA.cifid)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("OnboardStatus"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Onboard Status Y/N "
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.OnboardStatus=BANCS.INPUT.OnboardStatus
		print(CUST.DATA.OnboardStatus)
	#}
	ENDIF
	
	
	############################################
	# Fetching the value from table
	############################################
	
	sv_q = "update crmuser.coreinterface  set FREECODE1 =?SVAR , FREECODE1DESC='YES' where ORGKEY=?SVAR  AND bank_id=?SVAR "
	PRINT(sv_q)
	BANCS.INPARAM.BINDVARS = CUST.DATA.OnboardStatus + "|" + CUST.DATA.cifid + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_p= urhk_dbSQLWithBind(sv_q)
	print(sv_p)
	IF (sv_p==0) THEN
	#{
		sv_d = urhk_dbSqlWithBind("COMMIT")
		IF (CUST.DATA.OnboardStatus=="Y") THEN
		#{
			CUST.DATA.errMsg="Onboarded Successfully"
			CUST.DATA.varValue1="Y"
			#}
		ELSE
			#{
			CUST.DATA.errMsg="De-Onboarded Successfully"
			CUST.DATA.varValue1="N"
		#}
		ENDIF
		sv_z = urhk_SetOrbOut("ONBOARDEDSTATUS|"+CUST.DATA.varValue1)
		sv_e=urhk_SetOrbOut("Statusmsg|"+CUST.DATA.errMsg)
		#}
	ELSE
		#{
		sv_d = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_d)
		CUST.DATA.errMsg="Cifid Does not Exist"
		sv_e=urhk_SetOrbOut("Statusmsg|"+CUST.DATA.errMsg)
	#}
	ENDIF
	
	End:
		EXITSCRIPT
		TRACE OFF
END-->
