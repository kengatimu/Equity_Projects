<--start
trace on



	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether INTERFACE Class exists else create it
	###########################################################################################
		
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	

	#-------------------------------------------------------------------------
	# The below three parameter can be setup in CPARAM/SETVAR
	#-------------------------------------------------------------------------
	CUST.INTERFACE.interfaceRequestID = "SSOUserMod"
	CUST.INTERFACE.interfaceRequestVersion = "10.2"
	CUST.INTERFACE.bankId = BANCS.STDIN.contextBankId
	
	CUST.INTERFACE.endPointUrl = "<FIXML xsi:schemaLocation='http://www.finacle.com/fixml SSOUserMod.xsd' xmlns='http://www.finacle.com/fixml' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'>"
	PRINT(CUST.INTERFACE.endPointUrl)


	
	#-------------------------------------------------------------------------
	# Fetch the current data time to send in request header
	#-------------------------------------------------------------------------
	sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
		PRINT(CUST.INTERFACE.msgDateTime)
	#}
	ENDIF
	sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYYMMDD'),TO_CHAR(SYSDATE,'HHMMSS') FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.INTERFACE.requestId = "Req_" + BANCS.OUTPARAM.date + BANCS.OUTPARAM.time 
		PRINT(CUST.INTERFACE.requestId)
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------
	# Forming the Header
	# This would need to be changed based on the FI API that is being triggered
	# The sample given below is that of XferTrnAdd and all the input values are
	# currently hardcoded.
	#--------------------------------------------------------------------------
	#-------------------------------------------------------------------------
	#- Forming the Header for XferTrnAdd
	#-------------------------------------------------------------------------
	CUST.INTERFACE.bodyXMLMsg = ""
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Header>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RequestHeader>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<MessageKey>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RequestUUID>"+ CUST.INTERFACE.requestId +"</RequestUUID>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ServiceRequestId>"+CUST.INTERFACE.interfaceRequestID+"</ServiceRequestId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ChannelId>SSO</ChannelId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<LanguageId></LanguageId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</MessageKey>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RequestMessageInfo>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BankId>"+ CUST.INTERFACE.bankId  +"</BankId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TimeZone></TimeZone>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<EntityId></EntityId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<EntityType></EntityType>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ArmCorrelationId></ArmCorrelationId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<MessageDateTime>" + CUST.INTERFACE.msgDateTime + "</MessageDateTime>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RequestMessageInfo>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Security>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Token>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PasswordToken>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<UserId></UserId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Password></Password>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PasswordToken>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Token>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<FICertToken></FICertToken>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RealUserLoginSessionId></RealUserLoginSessionId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RealUser></RealUser>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RealUserPwd></RealUserPwd>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SSOTransferToken></SSOTransferToken>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Security>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RequestHeader>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Header>"
	
	
	
	#--------------------------------------------------------------------------
	# Forming the Body
	# This would need to be changed based on the FI API that is being triggered
	#--------------------------------------------------------------------------
	#-------------------------------------------------------------------------
	#- Forming the Body for XferTrnAdd
	#-------------------------------------------------------------------------
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Body>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SSOUserModRequest>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SSOUserModRq>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<userId>" +CUST.INTERFACE.userId+"</userId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<realUserId>" +CUST.INTERFACE.realUserId+"</realUserId>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<reqTwoFactorAuth>" +CUST.INTERFACE.reqTwoFactorAuth+"</reqTwoFactorAuth>"	
	
	IF(CUST.INTERFACE.dateDiff <= "0") THEN
	#{
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<pw_expy_date>" +CUST.INTERFACE.pw_expy_date+"</pw_expy_date>"
	#}
	ENDIF
	
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</SSOUserModRq>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</SSOUserModRequest>"
	CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Body>"
	#CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</FIXML>"
			
	PRINT(CUST.INTERFACE.bodyXMLMsg)
	
	
	
end-->
