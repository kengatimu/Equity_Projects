<--start
trace on
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("CUST","GLBDATA")==0)then
                createclass("CUST","GLBDATA",5)
        endif
	CUST.GLBDATA.acctCrncy = ""
	CUST.GLBDATA.refCrncy = ""
	CUST.GLBDATA.receivedAmt = ""
	CUST.GLBDATA.custName = ""
	CUST.GLBDATA.idNum = ""
	CUST.GLBDATA.phoneNo = ""
	CUST.GLBDATA.docDetails = ""
	CUST.GLBDATA.nationDet = ""
	CUST.GLBDATA.retMsg = ""
	CUST.GLBDATA.statusFlag = ""
	CUST.GLBDATA.errMsg = ""
	CUST.GLBDATA.fieldId = ""
	CUST.GLBDATA.bankId = ""
	CUST.GLBDATA.acctCrncyAmt = ""
	CUST.GLBDATA.amlYN="Z"
	CUST.GLBDATA.AmtLimit =""
	#--------------------------------Edwin
	CUST.GLBDATA.Output = ""
	CUST.GLBDATA.Output2 = ""
	CUST.GLBDATA.Output3 = ""
	CUST.GLBDATA.Output4 = ""
	CUST.GLBDATA.Output5 = ""
	CUST.GLBDATA.Output6 = ""	
	CUST.GLBDATA.Output7 = ""
	CUST.GLBDATA.amt1 = "0" 
	CUST.GLBDATA.cifId = ""
	CUST.GLBDATA.CummOutput = ""
	#-------------------------------Edwin
	CUST.GLBDATA.bankId = BANCS.STDIN.contextBankId
	print(CUST.GLBDATA.bankId)
	if(fieldexists(BANCS.INPUT.acctCrncy))then
		if(trim(BANCS.INPUT.acctCrncy) != "")then
			CUST.GLBDATA.acctCrncy = toupper(trim(BANCS.INPUT.acctCrncy))
			print(CUST.GLBDATA.acctCrncy)
		endif
	endif
	if(fieldexists(BANCS.INPUT.refCrncy))then
		if(trim(BANCS.INPUT.refCrncy) != "")then
			CUST.GLBDATA.refCrncy = toupper(trim(BANCS.INPUT.refCrncy))
			print(CUST.GLBDATA.refCrncy)
		endif
	endif
	if(fieldexists(BANCS.INPUT.receivedAmt))then
		if(trim(BANCS.INPUT.receivedAmt) != "")then
			CUST.GLBDATA.receivedAmt = trim(BANCS.INPUT.receivedAmt)
			print(CUST.GLBDATA.receivedAmt)
		endif
	endif
	if(fieldexists(BANCS.INPUT.treaRate))then
		if(trim(BANCS.INPUT.treaRate) != "")then
			CUST.GLBDATA.treaRate = trim(BANCS.INPUT.treaRate)
			print(CUST.GLBDATA.treaRate)
		endif
	endif
	if(fieldexists(BANCS.INPUT.custName))then
		if(trim(BANCS.INPUT.custName) != "")then
			CUST.GLBDATA.custName = toupper(trim(BANCS.INPUT.custName))
			print(CUST.GLBDATA.custName)
		endif
	endif
	if(fieldexists(BANCS.INPUT.idNum))then
		if(trim(BANCS.INPUT.idNum) != "")then
			CUST.GLBDATA.idNum = toupper(trim(BANCS.INPUT.idNum))
			print(CUST.GLBDATA.idNum)
		endif
	endif
	if(fieldexists(BANCS.INPUT.phoneNo))then
		if(trim(BANCS.INPUT.phoneNo) != "")then
			CUST.GLBDATA.phoneNo = toupper(trim(BANCS.INPUT.phoneNo))
			print(CUST.GLBDATA.phoneNo)
		endif
	endif
	if(fieldexists(BANCS.INPUT.docDetails))then
		if(trim(BANCS.INPUT.docDetails) != "")then
			CUST.GLBDATA.docDetails = toupper(trim(BANCS.INPUT.docDetails))
			print(CUST.GLBDATA.docDetails)
		endif
	endif
	if(fieldexists(BANCS.INPUT.nationDet))then
		if(trim(BANCS.INPUT.nationDet) != "")then
			CUST.GLBDATA.nationDet = toupper(trim(BANCS.INPUT.nationDet))
			print(CUST.GLBDATA.nationDet)
		endif
	endif
	if(fieldexists(BANCS.INPUT.acctCrncyAmt))then
		if(trim(BANCS.INPUT.acctCrncyAmt) != "")then
			CUST.GLBDATA.acctCrncyAmt = toupper(trim(BANCS.INPUT.acctCrncyAmt))
			print(CUST.GLBDATA.acctCrncyAmt)
		endif
	endif
	if(CUST.GLBDATA.idNum !="")then
		print(CUST.GLBDATA.idNum)
		sv_s = "cifId,uniqueID|select orgkey,uniqueid from crmuser.accounts where bank_id =?SVAR and uniqueid =?SVAR and rownum <2"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.GLBDATA.idNum
		print(BANCS.INPARAM.BINDVARS)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		if(sv_d ==0)then
			CUST.GLBDATA.cifId = BANCS.OUTPARAM.cifId
			print(CUST.GLBDATA.cifId)
			CUST.GLBDATA.uniqueID = BANCS.OUTPARAM.uniqueID
			print(CUST.GLBDATA.uniqueID)
		else
                        CUST.GLBDATA.cifId = "" 
                        CUST.GLBDATA.uniqueID = CUST.GLBDATA.idNum 
                endif
			sv_s = "amlYN|select substr(custom.fn_camlval_chk(?SVAR,?SVAR,null),1,1) from dual "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.GLBDATA.cifId
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_s)
			if(sv_u ==0)then
				CUST.GLBDATA.amlYN = BANCS.OUTPARAM.amlYN
				print(CUST.GLBDATA.amlYN)
				if (CUST.GLBDATA.amlYN =="Z") then
						print(CUST.GLBDATA.uniqueID)
					sv_s = "amlYN|select substr(custom.fn_camlval_chk(?SVAR,null,?SVAR),1,1) from dual "
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.GLBDATA.uniqueID
						print(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbSelectWithBind(sv_s)
					if(sv_u ==0)then
						CUST.GLBDATA.amlYN = BANCS.OUTPARAM.amlYN
						print(CUST.GLBDATA.amlYN)
					endif
				else
					print(CUST.GLBDATA.amlYN)
				endif
			endif
	endif
	if(CUST.GLBDATA.idNum !="")then
		sv_s ="FirstName,MiddleName,LastName,idNum,fromAmount,FromCurrency,Nationality,Phonenum,date,solId|"
		sv_s = sv_s + "select  customer_name,middle_name,last_name,id_num,from_amount,from_currency,nationality,phone_num,time,sol_id from (select "
		sv_s = sv_s + "	customer_name,middle_name,last_name,id_num,from_amount,"
		sv_s = sv_s + "from_currency,nationality,phone_num,trunc(rcre_time) as time,sol_id from CUSTOM.CASHDX_CUSTOM where id_num =?SVAR"
		sv_s = sv_s + " and bank_id =?SVAR  ORDER BY rcre_time desc )  where rownum = 1" 
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.GLBDATA.idNum +"|"+ BANCS.STDIN.contextBankId
		sv_e = urhk_dbCursorOpenWithBind(sv_s)	
		if(sv_e ==0)then
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			while (sv_q ==0)
				CUST.GLBDATA.FirstName = BANCS.OUTPARAM.FirstName
				CUST.GLBDATA.MiddleName = BANCS.OUTPARAM.MiddleName
				CUST.GLBDATA.LastName = BANCS.OUTPARAM.LastName
				CUST.GLBDATA.idNum = BANCS.OUTPARAM.idNum
				CUST.GLBDATA.fromAmount = BANCS.OUTPARAM.fromAmount
				CUST.GLBDATA.FromCurrency = BANCS.OUTPARAM.FromCurrency
				CUST.GLBDATA.Nationality = BANCS.OUTPARAM.Nationality
				CUST.GLBDATA.Phonenum = BANCS.OUTPARAM.Phonenum
				CUST.GLBDATA.date = BANCS.OUTPARAM.date
				CUST.GLBDATA.solId = BANCS.OUTPARAM.solId
				CUST.GLBDATA.CustName = CUST.GLBDATA.FirstName + " "+ CUST.GLBDATA.MiddleName + " " + CUST.GLBDATA.LastName
				CUST.GLBDATA.Output = "ID: " +CUST.GLBDATA.idNum +" Customer Name: " +CUST.GLBDATA.CustName +" Amount: "+CUST.GLBDATA.fromAmount+""+CUST.GLBDATA.FromCurrency+" Nationality: "+CUST.GLBDATA.Nationality+" Mobile: "+CUST.GLBDATA.Phonenum+" Date: "+CUST.GLBDATA.date+" Branch: "+CUST.GLBDATA.solId
				sv_q = urhk_dbCursorFetch(sv_m)
				print(sv_q)
			DO
		endif
		#---------------------------------Edwin  Cummulative for the month
		sv_s ="amt,currency|select sum(from_amount) amt ,from_currency  from CUSTOM.CASHDX_CUSTOM where id_num =?SVAR and sysdate - rcre_time <='30'" 
		sv_s = sv_s + "and from_currency  is not null and from_amount is not null and bank_id =?SVAR group by from_currency"
		print(sv_s)
                BANCS.INPARAM.BINDVARS = CUST.GLBDATA.idNum +"|"+ BANCS.STDIN.contextBankId
                sv_e = urhk_dbCursorOpenWithBind(sv_s)
                if(sv_e ==0)then
                        sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(sv_m)
                        sv_q = urhk_dbCursorFetch(sv_m)
                        print(sv_q)
                        while (sv_q ==0)
				CUST.GLBDATA.amt = BANCS.OUTPARAM.amt
				print(CUST.GLBDATA.amt)
				CUST.GLBDATA.currency = BANCS.OUTPARAM.currency
				print(CUST.GLBDATA.currency)
					print(CUST.GLBDATA.amt)
					if(CUST.GLBDATA.currency =="USD")then
						CUST.GLBDATA.Output2 = "USD: " + CUST.GLBDATA.amt
					endif	
					if(CUST.GLBDATA.currency =="GBP")then
                                                CUST.GLBDATA.Output3 = "GBP: " + CUST.GLBDATA.amt
                                        endif
					if(CUST.GLBDATA.currency =="EUR")then
                                                CUST.GLBDATA.Output4 = "EUR: " + CUST.GLBDATA.amt
                                        endif
					if(CUST.GLBDATA.currency =="AED")then
                                                CUST.GLBDATA.Output5 = "AED: " + CUST.GLBDATA.amt
                                        endif
					if(CUST.GLBDATA.currency =="KES")then
                                                CUST.GLBDATA.Output6 = "KES: " + CUST.GLBDATA.amt
					endif
					if(CUST.GLBDATA.currency =="ZAR")then
                                                CUST.GLBDATA.Output7 = "ZAR: " + CUST.GLBDATA.amt
                                        endif

				sv_q = urhk_dbCursorFetch(sv_m)
                                print(sv_q)
			do
			print(CUST.GLBDATA.amt1)
			if(CUST.GLBDATA.Output2 !="")then
				print(CUST.GLBDATA.Output2)
			else
				CUST.GLBDATA.Output2 = "USD: " + CUST.GLBDATA.amt1
				print(CUST.GLBDATA.Output2)
			endif
			if(CUST.GLBDATA.Output3 !="")then
				print(CUST.GLBDATA.Output3)
			else
				CUST.GLBDATA.Output3 = "GBP: " + CUST.GLBDATA.amt1
				print(CUST.GLBDATA.Output3)
			endif
			if(CUST.GLBDATA.Output4 !="")then
				print(CUST.GLBDATA.Output4)
			else
				CUST.GLBDATA.Output4 = "EUR: " + CUST.GLBDATA.amt1
				print(CUST.GLBDATA.Output4)
			endif
			if(CUST.GLBDATA.Output5 !="")then
				print(CUST.GLBDATA.Output5)
			else
				CUST.GLBDATA.Output5 = "AED: " + CUST.GLBDATA.amt1
				print(CUST.GLBDATA.Output5)
			endif
			if(CUST.GLBDATA.Output6 !="")then
				print(CUST.GLBDATA.Output6)
			else
				CUST.GLBDATA.Output6 = "KES: " + CUST.GLBDATA.amt1
				print(CUST.GLBDATA.Output6)
			endif
			if(CUST.GLBDATA.Output7 !="")then
                                print(CUST.GLBDATA.Output7)
                        else
                                CUST.GLBDATA.Output7 = "ZAR: " + CUST.GLBDATA.amt1
                                print(CUST.GLBDATA.Output7)
                        endif

			CUST.GLBDATA.CummOutput = "Last 30 days Totals:" +CUST.GLBDATA.Output2+ " " +CUST.GLBDATA.Output3+ " " +CUST.GLBDATA.Output4+ " " +CUST.GLBDATA.Output5+ " "+CUST.GLBDATA.Output6+ " "+CUST.GLBDATA.Output7
			print(CUST.GLBDATA.CummOutput)
		endif		

		#----------------------------------Edwin
	endif
	if(CUST.GLBDATA.amlYN!="")then
		##W/B
		sv_u = urhk_SetOrbOut("isWatchBlack|" + CUST.GLBDATA.amlYN ) 
	endif
	if(CUST.GLBDATA.cifId!="")then
		##Y/N
		sv_u = urhk_SetOrbOut("isEqCust|Y")
	else
		sv_u = urhk_SetOrbOut("isEqCust|N")
	endif
	if(CUST.GLBDATA.acctCrncy !="")then	
	if((CUST.GLBDATA.acctCrncy=="USD") or (CUST.GLBDATA.acctCrncy=="GBP") or (CUST.GLBDATA.acctCrncy=="EUR"))then
		if(cdouble(CUST.GLBDATA.receivedAmt)>1000)then
			##L
			sv_u = urhk_SetOrbOut("isLimit|L")
		else
			##L
			sv_u = urhk_SetOrbOut("isLimit|N")
		endif
	else
		if(CUST.GLBDATA.acctCrncy=="KES")then
			if(cdouble(CUST.GLBDATA.receivedAmt)>100000)then
				sv_u = urhk_SetOrbOut("isLimit|L")
			else
				sv_u = urhk_SetOrbOut("isLimit|N")	
			endif
		else
			if(CUST.GLBDATA.acctCrncy=="AED")then
				if(cdouble(CUST.GLBDATA.receivedAmt)>4000)then
					sv_u = urhk_SetOrbOut("isLimit|L")
				else
					sv_u = urhk_SetOrbOut("isLimit|N")
				endif	
			else
				if(CUST.GLBDATA.acctCrncy=="ZAR")then
					if(cdouble(CUST.GLBDATA.receivedAmt)>15000)then
						sv_u = urhk_SetOrbOut("isLimit|L")
					else
						sv_u = urhk_SetOrbOut("isLimit|N")
					endif
				else
					sv_u = urhk_SetOrbOut("isLimit|L")
				endif

			endif	
		endif
	endif
	endif
	if(CUST.GLBDATA.Output!="")then
		sv_u = urhk_SetOrbOut("isExistTran|" + CUST.GLBDATA.Output )
	else
		sv_u = urhk_SetOrbOut("isExistTran|N")
	endif
	if(CUST.GLBDATA.CummOutput!="")then
		sv_u = urhk_SetOrbOut("isCumm|" + CUST.GLBDATA.CummOutput )
		print(sv_u)
	else
		sv_u = urhk_SetOrbOut("isCumm|N")
		print(sv_u)
	endif

trace off
exitscript
end-->
