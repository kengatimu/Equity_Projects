	#	sv_u = urhk_SetOrbOut(sv_z)
	#	CUST.CTODA.successFlg = "F"
	#	GOTO ENDOFSCRIPT
	##}
	#ENDIF
	
	
	#-----------------------------------Modified for TOL 369221---------------------------#
	BANCS.INPARAM.BINDVARS =CUST.CTODA.accNum	 + "|" + "N" + "|" + "Y"
	
	sv_s ="schmType,schmCode|"
	sv_s = sv_s + " SELECT SCHM_TYPE,SCHM_CODE FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE  FORACID = ?SVAR "
	sv_s = sv_s + " AND DEL_FLG = ?SVAR "
	sv_s = sv_s + " AND ENTITY_CRE_FLG = ?SVAR"
	
	PRINT(sv_s)
	sv_u= urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CTODA.schmType=BANCS.OUTPARAM.schmType
		CUST.CTODA.schmCode=BANCS.OUTPARAM.schmCode
		#}
	ELSE
		#{
		CUST.CTODA.errorMsg="UNABLE TO FETCH SCHM TYPE FROM TABLE"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CTODA.errorMsg + "^acctNum")
		print(sv_u)
		GOTO ENDOFSCRIPT
		#}
		
	#}
	ENDIF
	PRINT(CUST.CTODA.schmType)
	#-----------------------------------------------------------
	#               Fetching valid schmecode:
	#-----------------------------------------------------------
	BANCS.INPUT.moduleName = "CATODSCORE"
	BANCS.INPUT.parameterId = "ALWDSCHM"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		sv_l = STRLEN(BANCS.OUTPUT.parameterVal)
		print(sv_l)
		CUST.CTODA.sType=BANCS.OUTPUT.parameterVal
		print(CUST.CTODA.sType)
		WHILE(sv_l > 0)
		#{
			sv_g = GETPOSITION(CUST.CTODA.sType,",")
			print(sv_g)
			IF (sv_g == 0) THEN
			#{
				CUST.CTODA.alwSchmType = CUST.CTODA.sType
				print(CUST.CTODA.alwSchmType)
				CUST.CTODA.sType = ""
				#}
			ELSE
				#{
				CUST.CTODA.alwSchmType = TRIM(MID$(CUST.CTODA.sType,0,sv_g - 1))
				CUST.CTODA.sType = MID$(CUST.CTODA.sType,sv_g,sv_l)
			#}
			ENDIF
			print(CUST.CTODA.alwSchmType)
			IF (CUST.CTODA.schmCode ==CUST.CTODA.alwSchmType) THEN
			#{
				# {
				GOTO LABEL1
			#}
			ENDIF
			print(CUST.CTODA.sType)
			sv_l = STRLEN(CUST.CTODA.sType)
			print(sv_l)
			IF (sv_l == 0) THEN
			#{
				CUST.CTODA.errMsg = "Scheme Code not allowed for this menu"
				sv_e = CUST.CTODA.errMsg
				sv_m = "funcCode"
				sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			# }
		#}
		DO
		#}
	ELSE
		#{
		CUST.CTODA.errMsg = "ALLOWED SCHMECODE SETUP NOT DONE IN CPARAM"
		GOTO ENDOFSCRIPT
		# }
	#}
	ENDIF
	
	LABEL1:
		#}
		
		
		
		
		#-----------------------------------Modified for TOL 369221---------------------------#
		
		
		
		
		#------------------------------------------------------------------------------
		#  calling script to fetch data from database.
		#------------------------------------------------------------------------------
		CALL("ctodadp002.scr")
		IF (CUST.CTODA.successFlg == "F") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#------------------------------------------------------------------------------
		#  calling script to set fetched data into front end.
		#------------------------------------------------------------------------------
		CALL("ctodadp004.scr")
		IF (CUST.CTODA.successFlg == "F") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		BANCS.OUTPUT.SuccessOrFailure = "S"
		sv_w = ""
		sv_w = "SuccessOrFailure|Y"
		sv_u = urhk_SetOrbOut(sv_w)
	ENDOFSCRIPT:
		IF (CUST.CTODA.successFlg == "F") THEN
		#{
			sv_w = "SUCCESSORFAILURE|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_z = "Error_0|ERROR^" + CUST.CTODA.errorMsg + "^" + CUST.CTODA.fieldName
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CTODA.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","CTODA") != 0) THEN
		#{
			DELETECLASS ("CUST","CTODA")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
