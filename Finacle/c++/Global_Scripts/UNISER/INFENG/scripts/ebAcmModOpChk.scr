<--start
trace on
#Rep/Class
        libname CUSTOMSO
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0) then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_u = urhk_B2k_PrintRepos("BANCS")
        print(sv_u)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.custId.cifId")
        EQSRV.GLBDATA.cifid = BANCS.OUTPARAM.srvValue
        print(EQSRV.GLBDATA.cifid)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode")
        EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.srvValue
        print(EQSRV.GLBDATA.schmCode)
        sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.foracid")
        EQSRV.GLBDATA.VirtualAcct = BANCS.OUTPARAM.srvValue
        print(EQSRV.GLBDATA.VirtualAcct)
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctCustInfo.modeOfOperCode.refCode")
        EQSRV.GLBDATA.TModeOfOper = BANCS.OUTPARAM.srvValue
        print(EQSRV.GLBDATA.TModeOfOper)
	sv_a = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.VirtualAcct)
	if(sv_a==0)then
		EQSRV.GLBDATA.FmodeOper = BANCS.OUTPARAM.modeOprnCode
	else
		EQSRV.GLBDATA.FmodeOper = ""
	endif
	print(EQSRV.GLBDATA.FmodeOper)
	##'ETS','ALL','ANY','AWITH','BTS','TTS'
	if((EQSRV.GLBDATA.FmodeOper=="ETS") or (EQSRV.GLBDATA.FmodeOper=="ALL") or (EQSRV.GLBDATA.FmodeOper=="ANY") or (EQSRV.GLBDATA.FmodeOper=="AWITH") or (EQSRV.GLBDATA.FmodeOper=="BTS") or (EQSRV.GLBDATA.FmodeOper=="TTS"))then
		if(EQSRV.GLBDATA.FmodeOper == EQSRV.GLBDATA.TModeOfOper)then
			print("No")
			exitscript
		endif
	else
		exitscript
	endif
        sv_a = urhk_getEnv("TBA_PROD_ROOT")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
		EQSRV.GLBDATA.rootpath = "/finacle/EQPROD/BackEnd/Finacle/FC/app/cust/INFENG"
	else
		EQSRV.GLBDATA.rootpath = BANCS.OUTPARAM.envValue
		EQSRV.GLBDATA.rootpath = EQSRV.GLBDATA.rootpath + "/cust/INFENG" 
        endif
	print(EQSRV.GLBDATA.rootpath)
        sv_s = "refNum|SELECT CONCAT(CONCAT('EQSAFIVAL',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5)))"
        sv_s = sv_s + " FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        if(sv_d == 0)then
                EQSRV.GLBDATA.refNum = BANCS.OUTPARAM.refNum
                print(EQSRV.GLBDATA.refNum)
        endif
	sv_d = "httpURL | select v.parameter_value from custom.c_cpvalue  v,custom.c_cpmaster m "
	sv_d = sv_d + " where m.parameter_id=v.parameter_id "
	sv_d = sv_d + " and m.module_name =v.module_name "
	sv_d = sv_d + " and m.module_name='WAY4' "
	sv_d = sv_d + " and m.parameter_level='BNKL' "
	sv_d = sv_d + " and v.parameter_id=?SVAR "
	sv_d = sv_d + " and m.entity_cre_flg='Y' "
	sv_d = sv_d + " and v.entity_cre_flg='Y' "
	sv_d = sv_d + " and m.del_flg='N' "
	sv_d = sv_d + " and v.del_flg='N' "
	sv_d = sv_d + " and m.bank_id=?SVAR "
	sv_d = sv_d + " and v.bank_id=?SVAR "
	BANCS.INPARAM.BINDVARS = "ACMURL|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.httpURL = BANCS.OUTPARAM.httpURL
	else
		EQSRV.GLBDATA.httpURL = "http://wsinternaluat.ebsafrica.com/fin/ESB/PS/Way4/V3/REST/Card/queryCardsByAccNo"
	endif
        EQSRV.GLBDATA.edResp =  EQSRV.GLBDATA.refNum + ".dat"
	EQSRV.GLBDATA.MsgId = "565757"
	EQSRV.GLBDATA.acctNum = EQSRV.GLBDATA.VirtualAcct 
        EQSRV.GLBDATA.jInp = EQSRV.GLBDATA.MsgId + " " + EQSRV.GLBDATA.acctNum + " " + EQSRV.GLBDATA.httpURL
        print(EQSRV.GLBDATA.jInp)
        sv_r=system("java -cp /finacle/jdk1.7.0_80/lib:/finacle/jdk1.7.0_80/custom:/finacle/jdk1.7.0_80/custom/commons-codec.jar:" +EQSRV.GLBDATA.rootpath+ " com.cubpEquityDirect.EBGetWayCardDetails.EBGetWayCardDetails "+ EQSRV.GLBDATA.jInp + " >> " +EQSRV.GLBDATA.edResp )
	print(sv_r)
        sv_a = urhk_getEnv("ONS_LOG_DIR")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
                print("Env variable ONS/log not found")
                goto VAYU
        endif
        EQSRV.GLBDATA.ONS_path = BANCS.OUTPARAM.envValue
        print(EQSRV.GLBDATA.ONS_path)
        EQSRV.GLBDATA.fileLoc = EQSRV.GLBDATA.ONS_path +"/"+BANCS.STDIN.userId + "/" + EQSRV.GLBDATA.edResp
        print(EQSRV.GLBDATA.fileLoc)
        sv_r = urtn_fileAccess(EQSRV.GLBDATA.fileLoc)
        ###print(sv_r)
        if(sv_r != 0)then
                EQSRV.GLBDATA.excmessageField = "File does not exists"
                sv_z = urhk_SetOrbOut("Error_1|Error^File does not exist^txtFilename")
                goto VAYU
        else
                EQSRV.GLBDATA.fileopen = "Y"
        endif
        print(EQSRV.GLBDATA.fileopen)
        sv_s = urtn_fileOpen(EQSRV.GLBDATA.fileLoc + "|r")
        if(sv_s < 0)then
                print("error in openning file")
        else
        sv_k = urtn_fileRead(sv_s+"|EQSRV.GLBDATA.Record1")
        EQSRV.GLBDATA.recNum =1
        while(sv_k == 0)
        #{
                if(EQSRV.GLBDATA.Record1 =="")then
                        goto NEXTRECORD
                else
                        BANCS.INPUT.wkbAcct = ""
			#200|ESB-00|SUCCESS|23 Cards found|23
                        ###print(EQSRV.GLBDATA.Record1)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        ###print(sv_f)
                        sv_p = getposition(sv_f,"|")
                        BANCS.INPUT.wkbAcct  = mid$(sv_f,0,(sv_p-1))
                        print(BANCS.INPUT.wkbAcct)
                        if(BANCS.INPUT.wkbAcct!="200")then
                                EQSRV.GLBDATA.errorFlg = "Y"
                                EQSRV.GLBDATA.errorMsg = "Way4 Connection Failed"
                                sv_u = urhk_SetOrbOut("errorFlg|"+EQSRV.GLBDATA.errorFlg)
                                sv_u = urhk_SetOrbOut("errorMsg|"+EQSRV.GLBDATA.errorMsg)
                                sv_s = system("rm -f " + EQSRV.GLBDATA.fileLoc)
                                sv_u = urhk_SRV_SetErr("Way4 Connection Failed  ["+ EQSRV.GLBDATA.acctNum+ "]")
                                exitscript
                        endif
                        #+++++++++++++
                        #CifId
                        #+++++++++++++
                        EQSRV.GLBDATA.Record1 = mid$(sv_f,sv_p,sv_l)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.RepCode  = mid$(sv_f,0,(sv_p-1))
                        #+++++++++++++
                        #Account Number
                        #+++++++++++++
                        EQSRV.GLBDATA.Record1 = mid$(sv_f,sv_p,sv_l)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.repMsg  = mid$(sv_f,0,(sv_p-1))
                        #+++++++++++++
                        #Acct Name
                        #+++++++++++++
                        EQSRV.GLBDATA.Record1 = mid$(sv_f,sv_p,sv_l)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.reCard  = mid$(sv_f,0,(sv_p-1))
                        #+++++++++++++
                        #Phone Number
                        #+++++++++++++
                        EQSRV.GLBDATA.repCardNum = mid$(sv_f,sv_p,sv_l)
                        print(EQSRV.GLBDATA.RepCode)
                        print(EQSRV.GLBDATA.repMsg)
                        print(EQSRV.GLBDATA.reCard)
                        print(EQSRV.GLBDATA.repCardNum)
                        if(cdouble(EQSRV.GLBDATA.repCardNum)>0)then
                                sv_u = urhk_SRV_SetErr("Mode Of Operation Modification Not Allowed for ACC:"+ EQSRV.GLBDATA.acctNum + " " + EQSRV.GLBDATA.repCardNum + " Card(s) ACTIVE!!")
                                exitscript
                        endif
               endif
                NEXTRECORD:
                sv_k = urtn_fileRead(sv_s+"|EQSRV.GLBDATA.Record1")
                print(EQSRV.GLBDATA.recNum)
                EQSRV.GLBDATA.recNum = CINT(EQSRV.GLBDATA.recNum) +1
                print(EQSRV.GLBDATA.recNum)
        #}
        do
        endif
VAYU:
        exitscript
trace off
end-->
