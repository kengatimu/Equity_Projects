<--start
TRACE ON

#-------------------------------------------------------------
# Repository creation
#-------------------------------------------------------------
IF (REPEXISTS("CUST") == 0 ) THEN
#{
	CREATEREP("CUST")
#}
ENDIF
IF (CLASSEXISTS("CUST","UPM") == 0) THEN
#{
	CREATECLASS("CUST","UPM",5)
#}
ENDIF

CUST.UPM.errMsg = ""

#=========================================================================
# Checking User has a teller GL assigned 
#=========================================================================
sv_u = urhk_SRV_GetVal("usrGenDtl.emp.empId")
CUST.UPM.empID = BANCS.OUTPARAM.srvValue
print(CUST.UPM.empID)

sv_u = urhk_SRV_GetVal("usrGenDtl.usrRole.id")
CUST.UPM.roleId = BANCS.OUTPARAM.srvValue
print(CUST.UPM.roleId)

sv_u = urhk_SRV_GetVal("usrGenDtl.workClass.refCode")
CUST.UPM.workClass = BANCS.OUTPARAM.srvValue
print(CUST.UPM.workClass)

sv_u = urhk_SRV_GetVal("usrGenDtl.sol.solId")
CUST.UPM.solId = BANCS.OUTPARAM.srvValue
print(CUST.UPM.solId)


IF (TRIM(CUST.UPM.workClass) == 200) THEN

	sv_s="bgdmcount|"
        sv_s = sv_s + " SELECT COUNT(1) "
        sv_s = sv_s + " FROM TBAADM.UPR "
        sv_s = sv_s + " WHERE SOL_ID = ?SVAR "
	sv_s = sv_s + " AND USER_WORK_CLASS = '200' "
        sv_s = sv_s + " AND HOME_BANK_ID = ?SVAR "
	sv_s = sv_s + " AND USER_EMP_ID != ?SVAR "
        print(sv_s)
        BANCS.INPARAM.BINDVARS =  CUST.UPM.solId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.UPM.empID
        print(BANCS.INPARAM.BINDVARS)
	sv_b = urhk_dbSelectWithBind(sv_s)
	print(sv_b)
	IF(sv_b != 0) THEN
		#{
			print("BRM QUERY FAIL")
			GOTO ENDOFSCRIPT
		#}

	ELSE
		#{
			CUST.UPM.bgdmcount = BANCS.OUTPARAM.bgdmcount
			Print(CUST.UPM.bgdmcount)
				IF ((CINT(CUST.UPM.bgdmcount) > 1) AND (TRIM(CUST.UPM.solId) != 029) AND (TRIM(CUST.UPM.solId) != 011) AND (TRIM(CUST.UPM.solId) != 025) AND (TRIM(CUST.UPM.solId) != 030) AND (TRIM(CUST.UPM.solId) != 031)AND (TRIM(CUST.UPM.solId) != 052) AND (TRIM(CUST.UPM.solId) != 104) AND (TRIM(CUST.UPM.solId) != 081) AND (TRIM(CUST.UPM.solId) != 001) AND (TRIM(CUST.UPM.solId) != 018) AND (TRIM(CUST.UPM.solId) != 140) AND (TRIM(CUST.UPM.solId) != 141) AND (TRIM(CUST.UPM.solId) != 147) AND (TRIM(CUST.UPM.solId) != 148) AND (TRIM(CUST.UPM.solId) != 151) AND (TRIM(CUST.UPM.solId) != 155) AND (TRIM(CUST.UPM.solId) != 156) AND (TRIM(CUST.UPM.solId) != 160) AND (TRIM(CUST.UPM.solId) != 162) AND (TRIM(CUST.UPM.solId) != 163) AND (TRIM(CUST.UPM.solId) != 164) AND (TRIM(CUST.UPM.solId) != 170) AND (TRIM(CUST.UPM.solId) != 177))THEN
					CUST.UPM.errMsg = "THE BRANCH WILL HAVE MORE THAN 2 USERS WITH WORKCLASS 200"    
					print(CUST.UPM.errMsg)
							sv_s="UPRADT|"
							sv_s = sv_s + " SELECT COUNT(1) FROM TBAADM.ADT WHERE TABLE_NAME ='UPR' AND AUTH_ID ='!' AND MOP_ID ='CTRM' AND FUNC_CODE ='M' AND SUBSTR(TABLE_KEY,3,5) = ?SVAR "		
							print(sv_s)
							BANCS.INPARAM.BINDVARS =  CUST.UPM.empID
							print(BANCS.INPARAM.BINDVARS)
							sv_b = urhk_dbSelectWithBind(sv_s)
							print(sv_b)
									IF(sv_b != 0) THEN
										#{
											print("ADT QUERY FAIL")
											GOTO ENDOFSCRIPT
										#}

									ELSE	
											CUST.UPM.UPRADT = BANCS.OUTPARAM.UPRADT
											Print(CUST.UPM.UPRADT)
												IF (CINT(CUST.UPM.UPRADT) > 0) THEN
													BANCS.INPARAM.BINDVARS =  CUST.UPM.empID + "|" + CUST.UPM.empID
													print(BANCS.INPARAM.BINDVARS)
													sv_a = " update tbaadm.adt set AUTH_ID =(SELECT ENTERER_ID FROM TBAADM.ADT WHERE TABLE_NAME ='UPR' AND AUTH_ID ='!' AND MOP_ID ='CTRM' AND FUNC_CODE ='M' AND SUBSTR(TABLE_KEY,3,5) = ?SVAR),AUTH_BOD_DATE =AUDIT_BOD_DATE, AUTH_DATE =AUDIT_DATE, RMKS ='Modification Cancelled' WHERE TABLE_NAME in ('UPR','UAC') AND AUTH_ID ='!' AND MOP_ID ='CTRM' AND FUNC_CODE ='M' AND SUBSTR(TABLE_KEY,3,5) LIKE ?SVAR "
													sv_d = urhk_dbSQLWithBind(sv_a)
													print(sv_d)	
													BANCS.INPARAM.BINDVARS =  CUST.UPM.empID 
													print(BANCS.INPARAM.BINDVARS)
													sv_a = " delete tbaadm.upr_mod where  USER_EMP_ID = ?SVAR "
													sv_d = urhk_dbSQLWithBind(sv_a)
													print(sv_d)
													

												ENDIF
									ENDIF
								
					GOTO ENDOFSCRIPT
				
				ENDIF	
		#}
	ENDIF

ENDIF

IF (BANCS.STDIN.contextBankId !="43") THEN
IF ((CUST.UPM.roleId !="ICT") AND (CUST.UPM.roleId !="NTL") AND (CUST.UPM.roleId !="RTL") AND (CUST.UPM.roleId !="CTL") AND (CUST.UPM.roleId !="TELLER4") AND (CUST.UPM.roleId !="TELLER5")) THEN

	sv_s="Glcount|"
        sv_s = sv_s + " SELECT COUNT(1) "
        sv_s = sv_s + " FROM TBAADM.GEC "
        sv_s = sv_s + " WHERE EMP_ID = TRIM(?SVAR) "
        sv_s = sv_s + " AND BANK_ID = ?SVAR"
        print(sv_s)
        BANCS.INPARAM.BINDVARS =  CUST.UPM.empID + "|" +BANCS.STDIN.contextBankId 
        print(BANCS.INPARAM.BINDVARS)
	sv_b = urhk_dbSelectWithBind(sv_s)
	print(sv_b)
	IF(sv_b != 0) THEN
		#{
			print("GEC Query execution failed")
			GOTO ENDOFSCRIPT
		#}

	ELSE
		#{
			CUST.UPM.Glcount = BANCS.OUTPARAM.Glcount
			Print(CUST.UPM.Glcount)
				IF (CINT(CUST.UPM.Glcount) != 0) THEN
					CUST.UPM.errMsg = "The User Has a Teller GL Is Assigned"
					print(CUST.UPM.errMsg)
					GOTO ENDOFSCRIPT
				ENDIF
	#}
	ENDIF
ELSE
	IF ((CUST.UPM.workClass != "060") AND (CUST.UPM.workClass != "062"))THEN	
	CUST.UPM.errMsg = "The RoleId should ONLY be assigned to WorkClass 060,062"
	print(CUST.UPM.errMsg)
	GOTO ENDOFSCRIPT
 
	#}
	ENDIF
ENDIF

ELSE

IF ((CUST.UPM.roleId !="ICT") AND (CUST.UPM.roleId !="NTL") AND (CUST.UPM.roleId !="RTL") AND (CUST.UPM.roleId !="CTL") AND (CUST.UPM.roleId !="TELLER4") AND (CUST.UPM.roleId !="FRO") AND (CUST.UPM.roleId !="CLM")) THEN

	sv_s="Glcount|"
        sv_s = sv_s + " SELECT COUNT(1) "
        sv_s = sv_s + " FROM TBAADM.GEC "
        sv_s = sv_s + " WHERE EMP_ID = TRIM(?SVAR) "
        sv_s = sv_s + " AND BANK_ID = ?SVAR"
        print(sv_s)
        BANCS.INPARAM.BINDVARS =  CUST.UPM.empID + "|" +BANCS.STDIN.contextBankId 
        print(BANCS.INPARAM.BINDVARS)
	sv_b = urhk_dbSelectWithBind(sv_s)
	print(sv_b)
	IF(sv_b != 0) THEN
		#{
			print("GEC Query execution failed")
			GOTO ENDOFSCRIPT
		#}

	ELSE
		#{
			CUST.UPM.Glcount = BANCS.OUTPARAM.Glcount
			Print(CUST.UPM.Glcount)
				IF (CINT(CUST.UPM.Glcount) != 0) THEN
					CUST.UPM.errMsg = "The User Has a Teller GL Is Assigned"
					print(CUST.UPM.errMsg)
					GOTO ENDOFSCRIPT
				ENDIF
	#}
	ENDIF
ELSE
	IF ((CUST.UPM.workClass != "060") AND (CUST.UPM.workClass != "070")) THEN

		CUST.UPM.errMsg = "The RoleId should ONLY be assigned to WorkClass 060,070"

	print(CUST.UPM.errMsg)
	GOTO ENDOFSCRIPT
 
	#}
	ENDIF

ENDIF
ENDIF




ENDOFSCRIPT:
IF(CUST.UPM.errMsg != "") THEN
#{
	print(CUST.UPM.errMsg)
	sv_u = urhk_SRV_setErr(CUST.UPM.errMsg)
#}
ENDIF

EXITSCRIPT

TRACE OFF
