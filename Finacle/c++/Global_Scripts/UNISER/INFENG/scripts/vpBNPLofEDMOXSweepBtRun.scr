#-----------------------------------------------------------------------------------------------
<--START
TRACE ON
        sv_r = repexists("MTT")
        if(sv_r == 0)then
                createrep("MTT")
        endif
        sv_r = classexists("MTT","TranDetails")
        if(sv_r == 0)then
                createclass("MTT","TranDetails",5)
        endif
        sv_r = classexists("MTT","Error")
        if(sv_r == 0)then
                createclass("MTT","Error",5)
        endif

MTT.TranDetails.TranDateDiff    = "0"
MTT.TranDetails.TranType        = "T"
MTT.TranDetails.TranSubType     = "CI"
MTT.TranDetails.IgnoreExcp      = "I"
MTT.TranDetails.Consolidate     = "Y"
MTT.TranDetails.PostFlag        = "Y"
#MTT.TranDetails.ReversalFlg     = "Y"
MTT.TranDetails.PrintAdviceInd  = "B"
MTT.TranDetails.Remarks         = "BNPL EDMOX Batch Sweep"
sv_a = urhk_MTTS_PopulateInputDetails("")
print(sv_a)
print(EBSRV.GLBDATA.drAcct)
print(EBSRV.GLBDATA.crAcct)
print(EBSRV.GLBDATA.totTranDrAmt)
sv_r = urhk_MTTS_DefineTransaction("BGAMORT")
print(sv_r)

IF (sv_r != 0)THEN
        BANCS.OUTPUT.successOrFailure = "F"
	print(MTT.Error.Description)
	MTT.Error.Description="Debit Part Tran Definition failed "
	sv_r = urhk_MTTS_ReportErrorCondition("")
	sv_r = BANCS.OUTPARAM.MTTErrorDesc
        goto VAYU
ENDIF
#Creation of Debit leg
MTT.PartTranDetails.Account             = EBSRV.GLBDATA.drAcct 
print(MTT.PartTranDetails.Account)
MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode 
MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode 
MTT.PartTranDetails.Particulars         = "Disbursement for: " + EBSRV.GLBDATA.crAcct 
print(MTT.PartTranDetails.Particulars)
MTT.PartTranDetails.RefAmount           = -(cdouble(EBSRV.GLBDATA.totTranDrAmt))
print(MTT.PartTranDetails.RefAmount)
MTT.PartTranDetails.Amount              = -(cdouble(EBSRV.GLBDATA.totTranDrAmt))
print(MTT.PartTranDetails.Amount)
MTT.PartTranDetails.Refnum              = "Cons:" + left$(BANCS.STDIN.BODDate,10) 
print(MTT.PartTranDetails.Refnum)
MTT.PartTranDetails.RateCode            = ""
print(MTT.PartTranDetails.RateCode)
MTT.PartTranDetails.Rate                = "0" 
print(MTT.PartTranDetails.Rate)
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "Y"
MTT.PartTranDetails.ReportCode  	= "EDMOX"
MTT.PartTranDetails.ValueDateDiff       = "0"
MTT.PartTranDetails.Remarks             = "BNPL EDOMX" 
print(MTT.PartTranDetails.Remarks)
MTT.PartTranDetails.PstFlg              = "Y"
sv_r = urhk_MTTS_DefinePartTran("AMORT")
print(sv_r)
IF (sv_r!=0)THEN
        BANCS.OUTPUT.successOrFailure = "F"
	print(MTT.Error.Description)
	MTT.Error.Description="Debit Part Tran Definition failed "
	sv_r = urhk_MTTS_ReportErrorCondition("")
	sv_r = BANCS.OUTPARAM.MTTErrorDesc
        goto VAYU
ENDIF
# Creation of credit leg
MTT.PartTranDetails.Account             = EBSRV.GLBDATA.crAcct 
print(MTT.PartTranDetails.Account)
MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode 
print(MTT.PartTranDetails.RefCurrency)
MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode 
print(MTT.PartTranDetails.TranCurrency)
MTT.PartTranDetails.Particulars         = "Disbursement:from " + EBSRV.GLBDATA.drAcct 
print(MTT.PartTranDetails.Particulars)
MTT.PartTranDetails.RefAmount           = (cdouble(EBSRV.GLBDATA.totTranDrAmt))
print(MTT.PartTranDetails.RefAmount)
MTT.PartTranDetails.Amount              = (cdouble(EBSRV.GLBDATA.totTranDrAmt))
print(MTT.PartTranDetails.Amount)
MTT.PartTranDetails.Refnum              = "Cons:" + left$(BANCS.STDIN.BODDate,10) 
print(MTT.PartTranDetails.Refnum)
MTT.PartTranDetails.RateCode            = ""
MTT.PartTranDetails.Rate                = "" 
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "Y"
MTT.PartTranDetails.ReportCode  	= "EDMOX"
MTT.PartTranDetails.ValueDateDiff       = "0"
MTT.PartTranDetails.Remarks             = "BNPL EDOMX" 
MTT.PartTranDetails.PstFlg              = "Y"

sv_t = urhk_MTTS_DefinePartTran("AMORT")
print(sv_t)
IF(sv_t!=0)THEN
        BANCS.OUTPUT.successOrFailure = "F"
	print(MTT.Error.Description)
	MTT.Error.Description="Debit Part Tran Definition failed "
	sv_r = urhk_MTTS_ReportErrorCondition("")
	sv_r = BANCS.OUTPARAM.MTTErrorDesc
        goto VAYU
ENDIF
#Tran Status
MTT.Error.Description   = ""
BANCS.INPUT.TranStatus  = "S"
sv_r = urhk_MTTS_EndDefinition("")
print(sv_r)
IF(sv_r!=0)THEN
        BANCS.OUTPUT.successOrFailure = "F"
	print(MTT.Error.Description)
	MTT.Error.Description="Debit Part Tran Definition failed "
	sv_r = urhk_MTTS_ReportErrorCondition("")
	sv_r = BANCS.OUTPARAM.MTTErrorDesc
        goto VAYU
ELSE
        EBSRV.GLBDATA.MTTTranId = BANCS.OUTPARAM.MTTTranId
        print(EBSRV.GLBDATA.MTTTranId)
        goto VAYU
ENDIF
VAYU:
exitscript
TRACE OFF
END-->

