#-------------------------------------------------------------------------------------
#    Name				: schmwrkclassvaldp001.scr
#    Description     	: The script is used to hardcode source sol Id to home sol Id
#						: and to validate userWorkClass
#    Date            	: 23-01-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: getcparamvalue.scr
#    Menu Option		: HACXFSOL 
#    Srl. No		Date			Author			Description.   
#    -------		----			------			----------------
#    1.0			23-01-2013		Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","SCHMWCVAL") == 0) THEN
#{
	CREATECLASS("CUST","SCHMWCVAL",5)
#}
ENDIF

CUST.SCHMWCVAL.errMsg        = ""
CUST.SCHMWCVAL.userWorkClass = ""

BANCS.INPUT.moduleName  = "ACCTSCHMXFR"
BANCS.INPUT.parameterId = "SCHMWCVAL_WC"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.SCHMWCVAL.userWorkClass = BANCS.OUTPUT.parameterVal
	PRINT(CUST.SCHMWCVAL.userWorkClass)
#}
ELSE
#{
	CUST.SCHMWCVAL.errMsg = "Work Class setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

PRINT(BANCS.STDIN.contextBankId)
IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43")) THEN
#{
	PRINT(BANCS.STDIN.userWorkClass)
	PRINT(CUST.SCHMWCVAL.userWorkClass)
	IF (CINT(BANCS.STDIN.userWorkClass) < CINT(CUST.SCHMWCVAL.userWorkClass)) THEN
	#{
		CUST.SCHMWCVAL.res = "Y"
		PRINT(CUST.SCHMWCVAL.res)
		sv_a = "status|" + CUST.SCHMWCVAL.res
		PRINT(sv_a)
		sv_b = urhk_SetOrbOut(sv_a)
	#}
	ELSE
	#{
		CUST.SCHMWCVAL.res = "N"
		PRINT(CUST.SCHMWCVAL.res)
		sv_a = "status|" + CUST.SCHMWCVAL.res
		PRINT(sv_a)
		sv_b = urhk_SetOrbOut(sv_a)
	#}
	ENDIF
#}
ENDIF


ENDOFSCRIPT:
IF (CUST.SCHMWCVAL.errMsg != "") THEN
#{
	sv_a = "Error|" +CUST.SCHMWCVAL.errMsg
	PRINT(sv_a)
    sv_b = urhk_SetOrbOut(sv_a)
#}
ENDIF


#TRACE OFF
EXITSCRIPT
END-->
