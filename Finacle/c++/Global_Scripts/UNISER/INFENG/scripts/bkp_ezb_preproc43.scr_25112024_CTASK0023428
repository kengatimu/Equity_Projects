<--START
TRACE ON

	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
		CREATEREP("CUST")
	ENDIF

	sv_r = CLASSEXISTS("CUST", "ATM")
	IF (sv_r == 0) THEN
		CREATECLASS("CUST", "ATM", 5)
	ENDIF

	CUST.ATM.TranFeeCustAcct1 =""
	CUST.ATM.status = ""

	lv_f = mid$(BANCS.INPUT.Fee,4,16)
	print(lv_f)
	lv_f = CDOUBLE(lv_f)
	lv_f = lv_f/100
	print(lv_f)

	IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum) == 1) THEN
		IF (BANCS.INPUT.ConsumerNum !="") THEN
			print(BANCS.INPUT.ConsumerNum)
			sv_p = getposition(BANCS.INPUT.ConsumerNum,"|")
			print (sv_p)
			IF (sv_p ==0 ) THEN
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.ConsumerNum)
				IF (sv_u == 0) THEN
					print(BANCS.OUTPARAM.schmCode)
					IF (BANCS.OUTPARAM.schmCode=="INCOM") THEN
						CUST.ATM.TranFeeContraAcct1 = BANCS.INPUT.ConsumerNum
					ELSE
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.ReservedField3 = "Income Account Defined is not INCOM Type GL:Field 63"
						BANCS.OUTPUT.successOrFailure="F"
					ENDIF
				ELSE
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.ReservedField3 = "Income Account Defined is invalid:Field 63"
					BANCS.OUTPUT.successOrFailure="F"
				ENDIF
			ELSE
				sv_m = MID$(BANCS.INPUT.ConsumerNum, 0, sv_p-1)
				PRINT(sv_m)
				sv_u = urhk_getAcctDetailsInRepository(sv_m)
				IF (sv_u == 0) THEN
					CUST.ATM.TranFeeCustAcct1 = sv_m			
				ELSE
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.ReservedField3 = "Debit Fee Acct Defined is invalid:Field 63"
					BANCS.OUTPUT.successOrFailure="F"			
				ENDIF
			ENDIF

			# GET ACCOUNT STATUS
			lv_u = urhk_B2k_ForacidToAcid(CUST.ATM.TranFeeCustAcct1)
			print(lv_u)

			IF (lv_u == 0) THEN
				BANCS.INPARAM.acid = BANCS.OUTPARAM.Acid
				print(BANCS.INPARAM.acid)

				sv_u = urhk_getAcctStatus("")
				IF(sv_u == 0) THEN
					CUST.ATM.status = BANCS.OUTPARAM.acctStatus
					print(CUST.ATM.status)
				ENDIF
			ENDIF

			sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.TranFeeCustAcct1)
			IF (sv_u == 0) THEN
				CUST.ATM.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
				print(CUST.ATM.EffAvailableAmt)
				CUST.ATM.feeAmt  = lv_f
				PRINT(CUST.ATM.feeAmt)
				IF(CDOUBLE(CUST.ATM.feeAmt) > CDOUBLE("0"))THEN
					IF(CDOUBLE(CUST.ATM.feeAmt) > CDOUBLE(CUST.ATM.EffAvailableAmt) ) THEN
						CUST.ATM.LowBalInd ="Y"
						BANCS.OUTPUT.Fee="CDFD000000000000000070"
						BANCS.OUTPUT.StlmntFee="CDF00000000D0000000000000000"
					ENDIF
					IF(CUST.ATM.status != "") THEN
						IF((CUST.ATM.status == "D") OR (CUST.ATM.status == "I") )THEN
							CUST.ATM.LowBalInd ="Y"
							BANCS.OUTPUT.Fee="CDFD000000000000000070"
							BANCS.OUTPUT.StlmntFee="CDF00000000D0000000000000000"
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF

trace off
END-->
