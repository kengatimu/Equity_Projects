	BANCS.INPUT.moduleName  = "ATM"
	BANCS.INPUT.parameterId = "SCHMCODE_1"
	
	CALL ("atmgetcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ATM.schmCode1 = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.ATM.errMsg = "Suspense Account setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	## Balance fees INCOME GLS
	IF ((BANCS.INPUT.DccId == "SWT") or (BANCS.INPUT.DccId == "BRK") or(BANCS.INPUT.DccId=="WPD")OR (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
		IF ((BANCS.INPUT.ReservedField2=="BalEnq") OR  (BANCS.INPUT.ReservedField2=="MinStat")) THEN
			CUST.ATM.schmCode1income="INCOM"
			print(CUST.ATM.schmCode1income)
			IF ( (BANCS.INPUT.DccId == "SWT") or (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId=="WPD") or (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
				CUST.ATM.schmCode1income="BCDCINCOM"
				print(CUST.ATM.schmCode1income)
			ENDIF
			IF (BANCS.INPUT.ReservedField2=="BalEnq") THEN
				CUST.ATM.bacid="FRAICOM"
				print(CUST.ATM.bacid)
			ENDIF
			IF (BANCS.INPUT.ReservedField2=="MinStat") THEN
				CUST.ATM.bacid="FRAICOM"
				print(CUST.ATM.bacid)
			ENDIF
			sv_s = "contra|"
			sv_s = sv_s + " SELECT foracid "
			sv_s = sv_s + " FROM GAM "
			sv_s = sv_s + " WHERE sol_id = ?SVAR "
			sv_s = sv_s + " AND schm_code= ?SVAR  "
			sv_s = sv_s + " AND acct_ownership='O' "
			sv_s = sv_s + " AND DEL_FLG ='N' "
			sv_s = sv_s + " AND BACID = ?SVAR  "
			sv_s = sv_s + " AND bank_id = ?SVAR and rownum<2 "
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.SolId + "|" + CUST.ATM.schmCode1income + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.contextBankId 
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF  (sv_d == "0") then
				BANCS.OUTPUT.contraAccount = BANCS.OUTPARAM.contra
				print(BANCS.OUTPUT.contraAccount)
				GOTO ENDOFSCRIPT
			ENDIF
		ENDIF
	ENDIF
	IF ((BANCS.INPUT.DccId == "SWT") OR (BANCS.INPUT.DccId=="WPD") or (BANCS.INPUT.DccId == "BRK") OR (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN")) THEN
		IF(FIELDEXISTS(BANCS.INPUT.DeviceId) == 1) THEN
			CUST.ATM.DeviceId=BANCS.INPUT.DeviceId
			print(CUST.ATM.DeviceId)
			IF (BANCS.INPUT.CrForacid!="") THEN

				BANCS.OUTPUT.contraAccount= BANCS.INPUT.CrForacid
				print(BANCS.OUTPUT.contraAccount)
				IF ((BANCS.INPUT.DccId == "SWT") or (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId=="WPD") or (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN")) THEN
					CUST.ATM.DeviceId=trim(CUST.ATM.DeviceId) 
					print(CUST.ATM.DeviceId)
					CUST.ATM.glSubHeadCode1 = "10701"
					print(CUST.ATM.glSubHeadCode1)
					CUST.ATM.schmCode1 = "CASBC"
					print(CUST.ATM.schmCode1)
					IF ((BANCS.INPUT.DccId == "SWT") or (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId=="WPD") or (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
						IF (CUST.ATM.DeviceId=="MASTPAY") THEN
							IF (BANCS.INPUT.ReservedField1=="FRAISINT") THEN
								IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="ATMWIT"))  THEN
									BANCS.OUTPUT.contraAccount= "15051317030112"
									print(BANCS.OUTPUT.contraAccount)
									GOTO ENDOFSCRIPT
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					IF ((BANCS.INPUT.DccId == "SWT") or (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId=="WPD") or (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
						IF (CUST.ATM.DeviceId=="BSVPAY") THEN
							IF (BANCS.INPUT.ReservedField1=="BSVCOMM") THEN
								IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="ATMWIT"))  THEN
									BANCS.OUTPUT.contraAccount= "15051317030112"
									print(BANCS.OUTPUT.contraAccount)
									GOTO ENDOFSCRIPT
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="POSWITAB"))  THEN
						sv_s = "contra,solidcontra|"
						sv_s = sv_s + " SELECT foracid,sol_id "
						sv_s = sv_s + " FROM GAM "
						sv_s = sv_s + " WHERE acct_short_name = ?SVAR "
						sv_s = sv_s + " AND DEL_FLG ='N' "
						sv_s = sv_s + " AND bank_id = ?SVAR "
						sv_s = sv_s + " AND acct_crncy_code = ?SVAR "
						BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.TranCrncy
						sv_d =urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF  (sv_d == "0") then
							BANCS.OUTPUT.contraAccount = BANCS.OUTPARAM.contra
							print(BANCS.OUTPUT.contraAccount)
							GOTO ENDOFSCRIPT
						ENDIF
					ENDIF
					IF (BANCS.INPUT.ReservedField1=="TOPUP") THEN
						BANCS.OUTPUT.contraAccount ="15051307150169"
						print(BANCS.OUTPUT.contraAccount)
						GOTO ENDOFSCRIPT
					ENDIF
					IF (BANCS.INPUT.ReservedField1=="BSVCOMN") THEN
						BANCS.OUTPUT.contraAccount ="15051317030111"
						print(BANCS.OUTPUT.contraAccount)
						GOTO ENDOFSCRIPT
					ENDIF
				ENDIF
				IF ((BANCS.INPUT.ReservedField2=="ATMDEP") OR (BANCS.INPUT.ReservedField2=="ATMWIT"))  THEN
					sv_s = "contra,solidcontra|"
					sv_s = sv_s + " SELECT foracid,sol_id "
					sv_s = sv_s + " FROM GAM "
					sv_s = sv_s + " WHERE acct_short_name = ?SVAR "
					sv_s = sv_s + " AND gl_sub_head_code in ('10001','10701') "
					sv_s = sv_s + " AND schm_code in ('CASBC','CASH') "
					sv_s = sv_s + " AND acct_ownership='O' "
					sv_s = sv_s + " AND DEL_FLG ='N' "
					sv_s = sv_s + " AND bank_id = ?SVAR "
					sv_s = sv_s + " AND acct_crncy_code = ?SVAR "
					BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.TranCrncy	
					sv_d =urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF  (sv_d == "0") then
						IF (BANCS.INPUT.ReservedField2=="ATMDEP") THEN
							IF ((BANCS.INPUT.DccId == "WPD") AND (BANCS.INPUT.ReservedField2=="ATMDEP"))  THEN
								BANCS.OUTPUT.contraAccount = BANCS.OUTPARAM.contra
								print(BANCS.OUTPUT.contraAccount)
							ELSE
								BANCS.INPUT.Foracid = BANCS.OUTPARAM.contra
								print(BANCS.INPUT.Foracid)
								sv_k = MID$(BANCS.INPUT.DeviceId,0,3)
								print(sv_k)
								IF (sv_k=="EBC") THEN
									IF ((BANCS.INPUT.DccId == "BRK") AND (BANCS.INPUT.ReservedField2=="ATMDEP"))  THEN
										if (fieldexists(BANCS.INPUT.DevType)==1) then
											print(BANCS.INPUT.DevType)
											IF (BANCS.INPUT.DevType=="POS") THEN
												##IF (BANCS.INPUT.Foracid==BANCS.INPUT.CrForacid) THEN
													BANCS.OUTPUT.contraAccount = BANCS.OUTPARAM.contra
													print(BANCS.OUTPUT.contraAccount)
												##ENDIF
											ENDIF
										endif
									ENDIF
								ENDIF
							ENDIF
							GOTO ENDOFSCRIPT
						ENDIF
						IF  (BANCS.INPUT.ReservedField2=="ATMWIT") THEN
							#25/10/2021 Wpd Fix
							if(fieldexists(BANCS.OUTPUT.contraAccount)==1)then
								if ((BANCS.INPUT.DccId=="WPD") AND (BANCS.INPUT.ReservedField2!="ATMWIT")) then
									print(BANCS.OUTPUT.contraAccount)
								else
									BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
									print(BANCS.OUTPUT.contraAccount)
								endif
							else
								BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
								print(BANCS.OUTPUT.contraAccount)
							endif
							#Ends
							IF (BANCS.INPUT.ReservedField1=="CHARGE") THEN
								CUST.ATM.chargecontraGL = "650011485"
								print(CUST.ATM.chargecontraGL)
								CUST.ATM.solidcontra = BANCS.OUTPARAM.solidcontra
								print(CUST.ATM.solidcontra)
								BANCS.OUTPUT.contraAccount = CUST.ATM.solidcontra + CUST.ATM.chargecontraGL 
								print(BANCS.OUTPUT.contraAccount)
							ENDIF
							GOTO ENDOFSCRIPT
						ENDIF
					ELSE
						sv_s = "contra,solidcontra|"
						sv_s = sv_s + " SELECT foracid,sol_id  "
						sv_s = sv_s + " FROM GAM "
						sv_s = sv_s + " WHERE acct_short_name = ?SVAR "
						sv_s = sv_s + " AND gl_sub_head_code= ?SVAR "
						sv_s = sv_s + " AND schm_code= ?SVAR  "
						sv_s = sv_s + " AND acct_ownership='O' "
						sv_s = sv_s + " AND DEL_FLG ='N' "
						sv_s = sv_s + " AND bank_id = ?SVAR "
						sv_s = sv_s + " AND rownum<2 "
						BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceId + "|" + CUST.ATM.glSubHeadCode1 + "|" + CUST.ATM.schmCode1 + "|" + BANCS.STDIN.contextBankId 
						sv_d =urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF  (sv_d == "0") THEN
							IF (BANCS.INPUT.ReservedField2=="ATMDEP") THEN
								BANCS.INPUT.Foracid= BANCS.OUTPARAM.contra
								print(BANCS.INPUT.Foracid)
								GOTO ENDOFSCRIPT
							ENDIF
							IF  (BANCS.INPUT.ReservedField2=="ATMWIT") THEN
								BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
								print(BANCS.OUTPUT.contraAccount)
								IF (BANCS.INPUT.ReservedField1=="CHARGE") THEN
									CUST.ATM.chargecontraGL = "650011485"
									print(CUST.ATM.chargecontraGL)
									IF ((BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
										CUST.ATM.chargecontraGL = "650011485"
										print(CUST.ATM.chargecontraGL)
									ENDIF
									CUST.ATM.solidcontra = BANCS.OUTPARAM.solidcontra
									print(CUST.ATM.solidcontra)
									BANCS.OUTPUT.contraAccount = CUST.ATM.solidcontra + CUST.ATM.chargecontraGL 
									print(BANCS.OUTPUT.contraAccount)
								ENDIF
								GOTO ENDOFSCRIPT
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ELSE
				IF (CUST.ATM.DeviceId=="TERMID01") THEN
					IF (FIELDEXISTS(BANCS.INPUT.ReservedField1)) THEN
						IF (BANCS.INPUT.ReservedField1=="CHARGE") THEN
							GOTO CHARGES
						ELSE
							CUST.ATM.DeviceId="EBL00063"
							print(CUST.ATM.DeviceId)
						ENDIF
					ELSE
						CUST.ATM.DeviceId="EBL00063"
						print(CUST.ATM.DeviceId)
					ENDIF
				ELSE
					IF ((BANCS.INPUT.ReservedField2=="ATMDEP") OR (BANCS.INPUT.ReservedField2=="ATMWIT")) THEN
						CUST.ATM.DeviceId=BANCS.INPUT.DeviceId
						print(CUST.ATM.DeviceId)
					ENDIF						
				ENDIF
			ENDIF
		ENDIF
		IF (BANCS.INPUT.ReservedField2=="VMT") THEN
			print(BANCS.INPUT.ReservedField2)
			BANCS.OUTPUT.contraAccount= BANCS.INPUT.CrForacid
			print(BANCS.OUTPUT.contraAccount)
		ELSE
			IF ((BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
				IF (CUST.ATM.DeviceId=="MASTPAY") THEN
					IF (BANCS.INPUT.ReservedField1=="FRAISINT") THEN
						IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="ATMWIT")) THEN
							BANCS.OUTPUT.contraAccount= "15051317030112"
							print(BANCS.OUTPUT.contraAccount)
							GOTO ENDOFSCRIPT
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			### map new 15000 Gls 
			IF ((CUST.ATM.DeviceId=="VISAPAY") OR (CUST.ATM.DeviceId=="MASTPAY"))  THEN
				CUST.ATM.glSubHeadCode1="30715"
				CUST.ATM.schmCode1="OTHBC"
			ENDIF
			sv_s = "contra|"
			sv_s = sv_s + " SELECT foracid "
			sv_s = sv_s + " FROM tbaadm.GAM "
			sv_s = sv_s + " WHERE acct_short_name = ?SVAR "
			sv_s = sv_s + " AND ((gl_sub_head_code= ?SVAR AND schm_code= ?SVAR )  "
			IF ( (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
				sv_s = sv_s + " OR bacid in ('BCDCBSVREC','BCDCBSVPAY','BCDCMASTUPI','BCDCUPIPAY','BCDCVISAREC','BCDCVISAPAY','BCDCMASTREC','BCDCMASTPAY')) "
			ELSE
				sv_s = sv_s + " OR bacid in ('BULKPAY','BSVREC','BSVPAY','MASTUPI','UPIPAY','VISAREC','VISAPAY','MASTREC','MASTPAY')) "
			ENDIF
			sv_s = sv_s + " AND acct_ownership='O' "
			sv_s = sv_s + " AND DEL_FLG ='N' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND acct_crncy_code = ?SVAR "
			BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceId + "|" + CUST.ATM.glSubHeadCode1 + "|" + CUST.ATM.schmCode1 + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.TranCrncy	
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF  (sv_d == "0") then
				BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
				print(BANCS.OUTPUT.contraAccount)
				if (BANCS.OUTPUT.contraAccount==BANCS.INPUT.Foracid) then
					print("sameeeeeeeeeeeee")
					IF ( (BANCS.INPUT.DccId == "WPD") AND ((BANCS.INPUT.Command=="CDAR") OR (BANCS.INPUT.Command=="CDRR")) ) THEN
						sv_k = MID$(BANCS.INPUT.DeviceId,0,3)
						print(sv_k)
						IF (sv_k=="EBC") THEN
							print("skip")
						ELSE
							BANCS.OUTPUT.contraAccount = BANCS.INPUT.CrForacid
							print(BANCS.OUTPUT.contraAccount)
						ENDIF
					ELSE
						BANCS.OUTPUT.contraAccount = BANCS.INPUT.CrForacid
						print(BANCS.OUTPUT.contraAccount)
					ENDIF
				endif
				IF (BANCS.INPUT.ReservedField2=="POSDEP") THEN
					IF ( (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN"))  THEN
						IF (BANCS.INPUT.CrForacid=="5000300016275") THEN
							BANCS.OUTPUT.contraAccount= "5000300016275"
							print(BANCS.OUTPUT.contraAccount)
							GOTO ENDOFSCRIPT
						ENDIF
					ELSE
						IF (BANCS.INPUT.CrForacid=="5000300016275") THEN
							BANCS.OUTPUT.contraAccount= "5000300016275"
							print(BANCS.OUTPUT.contraAccount)
							GOTO ENDOFSCRIPT
						ENDIF
					ENDIF
				ENDIF

				IF ((FIELDEXISTS(BANCS.INPUT.ReservedField1)) AND (FIELDEXISTS(BANCS.INPUT.DccId)) AND (FIELDEXISTS(BANCS.INPUT.ReservedField2)) AND (FIELDEXISTS(CUST.ATM.DeviceId))) THEN
					IF ((BANCS.INPUT.ReservedField1=="CHARGE") AND (BANCS.INPUT.DccId=="BRK") and (CUST.ATM.DeviceId == "BULKPAY"))  THEN
						CUST.ATM.RFA =BANCS.INPUT.ReservedField2
						CUST.ATM.RFB = mid$(BANCS.INPUT.ReservedField2,0,5)
						CUST.ATM.RFC = mid$(BANCS.INPUT.ReservedField2,5,5)
						PRint (CUST.ATM.RFC)
						PRint (CUST.ATM.RFB)
						IF (CUST.ATM.RFB == "BULK-") THEN
							CUST.ATM.bacidx="RTGSCOMM"
							IF (BANCS.INPUT.TranCrncy!="") THEN
								IF ((BANCS.INPUT.TranCrncy =="USD") or (BANCS.INPUT.TranCrncy =="EUR")) THEN
									CUST.ATM.bacidx="SWIFTCOMM"
									CUST.ATM.solidx = CUST.ATM.RFC
								ELSE
									CUST.ATM.bacidx="RTGSCOMM"
									CUST.ATM.solidx = CUST.ATM.RFC
								ENDIF
							ELSE
								CUST.ATM.bacidx ="RTGSCOMM"
								CUST.ATM.solidx = "15000"
							ENDIF

							CUST.ATM.TranCrncyx = "CDF"
							sv_s = "contra| SELECT foracid FROM tbaadm.GAM "
							sv_s = sv_s + " WHERE  bacid = ?SVAR and acct_ownership='O' "
							sv_s = sv_s + " AND DEL_FLG ='N'  AND bank_id = ?SVAR "
							sv_s = sv_s + " AND acct_crncy_code = ?SVAR and sol_id =?SVAR "
							BANCS.INPARAM.BINDVARS = CUST.ATM.bacidx  + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ATM.TranCrncyx + "|" + CUST.ATM.solidx
							sv_d =urhk_dbSelectWithBind(sv_s)
							print(sv_d)
							IF  (sv_d == "0") then
								BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
								print(BANCS.OUTPUT.contraAccount)
							ENDIF
						ENDIF

					ENDIF
				ENDIF
				GOTO ENDOFSCRIPT
			ELSE
				IF (BANCS.INPUT.ReservedField2=="INTERC") THEN
					BANCS.OUTPUT.contraAccount= BANCS.INPUT.CrForacid
					print(BANCS.OUTPUT.contraAccount)
				ELSE
					## start POS
					IF (BANCS.INPUT.DccId == "MAG") THEN
						IF (BANCS.INPUT.ReservedField1=="CARDFEE") THEN
							IF  (BANCS.INPUT.ReservedField2=="POSWIT") THEN
								CUST.ATM.glSubHeadCode1="31703"
								print(CUST.ATM.glSubHeadCode1)
								CUST.ATM.schmCode1="OTHBC"
								print(CUST.ATM.schmCode1)
							ENDIF
						ENDIF
					ENDIF
					## end POS
					####### added chalres bacid and currency issues
					CUST.ATM.DeviceIdPosFlg="N"
					print(CUST.ATM.DeviceIdPosFlg)
					IF ((BANCS.INPUT.DccId == "WPD") OR (BANCS.INPUT.DccId == "BRK")) THEN
						IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="POSDEP") OR (BANCS.INPUT.ReservedField2=="CBCWAY4")) THEN
							sv_k = MID$(BANCS.INPUT.DeviceId,0,3)
							print(sv_k)
							IF (sv_k=="EBC") THEN
								CUST.ATM.DeviceIdPosFlg = "Y"
								print(CUST.ATM.DeviceIdPosFlg)
							ENDIF
						ENDIF
					ENDIF
					IF ((BANCS.INPUT.DccId == "SWT") OR (CUST.ATM.DeviceIdPosFlg=="Y")) THEN
						sv_s = "contra|"
						sv_s = sv_s + " SELECT foracid "
						sv_s = sv_s + " FROM tbaadm.GAM "
						sv_s = sv_s + " WHERE acct_short_name = ?SVAR "
						##sv_s = sv_s + " AND gl_sub_head_code= ?SVAR AND schm_code= ?SVAR   "
						sv_s = sv_s + " AND acct_ownership='O' "
						sv_s = sv_s + " AND DEL_FLG ='N' "
						sv_s = sv_s + " AND bank_id = ?SVAR "
						IF (CUST.ATM.DeviceIdPosFlg=="Y") THEN
							sv_s = sv_s + " AND acct_crncy_code = ?SVAR "
							sv_s = sv_s + " AND rownum<2 "
							BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.TranCrncy
							print(BANCS.INPARAM.BINDVARS)
							sv_d =urhk_dbSelectWithBind(sv_s)
							print(sv_d)
						ELSE
							###sv_s = sv_s + " AND acct_crncy_code = ?SVAR "
							sv_s = sv_s + " AND rownum<2 "
							BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceId + "|" + BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_d =urhk_dbSelectWithBind(sv_s)
							print(sv_d)
						ENDIF
					ELSE
						sv_s = "contra|"
						sv_s = sv_s + " SELECT foracid "
						sv_s = sv_s + " FROM tbaadm.GAM "
						sv_s = sv_s + " WHERE acct_short_name = ?SVAR "
						sv_s = sv_s + " AND gl_sub_head_code= ?SVAR AND schm_code= ?SVAR   "
						sv_s = sv_s + " AND acct_ownership='O' "
						sv_s = sv_s + " AND DEL_FLG ='N' "
						sv_s = sv_s + " AND bank_id = ?SVAR "
						sv_s = sv_s + " AND rownum<2 "
						BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceId + "|" + CUST.ATM.glSubHeadCode1 + "|" + CUST.ATM.schmCode1 + "|" + BANCS.STDIN.contextBankId
						sv_d =urhk_dbSelectWithBind(sv_s)
						print(sv_d)
					ENDIF
					IF  (sv_d == "0") then
						BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
						print(BANCS.OUTPUT.contraAccount)
						GOTO ENDOFSCRIPT	
					ELSE
						IF (BANCS.INPUT.CrForacid!="") THEN
							IF (BANCS.INPUT.DccId == "MAG") THEN
								IF  (BANCS.INPUT.ReservedField2=="ATMWIT") THEN
									IF (BANCS.INPUT.ReservedField1=="CARDFEE") THEN
										IF (FIELDEXISTS(BANCS.INPUT.TranCrncy)) THEN
											IF (BANCS.INPUT.TranCrncy=="USD") THEN
												BANCS.OUTPUT.contraAccount = "15051317030114"
												print(BANCS.OUTPUT.contraAccount)
												GOTO ENDOFSCRIPT
											ENDIF
											IF (BANCS.INPUT.TranCrncy=="CDF") THEN
												BANCS.OUTPUT.contraAccount = "15051317030029"
												print(BANCS.OUTPUT.contraAccount)
												GOTO ENDOFSCRIPT
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
							BANCS.OUTPUT.contraAccount= BANCS.INPUT.CrForacid
							print(BANCS.OUTPUT.contraAccount)
						ELSE
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.successOrFailure = "F"
							GOTO ENDOFSCRIPT
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF (BANCS.INPUT.Command!="CDAR") THEN
			IF ((BANCS.INPUT.CrForacid !="") AND (mid$(BANCS.INPUT.ReservedField2,0,8)!="VODAFONE"))  THEN
				print("Transafer")
				BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
			ENDIF
		ENDIF
	ENDIF
	
#----Incusion for AIRTEL MONEY
	IF (BANCS.INPUT.DccId == "AIR") THEN
