			ENDIF
			IF (FIELDEXISTS(BANCS.INPUT.Foracid)==1) THEN
				IF (BANCS.INPUT.Foracid=="VODAFONE") THEN
					GOTO ENDOFSCRIPT3
				ENDIF
			ENDIF
			IF (FIELDEXISTS(BANCS.INPUT.Foracid)==1) THEN
				IF (BANCS.INPUT.Foracid!="") THEN
					CUST.ATM.DebitAccount = BANCS.INPUT.Foracid
					print(CUST.ATM.DebitAccount)
				ELSE
					IF (FIELDEXISTS(BANCS.OUTPUT.contraAccount)==1) THEN
						IF (BANCS.OUTPUT.contraAccount!="") THEN
							CUST.ATM.DebitAccount = BANCS.OUTPUT.contraAccount
							print(CUST.ATM.DebitAccount)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF (FIELDEXISTS(CUST.ATM.DebitAccount)==1) THEN
				print(CUST.ATM.DebitAccount)
				sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.DebitAccount)
				IF (sv_u != 0) THEN
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					print("line 1063") 
					GOTO ENDOFSCRIPT3
				ELSE
					CUST.ATM.Debitcurrency = BANCS.OUTPARAM.acctCrncyCode
					print(CUST.ATM.Debitcurrency)
				ENDIF
			ENDIF
			IF (FIELDEXISTS(BANCS.INPUT.CrForacid)==1) THEN
				IF (BANCS.INPUT.CrForacid!="") THEN
					CUST.ATM.CreditAccount = BANCS.INPUT.CrForacid
					print(CUST.ATM.CreditAccount)
					IF ((BANCS.INPUT.CrForacid=="5000300151606") OR (BANCS.INPUT.CrForacid=="5000300151607")) THEN
						IF (FIELDEXISTS(BANCS.OUTPUT.contraAccount)==1) THEN
							IF (BANCS.OUTPUT.contraAccount!="") THEN
								CUST.ATM.CreditAccount = BANCS.OUTPUT.contraAccount
								print(CUST.ATM.CreditAccount)
							ENDIF
						ENDIF
					ENDIF
				ELSE
					IF (FIELDEXISTS(BANCS.OUTPUT.contraAccount)==1) THEN
						IF (BANCS.OUTPUT.contraAccount!="") THEN
							CUST.ATM.CreditAccount = BANCS.OUTPUT.contraAccount
							print(CUST.ATM.CreditAccount)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF (FIELDEXISTS(CUST.ATM.CreditAccount)==1) THEN
			#{
				IF (CUST.ATM.CreditAccount != "" ) THEN
				 #{
