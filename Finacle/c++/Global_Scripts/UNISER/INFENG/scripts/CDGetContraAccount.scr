				print(BANCS.OUTPUT.contraAccount)
				GOTO ENDOFSCRIPT
			ENDIF
		#}
		ENDIF
	#}		
	ENDIF
	

	#### for getting contra account for TOD req #####
	IF (MID$(BANCS.INPUT.ReservedField2,0,15) == "AUTOTODAVAILREQ") THEN
        IF ((BANCS.INPUT.DccId == "SWT") OR (BANCS.INPUT.DccId == "BWY"))THEN
			IF ( (BANCS.INPUT.Command == "DBTR") OR(BANCS.INPUT.Command == "TRTR") ) THEN
				sv_s = "todcontraacctnum| "
				sv_s = sv_s + " SELECT foracid "
				sv_s = sv_s + " FROM GAM "
				sv_s = sv_s + " WHERE bacid = ?SVAR  "
				sv_s = sv_s + " AND sol_id = ?SVAR"
                sv_s = sv_s + " AND acct_ownership = 'O' "
				sv_s = sv_s + " AND acct_cls_flg = 'N' "
				sv_s = sv_s + " AND del_flg ='N'"
				sv_s = sv_s + " AND bank_id = ?SVAR "
				sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
                print(sv_s)
				
				BANCS.INPARAM.BINDVARS = CUST.ATM.bacid5 + "|" + BANCS.INPUT.SolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode

                sv_d = urhk_dbSelectWithBind(sv_s)
                print(sv_d)
                print(BANCS.OUTPARAM.todcontraacctnum)
				
				IF (sv_d == "0") then
					BANCS.OUTPUT.contraAccount = trim(BANCS.OUTPARAM.todcontraacctnum)
                    print(BANCS.OUTPUT.contraAccount)
                    GOTO ENDOFSCRIPT
				ENDIF
