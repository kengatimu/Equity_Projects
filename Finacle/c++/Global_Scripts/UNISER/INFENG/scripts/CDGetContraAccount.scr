IF ((BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "OMK") OR (BANCS.INPUT.DccId == "WYM")) THEN
	IF ((BANCS.INPUT.ReservedField2 == "BalEnq") OR (BANCS.INPUT.ReservedField2 == "TOPUPDATA") OR (BANCS.INPUT.ReservedField2 == "TOPUPMC") OR (BANCS.INPUT.ReservedField2 == "MinStat") OR (BANCS.INPUT.ReservedField2 == "CommAlert")) THEN 
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
		IF (sv_u != 0) THEN
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		ELSE
			CUST.ATM.solid = BANCS.OUTPARAM.acctSolId

		ENDIF

		IF ((BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "WYM")) THEN
			IF ((BANCS.INPUT.ReservedField2=="TOPUPMC") OR (BANCS.INPUT.ReservedField2=="TOPUPDATA")) THEN
				CUST.ATM.bacid = "FINSERAIRTIME"
				print(CUST.ATM.bacid)
			ENDIF
		ENDIF
		print(CUST.ATM.solid)
		sv_s = "contra|"
		sv_s = sv_s + " SELECT foracid "
		sv_s = sv_s + " FROM GAM "
		sv_s = sv_s + " WHERE sol_id = ?SVAR"
		sv_s = sv_s + " AND bacid = ?SVAR "
		sv_s = sv_s + " AND del_flg ='N' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
		sv_d =urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == "0") THEN
			BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
			BANCS.OUTPUT.successOrFailure = "S"
			GOTO ENDOFSCRIPT
		ELSE
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.ATM.Command = BANCS.INPUT.Command
		IF ( (CUST.ATM.Command=="TRRR") OR (CUST.ATM.Command=="PCRR") OR (CUST.ATM.Command=="TRTR") OR (CUST.ATM.Command=="PCLR") OR (CUST.ATM.Command=="PRCR") OR (CUST.ATM.Command=="PRRR") OR (CUST.ATM.Command=="CWDR") OR (CUST.ATM.Command=="CWRR") or (CUST.ATM.Command=="DBTR") OR (CUST.ATM.Command=="DBRR")) THEN
			BANCS.OUTPUT.contraAccount = BANCS.INPUT.CrForacid
			print(BANCS.OUTPUT.contraAccount)
			BANCS.OUTPUT.successOrFailure = "S"
		ENDIF
		IF ((CUST.ATM.Command=="CDAR")OR (CUST.ATM.Command=="CDRR")) THEN
			BANCS.OUTPUT.contraAccount =  BANCS.INPUT.Foracid
		ENDIF			
	ENDIF
	IF ((BANCS.INPUT.ReservedField2 =="ATMWd") OR (BANCS.INPUT.ReservedField2 =="OMATMWITH")) THEN
		#--- ATM withdarwal 
		sv_s = "contra|"
		sv_s = sv_s + " SELECT foracid "
		sv_s = sv_s + " FROM GAM "
		sv_s = sv_s + " WHERE acct_short_name = ?SVAR"
		sv_s = sv_s + " AND gl_sub_head_code = ?SVAR "
		sv_s = sv_s + " AND schm_code = ?SVAR "
		sv_s = sv_s + " AND acct_ownership = 'O' "
		sv_s = sv_s + " AND del_flg ='N' "
		sv_s = sv_s + " AND bank_id =  ?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId +"|" + CUST.ATM.glSubHeadCode1 + "|" + CUST.ATM.schmCode1 + "|" + BANCS.STDIN.contextBankId
		sv_d =urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF  (sv_r == "0") then
			BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
			print(BANCS.OUTPUT.contraAccount)
		ELSE
			
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
				
		ENDIF
		
	ENDIF
	
ENDIF

