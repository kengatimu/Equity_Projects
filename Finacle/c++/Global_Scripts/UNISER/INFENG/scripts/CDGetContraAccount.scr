				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ENDIF
		ELSE
			CUST.ATM.Command = BANCS.INPUT.Command
			IF ( (CUST.ATM.Command=="TRTR") OR (CUST.ATM.Command=="PRCR") OR (CUST.ATM.Command=="PRRR") OR (CUST.ATM.Command=="CWDR") OR (CUST.ATM.Command=="CWRR") or (CUST.ATM.Command=="DBTR") OR (CUST.ATM.Command=="DBRR")) THEN
