print(sv_k)
IF (sv_k=="MPC") THEN
	CUST.ATM.freetextIND="DRCMER"
	print(CUST.ATM.freetextIND)
	CUST.ATM.way4brkmerchant="Y"
	print(CUST.ATM.way4brkmerchant)
	CUST.ATM.way4brkmerchantdd="Y"
	print(CUST.ATM.way4brkmerchantdd)
ENDIF
CUST.ATM.solidagtsoltax = "N"
IF (BANCS.INPUT.DccId=="BRK") THEN
	CUST.ATM.solidagtsoltax = "N"
	IF ((BANCS.INPUT.ReservedField2=="AGENCYBANKINGGENERIC") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGSCHOOL") OR (BANCS.INPUT.ReservedField2=="DGRKBILLPYT") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGTAX") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGCASHOUT")) THEN
		CUST.ATM.solidagtsoltax = "Y"
		print(CUST.ATM.solidagtsoltax)
	ENDIF
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1) THEN
		IF ((BANCS.INPUT.ReservedField2=="CASHIN") OR (BANCS.INPUT.ReservedField2=="CASHOUT") OR (CUST.ATM.solidagtsoltax == "Y")) THEN
			CUST.ATM.freetextIND="DRCMOB"
			print(CUST.ATM.freetextIND)
			CUST.ATM.way4brkmerchant="Y"
			print(CUST.ATM.way4brkmerchant)
			IF (FIELDEXISTS(BANCS.INPUT.ReservedField1) == 1) THEN
				CUST.ATM.DeviceIdagtt=BANCS.INPUT.ReservedField1
				print(CUST.ATM.DeviceIdagtt)
			ENDIF
			CUST.ATM.way4brkmerchantdd="Y"
			print(CUST.ATM.way4brkmerchantdd)
		ENDIF
	ENDIF
