IF (BANCS.INPUT.DccId == "HPD") THEN
	IF (BANCS.INPUT.CrForacid !="") THEN
		BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
	ELSE
		IF (BANCS.INPUT.Command=="PRCR") THEN	
			sv_s = "channel,purPayable,settAccount|"
			sv_s = sv_s + " SELECT channel_id,merch_purchase_payable,merch_settlement_account"
			sv_s = sv_s + " FROM CUSTOM.C_MERCHANTS"
			sv_s = sv_s + " WHERE merchant_id = ?SVAR"
			sv_s = sv_s + " AND del_flg ='N' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|" +BANCS.STDIN.contextBankId
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF  (sv_d == "0") then
				BANCS.OUTPUT.CHANNEL= BANCS.OUTPARAM.channel
				BANCS.OUTPUT.PURPAYABLE= BANCS.OUTPARAM.purPayable
				BANCS.OUTPUT.SETTACCOUNT= BANCS.OUTPARAM.settAccount
				
				IF (BANCS.OUTPUT.CHANNEL=="CLD") THEN
					BANCS.OUTPUT.contraAccount= CUST.ATM.contraAcct2
				ELSE
					BANCS.OUTPUT.contraAccount= BANCS.OUTPUT.PURPAYABLE
				ENDIF
				print(BANCS.OUTPUT.contraAccount)

			ELSE
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ENDIF

		ENDIF
		IF ((BANCS.INPUT.Command=="CWDR") OR (BANCS.INPUT.Command=="CWRR")) THEN
			IF (BANCS.INPUT.CrForacid !="") THEN
				BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
			ELSE
				IF (BANCS.INPUT.ReservedField2!="INTERC") THEN
					sv_s = "contra|"
					sv_s = sv_s + " SELECT merch_cashback_payable"
					sv_s = sv_s + " FROM CUSTOM.C_MERCHANTS "
					sv_s = sv_s + " WHERE merchant_id = ?SVAR"
					sv_s = sv_s + " AND del_flg ='N' "
					sv_s = sv_s + " AND bank_id = ?SVAR "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|" + BANCS.STDIN.contextBankId
					sv_d =urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF  (sv_d == "0") then
						BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
						print(BANCS.OUTPUT.contraAccount)
					ELSE
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					ENDIf
					
				
				ENDIF
			ENDIF
		
		ENDIF

		IF (BANCS.INPUT.Command=="PRRR") THEN
			IF (BANCS.INPUT.ReservedField2!="INTERC") THEN
				sv_z= mid$(BANCS.INPUT.OrigDataElements,0,4)
				print(sv_z)
				IF (sv_z=="CWDR") THEN
					sv_s = "contra| "
					sv_s = sv_s + " SELECT merch_cashback_payable"
					sv_s = sv_s + " FROM CUSTOM.C_MERCHANTS "
					sv_s = sv_s + " WHERE merchant_id = ?SVAR"
					sv_s = sv_s + " AND del_flg ='N' "
					sv_s = sv_s + " AND bank_id = ?SVAR "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|" + BANCS.STDIN.contextBankId
					sv_d = urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF  (sv_d == "0") then
						BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
						print(BANCS.OUTPUT.contraAccount)
					ELSE
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					ENDIF

				ELSE
					sv_s = "channel,purPayable,settAccount|"
					sv_s = sv_s + " SELECT channel_id,merch_purchase_payable,merch_settlement_account"
					sv_s = sv_s + " FROM CUSTOM.C_MERCHANTS"
					sv_s = sv_s + " WHERE merchant_id = ?SVAR"
					sv_s = sv_s + " AND del_flg ='N' "
					sv_s = sv_s + " AND bank_id = ?SVAR "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|" + BANCS.STDIN.contextBankId
					sv_d =urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF  (sv_d == "0") then
						BANCS.OUTPUT.CHANNEL= BANCS.OUTPARAM.channel
						BANCS.OUTPUT.PURPAYABLE= BANCS.OUTPARAM.purPayable
						BANCS.OUTPUT.SETTACCOUNT= BANCS.OUTPARAM.settAccount
					
						IF (BANCS.OUTPUT.CHANNEL=="CLD") THEN
							BANCS.OUTPUT.contraAccount= CUST.ATM.contraAcct2
						ELSE
							BANCS.OUTPUT.contraAccount= BANCS.OUTPUT.PURPAYABLE
						ENDIF
						print(BANCS.OUTPUT.contraAccount)

					ELSE
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					ENDIF
				ENDIF
			ELSE
				BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
			ENDIF
		ENDIF
	ENDIF
ENDIF
