			BANCS.OUTPUT.ReservedField3 = "Suspense/Office GL Posting not allowed"
			print(BANCS.OUTPUT.ReservedField3)
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			exitscript
		ENDIF
	ENDIF
ENDIF
#### stop suspense end
CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
IF(CUST.ATM.Get == 0 ) THEN
