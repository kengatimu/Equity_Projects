							sv_s = sv_s + " AND GAM.acct_cls_flg!='Y'"
							sv_s = sv_s + " AND agent_code = ?SVAR"
							sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
							sv_s = sv_s + " AND AGT.del_flg !='Y' and agt.FREE_TEXT= ?SVAR and gam.foracid= ?SVAR and rownum<2"
							print(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceIdagtt + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.ATM.freetextIND + "|" + CUST.ATM.agentaccountcheck
							sv_d =urhk_dbSelectWithBind(sv_s)
							print(sv_d)
							IF (sv_d == "0") THEN
								CUST.ATM.Agentaccount=BANCS.OUTPARAM.account
								print(CUST.ATM.Agentaccount)
								GOTO ENDOFSCRIPTAGT
							ENDIF
							#####
							IF (CUST.ATM.agentaccountcheck!= CUST.ATM.Agentaccount) THEN
								########## start insert
								print(BANCS.INPUT.Foracid)
								print(BANCS.INPUT.CrForacid)
								sv_e = mid$(BANCS.STDIN.BODDate,0,10)
								print(sv_e)
								sv_s = "sysdatedrc|"
