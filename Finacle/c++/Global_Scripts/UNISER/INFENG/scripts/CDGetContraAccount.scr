#----Incusion for ATM

	BANCS.INPUT.moduleName  = "ATM"
	BANCS.INPUT.parameterId = "GL_SUB_HEAD_1"
	
	CALL ("atmgetcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ATM.glSubHeadCode1 = BANCS.OUTPUT.parameterVal
