							CUST.ATM.transactiontype="C"
							print(CUST.ATM.transactiontype)
						ENDIF
						sv_q = " FXratecode| select CUSTOM.RETURN_FX_RATE_CODE(?SVAR,?SVAR,?SVAR,?SVAR) from dual"
						print(sv_q)
						BANCS.INPARAM.BINDVARS=CUST.ATM.Debitcurrency + "|" + CUST.ATM.creditcurrency + "|" + CUST.ATM.transactiontype + "|" + BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						sv_w=urhk_dbSelectWithBind(sv_q)
						print(sv_w)
						IF ( sv_w != 0 ) then
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
							print(BANCS.OUTPUT.ReservedField3)
							BANCS.OUTPUT.successOrFailure="F"
							exitscript
						ELSE
							CUST.ATM.FXratecode = BANCS.OUTPARAM.FXratecode
							print(CUST.ATM.FXratecode)
							IF (CUST.ATM.FXratecode=="") THEN
								BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
								print(BANCS.OUTPUT.ReservedField3)
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure = "F"
								GOTO ENDOFSCRIPT3
							ENDIF
							CUST.ATM.RateCodeC ="CDCI_RATE_CODE|"
							CUST.ATM.RateCode = CUST.ATM.RateCodeC + CUST.ATM.FXratecode
							print(CUST.ATM.RateCode)
							CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
							print(CUST.ATM.Put)
							CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
							IF(CUST.ATM.Get == 0 ) THEN
