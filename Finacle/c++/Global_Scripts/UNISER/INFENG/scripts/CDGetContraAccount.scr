			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.ATM.bacid5 + "|" 
			if (BANCS.INPUT.Command == "CWDR") THEN
			#{
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.INPUT.SolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
			#}
			ELSE
			#{
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS	+ BANCS.INPUT.CrSolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
			#}
			ENDIF
			sv_d = urhk_dbSelectWithBind(sv_s)
