	#### for getting contra account for CHANENL req #####
	IF ((BANCS.INPUT.DccId == "COR"))THEN
	#}
		IF ( (BANCS.INPUT.Command == "CWDR") OR (CUST.ATM.Command=="CDAR")) THEN
		#{
			sv_s = "corcontraacctnum| "
			sv_s = sv_s + " SELECT foracid "
			sv_s = sv_s + " FROM GAM "
			sv_s = sv_s + " WHERE bacid = ?SVAR  "
