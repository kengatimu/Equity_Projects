sv_k = MID$(BANCS.INPUT.DeviceId,0,4)
print(sv_k)
IF (sv_k=="COAB") THEN
	CUST.ATM.freetextIND="DRCAGT"
	print(CUST.ATM.freetextIND)
	CUST.ATM.way4brkmerchant="Y"
	print(CUST.ATM.way4brkmerchant)
	CUST.ATM.way4brkmerchantdd="Y"
	print(CUST.ATM.way4brkmerchantdd)
ENDIF

IF ( ((BANCS.INPUT.DccId == "WPD") OR (CUST.ATM.way4brkmerchant=="Y")) AND (CUST.ATM.way4brkmerchantdd=="Y")) THEN
	CUST.ATM.TranCrncyagt = BANCS.STDIN.homeCrncyCode
	print(CUST.ATM.TranCrncyagt)
	IF (BANCS.INPUT.TranCrncy!="") THEN
		CUST.ATM.TranCrncyagt = BANCS.INPUT.TranCrncy
		print(CUST.ATM.TranCrncyagt)
	ELSE
		CUST.ATM.TranCrncyagt = BANCS.STDIN.homeCrncyCode
		print(CUST.ATM.TranCrncyagt)
	ENDIF
	sv_s = "sol_id,account,agentpintype|"
	sv_s = sv_s + " SELECT agt.sol_id,gam.foracid,AGENT_PIN "
	sv_s = sv_s + " FROM tbaadm.AGT,tbaadm.GAM "
	sv_s = sv_s + " WHERE AGT.OPER_CREDIT_ACID=GAM.acid "
	sv_s = sv_s + " AND GAM.acct_cls_flg!='Y'"
	sv_s = sv_s + " AND agent_code = ?SVAR"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND AGT.del_flg !='Y' and agt.FREE_TEXT= ?SVAR and agt.CRNCY_CODE= ?SVAR and rownum<2"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceIdagtt + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.ATM.freetextIND + "|" + CUST.ATM.TranCrncyagt
	sv_d =urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF  (sv_d == "0") then
		CUST.ATM.Agentaccount=BANCS.OUTPARAM.account
		print(CUST.ATM.Agentaccount)
		CUST.ATM.agentpintype=BANCS.OUTPARAM.agentpintype
		print(CUST.ATM.agentpintype)

		IF (CUST.ATM.agentpintype=="WAY4AGENT") THEN
			IF ((BANCS.OUTPUT.contraAccount=="5000300016260") OR (BANCS.OUTPUT.contraAccount=="15000147033332") OR (BANCS.OUTPUT.contraAccount=="15000197010024") OR (BANCS.OUTPUT.contraAccount=="5000300151607") OR (BANCS.OUTPUT.contraAccount=="5000300151606") OR (BANCS.OUTPUT.contraAccount=="XXXXXXXXXX") OR (BANCS.OUTPUT.contraAccount=="5000300016262") OR (BANCS.OUTPUT.contraAccount=="5000300016261") OR (BANCS.OUTPUT.contraAccount=="15051137050001") OR (BANCS.OUTPUT.contraAccount=="15051137050002") OR (BANCS.INPUT.ReservedField2=="CBCWAY4")) THEN
				BANCS.OUTPUT.contraAccount = CUST.ATM.Agentaccount
				print(BANCS.OUTPUT.contraAccount)
			ENDIF
			sv_y=BANCS.INPUT.ReservedField2
			print (sv_y)
			sv_c=mid$(sv_y,0,5)
			print(sv_c)
			sv_k = MID$(BANCS.INPUT.DeviceId,0,4)
			print(sv_k)
			IF (sv_k=="COAB") THEN
				print(BANCS.INPUT.Foracid)
				print(BANCS.INPUT.CrForacid)
				IF ((sv_c=="ACCT:") OR (sv_c=="BILL:")) THEN
					sv_s = " solidagtway4,accountagtway4 "
					sv_s = sv_s + " | "
					sv_s = sv_s + " SELECT agt.sol_id,gam.foracid "
					sv_s = sv_s + " FROM AGT,GAM "
					sv_s = sv_s + " WHERE AGT.OPER_CREDIT_ACID = GAM.acid "
					sv_s = sv_s + " AND GAM.acct_cls_flg != 'Y'"
					sv_s = sv_s + " AND Agent_code = ?SVAR "
					sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
					sv_s = sv_s + " AND AGT.del_flg !='Y' and gam.foracid = ?SVAR and rownum<2 "
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.Foracid
					print(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					print(sv_s)
					IF (sv_d== "0") THEN
					#{
						CUST.ATM.solidagtway4= BANCS.OUTPARAM.solidagtway4
						print(CUST.ATM.solidagtway4)
						CUST.ATM.accountagtway4= BANCS.OUTPARAM.accountagtway4
						print(CUST.ATM.accountagtway4)
					#}
					ELSE
						print(BANCS.INPUT.Foracid)
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						BANCS.OUTPUT.ReservedField3="Agent and Debit accounts differs check Maintainance in finacle HAGTM "
						exitscript
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		sv_k = MID$(BANCS.INPUT.DeviceId,0,3)
		print(sv_k)
		IF (sv_k=="MPC") THEN
			BANCS.OUTPUT.contraAccount = CUST.ATM.Agentaccount
			print(BANCS.OUTPUT.contraAccount)
		ENDIF
		IF ((BANCS.INPUT.ReservedField2=="CASHIN") OR (BANCS.INPUT.ReservedField2=="CASHOUT")) THEN
			sv_r=mid$(BANCS.INPUT.Command,2,4)
			print(sv_r)
			IF (sv_r!="RR") THEN
				IF (FIELDEXISTS(BANCS.INPUT.CrForacid) == 1) THEN
					print(BANCS.INPUT.CrForacid)
					IF (BANCS.INPUT.CrForacid!="") THEN
						IF (BANCS.INPUT.DccId != "WPD") THEN
							CUST.ATM.agentaccountcheck = BANCS.INPUT.CrForacid
							print(CUST.ATM.agentaccountcheck)
							IF (BANCS.INPUT.ReservedField2=="CASHIN") THEN
								CUST.ATM.agentaccountcheck = BANCS.INPUT.Foracid
								print(CUST.ATM.agentaccountcheck)
							ENDIF
							IF (BANCS.INPUT.ReservedField2=="CASHOUT") THEN
								CUST.ATM.agentaccountcheck = BANCS.INPUT.CrForacid
								print(CUST.ATM.agentaccountcheck)
							ENDIF
							#####
							sv_s = "sol_id,account|"
							sv_s = sv_s + " SELECT agt.sol_id,gam.foracid "
							sv_s = sv_s + " FROM tbaadm.AGT,tbaadm.GAM "
