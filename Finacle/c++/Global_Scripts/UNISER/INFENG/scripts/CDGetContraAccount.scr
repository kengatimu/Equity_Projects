								sv_s = sv_s + " FROM DUAL"
								BANCS.INPARAM.BINDVARS = sv_e
								sv_d = urhk_dbSelectWithBind(sv_s)
								print(sv_d)
								IF (sv_d =="0") THEN
									CUST.ATM.sysdatedrc = BANCS.OUTPARAM.sysdatedrc
									print(CUST.ATM.sysdatedrc)
								ENDIF
								print(BANCS.STDIN.contextBankId)
								print(BANCS.INPUT.DeviceId)
								print(BANCS.INPUT.ReservedField3)
								print(CUST.ATM.TranCrncyagt)
								CUST.ATM.delflgdrc = "N"
								print(CUST.ATM.delflgdrc)
								print(BANCS.INPUT.ReservedField1)
								print(BANCS.INPUT.ReservedField2)
								sv_s = " INSERT INTO "
								sv_s = sv_s + " CUSTOM.C_POS_NONE_AGENTS "
								sv_s = sv_s + " ( "
								sv_s = sv_s + " CR_ACCOUNT_NO, "
								sv_s = sv_s + " DR_ACCOUNT_NO, "
								sv_s = sv_s + " TRAN_DATE_TIME, "
								sv_s = sv_s + " BANK_ID, "
								sv_s = sv_s + " TRAN_CRNCY,"
								sv_s = sv_s + " DEVICEID,"
								sv_s = sv_s + " RRN,"
								sv_s = sv_s + " FIELD125,"
								sv_s = sv_s + " FIELD126,"
								sv_s = sv_s + " CHANNELID,"
								sv_s = sv_s + " DEL_FLG ) "
								sv_s = sv_s + " values "
								sv_s = sv_s + " ( "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR )"
								print(sv_s)
								BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid +"|"+ BANCS.INPUT.Foracid +"|"+CUST.ATM.sysdatedrc+"|"+BANCS.STDIN.contextBankId+"|"+CUST.ATM.TranCrncyagt+"|"+BANCS.INPUT.DeviceId+"|"+BANCS.INPUT.ReservedField3 +"|"+ BANCS.INPUT.ReservedField1 +"|"+BANCS.INPUT.ReservedField2 +"|"+ BANCS.INPUT.DccId  +"|"+ CUST.ATM.delflgdrc
								print(BANCS.INPARAM.BINDVARS)
								sv_d = urhk_dbSqlWithBind(sv_s)		
								If (sv_d == 0) then
								#{
									sv_d = urhk_dbSqlWithBind("COMMIT")
									print(sv_d)
								#}
								endif
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure = "F"
								BANCS.OUTPUT.ReservedField3="Agent and Credit accounts differs check Maintainance in finacle HAGTM/QUIPU "
								exitscript
								########## end insert
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ELSE
		########## start insert
		CUST.ATM.TranCrncyagt = BANCS.STDIN.homeCrncyCode
		print(CUST.ATM.TranCrncyagt)
		IF (BANCS.INPUT.TranCrncy!="") THEN
			CUST.ATM.TranCrncyagt = BANCS.INPUT.TranCrncy
			print(CUST.ATM.TranCrncyagt)
		ELSE
			CUST.ATM.TranCrncyagt = BANCS.STDIN.homeCrncyCode
			print(CUST.ATM.TranCrncyagt)
		ENDIF
		print(BANCS.INPUT.Foracid)
		print(BANCS.INPUT.CrForacid)
		sv_e = mid$(BANCS.STDIN.BODDate,0,10)
		print(sv_e)
		sv_s = "sysdatedrc|"
		sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') "
		sv_s = sv_s + " FROM DUAL"
		BANCS.INPARAM.BINDVARS = sv_e
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
			CUST.ATM.sysdatedrc = BANCS.OUTPARAM.sysdatedrc
			print(CUST.ATM.sysdatedrc)
		ENDIF
		print(BANCS.STDIN.contextBankId)
		print(BANCS.INPUT.DeviceId)
		print(BANCS.INPUT.ReservedField3)
		print(CUST.ATM.TranCrncyagt)
		CUST.ATM.delflgdrc = "N"
		print(CUST.ATM.delflgdrc)
		print(BANCS.INPUT.ReservedField1)
		print(BANCS.INPUT.ReservedField2)
		sv_s = " INSERT INTO "
		sv_s = sv_s + " CUSTOM.C_POS_NONE_AGENTS "
		sv_s = sv_s + " ( "
		sv_s = sv_s + " CR_ACCOUNT_NO, "
		sv_s = sv_s + " DR_ACCOUNT_NO, "
		sv_s = sv_s + " TRAN_DATE_TIME, "
		sv_s = sv_s + " BANK_ID, "
		sv_s = sv_s + " TRAN_CRNCY,"
		sv_s = sv_s + " DEVICEID,"
		sv_s = sv_s + " RRN,"
		sv_s = sv_s + " FIELD125,"
		sv_s = sv_s + " FIELD126,"
		sv_s = sv_s + " CHANNELID,"
		sv_s = sv_s + " DEL_FLG ) "
		sv_s = sv_s + " values "
		sv_s = sv_s + " ( "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR )"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid +"|"+ BANCS.INPUT.Foracid +"|"+CUST.ATM.sysdatedrc+"|"+BANCS.STDIN.contextBankId+"|"+CUST.ATM.TranCrncyagt+"|"+BANCS.INPUT.DeviceId+"|"+BANCS.INPUT.ReservedField3 +"|"+ BANCS.INPUT.ReservedField1 +"|"+BANCS.INPUT.ReservedField2 +"|"+ BANCS.INPUT.DccId  +"|"+ CUST.ATM.delflgdrc
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSqlWithBind(sv_s)		
		If (sv_d == 0) then
		#{
			sv_d = urhk_dbSqlWithBind("COMMIT")
			print(sv_d)
		#}
		endif
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.ReservedField3="Please Maintain Agent/Merchant in finacle HAGTM "
		exitscript
		########## end insert
	ENDIF
ENDIF

ENDOFSCRIPTAGT:

### THUNESOUTBOUND start
IF (BANCS.INPUT.DccId=="BRK") THEN
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)==1) THEN
		IF (BANCS.INPUT.ReservedField2=="THUNESOUTBOUND") THEN
			BANCS.OUTPUT.contraAccount="5000130013342"
			print(BANCS.OUTPUT.contraAccount)
		ENDIF
	ENDIF
ENDIF
### THUNESOUTBOUND start
#############
##--- FX transactions blocking to use TTS,TTB and CNB and CNS  start 
IF ((BANCS.INPUT.DccId != "SWT") AND (BANCS.INPUT.DccId != "CUP") AND (BANCS.INPUT.DccId != "BS1") AND (BANCS.INPUT.DccId != "AME") AND (BANCS.INPUT.DccId != "MC1") AND (BANCS.INPUT.DccId!= "EFR") ) THEN
	IF ((BANCS.INPUT.Command=="CDAR") OR (BANCS.INPUT.Command=="CDRR") OR (BANCS.INPUT.ReservedField2=="CASHIN")) THEN
		print(BANCS.OUTPUT.contraAccount)
		print(BANCS.INPUT.CrForacid)
		CUST.ATM.DebitAccount=BANCS.OUTPUT.contraAccount
		print(CUST.ATM.DebitAccount)
		CUST.ATM.CreditAccount=BANCS.INPUT.CrForacid
		print(CUST.ATM.CreditAccount)
		IF (BANCS.INPUT.ReservedField2=="CASHIN") THEN
			BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
			print(BANCS.OUTPUT.contraAccount)
		ENDIF
	ELSE
		print(BANCS.OUTPUT.contraAccount)
		print(BANCS.INPUT.Foracid)
		CUST.ATM.DebitAccount=BANCS.INPUT.Foracid
		if(BANCS.OUTPUT.contraAccount==BANCS.INPUT.Foracid)then
			CUST.ATM.CreditAccount=BANCS.INPUT.CrForacid
			CUST.ATM.DevTypepos=""
			if (fieldexists(BANCS.INPUT.DevType)==1) then
				print(BANCS.INPUT.DevType)
				IF (BANCS.INPUT.DevType=="POS") THEN
					CUST.ATM.DevTypepos="POS"
					print(CUST.ATM.DevTypepos)
				ELSE
					CUST.ATM.DevTypepos="POS"
					print(CUST.ATM.DevTypepos)
				ENDIF
			endif
			sv_k = MID$(BANCS.INPUT.DeviceId,0,3)
			print(sv_k)
			IF (((BANCS.INPUT.DccId == "WPD") AND (BANCS.INPUT.ReservedField2=="ATMDEP")) OR ((BANCS.INPUT.DccId == "BRK") AND (BANCS.INPUT.ReservedField2=="ATMDEP") AND (sv_k=="EBC") AND (CUST.ATM.DevTypepos=="POS"))) THEN
				print(BANCS.INPUT.CrForacid)
			ELSE	
				IF (BANCS.INPUT.DccId=="WPD") THEN
					IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)==1) THEN
						IF (BANCS.INPUT.ReservedField2!="POSWITAB") THEN
							BANCS.OUTPUT.contraAccount = BANCS.INPUT.CrForacid
							print(BANCS.OUTPUT.contraAccount)
						ENDIF
					ELSE
						BANCS.OUTPUT.contraAccount = BANCS.INPUT.CrForacid
						print(BANCS.OUTPUT.contraAccount)
					ENDIF
				ELSE
					BANCS.OUTPUT.contraAccount = BANCS.INPUT.CrForacid
					print(BANCS.OUTPUT.contraAccount)
				ENDIF
			ENDIF
		else
			CUST.ATM.CreditAccount=BANCS.OUTPUT.contraAccount
		endif
	                print(CUST.ATM.DebitAccount)
		print(CUST.ATM.CreditAccount)
	ENDIF
	sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.DebitAccount)
	IF (sv_u != 0) THEN
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure = "F"
                print("line 1063") 
                GOTO ENDOFSCRIPT
	ELSE
		CUST.ATM.Debitcurrency = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.ATM.Debitcurrency)

	ENDIF
	IF (FIELDEXISTS(CUST.ATM.CreditAccount)==1) THEN
	#{
		IF (CUST.ATM.CreditAccount != "" ) THEN
		 #{
			sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.CreditAccount)
			IF (sv_u != 0) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				print("line 1074")
				GOTO ENDOFSCRIPT
			ELSE
				CUST.ATM.creditcurrency = BANCS.OUTPARAM.acctCrncyCode
				print(CUST.ATM.creditcurrency)
			ENDIF
			CUST.ATM.statusflg="N"
		 	IF (BANCS.INPUT.DccId == "WPD") THEN
				IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="POSWITAB")) THEN
					IF (CUST.ATM.Debitcurrency==CUST.ATM.creditcurrency) THEN 
						CUST.ATM.creditcurrency = BANCS.INPUT.TranCrncy
						print(CUST.ATM.creditcurrency)
					ENDIF
				ENDIF
			ENDIF
			
			IF (CUST.ATM.Debitcurrency!=CUST.ATM.creditcurrency) THEN  
				IF ((BANCS.INPUT.DccId == "BRK") OR (BANCS.INPUT.DccId == "WPD") OR (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN")) THEN
					CUST.ATM.RateCode="CRC"
					IF ((BANCS.INPUT.ReservedField2=="CASHIN") OR (BANCS.INPUT.ReservedField2=="CASHOUT")) THEN
						IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum) == 1) THEN
							CUST.ATM.RateCode=BANCS.INPUT.ConsumerNum
							print(CUST.ATM.RateCode)
							IF ((CUST.ATM.RateCode=="CNB") OR (CUST.ATM.RateCode=="CNS")) THEN
								CUST.ATM.RateCode ="CDCI_RATE_CODE|" + CUST.ATM.RateCode
								CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
								print(CUST.ATM.Put)
								CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
								IF (CUST.ATM.Get == 0 ) THEN
									print(BANCS.OUTPARAM.envValue)
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					IF (BANCS.INPUT.ReservedField1!="CHARGE") THEN
						IF (BANCS.INPUT.ReservedField2=="ATMWIT") THEN
							IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum) == 1) THEN
								CUST.ATM.RateCode=BANCS.INPUT.ConsumerNum
								print(CUST.ATM.RateCode)
								IF ((CUST.ATM.RateCode=="CNB") OR (CUST.ATM.RateCode=="CNS")) THEN
									CUST.ATM.RateCode ="CDCI_RATE_CODE|" + CUST.ATM.RateCode
									CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
									print(CUST.ATM.Put)
									CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
									IF (CUST.ATM.Get == 0 ) THEN
										print(BANCS.OUTPARAM.envValue)
									ENDIF
								ELSE
									IF (BANCS.INPUT.DccId == "WPD") THEN
										CUST.ATM.transactiontype="T"
										IF  ((BANCS.INPUT.ReservedField2=="POSWITAB") OR (BANCS.INPUT.ReservedField2=="POSDEP") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR (BANCS.INPUT.ReservedField2=="CASHOUT")) THEN
											CUST.ATM.transactiontype="C"
											print(CUST.ATM.transactiontype)
										ENDIF
										sv_q = " FXratecode| select CUSTOM.RETURN_FX_RATE_CODE(?SVAR,?SVAR,?SVAR,?SVAR) from dual"
										print(sv_q)
										BANCS.INPARAM.BINDVARS=CUST.ATM.Debitcurrency + "|" + CUST.ATM.creditcurrency + "|" + CUST.ATM.transactiontype + "|" + BANCS.STDIN.contextBankId
										print(BANCS.INPARAM.BINDVARS)
										sv_w=urhk_dbSelectWithBind(sv_q)
										print(sv_w)
										IF ( sv_w != 0 ) then
											BANCS.OUTPUT.RespCode = "99"
											BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
											print(BANCS.OUTPUT.ReservedField3)
											BANCS.OUTPUT.successOrFailure="F"
											exitscript
										ELSE
											CUST.ATM.FXratecode = BANCS.OUTPARAM.FXratecode
											print(CUST.ATM.FXratecode)
											IF (CUST.ATM.FXratecode=="") THEN
												BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
												print(BANCS.OUTPUT.ReservedField3)
												BANCS.OUTPUT.RespCode = "99"
												BANCS.OUTPUT.successOrFailure = "F"
												GOTO ENDOFSCRIPT
											ENDIF
											CUST.ATM.RateCodeC ="CDCI_RATE_CODE|"
											CUST.ATM.RateCode = CUST.ATM.RateCodeC + CUST.ATM.FXratecode
											print(CUST.ATM.RateCode)
											CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
											print(CUST.ATM.Put)
											CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
											IF(CUST.ATM.Get == 0 ) THEN
												print(BANCS.OUTPARAM.envValue)
											ELSE
												BANCS.OUTPUT.RespCode = "99"
												BANCS.OUTPUT.successOrFailure = "F"
												GOTO ENDOFSCRIPT
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ELSE
								IF (BANCS.INPUT.DccId == "WPD") THEN
									CUST.ATM.transactiontype="T"
									IF  ((BANCS.INPUT.ReservedField2=="POSWITAB") OR (BANCS.INPUT.ReservedField2=="POSDEP") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR (BANCS.INPUT.ReservedField2=="CASHOUT")) THEN
										CUST.ATM.transactiontype="C"
										print(CUST.ATM.transactiontype)
									ENDIF
									sv_q = " FXratecode| select CUSTOM.RETURN_FX_RATE_CODE(?SVAR,?SVAR,?SVAR,?SVAR) from dual"
									print(sv_q)
									BANCS.INPARAM.BINDVARS=CUST.ATM.Debitcurrency + "|" + CUST.ATM.creditcurrency + "|" + CUST.ATM.transactiontype + "|" + BANCS.STDIN.contextBankId
									print(BANCS.INPARAM.BINDVARS)
									sv_w=urhk_dbSelectWithBind(sv_q)
									print(sv_w)
									IF ( sv_w != 0 ) then
										BANCS.OUTPUT.RespCode = "99"
										BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
										print(BANCS.OUTPUT.ReservedField3)
										BANCS.OUTPUT.successOrFailure="F"
										exitscript
									ELSE
										CUST.ATM.FXratecode = BANCS.OUTPARAM.FXratecode
										print(CUST.ATM.FXratecode)
										IF (CUST.ATM.FXratecode=="") THEN
											BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
											print(BANCS.OUTPUT.ReservedField3)
											BANCS.OUTPUT.RespCode = "99"
											BANCS.OUTPUT.successOrFailure = "F"
											GOTO ENDOFSCRIPT
										ENDIF
										CUST.ATM.RateCodeC ="CDCI_RATE_CODE|"
										CUST.ATM.RateCode = CUST.ATM.RateCodeC + CUST.ATM.FXratecode
										print(CUST.ATM.RateCode)
										CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
										print(CUST.ATM.Put)
										CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
										IF(CUST.ATM.Get == 0 ) THEN
											print(BANCS.OUTPARAM.envValue)
										ELSE
											BANCS.OUTPUT.RespCode = "99"
											BANCS.OUTPUT.successOrFailure = "F"
											GOTO ENDOFSCRIPT
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ELSE
							IF (BANCS.INPUT.DccId == "WPD") THEN
								CUST.ATM.transactiontype="T"
								IF ((BANCS.INPUT.ReservedField2=="POSWITAB") OR (BANCS.INPUT.ReservedField2=="POSDEP") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR (BANCS.INPUT.ReservedField2=="CASHOUT")) THEN
									CUST.ATM.transactiontype="C"
									print(CUST.ATM.transactiontype)
								ENDIF
								sv_q = " FXratecode| select CUSTOM.RETURN_FX_RATE_CODE(?SVAR,?SVAR,?SVAR,?SVAR) from dual"
								print(sv_q)
								BANCS.INPARAM.BINDVARS=CUST.ATM.Debitcurrency + "|" + CUST.ATM.creditcurrency + "|" + CUST.ATM.transactiontype + "|" + BANCS.STDIN.contextBankId
								print(BANCS.INPARAM.BINDVARS)
								sv_w=urhk_dbSelectWithBind(sv_q)
								print(sv_w)
								IF ( sv_w != 0 ) then
									BANCS.OUTPUT.RespCode = "99"
									BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
									print(BANCS.OUTPUT.ReservedField3)
									BANCS.OUTPUT.successOrFailure="F"
									exitscript
								ELSE
									CUST.ATM.FXratecode = BANCS.OUTPARAM.FXratecode
									print(CUST.ATM.FXratecode)
									IF (CUST.ATM.FXratecode=="") THEN
										BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
										print(BANCS.OUTPUT.ReservedField3)
										BANCS.OUTPUT.RespCode = "99"
										BANCS.OUTPUT.successOrFailure = "F"
										GOTO ENDOFSCRIPT
									ENDIF
									CUST.ATM.RateCodeC ="CDCI_RATE_CODE|"
									CUST.ATM.RateCode = CUST.ATM.RateCodeC + CUST.ATM.FXratecode
									print(CUST.ATM.RateCode)
									CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
									print(CUST.ATM.Put)
									CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
									IF(CUST.ATM.Get == 0 ) THEN
										print(BANCS.OUTPARAM.envValue)
									ELSE
										BANCS.OUTPUT.RespCode = "99"
										BANCS.OUTPUT.successOrFailure = "F"
										GOTO ENDOFSCRIPT
									ENDIF
								ENDIF
							ENDIF
						ENDIF
						################## start agent forex
						IF (BANCS.INPUT.ReservedField2=="POSDEP")  THEN
							CUST.ATM.transactiontype="C"
							sv_q = " FXratecode| select CUSTOM.RETURN_FX_RATE_CODE(?SVAR,?SVAR,?SVAR,?SVAR) from dual"
							print(sv_q)
							BANCS.INPARAM.BINDVARS=CUST.ATM.Debitcurrency + "|" + CUST.ATM.creditcurrency + "|" + CUST.ATM.transactiontype + "|" + BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_w=urhk_dbSelectWithBind(sv_q)
							print(sv_w)
							IF ( sv_w != 0 ) then
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
								print(BANCS.OUTPUT.ReservedField3)
								BANCS.OUTPUT.successOrFailure="F"
								exitscript
							ELSE
								CUST.ATM.FXratecode = BANCS.OUTPARAM.FXratecode
								print(CUST.ATM.FXratecode)
								IF (CUST.ATM.FXratecode=="") THEN
									BANCS.OUTPUT.ReservedField3 = "RATE MATRIX NOT MAINTAINED"
									print(BANCS.OUTPUT.ReservedField3)
									BANCS.OUTPUT.RespCode = "99"
									BANCS.OUTPUT.successOrFailure = "F"
									GOTO ENDOFSCRIPT
								ENDIF
								CUST.ATM.RateCodeC ="CDCI_RATE_CODE|"
								CUST.ATM.RateCode = CUST.ATM.RateCodeC + CUST.ATM.FXratecode
								print(CUST.ATM.RateCode)
								CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
								print(CUST.ATM.Put)
								CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
								IF(CUST.ATM.Get == 0 ) THEN
									print(BANCS.OUTPARAM.envValue)
								ELSE
									BANCS.OUTPUT.RespCode = "99"
									BANCS.OUTPUT.successOrFailure = "F"
									GOTO ENDOFSCRIPT
								ENDIF
							ENDIF
						ENDIF
						################## end agent forex
					ENDIF
				ELSE
					#BANCS.OUTPUT.RespCode = "99"
					#BANCS.OUTPUT.successOrFailure = "F"
					#GOTO ENDOFSCRIPT
				ENDIF
			ENDIF
		 #}
		ENDIF
	#}
	ENDIF
ENDIF
