<--start
trace on

CALL("Common_Interface_CreateRepos.scr")

sv_s = " CIF, EMPLOYERID |  select foracid,ACCT_PREF from custom.int_change3 where bank_id=?SVAR and entity_cre_flg  in ('EMP') " 
print(sv_s)
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)
sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)
IF (sv_c==0) then
#{

	CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
	print(sv_k)

	WHILE (sv_k == 0)
	#{

		CUST.INTERFACE.CIF = BANCS.OUTPARAM.CIF
		CUST.INTERFACE.EMPLOYERID = BANCS.OUTPARAM.EMPLOYERID

		
		
			CUST.INTERFACE.SEGMOD ="N"
			
			sv_a = " segmentation_class,subsegment  | select segmentation_class, subsegment   from  crmuser.accounts where orgkey  =?SVAR  and bank_id =?SVAR "
			print (sv_a)
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_d)
			IF(sv_d == 0) THEN
				CUST.INTERFACE.SEGMENT = BANCS.OUTPARAM.segmentation_class
				CUST.INTERFACE.SUBSEG = BANCS.OUTPARAM.subsegment		

				IF (CUST.INTERFACE.SEGMENT == "RETAIL") then 
					CUST.INTERFACE.SEGMOD ="Y"
					CUST.INTERFACE.SEGMENT = "PART"
				ELSE
					PRINT (CUST.INTERFACE.SEGMENT)
				ENDIF

				IF (CUST.INTERFACE.SUBSEG =="HIGH") then
					CUST.INTERFACE.SEGMOD ="Y"
					CUST.INTERFACE.SUBSEG = "HNI"
				ELSE
					PRINT (CUST.INTERFACE.SUBSEG)
				ENDIF
			ENDIF
			
		CUST.INTERFACE.ADDRESS = "N"		
		sv_a = " ADDRESSID,ADDRESSCATEGORY, CITY, STATE,COUNTRY , ZIP | select  ADDRESSID,ADDRESSCATEGORY, city, state,country , zip from CRMUSER.address where orgkey  = ?SVAR and   PREFERREDADDRESS  ='Y' and bank_id = ?SVAR and rownum = 1 "
		print (sv_a)
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_d)
		IF(sv_d == 0) THEN
			CUST.INTERFACE.ADDRESS = "Y"
			CUST.INTERFACE.ADDRESSID = BANCS.OUTPARAM.ADDRESSID
			CUST.INTERFACE.ADDRESSCATEGORY = BANCS.OUTPARAM.ADDRESSCATEGORY
			CUST.INTERFACE.STATE = BANCS.OUTPARAM.STATE
			CUST.INTERFACE.COUNTRY = BANCS.OUTPARAM.COUNTRY
			CUST.INTERFACE.CITY = BANCS.OUTPARAM.CITY
			CUST.INTERFACE.ZIP = BANCS.OUTPARAM.ZIP			
		ELSE			
			CUST.INTERFACE.ADDRESS = "N"
		ENDIF
								
		
		
		CUST.INTERFACE.interfaceRequestID = "RetCustMod"
		CUST.INTERFACE.interfaceRequestVersion = "10.2"
		CUST.INTERFACE.bankID =BANCS.STDIN.contextBankId
		CUST.INTERFACE.channelID = "CRM"
		CUST.INTERFACE.startdate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.instDate = ""
		CUST.INTERFACE.lastdatepart ="T00:00:00.000"
		print(CUST.INTERFACE.lastdatepart)
		CUST.INTERFACE.sign ="-"
		print(CUST.INTERFACE.sign)

		#-------------------------------------------------------------------------
		# Fetch the current data time to send in request header
		#-------------------------------------------------------------------------
		sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
			print(CUST.INTERFACE.msgDateTime)
		#}
		ENDIF

		#-------------------------------------------------------------------------
		#- Forming the Header for RetCustAdd
		#-------------------------------------------------------------------------

		sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0)THEN
		#{
			CUST.INTERFACE.RequestID1 = BANCS.OUTPARAM.RequestID
			print(CUST.INTERFACE.RequestID1)
		#}
		ELSE
		#{
			CUST.INTERFACE.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
			print(CUST.INTERFACE.RequestID1)
		#}
		ENDIF

		CUST.INTERFACE.headerXML = ""
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Header>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestHeader>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageKey>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestUUID>"+ CUST.INTERFACE.RequestID1 +"</RequestUUID>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestId>"+  CUST.INTERFACE.interfaceRequestID +"</ServiceRequestId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ChannelId>" + CUST.INTERFACE.channelID + "</ChannelId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</MessageKey>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestMessageInfo>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<BankId>" + CUST.INTERFACE.bankID + "</BankId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<TimeZone>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</TimeZone>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</EntityId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityType>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</EntityType>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageDateTime>" + CUST.INTERFACE.msgDateTime + "</MessageDateTime>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestMessageInfo>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Security>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Token>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<PasswordToken>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<UserId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</UserId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Password>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Password>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</PasswordToken>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Token>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<FICertToken>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</FICertToken>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserLoginSessionId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RealUserLoginSessionId>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUser>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RealUser>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserPwd>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RealUserPwd>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<SSOTransferToken>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</SSOTransferToken>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Security>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestHeader>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Header>"

		#-------------------------------------------------------------------------
		#- Forming the Body for corp modification
		#-------------------------------------------------------------------------

			CUST.INTERFACE.bodyXMLMsg = ""
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Body>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RetCustModRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RetCustModRq>"
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RetCustModMainData>"
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustModData>"
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustId>" + CUST.INTERFACE.CIF + "</CustId>"
				#CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Manager>JM31324</Manager>"					
				
				IF (CUST.INTERFACE.SEGMOD == "Y") THEN
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SegmentationClass>" + CUST.INTERFACE.SEGMENT  + "</SegmentationClass>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SubSegment>" + CUST.INTERFACE.SUBSEG  + "</SubSegment>"
				ENDIF		
				IF (CUST.INTERFACE.ADDRESS == "Y") THEN
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RetAddrModDtls>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AddrCategory>" + CUST.INTERFACE.ADDRESSCATEGORY + "</AddrCategory>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<HoldMailFlag>N</HoldMailFlag>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AddressID>" + CUST.INTERFACE.ADDRESSID + "</AddressID>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<City>" + CUST.INTERFACE.CITY + "</City>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Country>" + CUST.INTERFACE.COUNTRY + "</Country>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<State>" + CUST.INTERFACE.STATE + "</State>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PostalCode>" + CUST.INTERFACE.ZIP + "</PostalCode>"
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetAddrModDtls>"
				ENDIF				
				
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CustModData>"	
					CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TradeFinFlag>Y</TradeFinFlag>"				
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustModMainData>"				
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RetailCustModRelatedData>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<preferencesModData/>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TradeFinModData>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustNative>Y</CustNative>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<InlandTradeAllowed>Y</InlandTradeAllowed>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TradeAuthorityCode/>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</TradeFinModData>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DemographicModData>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<EmploymentStatus>Employed</EmploymentStatus>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DemographicMiscModData>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<StrText2 />"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<EMPLOYERID>" + CUST.INTERFACE.EMPLOYERID + "</EMPLOYERID>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Type>CURRENT_EMPLOYMENT</Type>"
								CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</DemographicMiscModData>"
							CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</DemographicModData>"
						CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetailCustModRelatedData>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustModRq>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustModRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Body>"

		#-------------------------------------------------------------------------
		#Appending the header XML and body XML.
		#-------------------------------------------------------------------------
		CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML 
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
		CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"

		#-------------------------------------------------------------------------------
		# Setting input values for urhk_ConnectToFIAndSendMsg userhook
		#-------------------------------------------------------------------------------
		BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
		print(BANCS.INPARAM.SERVICE_NAME)
		BANCS.INPARAM.SEND_RECV_FLG             = "R"
		sv_a = CUST.INTERFACE.reqXMLMsg
		PRINT(sv_a)

		#-------------------------------------------------------------------------
		#- Executing the userhook to make the Outbound Call
		#-------------------------------------------------------------------------
		sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
		print(sv_l)
		IF (sv_l != 0) THEN
		#{
			print(BANCS.OUTPARAM.ErrMsg)
			CUST.INTERFACE.errorMsgFlg = "Y"
			CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
			CUST.INTERFACE.errorMsgCode = "FIERR"  
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF (BANCS.OUTPARAM.ErrMsg != "") THEN
		#{
			CUST.INTERFACE.errorMsgFlg = "Y"
			CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
			CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg 
			CUST.INTERFACE.errorMsgCode = "FIERR" 
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
			print(CUST.INTERFACE.respXMLMsg)
			CUST.INTERFACE.errorMsgFlg = ""
			CUST.INTERFACE.errorMsgDesc = ""
			
			CUST.INTERFACE.opndate = ""
			CUST.INTERFACE.cifid = ""
			CUST.INTERFACE.errorCode = ""
			CUST.INTERFACE.errorDesc = ""
			sv_x = CUST.INTERFACE.respXMLMsg

			#--------------------------------------------------------------------------------------------------------
			# Fetching the status of the request
			#--------------------------------------------------------------------------------------------------------
			sv_y = "<Status>"
			sv_z = "</Status>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
			#}
			ELSE
			#{
				CUST.INTERFACE.tranStatus = ""
			#}
			ENDIF
			print(CUST.INTERFACE.tranStatus)
			#--------------------------------------------------------------------------------------------------------
			# If Success fetching cif id and cif opn date else fetching error code and description
			#--------------------------------------------------------------------------------------------------------
			IF (CUST.INTERFACE.tranStatus =="SUCCESS")  THEN
			#{
				CUST.INTERFACE.errorMsgFlg = "N"
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<CustId>"
				sv_z = "</CustId>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.cifid = MID$(sv_x, sv_b, (sv_e - sv_b))
					print(CUST.INTERFACE.cifid)
				#}
				ENDIF
							#----------------------------------------------------------------------------------------------------
							# Update custom table status
							#----------------------------------------------------------------------------------------------------
							sv_s = "UPDATE CUSTOM.INT_CHANGE3   "
							sv_s = sv_s + " SET ENTITY_CRE_FLG = 'PME', CUST_PREF =  'Agreement Code Added' "
							sv_s = sv_s + " WHERE  bank_id=?SVAR and foracid=?SVAR and entity_cre_flg   ='EMP' "
							print(sv_s)
							BANCS.INPARAM.BINDVARS =    BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.CIF
							print(BANCS.INPARAM.BINDVARS)
					
							sv_d = urhk_dbSQLWithBind(sv_s)
							IF (sv_d == 0) THEN
							#{
								sv_c = urhk_dbSQLWithBind("commit")
								print(sv_c)
							#}
							ENDIF
					
				
			#}
			ELSE
			#{
				CUST.INTERFACE.errorMsgFlg = "Y"
				IF(CUST.INTERFACE.tranStatus != "SUCCESS") THEN
				#{
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<ErrorCode>"
					sv_z = "</ErrorCode>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
					#}
					ENDIF
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<ErrorDesc>"
					sv_z = "</ErrorDesc>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
					#}
					ENDIF

						
						#----------------------------------------------------------------------------------------------------
						# Update custom table failure status
						#----------------------------------------------------------------------------------------------------
						IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
						#{
							CUST.INTERFACE.errorCode = "SYSERR"
							CUST.INTERFACE.errorDesc = "Could not get response from server"
						#}
						ENDIF

						sv_s = "UPDATE  CUSTOM.INT_CHANGE3  "
						sv_s = sv_s + " SET ENTITY_CRE_FLG = 'EME', CUST_PREF =  SUBSTR (replace (q'["+CUST.INTERFACE.errorDesc+"]',q'[|]',q'[ ]'),1,100)   "
						sv_s = sv_s + " WHERE bank_id=?SVAR and foracid=?SVAR and entity_cre_flg   in ('EMP','EME') "
						print(sv_s)
						BANCS.INPARAM.BINDVARS =    BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.CIF
						print(BANCS.INPARAM.BINDVARS)				
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
						#{
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						#}
						ENDIF

				#}
				ENDIF
				IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
				#{
					CUST.INTERFACE.errorCode = "SYSERR"
					CUST.INTERFACE.errorDesc = "Could not get response from server"
				#}
				ENDIF
			#}
			ENDIF

		#}
		ENDIF
		VAYU:

		sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
		print(sv_k)
	#}
	DO

	sv_c = urhk_dbCursorClose(CUST.INTERFACE.DbcursorNumber)
	print(sv_c)
#}
ENDIF

ENDOFSCRIPT:
EXITSCRIPT
#trace off
end-->


