				#	 Fetch the account data for modify
				#--------------------------------------------------------------------------------------------------------------
				sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForCancel|retain_all_output = Y")
				PRINT(sv_u)
			
				IF (sv_u ==0 ) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					PRINT(sv_u)
					
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.DORM.foracid)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUST.DORM.acid)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUST.DORM.schm_type)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUST.DORM.schmCode)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|"+CUST.DORM.sweeps)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("schmDtls.acctStat.code|D")
					PRINT(sv_u)
					sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
					PRINT(sv_u)
					sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
					PRINT(sv_u)
					sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
					PRINT(sv_u)
					sv_u =urhk_SetUrhkInp("schmDtls.acctSchemeEntered|1")
					PRINT(sv_u)		
					sv_u = urhk_ExecSrv("SRV_CancelCAAcct|retain_all_output = Y")
					PRINT(sv_u)
				#}
				ENDIF

				IF (sv_u != 0) THEN
				#{
					IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						PRINT(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
					#}
					ELSE
					#{
						sv_v = 0
					#}
					ENDIF
				
					IF (sv_v > 0) then
					#{
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							print(sv_e)
							sv_g = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							print(sv_e)
							sv_g = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							PRINT(sv_g)
							sv_i = sv_i + 1
							PRINT(sv_u)
							CUST.DORM.errMsg = sv_e
						#}
						DO
					#}
					ELSE
					#{
						CUST.DORM.errMsg = "Account could not be cancelled"
					#}
					ENDIF
					
					GOTO ENDOFSCRIPT
				#}
				ELSE
				#{
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
					sv_g = "RESULT_MSG|Account cancellation initiated"
					sv_z = urhk_SetOrbOut(sv_g)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
	#}
	ENDIF


ENDOFSCRIPT :
IF (CUST.DORM.errMsg != "") THEN
#{
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	sv_g = "RESULT_MSG|" + CUST.DORM.errMsg + " - Account might need data correction, kindly invoke HACM menu for modifications"
	PRINT(sv_g)
	sv_z = urhk_SetOrbOut(sv_g)
	PRINT(sv_z)
#}
ENDIF


TRACE OFF

EXITSCRIPT
END-->