		IF (CUST.DORM.sweeps == "") THEN
		#{
			CUST.DORM.sweeps = "N" 
		#}
		ENDIF
	#}
	ELSE
	#{
		sv_e = "Account is invalid or not of SBA or CAA scheme type"
