<--START
TRACE ON
sv_a = urhk_B2k_PrintRepos("BANCS")
print(sv_a)
IF(REPEXISTS("CUST") == 0) THEN
#{
    CREATEREP("CUST")
#}
ENDIF 

IF(CLASSEXISTS("CUST","DORM") == 0) THEN
#{
    CREATECLASS("CUST","DORM",5)
#}
ENDIF

IF(CLASSEXISTS("CUST","GCHRG") == 0) THEN
#{
    CREATECLASS("CUST","GCHRG",5)
#}
ENDIF

CUST.DORM.errMsg		= ""
CUST.DORM.userWorkClass1= ""
CUST.DORM.userWorkClass2= ""
