CUST.DORM.currsts 		= BANCS.INPUT.currsts
CUST.DORM.newsts 		= BANCS.INPUT.newsts

BANCS.INPUT.moduleName = "DRMNTACTACTIV"

BANCS.INPUT.parameterId = "DREVENTID"
