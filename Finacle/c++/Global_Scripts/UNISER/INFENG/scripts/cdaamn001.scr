	sv_s = sv_s + "WHERE bank_id  = ?SVAR "
	sv_s = sv_s + "AND foracid = ?SVAR "
	sv_s = sv_s + "AND schm_type IN ('SBA','CAA') "
	sv_s = sv_s + "AND acct_cls_flg = 'N' "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DORM.foracid 

	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)


	IF( sv_u == 0) THEN 
	#{

		CUST.DORM.schm_type = BANCS.OUTPARAM.schm_type
		CUST.DORM.acid = BANCS.OUTPARAM.acid 
		CUST.DORM.acctcrncycode = BANCS.OUTPARAM.acctcrncycode
