#{
        CUST.GCHRG.eventId = BANCS.OUTPUT.parameterVal

#}
ELSE
#{
        CUST.DORM.errMsg = " Evevt Id setup not done in CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF



BANCS.INPUT.parameterId = "DORM_WRKCLAS1"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.DORM.userWorkClass1 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.DORM.errMsg = "WorkClass setup not done CPARAM"
