IF (CUST.DORM.funcCode== "V") THEN
#{
	IF ((BANCS.STDIN.userWorkClass =="060") OR (BANCS.STDIN.userWorkClass=="070")) THEN
	#{
		sv_e = "Verification not allowed by work class 070 and 060"
		sv_m = BANCS.STDIN.userWorkClass
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF

#-----------------------------------------------------------------------------------------
#--
#-----------------------------------------------------------------------------------------Edwin.Z end



	sv_s = "acid,schm_type,acctcrncycode,solid,schmCode,sweeps|SELECT acid,schm_type,acct_crncy_code,sol_id,schm_code,allow_sweeps "
