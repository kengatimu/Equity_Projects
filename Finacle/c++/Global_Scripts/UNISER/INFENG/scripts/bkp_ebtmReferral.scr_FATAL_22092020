<--start
trace on
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
#####exitscript
#SrvValues
	EBSRV.GLBDATA.totCAmt = 0
	EBSRV.GLBDATA.totDAmt = 0
	EBSRV.GLBDATA.chrgDrYN = ""
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	if ((EBSRV.GLBDATA.tranSubType == "CI") or (EBSRV.GLBDATA.tranSubType=="BI") or (EBSRV.GLBDATA.tranSubType=="NR") or (EBSRV.GLBDATA.tranSubType=="NP"))then
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EBSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EBSRV.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
			EBSRV.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
			EBSRV.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars2)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg")
			EBSRV.GLBDATA.recDelYN=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.recDelYN)
		if(EBSRV.GLBDATA.foracid!="")then
			sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.foracid)
			if(sv_u==0)then
				EBSRV.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
				EBSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
			endif
		endif
                sv_l = strlen(EBSRV.GLBDATA.tran_amt)
                sv_f = mid$(EBSRV.GLBDATA.tran_amt,0,sv_l)
                sv_l = strlen(EBSRV.GLBDATA.tran_amt)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
                EBSRV.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trans_amt)
                print(EBSRV.GLBDATA.trans_crncy)
                print(EBSRV.GLBDATA.tran_amt)
		if(EBSRV.GLBDATA.partTranType=="D")then
			EBSRV.GLBDATA.totDAmt = cdouble(EBSRV.GLBDATA.totDAmt) + cdouble(EBSRV.GLBDATA.trans_amt) 
		endif
		if(EBSRV.GLBDATA.partTranType=="C")then
			EBSRV.GLBDATA.totCAmt = cdouble(EBSRV.GLBDATA.totCAmt) + cdouble(EBSRV.GLBDATA.trans_amt) 
		endif
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif
	sv_o = " drlimCrncyCode,crncyCode,usrCdrLim,usrClgdrLim,usrTdrLim,usrIsolCdrLim,usrIsolClgdrLim,usrIsolTdrLim | " 
	sv_o = sv_o + " select dr_lim_crncy_code,crncy_code,user_cash_dr_lim,user_clg_dr_lim,"
	sv_o = sv_o + " user_xfer_dr_lim,user_intersol_cash_dr_limit,user_intersol_clg_dr_limit,"
	sv_o = sv_o + " user_intersol_xfer_dr_limit "
	sv_o = sv_o + " from tbaadm.rcl " 
	sv_o = sv_o + " where bank_id=?SVAR "
	sv_o = sv_o + " and del_flg='N' "
	sv_o = sv_o + " and crncy_code=?SVAR "
	sv_o = sv_o + " and role_id=?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.trans_crncy + "|" + BANCS.STDIN.roleId   
	print(BANCS.INPARAM.BINDVARS)
	print(sv_o)
	sv_u = urhk_dbSelectWithBind(sv_o)
	if(sv_u==0)then
		EBSRV.GLBDATA.drlimCrncyCode = BANCS.OUTPARAM.drlimCrncyCode
		EBSRV.GLBDATA.crncyCode = BANCS.OUTPARAM.crncyCode
		EBSRV.GLBDATA.usrCdrLim = BANCS.OUTPARAM.usrCdrLim
		EBSRV.GLBDATA.usrClgdrLim = BANCS.OUTPARAM.usrClgdrLim
		EBSRV.GLBDATA.usrTdrLim = BANCS.OUTPARAM.usrTdrLim
		EBSRV.GLBDATA.usrIsolCdrLim = BANCS.OUTPARAM.usrIsolCdrLim
		EBSRV.GLBDATA.usrIsolClgdrLim = BANCS.OUTPARAM.usrIsolClgdrLim
		EBSRV.GLBDATA.usrIsolTdrLim = BANCS.OUTPARAM.usrIsolTdrLim
	else
		EBSRV.GLBDATA.drlimCrncyCode = ""
		EBSRV.GLBDATA.crncyCode = "" 
		EBSRV.GLBDATA.usrCdrLim = "" 
		EBSRV.GLBDATA.usrClgdrLim = "" 
		EBSRV.GLBDATA.usrTdrLim = "" 
		EBSRV.GLBDATA.usrIsolCdrLim = "" 
		EBSRV.GLBDATA.usrIsolClgdrLim = "" 
		EBSRV.GLBDATA.usrIsolTdrLim = "" 
	endif
	if((cdouble(EBSRV.GLBDATA.totDAmt)>cdouble(EBSRV.GLBDATA.usrTdrLim)) and (EBSRV.GLBDATA.tranType=="T"))then
		 sv_r=urhk_B2k_PutUserException("CAE")
	endif
	if((cdouble(EBSRV.GLBDATA.totDAmt)>cdouble(EBSRV.GLBDATA.usrCdrLim)) and (EBSRV.GLBDATA.tranType=="C"))then
		 sv_r=urhk_B2k_PutUserException("CAE")
	endif
VAYU:	
	if(classexists("EBSRV","GLBDATA")==1) then
		deleteclass("EBSRV","GLBDATA")
	endif
	if(repexists("EBSRV")==1) then
		deleterep("EBSRV")
	endif
	exitscript
##trace off
end-->
