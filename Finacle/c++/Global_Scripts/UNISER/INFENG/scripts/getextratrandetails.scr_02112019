		BANCS.OUTPUT.TranParticularCode = BANCS.INPUT.TranParticularCode
		PRINT(BANCS.OUTPUT.TranParticularCode)
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.INPUT.PartTranType) == 1) THEN
	#{
		BANCS.OUTPUT.PartTranType= BANCS.INPUT.PartTranType
