	#}
	ENDIF
	
	
	IF (FIELDEXISTS(BANCS.INPUT.RefNum) == 1) THEN
	#{
		BANCS.OUTPUT.RefNum= TRIM(BANCS.INPUT.RefNum)
		PRINT(BANCS.OUTPUT.RefNum)
	#}
	ENDIF
	
	
	PRINT(BANCS.STDIN.mySolDesc)
	
	IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1) THEN
	#{
		IF (BANCS.STDIN.menuId == "HSALPAY") THEN
		#{
			IF (FIELDEXISTS(CUST.SALPAY.tranParticulars) == 1) THEN
			#{
				BANCS.OUTPUT.TranParticular = CUST.SALPAY.tranParticulars
				print (BANCS.OUTPUT.TranParticular)
			#}
			ENDIF
		#}
		ENDIF
		
		IF ((BANCS.STDIN.menuId == "HTM") OR (BANCS.STDIN.menuId == "HCASHDEP") OR (BANCS.STDIN.menuId == "HCASHWD")) THEN
		#{
			IF ((BANCS.INPUT.TranSubType == "CI") OR (BANCS.INPUT.TranSubType == "BI") OR (BANCS.INPUT.TranSubType == "NR") OR (BANCS.INPUT.TranSubType == "NP") OR (BANCS.INPUT.TranSubType == "I")) THEN
			#{
					IF (REPEXISTS("CUST") == 0) THEN
					#{
						CREATEREP("CUST")
					#}
					ENDIF

					IF (CLASSEXISTS("CUST","TMCHRG") == 0) THEN
					#{
						CREATECLASS("CUST","TMCHRG",5)
					#}
					ENDIF
				IF (BANCS.INPUT.TranParticular == "") THEN
				#{
					IF (BANCS.INPUT.PartTranType == "D") THEN
					#{
						BANCS.OUTPUT.TranParticular = "DEBIT TRANSFER"
						PRINT(BANCS.OUTPUT.TranParticular)
						#}
					ELSE
						#{
						BANCS.OUTPUT.TranParticular = "CREDIT TRANSFER"
						PRINT(BANCS.OUTPUT.TranParticular)
					#}
					ENDIF
					
					IF (BANCS.INPUT.TranSubType == "NP") THEN
					#{
						BANCS.OUTPUT.TranParticular = "Cash Withdrawl from " + BANCS.STDIN.mySolDesc
						PRINT(BANCS.OUTPUT.TranParticular)
						CUST.TMCHRG.TranId = BANCS.INPUT.TranId
						
					#}
					ENDIF
					
					IF (BANCS.INPUT.TranSubType == "NR") THEN
					#{
						BANCS.OUTPUT.TranParticular = "Cash Deposit from " + BANCS.STDIN.mySolDesc 
						PRINT(BANCS.OUTPUT.TranParticular)
					#}
					ENDIF
				ELSE
				#{
					IF ((BANCS.STDIN.contextBankId == "55") AND (BANCS.INPUT.TranSubType == "BI"))THEN
					#{
						sv_s = "tranPart1,tranPart2|select a.tran_partcls,b.tran_partcls from "
						sv_s = sv_s + "(select * from tbaadm.ptt where event_id = 'TMINT1' and bank_id = ?SVAR)a, "
						sv_s = sv_s + "(select * from tbaadm.ptt where event_id = 'TMWITH1' and bank_id = ?SVAR)b "
						sv_s = sv_s + "where a.bank_id = b.bank_id "
						
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						
						IF (sv_d == 0) THEN
						#{
							CUST.GCHRG.tranPart1 = BANCS.OUTPARAM.tranPart1
							print(CUST.GCHRG.tranPart1)
							CUST.GCHRG.tranPart2 = BANCS.OUTPARAM.tranPart2
							print(CUST.GCHRG.tranPart2)

							IF ((BANCS.INPUT.TranParticular == CUST.GCHRG.tranPart1) OR (BANCS.INPUT.TranParticular ==CUST.GCHRG.tranPart2)) THEN
								#{
								BANCS.OUTPUT.TranParticular2 = CUST.TMCHRG.TranId
								PRINT(BANCS.OUTPUT.TranParticular2)
								#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		IF (BANCS.STDIN.menuId == "HCDEP") THEN
		#{
			IF (BANCS.INPUT.TranSubType == "CR") THEN
			#{
				BANCS.OUTPUT.TranParticular = "Cash Deposit from " + BANCS.STDIN.mySolDesc
				PRINT(BANCS.OUTPUT.TranParticular)
			#}
			ENDIF
		#}
		ENDIF
		IF (BANCS.STDIN.menuId == "HBPAD") THEN
		#{
			IF (BANCS.STDIN.funcName != "SRV_CancelPayment") THEN
			#{
				IF (FIELDEXISTS(CUST.BILL.lateFeeAmt) == 1) THEN
				#{
					IF (CUST.BILL.billDateDiff > 0) THEN
					#{
						IF (CUST.BILL.billDusDateDiff > 0) THEN
						#{
							BANCS.OUTPUT.TranRmks = "Late Payment Fee:" + CUST.BILL.lateFeeAmt
							print(BANCS.OUTPUT.TranRmks)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	EXITSCRIPT
