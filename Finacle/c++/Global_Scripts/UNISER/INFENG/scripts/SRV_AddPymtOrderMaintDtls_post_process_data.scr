	sv_a=urhk_B2k_PrintRepos("BANCS")
	
	IF ( (FIELDEXISTS(BANCS.STDIN.moduleIdentity)) AND (BANCS.STDIN.moduleIdentity != "FI" ) ) THEN
		IF( (FIELDEXISTS(BANCS.STDIN.menuId)) AND (BANCS.STDIN.menuId == "HPORDM") ) THEN
		#{

			sv_a = urhk_SRV_GetVal("pordCrit.orderType")
