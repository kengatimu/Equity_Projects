###############
IF (BANCS.INPUT.DccId == "WPD") THEN
	IF (BANCS.INPUT.ReservedField2 != "") THEN 
		CUST.ATM.reversed2 = BANCS.INPUT.ReservedField2
		print(CUST.ATM.reversed2)
		sv_k = MID$(BANCS.INPUT.ReservedField2,0,5)
		print(sv_k)
		if (sv_k =="BILL:") THEN
			CUST.ATM.billercodenewed=trim(mid$(CUST.ATM.reversed2,5,6))
			print(CUST.ATM.billercodenewed)
			CUST.ATM.refnewed=trim(mid$(CUST.ATM.reversed2,11,30))
			print(CUST.ATM.refnewed)
			IF (fieldexists(CUST.ATM.TranId) == 1) THEN
				print(CUST.ATM.TranId)
				CUST.ATM.TranIdnewed=trim(CUST.ATM.TranId)
				print(CUST.ATM.TranIdnewed)
			ELSE
				CUST.ATM.TranIdnewed=""
				print(CUST.ATM.TranIdnewed)
			ENDIF
			IF (fieldexists(CUST.ATM.foracidcontra) == 1) THEN
				print(CUST.ATM.foracidcontra)
				CUST.ATM.BillerCrForacid=CUST.ATM.foracidcontra
				print(CUST.ATM.BillerCrForacid)
			ELSE
				CUST.ATM.BillerCrForacid=""
				print(CUST.ATM.BillerCrForacid)
			ENDIF
			IF (fieldexists(BANCS.OUTPUT.TranCrncy) == 1) THEN
				print(BANCS.OUTPUT.TranCrncy)
				CUST.ATM.TranCrncynewed=BANCS.OUTPUT.TranCrncy
				print(CUST.ATM.TranCrncynewed)
			ELSE
				CUST.ATM.TranCrncynewed=""
				print(CUST.ATM.TranCrncynewed)
			ENDIF
			IF (fieldexists(BANCS.OUTPUT.TranAmt) == 1) THEN
				print(BANCS.OUTPUT.TranAmt)
				CUST.ATM.Amountnewed = CDOUBLE(BANCS.OUTPUT.TranAmt)
				CUST.ATM.Amountnewed = CDOUBLE(CUST.ATM.Amountnewed)/CDOUBLE("100")
				print(CUST.ATM.Amountnewed)
			ELSE
				CUST.ATM.Amountnewed = ""
				print(CUST.ATM.Amountnewed)
			ENDIF
			IF (fieldexists(BANCS.OUTPUT.SerialNum) == 1) THEN
				print(BANCS.OUTPUT.SerialNum)
				CUST.ATM.narr1rrnauth = LTRIM(BANCS.OUTPUT.SerialNum,'0')
				print(CUST.ATM.narr1rrnauth)
			ELSE
				CUST.ATM.narr1rrnauth =""
				print(CUST.ATM.narr1rrnauth)
			ENDIF
			IF (fieldexists(BANCS.OUTPUT.ReservedField1) == 1) THEN
				print(BANCS.OUTPUT.ReservedField1)
				CUST.ATM.ReservedField1ed = BANCS.OUTPUT.ReservedField1
				print(CUST.ATM.ReservedField1ed)
			ELSE
				CUST.ATM.ReservedField1ed =""
				print(CUST.ATM.ReservedField1ed)
			ENDIF
			callscriptifexist("ebCubpEdUpDRC.scr")
		endif
	ENDIF
ENDIF

