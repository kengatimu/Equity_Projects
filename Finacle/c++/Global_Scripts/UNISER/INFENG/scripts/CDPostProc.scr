									sv_s = "update CUSTOM.C_NO_OF_WD set no_of_withdrawal=no_of_withdrawal-1,lchg_user_id=?SVAR,lchg_time=sysdate,last_tran_id=?SVAR,last_tran_date=to_date(?SVAR,'dd-mm-yyyy') WHERE foracid=?SVAR AND mon_yr=?SVAR AND bank_id=?SVAR"
									PRINT(sv_s)
									BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" +BANCS.OUTPUT.TranId+"|"+MID$(BANCS.OUTPUT.TranDate,0,10) + "|" + CUST.ATM.account + "|" + CUST.ATM.MMYYYY + "|"+BANCS.STDIN.contextBankId
									PRINT(BANCS.INPARAM.BINDVARS)
											
									sv_d = urhk_dbSqlWithBind(sv_s)
