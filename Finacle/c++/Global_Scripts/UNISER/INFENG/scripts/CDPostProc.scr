###IF ((BANCS.INPUT.DccId == "OMN") OR (BANCS.INPUT.DccId == "POL")) THEN
IF ((BANCS.INPUT.DccId != "SWT") AND (BANCS.INPUT.DccId != "WPD") AND (BANCS.INPUT.DccId != "BS1") AND (BANCS.INPUT.DccId != "MC1") AND (BANCS.INPUT.DccId != "CUP")) THEN
	IF (FIELDEXISTS(BANCS.OUTPUT.TranId) == 1) THEN
