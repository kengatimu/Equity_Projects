					print(CUST.ATM.rate)
					CUST.ATM.trea_rate = BANCS.OUTPARAM.trea_rate
					print(CUST.ATM.trea_rate)
					CUST.ATM.tran_amt = BANCS.OUTPARAM.tran_amt
					print(CUST.ATM.tran_amt)
					CUST.ATM.foracid = BANCS.OUTPARAM.foracid
