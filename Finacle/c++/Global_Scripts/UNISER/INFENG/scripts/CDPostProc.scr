CUST.ATM.DeviceIdPosFlg="N"
print(CUST.ATM.DeviceIdPosFlg)
IF ((BANCS.INPUT.DccId == "WPD") OR (BANCS.INPUT.DccId == "BRK")) THEN
	IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="POSDEP") OR (BANCS.INPUT.ReservedField2=="POSWITAB")) THEN
		sv_k = MID$(BANCS.INPUT.DeviceId,0,3)
		print(sv_k)
		IF (sv_k=="EBC") THEN
			CUST.ATM.DeviceIdPosFlg = "Y"
			print(CUST.ATM.DeviceIdPosFlg)
		ENDIF
	ENDIF
ENDIF
IF ( ((BANCS.INPUT.DccId == "BRK") OR (BANCS.INPUT.DccId == "WPD")) AND (CUST.ATM.DeviceIdPosFlg=="N") ) THEN
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1) THEN
		IF (BANCS.INPUT.ReservedField2!="") THEN
			IF (FIELDEXISTS(CUST.ATM.tranParticular)) THEN
				print(CUST.ATM.tranParticular)
				CUST.ATM.tranParticular = MID$(CUST.ATM.tranParticular,0,20)
				print(CUST.ATM.tranParticular)
			ELSE
				CUST.ATM.tranParticular=BANCS.INPUT.CardAcceptorName
				print(CUST.ATM.tranParticular)
			ENDIF
			sv_y=BANCS.INPUT.ReservedField2
			sv_c=mid$(sv_y,0,5)
			print(sv_c)
			IF ((BANCS.INPUT.ReservedField2=="POSWIT") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR (sv_c =="BILL:") OR (sv_c =="COLL:") OR (sv_c =="ACCT:")  OR (BANCS.INPUT.ReservedField2=="CASHOUT") OR (BANCS.INPUT.ReservedField2=="POSDEP") OR (BANCS.INPUT.ReservedField2=="POSWITAB")) THEN
				IF (FIELDEXISTS(BANCS.OUTPUT.TranId) == 1) THEN
					CUST.ATM.partTranTypeC="C"
					CUST.ATM.partTranTypeD="D" 
					CUST.ATM.PartTranSrlNum1="1"
					CUST.ATM.PartTranSrlNum2="2"
					CUST.ATM.TranId = BANCS.OUTPUT.TranId
					print(CUST.ATM.TranId)
					sv_d = "foracidcontra,tranamtcontra,refamtcontra,crncycontra,srlnumcontra,part_tran_type,srl_num,TRAN_PARTICULAR,TRAN_RMKS,TRAN_SUB_TYPE, TRAN_PARTICULAR_2 , REF_NUM, ENTRY_USER_ID,tran_crncy_code,ref_crncy_code,rate_code,rate,trea_rate,tran_amt,foracid,acct_crncy_code,ratediff,incomshare,fxrrn,dtdrefamount | "
					sv_d = sv_d + " select "
					sv_d = sv_d + "  (select gamdrc.foracid foracidcontra from tbaadm.dtd dtddrc,tbaadm.gam gamdrc where  gamdrc.bank_id=dtddrc.bank_id and gamdrc.acid=dtddrc.acid and pstd_flg='Y' and dtddrc.gl_sub_head_code not in ('19002','19702' )  and gam.del_flg='N' and dtddrc.tran_id=dtd.tran_id and dtddrc.tran_date=dtd.tran_date and dtddrc.bank_id=dtd.bank_id and dtddrc.part_tran_srl_num!=dtd.part_tran_srl_num and rownum<2) as foracidcontra, "
					sv_d = sv_d + " (select dtddrc.tran_amt tranamtcontra from tbaadm.dtd dtddrc,tbaadm.gam gamdrc where  gamdrc.bank_id=dtddrc.bank_id and gamdrc.acid=dtddrc.acid and pstd_flg='Y' and dtddrc.gl_sub_head_code not in ('19002','19702' )  and gam.del_flg='N' and dtddrc.tran_id=dtd.tran_id and dtddrc.tran_date=dtd.tran_date and dtddrc.bank_id=dtd.bank_id and dtddrc.part_tran_srl_num!=dtd.part_tran_srl_num and rownum<2) as tranamtcontra, "
					sv_d = sv_d + "  (select dtddrc.ref_amt refamtcontra from tbaadm.dtd dtddrc,tbaadm.gam gamdrc where  gamdrc.bank_id=dtddrc.bank_id and gamdrc.acid=dtddrc.acid and pstd_flg='Y' and dtddrc.gl_sub_head_code not in ('19002','19702' )  and gam.del_flg='N' and dtddrc.tran_id=dtd.tran_id and dtddrc.tran_date=dtd.tran_date and dtddrc.bank_id=dtd.bank_id and dtddrc.part_tran_srl_num!=dtd.part_tran_srl_num and rownum<2) as refamtcontra, "
					sv_d = sv_d + "  (select gamdrc.acct_crncy_code crncycontra from tbaadm.dtd dtddrc,tbaadm.gam gamdrc where  gamdrc.bank_id=dtddrc.bank_id and gamdrc.acid=dtddrc.acid and pstd_flg='Y' and dtddrc.gl_sub_head_code not in ('19002','19702' )  and gam.del_flg='N' and dtddrc.tran_id=dtd.tran_id and dtddrc.tran_date=dtd.tran_date and dtddrc.bank_id=dtd.bank_id and dtddrc.part_tran_srl_num!=dtd.part_tran_srl_num and rownum<2) as crncycontra, "
					sv_d = sv_d + "  (select dtddrc.part_tran_srl_num srlnumcontra from tbaadm.dtd dtddrc,tbaadm.gam gamdrc where  gamdrc.bank_id=dtddrc.bank_id and gamdrc.acid=dtddrc.acid and pstd_flg='Y' and dtddrc.gl_sub_head_code not in ('19002','19702' )  and gam.del_flg='N' and dtddrc.tran_id=dtd.tran_id and dtddrc.tran_date=dtd.tran_date and dtddrc.bank_id=dtd.bank_id and dtddrc.part_tran_srl_num!=dtd.part_tran_srl_num and rownum<2) as srlnumcontra, "
					sv_d = sv_d + "  dtd.part_tran_type,trim(dtd.PART_TRAN_SRL_NUM) SRL_NUM,TRAN_PARTICULAR,TRAN_RMKS,TRAN_SUB_TYPE, TRAN_PARTICULAR_2, REF_NUM ,ENTRY_USER_ID,TRAN_CRNCY_CODE,REF_CRNCY_CODE,RATE_CODE,RATE,TREA_RATE,dtd.tran_amt, "
					sv_d = sv_d + "  gam.foracid,gam.acct_crncy_code,abs(TREA_RATE-RATE) ratediff ,abs((abs(TREA_RATE-RATE)*dtd.tran_amt)) Incomshare,substr((substr(dtd.TRAN_PARTICULAR,instr(dtd.TRAN_PARTICULAR,'/') + 1)),1,instr((substr(dtd.TRAN_PARTICULAR,instr(dtd.TRAN_PARTICULAR,'/') + 1)),'/') - 1) fxrrn ,DTD.REF_AMT dtdrefamount  "
					sv_d = sv_d + "  from tbaadm.dtd,tbaadm.gam where gam.bank_id= ?SVAR and gam.bank_id=dtd.bank_id  "
					sv_d = sv_d + "  and tran_id=lpad(?SVAR,9,' ')  and gam.acid=dtd.acid  "
					sv_d = sv_d + "  and tran_date=to_date(?SVAR,'DD-MM-RR') and pstd_flg='Y' and dtd.gl_sub_head_code!='19002' and dtd.gl_sub_head_code!='19702' "
					sv_d = sv_d + "  and gam.del_flg='N' and TRAN_CRNCY_CODE<>REF_CRNCY_CODE "
					sv_d = sv_d + "  and (part_tran_type=?SVAR OR part_tran_type=?SVAR) and  (PART_TRAN_SRL_NUM  =lpad(?SVAR,4,' ') OR PART_TRAN_SRL_NUM  =lpad(?SVAR,4,' ')) and rownum<2  "
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ATM.TranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.ATM.partTranTypeC + "|" + CUST.ATM.partTranTypeD + "|" + CUST.ATM.PartTranSrlNum1 + "|" + CUST.ATM.PartTranSrlNum2
					print(sv_d)
					print(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbSelectWithBind(sv_d)
					if(sv_u==0)then
						CUST.ATM.tranParticular = BANCS.OUTPARAM.TRAN_PARTICULAR
						print(CUST.ATM.tranParticular)
						CUST.ATM.tranRemarks = BANCS.OUTPARAM.TRAN_RMKS
						print(CUST.ATM.tranRemarks)
						CUST.ATM.transubtype = BANCS.OUTPARAM.TRAN_SUB_TYPE
						print(CUST.ATM.transubtype)
						CUST.ATM.TRAN_PARTICULAR_2 = BANCS.OUTPARAM.TRAN_PARTICULAR_2
						print(CUST.ATM.TRAN_PARTICULAR_2)
						CUST.ATM.REF_NUM = BANCS.OUTPARAM.REF_NUM
						print(CUST.ATM.REF_NUM)
						CUST.ATM.ENTRY_USER_ID = BANCS.OUTPARAM.ENTRY_USER_ID
						print(CUST.ATM.ENTRY_USER_ID)
						CUST.ATM.tran_crncy_code = BANCS.OUTPARAM.tran_crncy_code
						print(CUST.ATM.tran_crncy_code)
						CUST.ATM.ref_crncy_code = BANCS.OUTPARAM.ref_crncy_code
						print(CUST.ATM.ref_crncy_code)
						CUST.ATM.rate_code = BANCS.OUTPARAM.rate_code
						print(CUST.ATM.rate_code)
						CUST.ATM.rate = BANCS.OUTPARAM.rate
						print(CUST.ATM.rate)
						CUST.ATM.trea_rate = BANCS.OUTPARAM.trea_rate
						print(CUST.ATM.trea_rate)
						CUST.ATM.tran_amt = BANCS.OUTPARAM.tran_amt
						print(CUST.ATM.tran_amt)
						CUST.ATM.foracid = BANCS.OUTPARAM.foracid
						print(CUST.ATM.foracid)
						CUST.ATM.ratediff = BANCS.OUTPARAM.ratediff
						print(CUST.ATM.ratediff)
						CUST.ATM.incomshare = BANCS.OUTPARAM.incomshare
						print(CUST.ATM.incomshare)
						CUST.ATM.fxrrn = BANCS.OUTPARAM.fxrrn
						print(CUST.ATM.fxrrn)
						CUST.ATM.acct_crncy_code = BANCS.OUTPARAM.acct_crncy_code
						print(CUST.ATM.acct_crncy_code)
						BANCS.OUTPUT.ReservedField3 = CUST.ATM.fxrrn
						print(BANCS.OUTPUT.ReservedField3)
						##foracidcontra,tranamtcontra,refamtcontra,crncycontra,srlnumcontra,part_tran_type,srl_num
						CUST.ATM.foracidcontra = BANCS.OUTPARAM.foracidcontra
						print(CUST.ATM.foracidcontra)
						CUST.ATM.tranamtcontra = BANCS.OUTPARAM.tranamtcontra
						print(CUST.ATM.tranamtcontra)
						CUST.ATM.refamtcontra = BANCS.OUTPARAM.refamtcontra
						print(CUST.ATM.refamtcontra)
						CUST.ATM.crncycontra = BANCS.OUTPARAM.crncycontra
						print(CUST.ATM.crncycontra)
						CUST.ATM.srlnumcontra = BANCS.OUTPARAM.srlnumcontra
						print(CUST.ATM.srlnumcontra)
						CUST.ATM.part_tran_type = BANCS.OUTPARAM.part_tran_type
						print(CUST.ATM.part_tran_type)
						CUST.ATM.srl_num = BANCS.OUTPARAM.srl_num
						print(CUST.ATM.srl_num)
						CUST.ATM.dtdrefamount = BANCS.OUTPARAM.dtdrefamount
						print(CUST.ATM.dtdrefamount)
						###foracidcontra,tranamtcontra,refamtcontra,crncycontra,srlnumcontra,part_tran_type,srl_num
						IF (CUST.ATM.acct_crncy_code != CUST.ATM.crncycontra) THEN
							IF (CUST.ATM.acct_crncy_code =="USD") THEN
								IF (CUST.ATM.part_tran_type =="D") THEN
									CUST.ATM.ratecodedrc1="CNB"
									print(CUST.ATM.ratecodedrc1)
								ELSE
									CUST.ATM.ratecodedrc1="CNS"
									print(CUST.ATM.ratecodedrc1)
								ENDIF
							ELSE
								IF (CUST.ATM.part_tran_type =="D") THEN
									CUST.ATM.ratecodedrc1="CNS"
									print(CUST.ATM.ratecodedrc1)
								ELSE
									CUST.ATM.ratecodedrc1="CNB"
									print(CUST.ATM.ratecodedrc1)
								ENDIF
							ENDIF
							call("copyBancsToCustC24.scr")
							IF ((BANCS.INPUT.ReservedField2=="CASHOUT") OR (BANCS.INPUT.ReservedField2=="CASHIN")) THEN
								call("AgentShareDRCPOSforex.scr")
							ELSE
								IF (BANCS.INPUT.DccId == "WPD") THEN
									sv_k = MID$(BANCS.INPUT.DeviceId,0,4)
									print(sv_k)
									IF (sv_k=="COAB") THEN
										call("AgentShareDRCPOSforex.scr")
									ENDIF
								ELSE
									call("AgentShareDRCPOSforex.scr")
								ENDIF
							ENDIF
							IF (FIELDEXISTS(BANCS.OUTPUT.successOrFailure)) THEN
								print(BANCS.OUTPUT.successOrFailure)
								IF (BANCS.OUTPUT.successOrFailure=="F") THEN
									BANCS.OUTPUT.RespCode = "99"
									BANCS.OUTPUT.successOrFailure = "F"
									exitscript
								ENDIF
							ENDIF
						ENDIF
					else
						CUST.ATM.pstCnt = 0
					endif
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

############### biller check start
IF ((BANCS.INPUT.DccId == "WPD") OR (BANCS.INPUT.DccId == "WPD")) THEN
	IF (BANCS.INPUT.ReservedField2 != "") THEN 
