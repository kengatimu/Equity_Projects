					IF(CINT(BANCS.OUTPARAM.count) == 0)THEN
					#{
						sv_s = "Insert into CUSTOM.C_NO_OF_WD (mon_yr, foracid, no_of_withdrawal, last_tran_date, last_tran_id, lchg_time, lchg_user_id, rcre_time, rcre_user_id, bank_id)"
						sv_s = sv_s + " Values(?SVAR,?SVAR, ?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY'), ?SVAR,sysdate, ?SVAR, sysdate, ?SVAR, ?SVAR )"
						BANCS.INPARAM.BINDVARS = CUST.ATM.MMYYYY + "|" + CUST.ATM.account + "|1"
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" +MID$(BANCS.OUTPUT.TranDate,0,10) + "|" +  BANCS.OUTPUT.TranId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)

						sv_d = urhk_dbSqlWithBind(sv_s)
						PRINT(sv_d)

						IF(sv_d != 0)THEN
						#{
							BANCS.OUTPUT.ReservedField3 = "Error in DB Operation!!"
							PRINT(BANCS.OUTPUT.ReservedField3)
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.successOrFailure = "F"
							exitscript
