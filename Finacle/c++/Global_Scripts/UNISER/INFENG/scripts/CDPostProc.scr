			IF(sv_h !="Y")THEN
#			#{
			PRINT(BANCS.OUTPARAM.parameterVal)
			CUST.ATM.cwdlLmt = BANCS.OUTPARAM.parameterVal
				CUST.ATM.MMYYYY = MID$(BANCS.STDIN.BODDate,3,2)+RIGHT$(MID$(BANCS.STDIN.BODDate,0,10),4)
