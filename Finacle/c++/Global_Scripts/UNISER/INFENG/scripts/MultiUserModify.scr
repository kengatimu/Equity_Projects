	CREATECLASS("BANCS", "OUTPUT", 5)
ENDIF

IF (BANCS.STDIN.userId=="CN01473") THEN
	exitscript
ENDIF

BANCS.OUTPUT.ReturnCode = "F"
BANCS.OUTPUT.ReturnMesg = "Unverified record.Only the person who created this can modify"


IF ((BANCS.STDIN.menuId == "HPORDM") and (BANCS.INPUT.FunctionCode=="M") and (BANCS.INPUT.RcreUserId == "FIVUSR43")) THEN
	IF ((BANCS.STDIN.userWorkClass !="260") and (BANCS.STDIN.userWorkClass !="071") and (BANCS.STDIN.userWorkClass !="650") and (BANCS.STDIN.userWorkClass !="600")) THEN
		BANCS.OUTPUT.ReturnCode = "F"
		BANCS.OUTPUT.ReturnMesg = "Channel Unverified Record.Only Only Workclass 260/071"
		exitscript
	ENDIF
ENDIF


IF (FIELDEXISTS(BANCS.STDIN.menuId )) THEN
        #CASE WHEN FRONT END IS USED FOR PO CREATION
        IF (FIELDEXISTS(BANCS.STDIN.homeSolId)) THEN
		IF ((BANCS.STDIN.menuId == "HPORDM") and (BANCS.STDIN.homeSolId == "5000")) THEN
		#{
			BANCS.OUTPUT.ReturnCode = "S"
			BANCS.OUTPUT.ReturnMesg = ""
                        exitscript
		#}
                ENDIF
	ENDIF
ENDIF
				
IF(FIELDEXISTS(BANCS.STDIN.menuOption))THEN
        #CASE WHEN FRONT END IS USED FOR PO CREATION
        IF(FIELDEXISTS(BANCS.STDIN.menuId))THEN
                IF(BANCS.STDIN.menuId!="HPORDM")THEN
			BANCS.OUTPUT.ReturnCode = "S"
			BANCS.OUTPUT.ReturnMesg = ""
                        exitscript
                ENDIF

        ELSE
                #CASE WHEN PO IS CREATED VIA BACK END SRV's
                print(BANCS.STDIN.menuOption)
                IF(BANCS.STDIN.menuOption =="") THEN
			BANCS.OUTPUT.ReturnCode = "S"
			BANCS.OUTPUT.ReturnMesg = ""
                        exitscript
                ENDIF

        ENDIF
ELSE
        exitscript

ENDIF

#	These are the values come in the script.
print(BANCS.INPUT.EntererId)
print(BANCS.INPUT.LchgUserId)
print(BANCS.INPUT.RcreUserId)
 
print(BANCS.STDIN.userId)
print(BANCS.STDIN.roleId)
print(BANCS.STDIN.menuOption)
print(BANCS.STDIN.serviceName)

MODIFY.ROLE.EntererId = BANCS.INPUT.EntererId
MODIFY.ROLE.roleId = BANCS.STDIN.roleId
MODIFY.ROLE.bank_id = BANCS.STDIN.contextBankId
