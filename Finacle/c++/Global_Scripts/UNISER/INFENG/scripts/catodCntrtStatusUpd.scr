<--START
CHECKSUM="343cc08b0a4b104408ab3cd2d5fc2fe41987ace60038ab966eb16a42f2e8f39a"
	TRACE ON
	
	#-------------------------------------------------------
	# Query to update status
	#-------------------------------------------------------
	BANCS.INPARAM.BINDVARS = MID$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.contextBankId
	sv_s = "UPDATE CUSTOM.CATOD_SANCTION_TABLE SET STATUS_FLG = 'E',CLS_FLG='Y',REMARKS = NULL WHERE"
	sv_s = sv_s + " ENTITY_CRE_FLG = 'Y' AND STATUS_FLG = 'A' AND"
	sv_s = sv_s + " EXPIRY_DATE<=TO_DATE(?SVAR,'DD-MM-YYYY') AND BANK_ID = ?SVAR"
	sv_d= urhk_dbSqlWithBind(sv_s)
	PRINT(sv_d)
	
	
	TRACE OFF
END-->
