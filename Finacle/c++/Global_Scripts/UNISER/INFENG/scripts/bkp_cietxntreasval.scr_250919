<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	sv_u = urhk_b2k_printrepos("BANCS")
	PRINT(sv_u)
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	CUST.CIETXN.acctCrncy =" "
	CUST.CIETXN.refCrncy=" "
	CUST.CIETXN.rateCode =" "
	CUST.CIETXN.rate="0"
	CUST.CIETXN.treaRate="0"
	CUST.CIETXN.errorFlg="N"
	CUST.CIETXN.errorMsg =" "
	CUST.CIETXN.rate1="0"
	CUST.CIETXN.treaRate1="0"
	CUST.CIETXN.treaRefNum=" "
	CUST.CIETXN.tranType=" "
	CUST.CIETXN.refAmt = " "
	
		CUST.CIETXN.treaRefNum = BANCS.INPUT.treaRefNum
		PRINT(CUST.CIETXN.treaRefNum)

		CUST.CIETXN.acctCrncy = TOUPPER(BANCS.INPUT.acctCrncy)
		PRINT(CUST.CIETXN.acctCrncy)

		CUST.CIETXN.refCrncy = TOUPPER(BANCS.INPUT.refCrncy)
		PRINT(CUST.CIETXN.refCrncy)

		CUST.CIETXN.rateCode1 = BANCS.INPUT.rateCode
		PRINT(CUST.CIETXN.rateCode1)

		CUST.CIETXN.rate1 = CDOUBLE(BANCS.INPUT.rate)
		PRINT(CUST.CIETXN.rate1)

		CUST.CIETXN.treaRate1 = CDOUBLE(BANCS.INPUT.treaRate)
		PRINT(CUST.CIETXN.treaRate1)

		IF(BANCS.STDIN.menuId != "HCASHDX")THEN
		#{
			CUST.CIETXN.tranType = TOUPPER(BANCS.INPUT.tranType)
			PRINT(CUST.CIETXN.tranType)
		#}
		ENDIF
        
		CUST.CIETXN.refAmt = CDOUBLE(BANCS.INPUT.refAmt)
        	PRINT(CUST.CIETXN.refAmt)


	IF((CUST.CIETXN.acctCrncy != "") AND (CUST.CIETXN.refCrncy != "") AND (CUST.CIETXN.acctCrncy != CUST.CIETXN.refCrncy)) THEN
	#{
		###########################################################################################
		# Fetching RATECODE from custom table
		###########################################################################################

		IF(CUST.CIETXN.acctCrncy != CUST.CIETXN.refCrncy) THEN
		#{
			sv_s = "recCount|"
			sv_s = sv_s + " SELECT 1 FROM DUAL WHERE EXISTS("
			sv_s = sv_s + " SELECT 1 FROM TBAADM.CNC"
			sv_s = sv_s + " WHERE CRNCY_CODE = ?SVAR"
			sv_s = sv_s + " AND ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND DEL_FLG != 'Y'"
			sv_s = sv_s + " AND BANK_ID = ?SVAR)"
			PRINT(sv_s)

			BANCS.INPARAM.BINDVARS = CUST.CIETXN.refCrncy + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)

			IF(sv_d != 0)THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Invalid Ref. CCY"
				GOTO ENDOFSCRIPT
			#}
			ENDIF

			IF(BANCS.STDIN.menuId == "HCASHDX")THEN
			#{
				sv_s = "rateCode|select ratecode_cash from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CIETXN.acctCrncy + "|" + CUST.CIETXN.refCrncy + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d ==0) THEN
				#{
					CUST.CIETXN.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.CIETXN.rateCode)

				#}
				ELSE
				#{
					#CUST.CIETXN.errorFlg="Y"
					#CUST.CIETXN.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ELSE
			#{
				IF(CUST.CIETXN.tranType == "C") THEN
				#{
					sv_s = "rateCode| select ratecode_cash from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				#}
				ELSE
				#{
					sv_s = "rateCode| select ratecode_tran from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				#}
				ENDIF
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CIETXN.refCrncy + "|" + CUST.CIETXN.acctCrncy + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d ==0) THEN
				#{
					CUST.CIETXN.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.CIETXN.rateCode)

				#}
				ELSE
				#{
					#CUST.CIETXN.errorFlg="Y"
					#CUST.CIETXN.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF	
		#}
		ENDIF
	#}
	ENDIF
	IF (BANCS.STDIN.moduleIdentity  != "FI") THEN
	#{
		IF(CUST.CIETXN.rateCode1 != CUST.CIETXN.rateCode)THEN
		#{
			CUST.CIETXN.errorFlg="Y"
			CUST.CIETXN.errorMsg="Treasury reference ratecode and defaulted ratecode differs"
			sv_u=urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
			sv_u=urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
			PRINT(sv_u)	
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
	
		sv_s="rate,tresrate,tresrefAmt|SELECT CUST_RATE,TREASURY_RATE,REF_AMT FROM TBAADM.FTRT WHERE TR_REF_NUM=?SVAR AND BANK_ID=?SVAR AND RATECODE=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.treaRefNum + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.rateCode1
	
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d ==0) THEN
			#{
					CUST.CIETXN.rate = CDOUBLE(BANCS.OUTPARAM.rate)
					PRINT(CUST.CIETXN.rate)
					CUST.CIETXN.treaRate = CDOUBLE(BANCS.OUTPARAM.tresrate)
					PRINT(CUST.CIETXN.treaRate)
					CUST.CIETXN.tresrefAmt = CDOUBLE(BANCS.OUTPARAM.tresrefAmt)
					PRINT(CUST.CIETXN.tresrefAmt)
	
			#}
		ENDIF
	
		#IF((CUST.CIETXN.rate1 != CUST.CIETXN.rate) OR (CUST.CIETXN.treaRate1 != CUST.CIETXN.treaRate))THEN
		IF((CUST.CIETXN.rate1 != CUST.CIETXN.rate) OR (CUST.CIETXN.treaRate1 != CUST.CIETXN.treaRate) OR (CUST.CIETXN.tresrefAmt != CUST.CIETXN.refAmt))THEN
		#{
			CUST.CIETXN.errorFlg="Y"
			CUST.CIETXN.errorMsg="Defaulted rate values are not equal to special rate values ,Can't Proceed"
			sv_u=urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
			sv_u=urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
			PRINT(sv_u)	
		#}	
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:

TRACE OFF
				
END-->


