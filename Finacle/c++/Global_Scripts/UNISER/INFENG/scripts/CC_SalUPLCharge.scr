#=======================================================================
# Name                   : CC_SalUPLCharge.scr
# Date                   : 25-10-2024
# Description            : posting balance certificate NOPGS
# MenuOption             : FI
# Author                 : Kelvin Musyoka   
# Called Script          : NA
# Calling Script         : NA
# Reference Document     : NA
# Modification History
# S.No.  Date          Name                 Description
