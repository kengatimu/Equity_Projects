<--START
CHECKSUM="3d4fa9059db686e4023ce186e36d92d3b11da4d19f3912627d989c590b799c4d"
	TRACE ON
	
	###########################################################################################
	# LASPAY Reversal Operation
	###########################################################################################
	
	CUST.HLASPAYREV.cmnDrAcct = ""
	CUST.HLASPAYREV.opAcct = ""
	CUST.HLASPAYREV.opAcid = ""
	
	sv_s = "opAcid|SELECT OP_ACID FROM TBAADM.LAM"
	sv_s = sv_s + " WHERE ACID = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.HLASPAYREV.acid + "|" + CUST.HLASPAYREV.bankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.HLASPAYREV.opAcid = BANCS.OUTPARAM.opAcid
		PRINT(CUST.HLASPAYREV.opAcid)
		sv_u = urhk_B2k_AcidToForacid(CUST.HLASPAYREV.opAcid)
		print(sv_u)
		
		IF(sv_u == 0)THEN
		#{
			CUST.HLASPAYREV.opAcct = BANCS.OUTPARAM.Foracid
			PRINT(CUST.HLASPAYREV.opAcct)
		#}
		ENDIF
		
	#}
	ENDIF
	
