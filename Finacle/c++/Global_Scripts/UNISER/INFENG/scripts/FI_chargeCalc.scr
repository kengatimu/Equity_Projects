<--START
TRACE ON
        #------------------------------------#
        #-- Repository And Class Creation  --#
        #------------------------------------#



		IF(REPEXISTS("CUST") == 0) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF

		IF (CLASSEXISTS("CUST", "CBAL") == 0) THEN
		#{
			CREATECLASS("CUST", "CBAL", 5)
		#}
		ENDIF	

        BANCS.INPUT.moduleName = "STMTCHRGUPLOAD"
        BANCS.INPUT.parameterId = "BALCERT_CHRGS_"+BANCS.STDIN.homeCrncyCode
        print(BANCS.STDIN.contextBankId)
        print(BANCS.INPUT.moduleName)
        print(BANCS.INPUT.parameterId)
        sv_g = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER"
        sv_g = sv_g + " WHERE "
        sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
        sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
        sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
        sv_g = sv_g + " C_CPVALUE.del_flg != 'Y' AND "
        sv_g = sv_g + " C_CPVALUE.entity_cre_flg = 'Y' AND "
        sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
        sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
        sv_g = sv_g + " C_CPMASTER.PARAMETER_ID=?SVAR" 
	print(sv_g)

        
		print(sv_g)



        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.moduleName + "|" + BANCS.INPUT.parameterId
        sv_d = urhk_dbSelectWithBind(sv_g)
        print(sv_d)

  
		IF(sv_d==0)THEN
		#{
			CUST.CBAL.CRNCY= BANCS.STDIN.homeCrncyCode
			PRINT(CUST.CBAL.CRNCY)

			CUST.CBAL.AMT= BANCS.OUTPARAM.parameterVal
			PRINT(CUST.CBAL.AMT)

			#----------------------------------------------------------------------------------------------
			# CHARGE CALCULATION
			#----------------------------------------------------------------------------------------------

			CUST.CBAL.CHARGEAMT= CUST.CBAL.AMT
			print(CUST.CBAL.CHARGEAMT)	

			CUST.CBAL.comm = CINT(CUST.CBAL.CHARGEAMT) * 0.2
			print(CUST.CBAL.comm)
			CUST.CBAL.comm = CINT(CUST.CBAL.comm)
			PRINT(CUST.CBAL.comm)

			CUST.CBAL.exduty= "0"
			PRINT(CUST.CBAL.exduty)

	
			CUST.CBAL.totaldeductions = (CINT(CUST.CBAL.CHARGEAMT) + CINT(CUST.CBAL.comm) + CINT(CUST.CBAL.exduty))
			print(CUST.CBAL.totaldeductions)

			#----------------------------------------------------------------------------------------------
			# SENDING RESPONSE
			#----------------------------------------------------------------------------------------------
			sv_t = "BalCertFee| " +CUST.CBAL.AMT
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "BalCertComm| " + CUST.CBAL.comm
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "BalCertDuty| " + CUST.CBAL.exduty
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "Currency| " + CUST.CBAL.CRNCY
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "TotalBalCertFee| " + CUST.CBAL.totaldeductions 
			sv_u = urhk_SetOrbOut(sv_t)




		#}
		ELSE
		#{
			PRINT("DB ERROR")
		#}
		ENDIF




TRACE OFF
END-->