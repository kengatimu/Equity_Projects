        PRINT(BANCS.INPARAM.BINDVARS)
        print(lv_s)
        lv_d = urhk_dbSelectWithBind(lv_s)
        print(lv_d)
        if(lv_d == 0)then
                EQSRV.GLBDATA.Liamount = BANCS.OUTPARAM.Liamount
        else
                EQSRV.GLBDATA.Liamount = "0"
        endif
        print(EQSRV.GLBDATA.Liamount)
        if(cdouble(EQSRV.GLBDATA.Liamount)>0)then
