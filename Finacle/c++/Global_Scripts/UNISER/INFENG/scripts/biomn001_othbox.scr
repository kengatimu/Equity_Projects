        sv_q = "isValid|select  instr((select listagg(parameter_value,',') "
        sv_q = sv_q + " within group (order by parameter_id) from custom.c_cpvalue "
        sv_q = sv_q + " where parameter_id = '" + BANCS.INPUT.parameterId + "' and module_name = ?SVAR "
        sv_q = sv_q + " and bank_id = ?SVAR ),?SVAR ) from dual"
        print(sv_q)
        BANCS.INPARAM.BINDVARS =  BANCS.INPUT.moduleName
        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.schm_code 
        print(BANCS.INPARAM.BINDVARS)
        sv_i = urhk_dbSelectWithBind(sv_q)
        print(sv_i)
