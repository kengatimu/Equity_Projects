                #}
                ENDIF
        #}
        ENDIF

        #---------------------------------------------------
        # Check whether bio validation should be done for schemes + SOL combination + not for skipping.
		# For the schme defined in this , bio validation will be available and for all the remaining it will skip
        #---------------------------------------------------
        print(BANCS.INPUT.menuId)

        BANCS.OUTPUT.parameterVal = ""
        BANCS.INPUT.moduleName="BIOM"
        BANCS.INPUT.parameterId="BIO_NOT_SKIP_SCHEME_" + BANCS.STDIN.mySolId


	sv_q = "iVal|select parameter_value from custom.c_cpvalue where parameter_id = ?SVAR"
	sv_q = sv_q + " AND module_name = ?SVAR " 
	sv_q = sv_q + " AND BANK_ID = ?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.parameterId + "|" + BANCS.INPUT.moduleName 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
	sv_i = urhk_dbSelectWithBind(sv_q)
        print(sv_i)
        IF ( sv_i == 0 ) THEN
        #{
		if(BANCS.OUTPARAM.iVal == "NA")THEN
		#{
			GOTO ENDOFVAL
		#}
		ENDIF
	#}
	ELSE
	#{
		GOTO ENDOFVAL
	#}
	ENDIF

        sv_q = "isValid|select  instr((select listagg(parameter_value,',') "
        sv_q = sv_q + " within group (order by parameter_id) from custom.c_cpvalue "
        sv_q = sv_q + " where parameter_id = '" + BANCS.INPUT.parameterId + "' and module_name = ?SVAR "
        sv_q = sv_q + " and bank_id = ?SVAR ),?SVAR ) from dual"
        print(sv_q)
        BANCS.INPARAM.BINDVARS = BANCS.INPUT.moduleName
        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.schm_code
        print(BANCS.INPARAM.BINDVARS)
        sv_i = urhk_dbSelectWithBind(sv_q)
        print(sv_i)
        IF ( sv_i == 0 ) THEN
        #{
                sv_v=BANCS.OUTPARAM.isValid
                print(sv_v)
                if(sv_v == 0 )THEN
                #{
                        #Disable for the entity
                        #CUST.INTERFACE.skipBioVal = "Y"
                        #GOTO ENDOFVAL
                #}
                ENDIF
        #}
        ENDIF

	

ENDOFVAL:
	
	CUST.INTERFACE.bioInput = CUST.INTERFACE.skipBioVal + "|" + CUST.INTERFACE.bioUrl +  "&"
	CUST.INTERFACE.bioInput = CUST.INTERFACE.bioInput + CUST.INTERFACE.userCust + "&" 
	CUST.INTERFACE.bioInput = CUST.INTERFACE.bioInput + CUST.INTERFACE.status  + "&"
	CUST.INTERFACE.bioInput = CUST.INTERFACE.bioInput + BANCS.STDIN.contextBankId + "&" 
	CUST.INTERFACE.bioInput = CUST.INTERFACE.bioInput + CUST.INTERFACE.cifId + "&" 
	CUST.INTERFACE.bioInput = CUST.INTERFACE.bioInput + BANCS.STDIN.userId + "&"
	CUST.INTERFACE.bioInput = CUST.INTERFACE.bioInput + CUST.INTERFACE.message + "&" + CUST.INTERFACE.cifValues + "&" + CUST.INTERFACE.modeOfOper+ "&" + CUST.INTERFACE.cifNameValues


	print(CUST.INTERFACE.bioInput)
	sv_v = urhk_SetOrbOut(CUST.INTERFACE.bioInput)
