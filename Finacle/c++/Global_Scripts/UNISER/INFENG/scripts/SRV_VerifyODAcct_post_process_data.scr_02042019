<--START
TRACE ON
        ###########################################################################################
        # Check whether CUST Repository exists else create it
        ###########################################################################################

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        ###########################################################################################
        # Check whether ODACT Class exists else create it
        ###########################################################################################

        sv_r = CLASSEXISTS("CUST","ODACT")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","ODACT",5)
        #}
        ENDIF

	##Script call for collecting disbursement charges
	CALL("crChrgColl.scr")

	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.foracid")
	CUST.ODACT.DrActNum = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.DrActNum)
	
	IF(TRIM(CUST.ODACT.DrActNum) == "")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.acid")
	CUST.ODACT.Dracid = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.Dracid)
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.crncyCode")
	CUST.ODACT.DrcrncyCode = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.DrcrncyCode)
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctInterestTax.intDrAcctId.solId")
	CUST.ODACT.DrsolId = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.DrsolId)
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.foracid")
	CUST.ODACT.foracid = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.foracid)
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId")
	CUST.ODACT.solId = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.solId)
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode")
	CUST.ODACT.schmCode = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.schmCode)
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.acctCrncyCode.crncyCode")
	CUST.ODACT.crncyCode = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.crncyCode)

	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.custId.cifId")
	CUST.ODACT.cifId = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.ODACT.cifId)

	sv_u = urhk_getAcctDetailsInRepository(CUST.ODACT.DrActNum)
	PRINT(sv_u)
	IF(sv_u != "0")THEN
	#{
		sv_u = urhk_SetOrbErr("Invalid opearative account")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.ODACT.DrschmCode= BANCS.OUTPARAM.schmCode
	PRINT(CUST.ODACT.DrschmCode)

        BANCS.INPUT.moduleName  = "OT"
        BANCS.INPUT.parameterId = "ODCA_SCHEMES"
        CALL ("getcparamvalue.scr")
        IF(BANCS.OUTPUT.parameterVal != "")THEN
        #{
                CUST.ODACT.schmparmVal = BANCS.OUTPUT.parameterVal
                #}
        ELSE
                #{
                CUST.ODACT.errorFlg = "Y"
                CUST.ODACT.errorMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                GOTO ENDOFSCRIPT

        #}
        ENDIF

        sv_p = GETPOSITION(CUST.ODACT.schmparmVal,CUST.ODACT.schmCode)
        PRINT(sv_p)

        IF(sv_p <= "0")THEN
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF
	CALL("ODpooling.scr")
	##Script call for collecting disbursement charges
	CALL("crChrgColl.scr")

ENDOFSCRIPT:
TRACE OFF
END-->
