<--START
TRACE ON

	#==============================================================================
	#       Intialising Variables
	#=============================================================================

	CUST.DATA.SOURCEFILE = CUST.DATA.FilePath
	print(CUST.DATA.SOURCEFILE)

	sv_r = urtn_fileAccess(CUST.DATA.SOURCEFILE)
	print(sv_r)
	IF ( sv_r != 0 ) THEN
		sv_r = urhk_TBAF_DispMesg("Unable to Access FILE_LIST")
		sv_v = "UNABLE TO ACCESS THE LIST OF FILES"
		GOTO ENDOFSCRIPT
	ENDIF

	#--------------------------
	#	OPENING THE FILE
	#--------------------------

	sv_t = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	print(sv_t)
	IF (sv_t < 0) THEN
		print("Unable to open the file")
		GOTO ENDOFSCRIPT
	ELSE
		print("File Opened SuccessFully")
		CUST.DATA.succIndex = sv_t
	ENDIF

	#===================================================================================================================
	#       Read The File Data
	#===================================================================================================================

	CUST.DATA.fileRec = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	PRINT(CUST.DATA.fileRec)
	sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
	PRINT(sv_t)
	IF(sv_t != 0) THEN
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "Error_03|ERROR^Upload file is empty^fileName"
		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
	ENDIF

	sv_z = 0
	sv_y = 0
	CUST.DATA.RECCNT = 0
	#=======================================================================================
	#       Split And Storage Of data in file
	#=======================================================================================

	WHILE(sv_t == 0)
	#{

		sv_y =format$(sv_z,"%d")
		CUST.DATA.RECCNT = cint(CUST.DATA.RECCNT)+1
		CUST.DATA.inputRecord         =       TOUPPER(CUST.DATA.inputRecord)
		sv_k = CUST.DATA.inputRecord
	
		sv_g = 0
		sv_n = 1

		sv_c = TRIM(CUST.DATA.inputRecord)
		CUST.DATA.FORACID= sv_c
		print(CUST.DATA.FORACID)

		#===================================================================================================
		#       STORAGE OF DATA INTO CUSTOM TABLE
		#===================================================================================================
			
		sv_s = " INSERT INTO custom.CUST_AUTO_LIEN_INQ (FORACID, RCRE_USER_ID,FILE_NAME,RCRE_TIME) "
		sv_s = sv_s + "  VALUES (?SVAR,?SVAR,?SVAR,sysdate)"
		BANCS.INPARAM.BINDVARS  = CUST.DATA.FORACID +"|"+ BANCS.STDIN.userId  + "|" + CUST.DATA.file_name
		print(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_r =  urhk_dbSQLwithbind(sv_s)
		print(sv_r)
		if(sv_r == 0)then
			sv_r = urhk_dbSQLwithbind("commit")
			print(sv_r)
			if(sv_r == 0)then
				CUST.DATA.sucess = "UPDATE SUCCESSFULL"
				CUST.DATA.scnt="1"
			else
				CUST.DATA.errorMsg  = " UPDATE FAILED"
				sv_r = urhk_dbSQLwithbind("ROLLBACK")
				GOTO NEXTREC1
			endif
		else
			CUST.DATA.errorMsg  = " UPDATE SOME ERROR IN THIS custom.fileupload"
			sv_w =CUST.DATA.errorMsg+"                                  "+CUST.DATA.SOURCEFILE
			print(sv_w)
			sv_r = urhk_dbSQLwithbind("ROLLBACK")
			GOTO NEXTREC1
		endif

		NEXTREC1:
		sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
		PRINT(sv_t)
		sv_z = sv_z + 1


		CUST.DATA.recCount = sv_z
		print(CUST.DATA.recCount)
		sv_y = format$(sv_z,"%d")
		PRINT(sv_y)

	DO
	#===================================================================================#
	# Closing the files                                                                 #
	#===================================================================================#
	sv_j = urtn_fileClose(CUST.DATA.SOURCEFILE)
	print(sv_j)
	sv_t = urtn_fileClose(CUST.DATA.fileRec)
	PRINT(sv_t)
	sv_e = system("mv "+CUST.DATA.FilePath+" "+CUST.DATA.FilePath+"_Done")
	print(sv_e)
	
	##Create Report the lifting lien

		lv_d = urhk_B2k_PID("")
		IF (lv_d == 0) THEN
			CUST.DATA.pid = BANCS.OUTPARAM.PID
			PRINT(CUST.DATA.pid)
		ENDIF
		#-----------------------------------------------------------------------------------------
		#Calling the sql to create the report
		#-----------------------------------------------------------------------------------------
		CUST.DATA.lstFile = "Lien_Inq_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"

		CUST.DATA.inputStr = CUST.DATA.file_name
		print(CUST.DATA.inputStr)

		CUST.DATA.ReportHeader = "FORACID|LIEN_ID|LIEN_AMT|LIEN_REASON_CODE|LIEN_REMARKS|"

		lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
		PRINT(lv_a)
		lv_s = SYSTEM(lv_a)
		PRINT(lv_s)

		sv_a = "exebatch spbx4001" + " " + "CUSTOM.LIEN_LIFT_INQ.LIEN_LIFT_INQ_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
		PRINT(sv_a)
		lv_u = SYSTEM(sv_a)
		PRINT(lv_u)
		IF (lv_u != 0) THEN
		#{
			CUST.DATA.errMsg = "Report generation Failed"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.errMsg)
			GOTO ENDOFSCRIPT
		ELSE
			#=====================================================================
			# Move the file to HPR menu
			#=====================================================================
			CUST.DATA.userId = BANCS.STDIN.userId
			CUST.DATA.title = "Lien Inq Upload REPORT For "+CUST.DATA.file_name
			PRINT(CUST.DATA.title)
			lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
			PRINT(lv_a)
			lv_x = SYSTEM(lv_a)
			PRINT(lv_x)
			if(lv_x == 0) then
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.file_name+". Check status in HPR"
				sv_z = urhk_SetOrbOut(sv_g)
				PRINT(sv_z)
			ELSE
				CUST.DATA.msg = "Error_2|Error.2^Lien Inq Report Generation Failed "
				sv_c = urhk_setorbout("SuccessOrFailure|N")
				sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
				GOTO ENDOFSCRIPT
			ENDIF
		ENDIF

ENDOFSCRIPT:
EXITSCRIPT
#TRACE OFF
END-->
