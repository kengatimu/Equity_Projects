<--START
TRACE ON
        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

	CUST.DATA.recCount = "0"

	sv_u = urhk_SRV_GetVal("revPTranLL.<rec_0>.partTran.tranId")
	PRINT(sv_u)

	CUST.DATA.tranId = BANCS.OUTPARAM.srvValue
	PRINT(CUST.DATA.tranId)
	sv_s = "recCount|SELECT count(*) FROM CUSTOM.C_DNTD WHERE BANK_ID=?SVAR AND TRIM(TRAN_ID)=TRIM(?SVAR)"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.tranId

	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)

        sv_q = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_q)
        IF(sv_q == 0) THEN
        #{

		CUST.DATA.recCount = BANCS.OUTPARAM.recCount
		PRINT(CUST.DATA.recCount)
	#}
	ENDIF

	IF(CUST.DATA.recCount == "0")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	CUST.DATA.tranRmks1 = "DAMAGE NOTES CHARGE REVERSAL TRANSACTION"
	CUST.DATA.tranRmks2 = "DAMAGE NOTES CHARGE REVERSAL TRANSACTION"
	CUST.DATA.tranParticular = "DAMAGE NOTES CHARGE REVERSAL TRANSACTION"

	sv_s = "chrgAmt,vatAmt,crncyCode,acctId,chrgAcctId,vatAcctId,rateCode|SELECT CHARGE_AMT,VAT_AMT,CRNCY_CODE,ACCT_ID,COMM_ACCT_ID,VAT_ACCT_ID,RATE_CODE "
	sv_s = sv_s + "FROM CUSTOM.C_DNTD WHERE BANK_ID=?SVAR AND TRIM(TRAN_ID) = TRIM(?SVAR) AND TO_DATE(TRAN_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY')"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.tranId +"|"+ MID$(BANCS.STDIN.BODDate,0,10)

	sv_q = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_q)
	IF(sv_q == 0)THEN
	#{
		CUST.DATA.chrgAmt = BANCS.OUTPARAM.chrgAmt	
		CUST.DATA.vatAmt = BANCS.OUTPARAM.vatAmt	
		CUST.DATA.acctId = BANCS.OUTPARAM.acctId
		CUST.DATA.crncyCode = BANCS.OUTPARAM.crncyCode
		CUST.DATA.chrgAcctId = BANCS.OUTPARAM.chrgAcctId
		CUST.DATA.vatAcctId = BANCS.OUTPARAM.vatAcctId	
		CUST.DATA.rateCode = BANCS.OUTPARAM.rateCode
		PRINT(CUST.DATA.chrgAmt)
		PRINT(CUST.DATA.vatAmt)
		PRINT(CUST.DATA.acctId)
		PRINT(CUST.DATA.crncyCode)
		PRINT(CUST.DATA.chrgAcctId)
		PRINT(CUST.DATA.vatAcctId)
		PRINT(CUST.DATA.rateCode)


        ### Transaction ##

        sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
        sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|CI")
        sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
        sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")

        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+CUST.DATA.chrgAmt+"|"+ CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+CUST.DATA.chrgAcctId)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+CUST.DATA.tranRmks1)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rateCode.refCode|"+CUST.DATA.rateCode)
        #sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rate|"+CUST.DATA.rate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+CUST.DATA.tranParticular)

        CUST.DATA.tranAmt = CDOUBLE(CUST.DATA.chrgAmt) + CDOUBLE(CUST.DATA.vatAmt)
        #PRINT(CUST.DATA.tranAmt)

        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.DATA.tranAmt+"|"+ CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.DATA.acctId)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|"+CUST.DATA.tranRmks1)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rateCode.refCode|"+CUST.DATA.rateCode)
        #sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rate|"+CUST.DATA.rate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+CUST.DATA.tranParticular)
		
        IF(CUST.DATA.vatAmt == 0)THEN
        #{
                PRINT("NO TAX")
                GOTO NO_TAX
        #}
        ENDIF

        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.key.serial_num|3")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.valueDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_2>.pTranIdentifier.partTranSrlNum|3")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.partTranType.code|D")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.refCrncyCode.crncyCode|"+CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.refAmt|"+CUST.DATA.vatAmt+"|"+ CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.acctId.foracid|"+CUST.DATA.vatAcctId)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.glDate|"+BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.tranRmks|"+CUST.DATA.tranRmks2)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.rateCode.refCode|"+CUST.DATA.rateCode)
        #sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.rate|"+CUST.DATA.rate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.tranParticulars|"+CUST.DATA.tranParticular)

        NO_TAX:
                sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
                sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")

                sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
                PRINT(sv_u)

                IF(sv_u != 0)THEN
                #{
                        sv_u = urhk_CopyOutToIn("")
                        PRINT(sv_u)

                        sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
                        sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")

                        sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
                        PRINT(sv_u)
                #}
                ENDIF

                IF(sv_u != 0)THEN
                #{
                        CUST.DATA.Remarks = "0"
                        CALL("dmgChrgrvrsl001.scr")
                        print(CUST.DATA.Remarks)
                        if(CUST.DATA.Remarks !="0")THEN
                        #{
                                CUST.DATA.errorFlg ="Y"
                                CUST.DATA.Msg ="Error in Posting Charge Transaction. "+CUST.DATA.Remarks
                                GOTO ENDOFSCRIPT
                        #}
                        endif

                        IF(CUST.DATA.srvError == "Y")THEN
                        #{
                                CUST.DATA.errorFlg ="Y"
                                CUST.DATA.scriptSuccess = "N"
                                GOTO ENDOFSCRIPT
                        #}
                        ENDIF
                #}
                ENDIF

                PRINT(BANCS.OUTPARAM.tranId)
                PRINT(BANCS.OUTPARAM.tranDate)

                sv_u = urhk_CopyOutToIn("")

                PRINT(sv_u)

                sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
                sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")

                sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
                PRINT(sv_u)

                IF(sv_u != 0)THEN
                #{
                        sv_u = urhk_CopyOutToIn("")
                        PRINT(sv_u)

                        sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
                        sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")

                        sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
                        PRINT(sv_u)
                #}
                ENDIF

                IF(sv_u != 0)THEN
                #{
                        CALL("dmgChrgrvrsl001.scr")

                        IF(CUST.DATA.srvError == "Y")THEN
                        #{
                                CUST.DATA.errorFlg ="Y"
				CUST.DATA.errorMsg = "Charge transaction Reversal Failed,Please reverse it manually"
                                CUST.DATA.scriptSuccess = "N"
                                GOTO ENDOFSCRIPT
                        #}
                        ENDIF
                #}
                ENDIF

                PRINT(BANCS.OUTPARAM.tranId)
                PRINT(BANCS.OUTPARAM.tranDate)

                CUST.DATA.errorFlg ="N"
                CUST.DATA.tranId1 = BANCS.OUTPARAM.tranId
		
		IF(TRIM(CUST.DATA.tranId) != "")THEN
		#{
			sv_s = "UPDATE CUSTOM.C_DNTD SET TRAN_STATUS='R' WHERE BANK_ID=?SVAR AND TRIM(TRAN_ID)=TRIM(?SVAR)"
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.tranId
                        sv_d = urhk_dbSqlWithBind(sv_s)
