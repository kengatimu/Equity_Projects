	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.messagedatetime^=^"+BANCS.INPARAM.MESSAGEDATETIME+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^sol^=^"+CUST.INTERFACE.mySolId+"^"
