	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	print(BANCS.INPARAM.SEND_RECV_FLG)
	
	## Creating the massage
	CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=NVPSTR,MSG_SUB_TYPE=FINVP###"
