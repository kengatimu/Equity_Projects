		sv_y = "<count>"
		sv_z = "</count>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.repCount = MID$(sv_x, sv_b, (sv_e - sv_b))
			print(CUST.INTERFACE.repCount)
			#}
		ELSE
			#{
			CUST.INTERFACE.repCount = ""
