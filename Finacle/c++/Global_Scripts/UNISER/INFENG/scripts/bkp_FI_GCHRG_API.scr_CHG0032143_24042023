	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|" + CUST.DATA.tranSubType)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.DATA.DebitAccount)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" + CUST.DATA.EventId)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgAmt|" + CUST.DATA.chrgAmt + "|" +CUST.DATA.ChrgCrncy)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" + CUST.DATA.ChrgCrncy)
	print(sv_u)
	
	
	IF(CUST.DATA.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#}
	ELSE
		#{
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
