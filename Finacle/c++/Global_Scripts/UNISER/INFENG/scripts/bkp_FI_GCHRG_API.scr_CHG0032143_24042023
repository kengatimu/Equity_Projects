	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" + CUST.DATA.ChrgCrncy)
	print(sv_u)
	
	
	##################################################
	# FetchDfltGenChrgDt
	##################################################
	IF(CUST.DATA.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltGenChrgDtl|retain_all_output = Y")
