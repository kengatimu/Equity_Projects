	sv_a = urhk_SetUrhkInp("genChrgCrit.gchSrlNum|" + CUST.DATA.gchSrlNum)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|" + CUST.DATA.tranType)
