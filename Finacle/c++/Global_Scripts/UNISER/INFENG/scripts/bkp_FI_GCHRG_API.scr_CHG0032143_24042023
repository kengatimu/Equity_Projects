			WHILE (sv_d <= sv_c)
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_e = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
				PRINT(sv_e)
				
				sv_d = sv_d + 1
				sv_n = sv_n + 1
				sv_d = sv_c + 1
			#}
			DO
