<--START
TRACE ON

	sv_a=urhk_B2K_PrintRepos("BANCS")	
	IF ((REPEXISTS("CUST")) == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF((CLASSEXISTS("CUST","DATA")) == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF


	CUST.DATA.OrgTranId 	= ""
	CUST.DATA.OrgTranDate 	= ""
	CUST.DATA.Narration 	= ""
	CUST.DATA.EventId	= ""
	
