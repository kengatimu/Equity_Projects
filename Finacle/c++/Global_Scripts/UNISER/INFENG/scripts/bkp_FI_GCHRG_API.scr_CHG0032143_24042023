	#{
		sv_s = "tran_particular|"
		sv_s = sv_s + " select tran_particular from"
		sv_s = sv_s + " (select tran_particular from tbaadm.dctd_acli  "
		#sv_s = sv_s + " where (tran_id =LPAD('"+CUST.DATA.OrgTranId+"',9,' ') OR REF_NUM =LPAD('"+CUST.DATA.OrgTranId+"',9,' '))"
		sv_s = sv_s + " where tran_id =LPAD('"+CUST.DATA.OrgTranId+"',9,' ')"
		sv_s = sv_s + " and tran_date = to_date('"+CUST.DATA.OrgTranDate+"','DD-MM-YYYY')"
		sv_s = sv_s + " and part_tran_type ='C'"
		sv_s = sv_s + " and del_flg ='N'"
		sv_s = sv_s + " and pstd_flg ='Y'"
		sv_s = sv_s + " and bank_id ='"+BANCS.STDIN.contextBankId+"'"
		#sv_s = sv_s + " order by tran_amt desc"
		sv_s = sv_s + " ) where rownum < 2"

		PRINT(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)

		IF(sv_d == 0)THEN
		#{
			CUST.DATA.TranParticulars = "SMS CHARGE -" +  BANCS.OUTPARAM.tran_particular
			CUST.DATA.Narration = mid$(CUST.DATA.TranParticulars,0,50)
