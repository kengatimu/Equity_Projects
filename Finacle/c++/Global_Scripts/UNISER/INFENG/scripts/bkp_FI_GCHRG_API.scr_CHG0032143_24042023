				CUST.DATA.ErrorCode = sv_e
				sv_i = sv_i + 1

				CUST.DATA.ErrMsg = CUST.DATA.ErrorCode + " - " + CUST.DATA.Tag + " - " +CUST.DATA.ErrMsg 
