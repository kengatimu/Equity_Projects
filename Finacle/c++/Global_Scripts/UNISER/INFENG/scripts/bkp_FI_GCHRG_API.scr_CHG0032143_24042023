	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|" + CUST.DATA.tranSubType)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.DATA.DebitAccount)
	print(sv_u)
