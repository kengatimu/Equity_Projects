			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
	                        sv_f = FORMAT$(sv_i,"%d")
                                sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
                                print(sv_e)
                                CUST.DATA.ErrMsg = sv_e
                                sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
                                print(sv_e)
                                CUST.DATA.Tag = sv_e
                                sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
                                print(sv_e)
                                CUST.DATA.ErrorCode = sv_e
                                sv_i = sv_i + 1

                                CUST.DATA.ErrMsg = CUST.DATA.ErrorCode + " - " + CUST.DATA.Tag + " - " +CUST.DATA.ErrMsg
                                print(CUST.DATA.ErrMsg)
			#}
			DO
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.OUTPARAM.Xcpn_num) == 1)THEN
		#{
			sv_d = 1
			sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
			WHILE (sv_d <= sv_c)
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_e = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
				PRINT(sv_e)
				
				sv_d = sv_d + 1
				sv_n = sv_n + 1
				sv_d = sv_c + 1
			#}
			DO
		#}
		ENDIF
		
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.DATA.chargeTranId = BANCS.OUTPARAM.tranId
	print(CUST.DATA.chargeTranId)
	CUST.DATA.cTranDate = BANCS.OUTPARAM.tranDate
	CUST.DATA.chargeTranDate = MID$(BANCS.OUTPARAM.tranDate,0,10)
	print(CUST.DATA.chargeTranDate)
	
	#---------------------------------------------------------------------------------------------------
	# Checking for unposted transactions in DTD
	#---------------------------------------------------------------------------------------------------
	#CUST.DATA.chargeTranId = "  5454043"
	sv_s = ""
	sv_s = sv_s + "dCount|SELECT count(1) FROM TBAADM.DTD "
	sv_s = sv_s + " WHERE DTD.tran_id =?SVAR "
	sv_s = sv_s + " AND DTD.TRAN_DATE = to_date(?SVAR,'dd-mm-yyyy')"
	sv_s = sv_s + " AND DTD.pstd_flg = 'N' "
	sv_s = sv_s + " AND DTD.del_flg='N' "
	sv_s = sv_s + " AND DTD.bank_id=?SVAR "
	sv_s = sv_s + " AND ENTRY_USER_ID = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.chargeTranId + "|" + CUST.DATA.chargeTranDate + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	CUST.DATA.dCount = BANCS.OUTPARAM.dCount
	print(CUST.DATA.dCount)
	
        GOTO SUCCESS
        #---------------------------------->
        # Error Setting
        #---------------------------------->
ERROR:
        lv_z = urhk_SetOrbOut("CHARGESTATUS|FAILED")
        lv_z = urhk_SetOrbOut("ERROR|"+CUST.DATA.ErrorMsg)
        GOTO ENDOFSCRIPT

        #---------------------------------->
        # Passing Output
	 #---------------------------------->
SUCCESS:
#	print(CUST.DATA.coltrlSrlNuM)
        lv_z = urhk_SetOrbOut("Message|Charges collected successfully")
	lv_z = urhk_SetOrbOut("TranId|"+CUST.DATA.chargeTranId)
	lv_z = urhk_SetOrbOut("TranDate|"+CUST.DATA.chargeTranDate)
        GOTO ENDOFSCRIPT

ENDOFSCRIPT:
EXITSCRIPT
