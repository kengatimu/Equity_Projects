<--START
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether UBP Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","UBP")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","UBP",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.UBP.refAmt = " "
	CUST.UBP.refCrncy = " "
	CUST.UBP.enteredRefCrncy=" "
	CUST.UBP.acctCrncy = " "
	CUST.UBP.rateCode = " "
	
	CUST.UBP.errorFlg = "N"
	CUST.UBP.errorMsg = ""
	CUST.UBP.rate = ""
	CUST.UBP.treaRate = ""
	CUST.UBP.tranAmt = ""
	CUST.UBP.tranAmtCcy = ""
	CUST.UBP.chgAmt = ""
	CUST.UBP.foracid = ""
	CUST.UBP.chgEvetId = ""
	
	
	
	sv_u = urhk_b2k_printrepos("BANCS")
	PRINT(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.refAmt))THEN
	#{
		IF(TRIM(BANCS.INPUT.refAmt) != "")THEN
		#{
			CUST.UBP.refAmt = TOUPPER(TRIM(BANCS.INPUT.refAmt))
			PRINT(CUST.UBP.refAmt)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.refCrncy1))THEN
	#{
		IF(TRIM(BANCS.INPUT.refCrncy1) != "")THEN
		#{
			CUST.UBP.refCrncy = TOUPPER(TRIM(BANCS.INPUT.refCrncy1))
			PRINT(CUST.UBP.refCrncy)
		#}
		ENDIF
	#}
	ENDIF
	#---------------------------Added by Vikas----------------------------------------------
	IF(FIELDEXISTS(BANCS.INPUT.refCrncy1))THEN
	#{
		IF(TRIM(BANCS.INPUT.refCrncy1) != "")THEN
		#{
			CUST.UBP.enteredRefCrncy = TOUPPER(TRIM(BANCS.INPUT.refCrncy1))
			PRINT(CUST.UBP.enteredRefCrncy)
		#}
		ENDIF
	#}
	ENDIF
	#------------------------------------------------------------------------------------------
	
	IF(FIELDEXISTS(BANCS.INPUT.acctCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctCrncy) != "")THEN
		#{
			CUST.UBP.acctCrncy= TOUPPER(TRIM(BANCS.INPUT.acctCrncy))
			PRINT(CUST.UBP.acctCrncy)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.rateCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.rateCode) != "")THEN
		#{
			CUST.UBP.rateCode= TOUPPER(TRIM(BANCS.INPUT.rateCode))
			PRINT(CUST.UBP.rateCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.rate))THEN
	#{
		IF(TRIM(BANCS.INPUT.rate) != "")THEN
		#{
			CUST.UBP.rate = TOUPPER(TRIM(BANCS.INPUT.rate))
			PRINT(CUST.UBP.rate)
			#}
		ELSE
			#{
			CUST.UBP.rate = ""
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.treaRate))THEN
	#{
		IF(TRIM(BANCS.INPUT.treaRate) != "")THEN
		#{
			CUST.UBP.treaRate = TOUPPER(TRIM(BANCS.INPUT.treaRate))
			PRINT(CUST.UBP.treaRate)
			#}
		ELSE
			#{
			CUST.UBP.treaRate = ""
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.chgEvetId))THEN
	#{
		IF(TRIM(BANCS.INPUT.chgEvetId) != "")THEN
		#{
			CUST.UBP.chgEvetId = TOUPPER(TRIM(BANCS.INPUT.chgEvetId))
			PRINT(CUST.UBP.chgEvetId)
			#}
		ELSE
			#{
			CUST.UBP.chgAmt=" "
			CUST.UBP.tranAmt=CDOUBLE(CUST.UBP.refAmt)
			GOTO NOCHARGE
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.UBP.chgAmt=" "
		CUST.UBP.tranAmt=CDOUBLE(CUST.UBP.refAmt)
		GOTO NOCHARGE
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.foracid))THEN
	#{
		IF(TRIM(BANCS.INPUT.foracid) != "")THEN
		#{
			CUST.UBP.foracid = TOUPPER(TRIM(BANCS.INPUT.foracid))
			PRINT(CUST.UBP.foracid)
		#}
		ENDIF
	#}
	ENDIF
	
	
	#=======================================================================================================
	#--Modified by Vikas
	#=======================================================================================================
	
	
	PRINT(CUST.UBP.refCrncy)
	PRINT(CUST.UBP.enteredRefCrncy)
	PRINT(BANCS.STDIN.homeCrncyCode)
	PRINT(CUST.UBP.rateCode)
	PRINT(CUST.UBP.refAmt)
	PRINT(CUST.UBP.chgEvetId)
	
	
	IF(CUST.UBP.enteredRefCrncy == BANCS.STDIN.homeCrncyCode)THEN
	#{
		CUST.UBP.refAmtInHomeCcy = CUST.UBP.refAmt
		PRINT(CUST.UBP.refAmtInHomeCcy)
		GOTO CHARGE_CALC
		#}
	ELSE
		#{
		BANCS.INPARAM.InputAmount = CUST.UBP.refAmt
		BANCS.INPARAM.FromCurrency = CUST.UBP.enteredRefCrncy
		BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
		BANCS.INPARAM.RateCode = CUST.UBP.rateCode
		BANCS.INPARAM.Rate = 0.0
		
		#   BANCS.INPARAM.Rate = CUST.CIETXN.rate
		BANCS.INPARAM.CustId = ""
		
		sv_u = urhk_B2k_ConvertAmount("")
		PRINT(sv_u)
		
		IF(sv_u == 0)THEN
		#{
			CUST.UBP.refAmtInHomeCcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			PRINT(CUST.UBP.refAmtInHomeCcy)
			#}
		ELSE
			#{
			CUST.UBP.errorFlg = "Y"
			CUST.UBP.errorMsg = "Unable to derive charge amount;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	CHARGE_CALC:
		
		sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" +CUST.UBP.chgEvetId)
		sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +BANCS.STDIN.homeCrncyCode)
		sv_u=urhk_SetUrhkInp("genChrgCrit.contextChrgAmt|"+CUST.UBP.refAmtInHomeCcy+"|"+BANCS.STDIN.homeCrncyCode)
		sv_u=urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|"+BANCS.STDIN.homeCrncyCode)
		
		IF (CUST.UBP.foracid == "")THEN
		#{
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|C")
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|CR")
			#sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" +CUST.UBP.refCrncy)
			#sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.UBP.refCrncy)
			#sv_u =urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|"+CUST.UBP.refCrncy)
			#sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgAmt|"+CUST.UBP.billAmt+"|"+CUST.UBP.refCrncy)
			#}
		ELSE
			#{
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|T")
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|BI")
			sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.UBP.foracid)
			#sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" +CUST.UBP.refCrncy)
			#sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.UBP.refCrncy)
			#sv_u=urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|"+CUST.UBP.refCrncy)
			#sv_u =	urhk_SetUrhkInp("genChrgCrit.contextChrgAmt|"+CUST.UBP.billAmt+"|"+CUST.UBP.refCrncy)
			
		#}
		ENDIF
		#=======================================================================================================
		
		
		
		sv_u = urhk_SetUrhkOut("genChrgDtl.calcAmt|calcAmt")
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltGenChrgDtl|retain_all_output = Y")
		PRINT(sv_u)
		
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				PRINT(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
				#}
			ELSE
				#{
				sv_v = 0
			#}
			ENDIF
			
			IF (sv_v > 0) THEN
			#{
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					PRINT(sv_e)
					sv_i = sv_i + 1
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF
		
		IF(sv_u != 0)THEN
		#{
			CUST.UBP.errorFlg = "Y"
			#CUST.UBP.errorMsg = "Unable to get Charge Details"
			CUST.UBP.errorCode = "UBP_ERR033"
			CALL("ubpdp044.scr")
			CUST.UBP.errorMsg =CUST.UBP.errorDesc
			
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.UBP.chgAmt = BANCS.OUTPARAM.calcAmt
		PRINT(CUST.UBP.chgAmt)
		IF(CUST.UBP.acctCrncy == BANCS.STDIN.homeCrncyCode)THEN
		#{
			IF(CUST.UBP.rateCode == " ")THEN
			#{
				CUST.UBP.tranAmt=CDOUBLE(CUST.UBP.chgAmt)+CDOUBLE(CUST.UBP.refAmt)
				#}
			ELSE
				#{
				CUST.UBP.tranAmt= CDOUBLE(CUST.UBP.refAmt)
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.UBP.tranAmt= CDOUBLE(CUST.UBP.refAmt)
		#}
		ENDIF
		
	NOCHARGE:
		
		IF(CUST.UBP.refCrncy == CUST.UBP.acctCrncy)THEN
		#{
			CUST.UBP.rate = "1.00"
			CUST.UBP.treaRate = "0.00"
			#CUST.UBP.tranAmt = CUST.UBP.refAmt
			CUST.UBP.tranAmtCcy = CUST.UBP.refCrncy
			
			IF(CUST.UBP.refAmt == " ")THEN
			#{
				CUST.UBP.tranAmtCcy = " "
			#}
			ENDIF
			
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.UBP.rateCode == " ")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		###########################################################################################
		# Get Rate From SRV
		###########################################################################################
		PRINT(CUST.UBP.acctCrncy)
		sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.UBP.acctCrncy)
		PRINT(sv_u)
		PRINT(CUST.UBP.refCrncy)
		sv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.UBP.refCrncy)
		PRINT(sv_u)
		PRINT(CUST.UBP.rateCode)
		sv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.UBP.rateCode)
		PRINT(sv_u)
		PRINT(CUST.UBP.tranAmt)
		PRINT(CUST.UBP.acctCrncy)
		sv_u = urhk_SetUrhkInp("fromAmt|"+CUST.UBP.tranAmt+"|"+CUST.UBP.acctCrncy)
		PRINT(sv_u)
		IF(CUST.UBP.rate != "")THEN
		#{
			sv_u = urhk_SetUrhkInp("rate|"+CUST.UBP.rate)
		#}
		ENDIF
		
		IF(CUST.UBP.treaRate != "")THEN
		#{
			sv_u = urhk_SetUrhkInp("treaRate|"+CUST.UBP.treaRate)
		#}
		ENDIF
		
		sv_u = urhk_SetUrhkOut("rate|rate")
		sv_u = urhk_SetUrhkOut("treaRate|treaRate")
		sv_u = urhk_SetUrhkOut("toAmt|toAmt")
		
		sv_u = urhk_ExecSrvNoCommit("SRV_TieredConvCrncy")
		PRINT(sv_u)
		
		IF(sv_u == 0)THEN
		#{
			CUST.UBP.rate = BANCS.OUTPARAM.rate
			PRINT(CUST.UBP.rate)
			
			CUST.UBP.treaRate = BANCS.OUTPARAM.treaRate
			PRINT(CUST.UBP.treaRate)
			
			CUST.UBP.toAmt = BANCS.OUTPARAM.toAmt
			PRINT(CUST.UBP.toAmt)
			
			sv_p = GETPOSITION(CUST.UBP.toAmt,"|")
			PRINT(sv_p)
			
			IF(sv_p > 0)THEN
			#{
				CUST.UBP.tranAmt = MID$(CUST.UBP.toAmt,0,sv_p-1)
				PRINT(CUST.UBP.tranAmt)
				
				BANCS.INPARAM.InputAmount=CUST.UBP.tranAmt
				BANCS.INPARAM.RoundOffAmt= 1.00
				BANCS.INPARAM.RoundOffFlag="L"
				sv_u=urhk_B2k_Roundoff("")
				print(sv_u)
				PRINT(CUST.UBP.tranAmt)
				CUST.UBP.tranAmtCcy = MID$(CUST.UBP.toAmt,sv_p,3)
				PRINT(CUST.UBP.tranAmtCcy)
			#}
			ENDIF
			
			#}
		ELSE
			#{
			
			PRINT(BANCS.OUTPARAM.Fatal_num)
			PRINT(BANCS.OUTPARAM.Error_num)
			PRINT(BANCS.OUTPARAM.Warning_num)
			PRINT(BANCS.OUTPARAM.UserInfo_num)
			PRINT(BANCS.OUTPARAM.Xcpn_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Xcpn_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
			
			sv_d = 1
			sv_n = 1
			sv_c = CINT(BANCS.OUTPARAM.Error_num)
			WHILE (sv_d <= sv_c)
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_b)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_a)
				sv_d = sv_d + 1
				sv_n = sv_n + 1
				sv_d = sv_c + 1
			#}
			DO
			CUST.UBP.errorFlg = "Y"
			CUST.UBP.errorMsg = sv_b
			CUST.UBP.rate = " "
			CUST.UBP.tranAmt = " "
			CUST.UBP.tranAmtCcy = " "
			
		#}
		ENDIF
		
	ENDOFSCRIPT:
		
		IF(CUST.UBP.errorFlg!="") THEN
		#{
			sv_u = urhk_SetOrbOut("errorFlg|"+CUST.UBP.errorFlg)
			PRINT(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("errorFlg|NULL")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF(CUST.UBP.errorMsg!="") THEN
		#{
			sv_u = urhk_SetOrbOut("errorMsg|"+CUST.UBP.errorMsg)
			PRINT(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("errorMsg|NULL")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF(CUST.UBP.rate!="") THEN
		#{
			sv_u = urhk_SetOrbOut("rate|"+CUST.UBP.rate)
			PRINT(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("rate|NULL")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF(CUST.UBP.treaRate!="") THEN
		#{
			sv_u = urhk_SetOrbOut("treaRate|"+CUST.UBP.treaRate)
			PRINT(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("treaRate|NULL")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF(CUST.UBP.chgAmt!="") THEN
		#{
			sv_u = urhk_SetOrbOut("chgAmt|"+CUST.UBP.chgAmt)
			PRINT(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("chgAmt|NULL")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF(CUST.UBP.tranAmt!="") THEN
		#{
			sv_u = urhk_SetOrbOut("totalAmt|"+CUST.UBP.tranAmt)
			PRINT(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("totalAmt|NULL")
			PRINT(sv_u)
		#}
		ENDIF
		
		#sv_u = urhk_SetOrbOut("tranAmtCcy|"+CUST.UBP.tranAmtCcy)
		#print(sv_u)
		
		
