			BANCS.INPARAM.BINDVARS = CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)	
			sv_s = " CTNAgency225 |  select  count (*)  from TBAADM.HTD where acid  = ?SVAR AND BANK_ID  = ?SVAR  AND  PSTD_DATE BETWEEN ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR and  TRAN_SUB_TYPE = 'CI' and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in   "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID ='WPD') "
			sv_s = sv_s + " and tran_amt > 50000  AND (TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM) not in "
			sv_s = sv_s + " (SELECT tran_date,tran_id,part_tran_srl_num FROM (SELECT *  FROM  "
			sv_s = sv_s + " (select  *  from TBAADM.HTD where acid = ?SVAR AND BANK_ID  = ?SVAR AND PSTD_DATE BETWEEN  ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C') and  TRAN_SUB_TYPE = 'CI' and PART_TRAN_TYPE='D'   and  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR  AND DELIVERY_CHANNEL_ID IN ('SWT','WPD')) union "
			sv_s = sv_s + " select  *  from TBAADM.HTD where  acid = ?SVAR AND BANK_ID  = ?SVAR AND  PSTD_DATE BETWEEN  ?SVAR  "  
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C')  and  TRAN_SUB_TYPE = 'NP'  and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID is null)) "
			sv_s = sv_s + " order by PSTD_DATE  ASC)WHERE rownum < 3) "
			print(sv_s)
			sv_b = urhk_dbSelectWithBind(sv_s)			
			IF (sv_s == 0) THEN
			#{
			CUST.GCHRG.CTNAgency225 = BANCS.OUTPARAM.CTNAgency225
			print(CUST.GCHRG.CTNAgency225)		
				IF (CUST.GCHRG.CTNAgency225 > 0) THEN
					
					#{
						CUST.GCHRG.Tot_Amt = -1 * CDOUBLE(CUST.GCHRG.WCHAG7)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.Tot_Amt = CDOUBLE(CUST.GCHRG.Tot_Amt)* CDOUBLE(CUST.GCHRG.CTNAgency225)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.amt7 = CDOUBLE(CUST.GCHRG.WCHAG7)
						PRINT(CUST.GCHRG.amt7)
						CUST.GCHRG.amt7 = CDOUBLE(CUST.GCHRG.amt7)* CDOUBLE(CUST.GCHRG.CTNAgency225)
						PRINT(CUST.GCHRG.amt7)
						CUST.GCHRG.amt = CDOUBLE(CUST.GCHRG.amt) + CDOUBLE(CUST.GCHRG.amt7)
						PRINT(CUST.GCHRG.amt)
					#}
				ENDIF
			#}
			ENDIF
				
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "CI"
				CUST.GCHRG.drAcctId = CUST.GCHRG.foracid
				CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.chrgAmt = CUST.GCHRG.amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(CUST.GCHRG.TMAGENCY)
				CUST.GCHRG.eventId = CUST.GCHRG.TMAGENCY
				
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
					#}
				ELSE
					#{
					PRINT("Failure")
				#}
				ENDIF
						
		norec:
		
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		DO
	
		
	ENDIF


EXITSCRIPT
TRACE OFF
END-->
