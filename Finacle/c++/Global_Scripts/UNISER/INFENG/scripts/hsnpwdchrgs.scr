#------------------------------------------------------------------------------------------------
#  Name            : hsnpwdchrgs.scr
#  Description     : Scripts collect withdraw charges for SB137,SB136,SB135,SB130 done above the two free withdraw
#  Date            : 01-10-2018
#  Author          : James Irungu
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :  (Batch Job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0		   01-10-2018      James Irungu		Original Version
#-----------------------------------------------------------------------------------------------


<--START
TRACE ON
	
	#--------------------------------------------------------------------------
	#  Creation of CUST repository and CHRG class
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("BANCS")
	#}
	ENDIF
	
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "GCHRG")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "GCHRG", 5)
	#}
	ENDIF
	
	
	
	#--------------------------------------------------------------------------
	# Selecting total number of accounts which are not charged
	#--------------------------------------------------------------------------	
	
	
	BANCS.INPUT.moduleName  = "TMCHARGES"
	BANCS.INPUT.parameterId = "WITHCHRG2"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.GCHRG.withevent = BANCS.OUTPUT.parameterVal
		PRINT(CUST.GCHRG.withevent)
		#}
	ELSE
		#{
		CUST.GCHRG.errMsg = "OTC event setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	BANCS.INPUT.parameterId = "INTCHRG"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.GCHRG.INTCHRG = BANCS.OUTPUT.parameterVal
		PRINT(CUST.GCHRG.withevent)
		#}
	ELSE
		#{
		CUST.GCHRG.errMsg = "INTER BRANCH event setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	

	
	BANCS.INPUT.parameterId = "ATMCHRG"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.GCHRG.TMATM = BANCS.OUTPUT.parameterVal
		PRINT(CUST.GCHRG.TMATM)
		#}
	ELSE
		#{
		CUST.GCHRG.errMsg = "ATM CHARGE event setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	
	BANCS.INPUT.parameterId = "AGNCYCHRG"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.GCHRG.TMAGENCY = BANCS.OUTPUT.parameterVal
		PRINT(CUST.GCHRG.TMAGENCY)
		#}
	ELSE
		#{
		CUST.GCHRG.errMsg = "AGENCY CHARGE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF



CUST.GCHRG.WCHBR = "120"      
CUST.GCHRG.WCHINBR = "180"
CUST.GCHRG.WCHATM = "36"
CUST.GCHRG.WCHAG1 = "30"
CUST.GCHRG.WCHAG2 = "54"
CUST.GCHRG.WCHAG3 = "90"
CUST.GCHRG.WCHAG4 = "174"
CUST.GCHRG.WCHAG5 = "204"
CUST.GCHRG.WCHAG6 = "234"
CUST.GCHRG.WCHAG7 = "270"


	sv_b = "DATEFRO|select to_char(sysdate,'MON-yyyy') from dual "
	PRINT (sv_b)
	sv_d = urhk_dbselectWithBind(sv_b)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.GCHRG.DATEFRO = "01" + "-" + BANCS.OUTPARAM.DATEFRO
		PRINT(CUST.GCHRG.DATEFRO)
		
	#}
	ENDIF


	sv_b = "DATETO|select to_char(sysdate,'DD-MON-yyyy') from dual "
	PRINT (sv_b)
	sv_d = urhk_dbselectWithBind(sv_b)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.GCHRG.DATETO = BANCS.OUTPARAM.DATETO
		PRINT(CUST.GCHRG.DATETO)
		
	#}
	ENDIF

	#--------------------------------------------------------------------------
	# Selecting total number of accounts which to charge
	#--------------------------------------------------------------------------

	sv_a = " ACID| select acid from tbaadm.gam where schm_code in ('SB130','SB135','SB136','SB137') AND BANK_ID = ?SVAR and sol_id =?SVAR "
	print(sv_a)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_e = urhk_dbCursorOpenWithBind(sv_a)
	IF(sv_e==0) THEN
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
				IF(sv_q == 1) THEN
					sv_x = urhk_dbCursorClose(sv_m)
					print(sv_x)
					exitscript
				ENDIF
			print(sv_q)

	WHILE (sv_q==0)		
			CUST.GCHRG.ACID = BANCS.OUTPARAM.ACID
			print(CUST.GCHRG.ACID)				
			
			sv_s = " count4| SELECT count(*)  FROM "
			sv_s = sv_s + " (select  *  from TBAADM.HTD where acid = ?SVAR AND BANK_ID  = ?SVAR AND PSTD_DATE BETWEEN ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR and  TRAN_TYPE in ('T','C') and  TRAN_SUB_TYPE = 'CI' and PART_TRAN_TYPE='D'  and  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR  AND DELIVERY_CHANNEL_ID IN ('SWT','WPD')) union "
			sv_s = sv_s + " select  *  from TBAADM.HTD where acid = ?SVAR AND BANK_ID  = ?SVAR AND  PSTD_DATE BETWEEN ?SVAR  "  
			sv_s = sv_s + " AND ?SVAR and  TRAN_TYPE in ('T','C')  and  TRAN_SUB_TYPE = 'NP'  and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID is null)) "
			print(sv_s)
		 BANCS.INPARAM.BINDVARS = CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
		 BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
		 PRINT(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_s)
		IF(sv_b==0) THEN		
			CUST.GCHRG.count4 = BANCS.OUTPARAM.count4
			print(CUST.GCHRG.count4)
			IF (cint(CUST.GCHRG.count4) < 3) THEN
				GOTO norec
			ENDIF
		ENDIF

		sv_a = " foracid| select foracid from tbaadm.gam where ACID = ?SVAR AND BANK_ID = ?SVAR "
		print(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_a)			
			IF (sv_a == 0) THEN
				CUST.GCHRG.foracid = BANCS.OUTPARAM.foracid
				print(CUST.GCHRG.foracid)
			ENDIF


			####----------------------------------------------------------------------####
			#Collecting cumulative charges for home branch Cash withdraw during the month
			####----------------------------------------------------------------------####

			BANCS.INPARAM.BINDVARS = CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_s = " CNTDomicile | select  count (*)  from TBAADM.HTD where acid  = ?SVAR AND BANK_ID  = ?SVAR  AND  PSTD_DATE BETWEEN ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR and TRAN_TYPE in ('T','C')  and  TRAN_SUB_TYPE = 'NP' and  SOL_ID = DTH_INIT_SOL_ID and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in   "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID is null) and  "
			sv_s = sv_s + " (TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM) not in "
			sv_s = sv_s + " (SELECT tran_date,tran_id,part_tran_srl_num FROM (SELECT *  FROM  "
			sv_s = sv_s + " (select  *  from TBAADM.HTD where acid = ?SVAR AND BANK_ID  = ?SVAR AND PSTD_DATE BETWEEN  ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C') and  TRAN_SUB_TYPE = 'CI' and PART_TRAN_TYPE='D'   and  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR  AND DELIVERY_CHANNEL_ID IN ('SWT','WPD')) union "
			sv_s = sv_s + " select  *  from TBAADM.HTD where  acid = ?SVAR AND BANK_ID  = ?SVAR AND  PSTD_DATE BETWEEN  ?SVAR  "  
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C')  and  TRAN_SUB_TYPE = 'NP'  and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID is null)) "
			sv_s = sv_s + " order by PSTD_DATE  ASC)WHERE rownum < 3)  "
			print(sv_s)
			sv_b = urhk_dbSelectWithBind(sv_s)			
			IF (sv_s == 0) THEN
			#{
				CUST.GCHRG.CNTDomicile = BANCS.OUTPARAM.CNTDomicile
				print(CUST.GCHRG.CNTDomicile)
							
					IF (CUST.GCHRG.CNTDomicile > 0) THEN
					
					#{
						CUST.GCHRG.Tot_Amt = -1 * CDOUBLE(CUST.GCHRG.WCHBR)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.Tot_Amt = CDOUBLE(CUST.GCHRG.Tot_Amt)* CDOUBLE(CUST.GCHRG.CNTDomicile)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.amt = CDOUBLE(CUST.GCHRG.WCHBR)
						PRINT(CUST.GCHRG.amt)
						CUST.GCHRG.amt = CDOUBLE(CUST.GCHRG.amt)* CDOUBLE(CUST.GCHRG.CNTDomicile)
						PRINT(CUST.GCHRG.amt)
						
					#}
				ELSE
					#{
						CUST.GCHRG.amt = "0.00"
					#}
				ENDIF
				
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "CI"
				CUST.GCHRG.drAcctId = CUST.GCHRG.foracid
				CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.chrgAmt = CUST.GCHRG.amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(CUST.GCHRG.withevent)
				CUST.GCHRG.eventId = CUST.GCHRG.withevent
				
				CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
						#}
					ELSE
						#{
						PRINT("Failure")
					#}
					ENDIF
			#}
			ENDIF

			
			####----------------------------------------------------------------------####
			#Collecting cumulative charges for Inter branch Cash withdraw during the month
			####----------------------------------------------------------------------####

			BANCS.INPARAM.BINDVARS = CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_s = " CNTInterSol | select  count (*)  from TBAADM.HTD where acid  = ?SVAR AND BANK_ID  = ?SVAR  AND  PSTD_DATE BETWEEN ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR and TRAN_TYPE in ('T','C') and  TRAN_SUB_TYPE = 'NP' and  SOL_ID != DTH_INIT_SOL_ID and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in   "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID is null) and  "
			sv_s = sv_s + " (TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM) not in "
			sv_s = sv_s + " (SELECT tran_date,tran_id,part_tran_srl_num FROM (SELECT *  FROM  "
			sv_s = sv_s + " (select  *  from TBAADM.HTD where acid = ?SVAR AND BANK_ID  = ?SVAR AND PSTD_DATE BETWEEN  ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C') and  TRAN_SUB_TYPE = 'CI' and PART_TRAN_TYPE='D'   and  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR  AND DELIVERY_CHANNEL_ID IN ('SWT','WPD')) union "
			sv_s = sv_s + " select  *  from TBAADM.HTD where  acid = ?SVAR AND BANK_ID  = ?SVAR AND  PSTD_DATE BETWEEN  ?SVAR  "  
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C')  and  TRAN_SUB_TYPE = 'NP'  and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID is null)) "
			sv_s = sv_s + " order by PSTD_DATE  ASC)WHERE rownum < 3)  "
			print(sv_s)
			print(sv_s)
			sv_b = urhk_dbSelectWithBind(sv_s)			
			IF (sv_s == 0) THEN
			#{
			CUST.GCHRG.CNTInterSol = BANCS.OUTPARAM.CNTInterSol
			print(CUST.GCHRG.CNTInterSol)

					IF (CUST.GCHRG.CNTInterSol > 0) THEN				

					#{
						CUST.GCHRG.Tot_Amt = -1 * CDOUBLE(CUST.GCHRG.WCHINBR)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.Tot_Amt = CDOUBLE(CUST.GCHRG.Tot_Amt)* CDOUBLE(CUST.GCHRG.CNTInterSol)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.amt = CDOUBLE(CUST.GCHRG.WCHINBR)
						PRINT(CUST.GCHRG.amt)
						CUST.GCHRG.amt = CDOUBLE(CUST.GCHRG.amt)* CDOUBLE(CUST.GCHRG.CNTInterSol)
						PRINT(CUST.GCHRG.amt)
						
						#}
					ELSE
						#{
						CUST.GCHRG.amt = "0.00"
					#}
				ENDIF
				
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "CI"
				CUST.GCHRG.drAcctId = CUST.GCHRG.foracid
				CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.chrgAmt = CUST.GCHRG.amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(CUST.GCHRG.INTCHRG)
				CUST.GCHRG.eventId = CUST.GCHRG.INTCHRG
				
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
					#}
				ELSE
					#{
					PRINT("Failure")
				#}
				ENDIF
			#}
			ENDIF
			
			####----------------------------------------------------------------------####
			#Collecting cumulative charges for ATM withdraw during the month
			####----------------------------------------------------------------------####

			BANCS.INPARAM.BINDVARS = CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)			
			sv_s = " CNTAtm| select  count (*)  from TBAADM.HTD where acid  = ?SVAR AND BANK_ID  = ?SVAR  AND  PSTD_DATE BETWEEN ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR and  TRAN_SUB_TYPE = 'CI' and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in   "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID ='SWT') and  "
			sv_s = sv_s + " (TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM) not in "
			sv_s = sv_s + " (SELECT tran_date,tran_id,part_tran_srl_num FROM (SELECT *  FROM  "
			sv_s = sv_s + " (select  *  from TBAADM.HTD where acid = ?SVAR AND BANK_ID  = ?SVAR AND PSTD_DATE BETWEEN  ?SVAR  "
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C') and  TRAN_SUB_TYPE = 'CI' and PART_TRAN_TYPE='D'   and  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR  AND DELIVERY_CHANNEL_ID IN ('SWT','WPD')) union "
			sv_s = sv_s + " select  *  from TBAADM.HTD where  acid = ?SVAR AND BANK_ID  = ?SVAR AND  PSTD_DATE BETWEEN  ?SVAR  "  
			sv_s = sv_s + " AND  ?SVAR  and TRAN_TYPE in ('T','C')  and  TRAN_SUB_TYPE = 'NP'  and PART_TRAN_TYPE='D'  AND  (TRAN_DATE,TRAN_ID) in  "
			sv_s = sv_s + " (select TRAN_DATE,TRAN_ID from tbaadm.hth where  BANK_ID  = ?SVAR AND DELIVERY_CHANNEL_ID is null)) "
			sv_s = sv_s + " order by PSTD_DATE  ASC)WHERE rownum < 3) "
			print(sv_s)
			sv_b = urhk_dbSelectWithBind(sv_s)			
			IF (sv_s == 0) THEN
			#{
			CUST.GCHRG.CNTAtm = BANCS.OUTPARAM.CNTAtm
			print(CUST.GCHRG.CNTAtm)
				IF (CUST.GCHRG.CNTAtm > 0) THEN
				

					#{
						CUST.GCHRG.Tot_Amt = -1 * CDOUBLE(CUST.GCHRG.WCHATM)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.Tot_Amt = CDOUBLE(CUST.GCHRG.Tot_Amt)* CDOUBLE(CUST.GCHRG.CNTAtm)
						PRINT(CUST.GCHRG.Tot_Amt)
						CUST.GCHRG.amt = CDOUBLE(CUST.GCHRG.WCHATM)
						PRINT(CUST.GCHRG.amt)
						CUST.GCHRG.amt = CDOUBLE(CUST.GCHRG.amt)* CDOUBLE(CUST.GCHRG.CNTAtm)
						PRINT(CUST.GCHRG.amt)
						
						#}
					ELSE
						#{
						CUST.GCHRG.amt = "0.00"
					#}
				ENDIF
				
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "CI"
				CUST.GCHRG.drAcctId = CUST.GCHRG.foracid
				CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.chrgAmt = CUST.GCHRG.amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(CUST.GCHRG.TMATM)
				CUST.GCHRG.eventId = CUST.GCHRG.TMATM
				
				CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
						#}
					ELSE
						#{
						PRINT("Failure")
					#}
					ENDIF
			#}
			ENDIF
			
			####----------------------------------------------------------------------####
			#Collecting cumulative charges for Agency withdraw during the month 
			####----------------------------------------------------------------------####
#tran_amt <= 2500

CUST.GCHRG.amt = "0.00"

			BANCS.INPARAM.BINDVARS = CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.GCHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.GCHRG.DATEFRO  + "|" +  CUST.GCHRG.DATETO  + "|" + BANCS.STDIN.contextBankId
