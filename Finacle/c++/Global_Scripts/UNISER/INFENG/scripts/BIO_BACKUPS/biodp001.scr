#*******************************************************************************************************
# Filename              : biodp001.scr
# Description           : This script is used to make connection with the third party for bio validation
# Input                 : cif id
# Output                : succes/failure
# Called Script         : NIL
# Calling Script        : biomn001.scr
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----          -----            --------          ----------------        ---------
#  1           25-09-2013         Dileep 	 Original Version          1.0
#********************************************************************************************************
<--START
CHECKSUM="48e185cc33b2e033598836cdd008a5deeabaa727ab76d55cf9c328c9132027d3"
	#TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","INTERFACE") == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	CUST.INTERFACE.RequestParam=CUST.INTERFACE.cifId
	print(CUST.INTERFACE.RequestParam)
	
	CUST.INTERFACE.interfaceRequestID = "BioValidation"
	CUST.INTERFACE.interfaceRequestVersion = "10.2"
	CUST.INTERFACE.bodyXMLMsg=CUST.INTERFACE.RequestParam
	CUST.INTERFACE.URL=""
	
	BANCS.INPARAM.Day=LEFT$(BANCS.STDIN.sysDate,2)
	BANCS.INPARAM.Month=MID$(BANCS.STDIN.sysDate,3,2)
	BANCS.INPARAM.Year=MID$(BANCS.STDIN.sysDate,8,2)
	BANCS.INPARAM.Hour=MID$(BANCS.STDIN.sysDate,11,2)
	BANCS.INPARAM.Minute=MID$(BANCS.STDIN.sysDate,14,2)
	BANCS.INPARAM.Second=MID$(BANCS.STDIN.sysDate,17,2)
	BANCS.INPARAM.SYSDATE=BANCS.INPARAM.Second+BANCS.INPARAM.Minute+BANCS.INPARAM.Day+BANCS.INPARAM.Month+BANCS.INPARAM.Year
	
	
	BANCS.INPARAM.UserApplId                = "FINCORE"
	BANCS.INPARAM.MESSAGEDATETIME		= BANCS.INPARAM.SYSDATE
	BANCS.INPARAM.RequestUUID               = BANCS.INPARAM.UserApplId + BANCS.INPARAM.SYSDATE
	BANCS.INPARAM.CHANNELID                 = "COR"
	BANCS.INPARAM.TIMEZONE                  = "GMT+05:30"
	BANCS.INPARAM.BANKID                    = BANCS.STDIN.contextBankId
	BANCS.INPARAM.ServiceReqId              = CUST.INTERFACE.interfaceRequestID
	BANCS.INPARAM.SERVICEREQUESTVERSION     = CUST.INTERFACE.interfaceRequestVersion
	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	
	
	CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=NVPSTR,MSG_SUB_TYPE=FINVP###"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "reqhdr.servicerequestversion^=^"+CUST.INTERFACE.interfaceRequestVersion+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.requestuuid^=^"+BANCS.INPARAM.RequestUUID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.servicerequestid^=^"+CUST.INTERFACE.interfaceRequestID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.origchannelid^=^"+BANCS.INPARAM.CHANNELID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.bankid^=^"+BANCS.INPARAM.BANKID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.messagedatetime^=^"+BANCS.INPARAM.MESSAGEDATETIME+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^body^=^"+CUST.INTERFACE.bodyXMLMsg+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^URL^=^"+CUST.INTERFACE.URL
	sv_a = CUST.INTERFACE.reqXMLMsg
	
	PRINT(sv_a)
	
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	
	PRINT(sv_l)
	IF (sv_l != 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.ErrMsg)
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		CUST.INTERFACE.errorMsgCode = "FIERR"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF (BANCS.OUTPARAM.ErrMsg != "") THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
		CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		CUST.INTERFACE.errorMsgCode = "FIERR"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
		PRINT(CUST.INTERFACE.respXMLMsg)
		CUST.INTERFACE.errorMsgFlg = ""
		CUST.INTERFACE.errorMsgDesc = ""
	#}
	ENDIF
	
	
	
	sv_x = CUST.INTERFACE.respXMLMsg
	sv_y = "<Status>"
	sv_z = "</Status>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
	ELSE
		#{
		CUST.INTERFACE.tranStatus = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.tranStatus)
	#--------------------------------------------------------------------------------------------------------
	# If Success fetching tran id else fetching error code and description
	#--------------------------------------------------------------------------------------------------------
	IF((CUST.INTERFACE.tranStatus == "SUCCESS") OR (CUST.INTERFACE.tranStatus == "FAILURE")) THEN
	#{
		
		CUST.INTERFACE.errorMsgFlg = "N"
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<RESULT>"
		sv_z = "</RESULT>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.tranId = MID$(sv_x, sv_b, (sv_e - sv_b))
			print(CUST.INTERFACE.tranId)
		#}
		ENDIF
		
		IF(CUST.INTERFACE.tranId == "") THEN
		#{
			CUST.INTERFACE.errorMsgFlg = "Y"
			CUST.INTERFACE.errorCode = "SYSERR"
			CUST.INTERFACE.errorDesc = "Could not get response from server"
		#}
		ENDIF
		
		sv_x = CUST.INTERFACE.tranId
		sv_y = "message"
		sv_z = "}}"
		sv_u = "status"
		sv_a = GETPOSITION(sv_x,sv_u) + STRLEN(sv_u) + 2
		sv_b = GETPOSITION(sv_x,sv_y) + STRLEN(sv_y) + 2
		sv_e = GETPOSITION(sv_x,sv_z) - 2
		sv_c = GETPOSITION(sv_x,sv_y) - 4
		CUST.INTERFACE.message = MID$(sv_x, sv_b, (sv_e - sv_b) )
		CUST.INTERFACE.status = MID$(sv_x, sv_a , (sv_c - sv_a) )
		print(CUST.INTERFACE.message)
		print(CUST.INTERFACE.status)
		#}
	ELSE
		#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorCode = "SYSERR"
		CUST.INTERFACE.errorDesc = "Could not get response from server"
		sv_c = "Error_1|" + CUST.INTERFACE.errorCode + "^" + CUST.INTERFACE.errorDesc + "^BE"
		sv_c = urhk_SetOrbOut(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
		#TRACE OFF
END-->
