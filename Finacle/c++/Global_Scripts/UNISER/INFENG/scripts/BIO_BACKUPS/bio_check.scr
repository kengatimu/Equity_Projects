			CUST.INTERFACE.status="3"
			PRINT(CUST.INTERFACE.status)
		#}
		ENDIF
		
		sv_x = CUST.INTERFACE.tranId
		sv_y = "message"
		sv_z = "}}"
		sv_u = "status"
		sv_a = GETPOSITION(sv_x,sv_u) + STRLEN(sv_u) + 2
