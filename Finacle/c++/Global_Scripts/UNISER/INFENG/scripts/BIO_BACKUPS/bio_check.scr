		CUST.INTERFACE.message = MID$(sv_x, sv_b, (sv_e - sv_b) )
		PRINT(CUST.INTERFACE.message)
		CUST.INTERFACE.status = MID$(sv_x, sv_a , (sv_c - sv_a) )
		PRINT(CUST.INTERFACE.status)
