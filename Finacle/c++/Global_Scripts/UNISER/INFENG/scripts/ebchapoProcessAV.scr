	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<PostalCode>90124</PostalCode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Country>KE</Country>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<AddrType/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</PostAddr>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</BankInfo>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</SBAcctId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SBAcctGenInfo>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<EotEnabled/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<DrIntMethodInd/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CorpRepresentativeSigFlg/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<MinStmtFreqPeriod>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Days/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Months/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</MinStmtFreqPeriod>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<MinStmtRequiredFlg/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<DebitIntPrenotificationInd/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<GenLedgerSubHead>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<GenLedgerSubHeadCode/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CurCode/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</GenLedgerSubHead>"
		EQSRV.GLBDATA.AcctName = EQSRV.GLBDATA.FirstName + " " + EQSRV.GLBDATA.LastName 
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<AcctName>"+EQSRV.GLBDATA.AcctName+"</AcctName>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<AcctShortName>"+EQSRV.GLBDATA.FirstName+"</AcctShortName>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<AcctStmtMode/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<AcctStmtFreq>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Cal>00</Cal>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Type>H</Type>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<StartDt>01</StartDt>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<WeekDay/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<WeekNum/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<HolStat>N</HolStat>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</AcctStmtFreq>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<DespatchMode>C</DespatchMode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</SBAcctGenInfo>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<RelPartyRec>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<RelPartyType>M</RelPartyType>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CustId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CustId>"+EQSRV.GLBDATA.CifId+"</CustId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</CustId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<RelPartyContactInfo>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<PostAddr>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Addr1>"+EQSRV.GLBDATA.AddrLine1+"</Addr1>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<StateProv>KEN</StateProv>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<PostalCode>90124</PostalCode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Country>KE</Country>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</PostAddr>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</RelPartyContactInfo>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<RecDelFlg/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</RelPartyRec>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</SBAcctAddRq>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SBAcctAddCustom_CustomData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<INTCRACCTFLG>S</INTCRACCTFLG>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<INTDRACCTFLG>S</INTDRACCTFLG>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<NRE>N</NRE>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<BORROWERCAT>SOLE</BORROWERCAT>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<ADVPURPOSE>BEXPA</ADVPURPOSE>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<VerifyReqFlg>Y</VerifyReqFlg>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SOLID>"+EQSRV.GLBDATA.PrimarySolId+"</SOLID>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<FREETEXT>COR</FREETEXT>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<ACCT_MGR>"+BANCS.STDIN.userId+"</ACCT_MGR>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CRCOMPRESTIND>M</CRCOMPRESTIND>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<MODE_OF_OPER_CODE>SELF</MODE_OF_OPER_CODE>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</SBAcctAddCustom_CustomData>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</SBAcctAddRequest>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</Body>"
	print(EQSRV.GLBDATA.bodyXMLMsg)
	EQSRV.GLBDATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "<FIXML>"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.headerXML
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.bodyXMLMsg
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "</FIXML>"

	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	sv_a = EQSRV.GLBDATA.reqXMLMsg
	PRINT(sv_a)
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	if(sv_l != 0)then
	print(BANCS.OUTPARAM.ErrMsg)
	EQSRV.GLBDATA.scrValYN = "N"
	EQSRV.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
	if(BANCS.OUTPARAM.ErrMsg != "") then
		EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
                        goto ENDSCR
                endif
        else
                        EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                        print(EQSRV.GLBDATA.respXMLMsg)
                        EQSRV.GLBDATA.scrValYN = "Y"
                        EQSRV.GLBDATA.valerr = ""
        endif
        sv_x = EQSRV.GLBDATA.respXMLMsg
        sv_y = "<Status>"
        sv_z = "</Status>"
        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
        sv_e = GETPOSITION(sv_x, sv_z) - 1
        if (GETPOSITION(sv_x, sv_y) != 0) then
                EQSRV.GLBDATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
        else
                EQSRV.GLBDATA.tranStatus = ""
        endif
        print(EQSRV.GLBDATA.tranStatus)
        if(EQSRV.GLBDATA.tranStatus == "SUCCESS") then
                sv_x = EQSRV.GLBDATA.respXMLMsg
                sv_y = "<AcctId>"
                sv_z = "</AcctId>"
                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                sv_e = GETPOSITION(sv_x, sv_z) - 1
                if (GETPOSITION(sv_x, sv_y) != 0) then
                        EQSRV.GLBDATA.AcctId = MID$(sv_x, sv_b, (sv_e - sv_b))
                endif
                if(EQSRV.GLBDATA.AcctId == "") then
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = "Could Not Get Response from Server"
                        goto ENDSCR
                else
                        print(EQSRV.GLBDATA.AcctId)
                endif
        else
                if(EQSRV.GLBDATA.tranStatus == "FAILED") then
                        sv_x = EQSRV.GLBDATA.respXMLMsg
                        sv_y = "<ErrorCode>"
                        sv_z = "</ErrorCode>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1
                        if(GETPOSITION(sv_x, sv_y) != 0) then
                                EQSRV.GLBDATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
                        endif
                        sv_x = EQSRV.GLBDATA.respXMLMsg
                        sv_y = "<ErrorDesc>"
                        sv_z = "</ErrorDesc>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1
                        if(GETPOSITION(sv_x, sv_y) != 0) then
                                EQSRV.GLBDATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
                        endif
                endif
                if((EQSRV.GLBDATA.errorCode == "") AND (EQSRV.GLBDATA.errorDesc == "")) then
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = "Could Not Get Response from Server"
                        goto ENDSCR
                else
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = EQSRV.GLBDATA.errorCode + ":" + EQSRV.GLBDATA.errorDesc
                        goto ENDSCR
                endif
        endif
	if(EQSRV.GLBDATA.AcctId!="")then
		print(EQSRV.GLBDATA.AcctId)
		EQSRV.GLBDATA.scrValYN = "Y"
		EQSRV.GLBDATA.valerr = "Hapo Hapo Customer Onboarded Successfully with NationalId: " + EQSRV.GLBDATA.IDRefNum +" CifId: " + EQSRV.GLBDATA.CifId + " AccountId: " + EQSRV.GLBDATA.AcctId 
	endif
ENDSCR:
	exitscript
###trace off
end-->
