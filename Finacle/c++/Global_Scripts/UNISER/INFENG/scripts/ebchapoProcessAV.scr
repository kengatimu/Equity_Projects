<--start
trace on
#Reps/Class
#++++++++++
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
	if(fieldexists(EQSRV.GLBDATA.hapohapoYN)==1)then
		print(EQSRV.GLBDATA.hapohapoYN)
		if(EQSRV.GLBDATA.hapohapoYN=="Y")then
			print(EQSRV.GLBDATA.exCif)
			print(EQSRV.GLBDATA.NatIdNum)
			EQSRV.GLBDATA.CifId = EQSRV.GLBDATA.exCif
			EQSRV.GLBDATA.IDRefNum = EQSRV.GLBDATA.NatIdNum
		        sv_u = urhk_getCustomerDetails(EQSRV.GLBDATA.exCif)
                        print(sv_u)
                        if(sv_u==0)then
                                EQSRV.GLBDATA.CustName     = BANCS.OUTPARAM.CustName
					EQSRV.GLBDATA.LastName = EQSRV.GLBDATA.CustName
                                EQSRV.GLBDATA.CustShortName = BANCS.OUTPARAM.CustShortName
					EQSRV.GLBDATA.FirstName = EQSRV.GLBDATA.CustShortName
                                EQSRV.GLBDATA.acctName = BANCS.OUTPARAM.CustName
