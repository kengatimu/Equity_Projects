	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Name/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<BranchId>"+EQSRV.GLBDATA.PrimarySolId+"</BranchId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<BranchName/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<PostAddr>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Addr1>"+EQSRV.GLBDATA.AddrLine1+"</Addr1>"
