        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUserLoginSessionId></RealUserLoginSessionId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUser></RealUser>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUserPwd></RealUserPwd>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<SSOTransferToken></SSOTransferToken>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Security>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RequestHeader>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Header>"
        EQSRV.GLBDATA.bodyXMLMsg = ""
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Body>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SBAcctAddRequest>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SBAcctAddRq>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CustId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CustId>" + EQSRV.GLBDATA.cifId + "</CustId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<PersonName>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<LastName>" + EQSRV.GLBDATA.LastName + "</LastName>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<FirstName>" + EQSRV.GLBDATA.FirstName + "</FirstName>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<MiddleName></MiddleName>"
	EQSRV.GLBDATA.AccName = EQSRV.GLBDATA.FirstName + " " + EQSRV.GLBDATA.LastName
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Name>" + EQSRV.GLBDATA.AccName + "</Name>"
	if(EQSRV.GLBDATA.Gender=="M")then
		EQSRV.GLBDATA.TitleP = "MR"
	endif
	if(EQSRV.GLBDATA.Gender=="F")then
		EQSRV.GLBDATA.TitleP = "MS"
	endif
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<TitlePrefix>" +EQSRV.GLBDATA.TitleP+ "</TitlePrefix>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</PersonName>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</CustId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SBAcctId>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<AcctId/>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<AcctType>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SchmCode>SB777</SchmCode>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<SchmType>SBA</SchmType>"
