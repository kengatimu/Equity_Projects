				EQSRV.GLBDATA.CustTitleCode = BANCS.OUTPARAM.CustTitleCode
				EQSRV.GLBDATA.CustComuAddr1 = BANCS.OUTPARAM.CustComuAddr1
					EQSRV.GLBDATA.AddrLine1 = EQSRV.GLBDATA.CustComuAddr1
				EQSRV.GLBDATA.CustComuAddr2 = BANCS.OUTPARAM.CustComuAddr2
				EQSRV.GLBDATA.CustComuCityCode = BANCS.OUTPARAM.CustComuCityCode
				EQSRV.GLBDATA.CustComuStateCode = BANCS.OUTPARAM.CustComuStateCode
				EQSRV.GLBDATA.CustComuPinCode = BANCS.OUTPARAM.CustComuPinCode
				EQSRV.GLBDATA.PrimarySolId = BANCS.STDIN.mySolId
                        else
                                EQSRV.GLBDATA.CustName  = ""
					EQSRV.GLBDATA.LastName = "" 
                                EQSRV.GLBDATA.CustShortName = ""
					EQSRV.GLBDATA.FirstName = "" 
                                EQSRV.GLBDATA.acctName = ""
				EQSRV.GLBDATA.PrimaryRM = "" 
				EQSRV.GLBDATA.SecondaryRM = "" 
				EQSRV.GLBDATA.TertiaryRM = "" 
				EQSRV.GLBDATA.AllowSweepsFlg = "" 
				EQSRV.GLBDATA.NatIdCardNum = "" 
				EQSRV.GLBDATA.CustSex = "" 
					EQSRV.GLBDATA.Gender = "" 
				EQSRV.GLBDATA.CustTitleCode = "" 
				EQSRV.GLBDATA.CustComuAddr1 = "" 
					EQSRV.GLBDATA.AddrLine1 = "" 
				EQSRV.GLBDATA.CustComuAddr2 = "" 
				EQSRV.GLBDATA.CustComuCityCode = "" 
				EQSRV.GLBDATA.CustComuStateCode = "" 
				EQSRV.GLBDATA.CustComuPinCode = "" 
				EQSRV.GLBDATA.PrimarySolId = BANCS.STDIN.mySolId
                        endif
		endif
	endif
	EQSRV.GLBDATA.AcctId = ""
	EQSRV.GLBDATA.cifId = EQSRV.GLBDATA.CifId 
        sv_s = "RequestID1|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0)then
		EQSRV.GLBDATA.RequestID1 = BANCS.OUTPARAM.RequestID1
		print(EQSRV.GLBDATA.RequestID1)
	else
		EQSRV.GLBDATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(EQSRV.GLBDATA.RequestID1)
	endif
	EQSRV.GLBDATA.RequestID1=EQSRV.GLBDATA.RequestID1
sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        if(sv_d == 0) then
                EQSRV.GLBDATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
                print(EQSRV.GLBDATA.msgDateTime)
        else
                EQSRV.GLBDATA.scrValYN  = "N"
                EQSRV.GLBDATA.valerr    = "rev API Creation Failed "
                goto ENDSCR
        endif
