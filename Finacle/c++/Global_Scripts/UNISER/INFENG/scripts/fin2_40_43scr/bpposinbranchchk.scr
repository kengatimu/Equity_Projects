<--START
TRACE ON

sv_s = "acct_short_name,foracid,sol_id,acct_crncy_code "
sv_s = sv_s + " | "
sv_s = sv_s + " SELECT acct_short_name,foracid,gam.sol_id,acct_crncy_code "
sv_s = sv_s + " FROM TBAADM.AGT,TBAADM.GAM "
sv_s = sv_s + " WHERE AGT.oper_credit_acid = GAM.acid "
sv_s = sv_s + " AND GAM.acct_cls_flg != 'Y'"
sv_s = sv_s + " AND agent_code = ?SVAR "
sv_s = sv_s + " AND AGT.del_flg !='Y' and rownum<2 "
BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId 
print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF  (sv_d != "0") then
	BANCS.OUTPUT.RespCode = "99"
	BANCS.OUTPUT.successOrFailure="F"
	BANCS.OUTPUT.ReservedField3="HAGTM not Maintained"
	exitscript
ELSE
	CUST.ATM.acct_short_name=trim(BANCS.OUTPARAM.acct_short_name)
	print(CUST.ATM.acct_short_name)
	CUST.ATM.sol_id=BANCS.OUTPARAM.sol_id
	print(CUST.ATM.sol_id)
	CUST.ATM.foracid=BANCS.OUTPARAM.foracid
	print(CUST.ATM.foracid)
	CUST.ATM.acct_crncy_code=BANCS.OUTPARAM.acct_crncy_code
	print(CUST.ATM.acct_crncy_code)
	IF (CUST.ATM.acct_short_name=="") THEN
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure="F"
		BANCS.OUTPUT.ReservedField3="Teller Mapped"
		exitscript
	ELSE
		sv_s = "emp_id "
		sv_s = sv_s + " | "
		sv_s = sv_s + " select EMP_ID from tbaadm.gec where  "
		sv_s = sv_s + " EMP_CASH_ACCT=?SVAR  "
		sv_s = sv_s + " and CRNCY_CODE=?SVAR and SOL_ID=?SVAR and bank_id=?SVAR "
		sv_s = sv_s + " AND del_flg !='Y' and rownum<2 "
		BANCS.INPARAM.BINDVARS = CUST.ATM.acct_short_name + "|" + CUST.ATM.acct_crncy_code + "|" + CUST.ATM.sol_id + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF  (sv_d != "0") then
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure="F"
			BANCS.OUTPUT.ReservedField3="NO TELLER Assigned"
			exitscript
		ELSE
			CUST.ATM.emp_id=trim(BANCS.OUTPARAM.emp_id)
			print(CUST.ATM.emp_id)
			IF (CUST.ATM.emp_id=="") THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				BANCS.OUTPUT.ReservedField3="NO TELLER Assigned"
				exitscript
			ELSE
				sv_s = "user_id "
				sv_s = sv_s + " | "
				sv_s = sv_s + " select user_id from tbaadm.upr where  "
				sv_s = sv_s + " user_emp_id=?SVAR  "
				sv_s = sv_s + " and HOME_BANK_ID=?SVAR "
				sv_s = sv_s + " AND del_flg !='Y' and rownum<2 "
				BANCS.INPARAM.BINDVARS = CUST.ATM.emp_id + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				print(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF  (sv_d != "0") then
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					BANCS.OUTPUT.ReservedField3="User deleted or does not exist"
					exitscript
				ELSE
					CUST.ATM.user_id=BANCS.OUTPARAM.user_id
					print(CUST.ATM.user_id)
					IF (CUST.ATM.user_id=="") THEN
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure="F"
						BANCS.OUTPUT.ReservedField3="User deleted or does not exist"
						exitscript
					ELSE
						print(CUST.ATM.user_id)
						BANCS.OUTPUT.TranParticulars2=CUST.ATM.user_id
						print(BANCS.OUTPUT.TranParticulars2)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF


#TRACE OFF
EXITSCRIPT
END-->