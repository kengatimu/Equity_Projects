#===========================================================================================*
# Name                          :   chargeamount.scr
# Date                          :   08-04-2013
# Description                   :   This script is used to get the charge amount for transaction
# Author                        :   Chethan
# Input							:	EventId and EventType
# output						:	Charge Amount
# Called Scripts                :   <none>
# Calling Script                :   <none>
# Reference                     :
# Modification History  		:
#  <Serial No.>  <Date>     <AuthorName>	<Description>
#--------------------------------------------------------------------------
#	1			08-04-2013	Chethan.S		Original Version
#============================================================================================*
<--START
CHECKSUM="9cf688aa8277670af413c3530bb934a1fec35a32697485bb8bd3c086c36f6fb1"
	TRACE ON
	
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","ATM") == 0) THEN
	#{
		CREATECLASS("CUST","ATM",5)
	#}
	ENDIF
	
	CUST.ATM.errMsg = ""
	
	BANCS.INPUT.moduleName  = "ATM"
	BANCS.INPUT.parameterId = "SCHMCODE_10"
	
	CALL ("atmgetcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ATM.schmCode10 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ATM.errMsg = "SCHMCODE setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SCHMCODE_5"
	
	CALL ("atmgetcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ATM.schmCode5 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ATM.errMsg = "SCHMCODE setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	# Getting the schm code for the account for which statement is requested.
	
	#---------------------------------------------------------
	# Total debit amount
	#---------------------------------------------------------
	sv_o = CUST.ATM.schmCode
	sv_m = CUST.ATM.chargeAmt
	print(sv_o)
	print(sv_m)
	
	CUST.ATM.chargeAmt = (cint(sv_m) * cint("10")) / cint("100")
	print(CUST.ATM.chargeAmt)
	sv_t = CUST.ATM.chargeAmt
	CUST.ATM.chargeAmt = cint(CUST.ATM.chargeAmt)
	
	######  VALIDATING FOR CA204 ##############
	
	IF (sv_o != CUST.ATM.schmCode10) THEN
	#{
		sv_t = (cint(sv_m) * cint("10")) / cint("100")
		print(sv_t)
		#}
	ELSE
		#{
		sv_t = (cint(sv_m) * cint("2")) / cint("100")
		print(sv_t)
	#}
	ENDIF
	
	IF (sv_o == CUST.ATM.schmCode10) THEN
	#{
		IF (sv_t < cint("200")) THEN
		#{
			sv_t = (cint(sv_m) * cint("2")) / cint("100")
			print(sv_t)
		#}
		ENDIF
		#}
	ELSE
		#{
		IF (sv_t < cint("200")) THEN
		#{
			sv_t = "200"
			print(sv_t)
		#}
		ENDIF
	#}
	ENDIF
	
	######  END VALIDATING FOR CA204 ##############
	
	######  VALIDATING FOR M-KESHO ##############
	
	IF (sv_o == CUST.ATM.schmCode5 ) THEN
	#{
		IF (sv_t < cint("100")) THEN
		#{
			sv_t = "100"
			print(sv_t)
		#}
		ENDIF
		#}
	ELSE
		#{
		
		IF (sv_t < cint("200") AND (sv_o==CUST.ATM.schmCode5)) THEN
		#{
			sv_t = "200"
			print(sv_t)
		#}
		ENDIF
	#}
	ENDIF
	print(sv_t)
	
	CUST.ATM.tot_amt = sv_t
	print(sv_t)
	sv_t = cdouble(CUST.ATM.tot_amt)
	print(sv_t)
	
	CUST.ATM.income_amt = sv_t
	print(CUST.ATM.income_amt)
	CUST.ATM.income_amt = 0
	FINISH:
		BANCS.OUTPUT.collAmount = CUST.ATM.income_amt
		BANCS.OUTPUT.AmountWithNoDiscount = CUST.ATM.income_amt
		BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
		
		
	ENDOFSCRIPT:
		IF(CUST.ATM.errMsg != "" ) THEN
		#{
			print(CUST.ATM.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
			BANCS.OUTPUT.RespCode = "99"
		#}
		ENDIF
		
END-->
