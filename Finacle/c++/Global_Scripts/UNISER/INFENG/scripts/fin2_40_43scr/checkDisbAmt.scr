				sv_h = sv_l
			#}
			ENDIF
			CUST.LADISB.oldLoanCrncyCode = MID$(BANCS.INPUT.oldacctCrncy,sv_d,(sv_h-1))
			PRINT(CUST.LADISB.oldLoanCrncyCode)
			
			#Get oldTotAmt
			sv_d = GETPOSITION(BANCS.INPUT.oldTotAmt,sv_b)
			PRINT(sv_d)
			IF(sv_a >9) THEN
			#{
				sv_d = sv_d +4
				#}
			ELSE
				#{
				sv_d = sv_d +3
			#}
			ENDIF
			PRINT(sv_d)
			sv_e = GETPOSITION(BANCS.INPUT.oldTotAmt,sv_c)
			PRINT(sv_e)
			sv_h= sv_e - sv_d
			sv_h = sv_h -1
			IF(sv_a == CUST.LADISB.totalCount) THEN
			#{
				sv_l = STRLEN(BANCS.INPUT.oldTotAmt)
