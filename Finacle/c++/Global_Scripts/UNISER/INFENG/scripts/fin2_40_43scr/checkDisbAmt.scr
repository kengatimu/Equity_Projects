			CUST.LADISB.loanDisbAmt1 = FORMAT$(CDOUBLE(CUST.LADISB.loanDisbAmt),"%.2f")
			CUST.LADISB.loanDisbAmt = FORMAT$((CDOUBLE(CUST.LADISB.loanDisbAmt) + CDOUBLE(CUST.LADISB.opAcntAmt)),"%.2f")
			CUST.LADISB.ConvTotTrcAmt = FORMAT$(CDOUBLE(CUST.LADISB.ConvTotTrcAmt),"%.2f")
			
			PRINT(CUST.LADISB.loanDisbAmt)
			PRINT(CUST.LADISB.ConvTotTrcAmt)
			
			IF(CDOUBLE(CUST.LADISB.loanDisbAmt) < CDOUBLE(CUST.LADISB.ConvTotTrcAmt)) THEN
			#{
				sv_u = urhk_SetOrbOut("disbAmtGreatOrLessFlg|G")
				#}
			ELSE
				#{
				sv_u = urhk_SetOrbOut("disbAmtGreatOrLessFlg|L")
