			lv_s = "convtotalAmount|SELECT REPLACE(?SVAR,',','') FROM DUAL"
			PRINT(lv_s)
			BANCS.INPARAM.BINDVARS = CUST.LADISB.totalAmount
			PRINT(BANCS.INPARAM.BINDVARS)
			
			lv_d = urhk_dbSelectWithBind(lv_s)
			PRINT(lv_d)
			
			IF(lv_d == 0)THEN
			#{
				CUST.LADISB.totalAmount = BANCS.OUTPARAM.convtotalAmount
				PRINT(CUST.LADISB.totalAmount)
			#}
			ENDIF
			
			#------------------------------------------------------------------------------
			#If currency codes are different, Convert Amount
			#------------------------------------------------------------------------------
			IF(CUST.LADISB.oldLoanCrncyCode!=CUST.LADISB.newLoanCrncyCode) THEN
			#{
				CUST.RATE.acctCrncy = CUST.LADISB.oldLoanCrncyCode
				CUST.RATE.refCrncy = CUST.LADISB.newLoanCrncyCode
				CUST.RATE.TranType = "T"
