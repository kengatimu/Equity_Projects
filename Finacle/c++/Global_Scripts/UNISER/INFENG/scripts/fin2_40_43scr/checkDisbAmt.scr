        		ELSE
                	#{
				CUST.LADISB.statFlg = "E"
				CUST.LADISB.errMsg = "Invalid Operative account"
				sv_u = urhk_SetOrbOut("errorFlg|"+CUST.LADISB.statFlg)
                        	sv_u = urhk_SetOrbOut("errorMsg|"+CUST.LADISB.errMsg)
			#}
			ENDIF

			sv_u = urhk_getAcctDetailsInRepository(CUST.LADISB.operativeAcnt)
			IF(sv_u != "0")THEN	
			#{
                                CUST.LADISB.statFlg = "E"
