			CUST.LADISB.ConvTotTrcAmt = CDOUBLE(CUST.LADISB.ConvTrcAmt) + CDOUBLE(CUST.LADISB.ConvTotTrcAmt)
			PRINT(CUST.LADISB.ConvTotTrcAmt)
			
