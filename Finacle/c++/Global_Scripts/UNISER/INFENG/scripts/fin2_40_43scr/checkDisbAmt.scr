                                sv_u = urhk_SetOrbOut("errorMsg|"+CUST.LADISB.errMsg)
			#}
			ENDIF

			CUST.LADISB.opAcntAmt = BANCS.OUTPARAM.EffAvailableAmt
			PRINT(CUST.LADISB.opAcntAmt)
			CUST.LADISB.opAcntCrncy = BANCS.OUTPARAM.acctCrncyCode
			PRINT(CUST.LADISB.opAcntCrncy)

                        IF(CUST.LADISB.opAcntCrncy != CUST.LADISB.newLoanCrncyCode) THEN
                        #{
                                CUST.RATE.acctCrncy = CUST.LADISB.opAcntCrncy
                                CUST.RATE.refCrncy = CUST.LADISB.newLoanCrncyCode
