								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ELSE
				#{
					sv_c = urhk_SetOrbOut("Err|An error has occured. Please contact Support.")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#------------------------------------------------------
		# Inculude generic collections account product code 
		#------------------------------------------------------
		IF (CUST.CHQVAL.inclforcount=="Y") THEN
		#{
			sv_s = "count|"
			sv_s = sv_s + "SELECT COUNT(1)FROM dual WHERE EXISTS(SELECT 1 FROM CUSTOM.C_CIC  "
			sv_s = sv_s + " WHERE acctnum = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR) "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CHQVAL.acctNum +"|"+BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF (sv_d==0) THEN 
			#{
				CUST.CHQVAL.count = BANCS.OUTPARAM.count
			#}
			ELSE
			#{
				CUST.CHQVAL.count ="0"
			#}
			ENDIF
			#print(CUST.CHQVAL.count)
			#----------------------------------------------
			# customization to ensure inculusion for safaricom super agent GL
			#----------------------------------------------
			CUST.CHQVAL.Superagent=mid$(CUST.CHQVAL.acctNum,3,13) 
			IF (CUST.CHQVAL.Superagent==CUST.CHQVAL.pSupAge) THEN
			#{
				CUST.CHQVAL.count ="1"
			#}
			ENDIF
			IF (CUST.CHQVAL.count != 0) THEN
			#{
				sv_s = "REFNUM,NAME|"
				sv_s = sv_s + "select REFNUM,NAME from CUSTOM.C_CIC "
				sv_s = sv_s + " where ACCTNUM = ?SVAR "
				sv_s = sv_s + " and REFNUM = ?SVAR "
				sv_s = sv_s + " and DEL_FLG = 'N' "
				sv_s = sv_s + " and bank_id = ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CHQVAL.acctNum +"|"+CUST.CHQVAL.ref +"|"+BANCS.STDIN.contextBankId

				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF ( sv_d != 0 ) then
				#{
					CUST.CHQVAL.MSG=CUST.CHQVAL.errormsg2
					print(CUST.CHQVAL.MSG)
					GOTO Finish1
				#}
				ELSE
				#{
					CUST.CHQVAL.refnum = BANCS.OUTPARAM.REFNUM
					CUST.CHQVAL.name = BANCS.OUTPARAM.NAME
					CUST.CHQVAL.field_4=CUST.CHQVAL.refnum
					CUST.CHQVAL.field_5= CUST.CHQVAL.name

					IF (CUST.CHQVAL.acctNum ==CUST.CHQVAL.chqValAcct7) THEN
					#{
						CUST.CHQVAL.particulars = CUST.CHQVAL.refnum + " " + CUST.CHQVAL.name
						print(CUST.CHQVAL.particulars)
						CUST.CHQVAL.field_6=CUST.CHQVAL.particulars
					#}
					else
					#{
						CUST.CHQVAL.particulars = CUST.CHQVAL.refnum + " " + CUST.CHQVAL.name
						print(CUST.CHQVAL.particulars)
						CUST.CHQVAL.field_6=CUST.CHQVAL.particulars
					#}
					endif
				#}	
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

	#---------Inclusion for Equity Insuarance Agency
	print(CUST.CHQVAL.chqValAcct6)
	print(CUST.CHQVAL.acctNum)
	 IF  (CUST.CHQVAL.acctNum==CUST.CHQVAL.chqValAcct6)  THEN
	 #{
		IF (CUST.CHQVAL.risknote=="Y") THEN 
		#{
			sv_s = "NAME,OTHER_NAMES,REFNUM,PROPERTY_ID,ITEM_DESC|"
			sv_s = sv_s + " SELECT CLNT_NAME,CLNT_OTHER_NAMES, FIN_GIN_POLICIES.POL_DRCR_NO,IPU_PROPERTY_ID,IPU_ITEM_DESC"
