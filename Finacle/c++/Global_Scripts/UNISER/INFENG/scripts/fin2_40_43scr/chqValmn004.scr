					print("Open window")
					goto Finish1
				#}
				ENDIF
		
STEP1:
				print(CUST.CHQVAL.srlnum)	
				sv_s = "yuName,yuNationalID,yustatus,yuremarks,yustatuscode| "
				sv_s = sv_s + " Select CUSTOMER_NAME,CUSTOMER_ID,status,REMARKS,status_code "
				sv_s = sv_s + " from CUSTOM.YUCASH_RFI_TABLE "
				sv_s = sv_s + " where ID = ?SVAR"
				sv_s = sv_s + " and REQUESTAPP = ?SVAR"
				sv_s = sv_s + " and bank_id= ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS =CUST.CHQVAL.srlnum +"|"+CUST.CHQVAL.REQUESTAPP +"|"+ BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == 0 ) then
				#{
					CUST.CHQVAL.done="Y"
					CUST.CHQVAL.yustatus = BANCS.OUTPARAM.yustatus
					CUST.CHQVAL.yuremarks = BANCS.OUTPARAM.yuremarks
