				PRINT(BANCS.INPARAM.BINDVARS)
				sv_w = urhk_dbSqlWithBind(sv_s)
				print(sv_w)
				IF (sv_w == 0) THEN
				#{
					sv_w = urhk_dbSqlWithBind("COMMIT")
				#}
				ENDIF

				print(sv_w)
