								print(CUST.CHQVAL.yuremarks)
								CUST.CHQVAL.MSG=CUST.CHQVAL.yuremarks
								goto Finish1
							#}
							ENDIF
						#}
						ELSE
						#{
							CUST.CHQVAL.name = "Dummy"
							CUST.CHQVAL.particulars="Dummy"
							CUST.CHQVAL.field_5= CUST.CHQVAL.name
							CUST.CHQVAL.field_6= CUST.CHQVAL.particulars
							sv_c = "Record not found or has status problems contact support."
							CUST.CHQVAL.MSG=sv_c
							sv_u = urhk_SetOrbOut("Err|"+CUST.CHQVAL.MSG)
							GOTO ENDOFSCRIPT	
						#}
						ENDIF
					#}
					ELSE
					#{
						CUST.CHQVAL.yuNationalID = BANCS.OUTPARAM.yuNationalID
						CUST.CHQVAL.yuName=BANCS.OUTPARAM.yuName
						print(CUST.CHQVAL.yuName)
						CUST.CHQVAL.name = CUST.CHQVAL.yuName
						CUST.CHQVAL.refnum = CUST.CHQVAL.ref
						CUST.CHQVAL.particulars = CUST.CHQVAL.refnum + "/" + CUST.CHQVAL.name
						CUST.CHQVAL.field_5= CUST.CHQVAL.name
						CUST.CHQVAL.field_6= CUST.CHQVAL.particulars
						print(CUST.CHQVAL.name)
						print(CUST.CHQVAL.particulars)

						sv_s = "check|"
						sv_s = sv_s + "SELECT count(1) FROM CUSTOM.C_CIC "
						sv_s = sv_s + " WHERE ACCTNUM = ?SVAR "
						sv_s = sv_s + " AND REFNUM = ?SVAR "
						sv_s = sv_s + " AND DEL_FLG = 'N' "
						sv_s = sv_s + " AND bank_id = ?SVAR "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.CHQVAL.acctNum +"|"+ CUST.CHQVAL.ref +"|"+BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_w = urhk_dbSelectWithBind(sv_s)
						IF (sv_w == 0) THEN 
						#{
							CUST.CHQVAL.check = BANCS.OUTPARAM.check
							IF (CUST.CHQVAL.check ==0) THEN
							#{
								sv_s = " INSERT into CUSTOM.C_CIC (DEL_FLG,ACCTNUM, REFNUM, NAME) "
								sv_s = sv_s + " values ('N',"
								sv_s = sv_s + " ?SVAR,"
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR, "
								sv_s = sv_s + " ?SVAR "
