	IF (CUST.CHQVAL.ref != "") THEN
	#{
		#-------------------------------------------
		# inculude Safaricom Dealers account 
		#-------------------------------------------
		IF (CUST.CHQVAL.acctNum==CUST.CHQVAL.pForacid2) THEN
		#{
			CUST.CHQVAL.ref=ltrim(CUST.CHQVAL.ref)
			CUST.CHQVAL.ref=rtrim(CUST.CHQVAL.ref)
			print(CUST.CHQVAL.ref)

			
			#--------------------------------------------
			#vaidating the customer info
			#--------------------------------------------
			IF (CUST.CHQVAL.done!='Y') THEN
			#{
				sv_u="srlnum|Select CUSTOM.YUCASH_RFI_SEQ.nextval from dual"
				sv_s = urhk_dbSelectWithBind(sv_u)
				print(sv_s) 
				IF (sv_s=="0") THEN
