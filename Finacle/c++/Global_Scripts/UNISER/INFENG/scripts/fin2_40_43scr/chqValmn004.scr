				sv_s = " INSERT INTO CUSTOM.YUCASH_RFI_TABLE (CASHINOUTFLG,STATUS,MOBILENUMBER,AMOUNT,BRANCH_CODE,ID,PAYMENT_METHOD,REQUESTAPP,BANK_ID) "
