					#{
						IF ((CUST.CHQVAL.yustatuscode == CUST.CHQVAL.pyucd ) OR (CUST.CHQVAL.yustatuscode == CINT("0"))) THEN 
						#{
							#--Checking if details exist in table 
							sv_s = "REFNUM,NAME|"
							sv_s = sv_s + "SELECT REFNUM,NAME FROM CUSTOM.C_CIC "
							sv_s = sv_s + " WHERE ACCTNUM = ?SVAR "
							sv_s = sv_s + " AND REFNUM = ?SVAR "
							sv_s = sv_s + " AND DEL_FLG = 'N' "
							sv_s = sv_s + " AND bank_id = ?SVAR"
							print(sv_s)
							
							BANCS.INPARAM.BINDVARS = CUST.CHQVAL.acctNum +"|"+CUST.CHQVAL.ref +"|"+ BANCS.STDIN.contextBankId
							
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbSelectWithBind(sv_s)
							print(sv_d)
							IF ( sv_d == 0 ) then
							#{
								CUST.CHQVAL.name = BANCS.OUTPARAM.NAME
								CUST.CHQVAL.refnum = BANCS.OUTPARAM.REFNUM
								CUST.CHQVAL.particulars = CUST.CHQVAL.refnum + "/" + CUST.CHQVAL.name
