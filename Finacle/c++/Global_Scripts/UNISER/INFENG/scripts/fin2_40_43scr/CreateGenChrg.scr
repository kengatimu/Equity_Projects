<--START
CHECKSUM="673031bb12084953b6c1bb2761777a9333e6885614eb507175517300159c52af"
	#trace on
	
	#----------------------------------------------------------------------
	# Create the necessary repositories and Classes
	#----------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
