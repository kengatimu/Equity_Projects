	#sv_p=urhk_B2k_printRepos("BANCS")
	
	CUST.GCHRG.Foracid = BANCS.INPUT.Foracid
	CUST.GCHRG.EventId = BANCS.INPUT.EventId
	
	#--------------------------------------------------------
	# Set inputs to SRV
	#--------------------------------------------------------
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|T")
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventType|GCHRG")
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|"+ CUST.GCHRG.EventId)
	sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|"+CUST.GCHRG.Foracid)
	
	sv_u = urhk_ExecSrv("SRV_FetchDfltGenChrgDtl|retain_all_output = Y")
	print(sv_u)
	IF(sv_u != 0) THEN
	#{
		GOTO CHECKSRVERROR
		
	#}
	ENDIF
	
	sv_u = urhk_CopyOutToIn("")
	sv_u = urhk_ExecSrv("SRV_AddGenChrgDtlAndVerify|same_user_verify = Y|retain_all_output = Y")
	print(sv_u)
	IF(sv_u != 0) THEN
	#{
		GOTO CHECKSRVERROR
		
		#}
	ELSE
		#{
		sv_u=urhk_SetOrbOut("STATUS|SUCCESS")
		EXITSCRIPT
	#}
	ENDIF
	
	CHECKSRVERROR :
		#{
		IF(fieldexists(BANCS.OUTPARAM.Error_num)) THEN
		#{
			sv_c = BANCS.OUTPARAM.Error_num
			IF (sv_c > 0) THEN
			#{
				sv_d = 1
				sv_e = ""
				#WHILE (sv_d <= sv_c)
				sv_f = FORMAT$(sv_d,"%d")
				print(("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f))
				print(("BANCS").("OUTPARAM").("Tag_"+sv_f))
				sv_d = sv_d + 1
				#DO
			#}
			ENDIF
		#}
		ENDIF
		
		IF(fieldexists(BANCS.OUTPARAM.Xcpn_num)) THEN
		#{
			sv_c = BANCS.OUTPARAM.Xcpn_num
			IF (sv_c > 0) THEN
			#{
				sv_d = 1
				sv_e = ""
				#WHILE (sv_d <= sv_c)
				sv_f = FORMAT$(sv_d,"%d")
				print(("BANCS").("OUTPARAM").("XcpnDesc_"+sv_f))
				print(("BANCS").("OUTPARAM").("XcpnCodeType_"+sv_f))
				sv_d = sv_d + 1
				#DO
			#}
			ENDIF
		#}
		ENDIF
		
		sv_u = urhk_SRV_SetErr("GCHRG Error")
		#}
		
		#trace off
END-->
