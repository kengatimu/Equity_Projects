<--START
	TRACE ON
	#==========================================================*
	# create repository
	#==========================================================*
	sv_a = REPEXISTS("CUST")
	IF(sv_a == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","WTAX")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "WTAX", 5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	CUST.WTAX.errorFlg ="N"
	CUST.WTAX.errorMsg =" "
	CUST.WTAX.schmCode =""
	CUST.WTAX.crncyCode =""
	CUST.WTAX.wtaxFlg =""
	
	IF(FIELDEXISTS(BANCS.INPUT.schmCode)) THEN
	#{
		IF(TRIM(BANCS.INPUT.schmCode) != "")THEN
		#{
			CUST.WTAX.schmCode= TOUPPER(TRIM(BANCS.INPUT.schmCode))
			PRINT(CUST.WTAX.schmCode)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.WTAX.errorFlg = "Y"
		CUST.WTAX.errorMsg = "scheme Code field does not exists"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.crncyCode)) THEN
	#{
		IF(TRIM(BANCS.INPUT.crncyCode) != "")THEN
		#{
			CUST.WTAX.crncyCode= TOUPPER(TRIM(BANCS.INPUT.crncyCode))
			PRINT(CUST.WTAX.crncyCode)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.WTAX.errorFlg = "Y"
		CUST.WTAX.errorMsg = "Crncy Code field does not exists"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "wtaxFlg|"
	sv_s = sv_s + " SELECT WTAX_FLG"
	sv_s = sv_s + " FROM TBAADM.CSP "
	sv_s = sv_s + " WHERE SCHM_CODE = ?SVAR"
	#sv_s = sv_s + " AND DEL_FLG != 'Y'"
	sv_s = sv_s + " AND CRNCY_CODE=?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.WTAX.schmCode +"|"+ CUST.WTAX.crncyCode + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0) THEN
	#{
		CUST.WTAX.wtaxFlg = BANCS.OUTPARAM.wtaxFlg
		PRINT(CUST.WTAX.wtaxFlg)
		#}
	ELSE
		#{
		CUST.WTAX.errorFlg = "Y"
		CUST.WTAX.errorMsg = "Invalid Scheme Code"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_SetOrbOut("errorFlg|"+CUST.WTAX.errorFlg)
        PRINT(sv_u)

        sv_u = urhk_SetOrbOut("errorMsg|"+CUST.WTAX.errorMsg)
        PRINT(sv_u)
	
	sv_u = urhk_SetOrbOut("wtaxFlg|"+CUST.WTAX.wtaxFlg)
	PRINT(sv_u)
	
	ENDOFSCRIPT:
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.WTAX.errorFlg)
		PRINT(sv_u)
		
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.WTAX.errorMsg)
		PRINT(sv_u)
		
		
		DELETECLASS("CUST", "WTAX")
		DELETEREP("CUST")
		
		TRACE OFF
		EXITSCRIPT
END-->
