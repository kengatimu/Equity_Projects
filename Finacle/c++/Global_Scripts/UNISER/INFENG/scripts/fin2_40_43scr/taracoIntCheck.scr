<--START
	
	TRACE ON
	
	sv_a = REPEXISTS("CUST")
	IF(sv_a == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.chrgOffAppIntAdj = ""
	CUST.DATA.AccntNum	= ""	
        CUST.DATA.errorFlg = "N"
        CUST.DATA.errorMsg = " "
	CUST.DATA.inrstAdjAmt = ""

	IF(FIELDEXISTS(BANCS.INPUT.AccntNum))THEN
	#{
		IF(BANCS.INPUT.AccntNum !="")THEN
		#{
			CUST.DATA.AccntNum = TOUPPER(TRIM(BANCS.INPUT.AccntNum))
			PRINT(CUST.DATA.AccntNum)
		#}
		ELSE
		#{
        		CUST.DATA.errorFlg = "N"
        		CUST.DATA.errorMsg = " "
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.chrgOffAppIntAdj))THEN
	#{
		IF(BANCS.INPUT.chrgOffAppIntAdj !="")THEN
		#{
			CUST.DATA.chrgOffAppIntAdj = TOUPPER(TRIM(BANCS.INPUT.chrgOffAppIntAdj))
			PRINT(CUST.DATA.chrgOffAppIntAdj)
		#}
		ELSE
		#{
			CUST.DATA.chrgOffAppIntAdj = "0"
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_s = "inrstAdjAmt|SELECT (PENDING_INTEREST - INTEREST_RECOVERY) FROM TBAADM.TA_COT WHERE ACID =(SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR "
	sv_s = sv_s + "AND FORACID= ?SVAR) AND BANK_ID=?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.AccntNum  + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "DB error,Please contact DBA"
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.DATA.inrstAdjAmt = BANCS.OUTPARAM.inrstAdjAmt
		PRINT(CUST.DATA.inrstAdjAmt)
	#}
	ENDIF

	IF(CDOUBLE(CUST.DATA.inrstAdjAmt) > CDOUBLE(CUST.DATA.chrgOffAppIntAdj))THEN
	#{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "There is outstanding Interest adjustment, Please collect Interest Moved From Suspense Amount first"
                GOTO ENDOFSCRIPT
        #}
	ENDIF

        ENDOFSCRIPT:
        sv_a = urhk_SetOrbOut("errorFlg|"+CUST.DATA.errorFlg)
        sv_a = urhk_SetOrbOut("errorMsg|"+CUST.DATA.errorMsg)

        TRACE OFF

END-->
