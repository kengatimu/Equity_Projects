<--START
CHECKSUM="219d79965695090f36b931e4469af8ddc666dd1cdb12faaf54a1710eaf805d64"
	#trace on
	#********************************************************************
	# This script formats the Input message header and footer details  and
	# sends the SMH fields back.
	# Input : PAYSYS.GLBDATA.HeaderDetails
	#		: PAYSYS.GLBDATA.FooterDetails
	#********************************************************************
	
	#This script parses header details of the swift message and populates related details
	#in the repositories
	#sv_r=urhk_B2k_PrintRepos("BANCS")
	sv_p = mid$(PAYSYS.GLBDATA.HeaderDetails,4,2)
	print(sv_p)
	print(PAYSYS.GLBDATA.HeaderDetails)
	IF(sv_p == "21") THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.ErrorDesc = " Received ACK/NAK message , hence ignoring "
		exitscript
	#}
	ENDIF
	
	sv_p =getPosition(PAYSYS.GLBDATA.HeaderDetails, "{1:")
	print(sv_p)
	BANCS.OUTPUT.SenderBIC =  mid$(PAYSYS.GLBDATA.HeaderDetails,sv_p+5,11)
	print(BANCS.OUTPUT.SenderBIC )
	sv_p =getPosition(PAYSYS.GLBDATA.HeaderDetails, "{2:")
	print (sv_p)
	BANCS.OUTPUT.MessageId =  mid$(PAYSYS.GLBDATA.HeaderDetails,sv_p+3,3)
	print(BANCS.OUTPUT.MessageId)
	BANCS.OUTPUT.RecvrBIC =  mid$(PAYSYS.GLBDATA.HeaderDetails,sv_p+6,11)
	print(BANCS.OUTPUT.RecvrBIC)
	sv_p=getPosition(PAYSYS.GLBDATA.HeaderDetails, "KPS")
	print(sv_p)
	BANCS.OUTPUT.KPS =  mid$(PAYSYS.GLBDATA.HeaderDetails,sv_p-1,3)
	print(BANCS.OUTPUT.KPS)
	
	sv_p =getPosition(PAYSYS.GLBDATA.HeaderDetails, "{2:I")
	print(sv_p)
	IF(sv_p != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.ErrorDesc = "Found a message which is Outward.Outward Messages can not be Uploaded.Hence ignoring."
		exitscript
	#}
	ENDIF
	
	sv_n =getPosition(PAYSYS.GLBDATA.HeaderDetails, "U}{")
	print (sv_n)
	#if(sv_n != 0) then
	#BANCS.OUTPUT.MsgPriority = "U"
	#else
	#BANCS.OUTPUT.MsgPriority = "N"
	
	#endif
	
	#code appended by Kinoti to test KPS functionality
	######################################################
	sv_n =getPosition(PAYSYS.GLBDATA.HeaderDetails, "U}{")
	print (sv_n)
	IF(sv_n != 0) THEN
	#{
		BANCS.OUTPUT.MsgPriority = "U"
		#}
	ELSE
		#{
		IF(BANCS.OUTPUT.KPS=="KPS") THEN
		#{
			BANCS.OUTPUT.MsgPriority = "K"
			#}
		ELSE
			#{
			BANCS.OUTPUT.MsgPriority = "N"
		#}
		ENDIF
	#}
	ENDIF
	#####################################################
	#END OF CODE
	sv_p = getPosition(PAYSYS.GLBDATA.FooterDetails,"PDE")
	print(sv_p)
	IF(sv_p != 0) THEN
	#{
		BANCS.OUTPUT.PDEFlag = "Y"
		#}
	ELSE
		#{
		BANCS.OUTPUT.PDEFlag = "N"
	#}
	ENDIF
	
	#Check whether this message is supported
	BANCS.INPARAM.PaysysId  = BANCS.INPUT.PaysysId
	print(BANCS.INPARAM.PaysysId)
	print(BANCS.INPUT.PaysysId)
	BANCS.INPARAM.MessageId = BANCS.OUTPUT.MessageId
	print(BANCS.INPARAM.MessageId)
	print(BANCS.OUTPUT.MessageId)
	BANCS.INPARAM.InOutInd	= "I"
	print(BANCS.INPARAM.InOutInd)
	sv_a = urhk_getPaysysMsgDetails("")
	print(sv_a)
	IF(sv_a != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.ErrorDesc = "No Setup in PAYSYS for PaysysId [" +BANCS.INPUT.PaysysId + "],MessageId ["
		BANCS.OUTPUT.ErrorDesc = BANCS.OUTPUT.ErrorDesc + BANCS.OUTPUT.MessageId  +"] for INWARD messages"
		print(BANCS.OUTPUT.ErrorDesc)
	#}
	ENDIF
	
	#Here customized logic can be put put to derive STP flag.
	BANCS.OUTPUT.STPFlag = "Y"
	exitscript
	#trace off
END-->
