<--START
CHECKSUM="6b5a747b035e48afb4f7543649c863324d5ad7f7962645ed5aecb615b987a13f"
	TRACE ON
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "LADISB")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "LADISB", 5)
	#}
	ENDIF
	
	CUST.LADISB.srlNo= "0"
	PRINT(BANCS.INPUT.chrgEvntIdVal)
	PRINT(BANCS.INPUT.usrEntAmt)
	PRINT(BANCS.INPUT.chrgEventTypeVal)
	PRINT(BANCS.INPUT.crncyVal)
	PRINT(BANCS.INPUT.loanAct)
	PRINT(BANCS.INPUT.disbAmt)
	#-----------------------WRITE CODE HERE FOR DELETE ENTRIES IN TABLE------------------#
	
	sv_s = "DELETE FROM CUSTOM.DISRT "
	sv_s = sv_s + " WHERE LOAN_ACCT_ID =?SVAR"
	BANCS.INPARAM.BINDVARS =BANCS.INPUT.loanAct
	
	PRINT(sv_s)
	sv_d= urhk_dbSqlWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d!= 0)THEN
	#{
		PRINT("not deleeted")
		#}
	ELSE
		#{
		PRINT(" deleeted")
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------#
	#-----------------------FOR CHARGES-------------------------------------------#
	
	BANCS.INPUT.chrgEvntIdVal = MID$(BANCS.INPUT.chrgEvntIdVal,1, STRLEN(BANCS.INPUT.chrgEvntIdVal)) + "!"
	BANCS.INPUT.usrEntAmt = MID$(BANCS.INPUT.usrEntAmt,1, STRLEN(BANCS.INPUT.usrEntAmt)) + "!"
	BANCS.INPUT.chrgEventTypeVal = MID$(BANCS.INPUT.chrgEventTypeVal,1, STRLEN(BANCS.INPUT.chrgEventTypeVal)) + "!"
	BANCS.INPUT.crncyVal = MID$(BANCS.INPUT.crncyVal,1, STRLEN(BANCS.INPUT.crncyVal)) + "!"
	
	PRINT(BANCS.INPUT.chrgEvntIdVal)
	PRINT(BANCS.INPUT.usrEntAmt)
	PRINT(BANCS.INPUT.chrgEventTypeVal)
	PRINT(BANCS.INPUT.crncyVal)
	
	
	WHILE(GETPOSITION(BANCS.INPUT.chrgEvntIdVal,"!") != 0)
	#{
		sv_a = MID$(BANCS.INPUT.chrgEvntIdVal,0,GETPOSITION(BANCS.INPUT.chrgEvntIdVal,"!") -1)
		PRINT(sv_a)
		sv_b = MID$(BANCS.INPUT.usrEntAmt,0,GETPOSITION(BANCS.INPUT.usrEntAmt,"!") -1)
		PRINT(sv_b)
		sv_c = MID$(BANCS.INPUT.chrgEventTypeVal,0,GETPOSITION(BANCS.INPUT.chrgEventTypeVal,"!") -1)
		PRINT(sv_c)
		sv_d = MID$(BANCS.INPUT.crncyVal,0,GETPOSITION(BANCS.INPUT.crncyVal,"!") -1)
		PRINT(sv_d)
		CUST.LADISB.chrgEvntIdVal = sv_a
		CUST.LADISB.usrEntAmt = sv_b
		CUST.LADISB.chrgEventTypeVal = sv_c
		CUST.LADISB.crncyVal = sv_d
		
		
		BANCS.INPUT.chrgEvntIdVal = MID$(BANCS.INPUT.chrgEvntIdVal,GETPOSITION(BANCS.INPUT.chrgEvntIdVal,"!"), STRLEN(BANCS.INPUT.chrgEvntIdVal))
		BANCS.INPUT.usrEntAmt = MID$(BANCS.INPUT.usrEntAmt,GETPOSITION(BANCS.INPUT.usrEntAmt,"!"), STRLEN(BANCS.INPUT.usrEntAmt))
		BANCS.INPUT.chrgEventTypeVal = MID$(BANCS.INPUT.chrgEventTypeVal,GETPOSITION(BANCS.INPUT.chrgEventTypeVal,"!"), STRLEN(BANCS.INPUT.chrgEventTypeVal))
		BANCS.INPUT.crncyVal = MID$(BANCS.INPUT.crncyVal,GETPOSITION(BANCS.INPUT.crncyVal,"!"), STRLEN(BANCS.INPUT.crncyVal))
		
		PRINT(BANCS.INPUT.chrgEvntIdVal)
		PRINT(BANCS.INPUT.usrEntAmt)
		PRINT(BANCS.INPUT.chrgEventTypeVal)
		PRINT(BANCS.INPUT.crncyVal)
		
		
		
		#----------FETCH BACID FROM PTT TABLE-----------
		BANCS.INPARAM.BINDVARS = CUST.LADISB.chrgEvntIdVal + "|" + CUST.LADISB.chrgEventTypeVal
		BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + "Y|N|"+ BANCS.STDIN.contextBankId
		sv_s = "bacid,tranPart| SELECT BACID,TRAN_PARTCLS FROM TBAADM.PTT  "
		sv_s = sv_s + " WHERE  EVENT_ID=?SVAR "
		sv_s = sv_s + "  AND EVENT_TYPE=?SVAR "
		sv_s = sv_s + "  AND  ENTITY_CRE_FLG =?SVAR "
		sv_s = sv_s + "  AND DEL_FLG = ?SVAR "
		sv_s = sv_s + "  AND BANK_ID = ?SVAR "
		PRINT(sv_s )
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.LADISB.bacid = BANCS.OUTPARAM.bacid
			IF(CUST.LADISB.chrgEvntIdVal == "VAT")THEN
			#{
				CUST.LADISB.tranPart = "VAT ON"
			#}
			ELSE
			#{
				CUST.LADISB.tranPart = TOUPPER(BANCS.OUTPARAM.tranPart)
			#}
			ENDIF

			print(CUST.LADISB.tranPart)
			CUST.LADISB.tranPart = CUST.LADISB.tranPart + " CHARGES"
			print(CUST.LADISB.tranPart)
			
			
			#}
		ELSE
			#{
			sv_w = "Error|PlaceHolder not maintained in HPTTM for event id -"+CUST.LADISB.chrgEvntIdVal
			sv_u = urhk_SetOrbOut(sv_w)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------FETCH THE ACCOUNT DETAILS BASED ON BACID -------------------------
		BANCS.INPARAM.BINDVARS = CUST.LADISB.bacid + "|" + BANCS.STDIN.mySolId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.LADISB.crncyVal
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|Y|N|"+ BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "acctNum,acctName|SELECT FORACID,ACCT_NAME "
		sv_s = sv_s + "  FROM TBAADM.GAM  "
		sv_s = sv_s + "  WHERE BACID = ?SVAR "
		sv_s = sv_s + "  AND sol_id =?SVAR "
		sv_s = sv_s + "   AND acct_crncy_code =?SVAR "
		sv_s = sv_s + "   AND ENTITY_CRE_FLG= ?SVAR "
		sv_s = sv_s + "   AND DEL_FLG =?SVAR "
		sv_s = sv_s + "   AND BANK_ID = ?SVAR "
		PRINT(sv_s )
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.LADISB.acctNum = BANCS.OUTPARAM.acctNum
			CUST.LADISB.acctName = BANCS.OUTPARAM.acctName
			#}
		ELSE
			#{
			sv_w = "Error|No Credit A/c available for  event id -"+CUST.LADISB.chrgEvntIdVal
			sv_u = urhk_SetOrbOut(sv_w)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-----------------------------insert into custom table---------#
		sv_a = CINT(CUST.LADISB.srlNo)+1
		CUST.LADISB.srlNo =sv_a
		PRINT(CUST.LADISB.srlNo)
		PRINT(CUST.LADISB.chrgEvntIdVal)
		sv_s = "INSERT INTO CUSTOM.DISRT ("
		sv_s = sv_s +"ACCT_ID,ACCT_NAME,TRAN_PARTICULARS,"
		sv_s = sv_s + "CCY,TRAN_AMT,INDICATOR,SRL_NO,EVENT_ID,"
		sv_s = sv_s + "EVENT_TYPE,BANK_ID,LOAN_ACCT_ID) VALUES ("
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR)"
		BANCS.INPARAM.BINDVARS = CUST.LADISB.acctNum + "|" + CUST.LADISB.acctName
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" + CUST.LADISB.tranPart
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|" + CUST.LADISB.crncyVal
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|" + CUST.LADISB.usrEntAmt
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|" + "C"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|" + CUST.LADISB.srlNo
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|"+ CUST.LADISB.chrgEvntIdVal
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|"+CUST.LADISB.chrgEventTypeVal
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|"+BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|"+BANCS.INPUT.loanAct
		PRINT(BANCS.INPARAM.BINDVARS)
		PRINT(sv_s)
		sv_d= urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d!=0) THEN
		#{
			PRINT("insert failed for charges")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		
		
	#}
	DO
	
	
	ENDOFSCRIPT:
		EXITSCRIPT
		
END-->
