<--start
trace on
callscriptifexist("ebRepClass.scr")
EBSRV.GLBDATA.recVerType = BANCS.INPUT.RecVerifyType
print(EBSRV.GLBDATA.recVerType)

if(EBSRV.GLBDATA.recVerType == "MAIN") then
#{
	lv_u = " update custom.armt set del_flg ='Y'"
        lv_u = lv_u + " where rcre_user_id=?SVAR and bank_id=?SVAR "
        lv_u = lv_u + " and currency_code = ?SVAR "
        lv_u = lv_u + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_u = lv_u + " and deposit_type=?SVAR "
        lv_u = lv_u + " and deposit_period_mnths=?SVAR "
        lv_u = lv_u + " and del_flg <> 'Y' "
        lv_u = lv_u + " and entity_cre_flg = 'N' "
        PRINT(lv_u)

        BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" +  EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        PRINT(BANCS.INPARAM.BINDVARS)
	
	lv_r = urhk_dbSQLWithBind(lv_u)
	print(lv_r)
	if(lv_r == 0) then
		EBSRV.GLBDATA.resMsg = "ALCO Rate Details Cancelled Successfully"
		GOTO ENDOFSCRIPT
	else
		EBSRV.GLBDATA.errMsg = "Verification Failed"
		GOTO ENDOFSCRIPT
	endif
#}
endif

if(EBSRV.GLBDATA.recVerType == "MOD") then
#{
        lv_u = " delete from custom.alco_rate_mod_tbl "
        lv_u = lv_u + " where rcre_user_id=?SVAR and bank_id=?SVAR "
        lv_u = lv_u + " and currency_code = ?SVAR "
        lv_u = lv_u + " and applicable_date = to_date(?SVAR,'DD-MM-RR') "
        lv_u = lv_u + " and deposit_type=?SVAR "
        lv_u = lv_u + " and deposit_period_mnths=?SVAR "
        lv_u = lv_u + " and del_flg <> 'Y' "
        lv_u = lv_u + " and entiry_cre_flg = 'N' "
        PRINT(lv_u)

        BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CrncyCode + "|" +  EBSRV.GLBDATA.AplliDate + "|" + EBSRV.GLBDATA.depPerdMths + "|" + EBSRV.GLBDATA.depPerdDays
        PRINT(BANCS.INPARAM.BINDVARS)

	lv_r = urhk_dbSQLWithBind(lv_u)
	print(lv_r)
	if(lv_r == 0) then
		EBSRV.GLBDATA.resMsg = "ALCO Rate Details Cancelled Successfully"
		GOTO ENDOFSCRIPT
	else
		EBSRV.GLBDATA.errMsg = "Verification Failed"
		GOTO ENDOFSCRIPT
	endif
#}
endif

ENDOFSCRIPT:
	##################callscriptifexist("ebRepClean.scr")
