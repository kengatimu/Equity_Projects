							STDWFS.GLBDATA.differ = BANCS.OUTPARAM.Diff
							PRINT(STDWFS.GLBDATA.differ)
							if (STDWFS.GLBDATA.differ =="0") then
								CUST.RATE.errMsglimit="Transaction not allowed check Limit USD 1000 Balance "
								GOTO NEXTRECLIMIT
							endif
						#}
						ENDIF
						sv_x = "dedit,credit|select (select  sum(tran_amt) from tbaadm.dtd where acid in (select acid from tbaadm.gam where foracid='" + CUST.RATE.foracid + "' and Bank_id=?SVAR ) and PART_TRAN_TYPE='D' and del_flg='N' and tran_date=(select db_stat_date from tbaadm.gct where DC_ALIAS=?SVAR ) and bank_id=?SVAR) debit ,(select  sum(tran_amt) from tbaadm.dtd where acid in (select acid from tbaadm.gam where foracid='" + CUST.RATE.foracid + "' and bank_id=?SVAR) and PART_TRAN_TYPE='C' and del_flg='N' and tran_date=(select db_stat_date from tbaadm.gct where DC_ALIAS=?SVAR ) and bank_id=?SVAR) credit  from dual"
						print(sv_x)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId 
						print(BANCS.INPARAM.BINDVARS)
						sv_w = urhk_dbSelectWithBind(sv_x)
						if (sv_w==0) then
							STDWFS.GLBDATA.dedit = cdouble(BANCS.OUTPARAM.dedit)
							print(STDWFS.GLBDATA.dedit)
							STDWFS.GLBDATA.credit = cdouble(BANCS.OUTPARAM.credit)
							print(STDWFS.GLBDATA.credit)
							IF (FIELDEXISTS(CUST.RATE.tranAmountlim ) == 1) THEN
								print(CUST.RATE.tranAmountlim )
