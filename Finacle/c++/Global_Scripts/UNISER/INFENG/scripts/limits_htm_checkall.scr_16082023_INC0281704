IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","RATE") == 0) THEN
#{
    CREATECLASS("CUST","RATE",5)
#}
ENDIF

sv_r=urhk_B2k_PrintRepos("BANCS")
print (sv_r)
###### Limits starts
PRINT(CUST.RATE.foracid)
Print (CUST.RATE.fxblkfxcrncy)
PRINT(CUST.RATE.partTrantype)
CUST.RATE.tranAmountlim = LEFT$(CUST.RATE.refAmt,GETPOSITION(CUST.RATE.refAmt,"|"))
print(CUST.RATE.tranAmountlim)
CUST.RATE.tranAmountlimcyc = RIGHT$(CUST.RATE.refAmt,GETPOSITION(CUST.RATE.refAmt,"|"))
print(CUST.RATE.tranAmountlimcyc)
CUST.RATE.limit1000="1001"
CUST.RATE.limit100="101"
IF (CUST.RATE.partTrantype=="D") THEN
	####### start agent limit
	### debit
	IF (CUST.RATE.foracid!="") THEN
		print(CUST.RATE.foracid)
		CUST.RATE.restrictflg=""
		CUST.RATE.FreeCode7="XXX"
		sv_u = urhk_getAdvanceDetailsForAccount(CUST.RATE.foracid)
		print(sv_u)
		if(sv_u==0)then
		#{
			print(BANCS.OUTPARAM.FreeCode7)
			CUST.RATE.FreeCode7 = BANCS.OUTPARAM.FreeCode7
			print(CUST.RATE.FreeCode7)
			IF (CUST.RATE.FreeCode7=="AGENT") THEN
				CUST.RATE.restrictflg = "Y"
			ELSE
				CUST.RATE.restrictflg = "N"
			ENDIF
		#}
		ELSE
			CUST.RATE.restrictflg = "N"
		ENDIF
		IF (CUST.RATE.restrictflg == "Y") THEN
			sv_h = urhk_getAcctDetailsInRepository(CUST.RATE.foracid)
			print(sv_h)
			IF (sv_h==0) THEN
				sv_r = REPEXISTS("STDWFS")
				IF (sv_r == 0) THEN
					CREATEREP("STDWFS")
				ENDIF
				sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
				IF (sv_r == 0) THEN
					CREATECLASS("STDWFS", "GLBDATA", 5)
				ENDIF
				STDWFS.GLBDATA.solidsh = BANCS.OUTPARAM.acctSolId
				print(STDWFS.GLBDATA.solidsh)
				STDWFS.GLBDATA.schmcodesh = BANCS.OUTPARAM.schmCode
				print(STDWFS.GLBDATA.schmcodesh)
				STDWFS.GLBDATA.schmType = BANCS.OUTPARAM.schmType
				print(STDWFS.GLBDATA.schmType)
				STDWFS.GLBDATA.acctCrncyCodeDR = BANCS.OUTPARAM.acctCrncyCode
				print(STDWFS.GLBDATA.acctCrncyCodeDR)
