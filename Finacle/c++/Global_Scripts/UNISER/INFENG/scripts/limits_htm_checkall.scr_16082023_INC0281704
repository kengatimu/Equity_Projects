				print(STDWFS.GLBDATA.EffAvailableAmttr)
				STDWFS.GLBDATA.EffAvailableAmttr = rtrim(ltrim(STDWFS.GLBDATA.EffAvailableAmttr))
				print(STDWFS.GLBDATA.EffAvailableAmttr)
				STDWFS.GLBDATA.EffAvailableAmttr = cdouble(STDWFS.GLBDATA.EffAvailableAmttr)
				print(STDWFS.GLBDATA.EffAvailableAmttr)
				IF (FIELDEXISTS(CUST.RATE.tranAmountlim ) == 1) THEN	
					STDWFS.GLBDATA.dedittr = cdouble(CUST.RATE.tranAmountlim )
					print(STDWFS.GLBDATA.dedittr)
					print(STDWFS.GLBDATA.EffAvailableAmttr)
					###
					IF (STDWFS.GLBDATA.acctCrncyCodeDR=="USD") THEN
						print(CUST.RATE.limit1000)
						sv_s = "Diff| select (case when (?SVAR - ?SVAR)<0 then '1' when (?SVAR - ?SVAR)>=0 then '0' end) as  fundsflg  from dual "
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.EffAvailableAmttr + "|" + CUST.RATE.limit1000 + "|" + STDWFS.GLBDATA.EffAvailableAmttr + "|" + CUST.RATE.limit1000
