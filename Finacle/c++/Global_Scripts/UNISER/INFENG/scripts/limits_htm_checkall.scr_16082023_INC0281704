								print(STDWFS.GLBDATA.dedittr)
								IF (CUST.RATE.fxblkfxcrncy!=STDWFS.GLBDATA.acctCrncyCodeDR) THEN
									###################
									BANCS.INPARAM.InputAmount  = STDWFS.GLBDATA.dedittr
									BANCS.INPARAM.FromCurrency = CUST.RATE.fxblkfxcrncy
									BANCS.INPARAM.ToCurrency   = "USD"
									BANCS.INPARAM.RateCode     = "MEAN"
									BANCS.INPARAM.Rate         = CDOUBLE("0.0")
									sv_u = urhk_B2k_ConvertAmount("")
									STDWFS.GLBDATA.dedittr = BANCS.OUTPARAM.OutputAmount
									print(STDWFS.GLBDATA.dedittr)
									###################
								ENDIF
								print(CUST.RATE.limit100)
								sv_s = "Diff| select (case when (?SVAR - ?SVAR)<0 then '1' when (?SVAR - ?SVAR)>=0 then '0' end) as  fundsflg  from dual "
								PRINT(sv_s)
								BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.dedittr + "|" + CUST.RATE.limit100 + "|" + STDWFS.GLBDATA.dedittr + "|" + CUST.RATE.limit100
								PRINT(BANCS.INPARAM.BINDVARS)
