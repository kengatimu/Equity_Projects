<--START
CHECKSUM="cdced81ef47cd0dced8de432c3ff5ab5313a16f30a88be15ad8e818d3a357c36"
	TRACE ON
	
	IF(CUST.INTERFACE.srvErrFlg == "Y") THEN
	#{
		sv_c = BANCS.OUTPARAM.Error_num
		PRINT(sv_c)
		sv_d = 1
		IF (sv_c > 0) THEN
		#{
			sv_d = FORMAT$(sv_d, "%d")
			PRINT(("BANCS").("OUTPARAM").("ErrorCode_" + sv_d))
			PRINT(("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d))
			PRINT(("BANCS").("OUTPARAM").("Tag_" + sv_d))
			CUST.INTERFACE.errorCode = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_d)
			CUST.INTERFACE.errorDesc = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_d)
			
			#}
		ELSE
			#{
			sv_n = 1
			sv_d = 1
			sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
			WHILE (sv_d <= sv_c)
			#{
				CUST.INTERFACE.srvErrorType = "X"
				sv_f = FORMAT$(sv_d,"%d")
				sv_e = ("BANCS").("OUTPARAM").("XcpnDesc_"+sv_f)
				PRINT(sv_e)
				("CUST").("INTERFACE").("XcpnCode_" + sv_f) = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
				sv_e = ("CUST").("INTERFACE").("XcpnCode_" + sv_f)
				CUST.INTERFACE.errorCode="EXP"
				CUST.INTERFACE.errorDesc=sv_e
				PRINT(sv_e)
				sv_d = sv_d + 1
				sv_n = sv_n + 1
			#}
			DO
			
			IF(BANCS.STDIN.menuId=="HOCCM") THEN
			#{
				sv_n = 1
				sv_d = 1
				PRINT(CUST.HOCCM.srvcallmode)
				WHILE(sv_d <= sv_c)
				#{
					IF(CUST.HOCCM.srvcallmode == "E")THEN
					#{
						sv_f = FORMAT$(sv_d,"%d")
						sv_e = ("CUST").("INTERFACE").("XcpnCode_" + sv_f)
						PRINT(sv_e)
						IF(sv_e == "ABE")THEN
						#{
							
							CUST.INTERFACE.acctNum = CUST.HOCCM.d1CrAcctNum
							lv_i = CDOUBLE(CUST.HOCCM.d1CrAmt)
							lv_b = FORMAT$(lv_i,"%.2f")+"|" + CUST.HOCCM.d1CrAcctCCY+"|"
							lv_b = lv_b + 'T' +"|" + "TRTRAN" +"|"
							lv_b = lv_b +  CUST.INTERFACE.acctNum +"|0001"
							PRINT(lv_b)
							#lv_u = urhk_RaiseABEForReferral(lv_b)
							#PRINT(lv_u)
							
							
							####################################################################################################################################
							#Customization For ABE exceptions starts here
							####################################################################################################################################
							#CUST.HOCCM.d1CrAcctCCY="EUR"
							CUST.HOCCM.eventType = "%TRTRAN%"
							BANCS.INPARAM.BINDVARS = BANCS.STDIN.roleId + "|" + CUST.HOCCM.eventType + "|" + BANCS.STDIN.contextBankId
							
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_s = "slab_details|SELECT EVENT_CURR_SLAB_DETAILS FROM TBAADM.REAT WHERE "
							sv_s = sv_s + "ROLE_ID =?SVAR AND EVENT_CURR_SLAB_DETAILS LIKE ?SVAR AND BANK_ID = ?SVAR"
							PRINT(sv_s)
							sv_u = urhk_dbselectWithBind(sv_s)
							PRINT(sv_u)
							IF (sv_u ==0) THEN
							#{
								CUST.HOCCM.eventType = "TRTRAN"
								CUST.HOCCM.slab_details = BANCS.OUTPARAM.slab_details
								PRINT(CUST.HOCCM.slab_details)
								sv_y = GETPOSITION(CUST.HOCCM.slab_details,CUST.HOCCM.eventType)
								PRINT(sv_y)
								sv_j = MID$(CUST.HOCCM.slab_details,sv_y - 1,sv_y + 14)
								PRINT(sv_j)
								sv_k = STRLEN(sv_j)
								PRINT(sv_k)
								sv_k = MID$(sv_j,sv_k - 5,sv_k)
								PRINT(sv_k)
								sv_k = TRIM(sv_k)
								PRINT(sv_k)
								
								#BANCS.INPARAM.BINDVARS =sv_k +"|"+ CUST.UBP.fromCrncyCode +"|"+ CUST.UBP.amtFrmCcy +"|"+CUST.UBP.amtFrmCcy +"|"+BANCS.STDIN.contextBankId
						#BANCS.INPARAM.BINDVARS =sv_k +"|"+ CUST.UBP.crCrncyCode +"|"+lv_i +"|"+BANCS.STDIN.contextBankId
						BANCS.INPARAM.BINDVARS =sv_k +"|"+ CUST.HOCCM.d1CrAcctCCY +"|"+BANCS.STDIN.contextBankId

						PRINT(BANCS.INPARAM.BINDVARS)
						sv_s = "authMatrixId|SELECT AUTH_MATRIX_ID FROM TBAADM.AAMT WHERE AMT_SLAB_ID=?SVAR AND CRNCY_CODE=?SVAR "
						#sv_s = sv_s + "AND START_AMT <?SVAR AND END_AMT>= ?SVAR AND BANK_ID=?SVAR"
						#sv_s = sv_s + "AND START_AMT <?SVAR  AND BANK_ID=?SVAR"
						sv_s = sv_s + " AND BANK_ID=?SVAR"

						PRINT(sv_s)
								PRINT(sv_s)
								sv_u = urhk_dbselectWithBind(sv_s)
								IF(sv_u ==0) THEN
								#{
									CUST.HOCCM.authMatrixId = BANCS.OUTPARAM.authMatrixId
									PRINT(CUST.HOCCM.authMatrixId)
									
									BANCS.INPARAM.BINDVARS = CUST.HOCCM.authMatrixId +"|"+ BANCS.STDIN.contextBankId
									PRINT(BANCS.INPARAM.BINDVARS)
									sv_s = "excpCode|SELECT EXCP_CODE from CUSTOM.C_CAM "
									sv_s = sv_s + " WHERE AUTH_MATRIX_ID = ?SVAR AND BANK_ID =?SVAR"
									PRINT(sv_s)
									PRINT(BANCS.INPARAM.BINDVARS)
									sv_u = urhk_dbselectWithBind(sv_s)
									IF(sv_u ==0) THEN
									#{
										CUST.HOCCM.excpCode = BANCS.OUTPARAM.excpCode
										PRINT(CUST.HOCCM.excpCode)
										
										sv_s = CUST.HOCCM.excpCode + "|N"
										sv_u = urhk_putCustomException(sv_s)
										PRINT(sv_u)
										#}
									ELSE
										#{
										
										PRINT("EXCP CODE NOT FOUND")
										
									#}
									ENDIF
									
									
								#}
								ENDIF
							#}
							ENDIF
							####################################################################################################################################
							#Customization For ABE exceptions ends here
							####################################################################################################################################
							
							
							
							CUST.INTERFACE.errorCode=""
							CUST.INTERFACE.errorDesc=""
							
							#}
						ELSE
							#{
							sv_s = sv_e  + "|N"
							sv_u = urhk_putCustomException(sv_s)
							
							#sv_u = urhk_B2k_PutUserException(sv_e)
							#sv_u =	urhk_OWCLG_RaiseException(sv_e)
							PRINT(sv_u)
							CUST.INTERFACE.errorCode=""
							CUST.INTERFACE.errorDesc=""
							
						#}
						ENDIF
						#}
					ELSE
						#{
						CUST.INTERFACE.srvErrorType = "X"
						CUST.INTERFACE.srvError = "Y"
						sv_b = "Unable to ignore Exception Code "+sv_e
						sv_g = "Error_" + FORMAT$(sv_n,"%d") + "|SRV ERROR^" + sv_b + "^prodCode"
						PRINT(sv_g)
						sv_u = urhk_SetOrbOut(sv_g)
						PRINT(sv_u)
					#}
					ENDIF
					
					sv_d = sv_d + 1
					sv_n = sv_n + 1
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF
		#}
	ELSE
		#{
		PRINT(CUST.INTERFACE.errorCode)
		CALL("Common_Interface_GetErrorDesc.scr")
		
	#}
	ENDIF
	
	IF(FIELDEXISTS(CUST.INTERFACE.errorCode) == 1)THEN
	#{
		
		IF((CUST.INTERFACE.errorCode != "") AND (CUST.INTERFACE.errorDesc != "")) THEN
		#{
			IF(CUST.INTERFACE.srvErrFlg == "Y") THEN
			#{
				sv_c = CUST.INTERFACE.errorCode + "^" + CUST.INTERFACE.errorDesc + "^BE"
				#sv_u = urhk_SRV_SetErr(sv_c)
				sv_u = urhk_SetOrbErr(sv_c)
				PRINT(sv_u)
				#}
			ELSE
				#{
				sv_c = CUST.INTERFACE.errorCode + "|" + CUST.INTERFACE.errorDesc
				sv_u = urhk_SetOrbWarning(sv_c)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#trace off
END-->
