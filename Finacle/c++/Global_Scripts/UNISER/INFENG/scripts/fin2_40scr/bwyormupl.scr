<--START
CHECKSUM="d9548e440a7ca0cfb101a796826000de52db33c72cabf90327d01d9c2025d56a"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	CUST.DATA.errMsg1	= ""
	CUST.DATA.cnt = "0"
	CUST.DATA.curNum = ""
	BANCS.INPUT.moduleName="TRADE_FINANCE"
	BANCS.INPUT.parameterId="REMIT_TYPE"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.remitType = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.errMsg1 = BANCS.INPUT.parameterId+" setup is not done in CPARAM"
		GOTO EOS
	#}
	ENDIF
	
	BANCS.INPUT.moduleName="TRADE_FINANCE"
	BANCS.INPUT.parameterId="NOR_CODE"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.notRateCode = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.errMsg1 = BANCS.INPUT.parameterId+" setup is not done in CPARAM"
		GOTO EOS
	#}
	ENDIF
	
	
	CUST.DATA.errMesg			= ""
	CUST.DATA.ErrMsg 			= ""
	CUST.DATA.ErrCode 			= ""
	CUST.DATA.Tag				= ""
	CUST.DATA.successFailure	= ""
	CUST.DATA.funcCode			= "J"
	CUST.DATA.inOutInd			= "O"
	CUST.DATA.BODDate			= BANCS.STDIN.BODDate
	CUST.DATA.nostroVdate 		= MID$(BANCS.STDIN.BODDate,0,10)
	CUST.DATA.WarningDesc4		= "BILL(S) LODGED SUCCESSFULLY"
	
	
	#-------------------------------------------#
	#-- Get Time Stamp from Dual              --#
	#-------------------------------------------#
	
	sv_s = ""
	sv_s = sv_s + "timeStamp|"
	sv_s = sv_s + "SELECT to_char(sysdate,'ddmmyyyyhhmmss') FROM DUAL "
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		CUST.DATA.timeStamp = BANCS.OUTPARAM.timeStamp
		print(CUST.DATA.timeStamp)
	#}
	ENDIF
	
	CUST.DATA.successFile = "SWIFT_UPLOAD_REMIT_Suc_"+CUST.DATA.timeStamp+".lst"
	print(CUST.DATA.successFile)
	CUST.DATA.failureFile = "SWIFT_UPLOAD_REMIT_err_"+CUST.DATA.timeStamp+".lst"
	print(CUST.DATA.failureFile)
	#-----------------------------------------------------------------------
	#FAILURE REPORT
	#-----------------------------------------------------------------------
	CUST.DATA.aling = "--------------------------------------------------------------------------------------"
	sv_b = "echo '"+ CUST.DATA.aling +"' >"+CUST.DATA.failureFile
	print(sv_b)
	sv_d= system(sv_b)
	CUST.DATA.fName		= "SRL NUM"
	CUST.DATA.FailRep	= "FAILURE REPORT"
	CUST.DATA.ErrorRes	= "ERROR REASON"
	
	sv_b = "echo '"+ CUST.DATA.FailRep +"' >>"+CUST.DATA.failureFile
	print(sv_b)
	sv_d= system(sv_b)
	
	sv_b = "echo '"+ CUST.DATA.aling +"'>>"+CUST.DATA.failureFile
	print(sv_b)
	sv_d= system(sv_b)
	
	sv_b = "echo '"+RPAD(CUST.DATA.fName,20,' ') +"' ' ''|'	'"+ CUST.DATA.ErrorRes  +"' '|'>>"+CUST.DATA.failureFile
	print(sv_b)
	sv_d= system(sv_b)
	
	sv_b = "echo '"+ CUST.DATA.aling +"' >>"+CUST.DATA.failureFile
	print(sv_b)
	sv_d= system(sv_b)
	
	#-----------------------------------------------------------------------
	#SUCCESS  REPORT
	#-----------------------------------------------------------------------
	sv_b = "echo '"+ CUST.DATA.aling +"' >"+CUST.DATA.successFile
	print(sv_b)
	sv_d= system(sv_b)
	
	CUST.DATA.fName1		= "SRL NUM"
	CUST.DATA.SuccessRep	= "SUCCESS REPORT"
	CUST.DATA.Status		= "STATUS"
	
	sv_b = "echo '"+ CUST.DATA.SuccessRep +"' >>"+CUST.DATA.successFile
	print(sv_b)
	sv_d= system(sv_b)
	
	sv_b = "echo '"+ CUST.DATA.aling +"'>>"+CUST.DATA.successFile
	print(sv_b)
	sv_d= system(sv_b)
	
	sv_b = "echo '"+RPAD(CUST.DATA.fName1,20,' ') +"' ' ''|' '"+ CUST.DATA.Status +"'>>"+CUST.DATA.successFile
	
	print(sv_b)
	sv_d= system(sv_b)
	
	sv_b = "echo '"+ CUST.DATA.aling +"' >>"+CUST.DATA.successFile
	print(sv_b)
	sv_d= system(sv_b)
	print(sv_d)
	
	#-------------------------------------------------------------
	# Select record from CREM table based on date and process flag
	#-------------------------------------------------------------
	sv_c = "sl_no,Req_id,TxnAmtCRN,TxnAmt,debitAccid,debitChargeAccid,"
	sv_c = sv_c + "SenderName,SenderAddr1,SenderAddr2,SenderAddr3,Cnt,"
	sv_c = sv_c + "BenAcid,BenName,BenAddr1,BenAddr2,BenAddr3,"
	sv_c = sv_c + "BenCnt,BenBIC,"
	sv_c = sv_c + "CorBankBIC,"
	sv_c = sv_c + "value_date,process_flg|"
	sv_c = sv_c + "SELECT CREM_SEQ,BWAY_SEQUENCENO,remit_ccy,remit_amt,oper_acct,oper_chrg_acct,"
	sv_c = sv_c + "rem_cust_name,rem_cust_addr1,rem_cust_addr2,rem_cust_addr3,rem_cust_cntry_code,"
	sv_c = sv_c + "ben_party_acid,ben_party_name,ben_party_addr1,ben_party_addr2,ben_party_addr3,"
	sv_c = sv_c + "ben_party_cntry_code,bene_bk_BIC,"
	sv_c = sv_c + "payee_bk_BIC,"
	sv_c = sv_c + "value_date ,process_flg "
	sv_c = sv_c + "FROM CUSTOM.CREM "
	sv_c = sv_c + "WHERE value_date <= (SELECT db_stat_date FROM TBAADM.GCT WHERE GCT.bank_id=?SVAR) "
	sv_c = sv_c + "AND process_flg = 'N' "
	sv_c = sv_c + "AND bank_id = ?SVAR"
	print(sv_c)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	#---------------------------
	# initialising loop counter
	#---------------------------
	CUST.DATA.counter=0
	print(sv_c)
	sv_e = urhk_dbCursorOpenWithBind(sv_c)
	print(sv_e)
	
	IF (sv_e != 0) THEN
	#{
		GOTO EOS
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUST.DATA.cur1 = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(CUST.DATA.cur1)
	CUST.DATA.curNum = urhk_dbCursorFetch(CUST.DATA.cur1)
	print(CUST.DATA.curNum)
	WHILE (CINT(CUST.DATA.curNum) == 0)
	#{
		CUST.DATA.cnt = CINT(CUST.DATA.cnt) + 1
		print(CUST.DATA.cnt)
		print(BANCS.OUTPARAM.sl_no)
		print(BANCS.OUTPARAM.Req_id)
		print(BANCS.OUTPARAM.TxnAmtCRN)
		print(BANCS.OUTPARAM.TxnAmt)
		print(BANCS.OUTPARAM.debitAccid)
		print(BANCS.OUTPARAM.debitChargeAccid)
		print(BANCS.OUTPARAM.SenderName)
		print(BANCS.OUTPARAM.SenderAddr1)
		print(BANCS.OUTPARAM.SenderAddr2)
		print(BANCS.OUTPARAM.SenderAddr3)
		print(BANCS.OUTPARAM.Cnt)
		print(BANCS.OUTPARAM.BenName)
		print(BANCS.OUTPARAM.BenAddr1)
		print(BANCS.OUTPARAM.BenAddr2)
		print(BANCS.OUTPARAM.BenAddr3)
		print(BANCS.OUTPARAM.BenCnt)
		print(BANCS.OUTPARAM.BenBIC)
		print(BANCS.OUTPARAM.CorBankBIC)
		print(BANCS.OUTPARAM.value_date)
		print(BANCS.OUTPARAM.process_flg)
		#--------------------------------------
		# Data to be provided by Customer
		#--------------------------------------
		CUST.DATA.sl_no = BANCS.OUTPARAM.sl_no
		CUST.DATA.Req_id = BANCS.OUTPARAM.Req_id
		CUST.DATA.TxnAmtCRN = BANCS.OUTPARAM.TxnAmtCRN
		CUST.DATA.debitAccid = BANCS.OUTPARAM.debitAccid
		CUST.DATA.debitChargeAccid = BANCS.OUTPARAM.debitChargeAccid
		CUST.DATA.TxnAmt = BANCS.OUTPARAM.TxnAmt
		#Reciever
		CUST.DATA.BenAcid = BANCS.OUTPARAM.BenAcid
		CUST.DATA.BenName = BANCS.OUTPARAM.BenName
		CUST.DATA.BenAddr1 = BANCS.OUTPARAM.BenAddr1
		CUST.DATA.BenAddr2 = BANCS.OUTPARAM.BenAddr2
		CUST.DATA.BenAddr3 = BANCS.OUTPARAM.BenAddr3
		CUST.DATA.BenCnt = BANCS.OUTPARAM.BenCnt
		#Sender
		CUST.DATA.SenderName = BANCS.OUTPARAM.SenderName
		CUST.DATA.SenderAddr1 = BANCS.OUTPARAM.SenderAddr1
		CUST.DATA.SenderAddr2 = BANCS.OUTPARAM.SenderAddr2
		CUST.DATA.SenderAddr3 = BANCS.OUTPARAM.SenderAddr3
		CUST.DATA.Cnt = BANCS.OUTPARAM.Cnt
		#--------------------------------------
		# Data to be provided by Bank
		#--------------------------------------
		CUST.DATA.value_date = BANCS.OUTPARAM.value_date
		CUST.DATA.process_flg = BANCS.OUTPARAM.process_flg
		#Getting the value for Coorespondant Bank
		CUST.DATA.CorBankBIC = BANCS.OUTPARAM.CorBankBIC
		#Getting the value for Recieving Bank
		CUST.DATA.BenBIC = BANCS.OUTPARAM.BenBIC
		#----------------------------
		# validating Debit account
		#----------------------------
		CUST.DATA.errMesg = ""
		print(CUST.DATA.debitAccid)
		sv_b = CUST.DATA.debitAccid
		IF (sv_b == "") THEN
		#{
			CUST.DATA.errMesg = "Blank account"
			print(CUST.DATA.errMesg)
			#}
		ELSE
			#{
			sv_a = urhk_valAcctNumber(sv_b)
			IF (sv_a == 0) THEN
			#{
				print(sv_a)
				sv_a = urhk_getAcctDetailsInRepository(sv_b)
				
				IF (sv_a == 0) THEN
				#{
					print(sv_a)
					
					IF (BANCS.OUTPARAM.acctCloseDate != "") THEN
					#{
						CUST.DATA.errMesg = "Account closed"
					#}
					ENDIF
					
					IF (BANCS.OUTPARAM.systemOnlyAcctFlg == "Y") THEN
					#{
						CUST.DATA.errMesg = "Only system generated transactions are allowed ON the account"
					#}
					ENDIF
					
					IF (trim(BANCS.OUTPARAM.freezeCode) != "") THEN
					#{
						CUST.DATA.errMesg = "Account frozen. Freeze code=" + BANCS.OUTPARAM.freezeCode
					#}
					ENDIF
					
					IF (BANCS.OUTPARAM.entityCreFlag != "Y") THEN
					#{
						CUST.DATA.errMesg = "Account unverified"
					#}
					ENDIF
					
					IF (BANCS.OUTPARAM.schmType == "LAA") THEN
					#{
						CUST.DATA.errMesg = "Loan Account cannot be used for remittance"
					#}
					ENDIF
					
					IF (BANCS.OUTPARAM.schmType == "TDA") THEN
					#{
						CUST.DATA.errMesg = "Term Deposit Account cannot be used for remittance"
					#}
					ENDIF
					
					IF (BANCS.OUTPARAM.schmType == "FBA") THEN
					#{
						CUST.DATA.errMesg = "Foreign Bill Account cannot be used for remittance"
					#}
					ENDIF
					
					IF (BANCS.OUTPARAM.schmType == "PCA") THEN
					#{
						CUST.DATA.errMesg = "Packing Credit Account cannot be used for remittance"
					#}
					ENDIF
					
					# For later use
					CUST.DATA.acctOpenDate = BANCS.OUTPARAM.acctOpenDate
					print(BANCS.OUTPARAM.EffAvailableAmt)
					print(BANCS.OUTPARAM.acctCrncyCode)
					CUST.DATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
					
					#-------------------------------------------------------------
					# Case: Debit account currency and remit currency are different
					#--------------------------------------------------------------
					
					IF (BANCS.OUTPARAM.acctCrncyCode != CUST.DATA.TxnAmtCRN) THEN
					#{
						BANCS.INPARAM.InputAmount = cdouble(CUST.DATA.EffAvailableAmt)
						BANCS.INPARAM.FromCurrency = BANCS.OUTPARAM.acctCrncyCode
						BANCS.INPARAM.ToCurrency = CUST.DATA.TxnAmtCRN
						
						# Hard Code the Rate to be Used
						BANCS.INPARAM.RateCode = "NOR"
						BANCS.INPARAM.Rate = 0
						
						sv_s = urhk_B2k_ConvertAmount("")
						print(sv_s)
						
						IF (sv_s == 0) THEN
						#{
							CUST.DATA.EffAvailableAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
						#}
						ENDIF
						
						print(CUST.DATA.EffAvailableAmt)
					#}
					ENDIF
					
					IF (cdouble(CUST.DATA.EffAvailableAmt) < cdouble(CUST.DATA.TxnAmt)) THEN
					#{
						CUST.DATA.errMesg = "Insufficient effective available amount"
					#}
					ENDIF
					
					print(CUST.DATA.errMesg)
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.DATA.errMesg = "Invalid account number"
				print(CUST.DATA.errMesg)
			#}
			ENDIF
		#}
		ENDIF
		
		#-------------------------------------------------------
		# In case any Failure in validation Set process flag in
		# CREM table as X and exit and process next record
		#-------------------------------------------------------
		
		IF (CUST.DATA.errMesg != "") THEN
		#{
			print(CUST.DATA.Req_id)
			print(CUST.DATA.errMesg)
			
			#Set Process_flg
			
			sv_a = "UPDATE CUSTOM.CREM SET process_flg='X',free_text_3 = " + "'"+CUST.DATA.errMesg+"'" + " where BWAY_SEQUENCENO="
			sv_a = sv_a + "'"+CUST.DATA.Req_id +"'"
			sv_a = sv_a + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
			print(sv_a)
			
			sv_b = "echo '"+RPAD(CUST.DATA.sl_no,17,' ')+"''|''"+CUST.DATA.errMesg+"' '|'>>"+CUST.DATA.failureFile
			print(sv_b)
			sv_x = system(sv_b)
			print(sv_x)
			
			sv_z = urhk_dbSQLWithBind(sv_a)
			print(sv_z)
			
			IF(sv_z == 0)THEN
			#{
				sv_b = urhk_dbSQLWithBind("COMMIT")
				#}
			ELSE
				#{
				GOTO FETCHNEXTRECORD
			#}
			ENDIF
			GOTO FETCHNEXTRECORD
		#}
		ENDIF
		
		#--------------------------------------------------------------------
		#   Deriving Bank Code and Branch Code from BIC for Recieving Bank
		#---------------------------------------------------------------------
		
		IF (CUST.DATA.BenBIC!="") THEN
		#{
			sv_a = "draweeBankCode,draweeBranchCode|SELECT bank_code,branch_code FROM TBAADM.BRBIC "
			sv_a = sv_a + " WHERE bank_identifier = '" + CUST.DATA.BenBIC + "'"
			sv_a = sv_a + " AND paysys_id = 'SWIFT'"
			sv_a = sv_a + " AND bank_code IN (SELECT bank_code FROM TBAADM.BKC "
			sv_a = sv_a + " WHERE del_flg!='Y' AND bank_corres_flg='Y')"
			sv_a = sv_a + " AND rownum < 2"
			sv_a = sv_a + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
			print(sv_a)
			sv_d = urhk_dbSelectWithBind(sv_a)
			print(sv_d)
			
			IF (sv_d=="0") THEN
			#{
				CUST.DATA.draweeBankCode = BANCS.OUTPARAM.draweeBankCode
				CUST.DATA.draweeBranchCode = BANCS.OUTPARAM.draweeBranchCode
				#}
			ELSE
				#{
				#---------------------------------------
				# If beneficiary Bank BIC is not present
				# then set process_flag as X
				#---------------------------------------
				
				CUST.DATA.errMesg = "Ben. BIC is not present"
				sv_a = "UPDATE CUSTOM.CREM SET process_flg='X',free_text_3 = " + "'"+CUST.DATA.errMesg+"'" + " WHERE BWAY_SEQUENCENO="
				sv_a = sv_a + "'"+CUST.DATA.Req_id +"'"
				sv_a = sv_a + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
				print(sv_a)
				
				sv_b = "echo '"+RPAD(CUST.DATA.sl_no,17,' ')+"''|''"+CUST.DATA.errMesg+"' '|'>>"+CUST.DATA.failureFile
				print(sv_b)
				sv_x = system(sv_b)
				print(sv_x)
				sv_z = urhk_dbSQLWithBind(sv_a)
				print(sv_z)
				
				IF(sv_z == 0)THEN
				#{
					sv_b = urhk_dbSQLWithBind("COMMIT")
					#}
				ELSE
					#{
					GOTO FETCHNEXTRECORD
				#}
				ENDIF
				GOTO FETCHNEXTRECORD
			#}
			ENDIF
			
			#}
		ELSE
			#{
			#---------------------------------------
			# If beneficiary Bank BIC is not present
			# then set process_flag as X
			#---------------------------------------
			CUST.DATA.errMesg = "Ben. BIC is not present"
			sv_a = "UPDATE CUSTOM.CREM SET process_flg='X',free_text_3 = " + "'"+CUST.DATA.errMesg+"'" + " WHERE BWAY_SEQUENCENO="
			sv_a = sv_a + "'"+CUST.DATA.Req_id +"'"
			sv_a = sv_a + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
			print(sv_a)
			
			sv_b = "echo '"+RPAD(CUST.DATA.sl_no,17,' ')+"''|''"+CUST.DATA.errMesg+"' '|'>>"+CUST.DATA.failureFile
			print(sv_b)
			sv_x = system(sv_b)
			print(sv_x)
			sv_z = urhk_dbSQLWithBind(sv_a)
			print(sv_z)
			
			IF(sv_z == 0)THEN
			#{
				sv_b = urhk_dbSQLWithBind("COMMIT")
				#}
			ELSE
				#{
				GOTO FETCHNEXTRECORD
			#}
			ENDIF
			GOTO FETCHNEXTRECORD
		#}
		ENDIF
		
		
		#--------------------------------------
		# Getting the sol details from account
		#--------------------------------------
		sv_j = urhk_getAcctDetailsInRepository(CUST.DATA.debitAccid)
		print(sv_j)
		
		IF(sv_j == 1)THEN
		#{
			GOTO FETCHNEXTRECORD
		#}
		ENDIF
		
		print(BANCS.OUTPARAM.acctSolId)
		print(BANCS.OUTPARAM.custId)
		
		CUST.DATA.custId = BANCS.OUTPARAM.custId
		
		#--------------------------------------------------
		# Changing sol Id of the user to access any account
		#---------------------------------------------------
		
		BANCS.STDIN.homeSolId=BANCS.OUTPARAM.acctSolId
		print(BANCS.STDIN.homeSolId)
		CUST.DATA.solId = BANCS.OUTPARAM.acctSolId
		
		
		sv_u = urhk_SetUrhkInp("remCritDtls.funcCode|"+CUST.DATA.funcCode)
		sv_u = urhk_SetUrhkInp("remCritDtls.solId.solId|"+CUST.DATA.solId)
		sv_u = urhk_SetUrhkInp("remCritDtls.remitType.remitType|"+CUST.DATA.remitType)
		sv_u = urhk_SetUrhkInp("remCritDtls.remitCrncy.crncyCode|"+CUST.DATA.TxnAmtCRN)
		sv_u = urhk_SetUrhkInp("remCritDtls.inOutInd|"+CUST.DATA.inOutInd )
		sv_u = urhk_ExecSrv("SRV_FetchDfltORDtlsForLdgNRlz|retain_all_output = Y")
		
		IF(sv_u != 0)THEN
		#{
			print("Error")
			sv_k = BANCS.OUTPARAM.Error_num
			print (sv_k)
			IF (sv_k >0) THEN
			#{
				sv_l = 1
				sv_p = FORMAT$(sv_l,"%d")
				CUST.DATA.ErrMsg = ("BANCS").("OUTPARAM").("ErrorMesg_"+ sv_p)
				sv_m = ""
				CUST.DATA.ErrMsg = sv_m + CUST.DATA.ErrMsg
				print(CUST.DATA.ErrMsg)
				CUST.DATA.ErrCode = ("BANCS").("OUTPARAM").("ErrorCode_"+ sv_p)
				print(CUST.DATA.ErrCode)
				CUST.DATA.Tag = ("BANCS").("OUTPARAM").("Tag_"+ sv_p)
				print(CUST.DATA.Tag)
				CUST.DATA.successFailure = "F"
			#}
			ENDIF
			
			sv_s = ""
			sv_a = "UPDATE CUSTOM.CREM SET process_flg='X',free_text_3 = " + "'"+CUST.DATA.ErrMsg+"'" + " where BWAY_SEQUENCENO="
			sv_a = sv_a + "'"+CUST.DATA.Req_id +"'"
			sv_a = sv_a + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
			print(sv_a)
			sv_b = "echo '"+RPAD(CUST.DATA.sl_no,17,' ')+"' '|' '"+CUST.DATA.ErrMsg+"' '|'>>"+CUST.DATA.failureFile
			print(sv_b)
			sv_x = system(sv_b)
			print(sv_x)
			sv_d = urhk_dbSQLWithBind(sv_a)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				sv_e = urhk_dbSQLWithBind("COMMIT")
				GOTO FETCHNEXTRECORD
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_c = urhk_CopyOutToIn("")
			print(sv_c)
		#}
		ENDIF
		
		sv_u = urhk_SetUrhkInp("remTranDtls.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("remTranDtls.tranType|T")
		sv_u = urhk_SetUrhkInp("remTranDtls.tranSubType|CI")
		sv_u = urhk_SetUrhkInp("remGenDtls.remitSubType|T")
		sv_u = urhk_SetUrhkInp("remGenDtls.roundOffFlg|N")
		sv_u = urhk_SetUrhkInp("remGenDtls.solId.solId|"+CUST.DATA.solId)
