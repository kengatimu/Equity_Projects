<--start
trace on
callscriptifexist("ebRepClass.scr")

lv_s = "CustName,CustBranch,CustConst,AcctNo,AcctName,AcctCCY,AcctBranch,AcctSchm,AcctModeOfOper,AcctStatus|"
lv_s = lv_s + " select name,cs.sol_desc, custom.fn_ref_desc(gam.bank_id,constitution_ref_code,'44') ,  "
lv_s = lv_s + " foracid ,acct_name,acct_crncy_code, acs.sol_desc,gsp.schm_desc, "
lv_s = lv_s + " custom.fn_ref_desc(gam.bank_id,mode_of_oper_code,'27') as modeofopr , "
lv_s = lv_s + " custom.fn_acct_status(gam.bank_id,foracid) as accountstatus "
lv_s = lv_s + " from crmuser.accounts a,tbaadm.sol cs,tbaadm.gam,tbaadm.sol acs,tbaadm.gsp  "
lv_s = lv_s + " where a.orgkey='"+EBSRV.GLBDATA.custId+"' "
lv_s = lv_s + " and gam.bank_id = ?SVAR " 
lv_s = lv_s + " and gsp.bank_id = ?SVAR " 
lv_s = lv_s + " and a.primary_sol_id=cs.sol_id "
lv_s = lv_s + " and gam.foracid=?SVAR "
lv_s = lv_s + " and gam.schm_code=gsp.schm_code "
lv_s = lv_s + " and gam.sol_id=acs.sol_id "
PRINT(lv_s)

BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.accNo
PRINT(BANCS.INPARAM.BINDVARS)

lv_r = urhk_dbSelectWithBind(lv_s)
PRINT(lv_r)

IF (lv_r == "0") THEN
#{
	EBSRV.GLBDATA.CustName = BANCS.OUTPARAM.CustName
	PRINT(EBSRV.GLBDATA.CustName)
	EBSRV.GLBDATA.CustBranch = BANCS.OUTPARAM.CustBranch
	PRINT(EBSRV.GLBDATA.CustBranch)
	EBSRV.GLBDATA.CustConst = BANCS.OUTPARAM.CustConst
	PRINT(EBSRV.GLBDATA.CustConst)
	IF(EBSRV.GLBDATA.CustConst == "No Data Found") THEN
	#{
		EBSRV.GLBDATA.CustConst = ""
	#}
	ENDIF
	EBSRV.GLBDATA.AcctNo = BANCS.OUTPARAM.AcctNo
	PRINT(EBSRV.GLBDATA.AcctNo)
	EBSRV.GLBDATA.AcctName = BANCS.OUTPARAM.AcctName
	PRINT(EBSRV.GLBDATA.AcctName)
	EBSRV.GLBDATA.AcctCCY = BANCS.OUTPARAM.AcctCCY
	PRINT(EBSRV.GLBDATA.AcctCCY)
	EBSRV.GLBDATA.AcctBranch = BANCS.OUTPARAM.AcctBranch
	PRINT(EBSRV.GLBDATA.AcctBranch)
	EBSRV.GLBDATA.AcctSchm = BANCS.OUTPARAM.AcctSchm
	PRINT(EBSRV.GLBDATA.AcctSchm)
	EBSRV.GLBDATA.AcctModeOfOper = BANCS.OUTPARAM.AcctModeOfOper
	PRINT(EBSRV.GLBDATA.AcctModeOfOper)
	IF(EBSRV.GLBDATA.AcctModeOfOper == "No Data Found") THEN
	#{
		EBSRV.GLBDATA.AcctModeOfOper = ""
	#}
	ENDIF
	EBSRV.GLBDATA.AcctStatus = BANCS.OUTPARAM.AcctStatus
	PRINT(EBSRV.GLBDATA.AcctStatus)
#}
ELSE
#{
	EBSRV.GLBDATA.errMsg = "Invalid Account!!!"
	GOTO ENDOFSCR
#}
ENDIF

lv_s = " RecCnt | select count(1) from custom.cust_alerts_tbl "
lv_s = lv_s + " where cust_id='"+EBSRV.GLBDATA.custId+"' "
lv_s = lv_s + " and foracid = ?SVAR "
lv_s = lv_s + " and bank_id = ?SVAR "
lv_s = lv_s + " and del_flg <> 'Y' "
lv_s = lv_s + " and entity_cre_flg = 'Y' "
PRINT(lv_s)

BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)

lv_r = urhk_dbSelectWithBind(lv_s)
IF ( lv_r == "0") THEN
#{	
	EBSRV.GLBDATA.RecCnt = BANCS.OUTPARAM.RecCnt
	PRINT(EBSRV.GLBDATA.RecCnt)

	IF ( EBSRV.GLBDATA.RecCnt != "0"  ) THEN
	#{
		lv_s = "ChargeAccountNo,ChargeAccountCCY,DrAlertFlag,MinDrAmount,CrAlertFlag, "
		lv_s = lv_s + " MinCrAmount,MobileNo,EmailAddress,AlertStatus,ChargeAcctClsFlg,ChargeAcctStatus|"
		lv_s = lv_s + " select charge_foracid,g.acct_crncy_code,dr_alert_flg, "
		lv_s = lv_s + " nvl(dr_min_amount,0),cr_alert_flg,nvl(cr_min_amount,0), "
		lv_s = lv_s + " mobile_no,email_address,activation_status,g.acct_cls_flg,custom.fn_acct_status(g.bank_id,g.foracid) "
		lv_s = lv_s + " from custom.cust_alerts_tbl a,tbaadm.gam g"
		lv_s = lv_s + " where a.cust_id='"+EBSRV.GLBDATA.custId+"' "
		lv_s = lv_s + " and a.foracid = ?SVAR "
		lv_s = lv_s + " and a.foracid = g.foracid "
		lv_s = lv_s + " and g.bank_id = ?SVAR " 
		#For Duplicate	
		lv_s = lv_s + " and a.del_flg = 'N' "
		lv_s = lv_s + " and a.entity_cre_flg = 'Y' "
		#lv_s = lv_s + " and a.activation_status = 'Y'"
		PRINT(lv_s)

		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		lv_r = urhk_dbSelectWithBind(lv_s)
		PRINT(lv_r)
		IF ( lv_r == "0") THEN
		#{
			EBSRV.GLBDATA.ChargeAccountNo = BANCS.OUTPARAM.ChargeAccountNo
			PRINT(EBSRV.GLBDATA.ChargeAccountNo)
			EBSRV.GLBDATA.ChargeAccountCCY = BANCS.OUTPARAM.ChargeAccountCCY
			PRINT(EBSRV.GLBDATA.ChargeAccountCCY)
			EBSRV.GLBDATA.DrAlertFlag = BANCS.OUTPARAM.DrAlertFlag
			PRINT(EBSRV.GLBDATA.DrAlertFlag)
			EBSRV.GLBDATA.MinDrAmount = BANCS.OUTPARAM.MinDrAmount
			PRINT(EBSRV.GLBDATA.MinDrAmount)
			EBSRV.GLBDATA.CrAlertFlag = BANCS.OUTPARAM.CrAlertFlag
			PRINT(EBSRV.GLBDATA.CrAlertFlag)
			EBSRV.GLBDATA.MinCrAmount = BANCS.OUTPARAM.MinCrAmount
			PRINT(EBSRV.GLBDATA.MinCrAmount)
			EBSRV.GLBDATA.MobileNo = BANCS.OUTPARAM.MobileNo
			PRINT(EBSRV.GLBDATA.MobileNo)
			EBSRV.GLBDATA.EmailAddress = BANCS.OUTPARAM.EmailAddress
			PRINT(EBSRV.GLBDATA.EmailAddress)
			EBSRV.GLBDATA.AlertStatus = BANCS.OUTPARAM.AlertStatus
			PRINT(EBSRV.GLBDATA.AlertStatus)
			EBSRV.GLBDATA.ChargeAcctClsFlg = BANCS.OUTPARAM.ChargeAcctClsFlg
			PRINT(EBSRV.GLBDATA.ChargeAcctClsFlg)
			EBSRV.GLBDATA.ChargeAcctStatus = BANCS.OUTPARAM.ChargeAcctStatus
			PRINT(EBSRV.GLBDATA.ChargeAcctStatus)
			EBSRV.GLBDATA.RecType = "MAIN"
			GOTO ENDOFSCR
		ELSE
			EBSRV.GLBDATA.errMsg = "Alert Details Not Found!!!"
			GOTO ENDOFSCR
		#}
		ENDIF
	#}	
	ELSE
	#{
		EBSRV.GLBDATA.errMsg = "Alert Details Not Found!!!"
		GOTO ENDOFSCR
	#}
	ENDIF
#}
ENDIF
ENDOFSCR:
ENDOFSCRIPT:
        exitscript
trace off
end-->
