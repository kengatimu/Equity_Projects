	print(BANCS.INPARAM.BINDVARS)
	sv_s = "frezCode,crSchmType,crCrncyCode|"
	sv_s = sv_s + " SELECT FREZ_CODE,SCHM_TYPE,ACCT_CRNCY_CODE "
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR "
	#sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID IS NOT NULL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# error
		CUST.INTERFACE.errorCode = "HOCCM_ERR_001"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.UBP.errorMsg = CUST.INTERFACE.errorDesc
