	# Only operative accounts and office account will be allowed.
	# TDA/TUA/LAA/DDA/CLA type account are not be allowed
	IF ( (CUST.UBP.crSchmType == "TDA") OR (CUST.UBP.crSchmType == "TUA") OR (CUST.UBP.crSchmType == "LAA") OR (CUST.UBP.crSchmType == "DDA") OR (CUST.UBP.crSchmType == "CLA") ) THEN
