		#{
			CUST.INTERFACE.errorCode = "HOCCM_ERR_001"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.UBP.errorMsg = CUST.INTERFACE.errorDesc
			sv_w = "SUCCESSORFAILURE|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_z = "Error|" + CUST.UBP.errorMsg
			sv_u = urhk_SetOrbOut(sv_z)
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.UBP.crACID = BANCS.OUTPARAM.Acid
			print(CUST.UBP.crACID)
		#}
		ENDIF
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Getting account details for further charge calculation.
	#--------------------------------------------------------------------------
	#SELECT FREZ_CODE,SCHM_TYPE FROM TBAADM.GAM WHERE FORACID = '1020160656991';
	#BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNum + "|" +TRIM(BANCS.STDIN.contextBankId)
