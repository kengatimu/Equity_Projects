		sv_u = urhk_SetOrbOut(sv_z)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.UBP.CrAccountName = BANCS.OUTPARAM.CrAccountName
		print(CUST.UBP.CrAccountName)
		CUST.UBP.CrSolId = BANCS.OUTPARAM.CrSolId
		print(CUST.UBP.CrSolId)
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------
	# sending values to FE.
	#--------------------------------------------------------------------------
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	#sv_w = "userId|" + CUST.UBP.userId
	#sv_u = urhk_SetOrbOut(sv_w)
	#sv_w = "bankId|" + CUST.UBP.bankId
