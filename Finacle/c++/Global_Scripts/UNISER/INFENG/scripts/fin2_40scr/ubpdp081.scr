	#------------------------------------------------------------------------------
	#  Validating credit Account Id.
	#------------------------------------------------------------------------------
	IF ((CUST.UBP.critCrAcctNum=="1038200435666") OR (CUST.UBP.critCrAcctNum=="2011211305798")) THEN
		sv_q = "Acid|"
		sv_q = sv_q + "select acid from tbaadm.gam where "
		sv_q = sv_q + " foracid = ?SVAR "
