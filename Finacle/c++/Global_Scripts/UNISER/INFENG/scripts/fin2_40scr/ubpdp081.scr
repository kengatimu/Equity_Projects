	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# selecting account name
	#--------------------------------------------------------------------------
	#BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNum + "|" + CUST.UBP.bankId
	BANCS.INPARAM.BINDVARS = CUST.UBP.critCrAcctNum
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "CrAccountName,CrSolId|"
	sv_s = sv_s + " SELECT ACCT_NAME,SOL_ID"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR "
	#sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID IS NOT NULL "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# error
		sv_w = "SUCCESSORFAILURE|N"
		sv_u = urhk_SetOrbOut(sv_w)
		sv_m = "Invalid Account Id."
