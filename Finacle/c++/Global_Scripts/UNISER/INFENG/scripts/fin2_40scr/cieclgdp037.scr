<--START
CHECKSUM="f6784c32c72ca1e21d3f90cb42dcd5a652998ba55d095e9d79e5b3956e2d6f61"
	TRACE ON
	
	PRINT(CUST.CIECLG.instrumentEntity)
	PRINT(CUST.CIECLG.instrumentBankCode)
	PRINT(CUST.CIECLG.payingAcct)
	
	###########################################################################################
	# Equity Bank - Bank Codes for different entities
	###########################################################################################
	
	CUST.CIECLG.parameterValue = ""
	CUST.CIECLG.parameterId = "EBL_BANK_CODE_" + CUST.CIECLG.instrumentEntity
	print(CUST.CIECLG.parameterId)
	sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_s = "Error_1|Error^Unable to get Equity Bank Code to validate Paying Account ID; Paramter Not set in CPARAM^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
	PRINT(CUST.CIECLG.parameterValue)
	
	IF(TRIM(CUST.CIECLG.parameterValue) == "")THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_s = "Error_1|Error^Unable to get Equity Bank Code to validate Paying Account ID; Paramter Not set in CPARAM^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CIECLG.instrumentBankCode != CUST.CIECLG.parameterValue)THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	CUST.CIECLG.acctBankId = ""
	sv_s = "acctBankId,acctClsFlg|"
	sv_s = sv_s + " SELECT BANK_ID,ACCT_CLS_FLG FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIECLG.payingAcct
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_s = "Error_1|Error^Invalid Payee Account ID^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
		CUST.CIECLG.errorMsg = "Invalid Payee Account ID"
	#}
	ENDIF
	
	CUST.CIECLG.acctBankId = BANCS.OUTPARAM.acctBankId
	PRINT(CUST.CIECLG.acctBankId)
	
	IF(CUST.CIECLG.acctBankId != CUST.CIECLG.instrumentEntity)THEN
	#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_s = "Error_1|Error^Entered Payee Account ID does not belong to Entered Instrument Entity^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
END-->
