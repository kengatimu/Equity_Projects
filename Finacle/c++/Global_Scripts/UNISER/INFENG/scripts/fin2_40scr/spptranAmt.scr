###########################################################################################

<--START
#TRACE ON

###########################################################################################
# Creating Repositories and Classes
###########################################################################################

###########################################################################################
# Check whether CUST Repository exists else create it
###########################################################################################

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

###########################################################################################
# Check whether SPPDATA Class exists else create it
###########################################################################################

        sv_r = CLASSEXISTS("CUST","SPPDATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","SPPDATA",5)
        #}
        ENDIF

	#sv_t = urhk_B2K_printRepos("BANCS")

###########################################################################################
# Include Library CUSTOMSO
###########################################################################################

        InclLib:
        #{
                libname CUSTOMSO
                RETURN
        #}

###########################################################################################
# Initializing local variables
###########################################################################################

CUST.SPPDATA.amt = ""
CUST.SPPDATA.foracid = ""
CUST.SPPDATA.beginChqNum = ""
CUST.SPPDATA.noOfLvs = ""
CUST.SPPDATA.acid = ""
CUST.SPPDATA.comp = ""
CUST.SPPDATA.effBal = ""
CUST.SPPDATA.acctCurr = ""
CUST.SPPDATA.Lvs = ""

#print(BANCS.INPUT.acctId)
#print(BANCS.INPUT.beginChqNum)
#print(BANCS.INPUT.noOfLvs)

###########################################################################################
# Get the input from the front end 
###########################################################################################

	IF(FIELDEXISTS(BANCS.INPUT.acctId) ==1) THEN
	#{	
		CUST.SPPDATA.foracid = BANCS.INPUT.acctId
		#PRINT(CUST.SPPDATA.foracid)
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.beginChqNum) ==1) THEN
	#{
		CUST.SPPDATA.beginChqNum = BANCS.INPUT.beginChqNum
		#PRINT(CUST.SPPDATA.beginChqNum)
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.noOfLvs) ==1) THEN
	#{
		CUST.SPPDATA.Lvs = BANCS.INPUT.noOfLvs
		print(CUST.SPPDATA.Lvs)
		CUST.SPPDATA.noOfLvs = LPAD(CUST.SPPDATA.Lvs,3,'0')
		PRINT(CUST.SPPDATA.noOfLvs)
	#}
	ENDIF

###########################################################################################
# Fetching Acid from Gam
###########################################################################################
	
	sv_s = "acid|SELECT acid"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE foracid=?SVAR"
	sv_s = sv_s + " AND entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND del_flg = 'N'"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	#print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.SPPDATA.foracid+"|"+BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)

        IF(sv_d == 0)THEN
        #{
                CUST.SPPDATA.acid =  BANCS.OUTPARAM.acid
        #}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
        ENDIF

###########################################################################################
# Creating CompB2k field which is used to get Charge Amount from tbaadm.cxl table
# COMP_B2KID in CXL will have the value of acid, begin cheque no and SPT serial number appeneded
# for stop payment the serial number is always going as "001" so instead of No of leaves being
# appeneded we are appended "001"
###########################################################################################
#CUST.SPPDATA.comp=CUST.SPPDATA.acid+CUST.SPPDATA.beginChqNum+CUST.SPPDATA.noOfLvs
CUST.SPPDATA.comp=CUST.SPPDATA.acid+CUST.SPPDATA.beginChqNum+"001"
print(CUST.SPPDATA.comp)

##########################################################################################
# Fetching Charge Amount from tbaadm.cxl table
##########################################################################################

	sv_s = "amt|SELECT actual_amt_coll"
	sv_s = sv_s + " FROM TBAADM.CXL"
	sv_s = sv_s + " WHERE COMP_B2KID_TYPE = 'SPCHG' and replace(COMP_B2KID,' ','')=?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.SPPDATA.comp+"|"+BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
        IF(sv_d == 0)THEN
        #{
                CUST.SPPDATA.amt = BANCS.OUTPARAM.amt
		print(CUST.SPPDATA.amt)
        #}
        ENDIF

###########################################################################################
# Fetching Account Currency and Effective Balance of the given account
###########################################################################################

	sv_h = urhk_getAcctDetailsInRepository(CUST.SPPDATA.foracid)

	CUST.SPPDATA.acctCurr = BANCS.OUTPARAM.acctCrncyCode
	print(CUST.SPPDATA.acctCurr)

	#CUST.SPPDATA.effBal = BANCS.OUTPARAM.FullEffAvailableAmt
	#print(CUST.SPPDATA.effBal)
	#CORRECT BALANCE
	CUST.SPPDATA.effBal = BANCS.OUTPARAM.EffAvailableAmt
	print(CUST.SPPDATA.effBal)
	#for testing purpose
	#CUST.SPPDATA.effBal=BANCS.OUTPARAM.clearBalance
	#print(CUST.SPPDATA.effBal)

###########################################################################################
# Checking Whether effective balance is less than Charge Amount
###########################################################################################

	IF(CDOUBLE(CUST.SPPDATA.effBal) < CDOUBLE(CUST.SPPDATA.amt)) THEN
	#{

##########################################################################################
# Sending data to the Front end
##########################################################################################

		sv_u = urhk_SetOrbOut("stat|Y")
		sv_u = urhk_SetOrbOut("chgAmt|"+CUST.SPPDATA.amt)
		sv_u = urhk_SetOrbOut("tranCurr|"+CUST.SPPDATA.acctCurr)
		sv_u = urhk_SetOrbOut("effBal|"+CUST.SPPDATA.effBal)	
	#}
	ELSE
	#{
		sv_u = urhk_SetOrbOut("stat|N")
	#}
	ENDIF


ENDOFSCRIPT:

EXITSCRIPT

#TRACE OFF
END-->
