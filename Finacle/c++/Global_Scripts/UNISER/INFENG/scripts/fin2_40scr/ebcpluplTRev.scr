                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = "FloatFund"
                sv_u = urhk_MTTS_definePartTran("SettleDr")
                print(sv_u)
                if(sv_u!=0)then
