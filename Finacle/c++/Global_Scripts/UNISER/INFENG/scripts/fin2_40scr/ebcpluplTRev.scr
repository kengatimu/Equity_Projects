	sv_c = sv_c + " and benef_bank_code= ?SVAR "
	sv_c = sv_c + " and benef_branch_code= ?SVAR "
	print(sv_c)
	####BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  trim(EQSRV.GLBDATA.CoreId) + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQSRV.GLBDATA.batchId + "|" + EQSRV.GLBDATA.beneficiaryAcct + "|" + EQSRV.GLBDATA.benefBankCode + "|" + EQSRV.GLBDATA.benefBrCode 
