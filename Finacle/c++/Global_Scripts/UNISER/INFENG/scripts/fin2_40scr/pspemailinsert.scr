<--START
CHECKSUM="5abdcd803d39f123d227f4487fbd9872b5d2e70750b16aa4aeb42381f2c50ebc"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("foracid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply foracid"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.foracid=BANCS.INPUT.foracid
		print(CUST.DATA.foracid)
		IF (FIELDEXISTS(CUST.DATA.foracid) == 1)  THEN
		#{
			IF (CUST.DATA.foracid != "") THEN
			#{
				BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
				sv_s = "acid|SELECT ACID FROM TBAADM.GAM WHERE ENTITY_CRE_fLG='Y' AND DEL_FLG='N' AND FORACID = ?SVAR AND BANK_ID = ?SVAR"
				sv_u = urhk_dbselectWithBind(sv_s)
				IF(sv_u != 0) THEN
				#{
					CUST.DATA.errMsg="The account does not exist"
					sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
					GOTO End
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("date_from"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply date_from"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.date_from=BANCS.INPUT.date_from
		print(CUST.DATA.date_from)
		
		sv_s = "date_from|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
		BANCS.INPARAM.BINDVARS =  CUST.DATA.date_from
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
		#{
			CUST.DATA.date_from = BANCS.OUTPARAM.date_from
			print(CUST.DATA.date_from)
		#}
		ENDIF
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("date_to"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply date_to"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.date_to=BANCS.INPUT.date_to
		print(CUST.DATA.date_to)
		sv_s = "date_to|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
		BANCS.INPARAM.BINDVARS =  CUST.DATA.date_to
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
		#{
			CUST.DATA.date_to = BANCS.OUTPARAM.date_to
			print(CUST.DATA.date_to)
		#}
		ENDIF
	#}
	ENDIF
	
	sv_h = mid$(BANCS.STDIN.BODDate,0,10)
	print(sv_h)
	
	sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
	BANCS.INPARAM.BINDVARS =  sv_h
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
	#{
		CUST.DATA.getboddate = BANCS.OUTPARAM.getboddate
		print(CUST.DATA.getboddate)
	#}
	ENDIF
	
	
	
	############################################
	# Fetching the value from table
	############################################
	
	sv_s = "Insert into   "
	sv_s = sv_s + " CUSTOM.PSPEMIAL_TABLE "
	sv_s = sv_s + " ( "
	sv_s = sv_s + " FORACID,"
	sv_s = sv_s + " DATE_FROM,"
	sv_s = sv_s + " DATE_TO, "
	sv_s = sv_s + " REQUEST_DATE, "
	sv_s = sv_s + " STATUS, "
	sv_s = sv_s + " BANK_ID "
	sv_s = sv_s + " ) "
	sv_s = sv_s + " VALUES "
	sv_s = sv_s + "	( "
	sv_s = sv_s + "	?SVAR, "
	sv_s = sv_s + " ?SVAR, "
	sv_s = sv_s + "	?SVAR, "
	sv_s = sv_s + "	?SVAR, "
	sv_s = sv_s + "	'N', "
	sv_s = sv_s + "	'54' "
	sv_s = sv_s + "	 )"
	BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + CUST.DATA.date_from + "|" +CUST.DATA.date_to  + "|" + CUST.DATA.getboddate
	PRINT(BANCS.INPARAM.BINDVARS)
	print(sv_s)
	sv_d = urhk_dbSqlWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		sv_d = urhk_dbSqlWithBind("COMMIT")
		sv_e=urhk_SetOrbOut("StattusCode|1")
		#}
	ELSE
		#{
		sv_d = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_d)
		CUST.DATA.errMsg="No Record"
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		
	#}
	ENDIF
	End:
		EXITSCRIPT
		TRACE OFF
END-->
