<--START
CHECKSUM="edebd97b2d677da8b43005112e1648a8cba2669857613f9ff9b11b4cec147708"
	TRACE ON
	#============================================================================
	# Create the necessary Repositories and Classes
	#============================================================================
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
		#}
	ELSE
		#{
		DELETEREP("CUST")
		CREATEREP("CUST")
	#}
	ENDIF
	
	
	IF (CLASSEXISTS("CUST", "HCASHX") == 0) THEN
	#{
		CREATECLASS("CUST", "HCASHX", 5)
		#}
	ELSE
		#{
		DELETECLASS("CUST", "HCASHX")
		CREATECLASS("CUST", "HCASHX", 5)
	#}
	ENDIF
	#===========================================================================
	#Initialising Variables
	#===========================================================================
	CUST.HCASHX.bankId = ""
	CUST.HCASHX.bankCode = ""
	CUST.HCASHX.branchCode = ""
	CUST.HCASHX.acctCrncy = ""
	CUST.HCASHX.cntrycode = ""
	CUST.HCASHX.currencyname = ""
	CUST.HCASHX.delflg = ""
	CUST.HCASHX.entityflg = ""
	
	
	#============================================================================
	#Fetching currency code from CNC table
	#============================================================================
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = "counts|"
	sv_c = sv_c + "SELECT COUNT(1)"
	sv_c = sv_c + " FROM CNC"
	sv_c = sv_c + " WHERE del_flg = 'N' AND entity_cre_flg = 'Y' "
	sv_c = sv_c + " AND  BANK_ID = ?SVAR ORDER BY CRNCY_CODE"
	
	
	print(sv_c)
	sv_r = urhk_dbSelectWithBind(sv_c)
	print(sv_r)
	
	print(BANCS.OUTPARAM.counts)
	IF (BANCS.OUTPARAM.counts == "0") THEN
	#{
		sv_u = urhk_SetOrbOut("Error|Y")
		#CUST.HCASHX.errMsg = urtn_getMsg("V201244")
		CUST.HCASHX.errMsg = "Error code is V201244"
		sv_z = "Error_9|ERROR^" + CUST.HCASHX.errMsg + " ^acctCrncy"
		sv_b = urhk_SetOrbOut(sv_z)
		GOTO LAST
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("recordCount|" + BANCS.OUTPARAM.counts)
		print(sv_u)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		#--------------------------------------------------------------------------
		# Create cursor and open it
		#--------------------------------------------------------------------------
		sv_s = "acctCrncy,cntrycode,currencyname,delflg,"
		sv_s = sv_s + " entityflg|"
		sv_s = sv_s + " SELECT crncy_code,"
		sv_s = sv_s + " cntry_code,"
		sv_s = sv_s + " crncy_name,"
		sv_s = sv_s + " del_flg,"
		sv_s = sv_s + " entity_cre_flg"
		sv_s = sv_s + " FROM CNC"
		sv_s = sv_s + " WHERE del_flg = 'N' AND entity_cre_flg = 'Y' "
		sv_s = sv_s + " AND  BANK_ID = ?SVAR ORDER BY CRNCY_CODE"
		#sv_r = urhk_dbSelectWithBind(sv_s)
		sv_r = urhk_dbCursorOpenWithBind(sv_s)
		print(sv_r)
		
		IF (sv_r != 0) THEN
		#{
			BANCS.OUTPUT.fatalErrorMsg = "Unable to open cursor. Contact system admin"
			BANCS.OUTPUT.fatalErrorFlg = "Y"
			GOTO Finish
		#}
		ENDIF
		
		CUST.HCASHX.cursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(CUST.HCASHX.cursorNumber)
		
		#--------------------------------------------------------------------------
		#Fetch data in a loop and assign it to output
		#--------------------------------------------------------------------------
		
		sv_r = urhk_dbCursorFetch(CUST.HCASHX.cursorNumber)
		sv_i =1
		WHILE(sv_r == 0)
		#{
			#----------------------------------------------------------------------
			# Save the data fetched in our repos variables
			# This is done as calls to urhk_SetOrbOut will clear the outparam
			# repository
			#----------------------------------------------------------------------
			
			IF(BANCS.OUTPARAM.acctCrncy == "") THEN
			#{
				CUST.HCASHX.acctCrncy = " "
				print(CUST.HCASHX.acctCrncy)
				#}
			ELSE
				#{
				CUST.HCASHX.acctCrncy = BANCS.OUTPARAM.acctCrncy
				print(CUST.HCASHX.acctCrncy)
			#}
			ENDIF
			
			IF(BANCS.OUTPARAM.cntrycode == "") THEN
			#{
				CUST.HCASHX.cntrycode = " "
				print(CUST.HCASHX.cntrycode)
				#}
			ELSE
				#{
				CUST.HCASHX.cntrycode = BANCS.OUTPARAM.cntrycode
				print(CUST.HCASHX.cntrycode)
			#}
			ENDIF
			
			IF(BANCS.OUTPARAM.currencyname == "") THEN
			#{
				CUST.HCASHX.currencyname = " "
				print(CUST.HCASHX.currencyname)
				#}
			ELSE
				#{
				CUST.HCASHX.currencyname = BANCS.OUTPARAM.currencyname
				print(CUST.HCASHX.currencyname)
			#}
			ENDIF
			
			IF(BANCS.OUTPARAM.delflg == "") THEN
			#{
				CUST.HCASHX.delflg = " "
				print(CUST.HCASHX.delflg)
				#}
			ELSE
				#{
				CUST.HCASHX.delflg = BANCS.OUTPARAM.delflg
				print(CUST.HCASHX.delflg)
			#}
			ENDIF
			
			IF(BANCS.OUTPARAM.entityflg == "") THEN
			#{
				CUST.HCASHX.entityflg = " "
				print(CUST.HCASHX.entityflg)
				#}
			ELSE
				#{
				CUST.HCASHX.entityflg = BANCS.OUTPARAM.entityflg
				print(CUST.HCASHX.entityflg)
			#}
			ENDIF
			
			
			#----------------------------------------------------------------------
			# Put record data into front end message fields
			#----------------------------------------------------------------------
			sv_y = format$(sv_i, "%d")
			print(sv_y)
			
			sv_s = "acctCrncy_" + sv_y + "|" + CUST.HCASHX.acctCrncy
			sv_r = urhk_SetOrbOut(sv_s)
			print(sv_r)
			
			sv_s = "cntrycode_" + sv_y + "|" + CUST.HCASHX.cntrycode
			sv_r = urhk_SetOrbOut(sv_s)
			print(sv_r)
			print(CUST.HCASHX.currencyname)
			sv_s = "currencyname_" + sv_y + "|" + CUST.HCASHX.currencyname
			sv_r = urhk_SetOrbOut(sv_s)
			print(sv_r)
			
			sv_s = "delflg_" + sv_y + "|" + CUST.HCASHX.delflg
			sv_r = urhk_SetOrbOut(sv_s)
			print(sv_r)
			
			sv_s = "entityflg_" + sv_y + "|" + CUST.HCASHX.entityflg
			sv_r = urhk_SetOrbOut(sv_s)
			print(sv_r)
			
			sv_i = sv_i + 1
			print(sv_i)
			
			#----------------------------------------------------------------------
			# Fetch next record
			#----------------------------------------------------------------------
			sv_r = urhk_dbCursorFetch(CUST.HCASHX.cursorNumber)
			print(sv_r)
		#}
		DO
		#--------------------------------------------------------------------------
		#Close the cursor
		#--------------------------------------------------------------------------
		sv_r = urhk_dbCursorClose(CUST.HCASHX.cursorNumber)
		GOTO LAST
		
		Finish:
			IF (TRIM(CUST.HCASHX.scrMsgs) != "") THEN
			#{
				CUST.HCASHX.successOrFailure = "F"
				GOTO LAST
			#}
			ENDIF
		#}
		ENDIF
		
	LAST:
		
		
		#============================================================================
		# delete the created Repositories and Classes
		#============================================================================
		IF (REPEXISTS("CUST") == 1) THEN
		#{
			DELETEREP("CUST")
		#}
		ENDIF
		
		IF (CLASSEXISTS("CUST", "HCASHX") == 1) THEN
		#{
			DELETECLASS("CUST", "HCASHX")
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
		
END-->
