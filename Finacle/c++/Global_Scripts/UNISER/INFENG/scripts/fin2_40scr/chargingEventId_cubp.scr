		MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.CUBPCHRG.Charge)
		MTT.PartTranDetails.Amount = -CDOUBLE(CUST.CUBPCHRG.Charge)
		PRINT(MTT.PartTranDetails.RefAmount)
		PRINT(MTT.PartTranDetails.Amount)
		#MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.CUBPCHRG.Charge)
		#MTT.PartTranDetails.Amount = -CDOUBLE(CUST.CUBPCHRG.Charge)
		MTT.PartTranDetails.Account = CUST.CUBPCHRG.ph1
		MTT.PartTranDetails.RefCurrency = CUST.CUBPCHRG.refCrncy
		MTT.PartTranDetails.TranCurrency = CUST.CUBPCHRG.refCrncy
		
		MTT.PartTranDetails.RateCode = CUST.CUBPCHRG.rateCode
		PRINT(MTT.PartTranDetails.RateCode)
		MTT.PartTranDetails.Rate = CUST.CUBPCHRG.chRate
		#	MTT.PartTranDetails.Rate	= "0"
		
		MTT.PartTranDetails.CarveAmtFlg = "Y"
