	sv_u = urhk_setOrbOut("Message|" + CUST.CUBPCHRG.SuccessOrFailure)
	PRINT(sv_u)
	sv_u = urhk_setOrbOut("Details|" + CUST.CUBPCHRG.Details)
	PRINT(sv_u)
	
	#------------------------------------------------------------------------------------------------------
	# Denom ADD
	#------------------------------------------------------------------------------------------------------
	
	IF (CUST.CUBPCHRG.tranId== "") THEN
	#{
		PRINT("Charge collection failed")
		CUST.CUBPCHRG.errorFlg = "Y"
		CUST.UBP.errorFlg = "Y"
		CUST.UBP.errorMsg = "Charge collection failed"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS=CUST.CUBPCHRG.crncyCode+"|"+CUST.CUBPCHRG.teller_id+"|"+CUST.CUBPCHRG.sol_id+"|"+ CUST.CUBPCHRG.bank_id
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_l = "cnt|SELECT COUNT(*) "
	sv_l = sv_l + "FROM CUSTOM.c_denm "
	sv_l = sv_l + "WHERE del_flg = 'N' "
	sv_l = sv_l + "AND crncy_code = ?SVAR "
	sv_l = sv_l + "AND teller_id = ?SVAR "
	sv_l = sv_l + "AND SOL_ID = ?SVAR "
	sv_l = sv_l + "AND denom_ind = 'N' "
	sv_l = sv_l + "AND bank_id = ?SVAR "
	PRINT(sv_l)
	
	sv_x = urhk_DBSelectWithBind(sv_l)
	PRINT(sv_x)
	CUST.CUBPCHRG.cnt = BANCS.OUTPARAM.cnt
	PRINT(CUST.CUBPCHRG.cnt )
	BANCS.INPARAM.BINDVARS= CUST.CUBPCHRG.crncyCode +"|"+ CUST.CUBPCHRG.bank_id
	PRINT(BANCS.INPARAM.BINDVARS)
	IF(CINT(CUST.CUBPCHRG.cnt) == 0) THEN
	#{
		sv_v = "INSERT INTO CUSTOM.c_denm "
		sv_v = sv_v + "(sol_id,crncy_code,denom_ind,denom_value,"
		sv_v = sv_v + "denom_count,teller_id,rcre_user_id,rcre_time,"
		sv_v = sv_v + "lchg_user_id,lchg_time,del_flg,bank_id) "
