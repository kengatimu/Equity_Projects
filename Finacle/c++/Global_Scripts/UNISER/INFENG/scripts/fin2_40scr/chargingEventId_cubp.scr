	IF ((CUST.CUBPCHRG.ChrgEvntId != "") AND (CDOUBLE(CUST.CUBPCHRG.chrgAmount) != "0.0")) THEN
	#{
		PRINT(CUST.CUBPCHRG.chrgAmount)
		
		MTT.ChargeDetails.EventType = "GCHRG"
