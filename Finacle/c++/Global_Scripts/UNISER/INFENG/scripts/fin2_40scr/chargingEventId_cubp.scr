			PRINT(MTT.Error.Description)
			CUST.CUBPCHRG.MTTErrMsg = MTT.Error.Description
			#}
		ELSE
			#{
			CUST.CUBPCHRG.MTTErrMsg = "Could not create end definition"
			MTT.Error.Description = CUST.CUBPCHRG.MTTErrMsg
		#}
		ENDIF
		sv_r = urhk_MTTS_ReportErrorCondition("")
		PRINT(sv_r)
		#CUST.CUBPCHRG.MTTErrMsg = MTT.Error.Description
		CUST.CUBPCHRG.SuccessOrFailure = "Failure"
		CUST.CUBPCHRG.Details = "Transaction generation failed"
		CUST.CUBPCHRG.tranId = ""
		#}
	ELSE
		#{
		PRINT(MTT.XCPN.NumExceptions)
		CUST.CUBPCHRG.NumExceptions = MTT.XCPN.NumExceptions
		IF (CUST.CUBPCHRG.NumExceptions == "0") THEN
		#{
			sv_b = urhk_MTTS_HandleExceptions("ENTRY")
			#CUST.CUBPCHRG.EVENT = "DX"
			#}
		ELSE
			#{
			sv_b = urhk_MTTS_HandleExceptions("ENTRY")
			#CUST.CUBPCHRG.EVENT = "DX"
			
		#}
		ENDIF
	#}
	ENDIF
	sv_r = urhk_B2k_PrintRepos("MTT")
	PRINT(sv_r)
	
	
	sv_u = urhk_MTTS_Close("")
	PRINT(sv_u)
	#sv_b = urhk_MTTS_HandleExceptions("POST")
	###print(sv_b)
	
	sv_r = urhk_B2k_PrintRepos("MTT")
	PRINT(sv_r)
	
	IF (BANCS.OUTPARAM.MTTPostingStatus == "S") THEN
	#{
		PRINT(BANCS.OUTPARAM.MTTTranId)
		CUST.CUBPCHRG.tranId = BANCS.OUTPARAM.MTTTranId
		IF (CUST.CUBPCHRG.NumExceptions == "0") THEN
		#{
			CUST.CUBPCHRG.SuccessOrFailure = "Success"
			CUST.CUBPCHRG.Details = "&nbsp;<B><font color=red>Transaction Posted:" + BANCS.OUTPARAM.MTTTranId + "<BR>&nbsp;" + BANCS.OUTPARAM.MTTPostingError + "</font></B><BR>"
			#}
		ELSE
			#{
			CUST.CUBPCHRG.SuccessOrFailure = "Failure"
			CUST.CUBPCHRG.Details = "&nbsp;<B><font color=red>Exceptions encountered.<BR>&nbsp;Transaction in entered status:" + BANCS.OUTPARAM.MTTTranId + "<BR>&nbsp;" + BANCS.OUTPARAM.MTTPostingError + "</font></B><BR>"
		#}
		ENDIF
		PRINT(CUST.CUBPCHRG.Details)
		#}
	ELSE
