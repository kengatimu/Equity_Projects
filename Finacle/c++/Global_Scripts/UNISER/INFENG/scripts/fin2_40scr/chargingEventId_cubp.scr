	#########################################################
	#Converting the reference amount to Home currency code
	#########################################################
	BANCS.INPARAM.InputAmount = CUST.UBP.chgAmt
	BANCS.INPARAM.FromCurrency = CUST.UBP.ChargepayRefCrncy
