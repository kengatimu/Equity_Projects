	sv_u = urhk_MTTS_Initialize("")
	PRINT(sv_u)
	
	CUST.CUBPCHRG.value_date = LEFT$(BANCS.STDIN.BODDate, 10)
	
	
	
	#-----------PRINT OUT THE VALUES OBTAINED FROM FRONT END : END ---------------------
	
	#----------------------------------------------------------------------------------------
	#	MTT Main Tran Details - TRANSFER C-CR TYPE
	#	ACCOUNT PLACEHOLDER 1 CR , ACCOUNT PLACEHOLDER 2 DR
	#----------------------------------------------------------------------------------------
	
	#MTT.TranDetails.TranDateDiff = "0"
	#MTT.TranDetails.IgnoreExcp = "I"
	#MTT.TranDetails.Consolidate = "N"
	#MTT.TranDetails.ReversalFlag = "N"
	#MTT.TranDetails.PostTranFlg = "X"
	#MTT.TranDetails.Remarks = "CURRENCY EXCHANGE"
