	#MTT.TranDetails.ErrorCheckForLuw = "N"
	#MTT.TranDetails.CommitFlag = "Y"
	
	#MTT.TranDetails.IgnoreExcp="Y"
	#MTT.TranDetails.Consolidate = "Y"
