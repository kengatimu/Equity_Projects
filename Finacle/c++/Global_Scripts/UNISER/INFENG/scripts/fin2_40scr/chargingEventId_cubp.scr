		sv_v = "INSERT INTO CUSTOM.c_denm_dr "
		sv_v = sv_v + "(sol_id,crncy_code,denom_ind,denom_value,"
		sv_v = sv_v + "denom_count,teller_id,rcre_user_id,rcre_time,"
		sv_v = sv_v + "lchg_user_id,lchg_time,del_flg,bank_id) "
		sv_v = sv_v + "SELECT '" + BANCS.STDIN.mySolId + "',crncy_code,denom_ind,denom_value,"
		sv_v = sv_v + "0,'" + CUST.CUBPCHRG.teller_id + "',rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,bank_id "
		sv_v = sv_v + "FROM c_mdnm "
		sv_v = sv_v + "WHERE crncy_code = ?SVAR "
		sv_v = sv_v + "AND bank_id = ?SVAR"
		PRINT(sv_v)
		sv_x = urhk_DBSqlWithBind(sv_v)
		PRINT(sv_x)
		#---------------------------INserting values into C_DENM_CR---
		BANCS.INPARAM.BINDVARS= CUST.CUBPCHRG.crncyCode +"|"+ CUST.CUBPCHRG.bank_id
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_v = "INSERT INTO CUSTOM.c_denm_cr "
		sv_v = sv_v + "(sol_id,crncy_code,denom_ind,denom_value,"
		sv_v = sv_v + "denom_count,teller_id,rcre_user_id,rcre_time,"
		sv_v = sv_v + "lchg_user_id,lchg_time,del_flg,bank_id) "
		sv_v = sv_v +  "SELECT '" + BANCS.STDIN.mySolId + "',crncy_code,denom_ind,denom_value,"
		sv_v = sv_v + "0,'"+CUST.CUBPCHRG.teller_id+"',rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,bank_id "
		sv_v = sv_v + "FROM c_mdnm "
		sv_v = sv_v + "	WHERE crncy_code= ?SVAR "
		sv_v = sv_v + " AND bank_id = ?SVAR "
		PRINT(sv_v)
		sv_x = urhk_DBSqlWithBind(sv_v)
		PRINT(sv_x)
	#}
	ENDIF
	
	
	BANCS.INPARAM.BINDVARS=  CUST.CUBPCHRG.teller_id + "|" + CUST.CUBPCHRG.bank_id+"|"+CUST.CUBPCHRG.crncyCode+"|"+CUST.CUBPCHRG.sol_id
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_v = " DenomInd,DenomValue,DenomCount|"
	sv_v = sv_v + " SELECT DENOM_IND,DENOM_VALUE,0 "
	sv_v = sv_v + " FROM  CUSTOM.C_DENM  A "
	sv_v = sv_v + " WHERE TELLER_ID = ?SVAR"
	sv_v = sv_v + " AND A.DEL_FLG = 'N'  "
	sv_v = sv_v + " AND A.BANK_ID = ?SVAR"
	sv_v = sv_v + " AND A.CRNCY_CODE =?SVAR "
	sv_v = sv_v + " AND A.SOL_ID =?SVAR order by DENOM_VALUE desc  "
	
	sv_c = urhk_DBCursorOpenWithBind(sv_v)
	IF(sv_c != 0) THEN
	#{
		PRINT("Charge collection failed")
		CUST.CUBPCHRG.errorFlg = "Y"
		CUST.UBP.errorFlg = "Y"
		CUST.UBP.errorMsg = "Charge collection failed"
		GOTO FINISH
	#}
	ENDIF
	IF(sv_c == 0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_m)
		sv_c = urhk_DBCursorFetch(sv_m)
		CUST.CUBPCHRG.NoteDenomVal = ""
		CUST.CUBPCHRG.CoinDenomVal = ""
		CUST.CUBPCHRG.NoteDenomCnt = ""
		CUST.CUBPCHRG.CoinDenomCnt = ""
		WHILE(sv_c == 0)
		#{
			IF (BANCS.OUTPARAM.DenomInd == "N") THEN
			#{
				
				
				IF (CUST.CUBPCHRG.NoteDenomCnt!="") THEN
				#{
					CUST.CUBPCHRG.NoteDenomCnt = CUST.CUBPCHRG.NoteDenomCnt + "-" + BANCS.OUTPARAM.DenomCount
					CUST.CUBPCHRG.NoteDenomVal = CUST.CUBPCHRG.NoteDenomVal + "-" + BANCS.OUTPARAM.DenomValue
					#}
				ELSE
					#{
					CUST.CUBPCHRG.NoteDenomCnt =  BANCS.OUTPARAM.DenomCount
					CUST.CUBPCHRG.NoteDenomVal =   BANCS.OUTPARAM.DenomValue
				#}
				ENDIF
				PRINT(CUST.CUBPCHRG.NoteDenomVal)
				PRINT(CUST.CUBPCHRG.NoteDenomCnt)
				
				#}
			ELSE
				#{
				
				IF (CUST.CUBPCHRG.CoinDenomCnt!="") THEN
				#{
					CUST.CUBPCHRG.CoinDenomVal  = CUST.CUBPCHRG.CoinDenomVal + "-" + BANCS.OUTPARAM.DenomValue
					CUST.CUBPCHRG.CoinDenomCnt  = CUST.CUBPCHRG.CoinDenomCnt + "-" + BANCS.OUTPARAM.DenomCount
					#}
				ELSE
					#{
					CUST.CUBPCHRG.CoinDenomVal  = BANCS.OUTPARAM.DenomValue
					CUST.CUBPCHRG.CoinDenomCnt  =  BANCS.OUTPARAM.DenomCount
				#}
				ENDIF
				PRINT(CUST.CUBPCHRG.CoinDenomVal)
				PRINT(CUST.CUBPCHRG.CoinDenomCnt)
			#}
			ENDIF
			sv_c = urhk_DBCursorFetch(sv_m)
		#}
		DO
		sv_c = urhk_DBCursorClose(sv_m)
		IF(sv_c!=0)THEN
		#{
			PRINT("Charge collection failed")
			CUST.CUBPCHRG.errorFlg = "Y"
			CUST.UBP.errorFlg = "Y"
			CUST.UBP.errorMsg = "Charge collection failed"
			GOTO FINISH
		#}
		ENDIF
		
		IF(CUST.CUBPCHRG.CoinDenomVal =="")THEN
		#{
			CUST.CUBPCHRG.CoinDenomVal = "0"
		#}
		ENDIF
		
		IF(CUST.CUBPCHRG.CoinDenomCnt =="")THEN
		#{
			CUST.CUBPCHRG.CoinDenomCnt = "0"
		#}
		ENDIF
		
		IF(CUST.CUBPCHRG.NoteDenomVal =="")THEN
		#{
			CUST.CUBPCHRG.NoteDenomVal = "0"
		#}
		ENDIF
		
		IF(CUST.CUBPCHRG.NoteDenomCnt =="")THEN
		#{
			CUST.CUBPCHRG.NoteDenomCnt = "0"
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	#------------------------------------------------------------------------------------------------------------------------------------------------------------------
	# Insert into C_DETD
	#------------------------------------------------------------------------------------------------------------------------------------------------------------------
	CUST.CUBPCHRG.dxfer_flg = "E"
	CUST.CUBPCHRG.denom_ind = "N"
	CUST.CUBPCHRG.ptran_type = "C"
	CUST.CUBPCHRG.part_tran_srl_num = "1"
	
	sv_m = "INSERT INTO CUSTOM.c_detd (sol_id,dxfer_id,dxfer_flg,ptran_type,crncy_code,denom_ind,denom_value,"
	sv_m = sv_m + "denom_count,teller_id,tran_date,"
	sv_m = sv_m + "value_date,"
	sv_m = sv_m + "part_tran_srl_num,rcre_user_id,rcre_time,"
	sv_m = sv_m + "lchg_user_id,lchg_time,bank_id)"
	sv_m = sv_m + " VALUES (?SVAR,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_m = sv_m + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "sysdate,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "sysdate,"
	sv_m = sv_m + "?SVAR )"
	
	CUST.CUBPCHRG.bindvarsM  =  CUST.CUBPCHRG.sol_id +"|"+CUST.CUBPCHRG.tranId+"|" +CUST.CUBPCHRG.dxfer_flg + "|"  +  CUST.CUBPCHRG.ptran_type +  "|" + CUST.CUBPCHRG.crncyCode +"|" +CUST.CUBPCHRG.denom_ind +"|"+ CUST.CUBPCHRG.NoteDenomVal
	CUST.CUBPCHRG.bindvarsM  = CUST.CUBPCHRG.bindvarsM + "|" +CUST.CUBPCHRG.NoteDenomCnt + "|" +CUST.CUBPCHRG.teller_id +"|"+ CUST.CUBPCHRG.tranDate+"|"+ CUST.CUBPCHRG.tranDate
	CUST.CUBPCHRG.bindvarsM  = CUST.CUBPCHRG.bindvarsM  + "|" +CUST.CUBPCHRG.part_tran_srl_num+ "|"+BANCS.STDIN.userId+ "|"+BANCS.STDIN.userId+ "|" + BANCS.STDIN.contextBankId
	
	BANCS.INPARAM.BINDVARS = CUST.CUBPCHRG.bindvarsM
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_q = sv_m
	PRINT(sv_q)
	sv_v = urhk_dbsqlWithBind(sv_q)
	PRINT(sv_v)
	IF (sv_v != 0)THEN
	#{
		PRINT("Charge collection failed")
		CUST.CUBPCHRG.errorFlg = "Y"
		CUST.UBP.errorFlg = "Y"
		CUST.UBP.errorMsg = "Charge collection failed"
		GOTO FINISH
	#}
	ENDIF
	
	CUST.CUBPCHRG.dxfer_flg = "E"
	CUST.CUBPCHRG.denom_ind = "C"
	CUST.CUBPCHRG.ptran_type = "C"
	CUST.CUBPCHRG.part_tran_srl_num = "1"
	
	sv_m = "INSERT INTO CUSTOM.c_detd (sol_id,dxfer_id,dxfer_flg,ptran_type,crncy_code,denom_ind,denom_value,"
	sv_m = sv_m + "denom_count,teller_id,tran_date,"
	sv_m = sv_m + "value_date,"
	sv_m = sv_m + "part_tran_srl_num,rcre_user_id,rcre_time,"
	sv_m = sv_m + "lchg_user_id,lchg_time,bank_id)"
	sv_m = sv_m + " VALUES (?SVAR,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_m = sv_m + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "sysdate,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "sysdate,"
	sv_m = sv_m + "?SVAR )"
	
	CUST.CUBPCHRG.bindvarsM  =  CUST.CUBPCHRG.sol_id +"|"+CUST.CUBPCHRG.tranId+"|" +CUST.CUBPCHRG.dxfer_flg + "|"  +  CUST.CUBPCHRG.ptran_type +  "|" + CUST.CUBPCHRG.crncyCode +"|" +CUST.CUBPCHRG.denom_ind +"|"+ CUST.CUBPCHRG.CoinDenomVal
	CUST.CUBPCHRG.bindvarsM  = CUST.CUBPCHRG.bindvarsM + "|" +CUST.CUBPCHRG.CoinDenomCnt + "|" +CUST.CUBPCHRG.teller_id +"|"+ CUST.CUBPCHRG.tranDate+"|"+ CUST.CUBPCHRG.tranDate
	CUST.CUBPCHRG.bindvarsM  = CUST.CUBPCHRG.bindvarsM  + "|" +CUST.CUBPCHRG.part_tran_srl_num+ "|"+BANCS.STDIN.userId+ "|"+BANCS.STDIN.userId+ "|" + BANCS.STDIN.contextBankId
	
	BANCS.INPARAM.BINDVARS = CUST.CUBPCHRG.bindvarsM
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_q = sv_m
	PRINT(sv_q)
	sv_v = urhk_dbsqlWithBind(sv_q)
	PRINT(sv_v)
	IF (sv_v != 0)THEN
	#{
		PRINT("Charge collection failed")
		CUST.CUBPCHRG.errorFlg = "Y"
		CUST.UBP.errorFlg = "Y"
		CUST.UBP.errorMsg = "Charge collection failed"
		GOTO FINISH
	#}
	ENDIF
