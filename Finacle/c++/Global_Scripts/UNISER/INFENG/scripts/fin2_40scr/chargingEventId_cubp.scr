		CUST.CUBPCHRG.teller_id = BANCS.OUTPARAM.teller_id
		PRINT(CUST.CUBPCHRG.ph1)
		
	#}
	ENDIF
	
	
	
	
	#-----------------------------------------------------------------------------------
	# DEFINE TRANSACTION
	#-----------------------------------------------------------------------------------
	
	MTT.TranDetails.TranDate = "0"
	MTT.TranDetails.TranType = "C"
	MTT.TranDetails.TranSubType = "CR"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Remarks = "CURRENCY EXCHANGE"
	MTT.TranDetails.PostFlag = "X"
	MTT.TranDetails.CommitFlag = "N"
	MTT.TranDetails.Consolidate = "Y"
	
	BANCS.INPARAM.PostTranFlg = "X"
	BANCS.INPARAM.CommitFlg = "N"
