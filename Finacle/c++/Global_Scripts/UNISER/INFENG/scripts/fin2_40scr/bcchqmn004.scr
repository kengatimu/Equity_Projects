#---------------------------------------------------------------------------------    
#	Name			: bcchqmn004.scr
#	Description		: It validates all the inputs for cheque book maintenance menu
#	Date			: 16-03-2013
#	Author			: GOKULKRISHNA
#	Input			: NA
#	Output			: NA
#	Called Script	:
#	Calling Scrip	: NA
#	Menu Option		: CCHQI
#	Srl. No			Date			Author			Description.
#	-------			---------		-------			---------------
#	1.0				16-03-2013		GOKULKRISHNA			Original Version
#       1.1				09-05-2013		Gokulkrishna			Added function Code Validation
#----------------------------------------------------------------------------------

<--START
CHECKSUM="f841551b7cb27de5a864bbb6701b6a43d6d2c28c82e19fd4feec0a5e332322ad"
	TRACE ON
	#---------------------------------------------------------------------------------
	# CREATING NEW REPOSITORY AND CLASS
	#---------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
	#{
		CREATECLASS("CUST", "CHQB", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.requestId)
	PRINT(BANCS.INPUT.acctNo)
	PRINT(BANCS.INPUT.noOfChqs)
	PRINT(BANCS.INPUT.startChqNo)
	PRINT(BANCS.INPUT.endChqNo)
	PRINT(BANCS.INPUT.reqStat)
	
	#---------------------------------------------------------------------------------
	# check if account no filed is blank.
	#---------------------------------------------------------------------------------
	CUST.CHQB.function 	= BANCS.INPUT.funcCode
	#CUST.CHQB.requestId     = BANCS.INPUT.requestId
	#CUST.CHQB.acctNum   = BANCS.INPUT.acctNo
	#CUST.CHQB.noOfChq   = BANCS.INPUT.noOfChqs
	#CUST.CHQB.chqStartSrlNum = BANCS.INPUT.startChqNo
	#CUST.CHQB.chqEndSrlNum = BANCS.INPUT.endChqNo
	#CUST.CHQB.reqStatus = BANCS.INPUT.reqStat
	
	#CUST.CHQB.request_id = ""
	#CUST.CHQB.acctNum = ""
	#CUST.CHQB.noOfChq = ""
	#CUST.CHQB.account_no1 = ""
	#CUST.CHQB.no_of_chkbooks = ""
	#CUST.CHQB.chqStartSrlNum = ""
	#CUST.CHQB.chqEndSrlNum = ""
	#CUST.CHQB.reqStatus = ""
	CUST.CHQB.succsflg = "Y"
	
	IF(BANCS.INPUT.funcCode == "A") THEN
	#{
		
		CUST.CHQB.account_no1 =	BANCS.INPUT.acctNo
		PRINT(CUST.CHQB.account_no1)
		
		CUST.CHQB.no_of_chkbooks =	TRIM(BANCS.INPUT.noOfChqs)
		PRINT(CUST.CHQB.no_of_chkbooks)
		CUST.CHQB.chqStartSrlNum = BANCS.INPUT.startChqNo
		PRINT(CUST.CHQB.chqStartSrlNum)
		CUST.CHQB.chqEndSrlNum = BANCS.INPUT.endChqNo
		PRINT(CUST.CHQB.chqEndSrlNum)
		
		call("bcchqdp001.scr")
		IF (CUST.CHQB.succsflg == "N") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------------------------------------------------
		# Sub string the date value to get the date without the time stamp.
		#----------------------------------------------------------------------------------
		sv_s = "LastSrlNo|SELECT NVL(MAX(BEGIN_CHQ_NUM+(NUM_OF_CHB*100)),1) FROM CUSTOM.C_BCHQ WHERE "
		sv_s = sv_s + "FORACID = ?SVAR "
		sv_s = sv_s + "AND REQ_STATUS != 'D' "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		
		sv_s = sv_s + " AND branch_code =?SVAR "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.acctNo + "|" + BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.mySolId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		
		IF (sv_u != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.start_srl_no = BANCS.OUTPARAM.LastSrlNo
			PRINT(CUST.CHQB.start_srl_no)
		#}
		ENDIF
		sv_c = MID$(BANCS.STDIN.BODDate,0,10)
		sv_c = "to_date('" + sv_c + "','dd-mm-yyyy')"
		sv_d = BANCS.STDIN.sysDate
		sv_d = "to_date('" + sv_d + "','dd-mm-yyyy hh24:mi:ss')"
		#----------------------------------------------------------------------------------
		# Select the next value for the Req Id from the sequence generated by ChqBookReq_Seq
		#----------------------------------------------------------------------------------
		
		sv_s = "requestid|SELECT CUSTOM.BChqReq_Seq_" + BANCS.STDIN.contextBankId  + ".nextval FROM DUAL"
		sv_u = urhk_dbSelectWithBind(sv_s)
		IF (sv_u!= 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "requestId"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			#sv_f = BANCS.OUTPARAM.requestid
			CUST.CHQB.RequestId = BANCS.OUTPARAM.requestid
			#----------------------------------------------------------------------------------
			#Insert Values from acceptance form in the C_BCHQ table with request status as 'A'
			#----------------------------------------------------------------------------------
			sv_s = "INSERT INTO CUSTOM.C_BCHQ( REQ_ID,FORACID,BRANCH_CODE,BEGIN_CHQ_NUM ,NUM_OF_CHB ,REQ_STATUS,REQ_DATE ,DOWNLOAD_ID ,DOWNLOAD_DATE ,AUTH_USER_ID,AUTH_TIME ,RCRE_USER_ID ,RCRE_TIME,DEL_FLG ,BANK_ID) "
			sv_s = sv_s + "VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,'E',"
			sv_s = sv_s +  sv_c  + " ,'','','','',?SVAR," + sv_d + ",'N',?SVAR)"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CHQB.RequestId + "|" +BANCS.INPUT.acctNo + "|" + BANCS.STDIN.mySolId + "|" + CUST.CHQB.start_srl_no + "|" + CUST.CHQB.no_of_chkbooks + "|"+ BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbsqlWithBind(sv_s)
			PRINT(sv_u)
			IF( sv_u == 0) THEN
			#{
				sv_u= urhk_dbsqlWithBind("COMMIT")
				PRINT(sv_u)
				IF (sv_u != 0 ) THEN
				#{
					sv_e = "A Database error has occured. Please contact your DBA."
					sv_m = "funcCode"
					sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					
					sv_s = "RESULT_MSG|Request Recorded Successfully . Request Id is" + " " + CUST.CHQB.RequestId
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
					sv_z = urhk_SetOrbOut(sv_s)
					PRINT(sv_z)
				#}
				ENDIF
				
				
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------------
	# For Delete operation.
	#---------------------------------------------------------------------------------
	IF(BANCS.INPUT.funcCode == "D") THEN
	#{
		
		CUST.CHQB.account_no = BANCS.INPUT.acctNo
		PRINT(CUST.CHQB.account_no)
		CUST.CHQB.request_id = BANCS.INPUT.requestId
		PRINT(CUST.CHQB.request_id)
		
		call("bcchqdp001.scr")
		IF (CUST.CHQB.succsflg == "N") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------------------------------------------------
		# Retrieve details corresponding to the given request id.
		#----------------------------------------------------------------------------------
		sv_s = "ChequeBooks,ReqStatus,foracid,begin_num|SELECT num_of_chb,"
		sv_s = sv_s + " req_status,foracid,begin_chq_num FROM CUSTOM.C_BCHQ WHERE "
		sv_s = sv_s + " req_id = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND branch_code =?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.requestId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
		sv_u = urhk_dbSelectWithBind(sv_s)
		
		IF (sv_u != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA"
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CHQB.no_of_chkbooks = BANCS.OUTPARAM.ChequeBooks
		CUST.CHQB.Request_status = BANCS.OUTPARAM.ReqStatus
		CUST.CHQB.fldAcctNo = BANCS.OUTPARAM.foracid
		CUST.CHQB.fldChqStNo = BANCS.OUTPARAM.begin_num
		IF (TRIM(CUST.CHQB.fldChqStNo) != "") THEN
		#{
			CUST.CHQB.fldChqEndNo = (cint(BANCS.OUTPARAM.begin_num) + (cint(BANCS.OUTPARAM.ChequeBooks)* 100) ) -1
		#}
		ENDIF
		#----------------------------------------------------------------------------------
		# Update the C_BCHQ table with the request status as "D" (deleted )
		#----------------------------------------------------------------------------------
		IF(CUST.CHQB.Request_status == "E") THEN
		#{
			sv_d = "to_date('" + BANCS.STDIN.sysDate + "','dd-mm-yyyy hh24:mi:ss')"
			sv_s = "UPDATE CUSTOM.C_BCHQ SET  DEL_FLG = 'Y' "
			sv_s = sv_s + " ,AUTH_USER_ID = ?SVAR "
			sv_s = sv_s + " ,AUTH_TIME =  " + sv_d + ",req_status = 'D'"
			sv_s = sv_s + " WHERE req_id = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND branch_code =?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + BANCS.INPUT.requestId + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.mySolId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbsqlWithBind(sv_s)
			IF (sv_u != 0 ) THEN
			#{
				sv_e = "A Database error has occured. Please contact your DBA."
				sv_m = "funcCode"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_s = "commit"
				sv_u = urhk_dbsqlWithBind(sv_s)
				IF (sv_u != 0 ) THEN
				#{
					sv_e = "A Database error has occured. Please contact your DBA."
					sv_m = "funcCode"
					sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			#----------------------------------------------------------------------------------
			# Confirmation message on sucessful logical deletion.
			#----------------------------------------------------------------------------------
			sv_e = "RESULT_MSG|Request has been deleted"
			PRINT(sv_e)
			sv_u = urhk_SetOrbOut(sv_e)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			PRINT(sv_u)
			GOTO ENDOFSCRIPT
			
			#}
		ELSE
			#{
			sv_e = "Request has been authorized/Deleted so can not be deleted"
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	#----------------------------------------------------------------------------------
	# Entered Option is 'V' i.e Authorizing a request that has been lodged
	#----------------------------------------------------------------------------------
	IF(BANCS.INPUT.funcCode== "V") THEN
	#{
		
		CUST.CHQB.account_no = BANCS.INPUT.acctNo
		PRINT(CUST.CHQB.account_no)
		CUST.CHQB.request_id = BANCS.INPUT.requestId
		PRINT(CUST.CHQB.request_id)
		
		call("bcchqdp001.scr")
		
		IF (CUST.CHQB.succsflg == "N") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_s = "ChequeBooks,ReqStatus,foracid,begin_num,rcreid|SELECT num_of_chb,"
		sv_s = sv_s + " req_status,foracid,begin_chq_num,rcre_user_id FROM CUSTOM.C_BCHQ WHERE "
		sv_s = sv_s + " req_id = ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND branch_code =?SVAR "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.requestId + "|" + BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.mySolId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CHQB.no_of_chkbooks = BANCS.OUTPARAM.ChequeBooks
		CUST.CHQB.Request_status = BANCS.OUTPARAM.ReqStatus
		CUST.CHQB.rcreid = trim(BANCS.OUTPARAM.rcreid)
		CUST.CHQB.fldNoChBk = BANCS.OUTPARAM.ChequeBooks
		CUST.CHQB.fldAcctNo = BANCS.OUTPARAM.foracid
		CUST.CHQB.fldReqStatus = BANCS.OUTPARAM.ReqStatus
		CUST.CHQB.fldChqStNo = BANCS.OUTPARAM.begin_num
		IF(trim(CUST.CHQB.fldChqStNo) != "") THEN
		#{
			CUST.CHQB.fldChqEndNo = cint(BANCS.OUTPARAM.begin_num) + (  cint(BANCS.OUTPARAM.ChequeBooks)* 100) - 1
			PRINT(CUST.CHQB.fldChqEndNo)
		#}
		ENDIF
		#----------------------------------------------------------------------------------
		#  Check IF the authorizers work class is the same or greater than or equal to the customers class.
		#----------------------------------------------------------------------------------
		sv_s = "rcreclass|SELECT USER_WORK_CLASS FROM TBAADM.UPR WHERE user_id = ?SVAR "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CHQB.rcreid
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d != 0) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.CHQB.rcreclass = BANCS.OUTPARAM.rcreclass
		PRINT(CUST.CHQB.rcreclass)
		
		sv_s = "authclass|SELECT USER_WORK_CLASS FROM TBAADM.UPR WHERE user_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		IF (sv_u != 0) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CHQB.authclass = BANCS.OUTPARAM.authclass
		PRINT(CUST.CHQB.authclass)
		IF(CINT(CUST.CHQB.authclass) >= CINT(CUST.CHQB.rcreclass)) THEN
		#{
			IF((CUST.CHQB.Request_status == "E")) THEN
			#{
				#----------------------------------------------------------------------------------
				# Check for the user cannot authorize his own account
				#----------------------------------------------------------------------------------
				IF (TRIM(BANCS.STDIN.userId) == TRIM(CUST.CHQB.rcreid)) THEN
				#{
					sv_e = "Cannot authorize your own request."
					sv_m = "funcCode"
					sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					#----------------------------------------------------------------------------------
					# Update the request status value to "A" in C_BCHQ table to mark it as authorized.
					#----------------------------------------------------------------------------------
					sv_d = "to_date('" + BANCS.STDIN.sysDate + "','dd-mm-yyyy hh24:mi:ss')"
					sv_s = "UPDATE CUSTOM.C_BCHQ SET req_status = 'A',AUTH_USER_ID = ?SVAR,AUTH_TIME =  " + sv_d + " WHERE req_id = ?SVAR AND bank_id = ?SVAR"
					sv_s = sv_s + " AND branch_code =?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + BANCS.INPUT.requestId + "|" + BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.mySolId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbsqlWithBind(sv_s)
					PRINT(sv_u)
					IF (sv_u != 0) THEN
					#{
						sv_e = "A Database error has occured. Please contact your DBA."
						sv_m = "funcCode"
						sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						sv_s = "commit"
						sv_s = urhk_dbsqlWithBind(sv_s)
						sv_e = "RESULT_MSG|Request has been authorized"
						PRINT(sv_e)
						sv_u = urhk_SetOrbOut(sv_e)
						PRINT(sv_u)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
						PRINT(sv_u)
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_e = "Request has already been authorized/Deleted"
				sv_m = "funcCode"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_e = "Authorizer work class should be greater than OR equal to record created user work class"
			sv_m = "funcCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	ENDOFSCRIPT:
		
		#TRACE OFF
		EXITSCRIPT
END-->
