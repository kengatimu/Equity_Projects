#-------------------------------------------------------------------------------------    
#	Name			: s_ast0057mn005.scr
#	Description		: This script is used for Reversal cannot be done for the Loan a/c,
#				: as the Disbursed amount has been used to pay off the linked loan a/cs.
#	Date			: 26-06-2013
#	Author			: Prashanth
#	Input			: NA
#	Output			: NA
#	Called Script		: SRV_FetchLADisbDataForRvsl_pre_process_data.scr
#	Calling Script	:
#	Menu Option		: HLADISB
#	Srl. No		Date		Author			Description.
#	-------		----		------			----------------
#	1.0			26-06-2013	Prashanth		Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="0795707d5d88cdc19dd28161b35e0911a1d073973a4f573c311985deca6ce91e"
	TRACE ON
	
	#sv_a = urhk_b2k_PrintRepos("BANCS")
	#print(sv_a)
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	CUST.LADISB.errMsg = ""
	
	#-------------------------------------------------------------------------------------------
	# Getting foracid from from frontend
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.LADISB.foracid = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.foracid)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "Error: urhk_SRV_GetVal failed for foracid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Calculate the count of foracid's under same cif_id,schemeCode
	#--------------------------------------------------------------------------
	sv_s = ""
	sv_s = "count|"
	sv_s = sv_s + " SELECT COUNT(*)"
	sv_s = sv_s + " FROM CUSTOM.C_LADISB_PAYOFF_OLDLOAN A "
	sv_s = sv_s + " WHERE A.loan_foracid = ?SVAR"
	sv_s = sv_s + " AND A.del_flg = 'N'"
	sv_s = sv_s + " AND A.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND A.bank_id = ?SVAR"
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid  + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in calculating count of new loan foracid's"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.count = BANCS.OUTPARAM.count
		print(CUST.LADISB.count)
	#}
	ENDIF
	
	IF(CUST.LADISB.count > 0) THEN
	#{
		CUST.LADISB.errMsg = "Reversal cannot be done for the Loan a/c, as the Disbursed amount has been used to pay OFF the linked loan A/C's"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "") THEN
		#{
			sv_a = urhk_SRV_SetErr(CUST.LADISB.errMsg)
			BANCS.OUTPUT.successOrFailure="F"
			print(CUST.LADISB.errMsg)
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
