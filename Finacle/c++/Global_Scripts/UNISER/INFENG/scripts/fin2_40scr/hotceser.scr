#	IF ((CUSTS.SBACT.DccId=="XXX") OR (CUSTS.SBACT.DccId=="ERP") OR (CUSTS.SBACT.DccId=="ESB") OR (CUSTS.SBACT.DccId=="WWW")) THEN

