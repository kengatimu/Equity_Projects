				#}
				ENDIF

				BANCS.INPARAM.BINDVARS = CUSTS.SBACT.foracid + "|" + BANCS.STDIN.contextBankId 
				sv_s = "acctstatus,frezcode|SELECT smt.acct_status,FREZ_CODE FROM TBAADM.gam,tbaadm.smt WHERE gam.ENTITY_CRE_fLG='Y' AND gam.DEL_FLG='N' and gam.acid=smt.acid  and gam.bank_id=smt.bank_id AND gam.FORACID = ?SVAR AND gam.BANK_ID = ?SVAR "
				sv_u = urhk_dbselectWithBind(sv_s)
				IF(sv_u == 0) THEN
				#{
					CUSTS.SBACT.acctstatus = BANCS.OUTPARAM.acctstatus
					print(CUSTS.SBACT.acctstatus)
					CUSTS.SBACT.frezcode = BANCS.OUTPARAM.frezcode
					print(CUSTS.SBACT.frezcode)
					IF (CUSTS.SBACT.acctstatus=="I") THEN
						CUSTS.SBACT.errMsg="The account is Inactive"
						sv_e=urhk_SetOrbOut("Error|"+CUSTS.SBACT.errMsg)
						CUSTS.SBACT.errMsgst="FAILURE"
						sv_f=urhk_SetOrbOut("Status|"+CUSTS.SBACT.errMsgst)
						GOTO End
					ENDIF
					IF (CUSTS.SBACT.acctstatus=="D") THEN
						CUSTS.SBACT.errMsg="The account is  Dormant"
						sv_e=urhk_SetOrbOut("Error|"+CUSTS.SBACT.errMsg)
						CUSTS.SBACT.errMsgst="FAILURE"
						sv_f=urhk_SetOrbOut("Status|"+CUSTS.SBACT.errMsgst)
						GOTO End
					ENDIF
					IF ((CUSTS.SBACT.frezcode=="D") OR (CUSTS.SBACT.frezcode=="T")) THEN
						CUSTS.SBACT.errMsg="The account is freezed"
						sv_e=urhk_SetOrbOut("Error|"+CUSTS.SBACT.errMsg)
						CUSTS.SBACT.errMsgst="FAILURE"
						sv_f=urhk_SetOrbOut("Status|"+CUSTS.SBACT.errMsgst)
						GOTO End
