	#}
	ENDIF
	
	
	#========================================================
	# Fetching the Record count
	#========================================================
	BANCS.INPARAM.BINDVARS = "N|Y|"+ BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.contextBankId + "|" + CUST.UBP.billerid
	sv_s = "recordNum|"
	sv_s = sv_s + " SELECT COUNT(*)"
	sv_s = sv_s + " FROM TBAADM.BRGT "
	sv_s = sv_s + " WHERE NVL(DEL_FLG, 'N') = ?SVAR"
	sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
	sv_s = sv_s + " AND FREE_TEXT1 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT2 = ?SVAR"
	sv_s = sv_s + " AND FREE_TEXT2 IS NOT NULL"
	sv_s = sv_s + " AND FREE_TEXT4 IS NOT NULL"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND BILLER_ID = ?SVAR"
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.UBP.recordNum = BANCS.OUTPARAM.recordNum
		PRINT(CUST.UBP.recordNum)
	#}
	ENDIF
	#sv_u = urhk_SetOrbOut("recCount|"+CUST.UBP.recordNum)
	#PRINT(sv_u)
	
	IF(CUST.UBP.recordNum=="0")THEN
	#{
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		#========================================================
		# Fetching tthe values from BRGT table and populating
		# the searcher list
		#========================================================
		BANCS.INPARAM.BINDVARS = "Y|N|"+ BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.contextBankId+ "|" + CUST.UBP.billerid
		sv_s = "billerId,billAcctId,billAcName,bankId,chgEvetId,valType,billercode|"
