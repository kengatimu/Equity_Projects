		#sv_s = sv_s + " SELECT BILLER_ID,FREE_TEXT1,replace(lpad(BILLER_NAME,35,' '),'''','&#8217'),FREE_TEXT2,FREE_TEXT3,FREE_TEXT4 ,FREE_TEXT5"
		sv_s = sv_s + " FROM TBAADM.BRGT "
		sv_s = sv_s + " WHERE NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		sv_s = sv_s + " AND FREE_TEXT1 IS NOT NULL"
		sv_s = sv_s + " AND FREE_TEXT2 = ?SVAR"
		sv_s = sv_s + " AND FREE_TEXT2 IS NOT NULL"
		sv_s = sv_s + " AND FREE_TEXT4 IS NOT NULL"
		sv_s = sv_s + " AND BANK_ID = ?SVAR"
		sv_s = sv_s + " AND BILLER_ID = ?SVAR"
		PRINT(sv_s)
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		PRINT(sv_c)
		IF(sv_c != 0)THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_n)
		sv_f = urhk_dbCursorFetch(sv_n)
		PRINT(sv_f)
		CUST.DATA.number = "0"
		print(CUST.DATA.number)
		WHILE(sv_f == 0)
		#{
			CUST.UBP.billerId = BANCS.OUTPARAM.billerId
			PRINT(CUST.UBP.billerId)
			CUST.UBP.billAcctId = BANCS.OUTPARAM.billAcctId
			PRINT(CUST.UBP.billAcctId)
			CUST.UBP.billAcName = BANCS.OUTPARAM.billAcName
			PRINT(CUST.UBP.billAcName)
			CUST.UBP.bankId = BANCS.OUTPARAM.bankId
			PRINT(CUST.UBP.bankId)
			CUST.UBP.chgEvetId = BANCS.OUTPARAM.chgEvetId
			PRINT(CUST.UBP.chgEvetId)
			CUST.UBP.valType = BANCS.OUTPARAM.valType
			PRINT(CUST.UBP.valType)
			CUST.UBP.billercode = BANCS.OUTPARAM.billercode
			PRINT(CUST.UBP.billercode)
			
			
			IF (strlen(CUST.UBP.billerId) !="") THEN
			#{
				sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.billerId|" + CUST.UBP.billerId
				print(sv_s)
				sv_Z = urhk_SetOrbOut(sv_s)
			#}
			ENDIF
			IF (strlen(CUST.UBP.billAcctId) !="") THEN
			#{
				sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.billAcctId|" + CUST.UBP.billAcctId
				print(sv_s)
				sv_Z = urhk_SetOrbOut(sv_s)
			#}
			ENDIF
			IF (strlen(CUST.UBP.billAcName) !="") THEN
			#{
				sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.billAcName|" + CUST.UBP.billAcName
				print(sv_s)
				sv_Z = urhk_SetOrbOut(sv_s)
			#}
			ENDIF
			
			IF (strlen(CUST.UBP.bankId) !="") THEN
			#{
				sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.bankId|" + CUST.UBP.bankId
				print(sv_s)
				sv_Z = urhk_SetOrbOut(sv_s)
			#}
			ENDIF
			IF (strlen(CUST.UBP.chgEvetId) !="") THEN
			#{
				sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.chgEvetId|" + CUST.UBP.chgEvetId
				print(sv_s)
				sv_Z = urhk_SetOrbOut(sv_s)
			#}
			ENDIF
			
			IF (strlen(CUST.UBP.valType) !="") THEN
			#{
				sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.valType|" + CUST.UBP.valType
				print(sv_s)
				sv_Z = urhk_SetOrbOut(sv_s)
			#}
			ENDIF
			
			
			IF (strlen(CUST.UBP.billercode) !="") THEN
			#{
				sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.billercode|" + CUST.UBP.billercode
				print(sv_s)
				sv_Z = urhk_SetOrbOut(sv_s)
			#}
			ENDIF
			
			CUST.DATA.numberone = "1"
			print(CUST.DATA.numberone)
			print(CUST.DATA.number)
			sv_q = "number|select ('" + CUST.DATA.number + "' + '" + CUST.DATA.numberone + "') from dual "
			print(sv_q)
			sv_w=urhk_dbSelectWithBind(sv_q)
			IF (sv_w == 0) THEN
			#{
				print("sumamount")
				CUST.DATA.number = BANCS.OUTPARAM.number
				print(CUST.DATA.number)
			#}
			ENDIF
			
			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			print(CUST.DATA.number)
			
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_n)
		PRINT(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
END-->
