		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRate|"+CUST.CIETXN.ieTreaRate)
	#}
	ENDIF
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refNum| ")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranCode.refCode|"+CUST.CIETXN.tranParticularsCode)
	CUST.CIETXN.tranParticular1 = ""
	CUST.CIETXN.tranParticular1 = "CREDIT TRANSFER THRU " + MID$(BANCS.STDIN.homeCrncyCode,0,2) + " - " + BANCS.STDIN.mySolDesc
	PRINT(CUST.CIETXN.tranParticular1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+CUST.CIETXN.tranParticular1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|TRF FROM "+CUST.CIETXN.drAcctName)
	IF(CUST.CIETXN.instrumentNum != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntType|"+CUST.CIETXN.instrumentType)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntAlpha|"+CUST.CIETXN.instrumentAlpha)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntNum|"+CUST.CIETXN.instrumentNum)
		CUST.CIETXN.instrumentDate = CUST.CIETXN.instrumentDate + " 00:00:00"
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntDate|"+CUST.CIETXN.instrumentDate)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------------------------
	# Credit Leg
	#------------------------------------------------------------------------------------------------
	
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|00002")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+CUST.CIETXN.refCrncy)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.CIETXN.refAmt+"|"+ CUST.CIETXN.refCrncy)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.CIETXN.crAcctNum)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
	IF(TRIM(CUST.CIETXN.ieRateCode)!= "")THEN
	#{
		IF(CUST.CIETXN.refCrncy != CUST.CIETXN.crAcctNumCcy)THEN
		#{
			sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rateCode.refCode|"+CUST.CIETXN.ieRateCode)
			sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rate|"+CUST.CIETXN.ieRate)
			sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.treaRate|"+CUST.CIETXN.ieTreaRate)
		#}
		ENDIF
	#}
	ENDIF
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|"+CUST.CIETXN.drAcctNum)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranCode.refCode|"+CUST.CIETXN.tranParticularsCode)
	CUST.CIETXN.tranParticular11 = ""
	CUST.CIETXN.tranParticular11 = "TRF FROM " + CUST.CIETXN.drAcctName
	PRINT(CUST.CIETXN.tranParticular11)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+CUST.CIETXN.tranParticular11)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|"+CUST.CIETXN.tranParticular11)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars2|"+CUST.CIETXN.tranRmks2)
	
	#------------------------------------------------------------------------------------------------
	
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
	
	IF(CUST.CIETXN.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#}
	ELSE
