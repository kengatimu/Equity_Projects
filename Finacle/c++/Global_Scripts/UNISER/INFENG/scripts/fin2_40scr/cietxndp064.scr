	BANCS.INPUT.refAmt = CUST.CIETXN.refAmt
	
	CUST.CIETXN.ieRateCode = ""
	CUST.CIETXN.ieRate = ""
	CUST.CIETXN.ieTreaRate = ""
	
	CALL("cietxndp067.scr")
	
	PRINT(CUST.CIETXN.ieRateCode)
	PRINT(CUST.CIETXN.ieRate)
	PRINT(CUST.CIETXN.ieTreaRate)
	
	IF((TRIM(CUST.CIETXN.ieRateCode) == "") AND (CDOUBLE(CUST.CIETXN.ieRate) != 1))THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.CIETXN.errorMsg + "^funcCode"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		CUST.CIETXN.scriptSuccess  = "N"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###########################################################################################
	# Tran Header
	###########################################################################################
	
	sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	CUST.CIETXN.tranSubType = "CI"
	sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|"+CUST.CIETXN.tranSubType)
	sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	
	###########################################################################################
	# Part Tran Details : Txn in Current Entity - Debit Leg
	###########################################################################################
	
	#-----------------------------------------------------------------------------------------------
	# Debit Leg
	#-----------------------------------------------------------------------------------------------
	
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|00001")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+CUST.CIETXN.refCrncy)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+CUST.CIETXN.refAmt+"|"+ CUST.CIETXN.refCrncy)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+CUST.CIETXN.nostroAcct)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+BANCS.STDIN.BODDate)
	IF(TRIM(CUST.CIETXN.ieRateCode)!= "")THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rateCode.refCode|"+CUST.CIETXN.ieRateCode)
