<--start
trace on
#Rep/Class
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0) then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_u = urhk_B2k_PrintRepos("BANCS")
        print(sv_u)

	if(fieldexists(BANCS.INPUT.AcctNum)==1)then	
		EQSRV.GLBDATA.AcctNum = BANCS.INPUT.AcctNum
	else
		EQSRV.GLBDATA.AcctNum = ""
	endif
	if(fieldexists(BANCS.INPUT.TranAmt)==1)then	
		EQSRV.GLBDATA.TranAmt = BANCS.INPUT.TranAmt
	else
		EQSRV.GLBDATA.TranAmt = ""
	endif
	if(fieldexists(BANCS.INPUT.TranDate)==1)then	
		EQSRV.GLBDATA.TranDate = BANCS.INPUT.TranDate
	else
		EQSRV.GLBDATA.TranDate = ""
	endif

	sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.AcctNum)
	if(sv_u ==0)then
		EQSRV.GLBDATA.glSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
		EQSRV.GLBDATA.solId     =       BANCS.OUTPARAM.acctSolId
		EQSRV.GLBDATA.schmType  =       BANCS.OUTPARAM.schmType
		EQSRV.GLBDATA.schmCode  =       BANCS.OUTPARAM.schmCode
		 sv_u = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.AcctNum)
                        if(sv_u==0)then
                                EQSRV.GLBDATA.InpAcid = BANCS.OUTPARAM.Acid
                        else
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|Invalid  Account " + EQSRV.GLBDATA.AcctNum ) 
                                exitscript
                        endif
	else
		 sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		 sv_u = urhk_SetOrbOut("Message|Invalid  Account " + EQSRV.GLBDATA.AcctNum ) 
		 exitscript
	endif
	if(strlen(BANCS.INPUT.TranDate)<10)then
		 sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		 sv_u = urhk_SetOrbOut("Message| Invalid Date")
		 exitscript
	endif
	sv_s = "tranId,tranDate,tranAmt,tranCrncy,refNum,trnRem | select tran_id,tran_date,tran_amt,tran_crncy_code,REF_NUM,tran_particular "
	sv_s = sv_s + " from tbaadm.dtd where bank_id=?SVAR "
	sv_s = sv_s + " and acid =?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR') "
	if(cdouble(EQSRV.GLBDATA.TranAmt)>0)then
	sv_s = sv_s + " and tran_amt =?SVAR "
	endif
	print(sv_s)
	if(cdouble(EQSRV.GLBDATA.TranAmt)>0)then
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  EQSRV.GLBDATA.InpAcid + "|" + EQSRV.GLBDATA.TranDate + "|" + EQSRV.GLBDATA.TranAmt
	else
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  EQSRV.GLBDATA.InpAcid + "|" + EQSRV.GLBDATA.TranDate
	endif
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbCursorOpenWithBind(sv_s)
        if(sv_u == 0)then
                EQSRV.GLBDATA.sihCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Data Combination Not exists" )
                goto VAYU

        endif
        EQSRV.GLBDATA.recNum = 0
        sv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.sihCurNum)
        if(sv_f !=0)then
                sv_f = urhk_dbCursorClose(EQSRV.GLBDATA.sihCurNum)
                print(sv_f)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Data Combination Not exists" )
                goto VAYU
        endif
        while(sv_f ==0)
                EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
                EQSRV.GLBDATA.tranDate = BANCS.OUTPARAM.tranDate
                EQSRV.GLBDATA.tranAmt = BANCS.OUTPARAM.tranAmt
                EQSRV.GLBDATA.tranCrncy = BANCS.OUTPARAM.tranCrncy
                EQSRV.GLBDATA.refNum = BANCS.OUTPARAM.refNum
		EQSRV.GLBDATA.trnRem = BANCS.OUTPARAM.trnRem
                sv_u = urhk_SetOrbOut("AcctNum|" + EQSRV.GLBDATA.AcctNum ) 
                if(EQSRV.GLBDATA.tranId !="")then
                sv_u = urhk_SetOrbOut("TranDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TranId |" + EQSRV.GLBDATA.tranId ) 
		endif
                if(EQSRV.GLBDATA.tranDate !="")then
		sv_u = urhk_SetOrbOut("TranDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TranDate |" + EQSRV.GLBDATA.tranDate ) 
                endif
                if(EQSRV.GLBDATA.tranAmt!="")then
		sv_u = urhk_SetOrbOut("TranDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TranAmt|" + EQSRV.GLBDATA.tranAmt ) 
                endif
		if(EQSRV.GLBDATA.tranCrncy!="") then
		sv_u = urhk_SetOrbOut("TranDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TranCrncy|" + EQSRV.GLBDATA.tranCrncy ) 
		endif
		if(EQSRV.GLBDATA.refNum!="") then
		sv_u = urhk_SetOrbOut("TranDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.RefNum|" + EQSRV.GLBDATA.refNum ) 
		endif
		if(EQSRV.GLBDATA.trnRem!="") then
		sv_u = urhk_SetOrbOut("TranDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TranParticular|" + EQSRV.GLBDATA.trnRem ) 
		endif
               sv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.sihCurNum)
                EQSRV.GLBDATA.recNum = cint(EQSRV.GLBDATA.recNum) + 1
        do
        sv_f = urhk_dbCursorClose(EQSRV.GLBDATA.sihCurNum)
        print(sv_f)
VAYU:
	exitscript	
trace off
end-->
