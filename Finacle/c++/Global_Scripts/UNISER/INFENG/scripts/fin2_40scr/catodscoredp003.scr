<--START
CHECKSUM="913d2c81880b6a09ad84fcee4860bb7118e21c669b1c50688215bf280052ca5c"
	TRACE ON
	#-----------------------------------------------------------------
	# Initialiizing required variables
	#-----------------------------------------------------------------
	print(CUST.CATOD.foracid)
	print(CUST.CATOD.score)
	print(CUST.CATOD.maxCntrctAmt)
	print(CUST.CATOD.maxCntrctPeriod)
	print(CUST.CATOD.cntrctAmt)
	print(CUST.CATOD.employr)
	print(CUST.CATOD.dept)
	
	CUST.CATOD.CurrencyCode 	=	BANCS.STDIN.homeCrncyCode
	
	CUST.CATOD.cForacid			=	CUST.CATOD.foracid
	CUST.CATOD.score			=	CUST.CATOD.score
	CUST.CATOD.Txfrlmt 			=	CUST.CATOD.cntrctAmt
	CUST.CATOD.CashIntSolmt 	=	CUST.CATOD.maxCntrctPeriod
	CUST.CATOD.cntrctAmt		=	CUST.CATOD.cntrctAmt
	CUST.CATOD.Cashlmt			=	CUST.CATOD.employr
	CUST.CATOD.depart			=	CUST.CATOD.dept
	
	print(CUST.CATOD.Cashlmt)
	print(CUST.CATOD.Txfrlmt)
	print(CUST.CATOD.CashIntSolmt)
	print(CUST.CATOD.cntrctAmt)
	print(CUST.CATOD.cForacid)
	
	sv_s = "crclRoleId|"
	sv_s = sv_s + " SELECT UPR.role_id"
	sv_s = sv_s + " FROM TBAADM.UPR"
	sv_s = sv_s + " WHERE UPR.user_id = ?SVAR"
	sv_s = sv_s + " AND UPR.del_flg = 'N'"
	sv_s = sv_s + " AND UPR.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND UPR.home_bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" +BANCS.STDIN.contextBankId
	sv_d=urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.CATOD.crclRoleId = BANCS.OUTPARAM.crclRoleId
		#}
	ELSE
		#{
		CUST.CATOD.crclRoleId = ""
	#}
	ENDIF
	
	sv_s = "cifId|"
	sv_s = sv_s + " SELECT GAM.cif_id"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE GAM.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND GAM.acct_cls_flg ='N'"
	sv_s = sv_s + " AND GAM.foracid = ?SVAR"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CATOD.cForacid + "|" +BANCS.STDIN.contextBankId
	sv_d=urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d == 0)  THEN
	#{
		CUST.CATOD.custId = BANCS.OUTPARAM.cifId
		print(CUST.CATOD.custId)
	#}
	ENDIF
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.CATOD.cForacid)
	print(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CATOD.acctSolId  = BANCS.OUTPARAM.acctSolId
		CUST.CATOD.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		CUST.CATOD.schmType = BANCS.OUTPARAM.schmType
		CUST.CATOD.schmCode = BANCS.OUTPARAM.schmCode
		CUST.CATOD.glSubHeadCode = BANCS.OUTPARAM.glSubHeadCode
		CUST.CATOD.acctOwner = BANCS.OUTPARAM.acctOwnerShip
		print(CUST.CATOD.acctSolId)
		print(CUST.CATOD.acctCrncyCode)
		print(CUST.CATOD.schmType)
		print(CUST.CATOD.schmCode)
		print(CUST.CATOD.glSubHeadCode)
		print(CUST.CATOD.acctOwner)
		#}
	ELSE
		#{
		sv_v = "N"
		sv_c = sv_c + 1
		CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "Account number is Invalid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------------------
	# IF Function Value is "U"
	#------------------------------------------------------------------------------------------
	
	IF (CUST.CATOD.Function=="U")  THEN
	#{
		
		sv_s = "count|"
		sv_s = sv_s + " SELECT COUNT(1)"
		sv_s = sv_s + " FROM CUSTOM.CATOD_MASTER_TABLE"
		sv_s = sv_s + " WHERE CATOD_MASTER_TABLE.ACCT_NUM = ?SVAR"
		sv_s = sv_s + " AND CATOD_MASTER_TABLE.bank_id = ?SVAR"
		sv_s = sv_s + " AND CATOD_MASTER_TABLE.del_flg = 'N'"
		sv_s = sv_s + " AND CATOD_MASTER_TABLE.entity_cre_flg = 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CATOD.cForacid + "|" +BANCS.STDIN.contextBankId
		sv_d=urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d == 0)  THEN
		#{
			CUST.CATOD.count = BANCS.OUTPARAM.count
			print(CUST.CATOD.count)
			#}
		ELSE
			#{
			sv_v = "N"
			sv_c = sv_c + 1
			CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "Error WHILE count"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (CINT(CUST.CATOD.count) >= 1)  THEN
		#{
			sv_v = "N"
			sv_c = sv_c + 1
			CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Record Already Exist. Use M as Function"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_s = "srlnum|SELECT CUSTOM.CATODSCORE_SEQ_"+ BANCS.STDIN.contextBankId + ".nextval "
		sv_s = sv_s +"FROM dual"
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.CATOD.keySeq = BANCS.OUTPARAM.srlnum
			print(CUST.CATOD.keySeq)
		#}
		ENDIF
		
		sv_s = ""
		sv_s = sv_s + " INSERT INTO"
		sv_s = sv_s + " CUSTOM.CATOD_MASTER_TABLE"
		sv_s = sv_s + " ("
		sv_s = sv_s + " KEY_SEQ ,"
		sv_s = sv_s + " CUST_ID,"
		sv_s = sv_s + " SCORE,"
		sv_s = sv_s + " MAX_CNTRT_AMT,"
		sv_s = sv_s + " MAX_CNTRT_PERIOD,"
		sv_s = sv_s + " REC_TIMESTAMP,"
		sv_s = sv_s + " ACCT_NUM,"
		sv_s = sv_s + " CONTRACT_AMT,"
		sv_s = sv_s + " BRANCH_ID,"
		sv_s = sv_s + " EMPLOYER,"
		sv_s = sv_s + " DEPARTMENT,"
		sv_s = sv_s + " BANK_ID,"
		sv_s = sv_s + " DEL_FLG,"
		sv_s = sv_s + " ENTITY_CRE_FLG"
		sv_s = sv_s + " )"
		sv_s = sv_s + " VALUES"
		sv_s = sv_s + " ("
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " SYSDATE,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " ?SVAR,"
		sv_s = sv_s + " 'N',"
		sv_s = sv_s + " 'Y'"
		sv_s = sv_s + " )"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CATOD.keySeq + "|" + CUST.CATOD.custId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.score + "|" + CUST.CATOD.maxCntrctAmt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.CATOD.maxCntrctPeriod
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.cForacid + "|" + CUST.CATOD.cntrctAmt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.acctSolId + "|" + CUST.CATOD.employr
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.depart + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbsqlWithBind(sv_s)
		
		IF (sv_d != 0)  THEN
		#{
			sv_v = "N"
			sv_c = sv_c + 1
			CUST.CATOD.errColl = CUST.CATOD.errColl + "~" + "Error in Adding Details"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
