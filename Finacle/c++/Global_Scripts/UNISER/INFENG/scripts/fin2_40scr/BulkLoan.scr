print (CUST.INTERFACE.PERIOD )
CUST.INTERFACE.STARTDATE = BANCS.OUTPARAM.OTHER
print (CUST.INTERFACE.STARTDATE )
CUST.INTERFACE.LOANAMT =BANCS.OUTPARAM.LOANAMT
print (CUST.INTERFACE.LOANAMT )
CUST.INTERFACE.LOANLACE  =BANCS.OUTPARAM.LACE
print (CUST.INTERFACE.LOANLACE  )
CUST.INTERFACE.LOANINSU =BANCS.OUTPARAM.INSURANCE
print (CUST.INTERFACE.LOANINSU )
CUST.INTERFACE.USERID =BANCS.OUTPARAM.USER_ID
print (CUST.INTERFACE.USERID)
CUST.INTERFACE.datec=BANCS.OUTPARAM.dateX
print(CUST.INTERFACE.datec)
CUST.INTERFACE.monthc=BANCS.OUTPARAM.monthX
print(CUST.INTERFACE.monthc)
CUST.INTERFACE.yearc=BANCS.OUTPARAM.yearX
print(CUST.INTERFACE.yearc)

CUST.INTERFACE.lastdatepart ="T00:00:00.000"
print(CUST.INTERFACE.lastdatepart)

CUST.INTERFACE.sign ="-"
print(CUST.INTERFACE.sign)

CUST.INTERFACE.STARTFDATE  =  CUST.INTERFACE.yearc + CUST.INTERFACE.sign + CUST.INTERFACE.monthc + CUST.INTERFACE.sign + CUST.INTERFACE.datec + CUST.INTERFACE.lastdatepart 
print(CUST.INTERFACE.STARTFDATE  )

#-------------------------------------------------------------------------
# Fetch the current data time to send in request header
#-------------------------------------------------------------------------
sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
	CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
	print(CUST.INTERFACE.msgDateTime)
#}
ENDIF

#-------------------------------------------------------------------------
#- Forming the Header for RetCustAdd
#-------------------------------------------------------------------------

sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0)THEN
#{
	CUST.INTERFACE.RequestID1 = BANCS.OUTPARAM.RequestID
	print(CUST.INTERFACE.RequestID1)
#}
ELSE
#{
	CUST.INTERFACE.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
	print(CUST.INTERFACE.RequestID1)
#}
ENDIF

