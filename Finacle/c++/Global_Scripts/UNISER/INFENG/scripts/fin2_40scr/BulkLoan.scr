<--start
trace on

CALL("Common_Interface_CreateRepos.scr")


sv_s="OTHER ,OPACC, SOL_ID,LOANAMT,PERIOD, CRNCY_CODE, LACE,INSURANCE, SCHM_CODE , BANK_ID, CIF_ID, USER_ID , STARTFDATE,dateX,monthX, yearX  |"
sv_s = sv_s + " SELECT OTHER, OPACC, a.SOL_ID,LOANAMT,PERIOD, a.CRNCY_CODE,LACE,INSURANCE,a.SCHM_CODE ,a.BANK_ID,gam.CIF_ID, USER_ID , STARTFDATE , "
sv_s = sv_s + " substr (to_char((to_date(STARTFDATE,'DD-MM-RRRR')),'DD-MM-RRRR'),0,2) as dateX, substr (to_char((to_date(STARTFDATE,'DD-MM-RRRR')),'DD-MM-RRRR'),4,2) as monthX, "
sv_s = sv_s + " substr (to_char((to_date(STARTFDATE,'DD-MM-RRRR')),'DD-MM-RRRR'),7,4) as yearX "
sv_s = sv_s + " FROM CUSTOM.BULK_loan a, tbaadm.gam "
sv_s = sv_s + " WHERE a.entity_cre_flg='N' "
sv_s = sv_s + " AND a.bank_id = ?SVAR "
sv_s = sv_s + " AND OPACC = foracid "
print(sv_s)
#BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId 
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)

sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c==0) then
#{

	CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
	print(sv_k)

WHILE (sv_k == 0)
#{

CUST.INTERFACE.interfaceRequestID = "LoanAcctAdd"
CUST.INTERFACE.interfaceRequestVersion = "10.2"
CUST.INTERFACE.bankID =BANCS.STDIN.contextBankId
CUST.INTERFACE.channelID = "COR"
CUST.INTERFACE.startdate = MID$(BANCS.STDIN.BODDate,0,10)
CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)

CUST.INTERFACE.CIFID = BANCS.OUTPARAM.CIF_ID
print (CUST.INTERFACE.CIFID )
CUST.INTERFACE.OPACC =BANCS.OUTPARAM.OPACC
print (CUST.INTERFACE.OPACC )
CUST.INTERFACE.SCHM = BANCS.OUTPARAM.SCHM_CODE
print (CUST.INTERFACE.SCHM )
