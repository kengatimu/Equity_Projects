	CUST.LADISB.failFile = "PAYOFFFAIL_"+ CUST.LADISB.pid +".txt"
	PRINT(CUST.LADISB.sucsFile)
	PRINT(CUST.LADISB.failFile)
	
	#----------------------------------------------------------------------
	# Getting records from custom table
	#----------------------------------------------------------------------
	sv_s = ""
	sv_s = sv_s + " foracid,opForacid,crAmount,drAmount,oldLoanCrncyCode|"
	sv_s = sv_s + " SELECT A.old_foracid,A.loan_op_foracid,A.la_op_amt,"
	sv_s = sv_s + " A.old_la_amt,A.old_la_crncy_code"
	sv_s = sv_s + " FROM CUSTOM.C_LADISB_PAYOFF_OLDLOAN A"
	sv_s = sv_s + " WHERE A.del_flg = 'N'"
	sv_s = sv_s + " AND A.entity_cre_flg = 'N'"
	sv_s = sv_s + " AND A.loan_foracid=?SVAR"
	sv_s = sv_s + " AND A.bank_id=?SVAR"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.loanForacid + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF( sv_c == 0) THEN
	#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		PRINT(sv_c)
		
		WHILE( sv_c == 0)
		#{
			CUST.LADISB.foracid 			= TOUPPER(BANCS.OUTPARAM.foracid)
			CUST.LADISB.opForacid 			= TOUPPER(BANCS.OUTPARAM.opForacid)
			CUST.LADISB.crAmount 			= BANCS.OUTPARAM.crAmount
			CUST.LADISB.drAmount 			= BANCS.OUTPARAM.drAmount
			CUST.LADISB.oldLoanCrncyCode 	= BANCS.OUTPARAM.oldLoanCrncyCode
			
			PRINT(CUST.LADISB.foracid)
			PRINT(CUST.LADISB.opForacid)
			PRINT(CUST.LADISB.crAmount)
			PRINT(CUST.LADISB.drAmount)
			PRINT(CUST.LADISB.oldLoanCrncyCode)
			
			CUST.LADISB.tranId = ""
			#--------------------------------------------------------------
			# getting the currency of debit account of payoff
			#--------------------------------------------------------------
			sv_a = urhk_getAcctDetailsInRepository(CUST.LADISB.opForacid)
			PRINT(sv_a)
			sv_u = 0
			IF(sv_a == 0) THEN
			#{
				CUST.LADISB.OpAcctCrncyCode 	= BANCS.OUTPARAM.acctCrncyCode
				PRINT(CUST.LADISB.OpAcctCrncyCode)
				
				#-----------------------------------------------------------------------
				# 	Defining Transaction between credit account and debit Account
				#-----------------------------------------------------------------------
				IF(CDOUBLE(CUST.LADISB.crAmount) < 0) THEN
				#{
					CUST.LADISB.crAmount = -1 * CDOUBLE(CUST.LADISB.crAmount)
					PRINT(CUST.LADISB.crAmount)
				#}
				ENDIF
				
				
				#------------------------------------------------------------------------------------------
				# Service SRV_FetchLaAcctDtlForPayOff
				#------------------------------------------------------------------------------------------
				sv_a = urhk_SetUrhkInp("payOffCrit.payOffValueDate|"+BANCS.STDIN.BODDate)
				sv_a = urhk_SetUrhkInp("payOffCrit.funcCode|P")
				sv_a = urhk_SetUrhkInp("payOffCrit.laAcct.foracid|"+CUST.LADISB.foracid)
				sv_a = urhk_SetUrhkInp("payOffCrit.tranType.tranType|T")
				sv_a = urhk_SetUrhkInp("payOffCrit.tranType.tranSubType|BI")
				sv_a = urhk_SetUrhkInp("payOffCrit.tranType.tranSubDesc|BANK INDUCED")
				sv_a = urhk_SetUrhkInp("payOffCrit.collAcct.foracid|"+CUST.LADISB.opForacid)
				
				#IF(CUST.LADISB.OpAcctCrncyCode != CUST.LADISB.oldLoanCrncyCode) THEN
				#{
				sv_a = urhk_SetUrhkInp("payOffCrit.tranExcgRateCode.refCode|"+CUST.LADISB.repayRateCode)
				PRINT(sv_a)
				sv_a = urhk_SetUrhkInp("payOffCrit.tranExcgRateCode.refRecType|67")
				PRINT(sv_a)
				#}
				#ENDIF
				
				sv_a = urhk_SetUrhkInp("payOffCrit.calcDsaPenalty|N")
				sv_a = urhk_SetUrhkInp("payOffCrit.reverseSubvention|N")
				sv_a = urhk_SetUrhkInp("payOffCrit.fcSolId|"+BANCS.STDIN.homeSolId)
				sv_a = urhk_SetUrhkInp("payOffCrit.prePaymentType|V")
				sv_a = urhk_SetUrhkInp("assmntMsg.laAcct.foracid|"+CUST.LADISB.foracid)
				
				sv_u = urhk_ExecSrv("SRV_FetchLaAcctDtlForPayOff|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				
				IF(sv_u == 0) THEN
				#{
					#------------------------------------------------------------------------------------------
					# Executing the next service if the above service executed successfully
					#------------------------------------------------------------------------------------------
					sv_a= urhk_CopyOutToIn("")
					sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPayOff|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)
					
					IF(sv_u == 0) THEN
					#{
						#------------------------------------------------------------------------------------------
						# Executing the next service if the above service executed successfully
						#------------------------------------------------------------------------------------------
						sv_a= urhk_CopyOutToIn("")
						
						#sv_u = urhk_ExecSrv("SRV_PayOffLaAcct|retain_all_output = Y|same_user_verify = Y")
						sv_u = urhk_ExecSrv("NAPI_PayOffLaAcct|retain_all_output = Y|same_user_verify = Y")
						PRINT(sv_u)
						
						IF(sv_u == 0) THEN
						#{
							#------------------------------------------------------------------------------------------
							# If the count is one then payoff modified successfully.
							# passing all the inputs to payoff service verify function
							#------------------------------------------------------------------------------------------
							#------------------------------------------------------------------------------------------
							# Service SRV_FetchLaAcctDtlForPayOff
							#------------------------------------------------------------------------------------------
							sv_a = urhk_SetUrhkInp("payOffCrit.payOffValueDate|"+BANCS.STDIN.BODDate)
							sv_a = urhk_SetUrhkInp("payOffCrit.funcCode|V")
							sv_a = urhk_SetUrhkInp("payOffCrit.laAcct.foracid|"+CUST.LADISB.foracid)
							sv_a = urhk_SetUrhkInp("payOffCrit.tranType.tranType|T")
							sv_a = urhk_SetUrhkInp("payOffCrit.tranType.tranSubType|BI")
							sv_a = urhk_SetUrhkInp("payOffCrit.tranType.tranSubDesc|BANK INDUCED")
							sv_a = urhk_SetUrhkInp("payOffCrit.collAcct.foracid|"+CUST.LADISB.opForacid)
							sv_a = urhk_SetUrhkInp("tranObj.tranDetail.ignoreXcpnFlg|Y")
							
							IF(CUST.LADISB.OpAcctCrncyCode != CUST.LADISB.oldLoanCrncyCode) THEN
							#{
								sv_a = urhk_SetUrhkInp("payOffCrit.tranExcgRateCode.refCode|"+CUST.LADISB.repayRateCode)
								PRINT(sv_a)
								sv_a = urhk_SetUrhkInp("payOffCrit.tranExcgRateCode.refRecType|67")
								PRINT(sv_a)
							#}
							ENDIF
							
							sv_a = urhk_SetUrhkInp("payOffCrit.calcDsaPenalty|N")
							sv_a = urhk_SetUrhkInp("payOffCrit.reverseSubvention|N")
							sv_a = urhk_SetUrhkInp("payOffCrit.fcSolId|"+BANCS.STDIN.homeSolId)
							sv_a = urhk_SetUrhkInp("payOffCrit.prePaymentType|V")
							sv_a = urhk_SetUrhkInp("assmntMsg.laAcct.foracid|"+CUST.LADISB.foracid)
							
							sv_u = urhk_ExecSrv("SRV_FetchLaAcctDtlForPayOff|retain_all_output = Y|same_user_verify = Y")
							PRINT(sv_u)
							
							IF(sv_u == 0) THEN
							#{
								#------------------------------------------------------------------------------------------
								# Executing the next service if the above service executed successfully
								#------------------------------------------------------------------------------------------
								sv_a= urhk_CopyOutToIn("")
								sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPayOff|retain_all_output = Y|same_user_verify = Y")
								PRINT(sv_u)
								
								IF(sv_u == 0) THEN
								#{
									#------------------------------------------------------------------------------------------
									# If the count is one then payoff modified successfully.
									# passing all the inputs to payoff service verify function
									#------------------------------------------------------------------------------------------
									sv_a= urhk_CopyOutToIn("")
									sv_a = urhk_SetUrhkInp("tranObj.tranDetail.ignoreXcpnFlg|Y")
									PRINT(sv_a)
									sv_a = urhk_SetUrhkInp("payOffCrit.funcCode|V")
									PRINT(sv_a)
									sv_a = urhk_SetUrhkOut("tranObj.tranDetail.tranIdentifier.tranId|tranId")
									PRINT(sv_a)
									sv_a = urhk_SetUrhkOut("tranObj.tranDetail.tranIdentifier.tranDate|tranDate")
									PRINT(sv_a)
									sv_u = urhk_ExecSrv("NAPI_PayOffLaAcct|retain_all_output = Y|same_user_verify = Y")
									PRINT(sv_u)
									
									IF(sv_u != 0) THEN
									#{
										sv_a= urhk_CopyOutToIn("")
										sv_a = urhk_SetUrhkInp("tranObj.tranDetail.ignoreXcpnFlg|Y")
										PRINT(sv_a)
										sv_a = urhk_SetUrhkInp("payOffCrit.funcCode|V")
										PRINT(sv_a)
										sv_a = urhk_SetUrhkOut("tranObj.tranDetail.tranIdentifier.tranId|tranId")
										PRINT(sv_a)
										sv_a = urhk_SetUrhkOut("tranObj.tranDetail.tranIdentifier.tranDate|tranDate")
										PRINT(sv_a)
										sv_u = urhk_ExecSrv("NAPI_PayOffLaAcct|retain_all_output = Y|same_user_verify = Y")
										PRINT(sv_u)
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
							
							IF((FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) AND (sv_u == 0)) THEN
							#{
								CUST.LADISB.tranId= BANCS.OUTPARAM.tranId
								PRINT(CUST.LADISB.tranId)
								
								sv_s = "echo 'Account ID \t Payoff Transaction ID' >>"+CUST.LADISB.sucsFile
								PRINT(sv_s)
								sv_a = SYSTEM(sv_s)
								PRINT(sv_a)
								
								sv_s = "echo '" + CUST.LADISB.foracid + ":" + CUST.LADISB.tranId+"' >>"+CUST.LADISB.sucsFile
								PRINT(sv_s)
								sv_a = SYSTEM(sv_s)
								PRINT(sv_a)
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				
				IF (sv_v > 0) THEN
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						CUST.LADISB.err = CUST.LADISB.err + "!" + sv_e
						PRINT(CUST.LADISB.err)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						PRINT(sv_e)
						sv_i = sv_i + 1
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			
			sv_c = urhk_dbCursorFetch(sv_l)
			PRINT(sv_c)
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.LADISB.errMsg != "") THEN
		#{
			sv_s = "echo 'Account ID \t Remarks ' >>"+CUST.LADISB.failFile
			PRINT(sv_s)
			sv_a = SYSTEM(sv_s)
			PRINT(sv_a)
			
			sv_s = "echo '"+CUST.LADISB.errMsg+"' >>"+CUST.LADISB.failFile
			PRINT(sv_s)
			sv_a = SYSTEM(sv_s)
			PRINT(sv_a)
			
			sv_u = urhk_Setorbout("Error|Payoff Failed, kindly check HPR for the failure report")
		#}
		ENDIF
		
		IF(CUST.LADISB.err != "") THEN
		#{
			sv_s = "echo '" + CUST.LADISB.foracid + ":" + CUST.LADISB.err+"' >>"+CUST.LADISB.failFile
			PRINT(sv_s)
			sv_a = SYSTEM(sv_s)
			PRINT(sv_a)
			
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = " DELETE FROM TBAADM.CLTT "
			sv_s = sv_s + "  WHERE "
			sv_s = sv_s + "  EVENT_ID ='PYOFF'"
			sv_s = sv_s + "  AND FUNC_CODE='P'"
			sv_s = sv_s + "  AND bank_id = ?SVAR"
			sv_s = sv_s + "  AND RCRE_USER_ID = ?SVAR"
			PRINT(sv_s)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			
			sv_d = urhk_dbSqlWithBind("COMMIT")
			PRINT(sv_d)
			
			#---------------------------------------------------------------------------------
			# Checking if report file is of zero bytes
			#---------------------------------------------------------------------------------
			sv_a = "test -s " + CUST.LADISB.failFile
			sv_b = SYSTEM(sv_a)
			PRINT(sv_b)
			
			#---------------------------------------------------------------------------------
			# Moving the File to  HPR menu
			#---------------------------------------------------------------------------------
			IF (sv_b == 0)THEN
			#{
				sv_a = "cp " + CUST.LADISB.failFile + " ${FIN_REPORTS_DIR}/" + BANCS.STDIN.userId + "/" + CUST.LADISB.failFile
				PRINT(sv_a)
				sv_b = SYSTEM(sv_a)
				PRINT(sv_b)
				
				sv_x = "babx4040 ${B2K_SESSION_ID} ${FIN_REPORTS_DIR}/"+ BANCS.STDIN.userId + "/"+ CUST.LADISB.failFile +' '+'"'+" Payoff Error Report "+'"'+" MANAGER 1 N"
				PRINT(sv_x)
				sv_h = SYSTEM (sv_x)
				PRINT(sv_h)
			#}
			ENDIF
			
			EXITSCRIPT
		#}
		ENDIF
		
		
		
		#---------------------------------------------------------------------------------
		# Checking if report file is of zero bytes
		#---------------------------------------------------------------------------------
		sv_a = "test -s " + CUST.LADISB.sucsFile
		sv_b = SYSTEM(sv_a)
		PRINT(sv_b)
		
		#---------------------------------------------------------------------------------
		# Moving the File to  HPR menu
		#---------------------------------------------------------------------------------
		IF (sv_b == 0)THEN
		#{
			sv_a = "cp " + CUST.LADISB.sucsFile + " ${FIN_REPORTS_DIR}/" + BANCS.STDIN.userId + "/" + CUST.LADISB.sucsFile
			PRINT(sv_a)
			sv_b = SYSTEM(sv_a)
			PRINT(sv_b)
			
			sv_x = "babx4040 ${B2K_SESSION_ID} ${FIN_REPORTS_DIR}/"+ BANCS.STDIN.userId + "/"+ CUST.LADISB.sucsFile +' '+'"'+" Payoff Success Report "+'"'+" MANAGER 1 N"
			PRINT(sv_x)
			sv_h = SYSTEM (sv_x)
			PRINT(sv_h)
		#}
		ENDIF
		
		EXITSCRIPT
