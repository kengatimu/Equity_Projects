<--START
CHECKSUM="f5619afeaa858cc6a39719a4d58452040922f03d6a1faf11146bf3516766a934"
	TRACE ON
	#==========================================================
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CUDDS") == 0) THEN
	#{
		CREATECLASS("CUST", "CUDDS", 5)
	#}
	ENDIF
	
	CUST.CUDDS.errMsg = ""
	BANCS.INPUT.moduleName="CLEARING"
