<--START 
TRACE ON

#------------------------------------------------------------------------------
# Creating repository and class
#------------------------------------------------------------------------------
IF(REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF(CLASSEXISTS("CUST","GCHRG") == 0) THEN
#{
	CREATECLASS("CUST","GCHRG",5)
#}
ENDIF

IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
#{
   	CREATECLASS("CUST","CPARAM", 5)
#}
ENDIF

#------------------------------------------------------------------------------
#Getting CSHDCHR_BACID values from CPARAM
#------------------------------------------------------------------------------
BANCS.INPUT.moduleName  = "CSHD_CHRGS"
BANCS.INPUT.parameterId = "JNR_MBR" 
CALL ("getcparamvalue.scr") 
IF(BANCS.OUTPUT.parameterVal != "")THEN 
#{ 
	CUST.CPARAM.schmCode = BANCS.OUTPUT.parameterVal 
	print(CUST.CPARAM.schmCode)
#} 
ELSE
#{
	CUST.CSHDCHR.errMsg = "CPARAM setup not done for Scheme Code "
	GOTO ENDOFSCRIPT 
#}
ENDIF

BANCS.INPUT.parameterId = "WITH_PERIOD" 
CALL ("getcparamvalue.scr") 
IF(BANCS.OUTPUT.parameterVal != "")THEN 
#{ 
	CUST.CPARAM.period = BANCS.OUTPUT.parameterVal 
	print(CUST.CPARAM.period)
#} 
ELSE
#{
	CUST.CSHDCHR.errMsg = "CPARAM setup not done for Period "
	GOTO ENDOFSCRIPT 
#}
ENDIF

BANCS.INPUT.parameterId = "WITH_AMT1" 
CALL ("getcparamvalue.scr") 
IF(BANCS.OUTPUT.parameterVal != "")THEN 
#{ 
	CUST.CPARAM.withamt1 = BANCS.OUTPUT.parameterVal 
	print(CUST.CPARAM.withamt1)
#} 
ELSE
#{
	CUST.CSHDCHR.errMsg = "CPARAM setup not done for Withdrawal Charges "
	GOTO ENDOFSCRIPT 
#}
ENDIF

BANCS.INPUT.parameterId = "WITH_AMT2" 
CALL ("getcparamvalue.scr") 
IF(BANCS.OUTPUT.parameterVal != "")THEN 
#{ 
	CUST.CPARAM.withamt2 = BANCS.OUTPUT.parameterVal 
	print(CUST.CPARAM.withamt2)
#} 
ELSE
#{
	CUST.CSHDCHR.errMsg = "CPARAM setup not done for Intersol Withdrawal Charges "
	GOTO ENDOFSCRIPT 
#}
ENDIF

BANCS.INPUT.parameterId = "DEPCHRG" 
CALL ("getcparamvalue.scr") 
IF(BANCS.OUTPUT.parameterVal != "")THEN 
#{ 
	CUST.CPARAM.depchrg = BANCS.OUTPUT.parameterVal 
	print(CUST.CPARAM.depchrg)
#} 
ELSE
#{
	CUST.CSHDCHR.errMsg = "CPARAM setup not done for Deposit Charge Event Id "
	GOTO ENDOFSCRIPT 
#}
ENDIF

BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_a = "currentDate|"
sv_a = sv_a + "select to_char(DB_STAT_DATE,'DD-Mon-YYYY') from tbaadm.gct where bank_id = ?SVAR"
print(sv_a)

sv_w = urhk_dbSelectWithBind(sv_a)
PRINT(sv_w)

IF (sv_w == 0) THEN 
#{ 
	CUST.CPARAM.currentDate = BANCS.OUTPARAM.currentDate
	print(CUST.CPARAM.currentDate)
#}
ENDIF

sv_s = " foracid,solId|"
sv_s = sv_s + " SELECT" 
sv_s = sv_s + " distinct GAM.foracid,gam.sol_id "
sv_s = sv_s + " FROM tbaadm.DTD, tbaadm.GAM  "
sv_s = sv_s + " WHERE DTD.DTH_INIT_SOL_ID = ?SVAR " 
sv_s = sv_s + " AND GAM.acid=DTD.acid "
sv_s = sv_s + " AND GAM.bank_id = DTD.bank_id" 
sv_s = sv_s + " AND GAM.acct_ownership='C' "
sv_s = sv_s + " AND GAM.del_flg='N' "
sv_s = sv_s + " AND GAM.acct_cls_flg='N' "
sv_s = sv_s + " AND GAM.schm_code=?SVAR "  
sv_s = sv_s + " AND GAM.acct_crncy_code=?SVAR " 
sv_s = sv_s + " AND GAM.bank_id = ?SVAR"  
sv_s = sv_s + " AND DTD.tran_type = 'C' "      
sv_s = sv_s + " AND DTD.tran_sub_type = 'NP' "  
sv_s = sv_s + " AND DTD.part_tran_type='D' "
sv_s = sv_s + " AND DTD.PSTD_FLG='Y' "
sv_s = sv_s + " AND DTD.del_flg='N' "
sv_s = sv_s + " AND DTD.TRAN_DATE =?SVAR"
print(sv_s)

BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" 
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.schmCode + "|" 
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.homeCrncyCode + "|"
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.currentDate
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_s)

IF(sv_e==0) THEN
	    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	    sv_q = urhk_dbCursorFetch(sv_m)
	    print(sv_q)

	   IF(sv_q == 1) THEN
		 sv_x = urhk_dbCursorClose(sv_m)
		 print(sv_x)
		 exitscript
	   ENDIF
	  print(sv_q)

	WHILE (sv_q==0)
	#{
		CUST.CPARAM.foracid = BANCS.OUTPARAM.foracid
		print(CUST.CPARAM.foracid)
		CUST.CPARAM.solId = BANCS.OUTPARAM.solId
		print(CUST.CPARAM.solId)

		sv_g = "lastTranDate|"
		sv_g = sv_g + "select to_char(a.tran_date, 'dd-mon-yyyy') from "
		sv_g = sv_g + "(select distinct tran_date from tbaadm.htd "
		sv_g = sv_g + "where acid in (select acid from tbaadm.gam where foracid = ?SVAR) "
		sv_g = sv_g + "and part_tran_type = 'D' "
		sv_g = sv_g + "AND HTD.tran_type = 'C' "
		sv_g = sv_g + "AND HTD.tran_sub_type = 'NP' "
		sv_g = sv_g + "and tran_date != ?SVAR "
		sv_g = sv_g + "order by  TRAN_DATE  desc)a where rownum < 2"
		print(sv_g)

		BANCS.INPARAM.BINDVARS = CUST.CPARAM.foracid + "|" + CUST.CPARAM.currentDate
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_g)
		PRINT(sv_d)

		IF (sv_d == 0) THEN 
		#{ 
			CUST.CPARAM.lastTranDate = BANCS.OUTPARAM.lastTranDate
			print(CUST.CPARAM.lastTranDate)
		#}
		ELSE
		#{
			CUST.CPARAM.lastTranDate = CUST.CPARAM.currentDate
			print(CUST.CPARAM.lastTranDate)
		#}
		ENDIF

		sv_h = "noOfDays |SELECT TO_date(?SVAR, 'dd/mm/yyyy') - TO_date(?SVAR, 'dd/mm/yyyy') DAYS FROM DUAL "
		BANCS.INPARAM.BINDVARS = CUST.CPARAM.currentDate + "|" + CUST.CPARAM.lastTranDate
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_h)
		PRINT(sv_b)

		IF (sv_b == 0) THEN 
		#{ 
			CUST.CPARAM.noOfDays = BANCS.OUTPARAM.noOfDays
			print(CUST.CPARAM.noOfDays)
			sv_a = CUST.CPARAM.period
		#}
		ENDIF
		IF ((cdouble(CUST.CPARAM.noOfDays) < cdouble(sv_a)) AND (CUST.CPARAM.lastTranDate != CUST.CPARAM.currentDate))  THEN
		#{
		
				sv_s = " count1|"
				sv_s = sv_s + "select count(*) from tbaadm.dtd, tbaadm.gam "
				sv_s = sv_s + "where dtd.acid = gam.acid and gam.foracid = ?SVAR "
				sv_s = sv_s + "and part_tran_type = 'D' "
				sv_s = sv_s + "and tran_date = ?SVAR "
				sv_s = sv_s + "and TRAN_TYPE = 'C' and  TRAN_SUB_TYPE = 'NP' "
				sv_s = sv_s + "and DTH_INIT_SOL_ID = ?SVAR "
				print(sv_s)

				BANCS.INPARAM.BINDVARS = CUST.CPARAM.foracid + "|" + CUST.CPARAM.currentDate + "|" + CUST.CPARAM.solId
				print(BANCS.INPARAM.BINDVARS)

				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)

				IF(sv_d==0) THEN
					    
					CUST.CPARAM.count1 = BANCS.OUTPARAM.count1
					print(CUST.CPARAM.count1)
					sv_d = CUST.CPARAM.withamt1
					CUST.CPARAM.chargeAmt1 = cint(sv_d) * cint(CUST.CPARAM.count1)
					print(CUST.CPARAM.chargeAmt1)
				#}
				ENDIF
				
				sv_s = " count2|"
				sv_s = sv_s + "select count(*) from tbaadm.dtd, tbaadm.gam "
				sv_s = sv_s + "where dtd.acid = gam.acid and gam.foracid = ?SVAR "
				sv_s = sv_s + "and part_tran_type = 'D' "
				sv_s = sv_s + "and tran_date =?SVAR "
				sv_s = sv_s + "and TRAN_TYPE = 'C' and  TRAN_SUB_TYPE = 'NP' "
				sv_s = sv_s + "and DTH_INIT_SOL_ID != ?SVAR "
				print(sv_s)

				BANCS.INPARAM.BINDVARS = CUST.CPARAM.foracid + "|" + CUST.CPARAM.currentDate + "|" + CUST.CPARAM.solId
				print(BANCS.INPARAM.BINDVARS)

				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)

				IF(sv_d==0) THEN
					    
					CUST.CPARAM.count2 = BANCS.OUTPARAM.count2
					print(CUST.CPARAM.count2)
					sv_d = CUST.CPARAM.withamt2
					CUST.CPARAM.chargeAmt2 = cint(sv_d) * cint(CUST.CPARAM.count2)
					print(CUST.CPARAM.chargeAmt2)
				#}
				ENDIF
					CUST.CPARAM.chargeAmt = cint(CUST.CPARAM.chargeAmt1) + cint(CUST.CPARAM.chargeAmt2)
					print(CUST.CPARAM.chargeAmt)

					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CUST.CPARAM.foracid
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CUST.CPARAM.chargeAmt + "|" + BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.eventId = CUST.CPARAM.depchrg
					
					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
					#}
					ELSE
					#{
						PRINT("Failure")
					#}
					ENDIF		
		#}
		ENDIF
		
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
	#}
	DO
#}
ENDIF


EXITSCRIPT
END-->
