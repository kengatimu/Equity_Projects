		IF(CUST.CIECLG.targetSolId == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Target Sol Id is not set in CPARAM^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(sv_i > 1)THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.CIECLG.creditEntity == CUST.CIECLG.instrumentEntity) AND (CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId))THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_1|Error^Both Credit Account ID AND Instrument belong to Init Entity. Please use HOCTM menu^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.CIECLG.creditEntity != BANCS.STDIN.contextBankId) AND (CUST.CIECLG.instrumentEntity != BANCS.STDIN.contextBankId))THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_1|Error^Either Credit Account Entity OR Instrument Entity should be Init Entity^creditEntity"
			sv_u = urhk_SetOrbOut(sv_s)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		######################################################################################
		# Clearing Amount Limit Check
		######################################################################################
		
		CUST.CIECLG.scriptSuccess = "Y"
		
		CALL("cieclgdp005.scr")
		
		IF(CUST.CIECLG.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		######################################################################################
		# Get Bank Id, Branch Id, Sort Code from CPARAM
		######################################################################################
		
		IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIECLG.parameterId = "DEFAULT_BANK_CODE_" + CUST.CIECLG.creditEntity
			#}
		ELSE
			#{
			CUST.CIECLG.parameterId = "DEFAULT_BANK_CODE_" + CUST.CIECLG.instrumentEntity
		#}
		ENDIF
		
		print(CUST.CIECLG.parameterId)
		
		sv_s = "defaultBankCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_1|Error^Bank Code to lodge instrument in " + CUST.CIECLG.creditEntity + " is not set in CPARAM^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIECLG.defaultBankCode = BANCS.OUTPARAM.defaultBankCode
		print(CUST.CIECLG.defaultBankCode)
		
		IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIECLG.parameterId = "DEFAULT_BRANCH_CODE_" + CUST.CIECLG.creditEntity
			#}
		ELSE
			#{
			CUST.CIECLG.parameterId = "DEFAULT_BRANCH_CODE_" + CUST.CIECLG.instrumentEntity
		#}
		ENDIF
		
		print(CUST.CIECLG.parameterId)
		
		sv_s = "defaultBranchCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_1|Error^Branch Code to lodge instrument in " + CUST.CIECLG.creditEntity + " is not set in CPARAM^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIECLG.defaultBranchCode = BANCS.OUTPARAM.defaultBranchCode
		print(CUST.CIECLG.defaultBranchCode)
		
		CUST.CIECLG.defaultSortCode = "100200300"
		
		######################################################################################
		# Check if the Instrument Bank Code is an Equity Bank Code
		######################################################################################
		
		CUST.CIECLG.scriptSuccess = "Y"
		
		CALL("cieclgdp037.scr")
		
		IF(CUST.CIECLG.scriptSuccess == "Y")THEN
		#{
			#----------------------------------------------------------------------------------------
			# Instrument Bank Code is an Equity Bank Code.
			# Payee Account Validation Done in cieclgdp037.scr
			#----------------------------------------------------------------------------------------
			
			IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
			#{
				GOTO LODGE_CURRENT_ENTITY
				#}
			ELSE
				#{
				sv_s = "recordCount|SELECT TO_CHAR((COUNT(*)+ 1)) FROM CUSTOM.IECD"
				sv_s = sv_s + " WHERE ZONE_CODE = ?SVAR"
				sv_s = sv_s + " AND ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
				sv_s = sv_s + " AND SOL_ID = ?SVAR"
				sv_s = sv_s + " AND BANK_ID = ?SVAR"
				print(sv_s)
				
				BANCS.INPARAM.BINDVARS = CUST.CIECLG.zoneCode + "|" + CUST.CIECLG.zoneDate + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				
				IF(sv_d == 0)THEN
				#{
					PRINT(BANCS.OUTPARAM.recordCount)
					CUST.CIECLG.setNum = "D" + BANCS.OUTPARAM.recordCount
					PRINT(CUST.CIECLG.setNum)
					#}
				ELSE
					#{
					CUST.CIECLG.setNum = "D1"
				#}
				ENDIF
				
				CUST.CIECLG.setNum = LPAD(CUST.CIECLG.setNum,6)
				PRINT(CUST.CIECLG.setNum)
				
				GOTO INSERT_IECD
			#}
			ENDIF
			
			
		#}
		ENDIF
		
		######################################################################################
		# Lodge Instrument in Current Entity
		######################################################################################
		
		LODGE_CURRENT_ENTITY:
			
			CUST.CIECLG.scriptSuccess = "Y"
			
			CALL("cieclgdp003.scr")
			
			IF(CUST.CIECLG.scriptSuccess == "N")THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			
			######################################################################################
			# Insert data into the IECD Custom Table
			######################################################################################
			
		INSERT_IECD:
			
			######################################################################################
			# UBP customization Insert Data into C_UBP table--start
			######################################################################################
			CUST.CIECLG.scriptSuccess = "Y"
			IF(FIELDEXISTS(CUST.CIECLG.billPayYes) == 1)THEN
			#{
				IF(CUST.CIECLG.billPayYes=="Y")THEN
				#{
					call("ubpdp069.scr")
					IF(CUST.CIECLG.scriptSuccess == "N")THEN
					#{
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			
			######################################################################################
			# UBP customization Insert Data into C_UBP table--end
			######################################################################################
			
			CUST.CIECLG.scriptSuccess = "Y"
			
			CALL("cieclgdp012.scr")
			
			IF(CUST.CIECLG.scriptSuccess == "N")THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			######################################################################################
			# Result Message
			######################################################################################
			
			sv_s = "RESULT_MSG|Instrument Lodged in Init Entity Successfully"
			sv_s = sv_s + "!" + CUST.CIECLG.funcCode + "!" + CUST.CIECLG.zoneCode + "!" + CUST.CIECLG.zoneDate + "!" + BANCS.STDIN.mySolId + "!" + CUST.CIECLG.setNum
			sv_s = sv_s + "!" + CUST.CIECLG.targetZoneCode + "!" + CUST.CIECLG.targetZoneDate + "!" + CUST.CIECLG.targetSolId + "!" + CUST.CIECLG.targetSetNum
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			print(sv_u)
			
		ENDOFSCRIPT:
	END-->
	
	
	
