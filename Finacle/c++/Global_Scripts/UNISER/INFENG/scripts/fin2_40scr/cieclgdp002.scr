			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Charge Event Id is not set in CPARAM^crAcctNum"
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIECLG.nostroAcct == "")THEN
		#{
