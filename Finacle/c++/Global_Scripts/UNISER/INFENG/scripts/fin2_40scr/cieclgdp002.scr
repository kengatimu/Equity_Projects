		######################################################################################
		# Validation for Input Fields
		######################################################################################
		sv_i = 0
		
		IF(CUST.CIECLG.crAcctNum == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Credit Account Id is blank^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIECLG.crAcctNumEntityId == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Invalid Credit Account ID^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIECLG.crAcctNumEntityId != CUST.CIECLG.creditEntity)THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Credit Account Entity ID AND Entered Entity ID mismatch^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIECLG.chargeEventId == "")THEN
		#{
