#===============================================================
# IMPORTANT: Auto Generated Header. DO NOT CHANGE MANUALLY.
# category: Script Name Based
# script: CreateReversalTran.scr
# event: NA
# description: CreateReversalTran
#===============================================================
#----------------------------------------------------------------------------
#       SCRIPT FOR CREATING AND REVERSING TRANSACTIONS.(CRT Menu Option)
#
# Srl No     Modified Date     Author          Modification    Version
# ------     -------------    -------         --------------   --------
#   1        06/03/2001       Anupk            Original         1.0
#----------------------------------------------------------------------------
#
<--start
trace on
# The fields for transaction details are TranDate,TranType,TranSubtype
# transaction remarks.
#
sv_a = urhk_MTTS_PopulateInputDetails("")
if (sv_a == 1) then
	exitscript
endif

#sv_r = urhk_B2k_PrintRepos("MTT")

sv_m=MID$(LTRIM(MTT.InputDetails.RefTranId), 0,1)
#print (sv_m)
if(sv_m =="S") then
		MTT.Error.Description="Reversal is not allowed for SYSTEM Generated Transaction"
		sv_r = urhk_MTTS_ReportErrorCondition("")
		BANCS.OUTPUT.successOrFailure="F"
		goto ENDOFSCRIPT
endif
MTT.TranDetails.TranDate="0" 

if (MTT.InputDetails.TranType == "C") then
	MTT.TranDetails.TranType = MTT.InputDetails.TranType
	if (MTT.InputDetails.TranSubType == "NP") then
		MTT.TranDetails.TranSubType = "NR"
	else
		if (MTT.InputDetails.TranSubType == "NR") then
			MTT.TranDetails.TranSubType = "NP"
		else
			sv_c = cdouble(MTT.InputDetails.RefAmount)
			if (sv_c < 0) then
				MTT.TranDetails.TranSubType = "CR"
			else
				MTT.TranDetails.TranSubType = "CP"		
			endif
		endif
	endif
else
	MTT.TranDetails.TranType = MTT.InputDetails.TranType
	MTT.TranDetails.TranSubType = MTT.InputDetails.TranSubType
endif

MTT.TranDetails.Remarks="REVERSAL TRAN"
MTT.TranDetails.Remarks="Reversal " + MTT.InputDetails.RefTranId + "/" + MTT.InputDetails.RefTranDate
MTT.TranDetails.IgnoreExcp=""
MTT.TranDetails.Consolidate="Y"  
MTT.TranDetails.PrintAdviceInd="Y"
MTT.TranDetails.ReversalFlg=""
MTT.TranDetails.ReversalDate=""
MTT.TranDetails.sysTranCode = "CASAAA038"
if(MTT.TranDetails.PrintAdviceInd == "Y")THEN
	MTT.TranDetails.PrintAdviceInd="B"
ENDIF
sv_b = urhk_MTTS_DefineTransaction("Reversal")
if (sv_b == 1) then
	exitscript
ENDIF

MTT.TranDetails.TranDate="0" 
MTT.TranDetails.TranType = MTT.InputDetails.TranType
MTT.TranDetails.TranSubType = MTT.InputDetails.TranSubType
MTT.TranDetails.Remarks="Rectification of " + MTT.InputDetails.RefTranId + "/" + MTT.InputDetails.RefTranDate
MTT.TranDetails.IgnoreExcp=""
MTT.TranDetails.Consolidate="Y"  
MTT.TranDetails.PrintAdviceInd="Y"
MTT.TranDetails.ReversalFlg=""
MTT.TranDetails.ReversalDate=""
MTT.TranDetails.sysTranCode = "CASAAA011"
if(MTT.TranDetails.PrintAdviceInd == "Y")THEN
	MTT.TranDetails.PrintAdviceInd="B"
ENDIF
sv_b = urhk_MTTS_DefineTransaction("Rectification")
if (sv_b == 1) then
	exitscript
ENDIF
#
while(sv_a < 1)
	sv_t = -1 * CDOUBLE(MTT.InputDetails.RefAmount)
	MTT.PartTranDetails.Account=MTT.InputDetails.Account
	MTT.PartTranDetails.RefAmount=sv_t
	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.RefCurrency
	MTT.PartTranDetails.RateCode=MTT.InputDetails.RateCode
	MTT.PartTranDetails.Rate=MTT.InputDetails.Rate
	MTT.PartTranDetails.Remarks=MTT.InputDetails.Remarks
	MTT.PartTranDetails.TreaRate=MTT.InputDetails.TreaRate
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDateDiff
	MTT.PartTranDetails.ReportCode=MTT.InputDetails.ReportCode
	sv_s = "REVERSED : "+MTT.InputDetails.Particulars + MTT.InputDetails.ReasonCode
	sv_l = strlen(sv_s)
	if (sv_l > 50) then
		MTT.PartTranDetails.Particulars=left$(sv_s,49)
	else
		MTT.PartTranDetails.Particulars=sv_s
	endif

	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "REVTR"
	sv_r = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	if (sv_r == 0) then
		call("getMTTTranPart.scr")
	endif
	
	MTT.PartTranDetails.Consolidate="N"
	MTT.PartTranDetails.TranIdentifier="Reversal"
	MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.AcPartB2kId
	MTT.PartTranDetails.ACPARTB2kType=MTT.InputDetails.B2kType
	MTT.PartTranDetails.PTranBusinessType="CRT"
	MTT.PartTranDetails.RefTranId=MTT.InputDetails.RefTranId
	MTT.PartTranDetails.RefTranDate=MTT.InputDetails.RefTranDate
	MTT.PartTranDetails.RefPtranSrlNum=MTT.InputDetails.RefPtranSrlNum
	MTT.PartTranDetails.RefInputKey=MTT.InputDetails.RefInputKey
	MTT.PartTranDetails.Refnum=""
	if (CDOUBLE(MTT.PartTranDetails.RefAmount) > 0) then
		MTT.PartTranDetails.sysPartTranCode = "PTRN03040"
	else
		MTT.PartTranDetails.sysPartTranCode = "PTRN00093"
	endif

	if (fieldexists(BANCS.INPUT.EntryRevUserId) AND fieldexists(BANCS.INPUT.EntryRevDate)) then 
	#{ 
		MTT.PartTranDetails.EntryUserId=BANCS.INPUT.EntryRevUserId 
		MTT.PartTranDetails.EntryTime=BANCS.INPUT.EntryRevDate 
	#} 
	endif 

	sv_r = urhk_MTTS_DefinePartTran("REVERSAL")
	if (sv_r == 1) then
		BANCS.OUTPUT.successOrFailure = "F"
		goto ENDOFSCRIPT
	endif

	if (MTT.InputDetails.TranType == "C") then
		MTT.PartTranDetails.Account=MTT.InputDetails.CashAccount
		MTT.PartTranDetails.RefAmount=MTT.InputDetails.RefAmount
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.RefCurrency
		MTT.PartTranDetails.RateCode=MTT.InputDetails.RateCode
		MTT.PartTranDetails.Rate=MTT.InputDetails.Rate
		MTT.PartTranDetails.Remarks=MTT.InputDetails.Remarks
		MTT.PartTranDetails.TreaRate=MTT.InputDetails.TreaRate
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDateDiff
		MTT.PartTranDetails.Particulars=MTT.InputDetails.Particulars

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "REVTR"
		sv_r = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_r == 0) then
			call("getMTTTranPart.scr")
		endif
		
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="Reversal"
		MTT.PartTranDetails.ACPARTB2kId=""
		MTT.PartTranDetails.ACPARTB2kType=""
		MTT.PartTranDetails.PTranBusinessType="CRT"
		MTT.PartTranDetails.RefTranId=""
		MTT.PartTranDetails.RefTranDate=""
		MTT.PartTranDetails.RefPtranSrlNum=""
		MTT.PartTranDetails.RefInputKey=MTT.InputDetails.RefInputKey
		MTT.PartTranDetails.Refnum=""
		if (CDOUBLE(MTT.PartTranDetails.RefAmount) > 0) then
			MTT.PartTranDetails.sysPartTranCode = "PTRN03041"
		else
			MTT.PartTranDetails.sysPartTranCode = "PTRN00094"
		endif

		if (fieldexists(BANCS.INPUT.EntryRevUserId) AND fieldexists(BANCS.INPUT.EntryRevDate)) then 
		#{ 
			MTT.PartTranDetails.EntryUserId=BANCS.INPUT.EntryRevUserId 
			MTT.PartTranDetails.EntryTime=BANCS.INPUT.EntryRevDate 
		#} 
		endif 

		sv_r = urhk_MTTS_DefinePartTran("CASHREV")
		if (sv_r == 1) then
			BANCS.OUTPUT.successOrFailure = "F"
			goto ENDOFSCRIPT
		endif
	endif


	if (MTT.InputDetails.RectificationAccount != "") then
		MTT.PartTranDetails.Account=MTT.InputDetails.RectificationAccount
		MTT.PartTranDetails.RefAmount=MTT.InputDetails.RefAmount
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.RefCurrency
		MTT.PartTranDetails.RateCode=MTT.InputDetails.RateCode
		MTT.PartTranDetails.Rate=MTT.InputDetails.Rate
		MTT.PartTranDetails.Remarks=MTT.InputDetails.Remarks
		MTT.PartTranDetails.TreaRate=MTT.InputDetails.TreaRate
		MTT.PartTranDetails.InstrmntType=MTT.InputDetails.InstrmntType
		MTT.PartTranDetails.InstrmntDate=MTT.InputDetails.InstrmntDate
		MTT.PartTranDetails.InstrmntNum=MTT.InputDetails.InstrmntNum
		MTT.PartTranDetails.InstrmntAlpha=MTT.InputDetails.InstrmntAlpha
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDateDiff
		MTT.PartTranDetails.Particulars=MTT.InputDetails.Particulars

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "REVTR"
		sv_r = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_r == 0) then
			call("getMTTTranPart.scr")
		endif
		
		MTT.PartTranDetails.Consolidate="N"
		if ((MTT.InputDetails.SingleTran=="Y") and (MTT.InputDetails.TranType != "C")) then
			if (CDOUBLE(MTT.PartTranDetails.RefAmount) > 0) then
				MTT.PartTranDetails.sysPartTranCode = "PTRN03047"
			else
				MTT.PartTranDetails.sysPartTranCode = "PTRN01737"
			endif
			MTT.PartTranDetails.TranIdentifier="Reversal"
		else
			if (CDOUBLE(MTT.PartTranDetails.RefAmount) > 0) then
				MTT.PartTranDetails.sysPartTranCode = "PTRN00095"
			else
				MTT.PartTranDetails.sysPartTranCode = "PTRN03048"
			endif
			MTT.PartTranDetails.TranIdentifier="Rectification"
		endif
		MTT.PartTranDetails.ACPARTB2kId=""
		MTT.PartTranDetails.ACPARTB2kType=""
		MTT.PartTranDetails.PTranBusinessType="CRT"
		MTT.PartTranDetails.RefTranId=""
		MTT.PartTranDetails.RefTranDate=""
		MTT.PartTranDetails.RefPtranSrlNum=""
		MTT.PartTranDetails.RefInputKey=MTT.InputDetails.RefInputKey
		MTT.PartTranDetails.Refnum=""
		if (fieldexists(BANCS.INPUT.EntryRevUserId) AND fieldexists(BANCS.INPUT.EntryRevDate)) then 
        #{ 
			MTT.PartTranDetails.EntryUserId=BANCS.INPUT.EntryRevUserId 
			MTT.PartTranDetails.EntryTime=BANCS.INPUT.EntryRevDate 
		#} 
		endif 

		sv_r = urhk_MTTS_DefinePartTran("RECTIFY")
		if (sv_r == 1) then
			BANCS.OUTPUT.successOrFailure = "F"
			goto ENDOFSCRIPT
		endif

		if (MTT.InputDetails.TranType == "C") then
			MTT.PartTranDetails.Account=MTT.InputDetails.CashAccount
			MTT.PartTranDetails.RefAmount=sv_t
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.RefCurrency
			MTT.PartTranDetails.RateCode=MTT.InputDetails.RateCode
			MTT.PartTranDetails.Rate=MTT.InputDetails.Rate
			MTT.PartTranDetails.TreaRate=MTT.InputDetails.TreaRate
			MTT.PartTranDetails.Remarks=MTT.InputDetails.Remarks
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDateDiff
			MTT.PartTranDetails.Particulars=MTT.InputDetails.Particulars

			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "REVTR"
			sv_r = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			if (sv_r == 0) then
				call("getMTTTranPart.scr")
			endif
			
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="Rectification"
			MTT.PartTranDetails.ACPARTB2kId=""
			MTT.PartTranDetails.ACPARTB2kType=""
			MTT.PartTranDetails.PTranBusinessType="CRT"
			MTT.PartTranDetails.RefTranId=""
			MTT.PartTranDetails.RefTranDate=""
			MTT.PartTranDetails.RefPtranSrlNum=""
			MTT.PartTranDetails.RefInputKey=MTT.InputDetails.RefInputKey
			MTT.PartTranDetails.Refnum=""
			if (CDOUBLE(MTT.PartTranDetails.RefAmount) > 0) then
				MTT.PartTranDetails.sysPartTranCode = "PTRN03042"
			else
				MTT.PartTranDetails.sysPartTranCode = "PTRN00096"
			endif

			if (fieldexists(BANCS.INPUT.EntryRevUserId) AND fieldexists(BANCS.INPUT.EntryRevDate)) then 
			#{ 
				MTT.PartTranDetails.EntryUserId=BANCS.INPUT.EntryRevUserId 
				MTT.PartTranDetails.EntryTime=BANCS.INPUT.EntryRevDate 
			#} 
			endif 

			sv_r = urhk_MTTS_DefinePartTran("CASHREC")
			if (sv_r == 1) then
				BANCS.OUTPUT.successOrFailure = "F"
				goto ENDOFSCRIPT
			endif
		endif
	endif
	sv_a = urhk_MTTS_PopulateInputDetails("")
do

sv_r = urhk_MTTS_EndDefinition("")

ENDOFSCRIPT:
#trace off
exitscript
end-->

