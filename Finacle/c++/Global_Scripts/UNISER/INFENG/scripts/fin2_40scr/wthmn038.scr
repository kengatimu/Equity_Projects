	PRINT(CUST.WITHTAX.crAccount)
	
	
	CUST.WITHTAX.tranAmt	=	CDOUBLE(CUST.WITHTAX.tranAmt) * CDOUBLE(CUST.WITHTAX.wthTaxPer)/100
	PRINT(CUST.WITHTAX.tranAmt)
	#------------------------------------------------------------------------------------------------
	# Rounding Off the amount to nearest five cents
	#------------------------------------------------------------------------------------------------
	BANCS.INPARAM.InputAmount	=	CUST.WITHTAX.tranAmt
	BANCS.INPARAM.RoundOffAmt=.05
	BANCS.INPARAM.RoundOffFlag="N"
