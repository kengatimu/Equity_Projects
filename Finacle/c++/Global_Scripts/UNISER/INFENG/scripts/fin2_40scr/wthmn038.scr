	#{
		CUST.WITHTAX.tranAmt = BANCS.OUTPARAM.OutputAmount
	#}
	ENDIF
	CUST.WITHTAX.tranAmt = FORMAT$(CDOUBLE(CUST.WITHTAX.tranAmt),"%.2f")
	PRINT(CUST.WITHTAX.tranAmt)
	
	#################################################################
	# Credit and Debit transactions
	#################################################################
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.key.serial_num|3")
	PRINT(sv_a)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.pTranIdentifier.tranDate|"+CUST.DATA.TranDate)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.glDate|"+CUST.DATA.TranDate)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.valueDate|"+ CUST.DATA.ValueDate)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.pTranIdentifier.partTranSrlNum|"+ LPAD("3",4,' '))
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.partTranType.code|D")
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.refCrncyCode.crncyCode|" + CUST.DATA.crncyCode)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.entryUserId.userId|SYSTEM")
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.pstdUserId.userId|SYSTEM")
	CUST.DATA.CurrAmt = CUST.WITHTAX.tranAmt + "|" + CUST.DATA.crncyCode
	PRINT(CUST.DATA.CurrAmt)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.refAmt|"+CUST.DATA.CurrAmt)
	PRINT(CUST.DATA.debitAccount)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.acctId.foracid|"+CUST.WITHTAX.drAccount)
	PRINT(sv_a)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.tranParticulars|Withholding tax ON Profit paid")
	PRINT(sv_a)
	
	##### credit transaction ####
	
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.tranParticulars|Withholding tax ON Profit paid")
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.key.serial_num|4")
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.pTranIdentifier.tranDate|"+CUST.DATA.TranDate)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.glDate|"+CUST.DATA.TranDate)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.valueDate|"+ CUST.DATA.ValueDate)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.pTranIdentifier.partTranSrlNum|"+ LPAD("4",4,' '))
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.partTranType.code|C")
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.refCrncyCode.crncyCode|" + CUST.DATA.crncyCode)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.acctId.crncyCode|" + CUST.DATA.crncyCode)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.entryUserId.userId|SYSTEM")
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.pstdUserId.userId|SYSTEM")
	CUST.DATA.CurrAmt = CUST.WITHTAX.tranAmt + "|" + CUST.DATA.crncyCode
	PRINT(CUST.DATA.CurrAmt)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.refAmt|"+CUST.DATA.CurrAmt)
	PRINT(CUST.DATA.creditAccount)
	sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.acctId.foracid|" + CUST.WITHTAX.crAccount)
	PRINT(sv_a)
	
	
