	IF(CUST.WITHTAX.withdTaxAppFlg != "Y") THEN
	#{
		GOTO ENDOFSCRIPTWTH
	#}
	ENDIF
	
	#################################################################
	# Getting value for "WTH_TAX_APP_FLG" set at scheme level
	#################################################################
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = CUST.WITHTAX.wthFlgChkAcct + "|" + BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.contextBankId + "|" + CUST.WITHTAX.delFlg+ "|" + CUST.WITHTAX.entityFlg
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "placeHolder,wthTaxPer|SELECT BACID,WTH_TAX_PCNT"
	sv_s = sv_s + " FROM CUSTOM.C_WTH_GSP_DET"
	sv_s = sv_s + " WHERE SCHM_CODE = ( SELECT SCHM_CODE FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR)"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG,'N') = ?SVAR"
	sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG,'N')= ?SVAR "
	
	PRINT(sv_s)
	sv_v = urhk_dbselectWithBind(sv_s)
