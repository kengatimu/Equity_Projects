<--start
trace on

CALL("Common_Interface_CreateRepos.scr")

sv_s=" nationalid, lastname, dateofbirth,datec,monthc,yearc, |"
sv_s = sv_s + " SELECT CORP_REP_KEY  nationalid,  LAST_NAME lastname ,DOB dateofbirth ,substr (to_char((to_date(DOB,'DD-MM-RRRR')),'DD-MM-RRRR'),0,2) as datec, "
sv_s = sv_s + " substr (to_char((to_date(DOB,'DD-MM-RRRR')),'DD-MM-RRRR'),4,2) as monthc,substr (to_char((to_date(DOB,'DD-MM-RRRR')),'DD-MM-RRRR'),7,4) as yearc "
sv_s = sv_s + " FROM CUSTOM.BCDC_COPRE_RELATED_MIG2  "
sv_s = sv_s + " WHERE STATUS='N' "
#sv_s = sv_s + " AND sol_id= ?SVAR"
sv_s = sv_s + " AND bank_id = ?SVAR "
print(sv_s)
#BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId 
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)

sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c==0) then
#{

	CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
	print(sv_k)

WHILE (sv_k == 0)
#{

CUST.INTERFACE.interfaceRequestID = "createProspectCustomerForRetail"
CUST.INTERFACE.interfaceRequestVersion = "10.2"
