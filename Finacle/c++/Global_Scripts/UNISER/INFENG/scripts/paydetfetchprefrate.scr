
<--START
	TRACE ON
	###############################
	#creating class and repository
	###############################
	IF(REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","DATA")==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	sv_a = urhk_B2k_PrintRepos("BANCS")
	
	###############################
	#Initializing variables
	###############################
	
	CUST.DATA.custacc= ""	
	CUST.DATA.tranccy=""
	CUST.DATA.trearefcode= ""	
	CUST.DATA.remitamt= ""
	CUST.DATA.Acccy=""
	CUST.DATA.prefrate="0"
	CUST.DATA.cifid=""


	IF(FIELDEXISTS(BANCS.INPUT.custacc)) THEN
	#{
		IF(TRIM(BANCS.INPUT.custacc) != "")THEN
		#{
			CUST.DATA.custacc= TOUPPER(TRIM(BANCS.INPUT.custacc))
			PRINT(CUST.DATA.custacc)

		sv_a=urhk_getAcctDetailsInRepository(CUST.DATA.custacc)
		if(sv_a == "0") then

			CUST.DATA.Acccy =BANCS.OUTPARAM.acctCrncyCode
			CUST.DATA.cifid =BANCS.OUTPARAM.cifId

			CUST.DATA.SchmCode=BANCS.OUTPARAM.schmCode
			print(CUST.DATA.Acccy)
			print(CUST.DATA.cifid)
		endif



		#}
		ENDIF
		#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.tranccy)) THEN
	#{
		IF(TRIM(BANCS.INPUT.tranccy) != "")THEN
		#{
			CUST.DATA.tranccy= TOUPPER(TRIM(BANCS.INPUT.tranccy))
			PRINT(CUST.DATA.tranccy)
		#}
		ENDIF
		#}
	ENDIF

CUST.DATA.tranccy="CDF"

	IF(FIELDEXISTS(BANCS.INPUT.trearefcode)) THEN
	#{
		IF(TRIM(BANCS.INPUT.trearefcode) != "")THEN
		#{
			CUST.DATA.trearefcode= TOUPPER(TRIM(BANCS.INPUT.trearefcode))
			PRINT(CUST.DATA.trearefcode)
		#}
		ENDIF
		#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.remitamt)) THEN
	#{
		IF(TRIM(BANCS.INPUT.remitamt) != "")THEN
		#{
			CUST.DATA.remitamt= TOUPPER(TRIM(BANCS.INPUT.remitamt))
			PRINT(CUST.DATA.remitamt)
		#}
		ENDIF
		#}
	ENDIF

	sv_a= ""

	sv_a="prefrate|select cust_rate from tbaadm.FTRT where  "
	sv_a = sv_a + " ratecode= 'TTB'"
	sv_a = sv_a + " AND from_crncy_code =?SVAR "
	sv_a = sv_a + " AND to_crncy_code =?SVAR "
	sv_a = sv_a + " AND tr_ref_num =?SVAR "
	sv_a = sv_a + " AND ref_amt =?SVAR "
	sv_a = sv_a + " AND cif_id =?SVAR "
	sv_a = sv_a + " AND bank_id ='43' and rownum=1"

	PRINT(sv_a)
	BANCS.INPARAM.BINDVARS = CUST.DATA.Acccy + "|" + CUST.DATA.tranccy+ "|" + CUST.DATA.trearefcode+ "|" + CUST.DATA.remitamt+ "|" +CUST.DATA.cifid


	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_q = urhk_dbSelectWithBind(sv_a)
	IF(sv_q==0)THEN
	print(BANCS.OUTPARAM.prefrate)

	CUST.DATA.prefrate=BANCS.OUTPARAM.prefrate
	CUST.DATA.errFlg="N"
	CUST.DATA.errMsg=" "


	ELSE
	CUST.DATA.errFlg="Y"
	CUST.DATA.errMsg="No Preferential rate found"

	ENDIF


	sv_z=urhk_SetOrbOut(("errFlg"+"|"+CUST.DATA.errFlg))
	PRINT(sv_z)
	sv_z=urhk_SetOrbOut(("errMsg"+"|"+CUST.DATA.errMsg))
	PRINT(sv_z)
	sv_z=urhk_SetOrbOut(("prefrate"+"|"+CUST.DATA.prefrate))
	PRINT(sv_z)


	IF(CLASSEXISTS("CUST","DATA")!=0) THEN
	#{
		DELETECLASS("CUST","DATA")
	#}
	ENDIF
	IF(REPEXISTS("CUST")!=0) THEN
	#{
		DELETEREP("CUST")
	#}
	ENDIF
	TRACE OFF
	EXITSCRIPT
	
END-->











