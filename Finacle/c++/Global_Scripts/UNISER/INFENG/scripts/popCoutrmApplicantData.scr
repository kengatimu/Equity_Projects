		print(BANCS.GLBDATA.countryDesc)
		#}
	ELSE
		#{
		BANCS.GLBDATA.countryDesc = ""
	#}
	ENDIF
	
	
	sv_x = " "
	IF (BANCS.GLBDATA.name != "") THEN
	#{
		sv_u = urhk_SetOrbOut("cifName|" + BANCS.GLBDATA.name)
