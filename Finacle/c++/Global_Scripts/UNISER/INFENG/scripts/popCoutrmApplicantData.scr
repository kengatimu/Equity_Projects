	#{
		EXITSCRIPT
	#}
	ENDIF
	
	sv_s = "custId| SELECT CIF_ID FROM TBAADM.GAM WHERE FORACID = ?SVAR "
	sv_s = sv_s + " AND DEL_FLG!='Y'"
	sv_s = sv_s + " AND BANK_ID= ?SVAR"
	BANCS.INPARAM.BINDVARS = BANCS.GLBDATA.formNo + "|" + BANCS.GLBDATA.bankId
