		BANCS.GLBDATA.swift = BANCS.OUTPARAM.swift_code
		BANCS.GLBDATA.pinCode = BANCS.OUTPARAM.pin_code
		BANCS.GLBDATA.custTitle = BANCS.OUTPARAM.cust_title_code
		BANCS.GLBDATA.preferredaddress = BANCS.OUTPARAM.preferredaddress
		BANCS.GLBDATA.emailId = BANCS.OUTPARAM.email_id
		BANCS.GLBDATA.phoneNum = BANCS.OUTPARAM.phone_num1
		
		print(BANCS.GLBDATA.name)
		print(BANCS.GLBDATA.alt1_name)
		print(BANCS.GLBDATA.addr1)
		print(BANCS.GLBDATA.addr2)
		print(BANCS.GLBDATA.city)
		print(BANCS.GLBDATA.state)
		print(BANCS.GLBDATA.country)
		print(BANCS.GLBDATA.swift)
		print(BANCS.GLBDATA.pinCode)
		print(BANCS.GLBDATA.custTitle)
		print(BANCS.GLBDATA.preferredaddress)
		print(BANCS.GLBDATA.emailId)
		print(BANCS.GLBDATA.phoneNum)
		
		#}
	ELSE
		#{
		EXITSCRIPT
	#}
	ENDIF
	
	sv_s = "cityDesc| SELECT REF_DESC FROM tbaadm.rct where ref_rec_type = ?SVAR AND ref_code = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR"
	BANCS.INPARAM.BINDVARS = "01|" + BANCS.GLBDATA.city + "|" + BANCS.GLBDATA.bankId
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
