	ENDIF
	
	
	sv_s = "countryDesc| SELECT REF_DESC FROM tbaadm.rct where ref_rec_type = ?SVAR AND ref_code = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR"
	BANCS.INPARAM.BINDVARS = "03|" + BANCS.GLBDATA.country + "|" + BANCS.GLBDATA.bankId
