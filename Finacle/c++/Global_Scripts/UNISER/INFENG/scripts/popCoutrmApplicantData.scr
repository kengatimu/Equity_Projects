	sv_s = sv_s + "	swift_code,  pin_code,  cust_title_code,  preferredaddress,  email_id,  phone_num1  from TBAADM.CNMA where  bank_id = ?SVAR "
	sv_s = sv_s + "	AND  addr_b2kid =  ?SVAR  AND  PREFERREDADDRESS='Y' AND start_date=to_date(?SVAR,'DD-MM-YYYY')"
	PRINT(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.GLBDATA.bankId + "|" +BANCS.GLBDATA.custId + "|" + BANCS.GLBDATA.addStartDate
