		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_0>.partInstruction.fixedAmt|"+INDLOC.SSIM.fixedAmt+"|"+INDLOC.SSIM.CrncyCode)
		#sv_a = urhk_SetUrhkInp("partInstrLL.<rec_0>.prDetail.acct.foracid|"+INDLOC.SSIM.dracct)
		#TEST 
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_0>.prDetail.acct.foracid|"+INDLOC.SSIM.Dracno)
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_0>.prDetail.feeCollectFlg|N")
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_0>.prDetail.amtPcnt|0.000000")

		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.key.serial_num|2")
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.partInstruction.partTranType.code|C")
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.partInstruction.refCrncy.crncyCode|"+INDLOC.SSIM.CrCrncyCode)
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.partInstruction.amtInd.code|F")
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.partInstruction.createMpEntryFlg|N")
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.partInstruction.fixedAmt|"+INDLOC.SSIM.fixedAmt+"|"+INDLOC.SSIM.CrCrncyCode)
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.prDetail.acct.foracid|"+INDLOC.SSIM.cracct)
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.prDetail.feeCollectFlg|N")
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_1>.prDetail.amtPcnt|0.000000")

       

		sv_a = urhk_SetUrhkOut("siHeader.siSrlNum|siSrlNum")
		sv_a = urhk_ExecSrv("SRV_AddSimpleSI|retain_all_output = Y|same_user_verify =Y")
		print(sv_a)
		#sv_u = urhk_B2k_PrintRepos("BANCS")
		IF(sv_a !=0) THEN
