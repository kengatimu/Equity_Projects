		       call("trapSRVerror.scr")
			if(fieldexists(CUST.DATA.errorMsg)==1)then
				INDLOC.SSIM.srvMsg            = CUST.DATA.errorMsg
				ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataOut + "And Si Not Added successfuly Error Msg "+INDLOC.SSIM.srvMsg
