		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_0>.partInstruction.amtInd.code|F")
		sv_a = urhk_SetUrhkInp("partInstrLL.<rec_0>.partInstruction.createMpEntryFlg|N")
