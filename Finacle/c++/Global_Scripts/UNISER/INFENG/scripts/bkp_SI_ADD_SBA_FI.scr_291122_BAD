				INDLOC.SSIM.srvSF             = "F"
				goto SRVEND
			endif

			GOTO ENDOFSCRIPT
		#}
		ENDIF
		INDLOC.SSIM.srlNum = BANCS.OUTPARAM.siSrlNum
		print(INDLOC.SSIM.srlNum)

		sv_a = urhk_SetUrhkInp("siHeader.siSrlNum|"+INDLOC.SSIM.srlNum)
		sv_a = urhk_ExecSrv("SRV_FetchSimpleSIForVerify|retain_all_output = Y|same_user_verify =Y|ignore_excp_flg = I|call_mode=N")
		IF(sv_a != 0)then
		#{
			PRINT("Service Failure")
			CALL("trapSRVerror.scr")
		#}
		ELSE
		#{	
			sv_a = urhk_CopyOutToIn("")
			sv_a = urhk_ExecSrv("SRV_VerifySimpleSI|retain_all_output = Y|ignore_excp_flg = I|call_mode=N|same_user_verify =Y")
			IF(sv_a != 0)then
			#{
				PRINT("Service Failure")
				CALL("trapSRVerror.scr")
			#}
			ENDIF
		#}
		ENDIF

		
		#ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataOut + " AND SI Added Successfully For Cr Account "+INDLOC.SSIM.cracct+" And Dr Account "+INDLOC.SSIM.dracct +" WITH SI Number "+INDLOC.SSIM.srlNum
		#TEST
		#ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataOut + " AND SI Added Successfully For Cr Account "+INDLOC.SSIM.cracct+" And Dr Account "+INDLOC.SSIM.Dracno +" WITH SI Number "+INDLOC.SSIM.srlNum
		#ONS.CUSTOM.custDataOut = "SI Added Successfully For Cr Account "+INDLOC.SSIM.cracct+" And Dr Account "+INDLOC.SSIM.Dracno +" WITH SI Number "+INDLOC.SSIM.srlNum
			
		#}
