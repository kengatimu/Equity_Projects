		sv_a = CUST.VAT.PandLBacid +"|"+BANCS.STDIN.homeCrncyCode + "|"+ CUST.VAT.solId
		sv_k =  urhk_B2k_BacidToAcctId(sv_a)
		
		IF(sv_k == 0)THEN
		#{
			MTT.InputDetails.PAndLAcct = BANCS.OUTPARAM.AcctId
			PRINT(MTT.InputDetails.PAndLAcct )
			#}
		ELSE
			#{
			MTT.InputDetails.PAndLAcct = ""
		#}
		ENDIF
		
		
		
		sv_s = "penalPandLBacid|"
		sv_s = sv_s + "SELECT PENAL_PANDL_BACID FROM TBAADM.GSP WHERE SCHM_CODE = ?SVAR"
		sv_s = sv_s + " AND BANK_ID = ?SVAR "
		
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS =  CUST.VAT.schmCode + "|" + BANCS.STDIN.contextBankId
		
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_k = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_k)
		
		IF(sv_k == 0)THEN
		#{
			CUST.VAT.penalPandLBacid = BANCS.OUTPARAM.penalPandLBacid
			PRINT(CUST.VAT.penalPandLBacid)
		#}
		ENDIF
		
		sv_a = CUST.VAT.penalPandLBacid +"|"+BANCS.STDIN.homeCrncyCode+"|"+ CUST.VAT.solId
		sv_k =  urhk_B2k_BacidToAcctId(sv_a)
		
		IF(sv_k == 0)THEN
		#{
			MTT.InputDetails.penalPAndLAcct = BANCS.OUTPARAM.AcctId
			PRINT(sv_b)
			#}
		ELSE
			#{
			MTT.InputDetails.penalPAndLAcct = ""
		#}
		ENDIF
		
		
		sv_s = "rateCode|"
		sv_s = sv_s +" SELECT repay_rate_code "
		sv_s = sv_s + " FROM TBAADM.GCT"
		sv_s = sv_s + " WHERE HOME_CRNCY_CODE = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y'"
		sv_s = sv_s + " AND BANK_ID = ?SVAR"
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.VAT.rateCode = "NOR"
			#}
		ELSE
			#{
			CUST.VAT.rateCode  = BANCS.OUTPARAM.rateCode
			PRINT(CUST.VAT.rateCode)
		#}
		ENDIF
		### for not collecting vat on penal interest
		#		CUST.VAT.totalIndSatFcy = (lv_u)+(lv_x)
		CUST.VAT.totalIndSatFcy = (lv_u)
		PRINT(CUST.VAT.totalIndSatFcy)
		### for not collecting vat on penal interest
		
		### for not collecting vat on penal interest
		#		lv_b = CDOUBLE(CUST.VAT.vatPcnt)* ((lv_u)+(lv_x))/100
		lv_b = CDOUBLE(CUST.VAT.vatPcnt)* (lv_u)/100
		PRINT(lv_b)
		### for not collecting vat on penal interest
		
		lv_u = CDOUBLE(CUST.VAT.vatPcnt)* ((lv_u))/100
		PRINT(lv_u)
		
		lv_x = CDOUBLE(CUST.VAT.vatPcnt)* ((lv_x))/100
		PRINT(lv_x)
		
		CUST.VAT.totalVatSatFcy = lv_b
		PRINT(CUST.VAT.totalVatSatFcy)
		
		IF(CUST.VAT.acctCrncyCode != BANCS.STDIN.homeCrncyCode)THEN
		#{
			CUST.VAT.totalVatSatFcy = lv_b
			PRINT(CUST.VAT.totalVatSatFcy)
			sv_m = CUST.VAT.totalIndSatFcy
			
			#convert amounts to home currency
			
			BANCS.INPARAM.InputAmount=sv_m
			BANCS.INPARAM.FromCurrency=CUST.VAT.acctCrncyCode
			BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.RateCode= CUST.VAT.rateCode
			BANCS.INPARAM.Rate=0
			sv_r = urhk_B2k_ConvertAmount("")
			CUST.VAT.totalIndSatLcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			PRINT(CUST.VAT.totalIndSatLcy)
			
			BANCS.INPARAM.InputAmount=lv_b
			BANCS.INPARAM.FromCurrency=CUST.VAT.acctCrncyCode
			BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.RateCode= CUST.VAT.rateCode
			BANCS.INPARAM.Rate=0
			sv_r = urhk_B2k_ConvertAmount("")
			CUST.VAT.totalVatSatLcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			PRINT(CUST.VAT.totalVatSatLcy)
			
			
			BANCS.INPARAM.InputAmount=lv_u
			BANCS.INPARAM.FromCurrency=CUST.VAT.acctCrncyCode
			BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.RateCode= CUST.VAT.rateCode
			BANCS.INPARAM.Rate=0
			sv_r = urhk_B2k_ConvertAmount("")
			lv_u = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			PRINT(lv_u)
			
			BANCS.INPARAM.InputAmount=lv_x
			BANCS.INPARAM.FromCurrency=CUST.VAT.acctCrncyCode
			BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.RateCode= CUST.VAT.rateCode
			BANCS.INPARAM.Rate=0
			sv_r = urhk_B2k_ConvertAmount("")
			lv_x = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			PRINT(lv_x)
			
			CUST.VAT.rate = BANCS.OUTPARAM.Rate
			PRINT(CUST.VAT.rate)
			
			#}
		ELSE
			#{
			CUST.VAT.totalIndSatLcy = CUST.VAT.totalIndSatFcy
			CUST.VAT.totalVatSatLcy  = CUST.VAT.totalVatSatFcy
			CUST.VAT.totalVatSatFcy = 0
			CUST.VAT.totalIndSatFcy = 0
			CUST.VAT.rate = "1"
		#}
		ENDIF
		
		### for not collecting vat on penal interest
		#		CUST.VAT.tranAmt = lv_u + lv_x
		CUST.VAT.tranAmt = lv_u
		### for not collecting vat on penal interest
		CUST.VAT.totalVatSatLcy = CUST.VAT.tranAmt
		CUST.VAT.crDrInd = "CR"
		
		IF(lv_b<0)THEN
		#{
			CUST.VAT.crDrInd = "DR"
		#}
		ENDIF
		
		CUST.VAT.PenalApplFlg	="N"
		
		IF((CUST.VAT.schmCheck == "Y") AND (lv_b!=0))THEN
		#{
			
			#--------------Part Transaction for Debiting P&L Account--------------#
			
			CUST.VAT.vatAcctDRNrml			     = MTT.InputDetails.PAndLAcct
			CUST.VAT.RemarksDRNrml           	 = "OD Recovery VAT DR Normal"
			CUST.VAT.ParticularsDRNrml         	 = " OD VAT Dr:" +MTT.InputDetails.ActualEntity
			CUST.VAT.RefAmountDRNrml           	 = lv_u
			CUST.VAT.RateCodeDRNrml 			 = CUST.VAT.rateCode
			
			#---------Part Transaction for  Crediting Vat Collection Account  ----------#
			
			CUST.VAT.vatAcctCRNrml			     = MTT.InputDetails.vatAcct
			CUST.VAT.RemarksCRNrml           	 = "OD Recovery VAT CR Normal"
			CUST.VAT.ParticularsCRNrml         	 = " OD VAT Cr:" +MTT.InputDetails.ActualEntity
			CUST.VAT.RefAmountCRNrml             = lv_u
			CUST.VAT.RateCodeCRNrml 			 = CUST.VAT.rateCode
			
			#--------------Part Transaction for Debiting P&L Account--------------#
			
			IF(lv_x !=0)THEN
			#{
				
				CUST.VAT.PenalApplFlg	="Y"
				
				CUST.VAT.vatAcctDRPenal			     = MTT.InputDetails.penalPAndLAcct
				CUST.VAT.RemarksDRPenal              = "OD Recovery VAT DR Penal"
				CUST.VAT.ParticularsDRPenal          = " OD VAT Dr:" +MTT.InputDetails.ActualEntity
				CUST.VAT.RefAmountDRPenal            = lv_x
				CUST.VAT.RateCodeDRPenal 			 = CUST.VAT.rateCode
				
			#}
			ENDIF
			
			#---------Part Transaction for  Crediting Vat Collection Account  ----------#
			
			IF(lv_x!=0)THEN
			#{
				
				CUST.VAT.vatAcctCRPenal			     = MTT.InputDetails.vatAcct
				CUST.VAT.RemarksCRPenal           	 = "OD Recovery VAT CR Penal"
				CUST.VAT.ParticularsCRPenal          = " OD VAT Cr:" +MTT.InputDetails.ActualEntity
				CUST.VAT.RefAmountCRPenal            = lv_x
				CUST.VAT.RateCodeCRPenal 			 = CUST.VAT.rateCode
				
			#}
			ENDIF
			
			IF((lv_u !=0) OR (lv_x !=0))THEN
			#{
				CUST.VAT.NrmlOrRev = "N"
				sv_k = lv_u
				### for not collecting vat on penal interest
				#				sv_l = lv_x
				sv_l = 0
				### for not collecting vat on penal interest
				CALL("VATODTranCreate.scr")
			#}
			ENDIF
			
			IF (FIELDEXISTS(CUST.VAT.vatTranId)) THEN
			#{
				PRINT(CUST.VAT.vatTranId)
				CUST.VAT.tranId = CUST.VAT.vatTranId
				PRINT(CUST.VAT.tranId)
				CUST.VAT.SattranId =""
				#}
			ELSE
				#{
				CUST.VAT.tranId = "NA"
				PRINT(CUST.VAT.tranId)
			#}
			ENDIF
			
			CALL("vatTableODUpdate.scr")
		#}
		ENDIF
		
		
		################### End of customization #####################################
		
		
		GET_NEXT_REC :
			sv_r = urhk_MTTS_PopulateInputDetails("")
		#}
		DO
		TRACE OFF
END-->
