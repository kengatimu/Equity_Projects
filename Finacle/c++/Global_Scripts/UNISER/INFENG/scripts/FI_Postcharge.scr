<--START
TRACE ON
        #------------------------------------#
        #-- Repository And Class Creation  --#
        #------------------------------------#



	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST", "CBAL") == 0) THEN
	#{
		CREATECLASS("CUST", "CBAL", 5)
	#}
	ENDIF	

	sv_q = urhk_B2k_PrintRepos("BANCS")
	print(sv_q)	


	IF( (FIELDEXISTS(("BANCS").("INPUT").("CHARGE"))== 0) ) THEN
	#{
   		CUST.CBAL.errMsg="Please enter the CHARGE"
		sv_t = "ERROR| " +CUST.CBAL.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("VAT"))== 0) ) THEN
	#{
   		CUST.CBAL.errMsg="please enter the VAT"
		sv_t = "ERROR| " +CUST.CBAL.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("FORACID"))== 0) ) THEN
	#{
   		CUST.CBAL.errMsg="please enter the FORACID"
		sv_t = "ERROR| " +CUST.CBAL.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

 
	#-----------------------------
	## Variable Intialization
	#-----------------------------
		CUST.CBAL.errMsg   = ""

		CUST.CBAL.drAcct =BANCS.INPUT.FORACID				
		print(CUST.CBAL.drAcct)

		CUST.CBAL.crAcct = "0746550100001"				
		print(CUST.CBAL.crAcct)

		CUST.CBAL.VATcrAcct = "0746550100001"				
		print(CUST.CBAL.VATcrAcct)

		CUST.CBAL.charge = BANCS.INPUT.CHARGE
		print(CUST.CBAL.charge)

		CUST.CBAL.exduty = BANCS.INPUT.VAT
		PRINT(CUST.CBAL.exduty)
	
	
		
		#---------------------------------
        # Populate MTT details
        #---------------------------------

		sv_r = urhk_MTTS_PopulateInputDetails("")
		Print(sv_r)

		IF (sv_r != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.CBAL.errMsg = MTT.Error.Description
			PRINT(CUST.CBAL.errMsg)
			EXITSCRIPT      
		#}
		ENDIF

		#---------------------------------
        #  Closing of MTT if it is opened
        #-----------------------------------

		sv_g = urhk_MTTS_Close("")
		print(sv_g)
	
		IF (sv_g != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.CBAL.errMsg = MTT.Error.Description
			PRINT(CUST.CBAL.errMsg)
			EXITSCRIPT
		#}
		ENDIF

        #-----------------------------
        #--- Initialize MTT details
        #-----------------------------

		BANCS.INPARAM.PostTranFlg               = "Y"
		BANCS.INPARAM.CommitFlg                 = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
		BANCS.INPARAM.ValidationFlag            = "N"
		BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw          = "Y"
		BANCS.INPARAM.CheckExceptions           = "Y"

		sv_o = urhk_MTTS_Initialize("")
		PRINT(sv_o)
		
		IF(sv_o != 0)THEN
		#{
			sv_o = urhk_MTTS_ReportErrorCondition("")
			CUST.CBAL.errMsg = MTT.Error.Description
			PRINT(CUST.CBAL.errMsg)
			EXITSCRIPT
		#}
		ENDIF


        #-------------------------------
        # Define the transaction
        #-------------------------------

		MTT.TranDetails.TranDate        = "0"
		MTT.TranDetails.TranType        = "T"
		MTT.TranDetails.TranSubType     = "BI"
		MTT.TranDetails.ValidationFlag  = "N"
		MTT.TranDetails.IgnoreExcp      = "I"
		MTT.TranDetails.CommitFlg       = "Y"
		MTT.TranDetails.PostFlag        = "Y"

		sv_r = urhk_MTTS_DefineTransaction("BAL/CRG_TranDetails")
		print(sv_r)

		IF (sv_r != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.CBAL.errMsg = MTT.Error.Description
			PRINT(CUST.CBAL.errMsg)
			EXITSCRIPT
		#}
		ENDIF



	#------------------------------------
	# DR/CR
	#--------------------------------------
		CUST.CBAL.charge1= CDOUBLE(CUST.CBAL.charge ) * -1
		PRINT(CUST.CBAL.charge1)
		print(CUST.CBAL.drAcct)
		print(CUST.CBAL.crAcct)

		CUST.CBAL.exduty1= CDOUBLE(CUST.CBAL.exduty) * -1
		print(CUST.CBAL.exduty1)
		
	#-----------------------------------------------------------------------
	#Debit customer account the bal certificate charge
	#-----------------------------------------------------------------------

			MTT.PartTranDetails.Account = CUST.CBAL.drAcct

			MTT.PartTranDetails.RefAmount = CUST.CBAL.charge1

			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "bal cert charge ("+ CUST.CBAL.drAcct + ")"
			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "BAL/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("DR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.CBAL.errMsg = MTT.Error.Description
				PRINT(CUST.CBAL.errMsg)
			#}
			ENDIF

	#----------------------------------------------------------------------				
	#Credit Bal certificate charge to the respective GL
	#----------------------------------------------------------------------
			MTT.PartTranDetails.Account        = CUST.CBAL.crAcct
			MTT.PartTranDetails.RefAmount      = CUST.CBAL.charge

			MTT.PartTranDetails.RefCurrency    = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "bal cert charge ("+ CUST.CBAL.crAcct + ")"

			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "BAL/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("CR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.CBAL.errMsg = MTT.Error.Description
				PRINT(CUST.CBAL.errMsg)
			#}
			ENDIF

	#-----------------------------------------------------------------------
	#Debit customer account the excercise duty fee
	#-----------------------------------------------------------------------

			MTT.PartTranDetails.Account = CUST.CBAL.drAcct

			MTT.PartTranDetails.RefAmount = CUST.CBAL.exduty1

			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "excise duty ("+ CUST.CBAL.drAcct + ")"
			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "BAL/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("DR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.CBAL.errMsg = MTT.Error.Description
				PRINT(CUST.CBAL.errMsg)
			#}
			ENDIF


	#----------------------------------------------------------------------				
	#Credit excise duty to the respective GL
	#----------------------------------------------------------------------
			MTT.PartTranDetails.Account        = CUST.CBAL.VATcrAcct
			MTT.PartTranDetails.RefAmount      = CUST.CBAL.exduty

			MTT.PartTranDetails.RefCurrency    = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "excise duty ("+ CUST.CBAL.VATcrAcct + ")"

			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "BAL/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("CR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.CBAL.errMsg = MTT.Error.Description
				PRINT(CUST.CBAL.errMsg)
			#}
			ENDIF





	#--------------------------------------------------------------
        # MTT ending definition to create transaction
        #--------------------------------------------------------------
	
		sv_r = urhk_MTTS_EndDefinition("")
		PRINT(sv_r)

		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			CUST.CBAL.tranId = TRIM(BANCS.OUTPARAM.MTTTranId)
			PRINT(CUST.CBAL.tranId)

			
		#}
		ENDIF

	#--------------------------------------------------------------
        # MTT Closing an initialized MTT
        #--------------------------------------------------------------
	
		sv_r = urhk_MTTS_Close("")
		print(sv_r)

	#--------------------------------------------------------------
        # SENDING RESPONSE
        #--------------------------------------------------------------

	IF(CUST.CBAL.tranId != "")THEN
	#{

		sv_t = "TRAN_ID| " + CUST.CBAL.tranId
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "TRAN_DATE| " + BANCS.STDIN.sysDate
		sv_u = urhk_SetOrbOut(sv_t)

	#}
	ELSE
	#{
   		CUST.CBAL.errMsg="The transaction was not posted"
		sv_t = "ERROR| " +CUST.CBAL.errMsg
		sv_u = urhk_SetOrbOut(sv_t)

	#}
	ENDIF

	ENDOFSCRIPT:
	EXITSCRIPT


TRACE OFF
END-->