<--START
CHECKSUM="d609492ea7345effbf01ab10bf015913877a57597c07816877a24e34da3310b6"
	TRACE ON
	
	###############################################################################
	# Define the Transaction
	###############################################################################
	BANCS.OUTPUT.scriptError = ""
	sv_a = urhk_MTTS_PopulateInputDetails("")
	
	IF(sv_a != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
