#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Name                   : ebGtJipW.scr 
#   Date                   : 17-Jul-2019
#   Description            :
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#+++++++++++++
#Rep/Class
#+++++++++++++
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	EQSRV.GLBDATA.errMsg	= ""
	EQSRV.GLBDATA.srvYN = ""
	EQSRV.GLBDATA.valerr = ""
#+++++++++++++
#DeriveInputs
#+++++++++++++
	if(fieldexists(BANCS.INPUT.ModuleId)==1)then
		EQSRV.GLBDATA.ModuleId = BANCS.INPUT.ModuleId
	else
		EQSRV.GLBDATA.ModuleId = ""
	endif
	if(fieldexists(BANCS.INPUT.jipangeAcct)==1)then
		EQSRV.GLBDATA.jipangeAcct = BANCS.INPUT.jipangeAcct
	else
		EQSRV.GLBDATA.jipangeAcct = ""
	endif
	if(fieldexists(BANCS.INPUT.withdrawAmt)==1)then
		EQSRV.GLBDATA.withdrawAmt = BANCS.INPUT.withdrawAmt
	else
		EQSRV.GLBDATA.withdrawAmt = "0"
	endif
	if(cdouble(EQSRV.GLBDATA.withdrawAmt) <=0)then
                EQSRV.GLBDATA.srvYN = "N"
                EQSRV.GLBDATA.valerr    =       "Withdrawal Amount Cannot be Zero " +EQSRV.GLBDATA.jipangeAcct
                goto VAYU
	endif
#Acct
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.jipangeAcct)
        if(sv_u ==0)then
                EQSRV.GLBDATA.glSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
                EQSRV.GLBDATA.solId     =       BANCS.OUTPARAM.acctSolId
                EQSRV.GLBDATA.schmType  =       BANCS.OUTPARAM.schmType
                EQSRV.GLBDATA.schmCode  =       BANCS.OUTPARAM.schmCode
                EQSRV.GLBDATA.crncyCode =       BANCS.OUTPARAM.acctCrncyCode
                EQSRV.GLBDATA.acctClsFlg        =       BANCS.OUTPARAM.acctCloseflg
	        EQSRV.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
                EQSRV.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt
                EQSRV.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
                EQSRV.GLBDATA.goalCrncy = BANCS.OUTPARAM.acctCrncyCode

        endif
	print(EQSRV.GLBDATA.withdrawAmt)
	print(EQSRV.GLBDATA.clearBalance)
	if(cdouble(EQSRV.GLBDATA.withdrawAmt) > cdouble(EQSRV.GLBDATA.clearBalance))then
                EQSRV.GLBDATA.srvYN = "N"
                EQSRV.GLBDATA.valerr    =       "Insufficient Funds in goal account " +EQSRV.GLBDATA.jipangeAcct
                goto VAYU
	endif
        if(EQSRV.GLBDATA.schmType !="SBA")then
                EQSRV.GLBDATA.srvYN = "N"
                EQSRV.GLBDATA.valerr    =       "Account not related with Goals " +EQSRV.GLBDATA.jipangeAcct
                goto VAYU
        endif
        if(EQSRV.GLBDATA.acctClsFlg =="Y")then
                EQSRV.GLBDATA.srvYN = "N"
                EQSRV.GLBDATA.valerr    =       "Account is in Closed " +EQSRV.GLBDATA.jipangeAcct
                goto VAYU
        endif
        sv_u = urhk_getAdvanceDetailsForAccount(EQSRV.GLBDATA.jipangeAcct)
        if(sv_u==0)then
                EQSRV.GLBDATA.gSourceAcct = BANCS.OUTPARAM.gacFreeText1
                EQSRV.GLBDATA.gGoalMonths = BANCS.OUTPARAM.gacFreeText2
                EQSRV.GLBDATA.gGoalDays = BANCS.OUTPARAM.gacFreeText3
                EQSRV.GLBDATA.gPayoutDays = BANCS.OUTPARAM.gacFreeText4
                EQSRV.GLBDATA.gExpiryDate = BANCS.OUTPARAM.gacFreeText5
                EQSRV.GLBDATA.gAprYN = BANCS.OUTPARAM.gacFreeText7
                EQSRV.GLBDATA.gOctYN = BANCS.OUTPARAM.gacFreeText8
                if(EQSRV.GLBDATA.gSourceAcct != "")then
                        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.gSourceAcct)
                        if(sv_u!=0)then
                                EQSRV.GLBDATA.valerr    = "Invalid SOurce Account for Goal " + EQSRV.GLBDATA.jipangeAcct
                                EQSRV.GLBDATA.srvYN     = "N"
                                goto VAYU
                        endif
                endif
        else
                EQSRV.GLBDATA.valerr    = "Invalid Goal Account " + EQSRV.GLBDATA.jipangeAcct
                EQSRV.GLBDATA.srvYN     = "N"
                goto VAYU
        endif
#++++++++++++
#transaction
#++++++++++++
	sv_a = urhk_MTTS_Close("")
	if(repexists("MTT")==0)then
		createrep("MTT")
	endif
	if(classexists("MTT","TranDetails")==0)then
		createclass("MTT","TranDetails",5)
	endif
	if(classexists("MTT","PartTranDetails")==0)then
		createclass("MTT","PartTranDetails",5)
	endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif

	BANCS.INPARAM.PostTranFlg	= "Y"
	BANCS.INPARAM.CommitFlg		= "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
	BANCS.INPARAM.ValidationFlag	= "Y"
	BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw	="Y"

	sv_a = urhk_MTTS_Initialize("")
	MTT.TranDetails.TranDate	= "0"
	MTT.TranDetails.TranType	= "T"
	MTT.TranDetails.TranSubType	= "BI"
	MTT.TranDetails.Remarks		= "GeorgeTown Goals Withdrawal"
	MTT.TranDetails.IgnoreExcp	= "Y"
	MTT.TranDetails.PrintAdviceInd	= "B"
	MTT.TranDetails.TranIdOnline	= "N"
	sv_u = urhk_MTTS_defineTransaction("JipangeWithDraw")
	if(sv_u != 0) then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQSRV.GLBDATA.valerr    = MTT.Error.Description 
			EQSRV.GLBDATA.srvYN     = "N"
		endif
		goto VAYU
	endif
	sv_u = urhk_MTTS_populateInputDetails("")
	if(sv_u != 0) then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQSRV.GLBDATA.valerr    = MTT.Error.Description 
			EQSRV.GLBDATA.srvYN     = "N"
		endif
		goto VAYU
	endif
#Debit
	print(EQSRV.GLBDATA.jipangeAcct)
	MTT.PartTranDetails.Account	= EQSRV.GLBDATA.jipangeAcct 
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = "Dr.For " + EQSRV.GLBDATA.gSourceAcct + " / Goals " 
	MTT.PartTranDetails.RefAmount	= -1 * cdouble(EQSRV.GLBDATA.withdrawAmt) 
	if(EQSRV.GLBDATA.ModuleId=="GTJIP")then
		MTT.PartTranDetails.Remarks	= "Withdrawal of Jipange Goals"
	endif
	MTT.PartTranDetails.RefNum	= EQSRV.GLBDATA.gSourceAcct 
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = "JipangeWithDraw"
	##MTT.PartTranDetails.ReportCode = sv_z
	sv_u = urhk_MTTS_definePartTran("SettleDr")
	print(sv_u)
	if(sv_u!=0)then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQSRV.GLBDATA.valerr    = MTT.Error.Description 
			EQSRV.GLBDATA.srvYN     = "N"
			goto VAYU
		endif
	endif
#Credit
	print(EQSRV.GLBDATA.gSourceAcct)
	MTT.PartTranDetails.Account 	= EQSRV.GLBDATA.gSourceAcct 
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = "Cr.From " + EQSRV.GLBDATA.jipangeAcct 
	MTT.PartTranDetails.RefAmount 	= 1 * cdouble(EQSRV.GLBDATA.withdrawAmt) 
	MTT.PartTranDetails.Remarks 	= "JJ Withdraw"
	MTT.PartTranDetails.RefNum 	= EQSRV.GLBDATA.gSourceAcct 
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = "JipangeWithDraw"
	##MTT.PartTranDetails.ReportCode = sv_z
	sv_u = urhk_MTTS_definePartTran("SettleDr")
	print(sv_u)
	if(sv_u!=0)then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQSRV.GLBDATA.valerr    = MTT.Error.Description 
			EQSRV.GLBDATA.srvYN     = "N"
			goto VAYU
		endif
	endif
#Res
	sv_u = urhk_MTTS_endDefinition("")
	if(sv_u!=0)then
		if(fieldexists(MTT.Error.Description))then
			print(MTT.Error.Description)
			EQSRV.GLBDATA.valerr    = MTT.Error.Description 
			EQSRV.GLBDATA.srvYN     = "N"
			goto VAYU
		endif
	else
		print(BANCS.OUTPARAM.MTTTranId)
		EQSRV.GLBDATA.withdrawTranId = BANCS.OUTPARAM.MTTTranId
EQSRV.GLBDATA.valerr    = "Jipange Jinue goal Withdrawn successfully with amount " + EQSRV.GLBDATA.withdrawAmt + "and tran id " + EQSRV.GLBDATA.withdrawTranId 
		EQSRV.GLBDATA.srvYN     = "Y"
		goto VAYU
	endif
	sv_u = urhk_MTTS_Close("")
	print(sv_u)
VAYU:
	print(EQSRV.GLBDATA.valerr)	
	print(EQSRV.GLBDATA.srvYN)
	sv_a = urhk_MTTS_Close("")
	##if(classexists("EQSRV","GLBDATA")==1)then
	##	deleteclass("EQSRV","GLBDATA")
	##endif
	##if(repexists("EQSRV")==1)then
	##	deleterep("EQSRV")
	##endif
	exitscript
trace off
end-->
