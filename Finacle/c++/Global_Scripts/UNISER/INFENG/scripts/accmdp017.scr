				sv_q = sv_q + " AND SOL_ID = ?SVAR "
				sv_q = sv_q + " AND BANK_ID = ?SVAR "
				IF(CUST.CONTRACT.funCode == "V")THEN
				#{
					
					#{
					sv_q = sv_q + " AND CREATED_BY != ?SVAR "
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|N|N|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CONTRACT.solId + "|" + CUST.CONTRACT.bankId + "|" + BANCS.STDIN.userId
					#}
				ELSE
					#{
					#	sv_q = sv_q + " AND CREATED_BY = ?SVAR "
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|N|N|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CONTRACT.solId + "|" + CUST.CONTRACT.bankId
					sv_q = sv_q + " AND VERIFY_BY IS NULL"
				#}
				ENDIF
				IF(CUST.CONTRACT.iFlag=="Y")THEN
				#{
					sv_q = sv_q + " AND ACCT_NUM = ?SVAR "
					BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.CONTRACT.acctNo
				#}
				ENDIF
				sv_q = sv_q + " ) ORDER BY REQUEST_ID DESC"
				
			#}
			ENDIF
			IF(CUST.CONTRACT.funCode== "Z") THEN
			#{
				BANCS.INPARAM.BINDVARS = "N|N|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CONTRACT.solId + "|" + CUST.CONTRACT.bankId + "|" + BANCS.STDIN.userId
				sv_q = "contractId,acctNum,rcreUser,createdDate,creFlg,extReq,encReq,remarks,clsFlg,solId|SELECT REQUEST_ID,ACCT_NUM,RCRE_USER,CREATED_DATE, "
				sv_q = sv_q + " ENTITY_CRE_FLG,EXT_REQ,ENC_REQ,REMARKS,CLS_FLG,SOL_ID"
				sv_q = sv_q + " FROM CUSTOM.CATOD_SANCTION_MOD_TABLE "
				sv_q = sv_q + " WHERE ENTITY_CRE_FLG =?SVAR "
				sv_q = sv_q + " AND DEL_FLG =?SVAR "
				sv_q = sv_q + " AND((ENC_REQ is not null) OR (EXT_REQ is not null) ) "
				sv_q = sv_q + " AND SOL_ID =?SVAR "
				sv_q = sv_q + " AND BANK_ID =?SVAR "
				sv_q = sv_q + " AND CREATED_BY = ?SVAR "
				sv_q = sv_q + " AND VERIFY_BY IS NULL"
				
				IF(CUST.CONTRACT.iFlag=="Y")THEN
				#{
					sv_q = sv_q + " AND ACCT_NUM = ?SVAR "
					BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS+"|"+CUST.CONTRACT.acctNo
				#}
				ENDIF
				sv_q = sv_q + " ORDER BY REQUEST_ID  DESC"
				
			#}
			ENDIF
			PRINT(sv_q)
			#sv_q = sv_q + " order by 1 "
			#print(BANCS.INPARAM.BINDVARS)
			sv_r = urhk_dbCursorOpenWithBind(sv_q)
			PRINT(sv_r)
			IF (sv_r != 0) THEN
			#{
				BANCS.OUTPUT.fatalErrorMsg = "Unable to open cursor. Contact system admin"
				BANCS.OUTPUT.fatalErrorFlg = "Y"
				GOTO FINISH
			#}
			ENDIF
			CUST.CONTRACT.cursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_r = urhk_dbCursorFetch(CUST.CONTRACT.cursorNumber)
			PRINT(sv_r)
			sv_i = 1
			WHILE(sv_r == 0)
			#{
				CUST.CONTRACT.contractId = BANCS.OUTPARAM.contractId
				CUST.CONTRACT.acctNum 	 = BANCS.OUTPARAM.acctNum
				CUST.CONTRACT.rcreUser	 = BANCS.OUTPARAM.rcreUser
				CUST.CONTRACT.createdDate = BANCS.OUTPARAM.createdDate
				CUST.CONTRACT.creFlg = BANCS.OUTPARAM.creFlg
				CUST.CONTRACT.extReq = BANCS.OUTPARAM.extReq
				CUST.CONTRACT.encReq = BANCS.OUTPARAM.encReq
				CUST.CONTRACT.remarks = BANCS.OUTPARAM.remarks
				CUST.CONTRACT.clsFlg = BANCS.OUTPARAM.clsFlg
				CUST.CONTRACT.solId = BANCS.OUTPARAM.solId
				
				print(CUST.CONTRACT.contractId)
				print(CUST.CONTRACT.acctNum)
				print(CUST.CONTRACT.rcreUser)
				print(CUST.CONTRACT.createdDate)
				print(CUST.CONTRACT.creFlg)
				print(CUST.CONTRACT.extReq)
				print(CUST.CONTRACT.encReq)
				print(CUST.CONTRACT.remarks)
				print(CUST.CONTRACT.clsFlg)
				print(CUST.CONTRACT.solId)
				
				IF(CUST.CONTRACT.creFlg == "Y") THEN
				#{
					CUST.CONTRACT.funcCode = "VERIFIED"
					#}
				ELSE
					#{
					IF((CUST.CONTRACT.extReq != "") OR (CUST.CONTRACT.encReq != ""))  THEN
					#{
						CUST.CONTRACT.funcCode = "ENCHANCED"
					#}
					ENDIF
					IF((CUST.CONTRACT.remarks !="") AND (CUST.CONTRACT.clsFlg == "Y")) THEN
					#{
						CUST.CONTRACT.funcCode = "TERMINATED"
					#}
					ENDIF
					
				#}
				ENDIF
				print(CUST.CONTRACT.funcCode)
				
				sv_y = format$(sv_i, "%d")
				print(sv_y)
				sv_s = "contractId_" + sv_y + "|" +CUST.CONTRACT.contractId
				print(sv_s)
				sv_r = urhk_SetOrbOut(sv_s)
				sv_s = "acctNo_" + sv_y + "|" + CUST.CONTRACT.acctNum
				print(sv_s)
				sv_r = urhk_SetOrbOut(sv_s)
				sv_s = "rcreUser_" + sv_y + "|" + CUST.CONTRACT.rcreUser
				print(sv_s)
				sv_r = urhk_SetOrbOut(sv_s)
				sv_s = "createdDate_" + sv_y + "|" + CUST.CONTRACT.createdDate
				print(sv_s)
				sv_r = urhk_SetOrbOut(sv_s)
				sv_s = "funcCode_" + sv_y + "|" + CUST.CONTRACT.funcCode
				print(sv_s)
				sv_r = urhk_SetOrbOut(sv_s)
				sv_s = "solId_" + sv_y + "|" + CUST.CONTRACT.solId
				print(sv_s)
				sv_r = urhk_SetOrbOut(sv_s)
				sv_i = sv_i + 1
				print(sv_i)
				#----------------------------------------------------------------------
				# Fetch next record
				#-----------------------------------------------------------------------
				sv_r = urhk_dbCursorFetch(CUST.CONTRACT.cursorNumber)
				PRINT(sv_r)
			#}
			DO
		#}
		ENDIF
		#--------------------------------------------------------------------------
		#Close the cursor
		#--------------------------------------------------------------------------
		sv_r = urhk_dbCursorClose(CUST.CONTRACT.cursorNumber)
	FINISH:
		EXITSCRIPT
END-->
