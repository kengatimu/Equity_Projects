	IF(FIELDEXISTS(BANCS.INPUT.origTranDate))THEN
	#{
		
		IF(TRIM(BANCS.INPUT.origTranDate) != "")THEN
		#{
			CUST.TRAN.origTranDate = TOUPPER(BANCS.INPUT.origTranDate)
			PRINT(CUST.TRAN.origTranDate)
