		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------#
	#          Fetching Event ID from CPARAM         #
	#------------------------------------------------#
	
	BANCS.INPUT.moduleName = "OT"
	BANCS.INPUT.parameterId = "CASH_CHRG_EVNT_ID"
	
	sv_g = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER WHERE "
	sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
	sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
	sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
	sv_g = sv_g + " C_CPVALUE.del_flg != 'Y' AND "
	sv_g = sv_g + " C_CPVALUE.entity_cre_flg = 'Y' AND "
	sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
	sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
	sv_g = sv_g + " C_CPVALUE.parameter_id = ?SVAR"
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.moduleName + "|" + BANCS.INPUT.parameterId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_g)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.parameterVal)
		
		IF(TRIM(BANCS.OUTPARAM.parameterVal)=="")THEN
		#{
			CUST.TRAN.errorFlg = "Y"
			CUST.TRAN.errorMsg = "Event Id for Charge Collection is not maintained in CPARAM!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.TRAN.errorFlg = "Y"
		CUST.TRAN.errorMsg = "Event Id for Charge Collection is not maintained in CPARAM!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------#
	
	CUST.TRAN.chrgEvntId = BANCS.OUTPARAM.parameterVal
	
	#------------------------------------------------#
	#        	  Validating Event ID                #
	#------------------------------------------------#
	
	sv_s = "count|SELECT count(*) FROM tbaadm.PTT where ENTITY_CRE_FLG ='Y' and del_flg='N' "
	sv_s = sv_s + " and  event_type ='GCHRG' and event_id =?SVAR and  bank_id= ?SVAR "
	
	BANCS.INPARAM.BINDVARS = CUST.TRAN.chrgEvntId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.count)
		IF(BANCS.OUTPARAM.count == "0")THEN
		#{
			CUST.TRAN.errorFlg = "Y"
			CUST.TRAN.errorMsg = "Invalid Event Id: "+CUST.TRAN.chrgEvntId+" for Charge Collection!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.TRAN.errorFlg = "Y"
		CUST.TRAN.errorMsg = "Invalid Event Id: "+CUST.TRAN.chrgEvntId+" for Charge Collection!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------#
	#      	    Fetching Account Details             #
	#------------------------------------------------#
	
	sv_s = "foracid,acctCrncy|select foracid, acct_crncy_code from tbaadm.gam where acid = (select acid "
	sv_s = sv_s + " from tbaadm.dtd where tran_id = ?SVAR and tran_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + "	and bank_id = ?SVAR and cust_id is not null and rownum = 1) and bank_id = ?SVAR "
	
	BANCS.INPARAM.BINDVARS = CUST.TRAN.origTranId + "|" + MID$(CUST.TRAN.origTranDate,0,10) + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.foracid)
		PRINT(BANCS.OUTPARAM.acctCrncy)
		
		IF(BANCS.OUTPARAM.foracid == "")THEN
		#{
			CUST.TRAN.errorFlg = "Y"
			CUST.TRAN.errorMsg = "Unable to fetch the Account Details for Charge Collection!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.TRAN.errorFlg = "Y"
		CUST.TRAN.errorMsg = "Unable to fetch the Account Details for Charge Collection!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.TRAN.foracid = BANCS.OUTPARAM.foracid
	CUST.TRAN.acctCrncy = BANCS.OUTPARAM.acctCrncy
	
	#-------------------------------------------------------------------#
	#      	    Calling GCHRG script for Charge Transaction             #
	#-------------------------------------------------------------------#
	
	CUST.GCHRG.tranType				= "T"
	CUST.GCHRG.tranSubType          = "CI"
	CUST.GCHRG.drAcctId             = CUST.TRAN.foracid
	CUST.GCHRG.acctCrncyCode        = CUST.TRAN.acctCrncy
	CUST.GCHRG.eventId				= CUST.TRAN.chrgEvntId
	CUST.GCHRG.chrgAmt				= ""
	
	CALL("gchrgcommon.scr")
	
	IF(CUST.GCHRG.successOrFailure == "S") THEN
	#{
		PRINT(CUST.GCHRG.chargeTranId)
		PRINT(CUST.GCHRG.chargeTranDate)
		#}
	ELSE
		#{
		CUST.TRAN.errorFlg = "Y"
		CUST.TRAN.errorMsg = CUST.GCHRG.gchrgErrMsg
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errFlg|"+CUST.TRAN.errorFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("message|"+CUST.TRAN.errorMsg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("cxlTranId|"+CUST.GCHRG.chargeTranId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("cxlTranDate|"+CUST.GCHRG.chargeTranDate)
		PRINT(sv_u)
		
		DELETECLASS("CUST","GCHRG")
		DELETECLASS("CUST","TRAN")
		DELETEREP("CUST")
END-->

