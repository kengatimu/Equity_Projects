#======================================================#
#Source Name                    :rpClintmGo.scr
#Menu                           :CLINTM
#Date                           :31-03-2023
#Description                    :On Click Go button from CLINTM Menu.
#Author                         :Ranjith Palani
#======================================================#
<--start
trace on

	#--------------------------------#
	#Repository and Class.
	#--------------------------------#
	if(repexists("CUST") == 0)then
	#{
		createrep("CUST")
	#}
	endif
	if(classexists("CUST","CLINTM") == 0)then
	#{
		createclass("CUST","CLINTM",5)
	#}
	endif

	sv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
	print(sv_a)

	sv_a = urhk_B2k_PrintRepos("BANCS")
	print(sv_a)

	CUST.CLINTM.acctId = BANCS.INPUT.acctId
	if(fieldexists(BANCS.INPUT.funcCode))then
		if(trim(BANCS.INPUT.funcCode) != "")then
			CUST.CLINTM.funcCode = toupper(trim(BANCS.INPUT.funcCode))
			print(CUST.CLINTM.funcCode)
			if(CUST.CLINTM.funcCode == "A")then
				goto drcadd
			endif
			if(CUST.CLINTM.funcCode == "I")then
				goto drcinq
			endif
			if(CUST.CLINTM.funcCode == "V")then
				goto drcvrfy
			endif
			if(CUST.CLINTM.funcCode == "M")then
				goto drcmod
			endif
			if(CUST.CLINTM.funcCode == "X")then
				goto drcxcl
			endif
		endif
	endif
	drcadd:
		sv_a = "mainCount|select count(1) from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_a = urhk_dbSelectWithBind(sv_a)
		if(sv_a == 0)then
			CUST.CLINTM.mainCount = BANCS.OUTPARAM.mainCount
		endif

		sv_a = "modCount|select count(1) from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_a = urhk_dbSelectWithBind(sv_a)
		if(sv_a == 0)then
			CUST.CLINTM.modCount = BANCS.OUTPARAM.modCount
		endif

		if(CUST.CLINTM.acctId != "")then
			sv_g = urhk_getAcctDetailsInRepository(CUST.CLINTM.acctId)
			if(sv_g == 0)then
				CUST.CLINTM.schmType = BANCS.OUTPARAM.schmType
				if(CUST.CLINTM.schmType != "LAA")then
					BANCS.OUTPUT.SuccessOrFailure = "F"
					sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
					sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Only LAA type should be Entered."+ "^dummy")
					goto drceqty
				endif
			endif
		endif

		if((CUST.CLINTM.modCount == 0) and (CUST.CLINTM.mainCount == 0))then
			BANCS.OUTPUT.SuccessOrFailure = "S"
			sv_e = urhk_SetOrbOut("SuccessOrFailure|Y")
			goto drceqty
		endif

		if(CUST.CLINTM.modCount == 1)then
			BANCS.OUTPUT.SuccessOrFailure = "F"
			sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Record already Added, Pending for Verification."+ "^dummy")
			goto drceqty
		endif

		if(CUST.CLINTM.mainCount == 1)then
			BANCS.OUTPUT.SuccessOrFailure = "F"
			sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Record is Added."+ "^dummy")
			goto drceqty
		endif

	drcinq:
		sv_c = "cnt|select count(1) from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_c = urhk_dbSelectWithBind(sv_c)
		if(sv_c == 0)then
			sv_t = BANCS.OUTPARAM.cnt
			if(sv_t == 0)then
				BANCS.OUTPUT.SuccessOrFailure = "F"
				sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Float Rate Not found for the Account "+ "^dummy")
				goto drceqty
			else
				sv_s = "custPrefInt,acctPrefInt,chnlPrefInt,negotiatedRate,minInt,maxInt,startDate,endDate,intAppliedStatus|"
				sv_s = sv_s + "select cust_dr_pref_pcnt,id_dr_pref_pcnt,chnl_dr_pref_pcnt,negotiated_rate_dr,min_int_pcnt_dr,"
				sv_s = sv_s + "max_int_pcnt_dr,to_char(start_date,'dd-mm-yyyy'),to_char(end_date,'dd-mm-yyyy'),float_interest_applied_status " 
				sv_s = sv_s + "from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
				sv_s = urhk_dbSelectWithBind(sv_s)
				print(sv_s)
				if(sv_s == 0)then
					CUST.CLINTM.custPrefInt = cdouble(BANCS.OUTPARAM.custPrefInt)
					CUST.CLINTM.acctPrefInt = cdouble(BANCS.OUTPARAM.acctPrefInt)
					CUST.CLINTM.chnlPrefInt = cdouble(BANCS.OUTPARAM.chnlPrefInt)
					CUST.CLINTM.negotiatedRate = cdouble(BANCS.OUTPARAM.negotiatedRate)
					CUST.CLINTM.minInt = cdouble(BANCS.OUTPARAM.minInt)
					CUST.CLINTM.maxInt = cdouble(BANCS.OUTPARAM.maxInt)
					CUST.CLINTM.startDate = BANCS.OUTPARAM.startDate
					CUST.CLINTM.endDate = BANCS.OUTPARAM.endDate
					CUST.CLINTM.intAppliedStatus = BANCS.OUTPARAM.intAppliedStatus
					sv_a = urhk_SetOrbOut("custPrefInt|"+ CUST.CLINTM.custPrefInt)
					sv_a = urhk_SetOrbOut("acctPrefInt|"+ CUST.CLINTM.acctPrefInt)
					sv_a = urhk_SetOrbOut("chnlPrefInt|"+ CUST.CLINTM.chnlPrefInt)
					sv_a = urhk_SetOrbOut("negotiatedRate|"+ CUST.CLINTM.negotiatedRate)
					sv_a = urhk_SetOrbOut("minInt|"+ CUST.CLINTM.minInt)
					sv_a = urhk_SetOrbOut("maxInt|"+ CUST.CLINTM.maxInt)
					sv_a = urhk_SetOrbOut("startDate|"+ CUST.CLINTM.startDate)
					sv_a = urhk_SetOrbOut("endDate|"+ CUST.CLINTM.endDate)
					sv_a = urhk_SetOrbOut("intAppliedStatus|"+ CUST.CLINTM.intAppliedStatus)

					BANCS.OUTPUT.SuccessOrFailure = "S"
					sv_s = urhk_SetOrbOut("SuccessOrFailure|Y")
					goto drceqty
				endif
			endif
		endif

	drcvrfy:
		sv_m = "modCount|select count(1) from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.modCount = BANCS.OUTPARAM.modCount
		endif

		sv_m = "mainCount|select count(1) from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.mainCount = BANCS.OUTPARAM.mainCount
		endif

		if((CUST.CLINTM.modCount == 0) and (CUST.CLINTM.mainCount == 0))then
			BANCS.OUTPUT.SuccessOrFailure = "F"
			sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_e = urhk_SetOrbOut("Error_0|Error ^" + " No Record to Verify "+ "^dummy")
			goto drceqty
		endif

		sv_e = "mainEntityCreFlg|select entity_cre_flg from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_e = urhk_dbSelectWithBind(sv_e)
		if(sv_e == 0)then
			CUST.CLINTM.mainEntityCreFlg = BANCS.OUTPARAM.mainEntityCreFlg
			print(CUST.CLINTM.mainEntityCreFlg)
			if((CUST.CLINTM.mainEntityCreFlg == "Y") and (CUST.CLINTM.modCount == 0))then
				BANCS.OUTPUT.SuccessOrFailure = "F"
				sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Record already in Verified State."+ "^dummy")
				goto drceqty
			endif
		endif

		print(CUST.CLINTM.mainEntityCreFlg)
		print(CUST.CLINTM.modCount)
		print(CUST.CLINTM.mainCount)
		if((CUST.CLINTM.mainEntityCreFlg == "N") and ((CUST.CLINTM.modCount == 1) or (CUST.CLINTM.mainCount == 1)))then
			sv_u = "lchgUserId|select lchg_user_id from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
			sv_u = urhk_dbSelectWithBind(sv_u)
			if(sv_u == 0)then
				CUST.CLINTM.lchgUserId = BANCS.OUTPARAM.lchgUserId
				if(CUST.CLINTM.lchgUserId != BANCS.STDIN.userId)then
					sv_v = "custPrefInt,acctPrefInt,chnlPrefInt,negotiatedRate,minInt,maxInt,startDate,endDate,intAppliedStatus|"
					sv_v = sv_v + "select cust_dr_pref_pcnt,id_dr_pref_pcnt,chnl_dr_pref_pcnt,negotiated_rate_dr,min_int_pcnt_dr,"
					sv_v = sv_v + "max_int_pcnt_dr,to_char(start_date,'dd-mm-yyyy'),to_char(end_date,'dd-mm-yyyy'),float_interest_applied_status " 
					sv_v = sv_v + "from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
					print(sv_v)
					BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
					sv_v = urhk_dbSelectWithBind(sv_v)
					print(sv_v)
					if(sv_v == 0)then
						CUST.CLINTM.custPrefInt = cdouble(BANCS.OUTPARAM.custPrefInt)
						CUST.CLINTM.acctPrefInt = cdouble(BANCS.OUTPARAM.acctPrefInt)
						CUST.CLINTM.chnlPrefInt = cdouble(BANCS.OUTPARAM.chnlPrefInt)
						CUST.CLINTM.negotiatedRate = cdouble(BANCS.OUTPARAM.negotiatedRate)
						CUST.CLINTM.minInt = cdouble(BANCS.OUTPARAM.minInt)
						CUST.CLINTM.maxInt = cdouble(BANCS.OUTPARAM.maxInt)
						CUST.CLINTM.startDate = BANCS.OUTPARAM.startDate
						CUST.CLINTM.endDate = BANCS.OUTPARAM.endDate
						CUST.CLINTM.intAppliedStatus = BANCS.OUTPARAM.intAppliedStatus
						sv_a = urhk_SetOrbOut("custPrefInt|"+ CUST.CLINTM.custPrefInt)
						sv_a = urhk_SetOrbOut("acctPrefInt|"+ CUST.CLINTM.acctPrefInt)
						sv_a = urhk_SetOrbOut("chnlPrefInt|"+ CUST.CLINTM.chnlPrefInt)
						sv_a = urhk_SetOrbOut("negotiatedRate|"+ CUST.CLINTM.negotiatedRate)
						sv_a = urhk_SetOrbOut("minInt|"+ CUST.CLINTM.minInt)
						sv_a = urhk_SetOrbOut("maxInt|"+ CUST.CLINTM.maxInt)
						sv_a = urhk_SetOrbOut("startDate|"+ CUST.CLINTM.startDate)
						sv_a = urhk_SetOrbOut("endDate|"+ CUST.CLINTM.endDate)
						sv_a = urhk_SetOrbOut("intAppliedStatus|"+ CUST.CLINTM.intAppliedStatus)

						BANCS.OUTPUT.SuccessOrFailure = "S"
						sv_s = urhk_SetOrbOut("SuccessOrFailure|Y")
						goto drceqty
					endif
				else
					BANCS.OUTPUT.SuccessOrFailure = "F"
					sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
					sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Same user can not verify. "+ "^dummy")
					goto drceqty
				endif
			endif
		endif
		#--------------Verify wothout Modify.
		if((CUST.CLINTM.mainEntityCreFlg == "N") and (CUST.CLINTM.modCount == 0) and (CUST.CLINTM.mainCount == 1))then
			sv_u = "rcreUserId|select rcre_user_id from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
			sv_u = urhk_dbSelectWithBind(sv_u)
			if(sv_u == 0)then
				CUST.CLINTM.rcreUserId = BANCS.OUTPARAM.rcreUserId
				if(CUST.CLINTM.rcreUserId != BANCS.STDIN.userId)then
					sv_v = "custPrefInt,acctPrefInt,chnlPrefInt,negotiatedRate,minInt,maxInt,startDate,endDate,intAppliedStatus|"
					sv_v = sv_v + "select cust_dr_pref_pcnt,id_dr_pref_pcnt,chnl_dr_pref_pcnt,negotiated_rate_dr,min_int_pcnt_dr,"
					sv_v = sv_v + "max_int_pcnt_dr,to_char(start_date,'dd-mm-yyyy'),to_char(end_date,'dd-mm-yyyy'),float_interest_applied_status " 
					sv_v = sv_v + "from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
					print(sv_v)
					BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
					sv_v = urhk_dbSelectWithBind(sv_v)
					print(sv_v)
					if(sv_v == 0)then
						CUST.CLINTM.custPrefInt = cdouble(BANCS.OUTPARAM.custPrefInt)
						CUST.CLINTM.acctPrefInt = cdouble(BANCS.OUTPARAM.acctPrefInt)
						CUST.CLINTM.chnlPrefInt = cdouble(BANCS.OUTPARAM.chnlPrefInt)
						CUST.CLINTM.negotiatedRate = cdouble(BANCS.OUTPARAM.negotiatedRate)
						CUST.CLINTM.minInt = cdouble(BANCS.OUTPARAM.minInt)
						CUST.CLINTM.maxInt = cdouble(BANCS.OUTPARAM.maxInt)
						CUST.CLINTM.startDate = BANCS.OUTPARAM.startDate
						CUST.CLINTM.endDate = BANCS.OUTPARAM.endDate
						CUST.CLINTM.intAppliedStatus = BANCS.OUTPARAM.intAppliedStatus
						sv_a = urhk_SetOrbOut("custPrefInt|"+ CUST.CLINTM.custPrefInt)
						sv_a = urhk_SetOrbOut("acctPrefInt|"+ CUST.CLINTM.acctPrefInt)
						sv_a = urhk_SetOrbOut("chnlPrefInt|"+ CUST.CLINTM.chnlPrefInt)
						sv_a = urhk_SetOrbOut("negotiatedRate|"+ CUST.CLINTM.negotiatedRate)
						sv_a = urhk_SetOrbOut("minInt|"+ CUST.CLINTM.minInt)
						sv_a = urhk_SetOrbOut("maxInt|"+ CUST.CLINTM.maxInt)
						sv_a = urhk_SetOrbOut("startDate|"+ CUST.CLINTM.startDate)
						sv_a = urhk_SetOrbOut("endDate|"+ CUST.CLINTM.endDate)
						sv_a = urhk_SetOrbOut("intAppliedStatus|"+ CUST.CLINTM.intAppliedStatus)

						BANCS.OUTPUT.SuccessOrFailure = "S"
						sv_s = urhk_SetOrbOut("SuccessOrFailure|Y")
						goto drceqty
					endif
				else
					BANCS.OUTPUT.SuccessOrFailure = "F"
					sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
					sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Same user can not verify. "+ "^dummy")
					goto drceqty
				endif
			endif
		endif
		#--------------------------------------------------------

	drcmod:
		sv_m = "mainCount|select count(1) from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.mainCoun = BANCS.OUTPARAM.mainCount
		endif

		sv_m = "modCount|select count(1) from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.modCount = BANCS.OUTPARAM.modCount
		endif
	
		if((CUST.CLINTM.mainCoun == 0) and (CUST.CLINTM.modCount == 0))then
			BANCS.OUTPUT.SuccessOrFailure = "F"
			sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_e = urhk_SetOrbOut("Error_0|Error ^" + " No Record to Modify. "+ "^dummy")
			goto drceqty
		endif

		if((CUST.CLINTM.mainCoun == 1) and (CUST.CLINTM.modCount == 1))then
			sv_m = "entityCreFlg|select entity_cre_flg from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
			sv_m = urhk_dbSelectWithBind(sv_m)
			if(sv_m == 0)then
				CUST.CLINTM.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
				if(CUST.CLINTM.entityCreFlg == "N")then
					BANCS.OUTPUT.SuccessOrFailure = "F"
					sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
					sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Record Pending for Verification. "+ "^dummy")
					goto drceqty
				endif
			endif
		endif

		if((CUST.CLINTM.mainCoun == 1) and (CUST.CLINTM.modCount == 0))then
			#--Populate main table values.
			sv_p = "custPrefInt,acctPrefInt,chnlPrefInt,negotiatedRate,minInt,maxInt,startDate,endDate,intAppliedStatus|"
			sv_p = sv_p + "select cust_dr_pref_pcnt,id_dr_pref_pcnt,chnl_dr_pref_pcnt,negotiated_rate_dr,min_int_pcnt_dr,"
			sv_p = sv_p + "max_int_pcnt_dr,to_char(start_date,'dd-mm-yyyy'),to_char(end_date,'dd-mm-yyyy'),float_interest_applied_status " 
			sv_p = sv_p + "from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
			print(sv_p)
			BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
			sv_p = urhk_dbSelectWithBind(sv_p)
			print(sv_p)
			if(sv_p == 0)then
				CUST.CLINTM.custPrefInt = cdouble(BANCS.OUTPARAM.custPrefInt)
				CUST.CLINTM.acctPrefInt = cdouble(BANCS.OUTPARAM.acctPrefInt)
				CUST.CLINTM.chnlPrefInt = cdouble(BANCS.OUTPARAM.chnlPrefInt)
				CUST.CLINTM.negotiatedRate = cdouble(BANCS.OUTPARAM.negotiatedRate)
				CUST.CLINTM.minInt = cdouble(BANCS.OUTPARAM.minInt)
				CUST.CLINTM.maxInt = cdouble(BANCS.OUTPARAM.maxInt)
				CUST.CLINTM.startDate = BANCS.OUTPARAM.startDate
				CUST.CLINTM.endDate = BANCS.OUTPARAM.endDate
				CUST.CLINTM.intAppliedStatus = BANCS.OUTPARAM.intAppliedStatus
				sv_p = urhk_SetOrbOut("custPrefInt|"+ CUST.CLINTM.custPrefInt)
				sv_p = urhk_SetOrbOut("acctPrefInt|"+ CUST.CLINTM.acctPrefInt)
				sv_p = urhk_SetOrbOut("chnlPrefInt|"+ CUST.CLINTM.chnlPrefInt)
				sv_p = urhk_SetOrbOut("negotiatedRate|"+ CUST.CLINTM.negotiatedRate)
				sv_p = urhk_SetOrbOut("minInt|"+ CUST.CLINTM.minInt)
				sv_p = urhk_SetOrbOut("maxInt|"+ CUST.CLINTM.maxInt)
				sv_p = urhk_SetOrbOut("startDate|"+ CUST.CLINTM.startDate)
				sv_p = urhk_SetOrbOut("endDate|"+ CUST.CLINTM.endDate)
				sv_p = urhk_SetOrbOut("intAppliedStatus|"+ CUST.CLINTM.intAppliedStatus)

				BANCS.OUTPUT.SuccessOrFailure = "S"
				sv_s = urhk_SetOrbOut("SuccessOrFailure|Y")
				goto drceqty
			endif
		endif
		
	drcxcl:
		sv_m = "mainCount|select count(1) from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.mainCount = BANCS.OUTPARAM.mainCount
		endif

		sv_m = "modCount|select count(1) from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.modCount = BANCS.OUTPARAM.modCount
		endif
	
		print(CUST.CLINTM.mainCount)
		print(CUST.CLINTM.modCount)
		if((CUST.CLINTM.mainCount == 0) and (CUST.CLINTM.modCount == 0))then
			BANCS.OUTPUT.SuccessOrFailure = "F"
			sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_e = urhk_SetOrbOut("Error_0|Error ^" + " No Record to Cancel. "+ "^dummy")
			goto drceqty
		endif

		if((CUST.CLINTM.mainCount == 1) and (CUST.CLINTM.modCount == 1))then
			BANCS.OUTPUT.SuccessOrFailure = "F"
			sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Cancel not Allowed, Record Pending for Verification. "+ "^dummy")
			goto drceqty
		endif

		if((CUST.CLINTM.mainCount == 1) and (CUST.CLINTM.modCount == 0))then
		sv_f = "entityCreFlg,rcreUserId|select entity_cre_flg,rcre_user_id from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
                BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
                sv_f = urhk_dbSelectWithBind(sv_f)
                if(sv_f == 0)then
                        CUST.CLINTM.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
                        CUST.CLINTM.rcreUserId = BANCS.OUTPARAM.rcreUserId
			if((CUST.CLINTM.entityCreFlg == "Y") and (CUST.CLINTM.modCount == 0))then
				BANCS.OUTPUT.SuccessOrFailure = "F"
				sv_e = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_e = urhk_SetOrbOut("Error_0|Error ^" + " Record is already Verified, Cancel not allowed. "+ "^dummy")
				goto drceqty
			endif 

			if((CUST.CLINTM.entityCreFlg == "N") and (CUST.CLINTM.rcreUserId == BANCS.STDIN.userId) and (CUST.CLINTM.modCount == 0))then
				sv_x = "custPrefInt,acctPrefInt,chnlPrefInt,negotiatedRate,minInt,maxInt,startDate,endDate,intAppliedStatus|"
				sv_x = sv_x + "select cust_dr_pref_pcnt,id_dr_pref_pcnt,chnl_dr_pref_pcnt,negotiated_rate_dr,min_int_pcnt_dr,"
				sv_x = sv_x + "max_int_pcnt_dr,to_char(start_date,'dd-mm-yyyy'),to_char(end_date,'dd-mm-yyyy'),float_interest_applied_status " 
				sv_x = sv_x + "from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
				print(sv_x)
				BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
				sv_x = urhk_dbSelectWithBind(sv_x)
				print(sv_x)
				if(sv_x == 0)then
					CUST.CLINTM.custPrefInt = cdouble(BANCS.OUTPARAM.custPrefInt)
					CUST.CLINTM.acctPrefInt = cdouble(BANCS.OUTPARAM.acctPrefInt)
					CUST.CLINTM.chnlPrefInt = cdouble(BANCS.OUTPARAM.chnlPrefInt)
					CUST.CLINTM.negotiatedRate = cdouble(BANCS.OUTPARAM.negotiatedRate)
					CUST.CLINTM.minInt = cdouble(BANCS.OUTPARAM.minInt)
					CUST.CLINTM.maxInt = cdouble(BANCS.OUTPARAM.maxInt)
					CUST.CLINTM.startDate = BANCS.OUTPARAM.startDate
					CUST.CLINTM.endDate = BANCS.OUTPARAM.endDate
					CUST.CLINTM.intAppliedStatus = BANCS.OUTPARAM.intAppliedStatus
					sv_a = urhk_SetOrbOut("custPrefInt|"+ CUST.CLINTM.custPrefInt)
					sv_a = urhk_SetOrbOut("acctPrefInt|"+ CUST.CLINTM.acctPrefInt)
					sv_a = urhk_SetOrbOut("chnlPrefInt|"+ CUST.CLINTM.chnlPrefInt)
					sv_a = urhk_SetOrbOut("negotiatedRate|"+ CUST.CLINTM.negotiatedRate)
					sv_a = urhk_SetOrbOut("minInt|"+ CUST.CLINTM.minInt)
					sv_a = urhk_SetOrbOut("maxInt|"+ CUST.CLINTM.maxInt)
					sv_a = urhk_SetOrbOut("startDate|"+ CUST.CLINTM.startDate)
					sv_a = urhk_SetOrbOut("endDate|"+ CUST.CLINTM.endDate)
					sv_a = urhk_SetOrbOut("intAppliedStatus|"+ CUST.CLINTM.intAppliedStatus)

					BANCS.OUTPUT.SuccessOrFailure = "S"
					sv_s = urhk_SetOrbOut("SuccessOrFailure|Y")
					goto drceqty
				endif
			endif
                endif
                endif


drceqty:
exitscript
trace off
end-->
