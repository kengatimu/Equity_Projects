<--START
TRACE ON

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST","DATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","DATA",5)
        #}
        ENDIF

        CUST.DATA.acctNum = " "
        CUST.DATA.chrgCrncy = " "
        CUST.DATA.chrgAmt = " "
        CUST.DATA.vatAmt = " "

        IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
        #{
                IF(BANCS.INPUT.acctNum !="")THEN
                #{
                        CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
                        PRINT(CUST.DATA.acctNum)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Account Number not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Account Number not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "chrgAmt,chrgCrncy,vatAmt|SELECT CHRG_AMT,CHRG_CRNCY_CODE,VAT_AMT FROM CUSTOM.SANLIM_TRAN WHERE ODACCT_NUM= ?SVAR AND "
	sv_s = sv_s +"CHRG_INIT_MENU=?SVAR AND POST_FLG='N' AND BANK_ID=?SVAR"
        BANCS.INPARAM.BINDVARS = CUST.DATA.acctNum +"|"+ BANCS.STDIN.menuId +"|"+ BANCS.STDIN.contextBankId
        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
		CUST.DATA.chrgCrncy = BANCS.OUTPARAM.chrgCrncy
		CUST.DATA.chrgAmt = BANCS.OUTPARAM.chrgAmt
		CUST.DATA.vatAmt = BANCS.OUTPARAM.vatAmt
		PRINT(CUST.DATA.chrgCrncy)
		PRINT(CUST.DATA.chrgAmt)
		PRINT(CUST.DATA.vatAmt)
	#}
	ENDIF	


ENDOFSCRIPT:

	PRINT(CUST.DATA.chrgCrncy)
	PRINT(CUST.DATA.chrgAmt)
	PRINT(CUST.DATA.vatAmt)

        sv_u = urhk_SetOrbOut("chrgCrncy|"+CUST.DATA.chrgCrncy)
        sv_u = urhk_SetOrbOut("chrgAmt|"+CUST.DATA.chrgAmt)
        sv_u = urhk_SetOrbOut("vatAmt|"+CUST.DATA.vatAmt)

TRACE OFF
END-->

