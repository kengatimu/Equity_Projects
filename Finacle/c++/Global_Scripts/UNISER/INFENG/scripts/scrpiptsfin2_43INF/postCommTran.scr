			EQT.COMM.tranDate = MID$(EQT.COMM.tranDate,0,10)
			sv_s ="Update custom.c_dntd set chrg_tran_id=?SVAR, chrg_tran_date=TO_DATE(?SVAR,'DD-MM-YYYY') ,"
			sv_s = sv_s + " tran_status='P' where tran_id=?SVAR and tran_date=TO_DATE(?SVAR,'DD-MM-YYYY') and bank_id=?SVAR "
			
			BANCS.INPARAM.BINDVARS = EQT.COMM.tranId + "|" + EQT.COMM.tranDate + "|" + EQT.CSH.cTranId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" +  MID$(EQT.CSH.cTranDate,0,10) + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				EQT.CSH.errorFlg ="Y"
				EQT.CSH.Msg ="Error in Updating Record in DB!!"
				
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
	ENDOFSCRIPT:
		
		IF(EQT.CSH.errorFlg =="Y") THEN
		#{
			if(EQT.COMM.Remarks !="0")THEN
			#{
				IF(TRIM(EQT.CSH.Msg) == "")THEN
				#{
					EQT.CSH.Msg =EQT.COMM.Remarks
				#}
				endif
			#}
			endif
			print(EQT.CSH.Msg)
			
			sv_s ="Update custom.c_dntd set tran_status='E', failure_remarks = ?SVAR"
			sv_s = sv_s + "  where tran_id=?SVAR and tran_date=TO_DATE(?SVAR,'DD-MM-YYYY') and bank_id=?SVAR "
			
			BANCS.INPARAM.BINDVARS = EQT.CSH.Msg + "|" + EQT.CSH.cTranId + "|" +  MID$(EQT.CSH.cTranDate,0,10)
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				EQT.CSH.errorFlg ="Y"
				EQT.CSH.Msg ="Error in Updating Record in DB!!"
				
			#}
			ENDIF
		#}
		endif
		IF(EQT.CSH.pstFlg=="N")THEN
		#{
			EQT.CSH.slCount = ""
			sv_s = "slCount|SELECT COUNT(1) FROM  CUSTOM.C_CHARGE_COLLECTION WHERE "
			sv_s = sv_s + " ACCT_NUM = ?SVAR AND TRAN_DATE = TO_DATE(sysdate,'DD-MM-YY') AND"
			sv_s = sv_s + " BANK_ID = ?SVAR "
			BANCS.INPARAM.BINDVARS = EQT.CSH.drAcct + "|"+ BANCS.STDIN.contextBankId

			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)

			IF(sv_d == 0)THEN
			#{
				sv_l = BANCS.OUTPARAM.slCount
				sv_l = CINT(sv_l) + 1
				EQT.CSH.slCount = sv_l
				PRINT(EQT.CSH.slCount)
			#}
			ENDIF

	
			EQT.CSH.totChrgAmount=CDOUBLE(EQT.CSH.commAmt)+CDOUBLE(EQT.CSH.vatAmt)
			PRINT(EQT.CSH.totChrgAmount)
	
			###Below steps added to reduce the error message string size to 100 Characters
			IF(STRLEN(EQT.CSH.Msg) >100)THEN
			#{
				sv_s="msgstr|SELECT SUBSTR(?SVAR,0,100) FROM DUAL"
				BANCS.INPARAM.BINDVARS = EQT.CSH.Msg
				PRINT(sv_s)
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF(sv_d == "0")THEN
				#{
					EQT.CSH.Msg = BANCS.OUTPARAM.msgstr
					PRINT(EQT.CSH.Msg)
				#}
				ENDIF
			#}
			ENDIF
			PRINT(EQT.CSH.Msg)
		
			sv_s = "INSERT INTO CUSTOM.C_CHARGE_COLLECTION (CHARGE_TYPE,SRL_NUM,ACCT_NUM,SOL_ID,ACCT_CRNCY_CODE,"
			sv_s = sv_s + "TRAN_DATE,CHARGE_AMT,VAT_AMT,TOTAL_CHARGE_AMT,CHARGE_CRNCY_CODE,TOT_ADJ_AMT,"
			sv_s = sv_s + "LAST_ADJUSTED_DATE,FULLY_ADJUSTED_FLG,LIEN_STATUS_FLG,LIEN_APPLIED_AMT,RCRE_USER_ID,"
			sv_s = sv_s + "RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,FAILURE_REMARKS) values "
			sv_s = sv_s + "(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
			sv_s = sv_s + "TO_DATE(sysdate,'DD-MM-YY'),?SVAR,?SVAR,?SVAR,?SVAR,0,"
			sv_s = sv_s + "'','N','N',0,?SVAR,"
			sv_s = sv_s + "SYSDATE,'','',?SVAR,?SVAR)"

			BANCS.INPARAM.BINDVARS = "DMGCHRG" + "|" + EQT.CSH.slCount + "|" + EQT.CSH.drAcct + "|" + BANCS.STDIN.mySolId + "|" + EQT.COMM.crAcctCrncy 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQT.CSH.commAmt + "|" + EQT.CSH.vatAmt + "|" + EQT.CSH.totChrgAmount
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQT.COMM.commCrncy + "|" + BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId  + "|" + EQT.CSH.Msg
	
			sv_q = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_q)
			IF(sv_q != 0)THEN
			#{
				EQT.CSH.errMsg = ""
				EQT.CSH.errMsg = EQT.CSH.drAcct + " Record insert failed"
				PRINT(EQT.CSH.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ELSE
			#{
				sv_q = urhk_dbSQLWithBind("COMMIT")
			#}
			ENDIF
		#}
		ENDIF
	LABEL_2:
		sv_u = urhk_SetOrbOut("errFlg|" + EQT.CSH.errorFlg)
		sv_u = urhk_SetOrbOut("message|" + EQT.CSH.Msg)
		
		sv_u = urhk_SetOrbOut("chrgTranId|" + EQT.COMM.tranId)
		sv_u = urhk_SetOrbOut("chrgTranDate|" + EQT.COMM.tranDate)
		
		DELETECLASS("EQT","CSH")
		DELETECLASS("EQT","COMM")
		DELETEREP("EQT")
		EXITSCRIPT
END-->
