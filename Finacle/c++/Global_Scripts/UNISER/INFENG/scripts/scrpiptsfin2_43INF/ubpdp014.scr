		sv_s = sv_s + "LCHG_USER_ID,LCHG_TIME,DENOM_VALUE,SOL_ID) "
	#}
	ELSE
	#{
		sv_s = sv_s + " TYP_OF_SERV,VAL_TYPE,CLG_ZONE_CODE,CLG_ZONE_DATE,SET_NUM,REM_DYN_FLD,SRL_NUM,NOTIFY_FLG,TREA_REF_NUM,TREA_RATE) "
	#}
	ENDIF

	sv_s = sv_s + " VALUES( "
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,?SVAR,?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,?SVAR,?SVAR,?SVAR,"
	sv_s = sv_s + " ?SVAR, ?SVAR,?SVAR,?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),"
	sv_s = sv_s + " to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),?SVAR,?SVAR,?SVAR,?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),?SVAR,?SVAR,?SVAR,"
        #IF(CUST.UBP.modeOfPay != "V")THEN
	IF(CUST.UBP.funcCode != "V")THEN
        #{
		sv_s = sv_s + " ?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,sysdate,?SVAR,?SVAR)"
	#}
	ELSE
	#{
		sv_s = sv_s + " ?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
	#}
	ENDIF

	sv_d = urhk_dbSQLWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d==0)THEN
	#{
		#sv_d = urhk_dbSqlWithBind("COMMIT")
		#}
	ELSE
		#{
		CUST.UBP.errorFlg = "Y"
		#CUST.UBP.errorMsg="Insertion to the scr failed"
		CUST.UBP.errorCode = "UBP_ERR028"
		CALL("ubpdp044.scr")
		CUST.UBP.errorMsg =CUST.UBP.errorDesc
		CUST.UBP.errorFocus="prodCode"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

