<--start
trace on

sv_a=BANCS.INPUT.crncy_code
sv_d=BANCS.INPUT.future_position

sv_s=BANCS.INPUT.today_position
print(sv_a)
print(sv_d)
print(sv_s)
sv_w=CDOUBLE(sv_d)
sv_z=CDOUBLE(sv_s)

if(sv_w<0) then
sv_p=-sv_w
BANCS.OUTPUT.future_crd_dbt="Dr."
else
sv_p=sv_w
BANCS.OUTPUT.future_crd_dbt="Cr."
endif
print(sv_p)

if(sv_z<0) then
sv_q=-sv_z
BANCS.OUTPUT.crd_dbt="Dr."
else
sv_q=sv_z
BANCS.OUTPUT.crd_dbt="Cr."
endif
print(sv_q)
#sv_t = FORMAT$(sv_q,"%2.2f") + "|" + sv_a
#sv_t = sv_q + "|" + sv_a 
#print(sv_t)
#sv_s = urhk_B2k_validateAmtWithCrncy(sv_t)
#sv_l=BANCS.OUTPARAM.OutputAmount
#sv_m = FORMAT$(sv_p,"%2.2f") + "|" + sv_a
#sv_n = urhk_B2k_validateAmtWithCrncy(sv_m)
#sv_o = BANCS.OUTPARAM.OutputAmount	
#Today position
	sv_f = getPosition(sv_s,"|")
	if(sv_f == 0) then
		sv_f = strlen(sv_s) + 1
	endif
	sv_g = MID$(sv_s,0,(sv_f-1))
	sv_g = CDOUBLE(sv_g)
	sv_g = Format$(sv_g, "%.2f")

	if (sv_g < 0 ) then
		sv_g= LTRIM(sv_g, ' ')
		sv_g= LTRIM(sv_g, '-')
	endif
	
	BANCS.INPARAM.InputAmount = sv_g
	BANCS.INPARAM.FromCurrency = sv_a
	BANCS.INPARAM.AmountWidth = 35 
	sv_m = urhk_B2k_floatWithComma("")
	if(sv_m == 0) then
		sv_l = BANCS.OUTPARAM.OutputAmount
	endif

#Future position
	sv_f = getPosition(sv_d,"|")
	if(sv_f == 0) then
		sv_f = strlen(sv_d) + 1
	endif
	sv_g = MID$(sv_d,0,(sv_f-1))
	sv_g = CDOUBLE(sv_g)
	sv_g = Format$(sv_g, "%.2f")

	if (sv_g < 0 ) then
		sv_g= LTRIM(sv_g, ' ')
		sv_g= LTRIM(sv_g, '-')
	endif
	BANCS.INPARAM.InputAmount = sv_g
	BANCS.INPARAM.FromCurrency = sv_a
	BANCS.INPARAM.AmountWidth = 35 
	sv_m = urhk_B2k_floatWithComma("")
	if(sv_m == 0) then
		sv_o = BANCS.OUTPARAM.OutputAmount
	endif	

##### CCY Validation
#Future Position
sv_t = sv_o + "|" + sv_a
sv_b = urhk_B2k_validateAmtWithCrncy(sv_t)
if(sv_b == 0) then
	BANCS.OUTPUT.future_position = sv_o
else
	BANCS.INPUT.ErrorMesg="Invalid amount"
endif
#Today Position
sv_m = sv_l + "|" + sv_a
sv_n = urhk_B2k_validateAmtWithCrncy(sv_m)
if(sv_n == 0) then 
	BANCS.OUTPUT.today_position = sv_l
else
	BANCS.INPUT.ErrorMesg="Invalid amount"
endif

print(BANCS.OUTPUT.future_position)
print(BANCS.OUTPUT.today_position)

sv_x = BANCS.INPUT.emp_id

sv_c=BANCS.INPUT.context_sol_id
if(BANCS.INPUT.numOfRec == "") then
     sv_c = 0
else
	 sv_c = CINT(BANCS.INPUT.numOfRec)
endif

sv_c = sv_c + 1

BANCS.OUTPUT.numOfRec=sv_c

BANCS.OUTPUT.crncy_desc = ""
BANCS.OUTPUT.future_position = ""

sv_b=urhk_GetDesc("validateCrncyCode|crncyCode=" + sv_a + "|crncyCodeDesc=&crncyDesc")

if(sv_b == 0) then
sv_c = BANCS.OUTPARAM.crncyDesc
BANCS.OUTPUT.crncy_desc = sv_c
endif

if(sv_w < 0) then
BANCS.OUTPUT.future_position = sv_o
BANCS.OUTPUT.future_crd_dbt="Dr."
else
BANCS.OUTPUT.future_position = sv_o
BANCS.OUTPUT.future_crd_dbt="Cr."
endif

if(sv_z < 0) then
BANCS.OUTPUT.today_position = sv_l
BANCS.OUTPUT.crd_dbt="Dr."
else
BANCS.OUTPUT.today_position = sv_l
BANCS.OUTPUT.crd_dbt="Cr."
endif

#trace off
end-->
