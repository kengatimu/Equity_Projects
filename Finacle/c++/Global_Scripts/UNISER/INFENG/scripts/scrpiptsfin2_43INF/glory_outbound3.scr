			CUST.INTERFACE.value100000 = FORMAT$(CDOUBLE(CUST.INTERFACE.value100000),"%.2f")
			PRINT(CUST.INTERFACE.value100000)
			#}
		ELSE
			#{
			CUST.INTERFACE.value100000 = ""
		#}
		ENDIF
		sv_y =""
		sv_z =""
		sv_x = CUST.INTERFACE.response
		sv_y = "<count100000>"
		sv_z = "</count100000>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.count100000 = MID$(sv_x, sv_b, (sv_e - sv_b))
			PRINT(CUST.INTERFACE.count100000)
			#}
		ELSE
			#{
			CUST.INTERFACE.count100000 = ""
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.response="3"
		PRINT(CUST.INTERFACE.response)
		
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
		#TRACE OFF
END-->
