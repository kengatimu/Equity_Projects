	##################################
	# Calculate Finacle System Interest #
	##################################
	
	sv_s = "intAmt1|"
	sv_s = sv_s + "select sum(base_amount) from tbaadm.int_adm where acid=?SVAR AND start_date <= to_date(?SVAR,'dd-mm-yyyy') AND bank_id=?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+CUST.EQB.intDate+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.intAmt1=BANCS.OUTPARAM.intAmt1
		PRINT(CUST.EQB.intAmt1)
		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to retrieve Finacle SYSTEM Interest"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	sv_s = "totDays,intDays,totAmt2,intAmt2|"
	sv_s = sv_s + "select (end_date - start_date)+1,(to_date(?SVAR,'dd-mm-yyyy')-start_date)+1,BASE_AMOUNT,"
	sv_s = sv_s + " cast((BASE_AMOUNT/(end_date - start_date+1))*(to_date(?SVAR,'dd-mm-yyyy')-start_date+1) as numeric(20,2)) "
	sv_s = sv_s + "from tbaadm.int_adm where acid=?SVAR  AND start_date <= to_date(?SVAR,'dd-mm-yyyy') AND end_date >= to_date(?SVAR,'dd-mm-yyyy') AND bank_id=?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.intDate+"|"+CUST.EQB.intDate+"|"+CUST.EQB.lAcid+"|"+CUST.EQB.intDate+"|"+CUST.EQB.intDate+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.totDays=BANCS.OUTPARAM.totDays
		PRINT(CUST.EQB.totDays)
		
		CUST.EQB.intDays=BANCS.OUTPARAM.intDays
		PRINT(CUST.EQB.intDays)
		
		CUST.EQB.totAmt2=BANCS.OUTPARAM.totAmt2
		PRINT(CUST.EQB.totAmt2)
		
