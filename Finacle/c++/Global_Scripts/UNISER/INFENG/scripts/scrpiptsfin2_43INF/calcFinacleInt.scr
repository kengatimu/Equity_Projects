	#}
	ELSE
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to retrieve Migrated Adjustment amount"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.EQB.finInt=CDOUBLE(CUST.EQB.finInt)-CDOUBLE(CUST.EQB.migAdjAmt)
	PRINT(CUST.EQB.finInt)	
	
	ENDOFSCRIPT:
		PRINT(CUST.EQB.errorFlg)
