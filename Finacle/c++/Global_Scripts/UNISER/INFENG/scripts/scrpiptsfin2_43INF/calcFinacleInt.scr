		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to retrieve Finacle SYSTEM Interest"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.EQB.finInt=CDOUBLE(CUST.EQB.intAmt2)+CDOUBLE(CUST.EQB.intAmt1)-CDOUBLE(CUST.EQB.totAmt2)
	PRINT(CUST.EQB.finInt)
	
		##################################
	# Calculate Migrated Adjustment amount #
	##################################
	
	sv_s = "migAdjAmt|"
	sv_s = sv_s + "select sum(adjustment_amt) from tbaadm.iar where entity_id=?SVAR AND entity_type = 'ACCNT' and applied_flg='Y' and int_run_ind='D' and del_flg='N' and entity_cre_flg='Y' AND bank_id=?SVAR"
	sv_s = sv_s + " and application_date=to_date(?SVAR,'dd-mm-yyyy')"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId+"|"+CUST.EQB.migDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.migAdjAmt=BANCS.OUTPARAM.migAdjAmt
