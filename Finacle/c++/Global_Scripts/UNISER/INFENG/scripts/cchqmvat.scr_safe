						CUST.CHQB.total_chrgAmt = CDOUBLE(CUST.CHQB.income_amt) + CDOUBLE(CUST.CHQB.vat_amt)
						PRINT(CUST.CHQB.total_chrgAmt)
						
						sv_p = GETPOSITION(CUST.CHQB.income_amt,".")
						PRINT(sv_p)
						
						IF(sv_p > 0)THEN
						#{
							CUST.CHQB.income_amt = MID$(CUST.CHQB.income_amt,0,sv_p + 2)
							PRINT(CUST.CHQB.income_amt)
						#}
						ENDIF
						
						sv_p = GETPOSITION(CUST.CHQB.vat_amt,".")
						PRINT(sv_p)
						
						IF(sv_p > 0)THEN
						#{
