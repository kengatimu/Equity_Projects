						PRINT(CUST.CHQB.AmountTableCode)
						CUST.CHQB.totChqleaves = CINT(CUST.CHQB.noOfChqs) * CINT(CUST.CHQB.leaves)
						PRINT(CUST.CHQB.totChqleaves)
						
						#---------------------------------------------------------
						# Selecting charge amt for one chq leave
						# based on ASTM code CHQI  & calculating tot income amount
						#---------------------------------------------------------
						BANCS.INPARAM.InputAmount = CUST.CHQB.amount
						BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
						BANCS.INPARAM.AmountTableCode = CUST.CHQB.AmountTableCode
						
						sv_u = urhk_B2k_GetASTMAmount("")
						PRINT(sv_u)
						
						IF (sv_u == 1) THEN
						#{
							CUST.CHQB.errorFlg="Y"
							CUST.CHQB.Msg="Unable to find the charge table code cheque book commision"
							#											sv_c = urhk_SetOrbOut("Error_01|ERROR:^Unable to find the charge table code cheque book commision")
							#											sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						
						CUST.CHQB.outAmount = BANCS.OUTPARAM.OutputAmount
						PRINT(BANCS.OUTPARAM.OutputAmount)
						PRINT(CUST.CHQB.outAmount)
						
						CUST.CHQB.income_amt = CDOUBLE(CUST.CHQB.totChqleaves) * CDOUBLE(CUST.CHQB.outAmount)
						PRINT(CUST.CHQB.income_amt)
						CUST.CHQB.vat_amt = CDOUBLE(CUST.CHQB.income_amt)* (0.01) * CDOUBLE(CUST.CHQB.vatpcnt)
						PRINT(CUST.CHQB.vat_amt)
						CUST.CHQB.total_chrgAmt = CDOUBLE(CUST.CHQB.income_amt) + CDOUBLE(CUST.CHQB.vat_amt)
						PRINT(CUST.CHQB.total_chrgAmt)
						
						sv_p = GETPOSITION(CUST.CHQB.income_amt,".")
						PRINT(sv_p)
						
						IF(sv_p > 0)THEN
						#{
							CUST.CHQB.income_amt = MID$(CUST.CHQB.income_amt,0,sv_p + 2)
							PRINT(CUST.CHQB.income_amt)
						#}
						ENDIF
						
						sv_p = GETPOSITION(CUST.CHQB.vat_amt,".")
						PRINT(sv_p)
						
						IF(sv_p > 0)THEN
						#{
							CUST.CHQB.vat_amt = MID$(CUST.CHQB.vat_amt,0,sv_p + 2)
							PRINT(CUST.CHQB.vat_amt)
						#}
						ENDIF
						
						sv_p = GETPOSITION(CUST.CHQB.total_chrgAmt,".")
						PRINT(sv_p)
						
						IF(sv_p > 0)THEN
						#{
							CUST.CHQB.total_chrgAmt = MID$(CUST.CHQB.total_chrgAmt,0,sv_p + 2)
							PRINT(CUST.CHQB.total_chrgAmt)
						#}
						ENDIF
						#IF(CUST.CHQB.isDummy =="Y") THEN
						#{
						CUST.CHQB.Msg = "For the available amount, a charge of  " + CUST.CHQB.income_amt + " " + BANCS.STDIN.homeCrncyCode
						CUST.CHQB.Msg = CUST.CHQB.Msg + " AND VAT of  " +  CUST.CHQB.vat_amt + " " + BANCS.STDIN.homeCrncyCode +" making a total charge of  " + CUST.CHQB.total_chrgAmt + " " + BANCS.STDIN.homeCrncyCode + " will be applicable."
						CUST.CHQB.Msg = CUST.CHQB.Msg + " DO you want to continue? Click Ok to Continue with the charge AND Cancel to terminate the transaction."
						
						#}
						#ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#	#}
	#	ENDIF
	ENDOFSCRIPT:
		sv_u = urhk_SetOrbOut("errFlg|" + CUST.CHQB.errorFlg)
		IF(CUST.CHQB.Msg != "") THEN
		#{
			PRINT(CUST.CHQB.Msg)
			sv_u = urhk_SetOrbOut("message|" + CUST.CHQB.Msg)
		#}
		ENDIF
		TRACE OFF
END-->
