#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_p = urhk_B2k_PrintRepos("BANCS")
        print(sv_p)
        if(fieldexists(BANCS.STDIN.menuId)==1)then
                print(BANCS.STDIN.menuId)
        endif
        EQSRV.GLBDATA.rateCode = " "
        EQSRV.GLBDATA.rate = " "
        EQSRV.GLBDATA.treaRate = " "
        EQSRV.GLBDATA.errorFlg = "N"
        EQSRV.GLBDATA.errorMsg = "S"
        if((BANCS.STDIN.menuId=="HCAAC")or(BANCS.STDIN.menuId=="HCAACTD")or(BANCS.STDIN.menuId=="HOAACTD")or(BANCS.STDIN.menuId=="HOAACTU"))then
                if(fieldexists(BANCS.INPUT.tranType)==1)then
                        EQSRV.GLBDATA.tranType = BANCS.INPUT.tranType
                else
                        EQSRV.GLBDATA.tranType = ""
                endif
                if(fieldexists(BANCS.INPUT.crncyCode)==1)then
                        EQSRV.GLBDATA.crncyCode = BANCS.INPUT.crncyCode
                else
                        EQSRV.GLBDATA.crncyCode = ""
                endif
                if(fieldexists(BANCS.INPUT.acctCrncy)==1)then
                        EQSRV.GLBDATA.acctCrncy = BANCS.INPUT.acctCrncy
                else
                        EQSRV.GLBDATA.acctCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.xferAcctId)==1)then
                        EQSRV.GLBDATA.xferAcctId = BANCS.INPUT.xferAcctId
                else
                        EQSRV.GLBDATA.xferAcctId = ""
                endif
                if(EQSRV.GLBDATA.xferAcctId!="")then
                sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.xferAcctId)
                if(sv_u==0)then
                        EQSRV.GLBDATA.toCrncy = BANCS.OUTPARAM.acctCrncyCode
                else
                        EQSRV.GLBDATA.toCrncy = ""
                endif
                else
                        EQSRV.GLBDATA.toCrncy = ""
                endif
                if(EQSRV.GLBDATA.acctCrncy==EQSRV.GLBDATA.toCrncy)then
                        EQSRV.GLBDATA.errorFlg = "Y"
                        EQSRV.GLBDATA.errorMsg = "S"
                        goto ENDRES
                endif
                if((EQSRV.GLBDATA.tranType=="T") and (EQSRV.GLBDATA.toCrncy!="") and (EQSRV.GLBDATA.toCrncy!=EQSRV.GLBDATA.acctCrncy))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'T',?SVAR)from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acctCrncy + "|" + EQSRV.GLBDATA.toCrncy + "|" + BANCS.STDIN.menuId
                endif
                if(EQSRV.GLBDATA.tranType=="C")then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'C',?SVAR)from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acctCrncy + "|" + EQSRV.GLBDATA.crncyCode + "|" + BANCS.STDIN.menuId
                endif
                print(sv_d)
                print(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u==0)then
                        EQSRV.GLBDATA.ortCode = BANCS.OUTPARAM.ortCode
                else
                        EQSRV.GLBDATA.ortCode = ""
                        EQSRV.GLBDATA.errorFlg = "Y"
                        EQSRV.GLBDATA.errorMsg = "Rate Derivation Failed"
                endif
                if(EQSRV.GLBDATA.ortCode!="")then
                        sv_l = strlen(EQSRV.GLBDATA.ortCode)
                        sv_f = mid$(EQSRV.GLBDATA.ortCode,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.rateCode = mid$(sv_f,0,(sv_p-1))
                        print(EQSRV.GLBDATA.rateCode)
                        EQSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                        print(EQSRV.GLBDATA.trSting)
                        sv_l = strlen(EQSRV.GLBDATA.trSting)
                        sv_f = mid$(EQSRV.GLBDATA.trSting,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.rate  = mid$(sv_f,0,(sv_p-1))
                        print(EQSRV.GLBDATA.rate)
                        EQSRV.GLBDATA.treaRate = mid$(sv_f,sv_p,sv_l)
                        print(EQSRV.GLBDATA.treaRate)
                endif
        endif
        #if((BANCS.STDIN.menuId=="OGM")or(BANCS.STDIN.menuId=="IGM")or(BANCS.STDIN.menuId=="HLADISB")or(BANCS.STDIN.menuId=="HPAYOFF")or(BANCS.STDIN.menuId=="ODCM")or(BANCS.STDIN.menuId=="IDCM")or(BANCS.STDIN.menuId=="HLASPAY")or(BANCS.STDIN.menuId=="HIRM") or (BANCS.STDIN.menuId=="HORM")or(BANCS.STDIN.menuId=="HLAUPAY"))then
        if((BANCS.STDIN.menuId=="OGM")or(BANCS.STDIN.menuId=="IGM")or(BANCS.STDIN.menuId=="HLADISB")or(BANCS.STDIN.menuId=="HPAYOFF")or(BANCS.STDIN.menuId=="ODCM")or(BANCS.STDIN.menuId=="IDCM") or(BANCS.STDIN.menuId=="HIRM") or (BANCS.STDIN.menuId=="HORM")or(BANCS.STDIN.menuId=="HLAUPAY"))then
	#{
                if(fieldexists(BANCS.INPUT.mopId) == 1)then
                        EQSRV.GLBDATA.mopId = BANCS.INPUT.mopId
                else
                        EQSRV.GLBDATA.mopId = ""
                endif
                if(fieldexists(BANCS.INPUT.pageName) == 1)then
                        EQSRV.GLBDATA.pageName = BANCS.INPUT.pageName
                else
                        EQSRV.GLBDATA.pageName = ""
                endif
                if(fieldexists(BANCS.INPUT.funcCode) == 1)then
                        EQSRV.GLBDATA.funcCode = BANCS.INPUT.funcCode
                else
                        EQSRV.GLBDATA.funcCode = ""
                endif
                if(fieldexists(BANCS.INPUT.acctCrncy) == 1)then
                        EQSRV.GLBDATA.acctCrncy = BANCS.INPUT.acctCrncy
                else
                        EQSRV.GLBDATA.acctCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.chrgDrAcct) == 1)then
                        EQSRV.GLBDATA.chrgDrAcct = BANCS.INPUT.chrgDrAcct
                else
                        EQSRV.GLBDATA.chrgDrAcct = ""
                endif
                if(fieldexists(BANCS.INPUT.creditAcctNum) == 1)then
                        EQSRV.GLBDATA.creditAcctNum = BANCS.INPUT.creditAcctNum
                else
                        EQSRV.GLBDATA.creditAcctNum = ""
                endif
                if(fieldexists(BANCS.INPUT.bgCrncyCode) == 1)then
                        EQSRV.GLBDATA.bgCrncyCode = BANCS.INPUT.bgCrncyCode
                else
                        EQSRV.GLBDATA.bgCrncyCode = ""
                endif
                if(fieldexists(BANCS.INPUT.regType) == 1)then
                        EQSRV.GLBDATA.regType = BANCS.INPUT.regType
                else
                        EQSRV.GLBDATA.regType = ""
                endif
                if(fieldexists(BANCS.INPUT.regType) == 1)then
                        EQSRV.GLBDATA.regType = BANCS.INPUT.regType
                else
                        EQSRV.GLBDATA.regType = ""
                endif
                if(EQSRV.GLBDATA.chrgDrAcct!="")then
                sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.chrgDrAcct)
                if(sv_u==0)then
                        EQSRV.GLBDATA.frmCrncy = BANCS.OUTPARAM.acctCrncyCode
                else
                        EQSRV.GLBDATA.frmCrncy = ""
                endif
                else
                        EQSRV.GLBDATA.frmCrncy = ""
                endif
                if(EQSRV.GLBDATA.creditAcctNum!="")then
                sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.creditAcctNum)
                if(sv_u==0)then
                        EQSRV.GLBDATA.toCrncy = BANCS.OUTPARAM.acctCrncyCode
                else
                        EQSRV.GLBDATA.toCrncy = ""
                endif
                else
                        EQSRV.GLBDATA.toCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.srcAcctIdCrncy) == 1)then
                        EQSRV.GLBDATA.frmCrncy = BANCS.INPUT.srcAcctIdCrncy
                else
                        EQSRV.GLBDATA.frmCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.laAcctIdCrncy) == 1)then
                        EQSRV.GLBDATA.toCrncy = BANCS.INPUT.laAcctIdCrncy
                else
                        EQSRV.GLBDATA.toCrncy = ""
                endif
                sv_d =""
                BANCS.INPARAM.BINDVARS =""
                if((EQSRV.GLBDATA.frmCrncy!=EQSRV.GLBDATA.toCrncy) and (EQSRV.GLBDATA.pageName=="laupaymain"))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'T',?SVAR)from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.frmCrncy + "|" + EQSRV.GLBDATA.toCrncy + "|" + BANCS.STDIN.menuId
                        ##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.toCrncy + "|" + EQSRV.GLBDATA.frmCrncy + "|" + BANCS.STDIN.menuId
                endif
                if((EQSRV.GLBDATA.acctCrncy!=EQSRV.GLBDATA.toCrncy) and (EQSRV.GLBDATA.acctCrncy!="") and (EQSRV.GLBDATA.toCrncy!=""))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'T',?SVAR)from dual "
                        ##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acctCrncy + "|" + EQSRV.GLBDATA.toCrncy + "|" + BANCS.STDIN.menuId
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.toCrncy + "|" + EQSRV.GLBDATA.acctCrncy + "|" + BANCS.STDIN.menuId
                        if((BANCS.STDIN.menuId=="ODCM")and(EQSRV.GLBDATA.pageName=="tfcmarginpage"))then
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acctCrncy + "|" + EQSRV.GLBDATA.toCrncy + "|" + BANCS.STDIN.menuId
                        endif
                        if(BANCS.STDIN.menuId=="HPAYOFF")then
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acctCrncy + "|" + EQSRV.GLBDATA.toCrncy + "|" + BANCS.STDIN.menuId
                        endif
                endif
                if((EQSRV.GLBDATA.frmCrncy!=EQSRV.GLBDATA.toCrncy) and (EQSRV.GLBDATA.frmCrncy!="") and (EQSRV.GLBDATA.toCrncy!="")and(EQSRV.GLBDATA.pageName=="tfc_charge_detail")and((EQSRV.GLBDATA.mopId=="ODCM")or(EQSRV.GLBDATA.mopId=="IDCM")or(EQSRV.GLBDATA.mopId=="OGM")or(EQSRV.GLBDATA.mopId=="IGM")))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'T',?SVAR)from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.toCrncy + "|" + EQSRV.GLBDATA.frmCrncy + "|" + BANCS.STDIN.menuId
                endif
                if((EQSRV.GLBDATA.frmCrncy!=EQSRV.GLBDATA.toCrncy) and (EQSRV.GLBDATA.frmCrncy!="") and (EQSRV.GLBDATA.toCrncy!="")and(EQSRV.GLBDATA.pageName=="laspaymain")and(EQSRV.GLBDATA.mopId=="HLASPAY"))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'T',?SVAR)from dual "
                        ##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.toCrncy + "|" + EQSRV.GLBDATA.frmCrncy + "|" + BANCS.STDIN.menuId
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.frmCrncy + "|" + EQSRV.GLBDATA.toCrncy + "|" + BANCS.STDIN.menuId
                endif
                if((BANCS.STDIN.homeCrncyCode!=EQSRV.GLBDATA.bgCrncyCode) and (EQSRV.GLBDATA.bgCrncyCode!=""))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'T',?SVAR)from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode + "|" + EQSRV.GLBDATA.bgCrncyCode + "|" + BANCS.STDIN.menuId
                endif
                if(sv_d!="")then
			print(sv_d)
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EQSRV.GLBDATA.output = BANCS.OUTPARAM.ortCode
			else
				EQSRV.GLBDATA.output = "N|No"
			endif
                else
                        EQSRV.GLBDATA.output = "N|No"
                endif
                sv_a = urhk_SetOrbOut(EQSRV.GLBDATA.output)
                print(sv_a)
                exitscript
        #}
        endif
        if((BANCS.STDIN.menuId=="HMICZ")or(BANCS.STDIN.menuId=="HSSIM"))then
        #{
                if(fieldexists(BANCS.INPUT.mopId) == 1)then
                        EQSRV.GLBDATA.mopId = BANCS.INPUT.mopId
                else
                        EQSRV.GLBDATA.mopId = ""
                endif
                if(fieldexists(BANCS.INPUT.pageName) == 1)then
                        EQSRV.GLBDATA.pageName = BANCS.INPUT.pageName
                else
                        EQSRV.GLBDATA.pageName = ""
                endif
                if(fieldexists(BANCS.INPUT.funcCode) == 1)then
                        EQSRV.GLBDATA.funcCode = BANCS.INPUT.funcCode
                else
                        EQSRV.GLBDATA.funcCode = ""
                endif
                if(fieldexists(BANCS.INPUT.sttlmntCrncy) == 1)then
                        EQSRV.GLBDATA.sttlmntCrncy = BANCS.INPUT.sttlmntCrncy
                else
                        EQSRV.GLBDATA.sttlmntCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.zoneCrncy) == 1)then
                        EQSRV.GLBDATA.zoneCrncy = BANCS.INPUT.zoneCrncy
                else
                        EQSRV.GLBDATA.zoneCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.mRefCrncy) == 1)then
                        EQSRV.GLBDATA.mRefCrncy = BANCS.INPUT.mRefCrncy
                else
                        EQSRV.GLBDATA.mRefCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.mAcctCrncy) == 1)then
                        EQSRV.GLBDATA.mAcctCrncy = BANCS.INPUT.mAcctCrncy
                else
                        EQSRV.GLBDATA.mAcctCrncy = ""
                endif
                if(fieldexists(BANCS.INPUT.acctId)==1)then
                        EQSRV.GLBDATA.CommAcctId = BANCS.INPUT.acctId
                else
                        EQSRV.GLBDATA.CommAcctId = ""
                endif
                if(EQSRV.GLBDATA.CommAcctId!="")then
                sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.CommAcctId)
                if(sv_u==0)then
                        EQSRV.GLBDATA.frmCrncy = BANCS.OUTPARAM.acctCrncyCode
                else
                        EQSRV.GLBDATA.frmCrncy = ""
                endif
                else
                        EQSRV.GLBDATA.frmCrncy = ""
                endif

                if(BANCS.STDIN.menuId=="HMICZ")then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,upper(?SVAR),upper(?SVAR),'T',upper(?SVAR))from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.zoneCrncy + "|" + EQSRV.GLBDATA.sttlmntCrncy + "|" + BANCS.STDIN.menuId
                endif
                if(((BANCS.STDIN.menuId=="HSSIM") or (BANCS.STDIN.menuId=="HSIM"))and(EQSRV.GLBDATA.pageName=="gssimdtl"))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,upper(?SVAR),upper(?SVAR),'T',upper(?SVAR))from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.frmCrncy + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.menuId
                endif
                if((BANCS.STDIN.menuId=="HSSIM")and(EQSRV.GLBDATA.pageName!="gssimdtl"))then
                        sv_d = "ortCode|select custom.fn_rtpop_chk(?SVAR,upper(?SVAR),upper(?SVAR),'T',upper(?SVAR))from dual "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.mRefCrncy + "|" + EQSRV.GLBDATA.mAcctCrncy + "|" + BANCS.STDIN.menuId
                endif
                if(sv_d!="")then
                print(sv_d)
                print(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u==0)then
                        EQSRV.GLBDATA.output = BANCS.OUTPARAM.ortCode
                else
                        EQSRV.GLBDATA.output = "N|No"
                endif
                else
                        EQSRV.GLBDATA.output = "N|No"
                endif
                sv_a = urhk_SetOrbOut(EQSRV.GLBDATA.output)
                print(sv_a)
                exitscript
        #}
        endif
ENDRES:
        if(EQSRV.GLBDATA.rateCode!="")then
                sv_u = urhk_SetOrbOut("rateCode|"+EQSRV.GLBDATA.rateCode)
                print(sv_u)
        endif
        if(EQSRV.GLBDATA.rate!="")then
                sv_u = urhk_SetOrbOut("rate|"+EQSRV.GLBDATA.rate)
                print(sv_u)
        endif
        if(EQSRV.GLBDATA.treaRate!="")then
                sv_u = urhk_SetOrbOut("treaRate|"+EQSRV.GLBDATA.treaRate)
                print(sv_u)
        endif
        if(EQSRV.GLBDATA.errorFlg!="")then
                sv_u = urhk_SetOrbOut("errorFlg|"+EQSRV.GLBDATA.errorFlg)
                print(sv_u)
        endif
        if(EQSRV.GLBDATA.errorMsg!="")then
                sv_u = urhk_SetOrbOut("errorMsg|"+EQSRV.GLBDATA.errorMsg)
                print(sv_u)
        endif
exitscript
trace off
end-->
