        #sv_s="chrgType,chrgAmt,chrgpcnt,minAmt,maxAmt,slabCode|SELECT CHARGE_TYPE,CHRG_AMT,PRCNT,MIN_AMT,MAX_AMT,SLAB_CODE FROM CUSTOM.CUSTOM_CCPRM WHERE EVENT_TYPE=?SVAR AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
       	sv_s="chrgType,chrgAmt,chrgpcnt,minAmt,maxAmt,slabCode|SELECT CHARGE_TYPE,CHRG_AMT,PRCNT,MIN_AMT,MAX_AMT,SLAB_CODE FROM CUSTOM.CUSTOM_CCPRM WHERE EVENT_TYPE='GCHRG' AND EVENT_ID= ?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
