        #BANCS.INPARAM.BINDVARS = CUST.CHQB.schmCode + "|" + CUST.CHQB.crncyCode + "|" + BANCS.STDIN.contextBankId
	
	BANCS.INPARAM.BINDVARS =  CUST.CHQB.eventId + "|" + CUST.CHQB.schmCode + "|" + CUST.CHQB.crncyCode + "|" + BANCS.STDIN.contextBankId

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)
        sv_p = urhk_dbCursorOpenWithBind(sv_s)
        PRINT(sv_p)
        IF(sv_p!=0) THEN
        #{
                sv_e="Charge details not maintained in CCPRM for scheme code "+CUST.CHQB.schmCode+" AND Currency Code "+CUST.CHQB.crncyCode
                sv_u = urhk_SetOrbErr(sv_e)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                GOTO ENDOFSCRIPT

        #}
        ENDIF


        sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        PRINT(sv_n)

        sv_f = urhk_dbCursorFetch(sv_n)
        PRINT(sv_f)
        WHILE(sv_f == 0)
        #{
                CUST.CHQB.chrgType=BANCS.OUTPARAM.chrgType
                CUST.CHQB.chrgAmt=BANCS.OUTPARAM.chrgAmt
                CUST.CHQB.chrgpcnt=BANCS.OUTPARAM.chrgpcnt
                CUST.CHQB.minAmt=BANCS.OUTPARAM.minAmt
                CUST.CHQB.maxAmt=BANCS.OUTPARAM.maxAmt
                CUST.CHQB.slabCode=BANCS.OUTPARAM.slabCode
                PRINT(CUST.CHQB.chrgpcnt)
                PRINT(CUST.CHQB.minAmt)
                PRINT(CUST.CHQB.maxAmt)
                PRINT(CUST.CHQB.chrgAmt)
                PRINT(CUST.CHQB.slabCode)
                IF(CUST.CHQB.chrgType == "P")THEN
                #{
                        CUST.CHQB.chrgAmt = CDOUBLE(CUST.CHQB.inputAmt) * CDOUBLE(CUST.CHQB.chrgpcnt) * (0.01)
                        IF(CUST.CHQB.chrgAmt < CUST.CHQB.minAmt)THEN
                        #{
                                CUST.CHQB.chrgAmt = CUST.CHQB.minAmt
                        #}
                        ENDIF
                        IF(CUST.CHQB.chrgAmt > CUST.CHQB.maxAmt)THEN
                        #{
                                CUST.CHQB.chrgAmt = CUST.CHQB.maxAmt
                        #}
                        ENDIF
                #}
                ENDIF

                IF(CUST.CHQB.chrgType == "S")THEN
                #{
                        IF(CUST.CHQB.slabCode == "")THEN
                        #{
                                sv_e="Charge slab code not maintained in CCPRM for scheme code "+CUST.CHQB.schmCode+" AND Currency Code "+CUST.CHQB.crncy
                                sv_u = urhk_SetOrbErr(sv_e)
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                                GOTO ENDOFSCRIPT
                        #}
                        ENDIF
                        BANCS.INPARAM.CurrencyCode = CUST.CHQB.crncy
                        BANCS.INPARAM.AmountTableCode = CUST.CHQB.slabCode
                        BANCS.INPARAM.InputAmount = CUST.CHQB.inputAmt
                        PRINT(BANCS.INPARAM.AmountTableCode)
                        PRINT(BANCS.INPARAM.CurrencyCode)
                        PRINT(BANCS.INPARAM.InputAmount)

                        # -----------------------------------------------------------------------------
                        # Amount slab Userhook to determine the COT amount
                        # -----------------------------------------------------------------------------
                        sv_r = urhk_B2k_GetASTMAmount("")
                        print(sv_r)

                        IF (sv_r != 0) THEN
                        #{
                                sv_e="Unable to determine the charge Amount for the table Code:"+CUST.CHQB.slabCode
                                sv_u = urhk_SetOrbErr(sv_e)
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                                GOTO ENDOFSCRIPT
                       #}
                       ENDIF

                       # -----------------------------------------------------------------------------
                       # Charge amount for the account
                       # -----------------------------------------------------------------------------
                       CUST.CHQB.chrgAmt = BANCS.OUTPARAM.OutputAmount
                       print(CUST.CHQB.chrgAmt)
                #}
                ENDIF



#CheckingPreF RF112349
		

		IF  (CUST.CHQB.crncyCode =="USD") THEN
			CUST.CHQB.event ="CHQREQ"
		ENDIF

		IF  (CUST.CHQB.crncyCode =="CDF") then
			CUST.CHQB.event= "CHQREQBC"
		ENDIF
		IF  (CUST.CHQB.crncyCode =="EUR") then
			CUST.CHQB.event= "CHQREQEUR"
		ENDIF
	
		#check Agreement level

			sv_s =" AMTIND, PRCNT,AMT,MIN_AMT,MAX_AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE,MIN_AMT,MAX_AMT   from custom.c_cpcm_data where entity_cre_flg='Y' and "
			sv_s = sv_s + " del_flg='N' and event_type ='"+CUST.CHQB.eventType+"' and event_id='"+CUST.CHQB.event +"' and  PERCENT  ='A'" 
			sv_s = sv_s + " and AGREEMENT_CODE = (select employerid from CRMUSER.DEMOGRAPHIC where orgkey  ='"+CUST.CHQB.Cif+"' ) "
			sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum=1"
			print(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN				
				CUST.CHQB.chrgAmt=BANCS.OUTPARAM.AMT	
				PRINT(CUST.CHQB.chrgAmt)
			ENDIF

		
		#check CIF level

			sv_s =" AMTIND, PRCNT,AMT,MIN_AMT,MAX_AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE,MIN_AMT,MAX_AMT   from custom.c_cpcm_data where entity_cre_flg='Y' and "
			sv_s = sv_s + " del_flg='N' and event_type ='"+CUST.CHQB.eventType+"' and event_id='"+CUST.CHQB.event+"' and  PERCENT  ='A'" 
			sv_s = sv_s + " and cust_id ='"+CUST.CHQB.Cif+"'"
			sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
			print(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN				
				CUST.CHQB.chrgAmt=BANCS.OUTPARAM.AMT	
				PRINT(CUST.CHQB.chrgAmt)
			ENDIF


		#check account level

			sv_s =" AMTIND, PRCNT,AMT,MIN_AMT,MAX_AMT | select PERCENT,PERCENT_VALUE ,AMT_VALUE,MIN_AMT,MAX_AMT   from custom.c_cpcm_data where entity_cre_flg='Y' and "
			sv_s = sv_s + " del_flg='N' and event_type ='"+CUST.CHQB.eventType+"' and event_id='"+CUST.CHQB.event+"' and  PERCENT ='A'" 
			sv_s = sv_s + " and foracid ='"+CUST.CHQB.acctNo +"'"
			sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum =1 "
			print(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN
				CUST.CHQB.chrgAmt=BANCS.OUTPARAM.AMT	
				PRINT(CUST.CHQB.chrgAmt)
			ENDIF
			
	
#EndChecking PreF RF112349


                #CUST.CHQB.totalchrgAmt = (CUST.CHQB.totalchrgAmt) + (CUST.CHQB.chrgAmt)
                CUST.CHQB.totalchrgAmt = CDOUBLE(CUST.CHQB.totalchrgAmt) + CDOUBLE(CUST.CHQB.chrgAmt)
                sv_f = urhk_dbCursorFetch(sv_n)
                PRINT(sv_f)

        #}
        DO
        sv_p = urhk_dbCursorClose(sv_n)
        PRINT(sv_p)

	PRINT(CUST.CHQB.totalchrgAmt)
	
        IF(TRIM(CUST.CHQB.leaves) != "")THEN
        #{
                CUST.CHQB.totalchrgAmt = CDOUBLE(CUST.CHQB.totalchrgAmt)*CDOUBLE(CUST.CHQB.noOfChq)*(CDOUBLE(CUST.CHQB.leaves)/(25))
        #}
        ELSE
        #{
                CUST.CHQB.totalchrgAmt = CDOUBLE(CUST.CHQB.totalchrgAmt)*CDOUBLE(CUST.CHQB.noOfChq)
        #}
        ENDIF

        PRINT(CUST.CHQB.totalchrgAmt)

	
	CUST.CHQB.vat_amt = CDOUBLE(CUST.CHQB.totalchrgAmt)* (0.01) * CDOUBLE(CUST.CHQB.vatpcnt)
	PRINT(CUST.CHQB.vat_amt)
	CUST.CHQB.total_chrgAmt = CDOUBLE(CUST.CHQB.totalchrgAmt) + CDOUBLE(CUST.CHQB.vat_amt)
	PRINT(CUST.CHQB.total_chrgAmt)
	
	sv_p = GETPOSITION(CUST.CHQB.totalchrgAmt,".")
	PRINT(sv_p)
	
	IF(sv_p > 0)THEN
	#{
		CUST.CHQB.totalchrgAmt = MID$(CUST.CHQB.totalchrgAmt,0,sv_p + 2)
		PRINT(CUST.CHQB.totalchrgAmt)
	#}
	ENDIF
	
	sv_p = GETPOSITION(CUST.CHQB.vat_amt,".")
	PRINT(sv_p)
	
	IF(sv_p > 0)THEN
	#{
		CUST.CHQB.vat_amt = MID$(CUST.CHQB.vat_amt,0,sv_p + 2)
		PRINT(CUST.CHQB.vat_amt)
	#}
	ENDIF
	
	sv_p = GETPOSITION(CUST.CHQB.total_chrgAmt,".")
	PRINT(sv_p)
	
	IF(sv_p > 0)THEN
	#{
		CUST.CHQB.total_chrgAmt = MID$(CUST.CHQB.total_chrgAmt,0,sv_p + 2)
		PRINT(CUST.CHQB.total_chrgAmt)
