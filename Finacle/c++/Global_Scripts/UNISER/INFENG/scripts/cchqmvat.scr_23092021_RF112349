	#CUST.CHQB.Msg = CUST.CHQB.Msg + " DO you want to continue? Click Ok to Continue with the charge AND Cancel to terminate the transaction."
	
	ENDOFSCRIPT:
		sv_u = urhk_SetOrbOut("errFlg|" + CUST.CHQB.errorFlg)
