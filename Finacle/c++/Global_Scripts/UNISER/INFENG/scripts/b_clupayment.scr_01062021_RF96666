<--START
CHECKSUM="feaea61f2356177f8569f96878ed4e50a3efa812bd955b649ce27078087106d7"
	TRACE ON
	
	sv_a=urhk_B2k_PrintRepos("BANCS")
	
	sv_a = REPEXISTS("STDWFS")
	IF (sv_a == 0) THEN
	#{
		CREATEREP("STDWFS")
	#}
	ENDIF
	
	sv_a = CLASSEXISTS("STDWFS", "GLBDATA")
	IF (sv_a == 0) THEN
	#{
		CREATECLASS("STDWFS", "GLBDATA", 5)
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.INPUT.funcCode) == 1) THEN
	#{
		STDWFS.GLBDATA.funcCode=TOUPPER(TRIM(BANCS.INPUT.funcCode))
		print(STDWFS.GLBDATA.funcCode)
		
		IF (FIELDEXISTS(BANCS.INPUT.dco) == 1) THEN
		#{
			STDWFS.GLBDATA.dco=TOUPPER(TRIM(BANCS.INPUT.dco))
			print(STDWFS.GLBDATA.dco)

	
			IF((STDWFS.GLBDATA.funcCode == "R") OR (STDWFS.GLBDATA.funcCode == "D"))THEN
			#{				
				sv_u="opacct|select a.foracid from tbaadm.gam a ,tbaadm.gam b,tbaadm.lam where lam.BANK_ID = ?SVAR"
				sv_u= sv_u + "AND b.foracid=?SVAR AND a.acid=lam.op_acid AND lam.acid=b.acid"
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  STDWFS.GLBDATA.dco
				print(BANCS.INPARAM.BINDVARS)
				
				sv_r =  urhk_dbSelectWithBind(sv_u)
				print(sv_r)
				
				IF (sv_r ==0) THEN
				#{
					STDWFS.GLBDATA.opacct = TRIM(BANCS.OUTPARAM.opacct)
					print (STDWFS.GLBDATA.opacct)
					#}
				ELSE
					#{
					STDWFS.GLBDATA.opacct = " "
				#}
				ENDIF
				
				sv_z = urhk_SetOrbOut("output|"+ STDWFS.GLBDATA.opacct)
				print(sv_z)
			#}
			ENDIF
			IF(STDWFS.GLBDATA.funcCode == "P")THEN
			#{
				STDWFS.GLBDATA.realizeflg="N"
				sv_u="opacct|select count(1) from tbaadm.gam a ,tbaadm.lam b where b.BANK_ID = ?SVAR "
				sv_u= sv_u + "AND a.foracid=?SVAR AND a.acid=b.acid AND b.ACCR_PENAL_INT_UNREALIZED_AMT = 0"
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  STDWFS.GLBDATA.dco
				print(BANCS.INPARAM.BINDVARS)
				
				sv_r =  urhk_dbSelectWithBind(sv_u)
				print(sv_r)
				
				IF (sv_r ==0) THEN
				#{
					STDWFS.GLBDATA.opacct = TRIM(BANCS.OUTPARAM.opacct)
					print (STDWFS.GLBDATA.opacct)
					
					IF(STDWFS.GLBDATA.opacct == 0)THEN
					#{
						STDWFS.GLBDATA.realizeflg="Y"
					#}
					ENDIF
				#}
				ENDIF				
				
				sv_z = urhk_SetOrbOut(STDWFS.GLBDATA.realizeflg+"|output")
				print(sv_z)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	TRACE OFF
END-->
