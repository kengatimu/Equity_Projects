BANCS.OUTPUT.nonIntOverdueAmount = CDOUBLE(CUST.INTERFACE.nonIntDmdAmt) - CDOUBLE(CUST.INTERFACE.nonIntTotAdjAmt)
BANCS.OUTPUT.nonIntOverdueDate = CUST.INTERFACE.nonIntOverdueDate
BANCS.OUTPUT.numIntOverdue = CUST.INTERFACE.intOverdueCount
BANCS.OUTPUT.intOverduePeriod = CUST.INTERFACE.intOverduePerd
BANCS.OUTPUT.intOverdueAmount =  CDOUBLE(CUST.INTERFACE.intDmdAmt) - CDOUBLE(CUST.INTERFACE.intTotAdjAmt)
BANCS.OUTPUT.intOverdueDate = CUST.INTERFACE.intOverdueDate 
BANCS.OUTPUT.laOverFlowAmt = CUST.INTERFACE.oFlowAmt
BANCS.OUTPUT.totOverdueAmount = CDOUBLE(BANCS.OUTPUT.nonIntOverdueAmount)+ CDOUBLE(BANCS.OUTPUT.intOverdueAmount)
