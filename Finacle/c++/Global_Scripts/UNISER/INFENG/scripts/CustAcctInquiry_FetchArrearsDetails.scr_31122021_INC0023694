# Select from LDT
sv_q = "shdl_num,dmd_flow_id,dmd_date,dmd_srl_num,dmd_ovdu_date|"
sv_q = sv_q + " SELECT SHDL_NUM,DMD_FLOW_ID,DMD_DATE,DMD_SRL_NUM,DMD_OVDU_DATE FROM TBAADM.LDT WHERE "
sv_q = sv_q + " DEL_FLG = ?SVAR "
sv_q = sv_q + " AND ACID = ?SVAR "
#sv_q = sv_q + " AND BOD_DATE = to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
sv_q = sv_q + " AND BANK_ID = ?SVAR "


sv_q = "acid,dmdFlowId,dmdData,dmdEffDate,dmdOvduDate,shdlNum,dmdSrlNum,dmdAmt,totAdjAmt,dmdType|"
sv_q = sv_q + " SELECT LDT.ACID ,"
sv_q = sv_q + " LDT.DMD_FLOW_ID,"
sv_q = sv_q + " TO_CHAR(LDT.DMD_DATE, 'DD-MM-YYYY HH24:MI:SS') ,"
sv_q = sv_q + " TO_CHAR(LDT.DMD_EFF_DATE,'DD-MM-YYYY HH24:MI:SS'),"
sv_q = sv_q + " TO_CHAR(LDT.DMD_OVDU_DATE,'DD-MM-YYYY HH24:MI:SS'),"
sv_q = sv_q + " LDT.SHDL_NUM , "
sv_q = sv_q + " LDT.DMD_SRL_NUM, "
sv_q = sv_q + " LDT.DMD_AMT , "
sv_q = sv_q + " LDT.TOT_ADJ_AMT, "
sv_q = sv_q + " LFM.DMD_TYPE "
sv_q = sv_q + " FROM TBAADM.LDT,TBAADM.LFM "
sv_q = sv_q + " WHERE"
sv_q = sv_q + " LDT.BANK_ID= ?SVAR AND "
sv_q = sv_q + " LFM.BANK_ID=?SVAR AND "
sv_q = sv_q + " LDT.ACID = ?SVAR "
sv_q = sv_q + " AND LDT.SHDL_NUM = ?SVAR "
sv_q = sv_q + " AND LDT.DMD_EFF_DATE <= TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS')"
sv_q = sv_q + " AND LDT.DEL_FLG != 'Y' "
sv_q = sv_q + " AND LDT.DMD_FLOW_ID = LFM.FLOW_ID "
sv_q = sv_q + " AND LDT.DMD_AMT != TOT_ADJ_AMT"

print(sv_q)

BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.acid 
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.repShdlNum + "|" + BANCS.STDIN.BODDate

