sv_f = urhk_dbCursorFetch(sv_n)
PRINT(sv_f)
sv_i = 1
WHILE(sv_f == 0)
#{

	print(BANCS.OUTPARAM.dmdFlowId)

	CUST.INTERFACE.dmdFlowId = BANCS.OUTPARAM.dmdFlowId
	CUST.INTERFACE.dmdOvduDate = BANCS.OUTPARAM.dmdOvduDate
	CUST.INTERFACE.dmdAmt = BANCS.OUTPARAM.dmdAmt
	CUST.INTERFACE.totAdjAmt =  BANCS.OUTPARAM.totAdjAmt



	sv_q = "dmdTypeInd|select DMD_TYPE from tbaadm.LFM "
	sv_q = sv_q + " where FLOW_ID = ?SVAR "
	sv_q = sv_q + " AND DEL_FLG = 'N' "
	sv_q = sv_q + " AND BANK_ID = ?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.OUTPARAM.dmdFlowId + "|" + BANCS.STDIN.contextBankId
	
	sv_e = urhk_dbSelectWithBind(sv_q)
	print(sv_e)

	IF(sv_e != 0) THEN
	#{
		BANCS.OUTPUT.SucessOrFailure = "F"
		BANCS.OUTPUT.ErrorMsg = "Flow id is not able to derive"
		GOTO ERROREXIT
	#}
	ENDIF

	CUST.INTERFACE.dmdTypeInd = BANCS.OUTPARAM.dmdTypeInd
	print(CUST.INTERFACE.dmdTypeInd)
	print(CUST.INTERFACE.idmdOvduEomFlg)

	IF(((CUST.INTERFACE.idmdOvduEomFlg == "Y") AND (CUST.INTERFACE.dmdTypeInd == "I" )) OR ((CUST.INTERFACE.pdmdOvduEomFlg == "Y") AND (CUST.INTERFACE.dmdTypeInd != "I" )))THEN
	#{
		sv_q = "lastDay| SELECT TO_CHAR(LAST_DAY(" + CUST.INTERFACE.dmdOvduDate + "),'DD-MM-YYYY') FROM DUAL"
		sv_e = urhk_dbSelectWithBind(sv_q)
		print(sv_e)

		IF(sv_e != 0) THEN
		#{
			BANCS.OUTPUT.SucessOrFailure = "F"
			BANCS.OUTPUT.ErrorMsg = "Flow id is not able to derive"
			GOTO ERROREXIT
		#}
		ENDIF

		CUST.INTERFACE.lastDay = BANCS.OUTPARAM.lastDay
		CUST.INTERFACE.dmdOvduDate = CUST.INTERFACE.lastDay
	#}
	ENDIF

	IF(CUST.INTERFACE.dmdTypeInd == "I")THEN
	#{
	
		IF(TRIM(CUST.INTERFACE.dmdOvduDate) != "" )THEN
		#{
			BANCS.INPARAM.date2=CUST.INTERFACE.dmdOvduDate
			BANCS.INPARAM.date1=BANCS.STDIN.BODDate

			print(BANCS.INPARAM.date1)
			print(BANCS.INPARAM.date2)
			sv_j=urhk_B2k_dateDiff("")
			sv_k=BANCS.OUTPARAM.dateDiff
			print(sv_k)

			IF (sv_k > 0)THEN
			#{
				if(sv_k > CINT(CUST.INTERFACE.intOverduePerd))THEN
				#{
					CUST.INTERFACE.intOverduePerd = CINT(sv_k) + 1
					CUST.INTERFACE.intOverdueDate = CUST.INTERFACE.dmdOvduDate 
				#}
				ENDIF
				CUST.INTERFACE.intDmdAmt = CDOUBLE(CUST.INTERFACE.intDmdAmt) + CDOUBLE(CUST.INTERFACE.dmdAmt)
				CUST.INTERFACE.intTotAdjAmt = CDOUBLE(CUST.INTERFACE.intTotAdjAmt) + CDOUBLE(CUST.INTERFACE.totAdjAmt)
				CUST.INTERFACE.intOverdueCount = CINT(CUST.INTERFACE.intOverdueCount) + 1
			
			#}
			ENDIF
		#}
		ENDIF

	#}
	ELSE
	#{

                IF(TRIM(CUST.INTERFACE.dmdOvduDate) != "" )THEN
                #{
                        BANCS.INPARAM.date2=CUST.INTERFACE.dmdOvduDate
                        BANCS.INPARAM.date1=BANCS.STDIN.BODDate

                        print(BANCS.INPARAM.date1)
                        print(BANCS.INPARAM.date2)
                        sv_j=urhk_B2k_dateDiff("")
                        sv_k=BANCS.OUTPARAM.dateDiff
                        print(sv_k)

                        IF (sv_k > 0)THEN
                        #{
				IF(sv_k > CINT(CUST.INTERFACE.notIntOverduePerd))THEN
				#{
					CUST.INTERFACE.notIntOverduePerd = CINT(sv_k) + 1
					CUST.INTERFACE.nonIntOverdueDate = CUST.INTERFACE.dmdOvduDate	
				#}
				ENDIF
				print(CUST.INTERFACE.dmdAmt)
				print(CUST.INTERFACE.nonIntDmdAmt)
				print(CUST.INTERFACE.totAdjAmt)
				print(CUST.INTERFACE.nonIntTotAdjAmt)
                                CUST.INTERFACE.nonIntDmdAmt = CDOUBLE(CUST.INTERFACE.nonIntDmdAmt) + CDOUBLE(CUST.INTERFACE.dmdAmt)
				print(CUST.INTERFACE.nonIntDmdAmt)
                                CUST.INTERFACE.nonIntTotAdjAmt = CDOUBLE(CUST.INTERFACE.nonIntTotAdjAmt) + CDOUBLE(CUST.INTERFACE.totAdjAmt)
				print(CUST.INTERFACE.nonIntTotAdjAmt)
                                CUST.INTERFACE.nonIntOverdueCount = CINT(CUST.INTERFACE.nonIntOverdueCount) +1 
			#}
			ENDIF

		#}
		ENDIF
	#}
	ENDIF

	sv_i = sv_i + 1
	sv_f = urhk_dbCursorFetch(sv_n)
	PRINT(sv_f)

#}
DO
lv_c = urhk_dbCursorClose(sv_n)
PRINT(lv_c)
IF(CUST.INTERFACE.repShdlNum != "01")THEN
#{
	CUST.INTERFACE.rephasedFlg = "Y"
	sv_q = "flowStartDate|SELECT TO_CHAR(MIN(FLOW_START_DATE),'DD-MM-YYYY HH24:MI:SS') "
	sv_q = sv_q + " FROM TBAADM.LRS WHERE "
	sv_q = sv_q + " LRS.BANK_ID = ?SVAR " 
	sv_q = sv_q + " and LRS.ACID = ?SVAR " 
	sv_q = sv_q + " and LRS.SHDL_NUM = ?SVAR " 
	sv_q = sv_q + " and LRS.DEL_FLG != 'Y' " 
	sv_q = sv_q + " and LRS.ENTITY_CRE_FLG = 'Y' " 

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.acid + "|" + CUST.INTERFACE.repShdlNum

	print(BANCS.INPARAM.BINDVARS)

	sv_e = urhk_dbSelectWithBind(sv_q)
	print(sv_e)

	IF(sv_e != 0) THEN
	#{
		BANCS.OUTPUT.SucessOrFailure = "F"
		BANCS.OUTPUT.ErrorMsg = "first rephasement flag is not able to derive"
		GOTO ERROREXIT
	#}
	ENDIF
	CUST.INTERFACE.firstRephasedDmdDate = BANCS.OUTPARAM.flowStartDate

#}
ENDIF


BANCS.OUTPUT.firstRephasedDmdDate = CUST.INTERFACE.firstRephasedDmdDate
