# Validation the scheme
sv_q = "maxPendDmdDate,idmdOvduEomFlg,pdmdOvduEomFlg,repShdlNum,oFlowAmt,dmdsatisfymthd,purpAdv|"
sv_q = sv_q + " SELECT MAX_PENDING_DMD_DATE,IDMD_OVDU_EOM_FLG,PDMD_OVDU_EOM_FLG,REP_SHDL_NUM , OFLOW_AMT ,DMD_SATISFY_MTHD, "
sv_q = sv_q + " (select PURPOSE_OF_ADVN from tbaadm.gac where bank_id=lam.bank_id and acid=lam.acid) "
sv_q = sv_q + " FROM TBAADM.LAM WHERE ENTITY_CRE_FLG = ?SVAR"
sv_q = sv_q + " AND DEL_FLG = ?SVAR "
sv_q = sv_q + " AND ACID = ?SVAR "
sv_q = sv_q + " AND BANK_ID = ?SVAR "
print(sv_q)

BANCS.INPARAM.BINDVARS = "Y|N|" + CUST.INTERFACE.acid + "|" + BANCS.STDIN.contextBankId

print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbSelectWithBind(sv_q)
print(sv_e)

IF(sv_e != 0) THEN
