		sv_z = urhk_MTTS_DefinePartTran("RECCR")
	#}
	ENDIF
	#----------------------------------------------------------------------------
	# Debit Charge Off A/c
	#----------------------------------------------------------------------------
	IF (sv_h!=0) THEN
	#{
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeOffLine
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		# Ref Currencty will be the Loan A/c Currency
		MTT.PartTranDetails.RefAmount=-sv_h
		MTT.PartTranDetails.Particulars="Dr ChargeOff A/c"
		MTT.PartTranDetails.RateCode = MTT.InputDetails.tranRateCode
		MTT.PartTranDetails.Rate = MTT.InputDetails.tranRate
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAREC"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		
		sv_z = urhk_MTTS_DefinePartTran("RECDR")
	#}
	ENDIF
	#----------------------------------------------------------------------------
	# Creating Accrued Interest Amount Part Tran..(This is not the same as
	# Cash/Accrul basis Acrd Int fucntionality)
	#----------------------------------------------------------------------------
	IF (sv_e != 0) THEN
	#{
		MTT.PartTranDetails.RefAmount=sv_e
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
		print(MTT.PartTranDetails.RefCurrency)
		print(MTT.PartTranDetails.RateCode)
		
		IF(sv_q == "Y") THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.intBookAcct
			MTT.PartTranDetails.Particulars="Cr P&L Interest A/c"
			#}
		ELSE
			#{
			MTT.PartTranDetails.Account=MTT.InputDetails.IntSuspenseAcct
			MTT.PartTranDetails.Particulars="Cr Suspense A/c"
		#}
		ENDIF
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAREC"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.ChargeDetails.EventType = "ACCR"
		MTT.ChargeDetails.EventId = MTT.InputDetails.accrEventId
		IF(fieldexists(MTT.InputDetails.CompB2kId)) THEN
		#{
			MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
		#}
		ENDIF
		MTT.ChargeDetails.CalculatedAmount = sv_f
		MTT.ChargeDetails.ActualAmount = sv_e
		MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.tranCrncy
		MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
		MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct
		MTT.ChargeDetails.ServiceSolId  = BANCS.STDIN.mySolId
		sv_z = urhk_MTTS_DefineChargePartTran("ACCR")
	#}
	ENDIF
	
	#----------------------------------------------------------------------------
	# Creating Accrued Penal Interest Amount Part Tran..(This is not the same as
	# Cash/Accrul basis Acrd Int fucntionality)
	#----------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		MTT.PartTranDetails.RefAmount=sv_u
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
		print(MTT.PartTranDetails.RefCurrency)
		print(MTT.PartTranDetails.RateCode)
		
		IF(sv_q == "Y") THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.penalIntBookAcct
			MTT.PartTranDetails.Particulars="Cr Penal P&L Interest A/c"
			#}
		ELSE
			#{
			MTT.PartTranDetails.Account=MTT.InputDetails.PenalIntSuspenseAcct
			MTT.PartTranDetails.Particulars="Cr Penal Suspense A/c"
		#}
		ENDIF
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAREC"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.ChargeDetails.EventType = "ACCR"
		MTT.ChargeDetails.EventId = MTT.InputDetails.accrEventId
		IF(fieldexists(MTT.InputDetails.CompB2kId)) THEN
		#{
			MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
		#}
		ENDIF
		#MTT.ChargeDetails.CalculatedAmount = sv_f
		MTT.ChargeDetails.ActualAmount = sv_u
		MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.tranCrncy
		MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
		MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct
		MTT.ChargeDetails.ServiceSolId  = BANCS.STDIN.mySolId
		sv_z = urhk_MTTS_DefineChargePartTran("ACCR")
	#}
	ENDIF
	
	#----------------------------------------------------------------------------
	# Credit Office A/c for bank charge and other charges.
	#----------------------------------------------------------------------------
	sv_t = sv_a + sv_d
	IF ( (sv_t  != 0) AND ( MTT.InputDetails.chargeRouteFlg == "O" )) THEN
	#{
		#--{
		MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAccount
		MTT.PartTranDetails.RefAmount=sv_t
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.Particulars="Cr office A/c for charges"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAREC"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.LAAddnlDetails.OriginOfTran = "RECOV"
		MTT.LAAddnlDetails.TypeOfDemand="A"
		MTT.LAAddnlDetails.DemandSatisfyFlg="Y"
		MTT.LAAddnlDetails.DemandFlowId=MTT.InputDetails.DmdFlow
		MTT.LAAddnlDetails.PrincipalAmt=0
		MTT.LAAddnlDetails.InterestAmt  = 0
		MTT.LAAddnlDetails.OtherChrgAmt=sv_d
		MTT.LAAddnlDetails.BankChrgAmt=sv_a
		MTT.LAAddnlDetails.LoanAcctId=MTT.InputDetails.loanAcct
		
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		
		sv_z = urhk_MTTS_DefinePartTran("CROFC")
	#}
	ENDIF
	sv_z = urhk_MTTS_EndDefinition("")
	TRACE OFF
END-->
