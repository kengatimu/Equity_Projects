	#-----------------------------------------------------------------------------------------
	
	CUST.CIETXN.chrgAmtInAcctCrncy = "0"
	IF (CDOUBLE(CUST.CIETXN.chargeTranAmt) > 0) THEN
	#{
		BANCS.INPARAM.InputAmount = CUST.CIETXN.chargeTranAmt
		BANCS.INPARAM.FromCurrency = "USD"
		BANCS.INPARAM.ToCurrency = CUST.CIETXN.tranAmtCcy
