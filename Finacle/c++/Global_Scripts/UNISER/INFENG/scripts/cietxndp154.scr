		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.chrgAmtInAcctCrncy = CDOUBLE("0")
		PRINT(CUST.CIETXN.chrgAmtInAcctCrncy)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------
	IF((BANCS.STDIN.contextBankId == "11") AND (CUST.CIETXN.startSolId == "2011")) THEN
	#{
		CUST.CIETXN.chargeTranAmt1 = CDOUBLE(CUST.CIETXN.chargeAmt1)
