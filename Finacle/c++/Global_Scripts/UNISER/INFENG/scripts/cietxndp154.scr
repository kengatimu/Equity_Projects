		PRINT(CUST.CIETXN.chargeTranAmt)
	#}
	ENDIF
	
	
	IF((CDOUBLE(CUST.CIETXN.tranAmtInUsd) > 5000) AND (CDOUBLE(CUST.CIETXN.tranAmtInUsd) <= 10000))THEN
	#{
		CUST.CIETXN.chargeTranAmt = CUST.CIETXN.chargeSlab3
		PRINT(CUST.CIETXN.chargeTranAmt)
	#}
	ENDIF
	
	IF(CDOUBLE(CUST.CIETXN.tranAmtInUsd) > 10000) THEN
	#{
		CUST.CIETXN.chargeTranAmt = CUST.CIETXN.chargeSlab4
		PRINT(CUST.CIETXN.chargeTranAmt)
	#}
	ENDIF

GOTO NEXTSTEP
#}
ENDIF

