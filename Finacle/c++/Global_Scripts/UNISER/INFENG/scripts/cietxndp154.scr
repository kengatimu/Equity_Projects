			PRINT(CUST.CIETXN.chrgAmtInAcctCrncy1)
		#}
		ENDIF
		
		CUST.CIETXN.chargeCrAcctID = CUST.CIETXN.vostroAcct
		CUST.CIETXN.chargeEventId = CUST.CIETXN.chargeEventId
		CUST.CIETXN.chargeTranAmt1 = CUST.CIETXN.chrgAmtInAcctCrncy1
