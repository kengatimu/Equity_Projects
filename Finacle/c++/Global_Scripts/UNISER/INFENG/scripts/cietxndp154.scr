	CUST.CIETXN.chargeEventId = CUST.CIETXN.chargeEventId
	CUST.CIETXN.chargeTranAmt = CUST.CIETXN.chrgAmtInAcctCrncy
	CUST.CIETXN.chargeTranCcy = CUST.CIETXN.tranAmtCcy
