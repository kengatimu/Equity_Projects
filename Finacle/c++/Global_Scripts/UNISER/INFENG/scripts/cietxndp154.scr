			CUST.CIETXN.limitamt="1000"
			PRINT(CUST.CIETXN.limitamt)
			
			
			IF ((CINT(CUST.CIETXN.tranAmtUsd) < CINT(CUST.CIETXN.limitamt)) OR (CINT(CUST.CIETXN.tranAmtUsd) == CINT(CUST.CIETXN.limitamt)))  THEN
			#{
				CUST.CIETXN.chargeAmt = "0"
				PRINT(CUST.CIETXN.chargeAmt)
				
				#}
			ELSE
				#{
				
				
				CUST.CIETXN.limitchargeusd="15"
				CUST.CIETXN.limitcharge1usd = (CDOUBLE(CUST.CIETXN.tranAmt) * CDOUBLE("0.2")) / CDOUBLE("100")
				PRINT(CUST.CIETXN.limitcharge1usd)
				
				IF (CUST.CIETXN.tranAmtCcy!="USD") THEN
				#{
					
					BANCS.INPARAM.InputAmount = CUST.CIETXN.limitchargeusd
					BANCS.INPARAM.FromCurrency = "USD"
					BANCS.INPARAM.ToCurrency = CUST.CIETXN.tranAmtCcy
					BANCS.INPARAM.RateCode = CUST.CIETXN.chargeRateCode
					BANCS.INPARAM.Rate = 0.00
					BANCS.INPARAM.CustId = ""
					
					sv_u = urhk_B2k_ConvertAmount("")
					PRINT(sv_u)
					
					IF(sv_u == 0)THEN
					#{
						CUST.CIETXN.limitcharge = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
						PRINT(CUST.CIETXN.limitcharge)
					#}
					ENDIF
					
					BANCS.INPARAM.InputAmount = CUST.CIETXN.limitcharge1usd
					BANCS.INPARAM.FromCurrency = "USD"
					BANCS.INPARAM.ToCurrency = CUST.CIETXN.tranAmtCcy
					BANCS.INPARAM.RateCode = CUST.CIETXN.chargeRateCode
					BANCS.INPARAM.Rate = 0.00
					BANCS.INPARAM.CustId = ""
					
					sv_u = urhk_B2k_ConvertAmount("")
					PRINT(sv_u)
					
					IF(sv_u == 0)THEN
					#{
						CUST.CIETXN.limitcharge1 = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
						PRINT(CUST.CIETXN.limitcharge1)
					#}
					ENDIF
					
					IF ((CUST.CIETXN.limitcharge1) > (CUST.CIETXN.limitcharge)) THEN
					#{
						CUST.CIETXN.chargeTranAmt = CUST.CIETXN.limitcharge
						PRINT(CUST.CIETXN.chargeTranAmt)
						#}
					ELSE
						#{
						CUST.CIETXN.chargeTranAmt = CUST.CIETXN.limitcharge1
						PRINT(CUST.CIETXN.chargeTranAmt)
					#}
					ENDIF
					
					#}
				ELSE
					#{
					
					IF ((CUST.CIETXN.limitcharge1usd) > (CUST.CIETXN.limitchargeusd)) THEN
					#{
						CUST.CIETXN.chargeTranAmt = CUST.CIETXN.limitchargeusd
						PRINT(CUST.CIETXN.chargeTranAmt)
						#}
					ELSE
						#{
						CUST.CIETXN.chargeTranAmt = CUST.CIETXN.limitcharge1usd
						PRINT(CUST.CIETXN.chargeTranAmt)
					#}
					ENDIF
					
				#}
				ENDIF
				
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(MID$(BANCS.STDIN.userId,0,6) == "FIVUSR")THEN
		#{
			CUST.CIETXN.outputData=CUST.CIETXN.scriptSuccess+","+CUST.CIETXN.errorFlg+","+CUST.CIETXN.errorMsg+","+CUST.CIETXN.chargeTranAmt+","
			CUST.CIETXN.outputData=CUST.CIETXN.outputData+CUST.CIETXN.chargeCrAcctID+","+CUST.CIETXN.chargeEventId+","+CUST.CIETXN.chargeTranCcy+","
			CUST.CIETXN.outputData=CUST.CIETXN.outputData+CUST.CIETXN.chargeTranAmt1+","+CUST.CIETXN.chargeRate+","+CUST.CIETXN.chargeRateCode +","
			CUST.CIETXN.outputData=CUST.CIETXN.outputData+CUST.CIETXN.chargeTranParticulars +","+CUST.CIETXN.chargeTranRmks +","

			sv_b=urhk_setOrbOut("outputData|"+CUST.CIETXN.outputData)
			PRINT(sv_b)
			
		#}
		ENDIF
		
END-->
