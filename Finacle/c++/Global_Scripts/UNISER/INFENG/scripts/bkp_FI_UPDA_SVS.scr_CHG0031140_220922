                #{
                sv_x = urhk_dbSQLWithBind("COMMIT")
                #}
                endif

                sv_a = " update SVSUSER.signmaintenance set EXPIRYDATE = to_date(?SVAR,'DD-MM-YYYY') ,LASTACTIVITY=?SVAR,MODIFIEDBY=?SVAR,MODIFIEDDATE=to_timestamp(?SVAR,'DD-MM-RR HH12:MI:SSXFF AM'),VERIFIEDBY=?SVAR,VERIFIEDDATE=to_timestamp(?SVAR,'DD-MM-RR HH12:MI:SSXFF AM')  where  SIGNID  ='"+CUST.DATA.signid+"' "

                BANCS.INPARAM.BINDVARS = CUST.DATA.expdate+"|UPDATE|"+BANCS.STDIN.userId+"|"+BANCS.STDIN.sysDate+"|"+BANCS.STDIN.userId+"|"+BANCS.STDIN.sysDate
                sv_v = urhk_dbSQLWithBind(sv_a)
