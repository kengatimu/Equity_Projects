                sv_a = "Insert into SVSUSER.AUDITINFO(ID,SIGNPOWERNO,SIGNID,MENUITEM,ACTIVITY,USERNAME,ISMASTER,OCCUREDAT,OLDVAL,NEWVAL,LOGMSG,ERRWARNING,ENTITYID) "
                sv_a = sv_a+" values (concat(?SVAR,svsuser.auditidsequence.nextval),0,?SVAR,'Signature','UPDATE',?SVAR,'N',to_timestamp(?SVAR,'DD-MM-RR HH12:MI:SSXFF AM'),?SVAR,?SVAR,?SVAR,'SUCCESS',?SVAR) "

