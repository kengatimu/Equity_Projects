	CUST.DATA.messageField = " Signature ID not Found"



        sv_s = "expirydate|select i.expirydate from SVSUSER.SIGNMAINTENANCE m , SVSUSER.SIGNCUSTINFO i,SVSUSER.SIGNOTHERINFO o where m.active ='Y'  and m.deleted ='N' and m.verified = 'Y' and i.verified ='Y' and m.signid =i.signid and m.signid =o.signid and o.signid =i.signid  and m.SIGNID = ?SVAR  and  o.ENTITYID = ?SVAR"

