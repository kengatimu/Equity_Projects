                BANCS.INPARAM.BINDVARS = CUST.DATA.expdate+"|UPDATE|"+BANCS.STDIN.userId+"|"+BANCS.STDIN.sysDate+"|"+BANCS.STDIN.userId+"|"+BANCS.STDIN.sysDate
