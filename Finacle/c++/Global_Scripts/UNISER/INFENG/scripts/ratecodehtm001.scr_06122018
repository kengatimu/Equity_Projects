<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether HTM Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","HTM")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","HTM",5)
	#}
	ENDIF
	sv_u = urhk_b2k_printrepos("BANCS")
	PRINT(sv_u)
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	CUST.HTM.acctCrncy =" "
	CUST.HTM.refCrncy=" "
	CUST.HTM.tranType=" "
	CUST.HTM.rateCode =" "
	CUST.HTM.rate=" "
	CUST.HTM.treaRate=" "
	CUST.HTM.errorFlg="N"
	CUST.HTM.errorMsg =" "
	CUST.HTM.rateCodeCash =" "
	CUST.HTM.rateCodetran = " "
	CUST.HTM.drCrInd = " "
	CUST.HTM.rate1=" "
	CUST.HTM.treaRate1=" "
	CUST.HTM.treaRefNum=" "
	
		CUST.HTM.treaRefNum = sv_b
		PRINT(CUST.HTM.treaRefNum)

		CUST.HTM.acctCrncy = sv_c
		PRINT(CUST.HTM.acctCrncy)

		CUST.HTM.refCrncy = sv_d
		PRINT(CUST.HTM.refCrncy)

		CUST.HTM.tranType = sv_f
		PRINT(CUST.HTM.tranType)

		CUST.HTM.drCrInd = sv_g
		PRINT(CUST.HTM.drCrInd)

		CUST.HTM.rateCode1 = sv_e
		PRINT(CUST.HTM.rateCode1)

		CUST.HTM.rate1 = CDOUBLE(sv_h)
		PRINT(CUST.HTM.rate1)

		CUST.HTM.treaRate1 = CDOUBLE(sv_i)
		PRINT(CUST.HTM.treaRate1)

	IF((CUST.HTM.acctCrncy != "") AND (CUST.HTM.refCrncy != "") AND (CUST.HTM.acctCrncy != CUST.HTM.refCrncy)) THEN
	#{
		###########################################################################################
		# Fetching RATECODE from custom table
		###########################################################################################

		IF(CUST.HTM.acctCrncy != CUST.HTM.refCrncy) THEN
		#{
			sv_s = "recCount|"
			sv_s = sv_s + " SELECT 1 FROM DUAL WHERE EXISTS("
			sv_s = sv_s + " SELECT 1 FROM TBAADM.CNC"
			sv_s = sv_s + " WHERE CRNCY_CODE = ?SVAR"
			sv_s = sv_s + " AND ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND DEL_FLG != 'Y'"
			sv_s = sv_s + " AND BANK_ID = ?SVAR)"
			PRINT(sv_s)

			BANCS.INPARAM.BINDVARS = CUST.HTM.refCrncy + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)

			IF(sv_d != 0)THEN
			#{
				CUST.HTM.errorFlg = "Y"
				CUST.HTM.errorMsg = "Invalid Ref. CCY"
				GOTO ENDOFSCRIPT
			#}
			ENDIF

			IF((CUST.HTM.tranType == "C") AND (CUST.HTM.drCrInd == "C")) THEN
			#{
				sv_s = "rateCode| select ratecode_cash from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.HTM.refCrncy + "|" + CUST.HTM.acctCrncy + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d ==0) THEN
				#{
					CUST.HTM.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.HTM.rateCode)
				#}
				
				ELSE
				#{
					#CUST.HTM.errorFlg="Y"
					#CUST.HTM.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			IF((CUST.HTM.tranType == "C") AND (CUST.HTM.drCrInd == "D")) THEN
			#{
				sv_s = "rateCode| select ratecode_cash from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.HTM.acctCrncy + "|" + CUST.HTM.refCrncy + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d ==0) THEN
				#{
					CUST.HTM.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.HTM.rateCode)
				#}
				ELSE
				#{
					#CUST.HTM.errorFlg="Y"
					#CUST.HTM.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF

			IF((CUST.HTM.tranType == "T") AND (CUST.HTM.drCrInd == "D")) THEN
			#{
				sv_s = "rateCode| select ratecode_tran from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.HTM.acctCrncy + "|" + CUST.HTM.refCrncy + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d ==0) THEN
				#{
					CUST.HTM.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.HTM.rateCode)

				#}
				ELSE
				#{
					#CUST.HTM.errorFlg="Y"
					#CUST.HTM.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			IF((CUST.HTM.tranType == "T") AND (CUST.HTM.drCrInd == "C")) THEN
			#{
				sv_s = "rateCode| select ratecode_tran from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.HTM.refCrncy + "|" + CUST.HTM.acctCrncy + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d ==0) THEN
				#{
					CUST.HTM.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.HTM.rateCode)

				#}
				ELSE
				#{
					#CUST.HTM.errorFlg="Y"
					#CUST.HTM.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	IF(CUST.HTM.rateCode1 != CUST.HTM.rateCode)THEN
	#{
		sv_u=urhk_SRV_SetErr("Treasury reference ratecode and defaulted ratecode differs")
		PRINT(sv_u)	
		GOTO ENDOFSCRIPT
	#}	
	ENDIF

	sv_s="rate,tresrate|SELECT CUST_RATE,TREASURY_RATE FROM TBAADM.FTRT WHERE TR_REF_NUM=?SVAR AND BANK_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.HTM.treaRefNum + "|" + BANCS.STDIN.contextBankId

	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)
        IF(sv_d ==0) THEN
        #{
                 CUST.HTM.rate = CDOUBLE(BANCS.OUTPARAM.rate)
                 PRINT(CUST.HTM.rate)
                 CUST.HTM.treaRate = CDOUBLE(BANCS.OUTPARAM.tresrate)
                 PRINT(CUST.HTM.treaRate)

        #}
	ENDIF

	IF((CUST.HTM.rate1 != CUST.HTM.rate) OR (CUST.HTM.treaRate1 != CUST.HTM.treaRate))THEN
	#{
		sv_u=urhk_SRV_SetErr("Defaulted rate values are not equal to special rate values ,Can't Proceed")
		PRINT(sv_u)	
	#}	
	ENDIF
	
	ENDOFSCRIPT:

TRACE OFF
				
END-->

