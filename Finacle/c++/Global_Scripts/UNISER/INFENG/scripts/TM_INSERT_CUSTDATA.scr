ENDIF
   	sv_x = urhk_B2k_PrintRepos("BANCS")
        PRINT(sv_x)

	CUST.DATA.chargeflg = "N"
	CUST.DATA.ERRFLAG = ""
        print(BANCS.STDIN.serviceName)  
        IF (( BANCS.STDIN.serviceName == "SRV_AddXferTranForPTranPost") OR ( BANCS.STDIN.serviceName == "SRV_ModifyXferTranForPTranPost")  OR ( BANCS.STDIN.serviceName == "SRV_AddAndPostCashTran") OR ( BANCS.STDIN.serviceName == "SRV_AddCashTranForPTranPost") OR ( BANCS.STDIN.serviceName == "SRV_ModifyCashTranForPTranPost") OR ( BANCS.STDIN.serviceName == "SRV_AddCashTran" ) OR ( BANCS.STDIN.serviceName == "SRV_AddCashTran") or (BANCS.STDIN.serviceName == "SRV_ModifyCashTran")) THEN
        #{
                sv_u = urhk_SRV_GetVal("tranDtl.tranIdentifier.tranId")
		print(sv_u)
		IF(sv_u == 0) THEN
		#{
			CUST.DATA.tranid = BANCS.OUTPARAM.srvValue
			print(CUST.DATA.tranid)
		#}
		ELSE
		#{
			CUST.DATA.tranid = ""
		#}
		ENDIF
		sv_u = urhk_SRV_GetVal("tranDtl.tranIdentifier.tranDate")
                print(sv_u)
                IF(sv_u == 0) THEN
                #{
                        CUST.DATA.trandate = MID$(BANCS.OUTPARAM.srvValue,0,10)
                        print(CUST.DATA.trandate)
                #}
                ELSE
                #{
                        CUST.DATA.trandate = ""
                #}
                ENDIF

        #}
        ENDIF
	IF ( BANCS.STDIN.serviceName == "SRV_AddAndPostXferTran") THEN
        #{ 
		sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
                print(sv_u)
                IF(sv_u == 0) THEN
                #{
                        CUST.DATA.tranid = BANCS.OUTPARAM.srvValue
                        print(CUST.DATA.tranid)
                #}
                ELSE
                #{
                        CUST.DATA.tranid = ""
                #}
                ENDIF
                sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranDate")
                print(sv_u)
                IF(sv_u == 0) THEN
                #{
                        CUST.DATA.trandate = MID$(BANCS.OUTPARAM.srvValue,0,10)
                        print(CUST.DATA.trandate)
                #}
                ELSE
                #{
                        CUST.DATA.trandate = ""
                #}
                ENDIF

        #}
        ENDIF
	print(CUST.DATA.tranid)
	
		###################################################
		# Print the Custom and Bancs Repositories
		###################################################
			sv_r=urhk_B2k_PrintRepos("CUST")

			###################################################
			# Parse the customized values
			###################################################
			sv_z = ONS.CUSTOM.custDataIn
			print(sv_z)
			sv_u = urhk_ParseONSCustData(sv_z)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		        IF (( BANCS.STDIN.serviceName == "SRV_ModifyXferTranForPTranPost") or (BANCS.STDIN.serviceName == "SRV_ModifyCashTranForPTranPos") or (BANCS.STDIN.serviceName == "SRV_ModifyCashTranForPTranPost" ) or (BANCS.STDIN.serviceName == "SRV_ModifyCashTran")) THEN
			#{
			        CUST.DATA.TRAINID = CUST.DATA.tranid 
                                sv_s = ""
				sv_s = sv_s + " count|"
				sv_s = sv_s + " SELECT count(1)"
				sv_s = sv_s + "  from CUSTOM.CUST_TM"
				sv_s = sv_s + " WHERE TRAN_ID='" + CUST.DATA.TRAINID  + "' and TRAN_DATE = to_date('"+ CUST.DATA.trandate  +"','dd-mm-yyyy')"
				sv_s = sv_s + " AND BANK_ID='" + BANCS.STDIN.contextBankId +"'"
				print(sv_s)
				sv_u = urhk_dbSelectWithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN
				#{

					CUST.DATA.count =BANCS.OUTPARAM.count
					print(CUST.DATA.count)
	 
				#}
                                ELSE
                                #{
                                          CUST.DATA.count ="" 
                                #}
				ENDIF
                                IF (CUST.DATA.count != "") THEN
                                #{
                                        sv_s =""
					sv_s = sv_s + " delete"
					sv_s = sv_s + "  from CUSTOM.CUST_TM"
					sv_s = sv_s + " WHERE TRAN_ID='" + CUST.DATA.TRAINID  + "' and TRAN_DATE =to_date('"+ CUST.DATA.trandate  +"','dd-mm-yyyy')"
					sv_s = sv_s + " AND BANK_ID='" + BANCS.STDIN.contextBankId +"'"
					print(sv_s) 
                                        sv_e= urhk_dbsqlWithBind(sv_s)
                                        print(sv_e)
					IF(sv_e==0) THEN
					#{
						CUST.DATA.FLG ="Y"
					#}
	                                ENDIF 
				#}
				ENDIF
                        #}
                        ENDIF

			#CUST.DATA.ERRFLAG = "Y"
			#sv_u = urhk_SRV_SetErr("No of loan field is mandatory under general tab for this schm type")
			#EXITSCRIPT
				
			sv_d = 1
	
		        WHILE(sv_d <= 1)
		        #{
				IF (sv_d == 1) THEN
				#{
					IF (FIELDEXISTS(BANCS.INPUT.tmdet1_FIELD_1)) THEN
					#{
						CUST.DATA.Address = BANCS.INPUT.tmdet1_FIELD_1
						print(CUST.DATA.Address)
					#}
					ELSE
					#{
						CUST.DATA.Address = ""
					#}
					ENDIF

					IF (FIELDEXISTS(BANCS.INPUT.tmdet1_FIELD_2)) THEN
					#{
						CUST.DATA.id_no = BANCS.INPUT.tmdet1_FIELD_2
						print(CUST.DATA.id_no)
					#}
					ELSE
					#{
						CUST.DATA.id_no = ""
					#}
					ENDIF

					IF (FIELDEXISTS(BANCS.INPUT.tmdet1_FIELD_3)) THEN
					#{
						CUST.DATA.name = BANCS.INPUT.tmdet1_FIELD_3
						print(CUST.DATA.name)
					#}
					ELSE
					#{
						CUST.DATA.name = ""
					#}
					ENDIF

					IF (FIELDEXISTS(BANCS.INPUT.tmdet1_FIELD_4)) THEN
					#{
						CUST.DATA.typofId = BANCS.INPUT.tmdet1_FIELD_4
						print(CUST.DATA.typofId)
					#}
					ELSE
					#{
						CUST.DATA.typofId = ""
					#}
					ENDIF
					
					IF (FIELDEXISTS(BANCS.INPUT.tmdet1_FIELD_5)) THEN
					#{
						CUST.DATA.Issue = BANCS.INPUT.tmdet1_FIELD_5
						print(CUST.DATA.Issue)

						IF(CUST.DATA.Issue == "undefined") THEN
						#{
							CUST.DATA.Issue = MID$(BANCS.STDIN.BODDate,0,10)
							PRINT(CUST.DATA.Issue)
						#}
						ENDIF
					#}
					ELSE
					#{
						CUST.DATA.Issue = ""
					#}
					ENDIF
				#}
				ENDIF

				IF(CUST.DATA.Issue == "undefined") THEN
				#{
					CUST.DATA.Issue = MID$(BANCS.STDIN.BODDate,0,10)
					PRINT(CUST.DATA.Issue)
				#}
				ENDIF
	

				sv_c = ""
				sv_c = sv_c + "INSERT INTO CUSTOM.CUST_TM ("
				sv_c = sv_c + "SRL_NO,"
				sv_c = sv_c + "ADDRESS,ID_NO,NAME,TYP_OF_ID,ISSUE_DATE,"
				sv_c = sv_c + "BANK_ID,TRAN_ID ,TRAN_DATE)"
				sv_c = sv_c + " VALUES ("
				sv_c = sv_c + "?SVAR,?SVAR,?SVAR,"
				sv_c = sv_c + "?SVAR,?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,"
				sv_c = sv_c + "?SVAR ,to_date(?SVAR,'DD-MM-YYYY'))"
				print(sv_c)
				print(sv_d)	
				print(CUST.DATA.id_no)
				print(CUST.DATA.name)
				print(CUST.DATA.typofId)
				print(CUST.DATA.Issue)
				print(CUST.DATA.tranid)
				CUST.DATA.srlno = sv_d
				print(CUST.DATA.Address)
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = CUST.DATA.srlno  +"|"+ CUST.DATA.Address 
				BANCS.INPARAM.BINDVARS =BANCS.INPARAM.BINDVARS+"|"+  CUST.DATA.id_no +"|"+ CUST.DATA.name +"|"+ CUST.DATA.typofId +"|"+ CUST.DATA.Issue
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+ BANCS.STDIN.contextBankId  +"|"+CUST.DATA.tranid +"|"+CUST.DATA.trandate
				print(BANCS.INPARAM.BINDVARS)

				sv_e= urhk_dbsqlWithBind(sv_c)
				print(sv_e)
				IF(sv_e==0) THEN
				#{
					CUST.DATA.FLG ="Y"
				#}
				ELSE
				#{	
					CUST.DATA.FLG ="N"
				#}
				ENDIF
		#+++++++++++++++++++
		if(fieldexists(BANCS.INPUT.tmdet_FIELD_18))then
			CUST.DATA.AcctId = BANCS.INPUT.tmdet_FIELD_18 
		else
			CUST.DATA.AcctId = ""
		endif
                if((CUST.DATA.AcctId!="") and (CUST.DATA.name!=""))then
                        lv_u = urhk_getAcctDetailsInRepository(CUST.DATA.AcctId)
                        if(lv_u==0)then
                                CUST.DATA.laSolId = BANCS.OUTPARAM.acctSolId
                                CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
                                CUST.DATA.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
                                CUST.DATA.cifId = BANCS.OUTPARAM.cifId
                                if(CUST.DATA.acctOwnerShip!="O")then
                                        lv_d = " sdnCnt | select custom.fn_unscsdn_chk(?SVAR,?SVAR,?SVAR,'HACLINQ',?SVAR,?SVAR) from dual "
                                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.AcctId + "|" + CUST.DATA.cifId + "|" + CUST.DATA.name + "|" + CUST.DATA.name 
                                        print(BANCS.INPARAM.BINDVARS)
                                        print(sv_d)
                                        lv_u = urhk_dbSelectWithBind(lv_d)
                                        if(sv_u==0)then
                                                CUST.DATA.sdnCnt = BANCS.OUTPARAM.sdnCnt
                                        else
                                                CUST.DATA.sdnCnt = "N"
                                        endif
                                        print(CUST.DATA.sdnCnt)
                                        if(CUST.DATA.sdnCnt=="Y")then
                                                ##lv_r=urhk_B2k_PutUserException("USN")
						##BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
						##BANCS.INPARAM.DrCrInd = "C" 
						##BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
						##sv_c = urhk_FTS_RaiseException("USN")
						##PRINT(sv_c)
                                        endif
                                endif
                        endif
                endif
		#+++++++++++++++++++

				print(sv_d)
				sv_d = sv_d + 1
				

		        #}
		        DO
			IF (CUST.DATA.FLG =="Y") THEN
			#{
				sv_r=urhk_dbSQLWithBind("commit")
				print(sv_d)
				BANCS.OUTPUT.SuccessOrFailure = "S"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")	
			#{
			ENDIF

	##Check For Damage Notes

	IF (FIELDEXISTS(BANCS.INPUT.tmdet_FIELD_22)) THEN	
		IF (BANCS.INPUT.tmdet_FIELD_22 != "") THEN 

			CUST.DATA.DmgAmt = BANCS.INPUT.tmdet_FIELD_22
			print(CUST.DATA.DmgAmt)

			sv_p = CUST.DATA.DmgAmt
			sv_q = 0
			sv_q = GETPOSITION(sv_p,",")
			PRINT(sv_q)			
			IF(sv_q > 0)THEN
			#{
				CUST.DATA.DmgAmt  = MID$(sv_p,0,sv_q-1)
				PRINT(CUST.DATA.DmgAmt)
				CUST.DATA.DmgAmt = CUST.DATA.DmgAmt + "." + MID$(sv_p,sv_q,2)
				PRINT(CUST.DATA.DmgAmt)
			#}
			ENDIF

			#sv_u = "ActBal | SELECT  replace (replace ( replace (Trim( to_char(?SVAR, '999,999,999,999,999.99')),'.','X'),',','.'),'X',',') from dual "
			#BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.ActBal
			#sv_d = urhk_dbSelectWithBind(sv_u)
			#if(sv_d==0)then
			#	EBSRV.GLBDATA.ActBal = BANCS.OUTPARAM.ActBal
			#	Print (EBSRV.GLBDATA.ActBal)
			#endif

			BANCS.INPUT.acctType = "COMMISSION"
			CALL("fetchAcctForComm.scr")
			
			IF(EQT.COMM.errorFlg == "Y")THEN
				GOTO ENDOFSCRIPT
			ELSE
				PRINT(EQT.COMM.crAcctNum)
				CUST.DATA.commAcct = EQT.COMM.crAcctNum
			endif
			
			BANCS.INPUT.acctType = "TAX"
			CALL("fetchAcctForComm.scr")		
			IF(EQT.COMM.errorFlg == "Y")THEN

				GOTO ENDOFSCRIPT
			ELSE
				PRINT(EQT.COMM.crAcctNum)
				CUST.DATA.vatAcct = EQT.COMM.crAcctNum
			endif

			BANCS.INPUT.moduleName = "OT"
			BANCS.INPUT.parameterId = "COMM_CHARGE_PERCENT"		
			CALL ("getcparamvalue.scr")
			CUST.DATA.CHARGE_PERCENT = BANCS.OUTPUT.parameterVal
			Print (CUST.DATA.CHARGE_PERCENT)

			BANCS.INPUT.moduleName = "OT"
			BANCS.INPUT.parameterId = "COMM_VAT_PERCENT"	
			CALL ("getcparamvalue.scr")
			CUST.DATA.VAT_PERCENT = BANCS.OUTPUT.parameterVal
			Print (CUST.DATA.VAT_PERCENT)

			CUST.DATA.chrgAmt = FORMAT$ ( (CDOUBLE(CUST.DATA.DmgAmt)*CDOUBLE(CUST.DATA.CHARGE_PERCENT)*(0.01) ),"%.2f")
			print (CUST.DATA.chrgAmt)
			CUST.DATA.vatAmt = FORMAT$ ((cdouble(CUST.DATA.chrgAmt) * CDOUBLE(CUST.DATA.VAT_PERCENT)*(0.01)),"%.2f")
			print (CUST.DATA.vatAmt)

			##Checkif Existing
			sv_s = "recCount|select count(1) from custom.c_dntd where tran_id= ?SVAR  and tran_date=TO_DATE(?SVAR,'DD-MM-YYYY') and  tran_status='E' and bank_id=?SVAR "
			BANCS.INPARAM.BINDVARS =  CUST.DATA.tranid + "|" +  CUST.DATA.trandate + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)	
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)			
			IF(sv_d != 0)THEN
				CUST.DATA.errorFlg ="Y"
				CUST.DATA.MSG ="Error in Database Operation!!"
				GOTO ENDOFSCRIPT
			ELSE
				CUST.DATA.recCount = BANCS.OUTPARAM.recCount
				Print (CUST.DATA.recCount)
			ENDIF
			
			IF ( cint(CUST.DATA.recCount) == 0 ) THEN

				sv_s = "Insert into CUSTOM.C_DNTD (TRAN_ID, TRAN_DATE, TRAN_TYPE, TRAN_SUB_TYPE, INIT_SOL_ID, CRNCY_CODE, DMG_NOTE_AMT, CHARGE_AMT,"
				sv_s = sv_s + " VAT_AMT, ACCT_ID, COMM_ACCT_ID, VAT_ACCT_ID, RATE_CODE, RATE, RCRE_USER_ID, RCRE_TIME, BANK_ID, TRAN_STATUS) Values ("
				sv_s = sv_s + " ?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, "
				sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, SYSDATE, ?SVAR, 'E' )"
				print(sv_s)			
				BANCS.INPARAM.BINDVARS = CUST.DATA.tranid + "|" +  CUST.DATA.trandate + "|" + CUST.DATA.partTranType + "|" + CUST.DATA.tranSubType + "|" + BANCS.STDIN.mySolId
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.tmdet_FIELD_21 + "|" + CUST.DATA.DmgAmt + "|" + CUST.DATA.chrgAmt
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.vatAmt + "|" + BANCS.INPUT.tmdet_FIELD_18 + "|" + CUST.DATA.commAcct + "|" + CUST.DATA.vatAcct  + "|" + BANCS.INPUT.tmdet_FIELD_23
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.tmdet_FIELD_24 + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSqlWithBind(sv_s)
				PRINT(sv_d)
				
				IF(sv_d != 0) THEN
				#{
					CUST.DATA.errorFlg = "Y"
					CUST.DATA.Msg = "Error in Saving Damage Note details in DB!!"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			
			ELSE
				sv_s = "UPDATE CUSTOM.C_DNTD set CRNCY_CODE = ?SVAR ,DMG_NOTE_AMT = ?SVAR ,CHARGE_AMT = ?SVAR , VAT_AMT =?SVAR  where tran_id =?SVAR "
				sv_s = sv_s + "  and  tran_date  = TO_DATE(?SVAR,'DD-MM-YYYY')  and bank_id = ?SVAR dnd  INIT_SOL_ID =?SVAR  "
				print(sv_s)			
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.tmdet_FIELD_21 + "|" + CUST.DATA.DmgAmt + "|" + CUST.DATA.chrgAmt + "|" + CUST.DATA.vatAmt + "|" + CUST.DATA.tranid + "|" +  CUST.DATA.trandate  + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSqlWithBind(sv_s)
				PRINT(sv_d)				
				IF(sv_d != 0) THEN
				#{
					CUST.DATA.errorFlg = "Y"
					CUST.DATA.Msg = "Error in Saving Damage Note details in DB!!"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			ENDIF
			
		ENDIF
	ENDIF

ENDOFSCRIPT:
EXITSCRIPT
TRACE OFF
