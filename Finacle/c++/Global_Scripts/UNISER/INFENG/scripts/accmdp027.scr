<--START
CHECKSUM="9340cf27fb857653f3c87b27ffd4d6a71860cbd2db9adc888c3462fc373ef172"
	
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CONTRACT") == 0) THEN
	#{
		CREATECLASS("CUST", "CONTRACT", 5)
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "INTERFACE") == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# Getting Input at Backend
	#--------------------------------------------------------------------------
	CUST.CONTRACT.contractId =  TRIM(BANCS.INPUT.contractId)
	print(CUST.CONTRACT.contractId)
	BANCS.INPARAM.BINDVARS = CUST.CONTRACT.contractId + "|N|Y|" + BANCS.STDIN.contextBankId
	sv_s = " acctNum|SELECT  acct_num  "
	sv_s = sv_s + " FROM  custom.catod_sanction_table "
	sv_s = sv_s + "  WHERE  request_id =?SVAR  "
	sv_s = sv_s + "  AND   del_flg = ?SVAR   "
	sv_s = sv_s + "  AND  entity_cre_flg = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		sv_w = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_w)
		GOTO FINISH
		#}
	ELSE
		#{
		CUST.CONTRACT.accNum = BANCS.OUTPARAM.acctNum
	#}
	ENDIF
	
	#CUST.CONTRACT.accNum =  TRIM(BANCS.INPUT.acctNum)
	print(CUST.CONTRACT.accNum)
	
	BANCS.INPARAM.BINDVARS = CUST.CONTRACT.accNum + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "crncyCode,acctName,solId|"
	sv_s = sv_s + " SELECT ACCT_CRNCY_CODE,ACCT_NAME,SOL_ID"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		CUST.CONTRACT.crncyCode = ""
		CUST.CONTRACT.acctName = ""
		CUST.CONTRACT.solId = ""
		#}
	ELSE
		#{
		CUST.CONTRACT.crncyCode = BANCS.OUTPARAM.crncyCode
		print(CUST.CONTRACT.crncyCode)
		CUST.CONTRACT.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CONTRACT.acctName)
		CUST.CONTRACT.solId = BANCS.OUTPARAM.solId
		print(CUST.CONTRACT.solId)
		
	#}
	ENDIF
	
	
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctCrncy|" + CUST.CONTRACT.crncyCode
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctSolId|" + CUST.CONTRACT.solId
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctName|" + CUST.CONTRACT.acctName
	sv_u = urhk_SetOrbOut(sv_w)
	sv_w = "acctNum|" + CUST.CONTRACT.accNum
	sv_u = urhk_SetOrbOut(sv_w)
	
	
	FINISH:
		EXITSCRIPT
		
END-->
