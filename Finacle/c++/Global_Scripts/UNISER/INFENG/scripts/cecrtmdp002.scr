<--START
CHECKSUM="b2fe47a1aac946ac328f590d85154b3fa57337fa0f1d335e52163feaecdae650"
	TRACE ON
	
	
	#----------------------------------------------------------
	# Transaction sub type returned according to the bank id
	# for UG(56) it is of type "BI" and other bank it is "CI"
	#----------------------------------------------------------
	
	IF( BANCS.STDIN.contextBankId == "56") THEN
	#{
		PRINT(BANCS.STDIN.contextBankId)
		sv_b = "transubtype|" + "BI"
		sv_z = urhk_SetOrbOut(sv_b)
		#}
	ELSE
		#{
		PRINT(BANCS.STDIN.contextBankId)
		sv_b = "transubtype|" + "CI"
		sv_z = urhk_SetOrbOut(sv_b)
		
	#}
	ENDIF
	
	TRACE OFF
	EXITSCRIPT
END-->
