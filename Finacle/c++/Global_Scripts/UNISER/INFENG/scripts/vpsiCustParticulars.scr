<--start
trace on
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(classexists("CUST","ALERTS")==0)then
                createclass("CUST","ALERTS",5)
        endif
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                CUST.ALERTS.TranId = MTT.InputDetails.Argument1
                CUST.ALERTS.tranParticular = MTT.InputDetails.Argument2
                CUST.ALERTS.tranRemarks = MTT.InputDetails.Argument3
                CUST.ALERTS.AcctNum = MTT.InputDetails.Argument4
                CUST.ALERTS.partTranType = MTT.InputDetails.Argument5
                CUST.ALERTS.TranAmt = MTT.InputDetails.Argument6
                CUST.ALERTS.tranCrncyCode = MTT.InputDetails.Argument7
                CUST.ALERTS.acctName = MTT.InputDetails.Argument8
                CUST.ALERTS.PartTranSrlNum = MTT.InputDetails.Argument9
                Print (CUST.ALERTS.PartTranSrlNum)
                CUST.ALERTS.DTHRemarks = MTT.InputDetails.Argument10
                Print (CUST.ALERTS.DTHRemarks)
                CUST.ALERTS.tranParticular2 = MTT.InputDetails.Argument11
                Print (CUST.ALERTS.tranParticular2)
                CUST.ALERTS.dupySrlNum = MTT.InputDetails.Argument12
                Print (CUST.ALERTS.dupySrlNum)
        else
		CUST.ALERTS.TranId = ""
		CUST.ALERTS.tranParticular = ""
		CUST.ALERTS.tranRemarks= ""
		CUST.ALERTS.AcctNum = ""
		CUST.ALERTS.partTranType = ""
		CUST.ALERTS.TranAmt = ""
		CUST.ALERTS.tranCrncyCode = ""
		CUST.ALERTS.acctName = ""
		CUST.ALERTS.PartTranSrlNum ="" 
		CUST.ALERTS.DTHRemarks = ""
		CUST.ALERTS.tranParticular2 = ""
		CUST.ALERTS.dupySrlNum = ""
	endif

	sv_r = urhk_b2k_sleep("5")
        print(BANCS.STDIN.sysDate)
        if(CUST.ALERTS.TranId=="")then
                exitscript
        else
                sv_d = "pstCnt|select count(*) "
                sv_d = sv_d + " from tbaadm.dtd where bank_id= ?SVAR "
                sv_d = sv_d + " and tran_id=lpad(?SVAR,9,' ') "
                sv_d = sv_d + " and tran_date=to_date(?SVAR,'DD-MM-RR') "
                sv_d = sv_d + " and pstd_flg='Y' "
                sv_d = sv_d + " and del_flg='N' "
		sv_d = sv_d + " and tran_sub_type in ('BS','SI') "
                sv_d = sv_d + " and part_tran_type=?SVAR "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.TranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.ALERTS.partTranType
                print(sv_d)
                print(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u==0)then
                        CUST.ALERTS.pstCnt = BANCS.OUTPARAM.pstCnt
                else
                        CUST.ALERTS.pstCnt = 0
                endif
        endif
        print(CUST.ALERTS.pstCnt)
        if(cdouble(CUST.ALERTS.pstCnt)<=0)then
                exitscript
	endif
	CUST.ALERTS.siNum = right$(CUST.ALERTS.DTHRemarks,12)
	print(CUST.ALERTS.siNum)
	lv_p = " upySrlNum,upyAdmNum | select pr_srl_num ,amt_drv_srl_num from tbaadm.pyrh "
	lv_p = lv_p + " where bank_id=?SVAR and trim(pr_b2k_id)=?SVAR "
	lv_p = lv_p + " and pr_b2k_type='SI' and part_tran_type=?SVAR "
	lv_p = lv_p + " and entity_cre_flg='Y' and del_flg='N' and rownum<=1"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + trim(CUST.ALERTS.siNum) + "|" + CUST.ALERTS.partTranType
	print(lv_p)
	print(BANCS.INPARAM.BINDVARS)
	lv_o = urhk_dbSelectWithBind(lv_p)
	if(lv_o==0)then
		CUST.ALERTS.upySrlNum = BANCS.OUTPARAM.upySrlNum
		CUST.ALERTS.upyAdmNum = BANCS.OUTPARAM.upyAdmNum
	else
		CUST.ALERTS.upySrlNum = ""
		CUST.ALERTS.upyAdmNum = ""
	endif
	##lv_p = "dpySrlNum |  select pr_srl_num from tbaadm.dtd where bank_id=?SVAR "
	##lv_p = lv_p + " and tran_id=lpad(?SVAR,9,' ') and tran_date=to_date(?SVAR,'DD-MM-RR') and part_tran_srl_num=?NVAR "
	##lv_p = lv_p + " and pstd_flg='Y' and del_flg='N' and trim(si_srl_num)=?SVAR and part_tran_type=?SVAR " 
	##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + trim(CUST.ALERTS.TranId) + "|" + left$(BANCS.STDIN.BODDate,10) + "|" +  CUST.ALERTS.PartTranSrlNum + "|" + trim(CUST.ALERTS.siNum) + "|" + CUST.ALERTS.partTranType  
	##print(BANCS.INPARAM.BINDVARS)
	##print(lv_p)
	##lv_o = urhk_dbSelectWithBind(lv_p)
	##if(lv_o==0)then
	##CUST.ALERTS.dupySrlNum = BANCS.OUTPARAM.dpySrlNum
	##else
	##CUST.ALERTS.dupySrlNum = ""
	##endif
	lv_p = " pySrlNum,pyAdmNum | select pr_srl_num ,amt_drv_srl_num from tbaadm.pyrh "
	lv_p = lv_p + " where bank_id=?SVAR and trim(pr_b2k_id)=?SVAR "
	if(CUST.ALERTS.partTranType=="D")then
	lv_p = lv_p + " and pr_b2k_type='SI' and part_tran_type='C' "
	endif
	if(CUST.ALERTS.partTranType=="C")then
	lv_p = lv_p + " and pr_b2k_type='SI' and part_tran_type='D' "
	endif
	lv_p = lv_p + " and entity_cre_flg='Y' and del_flg='N' and rownum<=1"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + trim(CUST.ALERTS.siNum)
	print(lv_p)
	print(BANCS.INPARAM.BINDVARS)
	lv_o = urhk_dbSelectWithBind(lv_p)
	if(lv_o==0)then
		CUST.ALERTS.pySrlNum = BANCS.OUTPARAM.pySrlNum
		CUST.ALERTS.pyAdmNum = BANCS.OUTPARAM.pyAdmNum
	else
		CUST.ALERTS.pySrlNum = ""
		CUST.ALERTS.pyAdmNum = ""
	endif
	lv_h = "siacid,sirptCode,sirefNum,siTranParticular,siRemarks,siNums| "
	lv_h = lv_h + " select acid,rpt_code,ref_num,tran_particular,tran_rmks,pr_srl_num  "
	lv_h = lv_h + " from tbaadm.pyrd where bank_id=?SVAR and  pr_srl_num=lpad(?SVAR,9,' ') "
	lv_h = lv_h + " and entity_cre_flg='Y' and del_flg='N' " 
	lv_h = lv_h + " and serial_num in (select max(serial_num) from tbaadm.pyrd "
	lv_h = lv_h + " where bank_id=?SVAR and  pr_srl_num=lpad(?SVAR,9,' ') "
	lv_h = lv_h + " and entity_cre_flg='Y' and del_flg='N' ) "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + trim(CUST.ALERTS.pySrlNum) + "|" + BANCS.STDIN.contextBankId + "|" + trim(CUST.ALERTS.pySrlNum)
	print(lv_h)
	print(BANCS.INPARAM.BINDVARS)
	lv_s = urhk_dbSelectWithBind(lv_h)
	if(lv_s==0)then
		CUST.ALERTS.siacid = BANCS.OUTPARAM.siacid
		CUST.ALERTS.sirptCode = BANCS.OUTPARAM.sirptCode
		CUST.ALERTS.sirefNum = BANCS.OUTPARAM.sirefNum
		CUST.ALERTS.siTranParticular = BANCS.OUTPARAM.siTranParticular
		CUST.ALERTS.siRemarks = BANCS.OUTPARAM.siRemarks
		CUST.ALERTS.siNums = BANCS.OUTPARAM.siNums
	else
		CUST.ALERTS.siacid = "" 
		CUST.ALERTS.sirptCode = ""
		CUST.ALERTS.sirefNum = ""
		CUST.ALERTS.siTranParticular = ""
		CUST.ALERTS.siRemarks = ""
		CUST.ALERTS.siNums = ""
	endif
	if(CUST.ALERTS.siacid!="")then
                sv_a= urhk_B2k_AcidToForacid(CUST.ALERTS.siacid)
                if(sv_a==0)then
                        EBSRV.GLBDATA.AcctId = BANCS.OUTPARAM.Foracid
                else
                        EBSRV.GLBDATA.AcctId = ""
                endif
		sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.AcctId)
                if(sv_u == 0)then
			EBSRV.GLBDATA.acctNAme = BANCS.OUTPARAM.acctName
		else
			EBSRV.GLBDATA.acctNAme = ""
		endif
	endif
	#Virement permanent, RefNumber, Beneficiary Name, Reason
	if(CUST.ALERTS.partTranType=="D")then
		if(CUST.ALERTS.sirefNum!="")then
			CUST.ALERTS.tranParts = "Virement permanent," + CUST.ALERTS.sirefNum + " " + EBSRV.GLBDATA.acctNAme + " " + CUST.ALERTS.siRemarks  
		else
			CUST.ALERTS.tranParts = "Virement permanent," + EBSRV.GLBDATA.acctNAme + " " + CUST.ALERTS.siRemarks  
		endif
	endif
	#Virement permanent, Ordering Name, Reason
	if(CUST.ALERTS.partTranType=="C")then
		CUST.ALERTS.tranParts = "Virement permanent," + EBSRV.GLBDATA.acctNAme + " " + CUST.ALERTS.siRemarks  
	endif
	if(CUST.ALERTS.tranParts!="")then
		CUST.ALERTS.tranParts = left$(CUST.ALERTS.tranParts,50)
	endif
	if(CUST.ALERTS.tranParts!="")then
		lv_u = "update tbaadm.dtd set REF_NUM='',TRAN_RMKS='',TRAN_PARTICULAR_2='', tran_particular =?SVAR where bank_id=?SVAR and tran_id=lpad(?SVAR,9,' ') and tran_date=to_date(?SVAR,'DD-MM-RR') and trim(si_srl_num) = ?SVAR and trim(pr_srl_num)=?SVAR and part_tran_type=?SVAR and pstd_flg='Y' and del_flg='N' " 
		print(CUST.ALERTS.upySrlNum)
		print(CUST.ALERTS.dupySrlNum)	
		BANCS.INPARAM.BINDVARS = CUST.ALERTS.tranParts + "|" + BANCS.STDIN.contextBankId + "|" + trim(CUST.ALERTS.TranId) + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + trim(CUST.ALERTS.siNum) + "|" + trim(CUST.ALERTS.dupySrlNum) + "|" +  CUST.ALERTS.partTranType 
		print(BANCS.INPARAM.BINDVARS)
		print(lv_u)
		lv_d = urhk_dbSqlWithBind(lv_u)
		print(lv_d)
		if(lv_d==0)then
			lv_j = urhk_dbSqlWithBind("commit")
		else
			lv_j = urhk_dbSqlWithBind("rollback")
		endif
	endif
	exitscript
trace off
end-->
