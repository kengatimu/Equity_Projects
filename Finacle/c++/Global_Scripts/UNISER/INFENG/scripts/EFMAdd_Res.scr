<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether INTERFACE Class exists else create it
	###########################################################################################
		
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	
	CUST.INTERFACE.status = ""
	

	CUST.INTERFACE.efm_respCode = ""
	CUST.INTERFACE.efm_mesg = ""
	CUST.INTERFACE.efm_errorCode = ""
	CUST.INTERFACE.efm_errorDesc = ""
	CUST.INTERFACE.efm_FieldName= ""
	CUST.INTERFACE.efm_respErrorMessage= ""
	CUST.INTERFACE.efm_respStatus = ""
	
	sv_x = CUST.INTERFACE.respXMLMsg
	
	#--------------------------------------------------------------------------------------------------------
	# Fetching the status of the request
	#--------------------------------------------------------------------------------------------------------
	sv_y = "<HostTransaction>"
	sv_z = "</HostTransaction>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.ubusStuatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		sv_x = CUST.INTERFACE.ubusStuatus
		PRINT(sv_x)
		sv_y = "<Status>"
		sv_z = "</Status>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.status = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
			PRINT(CUST.INTERFACE.status)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.status = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.status)
	
	#--------------------------------------------------------------------------------------------------------
	# If Success the fetch other values from the response xml
	#--------------------------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.status == "SUCCESS") THEN
	#{
		CUST.INTERFACE.efm_errorMsgFlg = "N"
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<executeFinacleScriptResponse>"
		sv_z = "</executeFinacleScriptResponse>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			
			sv_y = "<executeFinacleScript_CustomData>"
			sv_z = "</executeFinacleScript_CustomData>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				
				sv_y = "<EFMAdd_RES>"
				sv_z = "</EFMAdd_RES>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF(GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<EFMStatus>"
					sv_z = "</EFMStatus>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.efm_respStatus = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
						print(CUST.INTERFACE.efm_respStatus)
					#}
					ENDIF
					
					IF(CUST.INTERFACE.efm_respStatus == "SUCCESS")THEN
					#{
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<EMP_ID>"
						sv_z = "</EMP_ID>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.efm_respCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
							print(CUST.INTERFACE.efm_respCode)
						#}
						ENDIF
						
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<MESSAGE>"
						sv_z = "</MESSAGE>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.efm_mesg = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,100)
							print(CUST.INTERFACE.efm_mesg)
						#}
						ENDIF
					#}
					ELSE
					#{
						print("inelse err")
						
						
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<EFMErrors>"
						sv_z = "</EFMErrors>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.efm_EFMErrors = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,1000)
							print(CUST.INTERFACE.efm_EFMErrors)
						#}
						ENDIF
						#sv_x = CUST.INTERFACE.respXMLMsg
						#sv_y = "<ErrorMessage_1>"
						#sv_z = "</ErrorMessage_1>"
						#sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						#sv_e = GETPOSITION(sv_x, sv_z) - 1
						#IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
						#	CUST.INTERFACE.efm_respErrorMessage = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,80)
						#	print(CUST.INTERFACE.efm_respErrorMessage)
						#}
						#ENDIF
						
						#sv_x = CUST.INTERFACE.respXMLMsg
						#sv_y = "<FieldName_1>"
						#sv_z = "</FieldName_1>"
						#sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						#sv_e = GETPOSITION(sv_x, sv_z) - 1
						#IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
						#	CUST.INTERFACE.efm_FieldName = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
						#	print(CUST.INTERFACE.efm_FieldName)
						#}
						#ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		
	#}
	ELSE
	#{
		CUST.INTERFACE.efm_errorMsgFlg = "Y"
		IF(CUST.INTERFACE.status == "FAILURE") THEN
		#{
			sv_x = CUST.INTERFACE.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.efm_errorCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
				PRINT(CUST.INTERFACE.efm_errorCode)
			#}
			ENDIF
			IF(CUST.INTERFACE.efm_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorDesc>"
				sv_z = "</ErrorDesc>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.efm_errorDesc = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,120)
					PRINT(CUST.INTERFACE.efm_errorDesc)
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		IF((CUST.INTERFACE.efm_errorCode == "") AND (CUST.INTERFACE.efm_errorDesc == "")) THEN
		#{
			CUST.INTERFACE.efm_errorCode = "SYSERR"
			CUST.INTERFACE.efm_errorDesc = "Could not get response from server"
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.INTERFACE.efm_errorMsgFlg)
	
	PRINT(CUST.INTERFACE.efm_errorCode)
	PRINT(CUST.INTERFACE.efm_errorDesc)

	
	
	
	#TRACE OFF
END-->
