#-------------------------------------------------------------------------------------------------------
# Source Name           :   dcchrgmn003.scr
# Date                  :   23-01-2013
# Author                :   Manoj
# Title                 :   DCCharges
# Description           :	It is event based script for event type - DCAMD,DCTRN,DCAMD event id - DCCHG,DCCHGLO and bacid LCCOMM.
#							Based on the dc ecxpiry date, new expiry date and input amount, it hardcodes the charge amount as 2000.
# Called Scripts		: 	NA
# Calling Script		:	getcparamvalue.scr
# Modification History  :
# <Serial No.>      <Date>          <Author Name>       <Description>
# 1.0            23-01-2013     	Manoj        Original version
# 2.0			 20-20-2013			Manoj		 Repository removed and exit script added
#-------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="f0953b16d0fae220fb17d346bb53fc9ab2245553add40ade7d4ee694add4fd91"
	#TRACE ON
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	#--------------------------------------------------------------------------
	# Initialise the CHRG repository
	#--------------------------------------------------------------------------
	sv_r = REPEXISTS("CHRG")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CHRG")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CHRG","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CHRG","DATA",5)
	#}
	ENDIF
	
	CHRG.DATA.dcOpnDate		= ""
	CHRG.DATA.dcExpDate		= ""
	CHRG.DATA.newExpiryDate	= ""
	CHRG.DATA.inputCrncy 	= ""
	CHRG.DATA.rateCode 		= ""
	CHRG.DATA.amdRate 		= ""
	CHRG.DATA.calAmt		= CDOUBLE("0")
	CHRG.DATA.inputAmt 		= CDOUBLE("0")
	CHRG.DATA.calcAmt 		= CDOUBLE("0")
	
	BANCS.INPUT.moduleName="TRADE_FINANCE"
	BANCS.INPUT.parameterId="FB_CHRG"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CHRG.DATA.calAmt = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CHRG.DATA.errMsg = "Amount setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.INPUT.newExpiryDate) == 0)THEN
	#{
		GOTO FINISH
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Charge Calculation
	#--------------------------------------------------------------------------
	print(BANCS.INPUT.dcOpnDate)
	print(BANCS.INPUT.dcExpDate)
	print(BANCS.INPUT.newExpiryDate)
	
	CHRG.DATA.dcOpnDate 	= LEFT$(BANCS.INPUT.dcOpnDate,10)
	CHRG.DATA.dcExpDate 	= LEFT$(BANCS.INPUT.dcExpDate,10)
	CHRG.DATA.newExpiryDate = LEFT$(BANCS.INPUT.newExpiryDate,10)
	CHRG.DATA.inputAmt 		= BANCS.INPUT.inputAmount
	CHRG.DATA.inputCrncy 	= TRIM(BANCS.INPUT.inputCrncy)
	CHRG.DATA.rateCode 		= BANCS.INPUT.rateCode
	#CHRG.DATA.amdRate 		= BANCS.INPUT.amendrate
	CHRG.DATA.amdRate		= BANCS.INPUT.rateValue
	
	
	
	print(CHRG.DATA.dcOpnDate)
	print(CHRG.DATA.dcExpDate)
	print(CHRG.DATA.newExpiryDate)
	print(CHRG.DATA.inputAmt)
	print(CHRG.DATA.inputCrncy)
	print(CHRG.DATA.rateCode)
	print(CHRG.DATA.amdRate)
	
	#--------------------------------------------------------------------------
	#---No change in exp date and amt
	#--------------------------------------------------------------------------
	IF ((CHRG.DATA.dcExpDate == CHRG.DATA.newExpiryDate) AND (cdouble(CHRG.DATA.inputAmt) <= cdouble("0"))) THEN
	#{
		print("No change in the amt & exp date")
		CHRG.DATA.calcAmt = CHRG.DATA.calAmt
		GOTO FINISH
	#}
	ENDIF
	
	FINISH:
		BANCS.OUTPUT.collAmount = CHRG.DATA.calcAmt
		BANCS.OUTPUT.collCrncy 	= BANCS.STDIN.homeCrncyCode
		
		#TRACE OFF
		EXITSCRIPT
END-->
