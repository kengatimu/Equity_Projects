<--START
TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
        	CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
        	CREATECLASS ("CUST","DATA",5)
	#}
	ENDIF

	CUST.DATA.errflg = "N"
	CUST.DATA.errMsg = " "
        CUST.DATA.crlinepcnt = "0"
	CUST.DATA.maxPcnt = "0"
	CUST.DATA.minPcnt = "0"

        IF(FIELDEXISTS(BANCS.INPUT.crlinepcnt))THEN
        #{
                IF(BANCS.INPUT.crlinepcnt !="")THEN
                #{
                        CUST.DATA.crlinepcnt = TOUPPER(TRIM(BANCS.INPUT.crlinepcnt))
                        PRINT(CUST.DATA.crlinepcnt)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF


        CUST.DATA.parameterId = "CRLINE_DISB_MIN_PCNT"
        CUST.DATA.moduleName = "OT"

        PRINT(BANCS.STDIN.contextBankId)
        PRINT(CUST.DATA.moduleName)
        PRINT(CUST.DATA.parameterId)

        sv_a = ""

        sv_a = sv_a + "paramVal|select parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER "
        sv_a = sv_a + " WHERE C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
        sv_a = sv_a + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
        sv_a = sv_a + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
        sv_a = sv_a + " C_CPVALUE.del_flg != 'Y' AND "
        sv_a = sv_a + " C_CPVALUE.entity_cre_flg = 'Y' AND "
        sv_a = sv_a + " C_CPMASTER.bank_id = ?SVAR AND "
        sv_a = sv_a + " C_CPMASTER.module_name = ?SVAR AND "
        sv_a = sv_a + " C_CPVALUE.parameter_id = ?SVAR "

        PRINT(sv_a)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.moduleName + "|" + CUST.DATA.parameterId

        sv_d = urhk_dbSelectWithBind(sv_a)
        PRINT(sv_a)
        PRINT(sv_d)

        IF(sv_d == 0) THEN
        #{
                PRINT(BANCS.OUTPARAM.paramVal)
                CUST.DATA.minPcnt = BANCS.OUTPARAM.paramVal
        #}
        ELSE
        #{
                CUST.DATA.errflg = "Y"
                CUST.DATA.errMsg = "CPARAM set up not available for CRLINE_DISB_MIN_PCNT"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        CUST.DATA.parameterId = "CRLINE_DISB_MAX_PCNT"
        CUST.DATA.moduleName = "OT"

        PRINT(BANCS.STDIN.contextBankId)
        PRINT(CUST.DATA.moduleName)
        PRINT(CUST.DATA.parameterId)

        sv_a = ""

        sv_a = sv_a + "paramVal|select parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER "
        sv_a = sv_a + " WHERE C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
        sv_a = sv_a + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
        sv_a = sv_a + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
        sv_a = sv_a + " C_CPVALUE.del_flg != 'Y' AND "
        sv_a = sv_a + " C_CPVALUE.entity_cre_flg = 'Y' AND "
        sv_a = sv_a + " C_CPMASTER.bank_id = ?SVAR AND "
        sv_a = sv_a + " C_CPMASTER.module_name = ?SVAR AND "
        sv_a = sv_a + " C_CPVALUE.parameter_id = ?SVAR "

        PRINT(sv_a)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.moduleName + "|" + CUST.DATA.parameterId

        sv_d = urhk_dbSelectWithBind(sv_a)
        PRINT(sv_a)
        PRINT(sv_d)

        IF(sv_d == 0) THEN
        #{
                PRINT(BANCS.OUTPARAM.paramVal)
                CUST.DATA.maxPcnt = BANCS.OUTPARAM.paramVal
        #}
        ELSE
        #{
                CUST.DATA.errflg = "Y"
                CUST.DATA.errMsg = "CPARAM set up not available for CRLINE_DISB_MAX_PCNT"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	IF((CDOUBLE(CUST.DATA.crlinepcnt) < CDOUBLE(CUST.DATA.minPcnt)) OR (CDOUBLE(CUST.DATA.crlinepcnt) > CDOUBLE(CUST.DATA.maxPcnt)))THEN
	#{
                CUST.DATA.errflg = "Y"
                CUST.DATA.errMsg = "Credit Line Disbursement percentage should be between "+CUST.DATA.minPcnt+" AND "+CUST.DATA.maxPcnt
                GOTO ENDOFSCRIPT
        #}
        ENDIF


ENDOFSCRIPT:
        sv_u = urhk_SetOrbOut("errflg|"+CUST.DATA.errflg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
TRACE OFF
END-->
