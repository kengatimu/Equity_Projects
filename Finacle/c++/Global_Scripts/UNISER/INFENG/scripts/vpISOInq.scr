<--start
trace on
        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF
        IF (CLASSEXISTS("CUST","AINQ") == 0) THEN
        #{
                CREATECLASS("CUST","AINQ",5)
        #}
        ENDIF
        if(fieldexists(BANCS.INPUT.strrr1)==1)then
                CUST.AINQ.ChnlType = BANCS.INPUT.strrr1
        else
                CUST.AINQ.ChnlType = ""
        endif
        if(fieldexists(BANCS.INPUT.strrr3)==1)then
                CUST.AINQ.ChnlDate = BANCS.INPUT.strrr3
        else
                CUST.AINQ.ChnlDate = ""
        endif
        if(fieldexists(BANCS.INPUT.strrr4)==1)then
                print(BANCS.INPUT.strrr4)
                CUST.AINQ.ChnlrrnTrnId = trim(BANCS.INPUT.strrr4)
                print(CUST.AINQ.ChnlrrnTrnId)
        else
                CUST.AINQ.ChnlrrnTrnId = ""
        endif
        if(fieldexists(BANCS.INPUT.Foracid)==1)then
                print(BANCS.INPUT.Foracid)
                CUST.AINQ.Foracid = BANCS.INPUT.Foracid
        else
                CUST.AINQ.Foracid = ""
        endif
                sv_q = urhk_B2k_ForacidToAcid(CUST.AINQ.Foracid)
                if(sv_q==0)then
                        CUST.AINQ.ChnlAcid = BANCS.OUTPARAM.Acid
                else
                        CUST.AINQ.ChnlAcid = ""
                endif

        if(CUST.AINQ.ChnlrrnTrnId=="")then
        #{
                print("RECORD NOT FOUND ")
                BANCS.OUTPUT.RespCode = "00"
                BANCS.OUTPUT.successOrFailure = "S"
                CUST.AINQ.pstd_flg = "F"
                CUST.AINQ.rcre_time = "NA"
                CUST.AINQ.pstd_date = "NA"
                CUST.AINQ.tranid = "NA"
                BANCS.OUTPUT.ReservedField1 = "Transaction Not Found"
                BANCS.OUTPUT.ReservedField3 = CUST.AINQ.pstd_flg + "|" + CUST.AINQ.rcre_time + "|" + CUST.AINQ.pstd_date + "|" + CUST.AINQ.tranid
                exitscript
        #}
        endif
                print(CUST.AINQ.ChnlrrnTrnId)
                lv_l = strlen(CUST.AINQ.ChnlrrnTrnId)
                print(lv_l)
                if(lv_l>9)then
                        lv_p = "corrRRN | select ltrim(?SVAR,0) from dual  "
                        BANCS.INPARAM.BINDVARS = CUST.AINQ.ChnlrrnTrnId
                        lv_p = urhk_dbSelectWithBind(lv_p)
                        if(lv_p==0)then
                                CUST.AINQ.corrRRN = BANCS.OUTPARAM.corrRRN
                        else
                                CUST.AINQ.corrRRN = CUST.AINQ.ChnlrrnTrnId
                        endif
                        print(CUST.AINQ.corrRRN)
                endif
                lv_d = "pstd_flg,rcre_time,pstd_date,tranid,tran_amt,pstdtime,rcretimee | select pstd_flg,rcre_time,pstd_date,tran_id,tran_amt,to_char(pstd_date,'DD-MM-YYYY HH:MM:SS'),TO_CHAR(CAST(rcre_time AS TIMESTAMP), 'DD-MM-YYYY HH24:MI:SS') from tbaadm.dtd where bank_id=?SVAR and acid=?SVAR "
                if(lv_l<=9)then
                        lv_d = lv_d + " and tran_id=lpad(?SVAR,9,' ') "
                endif
                lv_d = lv_d + " and tran_date=to_date(?SVAR,'DD-MM-RRRR') and pstd_flg='Y' and del_flg='N' "
                if(lv_l>9)then
                #{
                        ###lv_d = lv_d + " and (tran_particular like '%" + CUST.AINQ.ChnlrrnTrnId + "%' or tran_particular_2 like '%" + CUST.AINQ.ChnlrrnTrnId + "%' ) "
                        lv_d = lv_d + " and (tran_particular like '%" + CUST.AINQ.corrRRN + "%' or tran_particular_2 like '%" + CUST.AINQ.corrRRN + "%' or ref_num like '%" + CUST.AINQ.corrRRN + "%' ) "
                #}
                endif
                        ########lv_d = lv_d + " and pstd_date >=sysdate -(1 /(24*60))  and rownum<=1 "
                        lv_d = lv_d + " and rownum<=1 "
                if(lv_l<=9)then
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.AINQ.ChnlAcid + "|" + CUST.AINQ.ChnlrrnTrnId + "|" + left$(BANCS.STDIN.BODDate,10)
                else
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.AINQ.ChnlAcid + "|" + left$(BANCS.STDIN.BODDate,10)
                endif
                print(BANCS.INPARAM.BINDVARS)
                print(lv_d)
                sv_d = urhk_dbSelectWithBind(lv_d)
                print(sv_d)
                if(sv_d == "0")then
                #{
                        CUST.AINQ.pstd_flg = BANCS.OUTPARAM.pstd_flg
                        CUST.AINQ.rcre_time = BANCS.OUTPARAM.rcre_time
                        CUST.AINQ.pstd_date = BANCS.OUTPARAM.pstd_date
                        CUST.AINQ.tranid = BANCS.OUTPARAM.tranid
                        CUST.AINQ.TranAmt = BANCS.OUTPARAM.tran_amt
                        CUST.AINQ.pstdtime = BANCS.OUTPARAM.pstdtime
                        CUST.AINQ.rcretimee = BANCS.OUTPARAM.rcretimee

                        print(CUST.AINQ.pstdtime)
                        print(CUST.AINQ.rcretimee)

                        print(CUST.AINQ.pstd_flg)
                        print(CUST.AINQ.rcre_time)
                        print(CUST.AINQ.pstd_date)
                        lv_d = "currTime,frmTime,diffMinute | SELECT SYSDATE AS current_time,TO_DATE(?SVAR, 'DD-MM-YYYY HH24:MI:SS')AS from_time,ROUND((SYSDATE - TO_DATE(?SVAR, 'DD-MM-YYYY HH24:MI:SS')) * 1440, 4)AS diff_in_minutes from dual "
                        ####lv_d = "currTime,frmTime,diffMinute | SELECT SYSDATE AS current_time,TO_DATE(?SVAR, 'DD-MM-YYYY HH24:MI:SS')AS from_time,ROUND((to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') - TO_DATE(?SVAR, 'DD-MM-YYYY HH24:MI:SS')) * 1440, 4)AS diff_in_minutes from dual "
                        ###BANCS.INPARAM.BINDVARS = CUST.AINQ.rcretimee + "|" + BANCS.STDIN.sysDate + "|" + CUST.AINQ.rcretimee
                        BANCS.INPARAM.BINDVARS = CUST.AINQ.rcretimee + "|" + CUST.AINQ.rcretimee
                        print(lv_d)
                        print(BANCS.INPARAM.BINDVARS)
                        lv_s = urhk_dbSelectWithBind(lv_d)
                        if(lv_s==0)then
                                CUST.AINQ.currTime = BANCS.OUTPARAM.currTime
                                CUST.AINQ.frmTime = BANCS.OUTPARAM.frmTime
                                CUST.AINQ.diffMinute = BANCS.OUTPARAM.diffMinute
                                print(BANCS.STDIN.sysDate)
                                print(CUST.AINQ.currTime)
                                print(CUST.AINQ.frmTime)
                                print(CUST.AINQ.diffMinute)
                        else
                                CUST.AINQ.diffMinute = "0"
                        endif
                        if(cdouble(CUST.AINQ.diffMinute)<=1)then
                        ##if(cdouble(CUST.AINQ.diffMinute)<=10)then
                                BANCS.OUTPUT.ReservedField3 = CUST.AINQ.pstd_flg + "|" + CUST.AINQ.rcre_time + "|" + CUST.AINQ.pstd_date +"|" + CUST.AINQ.tranid
                                BANCS.OUTPUT.ReservedField2 = CUST.AINQ.pstd_flg + "|" + CUST.AINQ.rcre_time + "|" + CUST.AINQ.pstd_date + "|" + CUST.AINQ.tranid
                                print(BANCS.OUTPUT.ReservedField3)
                                BANCS.OUTPUT.RespCode = "00"
                                BANCS.OUTPUT.successOrFailure = "S"
                        else
                                print("RECORD NOT FOUND ")
                                BANCS.OUTPUT.RespCode = "00"
                                BANCS.OUTPUT.successOrFailure = "S"
                                CUST.AINQ.pstd_flg = "F"
                                CUST.AINQ.rcre_time = "NA"
                                CUST.AINQ.pstd_date = "NA"
                                CUST.AINQ.tranid = "NA"
                                BANCS.OUTPUT.ReservedField1 = "Transaction Not Found"
                                BANCS.OUTPUT.ReservedField3 = CUST.AINQ.pstd_flg + "|" + CUST.AINQ.rcre_time + "|" + CUST.AINQ.pstd_date + "|" + CUST.AINQ.tranid
                                BANCS.OUTPUT.ReservedField2 = CUST.AINQ.pstd_flg + "|" + CUST.AINQ.rcre_time + "|" + CUST.AINQ.pstd_date + "|" + CUST.AINQ.tranid
                        endif
                #}
                else
                #{
                        print("RECORD NOT FOUND ")
                        BANCS.OUTPUT.RespCode = "00"
                        BANCS.OUTPUT.successOrFailure = "S"
                        CUST.AINQ.pstd_flg = "F"
                        CUST.AINQ.rcre_time = "NA"
                        CUST.AINQ.pstd_date = "NA"
                        CUST.AINQ.tranid = "NA"
                        BANCS.OUTPUT.ReservedField1 = "Transaction Not Found"
                        BANCS.OUTPUT.ReservedField3 = CUST.AINQ.pstd_flg + "|" + CUST.AINQ.rcre_time + "|" + CUST.AINQ.pstd_date + "|" + CUST.AINQ.tranid
                        BANCS.OUTPUT.ReservedField2 = CUST.AINQ.pstd_flg + "|" + CUST.AINQ.rcre_time + "|" + CUST.AINQ.pstd_date + "|" + CUST.AINQ.tranid
                #}
                endif
#TRACE OFF
end-->
