endif
CUST.DATA.acid=BANCS.OUTPARAM.Acid


    sv_k = "acid,foracid,modeofoper,custid,cifid,email,phone,acct_poa_rec,custname,acct_poa_name, DATE_CREATED, rmks, deleted|select a.acid, foracid ,mode_of_oper_code, "
	sv_k = sv_k + "a.cust_id, c.cif_id, email, phone, acct_poa_as_rec_type, cust_name , acct_poa_as_name, to_date(a.RCRE_TIME,'DD-MM-YYYY') , free_text, a.del_flg "
	sv_k = sv_k + " from tbaadm.gam g, tbaadm.aas a, tbaadm.cmg c"
	sv_k = sv_k + " where g.acid=a.acid and a.cust_id=c.cust_id "
    sv_k = sv_k + " and a.acid = ?SVAR  AND a.del_flg='N' and acct_poa_as_rec_type<>'O' "
    sv_k = sv_k + " and g.bank_id = ?SVAR "
        PRINT(sv_k)

        BANCS.INPARAM.BINDVARS = CUST.DATA.acid + "|" + BANCS.STDIN.contextBankId
        PRINT(BANCS.INPARAM.BINDVARS)


sv_r = urhk_dbCursorOpenWithBind(sv_k)
print(sv_r)

IF(sv_r==0) THEN
#{
        sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_m)
