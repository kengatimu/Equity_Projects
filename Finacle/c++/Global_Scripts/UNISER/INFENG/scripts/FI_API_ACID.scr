        IF(sv_q != 0) THEN
        #{
                sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        #}
        ENDIF
		
		sv_s=0
		sv_c =1
WHILE(sv_q == 0)
#{

        sv_j = sv_c 
        CUST.DATA.OPLoop = "RECORD_" + format$(sv_j,"%d") + "."
		
        CUST.DATA.acid = BANCS.OUTPARAM.acid
	    print(CUST.DATA.acid)
        CUST.DATA.foracid = BANCS.OUTPARAM.foracid
        CUST.DATA.modeofoper = BANCS.OUTPARAM.modeofoper
		CUST.DATA.DATECREATED=BANCS.OUTPARAM.DATE_CREATED
	
        IF(CUST.DATA.modeofoper == "")then
        #{
                CUST.DATA.modeofoper = "NULL"
        #}
        ENDIF
        CUST.DATA.custid = BANCS.OUTPARAM.custid
        CUST.DATA.cifid = BANCS.OUTPARAM.cifid
        CUST.DATA.email = BANCS.OUTPARAM.email
        IF(CUST.DATA.email == "")then
        #{
                CUST.DATA.email = "NULL"
        #}
        ENDIF
		CUST.DATA.rmks=BANCS.OUTPARAM.rmks
		 IF(CUST.DATA.rmks == "")then
        #{
                CUST.DATA.rmks = "NULL"
        #}
        ENDIF

        CUST.DATA.phone = BANCS.OUTPARAM.phone
        IF(CUST.DATA.phone == "")then
        #{
                CUST.DATA.phone = "NULL"
        #}
        ENDIF
        CUST.DATA.acct_poa_rec = BANCS.OUTPARAM.acct_poa_rec
        CUST.DATA.custname = BANCS.OUTPARAM.custname
        CUST.DATA.acct_poa_name = BANCS.OUTPARAM.acct_poa_name
		CUST.DATA.deleted=BANCS.OUTPARAM.deleted
         lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"ACID|" +CUST.DATA.acid)
         lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"ACCTNUM|" +CUST.DATA.foracid)
         lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"MODEOFOPERATION|" +CUST.DATA.modeofoper)
         lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"CUSTID|" +CUST.DATA.custid)
         lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"CIFID|" +CUST.DATA.cifid)
		 lv_b = urhk_SetOrbOut(CUST.DATA.OPLoop +"DATECREATED|" +CUST.DATA.DATECREATED)
