<--START
CHECKSUM="790bb79cb967328f7e20e8e5dd41c77cabedca98993709878d59cccd9037c449"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	# CHG0032387
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF

	IF (REPEXISTS("CUSTSS") == 0 ) THEN
	#{
		CREATEREP("CUSTSS")
	#}
	ENDIF
	IF (CLASSEXISTS("CUSTSS","CDAAA") == 0) THEN
	#{
		CREATECLASS("CUSTSS","CDAAA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Bank id"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Bankid=BANCS.INPUT.Bankid
		print(CUST.DATA.Bankid)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Acctnum"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Account Number"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Acctnum=BANCS.INPUT.Acctnum
		print(CUST.DATA.Acctnum)
	#}
	ENDIF
	
	########################
	sv_s="solid,foracid,acid,schmcode,schmtype,acctStatus,sweeps,mngruserid|"	
	sv_s = sv_s + "  select g.sol_id,g.foracid,g.acid,g.schm_code,g.schm_type,s.acct_status,g.allow_sweeps, "
	sv_s = sv_s + "  (SELECT  Roleu.USER_ID FROM tbaadm.get EMPu, tbaadm.upr ROLEu WHERE EMPu.EMP_ID = ROLEu.USER_EMP_ID and roleu.del_flg='N' and empu.del_flg='N' and roleu.ROLE_ID!='DEL'  "
	sv_s = sv_s + "  and  ROLEu.USER_WORK_CLASS ='150'  AND g.sol_id=Roleu.SOL_ID  and g.sol_id=Roleu.sol_id and rownum<2) as mngruser_id  "
	sv_s = sv_s + "   from tbaadm.gam g, tbaadm.smt s where g.acid = s.acid and g.bank_id = s.bank_id    "
	sv_s = sv_s + "  and g.bank_id = ?SVAR and g.foracid = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
		CUSTSS.CDAAA.foracid    = BANCS.OUTPARAM.foracid
		PRINT(CUSTSS.CDAAA.foracid)
		CUSTSS.CDAAA.acid	= BANCS.OUTPARAM.acid
		PRINT(CUSTSS.CDAAA.acid)
		CUSTSS.CDAAA.schmtype	= BANCS.OUTPARAM.schmtype
		PRINT(CUSTSS.CDAAA.schmtype)
		CUSTSS.CDAAA.schmcode	= BANCS.OUTPARAM.schmcode
		PRINT(CUSTSS.CDAAA.schmcode)
		CUSTSS.CDAAA.sweeps	= BANCS.OUTPARAM.sweeps
		PRINT(CUSTSS.CDAAA.sweeps)
		CUSTSS.CDAAA.solid	= BANCS.OUTPARAM.solid
		PRINT(CUSTSS.CDAAA.solid)
		CUSTSS.CDAAA.acctStatus      = BANCS.OUTPARAM.acctStatus
		PRINT(CUSTSS.CDAAA.acctStatus)
		CUSTSS.CDAAA.mngruserid	 =   BANCS.OUTPARAM.mngruserid
		PRINT(CUSTSS.CDAAA.mngruserid)

		IF (CUSTSS.CDAAA.sweeps == "") THEN
		#{
			CUSTSS.CDAAA.sweeps = "N"
		#}
		ENDIF
		
		IF(CUSTSS.CDAAA.solid != BANCS.STDIN.mySolId)THEN
		#{
			sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTSS.CDAAA.solid)
			print(sv_u)
			sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			print(sv_u)
		#}
		ENDIF

		
		#--------------------------------------------------------------------------------------------------------------
		# Inputs for Account Modify services
		# urhk_SetUrhkInp is used to set inputs
		#--------------------------------------------------------------------------------------------------------------
		
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTSS.CDAAA.foracid)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTSS.CDAAA.acid)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTSS.CDAAA.schmtype)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTSS.CDAAA.schmcode)
		PRINT(sv_u)
		if (CUSTSS.CDAAA.schmtype == "SBA") then
		#{

			sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y")
			PRINT(sv_u)
		#}
		else
		#{
			sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForModify|retain_all_output = Y")
			PRINT(sv_u)
		#}
		endif

		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTSS.CDAAA.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctMgrAtAcct.userId|" + CUSTSS.CDAAA.mngruserid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTSS.CDAAA.acid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTSS.CDAAA.schmtype)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTSS.CDAAA.schmcode)
			PRINT(sv_u)
			#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCUSTSInfo.allowSweeps|"+CUSTSS.CDAAA.sweeps)
			#PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|"+CUSTSS.CDAAA.sweeps)
			PRINT(sv_u)
			if (CUSTSS.CDAAA.schmtype == "SBA") then
			#{
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeCode7.refCode|")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("operAcctSchmDtls.acctSchemeEntered|1")
				PRINT(sv_u)
			#}
			else
			#{
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeCode7.refCode|")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("schmDtls.acctSchemeEntered|1")
				PRINT(sv_u)
			#}
			endif

			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
			PRINT(sv_u)
			sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
			PRINT(sv_u)
			#sv_u =urhk_SetUrhkInp("operAcctSchmDtls.acctSchemeEntered|1")
			#PRINT(sv_u)
			if (CUSTSS.CDAAA.schmtype == "SBA") then
			#{
				sv_u = urhk_ExecSrv("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
			#}
			else
			#{
				sv_u = urhk_ExecSrv("SRV_ModifyCAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
			#}
			endif
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------------------------
		# SRV Error check
		#----------------------------------------------------------------------------------------------------
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
				#}
			ELSE
				#{
				sv_v = 0
			#}
			ENDIF
			IF (sv_v > 0) THEN
			#{
				sv_u = system("echo 'Error for Acct:"+CUSTSS.CDAAA.foracid+" ' >>acctivated.log")
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					print(sv_f)
					IF (FIELDEXISTS(("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)) == 1) THEN
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						print(sv_e)
						IF (FIELDEXISTS(("BANCS").("OUTPARAM").("Tag_"+sv_f)) == 1) THEN
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							print(sv_e)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>acctivated.log")
							print(sv_u)
							#####
							IF (FIELDEXISTS(sv_e) == 1) THEN
								if (sv_e!="") Then
									CUSTSS.CDAAA.errorsact = sv_e
									print(CUSTSS.CDAAA.errorsact)
								endif
							ENDIF
						ELSE
							sv_i = sv_i + 1
							print(sv_i)
						ENDIF
					ELSE
						sv_i = sv_i + 1
						print(sv_i)
					ENDIF
					####
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF
	ELSE
		CUST.DATA.errMsg="Kindly Supply Valid Account Number"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
	ENDIF	
	########################

	IF (FIELDEXISTS(CUSTSS.CDAAA.errorsact)) THEN
		print(CUSTSS.CDAAA.errorsact)
		sv_e=urhk_SetOrbOut("Error|"+ CUSTSS.CDAAA.errorsact)
		print(sv_e)
	ELSE
		sv_e=urhk_SetOrbOut("SUCCESS|LIMITS_UNBLOCKED")
		print(sv_e)
	ENDIF
	
	End:
		EXITSCRIPT
		TRACE OFF
END-->
