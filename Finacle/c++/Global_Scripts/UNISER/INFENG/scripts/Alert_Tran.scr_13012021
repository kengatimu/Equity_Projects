					ELSE
						CUST.ALERTS.sysDatesys = BANCS.OUTPARAM.sysDatesys
						PRINT(CUST.ALERTS.sysDatesys)
					ENDIF
				CUST.ALERTS.narraction3 = ". For any queries, contact 0763063000"
				print(CUST.ALERTS.narraction3)
				IF (BANCS.STDIN.contextBankId=="11") THEN
					CUST.ALERTS.narraction3 = ". For any queries, contact 0916986000"
					print(CUST.ALERTS.narraction3)
				ENDIF
				IF (BANCS.STDIN.contextBankId=="55") THEN
					CUST.ALERTS.narraction3 = ". For any queries, contact 0768985500"
					print(CUST.ALERTS.narraction3)
				ENDIF
				# unpaid or presented cheque
				IF (BANCS.INPUT.partTranType=="D") THEN
					IF (FIELDEXISTS(BANCS.INPUT.tranParticular)==1) THEN
						CUST.ALERTS.tranParticularchq = mid$(BANCS.INPUT.tranParticular,0,13)
						print(CUST.ALERTS.tranParticularchq)
						IF (CUST.ALERTS.tranParticularchq=="unpaid chq.no") THEN
							CUST.ALERTS.narraction1= "Bounced Cheque "
							CUST.ALERTS.narraction1 = CUST.ALERTS.narraction1 + " " + BANCS.INPUT.tranParticular + ", your account "
							print(CUST.ALERTS.narraction1)
						ENDIF
						CUST.ALERTS.tranParticularchqpres = mid$(BANCS.INPUT.tranParticular,0,9)
						print(CUST.ALERTS.tranParticularchqpres)
						IF (CUST.ALERTS.tranParticularchqpres=="ChequeNo.") THEN
							CUST.ALERTS.narraction1space=""
							CUST.ALERTS.narraction1= CUST.ALERTS.narraction1space + " " + BANCS.INPUT.tranParticular + ", your account "
							print(CUST.ALERTS.narraction1)
						ENDIF
						CUST.ALERTS.tranParticularchqprej = mid$(BANCS.INPUT.tranParticular,0,7)
						print(CUST.ALERTS.tranParticularchqprej)
						IF (CUST.ALERTS.tranParticularchqprej=="REJECT:") THEN
							CUST.ALERTS.narraction1space=""
							CUST.ALERTS.narraction1= CUST.ALERTS.narraction1space + " " + BANCS.INPUT.tranParticular + ", your account "
							print(CUST.ALERTS.narraction1)
						ENDIF
					ENDIF
				ELSE
					IF (FIELDEXISTS(BANCS.INPUT.tranParticular)==1) THEN
						CUST.ALERTS.tranParticularchqunpad = mid$(BANCS.INPUT.tranParticular,0,13)
						print(CUST.ALERTS.tranParticularchqunpad)
						IF (CUST.ALERTS.tranParticularchqunpad=="Unpaid Cheque") THEN
							CUST.ALERTS.narraction1space=""
							CUST.ALERTS.narraction1= CUST.ALERTS.narraction1space + " " + BANCS.INPUT.tranParticular + ", your account"
							print(CUST.ALERTS.narraction1)
						ENDIF
					ENDIF
				ENDIF
				CUST.ALERTS.massage= CUST.ALERTS.Dear + CUST.ALERTS.name + " "+ CUST.ALERTS.transactiontype + " " + CUST.ALERTS.transactionAmount + CUST.ALERTS.narraction1 + CUST.ALERTS.transacAccount +" "+ CUST.ALERTS.narractionreff + CUST.ALERTS.narraction2 + CUST.ALERTS.sysDatesys + CUST.ALERTS.narraction3
				print(CUST.ALERTS.massage)

#----edwin start RTGS

				IF (FIELDEXISTS(BANCS.INPUT.tranParticular)==1) THEN
				#{
					Print(BANCS.INPUT.tranParticular)
					BANCS.INPUT.tranParticular = mid$(BANCS.INPUT.tranParticular,0,10)
					print(BANCS.INPUT.tranParticular)
					IF ((BANCS.INPUT.tranParticular=="RTGS/RMT") and (BANCS.INPUT.partTranType=="C"))  THEN
					#{
						CUST.ALERTS.narract1 = MID$(BANCS.INPUT.tranParticular,4,10) 
						print(CUST.ALERTS.narract1)
						CUST.ALERTS.narract2 = " has been deposited to your account "
						print(CUST.ALERTS.narract2)
						CUST.ALERTS.massage= CUST.ALERTS.Dear + CUST.ALERTS.name + " "+ BANCS.INPUT.tranParticular + " " + CUST.ALERTS.transactiontype + " "
						CUST.ALERTS.massage= CUST.ALERTS.massage + CUST.ALERTS.transactionAmount + CUST.ALERTS.narract2 + CUST.ALERTS.transacAccount 
						CUST.ALERTS.massage= CUST.ALERTS.massage + CUST.ALERTS.narractionreff + CUST.ALERTS.narraction2 + CUST.ALERTS.sysDatesys + CUST.ALERTS.narraction3
						PRINT(CUST.ALERTS.massage)
					#}
					ENDIF

				
#--------edwin End of RTGS
				IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1) THEN
				#{
					IF (BANCS.STDIN.menuId == "HOCCM") THEN
					#{
						IF (BANCS.INPUT.partTranType=="C") THEN
						#{
							BANCS.INPUT.tranParticular     = MID$(BANCS.INPUT.tranParticular,0,10)
							print(BANCS.INPUT.tranParticular)
							CUST.ALERTS.narract1 = MID$(BANCS.INPUT.tranParticular,4,10) 
							print(CUST.ALERTS.narract1)
							CUST.ALERTS.narract2 = " has been deposited to your account "
							print(CUST.ALERTS.narract2)
							CUST.ALERTS.massage= CUST.ALERTS.Dear + CUST.ALERTS.name + " "+ BANCS.INPUT.tranParticular + " " + CUST.ALERTS.transactiontype + " "
							CUST.ALERTS.massage= CUST.ALERTS.massage + CUST.ALERTS.transactionAmount + CUST.ALERTS.narract2 + CUST.ALERTS.transacAccount 
							CUST.ALERTS.massage = CUST.ALERTS.massage + CUST.ALERTS.narractionreff + CUST.ALERTS.narraction2 + CUST.ALERTS.sysDatesys + CUST.ALERTS.narraction3
							PRINT(CUST.ALERTS.massage)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF

				###################################################################################################
				# Insert into CUSTOM.MOBEE_PUSH_SMS TABLE
				###################################################################################################
				
				IF ((CUST.ALERTS.phoneno!="") AND (CUST.ALERTS.acctownership!="O")) THEN
				#{ 
					CALL("smspushothers.scr")
					IF (CUST.ALERTS.FreeCode8=="ALL") THEN
						IF  (CUST.ALERTS.sendnowemail == "Y") THEN
							print(CUST.ALERTS.sendnowemail)
							if (CUST.ALERTS.massage!="") then
								callscriptifexist("eqmail.scr")
								GOTO ENDOFSCRIPT
							endif
						ENDIF
					ENDIF
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			ENDIF
		#}
		ENDIF
	ENDIF
ENDIF
####noramal end

IF (FIELDEXISTS(BANCS.INPUT.AcctNum) == 1) THEN
	CUST.ALERTS.sendnow = "N"
	IF (FIELDEXISTS(BANCS.INPUT.DeliveryChnlId) == 1) THEN
		IF ((BANCS.INPUT.DeliveryChnlId=="EAZ") AND (BANCS.STDIN.contextBankId=="54")) THEN
			IF (FIELDEXISTS(BANCS.INPUT.tranParticular2) == 1) THEN
				####
				sv_s = BANCS.INPUT.tranParticular2
				print(sv_s)
				sv_u = "statusbill,EslipDetails1|select substr(?SVAR,1,instr(?SVAR,'/') - 1) ,substr(?SVAR,instr(?SVAR,'/') + 1) from dual "
				print(sv_u)
				BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
				sv_w=urhk_dbSelectWithBind(sv_u)
				print(sv_w)
				CUST.ALERTS.statusbill = BANCS.OUTPARAM.statusbill
				print(CUST.ALERTS.statusbill)
				CUST.ALERTS.EslipDetails1 = BANCS.OUTPARAM.EslipDetails1
				print(CUST.ALERTS.EslipDetails1)
					###2
					sv_s = CUST.ALERTS.EslipDetails1
					print(sv_s)
					sv_u = "statusbill2,EslipDetails12|select substr(?SVAR,1,instr(?SVAR,'/') - 1) ,substr(?SVAR,instr(?SVAR,'/') + 1) from dual "
					print(sv_u)
					BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
					sv_w=urhk_dbSelectWithBind(sv_u)
					print(sv_w)
					CUST.ALERTS.statusbill2 = BANCS.OUTPARAM.statusbill2
					print(CUST.ALERTS.statusbill2)
					CUST.ALERTS.EslipDetails12 = BANCS.OUTPARAM.EslipDetails12
					print(CUST.ALERTS.EslipDetails12)
					###2
						###3
						sv_s = CUST.ALERTS.EslipDetails12
						print(sv_s)
						sv_u = "statusbill3,EslipDetails13|select substr(?SVAR,1,instr(?SVAR,'/') - 1) ,substr(?SVAR,instr(?SVAR,'/') + 1) from dual "
						print(sv_u)
						BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
						sv_w=urhk_dbSelectWithBind(sv_u)
						print(sv_w)
						CUST.ALERTS.statusbill3 = BANCS.OUTPARAM.statusbill3
						print(CUST.ALERTS.statusbill3)
						CUST.ALERTS.EslipDetails13 = BANCS.OUTPARAM.EslipDetails13
						print(CUST.ALERTS.EslipDetails13)
						###3
				####
				IF ((CUST.ALERTS.statusbill=="P2PIntra") OR (CUST.ALERTS.statusbill3 =="UNBLOCK")) THEN
					CUST.ALERTS.account = BANCS.INPUT.AcctNum
					print(CUST.ALERTS.account)
					#IF (BANCS.INPUT.tranRemarks=="254763626695") THEN
						sv_s = "PHONENO,trandate,ACCT_NAME,transacAccount,acctownership| select FORACID,(select TO_CHAR(db_stat_date, 'DD-Mon-RRRR') from tbaadm.gct where bank_id= ?SVAR) as TRAN_DATE,(SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)) as ACCT_NAME,gam.foracid as transacAccount,ACCT_OWNERSHIP from tbaadm.gam  "
						sv_s = sv_s + " where  "
						sv_s = sv_s + " gam.foracid= ?SVAR and gam.bank_id= ?SVAR  "
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.ALERTS.account + "|" + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_u =  urhk_dbSelectWithBind(sv_s)
						IF(sv_u == 0) THEN
							CUST.ALERTS.phoneno = BANCS.OUTPARAM.PHONENO
							PRINT(CUST.ALERTS.phoneno)
							IF (CUST.ALERTS.statusbill=="P2PIntra") THEN
								CUST.ALERTS.phoneno = BANCS.INPUT.tranRemarks
								PRINT(CUST.ALERTS.phoneno)
							ENDIF
							IF (CUST.ALERTS.statusbill3 =="UNBLOCK") THEN
								IF (BANCS.INPUT.partTranType=="D") THEN
									CUST.ALERTS.phoneno = CUST.ALERTS.statusbill
									PRINT(CUST.ALERTS.phoneno)
								ELSE
									CUST.ALERTS.phoneno = CUST.ALERTS.statusbill2
									PRINT(CUST.ALERTS.phoneno)
								ENDIF
							ENDIF
							PRINT(BANCS.OUTPARAM.ACCT_NAME)
							PRINT(BANCS.OUTPARAM.trandate)
							CUST.ALERTS.trandate = BANCS.OUTPARAM.trandate
							PRINT(CUST.ALERTS.trandate)
							PRINT(BANCS.OUTPARAM.transacAccount)
							#### Dear CHARLES a debit of 44995.35 has been drawn from your account 0020XXXXX0236 On: 24-Aug-18 06:58:06. Customer Care 0763063000/0763026000
							CUST.ALERTS.Dear="Dear "
							print(CUST.ALERTS.Dear)
							CUST.ALERTS.name = BANCS.OUTPARAM.ACCT_NAME
							print(CUST.ALERTS.name)
							CUST.ALERTS.acctownership = BANCS.OUTPARAM.acctownership
							print(CUST.ALERTS.acctownership)
							
							CUST.ALERTS.transactiontype=""
							IF (FIELDEXISTS(BANCS.INPUT.partTranType) == 1) THEN
								IF (BANCS.INPUT.partTranType=="D") THEN
									CUST.ALERTS.transactiontype = BANCS.INPUT.tranCrncyCode
									print(CUST.ALERTS.transactiontype)
								ELSE
									CUST.ALERTS.transactiontype = BANCS.INPUT.tranCrncyCode
									print(CUST.ALERTS.transactiontype)
								ENDIF
							ENDIF
							CUST.ALERTS.transactionAmount = trim(BANCS.INPUT.TranAmt)
							print(CUST.ALERTS.transactionAmount)
							CUST.ALERTS.narraction1=""
							IF (FIELDEXISTS(BANCS.INPUT.partTranType) == 1) THEN
								IF (BANCS.INPUT.partTranType=="D") THEN
									CUST.ALERTS.narraction1 = " has been drawn from your account "
									print(CUST.ALERTS.narraction1)
								ELSE
									CUST.ALERTS.narraction1 = " has been credited to your account "
									print(CUST.ALERTS.narraction1)
								ENDIF
							ENDIF
							CUST.ALERTS.transacAccount = BANCS.OUTPARAM.transacAccount
							PRINT(CUST.ALERTS.transacAccount)
							CUST.ALERTS.xxxx="......"
							print(CUST.ALERTS.xxxx)
							##substr(gam.foracid,1,4)|| 'XXXXX'||substr(gam.foracid,10,4)
							CUST.ALERTS.parta=MID$(CUST.ALERTS.transacAccount,1,4)
							print(CUST.ALERTS.parta)
							CUST.ALERTS.partb=MID$(CUST.ALERTS.transacAccount,10,4)
							print(CUST.ALERTS.partb)
							CUST.ALERTS.transacAccount = CUST.ALERTS.parta + CUST.ALERTS.xxxx + CUST.ALERTS.partb
							PRINT(CUST.ALERTS.transacAccount)
							CUST.ALERTS.narraction2 = " on "
							print(CUST.ALERTS.narraction2)
							CUST.ALERTS.narractionreff = " Ref:"
							print(CUST.ALERTS.narractionreff)
							IF (CUST.ALERTS.statusbill=="P2PIntra") THEN 
								CUST.ALERTS.narractionreff = CUST.ALERTS.narractionreff + CUST.ALERTS.EslipDetails1
								print(CUST.ALERTS.narractionreff)
							ENDIF
							IF (CUST.ALERTS.statusbill3 =="UNBLOCK") THEN
								CUST.ALERTS.narractionreff = CUST.ALERTS.narractionreff + CUST.ALERTS.EslipDetails13
								print(CUST.ALERTS.narractionreff)
							ENDIF
							CUST.ALERTS.sysDate = MID$(BANCS.STDIN.sysDate,0,10)
							print(CUST.ALERTS.sysDate)
								sv_s = "sysDatesys|"
								sv_s = sv_s + " SELECT TO_CHAR(SYSDATE,'DD-MON-RRRR HH24:MI:SS AM') as SYSDATESYS  "
								sv_s = sv_s + " FROM DUAL"
								PRINT(sv_s)
								sv_d = urhk_dbSelectWithBind(sv_s)
								PRINT(sv_d)
								IF(sv_d!=0)THEN
									CUST.ALERTS.scriptSuccess = "N"
									sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
									print(sv_u)
									sv_u = urhk_SetOrbOut("Error_1|Error^Query Failed^prodCode")
									print(sv_u)
									GOTO ENDOFSCRIPT
								ELSE
									CUST.ALERTS.sysDatesys = BANCS.OUTPARAM.sysDatesys
									PRINT(CUST.ALERTS.sysDatesys)
								ENDIF
							CUST.ALERTS.narraction3 = ". For any queries, contact 0763063000"
							print(CUST.ALERTS.narraction3)
							
							CUST.ALERTS.massage= CUST.ALERTS.Dear + CUST.ALERTS.name + " "+ CUST.ALERTS.transactiontype + " " + CUST.ALERTS.transactionAmount + CUST.ALERTS.narraction1 + CUST.ALERTS.transacAccount +" "+ CUST.ALERTS.narractionreff + CUST.ALERTS.narraction2 + CUST.ALERTS.sysDatesys + CUST.ALERTS.narraction3
							print(CUST.ALERTS.massage)
							
							###################################################################################################
							# Insert into CUSTOM.MOBEE_PUSH_SMS TABLE
							###################################################################################################
							
							IF ((CUST.ALERTS.phoneno!="") AND (CUST.ALERTS.acctownership!="O")) THEN
							#{
								IF (CUST.ALERTS.statusbill=="P2PIntra") THEN
									IF (BANCS.INPUT.partTranType=="D") THEN
										if (CINT(BANCS.INPUT.TranAmt) > 150) then 
											CALL("smspushothers.scr")
										endif
									ENDIF
								ENDIF
								IF (CUST.ALERTS.statusbill3 =="UNBLOCK") THEN
									#if (CINT(BANCS.INPUT.TranAmt) > 150) then 
									#	CALL("smspushothers.scr")
									#endif
								ENDIF
							#}
							ENDIF
						ENDIF
					#ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
