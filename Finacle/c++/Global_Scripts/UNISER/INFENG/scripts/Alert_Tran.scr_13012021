							IF (CINT(BANCS.INPUT.TranAmt) > 0) THEN
								IF (BANCS.INPUT.TranSubType != "BI") THEN
									CUST.ALERTS.sendnow = "Y"
									print(CUST.ALERTS.sendnow)
