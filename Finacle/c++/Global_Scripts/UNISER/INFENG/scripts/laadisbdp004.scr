#------------------------------------------------------------------------------------------------    
#   Name			: laadisbdp004.scr
#   Description		: Common script for finding common values
#   Date			: 31-03-2013
#   Author			: Samrat
#   Input			: NA
#   Output			: NA
#   Called Script	: Called from many scripts
#   Calling Script	: laadisbdp008.scr
#   Menu Option		:
#	Srl. No         Date            Author          	Description.
#	-------         ------          ------          	------------
#   1.0             31-03-2013      Samrat				Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="b926e44169157289713a3243028436fe1e6d3a7a17824ecfd0e41ffc7a9383fb"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	
	#-----------------------------------------------------------------------------------------------
	#Initializing Output Variables
	#-----------------------------------------------------------------------------------------------
	CUST.LADISB.errMsg 		= ""
	CUST.LADISB.loanType 	= ""
	
	#################################################################################
	# Getting and details of loan account
	#################################################################################
	sv_s = ""
	sv_s = sv_s + " laCifId,laSchmCode,laAcctOpnDate,"
	sv_s = sv_s + " laClrBalAmt,laBacid,laAcctSolId,"
	sv_s = sv_s + " sancLimit,lastPurgeDate,rcreUserId|"
	sv_s = sv_s + " SELECT GAM.cif_id,GAM.schm_code,to_char(GAM.acct_opn_date,'dd-mm-yyyy'),"
	sv_s = sv_s + " GAM.clr_bal_amt,GAM.bacid,GAM.sol_id,"
	sv_s = sv_s + " GAM.sanct_lim,GAM.last_purge_date,GAM.rcre_user_id"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE GAM.foracid = ?SVAR"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.LADISB.loanAcctId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d != 0) THEN
	#{
		CUST.LADISB.errMsg = "The account does not exists."
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.laCifId			= BANCS.OUTPARAM.laCifId
		CUST.LADISB.laSchmCode 		= BANCS.OUTPARAM.laSchmCode
		CUST.LADISB.laAcctOpnDate 	= BANCS.OUTPARAM.laAcctOpnDate
		CUST.LADISB.laClrBalAmt 	= BANCS.OUTPARAM.laClrBalAmt
		CUST.LADISB.laBacid			= BANCS.OUTPARAM.laBacid
		CUST.LADISB.laAcctSolId		= BANCS.OUTPARAM.laAcctSolId
		CUST.LADISB.loanAmt			= BANCS.OUTPARAM.sancLimit
		CUST.LADISB.rcreUserId		= BANCS.OUTPARAM.rcreUserId
		CUST.LADISB.lastPurgeDate 	= BANCS.OUTPARAM.lastPurgeDate
		CUST.LADISB.amtAvailForDisb = CDOUBLE(CUST.LADISB.loanAmt) + CDOUBLE(CUST.LADISB.laClrBalAmt)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------
	#--Calling common script for cparam set up
	#-----------------------------------------------------------------------------
	CUST.LADISB.stepVal="4"
	CALL("laadisbdp008.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(CUST.CPARAM.loanLimit)
	PRINT(CUST.CPARAM.usrWrkCls1)
	PRINT(CUST.CPARAM.usrWrkCls2)
	PRINT(CUST.CPARAM.rcreUserId)
	
	#---------------------------------------------------------------------
	#---Getting the operative account to credit
	#---------------------------------------------------------------------
	sv_s=""
	sv_s = sv_s + " operAcctId,operAcid|"
	sv_s = sv_s + " SELECT GAM.foracid,GAM.acid"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE GAM.acid = ("
	sv_s = sv_s + 			" SELECT LAM.op_acid"
	sv_s = sv_s + 			" FROM TBAADM.GAM, TBAADM.LAM"
	sv_s = sv_s + 			" WHERE LAM.acid = GAM.acid"
	sv_s = sv_s + 			" AND LAM.bank_id = GAM.bank_id"
	sv_s = sv_s + 			" AND GAM.foracid = ?SVAR"
	sv_s = sv_s + 			" AND LAM.bank_id = ?SVAR)"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.loanAcctId 	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.operAcctFlg="N"
		#}
	ELSE
		#{
		CUST.LADISB.operAcctId	 = BANCS.OUTPARAM.operAcctId
		CUST.LADISB.operAcid	 = BANCS.OUTPARAM.operAcid
		print(CUST.LADISB.operAcctId)
		print(CUST.LADISB.operAcid)
		CUST.LADISB.operAcctFlg="Y"
		
		sv_u = urhk_getAcctDetailsInRepository(CUST.LADISB.operAcctId)
		IF (sv_u != 0 ) THEN
		#{
			CUST.LADISB.errMsg = "Error in finding effitive available  balance of operative account"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.LADISB.operAcctEffBal = BANCS.OUTPARAM.EffAvailableAmt
		print(CUST.LADISB.operAcctEffBal)
	#}
	ENDIF
	
	#################################################################################
	# Inclusion for Stima Loan
	#################################################################################
	IF (CUST.LADISB.laSchmCode == CUST.CPARAM.stSchmCode) THEN
	#{
		CUST.LADISB.loanType = "S"
		PRINT(CUST.LADISB.loanType)
		CUST.LADISB.crAcctId = CUST.CPARAM.stCrAcctId
		print(CUST.LADISB.crAcctId)
		
		CUST.LADISB.contribution=(CDOUBLE(CUST.LADISB.disbAmt) * CDOUBLE(CUST.CPARAM.cntbPercent))/100
		print(CUST.LADISB.contribution)
		
		CUST.LADISB.chrgAmt=CDOUBLE(CUST.LADISB.disbAmt)-CDOUBLE(CUST.LADISB.contribution)
		print(CUST.LADISB.chrgAmt)
		
		CUST.LADISB.laceAmt=(CDOUBLE(CUST.LADISB.chrgAmt)*CDOUBLE(CUST.CPARAM.lacePercent))/100
		print(CUST.LADISB.laceAmt)
		
		CALL("laadisbdp003.scr")
		IF (CUST.LADISB.errMsg != "") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		print(CUST.LADISB.insuAmt)
		
		CUST.LADISB.fees=CDOUBLE(CUST.LADISB.laceAmt) + CDOUBLE(CUST.LADISB.contribution) + CDOUBLE(CUST.LADISB.insuAmt)
		print(CUST.LADISB.fees)
		
	#}
	ENDIF
	
	#################################################################################
	# Inclusion for IPOs
	#################################################################################
	IF ((CUST.LADISB.laBacid == CUST.CPARAM.ipoBacid) OR (CUST.LADISB.laSchmCode == CUST.CPARAM.ipoSchmCode)) THEN
	#{
		CUST.LADISB.loanType = "I"
		print(CUST.LADISB.loanType)
		CUST.LADISB.crAcctId = CUST.LADISB.operAcctId
		print(CUST.LADISB.crAcctId)
		CALL("laadisbdp002.scr")
		IF (CUST.LADISB.errMsg != "") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		print(CUST.LADISB.insuAmt)
		print(CUST.CPARAM.contrb100)
		print(CUST.CPARAM.contrbVal)
		print(CUST.LADISB.disbAmt)
		
		CUST.LADISB.contrb100=(CDOUBLE(CUST.LADISB.disbAmt)*CDOUBLE(CUST.CPARAM.contrb100))/CDOUBLE(CUST.CPARAM.contrbVal)
		print(CUST.LADISB.contrb100)
		CUST.LADISB.contribution=CDOUBLE(CUST.LADISB.contrb100)-CDOUBLE(CUST.LADISB.disbAmt)
		print(CUST.LADISB.contribution)
		
		CUST.LADISB.laceAmt = (CDOUBLE(CUST.LADISB.disbAmt)*CDOUBLE(CUST.CPARAM.lacePercent))/100
		print(CUST.LADISB.laceAmt)
		CUST.LADISB.lienAmt= CUST.CPARAM.lienAmt
		CUST.LADISB.cdsApp = CUST.CPARAM.cdsApp
		print(CUST.LADISB.lienAmt)
		print(CUST.LADISB.cdsApp)
		
		CUST.LADISB.fees = CDOUBLE(CUST.LADISB.laceAmt) + CDOUBLE(CUST.LADISB.lienAmt) + CDOUBLE(CUST.LADISB.cdsApp) + CDOUBLE(CUST.LADISB.insuAmt) + CDOUBLE(CUST.LADISB.contribution)
		print(CUST.LADISB.fees)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
