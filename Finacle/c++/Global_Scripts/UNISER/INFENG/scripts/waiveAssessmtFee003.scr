<--start
trace on
#Reps/Class
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(repexists("LWFE")==0)then
                createrep("LWFE")
        endif
        if(classexists("LWFE","GLBDATA")==0)then
                createclass("LWFE","GLBDATA",5)
        endif
		
		sv_n = "startDate |select DB_STAT_DATE from tbaadm.gct where bank_id = ?SVAR "
		print (sv_n)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		sv_f =  urhk_dbSelectWithBind(sv_n)
		PRINT(sv_f)

		IF (sv_f == 0)THEN
			LWFE.GLBDATA.startDate = BANCS.OUTPARAM.startDate
			print (LWFE.GLBDATA.startDate)
		ENDIF
		IF(BANCS.STDIN.contextBankId =="50") THEN
		#{
			LWFE.GLBDATA.acctMgr = "EXPUSR50"
		#}
		ENDIF
		IF(BANCS.STDIN.contextBankId =="54") THEN
		#{
			LWFE.GLBDATA.acctMgr = "EXPUSR54"
		#}
		ENDIF
		IF(BANCS.STDIN.contextBankId =="55") THEN
		#{
			LWFE.GLBDATA.acctMgr = "EXPUSR55"
		#}
		ENDIF
		IF(BANCS.STDIN.contextBankId =="56") THEN
		#{
			LWFE.GLBDATA.acctMgr = "EXPUSR56"
		#}
		ENDIF
		sv_q="laAcctId,laAcid,laSolId,laCrncyCode|"
		sv_q = sv_q + " select distinct foracid,b.acid,a.sol_id, a.acct_crncy_code from tbaadm.gam a, tbaadm.chat b where a.bank_id = b.bank_id and a.bank_id = ?SVAR "
		#sv_q = sv_q + " and a.acid = b.acid and  acct_opn_date = ?SVAR and acct_cls_flg != 'Y' and schm_code = 'LA527' "
		sv_q = sv_q + " and a.acid = b.acid and  acct_opn_date <= ?SVAR and acct_cls_flg != 'Y' and schm_code = 'LA527' "
		sv_q = sv_q + " and a.sol_id = ?SVAR and b.RCRE_TIME <(select sysdate-0.020833 from dual) "
		#sv_q = sv_q + " and a.sol_id = ?SVAR and b.RCRE_TIME <(select sysdate from dual) "
		sv_q = sv_q + " and USER_CALC_CHRGE_AMT ! = 0 and CHRGE_AMT_COLLECTED = 0 "
		#sv_q = sv_q + " and CHRGE_WAIVED = 0 and b.del_flg != 'Y' and ACCT_MGR_USER_ID = ?SVAR "
		sv_q = sv_q + " and CHRGE_WAIVED = 0 and b.del_flg != 'Y' and a.acid not in (select acid from tbaadm.cot where bank_id =?SVAR) "
		sv_q = sv_q + " and a.acid in (select acid from tbaadm.lam where bank_id =?SVAR and payoff_flg !='Y') "
		print(sv_q)
		#BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + LWFE.GLBDATA.startDate + "|" + BANCS.STDIN.mySolId + "|" + LWFE.GLBDATA.acctMgr
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + LWFE.GLBDATA.startDate + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_e = urhk_dbCursorOpenWithBind(sv_q)

		IF(sv_e==0) THEN
			    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			    sv_q = urhk_dbCursorFetch(sv_m)
			    print(sv_q)

			   IF(sv_q == 1) THEN
				 sv_x = urhk_dbCursorClose(sv_m)
				 print(sv_x)
				 exitscript
			   ENDIF
			  print(sv_q)

		WHILE (sv_q==0)
			LWFE.GLBDATA.laAcctId=BANCS.OUTPARAM.laAcctId
			print(LWFE.GLBDATA.laAcctId)
			LWFE.GLBDATA.laSolId=BANCS.OUTPARAM.laSolId
			print(LWFE.GLBDATA.laSolId)
			LWFE.GLBDATA.laAcid=BANCS.OUTPARAM.laAcid
			print(LWFE.GLBDATA.laAcid)
			LWFE.GLBDATA.laCrncyCode=BANCS.OUTPARAM.laCrncyCode
			print(LWFE.GLBDATA.laCrncyCode)

			lv_d = " chrgCnt | select count(*) from tbaadm.chat where bank_id= ?SVAR and acid= ?SVAR and entity_cre_flg='Y'"
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + LWFE.GLBDATA.laAcid 
			print(BANCS.INPARAM.BINDVARS)
			lv_s = urhk_dbSelectWithBind(lv_d)
			if(lv_s==0)then
			#{
				LWFE.GLBDATA.chrgCnt = BANCS.OUTPARAM.chrgCnt
			else
				LWFE.GLBDATA.chrgCnt = "0"
			#}
			endif
		#srv
			sv_a = urhk_SetUrhkInp("laAcct.foracid|"+LWFE.GLBDATA.laAcctId)
			sv_a = urhk_SetUrhkInp("laAcct.solId|"+LWFE.GLBDATA.laSolId)
			sv_a = urhk_SetUrhkInp("laAcct.crncyCode|"+LWFE.GLBDATA.laCrncyCode)
			sv_a = urhk_SetUrhkInp("waiverOf| ")
			sv_a = urhk_SetUrhkInp("waivedAmt| ")
			LWFE.GLBDATA.counter_1 = "0"
			while(cint(LWFE.GLBDATA.counter_1)<cint(LWFE.GLBDATA.chrgCnt))
			#{
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.key.serial_num|serial_num_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.chrgType|chrgType_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.crncyCode|crncyCode_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.assmntAmt|assmntAmt_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.collAmt|collAmt_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.waiveAmt|waiveAmt_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.whtWaiveAmt|whtWaiveAmt_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.origWaiveAmt|origWaiveAmt_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.actionFlg|actionFlg_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.reversedFlg|reversedFlg_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverOf|waiverOf_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.selFlg|selFlg_" + LWFE.GLBDATA.counter_1 )
				sv_u = urhk_SetUrhkOut("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.chatCookie|chatCookie_" + LWFE.GLBDATA.counter_1 )
				LWFE.GLBDATA.counter_1 = cint(LWFE.GLBDATA.counter_1) + 1
				print(LWFE.GLBDATA.counter_1)
			#}
			do
			sv_u = urhk_ExecSrv("SRV_FetchFeeWaiverForModify|retain_all_output = Y")
			print(sv_u)
			if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
				print(BANCS.OUTPARAM.successOrFailure)
				sv_s = BANCS.OUTPARAM.successOrFailure
			else
				sv_s = "X"
			endif
			if (( sv_u == 0 ) and ( sv_s=="S") ) then
			#{
				print("fetch")
			#}
			else
			#{
				print(EBSRV.GLBDATA.errid)
				EBSRV.GLBDATA.srvAcctId = LWFE.GLBDATA.laAcctId
				callscriptifexist("ebsrvHandler.scr")
				EBSRV.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError
				EBSRV.GLBDATA.srvErrCode = "SRV_FetchDfltODAcctDtls"
				EBSRV.GLBDATA.srvSucFail = "F"
				goto NXTLP
			#}
			endif
			LWFE.GLBDATA.counter_1 = "0"
			while(cint(LWFE.GLBDATA.counter_1)<cint(LWFE.GLBDATA.chrgCnt))
			#{
				("LWFE").("GLBDATA").("serial_num_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("serial_num_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("chrgType_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("chrgType_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("crncyCode_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("crncyCode_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("assmntAmt_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("assmntAmt_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("collAmt_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("collAmt_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("waiveAmt_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("waiveAmt_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("whtWaiveAmt_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("whtWaiveAmt_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("origWaiveAmt_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("origWaiveAmt_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("actionFlg_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("actionFlg_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("reversedFlg_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("reversedFlg_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("waiverOf_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("waiverOf_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("selFlg_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("selFlg_"+LWFE.GLBDATA.counter_1)
				("LWFE").("GLBDATA").("chatCookie_"+LWFE.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("chatCookie_"+LWFE.GLBDATA.counter_1)
				LWFE.GLBDATA.counter_1 = cint(LWFE.GLBDATA.counter_1) + 1
				print(LWFE.GLBDATA.counter_1)
			#}
			do
			sv_a = urhk_SetUrhkInp("laAcct.foracid|"+LWFE.GLBDATA.laAcctId)
			sv_a = urhk_SetUrhkInp("laAcct.solId|"+LWFE.GLBDATA.laSolId)
			sv_a = urhk_SetUrhkInp("laAcct.crncyCode|"+LWFE.GLBDATA.laCrncyCode)
			##sv_a = urhk_SetUrhkInp("waiverOf| ")
			##sv_a = urhk_SetUrhkInp("waivedAmt| ")
			LWFE.GLBDATA.counter_1 = "0"
			while(cint(LWFE.GLBDATA.counter_1)<cint(LWFE.GLBDATA.chrgCnt))
			#{
				print(LWFE.GLBDATA.counter_1)
				print(LWFE.GLBDATA.chrgCnt)
				print(("LWFE").("GLBDATA").("serial_num_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.key.serial_num|" + ("LWFE").("GLBDATA").("serial_num_"+LWFE.GLBDATA.counter_1))  
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.chrgType|" + ("LWFE").("GLBDATA").("chrgType_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.crncyCode|" + ("LWFE").("GLBDATA").("crncyCode_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.assmntAmt|" + ("LWFE").("GLBDATA").("assmntAmt_"+LWFE.GLBDATA.counter_1)) 
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.collAmt|" + ("LWFE").("GLBDATA").("collAmt_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.waiveAmt|" + ("LWFE").("GLBDATA").("assmntAmt_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.whtWaiveAmt|" + ("LWFE").("GLBDATA").("assmntAmt_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.origWaiveAmt|" + ("LWFE").("GLBDATA").("origWaiveAmt_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.actionFlg|" + ("LWFE").("GLBDATA").("actionFlg_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverDtl.reversedFlg|" + ("LWFE").("GLBDATA").("reversedFlg_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.waiverOf|" + ("LWFE").("GLBDATA").("waiverOf_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.selFlg|" + ("LWFE").("GLBDATA").("selFlg_"+LWFE.GLBDATA.counter_1))
				sv_u = urhk_SetUrhkInp("feeWaiverOutputLL.<rec_"+LWFE.GLBDATA.counter_1+">.chatCookie|" + ("LWFE").("GLBDATA").("chatCookie_"+LWFE.GLBDATA.counter_1))
				LWFE.GLBDATA.counter_1 = cint(LWFE.GLBDATA.counter_1) + 1
				print(LWFE.GLBDATA.counter_1)
			#}
			do
		sv_u = urhk_ExecSrvNoCommit("SRV_ModifyFeeWaiverAndVerify|retain_all_output = Y|same_user_verify = Y")
		print(sv_u)
		if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
			print(BANCS.OUTPARAM.successOrFailure)
			sv_s = BANCS.OUTPARAM.successOrFailure
		else
			sv_s = "X"
		endif
		if (( sv_u == 0 ) and ( sv_s=="S") ) then
		#{
			print("fetch")
		#}
		else
		#{
			EBSRV.GLBDATA.srvAcctId = LWFE.GLBDATA.laAcctId
			callscriptifexist("ebsrvHandler.scr")
			EBSRV.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError
			EBSRV.GLBDATA.srvErrCode = "SRV_FetchDfltODAcctDtls"
			EBSRV.GLBDATA.srvSucFail = "F"
		#}
		endif
		sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)	

	DO
	sv_d = urhk_dbCursorClose(sv_m)
		print(sv_d)

		       print("ALL FEES WAIVED AND ACCOUNTS CLOSED")
	ENDIF
	exitscript
trace off
