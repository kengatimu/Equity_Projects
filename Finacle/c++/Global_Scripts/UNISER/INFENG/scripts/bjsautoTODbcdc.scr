
<--START
TRACE ON

#--------------------------------------------------------------------------
#  Creation of EQSRV repository and GLBDATA class
#--------------------------------------------------------------------------

	sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        endif

	sv_r = REPEXISTS("EQSRV")
        IF (sv_r == 0) THEN
                CREATEREP("EQSRV")
        endif

	sv_r = CLASSEXISTS("EQSRV", "GLBDATA")
	IF (sv_r == 0) THEN
		CREATECLASS("EQSRV", "GLBDATA", 5)
	ENDIF
#--------------------------------------------------------------------------
# Selecting accounts from DTD 
#--------------------------------------------------------------------------


sv_s = "tranId,trandate,tran_amt,foracid,acct_crncy_code,schm_code |  select distinct(tran_id), TO_CHAR(tran_date, 'DD-MM-YYYY HH24:MI:SS' ), tran_amt,foracid,acct_crncy_code,schm_code  from tbaadm.dtd,tbaadm.gam where gam.acct_ownership!='O' and dtd.acid=gam.acid  and dtd.bank_id=gam.bank_id and dtd.bank_id='43' and  PSTD_FLG ='N' and dtd.del_flg ='N'  and  dtd.tran_id in (select distinct  tran_id  from  tbaadm.dtd where   bank_id='43'  and pstd_flg ='N' and del_flg ='N' and  dtd.acid in (select acid from  tbaadm.gam where bank_id='43' and bacid='PROXY' and sol_id in (select sol_id from tbaadm.sst where set_id='BCDC')) ) and PSTD_FLG ='N' and dtd.del_flg ='N' and gam.bank_id='43'  "
	print(sv_s)

	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_o)

	print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	EQSRV.GLBDATA.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(EQSRV.GLBDATA.MainCursor)

	print(sv_o)

	while (sv_o == 0)
		sv_c = urhk_dbCursorFetch(EQSRV.GLBDATA.MainCursor)
		print(sv_c)
		IF (sv_c == 0) THEN
		#{ 
				#sv_r = urhk_MTTS_EndDefinition("")
                                #print(sv_r)


            		print(sv_c)
	    		sv_o = 1
			print(sv_o)

		#}
		ELSE 
		#{
			print(sv_c)
	    		sv_o = 1
			print(sv_o)
			EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
			print(EQSRV.GLBDATA.tranId)
			EQSRV.GLBDATA.trandate = BANCS.OUTPARAM.trandate
			print(EQSRV.GLBDATA.trandate)
			EQSRV.GLBDATA.tran_amt = BANCS.OUTPARAM.tran_amt
			print(EQSRV.GLBDATA.tran_amt)
			EQSRV.GLBDATA.foracid = BANCS.OUTPARAM.foracid
			print(EQSRV.GLBDATA.foracid)
			EQSRV.GLBDATA.acct_crncy_code = BANCS.OUTPARAM.acct_crncy_code
			print(EQSRV.GLBDATA.acct_crncy_code)
			EQSRV.GLBDATA.schm_code  = BANCS.OUTPARAM.schm_code
			print(EQSRV.GLBDATA.schm_code)
			#####
			sv_h = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
			print(sv_h)
			IF (sv_h==0) THEN
				EQSRV.GLBDATA.solidsh = BANCS.OUTPARAM.acctSolId
				print(EQSRV.GLBDATA.solidsh)
				EQSRV.GLBDATA.schmcodesh = BANCS.OUTPARAM.schmCode
				print(EQSRV.GLBDATA.schmcodesh)
				EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
				print(EQSRV.GLBDATA.schmType)
				EQSRV.GLBDATA.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
				print(EQSRV.GLBDATA.EffAvailableAmttr)
				EQSRV.GLBDATA.lienAmt = BANCS.OUTPARAM.lienAmt
				print(EQSRV.GLBDATA.lienAmt)

				IF (CINT(EQSRV.GLBDATA.EffAvailableAmttr) < CINT(EQSRV.GLBDATA.tran_amt)) THEN 
					EQSRV.GLBDATA.finalstatus="E"
					print(EQSRV.GLBDATA.finalstatus)
					EQSRV.GLBDATA.EffAvailableAmttrdiff  =  CDOUBLE(EQSRV.GLBDATA.EffAvailableAmttr) - CDOUBLE(EQSRV.GLBDATA.lienAmt)
					print(EQSRV.GLBDATA.EffAvailableAmttrdiff)
				ENDIF
				
############################
 	if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	print(EQSRV.GLBDATA.tranId)
	EQSRV.GLBDATA.tranId =EQSRV.GLBDATA.tranId
	print(EQSRV.GLBDATA.trandate)
	EQSRV.GLBDATA.trandate=EQSRV.GLBDATA.trandate
	print(EQSRV.GLBDATA.acct_crncy_code)
	EQSRV.GLBDATA.acct_crncy_code = EQSRV.GLBDATA.acct_crncy_code
	sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranId|" + EQSRV.GLBDATA.tranId)
	sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + EQSRV.GLBDATA.trandate)
	###sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + BANCS.STDIN.BODDate ) 
	sv_r = urhk_ExecSrv("SRV_FetchTranDtlsForModify|retain_all_output = Y")
	print(sv_r)
	if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
		print(BANCS.OUTPARAM.successOrFailure)
		sv_s = BANCS.OUTPARAM.successOrFailure
	else
		sv_s = "X"
	endif
	if (( sv_r == 0 ) and ( sv_s=="S") ) then
	#{
		sv_u = urhk_GetUrhkNum("tranDtl.partTranDetailLL")
		if(sv_u != 0)then
			goto VAYU
		endif
		sv_j = cint(BANCS.OUTPARAM.srvValue)
		print(sv_j)
		sv_b = 0
		while(sv_b < sv_j)
		#{
			sv_d = urhk_GetUrhkOut("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.pTranIdentifier.partTranSrlNum")
                        EQSRV.GLBDATA.partTranSrlNum = BANCS.OUTPARAM.srvValue
			sv_d = urhk_GetUrhkOut("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.partTranType.code")
                        EQSRV.GLBDATA.partTranType = BANCS.OUTPARAM.srvValue
		if(EQSRV.GLBDATA.partTranType=="D")then
			sv_d = urhk_GetUrhkOut("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.acctId.foracid")
			EQSRV.GLBDATA.foracid = BANCS.OUTPARAM.srvValue
			sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
			print(sv_u)
			if(sv_u==0)then
				EQSRV.GLBDATA.drBalance = BANCS.OUTPARAM.ClearBalance
				EQSRV.GLBDATA.drCif  = BANCS.OUTPARAM.cifId
			else
				EQSRV.GLBDATA.drBalance = ""
				EQSRV.GLBDATA.drCif = ""
			endif
			sv_d = urhk_GetUrhkOut("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.tranAmt")
                        EQSRV.GLBDATA.tranAmt = BANCS.OUTPARAM.srvValue
			sv_d = urhk_GetUrhkOut("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.grantTodFlg")
                        EQSRV.GLBDATA.grantTodFlg = BANCS.OUTPARAM.srvValue
		endif
                        print(sv_b)
                        sv_b = sv_b + 1
                #}
                do
	else
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.tranId 
                callscriptifexist("ebsrvHandler.scr")
                EQSRV.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.srvErrCode = "Fetch Tran"
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        #}
        endif
	sv_a = urhk_CopyOutToIn("")
	print(sv_a)
        sv_b = 0
        while(sv_b < sv_j)
        #{
		IF (EQSRV.GLBDATA.finalstatus=="E") THEN
			##if(cdouble(EQSRV.GLBDATA.drBalance)<cdouble(EQSRV.GLBDATA.tranAmt))then
			sv_s = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.grantTodFlg|Y")
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.todEventType.type|TODIN")
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.discreteAdvnType.code|S")
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.discreteAdvnCatgr.code|C")
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.grantDate|" + BANCS.STDIN.BODDate)
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.expiryDate|" + BANCS.STDIN.BODDate)
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.penalDate|" + BANCS.STDIN.BODDate)
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.acct.foracid|" + EQSRV.GLBDATA.foracid)
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.acct.crncyCode|" + EQSRV.GLBDATA.acct_crncy_code)
			print(EQSRV.GLBDATA.EffAvailableAmttrdiff)
			sv_a= EQSRV.GLBDATA.EffAvailableAmttrdiff 
			sv_a= format$(CDOUBLE(sv_a),"%17.2f")
			sv_a= sv_a + "|" + EQSRV.GLBDATA.acct_crncy_code
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.todAmtToBeGrntd|" + sv_a)
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" +FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.todLevIntFlg|N")
			sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_b, "%d") + ">.instantTodDtl.todBasicDtl.permittedBy.userId|" + BANCS.STDIN.userId)
			##endif
		ENDIF
                sv_b = sv_b + 1
        #}
        do
	sv_a = urhk_ExecSrvNoCommit("SRV_ModifyAndPostXferTran|retain_all_output = Y|same_user_verify = Y")
	print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_a == 0 ) and ( sv_s=="S") ) then
        #{
                EQSRV.GLBDATA.srvErrMsg = "Transaction Posted Successfully : " + EQSRV.GLBDATA.tranId 
                EQSRV.GLBDATA.srvSucFail = "S"
        else
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.tranId 
                callscriptifexist("ebsrvHandler.scr")
                EQSRV.GLBDATA.srvErrMsg =  EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.srvErrCode = "SRV_ModifyAndPostXferTran"
                ###EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        #}
        endif
VAYU:
        print(EQSRV.GLBDATA.srvErrMsg)
        print(EQSRV.GLBDATA.srvErrCode)
       ## print(EQSRV.GLBDATA.srvSucFail)
###########################
			ENDIF
			####

			print(sv_o)
			sv_o = sv_o + 1
			print(sv_o)
		ENDIF
		print(sv_o)
		sv_o = sv_o + 1
		print(sv_o)
	DO

	sv_c = urhk_dbCursorClose(EQSRV.GLBDATA.MainCursor) 
	print(sv_c)

