                PRINT(BANCS.OUTPARAM.tranId)
                PRINT(BANCS.OUTPARAM.tranDate)

                CUST.DATA.errorFlg ="N"
                CUST.DATA.tranId1 = BANCS.OUTPARAM.tranId
		
		IF((TRIM(CUST.DATA.tranId) != "") AND (CUST.DATA.dmgFlg == "Y"))THEN
