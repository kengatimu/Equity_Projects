        ### Transaction ##

        sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
        #sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|CI")
        sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
        sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
        sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")

        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+CUST.DATA.chrgAmt+"|"+ CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+CUST.DATA.chrgAcctId)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+CUST.DATA.tranRmks1)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rateCode.refCode|"+CUST.DATA.rateCode)
        #sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rate|"+CUST.DATA.rate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+CUST.DATA.tranParticular)

        CUST.DATA.tranAmt = CDOUBLE(CUST.DATA.chrgAmt) + CDOUBLE(CUST.DATA.vatAmt)
        #PRINT(CUST.DATA.tranAmt)

        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
        sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.DATA.tranAmt+"|"+ CUST.DATA.crncyCode)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.DATA.acctId)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|"+CUST.DATA.tranRmks1)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rateCode.refCode|"+CUST.DATA.rateCode)
        #sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rate|"+CUST.DATA.rate)
        sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+CUST.DATA.tranParticular)
		
        IF(CUST.DATA.vatAmt == 0)THEN
