		#sv_s = sv_s + "TO_DATE(TRAN_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY') AND TRAN_CRNCY_CODE=?SVAR AND PART_TRAN_TYPE='D' AND BANK_ID=?SVAR AND TRAN_AMT=?SVAR)"
		#sv_s = sv_s + "TO_DATE(TRAN_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY') AND PART_TRAN_TYPE='D' AND BANK_ID=?SVAR AND TRAN_PARTICULAR LIKE 'CHARGES ON TRANID:"+TRIM(CUST.DATA.tranId)+"%')"
#PRINT(sv_s)
                #BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId+"|"+CUST.DATA.chrg_tran_id+"|"+CUST.DATA.tranDate+"|"+CUST.DATA.crncyCode
