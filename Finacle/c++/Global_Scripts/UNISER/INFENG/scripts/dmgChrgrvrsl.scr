		sv_s = sv_s + " BANK_ID=?SVAR AND EVENT_ID='CWCHRG')"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId+"|"+BANCS.STDIN.contextBankId
                sv_q = urhk_dbSelectWithBind(sv_s)
                PRINT(sv_q)
                IF(sv_q == 0)THEN
