                sv_s = "chrgAmt,vatAmt,crncyCode,chrg_tran_id,acctId,chrgAcctId,vatAcctId|SELECT CHRG_AMT,VAT_AMT,COLL_CRNCY_CODE,CHRG_TRAN_ID,ACCT_ID,VAT_ACCT_ID,"
		sv_s= sv_s +"CHRG_ACCT_ID FROM CUSTOM.C_CTDT WHERE BANK_ID=?SVAR AND TRIM(PARENT_TRAN_ID) = TRIM(?SVAR) AND TO_DATE(PARENT_TRAN_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY')"
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.tranId +"|"+ CUST.DATA.tranDate

                sv_q = urhk_dbSelectWithBind(sv_s)
