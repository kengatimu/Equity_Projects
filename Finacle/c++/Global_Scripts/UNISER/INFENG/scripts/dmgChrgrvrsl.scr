		ENDIF

		#sv_s = "chrgAcctId|SELECT FORACID FROM TBAADM.GAM,TBAADM.dctd_acli WHERE GAM.BANK_ID=?SVAR AND GAM.ACID=dctd_acli.ACID AND TRIM(TRAN_ID)=TRIM(?SVAR) AND "
