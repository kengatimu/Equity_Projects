IF (BANCS.STDIN.contextBankId=="54") THEN

	sv_u = urhk_SRV_GetVal("ddMassIssHdr.tranSubType.tranType")
	CUST.DATA.tranType = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.tranType)

	sv_u = urhk_SRV_GetVal("ddMassIssHdr.tranSubType.tranSubType")
	CUST.DATA.tranSubType = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.tranSubType)

	IF (CUST.DATA.tranType=="C") THEN
		sv_s = urhk_SRV_SetErr("Cash not allowed for demand draft")
		print(sv_s)
		GOTO End
	ENDIF
	#+++++++++++++++++++++++++++++++++++++++++++++Katumo M
	sv_u = urhk_SRV_GetVal("ddMassIssHdr.purAcct.foracid")
	CUST.DATA.foracid = BANCS.OUTPARAM.srvValue
	print (CUST.DATA.foracid)

	sv_n = mid$(CUST.DATA.foracid,3,13)
	print (sv_n)
	
	sv_u = urhk_SRV_GetVal("ddMassIssHdr.purAcct.solId")
	CUST.DATA.solId = BANCS.OUTPARAM.srvValue
	print (CUST.DATA.solId)

	sv_u = urhk_SRV_GetVal("ddMassIssMiscDtl.totPurDDAmt")
	CUST.DATA.totPurDDAmt = BANCS.OUTPARAM.srvValue
	print (CUST.DATA.totPurDDAmt)


	if ((sv_n == "1300100814") and (CUST.DATA.tranSubType =="CI")) then
		sv_s = urhk_SRV_SetErr("Customer induced not allowed on imprest acct")
		print(sv_s)
		GOTO End
	endif

	if ((sv_n == "1300100814") and (CUST.DATA.solId != "000")) then 
		call("valacctdailylmt.scr")
		GOTO end
	ENDIF
	#+++++++++++++++++++++++++++++++++++++++++++++ Katumo M
ENDIF

End:

	EXITSCRIPT
