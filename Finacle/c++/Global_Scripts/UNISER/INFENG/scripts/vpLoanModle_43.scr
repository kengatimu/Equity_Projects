<--start
trace on
#Reps/Class
#++++++++++
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("ONS")==0)then
		createrep("ONS")
	endif
	if(classexists("ONS","CUSTOM")==0)then
		createclass("ONS","CUSTOM",5)
	endif
	if(repexists("LAMOD")==0)then
		createrep("LAMOD")
	endif
	if(classexists("LAMOD","GLBDATA")==0)then
		createclass("LAMOD","GLBDATA",5)
	endif
#Inp
#+++
	BANCS.INPUT.solId = BANCS.STDIN.mySolId 
	LAMOD.GLBDATA.srvErrCode = ""
	LAMOD.GLBDATA.srvErrMsg = "" 
	LAMOD.GLBDATA.srvSucFail = ""
	LAMOD.GLBDATA.originationDate = BANCS.STDIN.BODDate
	LAMOD.GLBDATA.schmType = "LAA"
	#FiledMapInp
	#++++++++++
		sv_u = urhk_SetUrhkInp("mandatoryParameters.originationDate|" + LAMOD.GLBDATA.originationDate )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.schmCode.schmCode|" + LAMOD.GLBDATA.schmCode )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.schmCode.schmType|" + LAMOD.GLBDATA.schmType )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.crncyCode.crncyCode|" + LAMOD.GLBDATA.crncyCode )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.loanPerdMths|" + LAMOD.GLBDATA.PerdMths )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.loanPerdDays|" + LAMOD.GLBDATA.PerdDays )
		sv_u = urhk_SetUrhkInp("variables.loanAmount|" + LAMOD.GLBDATA.loanAmount + "|" + LAMOD.GLBDATA.crncyCode )
		sv_u = urhk_SetUrhkInp("variables.noOfInstalmnts|" + LAMOD.GLBDATA.noOfInstalmnts )
		sv_u = urhk_SetUrhkInp("variables.intRate|" + LAMOD.GLBDATA.intRate )

		sv_u = urhk_SetUrhkOut("result.matDate|matDate")
		sv_u = urhk_SetUrhkOut("result.effIntRate|effIntRate")
	LAMOD.GLBDATA.counter_2 = "0"
	While(cint(LAMOD.GLBDATA.counter_2) < cint(LAMOD.GLBDATA.noOfInstalmnts))
		LAMOD.GLBDATA.counter_1	= LAMOD.GLBDATA.counter_2
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.key.serial_num|serial_num_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.hldyPrdDmd|hldyPrdDmd_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.flowDate|flowDate_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.instlAmt|instlAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.combInstlAmt|combInstlAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.princAmt|princAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.intAmt|intAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.cummPrincAmt|cummPrincAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.cummIntAmt|cummIntAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.bankSharePcnt|bankSharePcnt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.custSharePcnt|custSharePcnt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.princOutStanding|princOutStanding_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.qntyOfAssetDlvd|qntyOfAssetDlvd_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.variableChrgDmd|variableChrgDmd_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.fixedChargeAmt|fixedChargeAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.flowDesc|flowDesc_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.cummFixedChargeAmt|cummFixedChargeAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.strOfAmtForSbsdy|strOfAmtForSbsdy_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.totalSbsdyAmt|totalSbsdyAmt_"+LAMOD.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+LAMOD.GLBDATA.counter_1+">.amortStruct.sellPriceAmt|sellPriceAmt_"+LAMOD.GLBDATA.counter_1)
		LAMOD.GLBDATA.counter_2 = cint(LAMOD.GLBDATA.counter_2) + 1
	do
	#fetchSrv
	#++++++++++
		sv_u = urhk_ExecSrv("SRV_Schedule|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
		print(sv_u)
		if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
			print(BANCS.OUTPARAM.successOrFailure)
			sv_s = BANCS.OUTPARAM.successOrFailure
		else
			sv_s = "X"
		endif
		if (( sv_u == 0 ) and ( sv_s=="S") ) then
			LAMOD.GLBDATA.matDate	= BANCS.OUTPARAM.matDate
			LAMOD.GLBDATA.effIntRate = BANCS.OUTPARAM.effIntRate
		else
			print(LAMOD.GLBDATA.schmCode)
			LAMOD.GLBDATA.srvAcctId = LAMOD.GLBDATA.schmCode 
			callscriptifexist("ebsrvHandler.scr")
			LAMOD.GLBDATA.srvErrMsg	=  LAMOD.GLBDATA.SrvError 
			LAMOD.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctDtlForTaChrgOff " 
			LAMOD.GLBDATA.srvSucFail = "F"
			goto VAYU
		endif
	LAMOD.GLBDATA.counter_2 = "0"
	while(cint(LAMOD.GLBDATA.counter_2) < cint(LAMOD.GLBDATA.noOfInstalmnts))
		LAMOD.GLBDATA.counter_1	=	LAMOD.GLBDATA.counter_2
		("LAMOD").("GLBDATA").("serialnum_" + LAMOD.GLBDATA.counter_1)	=  ("BANCS").("OUTPARAM").("serial_num_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("hldyPrdDmd_" + LAMOD.GLBDATA.counter_1)	=  ("BANCS").("OUTPARAM").("hldyPrdDmd_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("flowDate_" + LAMOD.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("flowDate_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("instlAmt_" + LAMOD.GLBDATA.counter_1)  = ("BANCS").("OUTPARAM").("instlAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("combInstlAmt_" + LAMOD.GLBDATA.counter_1)  =  ("BANCS").("OUTPARAM").("combInstlAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("princAmt_" + LAMOD.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("princAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("intAmt_" + LAMOD.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("intAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("cummPrincAmt_" + LAMOD.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("cummPrincAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("cummIntAmt_" + LAMOD.GLBDATA.counter_1)  = ("BANCS").("OUTPARAM").("cummIntAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("bankSharePcnt_" + LAMOD.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("bankSharePcnt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("custSharePcnt_" + LAMOD.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("custSharePcnt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("princOutStanding_" + LAMOD.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("princOutStanding_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("qntyOfAssetDlvd_" + LAMOD.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("qntyOfAssetDlvd_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("variableChrgDmd_" + LAMOD.GLBDATA.counter_1)  = ("BANCS").("OUTPARAM").("variableChrgDmd_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("fixedChargeAmt_" + LAMOD.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("fixedChargeAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("flowDesc_" + LAMOD.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("flowDesc_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("cummFixedChargeAmt_" + LAMOD.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("cummFixedChargeAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("strOfAmtForSbsdy_" + LAMOD.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("strOfAmtForSbsdy_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("totalSbsdyAmt_" + LAMOD.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("totalSbsdyAmt_" + LAMOD.GLBDATA.counter_1)
		("LAMOD").("GLBDATA").("sellPriceAmt_" + LAMOD.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("sellPriceAmt_" + LAMOD.GLBDATA.counter_1)

		LAMOD.GLBDATA.counter_2 = cint(LAMOD.GLBDATA.counter_2) + 1
	do
			
VAYU:
	print(LAMOD.GLBDATA.srvErrMsg)
	print(LAMOD.GLBDATA.srvErrCode)
	print(LAMOD.GLBDATA.srvSucFail)
	exitscript
##trace off
end-->
