<--start
TRACE ON

sv_u = urhk_B2k_PrintRepos("BANCS")
print(sv_u)

CUST.HOCCM.detNoOfChq = ""
CUST.HOCCM.detTotalCrAmt = "0"


	#----------------------------------------------------
	# Getting Instrument details
	#----------------------------------------------------
	CUST.HOCCM.d1InstAmt = TRIM(BANCS.INPUT.totalCrAmt)
	print(CUST.HOCCM.d1InstAmt)
	CUST.HOCCM.d1InstNum = TRIM(BANCS.INPUT.d1InstNum)
	print(CUST.HOCCM.d1InstNum)
	CUST.HOCCM.d1InstDate = TRIM(BANCS.INPUT.zoneDate)
	print(CUST.HOCCM.d1InstDate)
	CUST.HOCCM.d1PayingAcctNum = TRIM(BANCS.INPUT.d1PayingAcctNum)
	print(CUST.HOCCM.d1PayingAcctNum)
	CUST.HOCCM.d1BankCode = TRIM(BANCS.INPUT.d1BankCode)
	print(CUST.HOCCM.d1BankCode)
	CUST.HOCCM.d1TranCode = TRIM(BANCS.INPUT.d1TranCode)
	print(CUST.HOCCM.d1TranCode)
	BANCS.INPUT.d1BatchNum="1"
	CUST.HOCCM.d1BatchNum = TRIM(BANCS.INPUT.d1BatchNum)
	print(CUST.HOCCM.d1BatchNum)
	CUST.HOCCM.d1TranId = TRIM(BANCS.INPUT.d1TranId)
	print(CUST.HOCCM.d1TranId)
	IF (FIELDEXISTS(BANCS.INPUT.d1InstFreetext) == 1) THEN	
		CUST.HOCCM.d1InstFreetext = TRIM(BANCS.INPUT.d1InstFreetext)
		print(CUST.HOCCM.d1InstFreetext)
	ENDIF
	IF (FIELDEXISTS(BANCS.INPUT.freetext1) == 1) THEN	
		CUST.HOCCM.d1InstFreetext = TRIM(BANCS.INPUT.freetext1)
		print(CUST.HOCCM.d1InstFreetext)
	ENDIF
	CUST.HOCCM.d1BrCode = TRIM(BANCS.INPUT.d1BrCode)
	print(CUST.HOCCM.d1BrCode)
	CUST.HOCCM.detNoOfChq = "1"
	CUST.HOCCM.detTotalCrAmt = CUST.HOCCM.d1InstAmt
	print(CUST.HOCCM.detTotalCrAmt)
	#----------------------------------------------------
	# Getting acount details
	#----------------------------------------------------
	CUST.HOCCM.d1CrAcctNum = BANCS.INPUT.critCrAcctNum
	print(CUST.HOCCM.d1CrAcctNum)
	
ENDOFSCRIPT:
EXITSCRIPT
TRACE OFF
end-->
