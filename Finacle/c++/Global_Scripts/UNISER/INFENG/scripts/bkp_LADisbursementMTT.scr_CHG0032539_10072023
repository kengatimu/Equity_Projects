		IF(fieldExists(MTT.InputDetails.DCRecCount)) THEN
		#{
			sv_d=CINT(MTT.InputDetails.DCRecCount)
		#}
		ENDIF
		
		WHILE(sv_d > 0)
		#{
			sv_v = CDOUBLE(("MTT").("InputDetails").("TFINDCChrgAmt_" + FORMAT$(sv_e,"%d")))
			
			IF(sv_v > 0) THEN
			#{
				MTT.PartTranDetails.Account=("MTT").("InputDetails").("TFINDCChrgForAcid_" + FORMAT$(sv_e,"%d"))
				
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.GlDate=MTT.InputDetails.glDate
				
				#if (sv_c == "Y")then
				IF(("MTT").("InputDetails").("TFINDCChrgCrDrInd_" + FORMAT$(sv_e,"%d")) == "C") THEN
				#{
					MTT.PartTranDetails.RefAmount=sv_v
					#}
				ELSE
					#{
					MTT.PartTranDetails.RefAmount=-sv_v
				#}
				ENDIF
				
				MTT.PartTranDetails.RefCurrency=("MTT").("InputDetails").("TFINDCChrgCollCrcny_" + FORMAT$(sv_e,"%d"))
				
				IF(fieldexists(MTT.InputDetails.chrgRateCode)) THEN
				#{
					MTT.PartTranDetails.RateCode = MTT.InputDetails.chrgRateCode
					MTT.PartTranDetails.Rate = MTT.InputDetails.chrgRate
					#}
				ELSE
					#{
					MTT.PartTranDetails.RateCode = ""
				#}
				ENDIF
				
				MTT.PartTranDetails.Particulars="DC Charges"
				
				# call to common script to modify tran particulars if script is present
				MTT.PartTranDetails.ScriptEventType = "DISTR"
				sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				
				IF (sv_m == 0) THEN
				#{
					call("getMTTTranPart.scr")
				#}
				ENDIF
				
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="disbursement"
				MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
				MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
				MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
				print(MTT.PartTranDetails.RefCurrency)
				print(MTT.PartTranDetails.RefAmount)
				
				sv_z = urhk_MTTS_DefineChargePartTran("TFINDCCHRGCR")
				#}end if
			#}
			ENDIF
			
			sv_e=sv_e+1
			sv_d=sv_d-1
		#}
		DO
		#}end while
		
		#Amount
		sv_b = 0
		
		#Counters
		sv_d = 0
		sv_e = 0
		
		sv_y = ""
		IF(fieldExists(MTT.InputDetails.billRecCount)) THEN
		#{
			sv_d=CINT(MTT.InputDetails.billRecCount)
		#}
		ENDIF
		
		WHILE(sv_d > 0)
		#{
			sv_v = CDOUBLE(("MTT").("InputDetails").("TFINChrgAmt_" + FORMAT$(sv_e,"%d")))
			
			IF(MTT.InputDetails.disburseCrncy != ("MTT").("InputDetails").("TFINChrgCollCrcny_" + FORMAT$(sv_e,"%d"))) THEN
			#{
				IF(("MTT").("InputDetails").("TFINChrgCrDrInd_" + FORMAT$(sv_e,"%d")) == "C") THEN
				#{
					sv_b = sv_b + sv_v
					#}
				ELSE
					#{
					sv_b = sv_b - sv_v
				#}
				ENDIF
				
				sv_y = ("MTT").("InputDetails").("TFINChrgCollCrcny_" + FORMAT$(sv_e,"%d"))
			#}
			ENDIF
			
			sv_e=sv_e+1
			sv_d=sv_d-1
		#}
		DO
		#}end while
		IF(sv_y == "") THEN
		#{
			sv_y = MTT.InputDetails.disburseCrncy
		#}
		ENDIF
		
		IF(fieldExists(MTT.InputDetails.DCRecCount)) THEN
		#{
			sv_d=CINT(MTT.InputDetails.DCRecCount)
		#}
		ENDIF
		
		#DC Charge Amount
		sv_f = 0
		
		#Counter
		sv_e = 0
		sv_x = ""
		
		WHILE(sv_d > 0)
		#{
			sv_v = CDOUBLE(("MTT").("InputDetails").("TFINDCChrgAmt_" + FORMAT$(sv_e,"%d")))
			
			IF(MTT.InputDetails.disburseCrncy != ("MTT").("InputDetails").("TFINDCChrgCollCrcny_" + FORMAT$(sv_e,"%d"))) THEN
			#{
				IF(("MTT").("InputDetails").("TFINDCChrgCrDrInd_" + FORMAT$(sv_e,"%d")) == "C") THEN
				#{
					sv_f = sv_f + sv_v
					#}
				ELSE
					#{
					sv_f = sv_f - sv_v
				#}
				ENDIF
				
				sv_x = ("MTT").("InputDetails").("TFINDCChrgCollCrcny_" + FORMAT$(sv_e,"%d"))
			#}
			ENDIF
			
			sv_e=sv_e+1
			sv_d=sv_d-1
		#}
		DO
		#}end while
		
		IF(sv_x == "") THEN
		#{
			sv_x = MTT.InputDetails.disburseCrncy
		#}
		ENDIF
		
		#if Bills and DC crncy's are same then consolidate the trasaction
		IF(sv_x == sv_y) THEN
		#{
			sv_b = sv_b + sv_f
			#}end if
		#}
		ENDIF
		
		sv_d = 0
		
		IF(fieldExists(MTT.InputDetails.billRecCount)) THEN
		#{
			sv_d=CINT(MTT.InputDetails.billRecCount)
		#}
		ENDIF
		
		#Initialize ExtraPtranReqForBill/sv_a to some unused value
		sv_a = ""
		
		IF(fieldExists(MTT.InputDetails.ExtraPtranReqForBill)) THEN
		#{
			sv_a = MTT.InputDetails.ExtraPtranReqForBill
		#}
		ENDIF
		
		#Create extra part tran if crncy's are different
		IF((sv_a == "Y") AND (sv_d > 0) AND (sv_x != sv_y)) THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
			
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
			MTT.PartTranDetails.GlDate=MTT.InputDetails.glDate
			
			IF (sv_c == "Y")THEN
			#{
				MTT.PartTranDetails.RefAmount=sv_b
				#}
			ELSE
				#{
				MTT.PartTranDetails.RefAmount=-sv_b
			#}
			ENDIF
			
			MTT.PartTranDetails.RefCurrency=sv_y
			
			IF(fieldexists(MTT.InputDetails.chrgRateCode)) THEN
			#{
				MTT.PartTranDetails.RateCode = MTT.InputDetails.chrgRateCode
				MTT.PartTranDetails.Rate = MTT.InputDetails.chrgRate
				#}
			ELSE
				#{
				MTT.PartTranDetails.RateCode = ""
			#}
			ENDIF
			
			MTT.PartTranDetails.Particulars="TFIN Entity Charges Debit"
			
			# call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "DISTR"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			
			IF (sv_m == 0) THEN
			#{
				call("getMTTTranPart.scr")
			#}
			ENDIF
			
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="disbursement"
			MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			print(MTT.PartTranDetails.RefCurrency)
			print(MTT.PartTranDetails.RefAmount)
			
			sv_z = urhk_MTTS_DefinePartTran("TFINBILLCHRGLADR")
			#}end if
		#}
		ENDIF
		
		#extra transaction for DC
		sv_d = 0
		sv_a = ""
		
		IF(fieldExists(MTT.InputDetails.DCRecCount)) THEN
		#{
			sv_d=CINT(MTT.InputDetails.DCRecCount)
			sv_a = MTT.InputDetails.ExtraPtranReqForDC
		#}
		ENDIF
		
		#Create extra part tran if crncy's are different
		IF((sv_a == "Y") AND (sv_d > 0)  AND (sv_x != sv_y)) THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
			
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
			MTT.PartTranDetails.GlDate=MTT.InputDetails.glDate
			
			IF (sv_c == "Y")THEN
			#{
				MTT.PartTranDetails.RefAmount=sv_f
				#}
			ELSE
				#{
				MTT.PartTranDetails.RefAmount=-sv_f
			#}
			ENDIF
			
			MTT.PartTranDetails.RefCurrency=sv_x
			MTT.PartTranDetails.RateCode = MTT.InputDetails.chrgRateCode
			MTT.PartTranDetails.Rate = MTT.InputDetails.chrgRate
			
			MTT.PartTranDetails.Particulars="DC Charge account charges Debit"
			
			# call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "DISTR"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			
			IF (sv_m == 0) THEN
			#{
				call("getMTTTranPart.scr")
			#}
			ENDIF
			
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="disbursement"
			MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			print(MTT.PartTranDetails.RefCurrency)
			print(MTT.PartTranDetails.RefAmount)
			
			sv_z = urhk_MTTS_DefinePartTran("TFINDCCHRGLADR")
			#}end if
		#}
		ENDIF
		
		IF(fieldExists(MTT.InputDetails.ExtraPtranReqForBill)) THEN
		#{
			sv_g = MTT.InputDetails.ExtraPtranReqForBill
		#}
		ENDIF
		
		#Create extra part tran if (DC chrg crncy = Bills Chrg crncy) != Loan a/c crncy
		IF((sv_a == "Y") AND (sv_g == "Y") AND (sv_y == sv_x)) THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
			
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
			MTT.PartTranDetails.GlDate=MTT.InputDetails.glDate
			
			IF (sv_c == "Y")THEN
			#{
				MTT.PartTranDetails.RefAmount=sv_b
				#}
			ELSE
				#{
				MTT.PartTranDetails.RefAmount=-sv_b
			#}
			ENDIF
			
			MTT.PartTranDetails.RefCurrency=sv_x
			MTT.PartTranDetails.RateCode = MTT.InputDetails.chrgRateCode
			MTT.PartTranDetails.Rate = MTT.InputDetails.chrgRate
			
			MTT.PartTranDetails.Particulars="TFIN Charges Debit"
			
			# call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "DISTR"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			
			IF (sv_m == 0) THEN
			#{
				call("getMTTTranPart.scr")
			#}
			ENDIF
			
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="disbursement"
			MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			print(MTT.PartTranDetails.RefCurrency)
			print(MTT.PartTranDetails.RefAmount)
			
			sv_z = urhk_MTTS_DefinePartTran("TFINLAACHRGDR")
			#}end if
		#}
		ENDIF
		
	#}
	ENDIF
	
	###########################  MURABAHA TFIN CHANGE-END  ###########################################
	
	# Added for gross debit transaction
	IF (sv_q == "G") THEN
	#{
		#Debit the operating account in disbursement crncy
		#with ref amount as charge Credit amount
		IF( sv_t != 0) THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.disbCreditAcct
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
			MTT.PartTranDetails.GlDate=MTT.InputDetails.glDate
			IF (sv_c == "Y") THEN
			#{
				MTT.PartTranDetails.RefAmount=sv_t
				#}
			ELSE
				#{
				MTT.PartTranDetails.RefAmount=-sv_t
			#}
			ENDIF
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.disburseCrncy
			MTT.PartTranDetails.RateCode = MTT.InputDetails.tranRateCode
			MTT.PartTranDetails.TreaRate = MTT.InputDetails.tranTreaRate
			MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.tranTreaRefNum
			MTT.PartTranDetails.Rate = MTT.InputDetails.tranRate
			#MTT.PartTranDetails.Particulars="Operative A/c Adjustment for Gross Disbursement"
			MTT.PartTranDetails.Particulars="Fee Collection"
			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "DISTR"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
			#{
				call("getMTTTranPart.scr")
			#}
			ENDIF
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="disbursement"
			MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			print(MTT.PartTranDetails.RefCurrency)
			print(MTT.PartTranDetails.RefAmount)
			
			sv_z = urhk_MTTS_DefineLoanPartTran("DISBDEBIT")
			#print(sv_z)
		#}
		ENDIF
	#}
	ENDIF
	
	sv_z = urhk_MTTS_EndDefinition("")
	#print(sv_z)
	TRACE OFF
