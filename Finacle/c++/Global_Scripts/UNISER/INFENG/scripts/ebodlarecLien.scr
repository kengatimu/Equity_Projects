<--start
trace on
	if(repexists("EBLN")==0)then
		createrep("EBLN")
	endif
	if(classexists("EBLN","GLBDATA")==0)then
		createclass("EBLN","GLBDATA",5)
	endif
	
	sv_a = urhk_MTTS_PopulateInputDetails("")
	print(sv_a)
	if(sv_a==0)then
		print(MTT.InputDetails.Argument1)
                EBLN.GLBDATA.trSting = MTT.InputDetails.Argument1
                sv_l = strlen(EBLN.GLBDATA.trSting)
                sv_f = mid$(EBLN.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBLN.GLBDATA.LMode  = mid$(sv_f,0,(sv_p-1))
                print(EBLN.GLBDATA.LMode)
                #--
                EBLN.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBLN.GLBDATA.trSting)
                sv_l = strlen(EBLN.GLBDATA.trSting)
                sv_f = mid$(EBLN.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBLN.GLBDATA.LAcctId  = mid$(sv_f,0,(sv_p-1))
                print(EBLN.GLBDATA.LAcctId)
                #--
                EBLN.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBLN.GLBDATA.trSting)
                sv_l = strlen(EBLN.GLBDATA.trSting)
                sv_f = mid$(EBLN.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBLN.GLBDATA.LB2kId  = mid$(sv_f,0,(sv_p-1))
                print(EBLN.GLBDATA.LB2kId)
                #--
		EBLN.GLBDATA.Lienamt = mid$(sv_f,sv_p,sv_l)
		print(EBLN.GLBDATA.Lienamt)
	else
		EBLN.GLBDATA.LMode = ""
		EBLN.GLBDATA.LAcctId = ""
		EBLN.GLBDATA.LB2kId = ""
		EBLN.GLBDATA.Lienamt = ""
	endif
	if(EBLN.GLBDATA.LMode=="A")then
		BANCS.INPARAM.acctNum = EBLN.GLBDATA.LAcctId 
		BANCS.INPARAM.blockMode = "A"
		BANCS.INPARAM.lienAmt = cdouble(EBLN.GLBDATA.Lienamt)
		BANCS.INPARAM.expiryDate = "31-12-2099"
		BANCS.INPARAM.remarks = "Lien for loans on od"
		BANCS.INPARAM.reasonCode = "ODLA"
		BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
		BANCS.INPARAM.lienValueDate = LEFT$(BANCS.STDIN.BODDate,10)
		sv_u = urhk_updateLien("")
		if(sv_u != 0)then
		#{
			print("Unable to Mark the lien on operative account for loan recovery")
		else
			print("Lien Success")
			print("Lien on operative account for loan recovery")
		#}
		endif
	endif
	if(EBLN.GLBDATA.LMode=="M")then
		BANCS.INPARAM.b2kId = EBLN.GLBDATA.LB2kId 
		BANCS.INPARAM.acctNum = EBLN.GLBDATA.LAcctId 
		BANCS.INPARAM.blockMode = "M"
		BANCS.INPARAM.lienAmt = cdouble(EBLN.GLBDATA.Lienamt)
		BANCS.INPARAM.expiryDate = "31-12-2099"
		BANCS.INPARAM.remarks = "Lien for loans on od"
		BANCS.INPARAM.reasonCode = "ODLA"
		BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
		BANCS.INPARAM.lienValueDate = LEFT$(BANCS.STDIN.BODDate,10)
		sv_u = urhk_updateLien("")
		if(sv_u != 0)then
		#{
			print("Unable to Mark the lien on operative account for loan recovery")
		else
			print("Lien Success")
			print("Lien on operative account for loan recovery")
		#}
		endif
	endif
	exitscript
trace off
end-->
