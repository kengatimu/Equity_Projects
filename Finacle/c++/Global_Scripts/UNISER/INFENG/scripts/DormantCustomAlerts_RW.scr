#----------------------------------------------------------------------------------------------------------
# Filename              :       DormantCustomAlerts_RW.scr
# Author                :       Timothy Karemeri
# Description           :       This script gets details of accounts that will go dormant in 30 days for sending notification to the customers
# Input                 :       None
# Output                :       None
# Called Script         :       None
# Calling Script        :       None
# Ticket Number		:	INC0032290
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-11-2022         Timothy          Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
TRACE ON

	#--------------------------------------------------------------------------
	# Initialise Repository
	#--------------------------------------------------------------------------
	IF (REPEXISTS("CUST")==0)THEN
		CREATEREP("CUST")
	ENDIF
	IF(CLASSEXISTS("CUST","DATA")==0)then
		CREATECLASS("CUST","DATA",5)
	ENDIF

	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)

	########################################
	#Fetch Eligible Accounts for Alerts#####
	########################################
	sv_s = "ACID, FORACID,LAST_TRAN_DATE,SCHM_TYPE, SCHM_CODE, NAME,SYSDATE,CURRENCY, PHONENO |"
	sv_s = sv_s + " SELECT ACID, FORACID,TO_CHAR(LAST_TRAN_DATE,'DD-MM-YYYY'),SCHM_TYPE, SCHM_CODE,ACCT_SHORT_NAME,TO_CHAR(SYSDATE,'DD-MM-YYYY'),ACCT_CRNCY_CODE,PHONE_NUM FROM TBAADM.GAM WHERE "
	sv_s = sv_s + " SCHM_TYPE IN  ('SBA','CAA') AND BANK_ID=?SVAR AND DEL_FLG='N' AND ACCT_CLS_FLG='N' AND ENTITY_CRE_FLG='Y' "
	sv_s = sv_s + " AND (TO_DATE(SYSDATE, 'DD-MM-YYYY')- TO_DATE(GAM.LAST_TRAN_DATE,'DD-MM-YYYY')) = '152' "
	sv_s = sv_s + " AND ACCT_OWNERSHIP ='C' and LAST_TRAN_DATE is not null and sol_id = ?SVAR "
	sv_s = sv_s + " and acid in (select acid from tbaadm.smt where bank_id = ?SVAR and acct_status ='A') "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  + "|"+ BANCS.STDIN.mySolId  + "|"+  BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbcursorOpenWithBind(sv_s)
	print(sv_d)
		
	IF(sv_d == 0) THEN
		#{

		CUST.DATA.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(CUST.DATA.CURSOR_NUMBER)
		sv_c = urhk_dbCursorFetch(CUST.DATA.CURSOR_NUMBER)
		print(sv_c)
		BANCS.INPUT.RECCOUNT=cint("1")
		print(BANCS.INPUT.RECCOUNT)
		
		WHILE(sv_c == "0")
		#{
		CUST.DATA.ACID= BANCS.OUTPARAM.ACID
		PRINT(CUST.DATA.ACID)
		CUST.DATA.FORACID= BANCS.OUTPARAM.FORACID
		PRINT(CUST.DATA.FORACID)
		CUST.DATA.LAST_TRAN_DATE= BANCS.OUTPARAM.LAST_TRAN_DATE
		PRINT(CUST.DATA.LAST_TRAN_DATE)		
		CUST.DATA.SCHM_TYPE= BANCS.OUTPARAM.SCHM_TYPE
		PRINT(CUST.DATA.SCHM_TYPE)
		CUST.DATA.NAME= BANCS.OUTPARAM.NAME
		PRINT(CUST.DATA.NAME)
		CUST.DATA.SYSDATE= BANCS.OUTPARAM.SYSDATE
		PRINT(CUST.DATA.SYSDATE)
		CUST.DATA.MESSAGE_STATUS = "0"
		PRINT(CUST.DATA.MESSAGE_STATUS)

		CUST.DATA.PhoneNumber =BANCS.OUTPARAM.PHONENO
		print(CUST.DATA.PhoneNumber)

		CUST.DATA.CURRENCY = BANCS.OUTPARAM.CURRENCY 
		PRINT(CUST.DATA.CURRENCY)
		CUST.DATA.SCHM_CODE= BANCS.OUTPARAM.SCHM_CODE
		PRINT(CUST.DATA.SCHM_CODE)

		CUST.DATA.MESSAGE1 = "Mukiliya mwiza " 
		PRINT(CUST.DATA.MESSAGE1)
		CUST.DATA.MESSAGE2 = " mumaze igihe kinini mudakoresha konti yanyu(" + CUST.DATA.FORACID + "),"
		PRINT(CUST.DATA.MESSAGE2)
		CUST.DATA.MESSAGE3 = " tarabasaba kugana ishami, umugent wacu mukabitsa cyangwa "
		PRINT(CUST.DATA.MESSAGE3)

		CUST.DATA.MESSAGE4 = " mukabikuza kugirango konti idasinzira "
		PRINT(CUST.DATA.MESSAGE4)
		CUST.DATA.MESSAGE5 = " Murakoze."
		PRINT(CUST.DATA.MESSAGE5)
		CUST.DATA.MESSAGE6 = " EQUITY BANK RWANDA"
		PRINT(CUST.DATA.MESSAGE6)

		CUST.DATA.MESSAGE = CUST.DATA.MESSAGE1 + CUST.DATA.MESSAGE2 + CUST.DATA.MESSAGE3
		PRINT(CUST.DATA.MESSAGE)

		CUST.DATA.MESSAGE30 =  CUST.DATA.MESSAGE4 
		PRINT(CUST.DATA.MESSAGE30)

		CUST.DATA.MESSAGE2 =   CUST.DATA.MESSAGE5 + CUST.DATA.MESSAGE6
		PRINT(CUST.DATA.MESSAGE2)

				sv_i = "INSERT INTO CUSTOM.DORMANT_ALERT_SMS (ACID, FORACID, ACCT_NAME, PHONE_NUM,BANK_ID,RCRE_TIME,MESSAGE,MESSAGE_STATUS,MESSAGE2,MESSAGE3) "
				sv_i = sv_i + " VALUES (?SVAR, ?SVAR, ?SVAR, ?SVAR,?SVAR,SYSDATE,?SVAR,'0',?SVAR,?SVAR)"
				print (sv_i)
		
				BANCS.INPARAM.BINDVARS = CUST.DATA.ACID+"|"+ CUST.DATA.FORACID+"|"+ CUST.DATA.NAME+"|"+ CUST.DATA.PhoneNumber +"|"+BANCS.STDIN.contextBankId +"|"+CUST.DATA.MESSAGE+"|"+CUST.DATA.MESSAGE30+"|"+CUST.DATA.MESSAGE2
				Print(BANCS.INPARAM.BINDVARS)

				sv_i = urhk_dbSqlWithBind(sv_i)
				print (sv_i)
		
		GOTO NEXTREC

			BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
			PRINT(BANCS.INPUT.RECCOUNT)
			
		NEXTREC:
		sv_c = urhk_dbCursorFetch(CUST.DATA.CURSOR_NUMBER)
		print(sv_c)

		DO

ENDIF
	
EXITSCRIPT
END-->

