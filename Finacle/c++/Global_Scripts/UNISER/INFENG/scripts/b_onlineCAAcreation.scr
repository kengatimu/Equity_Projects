<--start
trace on

CALL("Common_Interface_CreateRepos.scr")

sv_s=" others, sol_id, SCHM_CODE, CIF_ID, address,nationalid,firstname,middlename,lastname,solid,gender,dateofbirth,datec,monthc,yearc,DOC_CODE, EXPIRY_DATE|"
sv_s = sv_s + " SELECT others, sol_id ,SCHM_CODE, CIF_ID, ADDRESS,national_id,first_name,CASE WHEN sur_name IS NULL THEN 'XX' ELSE middle_name  END middle_name  , CASE WHEN sur_name IS NULL THEN  middle_name  ELSE   sur_name  END sur_name,sol_id,gender,date_of_birth,substr (to_char((to_date(DATE_OF_BIRTH,'DD-MM-RRRR')),'DD-MM-RRRR'),0,2) as datec, "
sv_s = sv_s + " substr (to_char((to_date(DATE_OF_BIRTH,'DD-MM-RRRR')),'DD-MM-RRRR'),4,2) as monthc,substr (to_char((to_date(DATE_OF_BIRTH,'DD-MM-RRRR')),'DD-MM-RRRR'),7,4)-100 as yearc, "
sv_s = sv_s + " DOC_CODE, EXPIRY_DATE "
sv_s = sv_s + " FROM CUSTOM.BULK_CIF_DRC "
sv_s = sv_s + " WHERE entity_cre_flg ='P' "
#sv_s = sv_s + " AND sol_id= ?SVAR"
sv_s = sv_s + " AND bank_id = ?SVAR and schm_code in (select schm_code from tbaadm.gsp where bank_id ='43' and schm_type ='CAA')"
print(sv_s)
#BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId 
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)

sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c==0) then
#{

	CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
	print(sv_k)

WHILE (sv_k == 0)
#{


CUST.INTERFACE.sol =BANCS.OUTPARAM.sol_id
CUST.INTERFACE.schm =BANCS.OUTPARAM.SCHM_CODE
CUST.INTERFACE.cifid= BANCS.OUTPARAM.CIF_ID
CUST.INTERFACE.interfaceRequestID = "CAAcctAdd"
CUST.INTERFACE.interfaceRequestVersion = "10.2"
CUST.INTERFACE.bankID =BANCS.STDIN.contextBankId
CUST.INTERFACE.channelID = "BRK"
CUST.INTERFACE.address=BANCS.OUTPARAM.address
CUST.INTERFACE.category="Mailing"
CUST.INTERFACE.startdate = MID$(BANCS.STDIN.BODDate,0,10)
CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
CUST.INTERFACE.instDate = ""
IF (BANCS.STDIN.contextBankId=="43") THEN
	CUST.INTERFACE.city = "051"
	CUST.INTERFACE.Country="CD"
	CUST.INTERFACE.StrText10=BANCS.OUTPARAM.others
	CUST.INTERFACE.State="143"
	CUST.INTERFACE.PostalCode="00100"
	CUST.INTERFACE.Nationality="CD"
        CUST.INTERFACE.Doc=BANCS.OUTPARAM.DOC_CODE

IF(CUST.INTERFACE.Doc=="3") THEN
	CUST.INTERFACE.docdesc="PASSPORT"
	CUST.INTERFACE.Expirydate =BANCS.OUTPARAM.EXPIRY_DATE
ENDIF
IF(CUST.INTERFACE.Doc=="5") THEN
	CUST.INTERFACE.docdesc="VOTER REGISTRATION CARD"
ENDIF
IF(CUST.INTERFACE.Doc=="6") THEN
	CUST.INTERFACE.docdesc="DRIVING LICENSE"
	CUST.INTERFACE.Expirydate =BANCS.OUTPARAM.EXPIRY_DATE
ENDIF

ENDIF

CUST.INTERFACE.freetext = "FREE_TEXT_FORMAT"
CUST.INTERFACE.firstname=BANCS.OUTPARAM.firstname
print(CUST.INTERFACE.firstname)
CUST.INTERFACE.shortname=MID$(BANCS.OUTPARAM.firstname,0,9)
print(CUST.INTERFACE.shortname)
CUST.INTERFACE.middlename=BANCS.OUTPARAM.middlename
CUST.INTERFACE.lastname=BANCS.OUTPARAM.lastname
CUST.INTERFACE.natidno=BANCS.OUTPARAM.nationalid
CUST.INTERFACE.solid=BANCS.OUTPARAM.solid
CUST.INTERFACE.gender=BANCS.OUTPARAM.gender
CUST.INTERFACE.dateofbirth=BANCS.OUTPARAM.dateofbirth
print(CUST.INTERFACE.dateofbirth)
CUST.INTERFACE.datec=BANCS.OUTPARAM.datec
print(CUST.INTERFACE.datec)
CUST.INTERFACE.monthc=BANCS.OUTPARAM.monthc
print(CUST.INTERFACE.monthc)
CUST.INTERFACE.yearc=BANCS.OUTPARAM.yearc
print(CUST.INTERFACE.yearc)


IF (CUST.INTERFACE.middlename=="XX") THEN
	CUST.INTERFACE.Custname =CUST.INTERFACE.firstname + " "  + CUST.INTERFACE.lastname
ELSE
	CUST.INTERFACE.Custname =CUST.INTERFACE.firstname + " " + CUST.INTERFACE.middlename + " "  + CUST.INTERFACE.lastname	
ENDIF


CUST.INTERFACE.lastdatepart ="T00:00:00.000"
print(CUST.INTERFACE.lastdatepart)

CUST.INTERFACE.sign ="-"
print(CUST.INTERFACE.sign)

CUST.INTERFACE.dateofbirth =  CUST.INTERFACE.yearc + CUST.INTERFACE.sign + CUST.INTERFACE.monthc + CUST.INTERFACE.sign + CUST.INTERFACE.datec + CUST.INTERFACE.lastdatepart 
print(CUST.INTERFACE.dateofbirth)

##-------------------------------------------------------------------------
## Convert Value dates into Gregorian format
##-------------------------------------------------------------------------
#COMMON.INPUT.dateFmt = "DD-MM-YYYY"
#COMMON.INPUT.date = CUST.INTERFACE.drValueDate
#CALL("Common_Interface_ConvertDateToGregorian.scr")
#CUST.INTERFACE.drValueDate = COMMON.OUTPUT.outDate
#COMMON.INPUT.dateFmt = "DD-MM-YYYY"
#COMMON.INPUT.date = CUST.INTERFACE.crValueDate
#CALL("Common_Interface_ConvertDateToGregorian.scr")
#CUST.INTERFACE.crValueDate = COMMON.OUTPUT.outDate
#COMMON.INPUT.dateFmt = "DD-MM-YYYY"
#COMMON.INPUT.date = CUST.INTERFACE.instDate
#CALL("Common_Interface_ConvertDateToGregorian.scr")
#CUST.INTERFACE.instDate = COMMON.OUTPUT.outDate


#-------------------------------------------------------------------------
# Fetch the current data time to send in request header
#-------------------------------------------------------------------------
sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
	CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
	print(CUST.INTERFACE.msgDateTime)
#}
ENDIF

#-------------------------------------------------------------------------
#- Forming the Header for RetCustAdd
#-------------------------------------------------------------------------

sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0)THEN
#{
	CUST.INTERFACE.RequestID1 = BANCS.OUTPARAM.RequestID
	print(CUST.INTERFACE.RequestID1)
#}
ELSE
#{
	CUST.INTERFACE.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
	print(CUST.INTERFACE.RequestID1)
#}
ENDIF


CUST.INTERFACE.headerXML = ""
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Header>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestHeader>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageKey>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestUUID>"+ CUST.INTERFACE.RequestID1 +"</RequestUUID>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestId>CAAcctAdd</ServiceRequestId>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ChannelId>" + CUST.INTERFACE.channelID + "</ChannelId>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<LanguageId/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</MessageKey>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestMessageInfo>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<BankId>" + CUST.INTERFACE.bankID + "</BankId>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<TimeZone/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityId/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityType/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ArmCorrelationId/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageDateTime>" + CUST.INTERFACE.msgDateTime + "</MessageDateTime>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestMessageInfo>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Security>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Token>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<PasswordToken>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<UserId/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Password/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</PasswordToken>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Token>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<FICertToken/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserLoginSessionId/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUser/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserPwd/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<SSOTransferToken/>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Security>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestHeader>"
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Header>"

#-------------------------------------------------------------------------
#- Forming the Body for RetCustAdd
#-------------------------------------------------------------------------


CUST.INTERFACE.bodyXMLMsg = ""
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Body>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CAAcctAddRequest>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CAAcctAddRq>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustId>" + CUST.INTERFACE.cifid + "</CustId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PersonName>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<LastName>" + CUST.INTERFACE.Custname + "</LastName>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Name>"+ CUST.INTERFACE.Custname +"</Name>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PersonName>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CustId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CAAcctId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctType>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SchmCode>" + CUST.INTERFACE.schm + "</SchmCode>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SchmType>CAA</SchmType>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</AcctType>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctCurr>" + CUST.INTERFACE.StrText10 + "</AcctCurr>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BankInfo>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BankId>" + BANCS.STDIN.contextBankId + "</BankId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BranchId>" + CUST.INTERFACE.sol + "</BranchId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</BankInfo>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CAAcctId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CAAcctGenInfo>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctName>" + CUST.INTERFACE.Custname + "</AcctName>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctShortName>"+CUST.INTERFACE.shortname+"</AcctShortName>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctStmtMode>N</AcctStmtMode>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AcctStmtFreq>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Type>M</Type>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</AcctStmtFreq>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DespatchMode>C</DespatchMode>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CAAcctGenInfo>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CAAcctAddRq>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CAAcctAdd_CustomData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SOLID>" + CUST.INTERFACE.sol + "</SOLID>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<MODE_OF_OPER_CODE>SELF</MODE_OF_OPER_CODE>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ALLOWSWEEPS>N</ALLOWSWEEPS>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CRCOMPRESTIND>M</CRCOMPRESTIND>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<JOINT isMultiRec='Y'>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SRLNUM>1</SRLNUM>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CIF_ID>" + CUST.INTERFACE.cifid + "</CIF_ID>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PASSSHEETFLG>Y</PASSSHEETFLG>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<STANDINGINSTRUCTIONFLG>Y</STANDINGINSTRUCTIONFLG>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DEPOSITNOTICEFLG>Y</DEPOSITNOTICEFLG>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<LOANOVRDUNOTICEFLG>Y</LOANOVRDUNOTICEFLG>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<XCLUDEFORCOMBSTMTFLG>Y</XCLUDEFORCOMBSTMTFLG>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</JOINT>"  
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CAAcctAdd_CustomData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CAAcctAddRequest>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Body>"

#-------------------------------------------------------------------------
#Appending the header XML and body XML.
#-------------------------------------------------------------------------

CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML 
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"

#-------------------------------------------------------------------------------
# Setting input values for urhk_ConnectToFIAndSendMsg userhook
#-------------------------------------------------------------------------------
BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
print(BANCS.INPARAM.SERVICE_NAME)
BANCS.INPARAM.SEND_RECV_FLG             = "R"
sv_a = CUST.INTERFACE.reqXMLMsg
PRINT(sv_a)

#-------------------------------------------------------------------------
#- Executing the userhook to make the Outbound Call
#-------------------------------------------------------------------------
sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
print(sv_l)
IF (sv_l != 0) THEN
#{
	print(BANCS.OUTPARAM.ErrMsg)
	CUST.INTERFACE.errorMsgFlg = "Y"
	CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
	CUST.INTERFACE.errorMsgCode = "FIERR"  
	GOTO ENDOFSCRIPT
#}
ENDIF
IF (BANCS.OUTPARAM.ErrMsg != "") THEN
#{
	CUST.INTERFACE.errorMsgFlg = "Y"
	CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
	CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg 
	CUST.INTERFACE.errorMsgCode = "FIERR" 
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
	print(CUST.INTERFACE.respXMLMsg)
	CUST.INTERFACE.errorMsgFlg = ""
	CUST.INTERFACE.errorMsgDesc = ""
	
CUST.INTERFACE.opndate = ""
CUST.INTERFACE.AcctId = ""
CUST.INTERFACE.errorCode = ""
CUST.INTERFACE.errorDesc = ""
sv_x = CUST.INTERFACE.respXMLMsg

#--------------------------------------------------------------------------------------------------------
# Fetching the status of the request
#--------------------------------------------------------------------------------------------------------
sv_y = "<Status>"
sv_z = "</Status>"
sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
sv_e = GETPOSITION(sv_x, sv_z) - 1
IF (GETPOSITION(sv_x, sv_y) != 0) THEN
#{
	CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
#}
ELSE
#{
	CUST.INTERFACE.tranStatus = ""
#}
ENDIF
print(CUST.INTERFACE.tranStatus)
#--------------------------------------------------------------------------------------------------------
# If Success fetching cif id and cif opn date else fetching error code and description
#--------------------------------------------------------------------------------------------------------
IF (CUST.INTERFACE.tranStatus =="SUCCESS")  THEN
#{
	CUST.INTERFACE.errorMsgFlg = "N"
	sv_x = CUST.INTERFACE.respXMLMsg
	sv_y = "<AcctId>"
	sv_z = "</AcctId>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.AcctId = MID$(sv_x, sv_b, (sv_e - sv_b))
		print(CUST.INTERFACE.AcctId)
	#}
	ENDIF
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				sv_s = "UPDATE CUSTOM.BULK_CIF_DRC "
				sv_s = sv_s + " SET entity_cre_flg = 'S',FORACID= ?SVAR"
				sv_s = sv_s + " WHERE cif_id= ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.INTERFACE.AcctId + "|" + CUST.INTERFACE.cifid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
		
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
		
	IF (CUST.INTERFACE.AcctId == "") THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorCode = "SYSERR"
		CUST.INTERFACE.errorDesc = "Could not get response from server"
	#}
	ENDIF
#}
ELSE
#{
	CUST.INTERFACE.errorMsgFlg = "Y"
	IF(CUST.INTERFACE.tranStatus != "SUCCESS") THEN
	#{
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<ErrorCode>"
		sv_z = "</ErrorCode>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
		ENDIF
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<ErrorDesc>"
		sv_z = "</ErrorDesc>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
		ENDIF

			#----------------------------------------------------------------------------------------------------
			# Update custom table failure status
			#----------------------------------------------------------------------------------------------------
			IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
			#{
				CUST.INTERFACE.errorCode = "SYSERR"
				CUST.INTERFACE.errorDesc = "Could not get response from server"
			#}
			ENDIF

			sv_s = "UPDATE CUSTOM.BULK_CIF_DRC "
			sv_s = sv_s + " SET entity_cre_flg = 'E',ERROR_CODE =?SVAR  "
			sv_s = sv_s + " WHERE cif_id= ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.errorDesc + "|" + CUST.INTERFACE.cifid + "|" + BANCS.STDIN.contextBankId 
			print(BANCS.INPARAM.BINDVARS)
	
			sv_d = urhk_dbSQLWithBind(sv_s)
			IF (sv_d == 0) THEN
			#{
				sv_c = urhk_dbSQLWithBind("commit")
				print(sv_c)
			#}
			ENDIF
	#}
	ENDIF
	IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
	#{
		CUST.INTERFACE.errorCode = "SYSERR"
		CUST.INTERFACE.errorDesc = "Could not get response from server"
	#}
	ENDIF
#}
ENDIF

print(CUST.INTERFACE.errorMsgFlg)
print(CUST.INTERFACE.AcctId)
print(CUST.INTERFACE.opndate)
print(CUST.INTERFACE.errorCode)
print(CUST.INTERFACE.errorDesc)
#}
ENDIF

		sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
		print(sv_k)

	#}
	DO

	sv_c = urhk_dbCursorClose(CUST.INTERFACE.DbcursorNumber)
	print(sv_c)
#}
ENDIF

ENDOFSCRIPT:
EXITSCRIPT
#trace off
end-->


