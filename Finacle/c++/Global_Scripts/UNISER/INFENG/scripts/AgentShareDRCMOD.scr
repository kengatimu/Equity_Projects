trace on

#####----------------------------------------------####
# Creating of  Repositories and Classes
#####----------------------------------------------####

IF(REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","ATM") == 0) THEN
#{
    CREATECLASS("CUST","ATM",5)
#}
ENDIF

sv_u=urhk_B2k_PrintRepos("BANCS")
print(sv_u)

	IF (BANCS.INPUT.Foracid!="") THEN
		print(BANCS.INPUT.Foracid)
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
		IF (sv_u != "0") THEN
		#{
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			sv_c = BANCS.OUTPARAM.schmCode
			print(sv_c)
			CUST.ATM.schmCodeDR = BANCS.OUTPARAM.schmCode
			print(CUST.ATM.schmCodeDR)
			CUST.ATM.cifIdDR = BANCS.OUTPARAM.cifId
			print(CUST.ATM.cifIdDR)
			CUST.ATM.SolIdDR = BANCS.OUTPARAM.acctSolId
			print(CUST.ATM.SolIdDR)
		#}
		ENDIF
	ENDIF

	IF (BANCS.INPUT.CrForacid!="") THEN
		print(BANCS.INPUT.CrForacid)
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
		IF (sv_u != "0") THEN
		#{
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			sv_c = BANCS.OUTPARAM.schmCode
			print(sv_c)
			CUST.ATM.schmCodeCR = BANCS.OUTPARAM.schmCode
			print(CUST.ATM.schmCodeCR)
			CUST.ATM.cifIdCR = BANCS.OUTPARAM.cifId
			print(CUST.ATM.cifIdCR)
			CUST.ATM.SolIdCR = BANCS.OUTPARAM.acctSolId
			print(CUST.ATM.SolIdCR)
		#}
		ENDIF
	ENDIF
	IF (BANCS.INPUT.ReservedField2=="CASHIN") THEN
		IF ((FIELDEXISTS(CUST.ATM.schmCodeDR) == 1) AND (FIELDEXISTS(CUST.ATM.schmCodeCR) == 1)) THEN
			IF (CUST.ATM.schmCodeDR == CUST.ATM.schmCodeCR) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			####  agent to agent start
			### CA233
			IF ((CUST.ATM.schmCodeDR =="CA233") AND (CUST.ATM.schmCodeCR=="CA233")) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			IF ((CUST.ATM.schmCodeDR =="CA233") AND (CUST.ATM.schmCodeCR=="CA234")) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			IF ((CUST.ATM.schmCodeDR =="CA233") AND (CUST.ATM.schmCodeCR=="CA213")) THEN
				GOTO ENDOFSCRIPT
			ENDIF

			## CA234
			IF ((CUST.ATM.schmCodeDR =="CA234") AND (CUST.ATM.schmCodeCR=="CA234")) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			IF ((CUST.ATM.schmCodeDR =="CA234") AND (CUST.ATM.schmCodeCR=="CA233")) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			IF ((CUST.ATM.schmCodeDR =="CA234") AND (CUST.ATM.schmCodeCR=="CA213")) THEN
				GOTO ENDOFSCRIPT
			ENDIF

			## CA213
			IF ((CUST.ATM.schmCodeDR =="CA213") AND (CUST.ATM.schmCodeCR=="CA213")) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			IF ((CUST.ATM.schmCodeDR =="CA213") AND (CUST.ATM.schmCodeCR=="CA233")) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			IF ((CUST.ATM.schmCodeDR =="CA213") AND (CUST.ATM.schmCodeCR=="CA234")) THEN
				GOTO ENDOFSCRIPT
			ENDIF
			####  agent to agent end
		ENDIF
	ENDIF
	############################
	CUST.ATM.freetextIND="DRCMOB"
