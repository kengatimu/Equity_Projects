	CUST.ATM.way4brkmerchant="Y"
	print(CUST.ATM.way4brkmerchant)
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField1) == 1) THEN
		CUST.ATM.DeviceIdagtt=BANCS.INPUT.ReservedField1
		print(CUST.ATM.DeviceIdagtt)
	ENDIF

	CUST.ATM.TranCrncyagt = BANCS.STDIN.homeCrncyCode
	print(CUST.ATM.TranCrncyagt)
	IF (BANCS.INPUT.TranCrncy!="") THEN
		CUST.ATM.TranCrncyagt = BANCS.INPUT.TranCrncy
		print(CUST.ATM.TranCrncyagt)
	ELSE
		CUST.ATM.TranCrncyagt = BANCS.STDIN.homeCrncyCode
		print(CUST.ATM.TranCrncyagt)
	ENDIF
	sv_s = "sol_id,account|"
	sv_s = sv_s + " SELECT agt.sol_id,gam.foracid "
	sv_s = sv_s + " FROM tbaadm.AGT,tbaadm.GAM "
	sv_s = sv_s + " WHERE AGT.OPER_CREDIT_ACID=GAM.acid "
	sv_s = sv_s + " AND GAM.acct_cls_flg!='Y'"
	sv_s = sv_s + " AND agent_code = ?SVAR"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND AGT.del_flg !='Y' and agt.FREE_TEXT= ?SVAR and agt.CRNCY_CODE= ?SVAR and rownum<2"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.ATM.DeviceIdagtt + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.ATM.freetextIND + "|" + CUST.ATM.TranCrncyagt
	sv_d =urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == "0") then
		CUST.ATM.Agentaccount=BANCS.OUTPARAM.account
		print(CUST.ATM.Agentaccount)
		CUST.ATM.SolIdDR = BANCS.OUTPARAM.sol_id
		print(CUST.ATM.SolIdDR)
		########### Start Status 
		PRINT(CUST.ATM.Agentaccount)
		sv_s = "SOL_ID,FORACID,SCHM_CODE,NAME,CIF_ID,ACCT_STATUS,ACCT_CRNCY_CODE,FREZ_CODE,FREZ_REASON_CODE "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT gam.sol_id,gam.foracid,gam.schm_code,RPAD(GAM.acct_name,80,' ') name,GAM.cif_id,acct_status,acct_crncy_code,FREZ_CODE,FREZ_REASON_CODE "
		sv_s = sv_s + " FROM TBAADM.GAM , TBAADM.smt WHERE  smt.acid=GAM.acid AND GAM.foracid = ?SVAR AND GAM.bank_id = ?SVAR AND  GAM.bank_id = smt.bank_id AND rownum<2 "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ATM.Agentaccount + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
			PRINT(BANCS.OUTPARAM.SOL_ID)
			PRINT(BANCS.OUTPARAM.FORACID)
			PRINT(BANCS.OUTPARAM.SCHM_CODE)
			PRINT(BANCS.OUTPARAM.NAME)
			PRINT(BANCS.OUTPARAM.CIF_ID)
			PRINT(BANCS.OUTPARAM.ACCT_STATUS)
			PRINT(BANCS.OUTPARAM.ACCT_CRNCY_CODE)
			PRINT(BANCS.OUTPARAM.FREZ_CODE)
			IF ((BANCS.OUTPARAM.FREZ_CODE=="") OR (BANCS.OUTPARAM.FREZ_CODE==" ")) THEN
				BANCS.OUTPARAM.FREZ_CODE="N"
				print(BANCS.OUTPARAM.FREZ_CODE)
			ENDIF
			PRINT(BANCS.OUTPARAM.FREZ_REASON_CODE)
			IF ((BANCS.OUTPARAM.FREZ_REASON_CODE=="") OR (BANCS.OUTPARAM.FREZ_REASON_CODE==" ")) THEN
				BANCS.OUTPARAM.FREZ_REASON_CODE="N"
				print(BANCS.OUTPARAM.FREZ_REASON_CODE)
			ENDIF
			IF ((BANCS.OUTPARAM.ACCT_STATUS=="D") OR (BANCS.OUTPARAM.ACCT_STATUS=="I")) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.ReservedField1 = "Agent Account is Dormant Or Inactive Transaction Not allowed "
				print(BANCS.OUTPUT.ReservedField1)
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			ENDIF
			IF ((BANCS.OUTPARAM.FREZ_CODE=="D") OR (BANCS.OUTPARAM.FREZ_CODE=="T")) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.ReservedField1 = "Agent Account is Frozen Transaction Not allowed "
				print(BANCS.OUTPUT.ReservedField1)
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			ENDIF
		ENDIF
		########### End Status  
	ENDIF

	IF ((BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYTELEGRAM") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYTELEGRAM") OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYTELEGRAM")) THEN
		sv_t= urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
		print(sv_t)
		IF (sv_t == 0) THEN
			CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
			print(CUST.ATM.solid)
			CUST.ATM.SolIdDR = CUST.ATM.solid
			print(CUST.ATM.SolIdDR)
