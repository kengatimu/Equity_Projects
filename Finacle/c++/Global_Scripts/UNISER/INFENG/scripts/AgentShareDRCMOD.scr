		ENDIF
		IF ((BANCS.INPUT.Command == "DBRR") AND ((BANCS.INPUT.ReservedField2=="AGENCYBANKINGGENERIC") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR  (BANCS.INPUT.ReservedField2=="AGENCYBANKINGSCHOOL") OR (BANCS.INPUT.ReservedField2=="DGRKBILLPYT") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGTAX") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYUSSD")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYTELEGRAM") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYTELEGRAM")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYTELEGRAM"))) THEN
