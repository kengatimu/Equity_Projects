	ELSE
		CUST.ATM.TranCrncyagt = BANCS.STDIN.homeCrncyCode
		print(CUST.ATM.TranCrncyagt)
	ENDIF
	
	#------------------------------------------------------------------
	#  Getting account to Debit and Credit 
	#------------------------------------------------------------------
	
	IF ((BANCS.INPUT.Command == "DBTR") OR (BANCS.INPUT.Command == "DBRR") ) THEN
	#{
		IF ((BANCS.INPUT.Command == "DBTR") OR (BANCS.INPUT.Command == "DBRR")) THEN
			IF (BANCS.INPUT.ReservedField2=="CASHOUT") THEN
				###
				CUST.ATM.bacidagt1 ="AGENCYPOSWITHD"
				print(CUST.ATM.bacidagt1)
				sv_s = "contra|"
				sv_s = sv_s + " SELECT foracid "
				sv_s = sv_s + " FROM GAM "
				sv_s = sv_s + " WHERE sol_id = ?SVAR "
				sv_s = sv_s + " AND acct_ownership='O' "
				sv_s = sv_s + " AND DEL_FLG ='N' "
				sv_s = sv_s + " AND BACID = ?SVAR  "
				sv_s = sv_s + " AND bank_id = ?SVAR and rownum<2 "
				BANCS.INPARAM.BINDVARS = CUST.ATM.SolIdDR + "|" + CUST.ATM.bacidagt1 + "|" + BANCS.STDIN.contextBankId 
				sv_d =urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == "0") then
					CUST.ATM.drAccount=BANCS.OUTPARAM.contra
					print(CUST.ATM.drAccount)
					IF ((BANCS.INPUT.ReservedField2=="CASHOUT") OR (BANCS.INPUT.ReservedField2=="XXXXXXX"))  THEN
						IF (BANCS.INPUT.ReservedField1=="CARDFEE") THEN
							IF (CUST.ATM.schmCodeDR=="CA290") THEN
								CUST.ATM.drAccount="15000807010014"
								print(CUST.ATM.drAccount)
							ENDIF
						ENDIF
					ENDIF
					sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.drAccount)
					IF (sv_u != "0") THEN
					#{
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				ENDIF
				###
				CUST.ATM.bacidagt2 ="AGENCYPOSPAYABLE"
				print(CUST.ATM.bacidagt2)
				sv_s = "contra|"
				sv_s = sv_s + " SELECT foracid "
				sv_s = sv_s + " FROM GAM "
				sv_s = sv_s + " WHERE sol_id = ?SVAR "
				sv_s = sv_s + " AND acct_ownership='O' "
				sv_s = sv_s + " AND DEL_FLG ='N' "
				sv_s = sv_s + " AND BACID = ?SVAR  "
				sv_s = sv_s + " AND bank_id = ?SVAR AND acct_crncy_code = ?SVAR and rownum<2 "
				BANCS.INPARAM.BINDVARS = CUST.ATM.SolIdDR + "|" + CUST.ATM.bacidagt2 + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ATM.TranCrncyagt
				sv_d =urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == "0") then
					CUST.ATM.CrAccount=BANCS.OUTPARAM.contra
					print(CUST.ATM.CrAccount)
					sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.CrAccount)
					IF (sv_u != "0") THEN
					#{
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				ENDIF
			ENDIF
			##IF (BANCS.INPUT.ReservedField2=="CASHIN") THEN
			IF ((BANCS.INPUT.ReservedField2=="AGENCYBANKINGGENERIC") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR  (BANCS.INPUT.ReservedField2=="AGENCYBANKINGSCHOOL") OR (BANCS.INPUT.ReservedField2=="DGRKBILLPYT") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGTAX") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYUSSD")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYTELEGRAM") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYTELEGRAM")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYTELEGRAM")) THEN
				CUST.ATM.bacidagt3 ="AGENCYPOSDEPOSIT"
				print(CUST.ATM.bacidagt3)
				sv_s = "contra|"
				sv_s = sv_s + " SELECT foracid "
				sv_s = sv_s + " FROM GAM "
				sv_s = sv_s + " WHERE sol_id = ?SVAR "
				sv_s = sv_s + " AND acct_ownership='O' "
				sv_s = sv_s + " AND DEL_FLG ='N' "
				sv_s = sv_s + " AND BACID = ?SVAR  "
				sv_s = sv_s + " AND bank_id = ?SVAR and rownum<2 "
				BANCS.INPARAM.BINDVARS = CUST.ATM.SolIdDR + "|" + CUST.ATM.bacidagt3 + "|" + BANCS.STDIN.contextBankId 
				sv_d =urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == "0") then
					CUST.ATM.drAccount=BANCS.OUTPARAM.contra
					print(CUST.ATM.drAccount)
					sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.drAccount)
					IF (sv_u != "0") THEN
					#{
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				ENDIF
				CUST.ATM.bacidagt4 ="AGENCYPOOLPAYABL"
				print(CUST.ATM.bacidagt4)
				sv_s = "contra|"
				sv_s = sv_s + " SELECT foracid "
				sv_s = sv_s + " FROM GAM "
				sv_s = sv_s + " WHERE sol_id = ?SVAR "
				sv_s = sv_s + " AND acct_ownership='O' "
				sv_s = sv_s + " AND DEL_FLG ='N' "
				sv_s = sv_s + " AND BACID = ?SVAR  "
				sv_s = sv_s + " AND bank_id = ?SVAR AND acct_crncy_code = ?SVAR and rownum<2 "
				BANCS.INPARAM.BINDVARS = CUST.ATM.SolIdDR + "|" + CUST.ATM.bacidagt4 + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ATM.TranCrncyagt
				sv_d =urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == "0") then
					CUST.ATM.CrAccount=BANCS.OUTPARAM.contra
					print(CUST.ATM.CrAccount)
					sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.CrAccount)
					IF (sv_u != "0") THEN
					#{
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		IF (BANCS.INPUT.Command == "DBRR") THEN
			print(CUST.ATM.CrAccount)
			print(CUST.ATM.drAccount)
			sv_g = CUST.ATM.CrAccount
			sv_j = CUST.ATM.drAccount
			CUST.ATM.CrAccount = sv_j
			print(CUST.ATM.CrAccount)
			CUST.ATM.drAccount = sv_g
			print(CUST.ATM.drAccount)
		ENDIF
	#}
	ENDIF
	print(CUST.ATM.CrAccount)
	print(CUST.ATM.drAccount)
	##########
	#------------------------------------------------------------------
	#  Getting transaction amount
	#------------------------------------------------------------------
	
	print(BANCS.INPUT.TranAmt)

	IF (BANCS.INPUT.TranAmt == "") THEN
	#{
		CUST.ATM.Amount = "0"
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.ATM.Amount = CDOUBLE(BANCS.INPUT.TranAmt)
		CUST.ATM.Amount = CDOUBLE(CUST.ATM.Amount)/CDOUBLE("100")
		print(CUST.ATM.Amount)

		IF (BANCS.INPUT.ReservedField2=="CASHOUT") THEN
			CUST.ATM.tableCode="AGWIT"
			print(CUST.ATM.tableCode)
		ENDIF
		##IF (BANCS.INPUT.ReservedField2=="CASHIN") THEN
		IF ((BANCS.INPUT.ReservedField2=="AGENCYBANKINGGENERIC") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR  (BANCS.INPUT.ReservedField2=="AGENCYBANKINGSCHOOL") OR (BANCS.INPUT.ReservedField2=="DGRKBILLPYT") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGTAX") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYUSSD")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYTELEGRAM") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYTELEGRAM")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYTELEGRAM")) THEN
			CUST.ATM.tableCode="AGDEP"
			print(CUST.ATM.tableCode)
		ENDIF
		#---------------------------------------------------------
		# getting amount to share 
		#---------------------------------------------------------
		
		BANCS.INPARAM.InputAmount = CUST.ATM.Amount
		print(BANCS.INPARAM.InputAmount)
		BANCS.INPARAM.CurrencyCode = BANCS.INPUT.TranCrncy
		print(BANCS.INPARAM.CurrencyCode)
		BANCS.INPARAM.AmountTableCode = CUST.ATM.tableCode
		print(BANCS.INPARAM.AmountTableCode)

		sv_u = urhk_B2k_GetASTMAmount ("") 
		print(sv_u)
		If (sv_u ==1)  then 
		#{
			sv_u = urhk_SRV_SetErr("Invalid Charge Code")
			BANCS.OUTPUT.successOrFailure = "F" 
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.ATM.agentShare = BANCS.OUTPARAM.OutputAmount
			print(CUST.ATM.agentShare)
			IF (BANCS.INPUT.ReservedField2=="CASHOUT") THEN
				##CUST.ATM.drCrAmount = CDOUBLE(CUST.ATM.agentShare)/CDOUBLE("2")
				CUST.ATM.drCrAmount = CUST.ATM.agentShare
				print(CUST.ATM.drCrAmount)
			ENDIF
			##IF (BANCS.INPUT.ReservedField2=="CASHIN") THEN
			IF ((BANCS.INPUT.ReservedField2=="AGENCYBANKINGGENERIC") OR (BANCS.INPUT.ReservedField2=="CASHIN") OR  (BANCS.INPUT.ReservedField2=="AGENCYBANKINGSCHOOL") OR (BANCS.INPUT.ReservedField2=="DGRKBILLPYT") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGTAX") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYUSSD")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYTELEGRAM") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYTELEGRAM")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYTELEGRAM")) THEN
				CUST.ATM.drCrAmount = CUST.ATM.agentShare
				print(CUST.ATM.drCrAmount)
			ENDIF
		ENDIF

		IF ((BANCS.INPUT.ReservedField2=="AGENCYBANKINGGENERIC") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGSCHOOL") OR (BANCS.INPUT.ReservedField2=="DGRKBILLPYT") OR (BANCS.INPUT.ReservedField2=="AGENCYBANKINGTAX") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYUSSD")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYUSSD") OR (BANCS.INPUT.ReservedField2=="SCHOOLBILLPAYTELEGRAM") OR (BANCS.INPUT.ReservedField2=="GENERICBILLPAYTELEGRAM")  OR (BANCS.INPUT.ReservedField2=="TAXBILLPAYTELEGRAM")) THEN
			IF (FIELDEXISTS(BANCS.INPUT.TranFeeAmount1) == 1) THEN
				CUST.ATM.Amountbill = CDOUBLE(BANCS.INPUT.TranFeeAmount1)
				CUST.ATM.Amountbill = CDOUBLE(CUST.ATM.Amountbill)/CDOUBLE("2")
				print(CUST.ATM.Amountbill)
				CUST.ATM.drCrAmount = CUST.ATM.Amountbill
