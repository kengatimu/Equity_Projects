me			: FI_ChangeLAContextSol.scr
#	Description		: To Change local LGI pointer context sol value
#	Input			: NA
#	Output			: NA
#	Called Script		: laspay_main.scr
#	Calling Scrip		: NA
#	Menu Option		: laspay
#	Srl. No			Date			Author			Description.   
#	-------			---------		-------			---------------			
#	1.0			05-Aug-2022		Edwin Zico		Original Version
#----------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#------------------------------------------------------------------------------
if(REPEXISTS("CUST") == 0)then
#{
        CREATEREP("CUST")
#}
endif

if(CLASSEXISTS("CUST","DATA") == 0)then
#{
    CREATECLASS("CUST","DATA",5)
#}
endif

#----------------------------------------------------------------------
# Channel validate
#------------------------------------------------------------------------
sv_u = urhk_B2K_PrintRepos("BANCS")
print(sv_u)

CUST.DATA.DccId=""
sv_a = urhk_GetChannelInfo("")
print(sv_a)
if (sv_a!=0) then
#{
     sv_u = urhk_SRV_SetErr("Error: Channel ID is not passed/Incorrect")
     BANCS.OUTPUT.successOrFailure="F"
     GOTO ENDOFSCRIPT
#}
else
#{
    CUST.DATA.DccId = BANCS.OUTPARAM.DccId
    print(CUST.DATA.DccId)
#}
endif

if((CUST.DATA.DccId=="EMP")OR (CUST.DATA.DccId=="PWE"))then
#{
	print("Ok for context switch")
#}
else
#{
	exitscript
#}
endif

CUST.DATA.InitSolId = BANCS.STDIN.mySolAlias
print(CUST.DATA.InitSolId)
print(BANCS.STDIN.homeSolId)
print(CUST.INTERFACE.sourceAcId)
sv_u = urhk_getAcctDetailsInRepository(CUST.INTERFACE.sourceAcId)
if(sv_u ==0)then
	CUST.DATA.acctOwnership = BANCS.OUTPARAM.acctOwnerShip
	CUST.DATA.solId = BANCS.OUTPARAM.acctSolId
endif
if(CUST.DATA.acctOwnership =="O")then
	if(CUST.DATA.solId != CUST.DATA.InitSolId)then
		BANCS.INPARAM.FlagType="A"
		BANCS.INPARAM.AcctId=CUST.INTERFACE.sourceAcId                           
		sv_u = urhk_ContextSOLUpdate("")
		if(sv_u != 0)then		
			sv_u = urhk_SRV_SetErr("Error: Unable to Change Context SOL for Acct:"+CUST.INTERFACE.sourceAcId)
		endif
	endif
endif

EXITSCRIPT
TRACE OFF
END-->



