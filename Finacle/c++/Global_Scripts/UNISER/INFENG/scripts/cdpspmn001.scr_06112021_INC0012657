				#{
				sv_m = "PassSheet Printing intiated Successfully . Charge collection failed."
			#}
			ENDIF
			
			sv_d = urhk_SetOrbOut("RESULT_MSG|"+sv_m)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			
		#}
		ENDIF
		
		sv_m = sv_m + "!" + CUST.PORT.noOfPages
		print(sv_m)
		sv_d = urhk_SetOrbOut("RESULT_MSG|"+sv_m)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		
		
	ENDOFSCRIPT:
		#trace off
		EXITSCRIPT
