<--START
CHECKSUM="4c4ad0e186fd6b5ad11a699a8f62a62175eb151828e1a367c4b114c4e8ffe4c6"
	TRACE ON
	
	####Customization : Collecting the VAT amount based on VAT percentage set at CPARAM ##############################
	
	
	IF (REPEXISTS("CUST") == 0) THEN
