	BANCS.INPARAM.BINDVARS =  CUST.VAT.schmCode + "|" + BANCS.STDIN.contextBankId
	
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_k = urhk_dbSelectWithBind(sv_s)
