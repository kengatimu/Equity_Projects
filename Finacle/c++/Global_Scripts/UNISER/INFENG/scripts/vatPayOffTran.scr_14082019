	PRINT(sv_u)
	sv_x = CDOUBLE(MTT.InputDetails.tranPenalInterestAmount)
	PRINT(sv_x)
	
	
	
	#Fecthing scheme code for the account############
	
	sv_k = "schmCode,acid,solId|select SCHM_CODE ,ACID,SOL_ID from TBAADM.GAM  "
	sv_k = sv_k + " where FORACID= ?SVAR "
	sv_k = sv_k + " AND ENTITY_CRE_FLG = 'Y'"
	sv_k = sv_k + " AND BANK_ID = ?SVAR "
	sv_k = sv_k + " AND DEL_FLG = 'N'"
	
	
	PRINT(sv_k)
	
	
	BANCS.INPARAM.BINDVARS =  CUST.VAT.foracid + "|" + BANCS.STDIN.contextBankId
	
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_k = urhk_dbSelectWithBind(sv_k)
	PRINT(sv_k)
	
	IF(sv_k == 0)THEN
	#{
		CUST.VAT.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(CUST.VAT.schmCode)
		CUST.VAT.acid = BANCS.OUTPARAM.acid
		PRINT(CUST.VAT.acid)
		CUST.VAT.solId = BANCS.OUTPARAM.solId
		PRINT(CUST.VAT.solId)
		
		
	#}
	ENDIF
	
