	IF (MTT.InputDetails.funcCode == "R" ) THEN
	#{
		
		sv_s = "normalInt|"
		sv_s = sv_s + " SELECT TRAN_AMT  FROM tbaadm.dctd_acli WHERE bank_id = ?SVAR "
