<--START
TRACE ON

#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

###############################################################################
# Validate the channel id for which context switch should be done
##############################################################################

CUST.DATA.DccId=""
sv_a = urhk_GetChannelInfo("")
print(sv_a)
if (sv_a!=0) then
#{
     sv_u = urhk_SRV_SetErr("Error: Channel ID is not passed/Incorrect")
     BANCS.OUTPUT.successOrFailure="F"
     GOTO ENDOFSCRIPT
#}
else
#{
    CUST.DATA.DccId = BANCS.OUTPARAM.DccId
    print(CUST.DATA.DccId)
#}
endif

IF ((CUST.DATA.DccId == "IGL") OR ( CUST.DATA.DccId == "ICO") OR ( CUST.DATA.DccId == "DEP") OR ( CUST.DATA.DccId == "POL") OR ( CUST.DATA.DccId == "BRK")) THEN
#{
	# Entitled for context switch
	print("Ok for context switch")
#}
ELSE
#{
	# Skip the context switching as the channel is not entitled to change
	####GOTO ENDOFSCRIPT
#}
ENDIF

CUST.DATA.noOfRecords = "0"
sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	CUST.DATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.DATA.noOfRecords)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
	BANCS.OUTPUT.successOrFailure = "F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_l = 0
sv_m = ""
sv_p = ""
sv_n = 0
sv_t = 0

WHILE(sv_l < CINT(CUST.DATA.noOfRecords))
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		#("CUST").("DATA").("foracid_"+sv_r) = BANCS.OUTPARAM.srvValue
		#CUST.DATA.foracid = ("CUST").("DATA").("foracid_"+sv_r)
		CUST.DATA.foracid = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.foracid)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for foracid")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		("CUST").("DATA").("partTran _"+sv_r) = BANCS.OUTPARAM.srvValue
		CUST.DATA.partTran = ("CUST").("DATA").("partTran _"+sv_r)
		PRINT(CUST.DATA.partTran)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for part Tran")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".delFlg")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.delFlg = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.delFlg)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for delFlg")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	PRINT(CUST.DATA.foracid)
	IF ((CUST.DATA.delFlg != "Y") AND (CUST.DATA.foracid != "")) THEN
	#{
		sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.foracid)
		IF (sv_u == 0) THEN
		#{
			CUST.DATA.laSolId = BANCS.OUTPARAM.acctSolId
			CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
			sv_d = "isBCDC | select count(*) from tbaadm.sst where bank_id=?SVAR and set_id='BCDC' and sol_id=?SVAR "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.laSolId
			print(BANCS.INPARAM.BINDVARS)
			print(sv_d)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
			    CUST.DATA.isBCDC = BANCS.OUTPARAM.isBCDC
			else
			    CUST.DATA.isBCDC = 0
			endif
			if(cdouble(CUST.DATA.isBCDC)>=1)then
				BANCS.INPARAM.FlagType="A"
				BANCS.INPARAM.AcctId=CUST.DATA.foracid
				sv_u = urhk_ContextSOLUpdate("")
				IF(sv_u != 0) THEN
				#{
					sv_u = urhk_SRV_SetErr("Error: Unable to Change Context SOL for Acct:"+CUST.DATA.foracid)
				#}
				ENDIF
				######## Exit after setting successfully for first office account
				sv_l = CINT(CUST.DATA.noOfRecords)			
				print(sv_l)
				GOTO LOOPEND
			else
				sv_l = CINT(CUST.DATA.noOfRecords)			
				print(sv_l)
				goto LOOPEND
			endif
		else
			sv_l = CINT(CUST.DATA.noOfRecords)			
			print(sv_l)
			goto LOOPEND
			
		#}
		ENDIF
	#}
	ENDIF

	LOOPEND:
		sv_l = sv_l + 1
        	print(sv_l)


#}
DO

EXITSCRIPT
#TRACE OFF
END-->

