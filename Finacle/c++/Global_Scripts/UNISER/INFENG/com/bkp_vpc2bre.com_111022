usId=${stuserId}
bankId=${bankId}
EventType=${EventType}
dfilpth=${dfilpth}
dRptname=${dRptname}
dfilname=${dfilname}
echo ${EventType} >>MTTRUN.txt
if [ "$EventType" = "MTTRUN" ]; then
echo ${EventType} >> MTTRUN1.txt
nohup exebatch babx4061 $B2K_SESSION_ID c2bre_dbInsert.scr ${dfilpth}  ${dRptname} ${dfilname}  @s
echo ${stuserId}  ${bankId} ${EventType} ${dfilname} ${dfilpth} ${dRptname} >> exemMM.log
fi

