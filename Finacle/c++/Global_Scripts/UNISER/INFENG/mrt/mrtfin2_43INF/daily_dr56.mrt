# Template Name :		daily_dr56.mrt
# Description	:		PAR  Executive Summary
# Author			E.G.KAROBIA, 13/10/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr40.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType

tot_portfolio		numberType
tot_clr_bal		numberType
tot_risk		numberType
par			numberType

grnd_branchcd   	numberType
grnd_advance_amt 	numberType
grnd_principal		numberType
grnd_demand_interest	numberType
grnd_penal_interest	numberType
grnd_overdue_days	numberType
grnd_total_arrears	numberType
grnd_portfolio		numberType
grnd_clr_bal		numberType


#
GROUPANDSORT
sol_id ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 120
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
if total_arrears = 0 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
	nextline
	nextline
	print "(a) Total Portfolio :" column 5 
	print " "
	print portfolio format "#,###,###,###,###.##"
	set  tot_risk = grnd_clr_bal + grnd_demand_interest + grnd_penal_interest
	set par = (tot_risk/portfolio)*100
	set par = roundoff par N 0.01
	nextline
	nextline
	print "(b) Total Risk Amt(O/s Bal+Int+pen.Int) "  column 5
	print "  "
	print tot_risk format "#,###,###,###,###.##"
	nextline
	nextline
	print "(c) P A R  ((b/a)*100)"  column 5
	print "  "
	print par format "#,###,###,###,###.##"


end
else
begin
	execute printRecordNotExist
end
nextline
nextline
print "Authorised Signatory (BRANCH)" column 20
print "Authorised Signatory"  column 67
nextline
nextline
nextline
print "Signature" column 67
nextline
nextline
print "********************End Of Report*********************" size 120 center
#
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
	print sol_id     column 3
	print advance_amt      column 16   format "#,###,###,###.##"
	print clr_bal	  column 33 format "#,###,###,###.##"
	print principal  column 51 format "#,###,###,###.##"
	print demand_interest	  column 68 format "#,###,###,###.##"
	print penal_interest  column 85 format "#,###,###,###.##"
	print total_arrears column 102 format "#,###,###,###.##"

	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "Branch Code "     column 5
	print "T_Amt advanced "   column 18
	print "T_Out.Balance" column 37
	print "T_principal " column 55
	print "T_Interest"    column 73
	print "T_Penal Int"  column 91
	print "T_Arrears" column 109
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
separatorline
        print "Grand Total" column 1

	set grnd_branchcd = totalcount sol_id
        set grnd_advance_amt =totalsum advance_amt
        set grnd_clr_bal = totalsum clr_bal
	set grnd_principal =totalsum principal
        set grnd_demand_interest =totalsum demand_interest
        set grnd_penal_interest =totalsum penal_interest
	set grnd_total_arrears =totalsum total_arrears 

	print grnd_branchcd     column 3
	print grnd_advance_amt      column 16   format "#,###,###,###.##"
	print grnd_clr_bal  column 33 format "#,###,###,###.##"
	print grnd_principal  column 51 format "#,###,###,###.##"
	print grnd_demand_interest  column 68 format "#,###,###,###.##"
	print grnd_penal_interest  column 85 format "#,###,###,###.##"
	print grnd_total_arrears  column 102 format "#,###,###,###.##"
	
	
separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	separatorline
	print "Subtotal" column 1
	set tot_schm_code_cnt = totalcount schm_code
        set tot_advance_amt =totalsum advance_amt
        set tot_clr_bal = totalsum clr_bal
	set tot_principal =totalsum principal
        set tot_demand_interest =totalsum demand_interest
        set tot_penal_interest =totalsum penal_interest
	set tot_total_arrears =totalsum total_arrears 

	print tot_schm_code_cnt     column 3
	print tot_advance_amt      column 16   format "#,###,###,###.##"
	print tot_clr_bal  column 33 format "#,###,###,###.##"
	print tot_principal  column 51 format "#,###,###,###.##"
	print tot_demand_interest  column 68 format "#,###,###,###.##"
	print tot_penal_interest  column 85 format "#,###,###,###.##"
	print tot_total_arrears  column 102 format "#,###,###,###.##"

	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     size 120 center
	nextline
	print "PAR EXECUTIVE SUMMARY "  size 120 center
	nextline
	nextline
	print "AS AT :" column 70
	print " "
	print date
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********"  size 120 center
nextline
nextline
nextline
end
