# Template Name :		daily_dr42.mrt
# Description	:		PAR  Report Detailed
# Author			E.G.KAROBIA, 12/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr42.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
tot_risk		numberType
par			numberType
tot_acct_name_cnt	numberType
tot_advance_amt		numberType
tot_flow_amt		numberType
tot_principal		numberType
tot_total_dmnd_int	numberType
tot_penal_int		numberType
tot_total_arrears	numberType
tot_total_ovdue_days	numberType
tot_clr_bal		numberType

grnd_acct_name_cnt	numberType
grnd_advance_amt	numberType
grnd_flow_amt		numberType
grnd_principal		numberType
grnd_total_dmnd_int	numberType
grnd_penal_int		numberType
grnd_total_arrears	numberType
grnd_total_ovdue_days	numberType
grnd_clr_bal		numberType

#
GROUPANDSORT
schm_code ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 195
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
if total_arrears = 0 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
	nextline
	nextline
	print "(a) Total Portfolio :" column 5 
	print " "
	print portfolio format "#,###,###,###,###.##"

	set  tot_risk = grnd_clr_bal +grnd_total_dmnd_int+ grnd_penal_int 

	set par = (tot_risk/portfolio)*100
	nextline
	nextline
	print "(b) Total Risk Amt(out.Bal+ Int + pen Int.). "  column 5
	print "  "
	print tot_risk format "#,###,###,###,###.##"
	nextline
	nextline
	print "(c) P A R  ((b/a)*100)"  column 5
	print "  "
	print par format "#,###,###,###,###.##"


end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF schm_code
    print "Product : " 
    print " "
    print schm_code     
    nextline
    nextline
#
AFTERBREAKOF schm_code
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
	print acct_no     column 3
	execute pipe
	print acct_name       column 22
	execute pipe
	print advance_amt  column 56 format "#,###,###,###.##"
	execute pipe
	print flow_amt  column 73 format "#,###,###,###.##"
	execute pipe
	print clr_bal	  column 90 format "#,###,###,###.##"
	execute pipe
	print principal   column 108 format "#,###,###,###.##"
	execute pipe
	print total_dmnd_int column 126 format "#,###,###,###.##"
	execute pipe
	print penal_int   column 143  format "#,###,###,###.##"
	execute pipe
	print total_arrears  column 162 format "#,###,###,###.##"
	execute pipe
	print total_ovdue_days  column 185
	execute pipe
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "A/c # "     column 5
	execute pipe
	print "A/c Name "   column 27
	execute pipe
	print "Amt advanced" column 58
	execute pipe
	print "Instl.Amnt " column 75
	execute pipe
	print "Out.Balance"    column 93
	execute pipe
	print "principal"  column 111
	execute pipe
	print "Interest." column 129
	execute pipe
	Print "Penal Int "  column 146
	execute pipe
	print "Tot.Arrears."  column 166
	execute pipe
	print "Days in Arr."  column 183
	execute pipe
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
separatorline
        print "Grand Total" column  3
        execute pipe	
	set grnd_acct_name_cnt=totalcount acct_name
        set grnd_advance_amt =totalsum advance_amt
        set grnd_flow_amt =totalsum flow_amt
        set grnd_principal =totalsum principal
        set grnd_total_dmnd_int =totalsum total_dmnd_int
        set grnd_total_arrears =totalsum total_arrears
	set grnd_penal_int=totalsum penal_int
	set grnd_clr_bal = totalsum clr_bal

	print grnd_acct_name_cnt column  21
	execute pipe
	print grnd_advance_amt  column 56 format "#,###,###,###.##"
	execute pipe
	print grnd_flow_amt column 73 format "#,###,###,###.##"
	execute pipe
	print grnd_clr_bal  column 90 format "#,###,###,###.##"
	execute pipe
	print grnd_principal   column 108 format "#,###,###,###.##"
	execute pipe
	print grnd_total_dmnd_int column 126 format "#,###,###,###.##"
	execute pipe
	print grnd_penal_int column 143 format "#,###,###,###.##"
	execute pipe
	print grnd_total_arrears  column 162 format "#,###,###,###.##"
	execute pipe
        separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	separatorline
	print "Subtotal" column 3
	execute pipe
	set tot_acct_name_cnt = groupcount acct_name
        set tot_advance_amt = groupsum advance_amt
        set tot_flow_amt = groupsum flow_amt
        set tot_principal = groupsum principal
        set tot_total_dmnd_int = groupsum total_dmnd_int
        set tot_total_arrears = groupsum total_arrears
	set tot_penal_int = groupsum penal_int
	set tot_clr_bal = groupsum clr_bal
	

	print tot_acct_name_cnt column 21 
	execute pipe
	print tot_advance_amt  column 56 format "#,###,###,###.##"
	execute pipe
	print tot_flow_amt column 73 format "#,###,###,###.##"
	execute pipe
	print tot_clr_bal  column 90 format "#,###,###,###.##"
	execute pipe
	print tot_principal   column 108 format "#,###,###,###.##"
	execute pipe
	print tot_total_dmnd_int column 126 format "#,###,###,###.##"
	execute pipe
	print tot_penal_int column 143 format "#,###,###,###.##"
	execute pipe
	print tot_total_arrears  column 162 format "#,###,###,###.##"
        execute pipe
	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "PAR REPORT- DETAILED "  column 64
	nextline
	nextline
	print "AS AT :" column 66
	print " "
	print date
	nextline
	nextline

end
##############################################################################
PROCEDURE pipe

begin

        print "|"               column 1
        print "|"               column 20 
        print "|"               column 55
	print "|"               column 72 
	print "|"               column 89 
	print "|"               column 107
	print "|"               column 125
	print "|"               column 142
	print "|"               column 162
	print "|"               column 180
	print "|"               column 195
        
end
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
