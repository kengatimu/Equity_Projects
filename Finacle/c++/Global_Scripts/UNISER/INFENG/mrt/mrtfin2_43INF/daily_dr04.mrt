#********************************************************************************
#    Report Name                        :    daily_dr04.mrt  
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*

#################################################################################

#**********************************************************************
#  DESC   :  This is the Mahareport specs for generating the accounts
#			 which are opened  and closed 
######################################################################
#
#
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
#
Type 		stringType
schmCode	stringType
foracid         stringType
acctName        stringType
date		stringType
enterId         stringType
authId          stringType

LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
count			numberType
totAccOpened		numberType
totAccClosed		numberType
page_number		numberType
schmcd			numberType
lv_setid	        stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
ipstype			stringtype
#
#
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is already sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in
#   RECORDLAYOUT section.
####################################################################
 date,Type,schmCode
#
#
#############################################################################
#
#   REPOSITORY (Optional Section) - Fixed-Type Repository.
#   This section tells about the Repository Information. A  Repository  is  a
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#   Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#
#############################################################################
REPOSITORY bankRepos.rip
############################################################################
bankName        stringType
branchName      stringtype

REPOSITORY  argv4
ipsetid				 stringType
ipFrmdate                        stringtype 
ipTodate			 stringType
ipFrmsch			 stringType
ipTosch				 stringType
ipType				 stringType

#
#
#MASSAGERECORD
#############################################################################
#
#   MASSAGERECORD (Optional Section).
#   The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#   later. This Block is executed every time a new record is read.
#
#############################################################################
#
#
IGNORERECORD
#############################################################################
#
#   IGNORERECORD (Optional Section).
#   The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
#   for input records), the record is Ignored.
#
#############################################################################
if type = ipstype
#
#
ONSTARTOFREPORT
#############################################################################
set count = 0
set totAccOpened = 0
set totAccClosed = 0

execute  pageHdr
execute  commonPageHdr

set page_number = 1
begin
if iptype ="O" 
 set ipstype = "C"
if iptype = "C"
 set ipstype = "O"
if iptype ="A"
 set ipstype ="A"
end
#
#
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    66
columnsperline  142
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 15
pagefooterlines 4
#
Beforebreakof date
####################################################################
#Abeforebreakoff date
####################################################################
nextline
print "Accounts for date     :" column 1
print date
nextline
AFTERBREAKOF schmCode
####################################################################
#AFTERBREAKOF schmCode
####################################################################
 set schmcd = groupcount schmcode
 nextline
 print " Total Accounts       :" column 1
 print schmcd 
 nextline
#
ONEVERYRECORD
####################################################################
# ON EVERY RECORD
####################################################################
 execute pipe
 print schmcode column 2
 print foracid column 17 
 print acctName column 37 size 25 
 begin
 if type ="O"and iptype ="O"
   print date column 67
 if type ="O" and iptype ="A"
   print date column 67
 end
 print enterId column 81 size 25
 begin
 if type ="C"and iptype ="C"
   print date column 105
 if type ="C" and iptype ="A"
   print date column 105
 end
 print authId column 125
 nextline
 set count = count + 1
 begin
  if type="O" and iptype="O" 
   set totAccOpened =totAccOpened+1
  if type="O" and iptype = "A"
   set totAccOpened =totAccOpened+1
  if type ="C" and iptype = "C"
   set totAccClosed = totAccClosed+1
  if type="C" and iptype = "A"
    set totAccClosed = totAccClosed+1
 end
#
#
ONENDOFREPORT
#############################################################################
#
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
#
#############################################################################
execute  Line
nextline
nextline
begin
 if iptype="O" and type ="O"
   print "Total Number of Accounts Opened : " column 5
   print " "
   print totAccOpened 
 if iptype ="C" and type = "C"
   print "Total Number of Accounts Closed : " column 5
   print " "
   print totAccClosed 
 if iptype = "A" 
   print "Total Number of Accounts Opened : " column 5
   print " "
   print totAccOpened 
   print " "
   print "Total Number of Accounts Closed : " 
   print " "
   print totAccClosed 
 end
nextline
nextline
begin

        if ( totalCount foracid = 0 )
        begin
                nextline
                nextline
                nextline
                separatorline
                print "  NO RECORD SELECTED FOR THE GIVEN CRITERIA " column 20
                separatorline
        end
		else

	begin
		execute line
                nextline
                nextline
		nextline
		nextline
		print "       Printed By:  " column 20
                print lv_userId
		print "                          Verified By: " 
                nextline
		print today  column 27
	end
end
#
#
PAGEHEADER
#######################################################################
#PageHeader on each Page
#######################################################################
execute  pageHdr
execute  commonPageHdr
################################################################################# 
PAGEFOOTER

	execute  Line

################################################################################# 
#
#
#############################################################################
#
#   PROCEDURE BLOCK.
#   Procedure  itself is a Independent  Block  and  defined at the end of the
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#   Template File, Makes  it  Structured  and  avoids burring the same set of
#   codes at several places.
#
#############################################################################
#
#
PROCEDURE commonPageHdr
########################################################################
# PROCEDURE commonPageHdr
##############################################################################
begin
        nextline
	begin
	 if iptype = "A"
		print "Opened / closed  Accounts  Between  " size 142 center
	 if iptype= "O"
		print "Opened  Accounts  Between  " size 142 center
	 if iptype = "C"
		print "Closed Accounts  Between  " size 142 center
	end
	nextline
	print ipFrmDate column 60
	print " & "
	print ipToDate
        nextline
	print " ==========================================" size 142 center
        nextline
	nextline
	execute Line
	nextline
	execute pipe
	print "Schm Code" column 2
	print "A/C Number" column 17 
	print "Name" column 37 
	print "A/C Open Date" column 65 
	print "Operator" column 81 
   	print "A/C Close Date" column 105 
	print "Supervisor" column 125 
	nextline
	execute line
	nextline
end
PROCEDURE pageHdr
########################################################################
# PROCEDURE pageHdr
##############################################################################
begin
    	nextline
        print "Page No. "   column 105
        print page_number 
        nextline
        print today column 105 
        nextline
        nextline
	print "EQUITY BANK LIMITED" size 142 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 142 center
        set page_number= page_number+1
	nextline
end

PROCEDURE pipe
##############################################################################
#PROCEDURE pipe
##############################################################################

begin
	print "|"               column 1
        print "|"               column 16
        print "|"               column 36
        print "|"               column 64
        print "|"               column 80
        print "|"               column 104
	print "|"               column 124
	
end
####################################################################
PROCEDURE line
##############################################################################
#PROCEDURE line
##############################################################################

begin
 print "-------------------------------------------------------------------------------------------------------------------------------------------------"column 1
	
end
####################################################################
# End of File
######################################################################
