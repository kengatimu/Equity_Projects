# ******************************************************************
#    Report Name		: INTERFACE_Ttumupload.mrt
#  Product Ttumupload.mrt customized for TTUM THRU FI
# ******************************************************************

RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include      Ttumupload.mri  

LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
locTranId				stringType
count					numberType
callscript      			numbertype
lv_inpFileName				stringType

GROUPANDSORT
RecordNumber
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################

REPOSITORY bankRepos.rip readonly
	bankName		stringType
	branchName		stringType
	uniformBrCode	stringType
	branchDistrict	stringType
	branchState		stringType

REPOSITORY argv4
	reportTo		stringType
	tranSubType		stringType
	fireBftiFlg		stringType
	tranRemarks		stringType
	inpFileName		stringType
	renameInpFile	stringType
    errorRptFileName    stringType
    errorRecFileName    stringType
	page_number		numberType

MASSAGERECORD
IGNORERECORD

PAGEFORMAT
####################################################################
nopagefeed
linesperPage    9999
columnsperline  2000
topMargin        0
bottomMargin     0
leftMargin       0

ONSTARTOFREPORT
####################################################################

ONENDOFREPORT
###################################################################
set lv_inpFileName = inpFileName
set callscript = runscript "INTERFACE_TtumExeExecdp003.scr" "lv_inpFileName" "successFlg"

PAGEHEADER
###################################################################

ONEVERYRECORD 
###################################################################
print successOrfailure
print "|"
print tranId
print "|"
print tranDate
print "|"
print pTranSrlNum
print "|"
print errMesg
print "|"
print RecordNumber
print "|"
print InputRecord
