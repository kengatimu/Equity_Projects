#################################################################################

#**********************************************************************
#  DESC   :     Deposits Under Lien Report 
######################################################################
#
RECORDLAYOUT
####################################################################
#   
####################################################################
sol_id			stringType
foracid			stringtype
lien_amt		numbertype
receipt_number		stringtype	
acct_name		stringtype
deposit_amount		numbertype
maturity_date	        stringtype 	
lien_remarks		stringtype

LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
total_lien        numbertype
total_bal         numbertype
total_dep 	  numbertype
gr_total_lien	  numbertype
gr_total_bal	  numbertype
gr_total_dep	  numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType
#
#
GROUPANDSORT 
####################################################################
#   RECORDLAYOUT section.
####################################################################
sol_id
#
REPOSITORY bankRepos.rip
############################################################################
bankName        stringType
branchName      stringtype
REPOSITORY  argv4
#############################################################################

ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType

#############################################################################
#MASSAGERECORD
#############################################################################
#IGNORERECORD
#############################################################################
ONSTARTOFREPORT
#############################################################################
set total_lien = 0
set total_bal = 0

execute brBankHdg 
execute pageHdg
#
PAGEHEADER
############################################################################
#
execute brBankHdg 
execute pageHdg
#
#
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    66
columnsperline 	170 
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 7
pagefooterlines 4
#
AFTERBREAKOF sol_id
####################################################################
#AFTERBREAKOF
####################################################################
set total_lien = groupsum lien_amt 
set total_bal = groupsum deposit_amount
set total_dep = groupcount receipt_number
separatorline
print "Sub Total " 	 column 2
print total_lien		column 20
print total_bal 		column 85
separatorline

#
#
ONEVERYRECORD
####################################################################
# ONEVERYRECORD
####################################################################
print foracid column 1
print lien_amt column 20
print receipt_number column 40 
print acct_name column 55
print deposit_amount column 85
print maturity_date column 105
print lien_remarks column 125
#
#############################################################################
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
print "Pg:" column 2
print pagenumber column 5
print "of" column 7
print "<<TOP>>" column 10
nextline
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
     nextline
     separatorline
     set gr_total_lien = totalsum lien_amt
     set gr_total_bal = totalsum deposit_amount
     set gr_total_dep = totalcount receipt_number
     print " Grand Total" 		column 2
     print gr_total_lien 		column 20
     print gr_total_bal  		column 85 
     separatorline 
     nextline
end

begin
     print "printed by:"  size  85 center
     print  lv_userId column  55
     nextline
     nextline
     print "verified by:" size  85 center
  
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 170 center

end
#
#################################################################################
Procedure  pageHdg
#################################################################################

begin
     nextline
     print " DEPOSIT UNDER LIEN REPORT"  size  170 center 
     nextline
     print " DATE:   " column   75
     print today size 10 
     nextline
     nextline
      end

begin
     separatorline
     print "Lien A/C" column 1
     print "Lien Amnt" column 20
     print "Receipt No." column 40
     print "Acct Name." column 55
     print "Deposit Amt" column 85
     print "Maturity Date" column 105
     print "Reason" column 125
     separatorline
end
#
#
#############################################################################
PROCEDURE brBankHdg
#############################################################################

begin
     print "Page No. "   column  130 
     print page_number precision 0
     nextline
     print today column  130
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 170 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 170 center 
   end

####################################################################
# End of File
######################################################################
