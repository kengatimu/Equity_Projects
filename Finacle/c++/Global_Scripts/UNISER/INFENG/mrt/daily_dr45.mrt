#***************************************************************************************

#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
solid stringType
gndt stringType
svbals numberType
demdeps numberType
fixdeps numberType
bbals numberType
cbals numberType
lodisbal numberType
loanacs numberType
savinacs numberType
currenacs numberType
termdeps numberType
loanx numberType
savinx numberType
currenx numberType
termx numberType
totbals numberType
totacs numberType
acsclsd numberType
outbal numberType
interest numberType
penalintrst numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
savingsbal numbertype 
demanddeps numbertype 
termdepsts numbertype 
bankbals numbertype 
cashbals numbertype 
totbalances numbertype 
loanacopnd numbertype 
savinacopnd numbertype 
currentacopnd numbertype 
termacopnd numbertype 
totalacs numbertype 
accountsclsd numbertype 
loandisbamt numbertype 
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
#REPOSITORY argv4
#setId           stringtype
#asondate        stringType
#***************************************************************************************
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg

set savingsbal = 0
set demanddeps = 0
set termdepsts = 0
set bankbals = 0
set cashbals = 0
set totbalances = 0
set loanacopnd = 0
set savinacopnd = 0
set currentacopnd = 0
set termacopnd = 0
set totalacs = 0
set accountsclsd = 0
set loandisbamt = 0
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   65
columnsperline 80 
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13
pagefooterlines 4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
execute Line
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
begin
    set savingsbal = svbals + savingsbal 
end

begin
    set demanddeps = demdeps + demanddeps
end

begin
    set termdepsts = termdepsts + fixdeps
end

begin
    set bankbals = bankbals + bbals
end

begin 
    set cashbals = cashbals + cbals
end

begin
    set totbalances = totbalances + totbals
end

begin
    set loanacopnd = loanacopnd + loanacs 
end

begin
    set savinacopnd = savinacopnd + savinacs 
end

begin
     set currentacopnd = currentacopnd + currenacs 
end

begin
     set termacopnd = termacopnd + termdeps 
end

begin
     set totalacs = totalacs + totacs 
end

begin
    set accountsclsd = accountsclsd + acsclsd
end

begin
    set loandisbamt = loandisbamt + lodisbal
end
#**************************************************************************************
ONENDOFREPORT
#**************************************************************************************
begin
execute pipe
execute line
nextline
execute pipe
print "DEPOSITS" column 10 
nextline
execute pipe
print "SAVINGS BALANCE" column 10 
print savingsbal column 55 format "###,###,###.##"
nextline
execute pipe
print "DEMAND A/CS BALANCE" column 10 
print demanddeps column 55  format "###,###,###.##"
nextline
execute pipe
print "TERM DEPOSITS" column 10 
print termdepsts column 55 format "###,###,###.##"
nextline
execute pipe
print "BANK BALANCES" column 10 
print bankbals column 55 format "###,###,###.##"
nextline
execute pipe
print "CASH BALANCES" column 10 
print cashbals column 55 format "###,###,###.##"
nextline
execute pipe
print "TOTAL BALANCES" column 10 
print totbalances column 55 format "###,###,###.##"
nextline
execute pipe
separatorline
execute pipe
print "ACCOUNTS" column 10 
nextline
execute pipe
print "LOAN A/CS OPENED" column 10 
print loanacopnd column 55 format "###,###,###"
nextline
execute pipe
print "SAVING A/CS OPENED" column 10 
print savinacopnd column 55 format "###,###,###"
nextline
execute pipe
print "CURRENT A/CS OPENED" column 10 
print currentacopnd column 55 format "###,###,###"
nextline
execute pipe
print "TERM DEPOSITS OPENED" column 10 
print termacopnd column 55 format "###,###,###"
nextline
execute pipe
print "TOTAL A/CS OPENED" column 10 
print totalacs column 55 format "###,###,###"
nextline
execute pipe
print "ACCOUNTS CLOSED" column 10 
print accountsclsd column 55 format "###,###,###"
nextline
execute pipe
nextline
execute pipe
print "OTHER" column 10 
nextline
execute pipe
print "LOANS DISBURSED" column 10 
print loandisbamt column 55 format "###,###,###.##" 
separatorline
execute pipe
separatorline
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:_______________________________________" column 20
nextline
end
#**************************************************************************************
PROCEDURE Line

begin
    print "-------------------------------------------------------------------------------------------------------" column 2

end
#***************************************************************************************

PROCEDURE pipe

begin

        print "|"               column 1
        print "|"               column 40 
        print "|"               column 80 

end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
nextline
print "INSTITUTION:  EQUITY BANK LIMITED " column 5
print "DATE:" column  60 
print asondate column 60  size 10
nextline
nextline
print  "BRANCH    :"  column 5
#print branchName column 20
nextline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
print "daily_dr45.mrt" column  60 
nextline
print "POSITION REPORT" size 80 center
nextline
#print "_____________________________________" size 90 center
nextline
execute pipe
execute Line
nextline
execute pipe
print "PARTICULARS" column 15
print "AMOUNT" column 55  center size 20
execute pipe
end
#****************************************************************************************

