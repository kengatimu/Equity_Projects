#  This is the Mahareport for Balance Sheet Consolidated 
###############################################################################
RECORDLAYOUT
###############################################################################
samt							numbertype
foracid							stringtype
acct_name						stringtype
sol_id							stringtype	
schm_code						stringtype
flow_amt						numbertype
next_dmd_date						stringtype
clr_bal_amt						numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript      stringType
lv_setid        stringType
lv_setdesc      stringType
################################################################################
GROUPANDSORT
###############################################################################
REPOSITORY bankRepos.rip  
###############################################################################
REPOSITORY argv4
setId           stringtype
###############################################################################
PAGEFORMAT
##############################################################################
ColumnsPerLine  110 
LinesPerPage	5000	
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
##############################################################################
ONSTARTOFREPORT
############################################################################## 
print "EQUITY BANK" column 10 size 100 center
nextline
print "BRANCH : " column 50 
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc column 60 size 20
separatorline
print "DIFF"	column 01
print "A/C"	column 10
print "A/C NAME"	column 25 
print "SOL_ID"		column 50
print "SCHM_CODE"	column 57
print "FLOW_AMT"	column 68
print "NEXT_DMD_DATE"	column 79 
print "CLR_BAL_AMT"	column 93
separatorline
###############################################################################
IGNORERECORD
###############################################################################
if (samt = 0)
#############################################################################
ONEVERYRECORD
#############################################################################
print samt	column 01
print foracid 	column 10
print acct_name column 25
print sol_id	column 50
print schm_code column 57
print flow_amt  column 68
print next_dmd_date	column 79
print clr_bal_amt	column 93
###############################################################################
ONENDOFREPORT
###############################################################################
