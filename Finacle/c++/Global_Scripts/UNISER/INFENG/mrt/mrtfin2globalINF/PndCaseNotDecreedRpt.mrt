########################################################################
# Report Name   :   Report on details of cases 
# Template Name :   PndCaseNotDecreedRpt.mrt		
# Description   :   To print the cases handled by the advocates.
#   
#	Modification log
#   ----------------
#   Srl.No.     Date        Author            Version
#   ------   ----------     ------------    --------------
#       1       23/11/04    Jaya Lakhsmi        1.0
#
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include PndCaseNotDecreedRpt.mri
#

LOCALVARIABLES
srl_num numberType
localdate       numberType
localyears      numberType
#
GROUPANDSORT
crncyCode
suitStatus
custId
solId

#IGNORERECORD
#if (PastDueFlg = "N")

PAGEFORMAT
linesperpage 60
columnsperline 330
pageheaderlines 12 
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip readonly  
localYearsToAdd        stringType
#
REPOSITORY argv4
PAGE_NUMBER              numberType
crit_reportOption        stringType
crit_reportTo            stringType
crit_solSetId            stringType
crit_acctNum             stringType
crit_custId              stringType
crit_asOnDate            stringType
crit_fromDate      		 stringType
crit_toDate              stringType
crit_suitStatus          stringType
crit_courtOrTribunal     stringType
crit_rptCrncyCode        stringType
#
ONSTARTOFREPORT
#
set localyears = strToNum localYearsToAdd
set pageNumber = 1
set srl_num = 0 
nextline
nextline
nextline
print "REPORT ON DETAILS OF CASES PENDING BEFORE A COURT NOT DECREED" column 29
nextline
nextline
execute printCriteria
#
PAGEHEADER
  
  print "Page No."    column 80
  print pageNumber size 5 precision 0
  nextline
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "" column 80
  print " "
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "HH24:NN:SS"
  nextline
  nextline 
  print "REPORT ON DETAILS OF CASES PENDING BEFORE A COURT NOT DECREED" column 29
  nextline
  nextline 
  execute pageHeader
#
BEFOREBREAKOF crncyCode
set srl_num = 0
nextpage
#execute pageHeader
#
ONEVERYRECORD
#========================================================================
execute detailRecord
#
#==========================================================================
ONENDOFREPORT
#==========================================================================
    if(srl_num = 0)
    begin
        nextline
        nextline
        nextline
        nextline
        nextline
        print "  -----  NO RECORDS SELECTED FOR PRINTING  ---- " column 24
        nextline
    end
    nextline
    nextline
	print "*** " column 24
	print pageNumber size 3 column 30 precision 0
	print " PAGE(S) PRINTED. ****END OF REPORT****" size 40 column 34
    nextline
#
    set PAGE_NUMBER = pagenumber
#
#
#============================================================================
PROCEDURE pageheader
#=============================================================================
begin 
  	print "Currency   "          column   3
	print crncyCode 			 column   12
    nextline
    nextline
    separatorline
	print "Sl.no"                column   1
    print "CIF ID "              column   8
    print "Name of the party"    column  43
    print "Present Liability"    column  123
    print " Advocate "           column  143
    print "Suit No"              column  223
    print "Date of filing suit"  column  283
    print "Suit Status"          column  305
    print "Status Date"          column  318
	separatorline
  nextline
end 
#============================================================================
PROCEDURE detailRecord
#============================================================================
    nextline
	set srl_num = srl_num + 1
    print srl_num             column   1
    print custId              column   8
    print custName            column  43
	print abs liability       column  123  autocomma precision 2 size 17
    if (liability < 0 ) 
		print "Dr"
	if (liability > 0 ) 
		print "Cr"
	print advocate            column  143
    print suitNum             column  223
    set localdate = stringToDate  entrustDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 283
    print suitStatus          column  305
    set localdate = stringToDate  suitStatusDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 318

#============================================================================
#==========================================================================
PROCEDURE printCriteria
#==========================================================================
    nextLine
    nextLine
    separatorLine
    nextline
    nextline
    print   "SELECTION CRITERIA"              column 40
    nextline
    print   "-------------------"             column 40
    nextline
    nextline
    print   "Report To                : "     column 30
    print   crit_reportTo
    nextline
    print   "Set Id                   : "     column 30
    print   crit_solSetId
    nextLine
    print   "Account Num              : "     column 30
    print   crit_acctNum
    nextline
    print   "CIF ID                   : "     column 30
    print   crit_custId
    nextline
    print   "As on date               : "     column 30
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "From Date                : "     column 30
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextLine
    print   "To Date                  : "     column 30
    set localdate = stringToDate  crit_toDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "Suit Status              : "     column 30
    print   crit_suitStatus
	nextline
    print   "Judicial Authority       : "     column 30
	print   crit_courtOrTribunal
    nextline
    print   "Report Currency Code     : "     column 30
    print   crit_rptCrncyCode
	nextline
	nextline
    separatorLine
#============================ End Of File ================================
