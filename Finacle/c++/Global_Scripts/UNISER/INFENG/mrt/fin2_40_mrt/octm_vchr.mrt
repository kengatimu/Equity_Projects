RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include  octm_vchr.mri

LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
	localdate		numberType
	localyears		numberType
	credit_or_debit		stringType
	lv_tranrmks		stringType
	lv_billerrefnum		stringType
	lv_billeracctid		stringType
	lv_instrfour		stringType
	lv_instrfreetext5	stringType
	lv_freetext1		stringType
	lv_freetext2		stringType
	lv_freetext3		stringType
	lv_freetext4		stringType
	lv_freetext5		stringType
	lv_freetext6		stringType
	lv_freetext7		stringType
	callscript     		stringtype
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################


REPOSITORY bankRepos.rip readonly
#############################################################################
localYearsToAdd		stringType


REPOSITORY  argv4
PAGE_NUMBER 	numberType
#REPORT_TO should not be more than 30 chars
#REPORT_NAME should not be more than 50 chars
REPORT_TO		stringType
REPORT_NAME		stringType

IGNORERECORD
	
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
	LinesPerPage 64
	LeftMargin 1 
	rightMargin 1	
	Topmargin	2
	BottomMargin 2
	columnsPerLine 85
    pageHeaderLines	8
    pageFooterLines 4

ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
set localyears = strToNum localYearsToAdd


PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
	if rec_table ="OCI" 
	begin
		execute voucher_try 
	end
	if  rec_table="OCP"
	begin
		execute voucher_routine 
	end
ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
set PAGE_NUMBER = pageNumber
set REPORT_TO=""
set REPORT_NAME=""
#REPORT_TO should not be more than 30 chars
#REPORT_NAME should not be more than 50 chars

######################################################################
#  PROCEDURE BLOCK
######################################################################
PROCEDURE voucher_try
	nextline
	nextline
	print "EQUITY BANK LTD" size 40 center
	nextline
	nextline
	print "CHEQUE DEPOSIT SLIP" size 40 center
	nextline
	nextline
	print "BRANCH CODE: " column 1
	print zone_sol_id 
	nextline
	nextline
	print "CHEQUE NO: " column 1
	print instrmnt_num 
	nextline
	nextline
	print "VALUE DATE: " column 1
	print value_date 
	nextline
	nextline
	print "DRAWERS BANK: " column 1
	print bank_name 
	nextline
	nextline
	print "DRAWERS BRANCH: " column 1
	print br_name 
	set lv_instrfour = instr_freetext4
	set callscript = runscript "gethoccm.scr" "lv_instrfour" "lv_tranrmks|lv_billerrefnum|lv_billeracctid|lv_freetext1|lv_freetext2|lv_freetext3|lv_freetext4|lv_freetext5|lv_freetext6|lv_freetext7"
	nextline
	nextline
	print "Name: " column 1
	print lv_tranrmks
	nextline
	nextline
	print "Tax code/tax type: " column 1
	print lv_freetext3
	nextline
	nextline
	print "Tax Name: " column 1
	print lv_freetext4
	nextline
	nextline
	print "PaymentPeriod(From):" column 1
	print lv_freetext5
	nextline
	nextline
	print "PaymentPeriod(To):" column 1
	print lv_freetext6
	nextline
	nextline
PROCEDURE voucher_routine 
	print "ACCOUNT NUMBER: " column 1
	print acct_num 
	nextline
	nextline
	print "ACCOUNT NAME: " column 1
	print acct_name 
	nextline
	nextline
	print "CHEQUE DATE: " column 1
	set localdate = stringToDate  zone_date
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat ""
	nextline
	nextline
	print "CHEQUE AMOUNT: " column 1
	print inst_amt 
	nextline
	nextline
	print "PAID IN BY :________________" column 1
	nextline
	nextline
	print "THANK YOU FOR YOUR CONTINUED SUPPORT" column 1
	nextline
	nextline
	print "YOU WERE SERVED BY :" column 1
	print " "
	print user_id
	nextline
	print "DATE: " column 1
	set localdate = stringToDate  today 
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat ""
	nextline
	nextline
	nextline
######################################################################
