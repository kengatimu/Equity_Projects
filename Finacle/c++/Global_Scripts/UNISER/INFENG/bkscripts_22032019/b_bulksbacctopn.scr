#------------------------------------------------------------------------------------------------
#  Name            : b_bulksbacctopn.scr
#  Description     : This script will call SBA acctopening services to modify data present in custom table
#  Date            : 21-08-2014
#  Author          : Jane Ndirangu
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :  (Batch Job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             21-08-2014      Jane Ndirangu		Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="db66c7017f3cad63c81ca816fe9d5df5ff53193c41e3ff85c23a2435d25ecf0e"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBAAA") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBAAA",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUSTS","CPARAM", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.SBAAA.errMsg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) "
	sv_s = sv_s + " FROM CUSTOM.INT_CHANGE "
	sv_s = sv_s + " WHERE INT_CHANGE.entity_cre_flg='N' "
	sv_s = sv_s + " AND INT_CHANGE.sol_id= ?SVAR"
	sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
	#{
		CUSTS.SBAAA.errMsg = "DB ERROR!"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.custcount)
		IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s="foracid,solid|"
	sv_s = sv_s + " SELECT INT_CHANGE.foracid,sol_id "
	sv_s = sv_s + " FROM CUSTOM.INT_CHANGE "
	sv_s = sv_s + " WHERE INT_CHANGE.entity_cre_flg='N' "
	sv_s = sv_s + " AND INT_CHANGE.sol_id= ?SVAR"
	sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.SBAAA.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.SBAAA.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUSTS.SBAAA.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.SBAAA.solid	= BANCS.OUTPARAM.solid
			CUSTS.SBAAA.date	=MID$(BANCS.STDIN.BODDate,0,10)
			
			print(CUSTS.SBAAA.foracid)
			print(CUSTS.SBAAA.solid)
			print(CUSTS.SBAAA.date)
			
			sv_s="acct,acid,acctname,shortname|"
			sv_s = sv_s + " select foracid,acid,b.cust_name,b.cust_short_name"
			sv_s = sv_s + " FROM tbaadm.gam a,tbaadm.cmg b where a.cif_id=b.cif_id "
			sv_s = sv_s + " AND b.cif_id= ?SVAR AND a.bank_id=b.bank_id "
			sv_s = sv_s + " AND b.bank_id= ?SVAR"
			sv_s = sv_s + " AND a.schm_code='SB130'"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUSTS.SBAAA.foracid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				CUSTS.SBAAA.acid	= BANCS.OUTPARAM.acid
				PRINT(CUSTS.SBAAA.acid)
				CUSTS.SBAAA.acct	= BANCS.OUTPARAM.acct
				PRINT(CUSTS.SBAAA.acct)
				CUSTS.SBAAA.acctname	= BANCS.OUTPARAM.acctname
				PRINT(CUSTS.SBAAA.acctname)
				CUSTS.SBAAA.shortname	= BANCS.OUTPARAM.shortname
				PRINT(CUSTS.SBAAA.shortname)
				
			#}
			ENDIF
			
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account open services
			# urhk_SetUrhkInp is used to set inputs
			#--------------------------------------------------------------------------------------------------------------
			
			
			sv_u = urhk_SetUrhkInp("acct.foracid|" + CUSTS.SBAAA.acct)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acct.acid|" + CUSTS.SBAAA.acid)
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_FetchAALMRecordForModify|retain_all_output = Y")
			PRINT(sv_u)
			
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_SetUrhkInp("acct.foracid|" + CUSTS.SBAAA.acct)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acct.acid|" + CUSTS.SBAAA.acid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acct.acctName|" + CUSTS.SBAAA.acctname)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acct.acctShortName|" + CUSTS.SBAAA.shortname)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acid|" + CUSTS.SBAAA.acid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctName|" + CUSTS.SBAAA.acctname)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctShortName|" + CUSTS.SBAAA.shortname)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acct.crncyCode|RWF")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acct.solId|4011")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("cash_abnrml_amt_lim|500000.00|RWF")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("clg_abnrml_amt_lim|100000.00|RWF")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("xfer_abnrml_amt_lim|500000.00|RWF")
				PRINT(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyAALMRecordAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF(sv_u == 0) THEN
				#{
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					sv_s = "UPDATE CUSTOM.INT_CHANGE "
					sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'P',"
					sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
					sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
					sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUSTS.SBAAA.foracid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_u = system("echo 'Error for Acct:"+CUSTS.SBAAA.foracid+" ' >>opened.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>opened.log")
						print(sv_u)
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUSTS.SBAAA.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.SBAAA.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.SBAAA.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUSTS.SBAAA.errMsg+"' >>opened.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
