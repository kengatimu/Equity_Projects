	#- fetched using the userhook urhk_getEnv inorder to avoid hard coding
	#==============================================================================================================
	BANCS.INPARAM.UserApplId                = "FINCORE"
	BANCS.INPARAM.MESSAGEDATETIME       	= MID$(CUST.INTERFACE.sysDate,6,4)+"-" + BANCS.INPARAM.Month + "-" + BANCS.INPARAM.Day + "T"
	BANCS.INPARAM.MESSAGEDATETIME           = BANCS.INPARAM.MESSAGEDATETIME + BANCS.INPARAM.Hour + ":" + BANCS.INPARAM.Minute + ":"
	BANCS.INPARAM.MESSAGEDATETIME			= BANCS.INPARAM.MESSAGEDATETIME + BANCS.INPARAM.Second + ".000"
	BANCS.INPARAM.RequestUUID               = BANCS.INPARAM.UserApplId + BANCS.INPARAM.SYSDATE
	BANCS.INPARAM.CHANNELID                 = "COR"
	BANCS.INPARAM.TIMEZONE                  = "GMT+05:30"
	BANCS.INPARAM.BANKID                    = BANCS.STDIN.contextBankId
	BANCS.INPARAM.ServiceReqId              = CUST.INTERFACE.interfaceRequestID
	BANCS.INPARAM.SERVICEREQUESTVERSION     = CUST.INTERFACE.interfaceRequestVersion
	
	#==============================================================================================================
	#- BANCS.INPARAM.SERVICE_NAME is used as a identifier for fitcpip adapter. So always set this value to FIJCA
	#==============================================================================================================
	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	#==============================================================================================================
	#- SEND_RECV_FLG flag is used to determine the mode of operation. The Possible values can be S or R.
