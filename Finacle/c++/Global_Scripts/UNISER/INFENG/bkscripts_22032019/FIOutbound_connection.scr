	#==============================================================================================================
	#Appending the header XML and body XML.
	#==============================================================================================================
	CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=NVPSTR,MSG_SUB_TYPE=FINVP###"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "reqhdr.servicerequestversion^=^"+CUST.INTERFACE.interfaceRequestVersion+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.requestuuid^=^"+BANCS.INPARAM.RequestUUID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.servicerequestid^=^"+CUST.INTERFACE.interfaceRequestID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.origchannelid^=^"+BANCS.INPARAM.CHANNELID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.bankid^=^"+BANCS.INPARAM.BANKID+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^reqhdr.messagedatetime^=^"+BANCS.INPARAM.MESSAGEDATETIME+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^body^=^"+CUST.INTERFACE.bodyXMLMsg+"^"
	CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "|^billerId^=^"+CUST.UBP.billerId
	
	sv_a = CUST.INTERFACE.reqXMLMsg
	PRINT(sv_a)
	
	#==============================================================================================================
	#- Executing the userhook to make the Outbound Call
	#==============================================================================================================
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	IF (sv_l != 0) THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
