	BANCS.INPARAM.Day   	= LEFT$(CUST.INTERFACE.sysDate,2)
	BANCS.INPARAM.Month 	= MID$(CUST.INTERFACE.sysDate,3,2)
	BANCS.INPARAM.Year  	= MID$(CUST.INTERFACE.sysDate,8,2)
	BANCS.INPARAM.Hour  	= MID$(CUST.INTERFACE.sysDate,11,2)
	BANCS.INPARAM.Minute    = MID$(CUST.INTERFACE.sysDate,14,2)
	BANCS.INPARAM.Second    = MID$(CUST.INTERFACE.sysDate,17,2)
	BANCS.INPARAM.SYSDATE   = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour
	BANCS.INPARAM.SYSDATE	= BANCS.INPARAM.SYSDATE + BANCS.INPARAM.Minute + BANCS.INPARAM.Second
	print(BANCS.INPARAM.SYSDATE)
	
	#==============================================================================================================
	#- Assigning appropriate values for the input varaibles that are required for urhk_ConnectToFIAndSendMsg
