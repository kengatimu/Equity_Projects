<--START
CHECKSUM="0bf2198d493ce1c4820f0144599d00fdc5720d8afb6277959e3d6be95f7dae3b"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Bank id"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Bankid=BANCS.INPUT.Bankid
		print(CUST.DATA.Bankid)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Acctnum"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Account Number"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Acctnum=BANCS.INPUT.Acctnum
		print(CUST.DATA.Acctnum)
	#}
	ENDIF
	
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("eoddate"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply EOD Date ...Note date format DD-MON-YYYY"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.eoddate=BANCS.INPUT.eoddate
		print(CUST.DATA.eoddate)
	#}
	ENDIF
	
	############################################
	# Fetching the value from table
	############################################
	
	sv_q = "eodbalance| "
	sv_q = sv_q + " select TBAADM.commonpackage.eabbal(?SVAR,(select acid from tbaadm.gam where foracid=?SVAR AND bank_id=?SVAR),?SVAR) EodBalance from dual "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.eoddate
	
	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)
	
	IF (sv_p==0) THEN
	#{
		
		CUST.DATA.varValue1 = BANCS.OUTPARAM.eodbalance
		print (CUST.DATA.varValue1)
		sv_z = urhk_SetOrbOut("EOD_BALANCE|"+CUST.DATA.varValue1)
		print(sv_z)
		
		sv_e=urhk_SetOrbOut("StattusCode|1")
		#}
	ELSE
		#{
		CUST.DATA.errMsg="Data Error ...Note date format DD-MON-YYYY"
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	#}
	ENDIF
	
	End:
		EXITSCRIPT
		TRACE OFF
END-->
