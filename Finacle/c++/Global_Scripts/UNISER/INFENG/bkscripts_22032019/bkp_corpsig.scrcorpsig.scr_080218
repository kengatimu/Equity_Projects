<--START
CHECKSUM="9a1a7220e69862d2a1bdfcc1a15ae87196f086ba1f8674235a629625e13991c4"
	TRACE ON
	LIBNAME CUSTOMSO
	#export SVS_PATH=/finweb/InstallPath2/SVSBULK/SVSBulkUpload/lib
	sv_d = CLASSEXISTS("BANCS", "FAC")
	
	IF (sv_d == 0) THEN
	#{
		CREATECLASS("BANCS", "FAC", 5)
	#}
	ENDIF
	#=======================================================================================*
	# Create repository and class
	#=======================================================================================*
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CATOD") == 0) THEN
	#{
		CREATECLASS("CUST","CATOD",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	#------------------------------------------------------------
	# Initialiizing required variables
	#------------------------------------------------------------
	CUST.CATOD.errMsg = ""
	
	#-----------------------------------------------------------------
	# Getting Values From FrontEnd
	#-----------------------------------------------------------------
	CUST.CATOD.fileName     =       BANCS.INPUT.fileName
	CUST.CATOD.Function     =       BANCS.INPUT.funcCode
	
	print(CUST.CATOD.fileName)
	print(CUST.CATOD.Function)
	#=============================================================
	# Query to get only file name ( with out path )
	#=============================================================
	sv_s = "fileName1 |"
	sv_s = sv_s + " SELECT SUBSTR('"+ CUST.CATOD.fileName +"',instr('"+ CUST.CATOD.fileName +"' ,'\',-1)+1) "
	sv_s = sv_s + " FROM DUAL "
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0) THEN
	#{
		CUST.CATOD.fileName1 = BANCS.OUTPARAM.fileName1
		print(CUST.CATOD.fileName1)
		#}
	ELSE
		#{
		sv_e = "File is Missing"
		sv_m = "fileName"
		CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		print(CUST.CATOD.errMsg)
		GOTO FAILURE
	#}
	ENDIF
	
	#=============================================================
	# Query to check valid extensions(.txt)
	#=============================================================
	print(CUST.CATOD.fileName1)
	sv_b = "."
	sv_c = getposition(CUST.CATOD.fileName1, sv_b)
	print(sv_c)
	IF (sv_c!=CINT("0")) THEN
	#{
		sv_z = STRLEN(CUST.CATOD.fileName1)
		print(sv_z)
		sv_e = MID$(CUST.CATOD.fileName1,sv_c,sv_z)
		print(sv_e)
		CUST.CATOD.extn = sv_e
		print(CUST.CATOD.extn)
	#}
	ENDIF
	
	IF((CUST.CATOD.extn == "txt") OR (CUST.CATOD.extn == "TXT")) THEN
	#{
		print("extensions of filename is correct")
		#}
	ELSE
		#{
		sv_e = "Sorry.., Please enter only txt extension file for uploading"
		sv_m = "fileName"
		CUST.CATOD.errMsg  = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		print(CUST.CATOD.errMsg)
		GOTO FAILURE
	#}
	ENDIF
	
	#=============================================================
	# Calling script for transfering the file from Client PC to UNIX server
	#=============================================================
	#call("catodscoredp004.scr")
	call("corpsigFileUpld.scr")
	
	#-------------------------------------------------
	# To get location of the COM file .
	#-------------------------------------------------
	
	#sv_r = urhk_getFileLocation("COM|svsBulkupload.com")
	#sv_s = BANCS.OUTPARAM.fileLocation
	
	#sv_t = sv_s + "svsBulkupload.com "+BANCS.STDIN.userId + "!" + BANCS.STDIN.contextBankId + "!" + BANCS.STDIN.homeSolId + "!C!"
	#sv_t = sv_t + " &"
	#sv_u = SYSTEM(sv_t)
	
	BANCS.INPARAM.scriptName = "svsBulkupload.com"
	BANCS.INPARAM.arguments = BANCS.STDIN.userId + "!" + BANCS.STDIN.contextBankId + "!" + BANCS.STDIN.homeSolId + "!C!"
	sv_u = urhk_CallShellScript("b")
	IF(sv_u !=0) THEN
	#{
		sv_e = "RESULT_MSG|Signature Upload process Failed - Check Reports in HPR after sometime."
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_e = "RESULT_MSG|Signature Upload process Initiated - Check status in HPR after sometime."
	sv_u = urhk_SetOrbOut(sv_e)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
END-->
