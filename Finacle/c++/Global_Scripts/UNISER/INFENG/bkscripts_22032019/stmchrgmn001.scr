<--START
CHECKSUM="6adce9527d22aabb15f2ef1fab417906b526774cd516858c1a281d71a5406e58"
	TRACE ON
	#--------------------------------------------------------
	#Creating Repository and Classes
	#--------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","STMTCHRG") == 0) THEN
	#{
		CREATECLASS("CUST","STMTCHRG",5)
	#}
	ENDIF
	
	CUST.STMTCHRG.errMsg = ""
	CUST.STMTCHRG.moduleName = ""
	BANCS.INPUT.moduleName  = "STMTCHRGUPLOAD"
	CUST.STMTCHRG.moduleName = BANCS.INPUT.moduleName
	BANCS.INPUT.parameterId = "SOLID1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STMTCHRG.solId1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^solId1 setup not done in CPARAM^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "STMTCHRGUPLOAD"
	BANCS.INPUT.parameterId = "SOLID2"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STMTCHRG.solId2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^solId2 setup not done in CPARAM^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "STMTCHRGUPLOAD"
	BANCS.INPUT.parameterId = "ACCTNO1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STMTCHRG.acctNo1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.STMTCHRG.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Account No1 setup not done in CPARAM^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "STMTCHRGUPLOAD"
	BANCS.INPUT.parameterId = "ACCTNO2"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STMTCHRG.acctNo2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.STMTCHRG.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Account No2 setup not done in CPARAM^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "STMTCHRGUPLOAD"
	BANCS.INPUT.parameterId = "AMOUNTS"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STMTCHRG.amt = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.STMTCHRG.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Amount setup not done in CPARAM^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "STMTCHRGUPLOAD"
	BANCS.INPUT.parameterId = "TPATCLR"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STMTCHRG.tpatclr = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.STMTCHRG.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Transation Particular setup not done in CPARAM^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_getEnv("USER_PASS")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		print("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^User Id Password is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.STMTCHRG.userPass = BANCS.OUTPARAM.envValue
		print(CUST.STMTCHRG.userPass)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("CTL_PATH")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STMTCHRG.ctlFilePath = BANCS.OUTPARAM.envValue
		PRINT(CUST.STMTCHRG.ctlFilePath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("DATA_PATH")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Data file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STMTCHRG.CMFilePath = BANCS.OUTPARAM.envValue
		PRINT(CUST.STMTCHRG.CMFilePath)
		
		#----------TOL - 367144-------------#
		BANCS.INPUT.upldPath = CUST.STMTCHRG.CMFilePath
		#---------------------------------------------------------------
		# Calling common script to append userId to upload file path
		#---------------------------------------------------------------
		CALL("appendUserId.scr")
		CUST.STMTCHRG.CMFilePath = BANCS.INPUT.upldPath
		PRINT(CUST.STMTCHRG.CMFilePath)
		
	#}
	ENDIF
	
	sv_u = urhk_getEnv("FIN_REPORTS_DIR")
	print(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.STMTCHRG.rptPath = BANCS.OUTPARAM.envValue
		print(CUST.STMTCHRG.rptPath)
	#}
	ENDIF
	
	print(CUST.STMTCHRG.rptPath)
	CUST.STMTCHRG.fileName = BANCS.INPUT.upldFileName
	print(CUST.STMTCHRG.fileName)
	
	CUST.STMTCHRG.testMode = BANCS.INPUT.testMode
	print(CUST.STMTCHRG.testMode)
	
	CUST.STMTCHRG.tranRmks = BANCS.INPUT.tranRmks
	print(CUST.STMTCHRG.tranRmks)
	
	CUST.STMTCHRG.statementPostage = BANCS.INPUT.statementPostage
	print(CUST.STMTCHRG.statementPostage)
	#------------------------------------------------------------
	# Check whether the Mandatory fields entered
	#------------------------------------------------------------
	IF ( CUST.STMTCHRG.fileName == "" ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Enter the File Name^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ( CUST.STMTCHRG.testMode == "" ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Please Select the Test Field^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ( CUST.STMTCHRG.tranRmks == "" ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Enter the Tran Remarks field^tranRmks")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ( CUST.STMTCHRG.statementPostage == "") THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Please select S OR P^statementPostage")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------
	# Insert the record into the Upload Status table
	#-------------------------------------------------------------------
	sv_s = " filSrlNum "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT NVL(MAX(upld_srl_num),0) + 1 "
	sv_s = sv_s + " FROM CUSTOM.C_UPLD_EQT_TBL "
	sv_s = sv_s + " WHERE upld_file_name = ?SVAR "
	sv_s = sv_s + " AND process_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.STMTCHRG.fileName + "|" + CUST.STMTCHRG.moduleName
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0 ) THEN
	#{
		CUST.STMTCHRG.fileSrlNum = BANCS.OUTPARAM.filSrlNum
		print(CUST.STMTCHRG.fileSrlNum)
		#}
	ELSE
		#{
		CUST.STMTCHRG.fileSrlNum = "1"
		print(CUST.STMTCHRG.fileSrlNum)
	#}
	ENDIF
	
	sv_s = " INSERT INTO CUSTOM.C_UPLD_EQT_TBL "
	sv_s = sv_s + " ( "
	sv_s = sv_s + " upld_file_name, "
	sv_s = sv_s + " upld_srl_num, "
	sv_s = sv_s + " status, "
	sv_s = sv_s + " status_desc,"
	sv_s = sv_s + " tran_id, "
	sv_s = sv_S + " bank_id, "
	sv_s = sv_s + " rcre_time, "
	sv_s = sv_s + " rcre_user_id, "
	sv_s = sv_s + " del_flg, "
	sv_s = sv_s + " process_id "
	sv_s = sv_s + " ) "
	sv_s = sv_s + " VALUES "
	sv_s = sv_s + " ( "
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "'P',"
	sv_s = sv_s + "'Initial insertionion',"
	sv_s = sv_s + " '', "
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "sysdate,"
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "'N', "
	sv_s = sv_s + "?SVAR"
	sv_s = sv_s + " ) "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.STMTCHRG.fileName + "|" + CUST.STMTCHRG.fileSrlNum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.STMTCHRG.moduleName
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSQLWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		print(sv_d)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------
	# Executing the COM file to check whether the file is valid or not
	#------------------------------------------------------------------------
	sv_c = urhk_getFileLocation("COM|stmtchrgdp001.com")
	print(sv_c)
	IF(sv_c == 0) THEN
	#{
		CUST.STMTCHRG.comFileLocation = BANCS.OUTPARAM.fileLocation
		print(CUST.STMTCHRG.comFileLocation)
		#}
	ELSE
		#{
		CUST.STMTCHRG.errMsg = "Technical Error - Com file Not exists"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = CUST.STMTCHRG.comFileLocation + "stmtchrgdp001.com"
	print(sv_s)
	
	CUST.STMTCHRG.fileNamePath = CUST.STMTCHRG.CMFilePath + CUST.STMTCHRG.fileName
	print(CUST.STMTCHRG.fileNamePath)
	CUST.STMTCHRG.bankIdCom=BANCS.STDIN.contextBankId
	print(CUST.STMTCHRG.bankIdCom)
	
	sv_d = urex(sv_s,"file.dat",CUST.STMTCHRG.fileNamePath+"|"+CUST.STMTCHRG.bankIdCom+"|"+ CUST.STMTCHRG.fileName)
	#sv_d = urex(sv_s,"file.dat",CUST.STMTCHRG.fileNamePath)
	print(sv_d)
	
	IF(sv_d != 0 ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Technical Error in urex execution for checking file exist OR not^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	print(CUST.STMTCHRG.fileExist)
	
	IF(CUST.STMTCHRG.fileExist != "Y" ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^File Does not Exists in the Specific path^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------------------------
	# Delete the record from the statementchrgs table
	#-----------------------------------------------------------------------
	
	sv_s = "DELETE FROM CUSTOM.STATEMENTCHRGS"
	sv_s = sv_s + " WHERE bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	sv_d = urhk_dbSQLWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0 ) THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		print(sv_d)
	#}
	ENDIF
	
	#-----------------------------------------------------------
	# Using SQL Loader upload the file into CUSTOM.STMTCHRG table
	#-----------------------------------------------------------
	CUST.STMTCHRG.ctlFilePath = CUST.STMTCHRG.ctlFilePath + "stmtchrg.ctl"
	print(CUST.STMTCHRG.fileName)
	
	sv_b = "$ORACLE_HOME/bin/sqlldr " + CUST.STMTCHRG.userPass + "  control=" + CUST.STMTCHRG.ctlFilePath + " data=" + CUST.STMTCHRG.fileName
	print(sv_b)
	
	sv_a = SYSTEM(sv_b)
	print(sv_a)
	
	IF(sv_a != 0 ) THEN
	#{
		#	CUST.STMTCHRG.errMsg = "Technical Error - Com file for loading a file"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Technical Error - Com file for loading a file^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------
	# Executing the com file to generate the file and executing TTUM exe
	#------------------------------------------------------------------
	sv_u = urhk_getFileLocation("COM|stmtchrgmn001.com")
	print(sv_u)
	IF( sv_u == 0 ) THEN
	#{
		CUST.STMTCHRG.comFilePath = BANCS.OUTPARAM.fileLocation
		print(CUST.STMTCHRG.comFilePath)
	#}
	ENDIF
	
	
	CUST.STMTCHRG.comFilePath = CUST.STMTCHRG.comFilePath + "stmtchrgmn001.com"
	print(CUST.STMTCHRG.comFilePath)
	print(CUST.STMTCHRG.fileName)
	print(CUST.STMTCHRG.rptPath)
	
	IF (CUST.STMTCHRG.rptPath == "") THEN
	#{
		CUST.STMTCHRG.rptPath = "1"
	#}
	ENDIF
	
	
	IF(CUST.STMTCHRG.statementPostage == "S" ) THEN
	#{
		sv_a = CUST.STMTCHRG.comFilePath + " stmtchrgmn001.sql " + BANCS.STDIN.contextBankId + " "+CUST.STMTCHRG.rptPath
		sv_a = sv_a + " " + CUST.STMTCHRG.fileName + " " + BANCS.STDIN.userId + " " + CUST.STMTCHRG.acctNo1
		sv_a = sv_a + " " + CUST.STMTCHRG.amt + " " + CUST.STMTCHRG.tpatclr + " " + BANCS.STDIN.homeCrncyCode + " " + CUST.STMTCHRG.solId1
		sv_a = sv_a + " " + CUST.STMTCHRG.solId2 + " " + CUST.STMTCHRG.testMode + " " + CUST.STMTCHRG.fileNamePath
		print(sv_a)
		#}
	ELSE
		#{
		sv_a = CUST.STMTCHRG.comFilePath + " stmtchrgmn002.sql " + BANCS.STDIN.contextBankId + " "+CUST.STMTCHRG.rptPath
		sv_a = sv_a + " " + CUST.STMTCHRG.fileName + " " + BANCS.STDIN.userId + " " + CUST.STMTCHRG.acctNo2
		sv_a = sv_a + " " + CUST.STMTCHRG.amt + " " + CUST.STMTCHRG.tpatclr + " " + BANCS.STDIN.homeCrncyCode + " " + CUST.STMTCHRG.solId1
		sv_a = sv_a + " " + CUST.STMTCHRG.solId2 + " " + CUST.STMTCHRG.testMode + " " + CUST.STMTCHRG.fileNamePath
		print(sv_a)
	#}
	ENDIF
	#sv_b = SYSTEM(sv_a)
	sv_b = SYSTEM(sv_a+" &")
	print(sv_b)
	
	IF(sv_b != 0 ) THEN
	#{
		CUST.STMTCHRG.errMsg = "Technical Error - Com file for generating a file"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Upload Initiated successfully "
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		exitscript
		
END-->
