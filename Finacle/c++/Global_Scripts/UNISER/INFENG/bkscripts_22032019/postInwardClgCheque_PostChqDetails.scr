<--START
TRACE ON

IF(CLASSEXISTS("CUST","GCHRG")==0) THEN
#{
	CREATECLASS("CUST","GCHRG",5)
#}
ENDIF

CUST.INTERFACE.showError = ""
CUST.INTERFACE.callFlg = ""
CUST.INTERFACE.parameterId = ""
CUST.INTERFACE.InwdEventId = ""
CUST.INTERFACE.chrgAmt = ""
CUST.INTERFACE.tranId = ""
print(CUST.INTERFACE.InstType)
IF(CUST.INTERFACE.DrAcct != CUST.INTERFACE.CrAcct)THEN
#{
	CUST.INTERFACE.showError = "Y"
#}
ENDIF


IF (CUST.INTERFACE.InstType == "CHQ") THEN
#{
	
	#-------------------------------------------------------------------------------
	# Setting inputs and outputs for SRV_AddTransferTran.
	#-------------------------------------------------------------------------------
	sv_a = urhk_SetUrhkInp("tranDtl.deliveryChannelId|" + CUST.INTERFACE.ChannelId)
	print(sv_a)
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_a = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")

	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	sv_a = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_a = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")

	#-------------------------------------------------------------------------------
	# Debit Leg.
	#-------------------------------------------------------------------------------

	#-------------------------------------------------------------------------------
	#Added code for Dr Tran Particulars 2
	#-------------------------------------------------------------------------------

	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
	#sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + CUST.INTERFACE.TranDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
	#sv_a = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
	sv_a = urhk_SeturhkInp("tranDtl.partTranDetailLL.<rec_0>.grantTodFlg|" + CUST.INTERFACE.TODFlag)
	print(CUST.INTERFACE.PostingCode)
	
	IF((CUST.INTERFACE.PostingCode == "000") OR (CUST.INTERFACE.PostingCode == "100")) THEN
	#{
		print("Inside  here in case of normal and force posting")
		print(CUST.INTERFACE.InstDate)
		sv_a = urhk_SeturhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntDate|" + CUST.INTERFACE.InstDate)
		print(sv_a)
		print(CUST.INTERFACE.InstNum)
		sv_a = urhk_SeturhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntNum|" + CUST.INTERFACE.InstNum)
		print(sv_a)
		print(CUST.INTERFACE.InstType)
		sv_a = urhk_SeturhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntType|"+ CUST.INTERFACE.InstType)
		print(sv_a)
		sv_a = urhk_SeturhkInp("tranDtl.partTranDetailLL.<rec_0>.instrmnt.instrmntAlpha|!")
		print(sv_a)
	#}
	ENDIF

	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|" + CUST.INTERFACE.DrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|" + CUST.INTERFACE.DrTranAmt + "|" + CUST.INTERFACE.DrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranAmt|" + CUST.INTERFACE.DrTranAmt + "|" + CUST.INTERFACE.DrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|" + CUST.INTERFACE.DrAcct)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|" + BANCS.STDIN.BODDate)

	IF(FIELDEXISTS(CUST.INTERFACE.DrRemarks) == 1) THEN
	#{
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|" + CUST.INTERFACE.DrRemarks)
		print(sv_a)
	#}
	ENDIF

	IF(FIELDEXISTS(CUST.INTERFACE.DrTranPart) == 1) THEN
	#{
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|" + CUST.INTERFACE.DrTranPart)
	#}
	ENDIF

	IF(FIELDEXISTS(CUST.INTERFACE.DrTranPart2) == 1) THEN
	#{
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars2|" + CUST.INTERFACE.DrTranPart2)
	#}
	ENDIF

	CUST.INTERFACE.srNo = CINT("2")
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_a = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")

	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|" + CUST.INTERFACE.TransactionType)
	sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)

	#-------------------------------------------------------------------------------
	# Credit Leg.
	#-------------------------------------------------------------------------------

	#-------------------------------------------------------------------------------
	#Added code for Cr Tran Particulars 2
	#-------------------------------------------------------------------------------

	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|" + CUST.INTERFACE.srNo)
	#sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + CUST.INTERFACE.TranDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
	#sv_a = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|" + CUST.INTERFACE.srNo)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|" + CUST.INTERFACE.CrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|" + CUST.INTERFACE.CrTranAmt + "|" + CUST.INTERFACE.CrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranAmt|" + CUST.INTERFACE.CrTranAmt + "|" + CUST.INTERFACE.CrTrCrncy)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|" + CUST.INTERFACE.CrAcct)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|" + BANCS.STDIN.BODDate)
	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|" + CUST.INTERFACE.CrRemarks)

	IF(FIELDEXISTS(CUST.INTERFACE.CrTranPart) == 1) THEN
	#{
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|" + CUST.INTERFACE.CrTranPart)
	#}
	ENDIF

	IF(FIELDEXISTS(CUST.INTERFACE.CrTranPart2) == 1) THEN
	#{
		sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars2|" + CUST.INTERFACE.CrTranPart2)
	#}
	ENDIF


	sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|" + CUST.INTERFACE.TranRefNum)

	#-------------------------------------------------------------------------------
	# TOD Details
	#-------------------------------------------------------------------------------

	IF(CUST.INTERFACE.TODFlag == "Y") THEN
	#{
		sv_s = "advType,advCatg|select DISCRET_ADVN_TYPE,DISCRET_ADVN_CATGR "
		sv_s = sv_s + " from tbaadm.DAR where DAT_REF_TYPE = 'IN' "
		sv_s = sv_s + " and schm_code = '" + CUST.INTERFACE.DrSchmCode + "'"
		sv_s = sv_s + " and bank_id = '" + BANCS.STDIN.contextBankId + "'"
		sv_s = sv_s + " and del_flg != 'Y'"
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)

		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.advType = BANCS.OUTPARAM.advType
			CUST.INTERFACE.advCatg = BANCS.OUTPARAM.advCatg
		#}
		ELSE
		#{
			CUST.INTERFACE.advType = ""
			CUST.INTERFACE.advCatg = ""
		#}
		ENDIF

		sv_a=urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.discreteAdvnType.code|"+CUST.INTERFACE.advType)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.discreteAdvnCatgr.code|"+CUST.INTERFACE.advCatg)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.grantDate|" + BANCS.STDIN.BODDate)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.expiryDate|" + BANCS.STDIN.BODDate)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.acct.foracid|" + CUST.INTERFACE.DrAcct)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.acct.crncyCode|" + CUST.INTERFACE.DrTrCrncy)
		sv_a = CUST.INTERFACE.TODAmount
		sv_a = format$(CDOUBLE(sv_a),"%17.2f")
		sv_a = sv_a + "|" + CUST.INTERFACE.DrTrCrncy
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.todAmtToBeGrntd|" + sv_a)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.todLevIntFlg|N")
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.permittedBy.userId|" + BANCS.STDIN.userId)
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.todEventType.type|TODIN")
		sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.instantTodDtl.todBasicDtl.penalDate|" + BANCS.STDIN.BODDate)
	#}
	ENDIF

	#-------------------------------------------------------------------------------
	# Execution of Service.
	#-------------------------------------------------------------------------------
	sv_a = urhk_ExecSrvNoCommit("SRV_CreateAndPostTransferTran|retain_all_output = Y")
	print(sv_a)
	IF(sv_a != "0") THEN
	#{
		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ELSE
	#{
		CUST.INTERFACE.tranId = BANCS.OUTPARAM.tranId
		print(CUST.INTERFACE.tranId)
		CUST.INTERFACE.TranDate = BANCS.OUTPARAM.tranDate
		print(CUST.INTERFACE.TranDate)
	#}
	ENDIF
	
	IF(CUST.INTERFACE.tranId != "") THEN
	#{	
		#-------------------------------------------------------------------------------
		# Collecting charges for all entities except Rwanda.
		#-------------------------------------------------------------------------------
		#IF(BANCS.STDIN.contextBankId == "50")THEN
		#{
		#	GOTO ENDOFSCRIPT
		#}
		#ENDIF
	  
		#-----------------------------------------------------------------------------------------------
		#Getting event id from cparam setup
		#-----------------------------------------------------------------------------------------------
		BANCS.INPUT.moduleName = "VERACIOUS"
		###################
			
		BANCS.INPUT.parameterId = "INWD_CHRG_EVENT"
		sv_s = "COUNT|SELECT COUNT(1) FROM CUSTOM.ACCT_EXEMPTION_TABLE "
		sv_s = sv_s + " WHERE FORACID = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR and EXEMPT_CODE in ('ACCT','LDFEE','INWARD','INWDEXEMPT') "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.DrAcct + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u =  urhk_dbSelectWithBind(sv_s)
		IF(sv_u == 0) THEN
		#{ 
			PRINT(BANCS.OUTPARAM.COUNT)
			IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
			#{
				sv_d = "EXCOUNT|SELECT COUNT(*) FROM CUSTOM.ACCT_EXEMPTION_TABLE "
				sv_d = sv_d + " WHERE FORACID = ?SVAR "
				sv_d = sv_d + " AND bank_id = ?SVAR and EXEMPT_CODE in ('INWDEXEMPT') "
				PRINT(sv_d)
				BANCS.INPARAM.BINDVARS = CUST.INTERFACE.DrAcct + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_c =  urhk_dbSelectWithBind(sv_d)
				IF(sv_c == 0) THEN
				#{ 
					CUST.INTERFACE.EXCOUNT = CINT(BANCS.OUTPARAM.EXCOUNT)
					PRINT(CUST.INTERFACE.EXCOUNT)

					IF (CUST.INTERFACE.EXCOUNT > 0) THEN
					#{
						BANCS.INPUT.parameterId = "INWD_CHRG_EVENTCH"
						print("new charge")
					#}				
					ELSE
					#{
					GOTO WAIVECHRG
					#}
					ENDIF
				#}
				ENDIF
			#}
			ELSE
			#{
				BANCS.INPUT.parameterId = "INWD_CHRG_EVENT"
				print("normal charge")
			#}
			ENDIF
		#}
		ELSE
		#{
			BANCS.INPUT.parameterId = "INWD_CHRG_EVENT"
		#}
		ENDIF

		###################
		
		
		CALL ("getcparamvalue.scr")
		print(BANCS.OUTPUT.parameterVal)

		IF(BANCS.OUTPUT.parameterVal != "")THEN
		#{
			CUST.INTERFACE.InwdEventId= BANCS.OUTPUT.parameterVal
			CUST.INTERFACE.chrgAmt = ""
		#}
		ELSE
		#{
			CUST.INTERFACE.errorCode = "ERR116"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ENDIF

		BANCS.INPARAM.BINDVARS = "GCHRG" + "|" + CUST.INTERFACE.InwdEventId + "|" + BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_q = "fxdAmt|selecT a.fixed_amt from  "
		sv_q = sv_q + " tbaadm.ptt p ,tbaadm.adm a "
		sv_q = sv_q + " where p.AMT_DERV_SRL_NUM = a.AMT_DRV_SRL_NUM "
		sv_q = sv_q + " and p.event_type = ?SVAR "
		sv_q = sv_q + " and p.event_id = ?SVAR and p.bank_id = ?SVAR "
		sv_q = sv_q + " and a.bank_id = ?SVAR "
		print(sv_q)
		sv_s = urhk_dbSelectWithBind(sv_q)
		
		if(sv_s == 0 ) THEN
		#}
			CUST.INTERFACE.chrgAmt = BANCS.OUTPARAM.fxdAmt
			print(CUST.INTERFACE.chrgAmt)
		#}
		ELSE
		#{	Charge setup is not done
			CUST.INTERFACE.errorCode = "ERR116"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ENDIF
		
		####################################################################
		# GRANT TOD
		####################################################################
		
		print(CUST.INTERFACE.InwdEventId)
		#-----------------------------------------------------------------------------------------------
		#Assigning debit account and eventid details
		#-----------------------------------------------------------------------------------------------
		CUST.GCHRG.drAcctId		= CUST.INTERFACE.DrAcct
		CUST.GCHRG.acctCrncyCode	= BANCS.STDIN.homeCrncyCode
		CUST.GCHRG.eventId		= CUST.INTERFACE.InwdEventId
		CUST.GCHRG.chrgAmt		= CUST.INTERFACE.chrgAmt
		CUST.GCHRG.tranType		= "T"
		CUST.GCHRG.tranSubType		= "BI"

		#-----------------------------------------------------------------------------------------------
		#Collecting charges using gchrg services
		#-----------------------------------------------------------------------------------------------
		#CALL("gchrgcommon.scr")
		CALL("postInwardClgCheque_CollChrg.scr")
		IF(CUST.GCHRG.successOrFailure == "S") THEN
		#{
			print(CUST.GCHRG.tranId)
			CUST.INTERFACE.chrgAmt = CUST.GCHRG.chrgAmt
		
		#}
		ELSE
		#{
			print(CUST.GCHRG.gchrgErrMsg)
			CUST.INTERFACE.srvErrFlg = "Y"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ENDIF
	  #}
	  ENDIF
#}
ENDIF

WAIVECHRG:

IF ((CUST.INTERFACE.InstType == "BC") OR (CUST.INTERFACE.InstType == "DIV")) THEN
#{
	print(CUST.INTERFACE.DDPayeeBnk)
	print(CUST.INTERFACE.DDPayeeBr)
	
	print(CUST.INTERFACE.issuBrCode)
	print(CUST.INTERFACE.issuBnkCode)
	print(CUST.INTERFACE.issuExtnCode)
	
	print(CUST.INTERFACE.InstNum)
	CUST.INTERFACE.InstNum = trim(CUST.INTERFACE.InstNum)
	print(CUST.INTERFACE.InstNum)
	#-------------------------------------------------------------------------------

	# Setting inputs and outputs for SRV_AddDDMassPmt.

	#-------------------------------------------------------------------------------

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.tranSubType.tranType|" + CUST.INTERFACE.TransactionType)
	
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.tranSubType.tranSubType|" + CUST.INTERFACE.TransactionSubType)
	
	sv_a = urhk_SetUrhkInp("ddMassPmtMiscDtl.ignoreXcpnsFlg|Y")

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.eventType|DDMP")

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddInstrmnt.instrmntNum|" + CUST.INTERFACE.InstNum)

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddInstrmnt.instrmntType|"+CUST.INTERFACE.InstType)

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddInstrmnt.instrmntDate|" + CUST.INTERFACE.MCIssueDate + " 00:00:00")

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddInstrmnt.instrmntDesc|BANKERS CHEQUE")

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeName|" + CUST.INTERFACE.PayeeName)
	
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddAcct.foracid|"+CUST.INTERFACE.DrAcct)

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddAcct.crncyCode|"+ CUST.INTERFACE.DrTrCrncy)

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeAcct.foracid|"+ CUST.INTERFACE.CrAcct)

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.valueDate|" + BANCS.STDIN.BODDate)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.key.serial_num|0")

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.key.srlNum|0")

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.ddAcct.foracid|" + CUST.INTERFACE.DrAcct)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.ddAcct.crncyCode|" + CUST.INTERFACE.DrTrCrncy)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.ddAmt|" + CUST.INTERFACE.DrTranAmt + "|" + CUST.INTERFACE.DrTrCrncy) 

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.ddInstrmnt.instrmntDate|" + CUST.INTERFACE.MCIssueDate + " 00:00:00")
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.ddInstrmnt.instrmntType|"+ CUST.INTERFACE.InstType)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.ddInstrmnt.instrmntNum|" + CUST.INTERFACE.InstNum)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.issBr.bankCode|" + CUST.INTERFACE.issuBnkCode)
	
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.issBr.brCode|" + CUST.INTERFACE.issuBrCode)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.delFlg|N")

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.issExtnCntrCode|" + CUST.INTERFACE.issuExtnCode)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.payeeAcct.foracid|" + CUST.INTERFACE.CrAcct)

	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_0>.ddPmtDtl.payeeName|" + CUST.INTERFACE.PayeeName)
	
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeRateCode.refCode|TTB")

	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeRate|1.00")
	
	sv_a = urhk_SetUrhkOut("ddMassPmtHdr.tranId|tranId")
	
	sv_a = urhk_SetUrhkOut("ddMassPmtHdr.tranDate|TranDate")

	#-------------------------------------------------------------------------------
	# Execution of Service.
	#-------------------------------------------------------------------------------
	sv_a = urhk_ExecSrvNoCommit("SRV_AddDDMassPmtDtl|same_user_verify = Y|retain_all_output = Y|call_mode = N")
	print(sv_a)
	IF(sv_a != "0") THEN
	#{
		print(BANCS.OUTPARAM.Error_num)

		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
						
	#}
	ELSE
	#{
		CUST.INTERFACE.tranId = BANCS.OUTPARAM.tranId
		print(CUST.INTERFACE.tranId)
		### The variable will hold the TranDate from the previous SRV Call to SRV_AddDDMassPmtDtl ##
		CUST.INTERFACE.TranDate = BANCS.OUTPARAM.TranDate
		print(CUST.INTERFACE.TranDate)
	#}
	ENDIF

	sv_a = urhk_CopyOutToIn("")
	print(sv_a)
	lv_u = urhk_SetUrhkInp("ddMassPmtHdr.tranDate|" + CUST.INTERFACE.TranDate)
	lv_u = urhk_SetUrhkInp("ddMassPmtHdr.tranId|" + CUST.INTERFACE.tranId)

	sv_n = urhk_ExecSrvNoCommit("SRV_FetchDDMassPmtDtlForPost|retain_all_output = Y")
	print(sv_n)
	IF(sv_n != "0") THEN
	#{
		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF

	##-------------------------------------------------------------------------------
	#  Copying all fetched outputs as inputs for other services
	##-------------------------------------------------------------------------------
	BANCS.INPARAM.SourceStr = ""
	BANCS.INPARAM.ReplaceStr = "ddMassPmtDtl"
	lv_a = urhk_CopyOutToInDiffStruct("")
	print(lv_a)

	lv_n = urhk_ExecSrvNoCommit("SRV_CreateTranForDDMassPmt|retain_all_output = Y|call_mode = N")
	print(lv_n)
	IF(lv_n == 1) THEN
	#{
		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF

	lv_u = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranDate|" + CUST.INTERFACE.TranDate)
	lv_u = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranId|" + CUST.INTERFACE.tranId)
	lv_u = urhk_SetUrhkInp("tranDetail.ignoreXcpnFlg|N")
	lv_n = urhk_ExecSrvNoCommit("SRV_PostAnEnteredTransaction|retain_all_output = Y|same_user_verify = Y|call_mode = N")
	print(lv_n)
	IF(lv_n != 0 ) THEN
	#{
		print("SRV_PostAnEnteredTransaction execution failed")
                sv_a = urhk_CopyOutToIn("")
                PRINT(sv_a)

                sv_a = urhk_ExecSrvNoCommit("SRV_PostAnEnteredTransaction|same_user_verify = Y|call_mode = N")
                print(sv_a)

		IF(sv_a != 0) THEN
                #{
			CUST.INTERFACE.srvErrFlg = "Y"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
                #}
                ENDIF
	#}
	ENDIF
	
	CUST.INTERFACE.TranDate = MID$(CUST.INTERFACE.TranDate,0,10)

#} 
ENDIF

