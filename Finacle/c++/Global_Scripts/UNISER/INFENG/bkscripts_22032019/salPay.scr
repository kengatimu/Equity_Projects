<--start
trace on

##################################################################
#	Tran definition starts
##################################################################

BANCS.INPARAM.PostTranFlg="Y"
BANCS.INPARAM.CommitFlg="Y"
BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
BANCS.INPARAM.ErrorCheckForLuw="Y"
BANCS.INPARAM.CheckExceptions="Y"
BANCS.INPARAM.InsertTranWithValidnFlg="N"

sv_r = urhk_MTTS_PopulateInputDetails("")

if(sv_r != 0) then
    BANCS.OUTPUT.successOrFailure = "F"
    BANCS.OUTPUT.scriptError = "urhk_MTTS_PopulateInputDetails returns FAILURE"
    exitscript
endif

MTT.TranDetails.TranDate="0"
MTT.TranDetails.TranType="T"
MTT.TranDetails.TranSubType="BI"
MTT.TranDetails.IgnoreExcp="Y"
MTT.TranDetails.Remarks="SalPay"
MTT.TranDetails.Consolidate="Y"
MTT.TranDetails.sysTranCode = "LOANAA052"

sv_n = urhk_MTTS_DefineTransaction("AcctTransfer")

##################################################################
sv_x=0
while (sv_x < 1)
    sv_a = CDOUBLE(MTT.InputDetails.creditAmt)
       if(sv_a != 0) then
            sv_b = MTT.InputDetails.debitAcctNo
            sv_c = MTT.InputDetails.operAcctNo
            sv_f = MTT.InputDetails.creditCrcyCode

            if((sv_b != "") and (sv_c != ""))then
                # Credit Part Tran
                MTT.PartTranDetails.RefAmount = (sv_a)
                MTT.PartTranDetails.Account = sv_c
                MTT.PartTranDetails.RefCurrency = sv_f
                MTT.PartTranDetails.ValueDate = MTT.InputDetails.dateDiff
				MTT.PartTranDetails.GlDate=MTT.InputDetails.glDateDiff
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = "AcctTransfer"
                MTT.PartTranDetails.PTranBusinessType="NONE"
				#Frontend field name is Particulars hence putting the value in tranParticulars instead of Remarks. 
		print(MTT.InputDetails.tranParticulars)
		print(MTT.InputDetails.tranRemarks)
                MTT.PartTranDetails.Particulars=MTT.InputDetails.tranParticulars
                MTT.PartTranDetails.Remarks=MTT.InputDetails.tranRemarks
				MTT.PartTranDetails.sysPartTranCode = "PTRN00771"
 
                # Call to common script to modify tran particulars if script is present
                MTT.PartTranDetails.ScriptEventType = "CRTRA"
                sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				
                if (sv_m == 0) then
                    call("getMTTTranPart.scr")
                endif

                sv_r = urhk_MTTS_DefinePartTran("SalPayCr")

                # Debit Part Tran
                MTT.PartTranDetails.RefAmount = -(sv_a)
                MTT.PartTranDetails.Account = sv_b
                MTT.PartTranDetails.RefCurrency = sv_f
                MTT.PartTranDetails.ValueDate = MTT.InputDetails.dateDiff
				MTT.PartTranDetails.GlDate=MTT.InputDetails.glDateDiff
                MTT.PartTranDetails.Consolidate = "Y"
                MTT.PartTranDetails.TranIdentifier = "AcctTransfer"
                MTT.PartTranDetails.PTranBusinessType="NONE"
                MTT.PartTranDetails.Particulars=""
                MTT.PartTranDetails.Remarks=MTT.InputDetails.tranRemarks
				MTT.PartTranDetails.sysPartTranCode = "PTRN00772"

				if(MTT.InputDetails.scrOAPFlg == "Y") then
				   MTT.PartTranDetails.Refnum          = MTT.InputDetails.referenceNo
                   MTT.OAPAddnlDetails.OffsetAmount    = MTT.InputDetails.oaptotSalCrAmt
                   MTT.OAPAddnlDetails.OrgTranID       = MTT.InputDetails.tranId
                   MTT.OAPAddnlDetails.OrgTranDate     = MTT.InputDetails.tranDate
                   MTT.OAPAddnlDetails.OrgPartTran     = MTT.InputDetails.partTranSrlNo 
                endif

                # Call to common script to modify tran particulars if script is present
                MTT.PartTranDetails.ScriptEventType = "CRTRA"
                sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				
                if (sv_m == 0) then
                    call("getMTTTranPart.scr")
                endif

                sv_r = urhk_MTTS_DefinePartTran("SalPayDr")
            endif
        endif
		sv_r = urhk_MTTS_EndDefinition("")
		sv_x = urhk_MTTS_PopulateInputDetails("")
		DO

sv_r = urhk_MTTS_EndDefinition("")

#trace off
end-->
