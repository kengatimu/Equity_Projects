		BANCS.INPARAM.BINDVARS = CUST.TRANVAL.tranId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF (sv_d == 0) THEN
		#{
			IF (CINT(BANCS.OUTPARAM.count) > 0) THEN
			#{
				IF (BANCS.STDIN.userWorkClass < "500") THEN
				#{
					CUST.TRANVAL.errMsg = "DELETING SYSTEM SERIAL NOT ALLOWED."
					PRINT(CUST.TRANVAL.errMsg)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	#############################restricting deletion of transactions below 150#############################
	sv_s = "count|SELECT count(1) FROM TBAADM.DTD "
	sv_s = sv_s + " WHERE DTD.tran_id =?SVAR "
	sv_s = sv_s + " AND DTD.entry_user_id !='SYSTEM'"
	sv_s = sv_s + " AND DTD.pstd_flg = 'N' "
	sv_s = sv_s + " AND DTD.del_flg='N' "
	sv_s = sv_s + " AND DTD.bank_id=?SVAR "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.TRANVAL.tranId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	sv_q = urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_q)
	
	IF (sv_d == 0) THEN
	#{
		IF (CINT(BANCS.OUTPARAM.count) > 0) THEN
		#{
			IF (BANCS.STDIN.userWorkClass < "150") THEN
			#{
				CUST.TRANVAL.errMsg = "Only workclass 150 OR above can delete transactions."
				PRINT(CUST.TRANVAL.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		IF (CUST.TRANVAL.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.TRANVAL.errMsg)
			PRINT(sv_u)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
