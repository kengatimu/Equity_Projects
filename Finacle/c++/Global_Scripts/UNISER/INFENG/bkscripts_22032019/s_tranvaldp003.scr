	IF (CLASSEXISTS("CUST","TRANVAL") == 0) THEN
	#{
		CREATECLASS("CUST","TRANVAL",5)
	#}
	ENDIF
	
	CUST.TRANVAL.errMsg    = ""
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.TRANVAL.tranId = BANCS.OUTPARAM.srvValue
		PRINT(CUST.TRANVAL.tranId)
		#}
	ELSE
		#{
		CUST.TRANVAL.errMsg = "Error: urhk_SRV_GetVal failed for tranID"
		PRINT(CUST.TRANVAL.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (BANCS.STDIN.contextBankId == "54") THEN
	#{
		#############################restricting deletion of serials#############################
		sv_s = "count|SELECT count(1) FROM TBAADM.DTD "
		sv_s = sv_s + " WHERE DTD.tran_id =?SVAR "
		sv_s = sv_s + " AND DTD.entry_user_id ='SYSTEM'"
		sv_s = sv_s + " AND DTD.pstd_flg = 'N' "
		sv_s = sv_s + " AND DTD.del_flg='N' "
		sv_s = sv_s + " AND DTD.bank_id=?SVAR "
