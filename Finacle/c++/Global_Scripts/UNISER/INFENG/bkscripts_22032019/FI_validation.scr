#---------------------------------------------------------------------------------    
#	Name			: s_tranvaldp001.scr
#	Description		: This script is used for blocking transactions when the 
#				      tran sub type is BI and account is dormant or inactive 
#					  account in TM menu. 
#	Date			: 16-01-2013
#	Author			: GOKULKRISHNA
#	Input			: NA
#	Output			: NA
#	Called Script	: SRV_AddAndPostXferTran_validate_data.scr
#	Calling Scrip	: NA
#	Menu Option		: HTM
#	Srl. No			Date			Author			Description.   
#	-------			---------		-------			---------------			
#	1.0				16-01-2013		GOKULKRISHNA			Original Version
#   1.1				06-03-2013      GOKULKRISHNA			Added the onlineOrBatch Check
#   1.2				01-08-2013      Bharath			Validation added for deleted part trans
#----------------------------------------------------------------------------------

<--START
TRACE ON

#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","INTERFACE") == 0) THEN
#{
    CREATECLASS("CUST","INTERFACE",5)
#}
ENDIF


sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
        CUST.INTERFACE.tranType = BANCS.OUTPARAM.srvValue
        PRINT(CUST.INTERFACE.tranType)
#}
ELSE
#{
        sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Type")
        BANCS.OUTPUT.successOrFailure = "F"
        GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
        CUST.INTERFACE.tranSubType = BANCS.OUTPARAM.srvValue
        PRINT(CUST.INTERFACE.tranSubType)
#}
ELSE
#{
        sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Sub Type")
        BANCS.OUTPUT.successOrFailure = "F"
        GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	CUST.INTERFACE.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.INTERFACE.noOfRecords)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
	BANCS.OUTPUT.successOrFailure = "F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_l = 0
sv_m = ""
sv_p = ""
sv_n = 0
sv_t = 0

WHILE(sv_l < CUST.INTERFACE.noOfRecords)
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		#("CUST").("INTERFACE").("foracid_"+sv_r) = BANCS.OUTPARAM.srvValue
		#CUST.INTERFACE.foracid = ("CUST").("INTERFACE").("foracid_"+sv_r)
		CUST.INTERFACE.foracid = BANCS.OUTPARAM.srvValue
		PRINT(CUST.INTERFACE.foracid)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for foracid")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		("CUST").("INTERFACE").("partTran _"+sv_r) = BANCS.OUTPARAM.srvValue
		CUST.INTERFACE.partTran = ("CUST").("INTERFACE").("partTran _"+sv_r)
		PRINT(CUST.INTERFACE.partTran)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for part Tran")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".delFlg")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.INTERFACE.delFlg = BANCS.OUTPARAM.srvValue
		PRINT(CUST.INTERFACE.delFlg)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for delFlg")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#sv_l = sv_l + 1
	#PRINT(sv_l)

	IF (CUST.INTERFACE.delFlg == "Y") THEN
	#{
		GOTO NEXTREC
	#}
	ENDIF

	PRINT(CUST.INTERFACE.foracid)

	#Granting TOD if the account balance is less than the charge amount
	CUST.INTERFACE.grantTOD="N"
	
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".tranAmt")
	CUST.INTERFACE.DrTranAmt=BANCS.OUTPARAM.srvValue
	print(CUST.INTERFACE.DrTranAmt)
	sv_w = LEFT$(CUST.INTERFACE.DrTranAmt,GETPOSITION(CUST.INTERFACE.DrTranAmt,"|")-1)
	sv_x = MID$(CUST.INTERFACE.DrTranAmt,GETPOSITION(CUST.INTERFACE.DrTranAmt,"|"),STRLEN(CUST.INTERFACE.DrTranAmt))
	print(sv_w)
	print(sv_x)
	CUST.INTERFACE.DrTranAmt=sv_w
	CUST.INTERFACE.DrTrCrncy=sv_x

	sv_k = urhk_getAcctDetailsInRepository(CUST.INTERFACE.foracid)
	if(sv_k == 0) then
	#{
		CUST.INTERFACE.DrAcctBal= BANCS.OUTPARAM.EffAvailableAmt
		print(CUST.INTERFACE.DrAcctBal)
		CUST.INTERFACE.DrSchmCode = BANCS.OUTPARAM.schmCode
		CUST.INTERFACE.DrSchmType = BANCS.OUTPARAM.schmType
		CUST.INTERFACE.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
		print(CUST.INTERFACE.acctOwnerShip)

		IF((CUST.INTERFACE.partTran == "D") AND (CUST.INTERFACE.acctOwnerShip != "O")) THEN
		#{
			IF ( CDOUBLE(CUST.INTERFACE.DrAcctBal) < CDOUBLE(CUST.INTERFACE.DrTranAmt))	THEN
			#{
				CUST.INTERFACE.DccId=""
				sv_a = urhk_GetChannelInfo("")
				print(sv_a)
				if (sv_a!=0) then
				#{
					sv_u = urhk_SRV_SetErr("Error: Channel ID is not passed/Incorrect")
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				#}
				else
				#{
					CUST.INTERFACE.DccId = BANCS.OUTPARAM.DccId
				#}
				endif
				
				IF(CUST.INTERFACE.DccId=="ICO")THEN
					CUST.INTERFACE.grantTOD="Y"
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF


	IF(CUST.INTERFACE.grantTOD=="Y")THEN
	#{	
		sv_s = "advType,advCatg|select DISCRET_ADVN_TYPE,DISCRET_ADVN_CATGR "
		sv_s = sv_s + " from tbaadm.DAR where DAT_REF_TYPE = 'IN' "
		sv_s = sv_s + " and schm_code = '" + CUST.INTERFACE.DrSchmCode  + "'"
		sv_s = sv_s + " and bank_id = '" + BANCS.STDIN.contextBankId + "'"
		sv_s = sv_s + " and del_flg != 'Y'"
		print(sv_s)
		sv_d = urhk_dbSelectwithBind(sv_s)
		print(sv_d)

		IF(sv_d == 0) THEN
		#{
				CUST.INTERFACE.advType = BANCS.OUTPARAM.advType
				CUST.INTERFACE.advCatg = BANCS.OUTPARAM.advCatg
		#}
		ELSE
		#{
				CUST.INTERFACE.advType = ""
				CUST.INTERFACE.advCatg = ""
			        BANCS.OUTPUT.successOrFailure="F"
        			sv_m = "TOD setup is not available for the scheme : " + CUST.INTERFACE.DrSchmCode 
        			sv_u = urhk_SRV_SetErr(sv_m)
				GOTO ENDOFSCRIPT
		#}
		ENDIF
		

		sv_k= "tranDtl.partTranDetailLL."+sv_r+ ".instantTodDtl.todBasicDtl"
		
		sv_a= urhk_SRV_SetVal("tranDtl.partTranDetailLL."+sv_r+ ".grantTodFlg|Y")
		sv_a= urhk_SRV_SetVal(sv_k + ".discreteAdvnType.code|"+CUST.INTERFACE.advType)
		sv_a= urhk_SRV_SetVal(sv_k + ".discreteAdvnCatgr.code|"+CUST.INTERFACE.advCatg)
		sv_a= urhk_SRV_SetVal(sv_k + ".grantDate|" + BANCS.STDIN.BODDate)
		sv_a= urhk_SRV_SetVal(sv_k + ".expiryDate|" + BANCS.STDIN.BODDate)
		sv_a= urhk_SRV_SetVal(sv_k + ".acct.foracid|" + CUST.INTERFACE.foracid)
		sv_a= urhk_SRV_SetVal(sv_k + ".acct.crncyCode|" + CUST.INTERFACE.DrTrCrncy)
		sv_a = CUST.INTERFACE.DrTranAmt
		sv_a = format$(CDOUBLE(sv_a),"%17.2f")
		sv_a = sv_a + "|" + CUST.INTERFACE.DrTrCrncy
		sv_a= urhk_SRV_SetVal(sv_k + ".todAmtToBeGrntd|" + sv_a)
		sv_a= urhk_SRV_SetVal(sv_k + ".todLevIntFlg|N")
		sv_a= urhk_SRV_SetVal(sv_k + ".permittedBy.userId|" + BANCS.STDIN.userId)
		sv_a= urhk_SRV_SetVal(sv_k + ".todEventType.type|TODIN")
		sv_a= urhk_SRV_SetVal(sv_k + ".penalDate|" + BANCS.STDIN.BODDate)
	#}
	ENDIF






	NEXTREC:
sv_l = sv_l + 1
PRINT(sv_l)
#}
DO

IF (sv_n > 0) THEN 
#{
	BANCS.OUTPUT.successOrFailure="F"
	sv_m = RTRIM(sv_m ,',')
	sv_m = "Transaction not allowed for Dormant Accounts with part tran serial num:"+  sv_m	
	sv_u = urhk_SRV_SetErr(sv_m)
#}
ENDIF

IF (sv_t > 0) THEN 
#{
	BANCS.OUTPUT.successOrFailure="F"
	sv_p = RTRIM(sv_p ,',')
	sv_p = "Transaction not allowed for Inactive Accounts with part tran serial num:"+  sv_p	
	sv_u = urhk_SRV_SetErr(sv_p)
#}
ENDIF

ENDOFSCRIPT:
#-------------------------------------------------------------------------------------------------------
# Deleting the Class and Repository
#-------------------------------------------------------------------------------------------------------
IF (CLASSEXISTS("CUST","INTERFACE") == 1) THEN
#{
    DELETECLASS("CUST","INTERFACE")
#}
ENDIF

IF (REPEXISTS("CUST") == 1) THEN
#{
    DELETEREP("CUST")
#}
ENDIF

EXITSCRIPT
#TRACE OFF
END-->
