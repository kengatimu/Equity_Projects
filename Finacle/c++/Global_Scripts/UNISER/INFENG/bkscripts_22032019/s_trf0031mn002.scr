	#---------------------------------------------------------------------------------------------
	#User hook used to get customfield from screen
	#---------------------------------------------------------------------------------------------
	PRINT("TEEST"+ONS.CUSTOM.custDataIn+"TEST")
	IF(STRLEN(TRIM(ONS.CUSTOM.custDataIn)) > 0) THEN
	#{
		IF(CUST.TRF0031.menuId == "HORM") THEN
		#{
			sv_d = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)
			PRINT(sv_d)
			IF(FIELDEXISTS(BANCS.INPUT.ormpartydtl_FIELD_1) ==1) THEN
