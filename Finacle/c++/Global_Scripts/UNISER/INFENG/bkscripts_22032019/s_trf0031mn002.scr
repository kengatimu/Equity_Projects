				CUST.TRF0031.fedWireSortCode = BANCS.INPUT.ormpartydtl_FIELD_1
				PRINT(CUST.TRF0031.fedWireSortCode)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF(CUST.TRF0031.fedWireSortCode != "") THEN
	#{
		sv_s = "count|"
		sv_s = sv_s + " SELECT count(*) "
		sv_s = sv_s + " FROM CUSTOM.C_PTYDTL"
		sv_s = sv_s + " WHERE C_PTYDTL.remt_id = ?SVAR"
		sv_s = sv_s + " AND C_PTYDTL.entity_cre_flg IN('N','Y')"
		sv_s = sv_s + " AND C_PTYDTL.del_flg = 'N' "
		sv_s = sv_s + " AND C_PTYDTL.bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS	=""
		BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
		BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		print(BANCS.OUTPARAM.count)
		
		IF(sv_d == 0) THEN
		#{
			IF(CINT(BANCS.OUTPARAM.count) > 0) THEN
			#{
				sv_s = ""
				sv_s = sv_s + " UPDATE CUSTOM.C_PTYDTL "
				sv_s = sv_s + " SET "
				sv_s = sv_s + " C_PTYDTL.FED_SORT_NUM 	= ?SVAR"
				sv_s = sv_s + " WHERE C_PTYDTL.remt_id 	= ?SVAR"
				sv_s = sv_s + " AND C_PTYDTL.entity_cre_flg IN('N','Y')"
				sv_s = sv_s + " AND C_PTYDTL.del_flg = 'N' "
				sv_s = sv_s + " AND C_PTYDTL.bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS	=""
				BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.fedWireSortCode + "|"
				BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
				BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSQLWithBind(sv_s)
				#}
			ELSE
				#{
				sv_s = ""
				sv_s = sv_s + " INSERT INTO CUSTOM.C_PTYDTL(sl_num,remt_id,fed_sort_num,entity_cre_flg,rcre_user_id,rcre_time,del_flg,bank_id) "
				sv_s = sv_s + " VALUES ("
				sv_s = sv_s + "CUSTOM.seq.nextval"
				sv_s = sv_s + ",?SVAR "
				sv_s = sv_s + ",?SVAR "
				sv_s = sv_s + ",'N' "
				sv_s = sv_s + ",?SVAR "
				sv_s = sv_s + ",sysdate "
				sv_s = sv_s + ",'N' "
				sv_s = sv_s + ",?SVAR "
				sv_s = sv_s + ")"
				PRINT(sv_s)
				
				BANCS.INPARAM.BINDVARS	=""
				BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
				BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+CUST.TRF0031.fedWireSortCode+ "|"
				BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.userId + "|"
				BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
			#}
			ENDIF
			IF (sv_d == 0) THEN
			#{
				sv_d = urhk_dbSQLWithBind("COMMIT")
				#}
			ELSE
				#{
				CUST.TRF0031.errMsg = "The records are not commited"
				sv_v = urhk_SRV_SetErr(CUST.TRF0031.errorMsg)
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.TRF0031.errMsg = "Unable to find records for the remittance id"
			sv_v = urhk_SRV_SetErr(CUST.TRF0031.errorMsg)
		#}
		ENDIF
	#}
	ENDIF
	
