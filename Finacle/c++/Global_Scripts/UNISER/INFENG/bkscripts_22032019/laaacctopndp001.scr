		IF(sv_a > 0) THEN
		#{
			#-----------------------------------------------------------------------------------------------
			#Getting INSTDATELIST values from CPARAM
			#-----------------------------------------------------------------------------------------------
			BANCS.INPUT.moduleName = "LAOPN"
			BANCS.INPUT.parameterId = "INSTDATELIST"
			
			CALL ("getcparamvalue.scr")
			PRINT(BANCS.OUTPUT.parameterVal)
			
			IF(BANCS.OUTPUT.parameterVal != "")THEN
			#{
				CUST.CPARAM.instDateList= BANCS.OUTPUT.parameterVal
				PRINT(CUST.CPARAM.instDateList)
				#}
			ELSE
				#{
				CUST.LAOPN.errMsg = "INSTDATELIST setup not done in CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a=GETPOSITION(CUST.CPARAM.instDateList,"!"+CUST.LAOPN.instDateDay+"!")
			PRINT(sv_a)
			IF(sv_a == 0) THEN
			#{
				CUST.LAOPN.errMsg = "The Repayment Date Should Be 05,10,15,20 OR 25"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
