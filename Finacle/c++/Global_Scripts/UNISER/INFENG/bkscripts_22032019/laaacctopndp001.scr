CHECKSUM="c2c52d9ba99a720e0638573a10b06728e8e386789a02df8b94e2e2d91ab4c538"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LAOPN") == 0) THEN
	#{
		CREATECLASS("CUST","LAOPN",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Initaializing variables
	#------------------------------------------------------------------------------
	CUST.LAOPN.errMsg = " "
	
	IF(BANCS.STDIN.contextBankId == "54" ) THEN
	#{
		#-----------------------------------------------------------------------------------------------
		#Getting INSTSCHMLIST values from CPARAM
		#-----------------------------------------------------------------------------------------------
		BANCS.INPUT.moduleName = "LAOPN"
		BANCS.INPUT.parameterId = "INSTSCHMLIST"
		
		CALL ("getcparamvalue.scr")
		PRINT(BANCS.OUTPUT.parameterVal)
		
		IF(BANCS.OUTPUT.parameterVal != "")THEN
		#{
			CUST.CPARAM.instSchmList= BANCS.OUTPUT.parameterVal
			PRINT(CUST.CPARAM.instSchmList)
			#}
		ELSE
			#{
			CUST.LAOPN.errMsg = "INSTSCHMLIST setup not done in CPARAM"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.LAOPN.laSchmCode 		= TRIM(BANCS.INPUT.laSchmCode)
		PRINT(CUST.LAOPN.laSchmCode)
		CUST.LAOPN.instDateDay 		= TRIM(BANCS.INPUT.instDateDay)
		PRINT(CUST.LAOPN.instDateDay)
		sv_a=GETPOSITION(CUST.CPARAM.instSchmList,"!"+CUST.LAOPN.laSchmCode+"!")
