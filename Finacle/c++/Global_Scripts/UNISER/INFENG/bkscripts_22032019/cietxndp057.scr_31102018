<--START
CHECKSUM="0782c418ecef5bf94114720cac9f4ba9987638a82e0cc630e388b7df7f82e04a"
	TRACE ON
	
	PRINT(CUST.CIETXN.randomRefNo)
	PRINT(CUST.CIETXN.phoneNo)
	
	###################################################################################################
	# Initialize the variables
	###################################################################################################
	
	CUST.CIETXN.mobeepush_REF_NO= "127"
	CUST.CIETXN.mobeepush_LANGUAGE = "EN"
	CUST.CIETXN.mobeepush_INSTITUTION_CODE = "068"
	CUST.CIETXN.mobeepush_MOBILE_NUMBER = CUST.CIETXN.phoneNo
	CUST.CIETXN.mobeepush_MESSAGE_ARRIEVED_DATE = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.CIETXN.mobeepush_MESSAGE_PRIORITY = "4"
	CUST.CIETXN.mobeepush_MESSAGE_STATUS = "0"
	CUST.CIETXN.mobeepush_MESSAGE_VALIDITY_PERIOD = "86400000"
	CUST.CIETXN.mobeepush_DEPARTMENT = "Finacle"
	CUST.CIETXN.mobeepush_MESSAGE_TEXT = ""
	CUST.CIETXN.mobeepush_RETRY_COUNT = "0"
	CUST.CIETXN.mobeepush_BANK_ID = BANCS.STDIN.contextBankId
	
	PRINT(CUST.CIETXN.mobeepush_REF_NO)
	PRINT(CUST.CIETXN.mobeepush_LANGUAGE)
	PRINT(CUST.CIETXN.mobeepush_INSTITUTION_CODE)
	PRINT(CUST.CIETXN.mobeepush_MOBILE_NUMBER)
	PRINT(CUST.CIETXN.mobeepush_MESSAGE_ARRIEVED_DATE)
	PRINT(CUST.CIETXN.mobeepush_MESSAGE_PRIORITY)
	PRINT(CUST.CIETXN.mobeepush_MESSAGE_STATUS)
	PRINT(CUST.CIETXN.mobeepush_MESSAGE_VALIDITY_PERIOD)
	PRINT(CUST.CIETXN.mobeepush_DEPARTMENT)
	PRINT(CUST.CIETXN.mobeepush_MESSAGE_TEXT)
	PRINT(CUST.CIETXN.mobeepush_RETRY_COUNT)
	PRINT(CUST.CIETXN.mobeepush_BANK_ID)
	
	###################################################################################################
	# Get Random Reference Number Expiry Period from CPARAM
	###################################################################################################
	
	CUST.CIETXN.expiryPeriodInDays = ""
	
	CUST.CIETXN.parameterId = "PA_EXPIRY_PERIOD"
	print(CUST.CIETXN.parameterId)
	
	sv_s = "expiryPeriodInDays|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Random Ref No Expiry Period not set in CPARAM^prodCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.expiryPeriodInDays = BANCS.OUTPARAM.expiryPeriodInDays
	print(CUST.CIETXN.expiryPeriodInDays)
	
	IF(TRIM(CUST.CIETXN.expiryPeriodInDays) == "")THEN
	#{
		CUST.CIETXN.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Random Ref No Expiry Period not set in CPARAM^prodCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###################################################################################################
	# MESSAGE TEXT
	###################################################################################################
	
	CUST.CIETXN.mobeepush_MESSAGE_TEXT = "Dear Customer, your payment reference no. is " + CUST.CIETXN.randomRefNo + "."
	CUST.CIETXN.mobeepush_MESSAGE_TEXT = CUST.CIETXN.mobeepush_MESSAGE_TEXT + "The reference no. is valid only for " + CUST.CIETXN.expiryPeriodInDays + " days"
	PRINT(CUST.CIETXN.mobeepush_MESSAGE_TEXT)
	
	###################################################################################################
	# Insert into CUSTOM.MOBEE_PUSH_SMS TABLE
	###################################################################################################
	
	sv_s = "INSERT INTO CUSTOM.MOBEE_PUSH_SMS VALUES("
	sv_s = sv_s + "CUSTOM.MOBEE_PUSH_SMS_SEQUENCE.nextval" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR" + ","
	sv_s = sv_s + "?SVAR)"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	#BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTOM.MOBEE_PUSH_SMS_SEQUENCE.nextval'	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_LANGUAGE		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_INSTITUTION_CODE	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_MOBILE_NUMBER		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_MESSAGE_ARRIEVED_DATE	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_MESSAGE_PRIORITY	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_MESSAGE_STATUS		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_MESSAGE_VALIDITY_PERIOD	+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_DEPARTMENT		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_MESSAGE_TEXT		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_RETRY_COUNT		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.mobeepush_BANK_ID
	
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Insert Query Failed^prodCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
END-->
