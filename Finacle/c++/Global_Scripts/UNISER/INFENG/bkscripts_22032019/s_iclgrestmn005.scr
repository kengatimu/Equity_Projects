			BANCS.INPARAM.BINDVARS = CUST.DATA.solID + "|" + CUST.DATA.instNum + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.insAmt
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			
			CUST.DATA.count = BANCS.OUTPARAM.ddexists
			IF (CUST.DATA.count == 0) THEN
			#{
				print("The Instrument is not issued by this Branch")
				sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|The Instrument is not issued by this Branch")
				GOTO ENDSCRIPT
				#}
			ELSE
				#{
				sv_s = "status|"
