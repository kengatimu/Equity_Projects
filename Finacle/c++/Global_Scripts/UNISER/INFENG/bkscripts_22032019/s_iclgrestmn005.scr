				sv_s = sv_s + " WHERE issu_br_code = ?SVAR "
				sv_s = sv_s + " AND dd_crncy_code = ?SVAR "
				sv_s = sv_s + " AND LTRIM(dd_num) = ?SVAR "
				sv_s = sv_s + " AND bank_id = ?SVAR "
				sv_s = sv_s + " AND DD_AMT = ?SVAR "
				print(sv_s)
				
				BANCS.INPARAM.BINDVARS = CUST.DATA.solID + "|" + CUST.DATA.acctCcy + "|" + CUST.DATA.instNum + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.insAmt
				
				sv_d = urhk_dbselectWithBind(sv_s)
				print(sv_d)
				IF (sv_d != 0) THEN
				#{
					GOTO ENDSCRIPT
					#}
				ELSE
					#{
					sv_a = BANCS.OUTPARAM.status
					print(sv_a)
				#}
				ENDIF
				
				IF (sv_a != "U") THEN
				#{
					print("The Instrument is not unpaid")
					sv_u = urhk_SRV_SetErr("instrmntDtl.instrmntNum|The Instrument is not unpaid")
					GOTO ENDSCRIPT
