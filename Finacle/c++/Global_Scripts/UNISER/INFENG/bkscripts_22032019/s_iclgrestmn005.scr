		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE sol_id = ?SVAR "
		sv_s = sv_s + " AND acct_crncy_code = ?SVAR"
		sv_s = sv_s + " AND bacid = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.solID + "|" + CUST.DATA.acctCcy + "|" + CUST.DATA.bacid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		IF (sv_d !=0) THEN
		#{
			GOTO FINISH
			#}
		ELSE
			#{
			CUST.DATA.foracid = BANCS.OUTPARAM.foracid
			print(CUST.DATA.foracid)
		#}
		ENDIF
		
		
		IF (CUST.DATA.foracid == CUST.DATA.acctNo) THEN
		#{
			sv_s = "ddexists|"
			sv_s = sv_s + " SELECT count(*) "
			sv_s = sv_s + " FROM TBAADM.DST "
			sv_s = sv_s + " WHERE issu_br_code = ?SVAR "
			sv_s = sv_s + " AND LTRIM(dd_num) = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND DD_AMT = ?SVAR "
