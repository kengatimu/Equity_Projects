			#}
			ENDIF
			BANCS.INPUT.funCode = "M"
			BANCS.INPUT.newValue = "Y"
			BANCS.INPUT.autoVerify="Y"
			#}
		ELSE
			#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q="insert into "
			sv_q = sv_q + "C_SOLMNT values (?SVAR,"
			sv_q = sv_q + "'Y',"
			sv_q = sv_q + "?SVAR)"
			print(sv_q)
			sv_v=urhk_dbsqlWithBind(sv_q)
