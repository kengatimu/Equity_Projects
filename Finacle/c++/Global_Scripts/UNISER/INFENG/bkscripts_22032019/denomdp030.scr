	CUST.DENOM.funCode=BANCS.INPUT.funcCode
	print(CUST.DENOM.funCode)
	CUST.DENOM.bank_id=BANCS.STDIN.contextBankId
	print(CUST.DENOM.bank_id)
	
	#--------------------------------------------------------------------------------------
	# Begin of Code
	#--------------------------------------------------------------------------------------
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
	PRINT(BANCS.INPARAM.BINDVARS)
	
	
	sv_q = "sol_cnt|SELECT count(*) "
	sv_q = sv_q + "FROM SOL "
	sv_q = sv_q + "WHERE sol_id= ?SVAR "
	sv_q = sv_q + "AND bank_id = ?SVAR "
	print(sv_q)
	sv_r=urhk_dbselectWithBind(sv_q)
