<--START
CHECKSUM="2301849443e4a782f4d4d073724f19286c22a6c66c872b5f104eda672c7d047e"
	TRACE ON
	#--------------------------------------------------------------------------------------
	#		CREATE REPOSITORY AND CLASSES
	#--------------------------------------------------------------------------------------
	sv_r = 	REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "DENOM")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------------------
