		sv_v=urhk_dbselectWithBind(sv_q)
		print(sv_v)
		IF(sv_v==0)THEN
		#{
			CUST.DENOM.flg=BANCS.OUTPARAM.flg
			print(CUST.DENOM.flg)
			#}
		ELSE
			#{
			CUST.DENOM.flg="Y"
			print(CUST.DENOM.flg)
		#}
		ENDIF
		IF(CUST.DENOM.flg=="Y")THEN
		#{
			sv_z= urhk_SetOrbOut("SuccessOrFailure|Y")
			print(sv_z)
			sv_z = urhk_SetOrbOut("RESULT_MSG| SOL ID - "+CUST.DENOM.sol+"  is Disabled")
			#}
		ELSE
			#{
			sv_z= urhk_SetOrbOut("SuccessOrFailure|Y")
			print(sv_z)
			sv_z = urhk_SetOrbOut("RESULT_MSG| SOL ID - "+CUST.DENOM.sol+"  is Enabled")
		#}
		ENDIF
		BANCS.INPUT.funCode = "I"
		BANCS.INPUT.oldValue=CUST.DENOM.flg
		BANCS.INPUT.newValue=""
		BANCS.INPUT.autoVerify ="Y"
	#}
	ENDIF
	
	#--------------------------------------------------------------------------------------
	# INITIALIZE INPUTS FOR AUDIT
