			IF(sv_r==0)THEN
			#{
				print(BANCS.OUTPARAM.disFlg)
				BANCS.INPUT.oldValue = BANCS.OUTPARAM.disFlg
				
				#}
			ELSE
				#{
				sv_a = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_d = urhk_SetOrbOut("Error_1|err ^ Database err ^")
				GOTO FINISH
			#}
			ENDIF
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q="update C_SOLMNT "
			sv_q = sv_q + "SET dis_flg='Y' "
			sv_q = sv_q + "WHERE sol_id= ?SVAR "
			sv_q = sv_q + "AND bank_id = ?SVAR "
			print(sv_q)
			sv_v=urhk_dbsqlWithBind(sv_q)
			print(sv_v)
			IF(sv_v==0)THEN
			#{
				sv_z= urhk_SetOrbOut("SuccessOrFailure|Y")
				print(sv_z)
				sv_z = urhk_SetOrbOut("RESULT_MSG| SOL ID -  "+CUST.DENOM.sol+"  Disabled")
				print(sv_z)
				sv_l="commit"
				sv_v=urhk_dbsql(sv_l)
				print(sv_v)
				#goto FINISH
				#}
			ELSE
				#{
				sv_a = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_d = urhk_SetOrbOut("Error_1|err ^ Database err ^")
