	ELSE
		#{
		CUST.DENOM.sol_cnt=0
		print(CUST.DENOM.sol_cnt)
	#}
	ENDIF
	IF(CUST.DENOM.sol_cnt==0)THEN
	#{
		sv_a = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_z = urhk_SetOrbOut("Error_10|Error:^Invalid Sol ID^SOL")
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_q ="cnt|select count(*) "
	sv_q = sv_q + "FROM C_SOLMNT "
	sv_q = sv_q + "WHERE sol_id= ?SVAR "
	sv_q = sv_q + "AND bank_id = ?SVAR "
	print(sv_q)
	sv_r=urhk_dbselectWithbind(sv_q)
	print(sv_r)
	IF(sv_r==0) THEN
	#{
		CUST.DENOM.cnt=BANCS.OUTPARAM.cnt
		print(CUST.DENOM.cnt)
		#}
	ELSE
		#{
		CUST.DENOM.cnt=0
		print(CUST.DENOM.cnt)
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------------------
	# Function : ENABLE
	#--------------------------------------------------------------------------------------
	IF(CUST.DENOM.funCode=="E")THEN
	#{
		IF(CUST.DENOM.cnt!=0)THEN
		#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = "disFlg|SELECT dis_flg FROM tbaadm.C_SOLMNT "
			sv_q = sv_q + "WHERE sol_id= ?SVAR "
			sv_q = sv_q + "AND bank_id = ?SVAR "
			print(sv_q)
			sv_r = urhk_dbSelectWithBind(sv_q)
			print(sv_r)
			IF(sv_r==0)THEN
			#{
				print(BANCS.OUTPARAM.disFlg)
				BANCS.INPUT.oldValue = BANCS.OUTPARAM.disFlg
				
				#}
			ELSE
				#{
				sv_a = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_d = urhk_SetOrbOut("Error_1|err ^ Database err ^")
				GOTO FINISH
			#}
			ENDIF
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q="update C_SOLMNT "
			sv_q = sv_q + "SET dis_flg='N' "
			sv_q = sv_q + "WHERE sol_id= ?SVAR "
			sv_q = sv_q + "AND bank_id = ?SVAR "
			print(sv_q)
			sv_r=urhk_dbsqlWithBind(sv_q)
			print(sv_r)
			IF(sv_r==0)THEN
			#{
				sv_z= urhk_SetOrbOut("SuccessOrFailure|Y")
				print(sv_z)
				sv_z = urhk_SetOrbOut("RESULT_MSG| SOL ID - "+CUST.DENOM.sol+"  Enabled")
				print(sv_z)
				sv_q="commit"
				sv_r=urhk_dbsql(sv_q)
				print(sv_r)
				#goto FINISH
				#}
			ELSE
				#{
				sv_a = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_d = urhk_SetOrbOut("Error_1|err ^ Database err ^")
				GOTO FINISH
			#}
			ENDIF
			BANCS.INPUT.funCode = "M"
			BANCS.INPUT.newValue = "N"
			BANCS.INPUT.autoVerify="Y"
			#}
		ELSE
			#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q="INSERT INTO C_SOLMNT "
			sv_q = sv_q + "VALUES (?SVAR,"
			sv_q = sv_q + "'N',"
			sv_q = sv_q + "?SVAR)"
			print(sv_q)
			sv_r=urhk_dbsqlWithBind(sv_q)
			print(sv_r)
			IF(sv_r==0)THEN
			#{
				sv_z= urhk_SetOrbOut("SuccessOrFailure|Y")
				print(sv_z)
				sv_z = urhk_SetOrbOut("RESULT_MSG| SOL ID - "+CUST.DENOM.sol+"  Enabled")
				print(sv_z)
				sv_l="commit"
				sv_v=urhk_dbsql(sv_l)
				print(sv_v)
				
				#}
			ELSE
				#{
				
				sv_a = urhk_SetOrbOut("SuccessOrFailure|N")
				sv_d = urhk_SetOrbOut("Error_1|err ^ Database err ^")
				GOTO FINISH
			#}
			ENDIF
			BANCS.INPUT.funCode = "A"
			BANCS.INPUT.oldValue = ""
			BANCS.INPUT.newValue = "N"
			BANCS.INPUT.autoVerify ="Y"
		#}
		ENDIF
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------------------
	# Function : DISABLE
	#--------------------------------------------------------------------------------------
	IF(CUST.DENOM.funCode=="D")THEN
	#{
		IF(CUST.DENOM.cnt!=0)THEN
		#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.sol +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = "disFlg|SELECT dis_flg FROM tbaadm.C_SOLMNT "
