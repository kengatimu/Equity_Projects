#-------------------------------------------------------------------------------------------------------
# Source Name           :   oclgrptmn001.scr
# Date                  :   12-03-2013
# Author                :   Shishira
# Title                 :   OutwardClearingReport
# Description           :   Validates Input from COCLG menu and calles com
# Sources called        :   NA
# Sources called from   :   coclg.xml
# RS Approach Document  :
# Modification History  :
# <Serial No.>      <Date>          <Author Name>       <Description>
# 0.00a             12-03-2013     Shishira        Original version
# 0.00b				25-04-2013		Iranna			Modified Scr
#-------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="6ec14f17f82d8a0039872d0a6348a1aa68be11ffb018ce280ebc8dd7a0898714"
	TRACE ON
	
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.setId=BANCS.INPUT.setId
	print(CUST.DATA.setId)
	CUST.DATA.zoneCode=BANCS.INPUT.zoneCode
	print(CUST.DATA.zoneCode)
	CUST.DATA.zoneDate=BANCS.INPUT.date_ui
	
	
	#---------------------------------------
	#Fetching Zone Code
	#---------------------------------------
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "OCLGIRPT_ZONE1"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.pZoneCode1 =BANCS.OUTPUT.parameterVal
		print(CUST.DATA.pZoneCode1)
		#}
	ELSE
		#{
		CUST.DATA.pZoneCode1 = ""
		sv_e = "C_Param Setup Not Done"
		sv_m = "ERROR"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "OCLGIRPT_ZONE2"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.pZoneCode2 =BANCS.OUTPUT.parameterVal
		print(CUST.DATA.pZoneCode2)
		#}
	ELSE
		#{
		CUST.DATA.pZoneCode2 = ""
		sv_e = "C_Param Setup Not Done"
		sv_m = "ERROR"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	#--------------------------------------------------
	#Set Id validation
	#--------------------------------------------------
	
	sv_s = "Count|SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.SST "
	sv_s = sv_s + " WHERE SST.set_id=?SVAR "
	sv_s = sv_s + " AND SST.del_flg ='N' "
	sv_s = sv_s + " AND SST.entity_cre_flg ='Y' "
	sv_s = sv_s + " AND SST.bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.setId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		CUST.DATA.Count = BANCS.OUTPARAM.Count
		print(CUST.DATA.Count)
	#}
	ENDIF
	
	
	IF (CUST.DATA.Count==0) THEN
	#{
		print("Invalid Set Id")
		sv_e = "Invalid Set ID"
		sv_m = "setId"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	#--------------------------------------------------
	#Zone Code validation
	#--------------------------------------------------
	
	sv_s = "count|SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.OCI,TBAADM.OCP,TBAADM.GAM "
	sv_s = sv_s + " WHERE OCI.sol_id=OCP.sol_id "
	sv_s = sv_s + " AND OCI.clg_zone_date=OCP.clg_zone_date "
	sv_s = sv_s + " AND OCI.clg_zone_code=OCP.clg_zone_code "
	sv_s = sv_s + " AND OCI.set_num=OCP.set_num "
	sv_s = sv_s + " AND GAM.ACID=OCP.acid "
	sv_s = sv_s + " AND OCI.del_flg = 'N' "
	sv_s = sv_s + " AND GAM.del_flg = 'N' "
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + " AND OCI.del_flg ='N' "
	sv_s = sv_s + " AND OCI.sol_id in (SELECT sol_id FROM TBAADM.SST WHERE SST.set_id= ?SVAR AND del_flg ='N') "
	sv_s = sv_s + " AND OCI.clg_zone_code=?SVAR "
	sv_s = sv_s + " AND OCI.clg_zone_date =TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND OCI.bank_id=OCP.bank_id "
	sv_s = sv_s + " AND OCP.bank_id=GAM.bank_id "
	sv_s = sv_s + " AND OCP.bank_id=GAM.bank_id "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	
	BANCS.INPARAM.BINDVARS = CUST.DATA.setId + "|" + CUST.DATA.zoneCode + "|" + CUST.DATA.zoneDate +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		CUST.DATA.count= BANCS.OUTPARAM.count
		print(CUST.DATA.count)
	#}
	ENDIF
	
	IF (CUST.DATA.count==0) THEN
	#{
		print("No Record Found")
		sv_e = "No Record Found"
		sv_m = "ERROR"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	
	
	#--------------------------------------------------
	#Com selection
	#--------------------------------------------------
	
	print(BANCS.INPUT.funcCode)
	CUST.DATA.comtz = "oclgirptdp001.com"
	CUST.DATA.comrd	= "oclgirptdp002.com"
	CUST.DATA.comug = "oclgirptdp003.com"
	CUST.DATA.msg	="oclgirptdp001.com does not exists"
	
	#--------------------------------------------------
	#Fetching com file path
	#--------------------------------------------------
	sv_c = urhk_getFileLocation("COM|"+CUST.DATA.comtz)
	IF (sv_c != 0) THEN
	#{
		sv_e = CUST.DATA.msg
		sv_m = "ERROR"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	CUST.DATA.fileLocation = BANCS.OUTPARAM.fileLocation
	print(CUST.DATA.fileLocation)
	
	
	IF (BANCS.STDIN.contextBankId == "55") THEN
	#{
		sv_s = CUST.DATA.fileLocation + CUST.DATA.comtz + " " + CUST.DATA.setId + " " + CUST.DATA.zoneDate + " " +"'" + CUST.DATA.zoneCode + "'" + " " + "'"+ BANCS.STDIN.contextBankId + "'"
		print(sv_s)
	#}
	ENDIF
	
	IF (BANCS.STDIN.contextBankId == "50") THEN
	#{
		sv_s = CUST.DATA.fileLocation + CUST.DATA.comrd + " " + CUST.DATA.setId + " " + CUST.DATA.zoneDate + " " +"'" + CUST.DATA.zoneCode + "'" + " " + "'"+ BANCS.STDIN.contextBankId + "'"
		print(sv_s)
	#}
	ENDIF
	
	IF (BANCS.STDIN.contextBankId == "56") THEN
	#{
		sv_s = CUST.DATA.fileLocation + CUST.DATA.comug + " " + CUST.DATA.setId + " " + CUST.DATA.zoneDate + " " +"'" + CUST.DATA.zoneCode + "'" + " " + "'"+ BANCS.STDIN.contextBankId + "'" + " " +"'"+ CUST.DATA.pZoneCode1 +"'" + " " +"'"+ CUST.DATA.pZoneCode2 +"'"
		print(sv_s)
	#}
	ENDIF
	
	sv_n = SYSTEM(sv_s + "&" )
	print (sv_n)
	IF (sv_n == 0) THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Report Generated. To View/Print, Use HPR Menu."
		sv_z = urhk_SetOrbOut(sv_g)
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Report Could Not Be Generated"
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	FINISH:
		EXITSCRIPT
		TRACE OFF
END-->
