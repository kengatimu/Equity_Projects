		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			#}
		ELSE
			#{
			CUST.EODSTAT.errMsg = "DELETE command failed for MINUSCHQS"
		#}
		ENDIF
		
		sv_s = "INSERT INTO CUSTOM.MINUSCHQS"
		sv_s = sv_s + " SELECT sol_id,dd_num,dd_date,dd_amt,bank_id"
		sv_s = sv_s + " FROM TBAADM.DDC"
		sv_s = sv_s + " WHERE dd_date > SYSDATE - 180"
		sv_s = sv_s + " AND dd_num IS NOT NULL"
		sv_s = sv_s + " AND bank_id = ?SVAR"
		sv_s = sv_s + " AND entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND del_flg = 'N'"
		sv_s = sv_s + " MINUS"
		sv_s = sv_s + " SELECT sol_id,dd_num,dd_date,dd_amt,bank_id"
		sv_s = sv_s + " FROM TBAADM.DDD"
		sv_s = sv_s + " WHERE dd_date > SYSDATE - 180"
		sv_s = sv_s + " AND dd_num IS NOT NULL"
		sv_s = sv_s + " AND bank_id = ?SVAR"
		sv_s = sv_s + " AND entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND del_flg = 'N'"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			#}
		ELSE
			#{
			CUST.EODSTAT.errMsg = "Insert into MINUSCHQS failed"
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.EODSTAT.errMsg = "MINUSCHQS table not available"
	#}
	ENDIF
	
	sv_s = " COUNT|SELECT COUNT(1)"
	sv_s = sv_s + " FROM ALL_TABLES"
	sv_s = sv_s + "	WHERE owner = 'CUSTOM'"
	sv_s = sv_s + " AND table_name = 'NEW_ACCOUNTS'"
	sv_d = urhk_dbselectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		sv_s = "DELETE FROM "
		sv_s = sv_s + "CUSTOM.NEW_ACCOUNTS "
		sv_s = sv_s + "WHERE bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			#}
		ELSE
			#{
			CUST.EODSTAT.errMsg =  "DELETE command failed for NEW_ACCOUNTS"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_s = " INSERT INTO CUSTOM.NEW_ACCOUNTS"
		sv_s = sv_s + " SELECT SUBSTR(GAM.foracid,4) KBACCTNO,GAM.foracid,GAM.acct_name,GAM.acct_crncy_code,GAM.sol_id,GAM.bank_id"
		sv_s = sv_s + " FROM TBAADM.GAM, TBAADM.CMG"
		sv_s = sv_s + " WHERE GAM.cust_id = CMG.cust_id"
		sv_s = sv_s + " AND CMG.bank_id = GAM.bank_id"
		sv_s = sv_s + " AND TO_CHAR(GAM.acct_opn_date,'mm/dd/yyyy') ="
		sv_s = sv_s + " (SELECT TO_CHAR(db_stat_date-1,'mm/dd/yyyy')"
		sv_s = sv_s + " FROM TBAADM.GCT"
		sv_s = sv_s + " WHERE bank_id = ?SVAR)"
		sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND GAM.del_flg = 'N'"
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
		sv_s = sv_s + " AND GAM.schm_type IN ('SBA','CAA')"
		sv_s = sv_s + " AND acct_cls_flg = 'N'"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.contextBankId
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			#}
		ELSE
			#{
			CUST.EODSTAT.errMsg = "Insert into NEW_ACCOUNTS failed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.EODSTAT.errMsg = "NEW_ACCOUNTS table not available"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.EODSTAT.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.EODSTAT.errMsg+"' >>EODSTAT.log")
		#}
