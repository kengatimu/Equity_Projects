<--START
CHECKSUM="a1f88be1e00d725c9fb9dd63bf45d535fc7b8da355aeb0c8563aa878d5683ea4"
	TRACE ON
	
	CUST.CIECLG.scriptSuccess = "Y"
	
	CUST.CIECLG.txnType = "CL"
	print(CUST.CIECLG.txnType)
	
	print(CUST.CIECLG.instrumentAmt)
	print(CUST.CIECLG.instrumentAmtCcy)
	print(BANCS.STDIN.roleId)
	print(BANCS.STDIN.contextBankId)
	
	CUST.CIECLG.crossCntryLim = ""
	CUST.CIECLG.userRoleLim = ""
	CUST.CIECLG.parameterId = ""
	
	IF(CUST.CIECLG.txnType == "CL")THEN
	#{
		print(CUST.CIECLG.creditEntity)
		print(CUST.CIECLG.instrumentEntity)
		
		IF(CUST.CIECLG.creditEntity != BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIECLG.targetEntity = CUST.CIECLG.creditEntity
			print(CUST.CIECLG.targetEntity)
		#}
		ENDIF
		
		IF(CUST.CIECLG.instrumentEntity != BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIECLG.targetEntity = CUST.CIECLG.instrumentEntity
			print(CUST.CIECLG.targetEntity)
		#}
		ENDIF
		
		IF((CUST.CIECLG.creditEntity != BANCS.STDIN.contextBankId) AND (CUST.CIECLG.instrumentEntity != BANCS.STDIN.contextBankId))THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^Either Credit Account ID OR Instrument belong to initiating entity^prodCode"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	#}
	ENDIF
	
	########################################################################################
	# 1. Cross Country Limit Check
	########################################################################################
	
	IF(CUST.CIECLG.targetEntity != "")THEN
	#{
		CUST.CIECLG.parameterId = CUST.CIECLG.txnType + "_CROSS_CNTRY_LIMIT_" + CUST.CIECLG.targetEntity + "_" + CUST.CIECLG.instrumentAmtCcy
		print(CUST.CIECLG.parameterId)
		
		sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIECLG.parameterId = CUST.CIECLG.txnType + "_CROSS_CNTRY_LIMIT_" + CUST.CIECLG.targetEntity + "_" + BANCS.STDIN.homeCrncyCode
			print(CUST.CIECLG.parameterId)
			sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^Cross Country Transaction Amount Limit Not Maintained in CPARAM for Home Currency. Parameter Id is " + CUST.CIECLG.parameterId + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIECLG.parameterValue)
			
			CUST.CIECLG.crossCntryLim = CDOUBLE(CUST.CIECLG.parameterValue)
			print(CUST.CIECLG.crossCntryLim)
			
			#########################################################################################
			# Get the Rate Code for Calculation of Limit
			#########################################################################################
			
			CUST.CIECLG.parameterId = CUST.CIECLG.txnType + "_RATE_CODE_" + CUST.CIECLG.targetEntity
			print(CUST.CIECLG.parameterId)
			sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^Rate Code Not Maintained in CPARAM to find Limit value in Home Ccy. Parameter Id is " + CUST.CIECLG.parameterId + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIECLG.parameterValue)
			
			CUST.CIECLG.limitRateCode = CUST.CIECLG.parameterValue
			PRINT(CUST.CIECLG.limitRateCode)
			
			#########################################################################################
			# Convert Amount
			#########################################################################################
			
			BANCS.INPARAM.InputAmount = CUST.CIECLG.instrumentAmt
			BANCS.INPARAM.FromCurrency = CUST.CIECLG.instrumentAmtCcy
			BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.RateCode = CUST.CIECLG.limitRateCode
			BANCS.INPARAM.Rate = 0.00
			BANCS.INPARAM.CustId = ""
			
			sv_u = urhk_B2k_ConvertAmount("")
			print(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				CUST.CIECLG.convertedRefAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				print(CUST.CIECLG.convertedRefAmt)
				#}
			ELSE
				#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^Unable to find Limit value in Home Ccy^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			IF(CDOUBLE(CUST.CIECLG.convertedRefAmt) > CDOUBLE(CUST.CIECLG.crossCntryLim))THEN
			#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				CUST.CIECLG.crossCntryLim = Format$(CDOUBLE(CUST.CIECLG.crossCntryLim),"%12.02f")
				sv_s = "Error_1|Error^Cross Country Transaction Amount Limit Exceeded. Limit is "+ CUST.CIECLG.crossCntryLim + " " + BANCS.STDIN.homeCrncyCode + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIECLG.parameterValue)
			
			CUST.CIECLG.crossCntryLim = CDOUBLE(CUST.CIECLG.parameterValue)
			print(CUST.CIECLG.crossCntryLim)
			
			IF(CDOUBLE(CUST.CIECLG.instrumentAmt) > CDOUBLE(CUST.CIECLG.crossCntryLim))THEN
			#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				CUST.CIECLG.crossCntryLim = Format$(CDOUBLE(CUST.CIECLG.crossCntryLim),"%12.02f")
				sv_s = "Error_1|Error^Cross Country Transaction Amount Limit Exceeded. Limit is "+ CUST.CIECLG.crossCntryLim + " " + CUST.CIECLG.instrumentAmtCcy + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	########################################################################################
	# 2. User Role Level Limit Check
	########################################################################################
	
	IF(CUST.CIECLG.targetEntity != "")THEN
	#{
		CUST.CIECLG.parameterId = BANCS.STDIN.roleId + "_" + CUST.CIECLG.txnType + "_LIM_" + CUST.CIECLG.targetEntity + "_" + CUST.CIECLG.instrumentAmtCcy
		print(CUST.CIECLG.parameterId)
		
		sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIECLG.parameterId = BANCS.STDIN.roleId + "_" + CUST.CIECLG.txnType + "_LIM_" + CUST.CIECLG.targetEntity + "_"+BANCS.STDIN.homeCrncyCode
			print(CUST.CIECLG.parameterId)
			sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_s = "Error_1|Error^User Role Level Transaction Amount Limit Not Maintained in CPARAM for " + BANCS.STDIN.roleId + " role. Parameter Id is " +CUST.CIECLG.parameterId + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIECLG.parameterValue)
			
			CUST.CIECLG.userRoleLim = CDOUBLE(CUST.CIECLG.parameterValue)
			print(CUST.CIECLG.userRoleLim)
			
			#########################################################################################
			# Use the Rate Code for Calculation of Limit
			#########################################################################################
			
			PRINT(CUST.CIECLG.limitRateCode)
			
			#########################################################################################
			# Use the converted Ref Amt
			#########################################################################################
			
			IF(CDOUBLE(CUST.CIECLG.convertedRefAmt) > CDOUBLE(CUST.CIECLG.userRoleLim))THEN
			#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				CUST.CIECLG.crossCntryLim = Format$(CDOUBLE(CUST.CIECLG.crossCntryLim),"%12.02f")
				sv_s = "Error_1|Error^User Role Level Transaction Amount Limit Exceeded. Limit is "+ CUST.CIECLG.userRoleLim + " " + BANCS.STDIN.homeCrncyCode + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#}
		ELSE
			#{
			CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
			PRINT(CUST.CIECLG.parameterValue)
			
			CUST.CIECLG.userRoleLim = CDOUBLE(CUST.CIECLG.parameterValue)
			print(CUST.CIECLG.userRoleLim)
			
			IF(CDOUBLE(CUST.CIECLG.instrumentAmt) > CDOUBLE(CUST.CIECLG.userRoleLim))THEN
			#{
				CUST.CIECLG.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				CUST.CIECLG.userRoleLim = Format$(CDOUBLE(CUST.CIECLG.userRoleLim),"%12.02f")
				sv_s = "Error_1|Error^User Role Level Transaction Amount Limit Exceeded. Limit is "+ CUST.CIECLG.userRoleLim + " " + CUST.CIECLG.instrumentAmtCcy + "^prodCode"
				sv_u = urhk_SetOrbOut(sv_s)
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	ENDOFSCRIPT:
