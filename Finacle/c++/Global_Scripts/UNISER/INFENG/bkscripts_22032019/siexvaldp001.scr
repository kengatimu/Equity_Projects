#-------------------------------------------------------------------------------------
#    Name				: siexvaldp001.scr 
#    Description     	: The script is used to check that only homeSolId can Inquire SI 
#    Date            	: 19-02-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: getcparamvalue.scr, SRV_AddSI_validate_data.scr, 
#    Menu Option		: HSIM
#    Srl. No		Date			Author			Description.   
#    -------		----			------			----------------
#    1.0			19-02-2013		Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
TRACE ON


#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","SIEXVAL") == 0) THEN
#{
	CREATECLASS("CUST","SIEXVAL",5)
#}
ENDIF

CUST.SIEXVAL.errMsg = ""
CUST.SIEXVAL.solID  = ""

IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50")) THEN
#{
	BANCS.INPUT.moduleName  = "SIEXECUTION"
	BANCS.INPUT.parameterId = "SIEXVAL_SOLID"
	CALL ("getcparamvalue.scr")

	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SIEXVAL.solID = BANCS.OUTPUT.parameterVal
		PRINT(CUST.SIEXVAL.solID)
	#}
	ELSE
	#{
		CUST.SIEXVAL.errMsg = "Sol Id setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF

PRINT(BANCS.STDIN.contextBankId)
PRINT(BANCS.STDIN.homeSolId)
Print(BANCS.STDIN.mySolId)
PRINT(CUST.SIEXVAL.solID)
IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "50")) THEN
#{
	IF (BANCS.STDIN.mySolId != CUST.SIEXVAL.solID) THEN
	#{
		CUST.SIEXVAL.res = "Y"
		PRINT(CUST.SIEXVAL.res)
		sv_a = "status|" + CUST.SIEXVAL.res
		sv_b = urhk_SetOrbOut(sv_a)
	#}
	ELSE
	#{
		CUST.SIEXVAL.res = "N"
		PRINT(CUST.SIEXVAL.res)
		sv_a = "status|" + CUST.SIEXVAL.res
		sv_b = urhk_SetOrbOut(sv_a)
	#}
	ENDIF
#}
ENDIF

ENDOFSCRIPT:
IF (CUST.SIEXVAL.errMsg != "") THEN
#{
    sv_u = urhk_SRV_SetErr(CUST.SIEXVAL.errMsg)
    BANCS.OUTPUT.successOrFailure = "F"
#}
ENDIF



TRACE OFF
EXITSCRIPT
END-->
