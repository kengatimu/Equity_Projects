<--START
CHECKSUM="c4c829f72cfff777ef1f254ae3d29952d6ffccc8ef8628d26f611c35734f2c41"
	TRACE ON
	#-----------------------------------------------------------------
	# Initialise is used to Check whether Class TDTR exists.
	# If not then creates that class.
	# 5 stands for String Type data.
	#-----------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0)THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","TDTR") == 0)THEN
	#{
		CREATECLASS("CUST","TDTR", 5)
	#}
	ENDIF
	
	CUST.TDTR.errMsg    = ""
	CUST.TDTR.Response = ""
	CUST.TDTR.brAccount = ""
	CUST.TDTR.hoAccount = ""
	CUST.TDTR.amount    = ""
	CUST.TDTR.narr1     = ""
	CUST.TDTR.solId     = ""
	CUST.TDTR.crAccount = ""
	CUST.TDTR.drAccount = ""
	CUST.TDTR.refCode   = ""
	
	#------------------------------------------------------------------
	#  Getting account to credit/debit and amount
	#------------------------------------------------------------------
	sv_a = BANCS.STDIN.mySolId
	CUST.TDTR.solId = sv_a
	PRINT(sv_a)
	BANCS.INPUT.moduleName = "ZEROISTN"
	
	BANCS.INPUT.parameterId = "TDTR_BRACCT"
	CALL ("getcparamvalue.scr")
	PRINT(sv_a + BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.TDTR.brAccount = sv_a + BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.TDTR.errMsg = "Debit Account setup not done CPARAM"
		GOTO Finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TDTR_HOACCT"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.TDTR.hoAccount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.TDTR.errMsg = "Credit Account setup not done CPARAM"
		GOTO Finish
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TDTR_NARR"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.TDTR.narr1 = BANCS.STDIN.mySolId + BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.TDTR.narr1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.TDTR.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.TDTR.refCode)
		#}
	ELSE
		#{
		CUST.TDTR.errMsg = "Ratecode set up not done CPARAM"
		GOTO Finish
	#}
	ENDIF
	#------------------------------------------------------------------------------
	# Getting the amount
	#------------------------------------------------------------------------------
	
	sv_s = "clearBalance |SELECT clr_bal_amt "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.TDTR.brAccount
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.TDTR.amount = BANCS.OUTPARAM.clearBalance
		IF (CDOUBLE(CUST.TDTR.amount) == 0) THEN
		#{
			EXITSCRIPT
		#}
		ENDIF
	#}
	ELSE
		#{
		CUST.TDTR.amount = "0"
		GOTO Finish
	#}
	ENDIF
	
	
	CUST.TDTR.crAccount = CUST.TDTR.hoAccount
	CUST.TDTR.drAccount = CUST.TDTR.brAccount
	PRINT(CUST.TDTR.crAccount)
	PRINT(CUST.TDTR.drAccount)
	
	#--------------------------------------------------------------------------
	# Create the narration
	#--------------------------------------------------------------------------
	CUST.TDTR.narr1=" :-> TOTAL TRADING AMOUNT TRX TO HO"
	CUST.TDTR.narr1=BANCS.STDIN.mySolId + CUST.TDTR.narr1
	PRINT(CUST.TDTR.narr1)
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("MTT")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT","TranDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT","TranDetails",5)
	#}
	ENDIF
	
	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("BANCS")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("BANCS","INPARAM")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("BANCS","INPARAM",5)
	#}
	ENDIF
	
	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="Y"
	BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"
	
	sv_u = urhk_MTTS_PopulateInputDetails("")
	
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
	MTT.TranDetails.Remarks = CUST.TDTR.narr1
	
	
	sv_v = "PurchaseComm"
	PRINT(sv_v)
	
	sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
	
	#--------------------------------------------------
	# Income To EQUITY PURCHASES COMM A/C
	#--------------------------------------------------
	
	MTT.PartTranDetails.Account = CUST.TDTR.crAccount
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.TDTR.narr1
	MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.TDTR.amount)
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_e = "PurchaseIncome"
	sv_r = urhk_MTTS_definePartTran(sv_e)
	PRINT(sv_r)
	
	#------------------------------------------------------------------
	# Debit Partran To NAKUMATT PURCHASES COMM A/C
	#------------------------------------------------------------------
	
	MTT.PartTranDetails.Account = CUST.TDTR.drAccount
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.TDTR.narr1
	sv_a = CDOUBLE(CUST.TDTR.amount )
	sv_a = -(sv_a)
	PRINT(sv_a)
	MTT.PartTranDetails.RefAmount = sv_a
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = "D" + CUST.TDTR.drAccount
	sv_u = urhk_MTTS_definePartTran(sv_h)
	IF (sv_u == 1) THEN
	#{
		PRINT("Unable to create MTT Part transaction")
		GOTO Finish
	#}
	ENDIF
	
	
	
	#############################
	# Commit the transaction
	#############################
	sv_u = urhk_MTTS_EndDefinition("")
	PRINT(sv_u)
	
	CUST.TDTR.TranId = BANCS.OUTPARAM.MTTTranId
	PRINT(CUST.TDTR.TranId)
	
	
	##################################################
	# If any error tran id will not be created
	##################################################
	IF ((sv_u != 0)  OR (CUST.TDTR.TranId==""))THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		PRINT (MTT.Error.Description)
		CUST.TDTR.ResStatus = "F"
		CUST.TDTR.Response = "Transaction creation Failed."
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO Finish
	#}
	ENDIF
	#sv_r = urhk_MTTS_Close("")
	#print(sv_r)
	
	Finish:
		IF(CUST.TDTR.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.TDTR.errMsg+"' >>ZRTN10.log")
		#}
		ENDIF
		
		EXITSCRIPT
		
		TRACE OFF
END-->
