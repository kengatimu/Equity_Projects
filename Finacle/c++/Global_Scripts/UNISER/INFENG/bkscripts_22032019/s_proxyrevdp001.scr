<--START
TRACE ON
#------------------------------------------------------------------------------
#	Creating repository and class
#	Initializing the variables
# 	Getting all the values from CPARAM  
#------------------------------------------------------------------------------
IF(REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF(CLASSEXISTS("CUST","REV") == 0) THEN
#{
    CREATECLASS("CUST","REV",5)
#}
ENDIF

CUST.REV.noOfRecords = ""
CUST.REV.foracid	 = ""
CUST.REV.errMsg      = ""

sv_a = urhk_SRV_GetVal("criteria.proxyAcct.foracid")
sv_p = BANCS.OUTPARAM.srvValue

    #-------------------------------------------------------------------------------------------------------
	# Get the number of proxy accounts 
	#-------------------------------------------------------------------------------------------------------
	
	sv_u = urhk_SRV_NumOfRecs("outLL")
	PRINT(sv_u)
	IF(sv_u == 0) THEN
	#{
		CUST.REV.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.REV.noOfRecords)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

    sv_l = 0
	sv_m = ""
	sv_n = 0

	WHILE(sv_l < CUST.REV.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		#-------------------------------------------------------------------------------------------
		# Fetch A/c - foracid
		#-------------------------------------------------------------------------------------------

		sv_b = urhk_SRV_GetVal("outLL." +sv_r+ ".revAcct.foracid")
		PRINT(sv_u)
		IF(sv_u == 0) THEN
		#{
			("CUST").("REV").("foracid_"+sv_r) = BANCS.OUTPARAM.srvValue
			CUST.REV.foracid = ("CUST").("REV").("foracid_"+sv_r)
			sv_q = CUST.REV.foracid
			PRINT(CUST.REV.foracid)
		#}
		ELSE
		#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for foracid")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (sv_p == sv_q) then
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_e = urhk_SRV_SetErr("Error :Can not be reversed to Proxy account")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_l = sv_l + 1
		PRINT (sv_l)
	#}
	DO

ENDOFSCRIPT :
#-------------------------------------------------------------------------------------------------------
# Deleting the Class and Repository
#-------------------------------------------------------------------------------------------------------
IF (CLASSEXISTS("CUST","REV") == 1) THEN
#{
    DELETECLASS("CUST","REV")
#}
ENDIF

IF (REPEXISTS("CUST") == 1) THEN
#{
    DELETEREP("CUST")
#}
ENDIF

EXITSCRIPT
TRACE OFF
END-->
