<--START
CHECKSUM="1e7e4fda33f17ec1f6b6cfa8d183b204910d844373d1594eba103ea4eba4658c"
	TRACE ON
	
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CUDDS") == 0) THEN
	#{
		CREATECLASS("CUST", "CUDDS", 5)
	#}
	ENDIF
	
	sv_s = "sysdate|select sysdate from dual"
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	CUST.CUDDS.sysdate = BANCS.OUTPARAM.sysdate
	print(CUST.CUDDS.sysdate)
	
	
	CUST.CUDDS.error_file = CUST.CUDDS.Originator + "_Processor_" + CUST.CUDDS.sysdate + ".ERR"
	print(CUST.CUDDS.error_file)
	CUST.CUDDS.suc_file = CUST.CUDDS.Originator + "_Processor_" + CUST.CUDDS.sysdate + ".SUC"
	CUST.CUDDS.excel_file = trim(CUST.CUDDS.Originator) + ".lst"
	print(CUST.CUDDS.excel_file)
	
	sv_a = "test -f " + CUST.CUDDS.error_file
	sv_r = system(sv_a)
	print(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		sv_a = system("rm -f " + CUST.CUDDS.error_file)
	#}
	ENDIF
	
	
	sv_a = "test -f " + CUST.CUDDS.suc_file
	sv_r = system(sv_a)
	print(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		sv_a = system("rm -f " + CUST.CUDDS.suc_file)
	#}
	ENDIF
	
	sv_a = "test -f " + CUST.CUDDS.excel_file
	sv_r = system(sv_a)
	print(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		sv_a = system("rm -f " + CUST.CUDDS.excel_file)
	#}
	ENDIF
	
	##########################################################################################
	# Calling com
	##########################################################################################
	
	CUST.CUDDS.com="uddsdirectdebitdp001.com"
	PRINT(CUST.CUDDS.com)
	
	sv_x = urhk_getFileLocation("COM|" + CUST.CUDDS.com)
	print(sv_x)
	
	sv_l = BANCS.OUTPARAM.fileLocation
	print(sv_l)
	
	
	sv_t  =  sv_l + CUST.CUDDS.com  + " " + CUST.CUDDS.Originator + "," + BANCS.STDIN.userId + " " + CUST.CUDDS.Originator + " " + BANCS.STDIN.contextBankId
	PRINT(sv_t)
	
	sv_u = SYSTEM(sv_t)
	print(sv_u)
	
	IF (sv_r == 0) THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Record successfully processed ."
		sv_u = urhk_SetOrbOut(sv_g)
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Record are not transfered. "
		sv_u = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	ENDSCRIPT:
		TRACE OFF
END-->
