#------------------------------------------------------------------------------------------------    
#    Name			 : s_sivaldp001.scr
#    Description     : The script is used to check for the given scheme code during debit transaction customer is treated as staff.
#					 : If tran type is .C. and credit account is office account, then it is treated as an external SI. When it is an external SI
#					 : and tran type is credit, tran particular should not be entered, else tran particular should be entered.
#					 : During Insurance premium, ref num field is made mandatory and tran particulars details are being populated from C_CIC custom table
#					 : and validates the reference amount to be multiple of 5 cents.
#    Date            : 13-02-2013
#    Author          : Divya
#    Input           : NA
#    Output			 : NA
#    Called Script	 : SRV_AddSI_pre_process_data.scr
#    Calling Script	 : getcparamvalue.scr
#    Menu Option	 : HSIM, HSSIM
#    Srl. No			Date			Author			Description.
#    ------			----------			-------			---------------
#    1.0			13-02-2013			Divya			Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="27fee646820d1b1f650175282a8c7b7c02611ecdc80c53e70854c85e02e8b2b7"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	# 	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","SIVAL") == 0) THEN
	#{
		CREATECLASS("CUST","SIVAL",5)
	#}
	ENDIF
	
	CUST.SIVAL.errMsg		= ""
	CUST.SIVAL.noOfRecords	= ""
	CUST.SIVAL.schmCode		= ""
	CUST.SIVAL.acctNum		= ""
	CUST.SIVAL.var1			= ""
	CUST.SIVAL.var2			= ""
	CUST.SIVAL.foracid1		= ""
	CUST.SIVAL.external		= ""
	CUST.SIVAL.srlNum		= ""
	CUST.SIVAL.staff        = ""
	
	BANCS.INPUT.moduleName  = "SIVAL"
	BANCS.INPUT.parameterId = "SIVAL_SC"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SIVAL.schmCode = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SIVAL.errMsg = "Scheme Code setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SIVAL_ACCTNUM"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SIVAL.acctNum = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SIVAL.errMsg = "Account Number setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	#-------------------------------------------------------------------------------------------------------
	# Get the number of accounts
	#-------------------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_NumOfRecs("subInstrLL")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.SIVAL.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.SIVAL.noOfRecords)
		#}
	ELSE
		#{
		CUST.SIVAL.errMsg = "Error:urhk_SRV_NumOfRecs failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_l = 0
	sv_m = 0
	sv_a = ""
	sv_b = 0
	sv_c = ""
	sv_e = 0
	sv_f = ""
	sv_g = 0
	sv_h = ""
	sv_i = 0
	sv_j = ""
	sv_k = 0
	WHILE (sv_l < CUST.SIVAL.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		PRINT(sv_r)
		
		sv_u = Format$(sv_m,"%d")
		sv_t = "<rec_"+sv_u+">"
		PRINT(sv_t)
		#-------------------------------------------------------------------------------------------
		# Fetch PartTranType
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("subInstrLL." +sv_r+ ".subInstr.partTranType.code")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SIVAL.code = BANCS.OUTPARAM.srvValue
			PRINT(CUST.SIVAL.code)
			#}
		ELSE
			#{
			CUST.SIVAL.errMsg = "Error: urhk_SRV_GetVal failed for PartTranType"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Foracid
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("subInstrLL." +sv_r+ ".prDtlLL." +sv_t+ ".acct.foracid")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SIVAL.foracid = BANCS.OUTPARAM.srvValue
			PRINT(CUST.SIVAL.foracid)
			#}
		ELSE
			#{
			CUST.SIVAL.errMsg = "Error: urhk_SRV_GetVal failed for Foracid"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Particulars
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("subInstrLL." +sv_r+ ".prDtlLL." +sv_t+ ".particulars")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SIVAL.tranPart = BANCS.OUTPARAM.srvValue
			PRINT(CUST.SIVAL.tranPart)
			#}
		ELSE
			#{
			CUST.SIVAL.errMsg = "Error: urhk_SRV_GetVal failed for TranParticular"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Key serial number
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("subInstrLL." +sv_r+ ".key.serial_num")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SIVAL.srlNum =	BANCS.OUTPARAM.srvValue
			PRINT(CUST.SIVAL.srlNum)
			#}
		ELSE
			#{
			CUST.SIVAL.errMsg = "Error: urhk_SRV_GetVal failed for serial number"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Reference Number
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("subInstrLL." +sv_r+ ".prDtlLL." +sv_t+ ".refNum")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SIVAL.refNo = BANCS.OUTPARAM.srvValue
			PRINT(CUST.SIVAL.refNo)
			#}
		ELSE
			#{
			CUST.SIVAL.errMsg = "Error: urhk_SRV_GetVal failed for Reference Number"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Amount
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("subInstrLL." +sv_r+ ".prDtlLL." +sv_t+ ".ptranAmt")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SIVAL.tranAmt = BANCS.OUTPARAM.srvValue
			PRINT(CUST.SIVAL.tranAmt)
			#}
		ELSE
			#{
			CUST.SIVAL.errMsg = "Error: urhk_SRV_GetVal failed for Tran Amount"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		PRINT(CUST.SIVAL.code)
		PRINT(CUST.SIVAL.foracid)
		IF ((CUST.SIVAL.code != "") AND (CUST.SIVAL.foracid != "")) THEN
		#{
			sv_u = urhk_getAcctDetailsInRepository(CUST.SIVAL.foracid)
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				IF (CUST.SIVAL.code == "C") THEN
				#{
					CUST.SIVAL.crcust = BANCS.OUTPARAM.custId
					PRINT(CUST.SIVAL.crcust)
					#}
				ELSE
					#{
					CUST.SIVAL.drcust = BANCS.OUTPARAM.custId
					PRINT(CUST.SIVAL.drcust)
				#}
				ENDIF
				CUST.SIVAL.schm = BANCS.OUTPARAM.schmCode
				PRINT(CUST.SIVAL.schm)
				PRINT(CUST.SIVAL.schmCode)
				IF ((CUST.SIVAL.schm == CUST.SIVAL.schmCode) AND (CUST.SIVAL.code == "D")) THEN
				#{
					CUST.SIVAL.staff = "Y"
				#}
				ENDIF
				PRINT(CUST.SIVAL.staff)
			#}
			ENDIF
		#}
		ENDIF
		
		PRINT(BANCS.STDIN.contextBankId)
		IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "11") OR (BANCS.STDIN.contextBankId == "50")) THEN
		#{
			PRINT(CUST.SIVAL.foracid)
			CUST.SIVAL.foracid1 = MID$(CUST.SIVAL.foracid,3,10)
			PRINT(CUST.SIVAL.foracid1)
			#}
		ELSE
			#{
			CUST.SIVAL.foracid1 = MID$(CUST.SIVAL.foracid,4,9)
			PRINT(CUST.SIVAL.foracid1)
		#}
		ENDIF
		IF ((CUST.SIVAL.code == "C") AND (CUST.SIVAL.acctNum == CUST.SIVAL.foracid1)) THEN
		#{
			CUST.SIVAL.external = "Y"
		#}
		ENDIF
		PRINT(CUST.SIVAL.external)
		
		PRINT(CUST.SIVAL.acctNum)
		PRINT(CUST.SIVAL.foracid1)
		PRINT(CUST.SIVAL.code)
		PRINT(CUST.SIVAL.tranPart)
		PRINT(CUST.SIVAL.srlNum)
		IF ((CUST.SIVAL.code == "C") AND (CUST.SIVAL.acctNum == CUST.SIVAL.foracid1) AND (TRIM(CUST.SIVAL.tranPart) != "")) THEN
		#{
			sv_u = urhk_SRV_SetVal("subInstrLL." +sv_r+ ".prDtlLL." +sv_t+ ".particulars| ")
			PRINT(sv_u)
			sv_a = sv_a + CUST.SIVAL.srlNum + ","
			PRINT(sv_a)
			
			sv_b = sv_b + 1
			PRINT(sv_b)
		#}
		ENDIF
		
		PRINT(CUST.SIVAL.acctNum)
		PRINT(CUST.SIVAL.foracid1)
		PRINT(CUST.SIVAL.srlNum)
		IF ((CUST.SIVAL.acctNum != CUST.SIVAL.foracid1) AND (CUST.SIVAL.tranPart == "")) THEN
		#{
			PRINT(CUST.SIVAL.srlNum)
			sv_c = sv_c + CUST.SIVAL.srlNum + ","
			PRINT(sv_c)
			
			sv_e = sv_e + 1
		#}
		ENDIF
		
		#----Inclusion for insuarance companies
		
		IF (CUST.SIVAL.code == "C") THEN
		#{
			sv_s = "count|"
			sv_s = sv_s + "SELECT COUNT(1) "
			sv_s = sv_s + "FROM CUSTOM.C_CIC "
			sv_s = sv_s + "WHERE acctnum = ?SVAR "
			sv_s = sv_s + "AND bank_id = ?SVAR "
			sv_s = sv_s + "AND del_flg = 'N'"
			BANCS.INPARAM.BINDVARS = CUST.SIVAL.foracid + "|" + BANCS.STDIN.contextBankId
			sv_d =  urhk_dbselectWithBind(sv_s)
			PRINT(sv_d)
			CUST.SIVAL.count = BANCS.OUTPARAM.count
			PRINT(CUST.SIVAL.count)
			CUST.SIVAL.tranPart = TRIM(CUST.SIVAL.tranPart)
			PRINT(CUST.SIVAL.tranPart)
			IF (CINT(CUST.SIVAL.count) != 0) THEN
			#{
				PRINT(CUST.SIVAL.refNo)
				IF (CUST.SIVAL.refNo == "") THEN
				#{
					sv_f = sv_f + CUST.SIVAL.srlNum + ","
					PRINT(sv_f)
					
					sv_g = sv_g + 1
					PRINT(sv_g)
					#}
				ELSE
					#{
					sv_s = "REFNUM,NAME|"
					sv_s = sv_s + "SELECT refnum,name "
					sv_s = sv_s + "FROM CUSTOM.C_CIC "
					sv_s = sv_s + "WHERE acctnum = ?SVAR "
					sv_s = sv_s + "AND refnum = ?SVAR "
					sv_s = sv_s + "AND del_flg = 'N'"
					sv_s = sv_s + "AND bank_id = ?SVAR "
					BANCS.INPARAM.BINDVARS = CUST.SIVAL.foracid + "|" + CUST.SIVAL.refNo + "|" + BANCS.STDIN.contextBankId
					PRINT(sv_s)
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbselectWithBind(sv_s)
					IF (sv_d != 0) THEN
					#{
						sv_h = sv_h + CUST.SIVAL.srlNum + ","
						PRINT(sv_h)
						
						sv_i = sv_i + 1
						PRINT(sv_i)
						#}
					ELSE
						#{
						CUST.SIVAL.refNo = BANCS.OUTPARAM.REFNUM
						PRINT(CUST.SIVAL.refNo)
						CUST.SIVAL.name  = BANCS.OUTPARAM.NAME
						PRINT(CUST.SIVAL.name)
						CUST.SIVAL.var1  = "For " + CUST.SIVAL.name + " Policy No. " + CUST.SIVAL.refNo
						PRINT(CUST.SIVAL.var1)
						sv_u = urhk_SRV_SetVal("subInstrLL." +sv_r+ ".prDtlLL." +sv_t+ ".particulars| " + CUST.SIVAL.var1)
						#					sv_u = urhk_SRV_SetVal()
						BANCS.OUTPUT.successOrFailure = "F"
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		PRINT(CUST.SIVAL.tranAmt)
		CUST.SIVAL.var2 = "."
		PRINT(CUST.SIVAL.var2)
		#CUST.SIVAL.amt = LEFT$(CUST.SIVAL.tranAmt,(STRLEN(CUST.SIVAL.tranAmt) - GETPOSITION(CUST.SIVAL.tranAmt,"|")))
		CUST.SIVAL.amt = LEFT$(CUST.SIVAL.tranAmt,GETPOSITION(CUST.SIVAL.tranAmt,"|") - 1)
		PRINT(CUST.SIVAL.amt)
		CUST.SIVAL.amtPos = getposition(CUST.SIVAL.amt , CUST.SIVAL.var2)
		PRINT(CUST.SIVAL.amtPos)
		CUST.SIVAL.amtLen = STRLEN(CUST.SIVAL.amt)
		PRINT(CUST.SIVAL.amtLen)
		CUST.SIVAL.getVal = MID$(CUST.SIVAL.amt,CINT(CUST.SIVAL.amtPos),CINT(CUST.SIVAL.amtLen))
		PRINT(CUST.SIVAL.getVal)
		IF (CINT(CUST.SIVAL.getVal) > 0) THEN
		#{
			CUST.SIVAL.intNum = CINT(CUST.SIVAL.getVal)/5
			PRINT(CUST.SIVAL.intNum)
			CUST.SIVAL.doubNum = CDOUBLE(CUST.SIVAL.getVal)/5
			PRINT(CUST.SIVAL.doubNum)
			IF (CDOUBLE(CUST.SIVAL.doubNum) > CDOUBLE(CUST.SIVAL.intNum)) THEN
			#{
				sv_j = sv_j + CUST.SIVAL.srlNum + ","
				PRINT(sv_j)
				
				sv_k = sv_k + 1
				PRINT(sv_k)
				sv_u = urhk_SRV_SetVal("subInstrLL." +sv_r+ ".prDtlLL." +sv_t+ ".ptranAmt| ")
			#}
			ENDIF
		#}
		ENDIF
		
		sv_l = sv_l + 1
		PRINT(sv_l)
	#}
	DO
	
	
	IF (sv_b > 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		sv_a = RTRIM(sv_a,',')
		sv_a = "The Particulars field should be left blank for the part tran srl no : " + sv_a
		PRINT(sv_a)
		sv_u = urhk_SRV_SetErr(sv_a)
	#}
	ENDIF
	
	IF (sv_e  > 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		sv_c = RTRIM(sv_c,',')
		sv_c = "Please Enter transacion Particulars in the Particulars field for the part tran srl no : " + sv_c
		PRINT(sv_c)
		sv_u = urhk_SRV_SetErr(sv_c)
	#}
	ENDIF
	
	IF (sv_g > 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		sv_f = RTRIM(sv_f,',')
		sv_f = "Enter the ADMIN/REG/POLICY NO in the Ref Num field for the part tran srl no : " + sv_f
		PRINT(sv_f)
		sv_u = urhk_SRV_SetErr(sv_f)
	#}
	ENDIF
	
	
	IF (sv_i > 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		sv_h = RTRIM(sv_h,',')
		sv_h = "Invalid ADMIN/REG/PLOCY number for the part tran srl no : " + sv_h
		PRINT(sv_h)
		sv_u = urhk_SRV_SetErr(sv_h)
	#}
	ENDIF
	
	IF (sv_k > 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		sv_j = RTRIM(sv_j,',')
		sv_j = "Decimal value should be multiple of 5 cents for the part tran srl no : " + sv_j
		PRINT(sv_j)
		sv_u = urhk_SRV_SetErr(sv_j)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.SIVAL.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.SIVAL.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
