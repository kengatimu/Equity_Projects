
#----------------------------------------------------------------------------------------------------------
# Filename              :       OutwardRejectUpl_PostChqDetails.scr
# Description           :       Script calling SRV for doing outward rejection
# Input                 :       none
# Output                :       None
# Called Script         :       None
#				
# Modification History
# Sl. #           Date             Author             Modification          				 Version
# -----           -----           --------          ----------------       			 	---------
#  1           20-06-2013      	 Anik Soni         Original Version         				1.0
#  2		08-06-2013	 Anik Soni	Changed service input from sort code to bank/br code	2.0 
#-----------------------------------------------------------------------------------------------------------

<--START
TRACE ON

	CUST.INTERFACE.showError = ""
	CUST.INTERFACE.callFlg = ""
	print(CUST.INTERFACE.oclgZoneDate)

	#--------------------------------------------------------------------------------
	# Setting inputs and outputs for SRV_AddTransferTran.
	#--------------------------------------------------------------------------------
	sv_a = urhk_SetUrhkInp("zoneDtl.zone.zoneCode|" +CUST.INTERFACE.inwZoneCode)
	sv_a = urhk_SetUrhkInp("zoneDtl.sol.solId|" + CUST.INTERFACE.SolId)
	sv_a = urhk_SetUrhkInp("zoneDtl.zoneDate|" + CUST.INTERFACE.ZoneDate)
	sv_a = urhk_SetUrhkInp("instrmntDtl.instrmntNum|" + CUST.INTERFACE.InstNum)
	sv_a = urhk_SetUrhkInp("instrmntDtl.instrmntType.type|CHQ" )
	sv_a = urhk_SetUrhkInp("instrmntDtl.instrmntAmt|"+ CUST.INTERFACE.InstAmt +"|"+ CUST.INTERFACE.ZoneCcy)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.rejType.code|O" )
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.rejCode1.rejectCode|" + CUST.INTERFACE.RejResCode)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSol.solId|" + CUST.INTERFACE.oSolId)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejZone.zoneCode|" + CUST.INTERFACE.clgZoneCode)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSetNum|" + CUST.INTERFACE.oSetNum)

	sv_a = urhk_ExecSrvNoCommit("SRV_FetchIcZoneDtlWithLock|retain_all_output = Y")

	IF(sv_a != "0") THEN
	#{

		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF

	#sv_u = urhk_B2k_PrintRepos("BANCS")
	#print(sv_u)

	#--------------------------------------------------------------------------------
	# Calling the service to copy all details.
	#--------------------------------------------------------------------------------
	sv_a = urhk_CopyOutToIn("")
	print(sv_a)

	sv_a = urhk_SetUrhkInp("zoneDtl.zone.zoneCode|" +CUST.INTERFACE.inwZoneCode)
	sv_a = urhk_SetUrhkInp("zoneDtl.sol.solId|" + CUST.INTERFACE.userSolId)
	sv_a = urhk_SetUrhkInp("zoneDtl.zoneCrncy.crncyCode|" + CUST.INTERFACE.ZoneCcy)
	sv_a = urhk_SetUrhkInp("zoneDtl.zoneDate|" + CUST.INTERFACE.ZoneDate)

	sv_a = urhk_SetUrhkInp("instrmntDtl.instrmntNum|" + CUST.INTERFACE.InstNum)
	sv_a = urhk_SetUrhkInp("instrmntDtl.instrmntType.type|CHQ" )
	sv_a = urhk_SetUrhkInp("instrmntDtl.instrmntAmt|" + CUST.INTERFACE.InstAmt +"|"+ CUST.INTERFACE.ZoneCcy)
	sv_a = urhk_SetUrhkInp("instrmntDtl.draweeBr.bankCode|" + CUST.INTERFACE.oBankCode)
        sv_a = urhk_SetUrhkInp("instrmntDtl.draweeBr.brCode|" + CUST.INTERFACE.oBrCode)
	sv_a = urhk_SetUrhkInp("instrmntDtl.rejType.code|O" )
	sv_a = urhk_SetUrhkInp("instrmntDtl.lstdFlg|Y")
	sv_a = urhk_SetUrhkInp("instrmntDtl.rcvdFlg|Y")
	sv_a = urhk_SetUrhkInp("instrmntDtl.sttlmntToAcctRtCode.refCode|MEAN")
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.rejType.code|O" )
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.rejCode1.rejectCode|" + CUST.INTERFACE.RejResCode)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSol.solId|" + CUST.INTERFACE.oSolId)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejZone.zoneCode|" + CUST.INTERFACE.clgZoneCode)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneSetNum|" + CUST.INTERFACE.oSetNum)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejZoneDate|" +CUST.INTERFACE.oclgZoneDate)
	sv_a = urhk_SetUrhkInp("instrmntRejDtl.outRejInstrmntSrlNum|" + CUST.INTERFACE.oInstSrNum)

	sv_a = urhk_SetUrhkInp("instrmntDtl.acct.foracid|" +CUST.INTERFACE.CrAcct)
	sv_a = urhk_SetUrhkInp("instrmntDtl.tranAmt|" +CUST.INTERFACE.InstAmt +"|"+ CUST.INTERFACE.ZoneCcy)
	sv_a = urhk_SetUrhkInp("instrmntDtl.carveFlg|N")

	sv_a = urhk_SetUrhkInp("instrmntDtl.presBr.brCode|" + CUST.INTERFACE.oBrCode)
	sv_a = urhk_SetUrhkInp("instrmntDtl.presBr.bankCode|" + CUST.INTERFACE.oBankCode)

	#--------------------------------------------------------------------------------
	# Calling the service to Add details for outward rejection.
	#--------------------------------------------------------------------------------
	sv_d = urhk_ExecSrvNoCommit("SRV_AddIcTranDtl|same_user_verify = Y|retain_all_output = Y|call_mode = N")
	print(sv_d)
	IF(sv_d != "0") THEN
	#{

		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF
	
	sv_a = urhk_CopyOutToIn("")
	print(sv_a)
	
	sv_d = urhk_ExecSrvNoCommit("SRV_FetchIcTranDtlForVerify|same_user_verify = Y|retain_all_output = Y|call_mode = N")
	print(sv_d)
	IF(sv_d != "0") THEN
	#{

		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF
	
	sv_a = urhk_CopyOutToIn("")
	print(sv_a)
		
	sv_d = urhk_ExecSrvNoCommit("SRV_VerifyIcTranDtl|same_user_verify = Y|retain_all_output = Y|call_mode = N")
	print(sv_d)
	IF(sv_d != "0") THEN
	#{

		CUST.INTERFACE.srvErrFlg = "Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF

EXITSCRIPT
END-->

