<--START
TRACE ON
LIBNAME CUSTOMSO
IF (REPEXISTS("CUST")==0) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","HINTTM")==0) THEN
#{
    CREATECLASS("CUST","HINTTM",5)
#}
ENDIF

CUST.HINTTM.fileName			=	"/finacle/anoop/UploadTDA.txt"
print(CUST.HINTTM.fileName)
CUST.HINTTM.logFile			=	"HINTTM.log"
#---------------------
# Access the file
#---------------------
sv_a = urtn_fileAccess(CUST.HINTTM.fileName)
sv_d = urtn_fileOpen(CUST.HINTTM.logFile + "|a")
IF (sv_d < 0) THEN
#{
    print("Error in Reading the file")
    GOTO ENDOFSCRIPT
#}
ENDIF
print(sv_a)
IF (sv_a != 0) THEN
#{
	print(" Input file File Not Accessible")
	sv_w = urtn_fileWrite(sv_d + "|Input file File Not Accessible" )

	GOTO ENDOFSCRIPT
#}
ENDIF
#---------------------
# Open the file
#---------------------

sv_b = urtn_fileOpen(CUST.HINTTM.fileName + "|r")
print(sv_b)
IF (sv_b < 0) THEN
#{
	print("Unable To Open File")
	sv_w = urtn_fileWrite(sv_d + "|Unable To Open Upload File" )
	GOTO ENDOFSCRIPT
#}
ENDIF
#---------------------
# Read record FROM the file 
#---------------------
sv_c = urtn_fileRead(sv_b + "|CUST.HINTTM.inputRecord")
print(sv_c)
IF (sv_c != 0) THEN
#{
	print("Upload File has no records")
	sv_w = urtn_fileWrite(sv_d + "|Upload File has no records" )
	GOTO ENDOFSCRIPT
#}
ENDIF
sv_w = urtn_fileWrite(sv_d + "|The Below A/c are processed" )
sv_w = urtn_fileWrite(sv_d + "|Foracid          | Success/Failure Ind     |  Message  " )
WHILE ( sv_c == 0)
#{
	print(sv_c)
	CUST.HINTTM.foracid = CUST.HINTTM.inputRecord
	print(CUST.HINTTM.foracid)

	#------------------------------------------------------
	# Fetch interest details.
	#------------------------------------------------------

	sv_a = urhk_SetUrhkInp("IntTblCrit.entityType.type|ACCNT")
	print(sv_a)
	sv_a = urhk_SetUrhkInp("IntTblCrit.entityId.entityType|ACCNT")
	print(sv_a)
	
	#------------------------------------------------------
	# Entity Id is Foracid
	#------------------------------------------------------
	
	sv_a = urhk_SetUrhkInp("IntTblCrit.entityId.entityId|" + CUST.HINTTM.foracid)
	print(sv_a)
	sv_a = urhk_SetUrhkInp("IntTblCrit.entityId.entityDispId|" + CUST.HINTTM.foracid)
	print(sv_a)

	
	#-------------------------------
	#service execution
	#-------------------------------

	sv_a = urhk_ExecSRV("SRV_FetchIntTblDtlForModify|retain_all_output = Y")
	print(sv_a)

	IF (sv_a != 0) THEN
   	#{
		CALL("trapErrorOrExcpn.scr")
		CUST.HINTTM.Status = "F"
		PRINT(ERROR.HINTTM.Status)
		PRINT(ERROR.HINTTM.MessageField)
		CUST.HINTTM.message = ERROR.HINTTM.MessageField
		GOTO CONT
	#}
	ENDIF

	#------------------------------------------------------
	# Modify fetched interest details.
	#------------------------------------------------------

	sv_a = urhk_CopyOutToIn("")
	print(sv_a)

	#sv_a = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.key.serial_num|1")
	#print(sv_a)

	#-------------------------------
	#service execution
	#-------------------------------

	sv_a = urhk_ExecSRV("SRV_ModifyIntTblDtlAndVerify|same_user_verify = Y|retain_all_output = Y")
	print(sv_a)

	IF (sv_a != 0) THEN
	#{
		#CALL("trapErrorOrExcpn.scr")
		CUST.HINTTM.Status = "F"
		PRINT(ERROR.HINTTM.Status)
		PRINT(ERROR.HINTTM.MessageField)
		CUST.HINTTM.message = ERROR.HINTTM.MessageField
		sv_w = urtn_fileWrite(sv_d + "|" + CUST.HINTTM.foracid + "    |      " + CUST.HINTTM.Status  + "         | " +  CUST.HINTTM.message)
		GOTO CONT
	#}
	ELSE
	#{
	CUST.HINTTM.Status = "S"
	print(CUST.HINTTM.Status)
	sv_w = urtn_fileWrite(sv_d + "|" + CUST.HINTTM.foracid + "    |           " + CUST.HINTTM.Status + "          | " +  "Successful")
	#}
	ENDIF

	CONT:
	sv_c = urtn_fileRead(sv_b + "|CUST.HINTTM.inputRecord")

#}
DO



ENDOFSCRIPT:
sv_u = urtn_fileClose(sv_d)
print(sv_u)
sv_u = urtn_fileClose(sv_b)
print(sv_u)

IF(CLASSEXISTS("CUST", "HINTTM")) THEN
	DELETECLASS("CUST", "HINTTM")
ENDIF
EXITSCRIPT
TRACE OFF
END-->
