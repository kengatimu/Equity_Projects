<--start
trace on

sv_a=urhk_B2k_PrintRepos("BANCS")

	sv_a = REPEXISTS("STDWFS")
        IF (sv_a == 0) THEN
                CREATEREP("STDWFS")
        ENDIF

        sv_a = CLASSEXISTS("STDWFS", "GLBDATA")
        IF (sv_a == 0) THEN
                CREATECLASS("STDWFS", "GLBDATA", 5)
        ENDIF

	 IF (FIELDEXISTS(BANCS.INPUT.dco) == 1) THEN
		STDWFS.GLBDATA.dco=TOUPPER(TRIM(BANCS.INPUT.dco))
		print(STDWFS.GLBDATA.dco)

		sv_u="count|select count(1) from tbaadm.cmg where cmg.BANK_ID = ?SVAR" 
		sv_u= sv_u + "AND cif_id= ?SVAR"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  STDWFS.GLBDATA.dco
		print(BANCS.INPARAM.BINDVARS)

		sv_r =  urhk_dbSelectWithBind(sv_u)
		print(sv_r)

		IF (sv_r ==0) THEN
		#{
			STDWFS.GLBDATA.count = TRIM(BANCS.OUTPARAM.count)
			print (STDWFS.GLBDATA.count)
		#}
		ELSE
		#{
			STDWFS.GLBDATA.count = " "
		#}
		ENDIF

		sv_z = urhk_SetOrbOut("output|"+ STDWFS.GLBDATA.count)
		print(sv_z)
	ENDIF

trace off
end-->


