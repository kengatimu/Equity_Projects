			sv_s = sv_s + " AND TRAN_DATE = ?SVAR "
			sv_s = sv_s + " AND BANK_ID = ?SVAR and PART_TRAN_TYPE='C' "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.refNoCr + "|" + CUST.CIETXN.tranid + "|" + CUST.CIETXN.getboddate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_w = urhk_dbSQLWithBind(sv_s)
			print(sv_w)
