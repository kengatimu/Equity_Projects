			sv_s = "UPDATE TBAADM.DTD SET REF_NUM = ?SVAR WHERE TRAN_ID = LPAD(?SVAR,9)"
			sv_s = sv_s + " AND TRAN_DATE = ?SVAR "
			sv_s = sv_s + " AND BANK_ID = ?SVAR and PART_TRAN_TYPE='D' "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.refNoDr + "|" + CUST.CIETXN.tranid + "|" + CUST.CIETXN.getboddate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_w = urhk_dbSQLWithBind(sv_s)
			print(sv_w)
