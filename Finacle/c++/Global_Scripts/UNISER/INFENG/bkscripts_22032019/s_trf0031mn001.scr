	IF(CLASSEXISTS("CUST","TRF0031") == 0) THEN
	#{
		CREATECLASS("CUST","TRF0031",5)
	#}
	ENDIF
	
	
	CUST.TRF0031.fedWireSortCode=""
	CUST.TRF0031.remtId=""
	CUST.TRF0031.errorMsg =""
	#---------------------------------------------------------------------------------------------
	#User hook used to get menu id from screen
	#---------------------------------------------------------------------------------------------
	IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1) THEN
	#{
		#sv_a=urhk_b2k_PRINTrepos("BANCS")
		CUST.TRF0031.menuId = BANCS.STDIN.menuId
		PRINT(CUST.TRF0031.menuId)
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_a=urhk_SRV_GetVal("remCritDtls.remitId")
	PRINT(sv_a)
	IF(sv_a == 0) THEN
	#{
		CUST.TRF0031.remtId = trim(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.TRF0031.remtId)
		#}
	ELSE
		#{
		CUST.TRF0031.errorMsg = "Unable to get remtId from front end"
		sv_v = urhk_SRV_SetErr(CUST.TRF0031.errorMsg)
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------------------------
	#User hook used to get dc Number from screen
	#---------------------------------------------------------------------------------------------
	PRINT(ONS.CUSTOM.custDataIn)
	IF(STRLEN(ONS.CUSTOM.custDataIn) > 0) THEN
	#{
		IF (CUST.TRF0031.menuId == "HORM") THEN
		#{
			sv_d = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)
			PRINT(sv_d)
			
			IF(FIELDEXISTS(BANCS.INPUT.ormpartydtl_FIELD_1) ==1) THEN
			#{
				CUST.TRF0031.fedWireSortCode = BANCS.INPUT.ormpartydtl_FIELD_1
				PRINT(CUST.TRF0031.fedWireSortCode)
				#}
			ELSE
				#{
				CUST.TRF0031.fedWireSortCode = ""
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.TRF0031.fedWireSortCode != "") THEN
	#{
		sv_s=""
		sv_s = sv_s + " INSERT INTO CUSTOM.C_PTYDTL(sl_num,remt_id,fed_sort_num,entity_cre_flg,rcre_user_id,rcre_time,del_flg,bank_id) "
		sv_s = sv_s + " VALUES ("
		sv_s = sv_s + " CUSTOM.seq.nextval"
		sv_s = sv_s + ",?SVAR "
		sv_s = sv_s + ",?SVAR "
		sv_s = sv_s + ",'N' "
		sv_s = sv_s + ",?SVAR "
		sv_s = sv_s + ",sysdate "
		sv_s = sv_s + ",'N' "
		sv_s = sv_s + ",?SVAR "
		sv_s = sv_s + ")"
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS	= ""
		BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ CUST.TRF0031.remtId + "|"
		BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+CUST.TRF0031.fedWireSortCode+ "|"
		BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.userId + "|"
		BANCS.INPARAM.BINDVARS 	= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		
		IF ( sv_d == 0) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			#}
		ELSE
			#{
			sv_d = urhk_dbSQLWithBind("ROLLABACK")
			CUST.TRF0031.errorMsg = "Unable to get FedWire/SortCode from front end"
			sv_v = urhk_SRV_SetErr(CUST.TRF0031.errorMsg)
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
