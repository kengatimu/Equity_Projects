	PRINT(STDWFS.GLBDATA.myBrCode)
	
	STDWFS.GLBDATA.tran_id = COLL.GLBDATA.tran_id
	PRINT(STDWFS.GLBDATA.tran_id)
	
	BANCS.INPUT.moduleName  = "TMCHARGES"
