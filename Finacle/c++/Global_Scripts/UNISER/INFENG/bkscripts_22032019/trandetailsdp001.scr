<--START
CHECKSUM="edbbe0b37a4ce3a04465760c4e77fb19eef5d167095597a7676066a3e5e208b4"
	TRACE ON
	
	
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	# 	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("STDWFS") == 0) THEN
	#{
		CREATEREP("STDWFS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("STDWFS","GLBDATA") == 0) THEN
	#{
		CREATECLASS("STDWFS","GLBDATA",5)
	#}
