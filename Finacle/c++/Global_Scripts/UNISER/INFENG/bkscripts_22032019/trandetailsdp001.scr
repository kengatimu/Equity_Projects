		#}
	ELSE
		#{
		STDWFS.GLBDATA.errMsg = "Branch Code setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CNTYCD"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		STDWFS.GLBDATA.cntyCd = BANCS.OUTPUT.parameterVal
		PRINT(STDWFS.GLBDATA.cntyCd)
		#}
	ELSE
		#{
		STDWFS.GLBDATA.errMsg = "Cnty Cd setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#-------------------------------------------------------------------------------------------------------
	# Get the trantype and transubtype
