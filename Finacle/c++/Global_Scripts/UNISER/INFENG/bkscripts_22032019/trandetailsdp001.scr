	STDWFS.GLBDATA.account = COLL.GLBDATA.account
	PRINT(STDWFS.GLBDATA.account)
	
	
	#------------------------------------------------------------------------------
	# Checking if the account number is there and if its there get the account infomation
	# Ensure the remarks field is entered and the ref num field
	#------------------------------------------------------------------------------
	sv_s = "bacid,solid,schmCode,glheadcode,custid|"
	sv_s = sv_s + "SELECT bacid,sol_id,schm_Code,gl_sub_head_code,cust_id "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE foracid = ?SVAR "
	sv_s = sv_s + "AND acct_cls_flg != 'Y' "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.account + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		STDWFS.GLBDATA.glheadcode = BANCS.OUTPARAM.glheadcode
		PRINT(STDWFS.GLBDATA.glheadcode)
		
		STDWFS.GLBDATA.bacid = BANCS.OUTPARAM.bacid
		PRINT(STDWFS.GLBDATA.bacid)
		
		STDWFS.GLBDATA.solid = BANCS.OUTPARAM.solid
		PRINT(STDWFS.GLBDATA.solid)
		
		STDWFS.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(STDWFS.GLBDATA.schmCode)
		
		STDWFS.GLBDATA.custid = BANCS.OUTPARAM.custid
		PRINT(STDWFS.GLBDATA.custid)
		
		STDWFS.GLBDATA.accnt = MID$(STDWFS.GLBDATA.account,3,13)
		PRINT (STDWFS.GLBDATA.accnt)
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "accountnum|"
	sv_s = sv_s + "SELECT foracid "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE acid IN("
	sv_s = sv_s + "SELECT acid "
	sv_s = sv_s + "FROM TBAADM.DTD "
	sv_s = sv_s + "WHERE tran_id = LPAD(?SVAR,9) "
	sv_s = sv_s + "AND part_tran_srl_num = LPAD('1',4) "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + " AND TRAN_DATE = to_date(?SVAR,'dd-mm-yyyy')"
	sv_s = sv_s + "AND bank_id = ?SVAR) "
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.tran_id + "|" + BANCS.STDIN.BODDate + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		STDWFS.GLBDATA.accountnum = BANCS.OUTPARAM.accountnum
		PRINT(STDWFS.GLBDATA.accountnum)
		#}
	ELSE
		#{
		STDWFS.GLBDATA.accountnum = ""
	#}
	ENDIF
	
	PRINT(BANCS.STDIN.BODDate)
	PRINT(STDWFS.GLBDATA.custid)
	PRINT(BANCS.STDIN.userId)
	
	#sv_s = "UPDATE bio.EQB_TRAN_VAL@GRUGBIO.US.ORACLE.COM  SET "
	#sv_s = sv_s + " tran_id = ?SVAR "
