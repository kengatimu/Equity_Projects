#----------------------------------------------------------------------------------------------------------
# Filename              :       AccessInq_main.scr
# Author                :       Swati Ganjoo
# Description           :       This script gets called from FI url executeFinacleScript and displays the 
#                               Access details for a user.
# Input                 :       Request XML
# Output                :       Response XML
# Called Script         :       Common_Interface_CreateRepos.scr, AccessInq_FetchAndValInpDtls.scr,
#                               AcccesInq_FetchUserDtl.scr,AccessInq_SendResponse.scr 
# Calling Script        :       None                                                            
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Swati Ganjoo      Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
#TRACE ON


	# Script body goes here
	#========================================================	
	# Create Repository
	#========================================================
	call("Common_Interface_CreateRepos.scr")
	
	#========================================================	
	# Initialization
	#========================================================
	CUST.INTERFACE.successOrFailure="S"
	
	#========================================================	
	# Calling script for validating the inputs
	#========================================================
	
	CALL("AccessInq_FetchAndValInpDtls.scr")
	
	#========================================================	
	# Calling script to fetch the details as a part of response
	#========================================================
	
	CALL("AccessInq_FetchUserDtl.scr")
	
	#========================================================	
	# Calling script to fetch the details as a part of response
	#========================================================
	
	CALL("AccessInq_SendResponse.scr")
	
	#========================================================	
	# Error Handling
	#========================================================
	ERROREXIT:
		IF(CUST.INTERFACE.successOrFailure=="F")THEN
		#{
			CUST.INTERFACE.srvErrFlg="N"
			CALL("Common_Interface_ErrorExit.scr")
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	
	
	ENDOFSCRIPT:
		TRACE OFF
		EXITSCRIPT
	
TRACE OFF
end-->
