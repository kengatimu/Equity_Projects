#########################################################################
RECORDLAYOUT

SOL_ID		 stringType
FORACID		 stringtype
ACCT_NAME	 stringtype
RCRE_USER_ID	 stringType
MOP_ID		 stringtype
AUDIT_BOD_DATE	 stringtype


####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 97
columnsperline 97
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 83 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
 begin
        execute pipe	
	print SOL_ID  column 6
	print FORACID      column 14
	print ACCT_NAME     column 30
	print RCRE_USER_ID   column 58		
	print MOP_ID  column 71
	print AUDIT_BOD_DATE  column 85
	
	
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL ID" column  5
	print "ACC NUM"     COLUMN 14	
	print "ACC NAME"   column 30
	print "ENTERER_ID"   column  58
	print "MENU OPTION" column  71
	print "AUDIT DATE" column  85
	Separatorline
end 
	
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 83 center 
	nextline
	print branchName  size 83 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 83 center
	nextline
	print "UNVERIFIED ACCOUNT INTEREST RATE MODIFICATION(S) REPORT"  size 83 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 83 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 3
	print "|"   column 12
	print "|"   column 28
	print "|"   column 56
	print "|"   column 69
	print "|"   column 83
	print "|"   column 97
	
end


