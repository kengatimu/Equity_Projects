PROCEDURE tran_details

if partTranType  = "C" 
	begin

	if (pagenumber = 1) 
	begin
		if(postEmailInd = "EMAIL")
		begin
		print "REPORT!MAILID#"
			nextline
		end
	end
	print bankname size 40 center
	nextline
	print branchname size 40 center
	nextline
	IF tranType ="T"																			       	
	begin																					       	
	 print "UTILITY BILL PAYMENTS" size 40 center																	       	
	end																					       	
	Else																					       
	Begin
	if tranSubType = "NR"
		print "UTILITY BILL PAYMENTS" size 40 center
	else
		print "UTILITY BILL PAYMENTS" size 40 center
	end

	if foracid="1012200698354"
	begin
	nextline
	nextline
	print "BANK REF NO: " column 1
	print tran_id
	nextline
	nextline
	print "TRANSACTION DATE: " column 1
	print tranDate size 10
	nextline
	nextline
	end
	ELSE
	begin
	nextline
	nextline
	print "BILL PAY REF NO: " column 1
	print tran_id
	nextline
	nextline
	print "TRANSACTION DATE: " column 1
	print tranDate size 10
	nextline
	nextline
	end
 end

