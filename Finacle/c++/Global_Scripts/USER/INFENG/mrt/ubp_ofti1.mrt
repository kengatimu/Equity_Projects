			set var6 = substr lv_var10 var8 var7
			print var6 column 11 size 10
			set var7 = var4-var3-1
			set var8 = var3+1
			set var6 = substr lv_var10 var8  var7
			print var6  column 19 size 6
			set var7 = var5-var4
			set var8 = var4+1
			set var6 = substr lv_var10 var8  var7
			print var6  size 15  rightjustify 
			nextline
		end

		if((lv_var11 != "") AND (lv_var11 != "0"))
		begin
			set var2 = getPos lv_var11 "!"
			set var3 = getPos lv_var11 "-"
			set var4 = getPos lv_var11 "|"
			set var5 = strlen lv_var11
			set var7 = var2-1
			set var6 = substr lv_var11 1  var7
			print var6 column 1
			set var7 = var3-var2-1
			set var8 = var2+1
			set var6 = substr lv_var11 var8 var7
			print var6 column 11 size 10
			set var7 = var4-var3-1
			set var8 = var3+1
			set var6 = substr lv_var11 var8  var7
			print var6  column 19 size 6
			set var7 = var5-var4
			set var8 = var4+1
			set var6 = substr lv_var11 var8  var7
			print var6  size 15  rightjustify 
			nextline
		end

		if((lv_var12 != "") AND (lv_var12 != "0"))
		begin
			set var2 = getPos lv_var12 "!"
			set var3 = getPos lv_var12 "-"
			set var4 = getPos lv_var12 "|"
			set var5 = strlen lv_var12
			set var7 = var2-1
			set var6 = substr lv_var12 1  var7
			print var6 column 1
