PROCEDURE print_amount_in_words
begin
	print amtStr column 1
   if (amtlen1 >= amtlen)
	begin
		print "Only."
	end
	nextLine
end
##############################################################################
# PROCEDURE TOKEN 
##############################################################################
PROCEDURE TOKEN 
begin
	set callscript = runscript "ubptoken.scr" "tran_id" "lv_token_id|lv_units|lv_FxAdj|lv_Fuel|lv_Inflation"
end

##############################################################################
# PROCEDURE denom_print
##############################################################################
PROCEDURE denom_print
begin
	set callscript = runscript "ubpdp080.scr" "lv_tranid" "lv_denstatus|lv_var1|lv_var2|lv_var3|lv_var4|lv_var5|lv_var6|lv_var7|lv_var8|lv_var9|lv_var10|lv_var11|lv_var12|lv_var13|lv_var14|lv_var15|PBchk|lv_PBvalue"
	if lv_denstatus = "Y"  
		begin
		print "DENOMINATION CURRENCY:" column 1
		print tranCrncyCode size 3
		nextline
		nextline
		print "DENOM" column 1
		print "NOTE/COIN" column 8 size 10
		print "COUNT" column 19 size 6
		print "TOTAL" column 31 size 6
		nextline
		
		if((lv_var8 != "") AND (lv_var8 != "0"))
		begin
			set var2 = getPos lv_var8 "!"
			set var3 = getPos lv_var8 "-"
			set var4 = getPos lv_var8 "|"
			set var5 = strlen lv_var8
			set var7 = var2-1
			set var6 = substr lv_var8 1  var7
			print var6 column 1
			set var7 = var3-var2-1
			set var8 = var2+1
			set var6 = substr lv_var8 var8 var7
			print var6 column 11 size 10
			set var7 = var4-var3-1
			set var8 = var3+1
			set var6 = substr lv_var8 var8  var7
			print var6  column 19 size 6
			set var7 = var5-var4
			set var8 = var4+1
			set var6 = substr lv_var8 var8  var7 
			print var6 size 15 rightjustify 
			nextline
		end

		if((lv_var9 != "") AND (lv_var9 != "0"))
		begin
			set var2 = getPos lv_var9 "!"
			set var3 = getPos lv_var9 "-"
			set var4 = getPos lv_var9 "|"
			set var5 = strlen lv_var9
			set var7 = var2-1
			set var6 = substr lv_var9 1  var7
			print var6 column 1
			set var7 = var3-var2-1
			set var8 = var2+1
			set var6 = substr lv_var9 var8 var7
			print var6 column 11 size 10
			set var7 = var4-var3-1
			set var8 = var3+1
			set var6 = substr lv_var9 var8  var7
			print var6  column 19 size 6
			set var7 = var5-var4
			set var8 = var4+1
			set var6 = substr lv_var9 var8  var7
			print var6  size 15  rightjustify 
			nextline
		end

		if((lv_var10 != "") AND (lv_var10 != "0"))
		begin
			set var2 = getPos lv_var10 "!"
			set var3 = getPos lv_var10 "-"
			set var4 = getPos lv_var10 "|"
			set var5 = strlen lv_var10
			set var7 = var2-1
			set var6 = substr lv_var10 1  var7
			print var6 column 1
			set var7 = var3-var2-1
