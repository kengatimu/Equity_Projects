<--START	
TRACE ON

	if(repexists("CUST")==0)then
		createrep("CUST")
	endif
	if(classexists("CUST","DATA")==0)then
		createclass("CUST","DATA",5)
	endif

	IF(BANCS.STDIN.menuId=="HTM")THEN
	#{

	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	IF(sv_u == 0) THEN
	#{
			CUST.DATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.DATA.noOfRecords)
	#}
	ELSE
	#{
			sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
			BANCS.OUTPUT.successOrFailure="F"
			exitscript
	#}
	ENDIF
	
	sv_l = 0
	sv_m = ""
	sv_n = 0
	sv_a = "\n"
	sv_x = 0
	sv_z = 0
	sv_c = 0
	sv_e = 0
	
	WHILE(sv_l < CUST.DATA.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		
			#-------------------------------------------------------------------------------------------
			# Fetch A/c - foracid
			#-------------------------------------------------------------------------------------------
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
			lv_n = BANCS.OUTPARAM.srvValue
			print(lv_n)

			sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
			lv_o = BANCS.OUTPARAM.srvValue
			print (lv_o)

			sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
			lv_p = BANCS.OUTPARAM.srvValue
			print (lv_p)

			IF (lv_o =="T") THEN
			#{
				if(lv_n !="") then
				#{
					lv_q = urhk_getAcctDetailsInRepository(lv_n)
					if (lv_q == 0)then
					#{
						lv_r = BANCS.OUTPARAM.schmCode
						PRINT(lv_r)

						if((lv_r == "OD541") OR (lv_r == "OD542") OR (lv_r == "OD543") OR (lv_r == "OD544") OR (lv_r == "OD545") OR (lv_r == "OD546") OR (lv_r == "OD549") OR (lv_r == "DL002") OR (lv_r == "ML001") OR (lv_r == "TBL00") OR (lv_r == "OD112") OR (lv_r == "ODFDR") OR (lv_r == "OD553")) then
						#{
							sv_s = urhk_SRV_SetErr("HTM not allowed on Digital loans recovery, use CODLPAY menu")
							print (sv_s)
							exitscript
						#}
						endif
					#}
					endif		
				#}
				endif
			#}
			ENDIF

	sv_l = sv_l + 1
	print(sv_l)
	#}
	DO

	#}			
	ENDIF

TRACE OFF	
END-->