<--START
CHECKSUM="4cc975e9a2e1fa2786c2808326d2ba3c0c740dc7ea7075c1297d673e1a19424a"
	TRACE ON
	sv_a = urhk_b2k_printRepos("BANCS")
	print(sv_a)

	#------------------------------------------------------------------------------
