<--start
trace on

#--- This script retries transactions for EFT transactions
callscriptifexist("EftRetry.scr")

#--- This script retries transactions for SWIFT and RTGS transactions
callscriptifexist("Batch_KTDA_retry.scr")

#--- This script retries transactions for ISO transactions
callscriptifexist("MTT_Retries.scr")

EXITSCRIPT
