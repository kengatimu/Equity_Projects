	IF(sv_d==0) THEN
	#{
		CUST.CONTRACT.cntrctAmtOld=BANCS.OUTPARAM.cntrctAmtOld
		CUST.CONTRACT.CntrctperOld =BANCS.OUTPARAM.CntrctperOld
