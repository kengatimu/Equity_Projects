	BANCS.INPARAM.BINDVARS= CUST.CONTRACT.contractId+"|"+CUST.CONTRACT.acctNo+"|"+"Y|N"
	
	sv_s = " cntrctAmtOld,CntrctperOld|SELECT REQ_AMT, REQ_PERIOD  "
	#-----------------Modified for TO :371577--------------------------------------#
	sv_s = sv_s + " FROM CUSTOM.CATOD_SANCTION_TABLE  "
	#-----------------Modified for TO :371577--------------------------------------#
	sv_s = sv_s + " WHERE REQUEST_ID =?SVAR "
	sv_s = sv_s + " AND ACCT_NUM= ?SVAR "
	sv_s = sv_s + " AND ENTITY_CRE_FLG=?SVAR "
	sv_s = sv_s + " AND DEL_FLG =?SVAR "
	PRINT(sv_s)
	sv_d= urhk_dbSelectWithBind(sv_s)
