<--start
trace on
#Reps/Class
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("ONS")==0)then
                createrep("ONS")
        endif
        if(classexists("ONS","CUSTOM")==0)then
                createclass("ONS","CUSTOM",5)
        endif
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
#Inp
#+++
	EQSRV.GLBDATA.BefDisbClBal = "0"
	if(fieldexists(BANCS.INPUT.OdAcctId)==1)then
		EQSRV.GLBDATA.odAcctId = BANCS.INPUT.OdAcctId
	else
		EQSRV.GLBDATA.odAcctId = ""
	endif
	if(fieldexists(BANCS.INPUT.SanctionLimit)==1)then
		EQSRV.GLBDATA.SanctionLimit = BANCS.INPUT.SanctionLimit
	else
		EQSRV.GLBDATA.SanctionLimit = ""
	endif
	if(fieldexists(BANCS.INPUT.LoanAmount)==1)then
		EQSRV.GLBDATA.LoanAmount = BANCS.INPUT.LoanAmount
	else
		EQSRV.GLBDATA.LoanAmount = ""
	endif
	if(fieldexists(BANCS.INPUT.sanctionDate)==1)then
		EQSRV.GLBDATA.sanctionDate = mid$(BANCS.INPUT.sanctionDate,0,10)
		EQSRV.GLBDATA.sanctionDate = EQSRV.GLBDATA.sanctionDate + " 00:00:00"
	else
		EQSRV.GLBDATA.sanctionDate = ""
	endif
	if(fieldexists(BANCS.INPUT.expiryDate)==1)then
		EQSRV.GLBDATA.expiryDate = mid$(BANCS.INPUT.expiryDate,0,10)
		EQSRV.GLBDATA.expiryDate = EQSRV.GLBDATA.expiryDate + " 00:00:00" 
	else
		EQSRV.GLBDATA.expiryDate = ""
	endif
	if(fieldexists(BANCS.INPUT.reviewdate)==1)then
		EQSRV.GLBDATA.reviewdate = mid$(BANCS.INPUT.reviewdate,0,10)
		EQSRV.GLBDATA.reviewdate = EQSRV.GLBDATA.reviewdate + " 00:00:00" 
	else
		EQSRV.GLBDATA.expiryDate = ""
	endif
	EQSRV.GLBDATA.applcbldate = EQSRV.GLBDATA.sanctionDate 
	##EQSRV.GLBDATA.sanctionDate = "03-05-2021 00:00:00"
	##EQSRV.GLBDATA.expiryDate = "03-05-2022 00:00:00"
	##EQSRV.GLBDATA.reviewdate = "03-04-2022 00:00:00"
	if(EQSRV.GLBDATA.odAcctId!="")then
		sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.odAcctId)
		if(sv_u != 0)then
				sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|Invalid OD Loan Account")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
		else
			print(BANCS.OUTPARAM.sanctionLimit)
			print(BANCS.OUTPARAM.cleanAdhocLimit)
			print(BANCS.OUTPARAM.drawingPower)
			print(BANCS.OUTPARAM.usedUnclearOverDACC)
			print(BANCS.OUTPARAM.FXClearBalance)
			print(BANCS.OUTPARAM.ClearBalance)
			print(BANCS.OUTPARAM.FxAvailableAmt)
			print(BANCS.OUTPARAM.AvailableAmt)
			print(BANCS.OUTPARAM.ClearBalance)
			print(BANCS.OUTPARAM.DACCLimit)
			print(BANCS.OUTPARAM.FxFFDAvailableAmt)
			print(BANCS.OUTPARAM.FFDAvailableAmt)
			print(BANCS.OUTPARAM.lienAmt)
			print(BANCS.OUTPARAM.FxEffAvailableAmt)
			print(BANCS.OUTPARAM.EffAvailableAmt)
			print(BANCS.OUTPARAM.systemGeneratedLimit)
			print(BANCS.OUTPARAM.SystemReservedAmt)
			EQSRV.GLBDATA.EffBal = BANCS.OUTPARAM.EffAvailableAmt
			EQSRV.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
			EQSRV.GLBDATA.BefDisbClBal = BANCS.OUTPARAM.clearBalance
			EQSRV.GLBDATA.sanLim = BANCS.OUTPARAM.sanctionLimit
			EQSRV.GLBDATA.drawingPower = BANCS.OUTPARAM.drawingPower
			EQSRV.GLBDATA.avalAmt = BANCS.OUTPARAM.AvailableAmt
			EQSRV.GLBDATA.odSchmCode = BANCS.OUTPARAM.schmCode
			EQSRV.GLBDATA.acctCloseflg = BANCS.OUTPARAM.acctCloseflg
		endif
			sv_u = urhk_getAdvanceDetailsForAccount(EQSRV.GLBDATA.odAcctId)
			print(sv_u)
			if(sv_u==0)then
				EQSRV.GLBDATA.opacctiddd = BANCS.OUTPARAM.gacFreeText1
				EQSRV.GLBDATA.repayFeq = BANCS.OUTPARAM.gacFreeText2
			else
				EQSRV.GLBDATA.opacctiddd = ""
				EQSRV.GLBDATA.repayFeq = ""
			endif
			if(EQSRV.GLBDATA.repayFeq=="")then
				EQSRV.GLBDATA.repayFeq = "M"	
			endif

	else
		exitscript	
	endif
#++++++++++
	print(EQSRV.GLBDATA.acctCloseflg)
	if(EQSRV.GLBDATA.acctCloseflg=="Y")then
		print("not allowed")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Limit Modify and Disburse not allowed ! Loan Account Closed")
                goto EOS
	endif
	print(EQSRV.GLBDATA.LoanAmount)
	if(cdouble(EQSRV.GLBDATA.LoanAmount)>cdouble(EQSRV.GLBDATA.SanctionLimit))then
		print("not allowed")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Limit Modify and Disburse not allowed ! Loan Amount Exceeds Sanction Amount")
                goto EOS
	endif
	if(cdouble(EQSRV.GLBDATA.LoanAmount)<=0)then
		print("not allowed")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Limit Modify and Disburse not allowed ! Invalid Loan Amount")
                goto EOS
	endif
	if(cdouble(EQSRV.GLBDATA.SanctionLimit)<=0)then
		print("not allowed")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Limit Modify and Disburse not allowed ! Invalid Sanction Amount")
                goto EOS
	endif
	print(EQSRV.GLBDATA.clearBalance)
	if(cdouble(EQSRV.GLBDATA.clearBalance)<=0)then
		EQSRV.GLBDATA.tmpClrAmt = -1 * cdouble(EQSRV.GLBDATA.clearBalance)
	else
		EQSRV.GLBDATA.tmpClrAmt = cdouble(EQSRV.GLBDATA.clearBalance)
	endif
	print(EQSRV.GLBDATA.SanctionLimit)
	print(EQSRV.GLBDATA.tmpClrAmt)
	print(EQSRV.GLBDATA.avalAmt)
	##if(cdouble(EQSRV.GLBDATA.SanctionLimit) > cdouble(EQSRV.GLBDATA.tmpClrAmt))then 
	##	print("allowed to overdraw")
	##	EQSRV.GLBDATA.Disbureamt = cdouble(EQSRV.GLBDATA.SanctionLimit) - cdouble(EQSRV.GLBDATA.tmpClrAmt)
		##EQSRV.GLBDATA.Disbureamt = cdouble(EQSRV.GLBDATA.SanctionLimit)
	##	print(EQSRV.GLBDATA.Disbureamt)
	##else
	##	print("not allowed")
	##	sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
	##	sv_u = urhk_SetOrbOut("Message|Limit Modify and Disburse not allowed ! Please check overdue and credit scoring")
        ##       goto EOS
	##endif
	lv_t = " intTblCode | select int_tbl_code from tbaadm.csp where bank_id=?SVAR and schm_code=?SVAR "
	lv_t = lv_t + " and crncy_code=?SVAR and del_flg='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odSchmCode + "|" + BANCS.STDIN.homeCrncyCode 
	print(lv_t)
	print(BANCS.INPARAM.BINDVARS)
	lv_u = urhk_dbSelectWithBind(lv_t)
	if(lv_u==0)then
		EQSRV.GLBDATA.intTblCode = BANCS.OUTPARAM.intTblCode
	else
		EQSRV.GLBDATA.intTblCode = ""
	endif
	lv_o = "odSolId,opSolId,opacctId,odAcid,opAcid | select od_sol_id,op_sol_id,op_acct_id,od_acid,op_acid from  "
	lv_o = lv_o + " custom.odla_disb_tbl where bank_id=?SVAR "
	lv_o = lv_o + " and od_acct_id=?SVAR "
	lv_o = lv_o + " and od_disb_tran_date is not null "
	lv_o = lv_o + " and od_disb_tran_id is not null "
	lv_o = lv_o + " and entity_cre_flg='Y' "
	lv_o = lv_o + " and del_flg='N' "
	lv_o = lv_o + " and rownum<=1 "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId
	print(lv_o)
	print(BANCS.INPARAM.BINDVARS)
	lv_b = urhk_dbSelectWithBind(lv_o)
	if(lv_b==0)then
		EQSRV.GLBDATA.oacctSolId = BANCS.OUTPARAM.odSolId
		EQSRV.GLBDATA.opacctSolId = BANCS.OUTPARAM.opSolId
		EQSRV.GLBDATA.OperativeAcctId = BANCS.OUTPARAM.opacctId
		EQSRV.GLBDATA.OdAcid = BANCS.OUTPARAM.odAcid
		EQSRV.GLBDATA.OperAcid = BANCS.OUTPARAM.opAcid
	else
		EQSRV.GLBDATA.odSolId = ""
		EQSRV.GLBDATA.opSolId = ""
		EQSRV.GLBDATA.OperativeAcctId = ""
		EQSRV.GLBDATA.OdAcid = ""
		EQSRV.GLBDATA.OperAcid = ""
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Invalid Operative Account")
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	endif
	sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.OperativeAcctId)
	if(sv_u != 0)then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Invalid Operative Account")
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	else
		print(BANCS.OUTPARAM.sanctionLimit)
		print(BANCS.OUTPARAM.cleanAdhocLimit)
		print(BANCS.OUTPARAM.drawingPower)
		print(BANCS.OUTPARAM.usedUnclearOverDACC)
		print(BANCS.OUTPARAM.FXClearBalance)
		print(BANCS.OUTPARAM.ClearBalance)
		print(BANCS.OUTPARAM.FxAvailableAmt)
		print(BANCS.OUTPARAM.AvailableAmt)
		print(BANCS.OUTPARAM.ClearBalance)
		print(BANCS.OUTPARAM.DACCLimit)
		print(BANCS.OUTPARAM.FxFFDAvailableAmt)
		print(BANCS.OUTPARAM.FFDAvailableAmt)
		print(BANCS.OUTPARAM.lienAmt)
		print(BANCS.OUTPARAM.FxEffAvailableAmt)
		print(BANCS.OUTPARAM.EffAvailableAmt)
		print(BANCS.OUTPARAM.systemGeneratedLimit)
		print(BANCS.OUTPARAM.SystemReservedAmt)
	endif
	

        EQSRV.GLBDATA.srvErrCode = ""
        EQSRV.GLBDATA.srvErrMsg = ""
        EQSRV.GLBDATA.srvSucFail = ""
	sv_a = urhk_SetUrhkInp("limitHdr.limitAcct.foracid|" + EQSRV.GLBDATA.odAcctId)
	print(sv_a)
	sv_a = urhk_SetUrhkOut("limitHdr.schmCookie|schmCookie")
	sv_a = urhk_SetUrhkOut("limitHdr.GAMCookie|GAMCookie")
	sv_a = urhk_SetUrhkOut("limitHdr.sanctLimit|sanctLimit")
	sv_a = urhk_SetUrhkOut("limitHdr.count|count")
	sv_a = urhk_SetUrhkOut("limitHdr.isLacType|isLacType")
	sv_a = urhk_SetUrhkOut("limitLL.<rec_0>.key.serial_num|serial_num")
	sv_a = urhk_SetUrhkOut("limitLL.<rec_0>.limitLevelIntFlg|limitLevelIntFlg")
	sv_a = urhk_SetUrhkOut("limitLL.<rec_0>.applicableDate|appldate")
	sv_u = urhk_ExecSrv("SRV_FetchAcctSanctLimitForModify|retain_all_output = Y")
	print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
                print("modify Fetch success")
		EQSRV.GLBDATA.schmCookie = BANCS.OUTPARAM.schmCookie
			print(EQSRV.GLBDATA.schmCookie)
		EQSRV.GLBDATA.GAMCookie = BANCS.OUTPARAM.GAMCookie
			print(EQSRV.GLBDATA.GAMCookie)
		EQSRV.GLBDATA.count  =  BANCS.OUTPARAM.count
			print(EQSRV.GLBDATA.count)
		EQSRV.GLBDATA.isLacType  =  BANCS.OUTPARAM.isLacType
			print(EQSRV.GLBDATA.isLacType)
		EQSRV.GLBDATA.serial_num = BANCS.OUTPARAM.serial_num
			print(EQSRV.GLBDATA.serial_num)
        else
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.odAcctId
                callscriptifexist("ebsrvHandler.scr")
                EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctSanctLimitForModify "
                EQSRV.GLBDATA.srvSucFail = "F"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.srvErrMsg ) 
                goto EOS
        endif
	sv_a = urhk_CopyOutToIn("")
	print(sv_a)
        sv_a = urhk_SetUrhkInp("limitHdr.limitAcct.foracid|" + EQSRV.GLBDATA.odAcctId)
        print(sv_a)
        sv_a = urhk_SetUrhkOut("limitHdr.schmCookie|schmCookie")
        sv_a = urhk_SetUrhkOut("limitHdr.GAMCookie|GAMCookie")
        sv_a = urhk_SetUrhkOut("limitHdr.sanctLimit|sanctLimit")
        sv_a = urhk_SetUrhkOut("limitHdr.count|count")
        sv_u = urhk_ExecSrv("SRV_InquireAcctSanctLimit|retain_all_output = Y")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
              print(BANCS.OUTPARAM.successOrFailure)
              sv_s = BANCS.OUTPARAM.successOrFailure
      	else
              sv_s = "X"
      	endif
	if (( sv_u == 0 ) and ( sv_s=="S") ) then
	      print(BANCS.OUTPARAM.schmCookie)
	      print(BANCS.OUTPARAM.GAMCookie)
	      print(BANCS.OUTPARAM.count)
	      EQSRV.GLBDATA.schmCookie = BANCS.OUTPARAM.schmCookie
	      EQSRV.GLBDATA.GAMCookie = BANCS.OUTPARAM.GAMCookie
	      EQSRV.GLBDATA.count = BANCS.OUTPARAM.count
	      print("Inquire success")
	else
	      EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.odAcctId
	      callscriptifexist("ebsrvHandler.scr")
	      EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
	      EQSRV.GLBDATA.srvErrCode = "Failed : SRV_InquireAcctSanctLimit "
	      EQSRV.GLBDATA.srvSucFail = "F"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.srvErrMsg ) 
		goto EOS
	endif
	##lv_c = cint(EQSRV.GLBDATA.count)
	lv_c = cint("0")
	print(lv_c)
	sv_a = urhk_CopyOutToIn("")
	print(sv_a)
	sv_a = urhk_SetUrhkInp("limitHdr.limitAcct.foracid|" + EQSRV.GLBDATA.odAcctId)
	##sv_a = urhk_SetUrhkInp("limitHdr.maxAlwdLimForAcct|" + EQSRV.GLBDATA.maxAllowedLimit + "|" + BANCS.STDIN.homeCrncyCode )
	sv_a = urhk_SetUrhkInp("limitHdr.maxAlwdLimForAcct|" + EQSRV.GLBDATA.SanctionLimit + "|" + BANCS.STDIN.homeCrncyCode )
	sv_a = urhk_SetUrhkInp("limitHdr.GAMCookie|" + EQSRV.GLBDATA.GAMCookie )
	sv_a = urhk_SetUrhkInp("limitHdr.schmCookie|" + EQSRV.GLBDATA.schmCookie )
	##EQSRV.GLBDATA.serial_num = cint(EQSRV.GLBDATA.count) + 1
	EQSRV.GLBDATA.serial_num = cint(EQSRV.GLBDATA.count)
	print(EQSRV.GLBDATA.serial_num)
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.key.serial_num|" + EQSRV.GLBDATA.serial_num )
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.applicableDate|" + EQSRV.GLBDATA.applcbldate)
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.sanctLimit|" + EQSRV.GLBDATA.SanctionLimit + "|" + BANCS.STDIN.homeCrncyCode )
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.limitLevelIntFlg|N")
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.supercedeFlg|N")
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.expiryDate|" + EQSRV.GLBDATA.expiryDate)
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.sanctDate|" + EQSRV.GLBDATA.sanctionDate)
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.limitPenaltyMth|0")
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.limitPenaltyDay|0")
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.limitPenaltyDate|" + EQSRV.GLBDATA.expiryDate )
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.loanPaperDate|" + EQSRV.GLBDATA.applcbldate ) 
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.limitReviewDate|" + EQSRV.GLBDATA.reviewdate)
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.sanctRefNum|23423")
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.sanctAuthCode.refCode|OTH")
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.sanctLevelCode.refCode|OTHER")
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.crncyCode|" + BANCS.STDIN.homeCrncyCode )	
	sv_a = urhk_SetUrhkInp("limitLL.<rec_" + FORMAT$(lv_c, "%d") + ">.recordFlg|Y")	

	sv_a = urhk_ExecSrvNoCommit("SRV_AddAcctSanctLimitAndVerify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg = I|call_mode=N")
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
	#{
                print("Sanction Limit Modified Successfully")
		###print(EQSRV.GLBDATA.Disbureamt)
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|CI")
		sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")
		sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")

		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode )
		##sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+EQSRV.GLBDATA.SanctionLimit+"|"+ BANCS.STDIN.homeCrncyCode )
		##sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+EQSRV.GLBDATA.Disbureamt+"|"+ BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+EQSRV.GLBDATA.LoanAmount+"|"+ BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+ EQSRV.GLBDATA.odAcctId )
