		##EQSRV.GLBDATA.drPart = "Dr:for " + EQSRV.GLBDATA.OperativeAcctId
		EQSRV.GLBDATA.drPart = "Disbursement for: " + EQSRV.GLBDATA.OperativeAcctId
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+ EQSRV.GLBDATA.drPart )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+ BANCS.STDIN.homeCrncyCode )
		##sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+EQSRV.GLBDATA.SanctionLimit+"|"+ BANCS.STDIN.homeCrncyCode )
		##sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+EQSRV.GLBDATA.Disbureamt+"|"+ BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+EQSRV.GLBDATA.LoanAmount+"|"+ BANCS.STDIN.homeCrncyCode )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+ EQSRV.GLBDATA.OperativeAcctId )
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
		EQSRV.GLBDATA.drRmks = "OD Disb"
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|"+ EQSRV.GLBDATA.drRmks )
		##EQSRV.GLBDATA.crPart = "OD Cr:from " + EQSRV.GLBDATA.odAcctId
		EQSRV.GLBDATA.crPart = "Disbursement:from " + EQSRV.GLBDATA.odAcctId
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+ EQSRV.GLBDATA.crPart )
		sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
		sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
		sv_u = urhk_ExecSrvNoCommit("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
		       print(BANCS.OUTPARAM.successOrFailure)
			if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
				callscriptifexist("ebsrvHandler.scr")
				if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
					EQSRV.GLBDATA.srvMsg    = EQSRV.GLBDATA.SrvError
					EQSRV.GLBDATA.srvErrorCode = "E0012"
					EQSRV.GLBDATA.srvSF     = "F"
					sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
					sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.srvMsg )
					goto EOS
				endif
			endif
			if((BANCS.OUTPARAM.successOrFailure=="S") and (sv_u==0))then
				print(BANCS.OUTPARAM.tranId)
				print(BANCS.OUTPARAM.tranDate)
				EQSRV.GLBDATA.disbTranId = BANCS.OUTPARAM.tranId
				EQSRV.GLBDATA.disbTranDate = BANCS.OUTPARAM.tranDate
			endif
		endif
		##if(cdouble(EQSRV.GLBDATA.SanctionLimit)>=1)then
		if(cdouble(EQSRV.GLBDATA.LoanAmount)>=1)then
			EQSRV.GLBDATA.lace = cdouble(EQSRV.GLBDATA.LoanAmount)*3/100
			print(EQSRV.GLBDATA.lace)
			EQSRV.GLBDATA.Insur = cdouble(EQSRV.GLBDATA.LoanAmount)*3/100
			print(EQSRV.GLBDATA.Insur)
			EQSRV.GLBDATA.totChrgAmt = cdouble(EQSRV.GLBDATA.lace) + cdouble(EQSRV.GLBDATA.Insur)
			print(EQSRV.GLBDATA.totChrgAmt)
			##EQSRV.GLBDATA.totChrgAmt = EQSRV.GLBDATA.SanctionLimit 
			EQSRV.GLBDATA.totChrgAmt = EQSRV.GLBDATA.LoanAmount 
			print(EQSRV.GLBDATA.totChrgAmt)
		else
			EQSRV.GLBDATA.totChrgAmt = 0
		endif
		if((EQSRV.GLBDATA.disbTranId!="") and (EQSRV.GLBDATA.disbTranDate!=""))then
			if(repexists("CUST")==0)then
				createrep("CUST")
			endif
			if(classexists("CUST","GCHRG")==0)then
				createclass("CUST","GCHRG",5)
			endif
			CUST.GCHRG.tranType = "T"
			CUST.GCHRG.tranSubType = "BI"
			CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
			CUST.GCHRG.chrgAmt = EQSRV.GLBDATA.totChrgAmt + "|" + BANCS.STDIN.homeCrncyCode
			CUST.GCHRG.eventId = "OD542LI"
			CUST.GCHRG.drAcctId = EQSRV.GLBDATA.OperativeAcctId 
			print(CUST.GCHRG.drAcctId)
			CUST.GCHRG.ModuleCode = "ODLOAN"
			call("gchrgcommon.scr")
			if(CUST.GCHRG.successOrFailure == "S")then
				print("Charge collected")
				print(CUST.GCHRG.chargeTranId)
				print(CUST.GCHRG.chargeTranDate)
			else
				CUST.GCHRG.chargeTranId = "NA"
				CUST.GCHRG.chargeTranDate = BANCS.STDIN.BODDate
				print("Failure")
			endif
		endif
		if((EQSRV.GLBDATA.disbTranId!="") and (EQSRV.GLBDATA.disbTranDate!=""))then
			lv_k = "disbRecNum|select max(nvl(free_text1,0))+1 from  custom.odla_disb_tbl  where bank_id=?SVAR "
			lv_k = lv_k + " and od_acct_id=?SVAR and od_acid=?SVAR "
			lv_k = lv_k + " and op_acct_id=?SVAR and op_acid=?SVAR "
			lv_k = lv_k + " and od_disb_tran_date is not null "
			lv_k = lv_k + " and od_disb_tran_id is not null and entity_cre_flg='Y' and del_flg='N' "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OdAcid + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OperAcid
			print(BANCS.INPARAM.BINDVARS)
			print(lv_k)
			lv_h = urhk_dbSelectWithBind(lv_k)
			if(lv_h==0)then
				EQSRV.GLBDATA.disbRecNum = BANCS.OUTPARAM.disbRecNum
			else
				EQSRV.GLBDATA.disbRecNum = 1
			endif
			lv_i = "insert into custom.odla_disb_tbl(bank_id,od_sol_id,op_sol_id,od_acct_id,op_acct_id,od_acid,op_acid,od_schm_code,od_sanct_lim,od_disb_amt,od_disb_tran_date,od_disb_tran_id,od_tot_comm_amt,od_comm_tran_date,od_comm_tran_id,is_resh_yn,resh_date,rcre_user_id,rcre_time,lchg_user_id,lchg_time,entity_cre_flg,del_flg,free_text1,free_text2,free_text3,free_text4,free_text5,free_text6) "
			lv_i = lv_i + " values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?NVAR,?NVAR,to_date(?SVAR,'DD-MM-RRRR'),?SVAR,?NVAR,to_date(?SVAR,'DD-MM-RRRR'),?SVAR,'N',sysdate,?SVAR,sysdate,?SVAR,sysdate,'Y','N',?SVAR,null,null,null,null,null) "
			##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.oacctSolId + "|" + EQSRV.GLBDATA.opacctSolId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OdAcid + "|" + EQSRV.GLBDATA.OperAcid + "|" + EQSRV.GLBDATA.odSchmCode + "|" + EQSRV.GLBDATA.SanctionLimit + "|" + EQSRV.GLBDATA.SanctionLimit + "|" + mid$(EQSRV.GLBDATA.disbTranDate,0,10) + "|" + EQSRV.GLBDATA.disbTranId + "|" + EQSRV.GLBDATA.totChrgAmt + "|" + mid$(CUST.GCHRG.chargeTranDate,0,10) + "|" + CUST.GCHRG.chargeTranId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.disbRecNum
			##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.oacctSolId + "|" + EQSRV.GLBDATA.opacctSolId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OdAcid + "|" + EQSRV.GLBDATA.OperAcid + "|" + EQSRV.GLBDATA.odSchmCode + "|" + EQSRV.GLBDATA.Disbureamt + "|" + EQSRV.GLBDATA.Disbureamt + "|" + mid$(EQSRV.GLBDATA.disbTranDate,0,10) + "|" + EQSRV.GLBDATA.disbTranId + "|" + EQSRV.GLBDATA.totChrgAmt + "|" + mid$(CUST.GCHRG.chargeTranDate,0,10) + "|" + CUST.GCHRG.chargeTranId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.disbRecNum
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.oacctSolId + "|" + EQSRV.GLBDATA.opacctSolId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OdAcid + "|" + EQSRV.GLBDATA.OperAcid + "|" + EQSRV.GLBDATA.odSchmCode + "|" + EQSRV.GLBDATA.LoanAmount + "|" + EQSRV.GLBDATA.LoanAmount + "|" + mid$(EQSRV.GLBDATA.disbTranDate,0,10) + "|" + EQSRV.GLBDATA.disbTranId + "|" + EQSRV.GLBDATA.totChrgAmt + "|" + mid$(CUST.GCHRG.chargeTranDate,0,10) + "|" + CUST.GCHRG.chargeTranId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.disbRecNum
			print(lv_i)
			print(BANCS.INPARAM.BINDVARS)
			lv_d = urhk_dbSqlWithBind(lv_i)
			if(lv_d==0)then
				lv_u = urhk_dbSqlWithBind("commit")
			###sv_s = "nohup babx4061 $B2K_SESSION_ID  ebodlaAclhmLarsh.scr " + EQSRV.GLBDATA.odAcctId + " " + EQSRV.GLBDATA.OperativeAcctId + " " + EQSRV.GLBDATA.SanctionLimit + " " + EQSRV.GLBDATA.disbTranId + " " + mid$(EQSRV.GLBDATA.disbTranDate,0,10) + " " + mid$(EQSRV.GLBDATA.sanctionDate,0,10) + " " + mid$(EQSRV.GLBDATA.expiryDate,0,10) + " " + EQSRV.GLBDATA.intTblCode + " " + BANCS.STDIN.homeCrncyCode + " @s &"
			###sv_s = "nohup babx4061 $B2K_SESSION_ID  ebodlaAclhmLarsh.scr " + EQSRV.GLBDATA.odAcctId + " " + EQSRV.GLBDATA.OperativeAcctId + " " + EQSRV.GLBDATA.Disbureamt + " " + EQSRV.GLBDATA.disbTranId + " " + mid$(EQSRV.GLBDATA.disbTranDate,0,10) + " " + mid$(EQSRV.GLBDATA.sanctionDate,0,10) + " " + mid$(EQSRV.GLBDATA.expiryDate,0,10) + " " + EQSRV.GLBDATA.intTblCode + " " + BANCS.STDIN.homeCrncyCode + " " + EQSRV.GLBDATA.repayFeq + " @s &"
			print(EQSRV.GLBDATA.BefDisbClBal)
			if(cdouble(EQSRV.GLBDATA.BefDisbClBal)<0)then
				EQSRV.GLBDATA.BefDisbClBal = -1 * cdouble(EQSRV.GLBDATA.BefDisbClBal)
				EQSRV.GLBDATA.LoanAmount = cdouble(EQSRV.GLBDATA.LoanAmount) + cdouble(EQSRV.GLBDATA.BefDisbClBal)
				print(EQSRV.GLBDATA.LoanAmount)
			else
				print(EQSRV.GLBDATA.LoanAmount)
			endif
			sv_s = "nohup babx4061 $B2K_SESSION_ID  ebodlaAclhmLarsh.scr " + EQSRV.GLBDATA.odAcctId + " " + EQSRV.GLBDATA.OperativeAcctId + " " + EQSRV.GLBDATA.LoanAmount + " " + EQSRV.GLBDATA.disbTranId + " " + mid$(EQSRV.GLBDATA.disbTranDate,0,10) + " " + mid$(EQSRV.GLBDATA.sanctionDate,0,10) + " " + mid$(EQSRV.GLBDATA.expiryDate,0,10) + " " + EQSRV.GLBDATA.intTblCode + " " + BANCS.STDIN.homeCrncyCode + " " + EQSRV.GLBDATA.repayFeq + " @s &"
				sv_r = system(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
				sv_u = urhk_SetOrbOut("Message|OD Loan Sanctioned and Disbursed Successfully")
				sv_u = urhk_SetOrbOut("ODLoanAccount|" + EQSRV.GLBDATA.odAcctId )
				sv_u = urhk_SetOrbOut("OperativeAcctId|" + EQSRV.GLBDATA.OperativeAcctId )
				sv_u = urhk_SetOrbOut("DisburseTranId|" + EQSRV.GLBDATA.disbTranId )
				sv_u = urhk_SetOrbOut("DisburseAmount|" + EQSRV.GLBDATA.LoanAmount )
				sv_u = urhk_SetOrbOut("DirburseTranDate|" + mid$(EQSRV.GLBDATA.disbTranDate,0,10) )
				BANCS.OUTPUT.successOrFailure="S"
				exitscript
			else
				lv_u = urhk_dbSqlWithBind("rollback")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
				sv_u = urhk_SetOrbOut("Message|ODA disbursement and Installement creation Failed")
				BANCS.OUTPUT.successOrFailure="F"
				exitscript
			endif
		endif
	#}
        else
	#{
		print(BANCS.OUTPARAM.Fatal_num)
