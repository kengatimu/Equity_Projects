<--start
trace on
sv_r = urhk_B2k_PrintRepos("BANCS")
PRINT(sv_r)
#redeploying
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	if((EBSRV.GLBDATA.tranSubType=="NR") or (EBSRV.GLBDATA.tranSubType=="CI") or (EBSRV.GLBDATA.tranSubType=="O"))then

	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.partTranType.code")
			EBSRV.GLBDATA.CrDrcode=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.CrDrcode)

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.key.serial_num")
			EBSRV.GLBDATA.serialnum=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.serialnum)

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EBSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EBSRV.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.refNum")
                        EBSRV.GLBDATA.refNum=BANCS.OUTPARAM.srvValue
                        print(EBSRV.GLBDATA.refNum)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
			EBSRV.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars)
			if(((EBSRV.GLBDATA.foracid =="0810295233054") OR (EBSRV.GLBDATA.foracid =="0810284143079")) and (EBSRV.GLBDATA.CrDrcode=="C"))then
				if(BANCS.STDIN.moduleIdentity=="FI")then
					print(EBSRV.GLBDATA.tran_rmks)
					EBSRV.GLBDATA.tran_rmks2 = MID$(EBSRV.GLBDATA.tran_rmks,0,4)	
					print(EBSRV.GLBDATA.tran_rmks2)
					sv_s ="refName|select substr(?SVAR,instr(?SVAR,'/')+1)refName from dual"	
					BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tran_rmks + "|" + EBSRV.GLBDATA.tran_rmks	
					print(sv_s)
					sv_u = urhk_dbSelectWithBind(sv_s)
					if(sv_u==0)then	
						EBSRV.GLBDATA.refNum2 = BANCS.OUTPARAM.refName 
						print(EBSRV.GLBDATA.refNum2)
					else
						EBSRV.GLBDATA.refNum2 = ""
					endif	
					if((EBSRV.GLBDATA.tran_rmks2 =="") or (EBSRV.GLBDATA.tran_rmks2 !="RTGS"))then
						sv_u = urhk_SRV_SetErr("Transaction not allowed on Channel")
						GOTO NEXTREC
					endif
				else
					EBSRV.GLBDATA.tran_rmks2 = ""		
				endif

				if(EBSRV.GLBDATA.tranSubType=="NR")then
					EBSRV.GLBDATA.tranParticulars = "Cash Deposit/" + EBSRV.GLBDATA.refNum + "-" + EBSRV.GLBDATA.tran_rmks 
					# Added By peter Mukavane for DFS Org deposit narrations 22-nov-2025 
					IF(BANCS.STDIN.menuId == "CUBP")THEN
						IF(EBSRV.GLBDATA.foracid == "0810284143079")THEN	
							EBSRV.GLBDATA.tranParticulars = "Organisation Deposit of Funds/" + EBSRV.GLBDATA.refNum + "-Top" + EBSRV.GLBDATA.refNum 
						ENDIF
								IF(EBSRV.GLBDATA.refNum == "1234")THEN	
									EBSRV.GLBDATA.tranParticulars = "SP Deposit of Funds/MM SP"
								ENDIF	
					ENDIF

					EBSRV.GLBDATA.tranParticulars = MID$(EBSRV.GLBDATA.tranParticulars,0,50)	
					print(EBSRV.GLBDATA.tranParticulars)
					sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars)
					print(sv_u)
				endif
				if(EBSRV.GLBDATA.tranSubType=="CI")then
					if(trim(EBSRV.GLBDATA.tran_rmks2)=="RTGS")then
						EBSRV.GLBDATA.tranParticulars = "Inward SWIFT Payment/" + EBSRV.GLBDATA.refNum + "-" + EBSRV.GLBDATA.refNum2 
						EBSRV.GLBDATA.tranParticulars = MID$(EBSRV.GLBDATA.tranParticulars,0,50)
						print(EBSRV.GLBDATA.tranParticulars)
						sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars)
						print(sv_u)
					else
						if(BANCS.STDIN.moduleIdentity=="FI")then
							EBSRV.GLBDATA.tranParticulars = "Internal Transfer/" + EBSRV.GLBDATA.refNum + "-" + EBSRV.GLBDATA.refNum2 
							EBSRV.GLBDATA.tranParticulars = MID$(EBSRV.GLBDATA.tranParticulars,0,50)
							print(EBSRV.GLBDATA.tranParticulars)
							sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars)
							print(sv_u)
						else
							EBSRV.GLBDATA.tranParticulars = "Internal Transfer/" + EBSRV.GLBDATA.refNum + "-" + EBSRV.GLBDATA.tran_rmks

					        	IF(BANCS.STDIN.menuId == "CUBP")THEN
								IF(EBSRV.GLBDATA.foracid == "0810284143079")THEN	
									EBSRV.GLBDATA.tranParticulars = "Organisation Deposit of Funds/" + EBSRV.GLBDATA.refNum + "-Top" + EBSRV.GLBDATA.refNum
 								ENDIF
								IF(EBSRV.GLBDATA.refNum == "1234")THEN	
									EBSRV.GLBDATA.tranParticulars = "SP Deposit of Funds/MM SP"
								ENDIF	
							ENDIF
                                                        EBSRV.GLBDATA.tranParticulars = MID$(EBSRV.GLBDATA.tranParticulars,0,50)
                                                        print(EBSRV.GLBDATA.tranParticulars)
                                                        sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars)
                                                        print(sv_u)	
						endif
					endif
				endif
			endif
			if(((EBSRV.GLBDATA.foracid =="0810295233054") OR (EBSRV.GLBDATA.foracid == "0810284143079"))and (EBSRV.GLBDATA.CrDrcode=="D"))then
                                if(BANCS.STDIN.moduleIdentity=="FI")then
					print(EBSRV.GLBDATA.tranParticulars)
					sv_s ="refName|select substr(?SVAR,instr(?SVAR,'/')+1)refName from dual"
                                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars 
                                        print(sv_s)
                                        sv_u = urhk_dbSelectWithBind(sv_s)
                                        if(sv_u==0)then
                                                EBSRV.GLBDATA.TranPart2 = BANCS.OUTPARAM.refName
                                                print(EBSRV.GLBDATA.TranPart2)
					else
						EBSRV.GLBDATA.TranPart2 = ""
					endif	
					EBSRV.GLBDATA.tranParticulars = "Internal Transfer/" + EBSRV.GLBDATA.TranPart2
					
					# Added By peter Mukavane for DFS 
					IF(BANCS.STDIN.menuId == "CUBP")THEN
						IF(EBSRV.GLBDATA.foracid == "0810284143079")THEN	
							EBSRV.GLBDATA.tranParticulars = "Organisation Deposit of Funds/" + EBSRV.GLBDATA.refNum + "-Top" + EBSRV.GLBDATA.refNum
						ENDIF	
						IF(EBSRV.GLBDATA.refNum == "1234")THEN	
							EBSRV.GLBDATA.tranParticulars = "SP Deposit of Funds/MM SP"
						ENDIF
					ENDIF	

					EBSRV.GLBDATA.tranParticulars = MID$(EBSRV.GLBDATA.tranParticulars,0,50)
					print(EBSRV.GLBDATA.tranParticulars)	
					sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars)
					print(sv_u)
				endif
			endif

	NEXTREC:
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif	
##trace off
end-->

