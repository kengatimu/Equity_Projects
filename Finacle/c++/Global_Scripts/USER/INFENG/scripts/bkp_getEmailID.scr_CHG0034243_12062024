<--START
TRACE ON

BANCS.OUTPUT.lv_Email = ""

IF (FIELDEXISTS(BANCS.INPUT.lv_foracid) == 1) THEN
#{
	print(BANCS.INPUT.lv_foracid)
ELSE
	BANCS.OUTPUT.lv_Email = ""
	exitscript	
#}
ENDIF

sv_s = "email|"
sv_s = sv_s + " select free_text_1 from tbaadm.gac,tbaadm.gam "
sv_s = sv_s + " where gam.acid = gac.acid "
sv_s = sv_s + " and gam.bank_id = gac.bank_id "
sv_s = sv_s + " and gam.bank_id = '"+BANCS.STDIN.contextBankId+"' "
sv_s = sv_s + " and gam.foracid = '"+BANCS.INPUT.lv_foracid+"' "

PRINT(sv_s)
sv_u = urhk_dbSelectWithBind(sv_s)
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	BANCS.OUTPUT.lv_Email = BANCS.OUTPARAM.email
	PRINT(BANCS.OUTPUT.lv_Email)
ELSE
	BANCS.OUTPUT.lv_Email = ""
#}
ENDIF

exitscript

TRACE OFF
END-->

