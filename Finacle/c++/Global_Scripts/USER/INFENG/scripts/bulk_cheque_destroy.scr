<--START
TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	
	sv_b = BANCS.STDIN.mySolId
	print(sv_b)
	

	sv_q = "foracid|"
	sv_q = sv_q + "select foracid from custom.bulk_cheque_destroy"
	sv_q = sv_q + " where process_flg is null "
	sv_q = sv_q + " and bank_id = '"+BANCS.STDIN.contextBankId+"' "
	sv_q = sv_q + " and sol_id  = '"+BANCS.STDIN.mySolId+"'"

	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_e = urhk_dbCursorOpenWithBind(sv_q)
	
	IF(sv_e==0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		
		WHILE(sv_q==0)
		#{
			CUST.DATA.foracid		= BANCS.OUTPARAM.foracid
			print(CUST.DATA.foracid)

			CUST.DATA.successOrFailure = ""
			CUST.DATA.errorCode = ""
			CUST.DATA.errorDesc = ""

			CALL("bulk_cheque_destroy_wf.scr")
                        PRINT(CUST.DATA.errorCode)
                        PRINT(CUST.DATA.errorDesc)
	
			IF(CUST.DATA.successOrFailure == "S") THEN
			#{
				sv_s = "UPDATE custom.bulk_cheque_destroy "
				sv_s = sv_s + " SET process_flg='S',"
				sv_s = sv_s + " remarks = 'DONE' "
				sv_s = sv_s + " WHERE foracid= ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR"
				sv_s = sv_s + " AND process_flg is null "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF

			ELSE
				sv_e =  CUST.DATA.errorCode + "-" +CUST.DATA.errorDesc 

				sv_s = "UPDATE custom.bulk_cheque_destroy "
				sv_s = sv_s + " SET process_flg='F',"
				sv_s = sv_s + " remarks = '"+sv_e+"' "
				sv_s = sv_s + " WHERE foracid= ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR"
				sv_s = sv_s + " AND process_flg is null "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			ENDIF
			
			
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			
		#}
		DO
		print("ALL CHEQUE ARE DESTROYED")
	#}
	ENDIF
	
	
TRACE OFF
exitscript
END-->
