	#{
#		BANCS.OUTPUT.successOrFailure = "F"
#		sv_r = "ERROR| Unable to Derive CR ACCT. Please check CUST setup"
#		sv_u = urhk_SetOrbOut(sv_r)
#		exitscript
#modified by Anuya for test
