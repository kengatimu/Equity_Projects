		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_r = "ERROR| RecvrChrg details should not be allowed in case of BEN or SHA charge options."
			sv_u = urhk_SetOrbOut(sv_r)
			exitscript
		#}
		else
		#{
			BANCS.INPUT.RecvrChrgAmt =""
			BANCS.INPUT.RecvrChrgCrncy =""
		#}
		endif

	#}
	else
	#{
		IF (FIELDEXISTS(BANCS.INPUT.RecvrChrgCrncy))  THEN
		#{
			IF (BANCS.INPUT.RecvrChrgCrncy != BANCS.INPUT.RemitCrncyCode) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
