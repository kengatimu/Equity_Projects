		IF (CUST.DATA.DccId !="POL") THEN
			BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId +"|" + CUST.DATA.DealReference
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_s = "count1|"
			sv_s = sv_s + " select count(1)  from tbaadm.dtd where bank_id =?SVAR "
			sv_s = sv_s + " and TREA_REF_NUM=?SVAR  "
			PRINT(sv_s)
			sv_d =  urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0 ) THEN
				CUST.DATA.count1 = BANCS.OUTPARAM.count1
				PRINT(CUST.DATA.count1)
				IF (cint(CUST.DATA.count1)> 0) THEN
					sv_r = "The Deal Reference Number is Used. " + CUST.DATA.DealReference
					sv_r = "ERROR|" + sv_r
					sv_w = urhk_SetOrbOut(sv_r)
					exitscript
				ENDIF
			ENDIF
		ENDIF

		# check expired / past deal reference number
		BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId +"|" + CUST.DATA.DealReference
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_s = "count1|"
		sv_s = sv_s + " select  count(*) from tbaadm.ftrt where bank_id =?SVAR  "
		sv_s = sv_s + " and REQUEST_DATE=(select db_stat_date from tbaadm.gct where bank_id=?SVAR ) and TR_REF_NUM=?SVAR  "
		PRINT(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0 ) THEN
			CUST.DATA.count1 = BANCS.OUTPARAM.count1
			PRINT(CUST.DATA.count1)
			IF (CUST.DATA.count1==0) THEN
				sv_r = "Invalid/Expired Deal Reference Number. " + CUST.DATA.DealReference
				sv_r = "ERROR|" + sv_r
				sv_w = urhk_SetOrbOut(sv_r)
				exitscript
			ENDIF
		ENDIF
	ENDIF


