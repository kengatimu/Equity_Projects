if(BANCS.INPUT.WaiveCharges == "Y")then
#{

	IF (FIELDEXISTS(BANCS.INPUT.tag36Rate)) THEN
	#{
		CUST.DATA.tag36Rate = BANCS.INPUT.tag36Rate
	#}
	ELSE
	#{
        	BANCS.OUTPUT.successOrFailure = "F"
        	sv_r = "ERROR| tag36Rate is a Mandatory Field"
        	sv_u = urhk_SetOrbOut(sv_r)
        	exitscript
	#}
	ENDIF

	if(BANCS.INPUT.ChargeOption != "OUR")then
	#{
		IF (FIELDEXISTS(BANCS.INPUT.SenderChrgAmt)) THEN
		#{
			if((BANCS.INPUT.ChargeOption == "BEN") AND (BANCS.INPUT.SenderChrgAmt == 0))then
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				sv_r = "ERROR| SenderChrgAmt should not be Zero or Null for BEN charges"
				sv_u = urhk_SetOrbOut(sv_r)
				exitscript
			#}
			endif
		#}
		ELSE
		#{
			if(BANCS.INPUT.ChargeOption == "BEN")then
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				sv_r = "ERROR| SenderChrgAmt is a Mandatory Field"
				sv_u = urhk_SetOrbOut(sv_r)
				exitscript
			#}
			else
			#{
				BANCS.INPUT.SenderChrgAmt = ""
			#}
			endif
		#}
		ENDIF

		IF (FIELDEXISTS(BANCS.INPUT.SenderChrgCrncy)) THEN
		#{
			IF (BANCS.INPUT.SenderChrgCrncy!= BANCS.INPUT.RemitCrncyCode) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				sv_r = "ERROR| SenderChrgCrncy should be same as the RemitCrncyCode"
				sv_u = urhk_SetOrbOut(sv_r)
				exitscript
			#}
			ENDIF
		#}
		ELSE
		#{
			if(BANCS.INPUT.ChargeOption == "BEN")then
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				sv_r = "ERROR| SenderChrgCrncy is a Mandatory Field"
				sv_u = urhk_SetOrbOut(sv_r)
