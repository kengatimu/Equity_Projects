				CUST.DATA.EffAvailableAmtef=cdouble(CUST.DATA.EffAvailableAmtef) *  cdouble(CUST.DATA.rate)
			ENDIF
			print (CUST.DATA.EffAvailableAmtef)
			print (CUST.DATA.totalamtptt)
			print (CUST.DATA.rate)
			IF (cdouble(CUST.DATA.EffAvailableAmtef) < cdouble(CUST.DATA.totalamtptt)) THEN
			print (CUST.DATA.EffAvailableAmtef)
			print (CUST.DATA.totalamtptt)
				sv_r = "The account ID has insufficient available amount. " + CUST.DATA.ChrgDrAcct
				sv_r = "ERROR|" + sv_r
				sv_w = urhk_SetOrbOut(sv_r)
				exitscript
