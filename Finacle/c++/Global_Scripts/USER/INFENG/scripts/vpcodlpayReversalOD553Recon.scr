<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("EQSRV")==0)then
        #{
                createrep("EQSRV")
        #}
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
        #{
                createclass("EQSRV","GLBDATA",5)
        #}
        endif
        EQSRV.GLBDATA.srvErrMsg = ""
        EQSRV.GLBDATA.srvErrCode = ""
        EQSRV.GLBDATA.srvSucFail = ""
        EQSRV.GLBDATA.machineId = ""
        sv_u = urhk_getEnv("HOST_NAME")
        print(BANCS.OUTPARAM.envValue)
        EQSRV.GLBDATA.machineId = BANCS.OUTPARAM.envValue
	EBSRV.GLBDATA.machineId = BANCS.OUTPARAM.envValue
	lv_e = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.foracid)
	if(lv_e==0) then
		EBSRV.GLBDATA.AgentOdCifId = BANCS.OUTPARAM.cifId
	else
		EBSRV.GLBDATA.AgentOdCifId = ""
	endif
        sv_l = "dmdsrlNum,drAcct,dmdDate,dmdOvduDate,orgDmdAmt,dmdAmt,solidagddt,totAdjAmt,lstAdjDate|"
        sv_l = sv_l + " select dep_srl_num,foracid,to_char(dmd_date,'DD-MM-YYYY'),to_char(dmd_ovdu_date,'DD-MM-YYYY'),dmd_amt,sum(dmd_amt-tot_adj_amt)as outstandingAmt,sol_id,tot_adj_amt,LAST_ADJ_DATE "
        sv_l = sv_l + " from custom.odsme_new "
        sv_l = sv_l + " where bank_id=?SVAR "
        ##sv_l = sv_l + " and to_date(dmd_date,'DD-MM-RR') <= to_date(?SVAR,'DD-MM-RR')"
        sv_l = sv_l + " and dep_command='CSWOP' "
        sv_l = sv_l + " and dep_dccid='BATCH' "
        sv_l = sv_l + " and dep_srl_num='NOSWEEPDIRECT_CREDIT' "
        sv_l = sv_l + " and del_flg='N' "
        sv_l = sv_l + " and entity_cre_flg='Y' "
	sv_l = sv_l + " and TOT_ADJ_AMT>0 "
	sv_l = sv_l + " and free_text1=?SVAR "
        sv_l = sv_l + " group by dep_srl_num,foracid,dmd_date,dmd_ovdu_date,dmd_amt,tot_adj_amt,sol_id,LAST_ADJ_DATE  "
        sv_l = sv_l + " order by dmd_date desc"
        print(sv_l)
        ##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + mid$(BANCS.STDIN.BODDate,0,10)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.AgentOdCifId 
	print(BANCS.INPARAM.BINDVARS)
        sv_c = urhk_dbCursorOpenWithBind(sv_l)
        if(sv_c==0)then
        #{
                EQSRV.GLBDATA.dlscdhNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        #}
        else
        #{
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        EQSRV.GLBDATA.ddaRec = 0
        sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.dlscdhNum)
        if(sv_z!=0)then
        #{
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
		EQSRV.GLBDATA.dmdsrlNum = BANCS.OUTPARAM.dmdsrlNum
		EQSRV.GLBDATA.drAcct = BANCS.OUTPARAM.drAcct
		EQSRV.GLBDATA.dmdDate = BANCS.OUTPARAM.dmdDate
		EQSRV.GLBDATA.dmdOvduDate = BANCS.OUTPARAM.dmdOvduDate
		EQSRV.GLBDATA.orgDmdAmt = BANCS.OUTPARAM.orgDmdAmt
		EQSRV.GLBDATA.dmdAmt = BANCS.OUTPARAM.dmdAmt
		EQSRV.GLBDATA.solidagddt = BANCS.OUTPARAM.solidagddt
		EQSRV.GLBDATA.totAdjAmt = BANCS.OUTPARAM.totAdjAmt
                if(cdouble(EQSRV.GLBDATA.dmdAmt)<=0)then
                #{
                                goto NXTREC
                #}
                endif
		print(EQOD.GLBDATA.tranAmt)
		print(EQOD.GLBDATA.tranid)
        	#recocile flow
                if(cdouble(EQOD.GLBDATA.tranAmt)>0)then
                #{
                     if(cdouble(EQSRV.GLBDATA.totAdjAmt)>=cdouble(EQOD.GLBDATA.tranAmt))then
                     #{
                        EBSRV.GLBDATA.totupamt = cdouble(EQSRV.GLBDATA.totAdjAmt) - cdouble(EQOD.GLBDATA.tranAmt)
                        print(EBSRV.GLBDATA.totupamt)
			IF(cdouble(EBSRV.GLBDATA.totupamt)>0) THEN
				EBSRV.GLBDATA.lstAdjDate1 = EBSRV.GLBDATA.lstAdjDate
			ELSE
				EBSRV.GLBDATA.lstAdjDate1 = ""
			ENDIF

                	sv_d = "update custom.odsme_new set tot_adj_amt='"+EBSRV.GLBDATA.totupamt+"' ,last_adj_date=to_date(?SVAR,'DD-MM-RR'),free_text2=?SVAR , PENAL_INT ='0' "
                	sv_d = sv_d + " where bank_id=?SVAR and foracid=?SVAR  and dep_srl_num=?SVAR and dmd_Date=to_date(?SVAR,'DD-MM-YYYY') and dmd_ovdu_Date=to_Date(?SVAR,'DD-MM-YYYY') and dmd_amt=?NVAR"
                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.lstAdjDate1 + "|" + EQOD.GLBDATA.tranid + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.drAcct + "|" + EQSRV.GLBDATA.dmdsrlNum + "|" + EQSRV.GLBDATA.dmdDate + "|" + EQSRV.GLBDATA.dmdOvduDate + "|" + EQSRV.GLBDATA.orgDmdAmt 
			print(sv_d)
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSqlWithBind(sv_d)
			if(sv_u==0)then
				sv_u = urhk_dbSqlWithBind("commit")
				print(sv_u)
			endif
		   else
                        if(cdouble(EQOD.GLBDATA.tranAmt)<=0)then
                        #{
                                 goto NXTREC
                        #}
                        endif
                        EQOD.GLBDATA.tranAmt = cdouble(EQOD.GLBDATA.tranAmt) - cdouble(EQSRV.GLBDATA.totAdjAmt)
                        print(EQOD.GLBDATA.tranAmt)
                        EQOD.GLBDATA.totupamt = cdouble(EQSRV.GLBDATA.totAdjAmt) - cdouble(EQSRV.GLBDATA.totAdjAmt)
                        print(EQOD.GLBDATA.totupamt)
                	sv_d = "update custom.odsme_new set tot_adj_amt='"+EBSRV.GLBDATA.totupamt+"' ,last_adj_date=to_date(?SVAR,'DD-MM-RR'),free_text2=?SVAR , PENAL_INT ='0' "
                	sv_d = sv_d + " where bank_id=?SVAR and foracid=?SVAR  and dep_srl_num=?SVAR and dmd_Date=to_date(?SVAR,'DD-MM-YYYY') and dmd_ovdu_Date=to_Date(?SVAR,'DD-MM-YYYY') and dmd_amt=?NVAR"
                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.lstAdjDate1 + "|" + EQOD.GLBDATA.tranid + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.drAcct + "|" + EQSRV.GLBDATA.dmdsrlNum + "|" + EQSRV.GLBDATA.dmdDate + "|" + EQSRV.GLBDATA.dmdOvduDate + "|" + EQSRV.GLBDATA.orgDmdAmt 
			print(sv_d)
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSqlWithBind(sv_d)
			if(sv_u==0)then
				sv_u = urhk_dbSqlWithBind("commit")
				print(sv_u)
			endif
		   #}
		   endif
		#}
		endif

			goto NXTREC
			#ends
                	
			NXTREC:
                        print(EQSRV.GLBDATA.srvErrMsg)
                        print(EQSRV.GLBDATA.srvErrCode)
                        print(EQSRV.GLBDATA.srvSucFail)
                        sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.dlscdhNum)
                        print(sv_u)
                        if(sv_u!=0)then
                        #{
                                print("fetch failed")
                                sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.dlscdhNum)
                                print(sv_u)
                                goto RESPONSE
                        #}
                        endif
                        EQSRV.GLBDATA.ddaRec = cint(EQSRV.GLBDATA.ddaRec) + 1
                        EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.ddaRec
                        print(EQSRV.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.dlscdhNum)
        print(sv_u)
Endofscript:
        print(EQSRV.GLBDATA.srvErrCode)
        print(EQSRV.GLBDATA.srvErrMsg)
        print(EQSRV.GLBDATA.srvSucFail)
        exitscript
RESPONSE:
	print("Agent Loan Paid and Reconciled Successfully")
        BANCS.OUTPUT.successOrFailure="S"
        exitscript
trace off
end-->
