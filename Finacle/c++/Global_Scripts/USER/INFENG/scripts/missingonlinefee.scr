CUST.MISS.errMsg = ""

sv_q= "acid,foracid|"
sv_q = sv_q + " select d.acid,g.foracid from tbaadm.dtd d,tbaadm.gam g where d.dth_init_sol_id =?SVAR and d.tran_type ='T' and d.tran_sub_type ='CI' and d.part_tran_type ='D' and d.acid in "
sv_q = sv_q + " (select acid from tbaadm.gam where acct_ownership ='C'and schm_type !='LAA' and foracid not in(SELECT foracid FROM CUSTOM.ACCT_EXEMPTION_TABLE where EXEMPT_CODE in ('ACCT','LDFEE','WITHEXMPT') and bank_id =?SVAR))"
sv_q = sv_q + " and d.ENTRY_USER_ID in (SELECT USER_ID FROM TBAADM.UPR WHERE VIRTUAL_FLG ='N') and d.PSTD_USER_ID !='SYSTEM' and d.rpt_code is null and trim(tran_id) not like 'S%' and d.acid=g.acid "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)
PRINT(sv_e)

IF(sv_e == 0) THEN
#{
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
