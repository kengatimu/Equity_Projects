	#}
	ENDIF
	print(sv_q)

	WHILE (sv_q==0)
	
		CUST.MISS.acid=BANCS.OUTPARAM.acid
		print(CUST.MISS.acid)
		CUST.MISS.foracid=BANCS.OUTPARAM.foracid
		print(CUST.MISS.foracid)
		
		
		sv_q = "Dcount|" 
		sv_q = sv_q + " select count (*) from tbaadm.dtd where acid =?SVAR  "
		sv_q = sv_q + " and dth_init_sol_id =?SVAR and tran_type ='T' and tran_sub_type ='CI' and part_tran_type ='D'"
		print(sv_q)
		BANCS.INPARAM.BINDVARS = CUST.MISS.acid + "|" + BANCS.STDIN.mySolId
		print(BANCS.INPARAM.BINDVARS)			
		sv_d = urhk_dbSelectWithBind(sv_q)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.MISS.Dcount=BANCS.OUTPARAM.Dcount
			print(CUST.MISS.Dcount)
		#}
		ENDIF
		
		sv_q = "Scount|" 
		sv_q = sv_q + " select count(*) from tbaadm.dtd where acid =?SVAR and RPT_CODE='TRCRG' and dth_init_sol_id =?SVAR" 
		print(sv_q)
		BANCS.INPARAM.BINDVARS = CUST.MISS.acid + "|" + BANCS.STDIN.mySolId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_q)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.MISS.Scount=BANCS.OUTPARAM.Scount
			print(CUST.MISS.Scount)
		#}
		ENDIF
		
			IF (CINT(CUST.MISS.Dcount) == CINT(CUST.MISS.Scount)) THEN
			#{
				GOTO NEXTREC
			#}
			ELSE
			#{
				CUST.MISS.Count = cdouble(CUST.MISS.Dcount)- cdouble(CUST.MISS.Scount)
				print(CUST.MISS.Count)
				CUST.MISS.negat ="-1"
				CUST.MISS.fee = "110"
				print(CUST.MISS.fee)
				CUST.MISS.chrg = cdouble(CUST.MISS.negat)*cdouble(CUST.MISS.fee)
				print(CUST.MISS.chrg)
				CUST.MISS.chrgAmt =cdouble(CUST.MISS.fee)*CINT(CUST.MISS.Count)
				print(CUST.MISS.chrgAmt)
				
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "BI"
				CUST.GCHRG.drAcctId = CUST.MISS.foracid
				CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.chrgAmt = CUST.MISS.chrgAmt + "|" + BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.eventId = "TMTRF1"			
				PRINT(CUST.GCHRG.eventId)
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
