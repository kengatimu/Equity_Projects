				CUST.CIETXN.txnTypeDesc = "Cash Depoist"
			#}
			ENDIF
			
			IF((CUST.CIETXN.tranSubType == "NP") OR (CUST.CIETXN.tranSubType == "PI") OR (CUST.CIETXN.tranSubType == "CP"))THEN
			#{
