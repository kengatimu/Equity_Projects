        sv_s = " INSERT INTO custom.cttum_auto_post_process  (DR_ACCOUNT_NUMBER,DR_ACCOUNT_CURRENCY,CR_ACCOUNT_NUMBER,CR_ACCOUNT_CURRENCY,AMOUNT,TRAN_DETAILS,TRAN_PARTICULAR_CODE,BANK_ID,RCRE_USER_ID,RCRE_TIME,DEL_FLG,ENTITY_CRE_FLG,PROCESSED_FLG,FILE_NAME,BATCHID) "
        sv_s = sv_s + "  VALUES (trim(?SVAR),?SVAR,trim (?SVAR),?SVAR,?SVAR,trim (?SVAR),?SVAR,?SVAR,?SVAR,sysdate,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR) "
