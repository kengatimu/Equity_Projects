# Category: User Defined
# Script Name : ecitizenValAcct.scr
# Calling Script: SRV_AddAndPostCashTran_validate_data.scr
# Type: NA|default
# Description: Restrict cash payment to ecitizen
# Author: JAMES GICHIRI
# Date:
# Modification Log:
#============================================================
<--start
trace on
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","ECZTN")==0)then
		createclass("EBSRV","ECZTN",5)
	endif


	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.ECZTN.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.ECZTN.tranSubType=BANCS.OUTPARAM.srvValue

	if ((EBSRV.ECZTN.tranSubType=="NR") or (EBSRV.ECZTN.tranSubType=="CR") or (EBSRV.ECZTN.tranSubType=="RI")) then
		sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
		sv_i = BANCS.OUTPARAM.srvValue
		print(sv_i)
		sv_p = 1
		sv_j = 0
		sv_p = FORMAT$(sv_p,"%d")
		sv_j = FORMAT$(sv_j,"%d")
		while(sv_j < sv_i)
		#{
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
				EBSRV.ECZTN.foracid=BANCS.OUTPARAM.srvValue
				print(EBSRV.ECZTN.foracid)
				
				sv_u = urhk_B2k_ForacidToAcid(EBSRV.ECZTN.foracid)

				IF(sv_u == 0) THEN
				#{
					EBSRV.ECZTN.acid = BANCS.OUTPARAM.Acid
					print("EBSRV.ECZTN.acid")
			
					BANCS.INPARAM.BINDVARS = EBSRV.ECZTN.acid+"|"+BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					sv_s = "ectzcount|"
					sv_s = sv_s + " SELECT count(*)"
					sv_s = sv_s + " FROM TBAADM.GAC "
					sv_s = sv_s + " WHERE acid=?SVAR"
					sv_s = sv_s + " AND BANK_ID=?SVAR"
					sv_s = sv_s + " AND free_text_1  LIKE '%ECITIZEN%'"

					PRINT(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF(sv_d == 0)THEN
					#{
						EBSRV.ECZTN.ectzcount = BANCS.OUTPARAM.ectzcount
						IF(EBSRV.ECZTN.ectzcount!="0")THEN
						#{
							
							sv_u = urhk_SRV_SetErr("Payment to be made through ECITIZEN")
							print(sv_u)
							BANCS.OUTPARAM.successOrFailure = "F"
					
						#}
						ENDIF
					#}
					ENDIF
						
				#}
				ENDIF

			sv_j = CINT(sv_j) + 1
			sv_j = FORMAT$(sv_j,"%d")
		#}
		DO
	endif
	
	
VAYU:	
	if(classexists("EBSRV","ECZTN")==1) then
		deleteclass("EBSRV","ECZTN")
	endif
	if(repexists("EBSRV")==1) then
		##deleterep("EBSRV")
	endif
	exitscript
trace off
end-->

