	ENDIF
	
	IF (REPEXISTS("AUDIT") == 0) THEN
	#{
		CREATEREP("AUDIT")
	#}
	ENDIF
	
	IF (CLASSEXISTS("AUDIT", "NEW") == 0) THEN
	#{
		CREATECLASS("AUDIT", "NEW", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("AUDIT", "OLD") == 0) THEN
	#{
		CREATECLASS("AUDIT", "OLD", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("AUDIT", "KEY") == 0) THEN
	#{
		CREATECLASS("AUDIT", "KEY", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("BANCS", "INPARAM") == 0) THEN
	#{
		CREATECLASS("BANCS", "INPARAM", 5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	
	
	sv_d = urhk_InitAudit("")
	BANCS.INPARAM.AUDITSOLID = BANCS.STDIN.mySolId
	BANCS.INPARAM.OPERCODE = CUST.DENOM.FuncCode
	BANCS.INPARAM.AUTOVERIFY = "Y"
	BANCS.INPARAM.ACCTNUM = ""
	BANCS.INPARAM.GLSUBHEADCODE = ""
	BANCS.INPARAM.REFNUM = ""
	BANCS.INPARAM.TABLENAME = "C_MDNM"
