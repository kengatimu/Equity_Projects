<--START
CHECKSUM="4d3078ef65cb3469952f43bc4f7fa9eef967c03075627d2d1b2b7245796a4637"
	TRACE ON
	
	IF (REPEXISTS("AUDIT") != 0) THEN
	#{
		DELETEREP("AUDIT")
