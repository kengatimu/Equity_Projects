	AUDIT.NEW.denom_value = ""
	PRINT(AUDIT.NEW.denom_value)
	
	CUST.DENOM.LoopCounter1 = "1"
	WHILE(CINT(CUST.DENOM.LoopCounter1) != 16)
	#{
		sv_x = CUST.DENOM.LoopCounter1
		sv_n = ("BANCS").("INPUT").("NoteDenom" + sv_x)
		#PRINT(sv_n)
		IF (sv_n != "") THEN
		#{
			IF (CINT(CUST.DENOM.LoopCounter1) == 1) THEN
			#{
				AUDIT.NEW.denom_value = AUDIT.NEW.denom_value + sv_n
				#}
			ELSE
				#{
				AUDIT.NEW.denom_value = AUDIT.NEW.denom_value + "/" + sv_n
			#}
			ENDIF
		#}
		ENDIF
		CUST.DENOM.LoopCounter1 = CINT(sv_x) + 1
	#}
	DO
	
	CUST.DENOM.LoopCounter2 = "1"
	WHILE(CINT(CUST.DENOM.LoopCounter2) != 16)
	#{
		sv_x = CUST.DENOM.LoopCounter2
		sv_c = ("BANCS").("INPUT").("CoinDenom" + sv_x)
		#PRINT(sv_c)
		IF (sv_c != "") THEN
		#{
			AUDIT.NEW.denom_value = AUDIT.NEW.denom_value + "/" + sv_c
		#}
		ENDIF
		CUST.DENOM.LoopCounter2 = CINT(sv_x) + 1
	#}
	DO
	
	PRINT(AUDIT.NEW.denom_value)
	PRINT(CUST.DENOM.FuncCode)
	
	#===========================================
	#     Addition
	#===========================================
	IF (CUST.DENOM.FuncCode == "A") THEN
	#{
		AUDIT.OLD.denom_value = ""
	#}
	ENDIF
	
	#===========================================
	#     ModIFication
	#===========================================
	IF (CUST.DENOM.FuncCode == "M") THEN
	#{
		AUDIT.OLD.denom_value = ""
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_a = "denom_value|SELECT DENOM_VALUE "
		sv_a = sv_a + "FROM C_MDNM "
		sv_a = sv_a + "WHERE CRNCY_CODE = ?SVAR "
		sv_a = sv_a + "AND  DENOM_IND = 'N' AND bank_id = ?SVAR"
		sv_a = sv_a + "ORDER BY denom_value DESC "
		PRINT(sv_a)
		
		sv_t = urhk_dbCursorOpenWithBind(sv_a)
		IF (sv_t == 0) THEN
		#{
			sv_r = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(sv_r)
			PRINT(sv_q)
			CUST.DENOM.count = "1"
			IF (sv_q != 0) THEN
			#{
				PRINT("Cursor Fetch Failed!!")
				PRINT(sv_q)
				GOTO FINISH
			#}
			ENDIF
			
			WHILE(sv_q == 0)
			#{
				IF (CINT(CUST.DENOM.count) == 1) THEN
				#{
					AUDIT.OLD.denom_value = AUDIT.OLD.denom_value + BANCS.OUTPARAM.denom_value
					#}
				ELSE
					#{
					AUDIT.OLD.denom_value = AUDIT.OLD.denom_value + "/" + BANCS.OUTPARAM.denom_value
				#}
				ENDIF
				sv_q = urhk_dbCursorFetch(sv_r)
				CUST.DENOM.count = CINT(CUST.DENOM.count) + 1
			#}
			DO
			sv_x = urhk_dbCursorClose(sv_r)
			#}
		ELSE
			#{
			PRINT("Cursor Open Failed!!")
			GOTO FINISH
		#}
		ENDIF
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_a = "denom_value|SELECT DENOM_VALUE "
		sv_a = sv_a + "FROM C_MDNM "
		sv_a = sv_a + "WHERE CRNCY_CODE = ?SVAR "
		sv_a = sv_a + "AND  DENOM_IND = 'C' AND bank_id = ?SVAR"
		sv_a = sv_a + "ORDER BY denom_value DESC "
		PRINT(sv_a)
		
		sv_t = urhk_dbCursorOpenWithBind(sv_a)
		IF (sv_t == 0) THEN
		#{
			sv_r = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(sv_r)
			PRINT(sv_q)
			CUST.DENOM.count = "1"
			IF (sv_q != 0) THEN
			#{
				PRINT("Cursor Fetch Failed!!")
				PRINT(sv_q)
				GOTO FINISH
			#}
			ENDIF
			
			WHILE(sv_q == 0)
			#{
				AUDIT.OLD.denom_value = AUDIT.OLD.denom_value + "/" + BANCS.OUTPARAM.denom_value
				sv_q = urhk_dbCursorFetch(sv_r)
				CUST.DENOM.count = CINT(CUST.DENOM.count) + 1
			#}
			DO
			sv_x = urhk_dbCursorClose(sv_r)
			#}
		ELSE
			#{
			PRINT("Cursor Open Failed!!")
			GOTO FINISH
			
		#}
		ENDIF
		
		PRINT(AUDIT.NEW.denom_value)
		PRINT(AUDIT.OLD.denom_value)
	#}
	ENDIF
	
	FINISH:
		EXITSCRIPT
		
		TRACE OFF
END-->
