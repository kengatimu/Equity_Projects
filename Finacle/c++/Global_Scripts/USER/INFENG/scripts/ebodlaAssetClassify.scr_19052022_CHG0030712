        BANCS.OUTPUT.trgEntityType = BANCS.INPUT.b2kType
        BANCS.OUTPUT.trgEntityId = BANCS.INPUT.b2kId
        if(BANCS.INPUT.schmCode!="OD549")then
        #{
                lv_h = "imaOvduDate,imiOvduDate,ioutstandingAmt| select to_char(max(dmd_ovdu_date),'DD-MM-RRRR'),"
                lv_h = lv_h + " to_char(min(dmd_ovdu_date),'DD-MM-RRRR'),dmd_amt-tot_adj_amt "
                lv_h = lv_h + " from custom.odla_dmd_tbl "
                lv_h = lv_h + " where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' "
                lv_h = lv_h + " and dmd_ovdu_date<to_date(?SVAR,'DD-MM-RRRR') "
                lv_h = lv_h + " and od_acid=?SVAR and FLOW_ID='INDEM'"
                lv_h = lv_h + " and (dmd_amt-tot_adj_amt) <>0 and (dmd_amt-tot_adj_amt) >0"
		lv_h = lv_h + " group by dmd_ovdu_date,dmd_amt,tot_adj_amt "
                lv_h = lv_h + " order by dmd_ovdu_date,dmd_amt,tot_adj_amt " 
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.INPUT.b2kId
                print(lv_h)
                print(BANCS.INPARAM.BINDVARS)
                lv_d = urhk_dbSelectWithBind(lv_h)
                if(lv_d==0)then
		#{
                        ODCAL.DATA.imaOvduDate = BANCS.OUTPARAM.imaOvduDate
                   	ODCAL.DATA.imiOvduDate = BANCS.OUTPARAM.imiOvduDate
                        ODCAL.DATA.ioutstandingAmt = BANCS.OUTPARAM.ioutstandingAmt
		#}
                else
		#{
                        ODCAL.DATA.imaOvduDate = ""
                        ODCAL.DATA.imiOvduDate = ""
                        ODCAL.DATA.ioutstandingAmt = "0" 
		#}
                endif
                lv_h = "pimaOvduDate,pimiOvduDate,pioutstandingAmt| select to_char(max(dmd_ovdu_date),'DD-MM-RRRR'),"
                lv_h = lv_h + " to_char(min(dmd_ovdu_date),'DD-MM-RRRR'),dmd_amt-tot_adj_amt "
                lv_h = lv_h + " from custom.odla_dmd_tbl "
                lv_h = lv_h + " where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' "
                lv_h = lv_h + " and dmd_ovdu_date<to_date(?SVAR,'DD-MM-RRRR') "
                lv_h = lv_h + " and od_acid=?SVAR and FLOW_ID='PRDEM'"
                lv_h = lv_h + " and (dmd_amt-tot_adj_amt) <>0 and (dmd_amt-tot_adj_amt) >0"
		lv_h = lv_h + " group by dmd_ovdu_date,dmd_amt,tot_adj_amt "
                lv_h = lv_h + " order by dmd_ovdu_date,dmd_amt,tot_adj_amt " 
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.INPUT.b2kId
                print(lv_h)
                print(BANCS.INPARAM.BINDVARS)
                lv_d = urhk_dbSelectWithBind(lv_h)
                if(lv_d==0)then
		#{
                        ODCAL.DATA.pimaOvduDate = BANCS.OUTPARAM.pimaOvduDate
                        ODCAL.DATA.pimiOvduDate = BANCS.OUTPARAM.pimiOvduDate
                        ODCAL.DATA.pioutstandingAmt = BANCS.OUTPARAM.pioutstandingAmt
		#}
                else
		#{
                        ODCAL.DATA.pimaOvduDate = ""
                        ODCAL.DATA.pimiOvduDate = ""
                        ODCAL.DATA.pioutstandingAmt = "0" 
		#}
                endif
		if(ODCAL.DATA.imiOvduDate!="")then
		#{
                        ODCAL.DATA.maOvduDate = ODCAL.DATA.imaOvduDate 
                        ODCAL.DATA.miOvduDate = ODCAL.DATA.imiOvduDate 
                        ODCAL.DATA.outstandingAmt = ODCAL.DATA.ioutstandingAmt 
		#}
		else
		#{
			if(ODCAL.DATA.pimiOvduDate!="")then
			#{
				ODCAL.DATA.maOvduDate = ODCAL.DATA.pimaOvduDate  
				ODCAL.DATA.miOvduDate = ODCAL.DATA.pimiOvduDate 
				ODCAL.DATA.outstandingAmt = ODCAL.DATA.pioutstandingAmt 
			#}
			endif
		#}
		endif
        #}
        else
        #{
                if(fieldexists(BANCS.INPUT.liability)==1)then
                #{
                        print(BANCS.INPUT.liability)
                #}
                endif
                if(fieldexists(BANCS.INPUT.minSancLimitExpDate)==1)then
                #{
                        ODCAL.DATA.maOvduDate = left$(BANCS.INPUT.minSancLimitExpDate,10)
                        ODCAL.DATA.miOvduDate = left$(BANCS.INPUT.minSancLimitExpDate,10)
                #}
                endif
        #}
        endif
        if(ODCAL.DATA.miOvduDate!="")then
        #{
                BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10)
                BANCS.INPARAM.date2 = ODCAL.DATA.miOvduDate
                sv_u = urhk_B2K_dateDiff("")
                print(sv_u)
                if(sv_u==0)then
                        ODCAL.DATA.overdueDays = BANCS.OUTPARAM.dateDiff
			print(ODCAL.DATA.overdueDays)
			print(ODCAL.DATA.outstandingAmt)
			if(cdouble(ODCAL.DATA.outstandingAmt)<=0)then
			#{
				ODCAL.DATA.overdueDays = "0"
			#}
			endif
                else
                        ODCAL.DATA.overdueDays = "0"
                endif
        #}
        else
        #{
                ODCAL.DATA.overdueDays = "0"
        #}
        endif
        lv_a= urhk_B2k_AcidToForacid(BANCS.INPUT.b2kId)
        if(lv_a==0)then
                ODCAL.DATA.Odforacid = BANCS.OUTPARAM.Foracid
        else
                ODCAL.DATA.Odforacid = ""
        endif
        if(ODCAL.DATA.Odforacid!="")then
                lv_u = urhk_getAcctDetailsInRepository(ODCAL.DATA.Odforacid)
                print(lv_u)
                if(lv_u==0)then
                        ODCAL.DATA.icrEffBal = BANCS.OUTPARAM.EffAvailableAmt
                        ODCAL.DATA.icrclearBalance = BANCS.OUTPARAM.clearBalance
                else
                        ODCAL.DATA.icrEffBal = ""
                        ODCAL.DATA.icrclearBalance = ""
                endif
                print(ODCAL.DATA.icrEffBal)
                print(ODCAL.DATA.icrclearBalance)
                if(cdouble(ODCAL.DATA.icrclearBalance)>=0)then
                        ODCAL.DATA.overdueDays = "0"
                endif
        endif
        if(cint(ODCAL.DATA.overdueDays) <= 30) then
                ODCAL.DATA.mainClassfn = "PA"
                ODCAL.DATA.subClassfn = "NORM"
                goto ENDOFSCRIPT
        endif
        if((cint(ODCAL.DATA.overdueDays) > 30) and (cint(ODCAL.DATA.overdueDays) <= 90)) then
                ODCAL.DATA.mainClassfn = "PA"
                ODCAL.DATA.subClassfn = "WATC"
                goto ENDOFSCRIPT
        endif
        if((cint(ODCAL.DATA.overdueDays) > 90) and (CINT(ODCAL.DATA.overdueDays) <= 180)) then
                ODCAL.DATA.mainClassfn = "NPA"
                ODCAL.DATA.subClassfn = "SUBS"
                goto ENDOFSCRIPT
        endif
        if((cint(ODCAL.DATA.overdueDays) > 180) and (CINT(ODCAL.DATA.overdueDays) <= 365)) then
                ODCAL.DATA.mainClassfn = "NPA"
                ODCAL.DATA.subClassfn = "DBTL"
                goto ENDOFSCRIPT
        endif
        if(cint(ODCAL.DATA.overdueDays) > 365) then
                ODCAL.DATA.mainClassfn = "NPA"
                ODCAL.DATA.subClassfn = "LOSS"
                goto ENDOFSCRIPT
        endif
        ENDOFSCRIPT:
                if((ODCAL.DATA.subClassfn != "") and (ODCAL.DATA.mainClassfn != "")) then
                        BANCS.OUTPUT.maxDPDCounter = ODCAL.DATA.overdueDays
                        BANCS.OUTPUT.mainClassificationSystem = ODCAL.DATA.mainClassfn
                        BANCS.OUTPUT.subClassificationSystem = ODCAL.DATA.subClassfn
                endif
                print(BANCS.OUTPUT.mainClassificationSystem)
                print(BANCS.OUTPUT.subClassificationSystem)
                print(BANCS.OUTPUT.maxDPDCounter)
                print(BANCS.OUTPUT.assetClsReasonCode)
                print(BANCS.OUTPUT.trgEntityType)
                print(BANCS.OUTPUT.trgEntityId)
        exitscript
trace off
