        if(classexists("ODCAL","DATA")==0)then
                createclass("ODCAL","DATA",5)
        endif
	ODCAL.DATA.maOvduDate = ""
	ODCAL.DATA.miOvduDate = ""
	ODCAL.DATA.outstandingAmt = "0"
	ODCAL.DATA.imaOvduDate = ""
	ODCAL.DATA.imiOvduDate = ""
	ODCAL.DATA.ioutstandingAmt = "0"
	ODCAL.DATA.pimaOvduDate = ""
	ODCAL.DATA.pimiOvduDate = ""
	ODCAL.DATA.pioutstandingAmt = "0"
        if(fieldexists(BANCS.INPUT.schmType)==1)then
        if(BANCS.INPUT.schmType!="ODA")then
                exitscript
        endif
        endif
        if(fieldexists(BANCS.INPUT.schmCode)==1)then
		if(BANCS.INPUT.schmCode=="OD541")then
			call("vpAgentAssetClassify.scr")
			exitscript
		endif
		if((BANCS.INPUT.schmCode!="OD542") and (BANCS.INPUT.schmCode!="OD543") and (BANCS.INPUT.schmCode!="OD544") and (BANCS.INPUT.schmCode!="OD545") and (BANCS.INPUT.schmCode!="OD546") and (BANCS.INPUT.schmCode!="OD549") and (BANCS.INPUT.schmCode!="OD112"))then
			exitscript
		endif
        endif
        if(fieldexists(BANCS.INPUT.b2kType)==1)then
                print(BANCS.INPUT.b2kType)
        endif
        if(fieldexists(BANCS.INPUT.b2kId)==1)then
                print(BANCS.INPUT.b2kId)
        endif
        if(fieldexists(BANCS.INPUT.solId)==1)then
                print(BANCS.INPUT.solId)
        endif
        BANCS.OUTPUT.maxDPDCounter      = ""
        BANCS.OUTPUT.mainClassificationSystem   = BANCS.INPUT.mainClassificationSystem
        BANCS.OUTPUT.subClassificationSystem    = BANCS.INPUT.subClassificationSystem
