<--START
CHECKSUM="85c9bcf64239139e5d09a9d12681832e07e28024ff870583bbdc20323a5205f7"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CUBP Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CUBP")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CUBP",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CUBP.acctNo = " "
	CUST.CUBP.errorFlg = "N"
	CUST.CUBP.errorMsg = " "
	CUST.CUBP.acctBnkId = " "
	CUST.CUBP.cifIdForSig = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNo))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctNo) != "")THEN
		#{
			CUST.CUBP.acctNo = TOUPPER(TRIM(BANCS.INPUT.acctNo))
			print(CUST.CUBP.acctNo)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CUBP.errorFlg = "Y"
		CUST.CUBP.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctBnkId,cifIdForSig|"
	sv_s = sv_s + " SELECT BANK_ID,CIF_ID"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CUBP.acctNo
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CUBP.acctBnkId = BANCS.OUTPARAM.acctBnkId
		print(CUST.CUBP.acctBnkId)
		CUST.CUBP.cifIdForSig = BANCS.OUTPARAM.cifIdForSig
		print(CUST.CUBP.cifIdForSig)
		
		IF(CUST.CUBP.acctBnkId != BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CUBP.errorFlg = "Y"
			CUST.CUBP.errorMsg = "The account does not exist."
			CUST.CUBP.cifIdForSig = " "
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		IF(TRIM(CUST.CUBP.cifIdForSig) == "")THEN
		#{
			CUST.CUBP.errorFlg = "Y"
			CUST.CUBP.errorMsg = "CIF ID is NULL for this A/c. ID"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CUBP.errorFlg = "Y"
		CUST.CUBP.errorMsg = "Enter Valid Account ID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		IF(CUST.CUBP.errorFlg == "")THEN
		#{
			CUST.CUBP.errorFlg = " "
		#}
		ENDIF
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CUBP.errorFlg)
		print(sv_u)
		
		IF(CUST.CUBP.errorMsg == "")THEN
		#{
			CUST.CUBP.errorMsg = " "
		#}
		ENDIF
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CUBP.errorMsg)
		print(sv_u)
		
		IF(CUST.CUBP.acctBnkId == "")THEN
		#{
			CUST.CUBP.acctBnkId = " "
		#}
		ENDIF
		###################################################################
		# Sending BANCS.STDIN.contextBankId for output
		##################################################################
		sv_u = urhk_SetOrbOut("acctBnkId|"+BANCS.STDIN.contextBankId)
		print(sv_u)
		
		IF(CUST.CUBP.cifIdForSig == "")THEN
		#{
			CUST.CUBP.cifIdForSig = " "
		#}
		ENDIF
		sv_u = urhk_SetOrbOut("cifIdForSig|"+CUST.CUBP.cifIdForSig)
		print(sv_u)
		
END-->
