<--start
trace on
#Assigning Initial Values
	sv_a = ""
	BANCS.INPUT.uploadPortNum  = ""
	BANCS.INPUT.DEVICE_ID	   = ""
	BANCS.INPUT.DEVICE_PORT_ID = ""
	BANCS.INPUT.CONTROLLER_ID  = ""
	
	print(BANCS.INPUT.uploadFileName)
#env variable for FT
	sv_a = getEnv("B2K_SESSION_ID")
	print(sv_a)
	if(sv_a == "") then
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "Error_02|ERROR^Invalid Session Id.Please contact your Administrator.^upldFile"
		sv_u = urhk_SetOrbOut(sv_z)
		EXIT
	endif
# Fetching Device id , device port id and controller id(web server ip address is going to be stored in
# controller id field in LGI)
	sv_m = "device_id,device_port_id,controller_id|select lgi.device_id,lgi.device_port_id,lgi.controller_id"
	sv_m = sv_m + " from tbaadm.lgi"
	sv_m = sv_m + " where lgi.session_id = '"+ sv_a + "'"
	print(sv_m)
	sv_q = urhk_dbselectWithBind(sv_m)
	print(sv_q)
	if(sv_q != 0) then
	#{
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "Error_02|ERROR^Port Id not available for the session Id.Please contact your Administrator.^upldFile"
		sv_u = urhk_SetOrbOut(sv_z)
		EXIT
		#}
	else
		#{
		BANCS.INPUT.DEVICE_ID = BANCS.OUTPARAM.device_id
		BANCS.INPUT.DEVICE_PORT_ID = BANCS.OUTPARAM.device_port_id
		BANCS.INPUT.CONTROLLER_ID = BANCS.OUTPARAM.controller_id
	#}
	endif
	
	sv_r = urhk_getEnv("FILEUPLOAD_JLIMO_PORTNUM")
	print(sv_r)
	if (sv_r != 0) then
	#{
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "Error_02|ERROR^ENV FILEUPLOAD_JLIMO_PORTNUM not set.Please contact your Administrator.^upldFile"
		sv_u = urhk_SetOrbOut(sv_z)
		EXIT
		#}
	else
		#{
		#print(BANCS.OUTPARAM.envValue)
		BANCS.INPUT.uploadPortNum = BANCS.OUTPARAM.envValue
	#}
	endif
#setting up env variable required for FT
	#sv_j="LANG|"
	#sv_k = urhk_putEnv(sv_j)
	#print(sv_k)
	
	#sv_m="LC_ALL|"
	#sv_n= urhk_putEnv(sv_m)
	#print(sv_n)
	
	sv_r = urhk_getEnv("LIMOC_CONFIG_PATH")
	if (sv_r != 0) then
	#{
		print("ENV LIMOC_CONFIG_PATH not set, taking default value")
		sv_j="UPLOAD_CLIENT_FILE|$TBA_PROD_ROOT/services/finlistval/fce/finlistval-client.cfg"
		sv_k = urhk_putEnv(sv_j)
		#}
	else
		#{
		print(BANCS.OUTPARAM.envValue)
		sv_j="UPLOAD_CLIENT_FILE|"+BANCS.OUTPARAM.envValue
		sv_k = urhk_putEnv(sv_j)
	#}
	endif
	
	sv_m="UPLOAD_CLIENT_LOG|."
	print(sv_m)
	sv_n= urhk_putEnv(sv_m)
	
	if (FIELDEXISTS(BANCS.INPUT.uploadFileName)) then
	#{
		sv_f = BANCS.INPUT.uploadFileName
		print(sv_f)
		if (BANCS.INPUT.uploadPortNum != "") then
			sv_i = BANCS.INPUT.uploadIPAddress + ":" + BANCS.INPUT.uploadPortNum
		endif
		print(sv_f)
		print(sv_i)
		# Upload Client Utility command for transferring the file to unix
		if (MID$(BANCS.INPUT.uploadFileName,0,1) == "/") then
		#{
			#filename is prefixed with esc char for unix filesystem
			sv_p = "uploadclient LIMO://" + sv_i + "//\ " + sv_f
			#}
		else
			#{
			sv_p = "uploadclient LIMO://" + sv_i + "///" + sv_f
		#}
		endif
		sv_z = ""
		sv_u = urhk_getFileLocation("COM|corpsigUpld.com")
		print(sv_u)
		print(BANCS.OUTPARAM.fileLocation)
		sv_z = BANCS.OUTPARAM.fileLocation
		print(sv_z)
		sv_j = "corpsigUpld.com"
		sv_p = sv_z + sv_j + " " + sv_i + " " + sv_f 
		print(sv_p)
       		sv_x = SYSTEM(sv_p + " &" )
		if (sv_x != 0) then
		#{
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^File Transfer Unsucessful.Please contact your Administrator^upldFile"
			sv_u = urhk_SetOrbOut(sv_z)
			EXIT
		#}
		endif
		#}
	else
		#{
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		sv_z = "Error_03|ERROR^File Transfer Unsucessful.Please contact your Administrator^upldFile"
		sv_u = urhk_SetOrbOut(sv_z)
		EXIT
	#}
	endif
ENDOFSCRIPT:
	exitscript
end-->
