<--START
TRACE ON

#--------------------------------------------------------------------------
#  Creation of MISS repository and CHRG class
#--------------------------------------------------------------------------

	sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        endif

	sv_r = REPEXISTS("MISS")
        IF (sv_r == 0) THEN
                CREATEREP("MISS")
        endif

	sv_r = CLASSEXISTS("MISS", "CHRG")
	IF (sv_r == 0) THEN
		CREATECLASS("MISS", "CHRG", 5)
	ENDIF

#--------------------------------------------------------------------------
# Selecting total number of accounts which are not charged 
#--------------------------------------------------------------------------

	sv_s = "getboddate|select to_char((db_stat_date-1),'DD-MM-YYYY') from tbaadm.gct where bank_id=?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	PRINT(BANCS.INPARAM.BINDVARS)

	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d =="0") THEN
		MISS.CHRG.getboddate = BANCS.OUTPARAM.getboddate
		print(MISS.CHRG.getboddate)
	ENDIF


	print(BANCS.STDIN.mySolId)
	MISS.CHRG.SET_ID = BANCS.STDIN.mySolId	

	sv_s = "dtd_Count|"
	sv_s = sv_s + "select  count(*) from custom.excise_duty_detail_table  "
	sv_s = sv_s + "	where PERCNTAMOUNT>0 "
	sv_s = sv_s + " and PROCESSFLG='N' "
	sv_s = sv_s + " and bank_id = '"+BANCS.STDIN.contextBankId+"'"
	sv_s = sv_s + " and processdate = to_date('"+Mid$(BANCS.STDIN.BODDate,0,10)+"','DD-MM-YYYY')"
	sv_s = sv_s + " and sol_id in (select sol_id from tbaadm.sst where set_id = '"+MISS.CHRG.SET_ID+"')"
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)

	sv_q = BANCS.OUTPARAM.dtd_Count
	print(sv_q)

	IF (sv_q == "0") THEN
		GOTO Finish
	ENDIF

	#--------------------------------------------------------------------------
	# Selecting accounts from custom.excise_duty_detail_table For creating transaction  
	#--------------------------------------------------------------------------


	sv_s = "enddate,startdate,excisedutyacc,sol_id,endperiod,startperiod ,diffamount,percntamount,foracid,acct_name,processdate,processflg,sequence|"
	sv_s = sv_s + " select enddate,startdate,EXCISEDUTYACC,sol_id,enddate_bal,startdate_bal ,diffamount,percntamount,foracid,acct_name,processdate,"
	sv_s = sv_s + "processflg,seq "
	sv_s = sv_s + " from custom.excise_duty_detail_table "
	sv_s = sv_s + " where PERCNTAMOUNT>0 "
	sv_s = sv_s + " and PROCESSFLG='N' "
	sv_s = sv_s + " and bank_id = '"+BANCS.STDIN.contextBankId+"'"
	sv_s = sv_s + " and processdate = to_date('"+Mid$(BANCS.STDIN.BODDate,0,10)+"','DD-MM-YYYY')"
	sv_s = sv_s + " and sol_id in (select sol_id from tbaadm.sst where set_id = '"+MISS.CHRG.SET_ID+"')"
	PRINT(sv_s)

	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_o)

	print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	MISS.CHRG.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(MISS.CHRG.MainCursor)

	#--------------------------------------------------------------------------	
	# Initialise the Local Variables 
	#--------------------------------------------------------------------------

	#------------------------------------------------------------------
	#  Variable Initialisation for counter. It should be Zero
	#------------------------------------------------------------------
		sv_z = 0
        #------------------------------------------------------------------
        #  Variable Initialisation for credit amount to the bank income
	#  account. It should be Zero. 
        #------------------------------------------------------------------
		MISS.CHRG.done = "N"


	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	    
	#===================================
	# STEP 1 : INITIALIZE THE MTT
	#===================================

	BANCS.INPARAM.PostTranFlg               = "Y"
	BANCS.INPARAM.CommitFlg                 = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
	BANCS.INPARAM.ValidationFlag            = "Y"
	BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw          = "Y"
	BANCS.INPARAM.CheckExceptions           = "N"

	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.Remarks = "Batch Duty Sweeps3 "
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.PSTUpdateFlg ="N"

	sv_v = "bCashWithCrg"
	print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("bCashWithCrg")

	#--------------------------------------------------------------------------
	# MTT code for creating tranxs like individual debit from customer and 
	# consolidated credit to the income Account. 
	#--------------------------------------------------------------------------

	while (sv_o == 0)
		sv_c = urhk_dbCursorFetch(MISS.CHRG.MainCursor)
		print(sv_c)
		IF (sv_c != 0) THEN
		#{ 
				sv_r = urhk_MTTS_EndDefinition("")
                                print(sv_r)


            		print(sv_c)
	    		sv_o = 1	

		#}
		ELSE 
		#{

			MISS.CHRG.enddate = BANCS.OUTPARAM.enddate
			print(MISS.CHRG.enddate)
			MISS.CHRG.startdate = BANCS.OUTPARAM.startdate
			print(MISS.CHRG.startdate)
			MISS.CHRG.excisedutyacc = BANCS.OUTPARAM.excisedutyacc
			print(MISS.CHRG.excisedutyacc)
			MISS.CHRG.sol_id = BANCS.OUTPARAM.sol_id
			print(MISS.CHRG.sol_id)
			MISS.CHRG.endperiod = BANCS.OUTPARAM.endperiod
			print(MISS.CHRG.endperiod)
			MISS.CHRG.startperiod = BANCS.OUTPARAM.startperiod
			print(MISS.CHRG.startperiod)
			MISS.CHRG.diffamount = BANCS.OUTPARAM.diffamount
			print(MISS.CHRG.diffamount)
			MISS.CHRG.percntamount = BANCS.OUTPARAM.percntamount
			print(MISS.CHRG.percntamount)
			MISS.CHRG.foracid = BANCS.OUTPARAM.foracid
			print(MISS.CHRG.foracid)
			MISS.CHRG.acct_name = BANCS.OUTPARAM.acct_name
			print(MISS.CHRG.acct_name)
			MISS.CHRG.processdate = BANCS.OUTPARAM.processdate
			print(MISS.CHRG.processdate)
			MISS.CHRG.processflg = BANCS.OUTPARAM.processflg
			print(MISS.CHRG.processflg)
			MISS.CHRG.sequence = BANCS.OUTPARAM.sequence
			print(MISS.CHRG.sequence)
			
			
			MISS.CHRG.stamp = "Y"

		

			#------------------------------------------
                        # counter setting for defining different PartTran
                        #------------------------------------------
                        	sv_z = sv_z + 1
                                MISS.CHRG.Counter = sv_z

			#--------------------------------------------------------------------------
			# Create the narration
			#--------------------------------------------------------------------------

			
			sv_m = "EXC DTY-"
			print(sv_m)
			sv_y = MISS.CHRG.foracid
			sv_x = " "
			sv_k = MISS.CHRG.acct_name
			print(sv_k)

			sv_w = sv_m + sv_y + sv_x + sv_k
			print(sv_w)

			MISS.CHRG.narr1 = sv_w
			print(MISS.CHRG.narr1)

			MISS.CHRG.narrexc = "EXC DTY-"
			print(MISS.CHRG.narrexc)
			MISS.CHRG.excisedutyaccnar = MISS.CHRG.excisedutyacc
			print(MISS.CHRG.excisedutyaccnar)
			MISS.CHRG.excdutynma = "EXCISE DUTY"
			print(MISS.CHRG.excdutynma)

			MISS.CHRG.narr2 = MISS.CHRG.narrexc + " " +MISS.CHRG.excisedutyaccnar+" "+ MISS.CHRG.excdutynma
			print(MISS.CHRG.narr2)

			MISS.CHRG.startdatennarr = MISS.CHRG.startdate 
			print(MISS.CHRG.startdatennarr)
			MISS.CHRG.narrto = "to"
			MISS.CHRG.startdatennarre = MISS.CHRG.enddate
			print(MISS.CHRG.startdatennarre)

			MISS.CHRG.narr3 = MISS.CHRG.startdatennarr +" " +MISS.CHRG.narrto +" "+ MISS.CHRG.startdatennarre +" "+ MISS.CHRG.sequence
			print(MISS.CHRG.narr3)
			

			MISS.CHRG.wtax_amt = ""
			print(MISS.CHRG.wtax_amt)
				

			#--------------------------------------------------
        		# Withholding Tax Account
        		#--------------------------------------------------

        		IF (MISS.CHRG.stamp == "Y") THEN

                		MTT.PartTranDetails.Account = MISS.CHRG.excisedutyacc
				print(MTT.PartTranDetails.Account)
                		MTT.PartTranDetails.RefCurrency = "KES"
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr1  
                		MTT.PartTranDetails.RefAmount = cdouble(MISS.CHRG.percntamount)
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.narr3
                		MTT.PartTranDetails.RefNum = MISS.CHRG.foracid
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_e = "Credt" + MISS.CHRG.Counter
				print(sv_e)
                		sv_r = urhk_MTTS_definePartTran(sv_e)
                		print(sv_r)

        		ENDIF


			#------------------------------------------------------------------
        		# Customer Debit Partran
        		#------------------------------------------------------------------

               			MTT.PartTranDetails.Account = MISS.CHRG.foracid
                		MTT.PartTranDetails.RefCurrency = "KES"
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr2 
                		sv_a = cdouble(MISS.CHRG.percntamount)
				print(sv_a)
				sv_a = -(sv_a)
				print(sv_a)
                		MTT.PartTranDetails.RefAmount = sv_a
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.narr3
                		MTT.PartTranDetails.RefNum = MISS.CHRG.foracid
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_h = "Debit" + MISS.CHRG.Counter
				print(sv_h)
                		sv_u = urhk_MTTS_definePartTran(sv_h)
				print(sv_u)

		#}
			#######

			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)


			IF (FIELDEXISTS(BANCS.OUTPARAM.MTTTranId) == 1) THEN
			#{
				MISS.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
			else
				MISS.CHRG.tranid =""
			endif

			print(MISS.CHRG.tranid)
			print(BANCS.STDIN.userId)
			print(BANCS.STDIN.sysDate)
			print(BANCS.STDIN.BODDate)

			sv_g = mid$(BANCS.STDIN.sysDate,0,10) 
			print(sv_g)
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)

						
			sv_s = "update custom.excise_duty_detail_table "
			sv_s = sv_s + "set processflg ='P' "
			#sv_s = sv_s + " Tran_id = '"+MISS.CHRG.tranid+"',"
			#sv_s = sv_s + " Tran_date = to_date('"+sv_h+"','DD-MM-YYYY')"
			sv_s = sv_s + " where bank_id = '"+BANCS.STDIN.contextBankId+"'"
			sv_s = sv_s + " and processdate = to_date('"+Mid$(BANCS.STDIN.BODDate,0,10)+"','DD-MM-YYYY')"
			sv_s = sv_s + " and seq=?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = MISS.CHRG.sequence 
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSQLWithBind(sv_s)
			print(sv_d)
			sv_d = urhk_dbSQLWithBind("COMMIT")
			print(sv_d)
			########
		ENDIF
	DO

	sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor) 

sv_r = urhk_MTTS_Close("")
print(sv_r)

