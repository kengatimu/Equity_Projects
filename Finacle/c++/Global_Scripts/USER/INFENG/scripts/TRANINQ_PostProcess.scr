			#{
				sv_w = BANCS.OUTPARAM.pstd_user_id
				BANCS.OUTPUT.posted_user_id = sv_w
			#}
			ENDIF
			IF(FIELDEXISTS(BANCS.OUTPARAM.pstd_date)) THEN
			#{
				sv_v = BANCS.OUTPARAM.pstd_date
			#}
			ENDIF
			
			IF (FIELDEXISTS(BANCS.OUTPARAM.vfd_user_id)) THEN
			#{
				sv_l = BANCS.OUTPARAM.vfd_user_id
				BANCS.OUTPUT.verified_user_id = sv_l
			#}
			ENDIF
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.vfd_date)) THEN
			#{
				sv_q = BANCS.OUTPARAM.vfd_date
			#}
			ENDIF
			
			IF (FIELDEXISTS(BANCS.OUTPARAM.entry_user_id)) THEN
			#{
				sv_k = BANCS.OUTPARAM.entry_user_id
				BANCS.OUTPUT.entered_user_id = sv_k
			#}
			ENDIF
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.entry_date)) THEN
			#{
				sv_x = BANCS.OUTPARAM.entry_date
			#}
			ENDIF
			
			
			
			sv_h = BANCS.OUTPARAM.trea_ref_num
			BANCS.OUTPUT.treasury_ref_no=sv_h
			
			sv_h = BANCS.OUTPARAM.tran_particular_code
			BANCS.OUTPUT.tran_particular_code=sv_h
			
			sv_h = BANCS.OUTPARAM.tran_particular_2
			BANCS.OUTPUT.tran_particular2=sv_h
			
			IF( BANCS.OUTPARAM.trea_rate > 0 ) THEN
			#{
				sv_n = BANCS.OUTPARAM.trea_rate
				sv_n = Format$(CDOUBLE(sv_n),"%.4f")
				BANCS.OUTPUT.treasury_rate = sv_n
			#}
			ENDIF
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.rate_code)) THEN
			#{
				IF( BANCS.OUTPARAM.rate_code != "" ) THEN
				#{
					BANCS.OUTPARAM.rate = Format$(CDOUBLE(BANCS.OUTPARAM.rate), "%.4f")
					BANCS.OUTPUT.rate_code = BANCS.OUTPARAM.rate_code + "/" + BANCS.OUTPARAM.rate
				#}
				ENDIF
			#}
			ENDIF
			
			#----Posted user id and date
			IF(sv_v != "") THEN
			#{
				BANCS.INPARAM.dateToBeAdded = sv_v
				sv_p = urhk_convertTimetoDiffTimeZone("")
				sv_p =  BANCS.OUTPARAM.convDate
				sv_h = sv_w + " / "
				sv_h = sv_h + sv_p
				BANCS.OUTPUT.posted= sv_h
			#}
			ENDIF
			
			#----Verified user id and date
			IF(sv_q != "") THEN
			#{
				BANCS.INPARAM.dateToBeAdded = sv_q
				sv_p = urhk_convertTimetoDiffTimeZone("")
				sv_p =  BANCS.OUTPARAM.convDate
				sv_h = sv_l + " / "
				sv_h = sv_h + sv_p
				BANCS.OUTPUT.verified= sv_h
			#}
			ENDIF
			
			#---- Entery user id and date
			IF(sv_x != "") THEN
			#{
				BANCS.INPARAM.dateToBeAdded = sv_x
				sv_p = urhk_convertTimetoDiffTimeZone("")
				sv_p =  BANCS.OUTPARAM.convDate
				sv_h = sv_k + " / "
				sv_h = sv_h + sv_p
				BANCS.OUTPUT.entered= sv_h
			#}
			ENDIF
			
			
		#}
		ENDIF
		
		sv_d = "instrmnt_type,instrmnt_num,instrmnt_date,ref_num,tran_particular,tran_rmks,rate,rpt_code| select instrmnt_type,instrmnt_num,to_char(instrmnt_date,'DD-MM-YYYY'),ref_num,tran_particular,tran_rmks,rate,rpt_code from TBAADM.DTD"
		sv_d = sv_d + " where"
		sv_d = sv_d + " DTD.tran_id = ?SVAR "
		sv_d = sv_d + " AND DTD.tran_date = TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS')"
		sv_d = sv_d + " AND DTD.part_tran_srl_num = ?SVAR "
		sv_d = sv_d + " AND DTD.BANK_ID = ?SVAR "
		
		BANCS.INPARAM.BINDVARS = sv_b + "|" + sv_a + "|" + sv_c + "|" + BANCS.STDIN.contextBankId
		
		sv_e = urhk_dbSelectWithBind(sv_d)
		IF(sv_e == 0) THEN
		#{
			BANCS.OUTPUT.inst_type			= BANCS.OUTPARAM.instrmnt_type
			BANCS.OUTPUT.inst_no			= BANCS.OUTPARAM.instrmnt_num
			BANCS.OUTPUT.ref_no	    		= BANCS.OUTPARAM.ref_num
			BANCS.OUTPUT.tran_remarks		= BANCS.OUTPARAM.tran_rmks
			BANCS.OUTPUT.tran_particular1	= BANCS.OUTPARAM.tran_particular
			BANCS.OUTPUT.report_code		= BANCS.OUTPARAM.rpt_code
			BANCS.INPARAM.dtddmmyyyy =BANCS.OUTPARAM.instrmnt_date
			CALL("ddmmyyyTOmmddyyyy.scr")
			BANCS.OUTPUT.inst_date=MID$(BANCS.OUTPARAM.dtmmddyyyy,0,10)
		#}
		ENDIF
		
		sv_d = "init_sol_id,remarks | select init_sol_id,remarks from TBAADM.DTH"
		sv_d = sv_d + " where "
		sv_d = sv_d + " DTH.tran_date= TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
		sv_d = sv_d + " AND DTH.tran_id= ?SVAR "
		sv_d = sv_d + " AND DTH.BANK_ID = ?SVAR "
		
		BANCS.INPARAM.BINDVARS =  sv_a + "|" + sv_b + "|" + BANCS.STDIN.contextBankId
		
		sv_e = urhk_dbSelectWithBind(sv_d)
		
		IF(sv_e == 0) THEN
		#{
			BANCS.OUTPUT.header_remarks=BANCS.OUTPARAM.remarks
			BANCS.OUTPUT.tran_sol_id=BANCS.OUTPARAM.init_sol_id
		#}
		ENDIF
	#}
	ENDIF
	#-----------------------------------------------------------------------
	#trace off
END-->
