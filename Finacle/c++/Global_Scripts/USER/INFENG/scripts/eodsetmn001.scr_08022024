						print(sv_d)
						CUST.DATA.resultMsg = "RCC EXEMPT ADDING Failed"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
			
				ELSE
					
					CUST.DATA.resultMsg = "ALREAY RCC EXEMPT RECORD FOR THE ACCOUNT EXIST"
					GOTO ENDOFSCRIPT
				
				ENDIF

			ENDIF

					
					
	ELSE
