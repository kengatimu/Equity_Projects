#----Edwin for demand regularization INC0158203 10112022
if(CUST.DATA.funcCode == "AGENTODREG" )then
#{
        if((BANCS.STDIN.userWorkClass =="310")or(BANCS.STDIN.userWorkClass >="510"))then
        #{

	sv_q = "count,cifid|select count(*),FREE_TEXT1 from custom.agddt where del_flg ='N' and foracid =?SVAR and dmd_amt-tot_adj_amt >0 "
	sv_q = sv_q + " and dep_command='CSWOP' and dep_dccid='BATCH' and bank_id =?SVAR group by FREE_TEXT1 "
	print(sv_q)
	BANCS.INPARAM.BINDVARS =  CUST.DATA.userId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)
	if(sv_p==0)then
		CUST.DATA.count = BANCS.OUTPARAM.count
		print (CUST.DATA.count)
		CUST.DATA.cifid = BANCS.OUTPARAM.cifid
		print (CUST.DATA.cifid)
		if(cdouble(CUST.DATA.count)<=0)then
			CUST.DATA.resultMsg = "No outstanding demands for the agent  " + CUST.DATA.userId 
			GOTO ENDOFSCRIPT
		else
			sv_q = "foracid,balamt|select foracid,clr_bal_amt from tbaadm.gam where cif_id =?SVAR and schm_code ='OD541' and del_flg ='N' and entity_cre_flg ='Y' and bank_id =?SVAR"
			print(sv_q)
			BANCS.INPARAM.BINDVARS =  CUST.DATA.cifid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_p= urhk_dbSelectWithBind(sv_q)
			print(sv_p)
			if(sv_p==0)then
				CUST.DATA.foracid = BANCS.OUTPARAM.foracid
				print(CUST.DATA.foracid)
				CUST.DATA.balamt = BANCS.OUTPARAM.balamt
				print(CUST.DATA.balamt)
				if(cdouble(CUST.DATA.balamt)<0)then
					CUST.DATA.resultMsg = "OD account" + CUST.DATA.foracid + "is in debit balance"
					GOTO ENDOFSCRIPT
				else
					sv_q = "update custom.agddt set del_flg='Y',free_text3='Deleted For CR Balance',free_text4=?SVAR,free_text5=sysdate where bank_id=?SVAR and foracid=?SVAR and free_text1=?SVAR"
					print(sv_q)
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.userId + "|" + CUST.DATA.cifid
					print(BANCS.INPARAM.BINDVARS)
					sv_b =  urhk_dbSqlWithBind(sv_q)
					print(sv_b)
					if(sv_b == 0)then
						sv_d = urhk_dbSqlWithBind("COMMIT")
						print(sv_d)
						CUST.DATA.resultMsg = "outstanding demands dropped successfully check the demand schedule"
						GOTO ENDOFSCRIPT
					else
						sv_d = urhk_dbSqlWithBind("ROLLBACK")
						print(sv_d)
						CUST.DATA.resultMsg = "oustanding demand drop failed!!! Retry again and check damand schedule"
						GOTO ENDOFSCRIPT
					endif
				endif
			else
				CUST.DATA.resultMsg = "Record not found check account"
				GOTO ENDOFSCRIPT
			endif
		endif
	else
		CUST.DATA.resultMsg = "Record not found check account"
		GOTO ENDOFSCRIPT	
	endif
	else
	       CUST.DATA.resultMsg = "only Work Class 310 and banksupport Workclasses allowed"
               GOTO ENDOFSCRIPT
        #}
        endif
endif
