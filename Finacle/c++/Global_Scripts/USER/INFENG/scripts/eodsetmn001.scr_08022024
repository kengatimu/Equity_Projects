IF ( CUST.DATA.funcCode == "CRM" ) THEN
#{

	IF (BANCS.STDIN.userWorkClass> 599) THEN
		#------------------------------------------------------------------------------
		#Finding count of records that need to be processed
		#------------------------------------------------------------------------------
		sv_s="custcount|"
		sv_s = sv_s + " SELECT COUNT(1) "
		sv_s = sv_s + " FROM CUSTOM.BULK_CIF "
		sv_s = sv_s + " WHERE entity_cre_flg='N' "
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d != 0) THEN 
		#{
			CUST.DATA.errMsg = "DB ERROR!"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			print(BANCS.OUTPARAM.custcount)
			IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		sv_s="cifid,empid|"
		sv_s = sv_s + " SELECT cif_id,national_id "
		sv_s = sv_s + " FROM custom.bulk_cif "
		sv_s = sv_s + " WHERE entity_cre_flg='N' "
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)

		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		print(sv_c)

		IF (sv_c==0) then
		#{
			CUST.DATA.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_k = urhk_dbCursorFetch(CUST.DATA.DbcursorNumber)
			print(sv_k)

			WHILE (sv_k == 0)
			#{

				CUST.DATA.cifid	= BANCS.OUTPARAM.cifid
				CUST.DATA.empid	= BANCS.OUTPARAM.empid

				sv_a = "update crmuser.accounts set SECONDARYRM_ID= ?SVAR "
				sv_a = sv_a + " where  bank_id= ?SVAR and orgkey= ?SVAR "
				print(sv_a)
				BANCS.INPARAM.BINDVARS = CUST.DATA.empid  + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.cifid
				print(BANCS.INPARAM.BINDVARS)
				sv_b =  urhk_dbSqlWithBind(sv_a)
				print(sv_b)
				IF(sv_b == 0)THEN
				#{
					sv_d = urhk_dbSqlWithBind("COMMIT")
					print(sv_d)

					sv_s = "UPDATE CUSTOM.BULK_CIF "
					sv_s = sv_s + " SET entity_cre_flg = 'P' "
					sv_s = sv_s + " WHERE national_id= ?SVAR"
					sv_s = sv_s + " AND cif_id = ?SVAR"
					sv_s = sv_s + " AND bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.DATA.empid + "|" + CUST.DATA.cifid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
			
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
					
				#}
				ELSE
				#{
					sv_d = urhk_dbSqlWithBind("ROLLBACK")
					print(sv_d)
					CUST.DATA.resultMsg = "Data Modification Failed"
					sv_s = "UPDATE CUSTOM.BULK_CIF "
					sv_s = sv_s + " SET entity_cre_flg = 'E',ERROR_CODE =?SVAR  "
					sv_s = sv_s + " WHERE national_id= ?SVAR "
					sv_s = sv_s + " AND bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.DATA.resultMsg + "|" + CUST.DATA.empid + "|" + BANCS.STDIN.contextBankId 
					print(BANCS.INPARAM.BINDVARS)
			
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
				#}
				ENDIF

				sv_k = urhk_dbCursorFetch(CUST.DATA.DbcursorNumber)
				print(sv_k)

			#}
			DO

			sv_c = urhk_dbCursorClose(CUST.DATA.DbcursorNumber)
			print(sv_c)

		#}
		ENDIF
		CUST.DATA.resultMsg = "Data Modification Successful"
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.DATA.resultMsg = "Work Class Above 600 .. Failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

#}
ENDIF

