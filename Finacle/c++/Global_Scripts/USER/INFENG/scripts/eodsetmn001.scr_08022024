IF ( CUST.DATA.funcCode == "DISBIO" ) THEN
#{

	IF (BANCS.STDIN.userWorkClass < 600) THEN
	CUST.DATA.resultMsg = "Workclass 650 and above"
	GOTO ENDOFSCRIPT
	ENDIF

	PRINT(CUST.DATA.userId)
	CUST.DATA.TBL = "CUSTOM.BIO_VAL_CHK_" + CUST.DATA.userId
	PRINT(CUST.DATA.TBL)
	CUST.DATA.TBL2 = "BIO_VAL_CHK_" + CUST.DATA.userId
	PRINT(CUST.DATA.TBL2)

	sv_s="tbcount| SELECT COUNT(*) FROM all_tables where  OWNER ='CUSTOM' AND TABLE_NAME = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.DATA.TBL2
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0) THEN		
		#{

		PRINT(BANCS.OUTPARAM.tbcount)
		IF (CINT(BANCS.OUTPARAM.tbcount)> 0 ) THEN 
			#{
			sv_s = " recount| SELECT COUNT(*) FROM " + CUST.DATA.TBL + " "
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)				
			CUST.DATA.resultMsg = "Table " + CUST.DATA.TBL + " already Exist with " + BANCS.OUTPARAM.recount + " Records"
			PRINT(CUST.DATA.resultMsg)
			GOTO ENDOFSCRIPT
			#}
		ELSE
						
			sv_u = urhk_getFileLocation("COM|twofactor.com")
			sv_l = BANCS.OUTPARAM.fileLocation
			sv_t = sv_l + "twofactor.com" + " " + CUST.DATA.TBL + " " + CUST.DATA.userId
			sv_u = SYSTEM(sv_t)
			sv_k = 1
			CUST.DATA.resultMsg = " Table " + CUST.DATA.TBL + " Created, "
			PRINT(CUST.DATA.resultMsg)
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.userId
			sv_a = " update SSOADM.USER_PROFILE_TBL  set REQ_TWO_FACTOR_AUTH='N' where REQ_TWO_FACTOR_AUTH='B' and HOME_ENTITY =?SVAR "
			sv_d = urhk_dbSqlWithBind(sv_a)
			print (sv_d)
			IF (sv_d == 0) THEN	
			CUST.DATA.resultMsg =  CUST.DATA.resultMsg + " SSO updated auth to N for entity " + CUST.DATA.userId
			PRINT(CUST.DATA.resultMsg)
			GOTO ENDOFSCRIPT
			ENDIF
		ENDIF
	ENDIF

#}
ENDIF


IF ( CUST.DATA.funcCode == "ENABIO" ) THEN
#{
			IF (BANCS.STDIN.userWorkClass < 600) THEN
