IF(CUST.DATA.funcCode == "RSCEXEMPT" )THEN
#{



IF (BANCS.STDIN.userWorkClass >514 ) THEN
	
		print(CUST.DATA.userId)
		CUST.DATA.DATALEN = STRLEN(CUST.DATA.userId)
		print (CUST.DATA.DATALEN)
		CUST.DATA.TASK= MID$(CUST.DATA.userId,0,3)
		print(CUST.DATA.TASK)

		IF  ((CUST.DATA.TASK !="ADD") AND (CUST.DATA.TASK !="DEL")) THEN
			CUST.DATA.resultMsg = "Valid Options ADD or DEL  eg ADD010101011010"
			GOTO ENDOFSCRIPT	
		ENDIF

		CUST.DATA.ACCT = MID$(CUST.DATA.userId,3,cint(CUST.DATA.DATALEN))
		PRINT (CUST.DATA.ACCT)


sv_b = urhk_getAcctDetailsInRepository(CUST.DATA.ACCT)
IF(sv_b == 0) then
     	CUST.DATA.schemeType = BANCS.OUTPARAM.schemeType
        Print (CUST.DATA.schemeType )
ELSE

  CUST.DATA.resultMsg = "Invalid account"
  GOTO ENDOFSCRIPT
ENDIF
		

		sv_a = " count|select count(*) from  CUSTOM.ACCT_EXEMPTION_TABLE where  EXEMPT_CODE  ='RCC' and foracid = ?SVAR and  bank_id = ?SVAR "
		print(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.DATA.ACCT + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_a)
		print(sv_b)
			IF(sv_b == 0)THEN
				CUST.DATA.COUNT = BANCS.OUTPARAM.count 
				PRINT(CUST.DATA.COUNT)
			ELSE
					CUST.DATA.resultMsg = "DATE ERROR"
					GOTO ENDOFSCRIPT
		
			ENDIF

			IF (CUST.DATA.TASK =="DEL") THEN	
		 		IF  (CUST.DATA.COUNT != 0) THEN	
				
				sv_a=" DELETE CUSTOM.ACCT_EXEMPTION_TABLE where foracid = ?SVAR and  bank_id = ?SVAR and  EXEMPT_CODE  ='RCC' "	
				sv_d = urhk_dbSQLWithBind(sv_a)
				print(sv_d)
					IF(sv_b == 0)THEN
					#{
						sv_d = urhk_dbSqlWithBind("COMMIT")
						print(sv_d)
						CUST.DATA.resultMsg = "RCC EXEMPT REVOKED Successful"
						GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						sv_d = urhk_dbSqlWithBind("ROLLBACK")
						print(sv_d)
						CUST.DATA.resultMsg = "RCC EXEMPT REVOKED Failed"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
			
				ELSE
					
					CUST.DATA.resultMsg = "NO RCC EXEMPT RECORD FOR THE ACCOUNT"
					GOTO ENDOFSCRIPT
				
				ENDIF

			ENDIF

			IF (CUST.DATA.TASK =="ADD") THEN	
		 		IF  (CUST.DATA.COUNT == 0) THEN	
				
				sv_a=" Insert into CUSTOM.ACCT_EXEMPTION_TABLE (FORACID ,EXEMPT_CODE,BANK_ID, DEL_FLG) Values   (?SVAR,'RCC',?SVAR, 'N') "	
				sv_d = urhk_dbSQLWithBind(sv_a)
				print(sv_d)
					IF(sv_b == 0)THEN
					#{
						sv_d = urhk_dbSqlWithBind("COMMIT")
						print(sv_d)
						CUST.DATA.resultMsg = "RCC EXEMPT ADDED Successful"
						GOTO ENDOFSCRIPT
					#}
