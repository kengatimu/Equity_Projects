				sv_d = urhk_dbSqlWithBind("COMMIT")
				print(sv_d)
				CUST.DATA.resultMsg = "JOBID " + CUST.DATA.userId + " process deleted "
				GOTO ENDOFSCRIPT
			else
				sv_d = urhk_dbSqlWithBind("ROLLBACK")
				print(sv_d)
				CUST.DATA.resultMsg = "JOBID deletion failed"
				GOTO ENDOFSCRIPT
			endif
			
			
		endif
	else
		CUST.DATA.resultMsg = "Record not found check the job ID"
		GOTO ENDOFSCRIPT	
	endif
#}
endif

