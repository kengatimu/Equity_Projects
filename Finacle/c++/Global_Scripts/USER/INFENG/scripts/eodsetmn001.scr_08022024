		if(cdouble(CUST.DATA.count)<=0)then
			CUST.DATA.resultMsg = "JOB ID " + CUST.DATA.userId + " is not executing"
			GOTO ENDOFSCRIPT
		else			
			sv_q = "delete from tbaadm.jct where EXTERNAL_REFERENCE_ID=?SVAR and JOB_STATUS='E' and sol_id =?SVAR and bank_id =?SVAR "
			print(sv_q)
			BANCS.INPARAM.BINDVARS =  CUST.DATA.userId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_b =  urhk_dbSqlWithBind(sv_q)
