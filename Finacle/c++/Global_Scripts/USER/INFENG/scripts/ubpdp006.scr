		CALL("ubpdp050.scr")
	#}
	ENDIF


	#========================================================
	# Moving the charge calculation to the end so that any  failures will not be commited. 
	#========================================================
	

                #CHARGE CALCULATION
                IF(CUST.UBP.chgEvetId!="")THEN
                #{
                        IF(FIELDEXISTS(BANCS.STDIN.EmployeeId))THEN
                        #{
                                IF(BANCS.STDIN.EmployeeId!="")THEN
                                #{
                                        CUST.UBP.empId=BANCS.STDIN.EmployeeId
                                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeSolId+"|"+BANCS.STDIN.contextBankId+"|"+CUST.UBP.payRefCrncy+"|"+CUST.UBP.empId
                                        sv_s="count1|"
                                        sv_s = sv_s + " SELECT COUNT(1)"
                                        sv_s = sv_s + " FROM TBAADM.GEC"
                                        sv_s = sv_s + " WHERE SOL_ID=?SVAR"
                                        sv_s = sv_s + " AND BANK_ID=?SVAR"
                                        sv_s = sv_s + " AND CRNCY_CODE=?SVAR"
                                        sv_s = sv_s + " AND EMP_ID=?SVAR"
                                        sv_d = urhk_dbSelectWithBind(sv_s)
                                        PRINT(sv_d)
                                        IF(sv_d==0)THEN
                                        #{
                                                CUST.UBP.count1=BANCS.OUTPARAM.count1
                                                IF(CUST.UBP.count1==0)THEN
                                                #{
                                                        CUST.UBP.errorFlg = "Y"
                                                        #CUST.UBP.errorMsg = "No bacid linked to the corresponding Employee Id"+CUST.UBP.empId
                                                        CUST.UBP.errorCode = "UBP_ERR009"
