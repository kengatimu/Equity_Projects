                                                        CUST.UBP.errorMsg=CUST.UBP.errorDesc+CUST.UBP.empId
                                                        CUST.UBP.errorFocus="random"
                                                        #ADDED
                                                        sv_u = urhk_dbSqlWithBind("ROLLBACK")
                                                        print(sv_u)
                                                        GOTO ENDOFSCRIPT
						#}
                                                ELSE
						#{
                                                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeSolId+"|"+BANCS.STDIN.contextBankId+"|"+CUST.UBP.payRefCrncy+"|"+CUST.UBP.empId
                                                        sv_s="empCashAcct|"
                                                        sv_s = sv_s + " SELECT EMP_CASH_ACCT"
                                                        sv_s = sv_s + " FROM TBAADM.GEC"
                                                        sv_s = sv_s + " WHERE SOL_ID=?SVAR"
                                                        sv_s = sv_s + " AND BANK_ID=?SVAR"
                                                        sv_s = sv_s + " AND CRNCY_CODE=?SVAR"
                                                        sv_s = sv_s + " AND EMP_ID=?SVAR"
                                                        sv_d = urhk_dbSelectWithBind(sv_s)
                                                        PRINT(sv_d)
                                                        IF(sv_d==0)THEN
                                                        #{
                                                                CUST.UBP.empCashAcct=BANCS.OUTPARAM.empCashAcct
                                                                PRINT(CUST.UBP.empCashAcct)
                                                                IF(CUST.UBP.empCashAcct=="")THEN
                                                                #{
                                                                        CUST.UBP.errorFlg = "Y"
                                                                        #CUST.UBP.errorMsg = "No bacid linked to empId "+CUST.UBP.empId
                                                                        CUST.UBP.errorCode = "UBP_ERR010"
                                                                        CALL("ubpdp044.scr")
                                                                        CUST.UBP.errorMsg=CUST.UBP.errorDesc+CUST.UBP.empId
                                                                        CUST.UBP.errorFocus="random"
                                                                        #ADDED
                                                                        sv_u = urhk_dbSqlWithBind("ROLLBACK")
                                                                        print(sv_u)
                                                                        GOTO ENDOFSCRIPT
                                                                #}
                                                                ENDIF
                                                                BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeSolId+"|"+BANCS.STDIN.contextBankId+"|"+CUST.UBP.payRefCrncy+"|"+CUST.UBP.empCashAcct
                                                                sv_s="chargeDebitAcctId|"
                                                                sv_s = sv_s + " SELECT FORACID"
                                                                sv_s = sv_s + " FROM TBAADM.GAM"
                                                                sv_s = sv_s + " WHERE SOL_ID=?SVAR"
                                                                sv_s = sv_s + " AND BANK_ID=?SVAR"
                                                                sv_s = sv_s + " AND ACCT_CRNCY_CODE=?SVAR"
                                                                sv_s = sv_s + " AND BACID=?SVAR"
                                                                sv_d = urhk_dbSelectWithBind(sv_s)
                                                                IF(sv_d==0)THEN
                                                                #{
                                                                        CUST.UBP.chargeDebitAcctId=BANCS.OUTPARAM.chargeDebitAcctId
                                                                        PRINT(CUST.UBP.chargeDebitAcctId)
                                                                #}
                                                                ELSE
                                                                #{
                                                                        CUST.UBP.errorFlg = "Y"
                                                                        #CUST.UBP.errorMsg = "No account linked to the bacid "+CUST.UBP.empCashAcct+" AND currency combination "+CUST.UBP.payRefCrncy
                                                                        CUST.UBP.errorCode = "UBP_ERR011"
                                                                        CALL("ubpdp044.scr")
                                                                        CUST.UBP.errorDesc1=CUST.UBP.errorDesc
                                                                        CUST.UBP.errorCode = "UBP_ERR012"
                                                                        CALL("ubpdp044.scr")
                                                                        CUST.UBP.errorDesc2=CUST.UBP.errorDesc
                                                                        CUST.UBP.errorMsg=CUST.UBP.errorDesc1+CUST.UBP.empCashAcct+CUST.UBP.errorDesc2+CUST.UBP.payRefCrncy
                                                                        CUST.UBP.errorFocus="random"
                                                                        #ADDED
                                                                        sv_u = urhk_dbSqlWithBind("ROLLBACK")
                                                                        print(sv_u)
                                                                        GOTO ENDOFSCRIPT
                                                                #}
                                                                ENDIF
							#}
                                                        ELSE
							#{
                                                                CUST.UBP.errorFlg = "Y"
                                                                #CUST.UBP.errorMsg = "No bacid linked to empId "+CUST.UBP.empId
                                                                CUST.UBP.errorCode = "UBP_ERR010"
                                                                CALL("ubpdp044.scr")
                                                                CUST.UBP.errorMsg =CUST.UBP.errorDesc
                                                                CUST.UBP.errorFocus="random"
