                                                        #}
                                                        ENDIF


                                                #}
                                                ENDIF
                                        #}
                                        ENDIF
                                #}
                                ENDIF
                        #}
                        ENDIF



                        CUST.UBP.ChargepayAcctId=CUST.UBP.chargeDebitAcctId
                        CUST.UBP.ChargepayRefCrncy=CUST.UBP.payRefCrncy
                        IF(CUST.UBP.payRefCrncy == BANCS.STDIN.homeCrncyCode)THEN
