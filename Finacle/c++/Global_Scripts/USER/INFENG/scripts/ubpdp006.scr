			#BANCS.INPARAM.BINDVARS = CUST.UBP.billerId+"|"+CUST.UBP.billAcctId+"|Y|N|" + BANCS.STDIN.contextBankId

			BANCS.INPARAM.BINDVARS = CUST.UBP.billerId + "|" + CUST.UBP.billAcctId + "|Y|N"
			print(BANCS.INPARAM.BINDVARS)

			sv_s = "billerBnkId|"
			sv_s = sv_s + " SELECT FREE_TEXT2"
			sv_s = sv_s + " FROM TBAADM.BRGT "
			sv_s = sv_s + " WHERE BILLER_ID=?SVAR"
			sv_s = sv_s + " AND FREE_TEXT1=?SVAR"
			sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
			sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
			#sv_s = sv_s + " AND BANK_ID = ?SVAR"
			PRINT(sv_s)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d==0)THEN
			#{	
				CUST.UBP.billerBnkId = BANCS.OUTPARAM.billerBnkId
				PRINT(CUST.UBP.billerBnkId)
			#}
			ENDIF
					
		#change-ends
			BANCS.INPARAM.BINDVARS = CUST.UBP.billAcctId +"|Y|N|"+ CUST.UBP.billerBnkId
			sv_s = "acctCrncyCode,billerBnkId|"
			sv_s = sv_s + " SELECT ACCT_CRNCY_CODE,BANK_ID"
			sv_s = sv_s + " FROM TBAADM.GAM "
			sv_s = sv_s + " WHERE FORACID=?SVAR"
			sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG, 'Y') = ?SVAR"
			sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
			sv_s = sv_s + " AND BANK_ID = ?SVAR"
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d!=0)THEN
			#{
				CUST.UBP.errorFlg = "Y"
				#CUST.UBP.errorMsg="Invalid Biller A/c Id linked to Biller"
				CUST.UBP.errorCode = "UBP_ERR002"
				CALL("ubpdp044.scr")
				CUST.UBP.errorMsg =CUST.UBP.errorDesc
				CUST.UBP.errorFocus="random"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.UBP.crncyCode=BANCS.OUTPARAM.acctCrncyCode
