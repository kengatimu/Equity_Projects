				CUST.DATA.phoneno                =       BANCS.OUTPARAM.phoneno
				Print(CUST.DATA.phoneno)
				CUST.ALERTS.phoneno  = CUST.DATA.phoneno
				CUST.ALERTS.trandate = mid$(BANCS.STDIN.BODDate,0,10)
				#CUST.ALERTS.massage  = "Dear Customer, Your transaction of Kshs. "+ CUST.DATA.Amount + " has successfully been Debited from Equity Account in Favour of  " + CUST.ALERTS.CName + " Ref. Number " + CUST.DATA.TranId  + ". Thank you."
				CUST.ALERTS.massage  = "Dear Customer, Your transaction of Kshs. "+ CUST.DATA.AmountX + " Remarks " + CUST.DATA.trandetails + " is successful. Thank you."
				Print (CUST.ALERTS.massage )
				CALL("smspushothers.scr")
			ENDIF

                        sv_z = "phoneno|select p.phoneno from CRMUSER.PHONEEMAIL p, tbaadm.gam g where p.bank_id=g.bank_id and p.orgkey=g.cif_id "
                        sv_z = sv_z+ " and p.preferredflag='Y' and  g.foracid=?SVAR and PHONEOREMAIL ='PHONE' and rownum=1 "
			print(sv_z)
                        BANCS.INPARAM.BINDVARS = CUST.DATA.Craccountnumber
			sv_d = urhk_dbselectWithBind(sv_z)
			PRINT(sv_d)
                        IF(sv_d==0)THEN
                                CUST.DATA.phoneno                =       BANCS.OUTPARAM.phoneno
                                Print(CUST.DATA.phoneno)
                                CUST.ALERTS.phoneno  = CUST.DATA.phoneno
                                CUST.ALERTS.trandate = mid$(BANCS.STDIN.BODDate,0,10)
                                CUST.ALERTS.massage  = "Dear Customer, Your transaction of Kshs. "+ CUST.DATA.AmountX + " Remarks " + CUST.DATA.trandetails + " is successful. Thank you."
                                Print (CUST.ALERTS.massage )
                                CALL("smspushothers.scr")
                        ENDIF
                ENDIF

		CUST.DATA.tranId = ""
		CUST.DATA.TranId = ""

		sv_c = urhk_dbCursorFetch(CUST.DATA.cursorNum)
		print(sv_c)
		print(CUST.DATA.cursorNum)
		print(sv_a)
          DO

		sv_r = "exebatch babx4040 $B2K_SESSION_ID "+CUST.DATA.SuccFile+ " 'Upload CTTUM Auto Post Transaction Success Report' MANAGER 1 N"
		sv_r = system(sv_r)
		sv_r = "exebatch babx4040 $B2K_SESSION_ID "+CUST.DATA.FailFile+ " 'Upload CTTUM Auto Post Transaction Fail Report' MANAGER 1 N"
		sv_r = system(sv_r)
		sv_g = urhk_dbCursorClose(CUST.DATA.cursorNum)
		print(sv_g)

ENDOFSCRIPT:
exitscript
