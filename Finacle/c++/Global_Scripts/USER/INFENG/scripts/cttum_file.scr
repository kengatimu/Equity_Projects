<--START
TRACE ON


	if (REPEXISTS("CUST")==0)THEN
		CREATEREP("CUST")
	endif

	if (CLASSEXISTS("CUST","DATA")==0)THEN
		CREATECLASS("CUST","DATA",5)
	endif

        sv_z = urhk_dbSelectWithBind("TimeStamp|select to_char(sysdate,'hh24miss') from dual ")
        CUST.DATA.TimeStamp = BANCS.OUTPARAM.TimeStamp
	CUST.DATA.Status = ""
	CUST.DATA.tranId = ""
	CUST.DATA.custname = ""
        CUST.DATA.FailFile = "CR_"+CUST.DATA.TimeStamp+".fai"
        CUST.DATA.SuccFile = "CR_"+CUST.DATA.TimeStamp+".suc"

        sv_k="FAILURE REPORT"
        sv_t=system("echo '"+sv_k+"' > "+CUST.DATA.FailFile)
        sv_k="Success Report"
        sv_t=system("echo '"+sv_k+"' > "+CUST.DATA.SuccFile)

	sv_x = urhk_B2k_PrintRepos("BANCS")
        print(sv_x)

	CUST.DATA.processed_flg ="N"

		sv_a =" Draccountnumber,Draccountcurrency,Craccountnumber,Craccountcurrency,amount,trandetails,tran_particularcode,bankid,lchguserid,rcreuserid," 
		sv_a =sv_a+" delflg,entitycreflg,processedflg|select nvl(Dr_account_number,'NA'),nvl(Dr_account_currency,'NA'),nvl(Cr_account_number,'NA'),nvl(Cr_account_currency,'NA'), "
		sv_a =sv_a+" nvl(amount,'NA'),nvl(tran_details,'NA'),nvl(tran_particular_code,'NA'),nvl(bank_id,'NA'),nvl(lchg_user_id,'NA'),nvl(rcre_user_id,'NA'),nvl(del_flg,'NA'), "
		sv_a =sv_a+" nvl(entity_cre_flg,'NA'),nvl(processed_flg,'NA') from custom.cttum_auto_post_process "
		sv_a =sv_a+" where processed_flg =?SVAR  and del_flg ='N' and  batchid  =?SVAR "
		PRINT(sv_a)
		BANCS.INPARAM.BINDVARS =CUST.DATA.processed_flg +"|"+ CUST.DATA.BatchID  
		print(BANCS.INPARAM.BINDVARS)

		sv_o = urhk_dbCursorOpenWithBind(sv_a)
		print(sv_o)
		CUST.DATA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_c = urhk_dbCursorFetch(CUST.DATA.cursorNum)
		print(sv_c)

		IF(sv_c !=0) Then
			sv_j = urhk_dbCursorClose(CUST.DATA.cursorNum)
			print(sv_j)
			GOTO ENDOFSCRIPT
		ENDIF


		sv_a=1
		WHILE(sv_c == 0)
			CUST.DATA.Draccountnumber = BANCS.OUTPARAM.Draccountnumber
			print(CUST.DATA.Draccountnumber)
			CUST.DATA.Draccountcurrency = BANCS.OUTPARAM.Draccountcurrency
			print(CUST.DATA.Draccountcurrency)
			CUST.DATA.Craccountnumber = BANCS.OUTPARAM.Craccountnumber
			print(CUST.DATA.Craccountnumber)
			CUST.DATA.Craccountcurrency = BANCS.OUTPARAM.Craccountcurrency
			print(CUST.DATA.Craccountcurrency)
			CUST.DATA.amount = BANCS.OUTPARAM.amount
			print(CUST.DATA.amount)
			CUST.DATA.Amount = CUST.DATA.amount
			CUST.DATA.trandetails = BANCS.OUTPARAM.trandetails
			print(CUST.DATA.trandetails)
			CUST.DATA.tranparticularcode = BANCS.OUTPARAM.tran_particularcode
			print(CUST.DATA.tranparticularcode)
			CUST.DATA.bankid = BANCS.OUTPARAM.bankid
			print(CUST.DATA.bankid)
			CUST.DATA.lchguserid = BANCS.OUTPARAM.lchguserid
			print(CUST.DATA.lchguserid)
			CUST.DATA.rcreuserid = BANCS.OUTPARAM.rcreuserid
			print(CUST.DATA.rcreuserid)
			CUST.DATA.delflg = BANCS.OUTPARAM.delflg
			print(CUST.DATA.delflg)
			CUST.DATA.entitycreflg = BANCS.OUTPARAM.entitycreflg
			print(CUST.DATA.entitycreflg)
			CUST.DATA.processedflg = BANCS.OUTPARAM.processedflg
			print(CUST.DATA.processedflg)

			CUST.DATA.TranId = ""
			call("cttum_mtt.scr")

			print(CUST.DATA.TranId)
		
		
			IF(CUST.DATA.TranId!="")THEN
				print(CUST.DATA.TranId)
				BANCS.INPARAM.BINDVARS = CUST.DATA.TranId+"|Y|"+CUST.DATA.Craccountnumber+"|"+CUST.DATA.tranparticularcode+"|N|"+CUST.DATA.trandetails +"|"+ CUST.DATA.BatchID
				print(BANCS.INPARAM.BINDVARS)
				sv_s = "UPDATE CUSTOM.CTTUM_AUTO_POST_PROCESS SET TRAN_ID=?SVAR , processed_flg =?SVAR WHERE  CR_ACCOUNT_NUMBER =?SVAR AND TRAN_PARTICULAR_CODE =?SVAR AND DEL_FLG=?SVAR AND TRAN_DETAILS =?SVAR and batchid =?SVAR"
				PRINT(sv_s)
				sv_d = urhk_dbSqlWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d==0)THEN
				       sv_d = urhk_dbSqlWithBind("COMMIT")
				ELSE
				      sv_d = urhk_dbSqlWithBind("ROALLBACK")
				ENDIF
				sv_t=system("echo  Account Number :'"+CUST.DATA.Draccountnumber+"' , TranID:'"+CUST.DATA.TranId+"' >> "+CUST.DATA.SuccFile)
			ELSE
				sv_t=system("echo  Debit Acct :'"+CUST.DATA.Draccountnumber+"' , Credit Acc :'"+CUST.DATA.Craccountnumber+"' , Credit Amt :'"+CUST.DATA.amount+"' , Status :'"+CUST.DATA.Status+"' >> "+CUST.DATA.FailFile)
				print("Hello WOrld")
			ENDIF


                IF(REPEXISTS("CUST") == 0 ) THEN
                    CREATEREP("CUST")
                ENDIF
                IF (CLASSEXISTS("CUST","ALERTS") == 0) THEN
                    CREATECLASS("CUST","ALERTS",5)
                ENDIF
		CUST.ALERTS.CName = ""
                sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.Draccountnumber)
                if(sv_u==0)then
                        CUST.ALERTS.DName = BANCS.OUTPARAM.acctName
                ENDIF

                sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.Craccountnumber)
                if(sv_u==0)then
                        CUST.ALERTS.CName = BANCS.OUTPARAM.acctName
                ENDIF

                IF (CUST.DATA.TranId!= "") THEN
		#{
			##---James Irungu for C2b ----CTASK0013510 05122022
			CUST.DATA.AmountX =""
			CUST.DATA.AmountX =  FORMAT$(CDOUBLE(CUST.DATA.Amount),"%.2f")
			
			CUST.DATA.phoneno = ""
