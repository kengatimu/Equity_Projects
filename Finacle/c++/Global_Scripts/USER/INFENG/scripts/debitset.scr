	#{
		EXITSCRIPT
	#}
	ENDIF
	
	#Check tran in dtd for DR leg"-----Ichangai
	sv_a= "countex|select count(1) from tbaadm.dtd where acid in "
	sv_a= sv_a + "(select acid from tbaadm.gam where foracid=?SVAR) "
	sv_a= sv_a + " and PSTD_FLG!='Y' and bank_id=?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.DEBITALL.drAccount + "|" + BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.countex)
		 IF (CINT(BANCS.OUTPARAM.countex) > 0) THEN
		  #{
		   CUST.DEBITALL.Response="Check Tran in Entered status for the FDR a/c"
		   GOTO Finish
		  #}
		 ENDIF	
	#}
	ENDIF
	#--------------------End dtd validation#
	
	CUST.DEBITALL.narr = CUST.DEBITALL.desc
