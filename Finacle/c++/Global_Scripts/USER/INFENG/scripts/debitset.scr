	sv_e = "PurchaseIncome"
	sv_r = urhk_MTTS_definePartTran(sv_e)
	PRINT(sv_r)
	
	#------------------------------------------------------------------
	# Debit From BR
	#------------------------------------------------------------------
		
        sv_s = "ACCT_CRNCY_CODE |SELECT ACCT_CRNCY_CODE "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DEBITALL.drAccount

	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.DEBITALL.currency = BANCS.OUTPARAM.ACCT_CRNCY_CODE
		PRINT(CUST.DEBITALL.currency)
		#}
		endif
	MTT.PartTranDetails.Account = CUST.DEBITALL.drAccount
	MTT.PartTranDetails.RefCurrency = CUST.DEBITALL.currency
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.DEBITALL.narr
	sv_a = CDOUBLE(CUST.DEBITALL.amount )
	sv_a = -(sv_a)
	PRINT(sv_a)
	MTT.PartTranDetails.RefAmount = sv_a
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = CUST.DEBITALL.drAccount
	
	
	sv_r = urhk_MTTS_definePartTran(sv_h)
	IF (sv_r == 1) THEN
	#{
		PRINT("Unable to create MTT Part transaction")
		GOTO Finish
	#}
	ENDIF
	
	#############################
