            #{
              CUST.DEBITALL.Response ="No Credit account set for the FDR account/or it's closed."
              GOTO Finish
            #}
            ENDIF
           
              CUST.DEBITALL.crAccount=BANCS.OUTPARAM.CRaccount
              PRINT(CUST.DEBITALL.crAccount)
                  
       ELSE
             BANCS.INPUT.moduleName = "DEBITALL"
             BANCS.INPUT.parameterId = "ACCT_CR"
             CALL ("getcparamvalue.scr")
                IF (BANCS.OUTPUT.parameterVal != "") THEN
                #{
                   CUST.DEBITALL.crAccount = BANCS.OUTPUT.parameterVal
                    PRINT(CUST.DEBITALL.crAccount)
               ELSE
                    CUST.DEBITALL.errMsg = "Credit  Account setup not done CPARAM"
                    GOTO ENDOFSCRIPT
                #}
                ENDIF
       #}
       ENDIF
	#----------------------End Term deposit validation#

	BANCS.INPUT.moduleName = "DEBITALL"
	BANCS.INPUT.parameterId = "DEBITALL_DESC"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DEBITALL.desc = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DEBITALL.desc = ""
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
