	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.DEBITALL.amount = BANCS.OUTPARAM.clearBalance
		PRINT(CUST.DEBITALL.amount)
		#}
		
	#}
	ELSE
		#{
		CUST.DEBITALL.amount = "0"
