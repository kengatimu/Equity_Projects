        else
        #{
                LAREC.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                LAREC.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                LAREC.GLBDATA.srvSucFail = "F"
