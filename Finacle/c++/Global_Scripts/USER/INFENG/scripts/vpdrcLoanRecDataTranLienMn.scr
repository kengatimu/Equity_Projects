        print(BANCS.OUTPARAM.envValue)
        LAREC.GLBDATA.machineId = BANCS.OUTPARAM.envValue
        sv_r = repexists("MTT")
        if(sv_r == 0)then
                createrep("MTT")
        endif
        sv_r = classexists("MTT","TranDetails")
        if(sv_r == 0)then
                createclass("MTT","TranDetails",5)
        endif
        MTT.TranDetails.TranDate="0"
        MTT.TranDetails.TranType = "T"
        MTT.TranDetails.TranSubType = "BI"
        MTT.TranDetails.IgnoreExcp = "I"
        MTT.TranDetails.Consolidate = "Y"
        MTT.TranDetails.Remarks = "OD Loan Recovery"
        MTT.TranDetails.ValidationFlag = "Y"
        MTT.TranDetails.PostTranFlg = "Y"
        MTT.TranDetails.CheckExceptions = "Y"
        MTT.TranDetails.PostFlag        = "Y"
        MTT.TranDetails.CommitFlg       = "Y"
        MTT.TranDetails.PrintAdviceInd  = "B"
        MTT.TranDetails.ModuleId        = "HTM"
        sv_u = urhk_MTTS_DefineTransaction("ODLoanRec")
        print(sv_u)
        if(sv_u != 0 ) then
                LAREC.GLBDATA.srvErrMsg = MTT.Error.Description
                LAREC.GLBDATA.srvErrCode = "MTT"
                LAREC.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
	lv_q = " shdlNum,flowId,odAcid,opAcid,dmdAmt,totAdjAmt,outstandAmt,dmdDate | select a.shdl_num,a.flow_id,a.od_acid,a.op_acid,a.dmd_amt,a.tot_adj_amt,a.dmd_amt-a.tot_adj_amt as outstandAmt,to_char(a.dmd_date,'DD-MM-YYYY') " 
	lv_q = lv_q + " from custom.odla_dmd_tbl a where a.bank_id=?SVAR "
	###lv_q = lv_q + " and a.od_acid=?SVAR and a.op_acid=?SVAR "
        lv_q = lv_q + " and a.op_sol_id in (select sol_id from tbaadm.sst where bank_id=?SVAR "
        lv_q = lv_q + " and entity_cre_flg='Y' and del_flg='N' and set_id=?SVAR) "
        lv_q = lv_q + " and not exists(select 1 from tbaadm.ta_cot where acid=a.od_acid and entity_cre_flg='Y' "
	lv_q = lv_q + " and del_flg='N' and chrge_off_principal-principal_recovery >0 and chrge_off_date is not null) "
	lv_q = lv_q + " and a.entity_cre_flg='Y' and a.del_flg='N' and a.dmd_amt-a.tot_adj_amt >0 "
	lv_q = lv_q + " and a.dmd_date<=to_date(?SVAR,'DD-MM-YYYY') "
	###BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + LAREC.GLBDATA.odAcid + "|" + LAREC.GLBDATA.opAcid + "|" + left$(BANCS.STDIN.BODDate,10)  		
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + left$(BANCS.STDIN.BODDate,10)  		
	print(lv_q)
	print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(lv_q)
        if(sv_u==0)then
        #{
                LAREC.GLBDATA.olarecCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
