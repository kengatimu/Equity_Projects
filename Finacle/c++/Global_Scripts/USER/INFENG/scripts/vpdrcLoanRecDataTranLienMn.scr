#val after lief lift
		print(LAREC.GLBDATA.opEffBal)
		print(LAREC.GLBDATA.outstandAmt)
#Operative Account With Dr Balance after lien lift ,get multi source payment
		if(cdouble(LAREC.GLBDATA.opEffBal)<=0)then
		#{
                        lv_m = " mcifId,mdrAcctId,mdrAmt|select cif_id,foracid,clr_bal_amt from tbaadm.gam where bank_id=?SVAR "
                        lv_m = lv_m + " and acct_ownership<>'O' and cif_id =?SVAR and acid<>?SVAR "
                        lv_m = lv_m + " and schm_type in ('SBA','CAA') and acct_crncy_code=?SVAR "
                        lv_m = lv_m + " and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg<>'Y' "
                        lv_m = lv_m + " and acct_cls_date is null and clr_bal_Amt >=1 and frez_code <>'D' "
                        lv_m = lv_m + " and mode_of_oper_code='SELF' "
                        lv_m = lv_m + " and schm_code not in ('SB102','SB103','SB114','SB121','SB122','SB123','SB124','SB133','SB150','VA300','SB113','SB101') "
                        ##lv_m = lv_m + " and lien_amt<=0 "
                        lv_m = lv_m + " and rownum<=1 order by cif_id,clr_bal_amt desc "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + LAREC.GLBDATA.opCifId +  "|" + LAREC.GLBDATA.opAcid + "|" + LAREC.GLBDATA.odCrncyCode 
                        print(lv_m)
                        print(BANCS.INPARAM.BINDVARS)
                        lv_s = urhk_dbSelectWithBind(lv_m)
                        if(lv_s==0)then
                        #{
                                LAREC.GLBDATA.mcifId = BANCS.OUTPARAM.mcifId
                                LAREC.GLBDATA.mdrAcctId = BANCS.OUTPARAM.mdrAcctId
                                LAREC.GLBDATA.mdrAmt = BANCS.OUTPARAM.mdrAmt
				LAREC.GLBDATA.isMultiSPay = "Y"
