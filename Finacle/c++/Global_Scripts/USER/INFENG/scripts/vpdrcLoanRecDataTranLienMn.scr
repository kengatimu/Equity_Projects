			LAREC.GLBDATA.opCifId = BANCS.OUTPARAM.cifId
                        print(BANCS.OUTPARAM.SystemReservedAmt)
                #}
                else
                #{
                        LAREC.GLBDATA.opdrawingPower = 0
                        LAREC.GLBDATA.opEffBal = 0
                        LAREC.GLBDATA.opclearBalance = 0
                        LAREC.GLBDATA.opsanLim = 0
                        LAREC.GLBDATA.opavalAmt = 0
                        LAREC.GLBDATA.oplienamt = 0
                        LAREC.GLBDATA.opCrncyCode = ""
			LAREC.GLBDATA.opCifId = ""
                #}
                endif
		if(cdouble(LAREC.GLBDATA.odclearBalance)>=0)then
		#{
			goto NXTREC
		#}
		endif
#org Oper Lien Lift
		if(cdouble(LAREC.GLBDATA.oplienamt) != cdouble("0"))then
		#{
                        sv_s = "amount1,acid,b2kid|select trim (lien_amt),acid,b2k_id from tbaadm.alt  where b2k_id in (select trim(max(b2k_id)) from tbaadm.alt where acid =?SVAR "
                        sv_s = sv_s + " and b2k_type = 'ULIEN' and lien_reason_code='ODLA' and b2k_id is not null and bank_id =?SVAR) and b2k_type = 'ULIEN' "
                        sv_s = sv_s + " and lien_reason_code='ODLA' and b2k_id is not null and acid =?SVAR and bank_id =?SVAR "
                        BANCS.INPARAM.BINDVARS = LAREC.GLBDATA.opAcid + "|" + BANCS.STDIN.contextBankId + "|" + LAREC.GLBDATA.opAcid + "|" + BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)
                        print(sv_s)
                        sv_d = urhk_dbSelectWithBind(sv_s)
                        print(sv_d)
                        if(sv_d == 0)then
                        #{
                                LAREC.GLBDATA.amount1 = BANCS.OUTPARAM.amount1
                                LAREC.GLBDATA.acid = BANCS.OUTPARAM.acid
                                LAREC.GLBDATA.b2kid = BANCS.OUTPARAM.b2kid
