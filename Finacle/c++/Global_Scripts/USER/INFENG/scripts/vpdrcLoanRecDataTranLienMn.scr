                                LAREC.GLBDATA.amount1 = "0"
                                LAREC.GLBDATA.acid = ""
                                LAREC.GLBDATA.b2kid = ""
                                LAREC.GLBDATA.Lib2kid = ""
				LAREC.GLBDATA.orgLienAmt = "0"
                        #}
                        endif
                        if(LAREC.GLBDATA.b2kid!="")then
                        #{
				print(LAREC.GLBDATA.amount1)
                                BANCS.INPARAM.b2kId = LAREC.GLBDATA.b2kid
                                BANCS.INPARAM.acctNum = LAREC.GLBDATA.opAcctId
