##vpdrcLoanRecDataTranLienMn.scr
<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("LAREC")==0)then
        #{
                createrep("LAREC")
        #}
        endif
        if(classexists("LAREC","GLBDATA")==0)then
        #{
                createclass("LAREC","GLBDATA",5)
