                        LAREC.GLBDATA.odclearBalance = 0
                        LAREC.GLBDATA.odsanLim = 0
                        LAREC.GLBDATA.odavalAmt = 0
                        LAREC.GLBDATA.odlienamt = 0
                        LAREC.GLBDATA.odCrncyCode = ""
                #}
                endif
                sv_u = urhk_getAcctDetailsInRepository(LAREC.GLBDATA.opAcctId)
                if(sv_u == 0)then
                #{
                        LAREC.GLBDATA.opEffBal = BANCS.OUTPARAM.EffAvailableAmt
                        LAREC.GLBDATA.opclearBalance = BANCS.OUTPARAM.clearBalance
                        LAREC.GLBDATA.opsanLim = BANCS.OUTPARAM.sanctionLimit
