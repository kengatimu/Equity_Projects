	sv_s = sv_s + " TRAN_PARTICULARS,TRAN_RMKS,TRAN_ID,APP_CATEGORY,FREETEXT1,"
	sv_s = sv_s + " FREETEXT2,FREETEXT3,FREETEXT4,FREETEXT5,FREETEXT6,FREETEXT7,"
