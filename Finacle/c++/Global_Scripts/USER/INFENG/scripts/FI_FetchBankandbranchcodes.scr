#------------------------------------------------------------------------------------------------
#  Name            : FI_FetchBranchCity.scr
#  Description     : Fetch branch city for standing order
#  Date            : 11-05-2022
#  Author          : James Maina
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             11-05-2022      James Maina		Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "CSEG")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "CSEG", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)	


	IF( (FIELDEXISTS(("BANCS").("INPUT").("CITYCODE"))== 0) ) THEN
	#{
   		CUST.CSEG.errMsg="please enter CITYCODE"
		sv_t = "ERROR | " +CUST.CSEG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.CSEG.CITYCODE= BANCS.INPUT.CITYCODE
	print(CUST.CSEG.CITYCODE)

   

	sv_s="BANKCODE, BRANCHCODE,BRANCHNAME|"
	sv_s=sv_s + "SELECT BCT.bank_code,BCT.br_code,decode('INFENG','',NVL(BCT.ALT1_br_name,BCT.br_name),BCT.br_name) FROM TBAADM.BCT"
	sv_s=sv_s + " WHERE 1 = 1 AND BCT.br_city_code =?SVAR AND bank_id = ?SVAR ORDER BY BCT.bank_code,BCT.br_code"
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.CSEG.CITYCODE + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_v = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_v)	

	IF(sv_v == 0) THEN
       	 #{
        	CUST.CSEG.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       		print(CUST.CSEG.CURSOR_NUMBER)
       		sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
        	print(sv_b)
		IF(sv_b== "1")THEN
		#{
   			CUST.CSEG.errMsg="No records were fetched"
			sv_t = "MSG| " +CUST.CSEG.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF

		BANCS.INPUT.RECCOUNT = CINT("1")
        	print(BANCS.INPUT.RECCOUNT)

		sv_i=1
		print(sv_i)

		WHILE(sv_b == "0")
        	#{
			CUST.CSEG.BANKCODE= BANCS.OUTPARAM.BANKCODE
			print(CUST.CSEG.BANKCODE)

			CUST.CSEG.BRANCHCODE= BANCS.OUTPARAM.BRANCHCODE
			print(CUST.CSEG.BRANCHCODE)

			CUST.CSEG.BRANCHNAME= BANCS.OUTPARAM.BRANCHNAME
			print(CUST.CSEG.BRANCHNAME)


			sv_s="BANKCODE_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.BANKCODE
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BRANCHCODE_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.BRANCHCODE
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BRANCHNAME_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.BRANCHNAME
			sv_u = urhk_SetOrbOut(sv_s)



       			GOTO NEXTREC

      			BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
        		PRINT(BANCS.INPUT.RECCOUNT)

        		NEXTREC:
			sv_i = sv_i + 1 
       			sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
       			print(sv_b)
		#}
		DO
	
	#}
	ENDIF
ENDOFSCRIPT:
END-->

