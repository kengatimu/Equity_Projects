<--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
	
	####################################################################	
	#EmployeeName
	####################################################################

	sv_p = STRLEN(CUST.INTERFACE.EmployeeName)
	PRINT(sv_p)
	IF (sv_p > 40 ) THEN
		CUST.INTERFACE.VAL_STATUS = "F"
		PRINT("EmployeeName lenght cannot be greater than 40 char")
		sv_a = "UserAdd_Val.Status_EmployeeName|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.ErrorMessage_EmployeeName|EmployeeName cannot be greater than 40 characters"
		sv_u = urhk_SetOrbOut(sv_b)
		#EXITSCRIPT
	ENDIF

	####################################################################	
	#EmpShortName
	####################################################################

	sv_p = STRLEN(CUST.INTERFACE.EmpShortName)
	PRINT(sv_p)
	IF (sv_p > 10 ) THEN
		CUST.INTERFACE.VAL_STATUS = "F"
		PRINT("EmpShortName lenght cannot be greater than 10 char")
		sv_a = "UserAdd_Val.Status_EmpShortName|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.ErrorMessage_EmpShortName|EmpShortName cannot be greater than 10 characters"
		sv_u = urhk_SetOrbOut(sv_b)
		#EXITSCRIPT
	ENDIF
	
	
	####################################################################	
	#EmpIntls
	####################################################################

	sv_p = STRLEN(CUST.INTERFACE.EmpIntls)
	PRINT(sv_p)
	IF (sv_p > 5 ) THEN
		CUST.INTERFACE.VAL_STATUS = "F"
		PRINT("EmpIntls lenght cannot be greater than 5 char")
		sv_a = "UserAdd_Val.Status_EmpIntls|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.ErrorMessage_EmpIntls|EmpIntls cannot be greater than 5 characters"
		sv_u = urhk_SetOrbOut(sv_b)
