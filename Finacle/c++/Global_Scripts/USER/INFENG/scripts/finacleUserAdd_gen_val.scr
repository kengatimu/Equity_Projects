	ENDIF

	####################################################################	
	#SolID
	####################################################################
	sv_s = "c_solId|SELECT COUNT(1) FROM TBAADM.SOL WHERE SOL_ID = ?SVAR AND BANK_ID = ?SVAR AND DEL_FLG = 'N'"
	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.SolID + "|" + CUST.INTERFACE.homeBankId  
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d == 0)THEN
	#{
		CUST.INTERFACE.c_solId = BANCS.OUTPARAM.c_solId
		IF(CUST.INTERFACE.c_solId == "0")THEN
		#{
			PRINT("Invalid SolId")
			CUST.INTERFACE.VAL_STATUS = "F"
			sv_a = "UserAdd_Val.Status_SolId|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.ErrorMessage_SolId|"+CUST.INTERFACE.SolID+ " Invalid SolId"
			sv_u = urhk_SetOrbOut(sv_b)
			#EXITSCRIPT
			
		#}
		ENDIF
	#}
	ELSE
	#{
		PRINT("SolID validation could not be processed ")
		CUST.INTERFACE.VAL_STATUS = "F"
		sv_a = "UserAdd_Val.Status_SolId|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.ErrorMessage_SolId|"+"SolID validation could not be processed"
		sv_u = urhk_SetOrbOut(sv_b)
		#EXITSCRIPT
	#}
	ENDIF
	

	####################################################################	
	#EmailID
	####################################################################

	sv_s = "c_emailId|SELECT 'VALID' FROM DUAL WHERE REGEXP_LIKE (?SVAR,'^[A-Za-z]+[A-Za-z0-9.]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$')"
	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.EmailID
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d == 0)THEN
	#{
		CUST.INTERFACE.c_emailId = BANCS.OUTPARAM.c_emailId
		IF(CUST.INTERFACE.c_emailId != "VALID")THEN
		#{
			PRINT("Invalid EmailId")
			CUST.INTERFACE.VAL_STATUS = "F"
			sv_a = "UserAdd_Val.Status_EmailID|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.ErrorMessage_EmailID|"+CUST.INTERFACE.EmailID+ " Invalid EmailId"
			sv_u = urhk_SetOrbOut(sv_b)
			#EXITSCRIPT
			
		#}
		ENDIF
	#}
