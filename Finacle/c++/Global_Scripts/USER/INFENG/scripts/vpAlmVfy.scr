<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
	if(fieldexists(EQSRV.GLBDATA.laoAcid)==1)then
		print(EQSRV.GLBDATA.laoAcid)
	else
		exitscript
	endif
	EQSRV.GLBDATA.rownum = "" 
	EQSRV.GLBDATA.b2kid = ""
	EQSRV.GLBDATA.lien_amt = ""
	EQSRV.GLBDATA.lien_rmks1 = ""
	EQSRV.GLBDATA.lienRsnCode = "ODLA"
	lv_s ="rownum,acid,b2kid,lien_amt,lien_rmks1,lnRsnCode1,lnCrncyCode|select rownum,acid,b2k_id,lien_amt,lien_remarks,lien_reason_code,alt_crncy_code"
	lv_s = lv_s + " from tbaadm.alt "
	lv_s = lv_s + " where bank_id = ?SVAR " 
	lv_s = lv_s + " and acid = ?SVAR " 
	lv_s = lv_s + " and b2k_type ='LOANS'"	
	lv_s = lv_s + " and entity_cre_flg='Y' and del_flg='N' "
	print(lv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|" + EQSRV.GLBDATA.laoAcid
	lv_u = urhk_dbCursorOpenWithBind(lv_s)
	print(lv_u)
	if(lv_u == 0)then
	#{
		lv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		lv_r = urhk_dbCursorFetch(lv_m)
		while(lv_r == 0)
		#{
			if(lv_r == 0)then
			#{
				EQSRV.GLBDATA.recno = BANCS.OUTPARAM.rownum
				EQSRV.GLBDATA.laoAcid = BANCS.OUTPARAM.acid
				EQSRV.GLBDATA.b2kid = BANCS.OUTPARAM.b2kid
				EQSRV.GLBDATA.lien_amt = BANCS.OUTPARAM.lien_amt
				EQSRV.GLBDATA.lien_rmks1 = BANCS.OUTPARAM.lien_rmks1
				EQSRV.GLBDATA.lnRsnCode1 = BANCS.OUTPARAM.lnRsnCode1
				EQSRV.GLBDATA.lnCrncyCode = BANCS.OUTPARAM.lnCrncyCode
				print(EQSRV.GLBDATA.recno)
				EQSRV.GLBDATA.recno = CINT(EQSRV.GLBDATA.recno) - 1
				if(EQSRV.GLBDATA.recno == "")then
					EQSRV.GLBDATA.recno = "0"	
				endif				
				print(EQSRV.GLBDATA.recno)
				print(EQSRV.GLBDATA.laoAcid)
				print(EQSRV.GLBDATA.b2kid)
				print(EQSRV.GLBDATA.lien_amt)
				print(EQSRV.GLBDATA.lien_rmks1)
				print(EQSRV.GLBDATA.lnRsnCode1)
				print(EQSRV.GLBDATA.lnCrncyCode)
				lv_q = urhk_B2k_AcidToForacid(EQSRV.GLBDATA.laoAcid)
				if(lv_q==0)then
					EQSRV.GLBDATA.opAcctNum = BANCS.OUTPARAM.Foracid 
				else
					EQSRV.GLBDATA.opAcctNum = ""
				endif
				lv_q = urhk_B2k_AcidToForacid(EQSRV.GLBDATA.b2kid)
				if(lv_q==0)then
					EQSRV.GLBDATA.AcctNum = BANCS.OUTPARAM.Foracid 
				else
					EQSRV.GLBDATA.AcctNum = ""
				endif
				lv_t = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + EQSRV.GLBDATA.opAcctNum )
				lv_t = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|LOANS")
				lv_t = urhk_SetUrhkInp("acctLienMaintCrit.moduleId|" + EQSRV.GLBDATA.AcctNum ) 
				lv_t = urhk_SetUrhkOut("lienMaintLL|lienMaintLLCnt")
				lv_g = urhk_ExecSrv("SRV_FetchLienDtlsOnAcForMod|retain_all_output = Y")
				print(lv_g)
				if ( lv_g != 0) then
				#{
					EQSRV.GLBDATA.lnstat ="N"
					lv_e = ""
					lv_c = BANCS.OUTPARAM.Error_num
					print(lv_c)
					if (lv_c > 0) then
					#{
						lv_d = 1
						while(lv_d <= lv_c)
						#{
							lv_f = FORMAT$(lv_d, "%d")
							lv_e = ("BANCS").("OUTPARAM").("ErrorMesg_" + lv_f)
							print(lv_e)
							BANCS.OUTPUT.ErrorMesg = lv_e
							lv_n = ("BANCS").("OUTPARAM").("ErrorCode_" + lv_f)
							print(lv_n)
							BANCS.OUTPUT.ErrorCode = lv_n 
							lv_n = ("BANCS").("OUTPARAM").("Tag_" + lv_f)
							print(lv_n)
							lv_c = lv_n + "|" + lv_e
							print(lv_c)
							EQSRV.GLBDATA.responsecode = lv_n 
							EQSRV.GLBDATA.response = lv_e
							lv_d = lv_d + 1
						#}
						do
					

					#}
					endif

				#}
				else
				#{

					EQSRV.GLBDATA.newlienamt = "0"  
					EQSRV.GLBDATA.oldlienamt = EQSRV.GLBDATA.lien_amt 
					print(EQSRV.GLBDATA.newlienamt)
					print(EQSRV.GLBDATA.oldlienamt)
					print(EQSRV.GLBDATA.lnCrncyCode)
					print(BANCS.OUTPARAM.lienMaintLLCnt)

					lv_z = urhk_CopyOutToIn("")
					print(lv_z)
					lv_t = urhk_setUrhkInp("acctLienMaintCrit.acctNum.foracid|" + EQSRV.GLBDATA.opAcctNum ) 
					lv_t = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|LOANS")
					lv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.key.serial_num|1")
					lv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.acid|" + EQSRV.GLBDATA.laoAcid)
					lv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.b2kId|" + EQSRV.GLBDATA.b2kid)
					lv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.oldLienAmt|" + EQSRV.GLBDATA.oldlienamt + "|" + EQSRV.GLBDATA.lnCrncyCode )
					lv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.newLienAmt|"+ EQSRV.GLBDATA.newlienamt + "|" + EQSRV.GLBDATA.lnCrncyCode)
					lv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.lienReasonCode.refCode|"+EQSRV.GLBDATA.lienRsnCode)
					#sv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.effFromDate|" + LEFT$(BANCS.STDIN.BODDate,10))
					#sv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.lienRemarks|"+EQSRV.GLBDATA.lienParticls)
					#sv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.expiryDate|31-12-2099")
					lv_t = urhk_SetUrhkInp("lienMaintLL.<rec_"+EQSRV.GLBDATA.recno+">.delFlg|Y")
					lv_t = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output=Y|ignore_excp_flg=I")
					print(lv_t)

					if(lv_t != 0)then
					#{
						EQSRV.GLBDATA.lnstat ="N"
						lv_e = ""
						lv_c = BANCS.OUTPARAM.Error_num
						print(lv_c)

						if(lv_c > 0)then
						#{
							lv_d = 1
							while(lv_d <= lv_c)
							#{
								lv_f = FORMAT$(lv_d, "%d")
								lv_e = ("BANCS").("OUTPARAM").("ErrorMesg_" + lv_f)
								print(lv_e)
								BANCS.OUTPUT.ErrorMesg = lv_e
								lv_n = ("BANCS").("OUTPARAM").("ErrorCode_" + lv_f)
								print(lv_n)
								BANCS.OUTPUT.ErrorCode = lv_n 
								lv_n = ("BANCS").("OUTPARAM").("Tag_" + lv_f)
								print(lv_n)
								lv_c = lv_n + "|" + lv_e
								print(lv_c)
								EQSRV.GLBDATA.responsecode = lv_n 
								EQSRV.GLBDATA.response = lv_e
								lv_d = lv_d + 1
							#}
							do
						#}
						endif
					else
						print("lien lifted")
					#}
					endif
					#}
					endif
				#}
				endif
			lv_r = urhk_dbCursorFetch(lv_m)	
		#}
		do
		lv_y = urhk_dbCursorClose(lv_m)
	#}
	endif
##trace off
end-->