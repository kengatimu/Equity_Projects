	#}
	ENDIF
	ONS.CUSTOM.custDataOut = "~milgspschdet1|" + CUST.CMILGSP.wthTaxPcnt + "|" + CUST.CMILGSP.bacid + "|" + CUST.CMILGSP.wthTaxAppFlg
	print(ONS.CUSTOM.custDataOut)
	ENDOFSCRIPT:
