	#}
	ENDIF
	
	
	BANCS.INPARAM.BINDVARS=CUST.CMILGSP.schmType+"|"+CUST.CMILGSP.schmCode+"|MILGSP|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "wthTaxAppFlg,wthTaxPcnt,bacid,delFlg,entityCreFlg|"
	sv_s = sv_s + " SELECT WTH_TAX_APP_FLG,WTH_TAX_PCNT,BACID,DEL_FLG,ENTITY_CRE_FLG"
	sv_s = sv_s + " FROM CUSTOM.C_WTH_GSP_DET"
	sv_s = sv_s + " WHERE SCHM_TYPE =?SVAR"
	sv_s = sv_s + " AND SCHM_CODE =?SVAR"
	sv_s = sv_s + " AND MOP_ID =?SVAR"
	sv_s = sv_s + " AND BANK_ID =?SVAR"
	PRINT(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.CMILGSP.wthTaxAppFlg = BANCS.OUTPARAM.wthTaxAppFlg
		PRINT(CUST.CMILGSP.wthTaxAppFlg)
		CUST.CMILGSP.wthTaxPcnt = BANCS.OUTPARAM.wthTaxPcnt
		PRINT(CUST.CMILGSP.wthTaxPcnt)
		CUST.CMILGSP.bacid = BANCS.OUTPARAM.bacid
		PRINT(CUST.CMILGSP.bacid)
		
		CUST.CMILGSP.delFlg = BANCS.OUTPARAM.delFlg
		PRINT(CUST.CMILGSP.delFlg)
		CUST.CMILGSP.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		PRINT(CUST.CMILGSP.entityCreFlg)
		#}
	ELSE
		#{
		CUST.CMILGSP.errorFlg = "Y"
