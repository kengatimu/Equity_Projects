<--start
trace on
        if(repexists("DIGIT")==0)then
        #{
                createrep("DIGIT")
        #}
        endif
        if(classexists("DIGIT","GLBDATA")==0)then
        #{
                createclass("DIGIT","GLBDATA",5)
        #}
        endif

        DIGIT.GLBDATA.srvErrMsg = ""
        DIGIT.GLBDATA.srvErrCode = ""
        DIGIT.GLBDATA.srvSucFail = ""
	DIGIT.GLBDATA.tranMode = ""
	DIGIT.GLBDATA.digitOdAcid = ""
	if(fieldexists(BANCS.STDIN.moduleIdentity)==1)then
	#{
		if(BANCS.STDIN.moduleIdentity=="FI")then
			DIGIT.GLBDATA.tranMode = "FI"
			if(fieldexists(EBSRV.GLBDATA.digitOdAcid)==1)then
				print(EBSRV.GLBDATA.digitOdAcid)
				DIGIT.GLBDATA.digitOdAcid = EBSRV.GLBDATA.digitOdAcid
			else
				exitscript
			endif
			if(fieldexists(EBSRV.GLBDATA.odsolid)==1)then
				print(EBSRV.GLBDATA.odsolid)
				DIGIT.GLBDATA.odSolId = EBSRV.GLBDATA.odsolid
				BANCS.STDIN.mySolId = EBSRV.GLBDATA.odsolid
			else
				print(BANCS.STDIN.mySolId)				
			endif
		endif
	#}
	endif

	if(fieldexists(BANCS.STDIN.menuId)==1)then
	#{
		if(BANCS.STDIN.menuId=="CODLPAY")then
			DIGIT.GLBDATA.tranMode = "ONS"
			if(fieldexists(EBSRV.GLBDATA.digitOdAcid)==1)then
				print(EBSRV.GLBDATA.digitOdAcid)
				DIGIT.GLBDATA.digitOdAcid = EBSRV.GLBDATA.digitOdAcid
			else
				exitscript
			endif
			if(fieldexists(EBSRV.GLBDATA.odsolid)==1)then
				print(EBSRV.GLBDATA.odsolid)
				DIGIT.GLBDATA.odSolId = EBSRV.GLBDATA.odsolid
				BANCS.STDIN.mySolId = EBSRV.GLBDATA.odsolid
			else
				print(BANCS.STDIN.mySolId)			
			endif
		endif
	#}
	endif



	lv_b = urhk_B2K_PrintRepos("BANCS")
	print(lv_b)
	sv_r = REPEXISTS("MTT")
	print(sv_r)
	IF (sv_r == 1) THEN
		sv_r = urhk_MTTS_Close("")
		print(sv_r)
	ENDIF
        BANCS.INPARAM.PostTranFlg               = "Y"
        BANCS.INPARAM.CommitFlg                 = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg   = "N"
        BANCS.INPARAM.proxyPostFlg              = "P"
        BANCS.INPARAM.ValidationFlag            = "N"
        BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw          = "Y"
        BANCS.INPARAM.CheckExceptions           = "N"
        sv_u = urhk_MTTS_Initialize("")
        print(sv_u)
        if(sv_u != 0 )then
        #{
                DIGIT.GLBDATA.srvErrMsg = MTT.Error.Description
                DIGIT.GLBDATA.srvErrCode = "MTT"
                DIGIT.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif

        DIGIT.GLBDATA.machineId = ""
        sv_u = urhk_getEnv("HOST_NAME")
        print(BANCS.OUTPARAM.envValue)
        DIGIT.GLBDATA.machineId = BANCS.OUTPARAM.envValue

        sv_r = repexists("MTT")
        if(sv_r == 0)then
                createrep("MTT")
        endif
        sv_r = classexists("MTT","TranDetails")
        if(sv_r == 0)then
                createclass("MTT","TranDetails",5)
        endif

        MTT.TranDetails.TranDate        = "0"
        MTT.TranDetails.TranType        = "T"
        MTT.TranDetails.TranSubType     = "IC"
        MTT.TranDetails.IgnoreExcp      = "I"
        MTT.TranDetails.Consolidate     = "N"
        MTT.TranDetails.Remarks         = "SME Interest Calculation"
        MTT.TranDetails.ValidationFlag  = "Y"
        MTT.TranDetails.PostTranFlg     = "Y"
        MTT.TranDetails.CheckExceptions = "Y"
        MTT.TranDetails.PostFlag        = "Y"
        MTT.TranDetails.CommitFlg       = "Y"
        MTT.TranDetails.PrintAdviceInd  = "B"
        MTT.TranDetails.ModuledDisbAmtId= "HTM"
        sv_u = urhk_MTTS_DefineTransaction("DL002Int")
        print(sv_u)
        if(sv_u != 0 ) then
                DIGIT.GLBDATA.srvErrMsg = MTT.Error.Description
                DIGIT.GLBDATA.srvErrCode = "MTT"
                DIGIT.GLBDATA.srvSucFail = "F"
		sv_r = urhk_MTTS_Close("")
        	print(sv_r)
                goto Endofscript
        endif

	
	lv_j = " plBacid,intCollbacid | select int_pandl_bacid_dr,int_coll_bacid from tbaadm.gsp where bank_id=?SVAR and schm_code=?SVAR and del_flg='N'  and schm_type='ODA' and int_coll_flg='Y' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|OD552"
	print(lv_j)
	print(BANCS.INPARAM.BINDVARS)
	lv_j = urhk_dbSelectWithBind(lv_j)
	if(lv_j==0)then
	#{
		DIGIT.GLBDATA.plBacid = BANCS.OUTPARAM.plBacid
		DIGIT.GLBDATA.intCollbacid = BANCS.OUTPARAM.intCollbacid
	else
		DIGIT.GLBDATA.plBacid = ""
		DIGIT.GLBDATA.intCollbacid = ""	 
	#}
	endif
	if(DIGIT.GLBDATA.plBacid!="")then
	#{
		DIGIT.GLBDATA.IntCrGLBacid = DIGIT.GLBDATA.plBacid
	#}
	else
	#{
		DIGIT.GLBDATA.IntCrGLBacid = "ODINT42"
	#}
	endif
        sv_t = DIGIT.GLBDATA.IntCrGLBacid +"|"+ BANCS.STDIN.homeCrncyCode +"|"+ BANCS.STDIN.mySolId
        print(sv_t)
        sv_u = urhk_B2k_BacidToAcctId(sv_t)
        if(sv_u == 0 )then
        #{
                DIGIT.GLBDATA.IntCrGlAcctId = BANCS.OUTPARAM.AcctId
                print(DIGIT.GLBDATA.IntCrGlAcctId)
        #}
        else
        #{
                DIGIT.GLBDATA.IntCrGlAcctId = ""
        #}
        endif
	if(DIGIT.GLBDATA.IntCrGlAcctId!="")then
	#{
		lv_d = urhk_getAcctDetailsInRepository(DIGIT.GLBDATA.IntCrGlAcctId)
		if(lv_d==0)then
		#{
			DIGIT.GLBDATA.schemeType = BANCS.OUTPARAM.schemeType
