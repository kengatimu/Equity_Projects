		endif
	#}
	else
	#{
	
                sv_r = urhk_MTTS_Close("")
                print(sv_r)	
		exitscript
	#}
	endif
	if(DIGIT.GLBDATA.digitOdAcid!="")then
	lv_q = " dDisbSrlNum,dShdlNum,dFlowId,dOdAcid,dOpAcid,dDmdDate,dDmdAmt,dRcreTime,dDisbTranDate,dDisbAmt |  select dmd.disb_srl_num,dmd.shdl_num,dmd.flow_id,dmd.od_acid,"
	lv_q = lv_q + " dmd.op_acid,to_char(dmd.dmd_date,'DD-MM-YYYY'),dmd.dmd_amt,dmd.rcre_time,(select to_char(od_disb_tran_date,'DD-MM-YYYY') from custom.dlla_disb_tbl where bank_id=?SVAR and od_acid=dmd.od_acid "
	lv_q = lv_q + " and disb_srl_num=dmd.disb_srl_num)as disbtrandate,(select od_disb_amt from custom.dlla_disb_tbl where bank_id=?SVAR and od_acid=dmd.od_acid and disb_srl_num=dmd.disb_srl_num)as disbtrandate "
	lv_q = lv_q + " from custom.dlla_dmd_tbl dmd,tbaadm.gam gam where dmd.bank_id=?SVAR and gam.bank_id=?SVAR and dmd.od_acid=?SVAR and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acid=dmd.od_acid and "
	lv_q = lv_q + " gam.acct_cls_flg='N' and gam.acct_cls_date is null and dmd.entity_cre_flg='Y' and dmd.del_flg='N' and dmd.flow_id='INDEM' and dmd.dmd_amt <>0 and dmd.free_text_5 is null "
	##lv_q = lv_q + " and dmd.dmd_date<=to_date(?SVAR,'DD-MM-RRRR') "
	lv_q = lv_q + " and dmd.op_sol_id in (select sol_id from tbaadm.sst where bank_id=?SVAR and set_id=?SVAR) "
	##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + DIGIT.GLBDATA.digitOdAcid + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId  
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + DIGIT.GLBDATA.digitOdAcid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId  

	else
	lv_q = " dDisbSrlNum,dShdlNum,dFlowId,dOdAcid,dOpAcid,dDmdDate,dDmdAmt,dRcreTime,dDisbTranDate,dDisbAmt |  select dmd.disb_srl_num,dmd.shdl_num,dmd.flow_id,dmd.od_acid,dmd.op_acid,to_char(dmd.dmd_date,'DD-MM-YYYY'), "
	lv_q = lv_q + " dmd.dmd_amt,dmd.rcre_time,(select to_char(od_disb_tran_date,'DD-MM-YYYY') from custom.dlla_disb_tbl where bank_id=?SVAR and od_acid=dmd.od_acid and disb_srl_num=dmd.disb_srl_num)as disbtrandate, "
	lv_q = lv_q + " (select od_disb_amt from custom.dlla_disb_tbl where bank_id=?SVAR and od_acid=dmd.od_acid and disb_srl_num=dmd.disb_srl_num)as disbtrandate from custom.dlla_dmd_tbl dmd,tbaadm.gam gam where "
	lv_q = lv_q + " dmd.bank_id=?SVAR and gam.bank_id=?SVAR and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acid=dmd.od_acid and gam.acct_cls_flg='N' and gam.acct_cls_date is null and dmd.entity_cre_flg='Y' "
	lv_q = lv_q + " and dmd.del_flg='N' and dmd.flow_id='INDEM' and dmd.dmd_amt <>0 and dmd.free_text_5 is null and dmd.dmd_date<=to_date(?SVAR,'DD-MM-RRRR') and dmd.op_sol_id in (select sol_id from tbaadm.sst where "
	lv_q = lv_q + " bank_id=?SVAR and set_id=?SVAR) "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId  
	endif
	print(lv_q)
	print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(lv_q)
        if(sv_u==0)then
        #{
                DIGIT.GLBDATA.schdlcurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        #}
        else
        #{
                DIGIT.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                DIGIT.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                DIGIT.GLBDATA.srvSucFail = "F"
                sv_r = urhk_MTTS_Close("")
                print(sv_r)
                goto Endofscript
        #}
        endif
        DIGIT.GLBDATA.ddaRec = 0
        sv_z = urhk_dbCursorFetch(DIGIT.GLBDATA.schdlcurNum)
        if(sv_z!=0)then
        #{
                DIGIT.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                DIGIT.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                DIGIT.GLBDATA.srvSucFail = "F"
                sv_r = urhk_MTTS_Close("")
                print(sv_r)
                goto Endofscript
        #}
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
                DIGIT.GLBDATA.dDisbSrlNum = BANCS.OUTPARAM.dDisbSrlNum
                DIGIT.GLBDATA.dShdlNum = BANCS.OUTPARAM.dShdlNum
                DIGIT.GLBDATA.dFlowId = BANCS.OUTPARAM.dFlowId
                DIGIT.GLBDATA.dOdAcid = BANCS.OUTPARAM.dOdAcid
                DIGIT.GLBDATA.dOpAcid = BANCS.OUTPARAM.dOpAcid
                DIGIT.GLBDATA.dDmdDate = BANCS.OUTPARAM.dDmdDate
                DIGIT.GLBDATA.dDmdAmt = BANCS.OUTPARAM.dDmdAmt
                DIGIT.GLBDATA.dRcreTime = BANCS.OUTPARAM.dRcreTime
                DIGIT.GLBDATA.dDisbTranDate = BANCS.OUTPARAM.dDisbTranDate
                DIGIT.GLBDATA.dDisbAmt = BANCS.OUTPARAM.dDisbAmt


                print(DIGIT.GLBDATA.dDisbSrlNum)
                print(DIGIT.GLBDATA.dShdlNum)
                print(DIGIT.GLBDATA.dFlowId)
                print(DIGIT.GLBDATA.dOdAcid)
                print(DIGIT.GLBDATA.dOpAcid)
                print(DIGIT.GLBDATA.dDmdDate)
                print(DIGIT.GLBDATA.dDmdAmt)
                print(DIGIT.GLBDATA.dRcreTime)
                print(DIGIT.GLBDATA.dDisbTranDate)
                print(DIGIT.GLBDATA.dDisbAmt)


                sv_a= urhk_B2k_AcidToForacid(DIGIT.GLBDATA.dOdAcid)
                if(sv_a==0)then
                #{
                        DIGIT.GLBDATA.drAcctId = BANCS.OUTPARAM.Foracid
                        DIGIT.GLBDATA.LidrAcctId = DIGIT.GLBDATA.drAcctId
                #}
                else
                #{
                        DIGIT.GLBDATA.drAcctId = ""
                        DIGIT.GLBDATA.LidrAcctId = ""
                #}
		endif
		print(DIGIT.GLBDATA.drAcctId)
                        #Creation of Debit Tran
                        MTT.PartTranDetails.Account             = DIGIT.GLBDATA.drAcctId
                        MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode
                        MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode
                        MTT.PartTranDetails.Particulars         = "Int.Coll " + DIGIT.GLBDATA.dDisbTranDate + " to " + DIGIT.GLBDATA.dDmdDate + "for " + DIGIT.GLBDATA.drAcctId
                        MTT.PartTranDetails.RefAmount           = -1*cdouble(DIGIT.GLBDATA.dDmdAmt)
                        MTT.PartTranDetails.Amount              = -1*cdouble(DIGIT.GLBDATA.dDmdAmt)
                        MTT.PartTranDetails.Refnum              = "Disb.No" +DIGIT.GLBDATA.dDisbSrlNum + "/ShdlNum." + DIGIT.GLBDATA.dShdlNum
                        MTT.PartTranDetails.RateCode            = ""
                        MTT.PartTranDetails.Rate                = ""
                        MTT.PartTranDetails.TranIdentifier      = "DL002Int"
                        MTT.PartTranDetails.Consolidate         = "N"
                        MTT.PartTranDetails.CarveAmtFlg         = "Y"
                        MTT.PartTranDetails.ReportCode          = "OD552"
                        MTT.PartTranDetails.ValueDateDiff       = "0"
                        MTT.PartTranDetails.Remarks             = DIGIT.GLBDATA.IntCrGlAcctId
                        MTT.PartTranDetails.PstFlg              = "Y"
			MTT.PartTranDetails.TODRefType          = "IC"
			MTT.PartTranDetails.TodEntityType       = "TODIC"
			MTT.PartTranDetails.TodEntityId         = DIGIT.GLBDATA.drAcctId 
