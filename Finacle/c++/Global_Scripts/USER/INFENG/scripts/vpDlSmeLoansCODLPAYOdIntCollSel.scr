			##MTT.PartTranDetails.TodPermittedBy      = "SYSTEM"
			MTT.PartTranDetails.TodPermittedBy      = BANCS.STDIN.userId
			MTT.PartTranDetails.TodRemarks          = "OD552 Int.Coll TOD"
                        sv_r = urhk_MTTS_DefinePartTran("DL002IntDr")
                        print(sv_r)
                        if(sv_r!=0)then
                                print("define debit fail")
                        else
                                print("define debit success")
                        endif
                        #Creation of Credit Tran
                        MTT.PartTranDetails.Account             = DIGIT.GLBDATA.IntCrGlAcctId
                        MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode
                        MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode
                        MTT.PartTranDetails.Particulars         = "Int.Coll " + DIGIT.GLBDATA.dDisbTranDate + " to " + DIGIT.GLBDATA.dDmdDate + "for " + DIGIT.GLBDATA.drAcctId
                        MTT.PartTranDetails.RefAmount           = 1*cdouble(DIGIT.GLBDATA.dDmdAmt)
                        MTT.PartTranDetails.Amount              = 1*cdouble(DIGIT.GLBDATA.dDmdAmt)
                        MTT.PartTranDetails.Refnum              = "Disb.No" +DIGIT.GLBDATA.dDisbSrlNum + "/ShdlNum." + DIGIT.GLBDATA.dShdlNum
                        MTT.PartTranDetails.RateCode            = ""
                        MTT.PartTranDetails.Rate                = ""
                        MTT.PartTranDetails.TranIdentifier      = "DL002Int"
                        MTT.PartTranDetails.Consolidate         = "N"
                        MTT.PartTranDetails.CarveAmtFlg         = "Y"
                        MTT.PartTranDetails.ReportCode          = "OD552"
                        MTT.PartTranDetails.ValueDateDiff       = "0"
                        MTT.PartTranDetails.Remarks             = DIGIT.GLBDATA.drAcctId
                        MTT.PartTranDetails.PstFlg              = "Y"
			if(DIGIT.GLBDATA.partitionedFlg=="Y")then
                        MTT.PartTranDetails.ACPARTB2kId         = DIGIT.GLBDATA.drAcctId
                        ##MTT.PartTranDetails.EntryUserId         = "SYSTEM"
			MTT.PartTranDetails.EntryUserId      = BANCS.STDIN.userId
                        MTT.PartTranDetails.EntryTime           = BANCS.STDIN.BODDate
                        ##MTT.PartTranDetails.ACPARTB2kType       = "ACCNT"
                        MTT.PartTranDetails.ACPARTB2kType       = DIGIT.GLBDATA.partitionedType 
			endif
                        sv_r = urhk_MTTS_DefinePartTran("DL002IntCr")
                        print(sv_r)
                        if(sv_r!=0)then
                                print("define debit fail")
                        else
                                print("define debit success")
                        endif
                #End Tran with TranId
                                sv_u = urhk_MTTS_EndDefinition("")
                                print(sv_u)
                                if (sv_u != 0) then
                                        sv_r = urhk_MTTS_ReportErrorCondition("")
                                        print (MTT.Error.Description)
                                        DIGIT.GLBDATA.srvErrMsg = MTT.Error.Description
                                        DIGIT.GLBDATA.srvErrCode = "MTT"
                                        DIGIT.GLBDATA.srvSucFail = "F"
                                        goto NXTREC
                                        DIGIT.GLBDATA.TranId = ""
                                else
                                        DIGIT.GLBDATA.TranId = BANCS.OUTPARAM.MTTTranId
                                        print(DIGIT.GLBDATA.TranId)
                                endif

                                print(MTT.XCPN.NumExceptions)
                                print(MTT.XCPN.NumWarnings)
                                if((MTT.XCPN.NumExceptions >= 1) or (MTT.XCPN.NumWarnings >= 1)) then
                                #{
                                        sv_u = urhk_MTTS_HandleExceptions("POST")
                                        if (sv_u != 0) then
                                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                                print (MTT.Error.Description)
                                                DIGIT.GLBDATA.srvErrMsg = MTT.Error.Description
                                                DIGIT.GLBDATA.srvErrCode = "MTT"
                                                DIGIT.GLBDATA.srvSucFail = "F"
                                                goto NXTREC
                                        endif
                                else
                                        sv_u = urhk_MTTS_HandleExceptions("POST")
                                        if (sv_u != 0) then
                                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                                print (MTT.Error.Description)
                                                DIGIT.GLBDATA.srvErrMsg = MTT.Error.Description
                                                DIGIT.GLBDATA.srvErrCode = "MTT"
                                                DIGIT.GLBDATA.srvSucFail = "F"
                                                goto NXTREC
                                        endif
                                #}
                                endif
                        if(DIGIT.GLBDATA.TranId!="")then
                        #{
				print(DIGIT.GLBDATA.TranId)
				if((DIGIT.GLBDATA.tranMode=="FI") OR (DIGIT.GLBDATA.tranMode=="ONS"))then
				#{
					lv_o = "tranId|select tran_id from tbaadm.dtd where bank_id=?SVAR and acid=?SVAR and pstd_flg='N' and del_flg='N' and rownum=1"
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + DIGIT.GLBDATA.dOdAcid 
					print(BANCS.INPARAM.BINDVARS)
					print(lv_o)
					lv_s = urhk_dbSelectWithBind(lv_o)
					if(lv_s == 0)then
					#{
