ENDIF
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DENOM.pType + "|" + CUST.DENOM.crncy + "|" + CUST.DENOM.denomInd + "|" + CUST.DENOM.denomVal + "|" + CUST.DENOM.tellerId + "|" + CUST.DENOM.tranDate + "|" + CUST.DENOM.tranDate + "|" + CUST.DENOM.serialno + "|" + CUST.DENOM.authMatrixId + "|" + CUST.DENOM.userId + "|" + CUST.DENOM.userId + "|" + CUST.DENOM.bank_id
		print(BANCS.INPARAM.BINDVARS)
		
		sv_m = "INSERT INTO c_detd (sol_id,dxfer_id,dxfer_flg,ptran_type,crncy_code,denom_ind,denom_value,"
