<--START
TRACE ON

IF (FIELDEXISTS(CUST.DENOM.tranDate) == 0) THEN
#{
	CUST.DENOM.tranDate = LEFT$(BANCS.STDIN.BODDate, 10)
	PRINT(CUST.DENOM.tranDate)
#}
ENDIF
IF (CUST.DENOM.tranDate == "") THEN
#{
	CUST.DENOM.tranDate = LEFT$(BANCS.STDIN.BODDate, 10)
	PRINT(CUST.DENOM.tranDate)
#}
ENDIF
IF (FIELDEXISTS(CUST.DENOM.authMatrixId) == 0) THEN
#{
	CUST.DENOM.authMatrixId = ""
#}
ENDIF
CUST.DENOM.ERRORMESSAGE = ""
print(CUST.DENOM.ERRORMESSAGE)
CUST.DENOM.bank_id = BANCS.STDIN.contextBankId
print(CUST.DENOM.bank_id)



IF ((BANCS.STDIN.menuId == "CIETXN"))THEN
#{
	PRINT(CUST.CIETXN.contextBankId)
	IF(FIELDEXISTS(CUST.CIETXN.contextBankId))THEN
	#{
		CUST.DENOM.bank_id = CUST.CIETXN.contextBankId
		PRINT(CUST.DENOM.bank_id)
	#}
	ENDIF
	
	IF(FIELDEXISTS(CUST.CIETXN.contextBankId))THEN
	#{
		CUST.DENOM.solId = CUST.CIETXN.mySolId
		PRINT(CUST.DENOM.solId)
	#}
	ENDIF
		
#}
ENDIF


IF ((BANCS.STDIN.menuId == "CUBP"))THEN
#{
	PRINT(CUST.UBP.bankId)
	IF(FIELDEXISTS(CUST.UBP.bankId))THEN
	#{
		CUST.DENOM.bank_id = CUST.UBP.bankId
		PRINT(CUST.DENOM.bank_id)
	#}
	ENDIF

	IF(FIELDEXISTS(CUST.UBP.bankId))THEN
	#{
		CUST.DENOM.solId = CUST.UBP.mySolId
		PRINT(CUST.DENOM.solId)
	#}
	ENDIF

#}
ENDIF	



#--------------------------------------------------------------------------------
# Parsing Total denominations details
#-----------------------------------------------------------------------------------
sv_a = ("CUST").("DENOM").("coinDenomValue" + FORMAT$(sv_k, "%d"))
sv_b = ("CUST").("DENOM").("noteDenomValue" + FORMAT$(sv_k, "%d"))
PRINT(sv_a)
PRINT(sv_b)
CUST.DENOM.coinDenomVal = sv_a
CUST.DENOM.noteDenomVal = sv_b
CUST.DENOM.pType = ("CUST").("DENOM").("pType" + FORMAT$(sv_k, "%d"))
CUST.DENOM.crncy = MID$(("CUST").("DENOM").("currency" + FORMAT$(sv_k, "%d")), 0, 3)

sv_j = GETPOSITION(("CUST").("DENOM").("totDen" + FORMAT$(sv_k, "%d")), "D")
IF (sv_j == 0) THEN
#{
	sv_j = GETPOSITION(("CUST").("DENOM").("totDen" + FORMAT$(sv_k, "%d")), "C")
#}
ENDIF
PRINT(sv_j)
PRINT((("CUST").("DENOM").("totDen" + FORMAT$(sv_k, "%d"))))
sv_e = LEFT$(("CUST").("DENOM").("totDen" + FORMAT$(sv_k, "%d")), sv_j - 2)
PRINT(sv_e)
sv_c = sv_e
sv_e = RIGHT$(("CUST").("DENOM").("totDen" + FORMAT$(sv_k, "%d")), (STRLEN(("CUST").("DENOM").("totDen" + FORMAT$(sv_k, "%d"))) - (sv_j - 1)))
PRINT(sv_e)
CUST.DENOM.roundoff = sv_e
PRINT(CUST.DENOM.roundoff)

sv_x = 0
sv_y = 0
sv_q = 1
PRINT(sv_a)
PRINT(sv_b)
PRINT(sv_c)

sv_g = ("CUST").("DENOM").("totDenGB" + FORMAT$(sv_k, "%d"))
PRINT(sv_g)
sv_h = ("CUST").("DENOM").("totDenPB" + FORMAT$(sv_k, "%d"))
PRINT(sv_h)

sv_r = 1
sv_p = "C"
sv_d = ""
sv_j = ""
sv_v = ""
print(CUST.UBP.empId)
#CUST.DENOM.userId = BANCS.STDIN.userId

CUST.DENOM.userId = CUST.UBP.empId
print(CUST.DENOM.userId)

CUST.DENOM.tellerId =CUST.UBP.empIdgec
print(CUST.DENOM.tellerId)

WHILE(sv_r != 0)
#{
	sv_q = GETPOSITION(sv_a, "-")
	PRINT(sv_q)
	sv_r = GETPOSITION(sv_c, "!")
	PRINT(sv_r)
	IF (sv_q != 0) THEN
	#{
		sv_x = LEFT$(sv_a, (sv_q - 1))
	#}
	ELSE
	#{
		sv_x = sv_a
	#}
	ENDIF
	IF (sv_r != 0) THEN
	#{
		sv_y = LEFT$(sv_c, (sv_r - 1))
	#}
	ELSE
	#{
		sv_y = sv_c
	#}
	ENDIF
	PRINT(sv_x)
	PRINT(sv_y)
	PRINT(sv_k)
	PRINT(CUST.DENOM.crncy)
	PRINT(sv_a)
	PRINT(sv_c)
	PRINT(sv_p)
	CUST.DENOM.DENOMVALUE = sv_x
	print(CUST.DENOM.EVENT)
	IF (CINT(sv_y) > 0) THEN
	#{
		#-----------------------------------------------------------------
		# Updating C_DENM table
		#-----------------------------------------------------------------
		IF ((CUST.DENOM.EVENT == "P") OR (CUST.DENOM.EVENT == "X") OR (CUST.DENOM.EVENT == "DX")) THEN
		#{
			CUST.DENOM.denmTbl = "CUSTOM.C_DENM"
			# Bind variables added by Arathi for issue <234116>
			BANCS.INPARAM.BINDVARS = CUST.DENOM.pType + "|" + sv_y + "|" + sv_y
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.DENOMVALUE
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.pType
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + sv_y + "|" + sv_y
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			
			sv_l = "UPDATE CUSTOM.C_DENM "
			sv_l = sv_l + "SET denom_count=(DECODE(?SVAR ,'C',denom_count+?SVAR ,denom_count-?SVAR ))"
			sv_l = sv_l + ",lchg_time = sysdate, lchg_user_id = ?SVAR "
			sv_l = sv_l + "WHERE DENOM_VALUE = ?SVAR "
			sv_l = sv_l + "AND (DECODE(?SVAR,'C',denom_count+?SVAR ,denom_count-?SVAR )) >= 0 "
			sv_l = sv_l + "AND bank_id = ?SVAR "
		#}
		ELSE
		#{
			# Bind variables added by Arathi for issue <234116>
			BANCS.INPARAM.BINDVARS = sv_y + "|" + CUST.DENOM.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.DENOMVALUE
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + sv_y
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			IF (CUST.DENOM.pType == "C") THEN
			#{
				CUST.DENOM.denmTbl = "CUSTOM.C_DENM_CR"
				sv_l = "UPDATE CUSTOM.C_DENM_CR "
				sv_l = sv_l + "SET denom_count = denom_count +?SVAR "
				sv_l = sv_l + ",lchg_time = sysdate, lchg_user_id = ?SVAR "
				sv_l = sv_l + "WHERE DENOM_VALUE = ?SVAR "
				sv_l = sv_l + "AND (denom_count+?SVAR) >= 0 "
				sv_l = sv_l + "AND bank_id = ?SVAR "
			#}
			ELSE
			#{
				CUST.DENOM.denmTbl = "CUSTOM.C_DENM_DR"
				sv_l = "UPDATE CUSTOM.C_DENM_DR "
				sv_l = sv_l + "SET denom_count = denom_count + ?SVAR "
				sv_l = sv_l + ",lchg_time = sysdate, lchg_user_id = ?SVAR "
				sv_l = sv_l + "WHERE DENOM_VALUE = ?SVAR "
				sv_l = sv_l + "AND (denom_count+ ?SVAR) >= 0 "
				sv_l = sv_l + "AND bank_id = ?SVAR "
			#}
			ENDIF
		#}
		ENDIF
		# Bind variables added by Arathi for issue <234116>
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncy
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + sv_p
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.solId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.tellerId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_l = sv_l + " AND CRNCY_CODE = ?SVAR AND DENOM_IND = ?SVAR "
		sv_l = sv_l + " AND SOL_ID = ?SVAR AND teller_id = ?SVAR "
		PRINT(sv_l)
		#sv_s = urhk_DBSql(sv_l)
		sv_s = urhk_dbSQLWithBind(sv_l)
		PRINT(sv_s)
		PRINT(BANCS.OUTPARAM.DB_ERRCODE)
		IF (BANCS.OUTPARAM.DB_ERRCODE != 0) THEN
		#{
			print(CUST.DENOM.solId)
			print(CUST.DENOM.tellerId)
			print(CUST.DENOM.crncy)
			print(CUST.DENOM.DENOMVALUE)
			print(CUST.DENOM.userId)
			print(CUST.DENOM.pType)
			sv_o = "~"
			print(sv_o)
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.tellerId + "|" + CUST.DENOM.solId + "|" + CUST.DENOM.crncy + "|" + CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "DInd,DValue,DCount|SELECT a.denom_ind,a.denom_value, "
			sv_s = sv_s + "CONCAT(A.denom_count,CONCAT('" + sv_o + "',B.denom_count))  FROM C_DENM A, C_DENM_DR B "
			sv_s = sv_s + "WHERE A.crncy_code = B.crncy_code AND A.teller_id = ?SVAR "
			sv_s = sv_s + "AND A.sol_id = ?SVAR "
			sv_s = sv_s + "AND A.denom_value = B.denom_value "
			sv_s = sv_s + "AND A.denom_ind = B.denom_ind "
			sv_s = sv_s + "AND A.del_flg = 'N' AND A.crncy_code = ?SVAR "
			sv_s = sv_s + "AND A.sol_id = B.sol_id "
			sv_s = sv_s + "AND A.bank_id = B.bank_id "
			sv_s = sv_s + "AND A.bank_id = ?SVAR "
			sv_s = sv_s + "AND A.teller_id = B.teller_id "
			sv_s = sv_s + "ORDER BY A.Denom_Ind,A.Denom_Value DESC"
			PRINT(sv_s)
			sv_c = urhk_DBCursorOpenWithBind(sv_s)
			IF (sv_c != 0) THEN
			#{
				sv_u = urhk_setOrbOut("Message|F")
				sv_u = urhk_setOrbOut("Details|DataBase Error")
				GOTO FINISH
			#}
			ENDIF
			IF (sv_c == 0) THEN
			#{
				sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				PRINT(sv_m)
				sv_c = urhk_DBCursorFetch(sv_m)
				CUST.DENOM.NDenomVal = ""
				CUST.DENOM.CDenomVal = ""
				CUST.DENOM.NDenomCnt = ""
				CUST.DENOM.CDenomCnt = ""
				WHILE(sv_c == 0)
				#{
					IF (BANCS.OUTPARAM.DInd == "N") THEN
					#{
						CUST.DENOM.NDenomVal = CUST.DENOM.NDenomVal + "-" + BANCS.OUTPARAM.DValue
						CUST.DENOM.NDenomCnt = CUST.DENOM.NDenomCnt + "-" + BANCS.OUTPARAM.DCount
						PRINT(CUST.DENOM.NDenomVal)
						PRINT(CUST.DENOM.NDenomCnt)
					#}
					ELSE
					#{
						CUST.DENOM.CDenomVal = CUST.DENOM.CDenomVal + "-" + BANCS.OUTPARAM.DValue
						CUST.DENOM.CDenomCnt = CUST.DENOM.CDenomCnt + "-" + BANCS.OUTPARAM.DCount
						PRINT(CUST.DENOM.CDenomVal)
						PRINT(CUST.DENOM.CDenomCnt)
					#}
					ENDIF
					sv_c = urhk_DBCursorFetch(sv_m)
				#}
				DO
				sv_c = urhk_DBCursorClose(sv_m)
				IF (sv_c != 0) THEN
				#{
					sv_u = urhk_setOrbOut("Message|N")
					sv_u = urhk_setOrbOut("Details|DataBase Error")
					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
			
			CUST.DENOM.DENOM_LOG = CUST.DENOM.solId + "|" + CUST.DENOM.tellerId + "|" + CUST.DENOM.crncy + "|" + CUST.DENOM.DENOMVALUE + "|" + CUST.DENOM.userId + "|" + CUST.DENOM.pType + "|" + CUST.DENOM.NDenomVal + "|" + CUST.DENOM.NDenomCnt + "|" + CUST.DENOM.CDenomVal + "|" + CUST.DENOM.CDenomCnt
			print(CUST.DENOM.DENOM_LOG)
			
			sv_d = "echo '" + CUST.DENOM.DENOM_LOG + "'>> DENOM_LOG.txt"
			print(sv_d)
			sv_o = system(sv_d)
			print(sv_o)
			
			CUST.DENOM.ERRORMESSAGE = "Error: Please re-create the transaction"
			print(CUST.DENOM.ERRORMESSAGE)
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	#-------------------------------------------------------------------------
	# Parsing GB denominations
	#-------------------------------------------------------------------------
	PRINT(("CUST").("DENOM").("totDenGB" + FORMAT$(sv_k, "%d")))
	IF ((("CUST").("DENOM").("totDenGB" + FORMAT$(sv_k, "%d"))) != "") THEN
	#{
		sv_f = GETPOSITION(sv_g, "!")
		PRINT(sv_f)
		IF (sv_f == 0) THEN
		#{
			sv_y = sv_g
		#}
		ELSE
		#{
			sv_y = LEFT$(sv_g, (sv_f - 1))
		#}
		ENDIF
		PRINT(sv_y)
		IF (CINT(sv_y) > 0) THEN
		#{
			BANCS.INPARAM.BINDVARS = sv_y + "|" + CUST.DENOM.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.DENOMVALUE
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncy + "|" + sv_p
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.solId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.tellerId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			IF ((CUST.DENOM.EVENT == "P") OR (CUST.DENOM.EVENT == "X") OR (CUST.DENOM.EVENT == "DX")) THEN
			#{
				sv_l = "UPDATE C_DENM"
				sv_l = sv_l + " SET denom_count = denom_count + ?SVAR"
			#}
			ELSE
			#{
				sv_l = "UPDATE C_DENM_CR"
				sv_l = sv_l + " SET denom_count = denom_count + ?SVAR"
			#}
			ENDIF
			sv_l = sv_l + " ,lchg_time = sysdate, lchg_user_id = ?SVAR "
			sv_l = sv_l + "WHERE DENOM_VALUE = ?SVAR "
			sv_l = sv_l + "AND CRNCY_CODE = ?SVAR "
			sv_l = sv_l + "AND DENOM_IND = ?SVAR "
			sv_l = sv_l + "AND SOL_ID = ?SVAR "
			sv_l = sv_l + "AND teller_id = ?SVAR "
			sv_l = sv_l + "AND bank_id = ?SVAR "
			PRINT(sv_l)
			sv_s = urhk_DBSqlWithBind(sv_l)
			PRINT(sv_s)
		#}
		ENDIF
	#}
	ENDIF
	#-------------------------------------------------------------------------
	# Parsing PB denominations
	#-------------------------------------------------------------------------
	PRINT(("CUST").("DENOM").("totDenPB" + FORMAT$(sv_k, "%d")))
	IF (("CUST").("DENOM").("totDenPB" + FORMAT$(sv_k, "%d")) != "") THEN
	#{
		sv_w = GETPOSITION(sv_h, "!")
		PRINT(sv_w)
		IF (sv_w == 0) THEN
		#{
			sv_y = sv_h
		#}
		ELSE
		#{
			sv_y = LEFT$(sv_h, (sv_w - 1))
		#}
		ENDIF
		PRINT(sv_y)
		IF (CINT(sv_y) > 0) THEN
		#{
			BANCS.INPARAM.BINDVARS = sv_y + "|" + CUST.DENOM.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.DENOMVALUE
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncy + "|" + sv_p
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.solId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.tellerId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			IF ((CUST.DENOM.EVENT == "P") OR (CUST.DENOM.EVENT == "X") OR (CUST.DENOM.EVENT == "DX")) THEN
			#{
				sv_l = "UPDATE C_DENM"
				sv_l = sv_l + " SET denom_count = denom_count - ?SVAR"
			#}
			ELSE
			#{
				sv_l = "UPDATE C_DENM_DR"
				sv_l = sv_l + " SET denom_count = denom_count + ?SVAR"
			#}
			ENDIF
			sv_l = sv_l + " ,lchg_time = sysdate, lchg_user_id = ?SVAR "
			sv_l = sv_l + "WHERE DENOM_VALUE = ?SVAR "
			sv_l = sv_l + "AND CRNCY_CODE = ?SVAR "
			sv_l = sv_l + "AND DENOM_IND = ?SVAR "
			sv_l = sv_l + "AND SOL_ID = ?SVAR "
			sv_l = sv_l + "AND teller_id = ?SVAR "
			sv_l = sv_l + "AND bank_id = ?SVAR "
			PRINT(sv_l)
			sv_s = urhk_DBSqlWithBind(sv_l)
			PRINT(sv_s)
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	PRINT(sv_x)
	PRINT(sv_a)
	sv_a = RIGHT$(sv_a, (STRLEN(sv_a) - (sv_q)))
	PRINT(sv_a)
	PRINT(sv_q)
	IF (sv_r != 0) THEN
	#{
		sv_d = sv_d + LEFT$(sv_c, sv_r)
	#}
	ELSE
	#{
		sv_d = sv_d + sv_c
	#}
	ENDIF
	PRINT(sv_d)
	sv_c = RIGHT$(sv_c, (STRLEN(sv_c) - (sv_r)))
	PRINT(sv_c)
	IF ((("CUST").("DENOM").("totDenGB" + FORMAT$(sv_k, "%d"))) != "") THEN
	#{
		IF (sv_f != 0) THEN
		#{
			sv_j = sv_j + LEFT$(sv_g, sv_f)
		#}
		ELSE
		#{
			sv_j = sv_j + sv_g
		#}
		ENDIF
		PRINT(sv_j)
		sv_g = RIGHT$(sv_g, (STRLEN(sv_g) - (sv_f)))
		PRINT(sv_g)
	#}
	ENDIF
	IF (("CUST").("DENOM").("totDenPB" + FORMAT$(sv_k, "%d")) != "") THEN
	#{
		IF (sv_w != 0) THEN
		#{
			sv_v = sv_v + LEFT$(sv_h, sv_w)
		#}
		ELSE
		#{
			sv_v = sv_v + sv_h
		#}
		ENDIF
		PRINT(sv_v)
		sv_h = RIGHT$(sv_h, (STRLEN(sv_h) - (sv_w)))
		PRINT(sv_h)
	#}
	ENDIF
	IF (sv_q == 0) THEN
	#{
		PRINT(sv_d)
		#---- Insert into C_DETD ---------
		IF (sv_p == "C") THEN
		#{
			PRINT(sv_a)
			CUST.DENOM.denomVal = CUST.DENOM.coinDenomVal
			CUST.DENOM.denomInd = "C"
		#}
		ELSE
		#{
			PRINT(sv_b)
			CUST.DENOM.denomVal = CUST.DENOM.noteDenomVal
			CUST.DENOM.denomInd = "N"
		#}
		ENDIF
		PRINT(sv_d)
		PRINT(sv_j)
		PRINT(sv_v)
		IF (RIGHT$(sv_d, 1) == "!") THEN
		#{
			CUST.DENOM.denomCnt = LEFT$(sv_d, STRLEN(sv_d) - 1)
		#}
		ELSE
		#{
			CUST.DENOM.denomCnt = sv_d
		#}
		ENDIF
		IF (RIGHT$(sv_j, 1) == "!") THEN
		#{
			CUST.DENOM.denomCntGB = LEFT$(sv_j, STRLEN(sv_j) - 1)
		#}
		ELSE
		#{
			CUST.DENOM.denomCntGB = sv_j
		#}
		ENDIF
		IF (RIGHT$(sv_v, 1) == "!") THEN
		#{
			CUST.DENOM.denomCntPB = LEFT$(sv_v, STRLEN(sv_v) - 1)
		#}
		ELSE
		#{
			CUST.DENOM.denomCntPB = sv_v
		#}
		ENDIF
		PRINT(CUST.DENOM.pType)
		IF (FIELDEXISTS(CUST.DENOM.tranDate) == 1) THEN
		#{
			CUST.DENOM.tranDate = LEFT$(BANCS.STDIN.BODDate, 10)
			PRINT(CUST.DENOM.tranDate)
		#}
		ENDIF
		print(CUST.DENOM.tranDate)
		
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.solId + "|" + CUST.DENOM.tranId + "|"

