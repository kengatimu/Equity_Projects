#-------------------------------------------------------------------------------------------------------
# Source Name           :   oclgrptmn001.scr
# Date                  :   12-03-2013
# Author                :   Shishira
# Title                 :   OutwardClearingReport
# Description           :   Validates Input from COCLG menu and calles com
# Sources called        :   NA
# Sources called from   :   coclg.xml
# RS Approach Document  :
# Modification History  :
# <Serial No.>      <Date>          <Author Name>       <Description>
# 0.00a             12-03-2013     Shishira        Original version
# 0.01             12-06-2013     Shishira        Modified ZoneCode validation and simplified if condition
#-------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="e00b5762e567ffdbe16ae37835f09e4ffdc1ef2e3fe3ebf4a37217b3b8a0aa52"
	TRACE ON
	
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.setId=BANCS.INPUT.setId
	print(CUST.DATA.setId)
	CUST.DATA.zoneCode=BANCS.INPUT.zoneCode
	print(CUST.DATA.zoneCode)
	CUST.DATA.zoneDate=BANCS.INPUT.date_ui
	CUST.DATA.funcCode=BANCS.INPUT.funcCode
	
	#---------------------------------------
	#Fetching Zone Code CPARAM
	#---------------------------------------
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "OCLGRPT_ZONE1"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.pZoneCode1 =BANCS.OUTPUT.parameterVal
		print(CUST.DATA.pZoneCode1)
		#}
	ELSE
		#{
		CUST.DATA.pZoneCode1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "OCLGRPT_ZONE2"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.pZoneCode2 =BANCS.OUTPUT.parameterVal
		print(CUST.DATA.pZoneCode2)
		#}
	ELSE
		#{
		CUST.DATA.pZoneCode2 = ""
	#}
	ENDIF
	
	IF (BANCS.STDIN.contextBankId!="56") THEN
	#{
		BANCS.INPUT.parameterId = "OCLGRPT_ZONE3"
		CALL("getcparamvalue.scr")
		
		IF (BANCS.OUTPUT.parameterVal != "")THEN
		#{
			print(BANCS.OUTPUT.parameterVal)
			CUST.DATA.pZoneCode3 =BANCS.OUTPUT.parameterVal
			print(CUST.DATA.pZoneCode3)
			#}
		ELSE
			#{
			CUST.DATA.pZoneCode3 = ""
		#}
		ENDIF
		
	#}
	ENDIF
	#==================================================
	# Set Id validation
	#==================================================
	
	sv_s = "Count|SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.SST "
	sv_s = sv_s + " WHERE SST.set_id=?SVAR "
	sv_s = sv_s + " AND SST.del_flg ='N' "
	sv_s = sv_s + " AND SST.entity_cre_flg ='Y' "
	sv_s = sv_s + " AND SST.bank_id = ?SVAR "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.DATA.setId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d==0) THEN
	#{
		CUST.DATA.Count = BANCS.OUTPARAM.Count
		print(CUST.DATA.Count)
	#}
	ENDIF
	
	
	IF (CUST.DATA.Count==0) THEN
	#{
		print("Invalid Set Id")
		sv_e = "Invalid Set ID"
		sv_m = "setId"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	#======================================================
	#Zone Code validation---- Valid Zone
	#=======================================================
	
	sv_s = "count|SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.OZC, "
	sv_s = sv_s + " TBAADM.OZH "
	sv_s = sv_s + " WHERE OZC.clg_zone_code=?SVAR "
	sv_s = sv_s + " AND OZC.bank_id=?SVAR "
	sv_s = sv_s + " AND OZC.clg_zone_code=OZH.clg_zone_code "
	sv_s = sv_s + " AND OZH.bank_id=OZC.bank_id "
	sv_s = sv_s + " AND OZC.del_flg = 'N' "
	sv_s = sv_s + " AND OZH.del_flg = 'N' "
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.zoneCode + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d==0) THEN
	#{
		CUST.DATA.count= BANCS.OUTPARAM.count
		print(CUST.DATA.count)
	#}
	ENDIF
	
	IF (CUST.DATA.count==0) THEN
	#{
		print("Invalid Zone Code/Zone Not Open  ")
		sv_e = "Invalid Zone Code / Zone Not Open "
		sv_m = "zoneCode"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	#======================================================
	#Zone Code validation -- Record Found
	#=======================================================
	sv_s = "count|SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.OCI  "
	sv_s = sv_s + " WHERE sol_id in ( SELECT SST.sol_id "
	sv_s = sv_s + " FROM TBAADM.SST "
	sv_s = sv_s + " WHERE SST.set_id=?SVAR "
	sv_s = sv_s + " AND SST.del_flg ='N' "
	sv_s = sv_s + " AND SST.entity_cre_flg ='Y' "
	sv_s = sv_s + " AND SST.bank_id = ?SVAR) "
	sv_s = sv_s + " AND clg_zone_code=?SVAR "
	sv_s = sv_s + " AND bank_id=?SVAR "
	sv_s = sv_s + " AND OCI.del_flg = 'N' "
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.setId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.zoneCode + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d==0) THEN
	#{
		CUST.DATA.count= BANCS.OUTPARAM.count
		print(CUST.DATA.count)
	#}
	ENDIF
	
	IF (CUST.DATA.count==0) THEN
	#{
		print("No Record Found ")
		sv_e = "No Record Found "
		sv_m = "zoneCode"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	#--------------------------------------------------
	#Com selection
	#--------------------------------------------------
	print(CUST.DATA.funcCode)
	IF (CUST.DATA.funcCode=="OCLG") THEN
	#{
		IF ((BANCS.STDIN.contextBankId=="54") OR (BANCS.STDIN.contextBankId=="50") ) THEN
		#{
			CUST.DATA.com="oclgrptdp001.com"
			CUST.DATA.msg="oclgrptdp001.com does not exists"
			print("oclgrptdp001.com will be called")
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId=="56") THEN
		#{
			CUST.DATA.com="oclgrptdp002.com"
			CUST.DATA.msg="oclgrptdp002.com does not exists"
			print("oclgrptdp002.com will be called")
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId=="55") THEN
		#{
			CUST.DATA.com="oclgrptdp003.com"
			CUST.DATA.msg="oclgrptdp003.com does not exists"
			print("oclgrptdp003.com will be called")
			
			BANCS.INPUT.moduleName = "CLEARING"
			BANCS.INPUT.parameterId = "OCLGRPT_BRCD"
			CALL("getcparamvalue.scr")
			
			IF (BANCS.OUTPUT.parameterVal != "")THEN
			#{
				print(BANCS.OUTPUT.parameterVal)
				CUST.DATA.pBrCode=BANCS.OUTPUT.parameterVal
				print(CUST.DATA.pBrCode)
				#}
			ELSE
				#{
				CUST.DATA.pBrCode=""
			#}
			ENDIF
			
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId=="11") THEN
		#{
			CUST.DATA.com="oclgrptdp004.com"
			CUST.DATA.msg="oclgrptdp004.com does not exists"
			print("oclgrptdp004.com will be called")
		#}
		ENDIF
		#}
	ELSE
		#{
		IF ((BANCS.STDIN.contextBankId=="54") OR (BANCS.STDIN.contextBankId=="50")) THEN
		#{
			CUST.DATA.com="oclgrptdp005.com"
			CUST.DATA.msg="oclgrptdp005.com does not exists"
			print("oclgrptdp005.com will be called")
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId=="55") THEN
		#{
			CUST.DATA.com="oclgrptdp006.com"
			CUST.DATA.msg="oclgrptdp006.com does not exists"
			print("oclgrptdp006.com will be called")
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId=="56") THEN
		#{
			CUST.DATA.com="oclgrptdp002.com"
			CUST.DATA.msg="oclgrptdp002.com does not exists"
			print("oclgrptdp002.com will be called")
			CUST.DATA.funcCode="OCLG"
		#}
		ENDIF
	#}
	ENDIF
	
	#--------------------------------------------------
	#Fetching com file path
	#--------------------------------------------------
	sv_c = urhk_getFileLocation("COM|"+CUST.DATA.com)
	CUST.DATA.fileLocation = BANCS.OUTPARAM.fileLocation
	print(CUST.DATA.fileLocation)
	
	IF (sv_c != 0) THEN
	#{
		print(CUST.DATA.msg)
		sv_e = CUST.DATA.msg
		sv_m = "ERROR"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
	#}
	ENDIF
	
	print(CUST.DATA.funcCode)
	IF (CUST.DATA.funcCode=="OCLG") THEN
	#{
		IF ((BANCS.STDIN.contextBankId=="54") OR (BANCS.STDIN.contextBankId=="11") OR (BANCS.STDIN.contextBankId=="50")) THEN
		#{
			sv_s = CUST.DATA.fileLocation + CUST.DATA.com + " " + CUST.DATA.setId + " " + CUST.DATA.zoneDate + " " +"'" + CUST.DATA.zoneCode +"'" + " " + BANCS.STDIN.contextBankId + " " +"'"+ CUST.DATA.pZoneCode1 +"'" + " " +"'"+ CUST.DATA.pZoneCode2 +"'"+ " " +"'"+ CUST.DATA.pZoneCode3 +"'"
			print(sv_s)
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId=="55") THEN
		#{
			sv_s = CUST.DATA.fileLocation + CUST.DATA.com + " " + CUST.DATA.setId + " " + CUST.DATA.zoneDate + " " +"'" + CUST.DATA.zoneCode +"'" + " " + BANCS.STDIN.contextBankId + " " +"'"+ CUST.DATA.pZoneCode1 +"'" + " " +"'"+ CUST.DATA.pZoneCode2 +"'"+ " " +"'"+ CUST.DATA.pZoneCode3 +"'" + " " +"'"+ CUST.DATA.pBrCode +"'"
			print(sv_s)
		#}
		ENDIF
		
		IF (BANCS.STDIN.contextBankId=="56") THEN
		#{
			sv_s = CUST.DATA.fileLocation + CUST.DATA.com + " " + CUST.DATA.setId + " " + CUST.DATA.zoneDate + " " + "'" + CUST.DATA.zoneCode + "'" + " " + BANCS.STDIN.contextBankId + " " + "'" + CUST.DATA.pZoneCode1 + "'" + " " + "'" + CUST.DATA.pZoneCode2 + "'"
			print(sv_s)
		#}
		ENDIF
		#}
	ELSE
		#{
		#IF (CUST.DATA.funcCode=="OCLG2")
		#{
		sv_s = CUST.DATA.fileLocation + CUST.DATA.com + " " + CUST.DATA.setId + " " + CUST.DATA.zoneDate + " " + "'" + CUST.DATA.zoneCode + "'" + " " + BANCS.STDIN.contextBankId
		print(sv_s)
	#}
	ENDIF
	
	sv_n = SYSTEM(sv_s + " &" )
	print (sv_n)
	
	IF (sv_n == CINT("0")) THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Report Generated. To View/Print use HPR Menu."
		sv_z = urhk_SetOrbOut(sv_g)
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Report Could Not Be Generated"
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	FINISH:
		EXITSCRIPT
		TRACE OFF
END-->
