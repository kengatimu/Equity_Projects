<--START
CHECKSUM="78c603639edc12eb5e5b81dcd415fd3c49ee2a00a8b69d289aa863f0bc3e005b"
	TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
	#{
		CREATECLASS("CUST", "CHQB", 5)
	#}
	ENDIF
	#---------------------------------------------------------------------
	#  Validation For No. Of Cheque Books Required Field
	#  1) Only No. of cheque books between 1-99 is permitted.
	#---------------------------------------------------------------------
	IF (CUST.CHQB.function == "A") THEN
	#{
		IF (FIELDEXISTS(CUST.CHQB.no_of_chkbooks)) THEN
		#{
			IF (TRIM(CUST.CHQB.no_of_chkbooks) == "") THEN
			#{
				PRINT(CUST.CHQB.function)
				sv_e = "Please Enter No. Of Cheque Books Required between 1 - 99"
				sv_m = "noOfChqs"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.CHQB.succsflg = "N"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				IF ((CINT(CUST.CHQB.no_of_chkbooks) < 1) OR (CINT(CUST.CHQB.no_of_chkbooks) > 99 )) THEN
				#{
					PRINT(CUST.CHQB.function)
					CUST.CHQB.chqFlg = "Y"
					sv_e = "Please Enter Cheque book quantity between 1-99"
					sv_m = "noOfChqs"
					sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					CUST.CHQB.succsflg = "N"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	#---------------------------------------------------------------------
	# check if account no filed is blank.
	#---------------------------------------------------------------------
	IF (CUST.CHQB.function != "A") THEN
	#{
		IF (FIELDEXISTS(CUST.CHQB.account_no)) THEN
		#{
			IF (FIELDEXISTS(CUST.CHQB.request_id)) THEN
			#{
				IF (CUST.CHQB.request_id == "") THEN
				#{
					IF (TRIM(CUST.CHQB.account_no) == "") THEN
					#{
						sv_e = "Please Enter account no."
						sv_m = "funcode"
						sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						CUST.CHQB.succsflg = "N"
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						PRINT(CUST.CHQB.function)
						PRINT(CUST.CHQB.account_no)
						sv_s = "ValidateAccout|SELECT COUNT(*) FROM CUSTOM.C_BCHQ "
						sv_s = sv_s + "WHERE foracid = ?SVAR "
						#		sv_s = sv_s + " AND  schm_type in ('SBA','CAA','ODA') "
						#		sv_s = sv_s + " AND  entity_cre_flg = 'Y' "
						#		sv_s = sv_s + " AND  del_flg !='Y' "
						#		sv_s = sv_s + " AND  acct_cls_flg !='Y' "
						sv_s = sv_s + " AND bank_id = ?SVAR"
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.CHQB.account_no + "|" + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_u = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_u)
					#}
					ENDIF
					
					IF (sv_u != 0) THEN
					#{
						sv_e = "A Database error has occured. Please contact your DBA."
						sv_m = "funcode"
						sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						CUST.CHQB.succsflg = "N"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					IF (CINT(BANCS.OUTPARAM.ValidateAccout) <= 0) THEN
					#{
						CUST.CHQB.schmFlg = "Y"
						sv_e = "Incorrect Account No"
						sv_m = "funcode"
						sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						CUST.CHQB.succsflg = "N"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					sv_a = urhk_getAcctDetailsInRepository(CUST.CHQB.account_no)
					PRINT(sv_a)
					IF (sv_a == 0) THEN
					#{
						PRINT(BANCS.OUTPARAM.freezeCode)
						PRINT(BANCS.OUTPARAM.acctSolId)
						IF (BANCS.OUTPARAM.freezeCode != " ") THEN
						#{
							CUST.CHQB.frzFlg = "Y"
							sv_e = "Frozen Account ,Cheque Book request cannot be processed"
							sv_m = "acctNo"
							sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
							sv_u = urhk_SetOrbOut(sv_e)
							sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
							CUST.CHQB.succsflg = "N"
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	#---------------------------------------------------------------------
	# Check for the request ID.
	#---------------------------------------------------------------------
	IF (CUST.CHQB.function != "A") THEN
	#{
		IF (FIELDEXISTS(CUST.CHQB.request_id)) THEN
		#{
			PRINT(CUST.CHQB.function)
			PRINT(CUST.CHQB.request_id)
			IF (TRIM(CUST.CHQB.request_id) == "") THEN
			#{
				sv_e = "Please Enter Request ID"
				sv_m = "reqID"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.CHQB.succsflg = "N"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				PRINT(CUST.CHQB.function)
				#---------------------------------------------------------------------
				# If Entered choice is "I" or "D" or "V" then list only those Requests having the req status as "E".
				#---------------------------------------------------------------------
				IF ((CUST.CHQB.function == "D") OR (CUST.CHQB.function == "V")) THEN
				#{
					sv_s = "ValidateRequest|SELECT COUNT(*) FROM CUSTOM.C_BCHQ "
					sv_s = sv_s + " WHERE req_id = ?SVAR"
					sv_s = sv_s + " AND req_status = 'E'"
					sv_s = sv_s + " AND bank_id = ?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.CHQB.request_id  + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
				#}
				ENDIF
				#---------------------------------------------------------------------
				# If Entered choice is "I" then list all the requests.
				#---------------------------------------------------------------------
				IF (CUST.CHQB.function == "I") THEN
				#{
					sv_s = "ValidateRequest|SELECT  COUNT(*) FROM  CUSTOM.C_BCHQ "
					sv_s = sv_s + " WHERE req_id = ?SVAR "
					sv_s = sv_s + " AND bank_id = ?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.CHQB.request_id  + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
				#}
				ENDIF
				sv_u = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_u)
				IF (sv_u != 0) THEN
				#{
					sv_e = "A Database error has occured. Please contact your DBA."
					sv_m = "funcode"
					sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					CUST.CHQB.succsflg = "N"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				IF (CINT(BANCS.OUTPARAM.ValidateRequest) <= 0) THEN
				#{
					sv_e = "Invalid Request ID"
					sv_m = "requestId"
					sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					CUST.CHQB.succsflg = "N"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	CUST.CHQB.succsflg = "Y"
	ENDOFSCRIPT:
		
		#TRACE OFF
		EXITSCRIPT
END-->
