<--start
trace on
#--------------------------------------------------------------------------
# Executing the validation  for sol_id
#--------------------------------------------------------------------------

sv_a= urhk_B2k_printrepos("BANCS")
print(sv_a)

IF (FIELDEXISTS(BANCS.INPUT.dcco)) THEN
	print(BANCS.INPUT.dcco)
	IF (BANCS.INPUT.dcco!="") THEN
		IF (REPEXISTS("CUST") == 0 ) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF
		IF (CLASSEXISTS("CUST","HPPTDATA") == 0) THEN
		#{
			CREATECLASS("CUST","HPPTDATA",5)
		#}
		ENDIF

		CUST.HPPTDATA.sol_id=BANCS.INPUT.dcco
		print(CUST.HPPTDATA.sol_id)

		CUST.HPPTDATA.COUNT="0"
		print(CUST.HPPTDATA.COUNT)
		CUST.HPPTDATA.tran_particular="Proceed"
		print(CUST.HPPTDATA.tran_particular)

		##ISO Transactions- Check##
		sv_s = "COUNT,tran_particular| select count(1),'ISO Gls Transactions' as tran_particular from tbaadm.dtd where sol_id= ?SVAR  and  bank_id= ?SVAR and del_flg='N' and PSTD_FLG='N' and acid in (select acid from tbaadm.gam where bank_id= ?SVAR and bacid ='ISO') " 
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.HPPTDATA.sol_id + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u =  urhk_dbSelectWithBind(sv_s)
		print(sv_u)
		IF(sv_u == 0) THEN
			CUST.HPPTDATA.COUNT = BANCS.OUTPARAM.COUNT
			PRINT(CUST.HPPTDATA.COUNT)
                        CUST.HPPTDATA.tran_particular =  BANCS.OUTPARAM.tran_particular
			PRINT(CUST.HPPTDATA.tran_particular)
			IF (CUST.HPPTDATA.COUNT!=0) THEN
				CUST.HPPTDATA.tran_particular_error =  CUST.HPPTDATA.tran_particular
				print(CUST.HPPTDATA.tran_particular_error)
				#sv_z = urhk_SetOrbOut("output|"+ CUST.HPPTDATA.COUNT)
				#print(sv_z)
				#sv_z = urhk_SetOrbOut("output1|"+ CUST.HPPTDATA.tran_particular)
				#print(sv_z)
				#GOTO ENDOFSCRIPT
		       ELSE
			   CUST.HPPTDATA.COUNT="0"
			   CUST.HPPTDATA.tran_particular="Proceed"
	               ENDIF
			sv_z = urhk_SetOrbOut("output|"+ CUST.HPPTDATA.COUNT)
			print(sv_z)
			sv_z = urhk_SetOrbOut("output1|"+ CUST.HPPTDATA.tran_particular)
			print(sv_z)
		
		ENDIF
		
	ENDIF
ENDIF

ENDOFSCRIPT:

EXITSCRIPT
##trace off
end-->
