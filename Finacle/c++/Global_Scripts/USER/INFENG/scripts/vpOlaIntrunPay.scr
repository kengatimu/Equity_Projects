	lv_s = lv_s + " select gam.sol_id,gam.foracid,gam.acct_crncy_code,gam.acid,gam.schm_code,gam.clr_bal_amt,gam.sanct_lim,eit.NRML_ACCRUED_AMOUNT_DR,eit.NRML_BOOKED_AMOUNT_DR,eit.NRML_INTEREST_AMOUNT_DR,eit.INTEREST_CALC_UPTO_DATE_DR,gam.last_any_tran_date,eit.NEXT_INT_RUN_DATE_DR,gac.dpd_cntr,gac.free_text_2 as intialLoanTenure, "
	lv_s = lv_s + " (select max(tran_date) from tbaadm.dctd_acli where acid=gam.acid and tran_particular like '%Payoff%' ) as dtd_payoff_date "
	lv_s = lv_s + " from tbaadm.gam ,tbaadm.eit,tbaadm.gac "
	lv_s = lv_s + " where gam.bank_id=?SVAR "
	lv_s = lv_s + " and gam.acid=gac.acid "
