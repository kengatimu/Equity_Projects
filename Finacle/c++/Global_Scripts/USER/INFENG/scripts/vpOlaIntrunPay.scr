        lv_s = lv_s + " and eit.entity_id=gac.acid "
        lv_s = lv_s + " and gam.sol_id=?SVAR " 
        lv_s = lv_s + " and gam.schm_type='ODA' "
        lv_s = lv_s + " and gam.schm_code in ('OD542','OD543','OD544','OD545','OD546') "
        lv_s = lv_s + " and gam.clr_bal_amt>=0 "
        lv_s = lv_s + " and not exists(select 1 from tbaadm.ta_cot where acid=gam.acid "
        lv_s = lv_s + " and entity_cre_flg='Y' and del_flg='N' and chrge_off_principal-principal_recovery >0 and CHRGE_OFF_DATE is not null) "
        lv_s = lv_s + " and gam.entity_cre_flg='Y' "
        lv_s = lv_s + " and gam.del_flg='N' "
        lv_s = lv_s + " and gam.acct_cls_flg='N' "
