	lv_s = lv_s + " and ((to_char(eit.NRML_ACCRUED_AMOUNT_DR,9999999999999.99) <> eit.NRML_BOOKED_AMOUNT_DR) or "
	lv_s = lv_s + " (eit.NRML_BOOKED_AMOUNT_DR <> eit.NRML_INTEREST_AMOUNT_DR)) and gam.acct_cls_date is null " 
