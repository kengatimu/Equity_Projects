                        CUST.DATA.remarks_1  = "insufficient funds Currenct Balance :" + CUST.DATA.EffAvalBal

                #}
                ENDIF

                lv_t = lv_t + 1
                PRINT(lv_t)


                NEXTREC:

                IF(CUST.DATA.chrgcollected == "N")THEN
                #{
                #----------- Start Insert
                        CUST.DATA.VatAmt = FORMAT$(cdouble(CUST.DATA.VatAmt),"%.2f")
                        CUST.DATA.LaceCharge = FORMAT$(cdouble(CUST.DATA.LaceCharge),"%.2f")
