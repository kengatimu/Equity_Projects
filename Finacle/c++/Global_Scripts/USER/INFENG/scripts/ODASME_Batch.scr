                #}
                ELSE
                #{
                        print("Sufficient balance")
                        print(CUST.DATA.ClrAmt)
                        CUST.DATA.ClrAmt = (CDOUBLE(CUST.DATA.ClrAmt)+CDOUBLE(CUST.DATA.LaceCharge))
