                        sv_s = " insert into CUSTOM.C_DEFERRED_ODA_CHARGE (Dr_OD_Account,Del_flg,Excise_Duty_chrg,Lace_chrg,Uncollected_charge_amount,consumption_amount,rcre_date,collected_flg,remarks_1)"
