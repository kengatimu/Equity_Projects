                                PRINT(CUST.DATA.LaceCharge)
                ################################Charge Calculation End###################################################
                ###############################Exercise Duty Calculation start#################################################
                                CUST.DATA.Vatperct = "20"
                                PRINT(CUST.DATA.Vatperct)
                                PRINT(CUST.DATA.LaceCharge)
                                CUST.DATA.VatAmt = (CDOUBLE(CUST.DATA.Vatperct) * CDOUBLE(CUST.DATA.LaceCharge))/100
                                PRINT(CUST.DATA.VatAmt)
                ################################Exercise Duty Calculation End###################################################


                CUST.DATA.TotAmt = (CDOUBLE(CUST.DATA.VatAmt) + CDOUBLE(CUST.DATA.LaceCharge))
                CUST.DATA.ClrAmt=CDOUBLE(CUST.DATA.TotAmt) *-1
                print(CUST.DATA.ClrAmt)
                CUST.DATA.ClrAmt = FORMAT$(CDOUBLE(CUST.DATA.ClrAmt),"%.2f")
                print(CUST.DATA.ClrAmt)
                CUST.DATA.EffAvalBal = FORMAT$(CDOUBLE(sv_l),"%.2f")
