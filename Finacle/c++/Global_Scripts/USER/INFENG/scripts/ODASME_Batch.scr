                ENDIF

                ####################################Getting CPARAM Value Start#############################################

                CUST.DATA.parameterId="LACE_OD548"

                sv_s = "LaceCharge|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
