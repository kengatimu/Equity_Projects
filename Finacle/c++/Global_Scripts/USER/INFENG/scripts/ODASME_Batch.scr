                IF(sv_d == 0)THEN
                #{
                        CUST.DATA.LacePercent = BANCS.OUTPARAM.LaceCharge

                #}
                ENDIF


                ###############################Charge Calculation start#################################################

                                PRINT(CUST.DATA.LacePercent)
