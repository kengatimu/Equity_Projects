#-----------------------------------------------------------------------------------------------
# Name			: denomdp005.scr
# Date			: 20-JUN-2010
# Description		: This script performs ADD, MODIFY and DELETE Operation based on FuncCode
# Input			: FuncCode, Currency and Denomination Details from JSP
# Output		: Success or Error Message
# Author		: Castro / Sandeep Patil
# Calling JSP		: denomdp004.jsp
# Called JSP		: -
# Menu Option		: HDENOM
# Module Code		: DENOM
# Bank			: STANDARD BANK
#  Modification History	:
#	<Serial No.>	<Date>			<Author>		<Description>
#	0.1		20-JUN-2010		Sandeep Patil		Draft Version
#	0.2		24-JUN-2010		Harini P		Enabled for Audit
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="5e6f69b84a7db3b99b1516d29e27a234de8ee127e87207cec2099b4c1a63ae45"
	TRACE ON
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST", "DENOM")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	
	sv_u = urhk_b2k_PrintRepos("BANCS")
	PRINT(sv_u)
	
	CUST.DENOM.FuncCode = BANCS.INPUT.FuncCode
	CUST.DENOM.Currency = BANCS.INPUT.Currency
	CUST.DENOM.bank_id = BANCS.STDIN.contextBankId
	print(CUST.DENOM.bank_id)
	CUST.DENOM.Details = "Success"
	
	# Call to Set the inputs for Audit
	call("denomdp052.scr")
	
	#--------------------------------------------------------------------------------------
	#	PERFORM ADD OR MODIFY OPERATION
	#--------------------------------------------------------------------------------------
	PRINT(CUST.DENOM.FuncCode)
	IF ((CUST.DENOM.FuncCode == "A") OR (CUST.DENOM.FuncCode == "M")) THEN
	#{
		CUST.DENOM.delFlg = "N"
		IF (CUST.DENOM.FuncCode == "A") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "count|SELECT COUNT(*) "
			sv_s = sv_s + " FROM C_MDNM "
			sv_s = sv_s + "WHERE del_flg = 'Y' "
			sv_s = sv_s + "AND crncy_code = ?SVAR"
			sv_s = sv_s + "AND bank_id = ?SVAR"
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF (sv_d == 1) THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
				GOTO FINISH
			#}
			ENDIF
			IF (CINT(BANCS.OUTPARAM.count) > 0) THEN
			#{
				CUST.DENOM.delFlg1 = "Y"
			#}
			ENDIF
		#}
		ENDIF
		IF (CUST.DENOM.FuncCode == "M") THEN
		#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			sv_s = "RecreUser,RecreTime|SELECT rcre_User_Id, rcre_Time "
			sv_s = sv_s + " FROM C_MDNM "
			sv_s = sv_s + "WHERE crncy_code = ?SVAR"
			sv_s = sv_s + " AND ROWNUM<2 "
			sv_s = sv_s + "AND bank_id = ?SVAR "
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			CUST.DENOM.RecreUser = BANCS.OUTPARAM.RecreUser
			CUST.DENOM.RecreTime = BANCS.OUTPARAM.RecreTime
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "count|SELECT COUNT(*) "
			sv_s = sv_s + "FROM C_MDNM "
			sv_s = sv_s + "WHERE del_flg = 'N' "
			sv_s = sv_s + "AND crncy_code = ?SVAR "
			sv_s = sv_s + "AND bank_id = ?SVAR "
			PRINT(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF (sv_d == 1) THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		IF (CUST.DENOM.delFlg == "Y") THEN
		#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "DELETE FROM C_MDNM "
			sv_s = sv_s + "WHERE crncy_code = ?SVAR"
			sv_s = sv_s + "AND bank_id = ?SVAR "
			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 1) THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		#--------------------------------------------------------------------------------------
		#	Deleting the entires in C_MDNM tables
		#--------------------------------------------------------------------------------------
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
		print(BANCS.INPARAM.BINDVARS)
		
		sv_s = "DenomValue|SELECT DENOM_VALUE "
		sv_s = sv_s + "FROM C_MDNM "
		sv_s = sv_s + "WHERE crncy_code = ?SVAR "
		sv_s = sv_s + "AND denom_ind='N' "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		sv_s = sv_s + "ORDER BY Denom_Value DESC"
		PRINT(sv_s)
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		IF (sv_c != 0) THEN
		#{
			sv_u = urhk_setOrbOut("Message|N")
			sv_u = urhk_setOrbOut("Details|DataBase Error")
			GOTO FINISH
		#}
		ENDIF
		IF (sv_c == 0) THEN
		#{
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_m)
			sv_c = urhk_dbCursorFetch(sv_m)
			PRINT(sv_c)
			WHILE(sv_c == 0)
			#{
				CUST.DENOM.delFlg = "Y"
				CUST.DENOM.denomVal = BANCS.OUTPARAM.DenomValue
				PRINT(CUST.DENOM.denomVal)
				CUST.DENOM.LoopCounter1 = "1"
				WHILE(CINT(CUST.DENOM.LoopCounter1) != 15)
				#{
					sv_x = CUST.DENOM.LoopCounter1
					sv_n = ("BANCS").("INPUT").("NoteDenom" + sv_x)
					sv_f = ("BANCS").("INPUT").("CoinDenom" + sv_x)
					PRINT(sv_n)
					IF (sv_n != "") THEN
					#{
						IF (CUST.DENOM.denomVal == sv_n) THEN
						#{
							CUST.DENOM.delFlg = "N"
						#}
						ENDIF
					#}
					ENDIF
					CUST.DENOM.LoopCounter1 = CINT(sv_x) + 1
				#}
				DO
				IF (CUST.DENOM.delFlg == "Y") THEN
				#{
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency  + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					CUST.DENOM.delFlgDetd = "N"
					sv_s = "denomvalueCnt|SELECT COUNT(1) FROM C_DETD D"
					sv_s = sv_s + " WHERE dxfer_flg='E' "
					sv_s = sv_s + "AND crncy_code = ?SVAR "
					sv_s = sv_s + "AND (SELECT del_flg "
					sv_s = sv_s + "FROM dtd "
					sv_s = sv_s + "WHERE tran_id=D.dxfer_id "
					sv_s = sv_s + "AND tran_date=D.tran_date "
					sv_s = sv_s + "AND ROWNUM<2)!='Y' "
					sv_s = sv_s + "AND D.dxfer_flg!='P' AND bank_id = ?SVAR"
					PRINT(sv_s)
					sv_c = urhk_dbselectWithBind(sv_s)
					IF (sv_c != 0) THEN
					#{
						sv_u = urhk_setOrbOut("Message|N")
						sv_u = urhk_setOrbOut("Details|DataBase Error")
						sv_c = urhk_dbCursorClose(sv_m)
						GOTO FINISH
					#}
					ENDIF
					IF (sv_c == 0) THEN
					#{
						CUST.DENOM.denomvalueCnt = BANCS.OUTPARAM.denomvalueCnt
						PRINT(CUST.DENOM.denomvalueCnt)
						IF (CUST.DENOM.denomvalueCnt > 0) THEN
						#{
							sv_u = urhk_setOrbOut("Message|N")
							sv_u = urhk_setOrbOut("Details|Transactions are in entered state cannot delete denomination")
							sv_c = urhk_dbCursorClose(sv_m)
							GOTO FINISH
						#}
						ENDIF
					#}
					ENDIF
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.denomVal + "|" + CUST.DENOM.bank_id
					print(BANCS.INPARAM.BINDVARS)
					
					sv_s = "DELETE FROM C_MDNM "
					sv_s = sv_s + "WHERE crncy_code = ?SVAR "
					sv_s = sv_s + "AND denom_value= ?SVAR "
					sv_s = sv_s + "AND denom_ind='N' "
					sv_s = sv_s + "AND bank_id = ?SVAR "
					PRINT(sv_s)
					sv_d = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 1) THEN
					#{
						sv_u = urhk_setOrbOut("Message|N")
						sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
						sv_c = urhk_dbCursorClose(sv_m)
						GOTO FINISH
					#}
					ENDIF
				#}
				ENDIF
				sv_c = urhk_dbCursorFetch(sv_m)
			#}
			DO
			sv_c = urhk_dbCursorClose(sv_m)
			IF (sv_c != 0) THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				sv_u = urhk_setOrbOut("Details|DataBase Error")
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		#---------------------- DEletting Coin Denominations----------------------------
		BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
		print(BANCS.INPARAM.BINDVARS)
		
		sv_s = "DenomValue|SELECT DENOM_VALUE"
		sv_s = sv_s + " FROM C_MDNM "
		sv_s = sv_s + "WHERE crncy_code = ?SVAR "
		sv_s = sv_s + "AND denom_ind='C' "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		sv_s = sv_s + "ORDER BY Denom_Value DESC"
		PRINT(sv_s)
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		IF (sv_c != 0) THEN
		#{
			sv_u = urhk_setOrbOut("Message|N")
			sv_u = urhk_setOrbOut("Details|DataBase Error")
			GOTO FINISH
		#}
		ENDIF
		IF (sv_c == 0) THEN
		#{
			sv_k = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_k)
			sv_c = urhk_dbCursorFetch(sv_k)
			WHILE(sv_c == 0)
			#{
				CUST.DENOM.delFlg = "Y"
				CUST.DENOM.denomVal = BANCS.OUTPARAM.DenomValue
				PRINT(CUST.DENOM.denomVal)
				CUST.DENOM.LoopCounter1 = "1"
				WHILE(CINT(CUST.DENOM.LoopCounter1) != 15)
				#{
					sv_x = CUST.DENOM.LoopCounter1
					sv_n = ("BANCS").("INPUT").("NoteDenom" + sv_x)
					sv_f = ("BANCS").("INPUT").("CoinDenom" + sv_x)
					PRINT(sv_f)
					IF (sv_f != "") THEN
					#{
						IF (CUST.DENOM.denomVal == sv_f) THEN
						#{
							CUST.DENOM.delFlg = "N"
						#}
						ENDIF
					#}
					ENDIF
					CUST.DENOM.LoopCounter1 = CINT(sv_x) + 1
				#}
				DO
				IF (CUST.DENOM.delFlg == "Y") THEN
				#{
					#--Checking denom value still in use---
					BANCS.INPARAM.BINDVARS = CUST.DENOM.denomVal + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					
					sv_s = "denvalChk|SELECT COUNT(*) "
					sv_s = sv_s + "FROM C_detd "
					sv_s = sv_s + "WHERE denom_value= ?SVAR "
					sv_s = sv_s + "AND dxfer_flg='E' "
					sv_s = sv_s + "AND denom_ind='C' AND bank_id = ?SVAR "
					PRINT(sv_s)
					sv_d = urhk_DBSelectWithBind(sv_s)
					PRINT(sv_d)
					CUST.DENOM.denvalChk = BANCS.OUTPARAM.denvalChk
					PRINT(CUST.DENOM.denvalChk)
					IF (CUST.DENOM.denvalChk > 0) THEN
					#{
						sv_u = urhk_setOrbOut("Message|N")
						sv_u = urhk_setOrbOut("Details| Denomination  " + CUST.DENOM.denomVal + " used in Trans which are in entered state so cannot delete")
						sv_c = urhk_dbCursorClose(sv_k)
						GOTO FINISH
					#}
					ENDIF
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + CUST.DENOM.denomVal + "|" + CUST.DENOM.bank_id
					print(BANCS.INPARAM.BINDVARS)
					
					sv_s = "DELETE FROM C_MDNM "
					sv_s = sv_s + "WHERE crncy_code = ?SVAR "
					sv_s = sv_s + "AND denom_value= ?SVAR "
					sv_s = sv_s + "AND denom_ind='C' "
					sv_s = sv_s + "AND bank_id = ?SVAR "
					PRINT(sv_s)
					sv_d = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 1) THEN
					#{
						sv_u = urhk_setOrbOut("Message|N")
						sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
						sv_c = urhk_dbCursorClose(sv_k)
						GOTO FINISH
					#}
					ENDIF
				#}
				ENDIF
				sv_c = urhk_dbCursorFetch(sv_k)
			#}
			DO
			sv_c = urhk_dbCursorClose(sv_k)
			IF (sv_c != 0) THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				sv_u = urhk_setOrbOut("Details|DataBase Error")
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		
		CUST.DENOM.LoopCounter = "1"
		WHILE(CINT(CUST.DENOM.LoopCounter) != 15)
		#{
			sv_a = CUST.DENOM.LoopCounter
			sv_b = ("BANCS").("INPUT").("NoteDenom" + sv_a)
			IF (sv_b != "") THEN
			#{
				BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + sv_b + "|" + CUST.DENOM.bank_id
				print(BANCS.INPARAM.BINDVARS)
				
				sv_l = "cnt|select count(*) "
				sv_l = sv_l + "FROM C_MDNM "
				sv_l = sv_l + "WHERE crncy_code= ?SVAR "
				sv_l = sv_l + "AND denom_ind='N' "
				sv_l = sv_l + "AND denom_value= ?SVAR "
				sv_l = sv_l + "AND bank_id = ?SVAR "
				PRINT(sv_l)
				sv_v = urhk_dbSELECTWithBind(sv_l)
				PRINT(sv_v)
				CUST.DENOM.cntChk = BANCS.OUTPARAM.cnt
				PRINT(CUST.DENOM.cntChk)
				
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + CUST.DENOM.Currency
				PRINT(BANCS.INPARAM.BINDVARS)
				
				IF (CUST.DENOM.cntChk == 0) THEN
				#{
					sv_t = "INSERT INTO C_MDNM "
					sv_s = "(sol_id,"
					sv_s = sv_s + "crncy_code, "
					sv_s = sv_s + "denom_ind, "
					sv_s = sv_s + "denom_value,"
					sv_s = sv_s + "rcre_user_id, "
					sv_s = sv_s + "rcre_time, "
					sv_s = sv_s + "lchg_user_id, "
					sv_s = sv_s + "lchg_time, "
					sv_s = sv_s + "del_flg,bank_id) "
					sv_s = sv_s + " VALUES(?SVAR,"
					sv_s = sv_s + "?SVAR,"
					sv_s = sv_s + "'N',"
					sv_s = sv_s + sv_b + ","
					PRINT(sv_s)
					##	IDENTIFY THE HEAD TELLER AND PLACE IT HERE
					IF (CUST.DENOM.FuncCode == "A") THEN
					#{
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_s = sv_s + "?SVAR,"
						sv_s = sv_s + "sysdate,"
						PRINT(sv_s)
						#}
					ELSE
						#{
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DENOM.RecreUser +"|"+ CUST.DENOM.RecreTime
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_s = sv_s + "?SVAR,?SVAR,"
						PRINT(sv_s)
					#}
					ENDIF
					
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId+"|"+ CUST.DENOM.bank_id
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_s = sv_s + "?SVAR,"
					sv_s = sv_s + "sysdate,"
					sv_s = sv_s + "'N',"
					sv_s = sv_s + "?SVAR)"
					PRINT(sv_s)
					sv_q = sv_t + sv_s
					PRINT(sv_q)
					sv_d = urhk_dbSQLWithBind(sv_q)
					PRINT(sv_d)
					IF (sv_d == 1) THEN
					#{
						sv_u = urhk_setOrbOut("Message|N")
						sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
						GOTO FINISH
					#}
					ENDIF
					
				#}
				ENDIF
			#}
			ENDIF
			sv_b = ("BANCS").("INPUT").("CoinDenom" + sv_a)
			IF (sv_b != "") THEN
			#{
				
				BANCS.INPARAM.BINDVARS = CUST.DENOM.Currency + "|" + sv_b + "|" + CUST.DENOM.bank_id
				print(BANCS.INPARAM.BINDVARS)
				
				sv_l = "cnt|SELECT COUNT(*) "
				sv_l = sv_l + "FROM C_mdnm "
				sv_l = sv_l + "WHERE crncy_code= ?SVAR "
				sv_l = sv_l + "AND denom_ind='C' "
				sv_l = sv_l + "AND denom_value= ?SVAR "
				sv_l = sv_l + "AND bank_id = ?SVAR "
				PRINT(sv_l)
				sv_v = urhk_dbSELECTWithBind(sv_l)
				PRINT(sv_v)
				CUST.DENOM.cntChk = BANCS.OUTPARAM.cnt
				PRINT(CUST.DENOM.cntChk)
				
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + CUST.DENOM.Currency
				PRINT(BANCS.INPARAM.BINDVARS)
				
				
				IF (CUST.DENOM.cntChk == 0) THEN
				#{
					sv_t = "INSERT INTO C_MDNM "
					sv_s = "(sol_id, "
					sv_s = sv_s + "crncy_code, "
					sv_s = sv_s + "denom_ind, "
					sv_s = sv_s + "denom_value,"
					sv_s = sv_s + "rcre_user_id, "
					sv_s = sv_s + "rcre_time, "
					sv_s = sv_s + "lchg_user_id, "
					sv_s = sv_s + "lchg_time, "
					sv_s = sv_s + "del_flg,bank_id) "
					sv_s = sv_s + " VALUES(?SVAR,"
					sv_s = sv_s + "?SVAR,"
					sv_s = sv_s + "'C',"
					sv_s = sv_s + sv_b + ","
					PRINT(sv_s)
					IF (CUST.DENOM.FuncCode == "A") THEN
					#{
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+BANCS.STDIN.userId
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_s = sv_s + "?SVAR,"
						sv_s = sv_s + "sysdate,"
						#}
					ELSE
						#{
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DENOM.RecreUser +"|"+ CUST.DENOM.RecreTime
						PRINT(BANCS.INPARAM.BINDVARS)
						
						sv_s = sv_s + "?SVAR,"
						sv_s = sv_s + "?SVAR,"
					#}
					ENDIF
					
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId +"|"+ CUST.DENOM.bank_id
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_s = sv_s + "?SVAR,"
					sv_s = sv_s + "sysdate,"
					sv_s = sv_s + "'N',"
					sv_s = sv_s + "?SVAR)"
					PRINT(sv_s)
					sv_q = sv_t + sv_s
					PRINT(sv_q)
					sv_d = urhk_dbSQLWithBind(sv_q)
					PRINT(sv_d)
					IF (sv_d == 1) THEN
					#{
						sv_u = urhk_setOrbOut("Message|N")
						sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
						GOTO FINISH
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			CUST.DENOM.LoopCounter = CINT(sv_a) + 1
		#}
		DO
		IF (CUST.DENOM.FuncCode == "A") THEN
		#{
			CUST.DENOM.Details = "Denomination details for currency - " + CUST.DENOM.Currency + "  are added successfully!!!"
			PRINT(CUST.DENOM.Details)
			#}
		ELSE
			#{
			CUST.DENOM.Details = "Denomination details for currency - " + CUST.DENOM.Currency + "  are modified successfully!!!"
			PRINT(CUST.DENOM.Details)
		#}
		ENDIF
	#}
	ENDIF
	
	#--------------------------------------------------------------------------------------
	#		PERFORM DELETE OPERATION
	#--------------------------------------------------------------------------------------
	IF (CUST.DENOM.FuncCode == "D") THEN
	#{
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_t = "UPDATE C_MDNM SET del_flg = 'Y', "
		sv_s = "lchg_user_id = ?SVAR,"
		sv_s = sv_s + "lchg_time = sysdate "
		sv_s = sv_s + "WHERE del_flg='N' "
		sv_s = sv_s + "AND crncy_code = ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		sv_q = sv_t + sv_s
		PRINT(sv_q)
		sv_d = urhk_dbSQLWithBind(sv_q)
		PRINT(sv_d)
		IF (sv_d == 1) THEN
		#{
			sv_u = urhk_setOrbOut("Message|N")
			sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
			GOTO FINISH
		#}
		ENDIF
		CUST.DENOM.Details = "Denomination details for currency - " + CUST.DENOM.Currency + " are deleted successfully!!!"
	#}
	ENDIF
	
	#--------------------------------------------------------------------------------------
	#		PERFORM UN-DELETE OPERATION
	#--------------------------------------------------------------------------------------
	IF (CUST.DENOM.FuncCode == "U") THEN
	#{
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + CUST.DENOM.Currency + "|" + CUST.DENOM.bank_id
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_t = "UPDATE C_MDNM SET del_flg = 'N', "
		sv_s = "lchg_user_id = ?SVAR,"
		sv_s = sv_s + "lchg_time = sysdate "
		sv_s = sv_s + "WHERE del_flg='Y' "
		sv_s = sv_s + "AND crncy_code = ?SVAR"
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		sv_q = sv_t + sv_s
		PRINT(sv_q)
		sv_d = urhk_dbSQLWithBind(sv_q)
		PRINT(sv_d)
		IF (sv_d == 1) THEN
		#{
			sv_u = urhk_setOrbOut("Message|N")
			sv_u = urhk_setOrbOut("Details|Oracle Error - Try after sometime")
			GOTO FINISH
		#}
		ENDIF
		CUST.DENOM.Details = "Denomination details for currency - " + CUST.DENOM.Currency + "  are retrieved successfully!!!"
	#}
	ENDIF
	
	#--------------------------------------------------------------------------------------
	#		SUCCESS MESSAGE
	#--------------------------------------------------------------------------------------
	sv_u = urhk_setOrbOut("Message|Result")
	PRINT(CUST.DENOM.Details)
	sv_u = urhk_setOrbOut("Details|" + CUST.DENOM.Details)
	
	#Calling Audit User Hook
	sv_s = urhk_Audit("")
	
	#Clearing the repos and classes
	IF (CLASSEXISTS("AUDIT", "OLD") == 1) THEN
	#{
		DELETECLASS("AUDIT", "OLD")
	#}
	ENDIF
	
	IF (CLASSEXISTS("AUDIT", "NEW") == 1) THEN
	#{
		DELETECLASS("AUDIT", "NEW")
	#}
	ENDIF
	
	IF (CLASSEXISTS("AUDIT", "KEY") == 1) THEN
	#{
		DELETECLASS("AUDIT", "KEY")
	#}
	ENDIF
	
	IF (REPEXISTS("AUDIT") == 1) THEN
	#{
		DELETEREP("AUDIT")
	#}
	ENDIF
	
	print(sv_s)
	print(BANCS.OUTPARAM.refNum)
	print(BANCS.OUTPARAM.successOrFailure)
	
	
	FINISH:
		EXITSCRIPT
		TRACE OFF
END-->
