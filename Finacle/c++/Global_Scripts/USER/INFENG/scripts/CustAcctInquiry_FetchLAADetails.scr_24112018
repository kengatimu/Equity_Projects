<--start
#trace on

	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.acid
	print(CUST.INTERFACE.acid)

	sv_s = "tmpShdlNum|"
	sv_s = sv_s + "SELECT max(SHDL_NUM) FROM TBAADM.LRS WHERE ACID= ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN
        #{
		CUST.INTERFACE.tmpShdlNum = BANCS.OUTPARAM.tmpShdlNum
		print(CUST.INTERFACE.tmpShdlNum)
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.acid + "|" + CUST.INTERFACE.acid + "|" + "N"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N" + "|" + "Y" + "|" + "Y"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.bankID
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.bankID
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "EIDEM"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.acid
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.tmpShdlNum

	sv_s = "flowStartDate,lrFreqType,flowAmt,numOfFlows,disbAmt,remnumOfFlows|"
	sv_s = sv_s + "SELECT to_char(FLOW_START_DATE,'DD-MM-YYYY'),LR_FREQ_TYPE,FLOW_AMT,NUM_OF_FLOWS,DIS_AMT,(LRS.NUM_OF_FLOWS-LRS.NUM_OF_DMDS) REM_NUM_OF_FLOW"
	sv_s = sv_s + " FROM TBAADM.LAM,TBAADM.LRS WHERE LAM.ACID = ?SVAR AND LRS.ACID = ?SVAR"
	sv_s = sv_s + " AND LAM.ACID = LRS.ACID AND LAM.DEL_FLG = ?SVAR AND LRS.DEL_FLG = ?SVAR"
	sv_s = sv_s + " AND LAM.ENTITY_CRE_FLG = ?SVAR AND LRS.ENTITY_CRE_FLG = ?SVAR"
	sv_s = sv_s + " AND LAM.BANK_ID = ?SVAR AND LRS.BANK_ID = ?SVAR AND LRS.FLOW_ID = ?SVAR"
	sv_s = sv_s + " AND LRS.FLOW_START_DATE = (SELECT max(FLOW_START_DATE) FROM LRS WHERE ACID = ?SVAR"
	sv_s = sv_s + " AND SHDL_NUM = ?SVAR)"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		sv_v = "shdlNum_" + FORMAT$(sv_q, "%d")
		#("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.shdlNum
		("CUST").("INTERFACE").(sv_v) = CUST.INTERFACE.tmpShdlNum
		sv_v = "flowStartDate_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.flowStartDate
		sv_v = "lrFreqType_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.lrFreqType
		sv_v = "flowAmt_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.flowAmt
		sv_v = "numOfFlows_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.numOfFlows
		sv_v = "remnumOfFlows_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.remnumOfFlows
		sv_v = "disbAmt_" + FORMAT$(sv_q, "%d")
	        ("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.disbAmt
	#}
	ELSE
	#{
		sv_v = "shdlNum_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
		sv_v = "flowStartDate_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
		sv_v = "lrFreqType_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
		sv_v = "flowAmt_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
		sv_v = "numOfFlows_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
		sv_v = "disbAmt_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
		sv_v = "remnumOfFlows_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""

	#}
	ENDIF

	# Added to include the account status for Loan account
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.acid + "|" + CUST.INTERFACE.bankID
	sv_s = "acct_cls_flg|select acct_cls_flg from tbaadm.gam where acid  = ?SVAR "
	sv_s = sv_s + " and bank_id = ?SVAR " 
	sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN
        #{
		sv_v = "accountStatus_" + FORMAT$(sv_q, "%d")
		IF(BANCS.OUTPARAM.acct_cls_flg == "N")THEN
		#{
			("CUST").("INTERFACE").(sv_v) = "A"
		#}
		ELSE
		#{
			("CUST").("INTERFACE").(sv_v) = "C"	
		#}
		ENDIF
	#}
	ENDIF


	IF(CUST.INTERFACE.DccId =="EFR")  THEN
        #{
                CUST.INTERFACE.dateArr = 0
		lv_q = sv_q 
                CALL("CustAcctInquiry_FetchArrearsDetails.scr")
		
		sv_q = lv_q
		print(sv_q)

                sv_v = "intOverdueAmount_" + FORMAT$(sv_q, "%d")
                ("CUST").("INTERFACE").(sv_v) = BANCS.OUTPUT.intOverdueAmount
                sv_v = "nonIntOverdueAmount_" + FORMAT$(sv_q, "%d")
                ("CUST").("INTERFACE").(sv_v) = BANCS.OUTPUT.nonIntOverdueAmount
                sv_v = "totOverdueAmount_" + FORMAT$(sv_q, "%d")
                ("CUST").("INTERFACE").(sv_v) = BANCS.OUTPUT.totOverdueAmount 
                sv_v = "dateArr_" + FORMAT$(sv_q, "%d")
                ("CUST").("INTERFACE").(sv_v) =  CUST.INTERFACE.dateArr
                sv_v = "nonIntOverdueDate_" + FORMAT$(sv_q, "%d")
                ("CUST").("INTERFACE").(sv_v) = BANCS.OUTPUT.nonIntOverdueDate

		print(("CUST").("INTERFACE").(sv_v))
        #}
        ENDIF

	IF(CUST.INTERFACE.DccId =="EXP")THEN
        #{
                 CUST.INTERFACE.dateArr = 0
		 CUST.INTERFACE.dmdsatisfymthd=""
                 CUST.INTERFACE.remnumOfFlows=""
		lv_q = sv_q 
               CALL("CustAcctInquiry_FetchArrearsDetails.scr")
		
		sv_q = lv_q
		print(sv_q)
               sv_v = "dateArr_" + FORMAT$(sv_q, "%d")
               ("CUST").("INTERFACE").(sv_v) =  CUST.INTERFACE.dateArr
		print(("CUST").("INTERFACE").(sv_v))
		sv_v = "dmdsatisfymthd_" + FORMAT$(sv_q, "%d")
               ("CUST").("INTERFACE").(sv_v) =  CUST.INTERFACE.dmdsatisfymthd
             		print(("CUST").("INTERFACE").(sv_v))

               ("CUST").("INTERFACE").(sv_v) =  CUST.INTERFACE.remnumOfFlows
		print(("CUST").("INTERFACE").(sv_v))


	ENDIF


#trace off
end-->
