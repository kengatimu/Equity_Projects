#-------------------------------------------------------------------------------------
<--START
CHECKSUM="50dd37d90a4cd4442c11f2513438d668ca7218063a0a5f331c6bafd92acc6e29"
	TRACE ON
	#-----------------------------------------------------------------
	# Creating Repository and classes
	#-----------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CATOD") == 0) THEN
	#{
		CREATECLASS("CUST","CATOD",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	#-----------------------------------------------------------------
	# Initialiizing required variables
	#-----------------------------------------------------------------
	CUST.CATOD.errMsg = ""
	
	#-------------------------------------------------------------------
	# Values coming FROM frontend
	#-------------------------------------------------------------------
	CUST.CATOD.Function 		=	BANCS.INPUT.funcCode
	CUST.CATOD.CurrencyCode 	= 	BANCS.STDIN.homeCrncyCode
	CUST.CATOD.cForacid			=	TRIM(BANCS.INPUT.foracid)
	CUST.CATOD.Cashlmt			= 	BANCS.INPUT.employer
	CUST.CATOD.Txfrlmt			= 	BANCS.INPUT.amount
	CUST.CATOD.Clglmt 			= 	BANCS.INPUT.score
	CUST.CATOD.CashIntSolmt 	= 	BANCS.INPUT.period
	CUST.CATOD.userWorkClass        =       BANCS.STDIN.userWorkClass
	
	
	#-----------------------------------Modified for TOL 369221---------------------------#
	BANCS.INPARAM.BINDVARS =CUST.CATOD.cForacid	 + "|" + "N" + "|" + "Y"
	
	sv_s ="schmType,schmCode|"
	sv_s = sv_s + " SELECT SCHM_TYPE,SCHM_CODE FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE  FORACID = ?SVAR "
	sv_s = sv_s + " AND DEL_FLG = ?SVAR "
	sv_s = sv_s + " AND ENTITY_CRE_FLG = ?SVAR"
	
	PRINT(sv_s)
	sv_u= urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CATOD.schmType=BANCS.OUTPARAM.schmType
		CUST.CATOD.schmCode=BANCS.OUTPARAM.schmCode
		#}
	ELSE
		#{
		CUST.CATOD.errorMsg="UNABLE TO FETCH SCHM TYPE FROM TABLE"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CATOD.errorMsg + "^acctNum")
		print(sv_u)
		GOTO ENDO
	#}
	ENDIF
	
	PRINT(CUST.CATOD.schmType)
	PRINT(CUST.CATOD.schmCode)
	#-----------------------------------------------------------
	#               Fetching valid schmecode:
	#-----------------------------------------------------------
	BANCS.INPUT.moduleName = "CATODSCORE"
	BANCS.INPUT.parameterId = "ALWDSCHM"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		sv_l = STRLEN(BANCS.OUTPUT.parameterVal)
		print(sv_l)
		CUST.CATOD.sType=BANCS.OUTPUT.parameterVal
		print(CUST.CATOD.sType)
		WHILE(sv_l > 0)
		#{
			sv_g = GETPOSITION(CUST.CATOD.sType,",")
			print(sv_g)
			IF (sv_g == 0) THEN
			#{
				CUST.CATOD.alwSchmType = CUST.CATOD.sType
				print(CUST.CATOD.alwSchmType)
				CUST.CATOD.sType = ""
				#}
			ELSE
				#{
				CUST.CATOD.alwSchmType = TRIM(MID$(CUST.CATOD.sType,0,sv_g - 1))
				CUST.CATOD.sType = MID$(CUST.CATOD.sType,sv_g,sv_l)
			#}
			ENDIF
			print(CUST.CATOD.alwSchmType)
			IF (CUST.CATOD.schmCode ==CUST.CATOD.alwSchmType) THEN
			#{
				GOTO LABEL1
			#}
			ENDIF
			print(CUST.CATOD.sType)
			sv_l = STRLEN(CUST.CATOD.sType)
			print(sv_l)
			IF (sv_l == 0) THEN
			#{
				CUST.CATOD.errMsg = "Scheme code not allowed for AutoTOD"
				sv_e = CUST.CATOD.errMsg
				sv_m = "funcCode"
				sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			# }
		#}
		DO
		#}
	ELSE
		#{
		CUST.CATOD.errMsg = "ALLOWED SCHMECODE SETUP NOT DONE IN CPARAM"
		sv_e = CUST.CATOD.errMsg
		sv_m = "funcCode"
		sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		# }
	#}
	ENDIF
	
	LABEL1:
		#-----------------------------------Modified for TOL 369221---------------------------#
		
		#-----------------------------------------------------------------
		# Getting Cparam Setups
		#-----------------------------------------------------------------
		call("rtgsuplddp001.scr")
		IF (CUST.CATOD.errMsg != "") THEN
		#{
			sv_e = CUST.CATOD.errMsg
			sv_m = "funcCode"
			sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CATOD.headOfficeSolId = CUST.CPARAM.homeSolId
		
		print(CUST.CATOD.Function)
		print(CUST.CATOD.CurrencyCode)
		print(CUST.CATOD.cForacid)
		print(CUST.CATOD.Cashlmt)
		print(CUST.CATOD.Txfrlmt)
		print(CUST.CATOD.Clglmt)
		print(CUST.CATOD.CashIntSolmt)
		print(CUST.CATOD.headOfficeSolId)
		print(CUST.CATOD.userWorkClass)
		
		sv_s = "crclRoleId|"
		sv_s = sv_s + " SELECT UPR.role_id"
		sv_s = sv_s + " FROM TBAADM.UPR"
		sv_s = sv_s + " WHERE UPR.user_id = ?SVAR"
		sv_s = sv_s + " AND UPR.del_flg = 'N'"
		sv_s = sv_s + " AND UPR.entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND UPR.home_bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" +BANCS.STDIN.contextBankId
		sv_d=urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d == 0) THEN
		#{
			CUST.CATOD.crclRoleId = BANCS.OUTPARAM.crclRoleId
			#}
		ELSE
			#{
			CUST.CATOD.crclRoleId = ""
		#}
		ENDIF
		
		#------------------------------------------------------------------------------------------
		# Validating The values of Function
		#------------------------------------------------------------------------------------------
		IF ((CUST.CATOD.Function=="A") OR (CUST.CATOD.Function=="M") OR (CUST.CATOD.Function=="Z") OR (CUST.CATOD.Function=="V")) THEN
		#{
			IF (CUST.CATOD.cForacid!="") THEN
			#{
				sv_s = "cifId,acid|"
				sv_s = sv_s + " SELECT GAM.cif_id, GAM.acid"
				sv_s = sv_s + " FROM TBAADM.GAM"
				sv_s = sv_s + " WHERE GAM.del_flg = 'N'"
				sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + " AND GAM.acct_cls_flg ='N'"
				sv_s = sv_s + " AND GAM.foracid = ?SVAR"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CATOD.cForacid + "|" +BANCS.STDIN.contextBankId
				sv_d=urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				
				IF (sv_d == 0)  THEN
				#{
					CUST.CATOD.custId = BANCS.OUTPARAM.cifId
					print(CUST.CATOD.custId)
					CUST.CATOD.acid = BANCS.OUTPARAM.acid
					print(CUST.CATOD.acid)
				#}
				ENDIF
				
				sv_u = urhk_getAcctDetailsInRepository(CUST.CATOD.cForacid)
				print(sv_u)
				
				IF (sv_u == 0) THEN
				#{
					CUST.CATOD.acctSolId  = BANCS.OUTPARAM.acctSolId
					CUST.CATOD.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
					CUST.CATOD.schmType = BANCS.OUTPARAM.schmType
					CUST.CATOD.schmCode = BANCS.OUTPARAM.schmCode
					CUST.CATOD.glSubHeadCode = BANCS.OUTPARAM.glSubHeadCode
					CUST.CATOD.acctOwner = BANCS.OUTPARAM.acctOwnerShip
					print(CUST.CATOD.acctSolId)
					print(CUST.CATOD.acctCrncyCode)
					print(CUST.CATOD.schmType)
					print(CUST.CATOD.schmCode)
					print(CUST.CATOD.glSubHeadCode)
					print(CUST.CATOD.acctOwner)
					#}
				ELSE
					#{
					CUST.CATOD.errMsg = "Account number is Invalid"
					sv_e = CUST.CATOD.errMsg
					sv_m = "foracid"
					sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				#------------------------------------------------------------------------------------------
				# Validation Account Status
				#------------------------------------------------------------------------------------------
				sv_s = "acctStatus|"
				sv_s = sv_s + " SELECT SMT.acct_status"
				sv_s = sv_s + " FROM TBAADM.SMT"
				sv_s = sv_s + " WHERE SMT.acid = ?SVAR"
				sv_s = sv_s + " AND SMT.bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CATOD.acid + "|" + BANCS.STDIN.contextBankId
				sv_d=urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				
				IF (sv_d == 0) THEN
				#{
					CUST.CATOD.acctStatus = BANCS.OUTPARAM.acctStatus
					print(CUST.CATOD.acctStatus)
					#}
				ELSE
					#{
					CUST.CATOD.acctStatus = ""
				#}
				ENDIF
				
				IF (BANCS.STDIN.contextBankId=="54") THEN
				#{
					IF (CUST.CATOD.acctStatus == "D" ) THEN
					#{
						CUST.CATOD.errMsg = "Account is Dormant/Inactive"
						sv_e = CUST.CATOD.errMsg
						sv_m = "foracid"
						sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ELSE
				#{

					IF (CUST.CATOD.acctStatus != "A" ) THEN
					#{
						CUST.CATOD.errMsg = "Account is Dormant/Inactive"
						sv_e = CUST.CATOD.errMsg
						sv_m = "foracid"
						sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
					#}
					ENDIF

				#}
				ENDIF
				
				#-----------------------------------------------------------
				#Fetching valid Workclass:
				#-----------------------------------------------------------
				BANCS.INPUT.moduleName = "CATODSCORE"
				BANCS.INPUT.parameterId = "WRKCLS"
				CALL("getcparamvalue.scr")
				
				IF (BANCS.OUTPUT.parameterVal != "")THEN
				#{
					print(BANCS.OUTPUT.parameterVal)
					sv_l = STRLEN(BANCS.OUTPUT.parameterVal)
					print(sv_l)
					CUST.CATOD.wrkCls=BANCS.OUTPUT.parameterVal
					print(CUST.CATOD.wrkCls)
					WHILE(sv_l > 0)
					#{
						sv_g = GETPOSITION(CUST.CATOD.wrkCls,",")
						print(sv_g)
						IF (sv_g == 0) THEN
						#{
							CUST.CATOD.classValue = CUST.CATOD.wrkCls
							print(CUST.CATOD.classValue)
							CUST.CATOD.wrkCls = ""
							#}
						ELSE
							#{
							CUST.CATOD.classValue = TRIM(MID$(CUST.CATOD.wrkCls,0,sv_g - 1))
							CUST.CATOD.wrkCls = MID$(CUST.CATOD.wrkCls,sv_g,sv_l)
						#}
						ENDIF
						print(CUST.CATOD.classValue)
						IF (CUST.CATOD.userWorkClass == CUST.CATOD.classValue) THEN
						#{
							GOTO VALIDATED
						#}
						ENDIF
						print(CUST.CATOD.wrkCls)
						sv_l = STRLEN(CUST.CATOD.wrkCls)
						print(sv_l)
						IF (sv_l == 0) THEN
						#{
							CUST.CATOD.errMsg = "Workclass is not sufficient for this operation. Use Inquiry Function."
							sv_e = CUST.CATOD.errMsg
							sv_m = "funcCode"
							sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
							sv_u = urhk_SetOrbOut(sv_e)
							sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					DO
					#}
				ELSE
					#{
					CUST.CATOD.errMsg = "Work Class set up is not done in CPARAM"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
			VALIDATED:
			#}
			ENDIF
			
			IF (CUST.CATOD.Function =="A") THEN
			#{
				IF (CUST.CATOD.Cashlmt != "") THEN
				#{
					sv_s = "count|"
					sv_s = sv_s + " SELECT COUNT(1)"
					sv_s = sv_s + " FROM TBAADM.EMRM"
					sv_s = sv_s + " WHERE EMRM.del_flg = 'N'"
					sv_s = sv_s + " AND EMRM.entity_cre_flg = 'Y'"
					sv_s = sv_s + " AND EMRM.employer_id = ?SVAR"
					sv_s = sv_s + " AND EMRM.bank_id=?SVAR"
					print(sv_s)
					
					BANCS.INPARAM.BINDVARS = CUST.CATOD.Cashlmt + "|" +BANCS.STDIN.contextBankId
					sv_d =  urhk_dbSelectWithBind(sv_s)
					
					IF (sv_d == 0)  THEN
					#{
						CUST.CATOD.count = BANCS.OUTPARAM.count
						print(CUST.CATOD.count)
					#}
					ENDIF
					# Removed the validation on Employer code as per TO 362792
					
					#			IF (CINT(CUST.CATOD.count) == 0)  THEN
					#{
					#				CUST.CATOD.errMsg = "Invalid Employer code!!"
					#				sv_e = CUST.CATOD.errMsg
					#				sv_m = "employer"
					#				sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
					#				sv_u = urhk_SetOrbOut(sv_e)
					#				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					#
					#				GOTO ENDOFSCRIPT
					#}
					#		ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		#------------------------------------------------------------------------------------------
		# IF Function Value is "A"  THEN INSERTING INTO TABLE CRCL
		#------------------------------------------------------------------------------------------
		
		IF (CUST.CATOD.Function=="A")  THEN
		#{
			
			sv_s = "count|"
			sv_s = sv_s + " SELECT COUNT(1)"
			sv_s = sv_s + " FROM CUSTOM.CATOD_MASTER_TABLE"
			sv_s = sv_s + " WHERE CATOD_MASTER_TABLE.ACCT_NUM = ?SVAR"
			sv_s = sv_s + " AND CATOD_MASTER_TABLE.bank_id = ?SVAR"
			sv_s = sv_s + " AND CATOD_MASTER_TABLE.del_flg = 'N'"
			sv_s = sv_s + " AND CATOD_MASTER_TABLE.entity_cre_flg in ('Y','N')"
			
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CATOD.cForacid + "|" +BANCS.STDIN.contextBankId
			sv_d=urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF (sv_d == 0)  THEN
			#{
				CUST.CATOD.count = BANCS.OUTPARAM.count
				print(CUST.CATOD.count)
			#}
			ENDIF
			
			IF (CINT(CUST.CATOD.count) >= 1)  THEN
			#{
				CUST.CATOD.errMsg = "Record Already Exist. Use M as Function"
				sv_e = CUST.CATOD.errMsg
				sv_m = "funcCode"
				sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				
				#-----------------------------------------------------------
				#Validate for the maximum contract amount
				#-----------------------------------------------------------
				BANCS.INPUT.moduleName = "CATODSCORE"
				BANCS.INPUT.parameterId = "MAXCNTRTAMT"
				CALL("getcparamvalue.scr")
				
				IF (BANCS.OUTPUT.parameterVal != "")THEN
				#{
					print(BANCS.OUTPUT.parameterVal)
					sv_l = STRLEN(BANCS.OUTPUT.parameterVal)
					print(sv_l)
					CUST.CATOD.maxCntrctAmt=BANCS.OUTPUT.parameterVal
					print(CUST.CATOD.maxCntrctAmt)
					
					IF (CDOUBLE(CUST.CATOD.maxCntrctAmt) < CDOUBLE(CUST.CATOD.Txfrlmt) ) THEN
					#{
						CUST.CATOD.errMsg = "Contract amount exceeds maximum allowed amount. "
						sv_e = CUST.CATOD.errMsg
						sv_m = "amount"
						sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.CATOD.errMsg = "Maximum contract amount allowed  setup is not done in CPARAM"
					sv_e = CUST.CATOD.errMsg
					sv_m = "funcCode"
					sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
					
				#}
				ENDIF
				
				
				#-------------------------------------------------------------------------
				# CALCULATING THE MAX CONTRACT AMOUNT
				# MAX_CNTRT_AMT  will be the sum of CONTRACT_AMT and the following charges
				# 2% of CONTRACT_AMT or 200 KES (whichever is higher)  -- Contract Fees
				# 10% of CONTRACT_AMT or 200 KES (whichever is higher) . Availment fees
				# 50 KES . Withdrawal charge
				#---------------------------------------------------------------------------
				
				print(CUST.CATOD.Txfrlmt)
				lv_t = CDOUBLE(CUST.CATOD.Txfrlmt) * 2/100
				lv_u = CDOUBLE(CUST.CATOD.Txfrlmt) * 10/100
				lv_w = 50
				
				print(lv_t)
				print(lv_u)
				
				IF ( lv_t < 200 ) THEN
				#{
					lv_t = 200
				#}
				ENDIF
				IF (BANCS.STDIN.contextBankId == "55") THEN
				#{
					IF ( lv_u < 5000 ) THEN
					#{
						lv_u = 5000
					#}
					ENDIF
					#}
				ELSE
					#{
					IF ( lv_u < 200 ) THEN
					#{
						lv_u = 200
					#}
					ENDIF
				#}
				ENDIF
				
				CUST.CATOD.MaxContracAmt = CDOUBLE(CUST.CATOD.Txfrlmt) + lv_t + lv_u + 50
				print(CUST.CATOD.MaxContracAmt)
				
				
				CUST.CATOD.depart =" "
				
				sv_s = "srlnum|SELECT CUSTOM.CATODSCORE_SEQ_"+ BANCS.STDIN.contextBankId + ".nextval "
				sv_s = sv_s +"FROM dual"
				print(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.CATOD.keySeq = BANCS.OUTPARAM.srlnum
					print(CUST.CATOD.keySeq)
				#}
				ENDIF
				
				IF (CINT(CUST.CATOD.CashIntSolmt)>12) THEN
				#{
					CUST.CATOD.errMsg = "Period can not be greater than 12"
					sv_e = CUST.CATOD.errMsg
					sv_m = "period"
					sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				sv_s = ""
				sv_s = sv_s + " INSERT INTO"
				sv_s = sv_s + " CUSTOM.CATOD_MASTER_TABLE"
				sv_s = sv_s + " ("
				sv_s = sv_s + " KEY_SEQ ,"
				sv_s = sv_s + " CUST_ID,"
				sv_s = sv_s + " SCORE,"
				sv_s = sv_s + " MAX_CNTRT_AMT,"
				sv_s = sv_s + " MAX_CNTRT_PERIOD,"
				sv_s = sv_s + " REC_TIMESTAMP,"
				sv_s = sv_s + " ACCT_NUM,"
				sv_s = sv_s + " CONTRACT_AMT,"
				sv_s = sv_s + " BRANCH_ID,"
				sv_s = sv_s + "  EMPLOYER,"
				sv_s = sv_s + " DEPARTMENT,"
				sv_s = sv_s + " BANK_ID,"
				sv_s = sv_s + " DEL_FLG,"
