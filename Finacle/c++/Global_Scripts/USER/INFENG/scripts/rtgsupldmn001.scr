				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.CATOD.CashIntSolmt
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.cForacid + "|" + CUST.CATOD.Txfrlmt
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.acctSolId + "|" + CUST.CATOD.Cashlmt
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.depart + "|" + BANCS.STDIN.contextBankId
				sv_d = urhk_dbsqlWithBind(sv_s)
				
