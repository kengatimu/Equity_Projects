<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
	
	 if(repexists("EBSRV")==0)then
        #{
                createrep("EBSRV")
        #}
        endif
        if(repexists("CUSTOM")==0)then
        #{
                createrep("CUSTOM")
        #}
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
        #{
                createclass("EBSRV","GLBDATA",5)
        #}
        endif
        if(classexists("CUSTOM","GLBDATA")==0)then
        #{
                createclass("CUSTOM","GLBDATA",5)
        #}
        endif

        sv_r = urhk_MTTS_Close("")
        print(sv_r)
        BANCS.INPARAM.PostTranFlg               = "Y"
        BANCS.INPARAM.CommitFlg                 = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
        BANCS.INPARAM.proxyPostFlg              = "P"
        BANCS.INPARAM.ValidationFlag            = "Y"
        BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw          = "Y"
        BANCS.INPARAM.CheckExceptions           = "N"
	EBSRV.GLBDATA.lAmt="0"
	EBSRV.GLBDATA.lRmks=""
	EBSRV.GLBDATA.lb2kid=""
        sv_u = urhk_MTTS_Initialize("")
        print(sv_u)
        if(sv_u != 0 )then
        #{
                EBSRV.GLBDATA.srvErrMsg = MTT.Error.Description
                EBSRV.GLBDATA.srvErrCode = "MTT"
                EBSRV.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        EBSRV.GLBDATA.machineId = ""
	EBSRV.GLBDATA.isMultiPay = ""
        sv_u = urhk_getEnv("HOST_NAME")
        print(BANCS.OUTPARAM.envValue)
        EBSRV.GLBDATA.machineId = BANCS.OUTPARAM.envValue
        sv_r = repexists("MTT")
        if(sv_r == 0)then
                createrep("MTT")
        endif
        sv_r = classexists("MTT","TranDetails")
        if(sv_r == 0)then
                createclass("MTT","TranDetails",5)
        endif
        MTT.TranDetails.TranDate	="0"
        MTT.TranDetails.TranType	= "T"
        MTT.TranDetails.TranSubType	= "BI"
        MTT.TranDetails.IgnoreExcp	= "I"
        MTT.TranDetails.Consolidate	= "Y"
        MTT.TranDetails.Remarks		= "FDR Loan Recovery"
        MTT.TranDetails.ValidationFlag  = "Y"
        MTT.TranDetails.PostTranFlg 	= "Y"
        MTT.TranDetails.CheckExceptions = "Y"
        MTT.TranDetails.PostFlag        = "Y"
        MTT.TranDetails.CommitFlg       = "Y"
        MTT.TranDetails.PrintAdviceInd  = "B"
        MTT.TranDetails.ModuleId        = "HTM"
        sv_u = urhk_MTTS_DefineTransaction("FDRRec002")
        print(sv_u)
        if(sv_u != 0 ) then
	#{
                EBSRV.GLBDATA.srvErrMsg = MTT.Error.Description
                EBSRV.GLBDATA.srvErrCode = "MTT"
                EBSRV.GLBDATA.srvSucFail = "F"
        	sv_r = urhk_MTTS_Close("")
                goto Endofscript
	#}
        endif


      
                EBSRV.GLBDATA.OdAcctId = EQOD.GLBDATA.accNum
                 EBSRV.GLBDATA.OpAcctId = EQOD.GLBDATA.OperaccNum 
                #EBSRV.GLBDATA.RepayMode = EQOD.GLBDATA.funcCode 
                EBSRV.GLBDATA.RepayAmount  = EQOD.GLBDATA.refAmt
		
		 if(EQOD.GLBDATA.funcCode=="P")then
                        BANCS.INPUT.RepayMode = "F"
                endif
                if(EQOD.GLBDATA.funcCode=="R")then
                        BANCS.INPUT.RepayMode = "P"
                endif

       		EBSRV.GLBDATA.RepayMode = BANCS.INPUT.RepayMode
		print(EBSRV.GLBDATA.RepayMode) 
	if(EBSRV.GLBDATA.RepayMode=="")then
	#{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Repayment Mode")
                BANCS.OUTPUT.successOrFailure="F"
        	sv_r = urhk_MTTS_Close("")
                exitscript
	#}
        endif
        if(cdouble(EBSRV.GLBDATA.RepayAmount)<=0)then
	#{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Repayment Amount")
                BANCS.OUTPUT.successOrFailure="F"
        	sv_r = urhk_MTTS_Close("")
                exitscript
	#}
        endif
	EBSRV.GLBDATA.isMultiPay = ""
        if(EBSRV.GLBDATA.OdAcctId!="")then
        #{
                sv_q = urhk_B2k_ForacidToAcid(EBSRV.GLBDATA.OdAcctId)
                if(sv_q==0)then
                #{
                        EBSRV.GLBDATA.odAcid = BANCS.OUTPARAM.Acid
                #}
                else
                #{
                        EBSRV.GLBDATA.odAcid = ""
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid Loan Account")
                        BANCS.OUTPUT.successOrFailure="F"
        		sv_r = urhk_MTTS_Close("")
                        exitscript
                #}
                endif
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.OdAcctId)
                if(sv_u!=0)then
                #{
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid OD Loan Account")
                        BANCS.OUTPUT.successOrFailure="F"
        		sv_r = urhk_MTTS_Close("")
                        exitscript
                #}
                else
                #{
                        EBSRV.GLBDATA.odSchmCode = BANCS.OUTPARAM.schmCode
                        print(EBSRV.GLBDATA.odSchmCode)
                        EBSRV.GLBDATA.crCif  = BANCS.OUTPARAM.cifId
                        print(EBSRV.GLBDATA.crCif)
                        EBSRV.GLBDATA.EffBal = BANCS.OUTPARAM.EffAvailableAmt
                        print(EBSRV.GLBDATA.EffBal)
                        EBSRV.GLBDATA.cClearBalance = BANCS.OUTPARAM.clearBalance
                        print(EBSRV.GLBDATA.cClearBalance)
			EBSRV.GLBDATA.odSolID = BANCS.OUTPARAM.acctSolId
			print(EBSRV.GLBDATA.odSolID)
                #}
                endif
                sv_u = urhk_getAdvanceDetailsForAccount(EBSRV.GLBDATA.OdAcctId)
                print(sv_u)
                if(sv_u==0)then
                #{
                        EBSRV.GLBDATA.OrgOpAcctId = BANCS.OUTPARAM.gacFreeText1
                #}
                else
                #{
                        EBSRV.GLBDATA.OrgOpAcctId = ""
                #}
                endif
		if(EBSRV.GLBDATA.OpAcctId!=EBSRV.GLBDATA.OrgOpAcctId)then
		#{
			print("Multi Source Repayment")
			EBSRV.GLBDATA.isMultiPay = "Y"
		#}
		endif
	#}
	endif
#Total due asOn Date
	lv_s = " asonDateDemandAmt | select sum(dmd_amt) from custom.odfdr_dmd_tbl where bank_id=?SVAR and dmd_amt>0 and entity_cre_flg='Y' and del_flg='N' and dmd_amt-tot_adj_amt>0 and od_acid=?SVAR order by disb_srl_num,dmd_date "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  EBSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	if(lv_d==0)then
	#{
		EBSRV.GLBDATA.asonDateDemandAmt = BANCS.OUTPARAM.asonDateDemandAmt
		print(EBSRV.GLBDATA.asonDateDemandAmt)
	else
		EBSRV.GLBDATA.asonDateDemandAmt = "0"
	#}
	endif
	print(EBSRV.GLBDATA.asonDateDemandAmt)
#Total Loan due 
	lv_s = " TotIntAmt | select sum(dmd_amt) from custom.odfdr_dmd_tbl where bank_id=?SVAR and dmd_amt>0 and flow_id='INDEM' and entity_cre_flg='Y' and del_flg='N' and dmd_amt-tot_adj_amt>0 and od_acid=?SVAR order by disb_srl_num,dmd_date "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	if(lv_d==0)then
	#{
		EBSRV.GLBDATA.TotIntAmt = BANCS.OUTPARAM.TotIntAmt
	else
		EBSRV.GLBDATA.TotIntAmt = "0"
	#}
	endif
	print(EBSRV.GLBDATA.TotIntAmt)
#Total Loan due 
	lv_s = " TotPrinAmt|select sum(dmd_amt)-sum(TOT_ADJ_AMT) from custom.odfdr_dmd_tbl where bank_id=?SVAR and dmd_amt>0 and flow_id='PRDEM' and entity_cre_flg='Y' and del_flg='N' and ((dmd_amt)-(tot_adj_amt))>0 and od_acid=?SVAR order by disb_srl_num,dmd_date "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	if(lv_d==0)then
	#{	
		print(BANCS.OUTPARAM.TotPrinAmt)
		EBSRV.GLBDATA.TotPrinAmt = BANCS.OUTPARAM.TotPrinAmt
		 print(EBSRV.GLBDATA.TotPrinAmt)
	else
		EBSRV.GLBDATA.TotPrinAmt = "0"
		 print(EBSRV.GLBDATA.TotPrinAmt)
	#}
	endif
#Total Interest due asOn Date
	lv_s = " asonDateInterestAmt | select sum(dmd_amt) from custom.odfdr_dmd_tbl where bank_id=?SVAR and dmd_amt>0 and entity_cre_flg='Y' and del_flg='N' and flow_id='INDEM' and dmd_amt-tot_adj_amt>0 and dmd_ovdu_date<=to_date(?SVAR,'DD-MM-YYYY') and od_acid=?SVAR order by disb_srl_num,dmd_date "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + EBSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	if(lv_d==0)then
	#{
		EBSRV.GLBDATA.asonDateInterestAmt = BANCS.OUTPARAM.asonDateInterestAmt
	else
		EBSRV.GLBDATA.asonDateInterestAmt = "0"
	#}
	endif
	print(EBSRV.GLBDATA.asonDateInterestAmt)
#Total Principle due asOn Date
	lv_d = " asonDatePrincipleAmt | select sum(dmd_amt) from custom.odfdr_dmd_tbl where bank_id=?SVAR and dmd_amt>0 and entity_cre_flg='Y' and del_flg='N' and flow_id='PRDEM' and dmd_amt-tot_adj_amt>0 and dmd_ovdu_date<=to_date(?SVAR,'DD-MM-YYYY') and od_acid=?SVAR order by disb_srl_num,dmd_date "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + EBSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_d)
	lv_d = urhk_dbSelectWithBind(lv_d)
	if(lv_d==0)then
	#{
		EBSRV.GLBDATA.asonDatePrincipleAmt = BANCS.OUTPARAM.asonDatePrincipleAmt
	else
		EBSRV.GLBDATA.asonDatePrincipleAmt = "0"
	#}
	endif
	print(EBSRV.GLBDATA.asonDatePrincipleAmt)
	EBSRV.GLBDATA.TotDemandAmt = cdouble(EBSRV.GLBDATA.asonDatePrincipleAmt) + cdouble(EBSRV.GLBDATA.asonDateInterestAmt) 
	print(EBSRV.GLBDATA.TotDemandAmt)
	#Partial/Full Payment Validation
	if(EBSRV.GLBDATA.RepayMode=="P")then
	#{
		print(EBSRV.GLBDATA.RepayAmount)
		print(EBSRV.GLBDATA.asonDateDemandAmt)
		print(EBSRV.GLBDATA.TotPrinAmt)
		if(cdouble(EBSRV.GLBDATA.RepayAmount)>cdouble(EBSRV.GLBDATA.TotPrinAmt))then
		#{
			print("partial payment amount is greater than total principle due amount")
		#}
		endif
	#}
	endif
	EBSRV.GLBDATA.TotIntPrinAmt = cdouble(EBSRV.GLBDATA.TotIntAmt) + cdouble(EBSRV.GLBDATA.TotPrinAmt)
	if(EBSRV.GLBDATA.RepayMode=="F")then
	#{
		EBSRV.GLBDATA.RepayAmount = EBSRV.GLBDATA.cClearBalance
		print(EBSRV.GLBDATA.RepayAmount) 
	#}
	endif
	#Available Fund Validation
	sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.OpAcctId)
	if(sv_u!=0)then
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Invalid Repayment Account")
		BANCS.OUTPUT.successOrFailure="F"
        	sv_r = urhk_MTTS_Close("")
		exitscript
	#}
	else
	#{
		EBSRV.GLBDATA.repaySchmCode = BANCS.OUTPARAM.schmCode
		print(EBSRV.GLBDATA.repaySchmCode)
		EBSRV.GLBDATA.repayCif  = BANCS.OUTPARAM.cifId
		print(EBSRV.GLBDATA.repayCif)
                EBSRV.GLBDATA.acid1 = BANCS.OUTPARAM.acid
                print(EBSRV.GLBDATA.acid1)
		EBSRV.GLBDATA.repayEffBal = BANCS.OUTPARAM.EffAvailableAmt
		print(EBSRV.GLBDATA.repayEffBal)
		EBSRV.GLBDATA.repayClearBalance = BANCS.OUTPARAM.clearBalance
		print(EBSRV.GLBDATA.repayClearBalance)
		EBSRV.GLBDATA.lienAmmt= BANCS.OUTPARAM.lienAmt
		print(EBSRV.GLBDATA.lienAmmt)
		
	#}
	endif
	EBSRV.GLBDATA.fcClearBalance = -1* cdouble(EBSRV.GLBDATA.cClearBalance)
	print(EBSRV.GLBDATA.fcClearBalance)
	print(EBSRV.GLBDATA.RepayAmount)
	IF(EBSRV.GLBDATA.TotPrinAmt != "") THEN
	if((cdouble(EBSRV.GLBDATA.TotPrinAmt) < cdouble(EBSRV.GLBDATA.RepayAmount)) and (EBSRV.GLBDATA.RepayMode=="P"))then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Partial Payment amount should be equal or lessthan total principle amount")
		BANCS.OUTPUT.successOrFailure="F"
        	sv_r = urhk_MTTS_Close("")
		exitscript
	endif
	else
	if((cdouble(EBSRV.GLBDATA.fcClearBalance) < cdouble(EBSRV.GLBDATA.RepayAmount)) and (EBSRV.GLBDATA.RepayMode=="P"))then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Partial Payment amount is Greater than Loan balance. Use Payoff Instead.")
		BANCS.OUTPUT.successOrFailure="F"
       	 	sv_r = urhk_MTTS_Close("")
		exitscript
	endif
	endif
	if((cdouble(EBSRV.GLBDATA.repayEffBal) > cdouble(EBSRV.GLBDATA.RepayAmount))and (EBSRV.GLBDATA.RepayMode=="P"))then
	#{
		EBSRV.GLBDATA.TranAmount = cdouble(EBSRV.GLBDATA.RepayAmount)
	#}
	endif
	lv_z = "LienBal|select '"+EBSRV.GLBDATA.RepayAmount+"' - '"+EBSRV.GLBDATA.lienAmmt+"' from dual "
	print(lv_z)
	lv_y = urhk_dbSelectWithBind(lv_z)
	if(lv_z != 0) then
		EBSRV.GLBDATA.LienBal = cdouble("0")
	else
		EBSRV.GLBDATA.LienBal = cdouble(BANCS.OUTPARAM.LienBal)
	endif
	####pick lien
	IF(EBSRV.GLBDATA.odSchmCode == "ODFDR") THEN
	#{
		lv_t = "lAmt,lRmks,lb2kid|select LIEN_AMT,LIEN_REMARKS,B2K_ID from tbaadm.alt where acid = '"+EBSRV.GLBDATA.acid1+"' "
		lv_t = lv_t + " and LIEN_REASON_CODE ='ODFDR' "
		lv_r = urhk_dbSelectWithBind(lv_t)
		if(lv_r == 0) then
			EBSRV.GLBDATA.lAmt=BANCS.OUTPARAM.lAmt
			EBSRV.GLBDATA.lRmks=BANCS.OUTPARAM.lRmks
			EBSRV.GLBDATA.lb2kid=BANCS.OUTPARAM.lb2kid
		endif
	#}
	ENDIF
	if(EBSRV.GLBDATA.LienBal < 0) then
	IF(EBSRV.GLBDATA.RepayMode=="F") then
	sv_s = "totAmttt|select '"+EQOD.GLBDATA.lllaclearBalance+"' + '"+EQSRV.GLBDATA.tranAmtt+"' from dual "
	sv_u = urhk_dbSelectWithBind(sv_s)
	print(sv_u)	
	if(sv_u == 0)then
	#{
		EQSRV.GLBDATA.totAmttt = BANCS.OUTPARAM.totAmttt
		PRINT(EQSRV.GLBDATA.totAmttt)
		print(EBSRV.GLBDATA.fcClearBalance)
		print(EQOD.GLBDATA.lllaclearBalance)
		if(cdouble(EBSRV.GLBDATA.fcClearBalance) == cdouble(EQOD.GLBDATA.lllaclearBalance)) then
		if(cdouble(EBSRV.GLBDATA.repayEffBal) < cdouble(EQSRV.GLBDATA.totAmttt))then
		#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Full Payment Failed ! Insufficient Fund in Operative Account^OperaccNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
       	 		sv_r = urhk_MTTS_Close("")
			exitscript
		#}
		endif
		endif
	#}
	endif	
	ENDIF
	if((cdouble(EBSRV.GLBDATA.repayEffBal) < cdouble(EBSRV.GLBDATA.RepayAmount))and (EBSRV.GLBDATA.RepayMode=="P"))then
	#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Partial Payment Failed ! Insufficient Fund in Operative Account^OperaccNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
        		sv_r = urhk_MTTS_Close("")
			exitscript
	#}
	endif
	if(EBSRV.GLBDATA.RepayMode=="F")then
	IF(EBSRV.GLBDATA.odSchmCode == "ODFDR") THEN
	#{
		if((cdouble(EBSRV.GLBDATA.TotIntPrinAmt)>cdouble(EBSRV.GLBDATA.repayClearBalance)) and (EBSRV.GLBDATA.RepayMode=="F"))then
		#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Full Payment Failed ! Insufficient Fund in Operative Account^OperaccNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
        		sv_r = urhk_MTTS_Close("")
			exitscript
		#}
		endif	
	#}
	else
	if((cdouble(EBSRV.GLBDATA.TotIntPrinAmt)>cdouble(EBSRV.GLBDATA.repayEffBal)) and (EBSRV.GLBDATA.RepayMode=="F"))then
	#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Full Payment Failed ! Insufficient Fund in Operative Account^OperaccNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
        		sv_r = urhk_MTTS_Close("")
			exitscript
	#}
	endif
	endif
	endif
	else
	if((cdouble(EBSRV.GLBDATA.repayEffBal) < cdouble(EBSRV.GLBDATA.RepayAmount))and (EBSRV.GLBDATA.RepayMode=="P"))then
	#{
			BANCS.STDIN.msg = "Error_1|Error.1 ^Partial Payment Failed ! Insufficient Fund in Operative Account^OperaccNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
        		sv_r = urhk_MTTS_Close("")
			exitscript
	#}
	endif
	endif
	print(EBSRV.GLBDATA.TotIntAmt)
	print(EBSRV.GLBDATA.asonDateInterestAmt)
	print(EBSRV.GLBDATA.TotPrinAmt)
	print(EBSRV.GLBDATA.asonDatePrincipleAmt)
	print(EBSRV.GLBDATA.TotDemandAmt)
	print(EBSRV.GLBDATA.asonDateDemandAmt)
	print(EBSRV.GLBDATA.RepayAmount)
	print(EBSRV.GLBDATA.TotIntPrinAmt)
	print(EBSRV.GLBDATA.cClearBalance)
	print(EBSRV.GLBDATA.isMultiPay)
	print(EBSRV.GLBDATA.OdAcctId)
	print(EBSRV.GLBDATA.OpAcctId)
	print(EBSRV.GLBDATA.repayEffBal)
	print(EBSRV.GLBDATA.repayClearBalance)
	print(EBSRV.GLBDATA.RepayMode)
#Entry starts
	if((cdouble(EBSRV.GLBDATA.cClearBalance)<0)and((EBSRV.GLBDATA.RepayMode=="F") or (EBSRV.GLBDATA.RepayMode=="P")))then
	#{
		if(EBSRV.GLBDATA.RepayMode=="F")then
				EBSRV.GLBDATA.TranAmount = cdouble(EBSRV.GLBDATA.cClearBalance)
		endif
		if(cdouble(EBSRV.GLBDATA.TranAmount)<0)then
			EBSRV.GLBDATA.TranAmount = -1 * cdouble(EBSRV.GLBDATA.TranAmount)
		endif
		print(EBSRV.GLBDATA.TranAmount)
		print(EBSRV.GLBDATA.OpAcctId)
                MTT.PartTranDetails.Account = EBSRV.GLBDATA.OpAcctId
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                MTT.PartTranDetails.RefAmount = -1*cdouble(EBSRV.GLBDATA.TranAmount)
                print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.TranCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.Amount = -1*cdouble(EBSRV.GLBDATA.TranAmount)
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.ValueDate   =  "0"
		if(EBSRV.GLBDATA.RepayMode=="F")then
			MTT.PartTranDetails.Particulars = "Full Payment via Codlpay :" + EBSRV.GLBDATA.OdAcctId
			MTT.PartTranDetails.Remarks = "Full Pay"
		endif
		if(EBSRV.GLBDATA.RepayMode=="P")then
			MTT.PartTranDetails.Particulars = "Payment Principle :" + EBSRV.GLBDATA.OdAcctId
			MTT.PartTranDetails.Remarks = "Prin Pay"
		endif
