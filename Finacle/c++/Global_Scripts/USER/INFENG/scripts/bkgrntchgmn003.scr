CHECKSUM="32aa61da9c04b082e70edf2cf7530d8437e97663b9640bb3602426e8e3e77dae"
	#TRACE ON
	
	#############################################################################
	# Custom repository creation
	#############################################################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	CUST.DATA.errMsg = ""
	sv_n = CDOUBLE("0")
	
	###############################################################################
	# To get the values from bank repository
	###############################################################################
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	
	
	###############################################################################
	# Calling getcparamvalue.scr script
	###############################################################################
	BANCS.INPUT.moduleName = "TRADE_FINANCE"
	BANCS.INPUT.parameterId = "BG_CHRG_PERC"
	CALL ("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.DATA.rate = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.errMsg = "Rate is not set"
		GOTO FINISH
	#}
	ENDIF
	
	################################################################################
	# comparing old BG Amount and new BG amount and calculate minimum charge amount
	################################################################################
	print(BANCS.INPUT.bgAmt)
	print(BANCS.INPUT.oldBgAmt)
	IF (CDOUBLE(BANCS.INPUT.bgAmt) != CDOUBLE(BANCS.INPUT.oldBgAmt)) THEN
	#{
		sv_a = CDOUBLE(BANCS.INPUT.bgAmt) - CDOUBLE(BANCS.INPUT.oldBgAmt)
		print(sv_a)
		IF (sv_a < CDOUBLE("0")) THEN
		#{
			sv_n = CDOUBLE("0")
			print(sv_n)
			GOTO FINISH
			#}
		ELSE
			#{
			print(BANCS.INPUT.NotlConvRate)
			sv_b =  CDOUBLE(BANCS.INPUT.NotlConvRate) * sv_a
			print(CUST.DATA.rate)
			sv_n = 	(sv_b * CDOUBLE(CUST.DATA.rate)) / CDOUBLE("100")
			print(sv_n)
			print(BANCS.INPUT.minimumChargeAmount)
			
			IF (CDOUBLE(BANCS.INPUT.minimumChargeAmount) > sv_n) THEN
			#{
				sv_n = CDOUBLE(BANCS.INPUT.minimumChargeAmount)
			#}
			ENDIF
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	FINISH:
		BANCS.OUTPUT.collAmount = sv_n
		BANCS.OUTPUT.AmountWithNoDiscount = sv_n
		print(BANCS.OUTPUT.collAmount)
		BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
		
		#TRACE OFF
		EXITSCRIPT
END-->
