<--START
CHECKSUM="275d4efa4d5d1f282e45bf18be2c8a3258d887232249146093928b8d0102d213"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.SBACT.errMsg = ""
	
	sv_s="foracid,solid,lienamount,crncy|"
	sv_s = sv_s + " select FREE_TEXT2,g.sol_id,FREE_TEXT1,acct_crncy_code from CUSTOM.INT_CHANGE c,tbaadm.gam g where " 
	sv_s = sv_s + " c.bank_id =?SVAR and c.ENTITY_CRE_FLG ='LIEN' and c.FREE_TEXT2 = g.foracid and c.bank_id = g.bank_id "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.SBACT.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUSTS.SBACT.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.SBACT.solid	= BANCS.OUTPARAM.solid
			CUSTS.SBACT.amount	= BANCS.OUTPARAM.lienamount
			CUSTS.SBACT.crncy 	= BANCS.OUTPARAM.crncy
			
			print(CUSTS.SBACT.foracid)
			print(CUSTS.SBACT.solid)
			print(CUSTS.SBACT.amount)
			print(CUSTS.SBACT.crncy)
			
			####CUSTS.SBACT.amount=CUSTS.SBACT.amount
			#CUSTS.SBACT.amount1="0.00|KES"
			CUSTS.SBACT.amount1 ="0.00|"+CUSTS.SBACT.crncy
			print(CUSTS.SBACT.amount1)
			CUSTS.SBACT.date="01-12-2099 12:11:48"
			
			IF(CUSTS.SBACT.solid != BANCS.STDIN.mySolId)THEN
			#{
				sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.SBACT.solid)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
			#}
			ENDIF
			
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account lien services
			# urhk_SetUrhkInp is used to set inputs
			#--------------------------------------------------------------------------------------------------------------
			
			
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUSTS.SBACT.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|"+CUSTS.SBACT.crncy)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUSTS.SBACT.amount+"|"+CUSTS.SBACT.crncy)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUSTS.SBACT.amount1)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUSTS.SBACT.date)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|COGE")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|Lien due to coge loans ")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUSTS.SBACT.date)
			PRINT(sv_u)
			
			sv_u = urhk_ExecSrv("SRV_AddLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				sv_s = "update custom.int_change set ENTITY_CRE_FLG ='LIENA' where FREE_TEXT2 =?SVAR and FREE_TEXT1 =?SVAR and bank_id =?SVAR"
				BANCS.INPARAM.BINDVARS = CUSTS.SBACT.foracid + "|" + CUSTS.SBACT.amount + "|" + BANCS.STDIN.contextBankId  
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			ENDIF
			
			
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUSTS.SBACT.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|"+CUSTS.SBACT.crncy)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUSTS.SBACT.amount+"|"+CUSTS.SBACT.crncy) 
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUSTS.SBACT.amount1)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUSTS.SBACT.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|COGE")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|Lien due to coge loans ")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUSTS.SBACT.date)
				PRINT(sv_u)
				
				sv_u = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF (sv_u == 0) THEN
				#{
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					sv_s = "update custom.int_change set ENTITY_CRE_FLG ='LIENA' where FREE_TEXT2 =?SVAR and FREE_TEXT1 =?SVAR and bank_id =?SVAR"
                                        BANCS.INPARAM.BINDVARS = CUSTS.SBACT.foracid + "|" + CUSTS.SBACT.amount + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
				#}
				ENDIF
				
				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						print(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) THEN
					#{
						sv_u = system("echo 'Error for Acct:"+CUSTS.SBACT.foracid+" ' >>lienedacct.log")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>lienedacct2.log")
							print(sv_u)
						#}
						DO
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			
			sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.SBACT.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.SBACT.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUSTS.SBACT.errMsg+"' >>lienedacct.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
