		endif
		print(EQOD.GLBDATA.opEffAmt)
		print(EQOD.GLBDATA.tranAmt)
		if(cdouble(EQOD.GLBDATA.tranAmt)>cdouble(EQOD.GLBDATA.opEffAmt))then
		#{
			print("insufficient fund")
			exitscript
		#}
		endif
	#}
	endif
                        sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
