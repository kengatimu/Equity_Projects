		#{
			IF ( CINT(BANCS.OUTPARAM.ValidateAccout) <= 0 ) THEN
			#{
				CUST.STABI.errMsg = "Incorrect Account No. / Accounts of schm other than " + CUST.STABI.schmcode1 + " , " + CUST.STABI.schmcode2 + " are not allowed"
