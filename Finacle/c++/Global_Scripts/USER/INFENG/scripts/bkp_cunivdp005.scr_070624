	PRINT(CUST.STABI.funcCode)
	
	IF (CUST.STABI.funcCode == "D") THEN  
	#{
	   	##-----------------Validate whether Biller or Data -----Ichangai---#
		
	   sv_t="Func|select FUNC from custom.C_univ where acctnum=?SVAR and refNum=?SVAR and bank_id=?SVAR"
