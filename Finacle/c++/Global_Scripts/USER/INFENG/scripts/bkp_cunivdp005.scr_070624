							sv_d = urhk_dbSQLWithBind("COMMIT")
							sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
							sv_g = "RESULT_MSG|Record Deleted Successfully <b>" + CUST.STABI.refNum + " , " + CUST.STABI.name + "</b>"
							sv_z = urhk_SetOrbOut(sv_g)
							GOTO ENDOFSCRIPT
