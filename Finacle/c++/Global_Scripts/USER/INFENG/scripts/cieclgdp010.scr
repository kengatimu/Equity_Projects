<--START
CHECKSUM="e63627c1e7895d8bddf1498f4bd263f8c2640992545846ddd6318947f2676060"
	TRACE ON
	
	
	print(BANCS.OUTPARAM.Fatal_num)
	print(BANCS.OUTPARAM.Error_num)
	print(BANCS.OUTPARAM.Warning_num)
	print(BANCS.OUTPARAM.UserInfo_num)
	print(BANCS.OUTPARAM.Xcpn_num)
	print(BANCS.OUTPARAM.Xcpn_Err_num)
	print(BANCS.OUTPARAM.Xcpn_Xcpn_num)
	print(BANCS.OUTPARAM.Xcpn_Err_num)
	
	CUST.CIECLG.srvErrorType = ""
	CUST.CIECLG.srvError = "Y"
	
	sv_d = 1
	sv_n = 1
	sv_c = CINT(BANCS.OUTPARAM.Error_num)
	WHILE (sv_d <= sv_c)
	#{
		CUST.CIECLG.srvErrorType = "E"
		sv_f = FORMAT$(sv_d,"%d")
		sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
		print(sv_b)
		sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
		print(sv_e)
		sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
		print(sv_a)
		sv_g = "Error_" + FORMAT$(sv_n,"%d") + "|SRV ERROR^" + sv_b + "^prodCode"
		print(sv_g)
		sv_u = urhk_SetOrbOut(sv_g)
		print(sv_u)
		
		sv_d = sv_d + 1
		sv_n = sv_n + 1
	#}
	DO
	
	IF(CUST.CIECLG.srvErrorType == "E")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.OUTPARAM.Xcpn_num) == 1)THEN
	#{
		sv_n = 1
		sv_d = 1
		sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
		WHILE (sv_d <= sv_c)
		#{
			CUST.CIECLG.srvErrorType = "X"
			sv_f = FORMAT$(sv_d,"%d")
			sv_e = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
			print(sv_e)
			
			IF(CUST.CIECLG.srvcallmode == "E")THEN
			#{
				sv_s = sv_e + "|N"
				sv_u = urhk_putCustomException(sv_s)
				#}
			ELSE
				#{
				CUST.CIECLG.srvErrorType = "X"
				CUST.CIECLG.srvError = "Y"
				sv_b = "Unable to ignore Exception Code "+sv_e
				sv_g = "Error_" + FORMAT$(sv_n,"%d") + "|SRV ERROR^" + sv_b + "^prodCode"
				print(sv_g)
				sv_u = urhk_SetOrbOut(sv_g)
				print(sv_u)
			#}
			ENDIF
			
			sv_d = sv_d + 1
			sv_n = sv_n + 1
			sv_d = sv_c + 1
		#}
		DO
	#}
	ENDIF
	
	IF(CUST.CIECLG.srvErrorType == "X")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.OUTPARAM.Warning_num) == 1)THEN
	#{
		sv_d = 1
		sv_c = CINT(BANCS.OUTPARAM.Warning_num)
		WHILE (sv_d <= sv_c)
		#{
			CUST.CIECLG.srvErrorType = "W"
			sv_f = FORMAT$(sv_d,"%d")
			sv_e = ("BANCS").("OUTPARAM").("WarningCode_" + sv_f)
			print(sv_e)
			
			sv_d = sv_d + 1
			sv_n = sv_n + 1
		#}
		DO
	#}
	ENDIF
	
	CUST.CIECLG.srvError = "N"
	
	ENDOFSCRIPT:
		
END-->
