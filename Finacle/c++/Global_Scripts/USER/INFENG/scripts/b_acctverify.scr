<--START
CHECKSUM="0f57407fd62ff887f022f1e051659b0380fec49ec75a2826de212e30163e239a"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBAAA") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBAAA",5)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.SBAAA.errMsg = ""
	
	CUSTS.SBAAA.schmcodes="SB777"
	
	sv_s="foracid,solid,schmcode,acctname|"
	sv_s = sv_s + "select foracid,sol_id,schm_code,acct_name from tbaadm.gam where bank_id = ?SVAR AND ENTITY_CRE_FLG='N' AND clr_bal_amt>'0' AND schm_code in ('SB777','SB142') AND RCRE_USER_ID='FIVUSR54' "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.SBAAA.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.SBAAA.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			
			CUSTS.SBAAA.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.SBAAA.solid	= BANCS.OUTPARAM.solid
			CUSTS.SBAAA.schmcode	= BANCS.OUTPARAM.schmcode
			CUSTS.SBAAA.acctname	= BANCS.OUTPARAM.acctname
			
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.SBAAA.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId|" + CUSTS.SBAAA.solid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.SBAAA.schmcode)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctName|" + CUSTS.SBAAA.acctname)
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_FetchSBAcctOpenDtlForVerify|retain_all_output = Y")
			print(sv_u)
			
			IF (sv_u == 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.SBAAA.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId|" + CUSTS.SBAAA.solid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.SBAAA.schmcode)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctName|" + CUSTS.SBAAA.acctname)
				PRINT(sv_u)
				sv_u = urhk_ExecSrv("SRV_VerifySBAcct|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_u = system("echo 'Error for Acct:"+CUSTS.SBAAA.foracid+" ' >>Opened.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>Verify.log")
						print(sv_u)
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			
			
			sv_k = urhk_dbCursorFetch(CUSTS.SBAAA.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.SBAAA.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.SBAAA.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUSTS.SBAAA.errMsg+"' >>Verify.log")
		#}
		ENDIF
		
		
		
		
		TRACE OFF
		exitscript
END-->
