			sv_z = sv_z + 1
			CUST.LEDGR.Counter = sv_z
			
			#--------------------------------------------------------------------------
			# Create the narration
			#--------------------------------------------------------------------------
			
			IF (CDOUBLE(CUST.LEDGR.AvailableBalAmt) >= CDOUBLE(CUST.LEDGR.Totalamt)) THEN
			#{
				
				IF (CUST.LEDGR.solidsh !="") THEN
				#{
					CUST.LEDGR.bacid="LEDGER"
