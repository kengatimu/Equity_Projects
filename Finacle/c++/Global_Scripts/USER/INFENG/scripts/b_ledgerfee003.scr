					#}
					ENDIF
					
					###################
					CUST.LEDGR.chrgs_accnt = CUST.LEDGR.foracid
					PRINT(CUST.LEDGR.chrgs_accnt)
					CUST.LEDGR.sum_fees = CUST.LEDGR.amt
					PRINT(CUST.LEDGR.sum_fees)
					CUST.LEDGR.crAccount = CUST.LEDGR.Mainincome
					PRINT(CUST.LEDGR.crAccount)
					
					sv_s = "getboddate|select to_char((db_stat_date),'DD-MON-YYYY') from tbaadm.gct where bank_id=?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbselectWithBind(sv_s)
