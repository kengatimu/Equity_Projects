					IF (sv_d == "0") THEN
					#{
						CUST.LEDGR.Mainincome= BANCS.OUTPARAM.contra
						PRINT(CUST.LEDGR.Mainincome)
						#}
					ELSE
						#{
						CUST.LEDGR.errMsg = "Ledger GL setup not done for the branch"
