					#{
						CUST.LEDGR.getboddate = BANCS.OUTPARAM.getboddate
						PRINT(CUST.LEDGR.getboddate)
						sv_a = "LEDGER FEE "
						CUST.LEDGR.narr1 = sv_a + "/" + CUST.LEDGR.getboddate
						PRINT(CUST.LEDGR.narr1)
					#}
					ENDIF
					
					
					
					IF (CDOUBLE(CUST.LEDGR.sum_fees)!=0) THEN
					#{
						#Sales Tax Credit

						CUST.LEDGR.Salestax = cdouble(CUST.LEDGR.sum_fees) * 0.18
						MTT.PartTranDetails.Account = CUST.LEDGR.salesTaxGl
						PRINT(MTT.PartTranDetails.Account)
						MTT.PartTranDetails.RefCurrency = CUST.LEDGR.acctCrncyCode
						MTT.PartTranDetails.RateCode ="MEAN"
						MTT.PartTranDetails.Rate = "0"
						MTT.PartTranDetails.ValueDateDiff = "0"
