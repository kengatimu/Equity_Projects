						CUST.LEDGR.salesTaxGl="2000340011780"


					ELSE
						BANCS.INPARAM.BINDVARS = CUST.LEDGR.solidsh + "|" + CUST.LEDGR.bacid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
						CUST.LEDGR.salesTaxGl="2000340011779"
					#}
					ENDIF
					PRINT(BANCS.INPARAM.BINDVARS)
					print(CUST.LEDGR.salesTaxGl)

					sv_d =urhk_dbSelectWithBind(sv_s)
