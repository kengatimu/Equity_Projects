						#{
							PRINT(MTT.Error.Description)
							CUST.LEDGR.MTTErrDesc = MTT.Error.Description
						#}
						ENDIF

						#Sales Tax Customer Debit

						CUST.LEDGR.Salestax = cdouble(CUST.LEDGR.sum_fees) * -0.18

						MTT.PartTranDetails.Account = CUST.LEDGR.chrgs_accnt
						PRINT(MTT.PartTranDetails.Account)
						MTT.PartTranDetails.RefCurrency = CUST.LEDGR.acctCrncyCode
						MTT.PartTranDetails.RateCode ="MEAN"
						MTT.PartTranDetails.Rate = "0"
						MTT.PartTranDetails.ValueDateDiff = "0"
						MTT.PartTranDetails.Particulars = "Sales charge on date :" + CUST.LEDGR.getboddate
						MTT.PartTranDetails.Particulars2 = "Sales Tax charges"
						MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.LEDGR.Salestax)
						PRINT(MTT.PartTranDetails.RefAmount)
						MTT.PartTranDetails.Remarks = "Sales Tax charges"
						MTT.PartTranDetails.RefNum = CUST.LEDGR.Salestax
						MTT.PartTranDetails.IgnoreExcp = "I"
						MTT.PartTranDetails.Consolidate = "N"
						MTT.PartTranDetails.TranIdentifier = sv_v
						sv_e = "CustStax"
						sv_r = urhk_MTTS_definePartTran(sv_e)
						PRINT(sv_r)
						IF(FIELDEXISTS(MTT.Error.Description)) THEN
						#{
							PRINT(MTT.Error.Description)
							CUST.LEDGR.MTTErrDesc = MTT.Error.Description
						#}
						ENDIF


						#Commission Credit
						MTT.PartTranDetails.Account = CUST.LEDGR.crAccount
						PRINT(MTT.PartTranDetails.Account)
						MTT.PartTranDetails.RefCurrency = CUST.LEDGR.acctCrncyCode
						MTT.PartTranDetails.RateCode ="MEAN"
						MTT.PartTranDetails.Rate = "0"
						MTT.PartTranDetails.ValueDateDiff = "0"
						MTT.PartTranDetails.Particulars = CUST.LEDGR.narr1
