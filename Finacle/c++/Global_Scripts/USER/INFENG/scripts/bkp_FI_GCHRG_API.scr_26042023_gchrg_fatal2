<--START
TRACE ON

	IF ((REPEXISTS("CUST")) == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF((CLASSEXISTS("CUST","DATA")) == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF

	   #--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
			sv_r = REPEXISTS("MTT")
			IF (sv_r == 0) THEN
							CREATEREP("MTT")
			ENDIF

			sv_r = CLASSEXISTS("MTT","TranDetails")
			IF (sv_r == 0) THEN
							CREATECLASS("MTT","TranDetails",5)
			ENDIF

			sv_r = CLASSEXISTS("MTT","PartTranDetails")
			IF (sv_r == 0) THEN
							CREATECLASS("MTT","PartTranDetails",5)
			ENDIF

			sv_r = CLASSEXISTS("MTT","InputDetails")
			IF (sv_r == 0) THEN
							CREATECLASS("MTT","InputDetails",5)
			ENDIF

			sv_r = CLASSEXISTS("MTT","Error")
			IF (sv_r == 0) THEN
							CREATECLASS("MTT","Error",5)
			ENDIF
			sv_r = CLASSEXISTS("BANCS","INPARAM")
			IF (sv_r == 0) THEN
			CREATECLASS("BANCS","INPARAM",5)
			ENDIF


	CUST.DATA.OrgTranId 	= ""
	CUST.DATA.OrgTranDate 	= ""
	CUST.DATA.Narration 	= ""
	CUST.DATA.EventId	= ""
	CUST.DATA.Insufficient_flg = "N"
	
	#------------------------------------
	#Getting input
	#-----------------------------------
	IF(FIELDEXISTS(BANCS.INPUT.tranType))THEN
	#{
		IF(BANCS.INPUT.tranType !="") THEN
		#{
			CUST.DATA.tranType = BANCS.INPUT.tranType
		ELSE
		       CUST.DATA.ErrMsg = "Please Provide Tran Type"
		       GOTO ERROR
		#}
		ENDIF

	ELSE
		CUST.DATA.ErrMsg = "Please Provide Tran Type"
		GOTO ERROR
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.tranSubType))THEN
	#{
		IF(BANCS.INPUT.tranSubType !="") THEN
		#{
			CUST.DATA.tranSubType = BANCS.INPUT.tranSubType
		ELSE
		       CUST.DATA.ErrMsg = "Please Provide Tran Sub Type"
		       GOTO ERROR
		#}
		ENDIF

	ELSE
		CUST.DATA.ErrMsg = "Please Provide Tran Sub Type"
		GOTO ERROR
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.DebitAccount))THEN
	#{
		IF(BANCS.INPUT.DebitAccount !="") THEN
		#{
			CUST.DATA.DebitAccount = BANCS.INPUT.DebitAccount
		ELSE
		       CUST.DATA.ErrMsg = "Please Provide the Debit A/C Id"
		       GOTO ERROR
		#}
		ENDIF

	ELSE
		CUST.DATA.ErrMsg = "Please Provide the Debit A/C Id"
		GOTO ERROR
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.EventId))THEN
	#{
		IF(BANCS.INPUT.EventId !="") THEN
		#{
			CUST.DATA.EventId =BANCS.INPUT.EventId
		ELSE
			CUST.DATA.ErrMsg = "Please Provide the Event Id"
			GOTO ERROR
		#}
		ENDIF

	ELSE
		CUST.DATA.ErrMsg = "Please Provide the Event Id"
		GOTO ERROR
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.chrgAmt))THEN
	#{
		IF(BANCS.INPUT.chrgAmt !="") THEN
		#{
			CUST.DATA.chrgAmt =BANCS.INPUT.chrgAmt
		ELSE
			CUST.DATA.ErrMsg = "Please Provide Charge Amount"
			GOTO ERROR
		#}
		ENDIF

	ELSE
		CUST.DATA.ErrMsg = "Please Provide Charge Amount"
		GOTO ERROR
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.ChrgCrncy))THEN
	#{
		IF(BANCS.INPUT.ChrgCrncy !="") THEN
		#{
			CUST.DATA.ChrgCrncy =BANCS.INPUT.ChrgCrncy
		ELSE
			CUST.DATA.ErrMsg = "Please Provide Charge Currency Code "
			GOTO ERROR
		#}
		ENDIF

	ELSE
		CUST.DATA.ErrMsg = "Please Provide Charge Currency Code "
		GOTO ERROR
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.OrgTranId))THEN
	#{
		IF(BANCS.INPUT.OrgTranId !="") THEN
		#{
			CUST.DATA.OrgTranId = BANCS.INPUT.OrgTranId
	 	ELSE	
			CUST.DATA.OrgTranId = ""
		#}
		ENDIF
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.OrgTranDate))THEN
	#{
		IF(BANCS.INPUT.OrgTranDate !="") THEN
		#{
			CUST.DATA.OrgTranDate = BANCS.INPUT.OrgTranDate
		ELSE
			CUST.DATA.OrgTranDate = ""
		#}
		ENDIF
	#}
	ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.Narration))THEN
        #{
                IF(BANCS.INPUT.Narration!="")THEN
                #{
                        CUST.DATA.Narration = "SMS CHARGE -" + BANCS.INPUT.Narration
		ELSE
			CUST.DATA.Narration = "SMS CHARGE"
                #}
                ENDIF
        #}
        ENDIF


    	lv_s = ""
        lv_s =lv_s + "output|"
        lv_s =lv_s + "SELECT DT_CHANGE_FLG from CUSTOM.EOD_TBL"

        print(lv_s)
        lv_z = urhk_dbSelectWithBind(lv_s)
        print(lv_z)
        IF(lv_z==0) THEN
        #{
		CUST.DATA.output   = BANCS.OUTPARAM.output
                print(CUST.DATA.output)
	ELSE
		CUST.DATA.output   = "N" 
		print(CUST.DATA.output)		
        #}
        endif

	IF(CUST.DATA.output=="Y")THEN
	#{
		CUST.DATA.DATA_INSERT_FLG = ""	
		print(CUST.DATA.tranType)
		print(CUST.DATA.tranSubType)
		print(CUST.DATA.DebitAccount)
		print(CUST.DATA.EventId)
		print(CUST.DATA.chrgAmt)
		print(CUST.DATA.ChrgCrncy)
		print(CUST.DATA.OrgTranId)
		print(CUST.DATA.OrgTranDate)
		print(CUST.DATA.Narration)
		CALL("SMS_CHARGE_EQUITY.scr")	

		IF(CUST.DATA.DATA_INSERT_FLG =="Y")THEN
		#{
			lv_z = urhk_SetOrbOut("Message|Charges collected successfully")
			lv_z = urhk_SetOrbOut("TranId| ")
			lv_z = urhk_SetOrbOut("TranDate| ")
			EXITSCRIPT
		ELSE		
			lv_z = urhk_SetOrbOut("Message|Charges collection failed")
			lv_z = urhk_SetOrbOut("TranId| ")
			lv_z = urhk_SetOrbOut("TranDate| ")
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.DebitAccount)
	if(sv_u!=0)then
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Invalid Account")
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	else
		CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
		print(CUST.DATA.schmCode)
		CUST.DATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.DATA.acctCrncyCode)
		CUST.DATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
		print(CUST.DATA.EffAvailableAmt)
		CUST.DATA.acctSolId = BANCS.OUTPARAM.acctSolId
		print(CUST.DATA.acctSolId)
	#}
	endif

	IF ((CUST.DATA.schmCode =="SB190") OR (CUST.DATA.schmCode =="SB191")) THEN
	#{
		lv_z = urhk_SetOrbOut("Message|Charges collected successfully")
		lv_z = urhk_SetOrbOut("TranId| ")
		lv_z = urhk_SetOrbOut("TranDate| ")
		EXITSCRIPT	
	#}
	ENDIF


	IF(CUST.DATA.acctCrncyCode!= CUST.DATA.ChrgCrncy)THEN
	#{
		BANCS.INPARAM.InputAmount	= CUST.DATA.chrgAmt 
		BANCS.INPARAM.FromCurrency	= CUST.DATA.ChrgCrncy
		BANCS.INPARAM.ToCurrency	= CUST.DATA.acctCrncyCode
		BANCS.INPARAM.RateCode		= "TTB"
		BANCS.INPARAM.Rate		= CDOUBLE("0.00")

		sv_b = urhk_B2k_ConvertAmount("")

		sv_c = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		sv_d = BANCS.OUTPARAM.Rate

		if(sv_c > CDOUBLE(CUST.DATA.EffAvailableAmt))then
		#{
			CUST.DATA.ErrMsg = "Insufficient balance to collect charges"
			CUST.DATA.Insufficient_flg = "Y" 
		#}
		endif
	ELSE
		if(CDOUBLE(CUST.DATA.chrgAmt)> CDOUBLE(CUST.DATA.EffAvailableAmt))then
                #{
                        CUST.DATA.ErrMsg = "Insufficient balance to collect charges"
			CUST.DATA.Insufficient_flg = "Y" 
                #}
                endif

	#}
	ENDIF

	IF(CUST.DATA.Insufficient_flg =="Y")THEN
	#{	
		CUST.DATA.DATA_INSERT_FLG = ""
		print(CUST.DATA.tranType)
		print(CUST.DATA.tranSubType)
		print(CUST.DATA.DebitAccount)
		print(CUST.DATA.EventId)
		print(CUST.DATA.chrgAmt)
		print(CUST.DATA.ChrgCrncy)
		print(CUST.DATA.OrgTranId)
		print(CUST.DATA.OrgTranDate)
		print(CUST.DATA.Narration)
		CALL("SMS_CHARGE_EQUITY.scr")

		IF(CUST.DATA.DATA_INSERT_FLG =="Y")THEN
		#{
			lv_z = urhk_SetOrbOut("Message|Insufficient balance to collect charges")
			lv_z = urhk_SetOrbOut("TranId| ")
			lv_z = urhk_SetOrbOut("TranDate| ")
			EXITSCRIPT
		ELSE
			lv_z = urhk_SetOrbOut("Message|Charges collection failed")
			lv_z = urhk_SetOrbOut("TranId| ")
			lv_z = urhk_SetOrbOut("TranDate| ")
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	#------------------------------------------------------------------------
	# Bacid and Crncy Accounts to be searched sol wise
	#------------------------------------------------------------------------
	CUST.DATA.inputBacid 	= "SMSNOTBRANCH"
	CUST.DATA.inputCcy 	= "KES" 
	CUST.DATA.inputSolID 	= CUST.DATA.acctSolId 

	sv_s = CUST.DATA.inputBacid + "|" + CUST.DATA.inputCcy + "|" + CUST.DATA.inputSolID
	PRINT(sv_s)
	sv_u = urhk_B2k_BacidToAcctId(sv_s)
	PRINT(sv_u)

	IF(sv_u == 0)THEN
	#{
		PRINT(BANCS.OUTPARAM.AcctId)
		CUST.DATA.CreditAccount  = BANCS.OUTPARAM.AcctId
		PRINT(CUST.DATA.CreditAccount)
	ELSE
		CUST.DATA.CreditAccount  = "0006500506362"	
		print(CUST.DATA.CreditAccount)
	#}
	ENDIF

        sv_a  = urhk_GetChannelInfo("")
        print(sv_a)
        print(BANCS.OUTPARAM.DccId)

        IF(BANCS.OUTPARAM.DccId!="")THEN
        #{
                CUST.DATA.DccId = BANCS.OUTPARAM.DccId
                print(CUST.DATA.DccId)
        ELSE
                CUST.DATA.DccId = "COR"
                print(CUST.DATA.DccId)
        #}
        ENDIF


	print(CUST.DATA.tranType)
	print(CUST.DATA.tranSubType)
	print(CUST.DATA.DebitAccount)
	print(CUST.DATA.EventId)
	print(CUST.DATA.chrgAmt)
	print(CUST.DATA.ChrgCrncy)
	print(CUST.DATA.Narration)

	#CUST.DATA.Tran_type = "T/BI"
	#CUST.DATA.Context_Crncy = "KES"


	CUST.DATA.tranId 		= ""
	CUST.DATA.tranDate		= ""
	CUST.DATA.ErrMsg		= ""
	CUST.DATA.Tag			= ""
	CUST.DATA.ErrorCode		= ""
	CUST.DATA.ErrMsg		= ""
	CUST.DATA.successOrFailure	= "S"
	CUST.DATA.Status = "Y"
	
	
	CUST.DATA.srvcallmode = ""

	IF(FIELDEXISTS(CUST.DATA.Narration))THEN
	#{
		print(CUST.DATA.Narration)
	#}
	ENDIF		

	IF(CUST.DATA.Narration=="")THEN
	#{
		CUST.DATA.Narration = "SMS CHARGE"
		PRINT(CUST.DATA.Narration)
	#}
	ENDIF
	
	#---------------------------------
	# Populate MTT details
	#---------------------------------

		sv_r = urhk_MTTS_PopulateInputDetails("")
		Print(sv_r)

		IF (sv_r != 0) THEN
		#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.DATA.errMsg = MTT.Error.Description
				PRINT(CUST.DATA.errMsg)
				EXITSCRIPT
		#}
		ENDIF

	#-----------------------------
	#--- Initialize MTT details
	#-----------------------------

		BANCS.INPARAM.PostTranFlg               = "Y"
		BANCS.INPARAM.CommitFlg                 = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
		BANCS.INPARAM.ValidationFlag            = "N"
		BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw          = "Y"
		BANCS.INPARAM.PartTranLUWFlg            = "Y"
		BANCS.INPARAM.IgnoreExcp        	= "I"
		BANCS.INPARAM.CheckExceptions           = "Y"

		sv_o = urhk_MTTS_Initialize("")
		PRINT(sv_o)

		IF(sv_o != 0)THEN
		#{
				sv_o = urhk_MTTS_ReportErrorCondition("")
				CUST.DATA.errMsg = MTT.Error.Description
				PRINT(CUST.DATA.errMsg)
				EXITSCRIPT
		#}
		ENDIF

	#-------------------------------
	# Define the transaction  #HEADER DETAILS
	#-------------------------------

		MTT.TranDetails.TranDate        = "0"
		MTT.TranDetails.TranType        = "T"
		MTT.TranDetails.TranSubType     = "BI"
		MTT.TranDetails.ValidationFlag  = "N"
		MTT.TranDetails.IgnoreExcp      = "I"
		MTT.TranDetails.CommitFlg       = "Y"
		MTT.TranDetails.PostFlag        = "Y"

		sv_r = urhk_MTTS_DefineTransaction("AUTOPOST")
		print(sv_r)

		IF (sv_r != 0) THEN
		#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.DATA.errMsg = MTT.Error.Description
				PRINT(CUST.DATA.errMsg)
				EXITSCRIPT
		#}
		ENDIF

	#----------------------------------------------
	#Main Transaction-------------------------------
	#----------------------------------------------
	#--------------------------------------------------------------------------
	#Credit to  account
	#--------------------------------------------------------------------------
		MTT.PartTranDetails.Account 		= CUST.DATA.CreditAccount
		MTT.PartTranDetails.RefAmount 		= cdouble(CUST.DATA.chrgAmt)
		#MTT.PartTranDetails.Amount      	= cdouble(CUST.DATA.chrgAmt)
		MTT.PartTranDetails.TranCurrency	= CUST.DATA.ChrgCrncy 
		MTT.PartTranDetails.RefCurrency 	= CUST.DATA.ChrgCrncy  
		MTT.PartTranDetails.ValueDate      	= "0"
		MTT.PartTranDetails.Particulars    	= CUST.DATA.Narration 
		MTT.PartTranDetails.Particulars2    	= CUST.DATA.DccId 
		MTT.PartTranDetails.Remarks        	= "SMS CHARGE" 
		MTT.PartTranDetails.TranIdentifier 	= "AUTOPOST"
		MTT.PartTranDetails.RateCode            = "MEAN"
		MTT.PartTranDetails.Consolidate    	= "N"
		IF(CUST.DATA.OrgTranId!="")THEN
		#{
			MTT.PartTranDetails.Refnum              = CUST.DATA.OrgTranId 
		#}
		ENDIF
		MTT.TranDetails.PostFlag           	= "Y"
		MTT.TranDetails.IgnoreExcp         	= "Y"

		sv_i = urhk_MTTS_DefinePartTran("CR")
		PRINT(sv_i)

		IF (sv_i != 0) THEN
		#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.DATA.errMsg = MTT.Error.Description
				PRINT(CUST.DATA.errMsg)
		#}
		ENDIF

	#Debit to Account
	#-----------------------------------------------------------------------------
                MTT.PartTranDetails.Account             = CUST.DATA.DebitAccount
                MTT.PartTranDetails.RefAmount           = -cdouble(CUST.DATA.chrgAmt)
                #MTT.PartTranDetails.Amount              = -cdouble(CUST.DATA.chrgAmt)
                MTT.PartTranDetails.TranCurrency        = CUST.DATA.acctCrncyCode
                MTT.PartTranDetails.RefCurrency         = CUST.DATA.ChrgCrncy 
                MTT.PartTranDetails.ValueDate           = "0"
                MTT.PartTranDetails.Particulars         = CUST.DATA.Narration
                MTT.PartTranDetails.Particulars2        = CUST.DATA.DccId
                MTT.PartTranDetails.Remarks             = "SMS CHARGE"
                MTT.PartTranDetails.TranIdentifier      = "AUTOPOST"
                MTT.PartTranDetails.RateCode            = "MEAN"
                MTT.PartTranDetails.Consolidate         = "N"
		IF(CUST.DATA.OrgTranId!="")THEN
		#{
			MTT.PartTranDetails.Refnum              = CUST.DATA.OrgTranId 
		#}
		ENDIF
                MTT.TranDetails.PostFlag                = "Y"
                MTT.TranDetails.IgnoreExcp              = "Y"

		sv_i = urhk_MTTS_DefinePartTran("DR")
		PRINT(sv_i)

		IF (sv_i != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
		#}
		ENDIF
	#--------------------------------------------------------------
	# MTT ending definition to create transaction
	#--------------------------------------------------------------

	sv_r = urhk_MTTS_EndDefinition("")
	PRINT(sv_r)

	IF(FIELDEXISTS(MTT.Error.Description)) THEN
	#{
		print(MTT.Error.Description)
		CUST.DATA.ErrMsg = MTT.Error.Description
		GOTO ERROR
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
	#{
		CUST.DATA.tranId = TRIM(BANCS.OUTPARAM.MTTTranId)
		PRINT(CUST.DATA.tranId)
		CUST.DATA.TranDate = MID$(BANCS.STDIN.BODDate,0,10)
		print(CUST.DATA.TranDate)
	#}
	ENDIF

	#--------------------------------------------------------------
	# MTT Closing an initialized MTT
	#--------------------------------------------------------------

	sv_r = urhk_MTTS_Close("")
	print(sv_r)

	print(CUST.DATA.tranId)
	CUST.DATA.TranDate = MID$(CUST.DATA.TranDate,0,10)
	print(CUST.DATA.TranDate)
	
        GOTO SUCCESS
        #---------------------------------->
        # Error Setting
        #---------------------------------->
ERROR:
        lv_z = urhk_SetOrbOut("CHARGESTATUS|FAILED")
        lv_z = urhk_SetOrbOut("ERROR|"+CUST.DATA.ErrMsg)
        GOTO ENDOFSCRIPT

        #---------------------------------->
        # Passing Output
	#---------------------------------->
SUCCESS:
        lv_z = urhk_SetOrbOut("Message|Charges collected successfully")
	lv_z = urhk_SetOrbOut("TranId|"+CUST.DATA.tranId)
	lv_z = urhk_SetOrbOut("TranDate|"+CUST.DATA.TranDate)
        GOTO ENDOFSCRIPT

ENDOFSCRIPT:
EXITSCRIPT
END-->


