##CUST.INTERFACE.CrAcct = "0020290425633"
CUST.INTERFACE.InstrType = "CHQ"
##CUST.INTERFACE.InstNum = "1"

sv_q="foracid,InstNum|"
sv_q = sv_q + "select foracid,ACCT_PREF  from custom.int_change where bank_id =?SVAR and ENTITY_CRE_FLG='CHQ'"
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)

	IF(sv_q == 1) THEN
		sv_x = urhk_dbCursorClose(sv_m)
		print(sv_x)
		exitscript
	ENDIF
	print(sv_q)

WHILE (sv_q==0)
	CUST.INTERFACE.CrAcct =	BANCS.OUTPARAM.foracid
	 print(CUST.INTERFACE.CrAcct)
	 print(CUST.INTERFACE.InstrType)
	 CUST.INTERFACE.InstNum = BANCS.OUTPARAM.InstNum
	 print(CUST.INTERFACE.InstNum)

	 sv_a = urhk_SetUrhkInp("acct.foracid|" + CUST.INTERFACE.CrAcct)
	 sv_a = urhk_SetUrhkInp("instrmnt.instrmntType|" + CUST.INTERFACE.InstrType)
	 sv_a = urhk_SetUrhkInp("instrmnt.instrmntNum|" + CUST.INTERFACE.InstNum)
	 sv_a = urhk_SetUrhkInp("instrmnt.instrmntAlpha|")

	sv_d = urhk_ExecSrvNoCommit("SRV_FetchChqStatForModify|same_user_verify = Y|retain_all_output = Y|call_mode = N")
