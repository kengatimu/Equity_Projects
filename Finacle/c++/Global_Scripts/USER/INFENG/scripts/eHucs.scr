			#}
			ELSE
			#{
				sv_v = 0
			#}
		ENDIF

		IF (sv_v > 0) THEN
		#{
			sv_u = system("echo 'Error for Acct:"+CUST.INTERFACE.CrAcct+" ' >>closed.log")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>closed.log")
				print(sv_u)

				sv_s = "UPDATE CUSTOM.INT_CHANGE "
				sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'CHQF',"
				sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE,"
				sv_s = sv_s + " INT_CHANGE.FREE_TEXT1= ?SVAR "
				sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
				sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
				sv_s = sv_s + " AND ENTITY_CRE_FLG='CHQ' "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = sv_e + "|" + CUST.INTERFACE.CrAcct + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
					goto NEXTREC
				#}
				ENDIF
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF

	#-------------------------------------------------------------------------------
