#---------------------------------------------------------------------------------    
#	Name			: ccrrm_FI_Verify.scr
#	Description		: Verfiy Script for CCRRM Custom Menu
#	Date			: 04-02-2024
#	Author			: JAMES GICHIRI
#	Input			: NA
#	Output			: NA
#	Called Script	: ccrrmbatchMain.com
#	Menu Option		: CCRRM
#----------------------------------------------------------------------------------

<--START
TRACE ON
LIBNAME CUSTOMSO


	if (REPEXISTS("CUST")==0)THEN
	#{
	CREATEREP("CUST")
	#}
	endif

	if (CLASSEXISTS("CUST","CCRRM")==0)THEN
	#{
	CREATECLASS("CUST","CCRRM",5)
	#}
	endif
	if(repexists("MTT")==0)then
        createrep("MTT")
	endif
	
	if(classexists("MTT","InputDetails")==0)then
		createclass("MTT","InputDetails",5)
	endif
	
	sv_a = urhk_b2k_printRepos("BANCS")
	print(sv_a)
	
	sv_a = urhk_MTTS_PopulateInputDetails("")
	print(sv_a)
	
	if(sv_a==0)then
	#{
		CUST.CCRRM.refcode= MTT.InputDetails.Argument1
		print(CUST.CCRRM.refcode)
		CUST.CCRRM.UserId= MTT.InputDetails.Argument2
		print(CUST.CCRRM.UserId)
		CUST.CCRRM.reportfile = MTT.InputDetails.Argument3
		print(CUST.CCRRM.reportfile)
		CUST.CCRRM.funCode = MTT.InputDetails.Argument4
		print(CUST.CCRRM.funCode)
		#exitscript
	#}	
	else
	#{
		print("Failed to populate the MTT")
		exitscript
	#}	
	endif

	
		
	# ********* Fetch Records and modify using CRM FI request
	
	
	
	print("Breakpoint 1")
	
	sv_a = urhk_b2k_printRepos("BANCS")
	print(sv_a)
	
	print("UPLOAD START")
	
	#exitscript	
	#====================VERIFICATION SECTION
	
	IF(CUST.CCRRM.funCode =="V")THEN
	#{

		#*************    Calling COM for verification process   **************************
		
		#=======================   Fetch data for verification  START
		
		sv_s = "customerid,customertype | select CIF_ID,CUST_TYPE from custom.ccrrm where ref_code=?SVAR and bank_id='"+BANCS.STDIN.contextBankId+"' and ENTITY_CRE_FLG='N' and VALID_FLG='Y' "
		BANCS.INPARAM.BINDVARS = CUST.CCRRM.refcode
		print(BANCS.INPARAM.BINDVARS)
        sv_k = urhk_dbCursorOpenWithBind(sv_s)
        PRINT(sv_k)
        sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        PRINT(sv_m)
        sv_c = urhk_dbCursorFetch(sv_m)
        PRINT(sv_c)
        IF(sv_c != 0)THEN
		#{
				CUST.CCRRM.SorFmessage = "No records found in the upload table for verification"
                sv_c=urhk_dbCursorClose(sv_m)
				
				sv_r = system("echo '\t"+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
				print(sv_r)
				
				GOTO VERREPORTSECTION
				
				
		#}		
        ELSE
		#{
            sv_j = 0
            PRINT(sv_j)
						
			WHILE (sv_c == 0)
				
				
				CUST.CCRRM.cust_id    = BANCS.OUTPARAM.customerid
				CUST.CCRRM.customertype    = BANCS.OUTPARAM.customertype
				CUST.CCRRM.verifyflg  = "F"
				CUST.CCRRM.entitycreflg = "N"
				#--------------------------------------------------------------------------------------------------------------
				# Inputs for Account Modify services
				# urhk_SetUrhkInp is used to set inputs
				#--------------------------------------------------------------------------------------------------------------
				
				call("ccrrVerifyReq.scr")
				
				IF(FIELDEXISTS(CUST.CRRMVER.SuccessOrFailure) == 1)THEN	
				#{
						print(CUST.CRRMVER.SuccessOrFailure)
						IF(trim(CUST.CRRMVER.SuccessOrFailure) == "S")THEN
						#{
							CUST.CCRRM.ModSuccessflg ="M"
							CUST.CCRRM.verifyflg = "P"
							CUST.CCRRM.entitycreflg = "Y"
							CUST.CCRRM.SorFmessage = "CIF Verified successfully"
								
						#}
						ELSE
						#{
							IF(FIELDEXISTS(CUST.CRRMVER.errorDesc) == 1)THEN
							#{
								CUST.CCRRM.SorFmessage = CUST.CRRMVER.errorDesc
							#}
							ELSE
							#{
								CUST.CCRRM.SorFmessage = "CIF Verification failed,Manual verification required"
							#}
							ENDIF
							CUST.CCRRM.verifyflg = "F"
						#}
						ENDIF
				#}
				ENDIF
				
				CUST.CCRRM.SorFmessage = CUST.CCRRM.cust_id +"   "+CUST.CCRRM.SorFmessage 
				print(CUST.CCRRM.SorFmessage)
				
				sv_r = system("echo '   "+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
				print(sv_r)
				
				
				#++++++++++Update the records after verification
				
				#------------------------------------------------------------
				#-- Updating the CCRRM table on the success condition  ---
				#-- status U - uploaded no modifification done yet-----------
				#-- status F - Failed to do modifification ------------------
				#-- status V - modification done, pending verification ------
				#-- status P - uploaded , modified done and verified --------
				#------------------------------------------------------------
				
				
				sv_s = "update CUSTOM.CCRRM set ENTITY_CRE_FLG=?SVAR,STATUS_CODE=?SVAR,LCHG_USER_ID=?SVAR,LCHG_TIME=sysdate where CIF_ID=?SVAR  and REF_CODE=?SVAR and bank_id=?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.CCRRM.entitycreflg +"|"+  CUST.CCRRM.verifyflg +"|"+ BANCS.STDIN.userId +"|"+ CUST.CCRRM.cust_id  +"|"+ CUST.CCRRM.refcode +"|"+BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				print(sv_s)
				sv_d=urhk_dbSqlWithBind(sv_s)
				IF (sv_d == 0)THEN
					sv_d = urhk_dbSQLWithBind("COMMIT")
				ENDIF
				
				sv_c = urhk_dbCursorFetch(sv_m)
				PRINT(sv_c)
				
			DO
			
			sv_c = urhk_dbCursorClose(sv_m)
			PRINT(sv_c)
			
		
		# ====================== END
		ENDIF
		
		
		#==================Report compilation 
		
		VERREPORTSECTION:
		
		sv_r = system("sleep 5")
		#********* START 
		
		sv_a=urhk_getEnv("B2K_SESSION_ID")
		IF(sv_a== 0)THEN
		#{
			CUST.CCRRM.session_id = BANCS.OUTPARAM.envValue
			print(CUST.CCRRM.session_id)
			
		#}
		ELSE
		#{
			CUST.CCRRM.errorMsg = "No sesion available"
			EXITSCRIPT
		#}
		ENDIF
		
		sv_r = system("sleep 5")
		print(sv_r)
		
		sv_u = urhk_getFileLocation("COM|ccrrm.com")
		IF(sv_u==0)THEN
		#{
			#Setting env variable
			#Session Id
			sv_a = "sessionid|" + CUST.CCRRM.session_id
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF
			
			#userId
			print(BANCS.STDIN.userId)
			sv_a = "userid|" + BANCS.STDIN.userId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF
			
			#Success file name
			sv_a = "successfile|" + CUST.CCRRM.reportfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
  			PRINT(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Error in setting env variable "
  				EXITSCRIPT
  			#}
  			ENDIF

			#Execute the com file
			BANCS.INPARAM.scriptName = "ccrrm.com"
			BANCS.INPARAM.arguments = ""
  			sv_u = urhk_CallShellScript("b")
  			print(sv_u)
  			IF (sv_u != 0) THEN
  			#{
  				CUST.CCRRM.errorMsg = "Could not execute com file: Report generation failed"
  				EXITSCRIPT
  			#}
  			ENDIF
			
			
			
			sv_r=system("rm -f"+ CUST.CCRRM.reportfile)
		#}
		ELSE
		#{
			CUST.CCRRM.errorMsg = "Unable to load the com file"
  				 exitscript
		#}
		ENDIF
		
		#********* END
	
		EXITSCRIPT
		
		
	#}
	ENDIF
	

 

exitscript
TRACE OFF
END-->



