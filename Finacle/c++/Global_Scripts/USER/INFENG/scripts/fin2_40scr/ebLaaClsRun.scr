#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Name                   : ebLaaClsRun.scr
#   Date                   : 15-Aug-2019
#   Description            : Loan CLose
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Reps/Class
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        ##print(sv_u)
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        EQSRV.GLBDATA.sucYN = ""
        EQSRV.GLBDATA.srvMsg = ""
        EQSRV.GLBDATA.datName = ""
        EQSRV.GLBDATA.laaAcctNum = ""
        EQSRV.GLBDATA.operAcctNum = ""
        EQSRV.GLBDATA.intAccrAmt = ""
        EQSRV.GLBDATA.intBookAmt = ""
        EQSRV.GLBDATA.laSolId = ""
        EQSRV.GLBDATA.laSchmCode = ""
        EQSRV.GLBDATA.laAcid = ""
        EQSRV.GLBDATA.clearBalance = ""
        EQSRV.GLBDATA.AvailableAmt = ""
        EQSRV.GLBDATA.EffAvailableAmt = ""
        EQSRV.GLBDATA.OpCrncy = ""
        EQSRV.GLBDATA.OpSchmType = ""
        EQSRV.GLBDATA.loanIntTot = ""
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                BANCS.INPUT.AcctNum = MTT.InputDetails.Argument1
                sv_l = strlen(MTT.InputDetails.Argument1)
                sv_f = mid$(MTT.InputDetails.Argument1,0,sv_l)
                sv_l = strlen(MTT.InputDetails.Argument1)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.laaAcctNum   = mid$(sv_f,0,(sv_p-1))
                EQSRV.GLBDATA.operAcctNum = mid$(sv_f,sv_p,sv_l)
                print(EQSRV.GLBDATA.laaAcctNum)
                print(EQSRV.GLBDATA.operAcctNum)

        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        endif
        BANCS.INPARAM.foracid = EQSRV.GLBDATA.laaAcctNum
        sv_u = urhk_getLoanAcctInterestDetails("")
        if(sv_u==0)then
               print(BANCS.OUTPARAM.intAccruedTillDate)
                EQSRV.GLBDATA.intAccrAmt = BANCS.OUTPARAM.intAccruedTillDate
               print(BANCS.OUTPARAM.intBookedTillDate)
                EQSRV.GLBDATA.intBookAmt = BANCS.OUTPARAM.intBookedTillDate
                sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.laaAcctNum)
                if(sv_u==0)then
                        EQSRV.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
                        EQSRV.GLBDATA.laSchmCode = BANCS.OUTPARAM.schmCode
                else
                        EQSRV.GLBDATA.sucYN = "N"
                        EQSRV.GLBDATA.srvMsg = "Invalid Loan Account " + EQSRV.GLBDATA.laaAcctNum
                        goto VAYU
                endif
                sv_q = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.laaAcctNum)
                if(sv_q==0)then
                        EQSRV.GLBDATA.laAcid = BANCS.OUTPARAM.Acid
                else
                        EQSRV.GLBDATA.sucYN = "N"
                        EQSRV.GLBDATA.srvMsg = "Invalid Loan Account " + EQSRV.GLBDATA.laaAcctNum
                        goto VAYU
                endif
        else
                EQSRV.GLBDATA.sucYN = "N"
                EQSRV.GLBDATA.srvMsg = "Invalid Loan Account " + EQSRV.GLBDATA.laaAcctNum
                goto VAYU
        endif
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.operAcctNum)
        if(sv_u==0)then
                EQSRV.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
                EQSRV.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt
                EQSRV.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
                EQSRV.GLBDATA.OpCrncy = BANCS.OUTPARAM.acctCrncyCode
                EQSRV.GLBDATA.OpSchmType = BANCS.OUTPARAM.schmType
        else
                EQSRV.GLBDATA.sucYN = "N"
                EQSRV.GLBDATA.srvMsg = "Invalid Operative Account " + EQSRV.GLBDATA.operAcctNum
                goto VAYU
        endif
        EQSRV.GLBDATA.loanIntTot = cdouble(EQSRV.GLBDATA.intAccrAmt) + cdouble(EQSRV.GLBDATA.intBookAmt)
        if(cdouble(EQSRV.GLBDATA.loanIntTot)<=0)then
                EQSRV.GLBDATA.sucYN = "Y"
                EQSRV.GLBDATA.srvMsg = "TOCLS"
                goto VAYUCLS
        endif
        print(EQSRV.GLBDATA.loanIntTot)
        print(EQSRV.GLBDATA.clearBalance)
        if(cdouble(EQSRV.GLBDATA.loanIntTot) > cdouble(EQSRV.GLBDATA.clearBalance))then
                EQSRV.GLBDATA.sucYN = "N"
                EQSRV.GLBDATA.srvMsg = "Insufficient Balance in Operative Account " + EQSRV.GLBDATA.operAcctNum
                goto VAYU
        endif
        #++++++++++++++++++++++++++++++++++++++++++++ lgen +++++++++++++++++++++++++++++++++++++++++++
        sv_l = EQSRV.GLBDATA.laaAcctNum + " " + EQSRV.GLBDATA.laSolId + " {~~~NULL!~~~} {~~~NULL!~~~} {~~~NULL!~~~} " + EQSRV.GLBDATA.laaAcctNum + " " + EQSRV.GLBDATA.laaAcctNum + " D I E Y N 0 0 {~~~NULL!~~~} N {~~~NULL!~~~} E {~~~NULL!~~~} L"
        EQSRV.GLBDATA.datName = "lgen" + EQSRV.GLBDATA.laaAcctNum + ".DAT"
        sv_q = "echo '" + sv_l + "' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_s = "echo $B2K_SESSION_ID"
        print(system(sv_s))
        sv_a = "nohup exebatch labx4001 $B2K_SESSION_ID < ./" +EQSRV.GLBDATA.datName
        sv_r = system(sv_a)
        if(sv_r==0)then
                sv_a = "rm -f " + EQSRV.GLBDATA.datName
		sv_r = system(sv_a)
        endif
        #++++++++++++++++++++++++++++++++++++++++++++ ldsp +++++++++++++++++++++++++++++++++++++++++++
        sv_l =EQSRV.GLBDATA.laSolId + " " + EQSRV.GLBDATA.laaAcctNum + " A {~~~NULL!~~~} " + EQSRV.GLBDATA.laaAcctNum + " " + EQSRV.GLBDATA.laaAcctNum + "  O {~~~NULL!~~~} {~~~NULL!~~~} {~~~NULL!~~~} N L"
        sv_p =" sol_set_id report_to type_of_demand schm_code_list from_acct_num to_acct_num recovery_mode recovery_option coll_pend_fee product_group pymnt_prioritization menu_parm"
        EQSRV.GLBDATA.datName = "ldsp" + EQSRV.GLBDATA.laaAcctNum + ".DAT"
        sv_q = "echo '" + sv_l + "' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo '" + sv_p + "' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo '' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo '' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo 'Loans Demand Satisfaction Process' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_l = EQSRV.GLBDATA.laaAcctNum
        sv_q = "echo '" + sv_l + "' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo '' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo '' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo '' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_q = "echo '' >> " + EQSRV.GLBDATA.datName
        sv_s = system(sv_q)
        sv_s = "echo $B2K_SESSION_ID"
        print(system(sv_s))
        sv_a = "nohup exebatch labx4004 $B2K_SESSION_ID < ./" +EQSRV.GLBDATA.datName
        sv_r = system(sv_a)
        if(sv_r==0)then
                sv_a = "rm -f " + EQSRV.GLBDATA.datName
		sv_r = system(sv_a)
        endif
        #++++++++++++++++++++++++++++++++++++++++++++ ldsp +++++++++++++++++++++++++++++++++++++++++++
VAYUCLS:
        #++++++++++++++++++++++++++++++++++++++++++++ Close +++++++++++++++++++++++++++++++++++++++++++
        if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.laSolId ) then
                sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.laSolId )
                sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
                if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                        print(BANCS.OUTPARAM.successOrFailure)
                        sv_s = BANCS.OUTPARAM.successOrFailure
                else
                        sv_s = "X"
                endif
                if (( sv_u != 0 ) and ( sv_s != "S"))then
                        EQSRV.GLBDATA.sucYN = "N"
                        EQSRV.GLBDATA.srvMsg = "CCS Failed"
                        goto VAYU
                endif
        endif
        sv_i = urhk_SetUrhkInp("acctBasic.foracid|" + EQSRV.GLBDATA.laaAcctNum )
        sv_u = urhk_ExecSrv("SRV_FetchLoanAcctDtlForClsr")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
                sv_u = urhk_SetUrhkInp("acctBasic.foracid|" + EQSRV.GLBDATA.laaAcctNum )
                sv_u = urhk_SetUrhkInp("acctBasic.acid|" + EQSRV.GLBDATA.laAcid )
                sv_u = urhk_SetUrhkInp("acctBasic.schmCode.schmCode|" + EQSRV.GLBDATA.laSchmCode )
                sv_u = urhk_ExecSrv(" SRV_CloseLoanAcctAndVerify|retain_all_output = Y")
                print(sv_u)
                if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                        print(BANCS.OUTPARAM.successOrFailure)
                        sv_s = BANCS.OUTPARAM.successOrFailure
                else
                        sv_s = "X"
                endif
                if (( sv_u == 0 ) and ( sv_s=="S") ) then
                        EQSRV.GLBDATA.sucYN = "Y"
                        EQSRV.GLBDATA.srvMsg = "Loan Closed Successfully  " + EQSRV.GLBDATA.laaAcctNum
                else
                        EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.laaAcctNum
                        callscriptifexist("ebsrvHandler.scr")
                        EQSRV.GLBDATA.sucYN = "N"
                        EQSRV.GLBDATA.srvMsg = "Loan Closure Failed " + EQSRV.GLBDATA.SrvError
                        goto VAYU
                endif
        else
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.laaAcctNum
                callscriptifexist("ebsrvHandler.scr")
                EQSRV.GLBDATA.sucYN = "N"
                EQSRV.GLBDATA.srvMsg = "Loan Closure Fetch Failed " + EQSRV.GLBDATA.SrvError
                goto VAYU
        endif
        #++++++++++++++++++++++++++++++++++++++++++++ Close +++++++++++++++++++++++++++++++++++++++++++
VAYU:
        print(EQSRV.GLBDATA.sucYN)
        print(EQSRV.GLBDATA.srvMsg)
        exitscript
trace off
end-->
