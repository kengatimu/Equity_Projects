<--start
	# Script body goes here
trace on


CUST.UBP.ref=""
print(CUST.UBP.billRefNum)




		##set up the input parameters for the script

		##Get the time-stamp from sysdate

		sv_z=""

		BANCS.INPARAM.Day=LEFT$(BANCS.STDIN.sysDate,2)
		PRINT(BANCS.INPARAM.Day)

		BANCS.INPARAM.Month=MID$(BANCS.STDIN.sysDate,3,2)
		PRINT(BANCS.INPARAM.Month)

		BANCS.INPARAM.Year=MID$(BANCS.STDIN.sysDate,8,2)
		PRINT(BANCS.INPARAM.Year)

		BANCS.INPARAM.Hour=MID$(BANCS.STDIN.sysDate,11,2)
		print(BANCS.INPARAM.Hour)

		BANCS.INPARAM.Minute=MID$(BANCS.STDIN.sysDate,14,2)
		print(BANCS.INPARAM.Minute)

		BANCS.INPARAM.Second=MID$(BANCS.STDIN.sysDate,17,2)
		print(BANCS.INPARAM.Second)

		BANCS.INPARAM.SYSDATE=BANCS.INPARAM.Second+BANCS.INPARAM.Minute+BANCS.INPARAM.Day+BANCS.INPARAM.Month+BANCS.INPARAM.Year

		print(BANCS.INPARAM.SYSDATE)



		BANCS.INPARAM.REQUESTUUID="reqUUID"+"TQ"+BANCS.INPARAM.SYSDATE

		BANCS.INPARAM.BANKID="54"

		BANCS.INPARAM.SERVICEREQUESTID="validateRiskNote1"

		BANCS.INPARAM.MESSAGEDATETIME=BANCS.STDIN.sysDate

		BANCS.INPARAM.CHANNELID="COR"

		BANCS.INPARAM.SERVICEREQUESTVERSION="10.3"

		BANCS.INPARAM.TIMEZONE="GMT+01:30"
			
		BANCS.INPARAM.UserApplId = "FCORE"
		BANCS.INPARAM.UserChannelId = "FI"


       #sv_z="IsRespReqd=NMSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
       sv_z="MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
       #sv_z = sv_z + "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
       sv_z = sv_z + "<FIXML>"
       sv_z = sv_z + "<Header>"
       sv_z = sv_z + "<RequestHeader>"
       sv_z = sv_z + "<MessageKey>"
       sv_z = sv_z + "<RequestUUID>" + BANCS.INPARAM.REQUESTUUID
       sv_z = sv_z + "</RequestUUID>"
       sv_z = sv_z + "<ServiceRequestId>" + BANCS.INPARAM.SERVICEREQUESTID
       sv_z = sv_z + "</ServiceRequestId>"
       sv_z = sv_z + "<ServiceRequestVersion>10.2"
       sv_z = sv_z + "</ServiceRequestVersion>"
       sv_z = sv_z + "<ChannelId>TNQ1"
       sv_z = sv_z + "</ChannelId>"
       sv_z = sv_z + "</MessageKey>"
       sv_z = sv_z + "<Reversal>"
       sv_z = sv_z + "<ParentRequestUUID>"
       sv_z = sv_z + "</ParentRequestUUID>"
       sv_z = sv_z + "</Reversal>"
       sv_z = sv_z + "<RequestMessageInfo>"
       sv_z = sv_z + "<BankId>54"
       sv_z = sv_z + "</BankId>"
       sv_z = sv_z + "<TimeZone>"
       sv_z = sv_z + "</TimeZone>"
       sv_z = sv_z + "<EntityId>"
       sv_z = sv_z + "</EntityId>"
       sv_z = sv_z + "<EntityType>"
      sv_z = sv_z + "</EntityType>"
      sv_z = sv_z + "<ArmCorrelationId>"
      sv_z = sv_z + "</ArmCorrelationId>"
      sv_z = sv_z + "<MessageDateTime>" + BANCS.INPARAM.MESSAGEDATETIME
      sv_z = sv_z + "</MessageDateTime>"
      sv_z = sv_z + "</RequestMessageInfo>"
      sv_z = sv_z + "<Security>"
      sv_z = sv_z + "<Token>"
      sv_z = sv_z + "<PasswordToken>"
      sv_z = sv_z + "<UserId>"
      sv_z = sv_z + "</UserId>"
      sv_z = sv_z + "<Password>"
      sv_z = sv_z + "</Password>"
      sv_z = sv_z + "</PasswordToken>"
      sv_z = sv_z + "</Token>"
      sv_z = sv_z + "<FICertToken>"
      sv_z = sv_z + "</FICertToken>"
      sv_z = sv_z + "<RealUserLoginSessionId>"
      sv_z = sv_z + "</RealUserLoginSessionId>"
      sv_z = sv_z + "<RealUser>"
      sv_z = sv_z + "</RealUser>"
      sv_z = sv_z + "<RealUserPwd>"
      sv_z = sv_z + "</RealUserPwd>"
      sv_z = sv_z + "<SSOTransferToken>"
      sv_z = sv_z + "</SSOTransferToken>"
      sv_z = sv_z + "</Security>"
      sv_z = sv_z + "</RequestHeader>"
      sv_z = sv_z + "</Header>"
      sv_z = sv_z + "<BODY>"
      sv_z=sv_z+"<RiskNote>"+CUST.UBP.ref
      sv_z=sv_z+"</RiskNote>"
      sv_z=sv_z+"<ClientId>"+CUST.UBP.billRefNum
      sv_z=sv_z+"</ClientId>"
      sv_z = sv_z + "</BODY>"
      sv_z = sv_z + "</FIXML>"
      
      ###################################setting the connection parameter START#################################################
      ##setting the service name to FIJCA
      BANCS.INPARAM.SERVICE_NAME="FIJCA"
      #you can change the value of following flag to "R" if user needs the response back
      BANCS.INPARAM.SEND_RECV_FLG="R"

      BANCS.INPARAM.InputXMLMsg=sv_z
      
      #calling the user hook to connect to FI

      sv_l=urhk_ConnectToFIAndSendMsg(sv_z)

      PRINT(sv_l)

       ##############



IF(sv_l!=0) then
	
	if(BANCS.OUTPARAM.ErrMsg!="") then
		
		PRINT("Error thrown from the user hook is ["+BANCS.OUTPARAM.ErrMsg+"]")
		CUST.UBP.errorFlg="Y"
		CUST.UBP.errorMsg="Error in Connecting to External System"
		
	endif
	
ELSE

            sv_z=BANCS.OUTPARAM.RespMesg
             print(sv_z)

		IF(sv_z=="") THEN
	
			print("The response is blank")
			CUST.UBP.errorFlg="Y"
			CUST.UBP.errorMsg="Record Does Not Exist"
                        GOTO ENDOFSCRIPT
		

		ELSE
			print("The response is not blank")
			print(sv_z)
			CUST.UBP.respMessage=sv_z
			CUST.UBP.errorFlg="N"
			CUST.UBP.errorMsg=" "


                               sv_a=CUST.UBP.respMessage


				sv_v=MID$(sv_a,0,1)
				print(sv_v)

				IF(sv_v==1) THEN

					sv_b=STRLEN(sv_a)
					
					sv_c=GETPOSITION(sv_a,"!")
					
					sv_d=MID$(sv_a,sv_c,sv_b-1)
					
					sv_e=GETPOSITION(sv_d,"!")
					
					sv_f=STRLEN(sv_d)
					
					sv_f=MID$(sv_d,sv_e,sv_f-1)
					
					sv_g=STRLEN(sv_f)
					
					sv_h=GETPOSITION(sv_f,"!")
					
					sv_i=MID$(sv_f,0,sv_h-1)
					
					CUST.UBP.name=sv_i

					print(CUST.UBP.name)
					
					CUST.UBP.othername=sv_i

					print(CUST.UBP.othername)	
						
					sv_j=STRLEN(sv_f)
					
					sv_k=MID$(sv_f,sv_h,sv_j-1)
					
					sv_o=GETPOSITION(sv_k,"!")
					
					sv_p=STRLEN(sv_k)
					
					sv_q=MID$(sv_k,sv_o,sv_p-1)
					
					CUST.UBP.refnum=sv_q

					print(CUST.UBP.refnum)

	   ELSE

				    #{
                                        CUST.UBP.errorFlg="Y"
			                CUST.UBP.errorMsg="No Person with Such Risk note Number"
                                         
				    #}

			
		                 ENDIF
                     ENDIF

	
ENDIF

ENDOFSCRIPT:

trace off
EXITSCRIPT

end-->
