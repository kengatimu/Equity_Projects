<--start
trace on
	print(BANCS.INPUT.depAcctId)
	BANCS.OUTPUT.lvTranId = " "
	BANCS.OUTPUT.lvtranDate = " "
	BANCS.OUTPUT.lvvalueDate = " "
	BANCS.OUTPUT.lvtranAmount = " "
	sv_u = urhk_B2k_ForacidToAcid(BANCS.INPUT.depAcctId)
	if(sv_u==0)then
		BANCS.INPUT.depAccId = BANCS.OUTPARAM.Acid
	else
		BANCS.INPUT.depAccId = ""
	endif
	sv_d = " tranId,tranDate,valueDate,tranAmount | select tran_id,tran_date,value_date,tran_amt "
	sv_d = sv_d + " from tbaadm.dtt "
	sv_d = sv_d + " where bank_id=?SVAR "
	sv_d = sv_d + " and del_flg='N' " 
	sv_d = sv_d + " and flow_code='PI' "
	sv_d = sv_d + " and part_tran_type='C' "
	sv_d = sv_d + " and acid=?SVAR "
        sv_d = sv_d + " and part_tran_srl_num in (select max(part_tran_srl_num) "
        sv_d = sv_d + " from tbaadm.dtt "
        sv_d = sv_d + " where bank_id=?SVAR "
        sv_d = sv_d + " and del_flg='N' " 
        sv_d = sv_d + " and flow_code='PI' "
        sv_d = sv_d + " and part_tran_type='C' "
        sv_d = sv_d + " and acid=?SVAR) "
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.depAccId  + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.INPUT.depAccId 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	print(sv_u)
	if(sv_u == 0)then
		BANCS.OUTPUT.lvTranId = TRIM(BANCS.OUTPARAM.tranId)
		BANCS.OUTPUT.lvtranDate = BANCS.OUTPARAM.tranDate
		BANCS.OUTPUT.lvvalueDate = BANCS.OUTPARAM.valueDate
		BANCS.OUTPUT.lvtranAmount = BANCS.OUTPARAM.tranAmount
	else
		BANCS.OUTPUT.lvTranId = " " 
		BANCS.OUTPUT.lvtranDate = " "
		BANCS.OUTPUT.lvvalueDate = " "
		BANCS.OUTPUT.lvtranAmount = " " 
	endif
	exitscript
trace off
end-->

