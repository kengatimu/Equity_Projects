<--START
CHECKSUM="7eed1f088274091fc223ff521a0fd575084fdcc8da825ff4d272b852df426c0b"
	TRACE ON
	
	#-----------------------------------------------------------------------------------------------
	# Creating Repository
	# Initializing the variables
	# Getting all the values from CPARAM
	#-----------------------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","EOD") == 0) THEN
	#{
		CREATECLASS("CUST","EOD", 5)
	#}
	ENDIF
	
	CUST.EOD.errMsg     = ""
	CUST.EOD.drAcctNo   = ""
	CUST.EOD.crAcctNo   = ""
	CUST.EOD.drClrBal   = ""
	CUST.EOD.appFee     = ""
	CUST.EOD.totalAmt   = ""
	CUST.EOD.tranParts  = ""
	CUST.EOD.tranRmks   = ""
	CUST.EOD.refNumCr   = ""
	CUST.EOD.refNumDr   = ""
	
	BANCS.INPUT.moduleName = "EOD_CHARGES"
	BANCS.INPUT.parameterId = "DR_ACCT_NO"
	CALL ("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EOD.drAcctNo = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EOD.drAcctNo)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "CPARAM setup not done for Debit account number"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EOD_CHARGES"
	BANCS.INPUT.parameterId = "CR_ACCT_NO"
	CALL ("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EOD.crAcctNo = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EOD.crAcctNo)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "CPARAM setup not done for Credit account number"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EOD_CHARGES"
	BANCS.INPUT.parameterId = "TRAN_PARTS"
	CALL("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.EOD.tranParts = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EOD.tranParts)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "CPARAM setup not done for Trans Particulars"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EOD_CHARGES"
	BANCS.INPUT.parameterId = "TRAN_RMKS"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EOD.tranRmks = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EOD.tranRmks)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "CPARAM setup not done for Trans Remarks"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EOD_CHARGES"
	BANCS.INPUT.parameterId = "REF_NUM_CR"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EOD.refNumCr = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EOD.refNumCr)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "CPARAM setup not done for Ref Number for Credit"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EOD_CHARGES"
	BANCS.INPUT.parameterId = "REF_NUM_DR"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EOD.refNumDr = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EOD.refNumDr)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "CPARAM setup not done for Ref Number for Debit"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	CALL ("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.EOD.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.EOD.refCode)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "NORRATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#   Clear balance of debit account no
	#---------------------------------------------------------------------------
	sv_s=""
	sv_s = sv_s + " clrDrBal|"
	sv_s = sv_s + " SELECT GAM.clr_bal_amt"
	sv_s = sv_s + " FROM tbaadm.GAM"
	sv_s = sv_s + " WHERE GAM.foracid = ?SVAR"
	sv_s = sv_s + " AND GAM.bank_id   =	?SVAR"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.EOD.drAcctNo+ "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbselectWithBind(sv_s)
	
	IF (sv_d == 0) THEN
	#{
		CUST.EOD.drClrBal=BANCS.OUTPARAM.clrDrBal
		PRINT(CUST.EOD.drClrBal)
		#}
	ELSE
		#{
		CUST.EOD.errMsg = "Unable to get the clear balance of the debit account"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CDOUBLE(CUST.EOD.drClrBal)==0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------
	#   Charges collected (appFee),Total amount of debit acct
	#------------------------------------------------------------------------------------
	sv_s=""
	sv_s = sv_s + " appFee,totalAmt|"
	sv_s = sv_s + " SELECT (count(1)*(24.2)),sum(tran_amt)"
	sv_s = sv_s + " FROM tbaadm.GAM, tbaadm.DTD "
	sv_s = sv_s + " WHERE GAM.acid = DTD.acid"
	sv_s = sv_s + " AND GAM.bank_id = DTD.bank_id"
	sv_s = sv_s + " AND GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND DTD.part_tran_type = 'C'"
	sv_s = sv_s + " AND DTD.PSTD_FLG='Y'"
	sv_s = sv_s + " AND DTD.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.EOD.drAcctNo + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbselectWithBind(sv_s)
	
	IF (sv_d == 0) THEN
	#{
		CUST.EOD.totalAmt=BANCS.OUTPARAM.totalAmt
		CUST.EOD.appFee=BANCS.OUTPARAM.appFee
		PRINT(CUST.EOD.totalAmt)
		PRINT(CUST.EOD.appFee)
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(CUST.EOD.totalAmt)
	
	IF ((CDOUBLE(CUST.EOD.appFee)==0) AND (CDOUBLE(CUST.EOD.totalAmt)==0)) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#---------------------------------------------------------------
	# Passing transaction inputs to the service
	# Adding and Posting the transaction
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.EOD.tranRmks)
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	#-----------------------------------------------------
	# Add partTran0 (credit)
	#-----------------------------------------------------
	sv_a = "tranDtl.partTranDetailLL.<rec_0>."
	sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|1")
	sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|C")
	sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.EOD.crAcctNo)
	sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.EOD.appFee+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|"+CUST.EOD.tranParts)
	sv_u = urhk_SetUrhkInp(sv_a + "refNum|"+CUST.EOD.refNumCr)
	sv_u = urhk_SetUrhkInp(sv_a + "tranRmks|"+CUST.EOD.tranRmks)
	sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.EOD.appFee+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.EOD.refCode)
	
	#---------------------------------------------------------
	# Add partTran1  (debit)
	#---------------------------------------------------------
	
	sv_b = "tranDtl.partTranDetailLL.<rec_1>."
	sv_u = urhk_SetUrhkInp(sv_b + "key.serial_num|2")
	sv_u = urhk_SetUrhkInp(sv_b + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_b + "partTranType.code|D")
	sv_u = urhk_SetUrhkInp(sv_b + "acctId.foracid|"+CUST.EOD.drAcctNo)
	sv_u = urhk_SetUrhkInp(sv_b + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_b + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_b + "tranAmt|"+CUST.EOD.appFee+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_b + "tranParticulars|"+CUST.EOD.tranParts)
	sv_u = urhk_SetUrhkInp(sv_b + "refNum|"+CUST.EOD.refNumDr)
	sv_u = urhk_SetUrhkInp(sv_b + "tranRmks|"+CUST.EOD.tranRmks)
	sv_u = urhk_SetUrhkInp(sv_b + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_b + "refAmt|"+CUST.EOD.appFee+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_b + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_b + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_b + "rateCode.refCode|" + CUST.EOD.refCode)
	
	sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
		PRINT(sv_u)
	#}
	ENDIF
	
	IF (sv_u == 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			PRINT(sv_u)
			IF (sv_u != 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
	#{
		PRINT(BANCS.OUTPARAM.tranId)
	#}
	ENDIF
	
	ENDOFSCRIPT :
		
		IF (CUST.EOD.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.EOD.errMsg+"' >>BILCG.log")
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
END-->
