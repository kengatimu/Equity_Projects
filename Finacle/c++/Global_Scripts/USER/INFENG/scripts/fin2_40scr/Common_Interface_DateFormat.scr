#----------------------------------------------------------------------------------------------------------
# Filename		:	Common_Interface_DateFormat.scr
# Author		:	Venkatesh
# Description	:	This script is a common change date format script.
#					This take the input date in FI format "YYYY-MM-DDTHH:MM:SS.SSS" and converts it into
#					desired format
# Input			: 	COMMON.INPUT.inpDate, COMMON.INPUT.dateFmt
# Output		: 	COMMON.OUTPUT.convDateFmt, BANCS.OUTPUT.successOrFailure, BANCS.INPUT.ErrorCode
# Called Script	: 	This will be called by all veripark scripts when there is a validation failure.
# Calling Script:	None
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----	          --------	  		 ----------------        ---------
#  1           09-04-2013    	Deepak Joghee		Original Version          1.0
#----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="6da5c8fcb577e53f0ae5c8b78844f4c76bd564c9640526e19d9fecb8b6c21576"
	TRACE ON
	
	# Expected format of date in the input "2011-00-10T15:31:47.518"
	print(COMMON.INPUT.inpDate)
	IF(COMMON.INPUT.inpDate != "") THEN
	#{
		sv_a =  COMMON.INPUT.inpDate
		sv_z="T"
		sv_u = GETPOSITION(sv_a,"T")
		IF (sv_u == 0 ) THEN
		#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR022"
			GOTO ERROREXIT
			#}
		ELSE
			#{
			sv_z = Left$(sv_a,(sv_u -1))
			print(sv_z)
			BANCS.OUTPUT.convDate = sv_z
			COMMON.OUTPUT.convDate = BANCS.OUTPUT.convDate
		#}
		ENDIF
		#----------------------------------------------------------------
		# Validate the Day/Month/Year passed in the input date
		#----------------------------------------------------------------
		COMMON.INPUT.tempDateString = COMMON.INPUT.inpDate
		#------------------------------------------------------------
		# Fetching Year from Input date
		#------------------------------------------------------------
		sv_p = GETPOSITION(COMMON.INPUT.tempDateString,"-")
		COMMON.INPUT.year = LEFT$(COMMON.INPUT.tempDateString,sv_p-1)
		print(COMMON.INPUT.year)
		sv_r = urhk_B2k_isStringNumeric(COMMON.INPUT.year)
		IF(sv_r == 0) THEN
		#{
			print(COMMON.INPUT.year)
			IF((CINT(COMMON.INPUT.year) > CINT("2099")) OR (CINT(COMMON.INPUT.year) < CINT("2000")) OR (COMMON.INPUT.year == "")) THEN
			#{
				print(COMMON.INPUT.year)
				CUST.INTERFACE.successOrFailure = "F"
				CUST.INTERFACE.errorCode = "ERR022"
				GOTO ERROREXIT
				
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR022"
			GOTO ERROREXIT
		#}
		ENDIF
		COMMON.INPUT.tempDateString = RIGHT$(COMMON.INPUT.tempDateString,STRLEN(COMMON.INPUT.tempDateString)- sv_p)
		print(COMMON.INPUT.tempDateString)
		#------------------------------------------------------------
		# Fetching Month from Input date
		#------------------------------------------------------------
		sv_p = GETPOSITION(COMMON.INPUT.tempDateString,"-")
		COMMON.INPUT.month = LEFT$(COMMON.INPUT.tempDateString,sv_p-1)
		print(COMMON.INPUT.month)
		COMMON.INPUT.tempDateString = RIGHT$(COMMON.INPUT.inpDate,STRLEN(COMMON.INPUT.tempDateString)- sv_p)
		print(COMMON.INPUT.tempDateString)
		sv_r = urhk_B2k_isStringNumeric(COMMON.INPUT.month)
		IF(sv_r == 0) THEN
		#{
			print(CINT(COMMON.INPUT.month))
			IF((CINT(COMMON.INPUT.month) > CINT("12")) OR (COMMON.INPUT.month == "")) THEN
			#{
				CUST.INTERFACE.successOrFailure = "F"
				CUST.INTERFACE.errorCode = "ERR022"
				GOTO ERROREXIT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR022"
			GOTO ERROREXIT
		#}
		ENDIF
		#------------------------------------------------------------
		# Fetching Day from Input date
		#------------------------------------------------------------
		sv_p = GETPOSITION(COMMON.INPUT.tempDateString,"T")
		print(sv_p)
		COMMON.INPUT.day = LEFT$(COMMON.INPUT.tempDateString,sv_p-1)
		print(COMMON.INPUT.day)
		sv_r = urhk_B2k_isStringNumeric(COMMON.INPUT.day)
		IF(sv_r == 0) THEN
		#{
			IF((CINT(COMMON.INPUT.day) > CINT("31")) OR (COMMON.INPUT.day == "")) THEN
			#{
				CUST.INTERFACE.successOrFailure = "F"
				CUST.INTERFACE.errorCode = "ERR022"
				GOTO ERROREXIT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR022"
			GOTO ERROREXIT
		#}
		ENDIF
	#}
	ENDIF
	
	IF(COMMON.INPUT.dateFmt != "" )  THEN
	#{
		sv_s = "outDate|SELECT to_char(to_date( ?SVAR ,'YYYY-MM-DD'), ?SVAR ) FROM DUAL"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = COMMON.OUTPUT.convDate + "|" + COMMON.INPUT.dateFmt
		
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		
		IF(sv_d != 0) THEN
		#{
			CUST.INTERFACE.successOrFailure = "F"
			CUST.INTERFACE.errorCode = "ERR022"
			GOTO ERROREXIT
			#}
		ELSE
			#{
			COMMON.OUTPUT.convDateFmt = BANCS.OUTPARAM.outDate
			print(COMMON.OUTPUT.convDateFmt)
			
		#}
		ENDIF
	#}
	ENDIF
	
END-->
