<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_a = "rm -f ebblkLacls.lst"
        sv_a = system(sv_a)
        sv_a = "touch ebblkLacls.lst"
        sv_a = system(sv_a)
        sv_d = "acctNum,opAcid | select gam.foracid,(select foracid from tbaadm.gam where acid=lam.op_acid) "
        sv_d = sv_d + "from tbaadm.gam,tbaadm.lam "
        sv_d = sv_d + "where gam.acid=lam.acid "
        ###sv_d = sv_d + "and gam.foracid in(select foracid from custom.zero_laa) "
        sv_d = sv_d + "and gam.bank_id=?SVAR "
        sv_d = sv_d + "and lam.bank_id=?SVAR "
	sv_d = sv_d + "and gam.sol_id in (select sol_id from tbaadm.sst where set_id=?SVAR and bank_id=?SVAR)"
        sv_d = sv_d + "and lam.final_disb_flg='Y' "
        sv_d = sv_d + "and gam.clr_bal_Amt =0 "
        sv_d = sv_d + "and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acct_cls_flg<>'Y' "
	sv_d = sv_d + "order by gam.cif_id,gam.foracid "
        print(sv_d)
 	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId

        print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(sv_d)
        if(sv_u==0)then
                EQSRV.GLBDATA.zeroLaaCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif
        EQSRV.GLBDATA.zeroLaRec = 0
        sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.zeroLaaCurNum)
        if(sv_z!=0)then
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
                sv_a = BANCS.OUTPARAM.acctNum
                sv_o = BANCS.OUTPARAM.opAcid
                sv_a = BANCS.OUTPARAM.acctNum + "|" + BANCS.OUTPARAM.opAcid
                sv_q = "echo '" + sv_a + "' >> ebblkLacls.lst"
                print(sv_q)
                sv_s = system(sv_q)
                print(sv_s)
                sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.zeroLaaCurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.zeroLaaCurNum)
                        print(sv_u)
                        EQSRV.GLBDATA.srvErrMsg =  "Cota Cursor Fetch Failed"
                        EQSRV.GLBDATA.srvErrCode = "DBCursor"
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto VAYURUN
                endif
                EQSRV.GLBDATA.zeroLaRec = cint(EQSRV.GLBDATA.zeroLaRec) + 1
                EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.zeroLaRec
                print(EQSRV.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.zeroLaaCurNum)
        print(sv_u)
        VAYURUN:
        sv_s = "echo $B2K_SESSION_ID"
        print(system(sv_s))
        sv_n = "5"
        sv_a = "nohup exebatch -n "+sv_n+" -i ebblkLacls.lst babx4061 $B2K_SESSION_ID ebLaaClsRun.scr @s"
        sv_r = system(sv_a)
VAYU:
        sv_a = "rm -f *.DAT"
        sv_r = system(sv_a)
        exitscript
trace off
end-->
