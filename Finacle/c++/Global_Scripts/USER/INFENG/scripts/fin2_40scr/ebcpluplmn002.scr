<--start
trace on
	LIBNAME CUSTOMSO
	if (repexists("CUST") == 0) then
		createrep("CUST")
	endif
	if (classexists("CUST","GLBDATA") == 0) then
		createclass("CUST","GLBDATA",5)
	endif
	if (classexists("CUST","CPARAM") == 0) then
		createclass("CUST","CPARAM",5)
	endif
#Initialiizing required variables
	CUST.GLBDATA.errMsg = ""
	CUST.GLBDATA.fileName 	= 	BANCS.INPUT.fileName
	CUST.GLBDATA.Function 	=	BANCS.INPUT.funcCode
	CUST.GLBDATA.TranYN 	= BANCS.INPUT.TranYN	
	CUST.GLBDATA.TranRemarks 	= BANCS.INPUT.TranRemarks	
	CUST.GLBDATA.ChargeType 	= BANCS.INPUT.ChargeType	
	CUST.GLBDATA.userWorkClass	=	BANCS.STDIN.userWorkClass
	print(CUST.GLBDATA.fileName)
	print(CUST.GLBDATA.Function)
	###sv_u = urhk_B2K_PrintRepos("BANCS")
	##print(sv_u)
	if(CUST.GLBDATA.TranYN=="")then
		CUST.GLBDATA.TranYN = "Y"
	endif
#load
	if (CUST.GLBDATA.Function=="U") then
	#{
		#callscriptifexist("ebcplupldp001.scr")
		#if (CUST.GLBDATA.errMsg != "") then
		#	sv_e = CUST.GLBDATA.errMsg
		#	sv_m = "funcCode"
		#	sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		#	sv_u = urhk_SetOrbOut(sv_e)
		#	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		#	goto ENDOFSCRIPT
		#endif
		#CUST.GLBDATA.headOfficeSolId = CUST.CPARAM.homeSolId
		#print(CUST.GLBDATA.headOfficeSolId)
		#print(BANCS.STDIN.mySolId)
		#if (BANCS.STDIN.mySolId != CUST.GLBDATA.headOfficeSolId)  then
		#	CUST.GLBDATA.errMsg = "Upload can be done only from head office"
		#	sv_e = CUST.GLBDATA.errMsg
		#	sv_m = "funcCode"
		#	sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		#	sv_u = urhk_SetOrbOut(sv_e)
		#	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		#	goto ENDOFSCRIPT
		#endif
	#}
	endif
#to get file name 
	sv_s = "fileName1 |"
	sv_s = sv_s + " select substr('"+ CUST.GLBDATA.fileName +"',instr('"+ CUST.GLBDATA.fileName +"' ,'\',-1)+1) "
	sv_s = sv_s + " from dual "
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	if (sv_d == 0) then
	#{
		CUST.GLBDATA.fileName1 = BANCS.OUTPARAM.fileName1
		print(CUST.GLBDATA.fileName1)
	else
		sv_e = "File is Missing"
		sv_m = "fileName"
		CUST.GLBDATA.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		print(CUST.GLBDATA.errMsg)
		goto FAILURE
	#}
	endif
#extensions(.csv)
	print(CUST.GLBDATA.fileName1)
	sv_b = "."
	sv_c = getposition(CUST.GLBDATA.fileName1, sv_b)
	print(sv_c)
	if (sv_c!=CINT("0")) then
		sv_z = STRLEN(CUST.GLBDATA.fileName1)
		print(sv_z)
		sv_e = MID$(CUST.GLBDATA.fileName1,sv_c,sv_z)
		print(sv_e)
		CUST.GLBDATA.extn = sv_e
		print(CUST.GLBDATA.extn)
	endif
	if((CUST.GLBDATA.extn == "csv") OR (CUST.GLBDATA.extn == "CSV")) then
		print("extensions of filename is correct")
	else
		sv_e = "Sorry.., Please enter only csv extension file for uploading"
		sv_m = "fileName"
		CUST.GLBDATA.errMsg  = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		print(CUST.GLBDATA.errMsg)
		goto FAILURE
	endif
#Client Machine to Unix
	callscriptifexist("ebcplupldp004.scr")
	sv_j = " sleep 20 "
	print(sv_j)
	sv_g = system(sv_j)
	print(sv_g)
#temp file creation
	if((CUST.GLBDATA.extn == "csv") OR (CUST.GLBDATA.extn == "CSV")) then
		CUST.GLBDATA.fileName2 = "TMP_" + CUST.GLBDATA.fileName1
		sv_s = "sed 's/,/|/g' " + CUST.GLBDATA.fileName1 + " > " + CUST.GLBDATA.fileName2
		print(sv_s)
		sv_a = system(sv_s)
		print(sv_a)
		CUST.GLBDATA.fileName1 = CUST.GLBDATA.fileName2
	endif
#Read file
	print(CUST.GLBDATA.fileName1)
	sv_o = urtn_fileOpen(CUST.GLBDATA.fileName1 + "|r")
	print(sv_o)
	
	if (sv_o == 0) then
		sv_d = "batchId | select to_char(sysdate,'ddmmyyyyhhmiss') from dual "
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.GLBDATA.batchId = BANCS.OUTPARAM.batchId 
			CUST.GLBDATA.batchId = "PESALINKB_" + CUST.GLBDATA.batchId
		else
			CUST.GLBDATA.batchId = "PESALINKB_" 
		endif
		sv_o = urtn_fileClose(sv_o)
		print(sv_o)
		sv_s = "nohup babx4061 $B2K_SESSION_ID ebcplupldp002.scr"
		sv_s = sv_s + " '" + CUST.GLBDATA.fileName1 + "'"
		sv_s = sv_s + " '" + CUST.GLBDATA.Function + "'"
		sv_s = sv_s + " '" + CUST.GLBDATA.TranYN + "'"
		sv_s = sv_s + " '" + CUST.GLBDATA.batchId + "'"
		sv_s = sv_s + " '" + CUST.GLBDATA.ChargeType + "'"
		sv_s = sv_s + " @s &"
		print(sv_s)
		sv_x = system(sv_s)
		print(sv_x)
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_z)
		sv_z = "RESULT_MSG|Upload Process Initiated Successfully - Check status in HPR after some time !Batch Id " + CUST.GLBDATA.batchId
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		goto ENDOFSCRIPT
	else
		sv_e = "Sorry.., Please enter only csv extension file for uploading"
		sv_m = "fileName"
		CUST.GLBDATA.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
		print(CUST.GLBDATA.errMsg)
		goto ENDOFSCRIPT
	endif
	
FAILURE:
	sv_z = "SuccessOrFailure|N"
	print(sv_z)
	sv_u = urhk_SetOrbOut(sv_z)
	print(sv_u)
	sv_z = CUST.GLBDATA.errMsg
	print(sv_z)
	sv_u = urhk_SetOrbOut(sv_z)
	print(sv_u)
ENDOFSCRIPT:
	exitscript
#trace off
end-->
		
		
