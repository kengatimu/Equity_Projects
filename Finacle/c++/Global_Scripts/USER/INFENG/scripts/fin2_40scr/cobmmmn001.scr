#------------------------------------------------------------------------------------------------    
#    Name			 : cobmmmn001.scr
#    Description     : The script is used Block/Unblock the solid.
#    Date            : 28-02-2013
#    Author          : Prakash
#    Input           : NA
#    Output			 : NA
#    Called Script	 : NA
#    Calling Script	 : NA
#    Menu Option	 : COBMM
#    Srl. No			Date			Author			Description.
#    ------			----------			-------			---------------
#    1.0			28-02-2013			Prakash			Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="575523c372eb4a039f9f1741726c5ed182ff1d354b46fdf5eabe236a90431755"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "OFFBRMT") == 0) THEN
	#{
		CREATECLASS("CUST", "OFFBRMT", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.solId)
	PRINT(BANCS.INPUT.frmDate)
	PRINT(BANCS.INPUT.toDate)
	
	CUST.OFFBRMT.funcCode = BANCS.INPUT.funcCode
	CUST.OFFBRMT.Sol	 = BANCS.INPUT.solId
	CUST.OFFBRMT.frmDate = BANCS.INPUT.frmDate
	CUST.OFFBRMT.toDate  = BANCS.INPUT.toDate
	CUST.OFFBRMT.errMsg = ""
	
	#---------------------------------------------------------------------------
	#	The following  step is to  validate SolID
	#---------------------------------------------------------------------------
	
	sv_u = urhk_B2k_valSolId(CUST.OFFBRMT.Sol)
	print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_e = "Invalid solid"
		sv_m = "solId"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	# The following step is to Validate Date
	#--------------------------------------------------------------------------
	
	sv_r = urhk_B2k_valDate(CUST.OFFBRMT.toDate)
	IF (sv_r != 0) THEN
	#{
		sv_e = "Invalid Date  "
		sv_m = "Date"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	sv_r = urhk_B2k_valDate(CUST.OFFBRMT.frmDate)
	IF (sv_r != 0) THEN
	#{
		sv_e = "Invalid Date  "
		sv_m = "Date"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	
	
	PRINT(BANCS.STDIN.BODDate)
	
	IF ((CUST.OFFBRMT.frmDate != left$(BANCS.STDIN.BODDate,10)) AND (CUST.OFFBRMT.funcCode == "B")) THEN
	#{
		sv_e = "Date should be equal to BOD Date"
		sv_m = "Date"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_B2K_getDateDiffFromBODDate(CUST.OFFBRMT.toDate)
	PRINT(sv_u)
	sv_f = cdouble(BANCS.OUTPARAM.DateDiff)
	PRINT(sv_f)
	IF (sv_f < 0) THEN
	#{
		sv_e = "To Date should be greater THEN  BOD Date"
		sv_m = "toDate_ui"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------
	#Process Starting
	#---------------------------------------------------------------------------
	
	IF (CUST.OFFBRMT.funcCode == "B") THEN
	#{
		
		sv_s = "Count|SELECT COUNT(*) FROM CUSTOM.C_OBM "
		sv_s = sv_s + "WHERE sol_id = ?SVAR "
		sv_s = sv_s + "AND mbm_date = To_date(?SVAR ,'DD-MM-YYYY')"
		sv_s = sv_s + "AND mbm_status ='B'"
		sv_s = sv_s + "AND del_flg = 'N'"
		sv_s = sv_s + "AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.OFFBRMT.Sol + "|" + CUST.OFFBRMT.frmDate + "|" + BANCS.STDIN.contextBankId
		PRINT(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.Count)
			IF (CINT(BANCS.OUTPARAM.Count) != 0) THEN
			#{
				
				
				sv_e = "This sol is already blocked"
				sv_m = "Date"
				sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				
				sv_s = "INSERT INTO CUSTOM.C_OBM VALUES("
				sv_s = sv_s + "?SVAR,"
				sv_s = sv_s + "to_date(?SVAR,'DD-MM-YYYY'),"
				sv_s = sv_s + "'B',"
				sv_s = sv_s + "?SVAR,"
				sv_s = sv_s + "SYSDATE,"
				sv_s = sv_s + "?SVAR,"
				sv_s = sv_s + "SYSDATE,"
				sv_s = sv_s + "'N',"
				sv_s = sv_s + "?SVAR)"
				BANCS.INPARAM.BINDVARS = CUST.OFFBRMT.Sol + "|" + CUST.OFFBRMT.frmDate + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
				PRINT(sv_s)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				PRINT(sv_d)
				
				sv_d = urhk_dbSQLWithBind("COMMIT")
				
				
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG| The Sol ID  <b>" + CUST.OFFBRMT.Sol + "</b>" + " is blocked"
				sv_z = urhk_SetOrbOut(sv_g)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.OFFBRMT.funcCode == "U") THEN
	#{
		sv_s = "Count|SELECT count(*) FROM CUSTOM.C_OBM "
		sv_s = sv_s + "WHERE sol_id = ?SVAR "
		sv_s = sv_s + "AND mbm_date = to_date(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + "AND mbm_status = 'B' "
		sv_s = sv_s + "AND del_flg = 'N' "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.OFFBRMT.Sol + "|" + CUST.OFFBRMT.frmDate + "|"+BANCS.STDIN.contextBankId
		PRINT(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		
		IF (sv_d == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.Count)
			
			IF (CINT(BANCS.OUTPARAM.Count) != 0) THEN
			#{
				sv_s = "UPDATE CUSTOM.C_OBM SET mbm_status='U',del_flg='Y' "
				sv_s = sv_s + "WHERE sol_id = ?SVAR "
				sv_s = sv_s + "AND mbm_date = to_date(?SVAR,'DD-MM-YYYY') "
				sv_s = sv_s + "AND mbm_status = 'B' "
				sv_s = sv_s + "AND del_flg = 'N' "
				sv_s = sv_s + "AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.OFFBRMT.Sol + "|" + CUST.OFFBRMT.frmDate + "|"+BANCS.STDIN.contextBankId
				PRINT(sv_s)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				PRINT(sv_d)
				sv_d = urhk_dbSQLWithBind("COMMIT")
				PRINT(sv_d)
				
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG| The Sol ID  <b>" + CUST.OFFBRMT.Sol + "</b>" + " is unblocked"
				sv_z = urhk_SetOrbOut(sv_g)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				
				sv_e = "This sol id is not yet blocked "
				sv_m = "Date"
				sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACEOF
END-->
