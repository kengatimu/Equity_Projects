	sv_a = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|T" )
	sv_a = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|BI")
	sv_a = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" + CUST.CIECLG.chargeEventId)
	sv_a = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" +CUST.CIECLG.chargeAmtCcy)
	sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.CIECLG.chargeAmtCcy)
	sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.CIECLG.chrgDebitAcct)
	
