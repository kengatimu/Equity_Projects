        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctGeneralInfo.acctBasic.acctTurnoverDetFlg|trnOvrflg")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.minIntPcntCr|minIntCrPcnt")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.minIntPcntDr|minIntDrPcnt")
