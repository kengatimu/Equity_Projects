        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.maxIntPcntDr|maxIntDrPcnt")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.peggedFlg|pegFlg")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.pegReviewDate|pegDte")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.wtaxFlg.code|wtaxCode")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.schmLvlWtaxPcnt|wtaxPcnt")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.schmLvlWtaxFloorLimit|wtaxFlrLmt")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqCr.startDd|intCrFrStDte")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqCr.type|intCrFrType")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqCr.hldyStat|intCrFrHolStat")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqDr.type|intDrFrType")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqDr.startDd|intDrFrStDte")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqDr.hldyStat|intDrFrHolStat")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctGeneralInfo.acctCustInfo.staffId.empId|staffId")
        sv_a = urhk_setUrhkout(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctGeneralInfo.acctCustInfo.relativeStaffId.empId|relativeStaffId")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.dailyCompIntFlg.code|dailyCompIntFlg")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.compRestInd|compRestInd")
        sv_u = urhk_ExecSrv("SRV_FetchDfltODAcctDtls|retain_all_output = Y")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        else
                sv_s = "X"
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
        #{
                print(BANCS.OUTPARAM.cashLimit)
                        EBSRV.GLBDATA.cashLimit = BANCS.OUTPARAM.cashLimit
