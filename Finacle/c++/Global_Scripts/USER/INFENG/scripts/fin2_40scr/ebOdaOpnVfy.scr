<--start
trace on
#Reps/Class
#++++++++++
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("ONS")==0)then
		createrep("ONS")
	endif
	if(classexists("ONS","CUSTOM")==0)then
		createclass("ONS","CUSTOM",5)
	endif
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
#Inp
#+++
	EBSRV.GLBDATA.srvErrCode = ""
	EBSRV.GLBDATA.srvErrMsg = "" 
	EBSRV.GLBDATA.srvSucFail = ""
	BANCS.INPUT.solId = BANCS.STDIN.mySolId 
        EBSRV.GLBDATA.CustName          = ""
        EBSRV.GLBDATA.CustShortName      = ""
        EBSRV.GLBDATA.NextPrintDate      = BANCS.STDIN.BODDate
	EBSRV.GLBDATA.NextPrintDate      = "22-05-2020 00:00:00"
        EBSRV.GLBDATA.PanGirNum                 = ""
        EBSRV.GLBDATA.SchemeType        = "ODA"
        EBSRV.GLBDATA.accMaturityDate   = ""
        EBSRV.GLBDATA.accOpnDate        = BANCS.STDIN.BODDate
        EBSRV.GLBDATA.acctName          = ""
        EBSRV.GLBDATA.cashCrLimit       = ""
        EBSRV.GLBDATA.cashLimit         = ""
        EBSRV.GLBDATA.ccyCode           = "KES"
        EBSRV.GLBDATA.clgCrLim          = ""
        EBSRV.GLBDATA.clgExpLim         = ""
        EBSRV.GLBDATA.compRestInd       = ""
        EBSRV.GLBDATA.cifId             = ""
        EBSRV.GLBDATA.dailyCompIntFlg    = ""
        EBSRV.GLBDATA.dfltType          = "dfltODAcctDtl"
        EBSRV.GLBDATA.documentDate      = BANCS.STDIN.BODDate
        EBSRV.GLBDATA.drawingPowerInd    = "E"
        EBSRV.GLBDATA.drawingPowerPcnt   = ""
        EBSRV.GLBDATA.dsaId             = ""
        EBSRV.GLBDATA.expiryDate        = "24-03-2099 00:00:00"
        EBSRV.GLBDATA.glsubHead         = ""
        EBSRV.GLBDATA.healthCode        = "NML"
        EBSRV.GLBDATA.intAmt            = ""
        EBSRV.GLBDATA.intColFlg         = "Y"
        EBSRV.GLBDATA.intCrncy          = ""
        EBSRV.GLBDATA.intCrncyRate      = ""
        EBSRV.GLBDATA.intPdFlg          = "N"
        EBSRV.GLBDATA.intRate           = ""
        EBSRV.GLBDATA.intTblCode        = ""
        EBSRV.GLBDATA.limitIdPrefix      = ""
        EBSRV.GLBDATA.limitIdSuffix      = ""
        EBSRV.GLBDATA.maxAlwdAdvnLim     = ""
        EBSRV.GLBDATA.mesgSeperator     = ""
        EBSRV.GLBDATA.messageField      = ""
        EBSRV.GLBDATA.minbal            = ""
        EBSRV.GLBDATA.modeofOperation    = "SELF"
        EBSRV.GLBDATA.nextIntRunDateCr   = BANCS.STDIN.BODDate
        EBSRV.GLBDATA.nextIntRunDateDr   = BANCS.STDIN.BODDate
        EBSRV.GLBDATA.sanctDate         = BANCS.STDIN.BODDate
        EBSRV.GLBDATA.sanctionAuthCode   = "OTH"
        EBSRV.GLBDATA.sanctionLevelCode  = "OTHER"
        EBSRV.GLBDATA.sanctionLimit      = "0|KES"
        EBSRV.GLBDATA.sanctionRefNum     = "AGENTLIM"
        EBSRV.GLBDATA.schemeCode        = "OD541"
        EBSRV.GLBDATA.sentMsg           = ""
        EBSRV.GLBDATA.serChrgColFlg      = "N"
        EBSRV.GLBDATA.solId             = ""
        EBSRV.GLBDATA.tmpAccNo          = ""
        EBSRV.GLBDATA.trnOvrflg         = "Y"
        EBSRV.GLBDATA.xferCrLim         = ""
        EBSRV.GLBDATA.xfexLim           = ""
        EBSRV.GLBDATA.FAcid             = ""
	sv_e = urhk_B2k_PID("")
	print(BANCS.OUTPARAM.PID)
	EBSRV.GLBDATA.errid = BANCS.OUTPARAM.PID
	sv_y = BANCS.OUTPARAM.PID+"_ODAOPEN.RPT"
#Data 
#++++
        sv_d = "cifId,schmCnt,schmCode,solId |select cif_id,count(schm_code),schm_code,sol_id from tbaadm.gam where bank_id=?SVAR "
        sv_d = sv_d + " and schm_code in ('SB126','CA207') "
        sv_d = sv_d + " and acct_ownership<>'O' "
        sv_d = sv_d + " and del_flg='N' "
        sv_d = sv_d + " and entity_cre_flg='Y' "
        sv_d = sv_d + " and acct_cls_flg='N' "
	sv_d = sv_d + " and cif_id not in (select cif_id from tbaadm.gam  where bank_id=?SVAR and schm_type='ODA' and schm_code='OD541') "
	##sv_d = sv_d + " and sol_id='003' "
	###sv_d = sv_d + " and cif_id='54200001091' "
	###sv_d = sv_d + " and sol_id in (select sol_id from tbaadm.sst where set_id=?SVAR and bank_id=?SVAR ) "
        sv_d = sv_d + " and rownum<=300 "
        sv_d = sv_d + " group by cif_id,schm_code,sol_id "
        sv_d = sv_d + " order by cif_id,schm_code,sol_id "
        print(sv_d)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
        ##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	sv_u = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.racoCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		EBSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE	
		EBSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG 
		EBSRV.GLBDATA.srvSucFail = "F"
		goto VAYU
	endif	
	EBSRV.GLBDATA.racoRec = 0
	print(EBSRV.GLBDATA.racoCurNum)
	sv_z = urhk_dbCursorFetch(EBSRV.GLBDATA.racoCurNum)
	if(sv_z!=0)then
		EBSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE	
		EBSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG 
		EBSRV.GLBDATA.srvSucFail = "F"
		goto VAYU
	endif
	print(sv_z)
	while(sv_z ==0)
	##{ vploop starts
	#+++++++++++++++++
		print("traco loop in")
                        EBSRV.GLBDATA.cifId = BANCS.OUTPARAM.cifId
                        EBSRV.GLBDATA.schmCnt = BANCS.OUTPARAM.schmCnt
                        EBSRV.GLBDATA.shmCode = BANCS.OUTPARAM.schmCode
                        EBSRV.GLBDATA.solId = BANCS.OUTPARAM.solId
			######
			IF (EBSRV.GLBDATA.solId != BANCS.STDIN.mySolId) THEN
				print(BANCS.STDIN.mySolId)
				sv_u = urhk_SetUrhkInp("sol.solId|"+EBSRV.GLBDATA.solId)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
				print(BANCS.STDIN.mySolId)
			ENDIF
			######
			sv_q=urhk_B2k_CifIdToCustId(EBSRV.GLBDATA.cifId)
			if(sv_q==0)then
				EBSRV.GLBDATA.CustId = BANCS.OUTPARAM.CustId
			else
				EBSRV.GLBDATA.CustId = ltrim(BANCS.OUTPARAM.CustId,54)
			endif
                        sv_u = urhk_getCustomerDetails(EBSRV.GLBDATA.cifId)
                        print(sv_u)
                        if(sv_u==0)then
                                EBSRV.GLBDATA.CustName     = BANCS.OUTPARAM.CustName
                                EBSRV.GLBDATA.CustShortName = BANCS.OUTPARAM.CustShortName
                                EBSRV.GLBDATA.acctName = BANCS.OUTPARAM.CustName
                        else
                                EBSRV.GLBDATA.CustName  = ""
                                EBSRV.GLBDATA.CustShortName = ""
                                EBSRV.GLBDATA.acctName = ""
                        endif
			sv_d = "poolCnt | select count(*) from tbaadm.pft where bank_id=?SVAR "
			sv_d = sv_d + " and entity_cre_flg='Y' and del_flg='N' and pool_owner_cust_id=?SVAR "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CustId
			print(sv_d)
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EBSRV.GLBDATA.poolCnt = BANCS.OUTPARAM.poolCnt
			else
				EBSRV.GLBDATA.poolCnt = "0"
			endif
			
			sv_d = "odCnt | select count(*) from tbaadm.gam where cif_id=?SVAR and bank_id=?SVAR "
			sv_d = sv_d + " and schm_code='OD541' and del_flg='N' and entity_cre_flg='Y' and acct_cls_flg<>'Y' "
			print(sv_d)
			BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.cifId + "|" + BANCS.STDIN.contextBankId
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EBSRV.GLBDATA.odCnt = BANCS.OUTPARAM.odCnt
			else
				EBSRV.GLBDATA.odCnt = "0"
			endif
		#++++++++++
		#Sweep
		#++++++++++
			sv_d = "sweepYN,cStmtreq,poCeilCy| select allow_sweeps,combined_stmt_reqd,po_stp_ceil_crncy from tbaadm.ccmg "
			sv_d = sv_d + " where cif_id=?SVAR and bank_id=?SVAR "
			sv_d = sv_d + "  and entity_cre_flg='Y' " 
			BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.cifId + "|" + BANCS.STDIN.contextBankId
			print(sv_d)
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EBSRV.GLBDATA.sweepYN = BANCS.OUTPARAM.sweepYN
				EBSRV.GLBDATA.cStmtreq = BANCS.OUTPARAM.cStmtreq
				EBSRV.GLBDATA.poCeilCy = BANCS.OUTPARAM.poCeilCy
			else
				EBSRV.GLBDATA.sweepYN = "0"
				EBSRV.GLBDATA.cStmtreq = "N" 
				EBSRV.GLBDATA.poCeilCy = "" 
			endif
			if((EBSRV.GLBDATA.sweepYN=="N") or (EBSRV.GLBDATA.sweepYN==""))then
				callscriptifexist("ebCcfmMoVfy.scr")
				if(fieldexists(EBSRV.GLBDATA.srvErrCode)==1)then
					if(EBSRV.GLBDATA.srvErrCode!="CCFMS")then
						sv_d = "update tbaadm.ccmg set allow_sweeps='Y' "
						sv_d = sv_d + " where bank_id=?SVAR "
						sv_d = sv_d + " and cif_id=?SVAR "
						print(sv_d)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.cifId
						print(BANCS.INPARAM.BINDVARS)
						sv_u = urhk_dbSqlWithBind(sv_d)
						if(sv_u==0)then
							sv_u = urhk_dbSqlWithBind("commit")
							EBSRV.GLBDATA.srvErrMsg = ""
							EBSRV.GLBDATA.srvErrCode = ""
							EBSRV.GLBDATA.srvSucFail = ""
							print("ccfm success")	
							EBSRV.GLBDATA.cPoolYN="Y"	
						endif
						if(sv_u!=0)then	
							goto NXTLP	
						endif
					else
						EBSRV.GLBDATA.srvErrMsg = ""
						EBSRV.GLBDATA.srvErrCode = ""
						EBSRV.GLBDATA.srvSucFail = ""
						print("ccfm success")	
						EBSRV.GLBDATA.cPoolYN="Y"	
					endif
				endif
			else
				EBSRV.GLBDATA.cPoolYN="Y"	
			endif
			print(EBSRV.GLBDATA.poolCnt)
			print(EBSRV.GLBDATA.odCnt)
			print(EBSRV.GLBDATA.cPoolYN)
			if (cdouble(EBSRV.GLBDATA.odCnt)>=1)then
				if(cdouble(EBSRV.GLBDATA.poolCnt) <=0)then
					if(EBSRV.GLBDATA.cPoolYN=="Y")then	
					sv_a = "nohup babx4061 $B2K_SESSION_ID ebOdaAgntPool.scr "+EBSRV.GLBDATA.cifId+" @s &"
					sv_a = system(sv_a)
					else
					goto NXTLP
					endif
				else
					goto NXTLP
				endif
			endif
			if(cdouble(EBSRV.GLBDATA.odCnt)>=1)then
					goto NXTLP
			endif
		#ContextSol
		#++++++++++
			print(BANCS.STDIN.mySolId)
			print(EBSRV.GLBDATA.solId)
			if ( BANCS.STDIN.mySolId != EBSRV.GLBDATA.solId ) then
				sv_u = urhk_SetUrhkInp("sol.solId|" +EBSRV.GLBDATA.solId)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
					print(BANCS.OUTPARAM.successOrFailure)
					sv_s = BANCS.OUTPARAM.successOrFailure
				else
					sv_s = "X"
				endif
				if (( sv_u != 0 ) and ( sv_s != "S"))then
					EBSRV.GLBDATA.srvErrMsg	=	"CCS Failed"
					EBSRV.GLBDATA.srvErrCode = "Failed : SRV_ModifyContextSol " 
					EBSRV.GLBDATA.srvSucFail = "F"
					goto NXTLP
				endif
			endif
        sv_a = urhk_SetUrhkInp("acctCriteria.custId.cifId|"+EBSRV.GLBDATA.cifId)
        sv_a = urhk_SetUrhkInp("acctCriteria.schmCode.schmCode|"+EBSRV.GLBDATA.schemeCode)
        sv_a = urhk_SetUrhkInp("acctCriteria.crncyCode.crncyCode|"+EBSRV.GLBDATA.ccyCode)
        sv_a = urhk_SetUrhkInp("acctCriteria.solId.solId|"+EBSRV.GLBDATA.solId)
        sv_a = urhk_SetUrhkInp("acctCriteria.glSubHeadCode.solId|"+EBSRV.GLBDATA.solId)
        sv_a = urhk_SetUrhkInp("acctCriteria.glSubHeadCode.crncyCode|"+EBSRV.GLBDATA.ccyCode)
#output
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.glSubHeadCode|glsubHead")
