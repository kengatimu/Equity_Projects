        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctGeneralInfo.acctCustInfo.servChrgCollFlg|serChrgColFlg")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.intPaidFlg|intPdFlg")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctInterestTax.intCollFlg|intColFlg")
        sv_a = urhk_SetUrhkOut(EBSRV.GLBDATA.dfltType+".acctCommonInfo.acctGeneralInfo.acctCustInfo.custConstDesc|custConst")
