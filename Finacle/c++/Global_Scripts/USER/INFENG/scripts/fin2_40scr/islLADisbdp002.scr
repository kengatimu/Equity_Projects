				#{
					lv_a = BANCS.OUTPARAM.Acid
					print(lv_a)
				#}
				ENDIF
				BANCS.INPARAM.BINDVARS = lv_a + "|" + BANCS.STDIN.contextBankId
				lv_s = "assetPurAcct|SELECT COM_PUR_ACID FROM TBAADM.MPA WHERE PURCHASE_REF = ?SVAR"
