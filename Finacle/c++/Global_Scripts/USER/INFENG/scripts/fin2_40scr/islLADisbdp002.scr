					MTT.PartTranDetails.TreaRate = MTT.InputDetails.tranTreaRate
					MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.tranTreaRefNum
					MTT.PartTranDetails.Rate = MTT.InputDetails.tranRate
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="disbursement"
					MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
					MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
					MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
					lv_z = urhk_MTTS_DefineLoanPartTran("DISBDEBIT")
					print(lv_z)
					
					MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Customer Operative A/c Debit"
					IF(CUST.ISL.Reversal == "Y")THEN
					#{
						MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Asset Purchase A/c Reversal Debit"
					#}
					ENDIF
					
					MTT.PartTranDetails.Account=lv_c
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.GlDate=MTT.InputDetails.glDate
					MTT.PartTranDetails.RefAmount=lv_t
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.disburseCrncy
					MTT.PartTranDetails.RateCode = MTT.InputDetails.tranRateCode
					MTT.PartTranDetails.TreaRate = MTT.InputDetails.tranTreaRate
					MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.tranTreaRefNum
					MTT.PartTranDetails.Rate = MTT.InputDetails.tranRate
					MTT.PartTranDetails.Consolidate="N"
