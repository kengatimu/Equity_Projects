			lv_t = (lv_l-lv_i+lv_m-lv_r-lv_s)
			print(lv_t)
			
			MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Builder A/c Credit"
			IF(CUST.ISL.Reversal == "Y")THEN
			#{
				lv_t = -lv_l+lv_i-lv_m+lv_r+lv_s
				print(lv_t)
				MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Builder A/c Reversal Debit"
			#}
			ENDIF
			
			lv_a = ""
			lv_b = ""
			lv_c = ""
			lv_a = MTT.InputDetails.loanAcct
			
			lv_u = urhk_B2k_ForacidToAcid(MTT.InputDetails.loanAcct)
			print(lv_u)
			IF(lv_u == 0)THEN
			#{
				lv_a = BANCS.OUTPARAM.Acid
				print(lv_a)
			#}
			ENDIF
			
			BANCS.INPARAM.BINDVARS = lv_a + "|" + BANCS.STDIN.contextBankId
			IF(CUST.ISL.comTranReqFlg == "Y")THEN
			#{
				lv_s = "builderAcct|SELECT COM_PUR_ACID FROM TBAADM.MPA WHERE PURCHASE_REF = ?SVAR"
				#}
			ELSE
				#{
				lv_s = "builderAcct|SELECT BUILDER_ACCT FROM TBAADM.LI_LAM WHERE ACID = ?SVAR"
			#}
			ENDIF
			lv_s = lv_s + " AND BANK_ID = ?SVAR"
			print(lv_s)
			lv_d = urhk_dbSelectWithBind(lv_s)
			print(lv_d)
			IF(lv_d == 0)THEN
			#{
				lv_b = BANCS.OUTPARAM.builderAcct
				print(lv_b)
				lv_u = urhk_B2k_AcidToForacid(lv_b)
				IF(lv_u == 0)THEN
				#{
					lv_c = BANCS.OUTPARAM.Foracid
					print(lv_c)
					MTT.PartTranDetails.Account=lv_c
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.GlDate=MTT.InputDetails.glDate
					MTT.PartTranDetails.RefAmount=lv_t
					print(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.disburseCrncy
					MTT.PartTranDetails.RateCode = MTT.InputDetails.tranRateCode
					MTT.PartTranDetails.TreaRate = MTT.InputDetails.tranTreaRate
					MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.tranTreaRefNum
					MTT.PartTranDetails.Rate = MTT.InputDetails.tranRate
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="disbursement"
					MTT.PartTranDetails.PTranBusinessType="DISBURSEMENT"
					MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
					MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
					lv_z = urhk_MTTS_DefineLoanPartTran("DISBCREDIT")
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		GOTO ENDOFSCRIPT
		
		###########################################################################################
		
	ENDOFSCRIPT:
		
