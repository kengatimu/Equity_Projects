	MURABAHA_3:
		
		IF(MTT.InputDetails.islamicLoanFlg == "I")THEN
		#{
			IF(MTT.InputDetails.isMURABAHAFlg == "Y")THEN
			#{
				###################################################################################################
				# Find the Asset Purchase Account
				###################################################################################################
				
				lv_a = ""
				lv_b = ""
				lv_c = ""
				lv_u = urhk_B2k_ForacidToAcid(MTT.InputDetails.loanAcct)
