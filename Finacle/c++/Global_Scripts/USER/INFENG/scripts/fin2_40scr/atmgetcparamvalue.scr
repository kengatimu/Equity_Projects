<--start
#trace on

IF (BANCS.INPUT.parameterId == "") THEN
#{
	print("Invalid Value passed")
	BANCS.OUTPUT.successOrFailure = "F"
	BANCS.OUTPUT.RespCode = "99"
	GOTO ENDOFSCR
#}
ENDIF

BANCS.OUTPUT.parameterVal = ""

#### Caching the CPARAM Codes
# WILL BE CACHED INTO ENV VARIABLES, IF ENV IS NULL THEN DB SELECT
# IS DONE. THIS IS DONE TO AVOID DB PROCESSING FOR EVERY REQUEST

BANCS.INPUT.envName = BANCS.INPUT.parameterId
print(BANCS.INPUT.envName)
sv_r = urhk_getEnv(BANCS.INPUT.envName)
print(sv_r)
IF (sv_r == 0) THEN
#{
	BANCS.OUTPUT.parameterVal = BANCS.OUTPARAM.envValue
	print(BANCS.OUTPUT.parameterVal)
#}
ELSE
#{
	sv_s = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER"
	sv_s = sv_s + " WHERE "
	sv_s = sv_s + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
	sv_s = sv_s + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
	sv_s = sv_s + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
	sv_s = sv_s + " C_CPMASTER.bank_id = ?SVAR AND "
	sv_s = sv_s + " C_CPMASTER.module_name = ?SVAR AND "
	sv_s = sv_s + " C_CPVALUE.parameter_id = ?SVAR"
	print(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.moduleName + "|" + BANCS.INPUT.parameterId
	print(BANCS.INPARAM.BINDVARS)

	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)

	IF(sv_d == 0) THEN
	#{
        print(BANCS.OUTPARAM.parameterVal)
        BANCS.OUTPUT.parameterVal = BANCS.OUTPARAM.parameterVal
		BANCS.INPUT.envName = BANCS.INPUT.parameterId
		sv_a = BANCS.INPUT.envName + "|" + TRIM(BANCS.OUTPUT.parameterVal)
		print(sv_a)

		sv_r = urhk_putEnv(BANCS.INPUT.envName + "|" + TRIM(BANCS.OUTPUT.parameterVal))
		print(sv_r)

		sv_a = SYSTEM("export " + BANCS.INPUT.envName)
		print(sv_a)
	#}
	ELSE
	#{
		print(BANCS.OUTPARAM.DB_ERRCODE)
		print("Error during execution of urhk_dbselect, returning SYSTEM MALFUNCTION RESPONSE  ")
		BANCS.OUTPUT.RespCode = "98"
		BANCS.OUTPUT.successOrFailure = "F"	
	#}
	ENDIF

#}
ENDIF
		
ENDOFSCR:
exitscript

end-->
