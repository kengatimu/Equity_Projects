<--START
CHECKSUM="31de7fab266dc9c4ca2fe1ca9034d4ee86a25bfaf7f51a073819688d85bb5722"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.ieTxnRefNo = ""
	CUST.CIETXN.tranAmtInHardCcy = ""
	CUST.CIETXN.hardCcy = ""
	CUST.CIETXN.chargeAmtInUsd = ""
	CUST.CIETXN.outgoingCPAccount = ""
	CUST.CIETXN.chargeAmtInHardCcy = ""
	CUST.CIETXN.currentDateTime = ""
	CUST.CIETXN.countryName = ""
	CUST.CIETXN.reportFileName = ""
	CUST.CIETXN.successOrFailure = ""
	CUST.CIETXN.errorMsg = ""
	
	###########################################################################################
	# Get system date-time and clear report file
	###########################################################################################
	
	sv_s = "currentDateTime|SELECT TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS') FROM DUAL"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.currentDateTime = BANCS.OUTPARAM.currentDateTime
		PRINT(CUST.CIETXN.currentDateTime)
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "KES")THEN
	#{
		CUST.CIETXN.countryName = "KENYA"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "UGX")THEN
	#{
		CUST.CIETXN.countryName = "UGANDA"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "SSP")THEN
	#{
		CUST.CIETXN.countryName = "SUDAN"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "RWF")THEN
	#{
		CUST.CIETXN.countryName = "RWANDA"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "TZS")THEN
	#{
		CUST.CIETXN.countryName = "TANZANIA"
	#}
	ENDIF
	
	CUST.CIETXN.reportFileName = "CIETXN_CW_" + CUST.CIETXN.countryName + "_SETTLEMENT2_" + CUST.CIETXN.currentDateTime + ".LST"
	PRINT(CUST.CIETXN.reportFileName)
	
	sv_s = "> "+  CUST.CIETXN.reportFileName
	sv_a = SYSTEM(sv_s)
	PRINT(sv_a)
	
	
	
	###########################################################################################
	# Get Entity2-Central Vostro Account
	###########################################################################################
	CUST.CIETXN.parameterId = "ENTITY2_CENTRAL_VOSTRO"
	CUST.CIETXN.flag1="1"
	PRINT(CUST.CIETXN.parameterId)
	
	sv_s = "entity2CentralVostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find the Parameter value for " + CUST.CIETXN.parameterId
		CUST.CIETXN.flag1="0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.entity2CentralVostroAcct = BANCS.OUTPARAM.entity2CentralVostroAcct
	PRINT(CUST.CIETXN.entity2CentralVostroAcct)
	
	IF(TRIM(CUST.CIETXN.entity2CentralVostroAcct) == "")THEN
	#{
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "The Parameter value for " + CUST.CIETXN.parameterId + " cannot be NULL"
		CUST.CIETXN.flag1="0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	
	
	
	###########################################################################################
	# Fetch Records which are Eligible for Settlement
	###########################################################################################
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	lv_s = "ieTxnRefNo,initEntityId,targetEntityId,tranAmtInHardCcy,hardCcy,chargeAmtInUsd,outgoingCPAccount|"
	lv_s = lv_s + " SELECT IE_TXN_REF_NO,INIT_ENTITY_ID,TARGET_ENTITY_ID,TRAN_AMT_IN_HARD_CCY,HARD_CRNCY_CODE,CHARGE_AMT_IN_USD,OUT_CP_ACCOUNT_ID"
	lv_s = lv_s + " FROM CUSTOM.IECWD"
	lv_s = lv_s + " WHERE TARGET_ENTITY_ID = ?SVAR"
	lv_s = lv_s + " AND NVL(ENTITY2_SETTLEMENT_STATUS,'X') != 'S' "
	lv_s = lv_s + " AND IE_TXN_REF_NO not in (select IE_TXN_REF_NO from CUSTOM.IETD where REVERSE_FLG='Y')"
	PRINT(lv_s)
	
	lv_c = urhk_dbCursorOpenWithBind(lv_s)
	PRINT(lv_c)
	
	IF(lv_c != 0)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	lv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(lv_n)
	
	lv_f = urhk_dbCursorFetch(lv_n)
	PRINT(lv_f)
	
	lv_i = 1
	
	WHILE(lv_f == 0)
	#{
		CUST.CIETXN.flag2="1"
		CUST.CIETXN.entity2SettlementStatus = "F"
		CUST.CIETXN.entity2SettlementTranId = ""
		CUST.CIETXN.entity2SettlementTranDate = ""
		CUST.CIETXN.errorMsg = ""
		
		CUST.CIETXN.ieTxnRefNo = BANCS.OUTPARAM.ieTxnRefNo
		PRINT(CUST.CIETXN.ieTxnRefNo)
		
		CUST.CIETXN.initEntityId = BANCS.OUTPARAM.initEntityId
		PRINT(CUST.CIETXN.initEntityId)
		
		CUST.CIETXN.targetEntityId = BANCS.OUTPARAM.targetEntityId
		PRINT(CUST.CIETXN.targetEntityId)
		
		CUST.CIETXN.tranAmtInHardCcy = BANCS.OUTPARAM.tranAmtInHardCcy
		PRINT(CUST.CIETXN.tranAmtInHardCcy)
		
		CUST.CIETXN.hardCcy = BANCS.OUTPARAM.hardCcy
		PRINT(CUST.CIETXN.hardCcy)
		
		CUST.CIETXN.chargeAmtInUsd = BANCS.OUTPARAM.chargeAmtInUsd
		PRINT(CUST.CIETXN.chargeAmtInUsd)
		
		CUST.CIETXN.outgoingCPAccount = BANCS.OUTPARAM.outgoingCPAccount
		PRINT(CUST.CIETXN.outgoingCPAccount)
		
		CUST.CIETXN.targetEntityName = ""
		
		
		IF(CUST.CIETXN.targetEntityId == "54")THEN
		#{
			CUST.CIETXN.targetEntityName = "KENYA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "56")THEN
		#{
			CUST.CIETXN.targetEntityName = "UGANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "11")THEN
		#{
			CUST.CIETXN.targetEntityName = "SUDAN"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "50")THEN
		#{
			CUST.CIETXN.targetEntityName = "RWANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "55")THEN
		#{
			CUST.CIETXN.targetEntityName = "TANZANIA"
		#}
		ENDIF
		
		
		
		#----------------------------------------------------------------------------------------
		# Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		BANCS.INPUT.inputBacid = CUST.CIETXN.entity2CentralVostroAcct
		BANCS.INPUT.inputCcy   = CUST.CIETXN.hardCcy
		BANCS.INPUT.inputSolID = BANCS.STDIN.mySolId
		BANCS.INPUT.inputBankId = BANCS.STDIN.contextBankId
		
		CALL("bacidtoacid.scr")
		CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
		PRINT(CUST.CIETXN.outputForacid)
		
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find the Account ID for "+CUST.CIETXN.entity2CentralVostroAcct
			CUST.CIETXN.flag2="0"
			GOTO NEXTFETCH1
		#}
		ENDIF
		
		CUST.CIETXN.entity2CentralVostroAcct = CUST.CIETXN.outputForacid
		PRINT(CUST.CIETXN.entity2CentralVostroAcct)
		
		#-----------------------------------------------------------------
		# Get charge Amt in Hard Ccy
		#-----------------------------------------------------------------
		
		IF(CUST.CIETXN.hardCcy != "USD")THEN
		#{
			#Convert to Hard Ccy
			#currently assigned with usd value
			CUST.CIETXN.chargeAmtInHardCcy = CUST.CIETXN.chargeAmtInUsd
			#}
		ELSE
			#{
			CUST.CIETXN.chargeAmtInHardCcy = CUST.CIETXN.chargeAmtInUsd
			PRINT(CUST.CIETXN.chargeAmtInHardCcy)
		#}
		ENDIF
		
		#-----------------------------------------------------------------
		# Create Transaction
		#-----------------------------------------------------------------
		
		CUST.CIETXN.refCrncy = ""
		CUST.CIETXN.crAcct1 = ""
		CUST.CIETXN.drAcct1 = ""
		CUST.CIETXN.refAmt = ""
		CUST.CIETXN.refNoCr = ""
		CUST.CIETXN.refNoDr = ""
		CUST.CIETXN.tranParticularCr = ""
		CUST.CIETXN.tranParticularDr = ""
		CUST.CIETXN.tranRmksCr = ""
		CUST.CIETXN.tranRmksDr = ""
		
		CUST.CIETXN.refCrncy = CUST.CIETXN.hardCcy
		CUST.CIETXN.crAcct1 = CUST.CIETXN.entity2CentralVostroAcct
		CUST.CIETXN.drAcct1 = CUST.CIETXN.outgoingCPAccount
		CUST.CIETXN.refAmt = CDOUBLE(CUST.CIETXN.tranAmtInHardCcy) +  CDOUBLE(CUST.CIETXN.chargeAmtInHardCcy)
		CUST.CIETXN.tranParticularCr = "IECW - " + CUST.CIETXN.targetEntityName + " SETTLEMENT"
		CUST.CIETXN.tranParticularDr = "IECW - " + CUST.CIETXN.targetEntityName + " SETTLEMENT"
		CUST.CIETXN.tranRmksCr = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.tranRmksDr = CUST.CIETXN.ieTxnRefNo
		
		PRINT(CUST.CIETXN.refCrncy)
		PRINT(CUST.CIETXN.crAcct1)
		PRINT(CUST.CIETXN.drAcct1)
		PRINT(CUST.CIETXN.refAmt)
		
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
		sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
		
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|C")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+CUST.CIETXN.refAmt+"|"+ CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+CUST.CIETXN.crAcct1)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refNum|"+CUST.CIETXN.refNoCr)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+CUST.CIETXN.tranParticularCr)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+CUST.CIETXN.tranRmksCr)
		
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|D")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.CIETXN.refAmt+"|"+ CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.CIETXN.drAcct1)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|"+CUST.CIETXN.refNoDr)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+CUST.CIETXN.tranParticularDr)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|"+CUST.CIETXN.tranRmksDr)
		
		sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
		sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
		
		sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
		PRINT(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			
			sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF(sv_u != 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.Fatal_num)
			PRINT(BANCS.OUTPARAM.Error_num)
			PRINT(BANCS.OUTPARAM.Warning_num)
			PRINT(BANCS.OUTPARAM.UserInfo_num)
			PRINT(BANCS.OUTPARAM.Xcpn_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Xcpn_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
			
			sv_d = 1
			sv_c = CINT(BANCS.OUTPARAM.Error_num)
			sv_b = ""
			WHILE (sv_d <= sv_c)
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_b)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_a)
				
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + sv_b + sv_a
				
				sv_d = sv_d + 1
				sv_d = sv_c + 1
			#}
			DO
			
			PRINT(CUST.CIETXN.errorMsg)
			
			lv_u = urhk_dbSqlWithBind("ROLLBACK")
			PRINT(lv_u)
			
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.tranId)
		PRINT(BANCS.OUTPARAM.tranDate)
		
		sv_u = urhk_CopyOutToIn("")
		PRINT(sv_u)
		
		sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
		sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
		
		sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
		PRINT(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			
			sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
			PRINT(sv_u)
		#}
		ENDIF
		
		IF(sv_u != 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.Fatal_num)
			PRINT(BANCS.OUTPARAM.Error_num)
			PRINT(BANCS.OUTPARAM.Warning_num)
			PRINT(BANCS.OUTPARAM.UserInfo_num)
			PRINT(BANCS.OUTPARAM.Xcpn_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Xcpn_num)
			PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
			
			sv_d = 1
			sv_c = CINT(BANCS.OUTPARAM.Error_num)
			sv_b = ""
			WHILE (sv_d <= sv_c)
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_b)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_a)
				
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + sv_b + sv_a
				
				sv_d = sv_d + 1
				sv_d = sv_c + 1
			#}
			DO
			
			PRINT(CUST.CIETXN.errorMsg)
			
			lv_u = urhk_dbSqlWithBind("ROLLBACK")
			PRINT(lv_u)
			
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.tranId)
		PRINT(BANCS.OUTPARAM.tranDate)
		
		CUST.CIETXN.entity2SettlementStatus = "S"
		CUST.CIETXN.entity2SettlementTranId = BANCS.OUTPARAM.tranId
		CUST.CIETXN.entity2SettlementTranDate = MID$(BANCS.OUTPARAM.tranDate,0,10)
		
		PRINT(CUST.CIETXN.entity2SettlementStatus)
		PRINT(CUST.CIETXN.entity2SettlementTranId)
		PRINT(CUST.CIETXN.entity2SettlementTranDate)
		
		lv_u = urhk_dbSqlWithBind("COMMIT")
		PRINT(lv_u)
		
		#-----------------------------------------------------------------
		# Update IECWD Table
		#-----------------------------------------------------------------
		
		NEXTFETCH:
			
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.entity2SettlementStatus
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CIETXN.entity2SettlementTranId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CIETXN.entity2SettlementTranDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CIETXN.entity2CentralVostroAcct
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CIETXN.ieTxnRefNo
			PRINT(BANCS.INPARAM.BINDVARS)
			
			lv_s = "UPDATE CUSTOM.IECWD SET "
			lv_s = lv_s + " ENTITY2_SETTLEMENT_STATUS = ?SVAR,"
			lv_s = lv_s + " ENTITY2_SETTLEMENT_TRAN_ID = ?SVAR,"
			lv_s = lv_s + " ENTITY2_SETTLEMENT_TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY'),"
			lv_s = lv_s + " ENTITY2_VOSTRO_ACCOUNT_ID = ?SVAR"
			lv_s = lv_s + " WHERE IE_TXN_REF_NO = ?SVAR"
			PRINT(lv_s)
			
			lv_d = urhk_dbSqlWithBind(lv_s)
			PRINT(lv_d)
			
			IF(lv_d != 0)THEN
			#{
				CUST.CIETXN.entity2SettlementStatus = "F"
				CUST.CIETXN.errorMsg = "Update Operation Failed ON Custom Table"
			#}
			ENDIF
			
			IF(CUST.CIETXN.entity2SettlementStatus == "S")THEN
			#{
				CUST.CIETXN.successOrFailure = "SUCCESS"
				#}
			ELSE
				#{
				CUST.CIETXN.successOrFailure = "FAILURE"
			#}
			ENDIF
			
			lv_u = urhk_dbSqlWithBind("COMMIT")
			PRINT(lv_u)
			
			CUST.CIETXN.outRecord = CUST.CIETXN.ieTxnRefNo
			CUST.CIETXN.outRecord = CUST.CIETXN.outRecord + "|" + CUST.CIETXN.successOrFailure
			CUST.CIETXN.outRecord = CUST.CIETXN.outRecord + "|" + CUST.CIETXN.errorMsg
		NEXTFETCH1:
			IF(CUST.CIETXN.flag2=="0")THEN
			#{
				CUST.CIETXN.outRecord = CUST.CIETXN.ieTxnRefNo
				CUST.CIETXN.outRecord = CUST.CIETXN.outRecord + "|" + CUST.CIETXN.errorMsg
			#}
			ENDIF
			
			sv_s = "echo '" + CUST.CIETXN.outRecord + "' >> " + CUST.CIETXN.reportFileName
			sv_a = SYSTEM(sv_s)
			PRINT(sv_a)
			
			lv_f = urhk_dbCursorFetch(lv_n)
			PRINT(lv_f)
			
		#}
		DO
		
		lv_c = urhk_dbCursorClose(lv_n)
		PRINT(lv_c)
		
	ENDOFSCRIPT:
		IF(CUST.CIETXN.flag1=="0")THEN
		#{
			CUST.CIETXN.outRecord = CUST.CIETXN.errorMsg
			sv_s = "echo '" + CUST.CIETXN.outRecord + "' >> " + CUST.CIETXN.reportFileName
			sv_a = SYSTEM(sv_s)
			PRINT(sv_a)
		#}
		ENDIF
		
END-->
