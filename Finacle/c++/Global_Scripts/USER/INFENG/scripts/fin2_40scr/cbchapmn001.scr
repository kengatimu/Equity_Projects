<--START
CHECKSUM="18354ef91e6ee8618c3b8df690f351d75bb9bd9ea8f0787836caf7aade5487d3"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "BNKCQPR") == 0) THEN
	#{
		CREATECLASS("CUST", "BNKCQPR", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.solId)
	PRINT(BANCS.INPUT.test)
	PRINT(BANCS.INPUT.remrks)
	
	CUST.BNKCQPR.test     = BANCS.INPUT.test
	CUST.BNKCQPR.remarks  = BANCS.INPUT.remrks
	CUST.BNKCQPR.ttumsal_mod = ""
	CUST.BNKCQPR.Rename = ""
	
	
	BANCS.INPUT.moduleName = "CBCHAP"
	BANCS.INPUT.parameterId = "FILENAME"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.BNKCQPR.processfile = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.BNKCQPR.errMsg = "Process file setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate test flag
	#---------------------------------------------------------------------------
	
	PRINT(CUST.BNKCQPR.test)
	
	IF (CUST.BNKCQPR.test == "") THEN
	#{
		sv_e = "The test flag should be entered"
		sv_m = "Test"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF ((CUST.BNKCQPR.test != "Y") AND (CUST.BNKCQPR.test != "N")) THEN
		#{
			sv_e = "Inavlid test flag  'Y' OR 'N' "
			sv_m = "Test"
			sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#	The foll step is to Validate remarks
	#---------------------------------------------------------------------------
	
	PRINT(CUST.BNKCQPR.remarks)
	
	IF (CUST.BNKCQPR.remarks == "") THEN
	#{
		sv_e = "Remarks should be entred"
		sv_m = "Test"
		sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------
	#checking if file exists and overiding
	#-----------------------------------------------------------------------------
	
	PRINT(CUST.BNKCQPR.processfile)
	sv_a = "test -f " + CUST.BNKCQPR.processfile
	sv_r = SYSTEM(sv_a)
	PRINT(sv_r)
	IF (sv_r == 0) THEN
	#{
		sv_s = "rm -f " + CUST.BNKCQPR.processfile
		sv_r = SYSTEM(sv_s)
		
		IF (sv_r != 0) THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Technical Error - Com file for loading a file^upldFileName")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------
	# Checking if their is any record for Processing
	#-----------------------------------------------------------------------------
	
	sv_s = "count|"
	sv_s = sv_s + "SELECT COUNT(1) "
	sv_s = sv_s + "FROM CUSTOM.FIN_DD_UPLOAD_TABLE "
	sv_s = sv_s + "WHERE processed_flag = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	CUST.BNKCQPR.count = BANCS.OUTPARAM.count
	PRINT(CUST.BNKCQPR.count)
	
	IF (CINT(CUST.BNKCQPR.count) == 0 ) THEN
	#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG| No Record is for Processing "
		sv_z = urhk_SetOrbOut(sv_g)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		#---------------------------------------------------------------------------
		# Processing the data
		#---------------------------------------------------------------------------
		
		IF (CUST.BNKCQPR.test == "Y") THEN
		#{
			CUST.BNKCQPR.ttumsal_mod = "T"
			CUST.BNKCQPR.Rename = "N"
			#}
		ELSE
			#{
			CUST.BNKCQPR.ttumsal_mod = "P"
			CUST.BNKCQPR.Rename = "Y"
		#}
		ENDIF
		
		CUST.BNKCQPR.comfile="bankersAp.com"
		
		sv_x = urhk_getFileLocation("COM|" + CUST.BNKCQPR.comfile )
		PRINT(sv_x)
		
		sv_l = BANCS.OUTPARAM.fileLocation
		PRINT(sv_l)
		
		PRINT(CUST.BNKCQPR.ttumsal_mod)
		
		sv_t  =  sv_l + CUST.BNKCQPR.comfile + " " + BANCS.STDIN.contextBankId + " " + CUST.BNKCQPR.ttumsal_mod + " " + CUST.BNKCQPR.Rename + " " + CUST.BNKCQPR.remarks + " " + CUST.BNKCQPR.processfile
		
		PRINT(sv_t)
		
		sv_u =system(sv_t)
		print(sv_u)
		
		IF(sv_u != 0) THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Technical Error - Com file for loading a file^upldFileName")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		#}
		ENDIF
		
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG| File is  Uploaded Succesfully "
		sv_z = urhk_SetOrbOut(sv_g)
		
		ENDOFSCRIPT:
			
			TRACE OFF
			EXITSCRIPT
	END-->
	
	
