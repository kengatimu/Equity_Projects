	#-------------------------------------------------------------------------------
        # Converting the ZoneDate into the rquired format
        #-------------------------------------------------------------------------------
        lv_a = "zonedate|SELECT to_char(to_date('"+ CUST.INTERFACE.ZoneDate + "','DD-MM-YYYY HH24:MI:SS'),'DD-MM-YYYY HH24:MI:SS') from dual"
        print(lv_a)
        lv_b = urhk_dbSelectWithBind(lv_a)

        IF(lv_b == 0) THEN
        #{
                CUST.INTERFACE.ZoneDate = BANCS.OUTPARAM.zonedate
                print(CUST.INTERFACE.ZoneDate)
