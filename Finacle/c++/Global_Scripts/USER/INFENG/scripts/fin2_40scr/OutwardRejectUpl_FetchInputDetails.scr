	#-------------------------------------------------------------------------------
        # Fetching the inwardZone Code and outwardRejZone Code
        #-------------------------------------------------------------------------------
	
	lv_s = "oclgZoneDate,clgZoneCode,oSolId,oSetNum,oInstSrNum,oBankCode,oBrCode,oSortCode|"
	lv_s = lv_s + "SELECT TO_CHAR(CLG_ZONE_DATE,'DD-MM-YYYY HH24:MI:SS'),CLG_ZONE_CODE,SOL_ID,SET_NUM,INSTRMNT_SRL_NUM,BANK_CODE,BR_CODE,SORT_CODE"
