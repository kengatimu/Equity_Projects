<--START
CHECKSUM="e02a5a0afdf0349edd4491110f3f19cb5d174bb57484f2f02ea35b021ca6b3bd"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
	#{
		CREATECLASS("CUST","GCHRG",5)
	#}
	ENDIF
	
	sv_a=urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_a)
	
	BANCS.INPUT.moduleName = "CHARGES"
	BANCS.INPUT.parameterId = "BUNDLE_FEE1"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.DATA.bundlefee1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.DATA.bundlefee1)
		#}
	ELSE
		#{
		CUST.DATA.errMsg = "bundle fee amount setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "BUNDLE_FEE2"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.DATA.bundlefee2 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.DATA.bundlefee2)
		#}
	ELSE
		#{
		CUST.DATA.errMsg = "bundle fee amount setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
