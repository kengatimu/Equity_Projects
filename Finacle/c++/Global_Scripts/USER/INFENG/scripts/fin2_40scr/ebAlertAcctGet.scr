#  1.0             08-06-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
	callscriptifexist("ebRepClass.scr")
	
	EBSRV.GLBDATA.acctNum = " "
	EBSRV.GLBDATA.errorFlg = "N"
	EBSRV.GLBDATA.errorMsg = " "
	EBSRV.GLBDATA.acctNumEntityId = " "
	EBSRV.GLBDATA.acctNumSolId = " "
	EBSRV.GLBDATA.acctNumCcy = " "
	EBSRV.GLBDATA.acctName = " "
	EBSRV.GLBDATA.entityCreFlg = " "
	EBSRV.GLBDATA.acctClsFlg = " "
	EBSRV.GLBDATA.schmType = " "
	EBSRV.GLBDATA.cifIdForSig = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	if(fieldexists(BANCS.INPUT.acctNum))then
		if(TRIM(BANCS.INPUT.acctNum) != "")then
			EBSRV.GLBDATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
			print(EBSRV.GLBDATA.acctNum)
		endif
	else
		EBSRV.GLBDATA.errorFlg = "Y"
		EBSRV.GLBDATA.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	endif
	sv_s = "acctNumEntityId,acctNumSolId,acctNumCcy,acctName,entityCreFlg,acctClsFlg,schmType,cifId|"
	sv_s = sv_s + " select bank_id,sol_id,acct_crncy_code,acct_name,entity_cre_flg,acct_cls_flg,schm_type,cif_id"
	sv_s = sv_s + " from tbaadm.gam "
	sv_s = sv_s + " where foracid = ?SVAR"
	sv_s = sv_s + " and del_flg != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.acctNum
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	if(sv_d == 0)then
	#{
		EBSRV.GLBDATA.acctNumEntityId = BANCS.OUTPARAM.acctNumEntityId
		print(EBSRV.GLBDATA.acctNumEntityId)
		EBSRV.GLBDATA.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
		print(EBSRV.GLBDATA.acctNumSolId)
		EBSRV.GLBDATA.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
		print(EBSRV.GLBDATA.acctNumCcy)
		EBSRV.GLBDATA.acctName = BANCS.OUTPARAM.acctName
		print(EBSRV.GLBDATA.acctName)
		EBSRV.GLBDATA.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		print(EBSRV.GLBDATA.entityCreFlg)
		EBSRV.GLBDATA.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
		print(EBSRV.GLBDATA.acctClsFlg)
		EBSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
		print(EBSRV.GLBDATA.schmType)
		EBSRV.GLBDATA.cifIdForSig = BANCS.OUTPARAM.cifId
		print(EBSRV.GLBDATA.cifIdForSig)
		
		if(EBSRV.GLBDATA.entityCreFlg == "N")then
			EBSRV.GLBDATA.errorFlg = "Y"
			EBSRV.GLBDATA.errorMsg = "Account Creation Not Authorised"
			GOTO ENDOFSCRIPT
		endif
		if(EBSRV.GLBDATA.acctClsFlg == "Y")then
			EBSRV.GLBDATA.errorFlg = "Y"
			EBSRV.GLBDATA.errorMsg = "Account is closed"
			GOTO ENDOFSCRIPT
		endif
		if((EBSRV.GLBDATA.schmType != "SBA") AND (EBSRV.GLBDATA.schmType != "CAA") AND (EBSRV.GLBDATA.schmType != "CCA") AND (EBSRV.GLBDATA.schmType != "ODA"))then
			EBSRV.GLBDATA.errorFlg = "Y"
			EBSRV.GLBDATA.errorMsg = "Only SBA/CAA/CCA/ODA Type of Accounts are allowed"
			GOTO ENDOFSCRIPT
		endif
		
		
	else
		EBSRV.GLBDATA.errorFlg = "Y"
		EBSRV.GLBDATA.errorMsg = "Invalid Account ID"
	endif
	
ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+EBSRV.GLBDATA.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+EBSRV.GLBDATA.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumEntityId|"+EBSRV.GLBDATA.acctNumEntityId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumSolId|"+EBSRV.GLBDATA.acctNumSolId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumCcy|"+EBSRV.GLBDATA.acctNumCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctName|"+EBSRV.GLBDATA.acctName)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNum|"+EBSRV.GLBDATA.acctNum)
		print(sv_u)
		if(EBSRV.GLBDATA.cifIdForSig!="")then
		sv_u = urhk_SetOrbOut("cifIdForSig|"+EBSRV.GLBDATA.cifIdForSig)
		print(sv_u)
		endif
end-->
