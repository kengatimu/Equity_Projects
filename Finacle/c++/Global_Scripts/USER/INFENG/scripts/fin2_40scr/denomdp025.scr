	sv_s = sv_s + "AND CRNCY_CODE= ?SVAR "
	sv_s = sv_s + "AND teller_id= ?SVAR AND bank_id = ?SVAR"
	sv_s = sv_s + "ORDER BY Denom_Ind,"
	sv_s = sv_s + "Denom_Value DESC "
	print(sv_s)
	sv_j = urhk_dbCursorOpenWithBind(sv_s)
