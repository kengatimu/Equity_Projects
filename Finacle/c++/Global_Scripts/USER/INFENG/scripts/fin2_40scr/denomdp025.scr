						print(CUST.DENOM.NoteDenomVal)
						print(BANCS.OUTPARAM.DenomValue)
						IF(CUST.DENOM.MDNMIND=="N")THEN
						#{
							IF(CUST.DENOM.NoteDenomVal ==  BANCS.OUTPARAM.DenomValue)THEN
							#{
								print(CUST.DENOM.NoteDenomVal)
								CUST.DENOM.delFlg="N"
								CUST.DENOM.delFlgCoin="N"
							#}
							ENDIF
						#}
						ENDIF
						
					#}
					ELSE
					#{
						print(BANCS.OUTPARAM.DenomValue)
						print(CUST.DENOM.CoinDenomVal)
						IF(CUST.DENOM.MDNMIND=="C")THEN
						#{
							IF(CUST.DENOM.CoinDenomVal ==  BANCS.OUTPARAM.DenomValue)THEN
							#{
								
								print(CUST.DENOM.CoinDenomVal)
								CUST.DENOM.delFlgCoin="N"
								CUST.DENOM.delFlg="N"
							#}
							ENDIF
						#}
