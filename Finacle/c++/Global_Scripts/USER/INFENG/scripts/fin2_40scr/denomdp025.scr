				#---C_DENM_CR table-----
				
				BANCS.INPARAM.BINDVARS = sv_b +"|"+ CUST.DENOM.curr +"|"+ CUST.DENOM.NoteDenomVal +"|"+ CUST.DENOM.DENMIND +"|"+ sv_u + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				
				sv_v = "delete from C_DENM_CR "
				sv_v = sv_v + "WHERE sol_id=?SVAR "
				sv_v = sv_v + "AND crncy_code= ?SVAR "
				sv_v = sv_v + "AND denom_value=?SVAR "
				sv_v = sv_v + "AND denom_ind= ?SVAR "
				sv_v = sv_v+ "AND teller_id= ?SVAR AND bank_id = ?SVAR"
				print(sv_v)
				sv_x=urhk_dbsqlWithBind(sv_v)
				print(sv_x)
				
			#}
			ENDIF
			IF(CUST.DENOM.delFlgCoin=="Y")THEN
			#{
				print(CUST.DENOM.DENMIND)
				print(CUST.DENOM.CoinDenomVal)
				
				BANCS.INPARAM.BINDVARS = sv_b +"|"+ CUST.DENOM.curr +"|"+ CUST.DENOM.CoinDenomVal +"|"+ CUST.DENOM.DENMIND +"|"+ sv_u + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_v="delete from  C_DENM "
				sv_v=sv_v+" where sol_id= ?SVAR AND crncy_code= ?SVAR AND denom_value= ?SVAR AND denom_ind= ?SVAR "
				sv_v=sv_v+ " AND teller_id= ?SVAR AND bank_id = ?SVAR"
				print(sv_v)
				sv_x=urhk_dbsqlWithBind(sv_v)
				print(sv_x)
				
				
				#---C_DENM_DR table----
				
				BANCS.INPARAM.BINDVARS = sv_b +"|"+ CUST.DENOM.curr+"|"+ CUST.DENOM.CoinDenomVal +"|"+ CUST.DENOM.DENMIND+"|"+ sv_u + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_v="delete from  C_DENM_DR "
				sv_v=sv_v+" where sol_id= ?SVAR AND crncy_code= ?SVAR AND denom_value= ?SVAR AND denom_ind= ?SVAR "
				sv_v=sv_v+ " AND teller_id= ?SVAR AND bank_id = ?SVAR"
				print(sv_v)
				sv_x=urhk_dbsqlWithBind(sv_v)
				print(sv_x)
				
				#---C_DENM_CR table-----
				
				BANCS.INPARAM.BINDVARS = sv_b +"|"+ CUST.DENOM.curr+"|"+ CUST.DENOM.NoteDenomVal +"|"+ CUST.DENOM.DENMIND+"|" sv_u + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_v="delete from  C_DENM_CR "
