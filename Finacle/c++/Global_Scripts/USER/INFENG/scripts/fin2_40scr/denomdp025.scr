				BANCS.INPARAM.BINDVARS = sv_b +"|"+ CUST.DENOM.curr	+"|"+ CUST.DENOM.NoteDenomVal +"|"+ CUST.DENOM.DENMIND +"|"+ sv_u + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_v = "delete from  C_DENM "
				sv_v = sv_v + "WHERE sol_id=?SVAR "
				sv_v = sv_v + "AND crncy_code= ?SVAR "
