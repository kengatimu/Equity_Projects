			BANCS.INPARAM.BINDVARS = CUST.DENOM.curr  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "DenomInd,DenomValue|SELECT DENOM_IND,DENOM_VALUE "
			sv_s = sv_s + "FROM C_MDNM "
			sv_s = sv_s + "WHERE del_flg  ='N' "
			sv_s = sv_s + "AND CRNCY_CODE  = ?SVAR AND bank_id = ?SVAR "
			sv_s = sv_s + "ORDER BY Denom_Ind,Denom_Value DESC "
			
			print(sv_s)
			sv_o = urhk_dbCursorOpenWithBind(sv_s)
			IF(sv_o!=0)THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				print(sv_u)
				sv_u = urhk_setOrbOut("Details|DataBase Error")
				print(sv_u)
