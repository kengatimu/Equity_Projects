<--START
CHECKSUM="7a32c5654daac8cd27907929ebaee0a76aa6bfb2687564233d7efd2e7794a513"
	TRACE ON
	#------------------------- If denominations present then checking each denomination in C_DENM table with C_MDNM table----------------------
	
	#sv_u=("CUST").("DENOM").("tellerId"+ FORMAT$(sv_p,"%d"))
	#sv_b=("CUST").("DENOM").("solId"+ FORMAT$(sv_p,"%d"))
	print(sv_u)
	print(sv_b)
	
	BANCS.INPARAM.BINDVARS = sv_b +"|"+ CUST.DENOM.curr +"|"+ sv_u + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_s = "DenomInd,DenomValue,DenomCount|SELECT DENOM_IND,DENOM_VALUE,denom_count "
