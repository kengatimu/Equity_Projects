			#}
			ENDIF
			IF (sv_o == 0) THEN
			#{
				sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				print(sv_n)
				sv_o = urhk_dbCursorFetch(sv_n)
				WHILE(sv_o == 0)
				#{
					
					print(BANCS.OUTPARAM.DenomValue)
					CUST.DENOM.MDNMIND=BANCS.OUTPARAM.DenomInd
