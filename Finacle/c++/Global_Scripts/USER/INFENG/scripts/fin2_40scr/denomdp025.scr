					#}
					ENDIF
					sv_o = urhk_dbCursorFetch(sv_n)
				#}
				DO
				
				
				
			#}
			ENDIF
			sv_o = urhk_dbCursorClose(sv_n)
			IF(sv_o!=0)THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				print(sv_u)
				sv_u = urhk_setOrbOut("Details|DataBase Error")
