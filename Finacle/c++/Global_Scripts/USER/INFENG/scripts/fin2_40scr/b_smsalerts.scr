<--START
CHECKSUM="02edca24d967873579cb29743952b3aba7b2fbccb1bdd20ba0fc4fbd9db7bd04"
	TRACE ON
	
	IF (REPEXISTS("CUSTS")==0) THEN
	#{
		CREATEREP("CUSTS")
		
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUSTSS","MESSAGE")==0) THEN
	#{
		
		CREATECLASS("CUSTS","MESSAGE",5)
		
	#}
	ENDIF
	
	
	sv_s="foracid,exemptcode|"
	sv_s = sv_s + " SELECT foracid,EXEMPT_CODE "
	sv_s = sv_s + " FROM CUSTOM.ACCT_EXEMPTION_TABLE "
	sv_s = sv_s + " WHERE del_flg='N' "
	sv_s = sv_s + " AND EXEMPT_CODE in( 'SURVAA', 'SURVDA') "
	sv_s = sv_s + " AND bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.MESSAGE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.MESSAGE.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			
			CUSTS.MESSAGE.foracid	= BANCS.OUTPARAM.foracid
			print(CUSTS.MESSAGE.foracid)
			CUSTS.MESSAGE.exemptcode	= BANCS.OUTPARAM.exemptcode
			print(CUSTS.MESSAGE.exemptcode)
			
			sv_s="foracid,acctname,acctstatus,phoneno,clrbal,trandate|"
			sv_s = sv_s + " select foracid,acct_short_name,acct_status,phoneno,clr_bal_amt,last_tran_date from tbaadm.gam a,tbaadm.smt b,crmuser.cphone c  "
			sv_s = sv_s + " where a.acid=b.acid AND c.phone_B2KID=a.cif_id AND foracid= ?SVAR "
			sv_s = sv_s + " AND preferredflag='Y' AND a.del_flg='N' "
			sv_s = sv_s + " AND a.bank_id= ?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUSTS.MESSAGE.foracid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d == 0) THEN
			#{
				CUSTS.MESSAGE.foracid	= BANCS.OUTPARAM.foracid
				PRINT(CUSTS.MESSAGE.foracid)
				CUSTS.MESSAGE.acctname	= BANCS.OUTPARAM.acctname
				PRINT(CUSTS.MESSAGE.acctname)
				CUSTS.MESSAGE.acctstatus	= BANCS.OUTPARAM.acctstatus
				PRINT(CUSTS.MESSAGE.acctstatus)
				CUSTS.MESSAGE.phoneno	= BANCS.OUTPARAM.phoneno
				PRINT(CUSTS.MESSAGE.phoneno)
				CUSTS.MESSAGE.clrbal	= BANCS.OUTPARAM.clrbal
				PRINT(CUSTS.MESSAGE.clrbal)
				CUSTS.MESSAGE.trandate	= BANCS.OUTPARAM.trandate
				PRINT(CUSTS.MESSAGE.trandate)
				
			#}
			ENDIF
			
			
			###################################################################################################
			# Initialize the variables
			###################################################################################################
			
			CUSTS.MESSAGE.mobeepush_REF_NO= ""
			CUSTS.MESSAGE.mobeepush_LANGUAGE = "EN"
			CUSTS.MESSAGE.mobeepush_INSTITUTION_CODE = "068"
			CUSTS.MESSAGE.mobeepush_MOBILE_NUMBER = CUSTS.MESSAGE.phoneno
			CUSTS.MESSAGE.mobeepush_MESSAGE_ARRIEVED_DATE = MID$(BANCS.STDIN.BODDate,0,10)
			CUSTS.MESSAGE.mobeepush_MESSAGE_PRIORITY = "4"
			CUSTS.MESSAGE.mobeepush_MESSAGE_STATUS = "0"
			CUSTS.MESSAGE.mobeepush_MESSAGE_VALIDITY_PERIOD = "86400000"
			CUSTS.MESSAGE.mobeepush_DEPARTMENT = "Finacle"
			CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT = ""
			CUSTS.MESSAGE.mobeepush_RETRY_COUNT = "0"
			CUSTS.MESSAGE.mobeepush_BANK_ID = BANCS.STDIN.contextBankId
			
			PRINT(CUSTS.MESSAGE.mobeepush_REF_NO)
			PRINT(CUSTS.MESSAGE.mobeepush_LANGUAGE)
			PRINT(CUSTS.MESSAGE.mobeepush_INSTITUTION_CODE)
			PRINT(CUSTS.MESSAGE.mobeepush_MOBILE_NUMBER)
			PRINT(CUSTS.MESSAGE.mobeepush_MESSAGE_ARRIEVED_DATE)
			PRINT(CUSTS.MESSAGE.mobeepush_MESSAGE_PRIORITY)
			PRINT(CUSTS.MESSAGE.mobeepush_MESSAGE_STATUS)
			PRINT(CUSTS.MESSAGE.mobeepush_MESSAGE_VALIDITY_PERIOD)
			PRINT(CUSTS.MESSAGE.mobeepush_DEPARTMENT)
			PRINT(CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT)
			PRINT(CUSTS.MESSAGE.mobeepush_RETRY_COUNT)
			PRINT(CUSTS.MESSAGE.mobeepush_BANK_ID)
			
			###################################################################################################
			# MESSAGE TEXT
			###################################################################################################
			
			IF (CUSTS.MESSAGE.exemptcode=="SURVAA") THEN
			#{
				
				CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT = "Good day " + CUSTS.MESSAGE.acctname + ", Equity Bank is here to serve you.Your savings account balance is "
				CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT = CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT + CUSTS.MESSAGE.clrbal + ". Thank you for being a member"
				PRINT(CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT)
				
				#}
			ELSE
				#{
				
				CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT = "Good day " + CUSTS.MESSAGE.acctname + ", Equity Bank is here to serve you.Your last transaction with us was ON "
				CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT = CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT + CUSTS.MESSAGE.trandate + ". Thank you for being a member"
				PRINT(CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT)
				
				
			#}
			ENDIF
			###################################################################################################
			# Insert into CUSTSOM.MOBEE_PUSH_SMS TABLE
			###################################################################################################
			
			sv_s = "INSERT INTO CUSTOM.MOBEE_PUSH_SMS VALUES("
			sv_s = sv_s + "CUSTOM.MOBEE_PUSH_SMS_SEQUENCE.nextval" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR" + ","
			sv_s = sv_s + "?SVAR)"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = ""
			#BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTOM.MOBEE_PUSH_SMS_SEQUENCE.nextval'	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_LANGUAGE		+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_INSTITUTION_CODE	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_MOBILE_NUMBER		+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_MESSAGE_ARRIEVED_DATE	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_MESSAGE_PRIORITY	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_MESSAGE_STATUS		+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_MESSAGE_VALIDITY_PERIOD	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_DEPARTMENT		+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_MESSAGE_TEXT		+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_RETRY_COUNT		+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUSTS.MESSAGE.mobeepush_BANK_ID
			
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				CUSTS.MESSAGE.scriptSuccess = "N"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Insert Query Failed^prodCode")
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			
			
			
			sv_k = urhk_dbCursorFetch(CUSTS.MESSAGE.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.MESSAGE.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
