<--START
CHECKSUM="2e4b40660fe9ecfca6f2d757512726e846deca68b4ea9c28b08c0b013c26b2a5"
	TRACE ON
	PRINT(CUST.HOCCM.InstrumentNum)
	CUST.HOCCM.InstrumentNum1 = LTRIM(CUST.HOCCM.InstrumentNum,'0')
	print(CUST.HOCCM.InstrumentNum1)
	
	BANCS.INPARAM.BINDVARS = LPAD(CUST.HOCCM.InstrumentNum1,16,' ') + "|" + CUST.HOCCM.DrSchmCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "U|" + CUST.HOCCM.acctSolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	lv_r = "ddstatus,cautionstatus,payeebrcode,payeebnkcode,issuBrCode,issuBnkCode,issuExtnCode,"
	lv_r = lv_r + " payeename,issue_date,dd_amt|SELECT DD_STATUS,CAUTIONED_STAT,"
	lv_r = lv_r + " PAYEE_BR_CODE,PAYEE_BANK_CODE,issu_br_code,issu_bank_code,ISSU_EXTN_CNTR_CODE,"
	lv_r = lv_r + " PAYEE_NAME,to_char(issue_date,'DD-MM-YYYY'),DD_AMT FROM TBAADM.DST"
	lv_r = lv_r + " WHERE DD_NUM  =  ?SVAR "
	lv_r = lv_r + " AND SCHM_CODE = ?SVAR "
	lv_r = lv_r + " AND DD_STATUS = ?SVAR "
	lv_r = lv_r + " AND issu_br_code = ?SVAR "
	lv_r = lv_r + " AND BANK_ID = ?SVAR "
	
	
	print(lv_r)
	
	lv_e = urhk_dbSelectWithBind(lv_r)
	print(lv_e)
	IF (lv_e ==0) THEN
	#{
		CUST.HOCCM.InstNum = LPAD(CUST.HOCCM.InstrumentNum,16,' ')
		CUST.HOCCM.DDSTATUS = BANCS.OUTPARAM.ddstatus
		CUST.HOCCM.dd_amt = BANCS.OUTPARAM.dd_amt
		print(CUST.HOCCM.dd_amt)
		CUST.HOCCM.CAUTIONSTATUS = BANCS.OUTPARAM.cautionstatus
		CUST.HOCCM.DDPayeeBr = BANCS.OUTPARAM.payeebrcode
		print(CUST.HOCCM.DDPayeeBr)
		CUST.HOCCM.DDPayeeBnk = BANCS.OUTPARAM.payeebnkcode
		print(CUST.HOCCM.DDPayeeBnk)
		CUST.HOCCM.issuBrCode = BANCS.OUTPARAM.issuBrCode
		print(CUST.HOCCM.issuBrCode)
		CUST.HOCCM.issuBnkCode = BANCS.OUTPARAM.issuBnkCode
		print(CUST.HOCCM.issuBnkCode)
		CUST.HOCCM.issuExtnCode = BANCS.OUTPARAM.issuExtnCode
		print(CUST.HOCCM.issuExtnCode)
		CUST.HOCCM.PayeeName = BANCS.OUTPARAM.payeename
		print(CUST.HOCCM.PayeeName)
		CUST.HOCCM.MCIssueDate = BANCS.OUTPARAM.issue_date
		print(CUST.HOCCM.MCIssueDate)
		
		IF (CUST.HOCCM.PayeeName == "") THEN
		#{
			CUST.HOCCM.PayeeName = " "
		#}
		ENDIF
		
		IF(CUST.HOCCM.CAUTIONSTATUS == "S") THEN
		#{
			
			CUST.INTERFACE.errorCode = "ERR064"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.HOCCM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.HOCCM.fieldName = "abc"
			CUST.HOCCM.successFlg = "F"
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.HOCCM.CAUTIONSTATUS == "C") OR (CUST.HOCCM.CAUTIONSTATUS == "L") OR (CUST.HOCCM.CAUTIONSTATUS == "M")) THEN
		#{
			CUST.INTERFACE.errorCode = "ERR064"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.HOCCM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.HOCCM.fieldName = "abc"
			CUST.HOCCM.successFlg = "F"
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.errorCode = "ERR064"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.HOCCM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.HOCCM.fieldName = "abc"
		CUST.HOCCM.successFlg = "F"
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	print(CUST.HOCCM.InstType)
	
	
	print(CUST.HOCCM.DDPayeeBnk)
	print(CUST.HOCCM.DDPayeeBr)
	
	print(CUST.HOCCM.issuBrCode)
	print(CUST.HOCCM.issuBnkCode)
	print(CUST.HOCCM.issuExtnCode)
	
	print(CUST.HOCCM.InstNum)
	
	#-------------------------------------------------------------------------------
	
	# Setting inputs and outputs for SRV_AddDDMassPmt.
	
	#-------------------------------------------------------------------------------
	
	#sv_u = "tranDtl.partTranDetailLL." +sv_r+ ".addnlDtl.ddPymtAddnlDtlPtr."
	
	
	
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.tranSubType.tranType|" + CUST.HOCCM.TransactionType)
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.tranSubType.tranSubType|" + CUST.HOCCM.TransactionSubType)
	sv_a = urhk_SetUrhkInp("ddMassPmtMiscDtl.ignoreXcpnsFlg|Y")
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.eventType|DDMP")
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddInstrmnt.instrmntType|"+CUST.HOCCM.InstType)
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeName|" + CUST.HOCCM.PayeeName)
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddAcct.foracid|"+CUST.HOCCM.PayingAcctNum)
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddAcct.crncyCode|"+ CUST.HOCCM.DrAcctCrncyCode)
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeAcct.foracid|" + CUST.HOCCM.CrAcct)
	
	
	
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.key.serial_num|"+sv_y)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.key.srlNum|"+sv_y)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.ddAcct.foracid|" + CUST.HOCCM.PayingAcctNum)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.ddAcct.crncyCode|" + CUST.HOCCM.DrAcctCrncyCode)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.ddAmt|" + CUST.HOCCM.CrTranAmt + "|" + CUST.HOCCM.DrAcctCrncyCode)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.ddInstrmnt.instrmntDate|" + CUST.HOCCM.MCIssueDate + " 00:00:00")
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.ddInstrmnt.instrmntType|"+CUST.HOCCM.InstType)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.ddInstrmnt.instrmntNum|" + CUST.HOCCM.InstNum)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.issBr.bankCode|" + CUST.HOCCM.issuBnkCode)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.issBr.brCode|" + CUST.HOCCM.issuBrCode)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.delFlg|N")
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.issExtnCntrCode|" + CUST.HOCCM.issuExtnCode)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.payeeAcct.foracid|" + CUST.HOCCM.CrAcct)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.payeeName|" + CUST.HOCCM.PayeeName)
	sv_a = urhk_SetUrhkInp("ddMassPmtLL.<rec_"+sv_y+">.ddPmtDtl.tranRmks|" + CUST.HOCCM.DrRemarks)
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeRateCode.refCode|TTB")
	sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeRate|1.00")
	sv_a = urhk_SetUrhkOut("ddMassPmtHdr.tranId|tranId")
	sv_a = urhk_SetUrhkOut("ddMassPmtHdr.tranDate|tranDate")
	
	
	IF (CUST.HOCCM.smInstrument == "S") THEN
	#{
		
		sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddInstrmnt.instrmntNum|" + CUST.HOCCM.InstNum)
		sv_a = urhk_SetUrhkInp("ddMassPmtHdr.ddInstrmnt.instrmntDate|" + CUST.HOCCM.MCIssueDate + " 00:00:00")
		sv_a = urhk_SetUrhkInp("ddMassPmtHdr.payeeAcct.foracid|"+ CUST.HOCCM.CrAcct)
		#-------------------------------------------------------------------------------
		# Execution of Service.
		#-------------------------------------------------------------------------------
		sv_a = urhk_ExecSrvNoCommit("SRV_AddDDMassPmtDtl|same_user_verify = Y|retain_all_output = Y|call_mode = N")
		print(sv_a)
		IF(sv_a != "0") THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			
			CUST.INTERFACE.srvErrFlg = "Y"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
			
			#}
		ELSE
			#{
			CUST.HOCCM.tranId = BANCS.OUTPARAM.tranId
			print(CUST.HOCCM.tranId)
			### The variable will hold the TranDate from the previous SRV Call to SRV_AddDDMassPmtDtl ##
			CUST.HOCCM.tranDate = BANCS.OUTPARAM.tranDate
			print(CUST.HOCCM.tranDate)
			sv_a = 0
		#}
		ENDIF
		
		sv_a = urhk_CopyOutToIn("")
		print(sv_a)
		lv_u = urhk_SetUrhkInp("ddMassPmtHdr.tranDate|" + CUST.HOCCM.tranDate)
		lv_u = urhk_SetUrhkInp("ddMassPmtHdr.tranId|" + CUST.HOCCM.tranId)
		
		sv_n = urhk_ExecSrvNoCommit("SRV_FetchDDMassPmtDtlForPost|retain_all_output = Y")
		print(sv_n)
		IF(sv_n != "0") THEN
		#{
			CUST.INTERFACE.srvErrFlg = "Y"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ENDIF
		
		##-------------------------------------------------------------------------------
		#  Copying all fetched outputs as inputs for other services
		##-------------------------------------------------------------------------------
		BANCS.INPARAM.SourceStr = ""
		BANCS.INPARAM.ReplaceStr = "ddMassPmtDtl"
		lv_a = urhk_CopyOutToInDiffStruct("")
		print(lv_a)
		
		lv_a = urhk_ExecSrvNoCommit("SRV_CreateTranForDDMassPmt|retain_all_output = Y|call_mode = N")
		print(lv_a)
		IF(lv_a == 1) THEN
		#{
			CUST.INTERFACE.srvErrFlg = "Y"
			CUST.INTERFACE.successOrFailure = "F"
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
				#}
			ELSE
				#{
				sv_v = 0
			#}
			ENDIF
			IF (sv_v > 0) THEN
			#{
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					print(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
					sv_u = urhk_SRV_SetErr(("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f))
					exitscript
				#}
				DO
			#}
			ENDIF
			
			
		#}
		ENDIF
	#}
	ENDIF
	
	
	EXITSCRIPT
