<--START
	# Script body goes here
	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	#==========================================================*
	# Intilializing the Variables
	#==========================================================*
	CUST.CIETXN.count="0"
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.randomRefNo = " "
	CUST.CIETXN.RefNo = " "
	IF(FIELDEXISTS(BANCS.INPUT.ieTxnRefNo))THEN
	#{
		IF(TRIM(BANCS.INPUT.ieTxnRefNo) != "")THEN
		#{
			CUST.CIETXN.randomRefNo = TOUPPER(TRIM(BANCS.INPUT.ieTxnRefNo))
			PRINT(CUST.CIETXN.randomRefNo)
		#}
		ELSE
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_s="count|SELECT COUNT(1) FROM CUSTOM.IEPAGL WHERE IE_TXN_REF_NO=?SVAR AND (INIT_ENTITY_ID = ?SVAR OR TARGET_ENTITY_ID = ?SVAR)"
	BANCS.INPARAM.BINDVARS=CUST.CIETXN.randomRefNo + "|"+ BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d != 0)THEN
	#{
		
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Error in Fetching Data"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.CIETXN.count =BANCS.OUTPARAM.count

	IF(CUST.CIETXN.count == "0") THEN
	#{
		sv_s = "mobNo,RefNo|"
        	sv_s = sv_s + " SELECT mobile_number,IE_TXN_REF_NO"
        	sv_s = sv_s + " FROM CUSTOM.MOBEE_PUSH_SMS "
        	sv_s = sv_s + " WHERE message_text like '%"+CUST.CIETXN.randomRefNo+"%'"
        	PRINT(sv_s)

        	sv_d = urhk_dbSelectWithBind(sv_s)
        	PRINT(sv_d)

        	IF(sv_d == 0)THEN
        	#{
                	CUST.CIETXN.mobNo = BANCS.OUTPARAM.mobNo
                	PRINT(CUST.CIETXN.mobNo)
                	CUST.CIETXN.RefNo = BANCS.OUTPARAM.RefNo
                	PRINT(CUST.CIETXN.RefNo)
	                IF((CUST.CIETXN.mobNo != "") AND (TRIM(CUST.CIETXN.RefNo) == ""))THEN
       		        #{
               		         BANCS.INPARAM.BINDVARS = CUST.CIETXN.mobNo
                       		 sv_s = "RefNo|"
                        	 sv_s = sv_s + " SELECT IE_TXN_REF_NO from custom.IEPAGL where phone_no = ?SVAR and status_flg='I'"
                        	 PRINT(sv_s)

                        	 sv_d = urhk_dbSelectWithBind(sv_s)
                        	 PRINT(sv_d)

                        	 IF(sv_d == 0) THEN
                        	#{
                               		 CUST.CIETXN.RefNo = BANCS.OUTPARAM.ieRefNo
                                	 PRINT(CUST.CIETXN.RefNo)

                        	#}
                        	ELSE
                        	#{
                               		 CUST.CIETXN.errorFlg = "Y"
                                         CUST.CIETXN.errorMsg = "Invalid reference Number"
                                	 GOTO ENDOFSCRIPT
                        	#}
                        	ENDIF
			#}
			ENDIF
                #}
		ELSE
		#{
                         CUST.CIETXN.errorFlg = "Y"
                         CUST.CIETXN.errorMsg = "Invalid reference Number"
                         GOTO ENDOFSCRIPT
		#}
		ENDIF

	#}
	ELSE
	#{
		CUST.CIETXN.RefNo = CUST.CIETXN.randomRefNo	
	#}
	ENDIF
	ENDOFSCRIPT:
		sv_s=urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		sv_s=urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		sv_s=urhk_SetOrbOut("ieTxnRefNo|"+CUST.CIETXN.RefNo)
		TRACE OFF
END-->

