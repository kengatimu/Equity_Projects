				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				print(BANCS.OUTPARAM.diff2)
				IF (CINT(BANCS.OUTPARAM.diff2) > 0) THEN
				#{
					sv_e = "End date cannot be smaller than the Start Date"
					sv_m = "toDate_ui"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
