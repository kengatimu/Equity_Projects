	CUST.DATA.errMsg = ""
	
	#---------------------------------------------------------------------------------
	#Checking the validity of the Start date entered
	#---------------------------------------------------------------------------------
	IF (fieldexists(CUST.DATA.frmDate)) THEN
	#{
		#---------------------------------------------------------------------------------
		# If start date is not entered.
		#---------------------------------------------------------------------------------
		IF ( CUST.DATA.frmDate == "") THEN
		#{
			sv_e = "Start Date has to be entered."
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			IF (urhk_B2k_valDate(CUST.DATA.frmDate)==1) THEN
			#{
				sv_e = "Date not valid. Enter Date in DD-MM-YYYY format"
				sv_m = "frmdate_ui"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			CUST.DATA.bod = BANCS.STDIN.BODDate
			PRINT(CUST.DATA.bod)
			#---------------------------------------------------------------------------------
			# Check for start date to be smaller than end date.
			#---------------------------------------------------------------------------------
			sv_q = "diff2|SELECT TO_DATE(SUBSTR(?SVAR,1,10),'DD-MM-YYYY') - TO_DATE(SUBSTR(?SVAR,1,10),'DD-MM-YYYY') FROM DUAL "
			BANCS.INPARAM.BINDVARS =  CUST.DATA.frmDate  + "|" + CUST.DATA.bod
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_k = urhk_dbSelectWithBind(sv_q)
			PRINT(sv_k)
			IF (sv_k != 0 ) THEN
			#{
				sv_e = "Error executing the query."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
				
			#}
			ELSE
				#{
				IF (BANCS.OUTPARAM.diff2 > 0) THEN
				#{
					sv_e = "Start Date Cannot be greater than the Current Date"
					sv_m = "frmdate_ui"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
