			#---------------------------------------------------------------------------------
			sv_q = "diff2|SELECT TO_DATE(SUBSTR(?SVAR,1,10),'DD-MM-YYYY') - TO_DATE(SUBSTR(?SVAR,1,10),'DD-MM-YYYY') FROM DUAL "
			#	BANCS.INPARAM.BINDVARS =  CUST.DATA.toDate  + "|" + CUST.DATA.bod
			BANCS.INPARAM.BINDVARS =  CUST.DATA.frmDate + "|" + CUST.DATA.toDate
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_k = urhk_dbSelectWithBind(sv_q)
