	#---------------------------------------------------------------------------------
	# Check if the duplicate filed value is invalid. i.e not "Y" or "N".
	#---------------------------------------------------------------------------------
	IF ((CUST.DATA.duplicate != "Y")  AND  (CUST.DATA.duplicate != "N")) THEN
	#{
		sv_e = "Only Y AND N are valid "
		sv_m = "duplicate"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------------
	# Check for the validity of Download ID.
	#---------------------------------------------------------------------------------
	IF (fieldexists(CUST.DATA.dnldID)) THEN
	#{
		IF (CUST.DATA.dnldID == "") THEN
		#{
			IF(CUST.DATA.duplicate == "Y") THEN
			#{
				sv_e = "DownLoad Id must be entered"
				sv_m = "dnldID"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_s ="count|SELECT COUNT(*) FROM CUSTOM.CUSTOM_CBR WHERE download_id = ?SVAR "
			sv_s = sv_s +  " AND  branch_id = trim(?SVAR) "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS =  CUST.DATA.dnldID + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_s = urhk_dbSelectWithBind(sv_s)
			IF (sv_s != 0 ) THEN
			#{
				sv_e = "Error occured. Contact DBA."
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				IF (CINT(BANCS.OUTPARAM.count) == 0) THEN
				#{
					
					sv_e = "Given Down Load Id does not Belong to your Branch"
					sv_m = "dnldID"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	IF (BANCS.INPUT.duplicate == "N") THEN
	#{
		CUST.DATA.SolId   =   trim(BANCS.STDIN.mySolId)
		sv_a = "brcode|SELECT br_code FROM TBAADM.sol WHERE sol_id = ?SVAR "
		sv_a = sv_a +  " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.DATA.SolId + "|"  + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_a = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_a)
		IF (sv_a != 0 ) THEN
		#{
			sv_e = "Error Occured. Contact DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.DATA.brcode = lpad(MID$(BANCS.OUTPARAM.brcode,0,3),3,'0')
		PRINT(CUST.DATA.brcode)
		#---------------------------------------------------------------------------------
		# Generating the Download sequence number.
		#---------------------------------------------------------------------------------
		
		#sv_t="DownSeq|SELECT CUSTOM.ChqBookDownLoad_Seq.nextval FROM DUAL"
		sv_t="DownSeq|SELECT CUSTOM.ChqBookDownLoad_Seq_" + BANCS.STDIN.contextBankId + ".nextval FROM DUAL"
		sv_t=urhk_dbSelectWithBind(sv_t)
		PRINT(sv_t)
		IF (sv_t != 0 ) THEN
		#{
			sv_e = "Error Occured. Contact DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.DATA.DownSeq = trim(BANCS.OUTPARAM.DownSeq)
		PRINT(CUST.DATA.DownSeq)
		#---------------------------------------------------------------------------------
		# Forming the file name.
		#---------------------------------------------------------------------------------
		CUST.DATA.lst1    = CUST.DATA.dnldfile1 + CUST.DATA.brcode+ "_" + lpad(CUST.DATA.DownSeq,6,'0') + ".txt"
		print(CUST.DATA.lst1)
		CUST.DATA.lst2    = CUST.DATA.dnldfile2 + CUST.DATA.brcode + "_" + lpad(CUST.DATA.DownSeq,6,'0') + ".txt"
		print(CUST.DATA.lst2)
		
		IF(BANCS.STDIN.contextBankId == "50") THEN
		#{
			sv_s = "boddatestart|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.DATA.frmDate
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			CUST.DATA.frmDate=BANCS.OUTPARAM.boddatestart
			
			sv_s = "boddateend|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.DATA.toDate
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			CUST.DATA.toDate = BANCS.OUTPARAM.boddateend
		#}
		ENDIF
		
		CUST.DATA.sql_param	=	CUST.DATA.frmDate + "!" + CUST.DATA.toDate + "!" + CUST.DATA.SolId + "!" + CUST.DATA.DownSeq +"!" + CUST.DATA.schmType1 + "!" + CUST.DATA.crncy1 + "!" + CUST.DATA.crncy2 + "!" + CUST.DATA.crncy3 + "!" + CUST.DATA.crncy4 + "!" +CUST.DATA.schmCode1 + "!" + CUST.DATA.crncy5 + "!" + CUST.DATA.crncy6 + "!" + CUST.DATA.crncy7 + "!" + CUST.DATA.crncy8 + "!" + CUST.DATA.schmtype2 + "!" + CUST.DATA.schmCode2 + "!" + CUST.DATA.crncy9 + "!" + CUST.DATA.crncy10 + "!" +  CUST.DATA.crncy11 + "!" + CUST.DATA.crncy12 + "!" + CUST.DATA.crncy13 + "!" + CUST.DATA.crncy14 + "!" + CUST.DATA.crncy15 + "!" + CUST.DATA.crncy16 + "!" + BANCS.STDIN.contextBankId
		PRINT(CUST.DATA.sql_param)
		
		sv_u = urhk_getFileLocation("COM|chqmndp001.com")
		print(sv_u)
		print(BANCS.OUTPARAM.fileLocation)
		
		IF (sv_u == 0) THEN
		#{
			#----------------------------------------------------------------------------------
			#---    Setting Env variables
			#----------------------------------------------------------------------------------
			sv_a = "sqlParam|" + CUST.DATA.sql_param
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "bankId|" + BANCS.STDIN.contextBankId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "lstFile1|" + CUST.DATA.lst1
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "lstFile2|" + CUST.DATA.lst2
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------
			#---    Executing com file in background
			#----------------------------------------------------------------------------------
			BANCS.INPARAM.scriptName = "chqmndp001.com"
			BANCS.INPARAM.arguments = ""
			sv_u = urhk_CallShellScript("b")
			print(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Com execution failed. Please check with admin"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.DATA.errMsg = "Unable to load com file"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.DATA.DWNLOADID 	=TRIM(CUST.DATA.dnldID)
		PRINT(CUST.DATA.DWNLOADID)
		CUST.DATA.SolId	=	BANCS.STDIN.mySolId
		PRINT(CUST.DATA.SolId)
		sv_a = "brcode|SELECT br_code FROM TBAADM.sol WHERE sol_id = ?SVAR "
		sv_a = sv_a +  " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.DATA.SolId + "|"  + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_a = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_a)
		
		IF (sv_a != 0 ) THEN
		#{
			sv_e = "Error Occured. Contact DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.DATA.brcode = lpad(MID$(BANCS.OUTPARAM.brcode,0,3),3,'0')
		PRINT(CUST.DATA.brcode)
		
		#---------------------------------------------------------------------------------*
		# Forming the name of the data file that is to be generated.
		#---------------------------------------------------------------------------------
		CUST.DATA.lst    = CUST.DATA.dnldfile3 + CUST.DATA.brcode + "_" + lpad(CUST.DATA.DWNLOADID,6,'0') + ".txt"
		print(CUST.DATA.lst)
		CUST.DATA.sql_param	=	CUST.DATA.DWNLOADID + "!" + CUST.DATA.SolId + "!" + BANCS.STDIN.contextBankId
		PRINT(CUST.DATA.sql_param)
		sv_u = urhk_getFileLocation("COM|chqmndp002.com")
		print(sv_u)
		print(BANCS.OUTPARAM.fileLocation)
		
		IF (sv_u == 0) THEN
		#{
			#----------------------------------------------------------------------------------
			#---    Setting Env variables
			#----------------------------------------------------------------------------------
			sv_a = "sqlParam|" + CUST.DATA.sql_param
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "bankId|" + BANCS.STDIN.contextBankId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "lstFile|" + CUST.DATA.lst
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Error in setting env variable fileName"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------
			#---    Executing com file in background
			#----------------------------------------------------------------------------------
			BANCS.INPARAM.scriptName = "chqmndp002.com"
			BANCS.INPARAM.arguments = ""
			sv_u = urhk_CallShellScript("b")
			print(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errMsg = "Com execution failed. Please check with admin"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.DATA.errMsg = "Unable to load com file"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.DATA.errMsg != "") THEN
		#{
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ CUST.DATA.errMsg
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			#}
		ELSE
			#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|Download process Initiated SuccessFully"
			sv_z = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
