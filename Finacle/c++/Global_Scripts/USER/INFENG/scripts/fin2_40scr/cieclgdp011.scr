<--START
CHECKSUM="0f17af25df42c697ea77a3a9afbf2be7c039627a1c0c2fc97172211ba5392b0a"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIECLG Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIECLG")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIECLG",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIECLG.acctNum = " "
	CUST.CIECLG.errorFlg = "N"
	CUST.CIECLG.errorMsg = " "
	CUST.CIECLG.acctNumEntityId = " "
	CUST.CIECLG.acctNumSolId = " "
	CUST.CIECLG.acctNumCcy = " "
	CUST.CIECLG.acctName = " "
	CUST.CIECLG.entityCreFlg = " "
	CUST.CIECLG.acctClsFlg = " "
	CUST.CIECLG.schmType = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
		#{
			CUST.CIECLG.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
			print(CUST.CIECLG.acctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctNumEntityId,acctNumSolId,acctNumCcy,acctName,entityCreFlg,acctClsFlg,schmType|"
	sv_s = sv_s + " SELECT BANK_ID,SOL_ID,ACCT_CRNCY_CODE,ACCT_NAME,ENTITY_CRE_FLG,ACCT_CLS_FLG,SCHM_TYPE"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIECLG.acctNum
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIECLG.acctNumEntityId = BANCS.OUTPARAM.acctNumEntityId
		print(CUST.CIECLG.acctNumEntityId)
		CUST.CIECLG.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
		print(CUST.CIECLG.acctNumSolId)
		CUST.CIECLG.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
		print(CUST.CIECLG.acctNumCcy)
		CUST.CIECLG.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CIECLG.acctName)
		CUST.CIECLG.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		print(CUST.CIECLG.entityCreFlg)
		CUST.CIECLG.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
		print(CUST.CIECLG.acctClsFlg)
		CUST.CIECLG.schmType = BANCS.OUTPARAM.schmType
		print(CUST.CIECLG.schmType)
		
		IF(CUST.CIECLG.entityCreFlg == "N")THEN
		#{
			CUST.CIECLG.errorFlg = "Y"
			CUST.CIECLG.errorMsg = "Account Creation Not Authorised"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.CIECLG.acctClsFlg == "Y")THEN
		#{
			CUST.CIECLG.errorFlg = "Y"
			CUST.CIECLG.errorMsg = "Account is closed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.CIECLG.schmType != "SBA") AND (CUST.CIECLG.schmType != "CAA") AND (CUST.CIECLG.schmType != "CCA") AND (CUST.CIECLG.schmType != "ODA"))THEN
		#{
			CUST.CIECLG.errorFlg = "N"
			CUST.CIECLG.errorMsg = "Only SBA/CAA/CCA/ODA Type of Accounts are allowed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		#}
	ELSE
		#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Invalid Account ID"
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIECLG.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIECLG.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumEntityId|"+CUST.CIECLG.acctNumEntityId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumSolId|"+CUST.CIECLG.acctNumSolId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumCcy|"+CUST.CIECLG.acctNumCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctName|"+CUST.CIECLG.acctName)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNum|"+CUST.CIECLG.acctNum)
		print(sv_u)
		
		
END-->
