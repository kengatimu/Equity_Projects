#    Name			 : salpaymn001.scr 
#    Description     : Thus script is called from the on submit of the salpay chage pop menu
#					 : for the chage collection
#    Date            : 10-03-2013
#    Author          : Prakash
#    Input           : NA
#    Output			 : NA
#    Called Script	 : NA
#    Calling Script	 : NA
#    Menu Option	 : COBMM
#    Srl. No			Date			Author			Description.
#    ------			----------			-------			---------------
#    1.0			10-03-2013			Prakash			Original Version
#    2.0			08-10-2013			Bharath			Modified for TOL 377053
#------------------------------------------------------------------------------
<--START
CHECKSUM="3da6af72b9ddc5f42e2072b4d85e290df0e941890a3f45bd7cf579f4b5454c80"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "SALPAY") == 0) THEN
	#{
		CREATECLASS("CUST", "SALPAY", 5)
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","GCHRG") == 0) THEN
	#{
		CREATECLASS("CUST","GCHRG",5)
	#}
	ENDIF
	
	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	
	#-------------------------------------------------------------------------------------------------------
	# Fetching Required Input Details
	#-------------------------------------------------------------------------------------------------------
	CUST.SALPAY.chgrcode 	= MTT.InputDetails.Argument1
	print(CUST.SALPAY.chgrcode)
	CUST.SALPAY.trandate 	= MTT.InputDetails.Argument2
	print(CUST.SALPAY.trandate)
	CUST.SALPAY.tranid 		= MTT.InputDetails.Argument3
	print(CUST.SALPAY.tranid)
	CUST.SALPAY.eventid 	= MTT.InputDetails.Argument4
	print(CUST.SALPAY.eventid)
	CUST.GCHRG.chgrcode 	= CUST.SALPAY.chgrcode
	print(CUST.GCHRG.chgrcode)
	
	sv_r = urhk_MTTS_Close("")
	print(sv_r)
	
	CUST.SALPAY.acctname 	= ""
	CUST.SALPAY.foracid 	= ""
	CUST.SALPAY.sucess  	= ""
	CUST.SALPAY.failure 	= ""
	CUST.SALPAY.acctcrncycode = ""
	CUST.SALPAY.ChrgAmt 	= ""
	CUST.SALPAY.errMsg 		= ""
	
	#--------------------------------------------------------------------------
	# Selecting credit part trans from dtd for the passed tranid and trandate
	#--------------------------------------------------------------------------
	sv_s = "foracid,schmCode,sol_id,acctcrncycode,acctname|SELECT foracid,schm_code,sol_id,acct_crncy_code,acct_name "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE acid IN "
	sv_s = sv_s + "( SELECT acid "
	sv_s = sv_s + "FROM TBAADM.DTD "
	sv_s = sv_s + "WHERE tran_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + "AND tran_id = LPAD(?SVAR,9) "
	sv_s = sv_s + "AND part_tran_type = 'C' "
	sv_s = sv_s + "AND del_flg != 'Y' "
	sv_s = sv_s + "AND bank_id = ?SVAR )"
	sv_s = sv_s + "AND bank_id = ?SVAR "
	
	BANCS.INPARAM.BINDVARS =  CUST.SALPAY.trandate + "|" + CUST.SALPAY.tranid  + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	
	
	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_o)
	
	IF(sv_o != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUST.SALPAY.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(CUST.SALPAY.MainCursor)
	#--------------------------------------------------------------------------
	# Initialise the Local Variables
	# Variable Initialisation for counter. It should be Zero
	# Variable Initialisation for credit amount to the bank income  account. It should be Zero.
	#--------------------------------------------------------------------------
	
	sv_n = "echo > sucess.lst "
	sv_a = "echo > failure.lst "
	
	sv_b = SYSTEM(sv_n)
	PRINT(sv_b)
	sv_b = SYSTEM(sv_a)
	
	sv_z = 0
	sv_l = 0
	
	#--------------------------------------------------------------------------
	# Calling script for creating tranxs like individual debit from customer and
	# consolidated credit to the income Account.
	#--------------------------------------------------------------------------
	sv_m = ""
	WHILE (sv_o == 0)
	#{
		
		sv_c = urhk_dbCursorFetch(CUST.SALPAY.MainCursor )
		print(sv_c)
		IF (sv_c != 0) THEN
		#{
			print(sv_c)
			sv_o = 1
			#}
		ELSE
			#{
			#--------------------------------------------------
			# Customer Debit part transaction
			#--------------------------------------------------
			
			CUST.SALPAY.Cust_Foracid = BANCS.OUTPARAM.foracid
			PRINT(CUST.SALPAY.Cust_Foracid)
			
			CUST.SALPAY.Cust_sol_id = BANCS.OUTPARAM.sol_id
			PRINT(CUST.SALPAY.Cust_sol_id)
			
			CUST.SALPAY.acctcrncycode = BANCS.OUTPARAM.acctcrncycode
			PRINT(CUST.SALPAY.acctcrncycode)
			
			CUST.SALPAY.acctname = BANCS.OUTPARAM.acctname
			PRINT(CUST.SALPAY.acctname)
			CUST.SALPAY.schmCode = BANCS.OUTPARAM.schmCode
			PRINT(CUST.SALPAY.schmCode)
			
			IF ((BANCS.STDIN.contextBankId == "50") AND (CUST.SALPAY.schmCode == "CA202")) THEN
			#{
				CUST.SALPAY.errMsg = "DO not collect charges for this account"
				print(CUST.SALPAY.errMsg)
				sv_u = urhk_SRV_setErr(CUST.SALPAY.errMsg)
				BANCS.OUTPUT.successOrFailure = "F"
				#}
			ELSE
				#{
				sv_z = sv_z + 1
				CUST.SALPAY.Counter = sv_z
				
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "BI"
				CUST.GCHRG.drAcctId = CUST.SALPAY.Cust_Foracid
				CUST.GCHRG.acctCrncyCode = CUST.SALPAY.acctcrncycode
				CUST.GCHRG.eventId = CUST.SALPAY.eventid
				CUST.GCHRG.chrgAmt = CUST.SALPAY.ChrgAmt + "|" + CUST.SALPAY.acctcrncycode
				
				CALL("gchrgcommon.scr")
				
				IF( CUST.GCHRG.successOrFailure == "S" ) THEN
				#{
					sv_m ="echo '"+ CUST.SALPAY.Cust_Foracid + "|" + CUST.SALPAY.acctname + "|" + CUST.GCHRG.tranId + "| Chages collected SuccessFull' >>sucess.lst"
					PRINT(sv_m)
					sv_c = SYSTEM(sv_m)
					print(sv_c)
					#}
				ELSE
					#{
					sv_m ="echo '"+ CUST.SALPAY.Cust_Foracid + "|" + CUST.SALPAY.acctname + "| |Chages not collected' >>failure.lst"
					print(sv_m)
					sv_c = SYSTEM(sv_m)
					print(sv_c)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	DO
	sv_c = urhk_dbCursorClose(CUST.SALPAY.MainCursor)
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
