			CUST.INTERFACE.tranParticularsDr = BANCS.OUTPARAM.tranpart1
			CUST.INTERFACE.tranParticularsDr = "REV:" + CUST.INTERFACE.tranParticularsDr
			PRINT(CUST.INTERFACE.tranParticularsDr)
			CUST.INTERFACE.tranParticularsDr = MID$(CUST.INTERFACE.tranParticularsDr,0,50)
			PRINT(CUST.INTERFACE.tranParticularsDr)
			CUST.INTERFACE.tranRmksDr = BANCS.OUTPARAM.tranRmks1
			PRINT(CUST.INTERFACE.tranRmksDr)
			CUST.INTERFACE.tranRmksDr = MID$(CUST.INTERFACE.tranRmksDr,0,30)
			PRINT(CUST.INTERFACE.tranRmksDr)
			CUST.INTERFACE.rateCode = BANCS.OUTPARAM.rateCode
			PRINT(CUST.INTERFACE.rateCode)
			CUST.INTERFACE.drRate = BANCS.OUTPARAM.rate
			PRINT(CUST.INTERFACE.drRate)
			CUST.INTERFACE.refNumDr = BANCS.OUTPARAM.refNo
			PRINT(CUST.INTERFACE.refNumDr)
		#}
		ENDIF
		
		IF(TRIM(CUST.CIEREV.partTranSrlNum) == "3")THEN
		#{
			CUST.INTERFACE.chargeCrAcctID = CUST.CIEREV.drAcct
			CUST.INTERFACE.chargeTranAmt = ""
			CUST.INTERFACE.chargeTranCcy = ""
			CUST.INTERFACE.chargeRateCode = ""
			CUST.INTERFACE.chargeRate = ""
			CUST.INTERFACE.chargeTranParticulars = BANCS.OUTPARAM.tranpart1
			CUST.INTERFACE.chargeTranParticulars = "REV:" + BANCS.OUTPARAM.tranpart1
			PRINT(CUST.INTERFACE.chargeTranParticulars)
			CUST.INTERFACE.chargeTranParticulars = MID$(CUST.INTERFACE.chargeTranParticulars,0,50)
			PRINT(CUST.INTERFACE.chargeTranParticulars)
			CUST.INTERFACE.chargeTranRmks = BANCS.OUTPARAM.tranRmks1
			PRINT(CUST.INTERFACE.chargeTranRmks)
			
			PRINT(CUST.CIEREV.chargeAmt)
			IF((CDOUBLE(CUST.CIEREV.chargeAmt)==0) OR (TRIM(CUST.CIEREV.chargeAmt)==""))THEN
			#{
				CUST.INTERFACE.chargeTranAmt="0"
			#}
			ENDIF
		#}
		ENDIF
		
		IF(TRIM(CUST.CIEREV.partTranSrlNum) == "4")THEN
		#{
			CUST.INTERFACE.chargeDrAcctID = BANCS.OUTPARAM.acid
			PRINT(CUST.INTERFACE.chargeDrAcctID)
			CUST.INTERFACE.chargeTranAmt = BANCS.OUTPARAM.refAmt
			PRINT(CUST.INTERFACE.chargeTranAmt)
			CUST.INTERFACE.chargeTranCcy = BANCS.OUTPARAM.refCrncy
			PRINT(CUST.INTERFACE.chargeTranCcy)
			CUST.INTERFACE.chargeRateCode = BANCS.OUTPARAM.rateCode
			PRINT(CUST.INTERFACE.chargeRateCode)
			CUST.INTERFACE.chargeRate = BANCS.OUTPARAM.rate
			PRINT(CUST.INTERFACE.chargeRate)
			
			lv_s = "chargeDrAcctID|SELECT FORACID FROM TBAADM.GAM WHERE ACID = ?SVAR AND BANK_ID = ?SVAR"
			PRINT(lv_s)
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.chargeDrAcctID + "|" + CUST.CIEREV.targetEntity
			PRINT(BANCS.INPARAM.BINDVARS)
			lv_d = urhk_dbSelectWithBind(lv_s)
			PRINT(lv_d)
			IF(lv_d == 0)THEN
			#{
				CUST.INTERFACE.chargeDrAcctID = BANCS.OUTPARAM.chargeDrAcctID
				PRINT(CUST.INTERFACE.chargeDrAcctID)
			#}
			ENDIF
			#}
			
			PRINT(CUST.CIEREV.chargeAmt)
			IF((CDOUBLE(CUST.CIEREV.chargeAmt)==0) OR (TRIM(CUST.CIEREV.chargeAmt)==""))THEN
			#{
				CUST.INTERFACE.chargeTranAmt="0"
			#}
			ENDIF
			
		#}
		ENDIF
		
		lv_f = urhk_dbCursorFetch(lv_n)
		PRINT(lv_f)
	#}
	DO
	
	lv_c = urhk_dbCursorClose(lv_n)
	PRINT(lv_c)
	
	CALL("cietxnmn003.scr")
	
	IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
	#{
		lv_u = urhk_dbSqlWithBind("ROLLBACK")
		PRINT(lv_u)
		lv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		PRINT(lv_u)
		lv_u = urhk_SetOrbOut("Error_1|Error^Could not create transaction in the other entity^prodCode")
		PRINT(lv_u)
		
		lv_a = CUST.INTERFACE.errorDesc
		
		lv_l = STRLEN(lv_a)
		lv_n = 0
		lv_s = ""
		WHILE(lv_n < lv_l)
		#{
			PRINT(lv_a)
			PRINT(lv_n)
			lv_c = ""
			lv_c = MID$(lv_a,lv_n,1)
			PRINT(lv_c)
			
			IF(lv_c == "|")THEN
			#{
				PRINT("IF")
				lv_s = lv_s + " - "
				PRINT(lv_s)
				GOTO NEXT_CHAR
			#}
			ENDIF
			
			IF(lv_c == "'")THEN
			#{
				PRINT("IF")
				lv_s = lv_s + ""
				PRINT(lv_s)
				GOTO NEXT_CHAR
			#}
			ENDIF
			
			lv_s = lv_s + lv_c
			PRINT(lv_s)
			
			NEXT_CHAR:
				
				lv_n = lv_n + 1
			#}
			DO
			
			PRINT(lv_a)
			PRINT(lv_s)
			
			CUST.INTERFACE.errorDesc = lv_s
			CUST.INTERFACE.errorDesc = CUST.INTERFACE.errorCode + " - " + CUST.INTERFACE.errorDesc
			PRINT(CUST.INTERFACE.errorDesc)
			
			lv_s = "Error_2|Error^"+ CUST.INTERFACE.errorDesc + "^prodCode"
			lv_u = urhk_SetOrbOut(lv_s)
			PRINT(lv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIEREV.revEntity2TranId = CUST.INTERFACE.tranId
		CUST.CIEREV.revEntity2TranDate = MID$(CUST.INTERFACE.tranDate,0,10)
		
		PRINT(CUST.CIEREV.revEntity2TranId)
		PRINT(CUST.CIEREV.revEntity2TranDate)
		
		#-------------------------------------------------------------
		# Update IETD for Txn Reversal
		#-------------------------------------------------------------
		
		CUST.CIEREV.scriptSuccess = "N"
		
		CALL("cierevdp008.scr")
		
		IF(CUST.CIEREV.scriptSuccess == "N")THEN
		#{
			lv_u = urhk_dbSqlWithBind("ROLLBACK")
			PRINT(lv_u)
			lv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			PRINT(lv_u)
			lv_u = urhk_SetOrbOut("Error_1|Error^Custom Table Update operation failed^prodCode")
			PRINT(lv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------
		# Inserting Values into custom table custom.ierev
		#-------------------------------------------------------------
		
		BANCS.INPARAM.BINDVARS = CUST.CIEREV.ieTxnRefNo+"|"+CUST.CIEREV.entity1TranId+"|"+CUST.CIEREV.entity1TranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.entity2TranId+"|"+CUST.CIEREV.entity2TranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"||"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.revEntity1TranId+"|"+CUST.CIEREV.revEntity1TranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.CIEREV.revEntity2TranId+"|"+CUST.CIEREV.revEntity2TranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"||"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|N|Y|"+BANCS.STDIN.userId+"|"+BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		lv_s = "INSERT INTO custom.ierev "
		lv_s = lv_s + "VALUES (?SVAR,?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,to_date(?SVAR,'DD-MM-YYYY'),"
		lv_s = lv_s + "?SVAR,?SVAR,?SVAR,sysdate,?SVAR,sysdate,?SVAR)"
		PRINT(lv_s)
		lv_d = urhk_dbSqlWithBind(lv_s)
		PRINT(lv_d)
		IF (lv_d != 0) THEN
		#{
			lv_u = urhk_dbSqlWithBind("ROLLBACK")
			PRINT("insertion failed")
			lv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			PRINT(lv_u)
			lv_u = urhk_SetOrbOut("Error_1|Error^Custom Table Insert Operation failed^prodCode")
			PRINT(lv_u)
			GOTO ENDOFSCRIPT
			
		#}
		ENDIF
		
		#-------------------------------------------------------------
		# Send the Result Page Details to front end
		#-------------------------------------------------------------
		
		lv_s = "RESULT_MSG|Inter Entity Transaction Reversed Successfully"
		lv_s = lv_s + "!" + CUST.CIEREV.initEntity + "!" + CUST.CIEREV.revEntity1TranId + "!" + CUST.CIEREV.revEntity1TranDate + "!" + CUST.CIEREV.targetEntity + "!" + CUST.CIEREV.revEntity2TranId + "!" + CUST.CIEREV.revEntity2TranDate + "!--!--"
		PRINT(lv_s)
		lv_u = urhk_SetOrbOut(lv_s)
		PRINT(lv_u)
		lv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		PRINT(lv_u)
		
	ENDOFSCRIPT:
		
END-->
