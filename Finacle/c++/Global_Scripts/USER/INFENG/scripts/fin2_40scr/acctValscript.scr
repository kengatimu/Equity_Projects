<--STARt
TRACE ON

IF (REPEXISTS("CUST") == 0) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DORM") == 0) THEN
#{
    CREATECLASS("CUST","DORM",5)
#}
ENDIF

print(BANCS.INPUT.acctNo)

BANCS.INPUT.acctNo = TRIM(BANCS.INPUT.acctNo)

print(BANCS.INPUT.acctNo)

sv_s = "acid,schm_type,count|SELECT acid,schm_type,count(*) "
sv_s = sv_s + "FROM TBAADM.GAM "
sv_s = sv_s + "WHERE bank_id  = ?SVAR  "
sv_s = sv_s + "AND foracid = ?SVAR "
sv_s = sv_s + "AND schm_type IN ('SBA','CAA') " 
sv_s = sv_s + "AND acct_cls_flg = 'N' "
sv_s = sv_s + "AND entity_cre_flg = 'Y' "
sv_s = sv_s + "AND del_flg = 'N' "
sv_s = sv_s + "GROUP BY acid, schm_type "
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.acctNo

sv_u = urhk_dbSelectWithBind(sv_s)
PRINT(sv_u)

IF( sv_u == 0 ) THEN
#{
		
	PRINT(BANCS.OUTPARAM.count)
	PRINT(BANCS.OUTPARAM.acid)
	PRINT(BANCS.OUTPARAM.schm_type)
	
	sv_s = "acctStatus|SELECT acct_status "
	sv_s = sv_s + "FROM TBAADM.SMT "
	sv_s = sv_s + "WHERE acid = ?SVAR  "
	sv_s = sv_s + "AND bank_id= ?SVAR  "
	BANCS.INPARAM.BINDVARS = BANCS.OUTPARAM.acid + "|" + BANCS.STDIN.contextBankId 

	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)	
	PRINT(BANCS.OUTPARAM.acctStatus)
	sv_m = ""
	sv_m = BANCS.OUTPARAM.acctStatus
    sv_b = "actext|" + "N"  
    sv_z = urhk_SetOrbOut(sv_b)
	
	IF( sv_m != "" ) THEN
	#{
		sv_c = "status|" + sv_m
    	sv_y = urhk_SetOrbOut(sv_c)
	#}
	ENDIF
#}
ELSE
#{

    sv_b = "actext|" + "C"
    sv_z = urhk_SetOrbOut(sv_b)
#}
ENDIF

TRACE OFF
EXITSCRIPT
END-->
