#***********************************************************************************************************************
# Filename              : astclsdp005.scr
# Description           : This script is used to check and update teh classification if the normal upgrade date is BOD
#			: or watch upgrade date is BOD or both and based on that update the classifcation
# Input                 :
# Output                :
# Called Script         :astclsdp003.scr,astclsdp004.scr
# Calling Script        :astclsdp001.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----          ------           --------          ----------------        ---------
#   1          17-06-2013       Kalvin		      Original Version          1.0
#***********************************************************************************************************************

<--START
CHECKSUM="b41b6db5b2af82f712e4b5a25cbaf100d6387460cb6a50e4abfa7e7cef886686"
	TRACE ON
	
	#------------------------------------------------------------------
	# Checking the Normal upgrade date  and watch upgrade date of the
	# account and updating the status based on the same
	#------------------------------------------------------------------
	#-----------------------------------------------------------------------------------------------------
	#Check  upgr_watch_date =  BOD.
	#If current_dpd = 0 then main classification would be updated as PA and sub classification WATCH
	#-------------------------------------------------------------------------------------------------
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ASSETS.foracid
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" + BANCS.STDIN.BODDate + "|" + "0"
	sv_s = "recCount|SELECT COUNT(*) FROM CUSTOM.C_CAC WHERE"
	sv_s = sv_s + " BANK_ID = ?SVAR AND FORACID = ?SVAR   "
	sv_s = sv_s + " AND UPGR_WATCH_DATE<= TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss') "
	sv_s = sv_S + " AND CURRENT_DPD =?SVAR"
	sv_d =  urhk_dbSelectWithBind(sv_s)
	
	PRINT(BANCS.OUTPARAM.recCount)
	IF(BANCS.OUTPARAM.recCount != 0) THEN
	#{
		PRINT("inside IF loop ")
		CUST.ASSETS.mainClassificationSystem="PA"
		CUST.ASSETS.subClassificationSystem="WATC"
		CUST.ASSETS.getWatchUpgrDate = "N"
		CUST.ASSETS.getNrmlUpgrDate = "Y"
		CUST.ASSETS.assetClsReasonCode = "UPGR"
		CALL("astclsdp002.scr")
		#-------------------------------------------------
		# Update the details into custom table
		#-------------------------------------------------
		CALL("astclsdp003.scr")
		
		
		#}
	ELSE
		#{
		PRINT("inside ELSE loop ")
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ASSETS.foracid
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" + BANCS.STDIN.BODDate + "|" + "0"
		sv_s = "recCount|SELECT COUNT(*) FROM CUSTOM.C_CAC WHERE"
		sv_s = sv_s + " BANK_ID = ?SVAR AND FORACID = ?SVAR   "
		sv_s = sv_s + " AND UPGR_NORMAL_DATE<=TO_DATE(?SVAR,'DD-MM-YYYY hh24:mi:ss')"
		sv_s = sv_s + "  AND CURRENT_DPD =?SVAR"
		sv_d =  urhk_dbSelectWithBind(sv_s)
		IF(BANCS.OUTPARAM.recCount != 0) THEN
		#{
			#---------------------------------------------------------------------
			#Check if upgr_nrml_date =  BOD.and current_dpd = 0
			#then main classification would be updated as PA
			#and sub classification would be updated as NORM
			#The entry in C_CAC would be removed and the old entry would be moved to C_CACH.
			#---------------------------------------------------------------------
			CALL("astclsdp004.scr")
			IF(CUST.ASSETS.statusCACH == "Y") THEN
			#{
				BANCS.INPARAM.BINDVARS = "Y"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSETS.foracid
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_s = "UPDATE CUSTOM.C_CAC SET"
				sv_s = sv_s + " DEL_FLG = ?SVAR,"
				sv_s = sv_s + " WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR"
				sv_d = urhk_dbSqlWithBind(sv_s)
				print(sv_d)
				
				CUST.ASSETS.mainClassificationSystem="PA"
				CUST.ASSETS.subClassificationSystem="NORM"
				CUST.ASSETS.assetClsReasonCode = "UPGR"
			#}
			ENDIF
		#}
		ENDIF
		
	#}
	ENDIF
	
	#trace off
END-->
