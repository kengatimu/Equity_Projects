<--START
CHECKSUM="7569391b39deeaceb82460f8186812ba91b716247cc8c64ddd18808e3d28bd69"
	TRACE ON
	
	######################################################################################
	# Set FI Input and Call XferTranAdd API
	######################################################################################
	
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	CUST.CIECLG.chargeAmtInCrAcctCcy = "0.00"
	
	BANCS.INPARAM.InputAmount = CUST.CIECLG.chargeAmt
	BANCS.INPARAM.FromCurrency = CUST.CIECLG.chargeAmtCcy
	BANCS.INPARAM.ToCurrency = CUST.CIECLG.crAcctNumCcy
	BANCS.INPARAM.RateCode = "MEAN"
	BANCS.INPARAM.Rate = 0.00
	BANCS.INPARAM.CustId = ""
	
	sv_u = urhk_B2k_ConvertAmount("")
	print(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.CIECLG.chargeAmtInCrAcctCcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
	#}
	ENDIF
	
	print(BANCS.STDIN.sysDate)
	
	sv_s = "RequestID|SELECT CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0)THEN
	#{
		CUST.CIECLG.RequestID = BANCS.OUTPARAM.RequestID
		print(CUST.CIECLG.RequestID)
		#}
	ELSE
		#{
		CUST.CIECLG.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(CUST.CIECLG.RequestID)
	#}
	ENDIF
	
	CUST.INTERFACE.interfaceRequestID = "XferTrnAdd"
	CUST.INTERFACE.interfaceRequestVersion = "10.2"
	CUST.INTERFACE.RequestID = CUST.CIECLG.RequestID
	CUST.INTERFACE.bankID = CUST.CIECLG.creditEntity
	CUST.INTERFACE.channelID = "COR"
	CUST.INTERFACE.tranType = "T"
	CUST.INTERFACE.tranSubType = "BI"
	CUST.INTERFACE.drAcctID = CUST.CIECLG.crAcctNum
	CUST.INTERFACE.crAcctID = CUST.CIECLG.vostroAcct
	CUST.INTERFACE.tranAmt = CUST.CIECLG.chargeAmtInCrAcctCcy
	CUST.INTERFACE.tranCcy = CUST.CIECLG.crAcctNumCcy
	CUST.INTERFACE.tranParticulars = "Inter Entity Clearing Charge"
	CUST.INTERFACE.tranRmks = CUST.CIECLG.chargeTranId + " / " + CUST.CIECLG.chargeTranDate
	CUST.INTERFACE.drValueDate = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.INTERFACE.rateCode = "MEAN"
	CUST.INTERFACE.drRate = "1.00"
	CUST.INTERFACE.crRate = "1.00"
	CUST.INTERFACE.chkInstDetails = "N"
	CUST.INTERFACE.instDate = ""
	CUST.INTERFACE.instAlpha = ""
	CUST.INTERFACE.instNum = ""
	CUST.INTERFACE.instType = ""
	
	CUST.INTERFACE.errorMsgFlg = "N"
	CUST.INTERFACE.errorMsgCode = " "
	CUST.INTERFACE.errorMsgDesc = " "
	
	CALL("cietxnmn003.scr")
	
	IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
	#{
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Could not create transaction in the other entity^prodCode")
		print(sv_u)
		sv_s = "Error_2|Error^"+ CUST.INTERFACE.errorMsgDesc + "^prodCode"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.targetChargeTranId = CUST.INTERFACE.tranId
	CUST.CIECLG.targetChargeTranDate = MID$(CUST.INTERFACE.tranDate,0,10)
	
	ENDOFSCRIPT:
		
		
END-->
