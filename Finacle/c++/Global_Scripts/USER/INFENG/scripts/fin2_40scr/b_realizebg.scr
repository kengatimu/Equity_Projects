<--START
CHECKSUM="c1733418d30be39238db84775eda3d7c0443370679f41699c78a41ce71e76a4"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	sv_a=urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_a)
	
	sv_r = REPEXISTS("CUSTS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUSTS", "GLBDATA", 5)
	#}
	ENDIF

	CUSTS.GLBDATA.sysDate = MID$(BANCS.STDIN.sysDate,0,10)
	print(CUSTS.GLBDATA.sysDate)
	
	sv_q="BGSRLNUM,solId,custid,bgamt,crncycode,issuedate,b2kid,operacid,bgType|"
	sv_q = sv_q + "select BG_SRL_NUM,sol_id,cust_id,bg_amt,crncy_code, "
	sv_q = sv_q + "to_char (to_date(issue_date,'DD-MM-YY'), 'DD-MM-YYYY HH24:MI:SS'), "
	sv_q = sv_q + "BG_B2KID,OPER_ACID,BG_TYPE from tbaadm.bgm where FUNC_CODE= 'A' "
	#sv_q = sv_q + "and bank_id= ?SVAR and BG_EXPIRY_DATE=TO_CHAR(TO_DATE('29-03-2018','DD-MM-YYYY'), 'DD-MON-YYYY') "
	sv_q = sv_q + "and bank_id= ?SVAR and BG_EXPIRY_DATE=TO_CHAR(TO_DATE(?SVAR,'DD-MM-YYYY'), 'DD-MON-YYYY') "
	PRINT(sv_q)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUSTS.GLBDATA.sysDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_e = urhk_dbCursorOpenWithBind(sv_q)
	
	IF(sv_e==0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		PRINT(sv_q)
		
		WHILE(sv_q==0)
		#{
			CUSTS.GLBDATA.BGSRLNUM=BANCS.OUTPARAM.BGSRLNUM
			PRINT(CUSTS.GLBDATA.BGSRLNUM)
			CUSTS.GLBDATA.solId=BANCS.OUTPARAM.solId
			PRINT(CUSTS.GLBDATA.solId)
			CUSTS.GLBDATA.custid=BANCS.OUTPARAM.custid
			PRINT(CUSTS.GLBDATA.custid)
			CUSTS.GLBDATA.bgamt=BANCS.OUTPARAM.bgamt
			PRINT(CUSTS.GLBDATA.bgamt)
			CUSTS.GLBDATA.crncycode=BANCS.OUTPARAM.crncycode
			PRINT(CUSTS.GLBDATA.crncycode)
			CUSTS.GLBDATA.issuedate=BANCS.OUTPARAM.issuedate
			PRINT(CUSTS.GLBDATA.issuedate)
			CUSTS.GLBDATA.b2kid=BANCS.OUTPARAM.b2kid
			PRINT(CUSTS.GLBDATA.b2kid)
			CUSTS.GLBDATA.operacid=BANCS.OUTPARAM.operacid
			PRINT(CUSTS.GLBDATA.operacid)
			CUSTS.GLBDATA.bgType=BANCS.OUTPARAM.bgType
			PRINT(CUSTS.GLBDATA.bgType)

						
			sv_u = "foracid,cifId|"
			sv_u = sv_u + "select foracid,cif_id from tbaadm.gam  "
			sv_u = sv_u + " where acid = ?SVAR  AND bank_id= ?SVAR"
			PRINT(sv_u)
			
			BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.operacid + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_w =  urhk_dbSelectWithBind(sv_u)
			PRINT(sv_w)
			
			IF (sv_w==0) THEN
			#{
				CUSTS.GLBDATA.foracid=BANCS.OUTPARAM.foracid
				PRINT(CUSTS.GLBDATA.foracid)
				CUSTS.GLBDATA.cifId=BANCS.OUTPARAM.cifId
				PRINT(CUSTS.GLBDATA.cifId)
				
				PRINT(CUSTS.GLBDATA.solId)
				
				IF(CUSTS.GLBDATA.solId != BANCS.STDIN.mySolId)THEN
				#{
					sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.GLBDATA.solId)
					PRINT(sv_u)
					sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
					PRINT(sv_u)
				#}
				ENDIF
			#}
			ENDIF
						
			sv_u = urhk_SetUrhkInp("bgCritDtl.bgFuncCode|R")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("bgCritDtl.bgSrlNum|" + CUSTS.GLBDATA.BGSRLNUM)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("bgCritDtl.bgSolId.solId|" + CUSTS.GLBDATA.solId)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("bgCritDtl.bgCritCrncy|" + CUSTS.GLBDATA.crncycode)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("bgCommonDtl.bgB2kId|" + CUSTS.GLBDATA.b2kid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("bgCritDtl.inOutInd|O")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("bgCritDtl.isEntityIslamic|N")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("bgCritDtl.amendType|")
			PRINT(sv_u)

			sv_u = urhk_ExecSrv("SRV_FetchBGDtlsForReversal|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			
			IF(sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)

				sv_u = urhk_SetUrhkInp("bgCritDtl.bgType.type|" + CUSTS.GLBDATA.bgType)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCritDtl.bgApplCifId.cifId|" + CUSTS.GLBDATA.cifId)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgGeneralDtl.applOperAcct.foracid|" + CUSTS.GLBDATA.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgGeneralDtl.bgAmt|" + CUSTS.GLBDATA.bgamt + "|" + CUSTS.GLBDATA.crncycode)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgGeneralDtl.bgAmtCrncy|" + CUSTS.GLBDATA.crncycode)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgGeneralDtl.bgIssueDate|" + CUSTS.GLBDATA.issuedate)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgGeneralDtl.bgStatus|A")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgMarginMsg.tfcMarginHeader.operAcct.foracid|" +CUSTS.GLBDATA.foracid )
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgGeneralDtl.bgCloseOnReverse|Y")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgInstDtls.bgInstHeader.rateCode.refCode|MEAN")
				PRINT(sv_u)
				
				sv_u = urhk_ExecSrv("SRV_ReversalOutwardBGDtls|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)

			#}
			ENDIF
			
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_SetUrhkInp("bgCritDtl.bgFuncCode|V")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCritDtl.bgSrlNum|" + CUSTS.GLBDATA.BGSRLNUM)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCritDtl.bgSolId.solId|" + CUSTS.GLBDATA.solId)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCritDtl.bgCritCrncy|" + CUSTS.GLBDATA.crncycode)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCommonDtl.bgB2kId|" + CUSTS.GLBDATA.b2kid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCritDtl.inOutInd|O")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCritDtl.isEntityIslamic|N")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("bgCritDtl.amendType|")
				PRINT(sv_u)

				sv_u = urhk_ExecSrv("SRV_FetchBGDtlsForVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				
				IF(sv_u == 0) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					PRINT(sv_u)

					sv_u = urhk_SetUrhkInp("bgGeneralDtl.bgType.type|" + CUSTS.GLBDATA.bgType)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("bgCritDtl.bgApplCifId.cifId|" + CUSTS.GLBDATA.cifId)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("bgCommonDtl.bgEvent|R")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("bgGeneralDtl.bgAmt|" + CUSTS.GLBDATA.bgamt + "|" + CUSTS.GLBDATA.crncycode)
					PRINT(sv_u)
			
					sv_u = urhk_ExecSrv("SRV_VerifyOutwardBGDtls|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)

				#}
				ENDIF				

				IF(sv_u !=0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						PRINT(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					
					IF (sv_v > 0) THEN
					#{
						sv_u = SYSTEM("echo 'Error for BG:"+CUSTS.GLBDATA.BGSRLNUM+" ' >>BgVerify.log")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							PRINT(sv_e)
							sv_i = sv_i + 1
							sv_u = SYSTEM("echo '"+sv_e+"' >>BgVerify.log")
							PRINT(sv_u)
						#}
						DO
					#}
					ENDIF
				#}
				ENDIF

				
			#}
			ELSE
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				
				IF (sv_v > 0) THEN
				#{
					sv_u = SYSTEM("echo 'Error for BG:"+CUSTS.GLBDATA.BGSRLNUM+" ' >>Bgrealize.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_i = sv_i + 1
						sv_u = SYSTEM("echo '"+sv_e+"' >>Bgrealize.log")
						PRINT(sv_u)
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
				
			sv_q = urhk_dbCursorFetch(sv_m)
			PRINT(sv_q)
			
		#}
		DO
		sv_d = urhk_dbCursorClose(sv_m)
		PRINT(sv_d)
		
	#}
	ENDIF
	
	
	TRACE OFF
	EXITSCRIPT
END-->
