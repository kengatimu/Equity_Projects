				BANCS.INPARAM.BINDVARS = BANCS.INPUT.drAcct + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_u =  urhk_dbSelectWithBind(sv_s)
				IF(sv_u == 0) THEN
				#{
					CUST.DATA.chrgEventId = BANCS.OUTPARAM.event
					print(CUST.DATA.chrgEventId)
					sv_b = urhk_SRV_SetVal("pordPaymentDtls.chrgEventId.eventId|"+CUST.DATA.chrgEventId)
					print(sv_b)
				#}
				ENDIF
				#}
			ELSE
				#{
				IF ((sv_e=="OUR") AND (CUST.DATA.paysysId=="SWIFT")) THEN
				#{
					
					CUST.DATA.chrgEventId = "SWIFTOUR"
					print(CUST.DATA.chrgEventId)
					
					sv_b = urhk_SRV_SetVal("pordPaymentDtls.chrgEventId.eventId|"+CUST.DATA.chrgEventId)
					print(sv_b)
					
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			IF ((sv_e=="OUR") AND (CUST.DATA.paysysId=="SWIFT")) THEN
			#{
				
				CUST.DATA.chrgEventId = "SWIFTOUR"
				print(CUST.DATA.chrgEventId)
				
				sv_b = urhk_SRV_SetVal("pordPaymentDtls.chrgEventId.eventId|"+CUST.DATA.chrgEventId)
				print(sv_b)
				
			#}
			ENDIF
		#}
		ENDIF
		#}
	ELSE
		#{
		IF (CUST.DATA.paysysId=="RTGS") THEN
		#{
			sv_s = "COUNT|SELECT COUNT(1) FROM CUSTOM.ALL_ACCT_EXEMPTION_TABLE "
			sv_s = sv_s + " WHERE FORACID = ?SVAR"
			sv_s = sv_s + " AND bank_id = ?SVAR AND CHARGE_TYPE='RTGS' "
