		#{
			PRINT(BANCS.OUTPARAM.COUNT)
			IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
			#{
				sv_s = "event|SELECT EVENT_ID FROM CUSTOM.ALL_ACCT_EXEMPTION_TABLE "
				sv_s = sv_s + " WHERE FORACID = ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR AND CHARGE_TYPE='OUTSWIFT' "
