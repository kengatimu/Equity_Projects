	#}
	ENDIF
	
	
	IF ((TRIM(CUST.LAOPN.FI)) == CUST.CPARAM.fi) THEN
	#{
		#--------------------------------------------------------------------
		#To get the BODDate and SYSDate from the BANCS Repository
		#--------------------------------------------------------------------
		PRINT(BANCS.STDIN.sysDate)
		PRINT(BANCS.STDIN.BODDate)
		CUST.LAOPN.sys_timestamp = BANCS.STDIN.sysDate
		CUST.LAOPN.bod_timestamp = BANCS.STDIN.BODDate
		CUST.LAOPN.BODDate = LEFT$(CUST.LAOPN.bod_timestamp,10)
		PRINT(CUST.LAOPN.BODDate)
		CUST.LAOPN.SYSDate = LEFT$(CUST.LAOPN.sys_timestamp,10)
		PRINT(CUST.LAOPN.SYSDate)
		
		#--------------------------------------------------------
		#To handle the unique validation
		#--------------------------------------------------------
		IF ((STRLEN(TRIM(CUST.LAOPN.App_Id))) > 0) THEN
		#{
			GOTO COUNT
			#}
		ELSE
			#{
			CUST.LAOPN.errMsg = "acctCommonInfo.acctClassMISC.freeText3|MIS code free_text3 is mandatory"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		COUNT:
			sv_s ="count|"
			sv_s = sv_s + " SELECT COUNT(*) FROM CUSTOM.C_EQBK"
			sv_s = sv_s + " WHERE C_EQBK.app_id =?SVAR"
			sv_s = sv_s + " AND C_EQBK.mod_code=?SVAR"
			sv_s = sv_s + " AND C_EQBK.bank_id=?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.LAOPN.App_Id + "|" + CUST.CPARAM.mod_code + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbselectWithBind(sv_s)
			IF ( sv_d == 0 ) THEN
			#{
				PRINT(BANCS.OUTPARAM.count)
				CUST.LAOPN.count=BANCS.OUTPARAM.count
				PRINT(CUST.LAOPN.count)
				
				IF (CINT(CUST.LAOPN.count)==0) THEN
				#{
					sv_s = "INSERT INTO CUSTOM.C_EQBK(TRAN_DATE,BOD_DATE,APP_ID,MOD_CODE,PROCESSED_FLG,START_TIME,BANK_ID) values ("
					sv_s = sv_s + "to_date(?SVAR,'dd-mm-yyyy'),"
					sv_s = sv_s + "to_date(?SVAR,'dd-mm-yyyy'),"
					sv_s = sv_s + "?SVAR,"
					sv_s = sv_s + "?SVAR,"
					sv_s = sv_s + "?SVAR,"
					sv_s = sv_s + "sysdate,"
					sv_s = sv_s + "?SVAR)"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.LAOPN.SYSDate +"|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LAOPN.BODDate + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LAOPN.App_Id + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.mod_code + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.processed_flag + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					
					IF ( sv_d!=0 ) THEN
					#{
						CUST.LAOPN.errMsg = "Too many Requests for same Application ID at the same instance from two OR more different Users."
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					GOTO LOGIC
					#}
				ELSE
					#{
					sv_s ="count|"
					sv_s = sv_s + " SELECT COUNT(*) FROM CUSTOM.C_EQBK"
					sv_s = sv_s + " WHERE app_id =?SVAR"
					sv_s = sv_s + " AND (sysdate-start_time) > ?SVAR"
					sv_s = sv_s + " AND bank_id =?SVAR"
					BANCS.INPARAM.BINDVARS = CUST.LAOPN.App_Id + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.sysstartdate + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbselectWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						PRINT(BANCS.OUTPARAM.count)
						CUST.LAOPN.count=BANCS.OUTPARAM.count
						PRINT(CUST.LAOPN.count)
						IF (CINT(CUST.LAOPN.count)!=0) THEN
						#{
							sv_s ="processed_flag,foracid,status|"
							sv_s = sv_s + " SELECT processed_flg,free_text_1,free_text_2"
							sv_s = sv_s + " FROM CUSTOM.C_EQBK"
							sv_s = sv_s + " WHERE app_id =?SVAR"
							sv_s = sv_s + " AND mod_code = ?SVAR"
							sv_s = sv_s + " AND bank_id =?SVAR"
							PRINT(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.LAOPN.App_Id + "|" + CUST.CPARAM.mod_code + "|" + BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbselectWithBind(sv_s)
							IF (sv_d == 0) THEN
							#{
								CUST.LAOPN.processed_flag=BANCS.OUTPARAM.processed_flag
								CUST.LAOPN.foracid=BANCS.OUTPARAM.foracid
								CUST.LAOPN.status=BANCS.OUTPARAM.status
								PRINT(CUST.LAOPN.status)
								PRINT(CUST.LAOPN.processed_flag)
								PRINT(CUST.LAOPN.foracid)
								IF ((CUST.LAOPN.processed_flag == "Y") AND (STRLEN(CUST.LAOPN.foracid) > 0) AND (CUST.LAOPN.status == CUST.CPARAM.status1)) THEN
								#{
									CUST.LAOPN.errMsg = "Duplicate Application ID, Loan account No:" + CUST.LAOPN.foracid + "|" + CUST.LAOPN.status
									GOTO ENDOFSCRIPT
								#}
								ENDIF
								IF ((CUST.LAOPN.processed_flag == "N") AND (STRLEN(CUST.LAOPN.foracid) > 0) AND (CUST.LAOPN.status == CUST.CPARAM.status2)) THEN
								#{
									CUST.LAOPN.errMsg = "Duplicate Application ID, Loan account No:" + CUST.LAOPN.foracid + "|" + CUST.LAOPN.status
									GOTO ENDOFSCRIPT
								#}
								ENDIF
								IF (((CUST.LAOPN.processed_flag) =="N") AND (STRLEN(CUST.LAOPN.foracid) == 0) AND ((CUST.LAOPN.status) == "" )) THEN
								#{
									sv_s ="foracid_gam,entity_cre_flg,del_flg|"
									sv_s = sv_s + " SELECT GAM.foracid,GAM.entity_cre_flg,GAM.del_flg"
									sv_s = sv_s + " FROM TBAADM.GAM"
									sv_s = sv_s + " WHERE GAM.acid IN ("
									sv_s = sv_s + " SELECT GAC.acid FROM GAC"
									sv_s = sv_s + " WHERE GAC.free_text_3 =?SVAR "
									sv_s = sv_s + " AND GAC.bank_id = GAM.bank_id)"
									sv_s = sv_s + " AND GAM.bank_id =?SVAR"
									PRINT(sv_s)
									BANCS.INPARAM.BINDVARS = CUST.LAOPN.App_Id + "|" + BANCS.STDIN.contextBankId
									PRINT(BANCS.INPARAM.BINDVARS)
									sv_d = urhk_dbselectWithBind(sv_s)
									IF (sv_d == 0) THEN
									#{
										PRINT(BANCS.OUTPARAM.foracid_gam)
										PRINT(BANCS.OUTPARAM.entity_cre_flg)
										PRINT(BANCS.OUTPARAM.del_flg)
										CUST.LAOPN.foracid_gam	=BANCS.OUTPARAM.foracid_gam
										CUST.LAOPN.entity_cre_flg	=BANCS.OUTPARAM.entity_cre_flg
										CUST.LAOPN.del_flg	=BANCS.OUTPARAM.del_flg
										IF (((CUST.LAOPN.entity_cre_flg) =="N") AND ((CUST.LAOPN.del_flg) =="N")) THEN
										#{
											PRINT(CUST.LAOPN.App_Id)
											sv_s ="UPDATE CUSTOM.C_EQBK"
											sv_s = sv_s + " SET START_TIME=sysdate,"
											sv_s = sv_s + " end_time=sysdate,"
											sv_s = sv_s + " processed_flg= 'N',"
											sv_s = sv_s + " free_text_1=?SVAR,"
											sv_s = sv_s + " free_text_2 =?SVAR"
											sv_s = sv_s + " WHERE app_id =?SVAR"
											sv_s = sv_s + " AND mod_code =?SVAR"
											sv_s = sv_s + " AND bank_id =?SVAR"
											
											PRINT(sv_s)
											BANCS.INPARAM.BINDVARS = CUST.LAOPN.foracid_gam + "|"
											BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.free_text_2 + "|"
											BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LAOPN.App_Id +"|"
											BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.mod_code + "|"
											BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
											PRINT(BANCS.INPARAM.BINDVARS)
											sv_d = urhk_dbSQLWithBind(sv_s)
											PRINT(sv_d)
											IF (sv_d == 0) THEN
											#{
												PRINT("The table C_EQBK updated successfully")
												#}
											ELSE
												#{
												CUST.LAOPN.errMsg =" The table C_EQBK not updated successfully "
												GOTO ENDOFSCRIPT
											#}
											ENDIF
											#-----------------------------
											#commit c_eqbk Table
											#-----------------------------
											IF ( sv_d!=0 ) THEN
											#{
												CUST.LAOPN.errMsg = "Loan Account opened, but not Verified for this Application ID"
												GOTO ENDOFSCRIPT
											#}
											ENDIF
										#}
										ENDIF
										#}
									ELSE
										#{
										sv_s ="UPDATE CUSTOM.C_EQBK"
										sv_s = sv_s + " SET start_time=sysdate"
										sv_s = sv_s + " WHERE app_id =?SVAR"
										sv_s = sv_s + " AND mod_code =?SVAR"
										sv_s = sv_s + " AND bank_id =?SVAR"
										PRINT(sv_s)
										BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LAOPN.App_Id +"|"
										BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.mod_code + "|"
										BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
										PRINT(BANCS.INPARAM.BINDVARS)
										sv_d = urhk_dbSQLWithBind(sv_s)
										PRINT(sv_d)
										IF (sv_d != 0) THEN
										#{
											CUST.LAOPN.errMsg =" The table C_EQBK not updated successfully "
											GOTO ENDOFSCRIPT
										#}
										ENDIF
										
										GOTO LOGIC
										
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
							#}
						ELSE
							#{
							CUST.LAOPN.errMsg = "Too many Requests for same Application ID at the same instance. Please try after some time."
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						#}
					ELSE
						#{
						CUST.LAOPN.errMsg = "Duplicate Application ID"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				
			LOGIC:
				#-------------------------------------------
				#Fetching EISchmFlg from the database
				#-------------------------------------------
				sv_s = "EISchmFlg|"
				sv_s = sv_s + " SELECT "
				sv_s = sv_s + " LSP.ei_schm_flg "
				sv_s = sv_s + " FROM TBAADM.LSP "
				sv_s = sv_s + " WHERE LSP.crncy_code=?SVAR"
				sv_s = sv_s + " AND LSP.schm_code=?SVAR"
				sv_s = sv_s + " AND LSP.del_flg='N'"
				sv_s = sv_s + " AND LSP.bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.LAOPN.loanCurrency + "|" + CUST.LAOPN.schmCode + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					PRINT(BANCS.OUTPARAM.EISchmFlg)
					CUST.LAOPN.EISchmFlg	=BANCS.OUTPARAM.EISchmFlg
					#}
				ELSE
					#{
					CUST.LAOPN.errMsg = "Select statement of LSP not executed successfully"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				#----------------------------------------------
				#Checking for the EI or NEI type of Account
				#----------------------------------------------
				
				
				PRINT(CUST.LAOPN.loanAmount)
				PRINT(CUST.LAOPN.noOfInstallment)
				PRINT(CUST.LAOPN.EISchmFlg)
				
				IF (CUST.LAOPN.EISchmFlg == "N") THEN
				#{
					#-----------------------------------------
					#NEI type of Account
					#-----------------------------------------
					#X=ABS( Loan Amount/No of Installments)
					CUST.LAOPN.loanAmount	=CDOUBLE(CUST.LAOPN.loanAmount)
					CUST.LAOPN.noOfInstallment=CDOUBLE(CUST.LAOPN.noOfInstallment)
					CUST.LAOPN.CalAmt=(CDOUBLE(CUST.LAOPN.loanAmount)/CDOUBLE(CUST.LAOPN.noOfInstallment))
					PRINT(CUST.LAOPN.CalAmt)
					
					sv_a= urhk_SRV_SetVal("acctRepaymentShdlLA.repaymentLL.<rec_0>.flowAmt|"+CUST.LAOPN.CalAmt+"|"+CUST.LAOPN.loanCurrency)
					sv_a= urhk_SRV_SetVal("acctRepaymentShdlLA.repaymentLL.<rec_1>.flowAmt|0|"+CUST.LAOPN.loanCurrency)
					sv_a= urhk_SRV_SetVal("acctRepaymentShdlLA.repaymentLL.<rec_1>.noOfDemands|0")
					PRINT(sv_a)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
	ENDOFSCRIPT:
		IF (CUST.LAOPN.errMsg != "") THEN
		#{
			PRINT(CUST.LAOPN.errMsg)
			sv_u = urhk_SRV_setErr(CUST.LAOPN.errMsg)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
