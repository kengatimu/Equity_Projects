	IF ((STRLEN(TRIM(CUST.LAOPN.freeText1))) > 0) THEN
	#{
		sv_c = GETPOSITION(CUST.LAOPN.freeText1,"|")
		PRINT(sv_c)
		
		IF (sv_c != 0) THEN
		#{
			#-------------------------------------------------
			#Obtaining the value before the pipe
			#-------------------------------------------------
			sv_d = Left$(CUST.LAOPN.freeText1,sv_c-1)
			PRINT(sv_d)
			CUST.LAOPN.free_Text1 = sv_d
			#-----------------------------------------------
			# Obtaining the length of the amount
			#-----------------------------------------------
			sv_l = STRLEN(TRIM(CUST.LAOPN.freeText1))
			PRINT(sv_l)
			PRINT(sv_c)
			#--------------------------------------------------
			#Obtaining the value after the pipe
			#-------------------------------------------------
			sv_g = MID$(CUST.LAOPN.freeText1,sv_c,sv_l)
			PRINT(sv_g)
			CUST.LAOPN.FI = sv_g
			sv_a= urhk_SRV_SetVal("acctCommonInfo.acctClassMISC.freeText1|"+ CUST.LAOPN.free_Text1)
			#}
		ELSE
