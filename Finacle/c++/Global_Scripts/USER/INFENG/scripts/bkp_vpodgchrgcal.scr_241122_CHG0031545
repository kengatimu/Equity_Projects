<--start
trace on
#Rep/Class
        if(repexists("EQCHRG")==0)then
        #{
                createrep("EQCHRG")
        #}
        endif
        if(classexists("EQCHRG","GLBDATA")==0)then
        #}
                createclass("EQCHRG","GLBDATA",5)
        #}
        endif
        EQCHRG.GLBDATA.schmcode = ""
        if(fieldexists(EQSRV.GLBDATA.schmCode)==1)then
                EQCHRG.GLBDATA.schmcode = EQSRV.GLBDATA.schmCode
        endif
        if(fieldexists(EQSRV.GLBDATA.odSchmCode)==1)then
                EQCHRG.GLBDATA.schmcode = EQSRV.GLBDATA.odSchmCode
        endif
        if(fieldexists(EQSRV.GLBDATA.ChargeModule)==1)then
                if(EQSRV.GLBDATA.ChargeModule=="ODCR")then
                if(fieldexists(EQSRV.GLBDATA.sanctionLimit)==1)then
                        EQCHRG.GLBDATA.amnt = cdouble(EQSRV.GLBDATA.sanctionLimit)
                        EQCHRG.GLBDATA.crsamnt = cdouble(EQSRV.GLBDATA.sanctionLimit)
                else
                        EQCHRG.GLBDATA.amnt = "0"
                        EQCHRG.GLBDATA.crsamnt = "0"
                endif
                endif
                if(EQSRV.GLBDATA.ChargeModule=="ACLHM")then
                if(fieldexists(EQSRV.GLBDATA.rtLoanAmount)==1)then
                        EQCHRG.GLBDATA.amnt = cdouble(EQSRV.GLBDATA.rtLoanAmount)
                        EQCHRG.GLBDATA.crsamnt = cdouble(EQSRV.GLBDATA.rtLoanAmount)
                else
                        EQCHRG.GLBDATA.amnt = "0"
                        EQCHRG.GLBDATA.crsamnt = "0"
                endif
                endif
        endif
        #-------------------Vino Palani SS scheme OD112/bank id added INC0134488/---vino Palani new scheme CHG0031416 27102022
        if((BANCS.STDIN.contextBankId=="54") or (BANCS.STDIN.contextBankId=="56") or (BANCS.STDIN.contextBankId=="11") or (BANCS.STDIN.contextBankId=="43"))then
        #{
                if((EQCHRG.GLBDATA.schmcode=="OD542") or (EQCHRG.GLBDATA.schmcode=="OD543") or (EQCHRG.GLBDATA.schmcode=="OD545") or (EQCHRG.GLBDATA.schmcode=="OD546") or (EQCHRG.GLBDATA.schmcode=="OD112") or (EQCHRG.GLBDATA.schmcode=="DL002"))then
                #{
                        EQCHRG.GLBDATA.laceAmt = cdouble(EQCHRG.GLBDATA.amnt) * 5/100
                        print(EQCHRG.GLBDATA.laceAmt)
                        EQCHRG.GLBDATA.insAmt = cdouble(EQCHRG.GLBDATA.amnt) * 1/100
                        print(EQCHRG.GLBDATA.insAmt)
                        EQCHRG.GLBDATA.exciseDuty = cdouble(EQCHRG.GLBDATA.laceAmt) *20/100
                        print(EQCHRG.GLBDATA.exciseDuty)
                        EQCHRG.GLBDATA.totalChrgAmt = cdouble(EQCHRG.GLBDATA.laceAmt) + cdouble(EQCHRG.GLBDATA.insAmt) + cdouble(EQCHRG.GLBDATA.exciseDuty)
                        print(EQCHRG.GLBDATA.totalChrgAmt)
                #}
                endif
                if(EQCHRG.GLBDATA.schmcode=="OD544")then
                #{
                        print(EQCHRG.GLBDATA.crsamnt)
                        EQCHRG.GLBDATA.laceAmt = cdouble(EQCHRG.GLBDATA.crsamnt) * 3/100
                        print(EQCHRG.GLBDATA.laceAmt)
                        EQCHRG.GLBDATA.insAmt = cdouble(EQCHRG.GLBDATA.crsamnt) * 0.625000/100
                        print(EQCHRG.GLBDATA.insAmt)
                        EQCHRG.GLBDATA.exciseDuty = cdouble(EQCHRG.GLBDATA.laceAmt) *20/100
                        print(EQCHRG.GLBDATA.exciseDuty)
                        ##EQCHRG.GLBDATA.exciseDuty = cdouble("0")
                        EQCHRG.GLBDATA.totalChrgAmt = cdouble(EQCHRG.GLBDATA.laceAmt) + cdouble(EQCHRG.GLBDATA.insAmt) + cdouble(EQCHRG.GLBDATA.exciseDuty)
                        print(EQCHRG.GLBDATA.totalChrgAmt)
                #}
                endif
		#---vino Palani CHG0031416 27102022
		if(EQCHRG.GLBDATA.schmcode=="ML001")then
                #{
                        EQCHRG.GLBDATA.laceAmt = cdouble(EQCHRG.GLBDATA.amnt) * 1.23917/100
                        print(EQCHRG.GLBDATA.laceAmt)
                        EQCHRG.GLBDATA.insAmt = cdouble(EQCHRG.GLBDATA.amnt) * 0.013/100
                        print(EQCHRG.GLBDATA.insAmt)
                        EQCHRG.GLBDATA.exciseDuty = cdouble(EQCHRG.GLBDATA.laceAmt) *20/100
                        print(EQCHRG.GLBDATA.exciseDuty)
                        EQCHRG.GLBDATA.totalChrgAmt = cdouble(EQCHRG.GLBDATA.laceAmt) + cdouble(EQCHRG.GLBDATA.insAmt) + cdouble(EQCHRG.GLBDATA.exciseDuty)
                        print(EQCHRG.GLBDATA.totalChrgAmt)
                #}
                endif
        #}
        endif
        if(cdouble(EQCHRG.GLBDATA.totalChrgAmt)>0)then
        #{
                if(EQSRV.GLBDATA.ChargeModule=="ODCR")then
                        EQCHRG.GLBDATA.finalLoanSanctAmt = cdouble(EQSRV.GLBDATA.sanctionLimit) + cdouble(EQCHRG.GLBDATA.totalChrgAmt)
                endif
                if(EQSRV.GLBDATA.ChargeModule=="ACLHM")then
                        EQCHRG.GLBDATA.finalLoanSanctAmt = cdouble(EQSRV.GLBDATA.rtLoanAmount) + cdouble(EQCHRG.GLBDATA.totalChrgAmt)
                endif
        #}
        else
        #{
                if(EQSRV.GLBDATA.ChargeModule=="ODCR")then
                        EQCHRG.GLBDATA.finalLoanSanctAmt = cdouble(EQSRV.GLBDATA.sanctionLimit)
                endif
                if(EQSRV.GLBDATA.ChargeModule=="ACLHM")then
                        EQCHRG.GLBDATA.finalLoanSanctAmt = cdouble(EQSRV.GLBDATA.rtLoanAmount)
                endif
        #}
        endif


##trace off
end-->
