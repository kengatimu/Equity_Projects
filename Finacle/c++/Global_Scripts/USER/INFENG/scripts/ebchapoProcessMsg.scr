<--start
trace on
#Reps/Class
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("CUST","ALERTS")==0)then
                createclass("CUST","ALERTS",5)
        endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_r = urhk_MTTS_PopulateInputDetails("")
        print(sv_r)
        if(sv_r==0)then
		CUST.ALERTS.MobileNum = MTT.InputDetails.Argument1
		CUST.ALERTS.MsgOut = MTT.InputDetails.Argument2
        else
		CUST.ALERTS.MobileNum = ""
		CUST.ALERTS.MsgOut = ""
	endif
	if((CUST.ALERTS.MobileNum!="")and(CUST.ALERTS.MobileNum!=""))then
        CUST.ALERTS.massage = CUST.ALERTS.MsgOut 
        print(CUST.ALERTS.massage)
        CUST.ALERTS.phoneno = CUST.ALERTS.MobileNum 
        CUST.ALERTS.trandate = mid$(BANCS.STDIN.BODDate,0,10)
        callscriptifexist("smspushothers.scr")
	endif
        if(classexists("CUST","ALERTS")==1) then
                deleteclass("CUST","ALERTS")
        endif
        if(repexists("CUST")==1) then
                deleterep("CUST")
        endif
        exitscript
trace off
end-->
