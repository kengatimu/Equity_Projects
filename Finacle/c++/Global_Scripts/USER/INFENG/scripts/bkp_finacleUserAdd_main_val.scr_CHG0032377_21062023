 <--START
	TRACE ON
	
	####################################################################
	# Check whether CUST Repository exists else create it
	####################################################################
		sv_r = REPEXISTS("CUST")
		IF(sv_r == 0) THEN
		#{
			CREATEREP ("CUST")
		#}
		ENDIF
	
	####################################################################
	# Check whether INTERFACE Class exists else create it
	####################################################################
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
		
		
	CUST.INTERFACE.EMP_ID_CUSTOM = "N"
	CUST.INTERFACE.EMP_ID_PRODUCT = "N"
	####################################################################	
	#EmployeeID
	####################################################################
	
	sv_p = STRLEN(CUST.INTERFACE.EmployeeID)
	PRINT(sv_p)
	IF (sv_p > 10 ) THEN
	#{
		PRINT("EMPLOYEE ID lenght cannot be greater than 10 char")
		CUST.INTERFACE.VAL_STATUS = "F"
		sv_a = "UserAdd_Val.Status_EmployeeID|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.ErrorMessage_EmployeeID|EMPLOYEE ID cannot be greater than 10 characters"
		sv_u = urhk_SetOrbOut(sv_b)
		#EXITSCRIPT
	#}
	ENDIF
	####################################################################	
	#EmployeeID - initial chk in the custom table
	####################################################################	
	
	sv_s = "c_empId|SELECT COUNT(1) FROM CUSTOM.C_FINACLEUSER_STATUS_TBL WHERE EMP_ID = ?SVAR AND API_Name = 'FinacleUserAdd'"
	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.EmployeeID 
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d == 0)THEN
	#{
		CUST.INTERFACE.c_empId = BANCS.OUTPARAM.c_empId
		IF(CUST.INTERFACE.c_empId != "0")THEN
		#{
			CUST.INTERFACE.EMP_ID_CUSTOM = "Y"
			CUST.INTERFACE.EMP_ID_PRODUCT = "Y"
			CUST.INTERFACE.EFM_EXISTS = "Y"
	
			PRINT("EMPLOYEE ID already exists")
		#	sv_a = "UserAdd_Val.EmployeeID_Status|ERROR"
		#	sv_u = urhk_SetOrbOut(sv_a)	
		#	sv_b = "UserAdd_Val.EmployeeID_ErrorMessage|"+CUST.INTERFACE.EmployeeID+ " already exists"
		#	sv_u = urhk_SetOrbOut(sv_b)
			GOTO USERID_VAL
			#EXITSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
		PRINT("EMPLOYEE ID validation could not be processed ")
		#CUST.INTERFACE.VAL_STATUS = "F"
		sv_a = "UserAdd_Val.EmployeeID_Status|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.EmployeeID_ErrorMessage|"+"EMPLOYEE ID validation could not be processed "
		sv_u = urhk_SetOrbOut(sv_b)
		#EXITSCRIPT
	#}
	ENDIF
	
	
	####################################################################	
	#EmployeeID - PROD TABLE CHK
	####################################################################
	
	sv_s = "c_empId|SELECT COUNT(1) FROM TBAADM.GET WHERE EMP_ID = ?SVAR AND SOL_ID = ?SVAR AND DEL_FLG ='N'"
	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.EmployeeID + "|" + CUST.INTERFACE.SolID 
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d == 0)THEN
	#{
		CUST.INTERFACE.c_empId = BANCS.OUTPARAM.c_empId
		IF(CUST.INTERFACE.c_empId != "0")THEN
		#{
			CUST.INTERFACE.EMP_ID_PRODUCT = "Y"
			CUST.INTERFACE.EFM_EXISTS = "Y"
			PRINT("EMPLOYEE ID already exists")
			sv_a = "UserAdd_Val.EmployeeID_Status|ERROR"
			sv_u = urhk_SetOrbOut(sv_a)	
			sv_b = "UserAdd_Val.EmployeeID_ErrorMessage|"+CUST.INTERFACE.EmployeeID+ " already exists"
			sv_u = urhk_SetOrbOut(sv_b)
			
			GOTO USERID_VAL
			
		#}
		ENDIF
	#}
	ELSE
	#{
		PRINT("EMPLOYEE ID validation could not be processed ")
		#CUST.INTERFACE.VAL_STATUS = "F"
		sv_a = "UserAdd_Val.EmployeeID_Status|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.EmployeeID_ErrorMessage|"+"EMPLOYEE ID validation could not be processed "
		sv_u = urhk_SetOrbOut(sv_b)
		#EXITSCRIPT
	#}
	ENDIF
	
	
	USERID_VAL:
	
	sv_p = STRLEN(CUST.INTERFACE.userId)
	PRINT(sv_p)
	IF (sv_p > 15 ) THEN
		PRINT("UserId lenght cannot be greater than 15 char")
		CUST.INTERFACE.VAL_STATUS = "F"
		sv_a = "UserAdd_Val.Status_UserId|ERROR"
		sv_u = urhk_SetOrbOut(sv_a)	
		sv_b = "UserAdd_Val.ErrorMessage_UserId|UserId cannot be greater than 15 characters"
		sv_u = urhk_SetOrbOut(sv_b)
		#EXITSCRIPT
	ENDIF
	
	
	
		#TRACE OFF
END-->