<--start
trace on
#Rep/Class
	if(repexists("ODLA")==0)then
		createrep("ODLA")
	endif
	if(classexists("ODLA","GLBDATA")==0)then
		createclass("ODLA","GLBDATA",5)
	endif
	ODLA.GLBDATA.srvErrCode = ""
	ODLA.GLBDATA.srvErrMsg  = ""
	ODLA.GLBDATA.srvSucFail = ""
	ODLA.GLBDATA.loanAcctId = "" 
	ODLA.GLBDATA.loanAcid = "" 
	ODLA.GLBDATA.loanSanctLim = "" 
	ODLA.GLBDATA.loanClrBalAmt = ""
	ODLA.GLBDATA.OperAcctId = "" 
	ODLA.GLBDATA.tranAmt = ""
        sv_r = urhk_MTTS_Close("")
        print(sv_r)
        BANCS.INPARAM.PostTranFlg               = "Y"
	BANCS.INPARAM.proxyPostFlg              = "P"
        BANCS.INPARAM.CommitFlg                 = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
        BANCS.INPARAM.ValidationFlag            = "Y"
        BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw          = "Y"
        BANCS.INPARAM.CheckExceptions           = "N"
        sv_u = urhk_MTTS_Initialize("")
        print(sv_u)
        if(sv_u != 0 )then
                ODLA.GLBDATA.srvErrMsg = MTT.Error.Description
                ODLA.GLBDATA.srvErrCode = "MTT"
                ODLA.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
        sv_r = repexists("MTT")
        if(sv_r == 0)then
                createrep("MTT")
        endif
        sv_r = classexists("MTT","TranDetails")
        if(sv_r == 0)then
                createclass("MTT","TranDetails",5)
        endif
        MTT.TranDetails.TranDate="0"
        MTT.TranDetails.TranType = "T"
        MTT.TranDetails.TranSubType = "BI"
        MTT.TranDetails.IgnoreExcp = "I"
        MTT.TranDetails.Consolidate = "Y"
        MTT.TranDetails.Remarks = "Rev:OD Loan Cr to GL"
        MTT.TranDetails.ValidationFlag = "Y"
        MTT.TranDetails.PostTranFlg = "Y"
        MTT.TranDetails.CheckExceptions = "Y"
        MTT.TranDetails.PostFlag        = "Y"
        MTT.TranDetails.CommitFlg       = "Y"
        MTT.TranDetails.PrintAdviceInd  = "B"
        sv_u = urhk_MTTS_DefineTransaction("ODLoanRec")
        print(sv_u)
        if(sv_u != 0 ) then
                ODLA.GLBDATA.srvErrMsg = MTT.Error.Description
                ODLA.GLBDATA.srvErrCode = "MTT"
                ODLA.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
	lv_d = "loanAcctId,loanAcid,loanSanctLim,loanClrBalAmt,loanIntCollId,OperAcctId,loanSchmCode|select foracid,acid,sanct_lim,clr_bal_amt,(select int_coll_bacid from tbaadm.gsp where bank_id=?SVAR and schm_code=gam.schm_code and del_flg='N' and rownum<=1),"
	lv_d = lv_d + " (select distinct op_acid from custom.odla_dmd_tbl where bank_id=?SVAR and od_acid=gam.acid "
	lv_d = lv_d + " and shdl_num in (select max(shdl_num) from custom.odla_dmd_tbl "
	lv_d = lv_d + " where bank_id=?SVAR and od_acid=gam.acid) and rownum<=1),schm_code "
	lv_d = lv_d + " from tbaadm.gam where bank_id=?SVAR "
	lv_d = lv_d + " and sol_id in (select sol_id from tbaadm.sst where bank_id=?SVAR "
        lv_d = lv_d + " and entity_cre_flg='Y' "
        lv_d = lv_d + " and del_flg='N' and set_id=?SVAR) "
	lv_d = lv_d + " and schm_type='ODA' "
        lv_d = lv_d + " and not exists(select 1 from tbaadm.ta_cot where acid=gam.acid and entity_cre_flg='Y' and del_flg='N' and chrge_off_principal-principal_recovery >0 and CHRGE_OFF_DATE is not null) "
	lv_d = lv_d + " and entity_cre_flg='Y' and del_flg='N' and schm_code in ('OD542','OD543','OD544','OD545','OD546') "
	lv_d = lv_d + " and acct_cls_flg<>'Y' and acct_cls_date is null and clr_bal_amt>0 "
	print(lv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.mySolId 
	print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(lv_d)
        if(sv_u==0)then
                ODLA.GLBDATA.schdlcurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                ODLA.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                ODLA.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                ODLA.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
        ODLA.GLBDATA.ddaRec = 0
        sv_z = urhk_dbCursorFetch(ODLA.GLBDATA.schdlcurNum)
        if(sv_z!=0)then
                ODLA.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                ODLA.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                ODLA.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
		ODLA.GLBDATA.loanAcctId = BANCS.OUTPARAM.loanAcctId
		ODLA.GLBDATA.loanAcid = BANCS.OUTPARAM.loanAcid 
		ODLA.GLBDATA.loanSanctLim = BANCS.OUTPARAM.loanSanctLim
		ODLA.GLBDATA.loanClrBalAmt = BANCS.OUTPARAM.loanClrBalAmt
		ODLA.GLBDATA.loanIntCollId = BANCS.OUTPARAM.loanIntCollId
		ODLA.GLBDATA.OperAcctId = BANCS.OUTPARAM.OperAcctId
		ODLA.GLBDATA.loanSchmCode = BANCS.OUTPARAM.loanSchmCode
		print(ODLA.GLBDATA.loanAcctId)
		print(ODLA.GLBDATA.loanAcid)
		print(ODLA.GLBDATA.loanSanctLim)
		print(ODLA.GLBDATA.loanClrBalAmt)
		print(ODLA.GLBDATA.loanIntCollId)
		print(ODLA.GLBDATA.OperAcctId)
#Dr/Cr Account Derivation
		sv_i = ODLA.GLBDATA.loanIntCollId +"|"+ BANCS.STDIN.homeCrncyCode +"|"+ BANCS.STDIN.mySolId 
		PRINT (sv_i)
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		if(sv_u == 0 )then
			ODLA.GLBDATA.recoveryAcctId=BANCS.OUTPARAM.AcctId
			print(ODLA.GLBDATA.recoveryAcctId)
		else
			ODLA.GLBDATA.recoveryAcctId = ""
		endif

                sv_a= urhk_B2k_AcidToForacid(ODLA.GLBDATA.loanAcid)
                if(sv_a==0)then
                        ODLA.GLBDATA.LoanAcctId = BANCS.OUTPARAM.Foracid
                else
                        ODLA.GLBDATA.LoanAcctId = ""
                endif
		if(ODLA.GLBDATA.recoveryAcctId!="")then
			ODLA.GLBDATA.OperAcctId = ODLA.GLBDATA.recoveryAcctId
		else
			sv_a= urhk_B2k_AcidToForacid(ODLA.GLBDATA.OperAcctId)
			if(sv_a==0)then
				ODLA.GLBDATA.OperAcctId = BANCS.OUTPARAM.Foracid
			else
				ODLA.GLBDATA.OperAcctId = ""
			endif
		endif
                sv_u = urhk_getAcctDetailsInRepository(ODLA.GLBDATA.LoanAcctId)
                if(sv_u == 0)then
                        ODLA.GLBDATA.laEffBal = BANCS.OUTPARAM.EffAvailableAmt
                        ODLA.GLBDATA.laclearBalance = BANCS.OUTPARAM.clearBalance
                        ODLA.GLBDATA.lasanLim = BANCS.OUTPARAM.sanctionLimit
                        ODLA.GLBDATA.ladrawingPower = BANCS.OUTPARAM.drawingPower
                        ODLA.GLBDATA.laavalAmt = BANCS.OUTPARAM.AvailableAmt
                        ODLA.GLBDATA.lalienamt = BANCS.OUTPARAM.lienAmt
                        print(BANCS.OUTPARAM.SystemReservedAmt)
                        if(cdouble(BANCS.OUTPARAM.SystemReservedAmt)>=1)then
                                goto NXTREC
                        endif
                else
                        ODLA.GLBDATA.ladrawingPower = 0
                        ODLA.GLBDATA.laEffBal = 0
                        ODLA.GLBDATA.laclearBalance = 0
                        ODLA.GLBDATA.lasanLim = 0
                        ODLA.GLBDATA.laavalAmt = 0
                        ODLA.GLBDATA.lalienamt = 0
                endif
                        sv_u = urhk_getAdvanceDetailsForAccount(ODLA.GLBDATA.LoanAcctId)
                        print(sv_u)
                        if(sv_u==0)then
                        #{
                                ODLA.GLBDATA.opacctiddd = BANCS.OUTPARAM.gacFreeText1
                                ODLA.GLBDATA.repayFeq = BANCS.OUTPARAM.gacFreeText2
                                ODLA.GLBDATA.LoanModule = BANCS.OUTPARAM.gacFreeText4
                                ODLA.GLBDATA.tmpEcoCode = BANCS.OUTPARAM.gacFreeText5
                                ODLA.GLBDATA.tmpEcoAcctId = BANCS.OUTPARAM.gacFreeText6
                                ODLA.GLBDATA.tmpEcoAncEmailId = BANCS.OUTPARAM.gacFreeText7
                        #}
                        else
                        #{
                                ODLA.GLBDATA.opacctiddd = ""
                                ODLA.GLBDATA.repayFeq = ""
                                ODLA.GLBDATA.LoanModule = ""
                                ODLA.GLBDATA.tmpEcoCode = ""
                                ODLA.GLBDATA.tmpEcoAcctId = ""
                                ODLA.GLBDATA.tmpEcoAncEmailId = ""
                        #}
                        endif
		print(ODLA.GLBDATA.OperAcctId)
		print(ODLA.GLBDATA.opacctiddd)
                sv_u = urhk_getAcctDetailsInRepository(ODLA.GLBDATA.opacctiddd)
                if(sv_u == 0)then
                        ODLA.GLBDATA.crEffBal = BANCS.OUTPARAM.EffAvailableAmt
                        ODLA.GLBDATA.crclearBalance = BANCS.OUTPARAM.clearBalance
                        ODLA.GLBDATA.crsanLim = BANCS.OUTPARAM.sanctionLimit
                        ODLA.GLBDATA.crdrawingPower = BANCS.OUTPARAM.drawingPower
                        ODLA.GLBDATA.cravalAmt = BANCS.OUTPARAM.AvailableAmt
                        ODLA.GLBDATA.crlienamt = BANCS.OUTPARAM.lienAmt
                        ODLA.GLBDATA.partitionedFlg = BANCS.OUTPARAM.partitionedFlg
                        ODLA.GLBDATA.partitionedType = BANCS.OUTPARAM.partitionedType

                        print(BANCS.OUTPARAM.SystemReservedAmt)
                else
                        ODLA.GLBDATA.crdrawingPower = 0
                        ODLA.GLBDATA.crEffBal = 0
                        ODLA.GLBDATA.crclearBalance = 0
                        ODLA.GLBDATA.crsanLim = 0
                        ODLA.GLBDATA.cravalAmt = 0
                        ODLA.GLBDATA.crlienamt = 0
                endif
                sv_a= urhk_B2k_ForacidToAcid(ODLA.GLBDATA.opacctiddd)
                if(sv_a==0)then
                        ODLA.GLBDATA.OperAcid = BANCS.OUTPARAM.Acid 
                else
                        ODLA.GLBDATA.OperAcid = ""
                endif
		if(cdouble(ODLA.GLBDATA.laclearBalance)<0)then
                        goto NXTREC
                endif
#Loan in Credit
                ##if(cdouble(ODLA.GLBDATA.laclearBalance)>=1)then
                if(cdouble(ODLA.GLBDATA.laclearBalance)>0)then
                        print("reverse the loan credit")
                        ##ODLA.GLBDATA.tranAmt = cdouble(ODLA.GLBDATA.laEffBal)
                        ODLA.GLBDATA.tranAmt = cdouble(ODLA.GLBDATA.laclearBalance)
                endif
#Transaction
                if((ODLA.GLBDATA.LoanAcctId!="")and(ODLA.GLBDATA.opacctiddd!="")and(cdouble(ODLA.GLBDATA.tranAmt)>0))then
                #{
                                MTT.PartTranDetails.Account = ODLA.GLBDATA.LoanAcctId 
                                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                                MTT.PartTranDetails.ValueDateDiff = "0"
                                MTT.PartTranDetails.ValueDate   =  "0"
				MTT.PartTranDetails.Particulars = "Rev Loan:for cust Cr" + ODLA.GLBDATA.opacctiddd 
                                MTT.PartTranDetails.RefAmount = -1*cdouble(ODLA.GLBDATA.tranAmt)
                                print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = "Reve on Loan Cr"
                                MTT.PartTranDetails.RefNum = ""
                                MTT.PartTranDetails.IgnoreExcp = "I"
                                ##MTT.PartTranDetails.CarveAmtFlg = "Y"
                                MTT.PartTranDetails.Consolidate = "Y"
                                MTT.PartTranDetails.TranIdentifier = "ODLoanRec"
                                print(MTT.PartTranDetails.TranIdentifier)
                                MTT.PartTranDetails.PstFlg = "Y"
				MTT.PartTranDetails.ProxyPstgInd= "P"
                                MTT.PartTranDetails.ReportCode   = "ODLoan"
                                sv_r = urhk_MTTS_definePartTran("OdLoanRecov")
                                print(sv_r)
                                if (sv_r != 0) then
                                        BANCS.OUTPUT.successOrFailure = "F"
                                        print(MTT.Error.Description)
                                        MTT.Error.Description="Debit Part Tran Definition failed "
                                        sv_r = urhk_MTTS_ReportErrorCondition("")
                                        sv_r = BANCS.OUTPARAM.MTTErrorDesc
                                        ODLA.GLBDATA.srvErrMsg = MTT.Error.Description
                                        ODLA.GLBDATA.srvErrCode = "MTT"
                                        ODLA.GLBDATA.srvSucFail = "F"
                                        goto NXTREC
                                endif
                                MTT.PartTranDetails.Account = ODLA.GLBDATA.opacctiddd 
                                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                                MTT.PartTranDetails.ValueDateDiff = "0"
                                MTT.PartTranDetails.ValueDate           =  "0"
				MTT.PartTranDetails.Particulars = "Rev Loan:Cr from:" + ODLA.GLBDATA.LoanAcctId 
                                MTT.PartTranDetails.RefAmount = 1 * cdouble(ODLA.GLBDATA.tranAmt)
                                print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = "Rev Loan"
                                MTT.PartTranDetails.RefNum = ""
                                MTT.PartTranDetails.IgnoreExcp = "I"
                                MTT.PartTranDetails.Consolidate = "Y"
				MTT.PartTranDetails.ProxyPstgInd= "P"
                                if(ODLA.GLBDATA.partitionedFlg=="Y")then
                                        MTT.PartTranDetails.ACPARTB2kId=ODLA.GLBDATA.LoanAcctId
                                        MTT.PartTranDetails.ACPARTB2kType=ODLA.GLBDATA.partitionedType
                                endif
                                MTT.PartTranDetails.TranIdentifier = "ODLoanRec"
                                MTT.PartTranDetails.ReportCode   = "ODLoan"
                                MTT.PartTranDetails.PstFlg = "Y"
                                sv_r = urhk_MTTS_definePartTran("OdLoanRecov")
                                if (sv_r != 0) then
                                        BANCS.OUTPUT.successOrFailure = "F"
                                        print(MTT.Error.Description)
                                        MTT.Error.Description="Credit Part Tran Definition failed "
                                        sv_r = urhk_MTTS_ReportErrorCondition("")
                                        sv_r = BANCS.OUTPARAM.MTTErrorDesc
                                        ODLA.GLBDATA.srvErrMsg = MTT.Error.Description
                                        ODLA.GLBDATA.srvErrCode = "MTT"
                                        ODLA.GLBDATA.srvSucFail = "F"
                                        goto NXTREC
                                endif
                                sv_u = urhk_MTTS_EndDefinition("")
                                print(sv_u)
                                if (sv_u != 0) then
                                        sv_r = urhk_MTTS_ReportErrorCondition("")
                                        print (MTT.Error.Description)
                                        ODLA.GLBDATA.srvErrMsg = MTT.Error.Description
                                        ODLA.GLBDATA.srvErrCode = "MTT"
                                        ODLA.GLBDATA.srvSucFail = "F"
                                        goto NXTREC
                                        ODLA.GLBDATA.TranId = ""
                                else
                                        ODLA.GLBDATA.TranId = BANCS.OUTPARAM.MTTTranId
                                        print(ODLA.GLBDATA.TranId)
                                endif

                                print(MTT.XCPN.NumExceptions)
                                print(MTT.XCPN.NumWarnings)
                                if((MTT.XCPN.NumExceptions >= 1) or (MTT.XCPN.NumWarnings >= 1)) then
                                #{
                                        sv_u = urhk_MTTS_HandleExceptions("POST")
                                        if (sv_u != 0) then
                                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                                print (MTT.Error.Description)
                                                ODLA.GLBDATA.srvErrMsg = MTT.Error.Description
                                                ODLA.GLBDATA.srvErrCode = "MTT"
                                                ODLA.GLBDATA.srvSucFail = "F"
                                                goto NXTREC
                                        endif
                                else
                                        sv_u = urhk_MTTS_HandleExceptions("POST")
                                        if (sv_u != 0) then
                                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                                print (MTT.Error.Description)
                                                ODLA.GLBDATA.srvErrMsg = MTT.Error.Description
                                                ODLA.GLBDATA.srvErrCode = "MTT"
                                                ODLA.GLBDATA.srvSucFail = "F"
                                                goto NXTREC
                                        endif
                                #}
                                endif
				if(ODLA.GLBDATA.TranId!="")then
				#{
					print("Reversed Loan Credit to Customer")
					lv_d = " update custom.odla_dmd_tbl set del_flg='Y',free_text_5='Account is in Credit'  where bank_id=?SVAR and od_acid=?SVAR "
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + ODLA.GLBDATA.loanAcid 
					print(BANCS.INPARAM.BINDVARS)
					print(lv_d)
					lv_d = urhk_dbSqlWithBind(lv_d)
					if(lv_d ==0)then
					#{
						lv_d = urhk_dbSqlWithBind("commit")
					#}
					endif
				#}
				endif
				print(ODLA.GLBDATA.loanSchmCode)
				
		#}
		else
		#{
			print("No Tran")
			goto NXTREC
		#}
		endif
                NXTREC:
                        print(ODLA.GLBDATA.srvErrMsg)
                        print(ODLA.GLBDATA.srvErrCode)
                        print(ODLA.GLBDATA.srvSucFail)
                        sv_u = urhk_dbCursorFetch(ODLA.GLBDATA.schdlcurNum)
                        print(sv_u)
                        if(sv_u!=0)then
                                print("fetch failed")
                                sv_u = urhk_dbCursorClose(ODLA.GLBDATA.schdlcurNum)
                                print(sv_u)
                                ODLA.GLBDATA.srvErrMsg =  "Demand Cursor Fetch Failed"
                                ODLA.GLBDATA.srvErrCode = "DBCursor"
                                ODLA.GLBDATA.srvSucFail = "F"
                                goto Endofscript
                        endif
                        ODLA.GLBDATA.ddaRec = cint(ODLA.GLBDATA.ddaRec) + 1
                        ODLA.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + ODLA.GLBDATA.ddaRec
                        print(ODLA.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(ODLA.GLBDATA.schdlcurNum)
        print(sv_u)
Endofscript:
        print(ODLA.GLBDATA.srvErrCode)
        print(ODLA.GLBDATA.srvErrMsg)
        print(ODLA.GLBDATA.srvSucFail)
        exitscript
trace off
end-->
