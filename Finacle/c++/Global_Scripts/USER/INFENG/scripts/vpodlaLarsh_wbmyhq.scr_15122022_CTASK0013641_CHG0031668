		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.disbTranDate
