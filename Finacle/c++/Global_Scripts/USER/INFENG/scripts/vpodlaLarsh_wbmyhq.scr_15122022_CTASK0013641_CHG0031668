	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId +"|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode
	print(lv_i)
	print(BANCS.INPARAM.BINDVARS)
	lv_d = urhk_dbSelectWithBind(lv_i)
	if(lv_d==0)then
		EQSRV.GLBDATA.drIntPcnt = BANCS.OUTPARAM.drIntPcnt
	else
		EQSRV.GLBDATA.drIntPcnt = 13
	endif
	print(EQSRV.GLBDATA.drIntPcnt)
	BANCS.INPARAM.date1 = EQSRV.GLBDATA.expiryDate 
	BANCS.INPARAM.date2 = EQSRV.GLBDATA.sanctDate 
	sv_u = urhk_B2K_dateDiff("")
	print(sv_u)
	if(sv_u == 0 ) then
		BANCS.INPUT.migdatediff = BANCS.OUTPARAM.dateDiff
	else
		BANCS.INPUT.migdatediff = 365 
	endif
	print(BANCS.INPUT.migdatediff)
	EQSRV.GLBDATA.numofMnths = cdouble(BANCS.INPUT.migdatediff) /30
	print(EQSRV.GLBDATA.numofMnths)
	lv_u = "numMonths,numofWeeks | select to_char(months_between(to_date(?SVAR,'DD-MM-RR'),to_date(?SVAR,'DD-MM-RR')),99),floor((to_date(?SVAR,'DD-MM-RR') - to_date(?SVAR,'DD-MM-RR'))/7)  from dual "
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.expiryDate + "|" + EQSRV.GLBDATA.sanctDate + "|" + EQSRV.GLBDATA.expiryDate + "|" + EQSRV.GLBDATA.sanctDate
	print(lv_u)
	print(BANCS.INPARAM.BINDVARS)
	lv_o = urhk_dbSelectWithBind(lv_u)
	if(lv_o==0)then
		BANCS.INPUT.numofMnths = BANCS.OUTPARAM.numMonths
		EQSRV.GLBDATA.numofWeeks = BANCS.OUTPARAM.numofWeeks
		EQSRV.GLBDATA.numofMnths = BANCS.INPUT.numofMnths
		print(BANCS.INPUT.numofMnths)
		print(EQSRV.GLBDATA.numofWeeks)
		print(EQSRV.GLBDATA.numofMnths)
	endif
	EQSRV.GLBDATA.fIntPcnt = cdouble(EQSRV.GLBDATA.drIntPcnt)/100
	print(EQSRV.GLBDATA.fIntPcnt)
#Monthly
	if(EQSRV.GLBDATA.repayFreq=="M")then
		EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/12
		EQSRV.GLBDATA.emiPyCnt = BANCS.INPUT.numofMnths 
	endif
#Quaterly
	if(EQSRV.GLBDATA.repayFreq=="Q")then
		EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/3
		EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths)/3
	endif
#Half-Yearly
	if(EQSRV.GLBDATA.repayFreq=="H")then
		EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/6
		EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths)/6
	endif
#Yearly
	if(EQSRV.GLBDATA.repayFreq=="Y")then
		EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/12
		EQSRV.GLBDATA.emiPyCnt =  cdouble(BANCS.INPUT.numofMnths)/12 
	endif
#Weekly
	if(EQSRV.GLBDATA.repayFreq=="W")then
		EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/52
		EQSRV.GLBDATA.emiPyCnt = EQSRV.GLBDATA.numofWeeks 
	endif
#BiWeekly
	if(EQSRV.GLBDATA.repayFreq=="B")then
		EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/26
		EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths) * 2
	endif
#Daily
        if(EQSRV.GLBDATA.repayFreq=="D")then
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/26
                EQSRV.GLBDATA.emiPyCnt = cdouble("1")
        endif
	print(EQSRV.GLBDATA.fiIntPcnt)
	print(EQSRV.GLBDATA.emiPyCnt)
#emi-amount
	lv_p = "pmtamt | select to_char(custom.fn_pmt_val(?NVAR,?NVAR,?NVAR,0),999999999999999.99) as pmtamt from dual "
	###BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.fiIntPcnt + "|" + BANCS.INPUT.numofMnths + "|" +  EQSRV.GLBDATA.sanLim
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.fiIntPcnt + "|" + EQSRV.GLBDATA.emiPyCnt + "|" +  EQSRV.GLBDATA.sanLim
