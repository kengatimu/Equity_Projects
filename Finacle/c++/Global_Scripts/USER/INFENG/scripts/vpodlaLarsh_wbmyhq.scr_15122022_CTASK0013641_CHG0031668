                EQSRV.GLBDATA.expiryDate = MTT.InputDetails.Argument7
                EQSRV.GLBDATA.intTblCode = MTT.InputDetails.Argument8
                EQSRV.GLBDATA.acctCrncyCode = MTT.InputDetails.Argument9
                EQSRV.GLBDATA.repayFreq = MTT.InputDetails.Argument10

                EQSRV.GLBDATA.odAcctId = EBSRV.GLBDATA.gloanacct 
                EQSRV.GLBDATA.OperativeAcctId = EBSRV.GLBDATA.gOperAcctId 
                EQSRV.GLBDATA.sanLim = EBSRV.GLBDATA.gclrbalamt 
                EQSRV.GLBDATA.disbTranId = EBSRV.GLBDATA.diTranId 
                EQSRV.GLBDATA.disbTranDate = EBSRV.GLBDATA.diTranDate 
                EQSRV.GLBDATA.sanctDate = EBSRV.GLBDATA.diTranDate 
                EQSRV.GLBDATA.expiryDate = EBSRV.GLBDATA.limExpDate 
                EQSRV.GLBDATA.intTblCode = EBSRV.GLBDATA.IntTblCode 
                EQSRV.GLBDATA.acctCrncyCode = EBSRV.GLBDATA.limCrncyCode 
                EQSRV.GLBDATA.repayFreq = EBSRV.GLBDATA.gLoanFrequency 
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                EQSRV.GLBDATA.odAcctId = EBSRV.GLBDATA.gloanacct 
                EQSRV.GLBDATA.OperativeAcctId = EBSRV.GLBDATA.gOperAcctId 
                EQSRV.GLBDATA.sanLim = EBSRV.GLBDATA.gclrbalamt 
                EQSRV.GLBDATA.disbTranId = EBSRV.GLBDATA.diTranId 
                EQSRV.GLBDATA.disbTranDate = EBSRV.GLBDATA.diTranDate 
                EQSRV.GLBDATA.sanctDate = EBSRV.GLBDATA.diTranDate 
                EQSRV.GLBDATA.expiryDate = EBSRV.GLBDATA.limExpDate 
                EQSRV.GLBDATA.intTblCode = EBSRV.GLBDATA.IntTblCode 
                EQSRV.GLBDATA.acctCrncyCode = EBSRV.GLBDATA.limCrncyCode 
                EQSRV.GLBDATA.repayFreq = EBSRV.GLBDATA.gLoanFrequency 
                ####goto VAYU
        endif
	print(EQSRV.GLBDATA.odAcctId)
	print(EQSRV.GLBDATA.OperativeAcctId)
	print(EQSRV.GLBDATA.sanLim)
	print(EQSRV.GLBDATA.disbTranId)
	print(EQSRV.GLBDATA.disbTranDate) 
	print(EQSRV.GLBDATA.sanctDate)
	print(EQSRV.GLBDATA.expiryDate)
	print(EQSRV.GLBDATA.intTblCode)
	print(EQSRV.GLBDATA.acctCrncyCode)
