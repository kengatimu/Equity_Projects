	print(BANCS.INPARAM.BINDVARS)
	lv_o = urhk_dbSelectWithBind(lv_p)
	if(lv_o==0)then
		EQSRV.GLBDATA.pmtamt = BANCS.OUTPARAM.pmtamt
		if(cdouble(EQSRV.GLBDATA.pmtamt)<=0)then
			EQSRV.GLBDATA.pmtamt = -1 * cdouble(EQSRV.GLBDATA.pmtamt)
		endif
	else
		EQSRV.GLBDATA.pmtamt = 0
	endif
	print(EQSRV.GLBDATA.fiIntPcnt)
	print(cint(EQSRV.GLBDATA.fiIntPcnt))
	print(cdouble(EQSRV.GLBDATA.fiIntPcnt))
	EQSRV.GLBDATA.IntAmt = cdouble(EQSRV.GLBDATA.sanLim) * cdouble(EQSRV.GLBDATA.fiIntPcnt)
	print(EQSRV.GLBDATA.IntAmt)
	EQSRV.GLBDATA.IntAmt = FORMAT$(cdouble(EQSRV.GLBDATA.IntAmt),"%.2f")
	print(EQSRV.GLBDATA.IntAmt)
	EQSRV.GLBDATA.PrinAmt = cdouble(EQSRV.GLBDATA.pmtamt) - cdouble(EQSRV.GLBDATA.IntAmt) 
	print(EQSRV.GLBDATA.PrinAmt)
	if(cdouble(EQSRV.GLBDATA.PrinAmt)<0)then
		EQSRV.GLBDATA.PrinAmt = -1 * cdouble(EQSRV.GLBDATA.PrinAmt)
	endif
	print(EQSRV.GLBDATA.PrinAmt)
	EQSRV.GLBDATA.PrinAmt = FORMAT$(cdouble(EQSRV.GLBDATA.PrinAmt),"%.2f")
	print(EQSRV.GLBDATA.PrinAmt)
	#entry in schedule table
	lv_e = " insert into custom.odla_schl_tbl (bank_id,od_acct_id,od_acid,od_sol_id,op_acct_id,op_acid,op_sol_id,od_disb_amt,od_disb_tran_date,schl_number,schl_date,number_of_payments,emi_amt,emi_int_amt,emi_principal_amt,next_dmd_date,rcre_user_id,rcre_time,lchg_user_id,lchg_time,entity_cre_flg,del_flg,free_text1,free_text2,free_text3,free_text4,free_text5,free_text6) "
	lv_e = lv_e + "  values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?NVAR,to_date(?SVAR,'DD-MM-RR'),1,to_date(?SVAR,'DD-MM-RR'),?NVAR,?NVAR,?NVAR,?NVAR,to_date(?SVAR,'DD-MM-RR'),?SVAR,sysdate,?SVAR,sysdate,'Y','N',null,null,null,null,null,?SVAR) "
	###BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.odAcid + "|" + EQSRV.GLBDATA.odsolid + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OperAcid + "|" + EQSRV.GLBDATA.odsolid + "|" + EQSRV.GLBDATA.sanLim + "|" + EQSRV.GLBDATA.disbTranDate + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQSRV.GLBDATA.numofMnths + "|" + EQSRV.GLBDATA.pmtamt + "|" + EQSRV.GLBDATA.IntAmt + "|" + EQSRV.GLBDATA.PrinAmt + "|" + EQSRV.GLBDATA.nxtDmdDate + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.repayFreq 
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.odAcid + "|" + EQSRV.GLBDATA.odsolid + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OperAcid + "|" + EQSRV.GLBDATA.odsolid + "|" + EQSRV.GLBDATA.sanLim + "|" + EQSRV.GLBDATA.disbTranDate + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQSRV.GLBDATA.emiPyCnt + "|" + EQSRV.GLBDATA.pmtamt + "|" + EQSRV.GLBDATA.IntAmt + "|" + EQSRV.GLBDATA.PrinAmt + "|" + EQSRV.GLBDATA.nxtDmdDate + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.repayFreq 
	print(lv_e)
	print(BANCS.INPARAM.BINDVARS)
	lv_i = urhk_dbSqlWithBind(lv_e)
	if(lv_i==0)then
	#{
		#status update in disbursement table
		lv_d = "update custom.odla_disb_tbl set is_resh_yn='Y',resh_date=to_date(?SVAR,'DD-MM-RR'),lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and od_acct_id=?SVAR and op_acct_id=?SVAR and OD_DISB_TRAN_DATE=to_date(?SVAR,'DD-MM-RR') and free_text1=1 " 
		BANCS.INPARAM.BINDVARS =  mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.disbTranDate
		print(lv_d)
