		BANCS.OUTPUT.RefNum= TRIM(BANCS.INPUT.RefNum)
		PRINT(BANCS.OUTPUT.RefNum)
	#}
	ENDIF
	
	
	PRINT(BANCS.STDIN.mySolDesc)
	
	IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1) THEN
	#{
	################### HPORDM #######################################
		IF (BANCS.STDIN.menuId == "HPORDM") THEN
		#{
		
				IF (FIELDEXISTS(BANCS.INPUT.TranId) == 1) THEN
				#{
					BANCS.OUTPUT.TranId= BANCS.INPUT.TranId
					PRINT(BANCS.OUTPUT.TranId)
				#}
				ENDIF
				
				IF (FIELDEXISTS(BANCS.INPUT.TranDate) == 1) THEN
				#{
					BANCS.OUTPUT.TranDate= BANCS.INPUT.TranDate
					PRINT(BANCS.OUTPUT.TranDate)
				#}
				ENDIF
	
	
			sv_u = "freetext,name,no|select FREE_TEXT1,BENEF_PARTY_NAME,FREE_TEXT from tbaadm.pord where bank_id=?SVAR AND PYMT_REF_NUM=?SVAR"
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + (RIGHT$(BANCS.INPUT.TranParticular,12))
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_r =  urhk_dbSelectWithBind(sv_u)
			PRINT(sv_r)
			IF (sv_r ==0) THEN
			#{
				BANCS.OUTPUT.freetext = TRIM(BANCS.OUTPARAM.freetext)
				PRINT (BANCS.OUTPUT.freetext)
				BANCS.OUTPUT.name = TRIM(BANCS.OUTPARAM.name)
				PRINT (BANCS.OUTPUT.name)
				BANCS.OUTPUT.no = TRIM(BANCS.OUTPARAM.no)
				PRINT (BANCS.OUTPUT.no)
			#}
			ELSE
			#{
				BANCS.OUTPUT.freetext = " "
				BANCS.OUTPUT.name = " "
				BANCS.OUTPUT.no = " "
			#}
			ENDIF
			
			IF(MID$(BANCS.INPUT.Remarks,0,4) == "SWIF")THEN
			#{
				IF(MID$(BANCS.INPUT.TranParticular,0,7) == "Charges")THEN
				#{
					BANCS.OUTPUT.TranParticular = "remmittance charges RTGS/SWIFT no: " + BANCS.OUTPUT.no
					PRINT(BANCS.OUTPUT.TranParticular)
				#}
				ELSE
				#{
					IF(BANCS.OUTPUT.freetext == "")THEN
					#{
					
						BANCS.OUTPUT.TranParticular ="SWFT:" + BANCS.OUTPUT.no + " "+ BANCS.OUTPUT.name
						PRINT(BANCS.OUTPUT.TranParticular)
						BANCS.OUTPUT.TranParticular = MID$(BANCS.OUTPUT.TranParticular,0,50)
						PRINT(BANCS.OUTPUT.TranParticular)

						
					#}
					ELSE
					#{
						BANCS.OUTPUT.TranParticular ="FRGN/RMT:" + (RIGHT$(BANCS.INPUT.TranParticular,12) + ":" + BANCS.OUTPUT.freetext + BANCS.OUTPUT.name)
						PRINT(BANCS.OUTPUT.TranParticular)
						BANCS.OUTPUT.TranParticular = MID$(BANCS.OUTPUT.TranParticular,0,50)
						PRINT(BANCS.OUTPUT.TranParticular)

					
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			IF(MID$(BANCS.INPUT.Remarks,0,4) == "RTGS")THEN
			#{
				IF(MID$(BANCS.INPUT.TranParticular,0,7) == "Charges")THEN
				#{
					BANCS.OUTPUT.TranParticular = "remmittance charges RTGS/SWIFT no: " + BANCS.OUTPUT.no
					PRINT(BANCS.OUTPUT.TranParticular)
				#}
				ELSE
				#{
					IF(BANCS.OUTPUT.freetext== "")THEN
					#{
						BANCS.OUTPUT.TranParticular ="RTGS:" + BANCS.OUTPUT.no + " " + BANCS.OUTPUT.name
						PRINT(BANCS.OUTPUT.TranParticular)
						BANCS.OUTPUT.TranParticular = MID$(BANCS.OUTPUT.TranParticular,0,50)
						PRINT(BANCS.OUTPUT.TranParticular)
					#}
					ELSE
					#{
						BANCS.OUTPUT.TranParticular ="RTGS/RMT:" + (RIGHT$(BANCS.INPUT.TranParticular,12)  + ":" + BANCS.OUTPUT.freetext + BANCS.OUTPUT.name)
						PRINT(BANCS.OUTPUT.TranParticular)
						BANCS.OUTPUT.TranParticular = MID$(BANCS.OUTPUT.TranParticular,0,50)
						PRINT(BANCS.OUTPUT.TranParticular)
			
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#	sv_s = " Update tbaadm.dtd set tran_particular=?SVAR ,tran_rmks =?SVAR "
		#	sv_s = sv_s + " where tran_id = ?SVAR "
		#	sv_s = sv_s + " AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
