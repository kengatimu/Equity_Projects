		#	BANCS.INPARAM.BINDVARS = mid$(BANCS.OUTPUT.TranParticular,0,50) + "|" + mid$(BANCS.OUTPUT.TranParticular,0,30) + "|" + BANCS.OUTPUT.TranId  + "|"  + BANCS.OUTPUT.TranDate + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.OUTPUT.PartTranSrlNum
		
		#	PRINT(BANCS.INPARAM.BINDVARS)
		
		#	sv_d = urhk_dbSQLWithBind(sv_s)
		#	PRINT(sv_d) 
			
		#}
		ENDIF	
	####################### HPORDM ################################
	
		IF (BANCS.STDIN.menuId == "HSALPAY") THEN
		#{
			IF (FIELDEXISTS(CUST.SALPAY.tranParticulars) == 1) THEN
			#{
				BANCS.OUTPUT.TranParticular = CUST.SALPAY.tranParticulars
				print (BANCS.OUTPUT.TranParticular)
			#}
			ENDIF
		#}
		ENDIF
		
		IF ((BANCS.STDIN.menuId == "HTM") OR (BANCS.STDIN.menuId == "HCASHDEP") OR (BANCS.STDIN.menuId == "HCASHWD")) THEN
		#{
			IF ((BANCS.INPUT.TranSubType == "CI") OR (BANCS.INPUT.TranSubType == "BI") OR (BANCS.INPUT.TranSubType == "NR") OR (BANCS.INPUT.TranSubType == "NP") OR (BANCS.INPUT.TranSubType == "I")) THEN
			#{
				IF (BANCS.INPUT.TranParticular == "") THEN
				#{
					IF (BANCS.INPUT.PartTranType == "D") THEN
					#{
						BANCS.OUTPUT.TranParticular = "DEBIT TRANSFER"
						PRINT(BANCS.OUTPUT.TranParticular)
						#}
					ELSE
						#{
						BANCS.OUTPUT.TranParticular = "CREDIT TRANSFER"
						PRINT(BANCS.OUTPUT.TranParticular)
					#}
					ENDIF
					
					IF (BANCS.INPUT.TranSubType == "NP") THEN
					#{
						BANCS.OUTPUT.TranParticular = "Cash Withdrawl from " + BANCS.STDIN.mySolDesc
						PRINT(BANCS.OUTPUT.TranParticular)
					#}
					ENDIF
					
					IF (BANCS.INPUT.TranSubType == "NR") THEN
					#{
						BANCS.OUTPUT.TranParticular = "Cash Deposit from " + BANCS.STDIN.mySolDesc
						PRINT(BANCS.OUTPUT.TranParticular)
					#}
					ENDIF

					IF (BANCS.STDIN.contextBankId=="43") THEN
						IF (BANCS.INPUT.PartTranType == "D") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Transfert au sein de Equity"
							PRINT(BANCS.OUTPUT.TranParticular)
							#}
						ELSE
							#{
							BANCS.OUTPUT.TranParticular = "Transfert au sein de Equity"
							PRINT(BANCS.OUTPUT.TranParticular)
						#}
						ENDIF
						
						IF (BANCS.INPUT.TranSubType == "NP") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Retrait en cash from " + BANCS.STDIN.mySolDesc
							PRINT(BANCS.OUTPUT.TranParticular)
						#}
						ENDIF
						
						IF (BANCS.INPUT.TranSubType == "NR") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Depot en cash from " + BANCS.STDIN.mySolDesc
							PRINT(BANCS.OUTPUT.TranParticular)
						#}
						ENDIF
					ENDIF
				ELSE
					IF (BANCS.STDIN.contextBankId=="43") THEN
						IF (BANCS.INPUT.PartTranType == "D") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Transfert au sein de Equity"
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular = BANCS.OUTPUT.TranParticular +"/"+ BANCS.INPUT.TranParticular
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.INPUT.TranParticularr = BANCS.OUTPUT.TranParticular
							PRINT(BANCS.INPUT.TranParticular)
							#}
						ELSE
							#{
							BANCS.OUTPUT.TranParticular = "Transfert au sein de Equity"
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular = BANCS.OUTPUT.TranParticular +"/"+ BANCS.INPUT.TranParticular
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.INPUT.TranParticularr = BANCS.OUTPUT.TranParticular
							PRINT(BANCS.INPUT.TranParticular)
						#}
						ENDIF
						
						IF (BANCS.INPUT.TranSubType == "NP") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Retrait en cash"
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular = BANCS.OUTPUT.TranParticular +"/"+ BANCS.INPUT.TranParticular
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.INPUT.TranParticularr = BANCS.OUTPUT.TranParticular
							PRINT(BANCS.INPUT.TranParticular)
						#}
						ENDIF
						
						IF (BANCS.INPUT.TranSubType == "NR") THEN
						#{
							BANCS.OUTPUT.TranParticular = "Depot en cash"
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.OUTPUT.TranParticular = BANCS.OUTPUT.TranParticular +"/"+ BANCS.INPUT.TranParticular
							PRINT(BANCS.OUTPUT.TranParticular)
							BANCS.INPUT.TranParticularr = BANCS.OUTPUT.TranParticular
							PRINT(BANCS.INPUT.TranParticular)
						#}
						ENDIF
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		IF (BANCS.STDIN.menuId == "HCDEP") THEN
		#{
			IF (BANCS.INPUT.TranSubType == "CR") THEN
			#{
				BANCS.OUTPUT.TranParticular = "Cash Deposit from " + BANCS.STDIN.mySolDesc
				PRINT(BANCS.OUTPUT.TranParticular)
			#}
			ENDIF
		#}
		ENDIF
		IF (BANCS.STDIN.menuId == "HBPAD") THEN
		#{
			IF (BANCS.STDIN.funcName != "SRV_CancelPayment") THEN
			#{
				IF (FIELDEXISTS(CUST.BILL.lateFeeAmt) == 1) THEN
				#{
					IF (CUST.BILL.billDateDiff > 0) THEN
					#{
						IF (CUST.BILL.billDusDateDiff > 0) THEN
						#{
							BANCS.OUTPUT.TranRmks = "Late Payment Fee:" + CUST.BILL.lateFeeAmt
							print(BANCS.OUTPUT.TranRmks)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	EXITSCRIPT
	TRACE OFF
