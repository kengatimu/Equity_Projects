BANCS.INPARAM.date1 = BANCS.STDIN.BODDate
print(BANCS.INPARAM.date1)
BANCS.INPARAM.date2 = CUST.ODAA.advn_start_date
print(BANCS.INPARAM.date2)
sv_e = urhk_B2k_dateDiff("")
if (sv_e==0) then
        PRINT(BANCS.OUTPARAM.dateDiff)
	CUST.ODAA.TODnodays = BANCS.OUTPARAM.dateDiff
	PRINT(CUST.ODAA.TODnodays)
endif

sv_s = "limexp_date|SELECT  to_char(LIM_EXP_DATE,'DD-MM-RRRR hh24:mm:ss' ) " 
sv_s = sv_s + "FROM TBAADM.LHT "
sv_s = sv_s + "WHERE LHT.acid = ?SVAR " 
sv_s = sv_s + "AND LHT.bank_id = ?SVAR " 
sv_s = sv_s + "AND LHT.del_flg ='N' "
sv_s = sv_s + "AND LHT.entity_cre_flg = 'Y' "
sv_s = sv_s + "AND LHT.status IN ('A') "
sv_s = sv_s + "AND LHT.lim_exp_date >= TO_DATE('" + left$(BANCS.STDIN.BODDate,10) + "','DD-MM-YYYY HH24:MI:SS') "
sv_s = sv_s + "AND LHT.APPLICABLE_DATE <= LHT.lim_exp_date  AND ROWNUM <2 ORDER BY LIM_EXP_DATE DESC"
BANCS.INPARAM.BINDVARS = CUST.ODAA.acctAcid + "|" + BANCS.STDIN.contextBankId  
print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
PRINT(sv_d)

IF (sv_d != 0) THEN
#{
	CUST.ODAA.limexp_date = BANCS.STDIN.BODDate
	PRINT(CUST.ODAA.limexp_date)
#}
ELSE
#{
	IF (BANCS.OUTPARAM.limexp_date!="") THEN
		CUST.ODAA.limexp_date = BANCS.OUTPARAM.limexp_date
