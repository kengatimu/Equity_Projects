BANCS.INPARAM.date1 = BANCS.STDIN.BODDate
print(BANCS.INPARAM.date1)
BANCS.INPARAM.date2 = CUST.ODAA.limexp_date
print(BANCS.INPARAM.date2)
sv_e = urhk_B2k_dateDiff("")
if (sv_e==0) then
        PRINT(BANCS.OUTPARAM.dateDiff)
	CUST.ODAA.Expnodays = BANCS.OUTPARAM.dateDiff
	PRINT(CUST.ODAA.Expnodays)
endif

sv_s = "acct_status_date|SELECT to_char(acct_status_date,'DD-MM-RRRR hh24:mm:ss' ) "
sv_s = sv_s + "FROM TBAADM.CAM "
sv_s = sv_s + "WHERE bank_id = ?SVAR "
sv_s = sv_s + "AND acid = ?SVAR "
sv_s = sv_s + "AND acct_status = 'I' "
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.ODAA.acctAcid
sv_d = urhk_dbSelectWithBind(sv_s)
PRINT(sv_d)

IF (sv_d != 0) THEN
