print(BANCS.INPARAM.date1)
BANCS.INPARAM.date2 = CUST.ODAA.acct_status_date
print(BANCS.INPARAM.date2)
sv_e = urhk_B2k_dateDiff("")
if (sv_e==0) then
        PRINT(BANCS.OUTPARAM.dateDiff)
	CUST.ODAA.Inacnodays = BANCS.OUTPARAM.dateDiff
	PRINT(CUST.ODAA.Inacnodays)
endif

sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.foracid)
IF (sv_u == 0) THEN
#{
	CUST.ODAA.sanctionLimit = BANCS.OUTPARAM.sanctionLimit
	PRINT(CUST.ODAA.sanctionLimit)

	CUST.ODAA.clearBalance = BANCS.OUTPARAM.clearBalance
	PRINT(CUST.ODAA.clearBalance)

	IF (CUST.ODAA.clearBalance >= 0 ) THEN
	#{
		GOTO STEPNRM
	#}
	ENDIF

	CUST.ODAA.Op_Month = BANCS.OUTPARAM.acctOpenDate
	CUST.ODAA.Last_Month = LEFT$(BANCS.STDIN.BODDate,10)
	sv_b = LEFT$(BANCS.STDIN.BODDate,10)

	CUST.ODAA.Op_Month = LEFT$(CUST.ODAA.Op_Month,10)
	PRINT(CUST.ODAA.Op_Month)
	CUST.ODAA.Last_Month = LEFT$(CUST.ODAA.Last_Month,10)
	PRINT(CUST.ODAA.Last_Month)

	sv_s = "NumOfMonths|SELECT MONTHS_BETWEEN(TO_DATE('" + CUST.ODAA.Last_Month + "','DD-MM-YYYY'),TO_DATE('" + CUST.ODAA.Op_Month + "','DD-MM-YYYY')) "
	sv_s = sv_s + "FROM DUAL "
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	PRINT(CUST.ODAA.month1)
	PRINT(CUST.ODAA.month2)
	PRINT(CUST.ODAA.month3)
	IF (sv_d != 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.errorMesg)
		GOTO Finish
	#}
	ELSE
	#{
		CUST.ODAA.NumOfMonths = BANCS.OUTPARAM.NumOfMonths
		PRINT(CUST.ODAA.NumOfMonths)
		IF (CINT(CUST.ODAA.NumOfMonths) >= CINT(CUST.ODAA.month1)) THEN
		#{
			PRINT("HI")
			GOTO STEPDBT
		#}
		ENDIF
	
		IF (CINT(CUST.ODAA.NumOfMonths) >= CINT(CUST.ODAA.month2)) THEN
		#{
			GOTO STEPSUB
		#}		
		ENDIF
	
		IF (CINT(CUST.ODAA.NumOfMonths) >= CINT(CUST.ODAA.month3)) THEN
		#{
			GOTO STEPWAT
		#}
		ELSE
		#{
			GOTO STEPNRM
		#}
		ENDIF
	#}
	ENDIF

	STEPDBT:
	#------------------------------------------------------------------------------------
	# DOUBTFULL CLASSIFICATION
	#------------------------------------------------------------------------------------
	# GENERAL CALCULATION FOR DOUBTFULL
	#----------------------------------
	sv_s = "Day270|SELECT  to_date('" + LEFT$(BANCS.STDIN.BODDate,10) + "','DD-MM-YYYY') - 270 "
	sv_s = sv_s + "FROM DUAL "
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.Day270)

		CUST.ODAA.Day270=BANCS.OUTPARAM.Day270
	#}
	ENDIF

	sv_s = "CrAmtDtd270|SELECT nvl(sum(tran_amt),0) "
	sv_s = sv_s + "FROM TBAADM.DTD "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND acid = ?SVAR "
	sv_s = sv_s + "AND  part_tran_type = 'C' "
	sv_s = sv_s + "AND pstd_flg = 'Y' "    
	sv_s = sv_s + "AND value_date >= TO_DATE(?SVAR,'DD-MM-YYYY')"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.ODAA.acctAcid + "|" + CUST.ODAA.Day270 
	PRINT(sv_s)

	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 1 ) THEN
	#{
		CUST.ODAA.CrAmtDtd270 = 0
	#}
	ELSE
	#{
		CUST.ODAA.CrAmtDtd270 = BANCS.OUTPARAM.CrAmtDtd270
	#}
	ENDIF
	
	PRINT(CUST.ODAA.Query1)
	
	sv_s = "CrAmtCtd270|" + CUST.ODAA.Query1 
	sv_s = sv_s + " and value_date >= TO_DATE(?SVAR,'DD-MM-YYYY')"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.ODAA.acctAcid + "|"  + BANCS.STDIN.contextBankId + "|" + CUST.ODAA.Day270
	sv_d = urhk_dbSelectWithBind(sv_s) 
	PRINT(sv_d)
	
	IF (sv_d == 1) THEN
	#{	
		CUST.ODAA.CrAmtCtd270 = 0
	#}
	ELSE
	#{	
		CUST.ODAA.CrAmtCtd270 = BANCS.OUTPARAM.CrAmtCtd270
	#}
	ENDIF
			
	CUST.ODAA.TotAmt270 = CDOUBLE(CUST.ODAA.CrAmtDtd270) + CDOUBLE(CUST.ODAA.CrAmtCtd270)
	PRINT(CUST.ODAA.TotAmt270)

	PRINT(CUST.ODAA.acctAcid)
	PRINT(BANCS.STDIN.BODDate)
	CUST.ODAA.ToDate = left$(BANCS.STDIN.BODDate,10)

	CUST.ODAA.FromDate = CUST.ODAA.Day270
	CALL("IntCal.scr")
	PRINT(CUST.ODAA.IntAmt)
	CUST.ODAA.IntAmt270 = CUST.ODAA.IntAmt
	PRINT(CUST.ODAA.Expnodays)
	PRINT(CUST.ODAA.TODnodays)
	
	IF (CINT(CUST.ODAA.TODnodays) >= CUST.ODAA.TODDays180 ) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass004
		GOTO Finish
	#}
	ENDIF
	
	IF (CINT(CUST.ODAA.Expnodays) >= CUST.ODAA.TODDays180 ) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass004
		GOTO Finish
	#}
	ENDIF
	
	IF(CINT(CUST.ODAA.Inacnodays) >= CUST.ODAA.TODDays180) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass004
		GOTO Finish
	#}
	ENDIF
	
	IF (CDOUBLE(CUST.ODAA.TotAmt270) < CDOUBLE(CUST.ODAA.IntAmt270) ) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass004
		GOTO Finish
	#}
	ENDIF

	GOTO STEPSUB

STEPSUB:
#------------------------------------------------------------------------------------
        # GENERAL CALCULATION FOR STEPSUBST
        #----------------------------------
	sv_s = "Day180|SELECT  to_date('" + LEFT$(BANCS.STDIN.BODDate,10) + "','DD-MM-YYYY') - 180 "
	sv_s = sv_s + "FROM DUAL "
	PRINT(sv_s)	
	sv_d=urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)

	PRINT(BANCS.OUTPARAM.Day180)

	CUST.ODAA.Day180 = BANCS.OUTPARAM.Day180
	PRINT(CUST.ODAA.Day180)
	sv_s = "CrAmtDtd180|SELECT nvl(sum(tran_amt),0) "
	sv_s = sv_s + "FROM TBAADM.DTD "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND acid = ?SVAR "
	sv_s = sv_s + "AND part_tran_type = 'C'"
	sv_s = sv_s + "AND pstd_flg = 'Y'"
	sv_s = sv_s + "AND value_date >= '" + CUST.ODAA.Day180 + "'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.ODAA.acctAcid
	PRINT(sv_s)
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 1 ) THEN
	#{
		CUST.ODAA.CrAmtDtd180 = 0
		PRINT(CUST.ODAA.CrAmtDtd180)
	#}
	ELSE
	#{
		CUST.ODAA.CrAmtDtd180 = BANCS.OUTPARAM.CrAmtDtd180
		PRINT(CUST.ODAA.CrAmtDtd180)	
	#}
	ENDIF

	sv_a = "CrAmtCtd180|" + CUST.ODAA.Query1 
	sv_a = sv_a + " and value_date >= TO_DATE('" + CUST.ODAA.Day180 + "','DD-MM-YYYY')"
	PRINT(sv_a) 
	BANCS.INPARAM.BINDVARS = CUST.ODAA.acctAcid + "|"  + BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_d)
	
	IF (sv_d == 1) THEN
	#{	
		CUST.ODAA.CrAmtCtd180 = 0
	#}
	ELSE
	#{
		CUST.ODAA.CrAmtCtd180 = BANCS.OUTPARAM.CrAmtCtd180
		PRINT(CUST.ODAA.CrAmtCtd180)
	#}
	ENDIF
				
	CUST.ODAA.TotAmt180 = CDOUBLE(CUST.ODAA.CrAmtDtd180) + CDOUBLE(CUST.ODAA.CrAmtCtd180)
	PRINT(CUST.ODAA.TotAmt180)

	PRINT(CUST.ODAA.acctAcid)
	PRINT(BANCS.STDIN.BODDate)
	CUST.ODAA.ToDate = left$(BANCS.STDIN.BODDate,10)
	PRINT(CUST.ODAA.ToDate)
	CUST.ODAA.FromDate = CUST.ODAA.Day180
	PRINT(CUST.ODAA.FromDate)
	CALL("IntCal.scr")
	PRINT(CUST.ODAA.IntAmt)
	CUST.ODAA.IntAmt180 = CUST.ODAA.IntAmt
	
	IF (CINT(CUST.ODAA.TODnodays) >= CUST.ODAA.TODDays90) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass003
		GOTO Finish
	#}
	ENDIF
	
	IF (CINT(CUST.ODAA.Expnodays) >= CUST.ODAA.TODDays90) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass003
		GOTO Finish
	#}
	ENDIF
	
	IF (CINT(CUST.ODAA.Inacnodays) >= CUST.ODAA.TODDays90) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass003
		GOTO Finish
	#}
	ENDIF
	
	IF (CDOUBLE(CUST.ODAA.TotAmt180) < CDOUBLE(CUST.ODAA.IntAmt180) ) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass002
       	CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass003
       	GOTO Finish
	#}
	ENDIF
		
	GOTO STEPWAT
	
	STEPWAT:
#------------------------------------------------------------------------------------
# WATCH CLASSIFICATION
#--------------------------------------------------
	sv_s = "Day90|SELECT  to_date('" + LEFT$(BANCS.STDIN.BODDate,10) + "','DD-MM-YYYY') - 90 "
	sv_s = sv_s + "FROM DUAL "
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)

	PRINT(BANCS.OUTPARAM.Day90)

	CUST.ODAA.Day90 = BANCS.OUTPARAM.Day90
	PRINT(CUST.ODAA.Day90)
				
	sv_s = "CrAmtDtd90|select nvl(sum(tran_amt),0) from TBAADM.dtd "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND acid = ?SVAR "
	sv_s = sv_s + "AND  part_tran_type = 'C' "
	sv_s = sv_s + "AND pstd_flg = 'Y' "
	sv_s = sv_s + "AND value_date >= TO_DATE(?SVAR,'DD-MM-YYYY')"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.ODAA.acctAcid  + "|" + CUST.ODAA.Day90
	PRINT(sv_s)

	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 1 ) THEN
	#{
		CUST.ODAA.CrAmtDtd90 = 0
	#}
	ELSE
	#{
	    CUST.ODAA.CrAmtDtd90 = BANCS.OUTPARAM.CrAmtDtd90
		PRINT(CUST.ODAA.CrAmtDtd90)
	#}
	ENDIF

	sv_s = "CrAmtCtd90|" + CUST.ODAA.Query1
	sv_s = sv_s + " and value_date >= TO_DATE('" + CUST.ODAA.Day90 + "','DD-MM-YYYY')"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.ODAA.acctAcid + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 1 ) THEN
	#{
		CUST.ODAA.CrAmtCtd90 = 0
	#}
	ELSE
	#{
		CUST.ODAA.CrAmtCtd90 = BANCS.OUTPARAM.CrAmtCtd90
		PRINT(CUST.ODAA.CrAmtCtd90)
	#}
	ENDIF		

	CUST.ODAA.TotAmt90 = CDOUBLE(CUST.ODAA.CrAmtDtd90) + CDOUBLE(CUST.ODAA.CrAmtCtd90)

	PRINT(CUST.ODAA.CrAmtCtd90)
	PRINT(CUST.ODAA.TotAmt90)

	PRINT(CUST.ODAA.acctAcid)
	PRINT(BANCS.STDIN.BODDate)
	CUST.ODAA.ToDate = left$(BANCS.STDIN.BODDate,10)

	CUST.ODAA.FromDate = CUST.ODAA.Day90
	CALL("IntCal.scr")
	PRINT(CUST.ODAA.IntAmt)
	CUST.ODAA.IntAmt90 = CUST.ODAA.IntAmt

	IF (CINT(CUST.ODAA.TODnodays) >= CUST.ODAA.TODDays30) THEN
	#{

		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass001
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass002
		GOTO Finish
	#}
	ENDIF

	IF (CINT(CUST.ODAA.Expnodays) >= CUST.ODAA.TODDays30) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass001
  		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass002
   		GOTO Finish
	#}
   	ENDIF

	IF (CINT(CUST.ODAA.Inacnodays) >= CUST.ODAA.TODDays30) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass001
		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass002
		GOTO Finish
	#}
	ENDIF	

   	IF (CDOUBLE(CUST.ODAA.TotAmt90) < CDOUBLE(CUST.ODAA.IntAmt90) ) THEN
	#{
		CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass001
   		CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass002
   		GOTO Finish
	#}
   	ENDIF
	
	GOTO STEPNRM
	#------------------------------------------------------------------------------------
        # GENERAL CALCULATION FOR STEPNR
        #---------------------------------
STEPNRM:
	#-------------------------
        # 1. NORMAL CLASSIFICATION
        #-------------------------
	CUST.ODAA.mainClassificationSystem = CUST.ODAA.mainClass001
	CUST.ODAA.subClassificationSystem = CUST.ODAA.subClass001
   	GOTO Finish
				
Finish:

	PRINT(CUST.ODAA.mainClassificationSystem)
	PRINT(CUST.ODAA.subClassificationSystem)
	
	
	BANCS.OUTPUT.mainClassificationSystem = CUST.ODAA.mainClassificationSystem
	PRINT(BANCS.OUTPUT.mainClassificationSystem)
	BANCS.OUTPUT.subClassificationSystem = CUST.ODAA.subClassificationSystem
	PRINT(BANCS.OUTPUT.subClassificationSystem)
	BANCS.OUTPUT.sysCustSubClass = BANCS.OUTPUT.subClassificationSystem
	PRINT(BANCS.OUTPUT.sysCustSubClass)
	BANCS.OUTPUT.sysCustMainClass = BANCS.OUTPUT.mainClassificationSystem
	PRINT(BANCS.OUTPUT.sysCustMainClass)
	BANCS.OUTPUT.assetClsReasonCode = "VEERU"
	PRINT(BANCS.OUTPUT.assetClsReasonCode)
	#BANCS.OUTPUT.percolateToAllAssets = "N"
	BANCS.OUTPUT.trgEntityId = ""
	BANCS.OUTPUT.trgEntityType = ""
	#DELETEREP("CUST")

EXITSCRIPT
TRACE OFF
END-->
