sv_s = "SELECT nvl(sum(tran_amt),0) "
sv_s = sv_s + "FROM TBAADM.CTD " 
sv_s = sv_s + "WHERE ACID = ?SVAR "
sv_s = sv_s + "AND PART_TRAN_TYPE = 'C' "
sv_s = sv_s + "AND PSTD_FLG = 'Y' "
sv_s = sv_s + "AND VALUE_DATE <=  TO_DATE('" + LEFT$(BANCS.STDIN.BODDate,10) + "','DD-MM-YYYY') " 
sv_s = sv_s + "AND bank_id = ?SVAR "
PRINT(sv_s)


CUST.ODAA.Query1 = sv_s

sv_s = "advn_start_date|SELECT to_char(max(discret_advn_start_date), 'DD-MM-RRRR hh24:mm:ss' )   "
sv_s = sv_s + "FROM TBAADM.TDAT " 
sv_s = sv_s + "WHERE TDAT.ACID = ?SVAR " 
sv_s = sv_s + "AND (TDAT.DISCRET_ADVN_REGLR_IND = 'U' OR TDAT.DISCRET_ADVN_REGLR_IND = 'E') "
sv_s = sv_s + "AND bank_id = ?SVAR "
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = CUST.ODAA.acctAcid + "|" + BANCS.STDIN.contextBankId  
PRINT(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s) 
PRINT(sv_d)

IF (sv_d != 0) THEN
#{
  	CUST.ODAA.advn_start_date = BANCS.STDIN.BODDate
	PRINT(CUST.ODAA.advn_start_date)
#}
ELSE
#{
	IF (BANCS.OUTPARAM.advn_start_date!="") THEN
		CUST.ODAA.advn_start_date = BANCS.OUTPARAM.advn_start_date
		PRINT(CUST.ODAA.advn_start_date)
	ELSE
		CUST.ODAA.advn_start_date = BANCS.STDIN.BODDate
		PRINT(CUST.ODAA.advn_start_date)
	ENDIF
#}
ENDIF

