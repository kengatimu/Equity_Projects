			#1
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			sv_b = GETPOSITION(CUST.CCRRM.inputdata, '|')
			print(sv_b)
			sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			CUST.CCRRM.CIF_ID = sv_a
			print(CUST.CCRRM.CIF_ID)


			#2
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			sv_b = GETPOSITION(CUST.CCRRM.inputdata, '|')
			print(sv_b)
			sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			CUST.CCRRM.ACCT_NAME = sv_a
			print(CUST.CCRRM.ACCT_NAME)

			#3
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			sv_b = GETPOSITION(CUST.CCRRM.inputdata, '|')
			print(sv_b)
			sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			CUST.CCRRM.RISK_SCORE = sv_a
			print(CUST.CCRRM.RISK_SCORE)
			
			#4
			sv_c = STRLEN(CUST.CCRRM.inputdata)
			print(sv_c)
			CUST.CCRRM.inputdata = MID$(CUST.CCRRM.inputdata,sv_b,sv_c-sv_b)
			print(CUST.CCRRM.inputdata)
			CUST.CCRRM.RISK_RATING = CUST.CCRRM.inputdata
			print(CUST.CCRRM.RISK_RATING)
			#sv_b = GETPOSITION(CUST.CCRRM.inputdata, '')
			#print(sv_b)
			#sv_a = MID$(CUST.CCRRM.inputdata,0,sv_b-1)
			#CUST.CCRRM.RISK_RATING = sv_a
			#print(CUST.CCRRM.RISK_RATING)

			#--------------------------------------------------------
			#call the script for inserting data
			#--------------------------------------------------------
				CALLSCRIPTIFEXIST("Ccrrm_insert.scr")

			#--------------------------------------------------------
			#--------------------------------------------------------


			NEXTREC:
			
				sv_d = sv_d + 1
				print(sv_d)
				
			
			sv_a = urtn_fileRead(CUST.CCRRM.fileRec + "|CUST.CCRRM.inputdata")
			CUST.CCRRM.fileread = sv_a
			print(sv_a)
		#}
		Do
	

		# --------------  Closing the file
		
		#sv_j = urtn_fileClose(CUST.CCRRM.FilePath)
		#print(sv_j)
		sv_t = urtn_fileClose(CUST.CCRRM.fileRec)
		PRINT(sv_t)
		
		#GOTO EXITCOM
		
		#================COM file for CRM-FI requests
		
		#  *************  START  ********************
		
		sv_u = urhk_getFileLocation("COM|ccrrmBatchMain.com")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			
			
			#----------------------------------------------------------------------------------
			#---    Setting Env variables
			#----------------------------------------------------------------------------------
			sv_a = "CcrrmRefNum|" + CUST.CCRRM.refnumber 
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.CCRRM.errorMsg = "Error in setting env variable Reference Number"
				print(CUST.CCRRM.errorMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "CcrrmEmpId|" + BANCS.STDIN.userId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.CCRRM.errorMsg = "Error in setting env variable User ID"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "Ccrrmworkfile|" + CUST.CCRRM.workfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.CCRRM.errorMsg = "Error in setting env variable WorkFile"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "CcrrmRptFile|" + CUST.CCRRM.reportfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.CCRRM.errorMsg = "Error in setting env variable REport Variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "CcrrmFunc|" + CUST.CCRRM.funCode
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.CCRRM.errorMsg = "Error in setting env variable Input Function"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			
			#----------------------------------------------------------------------------------
			#---    Executing com file in background
			#----------------------------------------------------------------------------------
			BANCS.INPARAM.scriptName = "ccrrmBatchMain.com"
			BANCS.INPARAM.arguments = ""
			sv_u = urhk_CallShellScript("b")
			print(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.CCRRM.errorMsg = "Upload process failed please retry"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.CCRRM.errorMsg = "Unable to load com file"
			GOTO ENDOFSCRIPT
