		ELSE
		#{
			CUST.CCRRM.entryuser = BANCS.OUTPARAM.entryuserid
			print(CUST.CCRRM.entryuser)
			IF(CUST.CCRRM.entryuser==BANCS.STDIN.userId)THEN
			#{
				sv_z = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_z)
				sv_z = "Error_02|ERROR^Entry user cannnot verify^"
				sv_u = urhk_SetOrbOut(sv_z)
				EXITSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
