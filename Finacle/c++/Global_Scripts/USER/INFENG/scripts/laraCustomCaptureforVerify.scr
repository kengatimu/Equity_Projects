                                CUST.LARA.PENAL_ACCRUED_AMOUNT_DR = BANCS.OUTPARAM.PENAL_ACCRUED_AMOUNT_DR
                                CUST.LARA.PENAL_BOOKED_AMOUNT_DR = BANCS.OUTPARAM.PENAL_BOOKED_AMOUNT_DR
