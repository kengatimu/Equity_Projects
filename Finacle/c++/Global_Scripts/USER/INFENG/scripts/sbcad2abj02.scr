                                                sv_e = "Account Cannot Activated, Finacle Error : " + sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
                                                print(sv_e)
                                                sv_i = sv_i + 1
												lv_e = sv_e + " " + CUST.DORM.foracid
                                                sv_u = system("echo '"+lv_e+"' >>acctivated.log")
                                                sv_z = "SuccessOrFailure|Failure"
                                                sv_u = urhk_SetOrbOut(sv_z)
                                                sv_o=urhk_SetOrbOut("MSG|"+sv_e+"'")
                                                print(sv_u)
                                        ELSE
                                                sv_i = sv_i + 1
                                                print(sv_i)
                                        ENDIF
                                ELSE
                                        sv_i = sv_i + 1
                                        print(sv_i)
                                ENDIF
                        #}
                        DO
                #}
                ENDIF	
		GOTO ENDOFSCRIPT
