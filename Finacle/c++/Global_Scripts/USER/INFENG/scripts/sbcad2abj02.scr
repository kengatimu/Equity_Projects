		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUST.DORM.schm_type)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUST.DORM.schmCode)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|"+CUST.DORM.sweeps)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psNextPrintDate|"+BANCS.STDIN.BODDate)
                PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("schmDtls.acctStat.code|A")
		PRINT(sv_u)
		sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
		PRINT(sv_u)
		sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_0>.psNextPrintDate|"+BANCS.STDIN.BODDate)
                PRINT(sv_u)
		sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
		PRINT(sv_u)
		IF(CUST.DORM.swiftStmtReqdFlg == "Y")THEN
                #{
                        sv_u =urhk_SetUrhkInp("acctCommonInfo.acctSwiftStatement.swiftNextDueDate|" + BANCS.STDIN.BODDate)
                        PRINT(sv_u)
                #}
                ENDIF
		sv_u =urhk_SetUrhkInp("schmDtls.acctSchemeEntered|1")
		PRINT(sv_u)		
		sv_u = urhk_ExecSrv("SRV_ModifyCAAcctAndVerify|same_user_verify = Y|retain_all_output = Y|call mode = E|ignore_excp_flg = I")
		PRINT(sv_u)
	#}
