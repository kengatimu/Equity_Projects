        #        print(CUST.DATA.comfil)
        #        sv_u = system(CUST.DATA.comfil)
        #        print(sv_u)
        #endif


     #   call("c2bre_file.scr")


	lv_b = urhk_SetOrbOut("SuccessOrFailure|Y")
	sv_x="File has been Uploaded and Process started successfully."
	CUST.DATA.message = "RESULT_MSG|"+sv_x
	sv_u = urhk_SetOrbOut(CUST.DATA.message)
ENDIF

ENDOFSCRIPT:
exitscript
#trace off
end-->
