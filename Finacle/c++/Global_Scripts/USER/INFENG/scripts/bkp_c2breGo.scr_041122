endif

	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)

	CUST.DATA.funcCode	= BANCS.INPUT.funcCode
	print(CUST.DATA.funcCode)
	CUST.DATA.fileName = BANCS.INPUT.fileName
	print(BANCS.INPUT.fileName)

if(CUST.DATA.funcCode == "U")then
	CUST.DATA.BANKID =BANCS.STDIN.contextBankId
	print(CUST.DATA.BANKID)
	print(BANCS.INPUT.fileName)
	
	sv_s = "filename |"
	sv_s = sv_s + " select substr('"+ CUST.DATA.fileName +"',instr('"+ CUST.DATA.fileName +"' ,'\',-1)+1) "
	sv_s = sv_s + " from dual "
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	if(sv_d == 0) then
	#{
		CUST.DATA.filename = BANCS.OUTPARAM.filename
		print(CUST.DATA.filename)
	#}
	Else
	#{
		CUST.DATA.filename = ""
	#}
	ENDIF
	sv_z = urhk_dbSelectWithBind("count|select count(*) from custom.auto_post_process where file_name='"+CUST.DATA.filename+"'")
        CUST.DATA.count               =       BANCS.OUTPARAM.count
	IF(CUST.DATA.count>0)THEN
	#{
		sv_z = urhk_SetOrbOut("Error_1|ERROR^File Already Uploaded.^fileName")
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_z = urhk_dbSelectWithBind("ReportFileName|select substr('"+CUST.DATA.filename+"',1,length('"+CUST.DATA.filename+"')-4) from dual")
        CUST.DATA.ReportFileName               =       BANCS.OUTPARAM.ReportFileName

	#------------------------------------------------------------
	#	Calling related scripts
	#-----------------------------------------------------------	
	sv_r = urhk_getEnv("ONS_LOG_DIR")
        if(sv_r == 0) then
        #{
                CUST.DATA.FilePath = BANCS.OUTPARAM.envValue
		print(CUST.DATA.FilePath)
        #}
        endif
	CUST.DATA.FilePath = CUST.DATA.FilePath +"/"+BANCS.STDIN.userId+"/"+CUST.DATA.filename
	#CUST.DATA.ReportFilePath = CUST.DATA.FilePath +"/"+BANCS.STDIN.userId+"/"+CUST.DATA.filename_Report
	call("cdataupdp004.scr")
	#call("c2bre_dbInsert.scr")
	sv_e = system("nohup babx4061 $B2K_SESSION_ID c2bre_dbInsert.scr "+CUST.DATA.FilePath+" "+CUST.DATA.ReportFileName+" "+CUST.DATA.filename+" &")
	print(sv_e)
        #sv_u = urhk_getFileLocation("COM|c2breBatch.com")
