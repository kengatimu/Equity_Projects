-------------------------------------------------------------------------------------------------------------
#    Name            : AutoVirtualAccountOpen.scr
#    Description     : Automation menu for suspending CIFs in bulk
#    Date            : 24-Sep-2024
#    Input           : NA
#    Output          : NA
#    Calling Script  : NA
#    Menu Option     : CAUTOMNU (Option - SC)
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1.          15-Aug-2024 	     Osuka S      		Original Version         1.0
#------------------------------------------------------------------------------------------------------

<--START
TRACE ON

	#==============================================================================
	#       Intialising Variables
	#=============================================================================
        IF (REPEXISTS("CUST") == 0) THEN
        #{
        CREATEREP("CUST")
        #}
        ENDIF
       
        sv_r = CLASSEXISTS("CUST","DATA")
        IF (sv_r == 0) THEN
        #{
        CREATECLASS("CUST","DATA",5)
        #}
        ENDIF
        
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)

    	print(CUST.DATA.file_name)

	sv_s = " orgkey,TYPE | select a.orgkey,case when corp_id is null then 'RET' else 'CORP'END Ttype  from CUSTOM.SUSPENDED_CIF a, crmuser.accounts b where a.FILE_NAME =?SVAR and a.SOL_ID =?SVAR and   a.bank_id =?SVAR and a.SUSPENDED ='P'  and  a.orgkey  =b.orgkey "
        BANCS.INPARAM.BINDVARS = CUST.DATA.file_name +"|"+  BANCS.STDIN.mySolAlias +"|"+  BANCS.STDIN.contextBankId
        sv_k = urhk_dbCursorOpenWithBind(sv_s)
        PRINT(sv_k)
        sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        PRINT(sv_m)
        sv_c = urhk_dbCursorFetch(sv_m)
        PRINT(sv_c)
        IF(sv_c != 0)THEN
                CUST.DATA.messg="No records found "
                sv_c=urhk_dbCursorClose(sv_m)
                GOTO ENDOFSCRIPT
        ELSE
                sv_j = 0
                PRINT(sv_j)
                WHILE (sv_c == 0)
                CUST.DATA.orgkey = BANCS.OUTPARAM.orgkey 


		CUST.DATA.interfaceRequestVersion = "10.2"
        	CUST.DATA.bankID =BANCS.STDIN.contextBankId
        	CUST.DATA.channelID = "COR"



        	CUST.DATA.FORACID = BANCS.OUTPARAM.orgkey
        	Print (CUST.DATA.FORACID)
		CUST.DATA.RETCOPR = BANCS.OUTPARAM.TYPE

        CUST.DATA.lastdatepart ="T00:00:00.000"
        print(CUST.DATA.lastdatepart)

        CUST.DATA.sign ="-"
        print(CUST.DATA.sign)

	sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN
        #{
                CUST.DATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
                print(CUST.DATA.msgDateTime)
        #}
        ENDIF

 	sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0)THEN
        #{
                CUST.DATA.RequestID1 = BANCS.OUTPARAM.RequestID
                print(CUST.DATA.RequestID1)
                #}
        ELSE
                #{
                CUST.DATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
                print(CUST.DATA.RequestID1)
        #}
        ENDIF

        CUST.DATA.headerXML = ""
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<Header>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestHeader>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<MessageKey>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestUUID>"+ CUST.DATA.RequestID1 +"</RequestUUID>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<ServiceRequestId>verifyCustomerDetails</ServiceRequestId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<ChannelId>" + CUST.DATA.channelID + "</ChannelId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</MessageKey>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestMessageInfo>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<BankId>" + CUST.DATA.bankID + "</BankId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<TimeZone>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</TimeZone>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<EntityId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</EntityId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<EntityType>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</EntityType>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<MessageDateTime>" + CUST.DATA.msgDateTime + "</MessageDateTime>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</RequestMessageInfo>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<Security>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<Token>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<PasswordToken>"
 	CUST.DATA.headerXML = CUST.DATA.headerXML + "<UserId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</UserId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<Password>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</Password>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</PasswordToken>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</Token>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<FICertToken>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</FICertToken>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUserLoginSessionId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</RealUserLoginSessionId>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUser>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</RealUser>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUserPwd>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</RealUserPwd>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "<SSOTransferToken>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</SSOTransferToken>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</Security>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</RequestHeader>"
        CUST.DATA.headerXML = CUST.DATA.headerXML + "</Header>"

        #-------------------------------------------------------------------------
        #- Forming the Body for RetCustAdd
        #-------------------------------------------------------------------------
        CUST.DATA.bodyXMLMsg = ""
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<Body>"
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<verifyCustomerDetailsRequest>"
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<CustomerVerifyRq>"
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<cifId>" + CUST.DATA.FORACID + "</cifId>"
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<decision>Approve</decision>"

 			IF (CUST.DATA.RETCOPR == "CORP") THEN
                                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<entityName>CorporateCustomer</entityName>"
                        ELSE
                                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<entityName>RetailCustomer</entityName>"
                        ENDIF

        ##CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<reason>ERROR</reason>"
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</CustomerVerifyRq>"
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</verifyCustomerDetailsRequest>"
        CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</Body>"

        #-------------------------------------------------------------------------
        #Appending the header XML and body XML.
        #-------------------------------------------------------------------------
        CUST.DATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
        CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + "<FIXML>"
        CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + CUST.DATA.headerXML
        CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + CUST.DATA.bodyXMLMsg
        CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + "</FIXML>"

 	#-------------------------------------------------------------------------------
        # Setting input values for urhk_ConnectToFIAndSendMsg userhook
        #-------------------------------------------------------------------------------
        BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
        print(BANCS.INPARAM.SERVICE_NAME)
        BANCS.INPARAM.SEND_RECV_FLG             = "R"
        sv_a = CUST.DATA.reqXMLMsg
        PRINT(sv_a)

        #-------------------------------------------------------------------------
        #- Executing the userhook to make the Outbound Call
        #-------------------------------------------------------------------------
        sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
        print(sv_l)
        IF (sv_l != 0) THEN
        #{
                print(BANCS.OUTPARAM.ErrMsg)
                CUST.DATA.errorMsgFlg = "Y"
                CUST.DATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
                CUST.DATA.errorMsgCode = "FIERR"
                GOTO NEXTREC
        #}
        ENDIF
        IF (BANCS.OUTPARAM.ErrMsg != "") THEN
        #{
                CUST.DATA.errorMsgFlg = "Y"
                CUST.DATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                CUST.DATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
                CUST.DATA.errorMsgCode = "FIERR"
                GOTO ENDOFSCRIPT
                #}
        ELSE
                #{
                CUST.DATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                print(CUST.DATA.respXMLMsg)
                CUST.DATA.errorMsgFlg = ""
                CUST.DATA.errorMsgDesc = ""

                CUST.DATA.opndate = ""
                #CUST.DATA.cifid = ""
                CUST.DATA.errorCode = ""
                CUST.DATA.errorDesc = ""
                sv_x = CUST.DATA.respXMLMsg

		#--------------------------------------------------------------------------------------------------------
                # Fetching the status of the request
                #--------------------------------------------------------------------------------------------------------
                sv_y = "<Status>"
                sv_z = "</Status>"
                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                sv_e = GETPOSITION(sv_x, sv_z) - 1
                IF (GETPOSITION(sv_x, sv_y) != 0) THEN
                #{
                        CUST.DATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
                        #}
                ELSE
                        #{
                        CUST.DATA.tranStatus = ""
                #}
                ENDIF
                print(CUST.DATA.tranStatus)
                #--------------------------------------------------------------------------------------------------------
                # If Success fetching cif id and cif opn date else fetching error code and description
                #--------------------------------------------------------------------------------------------------------
                IF (CUST.DATA.tranStatus =="SUCCESS")  THEN
                #{
                        CUST.DATA.errorMsgFlg = "N"
                        sv_x = CUST.DATA.respXMLMsg
                        sv_y = "<CustId>"
                        sv_z = "</CustId>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1
                        IF (GETPOSITION(sv_x, sv_y) != 0) THEN
                        #{
                                CUST.DATA.cifid = MID$(sv_x, sv_b, (sv_e - sv_b))
                                print(CUST.DATA.cifid)
                        #}
                        ENDIF
                        #----------------------------------------------------------------------------------------------------
                        # Update custom table status
                        #----------------------------------------------------------------------------------------------------
                        sv_s = "Update CUSTOM.SUSPENDED_CIF set  SUSPENDED ='Y', VERIFIED_BY =?SVAR where ORGKEY = ?SVAR  and bank_id =?SVAR and  FILE_NAME =?SVAR "
                        print(sv_s)
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + CUST.DATA.FORACID   + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.DATA.file_name  
                        print(BANCS.INPARAM.BINDVARS)
                        sv_d = urhk_dbSQLWithBind(sv_s)
                        IF (sv_d == 0) THEN
                        #{
                                sv_c = urhk_dbSQLWithBind("commit")
                                print(sv_c)
                        #}
                        ENDIF
 			IF (CUST.DATA.FORACID == "") THEN
                        #{
                                CUST.DATA.errorMsgFlg = "Y"
                                CUST.DATA.errorCode = "SYSERR"
                                CUST.DATA.errorDesc = "Could not get response from server"
                        #}
                        ENDIF
                        #}
                ELSE
                        #{
                        CUST.DATA.errorMsgFlg = "Y"
                        IF(CUST.DATA.tranStatus != "SUCCESS") THEN
                        #{
                                sv_x = CUST.DATA.respXMLMsg
                                sv_y = "<ErrorCode>"
                                sv_z = "</ErrorCode>"
                                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                                sv_e = GETPOSITION(sv_x, sv_z) - 1
                                IF (GETPOSITION(sv_x, sv_y) != 0) THEN
                                #{
                                        CUST.DATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
                                #}
                                ENDIF
                                sv_x = CUST.DATA.respXMLMsg
                                sv_y = "<ErrorDesc>"
                                sv_z = "</ErrorDesc>"
                                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                                sv_e = GETPOSITION(sv_x, sv_z) - 1
                                IF (GETPOSITION(sv_x, sv_y) != 0) THEN
                                #{
                                        CUST.DATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
                                #}
                                ENDIF

                                #----------------------------------------------------------------------------------------------------
                                # Update custom table failure status
                                #----------------------------------------------------------------------------------------------------
                                IF((CUST.DATA.errorCode == "") AND (CUST.DATA.errorDesc == "")) THEN
                                #{
                                        CUST.DATA.errorCode = "SYSERR"
                                        CUST.DATA.errorDesc = "Could not get response from server"
                                #}
                                ENDIF

                                sv_s = "UPDATE CUSTOM.SUSPENDED_CIF set  SUSPENDED = 'Z', ERROR_MSG =  REGEXP_REPLACE('"+CUST.DATA.errorDesc+"', '[^[:alnum:][:space:]]', ''),VERIFIED_BY =?SVAR   where ORGKEY = ?SVAR  and bank_id =?SVAR and  FILE_NAME =?SVAR " 
                                print(sv_s)
                                BANCS.INPARAM.BINDVARS =   BANCS.STDIN.userId + "|" +  CUST.DATA.FORACID   + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.DATA.file_name

                               sv_d = urhk_dbSQLWithBind(sv_s)
                                IF (sv_d == 0) THEN
                                #{
                                        sv_c = urhk_dbSQLWithBind("commit")
                                        print(sv_c)
                                #}
                                ENDIF
                        #}
                        ENDIF
                        IF((CUST.DATA.errorCode == "") AND (CUST.DATA.errorDesc == "")) THEN
                        #{
                                CUST.DATA.errorCode = "SYSERR"
                                CUST.DATA.errorDesc = "Could not get response from server"
                        #}
                        ENDIF
                #}
                ENDIF


        #}
        ENDIF

	NEXTREC:
                        sv_c = urhk_dbCursorFetch(sv_m)
                        PRINT(sv_c)

                DO
                sv_c = urhk_dbCursorClose(sv_m)
                PRINT(sv_c)
        ENDIF

                


	ENDOFSCRIPT:
#-- Report for uploaded records
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) "
	sv_s = sv_s + " FROM CUSTOM.SUSPENDED_CIF "
	sv_s = sv_s + " WHERE SUSPENDED = 'Y' "
	sv_s = sv_s + " AND SOL_ID= ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR AND FILE_NAME = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name
	# BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name 
	
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
		CUSTS.DATA.msg = "DB ERROR!"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
	ELSE
		print(BANCS.OUTPARAM.custcount)
		CUST.DATA.count = BANCS.OUTPARAM.custcount
		IF(CUST.DATA.count<1)THEN
			CUST.DATA.msg = "No records found"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			GOTO UPLOADERROR
		ENDIF

		lv_d = urhk_B2k_PID("")
		IF (lv_d == 0) THEN
			CUST.DATA.pid = BANCS.OUTPARAM.PID
			PRINT(CUST.DATA.pid)
		ENDIF

		#-----------------------------------------------------------------------------------------
		#Calling the sql to create the report
		#-----------------------------------------------------------------------------------------
		CUST.DATA.lstFile = "Bulk_Cif_Sus_Verification_Success_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"

		CUST.DATA.status = "Y"
		CUST.DATA.inputStr = CUST.DATA.file_name + "!" + BANCS.STDIN.contextBankId + "!" + CUST.DATA.status + "!" + BANCS.STDIN.mySolId
		print(CUST.DATA.inputStr)

		CUST.DATA.ReportHeader = "CIF ID              |UPLOAD BY |SOL_ID    |SUSPENDED |FILE_NAME                     |VERIFIED  |ERROR_MSG                                                                       |"

		lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
		PRINT(lv_a)
		lv_s = SYSTEM(lv_a)
		PRINT(lv_s)
		
		sv_a = "exebatch spbx4001" + " " + "CUSTOM.BULK_CIF_SUSPENSION.BULK_CIF_SUSPENSION_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
		PRINT(sv_a)
		lv_u = SYSTEM(sv_a)
		PRINT(lv_u)
		IF (lv_u != 0) THEN
		#{
			sv_w = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_w = "Error_03|ERROR^Virtual Account Opening Report Generation Failed^fileName"
			sv_u = urhk_SetOrbOut(sv_w)
			GOTO UPLOADERROR
		ELSE
			#=====================================================================
			# Move the file to HPR menu
			#=====================================================================
			CUST.DATA.userId = BANCS.STDIN.userId
			CUST.DATA.title = "Bulk Cif Sus Upld " + CUST.DATA.file_name + " Success Rpt"
			PRINT(CUST.DATA.title)
			lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
			PRINT(lv_a)
			lv_x = SYSTEM(lv_a)
			PRINT(lv_x)
			if(lv_x == 0) then
				sv_w = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.file_name+". Check status in HPR"
				sv_w = urhk_SetOrbOut(sv_g)
				PRINT(sv_w)
				GOTO UPLOADERROR
			ELSE
				sv_w = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_w)
				sv_w = "Error_03|ERROR^Virtual Account Opening Report Generation Failed^fileName"
				sv_u = urhk_SetOrbOut(sv_w)
				GOTO UPLOADERROR
			ENDIF
		ENDIF
	ENDIF

	# In case of error during upload
	UPLOADERROR:
		sv_s="custcount|"
		sv_s = sv_s + " SELECT COUNT(1) "
		sv_s = sv_s + " FROM CUSTOM.SUSPENDED_CIF "
		sv_s = sv_s + " WHERE SUSPENDED = 'Z' "
		sv_s = sv_s + " AND SOL_ID= ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR AND FILE_NAME = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name
		# BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name 
		
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d != 0) THEN
			CUSTS.DATA.msg = "DB ERROR!"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		ELSE
			print(BANCS.OUTPARAM.custcount)
			CUST.DATA.count = BANCS.OUTPARAM.custcount
			IF(CUST.DATA.count<1)THEN
				CUST.DATA.msg = "No records found"
				sv_c = urhk_setorbout("SuccessOrFailure|N")
				sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
				GOTO SUSPERROR
			ENDIF

			lv_d = urhk_B2k_PID("")
			IF (lv_d == 0) THEN
				CUST.DATA.pid = BANCS.OUTPARAM.PID
				PRINT(CUST.DATA.pid)
			ENDIF

			#-----------------------------------------------------------------------------------------
			#Calling the sql to create the report
			#-----------------------------------------------------------------------------------------		
			CUST.DATA.lstFile = "Bulk_Cif_Sus_Verification_Failure_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"
			CUST.DATA.status = "Z"
			CUST.DATA.inputStr = CUST.DATA.file_name + "!" + BANCS.STDIN.contextBankId + "!" + CUST.DATA.status + "!" + BANCS.STDIN.mySolId
			print(CUST.DATA.inputStr)

			CUST.DATA.ReportHeader = "CIF ID              |UPLOAD BY |SOL_ID    |SUSPENDED |FILE_NAME                     |VERIFIED  |ERROR_MSG                                                                       |"

			lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
			PRINT(lv_a)
			lv_s = SYSTEM(lv_a)
			PRINT(lv_s)
			
			sv_a = "exebatch spbx4001" + " " + "CUSTOM.BULK_CIF_SUSPENSION.BULK_CIF_SUSPENSION_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
			PRINT(sv_a)
			lv_u = SYSTEM(sv_a)
			PRINT(lv_u)
			IF (lv_u != 0) THEN
				sv_w = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_w)
				sv_w = "Error_03|ERROR^Virtual Account Error Report Generation Failed^fileName"
				sv_u = urhk_SetOrbOut(sv_w)
				GOTO SUSPERROR
			ELSE
				#=====================================================================
				# Move the file to HPR menu
				#=====================================================================
				CUST.DATA.userId = BANCS.STDIN.userId
				CUST.DATA.title = "Bulk Cif Sus Upld " + CUST.DATA.file_name + " Failure Rpt"
				PRINT(CUST.DATA.title)
				lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
				PRINT(lv_a)
				lv_x = SYSTEM(lv_a)
				PRINT(lv_x)
				if(lv_x == 0) then
					sv_w = urhk_SetOrbOut("SuccessOrFailure|Y")
					sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.file_name+". Check status in HPR"
					sv_w = urhk_SetOrbOut(sv_g)
					PRINT(sv_w)
					GOTO SUSPERROR
				ELSE
					sv_w = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_w)
					sv_w = "Error_03|ERROR^Virtual Account Error Report Generation Failed^fileName"
					sv_u = urhk_SetOrbOut(sv_w)
					GOTO SUSPERROR
				ENDIF
			ENDIF
		ENDIF

	# In case of error during upload
	SUSPERROR:
		sv_s="custcount|"
		sv_s = sv_s + " SELECT COUNT(1) "
		sv_s = sv_s + " FROM CUSTOM.SUSPENDED_CIF "
		sv_s = sv_s + " WHERE SUSPENDED = 'X' "
		sv_s = sv_s + " AND SOL_ID= ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR AND FILE_NAME = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name
		# BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name 
		
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d != 0) THEN
			CUSTS.DATA.msg = "DB ERROR!"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		ELSE
			print(BANCS.OUTPARAM.custcount)
			CUST.DATA.count = BANCS.OUTPARAM.custcount
			IF(CUST.DATA.count<1)THEN
				CUST.DATA.msg = "No records found"
				sv_c = urhk_setorbout("SuccessOrFailure|N")
				sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
				GOTO ENDOF
			ENDIF

			lv_d = urhk_B2k_PID("")
			IF (lv_d == 0) THEN
				CUST.DATA.pid = BANCS.OUTPARAM.PID
				PRINT(CUST.DATA.pid)
			ENDIF

			#-----------------------------------------------------------------------------------------
			#Calling the sql to create the report
			#-----------------------------------------------------------------------------------------		
			CUST.DATA.lstFile = "Bulk_Cif_Sus_Failure_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"
			CUST.DATA.status = "X"
			CUST.DATA.inputStr = CUST.DATA.file_name + "!" + BANCS.STDIN.contextBankId + "!" + CUST.DATA.status + "!" + BANCS.STDIN.mySolId
			print(CUST.DATA.inputStr)

			CUST.DATA.ReportHeader = "CIF ID              |UPLOAD BY |SOL_ID    |SUSPENDED |FILE_NAME                     |VERIFIED  |ERROR_MSG                                                                       |"

			lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
			PRINT(lv_a)
			lv_s = SYSTEM(lv_a)
			PRINT(lv_s)
			
			sv_a = "exebatch spbx4001" + " " + "CUSTOM.BULK_CIF_SUSPENSION.BULK_CIF_SUSPENSION_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
			PRINT(sv_a)
			lv_u = SYSTEM(sv_a)
			PRINT(lv_u)
			IF (lv_u != 0) THEN
				sv_w = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_w)
				sv_w = "Error_03|ERROR^Virtual Account Error Report Generation Failed^fileName"
				sv_u = urhk_SetOrbOut(sv_w)
				GOTO ENDOF
			ELSE
				#=====================================================================
				# Move the file to HPR menu
				#=====================================================================
				CUST.DATA.userId = BANCS.STDIN.userId
				CUST.DATA.title = "Bulk Cif Sus " + CUST.DATA.file_name + " Failure Rpt"
				PRINT(CUST.DATA.title)
				lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
				PRINT(lv_a)
				lv_x = SYSTEM(lv_a)
				PRINT(lv_x)
				if(lv_x == 0) then
					sv_w = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_w)
					sv_w = "Error_03|ERROR^Virtual Account Error Report Generation Failed^fileName"
					sv_u = urhk_SetOrbOut(sv_w)
					GOTO ENDOF
				ELSE
					CUST.DATA.msg = "Error_2|Error.2^Virtual Account Opening Report Generation Failed "
					sv_c = urhk_setorbout("SuccessOrFailure|N")
					sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
					GOTO ENDOF
				ENDIF
			ENDIF
		ENDIF

ENDOF:
EXITSCRIPT
TRACE OFF
END-->
