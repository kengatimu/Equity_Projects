#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName	: ebTransferBank54TranRevApi.scr 
#Desc		: Creates Charges Transaction in 54 (Interbank Transfer Failure) 
#MenuId		: NA
#CalledScript	: 
#Module		: MKEY -API
#Date		: 17/12/2018
#Author		: Vino Palani
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#+++++++++++++
#Rep&Class
#+++++++++++++
	if(repexists("MKEY")==0)then
		createrep("MKEY")
	endif
	if(classexists("MKEY","GLBDATA")==0)then
		createclass("MKEY","GLBDATA",5)
	endif
#+++++++++++++
#Inputs
#+++++++++++++
	print(MKEY.GLBDATA.drAcct)
	print(MKEY.GLBDATA.crAcct)
	print(MKEY.GLBDATA.drtranAmt)
	print(MKEY.GLBDATA.crtranAmt)
	print(MKEY.GLBDATA.oRefNum)
	MKEY.GLBDATA.RevOthTranId	= ""
	MKEY.GLBDATA.RequestID1	= ""
	MKEY.GLBDATA.msgDateTime	= ""
	MKEY.GLBDATA.channelID	= "COR"
	MKEY.GLBDATA.bankID	= "54"
	MKEY.GLBDATA.tranType	= "T"
	MKEY.GLBDATA.tranSubType = "BI"
	MKEY.GLBDATA.drRate	= "1.00"
	MKEY.GLBDATA.rateCode	= ""
	MKEY.GLBDATA.tranCcyDr	= "KES"
	MKEY.GLBDATA.drAcctID	= MKEY.GLBDATA.drAcct 
	MKEY.GLBDATA.crAcctID	= MKEY.GLBDATA.crAcct 
	MKEY.GLBDATA.tranAmtDr	= cdouble(MKEY.GLBDATA.drtranAmt) 
	MKEY.GLBDATA.tranAmtCr	= cdouble(MKEY.GLBDATA.crtranAmt) 
	MKEY.GLBDATA.commRefNum	= MKEY.GLBDATA.oRefNum 
	MKEY.GLBDATA.fintechSucYN  = "" 
	MKEY.GLBDATA.valerr     = "" 
	MKEY.GLBDATA.drCnt	= ""
	MKEY.GLBDATA.crCnt	= ""
	MKEY.GLBDATA.errorCode	= ""
	MKEY.GLBDATA.errorDesc	= ""
	MKEY.GLBDATA.tranParticularsDr	= "REV_TRANSFER_BANK:Oth for " +MKEY.GLBDATA.crAcctID
	MKEY.GLBDATA.tranRmksDr	= "OthRevDr"
	MKEY.GLBDATA.tranParticularsCr	= "REV_TRANSFER_BANK:Oth from " +MKEY.GLBDATA.drAcctID
	MKEY.GLBDATA.tranRmksCr	= "OthRevCr"
	MKEY.GLBDATA.tranParticulars2Dr	= MKEY.GLBDATA.oRefNum + "/" + MKEY.GLBDATA.crAcctID 
	MKEY.GLBDATA.tranParticulars2Cr	= MKEY.GLBDATA.oRefNum + "/" + MKEY.GLBDATA.drAcctID 
#++++++++++++
#Validations
#++++++++++++
	sv_s = "drCnt | select count(*) from tbaadm.gam where foracid='"+ MKEY.GLBDATA.drAcctID +"'  and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg='N' "	
	sv_s = sv_s + " and bank_id = '"+ MKEY.GLBDATA.bankID +"' "
	sv_u = urhk_dbSelectWithBind(sv_s)
	if(sv_u == 0)then
		MKEY.GLBDATA.drCnt	= BANCS.OUTPARAM.drCnt
	else
		MKEY.GLBDATA.drCnt	= ""
	endif
	sv_s = "crCnt | select count(*) from tbaadm.gam where foracid='"+ MKEY.GLBDATA.crAcctID +"'  and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg='N' "	
	sv_s = sv_s + " and bank_id = '"+ MKEY.GLBDATA.bankID +"' "
	sv_u = urhk_dbSelectWithBind(sv_s)
	if(sv_u == 0)then
		MKEY.GLBDATA.crCnt	= BANCS.OUTPARAM.crCnt
	else
		MKEY.GLBDATA.crCnt	= ""
	endif
	if(MKEY.GLBDATA.drCnt != "1")then
		MKEY.GLBDATA.fintechSucYN	= "N"
		MKEY.GLBDATA.valerr	= "99 Tran Dr Account Not Found ! " + MKEY.GLBDATA.drAcctID
		goto ENDSCR
	endif
	if(MKEY.GLBDATA.crCnt != "1")then
		MKEY.GLBDATA.fintechSucYN	= "N"
		MKEY.GLBDATA.valerr	= "99 Tran Cr Account Not Found ! " + MKEY.GLBDATA.crAcctID
		goto ENDSCR
	endif
#+++++++++++++
#DeriveInputs
#+++++++++++++
	sv_s = "RequestID1|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0)then
		MKEY.GLBDATA.RequestID1 = BANCS.OUTPARAM.RequestID1
		print(MKEY.GLBDATA.RequestID1)
	else
		MKEY.GLBDATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(MKEY.GLBDATA.RequestID1)
	endif
	MKEY.GLBDATA.RequestID1=MKEY.GLBDATA.RequestID1
	sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0) then
		MKEY.GLBDATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
		print(MKEY.GLBDATA.msgDateTime)
	else
		MKEY.GLBDATA.fintechSucYN	= "N"
		MKEY.GLBDATA.valerr	= "99 InterBank Tran API Creation Failed " 
		goto ENDSCR
	endif
#+++++++++++++
#Header XML
#+++++++++++++
	MKEY.GLBDATA.headerXML = ""
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Header>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RequestHeader>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<MessageKey>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RequestUUID>"+ MKEY.GLBDATA.RequestID1 +"</RequestUUID>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ServiceRequestId>XferTrnAdd</ServiceRequestId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ChannelId>" + MKEY.GLBDATA.channelID + "</ChannelId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<LanguageId></LanguageId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</MessageKey>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RequestMessageInfo>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<BankId>" + MKEY.GLBDATA.bankID + "</BankId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<TimeZone></TimeZone>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<EntityId></EntityId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<EntityType></EntityType>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ArmCorrelationId></ArmCorrelationId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<MessageDateTime>" + MKEY.GLBDATA.msgDateTime + "</MessageDateTime>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</RequestMessageInfo>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Security>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Token>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<PasswordToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<UserId></UserId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Password></Password>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</PasswordToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</Token>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<FICertToken></FICertToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RealUserLoginSessionId></RealUserLoginSessionId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RealUser></RealUser>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RealUserPwd></RealUserPwd>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<SSOTransferToken></SSOTransferToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</Security>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</RequestHeader>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</Header>"
#+++++++++++++
#Body XML
#+++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = ""
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<body><XferTrnAddRequest>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnAddRq>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnHdr>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnType>" + MKEY.GLBDATA.tranType + "</TrnType>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnSubType>" + MKEY.GLBDATA.tranSubType + "</TrnSubType>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnHdr>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnDetail>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRec>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>" + MKEY.GLBDATA.drAcctID + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<CreditDebitFlg>D</CreditDebitFlg>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<amountValue>" + MKEY.GLBDATA.tranAmtDr + "</amountValue>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<currencyCode>" + MKEY.GLBDATA.tranCcyDr + "</currencyCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnParticulars>" + MKEY.GLBDATA.tranParticularsDr + "</TrnParticulars>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRmks>" + MKEY.GLBDATA.tranRmksDr + "</PartTrnRmks>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<ValueDt>"+ MKEY.GLBDATA.msgDateTime + "</ValueDt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<Rate>" + MKEY.GLBDATA.drRate + "</Rate>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<RateCode>" + MKEY.GLBDATA.rateCode + "</RateCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SerialNum>1</SerialNum>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PartTrnRec>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRec>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>" + MKEY.GLBDATA.crAcctID + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<CreditDebitFlg>C</CreditDebitFlg>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<amountValue>" + MKEY.GLBDATA.tranAmtCr + "</amountValue>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<currencyCode>" + MKEY.GLBDATA.tranCcyDr + "</currencyCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnParticulars>" + MKEY.GLBDATA.tranParticularsCr + "</TrnParticulars>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRmks>" + MKEY.GLBDATA.tranRmksCr + "</PartTrnRmks>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<ValueDt>"+ MKEY.GLBDATA.msgDateTime + "</ValueDt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<Rate>" + MKEY.GLBDATA.drRate + "</Rate>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<RateCode>" + MKEY.GLBDATA.rateCode + "</RateCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SerialNum>2</SerialNum>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PartTrnRec>"

	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnDetail>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnAddRq>"

	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnAdd_CustomData>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PARTTRANDTLS isMultiRec='Y'>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SRLNUM>1</SRLNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<REFNUM>" + MKEY.GLBDATA.commRefNum + "</REFNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TRANPARTICULARS2>" + MKEY.GLBDATA.tranParticulars2Dr + "</TRANPARTICULARS2>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PARTTRANDTLS>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PARTTRANDTLS isMultiRec='Y'>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SRLNUM>2</SRLNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<REFNUM>" + MKEY.GLBDATA.commRefNum + "</REFNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TRANPARTICULARS2>" + MKEY.GLBDATA.tranParticulars2Cr + "</TRANPARTICULARS2>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PARTTRANDTLS>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnAdd_CustomData>"

	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnAddRequest></body>"

	print(MKEY.GLBDATA.bodyXMLMsg)
#+++++++++++++++++++++++++++++++++++++
#Appending the header XML and body XML.
#+++++++++++++++++++++++++++++++++++++
	MKEY.GLBDATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + "<FIXML>"
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + MKEY.GLBDATA.headerXML
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + MKEY.GLBDATA.bodyXMLMsg
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + "</FIXML>"
#+++++++++++++++++++
# FI Call 
#+++++++++++++++++++
	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	sv_a = MKEY.GLBDATA.reqXMLMsg
	PRINT(sv_a)
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	if(sv_l != 0)then
		print(BANCS.OUTPARAM.ErrMsg)
		MKEY.GLBDATA.fintechSucYN = "N"	
		MKEY.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
		if(BANCS.OUTPARAM.ErrMsg != "") then
			MKEY.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
			MKEY.GLBDATA.fintechSucYN = "N"	
			MKEY.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
			goto ENDSCR
		endif
	else
			MKEY.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
			print(MKEY.GLBDATA.respXMLMsg)
			MKEY.GLBDATA.fintechSucYN = "Y"	
			MKEY.GLBDATA.valerr = "" 
	endif
	sv_x = MKEY.GLBDATA.respXMLMsg
#++++++++++++++++++
#FI Response
#++++++++++++++++++
	sv_y = "<Status>"
	sv_z = "</Status>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	if (GETPOSITION(sv_x, sv_y) != 0) then
		MKEY.GLBDATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
	else
		MKEY.GLBDATA.tranStatus = ""
	endif
	print(MKEY.GLBDATA.tranStatus)
	if(MKEY.GLBDATA.tranStatus == "SUCCESS") then
		sv_x = MKEY.GLBDATA.respXMLMsg
		sv_y = "<TrnId>"
		sv_z = "</TrnId>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		if (GETPOSITION(sv_x, sv_y) != 0) then
			MKEY.GLBDATA.tranId = MID$(sv_x, sv_b, (sv_e - sv_b))
		endif
		if(MKEY.GLBDATA.tranId == "") then
			MKEY.GLBDATA.fintechSucYN = "N"	
			MKEY.GLBDATA.valerr = "Could Not Get Response from Server" 
			goto ENDSCR
		else
			print(MKEY.GLBDATA.tranId)
		endif
	else
		if(MKEY.GLBDATA.tranStatus == "FAILED") then
			sv_x = MKEY.GLBDATA.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			if(GETPOSITION(sv_x, sv_y) != 0) then
				MKEY.GLBDATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
			endif
			sv_x = MKEY.GLBDATA.respXMLMsg
			sv_y = "<ErrorDesc>"
			sv_z = "</ErrorDesc>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			if(GETPOSITION(sv_x, sv_y) != 0) then
				MKEY.GLBDATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
			endif
		endif
		if((MKEY.GLBDATA.errorCode == "") AND (MKEY.GLBDATA.errorDesc == "")) then
			MKEY.GLBDATA.fintechSucYN = "N"	
			MKEY.GLBDATA.valerr = "Could Not Get Response from Server" 
			goto ENDSCR
		else
			MKEY.GLBDATA.fintechSucYN = "N"	
			MKEY.GLBDATA.valerr = MKEY.GLBDATA.errorCode + ":" + MKEY.GLBDATA.errorDesc 
			goto ENDSCR
		endif
	endif
	if(MKEY.GLBDATA.tranId!="")then
		MKEY.GLBDATA.fintechSucYN = "Y"	
		MKEY.GLBDATA.valerr    = "54SUCCESS"
		MKEY.GLBDATA.RevOthTranId	= MKEY.GLBDATA.tranId
		goto ENDSCR
	else
		MKEY.GLBDATA.fintechSucYN = "N"	
		MKEY.GLBDATA.valerr    = "54FAIL"
		MKEY.GLBDATA.RevOthTranId	= ""
		goto ENDSCR
	endif

ENDSCR:
	print(MKEY.GLBDATA.fintechSucYN)
	print(MKEY.GLBDATA.valerr)
	print(MKEY.GLBDATA.RevOthTranId)
end-->
