			MTT.PartTranDetails.TranIdentifier      = "CASHH_TRAN"
			MTT.PartTranDetails.ParticularsCode	= CUST.DATA.tran_code
                        MTT.PartTranDetails.RateCode            = CUST.DATA.rate_code
                        MTT.PartTranDetails.Rate                = CUST.DATA.rate

			IF( TRIM(CUST.DATA.crncy_code) != "KES" ) THEN
			#{
			#}
