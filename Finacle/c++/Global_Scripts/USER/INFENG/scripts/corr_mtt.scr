CUST.DATA.Credit_amt = 0

sv_a = "foracid,tran_amt,tran_indicator,tran_particular,tran_rmks,part_details,crncy_code,tran_code,rate,rate_code,ref_ccy|"
sv_a = sv_a + "SELECT foracid,tran_amt,tran_indicator,tran_particular,tran_rmks,part_details,currency,tran_code,rate,rate_code,ref_ccy"
