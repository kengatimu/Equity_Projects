<--START
	TRACE ON
	
	#========================================================
	# Check whether CUST Repository exists else create it
	#========================================================
	sv_r = REPEXISTS("CUST")
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	#========================================================
	# Check whether UBP Class exists else create it
	#========================================================
	sv_r = CLASSEXISTS("CUST","UBP")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","UBP",5)
	#}
	ENDIF
	#========================================================
	# Check whether DATA Class exists else create it
	#========================================================
	sv_r = CLASSEXISTS("CUST","DATA")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","DATA",5)
	#}
	ENDIF
	#========================================================
	# Initialize the variables
	#========================================================
	
	#CUST.UBP.userid = "JM15260"
	IF( (FIELDEXISTS(("BANCS").("INPUT").("userid"))== 0) ) THEN
		CUST.UBP.errorMsg="Kindly Supply userid "
		sv_e=urhk_SetOrbOut("Error|"+CUST.UBP.errorMsg)
		GOTO ENDOFSCRIPT
	ELSE
		CUST.UBP.userid =BANCS.INPUT.userid
		print(CUST.UBP.userid)
	ENDIF
	#CUST.UBP.currency = "KES"
	IF( (FIELDEXISTS(("BANCS").("INPUT").("currency"))== 0) ) THEN
		CUST.UBP.errorMsg="Kindly Supply currency "
		sv_e=urhk_SetOrbOut("Error|"+CUST.UBP.errorMsg)
		GOTO ENDOFSCRIPT
	ELSE
		CUST.UBP.currency =BANCS.INPUT.currency
		print(CUST.UBP.currency)
	ENDIF
	#CUST.UBP.solid = "017"
	IF( (FIELDEXISTS(("BANCS").("INPUT").("solid"))== 0) ) THEN
		CUST.UBP.errorMsg="Kindly Supply solid "
		sv_e=urhk_SetOrbOut("Error|"+CUST.UBP.errorMsg)
		GOTO ENDOFSCRIPT
	ELSE
		CUST.UBP.solid = BANCS.INPUT.solid
		print(CUST.UBP.solid)
	ENDIF
	CUST.UBP.bankId=" "
	CUST.UBP.valType=" "
	CUST.UBP.recordCount = "0"
	CUST.DATA.number = "0"
	CUST.UBP.errorMsg=""
	CUST.UBP.errorFlg="N"
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0

	#========================================================
	# Fetching the Record count
	#========================================================
	BANCS.INPARAM.BINDVARS =  CUST.UBP.userid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.UBP.solid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.UBP.currency
	print(BANCS.INPARAM.BINDVARS )
	sv_s = "recordNum|"
	sv_s = sv_s + " SELECT sum(A.denom_count - B.denom_count) as denommt  FROM C_DENM A, C_DENM_DR B WHERE A.crncy_code = B.crncy_code "
	sv_s = sv_s + " AND A.denom_value = B.denom_value AND A.bank_id = B.bank_id "
	sv_s = sv_s + " AND A.denom_ind = B.denom_ind AND A.del_flg = 'N' AND A.sol_id = B.sol_id "
	sv_s = sv_s + " AND A.teller_id in (select USER_EMP_ID from tbaadm.upr where USER_ID= ?SVAR and HOME_BANK_ID= ?SVAR and del_flg='N')  "
	sv_s = sv_s + "  AND A.sol_id = ?SVAR AND A.bank_id = ?SVAR AND A.crncy_code = ?SVAR  "
	sv_s = sv_s + " AND A.teller_id = B.teller_id ORDER BY A.Denom_Ind "
	PRINT(sv_s)

	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.UBP.recordNum = BANCS.OUTPARAM.recordNum
		PRINT(CUST.UBP.recordNum)
		IF (CUST.UBP.recordNum=="") THEN
			CUST.UBP.errorMsg="No demon Maintained "
			sv_e=urhk_SetOrbOut("Error|"+CUST.UBP.errorMsg)
			CUST.UBP.errorFlg="Y"
			GOTO ENDOFSCRIPT
		ENDIF
	#}
	ELSE
		CUST.UBP.errorMsg="No demon Maintained "
		sv_e=urhk_SetOrbOut("Error|"+CUST.UBP.errorMsg)
		CUST.UBP.errorFlg="Y"
		GOTO ENDOFSCRIPT
	ENDIF
	
	IF(CUST.UBP.recordNum=="0") THEN
	#{
		CUST.UBP.errorMsg="No demon Maintained "
		sv_e=urhk_SetOrbOut("Error|"+CUST.UBP.errorMsg)
		CUST.UBP.errorFlg="Y"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		#========================================================
		BANCS.INPARAM.BINDVARS =  CUST.UBP.userid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.UBP.solid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.UBP.currency
		print(BANCS.INPARAM.BINDVARS )
		sv_s = "denom_desc,denom_value, denommt|"
		sv_s = sv_s + " SELECT  decode(a.denom_ind,'C','COINS','N','NOTES')as denom_desc ,a.denom_value ,(A.denom_count - B.denom_count) as denommt  FROM C_DENM A, C_DENM_DR B WHERE A.crncy_code = B.crncy_code "
		sv_s = sv_s + " AND A.denom_value = B.denom_value AND A.bank_id = B.bank_id "
		sv_s = sv_s + " AND A.denom_ind = B.denom_ind AND A.del_flg = 'N' AND A.sol_id = B.sol_id "
		sv_s = sv_s + " AND A.teller_id in (select USER_EMP_ID from tbaadm.upr where USER_ID= ?SVAR and HOME_BANK_ID= ?SVAR and del_flg='N')  "
		sv_s = sv_s + "  AND A.sol_id = ?SVAR AND A.bank_id = ?SVAR AND A.crncy_code = ?SVAR  "
		sv_s = sv_s + " AND A.teller_id = B.teller_id ORDER BY A.Denom_Ind "
		PRINT(sv_s)
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		PRINT(sv_c)
		IF(sv_c != 0)THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_n)
		sv_f = urhk_dbCursorFetch(sv_n)
		PRINT(sv_f)
		CUST.DATA.number = "0"
		print(CUST.DATA.number)
		WHILE(sv_f == 0)
		#{
			CUST.UBP.denom_desc = BANCS.OUTPARAM.denom_desc
			PRINT(CUST.UBP.denom_desc)
			CUST.UBP.denom_value = BANCS.OUTPARAM.denom_value
			PRINT(CUST.UBP.denom_value)
			CUST.UBP.denom_desc = CUST.UBP.denom_desc + "_" + CUST.UBP.denom_value
			PRINT(CUST.UBP.denom_desc)
			CUST.UBP.denommt = BANCS.OUTPARAM.denommt
			PRINT(CUST.UBP.denommt)

			IF (strlen(CUST.UBP.denom_desc) !="") THEN 
			     sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.denom_desc|" + CUST.UBP.denom_desc
					print(sv_s)
				       sv_Z = urhk_SetOrbOut(sv_s)
			ENDIF
			IF (strlen(CUST.UBP.denommt) !="") THEN
			     sv_s = "billers.<rec_" + CUST.DATA.number + ">.BG.denommt|" + CUST.UBP.denommt
				       print(sv_s)
				       sv_Z = urhk_SetOrbOut(sv_s)
			ENDIF

			CUST.DATA.numberone = "1"
			print(CUST.DATA.numberone)
			print(CUST.DATA.number)
			sv_q = "number|select ('" + CUST.DATA.number + "' + '" + CUST.DATA.numberone + "') from dual "
			print(sv_q)
			sv_w=urhk_dbSelectWithBind(sv_q)
			if (sv_w == 0) then
				print("sumamount")
				CUST.DATA.number = BANCS.OUTPARAM.number
				print(CUST.DATA.number)
			endif

			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			print(CUST.DATA.number)
			
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_n)
		PRINT(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:

	print(CUST.UBP.errorMsg)
	print(CUST.UBP.errorFlg)
	IF(CUST.UBP.errorFlg=="Y")THEN
	#{
		sv_u = urhk_SetOrbOut("Error|"+CUST.UBP.errorMsg)
		PRINT(sv_u)
		sv_b=urhk_SetOrbOut("SuccessOrFailure|N")
	ELSE
		sv_b=urhk_SetOrbOut("SuccessOrFailure|Y")
	#}
	ENDIF
END-->
