                        MCNT.EFTD.srvErrMsg =  "taraco Cursor Fetch Failed"
                        MCNT.EFTD.srvErrCode = "DBCursor"
                        MCNT.EFTD.srvSucFail = "C"
                        goto VAYU
                endif
                MCNT.EFTD.porRec = cint(MCNT.EFTD.porRec) + 1
                MCNT.EFTD.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + MCNT.EFTD.porRec
                print(MCNT.EFTD.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(MCNT.EFTD.porcurNum)
