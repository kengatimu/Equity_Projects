<--start
trace on
        sv_u = urhk_b2k_printrepos("BANCS")
        print(sv_u)
        if(repexists("MCNT") == 0)then
                createrep("MCNT")
        endif
        if(classexists("MCNT","EFTD") == 0)then
                createclass("MCNT","EFTD",5)
        endif
        if(repexists("EQSRV") == 0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0)then
                createclass("EQSRV","GLBDATA",5)
        endif
	MCNT.EFTD.srvErrCode = ""
	MCNT.EFTD.srvErrMsg = ""
	MCNT.EFTD.srvSucFail = ""
	MCNT.EFTD.isCutYN = ""
	MCNT.EFTD.custValueDate = ""
	MCNT.EFTD.OrderType = "CT"
	MCNT.EFTD.OrigEntityType = "PORD"
	MCNT.EFTD.POType = "RTGS"
	MCNT.EFTD.DrValueDate = BANCS.STDIN.BODDate
	MCNT.EFTD.DrExecutionDate = BANCS.STDIN.BODDate
	MCNT.EFTD.remitAmt = ""
	MCNT.EFTD.remitCrncy = ""
	MCNT.EFTD.ordPartyName = "Equity Bank Kenya Limited"
	MCNT.EFTD.ordPartyAdd1 = "Equity Centre"
	MCNT.EFTD.ordPartyAdd2 = "Hospital Hill Road"
	MCNT.EFTD.ordPartyAdd3 = "P.O. BOX 75104-00200 Nairobi"
	MCNT.EFTD.ordCntryCode = "KE"
	MCNT.EFTD.drAcctId = ""
	MCNT.EFTD.crAcctId = ""
	MCNT.EFTD.OurCorrespBIC = ""
	MCNT.EFTD.OurCorrespBankCode = ""
	MCNT.EFTD.OurCorrespBrCode = ""
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                MCNT.EFTD.trSting = MTT.InputDetails.Argument1
                sv_l = strlen(MCNT.EFTD.trSting)
                sv_f = mid$(MCNT.EFTD.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                MCNT.EFTD.uplbatchId  = mid$(sv_f,0,(sv_p-1))
                #--
                MCNT.EFTD.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(MCNT.EFTD.trSting)
                sv_f = mid$(MCNT.EFTD.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                MCNT.EFTD.drAcctId  = mid$(sv_f,0,(sv_p-1))
                #--
                MCNT.EFTD.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(MCNT.EFTD.trSting)
                sv_f = mid$(MCNT.EFTD.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                MCNT.EFTD.benefAcctId  = mid$(sv_f,0,(sv_p-1))
		#--
                MCNT.EFTD.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(MCNT.EFTD.trSting)
                sv_f = mid$(MCNT.EFTD.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                MCNT.EFTD.benefBicCode  = mid$(sv_f,0,(sv_p-1))
                MCNT.EFTD.remitAmt = mid$(sv_f,sv_p,sv_l)
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        endif
	sv_d = "uplbatchId,drAcctId,crAcctId,remitAmt,remitSol,remitCrncy,benefBranchCode,benefBicCode,benefBankCode,narration,benefName,benefAcctId | "
	sv_d = sv_d + " select upl_batch_id,dr_acct_id,cr_acct_id,remit_amt,our_branch_code,remit_crncy,benef_branch_code,benef_bic_code,benef_bank_code,narration,benef_name,benef_acct_id from custom.cust_merchant_po_tbl "
	sv_d = sv_d + " where bank_id=?SVAR "
	sv_d = sv_d + " and upl_batch_id=?SVAR "
	sv_d = sv_d + " and dr_acct_id=?SVAR " 
	sv_d = sv_d + " and benef_acct_id=?SVAR " 
	sv_d = sv_d + " and benef_bic_code=?SVAR " 
	sv_d = sv_d + " and remit_amt=?NVAR " 
	sv_d = sv_d + " and entity_cre_flg='Y' "
	sv_d = sv_d + " and del_flg='N' "
	sv_d = sv_d + " and process_status='U'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.uplbatchId + "|" + MCNT.EFTD.drAcctId + "|" + MCNT.EFTD.benefAcctId + "|" + MCNT.EFTD.benefBicCode + "|" + MCNT.EFTD.remitAmt 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
        sv_u = urhk_dbCursorOpenWithBind(sv_d)
        if(sv_u==0)then
                MCNT.EFTD.porcurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                MCNT.EFTD.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                MCNT.EFTD.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                MCNT.EFTD.srvSucFail = "F"
                goto VAYU
        endif
        MCNT.EFTD.porRec = 0
        print(MCNT.EFTD.porcurNum)
        sv_z = urhk_dbCursorFetch(MCNT.EFTD.porcurNum)
        if(sv_z!=0)then
                MCNT.EFTD.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                MCNT.EFTD.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                MCNT.EFTD.srvSucFail = "F"
                goto VAYU
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{ vploop starts
        #+++++++++++++++++
		MCNT.EFTD.uplbatchId = BANCS.OUTPARAM.uplbatchId
		MCNT.EFTD.drAcctId = BANCS.OUTPARAM.drAcctId
		MCNT.EFTD.crAcctId = BANCS.OUTPARAM.crAcctId
		MCNT.EFTD.remitAmt = BANCS.OUTPARAM.remitAmt
		MCNT.EFTD.remitSol = BANCS.OUTPARAM.remitSol
		MCNT.EFTD.remitCrncy = BANCS.OUTPARAM.remitCrncy
		MCNT.EFTD.benefBranchCode = BANCS.OUTPARAM.benefBranchCode
		MCNT.EFTD.benefBicCode = BANCS.OUTPARAM.benefBicCode
		MCNT.EFTD.benefBankCode = BANCS.OUTPARAM.benefBankCode
		MCNT.EFTD.narration = BANCS.OUTPARAM.narration
		MCNT.EFTD.benefName = BANCS.OUTPARAM.benefName
		MCNT.EFTD.benefAcctId = BANCS.OUTPARAM.benefAcctId
#val
		lv_i = MCNT.EFTD.benefBankCode + "|" + MCNT.EFTD.benefBranchCode
		lv_r = urhk_B2k_valBankBranchCode(lv_i)
		if(lv_r == 0) then
			BANCS.INPUT.OrderingCustomerName     =  BANCS.OUTPARAM.BranchName
			print(BANCS.INPUT.OrderingCustomerName)
			BANCS.INPUT.OrderingCustomerAddress1 =  BANCS.OUTPARAM.Addr1
			print(BANCS.INPUT.OrderingCustomerAddress1)
			BANCS.INPUT.OrderingCustomerAddress2 =  BANCS.OUTPARAM.Addr2
			print(BANCS.INPUT.OrderingCustomerAddress2)
			BANCS.INPUT.OrderingCustomerAddress3 =  BANCS.OUTPARAM.CityCode
			print(BANCS.INPUT.OrderingCustomerAddress3)
		else
			MCNT.EFTD.srvErrCode = "BANKBRANCH"
			MCNT.EFTD.srvErrMsg = "The branch or the bank and branch combination is invalid." 
			MCNT.EFTD.srvSucFail = "F"
			goto VAYU
		endif
		sv_u = urhk_getAcctDetailsInRepository(MCNT.EFTD.drAcctId)
		if(sv_u==0)then
			print(BANCS.OUTPARAM.AvailableAmt)
			print(BANCS.OUTPARAM.ClearBalance)
			print(BANCS.OUTPARAM.EffAvailableAmt)
			print(BANCS.OUTPARAM.systemGeneratedLimit)
			print(BANCS.OUTPARAM.SystemReservedAmt)
			print(BANCS.OUTPARAM.singleTranLimit)
			print(BANCS.OUTPARAM.cleanSingleTranLimit)
			print(BANCS.OUTPARAM.acctName)
			print(BANCS.OUTPARAM.custId)
			MCNT.EFTD.dracctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		else
			MCNT.EFTD.srvErrCode = "DRACCTID"
			MCNT.EFTD.srvErrMsg = "Invalid Debit Account " + MCNT.EFTD.drAcctId
			MCNT.EFTD.srvSucFail = "F"
			goto VAYU
		endif
		sv_u = urhk_getAcctDetailsInRepository(MCNT.EFTD.crAcctId)
		if(sv_u==0)then
			print(BANCS.OUTPARAM.AvailableAmt)
			print(BANCS.OUTPARAM.ClearBalance)
			print(BANCS.OUTPARAM.EffAvailableAmt)
			print(BANCS.OUTPARAM.systemGeneratedLimit)
			print(BANCS.OUTPARAM.SystemReservedAmt)
			print(BANCS.OUTPARAM.singleTranLimit)
			print(BANCS.OUTPARAM.cleanSingleTranLimit)
			MCNT.EFTD.cracctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		else
			MCNT.EFTD.srvErrCode = "CRACCTID"
			MCNT.EFTD.srvErrMsg = "Invalid Credit Account " + MCNT.EFTD.crAcctId
			MCNT.EFTD.srvSucFail = "F"
			goto VAYU
		endif
		if(MCNT.EFTD.dracctCrncyCode!=MCNT.EFTD.remitCrncy)then
			MCNT.EFTD.israteYN = "Y"
		else
			MCNT.EFTD.israteYN = "N"
		endif
		##BANCS.INPARAM.crncyCode = MCNT.EFTD.remitCrncy 
		##BANCS.INPARAM.solId = BANCS.STDIN.homeSolId 
		##sv_r = urhk_GetCrncyCorrBankDtls("")
		##if (sv_r != 0) then
		##	MCNT.EFTD.srvErrCode = "REMITCRNCY"
		##	MCNT.EFTD.srvErrMsg = "Invalid Remit Currency " + MCNT.EFTD.remitCrncy 
		##	MCNT.EFTD.srvSucFail = "F"
		##	goto VAYU
		##else
		##	MCNT.EFTD.OurCorrespBankCode = BANCS.OUTPARAM.crncyCorrBankCode
		##	MCNT.EFTD.OurCorrespBrCode = BANCS.OUTPARAM.crncyCorrBranchCode 
		##	BANCS.INPARAM.bankCode = BANCS.OUTPARAM.crncyCorrBankCode
		##	BANCS.INPARAM.branchCode = BANCS.OUTPARAM.crncyCorrBranchCode
		##	BANCS.INPARAM.paysysID = "RTGS" 
		##	sv_r = urhk_GetBICForBankBranch("")
		##	if (sv_r == 0) then
		##		MCNT.EFTD.OurCorrespBIC = BANCS.OUTPARAM.bankIdentifier
		##	else
		##		MCNT.EFTD.OurCorrespBIC = "CBKEKENXXXX"
		##	endif
		##endif
		##BANCS.INPARAM.bankCode = MCNT.EFTD.OurCorrespBankCode 
		##BANCS.INPARAM.branchCode = MCNT.EFTD.OurCorrespBrCode 
		##BANCS.INPARAM.crncyCode = MCNT.EFTD.remitCrncy 
		##BANCS.INPARAM.solId = BANCS.STDIN.homeSolId 
		##sv_j = urhk_GetCorrBankAccntDetails("")
		##if(sv_j==0)then
	##		MCNT.EFTD.vostroForacid       = BANCS.OUTPARAM.vostroForacid
	##		MCNT.EFTD.nostroMirrorAcctPH  = BANCS.OUTPARAM.nostroMirrorAcctPH
	##		if(MCNT.EFTD.vostroForacid == "")then
	##			sv_o = BANCS.OUTPARAM.nostroMirrorAcctPH+"|"+MCNT.EFTD.remitCrncy+"|"+BANCS.STDIN.homeSolId
	##			sv_g = urhk_B2k_BacidToAcctId(sv_o)
	##			if (sv_g == 0) then
	##				MCNT.EFTD.finalStlmtAcct = BANCS.OUTPARAM.AcctId
	##			endif
	##		else
	##			MCNT.EFTD.finalStlmtAcct = PAYSYS.PORD.vostroForacid
	##		endif
	##	else
	##		if(MCNT.EFTD.remitCrncy =="USD")then
	##			MCNT.EFTD.finalStlmtAcct = "0001100101153"
	##		endif
	##		if(MCNT.EFTD.remitCrncy =="KES")then
	##			MCNT.EFTD.finalStlmtAcct = "0001100100422"
	##		endif
	##	endif
		if(MCNT.EFTD.remitCrncy=="USD")then
			MCNT.EFTD.OurCorrespBankCode = "09"
			MCNT.EFTD.OurCorrespBrCode = "001"
			MCNT.EFTD.finalStlmtAcct = "0001100101153"
			MCNT.EFTD.OurCorrespBIC = "CBKEKENXXXX"
		endif
		if(MCNT.EFTD.remitCrncy=="KES")then
			MCNT.EFTD.OurCorrespBankCode = "09"
			MCNT.EFTD.OurCorrespBrCode = "001"
			MCNT.EFTD.finalStlmtAcct = "0001100100422"
			MCNT.EFTD.OurCorrespBIC = "CBKEKENXXXX"
		endif
#fetch
		sv_a = urhk_SetUrhkInp("pordCrit.orderType|" + MCNT.EFTD.OrderType)
		sv_u = urhk_ExecSrv("SRV_FetchDfltPymtOrderMaintDtlsForAdd|retain_all_output = Y")
		if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
		       print(BANCS.OUTPARAM.successOrFailure)
			if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
				EQSRV.GLBDATA.srvAcctId = "" 
				callscriptifexist("ebsrvHandler.scr")
				if(fieldexists(EQSRV.GLBDATA.ErrorMsg)==1)then
					print(EQSRV.GLBDATA.ErrorMsg)
					MCNT.EFTD.srvErrCode = "SRV_FetchDfltPymtOrderMaintDtlsForAdd"
					MCNT.EFTD.srvErrMsg = EQSRV.GLBDATA.ErrorMsg
					MCNT.EFTD.srvSucFail = "F"
					goto VAYU
				endif
			endif
			if((BANCS.OUTPARAM.successOrFailure=="S") and (sv_u==0))then
				print("fetch success")
			endif
		endif
		sv_z = urhk_CopyOutToIn("")
		print(sv_z)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.orderType|" + MCNT.EFTD.OrderType)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.solId.solId|" + BANCS.STDIN.homeSolId)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.origEntityType|" + MCNT.EFTD.OrigEntityType)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.origPaysysId.refCode|"+ MCNT.EFTD.POType)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.totalAmt|" + MCNT.EFTD.remitAmt + "|" + MCNT.EFTD.remitCrncy)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.totalAmtCrncy|" + MCNT.EFTD.remitCrncy)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.drValueDate|" + MCNT.EFTD.DrValueDate)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.drExecutionDate|" + MCNT.EFTD.DrExecutionDate)
		if (MCNT.EFTD.OrderType == "CT") then
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.ordPartyAcct|" + MCNT.EFTD.drAcctId)
			###sv_a = urhk_SetUrhkInp("pordHeaderDtls.cifId|" + MCNT.EFTD.cifId)
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.ordPartyNameAdd.name|" + MCNT.EFTD.ordPartyName)
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.ordPartyNameAdd.address1|" + MCNT.EFTD.ordPartyAdd1)
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.ordPartyNameAdd.address2|" + MCNT.EFTD.ordPartyAdd2)
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.ordPartyNameAdd.address3|" + MCNT.EFTD.ordPartyAdd3)
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.ordPartyCntryCode.refCode|" + MCNT.EFTD.ordCntryCode)
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.ordPartyAddrTypeInd|A")
		endif
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.drAcct.foracid|" + MCNT.EFTD.drAcctId)
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.crAcct.foracid|" + MCNT.EFTD.crAcctId)
		##sv_a = urhk_SetUrhkInp("pordHeaderDtls.exchRateCode.refCode|")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.exchRate|1.0000")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.exchRateCode.refRecType|67")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.reqExecDate|" + BANCS.STDIN.BODDate )
		##sv_a = urhk_SetUrhkInp("pordHeaderDtls.remarks|" )
		##sv_a = urhk_SetUrhkInp("pordHeaderDtls.freeText|" )
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.netChargeFlg|N")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.repairChargesFlg|N")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.todGrantedFlg|N")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.chrgAcct.foracid|" + MCNT.EFTD.drAcctId ) 
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.lienMarkedFlg|N")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.overRideDrExecDateFlg|N")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.overRideDrValueDateFlg|N")
		sv_a = urhk_SetUrhkInp("pordHeaderDtls.slaCategory|CRED")
#pordPaymentDtls
		sv_a = urhk_SetUrhkInp("pordPaymentDtls.remitAmt|" + MCNT.EFTD.remitAmt +"|" + MCNT.EFTD.remitCrncy)
		sv_a = urhk_SetUrhkInp("pordPaymentDtls.remitCrncy|" + MCNT.EFTD.remitCrncy)
		#senderDtls
		#recvrDtls
		#interInstnDtls
		if((MCNT.EFTD.POType=="RTGS") or (MCNT.EFTD.POType=="SWIFT"))then
				sv_d = "isCutYN|select custom.fn_pord_date(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR) from dual "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + MCNT.EFTD.remitCrncy + "|" + MCNT.EFTD.OurCorrespBIC + "|" + MCNT.EFTD.OurCorrespBankCode + "|" + MCNT.EFTD.OurCorrespBrCode
				print(sv_d)
				print(BANCS.INPARAM.BINDVARS)
				sv_u = urhk_dbSelectWithBind(sv_d)
				if(sv_u==0)then
					MCNT.EFTD.isCutYN = BANCS.OUTPARAM.isCutYN
				else
					MCNT.EFTD.isCutYN = ""
				endif
				print(MCNT.EFTD.isCutYN)
				if(MCNT.EFTD.isCutYN=="Y")then
					sv_e = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.BODDate
					print(sv_e)
					sv_a = urhk_GetNextWorkingDate(sv_e)
					if(sv_a==0)then
						print(BANCS.OUTPARAM.NextWorkingDate)
						MCNT.EFTD.ccustValueDate = BANCS.OUTPARAM.NextWorkingDate
						print(BANCS.OUTPARAM.PrevWorkingDate)
						print(BANCS.OUTPARAM.NextDataCentreWorkingDate)
						print(BANCS.OUTPARAM.PrevDataCentreWorkingDate)
						print(BANCS.OUTPARAM.PrevDataCentreWorkingDate)
						BANCS.INPARAM.date1 = BANCS.STDIN.sysDate
						BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
						sv_a = urhk_B2k_dateDiff("")
						if(sv_a==0)then
							print(BANCS.OUTPARAM.dateDiff)
							MCNT.EFTD.diffdate = BANCS.OUTPARAM.dateDiff
						else
							MCNT.EFTD.diffdate = ""
						endif
						if(cdouble(MCNT.EFTD.diffdate)==0)then
							MCNT.EFTD.custValueDate = MCNT.EFTD.ccustValueDate
						endif
						if(cdouble(MCNT.EFTD.diffdate)<=-1)then
							MCNT.EFTD.custValueDate = BANCS.STDIN.BODDate
						endif
						if(cdouble(MCNT.EFTD.diffdate)>=1)then
							MCNT.EFTD.custValueDate = MCNT.EFTD.ccustValueDate
						endif
					else
						MCNT.EFTD.custValueDate = ""
					endif
				else
					MCNT.EFTD.custValueDate = ""
				endif
		else
			MCNT.EFTD.custValueDate = ""
		endif
		sv_a = urhk_SetUrhkInp("pordPaymentDtls.msgDespatchDate|" + BANCS.STDIN.BODDate)
		print(MCNT.EFTD.custValueDate)
		if(MCNT.EFTD.custValueDate!="")then
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.overRideCrExecDateFlg|N")
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.overRideCrValueDateFlg|Y")
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.crValueDate|" + MCNT.EFTD.custValueDate )
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.reqExecDate|" + BANCS.STDIN.BODDate ) 
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.crExecutionDate|" + BANCS.STDIN.BODDate ) 
		else
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.overRideCrExecDateFlg|N")
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.overRideCrValueDateFlg|N")
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.crValueDate|" + BANCS.STDIN.BODDate ) 
			sv_a = urhk_SetUrhkInp("pordHeaderDtls.reqExecDate|" + BANCS.STDIN.BODDate ) 
			sv_a = urhk_SetUrhkInp("pordPaymentDtls.crExecutionDate|" + BANCS.STDIN.BODDate ) 
		endif
		lv_m = "benbnkname | select bank_name from tbaadm.bkc where bank_id=?SVAR and bank_code=?SVAR and del_flg='N' "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.benefBankCode 
		print(BANCS.INPARAM.BINDVARS)
		lv_s = urhk_dbSelectWithBind(lv_m)
		if(lv_s==0)then
			MCNT.EFTD.benbnkname = BANCS.OUTPARAM.benbnkname
		else
			MCNT.EFTD.benbnkname = ""
		endif
