VAYU:
	print(MCNT.EFTD.srvErrCode)
	print(MCNT.EFTD.srvErrMsg) 
	print(MCNT.EFTD.srvSucFail)
	if(MCNT.EFTD.srvSucFail=="F")then
		lv_u = " update custom.cust_merchant_po_tbl set process_status='F',process_desc=?SVAR,lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and upl_batch_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and benef_acct_id=?SVAR and remit_amt=?NVAR and remit_crncy=?SVAR and benef_bic_code=?SVAR and process_status='U' and narration=?SVAR "
		BANCS.INPARAM.BINDVARS = MCNT.EFTD.srvErrMsg + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.uplbatchId + "|" + MCNT.EFTD.benefAcctId + "|" + MCNT.EFTD.remitAmt + "|" + MCNT.EFTD.remitCrncy + "|" + MCNT.EFTD.benefBicCode + "|" + MCNT.EFTD.narration 
		print(lv_u)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlwithBind(lv_u)
		print(sv_u)
		sv_u = urhk_dbSqlwithBind("commit")
		print(sv_u)
	endif
	if(MCNT.EFTD.srvSucFail=="S")then
		lv_u = " update custom.cust_merchant_po_tbl set process_status='P',process_tran_id=?SVAR,process_desc=?SVAR,lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and upl_batch_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and benef_acct_id=?SVAR and remit_amt=?NVAR and remit_crncy=?SVAR and benef_bic_code=?SVAR and process_status='U' and narration=?SVAR "
		BANCS.INPARAM.BINDVARS = MCNT.EFTD.srvErrCode + "|" + MCNT.EFTD.srvErrMsg + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + MCNT.EFTD.uplbatchId + "|" + MCNT.EFTD.benefAcctId + "|" + MCNT.EFTD.remitAmt + "|" + MCNT.EFTD.remitCrncy + "|" + MCNT.EFTD.benefBicCode + "|" + MCNT.EFTD.narration 
		print(lv_u)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlwithBind(lv_u)
		print(sv_u)
		sv_u = urhk_dbSqlwithBind("commit")
		print(sv_u)
	endif
	exitscript
trace off
