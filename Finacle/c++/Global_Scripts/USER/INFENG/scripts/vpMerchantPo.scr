                                        MCNT.EFTD.srvErrCode = "SRV_AddPymtOrderMaintDtlsAndVerify"
                                        MCNT.EFTD.srvErrMsg = EQSRV.GLBDATA.ErrorMsg
                                        MCNT.EFTD.srvSucFail = "F"
                                        goto VAYU
				endif
			endif
			if((BANCS.OUTPARAM.successOrFailure=="S") and (sv_u==0))then
				print("po success")
				MCNT.EFTD.pymtRefNum = BANCS.OUTPARAM.pymtRefNum
				print(MCNT.EFTD.pymtRefNum)
				MCNT.EFTD.srvErrCode = MCNT.EFTD.pymtRefNum 
				MCNT.EFTD.srvErrMsg = "Payorder Processed Successfully" 
				MCNT.EFTD.srvSucFail = "S"
				goto VAYU
			endif
		endif
                sv_u = urhk_dbCursorFetch(MCNT.EFTD.porcurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(MCNT.EFTD.porcurNum)
