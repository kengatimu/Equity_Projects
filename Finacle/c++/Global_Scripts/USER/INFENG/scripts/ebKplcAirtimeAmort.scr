#------------------------------------------------------------------------------------------------
#  Name            : ebKplcAirtimeAmort.scr 
#  Description     : Tran
#  Date            : 05-03-2020
#  Author          : Vino Palani
#  Menu Option     : NA KADIS(daily job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             05-03-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
	sv_p = urhk_B2k_PrintRepos("BANCS")
	print(sv_p)
	EBSRV.GLBDATA.crAcct = ""
	#BANCS.STDIN.BODDate="31-12-2019"
#fetch
	sv_l = "srcAcct,drAcct,crBAcid,tranDate,tranCrncy,totTranAmt,totTranDrAmt | "
	sv_l = sv_l + " select gam.foracid as srcAcct, "
	sv_l = sv_l + " (case when gam.foracid='0001400304130' then '0001300105051' "
	sv_l = sv_l + " when gam.foracid in ('0001400302970','0001400301132','0001400301131') then '0003000105989' "
	sv_l = sv_l + " else 'NA' end) as drAcct, "
	sv_l = sv_l + " (case when gam.foracid='0001400304130' then (select nvl(foracid,'0006500504129') "
	sv_l = sv_l + " from tbaadm.gam where bank_id=?SVAR  "
	sv_l = sv_l + " and entity_cre_flg='Y' and del_flg='N' and sol_id=?SVAR and schm_code='INCOM' and acct_ownership<>'C' "
	sv_l = sv_l + " and acct_name='KPLC PREPAID COMMISSION GL' and rownum<=1 ) " 
	sv_l = sv_l + " when gam.foracid in ('0001400302970','0001400301132','0001400301131') then 'SMSCOM' "
	sv_l = sv_l + " else 'NA' end) as crBAcid, "
	sv_l = sv_l + " dtd.tran_date,dtd.tran_crncy_code,sum(dtd.tran_amt),"
	sv_l = sv_l + " sum((case when gam.foracid='0001400304130' then (dtd.tran_amt*3)/100 "
	sv_l = sv_l + " when gam.foracid='0001400302970' then (dtd.tran_amt*7)/100 " 
	sv_l = sv_l + " when gam.foracid='0001400301132' then (dtd.tran_amt*5.66)/100 " 
	sv_l = sv_l + " when gam.foracid='0001400301131' then (dtd.tran_amt*8)/100 " 
	sv_l = sv_l + " else 0 end)) as drAmt "
	sv_l = sv_l + " from tbaadm.dtd,tbaadm.gam where dtd.bank_id=?SVAR and gam.bank_id=?SVAR "
	sv_l = sv_l + " and dtd.bank_id=gam.bank_id " 
	sv_l = sv_l + " and dtd.acid=gam.acid "
	sv_l = sv_l + " and dtd.DTH_INIT_SOL_ID=?SVAR "
	sv_l = sv_l + " and dtd.PART_TRAN_TYPE='C' "
	sv_l = sv_l + " and dtd.pstd_flg='Y' " 
	sv_l = sv_l + " and dtd.del_flg='N' "
	sv_l = sv_l + " and tran_date=to_date(?SVAR,'DD-MM-RR') "
	sv_l = sv_l + " and gam.del_flg<>'Y' "
	sv_l = sv_l + " and gam.foracid in ('0001400302970','0001400301132','0001400301131') "
	sv_l = sv_l + " group by gam.foracid,dtd.tran_date,dtd.tran_crncy_code "
	print(sv_l)
	#BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + mid$(BANCS.STDIN.BODDate,0,10) 
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + mid$(BANCS.STDIN.BODDate,0,10)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbCursorOpenWithBind(sv_l)
	print(sv_c)
	if(sv_c != 0)then
	print("fetching failed")
	goto VAYU
	endif
	sv_p = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_p)
	sv_r = urhk_dbCursorFetch(sv_p)
	print(sv_r)
	if(sv_r != 0)then
	    goto VAYU
	endif
	EBSRV.GLBDATA.record_count = 0
	while(sv_r == 0)
		EBSRV.GLBDATA.srcAcct	=	BANCS.OUTPARAM.srcAcct
		EBSRV.GLBDATA.drAcct	=	BANCS.OUTPARAM.drAcct		
		EBSRV.GLBDATA.crBAcid	=	BANCS.OUTPARAM.crBAcid	
		EBSRV.GLBDATA.tranDate	=	BANCS.OUTPARAM.tranDate	
		EBSRV.GLBDATA.tranCrncy		=	BANCS.OUTPARAM.tranCrncy	
		EBSRV.GLBDATA.totTranAmt	=	BANCS.OUTPARAM.totTranAmt	
		EBSRV.GLBDATA.totTranDrAmt	=	BANCS.OUTPARAM.totTranDrAmt	
		if(EBSRV.GLBDATA.crBAcid=="SMSCOM")then
		sv_i = EBSRV.GLBDATA.crBAcid +"|"+ BANCS.STDIN.homeCrncyCode +"|"+ BANCS.STDIN.mySolId 
		print(sv_i)
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		if(sv_u == 0 )then
			EBSRV.GLBDATA.crAcct=BANCS.OUTPARAM.AcctId
			print(EBSRV.GLBDATA.crAcct)
		else
			goto NXTL
		endif
		else
		EBSRV.GLBDATA.crAcct = EBSRV.GLBDATA.crBAcid
		endif
		if((cdouble(EBSRV.GLBDATA.totTranDrAmt)>0) and (EBSRV.GLBDATA.crAcct!="") and (EBSRV.GLBDATA.drAcct!=""))then
			callscriptifexist("ebKplcAirtimeAmortT.scr")
		else
			goto NXTL
		endif
	NXTL:
        sv_r = urhk_dbCursorFetch(sv_p)
        do
        sv_r = urhk_dbCursorClose(sv_p)	
VAYU:
	exitscript
trace off
end-->
