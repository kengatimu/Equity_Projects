<--start
trace on

	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF(CLASSEXISTS("CUST","ACCOPEN") == 0) THEN
	#{	
		CREATECLASS("CUST","ACCOPEN",5)
	#}
	ENDIF

	if(BANCS.STDIN.contextBankId=="54")then
		if(BANCS.STDIN.moduleIdentity!="FI")then
			callscriptifexist("ebAcmModOpChk.scr")
		endif
	endif
	

	#--------------------JAMES.M DFP CHANGES STARTS----------------------------#
	IF((BANCS.STDIN.contextBankId=="56") and (BANCS.STDIN.moduleIdentity !="FI"))THEN
	#{
		sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeCode2.refCode")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ACCOPEN.freeCode2= TOUPPER(BANCS.OUTPARAM.srvValue)
			print(CUST.ACCOPEN.freeCode2)
		#}
		ENDIF
		sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeCode5.refCode")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ACCOPEN.freeCode5= TOUPPER(BANCS.OUTPARAM.srvValue)
			print(CUST.ACCOPEN.freeCode5)
		#}
		ENDIF
		sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeText9")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ACCOPEN.freeText9= TOUPPER(BANCS.OUTPARAM.srvValue)
			print(CUST.ACCOPEN.freeText9)
		#}
		ENDIF
		sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeText12")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ACCOPEN.freeText12= TOUPPER(BANCS.OUTPARAM.srvValue)
			print(CUST.ACCOPEN.freeText12)
		#}
		ENDIF
		sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeText13")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ACCOPEN.freeText13= TOUPPER(BANCS.OUTPARAM.srvValue)
			print(CUST.ACCOPEN.freeText13)
		#}
		ENDIF

		IF(CUST.ACCOPEN.freeCode2== "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeCode2.refCode|DPF Category is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			IF(CUST.ACCOPEN.freeCode2== "ALT") THEN
			#{
				IF(CUST.ACCOPEN.freeCode5== "") THEN
				#{
					sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeCode5.refCode|Other Bank Name is mandatory")
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				IF(CUST.ACCOPEN.freeText12 == "") THEN
				#{
					sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText12 |Acct No/Mobile money number is Mandatory")
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				IF(CUST.ACCOPEN.freeText13 == "") THEN
				#{
					sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText13 |Acct Name/Registered Name/Draft Name is Mandatory")
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ELSE
			#{
				IF(CUST.ACCOPEN.freeCode2== "DPF") THEN
				#{
					IF(CUST.ACCOPEN.freeText12 == "") THEN
					#{
						sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText12 |Acct No/Mobile money number is Mandatory")
						BANCS.OUTPUT.successOrFailure="F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					IF(CUST.ACCOPEN.freeText13 == "") THEN
					#{
						sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText13 |Acct Name/Registered Name/Draft Name is Mandatory")
						BANCS.OUTPUT.successOrFailure="F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					IF(CUST.ACCOPEN.freeText9 == "") THEN
					#{
						sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText9 |Telco Name is mandatory")
						BANCS.OUTPUT.successOrFailure="F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ELSE
				#{
					IF(CUST.ACCOPEN.freeCode2== "DRF") THEN
					#{
						IF(CUST.ACCOPEN.freeText13 == "") THEN
						#{
							sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText13 |Acct Name/Registered Name/Draft Name is Mandatory")
							BANCS.OUTPUT.successOrFailure="F"
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF

trace off
end-->
