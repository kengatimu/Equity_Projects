	IF (CUST.CHQB.func != "U") THEN
	#{
		#---------------------------------------------------------------------------
		# Fetching Record
		#---------------------------------------------------------------------------
		sv_s = "chqBook,chqLeaves,reqStatus,foracid,beginNum"
		#sv_s = "chqBook,chqLeaves,reqStatus,foracid,beginNum,instType "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT num_of_chb,num_of_chq_lvs,nvl(req_status,' '),foracid,begin_chq_num"
		#sv_s = sv_s + " SELECT num_of_chb,num_of_chq_lvs,nvl(req_status,' '),foracid,begin_chq_num,nvl(Inst_Type, ' ') "
		sv_s = sv_s + " FROM CUSTOM.CUSTOM_CBR "
		sv_s = sv_s + " WHERE req_id = ?SVAR "
