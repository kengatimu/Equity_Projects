			CUST.CHQB.foracid = BANCS.OUTPARAM.foracid
			print(CUST.CHQB.foracid)
			
			CUST.CHQB.beginNum = BANCS.OUTPARAM.beginNum
			print(CUST.CHQB.beginNum)
			
			sv_u = urhk_SetOrbOut("noOfChqs|"+CUST.CHQB.chqBook)
			print(sv_u)
			
			sv_u = urhk_SetOrbOut("leaves|"+CUST.CHQB.chqLeaves)
			print(sv_u)
			
			sv_u = urhk_SetOrbOut("reqStat|"+CUST.CHQB.reqStatus)
			print(sv_u)
			
			sv_u = urhk_SetOrbOut("acctNo|"+CUST.CHQB.foracid)
			print(sv_u)
			
			sv_u = urhk_SetOrbOut("startChqNo|"+CUST.CHQB.beginNum)
			print(sv_u)
			
		#}
		ENDIF
		IF (TRIM(CUST.CHQB.beginNum) != "" ) THEN
		#{
			CUST.CHQB.chqEndNo = CINT(CUST.CHQB.beginNum) + CINT(CUST.CHQB.chqBook) * CINT(CUST.CHQB.chqLeaves) - 1
			print(CUST.CHQB.chqEndNo)
			sv_u = urhk_SetOrbOut("endChqNo|"+CUST.CHQB.chqEndNo)
			print(sv_u)
		#}
		ENDIF
	#}
	ENDIF
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	
	ENDOFSCRIPT:
		TRACE OFF
		EXITSCRIPT
END-->
