	OUTSIDELOOP2:
		
		sv_f = 1
		#Blacklist check
		IF(sv_x > 1) THEN
		#{
			#Blacklisted Vessel is found
			BANCS.OUTPARAM.error_code =  "12"
			sv_f = FORMAT$(sv_x,"%d")
			BANCS.OUTPUT.count=  sv_f
