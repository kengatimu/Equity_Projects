<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
EQSRV.GLBDATA.errMsg = ""
	sv_d = "acctNum | select gam.foracid "
	sv_d = sv_d +  "from tbaadm.gam,tbaadm.ta_cot " 
	sv_d = sv_d +  "where gam.bank_id=?SVAR "
	sv_d = sv_d +  "and gam.acid = ta_cot.acid "
	sv_d = sv_d +  "and ta_cot.entity_cre_flg='Y' "
	sv_d = sv_d +  "and ta_cot.del_flg='N' "
	sv_d = sv_d +  "and ta_cot.chrge_off_date is null "
	sv_d = sv_d +  "and ta_cot.bank_id=?SVAR "
	sv_d = sv_d +  "and gam.sol_id in (select sol_id from tbaadm.sst where set_id='ALL' and bank_id=?SVAR )"
	sv_d = sv_d +  "and gam.entity_cre_flg='Y' and gam.del_flg='N'  and gam.clr_bal_amt <=1 "
	sv_d = sv_d +  "and gam.schm_type in ('CAA','CCA','SBA')  "
	sv_d = sv_d +  "and gam.acct_cls_flg <> 'Y' "
	sv_d = sv_d +  "and gam.acct_cls_date is null "
	#09/08/2019
#        sv_d = sv_d + "and exists ( select 1 from custom.eb_coff_recov where module_id='COFF' "
#        sv_d = sv_d + "and foracid =gam.foracid and bank_id='"+BANCS.STDIN.contextBankId+"' "
#       sv_d = sv_d + "and record_status='I' and del_flg<>'Y' and srv_msg is null) "
	#++++++++++++++
	sv_d = sv_d + "and exists ( select 1 from custom.int_change where CUST_PREF='COFF' "
        sv_d = sv_d + "and foracid =gam.foracid and bank_id='"+BANCS.STDIN.contextBankId+"' "
        sv_d = sv_d + "and ENTITY_CRE_FLG ='I') "
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+BANCS.STDIN.contextBankId+"|"+BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbCursorOpenWithBind(sv_d)

	if(sv_u==0)then
		EQSRV.GLBDATA.cotadCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.cotadCurNum)
		print(sv_z)

		while(sv_z == 0)
		##{
		print(BANCS.OUTPARAM.acctNum)

	#############################################################################
		BANCS.INPUT.solId = BANCS.STDIN.mySolId 
		EQSRV.GLBDATA.acctNum = BANCS.OUTPARAM.acctNum
		print(EQSRV.GLBDATA.acctNum)
		EQSRV.GLBDATA.funcCode = "C"
		EQSRV.GLBDATA.chargeOffType = "F"
		EQSRV.GLBDATA.modeOfOper = "C"
		EQSRV.GLBDATA.srvErrCode = ""
		EQSRV.GLBDATA.srvErrMsg = "" 
		EQSRV.GLBDATA.srvSucFail = ""
		EQSRV.GLBDATA.COReasonCode = "WQ"
		EQSRV.GLBDATA.CORefType = "CY"

	sv_d = "solId,chargeOffAcct,cifId | "
	sv_d = sv_d + " select sol_id,foracid,cif_id from tbaadm.gam "
	sv_d = sv_d + " where bank_id=?SVAR "
	sv_d = sv_d + " and foracid=?SVAR "
	sv_d = sv_d + " and entity_cre_flg='Y' and del_flg='N'  and clr_bal_amt <=1 "
	sv_d = sv_d + " and schm_type in ('CAA','CCA','SBA') "
	sv_d = sv_d + " and acct_cls_flg <> 'Y' and acct_cls_date is null "
	sv_d = sv_d + " and exists (select 1 from tbaadm.ta_cot where ta_cot.acid=gam.acid and ta_cot.entity_cre_flg='Y' and ta_cot.del_flg='N' "
	sv_d = sv_d + " and ta_cot.chrge_off_date is null and bank_id=?SVAR) "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.acctNum + "|" + BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.solId = BANCS.OUTPARAM.solId
		EQSRV.GLBDATA.foracid = BANCS.OUTPARAM.chargeOffAcct
		EQSRV.GLBDATA.cifId = BANCS.OUTPARAM.cifId
		#ContextSol
		#++++++++++
			print(BANCS.STDIN.mySolId)
			print(EQSRV.GLBDATA.solId)

			IF(BANCS.STDIN.mySolId != EQSRV.GLBDATA.solId)THEN
			#{
				sv_u = urhk_SetUrhkInp("sol.solId|"+EQSRV.GLBDATA.solId)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
				if ( sv_u != 0 ) then
					EQSRV.GLBDATA.srvErrMsg	= "CCS Failed"
					EQSRV.GLBDATA.srvErrCode = "Failed : SRV_ModifyContextSol " 
					EQSRV.GLBDATA.srvSucFail = "F"
					goto NXTLP
				endif
			#}
			ENDIF

		#FiledMapInp
		#++++++++++
		EQSRV.GLBDATA.recmsg    = "cota for : " + EQSRV.GLBDATA.foracid 
		print(EQSRV.GLBDATA.recmsg)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.funcCode|" + EQSRV.GLBDATA.funcCode)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.Acct.foracid|" + EQSRV.GLBDATA.foracid)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.Acct.solId|" + EQSRV.GLBDATA.solId)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.reason.refCode|" + EQSRV.GLBDATA.COReasonCode )
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.reason.refRecType|" + EQSRV.GLBDATA.CORefType )
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.chargeOffType|" + EQSRV.GLBDATA.chargeOffType)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.modeOfOper|" + EQSRV.GLBDATA.modeOfOper)

		#FieldMapOut
		#++++++++++
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.liability| liability ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.daysPastDue| daysPastDue ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.prinOutStanding| prinOutStanding ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.intOutStanding| intOutStanding ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.assetClassfnMain| assetClassfnMain ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.assetClassfnSub| assetClassfnSub ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.bookedInt| bookedInt ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.TA_COTCookie| TA_COTCookie ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.gacCookie| gacCookie ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.eitCookie| eitCookie ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.collateralValue| collateralValue ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.lastEvaluationDate| lastEvaluationDate ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.provisionAmt| provisionAmt ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.multChrgOffFlg| multChrgOffFlg ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.alrdyChrgdOffAmt| alrdyChrgdOffAmt ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.totalChrgOffAmt| totalChrgOffAmt ")
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.chargeOfftype| chargeOfftype ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.usrChrgOffAmt| usrChrgOffAmt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.chrgOffNonPdFlg| chrgOffNonPdFlg ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.partIntAppldAmt| partIntAppldAmt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.partBookedInt| partBookedInt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.treatPrinIntSep| treatPrinIntSep ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.intSuspAmt| intSuspAmt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.penalIntSuspAmt| penalIntSuspAmt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.penalIntOutStanding| penalIntOutStanding ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.penalBookedInt| penalBookedInt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.partPenalIntAppldAmt| partPenalIntAppldAmt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.partPenalBookedInt| partPenalBookedInt ") 
			sv_u = urhk_SetUrhkOut("taChrgOffAcctDtl.isReversalAllowed| isReversalAllowed ") 
		#fetchSrv
		#++++++++++
			sv_u = urhk_ExecSrv("SRV_FetchAcctDtlForTaChrgOff|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
			print(sv_u)
			if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
				print(BANCS.OUTPARAM.successOrFailure)
				sv_s = BANCS.OUTPARAM.successOrFailure
			else
				sv_s = "X"
			endif
			if (( sv_u == 0 ) and ( sv_s=="S") ) then
				EQSRV.GLBDATA.liability	= BANCS.OUTPARAM.liability
					print(EQSRV.GLBDATA.liability)
				EQSRV.GLBDATA.daysPastDue	= BANCS.OUTPARAM.daysPastDue
				EQSRV.GLBDATA.prinOutStanding	= BANCS.OUTPARAM.prinOutStanding
					print(EQSRV.GLBDATA.prinOutStanding)
				EQSRV.GLBDATA.intOutStanding	= BANCS.OUTPARAM.intOutStanding
					print(EQSRV.GLBDATA.intOutStanding)
				EQSRV.GLBDATA.assetClassfnMain	= BANCS.OUTPARAM.assetClassfnMain
				EQSRV.GLBDATA.assetClassfnSub	= BANCS.OUTPARAM.assetClassfnSub
				EQSRV.GLBDATA.bookedInt	= BANCS.OUTPARAM.bookedInt
					print(EQSRV.GLBDATA.bookedInt)
				EQSRV.GLBDATA.TA_COTCookie	= BANCS.OUTPARAM.TA_COTCookie
				EQSRV.GLBDATA.gacCookie	= BANCS.OUTPARAM.gacCookie
				EQSRV.GLBDATA.eitCookie	= BANCS.OUTPARAM.eitCookie
				EQSRV.GLBDATA.collateralValue	= BANCS.OUTPARAM.collateralValue
				EQSRV.GLBDATA.lastEvaluationDate	= BANCS.OUTPARAM.lastEvaluationDate
				EQSRV.GLBDATA.provisionAmt	= BANCS.OUTPARAM.provisionAmt
				EQSRV.GLBDATA.multChrgOffFlg	= BANCS.OUTPARAM.multChrgOffFlg
				EQSRV.GLBDATA.alrdyChrgdOffAmt	= BANCS.OUTPARAM.alrdyChrgdOffAmt
				EQSRV.GLBDATA.totalChrgOffAmt	= BANCS.OUTPARAM.totalChrgOffAmt
					print(EQSRV.GLBDATA.totalChrgOffAmt)	
				EQSRV.GLBDATA.chargeOfftype	= BANCS.OUTPARAM.chargeOfftype
				EQSRV.GLBDATA.usrChrgOffAmt	= BANCS.OUTPARAM.usrChrgOffAmt
					print(EQSRV.GLBDATA.usrChrgOffAmt)
				EQSRV.GLBDATA.chrgOffNonPdFlg	= BANCS.OUTPARAM.chrgOffNonPdFlg
				EQSRV.GLBDATA.partIntAppldAmt	= BANCS.OUTPARAM.partIntAppldAmt
				EQSRV.GLBDATA.partBookedInt	= BANCS.OUTPARAM.partBookedInt
					print(EQSRV.GLBDATA.partBookedInt)
				EQSRV.GLBDATA.treatPrinIntSep	= BANCS.OUTPARAM.treatPrinIntSep
				EQSRV.GLBDATA.intSuspAmt	= BANCS.OUTPARAM.intSuspAmt
				EQSRV.GLBDATA.penalIntSuspAmt	= BANCS.OUTPARAM.penalIntSuspAmt
				EQSRV.GLBDATA.penalIntOutStanding	= BANCS.OUTPARAM.penalIntOutStanding
				EQSRV.GLBDATA.penalBookedInt	= BANCS.OUTPARAM.penalBookedInt
				EQSRV.GLBDATA.partPenalIntAppldAmt	= BANCS.OUTPARAM.partPenalIntAppldAmt
				EQSRV.GLBDATA.partPenalBookedInt	= BANCS.OUTPARAM.partPenalBookedInt
				EQSRV.GLBDATA.isReversalAllowed	= BANCS.OUTPARAM.isReversalAllowed
			else
                                print(EQSRV.GLBDATA.foracid)
                                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.foracid
                                callscriptifexist("ebsrvHandler.scr")
				EQSRV.GLBDATA.srvErrMsg	=  EQSRV.GLBDATA.SrvError 
				EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctDtlForTaChrgOff " 
				EQSRV.GLBDATA.srvSucFail = "F"
				goto NXTLP
			endif
		#FiledMapInp
		#++++++++++
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.funcCode|" + EQSRV.GLBDATA.funcCode)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.Acct.foracid|" + EQSRV.GLBDATA.foracid)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.Acct.solId|" + EQSRV.GLBDATA.solId)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.chargeOffType|" + EQSRV.GLBDATA.chargeOffType)
			sv_u = urhk_SetUrhkInp("taChrgOffCrit.modeOfOper|" + EQSRV.GLBDATA.modeOfOper)

			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.liability|" + EQSRV.GLBDATA.liability) 
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.daysPastDue|" + EQSRV.GLBDATA.daysPastDue) 
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.prinOutStanding|" + EQSRV.GLBDATA.prinOutStanding)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.intOutStanding|" + EQSRV.GLBDATA.intOutStanding)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.assetClassfnMain|" + EQSRV.GLBDATA.assetClassfnMain)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.assetClassfnSub|" + EQSRV.GLBDATA.assetClassfnSub)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.bookedInt|" + EQSRV.GLBDATA.bookedInt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.TA_COTCookie|" + EQSRV.GLBDATA.TA_COTCookie)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.gacCookie|" + EQSRV.GLBDATA.gacCookie)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.eitCookie|" + EQSRV.GLBDATA.eitCookie)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.collateralValue|" + EQSRV.GLBDATA.collateralValue)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.provisionAmt|" + EQSRV.GLBDATA.provisionAmt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.multChrgOffFlg|N")
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.alrdyChrgdOffAmt|" + EQSRV.GLBDATA.alrdyChrgdOffAmt )
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.totalChrgOffAmt|" + EQSRV.GLBDATA.totalChrgOffAmt )
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.reason.refCode|" + EQSRV.GLBDATA.COReasonCode )
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.reason.refRecType|" + EQSRV.GLBDATA.CORefType )
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.chargeOfftype|F")
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.usrChrgOffAmt|" + EQSRV.GLBDATA.usrChrgOffAmt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.chrgOffNonPdFlg|" + EQSRV.GLBDATA.chrgOffNonPdFlg)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.partIntAppldAmt|" + EQSRV.GLBDATA.partIntAppldAmt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.partBookedInt|" + EQSRV.GLBDATA.partBookedInt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.treatPrinIntSep|" + EQSRV.GLBDATA.treatPrinIntSep)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.intSuspAmt|" + EQSRV.GLBDATA.intSuspAmt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.penalIntSuspAmt|" + EQSRV.GLBDATA.penalIntSuspAmt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.penalIntOutStanding|" + EQSRV.GLBDATA.penalIntOutStanding)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.penalBookedInt|" + EQSRV.GLBDATA.penalBookedInt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.partPenalIntAppldAmt|" + EQSRV.GLBDATA.partPenalIntAppldAmt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.partPenalBookedInt|" + EQSRV.GLBDATA.partPenalBookedInt)
			sv_u = urhk_SetUrhkInp("taChrgOffAcctDtl.isReversalAllowed|" + EQSRV.GLBDATA.isReversalAllowed )
			
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_0>.key.serial_num|srlNumO")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_0>.tranAcct.foracid|foracidO")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_0>.tranAcct.acctName|acctNameO")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_0>.tranPartcls|tranPartclsO")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_0>.tranAmt|tranAmtO")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_0>.drCrInd|drCrIndO")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_1>.key.serial_num|srlNumT")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_1>.tranAcct.foracid|foracidT")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_1>.tranAcct.acctName|acctNameT")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_1>.tranPartcls|tranPartclsT")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_1>.tranAmt|tranAmtT")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_1>.drCrInd|drCrIndT")
		if((cdouble(EQSRV.GLBDATA.intOutStanding)>0) or ( cdouble(EQSRV.GLBDATA.bookedInt)>0) or (cdouble(EQSRV.GLBDATA.partIntAppldAmt)>0) or (cdouble(EQSRV.GLBDATA.partBookedInt)>0) or (cdouble(EQSRV.GLBDATA.intSuspAmt)>0) or (cdouble(EQSRV.GLBDATA.penalIntSuspAmt)>0) or(cdouble(EQSRV.GLBDATA.penalIntOutStanding)>0))then
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_2>.key.serial_num|srlNumR")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_2>.tranAcct.foracid|foracidR")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_2>.tranAcct.acctName|acctNameR")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_2>.tranPartcls|tranPartclsR")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_2>.tranAmt|tranAmtR")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_2>.drCrInd|drCrIndR")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_3>.key.serial_num|srlNumF")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_3>.tranAcct.foracid|foracidF")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_3>.tranAcct.acctName|acctNameF")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_3>.tranPartcls|tranPartclsF")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_3>.tranAmt|tranAmtF")
			sv_u = urhk_SetUrhkOut("taChrgOffTranLL.<rec_3>.drCrInd|drCrIndF")
		endif
		#fetchSrv
		#++++++++++
			sv_u = urhk_ExecSrv("SRV_FetchTaChrgOffPartTranList|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
			print(sv_u)
			if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
				print(BANCS.OUTPARAM.successOrFailure)
				sv_s = BANCS.OUTPARAM.successOrFailure
			else
				sv_s = "X"
			endif
			if (( sv_u == 0 ) and ( sv_s=="S") ) then
				print("fetch success")
				print(BANCS.OUTPARAM.srlNumO)
				EQSRV.GLBDATA.srlNumO = BANCS.OUTPARAM.srlNumO
				EQSRV.GLBDATA.foracidO = BANCS.OUTPARAM.foracidO
				EQSRV.GLBDATA.acctNameO = BANCS.OUTPARAM.acctNameO
				EQSRV.GLBDATA.tranPartclsO = BANCS.OUTPARAM.tranPartclsO
				EQSRV.GLBDATA.tranAmtO = BANCS.OUTPARAM.tranAmtO
				EQSRV.GLBDATA.drCrIndO = BANCS.OUTPARAM.drCrIndO
				EQSRV.GLBDATA.srlNumT = BANCS.OUTPARAM.srlNumT
				EQSRV.GLBDATA.foracidT = BANCS.OUTPARAM.foracidT
