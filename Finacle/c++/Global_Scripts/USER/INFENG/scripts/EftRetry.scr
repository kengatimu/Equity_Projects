#------------------------------------------------------------------------------------------------
#  Name            : EFTRETRY.scr
#  Description     :
#  Date            : 21-JUN-2024
#  Author          : IRUNGU JAMES
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             21-JUN-2024      IRUNGU JAMES          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("CUST","EFTDATA")==0)then
                createclass("CUST","EFTDATA",5)
        endif




sv_s =  " update CUSTOM.EFT_RETRY  set  FREE_TEXT4 = rownum where POSTED ='N' "
sv_r = urhk_dbSqlWithBind(sv_s)
PRINT(sv_r)
IF(sv_r == 0)THEN
        sv_d = urhk_dbSqlWithBind("COMMIT")
        PRINT(sv_d)
        print("Insert done")
ENDIF

	sv_q="BANK_ID,BENEFICARY_NAME,BENEF_ACCOUNT_NUM,EVENTID,DR_ACCT_NUM,TRANCODE,TRAN_AMT,REMIT_CRNCY,SOL_ID,RATECODE,RATE,BANKCODE,BRCODE,WAIVEFLG,CHRG_AMT,CHRG_CRNCY,REF_NUM,TRAN_PARTICULAR,TRAN_REMARKS,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,FREE_TEXT4,CHANNEL,RETRY_NUM|"
	sv_q = sv_q + " select BANK_ID,BENEFICARY_NAME,BENEF_ACCOUNT_NUM,EVENTID,DR_ACCT_NUM,TRANCODE,TRAN_AMT,REMIT_CRNCY,SOL_ID,RATECODE,RATE,BANKCODE,BRCODE, "
	sv_q = sv_q + " WAIVEFLG,CHRG_AMT,CHRG_CRNCY,REF_NUM,TRAN_PARTICULAR,TRAN_REMARKS,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,FREE_TEXT4,CHANNEL,RETRY_NUM "
	sv_q = sv_q + " from CUSTOM.EFT_RETRY  where bank_id =?SVAR and POSTED ='N' and RCRE_TIME > sysdate - 7 order by RCRE_TIME asc "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_e = urhk_dbCursorOpenWithBind(sv_q)
	IF(sv_e==0) THEN
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
				IF(sv_q == 1) THEN
					sv_x = urhk_dbCursorClose(sv_m)
					print(sv_x)
					GOTO ENDOFSCRIPT
				ENDIF
			print(sv_q)

		WHILE (sv_q==0)

			CUST.EFTDATA.BankId=BANCS.OUTPARAM.BANK_ID
			CUST.EFTDATA.destCustName=BANCS.OUTPARAM.BENEFICARY_NAME
			CUST.EFTDATA.destAcct=BANCS.OUTPARAM.BENEF_ACCOUNT_NUM
			CUST.EFTDATA.eventId=BANCS.OUTPARAM.EVENTID
			CUST.EFTDATA.foracid=BANCS.OUTPARAM.DR_ACCT_NUM
			CUST.EFTDATA.tranCode=BANCS.OUTPARAM.TRANCODE
			CUST.EFTDATA.amount=BANCS.OUTPARAM.TRAN_AMT
			CUST.EFTDATA.remitCrncy=BANCS.OUTPARAM.REMIT_CRNCY
			CUST.EFTDATA.solid=BANCS.OUTPARAM.SOL_ID
			CUST.EFTDATA.rateCode=BANCS.OUTPARAM.RATECODE
			CUST.EFTDATA.rate=BANCS.OUTPARAM.RATE
			CUST.EFTDATA.bankCode=BANCS.OUTPARAM.BANKCODE
			CUST.EFTDATA.brCode=BANCS.OUTPARAM.BRCODE
			CUST.EFTDATA.waiveflg=BANCS.OUTPARAM.WAIVEFLG
			CUST.EFTDATA.chargeamt=BANCS.OUTPARAM.CHRG_AMT
			CUST.EFTDATA.chargecrny=BANCS.OUTPARAM.CHRG_CRNCY
			CUST.EFTDATA.cRefNum=BANCS.OUTPARAM.REF_NUM
			CUST.EFTDATA.cTranParticulars=BANCS.OUTPARAM.TRAN_PARTICULAR
			CUST.EFTDATA.cTranRemarks=BANCS.OUTPARAM.TRAN_REMARKS
			CUST.EFTDATA.ChannelId=BANCS.OUTPARAM.CHANNEL
			CUST.EFTDATA.FREE_TEXT1=BANCS.OUTPARAM.FREE_TEXT1
			CUST.EFTDATA.FREE_TEXT2=BANCS.OUTPARAM.FREE_TEXT2
			CUST.EFTDATA.FREE_TEXT3=BANCS.OUTPARAM.FREE_TEXT3
			CUST.EFTDATA.FREE_TEXT4=BANCS.OUTPARAM.FREE_TEXT4
			CUST.EFTDATA.RETRY_NUM=BANCS.OUTPARAM.RETRY_NUM



			sv_h = urhk_getAcctDetailsInRepository(CUST.EFTDATA.foracid)
			print(sv_h)
			IF (sv_h==0) THEN
				CUST.EFTDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
				CUST.EFTDATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
				print (CUST.EFTDATA.EffAvailableAmt)
				print (CUST.EFTDATA.acctCrncyCode)
			ELSE
				GOTO NEXTREC
			ENDIF
					
			IF (CUST.EFTDATA.acctCrncyCode == CUST.EFTDATA.remitCrncy) THEN				
				Print (CUST.EFTDATA.amount)
				Print (CUST.EFTDATA.EffAvailableAmt)				
				IF ( CDOUBLE(CUST.EFTDATA.amount)  > CDOUBLE(CUST.EFTDATA.EffAvailableAmt)) THEN
					GOTO NEXTREC
				ENDIF
			ENDIF

			
			IF (CUST.EFTDATA.RETRY_NUM=="") THEN
				CUST.EFTDATA.RETRY_NUM=1
			ELSE
				CUST.EFTDATA.RETRY_NUM=cint (CUST.EFTDATA.RETRY_NUM) + 1
			ENDIF
				

			##CUST.EFTDATA.ChannelId = "COR"


			sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			if(sv_d == 0) then
				CUST.EFTDATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
				print(CUST.EFTDATA.msgDateTime)
			endif
			sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			if(sv_d == 0)then
				CUST.EFTDATA.RequestID1 = BANCS.OUTPARAM.RequestID
				print(CUST.EFTDATA.RequestID1)
			else
				CUST.EFTDATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
				print(CUST.EFTDATA.RequestID1)
			endif


			CUST.EFTDATA.headerXML = ""
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<Header>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<RequestHeader>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<MessageKey>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<RequestUUID>"+ CUST.EFTDATA.RequestID1 +"</RequestUUID>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<ServiceRequestId>executeFinacleScript</ServiceRequestId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<ChannelId>" + CUST.EFTDATA.ChannelId + "</ChannelId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</MessageKey>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<RequestMessageInfo>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<BankId>" + CUST.EFTDATA.BankId + "</BankId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<TimeZone>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</TimeZone>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<EntityId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</EntityId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<EntityType>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</EntityType>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<MessageDateTime>" + CUST.EFTDATA.msgDateTime + "</MessageDateTime>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</RequestMessageInfo>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<Security>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<Token>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<PasswordToken>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<UserId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</UserId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<Password>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</Password>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</PasswordToken>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</Token>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<FICertToken>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</FICertToken>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<RealUserLoginSessionId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</RealUserLoginSessionId>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<RealUser>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</RealUser>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<RealUserPwd>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</RealUserPwd>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "<SSOTransferToken>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</SSOTransferToken>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</Security>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</RequestHeader>"
			CUST.EFTDATA.headerXML = CUST.EFTDATA.headerXML + "</Header>"
			CUST.EFTDATA.bodyXMLMsg = ""
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<Body>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<executeFinacleScriptRequest>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<ExecuteFinacleScriptInputVO>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<requestId>EftAdd</requestId>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "</ExecuteFinacleScriptInputVO>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<executeFinacleScript_CustomData>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<remitCrncy>" + CUST.EFTDATA.remitCrncy  + "</remitCrncy>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<rate>" + CUST.EFTDATA.rate  + "</rate>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<destCustName>" + CUST.EFTDATA.destCustName  + "</destCustName>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<destAcct>" + CUST.EFTDATA.destAcct  + "</destAcct>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<eventId>" + CUST.EFTDATA.eventId  + "</eventId>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<foracid>" + CUST.EFTDATA.foracid + "</foracid>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<tranCode>" + CUST.EFTDATA.tranCode + "</tranCode>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<amount>" + CUST.EFTDATA.amount + "</amount>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<bankCode>" + CUST.EFTDATA.bankCode + "</bankCode>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<solid>" + CUST.EFTDATA.solid + "</solid>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<rateCode>" +CUST.EFTDATA.rateCode + "</rateCode>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<brCode>" + CUST.EFTDATA.brCode + "</brCode>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<waiveflg>" + CUST.EFTDATA.waiveflg + "</waiveflg>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<chargecrny>" + CUST.EFTDATA.chargecrny  + "</chargecrny>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<chargeamt>" + CUST.EFTDATA.chargeamt  + "</chargeamt>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<cRefNum>" + CUST.EFTDATA.cRefNum  + "</cRefNum>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<cTranParticulars>" + CUST.EFTDATA.cTranParticulars  + "</cTranParticulars>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "<cTranRemarks>" + CUST.EFTDATA.cTranRemarks  + "</cTranRemarks>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "</executeFinacleScript_CustomData>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "</executeFinacleScriptRequest>"
			CUST.EFTDATA.bodyXMLMsg = CUST.EFTDATA.bodyXMLMsg + "</Body>"
			CUST.EFTDATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
			CUST.EFTDATA.reqXMLMsg = CUST.EFTDATA.reqXMLMsg + "<FIXML>"
			CUST.EFTDATA.reqXMLMsg = CUST.EFTDATA.reqXMLMsg + CUST.EFTDATA.headerXML
			CUST.EFTDATA.reqXMLMsg = CUST.EFTDATA.reqXMLMsg + CUST.EFTDATA.bodyXMLMsg
			CUST.EFTDATA.reqXMLMsg = CUST.EFTDATA.reqXMLMsg + "</FIXML>"

			BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
			print(BANCS.INPARAM.SERVICE_NAME)
			BANCS.INPARAM.SEND_RECV_FLG             = "R"
			sv_a = CUST.EFTDATA.reqXMLMsg
			print(sv_a)
			sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
			print(sv_l)
			if (sv_l != 0) then
				print(BANCS.OUTPARAM.ErrMsg)
				CUST.EFTDATA.errorMsgFlg = "Y"
				CUST.EFTDATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.EFTDATA.errorMsgCode = "FIERR"
				GOTO NEXTREC
			endif
			if (BANCS.OUTPARAM.ErrMsg != "") then
				CUST.EFTDATA.errorMsgFlg = "Y"
				CUST.EFTDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
				CUST.EFTDATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.EFTDATA.errorMsgCode = "FIERR"
				GOTO NEXTREC 
			else
				CUST.EFTDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
				print(CUST.EFTDATA.respXMLMsg)
				CUST.EFTDATA.errorMsgFlg = ""
				CUST.EFTDATA.errorMsgDesc = ""
				CUST.EFTDATA.errorCode = ""
				CUST.EFTDATA.errorDesc = ""
				sv_x = CUST.EFTDATA.respXMLMsg
				sv_y = "<Status>"
				sv_z = "</Status>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				if (GETPOSITION(sv_x, sv_y) != 0) then
					CUST.EFTDATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
				else
					CUST.EFTDATA.tranStatus = ""
				endif
				print(CUST.EFTDATA.tranStatus)
				if (CUST.EFTDATA.tranStatus =="SUCCESS")  then
					CUST.EFTDATA.errorMsgFlg = "N"
					sv_x = CUST.EFTDATA.respXMLMsg
					sv_y = "<TranId>"
					sv_z = "</TranId>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					if (GETPOSITION(sv_x, sv_y) != 0) then
						CUST.EFTDATA.TranId = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.EFTDATA.TranId)
					
						sv_s = "update CUSTOM.EFT_RETRY  "
						sv_s = sv_s + " set process_status  = 'POSTED', core_tran_id = ?SVAR , POSTED ='Y', LCHG_TIME =sysdate ,  LCHG_USER_ID = ?SVAR "
						sv_s = sv_s + " where BENEF_ACCOUNT_NUM = ?SVAR  and  tran_amt  = ?SVAR   "
						sv_s = sv_s + " and bank_id = ?SVAR  and REF_NUM=?SVAR and POSTED ='N' and  FREE_TEXT4 =?SVAR "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.EFTDATA.TranId + "|" + BANCS.STDIN.userId + "|" + CUST.EFTDATA.destAcct + "|" +  CUST.EFTDATA.amount  + "|" + BANCS.STDIN.contextBankId + "|" + CUST.EFTDATA.cRefNum + "|" + CUST.EFTDATA.FREE_TEXT4
						print(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSQLWithBind(sv_s)
						if (sv_d == 0) then
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						endif
					ELSE
						GOTO NEXTREC
					endif
				else
					CUST.EFTDATA.errorMsgFlg = "Y"
					if(CUST.EFTDATA.tranStatus != "SUCCESS") then
						sv_x = CUST.EFTDATA.respXMLMsg
						sv_y = "<ErrorCode>"
						sv_z = "</ErrorCode>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						if (GETPOSITION(sv_x, sv_y) != 0) then
							CUST.EFTDATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
						endif
						sv_x = CUST.EFTDATA.respXMLMsg
						sv_y = "<ErrorDesc>"
						sv_z = "</ErrorDesc>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						if (GETPOSITION(sv_x, sv_y) != 0) then
							CUST.EFTDATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
						endif
						if((CUST.EFTDATA.errorCode == "") AND (CUST.EFTDATA.errorDesc == "")) then
							CUST.EFTDATA.errorCode = "SYSERR"
							CUST.EFTDATA.errorDesc = "Could not get response from server"
						endif
						sv_s = "update custom.EFT_RETRY  "
						sv_s = sv_s + " set process_status  = 'ERR', free_text2 =?SVAR, RETRY_NUM =?SVAR  "
						sv_s = sv_s + " where benef_account_num = ?SVAR  and  tran_amt  = ?SVAR  "
						sv_s = sv_s + " and bank_id = ?SVAR  and REF_NUM=?SVAR and POSTED ='N'   and  FREE_TEXT4 =?SVAR "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.EFTDATA.errorDesc  + "|" +   CUST.EFTDATA.RETRY_NUM + "|" + CUST.EFTDATA.destAcct + "|" +  CUST.EFTDATA.amount  + "|" + BANCS.STDIN.contextBankId + "|" + CUST.EFTDATA.cRefNum + "|" + CUST.EFTDATA.FREE_TEXT4

						print(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSQLWithBind(sv_s)
						if (sv_d == 0) then
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						endif
					endif               
				endif
				if((CUST.EFTDATA.errorCode == "") AND (CUST.EFTDATA.errorDesc == "")) then
					CUST.EFTDATA.errorCode = "SYSERR"
					CUST.EFTDATA.errorDesc = "Could not get response from server"
				endif
			ENDIF
		NEXTREC:

		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		DO

		sv_q = urhk_dbCursorClose(sv_m)
		PRINT(sv_q)
      
        ENDIF


ENDOFSCRIPT:
        
IF (CLASSEXISTS( "CUST","EFTDATA" ) == 1) THEN
	DELETECLASS( "CUST","EFTDATA" )
ENDIF

IF (REPEXISTS("CUST") == 1) THEN
	DELETEREP("CUST")
ENDIF

EXITSCRIPT
END-->
