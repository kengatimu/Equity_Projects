                                MTT.PartTranDetails.ValueDate   =  "0"
				OCTMM.GLBDATA.drparticls = "Unpaid Chequeno. " + trim(OCTMM.GLBDATA.ociInstmntId) + " " + OCTMM.GLBDATA.ClgRejDesc
				MTT.PartTranDetails.Particulars = mid$(OCTMM.GLBDATA.drparticls,0,50) 
                                MTT.PartTranDetails.RefAmount = -1*cdouble(OCTMM.GLBDATA.ociInstmntAmt)
                                print(MTT.PartTranDetails.RefAmount)
				OCTMM.GLBDATA.remarks = trim(OCTMM.GLBDATA.ociInwRejZoneCode) + "/" + trim(OCTMM.GLBDATA.ociInwRejZoneDate) + "/" + trim(OCTMM.GLBDATA.ociInwRejZoneSrlNum) 
				print(OCTMM.GLBDATA.remarks)
				MTT.PartTranDetails.Remarks = left$(OCTMM.GLBDATA.remarks,30) 
				MTT.PartTranDetails.RefNum = OCTMM.GLBDATA.ociSetNum 
                                MTT.PartTranDetails.IgnoreExcp = "I"
                                MTT.PartTranDetails.CarveAmtFlg = "Y"
                                MTT.PartTranDetails.ProxyPstgInd= "P"
                                MTT.PartTranDetails.Consolidate = "N"
                                MTT.PartTranDetails.TranIdentifier = "OCIClgRec"
                                print(MTT.PartTranDetails.TranIdentifier)
                                MTT.PartTranDetails.PstFlg = "Y"
                                MTT.PartTranDetails.ReportCode   = "ODLoan"
                                sv_r = urhk_MTTS_definePartTran("OCIClgTran")
                                print(sv_r)
                                if (sv_r != 0) then
				#{
                                        BANCS.OUTPUT.successOrFailure = "F"
                                        print(MTT.Error.Description)
                                        MTT.Error.Description="Debit Part Tran Definition failed "
                                        sv_r = urhk_MTTS_ReportErrorCondition("")
                                        sv_r = BANCS.OUTPARAM.MTTErrorDesc
