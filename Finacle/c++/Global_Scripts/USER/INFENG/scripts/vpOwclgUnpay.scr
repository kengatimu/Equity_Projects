        while(sv_z ==0)
        ##{
       		OCTMM.GLBDATA.ociSolid = BANCS.OUTPARAM.ociSolid
		OCTMM.GLBDATA.iciAcctSolid = BANCS.OUTPARAM.iciAcctSolid
		OCTMM.GLBDATA.iciAcid = BANCS.OUTPARAM.iciAcid
		OCTMM.GLBDATA.icpTranId = BANCS.OUTPARAM.icpTranId
		OCTMM.GLBDATA.icpTranDate = BANCS.OUTPARAM.icpTranDate
		OCTMM.GLBDATA.icpPartTrnSrlNum = BANCS.OUTPARAM.icpPartTrnSrlNum
		OCTMM.GLBDATA.DrAcctId = BANCS.OUTPARAM.DrAcctId
