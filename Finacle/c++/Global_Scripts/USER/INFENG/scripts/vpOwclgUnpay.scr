		#{
			OCTMM.GLBDATA.pcommSkip = "Y"
		else
			OCTMM.GLBDATA.pcommSkip = "N"
		#}
		endif
		print(OCTMM.GLBDATA.pSchmType)
               
#Tran Entry Starts
                                MTT.PartTranDetails.Account = OCTMM.GLBDATA.DrAcctId 
                                MTT.PartTranDetails.RefCurrency = OCTMM.GLBDATA.drAcctCnrcyCode 
