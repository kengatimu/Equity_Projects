		print(OCTMM.GLBDATA.ociInwRejZoneDate)
		print(OCTMM.GLBDATA.ociInwRejZoneSrlNum)
		print(OCTMM.GLBDATA.ociPayeeName)

		sv_a= urhk_B2k_AcidToForacid(OCTMM.GLBDATA.DrAcctId)
		if(sv_a==0)then
