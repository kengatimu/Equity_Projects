                                        OCTMM.GLBDATA.srvErrCode = "MTT"
                                        OCTMM.GLBDATA.srvSucFail = "F"
                                        goto NXTREC
				#}
                                endif
				print(OCTMM.GLBDATA.drAcctCnrcyCode)
				print(OCTMM.GLBDATA.PdrAcctCnrcyCode)
                                MTT.PartTranDetails.Account = OCTMM.GLBDATA.PayingAcctId 
                                MTT.PartTranDetails.RefCurrency = OCTMM.GLBDATA.PdrAcctCnrcyCode 
                                MTT.PartTranDetails.ValueDateDiff = "0"
                                MTT.PartTranDetails.ValueDate           =  "0"
				OCTMM.GLBDATA.mcrParti = "Unpaid Chequeno. " + trim(OCTMM.GLBDATA.ociInstmntId) + " Insufficient Funds - " + OCTMM.GLBDATA.ociPayeeName 
				print(OCTMM.GLBDATA.mcrParti)
				MTT.PartTranDetails.Particulars = mid$(OCTMM.GLBDATA.mcrParti,0,50) 
                                MTT.PartTranDetails.RefAmount = 1 * cdouble(OCTMM.GLBDATA.ociInstmntAmt)
                                print(MTT.PartTranDetails.RefAmount)
				OCTMM.GLBDATA.remarks = trim(OCTMM.GLBDATA.ociInwRejZoneCode) + "/" + trim(OCTMM.GLBDATA.ociInwRejZoneDate) + "/" + trim(OCTMM.GLBDATA.ociInwRejZoneSrlNum) 
				print(OCTMM.GLBDATA.remarks)
				MTT.PartTranDetails.Remarks = left$(OCTMM.GLBDATA.remarks,30) 
				MTT.PartTranDetails.RefNum = OCTMM.GLBDATA.ociSetNum 
