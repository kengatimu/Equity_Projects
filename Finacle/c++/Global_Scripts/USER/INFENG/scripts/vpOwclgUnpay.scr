        print(sv_u)
        if(sv_u != 0 ) then
                OCTMM.GLBDATA.srvErrMsg = MTT.Error.Description
                OCTMM.GLBDATA.srvErrCode = "MTT"
                OCTMM.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
	lv_q = " ociSolid,iciAcctSolid,iciAcid,icpTranId,icpTranDate,icpPartTrnSrlNum,DrAcctId,commCrAcctId,PayingAcctId,ociClgZoneDate,ociClgZoneCode,ociSetNum,ociInstmntId,ociInstmntDate,ociInstmntAmt,ociInwRejZoneCode,ociInwRejZoneDate,ociInwRejZoneSrlNum,ociPayeeName,ociRejCode | "
	lv_q = lv_q + " select oci.sol_id,ici.acct_sol_id,ici.acid,icp.tran_id,icp.tran_date,icp.part_tran_srl_num,(select acid from tbaadm.dctd_acli where bank_id=?SVAR and tran_date=icp.tran_date and tran_id=icp.tran_id and part_tran_type='C' and tran_type='L' and tran_sub_type='I' and pstd_flg='Y' and del_flg='N') as DrAcctId, (select foracid from tbaadm.gam where bank_id=?SVAR and bacid='PNLCHQUN' and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg<>'Y' and sol_id=(select sol_id from tbaadm.gam where bank_id='54' and foracid=oci.paying_acct_id)) as commCrAcctId,oci.paying_acct_id,oci.clg_zone_date,oci.clg_zone_code,oci.set_num,oci.instrmnt_id,oci.instrmnt_date,oci.instrmnt_amt,oci.inw_rej_zone_code,oci.inw_rej_zone_date,oci.inw_rej_zone_srl_num,oci.freetext3,oci.rej_code_1  "
	lv_q = lv_q + " from tbaadm.oci,tbaadm.icp,tbaadm.ici "
	lv_q = lv_q + " where oci.bank_id=?SVAR and icp.bank_id=?SVAR and ici.bank_id=?SVAR " 
	lv_q = lv_q + " and oci.clg_zone_code in ('CTSINHSE','EQBOWZUSIN','EQBOWGBPIN','EQBOWEURIN') " 
	lv_q = lv_q + " and oci.clg_zone_date= to_date(?SVAR,'DD-MM-RRRR') " 
	lv_q = lv_q + " and oci.sol_id= ?SVAR " 
	lv_q = lv_q + " and oci.rej_type='O' " 
        lv_q = lv_q + " and oci.STATUS_FLG='J' "
        lv_q = lv_q + " and oci.del_flg='N' "
        lv_q = lv_q + " and icp.zone_code = oci.inw_rej_zone_code "
        lv_q = lv_q + " and icp.zone_date = oci.inw_rej_zone_date "
        lv_q = lv_q + " and icp.zone_srl_num = oci.inw_rej_zone_srl_num "
        lv_q = lv_q + " and icp.tran_amt = oci.instrmnt_amt "
        lv_q = lv_q + " and icp.status_ind='P' "
        lv_q = lv_q + " and ici.rej_type='O' "
        lv_q = lv_q + " and ici.out_rej_set_num = oci.set_num "
        lv_q = lv_q + " and ici.out_rej_zone_code = oci.clg_zone_code "
        lv_q = lv_q + " and ici.out_rej_zone_date = oci.clg_zone_date "
        lv_q = lv_q + " and ici.status_ind='P' "
        lv_q = lv_q + " and ici.ZONE_SRL_NUM = oci.inw_rej_zone_srl_num "
        lv_q = lv_q + " and ici.inst_num=oci.instrmnt_id "
        lv_q = lv_q + " and ici.inst_amt = oci.instrmnt_amt "
        lv_q = lv_q + " and ici.free_text1 is null" 
	##BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + lef$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.mySolId
	###BANCS.STDIN.BODDate = "06-03-2026"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.mySolId
        print(lv_q)
        print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(lv_q)
        if(sv_u==0)then
        #{
                OCTMM.GLBDATA.ocicurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
