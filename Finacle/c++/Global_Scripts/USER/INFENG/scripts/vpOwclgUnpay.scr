		lv_t = "CommTranAmt,ClgRejDesc| select regexp_substr(nvl(alt1_clg_rej_desc,0),'[^,]+$',1,1),clg_rej_desc from tbaadm.crc where bank_id=?SVAR and clg_rej_code=?SVAR and del_flg='N' "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + OCTMM.GLBDATA.ociRejCode
