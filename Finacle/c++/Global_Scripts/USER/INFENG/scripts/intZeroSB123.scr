				sv_s = sv_s + " to_char(greatest(TRUNC( to_date(?SVAR, 'DD-MM-YYYY') , 'Q'), to_date(?SVAR, 'DD-MM-YYYY')), 'DD-MM-YYYY')  as start_date"
