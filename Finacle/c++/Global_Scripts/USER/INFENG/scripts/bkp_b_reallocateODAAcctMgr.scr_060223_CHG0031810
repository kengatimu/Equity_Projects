#------------------------------------------------------------------------------------------------
#  Name            : b_reallocateODAAcctMgr.scr
#  Description     : This script will allocate account Managers to overdrafts accounts opened everyday
#  Date            : 01-07-2022
#  Author          : Timothy Karemeri
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :  (Batch Job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             01-07-2022      Timothy Karemeri		Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUSTS") == 0) THEN
#{
	CREATEREP("CUSTS")
#}
ENDIF

IF (CLASSEXISTS("CUSTS","ACMOD") == 0) THEN
#{
	CREATECLASS("CUSTS","ACMOD",5)
#}
ENDIF

IF (CLASSEXISTS("CUSTS","ACMOD") == 0) THEN
#{
    CREATECLASS("CUSTS","ACMOD", 5)
#}
ENDIF
#------------------------------------------------------------------------------
#Initialisig required repository variables 
#------------------------------------------------------------------------------
CUSTS.ACMOD.errMsg = ""

#------------------------------------------------------------------------------
#Finding count of records that need to be processed
#------------------------------------------------------------------------------

sv_a=urhk_B2k_PrintRepos("BANCS")
print (sv_a)

BANCS.INPUT.moduleName = "LOANINT"
BANCS.INPUT.parameterId = "ODAMGR"
CALL ("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)

IF (BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUSTS.ACMOD.odaAcctmgr = BANCS.OUTPUT.parameterVal
        PRINT(CUSTS.ACMOD.odaAcctmgr)
	 PRINT(CUSTS.ACMOD.odaAcctmgr)
#}
ELSE
#{
    CUSTS.ACMOD.errMsg = "Cparam set up not done for CURRMGR"
    GOTO ENDOFSCRIPT
#}
ENDIF

#CUSTS.ACMOD.odaAcctmgr = "JOHARI54"
#PRINT(CUSTS.ACMOD.odaAcctmgr)

###############################################################################################
##Getting the OD542 accounts and Account Managers to be allocated
###############################################################################################
sv_s="custcount1|"
sv_s = sv_s + " select count(*) from tbaadm.gam where bank_id = ?SVAR "
sv_s = sv_s + " and sol_id = ?SVAR "
sv_s = sv_s + " and schm_code in ('OD542') "
#sv_s = sv_s + " and schm_code in ('OD542','OD543','OD544','OD545','OD546') "
sv_s = sv_s + " and ACCT_CLS_FLG ! = 'Y' "
sv_s = sv_s + " and ACCT_MGR_USER_ID = ?SVAR "
print(sv_s)

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + CUSTS.ACMOD.odaAcctmgr
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)

IF (sv_d != 0) THEN 
#{
	CUSTS.ACMOD.errMsg = "DB ERROR!"
	GOTO NEXTLP1
#}
ELSE
#{
	CUSTS.ACMOD.custcount1 = BANCS.OUTPARAM.custcount1
	print(CUSTS.ACMOD.custcount1)
	IF (CINT(CUSTS.ACMOD.custcount1)== 0) THEN
	#{
		GOTO NEXTLP1
	#}
	ENDIF
	IF (CINT(CUSTS.ACMOD.custcount1) > 0) THEN
	#{
		CALL ("ODAAcctMgr001.scr")
	#}
	ENDIF
#}
ENDIF

NEXTLP1:


################################################################################################
###Getting the OD543 & OD544 accounts and Account Managers to be allocated
################################################################################################
sv_s="custcount2|"
sv_s = sv_s + " select count(*) from tbaadm.gam where bank_id = ?SVAR "
sv_s = sv_s + " and sol_id = ?SVAR "
sv_s = sv_s + " and schm_code in ('OD543','OD544') "
#sv_s = sv_s + " and schm_code in ('OD542','OD543','OD544','OD545','OD546') "
sv_s = sv_s + " and ACCT_CLS_FLG ! = 'Y' "
sv_s = sv_s + " and ACCT_MGR_USER_ID = ?SVAR "
print(sv_s)

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + CUSTS.ACMOD.odaAcctmgr
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)

IF (sv_d != 0) THEN 
#{
	CUSTS.ACMOD.errMsg = "DB ERROR!"
	GOTO NEXTLP2
#}
ELSE
#{
	CUSTS.ACMOD.custcount2 = BANCS.OUTPARAM.custcount2
	print(CUSTS.ACMOD.custcount2)
	IF (CINT(CUSTS.ACMOD.custcount2)== 0) THEN
	#{
		GOTO NEXTLP2
	#}
	ENDIF
	IF (CINT(CUSTS.ACMOD.custcount2) > 0) THEN
	#{
		CALL ("ODAAcctMgr002.scr")
	#}
	ENDIF
#}
ENDIF

NEXTLP2:
###############################################################################################
##Getting the OD545 & OD546 accounts and Account Managers to be allocated
###############################################################################################
sv_s="custcount3|"
sv_s = sv_s + " select count(*) from tbaadm.gam where bank_id = ?SVAR "
sv_s = sv_s + " and sol_id = ?SVAR "
sv_s = sv_s + " and schm_code in ('OD545','OD546') "
#sv_s = sv_s + " and schm_code in ('OD542','OD543','OD544','OD545','OD546') "
sv_s = sv_s + " and ACCT_CLS_FLG ! = 'Y' "
sv_s = sv_s + " and ACCT_MGR_USER_ID = ?SVAR "
print(sv_s)

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + CUSTS.ACMOD.odaAcctmgr
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)

IF (sv_d != 0) THEN 
#{
	CUSTS.ACMOD.errMsg = "DB ERROR!"
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	CUSTS.ACMOD.custcount3 = BANCS.OUTPARAM.custcount3
	print(CUSTS.ACMOD.custcount3)
	IF (CINT(CUSTS.ACMOD.custcount3)== 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF (CINT(CUSTS.ACMOD.custcount3) > 0) THEN
	#{
		CALL ("ODAAcctMgr003.scr")
	#}
	ENDIF
#}
ENDIF

ENDOFSCRIPT:
IF(CUSTS.ACMOD.errMsg != "") THEN
#{
    sv_u = system("echo '"+CUSTS.ACMOD.errMsg+"' >>ODAMgr.log")
#}
ENDIF

EXITSCRIPT
