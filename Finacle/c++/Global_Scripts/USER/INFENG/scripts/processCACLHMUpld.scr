<--START
	# Script body goes here
	TRACE ON
	
	###########################################################################
	# Create repository and class
	###########################################################################
	
	IF(REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","DATA")==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	sv_e = urhk_B2k_PrintRepos("BANCS")
	sv_r = urhk_getEnv("fileName")
	CUST.DATA.fileName = BANCS.OUTPARAM.envValue
	PRINT (CUST.DATA.fileName)

	sv_r = urhk_getEnv("funcCode")
	CUST.DATA.funcCode= BANCS.OUTPARAM.envValue
	PRINT (CUST.DATA.funcCode)
	
	CUST.DATA.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
	PRINT(CUST.DATA.BODDate)
	
	CUST.DATA.bankId  = BANCS.STDIN.contextBankId
	PRINT(CUST.DATA.bankId)
	CUST.DATA.srvErrMsg = ""
	
	############################################################################
	# Report Initialization
	############################################################################
	
	
	############################################################################
	# Generating time stamp
	############################################################################
	
	sv_v = ""
	sv_v = sv_v + "tstamp|"
	sv_v = sv_v + "SELECT TO_CHAR(sysdate,'DDMMYYHH24MISS') FROM DUAL"
	PRINT(sv_v)
	sv_w = urhk_dbSelectWithBind(sv_v)
	PRINT(sv_w)
	
	IF(sv_w == 0)THEN
	#{
		CUST.DATA.timeStamp=BANCS.OUTPARAM.tstamp
	#}
	ENDIF
	PRINT(CUST.DATA.timeStamp)
	
	CUST.DATA.rptFileName	= "CACLHMUPLD_REPORT_"+MID$(CUST.DATA.fileName,0,STRLEN(CUST.DATA.fileName) - 4)+"_"+CUST.DATA.timeStamp+".TXT"
	PRINT(CUST.DATA.rptFileName)
	
	CUST.DATA.rpDesc		= "Custom ACLHM Upload Report"
	PRINT(CUST.DATA.rpDesc)
	
	sv_s = SYSTEM("echo ' ' >" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo '=========================================================================================================================================================================' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo '                                                                         Custom ACLHM Upload Report                                                                        ' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo '=========================================================================================================================================================================' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo 'Upload FileName:    "+CUST.DATA.fileName+"' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo 'Upload Date 	:    "+CUST.DATA.BODDate+"' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo 'Upload Sol 	:    "+BANCS.STDIN.mySolId+"' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo 'Uploaded By 	:    "+BANCS.STDIN.userId+"' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
	
	sv_s = SYSTEM("echo '-------------------------------------------------------------------------------------------------------------------------------------------------------------------------' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo '| Record No |      Foracid       | Upload Status |                  Upload Remarks                  | Process Status |                 Process Remarks                  |' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo '-------------------------------------------------------------------------------------------------------------------------------------------------------------------------' >>" + CUST.DATA.rptFileName)
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
	
	
	############################################################################
	# Selecting all records from custom table with status E
	############################################################################
	
	sv_s = ""
	sv_s = "upldForacid,limit,expDate,recNo,uStatus,uRemarks|"
	sv_s = sv_s + " SELECT FORACID,LIMIT,to_char(EXPIRY_DATE,'dd-mm-yyyy hh:mi:ss'),RECORD_NO,UPLD_STATUS,UPLD_REMARKS FROM CUSTOM.C_ACLHMUPLD "
	sv_s = sv_s + " WHERE FILE_NAME = ?SVAR AND UPLOAD_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') AND BANK_ID=?SVAR order by RECORD_NO"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = CUST.DATA.fileName + "|" + CUST.DATA.BODDate+"|"+CUST.DATA.bankId
	
	sv_j = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_j)
	
	IF (sv_j != 0) THEN
	#{
		CUST.DATA.upldStatus = "Failed"
		CUST.DATA.upldError  = "No Records have been uploaded"
		sv_s = SYSTEM("echo 'Upload Failed		:    "+CUST.DATA.upldError+"' >>" + CUST.DATA.rptFileName)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.DATA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(CUST.DATA.cursorNum)
	
	sv_e = urhk_dbCursorFetch(CUST.DATA.cursorNum)
	PRINT(sv_e)
	
	WHILE(sv_e == "0")
	#{
		CUST.DATA.upldForacid		=	BANCS.OUTPARAM.upldForacid
		PRINT(CUST.DATA.upldForacid)

		CUST.DATA.limit 		= 	BANCS.OUTPARAM.limit
		print(CUST.DATA.limit)
		
		CUST.DATA.expDate		=	BANCS.OUTPARAM.expDate
		print(CUST.DATA.expDate)

		CUST.DATA.recNo		=	BANCS.OUTPARAM.recNo
		PRINT(CUST.DATA.recNo)
		
		CUST.DATA.uStatus		=	BANCS.OUTPARAM.uStatus
		PRINT(CUST.DATA.uStatus)
		
		CUST.DATA.uRemarks		=	BANCS.OUTPARAM.uRemarks
		PRINT(CUST.DATA.uRemarks)
		
		IF(CUST.DATA.uStatus == "Success")THEN
		#{
			CALL("processCACLHMUpldSRV.scr")
		#}
		ELSE
		#{
			CUST.DATA.procStatus = CUST.DATA.uStatus
			CUST.DATA.procRmks = CUST.DATA.uRemarks
		#}	
		ENDIF
		
		############################################################################
		# Pushing details to Report
		############################################################################
		print(CUST.DATA.procStatus)
		print(CUST.DATA.procRmks)
		CUST.DATA.concat = ""
		CUST.DATA.concat = LPAD(CUST.DATA.recNo,11,' ') + "|" + LPAD(CUST.DATA.upldForacid,20,' ') + "|" +LPAD(CUST.DATA.uStatus,15,' ') + "|" + LPAD(CUST.DATA.uRemarks,50,' ') + "|" + LPAD(CUST.DATA.procStatus,16,' ') + "|" + LPAD(CUST.DATA.procRmks,50,' ')
		sv_s = SYSTEM("echo '"+CUST.DATA.concat+" ' >>" + CUST.DATA.rptFileName)
		sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
		
		
		sv_a = "update custom.C_ACLHMUPLD set process_status = ?SVAR,process_remarks=?SVAR where FILE_NAME = ?SVAR AND UPLOAD_DATE=to_date(?SVAR,'dd-mm-yyyy') AND record_no=?SVAR AND BANK_ID = ?SVAR "
		PRINT(sv_a)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.procStatus+ "|" +mid$(CUST.DATA.procRmks,0,99) + "|" +CUST.DATA.fileName+ "|" +CUST.DATA.BODDate + "|" + CUST.DATA.recNo+ "|" +CUST.DATA.bankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_c = urhk_dbSqlWithBind(sv_a)
		PRINT(sv_c)
		sv_c = urhk_dbSqlWithBind("commit")
		PRINT(sv_c)
		
		
		sv_e = urhk_dbCursorFetch(CUST.DATA.cursorNum)
		PRINT(sv_e)
		
	#}
	DO
	sv_h = urhk_dbCursorClose(CUST.DATA.cursorNum)
	PRINT(sv_h)
	
	ENDOFSCRIPT:
	sv_s = SYSTEM("echo ' ' >>" + CUST.DATA.rptFileName)
		sv_s = SYSTEM("echo '=========================================================================================================================================================' >>" + CUST.DATA.rptFileName)
		
		sv_q = "exebatch babx4040 $B2K_SESSION_ID " + " "+ CUST.DATA.rptFileName +" Custom_ACLHM_Upload  MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		PRINT(sv_r)
		
END-->
