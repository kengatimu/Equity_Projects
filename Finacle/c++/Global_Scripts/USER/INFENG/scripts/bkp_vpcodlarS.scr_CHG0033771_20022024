                                        #{
                                                EQOD.GLBDATA.isreshYN = "Y"
                                        #}
                                        endif
                                        if((EQOD.GLBDATA.funcCode=="R")and((EQOD.GLBDATA.schmCode=="DL002")or(EQOD.GLBDATA.schmCode=="OD552")))then
