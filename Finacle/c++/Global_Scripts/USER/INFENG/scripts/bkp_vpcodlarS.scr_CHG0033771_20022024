                                                lv_d = "update custom.odla_dmd_tbl set del_flg='Y',lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and od_acid=?SVAR and del_flg='N' "
                                                BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQOD.GLBDATA.LoanAcid
                                                print(BANCS.INPARAM.BINDVARS)
                                                print(lv_d)
                                                lv_d = urhk_dbSqlWithBind(lv_d)
                                                if(lv_d==0)then
                                                #{
                                                        lv_d = urhk_dbSqlWithBind("commit")
                                                        if(lv_d==0)then
                                                        #{
                                                                sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
                                                                EQOD.GLBDATA.msg = "Loan Schedule Deleted Successfully. Generate New Demands "
                                                                sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
                                                                print(sv_c)
                                                                exitscript
                                                        else
                                                                lv_d = urhk_dbSqlWithBind("rollback")
                                                                sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
                                                                EQOD.GLBDATA.msg = "Loan Schedule Delete Failed."
                                                                sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
                                                                print(sv_c)
                                                                exitscript
                                                        #}
                                                        endif
                                                #}
                                                endif
                                        #}
                                        endif
