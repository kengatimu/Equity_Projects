<--START
	# Script body goes here
	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	 sv_r = CLASSEXISTS("CUST","INTERFACE")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","INTERFACE",5)
        #}
        ENDIF
	PRINT(BANCS.INPUT.inputData)
	
		CUST.INTERFACE.cifId = " "
		CUST.INTERFACE.acid = " "
		CUST.CIETXN.scriptSuccess = "Y"
		CUST.INTERFACE.modeOfOper = " "
		CUST.INTERFACE.schm_code = " "
		CUST.INTERFACE.corp = " "
		CUST.INTERFACE.recCount = " "
		CUST.INTERFACE.cifValues = " "
		CUST.INTERFACE.cifNameValues = " "
		CUST.CIETXN.errorFlg="N"
		CUST.CIETXN.errorMsg=" "
					CUST.INTERFACE.custId=" "
				CUST.INTERFACE.skipBioVal="N"
		
	#------------------------------------------------------------------------------
		# Fetching the customer id in case the input is account id
		#------------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.inputData 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|Y" + "|" + "N" + "|" + "C|E"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "cifId,acid,modeOfOper,schm_code|SELECT CIF_ID,ACID,MODE_OF_OPER_CODE,SCHM_CODE FROM TBAADM.GAM WHERE FORACID = ?SVAR"
		sv_s = sv_s + " AND ENTITY_CRE_FLG = ?SVAR AND DEL_FLG = ?SVAR"
		sv_s = sv_s + " AND ACCT_OWNERSHIP IN  (?SVAR, ?SVAR)"
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.cifId = BANCS.OUTPARAM.cifId
			CUST.INTERFACE.acid  = BANCS.OUTPARAM.acid
			CUST.INTERFACE.cifValues = CUST.INTERFACE.cifId 
			CUST.INTERFACE.modeOfOper = BANCS.OUTPARAM.modeOfOper
			CUST.INTERFACE.schm_code = BANCS.OUTPARAM.schm_code

			IF ((CUST.INTERFACE.modeOfOper != "ALL") AND (CUST.INTERFACE.modeOfOper != "SELF") AND (CUST.INTERFACE.modeOfOper != "ANY") AND (CUST.INTERFACE.modeOfOper != "ETS") AND (CUST.INTERFACE.modeOfOper != "BTS"))THEN
			#{
				CUST.INTERFACE.modeOfOper = "ALL"
			#}
			ENDIF 
            BANCS.INPARAM.BINDVARS = CUST.INTERFACE.cifId  + "|" + BANCS.STDIN.contextBankId
            sv_s = "cnt|SELECT  count(1) fROM CRMUSER.ACCOUNTS WHERE ORGKEY = ?SVAR "
            sv_s = sv_s + " AND BANK_ID = ?SVAR AND CORP_ID IS NULL "
            sv_d = urhk_dbSelectWithBind(sv_s)
            IF(sv_d == 0) THEN
            #{
                    IF(BANCS.OUTPARAM.cnt == 0)THEN
                    #{
                            CUST.INTERFACE.corp = "Y"
                    #}
					ELSE
					#{
					BANCS.INPARAM.BINDVARS = CUST.INTERFACE.cifId + "|" + BANCS.STDIN.contextBankId
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
					print(BANCS.INPARAM.BINDVARS)
					sv_s = "cifcustidname|SELECT CUST_NAME FROM TBAADM.CMG"
					sv_s = sv_s + " WHERE CIF_ID = ?SVAR"
					sv_s = sv_s + " AND BANK_ID = ?SVAR"
					sv_s = sv_s + " AND DEL_FLG = ?SVAR "
					print(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					IF(sv_d == 0) THEN
					#{
						CUST.INTERFACE.cifNameValues = BANCS.OUTPARAM.cifcustidname
								print(CUST.INTERFACE.cifNameValues)
					#}
                    ENDIF
            #}
            ENDIF

		#}
		ELSE
		#{
			CUST.INTERFACE.cifId = ""
			
				CUST.INTERFACE.skipBioVal = "Y"
				GOTO ENDOFVAL
			
		#}
		ENDIF
		
			
	IF(CUST.INTERFACE.modeOfOper != "SELD")THEN
	#{
		IF(CUST.INTERFACE.acid != "")THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.acid + "|" + "N" + "|" + BANCS.STDIN.contextBankId
			sv_s = "recCount|SELECT COUNT(*) FROM TBAADM.AAS"
			sv_s = sv_s + " WHERE ACID = ?SVAR"
			sv_s = sv_s + " AND DEL_FLG=?SVAR AND BANK_ID = ?SVAR "
			sv_s = sv_s + " AND CUST_ID IS NOT NULL "
			sv_s = sv_s + " AND ACCT_POA_AS_REC_TYPE <> 'M' "
			print(sv_s)
			sv_m  = urhk_dbSelectWithBind(sv_s)
			print(sv_m)
				
			IF(sv_m == 0) THEN
			#{
				CUST.INTERFACE.recCount = BANCS.OUTPARAM.recCount
			#}
			ELSE
			#{
				CUST.CIETXN.scriptSuccess = "N"
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Unable to Fetch Customer Details for Bio Validation"
				GOTO ENDOFVAL
			#}
			ENDIF

			IF(CUST.INTERFACE.recCount > 0)THEN
			#{
				BANCS.INPARAM.BINDVARS = CUST.INTERFACE.acid + "|" + "N" + "|" + BANCS.STDIN.contextBankId
				sv_s = "customerID|SELECT CUST_ID FROM TBAADM.AAS"
				sv_s = sv_s + " WHERE ACID = ?SVAR"
				sv_s = sv_s + " AND DEL_FLG=?SVAR AND BANK_ID = ?SVAR "
				sv_s = sv_s + " AND CUST_ID IS NOT NULL "
				sv_s = sv_s + " AND ACCT_POA_AS_REC_TYPE <> 'M' "

				print(sv_s)
				sv_m  = urhk_dbCursorOpenWithBind(sv_s)
				print(sv_m)
				IF(sv_m == 0) THEN
				#{
					sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
					print(sv_n)
				#}
				ELSE
				#{
					CUST.CIETXN.scriptSuccess = "N"
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Unable to Fetch Customer Details for Bio Validation"
					GOTO ENDOFVAL
				#}
				ENDIF

				sv_f = urhk_dbCursorFetch(sv_n)
				print(sv_f)
				WHILE(sv_f == 0)
				#{
					CUST.INTERFACE.custId = BANCS.OUTPARAM.customerID
					print(CUST.INTERFACE.custId)	
					#------------------------------------------------------------------------------
					# Checking whether customer override is required by checking OBCUST
					#------------------------------------------------------------------------------
					BANCS.INPARAM.BINDVARS = CUST.INTERFACE.custId + "|" + BANCS.STDIN.contextBankId
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
					print(BANCS.INPARAM.BINDVARS)
					sv_s = "jointCifId,cifcustidname|SELECT CIF_ID,CUST_NAME FROM TBAADM.CMG"
					sv_s = sv_s + " WHERE CUST_ID = ?SVAR"
					sv_s = sv_s + " AND BANK_ID = ?SVAR"
					sv_s = sv_s + " AND DEL_FLG = ?SVAR "
					print(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					IF(sv_d == 0) THEN
					#{
						print(BANCS.OUTPARAM.jointCifId)
                        # If there are joint CIF , check whether the customer is corporate/Retail
                        IF(CUST.INTERFACE.corp == "Y") THEN
                        #{
                                CUST.INTERFACE.cifValues = ""
								CUST.INTERFACE.cifNameValues=""
                                CUST.INTERFACE.corp = "N"
                        #}
                        ENDIF
						IF(CUST.INTERFACE.cifValues != "") THEN
						#{	
								CUST.INTERFACE.cifValues = CUST.INTERFACE.cifValues + "!" + BANCS.OUTPARAM.jointCifId
								print(CUST.INTERFACE.cifValues)
								CUST.INTERFACE.cifNameValues = CUST.INTERFACE.cifNameValues + "!" + BANCS.OUTPARAM.cifcustidname
								print(CUST.INTERFACE.cifNameValues)
						#}
						ELSE
						#{
								CUST.INTERFACE.cifValues = BANCS.OUTPARAM.jointCifId
								print(CUST.INTERFACE.cifValues)
								CUST.INTERFACE.cifNameValues = BANCS.OUTPARAM.cifcustidname
								print(CUST.INTERFACE.cifNameValues)
						#}
						ENDIF
					#}
					ELSE
					#{
						#sv_u = urhk_SetOrbOut("Error_0|ERROR DB operation failed. Kindly contact Admin")
						# Joint CIF is not valid 
						#GOTO ENDOFVAL
					#}
					ENDIF


					sv_f = urhk_dbCursorFetch(sv_n)
					print(sv_f)

				#}
				DO
				#Closing cursor
				sv_f = urhk_dbCursorClose(sv_n)
				print(sv_f)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFVAL:
		CUST.CIETXN.outputData = CUST.CIETXN.scriptSuccess+","+CUST.CIETXN.errorFlg+","+CUST.CIETXN.errorMsg
		CUST.CIETXN.outputData = CUST.CIETXN.outputData+","+CUST.INTERFACE.cifId +","+CUST.INTERFACE.acid 
		CUST.CIETXN.outputData = CUST.CIETXN.outputData+","+CUST.INTERFACE.modeOfOper+","+CUST.INTERFACE.schm_code+","+CUST.INTERFACE.corp
		CUST.CIETXN.outputData = CUST.CIETXN.outputData+","+CUST.INTERFACE.recCount+","+CUST.INTERFACE.custId+","+CUST.INTERFACE.cifValues
		CUST.CIETXN.outputData = CUST.CIETXN.outputData+","+CUST.INTERFACE.cifNameValues+","+CUST.INTERFACE.skipBioVal+","
		
		PRINT(CUST.CIETXN.outputData)
			sv_b=urhk_setOrbOut("outputData|"+CUST.CIETXN.outputData)
			PRINT(sv_b)
			
				
	PRINT(CUST.CIETXN.scriptSuccess)
	PRINT(CUST.CIETXN.errorFlg)
	PRINT(CUST.CIETXN.errorMsg)
	PRINT(CUST.INTERFACE.cifId)
	PRINT(CUST.INTERFACE.acid)
	PRINT(CUST.INTERFACE.modeOfOper)
	PRINT(CUST.INTERFACE.schm_code)
	PRINT(CUST.INTERFACE.corp)
	PRINT(CUST.INTERFACE.recCount)
	PRINT(CUST.INTERFACE.custId)
	PRINT(CUST.INTERFACE.cifValues)
	PRINT(CUST.INTERFACE.cifNameValues)
	PRINT(CUST.INTERFACE.skipBioVal)
END-->
