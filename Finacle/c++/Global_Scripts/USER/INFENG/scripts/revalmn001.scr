	MTT.TranDetails.Remarks = "Reval Transaction"
	MTT.TranDetails.IgnoreExcp="I"
	sv_a = urhk_MTTS_DefineTransaction("Reval")
	PRINT(sv_a)
	
	
	CUST.REVAL.tranRmksHdr			= ""
	CUST.REVAL.key					= ""
	CUST.REVAL.lstName				= ""
	CUST.REVAL.homeCrncyCode		= ""
	CUST.REVAL.cursorNo				= ""
	CUST.REVAL.currcode				= ""
	CUST.REVAL.pnlAccount			= ""
	CUST.REVAL.rateCode				= ""
	CUST.REVAL.homeCrncyPosAcct		= ""
	CUST.REVAL.foreignCrncyPosAcct	= ""
	CUST.REVAL.labelLine			= ""
	CUST.REVAL.clrBalFrnCrncy		= ""
	CUST.REVAL.clrBalHmeCrncy		= ""
	CUST.REVAL.netAmount			= ""
	CUST.REVAL.tranPtclrBdy			= ""
	CUST.REVAL.tranRmksBdy			= ""
	CUST.REVAL.errMsg				= ""
	CUST.REVAL.errCode				= ""
