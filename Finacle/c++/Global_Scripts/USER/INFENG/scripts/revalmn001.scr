	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.REVAL.tranRmksHdr = BANCS.OUTPUT.parameterVal
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EOD_REVALUATION"
	BANCS.INPUT.parameterId = "TRAN_BODY_RMKS"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.REVAL.tranRmksBdy = BANCS.OUTPUT.parameterVal
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "EOD_REVALUATION"
	BANCS.INPUT.parameterId = "TRAN_BODY_PTCLR"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.REVAL.tranPtclrBdy = BANCS.OUTPUT.parameterVal
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# 	Getting key for List File Name
	#------------------------------------------------------------------------------
	sv_s = "key|SELECT TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS') "
	sv_s = sv_s + " FROM DUAL"
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF( sv_d != 0 ) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.REVAL.key = BANCS.OUTPARAM.key
	CUST.REVAL.lstName = "REVAL" + CUST.REVAL.key + ".LST"
	PRINT(CUST.REVAL.lstName)
	
	#----------------------------------------------------------------------------
	# 	Get Home Currency
	#------------------------------------------------------------------------------
	PRINT(BANCS.STDIN.mySolId)
	sv_s = "homeCrncyCode|SELECT home_crncy_code"
	sv_s = sv_s + " FROM TBAADM.FCT "
	sv_s = sv_s + " WHERE sol_id = ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	sv_s = sv_s + " AND del_flg = 'N'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.REVAL.homeCrncyCode = BANCS.OUTPARAM.homeCrncyCode
		PRINT(CUST.REVAL.homeCrncyCode)
		
		
		
		#--------------------------------------------------------------------------------
		# 	Acct Selection Cursor
		#--------------------------------------------------------------------------------
		sv_s = "currCode,rateCode,pnlAccount,homecyAccount,foreigncyAccount|"
		sv_s = sv_s + " SELECT currency_code, "
		sv_s = sv_s + " rate_code,pnl_account,homecy_account,foreigncy_account  "
		sv_s = sv_s + " FROM CUSTOM.FX_REVAL "
		sv_s = sv_s + " WHERE bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		PRINT(sv_c)
		
		IF(sv_c != 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.REVAL.cursorNo = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.REVAL.cursorNo)
		sv_c = urhk_dbCursorFetch(CUST.REVAL.cursorNo)
		PRINT(sv_c)
		CUST.REVAL.tmpVar = "0"
		WHILE (sv_c == 0)
		#{
			CUST.REVAL.currcode = BANCS.OUTPARAM.currCode
			PRINT(CUST.REVAL.currcode)
			CUST.REVAL.pnlAccount = BANCS.OUTPARAM.pnlAccount
			PRINT(CUST.REVAL.pnlAccount)
			CUST.REVAL.rateCode = BANCS.OUTPARAM.rateCode
			PRINT(CUST.REVAL.rateCode)
			CUST.REVAL.homeCrncyPosAcct = BANCS.OUTPARAM.homecyAccount
			PRINT(CUST.REVAL.homeCrncyPosAcct)
			CUST.REVAL.foreignCrncyPosAcct = BANCS.OUTPARAM.foreigncyAccount
			PRINT(CUST.REVAL.foreignCrncyPosAcct)
			#--------------------------------------------------------------------------------
			#	Get the details of the table records in a Label line
			#--------------------------------------------------------------------------------
			
			CUST.REVAL.labelLine = CUST.REVAL.currcode
			CUST.REVAL.labelLine = CUST.REVAL.labelLine + "|" + CUST.REVAL.rateCode
			CUST.REVAL.labelLine = CUST.REVAL.labelLine + "|" + CUST.REVAL.pnlAccount
			CUST.REVAL.labelLine = CUST.REVAL.labelLine + "|" + CUST.REVAL.homeCrncyPosAcct
			CUST.REVAL.labelLine = CUST.REVAL.labelLine + "|" + CUST.REVAL.foreignCrncyPosAcct
			PRINT(CUST.REVAL.labelLine)
			
			#------------------------------------------------------------------
			# 	Get the details of Foreign account in repository
			#------------------------------------------------------------------
			#sv_u = urhk_getAcctDetailsInRepository(CUST.REVAL.foreignCrncyPosAcct)
			sv_s = "clrBal,unclrBal,acctCrncycode|"
			sv_s = sv_s + " SELECT GAM.clr_bal_amt,(gam.un_clr_bal_amt + gam.future_un_clr_bal_amt),acct_crncy_code"
			sv_s = sv_s + " FROM TBAADM.GAM"
			sv_s = sv_s + " WHERE GAM.foracid=?SVAR"
			sv_s = sv_s + " AND GAM.entity_cre_flg='Y'"
			sv_s = sv_s + " AND GAM.del_flg='N'"
			sv_s = sv_s + " AND GAM.bank_id=?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.REVAL.foreignCrncyPosAcct + "|" + BANCS.STDIN.contextBankId
			
			sv_d =  urhk_dbSelectWithBind(sv_s)
			IF (sv_d == 0) THEN
			#{
				sv_a = CDOUBLE(BANCS.OUTPARAM.clrBal)
				sv_a = sv_a + CDOUBLE(BANCS.OUTPARAM.unclrBal)
				PRINT(sv_a)
				CUST.REVAL.acctCrncycode=BANCS.OUTPARAM.acctCrncycode
				#}
			ELSE
				#{
				CUST.REVAL.errMsg = "Error WHILE selecting clr_bal_amt,un_clr_bal_amt from GAM table"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#------------------------------------------------------------------
			# 	Get Amounts in Home Currency
			#------------------------------------------------------------------
			BANCS.INPARAM.InputAmount = sv_a
			BANCS.INPARAM.FromCurrency = CUST.REVAL.acctCrncycode
			BANCS.INPARAM.ToCurrency = CUST.REVAL.homeCrncyCode
			BANCS.INPARAM.RateCode = CUST.REVAL.rateCode
			BANCS.INPARAM.Rate = 0
			sv_u = urhk_B2k_ConvertAmount("")
			
			#------------------------------------------------------------------
			# 	Add up to get Currency Position
			#------------------------------------------------------------------
			PRINT(BANCS.OUTPARAM.OutputAmount)
			CUST.REVAL.clrBalFrnCrncy = BANCS.OUTPARAM.OutputAmount
			PRINT(CUST.REVAL.clrBalFrnCrncy)
			
			#------------------------------------------------------------------
			# 	Get the details of Home Position account in repository
			#------------------------------------------------------------------
			#sv_u = urhk_getAcctDetailsInRepository(CUST.REVAL.homeCrncyPosAcct)
			
			
			sv_s = "clrBal,unclrBal|"
			sv_s = sv_s + " SELECT GAM.clr_bal_amt,(gam.un_clr_bal_amt + gam.future_un_clr_bal_amt) "
			sv_s = sv_s + " FROM TBAADM.GAM"
			sv_s = sv_s + " WHERE GAM.foracid=?SVAR"
			sv_s = sv_s + " AND GAM.entity_cre_flg='Y'"
			sv_s = sv_s + " AND GAM.del_flg='N'"
			sv_s = sv_s + " AND GAM.bank_id=?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.REVAL.homeCrncyPosAcct + "|" + BANCS.STDIN.contextBankId
			
			sv_d =  urhk_dbSelectWithBind(sv_s)
			IF (sv_d == 0) THEN
			#{
				CUST.REVAL.clrBalHmeCrncy = CDOUBLE(BANCS.OUTPARAM.clrBal) + CDOUBLE(BANCS.OUTPARAM.unclrBal)
				PRINT(CUST.REVAL.clrBalHmeCrncy)
				#}
			ELSE
				#{
				CUST.REVAL.errMsg = "Error WHILE selecting clr_bal_amt,un_clr_bal_amt from GAM table"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#------------------------------------------------------------------
			# Get the net amount by subtracting Home currency
			# position from the Fx Currency Position
			#------------------------------------------------------------------
			CUST.REVAL.netAmount = (-1*CDOUBLE(CUST.REVAL.clrBalFrnCrncy)) - CDOUBLE(CUST.REVAL.clrBalHmeCrncy)
			PRINT(CUST.REVAL.netAmount)
			CUST.REVAL.labelLine = CUST.REVAL.labelLine + "|" + FORMAT$(CDOUBLE(CUST.REVAL.netAmount), "%f")
			PRINT(CUST.REVAL.labelLine)
			
			IF ( CDOUBLE(CUST.REVAL.netAmount) != 0 ) THEN
			#{
				PRINT(CUST.REVAL.homeCrncyPosAcct)
				PRINT(CUST.REVAL.pnlAccount)
				
				
				PRINT(CUST.REVAL.tmpVar)
				PRINT(CUST.REVAL.netAmount)
				PRINT(CUST.REVAL.pnlAccount)
				PRINT(CUST.REVAL.homeCrncyPosAcct)
				
				
				GOTO TRAN
				
				
				sv_a = "tranDtl.partTranDetailLL.<rec_" + CUST.REVAL.tmpVar + ">."
				sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+CUST.REVAL.tmpVar)
				sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|"+CUST.REVAL.crDr1)
				sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.REVAL.homeCrncyPosAcct)
				sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.REVAL.netAmount+"|"+ CUST.REVAL.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|"+CUST.REVAL.tranPtclrBdy)
				sv_u = urhk_SetUrhkInp(sv_a + "tranRmks|"+CUST.REVAL.tranRmksBdy)
				sv_u = urhk_SetUrhkInp(sv_a + "refNum| ")
				sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|"+CUST.REVAL.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.REVAL.netAmount+"|"+CUST.REVAL.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.REVAL.rateCode)
				
				CUST.REVAL.tmpVar = CINT(CUST.REVAL.tmpVar)+1
				sv_a = "tranDtl.partTranDetailLL.<rec_" + CUST.REVAL.tmpVar + ">."
				sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+CUST.REVAL.tmpVar)
				sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|" +CUST.REVAL.crDr2)
				sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.REVAL.pnlAccount)
				sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.REVAL.netAmount+"|"+ CUST.REVAL.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|"+CUST.REVAL.tranPtclrBdy)
				sv_u = urhk_SetUrhkInp(sv_a + "tranRmks|"+CUST.REVAL.tranRmksBdy)
				sv_u = urhk_SetUrhkInp(sv_a + "refNum| ")
				sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|"+CUST.REVAL.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.REVAL.netAmount+"|"+CUST.REVAL.homeCrncyCode)
				sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
				sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.REVAL.rateCode)
				CUST.REVAL.tmpVar = CINT(CUST.REVAL.tmpVar) + 1
				
				
				TRAN:
					
					
					
					# ----------------------------------------------------------
					# Create Transaction between PnL account and Home Cy Account
					# ----------------------------------------------------------
					
					MTT.PartTranDetails.Account = CUST.REVAL.homeCrncyPosAcct
					MTT.PartTranDetails.RefAmount = CUST.REVAL.netAmount
					MTT.PartTranDetails.RefCurrency = CUST.REVAL.homeCrncyCode
					MTT.PartTranDetails.ValueDate = "0"
					MTT.PartTranDetails.Consolidate = "N"
					MTT.PartTranDetails.Remarks = "Reval"
					MTT.PartTranDetails.Particulars = "Revaluation Tran"
					MTT.PartTranDetails.TranIdentifier = "Reval"
					MTT.PartTranDetails.PTranBusinessType = " "
					
					PRINT(MTT.PartTranDetails.RefAmount)
					PRINT(MTT.PartTranDetails.Account)
					PRINT(MTT.PartTranDetails.Particulars)
					
					sv_s = urhk_MTTS_DefinePartTran("Office1")
					PRINT(sv_s)
					
					IF (sv_s != 0 ) THEN
					#{
						sv_r = urhk_MTTS_ReportErrorCondition("")
						PRINT(MTT.Error.Description)
						CUST.REVAL.errMsg = MTT.Error.Description
						BANCS.OUTPUT.successOrFailure="F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					sv_u =CDOUBLE(CUST.REVAL.netAmount)
					PRINT(sv_u)
					MTT.PartTranDetails.RefAmount = 0 - sv_u
					PRINT(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.Account = CUST.REVAL.pnlAccount
					PRINT(MTT.PartTranDetails.Account)
					MTT.PartTranDetails.RefAmount = 0 - sv_u
					PRINT(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.RefCurrency = CUST.REVAL.homeCrncyCode
					MTT.PartTranDetails.ValueDate = "0"
					MTT.PartTranDetails.Consolidate = "N"
					MTT.PartTranDetails.Particulars = "Revaluation Tran"
					MTT.PartTranDetails.TranIdentifier = "Reval"
					MTT.PartTranDetails.PTranBusinessType = " "
					MTT.PartTranDetails.Remarks = "Reval"
					
					sv_s = urhk_MTTS_DefinePartTran("Office2")
					PRINT(sv_s)
					
					IF (sv_s != 0 ) THEN
					#{
						sv_r = urhk_MTTS_ReportErrorCondition("")
						PRINT(MTT.Error.Description)
						CUST.REVAL.errMsg = MTT.Error.Description
						BANCS.OUTPUT.successOrFailure="F"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					
					
					
					
					
				#}
				ENDIF
				#print(CUST.REVAL.labelLine)
				#print(CUST.REVAL.lstName)
				
				
				#-------------------------------------------------------------------------
				# 	Storing the Label line in a List file
				#-------------------------------------------------------------------------
				
				sv_v = SYSTEM("echo '"+ CUST.REVAL.labelLine +"' >>" + CUST.REVAL.lstName)
				#sv_v = system("echo '"+ CUST.REVAL.labelLine +"' >>CUST.REVAL.lstName")
				PRINT(sv_v)
				sv_c = urhk_dbCursorFetch(CUST.REVAL.cursorNo)
				PRINT(sv_c)
			#}
			DO
			sv_x = urhk_dbCursorClose(CUST.REVAL.cursorNo)
			PRINT(sv_x)
			sv_s = urhk_MTTS_EndDefinition("")
			PRINT(sv_s)
			IF (sv_s != 0) THEN
			#{
				PRINT(MTT.Error.Description)
				sv_r = urhk_MTTS_ReportErrorCondition("")
				BANCS.OUTPUT.fatalErrorFlg="Y"
				#}
			ELSE
				#{
				
#				PRINT(BANCS.OUTPARAM.MTTTranId)
			#}
			ENDIF
			
			
		ENDOFSCRIPT:
			IF(CUST.REVAL.errMsg != "") THEN
			#{
				sv_u = SYSTEM("echo '"+CUST.REVAL.errMsg+"' >>REVAL.log")
			#}
			ENDIF
			
			#-------------------------------------------------------------------------------------------------------
			# Deleting the Class and Repository
			#-------------------------------------------------------------------------------------------------------
			IF (CLASSEXISTS("CUST","REVAL") == 1) THEN
			#{
				DELETECLASS("CUST","REVAL")
			#}
			ENDIF
			
			IF (REPEXISTS("CUST") == 1) THEN
			#{
				DELETEREP("CUST")
			#}
			ENDIF
			
			
			#TRACE OFF
			EXITSCRIPT
	END-->
	
