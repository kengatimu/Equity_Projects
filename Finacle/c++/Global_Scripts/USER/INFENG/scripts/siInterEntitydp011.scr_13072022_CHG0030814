##########################################################################################
# Source Name           : siInterEntitydp011.scr
# Date                  : 25-Apr-2013
# Description           : This script is called from SRV's to pass custom data to front end in HSSIM menu
#			: in Modify and Verify mode.
# Author                : Priyanka T02
# Modification History  :
# <Serial No.>  <Date>        <Author Name>             <Description>
# ------------  -----------   -----------------         --------------
#      1        25-Apr-2013    Priyanka T02               Base Version
#      2        06-Sep-2013    Bharath 			Modified for new porting items
###########################################################################################
<--START
CHECKSUM="c14afa2a29eabe1f9c736c0c5efd393f1dfee663e66957a6e656dc4617f9a061"
	# Script body goes here
	TRACE ON
	
	#---------------------------------------------------------------------
	#Check whether CUST Repository exists else create it
	#---------------------------------------------------------------------
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	#---------------------------------------------------------------------
	#Check whether CSIIET Class exists else create it
	#---------------------------------------------------------------------
	
	IF(CLASSEXISTS("CUST","CSIIET") == 0) THEN
	#{
		CREATECLASS ("CUST","CSIIET",5)
	#}
	ENDIF
	
	#---------------------------------------------------------------------
	#Initialize the variables
	#---------------------------------------------------------------------
	CUST.CSIIET.siSrlNum = ""
	CUST.CSIIET.siInterEntityFlg = ""
	CUST.CSIIET.targerEntity = ""
	CUST.CSIIET.targetEntityAcctId = ""
	CUST.CSIIET.entityCreFlg = ""
	CUST.CSIIET.bankId = BANCS.STDIN.contextBankId
	
	IF (BANCS.STDIN.contextBankId =="54") THEN
	#{
		IF (BANCS.STDIN.userWorkClass !="201") THEN
		#{
			sv_u = urhk_SRV_SetErr("Insufficent Workclass 201 for Verification......")
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------
	#Obtaining the value of si srl num
	#---------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("siHeader.siSrlNum")
	PRINT(sv_u)
	IF(sv_u != 0)THEN
	#{
		CUST.CSIIET.successOrFailure = "F"
		print("Couldn fetch siSrlNum")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.CSIIET.siSrlNum = BANCS.OUTPARAM.srvValue
		print(CUST.CSIIET.siSrlNum)
	#}
	ENDIF
	
	#----------------------------------
	#Fetch entity cre flg from table
	#----------------------------------
	BANCS.INPARAM.BINDVARS = CUST.CSIIET.siSrlNum + "|" + CUST.CSIIET.bankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "entityCreFlg|SELECT ENTITY_CRE_FLG "
	sv_s = sv_s + "FROM CUSTOM.IESID "
	sv_s = sv_s + "WHERE SI_SRL_NUM = ?SVAR "
	sv_s = sv_s + "AND BANK_ID = ?SVAR"
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CSIIET.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		print(CUST.CSIIET.entityCreFlg)
		#}
	ELSE
		#{
		print("Could not fetch data from table")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------
	#If entity cre flg is 'Y' then fetch custom data from mod table IESID_MOD
	#otherwise from main table IESID.
	#-------------------------------------------------------------------------
	IF(CUST.CSIIET.entityCreFlg == "Y") THEN
	#{
		#----------------------------------
		#Fetch custom data from mod table
		#----------------------------------
		BANCS.INPARAM.BINDVARS = CUST.CSIIET.siSrlNum + "|" + CUST.CSIIET.bankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_s = "siInterEntityFlg,targetEntity,targetEntityId|SELECT INTER_ENTITY_SI_FLG,TARGET_ENTITY,TARGET_ENTITY_ACCOUNT_ID "
		sv_s = sv_s + "FROM CUSTOM.IESID "
		sv_s = sv_s + "WHERE SI_SRL_NUM = ?SVAR "
		sv_s = sv_s + "AND BANK_ID = ?SVAR"
		print(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CSIIET.siInterEntityFlg = BANCS.OUTPARAM.siInterEntityFlg
			CUST.CSIIET.targerEntity = BANCS.OUTPARAM.targetEntity
			CUST.CSIIET.targetEntityId = BANCS.OUTPARAM.targetEntityId
			print(CUST.CSIIET.siInterEntityFlg)
			print(CUST.CSIIET.targerEntity)
			print(CUST.CSIIET.targetEntityId)
			#}
		ELSE
			#{
			print("Could not fetch data from table")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------
		#Fetch custom data from mod table
		#----------------------------------
		BANCS.INPARAM.BINDVARS = CUST.CSIIET.siSrlNum + "|" + CUST.CSIIET.bankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_s = "siInterEntityFlg,targetEntity,targetEntityId|SELECT INTER_ENTITY_SI_FLG,TARGET_ENTITY,TARGET_ENTITY_ACCOUNT_ID "
		sv_s = sv_s + "FROM CUSTOM.IESID_MOD "
		sv_s = sv_s + "WHERE SI_SRL_NUM = ?SVAR "
		sv_s = sv_s + "AND BANK_ID = ?SVAR"
		print(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CSIIET.siInterEntityFlg = BANCS.OUTPARAM.siInterEntityFlg
			CUST.CSIIET.targerEntity = BANCS.OUTPARAM.targetEntity
			CUST.CSIIET.targetEntityId = BANCS.OUTPARAM.targetEntityId
			print(CUST.CSIIET.siInterEntityFlg)
			print(CUST.CSIIET.targerEntity)
			print(CUST.CSIIET.targetEntityId)
		#}
		ENDIF
		
		#}
	ELSE
		#{
		
		#----------------------------------
		#Fetch custom data from mod table
		#----------------------------------
		BANCS.INPARAM.BINDVARS = CUST.CSIIET.siSrlNum + "|" + CUST.CSIIET.bankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_s = "siInterEntityFlg,targetEntity,targetEntityId|SELECT INTER_ENTITY_SI_FLG,TARGET_ENTITY,TARGET_ENTITY_ACCOUNT_ID "
		sv_s = sv_s + "FROM CUSTOM.IESID "
		sv_s = sv_s + "WHERE SI_SRL_NUM = ?SVAR "
		sv_s = sv_s + "AND BANK_ID = ?SVAR"
		print(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CSIIET.siInterEntityFlg = BANCS.OUTPARAM.siInterEntityFlg
			CUST.CSIIET.targerEntity = BANCS.OUTPARAM.targetEntity
			CUST.CSIIET.targetEntityId = BANCS.OUTPARAM.targetEntityId
			print(CUST.CSIIET.siInterEntityFlg)
			print(CUST.CSIIET.targerEntity)
			print(CUST.CSIIET.targetEntityId)
			#}
		ELSE
			#{
			print("Could not fetch data from table")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	#}
	ENDIF
	
	ONS.CUSTOM.custDataOut = "~issimdtl|" + CUST.CSIIET.siInterEntityFlg + "|" + CUST.CSIIET.targerEntity + "|" + CUST.CSIIET.targetEntityId
	print(ONS.CUSTOM.custDataOut)
	
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
END-->
