<--START
CHECKSUM="7c03522d63f9271efb4c2275b235f28b4af7b9f731a7b91a587bef8e9036e2fe"
	TRACE ON
	#---------------------------------------------------------------------------------
	# CREATING NEW REPOSITORY AND CLASS
	#---------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CHQB") == 0) THEN
	#{
		CREATECLASS("CUST", "CHQB", 5)
	#}
	ENDIF
	
	CUST.CHQB.requestId     = BANCS.INPUT.requestId
	
	sv_s = "foracid"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT foracid"
	sv_s = sv_s + " FROM CUSTOM.CUSTOM_CBR "
	sv_s = sv_s + " WHERE req_id = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	sv_s = sv_s + " AND del_flg != 'Y'"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CHQB.requestId +"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0 ) THEN
	#{
		CUST.CHQB.acctnum = BANCS.OUTPARAM.foracid
		sv_z = urhk_SetOrbOut("acctnum|"+CUST.CHQB.acctnum)
		print(sv_z)
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("Error_01|ERROR:^A Database error has occured. Please contact your DBA.")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	ENDOFSCRIPT :
		TRACE OFF
		EXITSCRIPT
END-->
