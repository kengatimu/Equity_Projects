#-------------------------------------------------------------------------------------    
#    Name			    : oldtonew.scr
#    Description        : This script will be called ttum_eft.mrt.for the given old  acct number and sol id it
#					    : selects the new acct number for it form old_acct_map and sends to the mrt.
#    Date            	: 15-01-2013
#    Author          	: Rajavel
#    Input           	: BANCS.INPUT.lv_foracid , BANCS.INPUT.lv_solid
#    Output			    : BANCS.OUTPUT.lv_for_acd , BANCS.OUTPUT.lv_userId
#    Called Script	 	: NA
#    Calling Script	 	: NA
#    Menu Option		: NA
#    Srl. No	Date		Author		 Description.
#    -------	-------		------		----------------
#     1.0		15-01-2013	Rajavel	     Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="f9d06df9d8e93dc1402b9c7924a792ec72c65f483f9aca30fe83d088bc089c2b"
	TRACE ON
	
	sv_s = "lv_for_acd|"
	sv_s = sv_s + "SELECT foracid "
	sv_s = sv_s + "FROM CUSTOM.OLD_ACCT_MAP "
	sv_s = sv_s + "WHERE old_num = ?SVAR "
	sv_s = sv_s + "AND sol_id =  ?SVAR "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.lv_foracid + "|" + BANCS.INPUT.lv_solid + "|" + BANCS.STDIN.contextBankId
	print(sv_s)
	sv_u = urhk_dbselectWithBind(sv_s)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		BANCS.OUTPUT.lv_for_acd = TRIM(BANCS.OUTPARAM.lv_for_acd)
		PRINT(BANCS.OUTPUT.lv_for_acd)
		BANCS.OUTPUT.lv_userId = BANCS.STDIN.userId
		PRINT(BANCS.OUTPUT.lv_userId)
		#}
	ELSE
		#{
		BANCS.OUTPUT.lv_for_acd = " "
	#}
	ENDIF
	#PRINT(BANCS.OUTPUT.lv_for_acd)
	#PRINT(BANCS.OUTPUT.lv_userId)
	
	TRACE OFF
	EXITSCRIPT
END-->
