#----------------------------------------------------------------------------------------------------------
# Filename              :       InwardChqReturn_main.scr
# Description           :       This is the main script that gets triggered when postInwardClgCheque is called
# Input                 :       Request XML
# Output                :       Response XML
# Called Script         :       None
# Calling Script        :       Common_CreateRepos.scr, InwardChqReturn_FetchInputDetails.scr, 
#				InwardChqReturn_ValidateInputDetails.scr, InwardChqReturn_FetchAccountDetails.scr,
#				InwardChqReturn_SendResponse.scr,Common_ErrorExit.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           15-06-2013      	   Anik Soni         Original Version         1.0
#-----------------------------------------------------------------------------------------------------------
<--start
trace on

#	sv_l = urhk_B2k_printrepos("BANCS")
#	print(sv_l)

	#-------------------------------------------------------------------------------
	# Calling create repository script
	#-------------------------------------------------------------------------------
	CALL("Common_Interface_CreateRepos.scr")
	CUST.INTERFACE.successOrFailure = "S"
	CUST.INTERFACE.srvErrFlg = "N"
	CUST.INTERFACE.errorCode = ""
	
	#-------------------------------------------------------------------------------
	# Getting Channel Information
	#-------------------------------------------------------------------------------
	
	lv_a = urhk_GetChannelInfo("")
	IF (FIELDEXISTS(BANCS.OUTPARAM.DccId)) THEN
	#{
	        CUST.INTERFACE.ChannelId = BANCS.OUTPARAM.DccId
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	# Defaulting some Input variables for the Interface
	#-------------------------------------------------------------------------------
	
	CUST.INTERFACE.TODFlag = "N"
	CUST.INTERFACE.ErrorFlg = "N"
	CUST.INTERFACE.TransactionType = "T"
	CUST.INTERFACE.TransactionSubType = "BI"
	CUST.INTERFACE.DrVNum = ""
	CUST.INTERFACE.CrVNum = ""
	CUST.INTERFACE.InstrType = "CHQ"
	CUST.INTERFACE.drEventId = ""
	CUST.INTERFACE.crEventId = ""
	CUST.INTERFACE.TranDate1 = ""
	CUST.INTERFACE.bankCode = ""
	CUST.INTERFACE.solId = ""
	CUST.INTERFACE.BODDate = ""
	CUST.INTERFACE.PostSrlNum = ""
  	CUST.INTERFACE.TranRefNum = "9090"
	CUST.INTERFACE.errorDesc = ""	
	#-------------------------------------------------------------------------------
	# Fetching Input Fields from FI
	#-------------------------------------------------------------------------------
	CALL("InwardChqReturn_FetchInputDetails.scr")
	
	#-------------------------------------------------------------------------------
	# Checking if both the Part Transactions contain same Dr/Cr Indicator
	#-------------------------------------------------------------------------------
	IF(("CUST").("INTERFACE").("ICR_REQ.ptTrDtl.<rec_0>.DrCrI") == "D") THEN
	#{
		IF(("CUST").("INTERFACE").("ICR_REQ.ptTrDtl.<rec_1>.DrCrI") == "D") THEN
		#{	
			CUST.INTERFACE.errorCode = "ERR069"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	IF(("CUST").("INTERFACE").("ICR_REQ.ptTrDtl.<rec_0>.DrCrI") == "C") THEN
	#{
		IF(("CUST").("INTERFACE").("ICR_REQ.ptTrDtl.<rec_1>.DrCrI") == "C") THEN
		#{	
			CUST.INTERFACE.errorCode = "ERR070"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	# Validating Input Fields
	#-------------------------------------------------------------------------------
	CALL("InwardChqReturn_ValidateInputDetails.scr")
	
	#-------------------------------------------------------------------------------
	# Validating Input Fields
	#-------------------------------------------------------------------------------
	#CALL("InwardChqReturn_ValidateChqDetails.scr")
	
	
	#-------------------------------------------------------------------------------
	# Posting the Cheque details
	#-------------------------------------------------------------------------------
	CALL("InwardChqReturn_PostChqDetails.scr")
	
	#-------------------------------------------------------------------------------
	# Send Response
	#-------------------------------------------------------------------------------
	
	FINISH:
	
	CALL("InwardChqReturn_SendResponse.scr")
	
	SKIPFINISH:
	IF(CUST.INTERFACE.successOrFailure == "E") THEN
	#{
	        sv_c = CUST.INTERFACE.errorCode + "|" + CUST.INTERFACE.errorDesc	
		sv_u = urhk_SetOrbWarning(sv_c)
	#}
	ENDIF

trace off
end-->
