<--START
CHECKSUM="f538264a9c0e4fb9204d6ae97e00351d110724a02aae094d113c64b70fde1c28"
	TRACE ON
	sv_a = urhk_b2k_PrintRepos("BANCS")
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	#Authorization Matrix Id Obtained from frontend
	sv_s = urhk_SRV_GetVal("authMatrixCrit.matrixId")
	CUST.DATA.matrixId = BANCS.OUTPARAM.srvValue
	PRINT(BANCS.OUTPARAM.srvValue)
	
	#Deriving the EXCP CODE
	BANCS.INPARAM.BINDVARS = ""
	sv_s = "maxCode|SELECT MAX(EXCP_CODE) FROM CUSTOM.CUST_AUTH_MATRIX_ID"
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	CUST.DATA.maxCode = BANCS.OUTPARAM.maxCode
	PRINT(CUST.DATA.maxCode)
	sv_k = LTRIM(CUST.DATA.maxCode,'A')
	sv_k = CINT(sv_k) + 1
	PRINT(sv_k)
	sv_k = FORMAT$(sv_k,"%d")
	PRINT(sv_k)
	sv_k = LPAD(sv_k,2,'0')
	PRINT(sv_k)
	CUST.DATA.excp_code = "A" + sv_k
	PRINT(CUST.DATA.excp_code)
	
	#Insert into EXT table
	BANCS.INPARAM.BINDVARS = CUST.DATA.excp_code + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.matrixId + "|" + BANCS.STDIN.contextBankId
	IF((BANCS.STDIN.contextBankId == 50) OR (BANCS.STDIN.contextBankId == 54)) THEN
	#{
		sv_f = "INSERT INTO TBAADM.EXT VALUES(?SVAR,'N','X','150','150','0',?SVAR,sysdate,?SVAR,sysdate,'N','','0',?SVAR,?SVAR,'','')"
		#}
	ELSE
		#{
		sv_f = "INSERT INTO TBAADM.EXT VALUES(?SVAR,'N','X','110','110','0',?SVAR,sysdate,?SVAR,sysdate,'N','','0',?SVAR,?SVAR,'','')"
	#}
	ENDIF
	PRINT(sv_f)
	
	sv_r = urhk_dbSqlWithBind(sv_f)
	PRINT(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		#sv_r = urhk_dbSqlWithBind("Commit")
		PRINT(sv_r)
		
		#Insert into MMSG table
		CUST.DATA.msg_Id = "EXT" + BANCS.STDIN.contextBankId + CUST.DATA.excp_code
		PRINT(CUST.DATA.msg_Id)
		BANCS.INPARAM.BINDVARS = CUST.DATA.msg_Id
		sv_f = "INSERT INTO TBAADM.MMSG VALUES(?SVAR,'N','ABE EXCEPTION','0','EXT','EXCEPTIONS','','','','','0')"
		PRINT(sv_f)
		
		sv_r = urhk_dbSqlWithBind(sv_f)
		PRINT(sv_r)
		
		IF(sv_r == 0) THEN
		#{
			#sv_r = urhk_dbSqlWithBind("Commit")
			PRINT(sv_r)
		#}
		ENDIF
	#}
	ENDIF
	
	#Insert into CUSTOM.C_CAM table
	BANCS.INPARAM.BINDVARS = CUST.DATA.excp_code + "|" + CUST.DATA.matrixId + "|" + BANCS.STDIN.contextBankId
	#BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.matrixId + "|" +
	
	sv_f = "INSERT INTO CUSTOM.C_CAM VALUES(?SVAR,?SVAR,?SVAR)"
	PRINT(sv_f)
	
	sv_r = urhk_dbSqlWithBind(sv_f)
	PRINT(sv_r)
	IF(sv_r != 0)THEN
	#{
		PRINT ("code not added")
	#}
	ENDIF
	
	
	TRACE OFF
END-->
