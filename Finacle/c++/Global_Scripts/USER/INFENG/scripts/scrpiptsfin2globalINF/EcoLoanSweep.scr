<--START
TRACE ON

	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	sv_r = REPEXISTS("MTT")
	IF (sv_r == 0) THEN
		CREATEREP("MTT")
	ENDIF

	sv_r = CLASSEXISTS("MTT","TranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","TranDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","PartTranDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
	print(sv_r)
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","PartTranDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","InputDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","InputDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","LAAddnlDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","LAAddnlDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","Error")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","Error",5)
	ENDIF

	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
		CREATEREP("BANCS")
	ENDIF

	sv_r = CLASSEXISTS("BANCS","INPARAM")
	IF (sv_r == 0) THEN
		CREATECLASS("BANCS","INPARAM",5)
	ENDIF

	IF (REPEXISTS("CUST")==0)THEN
		CREATEREP("CUST")
	ENDIF
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
		CREATECLASS("CUST","CPARAM",5)
	ENDIF

	IF(CLASSEXISTS("CUST","LADISB")==0)then
		CREATECLASS("CUST","LADISB",5)
	ENDIF
	#vp
	CUST.LADISB.loanCifId = ""
	CUST.LADISB.loanRefNum = ""
	CUST.LADISB.frmPartyName = ""
	CUST.LADISB.loanAmt = ""
	CUST.LADISB.partyName = ""
	CUST.LADISB.patyAcctNum = ""
	CUST.LADISB.productCode = "" 
	CUST.LADISB.tranid = ""
	#vp

	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="Y"
	BANCS.INPARAM.RestrictModifyInd="FOURTH_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"

	sv_r = urhk_MTTS_Initialize("")
	print(sv_r)
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "CI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
	MTT.TranDetails.Remarks = "Echo Loan Sweep"

	sv_a = urhk_MTTS_PopulateInputDetails("")
	print(sv_a)

	IF (BANCS.STDIN.contextBankId !="54")THEN
	#{
		sv_u = urhk_SRV_GetVal("acctDisburseTranLA.transferAcctNum.foracid")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.LADISB.operAcct = BANCS.OUTPARAM.srvValue
			PRINT(CUST.LADISB.operAcct)
	        #}
		ENDIF
		sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
		if (sv_a == 0) THEN
                #{
			CUST.LADISB.loanAcctId = BANCS.OUTPARAM.srvValue
			print(CUST.LADISB.loanAcctId)
		#}
		endif
		sv_a = urhk_SRV_GetVal("acctDisburseTranLA.schmCode.schmCode")
		if (sv_a == 0) THEN
                #{
			CUST.LADISB.laSchmCode=BANCS.OUTPARAM.srvValue
			print(CUST.LADISB.laSchmCode)
		#}
		endif
		sv_a = urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
		if (sv_a == 0) THEN
                #{
			CUST.LADISB.disbursAmt  = BANCS.OUTPARAM.srvValue
			print(CUST.LADISB.disbursAmt)
		#}
		endif

	#}
	ELSE
	#{
		print(CUST.LADISB.loanAcctId)
		print(CUST.LADISB.laSchmCode)
		print(BANCS.STDIN.contextBankId)
		print(CUST.LADISB.operAcct)
		print(CUST.LADISB.disbursAmt)
	#}
	ENDIF

	sv_s = "FreeCode6,freetext4,acctname,drforacid,cif_id,nat_id_card_num,freetext6 |"
	sv_s = sv_s + " SELECT d.free_code_6,FREE_TEXT_4,c.acct_name,c.foracid,n.cif_id,n.nat_id_card_num,d.free_text_6 "
	sv_s = sv_s + " FROM TBAADM.GAM a, TBAADM.LAM b, TBAADM.GAM c, TBAADM.GAC d ,TBAADM.CMG n "
	sv_s = sv_s + " WHERE a.acid = b.acid"
	sv_s = sv_s + " AND b.op_acid = c.acid"
	sv_s = sv_s + " AND d.acid = b.acid"
	sv_s = sv_s + " AND a.entity_cre_flg ='Y'"
	sv_s = sv_s + " AND a.del_flg = 'N'"
	sv_s = sv_s + " AND a.foracid = ?SVAR "
	sv_s = sv_s + " AND a.bank_id = b.bank_id"
	sv_s = sv_s + " AND b.bank_id = c.bank_id"
	sv_s = sv_s + " AND c.bank_id = d.bank_id"
	sv_s = sv_s + "  AND c.cif_id = n.cif_id "
	sv_s = sv_s + " AND n.bank_id = c.bank_id AND n.bank_id = d.bank_id AND n.bank_id = a.bank_id AND n.bank_id = b.bank_id "
	sv_s = sv_s + " AND d.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.LADISB.loanAcctId 	+ "|" +BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	sv_d=urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d != 0) THEN
	#{
		CUST.LADISB.errMsg 	= "Error in finding free code6 value"
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.LADISB.freeCode6= BANCS.OUTPARAM.FreeCode6
		print(CUST.LADISB.freeCode6) 
		CUST.LADISB.insuAmt=BANCS.OUTPARAM.freetext4
		print(CUST.LADISB.insuAmt)
		CUST.LADISB.acctname=BANCS.OUTPARAM.acctname
		print(CUST.LADISB.acctname)
		CUST.LADISB.operAcct=BANCS.OUTPARAM.drforacid
		print(CUST.LADISB.operAcct)
		CUST.LADISB.cif_id=BANCS.OUTPARAM.cif_id
		print(CUST.LADISB.cif_id)
		CUST.LADISB.nat_id_card_num=BANCS.OUTPARAM.nat_id_card_num
		print(CUST.LADISB.nat_id_card_num)
		CUST.LADISB.freetext6=BANCS.OUTPARAM.freetext6
		print(CUST.LADISB.freetext6)

		IF (BANCS.STDIN.contextBankId =="55")THEN
		#{
			sv_b = urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
			CUST.LADISB.insuAmt  = BANCS.OUTPARAM.srvValue
			sv_a=getPosition(CUST.LADISB.insuAmt,"|")
			sv_b=strlen(CUST.LADISB.insuAmt)
			CUST.LADISB.insuAmt   =LEFT$(CUST.LADISB.insuAmt,sv_a-1)
			print(CUST.LADISB.insuAmt)
		#}
		ELSE
		#{
			print(CUST.LADISB.insuAmt)
		#}
		ENDIF
				
		##vp
		CUST.LADISB.productCode = CUST.LADISB.freeCode6
		CUST.LADISB.loanCifId = CUST.LADISB.cif_id
		CUST.LADISB.loanRefNum = CUST.LADISB.freetext6 
		CUST.LADISB.frmPartyName = CUST.LADISB.acctname
		CUST.LADISB.loanAmt = CUST.LADISB.insuAmt 
		##vp

		
	#}
	ENDIF
	
	IF (CUST.LADISB.freeCode6 !="") THEN
	#{
		sv_s = "codename,longrefcode|"
		sv_s = sv_s + " SELECT RCT.ref_desc,LONG_REF_CODE "
		sv_s = sv_s + " FROM TBAADM.RCT"
		sv_s = sv_s + " WHERE RCT.ref_code= ?SVAR" 
		sv_s = sv_s + " AND RCT.ref_rec_type='AG'"
		sv_s = sv_s + " AND RCT.bank_id= ?SVAR" 
		BANCS.INPARAM.BINDVARS =  CUST.LADISB.freeCode6 + "|" + BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			CUST.LADISB.errMsg 	= "Error in finding ref_desc"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.LADISB.codeName= BANCS.OUTPARAM.codename
			print(CUST.LADISB.codeName)

			IF (BANCS.OUTPARAM.longrefcode =="") THEN

				CUST.LADISB.errMsg 	= "No Account to sweep"
				GOTO ENDOFSCRIPT

			ELSE

				CUST.CPARAM.lpFreeCode=BANCS.OUTPARAM.longrefcode
				print(CUST.CPARAM.lpFreeCode)

			ENDIF
		#}
		ENDIF
		##vp
			CUST.LADISB.partyName = CUST.LADISB.codeName 
			CUST.LADISB.patyAcctNum = CUST.CPARAM.lpFreeCode
		##vp
	#}	
	ENDIF

IF((CUST.LADISB.insuAmt > 0)  and (CUST.LADISB.operAcct!="") and (CUST.CPARAM.lpFreeCode!= ""))THEN
	sv_u = urhk_MTTS_DefineTransaction("EcosystemTran")

#CustomerDebit
		MTT.PartTranDetails.Account 	= CUST.LADISB.operAcct 
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.RateCode 	="MEAN"
		MTT.PartTranDetails.Rate 	= "0"
		MTT.PartTranDetails.ValueDateDiff = "0"
		MTT.PartTranDetails.Particulars = "Ecosystem loan sweep to " + CUST.LADISB.codeName 
		MTT.PartTranDetails.Particulars2 = CUST.LADISB.loanAcctId 
		MTT.PartTranDetails.RefAmount = -(cdouble(CUST.LADISB.insuAmt)) 
		MTT.PartTranDetails.Amount   = -(cdouble(CUST.LADISB.insuAmt))
		MTT.PartTranDetails.Remarks = "Dr.for Ecosystem Loan" 
		MTT.PartTranDetails.Refnum = CUST.LADISB.freetext6
		MTT.PartTranDetails.IgnoreExcp = "I"
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.TranIdentifier = "EcosystemTran" 
		sv_r = urhk_MTTS_definePartTran("CustDr")
		print(sv_r)
		IF(fieldexists(MTT.Error.Description)) THEN
			print(MTT.Error.Description)
			CUST.LADISB.MTTErrDesc = MTT.Error.Description
		ENDIF
#Ecosystem
		MTT.PartTranDetails.Account 	= CUST.CPARAM.lpFreeCode
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.RateCode 	="MEAN"
		MTT.PartTranDetails.Rate 	= "0"
		MTT.PartTranDetails.ValueDateDiff = "0"
		MTT.PartTranDetails.Particulars = "Cr from EazzyStock RefNum " + CUST.LADISB.freetext6 + "/" + CUST.LADISB.acctname 
		MTT.PartTranDetails.Particulars2 = CUST.LADISB.loanAcctId
                MTT.PartTranDetails.RefAmount = (cdouble(CUST.LADISB.insuAmt))  
		MTT.PartTranDetails.Remarks = "Cr from:" + CUST.LADISB.operAcct 
		MTT.PartTranDetails.Refnum = CUST.LADISB.freetext6
		MTT.PartTranDetails.IgnoreExcp = "I"
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.TranIdentifier = "EcosystemTran" 
		sv_r = urhk_MTTS_definePartTran("CustDr")
		print(sv_r)

		IF(fieldexists(MTT.Error.Description)) THEN
			print(MTT.Error.Description)
			CUST.LADISB.MTTErrDesc = MTT.Error.Description
		ENDIF

		ELSE
		sv_r = urhk_MTTS_EndDefinition("")
		sv_r = urhk_MTTS_Close("")
		print(sv_r)
		EXITSCRIPT

	ENDIF
	sv_r = urhk_MTTS_EndDefinition("")
	IF(fieldexists(BANCS.OUTPARAM.MTTTranId)) THEN
	
		print(BANCS.OUTPARAM.MTTTranId)
		CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
		print(CUST.LADISB.tranid)

	ENDIF

	sv_r = urhk_MTTS_Close("")
	print(sv_r)
	IF(fieldexists(BANCS.OUTPARAM.MTTTranId)) THEN
	
		print(BANCS.OUTPARAM.MTTTranId)
		CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
		print(CUST.LADISB.tranid)
		##Vino Palani
		if(CUST.LADISB.tranid!="")then
			print("chk")
		print(CUST.LADISB.loanCifId)
		print(CUST.LADISB.loanRefNum)
		print(CUST.LADISB.frmPartyName)
		print(CUST.LADISB.loanAmt)
		print(CUST.LADISB.partyName)
		print(CUST.LADISB.patyAcctNum)
		if(BANCS.STDIN.contextBankId !="56") then
		if((CUST.LADISB.partyName!="") and (CUST.LADISB.patyAcctNum!="") and (CUST.LADISB.loanAmt!="") and (CUST.LADISB.frmPartyName!="") and (CUST.LADISB.loanRefNum!="") and (CUST.LADISB.loanCifId!=""))then
			print("chk")
			BANCS.INPUT.lnmailscr       = ""
			BANCS.INPUT.lnmailscr       = "babx4061 $B2K_SESSION_ID ebLoanMail.scr "
			###BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.partyName + " "
			BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.patyAcctNum + " "
			BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.loanAmt + " "
			###BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.frmPartyName + " "
			BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.loanRefNum  + " "
			BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.loanCifId   + " "
			BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.productCode   + " "
			BANCS.INPUT.lnmailscr       = BANCS.INPUT.lnmailscr + CUST.LADISB.tranid   + " "
			print(BANCS.INPUT.lnmailscr)
			sv_s = system(BANCS.INPUT.lnmailscr)
			print(sv_s)
		endif
		endif
		endif
		##Vino Palani

	ENDIF
	ENDOFSCRIPT:
END-->
