			CUST.CIEREV.srvErrorType = "W"
			sv_f = FORMAT$(sv_d,"%d")
			("CUST").("CIEREV").("WarningCode_" + sv_f) = ("BANCS").("OUTPARAM").("WarningCode_" + sv_f)
			sv_e = ("CUST").("CIEREV").("WarningCode_" + sv_f)
			PRINT(sv_e)
			sv_d = sv_d + 1
			sv_n = sv_n + 1
		#}
		DO
		
		sv_d = 1
		sv_c = CINT(BANCS.OUTPARAM.Warning_num)
		WHILE (sv_d <= sv_c)
		#{
			CUST.CIEREV.srvErrorType = "W"
			sv_f = FORMAT$(sv_d,"%d")
			sv_e = ("BANCS").("OUTPARAM").("WarningCode_" + sv_f)
			PRINT(sv_e)
			
			IF(CUST.CIEREV.srvcallmode == "E")THEN
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_e = ("CUST").("CIEREV").("WarningCode_" + sv_f)
				PRINT(sv_e)
				sv_s = sv_e + "|N"
				sv_u = urhk_putCustomException(sv_s)
				PRINT(sv_u)
				#}
			ELSE
				#{
				CUST.CIEREV.srvErrorType = "W"
				CUST.CIEREV.srvError = "Y"
				sv_b = "Unable to ignore Warning Code "+sv_e
				sv_g = "Error_" + FORMAT$(sv_n,"%d") + "|SRV ERROR^" + sv_b + "^prodCode"
				PRINT(sv_g)
				sv_u = urhk_SetOrbOut(sv_g)
				PRINT(sv_u)
			#}
			ENDIF
			
			sv_d = sv_d + 1
			sv_n = sv_n + 1
		#}
		DO
	#}
	ENDIF
	
	IF(CUST.CIEREV.srvErrorType == "W")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIEREV.srvError = "N"
	
	ENDOFSCRIPT:
		
END-->
