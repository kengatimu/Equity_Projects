	CUST.CIEREV.revTranId = BANCS.OUTPARAM.tranId
	print(CUST.CIEREV.revTranId)
	CUST.CIEREV.revTranDate = BANCS.OUTPARAM.tranDate
	print(CUST.CIEREV.revTranDate)
	CUST.CIEREV.revTranDate = MID$(CUST.CIEREV.revTranDate,0,10)
	
	ENDOFSCRIPT:
