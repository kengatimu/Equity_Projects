	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|REV:"+CUST.CIEREV.tranpart1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+CUST.CIEREV.tranRmks1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRate|"+CUST.CIEREV.treaRateCr)
	IF(CUST.CIEREV.treaRefNum != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRefNum|"+CUST.CIEREV.treaRefNum)
	#}
	ENDIF
	
	###########################################################################################
	# Part Tran Details : Txn in Current Entity - Debit Leg
	###########################################################################################
	
	IF(CUST.CIEREV.refCrncy == CUST.CIEREV.drAcctNumCcy)THEN
	#{
		CUST.CIEREV.treaRateDr = "0"
		CUST.CIEREV.rateCodeDr = ""
	#}
	ENDIF
	
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|D")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+CUST.CIEREV.refCrncy)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.CIEREV.refAmt+"|"+ CUST.CIEREV.refCrncy)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.CIEREV.drAcctNum1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rateCode.refCode|"+CUST.CIEREV.rateCodeDr)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rate|"+CUST.CIEREV.rate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|REV:"+CUST.CIEREV.tranpart1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|"+CUST.CIEREV.tranRmks1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.treaRate|"+CUST.CIEREV.treaRateDr)
	IF(CUST.CIEREV.treaRefNum != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.treaRefNum|"+CUST.CIEREV.treaRefNum)
	#}
	ENDIF
	
	#No need to check for Instrument Details in other entity txn. Hence setting it to N
	CUST.CIEREV.chkInstDetails = "N"
	
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
	
	IF(CUST.CIEREV.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#}
	ELSE
		#{
		sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			print(sv_u)
			
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			
			sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(sv_u != 0)THEN
	#{
		CALL("cierevdp006.scr")
		
		IF(CUST.CIEREV.srvError == "Y")THEN
		#{
			CUST.CIEREV.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	print(BANCS.OUTPARAM.tranId)
	print(BANCS.OUTPARAM.tranDate)
	
	sv_u = urhk_CopyOutToIn("")
	print(sv_u)
	
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
	
	IF(CUST.CIEREV.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
