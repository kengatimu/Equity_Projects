<--start
trace on
	LIBNAME CUSTOMSO
	sv_u=urhk_B2k_PrintRepos("BANCS")
	print(sv_u)
# Rep/Class
	if (repexists("CUST") == 0) then
		createrep("CUST")
	endif
	if (classexists("CUST","GLBDATA") == 0) then
		createclass("CUST","GLBDATA",5)
	endif
	if (classexists("CUST","CPARAM") == 0) then
		createclass("CUST","CPARAM",5)
	endif
# Initialiizing required variables
	CUST.GLBDATA.selectedRec = ""
	CUST.GLBDATA.Function = ""
	CUST.GLBDATA.errColl =""
	CUST.GLBDATA.errMsg = ""
# Getting Input Parameters
	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	if (sv_u == 0) then
	#{
		CUST.GLBDATA.fileName = MTT.InputDetails.Argument1
		print(CUST.GLBDATA.fileName)
		CUST.GLBDATA.functionCode = MTT.InputDetails.Argument2
		print(CUST.GLBDATA.functionCode)
		CUST.GLBDATA.TranYN = MTT.InputDetails.Argument3
		print(CUST.GLBDATA.TranYN)
		CUST.GLBDATA.batchId = MTT.InputDetails.Argument4
		print(CUST.GLBDATA.batchId)
		CUST.GLBDATA.ChargeType = MTT.InputDetails.Argument5
		print(CUST.GLBDATA.ChargeType)
		#}
	else
		#{
		sv_u = urhk_MTTS_Close("")
		print(sv_u)
		goto ENDOFSCRIPT
	#}
	endif
	CUST.GLBDATA.Function = CUST.GLBDATA.functionCode
	print(CUST.GLBDATA.Function)
#chrg Amt
	if(CUST.GLBDATA.ChargeType!="")then
		sv_d = "ChrgAmt | "
		sv_d = sv_d + " select adm.fixed_amt "
		sv_d = sv_d + " from tbaadm.ptt ,tbaadm.adm "
		sv_d = sv_d + " where ptt.bank_id=?SVAR "
		sv_d = sv_d + " and ptt.entity_cre_flg='Y' "
		sv_d = sv_d + " and ptt.del_flg='N' "
		sv_d = sv_d + " and ptt.event_type='GCHRG' "
		sv_d = sv_d + " and ptt.event_id=?SVAR "
		sv_d = sv_d + " and ptt.amt_derv_srl_num=adm.amt_drv_srl_num "
		sv_d = sv_d + " and adm.entity_cre_flg='Y' "
		sv_d = sv_d + " and adm.del_flg='N' "
		sv_d = sv_d + " and adm.bank_id=?SVAR "
		sv_d = sv_d + " order by event_type,event_id "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.GLBDATA.ChargeType + "|" + BANCS.STDIN.contextBankId 
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_c = urhk_dbSelectWithBind(sv_d)
		if(sv_c==0)then
			CUST.GLBDATA.chrgAmt = BANCS.OUTPARAM.ChrgAmt
		else
			CUST.GLBDATA.chrgAmt = "0"
		endif
	else
		CUST.GLBDATA.chrgAmt = "0"
	endif
# Log File
	sv_s = "startTime|"
	sv_s = sv_s + " select to_char(SYSDATE, 'YYYYMMDDHH24MISS') "
	sv_s = sv_s + " from dual"
	print(sv_s)
	sv_r = urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	
	CUST.GLBDATA.startTime = BANCS.OUTPARAM.startTime
	CUST.GLBDATA.successlogFile = "Upload_Success_" + CUST.GLBDATA.startTime + ".log"
	CUST.GLBDATA.failurelogFile = "Upload_Failure_" + CUST.GLBDATA.startTime + ".log"
	print(CUST.GLBDATA.startTime)
	print(CUST.GLBDATA.successlogFile)
	print(CUST.GLBDATA.successlogFile)
# Sucess and Failure report files
	sv_s = "touch " + CUST.GLBDATA.successlogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	sv_s = "touch " + CUST.GLBDATA.failurelogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
# Read csv file 
	sv_o = urtn_fileOpen(CUST.GLBDATA.fileName + "|r")
	print(sv_o)
	if (sv_o == 0) then
	#{
		CUST.GLBDATA.fileindex = sv_o
		print(CUST.GLBDATA.fileindex)
		sv_x = urtn_fileRead(CUST.GLBDATA.fileindex + "|" + "BANCS.OUTPARAM.buffer")
		if(sv_x == 0) then
		#{
			sv_n = "1"
			sv_v = "Y"
			WHILE(sv_x==0)
			###{
				sv_c = 0
				print(CUST.GLBDATA.selectedRec)
				print(BANCS.OUTPARAM.buffer)
				CUST.GLBDATA.selectedRec = BANCS.OUTPARAM.buffer
				CUST.GLBDATA.recBackUp = CUST.GLBDATA.selectedRec
				print(CUST.GLBDATA.selectedRec)
				print(CUST.GLBDATA.recBackUp)
				# Reading the data from CSV file
				sv_l = STRLEN(CUST.GLBDATA.selectedRec)
				print(sv_l)
				print(CUST.GLBDATA.selectedRec)
				CUST.GLBDATA.selectedRec = CUST.GLBDATA.selectedRec + "|"
				print(CUST.GLBDATA.selectedRec)
				sv_z=CUST.GLBDATA.selectedRec
				sv_h="1"
				sv_t = 0
				WHILE(sv_l > 0)
				#{
					sv_l = STRLEN(sv_z)
					print(sv_l)
					sv_p = GETPOSITION(sv_z, "|")
					print(sv_p)
					sv_t = sv_t + 1
					print(sv_t)
					CUST.GLBDATA.numOfValues = sv_t
					print(CUST.GLBDATA.numOfValues)
					
					if(sv_p==0)then
						sv_l=-1
						print(sv_l)
					endif
					
					sv_a = LEFT$(sv_z, sv_p - 1)
					print(sv_a)
					CUST.GLBDATA.num=sv_h
					print(CUST.GLBDATA.num)
					("CUST").("GLBDATA").("fieldData" + CUST.GLBDATA.num) = sv_a
					print(sv_a)
					if (CUST.GLBDATA.num=="1") then
						CUST.GLBDATA.pfNumber=sv_a
						print(CUST.GLBDATA.pfNumber)
					endif
					if (CUST.GLBDATA.num=="2") then
						CUST.GLBDATA.eqDrAcctNum=sv_a
						print(CUST.GLBDATA.eqDrAcctNum)
					endif
					if (CUST.GLBDATA.num=="3") then
						CUST.GLBDATA.eqCrAcctNum=sv_a
						print(CUST.GLBDATA.eqCrAcctNum)
					endif
					if (CUST.GLBDATA.num=="4") then
						CUST.GLBDATA.beneficaryName=sv_a
						print(CUST.GLBDATA.beneficaryName)
					endif
					if (CUST.GLBDATA.num=="5") then
						CUST.GLBDATA.benfBankCode=sv_a
						print(CUST.GLBDATA.benfBankCode)
					endif
					if (CUST.GLBDATA.num=="6") then
						CUST.GLBDATA.benfBranchCode=sv_a
						print(CUST.GLBDATA.benfBranchCode)
					endif
					if (CUST.GLBDATA.num=="7") then
						CUST.GLBDATA.benfAcctNum=sv_a
						print(CUST.GLBDATA.benfAcctNum)
					endif
					if (CUST.GLBDATA.num=="8") then
						CUST.GLBDATA.tranAmt=sv_a
						print(CUST.GLBDATA.tranAmt)
					endif
					if (CUST.GLBDATA.num=="9") then
						CUST.GLBDATA.tranParticulars=sv_a
						print(CUST.GLBDATA.tranParticulars)
					endif
					
					sv_h=CINT(CUST.GLBDATA.num)+1
					print(sv_h)
					
					sv_z = RIGHT$(sv_z, STRLEN(sv_z) - sv_p)
					print(sv_z)
					sv_l=sv_l-sv_p
					print(sv_l)
					
					if((sv_l == 0)AND(sv_h < 9))then
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||" +"~" + "Invalid Record Structure"
						CUST.GLBDATA.recBackUp="Record " +sv_n
						goto INVALID
					endif
				#}
				DO
				if (CINT(CUST.GLBDATA.numOfValues) != 9) then
				#{
					if (CINT(CUST.GLBDATA.numOfValues) > 9) then
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.GLBDATA.errColl)
						goto RECORDSEXCEED
					else
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.GLBDATA.errColl)
						CUST.GLBDATA.recBackUp="Record " +sv_n
						goto INVALID
					#}
					endif
					
				#}
				endif
				#--- PF Number
				if (CUST.GLBDATA.fieldData1 != "") then
				#{
					print(CUST.GLBDATA.fieldData1)
					CUST.GLBDATA.pfNumber = MID$(CUST.GLBDATA.fieldData1,0,16)
					CUST.GLBDATA.pfNumber = trim(CUST.GLBDATA.pfNumber)
					print(CUST.GLBDATA.pfNumber)
					#sv_u = urhk_getAcctDetailsInRepository(CUST.GLBDATA.pfNumber)
					#print(sv_u)
					#if(sv_u !=0)then
					#{
					#	CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "Account Number is Invalid"
					#	sv_v = "N"
					#	sv_c = sv_c + 1
					#	goto INVALID
					#else
					#	CUST.GLBDATA.custId = BANCS.OUTPARAM.custId
					#	CUST.GLBDATA.acctSolId  = BANCS.OUTPARAM.acctSolId
					#}
					#endif
					#if (CUST.GLBDATA.schmType == "SBA") then
					#{
					#	if (CUST.GLBDATA.acctStatus != "A")  then
					#		sv_v = "N"
					#		sv_c = sv_c + 1
					#		CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "Account is invalid, dormant, freezed OR blocked "
					#		goto INVALID
					#	endif
					#}
					#endif
				#}
				endif
				#----- Dr Account Number
				if (CUST.GLBDATA.fieldData2 != "") then
				#{
					print(CUST.GLBDATA.fieldData2)
					CUST.GLBDATA.fieldData2 = MID$(CUST.GLBDATA.fieldData2,0,16)
					CUST.GLBDATA.eqDrAcctNum = CUST.GLBDATA.fieldData2
                                        sv_u = urhk_getAcctDetailsInRepository(CUST.GLBDATA.eqDrAcctNum)
                                        print(sv_u)
                                        if(sv_u !=0)then
                                        #{
                                               CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "DrAccount Number is Invalid"
                                               sv_v = "N"
                                               sv_c = sv_c + 1
                                               goto INVALID
                                        else
                                               CUST.GLBDATA.custId = BANCS.OUTPARAM.custId
                                               CUST.GLBDATA.acctSolId  = BANCS.OUTPARAM.acctSolId
                                        #}
                                        endif
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field2 is Missing"
					goto INVALID
				#}
				endif
				#----- Cr Account Number  
				if (CUST.GLBDATA.fieldData3 != "") then
				#{
					print(CUST.GLBDATA.fieldData3)
					CUST.GLBDATA.fieldData3 = MID$(CUST.GLBDATA.fieldData3,0,16)
					CUST.GLBDATA.eqCrAcctNum = CUST.GLBDATA.fieldData3
                                        sv_u = urhk_getAcctDetailsInRepository(CUST.GLBDATA.eqCrAcctNum)
                                        print(sv_u)
                                        if(sv_u !=0)then
                                        #{
                                               CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "CrAccount Number is Invalid"
                                               sv_v = "N"
                                               sv_c = sv_c + 1
                                               goto INVALID
                                        else
                                               CUST.GLBDATA.custId = BANCS.OUTPARAM.custId
                                               CUST.GLBDATA.acctSolId  = BANCS.OUTPARAM.acctSolId
                                        #}
                                        endif
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field3 is Missing"
					goto INVALID
				#}
				endif
				#----- Beneficiary Name 
				if (CUST.GLBDATA.fieldData4 != "") then
				#{
					print(CUST.GLBDATA.fieldData4)
					CUST.GLBDATA.fieldData4 = MID$(CUST.GLBDATA.fieldData4,0,80)
					CUST.GLBDATA.beneficaryName = CUST.GLBDATA.fieldData4
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field4 is Missing"
					goto INVALID
				#}
				endif
				#----- Beneficiary Bank Code  
				if (CUST.GLBDATA.fieldData5 != "") then
				#{
					print(CUST.GLBDATA.fieldData5)
					CUST.GLBDATA.fieldData5 = MID$(CUST.GLBDATA.fieldData5,0,10)
					CUST.GLBDATA.benfBankCode = CUST.GLBDATA.fieldData5
					sv_a = urhk_B2k_valBankCode(CUST.GLBDATA.benfBankCode)
					if(sv_a != 0 ) then
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "Invalid BankCode field5 "
						goto INVALID
					endif
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field5 is Missing"
					goto INVALID
				#}
				endif
				#----- Beneficiary Branch Code  
				if (CUST.GLBDATA.fieldData6 != "") then
				#{
					print(CUST.GLBDATA.fieldData6)
					CUST.GLBDATA.fieldData6 = MID$(CUST.GLBDATA.fieldData6,0,10)
					CUST.GLBDATA.benfBranchCode = CUST.GLBDATA.fieldData6
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field6 is Missing"
					goto INVALID
				#}
				endif
			#	if((CUST.GLBDATA.benfBankCode!="") and (CUST.GLBDATA.benfBranchCode!=""))then
			#		sv_a = CUST.GLBDATA.benfBankCode + "|" + CUST.GLBDATA.benfBranchCode 
			#		sv_b = urhk_B2k_valBankBranchCode(sv_a)
			#		IF(sv_b != 0 ) THEN
			#		#{
			#			sv_v = "N"
			#			sv_c = sv_c + 1
			#			CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "Invalid BankBranch field5&6 "
			#			goto INVALID
			#		#}
			#		ENDIF
			#	endif
				#----- Beneficiary Account Number 
				if (CUST.GLBDATA.fieldData7 != "") then
				#{
					print(CUST.GLBDATA.fieldData7)
					CUST.GLBDATA.fieldData7 = MID$(CUST.GLBDATA.fieldData7,0,80)
					CUST.GLBDATA.benfAcctNum = CUST.GLBDATA.fieldData7
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field7 is Missing"
					goto INVALID
				#}
				endif
				#---- tranAmount
				if (CUST.GLBDATA.fieldData8 != "") then
				#{
					print(CUST.GLBDATA.fieldData8)
					CUST.GLBDATA.recordLen = ""
					CUST.GLBDATA.recordLen = STRLEN(CUST.GLBDATA.fieldData8)
					if("0" != CUST.GLBDATA.recordLen ) then
						sv_p = GETPOSITION(CUST.GLBDATA.fieldData8,".")
						print(sv_p)
						sv_f = MID$(CUST.GLBDATA.fieldData8,0,sv_p-1)
						print(sv_f)
					endif
					CUST.GLBDATA.feildDataTemp1 = TRIM(sv_f)
					sv_r = MID$(CUST.GLBDATA.fieldData8,sv_p,CINT(CUST.GLBDATA.recordLen))
					print(sv_r)
					CUST.GLBDATA.tranAmt = sv_f + sv_r
					print(CUST.GLBDATA.tranAmt)
					sv_u = urhk_B2k_isStringNumeric (CUST.GLBDATA.tranAmt)
					print(sv_u)
					if(sv_u != 0) then
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field8 is not in numeric format"
						goto INVALID
					endif
						CUST.GLBDATA.tranAmt=CUST.GLBDATA.fieldData8
						print(cdouble(CUST.GLBDATA.tranAmt))
					if(cdouble(CUST.GLBDATA.tranAmt)<=0)then
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field8 Amount cannot be zero"
						goto INVALID
					endif
					if(cdouble(CUST.GLBDATA.tranAmt)>999999)then
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field8 Amount maximum 999,999.00"
						goto INVALID
					endif
					#++++chrg Amt
					print(CUST.GLBDATA.tranAmt)
					print(CUST.GLBDATA.chrgAmt)
					CUST.GLBDATA.tranAmt = cdouble(CUST.GLBDATA.tranAmt) - cdouble(CUST.GLBDATA.chrgAmt)
					print(CUST.GLBDATA.tranAmt)
					#-----------Edwin -tive credit amount fix
					if(cdouble(CUST.GLBDATA.tranAmt)<=0)then
                                                sv_v = "N"
                                                sv_c = sv_c + 1
                                                CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "final credit amount cannot be zero"
                                                goto INVALID
					endif
					#----------Edwin end
					print(CUST.GLBDATA.chrgAmt)
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field8 is Missing"
					goto INVALID
				#}
				endif
				#----- Tran Particular 
				if (CUST.GLBDATA.fieldData9 != "") then
				#{
					print(CUST.GLBDATA.fieldData9)
					CUST.GLBDATA.fieldData9 = MID$(CUST.GLBDATA.fieldData9,0,50)
					CUST.GLBDATA.tranParticulars = CUST.GLBDATA.fieldData9
				else
					sv_v = "N"
					sv_c = sv_c + 1
					CUST.GLBDATA.errColl = CUST.GLBDATA.errColl + "||||~" + "field9 is Missing"
					goto INVALID
				#}
				endif
				callscriptifexist("ebcpluplDataTran.scr")
				print(CUST.GLBDATA.numOfValues)
				print(sv_c)
				if ((CINT(CUST.GLBDATA.numOfValues) ==9 ) AND (sv_c == 0)) then
					sv_s = "echo" + " '" +  CUST.GLBDATA.recBackUp + "||||' >>" + " " + CUST.GLBDATA.successlogFile
					sv_d = system(sv_s)
					print(sv_d)
				else
					goto INVALID
				endif
				if (CUST.GLBDATA.errColl != "") then
					goto INVALID
				endif
				INVALID:
					print(sv_c)
					if (sv_c  != 0 ) then
						CUST.GLBDATA.error = CUST.GLBDATA.recBackUp + "|" + CUST.GLBDATA.errColl
						sv_s = "echo" + " '" +  CUST.GLBDATA.error + "' >>" + " " + CUST.GLBDATA.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.GLBDATA.recBackUp = ""
						CUST.GLBDATA.errColl = ""
						goto NEXTREC
					endif
				RECORDSEXCEED:
					if (sv_c  != 0 ) then
						CUST.GLBDATA.error = CUST.GLBDATA.fieldData1 + "|" + CUST.GLBDATA.errColl
						sv_s = "echo" + " '" +  CUST.GLBDATA.error + "' >>" + " " + CUST.GLBDATA.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.GLBDATA.recBackUp = ""
						CUST.GLBDATA.errColl = ""
						goto NEXTREC
					endif
				NEXTREC:
					# Reading the data from CSV file
					print(CUST.GLBDATA.fileindex)
					sv_x = urtn_fileRead(CUST.GLBDATA.fileindex + "|" + "BANCS.OUTPARAM.buffer")
					print(sv_x)
					print(sv_n)
					CUST.GLBDATA.recCnt = sv_n
					sv_n = CINT(CUST.GLBDATA.recCnt) + 1
					CUST.GLBDATA.recCnt = sv_n
					sv_n = CUST.GLBDATA.recCnt
					print(sv_n)
			###}
			DO
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Upload Process Initiated Success fully - Check status in HPR after some time "
				print(sv_g)
				sv_z = urhk_SetOrbOut(sv_g)
				print(sv_z)
				goto ENDOFSCRIPT
		else
				sv_e = "File Opened but Unable to Read."
				sv_m = "fileName"
				CUST.GLBDATA.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				goto FAILURE
		#}
		endif
	else
			sv_e = "Not able to open the file for upload."
			sv_m = "fileName"
			CUST.GLBDATA.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
			goto FAILURE
	#}
	endif
		
FAILURE:
		sv_z = "SuccessOrFailure|N"
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		sv_z = CUST.GLBDATA.errMsg
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
ENDOFSCRIPT:
		print(CUST.GLBDATA.errMsg)
		if (CUST.GLBDATA.errMsg == "") then
		#{
		# Report Generation
			sv_b = urhk_getEnv("FIN_REPORTS_DIR")
			print(sv_b)
			if (sv_b==0) then
				CUST.GLBDATA.envValue = BANCS.OUTPARAM.envValue
				print(CUST.GLBDATA.envValue)
			endif
			CUST.GLBDATA.envValue =CUST.GLBDATA.envValue
			print(CUST.GLBDATA.envValue)
			#sv_a = urhk_B2K_printRepos("CUST")
			#print(sv_a)
		# Success Report
			sv_s = "mrbx4004 $B2K_SESSION_ID ebcpluplSuc.mrt " + CUST.GLBDATA.successlogFile + " " + CUST.GLBDATA.successlogFile + "_RPT"
			print(sv_s)
			sv_d = system(sv_s)
			print(sv_d)
			CUST.GLBDATA.successlogFile = CUST.GLBDATA.successlogFile + "_RPT.rpt"
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.GLBDATA.envValue + "/" + BANCS.STDIN.userId  +"/" + CUST.GLBDATA.successlogFile+  " 'Success Upload Report For PesaLink' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			print (sv_h)
		# Failure Report
			sv_s = "mrbx4004 $B2K_SESSION_ID ebcpluplFai.mrt " + CUST.GLBDATA.failurelogFile + " " + CUST.GLBDATA.failurelogFile + "_RPT"
			print(sv_s)
			sv_d = system(sv_s)
			print(sv_d)
			CUST.GLBDATA.failurelogFile = CUST.GLBDATA.failurelogFile + "_RPT.rpt"
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.GLBDATA.envValue + "/"+ BANCS.STDIN.userId +"/"+CUST.GLBDATA.failurelogFile+" 'Failure Upload Report For PesaLink' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			print (sv_h)
		# Transaction
			sv_a = urhk_getEnv("ONS_LOG_DIR")
			print(BANCS.OUTPARAM.envValue)
			print(sv_a)
			if(sv_a == 1)then
				print("Env variable ONS/log not found")
			endif
			CUST.GLBDATA.ONSpath = BANCS.OUTPARAM.envValue
			print(CUST.GLBDATA.ONSpath)
			CUST.GLBDATA.fileLoc = CUST.GLBDATA.ONSpath +"/"+BANCS.STDIN.userId + "/" 
		 	sv_u = urhk_getFileLocation("COM|ebcpluplT.com")
			if(sv_u ==0)then
				print(BANCS.OUTPARAM.fileLocation)
				CUST.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "ebcpluplT.com"
 				CUST.GLBDATA.comfil = CUST.GLBDATA.comfil + " " + BANCS.STDIN.contextBankId + " " + BANCS.STDIN.userId + " " + CUST.GLBDATA.fileLoc + " " + CUST.GLBDATA.TranYN + " " + CUST.GLBDATA.batchId 
			else
				CUST.GLBDATA.comfil   = ""
			endif
			print(CUST.GLBDATA.comfil)
			if(CUST.GLBDATA.comfil != "")then
				sv_u = system(CUST.GLBDATA.comfil)
				##sv_u=0
				if(sv_u ==0)then
					print("success")
				else
					print("failed")
				endif
			endif
		#}
		endif
exitscript
end-->
