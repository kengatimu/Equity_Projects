#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             09-09-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Reps/Class
#++++++++++
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
	EQSRV.GLBDATA.cifId = EQSRV.GLBDATA.CifId 
        sv_s = "RequestID1|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0)then
		EQSRV.GLBDATA.RequestID1 = BANCS.OUTPARAM.RequestID1
		print(EQSRV.GLBDATA.RequestID1)
	else
		EQSRV.GLBDATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(EQSRV.GLBDATA.RequestID1)
	endif
	EQSRV.GLBDATA.RequestID1=EQSRV.GLBDATA.RequestID1
sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        if(sv_d == 0) then
                EQSRV.GLBDATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
                print(EQSRV.GLBDATA.msgDateTime)
        else
                EQSRV.GLBDATA.scrValYN  = "N"
                EQSRV.GLBDATA.valerr    = "rev API Creation Failed "
                goto ENDSCR
        endif
	EQSRV.GLBDATA.channelID ="CRM"
	EQSRV.GLBDATA.bankID = BANCS.STDIN.contextBankId
        EQSRV.GLBDATA.headerXML = ""
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Header>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RequestHeader>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<MessageKey>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RequestUUID>"+ EQSRV.GLBDATA.RequestID1 +"</RequestUUID>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<ServiceRequestId>verifyCustomerDetails</ServiceRequestId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<ChannelId>" + EQSRV.GLBDATA.channelID + "</ChannelId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<LanguageId></LanguageId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</MessageKey>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RequestMessageInfo>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<BankId>" + EQSRV.GLBDATA.bankID + "</BankId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<TimeZone></TimeZone>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<EntityId></EntityId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<EntityType></EntityType>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<ArmCorrelationId></ArmCorrelationId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<MessageDateTime>" + EQSRV.GLBDATA.msgDateTime + "</MessageDateTime>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RequestMessageInfo>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Security>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Token>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<PasswordToken>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<UserId></UserId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<Password></Password>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</PasswordToken>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Token>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<FICertToken></FICertToken>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUserLoginSessionId></RealUserLoginSessionId>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUser></RealUser>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<RealUserPwd></RealUserPwd>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "<SSOTransferToken></SSOTransferToken>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Security>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</RequestHeader>"
        EQSRV.GLBDATA.headerXML = EQSRV.GLBDATA.headerXML + "</Header>"
        EQSRV.GLBDATA.bodyXMLMsg = ""
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<Body>"
        EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<verifyCustomerDetailsRequest>"
        EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<CustomerVerifyRq>"
        EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<cifId>" + EQSRV.GLBDATA.cifId + "</cifId>"
        EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<decision>Approve</decision>"
        EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "<entityName>RetailCustomer</entityName>"
        EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</CustomerVerifyRq>"
        EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</verifyCustomerDetailsRequest>"
	EQSRV.GLBDATA.bodyXMLMsg = EQSRV.GLBDATA.bodyXMLMsg + "</Body>"
	print(EQSRV.GLBDATA.bodyXMLMsg)
	EQSRV.GLBDATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "<FIXML>"
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.headerXML
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + EQSRV.GLBDATA.bodyXMLMsg
	EQSRV.GLBDATA.reqXMLMsg = EQSRV.GLBDATA.reqXMLMsg + "</FIXML>"

	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	sv_a = EQSRV.GLBDATA.reqXMLMsg
	PRINT(sv_a)
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	if(sv_l != 0)then
	print(BANCS.OUTPARAM.ErrMsg)
	EQSRV.GLBDATA.scrValYN = "N"
	EQSRV.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
	if(BANCS.OUTPARAM.ErrMsg != "") then
		EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = BANCS.OUTPARAM.ErrMsg
                        goto ENDSCR
                endif
        else
                        EQSRV.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                        print(EQSRV.GLBDATA.respXMLMsg)
                        EQSRV.GLBDATA.scrValYN = "Y"
                        EQSRV.GLBDATA.valerr = ""
        endif
        sv_x = EQSRV.GLBDATA.respXMLMsg
        sv_y = "<Status>"
        sv_z = "</Status>"
        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
        sv_e = GETPOSITION(sv_x, sv_z) - 1
        if (GETPOSITION(sv_x, sv_y) != 0) then
                EQSRV.GLBDATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
        else
                EQSRV.GLBDATA.tranStatus = ""
        endif
        print(EQSRV.GLBDATA.tranStatus)
        if(EQSRV.GLBDATA.tranStatus == "SUCCESS") then
                sv_x = EQSRV.GLBDATA.respXMLMsg
                sv_y = "<cifId>"
                sv_z = "</cifId>"
                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                sv_e = GETPOSITION(sv_x, sv_z) - 1
                if (GETPOSITION(sv_x, sv_y) != 0) then
                        EQSRV.GLBDATA.cifId = MID$(sv_x, sv_b, (sv_e - sv_b))
                endif
                if(EQSRV.GLBDATA.cifId == "") then
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = "Could Not Get Response from Server"
                        goto ENDSCR
                else
                        print(EQSRV.GLBDATA.CustId)
                endif
        else
                if(EQSRV.GLBDATA.tranStatus == "FAILED") then
                        sv_x = EQSRV.GLBDATA.respXMLMsg
                        sv_y = "<ErrorCode>"
                        sv_z = "</ErrorCode>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1
                        if(GETPOSITION(sv_x, sv_y) != 0) then
                                EQSRV.GLBDATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
                        endif
                        sv_x = EQSRV.GLBDATA.respXMLMsg
                        sv_y = "<ErrorDesc>"
                        sv_z = "</ErrorDesc>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1
                        if(GETPOSITION(sv_x, sv_y) != 0) then
                                EQSRV.GLBDATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
                        endif
                endif
                if((EQSRV.GLBDATA.errorCode == "") AND (EQSRV.GLBDATA.errorDesc == "")) then
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = "Could Not Get Response from Server"
                        goto ENDSCR
                else
                        EQSRV.GLBDATA.scrValYN = "N"
                        EQSRV.GLBDATA.valerr = EQSRV.GLBDATA.errorCode + ":" + EQSRV.GLBDATA.errorDesc
                        goto ENDSCR
                endif
        endif
	if(EQSRV.GLBDATA.cifId!="")then
		sv_d = "cifCnt,CifId,recYN|select count(*),orgkey,recordstatus from crmuser.accounts "
		sv_d = sv_d + " where bank_id=?SVAR and orgkey=?SVAR "
		sv_d = sv_d + " group by orgkey,recordstatus "
		print(sv_d)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.cifId 
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		print(sv_u)
		if(sv_u==0)then
			EQSRV.GLBDATA.cifCnt = BANCS.OUTPARAM.cifCnt
			EQSRV.GLBDATA.CifId = BANCS.OUTPARAM.CifId
			EQSRV.GLBDATA.recYN = BANCS.OUTPARAM.recYN
		else
			EQSRV.GLBDATA.cifCnt = 0
			EQSRV.GLBDATA.CifId = ""
			EQSRV.GLBDATA.recYN = ""
		endif
	endif
	if(EQSRV.GLBDATA.recYN=="A")then
		sv_d = "ccCnt,ccCifId,ccRecYN|select count(*),cif_id,entity_cre_flg "
		sv_d = sv_d + " from tbaadm.ccmg "
		sv_d = sv_d + " where bank_id=?SVAR "
		sv_d = sv_d + " and cif_id=?SVAR "
		sv_d = sv_d + " group by cif_id,entity_cre_flg "
		print(sv_d)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.cifId
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQSRV.GLBDATA.ccCnt = BANCS.OUTPARAM.ccCnt
			EQSRV.GLBDATA.ccCifId = BANCS.OUTPARAM.ccCifId
			EQSRV.GLBDATA.ccRecYN = BANCS.OUTPARAM.ccRecYN
		else
			EQSRV.GLBDATA.ccCnt = "" 
			EQSRV.GLBDATA.ccCifId = "" 
			EQSRV.GLBDATA.ccRecYN = "" 
		endif
		if(cdouble(EQSRV.GLBDATA.ccCnt)>=1)then
			EQSRV.GLBDATA.cifVerifyYN="Y"
			EQSRV.GLBDATA.iscrmCcfmYN="Y"
		else
			EQSRV.GLBDATA.cifVerifyYN="Y"
			EQSRV.GLBDATA.iscrmCcfmYN="N"
		endif
	else
		EQSRV.GLBDATA.cifVerifyYN="N"
		EQSRV.GLBDATA.iscrmCcfmYN="N"
		Print("cif unverified")
	endif
ENDSCR:
	exitscript
###trace off
end-->
