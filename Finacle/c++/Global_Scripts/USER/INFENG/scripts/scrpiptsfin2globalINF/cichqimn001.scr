#	Input			: NA
#	Output			: NA
#	Called Script	:
#	Calling Scrip	: NA
#	Menu Option		: CCHQI
#	Srl. No			Date			Author			Description.
#	-------			---------		-------			---------------
#	1.0				16-03-2013		GOKULKRISHNA			Original Version
#----------------------------------------------------------------------------------

<--START
CHECKSUM="4f79f4e6b8c066a927658d630b4c0b7cf4a35549ced0409f347a0423c440ba2a"
	TRACE ON
	#---------------------------------------------------------------------------------
	# CREATING NEW REPOSITORY AND CLASS
	#---------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.solID)
	PRINT(BANCS.INPUT.foracid)
	PRINT(BANCS.INPUT.status)
	
	CUST.DATA.solID = BANCS.INPUT.solID
	PRINT(CUST.DATA.solID)
	CUST.DATA.foracid = BANCS.INPUT.foracid
	PRINT(CUST.DATA.foracid)
	CUST.DATA.status  = BANCS.INPUT.status
	PRINT(CUST.DATA.status)
	
	#---------------------------------------------------------------------------------
	# Validation of SOL ID
	#---------------------------------------------------------------------------------
	IF(CUST.DATA.solID== "") THEN
	#{
		sv_e = "Sol Id Field  is mandatory"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.DATA.foracid != "") THEN
	#{
		
		sv_s = "ValidateAccout|Select count(*) from tbaadm.gam where foracid = ?SVAR "
		sv_s = sv_s + " AND schm_type ='SBA' AND entity_cre_flg = 'Y' AND del_flg !='Y' AND acct_cls_flg !='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.DATA.foracid  + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(BANCS.OUTPARAM.ValidateAccout <= 0) THEN
		#{
			sv_e = "Incorrect Account No. / Accounts of schm other than SBA are not allowed"
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		sv_e = "Acct Num Field  is mandatory"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ((CUST.DATA.status == "") AND (CUST.DATA.status != "E") AND (CUST.DATA.status != "A") AND (CUST.DATA.status != "D") AND (CUST.DATA.status != "S")) THEN
	#{
		sv_e = "Invalid Status [Request-E, Authorised-A, Deleted-D, Processed-S]"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		TRACE OFF
		EXITSCRIPT
END-->
