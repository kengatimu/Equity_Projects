#----------------------------------------------------------------------------------------------------------
# Filename              :       AccessInq_MenuAccessChk.scr
# Author                :       Swati Ganjoo
# Description           :       This script does the Menu Access Check
# Input                 :       UserID,MenuID
# Output                :       None
# Called Script         :       None
# Calling Script        :       AcccesInq_FetchUserDtl.scr                                                            
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Swati Ganjoo      Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
	# Script body goes here
TRACE ON
	BANCS.INPARAM.BINDVARS=CUST.INTERFACE.mopId+"|"+CUST.INTERFACE.hmeEntityId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "workClass|"
	sv_s = sv_s + " SELECT WORK_CLASS"
	sv_s = sv_s + " FROM TBAADM.MOD"
	sv_s = sv_s + " WHERE MOP_ID=?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.INTERFACE.workClass = BANCS.OUTPARAM.workClass
		print(CUST.INTERFACE.workClass)
		CUST.INTERFACE.workClass=MID$(CUST.INTERFACE.workClass,0,3)
		print(CUST.INTERFACE.workClass)
		CUST.INTERFACE.workClass=LTRIM(CUST.INTERFACE.workClass,'0')
		print(CUST.INTERFACE.workClass)
		sv_b=CUST.INTERFACE.workClass
	#}
	ELSE
	#{
		print("ERROREXIT in fetching workClass from MOD table")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR015"
		GOTO ERROREXIT
	#}
	ENDIF
	#========================================================
	# Executing the services for fetching the low & high workclass
	# Menu-HMOPM
	# Service Name-SRV_InquireMenu
	#========================================================
	sv_a=CINT("0")
	sv_s = urhk_SetUrhkInp("genDtl.mopId|"+CUST.INTERFACE.mopId)
	print(sv_s)
	WHILE(sv_a < sv_b)
	#{
		sv_u = urhk_SetUrhkOut("workClassDtlLL.<rec_"+  FORMAT$(sv_a,"%d") +">.key.serial_num|serial_num"+ format$(sv_a,"%d"))
		sv_u = urhk_SetUrhkOut("workClassDtlLL.<rec_"+  FORMAT$(sv_a,"%d") +">.workClassLow.refCode|workClassLow"+ format$(sv_a,"%d"))
		sv_u = urhk_SetUrhkOut("workClassDtlLL.<rec_"+  FORMAT$(sv_a,"%d") +">.workClassHigh.refCode|workClassHigh"+ format$(sv_a,"%d"))
		
		sv_a=sv_a +1
		print(sv_a)
	#}
	DO
	sv_u = urhk_ExecSrv("SRV_InquireMenu|retain_all_output = Y")
	print(sv_u)
	IF(sv_u!=0)THEN
	#{
		print("SRV failed!")
		CUST.INTERFACE.srvErrFlg="Y"
		CALL("Common_Interface_ErrorExit.scr")
		GOTO ERROREXIT
	#}
	ELSE
	#{
		sv_c =CINT("0")
		#----------------------------------------
		#Initialing the output to local variables
		#----------------------------------------
		WHILE(sv_c < sv_a)
		#{
			("CUST").("INTERFACE").("serial_num" + format$(sv_c,"%d"))=("BANCS").("OUTPARAM").("serial_num" + format$(sv_c,"%d"))
			("CUST").("INTERFACE").("workClassLow" + format$(sv_c,"%d"))=("BANCS").("OUTPARAM").("workClassLow" + format$(sv_c,"%d"))
			("CUST").("INTERFACE").("workClassHigh" + format$(sv_c,"%d"))=("BANCS").("OUTPARAM").("workClassHigh" + format$(sv_c,"%d"))
			print(("CUST").("INTERFACE").("serial_num" + format$(sv_c,"%d")))
			print(("CUST").("INTERFACE").("workClassLow" + format$(sv_c,"%d")))
			print(("CUST").("INTERFACE").("workClassHigh" + format$(sv_c,"%d")))
			
			sv_c=sv_c+1
		DO
		#---------------------------------------------------
		#Comparing the LOW & High work class with
		#effective work class for validating the menu access
		#---------------------------------------------------
		sv_o=0
		WHILE(sv_o < sv_a)
		#{
			IF((CUST.INTERFACE.effWrkClass>=("CUST").("INTERFACE").("workClassLow" + format$(sv_o,"%d")))AND(CUST.INTERFACE.effWrkClass<=("CUST").("INTERFACE").("workClassHigh" + format$(sv_o,"%d"))))THEN
			#{
				CUST.INTERFACE.bwRange="Y"
				PRINT(CUST.INTERFACE.bwRange)
			#}
			ENDIF
			
			sv_o=sv_o+1
		#}
		DO
		#{
	#}
	ENDIF
end-->
