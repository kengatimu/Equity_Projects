									BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.Clglmt + "|" + CUST.CATOD.CashIntSolmt
									BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  BANCS.INPUT.Chargeforacid
									BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.CurrencyCode + "|" + BANCS.STDIN.contextBankId
									BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.del_flgpol + "|" + CUST.CATOD.getboddate
									BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CATOD.sysdatepol + "|Y|" + CUST.CATOD.Entererid
									BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.INPUT.funcCode 
									sv_d = urhk_dbsqlWithBind(sv_s)
									print(sv_d)
									IF(sv_d == 0)THEN
									#{
										GOTO ENDOFSCRIPT
									#}
									ENDIF

						#}
						ENDIF
						
					#}
					ELSE
					#{
					
						#sv_d = urhk_dbSqlWithBind("ROLLBACK")
						#print(sv_d)
						CUST.CATOD.errMsg = "Error in Verifying Details"
						sv_e = CUST.CATOD.errMsg
						sv_m = "funcCode"
						sv_e = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
	
		#}
		ENDIF
		
		
		
		
		
	#}
	ENDIF
	
ENDOFSCRIPT:
	IF(CUST.CATOD.errMsg == "") THEN
	#{
		IF ((CUST.CATOD.Function=="A") OR (CUST.CATOD.Function=="Y")) THEN
		#{
			sv_t = "Record Added Successfully"
		#}
		ENDIF
		IF (CUST.CATOD.Function=="M")THEN
		#{
			sv_t = "Record Modified Successfully"
		#}
		ENDIF
		IF (CUST.CATOD.Function=="V")THEN
		#{
			sv_t = "Record Verified Successfully"
		#}
		ENDIF
		IF (CUST.CATOD.Function=="Z")THEN
		#{
			sv_t = "Record Closed Successfully"
		#}
		ENDIF
		IF (CUST.CATOD.Function=="I")THEN
		#{
			sv_t = "Inquiry Option"
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			exitscript
		#}
		ENDIF
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|" + sv_t
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF

	ENDO:	
	TRACE OFF
	EXITSCRIPT
	END-->
	
	
