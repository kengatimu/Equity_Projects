<--START
CHECKSUM="f4fa3c3025011e419f5a05eff5dd5c5a2b88715294bd019fe0ee92e9bbcf993b"
	TRACE ON
	
	sv_a=urhk_B2k_PrintRepos("BANCS")
	sv_b = urhk_SRV_GetVal("acctLienMaintCrit.lienExpiryDate")
	sv_n=BANCS.OUTPARAM.srvValue
	print(sv_n)
	
	IF(FIELDEXISTS(BANCS.STDIN.moduleIdentity))THEN
	#{
		IF(BANCS.STDIN.moduleIdentity != "FI")THEN
		#{
			IF (sv_n=="") THEN
			#{
				sv_f=urhk_SRV_SetErr("ENTER LIEN EXPIRY DATE")
				BANCS.OUTPUT.successOrFailure="F"
				exitscript
			#}
			ENDIF
		#}
		ENDIF

		IF(BANCS.STDIN.moduleIdentity == "FI")THEN
		#{	
			sv_r = REPEXISTS("MISS")
			IF (sv_r == 0) THEN
				CREATEREP("MISS")
			endif
			sv_r = CLASSEXISTS("MISS", "CHRG")
			IF (sv_r == 0) THEN
				CREATECLASS("MISS", "CHRG", 5)
			ENDIF
			sv_v = ""
			sv_a = urhk_GetChannelInfo("") 
			print(sv_a)
			if (sv_a==0) then
				 sv_v = BANCS.OUTPARAM.DccId
				 print(sv_v)
			endif
			IF ((sv_v=="XXXXX") OR (sv_v=="PCS")) THEN
				sv_b = urhk_SRV_GetVal("acctLienMaintCrit.acctNum.foracid")
				print(sv_b)
				MISS.CHRG.lienaccountid=BANCS.OUTPARAM.srvValue
				print(MISS.CHRG.lienaccountid)
				#####
				sv_h = urhk_getAcctDetailsInRepository(MISS.CHRG.lienaccountid)
				print(sv_h)
				IF (sv_h==0) THEN
					MISS.CHRG.solidsh = BANCS.OUTPARAM.acctSolId
					print(MISS.CHRG.solidsh)
					MISS.CHRG.schmcodesh = BANCS.OUTPARAM.schmCode
					print(MISS.CHRG.schmcodesh)
					MISS.CHRG.schmType = BANCS.OUTPARAM.schmType
					print(MISS.CHRG.schmType)
					MISS.CHRG.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
					print(MISS.CHRG.EffAvailableAmttr)
				ENDIF
				#####
				sv_m = urhk_SRV_GetVal("lienMaintLL.<rec_0>.newLienAmt")
				print(sv_m)
				MISS.CHRG.TranAmt = BANCS.OUTPARAM.srvValue
				print(MISS.CHRG.TranAmt)
				MISS.CHRG.record = MISS.CHRG.TranAmt
				print(MISS.CHRG.record)
				sv_j = GETPOSITION(MISS.CHRG.record,"|")
				MISS.CHRG.acctno = MID$(MISS.CHRG.record,0,sv_j-1)
				PRINT(MISS.CHRG.acctno)
				sv_g = STRLEN(MISS.CHRG.record)
				MISS.CHRG.tschm = MID$(MISS.CHRG.record,sv_j,sv_g-1)
				print(MISS.CHRG.tschm)
				MISS.CHRG.TranAmt = MISS.CHRG.acctno
				print(MISS.CHRG.TranAmt)
				IF ( CINT(MISS.CHRG.TranAmt) > CINT(MISS.CHRG.EffAvailableAmttr) ) THEN
					sv_f=urhk_SRV_SetErr("Insufficient Funds ")
					BANCS.OUTPUT.successOrFailure="F"
					exitscript
				ENDIF
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	TRACE OFF
	EXITSCRIPT
