<--start
trace on
sv_u=urhk_B2K_PrintRepos("BANCS")
print(sv_u)
if(fieldexists(BANCS.INPUT.NatIdNum)==1)then
	print(BANCS.INPUT.NatIdNum)
endif
if(BANCS.INPUT.NatIdNum!="")then
	sv_d = "NatId,FirstName,LastName,MiddleName,MobileNum,AddressLine1,AddressLine2,MailId,Occupation,CrncyCode,KaraPin|"
	sv_d = sv_d + " select national_id,first_name,last_name,middle_name,mobile_number,address_line1,address_line2,mail_id,occupation,currency_code,karpin_code "
	sv_d = sv_d + " from custom.obmt "
	sv_d = sv_d + " where bank_id=?SVAR "
	sv_d = sv_d + " and module_id='CU-HAPO' "
	sv_d = sv_d + " and national_id=?SVAR "
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.NatIdNum
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	print(sv_u)
	if(sv_u==0)then
	BANCS.INPUT.NatId=	BANCS.OUTPARAM.NatId
		BANCS.INPUT.FirstName = BANCS.OUTPARAM.FirstName
		BANCS.INPUT.LastName = BANCS.OUTPARAM.LastName
		BANCS.INPUT.MiddleName = BANCS.OUTPARAM.MiddleName
		BANCS.INPUT.MobileNum = BANCS.OUTPARAM.MobileNum
		BANCS.INPUT.AddressLine1 = BANCS.OUTPARAM.AddressLine1
		BANCS.INPUT.AddressLine2 = BANCS.OUTPARAM.AddressLine2
		BANCS.INPUT.MailId = BANCS.OUTPARAM.MailId
		BANCS.INPUT.Occupation = BANCS.OUTPARAM.Occupation
		BANCS.INPUT.CrncyCode = BANCS.OUTPARAM.CrncyCode
		BANCS.INPUT.KaraPin = BANCS.OUTPARAM.KaraPin
	else
		BANCS.INPUT.NatId = ""
		BANCS.INPUT.FirstName= ""
		BANCS.INPUT.LastName = ""
		BANCS.INPUT.MiddleName = ""
		BANCS.INPUT.MobileNum = ""
		BANCS.INPUT.AddressLine1 = ""
		BANCS.INPUT.AddressLine2 = ""
		BANCS.INPUT.MailId = ""
		BANCS.INPUT.Occupation= ""
		BANCS.INPUT.CrncyCode = ""
		BANCS.INPUT.KaraPin = ""
		BANCS.INPUT.popOut ="N|"
	endif
	BANCS.INPUT.popOut = "Y|" + BANCS.INPUT.NatId + "~" +BANCS.INPUT.FirstName + "~" + BANCS.INPUT.LastName + "~" + BANCS.INPUT.MiddleName + "~" + BANCS.INPUT.MobileNum + "~" + BANCS.INPUT.AddressLine1 + "~" + BANCS.INPUT.AddressLine2 + "~" + BANCS.INPUT.MailId + "~" + BANCS.INPUT.Occupation + "~" + BANCS.INPUT.CrncyCode + "~" + BANCS.INPUT.KaraPin 
	print(BANCS.INPUT.popOut)
	sv_a = urhk_SetOrbOut(BANCS.INPUT.popOut)
	print(sv_a)
endif
trace off
end-->
