<--start
#trace on

	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.acid + "|" + CUST.INTERFACE.acid + "|" 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.INTERFACE.bankID + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.INTERFACE.bankID
	sv_s = "maturityDate,interestRate|"
	sv_s = sv_s + "SELECT to_char(MATURITY_DATE,'DD-MM-YYYY'),INTEREST_RATE FROM TBAADM.TAM, TBAADM.EIT"
	sv_s = sv_s + " WHERE TAM.ACID = ?SVAR AND EIT.ENTITY_ID = ?SVAR"
	sv_s = sv_s + " AND TAM.ACID = EIT.ENTITY_ID AND TAM.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND EIT.BANK_ID = ?SVAR"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		sv_v = "maturityDate_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.maturityDate
		sv_v = "interestRate_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.interestRate
	#}
	ELSE
	#{
		sv_v = "maturityDate_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
		sv_v = "interestRate_" + FORMAT$(sv_q, "%d")
		("CUST").("INTERFACE").(sv_v) = ""
	#}
	ENDIF

#trace off
end-->
