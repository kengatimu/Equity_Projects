<--START
CHECKSUM="10c848ab6a734bff38502e9222ab79034c68af27135d8bca54f9144c352080a9"
	TRACE ON
	print(BANCS.STDIN.menuId)
	
	IF((BANCS.STDIN.menuId) != "HACLHM") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","ACLHM") == 0) THEN
	#{
		CREATECLASS("CUST","ACLHM",5)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Initialize variables
	#--------------------------------------------------------------------------
	CUST.ACLHM.foracid=""
	CUST.ACLHM.limPrefix=""
	CUST.ACLHM.limitSuffix=""
	
	sv_q=urhk_SRV_NumOfRecs("limitLL")
	print(sv_q)
	print(BANCS.OUTPARAM.srvValue)
	CUST.ACLHM.noOfRecs = BANCS.OUTPARAM.srvValue
	
	sv_u = urhk_SRV_GetVal("limitHdr.limitAcct.foracid")
	CUST.ACLHM.foracid = BANCS.OUTPARAM.srvValue
	print(CUST.ACLHM.foracid)
	
	sv_t = 0
	WHILE(sv_t < CINT(CUST.ACLHM.noOfRecs))
	#{
		sv_u = urhk_SRV_GetVal("limitLL.<rec_"+FORMAT$(sv_t,"%d")+">.limitPrefix")
		CUST.ACLHM.limPrefix = BANCS.OUTPARAM.srvValue
		print(CUST.ACLHM.limPrefix)
		
		sv_u = urhk_SRV_GetVal("limitLL.<rec_"+FORMAT$(sv_t,"%d")+">.limitSuffix.refCode")
		CUST.ACLHM.limitSuffix = BANCS.OUTPARAM.srvValue
		print(CUST.ACLHM.limitSuffix)
		
		IF ((CUST.ACLHM.limPrefix !=  "" ) AND (CUST.ACLHM.limitSuffix != "")) THEN
		#{
			sv_a =""
			sv_a =  "count | SELECT COUNT(*) "
			sv_a = sv_a + " FROM TBAADM.LLT  WHERE DEL_FLG != 'Y' "
			sv_a = sv_a + " AND BANK_ID = ?SVAR "
			sv_a = sv_a + " AND CUST_ID = (SELECT CUST_ID FROM "
			sv_a = sv_a + " TBAADM.GAM WHERE FORACID = ?SVAR  AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N')"
			sv_a = sv_a +"  AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N' "
			sv_a = sv_a + " AND LIMIT_PREFIX = ?SVAR "
			sv_a = sv_a + " AND LIMIT_SUFFIX = ?SVAR "
			
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId+"|"+CUST.ACLHM.foracid+"|"+CUST.ACLHM.limPrefix
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.ACLHM.limitSuffix
			print(sv_a)
			
			sv_d = urhk_dbSelectWithBind(sv_a)
			print(sv_d)
			
			CUST.ACLHM.recordCount = BANCS.OUTPARAM.count
			print(CUST.ACLHM.recordCount)
			
			IF(CINT(CUST.ACLHM.recordCount)==0) THEN
			#{
				sv_u = urhk_SRV_SetErr("CIF Id for the given limit node does not match with the Account CIF.")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		sv_t= sv_t+1
		
	#}
	DO
	ENDOFSCRIPT:
		TRACE OFF
END-->
