<--START
CHECKSUM="ffe7c2e6e225c6aaf4a41fffa93fed5500ad3533994ef1086d1c81bce1b9534c"
	TRACE ON
	
	#-------------------------------------------------------------
	# Repository creation
	#-------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","UPM") == 0) THEN
	#{
		CREATECLASS("CUST","UPM",5)
	#}
	ENDIF
	
	
	sv_a = urhk_SRV_GetVal("usrGenDtl.usrId")
	CUST.UPM.addUserId = BANCS.OUTPARAM.srvValue
	print(CUST.UPM.addUserId)
	
	#-------------------------------------------------------------
	# Getting Data From Main Table for Inquire
	#-------------------------------------------------------------
	BANCS.INPARAM.BINDVARS= CUST.UPM.addUserId
	sv_s = "tempRoleId,expiryDate| "
	sv_s = sv_s + "SELECT TEMPORARY_ROLE_ID,TO_CHAR((TO_DATE(EXPIRY_DATE,'DD-MON-YY HH:MI:SS')), 'DD-MM-YYYY') "
	sv_s = sv_s + "FROM CUSTOM.C_UAD "
	sv_s = sv_s + "WHERE USER_ID =?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG = 'Y' "
	sv_s = sv_s + " AND DEL_FLG = 'N' "
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.UPM.tempRoleId = BANCS.OUTPARAM.tempRoleId
	CUST.UPM.expiryDate = BANCS.OUTPARAM.expiryDate
	print(CUST.UPM.tempRoleId)
	print(CUST.UPM.expiryDate)
	
	sv_d = ""
	sv_d = sv_d + "~upmgendet|"
	sv_d = sv_d + CUST.UPM.tempRoleId
	sv_d = sv_d + "|"
	sv_d = sv_d +  CUST.UPM.expiryDate
	sv_d = sv_d + "|"
	
	ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataOut + "|" + sv_d
	print(ONS.CUSTOM.custDataOut)
	
	ENDOFSCRIPT:
		
		#TRACE OFF
