<--start
trace on
callscriptifexist("ebRepClass.scr")
EBSRV.GLBDATA.boddate = LEFT$(BANCS.STDIN.BODDate,10)
print(EBSRV.GLBDATA.boddate)

lv_i = "insert into custom.cust_alerts_tbl ( "
lv_i = lv_i + " bank_id,cust_id,del_flg,entity_cre_flg,register_date,foracid,charge_foracid, "
lv_i = lv_i + " dr_alert_flg,dr_min_amount,cr_alert_flg,cr_min_amount,mobile_no,email_address, "
lv_i = lv_i + " activation_status,rcre_time,rcre_user,lchg_time,lchg_user) "
lv_i = lv_i + " values "
lv_i = lv_i + " (?SVAR,?SVAR, "
lv_i = lv_i + " 'N','N', "
lv_i = lv_i + " to_date(?SVAR,'DD-MM-YY'), "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " upper('"+trim(EBSRV.GLBDATA.email)+"'), "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " SYSDATE, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " SYSDATE, "
lv_i = lv_i + " ?SVAR) "
print(lv_i)

BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.custId +"|"+ EBSRV.GLBDATA.boddate +"|"+ EBSRV.GLBDATA.accNo +"|"+ EBSRV.GLBDATA.chrgAcc
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ EBSRV.GLBDATA.drAlerts +"|"+ EBSRV.GLBDATA.minDrAmt +"|"+ EBSRV.GLBDATA.crAlerts
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ EBSRV.GLBDATA.minCrAmt +"|"+ EBSRV.GLBDATA.phNum 
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ EBSRV.GLBDATA.activateFlag +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.userId
print(BANCS.INPARAM.BINDVARS)

lv_r = urhk_dbSQLWithBind(lv_i)
print(lv_r)
if(lv_r == 0) then
	EBSRV.GLBDATA.resMsg = "Customer Details Saved Successfully!! Please Verify." 
	GOTO ENDOFSCRIPT
else
	EBSRV.GLBDATA.errMsg = "FAILED!!"
	GOTO ENDOFSCRIPT
endif
ENDOFSCRIPT:
	#######################callscriptifexist("ebRepClean.scr")
        EXITSCRIPT

trace off
end-->
