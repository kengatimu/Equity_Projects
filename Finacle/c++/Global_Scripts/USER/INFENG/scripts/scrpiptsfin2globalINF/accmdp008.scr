<--START
CHECKSUM="c392d877d2c6172e11c4f338d92b16ccf966121aeb437e37f0e4c08ce2040793"
	
	TRACE ON
	CUST.CONTRACT.contractId=BANCS.INPUT.contractId
	PRINT(BANCS.STDIN.contextBankId)
	CUST.CONTRACT.successFlg ="S"
	CUST.CONTRACT.userId=BANCS.STDIN.userId
	CUST.CONTRACT.workClass=BANCS.STDIN.userWorkClass
	CUST.CONTRACT.solId = TRIM(BANCS.STDIN.mySolId)
	
	#---------------------------------------------------------
	# CHECKING whether the useriD belongs to the Maker group
	#----------------------------------------------------------
	CALL("accmdp021.scr")
	IF(CUST.CONTRACT.successFlg =="F") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Changes done by Pankaj
	# Checking user sold id with account sol id
	#------------------------------------------------------------------------------
	
	IF(CUST.CONTRACT.funcCode != "I") THEN
	#{
		CUST.CONTRACT.acctsolId = ""
		
		BANCS.INPARAM.BINDVARS =CUST.CONTRACT.acctNum + "|" + "N" + "|" + "Y"
		
		sv_s ="solId|"
		sv_s = sv_s + " SELECT SOL_ID "
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE  FORACID = ?SVAR "
		sv_s = sv_s + " AND DEL_FLG = ?SVAR "
		sv_s = sv_s + " AND ENTITY_CRE_FLG = ?SVAR"
		
		PRINT(sv_s)
		sv_u= urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		
		IF (sv_u == 0) THEN
		#{
			CUST.CONTRACT.acctsolId=BANCS.OUTPARAM.solId
			IF(CUST.CONTRACT.acctsolId != CUST.CONTRACT.solId) THEN
			#{
				CUST.INTERFACE.errorCode = "CTODA_ERR_025"
				CALL("Common_Interface_GetErrorDesc.scr")
				IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
				#{
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					CUST.CONTRACT.errorMsg = "Could not fetch Parameter value for " +  CUST.INTERFACE.errorCode
					sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^acctNum"
					sv_u = urhk_SetOrbOut(sv_z)
					CUST.CONTRACT.successFlg = "F"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CUST.CONTRACT.errorMsg=CUST.INTERFACE.errorDesc
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					print(sv_u)
					sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^acctNum")
					print(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	BANCS.INPARAM.BINDVARS= CUST.CONTRACT.contractId+ "|" + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "N" + "|"  + "N"+"|"+"N"
	sv_s ="modCount|"
	sv_s = sv_s + " SELECT COUNT (1) "
	sv_s = sv_s + " FROM CUSTOM.CATOD_SANCTION_MOD_TABLE "
	sv_s = sv_s + " WHERE REQUEST_ID=?SVAR"
	sv_s = sv_s + " AND BANK_ID=?SVAR "
	sv_s = sv_s + " AND ENTITY_CRE_FLG=?SVAR "
	sv_s = sv_s + " AND DEL_FLG=?SVAR"
	sv_s = sv_s + " AND CLS_FLG=?SVAR"
	PRINT(sv_s)
	
	sv_d=urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d!=0) THEN
	#{
		
		#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Unable to get data from database^acctNo")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.CONTRACT.modCount=BANCS.OUTPARAM.modCount
	PRINT(CUST.CONTRACT.modCount)
	
	IF(CINT(CUST.CONTRACT.modCount)==0) THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Nothing to Modify^acctNo")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#**************************************************************************************
	#Fetching the values for the front end
	#**************************************************************************************
	
	BANCS.INPARAM.BINDVARS=CUST.CONTRACT.contractId + "|"+ "N" + "|" + "N"
	
	sv_s = "conAmt,maxAmt,maxContractPeriod,contractAmt,contractPeriod,charges,acctName,lchgUserId,schmType,acctNum,solId,charges,createdDate|"
	sv_s = sv_s +" SELECT A.CONTRACT_AMT,A.MAX_CNTRT_AMT,A.MAX_CNTRT_PERIOD,"
	sv_s = sv_s +" B.REQ_AMT,B.REQ_PERIOD,B.FEE,B.ACCT_NAME,B.LCHG_USER,B.SCHM_TYPE,B.ACCT_NUM,B.SOL_ID,B.FEE,to_char(to_date(B.CREATED_DATE,'dd-mon-yy'),'dd-mm-yyyy')"
	sv_s = sv_s +" FROM CUSTOM.CATOD_MASTER_TABLE A, CUSTOM.CATOD_SANCTION_MOD_TABLE B  "
	sv_s = sv_s +"  WHERE B.REQUEST_ID=?SVAR "
	sv_s = sv_s +"  AND A.ACCT_NUM= B.ACCT_NUM "
	sv_s = sv_s +"  AND B.ENTITY_CRE_FLG=?SVAR "
	sv_s = sv_s +"  AND B.DEL_FLG=?SVAR "
	
	PRINT(sv_s)
	sv_d=urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d!=0) THEN
	#{
		
		#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Unable to get data from database^acctNo")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CONTRACT.acctName=BANCS.OUTPARAM.acctName
	CUST.CONTRACT.maxAmt= BANCS.OUTPARAM.maxAmt
	CUST.CONTRACT.contractAmt= BANCS.OUTPARAM.contractAmt
	CUST.CONTRACT.conAmt= BANCS.OUTPARAM.conAmt
	CUST.CONTRACT.contractPeriod= BANCS.OUTPARAM.contractPeriod
	CUST.CONTRACT.charges=BANCS.OUTPARAM.charges
	CUST.CONTRACT.lchgUserId=BANCS.OUTPARAM.lchgUserId
	CUST.CONTRACT.schmType= BANCS.OUTPARAM.schmType
	CUST.CONTRACT.maxContractPeriod = BANCS.OUTPARAM.maxContractPeriod
	CUST.CONTRACT.acctNum =BANCS.OUTPARAM.acctNum
	CUST.CONTRACT.solId = BANCS.OUTPARAM.solId
	CUST.CONTRACT.charges= BANCS.OUTPARAM.charges
	#----------CHANGE MADE FOR TO:361667-------------------------#
	CUST.CONTRACT.createdDate=BANCS.OUTPARAM.createdDate
	#---------- END OF CHANGE MADE FOR TO:361667-----------------#
	
	BANCS.INPARAM.BINDVARS =CUST.CONTRACT.acctNum + "|" + "N" + "|" + "Y"
	
	sv_s ="schmCode,crncyCode|"
	sv_s = sv_s + " SELECT SCHM_CODE,ACCT_CRNCY_CODE FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE  FORACID = ?SVAR "
	sv_s = sv_s + " AND DEL_FLG = ?SVAR "
	sv_s = sv_s + " AND ENTITY_CRE_FLG = ?SVAR"
	
	PRINT(sv_s)
	sv_u= urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CONTRACT.schmCode =BANCS.OUTPARAM.schmCode
		CUST.CONTRACT.crncyCode=BANCS.OUTPARAM.crncyCode
	#}
	ENDIF
	#----------------------------------
	#FETCHING THE MINIMUM AMOUNT VALUE
	#----------------------------------
	
	sv_u=urhk_getSchemeDetailsInRepository(CUST.CONTRACT.schmCode)
	CUST.CONTRACT.schmType=BANCS.OUTPARAM.SchemeType
	
	CUST.INTERFACE.errorCode=CUST.CONTRACT.schmType+"_MIN_CNTRT"
	PRINT(CUST.INTERFACE.errorCode)
	CALL("CATOD_GetParameterDesc.scr")
	IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
	#{
		CUST.INTERFACE.errorCode="ACCM_ERR_008"
		CALL("Common_Interface_GetErrorDesc.scr")
		IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.CONTRACT.errorMsg = "Could not fetch Parameter value for " +  CUST.INTERFACE.errorCode
			sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^acctNum"
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CONTRACT.successFlg = "F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CONTRACT.errorMsg=CUST.INTERFACE.errorDesc
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^acctNum")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CONTRACT.minAmt=CUST.INTERFACE.errorDesc
		PRINT(CUST.CONTRACT.minAmt)
	#}
	ENDIF
	
	
	CUST.CONTRACT.maxAmt=FORMAT$(CDOUBLE(CUST.CONTRACT.maxAmt),"%.2f")
	CUST.CONTRACT.minAmt=FORMAT$(CDOUBLE(CUST.CONTRACT.minAmt),"%.2f")
	CUST.CONTRACT.contractAmt=FORMAT$(CDOUBLE(CUST.CONTRACT.contractAmt),"%.2f")
	CUST.CONTRACT.conAmt=FORMAT$(CDOUBLE(CUST.CONTRACT.conAmt),"%.2f")
	sv_u = urhk_SetOrbOut("funcCode|"+ CUST.CONTRACT.funcCode)
	
	
	sv_u = urhk_SetOrbOut("acctname|"+ CUST.CONTRACT.acctName)
	
	
	sv_u = urhk_SetOrbOut("solId|"+ CUST.CONTRACT.solId)
	
	
	sv_u = urhk_SetOrbOut("schmCode|"+ CUST.CONTRACT.schmCode)
	
	
	sv_u = urhk_SetOrbOut("minAmount|"+ CUST.CONTRACT.minAmt)
	
	
	sv_u = urhk_SetOrbOut("maxAmount|"+ CUST.CONTRACT.conAmt)
	
	sv_u = urhk_SetOrbOut("maxContrctPeriod|"+ CUST.CONTRACT.maxContractPeriod)
	
	
	sv_u = urhk_SetOrbOut("acctNo|"+ CUST.CONTRACT.acctNum)
	
	
	sv_u = urhk_SetOrbOut("contrctAmt|"+ CUST.CONTRACT.contractAmt)
	
	
	sv_u = urhk_SetOrbOut("contractPeriod|"+ CUST.CONTRACT.contractPeriod)
	
	
	sv_u = urhk_SetOrbOut("charges|"+ CUST.CONTRACT.charges)
	
	
	sv_u = urhk_SetOrbOut("crncyCode|"+ CUST.CONTRACT.crncyCode)
	#----------CHANGE MADE FOR TO:361667-------------------------#
	
	sv_u = urhk_SetOrbOut("creDateValue|"+ CUST.CONTRACT.createdDate)
	
	#---------- END OF CHANGE MADE FOR TO:361667-----------------#
	
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	
	
	
	ENDOFSCRIPT:
		
END-->
