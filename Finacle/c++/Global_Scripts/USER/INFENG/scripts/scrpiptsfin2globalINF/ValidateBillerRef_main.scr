#----------------------------------------------------------------------------------------------------------
# Filename              :       ValidateBillerRef_main.scr
# Author                :       Venkatesh T R
# Description           :       This is the main script that gets triggered when ValidateBillerRef is called
# Input                 :       Request XML
# Output                :       Response XML
# Called Script         :       None
# Calling Script        :       Common_CreateRepos.scr, ValidateBillerRef_FetchInputDetails.scr,
#                               ValidateBillerRef_ValidateInputDetails.scr,ValidateBillerRef_DoBillerVal.scr,
#                               ValidateBillerRef_SendResponse.scr, Common_Interface_ErrorList.scr,
#								Common_Interface_ErrorExit.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           09-03-2013         Venkatesh          Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
trace on
	#urhk_B2k_PrintRepos("BANCS")
	#-------------------------------------------------------------------------------
	# Calling create repository script
	#-------------------------------------------------------------------------------
	CALL("Common_Interface_CreateRepos.scr")
	CUST.INTERFACE.successOrFailure = "S"
	CUST.INTERFACE.srvErrFlg = "N"
	#-------------------------------------------------------------------------------
	# Fetching Input Fields from FI
	#-------------------------------------------------------------------------------
	CALL("ValidateBillerRef_FetchInputDetails.scr")
	
	#-------------------------------------------------------------------------------
	# Validating Input Fields
	#-------------------------------------------------------------------------------
	CALL("ValidateBillerRef_ValidateInputDetails.scr")
	
	#-------------------------------------------------------------------------------
	# Perform validation for the Biller 
	#-------------------------------------------------------------------------------
	CALL("ValidateBillerRef_DoBillerVal.scr")
	
	#-------------------------------------------------------------------------------
	# Send Response
	#-------------------------------------------------------------------------------
	CALL("ValidateBillerRef_SendResponse.scr")
	
	ERROREXIT:
		print(CUST.INTERFACE.successOrFailure)
		IF(CUST.INTERFACE.successOrFailure == "F") THEN
		#{
			CALL("Common_Interface_ErrorExit.scr")
		#}
		ENDIF
		
		
		trace off
end-->
