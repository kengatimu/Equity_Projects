<--START
CHECKSUM="fac188dc805459ac87097b551e214ab2a77cdd3c3ab7f09bb02d9f3ac1dfc754"
	TRACE ON
	
	
	CUST.CONTRACT.bodDate=BANCS.STDIN.BODDate
	
	#validations
	IF (CINT(CUST.CONTRACT.contractAmt) < CINT(CUST.CONTRACT.minAmt)) THEN
	#{
		CUST.INTERFACE.errorCode="ACCM_ERR_017"
		CALL("Common_Interface_GetErrorDesc.scr")
		IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.CONTRACT.errorMsg = "Could not fetch Parameter value for " +  CUST.INTERFACE.errorCode
			sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt"
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CONTRACT.successFlg = "F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CONTRACT.errorMsg=CUST.INTERFACE.errorDesc
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	#-----------------------------------------------------------
	#Validate for the maximum contract amount from CPARAM
	#-----------------------------------------------------------
	BANCS.INPUT.moduleName = "CATODSCORE"
	BANCS.INPUT.parameterId = "MAXCNTRTAMT"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		sv_l = STRLEN(BANCS.OUTPUT.parameterVal)
		print(sv_l)
		CUST.CONTRACT.maxCntrctAmtCPARAM =BANCS.OUTPUT.parameterVal
		print(CUST.CONTRACT.maxCntrctAmtCPARAM)
		
		IF (CDOUBLE(CUST.CONTRACT.maxCntrctAmtCPARAM) < CDOUBLE(CUST.CONTRACT.contractAmt) ) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.CONTRACT.errorMsg = "Contract amount exceeds maximum allowed amount set in CPARAM"
			sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt"
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CONTRACT.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		CUST.CONTRACT.errorMsg = "Maximum contract amount allowed  setup is not done in CPARAM"
		sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt"
		sv_u = urhk_SetOrbOut(sv_z)
		CUST.CONTRACT.successFlg = "F"
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	IF (CINT(CUST.CONTRACT.contractAmt) > CINT(CUST.CONTRACT.maxAmt)) THEN
	#{
		CUST.INTERFACE.errorCode="ACCM_ERR_018"
		CALL("Common_Interface_GetErrorDesc.scr")
		IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.CONTRACT.errorMsg = "Could not fetch Parameter value for " +  CUST.INTERFACE.errorCode
			sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt"
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CONTRACT.successFlg = "F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CONTRACT.errorMsg=CUST.INTERFACE.errorDesc
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF ( CINT(CUST.CONTRACT.contractPeriod) > CINT( CUST.CONTRACT.maxContractPeriod)) THEN
	#{
		CUST.INTERFACE.errorCode="ACCM_ERR_019"
		CALL("Common_Interface_GetErrorDesc.scr")
		IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			CUST.CONTRACT.errorMsg = "Could not fetch Parameter value for " +  CUST.INTERFACE.errorCode
			sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt"
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CONTRACT.successFlg = "F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CONTRACT.errorMsg=CUST.INTERFACE.errorDesc
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contractPeriod")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = CUST.CONTRACT.contractId +"|"+ CUST.CONTRACT.acctNo+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "N"+"|"+"N"
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_s = "count1|"
	sv_s = sv_s + "SELECT COUNT(1) FROM CUSTOM.CATOD_SANCTION_TABLE "
	sv_s = sv_s + " WHERE REQUEST_ID=?SVAR "
	sv_s = sv_s + " AND ACCT_NUM=?SVAR "
	sv_s = sv_s + " AND DEL_FLG=?SVAR "
	sv_s = sv_s + " AND ENTITY_CRE_FLG=?SVAR"
	PRINT(sv_s)
	sv_d= urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d==0) THEN
	#{
		BANCS.INPARAM.BINDVARS=CUST.CONTRACT.bodDate+"|"+ BANCS.STDIN.userId+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ BANCS.STDIN.userId+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ CUST.CONTRACT.bodDate+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ CUST.CONTRACT.contractAmt+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ CUST.CONTRACT.contractPeriod+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ CUST.CONTRACT.charges+"|"
		#BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ CUST.CONTRACT.chargeId+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ CUST.CONTRACT.contractId+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ CUST.CONTRACT.acctNo+"|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS+ "N"+"|"+"N"
		
		
		sv_s = "UPDATE CUSTOM.CATOD_SANCTION_TABLE SET "
		sv_s = sv_s + " LCHG_DATE 		= to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),"
		sv_s = sv_s + " LCHG_USER		= ?SVAR,"
		sv_s = sv_s + " MODIFIED_BY 		= ?SVAR,"
		sv_s = sv_s + " MODIFIED_DATE 		= to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),"
		sv_s = sv_s + " REQ_AMT			= ?SVAR,"
		sv_s = sv_s + " REQ_PERIOD		= ?SVAR,"
		sv_s = sv_s + " FEE			= ?SVAR"
		#sv_s = sv_s + " FEE_TRAN_ID		= ?SVAR "
		sv_s = sv_s + " WHERE REQUEST_ID	=?SVAR "
		sv_s = sv_s + " AND ACCT_NUM		=?SVAR "
		sv_s = sv_s + " AND DEL_FLG		=?SVAR "
		sv_s = sv_s + " AND ENTITY_CRE_FLG	=?SVAR"
		PRINT(sv_s)
		sv_d= urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d==0) THEN
		#{
			
			call("accmdp025.scr")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+"Contract ID " +CUST.CONTRACT.contractId+" has been modified  successfully")
			PRINT(sv_u)
			
			PRINT("Success")
			#}
		ELSE
			#{
			
			CUST.INTERFACE.errorCode="ACCM_ERR_021"
			CALL("Common_Interface_GetErrorDesc.scr")
			IF ( CUST.INTERFACE.SuccessFlag == "1") THEN
			#{
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				CUST.CONTRACT.errorMsg = "Could not fetch Parameter value for " +  CUST.INTERFACE.errorCode
				sv_z = "Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt"
				sv_u = urhk_SetOrbOut(sv_z)
				CUST.CONTRACT.successFlg = "F"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.CONTRACT.errorMsg=CUST.INTERFACE.errorDesc
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_u = urhk_SetOrbOut("Error_0|ERROR^" + CUST.CONTRACT.errorMsg + "^contrctAmt")
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	PRINT(sv_u)
	
	ENDOFSCRIPT:
