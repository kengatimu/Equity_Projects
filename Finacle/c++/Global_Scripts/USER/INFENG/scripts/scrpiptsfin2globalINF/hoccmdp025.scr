##########################################################################################
# Source Name           : hoccmdp025.scr
# Date                  : 20-Aug-2013
# Description           : This script gets called from crit page link file for fetching
#			: Set Num searcher list.
# Author                : Priyanka T
# Modification History  :
# <Serial No.>  <Date>        <Author Name>             <Description>
# ------------  -----------   -----------------         --------------
#      0.1        20-Aug-2013    Priyanka T               Base Version
###########################################################################################

<--START
CHECKSUM="ecf1fb86c06d9d6a0a6e573c71ea4c5a673a6165ebeb8c6293e90e3a41e83549"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "HOCCM") == 0) THEN
	#{
		CREATECLASS("CUST", "HOCCM", 5)
	#}
	ENDIF
	
	#-------------------------------------------------
	# Intializing the variables
	#-------------------------------------------------
	CUST.HOCCM.zoneCode = " "
	CUST.HOCCM.zoneDate = " "
	CUST.HOCCM.solId = " "
	CUST.HOCCM.bankId = " "
	CUST.HOCCM.setNum = " "
	CUST.HOCCM.noOfChq = " "
	CUST.HOCCM.foracid = " "
	CUST.HOCCM.acctName = " "
	
	#--------------------------------------------------------------------------
	# Getting Input at Backend
	#--------------------------------------------------------------------------
	
	CUST.HOCCM.zoneCode =  TOUPPER(TRIM(BANCS.INPUT.zoneCode))
	print(CUST.HOCCM.zoneCode)
	CUST.HOCCM.zoneDate =  TOUPPER(TRIM(BANCS.INPUT.zoneDate))
	print(CUST.HOCCM.zoneDate)
	CUST.HOCCM.solId = TRIM(BANCS.STDIN.mySolId)
	print(CUST.HOCCM.solId)
	CUST.HOCCM.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.HOCCM.bankId)
	
	#-----------------------------------------
	# Fetching the Record count
	#-----------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.HOCCM.zoneCode + "|" + CUST.HOCCM.zoneDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.solId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.bankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "recordCount|SELECT COUNT(DISTINCT(SET_NUM)) "
	sv_s = sv_s + " FROM TBAADM.OCI "
	sv_s = sv_s + " WHERE CLG_ZONE_CODE = ?SVAR "
	sv_s = sv_s + " AND CLG_ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND TRIM(STATUS_FLG) IS NULL"
	sv_s = sv_s + " AND SOL_ID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.HOCCM.recordCount = BANCS.OUTPARAM.recordCount
		print(CUST.HOCCM.recordCount)
	#}
	ENDIF
	
	IF(CUST.HOCCM.recordCount == "0")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SetOrbOut("recordCount|"+CUST.HOCCM.recordCount)
	print(sv_u)
	
	#--------------------------------------------------------------------------
	# Fetching Set Num from OCI table
	#--------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.HOCCM.zoneCode + "|" + CUST.HOCCM.zoneDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.solId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.bankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "setNum|SELECT DISTINCT(SET_NUM) "
	sv_s = sv_s + " FROM TBAADM.OCI "
	sv_s = sv_s + " WHERE CLG_ZONE_CODE = ?SVAR "
	sv_s = sv_s + " AND CLG_ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND TRIM(STATUS_FLG) IS NULL"
	sv_s = sv_s + " AND SOL_ID = ?SVAR "
	sv_s = sv_s + " AND BANK_ID = ?SVAR "
	print(sv_s)
	sv_c =urhk_dbCursorOpenWithBind(sv_s)
	IF (sv_c != 0 ) THEN
	#{
		CUST.HOCCM.errMsg = "Cursor opening failed"
		print(CUST.HOCCM.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(sv_n)
	sv_f = urhk_dbCursorFetch(sv_n)
	PRINT(sv_f)
	sv_i = 1
	WHILE(sv_f == 0)
	#{
		CUST.HOCCM.setNum = BANCS.OUTPARAM.setNum
		print(CUST.HOCCM.setNum)
		
		#--------------------------------------------------------------------------
		# Fetching the values from OCP table and populating
		# the searcher list
		#--------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = CUST.HOCCM.zoneCode + "|" + CUST.HOCCM.zoneDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.solId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.bankId
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "foracid,acctName|"
		#sv_s = sv_s + " SELECT DISTINCT(g.FORACID),replace(g.ACCT_NAME,'''','&#8217') "
		sv_s = sv_s + " SELECT DISTINCT(g.FORACID),g.ACCT_NAME "
		sv_s = sv_s + " FROM TBAADM.OCP p, TBAADM.GAM g "
		sv_s = sv_s + " WHERE p.CLG_ZONE_CODE = ?SVAR "
		sv_s = sv_s + " AND p.CLG_ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND TRIM(STATUS_FLG) IS NULL "
		sv_s = sv_s + " AND p.SET_NUM = '" + CUST.HOCCM.setNum + "' "
		sv_s = sv_s + " AND p.SOL_ID = ?SVAR "
		sv_s = sv_s + " AND p.BANK_ID = ?SVAR "
		sv_s = sv_s + " AND g.ACID = p.ACID "
		sv_s = sv_s + " AND g.BANK_ID = p.BANK_ID "
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d == 0)THEN
		#{
			CUST.HOCCM.foracid = BANCS.OUTPARAM.foracid
			print(CUST.HOCCM.foracid)
			CUST.HOCCM.acctName = BANCS.OUTPARAM.acctName
			print(CUST.HOCCM.acctName)
			#}
		ELSE
			#{
			CUST.HOCCM.errMsg = "Could not fetch account details"
			print(CUST.HOCCM.errMsg)
			GOTO NEXTFETCH
		#}
		ENDIF
		
		#--------------------------------------------------------------------------
		# Fetching No of Cheque from OCI table.
		#--------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = CUST.HOCCM.zoneCode + "|" + CUST.HOCCM.zoneDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.solId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.bankId
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "noOfChq,tranAmt|"
		sv_s = sv_s + " SELECT COUNT(SET_NUM),SUM(INSTRMNT_AMT)"
		sv_s = sv_s + " FROM TBAADM.OCI "
		sv_s = sv_s + " WHERE CLG_ZONE_CODE = ?SVAR "
		sv_s = sv_s + " AND SET_NUM = '" + CUST.HOCCM.setNum + "' "
		sv_s = sv_s + " AND CLG_ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND SOL_ID = ?SVAR "
		sv_s = sv_s + " AND BANK_ID = ?SVAR "
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0)THEN
		#{
			IF(BANCS.OUTPARAM.noOfChq != 0)THEN
			#{
				
				CUST.HOCCM.noOfChq = BANCS.OUTPARAM.noOfChq
				print(CUST.HOCCM.noOfChq)
				CUST.HOCCM.tranAmt = BANCS.OUTPARAM.tranAmt
				CUST.HOCCM.tranAmt = FORMAT$(CDOUBLE(CUST.HOCCM.tranAmt),"%.2f")
				print(CUST.HOCCM.tranAmt)
				#}
			ELSE
				#{
				CUST.HOCCM.errMsg = "Could not fetch data"
				print(CUST.HOCCM.errMsg)
				sv_z = "noOfChq|" + CUST.HOCCM.errMsg
				sv_u = urhk_SetOrbOut(sv_z)
				GOTO NEXTFETCH
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.HOCCM.errMsg = "Could not fetch data"
			print(CUST.HOCCM.errMsg)
			sv_z = "Error|" + CUST.HOCCM.errMsg
			sv_u = urhk_SetOrbOut(sv_z)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		sv_s = "setNum_" + Format$(sv_i,"%d") + "|" + CUST.HOCCM.setNum
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "foracid_" + Format$(sv_i,"%d") + "|" + CUST.HOCCM.foracid
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "acctName_" + Format$(sv_i,"%d") + "|" + CUST.HOCCM.acctName
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "noOfChq_" + Format$(sv_i,"%d") + "|" + CUST.HOCCM.noOfChq
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "tranAmt_" + Format$(sv_i,"%d") + "|" + CUST.HOCCM.tranAmt
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		NEXTFETCH:
			sv_i = sv_i + 1
			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_n)
		PRINT(sv_c)
		
		
		
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
END-->
