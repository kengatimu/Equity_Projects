#-------------------------------------------------------------------------------
# Validating the Original Transaction ID 
#-------------------------------------------------------------------------------
lv_q = "count|SELECT count(*)"
lv_q = lv_q + " FROM TBAADM.DCTD_ACLI"
lv_q = lv_q + " WHERE TRAN_ID = '" +CUST.INTERFACE.OrgTranID + "'"
lv_q = lv_q + " AND TRAN_DATE = to_date('" + CUST.INTERFACE.OrgTranDate + "','DD-MM-YYYY')"
lv_q = lv_q + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "'"
	
lv_e = urhk_dbSelectWithBind(lv_q)
lv_p=BANCS.OUTPARAM.count

	
IF(lv_p == 0)THEN
#{
	CUST.INTERFACE.errorCode = "ERR085" 
	CUST.INTERFACE.successOrFailure = "F"
	
	GOTO FINISH
#}
ELSE
#{
	lv_q = "tranamount,instrumentnum,instrumentdate,instrumentalpha|SELECT TRAN_AMT,INSTRMNT_NUM,"
	lv_q = lv_q + " to_char(INSTRMNT_DATE,'DD-MM-YYYY'),INSTRMNT_ALPHA FROM TBAADM.DCTD_ACLI"
	lv_q = lv_q + " WHERE TRAN_ID = '" + CUST.INTERFACE.OrgTranID + "'"
	lv_q = lv_q + " AND TRAN_DATE = to_date('" + CUST.INTERFACE.OrgTranDate + "','DD-MM-YYYY')"
	lv_q = lv_q + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "' AND rownum=1 "
	
	lv_e = urhk_dbSelectWithBind(lv_q)

	lv_p = CDOUBLE(BANCS.OUTPARAM.tranamount)
	lv_r = BANCS.OUTPARAM.instrumentnum
	lv_s = BANCS.OUTPARAM.instrumentdate
	
	CUST.INTERFACE.OrgTranAmt = CDOUBLE(BANCS.OUTPARAM.tranamount)
	CUST.INTERFACE.InstrAlpha = BANCS.OUTPARAM.instrumentalpha

	IF((lv_p != CDOUBLE(CUST.INTERFACE.DrTranAmt)) OR (lv_p != CDOUBLE(CUST.INTERFACE.CrTranAmt)) )THEN
	#{
		CUST.INTERFACE.errorCode = "ERR086" 
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	#}
	ENDIF


#}
ENDIF

#-------------------------------------------------------------------------------
# Validating the Reject Reason Code 
#-------------------------------------------------------------------------------
lv_q = "count|SELECT count(*)"
	lv_q = lv_q + " FROM TBAADM.CRC"
	lv_q = lv_q + " WHERE CLG_REJ_CODE = '" + CUST.INTERFACE.RejResCode + "'"
	lv_q = lv_q + " AND DEL_FLG = 'N' "
	lv_q = lv_q + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "'"
	
	lv_e = urhk_dbSelectWithBind(lv_q)
	lv_p=BANCS.OUTPARAM.count
	
IF(lv_p == 0)THEN
#{
	CUST.INTERFACE.errorCode = "ERR087" 
	CUST.INTERFACE.successOrFailure = "F"
	
	GOTO FINISH
#}
ENDIF


