			GOTO FINISH	
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
  #}
  ENDIF
print(CUST.INTERFACE.CrSchmType)
#-------------------------------------------------------------------------------
# Validating the DD Number
#-------------------------------------------------------------------------------
IF(CUST.INTERFACE.CrSchmType == "DDA") THEN
#{	
        IF(CUST.INTERFACE.CrSchmType == "DDA") THEN
        #{
              IF(CUST.INTERFACE.CrSchmCode == "DIVID")THEN
                     CUST.INTERFACE.InstrType = "DIV"
