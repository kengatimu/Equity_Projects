<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################
#sv_r=urhk_B2k_PrintRepos("BANCS")
#print (sv_r)

CUST.DATA.instnum = BANCS.INPUT.instnum
print(CUST.DATA.instnum)

CUST.DATA.ddIssDate = BANCS.INPUT.ddIssDate
print(CUST.DATA.ddIssDate)

CUST.DATA.bankCode = BANCS.INPUT.bankCode
print(CUST.DATA.bankCode)

CUST.DATA.brCode = BANCS.INPUT.brCode
print(CUST.DATA.brCode)

############################################
# Fetching the value from table
############################################
### modified query added dd date condition

sv_q = "trnId|"
sv_q = sv_q + "select tran_id"
sv_q = sv_q + " from tbaadm.ddd"
sv_q = sv_q + " where trim(dd_num) = ?SVAR"
sv_q = sv_q + " and bank_id = ?SVAR"
sv_q = sv_q + " and DD_DATE = to_date(?SVAR,'dd-mm-yyyy')"
sv_q = sv_q + " and br_code = ?SVAR"
sv_q = sv_q + " and bank_code = ?SVAR"
sv_q = sv_q + " and sol_id = ?SVAR"
sv_q = sv_q + " and del_flg = 'N'"
print(sv_q)

BANCS.INPARAM.BINDVARS 	= CUST.DATA.instnum + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.ddIssDate + "|" + CUST.DATA.brCode + "|" + CUST.DATA.bankCode + "|" + CUST.DATA.brCode
print(BANCS.INPARAM.BINDVARS)

sv_p= urhk_dbSelectWithBind(sv_q)
IF (sv_p == 0) THEN
#{
	CUST.DATA.trnId = BANCS.OUTPARAM.trnId
	print(CUST.DATA.trnId)
	sv_z = urhk_SetOrbOut("output|"+CUST.DATA.trnId)
	print(sv_z)
#}
ENDIF
trace off
end-->
