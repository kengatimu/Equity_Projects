<--start

if(repexists("CUST")==0)then
        createrep("CUST")
endif
if(classexists("CUST","DATA")==0)then
        createclass("CUST","DATA",5)
endif

CUST.DATA.TRANID = sv_a
print(CUST.DATA.TRANID)      
	
sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
print(sv_u)
if(sv_u == 0) then
	CUST.DATA.TRANID  = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.TRANID)
else
	CUST.DATA.TRANID  = ""
endif
sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranDate")
print(sv_u)
if(sv_u == 0) then
	CUST.DATA.TRANDATE  = MID$(BANCS.OUTPARAM.srvValue,0,10) 
	print(CUST.DATA.TRANDATE)
else
	CUST.DATA.TRANDATE  = ""
endif


lv_a =""
lv_a = lv_a + " MakerUserId | select distinct ENTRY_USER_ID   from tbaadm.dth, tbaadm.dtd where dth.bank_id = '"+BANCS.STDIN.contextBankId+"' "
lv_a = lv_a + " and ((B2K_EVENT_TYPE in ('TTUMP','SLUPR')) or (MODULE_ID = 'SAL')) and dtd.tran_id =dth.tran_id and dth.tran_id ='"+CUST.DATA.TRANID+"'  "
lv_a = lv_a + " and dtd.tran_date =dth.tran_date and dtd.bank_id =dth.bank_id and to_char (dth.tran_date,'DD-MM-YYYY') = '"+CUST.DATA.TRANDATE+"' and rownum = 1 "
PRINT(lv_a)
lv_z = urhk_dbSelectWithBind(lv_a)
print(lv_z)
IF(lv_z==0) THEN
	lv_q = BANCS.OUTPARAM.MakerUserId
        print(lv_q)
	IF (lv_q == BANCS.STDIN.userId) THEN
		sv_u = urhk_SRV_SetErr("Error:Same HTTUM,CSALBPP,CELPP Maker can not Post transaction")
                BANCS.OUTPUT.successOrFailure="F"
		exitscript
	ENDIF
else
	exitscript
ENDIF

ENDOFSCRIPT:
exitscript
