<--START
TRACE ON

  #---------------------------------------------------------
        # Create the necessary repos and classes
        #---------------------------------------------------------

        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

        #---------------------------------------------------------
        #       Bancs Repository Printing
        #---------------------------------------------------------
        sv_x = urhk_B2k_PrintRepos("BANCS")
        PRINT(sv_x)

        CUST.DATA.succFail="F"
        CUST.DATA.count = "0"
	CUST.DATA.tranId = ""

        IF(FIELDEXISTS(BANCS.INPUT.nationalId)==0) THEN
        #{
                CUST.DATA.nationalId = ""
        #}
        ELSE
        #{
                CUST.DATA.nationalId = BANCS.INPUT.nationalId
                PRINT(CUST.DATA.nationalId)
        #}
        ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.passportId)==0) THEN
        #{
                CUST.DATA.passportId = ""
        #}
        ELSE
        #{
                CUST.DATA.passportId = BANCS.INPUT.passportId
                PRINT(CUST.DATA.passportId)
        #}
        ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.birthCertificate)==0) THEN
        #{
                CUST.DATA.birthCertificate = ""
        #}
        ELSE
        #{
                CUST.DATA.birthCertificate = BANCS.INPUT.birthCertificate
                PRINT(CUST.DATA.birthCertificate)
        #}
        ENDIF

	IF((CUST.DATA.nationalId == "") and (CUST.DATA.passportId == "") and (CUST.DATA.birthCertificate == ""))THEN
	#{
		sv_u = urhk_SetOrbOut("Failed| Please enter either Passport Id or National Id or Birth Certificate")
                print(sv_u)
		
		EXITSCRIPT
	#}
	ENDIF

	IF((CUST.DATA.nationalId != "") and (CUST.DATA.passportId != ""))THEN
        #{
                sv_u = urhk_SetOrbOut("Failed| Please enter either Passport Id or National Id ")
                print(sv_u)

                EXITSCRIPT
        #}
        ENDIF

	IF(CUST.DATA.nationalId != "")THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.nationalId+ "|" +BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)

		sv_a = "cifId,custFirstName,custLastName,custPoneNo|select accounts.orgkey,accounts.cust_first_name,accounts.cust_last_name,accounts.preferredphone"
		sv_a = sv_a + " from crmuser.accounts,crmuser.entitydocument "
		sv_a = sv_a + " where uniqueid=?SVAR and referencenumber=uniqueid and accounts.bank_id=?SVAR and doccode='DOC03' "
		sv_a = sv_a + " and accounts.bank_id=entitydocument.bank_id and rownum<5"
		print(sv_a)
	#}
	ENDIF

	IF(CUST.DATA.passportId != "")THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.passportId+ "|" +BANCS.STDIN.contextBankId
                print(BANCS.INPARAM.BINDVARS)

                sv_a = "cifId,custFirstName,custLastName,custPoneNo|select accounts.orgkey,accounts.cust_first_name,accounts.cust_last_name,accounts.preferredphone"
                sv_a = sv_a + " from crmuser.accounts,crmuser.entitydocument "
                sv_a = sv_a + " where uniqueid=?SVAR and referencenumber=uniqueid and accounts.bank_id=?SVAR and doccode='PSSPR' "
                sv_a = sv_a + " and accounts.bank_id=entitydocument.bank_id and rownum<5"
                print(sv_a)
	#}
	ENDIF

	IF(CUST.DATA.birthCertificate != "")THEN
        #{
                BANCS.INPARAM.BINDVARS = CUST.DATA.birthCertificate+ "|" +BANCS.STDIN.contextBankId
                print(BANCS.INPARAM.BINDVARS)

                sv_a = "cifId,custFirstName,custLastName,custPoneNo|select accounts.orgkey,accounts.cust_first_name,accounts.cust_last_name,accounts.preferredphone"
                sv_a = sv_a + " from crmuser.accounts,crmuser.entitydocument "
                sv_a = sv_a + " where uniqueid=?SVAR and referencenumber=uniqueid and accounts.bank_id=?SVAR and doccode='BIRCT' "
                sv_a = sv_a + " and accounts.bank_id=entitydocument.bank_id and rownum<5"
                print(sv_a)
        #}
        ENDIF
	
        sv_d = urhk_dbCursorOpenWithBind(sv_a)
        print(sv_d)

        IF(sv_d!=0) THEN
        #{
                sv_u = urhk_dbCursorClose(sv_a)
                print(sv_u)

		sv_u = urhk_SetOrbOut("Status| No record found")
                print(sv_u)
        #}
        ELSE
        #{
                CUST.DATA.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(CUST.DATA.DB_CURSOR_NUMBER)


                sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
                print(sv_c)

		IF(sv_c != "0")THEN
		#{
			#sv_e = urhk_SetOrbOut("SuccessorFailure|Sucess")
			#sv_u = urhk_SetOrbOut("CifId| "+CUST.DATA.cifId)
			#sv_u = urhk_SetOrbOut("CustFirstName| "+CUST.DATA.custFirstName)
			#sv_u = urhk_SetOrbOut("CustLastName| "+CUST.DATA.custLastName)
			#sv_u = urhk_SetOrbOut("CustPhoneNo| "+CUST.DATA.custPoneNo)
			sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
			sv_u = urhk_SetOrbOut("Failure| No record found")	
			print(sv_u) 
		#}
		ENDIF

                while(sv_c ==0)
                #{
			CUST.DATA.cifId = BANCS.OUTPARAM.cifId
                        print(CUST.DATA.cifId)
                        CUST.DATA.custFirstName = BANCS.OUTPARAM.custFirstName
                        print(CUST.DATA.custFirstName)
                        CUST.DATA.custLastName = BANCS.OUTPARAM.custLastName
                        print(CUST.DATA.custLastName)
                        CUST.DATA.custPoneNo = BANCS.OUTPARAM.custPoneNo
                        print(CUST.DATA.custPoneNo)
                        
			CUST.DATA.count = CINT(CUST.DATA.count)+ 1
                        print(CUST.DATA.count)

                        #sv_c = urhk_SetOrbOut("recordCount|" +CUST.DATA.count)
                        #print(sv_c)

                        sv_c = urhk_SetOrbOut("CustomerDetails.<rec_"+CUST.DATA.count+">.CifId"+"| "+CUST.DATA.cifId)
                        print(sv_c)
                        
			sv_c = urhk_SetOrbOut("CustomerDetails.<rec_"+CUST.DATA.count+">.CustFirstName"+"| "+CUST.DATA.custFirstName)
                        print(sv_c)
                        
			sv_c = urhk_SetOrbOut("CustomerDetails.<rec_"+CUST.DATA.count+">.CustLastName"+"| "+CUST.DATA.custLastName)
                        print(sv_c)
                        
			sv_c = urhk_SetOrbOut("CustomerDetails.<rec_"+CUST.DATA.count+">.CustPhoneNo"+"| "+CUST.DATA.custPoneNo)
                        print(sv_c)

                        sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
                        print(sv_c)

                        #CUST.DATA.count = CINT(CUST.DATA.count)+ 1
                #}
                do
                sv_c = urhk_dbCursorClose(CUST.DATA.DB_CURSOR_NUMBER)
                print(sv_c)
        #}
        ENDIF

EXITSCRIPT




