<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_r = urhk_MTTS_Close("")
        print(sv_r)
        BANCS.INPARAM.PostTranFlg               = "Y"
        BANCS.INPARAM.CommitFlg                 = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
        BANCS.INPARAM.ValidationFlag            = "Y"
        BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw          = "Y"
        BANCS.INPARAM.CheckExceptions           = "N"
        sv_u = urhk_MTTS_Initialize("")
        print(sv_u)
        if(sv_u != 0 )then
                goto EndScr
        endif
        sv_r = repexists("MTT")
        if(sv_r == 0)then
                createrep("MTT")
        endif
        sv_r = classexists("MTT","TranDetails")
        if(sv_r == 0)then
                createclass("MTT","TranDetails",5)
        endif
        MTT.TranDetails.TranDate="0"
        MTT.TranDetails.TranType = "T"
        MTT.TranDetails.TranSubType = "BI"
        MTT.TranDetails.IgnoreExcp = "I"
        MTT.TranDetails.Consolidate = "Y"
        MTT.TranDetails.Remarks = "EFT Dr/Cr Sweeps" 
        MTT.TranDetails.ValidationFlag = "Y"
        MTT.TranDetails.PostTranFlg = "Y"
        MTT.TranDetails.CheckExceptions = "Y"
        MTT.TranDetails.PostFlag        = "Y"
        MTT.TranDetails.CommitFlg       = "Y"
        sv_u = urhk_MTTS_DefineTransaction("eftdrcrsweep")
        print(sv_u)
        if(sv_u != 0 ) then
                GOTO EndScr
        endif
        EQSRV.GLBDATA.srvErrCode = ""
        EQSRV.GLBDATA.srvErrMsg = ""
        EQSRV.GLBDATA.srvSucFail = ""
	EQSRV.GLBDATA.dtChk = left$(BANCS.STDIN.BODDate,10)
	print(EQSRV.GLBDATA.dtChk)
	#################EQSRV.GLBDATA.eftCrId = "0003000106378" 	
	#################lv_q = "--0003000106425 EFT Inward Credit / 0003000100774 
	EQSRV.GLBDATA.eftCrId = "0003000106425"
	lv_q = "moduleId,TranAmt | "
	lv_q = lv_q + " select 'EFTC',decode(part_tran_type,'C',1*nvl(sum(tran_amt),0),-1*nvl(sum(tran_amt),0)) from tbaadm.dtd where bank_id=?SVAR and pstd_flg='Y' and del_flg='N' and pstd_user_id is not null and pstd_date is not null and tran_date<=to_date(?SVAR,'DD-MM-RR') "
	#---Edwin to exempt sweep entry :  INC0160643 14112022
	if(EQSRV.GLBDATA.dtChk=="24-05-2023")then
	###lv_q = lv_q + " and tran_particular <> 'EFT DR CR SWEEP-10-02-2022' "  
	lv_q = lv_q + " and tran_particular <> 'SWEEP INWARDEFT' and TRAN_RMKS <> 'SWEEP INWARDEFT' "
	endif
	lv_q = lv_q + " and exists(select 1 from tbaadm.gam where bank_id=?SVAR and gam.acid=dtd.acid and gam.foracid=?SVAR and acct_cls_date is null and acct_ownership<>'C' and entity_cre_flg='Y' and del_flg='N') group by part_tran_type union " 
	##################--0001100206426 EFT Inward Debit / 0001100200414
	##################EQSRV.GLBDATA.eftDrId = "0001100206380"
	EQSRV.GLBDATA.eftDrId = "0001100206426"
	lv_q = lv_q + " select 'EFTD',decode(part_tran_type,'C',1*nvl(sum(tran_amt),0),-1*nvl(sum(tran_amt),0)) from tbaadm.dtd where bank_id=?SVAR and pstd_flg='Y' and del_flg='N' and pstd_user_id is not null and pstd_date is not null and tran_date<=to_date(?SVAR,'DD-MM-RR') and exists(select 1 from tbaadm.gam where bank_id=?SVAR and gam.acid=dtd.acid and gam.foracid=?SVAR and acct_cls_date is null and acct_ownership<>'C' and entity_cre_flg='Y' and del_flg='N') group by part_tran_type "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.eftCrId + "|" + BANCS.STDIN.contextBankId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.eftDrId 
	####BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.eftCrId + "|" + BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.eftDrId 
	print(lv_q)
	print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(lv_q)
        if(sv_u==0)then
                EQSRV.GLBDATA.dtdCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
        EQSRV.GLBDATA.ddaRec = 0
        sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.dtdCurNum)
        if(sv_z!=0)then
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto Endofscript
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
		EQSRV.GLBDATA.moduleId = BANCS.OUTPARAM.moduleId
		EQSRV.GLBDATA.TranAmt = BANCS.OUTPARAM.TranAmt
		print(EQSRV.GLBDATA.moduleId)
		print(EQSRV.GLBDATA.TranAmt)
		if(EQSRV.GLBDATA.moduleId=="EFTC")then
			if(cdouble(EQSRV.GLBDATA.TranAmt)<0)then
				EQSRV.GLBDATA.drAcctId = "0003000100774"	
				EQSRV.GLBDATA.crAcctId = EQSRV.GLBDATA.eftCrId
				EQSRV.GLBDATA.tranAmt = -1 * cdouble(EQSRV.GLBDATA.TranAmt) 
				print(EQSRV.GLBDATA.drAcctId)
				print(EQSRV.GLBDATA.crAcctId)
				print(EQSRV.GLBDATA.tranAmt)
			endif
			if(cdouble(EQSRV.GLBDATA.TranAmt)>0)then
				EQSRV.GLBDATA.drAcctId = EQSRV.GLBDATA.eftCrId 
				EQSRV.GLBDATA.crAcctId = "0003000100774" 
				EQSRV.GLBDATA.tranAmt = EQSRV.GLBDATA.TranAmt 
				print(EQSRV.GLBDATA.drAcctId)
				print(EQSRV.GLBDATA.crAcctId)
				print(EQSRV.GLBDATA.tranAmt)
			endif
		endif
		if(EQSRV.GLBDATA.moduleId=="EFTD")then
			if(cdouble(EQSRV.GLBDATA.TranAmt)<0)then
				EQSRV.GLBDATA.drAcctId = "0001100200414"
				EQSRV.GLBDATA.crAcctId = EQSRV.GLBDATA.eftDrId
				EQSRV.GLBDATA.tranAmt = -1 * cdouble(EQSRV.GLBDATA.TranAmt) 
				print(EQSRV.GLBDATA.drAcctId)
				print(EQSRV.GLBDATA.crAcctId)
				print(EQSRV.GLBDATA.tranAmt)
			endif
			if(cdouble(EQSRV.GLBDATA.TranAmt)>0)then
				EQSRV.GLBDATA.drAcctId = EQSRV.GLBDATA.eftDrId 
				EQSRV.GLBDATA.crAcctId = "0001100200414"
				EQSRV.GLBDATA.tranAmt = EQSRV.GLBDATA.TranAmt 
				print(EQSRV.GLBDATA.drAcctId)
				print(EQSRV.GLBDATA.crAcctId)
				print(EQSRV.GLBDATA.tranAmt)
			endif
		endif
		if((EQSRV.GLBDATA.drAcctId!="")and(EQSRV.GLBDATA.crAcctId!="")and(cdouble(EQSRV.GLBDATA.tranAmt)>0))then
                MTT.PartTranDetails.Account = EQSRV.GLBDATA.drAcctId 
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.ValueDate   =  "0"
		if(EQSRV.GLBDATA.crAcctId=="0001100200414")then
			MTT.PartTranDetails.Particulars = "REQUEST ACCEPTED" 
		endif
		if(EQSRV.GLBDATA.drAcctId=="0001100200414")then
			MTT.PartTranDetails.Particulars = "OUTWARD DIRECT"
		endif
		if((EQSRV.GLBDATA.drAcctId!="0001100200414") and(EQSRV.GLBDATA.crAcctId!="0001100200414"))then
			MTT.PartTranDetails.Particulars = "eft dr cr sweep"
		endif
                MTT.PartTranDetails.RefAmount = -1*cdouble(EQSRV.GLBDATA.tranAmt)
                print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = ""
                MTT.PartTranDetails.RefNum = ""
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "Y"
                MTT.PartTranDetails.TranIdentifier = "eftdrcrsweep"
                print(MTT.PartTranDetails.TranIdentifier)
                sv_e = "PurchaseIncome"
                sv_r = urhk_MTTS_definePartTran(sv_e)
                print(sv_r)
                if (sv_r != 0) then
                        BANCS.OUTPUT.successOrFailure = "F"
                        print(MTT.Error.Description)
                        MTT.Error.Description="Could not Create Part tran for collection of WTH"
                        sv_r = urhk_MTTS_ReportErrorCondition("")
                        print(sv_r)
                        sv_r = BANCS.OUTPARAM.MTTErrorDesc
                        print(sv_r)
                        GOTO EndScr
                endif
                MTT.PartTranDetails.Account = EQSRV.GLBDATA.crAcctId 
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.ValueDate           =  "0"
		if(EQSRV.GLBDATA.crAcctId=="0001100200414")then
			MTT.PartTranDetails.Particulars = "REQUEST ACCEPTED" 
		endif
		if(EQSRV.GLBDATA.drAcctId=="0001100200414")then
			MTT.PartTranDetails.Particulars = "OUTWARD DIRECT"
		endif
		if((EQSRV.GLBDATA.drAcctId!="0001100200414") and(EQSRV.GLBDATA.crAcctId!="0001100200414"))then
			MTT.PartTranDetails.Particulars = "eft dr cr sweep"
		endif
                MTT.PartTranDetails.RefAmount = 1 * cdouble(EQSRV.GLBDATA.tranAmt) 
                print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = ""
                MTT.PartTranDetails.RefNum = ""
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "Y"
                MTT.PartTranDetails.TranIdentifier = "eftdrcrsweep"


                sv_r = urhk_MTTS_definePartTran("eftdrcrsweep")
                if (sv_r == 1) then
                        EQSRV.GLBDATA.expErrMsg = "Unable to define part-tran."
                        goto EndScr
                endif
                sv_u = urhk_MTTS_EndDefinition("")
                print(sv_u)
                EQSRV.GLBDATA.TranId = BANCS.OUTPARAM.MTTTranId
                print(EQSRV.GLBDATA.TranId)

                print(MTT.XCPN.NumExceptions)
		print(MTT.XCPN.NumWarnings)
                if((MTT.XCPN.NumExceptions >= 1) or (MTT.XCPN.NumWarnings >= 1)) then
                        sv_u = urhk_MTTS_HandleExceptions("POST")
                        if (sv_u != 0) then
                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                print (MTT.Error.Description)
                        endif
                else
                        sv_u = urhk_MTTS_HandleExceptions("POST")
                        if (sv_u != 0) then
                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                print (MTT.Error.Description)
                        endif
                endif
			
		else
			goto NXTREC
		endif
		NXTREC:
                sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.dtdCurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.dtdCurNum)
                        print(sv_u)
                        EQSRV.GLBDATA.srvErrMsg =  "lara Cursor Fetch Failed"
                        EQSRV.GLBDATA.srvErrCode = "DBCursor"
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto Endofscript
                endif
                EQSRV.GLBDATA.ddaRec = cint(EQSRV.GLBDATA.ddaRec) + 1
                EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.ddaRec
                print(EQSRV.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.dtdCurNum)
        print(sv_u)
trace off
end-->
