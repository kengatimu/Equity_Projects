<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("EQSRV")==0)then
        #{
                createrep("EQSRV")
        #}
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
        #{
                createclass("EQSRV","GLBDATA",5)
        #}
        endif
        EQSRV.GLBDATA.srvErrMsg = ""
        EQSRV.GLBDATA.srvErrCode = ""
        EQSRV.GLBDATA.srvSucFail = ""
        EQSRV.GLBDATA.machineId = ""
        sv_u = urhk_getEnv("HOST_NAME")
        print(BANCS.OUTPARAM.envValue)
        EQSRV.GLBDATA.machineId = BANCS.OUTPARAM.envValue
	EBSRV.GLBDATA.machineId = BANCS.OUTPARAM.envValue
        lv_q = " shdlNum,flowId,crAcid,drAcid,dmdDate,dmdovduDate,dmdAmt,dmdAmtRounded,totAdjAmt,totDueAmt,numOdpay,monthofPay | select shdl_num,flow_id,od_acid,op_acid,to_char(dmd_date,'DD-MM-YYYY'),to_char(dmd_ovdu_date,'DD-MM-YYYY'),dmd_amt,round(dmd_amt),tot_adj_amt,dmd_amt-tot_adj_amt,free_text_1 as numberofpayMonths,free_text_2 as monthofPay "
        lv_q = lv_q + " from custom.odla_dmd_tbl where bank_id=?SVAR and dmd_amt>0 "
        lv_q = lv_q + " and entity_cre_flg='Y' and del_flg='N' and dmd_amt-tot_adj_amt>0 "
        lv_q = lv_q + " and od_acid=?SVAR "
        lv_q = lv_q + " and flow_id in ('PRDEM','INDEM') "
        lv_q = lv_q + " order by dmd_date "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.odAcid
        print(lv_q)
        print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(lv_q)
        if(sv_u==0)then
        #{
                EQSRV.GLBDATA.dlscdhNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        #}
        else
        #{
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        EQSRV.GLBDATA.ddaRec = 0
        sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.dlscdhNum)
        if(sv_z!=0)then
        #{
		IF(EBSRV.GLBDATA.cClearBalance != cdouble("0")) THEN
			GOTO RESPONSE
		ENDIF
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
                EQSRV.GLBDATA.shdlNum = BANCS.OUTPARAM.shdlNum
                EQSRV.GLBDATA.flowId = BANCS.OUTPARAM.flowId
                EQSRV.GLBDATA.crAcid = BANCS.OUTPARAM.crAcid
                EQSRV.GLBDATA.drAcid = BANCS.OUTPARAM.drAcid
                EQSRV.GLBDATA.dmdDate = BANCS.OUTPARAM.dmdDate
                EQSRV.GLBDATA.dmdovduDate = BANCS.OUTPARAM.dmdovduDate
                EQSRV.GLBDATA.dmdAmt = BANCS.OUTPARAM.dmdAmt
                EQSRV.GLBDATA.dmdAmtRounded = BANCS.OUTPARAM.dmdAmtRounded
                EQSRV.GLBDATA.totAdjAmt = BANCS.OUTPARAM.totAdjAmt
                EQSRV.GLBDATA.totDueAmt = BANCS.OUTPARAM.totDueAmt
                EQSRV.GLBDATA.numOfpay = BANCS.OUTPARAM.numOdpay
                EQSRV.GLBDATA.monthofPay = BANCS.OUTPARAM.monthofPay
                if(cdouble(EQSRV.GLBDATA.totDueAmt)<=0)then
                #{
                                goto NXTREC
                #}
                endif
        #recocile flow
                if((EQSRV.GLBDATA.flowId=="INDEM")or(EQSRV.GLBDATA.flowId=="PRDEM"))then
                #{
                        if(cdouble(EBSRV.GLBDATA.tranAmt)>0)then
                        #{
                                print(EBSRV.GLBDATA.tranAmt)
                                print(EQSRV.GLBDATA.dmdAmt)
                                print(EQSRV.GLBDATA.totAdjAmt)
                                print(EQSRV.GLBDATA.totDueAmt)
                                if(cdouble(EQSRV.GLBDATA.totDueAmt)>=cdouble(EBSRV.GLBDATA.tranAmt))then
                                #{
                                        EQSRV.GLBDATA.totupamt = cdouble(EQSRV.GLBDATA.totAdjAmt) + cdouble(EBSRV.GLBDATA.tranAmt)
                                        print(EQSRV.GLBDATA.totupamt)
					print(EBSRV.GLBDATA.TranId)
					print(EQSRV.GLBDATA.shdlNum)
					print(EQSRV.GLBDATA.flowId)
					print(EQSRV.GLBDATA.crAcid)
					print(EQSRV.GLBDATA.numOfpay)
					print(EQSRV.GLBDATA.monthofPay)
                                        lv_j = "update custom.odla_dmd_tbl set tot_adj_amt=?SVAR,lchg_user_id=?SVAR,lchg_time=sysdate,host_machine_id=?SVAR,free_text_4=?SVAR,free_text_3='ChannelPay',last_adj_date=to_date(?SVAR,'DD-MM-YYYY')  where bank_id=?SVAR and shdl_num=?NVAR and flow_id=?SVAR and od_acid=?SVAR  and free_text_1=?SVAR and free_text_2=?SVAR and entity_cre_flg='Y' and del_flg='N' and dmd_amt=?NVAR and dmd_date=to_date(?SVAR,'DD-MM-YYYY') "
                                        BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.totupamt + "|" + BANCS.STDIN.userId + "|" + EBSRV.GLBDATA.machineId + "|" + EBSRV.GLBDATA.TranId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.shdlNum + "|" + EQSRV.GLBDATA.flowId + "|" + EQSRV.GLBDATA.crAcid + "|" + EQSRV.GLBDATA.numOfpay + "|" + EQSRV.GLBDATA.monthofPay + "|" + EQSRV.GLBDATA.dmdAmt + "|" + EQSRV.GLBDATA.dmdDate 
                                        print(lv_j)
                                        print(BANCS.INPARAM.BINDVARS)
                                        lv_j = urhk_dbSqlWithBind(lv_j)
                                        if(lv_j==0)then
                                        #{
                                                lv_j = urhk_dbSqlWithBind("commit")
						EBSRV.GLBDATA.tranAmt = "0"
                                        #}
                                        endif
                                        goto NXTREC
                                #}
                                else
                                #{
                                        if(cdouble(EBSRV.GLBDATA.tranAmt)<=0)then
                                        #{
                                                goto NXTREC
                                        #}
                                        endif
                                        EBSRV.GLBDATA.tranAmt = cdouble(EBSRV.GLBDATA.tranAmt) - cdouble(EQSRV.GLBDATA.totDueAmt)
                                        print(EBSRV.GLBDATA.tranAmt)
                                        EQSRV.GLBDATA.totupamt = cdouble(EQSRV.GLBDATA.totAdjAmt) + cdouble(EQSRV.GLBDATA.totDueAmt)
                                        print(EQSRV.GLBDATA.totupamt)
					print(EBSRV.GLBDATA.machineId)
					print(EBSRV.GLBDATA.TranId)
					print(EQSRV.GLBDATA.shdlNum)
					print(EQSRV.GLBDATA.flowId)
					print(EQSRV.GLBDATA.crAcid)
					print(EQSRV.GLBDATA.numOfpay)
					print(EQSRV.GLBDATA.monthofPay)
                                        lv_j = "update custom.odla_dmd_tbl set tot_adj_amt=?NVAR,lchg_user_id=?SVAR,lchg_time=sysdate,host_machine_id=?SVAR,free_text_4=?SVAR,free_text_3='ChannelPay',last_adj_date=to_date(?SVAR,'DD-MM-YYYY')  where bank_id=?SVAR and shdl_num=?NVAR and flow_id=?SVAR and od_acid=?SVAR  and free_text_1=?SVAR and free_text_2=?SVAR and entity_cre_flg='Y' and del_flg='N' and dmd_amt=?NVAR and dmd_date=to_date(?SVAR,'DD-MM-YYYY') "
                                        BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.totupamt + "|" + BANCS.STDIN.userId + "|" + EBSRV.GLBDATA.machineId + "|" + EBSRV.GLBDATA.TranId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.shdlNum + "|" + EQSRV.GLBDATA.flowId + "|" + EQSRV.GLBDATA.crAcid + "|" + EQSRV.GLBDATA.numOfpay + "|" + EQSRV.GLBDATA.monthofPay + "|" + EQSRV.GLBDATA.dmdAmt + "|" + EQSRV.GLBDATA.dmdDate
                                        print(lv_j)
                                        print(BANCS.INPARAM.BINDVARS)
                                        lv_j = urhk_dbSqlWithBind(lv_j)
                                        if(lv_j==0)then
                                        #{
                                                lv_j = urhk_dbSqlWithBind("commit")
                                        #}
                                        endif
                                        goto NXTREC
                                #}
                                endif
			#}
			else
			#{
                                        goto NXTREC
                        #}
                        endif
                #}
                endif
#Ends
                NXTREC:
                        print(EQSRV.GLBDATA.srvErrMsg)
                        print(EQSRV.GLBDATA.srvErrCode)
                        print(EQSRV.GLBDATA.srvSucFail)
                        sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.dlscdhNum)
                        print(sv_u)
                        if(sv_u!=0)then
                        #{
                                print("fetch failed")
                                sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.dlscdhNum)
                                print(sv_u)
                                goto RESPONSE
                        #}
                        endif
                        EQSRV.GLBDATA.ddaRec = cint(EQSRV.GLBDATA.ddaRec) + 1
                        EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.ddaRec
                        print(EQSRV.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.dlscdhNum)
        print(sv_u)
Endofscript:
        print(EQSRV.GLBDATA.srvErrCode)
        print(EQSRV.GLBDATA.srvErrMsg)
        print(EQSRV.GLBDATA.srvSucFail)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
        sv_u = urhk_SetOrbOut("Message|OD Loan Payment Processed Successfully")
        sv_u = urhk_SetOrbOut("ODLoanAccount|" + EBSRV.GLBDATA.OdAcctId )
        sv_u = urhk_SetOrbOut("OperativeAcctId|" + EBSRV.GLBDATA.OpAcctId )
        sv_u = urhk_SetOrbOut("TranId|" + EBSRV.GLBDATA.TranId )
        sv_u = urhk_SetOrbOut("TranAmount|" + EBSRV.GLBDATA.RepayAmount )
        sv_u = urhk_SetOrbOut("TranDate|" + mid$(BANCS.STDIN.BODDate,0,10) )
        BANCS.OUTPUT.successOrFailure="S"
        exitscript
RESPONSE:
        sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
        sv_u = urhk_SetOrbOut("Message|OD Loan Payment Processed Successfully")
        sv_u = urhk_SetOrbOut("ODLoanAccount|" + EBSRV.GLBDATA.OdAcctId )
        sv_u = urhk_SetOrbOut("OperativeAcctId|" + EBSRV.GLBDATA.OpAcctId )
        sv_u = urhk_SetOrbOut("TranId|" + EBSRV.GLBDATA.TranId )
        sv_u = urhk_SetOrbOut("TranAmount|" + EBSRV.GLBDATA.RepayAmount )
        sv_u = urhk_SetOrbOut("TranDate|" + mid$(BANCS.STDIN.BODDate,0,10) )
        BANCS.OUTPUT.successOrFailure="S"
        exitscript
trace off
end-->
