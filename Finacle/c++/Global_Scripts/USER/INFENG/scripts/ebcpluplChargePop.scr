<--start
trace on
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	sv_d = "pttCnt | select count(*) "
	sv_d = sv_d + " from tbaadm.ptt ,tbaadm.adm " 
	sv_d = sv_d + " where ptt.bank_id=?SVAR " 
	sv_d = sv_d + " and ptt.entity_cre_flg='Y' "
	sv_d = sv_d + " and ptt.del_flg='N' "
	sv_d = sv_d + " and ptt.event_type='GCHRG' "
	sv_d = sv_d + " and ptt.event_id='PLUPL' "
	sv_d = sv_d + " and ptt.amt_derv_srl_num=adm.amt_drv_srl_num "
	sv_d = sv_d + " and adm.entity_cre_flg='Y' "
	sv_d = sv_d + " and adm.del_flg='N' "
	sv_d = sv_d + " and adm.bank_id=?SVAR "
	sv_d = sv_d + " order by event_type,event_id "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId	
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		BANCS.INPUT.pttrecCnt = BANCS.OUTPARAM.pttCnt
	else
		BANCS.INPUT.pttrecCnt = 0
	endif
	sv_h = urhk_SetOrbOut("recCount|" +BANCS.INPUT.pttrecCnt)
	sv_d = "eventType,eventId,ChrgAmt,ChrgInd,ChrgCrncy,ChrgRmks | "
	sv_d = sv_d + " select event_type,event_id,adm.fixed_amt,adm.amt_ind,adm.crncy_code,tran_partcls " 
	sv_d = sv_d + " from tbaadm.ptt ,tbaadm.adm "
        sv_d = sv_d + " where ptt.bank_id=?SVAR " 
        sv_d = sv_d + " and ptt.entity_cre_flg='Y' "
        sv_d = sv_d + " and ptt.del_flg='N' "
	sv_d = sv_d + " and ptt.event_type='GCHRG' "
	sv_d = sv_d + " and ptt.event_id='PLUPL' "
        sv_d = sv_d + " and ptt.amt_derv_srl_num=adm.amt_drv_srl_num "
        sv_d = sv_d + " and adm.entity_cre_flg='Y' "
        sv_d = sv_d + " and adm.del_flg='N' "
        sv_d = sv_d + " and adm.bank_id=?SVAR "
        sv_d = sv_d + " order by event_type,event_id "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId	
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_c==0)then
		BANCS.INPUT.pttNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		BANCS.INPUT.pttNum = ""
	endif
	sv_r = urhk_dbCursorFetch(BANCS.INPUT.pttNum)
	print(sv_r)
	sv_z = 0
	sv_n = 1
	while(sv_r == 0)
	#{
			BANCS.INPUT.eventType	= BANCS.OUTPARAM.eventType
			BANCS.INPUT.eventId	= BANCS.OUTPARAM.eventId
			BANCS.INPUT.ChrgAmt	= BANCS.OUTPARAM.ChrgAmt
			BANCS.INPUT.ChrgInd	= BANCS.OUTPARAM.ChrgInd
			BANCS.INPUT.ChrgCrncy	= BANCS.OUTPARAM.ChrgCrncy
			BANCS.INPUT.ChrgRmks	= BANCS.OUTPARAM.ChrgRmks
			BANCS.INPUT.count = sv_n
			if(BANCS.INPUT.eventType=="")then
				BANCS.INPUT.eventType = " "
			endif
			if(BANCS.INPUT.eventId=="")then
				BANCS.INPUT.eventId = " "
			endif
			if(BANCS.INPUT.ChrgAmt=="")then
				BANCS.INPUT.ChrgAmt = " "
			endif
			if(BANCS.INPUT.ChrgInd=="")then
				BANCS.INPUT.ChrgInd = " "
			endif
			if(BANCS.INPUT.ChrgCrncy=="")then
				BANCS.INPUT.ChrgCrncy= " "
			endif
			if(BANCS.INPUT.ChrgRmks=="")then
				BANCS.INPUT.ChrgRmks = " "
			endif
			sv_s = "ChargeType_" + BANCS.INPUT.count + "|" + BANCS.INPUT.eventId 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "ChargeEvent_" + BANCS.INPUT.count + "|" + BANCS.INPUT.eventType 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "ChargeAmt_" + BANCS.INPUT.count + "|" + BANCS.INPUT.ChrgAmt 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "ChargeInd_" + BANCS.INPUT.count + "|" + BANCS.INPUT.ChrgInd 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "ChargeCrncy_" + BANCS.INPUT.count + "|" + BANCS.INPUT.ChrgCrncy 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "ChargeRmks_" + BANCS.INPUT.count + "|" + BANCS.INPUT.ChrgRmks 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)

			if(sv_r == 0)then
				sv_r = urhk_dbCursorFetch(BANCS.INPUT.pttNum)
			endif
			sv_n = sv_n + 1
			print(sv_n)
	#}
	do
        sv_r = urhk_dbCursorClose(BANCS.INPUT.pttNum)
trace off
end-->
