<--START
CHECKSUM="d02e840fa413f00b4cc88f247f09d229e0a9fd0a4e06c30f2c9ecf8bb5db6c07"
	# Script body goes here
	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CSIIET Class exists else create it
	###########################################################################################
	
	IF(CLASSEXISTS("CUST","CSIIET") == 0) THEN
	#{
		CREATECLASS ("CUST","CSIIET",5)
	#}
	ENDIF
	
	###########################################################################################
	# Check whether INTERFACE Class exists else create it
	###########################################################################################
	
	IF(CLASSEXISTS("CUST","INTERFACE") == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	#--------------------------------
	#Initialising the variables.
	#--------------------------------
	CUST.CSIIET.siSrlNum = ""
	CUST.CSIIET.tranId = ""
	CUST.CSIIET.tranDate = ""
	CUST.CSIIET.targetTranId = ""
	CUST.CSIIET.targetTranDate = ""
	CUST.CSIIET.tranAmt = ""
	CUST.CSIIET.targetEntity = ""
	CUST.CSIIET.crAcctID = ""
	CUST.CSIIET.drAcctID = ""
	CUST.CSIIET.parameterId = ""
	CUST.CSIIET.fileStr = "DAILY.UPDATESI_"
	CUST.CSIIET.dateFormatInFile = "YYYYMMDDHH24MISS"
	CUST.CSIIET.currentDateTime = ""
	CUST.CSIIET.extractFile = ""
	CUST.CSIIET.moduleName = "IETX"
	CUST.CSIIET.mrtFile = "Inter_Entity_SI_Report.jasper"
	CUST.CSIIET.rptFile = "Inter_Entity_SI_Report"
	CUST.CSIIET.bankId = BANCS.STDIN.contextBankId
	CUST.CSIIET.execDate = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.CSIIET.solId = BANCS.STDIN.mySolId
	CUST.CSIIET.errMsgFlg = "N"
	CUST.CSIIET.errMsg = ""
	
	
	#-------------------------------------------------------
	# Query to fetch system date from dual table
	#-------------------------------------------------------
	sv_s = "currentDateTime|SELECT TO_CHAR(SYSDATE,'" + CUST.CSIIET.dateFormatInFile
	sv_s = sv_s + "') FROM DUAL"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.CSIIET.currentDateTime = BANCS.OUTPARAM.currentDateTime
		print(CUST.CSIIET.currentDateTime)
	#}
	ENDIF
	
	CUST.CSIIET.extractFile = CUST.CSIIET.fileStr + CUST.CSIIET.currentDateTime + ".lst"
	print(CUST.CSIIET.extractFile)
	
	sv_s = "> "+  CUST.CSIIET.extractFile
	sv_a = SYSTEM(sv_s)
	print(sv_a)
	
	#--------------------------------------------------------
	#Fetching siSrlNum,tran id and tran date from SIHT table
	#--------------------------------------------------------
	
	BANCS.INPARAM.BINDVARS = CUST.CSIIET.bankId + "|S" + "|" +  CUST.CSIIET.execDate + "|Y"
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "siSrlNum,tranId,tranDate|"
	sv_s = sv_s + "SELECT S.SI_SRL_NUM,TRAN_ID,to_char(TRAN_DATE,'DD-MM-YYYY') "
	sv_s = sv_s + "FROM TBAADM.SIHT S,CUSTOM.IESID I "
	#sv_s = sv_s + "WHERE tran_date = to_date(?SVAR, 'dd-mm-yyyy') "
	sv_s = sv_s + "WHERE S.BANK_ID = ?SVAR "
	sv_s = sv_s + "AND HISTORY_EVENT_STATUS = ?SVAR "
	sv_s = sv_s + "AND S.SI_SRL_NUM = I.SI_SRL_NUM "
	sv_s = sv_s + "AND S.BANK_ID = I.BANK_ID "
	sv_s = sv_s + "AND S.EXEC_DATE = to_date(?SVAR, 'dd-mm-yyyy') "
	sv_s = sv_s + "AND I.INTER_ENTITY_SI_FLG = ?SVAR "
	sv_s = sv_s + "AND S.SI_SRL_NUM = '        5416' "
	print(sv_s)
	
	sv_c =urhk_dbCursorOpenWithBind(sv_s)
	IF (sv_c != 0 ) THEN
	#{
		CUST.CSIIET.errMsg = "Could not open cursor"
		GOTO NEXT
	#}
	ENDIF
	
	sv_f = "1"
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(sv_n)
	sv_c = urhk_dbCursorFetch(sv_n)
	PRINT(sv_c)
	
	IF(sv_c !=0) THEN
	#{
		CUST.CSIIET.errMsgFlg = "Y"
		CUST.CSIIET.errMsg = "Could not fetch details from siht table"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_t = 1
	WHILE(sv_c == 0)
	#{
		CUST.CSIIET.siSrlNum = BANCS.OUTPARAM.siSrlNum
		CUST.CSIIET.tranId = BANCS.OUTPARAM.tranId
		CUST.CSIIET.tranDate = BANCS.OUTPARAM.tranDate
		print(CUST.CSIIET.siSrlNum)
		print(CUST.CSIIET.tranId)
		print(CUST.CSIIET.tranDate)
		
		BANCS.INPARAM.BINDVARS = CUST.CSIIET.tranId + "|" + CUST.CSIIET.tranDate + "|" + CUST.CSIIET.bankId + "|C"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CSIIET.tranId + "|" + CUST.CSIIET.tranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CSIIET.bankId + "|C"
		
		print(BANCS.INPARAM.BINDVARS)
		CUST.CSIIET.tranCrncyCode = ""
		sv_s = "tranCrncyCode|"
		sv_s = sv_s + "SELECT TRAN_CRNCY_CODE "
		sv_s = sv_s + "FROM (SELECT TRAN_CRNCY_CODE "
		sv_s = sv_s + "FROM TBAADM.HTD "
		sv_s = sv_s + "WHERE tran_id = ?SVAR "
		sv_s = sv_s + "AND tran_date = to_date(?SVAR, 'dd-mm-yy') "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		sv_s = sv_s + "AND part_tran_type = ?SVAR "
		sv_s = sv_s + "AND rownum = 1 "
		sv_s = sv_s + "UNION "
		sv_s = sv_s + "SELECT TRAN_CRNCY_CODE "
		sv_s = sv_s + "FROM TBAADM.DTD "
		sv_s = sv_s + "WHERE tran_id = ?SVAR "
		sv_s = sv_s + "AND tran_date = to_date(?SVAR, 'dd-mm-yy') "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		sv_s = sv_s + "AND part_tran_type = ?SVAR "
		sv_s = sv_s + "AND rownum = 1) "
		
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0)THEN
		#{
			CUST.CSIIET.tranCrncyCode = BANCS.OUTPARAM.tranCrncyCode
			print(CUST.CSIIET.tranCrncyCode)
		#}
		ENDIF
		
		BANCS.INPARAM.BINDVARS = CUST.CSIIET.tranId + "|" + CUST.CSIIET.tranDate + "|" + CUST.CSIIET.bankId + "|C"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CSIIET.tranId + "|" + CUST.CSIIET.tranDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CSIIET.bankId + "|C"
		
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "tranAmt|"
		sv_s = sv_s + "SELECT SUM(TRAN_AMT) "
		sv_s = sv_s + "FROM (SELECT TRAN_AMT "
		sv_s = sv_s + "FROM TBAADM.HTD "
		sv_s = sv_s + "WHERE tran_id = ?SVAR "
		sv_s = sv_s + "AND tran_date = to_date(?SVAR, 'dd-mm-yy') "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		sv_s = sv_s + "AND part_tran_type = ?SVAR "
		sv_s = sv_s + "UNION "
		sv_s = sv_s + "SELECT TRAN_AMT "
		sv_s = sv_s + "FROM TBAADM.DTD "
		sv_s = sv_s + "WHERE tran_id = ?SVAR "
		sv_s = sv_s + "AND tran_date = to_date(?SVAR, 'dd-mm-yy') "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		sv_s = sv_s + "AND part_tran_type = ?SVAR) "
		#sv_s = sv_s + "GROUP BY acid "
		
		print(sv_s)
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		IF (sv_c != 0 ) THEN
		#{
			CUST.CSIIET.errMsgFlg = "Y"
			CUST.CSIIET.errMsg = "Could not open cursor."
			GOTO NEXT
		#}
		ENDIF
		sv_g = "1"
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_m)
		sv_e = urhk_dbCursorFetch(sv_m)
		PRINT(sv_e)
		
		IF(sv_e !=0) THEN
		#{
			CUST.CSIIET.errMsgFlg = "Y"
			CUST.CSIIET.errMsg = "Could not fetch details from HTD AND DTD table."
			GOTO NEXT
		#}
		ENDIF
		
		WHILE(sv_e == 0)
		#{
			CUST.CSIIET.tranAmt = BANCS.OUTPARAM.tranAmt
			print(CUST.CSIIET.tranAmt)
			#------------------------------------------
			#Fetch debit acct from custom table IESID
			#------------------------------------------
			BANCS.INPARAM.BINDVARS = CUST.CSIIET.siSrlNum + "|" + CUST.CSIIET.bankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "targetEntity,targetEntityAcctId|SELECT TARGET_ENTITY,TARGET_ENTITY_ACCOUNT_ID "
			sv_s = sv_s + "FROM CUSTOM.IESID "
			sv_s = sv_s + "WHERE SI_SRL_NUM = ?SVAR "
			sv_s = sv_s + "AND BANK_ID = ?SVAR"
			print(sv_s)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				CUST.CSIIET.targetEntity = BANCS.OUTPARAM.targetEntity
				CUST.CSIIET.crAcctID = BANCS.OUTPARAM.targetEntityAcctId
				print(CUST.CSIIET.crAcctID)
				#}
			ELSE
				#{
				CUST.CSIIET.errMsgFlg = "Y"
				CUST.CSIIET.errMsg = "Could not fetch details from IESID custom table."
				GOTO NEXT
			#}
			ENDIF
			
			CUST.CSIIET.parameterId = "SI" + "_VOSTRO_" + CUST.CSIIET.targetEntity
			print(CUST.CSIIET.parameterId)
			
			BANCS.INPARAM.BINDVARS = CUST.CSIIET.moduleName + "|" + CUST.CSIIET.bankId + "|" + CUST.CSIIET.parameterId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = ?SVAR"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			print(sv_s)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				CUST.CSIIET.drAcctID = BANCS.OUTPARAM.parameterValue
				print(CUST.CSIIET.drAcctID)
				#}
			ELSE
				#{
				CUST.CSIIET.errMsgFlg = "Y"
				CUST.CSIIET.errMsg = "Vostro for Standing Intructions is not maintained in CPARAM." + CUST.CSIIET.parameterId
				GOTO NEXT
			#}
			ENDIF
			
			sv_s = "RequestID|SELECT CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')) FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0)THEN
			#{
				CUST.CSIIET.RequestID = BANCS.OUTPARAM.RequestID
				print(CUST.CSIIET.RequestID)
				#}
			ELSE
				#{
				CUST.CSIIET.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2)+ MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
				print(CUST.CSIIET.RequestID)
			#}
			ENDIF
			
			CUST.CSIIET.RequestID = CUST.CSIIET.RequestID + FORMAT$(sv_t,"%d")
			PRINT(CUST.CSIIET.RequestID)
			
			#-------------------------------------------------------
			#Assigning all the input variables for calling script.
			#-------------------------------------------------------
			CUST.INTERFACE.interfaceRequestID = "XferTrnAdd"
			CUST.INTERFACE.interfaceRequestVersion = "10.2"
			CUST.INTERFACE.RequestID = CUST.CSIIET.RequestID
			CUST.INTERFACE.bankID = CUST.CSIIET.targetEntity
			CUST.INTERFACE.channelID = "COR"
			CUST.INTERFACE.tranType = "T"
			CUST.INTERFACE.tranSubType = "BI"
			CUST.INTERFACE.tranCcy = CUST.CSIIET.tranCrncyCode
			CUST.INTERFACE.tranParticulars = "Inter Entity Standing Instructions"
			CUST.INTERFACE.tranRmks =  CUST.CSIIET.tranId + " / " + CUST.CSIIET.tranDate
			CUST.INTERFACE.drValueDate = MID$(BANCS.STDIN.BODDate,0,10)
			CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
			CUST.INTERFACE.rateCode = "MEAN"
			CUST.INTERFACE.drRate = ""
			CUST.INTERFACE.crRate = ""
			CUST.INTERFACE.instDate = ""
			CUST.INTERFACE.instAlpha = ""
			CUST.INTERFACE.instNum = ""
			CUST.INTERFACE.instType = ""
			CUST.INTERFACE.chkInstDetails = ""
			CUST.INTERFACE.crAcctID =  CUST.CSIIET.crAcctID
			CUST.INTERFACE.drAcctID =  CUST.CSIIET.drAcctID
			CUST.INTERFACE.tranAmt =  CUST.CSIIET.tranAmt
			
			#-----------------------------
			#Calling the interface script
			#-----------------------------
			
			CUST.CSIIET.targetTranId = ""
			CUST.CSIIET.targetTranDate = ""
			
			CALL("cietxnmn003.scr")
			
			IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
			#{
				CUST.CSIIET.errMsg = CUST.INTERFACE.errorDesc
				#}
			ELSE
				#{
				CUST.CSIIET.targetTranId = CUST.INTERFACE.tranId
				CUST.CSIIET.targetTranDate = CUST.INTERFACE.tranDate
			#}
			ENDIF
			
			NEXT:
				#-------------------------------------------------------
				#Sending the output to lst file for report generation.
				#-------------------------------------------------------
				CUST.CSIIET.output = ""
				CUST.CSIIET.output = CUST.CSIIET.siSrlNum +"|"+ CUST.CSIIET.execDate +"|"+ CUST.CSIIET.solId +"|"+ CUST.CSIIET.bankId
				CUST.CSIIET.output = CUST.CSIIET.output +"|"+ CUST.CSIIET.tranId +"|"+ CUST.CSIIET.tranDate +"|"+ CUST.CSIIET.targetEntity
				CUST.CSIIET.output = CUST.CSIIET.output +"|"+ CUST.CSIIET.targetTranId +"|"+ CUST.CSIIET.targetTranDate +"|"+ CUST.CSIIET.errMsg
				print(CUST.CSIIET.output)
				
				sv_s = "echo '" + CUST.CSIIET.output + "' >> " + CUST.CSIIET.extractFile
				sv_a = SYSTEM(sv_s)
				print(sv_a)
				
				sv_t = sv_t + 1
				print(sv_t)
				
				sv_e = urhk_dbCursorFetch(sv_m)
				PRINT(sv_e)
			#}
			DO
			sv_c = urhk_dbCursorFetch(sv_n)
			PRINT(sv_c)
		#}
		DO
		
		#-------------------------------------------
		#Generation of report
		#-------------------------------------------
		sv_s = "exebatch mrbx4004 $B2K_SESSION_ID "+CUST.CSIIET.mrtFile+" "+CUST.CSIIET.extractFile+" "+CUST.CSIIET.rptFile
		sv_r = SYSTEM(sv_s)
		print(sv_r)
		IF(sv_r == 0)THEN
		#{
			sv_s = "exebatch babx4040 $B2K_SESSION_ID "+CUST.CSIIET.rptFile+".PDF 'Inter Entity SI Execution Report' MANAGER 1 N"
			sv_r = SYSTEM(sv_s)
			
			IF(sv_r != 0)THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		
		
	ENDOFSCRIPT:
		IF (sv_f == "1") THEN
		#{
			sv_u= urhk_dbCursorClose(sv_n)
			print(sv_u)
		#}
		ENDIF
		IF (sv_g == "1") THEN
		#{
			sv_u= urhk_dbCursorClose(sv_m)
			print(sv_u)
		#}
		ENDIF
		TRACE OFF
		EXITSCRIPT
		
END-->
