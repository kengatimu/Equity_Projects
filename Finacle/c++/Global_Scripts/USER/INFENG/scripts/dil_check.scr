#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="67437073bd3d6814bff8feb4367347c806f67b73b1eb46673196a9366d897be8"
	TRACE ON
	
	#--------------------------------------------------------------------------------
	# Setting Customer Details in Response XML
	#--------------------------------------------------------------------------------
	sv_t = "CustAcctInquiry_RES.CustomerID| " + CUST.INTERFACE.customerID
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.CustomerName| " + CUST.INTERFACE.custName
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.CustomerFirstName| " + CUST.INTERFACE.custFirstName
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.CustomerLastName| " + CUST.INTERFACE.custLastName
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.CustomerShortName| " + CUST.INTERFACE.custShortName
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.CustomerTitleCode| " + CUST.INTERFACE.custTitleCode
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.NationalID| " + CUST.INTERFACE.custNationalID
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.EmailID| " + CUST.INTERFACE.prefEmailID
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PhoneNo| " + CUST.INTERFACE.prefPhoneNo
	sv_u = urhk_SetOrbOut(sv_t)
	#-----------------------------------------------------
	# Converting to Gerigorian format
	#-----------------------------------------------------
	IF(CUST.INTERFACE.custDOB != "") THEN
	#{
		COMMON.INPUT.dateFmt = "DD-MM-YY"
		COMMON.INPUT.date = CUST.INTERFACE.custDOB
		CALL("Common_Interface_ConvertDateToGregorian.scr")
		CUST.INTERFACE.custDOB = COMMON.OUTPUT.outDate
		print(CUST.INTERFACE.custDOB)
	#}
	ENDIF
	sv_t = "CustAcctInquiry_RES.DateOfBirth| " + CUST.INTERFACE.custDOB
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.MaritalStatus| " + CUST.INTERFACE.custMaritalStatus
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.Sex| " + CUST.INTERFACE.custSex
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.CustomerMinorFlag| " + CUST.INTERFACE.custMinorFlg
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.CustomerNREFlag| " + CUST.INTERFACE.custNREFlg
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.Community| " + CUST.INTERFACE.custCommuCode
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.UserSubClassification| " + CUST.INTERFACE.userSubClassification
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PassportNo| " + CUST.INTERFACE.custPassportNo
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.Address1| " + CUST.INTERFACE.custPrefAddr1
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.Address2| " + CUST.INTERFACE.custPrefAddr2
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.CityCode| " + CUST.INTERFACE.custPrefCityCode
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.StateCode| " + CUST.INTERFACE.custPrefStateCode
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.CountryCode| " + CUST.INTERFACE.custPrefCntyCode
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.CityCodeDesc| " + CUST.INTERFACE.custPrefCityCodeDesc
	sv_u = urhk_SetOrbOut(sv_t)
	sv_t = "CustAcctInquiry_RES.PrefAddress.<rec_1>.PinCode| " + CUST.INTERFACE.custPrefPinCode
	sv_u = urhk_SetOrbOut(sv_t)
	
	#--------------------------------------------------------------------------------
	# Setting Account Details in Response XML
	#--------------------------------------------------------------------------------
	sv_q = 1
	WHILE(sv_q <= CINT(CUST.INTERFACE.accountCount))
	#{
		sv_v = "foracid_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountID| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acid_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.Acid| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acctOpenDate_" + FORMAT$(sv_q, "%d")
		#-----------------------------------------------------
		# Converting to Gerigorian format
		#-----------------------------------------------------
		IF(("CUST").("INTERFACE").(sv_v) != "") THEN
		#{
			COMMON.INPUT.dateFmt = "DD-MM-YY"
			COMMON.INPUT.date = ("CUST").("INTERFACE").(sv_v)
			CALL("Common_Interface_ConvertDateToGregorian.scr")
			("CUST").("INTERFACE").(sv_v) = COMMON.OUTPUT.outDate
			print(("CUST").("INTERFACE").(sv_v))
		#}
		ENDIF
		
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AcctOpenDate| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "solID_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.BranchCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "schemeCode_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.SchemeCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "schemeType_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.SchemeType| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		CUST.INTERFACE.schemeType = ("CUST").("INTERFACE").(sv_v)
		sv_v = "acctName_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountName| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "crncyCode_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.Currency| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "accountStatus_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountStatus| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acctOwnership_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountOwnership| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "acctClosureFlg_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountClosureFlag| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "freezeCode_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.FreezeCode| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "clrBalAmt_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ClearBalance| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "unClearBalAmt_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.UnclearBalance| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "sanctLimit_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.SanctionLimit| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "lienAmt_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.LienAmount| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "drawingPower_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.DrawingPower| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
		sv_u = urhk_SetOrbOut(sv_t)
		
		sv_v = "modeOfOperation_" + FORMAT$(sv_q, "%d")
		sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ModeOfOperation| " + ("CUST").("INTERFACE").(sv_v)
		sv_u = urhk_SetOrbOut(sv_t)
		#--------------------------------------------------------------------------------
		# Following details are only applicable for TDA/TUA accounts
		#--------------------------------------------------------------------------------
		IF((CUST.INTERFACE.schemeType == "TDA") OR (CUST.INTERFACE.schemeType == "TUA")) THEN
		#{
			sv_v = "interestRate_" + FORMAT$(sv_q, "%d")
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.InterestRate| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
			
			sv_v = "maturityDate_" + FORMAT$(sv_q, "%d")
			#-----------------------------------------------------
			# Converting to Gerigorian format
			#-----------------------------------------------------
			IF(("CUST").("INTERFACE").(sv_v) != "") THEN
			#{
				COMMON.INPUT.dateFmt = "DD-MM-YY"
				COMMON.INPUT.date = ("CUST").("INTERFACE").(sv_v)
				CALL("Common_Interface_ConvertDateToGregorian.scr")
				("CUST").("INTERFACE").(sv_v) = COMMON.OUTPUT.outDate
				print(("CUST").("INTERFACE").(sv_v))
			#}
			ENDIF
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.MaturityDate| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF
		#--------------------------------------------------------------------------------
		# Following details are only applicable for LAA/CLA accounts
		#--------------------------------------------------------------------------------
		IF((CUST.INTERFACE.schemeType == "LAA") OR (CUST.INTERFACE.schemeType == "CLA")) THEN
		#{
			sv_v = "disbAmt_" + FORMAT$(sv_q, "%d")
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.DisbursementAmt| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
			
			sv_v = "numOfFlows_" + FORMAT$(sv_q, "%d")
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.NoOfFlows| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
			
			sv_v = "lrFreqType_" + FORMAT$(sv_q, "%d")
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.RepayFrequency| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
			
			sv_v = "shdlNum_" + FORMAT$(sv_q, "%d")
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.ScheduleNo| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
			
			sv_v = "flowAmt_" + FORMAT$(sv_q, "%d")
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.FlowAmount| " + FORMAT$(CDOUBLE(("CUST").("INTERFACE").(sv_v)),"%.2f")
			sv_u = urhk_SetOrbOut(sv_t)
			
			sv_v = "flowStartDate_" + FORMAT$(sv_q, "%d")
			#-----------------------------------------------------
			# Converting to Gerigorian format
			#-----------------------------------------------------
			IF(("CUST").("INTERFACE").(sv_v) != "") THEN
			#{
				COMMON.INPUT.dateFmt = "DD-MM-YY"
				COMMON.INPUT.date = ("CUST").("INTERFACE").(sv_v)
				CALL("Common_Interface_ConvertDateToGregorian.scr")
				("CUST").("INTERFACE").(sv_v) = COMMON.OUTPUT.outDate
				print(("CUST").("INTERFACE").(sv_v))
			#}
			ENDIF
			sv_t = "CustAcctInquiry_RES.AcctDtls.<rec_" + FORMAT$(sv_q,"%d") + ">.FlowStartDate| " + ("CUST").("INTERFACE").(sv_v)
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF
		sv_q = sv_q + 1
	#}
	DO
	
	#trace off
END-->
