<--START
CHECKSUM="62b322b76e0c0a5442f940b8e3b3c355ab8d0b7fd40b8c54daede45892be690c"
	#TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "STFSALPRO") == 0) THEN
	#{
		CREATECLASS("CUST", "STFSALPRO", 5)
	#}
	ENDIF
	
	
	PRINT(BANCS.INPUT.setId)
	PRINT(BANCS.INPUT.salDate)
	PRINT(BANCS.INPUT.remrks)
	
	CUST.STFSALPRO.userPass  = ""
	CUST.STFSALPRO.setId     = BANCS.INPUT.setId
	CUST.STFSALPRO.salDate   = BANCS.INPUT.salDate
	CUST.STFSALPRO.remrks    = BANCS.INPUT.remrks
	CUST.STFSALPRO.errorMsg	 = ""
	
	sv_u = urhk_getEnv("USER_PASS")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^User Id Password is not set, taking default value^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STFSALPRO.userPass = BANCS.OUTPARAM.envValue
		PRINT(CUST.STFSALPRO.userPass)
	#}
	ENDIF
	
	###############################################################################
	## Getting STFILE From CPARAM TABLE
	##############################################################################
	BANCS.INPUT.moduleName  = "STAFFLOAN"
	BANCS.INPUT.parameterId = "STFILE"
	
	CALL ("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.STFSALPRO.upldFileName = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.STFSALPRO.errMsg="Upload File Name setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^ file Name  not done in CPARAM^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#######################################################################
	## Getting CTL_PATH
	######################################################################
	sv_u = urhk_getEnv("CTL_PATH")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STFSALPRO.ctlPath = BANCS.OUTPARAM.envValue
		PRINT(CUST.STFSALPRO.ctlPath)
	#}
	ENDIF
	#######################################################################
	## Getting DATA_PATH
	######################################################################
	sv_u = urhk_getEnv("DATA_PATH")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Data file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.envValue)
		CUST.STFSALPRO.dataPath = BANCS.OUTPARAM.envValue
		PRINT(CUST.STFSALPRO.dataPath)
		
		#----------TOL - 367144-------------#
		BANCS.INPUT.upldPath = CUST.STFSALPRO.dataPath
		#---------------------------------------------------------------
		# Calling common script to append userId to upload file path
		#---------------------------------------------------------------
		CALL("appendUserId.scr")
		CUST.STFSALPRO.dataPath = BANCS.INPUT.upldPath
		PRINT(CUST.STFSALPRO.dataPath)
	#}
	ENDIF
	
	sv_u = urhk_getFileLocation("COM|slnpppagedp001.com")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		#----------------------------------------------------------------------------------
		#---    Setting Env variables
		#----------------------------------------------------------------------------------
		sv_a = "bankId|" + BANCS.STDIN.contextBankId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "setId|" + CUST.STFSALPRO.setId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "upldFileName|" + CUST.STFSALPRO.upldFileName
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "salDate|" + CUST.STFSALPRO.salDate
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "onsUser|" + BANCS.STDIN.userId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "remarks|" + CUST.STFSALPRO.remrks
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "homeCrncy|" + BANCS.STDIN.homeCrncyCode
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Error in setting env variable"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------
		#---    Executing com file in background
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.scriptName = "slnpppagedp001.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.STFSALPRO.errorMsg = "Upload process failed please retry"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.STFSALPRO.errorMsg = "Unable to load com file"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.STFSALPRO.errorMsg != "") THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^"+CUST.STFSALPRO.errorMsg+"^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			#}
		ELSE
			#{
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|Upload/Process Initiated SuccessFully"
			sv_z = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
