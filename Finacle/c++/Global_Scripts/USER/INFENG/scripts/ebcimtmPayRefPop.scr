#vp
<--start
trace on
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)




	BANCS.INPUT.funCode = BANCS.INPUT.funcCode
	sv_d = "pymntCnt | select count(*) "
	sv_d = sv_d + " from custom.CUST_CIMTM_MASTER_TABLE where bank_id=?SVAR and sol_id=?SVAR "
	sv_d = sv_d + " and transaction_status is  null "
	sv_d = sv_d + " and transaction_responsecode is  null "

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		BANCS.INPUT.pymntCnt = BANCS.OUTPARAM.pymntCnt
	else
		BANCS.INPUT.pymntCnt = 0
	endif
	sv_h = urhk_SetOrbOut("recCount|" +BANCS.INPUT.pymntCnt)
	sv_d = " paymentRefNum,PaymentRefDate | select pymntrefnum,to_char(PYMNTREFDATE,'DD-MM-YYYY') "
	sv_d = sv_d + " from custom.CUST_CIMTM_MASTER_TABLE where bank_id=?SVAR and sol_id=?SVAR "
	sv_d = sv_d + " and transaction_status is  null "
	sv_d = sv_d + " and transaction_responsecode is  null "
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId
	print(sv_d)
	print(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_c==0)then
		BANCS.INPUT.pttNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
		BANCS.INPUT.pttNum = ""
	endif
	sv_r = urhk_dbCursorFetch(BANCS.INPUT.pttNum)
	print(sv_r)
	sv_z = 0
	sv_n = 1
	while(sv_r == 0)
	#{
			BANCS.INPUT.paymentRefNum	= BANCS.OUTPARAM.paymentRefNum
			BANCS.INPUT.PaymentRefDate	= BANCS.OUTPARAM.PaymentRefDate
			BANCS.INPUT.count = sv_n
			if(BANCS.INPUT.paymentRefNum=="")then
				BANCS.INPUT.paymentRefNum = " "
			endif
			if(BANCS.INPUT.PaymentRefDate=="")then
				BANCS.INPUT.PaymentRefDate = " "
			endif
			sv_s = "PymntRefNum_" + BANCS.INPUT.count + "|" + BANCS.INPUT.paymentRefNum 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "pymntRefDate_" + BANCS.INPUT.count + "|" + BANCS.INPUT.PaymentRefDate 
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			if(sv_r == 0)then
				sv_r = urhk_dbCursorFetch(BANCS.INPUT.pttNum)
			endif
			sv_n = sv_n + 1
			print(sv_n)
	#}
	do
        sv_r = urhk_dbCursorClose(BANCS.INPUT.pttNum)
trace off
end-->
