<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)



        if(repexists("CUST") == 0)then
                createrep("CUST")
        endif
        if(classexists("CUST","DATA") == 0)then
                createclass("CUST","DATA",5)
        endif

	#-----------------------------
        ## Variable Intialization
        #-----------------------------
		CUST.DATA.errMsg   = ""
		CUST.DATA.credit1   = CUST.DATA.Craccountnumber
                print(CUST.DATA.credit1)
		CUST.DATA.debit1 = CUST.DATA.Draccountnumber
                print(CUST.DATA.debit1) 
		CUST.DATA.creditAmt1 = CDOUBLE(CUST.DATA.amount)
		PRINT(CUST.DATA.creditAmt1)
		CUST.DATA.debitAmt1 = CDOUBLE(CUST.DATA.amount) * -1
	        CUST.DATA.trandetails  = CUST.DATA.trandetails
                print(CUST.DATA.trandetails)
		CUST.DATA.TranId = ""

        #---------------------------------
        # Populate MTT details
        #---------------------------------

		sv_r = urhk_MTTS_PopulateInputDetails("")
		Print(sv_r)

		IF (sv_r != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
			EXITSCRIPT
		#}
		ENDIF

        #---------------------------------
        #  Closing of MTT if it is opened
        #---------------------------------

		sv_g = urhk_MTTS_Close("")
		print(sv_g)

		IF (sv_g != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
			EXITSCRIPT
		#}
		ENDIF

		#-----------------------------
		#--- Initialize MTT details
		#-----------------------------
					
		BANCS.INPARAM.PostTranFlg               = "Y"
		BANCS.INPARAM.CommitFlg                 = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
		BANCS.INPARAM.ValidationFlag            = "N"
		BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw          = "Y"
		BANCS.INPARAM.CheckExceptions           = "Y"

		sv_o = urhk_MTTS_Initialize("")
		PRINT(sv_o)

		IF(sv_o != 0)THEN
		#{
			sv_o = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
			EXITSCRIPT
		#}
		ENDIF

		#-------------------------------
		# Define the transaction  #HEADER DETAILS
		#-------------------------------

		MTT.TranDetails.TranDate        = "0"
		MTT.TranDetails.TranType        = "T"
		MTT.TranDetails.TranSubType     = "BI"
		MTT.TranDetails.ValidationFlag  = "N"
		MTT.TranDetails.IgnoreExcp      = "I"
		MTT.TranDetails.CommitFlg       = "Y"
		MTT.TranDetails.PostFlag        = "Y"
		MTT.TranDetails.Remarks = CUST.DATA.rcreuserid  + "_" + CUST.DATA.lchguserid

		sv_r = urhk_MTTS_DefineTransaction("REVERSAL")
		print(sv_r)

		IF (sv_r != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
			EXITSCRIPT
		#}
		ENDIF

		#----------------------------------------------
		#Main Transaction-------------------------------
		#----------------------------------------------
                #--------------------------------------------------------------------------
		#Credit to loan account
		#--------------------------------------------------------------------------
		MTT.PartTranDetails.Account = CUST.DATA.credit1
		MTT.PartTranDetails.RefAmount = CUST.DATA.creditAmt1
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.ValueDate      = "0"
		MTT.PartTranDetails.Particulars    = CUST.DATA.trandetails
                PRINT(MTT.PartTranDetails.Particulars)
		MTT.PartTranDetails.Remarks        = ""
		MTT.PartTranDetails.TranIdentifier = "REVERSAL"
		MTT.PartTranDetails.Consolidate    = "N"
		MTT.PartTranDetails.Refnum         = ""
		MTT.TranDetails.PostFlag           = "Y"
		MTT.TranDetails.IgnoreExcp         = "Y"

		sv_i = urhk_MTTS_DefinePartTran("CR")
		PRINT(sv_i)

		IF (sv_i != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
		#}
		ENDIF
	        #----------------------------------------------------------------------------		
		#Debit to Account 1
		#----------------------------------------------------------------------------
		MTT.PartTranDetails.Account        = CUST.DATA.debit1
		MTT.PartTranDetails.RefAmount      = CUST.DATA.debitAmt1
		MTT.PartTranDetails.RefCurrency    = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.ValueDate      = "0"
		MTT.PartTranDetails.Particulars    = CUST.DATA.trandetails
                PRINT(MTT.PartTranDetails.Particulars)
		MTT.PartTranDetails.Remarks        = ""
		MTT.PartTranDetails.TranIdentifier = "REVERSAL"
		MTT.PartTranDetails.Consolidate    = "N"
		MTT.PartTranDetails.Refnum         = ""
		MTT.TranDetails.PostFlag           = "Y"
		MTT.TranDetails.IgnoreExcp         = "Y"

		sv_i = urhk_MTTS_DefinePartTran("DR")
		PRINT(sv_i)

		IF (sv_i != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.DATA.errMsg = MTT.Error.Description
			PRINT(CUST.DATA.errMsg)
		#}
		ENDIF


		#--------------------------------------------------------------
		# MTT ending definition to create transaction
		#--------------------------------------------------------------

		sv_r = urhk_MTTS_EndDefinition("")
		PRINT(sv_r)

		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			CUST.DATA.TranId = TRIM(BANCS.OUTPARAM.MTTTranId)
			PRINT(CUST.DATA.TranId)

			
		#}
		ENDIF

		#--------------------------------------------------------------
		# MTT Closing an initialized MTT
		#--------------------------------------------------------------

		sv_r = urhk_MTTS_Close("")
		print(sv_r)

                print(CUST.DATA.TranId)

		CUST.DATA.Status = CUST.DATA.errMsg






#trace off

end-->
