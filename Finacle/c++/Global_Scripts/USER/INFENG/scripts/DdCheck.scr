	sv_q = "count|select count(*) from tbaadm.ddc d,tbaadm.upr u where d.prnt_flg='P' and d.del_flg ='N' and u.USER_ID = d.print_user_id  "
	sv_q = sv_q + "and d.bank_id = u.home_bank_id and u.user_emp_id =?SVAR and stat<>'C' and u.home_bank_id =?SVAR "
	BANCS.INPARAM.BINDVARS=CUST.DATA.usrId + "|" + BANCS.STDIN.contextBankId 
	sv_d = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		CUST.DATA.COUNT=BANCS.OUTPARAM.count
		print(CUST.DATA.COUNT)

		IF ( CUST.DATA.COUNT != 0 ) THEN
