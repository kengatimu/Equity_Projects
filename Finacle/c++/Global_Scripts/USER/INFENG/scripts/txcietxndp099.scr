<--START
CHECKSUM="cae0df07ea47618ea40870e2c28e243262219deeee90d1cca7d81688d8116ddd"
	TRACE ON
	sv_a = urhk_B2K_PrintRepos("BANCS")
	print(sv_a)

print(BANCS.INPUT.creditEntity)
print(BANCS.INPUT.crAcctNum)
print(BANCS.INPUT.refAmt)

CUST.CIETXN.refAmt = BANCS.INPUT.refAmt
print(CUST.CIETXN.refAmt)


IF ((CUST.CIETXN.DccId=="EBK") OR (CUST.CIETXN.DccId=="OMN")) THEN
	#CUST.CIETXN.refAmt = CUST.CIETXN.tranAmtCrEBK
	CUST.CIETXN.refAmt = CUST.CIETXN.refAmt
	print(CUST.CIETXN.refAmt)
	CUST.CIETXN.refAmt = FORMAT$(CDOUBLE(CUST.CIETXN.refAmt),"%.2f")
	print(CUST.CIETXN.refAmt)
	
ENDIF

CUST.CIETXN.userCRentitya="FIVUSR"
CUST.CIETXN.userCRentitya = CUST.CIETXN.userCRentitya + BANCS.INPUT.creditEntity
print(CUST.CIETXN.userCRentitya)


	#------------------------------------------------------------------------
	# Removing Quotes from data from Remote billers
	#------------------------------------------------------------------------
	
	sv_s = "count|select count(1) "
	sv_s = sv_s + " from tbaadm.dtd "
	sv_s = sv_s + " where acid  = (select acid from tbaadm.gam where foracid  = ?SVAR) "
	sv_s = sv_s + " AND  tran_amt = ?SVAR "
	#sv_s = sv_s + " AND  tran_particular like ?SVAR "
	sv_s = sv_s + " AND bank_id  = ?SVAR "
	sv_s = sv_s + " AND TRAN_SUB_TYPE = 'CI'"
	sv_s = sv_s + " AND TRAN_TYPE = 'T'"
	sv_s = sv_s + " AND ENTRY_USER_ID = ?SVAR"
	sv_s = sv_s + " AND tran_date = (select db_stat_date from tbaadm.gct where bank_id = ?SVAR)"
	
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.crAcctNum +"|"+ CUST.CIETXN.refAmt +"|"+ BANCS.INPUT.creditEntity +"|"+ CUST.CIETXN.userCRentitya +"|"+ BANCS.INPUT.creditEntity
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d==0)THEN
	#{
		sv_f = BANCS.OUTPARAM.count
		IF(sv_f != 0) THEN
		#{

			CUST.CIETXN.scriptSuccess = "N"
			CUST.CIETXN.errorMsgDesc = "Transaction Already Created in Other Entity for this Customer"
			#GOTO ENDOFSCRIPT

			CUST.CIETXN.scriptSuccess = "N"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Transaction Already Created in Other Entity for this Customer^prodCode")
			print(sv_u)
			sv_g = "Transaction Already Created in Other Entity for this Customer"
			sv_h = "Y"
			GOTO ENDOFSCRIPT
			
			sv_s = "syshh,sysrcr,sysmins,rcrmins|select  to_char(sysdate,'hh'), to_char(max(rcre_time),'hh'),to_char(sysdate,'mi') , to_char(max(rcre_time),'mi') "
			sv_s = sv_s + " from tbaadm.dtd "
			sv_s = sv_s + " where acid  = (select acid from tbaadm.gam where foracid  = ?SVAR) "
			sv_s = sv_s + " AND  tran_amt = ?SVAR "
			#sv_s = sv_s + " AND  tran_particular like ?SVAR "
			sv_s = sv_s + " AND bank_id  = ?SVAR "
			sv_s = sv_s + " AND TRAN_SUB_TYPE = 'CI'"
			sv_s = sv_s + " AND TRAN_TYPE = 'T'"
			sv_s = sv_s + " AND ENTRY_USER_ID = ?SVAR"
			sv_s = sv_s + " AND tran_date = (select db_stat_date from tbaadm.gct where bank_id = ?SVAR)"
			
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.crAcctNum +"|"+ CUST.CIETXN.refAmt +"|"+ BANCS.INPUT.creditEntity +"|"+ CUST.CIETXN.userCRentitya +"|"+ BANCS.INPUT.creditEntity
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0)THEN
			#{
				sv_f = BANCS.OUTPARAM.sysmins
				sv_t = BANCS.OUTPARAM.rcrmins
				sv_i = BANCS.OUTPARAM.syshh
				sv_m = BANCS.OUTPARAM.sysrcr
				print(sv_f)
				sv_b = cinT(sv_f)-cint(sv_t)
				sv_c = cinT(sv_f) + 60 - cinT(sv_t)
				print(sv_b)
				print(sv_c)
				print(sv_i)
				print(sv_m)
				
				IF(( sv_b < 10) AND (sv_i == sv_m)) THEN
				#{
					sv_g = "Transaction Already Created in Other Entity for this Customer ."
					sv_h = "N"
					IF(sv_h == "N")THEN
					#{
						CUST.CIETXN.scriptSuccess = "N"
						CUST.CIETXN.errorMsgDesc = "Transaction Already Created in Other Entity for this Customer"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					#}
				ELSE
					#{
					sv_g = "No Trans"
					sv_h = "Y"
				#}
				ENDIF
				
				IF((sv_c < 10) AND (sv_i != sv_m)) THEN
				#{
					sv_g = "Transaction Already Created in Other Entity for this Customer "
					sv_h = "N"
					IF(sv_h == "N")THEN
					#{
						CUST.CIETXN.scriptSuccess = "N"
						CUST.CIETXN.errorMsgDesc = "Transaction Already Created in Other Entity for this Customer"
						sv_g = "Transaction Already Created in Other Entity for this Customer"
						sv_h = "Y"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					#}
				ELSE
					#{
					sv_g = "No Trans"
					sv_h = "Y"
				#}
				ENDIF
				
				
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_g = "No Trans"
			sv_h = "Y"
		#}
		ENDIF
		
		
		#}
	ELSE
		#{
		sv_g = "No Trans"
		sv_h = "Y"
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_d = urhk_SetOrbOut("errorFlg|"+ sv_h)
		sv_u = urhk_SetOrbOut("errorMsg|"+sv_g)
		
		
		#trace off
		EXITSCRIPT
END-->
