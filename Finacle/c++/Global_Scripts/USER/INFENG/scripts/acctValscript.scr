sv_s = "acid,schm_type,count|SELECT acid,schm_type,count(*) "
sv_s = sv_s + "FROM TBAADM.GAM "
sv_s = sv_s + "WHERE bank_id  = ?SVAR  "
sv_s = sv_s + "AND foracid = ?SVAR "
sv_s = sv_s + "AND schm_type IN ('SBA','CAA') " 
sv_s = sv_s + "AND acct_cls_flg = 'N' "
sv_s = sv_s + "AND entity_cre_flg = 'Y' "
sv_s = sv_s + "AND del_flg = 'N' "
sv_s = sv_s + "GROUP BY acid, schm_type "
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.acctNo

sv_u = urhk_dbSelectWithBind(sv_s)
PRINT(sv_u)

IF( sv_u == 0 ) THEN
