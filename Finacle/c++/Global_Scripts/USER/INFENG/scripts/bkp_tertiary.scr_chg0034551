	TRACE ON
	##-------------------------------------------------------
	# Repository and Class Creation
	##-------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	sv_a=urhk_B2k_PrintRepos("BANCS")
        PRINT(sv_a)

	print(BANCS.INPUT.guarCovCode)
	CUST.DATA.mscCode = TOUPPER(BANCS.INPUT.guarCovCode)
	CUST.DATA.msInfo = "PF Number Not Captured In The System"
	
	
	sv_a = "myCode|SELECT REF_CODE FROM TBAADM.RCT where REF_CODE=?SVAR and BANK_ID=?SVAR AND ROWNUM=1"
	BANCS.INPARAM.BINDVARS= CUST.DATA.mscCode + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_b = urhk_dbSelectWithBind(sv_a)
	
	if(sv_b == 0)then
	#{
		CUST.DATA.msInfo = "PF Number Captured Successfully"
		print(BANCS.OUTPARAM.myCode)
		sv_u = urhk_SetOrbOut("msgInfo|PF Number Captured Successfully")
		
	#}
	else
	#{
		print("Doesnt exist")
		sv_u = urhk_SetOrbOut("msgInfo|"+CUST.DATA.msInfo)

	#}
	endif

	if(sv_u == 0)then
	#{
		GOTO ENDOFSCRIPT
	#}
	else
	#{
		print("Doesnt exist")
	#}
	endif





	
	ENDOFSCRIPT:
	
	

