		ELSE
			#{
			CUST.LAOPN.errMsg = "  Scheme code should not be null "
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF ((BANCS.STDIN.contextBankId=="54") OR (BANCS.STDIN.contextBankId=="43")) THEN
	#{
		
		IF ((CUST.LAOPN.schmCode != "LA520") AND (CUST.LAOPN.schmCode != "LA526") AND (CUST.LAOPN.schmCode != "LA522") AND (CUST.LAOPN.schmCode != "LA524") and  (CUST.LAOPN.schmCode != "LA549")) THEN
