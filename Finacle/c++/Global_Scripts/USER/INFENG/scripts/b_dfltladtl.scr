			sv_a=GETPOSITION(CUST.CPARAM.opnschmlist,"!" + CUST.LAOPN.schmCode + "!")
			
			PRINT(sv_a)
			IF ((sv_a > 0) AND (CUST.LAOPN.cifid!="XXXXXXXXXX"))  THEN
			#{
				
				####sv_u = urhk_SRV_SetErr(" TO OPEN A LOAN ACCOUNT IN SCHME_CODE " + CUST.LAOPN.schmCode + " KINDLY USE CAS")
				####BANCS.OUTPUT.successOrFailure = "F"
				####EXITSCRIPT
				
				#}
			ELSE
				#{
				sv_a=GETPOSITION(CUST.CPARAM.exprList,"," + CUST.LAOPN.schmCode + ",")
				PRINT(sv_a)
				IF (sv_a > 0) THEN
