	##LOAN ORIGINATION VALIDATIONS FOR UGANDA v2 -- Ayaa
	IF (BANCS.STDIN.contextBankId =="56")  THEN
	#{
		IF (CUST.LAOPN.schmCode!="") THEN
		#{
			sv_s ="uniqueid,uniqueidtype,corpid|select uniqueid,uniqueidtype,corp_id from crmuser.accounts where BANK_ID = ?SVAR AND orgkey=?SVAR AND suspended='N' "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LAOPN.cifid
			PRINT(BANCS.INPARAM.BINDVARS)			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)

			IF (sv_d == 0) THEN
			#{
				CUST.LAOPN.uniqueid = BANCS.OUTPARAM.uniqueid
				print (CUST.LAOPN.uniqueid)
				CUST.LAOPN.uniqueidtype = BANCS.OUTPARAM.uniqueidtype
				print (CUST.LAOPN.uniqueidtype)
				CUST.LAOPN.corpid = BANCS.OUTPARAM.corpid
				print (CUST.LAOPN.corpid)

				##check for Individuals
				IF(CUST.LAOPN.corpid=="") THEN
				#{
					##Check for Registered Entities opened with individual CIFs & check for phone solution CIFs with wrongly maintained Gender "Others"
					sv_s = "gender|select gender from crmuser.accounts where BANK_ID = ?SVAR and orgkey = ?SVAR "
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LAOPN.cifid
					PRINT(BANCS.INPARAM.BINDVARS)			
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)

					IF(sv_d == 0) THEN
					#{
						CUST.LAOPN.gender = BANCS.OUTPARAM.gender
						print (CUST.LAOPN.gender)

						IF((CUST.LAOPN.gender != "M") AND (CUST.LAOPN.gender != "F")) THEN
						#{
							sv_u = urhk_SRV_SetErr("Kindly maintain the correct Gender for " + CUST.LAOPN.cifid + " in CRM")
							BANCS.OUTPUT.successOrFailure = "F"
							EXITSCRIPT
						#}
						ENDIF
					#}
					ENDIF

					sv_s = "referencenumber,identificationtype,preferreduniqueid,doctypecode|select referencenumber,identificationtype,preferreduniqueid,doctypecode from crmuser.entitydocument where bank_id = ?SVAR and orgkey = ?SVAR and preferreduniqueid = 'Y' "
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LAOPN.cifid
					PRINT(BANCS.INPARAM.BINDVARS)			
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)

					IF(sv_d == 0) THEN
					#{
						CUST.LAOPN.referencenumber = BANCS.OUTPARAM.referencenumber
						print (CUST.LAOPN.referencenumber)
						CUST.LAOPN.identificationtype = BANCS.OUTPARAM.identificationtype
						print (CUST.LAOPN.identificationtype)
						CUST.LAOPN.preferreduniqueid = BANCS.OUTPARAM.preferreduniqueid
						print (CUST.LAOPN.preferreduniqueid)
						CUST.LAOPN.doctypecode = BANCS.OUTPARAM.doctypecode
						print (CUST.LAOPN.doctypecode)
						
						## Check if doctypecode is maintaned correctly in entitydocument
						IF((CUST.LAOPN.doctypecode != "INDIV") AND (CUST.LAOPN.doctypecode != "FOREN") AND (CUST.LAOPN.doctypecode != "REFUG")) THEN
						#{
								sv_u = urhk_SRV_SetErr("Kindly maintain the correct doctypecode for " + CUST.LAOPN.cifid + " in CRM")
								BANCS.OUTPUT.successOrFailure = "F"
								EXITSCRIPT
						#}
						ENDIF

						IF(CUST.LAOPN.doctypecode == "INDIV") THEN
						#{
							IF(CUST.LAOPN.identificationtype != "National Card Number") THEN
							#{
								sv_u = urhk_SRV_SetErr("Kindly capture the National ID Number for " + CUST.LAOPN.cifid + " in CRM")
								BANCS.OUTPUT.successOrFailure = "F"
								EXITSCRIPT
							#}
							ENDIF
						#}	
						ENDIF
						
						IF(CUST.LAOPN.doctypecode == "FOREN") THEN
						#{
							IF((CUST.LAOPN.identificationtype != "Passport Number") AND (CUST.LAOPN.identificationtype != "IDTypeR6")) THEN
							#{
								sv_u = urhk_SRV_SetErr("Kindly capture the Passport Number/Work Permit Number for " + CUST.LAOPN.cifid + " in CRM")
								BANCS.OUTPUT.successOrFailure = "F"
								EXITSCRIPT
							#}
							ENDIF
						#}	
						ENDIF
						
						IF(CUST.LAOPN.doctypecode == "REFUG") THEN
						#{
							IF(CUST.LAOPN.identificationtype != "IDTypeR2") THEN
							#{
								sv_u = urhk_SRV_SetErr("Kindly capture the Refugee ID Number for " + CUST.LAOPN.cifid + " in CRM")
								BANCS.OUTPUT.successOrFailure = "F"
								EXITSCRIPT
							#}
							ENDIF
						#}	
						ENDIF
						
						## check for schemes for customers who must be salaried/employed
						IF((CUST.LAOPN.schmCode =="LA504") OR (CUST.LAOPN.schmCode =="LA507") OR (CUST.LAOPN.schmCode =="LA511") OR (CUST.LAOPN.schmCode =="LA512") OR (CUST.LAOPN.schmCode =="LA513") OR (CUST.LAOPN.schmCode =="LA555") OR (CUST.LAOPN.schmCode =="LA565") OR (CUST.LAOPN.schmCode =="LA566") OR (CUST.LAOPN.schmCode =="LA567") OR (CUST.LAOPN.schmCode =="LA568") OR (CUST.LAOPN.schmCode =="LA590") OR (CUST.LAOPN.schmCode =="LA591") OR (CUST.LAOPN.schmCode =="LA592") OR (CUST.LAOPN.schmCode =="LA593") OR (CUST.LAOPN.schmCode =="LA594") OR (CUST.LAOPN.schmCode =="LA595")) THEN
						#{
							
							sv_s = "employment_status,employersname,employerid,annual_salary_income,income_freq|select employment_status,employersname,employerid,annual_salary_income,income_freq from crmuser.demographic where bank_id = ?SVAR and orgkey = ?SVAR "
							BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LAOPN.cifid
							PRINT(BANCS.INPARAM.BINDVARS)			
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)

							IF(sv_d == 0) THEN
							#{
								CUST.LAOPN.employment_status = BANCS.OUTPARAM.employment_status
								print (CUST.LAOPN.employment_status)
								CUST.LAOPN.employersname = BANCS.OUTPARAM.employersname
								print (CUST.LAOPN.employersname)
								CUST.LAOPN.employerid = BANCS.OUTPARAM.employerid
								print (CUST.LAOPN.employerid)
								CUST.LAOPN.annual_salary_income = BANCS.OUTPARAM.annual_salary_income
								print (CUST.LAOPN.annual_salary_income)
								CUST.LAOPN.income_freq= BANCS.OUTPARAM.income_freq
								print (CUST.LAOPN.income_freq)

								##check if customer is salaried or employed
								IF((BANCS.OUTPARAM.employment_status == "Salaried") OR (BANCS.OUTPARAM.employment_status == "Employed")) THEN
								#{
									IF((BANCS.OUTPARAM.employersname == "") OR (BANCS.OUTPARAM.annual_salary_income == "") OR (BANCS.OUTPARAM.annual_salary_income == 0) OR (BANCS.OUTPARAM.income_freq == "")) THEN
									#{
										sv_u = urhk_SRV_SetErr("Kindly maintain the employment details for " + CUST.LAOPN.cifid + " in CRM")
										BANCS.OUTPUT.successOrFailure = "F"
										EXITSCRIPT
									#}
									ENDIF	
								#}
								ELSE
								#{
									sv_u = urhk_SRV_SetErr("Kindly maintain the employment details for " + CUST.LAOPN.cifid + " in CRM")
									BANCS.OUTPUT.successOrFailure = "F"
									EXITSCRIPT
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ELSE
					#{
						sv_u = urhk_SRV_SetErr("Kindly maintain the ID as preferred for " + CUST.LAOPN.cifid + " in CRM")
						BANCS.OUTPUT.successOrFailure = "F"
						EXITSCRIPT
					#}	
					ENDIF
				#}
				ENDIF

				##check for Registered Entities
				IF(CUST.LAOPN.corpid != "") THEN
				#{
					sv_s = "count|select count(*) from crmuser.entitydocument where BANK_ID = ?SVAR and orgkey = ?SVAR and doctypecode = 'RGENT' and doccode in ('RGNCT','INCCT') "
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LAOPN.cifid
					PRINT(BANCS.INPARAM.BINDVARS)			
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)			
					PRINT(BANCS.OUTPARAM.count)

					IF (cdouble(BANCS.OUTPARAM.count) >= 1)  THEN
					#{
						##CHECK FOR SHAREHOLDERS
						sv_s = "count_sh|select count(*) from CRMUSER.ENTITYRELATIONSHIP where BANK_ID = ?SVAR and orgkey = ?SVAR and RELATIONSHIP = 'ShareHolder' "
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LAOPN.cifid
						PRINT(BANCS.INPARAM.BINDVARS)			
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						sv_e = BANCS.OUTPARAM.count_sh			
						PRINT(sv_e)

						##CHECK FOR DIRECTORS	
						sv_s = "count_dir|select count(*) from crmuser.corpmiscellaneousinfo where BANK_ID = ?SVAR and orgkey = ?SVAR and STR11 = 'DIR' AND TYPE = 'Relation' "
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LAOPN.cifid
						PRINT(BANCS.INPARAM.BINDVARS)			
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						sv_f = BANCS.OUTPARAM.count_dir	
						PRINT(sv_f)

						IF ((sv_e == 0) AND (sv_f == 0))  THEN
						#{
							sv_u = urhk_SRV_SetErr("Kindly capture the Stakeholder(ShareHolder/Director) details for  " + CUST.LAOPN.cifid + " in CRM")
							BANCS.OUTPUT.successOrFailure = "F"
							EXITSCRIPT
						#}
						ENDIF
					#}
					ELSE
					#{
						sv_u = urhk_SRV_SetErr("Kindly capture the Registration Number/Certificate of Incorporation Number for  " + CUST.LAOPN.cifid + " in CRM")
						BANCS.OUTPUT.successOrFailure = "F"
						EXITSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ELSE
			#{
				sv_u = urhk_SRV_SetErr("CIF " + CUST.LAOPN.cifid + " is Suspended in CRM")
				BANCS.OUTPUT.successOrFailure = "F"
				EXITSCRIPT
			#}
			ENDIF
		#}
		ENDIF	
	#}
	ENDIF
	## --ends LOAN ORIGINATION VALIDATIONS FOR UGANDA v2 -- Ayaa
	
	######Taking care of IGLs
	BANCS.INPUT.moduleName = "LAOPN"
	BANCS.INPUT.parameterId = "OPNIGLSHMLIST"
	
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.opniglSchmList = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.opniglSchmList)
		#}
	ELSE
		#{
		CUST.LAOPN.errMsg = "OpenSchemeList setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# TO OPEN A LOAN ACCOUNT IN SCHME_CODE
	#--------------------------------------------------------------------------
	IF (CUST.LAOPN.schmCode != "") THEN
	#{
		sv_a=GETPOSITION(CUST.CPARAM.opniglSchmList,"!" + CUST.LAOPN.schmCode + "!")
		
		PRINT(sv_a)
		IF (sv_a > 0) THEN
		#{
			
			sv_u = urhk_SRV_SetErr(" TO OPEN A LOAN ACCOUNT IN SCHME_CODE " + CUST.LAOPN.schmCode + " KINDLY USE IGLS")
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.LAOPN.errMsg = "  Scheme code should not be null "
		EXITSCRIPT
	#}
	ENDIF


	
	TRACE OFF
END-->
