<--START
CHECKSUM="24dc7d97c583e4ce16035bffe1921b44a99687631c5e4d28ba23db023046791f"
	TRACE ON
	
	
	IF(CUST.INTERFACE.DrAcct != CUST.INTERFACE.CrAcct) THEN
	#{
		#---------------------------------------------------------------------------------
		# Validating the DD Number
		#---------------------------------------------------------------------------------
		
		IF(CUST.INTERFACE.DrSchmType == "DDA") THEN
		#{
                        if(CUST.INTERFACE.DrAcct=="0003000403167")then
                                if(CUST.INTERFACE.DrSchmCode=="DIVID")then
                                        CUST.INTERFACE.InstType = "DIV"
                                endif
                                if(CUST.INTERFACE.DrSchmCode=="BNKCH")then
                                        CUST.INTERFACE.InstType = "BC"
                                endif
                        else
                        print(CUST.INTERFACE.InstType)
                        endif
			print(CUST.INTERFACE.InstType)
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.InstNum + "|" + CUST.INTERFACE.DrSchmCode
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.DrCrncyCode
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|U|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.solId
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.DrTranAmt
			print(BANCS.INPARAM.BINDVARS)
			lv_r = "ddstatus,cautionstatus,payeebrcode,payeebnkcode,issuBrCode,issuBnkCode,issuExtnCode,payeename,issue_date|SELECT DD_STATUS,CAUTIONED_STAT,"
			lv_r = lv_r + " PAYEE_BR_CODE,PAYEE_BANK_CODE,issu_br_code,issu_bank_code,ISSU_EXTN_CNTR_CODE, PAYEE_NAME,to_char(issue_date,'DD-MM-YYYY') FROM TBAADM.DST"
			lv_r = lv_r + " WHERE DD_NUM  = ?SVAR "
			lv_r = lv_r + " AND SCHM_CODE = ?SVAR "
			lv_r = lv_r + " AND DD_CRNCY_CODE = ?SVAR "
			lv_r = lv_r + " AND DD_STATUS = ?SVAR "
			lv_r = lv_r + " AND BANK_ID = ?SVAR "
			lv_r = lv_r + " AND ISSU_BR_CODE  = ?SVAR "
			lv_r = lv_r + " AND DD_AMT  = ?SVAR "
			
			print(lv_r)
			
			lv_e = urhk_dbSelectWithBind(lv_r)
			
			IF (lv_e ==0) THEN
			#{
				CUST.INTERFACE.InstNum = LPAD(CUST.INTERFACE.InstNum,16,' ')
				CUST.INTERFACE.DDSTATUS = BANCS.OUTPARAM.ddstatus
				CUST.INTERFACE.CAUTIONSTATUS = BANCS.OUTPARAM.cautionstatus
				CUST.INTERFACE.DDPayeeBr = BANCS.OUTPARAM.payeebrcode
				print(CUST.INTERFACE.DDPayeeBr)
				CUST.INTERFACE.DDPayeeBnk = BANCS.OUTPARAM.payeebnkcode
				print(CUST.INTERFACE.DDPayeeBnk)
				CUST.INTERFACE.issuBrCode = BANCS.OUTPARAM.issuBrCode
				print(CUST.INTERFACE.issuBrCode)
				CUST.INTERFACE.issuBnkCode = BANCS.OUTPARAM.issuBnkCode
				print(CUST.INTERFACE.issuBnkCode)
				CUST.INTERFACE.issuExtnCode = BANCS.OUTPARAM.issuExtnCode
				print(CUST.INTERFACE.issuExtnCode)
				CUST.INTERFACE.PayeeName = BANCS.OUTPARAM.payeename
				print(CUST.INTERFACE.PayeeName)
				CUST.INTERFACE.MCIssueDate = BANCS.OUTPARAM.issue_date
				print(CUST.INTERFACE.MCIssueDate)
				
				IF (CUST.INTERFACE.PayeeName == "") THEN
				#{
					CUST.INTERFACE.PayeeName = " "
				#}
				ENDIF
				
				IF(CUST.INTERFACE.DDSTATUS== "P") THEN
				#{
					CUST.INTERFACE.DrAcct = CUST.INTERFACE.CrAcct
					CUST.INTERFACE.errorCode = "ERR063"
					CUST.INTERFACE.successOrFailure = "F"
					
					CUST.INTERFACE.InstType = "CHQ"
					
					GOTO FINISH
				#}
				ENDIF
				
				IF(CUST.INTERFACE.CAUTIONSTATUS == "S") THEN
				#{
					CUST.INTERFACE.DrAcct = CUST.INTERFACE.CrAcct
					CUST.INTERFACE.errorCode = "ERR064"
					CUST.INTERFACE.successOrFailure = "F"
					
					CUST.INTERFACE.InstType = "CHQ"
					
					GOTO FINISH
				#}
				ENDIF
				
				IF((CUST.INTERFACE.CAUTIONSTATUS == "C") OR (CUST.INTERFACE.CAUTIONSTATUS == "L") OR (CUST.INTERFACE.CAUTIONSTATUS == "M")) THEN
				#{
					CUST.INTERFACE.DrAcct = CUST.INTERFACE.CrAcct
					CUST.INTERFACE.errorCode = "ERR065"
					CUST.INTERFACE.successOrFailure = "F"
					
					CUST.INTERFACE.InstType = "CHQ"
					
					GOTO FINISH
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.INTERFACE.DrAcct = CUST.INTERFACE.CrAcct
				CUST.INTERFACE.errorCode = "ERR066"
				CUST.INTERFACE.successOrFailure = "F"
				
				CUST.INTERFACE.InstType = "CHQ"
				
				GOTO FINISH
			#}
			ENDIF
			
			print(CUST.INTERFACE.InstType)
			#}
		ELSE
			#{
			
			#---------------------------------------------------------------------------------
			# Validating the Cheque Number
			#---------------------------------------------------------------------------------
			
			CUST.INTERFACE.InstType = "CHQ"
			
			BANCS.INPARAM.AccountId = CUST.INTERFACE.DrAcct
			print(BANCS.INPARAM.AccountId)
			BANCS.INPARAM.InstrumentNumber = CUST.INTERFACE.InstNum
			print(BANCS.INPARAM.InstrumentNumber)
			BANCS.INPARAM.InstrumentAlpha = "!"
			print(BANCS.INPARAM.InstrumentAlpha)
			sv_e = urhk_B2k_valInstrumentNumForAcct("")
			print(sv_e)
			IF(sv_e == 0)THEN
			#{
				print(BANCS.OUTPARAM.ReturnCode)
				print(BANCS.OUTPARAM.ChqStatus)
				sv_s = BANCS.OUTPARAM.ChqStatus
				print(sv_s)
				IF (sv_s == "S") THEN
				#{
					CUST.INTERFACE.DrAcct = CUST.INTERFACE.CrAcct
					CUST.INTERFACE.errorCode = "ERR064"
					CUST.INTERFACE.successOrFailure = "F"
					
					
					GOTO FINISH
				#}
				ENDIF
				
				IF(sv_s == "P") THEN
				#{
					CUST.INTERFACE.DrAcct = CUST.INTERFACE.CrAcct
					CUST.INTERFACE.errorCode = "ERR063"
					CUST.INTERFACE.successOrFailure = "F"
					
					GOTO FINISH
				#}
				ENDIF
				
				IF ((sv_s == "C") OR (sv_s == "D") OR (sv_s == "R") OR (sv_s=="I"))THEN
				#{
					CUST.INTERFACE.DrAcct = CUST.INTERFACE.CrAcct
					CUST.INTERFACE.errorCode = "ERR067"
					CUST.INTERFACE.successOrFailure = "F"
					
					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# Validating the Cr Account.
	#---------------------------------------------------------------------------------
	
	sv_b = urhk_getAcctDetailsInRepository(CUST.INTERFACE.CrAcct)
	IF(sv_b==1) THEN
	#{
		CUST.INTERFACE.errorCode = "ERR068"
		CUST.INTERFACE.successOrFailure = "F"
		
		GOTO FINISH
	#}
	ENDIF
	
	
	
	#trace off
END-->
