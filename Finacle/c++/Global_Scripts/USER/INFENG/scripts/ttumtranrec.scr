#----------------------------------------------------------------------------------------------------------
# Filename              :       ttumtranrec.scr
# Author                :
# Description           :       Retun tran records[Total Cr and Dr | Total Cr and Dr Amount]
# Input                 :       NA
# Output                :       NA
# Called Script         :       None
# Calling Script        :       Ttumupload.mrt
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           01-08-2023         Gichiri	          original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="6a3aadbcb8e533df260313484577ed020cec59ede3ad5b1710599d857c17ce63"
	TRACE ON
	
	LIBNAME CUSTOMSO
	
	#----------------------------------------------------------------------
	# Create the necessary repositories and Classes
	#----------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","TTUM") == 0) THEN
	#{
		CREATECLASS("CUST","TTUM",5)
	#}
	ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	BANCS.OUTPUT.totalcredit = ""
 	BANCS.OUTPUT.totaldebits = "" 
        BANCS.OUTPUT.totalCrAmt = "" 
        BANCS.OUTPUT.totalDrAmt = "" 
	#PRINT(BANCS.INPUT.fire_bfti_flg)
	#--------------Read the records in the file--------------------------------------------------

	sv_t = urtn_fileOpen("ttumtranrec.log|r")
	IF (sv_t < 0) THEN
	#{
		PRINT("file cannot be open")
		BANCS.OUTPUT.tranrec = " 0 0 0 0"
		GOTO ENDOFTTUMDP003
	#}
	ENDIF
	CUST.TTUM.dataFileIndex = sv_t
	PRINT(CUST.TTUM.dataFileIndex)
	sv_e = urtn_fileRead(CUST.TTUM.dataFileIndex + "|CUST.TTUM.tranrec")
	PRINT(sv_e)
	PRINT(CUST.TTUM.tranrec)
	
	sv_u = SYSTEM("rm -f ttumtranrec.log")
	PRINT(sv_u)
	#=============================================================
	sv_d = "totalcredit,totaldebits,totalCrAmt,totalDrAmt|SELECT REGEXP_SUBSTR(?SVAR, '[^!]+', 1, 1) totalCr,"
	sv_d = sv_d + "REGEXP_SUBSTR(?SVAR, '[^!]+', 1, 2) totalDr,"
	sv_d = sv_d + "REGEXP_SUBSTR(?SVAR, '[^!]+', 1, 3) totalCrAmt,"
	sv_d = sv_d + "REGEXP_SUBSTR(?SVAR, '[^!]+', 1, 4) totalDrAmt "
	sv_d = sv_d + "FROM DUAL"
	print(sv_d)
	
	#=============================================================
	
	BANCS.INPARAM.BINDVARS = CUST.TTUM.tranrec +"|"+ CUST.TTUM.tranrec +"|"+  CUST.TTUM.tranrec +"|"+  CUST.TTUM.tranrec
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		BANCS.OUTPUT.totalcredit = BANCS.OUTPARAM.totalcredit
		BANCS.OUTPUT.totaldebits = BANCS.OUTPARAM.totaldebits
		BANCS.OUTPUT.totalCrAmt = BANCS.OUTPARAM.totalCrAmt
		BANCS.OUTPUT.totalDrAmt = BANCS.OUTPARAM.totalDrAmt
	else
			print("Error occurred!!")
	endif

	#--------------------end
	
	print(BANCS.OUTPUT.totalcredit)
	print(BANCS.OUTPUT.totaldebits)
	print(BANCS.OUTPUT.totalCrAmt)
	print(BANCS.OUTPUT.totalDrAmt)
	
	sv_u = urtn_fileClose(CUST.TTUM.dataFileIndex)
	
	

	
	ENDOFTTUMDP003:
		
		TRACE OFF
EXITSCRIPT		
END-->
