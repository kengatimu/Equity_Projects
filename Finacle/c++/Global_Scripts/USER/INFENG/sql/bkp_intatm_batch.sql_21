er.address set HOLDMAILFLAG='N' where bank_id='43' and orgkey in (
	select cif_id  from CUSTOM.INT_CREDIT_CRA_DRC where STATUS_FLG='F' and cif_id in (select orgkey from crmuser.accounts where bank_id='43') and remarks like '%CRMEJB0016.Hold mail Indicator is required%')
and PREFERREDADDRESS='Y'  and HOLDMAILFLAG  is null;
/
commit;
/
update crmuser.phoneemail set PHONENOLOCALCODE='243' where bank_id ='43' and orgkey in ( 
	select cif_id  from CUSTOM.INT_CREDIT_CRA_DRC where STATUS_FLG='F' and  remarks like '% CRMEJB0016.Phone Number Local Code is required, please provide the value%')
and PHONEOREMAIL='PHONE' and PREFERREDFLAG='Y' and PHONENOLOCALCODE is  null;
/
commit;
/
update CRMUSER.ACCOUNTS  set  SUBSEGMENT ='MIDDLE'   where bank_id='43'
orgkey in (select cif_id  from CUSTOM.INT_CREDIT_CRA_DRC where STATUS_FLG='F'  and  remarks like '% CRMEJB0123.The value provided for , AccountBO.SubSegment is not valid data category%')
and SEGMENTATION_CLASS='RETAIL'
/
commit;
/
update CRMUSER.ACCOUNTS  set  SUBSEGMENT ='MEDIUM'   where bank_id='43'
orgkey in (select cif_id  from CUSTOM.INT_CREDIT_CRA_DRC where STATUS_FLG='F'  and  remarks like '% CRMEJB0123.The value provided for , AccountBO.SubSegment is not valid data category%')
and SEGMENTATION_CLASS='MSME'
/
commit;
/
update crmuser.address set state='KIN' where bank_id='43' and orgkey in (
	select cif_id  from CUSTOM.INT_CREDIT_CRA_DRC where STATUS_FLG='F' and cif_id in (select orgkey from crmuser.accounts where bank_id='43') and remarks like '%AccountBO.Address.state is not valid data category%')
and state='.';
/
commit;
/ 
update crmuser.address set city='KIN' where bank_id='43' and orgkey in (
	select cif_id  from CUSTOM.INT_CREDIT_CRA_DRC where STATUS_FLG='F' and cif_id in (select orgkey from crmuser.accounts where bank_id='43') and remarks like '%AccountBO.Address.state is not valid data category%')
and city='.';
/
commit;
/ 
update crmuser.address set zip='243' where bank_id='43' and orgkey in (
	select cif_id  from CUSTOM.INT_CREDIT_CRA_DRC where STATUS_FLG='F' and cif_id in (select orgkey from crmuser.accounts where bank_id='43') and remarks like '%Zip is required, please provide the value%')
and PREFERREDADDRESS='Y' and zip is null;
/
commit;
/
update CUSTOM.INT_CREDIT_CRA_DRC set REMARKS='',STATUS_FLG=''  where STATUS_FLG='F' AND remarks like '%CRMEJB0016.Hold mail Indicator is required%'
/
commit;
/
update CUSTOM.INT_CREDIT_CRA_DRC set REMARKS='',STATUS_FLG=''  where STATUS_FLG='F' AND remarks like '% CRMEJB0016.Phone Number Local Code is required, please provide the value%'
/
commit;
/
update CUSTOM.INT_CREDIT_CRA_DRC set REMARKS='',STATUS_FLG=''  where STATUS_FLG='F' and  remarks like '% CRMEJB0123.The value provided for , AccountBO.SubSegment is not valid data category%';
/
commit;
/
update CUSTOM.INT_CREDIT_CRA_DRC set REMARKS='',STATUS_FLG=''  where STATUS_FLG='F' and  remarks like '%Zip is required, please provide the value%';
/
commit;
/
CREATE TABLE CUSTOM.INT_CREDIT_CRA_DRCDONE
(
	  CIF_ID            VARCHAR2(100 CHAR),
	  ACCOUNT_NAME      VARCHAR2(100 BYTE),
	  FINAL_RISK_SCORE  VARCHAR2(100 CHAR),
	  RISK_RATING       VARCHAR2(100 CHAR),
	  BANK_ID           VARCHAR2(8 CHAR),
	  REMARKS           VARCHAR2(1000 BYTE),
	  STATUS_FLG        VARCHAR2(20 BYTE)
);
/
commit;
/
exit;
/

