va.lang.String%15::CATOD_SANCTION_TABLE%RCRE_DATE%CATOD_SANCTION_TABLE_RCRE_DATE%java.sql.Timestamp%7::CATOD_SANCTION_TABLE%LCHG_USER%CATOD_SANCTION_TABLE_LCHG_USER%java.lang.String%15::CATOD_SANCTION_TABLE%LCHG_DATE%CATOD_SANCTION_TABLE_LCHG_DATE%java.sql.Timestamp%7::CATOD_SANCTION_TABLE%E_TYPE%CATOD_SANCTION_TABLE_E_TYPE%java.lang.String%2::CATOD_SANCTION_TABLE%EXT_REQ%CATOD_SANCTION_TABLE_EXT_REQ%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%EXT_APP%CATOD_SANCTION_TABLE_EXT_APP%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%ENC_REQ%CATOD_SANCTION_TABLE_ENC_REQ%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%ENC_APP%CATOD_SANCTION_TABLE_ENC_APP%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%MSG_IND%CATOD_SANCTION_TABLE_MSG_IND%java.lang.String%1::CATOD_SANCTION_TABLE%EMAIL_FLG%CATOD_SANCTION_TABLE_EMAIL_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%SMS_FLG%CATOD_SANCTION_TABLE_SMS_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%IS_DELETED%CATOD_SANCTION_TABLE_IS_DELETED%java.lang.String%1::CATOD_SANCTION_TABLE%ADM_FEES%CATOD_SANCTION_TABLE_ADM_FEES%java.lang.String%1::CATOD_SANCTION_TABLE%CLS_FLG%CATOD_SANCTION_TABLE_CLS_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%BANK_ID%CATOD_SANCTION_TABLE_BANK_ID%java.lang.String%10::CATOD_SANCTION_TABLE%ENTITY_CRE_FLG%CATOD_SANCTION_TABLE_ENTITY_CRE_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%DEL_FLG%CATOD_SANCTION_TABLE_DEL_FLG%java.lang.String%1::CATOD_SANCTION_TABLE%FEE%CATOD_SANCTION_TABLE_FEE%java.math.BigDecimal%22::CATOD_SANCTION_TABLE%FEE_TRAN_ID%CATOD_SANCTION_TABLE_FEE_TRAN_ID%java.lang.String%8::|!NULL!|CATOD_SANCTION_TABLE%REQUEST_ID%REQUEST_ID%java.lang.String%16::CATOD_SANCTION_TABLE%ACCT_NAME%CATOD_SANCTION_TABLE_ACCT_NAME%java.lang.String%80::|!NULL!|CATOD_SANCTION_TABLE%REQUEST_ID%REQUEST_ID%java.lang.String%16::CATOD_SANCTION_TABLE%ACCT_NAME%CATOD_SANCTION_TABLE_ACCT_NAME%java.lang.String%80::|where%CATOD_SANCTION_TABLE.SOL_ID%=%$P{SOL_ID}%Parameter%String::and%CATOD_SANCTION_TABLE.REQUEST_ID%=%$P{REQUEST_ID}%Parameter%String::and%CATOD_SANCTION_TABLE.ACCT_NUM%=%$P{ACCT_NUM}%Parameter%String::and%CATOD_SANCTION_TABLE.STATUS_FLG%=%$P{STATUS_FLG}%Parameter%String::|SOL_ID%java.lang.String%100%!NULL!%SOL ID@DBQUERY%PRODUCT!@!SolID_List#@#N%java.lang.String!@!DEFAULT!@!0!@!100%CONSTANT%N%N::REQUEST_ID%java.lang.String%16%!NULL!%REQUEST ID@DBQUERY%NONE%java.lang.String!@!DEFAULT!@!0!@!16%CONSTANT%N%N::ACCT_NUM%java.lang.String%16%!NULL!%ACCT NUM@DBQUERY%PRODUCT!@!AC_ID_Lookup#@#N%java.lang.String!@!DEFAULT!@!0!@!16%CONSTANT%N%N::STATUS_FLG%java.lang.String%100%!NULL!%STATUS FLAG@DBQUERY%NONE%java.lang.String!@!DEFAULT!@!0!@!1%CONSTANT%N%N::FROM_DATE%java.sql.Timestamp%10%!NULL!%SANCTION FROM DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::TO_DATE%java.sql.Timestamp%10%!NULL!%SANCTION TO DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::|!NULL!|!NULL!|!NULL!|select     CATOD_SANCTION_TABLE.REQUEST_ID as *REQUEST_ID* ,     CATOD_SANCTION_TABLE.ACCT_NAME as *CATOD_SANCTION_TABLE_ACCT_NAME* from     CUSTOM.CATOD_SANCTION_TABLE CATOD_SANCTION_TABLE  where    CATOD_SANCTION_TABLE.SOL_ID = $P{SOL_ID}     and CATOD_SANCTION_TABLE.REQUEST_ID = $P{REQUEST_ID}     and CATOD_SANCTION_TABLE.ACCT_NUM = $P{ACCT_NUM}     and CATOD_SANCTION_TABLE.STATUS_FLG = $P{STATUS_FLG}|SELECT      A.REQUEST_ID,      A.ACCT_NUM,      A.ACCT_NAME,      A.SOL_ID,      B.SCHM_CODE,      DECODE(REQ_TYPE,'F','FRESH','E',DECODE(E_TYPE,'01','ENHANCEMENT','02','EXTENSION','03','EXT/ENC'),'C','TERMINATED')REQ_TYPE,      DECODE(STATUS_FLG,'A','APPROVED','P','PENDING','R','REJECTED','X','EXPIRED','C','TERMINATED')STATUS,      NVL(TO_CHAR(CREATED_BY),'-')CREATED_BY,      NVL(TO_CHAR(CREATED_DATE,'DD-MM-YYYY'),'-')CREATED_DATE,      NVL(TO_CHAR(MODIFIED_BY),'-')MODIFIED_BY,      NVL(TO_CHAR(MODIFIED_DATE,'DD-MM-YYYY'),'-')MODIFIED_DATE,      NVL(TO_CHAR(VERIFY_BY),'-')VERIFY_BY,      NVL(TO_CHAR(VERIFY_DATE,'DD-MM-YYYY'),'-')VERIFY_DATE,      NVL(TO_CHAR(SANCT_DATE,'DD-MM-YYYY'),'-')SANCT_DATE,      NVL(TO_CHAR(SANCT_PERIOD),'-')SANCT_PERIOD,      NVL(TO_CHAR(EXPIRY_DATE,'DD-MM-YYYY'),'-')EXPIRY_DATE,      NVL(TO_CHAR(SANCT_AMT),'-')SANCT_AMT FROM      *CUSTOM*.*CATOD_SANCTION_TABLE* A,*TBAADM*.*GAM* B WHERE      A.ACCT_NUM = B.FORACID AND      (A.SOL_ID = $P{SOL_ID}      or NVL($P{SOL_ID},'ALL') = 'ALL')      and (A.REQUEST_ID = $P{REQUEST_ID}      or NVL($P{REQUEST_ID},'ALL') = 'ALL')      and (A.ACCT_NUM = $P{ACCT_NUM}      or NVL($P{ACCT_NUM},'ALL') = 'ALL')      and (A.STATUS_FLG = $P{STATUS_FLG}      or NVL($P{STATUS_FLG},'ALL') = 'ALL')      and (A.SANCT_DATE BETWEEN TO_DATE(NVL($P{FROM_DATE},'01-01-1900'),'DD-MM-YYYY')  AND TO_DATE(NVL($P{TO_DATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY'))|true"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
     A.REQUEST_ID,
     A.ACCT_NUM,
     A.ACCT_NAME,
     A.SOL_ID,
     B.SCHM_CODE,
     DECODE(REQ_TYPE,'F','FRESH','E',DECODE(E_TYPE,'01','ENHANCEMENT','02','EXTENSION','03','EXT/ENC'),'C','TERMINATED')REQ_TYPE,
     DECODE(STATUS_FLG,'A','APPROVED','P','PENDING','R','REJECTED','X','EXPIRED','C','TERMINATED')STATUS,
     NVL(TO_CHAR(CREATED_BY),'-')CREATED_BY,
     NVL(TO_CHAR(CREATED_DATE,'DD-MM-YYYY'),'-')CREATED_DATE,
     NVL(TO_CHAR(MODIFIED_BY),'-')MODIFIED_BY,
     NVL(TO_CHAR(MODIFIED_DATE,'DD-MM-YYYY'),'-')MODIFIED_DATE,
     NVL(TO_CHAR(VERIFY_BY),'-')VERIFY_BY,
     NVL(TO_CHAR(VERIFY_DATE,'DD-MM-YYYY'),'-')VERIFY_DATE,
     NVL(TO_CHAR(SANCT_DATE,'DD-MM-YYYY'),'-')SANCT_DATE,
     NVL(TO_CHAR(SANCT_PERIOD),'-')SANCT_PERIOD,
     NVL(TO_CHAR(EXPIRY_DATE,'DD-MM-YYYY'),'-')EXPIRY_DATE,
     NVL(TO_CHAR(SANCT_AMT),'-')SANCT_AMT
FROM
     "CUSTOM"."CATOD_SANCTION_TABLE" A,"TBAADM"."GAM" B
WHERE
     A.ACCT_NUM = B.FORACID AND
     (A.SOL_ID = $P{SOL_ID}
     or NVL($P{SOL_ID},'ALL') = 'ALL')
     and (A.REQUEST_ID = $P{REQUEST_ID}
     or NVL($P{REQUEST_ID},'ALL') = 'ALL')
     and (A.ACCT_NUM = $P{ACCT_NUM}
     or NVL($P{ACCT_NUM},'ALL') = 'ALL')
     and (A.STATUS_FLG = UPPER($P{STATUS_FLG})
     or NVL($P{STATUS_FLG},'ALL') = 'ALL')
     and (A.SANCT_DATE BETWEEN TO_DATE(NVL($P{FROM_DATE},'01-01-1900'),'DD-MM-YYYY')
 AND TO_DATE(NVL($P{TO_DATE},TO_CHAR(SYSDATE,'DD-MM-YYYY')),'DD-MM-YYYY'))]]></queryString>

