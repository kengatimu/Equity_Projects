#####################################################################
RECORDLAYOUT
#####################################################################
cifID     stringType 
acctnum   stringType
schmCode  stringType

#####################################################################
LOCALVARIABLES
#####################################################################
	total_pages		StringType
	totalpages		NumberType
	reportCnt		NumberType

#####################################################################
GroupAndSort
#####################################################################
#	solID

#####################################################################  
REPOSITORY bankRepos.rip
#####################################################################
	bankName		StringType
	branchName		StringType
	BODDate			StringType
	userId			StringType

#####################################################################
PAGEFORMAT 
#####################################################################
	linesperpage		60
	columnsperline		100
	pageheaderlines		9
	topMargin			3
	bottomMargin		3
	pagefooterlines		4
	LeftMargin 			3
	RightMargin 		3
#####################################################################
ONSTARTOFREPORT
#####################################################################
	execute columnTitle
	execute pageTitle

#####################################################################
PAGEHEADER
#####################################################################
	execute columnTitle
	execute pageTitle
#####################################################################
ONEVERYRECORD
#####################################################################
	set reportCnt=reportCnt+1
	execute printrecords

#####################################################################  
ONENDOFREPORT
#####################################################################
	if (reportCnt=0)
	begin	
		nextline
		print "-------------No Data Found -------------" center size 70
	end

#####################################################################
PROCEDURE columnTitle
#####################################################################
BEGIN
	print bankName						center size 70
	nextline
	print branchName					center size 70
	nextline
	nextline
	print "Nominal Accounts Creation" 	center size 70
	nextline
	nextline
END
#####################################################################
PROCEDURE pageTitle
#####################################################################
BEGIN
	separatorline
	print "Sl No"				column 1 size 05
	print "|"					column 07 
	print "CIF ID"				column 09 size 20
	print "|"							column 30
	print "Accnt Num"				column 31 size 16 
    print "|"							column 55 	
	print "Schm Code"				column 57 size 10
	print "|"							column 68
	separatorline
END 
#####################################################################
PROCEDURE printrecords
#####################################################################
BEGIN
	IF(reportCnt = 1 AND cifID = "" AND acctnum ="" AND schmCode = "")
	begin
	print "-----------NO DATA FOUND-----------" center
	end
	else
	begin
	print reportCnt 					column 1 size 05	
	print "|"							column 07 
	print cifID						    column 09 size 20 
	print "|"							column 30
	print acctnum						column 31 size 16 
	print "|"							column 55 
	print schmCode						column 57 size 10
	print "|"							column 68
	end
END
