####################################################################
RecordLayout
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include psp.mri

localVariables
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
page_tot_printed        stringType
total_pages             numberType
cl_flg                  stringType
string1                 stringType
string2                 stringType
emailId                 stringType
footer_printed          stringType
callscript              stringType
lvfacid			stringType
lvtaxamt		numbertype
inst			stringType
inst1			stringType
inst2			stringType
part			stringType
part1			stringType
part2			stringType
instlen			numbertype
address1                stringType
address2		stringType
address3		stringType
conn			stringType
KU			stringType
KU1			stringType
KU2			stringType
KU3			stringType
KU4			stringType
KU5			stringType
Ku6			stringType
particular2		stringType
space                    stringType
tran_part1                stringType
tran_part2                stringType
dot                       stringType 
tran_part3                stringType
ret stringType
asample stringType
bsample stringType
fileoutput	          stringType
lv_acctNum                stringType
lv_unclearbal             stringType
lv_clearbal               stringType
bcdcFlg                   stringType
####################################################################
#   MANDATORY SECTION (3rd Section)
GROUPANDSORT
####################################################################
despatch_mode, acctNum, srl_num, gl_date_in_YYYY_MM_DD,
pstd_date_YYYY_MM_DD, tran_id,part_tran_srl_num
repository argv4
page_number         numberType
pr_station          stringType
email_post_ind     stringType
 set_id stringType
pageFormat
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
#linesperPage    68
#columnsperline 150
#pageHeaderLines 7
#pageFooterLines 7
#TopMargin       9
#BottomMargin    5

linesperPage    900
columnsperline 5000
pageHeaderLines 0 
pageFooterLines 0
TopMargin       0
BottomMargin    0

