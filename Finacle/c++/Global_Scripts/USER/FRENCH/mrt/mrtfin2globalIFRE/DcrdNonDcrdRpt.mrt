ndecAmtLess1lac   numberType
ndecCntLess5lac   numberType
ndecAmtLess5lac   numberType
ndecCntLess10lac  numberType
ndecAmtLess10lac  numberType
ndecCntLess25lac  numberType
ndecAmtLess25lac  numberType
ndecCntMore25lac  numberType
ndecAmtMore25lac  numberType
ndecAmtCnt		  numberType
ndecAmtSum		  numberType

decAmtCntTot	numberType
decAmtSumTot	numberType
ndecAmtCntTot	numberType
ndecAmtSumTot	numberType
#
GROUPANDSORT
currencyCode
suitStatus 

IGNORERECORD
#if (pastDueFlg = "N")
if (suitStatus != "DCREE" and suitStatus != "NDCRE")
#
PAGEFORMAT
linesperpage 72
columnsperline 100
pageheaderlines 5 
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip readonly  
localYearsToAdd        stringType
#
REPOSITORY argv4
PAGE_NUMBER              numberType
crit_reportTo            stringType
crit_solSetId            stringType
crit_acctNum             stringType
crit_custId              stringType
crit_asOnDate            stringType
crit_fromDate            stringType
crit_toDate              stringType
crit_suitStatus          stringType
crit_courtOrTribunal     stringType
crit_rptCrncyCode        stringType
#
ONSTARTOFREPORT
set localyears = strToNum localYearsToAdd
set pageNumber = 1
set srl_num = 0
nextline
nextline
nextline
print "REPORT ON DETAILS OF CASES DECREED AND NON DECREED " column 20
nextline
nextline
#print "----------------------------------------------------" column 28
nextline
nextline
execute printCriteria
#nextpage
#
PAGEHEADER
  print "Page No."    column 85
  print pageNumber size 5 precision 0
  nextline
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "" column 85
  print " " 
  set localdate = stringToDate  today 
  set localdate = periodAdd localdate localyears Y 
  print localdate DateFormat "HH24:NN:SS"
  nextline
  print "REPORT ON DETAILS OF CASES DECREED AND  NOT DECREED " column 20
  nextline 
  nextline
  print "---------------------------------------------------" column 20
  nextline
#
BEFOREBREAKOF currencyCode
execute initialize
nextpage
#
AFTERBREAKOF currencyCode
if(srl_num != 0)
begin
execute total
execute decreed
end
#
ONEVERYRECORD
execute suitDetail
#
ONENDOFREPORT
execute endrecord
#
#==========================================================================
PROCEDURE suitDetail
#==========================================================================
begin
	set srl_num = srl_num + 1
	
	set asOnDate = subStr asOnDate 1,10
	set suitStatusDate = subStr suitStatusDate 1,10
	set date1 = stringToDate asOnDate
	set date2 = stringToDate suitStatusDate
	set age = periodDiff date1 date2 M
#  	For decreed cases	
	if (suitStatus = "DCREE")
	begin
		if (age >= 0)
		begin
		if ( age <= 12.00 )
		begin
			set decCntLess1yr = decCntLess1yr + 1    
			set decAmtLess1yr = decAmtLess1yr + liability 
			if ( epFiledDate != "" )  
			begin 
				set decEpCntLess1yr = decEpCntLess1yr + 1
				set decEpAmtLess1yr = decEpAmtLess1yr + amtClaimed
			end
		end

		else if ( age <= 36.00 )
		begin
			set decCntLess3yr = decCntLess3yr + 1    
			set decAmtLess3yr = decAmtLess3yr + liability 
			if ( epFiledDate != "" )
			begin
				set decEpCntLess3yr = decEpCntLess3yr + 1
				set decEpAmtLess3yr = decEpAmtLess3yr + amtClaimed
			end
		end

		else if ( age <= 72.00)
		begin
			set decCntLess5yr = decCntLess5yr + 1    
			set decAmtLess5yr = decAmtLess5yr + liability 
			if ( epFiledDate != "" )
			begin
				set decEpCntLess5yr = decEpCntLess5yr + 1
				set decEpAmtLess5yr = decEpAmtLess5yr + amtClaimed
			end
		end

		else if ( age <= 120.00)
		begin
			set decCntLess10yr = decCntLess10yr + 1    
			set decAmtLess10yr = decAmtLess10yr + liability 
			if ( epFiledDate != "" )
			begin
				set decEpCntLess10yr = decEpCntLess10yr + 1
				set decEpAmtLess10yr = decEpAmtLess10yr + amtClaimed
			end
		end

		else 
		begin
			set decCntLess10yr = decCntLess10yr + 1    
			set decAmtLess10yr = decAmtLess10yr + liability 
			if ( epFiledDate != "" )
			begin
				set decEpCntLess10yr = decEpCntLess10yr + 1
				set decEpAmtLess10yr = decEpAmtLess10yr + amtClaimed
			end
		end
		end	
		
		set amount = liability * -1
		if (liability < 0)
		begin
		if ( amount  <= 100000)
		begin
			set decCntLess1lac = decCntLess1lac + 1       
			set decAmtLess1lac = decAmtLess1lac + liability
		end

		else if ( amount <= 500000)
		begin
			set decCntLess5lac = decCntLess5lac + 1       
			set decAmtLess5lac = decAmtLess5lac + liability
		end
     
		else if ( amount <= 1000000)
 		begin
			set decCntLess10lac = decCntLess10lac + 1       
			set decAmtLess10lac = decAmtLess10lac + liability
 		end

 		else if ( amount <= 2500000 ) 
 		begin
			set decCntLess25lac = decCntLess25lac + 1       
			set decAmtLess25lac = decAmtLess25lac + liability
 		end

 		else 
 		begin
			set decCntMore25lac = decCntMore25lac + 1       
			set decAmtMore25lac = decAmtMore25lac + liability
 		end
		end
	end	
#	For non-decreed cases	
	else
	begin
		if (age >= 0)
		begin
		if ( age <= 12.00 )
		begin
			set ndecCntLess1yr = ndecCntLess1yr + 1    
			set ndecAmtLess1yr = ndecAmtLess1yr + liability 
			if ( epFiledDate != "" )  
			begin 
				set ndecEpCntLess1yr = ndecEpCntLess1yr + 1
				set ndecEpAmtLess1yr = ndecEpAmtLess1yr + amtClaimed
			end
		end

		else if ( age <= 36.00 )
		begin
			set ndecCntLess3yr = ndecCntLess3yr + 1    
			set ndecAmtLess3yr = ndecAmtLess3yr + liability 
			if ( epFiledDate != "" )
			begin
				set ndecEpCntLess3yr = ndecEpCntLess3yr + 1
				set ndecEpAmtLess3yr = ndecEpAmtLess3yr + amtClaimed
			end
		end

		else if ( age <= 72.00)
		begin
			set ndecCntLess5yr = ndecCntLess5yr + 1    
			set ndecAmtLess5yr = ndecAmtLess5yr + liability 
			if ( epFiledDate != "" )
			begin
				set ndecEpCntLess5yr = ndecEpCntLess5yr + 1
				set ndecEpAmtLess5yr = ndecEpAmtLess5yr + amtClaimed
			end
		end

		else if ( age <= 120.00)
		begin
			set ndecCntLess10yr = ndecCntLess10yr + 1    
			set ndecAmtLess10yr = ndecAmtLess10yr + liability 
			if ( epFiledDate != "" )
			begin
				set ndecEpCntLess10yr = ndecEpCntLess10yr + 1
				set ndecEpAmtLess10yr = ndecEpAmtLess10yr + amtClaimed
			end
		end

		else 
		begin
			set ndecCntLess10yr = ndecCntLess10yr + 1    
			set ndecAmtLess10yr = ndecAmtLess10yr + liability 
			if ( epFiledDate != "" )
			begin
				set ndecEpCntLess10yr = ndecEpCntLess10yr + 1
				set ndecEpAmtLess10yr = ndecEpAmtLess10yr + amtClaimed
			end
		end
		end
		set amount = liability * -1
		if (liability < 0)
		begin
		if ( amount  <= 100000)
		begin
			set ndecCntLess1lac = ndecCntLess1lac + 1       
			set ndecAmtLess1lac = ndecAmtLess1lac + liability
		end

		else if ( amount <= 500000)
		begin
			set ndecCntLess5lac = ndecCntLess5lac + 1       
			set ndecAmtLess5lac = ndecAmtLess5lac + liability
		end
     
		else if ( amount <= 1000000)
 		begin
			set ndecCntLess10lac = ndecCntLess10lac + 1       
			set ndecAmtLess10lac = ndecAmtLess10lac + liability
 		end

 		else if ( amount <= 2500000 ) 
 		begin
			set ndecCntLess25lac = ndecCntLess25lac + 1       
			set ndecAmtLess25lac = ndecAmtLess25lac + liability
 		end

 		else 
 		begin
			set ndecCntMore25lac = ndecCntMore25lac + 1       
			set ndecAmtMore25lac = ndecAmtMore25lac + liability
 		end
		end
	end
end

#==========================================================================
PROCEDURE printCriteria
#==========================================================================
    nextLine
    nextLine
    separatorLine
    nextline
    nextline
    print   "SELECTION CRITERIA"              column 40
    nextline
    print   "-------------------"             column 40
    nextline
    nextline
    print   "Report To                : "     column 30
    print   crit_reportTo
    nextline
    print   "Set Id                   : "     column 30
    print   crit_solSetId
    nextLine
    print   "Account Num              : "     column 30
    print   crit_acctNum
    nextline
    print   "CIF ID                   : "     column 30
    print   crit_custId
    nextline
    print   "As on date               : "     column 30
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "From Date                : "     column 30
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextLine
    print   "To Date                  : "     column 30
    set localdate = stringToDate  crit_toDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "Suit Status              : "     column 30
    print   crit_suitStatus
    nextline
    print   "Judicial Authority       : "     column 30
    print   crit_courtOrTribunal
    nextline
    print   "Report Currency Code     : "     column 30
    print   crit_rptCrncyCode
    nextline
	nextline
   separatorLine
#============================ End Of File ================================
PROCEDURE endrecord
#==========================================================================
    if(srl_num = 0)
    begin
        nextline
        nextline
        nextline
        nextline
        nextline
        print "  -----  NO RECORDS SELECTED FOR PRINTING  ---- " column 24
        nextline
    end
    nextline
    nextline
	print "*** " column 24
	print pageNumber size 3 column 30 precision 0
	print " PAGE(S) PRINTED. ****END OF REPORT****" size 40 column 34
    nextline
#
    set PAGE_NUMBER = pagenumber
#
#=========================================================================
