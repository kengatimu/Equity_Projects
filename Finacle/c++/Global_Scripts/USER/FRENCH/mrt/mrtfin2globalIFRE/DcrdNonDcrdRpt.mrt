set decAmtSumTot =0
set ndecAmtCntTot=0
set ndecAmtSumTot=0

#=========================================================================
PROCEDURE decreed
#=========================================================================
begin
 nextline
 print "Currency Code : " column 2
 print currencyCode
 nextline 
 nextline
 separatorline
 print " Category "        column  1
 print " Age      "        column  20
 print "No of Accts"       column  35
 print "   Amount   "      column  47
 print " No of Eps filed"  column  67
 print " Amount "          column  88
 separatorline
 nextline
 print "Decreed"          column  1
 print "Upto 1 yr "       column  20
 print  decCntLess1yr     column  40
 print  abs decAmtLess1yr size 20 autocomma precision 2 column 47	 
 if ( decAmtLess1yr < 0) 
 	print "Dr" 
 if ( decAmtLess1yr > 0) 
 	print "Cr" 
 print  decEpCntLess1yr    column  72
 print  decEpAmtLess1yr size 20 autocomma precision 2 column 81 
 nextline
 print "Decreed"          column  1
 print ">1 and <=3 yr"    column  20
 print  decCntLess3yr     column  40
 print  abs decAmtLess3yr size 20 autocomma precision 2  column  47
 if ( decAmtLess3yr < 0) 
 	print "Dr" 
 if ( decAmtLess3yr > 0) 
 	print "Cr" 
 print  decEpCntLess3yr    column  72
 print  decEpAmtLess3yr size 20 autocomma precision 2 column 81 
 nextline
 print "Decreed"          column  1
 print ">3 and <=5 yr"    column  20
 print  decCntLess5yr     column  40
 print  abs decAmtLess5yr  size 20 autocomma precision 2  column  47
 if ( decAmtLess5yr < 0) 
 	print "Dr" 
 if ( decAmtLess5yr > 0) 
 	print "Cr" 
 print  decEpCntLess5yr    column  72
 print  decEpAmtLess5yr size 20 autocomma precision 2 column 81 
 nextline
 print "Decreed"           column  1
 print ">5 and <=10 yr"    column  20
 print  decCntLess10yr     column  40
 print  abs decAmtLess10yr  size 20 autocomma precision 2  column  47
 if ( decAmtLess10yr < 0) 
 	print "Dr" 
 if ( decAmtLess10yr > 0) 
 	print "Cr" 
 print  decEpCntLess10yr    column  72
 print  decEpAmtLess10yr size 20 autocomma precision 2 column 81 
 nextline
 print "Decreed"          column  1
 print ">10 yr"           column  20
 print  decCntMore10yr    column  40
 print  abs decAmtMore10yr  size 20 autocomma precision 2  column  47
 if ( decAmtMore10yr < 0) 
 	print "Dr" 
 if ( decAmtMore10yr > 0) 
 	print "Cr" 
 print  decEpCntMore10yr    column  72
 print  decEpAmtMore10yr size 20 autocomma precision 2 column 81 
 nextline
 nextline
 print "Total "           column 1
 print decCntTot          column 40
 print abs decSumTot size 20 autocomma precision 2  column 47
 if ( decSumTot < 0) 
 	print "Dr" 
 print decEpCntTot        column 72
 print decEpSumTot size 20 autocomma precision 2 column 81 
 nextline
 nextline
 nextline

 print "Non Decreed-Suit"  column  2
 nextline
 print " filed accts"      column  1
 print "Upto 1 yr "        column  20
 print  ndecCntLess1yr     column  40
 print  abs ndecAmtLess1yr size 20 autocomma precision 2 column  47
 if ( ndecAmtLess1yr < 0) 
 	print "Dr" 
 if (ndecAmtLess1yr > 0 ) 
 	print "Cr"
 print  ndecEpCntLess1yr    column  72
 print  ndecEpAmtLess1yr size 20 autocomma precision 2 column 81 
 nextline
 print "Non Decreed-Suit"  column  2
 nextline
 print " filed accts"      column  1
 print ">1 and <=3 yr"     column  20
 print  ndecCntLess3yr     column  40
 print  abs ndecAmtLess3yr size 20 autocomma precision 2 column  47
 if ( ndecAmtLess3yr < 0) 
 	print "Dr" 
 if ( ndecAmtLess3yr > 0) 
 	print "Cr" 
 print  ndecEpCntLess3yr    column  72
 print  ndecEpAmtLess3yr size 20 autocomma precision 2 column 81 
 nextline
 print "Non Decreed-Suit"  column  2
 nextline
 print " filed accts"      	column  1
 print ">3 and <=5 yr"    	column  20
 print  ndecCntLess5yr     	column  40
 print  abs ndecAmtLess5yr size 20 autocomma precision 2 column  47
 if ( ndecAmtLess5yr < 0) 
 	print "Dr" 
 if ( ndecAmtLess5yr > 0) 
 	print "Cr" 
 print  ndecEpCntLess5yr    column  72
 print  ndecEpAmtLess5yr size 20 autocomma precision 2 column 81 
 nextline
 print "Non Decreed-Suit"  column  2
 nextline
 print " filed accts"       column  1
 print ">5 and <=10 yr"     column  20
 print  ndecCntLess10yr     column  40
 print  abs ndecAmtLess10yr size 20 autocomma precision 2  column  47
 if ( ndecAmtLess10yr < 0) 
 	print "Dr" 
 if ( ndecAmtLess10yr > 0) 
 	print "Cr" 
 print  ndecEpCntLess10yr    column  72
 print  ndecEpAmtLess10yr size 20 autocomma precision 2 column 81 
 nextline
 print "Non Decreed-Suit"  column  2
 nextline
 print " filed accts"       column  1
 print ">10 yr"             column  20
 print  ndecCntMore10yr     column  40
 print  abs ndecAmtMore10yr size 20 autocomma precision 2 column  47
 if ( ndecAmtMore10yr < 0) 
 	print "Dr" 
 if ( ndecAmtMore10yr > 0) 
 	print "Cr" 
 print  ndecEpCntMore10yr    column  72
 print  ndecEpAmtMore10yr size 20 autocomma precision 2 column 81 
 nextline
 nextline
 print "Total "           	column 2
 print ndecCntTot           column 40
 print abs ndecSumTot size 20 autocomma precision 2  column 47
 if (ndecSumTot < 0) 
 	print "Dr" 
 if (ndecSumTot > 0) 
 	print "Cr" 
 print ndecEpCntTot        column 72
 print ndecEpSumTot size 20 autocomma precision 2 column 81 

 nextline
 nextline
 nextline
 separatorline
 print " Category "        column  1
 print " Amount Range"     column  25
 print " No of Accounts"   column  50
 print " Amount "          column  75
 separatorline
 nextline
 print " Decreed "        	column 1
 print " <= 1 lac "    		column 25
 print decCntLess1lac      	column 55 
 print abs decAmtLess1lac size 20 autocomma precision 2  column 65
 if (decAmtLess1lac < 0 ) 
 	print "Dr" 
 nextline
 print " Decreed "        		column 1
 print " >1 lac and <=5 lacs"   column 25
 print decCntLess5lac      		column 55 
 print abs decAmtLess5lac size 20 autocomma precision 2  column 65
 if (decAmtLess5lac < 0 ) 
 	print "Dr" 
 nextline
 print " Decreed "        		column 1
 print " >5 lacs and <=10 lacs" column 25
 print decCntLess10lac      	column 55 
 print abs decAmtLess10lac size 20 autocomma precision 2  column 65
 if (decAmtLess10lac < 0 ) 
 	print "Dr" 
 nextline
 print " Decreed "        			column 1
 print " >10 lacs and <=25 lacs"    column 25
 print decCntLess25lac      		column 55 
 print abs decAmtLess25lac size 20 autocomma precision 2  column 65
 if (decAmtLess25lac < 0 ) 
 	print "Dr" 
 nextline
 print " Decreed "        	column 1
 print " >25 lacs"    		column 25
 print decCntMore25lac      column 55 
 print abs decAmtMore25lac size 20 autocomma precision 2  column 65
 if (decAmtMore25lac < 0) 
 	print "Dr" 
 nextline
 nextline
 print " Total "        	column 1
