decEpAgeSum		  numberType

ndecEpCntLess1yr  numberType
ndecEpAmtLess1yr  numberType
ndecEpCntLess3yr  numberType
ndecEpAmtLess3yr  numberType
ndecEpCntLess5yr  numberType
ndecEpAmtLess5yr  numberType
ndecEpCntLess10yr numberType
ndecEpAmtLess10yr numberType
ndecEpCntMore10yr numberType
ndecEpAmtMore10yr numberType
ndecEpAgeCnt      numberType
ndecEpAgeSum      numberType

decCntTot		numberType
decSumTot		numberType
ndecCntTot		numberType
ndecSumTot		numberType

decEpCntTot		numberType
decEpSumTot		numberType
ndecEpCntTot	numberType
ndecEpSumTot	numberType

decCntLess1lac  numberType
decAmtLess1lac  numberType
decCntLess5lac  numberType
decAmtLess5lac  numberType
decCntLess10lac numberType
decAmtLess10lac numberType
