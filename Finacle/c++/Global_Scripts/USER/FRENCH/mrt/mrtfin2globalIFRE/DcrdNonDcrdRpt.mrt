#==========================================================================
PROCEDURE total 
#==========================================================================
begin
	set decCntTot=decCntLess1yr + decCntLess3yr + decCntLess5yr + decCntLess10yr + decCntMore10yr	
	set decSumTot= decAmtLess1yr + decAmtLess3yr + decAmtLess5yr + decAmtLess10yr + decAmtMore10yr
	set decEpCntTot=decEpCntLess1yr + decEpCntLess3yr + decEpCntLess5yr + decEpCntLess10yr + decEpCntMore10yr	
	set decEpSumTot= decEpAmtLess1yr + decEpAmtLess3yr + decEpAmtLess5yr + decEpAmtLess10yr + decEpAmtMore10yr
	set ndecSumTot= ndecAmtLess1yr + ndecAmtLess3yr + ndecAmtLess5yr + ndecAmtLess10yr + ndecAmtMore10yr
	set ndecCntTot=ndecCntLess1yr + ndecCntLess3yr + ndecCntLess5yr + ndecCntLess10yr + ndecCntMore10yr	
	set ndecEpCntTot=ndecEpCntLess1yr + ndecEpCntLess3yr + ndecEpCntLess5yr + ndecEpCntLess10yr + ndecEpCntMore10yr	
	set ndecEpSumTot= ndecEpAmtLess1yr + ndecEpAmtLess3yr + ndecEpAmtLess5yr + ndecEpAmtLess10yr + ndecEpAmtMore10yr
	
	set decAmtCntTot = decCntLess1lac + decCntLess5lac + decCntLess10lac + decCntLess25lac + decCntMore25lac
	set decAmtSumTot = decAmtLess1lac + decAmtLess5lac	+ decAmtLess10lac + decAmtLess25lac + decAmtMore25lac
	set ndecAmtCntTot = ndecCntLess1lac + ndecCntLess5lac + ndecCntLess10lac + ndecCntLess25lac + ndecCntMore25lac
	set ndecAmtSumTot = ndecAmtLess1lac + ndecAmtLess5lac + ndecAmtLess10lac + ndecAmtLess25lac + ndecAmtMore25lac
	
end


