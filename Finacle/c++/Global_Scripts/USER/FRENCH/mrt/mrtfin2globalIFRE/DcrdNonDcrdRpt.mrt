#	Modification log
#   ----------------
#   Srl.No.     Date        Author            Version
#   ------   ----------     ------------    --------------
#       1     08/02/05     Jaya Lakshmi         1.0
#
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
#
$$$include DcrdNonDcrdRpt.mri 

LOCALVARIABLES
srl_num 		numberType
date1			numberType
date2			numberType
age				numberType
amount			numberType
localdate       numberType
localyears      numberType

decCntLess1yr   numberType
decAmtLess1yr   numberType
decCntLess3yr   numberType
decAmtLess3yr   numberType
decCntLess5yr   numberType
decAmtLess5yr   numberType
decCntLess10yr  numberType
decAmtLess10yr  numberType
decCntMore10yr  numberType
decAmtMore10yr  numberType
decAgeCnt		numberType
decAgeSum		numberType

ndecCntLess1yr  numberType
ndecAmtLess1yr  numberType
ndecCntLess3yr  numberType
ndecAmtLess3yr  numberType
ndecCntLess5yr  numberType
ndecAmtLess5yr  numberType
ndecCntLess10yr numberType
ndecAmtLess10yr numberType
ndecCntMore10yr numberType
ndecAmtMore10yr numberType
ndecAgeCnt		numberType
ndecAgeSum		numberType

decEpCntLess1yr   numberType
decEpAmtLess1yr   numberType
decEpCntLess3yr   numberType
decEpAmtLess3yr   numberType
decEpCntLess5yr   numberType
decEpAmtLess5yr   numberType
decEpCntLess10yr  numberType
decEpAmtLess10yr  numberType
decEpCntMore10yr  numberType
decEpAmtMore10yr  numberType
