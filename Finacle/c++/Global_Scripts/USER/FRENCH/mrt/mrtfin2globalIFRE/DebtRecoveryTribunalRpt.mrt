#############################################################################
#  FILE   :  DebtRecoveryTribunal.mrt 
#  DATE   :  29-01-2005
#  AUTHOR :  Jaya Lakshmi          
#  DESC   :  This is the Mahareport specs for generating report for cases
#            before dedt recovery tribunal
#############################################################################
#
RECORDLAYOUT
$$$include DebtRecoveryTribunalRpt.mri
#
LOCALVARIABLES
srlNum 						numberType
LocDate						numberType
from_count					numberType
from_amount					numberType
to_count					numberType
to_amount					numberType
decree_count				numberType
decree_amount				numberType
opn_count					numberType
opn_amount					numberType
comp_rec_count				numberType
comp_rec_amount				numberType
other_rec_count				numberType
other_rec_amount			numberType
total_opn_count				numberType
total_opn_amount			numberType
total_end_count				numberType
total_end_amount			numberType
total_rec_count				numberType
total_rec_amount			numberType
localdate 			        numberType
localyears     			    numberType
#
GROUPANDSORT
CrncyCode					ascending
#
#IGNORERECORD 
#if (pastDueFlg = "N" )
#
PAGEFORMAT
linesperPage    65
columnsperline  100 
topMargin        0
bottomMargin     0
leftMargin       0
pageHeaderLines	 6
pageFooterLines  2
#
REPOSITORY bankRepos.rip readonly  
localYearsToAdd        stringType
#
REPOSITORY  argv4
errorMsg                 stringType
errorMsg1                stringType
PAGE_NUMBER              numberType
crit_reportTo            stringType
crit_solSetId            stringType
crit_acctNum             stringType
crit_custId              stringType
crit_asOnDate            stringType
crit_fromDate            stringType
crit_toDate              stringType
crit_suitStatus          stringType
crit_courtOrTribunal     stringType
crit_rptCrncyCode        stringType
#

ONSTARTOFREPORT
set localyears = strToNum localYearsToAdd
set srlNum = 0
set PAGE_NUMBER = 1
nextline
if (errorMsg != "")
begin
	print " Error: "
	print errorMsg
end	
nextline
nextline
if (errorMsg1 != "")
begin
	print " Error: "
	print errorMsg1 
end
nextline
nextline
print "    REPORT ON CASES BEFORE DEBT RECOVERY TRIBUNAL - POSITION AS ON "  size 68 center
if crit_asOnDate != ""
begin
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
end
nextline
nextline
execute printCriteria
nextline
nextline

#
PAGEHEADER
print "Page No."    column 82
print pageNumber size 5 precision 0
nextline

set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 82
print " " 
set localdate = stringToDate  today 
set localdate = periodAdd localdate localyears Y 
print localdate DateFormat "HH24:NN:SS"
nextline
nextline
print "    REPORT ON CASES BEFORE DEBT RECOVERY TRIBUNAL - POSITION AS ON "  size 68 center
if crit_asOnDate != ""
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
nextline
separatorline
#
BEFOREBREAKOF CrncyCode
set from_count			= 0
set from_amount			= 0
set to_count			= 0
set to_amount			= 0
set decree_count		= 0
set decree_amount		= 0
set opn_count 			= 0
set opn_amount			= 0
set comp_rec_count		= 0
set comp_rec_amount 	= 0
set other_rec_count 	= 0
set other_rec_amount	= 0
set total_opn_count		= 0
set total_opn_amount	= 0
set total_end_count		= 0
set total_end_amount	= 0
set total_rec_count		= 0
set total_rec_amount	= 0
nextpage
#
AFTERBREAKOF CrncyCode
if (srlNum != 0)
begin
set total_opn_count = opn_count + from_count
set total_opn_amount = opn_amount + from_amount
set total_end_count = opn_count + from_count + to_count + decree_count 
set total_end_amount = total_opn_amount - (to_amount + decree_amount)
set total_rec_count = comp_rec_count + other_rec_count 
set total_rec_amount = comp_rec_amount + other_rec_amount
execute PrintHeader
print " Opening Balance as on " 
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
print opn_count column 52
print abs opn_amount size 20 autocomma column 61 rightjustify precision 2
if (opn_amount < 0)
	print "Dr"
if (opn_amount > 0)
	print "Cr"
nextline
nextline
print " Cases transferred from civil court/high court"
print from_count column 52
print abs from_amount size 20 autocomma column 61 rightjustify precision 2
if (from_amount < 0)
	print "Dr"
if (from_amount > 0)
	print "Cr"
nextline
print " between opening balance date and closing"
nextline
print " balance date"
nextline
nextline
print " Sub total - No of cases as on closing balance"
print total_opn_count column 52
print abs total_opn_amount size 20 autocomma column 61 rightjustify precision 2
if (total_opn_amount < 0)
	print "Dr"
if (total_opn_amount > 0)
	print "Cr"
nextline
print "		date with  DRT" 
nextline
nextline
print " Cases transferred to civil court/high court"
print to_count column 52
print abs to_amount size 20 autocomma column 61 rightjustify precision 2
if (to_amount < 0)
	print "Dr"
if (to_amount > 0)
	print "Cr"
nextline
print " between opening balance date and closing"
nextline
print " balance date"
nextline
nextline
print " Decreed cases"
print decree_count column 52
print abs decree_amount size 20 autocomma column 61 rightjustify precision 2
if (decree_amount < 0)
	print "Dr"
if (decree_amount > 0)
	print "Cr"
nextline
nextline
print " Closing Balance  "
#print total_end_count column 52
print abs total_end_amount size 20 autocomma column 61 rightjustify precision 2
if (total_end_amount < 0)
	print "Dr"
if (total_end_amount > 0)
	print "Cr"
nextline
nextline
print "Recovery Details. "
nextline
nextline
print " Recovery through compromise"
print comp_rec_count column 52
print comp_rec_amount size 20 autocomma column 61 rightjustify precision 2
if (comp_rec_amount > 0)
	print "Cr"
nextline
nextline
print " Other recoveries"
print other_rec_count column 52
print other_rec_amount size 20 autocomma column 61 rightjustify precision 2
if (other_rec_amount > 0)
	print "Cr"
nextline
nextline
print " Total Recovery in the "
print "  DRT cases "
print total_rec_count column 52
print total_rec_amount size 20 autocomma column 61 rightjustify precision 2
if (total_rec_amount > 0)
	print "Cr"
separatorline
end
#
ONEVERYRECORD
set srlNum = srlNum + 1
if ((stringtoDate transferdate < stringtoDate crit_fromDate) and (courtcode = crit_courtOrTribunal))
begin
	set opn_count = opn_count + 1
	set opn_amount = opn_amount + openBalance
end

if ((courtcode = crit_courtOrTribunal) and (stringToDate transferdate >= stringToDate crit_fromDate and stringToDate transferdate <= stringToDate crit_toDate))
begin
	set from_count = from_count + 1
	set from_amount = from_amount + amtLiable  
end
if ((courtcode != crit_courtOrTribunal) and (stringToDate transferdate >= stringToDate crit_fromDate and stringToDate transferdate <= stringToDate crit_toDate))
begin
	set to_count =  to_count + 1 
	set to_amount = to_amount + amtLiable  
end

# Here we are using suit status code for Decreed cases as DCREE

if ((suitcode = "DCREE") and (stringToDate transferdate >= stringToDate crit_fromDate and stringToDate transferdate <= stringToDate crit_toDate))
begin
	set decree_count = decree_count + 1 
	set decree_amount = decree_amount + amtLiable  
end

# Here we are using code of settlement mode for Recovery through compromises as COMPR

if (modofsettlement = "COMPR" and courtcode = crit_courtOrTribunal)
begin
	set comp_rec_count = comp_rec_count + 1
	set comp_rec_amount = comp_rec_amount + amtCredited
end
else if( amtCredited != 0 and courtcode = crit_courtOrTribunal)
begin
	set other_rec_count = other_rec_count + 1
	set other_rec_amount = other_rec_amount + amtCredited
end
#
ONENDOFREPORT
    if(srlNum = 0)
    begin
        nextline
        nextline
        print "  -----  NO RECORDS SELECTED FOR PRINTING  ---- " column 24
        nextline
    end
    nextline
    nextline
    nextline
	print "*** " column 24
	print pageNumber size 3 column 30 precision 0
	print " PAGE(S) PRINTED. ****END OF REPORT****" size 40 column 34
    nextline
    set PAGE_NUMBER = pagenumber
#
#=========================================================================
PROCEDURE PrintHeader
#=========================================================================
print "Currency Code : " column 1
print CrncyCode					
nextline
print "                                                   No of A/cs             Amount"
nextline
nextline
#
#==========================================================================
PROCEDURE printCriteria
#==========================================================================
    nextLine
    nextLine
    separatorLine
    nextline
    nextline
    print   "SELECTION CRITERIA"              column 40
    nextline
    print   "-------------------"             column 40
    nextline
    nextline
    print   "Report To                : "     column 30
    print   crit_reportTo
    nextline
    print   "Sol Set Id               : "     column 30
    print   crit_solSetId
    nextLine
    print   "Account Num              : "     column 30
    print   crit_acctNum
    nextline
    print   "CIF ID                   : "     column 30
    print   crit_custId
    nextline
    print   "As on date               : "     column 30
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "From Date                : "     column 30
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextLine
    print   "To Date                  : "     column 30
    set localdate = stringToDate  crit_toDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "Suit Status              : "     column 30
    print   crit_suitStatus
    nextline
    print   "Judicial Authority       : "     column 30
    print   crit_courtOrTribunal
    nextline
    print   "Report Currency Code     : "     column 30
    print   crit_rptCrncyCode
    nextline
    nextline
    separatorLine
#============================ End Of File ===============================
