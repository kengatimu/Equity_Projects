#-------------------------------------------------------------------------------------

<--START
CHECKSUM="2d6bfd2cd5a9312b05e85c69965905f220ba1d679a7b296e233ef2865a90d648"
	TRACE ON
	
	sv_r=urhk_B2k_PrintRepos("BANCS")
	print(sv_r)
	
	#-------------------------------------------------------------------------------------
	# CREATION OF REPOSITORIES
	#-------------------------------------------------------------------------------------
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST","DENOM",5)
	#}
	ENDIF
	#-------------------------------------------------------------------------------------
	# INITIALIZE THE VARIABLES
	#-------------------------------------------------------------------------------------
	
	#-----------GETTING THE VALUES OF THE FIELD FROM THE FRONT END : START --------------
	
	CUST.DENOM.flag1 = "IVL"
	CUST.DENOM.bank_id = BANCS.STDIN.contextBankId
	print(CUST.DENOM.bank_id)
	#-----------GETTING THE VALUES OF THE FIELD FROM THE FRONT END :END------------------
	
	#-------------------------------------------------------------------------------------
	# VALIDATE IF THE ENTERED CURRENCY IS VALID OR NOT
	#-------------------------------------------------------------------------------------
	
	#-----------QUERY IN CNC TABLE IF THE ENTERED CURRENCY EXISTS OR NOT : START --------
	
	CUST.DENOM.CrncyCode = toupper(BANCS.INPUT.CrncyCode)
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.CrncyCode +"|"+ CUST.DENOM.bank_id
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_a = "count | SELECT count(*) "
	sv_a = sv_a + "FROM cnc "
	sv_a = sv_a + "WHERE entity_cre_flg = 'Y' "
	sv_a = sv_a + "AND del_flg!='Y' "
	sv_a = sv_a + "AND crncy_code = ?SVAR "
	sv_a = sv_a + "AND bank_id= ?SVAR "
	print(sv_a)
	
	sv_q = urhk_dbSelectWithBind(sv_a)
	print(sv_q)
	
	IF(sv_q == 0) THEN
	#{
		CUST.DENOM.count = BANCS.OUTPARAM.count
		print(CUST.DENOM.count)
		IF(CUST.DENOM.count == 0) THEN
		#{
			CUST.DENOM.flag1 = "IVL"
			#}
		ELSE
			#{
			CUST.DENOM.ErrMsg = "This is valid Currency Code "
			sv_u = urhk_setOrbOut("Success|"+CUST.DENOM.ErrMsg)
			print(sv_u)
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------QUERY IN CNC TABLE IF THE ENTERED CURRENCY EXISTS OR NOT : END --------
	
	IF(CUST.DENOM.flag1 == "IVL") THEN
	#{
		CUST.DENOM.CrncyCode = toupper(BANCS.INPUT.CrncyCode)
		#-------------------- TO CHECK IF THE SELECTED CURRENCY CODE IS VERIFIED : START------------
		
		BANCS.INPARAM.BINDVARS= CUST.DENOM.CrncyCode +"|"+ CUST.DENOM.bank_id
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_a = "count3 | SELECT count(*) "
		sv_a = sv_a + "FROM cnc "
		sv_a = sv_a + " WHERE crncy_code = ?SVAR "
		sv_a = sv_a + "AND bank_id= ?SVAR "
		print(sv_a)
		sv_q = urhk_dbSelectWithBind(sv_a)
		print(sv_q)
		IF(sv_q == 0) THEN
		#{
			CUST.DENOM.count3 = BANCS.OUTPARAM.count3
			print(CUST.DENOM.count3)
			IF(CUST.DENOM.count3 != 0) THEN
			#{
				BANCS.INPARAM.BINDVARS = CUST.DENOM.CrncyCode +"|"+	CUST.DENOM.bank_id
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_a = "count1 | SELECT count(*) "
				sv_a = sv_a + "FROM cnc "
				sv_a = sv_a + " WHERE del_flg!='Y' "
				sv_a = sv_a + " AND crncy_code = ?SVAR "
				sv_a = sv_a + "AND bank_id= ?SVAR "
				print(sv_a)
				sv_q = urhk_dbSelectWithBind(sv_a)
				print(sv_q)
				IF(sv_q == 0) THEN
				#{
					CUST.DENOM.count1 = BANCS.OUTPARAM.count1
					print(CUST.DENOM.count1)
					IF(CUST.DENOM.count1 != 0) THEN
					#{
						CUST.DENOM.flag1 = "VER"
					#}
					ENDIF
				#}
				ENDIF
				
				BANCS.INPARAM.BINDVARS = CUST.DENOM.CrncyCode +"|"+ CUST.DENOM.bank_id
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_a = "count2 | SELECT count(*) "
				sv_a = sv_a + "FROM cnc "
				sv_a = sv_a + " WHERE entity_cre_flg = 'Y' "
				sv_a = sv_a + " AND crncy_code = ?SVAR "
				sv_a = sv_a + "AND bank_id= ?SVAR "
				print(sv_a)
				sv_q = urhk_dbSelectWithBind(sv_a)
				print(sv_q)
				IF(sv_q == 0) THEN
				#{
					CUST.DENOM.count2 = BANCS.OUTPARAM.count2
					print(CUST.DENOM.count2)
					IF(CUST.DENOM.count2 != 0) THEN
					#{
						CUST.DENOM.flag1 = "DEL"
					#}
					ENDIF
				#}
				ENDIF
				
				#-------------------- TO CHECK IF THE SELECTED CURRENCY CODE IS DELETED : END------------
				
			#}
			ELSE
				#{
				CUST.DENOM.flag = "IVL"
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------SEND THE OUTPUT TO THE FRONT END : START----------------------------------------
	
	print(CUST.DENOM.flag1)
	IF (CUST.DENOM.flag1 == "IVL")THEN
	#{
		CUST.DENOM.ErrMsg = "Enter a Valid Currency Code"
		sv_u = urhk_setOrbOut("Error|"+CUST.DENOM.ErrMsg)
		print(sv_u)
		GOTO FINISH
	#}
	ENDIF
	IF(CUST.DENOM.flag1 == "VER")THEN
	#{
		CUST.DENOM.ErrMsg = "This Currency Code is not verified..Please Re-Enter"
		sv_u = urhk_setOrbOut("Error|"+CUST.DENOM.ErrMsg)
		print(sv_u)
		GOTO FINISH
	#}
	ENDIF
	IF(CUST.DENOM.flag1 == "DEL")THEN
	#{
		CUST.DENOM.ErrMsg = "This Currency Code is deleted..Please Re-Enter"
		sv_u = urhk_setOrbOut("Error|"+CUST.DENOM.ErrMsg)
		print(sv_u)
		GOTO FINISH
	#}
	ENDIF
	
	#-----------SEND THE OUTPUT TO THE FRONT END : END -----------------------------------------
	FINISH:
		TRACE OFF
		exitscript
END-->
