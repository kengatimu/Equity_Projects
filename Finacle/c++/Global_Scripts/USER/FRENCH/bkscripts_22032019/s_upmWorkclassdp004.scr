<--START
CHECKSUM="5384083b26957318fd74cdef36aca8dfd560c85269978885de960bfeba959881"
	TRACE ON
	
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	
	IF (CLASSEXISTS("CUST", "UPMWC") == 0) THEN
	#{
		CREATECLASS("CUST", "UPMWC", 5)
	#}
	ENDIF
	
	CUST.UPMWC.empId = ""
	CUST.UPMWC.errMsg = ""
	
	
	BANCS.INPUT.moduleName = "UPMWORKCLASS"
	BANCS.INPUT.parameterId = "UPMEMPID"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.upmEmpID = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for empID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#-----------------------------------------------------------------------------------------
	# Check whether Empl_ID is a duplicate
	#-----------------------------------------------------------------------------------------
	
	sv_u = urhk_SRV_GetVal("usrGenDtl.emp.empId")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.UPMWC.empId = BANCS.OUTPARAM.srvValue
		PRINT(CUST.UPMWC.empId)
		sv_s = "count|SELECT COUNT(user_emp_id) "
		sv_s = sv_s +"FROM TBAADM.UPR "
		sv_s = sv_s + "WHERE user_emp_id = ?SVAR "
		sv_s = sv_s + "AND home_bank_id = ?SVAR"
		BANCS.INPARAM.BINDVARS =  CUST.UPMWC.empId + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.UPMWC.count = BANCS.OUTPARAM.count
			PRINT(CUST.UPMWC.count)
			#}
		ELSE
			#{
			CUST.UPMWC.count = 0
		#}
		ENDIF
		
		IF ((CINT(CUST.UPMWC.count) > 0) AND (CUST.UPMWC.empId != CUST.UPMWC.upmEmpID)) THEN
		#{
			CUST.UPMWC.errMsg = "Duplicate Employee ID. Please re-enter"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT :
		IF (CUST.UPMWC.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.UPMWC.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
