	IF(CUST.CIETXN.cashTxnFlg == "Y")THEN
	#{
		GOTO CASH_TXN
		#}
	ELSE
		#{
		GOTO XFER_TXN
	#}
	ENDIF
	
	CASH_TXN:
		
		sv_i = 0
		
		IF(CUST.CIETXN.crAcctNum == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Credit Account Id is blank^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.crAcctNumEntityId == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Invalid Credit Account ID^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.crAcctNumEntityId != BANCS.STDIN.contextBankId)THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Credit Account Number should be of Same Entity^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.chargeEventId == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Charge Event Id is not set in CPARAM^drAcctNum"
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(sv_i > 1)THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		GOTO TXN_LIMIT
		
	XFER_TXN:
		
		sv_i = 0
		
		IF(CUST.CIETXN.drAcctNum == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Debit Account Id is blank^drAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.drAcctNumEntityId == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Invalid Debit Account ID^drAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.crAcctNum == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Credit Account Id is blank^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.crAcctNumEntityId == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Invalid Credit Account ID^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.drAcctNumEntityId != CUST.CIETXN.debitEntity)THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Account Entity ID AND Entered Entity ID mismatch for Debit Account^drAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.crAcctNumEntityId != CUST.CIETXN.creditEntity)THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Account Entity ID AND Entered Entity ID mismatch for Credit Account^crAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.chargeEventId == "")THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Charge Event Id is not set in CPARAM^drAcctNum"
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF((CUST.CIETXN.crAcctNumEntityId == CUST.CIETXN.drAcctNumEntityId) AND (CUST.CIETXN.crAcctNumEntityId != BANCS.STDIN.contextBankId))THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Only Same Entity Accounts are allowed^drAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.crAcctNumEntityId != BANCS.STDIN.contextBankId)THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Credit Account ID should be of Same Entity^drAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(CUST.CIETXN.drAcctNumEntityId != BANCS.STDIN.contextBankId)THEN
		#{
			IF(sv_i == 0)THEN
			#{
				sv_i = 1
			#}
			ENDIF
			sv_n = Format$(sv_i,"%d")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_" + sv_n + "|Error^Debit Account ID should be of Same Entity^drAcctNum"
			sv_u = urhk_SetOrbOut(sv_s)
			sv_i = sv_i + 1
		#}
		ENDIF
		
		IF(sv_i > 1)THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		GOTO TXN_LIMIT
		
		######################################################################################
		# Transaction Amount Limit Check
		######################################################################################
		
	TXN_LIMIT:
		
		CUST.CIETXN.scriptSuccess = "Y"
		
		#CALL("cietxndp008.scr")
		
		CALL("cietxndp073.scr")
		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		######################################################################################
		# Create Transaction in the Current Entity
		######################################################################################
		
		IF(CUST.CIETXN.cashTxnFlg == "Y")THEN
		#{
			CALL("cietxndp037.scr")
			#}
		ELSE
			#{
			CALL("cietxndp038.scr")
		#}
		ENDIF
		
		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.entity1 = BANCS.STDIN.contextBankId
		CUST.CIETXN.entity1TranDate = MID$(CUST.CIETXN.entity1TranDate,0,10)
		
		######################################################################################
		# Insert data into the IEPAGL Custom Table
		######################################################################################
		
	DATA_INSERT:
		
		#-------------------------------------------------------------------------------------
		# Obtain the IE_TXN_REF_NO
		#-------------------------------------------------------------------------------------
		
		CUST.CIETXN.seqNextVal = ""
		CUST.CIETXN.ieTxnRefNo = ""
		
		sv_s = "seqNextVal|SELECT LPAD(CUSTOM.IE_TXN_REF_NO_SEQ.NEXTVAL,'6','0') FROM DUAL"
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.seqNextVal = BANCS.OUTPARAM.seqNextVal
			PRINT(CUST.CIETXN.seqNextVal)
			CUST.CIETXN.ieTxnRefNo = CUST.CIETXN.entity1 + "00" + CUST.CIETXN.seqNextVal
			PRINT(CUST.CIETXN.ieTxnRefNo)
			#}
		ELSE
			#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Could not get Inter Entity Transaction Reference Number^prodCode")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.scriptSuccess = "Y"
		
		CALL("cietxndp039.scr")
		
		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		######################################################################################
		# Calling script for DENOM insertion
		######################################################################################
		IF(FIELDEXISTS(CUST.CIETXN.returnValue) AND FIELDEXISTS(CUST.CIETXN.entity1TranId))THEN
		#{
			IF((CUST.CIETXN.returnValue!="")AND (CUST.CIETXN.entity1TranId!=""))THEN
			#{
				CUST.CIETXN.scriptSuccess = "Y"
				CALL("denom_insert.scr")
				IF(CUST.CIETXN.scriptSuccess == "N")THEN
				#{
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		
		######################################################################################
		# Calling Script for MOBEE_PUSH_SMS Insertion
		######################################################################################
		
		CUST.CIETXN.scriptSuccess = "Y"
		
		CALL("cietxndp057.scr")
		
		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.randomRefNo = "********"
		
		######################################################################################
		
		IF (CUST.CIETXN.fxChargeResult!="") THEN
		#{
			sv_s = "RESULT_MSG|Payment To A/c. GL Transaction Done Successfully. Transaction Reference No: " + CUST.CIETXN.ieTxnRefNo + CUST.CIETXN.fxChargeResult
			#}
		ELSE
			#{
			sv_s = "RESULT_MSG|Payment To A/c. GL Transaction Done Successfully. Transaction Reference No: " + CUST.CIETXN.ieTxnRefNo
			
		#}
		ENDIF
		
		#sv_s = "RESULT_MSG|Payment To A/c. GL Transaction Done Successfully. Transaction Reference No: " + CUST.CIETXN.ieTxnRefNo
		sv_s = sv_s + "!" + CUST.CIETXN.ieTxnRefNo + "!" + CUST.CIETXN.entity1 + "!" + CUST.CIETXN.entity1TranId + "!" + CUST.CIETXN.entity1TranDate + "!!!!" + CUST.CIETXN.chargeTranId + "!" + CUST.CIETXN.chargeTranDate + "!" + CUST.CIETXN.randomRefNo
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_u)
		
		
	ENDOFSCRIPT:
END-->
