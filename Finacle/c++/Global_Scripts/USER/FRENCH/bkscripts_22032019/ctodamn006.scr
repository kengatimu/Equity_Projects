#----------------------------------------------------------------------------------------------------------
# Filename              :       ctodamn006.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script for calling script to do the functionality as Function code.
# Input                 :       func Code,Account Id,Availment request Id and all Details page field values
# Output                :       RESULT MSG or error message.
# Called Script         :       ctodadp005.scr, ctodadp006.scr, ctodadp007.scr, ctodadp008.scr
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           01-04-2013         Nitin Prabhakar   original Version          1.0
#  2           25-07-2013         Bharath		Modified for expiry date field
#  3           26-07-2013         Bharath			Modified for total amount availed field
#-----------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="bfc26a4ec2fb6f1d37299ab29cc5717cfc7de94b5e245c6037a155df9f5a21b9"
	TRACE ON
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CTODA") == 0) THEN
	#{
		CREATECLASS("CUST", "CTODA", 5)
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "INTERFACE") == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#  Declaration of variables used in script
	#------------------------------------------------------------------------------
	CUST.CTODA.userId = TRIM(BANCS.STDIN.userId)
	print(CUST.CTODA.userId)
	CUST.CTODA.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.CTODA.bankId)
	
	CUST.CTODA.resultPageMsg = ""
	CUST.CTODA.successFlg = "S"
	
	# Taking FE fields values in Repository variable.
	CUST.CTODA.funcCode = TRIM(BANCS.INPUT.funcCode)
	print(CUST.CTODA.funcCode)
	CUST.CTODA.accNum = TRIM(BANCS.INPUT.accNum)
	print(CUST.CTODA.accNum)
	CUST.CTODA.availReqId = TRIM(BANCS.INPUT.availReqId)
	print(CUST.CTODA.availReqId)
	CUST.CTODA.contractId = TRIM(BANCS.INPUT.contractId)
	print(CUST.CTODA.contractId)
	CUST.CTODA.accName = TRIM(BANCS.INPUT.accName)
	print(CUST.CTODA.accName)
	CUST.CTODA.accCCY = TRIM(BANCS.INPUT.accCCY)
	print(CUST.CTODA.accCCY)
	CUST.CTODA.maxAvailAmt = TRIM(BANCS.INPUT.maxAvailAmt)
	print(CUST.CTODA.maxAvailAmt)
	CUST.CTODA.contractPeriodMM = TRIM(BANCS.INPUT.contractPeriodMM)
	print(CUST.CTODA.contractPeriodMM)
	CUST.CTODA.availAmt = TRIM(BANCS.INPUT.availAmt)
	print(CUST.CTODA.availAmt)
	CUST.CTODA.availPeriodMM = TRIM(BANCS.INPUT.availPeriodMM)
	print(CUST.CTODA.availPeriodMM)
	CUST.CTODA.chrgAmt = TRIM(BANCS.INPUT.chrgAmt)
	print(CUST.CTODA.chrgAmt)
	CUST.CTODA.netTodAmount = TRIM(BANCS.INPUT.netTodAmount)
	print(CUST.CTODA.netTodAmount)
	CUST.CTODA.remarks = TRIM(BANCS.INPUT.remarks)
	print(CUST.CTODA.remarks)
	CUST.CTODA.expDate = TRIM(BANCS.INPUT.expDate)
	print(CUST.CTODA.expDate)
	CUST.CTODA.expiryDate = CUST.CTODA.expDate
	print(CUST.CTODA.expiryDate)
	CUST.CTODA.totAvailedAmt = TRIM(BANCS.INPUT.totAvailedAmt)
	print(CUST.CTODA.totAvailedAmt)
	
	#----------------------------------------------------------------------------------
	# calling Inserting/updating the value in the tables as per function code.
	#----------------------------------------------------------------------------------
	IF (CUST.CTODA.funcCode=="A") THEN
	#{
		call("ctodadp005.scr")
	#}
	ENDIF
	IF (CUST.CTODA.funcCode=="M") THEN
	#{
		call("ctodadp006.scr")
	#}
	ENDIF
	IF (CUST.CTODA.funcCode=="V") THEN
	#{
		call("ctodadp007.scr")
	#}
	ENDIF
	IF (CUST.CTODA.funcCode=="X") THEN
	#{
		call("ctodadp008.scr")
	#}
	ENDIF
	IF (CUST.CTODA.successFlg == "F") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#CUST.CTODA.resultPageMsg = "Sample success result message"
	BANCS.OUTPUT.SuccessOrFailure = "S"
	sv_w = ""
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	sv_u = urhk_SetOrbOut("RESULT_MSG|<font color=black>" + CUST.CTODA.resultPageMsg)
	ENDOFSCRIPT:
		IF (CUST.CTODA.successFlg == "F") THEN
		#{
			sv_w = "SUCCESSORFAILURE|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_z = "Error_0|ERROR^" + CUST.CTODA.errorMsg + "^" + CUST.CTODA.fieldName
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.CTODA.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","CTODA") != 0) THEN
		#{
			DELETECLASS ("CUST","CTODA")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
