	PRINT(sv_a)
	
	sv_s = "lv_CustomerName|"
	sv_s = sv_s + "SELECT CUST_NAME "
	sv_s = sv_s + "FROM  tbaadm.cmg "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  cif_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + sv_a
	sv_u = urhk_dbselectWithBind(sv_s)
	PRINT(sv_u)
	
	IF ( sv_u == "0" ) THEN
	#{
		BANCS.OUTPUT.lv_CustomerName = TRIM(BANCS.OUTPARAM.lv_CustomerName)
		PRINT (BANCS.OUTPUT.lv_CustomerName)
		#}
