<--START
CHECKSUM="5942fe4cb8d18cfdd8ddfa96f0d87cb74aaf8c465db1dac03d40ad50c239d9c3"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DORM") == 0) THEN
	#{
		CREATECLASS("CUST","DORM",5)
	#}
	ENDIF
	
	
	CUST.DORM.crncy = " "
	
	print(BANCS.INPUT.roleIdval)
	
	sv_s = "count|SELECT COUNT(1) "
	sv_s = sv_s + "FROM CUSTOM.CRCL "
	sv_s = sv_s + "WHERE bank_id  = ?SVAR  "
	sv_s = sv_s + "AND role_id  = ?SVAR "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.roleIdval
	
	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	print(BANCS.OUTPARAM.count)
	
	IF( sv_u == 0 ) THEN
	#{
		IF(CINT(BANCS.OUTPARAM.count) >1) THEN
		#{
			#sv_c = "Err|More than one currency available for Role ID . Please use searcher."
			#sv_y = urhk_SetOrbOut(sv_c)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	sv_s = "crncy|SELECT crncy_code "
	sv_s = sv_s + "FROM CUSTOM.CRCL "
	sv_s = sv_s + "WHERE bank_id  = ?SVAR  "
	sv_s = sv_s + "AND role_id  = ?SVAR "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.roleIdval
	
	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	
	IF( sv_u == 0 ) THEN
	#{
		PRINT(BANCS.OUTPARAM.crncy)
		CUST.DORM.crncy = BANCS.OUTPARAM.crncy
		sv_c = "crncy|"+CUST.DORM.crncy
		sv_y = urhk_SetOrbOut(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		TRACE OFF
		EXITSCRIPT
END-->
