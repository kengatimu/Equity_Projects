				BANCS.INPARAM.BINDVARS = ""
				
				IF (lv_d != 0) THEN
				#{
					lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
					lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"Insertion failed"+"^moduleId")
					print(BANCS.INPARAM.BINDVARS)
					lv_z=urhk_dbSqlWithBind("ROLLBACK")
					
					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			
			lv_s="INSERT INTO CUSTOM.MODULE_DETAILS"
			lv_s=lv_s + " VALUES(?SVAR,"
			lv_s=lv_s + "?SVAR,"
			lv_s=lv_s + "?SVAR,"
			lv_s=lv_s + "?SVAR,"
			lv_s=lv_s + "" + "to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss')"+","
			lv_s=lv_s + "?SVAR,"
			lv_s=lv_s + "" + "to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss')"+","
			lv_s=lv_s + "?SVAR,"
			lv_s=lv_s + "?SVAR,"
			lv_s=lv_s + "?SVAR)"
