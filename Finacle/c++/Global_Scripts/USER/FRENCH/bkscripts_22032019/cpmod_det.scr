				lv_n=lv_n + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
				print(BANCS.INPARAM.BINDVARS)
				
				lv_d=urhk_dbSelectWithBind(lv_n)
				
				print(lv_d)
				
				CUST.DATA.moduleDesc=BANCS.OUTPARAM.moduleDesc
