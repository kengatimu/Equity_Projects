		print(lv_p)
		BANCS.INPARAM.BINDVARS = CUST.CPMOD.table + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CPMOD.table_key
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CPMOD.table + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CPMOD.table_key
		print(BANCS.INPARAM.BINDVARS)
		
		lv_q=urhk_dbSelectWithBind(lv_p)
		
		print(lv_q)
		
		IF(lv_p==0) THEN
		#{
			CUST.CPMOD.funccode=BANCS.OUTPARAM.funccode
			PRINT("IN AUDIT")
			print(CUST.CPMOD.funccode)
			IF(CUST.CPMOD.modcount==0) THEN
			#{
				lv_p="encflg|"
				lv_p=lv_p +"SELECT ENTITY_CRE_FLG FROM CUSTOM.MODULE_DETAILS"
				lv_p=lv_p + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
				lv_p=lv_p + " AND DEL_FLG='N'"
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
				print(BANCS.INPARAM.BINDVARS)
				
				lv_d=urhk_dbSelectWithBind(lv_p)
				
				print(lv_d)
				CUST.CPMOD.encflg=BANCS.OUTPARAM.encflg
				print(CUST.CPMOD.encflg)
				IF(CUST.CPMOD.encflg=="N") THEN
				#{
					
					IF((CUST.CPMOD.funccode=="A") OR (CUST.CPMOD.funccode=="M"))THEN
					#{
						print("funccode is A OR M")
						lv_b="DELETE FROM CUSTOM.MODULE_DETAILS"
						lv_b=lv_b + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
						print(lv_b)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
						print(BANCS.INPARAM.BINDVARS)
						
						lv_d=urhk_dbSqlWithBind(lv_b)
						
						GOTO DEL
					#}
					ENDIF
					#}
				ELSE
					#{
					IF(CUST.CPMOD.funccode=="D") THEN
					#{
						GOTO DEL
					#}
					ENDIF
				#}
				ENDIF
				#}
			ELSE
				#{
				print("in mod table")
				IF(CUST.CPMOD.funccode=="M") THEN
				#{
					print("fi=unccode is M")
					lv_b="DELETE FROM CUSTOM.MODULEDET_MOD"
					lv_b=lv_b + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
					print(BANCS.INPARAM.BINDVARS)
					
					lv_d=urhk_dbSqlWithBind(lv_b)
					
				#}
				ENDIF
			#}
			ENDIF
			
			DEL:
				# Handle Audit. This Code should not be generated if Audit is not enabled
				lv_a = urhk_InitAudit("")
				CUST.DATA.adtProcCode = "X"
				CALL("cpmod_audit.scr")
				IF (CUST.DATA.adtSuccessOrFailure != "S") THEN
				#{
					CUST.DATA.procSuccessOrfailure = "F"
					
					IF (CUST.DATA.errorMesg == "") THEN
					#{
						CUST.DATA.tmpErrMessage = "Error in auditing record"
						#}
					ELSE
						#{
						CUST.DATA.tmpErrMessage = CUST.DATA.errorMesg
					#}
					ENDIF
					
					CUST.DATA.msgProcCode = "PROCMSG"
				#}
				ENDIF
				
				IF (CUST.DATA.procSuccessOrfailure == "F") THEN
				#{
					lv_r = urhk_SetOrbOut("^Error_1|ERROR^" + CUST.DATA.tmpErrMessage )
					lv_z = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO FINISH
				#}
				ENDIF
				
				lv_u=urhk_dbSqlWithBind("COMMIT")
				CUST.CPMOD.vrmsg="Cancellation done Successfully"
				lv_e=urhk_SetOrbOut("RESULT_MSG|" +CUST.CPMOD.vrmsg +" " +CUST.CPMOD.moduleId)
				lv_p=urhk_SetOrbOut("SuccessOrFailure|Y")
				#}
			ELSE
				#{
				lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
				lv_t = urhk_SetOrbOut("Error_1|ERROR:^"+"Entry is not made in audit table"+"^moduleId")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		#--------------------------------------------------------------------------------#
		#If the funcCode is for verify,check whether it is present in the mod table or not
		#--------------------------------------------------------------------------------#
		
		IF(CUST.CPMOD.funcCode=="V") THEN
		#{
			print(CUST.CPMOD.funcCode)
			
			lv_p="funccode|"
			lv_p=lv_p + "SELECT FUNC_CODE"
			lv_p=lv_p + " FROM TBAADM.ADT"
			lv_p=lv_p + " WHERE TABLE_NAME=?SVAR"
			lv_p=lv_p + " AND BANK_ID=?SVAR"
			lv_p=lv_p + " AND TABLE_KEY=?SVAR"
			lv_p=lv_p + " AND AUDIT_DATE=(SELECT MAX(AUDIT_DATE) FROM TBAADM.ADT"
			lv_p=lv_p + " WHERE TABLE_NAME=?SVAR"
			lv_p=lv_p + " AND BANK_ID=?SVAR"
			lv_p=lv_p + " AND TABLE_KEY=?SVAR)"
			print(lv_p)
			BANCS.INPARAM.BINDVARS = CUST.CPMOD.table + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CPMOD.table_key
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CPMOD.table + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CPMOD.table_key
			print(BANCS.INPARAM.BINDVARS)
			
			lv_q=urhk_dbSelectWithBind(lv_p)
			
			print(lv_q)
			
			IF(lv_q==0) THEN
			#{
				CUST.CPMOD.funccode=BANCS.OUTPARAM.funccode
				print(CUST.CPMOD.funccode)
				IF(CUST.CPMOD.modcount==0) THEN
				#{
					print("no data in mod table")
					IF((CUST.CPMOD.funccode=="A") OR (CUST.CPMOD.funccode=="M")) THEN
					#{
						print(CUST.CPMOD.modcount)
						
						#--------------------------------------------------------------------------------#
						#If not present in mod table,check lastuserid in main table,validate against the
						#current user,if both are not same then only he can verify it
						#--------------------------------------------------------------------------------#
						
						lv_l="UPDATE CUSTOM.MODULE_DETAILS SET ENTITY_CRE_FLG='Y'"
						lv_l=lv_l + " WHERE MODULE_ID=?SVAR"
						print(lv_l)
						BANCS.INPARAM.BINDVARS = CUST.CPMOD.moduleId
						print(BANCS.INPARAM.BINDVARS)
						
						lv_d=urhk_dbSqlWithBind(lv_l)
						
						
						BANCS.INPARAM.BINDVARS = ""
						
						IF(lv_d!=0) THEN
						#{
							lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
							lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"Verification Failed"+"^moduleId")
							print(BANCS.INPARAM.BINDVARS)
							lv_l=urhk_dbSqlWithBind("ROLLBACK")
							
							GOTO FINISH
						#}
						ENDIF
					#}
					ENDIF
					
					IF(CUST.CPMOD.funccode=="D") THEN
					#{
						GOTO UPDATE
					#}
					ENDIF
					
					#IF(CUST.CPMOD.funccode=="X") THEN
					#{
					#GOTO UPDATE
					#}
					#ENDIF
					
					#}
				ELSE
					#{
					print("in mod table")
					IF(CUST.CPMOD.funccode=="M") THEN
					#{
						#-------------------------------------------------------------------------------------------------------#
						#Check whether record exists in the main table or not, if yes, then validate lastuserid of mod table
						#against current user,if both are different,delete the data from mod table and verify the record in main
						#table
						#--------------------------------------------------------------------------------------------------------#
						
						print(CUST.CPMOD.modcount)
						lv_n="moduleId,moduleDesc,delflg,recrusrId,rcretime,encreflg|"
						lv_n=lv_n + "SELECT MODULE_ID,MODULE_DESC,DEL_FLG,RCRE_USER_ID,RCRE_TIME,ENTITY_CRE_FLG"
						lv_n=lv_n + " FROM CUSTOM.MODULEDET_MOD"
						lv_n=lv_n + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
						BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
						print(BANCS.INPARAM.BINDVARS)
						
						lv_d=urhk_dbSelectWithBind(lv_n)
						
						print(lv_d)
						
						CUST.DATA.moduleId=BANCS.OUTPARAM.moduleId
						CUST.DATA.moduleDesc=BANCS.OUTPARAM.moduleDesc
						CUST.DATA.delflg=BANCS.OUTPARAM.delflg
						CUST.DATA.recrusrId=BANCS.OUTPARAM.recrusrId
						CUST.DATA.rcretime=BANCS.OUTPARAM.rcretime
						CUST.DATA.encreflg=BANCS.OUTPARAM.encreflg
						
						lv_l="DELETE FROM CUSTOM.MODULEDET_MOD"
						lv_l=lv_l + " WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR"
						print(lv_l)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CUST.CPMOD.moduleId
						print(BANCS.INPARAM.BINDVARS)
						
						lv_d=urhk_dbSqlWithBind(lv_l)
						
						
						lv_a=" UPDATE CUSTOM.MODULE_DETAILS"
						lv_a=lv_a + " SET ENTITY_CRE_FLG='Y',"
						lv_a=lv_a + " MODULE_DESC= ?SVAR,"
						lv_a=lv_a + " LCHG_USER_ID= ?SVAR,"
						lv_a=lv_a + " LCHG_TIME=sysdate WHERE BANK_ID = ?SVAR AND MODULE_ID=?SVAR "
						print(lv_a)
						
						BANCS.INPARAM.BINDVARS = CUST.DATA.moduleDesc + "|" + CUST.CPMOD.lstusrid + "|" + BANCS.STDIN.contextBankId
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CPMOD.moduleId
						print(BANCS.INPARAM.BINDVARS)
						
						lv_d=urhk_dbSqlWithBind(lv_a)
						
					#}
					ENDIF
					
				#}
				ENDIF
				
			UPDATE:
				# Handle Audit. This Code should not be generated if Audit is not enabled
				print("initiating adt userhook")
				lv_a = urhk_InitAudit("")
				print(lv_a)
				CUST.DATA.adtProcCode = "V"
				CALL("cpmod_audit.scr")
				IF (CUST.DATA.adtSuccessOrFailure != "S") THEN
				#{
					CUST.DATA.procSuccessOrfailure = "F"
					
					IF (CUST.DATA.errorMesg == "") THEN
					#{
						CUST.DATA.tmpErrMessage = "Error in auditing record"
						#}
					ELSE
						#{
						CUST.DATA.tmpErrMessage = CUST.DATA.errorMesg
					#}
					ENDIF
					
					CUST.DATA.msgProcCode = "PROCMSG"
				#}
				ENDIF
				
				IF (CUST.DATA.procSuccessOrfailure == "F") THEN
				#{
					lv_r = urhk_SetOrbOut("^Error_1|ERROR^" + CUST.DATA.tmpErrMessage )
					lv_z = urhk_SetOrbOut("SuccessOrFailure|N")
					lv_l=urhk_dbSqlWithBind("ROLLBACK")
					GOTO FINISH
				#}
				ENDIF
				
				lv_u=urhk_dbSqlWithBind("COMMIT")
				CUST.CPMOD.vrmsg="Verfication done Successfully"
				lv_e=urhk_SetOrbOut("RESULT_MSG|" +CUST.CPMOD.vrmsg +" " +CUST.CPMOD.moduleId)
				lv_p=urhk_SetOrbOut("SuccessOrFailure|Y")
				#}
			ELSE
				#{
				lv_z=urhk_SetOrbOut("SuccessOrFailure|N")
				lv_u = urhk_SetOrbOut("Error_1|ERROR:^"+"No data in audit table"+"^moduleId")
				lv_l=urhk_dbSqlWithBind("ROLLBACK")
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		
	FINISH:
		EXITSCRIPT
		TRACE OFF
END-->
