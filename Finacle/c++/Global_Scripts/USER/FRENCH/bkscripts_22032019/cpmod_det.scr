	#--------------------------------------------------------------------------------#
	#If the funcCode is for delete,check whether it is present in the mod table or not
	#--------------------------------------------------------------------------------#
	
	IF(CUST.CPMOD.funcCode=="D") THEN
	#{
		print(CUST.CPMOD.modcount)
		lv_s="count|"
		lv_s=lv_s + "SELECT COUNT(*) FROM CUSTOM.C_CPARAM_MASTER_TABLE "
