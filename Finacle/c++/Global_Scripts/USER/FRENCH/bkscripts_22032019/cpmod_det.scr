			lv_u=urhk_SetOrbOut("RESULT_MSG|"+CUST.CPMOD.msg+" "+CUST.CPMOD.moduleId)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.CPMOD.funcCode=="M") THEN
	#{
		lv_a = urhk_InitAudit("")
