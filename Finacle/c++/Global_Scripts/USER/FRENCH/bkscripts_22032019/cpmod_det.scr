				lv_s=lv_s + "?SVAR,"
				lv_s=lv_s + "?SVAR,"
				lv_s=lv_s + "?SVAR,"
				lv_s=lv_s + "?SVAR,"
				lv_s=lv_s + "" + "to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss')"+","
				lv_s=lv_s + "?SVAR,"
				lv_s=lv_s + "?SVAR,"
				lv_s=lv_s + "?SVAR)"
				print(lv_S)
				BANCS.INPARAM.BINDVARS = CUST.CPMOD.moduleId + "|" + CUST.CPMOD.moduleDesc + "|" + CUST.DATA.delflg
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.creusrid + "|" + CUST.DATA.credate
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.sysDate
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.ecreflg + "|" + CUST.CPMOD.ts_cnt
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				lv_d=urhk_dbSqlWithBind(lv_s)
				
				print(lv_d)
