<--START
CHECKSUM="93e44c0ea8622e0d985c4c6a0c80d8319f3586d09622e9b02aabb2dee59a1e90"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0

	IF( (FIELDEXISTS(("BANCS").("INPUT").("account_number"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply account_number"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.account_number = BANCS.INPUT.account_number
		print(CUST.DATA.account_number)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("bank_id"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply bank_id"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.bank_id = BANCS.INPUT.bank_id
		print(CUST.DATA.bank_id)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("from_currency"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply from_currency"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.from_currency = BANCS.INPUT.from_currency
		print(CUST.DATA.from_currency)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("to_currency"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply to_currency"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.to_currency = BANCS.INPUT.to_currency
		print(CUST.DATA.to_currency)
	#}
	ENDIF

	sv_u = urhk_getAdvanceDetailsForAccount(CUST.DATA.account_number)
	print(sv_u)
	if(sv_u==0)then
		print(BANCS.OUTPARAM.FreeCode7)
		CUST.DATA.FreeCode7 = BANCS.OUTPARAM.FreeCode7
		print(CUST.DATA.FreeCode7)

		IF ((CUST.DATA.FreeCode7=="FXGA") OR (CUST.DATA.FreeCode7=="FXGB") OR (CUST.DATA.FreeCode7=="FXGC") OR (CUST.DATA.FreeCode7=="FXGD")) THEN
			####
				CUST.DATA.transactiontype=CUST.DATA.FreeCode7
				print(CUST.DATA.transactiontype)
				sv_q = " FXratecode| select CUSTOM.RETURN_FX_RATE_CODE(?SVAR,?SVAR,?SVAR,?SVAR) from dual"
				print(sv_q)
				BANCS.INPARAM.BINDVARS=CUST.DATA.from_currency + "|" + CUST.DATA.to_currency + "|" + CUST.DATA.transactiontype + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_w=urhk_dbSelectWithBind(sv_q)
				print(sv_w)
				IF ( sv_w != 0 ) then
					sv_e=urhk_SetOrbOut("StattusCode|2")
					CUST.DATA.errMsg="FX Group Not Maintained "
					sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
					GOTO End
				ELSE
					CUST.DATA.FXratecode = BANCS.OUTPARAM.FXratecode
					print(CUST.DATA.FXratecode)
					sv_z = urhk_SetOrbOut("RATE_CODE|"+CUST.DATA.FXratecode)
					print(sv_z)
					sv_e=urhk_SetOrbOut("StattusCode|1")
					#####
						BANCS.INPARAM.BINDVARS =CUST.DATA.from_currency + "|" + CUST.DATA.to_currency
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.FXratecode + "|" +BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
						sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
						sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
						sv_u = sv_u + " AND RATECODE= ?SVAR "
						sv_u = sv_u + " AND BANK_ID = ?SVAR  and rownum<2 "
						print(sv_u)
						sv_y=urhk_dbSelectWithBind(sv_u)
						print(sv_y)
						if (sv_y == "0") then
							sv_k = BANCS.OUTPARAM.fxdcrncycode
							print(sv_k)
							sv_j = BANCS.OUTPARAM.ratecode
							print(sv_j)
							sv_p = BANCS.OUTPARAM.Rate
							print(sv_p)
							CUST.DATA.rate = sv_p
							print(CUST.DATA.rate)
							sv_x= BANCS.OUTPARAM.treaRate
							print(sv_x)
							CUST.DATA.treaRate = sv_x
							print(CUST.DATA.treaRate)
							CUST.DATA.fixed_crncy = CUST.DATA.from_currency
							print(CUST.DATA.fixed_crncy)
							CUST.DATA.var_crncy = CUST.DATA.to_currency
							print(CUST.DATA.var_crncy)
							sv_z = urhk_SetOrbOut("RATE|"+CUST.DATA.rate)
							print(sv_z)
							sv_e=urhk_SetOrbOut("StattusCode|1")
						else
							BANCS.INPARAM.BINDVARS = CUST.DATA.to_currency + "|" + CUST.DATA.from_currency 
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.FXratecode + "|" +BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
							sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
							sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
							sv_u = sv_u + " AND RATECODE= ?SVAR "
							sv_u = sv_u + " AND BANK_ID = ?SVAR and rownum<2 "
							print(sv_u)
							sv_y=urhk_dbSelectWithBind(sv_u)
							print(sv_y)
							if (sv_y == "0") then
								sv_k = BANCS.OUTPARAM.fxdcrncycode
								print(sv_k)
								sv_j = BANCS.OUTPARAM.ratecode
								print(sv_j)
								sv_p = BANCS.OUTPARAM.Rate
								print(sv_p)
								CUST.DATA.rate = sv_p
								print(CUST.DATA.rate)
								sv_x= BANCS.OUTPARAM.treaRate
								print(sv_x)
								CUST.DATA.treaRate = sv_x
								print(CUST.DATA.treaRate)
								CUST.DATA.fixed_crncy = CUST.DATA.to_currency
								print(CUST.DATA.fixed_crncy)
								CUST.DATA.var_crncy = CUST.DATA.from_currency
								print(CUST.DATA.var_crncy)
								sv_z = urhk_SetOrbOut("RATE|"+CUST.DATA.rate)
								print(sv_z)
								sv_e=urhk_SetOrbOut("StattusCode|1")
							ELSE
								IF (CUST.DATA.to_currency != CUST.DATA.from_currency) THEN
								#{
									CUST.DATA.errMsg="Rate Not Maintained"
									sv_e=urhk_SetOrbOut("StattusCode|2")
									sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
								#}
								ENDIF
								print("Rate Not Maintained")
							endif
						endif
					#####
				ENDIF
			####
			sv_z = urhk_SetOrbOut("FXGROUP_CODE|"+CUST.DATA.FreeCode7)
			print(sv_z)
			sv_e=urhk_SetOrbOut("StattusCode|1")
		ELSE
			sv_e=urhk_SetOrbOut("StattusCode|2")
			CUST.DATA.errMsg="Customer Not Maintained for Special Rates"
			sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		ENDIF
	else
		CUST.DATA.errMsg="Invalid Account"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
	endif

	End:
		EXITSCRIPT
		TRACE OFF
END-->
