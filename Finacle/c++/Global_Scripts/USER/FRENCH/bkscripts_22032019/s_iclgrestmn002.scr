######################################################################################################################
# Source Name						: s_iclgrestmn002.scr
# Menu								: HICTM
# Date								: 28-01-2013
# Description						: This script will get call from SRV for validations.
# Input Values						: ZoneCode
# Output Values						: Yes or No.
# Called Scripts					: none
# Calling Script					: SRV_FetchZoneDtlForIcTranDelete_validate_data.scr
# Author     						: Shishira
# Bank								: Equity Bank,KENYA
# Modification History				:
#		< Version No.> 		<Date>		<Author Name> 		<Description>
#		 0.1			21-01-2013 		Shishira			   Original Version
########################################################################################################################
<--START
CHECKSUM="923cc86a1fca2be3a2107b307d6f4fc080d501fef008cc2c849185013b77b877"
	TRACE ON
	#-----------------------------------------------
	# Creating Repository
	#-----------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	BANCS.INPUT.zoneCode = ""
	BANCS.INPUT.funcCode = ""
	CUST.DATA.zoneCode = ""
	
	
	sv_z = urhk_SRV_GetVal("icZoneDtl.zone.zoneCode")
	IF	(sv_z != 0) THEN
	#{
		GOTO FINISH
	#}
	ENDIF
	
	CUST.DATA.mySol = BANCS.STDIN.mySolId
	
	print(BANCS.OUTPARAM.srvValue)
	CUST.DATA.zoneCode=BANCS.OUTPARAM.srvValue
	
	CUST.DATA.errMsg= ""
	BANCS.INPUT.moduleName="CLEARING"
	
	#-------------------------------------------
	#Fetching SolID
	#-------------------------------------------
	BANCS.INPUT.parameterId="SOL_000"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.headOffSol = BANCS.OUTPUT.parameterVal
		print(CUST.DATA.headOffSol)
		#}
	ELSE
		#{
		CUST.DATA.errMsg = "CPARAM set up not done for head offc sol"
		GOTO FINISH
	#}
	ENDIF
	
	print(CUST.DATA.headOffSol)
	print(CUST.DATA.mySol)
	
	IF ((CUST.DATA.headOffSol != CUST.DATA.mySol)) THEN
	#{
		sv_u =  urhk_SRV_SetErr("Deletion Not Allowed!...Contact H/O Clearing")
		GOTO FINISH
	#}
	ENDIF
	
	IF (BANCS.STDIN.contextBankId != "56") THEN
	#{
		#-----------------------------------------------
		# Getting Zone code from Custom Table
		#-----------------------------------------------
		BANCS.INPUT.parameterId = "ZONE_ICLG"
		CALL ("getcparamvalue.scr")
		IF (BANCS.OUTPUT.parameterVal != "") THEN
		#{
			CUST.DATA.zoneIclg = BANCS.OUTPUT.parameterVal
			print(CUST.DATA.zoneIclg)
			#}
		ELSE
			#{
			CUST.DATA.errMsg = "Zone set up is not done in CPARAM"
			GOTO FINISH
		#}
		ENDIF
		
		IF (BANCS.STDIN.homeSolId != CUST.DATA.headOffSol) THEN
		#{
			sv_f = getposition(CUST.DATA.zoneIclg ,"|"+CUST.DATA.zoneCode+"|")
			IF (sv_f > 0) THEN
			#{
				sv_u = urhk_SRV_SetErr("icZoneDtl.zone.zoneCode|Cannot be operated from Branch...Contact H/O Clearing")
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
		
		FINISH:
			IF (CUST.DATA.errMsg!= "") THEN
			#{
				sv_b = urhk_SRV_SetErr(CUST.DATA.errMsg)
			#}
			ENDIF
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
