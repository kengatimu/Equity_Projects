<--START
CHECKSUM="6b900cbdaacf9d78bd3089b6f41b636faf04dcc74cf8b370824bc10487275559"
	TRACE ON
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	#	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	CUST.LADISB.errMsg = ""
	sv_a = urhk_B2K_printRepos("BANCS")
	print(sv_a)
	
	#IF(BANCS.STDIN.menuId=="HLADISB") THEN
	IF(FIELDEXISTS(BANCS.STDIN.menuId) == 0) THEN
	#{
		print(BANCS.STDIN.userId)
		print(CUST.LADISB.loanForacid)
		print(CUST.LADISB.foracid)
		print(BANCS.STDIN.contextBankId)
		
		sv_u = urhk_SRV_GetVal("tranObj.tranDetail.tranIdentifier.tranId")
		print(sv_u)
		IF(sv_u == 0) THEN
		#{
			CUST.LADISB.tranId = BANCS.OUTPARAM.srvValue
			print(CUST.LADISB.tranId)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error occured in getting TranId"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.STDIN.userId) == 1) THEN
		#{
			print(BANCS.STDIN.userId)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error occured in getting userId"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(FIELDEXISTS(CUST.LADISB.loanForacid) == 1) THEN
		#{
			print(CUST.LADISB.loanForacid)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error occured in getting Newloan Account"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(FIELDEXISTS(CUST.LADISB.foracid) == 1) THEN
		#{
			print(CUST.LADISB.foracid)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error occured in getting Oldloan Account"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.STDIN.contextBankId) == 1) THEN
		#{
			print(BANCS.STDIN.contextBankId)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error occured in getting bankId"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(FIELDEXISTS(CUST.LADISB.tranId) == 1) THEN
		#{
			IF(CUST.LADISB.tranId != "") THEN
			#{
				print(CUST.LADISB.tranId)
				#-----------------------------------------------------
				#Update the status to the LADISB_PAYOFF_OLDLOAN table
				#-----------------------------------------------------
				sv_s ="UPDATE CUSTOM.C_LADISB_PAYOFF_OLDLOAN A"
				sv_s = sv_s + " SET A.entity_cre_flg = 'Y',"
				sv_s = sv_s + " A.tran_id=?SVAR,"
				sv_s = sv_s + " A.lchg_user_id=?SVAR,"
				sv_s = sv_s + " A.lchg_time = sysdate"
				sv_s = sv_s + " WHERE A.loan_foracid =?SVAR"
				sv_s = sv_s + " AND A.old_foracid =?SVAR"
				sv_s = sv_s + " AND A.bank_id=?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.LADISB.tranId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.loanForacid + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid +"|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSQLWithBind(sv_s)
				print(sv_d)
				
				IF(sv_d != 0) THEN
				#{
					CUST.LADISB.errMsg = "Error occured in updating the Custom table"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.LADISB.errMsg = "Error occured in getting tranId is null"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error occured in getting tranId"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		BANCS.OUTPUT.successOrFailure="S"
		IF(CUST.LADISB.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUST.LADISB.errMsg+"' >>ast0057.log")
		#}
		ENDIF
		
		EXITSCRIPT
		
		TRACE OFF
END-->
