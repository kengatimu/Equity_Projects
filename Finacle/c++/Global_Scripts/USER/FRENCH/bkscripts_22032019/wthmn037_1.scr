<--START
CHECKSUM="9aae83f6d94c1579fff79dc48eaea7dba6b0cde2ec2b383dad187e4f52363243"
	TRACE ON
	#################################################################
	# Getting the variables from parent script
	#################################################################
	BANCS.OUTPUT.PartTranNum="0"
	CUST.WITHTAX.delFlg 				= 	"N"
	CUST.WITHTAX.entityFlg 				=   "Y"
	CUST.WITHTAX.withdTaxAppFlg 		= 	""
	CUST.WITHTAX.placeHolder 			= 	""
	CUST.WITHTAX.wthTaxPer 				= 	""
	CUST.WITHTAX.crAccount				= 	""
	
	#################################################################
	# Getting value for "WTH_TAX_APP_FLG" set at Account Level
	#################################################################
	PRINT(CUST.WITHTAX.wthFlgChkAcct)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = CUST.WITHTAX.wthFlgChkAcct + "|" +BANCS.STDIN.contextBankId + "|" + CUST.WITHTAX.delFlg+ "|" + CUST.WITHTAX.entityFlg
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "withdTaxAppFlg|SELECT WTH_TAX_APP_FLG"
	sv_s = sv_s + " FROM CUSTOM.C_WTHAO"
	sv_s = sv_s + " WHERE  FORACID = ?SVAR"
	sv_s = sv_s + " AND  BANK_ID = ?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG,'N') = ?SVAR"
	sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG,'N')= ?SVAR "
	#
	PRINT(sv_s)
	sv_v = urhk_dbselectWithBind(sv_s)
	PRINT(sv_v)
	IF(sv_v == 0) THEN
	#{
		CUST.WITHTAX.withdTaxAppFlg 	= BANCS.OUTPARAM.withdTaxAppFlg
		#}
	ELSE
		#{
		CUST.WITHTAX.withdTaxAppFlg   = ""
	#}
	ENDIF
	PRINT(CUST.WITHTAX.withdTaxAppFlg)
	IF(CUST.WITHTAX.withdTaxAppFlg != "Y") THEN
	#{
		GOTO ENDOFSCRIPTWTH
	#}
	ENDIF
	
	#################################################################
	# Getting value for "WTH_TAX_APP_FLG" set at scheme level
	#################################################################
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = CUST.WITHTAX.wthFlgChkAcct + "|" + BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.contextBankId + "|" + CUST.WITHTAX.delFlg+ "|" + CUST.WITHTAX.entityFlg
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "placeHolder,wthTaxPer|SELECT BACID,WTH_TAX_PCNT"
	sv_s = sv_s + " FROM CUSTOM.C_WTH_GSP_DET"
	sv_s = sv_s + " WHERE SCHM_CODE = ( SELECT SCHM_CODE FROM GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR)"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG,'N') = ?SVAR"
	sv_s = sv_s + " AND NVL(ENTITY_CRE_FLG,'N')= ?SVAR "
	
	PRINT(sv_s)
	sv_v = urhk_dbselectWithBind(sv_s)
	PRINT(sv_v)
	IF(sv_v == 0) THEN
	#{
		CUST.WITHTAX.placeHolder 		= BANCS.OUTPARAM.placeHolder
		CUST.WITHTAX.wthTaxPer 			= BANCS.OUTPARAM.wthTaxPer
		#}
	ELSE
		#{
		BANCS.OUTPUT.successOrFailure ="F"
		GOTO ENDOFSCRIPTWTH
	#}
	ENDIF
	
	PRINT(CUST.WITHTAX.placeHolder)
	PRINT(CUST.WITHTAX.wthTaxPer)
	
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = CUST.WITHTAX.drAccount + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "acctCcy,sol_id|SELECT ACCT_CRNCY_CODE,SOL_ID"
	sv_s = sv_s + " FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	
	PRINT(sv_s)
	sv_v = urhk_dbselectWithBind(sv_s)
	PRINT(sv_v)
	IF(sv_v == 0) THEN
	#{
		CUST.WITHTAX.acctCcy 		    = BANCS.OUTPARAM.acctCcy
		CUST.WITHTAX.sol_id 			= BANCS.OUTPARAM.sol_id
	#}
	ENDIF
	PRINT(CUST.WITHTAX.acctCcy)
	PRINT(CUST.WITHTAX.sol_id)
	
	#################################################################
	# Getting the account num from Placeholder
	#################################################################
	
	sv_s = CUST.WITHTAX.placeHolder + "|" + CUST.WITHTAX.acctCcy + "|" + CUST.WITHTAX.sol_id
	PRINT(sv_s)
	sv_u = urhk_B2k_BacidToAcctId(sv_s)
	PRINT(sv_u)
	IF (sv_u != 0 ) THEN
	#{
		CUST.WITHTAX.errMsg ="Unable to fetch account from Placeholder "
		GOTO ENDOFSCRIPTWTH
	#}
	ENDIF
	CUST.WITHTAX.crAccount = BANCS.OUTPARAM.AcctId
	PRINT(CUST.WITHTAX.crAccount)
	
	PRINT(CUST.WITHTAX.tranAmt)
	CUST.WITHTAX.tranAmt	=	CDOUBLE(CUST.WITHTAX.tranAmt) * CDOUBLE(CUST.WITHTAX.wthTaxPer)/100
	PRINT(CUST.WITHTAX.tranAmt)
	#------------------------------------------------------------------------------------------------
	# Rounding Off the amount to nearest five cents
	#------------------------------------------------------------------------------------------------
	BANCS.INPARAM.InputAmount	=	CUST.WITHTAX.tranAmt
	BANCS.INPARAM.RoundOffAmt="0.05"
	BANCS.INPARAM.RoundOffFlag="N"
	sv_u=urhk_B2k_Roundoff("")
	IF (sv_u  == 0) THEN
	#{
		CUST.WITHTAX.tranAmt = BANCS.OUTPARAM.OutputAmount
	#}
	ENDIF
	#CUST.WITHTAX.tranAmt = FORMAT$(CDOUBLE(CUST.WITHTAX.tranAmt),"%.2f")
	PRINT(CUST.WITHTAX.tranAmt)
	
	#------------------------------------------------------------------------------------------------
	# START of Part tran for Transactions
	#------------------------------------------------------------------------------------------------
	# Debiting Dr account
	#------------------------------------------------------------------------------------------------
	PRINT(CUST.WITHTAX.drAccount)
	
	MTT.PartTranDetails.Account = CUST.WITHTAX.drAccount
	MTT.PartTranDetails.RefAmount = -1 * CDOUBLE(CUST.WITHTAX.tranAmt)
	MTT.PartTranDetails.TranIdentifier = CUST.WITHTAX.tranIdentifier
	MTT.PartTranDetails.Particulars = "Withholding tax ON Profit paid"
	MTT.PartTranDetails.Remarks	= "Withholding tax : Debit Tran"
	MTT.PartTranDetails.RefCurrency = CUST.WITHTAX.acctCcy
	MTT.PartTranDetails.Consolidate = "N"
	#	MTT.PartTranDetails.PTranBusinessType = "OPERATIVEACCTCLOSUREDR"
	MTT.PartTranDetails.Refnum	=	CUST.WITHTAX.Refnum
	
	BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
	
	PRINT(MTT.PartTranDetails.RefAmount)
	PRINT(MTT.PartTranDetails.Account)
	
	sv_j = urhk_MTTS_DefinePartTran("")
	PRINT(sv_j)
	
	IF (sv_j != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		PRINT(MTT.Error.Description)
		MTT.Error.Description="Could not Create Part tran for collection of WTH"
		sv_r = urhk_MTTS_ReportErrorCondition("")
		sv_r = BANCS.OUTPARAM.MTTErrorDesc
		GOTO ENDOFSCRIPTWTH
	#}
	ENDIF
	
	#------------------------------------------------------------------------------------------------
	# Crediting Cr Account -
	#------------------------------------------------------------------------------------------------
	MTT.PartTranDetails.Account = CUST.WITHTAX.crAccount
	MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.WITHTAX.tranAmt)
	MTT.PartTranDetails.TranIdentifier = CUST.WITHTAX.tranIdentifier
	MTT.PartTranDetails.Particulars = "Withholding tax ON Profit paid"
	MTT.PartTranDetails.Remarks	= "Withholding tax : Credit Tran"
	MTT.PartTranDetails.RefCurrency = CUST.WITHTAX.acctCcy
	MTT.PartTranDetails.Consolidate	= "N"
	#	MTT.PartTranDetails.PTranBusinessType = "OPERATIVEACCTCLOSURECR"
	MTT.PartTranDetails.Refnum	=	CUST.WITHTAX.Refnum
	
	BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
	
	PRINT(MTT.PartTranDetails.Account)
	PRINT(MTT.PartTranDetails.RefAmount)
	
	sv_j = urhk_MTTS_DefinePartTran("")
	PRINT(sv_j)
	
	IF (sv_j != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		MTT.Error.Description="Could not Create Part tran for collection of WTH"
		sv_r = urhk_MTTS_ReportErrorCondition("")
		sv_r = BANCS.OUTPARAM.MTTErrorDesc
		GOTO ENDOFSCRIPTWTH
	#}
	ENDIF
	
	ENDOFSCRIPTWTH:
END-->
