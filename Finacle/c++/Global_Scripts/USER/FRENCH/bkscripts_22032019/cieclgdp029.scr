	CUST.CIECLG.instrumentEntity = ""
	CUST.CIECLG.shortName = ""
	CUST.CIECLG.instrumentBranchName = ""
	CUST.CIECLG.delFlg = ""
	CUST.CIECLG.recordCount = "0"
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentBankCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentBankCode) != "")THEN
		#{
			CUST.CIECLG.instrumentBankCode = BANCS.INPUT.instrumentBankCode
			print(CUST.CIECLG.instrumentBankCode)
