		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentSortCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentSortCode) != "")THEN
		#{
			CUST.CIECLG.instrumentSortCode = BANCS.INPUT.instrumentSortCode
			print(CUST.CIECLG.instrumentSortCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentEntity) != "")THEN
		#{
			CUST.CIECLG.instrumentEntity = BANCS.INPUT.instrumentEntity
			print(CUST.CIECLG.instrumentEntity)
		#}
		ENDIF
	#}
	ENDIF
	
	CUST.CIECLG.instrumentBankCode = CUST.CIECLG.instrumentBankCode + "%"
	CUST.CIECLG.instrumentBranchCode = CUST.CIECLG.instrumentBranchCode + "%"
	CUST.CIECLG.instrumentSortCode = CUST.CIECLG.instrumentSortCode + "%"
	
	BANCS.INPARAM.BINDVARS = CUST.CIECLG.instrumentEntity + "|" + CUST.CIECLG.instrumentBankCode + "|" + CUST.CIECLG.instrumentBranchCode + "|" + CUST.CIECLG.instrumentSortCode
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "recordCount|"
	sv_s = sv_s + " SELECT COUNT(*)"
	sv_s = sv_s + " FROM TBAADM.TBA_BRANCH_CODE_TBL "
	sv_s = sv_s + " WHERE TBA_BRANCH_CODE_TBL.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND  LOCAL_CLG_FLG = 'Y' "
	sv_s = sv_s + " AND BR_CODE >= '!' "
	sv_s = sv_s + " AND BANK_CODE LIKE ?SVAR"
	sv_s = sv_s + " AND BR_CODE LIKE ?SVAR"
	sv_s = sv_s + " AND BR_CODE NOT IN ('248','249')"
	sv_s = sv_s + " AND CONCAT(CONCAT(MICR_CENTRE_CODE,MICR_BANK_CODE),MICR_BRANCH_CODE) LIKE ?SVAR"
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIECLG.recordCount = BANCS.OUTPARAM.recordCount
		print(CUST.CIECLG.recordCount)
	#}
	ENDIF
	
	sv_u = urhk_SetOrbOut("recordCount|"+CUST.CIECLG.recordCount)
	print(sv_u)
	
	BANCS.INPARAM.BINDVARS = CUST.CIECLG.instrumentEntity + "|" + CUST.CIECLG.instrumentBankCode + "|" + CUST.CIECLG.instrumentBranchCode + "|" + CUST.CIECLG.instrumentSortCode
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "instrumentBankCode,instrumentBranchCode,shortName,instrumentBranchName,instrumentSortCode,delFlg|"
	sv_s = sv_s + " SELECT BANK_CODE,BR_CODE,"
	sv_s = sv_s + " REPLACE(REPLACE(NVL(BR_SHORT_NAME,'-'),'\','\\'),'''','\'''),"
	sv_s = sv_s + " REPLACE(REPLACE(NVL(BR_NAME,'-'),'\','\\'),'''','\'''),"
	sv_s = sv_s + " CONCAT(CONCAT(MICR_CENTRE_CODE,MICR_BANK_CODE),MICR_BRANCH_CODE),DEL_FLG"
	sv_s = sv_s + " FROM TBAADM.TBA_BRANCH_CODE_TBL "
	sv_s = sv_s + " WHERE TBA_BRANCH_CODE_TBL.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND  LOCAL_CLG_FLG = 'Y' "
	sv_s = sv_s + " AND BR_CODE >= '!' "
	sv_s = sv_s + " AND BANK_CODE LIKE ?SVAR"
	sv_s = sv_s + " AND BR_CODE LIKE ?SVAR"
	sv_s = sv_s + " AND BR_CODE NOT IN ('249','248')"
	sv_s = sv_s + " AND CONCAT(CONCAT(MICR_CENTRE_CODE,MICR_BANK_CODE),MICR_BRANCH_CODE) LIKE ?SVAR"
	sv_s = sv_s + " ORDER BY BANK_CODE, 3"
	print(sv_s)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF(sv_c != 0)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	
	sv_i = 1
	
	WHILE(sv_f == 0)
	#{
		CUST.CIECLG.instrumentBankCode = BANCS.OUTPARAM.instrumentBankCode
		print(CUST.CIECLG.instrumentBankCode)
		
		CUST.CIECLG.instrumentBranchCode = BANCS.OUTPARAM.instrumentBranchCode
		print(CUST.CIECLG.instrumentBranchCode)
		
		CUST.CIECLG.shortName = BANCS.OUTPARAM.shortName
		print(CUST.CIECLG.shortName)
		
		CUST.CIECLG.instrumentBranchName = BANCS.OUTPARAM.instrumentBranchName
		print(CUST.CIECLG.instrumentBranchName)
		
		CUST.CIECLG.instrumentSortCode = BANCS.OUTPARAM.instrumentSortCode
		print(CUST.CIECLG.instrumentSortCode)
		
		CUST.CIECLG.delFlg = BANCS.OUTPARAM.delFlg
		print(CUST.CIECLG.delFlg)
		
		sv_s = "instrumentSortCode_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.instrumentSortCode
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "instrumentBankCode_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.instrumentBankCode
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "instrumentBranchCode_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.instrumentBranchCode
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "shortName_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.shortName
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "instrumentBranchName_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.instrumentBranchName
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "delFlg_" + Format$(sv_i,"%d") + "|" + CUST.CIECLG.delFlg
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_i = sv_i + 1
		
		sv_f = urhk_dbCursorFetch(sv_n)
		print(sv_f)
		
	#}
	DO
	
	sv_c = urhk_dbCursorClose(sv_n)
	print(sv_c)
	
	
	ENDOFSCRIPT:
		
END-->
