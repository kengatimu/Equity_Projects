################################################################################################
#  Name			:  denomdp006.scr
#  Date			:  19-Dec-2006
#  Description		:  This script validates the currency code and sends back
#			:  the existing denomination details to the front end
#  Input		:  FuncCode, Currency from JSP
#  Output		:  Number of decimal points,Currency Name and Denomination details
#  Author		:  Castro
#  Calling JSP		:  None
#  Menu Option		:
#  MODULE CODE		:  DENOM
#  Modification History	:
#  ====================
#	Serial No.	Date			Author			Description
#	0.1		13-JUN-2010		Sandeep Patil		Draft Version
################################################################################################
<--START
CHECKSUM="f5a4aaf140b7f214e4f1492fec30c50a86c5fa7744f17b690a71b1a0d8db84b7"
	TRACE ON
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST", "DENOM")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	sv_u=urhk_b2k_PrintRepos("BANCS")
	CUST.DENOM.CrncyCount = BANCS.INPUT.CrncyCount
	CUST.DENOM.TranType = BANCS.INPUT.TranType
	CUST.DENOM.tellerId = BANCS.STDIN.EmployeeId
	CUST.DENOM.bank_id = BANCS.STDIN.contextBankId
	print(CUST.DENOM.bank_id)
	CUST.DENOM.MENU_ID = TRIM(BANCS.STDIN.menuId)
	print(CUST.DENOM.MENU_ID)
	sv_c = 0
	
	WHILE(sv_c < CINT(CUST.DENOM.CrncyCount))
	#{
		sv_e = "N"
		IF(FIELDEXISTS(("BANCS").("INPUT").("AcctId"+ FORMAT$(sv_c,"%d"))) == 0) THEN
		#{
			sv_e = "Y"
			GOTO NULLENT
		#}
		ENDIF
		CUST.DENOM.Acctid=("BANCS").("INPUT").("AcctId"+ FORMAT$(sv_c,"%d"))
		PRINT(CUST.DENOM.Acctid)
		
		("CUST").("DENOM").("AcctId"+ FORMAT$(sv_c,"%d")) = CUST.DENOM.Acctid
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.Acctid + "|" + CUST.DENOM.bank_id
		print(BANCS.INPARAM.BINDVARS)
		
		sv_l = "bacid,solId,crncy,bankId|SELECT bacid,sol_id,acct_crncy_code,bank_id "
		sv_l = sv_l + "FROM gam "
		sv_l = sv_l + "WHERE foracid = ?SVAR "
		sv_l = sv_l + "AND bank_id= ?SVAR "
		PRINT(sv_l)
		sv_v = urhk_DBSelectWithBind(sv_l)
		IF(sv_v != 0) THEN
		#{
			sv_e = "Y"
			GOTO NULLENT
		#}
		ENDIF
		CUST.DENOM.bacid = BANCS.OUTPARAM.bacid
		CUST.DENOM.solId = BANCS.OUTPARAM.solId
		CUST.DENOM.crncy = BANCS.OUTPARAM.crncy
		CUST.DENOM.bankId = BANCS.OUTPARAM.bankId
		
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.bacid +"|"+ CUST.DENOM.solId +"|"+ CUST.DENOM.crncy +"|"+ CUST.DENOM.bank_id +"|"+"Y"+"|"+"Y"
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_l = "empId|SELECT emp_id "
		sv_l = sv_l + "FROM GEC "
		sv_l = sv_l + "WHERE emp_cash_acct = ?SVAR "
		sv_l = sv_l + "AND sol_id = ?SVAR "
		sv_l = sv_l + "AND crncy_code = ?SVAR "
		sv_l = sv_l + "AND bank_id = ?SVAR "
		sv_l = sv_l + "AND entity_cre_flg = ?SVAR AND del_flg != ?SVAR "
		#---------This line added due to instabilty in database-----------
		sv_l = sv_l + "AND rownum<2 "
		#-------------------------------------------------------------------
		PRINT(sv_l)
		sv_v = urhk_DBSelectWithBind(sv_l)
		PRINT(sv_v)
		IF(sv_v==0)THEN
		#{
			("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d")) = BANCS.OUTPARAM.empId
			("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d"))= CUST.DENOM.solId
			PRINT(("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d")))
			PRINT(("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d")))
			#}
		ELSE
			#{
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.Acctid +"|"+ CUST.DENOM.bank_id+"|"+"Y"+"|"+"Y"
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = "exists|SELECT 1 "
			sv_q = sv_q + "FROM dual "
			sv_q = sv_q + "WHERE EXISTS "
			sv_q = sv_q + "( SELECT 1 FROM gct "
			sv_q = sv_q + "WHERE cash_bacid = "
			sv_q = sv_q + "(SELECT bacid FROM gam "
			sv_q = sv_q + "WHERE foracid = ?SVAR "
			sv_q = sv_q + "AND bank_id= ?SVAR "
			sv_q = sv_q + "AND entity_cre_flg = ?SVAR "
			sv_q = sv_q + "AND del_flg!= ?SVAR)) "
			PRINT(sv_q)
			sv_v = urhk_DBSelectWithBind(sv_q)
			PRINT(sv_v)
			IF(sv_v == 0) THEN
			#{
				("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d")) = "VAULT"
				#("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d")) = BANCS.STDIN.mySolId
				("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d")) = CUST.DENOM.solId
			#}
			ELSE
			#{
				sv_e = "Y"
				GOTO NULLENT
			#}
			ENDIF
		#}
		ENDIF
		
		NULLENT:
			IF(sv_e == "Y") THEN
			#{
				("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d"))=BANCS.STDIN.EmployeeId
				("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d"))=BANCS.STDIN.mySolId
				PRINT(("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d")))
				PRINT(("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d")))
			#}
			ENDIF
			#-----------------------------------------------------------------------------
			#  checking Denominations present for current currency in C_MDNM table
			#-----------------------------------------------------------------------------
			sv_u = ("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d"))
			sv_b = ("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d"))
			#--------------------------------------------------------------
			#---Checking for SOL is allowed for Denom module----
			#---------------------------------------------------------------------
			
			BANCS.INPARAM.BINDVARS = sv_b +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_l = "flg|SELECT dis_flg "
			sv_l = sv_l + "FROM c_solmnt "
			sv_l = sv_l + "WHERE sol_id = ?SVAR "
			sv_l = sv_l + "AND bank_id= ?SVAR "
			PRINT(sv_l)
			sv_v = urhk_DBSelectWithBind(sv_l)
			PRINT(sv_v)
			IF(sv_v==0)THEN
			#{
				CUST.DENOM.flg=BANCS.OUTPARAM.flg
				PRINT(CUST.DENOM.flg)
				IF(CUST.DENOM.flg=="Y")THEN
				#{
					sv_u = urhk_setOrbOut("Message|N")
					sv_u = urhk_setOrbOut("Details|DIS")
					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
			#--------------------------------------------------------------
			#---Checking for MENU is allowed for Denom module----
			#---------------------------------------------------------------------
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.MENU_ID +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_l = "flg|SELECT dis_flg "
			sv_l = sv_l + "FROM c_menumnt "
			sv_l = sv_l + "WHERE MENU_ID = ?SVAR "
			sv_l = sv_l + "AND bank_id= ?SVAR "
			PRINT(sv_l)
			sv_v = urhk_DBSelectWithBind(sv_l)
			PRINT(sv_v)
			IF(sv_v==0)THEN
			#{
				CUST.DENOM.flg=BANCS.OUTPARAM.flg
				PRINT(CUST.DENOM.flg)
				IF(CUST.DENOM.flg=="Y")THEN
				#{
					sv_u = urhk_setOrbOut("Message|N")
					sv_u = urhk_setOrbOut("Details|DIS")
					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
			#-------------------------------------------------
			sv_z = ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))
			PRINT(sv_z)
			
			BANCS.INPARAM.BINDVARS = sv_z +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_l = "cnt|SELECT COUNT(*) "
			sv_l = sv_l + "FROM c_mdnm "
			sv_l = sv_l + "WHERE del_flg = 'Y' "
			#sv_l = sv_l + "AND crncy_code = '" + (("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))) + "' "
			sv_l = sv_l + "AND crncy_code = ?SVAR "
			sv_l = sv_l + "AND denom_ind='N' "
			sv_l = sv_l + "AND bank_id= ?SVAR "
			PRINT(sv_l)
			sv_x = urhk_DBSelectWithBind(sv_l)
			PRINT(sv_x)
			CUST.DENOM.cnt = BANCS.OUTPARAM.cnt
			PRINT(CUST.DENOM.cnt)
			CUST.DENOM.crncyCode = ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))
			IF(CINT(CUST.DENOM.cnt) > 0) THEN
			#{
				sv_u = urhk_setOrbOut("Message|F")
				sv_u = urhk_setOrbOut("Details|Denominations For "+CUST.DENOM.crncyCode+" are deleted at present")
				GOTO FINISH
			#}
			ENDIF
			#-----------------------------------------------------------------------------
			#  checking Denominations present for current currency in C_MDNM table
			#-----------------------------------------------------------------------------
			sv_u = ("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d"))
			sv_b = ("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d"))
			sv_z = ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))
			
			BANCS.INPARAM.BINDVARS = sv_z +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_l = "cnt|SELECT COUNT(*) "
			sv_l = sv_l + "FROM c_mdnm "
			sv_l = sv_l + "WHERE del_flg = 'N' "
			#sv_l = sv_l + "AND crncy_code = '" + (("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))) + "' "
			sv_l = sv_l + "AND crncy_code = ?SVAR "
			sv_l = sv_l + "AND denom_ind='N' "
			sv_l = sv_l + "AND bank_id= ?SVAR "
			PRINT(sv_l)
			sv_x = urhk_DBSelectWithBind(sv_l)
			PRINT(sv_x)
			CUST.DENOM.cnt = BANCS.OUTPARAM.cnt
			PRINT(CUST.DENOM.cnt)
			CUST.DENOM.crncyCode = ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))
			IF(CINT(CUST.DENOM.cnt) == 0) THEN
			#{
				sv_u = urhk_setOrbOut("Message|F")
				sv_u = urhk_setOrbOut("Details|Denominations For "+CUST.DENOM.crncyCode+" are not present")
				GOTO FINISH
			#}
			ENDIF
			#-----------------------------------------------------------------------------
			#  checking Denominations present for current currency in C_DENM table
			#-----------------------------------------------------------------------------
			sv_u = ("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d"))
			sv_b = ("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d"))
			sv_z = ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))
			
			BANCS.INPARAM.BINDVARS = sv_z +"|"+ sv_u +"|" + sv_b +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_l = "cnt|SELECT COUNT(*) "
			sv_l = sv_l + "FROM c_denm "
			sv_l = sv_l + "WHERE del_flg = 'N' "
			#sv_l = sv_l + "AND crncy_code = '" + ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d")) + "' "
			sv_l = sv_l + "AND crncy_code = ?SVAR "
			sv_l = sv_l + "AND teller_id = ?SVAR "
			sv_l = sv_l + "AND SOL_ID = ?SVAR "
			sv_l = sv_l + "AND denom_ind = 'N' "
			sv_l = sv_l + "AND bank_id = ?SVAR "
			PRINT(sv_l)
			CUST.DENOM.crncyCode=(("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d")))
			sv_x = urhk_DBSelectWithBind(sv_l)
			PRINT(sv_x)
			CUST.DENOM.cnt = BANCS.OUTPARAM.cnt
			
			BANCS.INPARAM.BINDVARS= CUST.DENOM.crncyCode +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			IF(CINT(CUST.DENOM.cnt) == 0) THEN
			#{
				sv_v = "INSERT INTO c_denm "
				sv_v = sv_v + "(sol_id,crncy_code,denom_ind,denom_value,"
				sv_v = sv_v + "denom_count,teller_id,rcre_user_id,rcre_time,"
				sv_v = sv_v + "lchg_user_id,lchg_time,del_flg,bank_id) "
				sv_v = sv_v + "SELECT '" + BANCS.STDIN.mySolId + "',crncy_code,denom_ind,denom_value,"
				sv_v = sv_v + "0,'"+sv_u+"',rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,bank_id "
				sv_v = sv_v + "FROM c_mdnm "
				sv_v = sv_v + "WHERE crncy_code = ?SVAR "
				sv_v = sv_v + "AND bank_id = ?SVAR "
				PRINT(sv_v)
				sv_x = urhk_DBSqlWithBind(sv_v)
				PRINT(sv_x)
				#--------------------Inserting values in C_DENM_DR-----------------
				BANCS.INPARAM.BINDVARS= CUST.DENOM.crncyCode +"|"+ CUST.DENOM.bank_id
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_v = "INSERT INTO c_denm_dr "
				sv_v = sv_v + "(sol_id,crncy_code,denom_ind,denom_value,"
				sv_v = sv_v + "denom_count,teller_id,rcre_user_id,rcre_time,"
				sv_v = sv_v + "lchg_user_id,lchg_time,del_flg,bank_id) "
				sv_v = sv_v + "SELECT '" + BANCS.STDIN.mySolId + "',crncy_code,denom_ind,denom_value,"
				sv_v = sv_v + "0,'" + sv_u + "',rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,bank_id "
				sv_v = sv_v + "FROM c_mdnm "
				sv_v = sv_v + "WHERE crncy_code = ?SVAR "
				sv_v = sv_v + "AND bank_id = ?SVAR"
				PRINT(sv_v)
				sv_x = urhk_DBSqlWithBind(sv_v)
				PRINT(sv_x)
				#---------------------------INserting values into C_DENM_CR---
				BANCS.INPARAM.BINDVARS= CUST.DENOM.crncyCode +"|"+ CUST.DENOM.bank_id
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_v = "INSERT INTO c_denm_cr "
				sv_v = sv_v + "(sol_id,crncy_code,denom_ind,denom_value,"
				sv_v = sv_v + "denom_count,teller_id,rcre_user_id,rcre_time,"
				sv_v = sv_v + "lchg_user_id,lchg_time,del_flg,bank_id) "
				sv_v = sv_v +  "SELECT '" + BANCS.STDIN.mySolId + "',crncy_code,denom_ind,denom_value,"
				sv_v = sv_v + "0,'"+sv_u+"',rcre_user_id,rcre_time,lchg_user_id,lchg_time,del_flg,bank_id "
				sv_v = sv_v + "FROM c_mdnm "
				sv_v = sv_v + "	WHERE crncy_code= ?SVAR "
				sv_v = sv_v + " AND bank_id = ?SVAR "
				PRINT(sv_v)
				sv_x = urhk_DBSqlWithBind(sv_v)
				PRINT(sv_x)
				#}
			ELSE
				#{
				CUST.DENOM.tellerId = ("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d"))
				CUST.DENOM.solId = ("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d"))
				#-- To check if new denomination added for current currencies and add it to C_DENM,C_DENM_CR and C_DENM_DR tables--
				CALL("denomdp024.scr")
			#}
			ENDIF
			#-----------------------------------------------------------------------------------
			#  checking for currency with DENOM_count=0
			#-----------------------------------------------------------------------------------
			sv_u = ("CUST").("DENOM").("tellerId"+ FORMAT$(sv_c,"%d"))
			sv_b = ("CUST").("DENOM").("solId"+ FORMAT$(sv_c,"%d"))
			sv_d = 0
			WHILE(sv_d < CINT(CUST.DENOM.CrncyCount))
			#{
				PRINT(sv_d)
				PRINT(("BANCS").("INPUT").("pTranType"+ FORMAT$(sv_c,"%d")))
				CUST.DENOM.pTranType=("BANCS").("INPUT").("pTranType"+ FORMAT$(sv_c,"%d"))
				PRINT(CUST.DENOM.pTranType)
				IF(CUST.DENOM.pTranType=="D")THEN
				#{
					CUST.DENOM.crncyCode = ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_c,"%d"))
					
					BANCS.INPARAM.BINDVARS= CUST.DENOM.crncyCode +"|"+ sv_u +"|"+ sv_b +"|"+ CUST.DENOM.bank_id
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_l = "cnt|SELECT COUNT(*) "
					sv_l = sv_l + "FROM c_denm "
					sv_l = sv_l + "WHERE del_flg='N' "
					sv_l = sv_l + "AND crncy_code = ?SVAR "
					sv_l = sv_l + "AND teller_id = ?SVAR "
					sv_l = sv_l + "AND SOL_ID = ?SVAR "
					sv_l = sv_l + "AND DENOM_COUNT > 0 "
					sv_l = sv_l + "AND bank_id = ?SVAR "
					PRINT(sv_l)
					sv_x = urhk_DBSelectWithBind(sv_l)
					IF(sv_x != 0)THEN
					#{
						sv_u = urhk_setOrbOut("Message|F")
						sv_u = urhk_setOrbOut("Details|DataBase Error")
						GOTO FINISH
					#}
					ENDIF
					PRINT(sv_x)
					CUST.DENOM.cnt = BANCS.OUTPARAM.cnt
					IF(CINT(CUST.DENOM.cnt) == 0) THEN
					#{
						sv_u = urhk_setOrbOut("Message|F")
						sv_u = urhk_setOrbOut("Details|Denomination for "+CUST.DENOM.crncyCode+" with teller is zero ")
						GOTO FINISH
					#}
					ENDIF
				#}
				ENDIF
				sv_d=sv_d+1
			#}
			DO
			sv_c = sv_c + 1
		#}
		DO
		sv_p = 0
		WHILE(sv_p < CINT(CUST.DENOM.CrncyCount))
		#{
			
			CUST.DENOM.mask ="N"
			
			IF(FIELDEXISTS(("CUST").("DENOM").("AcctId"+ FORMAT$(sv_p,"%d"))) == 1) THEN
			#{
				
				CUST.DENOM.Acct=("CUST").("DENOM").("AcctId"+ FORMAT$(sv_p,"%d"))
				print("test")
				PRINT(CUST.DENOM.Acct)
				
				
				
				BANCS.INPARAM.BINDVARS = CUST.DENOM.Acct + "|" + CUST.DENOM.bank_id
				print(BANCS.INPARAM.BINDVARS)
				
				sv_l = "bacid,solId,crncy,bankId,acid|SELECT bacid,sol_id,acct_crncy_code,bank_id,acid "
				sv_l = sv_l + "FROM gam "
				sv_l = sv_l + "WHERE foracid = ?SVAR "
				sv_l = sv_l + "AND bank_id= ?SVAR "
				PRINT(sv_l)
				sv_v = urhk_DBSelectWithBind(sv_l)
				IF(sv_v == 0) THEN
				#{
					CUST.DENOM.bacid = BANCS.OUTPARAM.bacid
					CUST.DENOM.solId = BANCS.OUTPARAM.solId
					CUST.DENOM.crncy = BANCS.OUTPARAM.crncy
					CUST.DENOM.bankId = BANCS.OUTPARAM.bankId
					CUST.DENOM.acid = BANCS.OUTPARAM.acid
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.acid +"|"+ CUST.DENOM.bank_id
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_l = "cnts|select count(*) "
					sv_l = sv_l + "from tbaadm.aac "
					sv_l = sv_l + " where acid = ?SVAR AND bank_id = ?SVAR "
					sv_l = sv_l + " AND entity_cre_flg='Y' "
					print(sv_l)
					sv_v = urhk_DBSelectWithBind(sv_l)
					IF(sv_v != 0) THEN
					#{
						CUST.DENOM.cnts = "0"
					#}
					ELSE
					#{
						CUST.DENOM.mask = "N"
					#}
					ENDIF
					
					CUST.DENOM.cnts = BANCS.OUTPARAM.cnts
					print(CUST.DENOM.cnts)
					
					IF(CUST.DENOM.cnts > 0)THEN
					#{
						sv_l = "accessCode| select acct_access_code from tbaadm.aac "
						sv_l = sv_l + " where acid = ?SVAR AND bank_id = ?SVAR "
						sv_l = sv_l + " AND entity_cre_flg='Y' "
						print(sv_l)
						sv_v = urhk_DBSelectWithBind(sv_l)
						IF(sv_v == 0)THEN
						#{
							CUST.DENOM.accessCode = BANCS.OUTPARAM.accessCode
							print(CUST.DENOM.accessCode)
							
							BANCS.INPARAM.BINDVARS = CUST.DENOM.accessCode +"|"+  BANCS.STDIN.userId +"|"+ CUST.DENOM.bank_id
							print(BANCS.INPARAM.BINDVARS)
							sv_l = "cntRec|select count(*) from tbaadm.uac"
							sv_l = sv_l + " where acct_access_code = ?SVAR AND user_id = ?SVAR "
							sv_l = sv_l + " AND bank_id = ?SVAR AND entity_cre_flg='Y' "
							print(sv_l)
							sv_v = urhk_DBSelectWithBind(sv_l)
							print(BANCS.OUTPARAM.cntRec)
							IF(BANCS.OUTPARAM.cntRec > 0)THEN
							#{
								CUST.DENOM.mask = "N"
							#}
							ELSE
							#{
								CUST.DENOM.mask = "Y"
							#}
							ENDIF
							
						#}
						ENDIF
					#}
					ELSE
					#{
						CUST.DENOM.mask = "N"
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			CUST.DENOM.crncy = ("BANCS").("INPUT").("Crncy"+FORMAT$(sv_p,"%d"))
			#--------------------------------------------------------------------------------------
			#	FETCH CURRENCY NAME AND DECIMAL POINTS	#
			#--------------------------------------------------------------------------------------
			
			BANCS.INPARAM.BINDVARS = CUST.DENOM.crncy + "|" + CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "CrncyName,NumOfDecPoints|SELECT crncy_name, num_of_dec_points FROM tbaadm.cnc"
			sv_s = sv_s + " WHERE crncy_code = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_d = urhk_DBSelectWithBind(sv_s)
			IF(sv_d != 0 )THEN
			#{
				sv_u = urhk_setOrbOut("Message|F")
				sv_u = urhk_setOrbOut("Details|DataBase Error")
				GOTO FINISH
			#}
			ENDIF
			CUST.DENOM.CrncyName = BANCS.OUTPARAM.CrncyName
			CUST.DENOM.NumOfDecPoints = BANCS.OUTPARAM.NumOfDecPoints
			#--------------------------------------------------------------------------------------
			#	SEND EXISTING DENOMINATIONS TO FRONTEND		#
			#--------------------------------------------------------------------------------------
			IF(FIELDEXISTS(("CUST").("DENOM").("tellerId"+ FORMAT$(sv_p,"%d")))) THEN
			#{
				sv_u = ("CUST").("DENOM").("tellerId"+ FORMAT$(sv_p,"%d"))
			#}
			ELSE
			#{
				sv_u = BANCS.STDIN.EmployeeId
			#}
			ENDIF
			IF(FIELDEXISTS(("CUST").("DENOM").("solId"+ FORMAT$(sv_p,"%d")))) THEN
			#{
				sv_b = ("CUST").("DENOM").("solId"+ FORMAT$(sv_p,"%d"))
			#}
			ELSE
			#{
				sv_b = BANCS.STDIN.mySolId
			#}
			ENDIF
			
			BANCS.INPARAM.BINDVARS = sv_u +"|"+ sv_b +"|"+ CUST.DENOM.bank_id +"|"+	CUST.DENOM.crncy
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "DenomInd,DenomValue,DenomCount|SELECT a.denom_ind,a.denom_value,"
			sv_s = sv_s + "(A.denom_count - B.denom_count) "
			sv_s = sv_s + "FROM C_DENM A, C_DENM_DR B "
			sv_s = sv_s + "WHERE A.crncy_code = B.crncy_code "
			sv_s = sv_s + "AND A.teller_id = ?SVAR "
			sv_s = sv_s + "AND A.sol_id = ?SVAR "
			sv_s = sv_s + "AND A.denom_value = B.denom_value "
			sv_s = sv_s + "AND A.bank_id = B.bank_id "
			sv_s = sv_s + "AND A.denom_ind = B.denom_ind "
			sv_s = sv_s + "AND A.del_flg = 'N' "
			sv_s = sv_s + "AND A.bank_id = ?SVAR "
			sv_s = sv_s + "AND A.crncy_code = ?SVAR "
			sv_s = sv_s + "AND A.sol_id = B.sol_id "
			sv_s = sv_s + "AND A.teller_id = B.teller_id "
			sv_s = sv_s + "ORDER BY A.Denom_Ind,A.Denom_Value DESC "
			PRINT(sv_s)
			sv_c = urhk_DBCursorOpenWithBind(sv_s)
			IF(sv_c != 0) THEN
			#{
				sv_u = urhk_setOrbOut("Message|F")
				sv_u = urhk_setOrbOut("Details|DataBase Error")
				GOTO FINISH
			#}
			ENDIF
			IF(sv_c == 0) THEN
			#{
				sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				PRINT(sv_m)
				sv_c = urhk_DBCursorFetch(sv_m)
				CUST.DENOM.NoteDenomVal = ""
				CUST.DENOM.CoinDenomVal = ""
				CUST.DENOM.NoteDenomCnt = ""
				CUST.DENOM.CoinDenomCnt = ""
				WHILE(sv_c == 0)
				#{
					IF (BANCS.OUTPARAM.DenomInd == "N") THEN
					#{
						CUST.DENOM.NoteDenomVal = CUST.DENOM.NoteDenomVal + "-" + BANCS.OUTPARAM.DenomValue
						IF(CUST.DENOM.mask == "Y")THEN
						#{
							CUST.DENOM.NoteDenomCnt = CUST.DENOM.NoteDenomCnt + "-" + "M" + BANCS.OUTPARAM.DenomCount
						#}
						ELSE
						#{
							CUST.DENOM.NoteDenomCnt = CUST.DENOM.NoteDenomCnt + "-" + BANCS.OUTPARAM.DenomCount
						#}
						ENDIF
						PRINT(CUST.DENOM.NoteDenomVal)
						PRINT(CUST.DENOM.NoteDenomCnt)
					#}
					ELSE
					#{
						CUST.DENOM.CoinDenomVal  = CUST.DENOM.CoinDenomVal + "-" + BANCS.OUTPARAM.DenomValue
						IF(CUST.DENOM.mask == "Y")THEN
						#{
							CUST.DENOM.CoinDenomCnt  = CUST.DENOM.CoinDenomCnt + "-" + "M" + BANCS.OUTPARAM.DenomCount
						#}
						ELSE
						#{
							CUST.DENOM.CoinDenomCnt  = CUST.DENOM.CoinDenomCnt + "-" + BANCS.OUTPARAM.DenomCount
						#}
						ENDIF
						PRINT(CUST.DENOM.CoinDenomVal)
						PRINT(CUST.DENOM.CoinDenomCnt)
					#}
					ENDIF
					sv_c = urhk_DBCursorFetch(sv_m)
				#}
				DO
				sv_c = urhk_DBCursorClose(sv_m)
				IF(sv_c!=0)THEN
				#{
					sv_u = urhk_setOrbOut("Message|N")
					sv_u = urhk_setOrbOut("Details|DataBase Error")
					GOTO FINISH
				#}
				ENDIF
			#}
			ENDIF
			#--------------------------------------------------------------------------------------
			#	CHECK FOR DUPLICATE CURRENCY  IN CASE OF ADD MODE
			#	CHECK FOR CURRENCY DENOMINATION AVAILABILITY IN CASE OF NON-ADD MODE
			#--------------------------------------------------------------------------------------
			#sv_u=("CUST").("DENOM").("tellerId"+ FORMAT$(sv_p,"%d"))
			#sv_b=("CUST").("DENOM").("solId"+ FORMAT$(sv_p,"%d"))
			IF(FIELDEXISTS(("CUST").("DENOM").("tellerId"+ FORMAT$(sv_p,"%d")))) THEN
			#{
				sv_u = ("CUST").("DENOM").("tellerId"+ FORMAT$(sv_p,"%d"))
			#}
			ELSE
			#{
				sv_u = BANCS.STDIN.EmployeeId
			#}
			ENDIF
			IF(FIELDEXISTS(("CUST").("DENOM").("solId"+ FORMAT$(sv_p,"%d")))) THEN
			#{
				sv_b = ("CUST").("DENOM").("solId"+ FORMAT$(sv_p,"%d"))
			#}
			ELSE
			#{
				sv_b = BANCS.STDIN.mySolId
			#}
			ENDIF
			#--------------------------------------------------------------------------------------
			#		SUCCESS MESSAGE			#
			#--------------------------------------------------------------------------------------
			CUST.DENOM.NoteDenomVal = MID$(CUST.DENOM.NoteDenomVal,1,STRLEN(CUST.DENOM.NoteDenomVal))
			CUST.DENOM.CoinDenomVal = MID$(CUST.DENOM.CoinDenomVal,1,STRLEN(CUST.DENOM.CoinDenomVal))
			CUST.DENOM.NoteDenomCnt = MID$(CUST.DENOM.NoteDenomCnt,1,STRLEN(CUST.DENOM.NoteDenomCnt))
			CUST.DENOM.CoinDenomCnt = MID$(CUST.DENOM.CoinDenomCnt,1,STRLEN(CUST.DENOM.CoinDenomCnt))
			
			sv_u = urhk_setOrbOut("Message|Y")
			sv_u = urhk_setOrbOut("Details|Success")
			sv_t = FORMAT$(sv_p,"%d")
			sv_u = urhk_setOrbOut("Crncy" + sv_t +  "|" + CUST.DENOM.crncy)
			sv_u = urhk_setOrbOut("CrncyDtls" + sv_t +  "|" + CUST.DENOM.CrncyName + "@" + CUST.DENOM.NumOfDecPoints)
			
			PRINT("CrncyDtls" + sv_t +  "|" + CUST.DENOM.crncy + "@" + CUST.DENOM.CrncyName + "@" + CUST.DENOM.NumOfDecPoints)
			
			PRINT("CUST.DENOM.NoteDenomVal"+CUST.DENOM.NoteDenomVal)
			sv_u = urhk_setOrbOut("NoteDenomVal" + sv_t +  "|" + CUST.DENOM.NoteDenomVal)
			PRINT("NoteDenomCnt" + sv_t +  "|" + CUST.DENOM.NoteDenomCnt)
			sv_u = urhk_setOrbOut("NoteDenomCnt" + sv_t +  "|" + CUST.DENOM.NoteDenomCnt)
			IF ((CUST.DENOM.CoinDenomCnt != "") AND (CUST.DENOM.CoinDenomVal != "")) THEN
			#{
				PRINT("CoinDenomVal" + sv_t +  "|" + CUST.DENOM.CoinDenomVal)
				sv_u = urhk_setOrbOut("CoinDenomVal" + sv_t +  "|" + CUST.DENOM.CoinDenomVal)
				PRINT("CoinDenomCnt" + sv_t +  "|" + CUST.DENOM.CoinDenomCnt)
				sv_u = urhk_setOrbOut("CoinDenomCnt" + sv_t +  "|"  + CUST.DENOM.CoinDenomCnt )
				
				#}
			ELSE
				#{
				Print("COIN:" + sv_t)
				sv_u = urhk_setOrbOut("CoinDenomVal" + sv_t + "|0")
				sv_u = urhk_setOrbOut("CoinDenomCnt" + sv_t + "|0")
			#}
			ENDIF
			
			sv_p = sv_p + 1
			print(sv_p)
			print(CINT(CUST.DENOM.CrncyCount))
		#}
		DO
		#-------------------------------------------------------------------
		#	GETTING SETVAR FLAG FROM DB
		#	Y - AMOUNT TO BE ENTERD DIRECTLY, N - DENOM MULTIPLES
		#-------------------------------------------------------------------
		# Commeting not needed in EQUITY/MPCB // MANDAR
		##	CUST.DENOM.moduleName = "DENOM"
		#	#CUST.DENOM.subModuleName = "DENOM"
		#	CUST.DENOM.variableName = "AMOUNT_IND"
		#	BANCS.INPARAM.BINDVARS= CUST.DENOM.moduleName + "|" + CUST.DENOM.subModuleName + "|" + CUST.DENOM.variableName + "|" + CUST.DENOM.bank_id
		#
		#	sv_l = "varValue|"
		#	sv_l = sv_l + "SELECT variable_value "
		#	sv_l = sv_l + "FROM c_svrSetvar "
		#	sv_l = sv_l + "WHERE module_name = ?SVAR and sub_module_name= ?SVAR "
		#	sv_l = sv_l + "AND variable_name = ?SVAR and bank_id = ?SVAR "
		#	print(sv_l)
		#	sv_q = urhk_dbselectWithBind(sv_l)
		#
		#	IF(sv_q!=0) THEN
		#	#{
		#		sv_u = urhk_setOrbOut("Message|F")
		#		sv_u = urhk_setOrbOut("Details|Setvar Setup Missing")
		#		GOTO FINISH
		#	#}
		#	ELSE
		#	#{
		#		CUST.DENOM.setVarFlg = BANCS.OUTPARAM.varValue
		#		print(CUST.DENOM.setVarFlg)
		#		sv_u = urhk_setOrbOut("setVarFlg|" + CUST.DENOM.setVarFlg)
		#	#}
		#	ENDIF
		#	#-------------------------------------------------------------------
		
		sv_u = urhk_setOrbOut("Message|Y")
		sv_u = urhk_setOrbOut("Details|Success")
		#sv_u = urhk_setOrbOut("setVarFlg|N")
		
	FINISH:
		CUST.DENOM.errorFlg="Y"
		EXITSCRIPT
END-->
