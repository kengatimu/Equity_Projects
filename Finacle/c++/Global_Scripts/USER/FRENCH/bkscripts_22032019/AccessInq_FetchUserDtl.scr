#----------------------------------------------------------------------------------------------------------
# Filename              :       AcccesInq_FetchUserDtl.scr
# Author                :       Swati Ganjoo
# Description           :       This script fetches the values required as a part of response
# Input                 :       UserID,EmployeeID,AccessCode,UserWorkClass,EmployeeName,EffectiveWorkClass
#                               EmployeeEmailID etc
# Output                :       None
# Called Script         :       AccessInq_MenuAccessChk.scr,AccessInq_AcctAccessChk.scr,
#                               Common_Interface_ConvertDateToGregorian.scr
# Calling Script        :       AccessInq_main.scr                                                            
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Swati Ganjoo      Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
TRACE ON

                CUST.INTERFACE.cifId=""
                CUST.INTERFACE.custId=""
                CUST.INTERFACE.EmpEmailId =""

	#========================================================	
	# Fetching the details from UPR table
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|"+CUST.INTERFACE.usrEmpId+"|Y|N|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "usrId,usrEmpId,usrWrkCls,solId,usrAcctExpDate,usrPwExpDate,usrAppNam,rolId,usrTempWrkCls,effWrkClass,dbStatDate|"
	sv_s = sv_s + " SELECT USER_ID,USER_EMP_ID,USER_WORK_CLASS,SOL_ID,TO_CHAR(USER_ACCT_EXPY_DATE,'DD-MM-YYYY'),"
	sv_s = sv_s + " TO_CHAR(USER_PW_EXPY_DATE,'DD-MM-YYYY'),USER_APPL_NAME,ROLE_ID,USER_TEMP_WORK_CLASS,"
	sv_s = sv_s + " DECODE(SIGN(DB_STAT_DATE-USER_TMP_WRK_CLASS_EFF_UPTO),"
	sv_s = sv_s + " -1,USER_TEMP_WORK_CLASS,0,USER_TEMP_WORK_CLASS,USER_WORK_CLASS)EFFECTIVE_WORK_CLASS,"
	sv_s = sv_s + " TO_CHAR(DB_STAT_DATE,'DD-MM-YYYY')"
	sv_s = sv_s + " FROM TBAADM.UPR A,TBAADM.GCT B"
	sv_s = sv_s + " WHERE A.USER_ID =?SVAR"
	sv_s = sv_s + " AND A.USER_EMP_ID =?SVAR"
	sv_s = sv_s + " AND A.ENTITY_CRE_FLG =?SVAR"
	sv_s = sv_s + " AND A.DEL_FLG = ?SVAR"
	sv_s = sv_s + " AND B.BANK_ID=?SVAR"

	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0 ) THEN
	#{
		CUST.INTERFACE.usrId 			= BANCS.OUTPARAM.usrId
		CUST.INTERFACE.usrEmpId 		= BANCS.OUTPARAM.usrEmpId
		CUST.INTERFACE.usrWrkCls 		= BANCS.OUTPARAM.usrWrkCls
		CUST.INTERFACE.solId 			= BANCS.OUTPARAM.solId
		CUST.INTERFACE.usrAcctExpDate 	= BANCS.OUTPARAM.usrAcctExpDate
		CUST.INTERFACE.usrPwExpDate 	= BANCS.OUTPARAM.usrPwExpDate
		CUST.INTERFACE.usrAppNam 		= BANCS.OUTPARAM.usrAppNam
		CUST.INTERFACE.rolId 			= BANCS.OUTPARAM.rolId
		CUST.INTERFACE.usrTempWrkCls 	= BANCS.OUTPARAM.usrTempWrkCls
		CUST.INTERFACE.effWrkClass 		= BANCS.OUTPARAM.effWrkClass
		CUST.INTERFACE.dbStatDate 		= BANCS.OUTPARAM.dbStatDate
		
		print(CUST.INTERFACE.usrId)
		print(CUST.INTERFACE.usrEmpId)
		print(CUST.INTERFACE.usrWrkCls)
		print(CUST.INTERFACE.solId)
		print(CUST.INTERFACE.usrAcctExpDate)
		print(CUST.INTERFACE.usrPwExpDate)
		print(CUST.INTERFACE.usrAppNam)
		print(CUST.INTERFACE.rolId)
		print(CUST.INTERFACE.usrTempWrkCls)
		print(CUST.INTERFACE.effWrkClass)
		print(CUST.INTERFACE.dbStatDate)
	#}
	ELSE
	#{
		print("ERROREXIT in fetching details from UPR table")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR016"
		GOTO ERROREXIT
	#}
	ENDIF

        #========================================================
        # Checking access of user for the bank id's
        #========================================================
        BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId+"|N"
        print(BANCS.INPARAM.BINDVARS)
        sv_q = "home_Entity|select home_entity from ssoadm.user_profile_tbl "
        sv_q = sv_q + " where user_id = ?SVAR "
        sv_q = sv_q + " and del_flg = ?SVAR "

        sv_d =  urhk_dbSelectWithBind(sv_q)
        IF (sv_d == 0 ) THEN
        #{
                CUST.INTERFACE.sso_home_entity= BANCS.OUTPARAM.home_Entity

                BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrId
                sv_q = "sso_entity_id|select distinct entity_id from "
                sv_q = sv_q + " ssoadm.SSO_RESOURCE_ACCESS_TBL where user_id = ?SVAR "
                sv_q = sv_q + " and Res_id in ('CRMServer','CoreServer') "

                sv_c = urhk_dbCursorOpenWithBind(sv_q)
                print(sv_c)
                IF(sv_c != 0)THEN
                #{
                        print("ERROREXIT in fetching details from UPR table")
                        CUST.INTERFACE.successOrFailure="F"
                        CUST.INTERFACE.errorCode="ERR016"
                        GOTO ERROREXIT
                #}
		ENDIF
                sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(sv_n)
                sv_f = urhk_dbCursorFetch(sv_n)
                print(sv_f)
                CUST.INTERFACE.sso_entity_list=CUST.INTERFACE.sso_home_entity + ","
                WHILE(sv_f == 0)
                #{
			IF (CUST.INTERFACE.sso_home_entity == BANCS.OUTPARAM.sso_entity_id ) THEN
			#{
				#Home entity is already added 
			#}
			ELSE
			#{
                        CUST.INTERFACE.sso_entity_id=BANCS.OUTPARAM.sso_entity_id
                        print(CUST.INTERFACE.sso_entity_id)
                        CUST.INTERFACE.sso_entity_list = CUST.INTERFACE.sso_entity_list + CUST.INTERFACE.sso_entity_id + ","
			#}
			ENDIF
                        sv_f = urhk_dbCursorFetch(sv_n)
                #}
                DO
                sv_c = urhk_dbCursorClose(sv_n)
        #}
        ELSE
        #{
                CUST.INTERFACE.sso_home_entity=""
                CUST.INTERFACE.sso_entity_list=""
        #}
        ENDIF
        print(CUST.INTERFACE.sso_entity_list)
	
	#========================================================	
	# Fetching the details from GET table
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrEmpId+"|Y|N"
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "empName,EmpEmailId|"
	sv_s = sv_s + " SELECT EMP_NAME,EMP_EMAIL_ID"
	sv_s = sv_s + " FROM TBAADM.GET"
	sv_s = sv_s + " WHERE EMP_ID=?SVAR"
	sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.INTERFACE.empName = BANCS.OUTPARAM.empName
		print(CUST.INTERFACE.empName)
		CUST.INTERFACE.EmpEmailId= BANCS.OUTPARAM.EmpEmailId
		print(CUST.INTERFACE.EmpEmailId)
	#}
	ELSE
	#{
		CUST.INTERFACE.empName=""
		CUST.INTERFACE.EmpEmailId=""
		print("ERROREXIT in fetching employee name")
	#}
	ENDIF
	#========================================================	
	# Fetching the details from SOL table
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.INTERFACE.solId+"|"+BANCS.STDIN.contextBankId+"|N"
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "solDesc,cityCode|"
	sv_s = sv_s + " SELECT SOL_DESC,CITY_CODE"
	sv_s = sv_s + " FROM TBAADM.SOL"
	sv_s = sv_s + " WHERE SOL_ID=?SVAR"
	sv_s = sv_s + " AND BANK_ID =?SVAR"
	sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.INTERFACE.solDesc = BANCS.OUTPARAM.solDesc
		CUST.INTERFACE.cityCode = BANCS.OUTPARAM.cityCode
		print(CUST.INTERFACE.solDesc)
		print(CUST.INTERFACE.cityCode)
	#}
	ELSE
	#{
		print("ERROREXIT in fetching solDesc,cityCode from SOL table")
		CUST.INTERFACE.successOrFailure="F"
		CUST.INTERFACE.errorCode="ERR017"
		GOTO ERROREXIT
	#}
	ENDIF
	#========================================================	
	# Fetching the details from RCT table
	#========================================================
	IF(CUST.INTERFACE.cityCode!="")THEN
	#{
		CUST.INTERFACE.refRecType="01"
		BANCS.INPARAM.BINDVARS=CUST.INTERFACE.refRecType+"|"+CUST.INTERFACE.cityCode+"|"+BANCS.STDIN.contextBankId+"|N"
		print(BANCS.INPARAM.BINDVARS)
		sv_s = "cityDesc|"
		sv_s = sv_s + " SELECT REF_DESC"
		sv_s = sv_s + " FROM TBAADM.RCT"
		sv_s = sv_s + " WHERE REF_REC_TYPE=?SVAR"
		sv_s = sv_s + " AND REF_CODE =?SVAR"
		sv_s = sv_s + " AND BANK_ID =?SVAR"
		sv_s = sv_s + " AND NVL(DEL_FLG, 'N') = ?SVAR"
		print(sv_s)
		sv_d =  urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.INTERFACE.cityDesc = BANCS.OUTPARAM.cityDesc
			print(CUST.INTERFACE.cityDesc)
		#}
		ELSE
		#{
			print("ERROREXIT in fetching cityDesc")
			CUST.INTERFACE.successOrFailure="F"
			CUST.INTERFACE.errorCode="ERR018"
			GOTO ERROREXIT
		#}
		ENDIF
	ELSE
	#{
		CUST.INTERFACE.cityDesc=""
	#}
	ENDIF

	#========================================================
        # Fetching the details from EMRM table
        #========================================================
        BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrEmpId + "|" + "N" + "|" + BANCS.STDIN.contextBankId
        print(BANCS.INPARAM.BINDVARS)
        sv_s = "count|"
        sv_s = sv_s + " SELECT count(1) " 
        sv_s = sv_s + " FROM CRMUSER.ACCOUNTS"
        sv_s = sv_s + " WHERE STAFFEMPLOYEEID =?SVAR"
        sv_s = sv_s + " AND SUSPENDED =?SVAR"
        sv_s = sv_s + " AND BANK_ID =?SVAR"
        print(sv_s)
        sv_d =  urhk_dbSelectWithBind(sv_s)
        print(sv_d)
	if(sv_d == 0)THEN
	#{
		CUST.INTERFACE.count = BANCS.OUTPARAM.count
		print(CUST.INTERFACE.count)
		IF(CUST.INTERFACE.count > 1 ) THEN
		#{
			#Multiple cif id stored
		        print("ERROREXIT Multiple cif id's for the employee")
                        CUST.INTERFACE.successOrFailure="F"
                        CUST.INTERFACE.errorCode="ERR046"
                        GOTO ERROREXIT
		#}
		ENDIF
	#}
        ELSE
        #{
                print("ERROREXIT in fetching EmpEmailId")
                CUST.INTERFACE.cifId=""
                CUST.INTERFACE.custId=""
                CUST.INTERFACE.EmpEmailId =""
        #}
        ENDIF

	
	#========================================================	
	# Fetching the details from EMRM table
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.INTERFACE.usrEmpId + "|" + "N" + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "cifId,EmpEmailId|"
	sv_s = sv_s + " SELECT ORGKEY,EMAIL"
	sv_s = sv_s + " FROM CRMUSER.ACCOUNTS"
	sv_s = sv_s + " WHERE STAFFEMPLOYEEID =?SVAR"
	sv_s = sv_s + " AND SUSPENDED =?SVAR"
	sv_s = sv_s + " AND BANK_ID =?SVAR"
	print(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.INTERFACE.cifId= BANCS.OUTPARAM.cifId
		#CUST.INTERFACE.EmpEmailId= BANCS.OUTPARAM.EmpEmailId
		CUST.INTERFACE.custId     = ""
		print(CUST.INTERFACE.cifId)
		print(CUST.INTERFACE.custId)
	#}
	ELSE
	#{
		print("ERROREXIT in fetching EmpEmailId")
		CUST.INTERFACE.cifId=""
		CUST.INTERFACE.custId=""
		#CUST.INTERFACE.EmpEmailId =""
	#}
	ENDIF	
	#========================================================	
	# Checking Menu level Access
	#========================================================
	IF(CUST.INTERFACE.mopId!="")THEN
	#{
		#========================================================	
		# Calling custom scr for Checking Menu level Access
		#========================================================
		CALL("AccessInq_MenuAccessChk.scr")
	#}
	ENDIF
	#========================================================	
	# Validating the User Access Codes from UAC table for a
	# particular user
	#========================================================
	IF(CUST.INTERFACE.accessCode!="")THEN
	#{
		#========================================================	
		# Calling custom scr for Checking Access Code
		#========================================================
		CALL("AccessInq_AcctAccessChk.scr")
		
	#}
	ENDIF
	#========================================================	
	# Changing the dates to Gregoria format 
	#========================================================
	IF(CUST.INTERFACE.usrAcctExpDate!="")THEN
	#{
		COMMON.INPUT.dateFmt = "DD-MM-YYYY"
		COMMON.INPUT.date = CUST.INTERFACE.usrAcctExpDate
		CALL("Common_Interface_ConvertDateToGregorian.scr")
		CUST.INTERFACE.usrAcctExpDate = COMMON.OUTPUT.outDate
		print(CUST.INTERFACE.usrAcctExpDate)
		
	#}	
	ENDIF
	IF(CUST.INTERFACE.usrPwExpDate!="")THEN
	#{
		COMMON.INPUT.dateFmt = "DD-MM-YYYY"
		COMMON.INPUT.date = CUST.INTERFACE.usrPwExpDate
		CALL("Common_Interface_ConvertDateToGregorian.scr")
		CUST.INTERFACE.usrPwExpDate = COMMON.OUTPUT.outDate
		print(CUST.INTERFACE.usrPwExpDate)
		
	#}
	ENDIF
	IF(CUST.INTERFACE.dbStatDate!="")THEN
	#{
		COMMON.INPUT.dateFmt = "DD-MM-YYYY"
		COMMON.INPUT.date = CUST.INTERFACE.dbStatDate
		CALL("Common_Interface_ConvertDateToGregorian.scr")
		CUST.INTERFACE.dbStatDate = COMMON.OUTPUT.outDate
		print(CUST.INTERFACE.dbStatDate)
		
	#}
	ENDIF
end-->
