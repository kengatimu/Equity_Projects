		print(sv_l)
		print(sv_c)
		#--------------------------------------------------
		#Obtaining the value after the pipe 
		#-------------------------------------------------
		sv_g = MID$(CUST.LAOPN.freeTextp1,sv_c,sv_l)
		print(sv_g)
		CUST.LAOPN.FI = sv_g
		print(CUST.LAOPN.FI)
	#}
	ELSE
	#{
		sv_f = sv_f
		print(sv_f)
	#}
