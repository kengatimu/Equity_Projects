IF ((STRLEN(TRIM(CUST.LAOPN.freeTextp1))) > 0) THEN
#{
	sv_c = getposition(CUST.LAOPN.freeTextp1,"|")
	print(sv_c)

	IF (sv_c != 0) THEN
	#{
		#-------------------------------------------------
		#Obtaining the value before the pipe 
		#-------------------------------------------------
		sv_d = Left$(CUST.LAOPN.freeTextp1,sv_c-1)
		print(sv_d)
