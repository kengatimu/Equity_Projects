		IF (CINT(CUST.LAOPN.forCountsum)>2 ) THEN
			print("Eazzy loan Exist.")
			sv_u = urhk_SRV_SetErr("Eazzy loan Exist......" )
			BANCS.OUTPUT.successOrFailure = "F"
			exitscript
		ENDIF
	ELSE
		IF (BANCS.STDIN.contextBankId=="99") THEN
			IF (CINT(CUST.LAOPN.forCountsum)>0 ) THEN
				print("Eazzy loan Exist.")
				sv_u = urhk_SRV_SetErr("Eazzy loan Exist......" )
				BANCS.OUTPUT.successOrFailure = "F"
				exitscript
