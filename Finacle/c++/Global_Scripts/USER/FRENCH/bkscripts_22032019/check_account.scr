IF ((sv_m=="LA527") OR (sv_m=="FL527")) THEN
	
	IF (sv_m=="LA527") THEN
		sv_k = "forCountsum| select count(foracid) from tbaadm.gam g, tbaadm.cmg c where g.schm_code='LA527'  "
		sv_k = sv_k + " and g.cif_id=c.cif_id and g.bank_id=c.bank_id  and g.bank_id='54' and g.acct_cls_flg='N' and g.clr_bal_amt!='0' "
		sv_k = sv_k + " and g.cif_id=(select cif_id from tbaadm.gam where  foracid=?SVAR and BANK_ID = ?SVAR )   "
