		sv_k = sv_k + " and g.cif_id=c.cif_id and g.bank_id=c.bank_id  and g.bank_id='99' and g.acct_cls_flg='N'  "
		sv_k = sv_k + " and g.cif_id=(select cif_id from tbaadm.gam where  foracid=?SVAR and BANK_ID = ?SVAR )   "
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.uAccount  + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
