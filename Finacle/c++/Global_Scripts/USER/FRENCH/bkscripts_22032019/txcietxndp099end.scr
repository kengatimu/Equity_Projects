<--START
CHECKSUM="cae0df07ea47618ea40870e2c28e243262219deeee90d1cca7d81688d8116ddd"
	TRACE ON
	sv_a = urhk_B2K_PrintRepos("BANCS")
	print(sv_a)

print(CUST.INTERFACE.bankID)
print(CUST.INTERFACE.crAcctID)
print(CUST.CIETXN.refAmt)


CUST.CIETXN.userCRentitya="FIVUSR"
CUST.CIETXN.userCRentitya = CUST.CIETXN.userCRentitya + CUST.INTERFACE.bankID
print(CUST.CIETXN.userCRentitya)


	#------------------------------------------------------------------------
	# Removing Quotes from data from Remote billers
	#------------------------------------------------------------------------
	
	sv_s = "count|select count(1) "
	sv_s = sv_s + " from tbaadm.dtd "
	sv_s = sv_s + " where acid  = (select acid from tbaadm.gam where foracid  = ?SVAR) "
	sv_s = sv_s + " AND  tran_amt = ?SVAR "
	#sv_s = sv_s + " AND  tran_particular like ?SVAR "
	sv_s = sv_s + " AND bank_id  = ?SVAR "
	sv_s = sv_s + " AND TRAN_SUB_TYPE = 'CI'"
	sv_s = sv_s + " AND TRAN_TYPE = 'T'"
	sv_s = sv_s + " AND ENTRY_USER_ID = ?SVAR"
	sv_s = sv_s + " AND tran_date = (select db_stat_date from tbaadm.gct where bank_id = ?SVAR)"
	
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.crAcctID +"|"+ CUST.CIETXN.refAmt +"|"+ CUST.INTERFACE.bankID +"|"+ CUST.CIETXN.userCRentitya +"|"+ CUST.INTERFACE.bankID
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d==0)THEN
	#{
		sv_f = BANCS.OUTPARAM.count
		IF(sv_f != 0) THEN
		#{
			
			sv_s = "syshh,sysrcr,sysmins,rcrmins|select  to_char(sysdate,'hh'), to_char(max(rcre_time),'hh'),to_char(sysdate,'mi') , to_char(max(rcre_time),'mi') "
			sv_s = sv_s + " from tbaadm.dtd "
			sv_s = sv_s + " where acid  = (select acid from tbaadm.gam where foracid  = ?SVAR) "
			sv_s = sv_s + " AND  tran_amt = ?SVAR "
			#sv_s = sv_s + " AND  tran_particular like ?SVAR "
			sv_s = sv_s + " AND bank_id  = ?SVAR "
			sv_s = sv_s + " AND TRAN_SUB_TYPE = 'CI'"
			sv_s = sv_s + " AND TRAN_TYPE = 'T'"
			sv_s = sv_s + " AND ENTRY_USER_ID = ?SVAR"
			sv_s = sv_s + " AND tran_date = (select db_stat_date from tbaadm.gct where bank_id = ?SVAR)"
			
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.crAcctID +"|"+ CUST.CIETXN.refAmt +"|"+ CUST.INTERFACE.bankID +"|"+ CUST.CIETXN.userCRentitya +"|"+ CUST.INTERFACE.bankID
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0)THEN
			#{
				sv_f = BANCS.OUTPARAM.sysmins
				sv_t = BANCS.OUTPARAM.rcrmins
				sv_i = BANCS.OUTPARAM.syshh
				sv_m = BANCS.OUTPARAM.sysrcr
				print(sv_f)
				sv_b = cinT(sv_f)-cint(sv_t)
				sv_c = cinT(sv_f) + 60 - cinT(sv_t)
				print(sv_b)
				print(sv_c)
				print(sv_i)
				print(sv_m)
				
				IF(( sv_b < 10) AND (sv_i == sv_m)) THEN
				#{
					sv_g = "DEST Transaction Already Created in Other Entity for this Cust"
					sv_h = "N"
					IF(sv_h == "N")THEN
					#{
						CUST.CIETXN.scriptSuccess = "N"
						CUST.CIETXN.errorMsgDesc = "DEST Transaction Already Created in Other Entity for this Cust"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					#}
				ELSE
					#{
					sv_g = "No Trans"
					sv_h = "Y"
				#}
				ENDIF
				
				IF((sv_c < 10) AND (sv_i != sv_m)) THEN
				#{
					sv_g = "DEST Transaction Already Created in Other Entity for this Cust"
					sv_h = "N"
					IF(sv_h == "N")THEN
					#{
						CUST.CIETXN.scriptSuccess = "N"
						CUST.CIETXN.errorMsgDesc = "DEST Transaction Already Created in Other Entity for this Cust"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					#}
				ELSE
					#{
					sv_g = "No Trans"
					sv_h = "Y"
				#}
				ENDIF
				
				
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_g = "No Trans"
			sv_h = "Y"
		#}
		ENDIF
		
		
		#}
	ELSE
		#{
		sv_g = "No Trans"
		sv_h = "Y"
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_d = urhk_SetOrbOut("errorFlg|"+ sv_h)
		sv_u = urhk_SetOrbOut("errorMsg|"+sv_g)
		
		
		#trace off
		EXITSCRIPT
END-->
