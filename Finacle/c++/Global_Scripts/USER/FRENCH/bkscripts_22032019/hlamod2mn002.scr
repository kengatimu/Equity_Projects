	ENDOFSCRIPT:
		IF (CUST.HLAMOD2.errMsg != "") THEN
		#{
			CUST.HLAMOD2.calculatedAmt = " "
			sv_s = "Error_01|ERROR:^"+ CUST.HLAMOD2.errMsg +"^fieldName"
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
		#}
		ENDIF
		
		sv_u = urhk_SetOrbOut("calculatedAmt|"+CUST.HLAMOD2.calculatedAmt)
		sv_u = urhk_SetOrbOut("noofDay|"+CUST.HLAMOD2.noofDay)
		sv_u = urhk_SetOrbOut("leapYrAdj|"+CUST.HLAMOD2.leapYrAdj)
		print(sv_u)
		
		EXITSCRIPT
END-->
