			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				print(sv_f)
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				print(sv_e)
				CUST.HLAMOD2.errMsg = CUST.HLAMOD2.errMsg + " !" + sv_e
				sv_g = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				print(sv_e)
				sv_g = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_g)
				sv_i = sv_i + 1
				PRINT(sv_u)
			#}
			DO
		#}
		ENDIF
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (TRIM(CUST.HLAMOD2.balance) != "") THEN
