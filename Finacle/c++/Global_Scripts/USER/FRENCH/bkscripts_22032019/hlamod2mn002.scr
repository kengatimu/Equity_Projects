	sv_s = sv_s + " SELECT GAM.schm_code,GAM.acct_crncy_code,LAM.rep_perd_mths,LAM.rep_perd_days,"
	sv_s = sv_s + " GAM.sanct_lim"
	sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.LAM"
	sv_s = sv_s + " WHERE GAM.foracid = ?SVAR"
	sv_s = sv_s + " AND GAM.bank_id = LAM.bank_id"
	sv_s = sv_s + " AND GAM.acid = LAM.acid"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.HLAMOD2.acctId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d != 0) THEN
	#{
		CUST.HLAMOD2.errMsg = "The account does not exists."
		GOTO ENDOFSCRIPT
		#}
