	########################################################################### 
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		CUST.INTERFACE.srvErrFlg ="Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO ERROREXIT
	#}
	ENDIF

	sv_u = urhk_CopyOutToIn("")

	sv_a = urhk_SetUrhkOut("genChrgCrit.tranId|tranId")
	sv_a = urhk_SetUrhkOut("genChrgCrit.tranDate|tranDate")

	###########################################################################
	# Calling SRV_VerifyGenChrgDtl for Verifying the general charge details
	########################################################################### 
	sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|call_mode = N")

	###########################################################################
