print(CUST.INTERFACE.crAcct)
print(CUST.INTERFACE.actualAmt)
IF(CDOUBLE(CUST.INTERFACE.actualAmt) != CDOUBLE("0")) THEN
#{
	sv_a = urhk_CopyOutToIn("")
	print(sv_a)
	print(CUST.INTERFACE.tranRmks)
