	########################################################################### 

	IF (sv_u != 0) THEN
	#{
		CUST.INTERFACE.srvErrFlg ="Y"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO ERROREXIT
	#}
	ENDIF

	sv_u = urhk_CopyOutToIn("")

	###########################################################################
	# Calling SRV_FetchGenChrgDtlForVerify for charge calculation
	########################################################################### 
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
			
	###########################################################################
	# If service calling fails, then capture the error, exception and warnings
