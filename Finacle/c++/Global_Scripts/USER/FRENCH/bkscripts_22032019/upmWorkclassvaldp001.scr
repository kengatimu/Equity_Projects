#------------------------------------------------------------------------------------------------
#	Name			: upmWorkclassval_dp001.scr 
#	Description		: This script is used for workclass validation in HUPM.
#	Date			: 08-02-2013
#	Author 			: Prakash
#   Input			: NA
#   Outpu			: NA
#   Called			: upmgendet_custom.jsp
#   Calling jsp     : NA 
#   Menu Option     : HUPM
#   Srl. No         Date            Author          Description.
#   ------         ----------      -------         ---------------
#   1.0            08-02-2013       Prakash         Original Version
#-----------------------------------------------------------------------------------------------

<--START
TRACE ON

#------------------------------------------------------------------------------
#   Creating repository and class
#   Initializing the variables
#   Getting all the values from CPARAM
#------------------------------------------------------------------------------

IF (REPEXISTS("CUST") == 0) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","UPR") == 0) THEN
#{
    CREATECLASS("CUST","UPR",5)
#}
ENDIF

CUST.UPR.userWorkClass = ""
CUST.UPR.work_classval10 = ""
CUST.UPR.work_classval12 = ""
CUST.UPR.errMsg = ""

BANCS.INPUT.moduleName = "UPMWORKCLASS" 
BANCS.INPUT.parameterId = "WORK_CLASSVAL10"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)

IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.UPR.work_classval10 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.UPR.errMsg = "CPARAM setup not done for workclss"
	GOTO ENDOFSCRIPT
#}
ENDIF
PRINT(CUST.UPR.work_classval10)

BANCS.INPUT.parameterId = "WORK_CLASSVAL12"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
        CUST.UPR.work_classval12 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.UPR.errMsg = "CPARAM setup not done for workclss"
        GOTO ENDOFSCRIPT
#}
ENDIF
PRINT(CUST.UPR.work_classval12)

CUST.UPR.userWorkClass = BANCS.STDIN.userWorkClass

PRINT(CUST.UPR.userWorkClass)

#----------------------------------------------------------------------------------
# If the workclass is less or equal to 350 
#----------------------------------------------------------------------------------

PRINT(CUST.UPR.userWorkClass)

IF (CINT(CUST.UPR.userWorkClass) <=  CINT(CUST.UPR.work_classval10)) THEN
#{
    sv_b = "status|" +  "P"
    sv_z = urhk_SetOrbOut(sv_b)
#}
ELSE
#{
	sv_b = "status|" + "N"
    sv_z = urhk_SetOrbOut(sv_b)
#}
ENDIF

#----------------------------------------------------------------------------------
# If the workclass is less or equal to 600
# only present in KN to  protect date filed returning status . 
#----------------------------------------------------------------------------------

IF(BANCS.STDIN.contextBankId == "54") THEN
#{
	IF (CINT(CUST.UPR.userWorkClass) < CINT(CUST.UPR.work_classval12)) THEN
	#{
		sv_b = "expfld|" + "Y"
		sv_z = urhk_SetOrbOut(sv_b)
	#}
	ELSE
	#{
		sv_b = "expfld|" + "Z"
		sv_z = urhk_SetOrbOut(sv_b)
	#}
	ENDIF
#}
ELSE
#{
	sv_b = "expfld|" + "Z"
	sv_z = urhk_SetOrbOut(sv_b)
#}
ENDIF



ENDOFSCRIPT:
IF (CUST.UPR.errMsg != "") THEN
#{
	sv_b = "Error|" + CUST.UPR.errMsg
	sv_z = urhk_SetOrbOut(sv_b)
#}
ENDIF

TRACE OFF
EXITSCRIPT
END-->
