		CUST.UPMWC.upmEmpID = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for empID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "WORK_CLASSVAL17"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.work_class17 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for work class"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.UPMWC.work_class17)
	
	BANCS.INPUT.parameterId = "WORK_CLASSVAL18"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.work_class18 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for work class"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.UPMWC.work_class18)
	
	BANCS.INPUT.parameterId = "WORK_CLASSVAL19"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.work_class19 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for work class"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.UPMWC.work_class19)
	
	BANCS.INPUT.parameterId = "WORK_CLASSVAL20"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.work_class20 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for work class"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.UPMWC.work_class20)
	
	BANCS.INPUT.parameterId = "WORK_CLASSVAL21"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.UPMWC.work_class21 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.UPMWC.errMsg = "CPARAM setup not done for work class"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.UPMWC.work_class21)
	
	sv_u = urhk_SRV_GetVal("usrGenDtl.sol.solId")
	PRINT(sv_u)
	CUST.UPMWC.usersolId = BANCS.OUTPARAM.srvValue
	
	CUST.UPMWC.userWorkClass = BANCS.STDIN.userWorkClass
	PRINT(CUST.UPMWC.userWorkClass)
	
	sv_u = urhk_SRV_GetVal("usrGenDtl.tmpWorkClass.refCode")
	PRINT(sv_u)
	CUST.UPMWC.tempworkclass =  BANCS.OUTPARAM.srvValue
	PRINT(CUST.UPMWC.tempworkclass)
	PRINT(CUST.UPMWC.userWorkClass)
	IF (CUST.UPMWC.tempworkclass != "") THEN
	#{
		IF (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.userWorkClass)) THEN
		#{
			CUST.UPMWC.errMsg = "Temp Work Class can not be more than your own workclass"
			PRINT(CUST.UPMWC.errMsg)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_u = urhk_SRV_GetVal("usrGenDtl.workClass.refCode")
		PRINT(sv_u)
		CUST.UPMWC.newUsrClass = BANCS.OUTPARAM.srvValue
		PRINT(CUST.UPMWC.newUsrClass)
		#-----------------------------------------------------------------------------------------
		# 	set limits on different workclasses
		#-----------------------------------------------------------------------------------------
		
		#-----------------------------------------------------------------------------------------
		# If workclass = 050 and temporary workclass > 055
		#-----------------------------------------------------------------------------------------
		
		IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class13)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class2))) THEN
		#{
			CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class2
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
		
		IF((BANCS.STDIN.contextBankId == "54" )  OR (BANCS.STDIN.contextBankId == "55" ) OR (BANCS.STDIN.contextBankId == "50" ) )THEN
		#{
			#-----------------------------------------------------------------------------------------
			# If workclass < 080 and temporary workclass >= 080
			#-----------------------------------------------------------------------------------------
			
			IF ((CINT(CUST.UPMWC.newUsrClass) < CINT(CUST.UPMWC.work_class4)) AND (CINT(CUST.UPMWC.tempworkclass) >= CINT(CUST.UPMWC.work_class4))) THEN
			#{
				CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class4
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		IF((BANCS.STDIN.contextBankId == "11" ) OR (BANCS.STDIN.contextBankId == "56" ) )THEN
		#{
			#-----------------------------------------------------------------------------------------
			# If workclass = 055 and temporary workclass > 080
			#-----------------------------------------------------------------------------------------
			
			IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class2)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class4))) THEN
			#{
				CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class4
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#-----------------------------------------------------------------------------------------
			# If workclass 60 maximum temporary workclass = 110
			#-----------------------------------------------------------------------------------------
			IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class17)) OR (CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class18)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class19))) THEN
			#{
				CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class19
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#-----------------------------------------------------------------------------------------
			# If workclass 70 maximum temporary workclass = 110
			#-----------------------------------------------------------------------------------------
			IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class20)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class19))) THEN
			#{
				CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class19
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF
		
		
		#-----------------------------------------------------------------------------------------
		# If workclass = 075 temporary workclass > 075
		#-----------------------------------------------------------------------------------------
		IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class3)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class3))) THEN
		#{
			CUST.UPMWC.errMsg = "No Temporary Workclass"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-----------------------------------------------------------------------------------------
		# If workclass >= 080 and  < 145
		#-----------------------------------------------------------------------------------------
		
		IF((BANCS.STDIN.contextBankId == "54" )  OR (BANCS.STDIN.contextBankId == "55" ) OR (BANCS.STDIN.contextBankId == "50" ) )THEN
		#{
			IF ((CINT(CUST.UPMWC.newUsrClass) >= CINT(CUST.UPMWC.work_class4)) AND (CINT(CUST.UPMWC.newUsrClass) < CINT(CUST.UPMWC.work_class7))) THEN
			#{
				
				CUST.UPMWC.errMsg = "Temporary Workclass cannot be granted here"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF((BANCS.STDIN.contextBankId == "11" ) OR (BANCS.STDIN.contextBankId == "56")) THEN
		#{
			#-----------------------------------------------------------------------------------------
			# If workclass 080 maximum temporary workclass = 150
			#-----------------------------------------------------------------------------------------
			IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class4)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class8))) THEN
			#{
				
				CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class8
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#-----------------------------------------------------------------------------------------
			# If workclass 085 maximum temporary workclass = 110
			#-----------------------------------------------------------------------------------------
			IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class21)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class19))) THEN
			#{
				
				CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class19
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#-----------------------------------------------------------------------------------------
			# If workclass 110 maximum temporary workclass = 150
			#-----------------------------------------------------------------------------------------
			IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class19)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class8))) THEN
			#{
				
				CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " + CUST.UPMWC.work_class8
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		
		#-----------------------------------------------------------------------------------------
		# If workclass  = 90 or 100 or 150 and  temporary workclass > 200
		#-----------------------------------------------------------------------------------------
		
		IF (((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class6)) OR (CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class5)) OR (CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class8))) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class9))) THEN
		#{
			CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " +  CUST.UPMWC.work_class9
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-----------------------------------------------------------------------------------------
		# If workclass = 200 and temporary workclass > 360
		#-----------------------------------------------------------------------------------------
		
		IF ((CINT(CUST.UPMWC.newUsrClass) == CINT(CUST.UPMWC.work_class9)) AND (CINT(CUST.UPMWC.tempworkclass) > CINT(CUST.UPMWC.work_class11))) THEN
		#{
			CUST.UPMWC.errMsg = "Maximum Temporary Workclass cannot exceed " +  CUST.UPMWC.work_class11
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	#-----------------------------------------------------------------------------------------
	# Temp workclass effective date validation
	#-----------------------------------------------------------------------------------------
	
	sv_u = urhk_SRV_GetVal("usrGenDtl.tmpWorkClassEffUpto")
	PRINT(sv_u)
	CUST.UPMWC.eff_upto_date = BANCS.OUTPARAM.srvValue
	PRINT(BANCS.STDIN.BODDate)
	PRINT(CUST.UPMWC.eff_upto_date)
	BANCS.INPARAM.date1 = CUST.UPMWC.eff_upto_date
	BANCS.INPARAM.date2 = BANCS.STDIN.BODDate
	
	IF (STRLEN(CUST.UPMWC.eff_upto_date) != 0) THEN
	#{
		sv_e = urhk_B2k_dateDiff("")
		PRINT(BANCS.OUTPARAM.dateDiff)
		IF (CINT(BANCS.OUTPARAM.dateDiff) >= CINT(CUST.UPMWC.work_class1)) THEN
		#{
			CUST.UPMWC.errMsg = "Temp Work Class - Effective upto date - should be less than " +  CUST.UPMWC.work_class1 + " Days from today"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.UPMWC.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.UPMWC.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
