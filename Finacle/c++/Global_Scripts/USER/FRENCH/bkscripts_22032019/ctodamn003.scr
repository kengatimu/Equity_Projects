	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CTODA.accNum + "|N"
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "reqId,contractId,accName,netTodAmount,remarks,grantDate,expDate|"
	sv_s = sv_s + " SELECT REQUEST_ID,SANCT_ID,ACCT_NAME,REQ_AMT,REMARKS,to_char(GRANT_DATE,'dd-mm-yyyy'),to_char(EXPIRY_DATE,'dd-mm-yyyy')"
	sv_s = sv_s + " FROM CUSTOM.C_TODA "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR "
