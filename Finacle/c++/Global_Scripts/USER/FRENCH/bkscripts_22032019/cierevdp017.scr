	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rateCode.refCode|"+CUST.CIEREV.rateCode_1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rate|"+CUST.CIEREV.rate_1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refNum|"+CUST.CIEREV.refNo_1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranCode.refCode|"+CUST.CIEREV.tranPartCode_1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+CUST.CIEREV.tranParticular_1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+CUST.CIEREV.tranRmks_1)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRate|"+CUST.CIEREV.treaRate_1)
	IF(CUST.CIEREV.treaRefNum_1 != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRefNum|"+CUST.CIEREV.treaRefNum_1)
	#}
	ENDIF
	
	###########################################################################################
	# Credit Leg
	###########################################################################################
	
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|00002")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|"+CUST.CIEREV.partTranType_2)
