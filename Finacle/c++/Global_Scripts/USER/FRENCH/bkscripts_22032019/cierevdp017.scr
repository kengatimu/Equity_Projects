	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.CIEREV.refAmt_2+"|"+ CUST.CIEREV.refCrncy_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.CIEREV.foracid_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rateCode.refCode|"+CUST.CIEREV.rateCode_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rate|"+CUST.CIEREV.rate_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|"+CUST.CIEREV.refNo_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranCode.refCode|"+CUST.CIEREV.tranPartCode_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+CUST.CIEREV.tranParticular_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+CUST.CIEREV.tranRmks_2)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.treaRate|"+CUST.CIEREV.treaRate_2)
	IF(CUST.CIEREV.treaRefNum_2 != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRefNum|"+CUST.CIEREV.treaRefNum_2)
	#}
	ENDIF
	
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
	
	IF(CUST.CIEREV.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#}
	ELSE
		#{
		sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			print(sv_u)
			
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			
			sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
