		PRINT(CUST.CASIGLS.appId)
		sv_s =" UPDATE CUSTOM.C_EQBK "
		sv_s = sv_s + " SET end_time = SYSDATE,processed_flg = 'Y' "
		sv_s = sv_s + " WHERE app_id = ?SVAR "
		sv_s = sv_s + " AND mod_code = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.CASIGLS.appId + "|" + CUST.CASIGLS.modCode1
		PRINT(sv_s)
		sv_d = urhk_dbSQLWithBind (sv_s)
		PRINT(sv_d)
		PRINT(BANCS.OUTPARAM.DB_ERRCODE)
		
		###---------------------------------------------------------------------#######
		## commit CUSTOM.C_EQBK Table            ##
		###---------------------------------------------------------------------#######
		sv_d = urhk_dbSQLWithBind("commit")
		PRINT(sv_d)
		
	QUITSCRIPT:
