<--start
TRACE ON
#-------------------------------------------------------------------------------------------------
# Selecting credit Account Id and account name for cheque
#-------------------------------------------------------------------------------------------------
BANCS.INPARAM.BINDVARS = CUST.INTERFACE.ZoneID + "|" + CUST.INTERFACE.ZoneDate
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.TranID
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.bankId
print(BANCS.INPARAM.BINDVARS)
sv_s = "foracid,acctName|"
sv_s = sv_s + " SELECT g.FORACID,g.ACCT_NAME"
sv_s = sv_s + " FROM TBAADM.OCP a, TBAADM.GAM g, TBAADM.OCI i "
sv_s = sv_s + " WHERE i.CLG_ZONE_CODE = ?SVAR "
sv_s = sv_s + " AND i.CLG_ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') "
sv_s = sv_s + " AND i.FREETEXT2 = ?SVAR "
sv_s = sv_s + " AND i.BANK_ID = ?SVAR "
sv_s = sv_s + " AND a.SET_NUM = i.SET_NUM "
sv_s = sv_s + " AND a.CLG_ZONE_CODE = i.CLG_ZONE_CODE "
sv_s = sv_s + " AND a.BANK_ID = i.BANK_ID "
sv_s = sv_s + " AND g.ACID = a.ACID "
sv_s = sv_s + " AND g.BANK_ID = a.BANK_ID "
print(sv_s)
sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)
IF (sv_c != 0) THEN
#{
	# throwing error
	# Cheque not Lodged
	CUST.INTERFACE.successOrFailure = "F"
	CUST.INTERFACE.errorCode = "ERR104"
	GOTO ERROREXIT
#}
ENDIF
CUST.INTERFACE.cursorNumber= BANCS.OUTPARAM.DB_CURSOR_NUMBER
print(CUST.INTERFACE.cursorNumber)
# Fetch data in a loop and assign it to output
sv_c = urhk_dbCursorFetch(CUST.INTERFACE.cursorNumber)
print(sv_c)
IF (sv_c != 0) THEN
#{
	# throwing error
	# Cheque not Lodged
	CUST.INTERFACE.successOrFailure = "F"
	CUST.INTERFACE.errorCode = "ERR104"
	GOTO ERROREXIT
#}
ENDIF
sv_c = urhk_dbCursorClose(CUST.INTERFACE.cursorNumber)
print(sv_c)
# WHILE OF CURSOR IS WITTEN IN SCRIPT ChqReconInq_SendResponse.scr 
# WHICH WILL SEND THE DATA IN THE RESPONSE XML.
EXITSCRIPT
end-->
