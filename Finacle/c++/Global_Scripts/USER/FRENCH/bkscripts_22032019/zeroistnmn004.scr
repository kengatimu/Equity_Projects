			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			PRINT(sv_u)
			IF(sv_u != 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
	#}
