		#}
	ELSE
		#{
		CUST.IPOL.rate = "1"
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Getting  amount
	#------------------------------------------------------------------------------
	
	sv_s = "clearBalance,acctCrncyCode |SELECT clr_bal_amt,acct_crncy_code "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.IPOL.brAcct
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		
		CUST.IPOL.bal = BANCS.OUTPARAM.clearBalance
		IF (CDOUBLE(CUST.IPOL.bal) == 0) THEN
		#{
			EXITSCRIPT
		#}
		ENDIF
		PRINT(CUST.IPOL.bal)
		
		CUST.IPOL.dbAcctCrncy = BANCS.OUTPARAM.acctCrncyCode
		
		IF (CDOUBLE(CUST.IPOL.bal) < 0) THEN
		#{
			CUST.IPOL.bal = ( CDOUBLE(CUST.IPOL.bal) * -1 )
			CUST.IPOL.crdr0 = "D"
			CUST.IPOL.crdr1 = "C"
			#}
		ELSE
			#{
			CUST.IPOL.crdr0 = "C"
			CUST.IPOL.crdr1 = "D"
		#}
		ENDIF
	#}
	ELSE
		#{
		CUST.IPOL.bal = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctCrncyCode |SELECT acct_crncy_code "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.IPOL.hoAcct
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.acctCrncyCode)
		CUST.IPOL.crAcctCrncy = BANCS.OUTPARAM.acctCrncyCode
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	CUST.IPOL.tranAmt = CUST.IPOL.bal
	
	#---------------------------------------------------------------
	# Passing transaction inputs to the service
	# Adding and Posting the transaction
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|" + CUST.IPOL.tranRmks)
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	
	sv_w = "tranDtl.partTranDetailLL.<rec_0>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|1")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|" + CUST.IPOL.crdr0)
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.IPOL.hoAcct)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.IPOL.crParticulars)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks|" + CUST.IPOL.tranRmks)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum|" + CUST.IPOL.crRefNum)
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.IPOL.tranAmt+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.IPOL.tranAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.IPOL.rateCode)
	
	sv_w = "tranDtl.partTranDetailLL.<rec_1>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|2")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|" + CUST.IPOL.crdr1)
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.IPOL.brAcct)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.IPOL.dbParticulars)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks|"+CUST.IPOL.tranRmks)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum|" + CUST.IPOL.dbRefNum)
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.IPOL.tranAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.IPOL.tranAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.IPOL.rateCode)
	
	
	sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
	PRINT(sv_u)
	IF(sv_u != 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
