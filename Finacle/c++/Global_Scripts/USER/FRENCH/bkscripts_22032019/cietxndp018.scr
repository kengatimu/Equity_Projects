<--START
CHECKSUM="01c0110155daaa5b661ebc6f9d3014b2df913057d0cc8c3c27c2785cf7436197"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.targetEntity = " "
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.targetEntityDesc = " "
	
	
	
	IF(FIELDEXISTS(BANCS.INPUT.targetEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.targetEntity) != "")THEN
		#{
			CUST.CIETXN.targetEntity = TOUPPER(TRIM(BANCS.INPUT.targetEntity))
			print(CUST.CIETXN.targetEntity)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "targetEntity,targetEntityDesc|"
	sv_s = sv_s + " SELECT BANK_ID,GROUP_DESC"
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.targetEntity
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.targetEntity = BANCS.OUTPARAM.targetEntity
		print(CUST.CIETXN.targetEntity)
		CUST.CIETXN.targetEntityDesc = BANCS.OUTPARAM.targetEntityDesc
		print(CUST.CIETXN.targetEntityDesc)
		
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Invalid Entity ID"
	#}
	ENDIF
	
	CUST.CIETXN.targetEntityDesc = TOUPPER(CUST.CIETXN.targetEntityDesc)
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetEntity|"+CUST.CIETXN.targetEntity)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetEntityDesc|"+CUST.CIETXN.targetEntityDesc)
		print(sv_u)
		
		
END-->
