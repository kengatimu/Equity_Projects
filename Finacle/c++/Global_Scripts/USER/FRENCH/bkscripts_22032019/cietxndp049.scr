<--START
CHECKSUM="1dae4f6febd2754cfaa54c37abc5cb4bc972679e322fa95c8b1a4780d6fc2767"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	sv_u = urhk_b2k_printrepos("BANCS")
	
	CUST.CIETXN.ieTxnRefNo = " "
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.ieTxnRefNo))THEN
	#{
		IF(TRIM(BANCS.INPUT.ieTxnRefNo) != "")THEN
		#{
			CUST.CIETXN.ieTxnRefNo = TOUPPER(TRIM(BANCS.INPUT.ieTxnRefNo))
			print(CUST.CIETXN.ieTxnRefNo)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to generate Receipt"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "timeStamp|select to_char(sysdate,'ddmmyyyyhhmiss') from dual" 
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.timeStamp = BANCS.OUTPARAM.timeStamp
		print(CUST.CIETXN.timeStamp)
	#}
	ENDIF
	
	sv_p = urhk_B2k_PID("")
	IF(sv_p == 0 ) THEN
	#{
		CUST.CIETXN.Rpid = "cietxn_receipt_"+TRIM(BANCS.OUTPARAM.PID)
		CUST.CIETXN.Rpid = CUST.CIETXN.Rpid + CUST.CIETXN.timeStamp
		PRINT(CUST.CIETXN.Rpid)
		#}
	ELSE
		#{
		CUST.CIETXN.Rpid = "123"
		PRINT(CUST.CIETXN.Rpid)
	#}
	ENDIF
	
	CUST.CIETXN.lst = "cietxn_receipt_"+TRIM(BANCS.OUTPARAM.PID)
	CUST.CIETXN.lst = CUST.CIETXN.lst + CUST.CIETXN.timeStamp +".lst"
	print(CUST.CIETXN.lst)
	CUST.CIETXN.sucRptName = "CIETXN_RECEIPT_"+TRIM(BANCS.OUTPARAM.PID)
	CUST.CIETXN.sucRptName = CUST.CIETXN.sucRptName + CUST.CIETXN.timeStamp
	print(CUST.CIETXN.sucRptName)
	sv_s = "touch "+ CUST.CIETXN.lst
	PRINT(sv_s)
	sv_o = SYSTEM(sv_s)
	PRINT(sv_o)
	
	#sv_s = "> cietxn_receipt.lst"
	#print(sv_s)
	#sv_o = system(sv_s)
	#print(sv_o)
	
	##############################################################################
	# Fetch Data from custom table using ieTxnRefNo
	##############################################################################
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.ieTxnRefNo + "|" + MID$(BANCS.STDIN.BODDate,0,10)+ "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_s = "tranType,tranSubType,initId,targetId,entity1TranId,entity1TranDate,entity2TranId,entity2TranDate,"
	sv_s = sv_s + "crAcctId,drAcctId,refAmt,refCrncy,rateCode,rate,tranAmt,tranCrncyCode,chargeAmt,"
	sv_s = sv_s + "chargeCrncyCode,refNo,nostroAcct,vostroAcct,instrmntAlpha,instrmntDate,instrmntNum,instrmntType|"
	sv_s = sv_s + "SELECT TRAN_TYPE,TRAN_SUB_TYPE,INIT_ENTITY_ID,TARGET_ENTITY_ID,ENTITY1_TRAN_ID,to_char(ENTITY1_TRAN_DATE,'DD-MM-YYYY'),"
	sv_s = sv_s + "ENTITY2_TRAN_ID,to_char(ENTITY2_TRAN_DATE,'DD-MM-YYYY'),CR_ACCOUNT_ID,DR_ACCOUNT_ID,REF_AMT,REF_CRNCY_CODE,RATE_CODE,RATE,"
	sv_s = sv_s + "TRAN_AMT,TRAN_CRNCY_CODE,CHARGE_AMT,CHARGE_CRNCY_CODE,REF_NO,NOSTRO_ACCOUNT_ID,VOSTRO_ACCOUNT_ID,INSTRMNT_ALPHA,INSTRMNT_DATE,"
	sv_s = sv_s + "INSTRMNT_NUM,INSTRMNT_TYPE "
	sv_s = sv_s + "FROM CUSTOM.IETD "
	sv_s = sv_s + "WHERE IE_TXN_REF_NO = ?SVAR "
	sv_s = sv_s + "AND NVL(entity1_tran_date,charge_Tran_Date) = to_date(?SVAR,'dd-mm-yyyy') "
	sv_s = sv_s + "AND init_entity_id = ?SVAR"
	
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.tranType = BANCS.OUTPARAM.tranType
		print(CUST.CIETXN.tranType)
		
		CUST.CIETXN.tranSubType = BANCS.OUTPARAM.tranSubType
		print(CUST.CIETXN.tranSubType)
		
		CUST.CIETXN.entity1TranId = BANCS.OUTPARAM.entity1TranId
		print(CUST.CIETXN.entity1TranId)
		
		CUST.CIETXN.entity1TranDate = BANCS.OUTPARAM.entity1TranDate
		print(CUST.CIETXN.entity1TranDate)
		
		CUST.CIETXN.entity2TranId = BANCS.OUTPARAM.entity2TranId
		print(CUST.CIETXN.entity2TranId)
		
		CUST.CIETXN.entity2TranDate = BANCS.OUTPARAM.entity2TranDate
		print(CUST.CIETXN.entity2TranDate)
		
		CUST.CIETXN.crAcctId = BANCS.OUTPARAM.crAcctId
		print(CUST.CIETXN.crAcctId)
		
		CUST.CIETXN.drAcctId = BANCS.OUTPARAM.drAcctId
		print(CUST.CIETXN.drAcctId)
		
		CUST.CIETXN.refAmt = BANCS.OUTPARAM.refAmt
		print(CUST.CIETXN.refAmt)
		
		CUST.CIETXN.refCrncy = BANCS.OUTPARAM.refCrncy
		print(CUST.CIETXN.refCrncy)
		
		CUST.CIETXN.rateCode = BANCS.OUTPARAM.rateCode
		print(CUST.CIETXN.rateCode)
		
		CUST.CIETXN.rate = BANCS.OUTPARAM.rate
		print(CUST.CIETXN.rate)
		
		CUST.CIETXN.tranAmt = BANCS.OUTPARAM.tranAmt
		print(CUST.CIETXN.tranAmt)
		
		CUST.CIETXN.tranCrncyCode = BANCS.OUTPARAM.tranCrncyCode
		print(CUST.CIETXN.tranCrncyCode)
		
		CUST.CIETXN.nostroAcct = BANCS.OUTPARAM.nostroAcct
		print(CUST.CIETXN.nostroAcct)
		
		CUST.CIETXN.vostroAcct = BANCS.OUTPARAM.vostroAcct
		print(CUST.CIETXN.vostroAcct)
		
		CUST.CIETXN.initId = BANCS.OUTPARAM.initId
		print(CUST.CIETXN.initId)
	#}
	ENDIF
	
	###########################################################################################
	# Create lst File - Data Fields in sync with ofti.mri
	###########################################################################################
	
	IF(CUST.CIETXN.tranType == "C")THEN
	#{
		IF((CUST.CIETXN.tranSubType == "NR") OR (CUST.CIETXN.tranSubType == "RI"))THEN
		#{
			CUST.CIETXN.foracid = CUST.CIETXN.crAcctId
			CUST.CIETXN.tranDate = CUST.CIETXN.entity1TranDate
			CUST.CIETXN.tranAmt = FORMAT$(CDOUBLE(CUST.CIETXN.refAmt),"%.2f")
			CUST.CIETXN.tranCrncyCode = CUST.CIETXN.refCrncy
			CUST.CIETXN.tran_id = CUST.CIETXN.ieTxnRefNo
			CUST.CIETXN.acct_name = ""
			CUST.CIETXN.acid = ""
			sv_s = "acct_name,acid|"
			sv_s = sv_s + " SELECT ACCT_NAME,ACID"
			sv_s = sv_s + " FROM TBAADM.GAM "
			sv_s = sv_s + " WHERE FORACID = ?SVAR"
			sv_s = sv_s + " AND DEL_FLG != 'Y'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.crAcctId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				CUST.CIETXN.acct_name = BANCS.OUTPARAM.acct_name
				PRINT(CUST.CIETXN.acct_name)
				CUST.CIETXN.acid = BANCS.OUTPARAM.acid
				PRINT(CUST.CIETXN.acid)
			#}
			ENDIF
			
			CUST.CIETXN.tranType = "C"
			CUST.CIETXN.tranSubType = "NR"
			CUST.CIETXN.partTranType = "C"
			CUST.CIETXN.nostroAcctAcid = ""
			sv_s = CUST.CIETXN.nostroAcct
			sv_u = urhk_B2k_ForacidToAcid(sv_s)
			print(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				PRINT(BANCS.OUTPARAM.Acid)
				CUST.CIETXN.nostroAcctAcid = BANCS.OUTPARAM.Acid
				PRINT(CUST.CIETXN.nostroAcctAcid)
			#}
			ENDIF
			
			CUST.CIETXN.tranparticulars = ""
			CUST.CIETXN.posted_user_id = ""
			sv_s = "tranparticulars,posted_user_id|"
			sv_s = sv_s + " SELECT TRAN_PARTICULAR,PSTD_USER_ID"
			sv_s = sv_s + " FROM TBAADM.DTD "
			sv_s = sv_s + " WHERE ACID = ?SVAR"
			sv_s = sv_s + " AND TRAN_ID = ?SVAR"
			sv_s = sv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
			sv_s = sv_s + " AND ROWNUM = 1"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.nostroAcctAcid + "|" + CUST.CIETXN.entity1TranId + "|" + CUST.CIETXN.entity1TranDate
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				CUST.CIETXN.tranparticulars = BANCS.OUTPARAM.tranparticulars
				PRINT(CUST.CIETXN.tranparticulars)
				CUST.CIETXN.posted_user_id = BANCS.OUTPARAM.posted_user_id
				PRINT(CUST.CIETXN.posted_user_id)
			#}
			ENDIF
			
			CALL("cietxndp050.scr")
			sv_s = "echo '" + CUST.CIETXN.outRecord + "'  >> "+CUST.CIETXN.lst
			print(sv_s)
			sv_o = SYSTEM(sv_s)
			print(sv_o)
			GOTO PRINT_RECEIPT
		#}
		ENDIF
		
		IF((CUST.CIETXN.tranSubType == "NP") OR (CUST.CIETXN.tranSubType == "PI"))THEN
		#{
			CUST.CIETXN.foracid = CUST.CIETXN.drAcctId
			CUST.CIETXN.tranDate = CUST.CIETXN.entity1TranDate
			CUST.CIETXN.tranAmt = FORMAT$(CDOUBLE(CUST.CIETXN.refAmt),"%.2f")
			CUST.CIETXN.tranCrncyCode = CUST.CIETXN.refCrncy
			CUST.CIETXN.tran_id = CUST.CIETXN.ieTxnRefNo
			CUST.CIETXN.acct_name = ""
			CUST.CIETXN.acid = ""
			sv_s = "acct_name,acid|"
			sv_s = sv_s + " SELECT ACCT_NAME,ACID"
			sv_s = sv_s + " FROM TBAADM.GAM "
			sv_s = sv_s + " WHERE FORACID = ?SVAR"
			sv_s = sv_s + " AND DEL_FLG != 'Y'"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.drAcctId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				CUST.CIETXN.acct_name = BANCS.OUTPARAM.acct_name
				PRINT(CUST.CIETXN.acct_name)
				CUST.CIETXN.acid = BANCS.OUTPARAM.acid
				PRINT(CUST.CIETXN.acid)
			#}
			ENDIF
			
			CUST.CIETXN.tranType = "C"
			CUST.CIETXN.tranSubType = "NP"
			CUST.CIETXN.partTranType = "D"
			CUST.CIETXN.nostroAcctAcid = ""
			sv_s = CUST.CIETXN.nostroAcct
			sv_u = urhk_B2k_ForacidToAcid(sv_s)
			print(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				PRINT(BANCS.OUTPARAM.Acid)
				CUST.CIETXN.nostroAcctAcid = BANCS.OUTPARAM.Acid
				PRINT(CUST.CIETXN.nostroAcctAcid)
			#}
			ENDIF
			
			CUST.CIETXN.tranparticulars = ""
			CUST.CIETXN.posted_user_id = ""
			sv_s = "tranparticulars,posted_user_id|"
			sv_s = sv_s + " SELECT TRAN_PARTICULAR,PSTD_USER_ID"
			sv_s = sv_s + " FROM TBAADM.DTD "
			sv_s = sv_s + " WHERE ACID = ?SVAR"
			sv_s = sv_s + " AND TRAN_ID = ?SVAR"
			sv_s = sv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
			sv_s = sv_s + " AND ROWNUM = 1"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.nostroAcctAcid + "|" + CUST.CIETXN.entity1TranId + "|" + CUST.CIETXN.entity1TranDate
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				CUST.CIETXN.tranparticulars = BANCS.OUTPARAM.tranparticulars
				PRINT(CUST.CIETXN.tranparticulars)
				CUST.CIETXN.posted_user_id = BANCS.OUTPARAM.posted_user_id
				PRINT(CUST.CIETXN.posted_user_id)
			#}
			ENDIF
			
			CALL("cietxndp050.scr")
			sv_s = "echo '" + CUST.CIETXN.outRecord + "'  >> "+CUST.CIETXN.lst
			print(sv_s)
			sv_o = SYSTEM(sv_s)
			print(sv_o)
			GOTO PRINT_RECEIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.CIETXN.tranType == "T")THEN
	#{
		#---------------------------------------------------------------------
		# Credit Part Tran
		#---------------------------------------------------------------------
		CUST.CIETXN.foracid = CUST.CIETXN.crAcctId
		CUST.CIETXN.tranDate = CUST.CIETXN.entity1TranDate
		CUST.CIETXN.tranAmt = FORMAT$(CDOUBLE(CUST.CIETXN.tranAmt),"%.2f")
		CUST.CIETXN.tranCrncyCode = CUST.CIETXN.tranCrncyCode
		CUST.CIETXN.tran_id = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.acct_name = ""
		CUST.CIETXN.acid = ""
		CUST.CIETXN.crAcctEntityId = ""
		sv_s = "acct_name,acid,crAcctEntityId|"
		sv_s = sv_s + " SELECT ACCT_NAME,ACID,BANK_ID"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE FORACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.crAcctId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.acct_name = BANCS.OUTPARAM.acct_name
			PRINT(CUST.CIETXN.acct_name)
			CUST.CIETXN.acid = BANCS.OUTPARAM.acid
			PRINT(CUST.CIETXN.acid)
			CUST.CIETXN.crAcctEntityId = BANCS.OUTPARAM.crAcctEntityId
			PRINT(CUST.CIETXN.crAcctEntityId)
		#}
		ENDIF
		
		CUST.CIETXN.tranType = "T"
		CUST.CIETXN.tranSubType = "CI"
		CUST.CIETXN.partTranType = "C"
		CUST.CIETXN.tmpAcid = ""
		IF((CUST.CIETXN.initId == BANCS.STDIN.contextBankId) AND (CUST.CIETXN.crAcctEntityId == BANCS.STDIN.contextBankId))THEN
		#{
			sv_s = CUST.CIETXN.nostroAcct
			CUST.CIETXN.tmpTranId = CUST.CIETXN.entity1TranId
			PRINT(CUST.CIETXN.tmpTranId)
			CUST.CIETXN.tmpTranDate = CUST.CIETXN.entity1TranDate
			PRINT(CUST.CIETXN.tmpTranDate)
			#}
		ELSE
			#{
			sv_s = CUST.CIETXN.vostroAcct
			CUST.CIETXN.tmpTranId = CUST.CIETXN.entity2TranId
			PRINT(CUST.CIETXN.tmpTranId)
			CUST.CIETXN.tmpTranDate = CUST.CIETXN.entity2TranDate
			PRINT(CUST.CIETXN.tmpTranDate)
		#}
		ENDIF
		
		lv_s = "tmpAcid|SELECT ACID FROM TBAADM.GAM WHERE FORACID = ?SVAR"
		print(lv_s)
		
		BANCS.INPARAM.BINDVARS = sv_s
		print(BANCS.INPARAM.BINDVARS)
		
		lv_d = urhk_dbSelectWithBind(lv_s)
		print(lv_d)
		
		IF(lv_d == 0)THEN
		#{
			CUST.CIETXN.tmpAcid = BANCS.OUTPARAM.tmpAcid
			PRINT(CUST.CIETXN.tmpAcid)
		#}
		ENDIF
		
		CUST.CIETXN.tranparticulars = ""
		CUST.CIETXN.posted_user_id = ""
		sv_s = "tranparticulars,posted_user_id|"
		sv_s = sv_s + " SELECT TRAN_PARTICULAR,PSTD_USER_ID"
		sv_s = sv_s + " FROM TBAADM.DTD "
		sv_s = sv_s + " WHERE ACID = ?SVAR"
		sv_s = sv_s + " AND TRAN_ID = ?SVAR"
		sv_s = sv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " AND ROWNUM = 1"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.tmpAcid + "|" + CUST.CIETXN.tmpTranId + "|" + CUST.CIETXN.tmpTranDate
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.tranparticulars = BANCS.OUTPARAM.tranparticulars
			PRINT(CUST.CIETXN.tranparticulars)
			CUST.CIETXN.posted_user_id = BANCS.OUTPARAM.posted_user_id
			PRINT(CUST.CIETXN.posted_user_id)
			#}
		ELSE
			#{
			IF((CUST.CIETXN.initId == BANCS.STDIN.contextBankId) AND (CUST.CIETXN.crAcctEntityId == BANCS.STDIN.contextBankId))THEN
			#{
				CUST.CIETXN.tranparticulars = "CREDIT TRANSFER THRU " + MID$(BANCS.STDIN.homeCrncyCode,0,2) + " - " + BANCS.STDIN.mySolDesc
				#}
			ELSE
				#{
				CUST.CIETXN.tranparticulars = "DEBIT TRANSFER THRU " + MID$(BANCS.STDIN.homeCrncyCode,0,2) + " - " + BANCS.STDIN.mySolDesc
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = "tranAmt,tranCrncyCode|"
		sv_s = sv_s + " SELECT TRAN_AMT,TRAN_CRNCY_CODE"
		sv_s = sv_s + " FROM TBAADM.DTD "
		sv_s = sv_s + " WHERE ACID = ?SVAR"
		sv_s = sv_s + " AND TRAN_ID = ?SVAR"
		sv_s = sv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " AND ROWNUM = 1"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.acid + "|" + CUST.CIETXN.tmpTranId + "|" + CUST.CIETXN.tmpTranDate
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.tranAmt = BANCS.OUTPARAM.tranAmt
			PRINT(CUST.CIETXN.tranAmt)
			CUST.CIETXN.tranCrncyCode = BANCS.OUTPARAM.tranCrncyCode
			PRINT(CUST.CIETXN.tranCrncyCode)
			
			CUST.CIETXN.tranAmt = FORMAT$(CDOUBLE(CUST.CIETXN.tranAmt),"%.2f")
			PRINT(CUST.CIETXN.tranAmt)
		#}
		ENDIF
		
		CALL("cietxndp050.scr")
		sv_s = "echo '" + CUST.CIETXN.outRecord + "'  >> "+CUST.CIETXN.lst
		print(sv_s)
		sv_o = SYSTEM(sv_s)
		print(sv_o)
		
		#---------------------------------------------------------------------
		# Debit Part Tran
		#---------------------------------------------------------------------
		
		CUST.CIETXN.foracid = CUST.CIETXN.drAcctId
		CUST.CIETXN.tranDate = CUST.CIETXN.entity1TranDate
		CUST.CIETXN.tranAmt = FORMAT$(CDOUBLE(CUST.CIETXN.tranAmt),"%.2f")
		CUST.CIETXN.tranCrncyCode = CUST.CIETXN.tranCrncyCode
		CUST.CIETXN.tran_id = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.acct_name = ""
		CUST.CIETXN.acid = ""
		CUST.CIETXN.drAcctEntityId = ""
		sv_s = "acct_name,acid,drAcctEntityId|"
		sv_s = sv_s + " SELECT ACCT_NAME,ACID,BANK_ID"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE FORACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.drAcctId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.acct_name = BANCS.OUTPARAM.acct_name
			PRINT(CUST.CIETXN.acct_name)
			CUST.CIETXN.acid = BANCS.OUTPARAM.acid
			PRINT(CUST.CIETXN.acid)
			CUST.CIETXN.drAcctEntityId = BANCS.OUTPARAM.drAcctEntityId
			PRINT(CUST.CIETXN.drAcctEntityId)
		#}
		ENDIF
		
		CUST.CIETXN.tranType = "T"
		CUST.CIETXN.tranSubType = "CI"
		CUST.CIETXN.partTranType = "D"
		CUST.CIETXN.tmpAcid = ""
		IF((CUST.CIETXN.initId == BANCS.STDIN.contextBankId) AND (CUST.CIETXN.drAcctEntityId == BANCS.STDIN.contextBankId))THEN
		#{
			sv_s = CUST.CIETXN.nostroAcct
			CUST.CIETXN.tmpTranId = CUST.CIETXN.entity1TranId
			PRINT(CUST.CIETXN.tmpTranId)
			CUST.CIETXN.tmpTranDate = CUST.CIETXN.entity1TranDate
			PRINT(CUST.CIETXN.tmpTranDate)
			#}
		ELSE
			#{
			sv_s = CUST.CIETXN.vostroAcct
			CUST.CIETXN.tmpTranId = CUST.CIETXN.entity2TranId
			PRINT(CUST.CIETXN.tmpTranId)
			CUST.CIETXN.tmpTranDate = CUST.CIETXN.entity2TranDate
			PRINT(CUST.CIETXN.tmpTranDate)
		#}
		ENDIF
		
		lv_s = "tmpAcid|SELECT ACID FROM TBAADM.GAM WHERE FORACID = ?SVAR"
		print(lv_s)
		
		BANCS.INPARAM.BINDVARS = sv_s
		print(BANCS.INPARAM.BINDVARS)
		
		lv_d = urhk_dbSelectWithBind(lv_s)
		print(lv_d)
		
		IF(lv_d == 0)THEN
		#{
			CUST.CIETXN.tmpAcid = BANCS.OUTPARAM.tmpAcid
			PRINT(CUST.CIETXN.tmpAcid)
		#}
		ENDIF
		
		CUST.CIETXN.tranparticulars = ""
		CUST.CIETXN.posted_user_id = ""
		sv_s = "tranparticulars,posted_user_id|"
		sv_s = sv_s + " SELECT TRAN_PARTICULAR,PSTD_USER_ID"
		sv_s = sv_s + " FROM TBAADM.DTD "
		sv_s = sv_s + " WHERE ACID = ?SVAR"
		sv_s = sv_s + " AND TRAN_ID = ?SVAR"
		sv_s = sv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " AND ROWNUM = 1"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.tmpAcid + "|" + CUST.CIETXN.tmpTranId + "|" + CUST.CIETXN.tmpTranDate
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.tranparticulars = BANCS.OUTPARAM.tranparticulars
			PRINT(CUST.CIETXN.tranparticulars)
			CUST.CIETXN.posted_user_id = BANCS.OUTPARAM.posted_user_id
			PRINT(CUST.CIETXN.posted_user_id)
			
			CUST.CIETXN.posted_user_id = BANCS.STDIN.userId
			PRINT(CUST.CIETXN.posted_user_id)
			#}
		ELSE
			#{
			IF((CUST.CIETXN.initId == BANCS.STDIN.contextBankId) AND (CUST.CIETXN.drAcctEntityId == BANCS.STDIN.contextBankId))THEN
			#{
				CUST.CIETXN.tranparticulars = "CREDIT TRANSFER THRU " + MID$(BANCS.STDIN.homeCrncyCode,0,2) + " - " + BANCS.STDIN.mySolDesc
				#}
			ELSE
				#{
				CUST.CIETXN.tranparticulars = "DEBIT TRANSFER THRU " + MID$(BANCS.STDIN.homeCrncyCode,0,2) + " - " + BANCS.STDIN.mySolDesc
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = "tranAmt,tranCrncyCode|"
		sv_s = sv_s + " SELECT TRAN_AMT,TRAN_CRNCY_CODE"
		sv_s = sv_s + " FROM TBAADM.DTD "
		sv_s = sv_s + " WHERE ACID = ?SVAR"
		sv_s = sv_s + " AND TRAN_ID = ?SVAR"
		sv_s = sv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " AND ROWNUM = 1"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.acid + "|" + CUST.CIETXN.tmpTranId + "|" + CUST.CIETXN.tmpTranDate
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.tranAmt = BANCS.OUTPARAM.tranAmt
			PRINT(CUST.CIETXN.tranAmt)
			CUST.CIETXN.tranCrncyCode = BANCS.OUTPARAM.tranCrncyCode
