			CUST.CIETXN.tranAmt = FORMAT$(CDOUBLE(CUST.CIETXN.tranAmt),"%.2f")
			PRINT(CUST.CIETXN.tranAmt)
		#}
		ENDIF
		
		CALL("cietxndp050.scr")
		sv_s = "echo '" + CUST.CIETXN.outRecord + "'  >> "+CUST.CIETXN.lst
		print(sv_s)
		sv_o = SYSTEM(sv_s)
		print(sv_o)
		
		GOTO PRINT_RECEIPT
		
	#}
	ENDIF
	
	PRINT_RECEIPT:
		#sv_s = "exebatch mrbx4004 $B2K_SESSION_ID cietxn_ofti1.mrt cietxn_receipt.lst CIETXN_RECEIPT"
