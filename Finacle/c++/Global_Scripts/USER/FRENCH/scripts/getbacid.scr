#-------------------------------------------------------------------------------------    
#    Name			    : getbacid.scr
#    Description     	: This script is used for generating report for given account number's bacid , reference number details.
#    Date            	: 11-01-2013
#    Author          	: Rajavel
#    Input           	: BANCS.INPUT.lv_foracid,BANCS.INPUT.lv_tranid,BANCS.INPUT.lv_srlnum,BANCS.INPUT.tranAmt
#    Output			    : BANCS.OUTPUT.lv_bacid ,BANCS.OUTPUT.refnum ,BANCS.OUTPUT.Noshares
#    Called Script	 	: NA
#    Calling Script	 	: NA
#    Menu Option		: NA
#    Srl. No		   Date		    Author			Description.
#    -------		----------		------			----------------
#    1.0		    11-01-2013		Rajavel	 	    Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="1e3cece042cd75779327844d1019dc84af0fc43970b832f56397e392b291f5d6"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","REPTS") == 0) THEN
	#{
		CREATECLASS("CUST","REPTS",5)
	#}
	ENDIF
	
	CUST.REPTS.errMsg = ""
	
	BANCS.OUTPUT.lv_bacid = ""
	BANCS.OUTPUT.refnum = ""
	
	sv_a = BANCS.INPUT.lv_foracid
	sv_b = BANCS.INPUT.lv_tranid
	sv_c = BANCS.INPUT.lv_srlnum
	sv_d = BANCS.INPUT.tranAmt
	
	BANCS.INPUT.moduleName  = "REPORTS"
	BANCS.INPUT.parameterId = "NUM1"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.REPTS.num1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.REPTS.errMsg = "NUM1 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "NUM2"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.REPTS.num2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.REPTS.errMsg = "NUM2 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# getting Bacid
	#------------------------------------------------------------------------------
	
	sv_w = urhk_getAcctDetailsInRepository(sv_a)
	PRINT(sv_w)
	IF (sv_w == 0) THEN
	#{
		BANCS.OUTPUT.lv_bacid = BANCS.OUTPARAM.acctPlaceHolder
		PRINT(BANCS.OUTPUT.lv_bacid)
		#}
	ELSE
		#{
		BANCS.OUTPUT.lv_bacid = ""
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# getting ref num
	#------------------------------------------------------------------------------
	
	sv_s = "ref|SELECT ref_num "
	sv_s  = sv_s +  "FROM TBAADM.DTD "
	sv_s  = sv_s +  "WHERE tran_id = ?SVAR "
	sv_s  = sv_s +  "AND part_tran_srl_num = ?SVAR "
	sv_s  = sv_s +  "AND bank_id = ?SVAR "
	sv_s  = sv_s +  "AND del_flg = 'N' "
	sv_s  = sv_s +  "AND tran_date =  TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS')"
	BANCS.INPARAM.BINDVARS = sv_b + "|" + sv_c + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.BODDate
	PRINT (sv_s)
	sv_r = urhk_dbselectWithBind(sv_s)
	PRINT(sv_r)
	IF ( sv_r == 0 ) THEN
	#{
		BANCS.OUTPUT.refnum = BANCS.OUTPARAM.ref
		PRINT(BANCS.OUTPUT.refnum)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# getting No of Shares
	#------------------------------------------------------------------------------
	PRINT(CUST.REPTS.num1)
	sv_d = CINT(BANCS.INPUT.tranAmt)- CINT(CUST.REPTS.num1)
	sv_e = CUST.REPTS.num2
	PRINT(sv_d)
	sv_f = sv_d/CDOUBLE(sv_e)
	PRINT(sv_f)
	BANCS.OUTPUT.Noshares = sv_f
	
	ENDOFSCRIPT:
		IF (CUST.REPTS.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUST.REPTS.errMsg+"' >>Reports.log")
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
