#----------------------------------------------------------------------------------------------------------
# Filename              :       ctodadp010.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to get new value from TOD sequence(CUSTOM.AVAIL_SEQ_GEN)
#                               in Add mode.
# Input                 :       None
# Output                :       New Availment request Id
# Called Script         :       None
# Calling Script        :       ctodadp005.scr
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           21-04-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------

<--START
CHECKSUM="8c47baea4105e78b49a2d6af1bfc59b82156e822e061d7d5bdf13b5ffc7d424a"
	TRACE ON
	#------------------------------------------------------------------------------
	# Getting availment Request Id from sequence CUSTOM.AVAIL_SEQ_GEN.
	#------------------------------------------------------------------------------
	sv_v = 1
	WHILE (sv_v < 10000000)
	#{
		print(sv_v)
		sv_s = "availReqId| SELECT LPAD(CUSTOM.AVAIL_SEQ_GEN.NEXTVAL,7,0) FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d != 0)THEN
		#{
			CUST.INTERFACE.errorCode = "CTODA_ERR_014"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
			CUST.CTODA.fieldName = "abc"
			CUST.CTODA.successFlg = "F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CTODA.availReqId = BANCS.OUTPARAM.availReqId
			print(CUST.CTODA.availReqId)
		#}
		ENDIF
		#------------------------------------------------------------------------------
		# Query to check that new Sequence value for availment Request Id(REQUEST_ID)
		# created already exist in table CUSTOM.C_TODA or not.
		#------------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = CUST.CTODA.availReqId
		sv_s =  "availReqIdCount|SELECT COUNT(REQUEST_ID) "
		sv_s = sv_s + " FROM CUSTOM.C_TODA "
		sv_s = sv_s + " WHERE REQUEST_ID = ?SVAR"
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0) THEN
		#{
			CUST.CTODA.availReqIdCount = BANCS.OUTPARAM.availReqIdCount
			print(CUST.CTODA.availReqIdCount)
		#}
		ENDIF
		IF (CUST.CTODA.availReqIdCount == "0") THEN
		#{
			CUST.CTODA.successFlg = "S"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF (sv_v == 9999999) THEN
		#{
			CUST.INTERFACE.errorCode = "CTODA_ERR_015"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.CTODA.errorMsg = CUST.INTERFACE.errorDesc
			CUST.CTODA.fieldName = "abc"
			CUST.CTODA.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		sv_v = sv_v + 1
	#}
	DO
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
