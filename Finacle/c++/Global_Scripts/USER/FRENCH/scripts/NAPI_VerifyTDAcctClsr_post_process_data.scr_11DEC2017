<--START
	# Script body goes here
	
	TRACE ON
	#----------------------------------------------------------------------------------------
	#Checking whether Required Classes exists.If not THEN create that class
	#-----------------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "ACCT") == 0) THEN
	#{
		CREATECLASS("CUST", "ACCT", 5)
	#}
	ENDIF
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	
	#----------------------------------------------------------------------------------------
	##Check the TDA account has the schm type of TDA and schm code of TD407
	#----------------------------------------------------------------------------------------
	
	CUST.ACCT.tdAccountF = BANCS.INPUT.tdAccount
	CUST.ACCT.CnorIntAmt = BANCS.INPUT.norIntAmt
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.tdAccount
	
	sv_s = "count|SELECT 1 FROM GAM WHERE del_flg !=  'Y' AND ENTITY_CRE_FLG='Y' "
	sv_s= sv_s +"AND bank_id =?SVAR AND foracid=?SVAR AND schm_code='TD407'"
	
	sv_d = urhk_dbSelectwithbind(sv_s)
	IF (sv_d == 0) THEN
	#{
		
		CUST.ACCT.count = BANCS.OUTPARAM.count
		PRINT(CUST.ACCT.count)
		
		#----------------------------------------------------------------------------------------
		##Check if there is a debit interest adjustment from the TDA account in DTT and check the amount
		#----------------------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.tdAccount
		
		sv_s = "wtaxFlg,wtaxPcnt,TDAacid,acctCrncy,tdsBacid,accSolId,nrmIntPdBacid,intPayblBacid|SELECT gam.WTAX_FLG,gam.WTAX_PCNT,gam.acid, "
		sv_s = sv_s + " gam.acct_crncy_code,TDS_BACID,sol_id, INT_PANDL_BACID_CR,INT_PAID_BACID "
		sv_s = sv_s + " FROM tbaadm.GAM,tbaadm.csp,tbaadm.gsp WHERE gam.del_flg !=  'Y' AND gam.ENTITY_CRE_FLG='Y' "
		sv_s = sv_s + " AND gam.bank_id =?SVAR AND foracid=?SVAR "
		sv_s = sv_s + " AND gam.schm_code='TD407' "
		sv_s = sv_s + " AND gam.bank_id=csp.bank_id "
		sv_s = sv_s + " AND gam.bank_id=gsp.bank_id "
		sv_s = sv_s + " AND gam.schm_code = csp.schm_code "
		sv_s = sv_s + " AND gam.schm_code = gsp.schm_code "
		sv_s = sv_s + " AND gam.acct_crncy_code= csp.crncy_code "
		
		sv_d = urhk_dbSelectwithbind(sv_s)
		
		IF (sv_d == 0) THEN
		#{
			
			CUST.ACCT.wtaxFlg = BANCS.OUTPARAM.wtaxFlg
			PRINT(CUST.ACCT.wtaxFlg)
			CUST.ACCT.wtaxPcnt = BANCS.OUTPARAM.wtaxPcnt
			PRINT(CUST.ACCT.wtaxPcnt)
			CUST.ACCT.TDAacid = BANCS.OUTPARAM.TDAacid
			PRINT(CUST.ACCT.TDAacid)
			CUST.ACCT.acctCrncy = BANCS.OUTPARAM.acctCrncy
			PRINT(CUST.ACCT.acctCrncy)
			CUST.ACCT.tdsBacid = BANCS.OUTPARAM.tdsBacid
			PRINT(CUST.ACCT.tdsBacid)
			CUST.ACCT.accSolId = BANCS.OUTPARAM.accSolId
			PRINT(CUST.ACCT.accSolId)
			CUST.ACCT.nrmIntPdBacid = BANCS.OUTPARAM.nrmIntPdBacid
			PRINT(CUST.ACCT.nrmIntPdBacid)
			CUST.ACCT.intPayblBacid = BANCS.OUTPARAM.intPayblBacid
			PRINT(CUST.ACCT.intPayblBacid)
			
			#}
			
			IF(CUST.ACCT.wtaxFlg=="W") THEN
			#{
				#----------------------------------------------------------------------------------------
				##Check if there is a debit interest adjustment from the TDA account in DTT and check the amount
				#----------------------------------------------------------------------------------------
				
				
				
				BANCS.INPARAM.BINDVARS = CUST.ACCT.TDAacid + "|" + BANCS.STDIN.contextBankId
				
				sv_s = "wrngAmt,wTrnDt,repayAcid,payblAcid|select  dtt.tran_amt,dtt.tran_date,REPAYMENT_ACID,dctd_acli.acid "
				sv_s = sv_s + " from tbaadm.dtt, tbaadm.tam,tbaadm.dctd_acli "
				sv_s = sv_s + " where dtt.acid=?SVAR AND dtt.tran_rmks='Debiting TD Account' AND dtt.part_tran_type='D' "
				sv_s = sv_s + " AND tam.acid=dtt.acid "
				sv_s = sv_s + " AND dtt.bank_id=?SVAR "
				sv_s = sv_s + " AND dtt.tran_id=dctd_acli.tran_id "
				sv_s = sv_s + " AND dtt.tran_date=dctd_acli.tran_date "
				sv_s = sv_s + " AND tam.bank_id=dtt.bank_id "
				sv_s = sv_s + " AND tam.bank_id=dctd_acli.bank_id "
				sv_s = sv_s + " AND dctd_acli.part_tran_type='C'"
				
				sv_d = urhk_dbSelectwithbind(sv_s)
				IF (sv_d == 0) THEN
				#{
					
					CUST.ACCT.wrngAmt = BANCS.OUTPARAM.wrngAmt
					PRINT(CUST.ACCT.wrngAmt)
					CUST.ACCT.wTrnDt = BANCS.OUTPARAM.wTrnDt
					PRINT(CUST.ACCT.wTrnDt)
					CUST.ACCT.repayAcid = BANCS.OUTPARAM.repayAcid
					PRINT(CUST.ACCT.repayAcid)
					CUST.ACCT.payblAcid = BANCS.OUTPARAM.payblAcid
					PRINT(CUST.ACCT.payblAcid)
					
					
					#----------------------------------------------------------------------------------------
					###Reversing the posted amount  from the Payable account to repayment account
					#----------------------------------------------------------------------------------------
					BANCS.INPARAM.BINDVARS = CUST.ACCT.repayAcid + "|" + BANCS.STDIN.contextBankId
					#fetching the foracid
					sv_y = ""
					sv_y =	sv_y + "C_ForacidCr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where acid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.crForacid = BANCS.OUTPARAM.C_ForacidCr
						PRINT(CUST.ACCT.crForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					BANCS.INPARAM.BINDVARS = CUST.ACCT.payblAcid + "|" + BANCS.STDIN.contextBankId
					sv_y = ""
					sv_y =	sv_y + "C_ForacidDr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where acid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.drForacid = BANCS.OUTPARAM.C_ForacidDr
						PRINT(CUST.ACCT.drForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					
					CUST.ACCT.tranAmt=CUST.ACCT.wrngAmt
					CUST.ACCT.tranCrncy=CUST.ACCT.acctCrncy
					CUST.ACCT.tran_particular = "REV PRINCIPAL -" + CUST.ACCT.tdAccountF
					PRINT(CUST.ACCT.tranAmt)
					PRINT(CUST.ACCT.tranCrncy)
					PRINT(CUST.ACCT.crForacid)
					PRINT(CUST.ACCT.drForacid)
					
					#calling MTT for posting the wrong amount reversal
					CALL("cust_post_mtt.scr")
					
					#----------------------------------------------------------------------------------------
					####End of principal reversal
					#----------------------------------------------------------------------------------------
					
					#----------------------------------------------------------------------------------------
					###Reversing the posted amount  from the Paid account to Payable account
					#----------------------------------------------------------------------------------------
					BANCS.INPARAM.BINDVARS = CUST.ACCT.payblAcid + "|" + BANCS.STDIN.contextBankId
					#fetching the foracid
					sv_y = ""
					sv_y =	sv_y + "C_ForacidCr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where acid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.crForacid = BANCS.OUTPARAM.C_ForacidCr
						PRINT(CUST.ACCT.crForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					BANCS.INPARAM.BINDVARS = CUST.ACCT.nrmIntPdBacid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ACCT.accSolId  + "|" +  CUST.ACCT.acctCrncy
					#fetching the foracid
					sv_y = ""
					sv_y =	sv_y + "C_ForacidDr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where bacid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					sv_y =  sv_y + " AND sol_id = ?SVAR AND acct_crncy_code = ?SVAR"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.drForacid = BANCS.OUTPARAM.C_ForacidDr
						PRINT(CUST.ACCT.drForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					
					CUST.ACCT.tranAmt=CUST.ACCT.wrngAmt
					CUST.ACCT.tranCrncy=CUST.ACCT.acctCrncy
					CUST.ACCT.tran_particular = "REV BOOKING -" + CUST.ACCT.tdAccountF
					PRINT(CUST.ACCT.tranAmt)
					PRINT(CUST.ACCT.tranCrncy)
					PRINT(CUST.ACCT.crForacid)
					PRINT(CUST.ACCT.drForacid)
					
					#calling MTT for posting the wrong amount reversal
					CALL("cust_post_mtt.scr")
					
					#----------------------------------------------------------------------------------------
					####End of principal reversal for BOOKING TRAN
					#----------------------------------------------------------------------------------------
					
					#----------------------------------------------------------------------------------------
					###Posting correct booking entry from the Paid account to Payable account
					#----------------------------------------------------------------------------------------
					BANCS.INPARAM.BINDVARS = CUST.ACCT.payblAcid + "|" + BANCS.STDIN.contextBankId
					#fetching the foracid
					sv_y = ""
					sv_y =	sv_y + "C_ForacidCr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where acid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.crForacid = BANCS.OUTPARAM.C_ForacidCr
						PRINT(CUST.ACCT.crForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					BANCS.INPARAM.BINDVARS = CUST.ACCT.nrmIntPdBacid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ACCT.accSolId  + "|" +  CUST.ACCT.acctCrncy
					#fetching the foracid
					sv_y = ""
					sv_y =	sv_y + "C_ForacidDr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where bacid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					sv_y =  sv_y + " AND sol_id = ?SVAR AND acct_crncy_code = ?SVAR"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.drForacid = BANCS.OUTPARAM.C_ForacidDr
						PRINT(CUST.ACCT.drForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					
					CUST.ACCT.tranAmt=CUST.ACCT.CnorIntAmt
					CUST.ACCT.tranCrncy=CUST.ACCT.acctCrncy
					CUST.ACCT.tran_particular = "CORR BOOKING -" + CUST.ACCT.tdAccountF
					PRINT(CUST.ACCT.tranAmt)
					PRINT(CUST.ACCT.tranCrncy)
					PRINT(CUST.ACCT.crForacid)
					PRINT(CUST.ACCT.drForacid)
					
					#calling MTT for posting the wrong amount reversal
					CALL("cust_post_mtt.scr")
					
					#----------------------------------------------------------------------------------------
					####End of posting correct BOOKING TRAN
					#----------------------------------------------------------------------------------------
					
					#----------------------------------------------------------------------------------------
					### Calculate TDS and post
					#----------------------------------------------------------------------------------------
					PRINT(CUST.ACCT.wtaxFlg)
					PRINT(CUST.ACCT.wtaxPcnt)
					PRINT(CUST.ACCT.TDAacid)
					PRINT(CUST.ACCT.acctCrncy)
					PRINT(CUST.ACCT.tdsBacid)
					PRINT(CUST.ACCT.accSolId)
					
					sv_t = (CDOUBLE(CUST.ACCT.CnorIntAmt) * CDOUBLE(CUST.ACCT.wtaxPcnt))/100
					PRINT(sv_t)
					CUST.ACCT.TDSAmt = sv_t
					PRINT(CUST.ACCT.TDSAmt)
					
					BANCS.INPARAM.BINDVARS = CUST.ACCT.tdsBacid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ACCT.accSolId  + "|" +  CUST.ACCT.acctCrncy
					#fetching the foracid
					sv_y = ""
					sv_y =	sv_y + "C_ForacidCr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where bacid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					sv_y =  sv_y + " AND sol_id = ?SVAR AND acct_crncy_code = ?SVAR"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.crForacid = BANCS.OUTPARAM.C_ForacidCr
						PRINT(CUST.ACCT.crForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					BANCS.INPARAM.BINDVARS = CUST.ACCT.payblAcid + "|" + BANCS.STDIN.contextBankId
					sv_y = ""
					sv_y =	sv_y + "C_ForacidDr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where acid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLG='N' AND del_flg='N'"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.drForacid = BANCS.OUTPARAM.C_ForacidDr
						PRINT(CUST.ACCT.drForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					
					CUST.ACCT.tranAmt=CUST.ACCT.TDSAmt
					CUST.ACCT.tranCrncy=CUST.ACCT.acctCrncy
					CUST.ACCT.tran_particular = "TDS TRAN -" + CUST.ACCT.tdAccountF
					
					PRINT(CUST.ACCT.tranAmt)
					PRINT(CUST.ACCT.tranCrncy)
					PRINT(CUST.ACCT.crForacid)
					PRINT(CUST.ACCT.drForacid)
					
					#calling MTT for posting the TDS component
					CALL("cust_post_mtt.scr")
					
					#----------------------------------------------------------------------------------------
					####End of TDS posting
					#----------------------------------------------------------------------------------------
					
					#----------------------------------------------------------------------------------------
					### Calculate INT amount and post
					#----------------------------------------------------------------------------------------
					
					PRINT(CUST.ACCT.TDSAmt)
					PRINT(CUST.ACCT.CnorIntAmt)
					
					CUST.ACCT.IntPostAmt = CDOUBLE(CUST.ACCT.CnorIntAmt) - CDOUBLE(CUST.ACCT.TDSAmt)
					PRINT(CUST.ACCT.IntPostAmt)
					
					
					
					BANCS.INPARAM.BINDVARS = CUST.ACCT.repayAcid + "|" + BANCS.STDIN.contextBankId
					#fetching the foracid
					sv_y = ""
					sv_y =	sv_y + "C_ForacidCr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where acid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.crForacid = BANCS.OUTPARAM.C_ForacidCr
						PRINT(CUST.ACCT.crForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					BANCS.INPARAM.BINDVARS = CUST.ACCT.payblAcid + "|" + BANCS.STDIN.contextBankId
					sv_y = ""
					sv_y =	sv_y + "C_ForacidDr"
					sv_y =	sv_y + " | select foracid from tbaadm.gam where acid=?SVAR"
					sv_y =  sv_y + " AND bank_id = ?SVAR AND Acct_CLS_FLg='N' AND del_flg='N'"
					PRINT(sv_y)
					sv_f = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_f)
					IF (sv_f == 0) THEN
					#{
						
						CUST.ACCT.drForacid = BANCS.OUTPARAM.C_ForacidDr
						PRINT(CUST.ACCT.drForacid)
						
						#}
					ELSE
						#{
						PRINT("no records found")
					#}
					ENDIF
					
					CUST.ACCT.tranAmt=CUST.ACCT.IntPostAmt
					CUST.ACCT.tranCrncy=CUST.ACCT.acctCrncy
					CUST.ACCT.tran_particular = "INT TRAN POSTING -" + CUST.ACCT.tdAccountF
					PRINT(CUST.ACCT.tranAmt)
					PRINT(CUST.ACCT.tranCrncy)
					PRINT(CUST.ACCT.crForacid)
					PRINT(CUST.ACCT.drForacid)
					
					#calling MTT for posting the interest amount
					CALL("cust_post_mtt.scr")
					
					
					#----------------------------------------------------------------------------------------
					####End of INT posting
					#----------------------------------------------------------------------------------------
					#}
				ELSE
					#{
					PRINT("EXITING as No wrong amount posted")
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				
				#}
			ELSE
				#{
				#repeat above logic without the TDS part
				##going to end of script as for bank's case all accounts have TDS
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF
		#}
	ELSE
		#{
		
		#----------------------------------------------------------------------------------------
		##Exiting script as the posting logic is only applicable to TD407
		#----------------------------------------------------------------------------------------
		
		PRINT("The TDA is not of TD407 scheme code")
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
END-->
