		#{
		CUST.CMILGSP.schmType  = BANCS.OUTPARAM.srvValue
		print(CUST.CMILGSP.schmType)
	#}
	ENDIF
	
	#========================================================
	# Selecting the entity cre flag and del flg from
	# main table to insert it in mod table
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.CMILGSP.schmType+"|"+CUST.CMILGSP.schmCode+"|MILGSP|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "entityCreFlg,delFlg|"
	sv_s = sv_s + " SELECT ENTITY_CRE_FLG,DEL_FLG"
	sv_s = sv_s + " FROM CUSTOM.C_WTH_GSP_DET"
	sv_s = sv_s + " WHERE SCHM_TYPE =?SVAR"
	sv_s = sv_s + " AND SCHM_CODE =?SVAR"
	sv_s = sv_s + " AND MOP_ID =?SVAR"
	sv_s = sv_s + " AND BANK_ID =?SVAR"
	PRINT(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.CMILGSP.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		PRINT(CUST.CMILGSP.entityCreFlg)
		CUST.CMILGSP.delFlg = BANCS.OUTPARAM.delFlg
		PRINT(CUST.CMILGSP.delFlg)
		IF((CUST.CMILGSP.delFlg=="N") AND (CUST.CMILGSP.entityCreFlg=="N"))THEN
		#{
			GOTO MAINTABLEUPDATE
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CMILGSP.errorFlg = "Y"
		#CUST.CMILGSP.errorMsg ="Select query failed"
		CUST.CGSP.errorCode="ERR_003"
		CALL("whtdp028.scr")
		CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
		CUST.CMILGSP.errorFocus="prodCode"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#========================================================
	# Checking if the record exists in MOD table.
	#========================================================
	BANCS.INPARAM.BINDVARS=CUST.CMILGSP.schmType+"|"+CUST.CMILGSP.schmCode+"|MILGSP|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "count1|"
	sv_s = sv_s + " SELECT COUNT(1)"
	sv_s = sv_s + " FROM CUSTOM.C_WTH_GSP_DET_MOD"
	sv_s = sv_s + " WHERE SCHM_TYPE =?SVAR"
	sv_s = sv_s + " AND SCHM_CODE =?SVAR"
	sv_s = sv_s + " AND MOP_ID =?SVAR"
	sv_s = sv_s + " AND BANK_ID =?SVAR"
	PRINT(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0 ) THEN
	#{
		CUST.CMILGSP.count1 = BANCS.OUTPARAM.count1
		PRINT(CUST.CMILGSP.count1)
		IF(CUST.CMILGSP.count1=="0")THEN
		#{
			GOTO MODTABLEINSERT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CMILGSP.errorFlg = "Y"
		#CUST.CMILGSP.errorMsg ="Select query failed"
		CUST.CGSP.errorCode="ERR_003"
		CALL("whtdp028.scr")
		CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
		CUST.CMILGSP.errorFocus="prodCode"
