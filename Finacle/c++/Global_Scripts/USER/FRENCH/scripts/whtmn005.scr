		CREATEREP ("CUST")
	#}
	ENDIF
	#========================================================
	# Check whether CMILGSP Class exists else create it
	#========================================================
	sv_r = CLASSEXISTS("CUST","CMILGSP")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CMILGSP",5)
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","CGSP")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CGSP",5)
	#}
	ENDIF
	CUST.CMILGSP.errorFlg="N"
	
	#========================================================
	# Getting the modified data in script
	#========================================================
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	#sv_r = urhk_B2k_PrintRepos("ONS")
	#PRINT(sv_r)
	IF(FIELDEXISTS(ONS.CUSTOM.custDataIn))THEN
	#{
		PRINT(ONS.CUSTOM.custDataIn)
		PRINT(STRLEN(ONS.CUSTOM.custDataIn))
		sv_u = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)
		IF(sv_u == 0)THEN
		#{
			IF(FIELDEXISTS(BANCS.INPUT.milgspschdet1_FIELD_1))THEN
			#{
				CUST.CMILGSP.wthTaxPcnt = TOUPPER(BANCS.INPUT.milgspschdet1_FIELD_1)
				PRINT(CUST.CMILGSP.wthTaxPcnt)
			#}
			ENDIF
			
			IF(FIELDEXISTS(BANCS.INPUT.milgspschdet1_FIELD_2))THEN
			#{
				CUST.CMILGSP.bacid= TOUPPER(TRIM(BANCS.INPUT.milgspschdet1_FIELD_2))
				PRINT(CUST.CMILGSP.bacid)
				IF(CUST.CMILGSP.bacid!="")THEN
				#{
					BANCS.INPARAM.BINDVARS=CUST.CMILGSP.bacid+"|N|Y"
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_s = "count5|"
					sv_s = sv_s + " SELECT COUNT(5)"
					sv_s = sv_s + " FROM TBAADM.APH"
					sv_s = sv_s + " WHERE BACID =?SVAR"
					sv_s = sv_s + " AND DEL_FLG =?SVAR"
					sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
					PRINT(sv_s)
					sv_d =  urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0 ) THEN
					#{
						CUST.CMILGSP.count5 = BANCS.OUTPARAM.count5
						PRINT(CUST.CMILGSP.count5)
						IF(CUST.CMILGSP.count5== 0) THEN
						#{
							CUST.CMILGSP.errorFlg = "Y"
							#CUST.CMILGSP.errorMsg ="Enter a vaild Withholding Tax Placeholder"
							CUST.CGSP.errorCode="ERR_001"
							CALL("whtdp028.scr")
							CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
							CUST.CMILGSP.errorFocus="prodCode"
							GOTO ENDOFSCRIPT
							
							#}
						ELSE
							#{
							BANCS.INPARAM.BINDVARS=CUST.CMILGSP.bacid+"|N|Y|"+BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_s = "count6|"
							sv_s = sv_s + " SELECT COUNT(6)"
							sv_s = sv_s + " FROM TBAADM.APH"
							sv_s = sv_s + " WHERE BACID =?SVAR"
							sv_s = sv_s + " AND DEL_FLG =?SVAR"
							sv_s = sv_s + " AND ENTITY_CRE_FLG =?SVAR"
							sv_s = sv_s + " AND BANK_ID =?SVAR"
							PRINT(sv_s)
							sv_d =  urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF (sv_d == 0 ) THEN
							#{
								CUST.CMILGSP.count6 = BANCS.OUTPARAM.count6
								PRINT(CUST.CMILGSP.count6)
								IF(CUST.CMILGSP.count6== 0) THEN
								#{
									CUST.CMILGSP.errorFlg = "Y"
									#CUST.CMILGSP.errorMsg ="Withholding Tax Placeholder doesnot belong to context Bank id"
									CUST.CGSP.errorCode="ERR_002"
									CALL("whtdp028.scr")
									CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
									CUST.CMILGSP.errorFocus="prodCode"
									GOTO ENDOFSCRIPT
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
						#}
					ELSE
						#{
						CUST.CMILGSP.errorFlg = "Y"
						#CUST.CMILGSP.errorMsg ="Select query failed"
						CUST.CGSP.errorCode="ERR_003"
						CALL("whtdp028.scr")
						CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
						CUST.CMILGSP.errorFocus="prodCode"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			IF(FIELDEXISTS(BANCS.INPUT.milgspschdet1_FIELD_3))THEN
			#{
				CUST.CMILGSP.wthTaxAppFlg  = BANCS.INPUT.milgspschdet1_FIELD_3
				PRINT(CUST.CMILGSP.wthTaxAppFlg )
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.CMILGSP.errorFlg = "Y"
			#CUST.CMILGSP.errorMsg ="Custom Field values not available"
			CUST.CGSP.errorCode="ERR_004"
			CALL("whtdp028.scr")
			CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
			CUST.CMILGSP.errorFocus="prodCode"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CMILGSP.errorFlg = "Y"
		#CUST.CMILGSP.errorMsg ="Custom Field values not available"
		CUST.CGSP.errorCode="ERR_004"
		CALL("whtdp028.scr")
		CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
		CUST.CMILGSP.errorFocus="prodCode"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("genDtl.schm.schmCode")
	IF(sv_u != 0) THEN
	#{
		CUST.CMILGSP.errorFlg = "Y"
		#CUST.CMILGSP.errorMsg ="Unable to fetch scheme code"
		CUST.CGSP.errorCode="ERR_005"
		CALL("whtdp028.scr")
		CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
		CUST.CMILGSP.errorFocus="prodCode"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.CMILGSP.schmCode = BANCS.OUTPARAM.srvValue
		print(CUST.CMILGSP.schmCode)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("genDtl.schm.schmType")
	IF(sv_u != 0) THEN
	#{
		CUST.CMILGSP.errorFlg = "Y"
		#CUST.CMILGSP.errorMsg ="Unable to fetch scheme Type"
		CUST.CGSP.errorCode="ERR_006"
		CALL("whtdp028.scr")
		CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
		CUST.CMILGSP.errorFocus="prodCode"
		GOTO ENDOFSCRIPT
		#}
