	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS =CUST.CMILGSP.wthTaxAppFlg
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.wthTaxPcnt
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.bacid
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.schmType
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.schmCode
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "MILGSP|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_s = "UPDATE CUSTOM.C_WTH_GSP_DET_MOD SET"
	sv_s = sv_s + " WTH_TAX_APP_FLG =?SVAR,"
	sv_s = sv_s + " WTH_TAX_PCNT =?SVAR,"
	sv_s = sv_s + " BACID =?SVAR"
	sv_s = sv_s + " WHERE SCHM_TYPE =?NVAR"
	sv_s = sv_s + " AND SCHM_CODE =?SVAR"
	sv_s = sv_s + " AND MOP_ID =?SVAR"
	sv_s = sv_s + " AND BANK_ID =?SVAR"
	sv_d = urhk_dbSQLWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d==0)THEN
	#{
		sv_d = urhk_dbSqlWithBind("COMMIT")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.CMILGSP.errorFlg = "Y"
		#CUST.CMILGSP.errorMsg ="Updation Failed!"
		CUST.CGSP.errorCode="ERR_008"
		CALL("whtdp028.scr")
		CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
		CUST.CMILGSP.errorFocus="prodCode"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	MODTABLEINSERT:
		BANCS.INPARAM.BINDVARS = CUST.CMILGSP.wthTaxAppFlg  + "|" + CUST.CMILGSP.wthTaxPcnt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.bacid
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.schmType
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.schmCode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "MILGSP"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_s =  "INSERT INTO CUSTOM.C_WTH_GSP_DET_MOD("
		sv_s = sv_s + " WTH_TAX_APP_FLG,WTH_TAX_PCNT,BACID,"
		sv_s = sv_s + " SCHM_TYPE,SCHM_CODE,MOP_ID,"
		sv_s = sv_s + " DEL_FLG,ENTITY_CRE_FLG,BANK_ID)"
		sv_s = sv_s + " VALUES( "
		sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
		sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR,"
		sv_s = sv_s + " ?SVAR, ?SVAR,?SVAR )"
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d==0)THEN
		#{
			sv_d = urhk_dbSqlWithBind("COMMIT")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CMILGSP.errorFlg = "Y"
			#CUST.CMILGSP.errorMsg ="Insertion Failed!"
			CUST.CGSP.errorCode="ERR_007"
			CALL("whtdp028.scr")
			CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
			CUST.CMILGSP.errorFocus="prodCode"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	MAINTABLEUPDATE:
		
		BANCS.INPARAM.BINDVARS =  CUST.CMILGSP.wthTaxAppFlg
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.wthTaxPcnt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.bacid
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.schmType
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CMILGSP.schmCode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "MILGSP|"+BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_s = "UPDATE CUSTOM.C_WTH_GSP_DET SET"
		sv_s = sv_s + " WTH_TAX_APP_FLG =?SVAR,"
		sv_s = sv_s + " WTH_TAX_PCNT =?SVAR,"
		sv_s = sv_s + " BACID =?SVAR"
		sv_s = sv_s + " WHERE SCHM_TYPE =?NVAR"
		sv_s = sv_s + " AND SCHM_CODE =?SVAR"
		sv_s = sv_s + " AND MOP_ID =?SVAR"
		sv_s = sv_s + " AND BANK_ID =?SVAR"
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d==0)THEN
		#{
			sv_d = urhk_dbSqlWithBind("COMMIT")
			#}
		ELSE
			#{
			CUST.CMILGSP.errorFlg = "Y"
			#CUST.CMILGSP.errorMsg ="Updation Failed!"
			CUST.CGSP.errorCode="ERR_008"
			CALL("whtdp028.scr")
			CUST.CMILGSP.errorMsg=CUST.CGSP.errorDesc
			CUST.CMILGSP.errorFocus="prodCode"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	ENDOFSCRIPT:
		IF(CUST.CMILGSP.errorFlg=="Y")THEN
		#{
			sv_r = urhk_SRV_SetErr(CUST.CMILGSP.errorMsg)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		#}
		ENDIF
		EXITSCRIPT
