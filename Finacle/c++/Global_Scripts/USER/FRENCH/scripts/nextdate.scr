#-------------------------------------------------------------------------------------    
#	Name				: nextdate.scr
#	Description     	: This script will be called from different mrt for calculating the next working date.
#	Date            	: 15-01-2013
#	Author          	: Rajavel
#	Input           	: NA
#	Output			    : BANCS.OUTPUT.nextwdate
#	Called Script	 	: NA
#	Calling Script	 	: NA
#	Menu Option		    : NA
#    Srl. No		Date		Author		 Description.
#    -------		----		------		----------------
#     1.0		15-01-2013	    Rajavel	     Original Version
#-------------------------------------------------------------------------------------

<--START
CHECKSUM="7712ab6aeda9dd334b4e0afdc2541b6eb62fb74f4f1a3e0d0fdfed31e762c8e5"
	TRACE ON
	
	sv_s = BANCS.STDIN.mySolId
	PRINT(sv_s)
	sv_u = LEFT$(BANCS.STDIN.BODDate,10)
	PRINT(sv_u)
	sv_a = sv_s + "|" + sv_u
	
	sv_e = urhk_GetNextWorkingDate(sv_a)
	PRINT(sv_e)
	PRINT(BANCS.OUTPARAM.NextWorkingDate)
	
	BANCS.OUTPUT.nextwdate = BANCS.OUTPARAM.NextWorkingDate
	PRINT(BANCS.OUTPARAM.PrevWorkingDate)
	PRINT(BANCS.OUTPARAM.NextDataCentreWorkingDate)
	PRINT(BANCS.OUTPARAM.PrevDataCentreWorkingDate)
	
	
	TRACE OFF
	EXITSCRIPT
END-->
