<--START
CHECKSUM="2ad3e283857ba9cbe3315e7851bd7cc3e86c90e9fd8c581e3650396830129ba7"
	TRACE ON
	###########################################################################################
	# CREATE THE NECESSARY REPOSITORY AND CLASSES
	###########################################################################################
	
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","CIECLG") == 0) THEN
	#{
		CREATECLASS("CUST","CIECLG",5)
	#}
	ENDIF
	
	CUST.CIECLG.instrumentEntity = ""
	CUST.CIECLG.instrumentBankCode = ""
	CUST.CIECLG.instrumentBranchCode = ""
	
	CUST.CIECLG.payingAcct = " "
	CUST.CIECLG.errorFlg = "N"
	CUST.CIECLG.errorMsg = " "
	
	###########################################################################################
	# Get the input values from front end
	###########################################################################################
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentEntity) != "")THEN
		#{
			CUST.CIECLG.instrumentEntity = BANCS.INPUT.instrumentEntity
			print(CUST.CIECLG.instrumentEntity)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentBankCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentBankCode) != "")THEN
		#{
			CUST.CIECLG.instrumentBankCode = BANCS.INPUT.instrumentBankCode
			print(CUST.CIECLG.instrumentBankCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.instrumentBranchCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.instrumentBranchCode) != "")THEN
		#{
			CUST.CIECLG.instrumentBranchCode = BANCS.INPUT.instrumentBranchCode
			print(CUST.CIECLG.instrumentBranchCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.payingAcct))THEN
	#{
		IF(TRIM(BANCS.INPUT.payingAcct) != "")THEN
		#{
			CUST.CIECLG.payingAcct = BANCS.INPUT.payingAcct
			print(CUST.CIECLG.payingAcct)
		#}
		ENDIF
	#}
	ENDIF
	
	###########################################################################################
	# Equity Bank - Bank Codes for different entities
	###########################################################################################
	
	CUST.CIECLG.parameterValue = ""
	CUST.CIECLG.parameterId = "EBL_BANK_CODE_" + CUST.CIECLG.instrumentEntity
	print(CUST.CIECLG.parameterId)
	sv_s = "parameterValue|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Unable to get Equity Bank Code to validate Paying Account ID; Paramter Not set in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.parameterValue = BANCS.OUTPARAM.parameterValue
	PRINT(CUST.CIECLG.parameterValue)
	
	IF(TRIM(CUST.CIECLG.parameterValue) == "")THEN
	#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Unable to get Equity Bank Code to validate Paying Account ID; Paramter Not set in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CIECLG.instrumentBankCode != CUST.CIECLG.parameterValue)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctBankId,acctClsFlg|"
	sv_s = sv_s + " SELECT BANK_ID,ACCT_CLS_FLG FROM TBAADM.GAM"
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIECLG.payingAcct
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Invalid Payee Account ID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.acctBankId = BANCS.OUTPARAM.acctBankId
	PRINT(CUST.CIECLG.acctBankId)
	
	IF(CUST.CIECLG.acctBankId != CUST.CIECLG.instrumentEntity)THEN
	#{
		CUST.CIECLG.errorFlg = "Y"
		CUST.CIECLG.errorMsg = "Entered Payee Account ID does not belong to Entered Instrument Entity"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_s = "erorFlg|" + CUST.CIECLG.errorFlg
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "errorMsg|" + CUST.CIECLG.errorMsg
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "payingAcct|" + CUST.CIECLG.payingAcct
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		TRACE OFF
END-->
