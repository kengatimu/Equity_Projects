######################################################################################################################
# Source Name						: s_clgznoprtnmn002.scr									
# Date								: 21-01-2013									
# Description						: This script is for making credit and debit transcations using at the Zone closing.
# Input Values						: None									
# Output Values						: To make the transcations of credit and debit.
# Called Scripts					: SRV_FetchIcZoneDetForClose_validate_data.scr									
# Calling Script					: getcparamvalue.scr						
# Author     						: Manoj								
# Bank								: Equity Bank,KENYA							
# Modification History				:				
#		< Version No.> 		<Date>		<Author Name> 		<Description>									
#		 0.1			15-JAN-2013 		Manoj			Original Version
#	   	 0.2			20-FEB-2013			Manoj			ratecode is added						
########################################################################################################################

<--START
TRACE ON

	#--------------------------------------------------------------------------
	#  Creation of CUST repository and INWDCLRCHG class
	#--------------------------------------------------------------------------

	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST", "CLRREST")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "CLRREST", 5)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------
	#Initilization custom repository values
	#-------------------------------------------------------------------------
	CUST.CLRREST.acctidBacid 	= ""
	CUST.CLRREST.rmrks 			= "Inward Clearing Charges"
	CUST.CLRREST.naration1 		= "Income from Inward Clearing Charge"
	CUST.CLRREST.naration2	 	= "Inward Clearing Charges"
	CUST.CLRREST.cshAmt 		= CDOUBLE("0")
	CUST.CLRREST.errMsg 		= ""
	CUST.CLRREST.custAcid	 	= ""
	CUST.CLRREST.custForacid 	= ""
	CUST.CLRREST.schmCode 		= ""
	CUST.CLRREST.acctOwnership 	= ""
	CUST.CLRREST.bacid 			= ""
	CUST.CLRREST.schmCod1 		= ""
	CUST.CLRREST.foracidv1 		= ""
	CUST.CLRREST.ipamt 			= ""
	CUST.CLRREST.amttblcod 		= ""
	CUST.CLRREST.minChrg 		= CDOUBLE("0")
	CUST.CLRREST.chrgBacid		= ""
	CUST.CLRREST.errMsg			= ""
	CUST.CLRREST.homeCrncy 		= BANCS.STDIN.homeCrncyCode 
	CUST.CLRREST.refCode 		= ""	
		
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="BACID_IWCLG" 
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CLRREST.bacid = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Bacid setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF	
	
	BANCS.INPUT.parameterId="SCHM_COD1_SB190" 
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CLRREST.schmCod1 = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Zone Code setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId="FORACIDS_ALL" 
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CLRREST.foracidv1 = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Foracid setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId="IPAMT_100" 
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
	CUST.CLRREST.ipamt= BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Amount setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId="AMTTBLCO_INWRD" 
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CLRREST.amttblcod = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Zone Code setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId="CHRG_BACID" 
	call("getcparamvalue.scr")
	print(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.CLRREST.chrgBacid = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Charge Bacid setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF

	BANCS.INPUT.parameterId="MIN_CHRG" 
	call("getcparamvalue.scr")
	print(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.CLRREST.minChrg = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Minimum charge setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"

	CALL ("getcparamvalue.scr")
	print(BANCS.OUTPUT.parameterVal)

	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CLRREST.refCode = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.CLRREST.errMsg = "Rate Code setup not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	#  Selecting values
	#--------------------------------------------------------------------------
	sv_u=urhk_SRV_GetVal("sol.solId")
	print(sv_u)
	CUST.CLRREST.solId=BANCS.OUTPARAM.srvValue   
	print(CUST.CLRREST.solId)	

	sv_u=urhk_SRV_GetVal("zone.zoneCode")
	print(sv_u)
	CUST.CLRREST.zoneCode=BANCS.OUTPARAM.srvValue   
	print(CUST.CLRREST.zoneCode)						

	sv_u=urhk_SRV_GetVal("zoneDate")			
	print(sv_u)
	CUST.CLRREST.zoneDate=LEFT$(BANCS.OUTPARAM.srvValue,10)
	print(CUST.CLRREST.zoneDate)
	
	#--------------------------------------------------------------------------
	# Selecting total number of record from ICI 
	#--------------------------------------------------------------------------
	sv_s = "Count|"
	sv_s = sv_s + " SELECT count(1) "
	sv_s = sv_s + " FROM TBAADM.ICI"
	sv_s = sv_s + " WHERE sol_id = ?SVAR "
	sv_s = sv_s + " AND zone_code = ?SVAR "
	sv_s = sv_s + " AND zone_date= TO_DATE(?SVAR,'DD-MM-YYYY') " 
	sv_s = sv_s + " AND acid in (select acid from TBAADM.gam where schm_type <> ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	sv_s = sv_s + " AND entity_cre_flg ='Y'"
	sv_s = sv_s + " AND DEL_FLG ='N')"
	sv_s = sv_s + " AND rej_type ='N'"
	sv_s = sv_s + " AND bank_id = ?SVAR"

	BANCS.INPARAM.BINDVARS = CUST.CLRREST.solId + "|" + CUST.CLRREST.zoneCode + "|" + CUST.CLRREST.zoneDate +"|DDA|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(sv_s)																			

	sv_d = urhk_dbSelectWithBind(sv_s)
	
	print(sv_d)
	IF(sv_d == 0) THEN
	#{
		sv_q = BANCS.OUTPARAM.Count
		print(sv_q)
	#}
	ELSE
	#{
		sv_q = 0
	#}
	ENDIF

	IF (sv_q == 0) THEN
	#{
		GOTO FINISH	
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# Selecting records from ICI 
	#--------------------------------------------------------------------------
	sv_s = "acid|"
	sv_s = sv_s + " SELECT acid "
	sv_s = sv_s + " FROM TBAADM.ICI "
	sv_s = sv_s + " WHERE "
	sv_s = sv_s + " sol_id=?SVAR"
	sv_s = sv_s + " AND zone_code=?SVAR"
	sv_s = sv_s + " AND zone_date= TO_DATE(?SVAR,'DD-MM-YYYY') " 
	sv_s = sv_s + " AND acid  in (select acid from TBAADM.gam where schm_type <> ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	sv_s = sv_s + " AND entity_cre_flg ='Y'"
	sv_s = sv_s + " AND del_flg ='N')"
	sv_s = sv_s + "	AND rej_type ='N'"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	
	
	BANCS.INPARAM.BINDVARS = CUST.CLRREST.solId + "|" + CUST.CLRREST.zoneCode + "|" + CUST.CLRREST.zoneDate + "|DDA|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	sv_o = urhk_dbcursorOpenWithBind(sv_s)												
	print(sv_o)

	print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUST.CLRREST.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(CUST.CLRREST.MainCursor)
	#--------------------------------------------------------------------------	
	# Initialise the Local Variables 
	#--------------------------------------------------------------------------
	sv_z = CINT("0")
	sv_l = CINT("0")
	
	PRINT(CUST.CLRREST.bacid)
	PRINT(BANCS.STDIN.homeCrncyCode)
	PRINT(BANCS.STDIN.mySolId)

	sv_i =CUST.CLRREST.bacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
	sv_u = urhk_B2k_BacidToAcctId(sv_i)
	print(sv_u)
	IF (sv_u == 1 ) THEN
	#{
		#--sending error report to PR
		sv_s = system("touch INWRD.rpt")
		sv_s = system("echo inward clearing charge Errors  >> INWRD.rpt")
		sv_s = system("echo ------------------------------------------- >> INWRD.rpt")
		sv_s = system("echo                                             >> INWRD.rpt")
		sv_s = "echo Account-inward clearing charge Income Account does not exist for the bacid "
		sv_s = sv_s + CUST.CLRREST.bacid + " >> INWRD.rpt"
		sv_s = system(sv_s)
		sv_s = system("echo                                             >> INWRD.rpt") 
		sv_s = system("echo          -----END---		        >> INWRD.rpt")     
		sv_s = "babx4040 ${B2K_SESSION_ID} INWRD.rpt Inward_Charge_Error_Report MANAGER 1 N"
		sv_u = system(sv_s)
		GOTO FINISH	
	#}	
	ENDIF

	CUST.CLRREST.acctidBacid = BANCS.OUTPARAM.AcctId  
	print(CUST.CLRREST.acctidBacid)	

	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.CLRREST.rmrks)
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	#--------------------------------------------------------------------------
	# Credit leg
	#--------------------------------------------------------------------------
	WHILE (sv_o == CINT("0"))
	#{
	sv_z = sv_z + 1
	sv_k = Format$(sv_z,"%d")	
	
	sv_c = urhk_dbCursorFetch(CUST.CLRREST.MainCursor)
	print(sv_c)
	IF (sv_c != CINT("0")) THEN
	#{ 
		print(sv_c)
		sv_o = 1 

		IF (sv_l != CINT("0")) THEN
		#{
			print(sv_k)
			CUST.CLRREST.cshAmt = sv_l
			sv_w = "tranDtl.partTranDetailLL.<rec_"+sv_k+">."
			sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|"+sv_k)
			sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|C")
			sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.CLRREST.acctidBacid)
			sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.CLRREST.naration1)
			sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
			sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
			sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.CLRREST.cshAmt+"|"+CUST.CLRREST.homeCrncy)
			sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + CUST.CLRREST.homeCrncy)
			sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.CLRREST.cshAmt+"|"+CUST.CLRREST.homeCrncy)
			sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.CLRREST.refCode)
		#--------------------------------------------------------------------------
		# CHANGES MADE HERE TO INTITATE TRANSACATION
		#--------------------------------------------------------------------------
			sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
			print(sv_u)
			IF(sv_u != 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
				print(sv_u)
			#}
			ENDIF
			IF(sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
				print(sv_u)
				IF(sv_u == 0) THEN
				#{
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
					sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate") 
					sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
					print(sv_u)
					IF(sv_u != 0 ) THEN
					#{
						sv_u = urhk_CopyOutToIn("")
						sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
						sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate") 
						sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
						print(sv_u)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}
				ELSE
				#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) then
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			IF(FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
			#{
				print(BANCS.OUTPARAM.tranId)
			#}
			ENDIF
		#}
		ELSE
		#{
			exitscript
		#}
		ENDIF
	#}
	ELSE 
	#{
		CUST.CLRREST.custAcid = BANCS.OUTPARAM.acid
		print(CUST.CLRREST.custAcid)
		#-----------------------------------------------------------------
		# Fetching customer details
		#-----------------------------------------------------------------
		sv_s = "foracid,schmCode,acctOwnership|"
		sv_s = sv_s + " SELECT foracid,schm_code,acct_ownership "
		sv_s = sv_s + " FROM TBAADM.GAM WHERE "
		sv_s = sv_s + " acid = ?SVAR"
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND entity_cre_flg ='Y'"
		sv_s = sv_s + " AND del_flg ='N'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CLRREST.custAcid + "|" + BANCS.STDIN.contextBankId
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d == 0) THEN
		#{
			CUST.CLRREST.custForacid = BANCS.OUTPARAM.foracid
			print(CUST.CLRREST.custForacid)
			CUST.CLRREST.schmCode = BANCS.OUTPARAM.schmCode
			print(CUST.CLRREST.schmCode)
			CUST.CLRREST.acctOwnership= BANCS.OUTPARAM.acctOwnership
			print(CUST.CLRREST.acctOwnership)
		#}
		ENDIF
		
		IF (CUST.CLRREST.schmCode != CUST.CLRREST.schmCod1) THEN
		#{
			sv_w = getPosition(CUST.CLRREST.foracidv1,"|" +  CUST.CLRREST.custForacid + "|")
			IF ( sv_w == 0 ) THEN
			#{
				IF (CUST.CLRREST.acctOwnership == "C") THEN
				#{
					BANCS.INPARAM.InputAmount = CUST.CLRREST.ipamt 
					BANCS.INPARAM.AmountTableCode = CUST.CLRREST.amttblcod
					BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
					sv_u = urhk_B2k_GetASTMAmount("")
					print(sv_u)
					IF (sv_u == 1) THEN
					#{
						sv_m = CUST.CLRREST.minChrg
						print(sv_m)
					#}
					ELSE
					#{
						sv_m = BANCS.OUTPARAM.OutputAmount
						print(sv_m)
					#}
					ENDIF
					CUST.CLRREST.Counter = sv_z						
					CUST.CLRREST.chargeAmt = sv_m
					print(sv_k)
					sv_l = CDOUBLE(sv_m) + sv_l	
					sv_w = "tranDtl.partTranDetailLL.<rec_"+sv_k+">."
					sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|"+sv_k)
					sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
					sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|D")
					sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.CLRREST.custForacid)
					sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.CLRREST.naration2)
					sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
					sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
					sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
					sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
					sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.CLRREST.chargeAmt+"|"+CUST.CLRREST.homeCrncy)
					sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|"+CUST.CLRREST.homeCrncy)
					sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.CLRREST.chargeAmt+"|"+CUST.CLRREST.homeCrncy)
					sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
					sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
					sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.CLRREST.refCode)
					print(sv_l)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	DO
	sv_c = urhk_dbCursorClose(CUST.CLRREST.MainCursor) 
	FINISH:
	
	IF(CUST.CLRREST.errMsg != "") THEN
	#{
        	sv_d=urhk_SRV_SetErr(CUST.CLRREST.errMsg)
	#}
	ENDIF
TRACE OFF
EXITSCRIPT
END-->
