<--start
trace on
#Reps
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(repexists("EQGTG")==0)then
		createrep("EQGTG")
	endif
	if(repexists("EQSURE")==0)then
		createrep("EQSURE")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
	if(classexists("EQGTG","GLBDATA")==0)then
		createclass("EQGTG","GLBDATA",5)
	endif
	if(classexists("EQSURE","GLBDATA")==0)then
		createclass("EQSURE","GLBDATA",5)
	endif
	#sv_u = urhk_B2K_PrintRepos("BANCS")
	#print(sv_u)
#+++++++
#inp/out
#+++++++
	#sv_u = urhk_GetChannelInfo("")
	#print(sv_u)
	EQSRV.GLBDATA.thirdPartCode = "GTGOALS"
	EQSRV.GLBDATA.thirdDesc = "GeorgeTown Goals"
	EQSRV.GLBDATA.dccidd = "MIC"
	EQSRV.GLBDATA.statMode	= "REQRES"
	EQGTG.GLBDATA.statMode	= ""
	if(fieldexists(BANCS.INPUT.ModuleId)==1)then	
		EQSRV.GLBDATA.ModuleId = BANCS.INPUT.ModuleId
	else
		EQSRV.GLBDATA.ModuleId	= ""
	endif
	if(fieldexists(BANCS.INPUT.Function)==1)then	
		EQSRV.GLBDATA.Function = BANCS.INPUT.Function
	else
		EQSRV.GLBDATA.Function	= ""
	endif
	if((EQSRV.GLBDATA.ModuleId=="GTWKB") or (EQSRV.GLBDATA.ModuleId=="GTWKS"))then
		goto VAYU
	endif
	#`````````````````````````````````````````````````````````````
	#Jipange Goal \ Wekeza Bakshishi \ Wekeza Sasa  Product starts
	#``````````````````````````````````````````````````````````````
	if(((EQSRV.GLBDATA.ModuleId=="GTJIP") or (EQSRV.GLBDATA.ModuleId=="GTWKB") or (EQSRV.GLBDATA.ModuleId=="GTWKS")) and (EQSRV.GLBDATA.Function=="O"))then
		if(EQSRV.GLBDATA.ModuleId =="GTJIP")then	
			EQSRV.GLBDATA.gtReqCode	= "GTJIP-O"
			EQSRV.GLBDATA.gtReqDesc = "GtJipange Goals Open"
			EQSRV.GLBDATA.reqId	= "reqId"
			callscriptifexist("ebGtJipO.scr")
			if((EQSRV.GLBDATA.srvYN =="Y") and (EQSRV.GLBDATA.valerr!="") and (EQSRV.GLBDATA.Onvforacid!=""))then	
			       sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
			       sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
			       if(EQSRV.GLBDATA.Onvforacid != "")then
				       sv_u = urhk_SetOrbOut("AcctId|" +EQSRV.GLBDATA.Onvforacid)
			       endif
			endif
			if((EQSRV.GLBDATA.srvYN =="N") and (EQSRV.GLBDATA.valerr!=""))then 
			       sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
			       sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
			endif
			exitscript
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKB")then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKB-O"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Bakshishi Goals Open"
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKS") then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKS-O"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Sasa Goals Open"
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		callscriptifexist("ebGtTuOpn.scr")
		if((EQGTG.GLBDATA.scrValYN=="N") or (EQGTG.GLBDATA.valerr!=""))then	
		        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		        sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		endif
		if(((EQGTG.GLBDATA.scrValYN=="Y") or (EQGTG.GLBDATA.valerr!=""))and (EQGTG.GLBDATA.AcctId !=""))then	
		       sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
		       sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		       if(EQGTG.GLBDATA.AcctId != "")then
			       sv_u = urhk_SetOrbOut("AcctId|" +EQGTG.GLBDATA.AcctId)
		       endif
		       if(EQGTG.GLBDATA.TrnId != "")then
			       sv_u = urhk_SetOrbOut("InitialFundingTranId|" +EQGTG.GLBDATA.TrnId)
		       endif
		endif
		goto VAYU
	endif
	if(((EQSRV.GLBDATA.ModuleId=="GTJIP") or (EQSRV.GLBDATA.ModuleId=="GTWKB") or (EQSRV.GLBDATA.ModuleId=="GTWKS")) and (EQSRV.GLBDATA.Function=="M"))then
		if(EQSRV.GLBDATA.ModuleId =="GTJIP") then	
			EQSRV.GLBDATA.gtReqCode	= "GTJIP-M"
			EQSRV.GLBDATA.gtReqDesc = "GtJipange Goals Modify"
			EQSRV.GLBDATA.reqId	= "reqId"
			callscriptifexist("ebGtJipM.scr")
			if((EQSRV.GLBDATA.srvYN =="Y") and (EQSRV.GLBDATA.valerr!="") and (EQSRV.GLBDATA.Onforacid!=""))then	
			       sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
			       sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
			       if(EQSRV.GLBDATA.Onforacid != "")then
				       sv_u = urhk_SetOrbOut("AcctId|" +EQSRV.GLBDATA.Onforacid)
			       endif
			       if(EQSRV.GLBDATA.activationMsg !="")then
				       sv_u = urhk_SetOrbOut("NotifyMsg|" +EQSRV.GLBDATA.activationMsg )
			       endif	
			endif
			if((EQSRV.GLBDATA.srvYN =="N") and (EQSRV.GLBDATA.valerr!=""))then
			       sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
			       sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
			endif
			exitscript
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKB") then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKB-M"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Bakshishi Goals Modify"
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKS")then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKS-M"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Sasa Goals Modify"
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		callscriptifexist("ebGtTuMod.scr")
		if((EQGTG.GLBDATA.scrValYN=="N") or (EQGTG.GLBDATA.valerr!=""))then	
		        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		        sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		endif
		if(((EQGTG.GLBDATA.scrValYN=="Y") or (EQGTG.GLBDATA.valerr!=""))and ((EQGTG.GLBDATA.AcctId !="") or (EQGTG.GLBDATA.AcctId=="")))then	
		       sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
		       sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		       if(EQGTG.GLBDATA.AcctId != "")then
			       sv_u = urhk_SetOrbOut("AcctId|" +EQGTG.GLBDATA.AcctId)
		       endif
		endif
		goto VAYU
	endif
	if(((EQSRV.GLBDATA.ModuleId=="GTWKB") or (EQSRV.GLBDATA.ModuleId=="GTWKS")) and (EQSRV.GLBDATA.Function=="R"))then
		if(EQSRV.GLBDATA.ModuleId =="GTWKB") then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKB-R"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Bakshishi Goals Auto-Renewal Enabled"
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKS")then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKS-R"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Sasa Goals Auto-Renewal Enabled" 
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		callscriptifexist("ebGtTuRenew.scr")
		if((EQGTG.GLBDATA.scrValYN=="N") and (EQGTG.GLBDATA.valerr!=""))then	
		        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		        sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
			goto VAYU
		endif
		if(((EQGTG.GLBDATA.scrValYN=="Y") or (EQGTG.GLBDATA.valerr!=""))and ((EQGTG.GLBDATA.AcctId !="") or (EQGTG.GLBDATA.AcctId=="")))then	
		       sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
		       sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		       if(EQGTG.GLBDATA.AcctId != "")then
			       sv_u = urhk_SetOrbOut("AcctId|" +EQGTG.GLBDATA.AcctId)
		       endif
			goto VAYU
		endif
	endif
	if(((EQSRV.GLBDATA.ModuleId=="GTJIP") or (EQSRV.GLBDATA.ModuleId=="GTWKB") or (EQSRV.GLBDATA.ModuleId=="GTWKS")) and (EQSRV.GLBDATA.Function=="Z"))then
		if(EQSRV.GLBDATA.ModuleId =="GTJIP") then	
			EQSRV.GLBDATA.gtReqCode	= "GTJIP-Z"
			EQSRV.GLBDATA.gtReqDesc = "GtJipange Goals Cancel/Close"
			EQSRV.GLBDATA.reqId	= "reqId"
			EQSRV.GLBDATA.closeMode = "FI"
			callscriptifexist("ebGtJipZ.scr")
			if((EQSRV.GLBDATA.scrValYN=="Y") and (EQSRV.GLBDATA.valerr!=""))then	
				sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
				sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
				print(EQSRV.GLBDATA.srvSF)
				print(EQSRV.GLBDATA.tranId)
				print(EQSRV.GLBDATA.tranDate)
				if(EQSRV.GLBDATA.tranId !="")then
					sv_u = urhk_SetOrbOut("CloureTranId|" + EQSRV.GLBDATA.tranId )
				endif
			endif
			if((EQSRV.GLBDATA.scrValYN=="N") and (EQSRV.GLBDATA.valerr!=""))then	
				sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
				sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
			endif
			exitscript
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKB") then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKB-Z"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Bakshishi Goals Cancel/Close"
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKS") then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKS-Z"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Sasa Goals Cancel/Close"
			EQSRV.GLBDATA.reqId	= "reqId"
		endif
		callscriptifexist("ebGtTuCls.scr")
		if((EQGTG.GLBDATA.scrValYN=="N") or (EQGTG.GLBDATA.valerr!=""))then	
		        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		        sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		endif
		if(((EQGTG.GLBDATA.scrValYN=="Y") or (EQGTG.GLBDATA.valerr!=""))and ((EQGTG.GLBDATA.AcctId !="") or (EQGTG.GLBDATA.AcctId=="")))then	
		       sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
		       sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		       if(EQGTG.GLBDATA.AcctId != "")then
			       sv_u = urhk_SetOrbOut("AcctId|" +EQGTG.GLBDATA.AcctId)
		       endif
		       if(EQGTG.GLBDATA.CloseValueDt != "")then
			       sv_u = urhk_SetOrbOut("ClosureDate|" +EQGTG.GLBDATA.CloseValueDt)
		       endif
		       if(EQGTG.GLBDATA.CloseTrnId != "")then
			       sv_u = urhk_SetOrbOut("ClosureTranId|" +EQGTG.GLBDATA.CloseTrnId)
		       endif
		endif
		goto VAYU
	endif
	if(((EQSRV.GLBDATA.ModuleId=="GTJIP") or (EQSRV.GLBDATA.ModuleId=="GTWKB") or (EQSRV.GLBDATA.ModuleId=="GTWKS")) and (EQSRV.GLBDATA.Function=="W"))then
		if(EQSRV.GLBDATA.ModuleId =="GTJIP") then	
			EQSRV.GLBDATA.gtReqCode	= "GTJIP-W"
			EQSRV.GLBDATA.gtReqDesc = "GtJipange Goals WithDraw" 
			EQSRV.GLBDATA.reqId	= "reqId"
			callscriptifexist("ebGtJipW.scr")
			if((EQSRV.GLBDATA.srvYN=="N") and (EQSRV.GLBDATA.valerr!=""))then
				sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
				sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
			endif
			if((EQSRV.GLBDATA.srvYN=="Y") and (EQSRV.GLBDATA.valerr!=""))then
				sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
				sv_u = urhk_SetOrbOut("Message|" +EQSRV.GLBDATA.valerr)
			endif
			goto VAYU
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKB") then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKB-W"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Bakshishi Goals WithDraw" 
			EQSRV.GLBDATA.reqId	= "reqId"
			callscriptifexist("ebGtTuPrtCls.scr")
		endif
		if(EQSRV.GLBDATA.ModuleId =="GTWKS") then	
			EQSRV.GLBDATA.gtReqCode	= "GTWKS-W"
			EQSRV.GLBDATA.gtReqDesc = "GtWekeza Sasa Goals WithDraw"
			EQSRV.GLBDATA.reqId	= "reqId"
			callscriptifexist("ebGtTuPrtCls.scr")
		endif
		if((EQGTG.GLBDATA.scrValYN=="N") or (EQGTG.GLBDATA.valerr!=""))then	
		        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		        sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		endif
		if(((EQGTG.GLBDATA.scrValYN=="Y") or (EQGTG.GLBDATA.valerr!=""))and ((EQGTG.GLBDATA.AcctId !="") or (EQGTG.GLBDATA.AcctId=="")))then	
		       sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
		       sv_u = urhk_SetOrbOut("Message|" +EQGTG.GLBDATA.valerr)
		       if(EQGTG.GLBDATA.AcctId != "")then
			       sv_u = urhk_SetOrbOut("AcctId|" +EQGTG.GLBDATA.AcctId)
		       endif
		       if(EQGTG.GLBDATA.CloseValueDt != "")then
			       sv_u = urhk_SetOrbOut("WithDrawDate|" +EQGTG.GLBDATA.CloseValueDt)
		       endif
		       if(EQGTG.GLBDATA.CloseTrnId != "")then
			       sv_u = urhk_SetOrbOut("WithDrawTranId|" +EQGTG.GLBDATA.CloseTrnId)
		       endif
		endif
		goto VAYU
	endif
	#`````````````````````````````````````````````````````````````
	#Jipange Goal \ Wekeza Bakshishi \ Wekeza Sasa  Product Ends
	#``````````````````````````````````````````````````````````````
	#Balance Inquiry
	#+++++++++++++++++++++++++++++++++	
	if((EQSRV.GLBDATA.ModuleId =="GBALINQ") and (EQSRV.GLBDATA.Function=="I"))then
		callscriptifexist("ebGtBalInq.scr")
	endif
	if((EQSRV.GLBDATA.ModuleId =="GTJIPI") and (EQSRV.GLBDATA.Function=="I"))then
		callscriptifexist("ebGtGoalInq.scr")
	endif
	
#+++++++
#cleanup
#+++++++
VAYU:
	EQSRV.GLBDATA.stYN = "Y"
	if((EQSRV.GLBDATA.ModuleId=="GTJIP") and (EQSRV.GLBDATA.Function=="W"))then
		EQSRV.GLBDATA.stYN = "N"
	endif
	if((EQSRV.GLBDATA.ModuleId!= "GBALINQ") and (EQSRV.GLBDATA.Function !="I"))then
		EQSRV.GLBDATA.stYN = "N"
	endif
	##sv_u = urhk_SetUrhkInp("sol.solId|" +BANCS.STDIN.mySolId )
	##sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
	##if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
	##	print(BANCS.OUTPARAM.successOrFailure)
	##	sv_s = BANCS.OUTPARAM.successOrFailure
	##else
	##	sv_s = "X"
	##endif
	##if (( sv_u != 0 ) and ( sv_s != "S"))then
	##	print("default sol ccs failed")
	##endif
	##if(EQSRV.GLBDATA.stYN=="Y")then
	##	callscriptifexist("ebChnlStaus.scr")
	##endif
	if(classexists("EQSRV","GLBDATA")==1)then
		deleteclass("EQSRV","GLBDATA")
	endif
	if(repexists("EQSRV")==1)then
		deleterep("EQSRV")
	endif
exitscript
trace off
end-->
