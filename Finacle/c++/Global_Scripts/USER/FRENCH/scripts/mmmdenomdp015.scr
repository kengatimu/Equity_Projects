<--START
trace on

IF (FIELDEXISTS(CUST.DENOM.tranDate) == 0) THEN
#{
	CUST.DENOM.tranDate = LEFT$(BANCS.STDIN.BODDate, 10)
	PRINT(CUST.DENOM.tranDate)
#}
ENDIF
IF (CUST.DENOM.tranDate == "") THEN
#{
	CUST.DENOM.tranDate = LEFT$(BANCS.STDIN.BODDate, 10)
	PRINT(CUST.DENOM.tranDate)
#}
ENDIF


IF (FIELDEXISTS(CUST.DENOM.authMatrixId) == 0) THEN
#{
	CUST.DENOM.authMatrixId = ""
#}
ENDIF

CUST.DENOM.bank_id = BANCS.STDIN.contextBankId
print(CUST.DENOM.bank_id)




IF ((BANCS.STDIN.menuId == "CIETXN"))THEN
#{
	PRINT(CUST.CIETXN.contextBankId)
	IF(FIELDEXISTS(CUST.CIETXN.contextBankId))THEN
	#{
		CUST.DENOM.bank_id = CUST.CIETXN.contextBankId
		PRINT(CUST.DENOM.bank_id)
	#}
	ENDIF
	
	IF(FIELDEXISTS(CUST.CIETXN.contextBankId))THEN
	#{
		CUST.DENOM.solId = CUST.CIETXN.mySolId
		PRINT(CUST.DENOM.solId)
	#}
	ENDIF
		
#}
ENDIF


IF ((BANCS.STDIN.menuId == "CUBP"))THEN
#{
	PRINT(CUST.UBP.bankId)
	IF(FIELDEXISTS(CUST.UBP.bankId))THEN
	#{
		CUST.DENOM.bank_id = CUST.UBP.bankId
		PRINT(CUST.DENOM.bank_id)
	#}
	ENDIF

	IF(FIELDEXISTS(CUST.UBP.bankId))THEN
	#{
		CUST.DENOM.solId = CUST.UBP.mySolId
		PRINT(CUST.DENOM.solId)
	#}
	ENDIF
#}
ENDIF


#---------------------------------------------------------------------------
#inserting values into C_DERD table
#-------------------------------------------------------------------------
PRINT(CUST.DENOM.roundoff)
sv_j = GETPOSITION(CUST.DENOM.roundoff, "!")
sv_u = LEFT$(sv_e, sv_j - 1)
PRINT(sv_u)
sv_i = RIGHT$(sv_e, (STRLEN(sv_e) - sv_j))
PRINT(sv_i)
sv_z = ("CUST").("DENOM").("currency" + FORMAT$(sv_k, "%d"))
#  Using MID$ as crncy values sent from CCT screen will have its pageno suffixed
sv_z = MID$(("CUST").("DENOM").("currency" + FORMAT$(sv_k, "%d")), 0, 3)

BANCS.INPARAM.BINDVARS = CUST.DENOM.solId + "|" + CUST.DENOM.tranId + "|"
IF ((BANCS.STDIN.menuId == "HGCHRG") OR (BANCS.STDIN.serviceName == "SRV_AddGenChrgDtl")) THEN
#{
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "C"
#}
ELSE
#{
	# added check for HLASPAY - Kalyana_Bommisetti	
	IF ((BANCS.STDIN.menuId == "HLAUPAY") OR (BANCS.STDIN.serviceName == "SRV_UnscheduleLaPmt") OR (BANCS.STDIN.serviceName == "SRV_ReverseUnscheduleLaPmt") OR (BANCS.STDIN.menuId == "HLASPAY") OR (BANCS.STDIN.serviceName == "SRV_ScheduleLaPmt") OR (BANCS.STDIN.serviceName == "SRV_ReverseScheduleLaPmt")) THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "L"
	#}
	ELSE
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DENOM.EVENT
	#}
	ENDIF
#}
ENDIF
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + sv_u + "|" + sv_z + "|" + CUST.DENOM.tranDate + "|" + sv_i + "|" + CUST.DENOM.tellerId + "|" + CUST.DENOM.authMatrixId + "|" + CUST.DENOM.bank_id
print(BANCS.INPARAM.BINDVARS)
sv_m = "INSERT INTO c_derd (sol_id,dxfer_id,dxfer_flg,ptran_type,crncy_code,"
sv_m = sv_m + "tran_date,roundoff_amt,teller_id,status,auth_matrix_id,bank_id) "
sv_m = sv_m + "VALUES(?SVAR,?SVAR,"
sv_m = sv_m + "?SVAR,?SVAR,?SVAR,"
sv_m = sv_m + "TO_DATE(?SVAR,'DD-MM-YYYY'),?SVAR,?SVAR"
sv_m = sv_m + ",'N',?SVAR,?SVAR)"
PRINT(sv_m)
sv_x = urhk_DBSqlWithBind(sv_m)
PRINT(sv_x)

END-->
