					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	CUST.DENOM.bank_id = TOUPPER(BANCS.STDIN.contextBankId)
	PRINT(CUST.DENOM.bank_id)
	
	IF (FIELDEXISTS(BANCS.STDIN.funcName) ==0) THEN
	#{
		
		GOTO FINISH
		#}
	ELSE
		#{
		IF ((BANCS.STDIN.menuId == "HGCHRG") OR (BANCS.STDIN.funcName == "SRV_VerifyGenChrgDtl")) THEN
		#{
			sv_q = urhk_SRV_GetVal("genChrgCrit.tranType.tranType")
			CUST.DENOM.tranType = BANCS.OUTPARAM.srvValue
			PRINT(CUST.DENOM.tranType)
			#}
		ELSE
			#{
			
			GOTO FINISH
			IF ((BANCS.STDIN.menuId == "HLAUPAY") OR (BANCS.STDIN.funcName == "SRV_ProcessUnscheduleLaPmtForVrfy") OR (BANCS.STDIN.serviceName == "SRV_ProcessUnscheduleLaPmtForVrfy")) THEN
			#{
				sv_q = urhk_SRV_GetVal("laPayCrit.tranType")
				#}
			ELSE
				#{
				sv_q = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	#-- Getting Tran.id--------------------
	IF (CUST.DENOM.tranType == "C") THEN
	#{
		IF ((FIELDEXISTS(ONS.CUSTOM.custDataIn) == 0) OR (TRIM(ONS.CUSTOM.custDataIn) == "")) THEN
		#{
			GOTO FINISH
		#}
		ENDIF
		IF ((BANCS.STDIN.menuId == "HGCHRG") OR (BANCS.STDIN.funcName == "SRV_VerifyGenChrgDtl")) THEN
		#{
			sv_q = urhk_SRV_GetVal("genChrgCrit.gchSrlNum")
			CUST.DENOM.tranId = LPAD(TRIM(BANCS.OUTPARAM.srvValue), 9)
			BANCS.INPARAM.BINDVARS = CUST.DENOM.tranId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
			PRINT(BANCS.INPARAM.BINDVARS)
