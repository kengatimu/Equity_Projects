		IF (FIELDEXISTS(BANCS.INPUT.srvcallmode)) THEN
		#{
			IF (BANCS.INPUT.srvcallmode == "S") THEN
			#{
				IF ((BANCS.STDIN.menuId == "HLAUPAY") OR (BANCS.STDIN.serviceName == "SRV_ProcessUnscheduleLaPmtForVrfy")) THEN
				#{
					GOTO FINISH
					sv_d = urhk_SRV_GetVal("tranObj.tranIdentifier.tranDate")
					#}
				ELSE
					#{
					sv_d = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranDate")
				#}
				ENDIF
				
				BANCS.INPUT.tranDate = MID$(BANCS.OUTPARAM.srvValue, 0, 10)
				PRINT(BANCS.INPUT.tranDate)
				sv_d = urhk_B2k_getDateDiffFromBODDate(BANCS.INPUT.tranDate)
				PRINT(sv_d)
