			#{
				CUST.DENOM.date = BANCS.OUTPARAM.tranDate
				#}
			ELSE
				#{
				CUST.DENOM.date = LEFT$(BANCS.STDIN.BODDate, 10)
			#}
			ENDIF
			PRINT(CUST.DENOM.date)
			sv_q = urhk_SRV_GetVal("genChrgCrit.tranId")
			CUST.DENOM.origTranId = BANCS.OUTPARAM.srvValue
			sv_q = urhk_SRV_GetVal("genChrgCrit.tranDate")
			CUST.DENOM.tranDate = LEFT$(BANCS.OUTPARAM.srvValue, 10)
			#}
		ELSE
			#{
			GOTO FINISH
			IF ((BANCS.STDIN.menuId == "HLAUPAY") OR (BANCS.STDIN.funcName == "SRV_ProcessUnscheduleLaPmtForVrfy") OR (BANCS.STDIN.serviceName == "SRV_ProcessUnscheduleLaPmtForVrfy")) THEN
			#{
				sv_q = urhk_SRV_GetVal("tranObj.tranIdentifier.tranId")
				CUST.DENOM.tranId = BANCS.OUTPARAM.srvValue
				sv_q = urhk_SRV_GetVal("tranObj.tranIdentifier.tranDate")
				CUST.DENOM.tranDate = LEFT$(BANCS.OUTPARAM.srvValue, 10)
				#}
			ELSE
				#{
				sv_q = urhk_SRV_GetVal("tranDtl.tranIdentifier.tranId")
				CUST.DENOM.tranId = BANCS.OUTPARAM.srvValue
				sv_q = urhk_SRV_GetVal("tranDtl.tranIdentifier.tranDate")
				CUST.DENOM.tranDate = LEFT$(BANCS.OUTPARAM.srvValue, 10)
			#}
			ENDIF
		#}
		ENDIF
		PRINT(CUST.DENOM.tranId)
		PRINT(CUST.DENOM.tranDate)
		
		PRINT(ONS.CUSTOM.custDataIn)
		sv_s = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)
		CALL("denomdp018.scr")
		
		#-----Query to update Dxfer_id as 'P' in C_DETD and C_DERD table---------------
		sv_l = "UPDATE CUSTOM.c_detd "
		sv_m = "UPDATE CUSTOM.c_derd "
		IF ((BANCS.STDIN.menuId == "HGCHRG") OR (BANCS.STDIN.funcName == "SRV_VerifyGenChrgDtl") OR (BANCS.STDIN.serviceName == "SRV_VerifyGenChrgDtl")) THEN
		#{
			sv_l = sv_l + "SET dxfer_flg = 'P',lchg_time=sysdate,lchg_user_id = ?SVAR,"
			sv_l = sv_l + "dxfer_id=?SVAR,tran_date=to_date(?SVAR,'DD-MM-YYYY') "
			sv_m = sv_m + "SET dxfer_flg = 'P',dxfer_id = ?SVAR,tran_date=to_date(?SVAR,'DD-MM-YYYY') "
			sv_n = "WHERE dxfer_id = ?SVAR "
			sv_n = sv_n + "AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
			
			BANCS.INPARAM.BINDVARS_L = BANCS.STDIN.userId + "|" + LPAD(CUST.DENOM.origTranId, 9, ' ') + "|" + CUST.DENOM.tranDate
			BANCS.INPARAM.BINDVARS_M = LPAD(CUST.DENOM.origTranId, 9, ' ') + "|" + CUST.DENOM.tranDate
			BANCS.INPARAM.BINDVARS_N = CUST.DENOM.tranId + "|" + CUST.DENOM.date
			#}
		ELSE
			#{
			sv_l = sv_l + "SET dxfer_flg = 'P',lchg_time=sysdate,lchg_user_id = ?SVAR "
			sv_m = sv_m + "SET dxfer_flg = 'P' "
			sv_n = "WHERE dxfer_id = ?SVAR "
			sv_n = sv_n + "AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY') "
			
			BANCS.INPARAM.BINDVARS_L = BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS_N = LPAD(CUST.DENOM.tranId, 9, ' ') + "|" + CUST.DENOM.date
		#}
		ENDIF
		
		PRINT(sv_l + sv_n)
		PRINT(sv_m + sv_n)
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS_L + "|" + BANCS.INPARAM.BINDVARS_N
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_v = urhk_dbsqlwithbind(sv_l + sv_n)
		PRINT(sv_v)
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS_M + "|" + BANCS.INPARAM.BINDVARS_N
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_v = urhk_dbsqlwithbind(sv_m + sv_n)
		PRINT(sv_v)
	#}
	ENDIF
	
	
