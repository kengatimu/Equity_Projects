<--START
CHECKSUM="ed0f27693f03490652d900eba6229eb599cadc2dc0327446561a369fb6decbf6"
	TRACE ON
	#----------------------------------------------------------------------
	# Create the necessary repositories and Classes
	#----------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","UPM") == 0) THEN
	#{
		CREATECLASS("CUST","UPM",5)
	#}
	ENDIF
	
	CUST.UPM.failureMessage = ""
	#sv_s = urhk_B2K_printRepos("BANCS")
	#-------------------------------------------------------------
	# Fetching the value from frontend and validating the same
	#-------------------------------------------------------------
	IF(FIELDEXISTS(BANCS.INPUT.userId))THEN
	#{
		CUST.UPM.userId = BANCS.INPUT.userId
		PRINT(CUST.UPM.userId)
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.tempRolId))THEN
	#{
		CUST.UPM.tempRoleId = BANCS.INPUT.tempRolId
		PRINT(CUST.UPM.tempRoleId)
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.expDate))THEN
	#{
		CUST.UPM.expiryDate = BANCS.INPUT.expDate
		PRINT(CUST.UPM.expiryDate)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Validating the temporary role Id and Expiry Date
	#------------------------------------------------------------------------------
	
	CALL("ctrmmn003.scr")
	
	#-------------------------------------------------------------------------------
	# If Record already exits then do an update else do an insert into C_UAD
	#-------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.UPM.userId
	sv_s = "actualRoleId|SELECT role_id FROM TBAADM.UPR WHERE USER_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d != 0) THEN
	#{
		CUST.UPM.failureMessage = "System Error. Could not fetch details from UPR"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "tempRolId^"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.UPM.actualRoleId = BANCS.OUTPARAM.actualRoleId
	
	
	BANCS.INPARAM.BINDVARS = CUST.UPM.userId
	sv_s = "recCount|SELECT COUNT(*) FROM CUSTOM.C_UAD WHERE USER_ID = ?SVAR "
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d != 0) THEN
	#{
		CUST.UPM.failureMessage = "System Error. Could not fetch details from C_UAD"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	print(BANCS.OUTPARAM.recCount)
	IF(BANCS.OUTPARAM.recCount == 0) THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.UPM.userId + "|" + CUST.UPM.actualRoleId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.UPM.tempRoleId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.UPM.expiryDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "Y"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
		print(BANCS.INPARAM.BINDVARS)
		
		sv_s = "INSERT INTO CUSTOM.C_UAD (USER_ID,ACTUAL_ROLE_ID,TEMPORARY_ROLE_ID,EXPIRY_DATE,ENTITY_CRE_FLG,"
		sv_s = sv_s + "DEL_FLG,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,ROLLBACK)"
		sv_s = sv_s + "VALUES (?SVAR,?SVAR,?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY'),?SVAR,?SVAR,?SVAR,"
		sv_s = sv_s + "TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'),?SVAR,TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'),?SVAR,?SVAR)"
		print(sv_s)
		sv_d = urhk_dbSqlWithBind(sv_s)
		IF (sv_d != 0) THEN
		#{
			CUST.UPM.failureMessage = "System Error. C_UAD table insertion failed"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			print("Query execution failed")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		
		BANCS.INPARAM.BINDVARS = CUST.UPM.tempRoleId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.UPM.expiryDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "Y"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.BODDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.UPM.userId
		sv_s="UPDATE CUSTOM.C_UAD SET TEMPORARY_ROLE_ID = ?SVAR,EXPIRY_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + ",ENTITY_CRE_FLG = ?SVAR,DEL_FLG = ?SVAR,RCRE_USER_ID = ?SVAR,RCRE_TIME = TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS')"
		sv_s = sv_s + ",LCHG_USER_ID = ?SVAR,LCHG_TIME = TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'),BANK_ID = ?SVAR,ROLLBACK = ?SVAR WHERE USER_ID = ?SVAR "
		sv_d =urhk_dbSQLWithBind(sv_s)
		IF(sv_d != 0) THEN
		#{
			print("Query execution failed")
			CUST.UPM.failureMessage = "System Error. C_UAD table updated failed"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
			sv_u = urhk_SetOrbOut(sv_s)
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------
	# Updating the UPR table
	#-------------------------------------------------------------------------------------------
	
	#sv_a = urhk_B2K_printRepos("CUST")
	sv_u = urhk_SetUrhkInp("usrGenDtl.usrId|" + CUST.UPM.userId)
	sv_u = urhk_ExecSrv("SRV_FetchUsrProfileForModify|same_user_verify = Y|retain_all_output = Y")
	sv_u = urhk_CopyOutToIn("")
	print(sv_u)
	print(CUST.UPM.tempRoleId)
	print(CUST.UPM.userId)
	sv_u = urhk_SetUrhkInp("usrGenDtl.usrRole.id|" + CUST.UPM.tempRoleId)
	
	IF(MID$(CUST.UPM.tempRoleId,0,3) == "BRM")THEN
	#{
		sv_u = urhk_SetUrhkInp("usrGenDtl.workClass.refCode|200")
	#}
	ENDIF
	IF(MID$(CUST.UPM.tempRoleId,0,3) == "AMO")THEN
	#{
		sv_u = urhk_SetUrhkInp("usrGenDtl.workClass.refCode|150")
	#}
	ENDIF
	
	sv_u = urhk_ExecSrv("SRV_ModifyUsrProfileAndVerify|same_user_verify = Y|retain_all_output = Y")
	print(sv_u)
	IF(sv_u != 0) THEN
	#{
		CUST.UPM.successOrFailure	= "F"
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				print(sv_e)
				CUST.UPM.failureMessage =  CUST.UPM.failureMessage + " ! " + sv_e
				sv_j = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				print(sv_j)
				sv_k = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_k)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
		
		CUST.UPM.failureMessage = sv_e
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_s = "Error_1|Error^" + CUST.UPM.failureMessage + "^tempRolId"
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	print(sv_u)
	sv_u = urhk_SetOrbOut("RESULT_MSG|"+"Temporary Role Id has been changed successfully")
	PRINT(sv_u)
	
	
	ENDOFSCRIPT:
		
		
		#trace off
END-->
