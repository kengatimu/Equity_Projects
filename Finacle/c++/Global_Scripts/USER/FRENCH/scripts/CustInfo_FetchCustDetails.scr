<--START
TRACE ON

print(BANCS.STDIN.contextBankId)
print(CUST.INTERFACE.solId)
print(CUST.INTERFACE.newForacid)
CUST.INTERFACE.alternateaccountno=" "
CUST.INTERFACE.customercode=" "
CUST.INTERFACE.middleinitial=" "
CUST.INTERFACE.freezecode=" "

BANCS.INPARAM.BINDVARS = CUST.INTERFACE.newForacid +"|"+ BANCS.STDIN.contextBankId

lv_q = "accountno,alternateaccountno,accounttype,openingdate,"
lv_q = lv_q + "status,clientcode,ownershipcode,balance,shadow_balance,typecode,"
lv_q = lv_q + "accounttypename,customercode,firstname,middleinitial,lastname,currencycode,isclosed,freezecode|"
lv_q = lv_q + " SELECT gam.foracid ,"
lv_q = lv_q + " gam.acct_short_name ,"
lv_q = lv_q + " gam.schm_type , gam.acct_opn_date ,"
lv_q = lv_q + " smt.acct_status , gam.sol_id ,"
lv_q = lv_q + " gam.acct_ownership , gam.clr_bal_amt ,"
lv_q = lv_q + " (gam.un_clr_bal_amt + gam.future_un_clr_bal_amt + gam.future_clr_bal_amt) , gam.schm_code ,"
lv_q = lv_q + " gsp.schm_desc , gam.cif_id ,"
lv_q = lv_q + " SUBSTR (TRIM (gam.acct_name),1,INSTR (TRIM (gam.acct_name), ' ') - 1) ,"
lv_q = lv_q + " '' ,SUBSTR(TRIM (gam.acct_name),LENGTH (SUBSTR (TRIM (gam.acct_name),1,INSTR (TRIM (gam.acct_name), ' ') + 1))),"
lv_q = lv_q + " gam.acct_crncy_code ,"
lv_q = lv_q + " gam.acct_cls_flg ,gam.frez_code "
lv_q = lv_q + " FROM tbaadm.gam, TBAADM.smt, TBAADM.gsp"
lv_q = lv_q + " WHERE gam.acid = smt.acid(+) "
lv_q = lv_q + " AND gam.schm_code = gsp.schm_code "
lv_q = lv_q + " AND gam.bank_id = gsp.bank_id "
lv_q = lv_q + " AND gam.bank_id = smt.bank_id "
lv_q = lv_q + " AND gam.foracid = ?SVAR "
lv_q = lv_q + " AND gam.bank_id = ?SVAR "

print(lv_q)

sv_d = urhk_dbSelectWithBind(lv_q)
print(sv_d)

if(sv_d == 1 ) THEN
#{
	#Validate for bankers cheque
BANCS.INPARAM.BINDVARS = CUST.INTERFACE.newForacid +"|"+ BANCS.STDIN.contextBankId

lv_q = "accountno,alternateaccountno,accounttype,openingdate,"
lv_q = lv_q + "status,clientcode,ownershipcode,balance,shadow_balance,typecode,"
lv_q = lv_q + "accounttypename,customercode,firstname,middleinitial,lastname,currencycode,isclosed,freezecode|"
lv_q = lv_q + " SELECT gam.foracid ,"
lv_q = lv_q + " gam.acct_short_name ,"
lv_q = lv_q + " gam.schm_type , gam.acct_opn_date ,"
lv_q = lv_q + " 'A' , gam.sol_id ,"
lv_q = lv_q + " gam.acct_ownership , gam.clr_bal_amt ,"
lv_q = lv_q + " (gam.un_clr_bal_amt + gam.future_un_clr_bal_amt + gam.future_clr_bal_amt) , gam.schm_code ,"
lv_q = lv_q + " gsp.schm_desc , gam.cust_id ,"
lv_q = lv_q + " SUBSTR (TRIM (gam.acct_name),1,INSTR (TRIM (gam.acct_name), ' ') - 1) ,"
lv_q = lv_q + " '' ,SUBSTR(TRIM (gam.acct_name),LENGTH (SUBSTR (TRIM (gam.acct_name),1,INSTR (TRIM (gam.acct_name), ' ') + 1))),"
lv_q = lv_q + " gam.acct_crncy_code ,"
lv_q = lv_q + " gam.acct_cls_flg ,gam.frez_code "
lv_q = lv_q + " FROM tbaadm.gam,  TBAADM.gsp"
lv_q = lv_q + " WHERE " 
lv_q = lv_q + " gam.schm_code = gsp.schm_code "
lv_q = lv_q + " AND gam.bank_id = gsp.bank_id "
lv_q = lv_q + " AND gam.foracid = ?SVAR "
lv_q = lv_q + " AND gam.bank_id = ?SVAR "

print(lv_q)

sv_d = urhk_dbSelectWithBind(lv_q)
print(sv_d)
#}
ENDIF 

IF(sv_d == 0) THEN
#{
	CUST.INTERFACE.accountno = BANCS.OUTPARAM.accountno
	print(CUST.INTERFACE.accountno)
	CUST.INTERFACE.alternateaccountno = BANCS.OUTPARAM.alternateaccountno
	print(CUST.INTERFACE.alternateaccountno)
