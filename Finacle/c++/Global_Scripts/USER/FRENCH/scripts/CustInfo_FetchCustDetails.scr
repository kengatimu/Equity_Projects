	print(CUST.INTERFACE.balance)
	CUST.INTERFACE.shadow_balance = BANCS.OUTPARAM.shadow_balance
	print(CUST.INTERFACE.shadow_balance)
	CUST.INTERFACE.typecode = BANCS.OUTPARAM.typecode
	print(CUST.INTERFACE.typecode)
	CUST.INTERFACE.accounttypename = BANCS.OUTPARAM.accounttypename
	print(CUST.INTERFACE.accounttypename)
	CUST.INTERFACE.customercode = BANCS.OUTPARAM.customercode
	print(CUST.INTERFACE.customercode)
	CUST.INTERFACE.firstname = BANCS.OUTPARAM.firstname
	print(CUST.INTERFACE.firstname)
	CUST.INTERFACE.middleinitial = BANCS.OUTPARAM.middleinitial
	print(CUST.INTERFACE.middleinitial)
	CUST.INTERFACE.lastname = BANCS.OUTPARAM.lastname
	print(CUST.INTERFACE.lastname)
	CUST.INTERFACE.currencycode = BANCS.OUTPARAM.currencycode
