<--START
CHECKSUM="6010fc08eb8340e836dee302b9cc58e518930569cd5238f08e16546ecc74af69"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.refAmt = " "
	CUST.CIETXN.refCrncy = " "
	CUST.CIETXN.acctCrncy = " "
	CUST.CIETXN.rateCode = " "
	
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.rate = " "
	CUST.CIETXN.treaRate = " "
	CUST.CIETXN.tranAmt = " "
	CUST.CIETXN.tranAmtCcy = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.refAmt))THEN
	#{
		IF(TRIM(BANCS.INPUT.refAmt) != "")THEN
		#{
			CUST.CIETXN.refAmt = TOUPPER(TRIM(BANCS.INPUT.refAmt))
			print(CUST.CIETXN.refAmt)
		#}
		ENDIF
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.refCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.refCrncy) != "")THEN
		#{
			CUST.CIETXN.refCrncy = TOUPPER(TRIM(BANCS.INPUT.refCrncy))
			print(CUST.CIETXN.refCrncy)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.acctCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctCrncy) != "")THEN
		#{
			CUST.CIETXN.acctCrncy= TOUPPER(TRIM(BANCS.INPUT.acctCrncy))
			print(CUST.CIETXN.acctCrncy)
		#}
		ENDIF
	#}
	ENDIF

	 
	
	IF(FIELDEXISTS(BANCS.INPUT.rateCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.rateCode) != "")THEN
		#{
			CUST.CIETXN.rateCode= TOUPPER(TRIM(BANCS.INPUT.rateCode))
			print(CUST.CIETXN.rateCode)
		#}
		ENDIF
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.rate))THEN
	#{
		IF(TRIM(BANCS.INPUT.rate) != "")THEN
		#{
			CUST.CIETXN.rate = TOUPPER(TRIM(BANCS.INPUT.rate))
			print(CUST.CIETXN.rate)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.treaRate))THEN
	#{
		IF(TRIM(BANCS.INPUT.treaRate) != "")THEN
		#{
			CUST.CIETXN.treaRate = TOUPPER(TRIM(BANCS.INPUT.treaRate))
			print(CUST.CIETXN.treaRate)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(CUST.CIETXN.refCrncy == CUST.CIETXN.acctCrncy)THEN
	#{
		CUST.CIETXN.rate = "1.00"
		CUST.CIETXN.treaRate = "0.00"
		CUST.CIETXN.tranAmt = CUST.CIETXN.refAmt
		CUST.CIETXN.tranAmtCcy = CUST.CIETXN.refCrncy
		
		IF(CUST.CIETXN.refAmt == " ")THEN
		#{
			CUST.CIETXN.tranAmtCcy = " "
		#}
		ENDIF
		
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CIETXN.rateCode == " ")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###########################################################################################
	# Get Rate From SRV
	###########################################################################################

	IF(BANCS.STDIN.menuId == "HCASHDX") THEN
	#{
		sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.CIETXN.acctCrncy)
        sv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.CIETXN.refCrncy)
        sv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.CIETXN.rateCode)
        sv_u = urhk_SetUrhkInp("fromAmt|"+CUST.CIETXN.refAmt+"|"+CUST.CIETXN.acctCrncy)
	#}
	ELSE
	#{
		sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.CIETXN.refCrncy)
        sv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.CIETXN.acctCrncy)
        sv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.CIETXN.rateCode)
        sv_u = urhk_SetUrhkInp("fromAmt|"+CUST.CIETXN.refAmt+"|"+CUST.CIETXN.refCrncy)
	#}
	ENDIF
		
	IF(CUST.CIETXN.rate != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("rate|"+CUST.CIETXN.rate)
	#}
	ENDIF
	
	IF(CUST.CIETXN.treaRate != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("treaRate|"+CUST.CIETXN.treaRate)
	#}
	ENDIF
	
	sv_u = urhk_SetUrhkOut("rate|rate")
	sv_u = urhk_SetUrhkOut("treaRate|treaRate")
	sv_u = urhk_SetUrhkOut("toAmt|toAmt")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_TieredConvCrncy")
	print(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.CIETXN.rate = BANCS.OUTPARAM.rate
		PRINT(CUST.CIETXN.rate)
		
		CUST.CIETXN.treaRate = BANCS.OUTPARAM.treaRate
		PRINT(CUST.CIETXN.treaRate)
		
		CUST.CIETXN.toAmt = BANCS.OUTPARAM.toAmt
		PRINT(CUST.CIETXN.toAmt)
		
		sv_p = GETPOSITION(CUST.CIETXN.toAmt,"|")
		print(sv_p)
		
		IF(sv_p > 0)THEN
		#{
			CUST.CIETXN.tranAmt = MID$(CUST.CIETXN.toAmt,0,sv_p-1)
			PRINT(CUST.CIETXN.tranAmt)
			CUST.CIETXN.tranAmtCcy = MID$(CUST.CIETXN.toAmt,sv_p,3)
			PRINT(CUST.CIETXN.tranAmtCcy)
		#}
		ENDIF
		
		#}
	ELSE
		#{
		
		print(BANCS.OUTPARAM.Fatal_num)
		print(BANCS.OUTPARAM.Error_num)
		print(BANCS.OUTPARAM.Warning_num)
		print(BANCS.OUTPARAM.UserInfo_num)
		print(BANCS.OUTPARAM.Xcpn_num)
		print(BANCS.OUTPARAM.Xcpn_Err_num)
		print(BANCS.OUTPARAM.Xcpn_Xcpn_num)
		print(BANCS.OUTPARAM.Xcpn_Err_num)
		
		sv_d = 1
		sv_n = 1
		sv_c = CINT(BANCS.OUTPARAM.Error_num)
		WHILE (sv_d <= sv_c)
		#{
			sv_f = FORMAT$(sv_d,"%d")
			sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
			print(sv_b)
			sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
			print(sv_e)
			sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
			print(sv_a)
			sv_d = sv_d + 1
			sv_n = sv_n + 1
			sv_d = sv_c + 1
		#}
		DO
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = sv_b
		CUST.CIETXN.rate = " "
		CUST.CIETXN.tranAmt = " "
		CUST.CIETXN.tranAmtCcy = " "
		
	#}
	ENDIF
	
	ENDOFSCRIPT:
	
	sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
	print(sv_u)
	sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
	print(sv_u)
	sv_u = urhk_SetOrbOut("rate|"+CUST.CIETXN.rate)
	print(sv_u)
	sv_u = urhk_SetOrbOut("treaRate|"+CUST.CIETXN.treaRate)
	print(sv_u)
	sv_u = urhk_SetOrbOut("tranAmt|"+CUST.CIETXN.tranAmt)
	print(sv_u)
	sv_u = urhk_SetOrbOut("tranAmtCcy|"+CUST.CIETXN.tranAmtCcy)
	print(sv_u)
	
END-->
