<--START
TRACE ON
        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST","DATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","DATA",5)
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST","RATE")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","RATE",5)
        #}
        ENDIF

	CUST.DATA.drAcctNum = " "
	CUST.DATA.opAcctNum = " "
	CUST.DATA.plAcctNum = " "
        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.tranAmt = "0"
        CUST.DATA.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
	CUST.DATA.tranid = " "

        IF(FIELDEXISTS(BANCS.INPUT.drAcctNum))THEN
        #{
                IF(TRIM(BANCS.INPUT.drAcctNum) != "")THEN
                #{
                        CUST.DATA.drAcctNum = TOUPPER(TRIM(BANCS.INPUT.drAcctNum))
                        PRINT(CUST.DATA.drAcctNum)
                #}
                ENDIF
                #}
        ELSE
                #{
        	CUST.DATA.errFlg = "Y"
        	CUST.DATA.errMsg = "OD account is not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.opAcctNum))THEN
        #{
                IF(TRIM(BANCS.INPUT.opAcctNum) != "")THEN
                #{
                        CUST.DATA.opAcctNum = TOUPPER(TRIM(BANCS.INPUT.opAcctNum))
                        PRINT(CUST.DATA.opAcctNum)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Operative account is not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.PLAcctNum))THEN
        #{
                IF(TRIM(BANCS.INPUT.PLAcctNum) != "")THEN
                #{
                        CUST.DATA.plAcctNum = TOUPPER(TRIM(BANCS.INPUT.PLAcctNum))
                        PRINT(CUST.DATA.plAcctNum)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "PANDL account is not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.IntrstAmt))THEN
        #{
                IF(TRIM(BANCS.INPUT.IntrstAmt) != "")THEN
                #{
                        CUST.DATA.tranAmt = TOUPPER(TRIM(BANCS.INPUT.IntrstAmt))
                        PRINT(CUST.DATA.tranAmt)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Interest Amount is not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.PLAcctCrncy))THEN
        #{
                IF(TRIM(BANCS.INPUT.PLAcctCrncy) != "")THEN
                #{
                        CUST.DATA.plAcctCrncy = TOUPPER(TRIM(BANCS.INPUT.PLAcctCrncy))
                        PRINT(CUST.DATA.plAcctCrncy)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Penal Account is not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.opAcctCrncy))THEN
        #{
                IF(TRIM(BANCS.INPUT.opAcctCrncy) != "")THEN
                #{
                        CUST.DATA.opAcctCrncy = TOUPPER(TRIM(BANCS.INPUT.opAcctCrncy))
                        PRINT(CUST.DATA.opAcctCrncy)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Opearative Account is not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	IF((TRIM(CUST.DATA.tranAmt) == "") OR (CUST.DATA.tranAmt == "0") OR (CDOUBLE(CUST.DATA.tranAmt) < CDOUBLE("0")))THEN
	#{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Interest Amount Should be greater than 0"
                GOTO ENDOFSCRIPT
	#}
	ENDIF	

        sv_s = "intrstAmt|SELECT PENDING_INTEREST FROM CUSTOM.TA_COT WHERE BANK_ID=?SVAR AND ACID=(SELECT ACID FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR)"
        BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId +"|"+ CUST.DATA.drAcctNum +"|"+BANCS.STDIN.contextBankId
        PRINT(sv_s)
        print(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
                CUST.DATA.intrstAmt = BANCS.OUTPARAM.intrstAmt
                PRINT(CUST.DATA.intrstAmt)
        #}
        ENDIF

	IF(CDOUBLE(CUST.DATA.tranAmt) > CDOUBLE(CUST.DATA.intrstAmt))THEN
	#{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Entered Amount is greater than the pending interest amount "+CUST.DATA.intrstAmt
                GOTO ENDOFSCRIPT
        #}
        ENDIF
               CUST.DATA.rateCode = ""
               CUST.DATA.rate = ""

	IF(CUST.DATA.opAcctCrncy != CUST.DATA.plAcctCrncy)THEN
        #{
        	CUST.RATE.acctCrncy = CUST.DATA.opAcctCrncy
                CUST.RATE.refCrncy  = CUST.DATA.plAcctCrncy
                CUST.RATE.TranType  = "T"

                CALL("fetchRateCode.scr")
                CUST.DATA.rateCode      =       CUST.RATE.rateCode
                CUST.DATA.rate          =       CUST.RATE.rate

                BANCS.INPARAM.InputAmount  = CUST.DATA.tranAmt
                BANCS.INPARAM.FromCurrency = CUST.DATA.cacrncy
                BANCS.INPARAM.ToCurrency   = CUST.DATA.odcrncy
                BANCS.INPARAM.RateCode     = CUST.DATA.rateCode
                BANCS.INPARAM.Rate         = CDOUBLE("0.0")
                #----------------------------------------------------------------------
                #Convert The Uncollected Amount Into AED for Storing Into Custom Table
                #----------------------------------------------------------------------
                lv_f = urhk_B2k_ConvertAmount("")
                IF(lv_f == 0)THEN
                #{
                	CUST.DATA.tranAmt = BANCS.OUTPARAM.OutputAmount
                        PRINT(CUST.DATA.tranAmt)
                #}
                ENDIF

         #}
         ENDIF

                sv_z = urhk_MTTS_Close("")
                PRINT(sv_z)

                BANCS.INPARAM.PostTranFlg = "Y"
                BANCS.INPARAM.CommitFlg = "Y"
                BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
                BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
                BANCS.INPARAM.ErrorCheckForLuw = "Y"
                BANCS.INPARAM.CheckExceptions = "Y"
                sv_r = urhk_MTTS_Initialize("")
                PRINT(sv_r)
                ############################################
                #Define Transaction  2
                #############################################
                MTT.TranDetails.TranID                                  = ""
                MTT.TranDetails.TranDate                = "0"
                MTT.TranDetails.TranType                = "T"
                MTT.TranDetails.PostFlag                = "Y"
                MTT.TranDetails.TranSubType             = "CI"
                MTT.TranDetails.ReversalFlag            = "N"
                MTT.TranDetails.IgnoreExcp              = "I"
                MTT.TranDetails.Consolidate             = "Y"
                MTT.TranDetails.Remarks                 = "Interest collection for Charge off account"
                sv_t = urhk_MTTS_DefineTransaction("CHRGOFF")

                IF(sv_t != "0")THEN
                #{
                        sv_r = urhk_MTTS_ReportErrorCondition("")
                        PRINT(MTT.Error.Description)
                        CUST.DATA.errMsg=MTT.Error.Description
                        PRINT(CUST.DATA.errMsg)
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

                sv_y = CDOUBLE(CUST.DATA.tranAmt)
                MTT.PartTranDetails.Account     = CUST.DATA.opAcctNum
                MTT.PartTranDetails.RefCurrency = CUST.DATA.plAcctCrncy
                MTT.PartTranDetails.RateCode = CUST.DATA.rateCode
                MTT.PartTranDetails.Particulars = "Charge off Intrest collection for:"+CUST.DATA.drAcctNum
                MTT.PartTranDetails.Remarks = "Interest Recovery for Charge off accounts"
                MTT.PartTranDetails.RefAmount = -(sv_y)
                PRINT(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Consolidate = "Y"
                MTT.PartTranDetails.TranIdentifier = "CHRGOFF"
                MTT.PartTranDetails.CarveAmtFlg="Y"
                sv_r = urhk_MTTS_DefinePartTran("DEBIT")
                PRINT(sv_r)

                IF(sv_r != "0")THEN
                #{
                        sv_r = urhk_MTTS_ReportErrorCondition("")
                        PRINT(MTT.Error.Description)
                        CUST.DATA.errMsg=MTT.Error.Description
                        PRINT(CUST.DATA.errMsg)
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

                ###################################################

                MTT.PartTranDetails.Account=CUST.DATA.plAcctNum
                MTT.PartTranDetails.RefAmount=CDOUBLE(CUST.DATA.tranAmt)
                PRINT(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Particulars = "Charge off Intrest collection for:"+CUST.DATA.drAcctNum
                MTT.PartTranDetails.RefCurrency= CUST.DATA.plAcctCrncy
                MTT.PartTranDetails.ValueDate="0"
                MTT.PartTranDetails.ReportCode = ""
                MTT.PartTranDetails.Consolidate="Y"
                MTT.PartTranDetails.TranIdentifier="CHRGOFF"
                MTT.PartTranDetails.PTranBusinessType=""
                sv_o = urhk_MTTS_DefinePartTran("CREDIT")
                PRINT(sv_o)

                IF(sv_o != "0")THEN
                #{
                        sv_r = urhk_MTTS_ReportErrorCondition("")
                        PRINT(MTT.Error.Description)
                        CUST.DATA.errMsg=MTT.Error.Description
                        PRINT(CUST.DATA.errMsg)
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

                sv_r = urhk_MTTS_EndDefinition("")
                PRINT(sv_r)
                IF(sv_r != "0")THEN
                #{
                        sv_r = urhk_MTTS_ReportErrorCondition("")
                        PRINT(MTT.Error.Description)
                        CUST.DATA.errMsg=MTT.Error.Description
                        PRINT(CUST.DATA.errMsg)
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

                PRINT(BANCS.OUTPARAM.MTTTranId)
                CUST.DATA.tranid = BANCS.OUTPARAM.MTTTranId
                sv_z = urhk_MTTS_Close("")
                PRINT(sv_z)
	IF(CUST.DATA.tranid != "" )THEN
       	#{

            sv_s = "INSERT INTO CUSTOM.CHRGOFF_INTRST(ODACCT_NUM,OPACCT_NUM,PANDLACCT_NUM,TRAN_ID,TRAN_AMT,RATE_CODE,TRAN_DATE,BANK_ID,RCRE_USER_ID,RCRE_TIME)"
            sv_s = sv_s + " VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,TO_DATE(?SVAR,'DD-MM-YY'),?SVAR,?SVAR,sysdate)"
            BANCS.INPARAM.BINDVARS=CUST.DATA.drAcctNum+"|"+CUST.DATA.opAcctNum+"|"+CUST.DATA.plAcctNum+"|"+CUST.DATA.tranid+"|"+CUST.DATA.tranAmt+"|"+CUST.DATA.rateCode
            BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.BODDate+ "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
            PRINT(sv_s)
            PRINT(BANCS.INPARAM.BINDVARS)
            sv_q = urhk_dbSQLWithBind(sv_s)
            PRINT(sv_q)
            IF(sv_q != 0)THEN
            #{
       		    CUST.DATA.errorMsg ="Database Insertion Failed"
                    PRINT(CUST.DATA.errorMsg)
                    GOTO ENDOFSCRIPT

            #}
            ENDIF

	    sv_s ="UPDATE CUSTOM.TA_COT SET PENDING_INTEREST=(PENDING_INTEREST - ?SVAR),INTEREST_RECOVERY=(INTEREST_RECOVERY + ?SVAR) WHERE BANK_ID=?SVAR AND ACID IN "
	    sv_s = sv_s + "(SELECT ACID FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR)"
	    BANCS.INPARAM.BINDVARS = CUST.DATA.tranAmt +"|"+CUST.DATA.tranAmt +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.drAcctNum +"|"+ BANCS.STDIN.contextBankId

	    PRINT(sv_s)
	    PRINT(BANCS.INPARAM.BINDVARS)
            sv_q = urhk_dbSQLWithBind(sv_s)
            PRINT(sv_q)
            IF(sv_q != 0)THEN
            #{
                    CUST.DATA.errorMsg ="Database Update Failed"
                    PRINT(CUST.DATA.errorMsg)
                    GOTO ENDOFSCRIPT

            #}
            ENDIF
		sv_u = urhk_SetOrbOut("RESULT_MSG|Interest has been collected Successfully with Tran Id:"+CUST.DATA.tranid)
        	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")


        #}
	ELSE
	#{
		sv_u = urhk_SetOrbOut("RESULT_MSG|Interest collection failed")
        	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
	#}
        ENDIF

	ENDOFSCRIPT:
        TRACE OFF
        EXITSCRIPT
END-->


