#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
	EQGTG.GLBDATA.goalAmount = 0 
	EQGTG.GLBDATA.WithDrawAmount = 0
	EQGTG.GLBDATA.goalBalance = 0
	EQGTG.GLBDATA.goalCrncy = "KES"
	EQGTG.GLBDATA.goalSchmType = ""
	if(fieldexists(BANCS.INPUT.GoalAccountId)==1)then
		EQGTG.GLBDATA.GoalAccountId = BANCS.INPUT.GoalAccountId	
	else
		EQGTG.GLBDATA.GoalAccountId = ""
	endif
	if(EQGTG.GLBDATA.GoalAccountId == "")then
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Invalid Goal Account " + EQGTG.GLBDATA.GoalAccountId ) 
		exitscript
	else
		sv_u = urhk_getAcctDetailsInRepository(EQGTG.GLBDATA.GoalAccountId)
		if(sv_u==0)then
			EQGTG.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance	
			EQGTG.GLBDATA.AvailableAmt = BANCS.OUTPARAM.AvailableAmt
			EQGTG.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
			EQGTG.GLBDATA.goalCrncy = BANCS.OUTPARAM.acctCrncyCode
			EQGTG.GLBDATA.goalSchmType = BANCS.OUTPARAM.schmType
			sv_u = urhk_B2k_ForacidToAcid(EQGTG.GLBDATA.GoalAccountId)
			if(sv_u==0)then
				EQGTG.GLBDATA.goalacid = BANCS.OUTPARAM.Acid	
			else
				sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
				sv_u = urhk_SetOrbOut("Message|Invalid Goal Account " + EQGTG.GLBDATA.GoalAccountId ) 
				exitscript
			endif
		else
			sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
			sv_u = urhk_SetOrbOut("Message|Invalid Goal Account " + EQGTG.GLBDATA.GoalAccountId ) 
			exitscript
		endif
	endif
	if(EQGTG.GLBDATA.goalSchmType == "TUA")then
		sv_d = "goalAmount | select sum(tran_amt) from tbaadm.dtt where acid=?SVAR "
		sv_d = sv_d + "  and flow_code in ('ID','TI') and bank_id=?SVAR and del_flg='N' "
		BANCS.INPARAM.BINDVARS = EQGTG.GLBDATA.goalacid + "|" + BANCS.STDIN.contextBankId
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.goalAmount = cdouble(BANCS.OUTPARAM.goalAmount)
		else
			EQGTG.GLBDATA.goalAmount = 0
		endif
		sv_d = "WithDrawAmount | select sum(tran_amt) from tbaadm.dtt where acid=?SVAR "
		sv_d = sv_d + "  and flow_code in ('TO') and bank_id=?SVAR and del_flg='N' "
		BANCS.INPARAM.BINDVARS = EQGTG.GLBDATA.goalacid + "|" + BANCS.STDIN.contextBankId
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.WithDrawAmount = cdouble(BANCS.OUTPARAM.WithDrawAmount)
		else
			EQGTG.GLBDATA.WithDrawAmount = 0
		endif
		print(EQGTG.GLBDATA.goalAmount)
		print(EQGTG.GLBDATA.WithDrawAmount)
		EQGTG.GLBDATA.goalBalance = cdouble(EQGTG.GLBDATA.goalAmount) - cdouble(EQGTG.GLBDATA.WithDrawAmount)
		print(EQGTG.GLBDATA.goalBalance)
	endif
	if(EQGTG.GLBDATA.goalSchmType == "SBA")then
	#{
		EQGTG.GLBDATA.hgoalAmount = "0"
		EQGTG.GLBDATA.dgoalAmount = "0"
		EQGTG.GLBDATA.goalAmount = "0"
		EQGTG.GLBDATA.hwdAmt = "0"
		EQGTG.GLBDATA.dwdAmt = "0"
		EQGTG.GLBDATA.WithDrawAmount= "0"
		sv_d = "hgoalAmount | select sum(tran_amt) from tbaadm.htd where acid=?SVAR and bank_id=?SVAR and del_flg='N' and pstd_flg='Y' "
		sv_d = sv_d + " and part_tran_type ='C' "
		BANCS.INPARAM.BINDVARS = EQGTG.GLBDATA.goalacid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.hgoalAmount = BANCS.OUTPARAM.hgoalAmount
		else
			EQGTG.GLBDATA.hgoalAmount = 0
		endif
		sv_d = "dgoalAmount | select sum(tran_amt) from tbaadm.dtd where acid=?SVAR and bank_id=?SVAR and del_flg='N' and pstd_flg='Y' "
		sv_d = sv_d + " and part_tran_type ='C' "
		BANCS.INPARAM.BINDVARS = EQGTG.GLBDATA.goalacid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.dgoalAmount = BANCS.OUTPARAM.dgoalAmount
		else
			EQGTG.GLBDATA.dgoalAmount = 0
		endif
		EQGTG.GLBDATA.goalAmount = cdouble(EQGTG.GLBDATA.hgoalAmount) + cdouble(EQGTG.GLBDATA.dgoalAmount)
		sv_d = "hwdAmt | select sum(tran_amt) from tbaadm.htd where acid=?SVAR and bank_id=?SVAR and del_flg='N' and pstd_flg='Y' "
		sv_d = sv_d + " and part_tran_type ='D' "
		BANCS.INPARAM.BINDVARS = EQGTG.GLBDATA.goalacid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.hwdAmt = BANCS.OUTPARAM.hwdAmt
		else
			EQGTG.GLBDATA.hwdAmt = 0
		endif
		sv_d = "dwdAmt | select sum(tran_amt) from tbaadm.dtd where acid=?SVAR and bank_id=?SVAR and del_flg='N' and pstd_flg='Y' "
		sv_d = sv_d + " and part_tran_type ='D' "
		BANCS.INPARAM.BINDVARS = EQGTG.GLBDATA.goalacid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.dwdAmt = BANCS.OUTPARAM.dwdAmt
		else
			EQGTG.GLBDATA.dwdAmt = 0
		endif
		EQGTG.GLBDATA.WithDrawAmount = cdouble(EQGTG.GLBDATA.hwdAmt) + cdouble(EQGTG.GLBDATA.dwdAmt)
		EQGTG.GLBDATA.goalBalance = cdouble(EQGTG.GLBDATA.goalAmount) - cdouble(EQGTG.GLBDATA.WithDrawAmount)
	#}
	endif
	sv_u = urhk_SetOrbOut("SuccessOrFailure|S")	
	sv_u = urhk_SetOrbOut("GoalAccountId|" + EQGTG.GLBDATA.GoalAccountId )
	sv_u = urhk_SetOrbOut("GoalCurrency|" + EQGTG.GLBDATA.goalCrncy )
	sv_u = urhk_SetOrbOut("TotallGoalAmount|" + EQGTG.GLBDATA.goalAmount ) 
	sv_u = urhk_SetOrbOut("WithDrawnAmount|" + EQGTG.GLBDATA.WithDrawAmount ) 
	sv_u = urhk_SetOrbOut("GoalBalance|" + EQGTG.GLBDATA.goalBalance ) 
	exitscript
trace off
end-->
