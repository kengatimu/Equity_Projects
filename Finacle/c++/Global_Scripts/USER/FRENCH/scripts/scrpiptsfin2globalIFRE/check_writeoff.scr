<--start	
TRACE ON

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","INTERFACE") == 0) THEN
#{
	CREATECLASS ("CUST","INTERFACE",5)
#}
ENDIF

sv_a = urhk_B2k_PrintRepos("BANCS")
print(sv_a)

CUST.INTERFACE.BANK_ID =""
CUST.INTERFACE.FORACID =""
CUST.INTERFACE.ACCT_NAME =""
CUST.INTERFACE.CHRGE_OFF_FLG =""
CUST.INTERFACE.acct =""

BANCS.INPUT.acct = trim(BANCS.INPUT.acct)
print(BANCS.INPUT.acct)

sv_s ="SOL_ID,BANK_ID,FORACID,ACCT_NAME,CHRGE_OFF_FLG|select gam.sol_id,gam.bank_id,gam.foracid,gam.ACCT_NAME,gac.CHRGE_OFF_FLG"
sv_s = sv_s + " from tbaadm.gac,tbaadm.gam "
sv_s = sv_s + " where gam.acid=gac.acid "
sv_s = sv_s + " and gam.BANK_ID=gac.BANK_ID and gam.schm_type in ('SBA','CAA') "
sv_s = sv_s + " and gac.CHRGE_OFF_FLG ='Y' "
sv_s = sv_s + " and gam.BANK_ID= ?SVAR "
sv_s = sv_s + " and gam.foracid=?SVAR "
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.acct
PRINT(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF (sv_d == 0) THEN
	CUST.INTERFACE.CHRGE_OFF_FLG = BANCS.OUTPARAM.CHRGE_OFF_FLG
	print(CUST.INTERFACE.CHRGE_OFF_FLG)
	CUST.INTERFACE.output = CUST.INTERFACE.CHRGE_OFF_FLG
	print(CUST.INTERFACE.output)
	CUST.INTERFACE.FORACID = BANCS.OUTPARAM.FORACID
	PRINT(CUST.INTERFACE.FORACID)
	CUST.INTERFACE.output2 = CUST.INTERFACE.FORACID
	print(CUST.INTERFACE.output2)
	CUST.INTERFACE.ACCT_NAME = MID$(BANCS.OUTPARAM.ACCT_NAME,0,30)
	PRINT(CUST.INTERFACE.ACCT_NAME)
	CUST.INTERFACE.output4 = CUST.INTERFACE.ACCT_NAME
	print(CUST.INTERFACE.output4)
	CUST.INTERFACE.SOL_ID = BANCS.OUTPARAM.SOL_ID
	PRINT(CUST.INTERFACE.SOL_ID)
	CUST.INTERFACE.output5 = CUST.INTERFACE.SOL_ID
	print(CUST.INTERFACE.output5)
	CUST.INTERFACE.acctsuspnes="3000100774"
	CUST.INTERFACE.output5= CUST.INTERFACE.output5 + CUST.INTERFACE.acctsuspnes 
	print(CUST.INTERFACE.output5)
	sv_z = urhk_SetOrbOut("output|"+CUST.INTERFACE.output)
	print(sv_z)
	sv_z = urhk_SetOrbOut("output2|"+CUST.INTERFACE.output2)
	print(sv_z)
	sv_z = urhk_SetOrbOut("output4|"+CUST.INTERFACE.output4)
	print(sv_z)
	sv_z = urhk_SetOrbOut("output5|"+CUST.INTERFACE.output5)
	print(sv_z)

ELSE
	CUST.INTERFACE.output = "N"
	print(CUST.INTERFACE.output)
	sv_z = urhk_SetOrbOut("output|"+CUST.INTERFACE.output)
	print(sv_z)
ENDIF

#trace off
END-->