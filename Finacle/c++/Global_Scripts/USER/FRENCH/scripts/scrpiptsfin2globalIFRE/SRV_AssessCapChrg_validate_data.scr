<--start
trace on
IF (BANCS.STDIN.moduleIdentity == "FI") THEN
#{
if (REPEXISTS("EQULO") == 0) then
	CREATEREP("EQULO")
endif

if (CLASSEXISTS("EQULO", "LOAN") == 0) then
	CREATECLASS("EQULO", "LOAN", 5)
endif

EQULO.LOAN.bodDate1 = MID$(BANCS.STDIN.BODDate,0,10)
EQULO.LOAN.date = EQULO.LOAN.bodDate1 + " 00:00:00" 

sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.schmCode.schmCode")
sv_b=BANCS.OUTPARAM.srvValue
print(sv_b)

EQULO.LOAN.SchmCode = sv_b
print(EQULO.LOAN.SchmCode)

IF ((sv_b=="LA527") OR (sv_b=="LA529") OR (sv_b=="LA548") OR (sv_b == "LA537") OR (sv_b == "LA510")) THEN
#{

sv_a = urhk_SRV_NumOfRecs("capitalizeChrgAssess.capitalizeChargeLL")
print(sv_a)
IF( sv_a == 0 ) THEN
#{
	sv_b = BANCS.OUTPARAM.srvValue
	EQULO.LOAN.MulRecCnt = sv_b
	IF(CINT(EQULO.LOAN.MulRecCnt) != 0) THEN
	#{
		EQULO.LOAN.limitcounter = "0"
		WHILE(CINT(EQULO.LOAN.limitcounter) < CINT(EQULO.LOAN.MulRecCnt))
			sv_c = CINT(EQULO.LOAN.limitcounter)
			sv_e = FORMAT$(sv_c,"%d")
			EQULO.LOAN.limitcounter = CINT(EQULO.LOAN.limitcounter) + 1
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.llkey.serial_num")
			EQULO.LOAN.serial_num = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.serial_num != "") THEN
      	        ("EQULO").("LOAN").("serialNum_"+sv_e) = EQULO.LOAN.serial_num
			ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.chrgType")
			EQULO.LOAN.chrgType = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.chrgType != "") THEN
				("EQULO").("LOAN").("chrgType_"+sv_e) = EQULO.LOAN.chrgType
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.chrgEventType")
			EQULO.LOAN.chrgEventType = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.chrgEventType != "") THEN
				("EQULO").("LOAN").("chrgEventType_"+sv_e) = EQULO.LOAN.chrgEventType
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.chrgEventId")
			EQULO.LOAN.chrgEventId = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.chrgEventId != "") THEN
      	        ("EQULO").("LOAN").("chrgEventId_"+sv_e) = EQULO.LOAN.chrgEventId
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.chrgCrncy")
			EQULO.LOAN.chrgCrncy = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.chrgCrncy != "") THEN
      	        ("EQULO").("LOAN").("chrgCrncy_"+sv_e) = EQULO.LOAN.chrgCrncy
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.userCalcChrgAmt")
			EQULO.LOAN.userCalcChrgAmt = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.userCalcChrgAmt != "") THEN
      	        ("EQULO").("LOAN").("userCalcChrgAmt_"+sv_e) = EQULO.LOAN.userCalcChrgAmt
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.sysCalcChrgAmt")
			EQULO.LOAN.sysCalcChrgAmt = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.sysCalcChrgAmt != "") THEN
      	        #("EQULO").("LOAN").("systemChargeAmt_"+sv_e) = EQULO.LOAN.sysCalcChrgAmt
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.collectedChrgAmt")
			EQULO.LOAN.collectedChrgAmt = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.collectedChrgAmt != "") THEN
      	        #("EQULO").("LOAN").("collectedChrgAmt_"+sv_e) = EQULO.LOAN.collectedChrgAmt
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.waivedChrgAmt")
			EQULO.LOAN.waivedChrgAmt = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.waivedChrgAmt != "") THEN
      	        ("EQULO").("LOAN").("waivedChrgAmt_"+sv_e) = EQULO.LOAN.waivedChrgAmt
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.modifyFlg")
			EQULO.LOAN.modifyFlg = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.modifyFlg != "") THEN
      	        ("EQULO").("LOAN").("modifyFlg_"+sv_e) = EQULO.LOAN.modifyFlg
            ENDIF
			
			sv_a = urhk_SRV_GetVal("capitalizeChrgAssess.capitalizeChargeLL.<rec_"+sv_e+">.selFlg")
			EQULO.LOAN.selFlg = BANCS.OUTPARAM.srvValue
			IF(EQULO.LOAN.selFlg != "") THEN
      	        ("EQULO").("LOAN").("selFlg_"+sv_e) = EQULO.LOAN.selFlg
            ENDIF
		DO
	#}
	ENDIF
#}
ENDIF
#}
ENDIF
#}
ENDIF
#}
trace off
exitscript
end-->
