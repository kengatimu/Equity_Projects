				MISS.CHRG.tranid="NULL"
			#}
			ENDIF
STEP3:
				print(MISS.CHRG.getboddate)

				MISS.CHRG.ERROR_SUCCESS_MESSAGE = "SUCCESS"
				print(MISS.CHRG.ERROR_SUCCESS_MESSAGE)

				sv_s = " update custom.POLARIS_DATA_TABLE set STATUS=?SVAR, ERROR_DESC=?SVAR "
				sv_s = sv_s + "  where TRANSACTION_CODE ='717' and SEQ_ID=?SVAR  and BANKID=?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = MISS.CHRG.finalstatus + "|" + MISS.CHRG.error_desc + "|" +  MISS.CHRG.seqid + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)

				sv_d = urhk_dbSQLWithBind(sv_s)
				print(sv_d)
				sv_d = urhk_dbSQLWithBind("COMMIT")
				print(sv_d)
