<--START
CHECKSUM="2893362505eb7eb799c253c0dc6c7615c4c9f97af3207ee3965e4ecbb8de5790"
	TRACE ON
	
	#---------------------------------------------------------------------------
	# CREATING NEW REPOSITORY AND CLASS
	#---------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.errMsg = ""
	
	PRINT(BANCS.INPUT.funcCode)
	
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Function Code
	#---------------------------------------------------------------------------
	#{
	PRINT(BANCS.INPUT.funcCode)
	IF (BANCS.INPUT.funcCode == "") THEN
	#{
		sv_e = "Function code need to be entered "
		sv_m = "funcCode"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO Finish1
		#}
	ELSE
		#{
		IF ((BANCS.INPUT.funcCode != "A") AND (BANCS.INPUT.funcCode != "M") AND (BANCS.INPUT.funcCode != "I") AND (BANCS.INPUT.funcCode != "D")) THEN
		#{
			sv_e = "Only M(Modify)/A(Add)/I(Inquiry)/D(Delete) is allowed "
			sv_m = "funcCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO Finish1
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Currency Code
	#---------------------------------------------------------------------------
	#{
	IF (BANCS.INPUT.currCode == "") THEN
	#{
		sv_e = "Currency Code must be entered "
		sv_m = "currCode"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO Finish1
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.currCode)
	IF (BANCS.INPUT.funcCode == "A") THEN
	#{
		sv_s = "flg|SELECT COUNT(1) "
		sv_s = sv_s + "FROM CUSTOM.FX_REVAL "
		sv_s = sv_s + "WHERE currency_code = ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.currCode + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.flg)
			CUST.DATA.flg = BANCS.OUTPARAM.flg
			#}
		ELSE
			#{
			CUST.DATA.flg = ""
		#}
		ENDIF
		IF (CUST.DATA.flg != 0) THEN
		#{
			sv_e = "Currency Code Already present "
			sv_m = "currCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO Finish1
		#}
		ENDIF
		
		
		IF (BANCS.INPUT.currCode != "") THEN
		#{
			sv_s = "flg|SELECT COUNT(1) "
			sv_s = sv_s + "FROM TBAADM.GAM "
			sv_s = sv_s + "WHERE acct_crncy_code = TRIM(?SVAR) "
			sv_s = sv_s + "AND bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.currCode + "|" + BANCS.STDIN.contextBankId
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				CUST.DATA.flg = BANCS.OUTPARAM.flg
				#}
			ELSE
				#{
				CUST.DATA.flg = ""
			#}
			ENDIF
			IF (CUST.DATA.flg == 0) THEN
			#{
				sv_e = "Invalid Currency Code.Please enter a valid Currency Code "
				sv_m = "currCode"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO Finish1
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF (BANCS.INPUT.funcCode == "M") THEN
	#{
		sv_s = "flg|SELECT COUNT(1) "
		sv_s = sv_s + "FROM CUSTOM.FX_REVAL "
		sv_s = sv_s + "WHERE currency_code = ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.currCode + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.flg)
			CUST.DATA.flg = BANCS.OUTPARAM.flg
			#}
		ELSE
			#{
			CUST.DATA.flg = ""
		#}
		ENDIF
		IF (CUST.DATA.flg == 0) THEN
		#{
			sv_e = "Currency Code doesnt exists "
			sv_m = "currCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO Finish1
		#}
		ENDIF
	#}
	ENDIF
	
	IF (BANCS.INPUT.funcCode == "M" OR BANCS.INPUT.funcCode == "D" OR BANCS.INPUT.funcCode == "I") THEN
	#{
		sv_s = "crncyCode,rateCode,pnlAccnt,homeCcyAccnt,foreCcyAccnt|"
		sv_s = sv_s + "SELECT currency_code,rate_code,pnl_account,homecy_account,foreigncy_account "
		sv_s = sv_s + "FROM CUSTOM.FX_REVAL "
		sv_s = sv_s + "WHERE currency_code = ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.currCode + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.DATA.dba_crncyCode   = BANCS.OUTPARAM.crncyCode
			PRINT(CUST.DATA.dba_crncyCode)
			CUST.DATA.dba_rateCode = BANCS.OUTPARAM.rateCode
			PRINT(CUST.DATA.dba_rateCode)
			CUST.DATA.dba_pnlAccnt = BANCS.OUTPARAM.pnlAccnt
			PRINT(CUST.DATA.dba_pnlAccnt)
			CUST.DATA.dba_homeCcyAccnt = BANCS.OUTPARAM.homeCcyAccnt
			PRINT(CUST.DATA.dba_homeCcyAccnt)
			CUST.DATA.dba_foreCcyAccnt = BANCS.OUTPARAM.foreCcyAccnt
			PRINT(CUST.DATA.dba_foreCcyAccnt)
			sv_u = urhk_SetOrbOut("currCode| " + CUST.DATA.dba_crncyCode)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("rateCode| " + CUST.DATA.dba_rateCode)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("pnlAccnt| " + CUST.DATA.dba_pnlAccnt)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("homeCyAccnt| " + CUST.DATA.dba_homeCcyAccnt)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("foreignCyAccnt| " + CUST.DATA.dba_foreCcyAccnt)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			PRINT(sv_u)
			sv_b = urhk_SetOrbOut("SetSize|30")
			sv_c = urhk_SetOrbOut("RecordsPerPage|50")
			sv_g = urhk_SetOrbOut("recCount|100")
			sv_k = urhk_SetOrbOut("columnCount|8")
			GOTO Finish1
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	PRINT(sv_u)
	
	Finish1:
		TRACE OFF
		EXITSCRIPT
END-->
