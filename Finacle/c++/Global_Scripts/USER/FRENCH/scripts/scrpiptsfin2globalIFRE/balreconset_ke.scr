###########################################################################################
# Initailizing the GL accounts no for Kenya 54
###########################################################################################

CUST.CIETXN.suspense = "0001300104489"
CUST.CIETXN.settlmnt = "0001100104469"
CUST.CIETXN.suspense_fin = "6000130014489"


sv_q = ""
sv_q = " sumsuspense | select sum(tran_amt) from TBAADM.CTD_DTD_ACLI_VIEW where acid in (select acid from tbaadm.gam "
sv_q = sv_q + "where foracid =?SVAR ) and tran_date= to_date(sysdate, 'DD-MON-YY') and PART_TRAN_TYPE ='C' "
BANCS.INPARAM.BINDVARS = CUST.CIETXN.suspense 
print(sv_q)
sv_w =  urhk_dbSelectWithBind(sv_q)
print(sv_w)

	IF (sv_w==0) THEN
        #{
        	CUST.CIETXN.sumsuspense=FORMAT$(CDOUBLE(BANCS.OUTPARAM.sumsuspense),"%.2f")
                print(CUST.CIETXN.sumsuspense)

###############################Calculate totoal EOD balance for 99 entity####################

sv_q=""
sv_q = "sumsuspense_fin | select sum(tran_amt) from TBAADM.CTD_DTD_ACLI_VIEW where acid in (select acid from tbaadm.gam "
sv_q = sv_q + "where foracid =?SVAR ) and tran_date= to_date(sysdate, 'DD-MON-YY') and PART_TRAN_TYPE ='D' "
BANCS.INPARAM.BINDVARS = CUST.CIETXN.suspense_fin
print(BANCS.INPARAM.BINDVARS)
print(sv_q)
sv_w =  urhk_dbSelectWithBind(sv_q)
print(sv_w)

        IF (sv_w==0) THEN
        #{
                CUST.CIETXN.sumsuspense_fin=FORMAT$(CDOUBLE(BANCS.OUTPARAM.sumsuspense_fin),"%.2f")
                print(CUST.CIETXN.sumsuspense_fin)
        #}
        ENDIF
###############################################################################################

IF (CUST.CIETXN.sumsuspense != CUST.CIETXN.sumsuspense_fin) THEN
#{

        print("The Total EOD balance is mismatch")
