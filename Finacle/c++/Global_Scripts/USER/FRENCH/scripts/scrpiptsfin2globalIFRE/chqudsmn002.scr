<--START
CHECKSUM="0eb9601ce3fcd38eaa66681805787005b89687b958f800386b9e6e73f64f0b44"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
