	CUST.CHQB.instType		= BANCS.INPUT.instType
	print(CUST.CHQB.instType)
	CUST.CHQB.instNum		= BANCS.INPUT.instNum
	CUST.CHQB.beginNum 		= BANCS.INPUT.beginNum
	CUST.CHQB.newStatus 	= BANCS.INPUT.newStatus
	#CUST.CHQB.numLeaves		= BANCS.INPUT.numLeaves
	CUST.CHQB.currStatus	= BANCS.INPUT.currStatus
	
	IF(CUST.CHQB.function == "M") THEN
	#{
		IF((CUST.CHQB.newStatus != "P" ) AND (CUST.CHQB.newStatus != "U")) THEN
		#{
			sv_e = "Invalid New status. valid values U-Unpaid,P-Paid"
			sv_m = "newStatus"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ( CUST.CHQB.newStatus == CUST.CHQB.currStatus) THEN
		#{
			sv_e = "Old AND New Status should not be same"
			sv_m = "newStatus"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------
		# Insert into C_CBT_MOD1
		#----------------------------------------
		
		sv_x = "INSERT INTO CUSTOM.C_CBT_MOD1 VALUES("
		sv_x = sv_x + "?SVAR, "
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "'N',"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "sysdate,"
		sv_x = sv_x + "?SVAR ,"
		sv_x = sv_x + "sysdate,?SVAR)"
		print(sv_x)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + CUST.CHQB.instType + "|" + CUST.CHQB.beginNum + " |" + CUST.CHQB.currStatus + "|" + CUST.CHQB.newStatus + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId +"|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSQLWithBind(sv_x)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			sv_e = "DataBase Error. Contact your DBA"
			sv_m = "Err"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_g = "RESULT_MSG|Record successfully modified for the account no. "+CUST.CHQB.acctNum
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_k = urhk_SetOrbOut(sv_g)
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
