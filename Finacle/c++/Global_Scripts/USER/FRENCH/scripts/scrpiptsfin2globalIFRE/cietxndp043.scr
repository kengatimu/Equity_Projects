<--START
CHECKSUM="ca291eedf09e3e7dd407405316519c47c78096bc19f61aaa5d1f632325fdbca5"
	TRACE ON
	
	CUST.CIETXN.scriptSuccess = "Y"
	
	sv_s = "UPDATE CUSTOM.IEPAGL SET "
	sv_s = sv_s + " TARGET_ENTITY_ID = ?SVAR" + ","
	sv_s = sv_s + " ENTITY1_PYMT_TRAN_ID = ?SVAR" + ","
	sv_s = sv_s + " ENTITY1_PYMT_TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_s = sv_s + " ENTITY2_PYMT_TRAN_ID = ?SVAR" + ","
	sv_s = sv_s + " ENTITY2_PYMT_TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_s = sv_s + " NOSTRO_ACCOUNT_ID = ?SVAR" + ","
	sv_s = sv_s + " VOSTRO_ACCOUNT_ID = ?SVAR" + ","
	sv_s = sv_s + " STATUS_FLG = 'P',"
	sv_s = sv_s + " LCHG_USER_ID = ?SVAR" + ","
	sv_s = sv_s + " LCHG_TIME = sysdate"
	sv_s = sv_s + " WHERE IE_TXN_REF_NO = ?SVAR"
	sv_s = sv_s + " AND INIT_ENTITY_ID = ?SVAR"
	
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.entity2TranId		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.entity2TranDate		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.entity1TranId             + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.entity1TranDate           + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.vostroAcct		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.nostroAcct                + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId			+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.ieTxnRefNo		+ "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.ieTxnInitEntity
	
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.scriptSuccess = "N"
		CUST.CIETXN.errorMsg = "Database Update Operation Failed ON Custom Table"
		sv_u = urhk_SRV_SetErr(CUST.CIETXN.errorMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
END-->
