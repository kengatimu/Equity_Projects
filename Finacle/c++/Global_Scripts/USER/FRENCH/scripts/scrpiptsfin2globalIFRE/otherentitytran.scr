<--start
trace on

###########################################################################################
# Check whether CUST Repository exists else create it
###########################################################################################

sv_r = REPEXISTS("CUST")

IF(sv_r == 0) THEN
#{
        CREATEREP ("CUST")
#}
ENDIF

###########################################################################################
# Check whether CIETXN Class exists else create it
###########################################################################################

sv_r = CLASSEXISTS("CUST","DATA")

IF(sv_r == 0) THEN
#{
        CREATECLASS ("CUST","DATA",5)
#}
ENDIF



sv_s = "RequestID1|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0)THEN
#{
        CUST.CIETXN.RequestID1 = BANCS.OUTPARAM.RequestID1
        print(CUST.CIETXN.RequestID1)
#}
ELSE
#{
        CUST.CIETXN.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
        print(CUST.CIETXN.RequestID1)
#}
ENDIF

CUST.DATA.RequestID1=CUST.CIETXN.RequestID1



#-------------------------------------------------------------------------
# Fetch the current data time to send in request header
#-------------------------------------------------------------------------
sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
	CUST.DATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
	print(CUST.DATA.msgDateTime)
#}
ENDIF

#-------------------------------------------------------------------------
#- Forming the Header for XferTrnAdd
#-------------------------------------------------------------------------
CUST.DATA.headerXML = ""
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Header>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestHeader>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<MessageKey>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestUUID>"+ CUST.DATA.RequestID1 +"</RequestUUID>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ServiceRequestId>XferTrnAdd</ServiceRequestId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ChannelId>" + CUST.DATA.channelID + "</ChannelId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<LanguageId></LanguageId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</MessageKey>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestMessageInfo>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<BankId>" + CUST.DATA.bankID + "</BankId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<TimeZone></TimeZone>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<EntityId></EntityId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<EntityType></EntityType>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ArmCorrelationId></ArmCorrelationId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<MessageDateTime>" + CUST.DATA.msgDateTime + "</MessageDateTime>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</RequestMessageInfo>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Security>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Token>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<PasswordToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<UserId></UserId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Password></Password>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</PasswordToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</Token>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<FICertToken></FICertToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUserLoginSessionId></RealUserLoginSessionId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUser></RealUser>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUserPwd></RealUserPwd>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<SSOTransferToken></SSOTransferToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</Security>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</RequestHeader>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</Header>"

#-------------------------------------------------------------------------
#- Forming the Body for XferTrnAdd
#-------------------------------------------------------------------------
CUST.DATA.bodyXMLMsg = ""
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<body><XferTrnAddRequest>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<XferTrnAddRq>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<XferTrnHdr>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnType>" + CUST.DATA.tranType + "</TrnType>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnSubType>" + CUST.DATA.tranSubType + "</TrnSubType>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</XferTrnHdr>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<XferTrnDetail>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PartTrnRec>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>" + CUST.DATA.drAcctID + "</AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<CreditDebitFlg>D</CreditDebitFlg>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnAmt>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<amountValue>" + CUST.DATA.tranAmtDr + "</amountValue>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<currencyCode>" + CUST.DATA.tranCcyDr + "</currencyCode>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</TrnAmt>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnParticulars>" + CUST.DATA.tranParticularsDr + "</TrnParticulars>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PartTrnRmks>" + CUST.DATA.tranRmksDr + "</PartTrnRmks>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<ValueDt>"+ CUST.DATA.msgDateTime + "</ValueDt>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<Rate>" + CUST.DATA.drRate + "</Rate>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<RateCode>" + CUST.DATA.rateCode + "</RateCode>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<SerialNum>1</SerialNum>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</PartTrnRec>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PartTrnRec>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>" + CUST.DATA.crAcctID + "</AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<CreditDebitFlg>C</CreditDebitFlg>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnAmt>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<amountValue>" + CUST.DATA.tranAmtCr + "</amountValue>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<currencyCode>" + CUST.DATA.tranCcyCr + "</currencyCode>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</TrnAmt>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnParticulars>" + CUST.DATA.tranParticularsCr + "</TrnParticulars>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PartTrnRmks>" + CUST.DATA.tranRmksCr + "</PartTrnRmks>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<ValueDt>"+ CUST.DATA.msgDateTime + "</ValueDt>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<Rate>" + CUST.DATA.crRate + "</Rate>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<RateCode>" + CUST.DATA.rateCode + "</RateCode>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<SerialNum>2</SerialNum>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</PartTrnRec>"
IF(CUST.DATA.chargeAmtPartTran == "Y")THEN
#{
	    IF(CDOUBLE(CUST.DATA.chargeTranAmt) > 0)THEN
	    #{
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PartTrnRec>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>" + CUST.DATA.crAcctID1 + "</AcctId>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</AcctId>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<CreditDebitFlg>C</CreditDebitFlg>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnAmt>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<amountValue>" + CUST.DATA.chargeTranAmt + "</amountValue>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<currencyCode>" + CUST.DATA.chargeTranCcy + "</currencyCode>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</TrnAmt>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TrnParticulars>" + CUST.DATA.chargeTranParticulars + "</TrnParticulars>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PartTrnRmks>" + CUST.DATA.chargeTranRmks + "</PartTrnRmks>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<ValueDt>"+ CUST.DATA.msgDateTime + "</ValueDt>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<Rate>" + CUST.DATA.crRate + "</Rate>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<RateCode>" + CUST.DATA.rateCode + "</RateCode>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<SerialNum>3</SerialNum>"
                CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</PartTrnRec>"
	    #}
	    ENDIF

#}
ENDIF
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</XferTrnDetail>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</XferTrnAddRq>"

CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<XferTrnAdd_CustomData>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PARTTRANDTLS isMultiRec='Y'>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<SRLNUM>1</SRLNUM>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<REFNUM>" + CUST.DATA.refNumDr + "</REFNUM>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TRANPARTICULARS2>" + CUST.DATA.tranParticulars2Dr + "</TRANPARTICULARS2>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</PARTTRANDTLS>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<PARTTRANDTLS isMultiRec='Y'>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<SRLNUM>2</SRLNUM>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<REFNUM>" + CUST.DATA.refNumCr + "</REFNUM>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<TRANPARTICULARS2>" + CUST.DATA.tranParticulars2Cr + "</TRANPARTICULARS2>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</PARTTRANDTLS>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</XferTrnAdd_CustomData>"

CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</XferTrnAddRequest></body>"

print(CUST.DATA.bodyXMLMsg)

#trace off
end-->

