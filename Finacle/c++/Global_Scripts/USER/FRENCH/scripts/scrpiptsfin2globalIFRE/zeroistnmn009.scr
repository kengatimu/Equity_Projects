CHECKSUM="eed60ac08dfe30d2344af16ea16cec6ff8f118cbb668f002a9303d3d9b041a1a"
	TRACE ON
	#------------------------------------------------------------------------------
	# Creating repository and class
	# Initializing the variables
	#----------------------------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","MLINE") == 0) THEN
	#{
		CREATECLASS("CUST","MLINE",5)
	#}
	ENDIF
	
	CUST.MLINE.errMsg         = ""
	CUST.MLINE.brAccount      = ""
	CUST.MLINE.hoAccount      = ""
	CUST.MLINE.narr1          = ""
	CUST.MLINE.tranAmt        = ""
	CUST.MLINE.tranRmks       = ""
	CUST.MLINE.crRefNum       = ""
	CUST.MLINE.dbRefNum       = ""
	CUST.MLINE.crdr0          = ""
	CUST.MLINE.crdr1          = ""
	CUST.MLINE.refCode        = ""
	BANCS.INPUT.moduleName    = ""
	BANCS.INPUT.parameterId   = ""
	
	#------------------------------------------------------------------
	# Getting all the values from CPARAM
	#------------------------------------------------------------------
	sv_a = BANCS.STDIN.mySolId
	PRINT(sv_a)
	BANCS.INPUT.moduleName = "ZEROISTN"
	BANCS.INPUT.parameterId = "MLINE_BRACCOUNT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		PRINT(BANCS.OUTPUT.parameterVal)
		CUST.MLINE.brAccount =  sv_a + BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.MLINE.errMsg = "debit Account setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MLINE_HOACCOUNT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		PRINT(BANCS.OUTPUT.parameterVal)
		CUST.MLINE.hoAccount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.MLINE.errMsg = "credit Account setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MLINE_NARR1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		PRINT(BANCS.OUTPUT.parameterVal)
		CUST.MLINE.narr1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.MLINE.narr1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.MLINE.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.MLINE.refCode)
		#}
	ELSE
		#{
		CUST.MLINE.errMsg = "Ratecode set up not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Getting  amount
	#------------------------------------------------------------------------------
	
	sv_s = "clearBalance |SELECT clr_bal_amt "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.MLINE.brAccount
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.MLINE.tranAmt = BANCS.OUTPARAM.clearBalance
		IF (CDOUBLE(CUST.MLINE.tranAmt) == 0) THEN
		#{
			EXITSCRIPT
		#}
		ENDIF
		PRINT(CUST.MLINE.tranAmt)
		
		IF (CDOUBLE(CUST.MLINE.tranAmt) < 0) THEN
		#{
			CUST.MLINE.tranAmt = ( CDOUBLE(CUST.MLINE.tranAmt) * -1 )
			CUST.MLINE.crdr0 = "D"
			CUST.MLINE.crdr1 = "C"
			#}
		ELSE
			#{
			CUST.MLINE.crdr0 = "C"
			CUST.MLINE.crdr1 = "D"
		#}
		ENDIF
	#}
	ELSE
		#{
		CUST.MLINE.tranAmt = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------
	# Passing transaction inputs to the service
	# Adding and Posting the transaction
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|" + CUST.MLINE.narr1)
	
	sv_w = "tranDtl.partTranDetailLL.<rec_0>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|1")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|" + CUST.MLINE.crdr0)
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.MLINE.hoAccount)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+CUST.MLINE.narr1)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks|" + CUST.MLINE.tranRmks)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum|" + CUST.MLINE.crRefNum)
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|" + CUST.MLINE.tranAmt + "|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.MLINE.tranAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.MLINE.refCode)
	
	sv_w = "tranDtl.partTranDetailLL.<rec_1>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|2")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|" + CUST.MLINE.crdr1)
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.MLINE.brAccount)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|" + CUST.MLINE.narr1)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks|"+CUST.MLINE.tranRmks)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum|" + CUST.MLINE.dbRefNum)
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.MLINE.tranAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.MLINE.tranAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.MLINE.refCode)
	
	sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
	PRINT(sv_u)
	IF(sv_u != 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
		PRINT(sv_u)
	#}
	ENDIF
	
	IF(sv_u == 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
		PRINT(sv_u)
		IF(sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			PRINT(sv_u)
			IF(sv_u != 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
	#{
		PRINT(BANCS.OUTPARAM.tranId)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.MLINE.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.MLINE.errMsg+"' >>ZRTN9.log")
		#}
		ENDIF
		
		EXITSCRIPT
		
		TRACE OFF
END-->
