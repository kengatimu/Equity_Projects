<--START
CHECKSUM="571745b84caac8ebcbae5746b207063b47b5e813a96511e884e72c51f6fe33ce"
	TRACE ON
	
	CALL("Common_Interface_CreateRepos.scr")
	
	sv_b = BANCS.STDIN.contextBankId
	print(sv_b)
	
	sv_q="foracid,solid,remitCrncy,awinstAcct,benefName,benfaddress1,benefCtryCode,Bic,others,amount,sequence,freetext1,error_code|"
	sv_q = sv_q + " select foracid,sol_id,remitCrncy,awinstAcct,benefName,benfaddress1,benefCtryCode,Bic,others,amount,sequence,freetext1,error_code from "
	sv_q = sv_q + " CUSTOM.PORDM_MER where bank_id = ?SVAR AND ENTITY_CRE_FLG='N'"
	print(sv_q)
	BANCS.INPARAM.BINDVARS = sv_b
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_q)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		
		CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			
			
			CUST.INTERFACE.interfaceRequestID = "executeFinacleScript"
			CUST.INTERFACE.interfaceRequestVersion = "10.2"
			CUST.INTERFACE.bankID = BANCS.STDIN.contextBankId
			CUST.INTERFACE.channelID = "MER"
			CUST.INTERFACE.BODDate=BANCS.STDIN.BODDate
			print(CUST.INTERFACE.BODDate)
			CUST.INTERFACE.foracid=BANCS.OUTPARAM.foracid
			print(CUST.INTERFACE.foracid)
			CUST.INTERFACE.solid=BANCS.OUTPARAM.solid
			print(CUST.INTERFACE.solid)
			CUST.INTERFACE.remitCrncy=BANCS.OUTPARAM.remitCrncy
			print(CUST.INTERFACE.remitCrncy)
			CUST.INTERFACE.awinstAcct=BANCS.OUTPARAM.awinstAcct
			print(CUST.INTERFACE.awinstAcct)
			CUST.INTERFACE.benefName=BANCS.OUTPARAM.benefName
			print(CUST.INTERFACE.benefName)
			CUST.INTERFACE.benfaddress1=BANCS.OUTPARAM.benfaddress1
			print(CUST.INTERFACE.benfaddress1)
			CUST.INTERFACE.benefCtryCode=BANCS.OUTPARAM.benefCtryCode
			print(CUST.INTERFACE.benefCtryCode)
			CUST.INTERFACE.Bic=BANCS.OUTPARAM.Bic
			print(CUST.INTERFACE.Bic)
			CUST.INTERFACE.amount=BANCS.OUTPARAM.amount
			print(CUST.INTERFACE.amount)
			CUST.INTERFACE.BODDate=BANCS.STDIN.BODDate
			print(CUST.INTERFACE.BODDate)
			CUST.INTERFACE.others=BANCS.OUTPARAM.others
			print(CUST.INTERFACE.others)
			CUST.INTERFACE.sequence=BANCS.OUTPARAM.sequence
			print(CUST.INTERFACE.sequence)
			CUST.INTERFACE.freetext1=BANCS.OUTPARAM.freetext1
			print(CUST.INTERFACE.freetext1)
			CUST.INTERFACE.error_code=BANCS.OUTPARAM.error_code
			print(CUST.INTERFACE.error_code)


		IF  (CUST.INTERFACE.bankID =="55") THEN
			CUST.INTERFACE.benfaddress2 = "P.O.BOX 75104"	
			CUST.INTERFACE.benfaddress4 = "TANZANIA"
			CUST.INTERFACE.BankCode = "01"
			CUST.INTERFACE.BrCode = "6701"
			CUST.INTERFACE.CorrespBIC = "TANZTZTXXXX"
			CUST.INTERFACE.EVENT_ID ="TPGRTGS"
		ENDIF
		IF  (CUST.INTERFACE.bankID =="54") THEN
			CUST.INTERFACE.benfaddress2 = "P.O.BOX 75104"	
			CUST.INTERFACE.benfaddress4 = "NAIROBI"
			CUST.INTERFACE.BankCode = "09"
			CUST.INTERFACE.BrCode = "001"
			CUST.INTERFACE.CorrespBIC = "CBKEKENXXXX"
			CUST.INTERFACE.EVENT_ID ="TPGRTGS"
		ENDIF


			
			#-------------------------------------------------------------------------
			# Fetch the current data time to send in request header
			#-------------------------------------------------------------------------
			sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
			#{
				CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
				print(CUST.INTERFACE.msgDateTime)
			#}
			ENDIF
			
			#-------------------------------------------------------------------------
			#- Forming the Header for RetCustAdd
			#-------------------------------------------------------------------------
			
			sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0)THEN
			#{
				CUST.INTERFACE.RequestID1 = BANCS.OUTPARAM.RequestID
				print(CUST.INTERFACE.RequestID1)
				#}
			ELSE
				#{
				CUST.INTERFACE.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
				print(CUST.INTERFACE.RequestID1)
			#}
			ENDIF
			
			CUST.INTERFACE.headerXML = ""
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Header>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestHeader>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageKey>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestUUID>" + CUST.INTERFACE.RequestID1 + "</RequestUUID>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestId>executeFinacleScript</ServiceRequestId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ChannelId>" + CUST.INTERFACE.channelID + "</ChannelId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<LanguageId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</MessageKey>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestMessageInfo>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<BankId>" + CUST.INTERFACE.bankID + "</BankId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<TimeZone />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityType />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ArmCorrelationId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageDateTime>" + CUST.INTERFACE.msgDateTime + "</MessageDateTime>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestMessageInfo>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Security>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Token>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<PasswordToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<UserId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Password />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</PasswordToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Token>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<FICertToken />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserLoginSessionId />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUser />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserPwd />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<SSOTransferToken />"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Security>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestHeader>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Header>"
			
			#-------------------------------------------------------------------------
			#- Forming the Body
			#-------------------------------------------------------------------------
			CUST.INTERFACE.bodyXMLMsg = ""
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Body>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<executeFinacleScriptRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ExecuteFinacleScriptInputVO>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<requestId>createPOthruFI.scr</requestId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</ExecuteFinacleScriptInputVO>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<executeFinacleScript_CustomData>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AutoVerify>Y</AutoVerify>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<POType>RTGS</POType>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<purposeCode>1A1</purposeCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ChrgEventId>" + CUST.INTERFACE.EVENT_ID + "</ChrgEventId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DrValueDate>" + CUST.INTERFACE.BODDate + "</DrValueDate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TranRefNum>NAN</TranRefNum>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RelatedRefNum />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DrExecutionDate>" + CUST.INTERFACE.BODDate + "</DrExecutionDate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SenderBIC />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SendingInstBIC />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<DrAcct>" + CUST.INTERFACE.foracid + "</DrAcct>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CrAcct>" + CUST.INTERFACE.freetext1 + "</CrAcct>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ChrgAcct />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ChrgDrAcct>" + CUST.INTERFACE.foracid + "</ChrgDrAcct>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RemitAmt>" + CUST.INTERFACE.amount + "</RemitAmt>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RemitCrncyCode>" + CUST.INTERFACE.remitCrncy + "</RemitCrncyCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<InstructedAmt>" + CUST.INTERFACE.amount + "</InstructedAmt>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<InstructedAmtCrncy>" + CUST.INTERFACE.remitCrncy + "</InstructedAmtCrncy>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<InstructionCodes />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ChargeOption>OUR</ChargeOption>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CrValueDate>" + CUST.INTERFACE.BODDate + "</CrValueDate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ReqExecDate>" + CUST.INTERFACE.BODDate + "</ReqExecDate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CrExecutionDate>" + CUST.INTERFACE.BODDate + "</CrExecutionDate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BenefPartyBIC></BenefPartyBIC>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiAddrInd>B</AwiAddrInd>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiAcct>" + CUST.INTERFACE.awinstAcct + "</AwiAcct>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiName>" + CUST.INTERFACE.benefName + "</AwiName>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiBIC>" + CUST.INTERFACE.error_code + "</AwiBIC>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RecvrBIC></RecvrBIC>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RecvrBankCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RecvrBrCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiBankCode></AwiBankCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiBrCode></AwiBrCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<OurCorrespBIC>" + CUST.INTERFACE.CorrespBIC+ "</OurCorrespBIC>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<OurCorrespBankCode>" + CUST.INTERFACE.BankCode + "</OurCorrespBankCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<OurCorrespBrCode>" + CUST.INTERFACE.BrCode + "</OurCorrespBrCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RemitInfo>" + CUST.INTERFACE.benfaddress1 + "</RemitInfo>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SenderToRecvrInfo />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<OrderType>CT</OrderType>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CountryCode>" + CUST.INTERFACE.benefCtryCode + "</CountryCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BenefPartyAcct>" + CUST.INTERFACE.awinstAcct + "</BenefPartyAcct>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BenefPartyName>" + CUST.INTERFACE.benefName + "</BenefPartyName>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BenefPartyAddr3 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BenefPartyAddr1>" + CUST.INTERFACE.benfaddress1 + "</BenefPartyAddr1>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BenefPartyAddr2 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<BenefPartyAddr3 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<WaiveCharges>N</WaiveCharges>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<tag36Rate>TTS</tag36Rate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SenderChrgAmt />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SenderChrgCrncy />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RecvrChrgCrncy />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RecvrChrgCrncy />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RecvrChrgAmt />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SenderChrgCrncy />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ordPartyAcct>" + CUST.INTERFACE.foracid + "</ordPartyAcct>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ordPartyName>" + CUST.INTERFACE.benfaddress1 + "</ordPartyName>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ordPartyAdd1>" + CUST.INTERFACE.benfaddress2 + "</ordPartyAdd1>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ordPartyAdd2>" + CUST.INTERFACE.benfaddress4 + "</ordPartyAdd2>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiAddr1 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiAddr2 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<AwiAddr3 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<exchRateCode>TTS</exchRateCode>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<chrgExchRateCode/>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<interInstnBic />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<interInstnBrCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<interInstnBankCode />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<interInstnName />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<interInstnNameAddr1 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<interInstnNameAddr2 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<interInstnNameAddr3 />"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ExchRate>0</ExchRate>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</executeFinacleScript_CustomData>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</executeFinacleScriptRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Body>"
			
			
			#-------------------------------------------------------------------------
			#Appending the header XML and body XML.
			#-------------------------------------------------------------------------
			CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"
			
			#-------------------------------------------------------------------------------
			# Setting input values for urhk_ConnectToFIAndSendMsg userhook
			#-------------------------------------------------------------------------------
			BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
			print(BANCS.INPARAM.SERVICE_NAME)
			BANCS.INPARAM.SEND_RECV_FLG             = "R"
			sv_a = CUST.INTERFACE.reqXMLMsg
			PRINT(sv_a)
			
			#-------------------------------------------------------------------------
			#- Executing the userhook to make the Outbound Call
			#-------------------------------------------------------------------------
			sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
			print(sv_l)
			IF (sv_l != 0) THEN
			#{
				print(BANCS.OUTPARAM.ErrMsg)
				CUST.INTERFACE.errorMsgFlg = "Y"
				CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.INTERFACE.errorMsgCode = "FIERR"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF (BANCS.OUTPARAM.ErrMsg != "") THEN
			#{
				CUST.INTERFACE.errorMsgFlg = "Y"
				CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
				CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.INTERFACE.errorMsgCode = "FIERR"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
				print(CUST.INTERFACE.respXMLMsg)
				CUST.INTERFACE.errorMsgFlg = ""
				CUST.INTERFACE.errorMsgDesc = ""
				
				CUST.INTERFACE.opndate = ""
				CUST.INTERFACE.cifid = ""
				CUST.INTERFACE.errorCode = ""
				CUST.INTERFACE.errorDesc = ""
				sv_x = CUST.INTERFACE.respXMLMsg
				
				#--------------------------------------------------------------------------------------------------------
				# Fetching the status of the request
				#--------------------------------------------------------------------------------------------------------
				sv_y = "<Status>"
				sv_z = "</Status>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
					#}
				ELSE
					#{
					CUST.INTERFACE.tranStatus = ""
				#}
				ENDIF
				print(CUST.INTERFACE.tranStatus)
				
				CUST.INTERFACE.Error = "N"
				CUST.INTERFACE.Errordesc = ""
				sv_y = "<Error>"
				sv_z = "</Error>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.Errordesc = MID$(sv_x, sv_b, (sv_e - sv_b))
					print(CUST.INTERFACE.Errordesc)
					
					CUST.INTERFACE.errorDesc = CUST.INTERFACE.Errordesc
					
					IF (CUST.INTERFACE.Errordesc!="") THEN
					#{
						CUST.INTERFACE.Error = "Y"
						#}
					ELSE
						#{
						CUST.INTERFACE.Error = "N"
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.INTERFACE.Error = "N"
					CUST.INTERFACE.Errordesc = ""
				#}
				ENDIF
				
				sv_y = "<ERROR>"
				sv_z = "</ERROR>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.Errordesc = MID$(sv_x, sv_b, (sv_e - sv_b))
					print(CUST.INTERFACE.Errordesc)
					
					CUST.INTERFACE.errorDesc = CUST.INTERFACE.Errordesc
					
					IF (CUST.INTERFACE.Errordesc!="") THEN
					#{
						CUST.INTERFACE.Error = "Y"
						#}
					ELSE
						#{
						CUST.INTERFACE.Error = "N"
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.INTERFACE.Error = "N"
					CUST.INTERFACE.Errordesc = ""
				#}
				ENDIF
				
				#--------------------------------------------------------------------------------------------------------
				# If Success fetching
				#--------------------------------------------------------------------------------------------------------
				IF ((CUST.INTERFACE.tranStatus =="SUCCESS") AND (CUST.INTERFACE.Error == "N"))  THEN
				#{
					CUST.INTERFACE.errorMsgFlg = "N"
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<DrAcct>"
					sv_z = "</DrAcct>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.cifid = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.INTERFACE.cifid)
					#}
					ENDIF
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<PymtRefNum>"
					sv_z = "</PymtRefNum>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.PymtRefNum = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.INTERFACE.PymtRefNum)
					#}
					ENDIF
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					
					#print (BANCS.OUTPARAM.foracid)
					sv_s = "UPDATE CUSTOM.PORDM_MER "
					sv_s = sv_s + " SET entity_cre_flg = 'P',CORE_REF_NO =?SVAR,ERROR_DESC =?SVAR "
					sv_s = sv_s + " WHERE FORACID= ?SVAR AND entity_cre_flg = 'N' "
					sv_s = sv_s + " AND SEQUENCE = ?SVAR  "
					BANCS.INPARAM.BINDVARS = CUST.INTERFACE.PymtRefNum + "|" + CUST.INTERFACE.tranStatus + "|" + CUST.INTERFACE.foracid + "|" + CUST.INTERFACE.sequence
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
					
					#}
				ELSE
					#{
					CUST.INTERFACE.errorMsgFlg = "Y"
					IF ((CUST.INTERFACE.tranStatus != "SUCCESS") OR (CUST.INTERFACE.Error == "Y"))  THEN
					#{
						print(CUST.INTERFACE.tranStatus)
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<ErrorCode>"
						sv_z = "</ErrorCode>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
						#}
						ENDIF
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<ErrorDesc>"
						sv_z = "</ErrorDesc>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
						#}
						ENDIF
						
						#----------------------------------------------------------------------------------------------------
						# Update custom table failure status
						#----------------------------------------------------------------------------------------------------
						IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
						#{
							CUST.INTERFACE.errorCode = "SYSERR"
							CUST.INTERFACE.errorDesc = "Could not get response from server"
						#}
						ENDIF
						
						sv_s = "UPDATE CUSTOM.PORDM_MER "
						sv_s = sv_s + " SET entity_cre_flg = 'E',ERROR_DESC =?SVAR  "
						sv_s = sv_s + " WHERE FORACID = ?SVAR "
						sv_s = sv_s + " AND entity_cre_flg = 'N' AND SEQUENCE=?SVAR   "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.INTERFACE.errorDesc + "|" + CUST.INTERFACE.foracid + "|" + CUST.INTERFACE.sequence
						print(BANCS.INPARAM.BINDVARS)
						
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
						#{
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						#}
						ENDIF
					#}
					ENDIF
					IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
					#{
						CUST.INTERFACE.errorCode = "SYSERR"
						CUST.INTERFACE.errorDesc = "Could not get response from server"
					#}
					ENDIF
				#}
				ENDIF
				
				#print(CUST.INTERFACE.errorMsgFlg)
				#print(CUST.INTERFACE.errorCode)
				#print(CUST.INTERFACE.errorDesc)
			#}
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUST.INTERFACE.DbcursorNumber)
		print(sv_c)
		#}
		#ENDIF
		
		ENDOFSCRIPT:
			EXITSCRIPT
			#trace off
	END-->
	
	
	
