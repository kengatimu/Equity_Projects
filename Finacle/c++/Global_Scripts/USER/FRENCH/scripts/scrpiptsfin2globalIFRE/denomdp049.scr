#--------------------------------------------------------------------------------------------------
# Name			: denomdp049.scr
# Date			: 15-07-2010
# Description		: This script file gets the input SolId from HDENRO menu and gets the total
#                       round off amount for all the teller accounts in that particular Sol
#			and calls the MTT script to perform the transaction between the
#			teller accounts and the PandL account and records it to a report.
# Menu Option		: HDENRO
# Calling JSP		: denommn004.jsp
# Bank			: STANDARD BANK
# Module Code		: DENOM
# Menu Name		: HDENRO
# Modification History	:
#	<Serial.No>	<Date>		<Author>		<Description>
#	0.1		15-07-2010	Sandeep Patil		Draft Version
#----------------------------------------------------------------------------------------------------
<--START
CHECKSUM="78811a3aac92826d4478abdbad6a22e340100dca7d0beda4044e5ab8d3872f29"
	TRACE ON
	#LIBNAME ABGMASTER
	LIBNAME CUSTOMSO
	sv_r = urhk_B2k_PrintRepos("BANCS")
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	IF (REPEXISTS("MTT") == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT", "TranDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT", "TranDetails", 5)
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT", "PartTranDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT", "PartTranDetails", 5)
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT", "Error")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT", "Error", 5)
	#}
	ENDIF
	#sv_r = urhk_MTTS_PopulateInputDetails("")
	#print(sv_r)
	#IF (sv_r != "0") THEN
	#{
	#       GOTO FINISH
	#}
	#ENDIF
	
	sv_b = urhk_getEnv("sSetId")
	CUST.DENOM.setId = BANCS.OUTPARAM.envValue
	print(CUST.DENOM.setId)
	
	sv_b = urhk_getEnv("sTellerId")
	CUST.DENOM.tellerId = BANCS.OUTPARAM.envValue
	print(CUST.DENOM.tellerId)
	
	CUST.DENOM.value_date = LEFT$(BANCS.STDIN.BODDate, 10)
	CUST.DENOM.BankId = BANCS.STDIN.contextBankId
	CUST.DENOM.FLAG1 = "N"
	CUST.DENOM.FLAG2 = "N"
	CUST.DENOM.FLAG3 = "N"
	CUST.DENOM.FLAG4 = "N"
	CUST.DENOM.SuccessReport = "Y"
	
	IF((CUST.DENOM.setId !="") OR (CUST.DENOM.setId != "ALL"))THEN
	#{
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.setId +"|"+ CUST.DENOM.BankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_q = "cnt1|select count(1) "
		sv_q = sv_q + "FROM stid "
		sv_q = sv_q + "WHERE SET_ID = ?SVAR "
		sv_q = sv_q + "AND BANK_ID = ?SVAR "
		print(sv_q)
		sv_s = urhk_dbselectWithBind(sv_q)
		print(sv_s)
		IF(sv_s ==0)THEN
		#{
			IF(BANCS.OUTPARAM.cnt1 == 0)THEN
			#{
				sv_z = urhk_SetOrbOut("Error_10|Error:^Invalid set Id^AccNo")
				print(sv_z)
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	sv_d = "Today|SELECT to_char(sysdate,'ddmmyyyyhhmiss') FROM dual"
	PRINT(sv_d)
	sv_p = urhk_dbSelect(sv_d)
	
	IF (BANCS.OUTPARAM.DB_ERRCODE == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.Today)
		CUST.DENOM.Today = BANCS.OUTPARAM.Today
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.DB_ERRMSG)
		GOTO FINISH
	#}
	ENDIF
	
	#-------------- CREATION OF LOG FILES : START ----------------------------------------------------
	CUST.DENOM.SuccessFile = "RoundoffSuc_" + CUST.DENOM.Today + ".log"
	sv_x = RPAD("TELLERID", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
	PRINT(sv_x)
	sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
	PRINT(sv_v)
	sv_b = SYSTEM(sv_v)
	sv_a = "---------------------------------------------------------------------------"
	PRINT(sv_a)
	sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
	PRINT(sv_c)
	sv_d = SYSTEM(sv_c)
	#--------------- CREATION OF LOG FILES : END -----------------------------------------------------
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.setId +"|"+ CUST.DENOM.BankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_s = "solId|select distinct sol_id "
	sv_s = sv_s + "FROM sst "
	sv_s = sv_s + "WHERE set_id = ?SVAR "
	sv_s = sv_s + "AND BANK_ID = ?SVAR "
	print(sv_s)
	sv_e = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_e)
	
	CUST.DENOM.CURSOR1 = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_r = urhk_dbCursorFetch(CUST.DENOM.CURSOR1)
	PRINT(sv_r)
	PRINT(CUST.DENOM.CURSOR1)
	WHILE(sv_r == 0)
	#{
		print(BANCS.OUTPARAM.solId)
		CUST.DENOM.solId=BANCS.OUTPARAM.solId
		print(CUST.DENOM.solId)
		
		#------------QUERY FOR THE PLACHOLDER OF P AND L ACCOUNT WHICH IS SET IN HSETVAR : Start ----------
		
		# In HSETVAR an entry is set with module code as DENOM, sub module code as DENOM, type as BACID,
		# variable name as PANDL and variable value as 8905001 for the P AND L account.
		
		BANCS.INPARAM.BINDVARS = CUST.DENOM.BankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_s = "PANDL|SELECT variable_value FROM c_svrsetvar "
		sv_s = sv_s + "WHERE module_name like 'DENOM' "
		sv_s = sv_s + "AND sub_module_name like 'DENOM' "
		sv_s = sv_s + "AND variable_name like 'PANDL' "
		sv_s = sv_s + "AND BANK_ID = ?SVAR "
		PRINT(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF (sv_d == 0) THEN
		#{
			CUST.DENOM.PANDL = BANCS.OUTPARAM.PANDL
			PRINT(CUST.DENOM.PANDL)
			#}
		ELSE
			#{
			CUST.DENOM.MTTErrMsg = "PANDL IS NOT SPECIFIED in SETVAR"
			PRINT(CUST.DENOM.MTTErrMsg)
			sv_p = "echo " + CUST.DENOM.MTTErrMsg + " >> " + CUST.DENOM.SuccessFile
			PRINT(sv_p)
			sv_a = SYSTEM(sv_p)
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.FLAG1 = "Y"
			sv_u = urhk_setOrbOut("Message|Failure")
			PRINT(sv_u)
			sv_u = urhk_setOrbOut("Details|" + CUST.DENOM.MTTErrMsg)
			PRINT(sv_u)
			GOTO FINISH
		#}
		ENDIF
		
		#-----------QUERY FOR THE PLACHOLDER OF P AND L ACCOUNT WHICH IS SET IN HSETVAR : End -----------
		
		#-------------------------------------------------------------------------------------------------
		# GETTING THE ROUND OFF AMOUNT FOR VARIOUS TELLER ACCOUNTS WITH DIFFERENT CURRENCY CODES
		#-------------------------------------------------------------------------------------------------
		
		sv_q = "teller_id,crncy_code,sol,status|SELECT DISTINCT teller_id,crncy_code,sol_id,status "
		sv_q = sv_q + "FROM c_derd "
		sv_q = sv_q + "WHERE status = 'N' "
		sv_q = sv_q + "AND BANK_ID = '" + CUST.DENOM.BankId + "' "
		sv_q = sv_q + "AND (dxfer_flg = 'P' OR dxfer_flg = 'DX' OR dxfer_flg = 'X' OR dxfer_flg = 'R') "
		sv_q = sv_q + "AND teller_id !='VAULT' "
		IF(CUST.DENOM.tellerId !="")THEN
		#{
			sv_q = sv_q + " AND teller_id = '" + CUST.DENOM.tellerId + "' "
		#}
		ENDIF
		
		IF (CUST.DENOM.solId != "ALL") THEN
		#{
			sv_q = sv_q + " AND sol_id = '" + CUST.DENOM.solId + "'"
		#}
		ENDIF
		PRINT(sv_q)
		
		sv_e = urhk_dbCursorOpen(sv_q)
		PRINT(sv_e)
		
		IF (sv_e == 0) THEN
		#{
			CUST.DENOM.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_r = urhk_dbCursorFetch(CUST.DENOM.CURSOR_NUMBER)
			PRINT(sv_r)
			PRINT(CUST.DENOM.CURSOR_NUMBER)
			IF(sv_r==0)THEN
			#{
				
				#------------------------------------------------------------------------------------------------
				# LOOP FOR GETTING ALL THE TELLER ACCOUNTS WITH DIFFERENT CURRENCIES AND STATUS FLAG AS 'N'
				#------------------------------------------------------------------------------------------------
				
				# CURSOR 1 : Gets all the distinct combinations of teller accounts,currency code for the selected
				#		Sol id with the status flag as 'N'
				
				WHILE(sv_r == 0)
				#{
					BANCS.OUTPUT.successOrFailure = "S"
					CUST.DENOM.teller_id = BANCS.OUTPARAM.teller_id
					PRINT(CUST.DENOM.teller_id)
					CUST.DENOM.crncy_code = BANCS.OUTPARAM.crncy_code
					PRINT(CUST.DENOM.crncy_code)
					CUST.DENOM.status = BANCS.OUTPARAM.status
					PRINT(CUST.DENOM.status)
					IF (CUST.DENOM.solId == "ALL") THEN
					#{
						CUST.DENOM.sol = TOUPPER(BANCS.OUTPARAM.sol)
						PRINT(CUST.DENOM.sol)
						CUST.DENOM.solId = CUST.DENOM.sol
						PRINT(CUST.DENOM.solId)
						#}
					ELSE
						#{
						CUST.DENOM.solId = BANCS.OUTPARAM.sol
						PRINT(CUST.DENOM.solId)
					#}
					ENDIF
					#------------- GETTING THE PLACEHOLDER FOR THE TELLER ACCOUNT : START ------------------------------
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.teller_id +"|"+ CUST.DENOM.solId +"|"+ CUST.DENOM.BankId +"|"+ CUST.DENOM.crncy_code
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_q = "ph|SELECT emp_cash_acct "
					sv_q = sv_q + "FROM gec "
					sv_q = sv_q + "WHERE emp_id = ?SVAR "
					sv_q = sv_q + "AND sol_id = ?SVAR "
					sv_q = sv_q + "AND bank_id = ?SVAR "
					sv_q = sv_q + "AND crncy_code = ?SVAR "
					sv_q = sv_q + " AND entity_cre_flg = 'Y' AND del_flg != 'Y' "
					PRINT(sv_q)
					sv_r = urhk_dbselectWithBind(sv_q)
					PRINT(sv_r)
					IF (sv_r == 0) THEN
					#{
						CUST.DENOM.ph = BANCS.OUTPARAM.ph
						PRINT(CUST.DENOM.ph)
						IF (CUST.DENOM.ph == "0") THEN
						#{
							IF (CUST.DENOM.FLAG4 == "N") THEN
							#{
								sv_x = RPAD("TELLERID", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
								PRINT(sv_x)
								sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
								PRINT(sv_v)
								sv_b = SYSTEM(sv_v)
								sv_a = "---------------------------------------------------------------------------"
								PRINT(sv_a)
								sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
								PRINT(sv_c)
								sv_d = SYSTEM(sv_c)
								CUST.DENOM.FLAG4 = "Y"
							#}
							ENDIF
							PRINT(CUST.DENOM.SuccessFile)
							sv_y = RPAD(CUST.DENOM.teller_id, 15) + "," + RPAD(CUST.DENOM.crncy_code, 15) + "," + RPAD(CUST.DENOM.solId, 10) + "------Account does not exist (OR) not authorised"
							PRINT(sv_y)
							sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_p)
							sv_a = SYSTEM(sv_p)
							BANCS.OUTPUT.successOrFailure = "F"
							CUST.DENOM.FLAG1 = "Y"
							GOTO NEXT
						#}
						ENDIF
						#}
					ELSE
						#{
						IF (CUST.DENOM.FLAG4 == "N") THEN
						#{
							sv_x = RPAD("TELLERID", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
							PRINT(sv_x)
							sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_v)
							sv_b = SYSTEM(sv_v)
							sv_a = "---------------------------------------------------------------------------"
							PRINT(sv_a)
							sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_c)
							sv_d = SYSTEM(sv_c)
							CUST.DENOM.FLAG4 = "Y"
						#}
						ENDIF
						PRINT(CUST.DENOM.SuccessFile)
						sv_y = RPAD(CUST.DENOM.teller_id, 15) + "," + RPAD(CUST.DENOM.crncy_code, 15) + "," + RPAD(CUST.DENOM.solId, 10) + "------Placeholder does not exist for this teller id"
						PRINT(sv_y)
						sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
						PRINT(sv_p)
						sv_a = SYSTEM(sv_p)
						BANCS.OUTPUT.successOrFailure = "F"
						CUST.DENOM.FLAG1 = "Y"
						GOTO NEXT
					#}
					ENDIF
					#-------------------- GETTING THE PLACEHOLDER FOR THE TELLER ACCOUNT : END--------------------------------
					#-------------------- GETTING THE FORACID FOR THE TELLER ACCOUNT : START----------------------------------
					sv_w = TRIM(CUST.DENOM.ph) + "|" + CUST.DENOM.crncy_code + "|" + CUST.DENOM.solId
					PRINT(sv_w)
					sv_r = urhk_B2k_BacidToAcctId(sv_w)
					PRINT(sv_r)
					IF (sv_r == "0") THEN
					#{
						CUST.DENOM.teller_acct = BANCS.OUTPARAM.AcctId
						PRINT(CUST.DENOM.teller_acct)
						
						#}
					ELSE
						#{
						IF (CUST.DENOM.FLAG4 == "N") THEN
						#{
							sv_x = RPAD("TELLERID", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
							PRINT(sv_x)
							sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_v)
							sv_b = SYSTEM(sv_v)
							sv_a = "---------------------------------------------------------------------------"
							PRINT(sv_a)
							sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_c)
							sv_d = SYSTEM(sv_c)
							CUST.DENOM.FLAG4 = "Y"
						#}
						ENDIF
						PRINT(CUST.DENOM.SuccessFile)
						sv_y = RPAD(CUST.DENOM.teller_id, 15) + "," + RPAD(CUST.DENOM.crncy_code, 15) + "," + RPAD(CUST.DENOM.solId, 10) + "------Foracid not found for this combination of crncycode,sol id AND placeholder"
						PRINT(sv_y)
						sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
						PRINT(sv_p)
						sv_a = SYSTEM(sv_p)
						BANCS.OUTPUT.successOrFailure = "F"
						CUST.DENOM.FLAG1 = "Y"
						GOTO NEXT
					#}
					ENDIF
					#------------------ GETTING THE FORACID FOR THE TELLER ACCOUNT : END---------------------------------------
					#-------------------- GETTING THE FORACID FOR THE PANDL ACCOUNT : START -----------------------------------
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.PANDL + "|"+ CUST.DENOM.solId +"|"+ CUST.DENOM.crncy_code +"|"+ CUST.DENOM.BankId
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_q = "pandl_acct|SELECT foracid "
					sv_q = sv_q + "FROM gam "
					sv_q = sv_q + "WHERE bacid = ?SVAR "
					sv_q = sv_q + "AND sol_id = ?SVAR "
					sv_q = sv_q + "AND acct_crncy_code = ?SVAR "
					sv_q = sv_q + "AND bank_id = ?SVAR "
					PRINT(sv_q)
					sv_r = urhk_dbselectWithBind(sv_q)
					PRINT(sv_r)
					IF (sv_r == 0) THEN
					#{
						CUST.DENOM.pandl_acct = BANCS.OUTPARAM.pandl_acct
						PRINT(CUST.DENOM.pandl_acct)
						IF (CUST.DENOM.pandl_acct == "0") THEN
						#{
							IF (CUST.DENOM.FLAG4 == "N") THEN
							#{
								sv_x = RPAD("TELLERID", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
								PRINT(sv_x)
								sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
								PRINT(sv_v)
								sv_b = SYSTEM(sv_v)
								sv_a = "---------------------------------------------------------------------------"
								PRINT(sv_a)
								sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
								PRINT(sv_c)
								sv_d = SYSTEM(sv_c)
								CUST.DENOM.FLAG4 = "Y"
							#}
							ENDIF
							#print(CUST.DENOM.SuccessFile)
							CUST.DENOM.MTTErrMsg = RPAD(CUST.DENOM.pandl_acct, 15) + " " + RPAD(CUST.DENOM.crncy_code, 15) + " " + RPAD(CUST.DENOM.solId, 10) + "-----Account does not exist (OR) not authorised"
							#print(CUST.DENOM.MTTErrMsg)
							sv_p = "echo " + CUST.DENOM.MTTErrMsg + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_p)
							sv_a = SYSTEM(sv_p)
							BANCS.OUTPUT.successOrFailure = "F"
							CUST.DENOM.FLAG1 = "Y"
							GOTO NEXT
						#}
						ENDIF
						#}
					ELSE
						#{
						IF (CUST.DENOM.FLAG4 == "N") THEN
						#{
							sv_x = RPAD("PANDL A/C", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
							PRINT(sv_x)
							sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_v)
							sv_b = SYSTEM(sv_v)
							sv_a = "---------------------------------------------------------------------------"
							PRINT(sv_a)
							sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_c)
							sv_d = SYSTEM(sv_c)
							CUST.DENOM.FLAG4 = "Y"
						#}
						ENDIF
						#print(CUST.DENOM.SuccessFile)
						CUST.DENOM.MTTErrMsg = RPAD(CUST.DENOM.PANDL, 15) + " " + RPAD(CUST.DENOM.crncy_code, 15) + " " + RPAD(CUST.DENOM.solId, 10) + "-----Foracid does not exist for this bacid"
						PRINT(CUST.DENOM.MTTErrMsg)
						sv_p = "echo " + CUST.DENOM.MTTErrMsg + " >> " + CUST.DENOM.SuccessFile
						PRINT(sv_p)
						sv_a = SYSTEM(sv_p)
						BANCS.OUTPUT.successOrFailure = "F"
						CUST.DENOM.FLAG1 = "Y"
						GOTO NEXT
					#}
					ENDIF
					#-------------------- GETTING THE FORACID FOR THE PANDL ACCOUNT : END -------------------------------------
					#--------------------- GETTING THE SUM OF ROUND OFF AMOUNT FOR CREDIT TYPE OF PART TRAN : START------------
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.teller_id +"|"+	CUST.DENOM.crncy_code +"|"+ CUST.DENOM.BankId
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_a = "tot_roundoff_amt1|SELECT sum(roundoff_amt) "
					sv_a = sv_a + "FROM c_derd "
					sv_a = sv_a + "WHERE status = 'N' "
					sv_a = sv_a + "AND teller_id = ?SVAR "
					sv_a = sv_a + "AND crncy_code = ?SVAR "
					sv_a = sv_a + "AND ptran_type = 'C' "
					sv_a = sv_a + "AND (dxfer_flg = 'P' OR dxfer_flg = 'DX' OR dxfer_flg = 'X' OR dxfer_flg = 'R') "
					sv_a = sv_a + "AND bank_id = ?SVAR "
					PRINT(sv_a)
					sv_b = urhk_dbselectWithBind(sv_a)
					PRINT(sv_b)
					IF (sv_b == 0) THEN
					#{
						CUST.DENOM.tot_roundoff_amt1 = BANCS.OUTPARAM.tot_roundoff_amt1
						PRINT(CUST.DENOM.tot_roundoff_amt1)
						#}
					ELSE
						#{
						IF (CUST.DENOM.FLAG4 == "N") THEN
						#{
							sv_x = RPAD("TELLERID", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
							PRINT(sv_x)
							sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_v)
							sv_b = SYSTEM(sv_v)
							sv_a = "---------------------------------------------------------------------------"
							PRINT(sv_a)
							sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_c)
							sv_d = SYSTEM(sv_c)
							CUST.DENOM.FLAG4 = "Y"
						#}
						ENDIF
						#print(CUST.DENOM.SuccessFile)
						sv_y = RPAD(CUST.DENOM.teller_id, 15) + "," + RPAD(CUST.DENOM.crncy_code, 15) + "," + RPAD(CUST.DENOM.solId, 10) + "------Round OFF Amount is not present"
						PRINT(sv_y)
						sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
						PRINT(sv_p)
						sv_a = SYSTEM(sv_p)
						BANCS.OUTPUT.successOrFailure = "F"
						CUST.DENOM.FLAG1 = "Y"
						GOTO NEXT
					#}
					ENDIF
					#--------------------- GETTING THE SUM OF ROUND OFF AMOUNT FOR CREDIT TYPE OF PART TRAN : END----------------
					#--------------------- GETTING THE SUM OF ROUND OFF AMOUNT FOR DEBIT TYPE OF PART TRAN : START---------------
					
					BANCS.INPARAM.BINDVARS = CUST.DENOM.teller_id +"|"+ CUST.DENOM.crncy_code +"|"+ CUST.DENOM.BankId
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_a = "tot_roundoff_amt2|SELECT sum(roundoff_amt) "
					sv_a = sv_a + "FROM c_derd "
					sv_a = sv_a + "WHERE status = 'N' "
					sv_a = sv_a + "AND teller_id = ?SVAR "
					sv_a = sv_a + "AND crncy_code = ?SVAR "
					sv_a = sv_a + "AND ptran_type = 'D' "
					sv_a = sv_a + "AND (dxfer_flg = 'P' OR dxfer_flg = 'DX' OR dxfer_flg = 'X' OR dxfer_flg = 'R') "
					sv_a = sv_a + "AND bank_id = ?SVAR "
					PRINT(sv_a)
					sv_b = urhk_dbselectWithBind(sv_a)
					PRINT(sv_b)
					IF (sv_b == 0) THEN
					#{
						CUST.DENOM.tot_roundoff_amt2 = BANCS.OUTPARAM.tot_roundoff_amt2
						PRINT(CUST.DENOM.tot_roundoff_amt2)
						#}
					ELSE
						#{
						IF (CUST.DENOM.FLAG4 == "N") THEN
						#{
							sv_x = RPAD("TELLERID", 15) + RPAD("CRNCYCODE", 15) + RPAD("SOLID", 10) + "---------- " + RPAD("Message", 20)
							PRINT(sv_x)
							sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_v)
							sv_b = SYSTEM(sv_v)
							sv_a = "---------------------------------------------------------------------------"
							PRINT(sv_a)
							sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_c)
							sv_d = SYSTEM(sv_c)
							CUST.DENOM.FLAG4 = "Y"
						#}
						ENDIF
						#print(CUST.DENOM.SuccessFile)
						sv_y = RPAD(CUST.DENOM.teller_id, 15) + "," + RPAD(CUST.DENOM.crncy_code, 15) + "," + RPAD(CUST.DENOM.solId, 10) + "------Round OFF Amount does not exist"
						#print(sv_y)
						sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
						PRINT(sv_p)
						sv_a = SYSTEM(sv_p)
						BANCS.OUTPUT.successOrFailure = "F"
						CUST.DENOM.FLAG1 = "Y"
						GOTO NEXT
					#}
					ENDIF
					#--------------------- GETTING THE SUM OF ROUND OFF AMOUNT FOR DEBIT TYPE OF PART TRAN : END------------------
					#--------------------- CALCULATION OF TOTAL ROUND OFF AMOUNT : START------------------------------------------
					CUST.DENOM.round_off_amt = CDOUBLE(CUST.DENOM.tot_roundoff_amt2) - CDOUBLE(CUST.DENOM.tot_roundoff_amt1)
					PRINT(CUST.DENOM.round_off_amt)
					IF (CDOUBLE(CUST.DENOM.round_off_amt) == "0") THEN
					#{
						IF (CUST.DENOM.FLAG3 == "N") THEN
						#{
							sv_x = RPAD("TELLERID", 15) + RPAD("SOLID", 10) + RPAD("TELLERACCT", 22) + RPAD("CRNCYCODE", 15) + RPAD("ROFFAMT", 20) + "---------- " + RPAD("Message", 20)
							#print(sv_x)
							sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_v)
							sv_b = SYSTEM(sv_v)
							sv_a = "----------------------------------------------------------------------------------------------------"
							PRINT(sv_a)
							sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
							PRINT(sv_c)
							sv_d = SYSTEM(sv_c)
							CUST.DENOM.FLAG3 = "Y"
						#}
						ENDIF
						#print(CUST.DENOM.SuccessFile)
						sv_y = RPAD(CUST.DENOM.teller_id, 15) + RPAD(CUST.DENOM.solId, 10) + RPAD(CUST.DENOM.teller_acct, 22) + RPAD(CUST.DENOM.crncy_code, 15) + RPAD(CUST.DENOM.round_off_amt, 20) + "---------Sum Of Round OFF Amount is Zero.Hence no Transaction created"
						PRINT(sv_y)
						sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
						PRINT(sv_p)
						sv_a = SYSTEM(sv_p)
						CUST.DENOM.FLAG1 = "Y"
						GOTO NEXT
					#}
					ENDIF
					IF (CUST.DENOM.round_off_amt < 0) THEN
					#{
						#Final Credit, so contra Debit tran to be done
						CUST.DENOM.Parttran = "D"
						#}
					ELSE
						#{
						#Final Debit, so contra credit tran to be done
						CUST.DENOM.Parttran = "C"
					#}
					ENDIF
					#print(CUST.DENOM.Parttran)
					#--------------------- CALCULATION OF TOTAL ROUND OFF AMOUNT : END-----------------------------------------
					CALL("denomdp012.scr")
					NEXT:
						#print(BANCS.OUTPUT.successOrFailure)
						IF (BANCS.OUTPUT.successOrFailure == "S") THEN
						#{
							CUST.DENOM.status = "R"
							PRINT(CUST.DENOM.status)
							#------------- SET THE STATUS FLAG TO 'R' ONCE THE AMOUNT IS ROUNDED OFF : START -------------------------
							
							BANCS.INPARAM.BINDVARS = CUST.DENOM.teller_id +"|"+	CUST.DENOM.solId +"|"+ CUST.DENOM.crncy_code +"|"+ CUST.DENOM.BankId
							PRINT(BANCS.INPARAM.BINDVARS)
							
							sv_y = "UPDATE c_derd SET status = 'R' "
							sv_y = sv_y + "WHERE teller_id = ?SVAR "
							sv_y = sv_y + "AND sol_id = ?SVAR "
							sv_y = sv_y + "AND crncy_code = ?SVAR "
							sv_y = sv_y + "AND status = 'N' "
							sv_y = sv_y + "AND (dxfer_flg = 'P' OR dxfer_flg = 'DX' OR dxfer_flg = 'X' OR dxfer_flg = 'R') "
							sv_y = sv_y + "AND bank_id = ?SVAR "
							PRINT(sv_y)
							sv_r = urhk_dbSQLWithBind(sv_y)
							PRINT(sv_r)
							#------------- SET THE STATUS FLAG TO 'R' ONCE THE AMOUNT IS ROUNDED OFF : END ---------------------------
						#}
						ENDIF
						sv_r = urhk_dbCursorFetch(CUST.DENOM.CURSOR_NUMBER)
						PRINT(sv_r)
						PRINT(CUST.DENOM.CURSOR_NUMBER)
					#}
					DO
					#}
				ELSE
					#{
					IF(CUST.DENOM.tellerId =="")THEN
					#{
						
						sv_y = "NA" + "," + "NA" + "," + RPAD(CUST.DENOM.solId, 10) + "------Nothing to round OFF for given SOL"
						#}
					ELSE
						#{
						sv_y = CUST.DENOM.tellerId + "," + "NA" + "," + RPAD(CUST.DENOM.solId, 10) + "------Nothing to round OFF for given SOL"
					#}
					ENDIF
					#print(sv_y)
					sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
					PRINT(sv_p)
					sv_a = SYSTEM(sv_p)
					BANCS.OUTPUT.successOrFailure = "F"
					CUST.DENOM.FLAG1 = "Y"
					
				#}
				ENDIF
				sv_x = urhk_dbCursorClose(CUST.DENOM.CURSOR_NUMBER)
				PRINT(sv_x)
			#}
			ENDIF
			
			sv_r = urhk_dbCursorFetch(CUST.DENOM.CURSOR1)
			PRINT(sv_r)
			PRINT(CUST.DENOM.CURSOR1)
		#}
		DO
		sv_x = urhk_dbCursorClose(CUST.DENOM.CURSOR1)
		PRINT(sv_x)
		print(CUST.DENOM.FLAG1)
		print(CUST.DENOM.FLAG1)
		#----------------------------------------------------------------------------------------------------------
		# SEND MESSAGE TO THE REPORT
		#----------------------------------------------------------------------------------------------------------
		
		#---------- RECORD THE SUCCESS MESSAGE IN THE SUCCESS REPORT : START --------------------------------------
		
		IF (CUST.DENOM.FLAG1 == "Y") THEN
		#{
			sv_a = "exebatch babx4040 $B2K_SESSION_ID " + CUST.DENOM.SuccessFile + " 'Denomination Round OFF Success Report' 'MANAGER' '1' N"
			PRINT(sv_a)
			sv_x = SYSTEM(sv_a)
			PRINT(sv_x)
			IF (sv_x != 0) THEN
			#{
				CUST.DENOM.SuccessReport = "N"
				GOTO RESULT
			#}
			ENDIF
		#}
		ENDIF
		
		#---------- RECORD THE SUCCESS MESSAGE IN THE SUCCESS REPORT : END ---------------------------------------
		
		#---------------------------------------------------------------------------------------------------------
		# SEND MESSAGE TO JSP
		#---------------------------------------------------------------------------------------------------------
		
		PRINT(BANCS.OUTPUT.successOrFailure)
		
	RESULT:
		
		
		#------------SEND SUCCESS MESSAGE TO FRONT END : START ----------------------------------------------------
		
		IF (CUST.DENOM.SuccessReport == "Y") THEN
		#{
			CUST.DENOM.ErrMsg = "Please check the report for further details"
			PRINT(CUST.DENOM.ErrMsg)
			#sv_z= urhk_SetOrbOut("SuccessOrFailure|Y")
			#print(sv_z)
			#sv_z = urhk_SetOrbOut("RESULT_MSG| Please check the report for further details")
			GOTO FINISH
			
			#------------SEND SUCCESS MESSAGE TO FRONT END : END ------------------------------------------------------
			
			#------------SEND FAILURE MESSAGE TO FRONT END : START ----------------------------------------------------
			
			#}
		ELSE
			#{
			CUST.DENOM.ErrMsg = "Please check the report for further details"
			PRINT(CUST.DENOM.ErrMsg)
			#sv_z= urhk_SetOrbOut("SuccessOrFailure|Y")
			#print(sv_z)
			#sv_z = urhk_SetOrbOut("RESULT_MSG| Please check the report for further details")
			GOTO FINISH
			
			
		#}
		ENDIF
		
		#------------SEND FAILURE MESSAGE TO FRONT END : END ------------------------------------------------------
		
		#DELETEREP("CUST")
		
	FINISH:
		TRACE OFF
		#EXITSCRIPT
END-->
