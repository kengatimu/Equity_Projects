<--START
CHECKSUM="0043bd6949e1b672b35e23ac86c61aa6b7e0e584f373444c7b92f55972f72f2e"
	TRACE ON
	#-------------------------------------------------------------------------------------------------------
	# Create repository and class
	#-------------------------------------------------------------------------------------------------------
	IF(REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","CATOD") == 0) THEN
	#{
		CREATECLASS("CUST","CATOD",5)
	#}
	ENDIF
	#-------------------------------------------------------------------------------------------------------
	# Intialising repository variables
	#-------------------------------------------------------------------------------------------------------
	CUST.CATOD.employer = ""
	CUST.CATOD.empName = ""
	CUST.CATOD.counter = ""
	
	#-------------------------------------------------------------------------------------------------------
	# Fetch all Event IDs of GCHRG event and Fixed derivation type
	#-------------------------------------------------------------------------------------------------------
	sv_s = "empCode,empName"
	sv_s = sv_s + "|"
	sv_s = sv_s + " SELECT EMRM.employer_id,EMRM.employer_name"
	#sv_s = sv_s + " SELECT replace(EMPLOYER_ID,'''',' '),rpad(replace(EMPLOYER_NAME,'''',' '),35,' ') "
	sv_s = sv_s + " FROM TBAADM.EMRM"
	sv_s = sv_s + " WHERE EMRM.del_flg = 'N'"
	sv_s = sv_s + " AND EMRM.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND EMRM.bank_id = ?SVAR"
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_c    =   urhk_dbCursorOpenWithBind(sv_s)
	
	IF(sv_c != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (sv_c == 0) THEN
	#{
		CUST.CATOD.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.CATOD.cursorNum)
		sv_r = urhk_dbCursorFetch(CUST.CATOD.cursorNum)
		PRINT(sv_r)
		IF(sv_r == 0) THEN
		#{
			WHILE (sv_r == 0)
			#{
				CUST.CATOD.counter = CINT(CUST.CATOD.counter) + 1
				CUST.CATOD.employer = BANCS.OUTPARAM.empCode
				CUST.CATOD.empName = BANCS.OUTPARAM.empName
				print(CUST.CATOD.employer)
				print(CUST.CATOD.empName)
				sv_u    =   urhk_SetOrbOut("recCount|" + CUST.CATOD.counter)
				IF(CUST.CATOD.employer != "") THEN
				#{
					sv_y    = "employer_" + CUST.CATOD.counter + "|" + CUST.CATOD.employer
					print(sv_y)
					sv_z    = "empName_" + CUST.CATOD.counter + "|" + CUST.CATOD.empName
					print(sv_z)
					sv_t = urhk_SetOrbOut(sv_y)
					sv_x = urhk_SetOrbOut(sv_z)
				#}
				ENDIF
				
				PRINT(CUST.CATOD.cursorNum)
				sv_r = urhk_dbCursorFetch(CUST.CATOD.cursorNum)
			#}
			DO
			#}
		ELSE
			#{
			PRINT("No records fetched")
		#}
		ENDIF
		
		PRINT(CUST.CATOD.cursorNum)
		sv_r = urhk_dbCursorClose(CUST.CATOD.cursorNum)
	#}
	ENDIF
	
	PRINT(CUST.CATOD.counter)
	
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
