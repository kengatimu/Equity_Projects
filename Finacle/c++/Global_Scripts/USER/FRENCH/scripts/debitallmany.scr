#and g.bank_id='54' and g.acct_cls_flg='N'  AND TAM.ACID = G.ACID AND TAM.BANK_ID = G.BANK_ID AND CLR_BAL_AMT!=0 and c.foracid=g.foracid and g.acct_opn_date>='15-sep-2016'
	sv_s = "dtd_Count|"
	sv_s = sv_s + "select count(1)  from  TBAADM.TAM,custom.INT_CHECK_ALL c ,tbaadm.gam g where INTEREST_RATE<6.65 and  g.foracid in (select foracid  from tbaadm.gam where bank_id='54' and acct_crncy_code='KES') "
	sv_s = sv_s + " and g.bank_id='54' and g.acct_cls_flg='N'  AND TAM.ACID = G.ACID AND TAM.BANK_ID = G.BANK_ID AND CLR_BAL_AMT!=0 and c.foracid=g.foracid and g.acct_opn_date>='15-sep-2016' "
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)

	sv_q = BANCS.OUTPARAM.dtd_Count
	print(sv_q)

	IF (sv_q == "0") THEN
		GOTO Finish
	ENDIF

#--------------------------------------------------------------------------
# Selecting accounts from DTD 
#--------------------------------------------------------------------------


sv_s = "creditaccount,debitaccount,amount|select (SELECT FORACID FROM TBAADM.GAM WHERE ACID =TAM.REPAYMENT_ACID AND GAM.BANK_ID ='54' AND TAM.BANK_ID ='54') as  creditaccount ,g.FORACID debitaccount ,g.clr_bal_amt amount  from  TBAADM.TAM,custom.INT_CHECK_ALL c ,tbaadm.gam g where INTEREST_RATE<6.65 and  g.foracid in (select foracid  from tbaadm.gam where bank_id='54' and acct_crncy_code='KES') "
sv_s = sv_s + " and g.bank_id='54' and g.acct_cls_flg='N'  AND TAM.ACID = G.ACID AND TAM.BANK_ID = G.BANK_ID AND CLR_BAL_AMT!=0 and c.foracid=g.foracid and g.acct_opn_date>='15-sep-2016' "
PRINT(sv_s)

	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_o)

	print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	MISS.CHRG.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(MISS.CHRG.MainCursor)

#--------------------------------------------------------------------------	
# Initialise the Local Variables 
#--------------------------------------------------------------------------

	#------------------------------------------------------------------
	#  Variable Initialisation for counter. It should be Zero
	#------------------------------------------------------------------
		sv_z = 0
        #------------------------------------------------------------------
        #  Variable Initialisation for credit amount to the bank income
	#  account. It should be Zero. 
        #------------------------------------------------------------------
		MISS.CHRG.done = "N"


#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------
	    

	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.Remarks = "TDA sweep "
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.PSTUpdateFlg ="N"

	sv_v = "bCashWithCrg"
	print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("bCashWithCrg")

#--------------------------------------------------------------------------
# MTT code for creating tranxs like individual debit from customer and 
# consolidated credit to the income Account. 
#--------------------------------------------------------------------------

	while (sv_o == 0)
		sv_c = urhk_dbCursorFetch(MISS.CHRG.MainCursor)
		print(sv_c)
		IF (sv_c != 0) THEN
		#{ 
				sv_r = urhk_MTTS_EndDefinition("")
                                print(sv_r)


            		print(sv_c)
	    		sv_o = 1	

		#}
		ELSE 
		#{

			MISS.CHRG.creditaccount = BANCS.OUTPARAM.creditaccount
			print(MISS.CHRG.creditaccount)
			MISS.CHRG.debitaccount = BANCS.OUTPARAM.debitaccount
			print(MISS.CHRG.debitaccount)
			MISS.CHRG.amount = BANCS.OUTPARAM.amount
			print(MISS.CHRG.amount)
			
			MISS.CHRG.stamp = "Y"

		

			#------------------------------------------
                        # counter setting for defining different PartTran
                        #------------------------------------------
                        	sv_z = sv_z + 1
                                MISS.CHRG.Counter = sv_z

			#--------------------------------------------------------------------------
			# Create the narration
			#--------------------------------------------------------------------------

			
			sv_m = "TDA sweep-"
			print(sv_m)
			sv_y = MISS.CHRG.creditaccount
			sv_x = " "
			sv_k = MISS.CHRG.creditaccount
			print(sv_k)

			sv_w = sv_m + sv_y + sv_x + sv_k
			print(sv_w)

			MISS.CHRG.narr1 = sv_w
			print(MISS.CHRG.narr1)


			MISS.CHRG.wtax_amt = ""
			print(MISS.CHRG.wtax_amt)
				

			#--------------------------------------------------
        		# Withholding Tax Account
        		#--------------------------------------------------

        		IF (MISS.CHRG.stamp == "Y") THEN

                		MTT.PartTranDetails.Account = MISS.CHRG.creditaccount
				print(MTT.PartTranDetails.Account)
                		MTT.PartTranDetails.RefCurrency = "KES"
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr1  
                		MTT.PartTranDetails.RefAmount = cdouble(MISS.CHRG.amount)
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.narr1
                		MTT.PartTranDetails.RefNum = MISS.CHRG.debitaccount
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_e = "Credt" + MISS.CHRG.Counter
				print(sv_e)
                		sv_r = urhk_MTTS_definePartTran(sv_e)
                		print(sv_r)

        		ENDIF


			#------------------------------------------------------------------
        		# Customer Debit Partran
        		#------------------------------------------------------------------

               			MTT.PartTranDetails.Account = MISS.CHRG.debitaccount
                		MTT.PartTranDetails.RefCurrency = "KES"
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr1 
                		sv_a = cdouble(MISS.CHRG.amount)
				print(sv_a)
				sv_a = -(sv_a)
				print(sv_a)
                		MTT.PartTranDetails.RefAmount = sv_a
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.narr1
                		MTT.PartTranDetails.RefNum = MISS.CHRG.creditaccount
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_h = "Debit" + MISS.CHRG.Counter
				print(sv_h)
                		sv_u = urhk_MTTS_definePartTran(sv_h)
				print(sv_u)

		#}
			#######

			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)

			MISS.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
			print(MISS.CHRG.tranid)

			print(BANCS.STDIN.userId)

			print(BANCS.STDIN.sysDate)

			print(BANCS.STDIN.BODDate)

			sv_g = mid$(BANCS.STDIN.sysDate,0,10) 
			print(sv_g)
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)
		ENDIF
	DO

	sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor) 

