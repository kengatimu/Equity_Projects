###########################################################################################
<--START
CHECKSUM="c1c60187763ea9955dac14bda457c9ab07d798815dbbad3447edeee048060c9d"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	sv_u = urhk_b2k_printrepos("BANCS")
	
	CUST.CIETXN.targetEntity = " "
	CUST.CIETXN.debitEntity = " "
	CUST.CIETXN.creditEntity = " "
	CUST.CIETXN.drAcctNum = " "
	CUST.CIETXN.crAcctNum = " "
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.chargeAmt = " "
	CUST.CIETXN.chargeAmtFlg = "N"
	CUST.CIETXN.chargeAmtCcy = " "
	CUST.CIETXN.chargeAmtCcyFlg = "N"
	CUST.CIETXN.chargeEventId = " "
	CUST.CIETXN.chargeEventIdFlg = "N"
	CUST.CIETXN.nostroAcct = " "
	CUST.CIETXN.nostroAcctFlg = "N"
	CUST.CIETXN.vostroAcct = " "
	CUST.CIETXN.vostroAcctFlg = "N"
	CUST.CIETXN.cashOrXfer = ""
	CUST.CIETXN.txnType = "PA"
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.debitEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.debitEntity) != "")THEN
		#{
			CUST.CIETXN.debitEntity = TOUPPER(TRIM(BANCS.INPUT.debitEntity))
			print(CUST.CIETXN.debitEntity)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.creditEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.creditEntity) != "")THEN
		#{
			CUST.CIETXN.creditEntity = TOUPPER(TRIM(BANCS.INPUT.creditEntity))
			print(CUST.CIETXN.creditEntity)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.drAcctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.drAcctNum) != "")THEN
		#{
			CUST.CIETXN.drAcctNum = TOUPPER(TRIM(BANCS.INPUT.drAcctNum))
			print(CUST.CIETXN.drAcctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.crAcctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.crAcctNum) != "")THEN
		#{
			CUST.CIETXN.crAcctNum = TOUPPER(TRIM(BANCS.INPUT.crAcctNum))
			print(CUST.CIETXN.crAcctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(TRIM(CUST.CIETXN.debitEntity) == "")THEN
	#{
		CUST.CIETXN.cashOrXfer = "CASH"
		PRINT(CUST.CIETXN.cashOrXfer)
		
		IF(CUST.CIETXN.creditEntity != BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Credit Account should be of Same Entity"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.targetEntity = CUST.CIETXN.creditEntity
		PRINT(CUST.CIETXN.targetEntity)
		#}
	ELSE
		#{
		CUST.CIETXN.cashOrXfer = "XFER"
		PRINT(CUST.CIETXN.cashOrXfer)
		
		IF((CUST.CIETXN.debitEntity == CUST.CIETXN.creditEntity) AND (CUST.CIETXN.debitEntity != BANCS.STDIN.contextBankId))THEN
		#{
			CUST.CIETXN.targetEntity = CUST.CIETXN.debitEntity
			PRINT(CUST.CIETXN.targetEntity)
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Both Debit AND Credit Accounts should be of Same Entity"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.CIETXN.debitEntity != CUST.CIETXN.creditEntity) AND (CUST.CIETXN.debitEntity == BANCS.STDIN.contextBankId))THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Credit Account should be of Same Entity"
			GOTO ENDOFSCRIPT
			CUST.CIETXN.targetEntity = CUST.CIETXN.creditEntity
			PRINT(CUST.CIETXN.targetEntity)
		#}
		ENDIF
		
		IF((CUST.CIETXN.debitEntity != CUST.CIETXN.creditEntity) AND (CUST.CIETXN.creditEntity == BANCS.STDIN.contextBankId))THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Debit Account should be of Same Entity"
			GOTO ENDOFSCRIPT
			CUST.CIETXN.targetEntity = CUST.CIETXN.debitEntity
			PRINT(CUST.CIETXN.targetEntity)
		#}
		ENDIF
		
		IF((CUST.CIETXN.debitEntity != CUST.CIETXN.creditEntity) AND (CUST.CIETXN.creditEntity != BANCS.STDIN.contextBankId) AND (CUST.CIETXN.debitEntity != BANCS.STDIN.contextBankId))THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Atleast one account should belong to Initiating Entity OR Both Cr AND Dr A/c should belong to same target entity"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	#}
	ENDIF
	
	###########################################################################################
	# Get the Charge Event Id
	###########################################################################################
	
	CUST.CIETXN.parameterId = CUST.CIETXN.txnType + "_CHRG_EVT_ID"
	print(CUST.CIETXN.parameterId)
	CUST.CIETXN.parameterId = "TT_CHRG_EVT_ID_55"
	
	sv_s = "chargeEventId|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Charge Event Id not set in CPARAM;"
		GOTO NOSTRO
	#}
	ENDIF
	
	CUST.CIETXN.chargeEventId = BANCS.OUTPARAM.chargeEventId
	print(CUST.CIETXN.chargeEventId)
	
	CUST.CIETXN.chargeEventIdFlg = "Y"
	
	CUST.CIETXN.chargeAmtCcy = BANCS.STDIN.homeCrncyCode
	print(CUST.CIETXN.chargeAmtCcy)
	###########################################################################################
	# Get the Charge Amt
	###########################################################################################
	
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|C")
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|CR")
	sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" +CUST.CIETXN.chargeEventId)
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" +CUST.CIETXN.chargeAmtCcy)
	sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.CIETXN.chargeAmtCcy)
	sv_u = urhk_SetUrhkOut("genChrgDtl.calcAmt|calcAmt")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltGenChrgDtl|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to get Charge Details;"
		GOTO NOSTRO
	#}
	ENDIF
	
	CUST.CIETXN.calcAmt = BANCS.OUTPARAM.calcAmt
	print(CUST.CIETXN.calcAmt)
	
	sv_p = GETPOSITION(CUST.CIETXN.calcAmt,"|")
	print(sv_p)
	
	IF(sv_p > 0)THEN
	#{
		sv_a = MID$(CUST.CIETXN.calcAmt,0,sv_p-1)
		print(sv_a)
		CUST.CIETXN.chargeAmt = sv_a
		print(CUST.CIETXN.chargeAmt)
		
		sv_c = MID$(CUST.CIETXN.calcAmt,sv_p,3)
		print(sv_c)
		CUST.CIETXN.chargeAmtCcy = sv_c
		print(CUST.CIETXN.chargeAmtCcy)
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to get Charge Details;"
		GOTO NOSTRO
	#}
	ENDIF
	
	CUST.CIETXN.chargeAmtFlg = "Y"
	CUST.CIETXN.chargeAmtCcyFlg = "Y"
	
	###########################################################################################
	# Get the Nostro Account Id
	###########################################################################################
	
	NOSTRO:
		
		CUST.CIETXN.nostroAcctFlg = "Y"
		
		###########################################################################################
		# Get the Vostro Account Id
		###########################################################################################
		
	VOSTRO:
		
		CUST.CIETXN.vostroAcctFlg = "Y"
		
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmt|"+CUST.CIETXN.chargeAmt)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmtFlg|"+CUST.CIETXN.chargeAmtFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmtCcy|"+CUST.CIETXN.chargeAmtCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeAmtCcyFlg|"+CUST.CIETXN.chargeAmtCcyFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeEventId|"+CUST.CIETXN.chargeEventId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("chargeEventIdFlg|"+CUST.CIETXN.chargeEventIdFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("nostroAcct|"+CUST.CIETXN.nostroAcct)
		print(sv_u)
		sv_u = urhk_SetOrbOut("nostroAcctFlg|"+CUST.CIETXN.nostroAcctFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("vostroAcct|"+CUST.CIETXN.vostroAcct)
		print(sv_u)
		sv_u = urhk_SetOrbOut("vostroAcctFlg|"+CUST.CIETXN.vostroAcctFlg)
		print(sv_u)
		
		
END-->
