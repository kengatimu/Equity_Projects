<--START
CHECKSUM="ccfb831f5c62b7c76021f33970be403e1b64566acc8d39010380b6b52fb6c866"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.debitEntity = " "
	CUST.CIETXN.debitEntityDesc = " "
	CUST.CIETXN.debitEntityHomeCcy = " "
	CUST.CIETXN.recordCount = "0"
	
	BANCS.INPARAM.BINDVARS = ""
	sv_s = "recordCount|"
	sv_s = sv_s + " SELECT COUNT(*)"
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE DEL_FLG != 'Y'"
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.recordCount = BANCS.OUTPARAM.recordCount
		print(CUST.CIETXN.recordCount)
	#}
	ENDIF
	
	sv_u = urhk_SetOrbOut("recordCount|"+CUST.CIETXN.recordCount)
	print(sv_u)
	
	BANCS.INPARAM.BINDVARS = ""
	sv_s = "debitEntity,debitEntityDesc,debitEntityHomeCcy|"
	sv_s = sv_s + " SELECT BANK_ID,GROUP_DESC,HOME_CRNCY_CODE"
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE DEL_FLG != 'Y'"
	sv_s = sv_s + " ORDER BY BANK_ID"
	print(sv_s)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF(sv_c != 0)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	
	sv_i = 1
	
	WHILE(sv_f == 0)
	#{
		CUST.CIETXN.debitEntity = BANCS.OUTPARAM.debitEntity
		print(CUST.CIETXN.debitEntity)
		
		CUST.CIETXN.debitEntityDesc = TOUPPER(BANCS.OUTPARAM.debitEntityDesc)
		print(CUST.CIETXN.debitEntityDesc)
		
		CUST.CIETXN.debitEntityHomeCcy = BANCS.OUTPARAM.debitEntityHomeCcy
		print(CUST.CIETXN.debitEntityHomeCcy)
		
		sv_s = "debitEntity_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.debitEntity
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "debitEntityDesc_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.debitEntityDesc
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "debitEntityHomeCcy_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.debitEntityHomeCcy
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_i = sv_i + 1
		
		sv_f = urhk_dbCursorFetch(sv_n)
		print(sv_f)
		
	#}
	DO
	
	sv_c = urhk_dbCursorClose(sv_n)
	print(sv_c)
	
	
	ENDOFSCRIPT:
		
END-->
