#-------------------------------------------------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="a6b006673acb4d6a6e380bb38db478e42e5772aa24d4cf2d84fb782df3d73a46"
	#TRACE ON
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.reportTo)
	PRINT(BANCS.INPUT.tranSub)
	PRINT(BANCS.INPUT.upldFile)
	PRINT(BANCS.INPUT.test)
	PRINT(BANCS.INPUT.tranRemark)
	CUST.DATA.reNameFile = " "
	CUST.DATA.errorMsg   = ""
	
	sv_s = "tmeStmp|SELECT TO_CHAR(SYSDATE,'DDMMYYYYHHMMSS') FROM DUAL "
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d ==0) THEN
	#{
		CUST.DATA.tmeStmp = BANCS.OUTPARAM.tmeStmp
		PRINT(CUST.DATA.tmeStmp)
	#}
	ENDIF
	
	CUST.DATA.tmpfilename = "CCARD_" + CUST.DATA.tmeStmp + ".txt"
	print(CUST.DATA.tmpfilename)
	
	
	#---------------------------------------------------------------------------------
	# RPTFILE  is fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "CARDSETLMNT"
	BANCS.INPUT.parameterId = "RPTFILE"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.file = BANCS.OUTPUT.parameterVal
		PRINT(CUST.DATA.file)
		#}
	ELSE
		#{
		sv_e = "Report File setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# LSTFILE  is fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "LSTFILE"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.lstfile = BANCS.OUTPUT.parameterVal
		PRINT(CUST.DATA.lstfile)
		#}
	ELSE
		#{
		sv_e = "List File setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# ROWCODE  is fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "ROWCODE"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.rowCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.DATA.rowCode)
		#}
	ELSE
		#{
		sv_e = "RowCode setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# TXTFILE  is fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.parameterId = "TXTFILE"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.txtfile = BANCS.OUTPUT.parameterVal
		PRINT(CUST.DATA.txtfile)
		#}
	ELSE
		#{
		sv_e = "Txt File setup not done in CPARAM"
		sv_m = "count"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF (BANCS.INPUT.upldFile=="") THEN
	#{
		sv_e = "The Upload File name should be entered"
		sv_m = "upldFile"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		#------------------------------------------------------------
		# Taking the upload file path
		#------------------------------------------------------------
		sv_u = urhk_getEnv("DATA_PATH")
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			PRINT("User Id Password is not set, taking default value")
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			print(BANCS.OUTPARAM.envValue)
			CUST.DATA.upldPath = BANCS.OUTPARAM.envValue
			PRINT(CUST.DATA.upldPath)
			
			#----------TOL - 367144-------------#
			BANCS.INPUT.upldPath = CUST.DATA.upldPath
			#---------------------------------------------------------------
			# Calling common script to append userId to upload file path
			#---------------------------------------------------------------
			CALL("appendUserId.scr")
			CUST.DATA.upldPath = BANCS.INPUT.upldPath
			PRINT(CUST.DATA.upldPath)
		#}
		ENDIF
		#------------------------------------------------------------
		# Taking the report file path
		#------------------------------------------------------------
		sv_u = urhk_getEnv("FIN_REPORTS_DIR")
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Report file path is not set in common ENV^upldFile")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			print(BANCS.OUTPARAM.envValue)
			CUST.DATA.rptPath = BANCS.OUTPARAM.envValue
			PRINT(CUST.DATA.rptPath)
		#}
		ENDIF
		#------------------------------------------------------------
		# checking if the upload file exists
		#------------------------------------------------------------
		sv_a = "test -f " + CUST.DATA.upldPath + BANCS.INPUT.upldFile
		sv_r = SYSTEM(sv_a)
		print(SV_R)
		IF (sv_r != 0) THEN
		#{
			sv_e = "The Upload File name does not exist OR the wrong uploadfile name"
			sv_m = "upldFile"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			BANCS.STDIN.contextBankId = "   "+BANCS.STDIN.contextBankId
			print(BANCS.STDIN.contextBankId)
			sv_a = "sed 's/$/" + BANCS.STDIN.contextBankId + "/g' " + CUST.DATA.upldPath + BANCS.INPUT.upldFile  + " > "  + CUST.DATA.tmpfilename
			print(sv_a)
			sv_r = SYSTEM(sv_a)
			PRINT(sv_r)
			BANCS.STDIN.contextBankId = TRIM(BANCS.STDIN.contextBankId)
			
			#sv_s = "cp " + CUST.DATA.tmpfilename + " " + CUST.DATA.upldPath + BANCS.INPUT.upldFile
			# print(sv_s)
			#	 sv_r = SYSTEM(sv_s)
			#    	 PRINT(sv_r)
			
			PRINT(CUST.DATA.file)
			sv_a = "test -f " + CUST.DATA.rptPath + CUST.DATA.file
			sv_r = SYSTEM(sv_a)
			PRINT(sv_r)
			IF (sv_r == 0) THEN
			#{
				sv_s = "rm -f " + CUST.DATA.rptPath + CUST.DATA.file
				sv_r = SYSTEM(sv_s)
			#}
			ENDIF
			
			CUST.DATA.processfile=BANCS.INPUT.upldFile + ".RPT"
			PRINT(CUST.DATA.processfile)
			sv_a = "test -f " + CUST.DATA.processfile
			sv_r = SYSTEM(sv_a)
			PRINT(sv_r)
			IF (sv_r == 0) THEN
			#{
				sv_s = "rm -f " + CUST.DATA.processfile
				sv_r = SYSTEM(sv_s)
			#}
			ENDIF
			#---------------------------------------------------------------------------
			#Changing file name to for process/upload
			#---------------------------------------------------------------------------
			sv_s = "cp " + CUST.DATA.tmpfilename + " " + CUST.DATA.txtfile
			sv_r = SYSTEM(sv_s)
			PRINT(sv_r)
			
			#---------------------------------------------------------------------------
			#Deleting  records from table
			#---------------------------------------------------------------------------
			
			sv_s = "DELETE FROM CUSTOM.C_CCST "
			sv_s = sv_s + " WHERE BANK_ID = ?SVAR "
			BANCS.INPARAM.BINDVARS = TRIM(BANCS.STDIN.contextBankId)
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_dbSQLWithBind("COMMIT")
				PRINT(sv_u)
				#}
			ELSE
				#{
				PRINT("Error Occured")
			#}
			ENDIF
		#}
		ENDIF
		
		#---------------------------------------------------------------------------
		#The following step is to Validate test flag
		#---------------------------------------------------------------------------
		PRINT(BANCS.INPUT.test)
		IF (BANCS.INPUT.test=="") THEN
		#{
			sv_e = "The test flag should be entered"
			sv_m = "test"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			IF ((BANCS.INPUT.test != "Y") AND (BANCS.INPUT.test != "N")) THEN
			#{
				sv_e = "Inavlid test flag  'Y' OR 'N'"
				sv_m = "test"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		#---------------------------------------------------------------------------
		#The following step is to Validate remarks
		#---------------------------------------------------------------------------
		PRINT(BANCS.INPUT.tranRemark)
		
		IF (BANCS.INPUT.tranRemark == "") THEN
		#{
			sv_e = "Valid remarks must be entered"
			sv_m = "tranRemark"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.DATA.remarks = TRIM(BANCS.INPUT.tranRemark)
		
		IF (BANCS.INPUT.test == "Y") THEN
		#{
			CUST.DATA.posting = "T"
			CUST.DATA.Rename = "N"
			#}
		ELSE
			#{
			CUST.DATA.posting = "P"
			CUST.DATA.Rename = "Y"
		#}
		ENDIF
		
		
		sv_u = urhk_getEnv("USER_PASS")
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			PRINT("User Id Password is not set, taking default value")
			sv_z = urhk_SetOrbOut("Error_01|ERROR^User Id Password is not set in common ENV^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			print(BANCS.OUTPARAM.envValue)
			CUST.DATA.userPass = BANCS.OUTPARAM.envValue
			PRINT(CUST.DATA.userPass)
		#}
		ENDIF
		
		sv_u = urhk_getEnv("CTL_PATH")
		PRINT(sv_u)
		#sv_u = 0
		IF (sv_u != 0) THEN
		#{
			PRINT("User Id Password is not set, taking default value")
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			print(BANCS.OUTPARAM.envValue)
			CUST.DATA.ctlPath = BANCS.OUTPARAM.envValue
			PRINT(CUST.DATA.ctlPath)
		#}
		ENDIF
		
		CUST.DATA.reNameFile = CUST.DATA.upldPath + BANCS.INPUT.upldFile
		PRINT(CUST.DATA.reNameFile)
		
		sv_u = urhk_getFileLocation("COM|CCardSettle.com")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			#----------------------------------------------------------------------------------
			#---    Setting Env variables
			#----------------------------------------------------------------------------------
			sv_a = "sqlInput|" + BANCS.INPUT.upldFile + "/" + BANCS.INPUT.tranRemark
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "bankId|" + BANCS.STDIN.contextBankId
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "rowCode|" + CUST.DATA.rowCode
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "file|" + CUST.DATA.file
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "lstFile|" + CUST.DATA.lstfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "renameFlg|" + CUST.DATA.Rename
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "renameFile|" + CUST.DATA.reNameFile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "pstdFlg|" + CUST.DATA.posting
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "txtFile|" + CUST.DATA.txtfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "processFile|" + CUST.DATA.processfile
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_a = "remarks|" + CUST.DATA.remarks
			sv_u = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Error in setting env variable drAcctCrncy"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------
			#---    Executing com file in background
			#----------------------------------------------------------------------------------
			BANCS.INPARAM.scriptName = "CCardSettle.com"
			BANCS.INPARAM.arguments = ""
			sv_u = urhk_CallShellScript("b")
			print(sv_u)
			IF (sv_u != 0) THEN
			#{
				CUST.DATA.errorMsg = "Upload process failed please retry"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.DATA.errorMsg = "Unable to load com file"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		ENDOFSCRIPT:
			IF (CUST.DATA.errorMsg != "") THEN
			#{
				sv_z = urhk_SetOrbOut("Error_01|ERROR^"+CUST.DATA.errorMsg+"^testMode")
				sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
				#}
			ELSE
				#{
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Upload/Process Initiated SuccessFully"
				sv_z = urhk_SetOrbOut(sv_g)
			#}
			ENDIF
			
			EXITSCRIPT
	END-->
	
	
