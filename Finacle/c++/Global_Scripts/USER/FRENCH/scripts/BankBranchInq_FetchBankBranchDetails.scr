#----------------------------------------------------------------------------------------------------------
# Filename              :       BankBranchInq_FetchBankBranchDetails.scr
# Author                :       Kalvin Joseph
# Description           :       This script fetches the bankcode,branchcode and bankIdentifier based on the request xml
# Input                 :       paySysID,localClearingFlg
# Output                :       None
# Called Script         :       BankBranchInq_main.scr
# Calling Script        :       None
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           07-03-2013	Kalvin              Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
TRACE ON

	IF(CUST.INTERFACE.paySysID != "")THEN
	#{
		#-------------------------------------------------------------------------------------
		#Fetching the bankcode branchcode and bank identifier
		#-------------------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.paySysID + "|" + CUST.INTERFACE.localClearingFlg
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N" + "|" + CUST.INTERFACE.bankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N" + "|" + CUST.INTERFACE.bankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + "N" + "|" + CUST.INTERFACE.bankId
		
		sv_s= "bankCode,branchCode,bankIdentifier,branchName|"
		sv_s = sv_s + "SELECT BRBIC.BANK_CODE,BRBIC.BRANCH_CODE,BRBIC.BANK_IDENTIFIER,BCT.BR_NAME"
		sv_s = sv_s + " FROM TBAADM.BRBIC,TBAADM.BKC,TBAADM.BCT WHERE BRBIC.PAYSYS_ID = ?SVAR"
		sv_s = sv_s + " AND BRBIC.BANK_CODE = BKC.BANK_CODE AND BKC.BANK_LOCAL_CLG_FLG = ?SVAR"
		sv_s = sv_s + " AND BRBIC.BANK_CODE = BCT.BANK_CODE AND BRBIC.BRANCH_CODE = BCT.BR_CODE"
		sv_s = sv_s + " AND BRBIC.DEL_FLG = ?SVAR AND BRBIC.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND BKC.DEL_FLG = ?SVAR AND BKC.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND BCT.DEL_FLG = ?SVAR AND BCT.BANK_ID = ?SVAR"
	#}
	ELSE
	#{
		#-------------------------------------------------------------------------------------
		#Fetching the bankcode branchcode and Branch name
		#-------------------------------------------------------------------------------------
		BANCS.INPARAM.BINDVARS = CUST.INTERFACE.bankCode + "|" + "N" + "|" + CUST.INTERFACE.bankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|"  + "N" + "|" + CUST.INTERFACE.bankId
		sv_s = "bankCode,branchCode,branchName|"
		sv_s = sv_s + "SELECT BCT.BANK_CODE,BCT.BR_CODE, BCT.BR_NAME"
		sv_s = sv_s + " FROM TBAADM.BCT ,TBAADM.BKC"
		sv_s = sv_s + " WHERE BCT.BANK_CODE = ?SVAR"
		sv_s = sv_s + " AND BCT.BANK_CODE = BKC.BANK_CODE"
		sv_s = sv_s + " AND  BKC.DEL_FLG = ?SVAR AND BKC.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND  BCT.DEL_FLG = ?SVAR AND BCT.BANK_ID = ?SVAR"
	#}
	ENDIF
	print(sv_s)
	sv_d = urhk_dbCursorOpenWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		sv_c = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_r = urhk_dbCursorFetch(sv_c)
		sv_q = 0
		#-------------------------------------------------------------------------------------
		#Assigning the fetched multirecord value to repository variable
		#-------------------------------------------------------------------------------------
		WHILE(sv_r == 0)
		#{
			sv_q = sv_q + 1
			sv_v = "bankCode_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.bankCode
			sv_v = "branchCode_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.branchCode
			
			IF (CUST.INTERFACE.paySysID  != "") THEN
			#{
				sv_v = "bankIdentifier_" + FORMAT$(sv_q, "%d")
				("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.bankIdentifier
			#}
			ENDIF
			sv_v = "branchName_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.branchName
			sv_r = urhk_dbCursorFetch(sv_c)
		#}
		DO
		sv_r = urhk_dbCursorClose(sv_c)
		CUST.INTERFACE.recordCount = sv_q
		PRINT(CUST.INTERFACE.recordCount)
	#}
	ENDIF
#TRACE OFF

END-->
