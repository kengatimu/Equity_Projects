	sv_s = sv_s + " FROM TBAADM.GSP"
	sv_s = sv_s + " WHERE schm_type= 'SBA' "
	sv_s = sv_s + " AND del_flg = 'N'"
	sv_s = sv_s + " AND bank_id =?SVAR "
	#PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(sv_s)
	
	sv_c    =   urhk_dbCursorOpenWithBind(sv_s)
	#PRINT(sv_c)
	
	IF(sv_c != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (sv_c == 0) THEN
	#{
		CUST.DATA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.DATA.cursorNum)
		sv_r = urhk_dbCursorFetch(CUST.DATA.cursorNum)
		PRINT(sv_r)
		IF(sv_r == 0) THEN
		#{
			WHILE (sv_r == 0)
			#{
				CUST.DATA.counter = CINT(CUST.DATA.counter) + 1
				CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
				CUST.DATA.schmDesc = BANCS.OUTPARAM.schmDesc
				
				sv_u    =   urhk_SetOrbOut("recCount|" + CUST.DATA.counter)
				IF(CUST.DATA.schmCode != "") THEN
				#{
					sv_y    = "schmCode_" + CUST.DATA.counter + "|" + CUST.DATA.schmCode
					PRINT(sv_y)
					sv_z    = "schmDesc_" + CUST.DATA.counter + "|" + CUST.DATA.schmDesc
					PRINT(sv_z)
					
					sv_t = urhk_SetOrbOut(sv_y)
					PRINT(sv_t)
					sv_x = urhk_SetOrbOut(sv_z)
					PRINT(sv_x)
				#}
				ENDIF
				
				PRINT(CUST.DATA.cursorNum)
				sv_r = urhk_dbCursorFetch(CUST.DATA.cursorNum)
			#}
			DO
			#}
		ELSE
			#{
			PRINT("No records fetched")
		#}
		ENDIF
		
		PRINT(CUST.DATA.cursorNum)
		sv_r = urhk_dbCursorClose(CUST.DATA.cursorNum)
	#}
	ENDIF
	
	PRINT(CUST.DATA.counter)
	
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
END-->
