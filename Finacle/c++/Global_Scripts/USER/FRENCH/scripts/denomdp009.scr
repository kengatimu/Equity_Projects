			#{
				BANCS.INPARAM.BINDVARS = CUST.DENOM.refCrncy +"|"+ CUST.DENOM.acctCrncy +"|"+ CUST.DENOM.bank_id
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_a = "count8 | SELECT count(*) "
				sv_a = sv_a + "FROM tbaadm.RTL "
				sv_a = sv_a + "WHERE fxd_crncy_code = ?SVAR "
				sv_a = sv_a + "AND var_crncy_code = ?SVAR "
				sv_a = sv_a + "AND del_flg != 'Y' "
				sv_a = sv_a + "AND bank_id =?SVAR "
