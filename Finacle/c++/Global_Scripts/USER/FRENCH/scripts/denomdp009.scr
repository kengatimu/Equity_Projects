		#-----------SEND THE OUTPUT TO THE FRONT END FOR CURRENCY CODE : START----------------------------------------
		
		PRINT(CUST.DENOM.flag1)
		
		IF(CUST.DENOM.no == 0)THEN
		#{
			CUST.DENOM.fromTo = "FROM"
			#}
		ELSE
			#{
			CUST.DENOM.fromTo = "TO"
		#}
		ENDIF
		
		IF (CUST.DENOM.flag1 == "IVL")THEN
		#{
			CUST.DENOM.ErrMsg = "Enter a Valid Currency Code"
