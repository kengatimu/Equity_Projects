	ENDIF
	
	#-----------CHECK THE DIFFERENT CONDITIONS OF THE FLAG : END -------------------------------
	#-----------QUERY IN CNC TABLE IF THE ENTERED CURRENCY EXISTS OR NOT : END------------------
	
	
	#-----------SEND THE OUTPUT TO THE FRONT END FOR THE RATECODE : START----------------------------------------
	
	PRINT(CUST.DENOM.flag)
	IF (CUST.DENOM.flag == "IVL")THEN
	#{
		CUST.DENOM.ErrMsg = "Enter a Valid Rate Code"
		sv_u = urhk_setOrbOut("Error|RATE&"+CUST.DENOM.ErrMsg)
		PRINT(sv_u)
		GOTO FINISH
	#}
	ENDIF
	IF(CUST.DENOM.flag == "NOT")THEN
	#{
		CUST.DENOM.ErrMsg = "Rate code not maintained for this currency combination"
		sv_u = urhk_setOrbOut("Error|RATE&"+CUST.DENOM.ErrMsg)
		PRINT(sv_u)
		GOTO FINISH
	#}
	ENDIF
	IF(CUST.DENOM.flag == "VAL")THEN
	#{
		CUST.DENOM.ErrMsg = "valid value"
		sv_u = urhk_setOrbOut("Success|RATE&"+CUST.DENOM.ErrMsg)
