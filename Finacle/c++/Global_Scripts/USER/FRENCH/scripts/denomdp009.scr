		CUST.DENOM.no = CINT(CUST.DENOM.no) + 1
	#}
	DO
	
	#-----------SEND THE OUTPUT TO THE FRONT END FOR CURRENCY CODE : END ---------------------
	
	#-----------QUERY IN CNC TABLE IF THE ENTERED CURRENCY EXISTS OR NOT : END ---------------
	
	#-------------------------------------------------------------------------------------
	# VALIDATE IF THE ENTERED RATE CODE IS VALID OR NOT
	#-------------------------------------------------------------------------------------
	
	#-----------QUERY IN RTL TABLE IF THE ENTERED RATE CODE EXISTS OR NOT : START --------
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.acctCrncy +"|"+ CUST.DENOM.refCrncy +"|"+ CUST.DENOM.RateCode +"|"+ CUST.DENOM.bank_id
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_a = "count5 | SELECT count(*) "
	sv_a = sv_a + "FROM tbaadm.RTL "
	sv_a = sv_a + "WHERE fxd_crncy_code =  ?SVAR "
	sv_a = sv_a + "AND var_crncy_code = ?SVAR "
	sv_a = sv_a + "AND del_flg != 'Y' "
	sv_a = sv_a + "AND ratecode = ?SVAR "
	sv_a = sv_a + "AND bank_id =?SVAR "
	PRINT(sv_a)
	
	sv_q = urhk_dbSelectWithbind(sv_a)
	PRINT(sv_q)
	
	IF(sv_q == 0) THEN
	#{
		CUST.DENOM.count5 = BANCS.OUTPARAM.count5
		PRINT(CUST.DENOM.count5)
		
		#-----------QUERY IN RTL TABLE IF INVERSE OF THE ENTERED RATE CODE EXISTS OR NOT : START ----
		
		IF(CUST.DENOM.count5 == 0) THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DENOM.refCrncy +"|"+ CUST.DENOM.acctCrncy +"|"+ CUST.DENOM.RateCode +"|"+ CUST.DENOM.bank_id
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_a = "count6 | SELECT count(*) "
			sv_a = sv_a + "FROM tbaadm.RTL "
			sv_a = sv_a + "WHERE fxd_crncy_code = ?SVAR "
			sv_a = sv_a + "AND var_crncy_code = ?SVAR "
			sv_a = sv_a + "AND del_flg != 'Y' "
			sv_a = sv_a + "AND ratecode =?SVAR "
			sv_a = sv_a + "AND bank_id =?SVAR "
			PRINT(sv_a)
			
			sv_q = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_q)
			IF(sv_q == 0) THEN
			#{
				CUST.DENOM.count6 = BANCS.OUTPARAM.count6
				PRINT(CUST.DENOM.count6)
				IF(CUST.DENOM.count6 == 0) THEN
				#{
					CUST.DENOM.flag = "IVL"
					#}
				ELSE
					#{
					CUST.DENOM.flag = "VAL"
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.DENOM.flag = "VAL"
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------QUERY IN RTL TABLE INVERSE OF THE ENTERED RATE CODE EXISTS OR NOT : END --------
	
	#-----------CHECK THE DIFFERENT CONDITIONS OF THE FLAG  : START-----------------------------
	
	IF(CUST.DENOM.flag == "IVL") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DENOM.acctCrncy +"|"+ CUST.DENOM.refCrncy +"|"+ CUST.DENOM.bank_id
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_a = "count7 | SELECT count(*) "
		sv_a = sv_a + "FROM tbaadm.RTL "
		sv_a = sv_a + "WHERE fxd_crncy_code = ?SVAR "
		sv_a = sv_a + "AND var_crncy_code = ?SVAR "
		sv_a = sv_a + "AND del_flg != 'Y' "
		sv_a = sv_a + "AND bank_id =?SVAR "
		PRINT(sv_a)
		
		sv_q = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_q)
		
		IF(sv_q == 0) THEN
		#{
			CUST.DENOM.count7 = BANCS.OUTPARAM.count7
			PRINT(CUST.DENOM.count7)
