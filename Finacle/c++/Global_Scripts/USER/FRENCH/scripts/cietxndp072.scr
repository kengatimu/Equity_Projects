<--START
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.targetCrncy = " "
	CUST.CIETXN.targetEntity = " "
	CUST.CIETXN.homecrncy = " "
	CUST.CIETXN.targetCrncyName = " "
	CUST.CIETXN.recordCount = "4"
	
	CUST.CIETXN.targetEntity = BANCS.INPUT.targetEntity
	PRINT(CUST.CIETXN.targetEntity)

	sv_u = urhk_SetOrbOut("recordCount|"+CUST.CIETXN.recordCount)
	print(sv_u)
	
	sv_s = "homecrncy|SELECT HOME_CRNCY_CODE FROM TBAADM.GCT WHERE BANK_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.targetEntity

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
		CUST.CIETXN.homecrncy = BANCS.OUTPARAM.homecrncy
	#}
	ELSE
	#{
		sv_u = urhk_SetOrbErr("DB Error Please contact DBA")
		exitscript	
	#}
	ENDIF
	PRINT(CUST.CIETXN.homecrncy)

	BANCS.INPARAM.BINDVARS = CUST.CIETXN.targetEntity
	sv_s = "targetCrncy,targetCrncyName|"
	sv_s = sv_s + " SELECT CRNCY_CODE,CRNCY_NAME"
	sv_s = sv_s + " FROM TBAADM.CNC "
	sv_s = sv_s + " WHERE CRNCY_CODE IN ('USD','GBP','EUR','"+CUST.CIETXN.homecrncy+"')"
	sv_s = sv_s + " AND  BANK_ID=?SVAR"
	print(sv_s)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF(sv_c != 0)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	
	sv_i = 1
	
	WHILE(sv_f == 0)
	#{
		CUST.CIETXN.targetCrncy = BANCS.OUTPARAM.targetCrncy
		print(CUST.CIETXN.targetCrncy)
		
		CUST.CIETXN.targetCrncyName = TOUPPER(BANCS.OUTPARAM.targetCrncyName)
		print(CUST.CIETXN.targetCrncyName)
		
		
		sv_s = "targetCrncy_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.targetCrncy
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_s = "targetCrncyName_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.targetCrncyName
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		
		sv_i = sv_i + 1
		
		sv_f = urhk_dbCursorFetch(sv_n)
		print(sv_f)
		
	#}
	DO
	
	sv_c = urhk_dbCursorClose(sv_n)
	print(sv_c)
	
	
	ENDOFSCRIPT:
TRACE OFF		
END-->
