<--start
TRACE ON
sv_k=""
sv_y=""
sv_w=""

sv_q="cif_id,phoneno,acct_name,date_of_birth,message|"
sv_q = sv_q + " select distinct g.cif_id ,(case when substr(c.PHONENO,1,1)='+' then substr(c.PHONENO,2) else c.PHONENO end)as PHONENO , "
sv_q = sv_q + " g.acct_name,m.DATE_OF_BIRTH, SUBSTR (LTRIM (g.ACCT_NAME),1,INSTR (LTRIM (g.ACCT_NAME), ' ') - 1) as Message  "
sv_q = sv_q + " from tbaadm.cphone c,tbaadm.gam g, tbaadm.cmg m where c.PHONE_B2KID=g.cif_id and m.cif_id=g.cif_id and c.bank_id=g.bank_id and m.bank_id=g.bank_id and c.bank_id='54' "
sv_q = sv_q + " and g.acct_cls_flg='N' and g.schm_type in ('SBA','CAA') and c.PREFERREDFLAG='Y' and to_char(m.DATE_OF_BIRTH,'DD-MM') =to_char(SYSDATE,'DD-MM') and c.PHONENO is not null "
print(sv_q)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

if(sv_e==0) then
       sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        sv_q = urhk_dbCursorFetch(sv_m)
        print(sv_q)
        if(sv_q == 1) then
               sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        endif
        print(sv_q)
        while(sv_q==0)
			##################
			# Get account balance as on BOD date.

			sv_a=BANCS.OUTPARAM.cif_id
			print(sv_a)
			sv_b=BANCS.OUTPARAM.phoneno
			print(sv_b)
			sv_c=BANCS.OUTPARAM.acct_name
			print(sv_c)
			sv_d=BANCS.OUTPARAM.date_of_birth
			print(sv_d)
			sv_e=BANCS.OUTPARAM.message
			print(sv_e)

			sv_o = "Happy Birthday "
			print(sv_o)
			sv_r = ", Equity Bank wishes you a day of joy and happiness. Thank you for giving us  an  opportunity to serve you "
			print(sv_r)
			sv_e = sv_o + sv_e + sv_r
			print(sv_e)

			sv_i="BirthdaySMS"
			sv_i= sv_i + BANCS.STDIN.contextBankId
			print(sv_i)

			###################################################################################################
			# Insert into CUSTOM.MOBEE_PUSH_SMS TABLE
			###################################################################################################
			
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			BANCS.INPARAM.BINDVARS =  sv_h
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				sv_f = BANCS.OUTPARAM.getboddate
				print(sv_f)
			ENDIF

			sv_s = " insert into  CUSTOM.MOBEE_PUSH_SMS (REF_NO, LANGUAGE, INSTITUTION_CODE, MOBILE_NUMBER, MESSAGE_ARRIEVED_DATE, MESSAGE_PRIORITY,  "
			sv_s = sv_s + " MESSAGE_STATUS, MESSAGE_VALIDITY_PERIOD, DEPARTMENT, MESSAGE_TEXT,retry_count, BANK_ID ) values ( "
			sv_s = sv_s + " CUSTOM.MOBEE_PUSH_SMS_SEQUENCE.nextval,'EN','068', ?SVAR ,?SVAR,'4','0','86400000',?SVAR, ?SVAR,0,?SVAR) "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = sv_b + "|" + sv_f + "|" + sv_i + "|" + sv_e + "|" + BANCS.STDIN.contextBankId 
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSqlWithBind(sv_s)
			print(sv_d)
			IF (sv_d!=0) THEN
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				print(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Insert Query Failed^prodCode")
				print(sv_u)
				sv_d = urhk_dbSqlWithBind("ROLLBACK")
				print(sv_d)
				GOTO ENDOFSCRIPT
			ELSE
				sv_w = urhk_dbSQLWithBind("COMMIT")
				print(sv_w)
			ENDIF


		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
        do
ENDOFSCRIPT:
TRACE OFF
EXITSCRIPT

end-->
