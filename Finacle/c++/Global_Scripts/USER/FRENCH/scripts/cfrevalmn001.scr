			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
		#}
		ENDIF
		
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG| " + "Record Deleted successfully " + "</b>" + BANCS.INPUT.currCode
		sv_z = urhk_SetOrbOut(sv_g)
		sv_d = urhk_dbSQLWithBind("COMMIT")
	#}
	ENDIF
	
	Finish1:
		TRACE OFF
		EXITSCRIPT
END-->
