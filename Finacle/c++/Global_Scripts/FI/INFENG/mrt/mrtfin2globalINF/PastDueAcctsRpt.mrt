PROCEDURE authorityDetails
#==========================================================================
nextline
nextline
set totcnt = deccnt + nondeccnt +  legcnt + othcnt
set totamt = decamt + nondecamt +  legamt + othamt
if (linesleftinpage < 13)
	nextpage
separatorline
print "                     Particulars                    Follow up Authority  "
print PermOfficeAuthXferPD
nextline
print  "                                         -----------------------------------------------"
nextline
print "                                                 No Of Accts            Amount   "
nextline
separatorline
print "Suit Filed-Decreed" column 6
print deccnt size 8 column 50
print abs decamt size 20 autocomma precision 2 column 61
if(decamt < 0)
begin
    print "Dr"
end
if(decamt > 0)
begin
    print "Cr"
end
nextline
print "Suit Filed-Non-Decreed" column 6
print nondeccnt size 8 column 50
print abs nondecamt size 20 autocomma precision 2 column 61
if(nondecamt < 0)
begin
    print "Dr"
end
if(nondecamt > 0)
begin
    print "Cr"
end
nextline
print "Legal action waived A/cs" column 6
print legcnt size 8 column 50
print abs legamt size 20 autocomma precision 2 column 61
if(legamt < 0)
begin
    print "Dr"
end
if(legamt > 0)
begin
    print "Cr"
end
nextline
print "Other LPD Accounts" column 6
print othcnt size 8 column 50
print abs othamt size 20 autocomma precision 2 column 61
if(othamt < 0)
begin
    print "Dr"
end
if(othamt > 0)
begin
    print "Cr"
end
nextline
print "Total" column 6
print totcnt size 8 column 50
print abs totamt size 20 autocomma precision 2 column 61
if(totamt < 0)
begin
    print "Dr"
end
if(totamt > 0)
begin
    print "Cr"
end
nextline
