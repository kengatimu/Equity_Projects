PROCEDURE splitDetails
#==========================================================================
if(linesleftinpage < 12)
	nextpage
nextline
nextline
print "Split Up Details Of Recovery"
separatorline
print "     Particulars             Currency            Amount"
nextline
separatorline
print "Suit filed-Decreed" column 6
print AcctCrncyCode size 3 column 30
print abs sdecamt size 20 autocomma precision 2 column 39
if(sdecamt < 0)
begin
    print "Dr"
end
if(sdecamt > 0)
begin
    print "Cr"
end
nextline
print "Suit filed-NonDecreed" column 6
print AcctCrncyCode size 3 column 30
print abs snondecamt size 20 autocomma precision 2 column 39
if(snondecamt < 0)
begin
    print "Dr"
end
if(snondecamt > 0)
begin
    print "Cr"
end
nextline
print "Other LPD Accounts" column 6
print AcctCrncyCode size 3 column 30
print abs sothamt size 20 autocomma precision 2 column 39
if(sothamt < 0)
begin
    print "Dr"
end
if(sothamt > 0)
begin
    print "Cr"
end
nextline
set stotamt = stotamt + sdecamt + snondecamt +  sothamt
print "Total Recovery" column 6
print AcctCrncyCode size 3 column 30
print abs stotamt size 20 autocomma precision 2 column 39
if(stotamt < 0)
begin
    print "Dr"
end
if(stotamt > 0)
begin
    print "Cr"
end
nextline
separatorline
#==========================================================================
PROCEDURE printCriteria
#==========================================================================
    nextLine
    nextLine
    separatorLine
    nextline
    nextline
    print   "SELECTION CRITERIA"              column 40
    nextline
    print   "-------------------"             column 40
    nextline
    nextline
    print   "Report To                : "     column 30
    print   crit_reportTo
    nextline
    print   "Set Id                   : "     column 30
    print   crit_solSetId
    nextLine
    print   "Account Num              : "     column 30
    print   crit_acctNum 
    nextline
    print   "CIF ID                   : "     column 30
    print   crit_custId
    nextline
    print   "As on date               : "     column 30
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "From Date                : "     column 30
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextLine
    print   "To Date                  : "     column 30
    set localdate = stringToDate  crit_toDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "Suit Status              : "     column 30
    print   crit_suitStatus
    nextline
	print   "Judicial Authority       : "     column 30
    print   crit_courtOrTribunal
    nextline
	print   "Report Currency Code     : "     column 30
    print   crit_rptCrncyCode
    nextline
    nextline
    separatorLine
