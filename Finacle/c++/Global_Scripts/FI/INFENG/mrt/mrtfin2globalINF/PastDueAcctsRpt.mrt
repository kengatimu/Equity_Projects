########################################################################
# Report Name   :   Quarterly Statement on Past due accounts 
# Template Name :   PastDueAcctsRpt.mrt 
# Description   :   To print the details of past due accounts
#   
#	Modification log
#   ----------------
#   Srl.No.     Date         Author            Version
#   ------   ----------     ------------    --------------
#       1    09-01-2005     Jaya Lakhsmi        1.0
#
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include PastDueAcctsRpt.mri
#
LOCALVARIABLES
srl_num numberType
localdate       numberType
localyears      numberType

FromDate			stringType
ToDate				stringType

deccnt              numberType
decamt              numberType
nondeccnt           numberType
nondecamt           numberType
legcnt              numberType
legamt              numberType
othcnt              numberType
othamt              numberType
totcnt              numberType
totamt              numberType

agricnt             numberType
agriamt             numberType
othercnt            numberType
otheramt            numberType
ssicnt              numberType
ssiamt              numberType

stmpamt             numberType
couramt             numberType
advocamt            numberType
miscamt             numberType
totalamt            numberType
cntopnbal           numberType
totopnbal           numberType

agr_cntopnbal       numberType
agr_totopnbal       numberType
agr_cntnewtrn       numberType
agr_totnewtrn       numberType
agr_cntothexp       numberType
agr_totothexp       numberType
agr_cntwrtoffamt    numberType
agr_totwrtoffamt    numberType
agr_cntdicgclmadj   numberType
agr_totdicgclmadj   numberType
agr_cntecgclmadj   numberType
agr_totecgclmadj   numberType
agr_cntothrec       numberType
agr_totothrec       numberType
agr_cntclsbyrecamt  numberType
agr_totclsbyrecamt  numberType
agr_cnttrnsbckamt   numberType
agr_tottrnsbckamt   numberType
agr_cntunappint     numberType
agr_totunappint     numberType

nonagr_cntopnbal   		numberType
nonagr_totopnbal    	numberType
nonagr_cntnewtrn    	numberType
nonagr_totnewtrn    	numberType
nonagr_cntothexp    	numberType
nonagr_totothexp    	numberType
nonagr_cntwrtoffamt 	numberType
nonagr_totwrtoffamt 	numberType
nonagr_cntdicgclmadj 	numberType
nonagr_totdicgclmadj 	numberType
nonagr_cntecgclmadj 	numberType
nonagr_totecgclmadj 	numberType
nonagr_cntothrec    	numberType
nonagr_totothrec    	numberType
nonagr_cntclsbyrecamt 	numberType
nonagr_totclsbyrecamt 	numberType
nonagr_cnttrnsbckamt 	numberType
nonagr_tottrnsbckamt 	numberType
nonagr_cntunappint   	numberType
nonagr_totunappint   	numberType

totcnt3             numberType
totsum3             numberType
totcnt4             numberType
totsum4             numberType

totcnt1             numberType
totsum1             numberType
totcnt2             numberType
totsum2             numberType

lpdcnt1             numberType
lpdsum1             numberType
lpdcnt2             numberType
lpdsum2             numberType

agr_totclmadjcnt	numberType
nonagr_totclmadjcnt	numberType
totclmadjamt		numberType

sdecamt              numberType
snondecamt           numberType
slegamt              numberType
sothamt              numberType
stotamt              numberType
#
GROUPANDSORT
AcctCrncyCode
PermOfficeAuthXferPD
#

#IGNORERECORD
#if(pastDueFlg = "N")

PAGEFORMAT
linesperpage 62
columnsperline 100
pageheaderlines 7
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip readonly  
localYearsToAdd        stringType
#
REPOSITORY argv4
errorMsg                 stringType
PAGE_NUMBER              numberType
crit_reportTo            stringType
crit_solSetId            stringType
crit_acctNum             stringType
crit_custId			     stringType
crit_asOnDate            stringType
crit_fromDate      		 stringType
crit_toDate        		 stringType
crit_suitStatus          stringType
crit_courtOrTribunal     stringType 
crit_rptCrncyCode        stringType 
#
ONSTARTOFREPORT
set localyears = strToNum localYearsToAdd
  set pageNumber	= 1
  set srl_num 	= 0 
  set FromDate 	= crit_fromDate
  set ToDate   	= crit_toDate
  nextline
  nextline
  nextline
  if (errorMsg != "")
  begin
  	print "Error: "
	print errorMsg
  end
  nextline
  nextline
  nextline
  print "QUARTERLY STATEMENT(CONSOLIDATED) OF PAST DUE ACCOUNTS AS ON " column 15
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
  nextline
  nextline
  execute printCriteria
  nextline
  nextline
  nextline

#
PAGEHEADER
  print "Page No."    column 85
  print pageNumber size 5 precision 0
  nextline
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "" column 85
  print " "
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "HH24:NN:SS"
  nextline
  nextline 
  print "QUARTERLY STATEMENT(CONSOLIDATED) OF PAST DUE ACCOUNTS AS ON " column 15
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
  nextline
  nextline
#
BEFOREBREAKOF PermOfficeAuthXferPD
set deccnt  = 0
set decamt  = 0
set nondeccnt  = 0
set nondecamt  = 0
set legcnt  = 0
set legamt  = 0
set othcnt  = 0
set othamt  = 0
set totcnt  = 0
set totamt  = 0
#
AFTERBREAKOF PermOfficeAuthXferPD
if (srl_num != 0)
	execute authorityDetails
#
AFTERBREAKOF AcctCrncyCode
if ( srl_num != 0)
begin
	execute claimdetails
	execute suitExpenses
	execute movementDetails
	execute splitDetails
end
#
BEFOREBREAKOF AcctCrncyCode
	set srl_num = 0

	set deccnt  = 0
	set decamt  = 0
	set nondeccnt  = 0
	set nondecamt  = 0
	set legcnt  = 0
	set legamt  = 0
	set othcnt  = 0
	set othamt  = 0
	set totcnt  = 0
	set totamt  = 0
	
	set agricnt  = 0
	set agriamt  = 0
	set othercnt = 0
	set otheramt = 0
	set ssicnt   = 0
	set ssiamt   = 0
	set stmpamt  = 0
	set couramt  = 0
	set advocamt = 0
	set miscamt  = 0
	set totalamt = 0

	set agr_cntopnbal = 0
    set agr_totopnbal = 0
    set agr_cntnewtrn = 0
    set agr_totnewtrn = 0
    set agr_totnewtrn = 0
    set agr_cntothexp = 0
    set agr_totothexp = 0
    set agr_cntwrtoffamt  = 0
    set agr_totwrtoffamt  = 0
    set agr_cntdicgclmadj = 0
    set agr_totdicgclmadj = 0
    set agr_cntecgclmadj = 0
    set agr_totecgclmadj = 0
    set agr_cntothrec = 0
    set agr_totothrec = 0
    set agr_cntclsbyrecamt 	= 0
    set agr_totclsbyrecamt 	= 0
    set agr_cnttrnsbckamt 	= 0
    set agr_tottrnsbckamt 	= 0
    set agr_cntunappint 	= 0
    set agr_totunappint 	= 0

    set nonagr_cntopnbal = 0
    set nonagr_totopnbal = 0
    set nonagr_cntnewtrn = 0
    set nonagr_totnewtrn = 0
    set nonagr_totnewtrn = 0
    set nonagr_cntothexp = 0
    set nonagr_totothexp = 0
    set nonagr_cntwrtoffamt  = 0
    set nonagr_totwrtoffamt  = 0
    set nonagr_cntdicgclmadj = 0
    set nonagr_totdicgclmadj = 0
    set nonagr_cntecgclmadj = 0
    set nonagr_totecgclmadj = 0
    set nonagr_cntothrec = 0
    set nonagr_totothrec = 0
    set nonagr_cntclsbyrecamt = 0
    set nonagr_totclsbyrecamt = 0
    set nonagr_cnttrnsbckamt  = 0
    set nonagr_tottrnsbckamt  = 0
    set nonagr_cntunappint = 0
    set nonagr_totunappint = 0

    set totcnt3 = 0
    set totsum3 = 0
    set totcnt4 = 0
    set totsum4 = 0

    set agr_totclmadjcnt    = 0
    set nonagr_totclmadjcnt = 0
	set totcnt1 = 0
    set totsum1 = 0
    set totcnt2 = 0
    set totsum2 = 0

    set lpdcnt1 = 0
    set lpdsum1 = 0
    set lpdcnt2 = 0
    set lpdsum2 = 0
	
	set sdecamt = 0
    set snondecamt = 0
    set sothamt = 0
    set stotamt = 0
	nextpage
	nextline
	print "Currency code:" column 1
	print AcctCrncyCode size 3 column 15

#==========================================================================
ONEVERYRECORD
#========================================================================
execute detailRecord
#
#==========================================================================
ONENDOFREPORT
#==========================================================================
    if(srl_num = 0)
    begin
        nextline
        nextline
        nextline
        nextline
        print "----------  NO RECORDS SELECTED FOR PRINTING  --------- " column 14
        nextline
    end
	nextline
    nextline
	nextline
	print "Date      Place     Prepared By     Checked By      Authorised Signatures" column 10
    nextline
	nextline
	nextline
	print "*** " column 24
	print pageNumber size 3 column 30 precision 0
	print " PAGE(S) PRINTED. ****END OF REPORT****" size 40 column 34
	nextline
#
    set PAGE_NUMBER = pagenumber
#
#===================================================================================
PROCEDURE claimdetails
#===================================================================================
nextline
nextline
separatorline
if (linesleftinpage < 9)
	nextpage
print "Credit Guarantee Claim Amount Settled But Not Yet Adjusted"
separatorline
print "            Agriculture                      Other Priority                      SSI"
separatorline
print "    No Of Accts            Amount    No Of Accts            Amount    No Of Accts            Amount"
separatorline
print agricnt size 8 column 5
print abs agriamt size 20 autocomma precision 2 column 13
if(agriamt < 0)
begin
    print "Dr"
end
if(agriamt > 0)
begin
    print "Cr"
end
print othercnt size 8 column 36
print abs otheramt size 20 autocomma precision 2 column 44
if(otheramt < 0)
begin
    print "Dr"
end
if(otheramt > 0)
begin
    print "Cr"
end
print ssicnt size 8 column 67
print abs ssiamt size 20 autocomma precision 2 column 75
if(ssiamt < 0)
begin
    print "Dr"
end
if(ssiamt > 0)
begin
    print "Cr"
end
separatorline

#==========================================================================
PROCEDURE suitExpenses
#==========================================================================
nextline
nextline
if (linesleftinpage < 9)
	nextpage
separatorline
print "Suit expenses incurred during the period" column 1
separatorline
print "Stamp Duty/Court Fee      Advocate Fee              Others               Total"
separatorline
set totalamt = stmpamt + couramt
print abs totalamt size 20 autocomma precision 2 column 2
if(totalamt < 0)
begin
    print "Dr"
end
if(totalamt > 0)
begin
    print "Cr"
end
print abs advocamt size 20 autocomma precision 2 column 25
if(advocamt < 0)
begin
    print "Dr"
end
if(advocamt > 0)
begin
    print "Cr"
end
print abs miscamt size 20 autocomma precision 2 column 48
if(miscamt < 0)
begin
    print "Dr"
end
if(miscamt > 0)
begin
    print "Cr"
end
set totalamt = totalamt + advocamt + miscamt
print abs totalamt size 20 autocomma precision 2 column 70 
if(totalamt < 0)
begin
    print "Dr"
end
if(totalamt > 0)
begin
    print "Cr"
end
separatorline
#==========================================================================
PROCEDURE movementDetails
#==========================================================================
nextline
	set totcnt1 = agr_cntopnbal + agr_cntnewtrn + agr_cntothexp
	set totsum1 = agr_totopnbal + agr_totnewtrn + agr_totothexp
	set totcnt2 = nonagr_cntopnbal + nonagr_cntnewtrn + nonagr_cntothexp
	set totsum2 = nonagr_totopnbal + nonagr_totnewtrn + nonagr_totothexp

	set totcnt3 = agr_cntwrtoffamt + agr_cntdicgclmadj + agr_cntothrec + agr_cntclsbyrecamt + agr_cnttrnsbckamt
	set totsum3 = agr_totwrtoffamt + agr_totdicgclmadj + agr_totothrec + agr_totclsbyrecamt + agr_tottrnsbckamt 
	set totcnt4 = nonagr_cntwrtoffamt + nonagr_cntdicgclmadj + nonagr_cntothrec + nonagr_cntclsbyrecamt + nonagr_cnttrnsbckamt
	set totsum4 = nonagr_totwrtoffamt + nonagr_totdicgclmadj + nonagr_totothrec + nonagr_totclsbyrecamt + nonagr_tottrnsbckamt
	
	set lpdcnt1 = totcnt1 - totcnt3
	set lpdsum1 = totsum1 - totsum3
	set lpdcnt2 = totcnt2 - totcnt4
	set lpdsum2 = totsum2 - totsum4

	nextline
	if (linesleftinpage < 25)
	nextpage
	separatorline
	print "     Particulars                      Agriculture                  Non-Agriculture"
	separatorline
	print "                               No Of Accts            Amount   No Of Accts            Amount"
	separatorline

	print "Opening Balance As On" 	column 1 
	print agr_cntopnbal size 8 	column 30
	print abs agr_totopnbal size 20 autocomma precision 2 column 40
	if(agr_totopnbal < 0)
   	 	print "Dr"
	if(agr_totopnbal > 0)
    	print "Cr"
	print nonagr_cntopnbal size 8 column 62
	print abs nonagr_totopnbal size 20 autocomma precision 2 column 74
	if(nonagr_totopnbal < 0)
    	print "Dr"
	if(nonagr_totopnbal > 0)
    	print "Cr"
	nextline

	print "New Transfers During" 	column 1
	print agr_cntnewtrn  size 8    	column 30
	print abs agr_totnewtrn size 20 autocomma precision 2 column 40
	if(agr_totnewtrn < 0)
    	print "Dr"
	if(agr_totnewtrn > 0)
    	print "Cr"
	print nonagr_cntnewtrn size 8   column 62
	print abs nonagr_totnewtrn size 20 autocomma precision 2 column 74
	if(nonagr_totnewtrn < 0)
   	 	print "Dr"
	if(nonagr_totnewtrn > 0)
    	print "Cr"
	nextline

	print "Other/Suit expenses" column 1
	print agr_cntothexp size 8 column 30
	print abs agr_totothexp size 20 autocomma precision 2 column 40
	if(agr_totothexp < 0)
    	print "Dr"
	if(agr_totothexp > 0)
    	print "Cr"
	print nonagr_cntothexp size 8 column 62
	print abs nonagr_totothexp size 20 autocomma precision 2 column 74
	if(nonagr_totothexp < 0)
    	print "Dr"
	if(nonagr_totothexp > 0)
    	print "Cr"
	nextline

	print "Total Debit" column 1
	print totcnt1 size 8 column 30
	print abs totsum1 size 20 autocomma precision 2 column 40
	if(totsum1 < 0)
    	print "Dr"
	if(totsum1 > 0)
    	print "Cr"
	print totcnt2 size 8 column 62
	print abs totsum2 size 20 autocomma precision 2 column 74
	if(totsum2 < 0)
    	print "Dr"
	if(totsum2 > 0)
    	print "Cr"
	nextline

	print "Write Off" column 1
	print agr_cntwrtoffamt size 8 column 30
	print abs agr_totwrtoffamt size 20 autocomma precision 2 column 40
	if(agr_totwrtoffamt < 0)
    	print "Dr"
	if(agr_totwrtoffamt > 0)
    	print "Cr"
	print nonagr_cntwrtoffamt size 8 column 62
	print abs nonagr_totwrtoffamt size 20 autocomma precision 2 column 74
	if(nonagr_totwrtoffamt < 0)
    	print "Dr"
	if(nonagr_totwrtoffamt > 0)
    	print "Cr"
	nextline

	print "Dicgc claims adjusted" 	column 1
	print agr_cntdicgclmadj size 8 column 30
	print abs agr_totdicgclmadj size 20 autocomma precision 2 column 40
	if(agr_totdicgclmadj < 0)
    	print "Dr"
	if(agr_totdicgclmadj > 0)
    	print "Cr"
	print nonagr_cntdicgclmadj size 8 column 62
	print abs nonagr_totdicgclmadj size 20 autocomma precision 2 column 74
	if(nonagr_totdicgclmadj < 0)
    	print "Dr"
	if(nonagr_totdicgclmadj > 0)
    	print "Cr"
	nextline

	print "Other Recoveries" 	column 1
	print agr_cntothrec size 8 column 30
	print abs agr_totothrec size 20 autocomma precision 2 column 40
	if(agr_totothrec < 0)
    	print "Dr"
	if(agr_totothrec > 0)
	    print "Cr"
	print nonagr_cntothrec size 8 column 62
	print abs nonagr_totothrec size 20 autocomma precision 2 column 74
	if(nonagr_totothrec < 0)
	    print "Dr"
	if(nonagr_totothrec > 0)
   	 	print "Cr"
	nextline

	print "No. of accts closed by "       column 1
	nextline
	print " recovery during given period" column 1
	print agr_cntclsbyrecamt size 8      column 30
	print abs agr_totclsbyrecamt size 20 autocomma precision 2 column 40
	if(agr_totclsbyrecamt < 0)
    	print "Dr"
	if(agr_totclsbyrecamt > 0)
    	print "Cr"
	print nonagr_cntclsbyrecamt size 8 column 62
	print abs nonagr_totclsbyrecamt size 20 autocomma precision 2 column 74
	if(nonagr_totclsbyrecamt < 0)
    	print "Dr"
	if(nonagr_totclsbyrecamt > 0)
    	print "Cr"
	nextline

	print "Transfer back to regular " column 1
	nextline
	print "  advance "				  column 1
	print agr_cnttrnsbckamt size 8 column 30
	print abs agr_tottrnsbckamt size 20 autocomma precision 2 column 40
	if(agr_tottrnsbckamt < 0)
    	print "Dr"
	if(agr_tottrnsbckamt > 0)
    	print "Cr"
	print nonagr_cnttrnsbckamt size 8 column 62
	print abs nonagr_tottrnsbckamt size 20 autocomma precision 2 column 74
	if(nonagr_tottrnsbckamt < 0)
    	print "Dr"
	if(nonagr_tottrnsbckamt > 0)
    	print "Cr"
	nextline

	print "Total credit" 	column 1
	print totcnt3 size 8 	column 30
	print abs totsum3 size 20 autocomma precision 2 column 40
	if(totsum3 < 0)
    	print "Dr"
	if(totsum3 > 0)
    	print "Cr"
	print totcnt4 size 8 column 62
	print abs totsum4 size 20 autocomma precision 2 column 74
	if(totsum4 < 0)
    	print "Dr"
	if(totsum4 > 0)
    	print "Cr"
	nextline

	print "LPD Liability as on" column 1
#	print lpdcnt1 size 8 column 30
	print abs lpdsum1 size 20 autocomma precision 2 column 40
	if(lpdsum1 < 0)
    	print "Dr"
	if(lpdsum1 > 0)
    	print "Cr"
#	print lpdcnt2 size 8 column 62
	print abs lpdsum2 size 20 autocomma precision 2 column 74
	if(lpdsum2 < 0)
    	print "Dr"
	if(lpdsum2 > 0)
    	print "Cr"
	nextline

	print "Other Recoveries" 	column 1
	print agr_cntothrec size 8 column 30
	print abs agr_totothrec size 20 autocomma precision 2 column 40
	if(agr_totothrec < 0)
    	print "Dr"
	if(agr_totothrec > 0)
    	print "Cr"
	print nonagr_cntothrec size 8 column 62
	print abs nonagr_totothrec size 20 autocomma precision 2 column 74
	if(nonagr_totothrec < 0)
    	print "Dr"
	if(nonagr_totothrec > 0)
    	print "Cr"
	nextline

	print "Unapplied Interest credited" column 1
	nextline
	print "  directly to interest"		column 1
	nextline
	print "  collected account"			column 1
	print agr_cntunappint size 8 column 30
	print abs agr_totunappint size 20 autocomma precision 2 column 40
	if(agr_totunappint < 0)
    	print "Dr"
	if(agr_totunappint > 0)
    	print "Cr"
	print nonagr_cntunappint size 8 column 62
	print abs nonagr_totunappint size 20 autocomma precision 2 column 74
	if(nonagr_totunappint < 0)
   		print "Dr"
	if(nonagr_totunappint > 0)
    	print "Cr"
	nextline

	print "DICGC/ECGC claims adjusted" 	column 1
	set totclmadjamt = agr_totdicgclmadj + agr_totecgclmadj
	print agr_totclmadjcnt size 8 column 30
	print abs totclmadjamt size 20 autocomma precision 2 column 40
	if(totclmadjamt < 0)
    	print "Dr"
	if(totclmadjamt > 0)
    	print "Cr"
	set totclmadjamt = nonagr_totdicgclmadj + nonagr_totecgclmadj
	print nonagr_totclmadjcnt size 8 column 62
	print abs totclmadjamt size 20 autocomma precision 2 column 74 
	if(totclmadjamt < 0)
    	print "Dr"
	if(totclmadjamt > 0)
    	print "Cr"
	nextline

	set totcnt3 = agr_cntothrec + agr_cntunappint +	agr_cntdicgclmadj + agr_cntecgclmadj
	set totsum3 = agr_totothrec + agr_totunappint + agr_totdicgclmadj +	agr_totecgclmadj
	set totcnt4 = nonagr_cntothrec + nonagr_cntunappint + nonagr_cntdicgclmadj + nonagr_cntecgclmadj
	set totsum4 = nonagr_totothrec + nonagr_totunappint + nonagr_totdicgclmadj + nonagr_totecgclmadj

	print "Total Recovery" column 1
	print totcnt3 size 8 column 30
	print abs totsum3 size 20 autocomma precision 2 column 40
	if(totsum3 < 0)
    	print "Dr"
	if(totsum3 > 0)
    	print "Cr"
	print totcnt4 size 8 column 62
	print abs totsum4 size 20 autocomma precision 2 column 74
	if(totsum4 < 0)
    	print "Dr"
	if(totsum4 > 0)
    	print "Cr"
	separatorline
#==========================================================================
PROCEDURE detailRecord
#==========================================================================
set srl_num = srl_num + 1
#Closed accounts are considered only while calculating "No. of accts closed by recovery"
#Non past due accounts are considered only while calculating "No. of accts transferred to regular advance "
#DCREE is the suit status used for decreed cases. It has to be changed
#NDCRE is the suit status used for non-decreed cases
#AGRI is the sub sector code used for identifying agriculture related accounts
if ( AcctClsFlg != "Y" )
begin
if (pastDueFlg = "Y")
begin
	if(SuitStatus = "DCREE")
	begin
    	set deccnt = deccnt + 1
	    set decamt = decamt + AcctBal
	end
	else if(SuitStatus = "NDCRE")
	begin
    	set nondeccnt = nondeccnt + 1
    	set nondecamt = nondecamt + AcctBal
	end
	if(LegalActionWaived = "Y")
	begin
		set legcnt = legcnt + 1
    	set legamt = legamt + AcctBal
	end
	if((SuitStatus != "DCREE") AND (SuitStatus != "NDCRE") AND   LegalActionWaived != "Y")
	begin
    	set othcnt = othcnt + 1
    	set othamt = othamt + AcctBal
	end 

#	 Section 2 PART 1
	if(SubSectorCode = "AGRI" and ClaimStlAmt != 0)
	begin
    	set agricnt = agricnt + 1
    	set agriamt = agriamt + ClaimStlAmt
	end
	else if(SubSectorCode = "SSI" and ClaimStlAmt != 0)
	begin
    	set ssicnt = ssicnt + 1
    	set ssiamt = ssiamt + ClaimStlAmt
	end
	else if ( ClaimStlAmt != 0)
	begin
    	set othercnt = othercnt + 1
    	set otheramt = otheramt + ClaimStlAmt
	end

# 	Section 3 Part 1
	set stmpamt = stmpamt + StampDuty
	set couramt = couramt + CourtFee
	set advocamt = advocamt + AdvocateFee
	set miscamt = miscamt + Miscellaneous

#  Part 2
	if(stringToDate PastDueXferDate <= stringToDate FromDate)
	begin
		if (SubSectorCode = "AGRI")
		begin
    		set agr_cntopnbal = agr_cntopnbal + 1
    		set agr_totopnbal = agr_totopnbal + BalOnStartDate
#    		set agr_cntnewtrn = agr_cntnewtrn + 1
#    		set agr_totnewtrn = agr_totnewtrn + sumCreditAmt
#    		set agr_totnewtrn = agr_totnewtrn - sumDebitAmt
		end
		else
    	begin
			set nonagr_cntopnbal = nonagr_cntopnbal + 1
    		set nonagr_totopnbal = nonagr_totopnbal + BalOnStartDate
#    		set nonagr_cntnewtrn = nonagr_cntnewtrn + 1
#    		set nonagr_totnewtrn = nonagr_totnewtrn + sumCreditAmt
#    		set nonagr_totnewtrn = nonagr_totnewtrn - sumDebitAmt
		end	
	end
	else if (stringToDate PastDueXferDate >= stringToDate FromDate and 
			stringToDate PastDueXferDate <= stringToDate ToDate)
	begin
		if (SubSectorCode = "AGRI")
    	begin
    		set agr_cntnewtrn = agr_cntnewtrn + 1
    		set agr_totnewtrn = agr_totnewtrn + BalOnEndDate
		end
		else
		begin
    		set nonagr_cntnewtrn = nonagr_cntnewtrn + 1
    		set nonagr_totnewtrn = nonagr_totnewtrn + BalOnEndDate
		end
	end

	if(OtherExpenses != 0)
	begin
		if (SubSectorCode = "AGRI")
    	begin
    		set agr_cntothexp = agr_cntothexp + 1
    		set agr_totothexp = agr_totothexp + OtherExpenses
		end
		else
    	begin
    		set nonagr_cntothexp = nonagr_cntothexp + 1
    		set nonagr_totothexp = nonagr_totothexp + OtherExpenses
		end
	end

	if((modeOfStlmt = "WRITO") and (sumCreditAmt != 0))
	begin
		if (SubSectorCode = "AGRI")
    	begin
    		set agr_cntwrtoffamt = agr_cntwrtoffamt + 1
    		set agr_totwrtoffamt = agr_totwrtoffamt + sumCreditAmt
		end
		else
		begin 
    		set nonagr_cntwrtoffamt = nonagr_cntwrtoffamt + 1
    		set nonagr_totwrtoffamt = nonagr_totwrtoffamt + sumCreditAmt
		end
	end

	if(DicgcClaimsAdjusted != 0)
	begin
		if (SubSectorCode = "AGRI")
   	 	begin
    		set agr_cntdicgclmadj = agr_cntdicgclmadj + 1
    		set agr_totdicgclmadj = agr_totdicgclmadj + DicgcClaimsAdjusted
    	end
		else
		begin
    		set nonagr_cntdicgclmadj = nonagr_cntdicgclmadj + 1
    		set nonagr_totdicgclmadj = nonagr_totdicgclmadj + DicgcClaimsAdjusted
		end
	end

	if(EcgcClaimsAdjusted != 0)
	begin
		if (SubSectorCode = "AGRI")
   	 	begin
    		set agr_cntecgclmadj = agr_cntecgclmadj + 1
    		set agr_totecgclmadj = agr_totecgclmadj + EcgcClaimsAdjusted
    	end
		else
		begin
    		set nonagr_cntecgclmadj = nonagr_cntecgclmadj + 1
    		set nonagr_totecgclmadj = nonagr_totecgclmadj + EcgcClaimsAdjusted
		end
	end
	if (DicgcClaimsAdjusted != 0 or EcgcClaimsAdjusted != 0)
	begin
 		if (SubSectorCode = "AGRI")
			set agr_totclmadjcnt = agr_totclmadjcnt + 1
		else
			set nonagr_totclmadjcnt = nonagr_totclmadjcnt + 1
	end			
		
	if(OtherRecoveries != 0)
	begin
		if (SubSectorCode = "AGRI")
    	begin   
 			set agr_cntothrec = agr_cntothrec + 1
    		set agr_totothrec = agr_totothrec + OtherRecoveries
    	end
		else
		begin   
 			set nonagr_cntothrec = nonagr_cntothrec + 1
   		 	set nonagr_totothrec = nonagr_totothrec + OtherRecoveries
		end
	end

	if(UnappliedInterest != 0)
	begin
		if (SubSectorCode = "AGRI")
    	begin
    		set agr_cntunappint = agr_cntunappint + 1
    		set agr_totunappint = agr_totunappint + UnappliedInterest
    	end
		else
		begin
    		set nonagr_cntunappint = nonagr_cntunappint + 1
   		 	set nonagr_totunappint = nonagr_totunappint + UnappliedInterest
		end
	end
	if(SuitStatus = "DCREE")
	begin
    	set sdecamt = sdecamt + sumCreditAmt + DicgcClaimsAdjusted + OtherRecoveries
	end
	else if(SuitStatus = "NDCRE")
	begin
    	set snondecamt = snondecamt + sumCreditAmt + DicgcClaimsAdjusted + OtherRecoveries
	end
end
else
begin
	if((modeOfStlmt = "XFERB") and (sumCreditAmt != 0) and (stringToDate PastDueReXferDate >= stringToDate FromDate) and (stringToDate PastDueReXferDate <= stringToDate ToDate))
	begin
		if (SubSectorCode = "AGRI")
    	begin
    		set agr_cnttrnsbckamt = agr_cnttrnsbckamt + 1
    		set agr_tottrnsbckamt = agr_tottrnsbckamt + sumCreditAmt
   	 	end
		else
		begin
   		 	set nonagr_cnttrnsbckamt = nonagr_cnttrnsbckamt + 1
   		 	set nonagr_tottrnsbckamt = nonagr_tottrnsbckamt + sumCreditAmt
		end
	end
end
end
else
begin
	if((modeOfStlmt = "RECOV") and (sumCreditAmt != 0) and (stringToDate ActClsDate <= stringToDate ToDate) and (stringToDate AcctClsDate >= stringToDate FromDate))
	begin
		if (SubSectorCode = "AGRI")
    	begin
    		set agr_cntclsbyrecamt = agr_cntclsbyrecamt + 1
    		set agr_totclsbyrecamt = agr_totclsbyrecamt + sumCreditAmt
		end
		else
   		begin
   		 	set nonagr_cntclsbyrecamt = nonagr_cntclsbyrecamt + 1
   		 	set nonagr_totclsbyrecamt = nonagr_totclsbyrecamt + sumCreditAmt
		end
	end
end	
if (SuitStatus != "DCREE" and SuitStatus!= "NDCRE" and pastDueFlg = "Y")
begin
   	set sothamt = sothamt + sumCreditAmt + DicgcClaimsAdjusted + OtherRecoveries
end

