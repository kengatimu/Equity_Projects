########################################################################
# Report Name   :   Report on details of cases 
# Template Name :  	DcrdEPFiledDmdNtcServedRpt.mrt
# Description   :   To print the cases handled by the advocates.
#   
#	Modification log
#   ----------------
#   Srl.No.     Date        Author            Version
#   ------   ----------     ------------    --------------
#       1       29/11/04    Jaya Lakhsmi        1.0
#
#########################################################################
RECORDLAYOUT
$$$include DcrdEPFiledDmdNtcServedRpt.mri 
#

LOCALVARIABLES
srl_num numberType
local   numberType
localdate       numberType
localyears      numberType
tmp     numberType
#
GROUPANDSORT
crncy_code
suit_status
sol_id
cust_id

#IGNORERECORD
#if (pastDueFlg = "N")

PAGEFORMAT
linesperpage 	60
columnsperline 	300
pageheaderlines 12 
topMargin  		2
bottomMargin 	2
#
REPOSITORY bankRepos.rip readonly  
localYearsToAdd        stringType
#
REPOSITORY argv4
PAGE_NUMBER              numberType
crit_reportTo            stringType
crit_solSetId            stringType
crit_acctNum             stringType
crit_custId              stringType
crit_asOnDate            stringType
crit_fromDate      		 stringType
crit_toDate        		 stringType
crit_suitStatus          stringType
crit_courtOrTribunal     stringType
crit_rptCrncyCode        stringType
#
ONSTARTOFREPORT
#
set localyears = strToNum localYearsToAdd
set pageNumber = 1
set srl_num = 0 
set local = 1 
nextline
nextline
nextline
print "REPORT ON DETAILS OF CASES DECREED / EP FILED / DEMAND NOTICES SERVED" column 20
nextline
nextline
execute printCriteria
#nextpage

PAGEHEADER
  print "Page No."    column 80
  print pageNumber size 5 precision 0
  nextline
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "" column 80
  print " "
  set localdate = stringToDate  today
  set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "HH24:NN:SS"
  nextline
  nextline 
  print "Report on Details of cases decreed / EP filed / Demand Notices served" column 25
  nextline
  print "---------------------------------------------------------------------" column 25
  nextline
  execute pageheader
#
BEFOREBREAKOF crncy_code
	if(demand_notice_served_on = "z") 
		set local = 1
	else 
		set local = 0
	set srl_num = 0	
	nextpage
#	execute pageheader
#
#========================================================================
ONEVERYRECORD
#========================================================================
set tmp = local
if (demand_notice_served_on = "z")
	set local = 1
else
	set local = 0
if (tmp != local )
begin
	nextpage
#	execute pageheader
	set srl_num = 0
end
	if(local = 1)
        execute suitDetail
    else
        execute decreeDetail
#==========================================================================
ONENDOFREPORT
#==========================================================================
    if(srl_num = 0)
    begin
        nextline
        nextline
        nextline
        nextline
        print "  -----  NO RECORDS SELECTED FOR PRINTING  ---- " column 24
        nextline
    end
    nextline
	nextline
    nextline
    nextline
	print "*** " column 24
	print pageNumber size 3 column 30 precision 0
	print " PAGE(S) PRINTED. ****END OF REPORT****" size 40 column 34
#
    set PAGE_NUMBER = pagenumber
#
#
#============================================================================
PROCEDURE pageheader
#=============================================================================
begin 
  	print "Currency   "          column   3
    print crncy_code             column   12
    nextline
    nextline
    separatorline
	print " Sl.no"                column   1
    print " CIF ID "              column   8
    print " Name of the party"    column  43
	print " Liability"            column 123
	if(local = 1)
		execute suitHeader
	else
		execute decreeHeader
end 
#============================================================================
PROCEDURE suitDetail
#============================================================================
	set srl_num = srl_num + 1
    nextline
    print srl_num             column   1
    print cust_id             column   8
    print cust_name           column  43
    print abs liability  column 123 autocomma precision 2 size 17
	if (liability < 0)
		print "Dr"
	if (liability > 0)
		print "Cr"
    print legal_counsel_name  column 143
    print suitNum            column  203
    print suit_status         column 263
    set localdate = stringToDate  suit_status_date
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 283

#============================================================================
PROCEDURE decreeDetail
#==========================================================================
	set srl_num = srl_num + 1
    nextline
    print srl_num             		column   1
    print cust_id             		column   8
    print cust_name           		column  43
    print abs liability  column 123 autocomma precision 2 size 17
	if (liability < 0)
		print "Dr"
	if (liability > 0)
		print "Cr"
    print final_decree_amount 		column  143 autocomma precision 2 size 17 
    print demand_notice_served_on  	column  163
#============================================================================
PROCEDURE suitHeader
#=============================================================================
	print " Advocate" 			column 120
	print " Suit No."			column 180
	print " Status of suit"  	column 240
	print " Status Date"		column 260
	nextline
	separatorline
	nextline
#============================================================================
PROCEDURE decreeHeader
#=============================================================================
    print " Decree/EP amount"        column 120 
    print " Date of demand notice"   column 140
    nextline
    separatorline
    nextline

#============================================================================
PROCEDURE printCriteria
#============================================================================
    nextLine
    nextLine
    separatorLine
    nextline
    nextline
    print   "SELECTION CRITERIA"              column 40
    nextline
    print   "-------------------"             column 40
    nextline
    nextline
    print   "Report To                : "     column 30
    print   crit_reportTo
    nextline
    print   "Set Id                   : "     column 30
    print   crit_solSetId
    nextLine
    print   "Account Num              : "     column 30
    print   crit_acctNum
    nextline
    print   "CIF ID                   : "     column 30
    print   crit_custId
    nextline
    print   "As on date               : "     column 30
    set localdate = stringToDate  crit_asOnDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "From Date                : "     column 30
    set localdate = stringToDate  crit_fromDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextLine
    print   "To Date                  : "     column 30
    set localdate = stringToDate  crit_toDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat ""
    nextline
    print   "Suit Status              : "     column 30
    print   crit_suitStatus
	nextline
    print   "Judicial Authority       : "     column 30
    print   crit_courtOrTribunal
    nextline
    print   "Report Currency Code     : "     column 30
    print   crit_rptCrncyCode
	nextline
    nextline
    separatorLine
#============================ End Of File ================================

