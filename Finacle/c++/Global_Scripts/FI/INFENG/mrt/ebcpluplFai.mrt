####################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
fieldData1					stringType
fieldData2					stringType
fieldData3					stringType
fieldData4					stringType
fieldData5					stringType
fieldData6					stringType
fieldData7					stringType
fieldData8					stringType
fieldData9					stringType
fieldData10					stringType
fieldData11					stringType
fieldData12					stringType
fieldData13					stringType
fieldData14					stringType

#####################################################################
LOCALVARIABLES
#####################################################################
slno 						numberType           
total_pages					stringType
totalpages					numberType
reportCnt					numberType

#####################################################################
GroupAndSort
#####################################################################

#####################################################################
MASSAGERECORD
#####################################################################

#####################################################################  
REPOSITORY bankRepos.rip
####################################################################
bankName					stringType			
branchName					stringType	
BODDate						stringType		
userId						stringType		

#####################################################################  
#REPOSITORY argv4
###################################################################

######################################################################
PAGEFORMAT 
######################################################################
linesperpage					60	
columnsperline  			        225	
pageheaderlines					14
leftMargin					03
rightMargin					03
topMargin      					02 
bottomMargin					02	

######################################################################
ONSTARTOFREPORT
######################################################################
set slno=0
set reportCnt=0

execute RptHeader
execute pageHeader

######################################################################
PAGEHEADER
#####################################################################
execute RptHeader   
execute pageHeader

######################################################################
PAGEFOOTER
#####################################################################
separatorline

#####################################################################
ONEVERYRECORD
#####################################################################
set slno=slno+1
set reportCnt=1
execute printrecords

#####################################################################  
ONENDOFREPORT
#####################################################################
set total_pages=numtostr PageNumber
set totalpages=prntagVal "pages" total_pages
if (reportCnt!=0)
begin 
separatorline
end
if (reportCnt=0)
	begin
		print "No Data Found"			column 01       size 95        center
		nextline
	end

#####################################################################
PROCEDURE RptHeader
#####################################################################
begin 
	nextline
	print bankName					column 01	size 95		center
	nextline
	nextline
	print "UserID :"				column 74  
	print userId
	nextline
	print "Page   :"				column 74 		
	print Pagenumber
	print "/"
	print "<<pages>>"
	nextline
	nextline
	print "Failure Upload Report of CPLUPL menu" 	column 	1 	size 95 	center
	nextline

end
#####################################################################
PROCEDURE pageHeader
#####################################################################
begin
        nextline
        separatorline
        print "| "                                      column 01       size 02
        print "PF Number"                               column 04       size 17
        print "| "                                      column 23       size 02
        print "Beneficiary Name"                        column 26       size 80
        print "| "                                      column 108      size 02
        print "Error Message"                           column 112      size 100 
        print " |"                                      column 214      size 02
        separatorline
 end

#####################################################################
PROCEDURE printrecords
#####################################################################
begin
        print "| "                                      column 01       size 02
        print fieldData1                                column 04       size 17
        print "| "                                      column 23       size 02
        print fieldData4                        	column 26       size 80
        print "| "                                      column 108      size 02
        print fieldData14                               column 112      size 100
        print " |"                                      column 214      size 02
end

