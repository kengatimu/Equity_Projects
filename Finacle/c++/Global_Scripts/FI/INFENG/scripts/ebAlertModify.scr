<--START

TRACE ON
callscriptifexist("ebRepClass.scr")

lv_i = " insert into custom.cust_alert_mod_tbl ( "
lv_i = lv_i + " bank_id,cust_id,del_flg,entity_cre_flg,register_date,foracid,charge_foracid, "
lv_i = lv_i + " dr_alert_flg,dr_min_amount,cr_alert_flg,cr_min_amount,mobile_no,email_address, "
lv_i = lv_i + " activation_status,rcre_time,rcre_user,lchg_time,lchg_user)  "
lv_i = lv_i + " (select bank_id,cust_id,del_flg,'N',register_date,foracid, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " upper('"+EBSRV.GLBDATA.email+"'), "
lv_i = lv_i + " ?SVAR, "
lv_i = lv_i + " rcre_time,rcre_user,sysdate, "
lv_i = lv_i + " ?SVAR "
lv_i = lv_i + " from custom.cust_alerts_tbl "
lv_i = lv_i + " where cust_id=?SVAR "
lv_i = lv_i + " and foracid = ?SVAR "
lv_i = lv_i + " and bank_id = ?SVAR "
lv_i = lv_i + " and del_flg = 'N' "
lv_i = lv_i + " and entity_cre_flg = 'Y' ) "
print(lv_i)

BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.chrgAcc +"|"+ EBSRV.GLBDATA.drAlerts +"|"+ EBSRV.GLBDATA.minDrAmt +"|"+ EBSRV.GLBDATA.crAlerts
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ EBSRV.GLBDATA.minCrAmt +"|"+ EBSRV.GLBDATA.phNum +"|"+ EBSRV.GLBDATA.activateFlag 
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId +"|"+  EBSRV.GLBDATA.custId +"|"+ EBSRV.GLBDATA.accNo + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)

lv_r = urhk_dbSQLWithBind(lv_i)
print(lv_r)
IF(lv_r == 0) THEN
#{
	EBSRV.GLBDATA.resMsg = "Customer Details Modified Successfully Please Verify"
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	EBSRV.GLBDATA.errMsg = "FAILED!!"
	GOTO ENDOFSCRIPT
#}
ENDIF

ENDOFSCRIPT:

        EXITSCRIPT

TRACE OFF

END-->



