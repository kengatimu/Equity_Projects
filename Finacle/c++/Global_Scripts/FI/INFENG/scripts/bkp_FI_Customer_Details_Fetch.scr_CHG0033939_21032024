<--START
TRACE ON

  #---------------------------------------------------------
        # Create the necessary repos and classes
        #---------------------------------------------------------

        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

        #---------------------------------------------------------
        #       Bancs Repository Printing
        #---------------------------------------------------------
        sv_x = urhk_B2k_PrintRepos("BANCS")
        PRINT(sv_x)

        IF(FIELDEXISTS(BANCS.INPUT.cifId)==0) THEN
        #{
                CUST.DATA.cifId = ""
        #}
        ELSE
        #{
                CUST.DATA.cifId = BANCS.INPUT.cifId
                PRINT(CUST.DATA.cifId)
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.bankId)==0) THEN
        #{
                CUST.DATA.bankId = ""
        #}
        ELSE
        #{
                CUST.DATA.bankId = BANCS.INPUT.bankId
                PRINT(CUST.DATA.bankId)
        #}
        ENDIF
	

	CUST.DATA.succFail	="F"
	CUST.DATA.count 	= "0"

	IF(CUST.DATA.cifId == "")THEN
	#{
		CUST.DATA.tmpErrMessage = "Cif must be entered"
		sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
		sv_e = urhk_SetOrbOut("Failed| "+CUST.DATA.tmpErrMessage)
		EXITSCRIPT
	#}
	ENDIF

	IF(CUST.DATA.bankId == "")THEN
        #{
		CUST.DATA.tmpErrMessage = "BankId must be entered" 
		sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
		sv_e = urhk_SetOrbOut("Failed| "+CUST.DATA.tmpErrMessage)
		EXITSCRIPT
        #}
        ENDIF	

	IF(CUST.DATA.cifId != "")THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.cifId + "|" + CUST.DATA.bankId
		print(BANCS.INPARAM.BINDVARS)

		sv_a = "count|select count(1) from crmuser.accounts where orgkey= ?SVAR and bank_id=?SVAR"
		print(sv_a)

                sv_d = urhk_dbSelectWithBind(sv_a)
                print(sv_d)

                IF(sv_d != 0)THEN
                #{
			CUST.DATA.tmpErrMessage = "Inavalid CIF"
			sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
			sv_e = urhk_SetOrbOut("Failed| "+CUST.DATA.tmpErrMessage)
			EXITSCRIPT
		#}
                ELSE
		#{
			CUST.DATA.count = BANCS.OUTPARAM.count
			print(CUST.DATA.count)

                #}
                ENDIF

		IF(CUST.DATA.count == "0")THEN
		#{
			CUST.DATA.tmpErrMessage = "Inavalid CIF"
                        sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
                        sv_e = urhk_SetOrbOut("Failed| "+CUST.DATA.tmpErrMessage)
                        EXITSCRIPT
		#}
		ELSE
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.cifId+ "|" +CUST.DATA.bankId+ "|" +CUST.DATA.bankId
			print(BANCS.INPARAM.BINDVARS)

			sv_a = "foracid,acctName,acctShortName,acctClsFlg|"
			sv_a = sv_a +" select foracid,acct_name,acct_short_name,acct_cls_flg "
			sv_a = sv_a +"  from tbaadm.gam"
			sv_a = sv_a +" where acid in (select acid from tbaadm.aas where NMA_KEY_ID=?SVAR and bank_id=?SVAR) and bank_id=?SVAR and acct_cls_flg='N'"
			print(sv_a)

			sv_d = urhk_dbCursorOpenWithBind(sv_a)
			print(sv_d)

			IF(sv_d!=0) THEN
			#{
				sv_e = urhk_SetOrbOut("SuccessorFailure|Sucess")
				CUST.DATA.message = "No record found"
				print(CUST.DATA.message)
				sv_u = urhk_SetOrbOut("Failure| "+CUST.DATA.message)
				print(sv_u)		

				sv_u = urhk_dbCursorClose(sv_a)
				print(sv_u)
			#}
			ELSE
			#{
				CUST.DATA.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				print(CUST.DATA.DB_CURSOR_NUMBER)

				sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
				print(sv_c)

				IF(sv_c != "0")THEN
				#{
					sv_e = urhk_SetOrbOut("SuccessorFailure|Sucess")
					CUST.DATA.message = "No record found"
					print(CUST.DATA.message)
					sv_u = urhk_SetOrbOut("Failure| "+CUST.DATA.message)
					print(sv_u) 
				#}
				ENDIF

				while(sv_c ==0)
				#{
					CUST.DATA.foracid = BANCS.OUTPARAM.foracid
					print(CUST.DATA.foracid)

					CUST.DATA.acctName = BANCS.OUTPARAM.acctName
					print(CUST.DATA.acctName)

					CUST.DATA.acctShortName = BANCS.OUTPARAM.acctShortName
					print(CUST.DATA.acctShortName)
					
					CUST.DATA.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
					print(CUST.DATA.acctClsFlg)

					CUST.DATA.count = CINT(CUST.DATA.count)+ 1
					print(CUST.DATA.count)

					IF(CUST.DATA.acctClsFlg == "N")THEN
					#{
						sv_c = urhk_SetOrbOut("CustomerDetails.<rec_"+CUST.DATA.count+">.Foracid"+"| "+CUST.DATA.foracid)
						print(sv_c)
						sv_c = urhk_SetOrbOut("CustomerDetails.<rec_"+CUST.DATA.count+">.AcctName"+"| "+CUST.DATA.acctName)
						print(sv_c)
						sv_c = urhk_SetOrbOut("CustomerDetails.<rec_"+CUST.DATA.count+">.AcctShortName"+"| "+CUST.DATA.acctShortName)
						print(sv_c)
					#}
					ENDIF

					sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
					print(sv_c)

				#}
				do
				sv_c = urhk_dbCursorClose(CUST.DATA.DB_CURSOR_NUMBER)
				print(sv_c)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
EXITSCRIPT

