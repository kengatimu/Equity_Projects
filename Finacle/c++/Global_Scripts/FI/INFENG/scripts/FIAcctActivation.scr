#------------------------------------------------------------------------------
#Initialisig required repository variables
#------------------------------------------------------------------------------
EQSRV.GLBDATA.errMsg = ""
#---------------------------------------------------------------------------------
# Validation for Account ID
#---------------------------------------------------------------------------------
#------------------------------------------------------------------------------
#Finding count of records that need to be processed
#------------------------------------------------------------------------------
#BANCS.INPUT.AcctId ="1500171145429"
EQSRV.GLBDATA.errormessage=""
EQSRV.GLBDATA.AcctId =BANCS.INPUT.AcctId
print(EQSRV.GLBDATA.AcctId)
print(BANCS.STDIN.contextBankId)
sv_s="AcctId|"
sv_s = sv_s + " SELECT count(1) "
sv_s = sv_s + " FROM tbaadm.gam "
sv_s = sv_s + " WHERE ENTITY_CRE_FLG='Y' "
sv_s = sv_s + " AND ACCT_CLS_FLG='N' "
sv_s = sv_s + " AND bank_id = ?SVAR"
sv_s = sv_s + " AND FORACID = ?SVAR"
sv_s = sv_s + " AND GAM.DEL_FLG != 'Y' "
print(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.AcctId
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF(sv_d == 0)THEN
	PRINT(BANCS.INPUT.AcctId)
	EQSRV.GLBDATA.AcctId  = BANCS.INPUT.AcctId
	PRINT(EQSRV.GLBDATA.AcctId)
	sv_s="acid,schmtype,acctcrncycode,schmcode,sweeps,solid|"
	sv_s = sv_s + " SELECT acid,schm_type,acct_crncy_code,schm_code,allow_sweeps,sol_id "
	sv_s = sv_s + " FROM tbaadm.gam "
	sv_s = sv_s + " WHERE foracid= ?SVAR"
	sv_s = sv_s + " AND bank_id= ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.AcctId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d != 0) THEN
		sv_o=urhk_SetOrbOut("ErrorCode|Invalid Account")
		EXITSCRIPT
	ELSE
		EQSRV.GLBDATA.acid	= BANCS.OUTPARAM.acid
		PRINT(EQSRV.GLBDATA.acid)
		EQSRV.GLBDATA.schmtype	= BANCS.OUTPARAM.schmtype
		PRINT(EQSRV.GLBDATA.schmtype)
		EQSRV.GLBDATA.acctcrncycode	= BANCS.OUTPARAM.acctcrncycode
		PRINT(EQSRV.GLBDATA.acctcrncycode)
		EQSRV.GLBDATA.schmcode	= BANCS.OUTPARAM.schmcode
		PRINT(EQSRV.GLBDATA.schmcode)
		EQSRV.GLBDATA.sweeps	= BANCS.OUTPARAM.sweeps
		PRINT(EQSRV.GLBDATA.sweeps)
		EQSRV.GLBDATA.solid= BANCS.OUTPARAM.solid
		PRINT(EQSRV.GLBDATA.solid)
		IF (EQSRV.GLBDATA.sweeps == "") THEN
		#{
			EQSRV.GLBDATA.sweeps = "N"
		#}
		ENDIF
			
		IF(EQSRV.GLBDATA.solid != BANCS.STDIN.mySolId)THEN
		#{
			sv_u = urhk_SetUrhkInp("sol.solId|"+EQSRV.GLBDATA.solid)
			print(sv_u)
			sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			print(sv_u)
		#}
		ENDIF
	#}
	ENDIF
	IF((EQSRV.GLBDATA.schmcode == "SB199") OR (EQSRV.GLBDATA.schmcode == "CA299"))THEN
	#{
		print(EQSRV.GLBDATA.schmcode)
		call("onlinetransfer.scr")
		IF (FIELDEXISTS(EQSRV.GLBDATA.errormessage) == 1) THEN
			IF (EQSRV.GLBDATA.errormessage!="") THEN
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Failure")
				sv_o=urhk_SetOrbOut("RESULT_MSG|"+EQSRV.GLBDATA.errormessage+"'")
				GOTO ENDOFSCRIPT
			ENDIF
		ENDIF
	#}
	ENDIF

	#--------------------------------------------------------------------------------------------------------------
	# Inputs for Account Modify services
	# urhk_SetUrhkInp is used to set inputs
	#--------------------------------------------------------------------------------------------------------------
	
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + EQSRV.GLBDATA.AcctId)
	PRINT(sv_u)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + EQSRV.GLBDATA.acid)
	PRINT(sv_u)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + EQSRV.GLBDATA.schmtype)
	PRINT(sv_u)
	sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + EQSRV.GLBDATA.schmcode)
	PRINT(sv_u)
	#sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y")
	#PRINT(sv_u)

	IF(EQSRV.GLBDATA.schmtype == "SBA")THEN
        #{
                sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y")
                PRINT(sv_u)
        #}
        ELSE
        #{
                sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForModify|retain_all_output = Y")
                PRINT(sv_u)
        #}
        ENDIF
	
	IF (sv_u == 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + EQSRV.GLBDATA.AcctId)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + EQSRV.GLBDATA.acid)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + EQSRV.GLBDATA.schmtype)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + EQSRV.GLBDATA.schmcode)
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|"+EQSRV.GLBDATA.sweeps)
		PRINT(sv_u)
		#sv_u = urhk_SetUrhkInp("operAcctSchmDtls.acctStat.code|A")
		#PRINT(sv_u)
		sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
		PRINT(sv_u)
		sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
		PRINT(sv_u)
		sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
		PRINT(sv_u)
		#sv_u =urhk_SetUrhkInp("operAcctSchmDtls.acctSchemeEntered|1")
		#PRINT(sv_u)


		IF(EQSRV.GLBDATA.schmtype == "SBA")THEN
                #{

                        sv_u = urhk_SetUrhkInp("operAcctSchmDtls.acctStat.code|A")
                        PRINT(sv_u)
                        sv_u =urhk_SetUrhkInp("operAcctSchmDtls.acctSchemeEntered|1")
                        PRINT(sv_u)
                #}
                ELSE
                #{
                        sv_u = urhk_SetUrhkInp("schmDtls.acctStat.code|A")
                        PRINT(sv_u)
                        sv_u =urhk_SetUrhkInp("schmDtls.acctSchemeEntered|1")
                        PRINT(sv_u)
                #}
                ENDIF

		#sv_u = urhk_ExecSrv("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
		#PRINT(sv_u)

		IF(EQSRV.GLBDATA.schmtype == "SBA")THEN
                #{
                        sv_u = urhk_ExecSrv("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
                        PRINT(sv_u)
                #}
                ELSE
                #{
                        sv_u = urhk_ExecSrv("SRV_ModifyCAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
                        PRINT(sv_u)
                #}
                ENDIF

		#----------------------------------------------------------------------------------------------------
		# SRV Error check
		#----------------------------------------------------------------------------------------------------
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
				#}
			ELSE
				#{
				sv_v = 0
			#}
			ENDIF
			IF (sv_v > 0) THEN
			#{
				sv_u = system("echo 'Error for Acct:"+EQSRV.GLBDATA.AcctId+" ' >>acctivated.log")
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					print(sv_f)
					IF (FIELDEXISTS(("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)) == 1) THEN
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						IF (FIELDEXISTS(("BANCS").("OUTPARAM").("Tag_"+sv_f)) == 1) THEN
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = "Account Cannot Activated, Finacle Error : " + sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>acctivated.log")
							sv_z = "SuccessOrFailure|Failure"
							sv_u = urhk_SetOrbOut(sv_z)
							sv_o=urhk_SetOrbOut("MSG|"+sv_e+"'")
							print(sv_u)
						ELSE
							sv_i = sv_i + 1
							print(sv_i)
						ENDIF
					ELSE
						sv_i = sv_i + 1
						print(sv_i)
					ENDIF
				#}
				DO
			#}
			ENDIF
		ELSE
			#-------------------------------------------
			# Creating Transaction for chage collection
			#-------------------------------------------

			IF (REPEXISTS("CUST") == 0) THEN
			#{
				CREATEREP("CUST")
			#}
			ENDIF
		
			IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
			#{
				CREATECLASS("CUST","GCHRG",5)
			#}
			ENDIF

			CUST.GCHRG.tranType = "T"
			print(CUST.GCHRG.tranType)
			CUST.GCHRG.tranSubType = "BI"
			CUST.GCHRG.drAcctId = EQSRV.GLBDATA.AcctId
			CUST.GCHRG.acctCrncyCode = EQSRV.GLBDATA.acctcrncycode 
			CUST.GCHRG.eventId = "DORACT" 
			CUST.GCHRG.chrgAmt =  "|" + EQSRV.GLBDATA.acctcrncycode 

			#============================================================================*
			# Updating the table SVSUSER.SIGNMAINTENANCE column to  'N'
			#============================================================================*
			sv_s =""
			sv_s = sv_s + " UPDATE SVSUSER.SIGNMAINTENANCE"
			sv_s = sv_s + " SET SIGNMAINTENANCE.active ='Y'"
			sv_s = sv_s + " WHERE SIGNMAINTENANCE.signid IN "
			sv_s = sv_s + 								" (SELECT SIGNOTHERINFO.signid" 
			sv_s = sv_s +								" FROM SVSUSER.SIGNOTHERINFO"
			sv_s = sv_s +								" WHERE SIGNOTHERINFO.acctid=?SVAR"
			sv_s = sv_s +								" AND   SIGNOTHERINFO.entityid=?SVAR)"
			PRINT(sv_s)
			#BANCS.INPARAM.BINDVARS	= ""
			BANCS.INPARAM.BINDVARS	= EQSRV.GLBDATA.AcctId + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d==0)THEN
			#{
				#sv_d = urhk_dbSQLWithBind("COMMIT")
				#PRINT(sv_d)
			#}
			ENDIF 
		  
			#IF ((BANCS.STDIN.contextBankId != "50") AND (BANCS.STDIN.contextBankId != "55")) THEN
			IF ((BANCS.STDIN.contextBankId != "50") OR (BANCS.STDIN.contextBankId != "55")) THEN
		
				CUST.GCHRG.successOrFailure = "S" 
			ENDIF

			#IF ((BANCS.STDIN.contextBankId == "50") AND (BANCS.STDIN.contextBankId == "55")) THEN
			IF ((BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55")) THEN
		
				CUST.GCHRG.successOrFailure = "S"
			ENDIF

			IF((CUST.GCHRG.successOrFailure == "S" ) AND ((BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55"))) THEN

				sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
				#sv_u = urhk_SetOrbOut(sv_z)
				#sv_g = "RESULT_MSG|Account Activated and Charges not Collected"
				sv_o=urhk_SetOrbOut("RESULT_MSG|Account Activated and Charges not Collected")
				#sv_z = urhk_SetOrbOut(sv_g)
				GOTO ENDOFSCRIPT
			ENDIF
			IF( CUST.GCHRG.successOrFailure == "S" ) THEN

				sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
				sv_o=urhk_SetOrbOut("RESULT_MSG|Account Activated successfully ")
				GOTO ENDOFSCRIPT
			#}
			ELSE
			#{
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
				sv_o=urhk_SetOrbOut("RESULT_MSG|Account Activated successfully ")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	ELSE
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_u = system("echo 'Error for Acct:"+EQSRV.GLBDATA.AcctId+" ' >>acctivated.log")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				print(sv_f)
				IF (FIELDEXISTS(("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)) == 1) THEN
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					IF (FIELDEXISTS(("BANCS").("OUTPARAM").("Tag_"+sv_f)) == 1) THEN
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = "Account Cannot Activated, Finacle Error : " +sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>acctivated.log")
						sv_z = "SuccessOrFailure|Failure"
						sv_u = urhk_SetOrbOut(sv_z)
						sv_o=urhk_SetOrbOut("MSG|"+sv_e+"'")
						print(sv_u)
					ELSE
						sv_i = sv_i + 1
						print(sv_i)
					ENDIF
				ELSE
					sv_i = sv_i + 1
					print(sv_i)
				ENDIF
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
#}
ENDIF
ENDOFSCRIPT:
IF (BANCS.STDIN.userId=="FIVUSR54") THEN
	EQSRV.GLBDATA.repmeSolId="000"
	print(EQSRV.GLBDATA.repmeSolId)
	Sv_a = urhk_SetUrhkInp("sol.solId|"+EQSRV.GLBDATA.repmeSolId)
	print(Sv_a)
	Sv_a = urhk_ExecSrv("SRV_ModifyContextSol|same_user_verify = Y|retain_all_output = Y")
	print(Sv_a)
	IF (Sv_a == 0) THEN
		print(BANCS.STDIN.mySolId)
	ENDIF
ENDIF
EXITSCRIPT
