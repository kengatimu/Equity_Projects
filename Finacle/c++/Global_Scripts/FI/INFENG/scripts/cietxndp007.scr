		CUST.INTERFACE.tranParticularsCr = "RSC Inter-Country charge"
		CUST.INTERFACE.tranParticularsDr = "RSC Inter-Country charge"

		CUST.INTERFACE.tranRmksCr = CUST.CIETXN.refCrncy + " / " + CUST.CIETXN.refAmt + " @ " + CUST.CIETXN.rate
		CUST.INTERFACE.tranRmksCr = MID$(CUST.INTERFACE.tranRmksCr,0,30)
		CUST.INTERFACE.tranRmksDr = MID$(CUST.CIETXN.crAcctName,0,30)
		CUST.INTERFACE.tranParticulars2Dr = ""
		CUST.INTERFACE.tranParticulars2Cr = ""
		CUST.INTERFACE.refNumDr = CUST.CIETXN.ieTxnRefNo
		CUST.INTERFACE.refNumCr = CUST.CIETXN.ieTxnRefNo
		CUST.INTERFACE.drValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.rateCode = ""
		CUST.INTERFACE.drRate = "1.00"
		CUST.INTERFACE.crRate = "1.00"

		sv_s=" ACCT_CRNCY_CODE_DR | select ACCT_CRNCY_CODE from tbaadm.gam  where foracid   = ?SVAR  "
		BANCS.INPARAM.BINDVARS =  CUST.INTERFACE.crAcctID
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d == 0) THEN
			CUST.CIETXN.ACCT_CRNCY_CODE_DR = BANCS.OUTPARAM.ACCT_CRNCY_CODE_DR
			Print (CUST.CIETXN.ACCT_CRNCY_CODE_DR)
		ENDIF
		IF (CUST.INTERFACE.tranCcyDr != CUST.CIETXN.ACCT_CRNCY_CODE_DR) THEN		
			sv_r = REPEXISTS("CUST")
                        IF(sv_r == 0) THEN
                                CREATEREP ("CUST")
                        ENDIF
                        sv_r = CLASSEXISTS("CUST","RATE")
                        IF(sv_r == 0) THEN
                                CREATECLASS ("CUST","RATE",5)
                        ENDIF
			CUST.RATE.acctCrncy = CUST.CIETXN.ACCT_CRNCY_CODE_DR
                        CUST.RATE.refCrncy = CUST.INTERFACE.tranCcyDr
                        CUST.RATE.TranType = "T"
                        CALL("fetchRateCode.scr")
			Print (CUST.RATE.rateCode)
			Print (CUST.RATE.rate)
                        CUST.INTERFACE.rateCode = CUST.RATE.rateCode
                        CUST.INTERFACE.drRate = CUST.RATE.rate
		ENDIF
		
		sv_s=" ACCT_CRNCY_CODE | select ACCT_CRNCY_CODE from tbaadm.gam  where foracid   = ?SVAR  "
		BANCS.INPARAM.BINDVARS =  CUST.INTERFACE.crAcctID
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d == 0) THEN
			CUST.CIETXN.ACCT_CRNCY_CODE_CR = BANCS.OUTPARAM.ACCT_CRNCY_CODE
			Print (CUST.CIETXN.ACCT_CRNCY_CODE_CR)
		ENDIF
		IF (CUST.INTERFACE.tranCcyCr != CUST.CIETXN.ACCT_CRNCY_CODE_CR) THEN		
			sv_r = REPEXISTS("CUST")
                        IF(sv_r == 0) THEN
                                CREATEREP ("CUST")
                        ENDIF
                        sv_r = CLASSEXISTS("CUST","RATE")
                        IF(sv_r == 0) THEN
                                CREATECLASS ("CUST","RATE",5)
                        ENDIF
			CUST.RATE.acctCrncy = CUST.CIETXN.ACCT_CRNCY_CODE_CR
                        CUST.RATE.refCrncy = CUST.INTERFACE.tranCcyCr
                        CUST.RATE.TranType = "T"
                        CALL("fetchRateCode.scr")
			Print (CUST.RATE.rateCode)
			Print (CUST.RATE.rate)
                        CUST.INTERFACE.rateCode = CUST.RATE.rateCode
                        CUST.INTERFACE.crRate = CUST.RATE.rate
		ENDIF

		CUST.INTERFACE.chkInstDetails = "N"
		CUST.INTERFACE.instDate = ""
		CUST.INTERFACE.instAlpha = ""
		CUST.INTERFACE.instNum = ""
		CUST.INTERFACE.instType = ""
		CUST.INTERFACE.chargeAmtPartTran = "N"
		CUST.INTERFACE.errorMsgFlg = "N"
		CUST.INTERFACE.errorMsgCode = " "
		CUST.INTERFACE.errorMsgDesc = " "
		CUST.INTERFACE.errorDesc = " "
		CUST.INTERFACE.errorCode = " "
		
		CALL("cietxnmn003.scr")
		CUST.CIETXN.entity2TranId1 = CUST.INTERFACE.tranId
		print(CUST.INTERFACE.tranId)
		print(CUST.CIETXN.entity2TranId1)

		#}
		ENDIF
	ELSE
	
		CUST.CIETXN.entity2TranId1 = "No Charge"
		print(CUST.CIETXN.entity2TranId1)

	ENDIF
                           
		######################################################################################
		# RSC FI call End
		######################################################################################

		IF(CUST.CIETXN.scriptSuccess == "N")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		sv_s = "RESULT_MSG|Inter Entity  Transfer Transaction Done Successfully. Transaction Reference No: " + CUST.CIETXN.ieTxnRefNo
		sv_s = sv_s + "!" + CUST.CIETXN.ieTxnRefNo + "!" + CUST.CIETXN.entity1 + "!" + CUST.CIETXN.entity1TranId + "!" + CUST.CIETXN.entity1TranDate + "!" + CUST.CIETXN.entity2 + "!" + CUST.CIETXN.entity2TranId + "!" + CUST.CIETXN.entity2TranId1 + "!" + CUST.CIETXN.entity2TranDate + "!" + CUST.CIETXN.chargeTranId + "!" + CUST.CIETXN.chargeTranDate+"!"+CUST.CIETXN.crAcctName
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_u)

	ENDOFSCRIPT:
END-->
