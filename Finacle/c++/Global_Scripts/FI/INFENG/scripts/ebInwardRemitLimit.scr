                                PRINT(EBSRV.GLBDATA.b2kid)

                                sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + EBSRV.GLBDATA.foracid )
                                sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
                                sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" + EBSRV.GLBDATA.tranCrncy )
                                sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
                                sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + EBSRV.GLBDATA.tranAmt + "|" + EBSRV.GLBDATA.tranCrncy)
                                sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + EBSRV.GLBDATA.amount1 + "|" + EBSRV.GLBDATA.tranCrncy)
                                sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + EBSRV.GLBDATA.LimExpiryDate )
                                sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|LIRM")
                                sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + EBSRV.GLBDATA.tranRemarks )
                                sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + EBSRV.GLBDATA.LimExpiryDate )
                                sv_t = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output =Y|same_user_verify =Y")
                                print(sv_t)
                                if(sv_t=="0")then
                                        print("lien")
                                        sv_u = urhk_getFileLocation("COM|ebIrm.com")
                                        if(sv_u ==0)then
                                                print(BANCS.OUTPARAM.fileLocation)
                                                EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "ebIrm.com"
                                                #++++++++++++++
                                                ##Frame
                                                #++++++++++++++
                                                EBSRV.GLBDATA.ccAddr = "NA"
                                                EBSRV.GLBDATA.frmPartyName = "Equity"
                                                EBSRV.GLBDATA.frmPartyLname = "Bank"
                                                EBSRV.GLBDATA.loanRefNum = EBSRV.GLBDATA.tranRemarks
                                                EBSRV.GLBDATA.PartyAcct = EBSRV.GLBDATA.foracid
                                        print(EBSRV.GLBDATA.comfil)
                                        print(EBSRV.GLBDATA.toAddr)
                                        print(EBSRV.GLBDATA.PartyName)
                                        print(EBSRV.GLBDATA.PartyLname)
                                        print(EBSRV.GLBDATA.PartyAcct)
                                        print(EBSRV.GLBDATA.tranAmt)
                                        print(EBSRV.GLBDATA.frmPartyName)
                                        print(EBSRV.GLBDATA.frmPartyLname)
                                        print(EBSRV.GLBDATA.loanRefNum)
                                        print(EBSRV.GLBDATA.ccAddr)
                                        print(EBSRV.GLBDATA.bdAddr)
                                        print(EBSRV.GLBDATA.tranparti)
                                                EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " + EBSRV.GLBDATA.toAddr + " " + EBSRV.GLBDATA.PartyName+ " " + EBSRV.GLBDATA.PartyLname + " " + EBSRV.GLBDATA.PartyAcct + " " + EBSRV.GLBDATA.tranAmt + " " + EBSRV.GLBDATA.frmPartyName + " " + EBSRV.GLBDATA.frmPartyLname + " " + EBSRV.GLBDATA.loanRefNum + " " + EBSRV.GLBDATA.ccAddr + " " + EBSRV.GLBDATA.bdAddr + " " + EBSRV.GLBDATA.tranparti
                                        else
                                                EBSRV.GLBDATA.comfil   = ""
                                        endif
                                        print(EBSRV.GLBDATA.comfil)
                                        if(EBSRV.GLBDATA.comfil != "")then
                                                sv_u = system(EBSRV.GLBDATA.comfil)
                                                if(sv_u ==0)then
                                                        print("smtp success")
                                                else
                                                        print("failed smtp")
                                                endif
                                        endif
                                else
                                        goto NXTLP
                                endif
                        #}
                        ELSE
                        #{
                                EBSRV.GLBDATA.amount1 ="0.00"
                        #------------------------------------------------------------------------------------------------------Edwin.z

                                sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + EBSRV.GLBDATA.foracid )
                                sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
