                        sv_s = sv_s + " where e.emp_id = g.user_emp_id and g.user_work_class  in ('200','150') "
                        sv_s = sv_s + " and home_bank_id =?SVAR and g.del_flg ='N' and g.sol_id =?SVAR "
                        sv_s = sv_s + " and e.emp_email_id is not null and rownum <=5 order by g.user_work_class desc "
                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticular + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.solid
