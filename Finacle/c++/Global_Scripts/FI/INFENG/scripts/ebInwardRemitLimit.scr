                                EBSRV.GLBDATA.bdAddr = BANCS.OUTPARAM.empemail
                                EBSRV.GLBDATA.tranparti = BANCS.OUTPARAM.tranparti
                                print(EBSRV.GLBDATA.bdAddr)
                        else
                                EBSRV.GLBDATA.bdAddr = "isaac.mwaurah@equitybank.co.ke"
                                print(EBSRV.GLBDATA.bdAddr)
