<--start
#trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        EBSRV.GLBDATA.comfil = ""
        EBSRV.GLBDATA.toAddr = ""
        EBSRV.GLBDATA.PartyName = "NA"
        EBSRV.GLBDATA.PartyLname = "NA"
        EBSRV.GLBDATA.PartyAcct = ""
        EBSRV.GLBDATA.tranAmt = 0
        EBSRV.GLBDATA.frmPartyName = "NA"
        EBSRV.GLBDATA.frmPartyLname = "NA"
        EBSRV.GLBDATA.loanRefNum = ""
        EBSRV.GLBDATA.ccAddr = "NA"
        EBSRV.GLBDATA.bdAddr = ""
        EBSRV.GLBDATA.tranparti = ""
        EBSRV.GLBDATA.whtCnt = 0
        EBSRV.GLBDATA.srvErrMsg  = ""
        EBSRV.GLBDATA.srvErrCode = ""
        EBSRV.GLBDATA.srvSucFail = ""

        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                EBSRV.GLBDATA.tranId = trim(MTT.InputDetails.Argument1)
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        endif
        sv_d = "tranId,CrAcid,tranAmt,tranCrncy,refAmt,refCrncy,tranParticular,refNum,tranRemarks | "
        sv_d = sv_d + " select tran_id,acid,tran_amt,tran_crncy_code,ref_amt,ref_crncy_code,tran_particular,ref_num,tran_rmks "
        sv_d = sv_d + " from tbaadm.dtd where bank_id= ?SVAR "
        sv_d = sv_d + " and tran_id=lpad(?SVAR,9,' ') "
        sv_d = sv_d + " and tran_date=to_date(?SVAR,'DD-MM-RR') "
        sv_d = sv_d + " and pstd_flg='Y' "
        sv_d = sv_d + " and del_flg='N' "
        sv_d = sv_d + " and part_tran_type='C' "
        sv_d = sv_d + " and ((tran_particular like 'RTGS%') OR (tran_particular like 'SWIFT%'))"
        sv_d = sv_d + " order by rcre_time desc "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.tranId + "|" + mid$(BANCS.STDIN.BODDate,0,10)
        print(sv_d)
        print(BANCS.INPARAM.BINDVARS)
        sv_u = urhk_dbCursorOpenWithBind(sv_d)
        if(sv_u==0)then
                EBSRV.GLBDATA.dtdCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                EBSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EBSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EBSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif
        EBSRV.GLBDATA.dtdRec = 0
        print(EBSRV.GLBDATA.dtdCurNum)
        sv_z = urhk_dbCursorFetch(EBSRV.GLBDATA.dtdCurNum)
        if(sv_z!=0)then
                EBSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EBSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EBSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{ vploop starts
        #+++++++++++++++++
                EBSRV.GLBDATA.tranId    = BANCS.OUTPARAM.tranId
                EBSRV.GLBDATA.CrAcid    = BANCS.OUTPARAM.CrAcid
                EBSRV.GLBDATA.tranAmt   = BANCS.OUTPARAM.tranAmt
                EBSRV.GLBDATA.tranCrncy = BANCS.OUTPARAM.tranCrncy
                EBSRV.GLBDATA.refAmt    = BANCS.OUTPARAM.refAmt
                EBSRV.GLBDATA.refCrncy  = BANCS.OUTPARAM.refCrncy
                EBSRV.GLBDATA.tranParticular = BANCS.OUTPARAM.tranParticular
                EBSRV.GLBDATA.refNum    = BANCS.OUTPARAM.refNum
                EBSRV.GLBDATA.tranRemarks = BANCS.OUTPARAM.tranRemarks
                sv_a= urhk_B2k_AcidToForacid(EBSRV.GLBDATA.CrAcid)
                if(sv_a==0)then
                        EBSRV.GLBDATA.foracid = BANCS.OUTPARAM.Foracid
                else
                        EBSRV.GLBDATA.foracid = ""
                endif
                sv_d = " parmVal | select v.parameter_value from custom.c_cpvalue  v,custom.c_cpmaster m  "
                sv_d = sv_d + " where m.parameter_id=v.parameter_id "
                sv_d = sv_d + " and m.module_name =v.module_name "
                sv_d = sv_d + " and m.module_name='TRANVAL' "
                sv_d = sv_d + " and m.parameter_level='BNKL' "
                EBSRV.GLBDATA.parmId = "IRML" + EBSRV.GLBDATA.tranCrncy
                sv_d = sv_d + " and v.parameter_id=?SVAR "
                sv_d = sv_d + " and m.entity_cre_flg='Y' "
                sv_d = sv_d + " and v.entity_cre_flg='Y' "
                sv_d = sv_d + " and m.del_flg='N' "
                sv_d = sv_d + " and v.del_flg='N' "
                sv_d = sv_d + " and m.bank_id=?SVAR "
                sv_d = sv_d + " and v.bank_id=?SVAR "
                BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.parmId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u == 0)then
                        EBSRV.GLBDATA.parmVal = BANCS.OUTPARAM.parmVal
                else
                        EBSRV.GLBDATA.parmVal = 0
                endif
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.foracid)
                if(sv_u==0)then
                        EBSRV.GLBDATA.CifId = BANCS.OUTPARAM.cifId
			EBSRV.GLBDATA.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
                else
                        EBSRV.GLBDATA.CifId = ""
			EBSRV.GLBDATA.acctOwnerShip = ""
                endif
                if(EBSRV.GLBDATA.CifId!="")then
                sv_d = "lCnt | select count(*) from custom.irml where bank_id=?SVAR and cif_id=?SVAR and del_flg='N' "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.CifId
                print(sv_d)
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u==0)then
                        EBSRV.GLBDATA.whtCnt = BANCS.OUTPARAM.lCnt
                else
                        EBSRV.GLBDATA.whtCnt = 0
                endif
                endif
                if((EBSRV.GLBDATA.acctOwnerShip!="O") and (EBSRV.GLBDATA.foracid!="") and (cdouble(EBSRV.GLBDATA.tranAmt)>=cdouble(EBSRV.GLBDATA.parmVal)) and (cdouble(EBSRV.GLBDATA.whtCnt)<=0))then
                ###if((EBSRV.GLBDATA.foracid!="") and (cdouble(EBSRV.GLBDATA.tranAmt)>=cdouble(EBSRV.GLBDATA.parmVal)))then
                ##{
                        EBSRV.GLBDATA.durationMnths = "0"
                        EBSRV.GLBDATA.durationDays = "7"
                        EBSRV.GLBDATA.newDate = (BANCS.STDIN.BODDate + "|" + EBSRV.GLBDATA.durationMnths + "|" + EBSRV.GLBDATA.durationDays)
                        print(EBSRV.GLBDATA.newDate)
                        sv_u = urhk_B2k_Add_MonthsDays_To_date(EBSRV.GLBDATA.newDate)
                        print(sv_u)
                        if(sv_u != 0)then
                                EBSRV.GLBDATA.LimExpiryDate = LEFT$(BANCS.STDIN.BODDate,10)
                                print(EBSRV.GLBDATA.LimExpiryDate)
                        else
                                EBSRV.GLBDATA.LimExpiryDate = BANCS.OUTPARAM.MODIFIED_DATE
                                print(EBSRV.GLBDATA.LimExpiryDate)
                        endif
                        sv_s = "PartyName,PartyLname | select (case when instrc(nvl(cust_short_name,cust_first_name),' ',1,1) >0 "
                        sv_s = sv_s + " then substr(nvl(cust_short_name,cust_first_name),1,instrc(nvl(cust_short_name,cust_first_name),' ',1,1)) "
                        sv_s = sv_s + " else cust_short_name end) as firstName, "
                        sv_s = sv_s + " (case when instrc(nvl(cust_last_name,cust_last_name),' ',1,1) >0 "
                        sv_s = sv_s + " then substr(nvl(cust_last_name,cust_last_name),1,instrc(nvl(cust_last_name,cust_last_name),' ',1,1)) "
                        sv_s = sv_s + " else cust_last_name end) as lastName "
                        sv_s = sv_s + " from tbaadm.cmg where cif_id in (select cif_id from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR ) "
                        sv_s = sv_s + " and bank_id=?SVAR "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
                        print(sv_s)
                        print(BANCS.INPARAM.BINDVARS)
                        sv_u = urhk_dbSelectWithBind(sv_s)
