                                                EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " + EBSRV.GLBDATA.toAddr + " " + EBSRV.GLBDATA.PartyName+ " " + EBSRV.GLBDATA.PartyLname + " " + EBSRV.GLBDATA.PartyAcct + " " + EBSRV.GLBDATA.tranAmt + " " + EBSRV.GLBDATA.frmPartyName + " " + EBSRV.GLBDATA.frmPartyLname + " " + EBSRV.GLBDATA.loanRefNum + " " + EBSRV.GLBDATA.ccAddr + " " + EBSRV.GLBDATA.bdAddr + " " + EBSRV.GLBDATA.tranparti
                                        else
