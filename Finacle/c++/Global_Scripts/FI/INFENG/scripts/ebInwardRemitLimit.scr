                        ###EBSRV.GLBDATA.bdAddr = "isaac.mwaurah@equitybank.co.ke,vino.palani@simbatech.biz,Edwin.Mureithi@equitybank.co.ke"
                        #------------------------------------------------------------------------------------------------------Edwin.z

                        sv_s = "amount1,acid,b2kid|select trim (lien_amt),acid,b2k_id from tbaadm.alt "
                        sv_s = sv_s  + " where B2K_ID in (select TRIM(max(B2K_ID))  from tbaadm.alt "
                        sv_s = sv_s  + " where acid in (select acid from tbaadm.gam where foracid =?SVAR)) and bank_id =?SVAR "
                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)
                        sv_d = urhk_dbSelectWithBind(sv_s)
                        print(sv_d)

                        IF (sv_d == 0) THEN
                        #{
                                EBSRV.GLBDATA.amount1 = BANCS.OUTPARAM.amount1
                                PRINT(EBSRV.GLBDATA.amount1)
                                EBSRV.GLBDATA.amount1 ="0.00"
                                PRINT(EBSRV.GLBDATA.amount1)
