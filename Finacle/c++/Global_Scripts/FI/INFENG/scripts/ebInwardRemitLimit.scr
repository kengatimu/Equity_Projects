#                       endif
#                       EBSRV.GLBDATA.bdAddr = "vino.palani@simbatech.biz"
                        EBSRV.GLBDATA.toAddr = "NA"


                        sv_h = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.foracid)
                        print(sv_h)
                        IF (sv_h==0) THEN
                        #{
                                EBSRV.GLBDATA.solid = BANCS.OUTPARAM.acctSolId
                                print(EBSRV.GLBDATA.solid)
