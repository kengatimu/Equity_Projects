<--start
trace on
        sv_a = repexists("CUSTOM")
        if (sv_a ==0) then
                createrep("CUSTOM")
        endif
        sv_a = classexists("CUSTOM","GLBDATA")
        if (sv_a ==0) then
                createclass("CUSTOM","GLBDATA",5)
        endif
        CUSTOM.GLBDATA.BODDate = mid$(BANCS.STDIN.BODDate,0,10)
        print(CUSTOM.GLBDATA.BODDate)

        lv_x = BANCS.STDIN.mySolId + "|" + CUSTOM.GLBDATA.BODDate
        print(lv_x)

        sv_e = urhk_GetNextWorkingDate(lv_x)
        print(sv_e)
        if(sv_e==0)then
        #{
                print(BANCS.OUTPARAM.NextWorkingDate)
                print(BANCS.OUTPARAM.PrevWorkingDate)
		CUSTOM.GLBDATA.PrevWorkingDate = BANCS.OUTPARAM.PrevWorkingDate
	#}
	else
		exitscript	
	endif

        if(fieldexists(BANCS.INPUT.inpSolId)==1)then
                CUSTOM.GLBDATA.sol_ID = BANCS.INPUT.inpSolId
        else
                CUSTOM.GLBDATA.sol_ID = ""
        endif
        if(fieldexists(BANCS.INPUT.inpAcctId)==1)then
                CUSTOM.GLBDATA.foracid = BANCS.INPUT.inpAcctId
        else
                CUSTOM.GLBDATA.foracid = ""
        endif
        if(fieldexists(BANCS.INPUT.inpCrncyCode)==1)then
                CUSTOM.GLBDATA.crncyCode = BANCS.INPUT.inpCrncyCode
        else
                CUSTOM.GLBDATA.crncyCode = ""
        endif
        if(fieldexists(BANCS.INPUT.inpIntCrDr)==1)then
                CUSTOM.GLBDATA.intDrCR = BANCS.INPUT.inpIntCrDr
        else
                CUSTOM.GLBDATA.intDrCR = ""
        endif

        CUSTOM.GLBDATA.schmType = "LAA"
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                CUSTOM.GLBDATA.foracid = MTT.InputDetails.Argument1
                CUSTOM.GLBDATA.sol_ID = MTT.InputDetails.Argument2
                CUSTOM.GLBDATA.crncyCode = MTT.InputDetails.Argument3
                CUSTOM.GLBDATA.inpSchmCode = MTT.InputDetails.Argument4
                CUSTOM.GLBDATA.intDrCR = MTT.InputDetails.Argument5
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
        endif
        print(CUSTOM.GLBDATA.sol_ID)
        print(CUSTOM.GLBDATA.foracid)
	sv_u = urhk_getAcctDetailsInRepository(CUSTOM.GLBDATA.foracid)
        if(sv_u==0)then
        #{
		CUSTOM.GLBDATA.acctName = BANCS.OUTPARAM.acctName
	#}
	else
	#{
		CUSTOM.GLBDATA.acctName = ""
	#}
	endif
	
        sv_a = urhk_SetUrhkInp("batchPgmId|LADGEN")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_0>.key.fieldName|sol_set_id")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_0>.fieldValue|"+CUSTOM.GLBDATA.sol_ID)
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_1>.key.fieldName|sol_set_id_desc")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_1>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_2>.key.fieldName|report_to")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_2>.fieldValue|"+CUSTOM.GLBDATA.foracid)
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_3>.key.fieldName|crncy_code")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_3>.fieldValue|" + CUSTOM.GLBDATA.crncyCode )
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_4>.key.fieldName|crncy_desc")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_4>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_5>.key.fieldName|inp_file_name")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_5>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_6>.key.fieldName|inc_restructured_acct")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_6>.fieldValue|E")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_7>.key.fieldName|product_group")
        #sv_a = urhk_SetUrhkInp("batchParam.<rec_7>.fieldValue|"+CUSTOM.GLBDATA.sol_ID)
		sv_a = urhk_SetUrhkInp("batchParam.<rec_7>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_8>.key.fieldName|product_group_desc")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_8>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_9>.key.fieldName|cif_id")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_9>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_10>.key.fieldName|cust_name")
        #sv_a = urhk_SetUrhkInp("batchParam.<rec_10>.fieldValue|"+CUSTOM.GLBDATA.foracid)
		sv_a = urhk_SetUrhkInp("batchParam.<rec_10>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_11>.key.fieldName|acct_from")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_11>.fieldValue|"+CUSTOM.GLBDATA.foracid)
        PRINT(FORMAT$(sv_a, "%d"))
		
        sv_a = urhk_SetUrhkInp("batchParam.<rec_12>.key.fieldName|from_acct_crncy_code")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_12>.fieldValue|" + CUSTOM.GLBDATA.crncyCode )
        PRINT(FORMAT$(sv_a, "%d"))
		
        sv_a = urhk_SetUrhkInp("batchParam.<rec_13>.key.fieldName|from_acct_sol_id")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_13>.fieldValue|"+CUSTOM.GLBDATA.sol_ID)
        PRINT(FORMAT$(sv_a, "%d"))
		
        sv_a = urhk_SetUrhkInp("batchParam.<rec_14>.key.fieldName|acct_name_from")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_14>.fieldValue|"+CUSTOM.GLBDATA.acctName)
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_15>.key.fieldName|acct_to")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_15>.fieldValue|"+CUSTOM.GLBDATA.foracid)
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_16>.key.fieldName|to_acct_crncy_code")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_16>.fieldValue|"+ CUSTOM.GLBDATA.crncyCode )
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_17>.key.fieldName|to_acct_sol_id")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_17>.fieldValue|"+CUSTOM.GLBDATA.sol_ID)
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_18>.key.fieldName|acct_name_to")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_18>.fieldValue|"+CUSTOM.GLBDATA.acctName)
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_19>.key.fieldName|print_int_detail")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_19>.fieldValue|D")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_20>.key.fieldName|inc_npa_acct")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_20>.fieldValue|I")

        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_21>.key.fieldName|inc_disabled_acct")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_21>.fieldValue|E")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_22>.key.fieldName|force_int_run")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_22>.fieldValue|Y")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_23>.key.fieldName|force_int_run_till_date")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_23>.fieldValue|"+ CUSTOM.GLBDATA.PrevWorkingDate)
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_24>.key.fieldName|value_date")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_24>.fieldValue|"+BANCS.STDIN.BODDate)
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_25>.key.fieldName|override_npa_int_flg")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_25>.fieldValue|N")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_26>.key.fieldName|trial_mode")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_26>.fieldValue|N")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_27>.key.fieldName|type_of_dmd")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_27>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_28>.key.fieldName|menu_parm")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_28>.fieldValue|L")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_29>.key.fieldName|diff_date")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_29>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_30>.key.fieldName|value_date_diff")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_30>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_31>.key.fieldName|desc")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_31>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_32>.key.fieldName|schm_code_list")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_32>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_33>.key.fieldName|schm_type")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_33>.fieldValue|LAA")

        PRINT(FORMAT$(sv_a, "%d"))
        sv_a = urhk_SetUrhkInp("batchParam.<rec_34>.key.fieldName|schm_type_list")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_34>.fieldValue|LAA")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_35>.key.fieldName|call_mode")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_35>.fieldValue|B")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_36>.key.fieldName|disable_flg")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_36>.fieldValue|N")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_37>.key.fieldName|sol_set_desc")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_37>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_38>.key.fieldName|schm_code_desc")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_38>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))

        sv_a = urhk_SetUrhkInp("batchParam.<rec_39>.key.fieldName|schme_code")
        sv_a = urhk_SetUrhkInp("batchParam.<rec_39>.fieldValue|")
        PRINT(FORMAT$(sv_a, "%d"))
	
        sv_a = urhk_SetUrhkInp("pgmStatus|0")
        PRINT(FORMAT$(sv_a, "%d"))
		
        sv_a = urhk_ExecSrv("NAPI_ExecuteBatch|retain_all_output = Y")
        PRINT(FORMAT$(sv_a, "%d"))
		
        if(sv_a != 0) then
                print("fail")
                call("ebsrvHandler.scr")
                CUSTOM.GLBDATA.isRoutine = "N"
        else
                print("succ")
                CUSTOM.GLBDATA.isRoutine = "Y"
        endif
exitscript
end-->


