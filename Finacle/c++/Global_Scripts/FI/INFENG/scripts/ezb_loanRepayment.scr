<--START
TRACE ON

    sv_u=REPEXISTS("CUST")
    IF(sv_u==0) THEN
    #{
        CREATEREP("CUST")
    #}
    ENDIF

    sv_u=CLASSEXISTS("CUST", "EZB")
    IF(sv_u==0) THEN
    #{
        CREATECLASS("CUST", "EZB", 5)
    #}
    ENDIF

    sv_t=urhk_b2k_printrepos("BANCS")
    print(sv_t)

    IF( (FIELDEXISTS(("BANCS").("INPUT").("AccountNo"))== 0) ) THEN
    #{
        CUST.EZB.errMsg="Please Enter Account Number"
        lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
    ELSE 
        CUST.EZB.AccountNo = TRIM(BANCS.INPUT.AccountNo)
        print(CUST.EZB.AccountNo)
        lv_u = urhk_B2k_ForacidToAcid(CUST.EZB.AccountNo)
        print(lv_u)

        if(lv_u == 0)then
        #{
            CUST.EZB.acid = BANCS.OUTPARAM.Acid
            print(CUST.EZB.acid)
        ELSE 
            CUST.EZB.errMsg="Invalid Account ["+CUST.EZB.AccountNo +"]"
            lv_a = "E9999"
            sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
            sv_u = urhk_SetOrbErr(sv_c)
            exitscript
        #}
        ENDIF

        sv_a = urhk_getAcctDetailsInRepository(CUST.EZB.AccountNo)
        print(sv_a)

        IF(sv_a == 0)THEN
        #{
            CUST.EZB.schmType = trim(BANCS.OUTPARAM.schmType)
            print(CUST.EZB.schmType)

            IF(CUST.EZB.schmType != "LAA")THEN
            #{
                CUST.EZB.errMsg="Scheme type not Allowed "
                lv_a = "E9999"
                sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
                sv_u = urhk_SetOrbErr(sv_c)
                exitscript
            #}
            ENDIF 
        #}
        ENDIF
    #}
    ENDIF

    #---------------------------------------------------------------------------------------------------------------
    # Variable Initialization
    #---------------------------------------------------------------------------------------------------------------
    CUST.EZB.schm_type = ""
    sv_z = " "
    CUST.EZB.installmentStatus = ""
    CUST.EZB.zero = "0.00"

    #----------------------------------------------------------------------------------------------
    # validations
    #----------------------------------------------------------------------------------------------

    sv_q = "dmdDate |"
    sv_q = sv_q + " SELECT DISTINCT DMD_DATE FROM TBAADM.LDT l WHERE ACID =?SVAR AND BANK_ID=?SVAR AND DEL_FLG='N' "
    sv_q = sv_q + " UNION "
    sv_q = sv_q + " SELECT DISTINCT DMD_DATE FROM TBAADM.LDTH WHERE ACID =?SVAR AND BANK_ID= ?SVAR AND DEL_FLG='N' ORDER BY DMD_DATE DESC "
    print(sv_q)
    
    BANCS.INPARAM.BINDVARS =  CUST.EZB.acid +"|"+BANCS.STDIN.contextBankId+"|"+CUST.EZB.acid +"|"+BANCS.STDIN.contextBankId
    print(BANCS.INPARAM.BINDVARS)

    sv_c = urhk_dbcursorOpenWithBind(sv_q)
    PRINT(sv_c)

    IF (sv_c == 0)THEN
    #{
        CUST.EZB.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        PRINT(CUST.EZB.cursor_number)

        sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
        print(sv_d)

        sv_q = 0
        print(sv_q)

        IF(sv_d == 0)THEN
        #{
            WHILE (sv_d == 0)
            #{
                sv_q = sv_q + 1
                print(sv_q)

                CUST.EZB.dmdDate = BANCS.OUTPARAM.dmdDate
                print(CUST.EZB.dmdDate)
            
                ##== GET INDEM
                lv_q = "intDmdAmt,intAdjAmt |SELECT DMD_AMT,TOT_ADJ_AMT FROM TBAADM.LDT l WHERE DMD_FLOW_ID IN ('INDEM') AND ACID =?SVAR AND DMD_DATE=?SVAR AND BANK_ID=?SVAR AND DEL_FLG='N' AND "
                lv_q =  lv_q + " DMD_SRL_NUM IN (SELECT MAX(DMD_SRL_NUM) FROM TBAADM.LDT WHERE ACID=L.ACID AND DMD_DATE= L.DMD_DATE)"
                lv_q =  lv_q + " UNION "
                lv_q =  lv_q + " SELECT DMD_AMT,TOT_ADJ_AMT FROM TBAADM.LDTH l WHERE DMD_FLOW_ID IN ('INDEM') AND ACID =?SVAR AND DMD_DATE=?SVAR AND BANK_ID=?SVAR AND DEL_FLG='N' AND "
                lv_q =  lv_q + " DMD_SRL_NUM IN (SELECT MAX(DMD_SRL_NUM) FROM TBAADM.LDT WHERE ACID=L.ACID AND DMD_DATE= L.DMD_DATE)"
                print(lv_q)
                BANCS.INPARAM.BINDVARS = CUST.EZB.acid +"|"+ CUST.EZB.dmdDate +"|"+ BANCS.STDIN.contextBankId+"|"+CUST.EZB.acid +"|"+ CUST.EZB.dmdDate +"|"+ BANCS.STDIN.contextBankId
                print(BANCS.INPARAM.BINDVARS)

                sv_c = urhk_dbSelectWithBind(lv_q)
                PRINT(sv_c)

                IF(sv_c == 0)THEN
                #{
                    CUST.EZB.intDmdAmt = BANCS.OUTPARAM.intDmdAmt
                    print(CUST.EZB.intDmdAmt)

                    CUST.EZB.intAdjAmt = BANCS.OUTPARAM.intAdjAmt
                    print(CUST.EZB.intAdjAmt)
                ELSE
                    CUST.EZB.intDmdAmt = CUST.EZB.zero
                    CUST.EZB.intAdjAmt = CUST.EZB.zero
                #}
                ENDIF

                ##== GET PRDEM
                lv_q = "prDmdAmt,prAdjAmt, dmdDueDate |SELECT DMD_AMT,TOT_ADJ_AMT,DMD_OVDU_DATE FROM TBAADM.LDT l WHERE DMD_FLOW_ID IN ('PRDEM') AND ACID =?SVAR AND DMD_DATE=?SVAR AND BANK_ID=?SVAR AND DEL_FLG='N' AND "
                lv_q =  lv_q + " DMD_SRL_NUM IN (SELECT MAX(DMD_SRL_NUM) FROM TBAADM.LDT WHERE ACID=L.ACID AND DMD_DATE= L.DMD_DATE AND DMD_FLOW_ID ='PRDEM' )"
                lv_q =  lv_q + " UNION "
                lv_q =  lv_q + " SELECT DMD_AMT,TOT_ADJ_AMT,DMD_OVDU_DATE FROM TBAADM.LDTH l WHERE DMD_FLOW_ID IN ('PRDEM') AND ACID =?SVAR AND DMD_DATE=?SVAR AND BANK_ID=?SVAR AND DEL_FLG='N' AND "
                lv_q =  lv_q + " DMD_SRL_NUM IN (SELECT MAX(DMD_SRL_NUM) FROM TBAADM.LDTH WHERE ACID=L.ACID AND DMD_DATE= L.DMD_DATE AND DMD_FLOW_ID ='PRDEM' )"
                print(lv_q)
                BANCS.INPARAM.BINDVARS = CUST.EZB.acid +"|"+ CUST.EZB.dmdDate +"|"+ BANCS.STDIN.contextBankId+"|"+CUST.EZB.acid +"|"+ CUST.EZB.dmdDate +"|"+ BANCS.STDIN.contextBankId
                print(BANCS.INPARAM.BINDVARS)

                sv_c = urhk_dbSelectWithBind(lv_q)
                PRINT(sv_c)

                IF(sv_c == 0)THEN
                #{
                    CUST.EZB.prDmdAmt = BANCS.OUTPARAM.prDmdAmt
                    print(CUST.EZB.prDmdAmt)

                    CUST.EZB.prAdjAmt = BANCS.OUTPARAM.prAdjAmt
                    print(CUST.EZB.prAdjAmt)

                    CUST.EZB.dmdDueDate = BANCS.OUTPARAM.dmdDueDate
                    print(CUST.EZB.dmdDueDate)
                ELSE
                    CUST.EZB.prDmdAmt = CUST.EZB.zero
                    CUST.EZB.prAdjAmt = CUST.EZB.zero
                    CUST.EZB.dmdDueDate = ""
                #}
                ENDIF

                ##== GET PIDEM
                #lv_q = "piDmdAmt,piAdjAmt |SELECT DMD_AMT,TOT_ADJ_AMT,DMD_EFF_DATE FROM TBAADM.LDT l WHERE DMD_FLOW_ID IN ('PRDEM') AND ACID =?SVAR AND DMD_DATE=?SVAR AND BANK_ID=?SVAR "
                #lv_q =  lv_q + " UNION "
                #lv_q =  lv_q + " SELECT DMD_AMT,TOT_ADJ_AMT,DMD_EFF_DATE FROM TBAADM.LDTH l WHERE DMD_FLOW_ID IN ('PRDEM') AND ACID =?SVAR AND DMD_DATE=?SVAR AND BANK_ID=?SVAR "
                #print(lv_q)
                #BANCS.INPARAM.BINDVARS = CUST.EZB.acid +"|"+ CUST.EZB.dmdDate +"|"+ BANCS.STDIN.contextBankId+"|"+CUST.EZB.acid +"|"+ CUST.EZB.dmdDate +"|"+ BANCS.STDIN.contextBankId
                #print(BANCS.INPARAM.BINDVARS)
                #
                #sv_c = urhk_dbSelectWithBind(lv_q)
                #PRINT(sv_c)
                #
                #IF(sv_c == 0)THEN
                ##{
                #    CUST.EZB.piDmdAmt = BANCS.OUTPARAM.piDmdAmt
                #    print(CUST.EZB.piDmdAmt)
                #
                #    CUST.EZB.piAdjAmt = BANCS.OUTPARAM.piAdjAmt
                #    print(CUST.EZB.piAdjAmt)
                #ELSE
                #    CUST.EZB.piDmdAmt = CUST.EZB.zero
                #    CUST.EZB.piAdjAmt = CUST.EZB.zero
                ##}
                #ENDIF

                ##== GET INTEREST RATE
                lv_q = "rate |SELECT INTEREST_RATE FROM TBAADM.EIT e WHERE e.entity_id =?SVAR AND bank_id=?SVAR"
                #lv_q = "rate | SELECT NRML_PCNT_DR FROM TBAADM.ITC c WHERE c.ENTITY_ID=?SVAR and del_flg='N' and entity_cre_flg='Y' and bank_id=?SVAR and int_tbl_code_srl_num in (select max(INT_TBL_CODE_SRL_NUM) from tbaadm.itc where  ENTITY_ID=c.entity_id )"
                print(lv_q)
                BANCS.INPARAM.BINDVARS = CUST.EZB.acid+"|"+ BANCS.STDIN.contextBankId
                print(BANCS.INPARAM.BINDVARS)

                sv_c = urhk_dbSelectWithBind(lv_q)
                PRINT(sv_c)

                IF(sv_c == 0)THEN
                #{
                    CUST.EZB.intRate = BANCS.OUTPARAM.rate
                    print(CUST.EZB.intRate)
                ELSE
                    CUST.EZB.errMsg="Error Getting interest rate for ["+CUST.EZB.AccountNo +"]"
                    lv_a = "E9999"
                    sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
                    sv_u = urhk_SetOrbErr(sv_c)
                    exitscript
                #}
                ENDIF

                CUST.EZB.totPaidAmt = CDOUBLE(CUST.EZB.intAdjAmt) + CDOUBLE(CUST.EZB.prAdjAmt)
                 CUST.EZB.totPaidAmt =  FORMAT$(CDOUBLE(CUST.EZB.totPaidAmt),"%.2f")
                print(CUST.EZB.totPaidAmt)
                CUST.EZB.totDmdAmt = CDOUBLE(CUST.EZB.prDmdAmt) + CDOUBLE(CUST.EZB.intDmdAmt)
                CUST.EZB.totDmdAmt = FORMAT$(CDOUBLE(CUST.EZB.totDmdAmt),"%.2f")
                print(CUST.EZB.totDmdAmt)

                IF( (CDOUBLE(CUST.EZB.totDmdAmt) == CDOUBLE(CUST.EZB.totPaidAmt)) OR (CDOUBLE(CUST.EZB.totPaidAmt) > CDOUBLE(CUST.EZB.totDmdAmt)) )THEN
                #{
                    CUST.EZB.installmentStatus = "SATISFIED"
                ELSE 
                    CUST.EZB.installmentStatus = "UNSATISFIED"
                #}
                ENDIF

                sv_v = "" + FORMAT$(sv_q, "%d")
                sv_t = "LoanAccountNumber| " + CUST.EZB.AccountNo
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "InstallmentNo_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = sv_q

                sv_v = "DueDate_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = CUST.EZB.dmdDueDate

                sv_v = "LoanOpeningBalance_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = sv_z

                sv_v = "PrincipalAmount_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = CUST.EZB.prAdjAmt

                sv_v = "InterestAmount_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = CUST.EZB.intAdjAmt

                sv_v = "InterestRate_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = CUST.EZB.intRate

                sv_v = "TotalAmount_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = CUST.EZB.totPaidAmt

                sv_v = "LoanClosingBalance_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = sv_z

                sv_v = "InstallmentPaymentStatus_" + FORMAT$(sv_q, "%d")
                ("CUST").("EZB").(sv_v) = CUST.EZB.installmentStatus

                sv_v = "InstallmentNo_" + FORMAT$(sv_q, "%d")
                sv_t = "LoanRepaymentSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.InstallmentNo| " + ("CUST").("EZB").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "DueDate_" + FORMAT$(sv_q, "%d")
                sv_t = "LoanRepaymentSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.DueDate| " + ("CUST").("EZB").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "PrincipalAmount_" + FORMAT$(sv_q, "%d")
                sv_t = "LoanRepaymentSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.PrincipalAmount| " + ("CUST").("EZB").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "InterestAmount_" + FORMAT$(sv_q, "%d")
                sv_t = "LoanRepaymentSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.InterestAmount| " + ("CUST").("EZB").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "InterestRate_" + FORMAT$(sv_q, "%d")
                sv_t = "LoanRepaymentSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.InterestRate| " + ("CUST").("EZB").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "TotalAmount_" + FORMAT$(sv_q, "%d")
                sv_t = "LoanRepaymentSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.TotalAmount| " + ("CUST").("EZB").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_v = "InstallmentPaymentStatus_" + FORMAT$(sv_q, "%d")
                sv_t = "LoanRepaymentSchedule_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.InstallmentPaymentStatus| " + ("CUST").("EZB").(sv_v)
                sv_u = urhk_SetOrbOut(sv_t)

                sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
                print(sv_d)
            #} 
            DO 

            sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
            print(sv_x)
            print(CUST.EZB.cursor_number)
        ELSE
            sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
            print(sv_x)
            print(CUST.EZB.cursor_number)

            CUST.EZB.errMsg = "Unable to Fetch Records. Contact System Admin."
            lv_a = "E9999"
            sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
            sv_u = urhk_SetOrbErr(sv_c)
            exitscript
        #}
        ENDIF 
    ELSE
        CUST.EZB.errMsg="Error Occured fetching records["+CUST.EZB.AccountNo +"]"
        lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
    #}
    ENDIF
ENDSCRIPT:
trace off
