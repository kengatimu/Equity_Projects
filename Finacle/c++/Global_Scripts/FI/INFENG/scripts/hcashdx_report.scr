	#		PRINT(CUST.DENOM.totamt_wrd)
	#	ELSE
	CUST.DENOM.totamt_wrd = ""
	
	#	ENDIF
	#endif
	
	print(CUST.DENOM.totamt_wrd)
	print(BANCS.STDIN.myBankCode)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.myBankCode + "|" + BANCS.STDIN.contextBankId
	lv_s = "Bankname|select BANK_NAME from TBAADM.BANK_CODE_TABLE where bank_code = ?SVAR AND  bank_id = ?SVAR"
	PRINT(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	PRINT(lv_d)
	IF (lv_d == 0) THEN
	#{
		CUST.DENOM.Bankname = BANCS.OUTPARAM.Bankname
		
		PRINT(CUST.DENOM.Bankname)
		#}
	ELSE
		#{
		CUST.DENOM.Bankname = ""
		
	#}
	ENDIF
	
	#---------------CHanged for BW PRD Error - GIRI--
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DENOM.CrncyCode2
	
	lv_s = "crncyname,dcmldesc|select crncy_name,dcml_desc from tbaadm.cnc where bank_id=?SVAR "
	lv_s = lv_s + "  AND crncy_code=?SVAR "
	lv_s = lv_s + "  AND ENTITY_CRE_FLG = 'Y' "
	lv_s = lv_s + "  AND DEL_FLG = 'N' "
	print(lv_s)
	
	lv_d = urhk_dbSelectWithBind(lv_s)
	PRINT(lv_d)
	
	IF (lv_d == 0) THEN
	#{
		CUST.DENOM.crncyname = BANCS.OUTPARAM.crncyname
		PRINT(CUST.DENOM.crncyname)
		
		CUST.DENOM.dcmldesc = BANCS.OUTPARAM.dcmldesc
		print(CUST.DENOM.dcmldesc)
		#}
	ELSE
		#{
		CUST.DENOM.crncyname = ""
		CUST.DENOM.dcmldesc = ""
	#}
	ENDIF
	
	# ----------------------------------------------------------------
	#  Writing to the lst file
	# ---------------------------------------------------------------
	lv_k = CUST.DENOM.sol_desc + "|" + CUST.DENOM.CrncyCode1 + "|"
	lv_k = lv_k + CUST.DENOM.totexchgamt + "|" + CUST.DENOM.CrncyCode2 + "|"
	lv_k = lv_k + CUST.DENOM.totamt + "|" + CUST.DENOM.rate + "|"
	lv_k = lv_k + CUST.DENOM.chrgAmount + "|" + CUST.DENOM.totamt_wrd + "|" + CUST.DENOM.Bankname + "|"
	lv_k = lv_k + CUST.DENOM.crncyname + "|" + CUST.DENOM.dcmldesc
	PRINT(lv_k)
	lv_q = " echo '" + lv_k + "' >> " + CUST.DENOM.lstFile
	PRINT(lv_q)
	lv_v = SYSTEM(lv_q)
	print(lv_v)
	
	# ----------------------------------------------------------------
	#  REPORT GENERATION
	# ----------------------------------------------------------------
	CUST.DENOM.jasperFile = "hcashdx_report.jasper"
	CUST.DENOM.rptTitle = "CASH EXCHANGE REPORT"
	CUST.DENOM.rptFile = "CASH_EXCHANGE_REPORT"
	
	lv_n = CUST.DENOM.rptFile + "_" + BANCS.STDIN.userId + "_" + CUST.DENOM.key
	CUST.DENOM.FILENAME = lv_n
	lv_e = "exebatch mrbx4004 $B2K_SESSION_ID " + CUST.DENOM.jasperFile + "  " + CUST.DENOM.lstFile + "   "
	lv_e = lv_e + lv_n
	PRINT(lv_e)
	lv_f = SYSTEM(lv_e)
	PRINT(lv_f)
	IF (lv_f != 0) THEN
	#{
		PRINT("RPT Generation Failed")
		GOTO STEP1
	#}
	ENDIF
	
	lv_x = "exebatch babx4040 $B2K_SESSION_ID  '" + lv_n + "'.PDF '" + CUST.DENOM.rptTitle + "' 'MANAGER' '1' 'N'"
	PRINT(lv_x)
	lv_h = SYSTEM(lv_x)
	PRINT(lv_h)
	IF (lv_h == 0) THEN
	#{
		PRINT("Report generated successfully")
		CUST.DENOM.CUSTOPTN_ID = "FIN_REPORTS_DIR"
		BANCS.INPARAM.BINDVARS = CUST.DENOM.CUSTOPTN_ID + "|" + BANCS.STDIN.contextBankId
		sv_q = "custoptn_value| SELECT custoptn_value FROM TBAADM.COMT"
		sv_q = sv_q + " WHERE custoptn_id = ?SVAR "
		sv_q = sv_q + " AND bank_id = ?SVAR "
		print(sv_q)
		sv_s = urhk_dbselectWithBind(sv_q)
		IF (sv_s == 0) THEN
		#{
			CUST.DENOM.PATH = BANCS.OUTPARAM.custoptn_value + "/" + BANCS.STDIN.userId + "/" + lv_n + ".PDF"
			print(CUST.DENOM.PATH)
			#}
		ELSE
			#{
			CUST.DENOM.PATH = "Report generation failed"
			CUST.DENOM.ErrMsg = urtn_getMsg("V200757")
			print(CUST.DENOM.ErrMsg)
			sv_u = urhk_SetOrbOut("Error_1|1^" + CUST.DENOM.ErrMsg + "^Message")
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	STEP1:
END-->
