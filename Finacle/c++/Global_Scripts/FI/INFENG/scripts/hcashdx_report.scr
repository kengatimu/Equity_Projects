	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	lv_s = "sol_desc|select SOL_DESC from tbaadm.sol where SOL_ID = ?SVAR AND  bank_id = ?SVAR "
	
	PRINT(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	IF (lv_d != 0) THEN
	#{
		PRINT("Error in getting key. Exiting")
		GOTO STEP1
		#}
	ELSE
		#{
		CUST.DENOM.sol_desc = BANCS.OUTPARAM.sol_desc
		
	#}
	ENDIF
	
	lv_s = "key|SELECT TO_CHAR(sysdate,'DDMMYYYYHH24MISS') FROM dual"
	
	PRINT(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	IF (lv_d != 0) THEN
	#{
		PRINT("Error in getting key. Exiting")
		GOTO STEP1
		#}
	ELSE
		#{
		CUST.DENOM.key = BANCS.OUTPARAM.key
	#}
	ENDIF
	
	
	
	CUST.DENOM.lstFile = "CashExchange_" + BANCS.STDIN.userId + "_" + CUST.DENOM.key + ".LST"
	lv_e = "touch " + CUST.DENOM.lstFile
	PRINT(lv_e)
	lv_m = SYSTEM(lv_e)
	PRINT(lv_m)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	lv_s = "addr1,addr2| "
	lv_s = lv_s + " SELECT addr_1,addr_2 FROM tbaadm.sol"
	lv_s = lv_s + " WHERE sol_id = ?SVAR"
	lv_s = lv_s + " AND del_flg <> 'Y'"
	lv_s = lv_s + " AND bank_id = ?SVAR"
	PRINT(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	PRINT(lv_d)
	
	IF (lv_d == 0) THEN
	#{
		CUST.DENOM.brAddr1 = BANCS.OUTPARAM.addr1
		PRINT(CUST.DENOM.brAddr1)
		CUST.DENOM.brAddr2 = BANCS.OUTPARAM.addr2
		PRINT(CUST.DENOM.brAddr2)
		#}
	ELSE
		#{
		print("Query execuion failed")
		CUST.DENOM.brAddr1 = ""
		CUST.DENOM.brAddr2 = ""
	#}
	ENDIF
	sv_a = CUST.DENOM.totamt
	sv_b = ""
	sv_c = getposition(CUST.DENOM.totamt, '.')
	print(sv_c)
	
	IF (sv_c != 0) THEN
	#{
		
		sv_a = Left$(CUST.DENOM.totamt, (sv_c - 1))
		print(sv_a)
		
		sv_b = Right$(CUST.DENOM.totamt, 2)
		print(sv_b)
		
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = sv_a
	
	#lv_s = "word|select to_char(to_date(to_char(?SVAR,'9999999'),'J'),'JSP') from dual"
	#PRINT(lv_s)
	#lv_d = urhk_dbSelectWithBind(lv_s)
