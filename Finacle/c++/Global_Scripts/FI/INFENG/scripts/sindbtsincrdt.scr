MTT.TranDetails.flgPostTransaction= "Y"

sv_r = urhk_MTTS_DefineTransaction("MPESATRAN")
print(sv_r)
if (sv_r != 0) then
#{
STDWFS.GLBDATA.Error_Desc      = "Error In Creation of Transaction"
exitscript
#}
endif

################################## End of Header ################################

################## Debit Transaction:####################################
MTT.PartTranDetails.RefAmount="-"+CUST.CIETXN.Amount
MTT.PartTranDetails.Account=CUST.CIETXN.Debit_Acct
MTT.PartTranDetails.RefCurrency="KES"
MTT.TranDetails.Remarks="Charges TRAN"
MTT.PartTranDetails.Consolidate="N"
MTT.PartTranDetails.Particulars=CUST.CIETXN.service_name + "_CHARGES/" +CUST.CIETXN.Refnumberto 
MTT.PartTranDetails.ValueDate="0"
MTT.PartTranDetails.ValueDateDiff="0"
MTT.PartTranDetails.TranIdentifier="MPESATRAN"
