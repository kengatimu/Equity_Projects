<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DD") == 0) THEN
        #{
                CREATECLASS("CUST","DD",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CancelUserID"))== 1) ) THEN
	#{
		CUST.DD.CancelUserID= BANCS.INPUT.CancelUserID
		PRINT(CUST.DD.CancelUserID)
	#}
	ELSE
	#{
		CUST.DD.CancelUserID=""
		PRINT(CUST.DD.CancelUserID)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("PostUserID"))== 1) ) THEN
	#{
		CUST.DD.PostUserID= BANCS.INPUT.PostUserID
		PRINT(CUST.DD.PostUserID)
	#}
	ELSE
	#{
		CUST.DD.PostUserID=""
		PRINT(CUST.DD.PostUserID)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Function"))== 0) ) THEN
	#{
   		CUST.DD.errMsg="Function is not available"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("DemandDraftNo"))== 1) ) THEN
	#{
		CUST.DD.DemandDraftNo= BANCS.INPUT.DemandDraftNo
		PRINT(CUST.DD.DemandDraftNo)
	#}
	ELSE
	#{
		CUST.DD.DemandDraftNo=""
		PRINT(CUST.DD.DemandDraftNo)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("DDtranId"))== 1) ) THEN
	#{
		CUST.DD.DDtranId= BANCS.INPUT.DDtranId
		PRINT(CUST.DD.DDtranId)
	#}
	ELSE
	#{
		CUST.DD.DDtranId=""
		PRINT(CUST.DD.DDtranId)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("DDprinted"))== 1) ) THEN
	#{
		CUST.DD.DDprinted= BANCS.INPUT.DDprinted
		PRINT(CUST.DD.DDprinted)
	#}
	ELSE
	#{
		CUST.DD.DDprinted=""
		PRINT(CUST.DD.DDprinted)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("DDissueDate"))== 1) ) THEN
	#{
		CUST.DD.DDissueDate= BANCS.INPUT.DDissueDate
		PRINT(CUST.DD.DDissueDate)
	#}
	ELSE
	#{
		CUST.DD.DDissueDate=""
		PRINT(CUST.DD.DDissueDate)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("tranType"))== 1) ) THEN
	#{
		CUST.DD.tranType= BANCS.INPUT.tranType
		PRINT(CUST.DD.tranType)
	#}
	ELSE
	#{
		CUST.DD.tranType=""
		PRINT(CUST.DD.tranType)
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("TranID"))== 1) ) THEN
	#{
		CUST.DD.postTran= BANCS.INPUT.TranID
		PRINT(CUST.DD.postTran)
	#}
	ELSE
	#{
		CUST.DD.postTran=""
		PRINT(CUST.DD.postTran)
	#}
	ENDIF


	################################ Variable Inititalization#######################################################
	CUST.DD.Function= BANCS.INPUT.Function
	print(CUST.DD.Function)

	#----------------------------------------------------------------------------------
	#Function code validation
	#----------------------------------------------------------------------------------
	IF((CUST.DD.Function!="C") AND (CUST.DD.Function!="P") )THEN
	#{
   		CUST.DD.errMsg="Invalid Function code. valid[C - cancel,P - post]"
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF(CUST.DD.Function=="C")THEN
	#{
		IF((CUST.DD.DDprinted!="Y") AND (CUST.DD.DDprinted!="N"))THEN
		#{
   			CUST.DD.errMsg="Invalid DDprinted. valid[Y,N]"
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
		IF(CUST.DD.DDprinted=="N")THEN
		#{
			IF(CUST.DD.DDtranId=="")THEN
			#{
   				CUST.DD.errMsg="DDtranId is not available"
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF
			IF(CUST.DD.DDissueDate=="")THEN
			#{
   				CUST.DD.errMsg="DDissueDate is null"
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
			IF(CUST.DD.DemandDraftNo=="")THEN
			#{
   				CUST.DD.errMsg="DemandDraftNo is not available"
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF

		#}
		ENDIF

		IF(CUST.DD.CancelUserID!="")THEN
		#{
			sv_s = "usersolid|select SOL_ID from tbaadm.upr  "
			sv_s = sv_s + "where HOME_BANK_ID=?SVAR and user_id=?SVAR "
	
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.CancelUserID
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_r =  urhk_dbSelectWithBind(sv_s)
			print(sv_r)
			IF (sv_r ==0) THEN
			#{
				CUST.DD.usersolid= BANCS.OUTPARAM.usersolid
				print (CUST.DD.usersolid)
				IF(CUST.DD.DDprinted=="Y")THEN
				#{
					sv_s = "ddnum,issuedate,crncycode,ddamt|select dd_num,to_char(issue_date,'DD-MM-YYYY HH24:MI:SS'),dd_crncy_code,dd_amt from tbaadm.dst where "
					sv_s = sv_s + "bank_id=?SVAR and issu_br_code=?SVAR  "
					sv_s = sv_s + "and issu_bank_code='68' and trim(dd_num)=?SVAR and DD_STATUS='U'"
	
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.usersolid+ "|" + CUST.DD.DemandDraftNo 
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_r =  urhk_dbSelectWithBind(sv_s)
					print(sv_r)
					IF (sv_r ==0) THEN
					#{
						CUST.DD.ddnum= BANCS.OUTPARAM.ddnum
						print (CUST.DD.ddnum)
						CUST.DD.issuedate= BANCS.OUTPARAM.issuedate
						print (CUST.DD.issuedate)
						CUST.DD.crncycode= BANCS.OUTPARAM.crncycode
						print (CUST.DD.crncycode)
						CUST.DD.ddamt= BANCS.OUTPARAM.ddamt
						print (CUST.DD.ddamt)
					#}
					ELSE
					#{
   						CUST.DD.errMsg="Invalid demand draft No passed or belongs to a different sol"
						sv_t = "Msg| " +CUST.DD.errMsg
						sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
						sv_u = urhk_SetOrbOut(sv_t)
   						GOTO ENDSCRIPT
					#}
					ENDIF
				#}
				ELSE
				#{
					sv_s = "tranid,srlnum,ddDate,ddcrncy,ddamt|select tran_id, part_tran_srl_num,to_char(dd_date,'DD-MM-YYYY HH24:MI:SS'),dd_crncy_code,DD_AMT from tbaadm.ddc where "
					sv_s = sv_s + "bank_id=?SVAR  and type='C' and dd_date=to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + "and trim(tran_id)=?SVAR and trim(part_tran_srl_num)='1' and init_sol_id=?SVAR and stat!='C' "
					print(sv_s)
	
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.DDissueDate+ "|" + CUST.DD.DDtranId+ "|" + CUST.DD.usersolid
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_r =  urhk_dbSelectWithBind(sv_s)
					print(sv_r)
					IF (sv_r ==0) THEN
					#{
						CUST.DD.tranid= BANCS.OUTPARAM.tranid
						print (CUST.DD.tranid)
						CUST.DD.srlnum= BANCS.OUTPARAM.srlnum
						print (CUST.DD.srlnum)
						CUST.DD.crncycode= BANCS.OUTPARAM.ddcrncy
						print (CUST.DD.crncycode)
						CUST.DD.issuedate= BANCS.OUTPARAM.ddDate
						print (CUST.DD.issuedate)
						CUST.DD.ddamt= BANCS.OUTPARAM.ddamt
						print (CUST.DD.ddamt)

					#}
					ELSE
					#{
   						CUST.DD.errMsg="Invalid DDtranid passed or belongs to a different sol"
						sv_t = "Msg| " +CUST.DD.errMsg
						sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
						sv_u = urhk_SetOrbOut(sv_t)
   						GOTO ENDSCRIPT
					#}
					ENDIF
				#}
				ENDIF

			#}
			ELSE
			#{
   				CUST.DD.errMsg="Invalid UserID passed"
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF
		#}
		ELSE
		#{
   			CUST.DD.errMsg="CancelUserID is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}	
		ENDIF

		IF(CUST.DD.tranType=="")THEN
		#{
   			CUST.DD.errMsg="tranType is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF

		IF(CUST.DD.DDprinted=="Y")THEN
		#{
			sv_u = urhk_SetUrhkInp("ddBasicDtl.ddIssDate|"+ CUST.DD.issuedate)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.ddNum|"+ CUST.DD.ddnum)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.issBankBr.brCode|"+ CUST.DD.usersolid)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.issBankBr.bankCode|68")
			sv_u = urhk_SetUrhkInp("ddBasicDtl.tranType.code|" + CUST.DD.tranType)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.ddValueDate|" + BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp("ddCancelMiscDtl.nonSysDD|N")
			sv_u = urhk_SetUrhkInp("ddCancelMiscDtl.createChrgs|N")
			sv_u = urhk_SetUrhkInp("ddBasicDtl.instrmntDtl.instrmntDate|"+CUST.DD.issuedate)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.purCrncy.crncyCode|" + CUST.DD.crncycode)
		#}
		ELSE
		#{
			sv_u = urhk_SetUrhkInp("ddBasicDtl.ddIssDate|"+ CUST.DD.issuedate)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.pTranIdentifier.tranId|"+ CUST.DD.tranid)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.pTranIdentifier.partTranSrlNum|"+ CUST.DD.srlnum)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.issBankBr.brCode|"+ CUST.DD.usersolid)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.issBankBr.bankCode|68")
			sv_u = urhk_SetUrhkInp("ddBasicDtl.tranType.code|" + CUST.DD.tranType)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.ddValueDate|" + BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp("ddCancelMiscDtl.nonSysDD|N")
			sv_u = urhk_SetUrhkInp("ddCancelMiscDtl.createChrgs|N")
			#sv_u = urhk_SetUrhkInp("ddBasicDtl.instrmntDtl.instrmntDate|"+CUST.DD.issuedate)
			sv_u = urhk_SetUrhkInp("ddBasicDtl.purCrncy.crncyCode|" + CUST.DD.crncycode)
			sv_u =urhk_SetUrhkInp("tranMsgDtl.tranDetail.tranIdentifier.tranId|"+CUST.DD.tranid)

		#}
		ENDIF


		sv_u = urhk_ExecSrv("SRV_FetchDDForCancel|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
		IF(sv_u==0)THEN
		#{

			sv_u = urhk_CopyOutToIn("")
			IF(CUST.DD.DDprinted=="Y")THEN
			#{
				IF(CUST.DD.crncycode=="USD")THEN
				#{
					sv_u = urhk_SetUrhkOut("tranMsgDtl.tranDetail.tranIdentifier.tranId|tranId")
				#}
				ELSE
				#{
					sv_u = urhk_SetUrhkOut("tranMsgDtl.tranDetail.partTranDetailLL.<rec_0>.pTranIdentifier.tranId|tranId")
				#}
				ENDIF
			#}
			ELSE
			#{
				sv_u = urhk_SetUrhkOut("tranMsgDtl.tranDetail.tranIdentifier.tranId|tranId")
			#}
			ENDIF		

			sv_u = urhk_ExecSrv("SRV_CancelDD|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF(sv_u==0)THEN
			#{
				CUST.DD.tranId= trim(BANCS.OUTPARAM.tranId)
				#CUST.DD.tranId= "123"

				print (CUST.DD.tranId)
				
  				CUST.DD.errMsg="DD has been Successfully Cancelled. The Tran. ID created is " +CUST.DD.tranId+". The customer must be paid "+ CUST.DD.ddamt + " " + CUST.DD.crncycode
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Success")
				sv_k = "TranID| " +CUST.DD.tranId
				sv_u = urhk_SetOrbOut(sv_k)
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ELSE
			#{
				GOTO ERRORCHECK
			#}
			ENDIF
		#}
		ELSE
		#{
			GOTO ERRORCHECK
		#}
		ENDIF
	#}
	ENDIF



	IF(CUST.DD.Function =="P")THEN
	#{
		IF(CUST.DD.postTran=="")THEN
		#{
   			CUST.DD.errMsg="TranID is null"
			sv_t = "Msg| " +CUST.DD.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ELSE
		#{
			sv_s = "initsolid,tranid|select init_sol_id,tran_id from tbaadm.DDD "
			sv_s = sv_s + "WHERE bank_id=?SVAR and tran_date=to_date( ?SVAR ,'DD-MM-YYYY HH24:MI:SS') and trim(tran_id)=?SVAR"
	
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.BODDate + "|" + CUST.DD.postTran
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_r =  urhk_dbSelectWithBind(sv_s)
			print(sv_r)
			IF (sv_r ==0) THEN
			#{
				CUST.DD.initsolid= BANCS.OUTPARAM.initsolid
				print (CUST.DD.initsolid)
				CUST.DD.tranid= BANCS.OUTPARAM.tranid
				print (CUST.DD.tranid)

			#}
			ELSE
			#{
   				CUST.DD.errMsg="There is no mass issue transaction corresponding to the transaction ID [ " + CUST.DD.postTran+ " ]."
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ENDIF

			IF(CUST.DD.PostUserID=="")THEN
			#{
   				CUST.DD.errMsg="PostUserID is null"
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT
			#}
			ELSE
			#{
				sv_s = "usersolid|select SOL_ID from tbaadm.upr  "
				sv_s = sv_s + "where HOME_BANK_ID=?SVAR and user_id=?SVAR "
	
				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.PostUserID
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_r =  urhk_dbSelectWithBind(sv_s)
				print(sv_r)
				IF (sv_r ==0) THEN
				#{
					CUST.DD.usersolid= BANCS.OUTPARAM.usersolid
					print (CUST.DD.usersolid)
				#}
				ELSE
				#{
   					CUST.DD.errMsg="Invalid PostUserID"
					sv_t = "Msg| " +CUST.DD.errMsg
					sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO ENDSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

		#IF(CUST.DD.usersolid !=CUST.DD.initsolid)THEN
		#{
			#sv_u = urhk_SetUrhkInp("sol.solId|"+CUST.DD.initsolid)
		#	sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			#IF(sv_u !=0)THEN
			#{
   				#CUST.DD.errMsg="Failed to switch sol"
				#sv_t = "Msg| " +CUST.DD.errMsg
				#sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				#sv_u = urhk_SetOrbOut(sv_t)
   				#GOTO ENDSCRIPT
			#}
			#ENDIF
		#}
		#ELSE
		#{
   			#CUST.DD.errMsg="PostUserID belongs to a different sol from issuing sol"
			#sv_t = "Msg| " +CUST.DD.errMsg
			#sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			#sv_u = urhk_SetOrbOut(sv_t)
   			#GOTO ENDSCRIPT
		#}
		#ENDIF

		sv_u = urhk_SetUrhkInp("ddBasicDtl.pTranIdentifier.tranId|" + CUST.DD.tranid)	
		sv_u = urhk_SetUrhkInp("tranMsgDtl.tranDetail.tranIdentifier.tranId|" + CUST.DD.tranid)		

		sv_u = urhk_ExecSrv("SRV_FetchDDCancelTranForPosting|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranDate|"+ BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranId|" + CUST.DD.tranid)

			sv_u = urhk_ExecSrv("SRV_PostAnEnteredTransaction|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF(sv_u==0)THEN
			#{
				CUST.DD.Msg="The Tran. ID posted is " + trim(CUST.DD.postTran)
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
				sv_t = "TranID| " +CUST.DD.postTran
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "Msg| " +CUST.DD.Msg
				sv_u = urhk_SetOrbOut(sv_t)

				sv_u = urhk_SetUrhkInp("sol.solId|000")
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")

   				GOTO ENDSCRIPT
			#}
			ELSE
			#{
				GOTO ERRORCHECK
			#}
			ENDIF
	
		#}
		ELSE
		#{
			GOTO ERRORCHECK
		#}
		ENDIF
	#}
	ENDIF

	ERRORCHECK:		

	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>ddadd.log")
				print(sv_u)
				
				#Error response
				sv_t = "Msg | " +sv_e
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT
			#}
