        print(CUST.INTERFACE.DccId)

        sv_t=urhk_b2k_printrepos("BANCS")
        print(sv_t)

        IF( (FIELDEXISTS(("BANCS").("INPUT").("AcctList"))== 0) ) THEN
        #{
                CUST.EZB.errMsg="please enter account list"
        lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
                sv_u = urhk_SetOrbErr(sv_c)
                exitscript
        #}
        ENDIF

        IF( (FIELDEXISTS(("BANCS").("INPUT").("TotRec"))== 0) ) THEN
        #{
                CUST.EZB.errMsg="please enter Total Record to be Fetched"
        lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
                sv_u = urhk_SetOrbErr(sv_c)
                exitscript
        #}
        ENDIF

        #---------------------------------------------------------------------------------------------------------------
        # Variable Initialization
        #---------------------------------------------------------------------------------------------------------------

        CUST.EZB.inputRecord = ("BANCS").("INPUT").("AcctList")
        print(CUST.EZB.inputRecord)
        CUST.EZB.totRec = ("BANCS").("INPUT").("TotRec")
        print(CUST.EZB.totRec)
        lv_q = 0
        print(lv_q)
        CUST.EZB.totalBal = "0.0"
        CUST.EZB.errMsg = ""

        #----------------------------------------------------------------------------------------------
        # validations
        #----------------------------------------------------------------------------------------------

        lv_m = urhk_B2k_isStringNumeric(CUST.EZB.totRec)
        print(lv_m)

        IF(lv_m !=0)THEN
        #{
                CUST.EZB.errMsg = "Invalid Input ["+CUST.EZB.totRec+"] for TotRec Tag"
                lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
                sv_u = urhk_SetOrbErr(sv_c)
                exitscript
        #}
        ENDIF

        lv_z = CUST.EZB.inputRecord
    print(lv_z)
    lv_y = getposition(lv_z,",")
    print(lv_y)

    lv_x = 0

    WHILE(lv_y > 0)
    #{
        lv_x = lv_x + 1
        print(lv_x)

        CUST.EZB.inputRecord1 = CUST.EZB.inputRecord
        print(CUST.EZB.inputRecord1)

        sv_l = STRLEN (CUST.EZB.inputRecord1)
        print(sv_l)
        sv_l = sv_l - lv_y
        print(sv_l)

        lv_z = mid$(lv_z,lv_y,sv_l)
        print(lv_z)
        CUST.EZB.inputRecord1 = lv_z
        print(CUST.EZB.inputRecord1)

        lv_y = getposition(lv_z,",")
        print(lv_y)
    #}
    DO

    lv_x = lv_x + 1
    print(lv_x)

    IF(lv_x != CUST.EZB.totRec)THEN
    #{
        CUST.EZB.errMsg="Account List Passed does not Match TotRec tag!!"
        lv_a = "E9999"
        lv_e = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(lv_e)
        exitscript
    #}
    ENDIF

        WHILE( lv_q < CUST.EZB.totRec )
        #{
                lv_q = lv_q + 1
                print(lv_q)

                CUST.EZB.created_flg =""
                CUST.EZB.del_flg =""
                CUST.EZB.acctCloseflg=""

                sv_v = "rec_" + FORMAT$(lv_q, "%d")

                IF(lv_q == 1)THEN
                #{
                        sv_c = CUST.EZB.inputRecord
                        print(sv_c)
                        sv_q = getposition(sv_c,",")
                        print(sv_q)

                        IF(sv_q > 0)THEN
                        #{
                                ("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
                                print(("CUST").("EZB").(sv_v))
                        ELSE
                                ("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
                                print(("CUST").("EZB").(sv_v))
                        #}
                        ENDIF
                ELSE
                        sv_q = getposition(sv_c,",")
                        print(sv_q)

                        IF(sv_q > 0)THEN
                        #{
                                sv_l = STRLEN (CUST.EZB.inputRecord)
                                print(sv_l)
                                print(CUST.EZB.inputRecord)
                                sv_l = sv_l - sv_q
                                print(sv_l)
                                sv_c = mid$(sv_c,sv_q,sv_l)
                                print(sv_c)
                                CUST.EZB.inputRecord = sv_c
                                print(CUST.EZB.inputRecord)

                                sv_q = getposition(sv_c,",")
                                print(sv_q)

                                ("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
                                print(("CUST").("EZB").(sv_v))

                                IF(lv_q == CUST.EZB.totRec)THEN
                                #{
                                        ("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
                                        print(("CUST").("EZB").(sv_v))
                                #}
                                ENDIF
                        ELSE
                                ("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
                                print(("CUST").("EZB").(sv_v))
                        #}
                        ENDIF
                #}
                ENDIF

                IF( ("CUST").("EZB").(sv_v) != "")THEN
                #{
                        sv_q = "created_flg, del_flg|"
                        sv_q = sv_q + "SELECT ENTITY_CRE_FLG, DEL_FLG FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR "
                        print(sv_q)

                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ ("CUST").("EZB").(sv_v)
                        print(BANCS.INPARAM.BINDVARS)

                        lv_s = urhk_dbSelectWithBind(sv_q)
                        print(lv_s)

                        IF(lv_s == 0)THEN
                        #{
                                CUST.EZB.created_flg = BANCS.OUTPARAM.created_flg
                                print(CUST.EZB.created_flg)
                                CUST.EZB.del_flg = BANCS.OUTPARAM.del_flg
                                print(CUST.EZB.del_flg)
                        ELSE
                                CUST.EZB.created_flg = ""
                                CUST.EZB.del_flg = ""
                        #}
                        ENDIF

                        sv_a = urhk_getAcctDetailsInRepository(trim(("CUST").("EZB").(sv_v)))
                        print(sv_a)

                        IF(sv_a == 0)THEN
                        #{
                                CUST.EZB.acctOwnerShip = trim(BANCS.OUTPARAM.acctOwnerShip)
                                print(CUST.EZB.acctOwnerShip)
                                CUST.EZB.acctCloseflg = trim(BANCS.OUTPARAM.acctCloseflg)
                                print(CUST.EZB.acctCloseflg)
                                #-------
                                CUST.INTERFACE.schmType = BANCS.OUTPARAM.schmType
                                print(CUST.INTERFACE.schmType)
                                #------
                                IF((CUST.EZB.created_flg =="Y") AND (CUST.EZB.del_flg =="N") AND (CUST.EZB.acctCloseflg =="N") )THEN
                                #{
                                        CUST.EZB.availableAmt = trim(BANCS.OUTPARAM.AvailableAmt)
                                        print(CUST.EZB.availableAmt)


                                        CUST.EZB.EffAvailableAmt = trim(BANCS.OUTPARAM.EffAvailableAmt)
                                        print(CUST.EZB.EffAvailableAmt)

                                        CUST.EZB.acctName = trim(BANCS.OUTPARAM.acctName)
                                        print(CUST.EZB.acctName)

                                        CUST.EZB.unclearBalance = trim(BANCS.OUTPARAM.unclearBalance)
                                        print(CUST.EZB.unclearBalance)
                                        CUST.EZB.clearBalance = trim(BANCS.OUTPARAM.clearBalance)
                                        print(CUST.EZB.clearBalance)
                                        CUST.EZB.drawingPower = trim(BANCS.OUTPARAM.drawingPower)
                                        print(CUST.EZB.drawingPower)

                                        CUST.EZB.currency = trim(BANCS.OUTPARAM.acctCrncyCode)
                                        print(CUST.EZB.currency)
                                        CUST.EZB.lienAmt = trim(BANCS.OUTPARAM.lienAmt)
                                        print(CUST.EZB.lienAmt)

                                        CUST.EZB.totalBal = CUST.EZB.clearBalance
                                        print(CUST.EZB.totalBal)

                                        lv_u = urhk_B2k_ForacidToAcid( ("CUST").("EZB").(sv_v) )
                            print(lv_u)

                            if(lv_u == 0)then
                            #{
                                BANCS.INPARAM.acid = BANCS.OUTPARAM.Acid
                                                print(BANCS.INPARAM.acid)

                                lv_t = urhk_getAcctStatus("")
                                print(lv_t)

                                if(lv_t == 0)then
                                #{
                                    CUST.EZB.acctStatus = BANCS.OUTPARAM.acctStatus
                                    print(CUST.EZB.acctStatus)
                                                        CUST.EZB.acctStatusDesc = ""

                                    IF(CUST.EZB.acctStatus == "A")THEN
                                    #{
                                        CUST.EZB.acctStatusDesc = "Active"
                                    #}
                                    ENDIF
                                    IF(CUST.EZB.acctStatus == "D")THEN
                                    #{
                                        CUST.EZB.acctStatusDesc = "Dormant"
                                    #}
                                    ENDIF
                                    IF(CUST.EZB.acctStatus == "I")THEN
                                    #{
                                        CUST.EZB.acctStatusDesc = "In Active"
                                    #}
                                    ENDIF
                                ELSE
                                        CUST.EZB.acctStatusDesc = ""
                            #}
                            ENDIF
                        ELSE
                                CUST.EZB.errMsg = "Invalid Account ^"+("CUST").("EZB").(sv_v) +"^"
                                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                                        sv_t = "Message | " +CUST.EZB.errMsg
                                        sv_u = urhk_SetOrbOut(sv_t)
                    #}
                    ENDIF

                                        lv_p= " "

                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccountID| " + ("CUST").("EZB").(sv_v)
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccountName| " + CUST.EZB.acctName
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.UnclearBalance| " + CUST.EZB.unclearBalance
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AvailableAmt| " + CUST.EZB.availableAmt
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.EffAvailableAmt| " + CUST.EZB.EffAvailableAmt
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DrawingPower| " + CUST.EZB.drawingPower
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.Currency| " + CUST.EZB.currency
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccountStatus| " + CUST.EZB.acctStatus
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccountStatusDescription| " + CUST.EZB.acctStatusDesc
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.TotalBalance| " + CUST.EZB.totalBal
                                        sv_u = urhk_SetOrbOut(sv_t)
                                        ###### 08/10/2025 Added by Kaviraj ########

                                        IF((CUST.INTERFACE.DccId =="POL") and (BANCS.STDIN.contextBankId=="54")) THEN
                                        #{
                                        IF((CUST.INTERFACE.schmType =="ODA") OR (CUST.INTERFACE.schmType =="LAA")) THEN
                                        #{
                                                BANCS.INPUT.foracid=("CUST").("EZB").(sv_v)
                                                print(BANCS.INPUT.foracid)

                                                    call("ezb_limit.scr")
                                                    sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.ODLimit| " + CUST.INTERFACE.odLimit
                                                    sv_u = urhk_SetOrbOut(sv_t)
                                                    sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.ODExpiry| " + CUST.INTERFACE.odExpiry
                                                    sv_u = urhk_SetOrbOut(sv_t)
                                                    sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.ODUtilized| " + CUST.INTERFACE.utilizedAmt
                                                    sv_u = urhk_SetOrbOut(sv_t)
                                                    sv_t = "AccountSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.ODAvailable| " + CUST.INTERFACE.availODAmt
                                                    sv_u = urhk_SetOrbOut(sv_t)
                                        #}
                                        ENDIF
                                        #}
                                        ENDIF
                                        ###### 08/10/2025 END ########
                                ELSE
                                        IF(CUST.EZB.created_flg =="N")THEN
                                                CUST.EZB.errMsg = "Account creation not yet authorised : "+ ("CUST").("EZB").(sv_v)
                                        ENDIF
                                        IF(CUST.EZB.del_flg =="Y")THEN
                                                CUST.EZB.errMsg = "The record is deleted : "+("CUST").("EZB").(sv_v)
                                        ENDIF
                                        IF(CUST.EZB.acctCloseflg =="Y")THEN
                                                CUST.EZB.errMsg = "Account has been closed : "+ ("CUST").("EZB").(sv_v)
                                        ENDIF

                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                                sv_t = "Message | " +CUST.EZB.errMsg
                                sv_u = urhk_SetOrbOut(sv_t)
                                #}
                                ENDIF
                        ELSE
                                CUST.EZB.errMsg = "Invalid Account ^" +("CUST").("EZB").(sv_v) +"^"
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                        sv_t = "Message | " +CUST.EZB.errMsg
                        sv_u = urhk_SetOrbOut(sv_t)
                        #}
                        ENDIF
                ELSE
                        CUST.EZB.errMsg = "Error occured!! Kindly Contact Administrator"
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_t = "Message | " +CUST.EZB.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                #}
                ENDIF
        #}
        DO

trace off
