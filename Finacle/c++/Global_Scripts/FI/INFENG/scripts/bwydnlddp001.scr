#-------------------------------------------------------------------------------------
#    Name		: bwydnlddp001.scr
#    Description	: The script is used to hardcode StartDate and EndDate
#    Date            	: 16-02-2013
#    Author          	: Saurabh Sinha
#    Input           	: NA
#    Output		: NA
#    Called Script	: NA 
#    Calling Script	: getcparamvalue.scr
#    Menu Option	: HBDTM 
#    Srl. No		Date			Author			Description.   
#    -------		----			------			----------------
#    1.0		16-02-2013		Saurabh	 		Original Version
#-------------------------------------------------------------------------------------
<--START
TRACE ON
#------------------------------------------------------------------------------
#       Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","BDTM") == 0) THEN
#{
	CREATECLASS("CUST","BDTM",5)
#}
ENDIF

IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
#{
	CREATECLASS("CUST","CPARAM",5)
#}
ENDIF

#------------------------------------------------------------------------------
#       Initializing the required variables
#------------------------------------------------------------------------------
CUST.BDTM.errMsg        = ""
CUST.BDTM.grpSeqId      = " "
#------------------------------------------------------------------------------
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
BANCS.INPUT.moduleName  = "CIF_FOR_CUST"
BANCS.INPUT.parameterId = "END_DATE"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.endDate = BANCS.OUTPUT.parameterVal
	CUST.BDTM.endDate   = CUST.CPARAM.endDate
	PRINT(CUST.CPARAM.endDate)
#}
ELSE
#{
	CUST.BDTM.errMsg = "End Date setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName  = "CIF_FOR_CUST"
BANCS.INPUT.parameterId = "EXT_DAY"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.CPARAM.extDay = BANCS.OUTPUT.parameterVal
	PRINT(CUST.CPARAM.extDay)
#}
ELSE
#{
	CUST.BDTM.errMsg = "extDay setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

#------------------------------------------------------------------------------
#       SQL query for sysdate-31 
#------------------------------------------------------------------------------
sv_s = "systDate|"
sv_s = sv_s + " SELECT TO_CHAR(SYSDATE - "
sv_s = sv_s + CUST.CPARAM.extDay +" ,'dd-mm-yyyy') FROM DUAL"
print(sv_s)
sv_d =urhk_dbSelectWithBind(sv_s)
IF (sv_d == 0) THEN
#{
	CUST.BDTM.startDate = BANCS.OUTPARAM.systDate
#}
ELSE
#{
	CUST.BDTM.errMsg = "Error while calculating Start Date"
	GOTO ENDOFSCRIPT
#}
ENDIF
sv_b = BANCS.STDIN.contextBankId
IF (sv_b == "55") THEN
#{
    BANCS.INPUT.moduleName = "CIF_FOR_CUST"
    BANCS.INPUT.parameterId = "STRT_DATE"
    CALL ("getcparamvalue.scr")
    IF (BANCS.OUTPUT.parameterVal != "") THEN
    #{
        CUST.BDTM.startDate = BANCS.OUTPUT.parameterVal
        PRINT(CUST.BDTM.startDate)
    #}
    ELSE
    #{
        CUST.BDTM.errMsg = "startDate setup not done in CPARAM"
        GOTO ENDOFSCRIPT
    #}
    ENDIF

    BANCS.INPUT.moduleName = "CIF_FOR_CUST"
    BANCS.INPUT.parameterId = "GRP_SEQ_ID"
    CALL ("getcparamvalue.scr")
    IF (BANCS.OUTPUT.parameterVal != "") THEN
    #{
        CUST.BDTM.grpSeqId= BANCS.OUTPUT.parameterVal
        PRINT(CUST.BDTM.grpSeqId)
    #}
    ELSE
    #{
        CUST.BDTM.errMsg = "grpSeqId setup not done in CPARAM"
        GOTO ENDOFSCRIPT
    #}
    ENDIF
#}
ENDIF

sv_a = "startDate|" + CUST.BDTM.startDate
sv_u = urhk_SetOrbOut(sv_a)
sv_a = "endDate|" + CUST.BDTM.endDate 
sv_u = urhk_SetOrbOut(sv_a)
print(sv_u)
sv_a = "bankId|" + BANCS.STDIN.contextBankId
sv_u = urhk_SetOrbOut(sv_a)
sv_a = "grpSeqId|" + CUST.BDTM.grpSeqId
sv_u = urhk_SetOrbOut(sv_a)

ENDOFSCRIPT:
#---------------------------------------------------------------------
# Error Logging 
#---------------------------------------------------------------------
IF (CUST.BDTM.errMsg != "") THEN
#{
	sv_u = urhk_SetOrbOut("Error|"+CUST.BDTM.errMsg)
#}
ENDIF

EXITSCRIPT
TRACE OFF
END-->
