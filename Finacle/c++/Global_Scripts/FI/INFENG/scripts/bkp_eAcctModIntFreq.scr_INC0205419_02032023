<--START
CHECKSUM="241077deeab9cbb9e4c1515546cbf9adfad83c186db837736eac8aa8569ed600"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTSS") == 0) THEN
	#{
		CREATEREP("CUSTSS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTSS","CDAAA") == 0) THEN
	#{
		CREATECLASS("CUSTSS","CDAAA",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTSS","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUSTSS","CPARAM", 5)
	#}
	ENDIF
	CUSTSS.CDAAA.FreeCode6=""
	print(CUSTSS.CDAAA.FreeCode6)
	######
		CUSTSS.CDAAA.boddate = mid$(BANCS.STDIN.BODDate,0,10)
		print(CUSTSS.CDAAA.boddate)
		sv_s = "boddate|"
		sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-RRRR')),'DD-MON-RRRR') as boddate "
		sv_s = sv_s + " FROM DUAL"
		BANCS.INPARAM.BINDVARS = CUSTSS.CDAAA.boddate
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
			CUSTSS.CDAAA.boddate = BANCS.OUTPARAM.boddate
			print(CUSTSS.CDAAA.boddate)
		ENDIF
	######
	CUSTSS.CDAAA.freeT15 = "GROUP"
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTSS.CDAAA.errMsg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="solid,foracid,acid,schmcode,schmtype,sweeps,mngruserid|"
	sv_s = sv_s + " select g.sol_id,g.foracid,g.acid,g.schm_code,g.schm_type,g.allow_sweeps, "
	sv_s = sv_s + " (SELECT  Roleu.USER_ID FROM tbaadm.get EMPu, tbaadm.upr ROLEu WHERE EMPu.EMP_ID = ROLEu.USER_EMP_ID and roleu.del_flg='N' and empu.del_flg='N' and roleu.ROLE_ID!='DEL' "
	sv_s = sv_s + " and  ROLEu.USER_WORK_CLASS ='200'  AND g.sol_id=Roleu.SOL_ID  and g.sol_id=Roleu.sol_id and rownum<2) as mngruser_id " 
	sv_s = sv_s + " from CUSTOM.INT_CHANGE d,tbaadm.gam g where "
	sv_s = sv_s + " g.bank_id = d.bank_id and d.foracid = g.foracid "
	sv_s = sv_s + " and d.bank_id =?SVAR and g.acct_ownership ='C' and d.ENTITY_CRE_FLG='M' and d.sol_id =?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
#	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_e = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_e)

	IF(sv_e == 0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		IF(sv_q == 1) THEN
		#{
			sv_x = urhk_dbCursorClose(sv_m)
			print(sv_x)
			CUSTSS.CDAAA.errMsg ="No Data."
			sv_e=urhk_SetOrbOut("StattusCode|Error")
			sv_e=urhk_SetOrbOut("Error|"+CUSTSS.CDAAA.errMsg )
			EXITSCRIPT
		#}
		ENDIF
		print(sv_q)

	WHILE (sv_q==0)

		CUSTSS.CDAAA.foracid    = BANCS.OUTPARAM.foracid
                PRINT(CUSTSS.CDAAA.foracid)
		CUSTSS.CDAAA.acid	= BANCS.OUTPARAM.acid
		PRINT(CUSTSS.CDAAA.acid)
		CUSTSS.CDAAA.schmtype	= BANCS.OUTPARAM.schmtype
		PRINT(CUSTSS.CDAAA.schmtype)
		CUSTSS.CDAAA.schmcode	= BANCS.OUTPARAM.schmcode
		PRINT(CUSTSS.CDAAA.schmcode)
		CUSTSS.CDAAA.sweeps	= BANCS.OUTPARAM.sweeps
		PRINT(CUSTSS.CDAAA.sweeps)
		CUSTSS.CDAAA.solid	= BANCS.OUTPARAM.solid
		PRINT(CUSTSS.CDAAA.solid)			
		CUSTSS.CDAAA.mngruserid	 =   BANCS.OUTPARAM.mngruserid
		PRINT(CUSTSS.CDAAA.mngruserid)

		IF (CUSTSS.CDAAA.sweeps == "") THEN
		#{
			CUSTSS.CDAAA.sweeps = "N"
		#}
		ENDIF
		
		IF(CUSTSS.CDAAA.solid != BANCS.STDIN.mySolId)THEN
		#{
			sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTSS.CDAAA.solid)
			print(sv_u)
			sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			print(sv_u)
		#}
		ENDIF

			
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account Modify services
			# urhk_SetUrhkInp is used to set inputs
			#--------------------------------------------------------------------------------------------------------------
			
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTSS.CDAAA.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTSS.CDAAA.acid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTSS.CDAAA.schmtype)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTSS.CDAAA.schmcode)
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_FetchODAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
                        PRINT(sv_u)

			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTSS.CDAAA.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTSS.CDAAA.acid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTSS.CDAAA.schmtype)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTSS.CDAAA.schmcode)
				PRINT(sv_u)			
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|"+CUSTSS.CDAAA.sweeps)
                                PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psNextPrintDate|02-04-2023")
				PRINT(sv_u)			
				
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
				PRINT(sv_u)
				sv_a = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqDr.type|W")
				print(sv_a)
				sv_u = urhk_ExecSrv("SRV_ModifyODAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				print(sv_u)
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_u = system("echo 'Error for Acct:"+CUSTSS.CDAAA.foracid+" ' >>acctivated.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						print(sv_f)
						IF (FIELDEXISTS(("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)) == 1) THEN
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							print(sv_e)
							IF (FIELDEXISTS(("BANCS").("OUTPARAM").("Tag_"+sv_f)) == 1) THEN
								sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
								print(sv_e)
								sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
								print(sv_e)
								sv_i = sv_i + 1
								sv_u = system("echo '"+sv_e+"' >>acctivated.log")
								print(sv_u)
								#####
								IF (FIELDEXISTS(sv_e) == 1) THEN
									if (sv_e!="") Then
										CUSTSS.CDAAA.errorsact = sv_e
										print(CUSTSS.CDAAA.errorsact)
										sv_s = " INSERT INTO "
										sv_s = sv_s + " custom.all_activation_errors  "
										sv_s = sv_s + " ( "
										sv_s = sv_s + " FORACID, "
										sv_s = sv_s + " SOL_ID, "
										sv_s = sv_s + " BOD_DATE,ERRORS, "
										sv_s = sv_s + " SYSDATE_TIME ) "
										sv_s = sv_s + " values "
										sv_s = sv_s + " ( "
										sv_s = sv_s + " ?SVAR, "
										sv_s = sv_s + " ?SVAR, "
										sv_s = sv_s + " ?SVAR ,?SVAR , sysdate )"
										print(sv_s)
										BANCS.INPARAM.BINDVARS = CUSTSS.CDAAA.foracid +"|"+ CUSTSS.CDAAA.solid +"|"+ CUSTSS.CDAAA.boddate +"|"+ CUSTSS.CDAAA.errorsact 
										print(BANCS.INPARAM.BINDVARS)
										sv_d = urhk_dbSqlWithBind(sv_s)
										If (sv_d == 0) then
											print("Insert done")
										ENDIF
									endif
								ENDIF
							ELSE
								sv_i = sv_i + 1
								print(sv_i)
							ENDIF
						ELSE
							sv_i = sv_i + 1
							print(sv_i)
						ENDIF
						####
					#}
					DO
				#}
				ENDIF

				sv_s = "UPDATE CUSTOM.INT_CHANGE "
				sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'N',"
				sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
				sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
				sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUSTSS.CDAAA.foracid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			else
			#{
				sv_s = "UPDATE CUSTOM.INT_CHANGE "
				sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'N',"
				sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
				sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
				sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUSTSS.CDAAA.foracid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				endif
			#}
			ENDIF
			
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)	
	#}
	DO
		
	#}
	ENDIF
	
	ENDOFSCRIPT:
	IF(CUSTSS.CDAAA.errMsg != "") THEN
	#{
		sv_u = system("echo '"+CUSTSS.CDAAA.errMsg+"' >>acctivated.log")
	#}
	ENDIF
EXITSCRIPT
