			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>IntraModSI.log")
				print(sv_u)
				
				#Error response
				sv_t = "ERROR | " +sv_e
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			DO
			#}
		ENDIF
	#}
	ENDIF


ENDSCRIPT:

