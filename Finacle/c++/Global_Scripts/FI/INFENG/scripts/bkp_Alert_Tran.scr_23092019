			sv_s = "PHONENO,trandate,ACCT_NAME,transacAccount,acctownership| select substr(PHONENO,-9) as PHONENO ,(select TO_CHAR(db_stat_date, 'DD-Mon-RRRR') from tbaadm.gct where bank_id= ?SVAR) as TRAN_DATE,(SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1)) as ACCT_NAME,gam.foracid as transacAccount,ACCT_OWNERSHIP from crmuser.phoneemail p ,tbaadm.gam  "
