<--START
TRACE ON
        #------------------------------------#
        #-- Repository And Class Creation  --#
        #------------------------------------#



		IF(REPEXISTS("CUST") == 0) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF

		IF (CLASSEXISTS("CUST", "CBAL") == 0) THEN
		#{
			CREATECLASS("CUST", "CBAL", 5)
		#}
		ENDIF	


		sv_q = urhk_B2k_PrintRepos("BANCS")
		print(sv_q)



	sv_s="AMTSRLNUM|"
	sv_s = sv_s + " SELECT AMT_DERV_SRL_NUM FROM TBAADM.PTT WHERE "
	sv_s = sv_s + " BANK_ID=?SVAR AND EVENT_TYPE='INQFE' AND EVENT_ID='BCERT' "
	print(sv_s)

	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)

	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d==0)THEN
	#{
		print(BANCS.OUTPARAM.AMTSRLNUM)
		CUST.CBAL.AMTSRLNUM= BANCS.OUTPARAM.AMTSRLNUM
		PRINT(CUST.CBAL.AMTSRLNUM)

		sv_s="CRNCY, AMT|"
		sv_s = sv_s + " select crncy_code, TO_CHAR(fixed_amt)  FROM TBAADM.TBA_AMT_DRV_METHOD_TBL WHERE "
		sv_s = sv_s + " amt_drv_srl_num=?SVAR AND bank_id =?SVAR "
		print(sv_s)

		BANCS.INPARAM.BINDVARS =  CUST.CBAL.AMTSRLNUM + "|" +BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d==0)THEN
		#{
			CUST.CBAL.CRNCY= BANCS.OUTPARAM.CRNCY
			PRINT(CUST.CBAL.CRNCY)

			CUST.CBAL.AMT= BANCS.OUTPARAM.AMT
			PRINT(CUST.CBAL.AMT)

			#----------------------------------------------------------------------------------------------
			# CHARGE CALCULATION
			#----------------------------------------------------------------------------------------------

			CUST.CBAL.CHARGEAMT= CUST.CBAL.AMT
			print(CUST.CBAL.CHARGEAMT)	

			CUST.CBAL.comm = CINT(CUST.CBAL.CHARGEAMT) * 0.2
			print(CUST.CBAL.comm)
			CUST.CBAL.comm = CINT(CUST.CBAL.comm)
			PRINT(CUST.CBAL.comm)

			CUST.CBAL.exduty= "0"
			PRINT(CUST.CBAL.exduty)

	
			CUST.CBAL.totaldeductions = (CINT(CUST.CBAL.CHARGEAMT) + CINT(CUST.CBAL.comm) + CINT(CUST.CBAL.exduty))
			print(CUST.CBAL.totaldeductions)

			#----------------------------------------------------------------------------------------------
			# SENDING RESPONSE
			#----------------------------------------------------------------------------------------------
			sv_t = "BalCertFee| " +CUST.CBAL.AMT
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "BalCertComm| " + CUST.CBAL.comm
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "BalCertDuty| " + CUST.CBAL.exduty
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "Currency| " + CUST.CBAL.CRNCY
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "TotalBalCertFee| " + CUST.CBAL.totaldeductions 
			sv_u = urhk_SetOrbOut(sv_t)




		#}
		ELSE
		#{
			PRINT("DB ERROR")
		#}
		ENDIF


	#}
	ELSE
	#{
		Print("DB error")
	#}
	ENDIF




TRACE OFF
END-->