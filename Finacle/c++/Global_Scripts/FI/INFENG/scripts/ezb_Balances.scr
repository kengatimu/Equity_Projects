#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("AcctList"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="please enter account list"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "MSG | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("TotRec"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please enter account list"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "MSG | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.EZB.inputRecord = ("BANCS").("INPUT").("AcctList")
	print(CUST.EZB.inputRecord)
	CUST.EZB.totRec = ("BANCS").("INPUT").("TotRec")
	print(CUST.EZB.totRec)
	lv_q = 0
	print(lv_q)

	#----------------------------------------------------------------------------------------------
	# validations
	#----------------------------------------------------------------------------------------------

	lv_m = urhk_B2k_isStringNumeric(CUST.EZB.totRec)
	print(lv_m)

	IF(lv_m !=0)THEN
	#{
		CUST.EZB.errMsg = "Invalid Input ["+CUST.EZB.totRec+"] for TotRec Tag"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "MSG | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF

	lv_z = CUST.EZB.inputRecord
    print(lv_z)
    lv_y = getposition(lv_z,",")
    print(lv_y)

    lv_x = 0

    WHILE(lv_y > 0)
    #{
        lv_x = lv_x + 1
        print(lv_x)

        CUST.EZB.inputRecord1 = CUST.EZB.inputRecord
        print(CUST.EZB.inputRecord1)

        sv_l = STRLEN (CUST.EZB.inputRecord1)
        print(sv_l)
        sv_l = sv_l - lv_y
        print(sv_l)

        lv_z = mid$(lv_z,lv_y,sv_l)
        print(lv_z)
        CUST.EZB.inputRecord1 = lv_z
        print(CUST.EZB.inputRecord1)

        lv_y = getposition(lv_z,",")
        print(lv_y)
    #}
    DO

	lv_x = lv_x + 1
    print(lv_x)

    IF(lv_x != CUST.EZB.totRec)THEN
    #{
        CUST.EZB.errMsg="Account List Passed does not Match TotRec tag!!"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "MSG | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
    #}
    ENDIF

	WHILE( lv_q < CUST.EZB.totRec )
	#{
		lv_q = lv_q + 1
		print(lv_q)

		sv_v = "rec_" + FORMAT$(lv_q, "%d")
		
		IF(lv_q == 1)THEN
		#{
			
			sv_c = CUST.EZB.inputRecord
			print(sv_c)
			sv_q = getposition(sv_c,",")
			print(sv_q)

			IF(sv_q > 0)THEN
			#{
				("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
				print(("CUST").("EZB").(sv_v))
			ELSE 
				("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
				print(("CUST").("EZB").(sv_v))
			#}
			ENDIF 
		ELSE
			sv_q = getposition(sv_c,",")
			print(sv_q)

			IF(sv_q > 0)THEN
			#{
				sv_l = STRLEN (CUST.EZB.inputRecord)
				print(sv_l)
				print(CUST.EZB.inputRecord)
				sv_l = sv_l - sv_q
				print(sv_l)
				sv_c = mid$(sv_c,sv_q,sv_l)
				print(sv_c)
				CUST.EZB.inputRecord = sv_c

				print(CUST.EZB.inputRecord)
				sv_q = getposition(sv_c,",")
				print(sv_q)

				("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
				print(("CUST").("EZB").(sv_v))

				IF(lv_q == CUST.EZB.totRec)THEN
				#{
					("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
					print(("CUST").("EZB").(sv_v))
				#}
				ENDIF
			ELSE 
				("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
				print(("CUST").("EZB").(sv_v))
			#}
			ENDIF 
		#}
		ENDIF

		IF( ("CUST").("EZB").(sv_v) != "")THEN
		#{
			sv_q = "created_flg, del_flg|"
			sv_q = sv_q + "SELECT ENTITY_CRE_FLG, DEL_FLG FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR "
			print(sv_q)

			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ ("CUST").("EZB").(sv_v)
			print(BANCS.INPARAM.BINDVARS)

			lv_s = urhk_dbSelectWithBind(sv_q)
			print(lv_s)

			IF(lv_s == 0)THEN
			#{
				CUST.EZB.created_flg = BANCS.OUTPARAM.created_flg
				print(CUST.EZB.created_flg)
				CUST.EZB.del_flg = BANCS.OUTPARAM.del_flg
				print(CUST.EZB.del_flg)
			ELSE 
				CUST.EZB.created_flg = ""
				CUST.EZB.del_flg = ""
			#}
			ENDIF

			sv_a = urhk_getAcctDetailsInRepository(trim(("CUST").("EZB").(sv_v)))
			print(sv_a)

			IF(sv_a == 0)THEN
			#{
				CUST.EZB.acctOwnerShip = trim(BANCS.OUTPARAM.acctOwnerShip)
				print(CUST.EZB.acctOwnerShip)

				CUST.EZB.availableAmt = trim(BANCS.OUTPARAM.AvailableAmt)
				print(CUST.EZB.availableAmt)

				CUST.EZB.acctName = trim(BANCS.OUTPARAM.acctName) 
				print(CUST.EZB.acctName)

				CUST.EZB.acctCloseflg = trim(BANCS.OUTPARAM.acctCloseflg)
				print(CUST.EZB.acctCloseflg)

				CUST.EZB.unclearBalance = trim(BANCS.OUTPARAM.unclearBalance)
				print(CUST.EZB.unclearBalance)

				CUST.EZB.drawingPower = trim(BANCS.OUTPARAM.drawingPower)
				print(CUST.EZB.drawingPower)

				CUST.EZB.currency = trim(BANCS.OUTPARAM.acctCrncyCode)
				print(CUST.EZB.currency)

				IF((CUST.EZB.created_flg =="Y") AND (CUST.EZB.del_flg =="N") AND (CUST.EZB.acctCloseflg =="N") )THEN
				#{
					lv_a  = STRLEN(CUST.EZB.acctName)
					print(lv_a)

					IF(lv_a > 40)THEN
						lv_b = Left$(CUST.EZB.acctName, 40)
						print(lv_b)
						CUST.EZB.acctName = lv_b
						print(CUST.EZB.acctName)
						lv_a  = STRLEN(CUST.EZB.acctName)
						print(lv_a)
					ENDIF

					sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccountID| " + ("CUST").("EZB").(sv_v)
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccountName| " + CUST.EZB.acctName
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.UnclearBalance| " + CUST.EZB.unclearBalance
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AvailableAmt| " + CUST.EZB.availableAmt
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DrawingPower| " + CUST.EZB.drawingPower
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.Currency| " + CUST.EZB.currency
					sv_u = urhk_SetOrbOut(sv_t)
				ELSE
					IF(CUST.EZB.created_flg =="N")THEN
						CUST.EZB.errMsg = "Account creation not yet authorised : "+ ("CUST").("EZB").(sv_v)
					ENDIF
					IF(CUST.EZB.del_flg =="Y")THEN
						CUST.EZB.errMsg = "The record is deleted : "+("CUST").("EZB").(sv_v)
					ENDIF
					IF(CUST.EZB.acctCloseflg =="Y")THEN
						CUST.EZB.errMsg = "Account has been closed : "+ ("CUST").("EZB").(sv_v)
					ENDIF

					#sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
			        #sv_u = urhk_SetOrbOut("ErrorCode|E9999")
			        sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.Error | " +CUST.EZB.errMsg
			        sv_u = urhk_SetOrbOut(sv_t)
				#}
				ENDIF
			ELSE 
				lv_c = "Error occured getting account details"
				sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.Error| " + lv_c
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ENDIF
		ELSE 
			lv_c = "Error occured!! Kindly Contact Administrator"
			sv_t = "AccountBalance_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.Error| " + lv_c
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF
	#}
	DO
trace off
END-->

