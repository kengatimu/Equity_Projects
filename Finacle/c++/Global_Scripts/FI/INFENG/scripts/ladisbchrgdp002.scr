<--START
CHECKSUM="d30f8349b3ac5c4aaf407f5569aae1938f2c103ba7289e23ab49c30a946bb527"
	TRACE ON
	
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "LADISB")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "LADISB", 5)
	#}
	ENDIF
	
	
	CUST.LADISB.accId = ""
	CUST.LADISB.acctName = ""
	CUST.LADISB.tranPart = ""
	CUST.LADISB.ccy = ""
	CUST.LADISB.tranAmt = ""
	CUST.LADISB.indicator = ""
	
	
	PRINT(BANCS.INPUT.loanAct)
sv_p='"'	
	sv_s ="accId,acctName,tranPart,ccy,tranAmt,indicator|"
	sv_s = sv_s + " SELECT ACCT_ID,replace(acct_name,'"+sv_p+"','') ,TRAN_PARTICULARS,"
	sv_s = sv_s + " CCY,TRAN_AMT,INDICATOR FROM CUSTOM.DISRT "
	sv_s = sv_s + " WHERE  LOAN_ACCT_ID =?SVAR "
	sv_s = sv_s + " AND  BANK_ID = ?SVAR"
	sv_s = sv_s + " ORDER BY SRL_NO DESC"
	
	BANCS.INPARAM.BINDVARS =BANCS.INPUT.loanAct +"|"+ BANCS.STDIN.contextBankId
	
	sv_r = urhk_dbCursorOpenWithBind(sv_s)
	
	IF (sv_r != 0) THEN
	#{
		BANCS.OUTPUT.fatalErrorMsg = "Unable to open cursor. Contact system admin"
		BANCS.OUTPUT.fatalErrorFlg = "Y"
		GOTO FINISH
	#}
	ENDIF
	CUST.LADISB.cursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_r = urhk_dbCursorFetch(CUST.LADISB.cursorNumber)
	sv_i = 0
	WHILE(sv_r == 0)
	#{
		CUST.LADISB.accId = CUST.LADISB.accId+ "!" +BANCS.OUTPARAM.accId
		CUST.LADISB.acctName = CUST.LADISB.acctName+ "!"+BANCS.OUTPARAM.acctName
		CUST.LADISB.tranPart = CUST.LADISB.tranPart+ "!"+ BANCS.OUTPARAM.tranPart
		CUST.LADISB.ccy = CUST.LADISB.ccy+ "!"+BANCS.OUTPARAM.ccy
		CUST.LADISB.tranAmt = CUST.LADISB.tranAmt+ "!"+BANCS.OUTPARAM.tranAmt
		CUST.LADISB.indicator = CUST.LADISB.indicator+ "!"+BANCS.OUTPARAM.indicator
		
		
		
		sv_i = sv_i + 1
		print(sv_i)
		#----------------------------------------------------------------------
		# Fetch next record
		#----------------------------------------------------------------------
		
		sv_r = urhk_dbCursorFetch(CUST.LADISB.cursorNumber)
		
	#}
	DO
	CUST.LADISB.accId = MID$(CUST.LADISB.accId,1,STRLEN(CUST.LADISB.accId))
	CUST.LADISB.acctName = MID$(CUST.LADISB.acctName,1,STRLEN(CUST.LADISB.acctName))
	CUST.LADISB.tranPart= MID$(CUST.LADISB.tranPart,1,STRLEN(CUST.LADISB.tranPart))
	CUST.LADISB.ccy= MID$(CUST.LADISB.ccy,1,STRLEN(CUST.LADISB.ccy))
	CUST.LADISB.tranAmt= MID$(CUST.LADISB.tranAmt,1,STRLEN(CUST.LADISB.tranAmt))
	CUST.LADISB.indicator= MID$(CUST.LADISB.indicator,1,STRLEN(CUST.LADISB.indicator))
	PRINT(CUST.LADISB.acctName )
	PRINT(CUST.LADISB.tranPart)
	PRINT(CUST.LADISB.ccy)
	PRINT(CUST.LADISB.tranAmt)
	PRINT(CUST.LADISB.indicator)
	
	
	
	
	sv_r = urhk_dbCursorClose(CUST.LADISB.cursorNumber)
	
	IF(CUST.LADISB.accId == "")THEN
	#{
		CUST.LADISB.accId = " "
	#}
	ENDIF
	IF(CUST.LADISB.acctName == "")THEN
	#{
		CUST.LADISB.acctName = " "
	#}
	ENDIF
	IF(CUST.LADISB.tranPart == "")THEN
	#{
		CUST.LADISB.tranPart = " "
	#}
	ENDIF
	IF(CUST.LADISB.ccy == "")THEN
	#{
		CUST.LADISB.ccy = " "
	#}
	ENDIF
	IF(CUST.LADISB.tranAmt == "")THEN
	#{
		CUST.LADISB.tranAmt = " "
	#}
	ENDIF
	IF(CUST.LADISB.indicator == "")THEN
	#{
		CUST.LADISB.indicator = " "
	#}
	ENDIF
	
	sv_r = urhk_SetOrbOut("acctIdRes|"+ CUST.LADISB.accId)
	PRINT(sv_r)
	
	sv_s = "acctNameRes|"+ CUST.LADISB.acctName
	print(sv_s)
	sv_r = urhk_SetOrbOut(sv_s)
	PRINT(sv_r)
	
	sv_s = "tranPartRes|" + CUST.LADISB.tranPart
	print(sv_s)
	sv_r = urhk_SetOrbOut(sv_s)
	PRINT(sv_r)
	
	sv_s = "ccyRes|" + CUST.LADISB.ccy
	print(sv_s)
	sv_r = urhk_SetOrbOut(sv_s)
	PRINT(sv_r)
	
	sv_s = "tranAmtRes|" + CUST.LADISB.tranAmt
	print(sv_s)
	sv_r = urhk_SetOrbOut(sv_s)
	PRINT(sv_r)
	
	sv_s = "crDrRes|" +  CUST.LADISB.indicator
	print(sv_s)
	sv_r = urhk_SetOrbOut(sv_s)
	PRINT(sv_r)
	
	
	FINISH:
		EXITSCRIPT
END-->
