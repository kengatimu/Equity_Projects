				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.custName|" + CUST.DATA.name)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.custTitleCode|" + CUST.DATA.refCode)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.passSheetFlg|N")
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.standingInstructionFlg|N")
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.depositNoticeFlg|N")
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.loanOvrduNoticeFlg|N")
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.xcludeForCombStmtFlg|N")
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.customerId.cifId|"+ CUST.DATA.cif)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.addressType|" + CUST.DATA.addtype)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.poaAuthRemarks|"+ CUST.DATA.KRAandID)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.relationCode.refCode|" + CUST.DATA.relationCode)
				
				IF(CUST.DATA.CITY_CODE !="") THEN
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.addressDet.cityCode|" + CUST.DATA.CITY_CODE)
				PRINT("DEFAULT CITY CODE USED FOR CUSTOMER NEEDING STATIC DATA UPDATE")
				
				ENDIF
				
				IF(CUST.DATA.STATE_CODE !="") THEN
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.addressDet.stateCode|" + CUST.DATA.STATE_CODE)
				PRINT("DEFAULT STATE CODE USED FOR CUSTOMER NEEDING STATIC DATA UPDATE")
				
				ENDIF
				
				IF(CUST.DATA.nextPrintDate!="")THEN
				#{
					sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psNextPrintDate|"+BANCS.STDIN.BODDate)
					sv_a = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_0>.psNextPrintDate|"+BANCS.STDIN.BODDate)

					print(sv_k)
					sv_y = cint(sv_k) - 1
					sv_y = FORMAT$(sv_y,"%d")
					PRINT(sv_y)
					WHILE(sv_y!= 0)
        				#{
	                                     	PRINT(CUST.DATA.nextPrintDate)
						PRINT(sv_y)
						sv_a = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_y+">.psNextPrintDate|"+BANCS.STDIN.BODDate)
						
						sv_y = cint(sv_y)-1	
						sv_y = FORMAT$(sv_y,"%d")
						print(sv_y)



					#}
					DO
				#}
				ENDIF

	
				sv_u = urhk_ExecSrv("SRV_ModifyCAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)

				IF (sv_u == 0) THEN
				#{
								CUST.DATA.PHONE =""
			CUST.DATA.EMAIL =""
			CUST.DATA.AccountPHONE =""
			CUST.DATA.AccountEMAIL =""
			
		###Fetching Account Phone Number and Email
				

			sv_s = "PHONE|"
			sv_s = sv_s + " select PHONENO from crmuser.phoneemail where orgkey in (select cif_id from tbaadm.gam where foracid =?SVAR) and bank_id =?SVAR and PHONEOREMAIL ='PHONE' AND PREFERREDFLAG ='Y'"
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
					IF(sv_d==0)THEN
					#{		
					
						CUST.DATA.AccountPHONE = BANCS.OUTPARAM.PHONE
						print(CUST.DATA.PHONE)
						
					#}
					
					ENDIF


			sv_s = "EMAIL|"
			sv_s = sv_s + " select EMAIL from crmuser.phoneemail where orgkey in (select cif_id from tbaadm.gam where foracid =?SVAR) and bank_id =?SVAR and PHONEOREMAIL ='EMAIL' AND PREFERREDFLAG ='Y'"
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
					IF(sv_d==0)THEN
					#{		
					
						CUST.DATA.AccountEMAIL = BANCS.OUTPARAM.EMAIL
						print(CUST.DATA.AccountEMAIL)
						
					#}
					
					ENDIF

			
			
			###Fetching Agent Phone Number and Email

			
			sv_s = "EMAIL|"
			sv_s = sv_s + " select email from crmuser.phoneemail where orgkey =?SVAR AND BANK_ID=?SVAR and PHONEOREMAIL ='EMAIL' AND PREFERREDFLAG ='Y'"
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

					IF(sv_d==0)THEN
					#{		
						
				CUST.DATA.EMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.EMAIL)
								
					#}
					
					ENDIF



			sv_s = "PHONE|"
			sv_s = sv_s + " select PHONENO from crmuser.phoneemail where orgkey =?SVAR AND BANK_ID=?SVAR and PHONEOREMAIL ='PHONE' AND PREFERREDFLAG ='Y'"
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

					IF(sv_d==0)THEN
					#{		
						
						CUST.DATA.PHONE = BANCS.OUTPARAM.PHONE
						print(CUST.DATA.PHONE)
								
					#}
					
					ENDIF

			
					
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " has been removed successfully."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				
			
					sv_k ="200"
					sv_t="ResponseCode| " + sv_k
					sv_m = urhk_SetOrbOut(sv_t)
					
					#sending response to the user
					CUST.DATA.msg = "KNOWN AGENT " + CUST.DATA.cif + " for account " +CUST.DATA.account + " has been added successfully."
					#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
					sv_t="MSG| " + CUST.DATA.msg
					sv_u = urhk_SetOrbOut(sv_t)
					sv_k ="200"
					
				sv_t="ResponseCode| " + sv_k
				sv_m = urhk_SetOrbOut(sv_t)
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentEMAIL| " + CUST.DATA.EMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentPHONE| " + CUST.DATA.PHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountPHONE| " + CUST.DATA.AccountPHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountEMAIL| " + CUST.DATA.AccountEMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentName| " + CUST.DATA.CUST_NAME
				sv_u = urhk_SetOrbOut(sv_t)
				#}
				ELSE
				#{
					GOTO CHECKERROR
				#}
				ENDIF

 				CUST.DATA.tablekey = CUST.DATA.acid +"/" +BANCS.STDIN.mySolId + "/" + BANCS.STDIN.contextBankId
				PRINT(CUST.DATA.tablekey)

			#}
			ENDIF

		#}
		ENDIF



		CHECKERROR:
		#----------------------------------------------------------------------------------------------------
		# SRV Error check
		#----------------------------------------------------------------------------------------------------
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
			#}									
			ELSE
			#{
				sv_v = 0
			#}
			ENDIF
			IF (sv_v > 0) then
			#{
				sv_u = system("echo 'Error for Acct:"+CUST.DATA.account+" '")
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
					sv_u = system("echo '"+sv_e+"' >>DATAn.log")
					print(sv_u)
				
					#Error response
					#sv_t = "executeFinacleScript_CustomData.ERROR | " +sv_e
					sv_k ="400"
					sv_t="ResponseCode| " + sv_k
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t="MSG| " + sv_e
					sv_u = urhk_SetOrbOut(sv_t)
					GOTO ENDSCRIPT					

				#}
				DO
			#}
			ENDIF	
		#}
		ENDIF
	#}
	ENDIF
ENDSCRIPT:
