				sv_t="AccountPHONE| " + CUST.DATA.AccountPHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountEMAIL| " + CUST.DATA.AccountEMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentName| " + CUST.DATA.CUST_NAME
				sv_u = urhk_SetOrbOut(sv_t)
				
				
				#}
				ELSE
				#{
					GOTO CHECKERROR
				#}
				ENDIF
 				CUST.DATA.tablekey = CUST.DATA.acid +"/" +BANCS.STDIN.mySolId + "/" + BANCS.STDIN.contextBankId
				PRINT(CUST.DATA.tablekey)

		#}
			ENDIF

		#}
		ENDIF

		################################################## CAA ACCOUNT #############################################

		IF(CUST.DATA.STYPE == "CAA")THEN
		#{
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.DATA.account)
			PRINT(sv_u)
			
			sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)


			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.relationType.code|"+ CUST.DATA.code)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.key.serial_num|"+ sv_k)

				sv_s = "addtype|"
				sv_s = sv_s + " SELECT DEFAULTADDRESSTYPE FROM CRMUSER.ACCOUNTS WHERE "
				sv_s = sv_s + "ORGKEY=?SVAR AND BANK_ID=?SVAR"

				BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)	
				IF(sv_d == 0)THEN
				#{				
					print(BANCS.OUTPARAM.addtype)	
					CUST.DATA.addtype= BANCS.OUTPARAM.addtype
					IF(CUST.DATA.addtype == "")THEN
					#{
						CUST.DATA.msg1 = "ADDRESSTYPE is not available for this" + CUST.DATA.cif

						#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg1
						sv_t="MSG| " + CUST.DATA.msg1
						sv_u = urhk_SetOrbOut(sv_t)
						GOTO ENDSCRIPT

					#}		
					ENDIF

				#}
				ENDIF	


				sv_u = urhk_GetCustomerDetails(CUST.DATA.cif)
				IF(sv_u==0)THEN
				#{
					CUST.DATA.name = BANCS.OUTPARAM.CustName
					print(CUST.DATA.name)

					IF(CUST.DATA.name == "")THEN
					#{
						CUST.DATA.msg1 = "Customer Name is not available for this" + CUST.DATA.cif

						#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg1
						sv_t="MSG| " + CUST.DATA.msg1
						sv_u = urhk_SetOrbOut(sv_t)
						GOTO ENDSCRIPT

					#}		
					ENDIF

					CUST.DATA.refCode= BANCS.OUTPARAM.CustTitleCode
					print(CUST.DATA.refCode)

