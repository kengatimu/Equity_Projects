<--START
CHECKSUM="6341b5ee80652f0451a02500437c76ffc514770160d13d6110ff1fde0ea4b95b"
	TRACE ON
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	CUST.DATA.errMsg = ""
	
	
	
	#============================================================================*
	# CALLING THE COM FILE TO GENERATE THE REFERENTIAL RATE EXPIRY REPORTI
	#============================================================================*
	
	sv_c = urhk_getFileLocation("COM|bwyormmn001.com")
	CUST.DATA.fileLocation = BANCS.OUTPARAM.fileLocation
	print(CUST.DATA.fileLocation)
	
	IF (sv_c != 0) THEN
	#{
		print("bwyormmn001.com does not exists")
		GOTO ENDSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_getEnv("DATA_PATH")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^User path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.userPath = BANCS.OUTPARAM.envValue
		print(CUST.DATA.userPath)
		
		#----------TOL - 367144-------------#
		BANCS.INPUT.upldPath = CUST.DATA.userPath
		#---------------------------------------------------------------
		# Calling common script to append userId to upload file path
		#---------------------------------------------------------------
		CALL("appendUserId.scr")
		CUST.DATA.userPath = BANCS.INPUT.upldPath
		print(CUST.DATA.userPath)
		
	#}
	ENDIF
	
	sv_s    =   CUST.DATA.fileLocation + "bwyormmn001.com" +" " + BANCS.STDIN.contextBankId +" " + CUST.DATA.userPath
	print(sv_s)
	
	
	sv_n = SYSTEM(sv_s)
	print (sv_n)
	
	IF(sv_n != 0 ) THEN
	#{
		GOTO ENDSCRIPT
		#}
	ELSE
		#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Upload Initiated successfully "
		sv_z = urhk_SetOrbOut(sv_g)
		sv_e = "babx4061 $B2K_SESSION_ID bwyormupl.scr &"
		print(sv_e)
		sv_r = SYSTEM(sv_e)
		print(sv_r)
	#}
	ENDIF
	
	ENDSCRIPT:
