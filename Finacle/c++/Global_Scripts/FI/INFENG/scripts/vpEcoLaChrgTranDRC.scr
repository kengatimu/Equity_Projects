                else
                        CUST.GCHRG.vatbacid = ""
			CUST.GCHRG.successOrFailure ="F"
                        GOTO END
                endif
	endif

		####Credit Part tran
		if(BANCS.STDIN.contextBankId=="43") then
        		CUST.GCHRG.Particulars =  "Cr: Ecosysem Lace Comm"
