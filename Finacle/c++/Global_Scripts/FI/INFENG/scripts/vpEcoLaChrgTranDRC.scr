                sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
		####Debit End

        if(BANCS.STDIN.contextBankId=="43")then
        	CUST.GCHRG.crChrBacid = "LACEOD549"
