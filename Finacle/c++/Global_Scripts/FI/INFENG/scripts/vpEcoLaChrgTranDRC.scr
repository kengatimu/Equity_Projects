            	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.refCrncyCode.crncyCode|"+ BANCS.STDIN.homeCrncyCode )
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.refAmt|"+EQSRV.GLBDATA.EcoExciseDuty+"|"+ BANCS.STDIN.homeCrncyCode)
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.acctId.foracid|"+ CUST.GCHRG.drAcctId)
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.glDate|"+BANCS.STDIN.BODDate)
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.tranRmks|")
		CUST.GCHRG.Particulars1 = "Tva sur la commission"
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_2>.tranParticulars|"+ CUST.GCHRG.Particulars1)
	#}
	endif

	if(BANCS.STDIN.contextBankId=="43")then
	#{
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.key.serial_num|4")
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.valueDate|" + BANCS.STDIN.BODDate)
                sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_3>.pTranIdentifier.partTranSrlNum|4")
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.partTranType.code|C")
            	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.refCrncyCode.crncyCode|"+ BANCS.STDIN.homeCrncyCode )
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.refAmt|"+EQSRV.GLBDATA.EcoExciseDuty+"|"+ BANCS.STDIN.homeCrncyCode)
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.acctId.foracid|"+ CUST.GCHRG.vatbacid)
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.glDate|"+BANCS.STDIN.BODDate)
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.tranRmks|")
		CUST.GCHRG.Particulars1 = "Cr: vat fee"
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.tranParticulars|"+ CUST.GCHRG.Particulars1)
	#}
	endif
            	sv_u = urhk_ExecSrvNoCommit("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y")
                print(sv_u)
                if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
                #{
                       print(BANCS.OUTPARAM.successOrFailure)
                        if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
                        #{
                                callscriptifexist("ebsrvHandler.scr")
                                if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
