	if(BANCS.STDIN.contextBankId=="43")then
		CUST.GCHRG.vatbacid = "VAT"
                sv_t = CUST.GCHRG.vatbacid +"|"+ BANCS.STDIN.homeCrncyCode +"|"+ CUST.GCHRG.drChrgSolId
