<--START
CHECKSUM="790bb79cb967328f7e20e8e5dd41c77cabedca98993709878d59cccd9037c449"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Bank id"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Bankid=BANCS.INPUT.Bankid
		print(CUST.DATA.Bankid)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Branch"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Branch "
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Branch = BANCS.INPUT.Branch
		print(CUST.DATA.Branch)
	#}
	ENDIF
	
	############################################
	# Fetching the value from table  ?SVAR
	############################################
	
	sv_q = "solid,soldesc,solclsflg,solclsdate,solboddate,solboddatemm| "
	sv_q = sv_q + " select sol_id,SOL_DESC,SOL_CLS_FLG, TO_CHAR((TO_DATE(SOL_CLS_DATE,'DD-MM-RRRR')),'DD-MM-RRRR') as SOL_CLS_DATE,  TO_CHAR((TO_DATE(SOL_BOD_DATE,'DD-MM-RRRR')),'DD-MM-RRRR') as SOL_BOD_DATE,TO_CHAR((TO_DATE(SOL_BOD_DATE,'DD-MM-RRRR')),'DD-MM-RRRR') as SOL_BOD_DATE_MM from tbaadm.sol where bank_id= ?SVAR and sol_id= ?SVAR  "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Branch
	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)
	IF (sv_p==0) THEN
	#{
		#solid,soldesc,solclsflg,solclsdate,solboddate
		
		CUST.DATA.solid = BANCS.OUTPARAM.solid
		print(CUST.DATA.solid)
		CUST.DATA.soldesc = BANCS.OUTPARAM.soldesc
		print(CUST.DATA.soldesc)
		CUST.DATA.solclsflg = BANCS.OUTPARAM.solclsflg
		print(CUST.DATA.solclsflg)
		CUST.DATA.solclsdate = BANCS.OUTPARAM.solclsdate
		print(CUST.DATA.solclsdate)
		CUST.DATA.solboddate = BANCS.OUTPARAM.solboddate
		print(CUST.DATA.solboddate)
		CUST.DATA.solboddatemm = BANCS.OUTPARAM.solboddatemm
		print(CUST.DATA.solboddatemm)
		


		sv_a= CUST.DATA.solid + "|" + CUST.DATA.solboddatemm
		print(sv_a)
		sv_e = urhk_GetNextWorkingDate(sv_a)
		print(sv_e)
		print(BANCS.OUTPARAM.NextWorkingDate)
		CUST.DATA.NextWorkingDate= MID$(BANCS.OUTPARAM.NextWorkingDate,0,10)
		print(CUST.DATA.NextWorkingDate)

		print(BANCS.OUTPARAM.PrevWorkingDate)
		CUST.DATA.PrevWorkingDate = MID$(BANCS.OUTPARAM.PrevWorkingDate,0,10)
		print(CUST.DATA.PrevWorkingDate)

		print(BANCS.OUTPARAM.NextDataCentreWorkingDate)
		CUST.DATA.NextDataCentreWorkingDate = MID$(BANCS.OUTPARAM.NextDataCentreWorkingDate,0,10)
		print(CUST.DATA.NextDataCentreWorkingDate)

		print(BANCS.OUTPARAM.PrevDataCentreWorkingDate)
		CUST.DATA.PrevDataCentreWorkingDate = MID$(BANCS.OUTPARAM.PrevDataCentreWorkingDate,0,10)
		print(CUST.DATA.PrevDataCentreWorkingDate)

		sv_z = urhk_SetOrbOut("SOL_ID|"+CUST.DATA.solid)
		print(sv_z)
		sv_z = urhk_SetOrbOut("SOL_DESC|"+ CUST.DATA.soldesc)
		print(sv_z)
		sv_z = urhk_SetOrbOut("SOL_CLS_FLG|"+ CUST.DATA.solclsflg)
		print(sv_z)
		sv_z = urhk_SetOrbOut("SOL_CLS_DATE|"+ CUST.DATA.solclsdate)
		print(sv_z)
		sv_z = urhk_SetOrbOut("SOL_BOD_DATE|"+ CUST.DATA.solboddate)
		print(sv_z)

		#next 
		sv_z = urhk_SetOrbOut("NEXTWORKINGDATE|"+ CUST.DATA.NextWorkingDate)
		print(sv_z)
		sv_z = urhk_SetOrbOut("PREVWORKINGDATE|"+ CUST.DATA.PrevWorkingDate)
		print(sv_z)
		sv_z = urhk_SetOrbOut("NEXTDATACENTREWORKINGDATE|"+ CUST.DATA.NextDataCentreWorkingDate)
		print(sv_z)
		sv_z = urhk_SetOrbOut("PREVDATACENTREWORKINGDATE|"+ CUST.DATA.PrevDataCentreWorkingDate)
		print(sv_z)

		sv_e=urhk_SetOrbOut("StattusCode|1")
		#}
	ELSE
		#{
		CUST.DATA.errMsg="Data Error ...Enter Valid Data"
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	#}
	ENDIF
	End:
		EXITSCRIPT
		TRACE OFF
END-->
