##########################################################################################
# Source Name           : FI_acctFreeze.scr
# Date                  : 19-01-2023
# Description           : FI - Account Freeze API
# Author                : Anand Pansare
# Modification History  :
# <Serial No.>  <Date>        <Author Name>             <Description>
# ------------  -----------   -----------------         --------------
#      1        19-01-2023    Kelvin Musyoka          Original file
###########################################################################################

<--start
trace on
#Repos&Classes
        if (repexists("EQSRV") == 0) then
                createrep("EQSRV")
        endif
        if (classexists("EQSRV","GLBDATA") == 0) then
                createclass("EQSRV","GLBDATA",5)
        endif


        print(BANCS.STDIN.BODDate)
        EQSRV.GLBDATA.srvErrMsg = ""
        EQSRV.GLBDATA.srvErrCode = ""
        EQSRV.GLBDATA.ClsFlg =""
        EQSRV.GLBDATA.srvSucFail = ""
        EQSRV.GLBDATA.frezChk   = ""
        EQSRV.GLBDATA.valerr    = ""
        EQSRV.GLBDATA.freezeAcct = ""
        EQSRV.GLBDATA.freezecode = ""

        if(fieldexists(BANCS.INPUT.freezeAcct)==1)then
                EQSRV.GLBDATA.freezeAcct = BANCS.INPUT.freezeAcct
        else
                EQSRV.GLBDATA.freezeAcct = ""
        endif
        if(fieldexists(BANCS.INPUT.freezeUnFreeze)==1)then
                EQSRV.GLBDATA.freezeUnFreeze = BANCS.INPUT.freezeUnFreeze
        else
                EQSRV.GLBDATA.freezeUnFreeze = ""
        endif
        if(fieldexists(BANCS.INPUT.freezeCode)==1)then
                EQSRV.GLBDATA.freezecode = BANCS.INPUT.freezeCode
        else
                EQSRV.GLBDATA.freezecode = ""
        endif

        if(fieldexists(BANCS.INPUT.freezeReasonCode)==1)then
                EQSRV.GLBDATA.freezeCode1 = BANCS.INPUT.freezeReasonCode
        else
                EQSRV.GLBDATA.freezeCode1 = ""
        endif

        if(fieldexists(BANCS.INPUT.freezeRemarks)==1)then
                EQSRV.GLBDATA.freezeRemarks1 = BANCS.INPUT.freezeRemarks
        else
                EQSRV.GLBDATA.freezeRemarks1= ""
        endif

        if(EQSRV.GLBDATA.freezeUnFreeze=="")then
                EQSRV.GLBDATA.srvErrMsg = "freezeUnFreeze tag value should be FZ or UZ"
                EQSRV.GLBDATA.srvErrCode = "999"
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif

        if(EQSRV.GLBDATA.freezeUnFreeze=="FZ")then
                if(EQSRV.GLBDATA.freezecode=="")then
                        EQSRV.GLBDATA.srvErrMsg = " freezeCode tag value should be D or C or T"
                        EQSRV.GLBDATA.srvErrCode = "999"
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto VAYU
                endif
        endif

        if(EQSRV.GLBDATA.freezeUnFreeze=="UZ")then
                EQSRV.GLBDATA.freezecode = ""
        endif

        if(EQSRV.GLBDATA.freezeAcct != "")then
                sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.freezeAcct)
                print(sv_u)
                if(sv_u == 0)then
                        EQSRV.GLBDATA.frezChk   = BANCS.OUTPARAM.freezeCode
                        EQSRV.GLBDATA.freezeSol = BANCS.OUTPARAM.acctSolId
                        EQSRV.GLBDATA.ClsFlg    = BANCS.OUTPARAM.acctCloseflg
                        Print (EQSRV.GLBDATA.ClsFlg)
                else
                        EQSRV.GLBDATA.srvErrMsg = "Invalid Account Id"
                        EQSRV.GLBDATA.srvErrCode = "999"
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto VAYU
                endif
        else
                EQSRV.GLBDATA.srvErrMsg = "Invalid Account Id"
                EQSRV.GLBDATA.srvErrCode = "999"
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif

        if(EQSRV.GLBDATA.ClsFlg=="Y")then
                EQSRV.GLBDATA.valerr= "Account closed"
        endif

        print(EQSRV.GLBDATA.frezChk)

        if(EQSRV.GLBDATA.frezChk !=" ")then
                EQSRV.GLBDATA.modifyYN = "Y"
        endif

        if((EQSRV.GLBDATA.frezChk=="") or (EQSRV.GLBDATA.frezChk==" "))then
                EQSRV.GLBDATA.modifyYN = "N"
        endif


        #ContextSol
                print(BANCS.STDIN.mySolId)
        print(EQSRV.GLBDATA.freezeSol)
        if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.freezeSol ) then
                sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.freezeSol)
                sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
                if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
                        print(BANCS.OUTPARAM.successOrFailure)
                        sv_s = BANCS.OUTPARAM.successOrFailure
                else
                        sv_s = "X"
                endif
                if (( sv_u != 0 ) and ( sv_s != "S"))then
                        EQSRV.GLBDATA.valerr     =       "CCS Failed"
                        goto VAYU
                endif
        endif

        if(EQSRV.GLBDATA.freezeUnFreeze=="UZ")then

        #UF
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+EQSRV.GLBDATA.freezeAcct)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|N")
        sv_u = urhk_SetUrhkOut("acctFreezeCriteria.freezeCode.code|freezecode")
        sv_u = urhk_SetUrhkOut("acctFreezeCriteria.freezeReason.refCode|freezeReason")
        sv_u = urhk_SetUrhkOut("acctFreezeCriteria.freezeRemarks|freezeRemarks")
        sv_u = urhk_ExecSrv("SRV_FetchAcctsForUnfreeze|same_user_verify=Y|retain_all_output = Y|call_mode = N")
        print(sv_u)

        if(sv_u != "0") then
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.freezeAcct
                callscriptifexist("errorCheck.scr")
                #EQSRV.GLBDATA.srvErrMsg = "Failed SRV_FetchAcctsForUnfreeze"
                EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctsForUnfreeze"
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        else
                EQSRV.GLBDATA.freezecode = BANCS.OUTPARAM.freezecode
                EQSRV.GLBDATA.freezeReason = BANCS.OUTPARAM.freezeReason
                EQSRV.GLBDATA.freezeRemarks = BANCS.OUTPARAM.freezeRemarks
        endif
        if(EQSRV.GLBDATA.srvSucFail!="F")then
                print(EQSRV.GLBDATA.freezecode)
                print(EQSRV.GLBDATA.freezeReason)
                print(EQSRV.GLBDATA.freezeRemarks)
                sv_u = urhk_copyOutToIn("")
                print(sv_u)
                sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+EQSRV.GLBDATA.freezeAcct)
                sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeCode.code|"+EQSRV.GLBDATA.freezecode)
                sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|N")
                sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.acctId.foracid|"+EQSRV.GLBDATA.freezeAcct)
                sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeCode.code|"+EQSRV.GLBDATA.freezecode)
                sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeReason.refCode|"+EQSRV.GLBDATA.freezeReason)
                sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeReason.refCode|"+EQSRV.GLBDATA.freezeReason)
                sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeRemarks|"+EQSRV.GLBDATA.freezeRemarks)
                sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeRemarks|"+EQSRV.GLBDATA.freezeRemarks)
                sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.selFlg|t")
                sv_u = urhk_ExecSrv("SRV_UnFreezeAcctsAutoVerify|same_user_verify=Y|retain_all_output = Y|call_mode = N")
                print(sv_u)
                if ( sv_u != "0" ) then
                        EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.freezeAcct
                        callscriptifexist("ebsrvHandler.scr")
                        #EQSRV.GLBDATA.srvErrMsg = "Failed SRV_UnFreezeAcctsAutoVerify"
                        EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
                        EQSRV.GLBDATA.srvErrCode = "Failed : SRV_UnFreezeAcctsAutoVerify "
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto VAYU
                else
                        EQSRV.GLBDATA.Onvforacid        = EQSRV.GLBDATA.freezeAcct
                        EQSRV.GLBDATA.srvErrMsg = "Account UNFreezed and Verified Successfully"
                        EQSRV.GLBDATA.srvSucFail = "S"
                        goto VAYU
                endif
        endif
        endif


        if(EQSRV.GLBDATA.freezeUnFreeze=="FZ")then


        #Freeze Service Inputs
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|"+EQSRV.GLBDATA.modifyYN)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+EQSRV.GLBDATA.freezeAcct)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeCode.code|"+EQSRV.GLBDATA.freezecode)
        sv_u = urhk_ExecSrv("SRV_FetchAcctsForFreeze|same_user_verify=Y|retain_all_output = Y|call_mode = N")
        print(sv_u)

        if(sv_u != "0") then
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.freezeAcct
                callscriptifexist("ebsrvHandler.scr")
                #EQSRV.GLBDATA.srvErrMsg = "Failed SRV_FetchAcctsForFreeze"
                EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctsForFreeze| "
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif


        IF (EQSRV.GLBDATA.srvSucFail !="F") Then
        sv_u = urhk_copyOutToIn("")
        print(sv_u)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+EQSRV.GLBDATA.freezeAcct)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeCode.code|"+EQSRV.GLBDATA.freezecode)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|"+EQSRV.GLBDATA.modifyYN)
        sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.acctId.foracid|"+EQSRV.GLBDATA.freezeAcct)
        sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeCode.code|"+EQSRV.GLBDATA.freezecode)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeReason.refCode|"+EQSRV.GLBDATA.freezeCode1)
        sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeReason.refCode|"+EQSRV.GLBDATA.freezeCode1)
        sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeRemarks|"+EQSRV.GLBDATA.freezeRemarks1)
        sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeRemarks|"+EQSRV.GLBDATA.freezeRemarks1)
        sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.selFlg|t")
        sv_u = urhk_ExecSrv("SRV_FreezeAcctsAutoVerify|same_user_verify=Y|retain_all_output = Y|call_mode = N")
        print(sv_u)

        if ( sv_u != "0" ) then
                EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.freezeAcct
                callscriptifexist("ebsrvHandler.scr")
                #EQSRV.GLBDATA.srvErrMsg = "Failed SRV_FetchAcctsForFreeze"
                EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
                EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FreezeAcctsAutoVerify "
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        else
                EQSRV.GLBDATA.Onvforacid        = EQSRV.GLBDATA.freezeAcct
                EQSRV.GLBDATA.srvErrMsg = "Account Frozen and Verified Successfully"
                EQSRV.GLBDATA.srvSucFail = "S"
                goto VAYU
        endif


ENDIF
        endif


#EndofScript
VAYU:

        print(EQSRV.GLBDATA.srvErrMsg)
        print(EQSRV.GLBDATA.srvErrCode)
        print(EQSRV.GLBDATA.srvSucFail)

        if(EQSRV.GLBDATA.srvSucFail=="F")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.srvErrMsg )
        endif

        if(EQSRV.GLBDATA.srvSucFail=="S")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.srvErrMsg )
        endif

        if(classexists("EQSRV","GLBDATA")==1)then
                deleteclass("EQSRV","GLBDATA")
        endif
        if(repexists("EQSRV")==1)then
                deleterep("EQSRV")
        endif


exitscript
trace off
end-->
