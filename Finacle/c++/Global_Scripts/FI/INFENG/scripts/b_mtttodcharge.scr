			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-----------------------------------------------------------------------------
		#End of MTT Definition
		#-----------------------------------------------------------------------------
		sv_v = urhk_MTTS_EndDefinition("")
		print(sv_v)
		IF (sv_v == 1) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			print (MTT.Error.Description)
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_a = urhk_B2k_PrintRepos("BANCS")
			IF (FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
			#{
				BANCS.OUTPARAM.MTTTranId = BANCS.OUTPARAM.MTTTranId
				print(BANCS.OUTPARAM.MTTTranId)
				#GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
