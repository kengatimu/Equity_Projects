		IF(sv_r != 0) THEN
		#{
			MTT.Error.Description="Error in Populating Input details for MTT"
			sv_r = urhk_MTTS_ReportErrorCondition("")
			exitscript
		#}
		ENDIF
		
		
		#-----------------------------------------------------------------------------------------------#
		#####   Defining the Transaction
		#-----------------------------------------------------------------------------------------------#
		
		#--------------------------
