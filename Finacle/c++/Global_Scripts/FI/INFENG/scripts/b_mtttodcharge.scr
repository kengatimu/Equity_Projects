		MTT.PartTranDetails.RefAmount= CDOUBLE(sv_m)
		print(sv_c)
		MTT.PartTranDetails.RefCurrency= sv_c
		MTT.PartTranDetails.RateCode= "MEAN"
		MTT.PartTranDetails.Rate= "0"
		MTT.PartTranDetails.ValueDate = "0"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier = "DFCU"
		MTT.PartTranDetails.Particulars = "TOD CHARGES"
		sv_v = urhk_MTTS_DefinePartTran("DFCU2")
		print(sv_v)
		
		IF (sv_v == 1) THEN
		#{
			print(MTT.Error.Description)
			print("Error WHILE defining Part Tran")
