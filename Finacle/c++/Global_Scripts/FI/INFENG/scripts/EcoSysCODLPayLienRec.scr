        endif
	
	if(repexists("EQOD")==0)then
        #{
                createrep("EQOD")
        #}
        endif
        if(classexists("EQOD","GLBDATA")==0)then
        #{
                createclass("EQOD","GLBDATA",5)
        #}
        endif
	
	 if(fieldexists(BANCS.INPUT.funcCode)==1)then
                print(BANCS.INPUT.funcCode)
                EBSRV.GLBDATA.funcCode = BANCS.INPUT.funcCode
        else
                EBSRV.GLBDATA.funcCode = ""
        endif

        print(EBSRV.GLBDATA.funcCode)		
        EBSRV.GLBDATA.isLienAddModify = ""
