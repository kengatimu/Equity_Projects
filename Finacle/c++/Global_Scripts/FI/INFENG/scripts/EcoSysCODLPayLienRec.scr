	if((EBSRV.GLBDATA.funcCode == "P") or (EBSRV.GLBDATA.funcCode =="R"))then
	#{
		sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.accNum)
		if(sv_u ==0) then
			EBSRV.GLBDATA.lllaclearBalance=BANCS.OUTPARAM.clearBalance
