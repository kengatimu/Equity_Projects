        EBSRV.GLBDATA.b2kid = ""
        EBSRV.GLBDATA.ppRegulAmt = cdouble("0")
        EBSRV.GLBDATA.tranAmt = cdouble("0")
        EBSRV.GLBDATA.aftTranup = ""
        EBSRV.GLBDATA.srvErrCode = ""
        EBSRV.GLBDATA.srvErrMsg = ""
