			if(cdouble(EBSRV.GLBDATA.lllaclearBalance)<0)then
				EBSRV.GLBDATA.lllaclearBalance = cdouble(EBSRV.GLBDATA.lllaclearBalance) * -1
				print(EBSRV.GLBDATA.lllaclearBalance)
			else
				EBSRV.GLBDATA.srvErrMsg = "Account in Credit Balance"
				goto Endofscript				
			endif
		else
			EBSRV.GLBDATA.srvErrMsg = "Loan Account Does not Exist"
			goto Endofscript
		endif
		IF(EBSRV.GLBDATA.funcCode == "P") then
		sv_s = "totAmttt|select '"+EBSRV.GLBDATA.lllaclearBalance+"' + '"+EBSRV.GLBDATA.tranAmtt+"' from dual "
		sv_u = urhk_dbSelectWithBind(sv_s)
		print(sv_u)	
		if(sv_u == 0)then
		#{
			EBSRV.GLBDATA.totAmttt = BANCS.OUTPARAM.totAmttt
			PRINT(EBSRV.GLBDATA.totAmttt)
		#}
		endif	
		ENDIF
		callscriptifexist("EcosyscodplayChnlPay.scr")
        	sv_r = urhk_MTTS_Close("")
		exitscript
	#}
	ENDIF
	
Endofscript:
        print(EBSRV.GLBDATA.srvErrCode)
        print(EBSRV.GLBDATA.srvErrMsg)
        print(EBSRV.GLBDATA.srvSucFail)
        exitscript
trace off
