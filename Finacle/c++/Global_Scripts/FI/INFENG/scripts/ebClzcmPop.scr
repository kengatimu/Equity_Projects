<--start
trace on
#Rep/Class
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_p = urhk_B2k_PrintRepos("BANCS")
        print(sv_p)
	if(fieldexists(BANCS.STDIN.menuId)==1)then
		print(BANCS.STDIN.menuId)	
	endif
	EQSRV.GLBDATA.crAcct = ""
	EQSRV.GLBDATA.drAcctId = " "
	EQSRV.GLBDATA.errorFlg = "N"
	EQSRV.GLBDATA.errorMsg = "S"
	if(BANCS.STDIN.menuId=="HMCLZOH")then
	#{
                if(fieldexists(BANCS.INPUT.mopId) == 1)then
                        EQSRV.GLBDATA.mopId = BANCS.INPUT.mopId
                else
                        EQSRV.GLBDATA.mopId = ""
                endif
                if(fieldexists(BANCS.INPUT.pageName) == 1)then
                        EQSRV.GLBDATA.pageName = BANCS.INPUT.pageName
                else
                        EQSRV.GLBDATA.pageName = ""
                endif
                if(fieldexists(BANCS.INPUT.funcCode) == 1)then
                        EQSRV.GLBDATA.funcCode = BANCS.INPUT.funcCode
                else
                        EQSRV.GLBDATA.funcCode = ""
                endif
                if(fieldexists(BANCS.INPUT.ZoneCode) == 1)then
                        EQSRV.GLBDATA.ZoneCode = BANCS.INPUT.ZoneCode
                else
                        EQSRV.GLBDATA.ZoneCode = ""
                endif
                if(fieldexists(BANCS.INPUT.ZoneDate) == 1)then
                        EQSRV.GLBDATA.ZoneDate = BANCS.INPUT.ZoneDate
                else
                        EQSRV.GLBDATA.ZoneDate = ""
                endif
		sv_d = "drBacid,homeclgFlg,frgnCrncyFlg,sttlInCrncyFlg,sttlCrncyCode,ZoneCrncyCode,RateCode,setRelFlg,setRelDrBacid,InterClgbacid | select dr_bacid,home_clg_flg,frgn_crncy_clg_flg,sttlmnt_in_inst_crncy_flg,sttlmnt_crncy_code,zone_crncy_code,rate_code,set_rel_reg_flg,set_rel_dr_bacid,inter_clg_bacid from tbaadm.ozc where bank_id=?SVAR and clg_zone_code=?SVAR and del_flg='N' and rownum<=1"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.ZoneCode 
		print(sv_d)
                print(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u==0)then
			EQSRV.GLBDATA.drBacid = BANCS.OUTPARAM.drBacid
			EQSRV.GLBDATA.homeclgFlg = BANCS.OUTPARAM.homeclgFlg
			EQSRV.GLBDATA.frgnCrncyFlg = BANCS.OUTPARAM.frgnCrncyFlg
			EQSRV.GLBDATA.sttlInCrncyFlg = BANCS.OUTPARAM.sttlInCrncyFlg
			EQSRV.GLBDATA.sttlCrncyCode = BANCS.OUTPARAM.sttlCrncyCode
			EQSRV.GLBDATA.ZoneCrncyCode = BANCS.OUTPARAM.ZoneCrncyCode
			EQSRV.GLBDATA.RateCode = BANCS.OUTPARAM.RateCode
			EQSRV.GLBDATA.setRelFlg = BANCS.OUTPARAM.setRelFlg
			EQSRV.GLBDATA.setRelDrBacid = BANCS.OUTPARAM.setRelDrBacid
			EQSRV.GLBDATA.InterClgbacid = BANCS.OUTPARAM.InterClgbacid
                        if((EQSRV.GLBDATA.ZoneCode=="EQBOWZUSIN") or (EQSRV.GLBDATA.ZoneCode=="EQBOWGBPIN") or (EQSRV.GLBDATA.ZoneCode=="EQBOWEURIN"))then
                                sv_i = EQSRV.GLBDATA.setRelDrBacid + "|" + EQSRV.GLBDATA.ZoneCrncyCode + "|" + BANCS.STDIN.mySolId
                        else
                                sv_i = EQSRV.GLBDATA.drBacid + "|" + EQSRV.GLBDATA.ZoneCrncyCode + "|" + BANCS.STDIN.mySolId
                        endif
                        print(sv_i)
			sv_u = urhk_B2k_BacidToAcctId(sv_i)
			if(sv_u==0)then
				EQSRV.GLBDATA.crAcct = BANCS.OUTPARAM.AcctId
			else	
				EQSRV.GLBDATA.drBacid = "BRCLG"
				sv_i = EQSRV.GLBDATA.drBacid + "|" + EQSRV.GLBDATA.ZoneCrncyCode + "|" + BANCS.STDIN.mySolId
				print(sv_i)
				sv_u = urhk_B2k_BacidToAcctId(sv_i)
				if(sv_u==0)then
					EQSRV.GLBDATA.crAcct = BANCS.OUTPARAM.AcctId
				endif
			endif
			if(EQSRV.GLBDATA.crAcct!="")then
				sv_d = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.crAcct)
				if(sv_d==0)then
					EQSRV.GLBDATA.acctSolId = BANCS.OUTPARAM.acctSolId
					EQSRV.GLBDATA.acctName = BANCS.OUTPARAM.acctName
					EQSRV.GLBDATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
				else
					EQSRV.GLBDATA.acctSolId = "" 
					EQSRV.GLBDATA.acctSolId = "" 
					EQSRV.GLBDATA.acctSolId = "" 
				endif
				EQSRV.GLBDATA.output = "Y|" + EQSRV.GLBDATA.crAcct + "~" + EQSRV.GLBDATA.acctName + "~" + EQSRV.GLBDATA.acctSolId + "~" + EQSRV.GLBDATA.acctCrncyCode 
			else
				EQSRV.GLBDATA.output = "N|No"
			endif
                else
                        EQSRV.GLBDATA.output = "N|No"
                endif
                sv_a = urhk_SetOrbOut(EQSRV.GLBDATA.output)
                print(sv_a)
                exitscript
	#}
	endif
exitscript
trace off
end-->
