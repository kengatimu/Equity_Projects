#vphucsVfy.scr
<--start
trace on
#Rep/Class
        if(repexists("UCS")==0)then
                createrep("UCS")
        endif
        if(classexists("UCS","GLBDATA")==0)then
                createclass("UCS","GLBDATA",5)
        endif
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
	if(fieldexists(VERRE.GLBDATA.AcctId)==1)then
		UCS.GLBDATA.acctId = VERRE.GLBDATA.AcctId 
	else
		UCS.GLBDATA.acctId = ""
	endif
	if(fieldexists(VERRE.GLBDATA.ChequeNum)==1)then
		UCS.GLBDATA.instrNum  = VERRE.GLBDATA.ChequeNum 
	else
		UCS.GLBDATA.instrNum  = ""
	endif
        if(fieldexists(VERRE.GLBDATA.StatusCode)==1)then
                UCS.GLBDATA.StatusCode  = VERRE.GLBDATA.StatusCode
        else
                UCS.GLBDATA.StatusCode  = ""
        endif
        UCS.GLBDATA.instrType = "CHQ"
	if(UCS.GLBDATA.StatusCode=="J")then
		UCS.GLBDATA.newStatCode = "J"
		UCS.GLBDATA.neqStatCodeDesc = "REJECTED"
	endif
	if(UCS.GLBDATA.StatusCode=="P")then
		UCS.GLBDATA.newStatCode = "P"
		UCS.GLBDATA.neqStatCodeDesc = "PASSED"
	endif
	if(UCS.GLBDATA.StatusCode=="U")then
		UCS.GLBDATA.newStatCode = "U"
		UCS.GLBDATA.neqStatCodeDesc = "UNUSED"
	endif
        sv_u = urhk_SetUrhkInp("acct.foracid|" + UCS.GLBDATA.acctId )
        sv_u = urhk_SetUrhkInp("instrmnt.instrmntType|" + UCS.GLBDATA.instrType )
        sv_u = urhk_SetUrhkInp("instrmnt.instrmntNum|" + UCS.GLBDATA.instrNum )
        sv_u = urhk_SetUrhkOut("beginChqNum|beginChqNum")
        sv_u = urhk_SetUrhkOut("presentStat.code|statCode")
        sv_u = urhk_SetUrhkOut("presentStat.codeDesc|statCodeDesc")
        sv_u = urhk_SetUrhkOut("cookie|cookie")

        sv_u = urhk_ExecSrv("SRV_FetchChqStatForModify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
        #{
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        #}
        else
        #{
                sv_s = "X"
        #}
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
        #{
                print("fetch in")
                UCS.GLBDATA.beginChqNum = BANCS.OUTPARAM.beginChqNum
                UCS.GLBDATA.statCode = BANCS.OUTPARAM.statCode
                UCS.GLBDATA.statCodeDesc = BANCS.OUTPARAM.statCodeDesc
                UCS.GLBDATA.cookie = BANCS.OUTPARAM.cookie
        #}
        else
        #{
                EQSRV.GLBDATA.srvAcctId = UCS.GLBDATA.acctId
                callscriptifexist("ebsrvHandler.scr")
                UCS.GLBDATA.srvErrMsg = "error"
                UCS.GLBDATA.srvErrCode = "Failed : SRV_FetchChqStatForModify "
                UCS.GLBDATA.srvSucFail = "F"
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
                        sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.SrvError )
                else
                        sv_u = urhk_SetOrbOut("Message|SRV_FetchChqStatForModify is failed")
                endif
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        #}
        endif
        sv_u = urhk_CopyOutToIn("")


        sv_u = urhk_SetUrhkInp("acct.foracid|" + UCS.GLBDATA.acctId )
        sv_u = urhk_SetUrhkInp("instrmnt.instrmntType|" + UCS.GLBDATA.instrType )
        sv_u = urhk_SetUrhkInp("instrmnt.instrmntNum|" + UCS.GLBDATA.instrNum )
        sv_u = urhk_SetUrhkInp("beginChqNum|" + UCS.GLBDATA.beginChqNum )
        sv_u = urhk_SetUrhkInp("newStat.code|" + UCS.GLBDATA.newStatCode )
        sv_u = urhk_SetUrhkInp("newStat.codeDesc|" + UCS.GLBDATA.neqStatCodeDesc )

        sv_u = urhk_ExecSrv("SRV_UpdateChqStatAndVerify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
        print(sv_u)
        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
        #{
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
        #}
        else
        #{
                sv_s = "X"
        #}
        endif
        if (( sv_u == 0 ) and ( sv_s=="S") ) then
        #{
                print("status in")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
		sv_u = urhk_SetOrbOut("Message|Cheque Status Updated Successfully")
		exitscript
        #}
        else
        #{
                EQSRV.GLBDATA.srvAcctId = UCS.GLBDATA.acctId
                callscriptifexist("ebsrvHandler.scr")
                UCS.GLBDATA.srvErrMsg = "error"
                UCS.GLBDATA.srvErrCode = "Failed : SRV_UpdateChqStatAndVerify "
                UCS.GLBDATA.srvSucFail = "F"
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
                        sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.SrvError )
                else
                        sv_u = urhk_SetOrbOut("Message|SRV_UpdateChqStatAndVerify is failed")
                endif
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        #}
        endif

trace off
end-->
