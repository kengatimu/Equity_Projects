<--START
CHECKSUM="3bf61f1246b227bc32491c8b54f813240dcac045c40b5c5c49a9989680d8403a"
	TRACE ON
	
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "CDDUM") == 0) THEN
	#{
		CREATECLASS("CUST", "CDDUM", 5)
	#}
	ENDIF
	sv_a = 1
	print(BANCS.INPUT.instNo)
	print(BANCS.INPUT.forAcid)
	CUST.CDDUM.InstType = TOUPPER(BANCS.INPUT.instNo)
	PRINT(CUST.CDDUM.InstType)
	CUST.CDDUM.acctno = BANCS.INPUT.forAcid
	PRINT(CUST.CDDUM.acctno)
	
	sv_s = "recCount"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT COUNT(*) "
	sv_s = sv_s + " FROM CUSTOM.C_CBT "
	sv_s = sv_s + " WHERE del_flg != 'Y' "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	sv_s = sv_s + " AND foracid = ?SVAR "
	sv_s = sv_s + " AND  inst_type = ?SVAR "
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  + "|" + CUST.CDDUM.acctno + "|" + CUST.CDDUM.InstType
	print(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	CUST.CDDUM.recCount = BANCS.OUTPARAM.recCount
	print(CUST.CDDUM.recCount)
	
	sv_q = urhk_SetOrbOut("recCount|"+CUST.CDDUM.recCount)
	
	sv_s = "begChqNo,chqLeavs,chqIssudate,numPaid,numUnused,numPosted,numDestroyed"
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT rpad(BEGIN_CHQ_NUM,10,' '),lpad(CHQ_NUM_OF_LVS,6,' '),lpad(CHQ_ISSU_DATE,14,' '),lpad(NUM_PAID,5,' '),lpad(NUM_UNUSED,5,' '),lpad(NUM_STOPED,5,' '),lpad(NUM_DESTROYED,5,' ') "
	sv_s = sv_s + " FROM CUSTOM.C_CBT "
	sv_s = sv_s + " WHERE del_flg != 'Y' "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	sv_s = sv_s + " AND  foracid = ?SVAR "
	sv_s = sv_s + " AND  inst_type = ?SVAR "
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  + "|" + CUST.CDDUM.acctno + "|" + CUST.CDDUM.InstType
	PRINT(BANCS.INPARAM.BINDVARS)
	print(sv_s)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	
	IF( sv_c != 0) THEN
	#{
		sv_u = urhk_SRV_SetErr("No recods fetched for the entered Account Number")
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		
		WHILE( sv_c == 0)
		#{
			CUST.CDDUM.count = sv_a
			print(CUST.CDDUM.count)
			
			CUST.CDDUM.begChqNo = BANCS.OUTPARAM.begChqNo
			print(CUST.CDDUM.begChqNo)
			
			CUST.CDDUM.chqLeavs = BANCS.OUTPARAM.chqLeavs
			print(CUST.CDDUM.chqLeavs)
			
			CUST.CDDUM.chqIssudate = BANCS.OUTPARAM.chqIssudate
			print(CUST.CDDUM.chqIssudate)
			
			CUST.CDDUM.numPaid = BANCS.OUTPARAM.numPaid
			print(CUST.CDDUM.numPaid)
			
			
			CUST.CDDUM.numUnused = BANCS.OUTPARAM.numUnused
			print(CUST.CDDUM.numUnused)
			
			CUST.CDDUM.numPosted = BANCS.OUTPARAM.numPosted
			
			CUST.CDDUM.numDestroyed = BANCS.OUTPARAM.numDestroyed
			
			sv_z = "status_" + CUST.CDDUM.count
			sv_z = sv_z + "| " +CUST.CDDUM.begChqNo
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "reqid_" + CUST.CDDUM.count
			sv_z = sv_z + "| " + CUST.CDDUM.chqLeavs
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "acctNum_" + CUST.CDDUM.count
			sv_z = sv_z + "| " +CUST.CDDUM.chqIssudate
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "numofchb_" + CUST.CDDUM.count
			sv_z = sv_z + "| " + CUST.CDDUM.numPaid
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "numofchqlvs_" + CUST.CDDUM.count
			sv_z = sv_z + "| " + CUST.CDDUM.numUnused
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "reqdate_" + CUST.CDDUM.count
			sv_z = sv_z + "| " + CUST.CDDUM.numPosted
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "reqst_" + CUST.CDDUM.count
			sv_z = sv_z + "| " + CUST.CDDUM.numDestroyed
			sv_u = urhk_SetOrbOut(sv_z)
			
			
			sv_a = sv_a + 1
			sv_c = urhk_dbCursorFetch(sv_l)
			print(sv_c)
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		exitscript
		
END-->
