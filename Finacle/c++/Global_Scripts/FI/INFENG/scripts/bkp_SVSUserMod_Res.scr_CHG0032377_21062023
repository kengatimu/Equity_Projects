<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether INTERFACE Class exists else create it
	###########################################################################################
		
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	
	CUST.INTERFACE.svs_status = ""
	
	CUST.INTERFACE.svs_errorCode = ""
	CUST.INTERFACE.svs_errorDesc = ""
	
	
	sv_x = CUST.INTERFACE.respXMLMsg
	
	#--------------------------------------------------------------------------------------------------------
	# Fetching the status of the request
	#--------------------------------------------------------------------------------------------------------
	sv_y = "<HostTransaction>"
	sv_z = "</HostTransaction>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.ubusStuatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		sv_x = CUST.INTERFACE.ubusStuatus
		PRINT(sv_x)
		sv_y = "<Status>"
		sv_z = "</Status>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.svs_status = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
			PRINT(CUST.INTERFACE.svs_status)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.svs_status = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.svs_status)
	
	#--------------------------------------------------------------------------------------------------------
	# If Success the fetch other values from the response xml
	#--------------------------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.svs_status == "SUCCESS") THEN
	#{
		CUST.INTERFACE.svs_errorMsgFlg = "N"
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<SVSUserModResponse>"
		sv_z = "</SVSUserModResponse>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			
			sv_y = "<SVSUserModRs>"
			sv_z = "</SVSUserModRs>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<Mesg>"
				sv_z = "</Mesg>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.svs_Mesg = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,50)
					print(CUST.INTERFACE.svs_Mesg)
				#}
				ENDIF

				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<responseCode>"
				sv_z = "</responseCode>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.svs_responseCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
					print(CUST.INTERFACE.svs_responseCode)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		
		#}
	ELSE
		#{
		CUST.INTERFACE.svs_errorMsgFlg = "Y"
		IF((CUST.INTERFACE.svs_status == "FAILED") OR (CUST.INTERFACE.svs_status == "FAILURE")) THEN
		#{
			sv_x = CUST.INTERFACE.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.svs_errorCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
				PRINT(CUST.INTERFACE.svs_errorCode)
			#}
			ENDIF
			IF(CUST.INTERFACE.svs_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorDesc>"
				sv_z = "</ErrorDesc>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.svs_errorDesc = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,80)
					PRINT(CUST.INTERFACE.svs_errorDesc)
				#}
				ENDIF
				
			#}
			ENDIF
			IF(CUST.INTERFACE.svs_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorType>"
				sv_z = "</ErrorType>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.svs_ErrorType = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
					PRINT(CUST.INTERFACE.svs_ErrorType)
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		IF((CUST.INTERFACE.svs_errorCode == "") AND (CUST.INTERFACE.svs_errorDesc == "")) THEN
		#{
			CUST.INTERFACE.svs_errorCode = "SYSERR"
			CUST.INTERFACE.svs_errorDesc = "Could not get response from server"
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.INTERFACE.svs_errorMsgFlg)
	
	PRINT(CUST.INTERFACE.svs_errorCode)
	PRINT(CUST.INTERFACE.svs_errorDesc)

	
	
	
	#TRACE OFF
END-->
