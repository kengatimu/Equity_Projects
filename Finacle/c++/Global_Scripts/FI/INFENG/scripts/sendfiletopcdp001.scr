<--START
TRACE ON


#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","SENDPC") == 0) THEN
#{
	CREATECLASS("CUST","SENDPC",5)
#}
ENDIF


#---------------------------------------------------------------------------------------------
# Initialize repository variables
#---------------------------------------------------------------------------------------------
BANCS.INPUT.moduleName  = "SENDFILETOPC"
BANCS.INPUT.parameterId = "SENDPCDIR"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.SENDPC.sendPCDIR = BANCS.OUTPUT.parameterVal
	sv_u = urhk_SetOrbOut("MSG|"+CUST.SENDPC.sendPCDIR)
#}
ELSE
#{
	sv_u = urhk_SetOrbOut("Error|Directory path setup not done in CPARAM")
#}
ENDIF

TRACE OFF
EXITSCRIPT
END-->
