#----------------------------------------------------------------------------------->OD548 collection update start by silvester
	sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.accNum)
	IF(sv_u ==0)then
	#{
		EQOD.GLBDATA.odschmCode=       BANCS.OUTPARAM.schmCode
	#}
	ENDIF
	sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.OperaccNum)
	IF(sv_u ==0)then
	#{
		EQOD.GLBDATA.opschmCode=       BANCS.OUTPARAM.schmCode
	#}
	ENDIF

	if(EQOD.GLBDATA.odschmCode=="OD548")then 
	#{
		callscriptifexist("ODSME_collected.scr")
		exitscript
	#}
	endif  
#----------------------------------------------------------------------------------->OD548 collection update ends by silvester
#Amount Format
        BANCS.INPUT.FinAmt = ltrim(EQOD.GLBDATA.refAmt, ' ')
        sv_t = getposition(BANCS.INPUT.FinAmt, ',')
        if(sv_t != 0) then
                sv_l = mid$(BANCS.INPUT.FinAmt,sv_t,strlen(BANCS.INPUT.FinAmt)-sv_t)
                if (CDOUBLE(sv_l) == 0 ) then
                        EQOD.GLBDATA.refAmt  = mid$(BANCS.INPUT.FinAmt,0,sv_t - 1)
                        print(EQOD.GLBDATA.refAmt)
                else
                        EQOD.GLBDATA.refAmt  = mid$(BANCS.INPUT.FinAmt,0,sv_t - 1) + "" + mid$(BANCS.INPUT.FinAmt,sv_t,strlen(BANCS.INPUT.FinAmt)-sv_t)
                        print(EQOD.GLBDATA.refAmt)
                endif
        else
                EQOD.GLBDATA.refAmt  = BANCS.INPUT.FinAmt
                print(EQOD.GLBDATA.refAmt)
        endif
        if(cdouble(EQOD.GLBDATA.refAmt)<0)then
        #{
                        BANCS.STDIN.msg = "Error_1|Error.1 ^Negative Amount Not Allowed^refAmt"
                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                        sv_z = "SuccessOrFailure|N"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
        #}
        endif
#both loan and operative account validation
        if((EQOD.GLBDATA.funcCode=="P")or(EQOD.GLBDATA.funcCode=="R"))then
        #{
                if(EQOD.GLBDATA.OperaccNum=="")then
                #{
                        BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account^OperaccNum"
