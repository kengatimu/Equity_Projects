<--start
trace on
        lv_b = urhk_B2K_PrintRepos("BANCS")
        print(lv_b)
        if(repexists("EQOD")==0)then
                createrep("EQOD")
        endif
        if(classexists("EQOD","GLBDATA")==0)then
                createclass("EQOD","GLBDATA",5)
        endif
        EQOD.GLBDATA.isrecovYN = "N"
        if(fieldexists(BANCS.INPUT.accNum)==1)then
                print(BANCS.INPUT.accNum)
                EQOD.GLBDATA.accNum = BANCS.INPUT.accNum
        else
                EQOD.GLBDATA.accNum = ""
        endif
        if(fieldexists(BANCS.INPUT.OperaccNum)==1)then
                print(BANCS.INPUT.OperaccNum)
                EQOD.GLBDATA.OperaccNum = BANCS.INPUT.OperaccNum
        else
                EQOD.GLBDATA.OperaccNum = ""
        endif
        if(fieldexists(BANCS.INPUT.refCrncy)==1)then
                print(BANCS.INPUT.refCrncy)
                EQOD.GLBDATA.refCrncy = BANCS.INPUT.refCrncy
        else
                EQOD.GLBDATA.refCrncy = ""
        endif
        if(fieldexists(BANCS.INPUT.refAmt)==1)then
                print(BANCS.INPUT.refAmt)
                EQOD.GLBDATA.refAmt = BANCS.INPUT.refAmt
        else
                EQOD.GLBDATA.refAmt = ""
        endif
        if(fieldexists(BANCS.INPUT.funcCode)==1)then
                print(BANCS.INPUT.funcCode)
                EQOD.GLBDATA.funcCode = BANCS.INPUT.funcCode
        else
                EQOD.GLBDATA.funcCode = ""
        endif
        if(fieldexists(BANCS.INPUT.reshDate)==1)then
