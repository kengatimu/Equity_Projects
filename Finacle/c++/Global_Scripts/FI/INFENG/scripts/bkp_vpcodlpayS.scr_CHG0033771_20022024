                                EQOD.GLBDATA.opcustid = BANCS.OUTPARAM.custId
                                if((EQOD.GLBDATA.opschmType=="SBA")or(EQOD.GLBDATA.opschmType=="CAA")or(EQOD.GLBDATA.opschmType=="CCA"))then
                                #{
                                        print("valid oper account")
                                #}
                                else
                                #{
                                        BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account Scheme Not Allowed^OperaccNum"
                                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                                        sv_z = "SuccessOrFailure|N"
                                        sv_u = urhk_SetOrbOut(sv_z)
                                        exitscript
                                #}
                                endif
                                if((EQOD.GLBDATA.opschmCode=="VA300")or(EQOD.GLBDATA.opschmCode=="SB113")or(EQOD.GLBDATA.opschmCode=="SB114")or(EQOD.GLBDATA.opschmCode=="SB101"))then
                                #{
                                        BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account Scheme Not Allowed^OperaccNum"
                                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                                        sv_z = "SuccessOrFailure|N"
                                        sv_u = urhk_SetOrbOut(sv_z)
                                        exitscript
                                #}
                                endif
                                if((EQOD.GLBDATA.opacctClsFlg!="")and(EQOD.GLBDATA.opacctClsFlg!="N"))then
                                #{
                                        BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account!Closed Account^OperaccNum"
                                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                                        sv_z = "SuccessOrFailure|N"
                                        sv_u = urhk_SetOrbOut(sv_z)
                                        exitscript
                                #}
                                endif
                                if(cdouble(EQOD.GLBDATA.opEffAmt)<=0)then
                                #{
                                        BANCS.STDIN.msg = "Error_1|Error.1 ^Insufficient Fund^OperaccNum"
                                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                                        sv_z = "SuccessOrFailure|N"
                                        sv_u = urhk_SetOrbOut(sv_z)
                                        exitscript
                                #}
                                endif
                        #}
                        else
                        #{
                                BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Operative Account^OperaccNum"
                                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                                sv_z = "SuccessOrFailure|N"
                                sv_u = urhk_SetOrbOut(sv_z)
                                exitscript
                        #}
                        endif
                #}
                endif
                if(EQOD.GLBDATA.accNum=="")then
                #{
                        BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Loan Account^accNum"
                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                        sv_z = "SuccessOrFailure|N"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
                #}
                else
                #{
                        sv_u = urhk_getAcctDetailsInRepository(EQOD.GLBDATA.accNum)
                        if(sv_u ==0)then
                        #{
                                EQOD.GLBDATA.glSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
                                EQOD.GLBDATA.solId     =       BANCS.OUTPARAM.acctSolId
                                EQOD.GLBDATA.schmType  =       BANCS.OUTPARAM.schmType
                                EQOD.GLBDATA.schmCode  =       BANCS.OUTPARAM.schmCode
                                EQOD.GLBDATA.crncyCode =       BANCS.OUTPARAM.acctCrncyCode
                                EQOD.GLBDATA.acctClsFlg        =       BANCS.OUTPARAM.acctCloseflg
                                EQOD.GLBDATA.laclearBalance      = BANCS.OUTPARAM.clearBalance
                                EQOD.GLBDATA.laEffAmt = BANCS.OUTPARAM.EffAvailableAmt
                                EQOD.GLBDATA.lacustid = BANCS.OUTPARAM.custId
                                if(cdouble(EQOD.GLBDATA.refAmt)==cdouble("0"))then
                                        EQOD.GLBDATA.refAmt = cdouble(EQOD.GLBDATA.laclearBalance)
                                endif
                                if(cdouble(EQOD.GLBDATA.refAmt)<0)then
                                        EQOD.GLBDATA.refAmt = -1 * cdouble(EQOD.GLBDATA.refAmt)
                                endif
				if((EQOD.GLBDATA.schmCode=="OD541") or (EQOD.GLBDATA.schmCode=="OD542")or(EQOD.GLBDATA.schmCode=="OD543")or(EQOD.GLBDATA.schmCode=="OD544")or(EQOD.GLBDATA.schmCode=="OD545")or(EQOD.GLBDATA.schmCode=="OD546")or(EQOD.GLBDATA.schmCode=="OD550")or(EQOD.GLBDATA.schmCode=="OD549") or(EQOD.GLBDATA.schmCode=="ML001") or(EQOD.GLBDATA.schmCode=="DL001")or(EQOD.GLBDATA.schmCode=="TBL00")or(EQOD.GLBDATA.schmCode=="OD112"))then
                                #{
                                        EQOD.GLBDATA.isrecovYN = "Y"
                                #}
                                else
                                #{
                                        BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Loan Account^accNum"
                                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                                        sv_z = "SuccessOrFailure|N"
                                        sv_u = urhk_SetOrbOut(sv_z)
                                        exitscript
                                #}
                                endif
                        #}
                        else
                        #{
                                BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Loan Account^accNum"
                                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                                sv_z = "SuccessOrFailure|N"
                                sv_u = urhk_SetOrbOut(sv_z)
                                exitscript
                        #}
                        endif
                #}
                endif
        #}
        endif
#cif validation
        print(EQOD.GLBDATA.lacustid)
        print(EQOD.GLBDATA.opcustid)
        if(EQOD.GLBDATA.lacustid!=EQOD.GLBDATA.opcustid)then
        #{
                BANCS.STDIN.msg = "Error_1|Error.1 ^CifId Mismatch Recovery Not Allowed^accNum"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
        #}
        endif
#due amount validation
        print(EQOD.GLBDATA.laclearBalance)
        print(EQOD.GLBDATA.laEffAmt)
        if(cdouble(EQOD.GLBDATA.laEffAmt)>=0)then
        #{
                ##BANCS.STDIN.msg = "Error_1|Error.1 ^No due for the Loan^accNum"
                ##sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                ##sv_z = "SuccessOrFailure|N"
                ##sv_u = urhk_SetOrbOut(sv_z)
                ##exitscript
        #}
        endif
        if(cdouble(EQOD.GLBDATA.laclearBalance)>=0)then
        #{
                BANCS.STDIN.msg = "Error_1|Error.1 ^No due for the Loan^accNum"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
        #}
        endif

#Agent Float Recovery
        if(EQOD.GLBDATA.schmCode=="OD541")then
        #{
                callscriptifexist("vpcodlpayAgentFloat.scr")
                exitscript
        #}
        endif
#Ecosystem/Merchant Loan Recovery
        if((EQOD.GLBDATA.schmCode=="OD549")or(EQOD.GLBDATA.schmCode=="ML001") or(EQOD.GLBDATA.schmCode=="DL001")or(EQOD.GLBDATA.schmCode=="TBL00"))then
        #{
                callscriptifexist("vpcodlpayEcoMerloan.scr")
                exitscript
        #}
        endif
#Oper avail amount validation
        if(cdouble(EQOD.GLBDATA.opEffAmt)<cdouble(EQOD.GLBDATA.refAmt))then
        #{
                BANCS.STDIN.msg = "Error_1|Error.1 ^Recovery amount is more than available amount^refAmt"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
        #}
        endif
        if(EQOD.GLBDATA.isrecovYN=="Y")then
        #{
                sv_q = urhk_B2k_ForacidToAcid(EQOD.GLBDATA.accNum)
                if(sv_q==0)then
                #{
                        EQOD.GLBDATA.LoanAcid = BANCS.OUTPARAM.Acid
                #}
                else
                #{
                        EQOD.GLBDATA.LoanAcid = ""
                #}
                endif
                lv_d = " dmdCnt | select count(*) from custom.odla_dmd_tbl where bank_id=?SVAR "
                lv_d = lv_d + " and od_acid = ?SVAR "
                lv_d = lv_d + " and dmd_amt-tot_adj_amt <> 0 "
                lv_d = lv_d + " and entity_cre_flg='Y' and del_flg='N' "
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQOD.GLBDATA.LoanAcid
                print(BANCS.INPARAM.BINDVARS)
                print(lv_d)
                lv_s = urhk_dbSelectWithBind(lv_d)
                if(lv_s==0)then
                #{
                        EQOD.GLBDATA.dmdCnt = BANCS.OUTPARAM.dmdCnt
                #}
                else
                #{
                        EQOD.GLBDATA.dmdCnt = "0"
                #}
                endif
                if((cdouble(EQOD.GLBDATA.dmdCnt)<=0)and(cdouble(EQOD.GLBDATA.laclearBalance)>=0))then
                #{
                        BANCS.STDIN.msg = "Error_1|Error.1 ^Loan Recovery not allowed ! No Active demamds for the account^accNum"
                        sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                        sv_z = "SuccessOrFailure|N"
                        sv_u = urhk_SetOrbOut(sv_z)
                        exitscript
                #}
                endif
                sv_u = urhk_getFileLocation("COM|vpcodlpay.com")
                print(sv_u)
                print(BANCS.OUTPARAM.fileLocation)
                if(sv_u == 0)then
                #{
                        sv_a = "LoanAcctId|" + EQOD.GLBDATA.accNum
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "OperAcctNum|" + EQOD.GLBDATA.OperaccNum
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "RecoverAmt|" + EQOD.GLBDATA.refAmt
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "FunctionC|" + EQOD.GLBDATA.funcCode
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "stuserId|" + BANCS.STDIN.userId
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "bankId|" + BANCS.STDIN.contextBankId
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        sv_a = "EventType|ONSPAY"
                        sv_u = urhk_putEnvForCallShellScript(sv_a)
                        print(sv_u)
                        BANCS.INPARAM.scriptName = "vpcodlpay.com"
                        BANCS.INPARAM.arguments = ""
                        sv_u = urhk_CallShellScript("b")
                        print(sv_u)
                        if(sv_u != 0)then
                        #{
                                print("failed")
                        #}
                        else
                        #{
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
                                EQOD.GLBDATA.msg = "Loan Payment Initiated Successfully. Please Visit HPR Menu in While"
                                sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
                                print(sv_c)
                                exitscript
                        #}
                        endif
                #}
                endif
        #}
        endif

