<--START
CHECKSUM="8668700b5491d9020e3f7cb33ca70549c0a1024090d815dd2d5f6632b9a831bd"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Initializing required variables
	#------------------------------------------------------------------------------
	CUST.DATA.recordCount	= ""
	BANCS.INPARAM.BINDVARS = ""
	
	#------------------------------------------------------------------------------
	# Getting values from frontend
	#------------------------------------------------------------------------------
	sv_a=urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode")
	PRINT(sv_a)
	IF(sv_a == 0)THEN
	#{
		CUST.DATA.schmcode=BANCS.OUTPARAM.srvValue
		print(CUST.DATA.schmcode)
		#}
	ELSE
		#{
		CUST.DATA.errMsg = "Error in getting scheme code"
		exitscript
	#}
	ENDIF
	
	
	
	#-------------------------------------------------------------------------------------------------------
	# Getting no.of records count
	#-------------------------------------------------------------------------------------------------------
	sv_u = "recordCount|"
	sv_u = sv_u + " select count(*) "
	sv_u = sv_u + " from tbaadm.pdt "
	sv_u = sv_u + " where bank_id = ?SVAR AND del_flg='N'"
	sv_u = sv_u + " AND schm_code= ?SVAR AND mandatory_flg='Y'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.schmcode
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.DATA.recordCount =BANCS.OUTPARAM.recordCount
		PRINT(CUST.DATA.recordCount)
		#}
	ELSE
		#{
		CUST.DATA.errMsg = "Error in getting record count"
		exitscript
	#}
	ENDIF
	
	sv_l = 0
	WHILE (sv_l < CINT(CUST.DATA.recordCount))
	#{
		sv_r = "<rec_" + Format$(sv_l,"%d") + ">"
		PRINT(sv_r)
		
		#------------------------------------------------------------------------------
		# getting frontend values
		#------------------------------------------------------------------------------
		
		sv_u=urhk_SRV_GetVal("acctCommonInfo.acctDocument.acctDocumentLL." + sv_r + ".freeText1")
		sv_z=BANCS.OUTPARAM.srvValue
		print(sv_z)
		
		sv_u=urhk_SRV_GetVal("acctCommonInfo.acctDocument.acctDocumentLL." + sv_r + ".receivedDate")
		sv_n=BANCS.OUTPARAM.srvValue
		print(sv_n)
		
		IF ((sv_z != "") AND (sv_n == "")) THEN
		#{
			
			sv_y=urhk_SRV_SetErr("acctCommonInfo.acctDocument.acctDocumentLL." + sv_r + ".receivedDate|ENTER RECEIVED DATE")
			BANCS.OUTPUT.successOrFailure="F"
			exitscript
			
		#}
		ENDIF
		
		sv_l = sv_l + 1
		PRINT(sv_l)
	#}
	DO
	
	
	
	
	
	TRACE OFF
	EXITSCRIPT
END-->
