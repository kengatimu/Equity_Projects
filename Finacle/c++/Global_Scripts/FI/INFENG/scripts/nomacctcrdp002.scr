#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- 
#	Name			: nomacctcrdp002.scr
#	Description		: This script is used to create Nominal Accounts
#	Date			: 21-02-2013
#	Author			: GOKULKRISHNA
#	Input			: NA
#	Output			: NA
#	Called Script	: nomacctcrdp001.scr
#	Calling Scrip	: NA
#	Menu Option		: CGLSNOM
#	Srl. No			Date			Author			Description.
#	-------			---------		-------			---------------
#	1.0				21-02-2013		GOKULKRISHNA	Original Version
#	2.0				12-08-2013		Vijaya V	Fetch Customer Name-TOL - 366700
#------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="7a9945595f3d31558846b8853dcba824fcddae9727f24a22a7273cc0eb90b7be"
	TRACE ON
	
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------
	# CONTEXT SOL ID OF USER
	#---------------------------------------------------------------------------------
	CUST.DATA.solid = BANCS.STDIN.mySolId
	PRINT(CUST.DATA.solid)
	
	CUST.DATA.foracid  = ""
	
	#---------------------------------------------------------------------------------
	# GL Sub Head Code to be used for A/c opening is fetched from CGCPM setup
	#---------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "NOMACCNTCRTN"
	BANCS.INPUT.parameterId = "GLSUBHEAD"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.glSubHead = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.glSubHead = ""
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	# To get a SysDate
	#-------------------------------------------------------------------------------
	sv_s = "timestamp|SELECT TO_CHAR(SYSDATE,'DDMMYYHHMMSS') "
	sv_s =  sv_s + "FROM DUAL"
	PRINT(sv_s)
	sv_u = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	IF (sv_u ==0) THEN
	#{
		CUST.DATA.timestamp = BANCS.OUTPARAM.timestamp
		PRINT(CUST.DATA.timestamp)
	#}
	ENDIF
	
	CUST.DATA.nomRpt 	 = "Nominal_" + CUST.DATA.timestamp + ".lst"
	CUST.DATA.successMrt = "Nominal_" + CUST.DATA.timestamp + ".rpt"
	CUST.DATA.successOrFailure 	= BANCS.OUTPUT.successOrFailure
	PRINT(CUST.DATA.successMrt)
	
	#---------------------------------------------------------------------------------
	# FETCHING CUSTOM DATA
	#---------------------------------------------------------------------------------
	sv_s = "cifId,schmCode1,schmCode2,crncyCode,sbAcct1,sbAcct2,acctMgr,pfNo,memId,grpNo,brwType|"
	sv_s = sv_s + " SELECT cIF_id,schm_code_1,schm_code_2,crncy_code,sb_account_1,sb_account_2,acct_mgr,pf_no,member_id,grp_reg_no,borrowing_type"
	sv_s = sv_s + " FROM CUSTOM.IGLS_NOM_ACCT_CRE_TABLE"
	sv_s = sv_s + " WHERE del_flg='N'"
	sv_s = sv_s + " AND (sb_account_1 IS NULL OR sb_account_2 IS NULL)"
	sv_s = sv_s + " AND status IN ('R','A')"
	sv_s = sv_s + " AND cif_id IS NOT NULL"
	sv_s = sv_s + " AND sol_id = ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	PRINT (sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.solid + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF (sv_c !=0) THEN
	#{
		PRINT("Error Occured in Cursor")
		EXITSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.DATA.cursorNum)
		sv_c = urhk_dbCursorFetch(CUST.DATA.cursorNum)
		PRINT(sv_c)
		IF(sv_c == 0) THEN
		#{
			WHILE(sv_c == 0)
			#{
				#---------------------------------------------------------------------------------
				#ASSIGNING VALUES
				#---------------------------------------------------------------------------------
				CUST.DATA.cifId = BANCS.OUTPARAM.cifId
				PRINT(CUST.DATA.cifId)
				CUST.DATA.crncyCode=BANCS.OUTPARAM.crncyCode
				PRINT(CUST.DATA.crncyCode)
				CUST.DATA.schmCode1=BANCS.OUTPARAM.schmCode1
				PRINT(CUST.DATA.schmCode1)
				CUST.DATA.schmCode2=BANCS.OUTPARAM.schmCode2
				PRINT(CUST.DATA.schmCode2)
				CUST.DATA.sbAcct1=BANCS.OUTPARAM.sbAcct1
				PRINT(CUST.DATA.sbAcct1)
				CUST.DATA.sbAcct2=BANCS.OUTPARAM.sbAcct2
				PRINT(CUST.DATA.sbAcct2)
				CUST.DATA.acctMgr=BANCS.OUTPARAM.acctMgr
				PRINT(CUST.DATA.acctMgr)
				CUST.DATA.pfNo=BANCS.OUTPARAM.pfNo
				PRINT(CUST.DATA.pfNo)
				CUST.DATA.memId=BANCS.OUTPARAM.memId
				PRINT(CUST.DATA.memId)
				CUST.DATA.grpNo=BANCS.OUTPARAM.grpNo
				PRINT(CUST.DATA.grpNo)
				CUST.DATA.brwType=BANCS.OUTPARAM.brwType
				PRINT(CUST.DATA.brwType)
				
				############################################################
				# TOL - 366700, to pass Customer Name
				############################################################
				sv_s = "accName,shrtName|SELECT CUST_NAME, CUST_SHORT_NAME "
				sv_s = sv_s + " FROM TBAADM.CMG "
				sv_s = sv_s + " WHERE del_flg ='N' "
				sv_s = sv_s + " AND ENTITY_CRE_FLG= 'Y' "
				sv_s = sv_s + " AND CIF_ID =  ?SVAR "
				sv_s = sv_s + " AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.DATA.cifId  + "|"  + BANCS.STDIN.contextBankId
				PRINT(sv_s)
				
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					CUST.DATA.accName=BANCS.OUTPARAM.accName
					PRINT(CUST.DATA.accName)
					CUST.DATA.shrtName=BANCS.OUTPARAM.shrtName
					PRINT(CUST.DATA.shrtName)
					
					#}
				ELSE
					#{
					print("Invalid CIF ID")
				#}
				ENDIF
				
				sv_z=1
				PRINT(CUST.DATA.sbAcct1)
				IF (CUST.DATA.sbAcct1 != "") THEN
				#{
					sv_z = 2
				#}
				ENDIF
				PRINT(sv_z)
				
				WHILE(sv_z <= 2)
				#{
					IF (sv_z == 1) THEN
					#{
						CUST.DATA.schmCode=CUST.DATA.schmCode1
						PRINT(CUST.DATA.schmCode)
						CUST.DATA.acctnum = "SB_ACCOUNT_1"
					#}
					ENDIF
					IF (sv_z == 2) THEN
					#{
						CUST.DATA.schmCode = CUST.DATA.schmCode2
						PRINT(CUST.DATA.schmCode)
						CUST.DATA.acctnum = "SB_ACCOUNT_2"
					#}
					ENDIF
					CUST.DATA.verCnt = sv_z
					PRINT(CUST.DATA.verCnt)
					
					#-------------------------------------------------------------------------------------------------------
					# Interest Table Code is fetched from the value set at the scheme level
					#-------------------------------------------------------------------------------------------------------
					sv_s = "intTblCode"
					sv_s = sv_s + "|"
					sv_s = sv_s + " SELECT int_tbl_code "
					sv_s = sv_s + " FROM TBAADM.CSP"
					sv_s = sv_s + " WHERE schm_code = ?SVAR"
					sv_s = sv_s + " AND bank_id = ?SVAR"
					sv_s = sv_s + " AND del_flg = 'N'"
					sv_s = sv_s + " AND crncy_code = ?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.DATA.schmCode1 + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_u)
					IF (sv_u == 0) THEN
					#{
						CUST.DATA.intTblCode = BANCS.OUTPARAM.intTblCode
						#				    CUST.DATA.intTblCode = "INTOD"
						PRINT(CUST.DATA.intTblCode)
						#}
					ELSE
						#{
						sv_m = "Error: urhk_dbSelect failed"
						
					#}
					ENDIF
					
					
					#-------------------------------------------------------------------------------------------------------
					# Setting inputs for the service to open an SBA account
					#-------------------------------------------------------------------------------------------------------
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.custId.cifId|" + CUST.DATA.cifId)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.intTblCode.tblCode|" + CUST.DATA.intTblCode)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.glSubHeadCode|" + CUST.DATA.glSubHead)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUST.DATA.schmCode)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.custId.cifId|" + CUST.DATA.cifId)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctName|" + CUST.DATA.accName)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctShortName|" + CUST.DATA.shrtName)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctOpnDate|" + BANCS.STDIN.BODDate)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId|" + BANCS.STDIN.mySolId)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.schmCode.schmCode|" + CUST.DATA.schmCode)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.wtaxFlg.code|N")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.peggedFlg|N")
					PRINT(sv_u)
					
					
					
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.pbPsCode.code|S")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.localCalFlg|N")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.despatchMode.code|P")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psFreq.type|Y")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psFreq.startDd|31")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psFreq.hldyStat|N")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.intCrAcctFlg.code|S")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.intDrAcctFlg.code|S")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqDr.type|Y")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqDr.startDd|31")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.intCalcFreqDr.hldyStat|N")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.wtaxAmountScopeFlg.code|P")
					PRINT(sv_u)

					sv_u = "lastday|"
					sv_u = sv_u + "SELECT TO_CHAR (LAST_DAY,'DD-MM-YYYY') FROM ( SELECT  TRUNC (SYSDATE, 'YEAR')  first_day, ADD_MONTHS ( TRUNC (SYSDATE, 'YEAR') , 12 ) - 1 last_day FROM dual) "
					print(sv_u)

					sv_w =  urhk_dbSelectWithBind(sv_u)
					print(sv_w)

					 IF (sv_w==0) THEN
						#{
						CUST.DATA.lastday=BANCS.OUTPARAM.lastday
						print(CUST.DATA.lastday)
					ELSE
						CUST.DATA.lastday=BANCS.STDIN.BODDate
						print(CUST.DATA.lastday)
					ENDIF

					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.nextIntRunDateCr|" +CUST.DATA.lastday)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.basicInterest.nextIntRunDateDr|" +BANCS.STDIN.BODDate)
					PRINT(sv_u)
					sv_u =urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.acctClassMISCEntered|1")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.schmType|SBA")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.industryType.refCode|2JB")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText14|IGLSGRPMEMBER")
					PRINT(sv_u)
					
					sv_m=CUST.DATA.grpNo+"-"+CUST.DATA.memId
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText15|" + sv_m)
					PRINT(sv_u)
					
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.modeOfOperCode.refCode|OTH")
					PRINT(sv_u)
					sv_u=urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.dailyCompIntFlg.code|N")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkOut("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|foracid")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkOut("acctCommonInfo.acctGeneralInfo.acctBasic.acid|acid")
					print(sv_u)
					
					
					
					#-------------------------------------------------------------------------------------------------------
					# Calling service to open SBA account
					#-------------------------------------------------------------------------------------------------------
					sv_u = urhk_ExecSrv("SRV_OpenSBAcctAndVerify|same_user_verify = Y")
					PRINT(sv_u)
					
					
					print(BANCS.OUTPARAM.acid)
					print(BANCS.OUTPARAM.foracid)
					
				
					
					IF (sv_u == 0) THEN
					#{
						CUST.DATA.foracid = BANCS.OUTPARAM.foracid
						PRINT(CUST.DATA.foracid)
						print(CUST.DATA.cifId)
						print(CUST.DATA.schmCode)
						sv_b = "echo '"+ CUST.DATA.cifId + "|" + CUST.DATA.foracid +  "|" +  CUST.DATA.schmCode +"'>>"+ CUST.DATA.nomRpt
						PRINT(sv_b)
						sv_d= SYSTEM(sv_b)
						PRINT(sv_d)
						#}
					ELSE
						#{
						
						
						CUST.DATA.foracid = ""
						
						
						IF (sv_u != 0) THEN
						#{
							IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
							#{
								print(BANCS.OUTPARAM.Error_num)
								sv_v = BANCS.OUTPARAM.Error_num
								#}
							ELSE
								#{
								sv_v = 0
							#}
							ENDIF
							
							IF (sv_v > 0) THEN
							#{
								sv_i = 1
								WHILE (sv_i <= sv_v)
								#{
									sv_f = FORMAT$(sv_i,"%d")
									sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
									print(sv_e)
									sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
									print(sv_e)
									sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
									print(sv_e)
									sv_i = sv_i + 1
								#}
								DO
							#}
							ENDIF
						#}
						ENDIF
						
						
						
						
						EXITSCRIPT
					#}
					ENDIF
					
					#---------------------------------------------------------------------------------
					# THIS STEP IS USED TO DISPLAY GENERATED CUSTOMER ACCOUNT
					#---------------------------------------------------------------------------------
					PRINT(CUST.DATA.cifId)
					
					sv_s = "UPDATE CUSTOM.IGLS_NOM_ACCT_CRE_TABLE SET "+ CUST.DATA.acctnum
					sv_s = sv_s + " = ?SVAR ,acct_cre_user =?SVAR"
					sv_s = sv_s + " ,acct_cre_time = SYSDATE , acct_open_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
					sv_s = sv_s + " ,lchg_time = SYSDATE , lchg_user = ?SVAR"
					sv_s = sv_s + " ,status = 'A' ,verify_cnt = ?SVAR"
					sv_s = sv_s + " WHERE cif_id = ?SVAR "
					sv_s = sv_s + " AND crncy_code = ?SVAR"
					
					IF (CUST.DATA.brwType == "M") THEN
					#{
						sv_s = sv_s + " AND MEMBER_ID = ?SVAR"
						PRINT("1")
					#}
					ENDIF
					
					IF (CUST.DATA.brwType == "G") THEN
					#{
						sv_s = sv_s + " AND GRP_REG_NO = ?SVAR"
						PRINT("2")
					#}
					ENDIF
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.userId + "|" + LEFT$(BANCS.STDIN.BODDate,10) + "|" + BANCS.STDIN.userId+"|" + CUST.DATA.verCnt + "|" + CUST.DATA.cifId + "|" + CUST.DATA.crncyCode
					PRINT(BANCS.INPARAM.BINDVARS)
					
					IF (CUST.DATA.brwType == "M") THEN
					#{
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.memId
						PRINT(BANCS.INPARAM.BINDVARS)
					#}
					ENDIF
					IF (CUST.DATA.brwType == "G") THEN
					#{
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.grpNo
						PRINT(BANCS.INPARAM.BINDVARS)
					#}
					ENDIF
					
					sv_u = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_u)
					IF (sv_u == 0) THEN
					#{
						sv_u = urhk_dbSQLWithBind("commit")
						PRINT(sv_u)
						#}
					ELSE
						#{
						PRINT("Error Occured during Update")
					#}
					ENDIF
					
					#---------------------------------------------------------------------------------
					# ITERATING THE LOOP
					#---------------------------------------------------------------------------------
					PRINT(sv_z)
					PRINT(CUST.DATA.sbAcct2)
					IF (sv_z == 1) THEN
					#{
						PRINT(CUST.DATA.sbAcct2)
						IF (CUST.DATA.sbAcct2 == "") THEN
						#{
							sv_z = sv_z + 1
							#}
						ELSE
							#{
							sv_z = sv_z + 2
						#}
						ENDIF
						#}
					ELSE
						#{
						sv_z = sv_z + 2
					#}
					ENDIF
				#}
				DO
				
				sv_c = urhk_dbCursorFetch(CUST.DATA.cursorNum)
			#}
			DO
			#}
		ELSE
			#{
			sv_b = "echo '"+ "" + "|" + "" +  "|" + ""  +"'>>"+ CUST.DATA.nomRpt
			PRINT(sv_b)
			sv_d= SYSTEM(sv_b)
			PRINT(sv_d)
		#}
		ENDIF
		
		IF (CUST.DATA.foracid != "" ) THEN
		#{
			sv_e = "RESULT_MSG|The Account Number generation initiated"
			PRINT(sv_e)
			sv_u = urhk_SetOrbOut(sv_e)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			PRINT(sv_u)
			
		#}
		ENDIF
		
		sv_c = urhk_dbCursorClose(CUST.DATA.cursorNum)
		sv_f = SYSTEM("mrbx4001  nomacctcr.mrt "  + CUST.DATA.nomRpt + " " + CUST.DATA.successMrt)
		PRINT(sv_f)
		IF (sv_f == 0) THEN
		#{
			BANCS.INPUT.rptFileName = CUST.DATA.successMrt
			PRINT(BANCS.INPUT.rptFileName)
			BANCS.INPUT.rptTitle = "NOMINAL ACCOUNT CREATION"
			PRINT(BANCS.INPUT.rptTitle)
			sv_s = "babx4040  $B2K_SESSION_ID "
			sv_s = sv_s + "'" + BANCS.INPUT.rptFileName + "' "
			sv_s = sv_s + "'" + BANCS.INPUT.rptTitle + "'"
			sv_s = sv_s + " MANAGER 1 N"
			PRINT(sv_s)
			sv_r = SYSTEM(sv_s)
			PRINT(sv_r)
		#}
		ENDIF
		
	#}
	ENDIF
	
	TRACE OFF
	EXITSCRIPT
END-->
