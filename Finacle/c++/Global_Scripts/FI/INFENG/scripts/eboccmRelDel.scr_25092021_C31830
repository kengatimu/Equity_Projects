        CUST.HOCCM.ClientCode = "KEEQB"
        CUST.HOCCM.CountryCode = "KE"
        CUST.HOCCM.UserName = TRIM(BANCS.STDIN.userId)
        if(CUST.HOCCM.eventMode=="RELEASE")then
                if(CUST.HOCCM.d1TranId!="")then
                        CUST.HOCCM.FinnTranId = CUST.HOCCM.d1TranId
                endif
                if(CUST.HOCCM.d2CBStranId!="")then
                        CUST.HOCCM.FinnTranId = CUST.HOCCM.d2CBStranId
                endif
        endif
        if((CUST.HOCCM.eventMode=="CANCEL")or(CUST.HOCCM.eventMode=="DELETE"))then
                if(CUST.HOCCM.d1TranId!="")then
                        CUST.HOCCM.FinnTranId = CUST.HOCCM.d1TranId
                endif
                if(CUST.HOCCM.d2CBStranId!="")then
                        CUST.HOCCM.FinnTranId = CUST.HOCCM.d2CBStranId
                endif
        endif
        BANCS.INPARAM.Day=LEFT$(BANCS.STDIN.sysDate,2)
        BANCS.INPARAM.Month=MID$(BANCS.STDIN.sysDate,3,2)
        BANCS.INPARAM.Year=MID$(BANCS.STDIN.sysDate,8,2)
        BANCS.INPARAM.Hour=MID$(BANCS.STDIN.sysDate,11,2)
        BANCS.INPARAM.Minute=MID$(BANCS.STDIN.sysDate,14,2)
        BANCS.INPARAM.Second=MID$(BANCS.STDIN.sysDate,17,2)
        BANCS.INPARAM.SYSDATE=BANCS.INPARAM.Second+BANCS.INPARAM.Minute+BANCS.INPARAM.Day+BANCS.INPARAM.Month+BANCS.INPARAM.Year
        BANCS.INPARAM.MESSAGEDATETIME           = "2013-04-24T15:30:30.910"
        BANCS.INPARAM.CHANNELID                 = "COR"
        BANCS.INPARAM.TIMEZONE                  = "GMT+05:30"
        BANCS.INPARAM.BANKID                    = BANCS.STDIN.contextBankId
        if(CUST.HOCCM.eventMode=="RELEASE")then
        BANCS.INPARAM.ServiceReqId              = "VPHReleaseCheque" 
	CUST.HOCCM.RequestUUID                ="VPH-REL"+ BANCS.INPARAM.SYSDATE
	endif
        if((CUST.HOCCM.eventMode=="CANCEL")or(CUST.HOCCM.eventMode=="DELETE"))then
        BANCS.INPARAM.ServiceReqId              = "VPHDeleteCheque" 
	CUST.HOCCM.RequestUUID                ="VPH-DEL"+ BANCS.INPARAM.SYSDATE
	endif
        BANCS.INPARAM.SERVICEREQUESTVERSION     = "10.2" 
        BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
        BANCS.INPARAM.SEND_RECV_FLG             = "R"
	CUST.HOCCM.productcode = CUST.HOCCM.ProductCode 
	CUST.HOCCM.client_code = CUST.HOCCM.ClientCode 
	CUST.HOCCM.country_code = CUST.HOCCM.CountryCode 
	CUST.HOCCM.username = CUST.HOCCM.UserName 
	CUST.HOCCM.tranid = CUST.HOCCM.FinnTranId 
	CUST.HOCCM.XmlMessage = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"				
