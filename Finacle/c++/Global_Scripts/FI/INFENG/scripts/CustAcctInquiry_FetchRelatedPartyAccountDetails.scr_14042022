<--start
trace on

#CALL("Common_Interface_CreateRepos.scr")
#sv_u = urhk_b2k_printrepos("BANCS")
#print(sv_u)
#CUST.INTERFACE.accountID = BANCS.INPUT.CustomerID 

print(CUST.INTERFACE.customerID)

sv_s = "foracid,acid,Role,mandate,acctname,cif|select foracid,a.acid,ACCT_POA_AS_REC_TYPE,mode_of_oper_code,acct_name,cif_id  from tbaadm.aas a, tbaadm.gam g " 
sv_s = sv_s + " where NMA_KEY_ID =?SVAR and g.bank_id =?SVAR and a.acid = g.acid and a.bank_id =g.bank_id and ACCT_POA_AS_REC_TYPE <>'M' and a.del_flg = 'N' "
print(sv_s)
BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbCursorOpenWithBind(sv_s)
if(sv_d == 0)then
	sv_c = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_c)
	sv_z = urhk_dbCursorFetch(sv_c)
	sv_q = 0
	while(sv_z == 0)
		sv_q = sv_q + 1
		sv_v = "foracid_" + FORMAT$(sv_q, "%d")
		print(sv_v)
                ("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.foracid

		sv_v = "Role_" + FORMAT$(sv_q, "%d")
		print(sv_v)
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.Role
		
		sv_v = "mandate_" + FORMAT$(sv_q, "%d")
		print(sv_v)
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.mandate

		sv_v = "acid_" + FORMAT$(sv_q, "%d")
		print(sv_v)
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acid

		sv_v = "cif_" + FORMAT$(sv_q, "%d")
		print(sv_v)
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.cif

		sv_v = "acctname_" + FORMAT$(sv_q, "%d")
		print(sv_v)
		("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctname

		sv_b = urhk_getAcctDetailsInRepository(BANCS.OUTPARAM.foracid)
		if(sv_b == 0) then
			
			sv_v = "acctSolId_" + FORMAT$(sv_q, "%d")
			print(sv_v)
			("CUST").("INTERFACE").(sv_v)= BANCS.OUTPARAM.acctSolId

			sv_v = "acctCrncyCode_" + FORMAT$(sv_q, "%d")
			print(sv_v)		
			("CUST").("INTERFACE").(sv_v)=  BANCS.OUTPARAM.acctCrncyCode

			#sv_v = "acctName_" + FORMAT$(sv_q, "%d")
			#print(sv_v)		     
			#("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctName
			
			sv_v = "schmCode_" + FORMAT$(sv_q, "%d")
			print(sv_v)	
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.schmCode

			sv_v = "schmType_" + FORMAT$(sv_q, "%d")
			print(sv_v)		       
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.schmType

			#sv_v = "cifId_" + FORMAT$(sv_q, "%d")
			#print(sv_v)
			#("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.cifId			 
			
			sv_v = "acctOpenDate_" + FORMAT$(sv_q, "%d")
			print(sv_v)
			("CUST").("INTERFACE").(sv_v) = Mid$(BANCS.OUTPARAM.acctOpenDate,0,10)	
			
			sv_v = "EffAvailableAmt_" + FORMAT$(sv_q, "%d")
			print(sv_v)
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.EffAvailableAmt

			sv_v = "acctCloseflg_" + FORMAT$(sv_q, "%d")
			print(sv_v)
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctCloseflg
			
			sv_v = "acctOwnership_" + FORMAT$(sv_q, "%d")
			print(sv_v)
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctOwnerShip

			sv_v = "freezeCode_" + FORMAT$(sv_q, "%d")
			print(sv_v)
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.freezeCode
			
		endif
		BANCS.INPARAM.acid = BANCS.OUTPARAM.acid
		sv_n = urhk_getAcctStatus("")
                if(sv_n == 0)then
			sv_v = "AccountStatus_" + FORMAT$(sv_q, "%d")
			print(sv_v)
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctStatus
                endif

		sv_z = urhk_dbCursorFetch(sv_c)
	DO
	sv_z = urhk_dbCursorClose(sv_c)
	CUST.INTERFACE.accountCount = sv_q
	print(CUST.INTERFACE.accountCount)
endif

sv_q = 0 
print(sv_q)
print(CINT(CUST.INTERFACE.accountCount))
WHILE(sv_q < CINT(CUST.INTERFACE.accountCount))
	sv_q = sv_q + 1

	sv_v = "foracid_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountID| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "acctname_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountName| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)	

	sv_v = "cif_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.CIFId| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "acid_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.Acid| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	
	sv_v = "acctSolId_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.BranchCode| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "acctCrncyCode_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.Currency| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_v = "schmCode_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.SchemeCode| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "schmType_" + FORMAT$(sv_q, "%d")
	print(sv_v)		       
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.SchemeType| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "acctOpenDate_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.AcctOpenDate| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "acctCloseflg_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountClosureFlag| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "EffAvailableAmt_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.ClearBalance| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "AccountStatus_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountStatus| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "freezeCode_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.FreezeCode| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "acctOwnership_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountOwnership| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)
	
	sv_v = "Role_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.Signatory| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

	sv_v = "mandate_" + FORMAT$(sv_q, "%d")
	print(sv_v)
	sv_t = "CustAcctInquiry_RES.RelatedAcc.<rec_" + FORMAT$(sv_q,"%d") + ">.ModeOfOperation| " + ("CUST").("INTERFACE").(sv_v)
	sv_u = urhk_SetOrbOut(sv_t)

print(sv_q)
#sv_q = sv_q + 1
print(sv_q)
