	#}
	endif

	sv_s = "roleid, workclass|select role_id, user_work_class from tbaadm.upr  "
	sv_s = sv_s + "where home_bank_ID=?SVAR and user_id=?SVAR "
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.userid
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	IF (sv_r ==0) THEN
	#{
		CUST.DD.roleid= BANCS.OUTPARAM.roleid
		print (CUST.DD.roleid)
		CUST.DD.workclass= BANCS.OUTPARAM.workclass
		print (CUST.DD.workclass)

		IF(CUST.DD.process=="M")THEN
		#{
			sv_s =" tranlimit | select TRAN_AMT from CUSTOM.Role_lIMits where role_id= ?SVAR  and WORK_CLASS =?SVAR  and bank_id =?SVAR and CRNCY =?SVAR and rownum ='1'  "
			BANCS.INPARAM.BINDVARS = CUST.DD.roleid + "|" + CUST.DD.workclass  + "|" + BANCS.STDIN.contextBankId   + "|" + CUST.DD.crncy
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			if(sv_d == 0)then
			#{
				CUST.DD.tranlimit = BANCS.OUTPARAM.tranlimit
				print (CUST.DD.tranlimit)
				CUST.DD.intersolTransferLimit = " "

				sv_t = "transferLimit| " +CUST.DD.tranlimit
				sv_u = urhk_SetOrbOut(sv_t)
				sv_p = "intersolTransferLimit| " +CUST.DD.intersolTransferLimit
				sv_u = urhk_SetOrbOut(sv_p)
			#}
			else
			#{
   				CUST.DD.errMsg="Limits for the role and userworclass not maintained"
				sv_t = "Msg| " +CUST.DD.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDSCRIPT	

			#}
			endif

		#}
		ELSE
		#{
			sv_s = "transferLimit, intersolTransferLimit|select USER_XFER_DR_LIM, USER_INTERSOL_XFER_DR_LIMIT from tbaadm.RCL  "
			sv_s = sv_s + "where bank_id=?SVAR and role_id=?SVAR and crncy_code=?SVAR "
	
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.roleid + "|" + CUST.DD.crncy
