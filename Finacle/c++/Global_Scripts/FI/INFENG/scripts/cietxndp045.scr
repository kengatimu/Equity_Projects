<--START
CHECKSUM="bf7bfe5d3b74d28772c22296c815024103c47969e46375e278f194cc2e3d85e4"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.acctNum = " "
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.acctNumEntityId = " "
	CUST.CIETXN.acctNumSolId = " "
	CUST.CIETXN.acctNumCcy = " "
	CUST.CIETXN.acctName = " "
	CUST.CIETXN.entityCreFlg = " "
	CUST.CIETXN.acctClsFlg = " "
	CUST.CIETXN.schmType = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
		#{
			CUST.CIETXN.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
			print(CUST.CIETXN.acctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctNumEntityId,acctNumSolId,acctNumCcy,acctName,entityCreFlg,acctClsFlg,schmType|"
	sv_s = sv_s + " SELECT BANK_ID,SOL_ID,ACCT_CRNCY_CODE,ACCT_NAME,ENTITY_CRE_FLG,ACCT_CLS_FLG,SCHM_TYPE"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.acctNum
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.acctNumEntityId = BANCS.OUTPARAM.acctNumEntityId
		print(CUST.CIETXN.acctNumEntityId)
		CUST.CIETXN.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
		print(CUST.CIETXN.acctNumSolId)
		CUST.CIETXN.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
		print(CUST.CIETXN.acctNumCcy)
		CUST.CIETXN.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CIETXN.acctName)
		CUST.CIETXN.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		print(CUST.CIETXN.entityCreFlg)
		CUST.CIETXN.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
		print(CUST.CIETXN.acctClsFlg)
		CUST.CIETXN.schmType = BANCS.OUTPARAM.schmType
		print(CUST.CIETXN.schmType)
		
		IF(CUST.CIETXN.entityCreFlg == "N")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Account Creation Not Authorised"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.CIETXN.acctClsFlg == "Y")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = "Account is closed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Invalid Account ID"
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumEntityId|"+CUST.CIETXN.acctNumEntityId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumSolId|"+CUST.CIETXN.acctNumSolId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNumCcy|"+CUST.CIETXN.acctNumCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctName|"+CUST.CIETXN.acctName)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctNum|"+CUST.CIETXN.acctNum)
		print(sv_u)
		
		
END-->
