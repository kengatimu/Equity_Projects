<--start
trace on
	if(repexists("CUST") == 0) then
	    createrep("CUST")
	endif 
	if(classexists("CUST","DATA") == 0) then
	    createclass("CUST","DATA",5)
	endif
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	CUST.DATA.errMsg		= ""
	CUST.DATA.funcCode 		= BANCS.INPUT.funcCode
	CUST.DATA.CIFId 		= TRIM(BANCS.INPUT.CIFId)
	if(CUST.DATA.funcCode=="")then
                BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Function^funcCode"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
	endif
	if(CUST.DATA.CIFId=="")then
                BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid CifId^CIFId"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
	endif
	if(CUST.DATA.CIFId!="")then
		sv_d = "iCnt,delYN|select count(*),del_flg from custom.irml "
		sv_d = sv_d + " where bank_id=?SVAR and cif_id=?SVAR group by del_flg "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.CIFId
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.DATA.iCnt = BANCS.OUTPARAM.iCnt
			CUST.DATA.delYN = BANCS.OUTPARAM.delYN
		else
			CUST.DATA.iCnt = 0
			CUST.DATA.delYN = ""
		endif
	endif
	if((cint(CUST.DATA.iCnt)<=0) and (CUST.DATA.funcCode=="D"))then
                BANCS.STDIN.msg = "Error_1|Error.1 ^Customer Facility not Maintained Yet!^CIFId"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
	endif
	if((cint(CUST.DATA.iCnt)>=1) and (CUST.DATA.delYN=="N") and (CUST.DATA.funcCode=="A")) then
                BANCS.STDIN.msg = "Error_1|Error.1 ^Customer Already Whitelisted^CIFId"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
	endif
	if((cint(CUST.DATA.iCnt)>=1) and (CUST.DATA.delYN=="N") and (CUST.DATA.funcCode=="D")) then
		sv_d = "update custom.irml set del_flg='Y',rcre_user_id=?SVAR,rcre_time=sysdate "
		sv_d = sv_d + "  where bank_id=?SVAR and cif_id=?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.CIFId
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSqlWithBind(sv_d)
		if(sv_u==0)then
			sv_u = urhk_dbSqlWithBind("commit")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_g = "RESULT_MSG|Customer Facility Maintained Successfully"
			print(sv_g)
			sv_z = urhk_SetOrbOut(sv_g)
			print(sv_z)
			exitscript
		endif
	endif
	sv_d = "Insert into CUSTOM.IRML (BANK_ID,CIF_ID,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,DEL_FLG,RCRE_USER_ID,RCRE_TIME) "
	sv_d = sv_d + " values (?SVAR,?SVAR,null,null,null,'N',?SVAR,to_date(?SVAR,'DD-MM-RR')) "
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.CIFId + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSqlWithBind(sv_d)
	if(sv_u==0)then
		sv_u = urhk_dbSqlWithBind("commit")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Customer Facility Maintained Successfully"
		print(sv_g)
		sv_z = urhk_SetOrbOut(sv_g)
		print(sv_z)
		exitscript
	endif
exitscript
trace off
end-->
