<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif

	EQSRV.GLBDATA.addtnlData = ""
#++++++++
#Inputs
#++++++++
        if(fieldexists(BANCS.INPUT.acid)==1)then
                EQSRV.GLBDATA.AcctId = trim(BANCS.INPUT.acid)
        else
               	EQSRV.GLBDATA.AcctId = "" 
        endif
	sv_j = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.AcctId)
	if(sv_j==0)then
                EQSRV.GLBDATA.InpAcid = BANCS.OUTPARAM.Acid
	else
		EQSRV.GLBDATA.InpAcid = ""
	endif
        if(fieldexists(BANCS.INPUT.branchId)==1)then
                EQSRV.GLBDATA.branchId = trim(BANCS.INPUT.branchId)
        else
               	EQSRV.GLBDATA.branchId = "" 
        endif
        if(fieldexists(BANCS.INPUT.fromDate)==1)then
                EQSRV.GLBDATA.fromDate = left$(BANCS.INPUT.fromDate,10)
				sv_k ="fromDate |select to_char((to_date('"+EQSRV.GLBDATA.fromDate+"', 'YYYY-MM-DD')),'DD-MM-YYYY') from dual"
	sv_e = urhk_dbSelectWithBind(sv_k)
	print(sv_e)
	EQSRV.GLBDATA.fromDate = BANCS.OUTPARAM.fromDate
	EQSRV.GLBDATA.fromDate = EQSRV.GLBDATA.fromDate + " 00:00:00"
	print(EQSRV.GLBDATA.fromDate)


        else
               	EQSRV.GLBDATA.fromDate = "" 
        endif
		
        if(fieldexists(BANCS.INPUT.toDate)==1)then
                EQSRV.GLBDATA.toDate = left$(BANCS.INPUT.toDate,10)
				sv_k ="toDate |select to_char((to_date('"+EQSRV.GLBDATA.toDate+"', 'YYYY-MM-DD')),'DD-MM-YYYY') from dual"
	sv_e = urhk_dbSelectWithBind(sv_k)
	print(sv_e)
		EQSRV.GLBDATA.toDate = BANCS.OUTPARAM.toDate			
		EQSRV.GLBDATA.toDate = EQSRV.GLBDATA.toDate + " 00:00:00"
		print(EQSRV.GLBDATA.toDate)
        else
               	EQSRV.GLBDATA.toDate = "" 
        endif
	#A,D
        #if(fieldexists(BANCS.INPUT.sortIn)==1)then
             #   EQSRV.GLBDATA.sortIn = trim(BANCS.INPUT.sortIn)
       # else
               #	EQSRV.GLBDATA.sortIn = "" 
        #endif
		EQSRV.GLBDATA.sortIn = "D" 
	#D,C,B
        if(fieldexists(BANCS.INPUT.txnType)==1)then
                EQSRV.GLBDATA.txnType = trim(BANCS.INPUT.txnType)
        else
               	EQSRV.GLBDATA.txnType = "" 
        endif
        if(fieldexists(BANCS.INPUT.numOfTxns)==1)then
                EQSRV.GLBDATA.numOfTxns = trim(BANCS.INPUT.numOfTxns)
        else
               	EQSRV.GLBDATA.numOfTxns = "" 
        endif
        EQSRV.GLBDATA.srvErrorCode = ""

		if(fieldexists(BANCS.INPUT.StmtType)==1)then
         EQSRV.GLBDATA.StmtType = trim(BANCS.INPUT.StmtType)
        else
               	EQSRV.GLBDATA.StmtType = "F" 
        endif
		


	##--------------- Getting Account Details -----------------------##

#sv_a = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.Foracid)
sv_a = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.AcctId)
IF(sv_a == 0)THEN
#{
        EQSRV.GLBDATA.Acid = BANCS.OUTPARAM.acid
        print(EQSRV.GLBDATA.Acid)
        EQSRV.GLBDATA.CifId = BANCS.OUTPARAM.cifId
        print(EQSRV.GLBDATA.CifId)
        EQSRV.GLBDATA.AcctOpenDate = BANCS.OUTPARAM.acctOpenDate
        print(EQSRV.GLBDATA.AcctOpenDate)
        EQSRV.GLBDATA.acctCloseDate = BANCS.OUTPARAM.acctCloseDate
        print(EQSRV.GLBDATA.acctCloseDate)
        EQSRV.GLBDATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
        print(EQSRV.GLBDATA.acctCrncyCode)
        EQSRV.GLBDATA.Balance = BANCS.OUTPARAM.EffAvailableAmt
        print(EQSRV.GLBDATA.Balance)

	#------------------- From Date Validation ----------------#

	BANCS.INPARAM.date1 = MID$(EQSRV.GLBDATA.AcctOpenDate,0,10)
	print(BANCS.INPARAM.date1)
	BANCS.INPARAM.date2 = EQSRV.GLBDATA.fromDate
	print(BANCS.INPARAM.date2)
	sv_e = urhk_B2k_dateDiff("")
	print(sv_e)
	print(BANCS.OUTPARAM.dateDiff)

	IF(BANCS.OUTPARAM.dateDiff > 0)THEN
	#{
		EQSRV.GLBDATA.Error = "The from date must be later than or same as the account opening date ["+MID$(EQSRV.GLBDATA.AcctOpenDate,0,10)+"]"
		GOTO ERR
	#}
	ENDIF
	#----------- Getting Opening  Balance --------------------#

	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.Acid +"|"+ MID$(EQSRV.GLBDATA.fromDate,0,10) +"|"+ MID$(EQSRV.GLBDATA.fromDate,0,10) +"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_a = "OpenBal|select nvl(tran_date_bal,0) from tbaadm.eab where acid=?SVAR and eod_date <= TO_DATE(?SVAR,'DD-MM-YYYY')-1 and end_eod_date >=TO_DATE(?SVAR,'DD-MM-YYYY')-1 and bank_id=?SVAR"
	sv_q = urhk_dbSelectWithBind(sv_a)
	IF(sv_q == 0)THEN
	#{
		EQSRV.GLBDATA.OpenBalance = CDOUBLE(BANCS.OUTPARAM.OpenBal)
		print(EQSRV.GLBDATA.OpenBalance)
	#}
	ELSE
	#{
		EQSRV.GLBDATA.OpenBalance = "0.00"
	#}
	ENDIF	

	IF(EQSRV.GLBDATA.OpenBalance < 0)THEN
	#{
		EQSRV.GLBDATA.OpenMark = "D"
	#}
	ELSE
	#{
		EQSRV.GLBDATA.OpenMark = "C"
	#}
	ENDIF
        #-------- Getting Closing Balance ----------------------#

	BANCS.INPARAM.acctId = EQSRV.GLBDATA.AcctId
        BANCS.INPARAM.asOnDate = EQSRV.GLBDATA.toDate   
        sv_a = urhk_getAcctBalanceAsOnDate("")
        print(sv_a)
        IF(sv_a == 0)THEN
        #{
                print(BANCS.OUTPARAM.acctBal)
                EQSRV.GLBDATA.CloseBalance = cdouble(BANCS.OUTPARAM.acctBal)
                IF(EQSRV.GLBDATA.CloseBalance < 0)THEN
                #{
                        EQSRV.GLBDATA.CloseMark = "D"
                #}
                ELSE
                #{
                        EQSRV.GLBDATA.CloseMark = "C"
                #}
                ENDIF
        #}
        ENDIF

        #---------- Setting the Response ----------------------#
        sv_z = urhk_SetOrbOut("OpeningBalance.DCMark|"+EQSRV.GLBDATA.OpenMark)
        sv_z = urhk_SetOrbOut("OpeningBalance.Date|"+EQSRV.GLBDATA.AcctOpenDate)
        sv_z = urhk_SetOrbOut("OpeningBalance.Currency|"+EQSRV.GLBDATA.acctCrncyCode)
        sv_z = urhk_SetOrbOut("OpeningBalance.Amount|"+EQSRV.GLBDATA.OpenBalance)
        sv_z = urhk_SetOrbOut("ClosingBalance.DCMark|"+EQSRV.GLBDATA.CloseMark)
	IF(EQSRV.GLBDATA.acctCloseDate != "")THEN
	#{
		sv_z = urhk_SetOrbOut("ClosingBalance.Date|"+EQSRV.GLBDATA.acctCloseDate)
	#}
	ELSE
	#{
		sv_x = MID$(EQSRV.GLBDATA.fromDate,0,10)
		sv_k = "closeDate|select to_char(to_date('"+sv_x+"','DD-MM-YYYY')-1, 'MM-DD-YYYY') FROM DUAL"
		sv_q = urhk_dbSelectWithBind(sv_k)
	IF(sv_q == 0)THEN
	#{
	EQSRV.GLBDATA.closeDate= BANCS.OUTPARAM.closeDate
		print(EQSRV.GLBDATA.closeDate)
		sv_z = urhk_SetOrbOut("ClosingBalance.Date|"+EQSRV.GLBDATA.closeDate)

	ENDIF
		#sv_z = urhk_SetOrbOut("ClosingBalance.Date| ")
	#}
	ENDIF
        sv_z = urhk_SetOrbOut("ClosingBalance.Currency|"+EQSRV.GLBDATA.acctCrncyCode)
        sv_z = urhk_SetOrbOut("ClosingBalance.Amount|"+EQSRV.GLBDATA.CloseBalance)






#++++++
#get si
#++++++
	sv_s = "soId,tranId,partSrlNum,tranType,tranSubType,ptranType,pstdDate,refNum,ValueDate,tranDate,tranAmount,tranCrncy,tranParticular,tranParticular2,tranRmks,instemntType,instDate,instNum,instAlpha,fxTranAmt,fxCrncyCode,Crncycode,tranCrncyCode | "
	sv_s = sv_s + " select  sol_id,tran_id,part_tran_srl_num,tran_type,tran_sub_type,part_tran_type,to_char(pstd_date, 'DD-MM-YYYY HH24:MI:SS' ),ref_num,to_char(value_date, 'DD-MM-YYYY HH24:MI:SS' ),to_char(tran_date, 'DD-MM-YYYY HH24:MI:SS' ),tran_amt,tran_crncy_code,tran_particular,tran_particular_2,tran_rmks,instrmnt_type,to_char(instrmnt_date, 'DD-MM-YYYY HH24:MI:SS' ),instrmnt_num,instrmnt_alpha,fx_tran_amt,crncy_code,crncy_code,tran_crncy_code  "
	sv_s = sv_s + " from tbaadm.dctd_acli " 
	sv_s = sv_s + " where bank_id = ?SVAR "  
	sv_s = sv_s + " and ((acid = ?SVAR) "
	sv_s = sv_s + " and (gl_date >= to_date( ?SVAR ,'DD-MM-YYYY HH24:MI:SS')) " 
	sv_s = sv_s + " and (gl_date <= to_date( ?SVAR ,'DD-MM-YYYY HH24:MI:SS')) " 
	sv_s = sv_s + " and (tran_date >= to_date( ?SVAR , 'DD-MM-YYYY HH24:MI:SS')) "
	sv_s = sv_s + " and (tran_date <= to_date( ?SVAR , 'DD-MM-YYYY HH24:MI:SS')) ) " 
	sv_s = sv_s + " and pstd_flg = 'Y' " 
	sv_s = sv_s + " and (ref_num is null or ref_num like '%' ) " 
	if(cdouble(EQSRV.GLBDATA.numOfTxns)>=1)then
		sv_s = sv_s + " and rownum<= ?SVAR "
	endif
	
	#For Fetching Debit Trans Only
	if(EQSRV.GLBDATA.StmtType =="D")then
	sv_s = sv_s + " and PART_TRAN_TYPE='D'" 
	print("Debit Statement")
	endif
	
	#For Fetching Credit Trans Only
	if(EQSRV.GLBDATA.StmtType =="C")then
	sv_s = sv_s + " and PART_TRAN_TYPE='C' " 
	print("Credit Statement")
	endif
	
	if(EQSRV.GLBDATA.sortIn=="D")then
	sv_s = sv_s + " order by  gl_date desc,pstd_date desc,tran_id desc,part_tran_srl_num desc " 
	endif
	if(EQSRV.GLBDATA.sortIn=="A")then
	sv_s = sv_s + " order by  gl_date asc,pstd_date asc,tran_id asc,part_tran_srl_num asc " 
	endif
	
	##EQSRV.GLBDATA.InpAcid = "UB2152416"
	print(EQSRV.GLBDATA.InpAcid)
	if(cdouble(EQSRV.GLBDATA.numOfTxns)>=1)then
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.InpAcid + "|" +  EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate + "|" + EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate + "|" + EQSRV.GLBDATA.numOfTxns 
	else
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.InpAcid + "|" +  EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate + "|" + EQSRV.GLBDATA.fromDate + "|" + EQSRV.GLBDATA.toDate 
	endif
	print(BANCS.INPARAM.BINDVARS)
	print(sv_s)
        sv_u = urhk_dbCursorOpenWithBind(sv_s)
        if(sv_u == 0)then
                EQSRV.GLBDATA.aclCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Database Error ")
                goto SIFNO

        endif
        EQSRV.GLBDATA.recNum = 0
        sv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.aclCurNum)
        if(sv_f !=0)then
                sv_f = urhk_dbCursorClose(EQSRV.GLBDATA.aclCurNum)
                print(sv_f)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Database Error ")
                goto SIFNO
        endif
        while(sv_f ==0)
		EQSRV.GLBDATA.soId = BANCS.OUTPARAM.soId
		EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
		EQSRV.GLBDATA.partSrlNum = BANCS.OUTPARAM.partSrlNum
		EQSRV.GLBDATA.tranType = BANCS.OUTPARAM.tranType
		print(EQSRV.GLBDATA.tranType)
		EQSRV.GLBDATA.tranSubType = BANCS.OUTPARAM.tranSubType
		print(EQSRV.GLBDATA.tranSubType)
	    EQSRV.GLBDATA.tranTypeCat = EQSRV.GLBDATA.tranType + "" + EQSRV.GLBDATA.tranSubType 
		EQSRV.GLBDATA.ptranType = BANCS.OUTPARAM.ptranType
		EQSRV.GLBDATA.pstdDate = BANCS.OUTPARAM.pstdDate 
		EQSRV.GLBDATA.refNum = BANCS.OUTPARAM.refNum 
		EQSRV.GLBDATA.ValueDate = BANCS.OUTPARAM.ValueDate
		PRINT(EQSRV.GLBDATA.ValueDate)
		EQSRV.GLBDATA.tranDate = BANCS.OUTPARAM.tranDate
		EQSRV.GLBDATA.tranAmount = BANCS.OUTPARAM.tranAmount
		EQSRV.GLBDATA.tranCrncy = BANCS.OUTPARAM.tranCrncy
		EQSRV.GLBDATA.tranParticular = BANCS.OUTPARAM.tranParticular
		PRINT(EQSRV.GLBDATA.tranParticular)
		EQSRV.GLBDATA.tranParticular2 = BANCS.OUTPARAM.tranParticular2
		EQSRV.GLBDATA.tranRmks = BANCS.OUTPARAM.tranRmks
		EQSRV.GLBDATA.instemntType = BANCS.OUTPARAM.instemntType
		EQSRV.GLBDATA.instDate = BANCS.OUTPARAM.instDate
		EQSRV.GLBDATA.instNum = BANCS.OUTPARAM.instNum
		EQSRV.GLBDATA.instAlpha = BANCS.OUTPARAM.instAlpha
		EQSRV.GLBDATA.fxTranAmt = BANCS.OUTPARAM.fxTranAmt
		EQSRV.GLBDATA.fxCrncyCode = BANCS.OUTPARAM.fxCrncyCode
		EQSRV.GLBDATA.Crncycode = BANCS.OUTPARAM.Crncycode
		EQSRV.GLBDATA.tranCrncyCode = BANCS.OUTPARAM.tranCrncyCode
#----------------------------------------------------------Edwin
		sv_b = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.AcctId)
if(sv_b == 0) then
        sv_e = BANCS.OUTPARAM.sanctionLimit
        sv_s = BANCS.OUTPARAM.cleanAdhocLimit
        sv_w = BANCS.OUTPARAM.drawingPower
        sv_q = BANCS.OUTPARAM.usedUnclearOverDACC
        sv_r = BANCS.OUTPARAM.FXClearBalance
        sv_x = BANCS.OUTPARAM.ClearBalance
        sv_h = BANCS.OUTPARAM.FxAvailableAmt
        sv_l = BANCS.OUTPARAM.AvailableAmt
        sv_i = BANCS.OUTPARAM.DACCLimit
        sv_j = BANCS.OUTPARAM.FxFFDAvailableAmt
        sv_n = BANCS.OUTPARAM.FFDAvailableAmt
        sv_k = BANCS.OUTPARAM.lienAmt
        sv_o = BANCS.OUTPARAM.FxEffAvailableAmt
        sv_t = BANCS.OUTPARAM.EffAvailableAmt
        sv_v = BANCS.OUTPARAM.systemGeneratedLimit
        sv_p = BANCS.OUTPARAM.SystemReservedAmt
	sv_c =  BANCS.OUTPARAM.schmCode
	sv_u = BANCS.OUTPARAM.FCNRCrncyCode	
	sv_z = BANCS.OUTPARAM.acctCrncyCode 
endif
#-------------------------------------------------------------------------------
		#EQSRV.GLBDATA.availableBalance = EQSRV.GLBDATA.tranAmount
		EQSRV.GLBDATA.availableBalance = sv_t 
		#EQSRV.GLBDATA.availableBalanceC = EQSRV.GLBDATA.tranCrncy
		EQSRV.GLBDATA.availableBalanceC = sv_z
		EQSRV.GLBDATA.branchId = EQSRV.GLBDATA.soId
		#EQSRV.GLBDATA.currencyCode = EQSRV.GLBDATA.tranCrncyCode
		EQSRV.GLBDATA.currencyCode = sv_z 
		#EQSRV.GLBDATA.fFDBalance = EQSRV.GLBDATA.tranAmount
		EQSRV.GLBDATA.fFDBalance = sv_n 
		#EQSRV.GLBDATA.fFDBalanceC = EQSRV.GLBDATA.tranCrncy
		EQSRV.GLBDATA.fFDBalanceC = sv_z 
		#EQSRV.GLBDATA.floatingBalance = EQSRV.GLBDATA.tranAmount
		EQSRV.GLBDATA.floatingBalance =  sv_t
		#EQSRV.GLBDATA.floatingBalanceC = EQSRV.GLBDATA.tranCrncy	
		EQSRV.GLBDATA.floatingBalanceC = sv_z 
		#EQSRV.GLBDATA.ledgerBalance = EQSRV.GLBDATA.tranAmount
		EQSRV.GLBDATA.ledgerBalance = sv_x 
		#EQSRV.GLBDATA.ledgerBalanceC = EQSRV.GLBDATA.tranCrncy 
		EQSRV.GLBDATA.ledgerBalanceC = sv_z 
		#EQSRV.GLBDATA.userDefinedBalance = EQSRV.GLBDATA.tranAmount
		EQSRV.GLBDATA.userDefinedBalance = sv_l 
		#EQSRV.GLBDATA.udfC = EQSRV.GLBDATA.tranCrncy
		EQSRV.GLBDATA.udfC = sv_z 
	if(EQSRV.GLBDATA.pstdDate!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.pstdDate |" + EQSRV.GLBDATA.pstdDate ) 
	endif
	if(EQSRV.GLBDATA.instNum!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.instrumentId |" + EQSRV.GLBDATA.instNum ) 
	endif
	if(EQSRV.GLBDATA.tranAmount!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.txnAmt.<rec_" + EQSRV.GLBDATA.recNum + ">.amountValue |" + EQSRV.GLBDATA.tranAmount ) 
	endif
	if(EQSRV.GLBDATA.tranCrncy!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.txnAmt.<rec_" + EQSRV.GLBDATA.recNum + ">.currencyCode |" + EQSRV.GLBDATA.tranCrncy ) 
	endif
	if(EQSRV.GLBDATA.tranDate!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.txnDate |" + EQSRV.GLBDATA.tranDate ) 
	endif
	if(EQSRV.GLBDATA.tranParticular!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.txnDesc |" + EQSRV.GLBDATA.tranParticular ) 
	endif
       if(EQSRV.GLBDATA.tranParticular2!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.txnDesc2 |" + EQSRV.GLBDATA.tranParticular2 ) 
	endif

	if(EQSRV.GLBDATA.tranRmks!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.txnRemarks |" + EQSRV.GLBDATA.tranRmks ) 
	endif
	if(EQSRV.GLBDATA.refNum!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.txnRefnum |" + EQSRV.GLBDATA.refNum ) 
	endif
	if(EQSRV.GLBDATA.ptranType!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.txnType |" + EQSRV.GLBDATA.ptranType ) 
	endif
	if(EQSRV.GLBDATA.addtnlData!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.transactionSummary.<rec_" + EQSRV.GLBDATA.recNum + ">.addtnlData |" + EQSRV.GLBDATA.addtnlData )
	endif
	if(EQSRV.GLBDATA.tranAmount!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.txnBalance.<rec_" + EQSRV.GLBDATA.recNum + ">.amountValue |" + EQSRV.GLBDATA.tranAmount ) 
	endif
	if(EQSRV.GLBDATA.tranCrncy!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.txnBalance.<rec_" + EQSRV.GLBDATA.recNum + ">.currencyCode |" + EQSRV.GLBDATA.tranCrncy ) 
	endif
	if(EQSRV.GLBDATA.tranTypeCat!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.txnCat |" + EQSRV.GLBDATA.tranTypeCat ) 
	endif
	if(EQSRV.GLBDATA.tranId!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.txnId |" + EQSRV.GLBDATA.tranId ) 
	endif
	if(EQSRV.GLBDATA.recNum!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.txnSrlNo |" + EQSRV.GLBDATA.recNum ) 
	endif
	if(EQSRV.GLBDATA.tranDate!="")then
		sv_u = urhk_SetOrbOut("getFullAccountStatementWithPaginationResponse.PaginatedAccountStatement.transactionDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.valueDate |" + EQSRV.GLBDATA.ValueDate )
	endif
		sv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.aclCurNum)
                EQSRV.GLBDATA.recNum = cint(EQSRV.GLBDATA.recNum) + 1
        do
