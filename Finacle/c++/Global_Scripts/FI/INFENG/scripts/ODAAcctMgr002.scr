#------------------------------------------------------------------------------------------------
#  Name            : ODAAcctMgr002.scr
#  Description     : This script will allocate account Managers to overdrafts accounts opened everyday
#  Date            : 01-07-2022
#  Author          : Timothy Karemeri
#  Input           : NA
#  Output          : NA
#  Called Script   : b_reallocateODAAcctMgr.scr
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :  (Batch Job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             01-07-2022      Timothy Karemeri		Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUSTS") == 0) THEN
#{
	CREATEREP("CUSTS")
#}
ENDIF

IF (CLASSEXISTS("CUSTS","ACMOD") == 0) THEN
#{
	CREATECLASS("CUSTS","ACMOD",5)
#}
ENDIF

IF (CLASSEXISTS("CUSTS","ACMOD") == 0) THEN
#{
    CREATECLASS("CUSTS","ACMOD", 5)
#}
ENDIF
#------------------------------------------------------------------------------
#Initialisig required repository variables 
#------------------------------------------------------------------------------
CUSTS.ACMOD.errMsg = ""


sv_y="AcctMgrcount2|"
sv_y = sv_y + " select count(*) from tbaadm.upr where home_bank_id = ?SVAR "
sv_y = sv_y + " and sol_id = ?SVAR "
sv_y = sv_y + " and role_id in ('CCL-AGR') and del_flg !='Y' "
print (sv_y)

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
print(BANCS.INPARAM.BINDVARS)
sv_x = urhk_dbSelectWithBind(sv_y)
IF (sv_x != 0) THEN 
#{
	CUSTS.ACMOD.errMsg = "DB ERROR!"
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	CUSTS.ACMOD.AcctMgrcount2= BANCS.OUTPARAM.AcctMgrcount2
	print(CUSTS.ACMOD.AcctMgrcount2)
	CUSTS.ACMOD.AcctMgrFlg= "Y"
	print(CUSTS.ACMOD.AcctMgrFlg)

	IF (CINT(CUSTS.ACMOD.AcctMgrcount2)== 0) THEN
	#{
		sv_y="AcctMgrcount2|"
		sv_y = sv_y + " select count(*) from (select * from tbaadm.upr where home_bank_id = ?SVAR "
		sv_y = sv_y + " and sol_id = ?SVAR "
		sv_y = sv_y + " and role_id in ('CAD') and del_flg !='Y' order by role_id asc) "
		#sv_y = sv_y + " where rownum< 2 "
		print (sv_y)

		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
		print(BANCS.INPARAM.BINDVARS)
		sv_x = urhk_dbSelectWithBind(sv_y)
		IF (sv_x != 0) THEN 
		#{
			CUSTS.ACMOD.errMsg = "DB ERROR!"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUSTS.ACMOD.AcctMgrcount2= BANCS.OUTPARAM.AcctMgrcount2
			print(CUSTS.ACMOD.AcctMgrcount2)
			CUSTS.ACMOD.AcctMgrFlg= "X"
			print(CUSTS.ACMOD.AcctMgrFlg)
			IF (CINT(CUSTS.ACMOD.AcctMgrcount2)== 0) THEN
			#{
				sv_y="AcctMgrcount2|"
				sv_y = sv_y + " select count(*) from (select * from tbaadm.upr where home_bank_id = ?SVAR "
				sv_y = sv_y + " and sol_id = ?SVAR "
				sv_y = sv_y + " and role_id in ('CRM') and del_flg !='Y' order by role_id asc) "
				#sv_y = sv_y + " where rownum< 2 "
				print (sv_y)

				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
				print(BANCS.INPARAM.BINDVARS)
				sv_x = urhk_dbSelectWithBind(sv_y)
				IF (sv_x != 0) THEN 
				#{
					CUSTS.ACMOD.errMsg = "DB ERROR!"
					GOTO ENDOFSCRIPT
				#}
				ELSE
				#{
					CUSTS.ACMOD.AcctMgrcount2= BANCS.OUTPARAM.AcctMgrcount2
					print(CUSTS.ACMOD.AcctMgrcount2)
					CUSTS.ACMOD.AcctMgrFlg= "Z"
					print(CUSTS.ACMOD.AcctMgrFlg)
					IF (CINT(CUSTS.ACMOD.AcctMgrcount2)== 0) THEN
					#{
						CUSTS.ACMOD.errMsg = "No Account Manager under ROLE ID for Reallocation!"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

	#}
	ENDIF
#}
ENDIF

CUSTS.ACMOD.CasesToAllocate = cint(CUSTS.ACMOD.custcount2)/cint(CUSTS.ACMOD.AcctMgrcount2)
print(CUSTS.ACMOD.CasesToAllocate)
CUSTS.ACMOD.CasesToAllocate = cint(CUSTS.ACMOD.CasesToAllocate)
print(CUSTS.ACMOD.CasesToAllocate)

IF (CUSTS.ACMOD.AcctMgrFlg == "X") THEN
	sv_y="acctMgr|"
	sv_y = sv_y + " select user_id from tbaadm.upr where home_bank_id = ?SVAR "
	sv_y = sv_y + " and sol_id = ?SVAR "
	sv_y = sv_y + " and role_id in ('CAD') and del_flg !='Y' "
	print (sv_y)
ENDIF
IF (CUSTS.ACMOD.AcctMgrFlg == "Y") THEN
	sv_y="acctMgr|"
	sv_y = sv_y + " select user_id from tbaadm.upr where home_bank_id = ?SVAR "
	sv_y = sv_y + " and sol_id = ?SVAR "
	sv_y = sv_y + " and role_id in ('CCL-AGR') and del_flg !='Y' "
	print (sv_y)
ENDIF
IF (CUSTS.ACMOD.AcctMgrFlg == "Z") THEN
sv_y="acctMgr|"
	sv_y = sv_y + " select user_id from tbaadm.upr where home_bank_id = ?SVAR "
	sv_y = sv_y + " and sol_id = ?SVAR "
	sv_y = sv_y + " and role_id in ('CRM') and del_flg !='Y' "
	print (sv_y)
ENDIF

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
print(BANCS.INPARAM.BINDVARS)
sv_x = urhk_dbCursorOpenWithBind(sv_y)
IF (sv_x == 0) THEN 
#{
	CUSTS.ACMOD.DbNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(CUSTS.ACMOD.DbNumber)
	sv_m = urhk_dbCursorFetch(CUSTS.ACMOD.DbNumber)
	print(sv_m)
	
	WHILE (sv_m == 0) 
	#{

		CUSTS.ACMOD.acctMgr= BANCS.OUTPARAM.acctMgr
		print(CUSTS.ACMOD.acctMgr)
	 
	sv_s="foracid,solid|"
	sv_s = sv_s + " select foracid,sol_id from tbaadm.gam where bank_id = ?SVAR "
	sv_s = sv_s + " and sol_id = ?SVAR "
	sv_s = sv_s + " and schm_code in ('OD543','OD544') "
	sv_s = sv_s + " and ACCT_CLS_FLG ! = 'Y' "
	sv_s = sv_s + " and ACCT_MGR_USER_ID = ?SVAR "
	sv_s = sv_s + " and ROWNUM <= ?SVAR "
	print(sv_s)

	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + CUSTS.ACMOD.odaAcctmgr + "|" + CUSTS.ACMOD.CasesToAllocate
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)

	IF (sv_c==0) then
	#{
		CUSTS.ACMOD.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.ACMOD.DbcursorNumber)
		print(sv_k)
		sv_q = 0
		WHILE ((sv_k == 0) AND (sv_q <= CUSTS.ACMOD.CasesToAllocate))
		#{
				sv_q = sv_q + 1
				print(sv_q)
			CUSTS.ACMOD.foracid= BANCS.OUTPARAM.foracid
			CUSTS.ACMOD.solid= BANCS.OUTPARAM.solid
			print(CUSTS.ACMOD.foracid)
			print(CUSTS.ACMOD.solid)

			print(BANCS.STDIN.mySolId)
			
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUSTS.ACMOD.foracid
				sv_s = " acid,AcctsolId,schmCode,schmType,acctClsFlag,sweeps,acctCrncyCode|select acid,sol_id,schm_code, schm_type, acct_cls_flg,allow_sweeps, acct_crncy_code from tbaadm.gam "
				sv_s = sv_s + "where bank_id = ?SVAR "
				sv_s = sv_s + "and foracid = ?SVAR "
				sv_s = sv_s + "and acct_cls_flg != 'Y' "
				PRINT(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)

				IF (sv_d == 0) THEN
				#{
				CUSTS.ACMOD.acid = BANCS.OUTPARAM.acid
				PRINT(sv_d)
				CUSTS.ACMOD.AcctsolId = BANCS.OUTPARAM.AcctsolId
				PRINT(CUSTS.ACMOD.acid)
				CUSTS.ACMOD.schmCode = BANCS.OUTPARAM.schmCode
				PRINT(CUSTS.ACMOD.schmCode)
				CUSTS.ACMOD.schmType = BANCS.OUTPARAM.schmType
				PRINT(CUSTS.ACMOD.schmType)
				CUSTS.ACMOD.acctClsFlag = BANCS.OUTPARAM.acctClsFlag
				PRINT(CUSTS.ACMOD.acctClsFlag)
				CUSTS.ACMOD.sweeps = BANCS.OUTPARAM.sweeps
				PRINT(CUSTS.ACMOD.sweeps)
				CUSTS.ACMOD.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
				PRINT(CUSTS.ACMOD.acctCrncyCode)
				#}
				ELSE
				#{
				GOTO ERROR
				#}
				ENDIF
			#--------------------------------------------------------------------------------------------------------------
			#--------------------------------------------------------------------------------------------------------------
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.ACMOD.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTS.ACMOD.acid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.ACMOD.schmCode)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTS.ACMOD.schmType)
			PRINT(sv_u)
			
			sv_u = urhk_ExecSrv("SRV_FetchODAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)

				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.ACMOD.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acid|" + CUSTS.ACMOD.acid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType|" + CUSTS.ACMOD.schmType)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode|" + CUSTS.ACMOD.schmCode)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.allowSweeps|" + CUSTS.ACMOD.sweeps)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctClsFlag|" + CUSTS.ACMOD.acctClsFlag)
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctGeneralInfoEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctInterestTax.acctInterestTaxEntered|1")
				PRINT(sv_u)
				sv_u =urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderEntered|1")
				PRINT(sv_u)

				
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctMgrAtAcct.userId|" + CUSTS.ACMOD.acctMgr)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctCrncyCode.crncyCode|" + CUSTS.ACMOD.acctCrncyCode)
				PRINT(sv_u)

				sv_u = urhk_ExecSrv("SRV_ModifyODAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)

				IF (sv_u == 0) THEN
				print("SUCCESS")
				ENDIF

			ENDIF

				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						print(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
					#}									
					ELSE
					#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) then
					#{
						sv_u = system("echo 'Error for Acct:"+CUSTS.ACMOD.foracid+" ' >>ODAMgr.log")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>ODAMgr.log")
							print(sv_u)
						#}
						DO
					#}
					ENDIF
				#}
				ENDIF
		ERROR:
		sv_k = urhk_dbCursorFetch(CUSTS.ACMOD.DbcursorNumber)
		print(sv_k)
		
		#}
		DO

		sv_c = urhk_dbCursorClose(CUSTS.ACMOD.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF

	ERROR1:
	sv_m = urhk_dbCursorFetch(CUSTS.ACMOD.DbNumber)
	print(sv_m)
	
	#}
	DO

	sv_g = urhk_dbCursorClose(CUSTS.ACMOD.DbNumber)
	print(sv_g)
#}
ENDIF

ENDOFSCRIPT:
IF(CUSTS.ACMOD.errMsg != "") THEN
#{
    sv_u = system("echo '"+CUSTS.ACMOD.errMsg+"' >>ODAMgr.log")
#}
ENDIF

EXITSCRIPT
END-->