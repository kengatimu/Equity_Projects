<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DD") == 0) THEN
        #{
                CREATECLASS("CUST","DD",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("userid"))== 0) ) THEN
	#{
   		CUST.DD.errMsg="UserId is not available"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("crncy"))== 0) ) THEN
	#{
   		CUST.DD.errMsg="crncy is not available"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF



	################################ Variable Inititalization#######################################################
	CUST.DD.userid= BANCS.INPUT.userid
	print(CUST.DD.userid)
	CUST.DD.crncy= BANCS.INPUT.crncy
	print(CUST.DD.crncy)

	if((CUST.DD.crncy!="KES") AND (CUST.DD.crncy!="USD"))then
	#{
   		CUST.DD.errMsg="crncy is not KES/USD"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT			

	#}
	endif

	sv_s = "roleid|select role_id from tbaadm.upr  "
	sv_s = sv_s + "where home_bank_ID=?SVAR and user_id=?SVAR "
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.userid
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	IF (sv_r ==0) THEN
	#{
		CUST.DD.roleid= BANCS.OUTPARAM.roleid
		print (CUST.DD.roleid)

		sv_s = "transferLimit, intersolTransferLimit|select USER_XFER_DR_LIM, USER_INTERSOL_XFER_DR_LIMIT from tbaadm.RCL  "
		sv_s = sv_s + "where bank_id=?SVAR and role_id=?SVAR and crncy_code=?SVAR "
	
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.DD.roleid + "|" + CUST.DD.crncy
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_r =  urhk_dbSelectWithBind(sv_s)
		print(sv_r)
		IF(sv_r==0)THEN
		#{
			CUST.DD.transferLimit= BANCS.OUTPARAM.transferLimit
			print (CUST.DD.transferLimit)
			CUST.DD.intersolTransferLimit= BANCS.OUTPARAM.intersolTransferLimit
			print (CUST.DD.intersolTransferLimit)


			sv_t = "transferLimit| " +CUST.DD.transferLimit
			sv_u = urhk_SetOrbOut(sv_t)
			sv_p = "intersolTransferLimit| " +CUST.DD.intersolTransferLimit
			sv_u = urhk_SetOrbOut(sv_p)


		#}
		ENDIF
	#}
	ELSE
	#{
   		CUST.DD.errMsg="Invalid userid passed"
		sv_t = "Msg| " +CUST.DD.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT		
	#}
	ENDIF



ENDSCRIPT:

trace off

end-->

