					if(((EQSRV.GLBDATA.freetxt1 == "SRV_ModifySBAcctAndVerify" ) or (EQSRV.GLBDATA.freetxt1=="SRV_VerifySBAcct")) and (cdouble(EQSRV.GLBDATA.delCnt) >=1))then
						sv_u = "update custom.agmt set entity_cre_flg='Y',lchg_user_id=?SVAR,lchg_time=to_date(?SVAR,'DD-MM-RR'),free_text2=?SVAR where bank_id=?SVAR and  dealer_code =?SVAR and foracid=?SVAR "
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQSRV.GLBDATA.freetxt1 + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.rdealerCode + "|" + EQSRV.GLBDATA.foracid 
						print(sv_u)
						print(BANCS.INPARAM.BINDVARS)
						sv_t = urhk_dbSqlWithBind(sv_u)
						if(sv_t==0)then
							sv_t = urhk_dbSqlWithBind("commit")
							print(sv_t)
						endif
					endif
					print(EQSRV.GLBDATA.delCnt)
					if((cdouble(EQSRV.GLBDATA.delCnt)<=0))then
				sv_d = "insert into custom.agmt (bank_id,agent_code,agent_desc,foracid,dealer_code,dealer_name,dealer_limit,registration_date,rcre_user_id,rcre_time,lchg_user_id,lchg_time,entity_cre_flg,del_flg,reg_mop_id,free_text1,free_text2,free_text3) values (?SVAR,'SAFAGNT','Safaraicom Agent',?SVAR,?SVAR,?SVAR,?NVAR,to_date(?SVAR,'DD-MM-RR'),?SVAR,to_date(?SVAR,'DD-MM-RR'),?SVAR,to_date(?SVAR,'DD-MM-RR'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR) "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.foracid + "|" + EQSRV.GLBDATA.rdealerCode + "|" + EQSRV.GLBDATA.rdealerName + "|" + EQSRV.GLBDATA.rlimit + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQSRV.GLBDATA.entityCreYN + "|" + EQSRV.GLBDATA.delYN + "|" + EQSRV.GLBDATA.reqMopId + "|" + EQSRV.GLBDATA.freetxt1 + "|" + EQSRV.GLBDATA.freetxt2 + "|" + EQSRV.GLBDATA.freetxt3  
