<--start
trace on

        if(repexists("ECOSL")==0)then
                createrep("ECOSL")
        endif
        if(classexists("ECOSL","GLBDATA")==0)then
                createclass("ECOSL","GLBDATA",5)
        endif

	ECOSL.GLBDATA.OPERATIVEACCT = BANCS.INPUT.OPERATIVEACCT
	print(ECOSL.GLBDATA.OPERATIVEACCT)

                sv_u = urhk_getAdvanceDetailsForAccount(ECOSL.GLBDATA.OPERATIVEACCT)
                print(sv_u)
                if(sv_u==0)then
                #{
		    if(BANCS.OUTPARAM.gacFreeText1!="")then
		    #{
                        ECOSL.GLBDATA.gacFreeText1 = BANCS.OUTPARAM.gacFreeText1
            		ECOSL.GLBDATA.eee = ECOSL.GLBDATA.gacFreeText1
            		sv_l = strlen(ECOSL.GLBDATA.eee)
            		sv_f = mid$(ECOSL.GLBDATA.eee,0,sv_l)
            		sv_p = getposition(sv_f,",")
            		ECOSL.GLBDATA.EcoCode2  = mid$(sv_f,0,(sv_p-1))
            		print(ECOSL.GLBDATA.EcoCode2)
            		ECOSL.GLBDATA.RefNum = mid$(sv_f,sv_p,sv_l)
            		print(ECOSL.GLBDATA.RefNum)
		    #}
		    else
		    #{
            		ECOSL.GLBDATA.EcoCode2  = " "
            		ECOSL.GLBDATA.RefNum = " "
		    #}
		    endif
		    if(BANCS.OUTPARAM.gacFreeText2!="")then
		    #{
                        ECOSL.GLBDATA.gacFreeText2 = BANCS.OUTPARAM.gacFreeText2
		    #}
		    else
		    #{
                        ECOSL.GLBDATA.gacFreeText2 = " "
		    #}
		    endif
		    if(BANCS.OUTPARAM.gacFreeText7!="")then
		    #{
                        ECOSL.GLBDATA.gacFreeText7 = BANCS.OUTPARAM.gacFreeText7
            		ECOSL.GLBDATA.fff = ECOSL.GLBDATA.gacFreeText7
            		sv_l = strlen(ECOSL.GLBDATA.fff)
            		sv_f = mid$(ECOSL.GLBDATA.fff,0,sv_l)
            		sv_p = getposition(sv_f,",")
            		ECOSL.GLBDATA.prefix  = mid$(sv_f,0,(sv_p-1))
            		print(ECOSL.GLBDATA.prefix)
            		ECOSL.GLBDATA.ExpiryDate= mid$(sv_f,sv_p,sv_l)
            		print(ECOSL.GLBDATA.ExpiryDate)
		    #}
		    else
		    #{
                        ECOSL.GLBDATA.ExpiryDate = " "
			ECOSL.GLBDATA.prefix = " "
		    #}
		    endif
                #}
		ELSE
		#{
			ECOSL.GLBDATA.successOrFailure = "F"
			ECOSL.GLBDATA.errorCode = "ERR110"
            		ECOSL.GLBDATA.EcoCode2 = " "
            		ECOSL.GLBDATA.RefNum = " "
                        ECOSL.GLBDATA.gacFreeText2 = " "
                        ECOSL.GLBDATA.ExpiryDate = " "
			ECOSL.GLBDATA.prefix = " "
                	sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                	sv_u = urhk_SetOrbOut("Message|Invalid Account")
                	exitscript
		#}
		ENDIF
	IF(ECOSL.GLBDATA.prefix !=  "ECO") THEN
                	sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                	sv_u = urhk_SetOrbOut("Message|Expiry Date not well Maintained, start with prefix ECO, and date format DD-MM-YYYY")
                	exitscript		
	ENDIF
	if(ECOSL.GLBDATA.EcoCode2!="")then
		sv_b = urhk_SetOrbOut("FREETEXT.ecoCode|" + ECOSL.GLBDATA.EcoCode2)
	endif
	if(ECOSL.GLBDATA.RefNum!="")then
		sv_b = urhk_SetOrbOut("FREETEXT.refNumber|" + ECOSL.GLBDATA.RefNum)
	endif
	if(ECOSL.GLBDATA.gacFreeText2!="")then
		sv_b = urhk_SetOrbOut("FREETEXT.NominatedNumber|" + ECOSL.GLBDATA.gacFreeText2)
	endif
	if(ECOSL.GLBDATA.ExpiryDate !="")then
		sv_b = urhk_SetOrbOut("FREETEXT.ExpiryDate|" + ECOSL.GLBDATA.ExpiryDate)
	endif
trace off
end-->