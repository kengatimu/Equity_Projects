<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF
		
		
		IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","AGENT") == 0) THEN
        #{
                CREATECLASS("CUST","AGENT",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)


	IF( (FIELDEXISTS(("BANCS").("INPUT").("Foracid"))== 0) ) THEN
   		CUST.DATA.errMsg="ACCOUNT TO CHANGE IS NULL"
		#sv_t = "executeFinacleScript_CustomData.ERROR | " +CUST.DATA.errMsg
		sv_t="ERROR| " + CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CUSTID"))== 0) ) THEN
   		CUST.DATA.errMsg="CIF OF THE Known Agent IS NULL"
		#sv_t = "executeFinacleScript_CustomData.ERROR | " +CUST.DATA.errMsg
		sv_t="ERROR| " + CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ENDIF



	IF( (FIELDEXISTS(("BANCS").("INPUT").("USERID"))== 0) ) THEN
	#{
		#Error response
   		CUST.DATA.errMsg="Kindly enter the USERID"
		#sv_t="ERROR| " + CUST.DATA.errMsg
		#sv_u = urhk_SetOrbOut(sv_t)
   		#GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("checkerUSERID"))== 1) ) THEN
	#{
		CUST.DATA.checkerUSERID= BANCS.INPUT.checkerUSERID
		PRINT(CUST.DATA.checkerUSERID)


	#}
	ELSE
	#{
		CUST.DATA.checkerUSERID=""
		PRINT(CUST.DATA.checkerUSERID)

	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("ENDDATE"))== 0) ) THEN
   		CUST.DATA.errMsg="Authorization End date of the account is null"
		sv_t = "executeFinacleScript_CustomAGENT.ERROR | " +CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ENDIF
	
	CUST.AGENT.authEndDate = BANCS.INPUT.ENDDATE
	print(CUST.AGENT.authEndDate)

	CUST.AGENT.BODDATE= mid$(BANCS.STDIN.BODDate,0,10) 
	PRINT(CUST.AGENT.BODDATE)
	
	IF(CUST.AGENT.authEndDate ==CUST.AGENT.BODDATE) THEN
	PRINT("Authorization end date equals to BOD Date")
	CUST.DATA.flag = "Y"
	
	ELSE
	PRINT("Authorization end date NOT equal to BOD Date")
	CUST.DATA.flag = "N"
	ENDIF

	CUST.DATA.function = "REMOVE"
	CUST.DATA.account = BANCS.INPUT.Foracid
	CUST.DATA.code = "O"
	CUST.DATA.cif = BANCS.INPUT.CUSTID


	print(CUST.DATA.function)

	IF((CUST.DATA.function =="ADD") OR (CUST.DATA.function =="REMOVE"))THEN
	#{
		PRINT("OKEY")
	#}
	ELSE
	#{		
	   	CUST.DATA.errMsg="Function must be ADD or REMOVE"
		sv_t="ERROR| " + CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("USERID"))== 1) ) THEN
	#{
		CUST.DATA.USERID = BANCS.INPUT.USERID
		print(CUST.DATA.USERID)
		
		ELSE
		#{
		sv_k ="400"
		sv_t="ResponseCode| " + sv_k
		sv_u = urhk_SetOrbOut(sv_t)
		
   		CUST.DATA.errMsg="Please Enter The User ID"
		sv_t = "MSG| " +CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#-----------------------------------------------------------------------------
	#Check if userid is valid
	#-----------------------------------------------------------------------------
	sv_s="COUNT|"
	sv_s = sv_s + " SELECT COUNT(*) FROM TBAADM.UPR WHERE  "
	sv_s = sv_s + " USER_ID=?SVAR AND DEL_FLG !='Y'"
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.DATA.USERID
	print(BANCS.INPARAM.BINDVARS)


	sv_d = urhk_dbSelectWithBind(sv_s)

	IF(sv_d==0)THEN
	#{
		CUST.DATA.COUNT = BANCS.OUTPARAM.COUNT
		PRINT(CUST.DATA.COUNT)
		
			IF(CUST.DATA.COUNT > 0)THEN
			#{
				
				PRINT("Valid User")
			#}
			ELSE
			#{
				CUST.DATA.errMsg="Invalid User." + CUST.DATA.USERID
				sv_t = "ERROR| " +CUST.DATA.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDOFSCRIPT

			#}
			ENDIF
		
	#}
	ELSE
	#{
		CUST.DATA.errMsg="Database error."
		sv_t = "ERROR| " +CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT

	#}
	ENDIF


	IF(CUST.DATA.checkerUSERID !="")THEN
	#{

		#-----------------------------------------------------------------------------
		#Check if checker userid is valid
		#-----------------------------------------------------------------------------
		sv_s="count1|"
		sv_s = sv_s + " SELECT count(1) FROM TBAADM.UPR WHERE  "
		sv_s = sv_s + " USER_ID=?SVAR "
		print(sv_s)

		BANCS.INPARAM.BINDVARS =  CUST.DATA.checkerUSERID
		print(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d==0)THEN
		#{
			CUST.DATA.count1 = BANCS.OUTPARAM.count1
			PRINT(CUST.DATA.count1)
			IF (cint(CUST.DATA.count1)== 0) THEN
			#{
				CUST.DATA.errMsg="INVALID checkerUSERID " + CUST.DATA.checkerUSERID
				sv_t = "ERROR| " +CUST.DATA.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
   				GOTO ENDOFSCRIPT
			#}
			ENDIF

		#}
		ENDIF	
	#}
	ENDIF



	#----------------------------------------------------------------------------------------------------------------------------
	#get refnum
	#-----------------------------------------------------------------------------------------------------------------------------
	sv_s = "refnum |"
	sv_s = sv_s + " SELECT TO_CHAR(TBAADM.TBA_ADT_REF_NUM_SEQ_54.NEXTVAL) FROM DUAL "

	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d==0)THEN
	#{
		PRINT(BANCS.OUTPARAM.refnum)	
		CUST.DATA.refnum= BANCS.OUTPARAM.refnum 
	#}
	ELSE
	#{
	   	GOTO ENDOFSCRIPT
	#}
	ENDIF

	

#################################REMOVE Known Agent####################################

	IF(CUST.DATA.function == "REMOVE")THEN
	#{
		sv_s = "ACID,STYPE, SOL,GLSUB|"
		sv_s = sv_s + " SELECT ACID,SCHM_TYPE,SOL_ID,GL_SUB_HEAD_CODE FROM TBAADM.GAM WHERE "
		sv_s = sv_s + "FORACID=?SVAR AND BANK_ID=?SVAR"

		BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d ==0) THEN
		#{
			PRINT(BANCS.OUTPARAM.ACID)	
			CUST.DATA.acid = BANCS.OUTPARAM.ACID

			PRINT(BANCS.OUTPARAM.STYPE)	
			CUST.DATA.STYPE= BANCS.OUTPARAM.STYPE

			PRINT(BANCS.OUTPARAM.SOL)	
			CUST.DATA.SOL= BANCS.OUTPARAM.SOL

			PRINT(BANCS.OUTPARAM.GLSUB)	
			CUST.DATA.GLSUB= BANCS.OUTPARAM.GLSUB

			sv_s = "COUNT|"
			sv_s = sv_s + " SELECT COUNT(*) FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "ACID=?SVAR AND BANK_ID=?SVAR AND ACCT_POA_AS_REC_TYPE='O'"

			BANCS.INPARAM.BINDVARS = CUST.DATA.acid +"|"+ BANCS.STDIN.contextBankId
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)		
			print(BANCS.OUTPARAM.COUNT)	
			CUST.DATA.count = BANCS.OUTPARAM.COUNT

			IF(CUST.DATA.count == 0)THEN
			#{
				CUST.DATA.msg1 = "No Known Agent for account " + CUST.DATA.account

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg1
				sv_t="MSG| " + CUST.DATA.msg1
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT	
			#}		
			ENDIF	

			#####Handle next print not null
			sv_s = "nextPrintDate|"
			sv_s = sv_s + " SELECT PS_NEXT_DUE_DATE FROM TBAADM.AST WHERE "
			sv_s = sv_s + " ACID=?SVAR AND BANK_ID=?SVAR"

			BANCS.INPARAM.BINDVARS = CUST.DATA.acid +"|"+ BANCS.STDIN.contextBankId		
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0)THEN
			#{
				PRINT(BANCS.OUTPARAM.nextPrintDate)	
				CUST.DATA.nextPrintDate= BANCS.OUTPARAM.nextPrintDate

			#}
			ELSE
			#{
				CUST.DATA.nextPrintDate=""
			#}
			ENDIF
	#}
	ENDIF	
	
		
	CUST.AGENT.BODDATE= mid$(BANCS.STDIN.BODDate,0,10) 
	PRINT(CUST.AGENT.BODDATE)
	
	IF(CUST.AGENT.authEndDate ==CUST.AGENT.BODDATE) THEN
	PRINT("Authorization end date equals to BOD Date")
	CUST.DATA.flag = "Y"
	
	ELSE
	PRINT("Authorization end date NOT equal to BOD Date")
	CUST.DATA.flag = "N"
	ENDIF

	##############################################SBA ACCOUNTS##############################	
	IF(CUST.DATA.STYPE == "SBA")THEN
	#{

		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.DATA.account)
		PRINT(sv_u)
			
		sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)


		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)

			sv_s = "SERIALNUM|"
			sv_s = sv_s + " SELECT ACCT_POA_AS_SRL_NUM-1 FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "NMA_KEY_ID=?SVAR AND BANK_ID=?SVAR AND ACID=?SVAR AND DEL_FLG='N'"

			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acid

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				print(BANCS.OUTPARAM.SERIALNUM)	
				CUST.DATA.sn = BANCS.OUTPARAM.SERIALNUM
				print(CUST.DATA.sn)
				sv_e = CUST.DATA.sn
			#}
			ELSE
			#{
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " is not found."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			ENDIF	

				CUST.AGENT.BODDATE= mid$(BANCS.STDIN.BODDate,0,10) 
				PRINT(CUST.AGENT.BODDATE)
				
				#IF(CUST.AGENT.authEndDate ==CUST.AGENT.BODDATE) THEN
				#PRINT("Authorization end date equals to BOD Date")
				#CUST.DATA.flag = "Y"
				
				#ELSE
				#PRINT("Authorization end date NOT equal to BOD Date")
				#CUST.DATA.flag = "N"
				#ENDIF
			
			print(CUST.DATA.flag)
			
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.delFlg|Y")
			print(sv_u)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.authEndDate|"+BANCS.STDIN.BODDate)
			print(sv_u)
			IF(CUST.DATA.nextPrintDate!="")THEN
			#{
				sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psNextPrintDate|"+BANCS.STDIN.BODDate)

			#}
			ENDIF
					
			sv_u = urhk_ExecSrv("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)

			IF (sv_u == 0) THEN
			#{
			
			CUST.DATA.PHONE =""
			CUST.DATA.EMAIL =""
			CUST.DATA.AccountPHONE =""
			CUST.DATA.AccountEMAIL =""
			
			###Fetching Account Phone Number and Email
				
			sv_s = "EMAIL, PHONE|"
			sv_s = sv_s + " select email, phone from crmuser.cmg where cif_id in (select cif_id from tbaadm.gam where foracid =?SVAR) and bank_id =?SVAR "
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				
				CUST.DATA.AccountEMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.EMAIL)
				
				CUST.DATA.AccountPHONE = BANCS.OUTPARAM.PHONE
				print(CUST.DATA.PHONE)
				
			#}
			
			ENDIF
			
			
			###Fetching Agent Phone Number and Email

			CUST.DATA.CUST_NAME = ""
			sv_s = "EMAIL, PHONE, CUST_NAME|"
			sv_s = sv_s + " select email, phone, CUST_NAME from crmuser.cmg where cif_id =?SVAR AND BANK_ID=?SVAR "
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				
				CUST.DATA.EMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.EMAIL)
				
				CUST.DATA.PHONE = BANCS.OUTPARAM.PHONE
				print(CUST.DATA.PHONE)
				
				CUST.DATA.CUST_NAME = BANCS.OUTPARAM.CUST_NAME
				print(CUST.DATA.CUST_NAME)
				
			#}
			
			ENDIF
			
				IF(CUST.DATA.flag =="N") THEN
				GOTO SBASVSEND
				
				PRINT("SVS SKIPPED")
				ENDIF
				
				
				#######SVS UPDATE STARTS HERE#

				#sv_a = " UPDATE SVSUSER.SIGNMAINTENANCE SET DELETED = 'Y', ACTIVE='N' ,LASTACTIVITY=?SVAR,MODIFIEDBY=?SVAR,  MODIFIEDDATE=TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF'), "
				sv_a = " UPDATE SVSUSER.SIGNMAINTENANCE SET EXPIRYDATE = TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF'),LASTACTIVITY=?SVAR,MODIFIEDBY=?SVAR,  MODIFIEDDATE=TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF'), "
				sv_a = sv_a + " VERIFIEDBY=?SVAR,VERIFIEDDATE=TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF')  WHERE LASTACTIVITY='ADD' AND ACTIVE ='Y' AND DELETED ='N' "
				sv_a = sv_a + " AND TRUNC(CREATEDDATE) IN TO_DATE((SELECT RCRE_TIME FROM TBAADM.AAS WHERE NMA_KEY_ID =?SVAR AND ACCT_POA_AS_REC_TYPE ='O' and trunc(LCHG_TIME) = trunc(sysdate) "
				sv_a = sv_a + " AND ACID IN(SELECT ACID FROM TBAADM.GAM WHERE FORACID =?SVAR) )) AND SIGNID IN (SELECT SIGNID FROM  SVSUSER.SIGNCUSTINFO WHERE  CUSTID=?SVAR) AND CREATEDBY =?SVAR "
				
				PRINT(sv_a) 
					
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.sysDate+"|UPDATE|"+CUST.DATA.USERID+"|"+BANCS.STDIN.sysDate+"|"+CUST.DATA.USERID+"|"+BANCS.STDIN.sysDate +"|"+ CUST.DATA.cif +"|"+ CUST.DATA.account +"|"+ CUST.DATA.cif +"|"+ BANCS.STDIN.userId
		print(BANCS.INPARAM.BINDVARS)
                sv_v = urhk_dbSQLWithBind(sv_a)
		print(sv_v)
                IF(sv_v == 0)then
                #{
                sv_x = urhk_dbSQLWithBind("COMMIT")
                #}
				PRINT("SVS SIGNMAINTENANCE Updated")
                endif

                		#sv_a = " update SVSUSER.signcustinfo set EXPIRYDATE = to_date(?SVAR,'DD-MM-YYYY') ,LASTACTIVITY=?SVAR,MODIFIEDBY=?SVAR,MODIFIEDDATE=to_timestamp(?SVAR,'DD-MM-RR HH24:MI:SSXFF'),VERIFIEDBY=?SVAR,VERIFIEDDATE=to_timestamp(?SVAR,'DD-MM-RR HH24:MI:SSXFF') where  SIGNID  ='"+CUST.DATA.signid+"' "
				sv_a = " UPDATE SVSUSER.signcustinfo SET EXPIRYDATE = TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF'),LASTACTIVITY=?SVAR,MODIFIEDBY=?SVAR,  MODIFIEDDATE=TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF'), "
				sv_a = sv_a + " VERIFIEDBY=?SVAR,VERIFIEDDATE=TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF')  WHERE LASTACTIVITY='ADD'  AND DELETED ='N' "
				sv_a = sv_a + " AND TRUNC(CREATEDDATE) IN TO_DATE((SELECT RCRE_TIME FROM TBAADM.AAS WHERE NMA_KEY_ID =?SVAR AND ACCT_POA_AS_REC_TYPE ='O' and trunc(LCHG_TIME) = trunc(sysdate) "
				sv_a = sv_a + " AND ACID IN(SELECT ACID FROM TBAADM.GAM WHERE FORACID =?SVAR) )) AND CUSTID=?SVAR AND CREATEDBY =?SVAR "

                		#BANCS.INPARAM.BINDVARS = CUST.DATA.expdate+"|UPDATE|"+CUST.DATA.userId+"|"+BANCS.STDIN.sysDate+"|"+CUST.DATA.userId+"|"+BANCS.STDIN.sysDate
                		BANCS.INPARAM.BINDVARS = BANCS.STDIN.sysDate+"|UPDATE|"+CUST.DATA.USERID+"|"+BANCS.STDIN.sysDate+"|"+CUST.DATA.USERID+"|"+BANCS.STDIN.sysDate +"|"+ CUST.DATA.cif +"|"+ CUST.DATA.account +"|"+ CUST.DATA.cif +"|"+ BANCS.STDIN.userId
				print(BANCS.INPARAM.BINDVARS)
                		sv_v = urhk_dbSQLWithBind(sv_a)
				print(sv_v)
                		IF(sv_v == 0)then
                		#{
                			sv_x = urhk_dbSQLWithBind("COMMIT")
                		#}
               		 	endif

	
				#######SVS UPDATE ENDS HERE#
				
				SBASVSEND:
				
					
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " has been removed successfully."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				sv_k ="200"
				sv_t="ResponseCode| " + sv_k
				sv_m = urhk_SetOrbOut(sv_t)
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentEMAIL| " + CUST.DATA.EMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentPHONE| " + CUST.DATA.PHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountPHONE| " + CUST.DATA.AccountPHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountEMAIL| " + CUST.DATA.AccountEMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentName| " + CUST.DATA.CUST_NAME
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ELSE
			#{
					GOTO REMCHECKERROR
			#}
			ENDIF
 			CUST.DATA.tablekey = CUST.DATA.acid +"/" +BANCS.STDIN.mySolId + "/" + BANCS.STDIN.contextBankId
			PRINT(CUST.DATA.tablekey)

		#}
		ENDIF


	#}
	ENDIF



	#####################################################CAA ACCOUNT#############################################
	IF(CUST.DATA.STYPE == "CAA")THEN
	#{

		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.DATA.account)
		PRINT(sv_u)
			
		sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)


		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)

			sv_s = "SERIALNUM|"
			sv_s = sv_s + " SELECT ACCT_POA_AS_SRL_NUM-1 FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "NMA_KEY_ID=?SVAR AND BANK_ID=?SVAR AND ACID=?SVAR AND DEL_FLG='N'"

			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acid
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				print(BANCS.OUTPARAM.SERIALNUM)	
				CUST.DATA.sn = BANCS.OUTPARAM.SERIALNUM
				print(CUST.DATA.sn)
				sv_e = CUST.DATA.sn
			#}
			ELSE
			#{
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " is not found."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			ENDIF	

		
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.delFlg|Y")
			print(sv_u)
			print(BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.authEndDate|"+BANCS.STDIN.BODDate)
			print(sv_u)
				
