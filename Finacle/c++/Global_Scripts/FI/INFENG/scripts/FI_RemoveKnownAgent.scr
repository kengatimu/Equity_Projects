				PRINT("SVS SIGNMAINTENANCE Updated")
                endif

                		#sv_a = " update SVSUSER.signcustinfo set EXPIRYDATE = to_date(?SVAR,'DD-MM-YYYY') ,LASTACTIVITY=?SVAR,MODIFIEDBY=?SVAR,MODIFIEDDATE=to_timestamp(?SVAR,'DD-MM-RR HH24:MI:SSXFF'),VERIFIEDBY=?SVAR,VERIFIEDDATE=to_timestamp(?SVAR,'DD-MM-RR HH24:MI:SSXFF') where  SIGNID  ='"+CUST.DATA.signid+"' "
				sv_a = " UPDATE SVSUSER.signcustinfo SET EXPIRYDATE = TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF'),LASTACTIVITY=?SVAR,MODIFIEDBY=?SVAR,  MODIFIEDDATE=TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF'), "
				sv_a = sv_a + " VERIFIEDBY=?SVAR,VERIFIEDDATE=TO_TIMESTAMP(?SVAR,'DD-MM-RR HH24:MI:SS.FF')  WHERE LASTACTIVITY='ADD'  AND DELETED ='N' "
				sv_a = sv_a + " AND TRUNC(CREATEDDATE) IN TO_DATE((SELECT RCRE_TIME FROM TBAADM.AAS WHERE NMA_KEY_ID =?SVAR AND ACCT_POA_AS_REC_TYPE ='O' and trunc(LCHG_TIME) = trunc(sysdate) "
				sv_a = sv_a + " AND ACID IN(SELECT ACID FROM TBAADM.GAM WHERE FORACID =?SVAR) )) AND CUSTID=?SVAR AND CREATEDBY =?SVAR "

