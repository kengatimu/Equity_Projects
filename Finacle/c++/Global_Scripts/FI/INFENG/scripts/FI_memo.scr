<--start
trace on


        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","MM") == 0) THEN
        #{
                CREATECLASS("CUST","MM",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("function"))== 0) ) THEN
	#{
   		CUST.MM.errMsg="function is not available"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.MM.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("cifid"))== 0) ) THEN
	#{
   		CUST.MM.errMsg="cifid is not available"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.MM.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF


	################################ Variable Inititalization###########################################################
	CUST.MM.function= BANCS.INPUT.function
	print(CUST.MM.function)
	CUST.MM.cifid= BANCS.INPUT.cifid
	print(CUST.MM.cifid)

	if((CUST.MM.function!="I") AND (CUST.MM.function!="D"))then
	#{
   		CUST.MM.errMsg="function is not I/D"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.MM.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT			

	#}
	endif

	#-----------------------CIF VALIDATION--------------------
	sv_s = "count|select count(*) from crmuser.accounts  "
	sv_s = sv_s + "where bank_ID=?SVAR and orgkey=?SVAR "
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.MM.cifid
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_r =  urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	IF (sv_r ==0) THEN
	#{
		CUST.MM.count= BANCS.OUTPARAM.count
		print (CUST.MM.count)
		IF(CUST.MM.count !=0)THEN
		#{
			IF(CUST.MM.function=="I")THEN
			#{
				sv_s = "cifid, msg1, msg2, msg3, msg4,msg5,msg6,msg7,msg8|SELECT foracid,NVL(msg_text_1,' '),NVL(msg_text_2,' '),"
				sv_s = sv_s + "NVL(msg_text_3,' '),NVL(msg_text_4,' '),NVL(msg_text_5,' '),NVL(msg_text_6,' '),NVL(msg_text_7,' '),NVL(msg_text_8,' ') "
				sv_s = sv_s + "FROM CUSTOM.C_MOP WHERE bank_id = ?SVAR AND del_flg = 'N' AND foracid = ?SVAR"
				print(sv_s)
		
				BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.MM.cifid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_r =  urhk_dbSelectWithBind(sv_s)
				print(sv_r)
				IF (sv_r ==0) THEN
				#{

					IF(BANCS.OUTPARAM.cifid == "")THEN
					#{
						CUST.MM.cifid=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg1== "")THEN
					#{
						CUST.MM.msg1=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg2== "")THEN
					#{
						CUST.MM.msg2=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg3== "")THEN
					#{
						CUST.MM.msg3=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg4== "")THEN
					#{
						CUST.MM.msg4=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg5== "")THEN
					#{
						CUST.MM.msg5=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg6== "")THEN
					#{
						CUST.MM.msg6=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg7== "")THEN
					#{
						CUST.MM.msg7=" "
					#}
					ENDIF
					IF(BANCS.OUTPARAM.msg8== "")THEN
					#{
						CUST.MM.msg8=" "
					#}
					ENDIF


					CUST.MM.cifid= BANCS.OUTPARAM.cifid
					CUST.MM.msg1= BANCS.OUTPARAM.msg1
					CUST.MM.msg2= BANCS.OUTPARAM.msg2
					CUST.MM.msg3= BANCS.OUTPARAM.msg3
					CUST.MM.msg4= BANCS.OUTPARAM.msg4
					CUST.MM.msg5= BANCS.OUTPARAM.msg5
					CUST.MM.msg6= BANCS.OUTPARAM.msg6
					CUST.MM.msg7= BANCS.OUTPARAM.msg7
					CUST.MM.msg8= BANCS.OUTPARAM.msg8

					sv_t = "cifid | " +CUST.MM.cifid 
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg1| " +CUST.MM.msg1
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg2| " +CUST.MM.msg2
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg3| " +CUST.MM.msg3
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg4| " +CUST.MM.msg4
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg5| " +CUST.MM.msg5
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg6| " +CUST.MM.msg6
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg7| " +CUST.MM.msg7
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "msg8| " +CUST.MM.msg8
					sv_u = urhk_SetOrbOut(sv_t)					
				

				#}
				ELSE
				#{
   					CUST.MM.errMsg="No record found"
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
					sv_t = "Msg| " +CUST.MM.errMsg
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO ENDSCRIPT
				#}
				ENDIF
			#}
			ELSE
			#{
				IF(CUST.MM.function=="D")THEN
				#{

					sv_s = "foracid,msg_text_1,msg_text_2,msg_text_3,msg_text_4,msg_text_5,msg_text_6,msg_text_7,msg_text_8|"
					sv_s = sv_s + "SELECT foracid,NVL(msg_text_1,' '),NVL(msg_text_2,' '),NVL(msg_text_3,' '),NVL(msg_text_4,' '),NVL(msg_text_5,' '),NVL(msg_text_6,' '),NVL(msg_text_7,' '),NVL(msg_text_8,' ') "
					sv_s = sv_s + "FROM CUSTOM.C_MOP "
					sv_s = sv_s + "WHERE foracid = ?SVAR "
					sv_s = sv_s + "AND del_flg = 'N' "
					sv_s = sv_s + "AND bank_id = ?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.MM.cifid + "|" + BANCS.STDIN.contextBankId
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUST.MM.dba_custID   = BANCS.OUTPARAM.foracid
						PRINT(CUST.MM.dba_custID)
						CUST.MM.dba_Message1 = BANCS.OUTPARAM.msg_text_1
						PRINT(CUST.MM.dba_Message1)
						CUST.MM.dba_Message2 = BANCS.OUTPARAM.msg_text_2
						PRINT(CUST.MM.dba_Message2)
						CUST.MM.dba_Message3 = BANCS.OUTPARAM.msg_text_3
						PRINT(CUST.MM.dba_Message3)
						CUST.MM.dba_Message4 = BANCS.OUTPARAM.msg_text_4
						PRINT(CUST.MM.dba_Message4)
						CUST.MM.dba_Message5 = BANCS.OUTPARAM.msg_text_5
						PRINT(CUST.MM.dba_Message5)
						CUST.MM.dba_Message6 = BANCS.OUTPARAM.msg_text_6
						PRINT(CUST.MM.dba_Message6)
						CUST.MM.dba_Message7 = BANCS.OUTPARAM.msg_text_7
						PRINT(CUST.MM.dba_Message7)
						CUST.MM.dba_Message8 = BANCS.OUTPARAM.msg_text_8
						PRINT(CUST.MM.dba_Message8)
			
						CUST.MM.adt_custID   = BANCS.OUTPARAM.foracid
						PRINT(CUST.MM.adt_custID)
						CUST.MM.adt_Message1 = BANCS.OUTPARAM.msg_text_1
						PRINT(CUST.MM.adt_Message1)
						CUST.MM.adt_Message2 = BANCS.OUTPARAM.msg_text_2
						PRINT(CUST.MM.adt_Message2)
						CUST.MM.adt_Message3 = BANCS.OUTPARAM.msg_text_3
						PRINT(CUST.MM.adt_Message3)
						CUST.MM.adt_Message4 = BANCS.OUTPARAM.msg_text_4
						PRINT(CUST.MM.adt_Message4)
						CUST.MM.adt_Message5 = BANCS.OUTPARAM.msg_text_5
						PRINT(CUST.MM.adt_Message5)
						CUST.MM.adt_Message6 = BANCS.OUTPARAM.msg_text_6
						PRINT(CUST.MM.adt_Message6)
						CUST.MM.adt_Message7 = BANCS.OUTPARAM.msg_text_7
						PRINT(CUST.MM.adt_Message7)
						CUST.MM.adt_Message8 = BANCS.OUTPARAM.msg_text_8
						PRINT(CUST.MM.adt_Message8)
					#}
					ENDIF

					sv_s = "Count|SELECT COUNT(1) "
					sv_s = sv_s + "FROM CUSTOM.C_MOP "
					sv_s = sv_s + "WHERE foracid = ?SVAR "
					sv_s = sv_s + "AND del_flg = 'N' "
					sv_s = sv_s + "AND bank_id = ?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.MM.cifid + "|" + BANCS.STDIN.contextBankId
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUST.MM.Count = BANCS.OUTPARAM.Count
					#}
					ELSE
					#{
						CUST.MM.Count = ""
					#}
					ENDIF
					PRINT(CUST.MM.Count)
					IF (CINT(CUST.MM.Count) == 0) THEN
					#{

   						CUST.MM.errMsg="Record Does not exists"
						sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
						sv_t = "Msg| " +CUST.MM.errMsg
						sv_u = urhk_SetOrbOut(sv_t)
   						GOTO ENDSCRIPT	
					#}
					ELSE
					#{
						sv_s = "UPDATE CUSTOM.C_MOP "
						sv_s = sv_s + "SET del_flg = 'Y' "
						sv_s = sv_s + "WHERE foracid = ?SVAR "
						sv_s = sv_s + "AND del_flg = 'N' "
						sv_s = sv_s + "AND bank_id = ?SVAR"
						BANCS.INPARAM.BINDVARS = CUST.MM.cifid + "|" + BANCS.STDIN.contextBankId
						PRINT(sv_s)
						sv_d = urhk_dbSQLWithBind(sv_s)
						PRINT(sv_d)
						IF (sv_d != 0 ) THEN
						#{
   							CUST.MM.errMsg="A Database error has occured. Please contact your DBA."
							sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
							sv_t = "Msg| " +CUST.MM.errMsg
							sv_u = urhk_SetOrbOut(sv_t)
   							GOTO ENDSCRIPT
						#}
						ELSE
						#{
							sv_s = "srlnum|SELECT CUSTOM.CUST_MEMO_AUDIT_SEQ_"+ BANCS.STDIN.contextBankId + ".nextval "
							sv_s = sv_s + "FROM DUAL"
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF (sv_d == 0) THEN
							#{
								CUST.MM.srlnum = BANCS.OUTPARAM.srlnum
								PRINT(CUST.MM.srlnum)
								CUST.MM.var1 = "DC"+ CUST.MM.srlnum
								PRINT(CUST.MM.var1)
								CUST.MM.srlnum = CUST.MM.var1
								PRINT(CUST.MM.srlnum)
								BANCS.STDIN.sysDate = MID$(BANCS.STDIN.sysDate,0,10)
								PRINT(BANCS.STDIN.sysDate)
								BANCS.STDIN.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
								PRINT(BANCS.STDIN.BODDate)

								sv_s = "INSERT INTO CUSTOM.C_AMOP(foracid,msg_text_1,msg_text_2,msg_text_3,msg_text_4,msg_text_5,msg_text_6,msg_text_7,msg_text_8,AUDIT_SRL_NUM,ENTERER_ID,AUDIT_DATE,FUNC_CODE,INIT_SOL_ID,AUDIT_BOD_DATE,bank_id)"
								sv_s = sv_s + "VALUES("
								sv_s = sv_s + "?SVAR,"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "NVL(?SVAR,' '),"
								sv_s = sv_s + "?SVAR,"
								sv_s = sv_s + "?SVAR,"
								sv_s = sv_s + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
								sv_s = sv_s + "'D',"
								sv_s = sv_s + "?SVAR,"
								sv_s = sv_s + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
								sv_s = sv_s + "?SVAR"
								sv_s = sv_s + ")"
								PRINT(sv_s)
								BANCS.INPARAM.BINDVARS = CUST.MM.cifid + "|" + CUST.MM.adt_Message1 + "|" + CUST.MM.adt_Message2 + "|" + CUST.MM.adt_Message3 + "|" + CUST.MM.adt_Message4 + "|" + CUST.MM.adt_Message5 + "|" + CUST.MM.adt_Message6 + "|" + CUST.MM.adt_Message7 + "|" + CUST.MM.adt_Message8 + "|" + CUST.MM.srlnum + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.sysDate + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.BODDate + "|" + BANCS.STDIN.contextBankId
								PRINT(BANCS.INPARAM.BINDVARS)
								sv_d = urhk_dbSQLWithBind(sv_s)
								sv_d = urhk_dbSQLWithBind("COMMIT")
								PRINT(sv_d)
								IF (sv_d != 0 ) THEN
								#{
   									CUST.MM.errMsg="A Database error has occured. Please contact your DBA."
									sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
									sv_t = "Msg| " +CUST.MM.errMsg
									sv_u = urhk_SetOrbOut(sv_t)
   									GOTO ENDSCRIPT
								#}
								ELSE
								#{
   									CUST.MM.errMsg="Record deleted successfully"
									sv_z = urhk_SetOrbOut("SuccessOrFailure|success")
									sv_t = "Msg| " +CUST.MM.errMsg
									sv_u = urhk_SetOrbOut(sv_t)
   									GOTO ENDSCRIPT
								#}
								ENDIF
							#}						
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ELSE
		#{
   			CUST.MM.errMsg="Invalid cif ID"
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_t = "Msg| " +CUST.MM.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT	
		#}
		ENDIF

	#}	
	ENDIF

ENDSCRIPT:

trace off

