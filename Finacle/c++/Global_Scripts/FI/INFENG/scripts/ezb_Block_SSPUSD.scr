<--start
trace on

	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	
	EBSRV.GLBDATA.drAccount = ""
	EBSRV.GLBDATA.crAccount = ""
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.addlTranCritPtr.tranParticularCode.refCode")
	EBSRV.GLBDATA.usertCode=BANCS.OUTPARAM.srvValue
	print(EBSRV.GLBDATA.usertCode)

	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)

	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")

	sv_v = "rec_" + sv_j

	while(sv_j < sv_i)
	#{
		if (sv_j == 2) then
			GOTO VALIDATE
		endif
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
        	EBSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
        	print(EBSRV.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
        	EBSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
        	print(EBSRV.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
        	EBSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
        	print(EBSRV.GLBDATA.partTranType)

		if( EBSRV.GLBDATA.foracid!="" )then	

			sv_p= "schm_code,acct_ownership,crncy_code|SELECT "
			sv_p = sv_p + "SCHM_CODE,ACCT_OWNERSHIP, ACCT_CRNCY_CODE "
			sv_p = sv_p + " FROM TBAADM.GAM WHERE BANK_ID = ?SVAR AND FORACID=?SVAR "

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.foracid 
			print(sv_p)
			sv_d = urhk_dbSelectWithBind(sv_p)
			print(sv_d)

			if(sv_d==0) then
				if(EBSRV.GLBDATA.partTranType=="C") then
					sv_v = "schmCodeCr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = BANCS.OUTPARAM.schm_code
					print( ("EBSRV").("GLBDATA").(sv_v) )
					sv_v = "schmCodeDr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = ""
					print( ("EBSRV").("GLBDATA").(sv_v) )

					sv_v = "acctOwnershipCr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = BANCS.OUTPARAM.acct_ownership
					print( ("EBSRV").("GLBDATA").(sv_v) )
					sv_v = "acctOwnershipDr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = ""
					print( ("EBSRV").("GLBDATA").(sv_v) )

					sv_v = "crncyCodeCr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = BANCS.OUTPARAM.crncy_code
					print( ("EBSRV").("GLBDATA").(sv_v) )
					sv_v = "crncyCodeDr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = ""
					print( ("EBSRV").("GLBDATA").(sv_v) )
				ELSE 
					sv_v = "schmCodeDr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = BANCS.OUTPARAM.schm_code
					print( ("EBSRV").("GLBDATA").(sv_v) )
					sv_v = "schmCodeCr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = ""
					print( ("EBSRV").("GLBDATA").(sv_v) )

					sv_v = "acctOwnershipDr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = BANCS.OUTPARAM.acct_ownership
					print( ("EBSRV").("GLBDATA").(sv_v) )
					sv_v = "acctOwnershipCr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = ""
					print( ("EBSRV").("GLBDATA").(sv_v) )

					sv_v = "crncyCodeDr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = BANCS.OUTPARAM.crncy_code
					print( ("EBSRV").("GLBDATA").(sv_v) )
					sv_v = "crncyCodeCr_" + sv_j
					("EBSRV").("GLBDATA").(sv_v) = ""
					print( ("EBSRV").("GLBDATA").(sv_v) )
				endif
			endif
		endif

        	sv_j = CINT(sv_j) + 1
        	sv_j = FORMAT$(sv_j,"%d")
		print(sv_j)
	#}
	DO

VALIDATE:
	print("comparing the two")
	IF( (EBSRV.GLBDATA.crncyCodeDr_0 !="")  AND (EBSRV.GLBDATA.crncyCodeCr_1 !="")) THEN
		IF( (EBSRV.GLBDATA.crncyCodeDr_0 == "SSP") AND (EBSRV.GLBDATA.crncyCodeCr_1 !="SSP") ) THEN
			sv_u = urhk_SRV_SetErr("Transfer from SSP to Foreign Currency not allowed")
    			BANCS.OUTPUT.successOrFailure="F"
		ELSE
			PRINT("Validation successful")
			PRINT(EBSRV.GLBDATA.crncyCodeDr_0)
			PRINT(EBSRV.GLBDATA.crncyCodeCr_1)
		ENDIF
	ENDIF 

	IF( (EBSRV.GLBDATA.crncyCodeDr_1 !="")  AND (EBSRV.GLBDATA.crncyCodeCr_0 !="")) THEN
		IF( (EBSRV.GLBDATA.crncyCodeDr_1 == "SSP") AND (EBSRV.GLBDATA.crncyCodeCr_0 !="SSP") ) THEN
			sv_u = urhk_SRV_SetErr("Transfer from SSP to Foreign Currency not allowed")
    			BANCS.OUTPUT.successOrFailure="F"
		ELSE
			PRINT("Validation successful")
			PRINT(EBSRV.GLBDATA.crncyCodeDr_1)
			PRINT(EBSRV.GLBDATA.crncyCodeCr_0)
		ENDIF
	ENDIF 

##trace off
end-->

