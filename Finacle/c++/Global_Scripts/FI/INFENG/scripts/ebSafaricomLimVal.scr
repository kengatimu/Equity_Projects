<--start
trace on
#Rep/Class
        libname CUSTOMSO
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA") == 0) then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_u = urhk_B2k_PrintRepos("BANCS")
        print(sv_u)
        sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
        EQSRV.GLBDATA.tranId = TRIM(BANCS.OUTPARAM.srvValue)
        print(EQSRV.GLBDATA.tranId)
        sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
        EQSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
        sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
        EQSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
        sv_u = urhk_SRV_GetVal("tranHdr.status")
        EQSRV.GLBDATA.tranStatus=BANCS.OUTPARAM.srvValue
        print(EQSRV.GLBDATA.tranStatus)
        ##if ((EQSRV.GLBDATA.tranSubType == "NP") or (EQSRV.GLBDATA.tranSubType=="CP") or (EQSRV.GLBDATA.tranSubType=="NR") or (EQSRV.GLBDATA.tranSubType=="CR"))then
        sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
        sv_i = BANCS.OUTPARAM.srvValue
        print(sv_i)
        sv_p = 1
        sv_j = 0
        sv_p = FORMAT$(sv_p,"%d")
        sv_j = FORMAT$(sv_j,"%d")
        while(sv_j < sv_i)
        #{
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
                        EQSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.foracid)
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
                        EQSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.tran_amt)
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
                        EQSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.partTranType)
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
                        EQSRV.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.tran_rmks)
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
                        EQSRV.GLBDATA.tranParti=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.tranParti)
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rateCode.refCode")
                        EQSRV.GLBDATA.rateCode=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.rateCode)
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rate")
                        EQSRV.GLBDATA.Rate=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.Rate)
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.pstdFlg")
                        EQSRV.GLBDATA.pstdFlg=BANCS.OUTPARAM.srvValue
                        print(EQSRV.GLBDATA.pstdFlg)

                sv_l = strlen(EQSRV.GLBDATA.tran_amt)
                sv_f = mid$(EQSRV.GLBDATA.tran_amt,0,sv_l)
                sv_l = strlen(EQSRV.GLBDATA.tran_amt)
                sv_p = getposition(sv_f,"|")
                EQSRV.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
                EQSRV.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
                sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
                if(sv_u==0)then
                #{
                        EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
                        EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
                        EQSRV.GLBDATA.acctSolId = BANCS.OUTPARAM.acctSolId
                        EQSRV.GLBDATA.cifid = BANCS.OUTPARAM.cifId
                        EQSRV.GLBDATA.custId = BANCS.OUTPARAM.custId
                        EQSRV.GLBDATA.dealerCode = ""
                #}
                endif
                if(EQSRV.GLBDATA.schmCode !="SB167")then
                        goto VAYU
                endif
        sv_d = "natIdNum,dealerCode | select nat_id_card_num,(select free_text "
        sv_d = sv_d + " from tbaadm.gam where bank_id=?SVAR and foracid='"+EQSRV.GLBDATA.foracid+"' and del_flg='N')"
        sv_d = sv_d + " from tbaadm.cmg where bank_id=?SVAR and cif_id=?SVAR "
        sv_d = sv_d + " and entity_cre_flg='Y' and del_flg='N' "
        print(sv_d)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.cifid
        sv_u = urhk_dbSelectWithBind(sv_d)
        if(sv_u==0)then
                EQSRV.GLBDATA.natIdNum = BANCS.OUTPARAM.natIdNum
                EQSRV.GLBDATA.dealerCode = BANCS.OUTPARAM.dealerCode
        else
                EQSRV.GLBDATA.natIdNum = ""
                EQSRV.GLBDATA.dealerCode = ""
        endif
        if(EQSRV.GLBDATA.natIdNum=="")then
                sv_u = urhk_SRV_SetErr("National Id Number not Exists ["+ EQSRV.GLBDATA.cifid + "]")
                exitscript
        endif
        if(EQSRV.GLBDATA.dealerCode=="")then
                sv_u = urhk_SRV_SetErr("Dealer Code Not Exists ["+ EQSRV.GLBDATA.cifid + "]")
                exitscript
        endif
        if((EQSRV.GLBDATA.cifid!="") and (EQSRV.GLBDATA.natIdNum!="") and (EQSRV.GLBDATA.schmCode=="SB167"))then
        ##{
        sv_s = "refNum|SELECT CONCAT(CONCAT('EQSAFIVAL',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5)))"
        sv_s = sv_s + " FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        if(sv_d == 0)then
                EQSRV.GLBDATA.refNum = BANCS.OUTPARAM.refNum
                print(EQSRV.GLBDATA.refNum)
        endif
        EQSRV.GLBDATA.edResp =  EQSRV.GLBDATA.refNum + ".dat"
        EQSRV.GLBDATA.amount = EQSRV.GLBDATA.trans_amt
        EQSRV.GLBDATA.dealerAccountNumber = EQSRV.GLBDATA.foracid 
        ##EQSRV.GLBDATA.dealerCode = "0785699353"
        EQSRV.GLBDATA.dealerCode = EQSRV.GLBDATA.dealerCode
        EQSRV.GLBDATA.finacleUserId = BANCS.STDIN.userId
        EQSRV.GLBDATA.payMethod = "C"
        EQSRV.GLBDATA.payRef = "4343"
        EQSRV.GLBDATA.serviceId = "2223"
        EQSRV.GLBDATA.NationalId = EQSRV.GLBDATA.natIdNum
        EQSRV.GLBDATA.httpURL = "http://10.11.2.6:9000/SafDealerPortal/SafDealerImpService"
        EQSRV.GLBDATA.jInp = EQSRV.GLBDATA.amount + " " + EQSRV.GLBDATA.dealerAccountNumber + " " + EQSRV.GLBDATA.dealerCode + " " + EQSRV.GLBDATA.finacleUserId + " " + EQSRV.GLBDATA.payMethod + " " + EQSRV.GLBDATA.payRef + " " + EQSRV.GLBDATA.serviceId + " " + EQSRV.GLBDATA.NationalId + " " + EQSRV.GLBDATA.httpURL
        print(EQSRV.GLBDATA.jInp)
        sv_r=system("java -cp /finacle/EQPRODFI/BackEnd/Finacle/FC/app/cust/INFENG com.cubpEquityDirect.ebSafaricomMerchantVal.ebSafaricomMerchantVal "+ EQSRV.GLBDATA.jInp + " >> " +EQSRV.GLBDATA.edResp )
	print(sv_r)
        sv_a = urhk_getEnv("ONS_LOG_DIR")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
                print("Env variable ONS/log not found")
                goto VAYU
        endif
        EQSRV.GLBDATA.ONS_path = BANCS.OUTPARAM.envValue
        print(EQSRV.GLBDATA.ONS_path)
        EQSRV.GLBDATA.fileLoc = EQSRV.GLBDATA.ONS_path +"/"+BANCS.STDIN.userId + "/" + EQSRV.GLBDATA.edResp
        print(EQSRV.GLBDATA.fileLoc)
        sv_r = urtn_fileAccess(EQSRV.GLBDATA.fileLoc)
        ###print(sv_r)
        if(sv_r != 0)then
                EQSRV.GLBDATA.excmessageField = "File does not exists"
                sv_z = urhk_SetOrbOut("Error_1|Error^File does not exist^txtFilename")
                goto VAYU
        else
                EQSRV.GLBDATA.fileopen = "Y"
        endif
        print(EQSRV.GLBDATA.fileopen)
        sv_s = urtn_fileOpen(EQSRV.GLBDATA.fileLoc + "|r")
        if(sv_s < 0)then
                print("error in openning file")
        else
        sv_k = urtn_fileRead(sv_s+"|EQSRV.GLBDATA.Record1")
        EQSRV.GLBDATA.recNum =1
        while(sv_k == 0)
        #{
                if(EQSRV.GLBDATA.Record1 =="")then
                        goto NEXTRECORD
                else
                        BANCS.INPUT.wkbAcct = ""
                        ###print(EQSRV.GLBDATA.Record1)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        ###print(sv_f)
                        sv_p = getposition(sv_f,"|")
                        BANCS.INPUT.wkbAcct  = mid$(sv_f,0,(sv_p-1))
                        print(BANCS.INPUT.wkbAcct)
                        if(BANCS.INPUT.wkbAcct!="00")then
                                EQSRV.GLBDATA.errorFlg = "Y"
                                EQSRV.GLBDATA.errorMsg = "Safaricom Merchant Not Exists"
                                sv_u = urhk_SetOrbOut("errorFlg|"+EQSRV.GLBDATA.errorFlg)
                                sv_u = urhk_SetOrbOut("errorMsg|"+EQSRV.GLBDATA.errorMsg)
                                sv_s = system("rm -f " + EQSRV.GLBDATA.fileLoc)
                                sv_u = urhk_SRV_SetErr("Safaricom Agent Valiation Failed for  ["+ EQSRV.GLBDATA.cifid + "]")
                                exitscript
                        endif
                        #+++++++++++++
                        #CifId
                        #+++++++++++++
                        EQSRV.GLBDATA.Record1 = mid$(sv_f,sv_p,sv_l)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.rnatId  = mid$(sv_f,0,(sv_p-1))
                        #+++++++++++++
                        #Account Number
                        #+++++++++++++
                        EQSRV.GLBDATA.Record1 = mid$(sv_f,sv_p,sv_l)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.rlimit  = mid$(sv_f,0,(sv_p-1))
                        #+++++++++++++
                        #Acct Name
                        #+++++++++++++
                        EQSRV.GLBDATA.Record1 = mid$(sv_f,sv_p,sv_l)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.rpayMethod  = mid$(sv_f,0,(sv_p-1))
                        #+++++++++++++
                        #Acct Name
                        #+++++++++++++
                        EQSRV.GLBDATA.Record1 = mid$(sv_f,sv_p,sv_l)
                        sv_l = strlen(EQSRV.GLBDATA.Record1)
                        sv_f = mid$(EQSRV.GLBDATA.Record1,0,sv_l)
                        sv_p = getposition(sv_f,"|")
                        EQSRV.GLBDATA.rdealerCode  = mid$(sv_f,0,(sv_p-1))
                        #+++++++++++++
                        #Phone Number
                        #+++++++++++++
                        EQSRV.GLBDATA.rdealerName = mid$(sv_f,sv_p,sv_l)
                        print(EQSRV.GLBDATA.rnatId)
                        print(EQSRV.GLBDATA.rlimit)
                        print(EQSRV.GLBDATA.rpayMethod)
                        print(EQSRV.GLBDATA.rdealerCode)
                        print(EQSRV.GLBDATA.rdealerName)
                        if(EQSRV.GLBDATA.natIdNum!=EQSRV.GLBDATA.rnatId)then
                                sv_u = urhk_SRV_SetErr("Safaricom Agent Valiation Failed for  ["+ EQSRV.GLBDATA.cifid + "]")
                                exitscript
                        endif
			print(EQSRV.GLBDATA.trans_amt)
			print(EQSRV.GLBDATA.rlimit)	
                        if(cdouble(EQSRV.GLBDATA.trans_amt)>cdouble(EQSRV.GLBDATA.rlimit))then
                                sv_u = urhk_SRV_SetErr("Safaricom Agent Limit Exceeds  ["+ EQSRV.GLBDATA.cifid + "]")
                                exitscript
                        endif
               endif
                NEXTRECORD:
                sv_k = urtn_fileRead(sv_s+"|EQSRV.GLBDATA.Record1")
                print(EQSRV.GLBDATA.recNum)
                EQSRV.GLBDATA.recNum = CINT(EQSRV.GLBDATA.recNum) +1
                print(EQSRV.GLBDATA.recNum)
        #}
        do
        endif
	#	sv_s = system("rm -f " + EQSRV.GLBDATA.fileLoc)
	##	print(sv_s)
        else
                exitscript
        ##}
        endif
        sv_j = CINT(sv_j) + 1
        sv_j = FORMAT$(sv_j,"%d")
        #}
        DO
        if(EQSRV.GLBDATA.fileLoc!="")then
                sv_s = system("rm -f " + EQSRV.GLBDATA.fileLoc)
                print(sv_s)
        endif
VAYU:
        exitscript
trace off
end-->
