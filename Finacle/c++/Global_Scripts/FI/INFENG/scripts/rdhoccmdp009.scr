        CUST.HOCCM.successFlg = "F"
        GOTO ENDOFSCRIPT
#}
ENDIF

##################################################################################
# Post Tran
##################################################################################
sv_u = urhk_SetUrhkOut("tranHdr.status|postStatus")
sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y|call_mode = N")
print(sv_u)
IF(sv_u != 0)then
#{
        sv_u = urhk_CopyOutToIn("")
