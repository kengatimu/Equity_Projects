                CUST.HOCCM.successFlg = "F"
                GOTO ENDOFSCRIPT
        #}
        ENDIF
#}
ENDIF

#------------------------------------------------------------------------------
# calling script to do payment trasaction if cheque is Inhouse.
#------------------------------------------------------------------------------
IF (CUST.HOCCM.zoneIdentifier == "O") THEN
#{
	call("hoccmdp014.scr")
	IF (CUST.HOCCM.successFlg == "F") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF


