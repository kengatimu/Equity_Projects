CUST.HOCCM.FinTranId = CUST.HOCCM.releaseTranId
CUST.HOCCM.FiRespCode = "000"

#Force post the transaction to remove the exception
##################################################################################
# Fetch Tran Details for Posting
##################################################################################
sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranId|" + CUST.HOCCM.releaseTranId)
