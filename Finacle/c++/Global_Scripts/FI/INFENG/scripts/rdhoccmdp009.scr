# Moving charges to the end as this can cause the transcation to commit
#------------------------------------------------------------------------------
IF (CUST.HOCCM.zoneIdentifier == "O") THEN
#{
        IF ( CUST.HOCCM.InstType == "CHQ" ) THEN
        #{
                #------------------------------------------------------------------------------
