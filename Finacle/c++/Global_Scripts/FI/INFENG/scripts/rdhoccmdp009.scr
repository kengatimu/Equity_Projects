        CUST.HOCCM.fieldName = "abc"
        CUST.HOCCM.successFlg = "F"
        GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_CopyOutToIn("")
print(sv_u)
IF(sv_u != 0)then
#{
        # calling script to trap SRV execution error
        CUST.INTERFACE.srvErrFlg ="Y"
        call("Common_Interface_ErrorExit.scr")
