#}
ENDIF

sv_u = urhk_SetUrhkOut("tranObject.tranIdentifier.tranId|releaseTranId")
sv_u = urhk_SetUrhkOut("tranObject.tranIdentifier.tranDate|releaseTranDate")
sv_u = urhk_SetUrhkOut("tranObject.pstFlg|releaseTranPstFlg")
sv_u = urhk_ExecSrvNoCommit("SRV_ReleaseOcSet|retain_all_output = Y")
print(sv_u)
IF(sv_u != 0)then
#{
	# calling script to trap SRV execution error
	CUST.INTERFACE.srvErrFlg ="Y"
