<--start
trace on


lv_u = urhk_B2k_ForacidToAcid(BANCS.INPUT.foracid)
print(lv_u)

if(lv_u == 0)then
#{
    BANCS.INPUT.acid = BANCS.OUTPARAM.Acid
    print(BANCS.INPUT.acid)
#}
endif

sv_a = BANCS.INPUT.acid
sv_z = BANCS.INPUT.foracid


#---------------------------------------------------------------------
# sv_b - clr_bal_amt; sv_c - future_bal_amt; 
# sv_d - un_clr_bal_amt; sv_e - FullAvailableAmount; 
# sv_f - FxFullAvailableAmt; sv_g - Utilised Limit;  
# sv_h - Unutilised Limit; sv_i - Alloted Limit 
#---------------------------------------------------------------------
sv_b = 0
sv_c = 0
sv_d = 0
sv_e = 0
sv_f = 0
sv_g = 0
sv_h = 0
sv_i = 0

#----------------------------------------------------------------------
# Function to Check if acid is present in the list of scheme types
#----------------------------------------------------------------------
#sv_j = urhk_GetDesc("validateAcctIdForLoansSchmTypes")
#print(sv_j)

#----------------------------------------------------------------------
# User hook function to get the Account Balance
#----------------------------------------------------------------------
sv_n = urhk_getFullAvailAmtForAcct(sv_z)
sv_e = cdouble(BANCS.OUTPARAM.FullAvailableAmt)
print(sv_e)
sv_f = cdouble(BANCS.OUTPARAM.FxFullAvailableAmt)
print(sv_f)

#-----------------------------------------------------------------------
# Function to get the Allotted Limit
#-----------------------------------------------------------------------
#sv_n = "acctClsFlg,sanctLim,adhocLim,emerAdvn,singleTranLim,cleanAdhocLim,cleanEmerAdvn,cleanSingleTranLim,drwngPower,crncyCode| select acct_cls_flg,sanct_lim,adhoc_lim,emer_advn,single_tran_lim,clean_adhoc_lim,clean_emer_advn,clean_single_tran_lim,drwng_power,crncy_code from GAM where" 
#sv_n = sv_n + " GAM.BANK_ID = ?SVAR AND " 
#sv_n = sv_n + " acid= ?SVAR "
#BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + sv_a
#sv_o = urhk_dbSelectWithBind(sv_n)

lv_a = urhk_getAcctDetailsInRepository(BANCS.INPUT.foracid)
print(lv_a)

if(fieldexists(BANCS.OUTPARAM.acctCloseflg)) then  
    sv_p=BANCS.OUTPARAM.acctCloseflg
    print(sv_p)
endif
if(fieldexists(BANCS.OUTPARAM.sanctionLimit)) then
    sv_q=BANCS.OUTPARAM.sanctionLimit
    print(sv_q)
endif
if(fieldexists(BANCS.OUTPARAM.adhocLimit)) then
    sv_r=BANCS.OUTPARAM.adhocLimit
    print(sv_r)
endif
if(fieldexists(BANCS.OUTPARAM.emergencyAdvance)) then
    sv_s=BANCS.OUTPARAM.emergencyAdvance
    print(sv_s)
endif
if(fieldexists(BANCS.OUTPARAM.singleTranLimit)) then
    sv_t=BANCS.OUTPARAM.singleTranLimit
    print(sv_t)
endif
if(fieldexists(BANCS.OUTPARAM.cleanAdhocLimit)) then
    sv_u=BANCS.OUTPARAM.cleanAdhocLimit
    print(sv_u)
endif
if(fieldexists(BANCS.OUTPARAM.cleanEmergencyAdvance)) then
    sv_v=BANCS.OUTPARAM.cleanEmergencyAdvance
    print(sv_v)
endif
if(fieldexists(BANCS.OUTPARAM.cleanSingleTranLimit)) then
    sv_w=BANCS.OUTPARAM.cleanSingleTranLimit
    print(sv_w)
endif
if(fieldexists(BANCS.OUTPARAM.drawingPower)) then
    sv_x=BANCS.OUTPARAM.drawingPower
    print(sv_x)
endif
if(fieldexists(BANCS.OUTPARAM.FCNRCrncyCode)) then
    sv_y = BANCS.OUTPARAM.FCNRCrncyCode
    print(sv_y)
endif
if(fieldexists(BANCS.OUTPARAM.acctCrncyCode)) then
    BANCS.INPUT.acct_crncy_code = BANCS.OUTPARAM.acctCrncyCode
    print(BANCS.INPUT.acct_crncy_code)
endif

#if(fieldexists(BANCS.OUTPARAM.FutureClrBalance)) then
#    sv_y=BANCS.OUTPARAM.FutureClrBalance
#    print(sv_y)
#endif


if(sv_p != "Y") then
    # sv_n - tot_secured_lim 
	sv_n = 0
	# sv_o - tot_clean_lim 
    sv_o = 0
	# Adding sanctLim, adhocLim, emerAdvn and cleanAdhocLim
    sv_n = cdouble(sv_q) + cdouble(sv_r) + cdouble(sv_s) + cdouble(sv_t)
    print(sv_n)
	# Adding cleanAdhocLim, cleanEmerAdvn and cleanSingleTranLim
    sv_o = cdouble(sv_u) + cdouble(sv_v) + cdouble(sv_w)
    print(sv_o)
    if(sv_n > (cdouble(sv_x))) then
		# Calculating the total Alloted Limit
        sv_i = cdouble(sv_x) + sv_o
    else
        sv_i = sv_n + sv_o
    endif
    print(sv_i)
endif
# Calculating the Available amount
print(sv_y)
if(sv_y != "") then
    sv_b = cdouble(BANCS.OUTPARAM.FXClearBalance)
    print(sv_b)
    if (sv_f < 0) then
        sv_e = 0
    else
        sv_e = sv_f
        print(sv_e)
    endif
else
    sv_b = cdouble(BANCS.OUTPARAM.clearBalance)
    sv_c = cdouble(BANCS.OUTPARAM.FutureClrBalance)
    if(sv_e < 0) then
        sv_e = 0
    endif
endif
sv_d = cdouble(BANCS.OUTPARAM.unclearBalance)
print(sv_d)
# Retrieving dis_amt from LAM table if acid is present in the list of scheme types

sv_v = "disAmt| select dis_amt from LAM where" 
sv_v = sv_v + " LAM.BANK_ID = ?SVAR AND " 
sv_v = sv_v + " acid= ?SVAR "
BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + sv_a
sv_o = urhk_dbSelectWithBind(sv_v)
if(sv_o == 0) then
    if(fieldexists(BANCS.OUTPARAM.disAmt)) then
        sv_g = cdouble(BANCS.OUTPARAM.disAmt)
    endif
else 
    # Calculating the utilised amount
    sv_g = sv_b + sv_d + sv_c
    print(sv_g)
    if(sv_g >= 0) then
        sv_g = 0
    else
        sv_g = sv_g * (-1)
    endif
    print(sv_g)
endif

# Calculating the unutilised amount
sv_h = sv_i - sv_g
print(sv_h)
if(sv_h <= 0) then
    sv_h = 0
endif

#---------------------------------------------------------------------
# Formatting data - trimming off values after two decimal digits
#---------------------------------------------------------------------
BANCS.OUTPUT.alloted_limit = format$(sv_i, "%17.02f")

BANCS.INPARAM.InputAmount = BANCS.OUTPUT.alloted_limit
BANCS.INPARAM.FromCurrency = BANCS.INPUT.acct_crncy_code
BANCS.INPARAM.AmountWidth = 17
sv_z = urhk_B2k_floatWithComma("")
BANCS.OUTPUT.alloted_limit = BANCS.OUTPARAM.OutputAmount

BANCS.OUTPUT.utilised_limit = format$(sv_g, "%17.02f") 

BANCS.INPARAM.InputAmount = BANCS.OUTPUT.utilised_limit
BANCS.INPARAM.FromCurrency = BANCS.INPUT.acct_crncy_code
BANCS.INPARAM.AmountWidth = 17
sv_z = urhk_B2k_floatWithComma("")
BANCS.OUTPUT.utilised_limit = BANCS.OUTPARAM.OutputAmount

BANCS.OUTPUT.avail_amt = format$(sv_e, "%17.02f")

BANCS.INPARAM.InputAmount = BANCS.OUTPUT.avail_amt
BANCS.INPARAM.FromCurrency = BANCS.INPUT.acct_crncy_code
BANCS.INPARAM.AmountWidth = 17
sv_z = urhk_B2k_floatWithComma("")
BANCS.OUTPUT.avail_amt = BANCS.OUTPARAM.OutputAmount

BANCS.OUTPUT.un_utilised_limit = format$(sv_h, "%17.02f")

BANCS.INPARAM.InputAmount = BANCS.OUTPUT.un_utilised_limit
BANCS.INPARAM.FromCurrency = BANCS.INPUT.acct_crncy_code
BANCS.INPARAM.AmountWidth = 17
sv_z = urhk_B2k_floatWithComma("")
BANCS.OUTPUT.un_utilised_limit = BANCS.OUTPARAM.OutputAmount

lv_c = "odExpiry| select l.lim_exp_date "
lv_c = lv_c + " from tbaadm.lht l where l.bank_id=?SVAR and l.acid=?SVAR and l.status='A' and l.supercede_flg='N' and"
lv_c = lv_c + " l.serial_num in (select max(serial_num) from tbaadm.lht where acid=l.acid and bank_id=l.bank_id )"
BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + sv_a
lv_o = urhk_dbSelectWithBind(lv_c)
print(lv_o)

if(lv_o == 0)then
	CUST.INTERFACE.odExpiry = BANCS.OUTPARAM.odExpiry
	print(CUST.INTERFACE.odExpiry)
else 
	CUST.INTERFACE.odExpiry=" "
endif

IF(BANCS.OUTPUT.alloted_limit !="")THEN
    CUST.INTERFACE.odLimit = BANCS.OUTPUT.alloted_limit
ELSE
    CUST.INTERFACE.odLimit = " "
ENDIF

IF(BANCS.OUTPUT.un_utilised_limit !="")THEN
    CUST.INTERFACE.availODAmt = BANCS.OUTPUT.un_utilised_limit
ELSE
    CUST.INTERFACE.availODAmt = " "
ENDIF

IF(BANCS.OUTPUT.utilised_limit !="")THEN
    CUST.INTERFACE.utilizedAmt = BANCS.OUTPUT.utilised_limit
ELSE
    CUST.INTERFACE.utilizedAmt = " "
ENDIF

#sv_u = urhk_SetOrbOut("AllotedLimit|"+ BANCS.OUTPUT.alloted_limit)
#sv_u = urhk_SetOrbOut("UtilisedAmount|"+ BANCS.OUTPUT.utilised_limit)
#sv_u = urhk_SetOrbOut("AvailableAmount|"+ BANCS.OUTPUT.avail_amt)
#sv_u = urhk_SetOrbOut("UnutilisedAmount|"+ BANCS.OUTPUT.un_utilised_limit)

trace off 
end-->
