#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Reps/Class
#++++++++++
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("ONS")==0)then
		createrep("ONS")
	endif
	if(classexists("ONS","CUSTOM")==0)then
		createclass("ONS","CUSTOM",5)
	endif
	if(repexists("EQSRV")==0)then
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then
		createclass("EQSRV","GLBDATA",5)
	endif
#Inp
#+++
	BANCS.INPUT.solId = BANCS.STDIN.mySolId 
	EQSRV.GLBDATA.srvErrCode = ""
	EQSRV.GLBDATA.srvErrMsg = "" 
	EQSRV.GLBDATA.srvSucFail = ""
	EQSRV.GLBDATA.originationDate = BANCS.STDIN.BODDate
	EQSRV.GLBDATA.schmType = "LAA"
	#FiledMapInp
	#++++++++++
		sv_u = urhk_SetUrhkInp("mandatoryParameters.originationDate|" + EQSRV.GLBDATA.originationDate )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.schmCode.schmCode|" + EQSRV.GLBDATA.schmCode )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.schmCode.schmType|" + EQSRV.GLBDATA.schmType )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.crncyCode.crncyCode|" + EQSRV.GLBDATA.crncyCode )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.loanPerdMths|" + EQSRV.GLBDATA.PerdMths )
		sv_u = urhk_SetUrhkInp("mandatoryParameters.loanPerdDays|" + EQSRV.GLBDATA.PerdDays )
		sv_u = urhk_SetUrhkInp("variables.loanAmount|" + EQSRV.GLBDATA.loanAmount + "|" + EQSRV.GLBDATA.crncyCode )
		sv_u = urhk_SetUrhkInp("variables.noOfInstalmnts|" + EQSRV.GLBDATA.noOfInstalmnts )
		sv_u = urhk_SetUrhkInp("variables.intRate|" + EQSRV.GLBDATA.intRate )

		sv_u = urhk_SetUrhkOut("result.matDate|matDate")
		sv_u = urhk_SetUrhkOut("result.effIntRate|effIntRate")
	EQSRV.GLBDATA.counter_2 = "0"
	While(cint(EQSRV.GLBDATA.counter_2) < cint(EQSRV.GLBDATA.noOfInstalmnts))
		EQSRV.GLBDATA.counter_1	= EQSRV.GLBDATA.counter_2
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.key.serial_num|serial_num_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.hldyPrdDmd|hldyPrdDmd_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.flowDate|flowDate_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.instlAmt|instlAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.combInstlAmt|combInstlAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.princAmt|princAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.intAmt|intAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.cummPrincAmt|cummPrincAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.cummIntAmt|cummIntAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.bankSharePcnt|bankSharePcnt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.custSharePcnt|custSharePcnt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.princOutStanding|princOutStanding_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.qntyOfAssetDlvd|qntyOfAssetDlvd_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.variableChrgDmd|variableChrgDmd_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.fixedChargeAmt|fixedChargeAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.flowDesc|flowDesc_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.cummFixedChargeAmt|cummFixedChargeAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.strOfAmtForSbsdy|strOfAmtForSbsdy_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.totalSbsdyAmt|totalSbsdyAmt_"+EQSRV.GLBDATA.counter_1)
		sv_u = urhk_SetUrhkOut("amortLL.<rec_"+EQSRV.GLBDATA.counter_1+">.amortStruct.sellPriceAmt|sellPriceAmt_"+EQSRV.GLBDATA.counter_1)
		EQSRV.GLBDATA.counter_2 = cint(EQSRV.GLBDATA.counter_2) + 1
	do
	#fetchSrv
	#++++++++++
		sv_u = urhk_ExecSrv("SRV_Schedule|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
		print(sv_u)
		if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
			print(BANCS.OUTPARAM.successOrFailure)
			sv_s = BANCS.OUTPARAM.successOrFailure
		else
			sv_s = "X"
		endif
		if (( sv_u == 0 ) and ( sv_s=="S") ) then
			EQSRV.GLBDATA.matDate	= BANCS.OUTPARAM.matDate
			EQSRV.GLBDATA.effIntRate = BANCS.OUTPARAM.effIntRate
		else
			print(EQSRV.GLBDATA.schmCode)
			EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.schmCode 
			callscriptifexist("ebsrvHandler.scr")
			EQSRV.GLBDATA.srvErrMsg	=  EQSRV.GLBDATA.SrvError 
			EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchAcctDtlForTaChrgOff " 
			EQSRV.GLBDATA.srvSucFail = "F"
			goto VAYU
		endif
	EQSRV.GLBDATA.counter_2 = "0"
	while(cint(EQSRV.GLBDATA.counter_2) < cint(EQSRV.GLBDATA.noOfInstalmnts))
		EQSRV.GLBDATA.counter_1	=	EQSRV.GLBDATA.counter_2
		("EQSRV").("GLBDATA").("serialnum_" + EQSRV.GLBDATA.counter_1)	=  ("BANCS").("OUTPARAM").("serial_num_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("hldyPrdDmd_" + EQSRV.GLBDATA.counter_1)	=  ("BANCS").("OUTPARAM").("hldyPrdDmd_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("flowDate_" + EQSRV.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("flowDate_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("instlAmt_" + EQSRV.GLBDATA.counter_1)  = ("BANCS").("OUTPARAM").("instlAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("combInstlAmt_" + EQSRV.GLBDATA.counter_1)  =  ("BANCS").("OUTPARAM").("combInstlAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("princAmt_" + EQSRV.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("princAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("intAmt_" + EQSRV.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("intAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("cummPrincAmt_" + EQSRV.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("cummPrincAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("cummIntAmt_" + EQSRV.GLBDATA.counter_1)  = ("BANCS").("OUTPARAM").("cummIntAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("bankSharePcnt_" + EQSRV.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("bankSharePcnt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("custSharePcnt_" + EQSRV.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("custSharePcnt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("princOutStanding_" + EQSRV.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("princOutStanding_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("qntyOfAssetDlvd_" + EQSRV.GLBDATA.counter_1)=  ("BANCS").("OUTPARAM").("qntyOfAssetDlvd_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("variableChrgDmd_" + EQSRV.GLBDATA.counter_1)  = ("BANCS").("OUTPARAM").("variableChrgDmd_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("fixedChargeAmt_" + EQSRV.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("fixedChargeAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("flowDesc_" + EQSRV.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("flowDesc_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("cummFixedChargeAmt_" + EQSRV.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("cummFixedChargeAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("strOfAmtForSbsdy_" + EQSRV.GLBDATA.counter_1)= ("BANCS").("OUTPARAM").("strOfAmtForSbsdy_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("totalSbsdyAmt_" + EQSRV.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("totalSbsdyAmt_" + EQSRV.GLBDATA.counter_1)
		("EQSRV").("GLBDATA").("sellPriceAmt_" + EQSRV.GLBDATA.counter_1) = ("BANCS").("OUTPARAM").("sellPriceAmt_" + EQSRV.GLBDATA.counter_1)

		EQSRV.GLBDATA.counter_2 = cint(EQSRV.GLBDATA.counter_2) + 1
	do
			
VAYU:
	print(EQSRV.GLBDATA.srvErrMsg)
	print(EQSRV.GLBDATA.srvErrCode)
	print(EQSRV.GLBDATA.srvSucFail)
	exitscript
trace off
end-->
