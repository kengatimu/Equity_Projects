                                                EBSRV.GLBDATA.srvSucFail = "F"
                                                goto NXTREC
                                        endif
                                #}
                                endif
                        if(EBSRV.GLBDATA.TranId!="")then
                        #{
				print(EBSRV.GLBDATA.TranId)
				if((EBSRV.GLBDATA.tranMode=="FI") OR (EBSRV.GLBDATA.tranMode=="ONS"))then
				#{
					lv_o = "tranId|select tran_id from tbaadm.dtd where bank_id=?SVAR and acid=?SVAR and pstd_flg='N' and del_flg='N' and rownum=1"
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.dOdAcid 
