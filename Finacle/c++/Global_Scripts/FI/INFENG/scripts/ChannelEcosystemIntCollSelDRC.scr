        EBSRV.GLBDATA.srvErrMsg = ""
        EBSRV.GLBDATA.srvErrCode = ""
        EBSRV.GLBDATA.srvSucFail = ""
	EBSRV.GLBDATA.tranMode = ""
	EBSRV.GLBDATA.OdAcid = EBSRV.GLBDATA.digitOdAcid
	if(fieldexists(BANCS.STDIN.moduleIdentity)==1)then
	#{
		if(BANCS.STDIN.moduleIdentity=="FI")then
			EBSRV.GLBDATA.tranMode = "FI"
			if(fieldexists(EBSRV.GLBDATA.OdAcid)==1)then
				print(EBSRV.GLBDATA.OdAcid)
