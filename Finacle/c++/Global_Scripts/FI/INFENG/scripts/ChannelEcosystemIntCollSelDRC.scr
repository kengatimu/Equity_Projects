	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.OdAcid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId  

	else
	lv_q = " dDisbSrlNum,dShdlNum,dFlowId,dOdAcid,dOpAcid,dDmdDate,dDmdAmt,dRcreTime,dDisbTranDate,dDisbAmt |  select dmd.disb_srl_num,dmd.shdl_num,dmd.flow_id,dmd.od_acid,dmd.op_acid,to_char(dmd.dmd_date,'DD-MM-YYYY'), "
	lv_q = lv_q + " dmd.dmd_amt,dmd.rcre_time,(select to_char(od_disb_tran_date,'DD-MM-YYYY') from custom.ecosystem_disb_tbl where bank_id=?SVAR and od_acid=dmd.od_acid and disb_srl_num=dmd.disb_srl_num)as disbtrandate, "
