	#{
		EBSRV.GLBDATA.IntCrGLBacid = EBSRV.GLBDATA.intCollbacid
	#}
	else
	#{
		EBSRV.GLBDATA.IntCrGLBacid = ""
	#}
	endif
	IF(EBSRV.GLBDATA.IntCrGLBacid != "") THEN
        sv_t = EBSRV.GLBDATA.IntCrGLBacid +"|"+ BANCS.STDIN.homeCrncyCode +"|"+ BANCS.STDIN.mySolId
        print(sv_t)
        sv_u = urhk_B2k_BacidToAcctId(sv_t)
        if(sv_u == 0 )then
        #{
                EBSRV.GLBDATA.IntCrGlAcctId = BANCS.OUTPARAM.AcctId
