                EBSRV.GLBDATA.srvSucFail = "F"
        	sv_r = urhk_MTTS_Close("")
                goto Endofscript
        #}
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
                EBSRV.GLBDATA.dDisbSrlNum = BANCS.OUTPARAM.dDisbSrlNum
                EBSRV.GLBDATA.dShdlNum = BANCS.OUTPARAM.dShdlNum
                EBSRV.GLBDATA.dFlowId = BANCS.OUTPARAM.dFlowId
                EBSRV.GLBDATA.dOdAcid = BANCS.OUTPARAM.dOdAcid
                EBSRV.GLBDATA.dOpAcid = BANCS.OUTPARAM.dOpAcid
                EBSRV.GLBDATA.dDmdDate = BANCS.OUTPARAM.dDmdDate
                EBSRV.GLBDATA.dDmdAmt = BANCS.OUTPARAM.dDmdAmt
                EBSRV.GLBDATA.dRcreTime = BANCS.OUTPARAM.dRcreTime
                EBSRV.GLBDATA.dDisbTranDate = BANCS.OUTPARAM.dDisbTranDate
                EBSRV.GLBDATA.dDisbAmt = BANCS.OUTPARAM.dDisbAmt


                print(EBSRV.GLBDATA.dDisbSrlNum)
                print(EBSRV.GLBDATA.dShdlNum)
                print(EBSRV.GLBDATA.dFlowId)
                print(EBSRV.GLBDATA.dOdAcid)
                print(EBSRV.GLBDATA.dOpAcid)
                print(EBSRV.GLBDATA.dDmdDate)
                print(EBSRV.GLBDATA.dDmdAmt)
                print(EBSRV.GLBDATA.dRcreTime)
                print(EBSRV.GLBDATA.dDisbTranDate)
                print(EBSRV.GLBDATA.dDisbAmt)


                sv_a= urhk_B2k_AcidToForacid(EBSRV.GLBDATA.dOdAcid)
                if(sv_a==0)then
                #{
                        EBSRV.GLBDATA.drAcctId = BANCS.OUTPARAM.Foracid
                        EBSRV.GLBDATA.LidrAcctId = EBSRV.GLBDATA.drAcctId
