                        EBSRV.GLBDATA.drAcctId = ""
                        EBSRV.GLBDATA.LidrAcctId = ""
                #}
		endif
		print(EBSRV.GLBDATA.drAcctId)
                        #Creation of Debit Tran
                        MTT.PartTranDetails.Account             = EBSRV.GLBDATA.drAcctId
                        MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode
                        MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode
                        MTT.PartTranDetails.Particulars         = "Int.Coll " + EBSRV.GLBDATA.dDisbTranDate + " to " + EBSRV.GLBDATA.dDmdDate + "for " + EBSRV.GLBDATA.drAcctId
                        MTT.PartTranDetails.RefAmount           = -1*cdouble(EBSRV.GLBDATA.dDmdAmt)
                        MTT.PartTranDetails.Amount              = -1*cdouble(EBSRV.GLBDATA.dDmdAmt)
                        MTT.PartTranDetails.Refnum              = "Disb.No" +EBSRV.GLBDATA.dDisbSrlNum + "/ShdlNum." + EBSRV.GLBDATA.dShdlNum
                        MTT.PartTranDetails.RateCode            = ""
                        MTT.PartTranDetails.Rate                = ""
                        MTT.PartTranDetails.TranIdentifier      = "OD549Int"
                        MTT.PartTranDetails.Consolidate         = "N"
                        MTT.PartTranDetails.CarveAmtFlg         = "Y"
                        MTT.PartTranDetails.ReportCode          = "OD549"
                        MTT.PartTranDetails.ValueDateDiff       = "0"
                        MTT.PartTranDetails.Remarks             = EBSRV.GLBDATA.IntCrGlAcctId
                        MTT.PartTranDetails.PstFlg              = "Y"
			MTT.PartTranDetails.TODRefType          = "IC"
			MTT.PartTranDetails.TodEntityType       = "TODIC"
			MTT.PartTranDetails.TodEntityId         = EBSRV.GLBDATA.drAcctId 
