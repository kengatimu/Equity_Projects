	if(EBSRV.GLBDATA.OdAcid!="")then
	lv_q = " dDisbSrlNum,dShdlNum,dFlowId,dOdAcid,dOpAcid,dDmdDate,dDmdAmt,dRcreTime,dDisbTranDate,dDisbAmt |  select dmd.disb_srl_num,dmd.shdl_num,dmd.flow_id,dmd.od_acid,"
	lv_q = lv_q + " dmd.op_acid,to_char(dmd.dmd_date,'DD-MM-YYYY'),dmd.dmd_amt,dmd.rcre_time,(select to_char(od_disb_tran_date,'DD-MM-YYYY') from custom.ecosystem_disb_tbl where bank_id=?SVAR and od_acid=dmd.od_acid "
	lv_q = lv_q + " and disb_srl_num=dmd.disb_srl_num)as disbtrandate,(select od_disb_amt from custom.ecosystem_disb_tbl where bank_id=?SVAR and od_acid=dmd.od_acid and disb_srl_num=dmd.disb_srl_num)as disbtrandate "
	lv_q = lv_q + " from custom.ecosystem_dmd_tbl dmd,tbaadm.gam gam where dmd.bank_id=?SVAR and gam.bank_id=?SVAR and dmd.od_acid=?SVAR and gam.entity_cre_flg='Y' and gam.del_flg='N' and gam.acid=dmd.od_acid and "
	lv_q = lv_q + " gam.acct_cls_flg='N' and gam.acct_cls_date is null and dmd.entity_cre_flg='Y' and dmd.del_flg='N' and dmd.flow_id='INDEM' and dmd.dmd_amt <>0 and dmd.free_text_5 is null "
	##lv_q = lv_q + " and dmd.dmd_date<=to_date(?SVAR,'DD-MM-RRRR') "
	lv_q = lv_q + " and dmd.op_sol_id in (select sol_id from tbaadm.sst where bank_id=?SVAR and set_id=?SVAR) "
