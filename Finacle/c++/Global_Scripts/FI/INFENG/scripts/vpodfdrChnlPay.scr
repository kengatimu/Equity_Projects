<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(fieldexists(BANCS.INPUT.OdAcctId)==1)then
                EBSRV.GLBDATA.OdAcctId = BANCS.INPUT.OdAcctId
        else
                EBSRV.GLBDATA.OdAcctId = ""
        endif
        if(fieldexists(BANCS.INPUT.OpAcctId)==1)then
                EBSRV.GLBDATA.OpAcctId = BANCS.INPUT.OpAcctId
        else
                EBSRV.GLBDATA.OpAcctId = ""
        endif
        if(fieldexists(BANCS.INPUT.RepayMode)==1)then
                EBSRV.GLBDATA.RepayMode = BANCS.INPUT.RepayMode
        else
                EBSRV.GLBDATA.RepayMode = ""
        endif
        if(fieldexists(BANCS.INPUT.RepayAmount)==1)then
                EBSRV.GLBDATA.RepayAmount = BANCS.INPUT.RepayAmount
        else
                EBSRV.GLBDATA.RepayAmount = ""
        endif
        if(fieldexists(BANCS.INPUT.AcctCloseYN)==1)then
                EBSRV.GLBDATA.AcctCloseYN = BANCS.INPUT.AcctCloseYN
        else
                EBSRV.GLBDATA.AcctCloseYN = ""
        endif
        if(EBSRV.GLBDATA.RepayMode=="")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Repayment Mode")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        endif
        if(cdouble(EBSRV.GLBDATA.RepayAmount)<=0)then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Repayment Amount")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        endif
        EBSRV.GLBDATA.odacctCrncyCode = ""
        EBSRV.GLBDATA.opacctCrncyCode = ""
        EBSRV.GLBDATA.odSchmCode = ""
        EBSRV.GLBDATA.crCif  = ""
        EBSRV.GLBDATA.EffBal = ""
        EBSRV.GLBDATA.clearBalance  = ""
        EBSRV.GLBDATA.sanLim = ""
        EBSRV.GLBDATA.drawingPower = ""
        EBSRV.GLBDATA.avalAmt = ""
        EBSRV.GLBDATA.acctClsFlg = ""
        EBSRV.GLBDATA.cclearBalance = ""
        EBSRV.GLBDATA.drCif  = ""
        EBSRV.GLBDATA.opEffBal = ""
        EBSRV.GLBDATA.opclearBalance = ""
        EBSRV.GLBDATA.opsanLim = ""
        EBSRV.GLBDATA.opdrawingPower = ""
        EBSRV.GLBDATA.opavalAmt = ""
        EBSRV.GLBDATA.opsolid = ""
        EBSRV.GLBDATA.acctClsFlg = ""
        EBSRV.GLBDATA.TranId = ""
        EBSRV.GLBDATA.disbTranDate = ""
        EBSRV.GLBDATA.opAcid = ""
        EBSRV.GLBDATA.odAcid = ""
        EBSRV.GLBDATA.srvMsg = ""
        EBSRV.GLBDATA.srvErrorCode = ""
        EBSRV.GLBDATA.srvSF = ""
        EBSRV.GLBDATA.upintAmt = "0"
        EBSRV.GLBDATA.totDue = "0"
        EBSRV.GLBDATA.nappAmt = "0"
        EBSRV.GLBDATA.naccrAmt = "0"
        EBSRV.GLBDATA.outstandingInt = "0"
EBSRV.GLBDATA.orgdrCif  = ""
EBSRV.GLBDATA.orgopEffBal = ""
EBSRV.GLBDATA.orgopclearBalance = ""
EBSRV.GLBDATA.orgopsanLim = ""
EBSRV.GLBDATA.orgopdrawingPower = ""
EBSRV.GLBDATA.orgopavalAmt = ""
EBSRV.GLBDATA.orgopsolid = ""
EBSRV.GLBDATA.orgacctClsFlg = ""
EBSRV.GLBDATA.isMultiPayYN = ""
        EBSRV.GLBDATA.machineId = ""
        sv_u = urhk_getEnv("HOST_NAME")
        print(BANCS.OUTPARAM.envValue)
        EBSRV.GLBDATA.machineId = BANCS.OUTPARAM.envValue

        if(EBSRV.GLBDATA.OdAcctId!="")then
                sv_q = urhk_B2k_ForacidToAcid(EBSRV.GLBDATA.OdAcctId)
                if(sv_q==0)then
                        EBSRV.GLBDATA.odAcid = BANCS.OUTPARAM.Acid
                else
                        EBSRV.GLBDATA.odAcid = ""
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid Loan Account")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                endif
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.OdAcctId)
                if(sv_u!=0)then
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid OD Loan Account")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                else
                        EBSRV.GLBDATA.odSchmCode = BANCS.OUTPARAM.schmCode
                        print(EBSRV.GLBDATA.odSchmCode)
                        EBSRV.GLBDATA.crCif  = BANCS.OUTPARAM.cifId
                        print(EBSRV.GLBDATA.crCif)
                        EBSRV.GLBDATA.EffBal = BANCS.OUTPARAM.EffAvailableAmt
                        print(EBSRV.GLBDATA.EffBal)
                        EBSRV.GLBDATA.cClearBalance = BANCS.OUTPARAM.clearBalance
                        print(EBSRV.GLBDATA.cClearBalance)
                        EBSRV.GLBDATA.odacctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
                endif
                sv_u = urhk_getAdvanceDetailsForAccount(EBSRV.GLBDATA.OdAcctId)
                print(sv_u)
                if(sv_u==0)then
                #{
                        EBSRV.GLBDATA.OrgOpAcctId = BANCS.OUTPARAM.gacFreeText1
                #}
                else
                #{
                        EBSRV.GLBDATA.OrgOpAcctId = ""
                #}
                endif

        endif
        lv_i = " naccrAmt,nbookAmt,nappAmt,nintRate,inintFreqTy,nintFreqStD,accrDtDr,bookDtDr,calcDtDr,nxtDtDr | select nrml_accrued_amount_dr,nrml_booked_amount_dr,nrml_interest_amount_dr,interest_rate,int_freq_type_dr,int_freq_start_dd_dr,to_char(accrued_upto_date_dr,'DD-MM-RRRR'),to_char(booked_upto_date_cr,'DD-MM-RRRR'),to_char(interest_calc_upto_date_dr,'DD-MM-RRRR'),to_char(next_int_run_date_dr,'DD-MM-RRRR') from tbaadm.eit where bank_id=?SVAR and entity_id=?SVAR  "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.odAcid
        lv_b = urhk_dbSelectWithBind(lv_i)
        if(lv_b==0)then
                EBSRV.GLBDATA.naccrAmt = BANCS.OUTPARAM.naccrAmt
                EBSRV.GLBDATA.nbookAmt = BANCS.OUTPARAM.nbookAmt
                EBSRV.GLBDATA.nappAmt = BANCS.OUTPARAM.nappAmt
                EBSRV.GLBDATA.nintRate = BANCS.OUTPARAM.nintRate
                EBSRV.GLBDATA.inintFreqTy = BANCS.OUTPARAM.inintFreqTy
                EBSRV.GLBDATA.nintFreqStD = BANCS.OUTPARAM.nintFreqStD
                EBSRV.GLBDATA.accrDtDr = BANCS.OUTPARAM.accrDtDr
                EBSRV.GLBDATA.bookDtDr = BANCS.OUTPARAM.bookDtDr
                EBSRV.GLBDATA.calcDtDr = BANCS.OUTPARAM.calcDtDr
                EBSRV.GLBDATA.nxtDtDr = BANCS.OUTPARAM.nxtDtDr
        else
                EBSRV.GLBDATA.naccrAmt = ""
                EBSRV.GLBDATA.nbookAmt = ""
                EBSRV.GLBDATA.nappAmt = ""
                EBSRV.GLBDATA.nintRate = ""
                EBSRV.GLBDATA.inintFreqTy = ""
                EBSRV.GLBDATA.nintFreqStD = ""
                EBSRV.GLBDATA.accrDtDr = ""
                EBSRV.GLBDATA.bookDtDr = ""
                EBSRV.GLBDATA.calcDtDr = ""
                EBSRV.GLBDATA.nxtDtDr = ""
        endif
        if(cdouble(EBSRV.GLBDATA.nintRate)<=0)then
                EBSRV.GLBDATA.nintRate = -1 * cdouble(EBSRV.GLBDATA.nintRate)
        endif
        if(EBSRV.GLBDATA.accrDtDr!="")then
                BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10)
                BANCS.INPARAM.date2 = EBSRV.GLBDATA.accrDtDr
                sv_u = urhk_B2K_dateDiff("")
                print(sv_u)
                if(sv_u == 0 ) then
                        EBSRV.GLBDATA.migdatediff = BANCS.OUTPARAM.dateDiff
                else
                        EBSRV.GLBDATA.migdatediff = "0"
                endif
        else
                EBSRV.GLBDATA.migdatediff = "1"
        endif
        print(EBSRV.GLBDATA.migdatediff)
        print(EBSRV.GLBDATA.nappAmt)
        print(EBSRV.GLBDATA.cClearBalance)

        if(cdouble(EBSRV.GLBDATA.cClearBalance)<0)then
                EBSRV.GLBDATA.cClearBalance = -1 *cdouble(EBSRV.GLBDATA.cClearBalance)
                print(EBSRV.GLBDATA.cClearBalance)
        endif
        if(cdouble(EBSRV.GLBDATA.migdatediff)<=0)then
                EBSRV.GLBDATA.migdatediff = -1 * cdouble(EBSRV.GLBDATA.migdatediff)
        endif
        if(cdouble(EBSRV.GLBDATA.migdatediff)!=cdouble("0"))then
        #{
                print(EBSRV.GLBDATA.cClearBalance)
                print(EBSRV.GLBDATA.nintRate)
                EBSRV.GLBDATA.upintAmt = (cdouble(EBSRV.GLBDATA.cClearBalance) * (cdouble(EBSRV.GLBDATA.nintRate)/100))/365
                print(EBSRV.GLBDATA.upintAmt)
                print(EBSRV.GLBDATA.naccrAmt)
                print(EBSRV.GLBDATA.nbookAmt)
                print(EBSRV.GLBDATA.nappAmt)
                if(cdouble(EBSRV.GLBDATA.nappAmt)>0)then
                        if(cdouble(EBSRV.GLBDATA.naccrAmt)>=cdouble(EBSRV.GLBDATA.nappAmt))then
                                EBSRV.GLBDATA.outstandingInt = cdouble(EBSRV.GLBDATA.naccrAmt) - cdouble(EBSRV.GLBDATA.nappAmt)
                                print(EBSRV.GLBDATA.outstandingInt)
                                EBSRV.GLBDATA.upintAmt = cdouble(EBSRV.GLBDATA.upintAmt) + cdouble(EBSRV.GLBDATA.outstandingInt)
                                print(EBSRV.GLBDATA.upintAmt)
                                EBSRV.GLBDATA.upintAmt = FORMAT$(cdouble(EBSRV.GLBDATA.upintAmt),"%.2f")
                                print(EBSRV.GLBDATA.upintAmt)
                        else
                                EBSRV.GLBDATA.outstandingInt = cdouble(EBSRV.GLBDATA.nappAmt) - cdouble(EBSRV.GLBDATA.naccrAmt)
                                print(EBSRV.GLBDATA.outstandingInt)
                                if(cdouble(EBSRV.GLBDATA.outstandingInt)<0)then
                                        EBSRV.GLBDATA.upintAmt = cdouble("0")
                                        print(EBSRV.GLBDATA.upintAmt)
                                else
                                        print(EBSRV.GLBDATA.upintAmt)
                                        print(EBSRV.GLBDATA.outstandingInt)
                                        EBSRV.GLBDATA.upintAmt = cdouble(EBSRV.GLBDATA.upintAmt) + cdouble(EBSRV.GLBDATA.outstandingInt)
                                        print(EBSRV.GLBDATA.upintAmt)
                                        EBSRV.GLBDATA.upintAmt = FORMAT$(cdouble(EBSRV.GLBDATA.upintAmt),"%.2f")
                                        print(EBSRV.GLBDATA.upintAmt)
                                endif
                        endif
                else
                        EBSRV.GLBDATA.upintAmt = cdouble(EBSRV.GLBDATA.naccrAmt) + cdouble(EBSRV.GLBDATA.upintAmt)
                        print(EBSRV.GLBDATA.upintAmt)
                        EBSRV.GLBDATA.upintAmt = FORMAT$(cdouble(EBSRV.GLBDATA.upintAmt),"%.2f")
                        print(EBSRV.GLBDATA.upintAmt)
                endif
        else
                print(EBSRV.GLBDATA.naccrAmt)
                print(EBSRV.GLBDATA.nbookAmt)
                print(EBSRV.GLBDATA.nappAmt)
                if(cdouble(EBSRV.GLBDATA.nappAmt)>0)then
                #{
                        if(cdouble(EBSRV.GLBDATA.naccrAmt)>=cdouble(EBSRV.GLBDATA.nappAmt))then
                        #{
                                EBSRV.GLBDATA.outstandingInt = cdouble(EBSRV.GLBDATA.naccrAmt) - cdouble(EBSRV.GLBDATA.nappAmt)
                                print(EBSRV.GLBDATA.outstandingInt)
                                EBSRV.GLBDATA.upintAmt = cdouble(EBSRV.GLBDATA.outstandingInt)
                                print(EBSRV.GLBDATA.upintAmt)
                                EBSRV.GLBDATA.upintAmt = FORMAT$(cdouble(EBSRV.GLBDATA.upintAmt),"%.2f")
                                print(EBSRV.GLBDATA.upintAmt)
                        else
                                  EBSRV.GLBDATA.outstandingInt = cdouble(EBSRV.GLBDATA.nappAmt) - cdouble(EBSRV.GLBDATA.naccrAmt)
                                print(EBSRV.GLBDATA.outstandingInt)
                                if(cdouble(EBSRV.GLBDATA.outstandingInt)<0)then
                                #{
                                        EBSRV.GLBDATA.upintAmt = cdouble("0")
                                        print(EBSRV.GLBDATA.upintAmt)
                                else
                                                EBSRV.GLBDATA.upintAmt = cdouble(EBSRV.GLBDATA.outstandingInt)
                                                print(EBSRV.GLBDATA.upintAmt)
                                                EBSRV.GLBDATA.upintAmt = FORMAT$(cdouble(EBSRV.GLBDATA.upintAmt),"%.2f")
                                                print(EBSRV.GLBDATA.upintAmt)
                                #}
                                endif
                        #}
                        endif
                else
                        print(EBSRV.GLBDATA.cClearBalance)
                        print(EBSRV.GLBDATA.nintRate)
                        EBSRV.GLBDATA.upintAmt = (cdouble(EBSRV.GLBDATA.cClearBalance) * (cdouble(EBSRV.GLBDATA.nintRate)/100))/365
                        print(EBSRV.GLBDATA.upintAmt)
                        print(EBSRV.GLBDATA.naccrAmt)
                        EBSRV.GLBDATA.upintAmt = cdouble(EBSRV.GLBDATA.naccrAmt)
                        print(EBSRV.GLBDATA.upintAmt)
                        EBSRV.GLBDATA.upintAmt = FORMAT$(cdouble(EBSRV.GLBDATA.upintAmt),"%.2f")
                        print(EBSRV.GLBDATA.upintAmt)
                #}
                endif
        #}
        endif
        if(cdouble(EBSRV.GLBDATA.upintAmt)<0)then
                EBSRV.GLBDATA.upintAmt = -1 * cdouble(EBSRV.GLBDATA.upintAmt)
                print(EBSRV.GLBDATA.upintAmt)
                EBSRV.GLBDATA.upintAmt = FORMAT$(cdouble(EBSRV.GLBDATA.upintAmt),"%.2f")
                print(EBSRV.GLBDATA.upintAmt)
        else
                print(EBSRV.GLBDATA.upintAmt)
        endif
        if(EBSRV.GLBDATA.OdAcctId=="")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid OD Loan Account")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        else
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.OdAcctId)
                if(sv_u!=0)then
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid OD Loan Account")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                else
                        EBSRV.GLBDATA.odSchmCode = BANCS.OUTPARAM.schmCode
                        EBSRV.GLBDATA.crCif  = BANCS.OUTPARAM.cifId
                        EBSRV.GLBDATA.EffBal = BANCS.OUTPARAM.EffAvailableAmt
                        EBSRV.GLBDATA.clearBalance = BANCS.OUTPARAM.clearBalance
                        EBSRV.GLBDATA.sanLim = BANCS.OUTPARAM.sanctionLimit
                        EBSRV.GLBDATA.drawingPower = BANCS.OUTPARAM.drawingPower
                        EBSRV.GLBDATA.avalAmt = BANCS.OUTPARAM.AvailableAmt
                        EBSRV.GLBDATA.acctClsFlg = BANCS.OUTPARAM.acctCloseflg
                        EBSRV.GLBDATA.odsolid = BANCS.OUTPARAM.acctSolId
                        EBSRV.GLBDATA.odacctCrncyCode = BANCS.OUTPARAM.acctCrncyCode

                        if(EBSRV.GLBDATA.odSchmCode!="ODFDR") THEN
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|Process Not allowed")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        endif
                        if(EBSRV.GLBDATA.acctClsFlg=="Y")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|OD Loan Account has been closed")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        endif
                        if(cdouble(EBSRV.GLBDATA.clearBalance)>=1)then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|OD Loan Account is in Credit")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        endif
                        print(EBSRV.GLBDATA.RepayMode)
                        EBSRV.GLBDATA.cclearBalance = -1 * cdouble(EBSRV.GLBDATA.clearBalance)
                        if(cdouble(EBSRV.GLBDATA.RepayAmount)>cdouble(EBSRV.GLBDATA.cclearBalance))then
                                print(EBSRV.GLBDATA.RepayAmount)
                                print(EBSRV.GLBDATA.cclearBalance)
                                print(EBSRV.GLBDATA.upintAmt)
                                if(EBSRV.GLBDATA.RepayMode=="F")then
                                        EBSRV.GLBDATA.totDue = cdouble(EBSRV.GLBDATA.cclearBalance) + cdouble(EBSRV.GLBDATA.upintAmt)
                                        print(EBSRV.GLBDATA.totDue)
                                endif
                                if(EBSRV.GLBDATA.RepayMode!="F")then
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("Message|Excess Repayment Amount")
                                        BANCS.OUTPUT.successOrFailure="F"
                                        exitscript
                                endif
                        endif
                endif
        endif
        if(EBSRV.GLBDATA.OrgOpAcctId!="")then
        #{
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.OrgOpAcctId)
                if(sv_u!=0)then
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid Operative Account")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                else
                        EBSRV.GLBDATA.orgdrCif  = BANCS.OUTPARAM.cifId
                        EBSRV.GLBDATA.orgopEffBal = BANCS.OUTPARAM.EffAvailableAmt
                        EBSRV.GLBDATA.orgopclearBalance = BANCS.OUTPARAM.clearBalance
                        EBSRV.GLBDATA.orgopsanLim = BANCS.OUTPARAM.sanctionLimit
                        EBSRV.GLBDATA.orgopdrawingPower = BANCS.OUTPARAM.drawingPower
                        EBSRV.GLBDATA.orgopavalAmt = BANCS.OUTPARAM.AvailableAmt
                        EBSRV.GLBDATA.orgopsolid = BANCS.OUTPARAM.acctSolId
                        EBSRV.GLBDATA.orgacctClsFlg = BANCS.OUTPARAM.acctCloseflg
                        EBSRV.GLBDATA.orgopcctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
                endif
                if(EBSRV.GLBDATA.orgacctClsFlg=="Y")then
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Operative Account has been closed")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                endif
                if(EBSRV.GLBDATA.OrgOpAcctId!=EBSRV.GLBDATA.OpAcctId)then
                        EBSRV.GLBDATA.isMultiPayYN = "Y"
                endif
                sv_q = urhk_B2k_ForacidToAcid(EBSRV.GLBDATA.OrgOpAcctId)
                if(sv_q==0)then
                        EBSRV.GLBDATA.orgopAcid = BANCS.OUTPARAM.Acid
                else
                        EBSRV.GLBDATA.orgopAcid = ""
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid Loan Account")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                endif
        #}
        endif
        if(EBSRV.GLBDATA.OpAcctId=="")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Operative Account")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        else
                sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.OpAcctId)
                if(sv_u!=0)then
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Invalid Operative Account")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                else
                        EBSRV.GLBDATA.drCif  = BANCS.OUTPARAM.cifId
                        EBSRV.GLBDATA.opEffBal = BANCS.OUTPARAM.EffAvailableAmt
                        EBSRV.GLBDATA.opclearBalance = BANCS.OUTPARAM.clearBalance
                        EBSRV.GLBDATA.opsanLim = BANCS.OUTPARAM.sanctionLimit
                        EBSRV.GLBDATA.opdrawingPower = BANCS.OUTPARAM.drawingPower
                        EBSRV.GLBDATA.opavalAmt = BANCS.OUTPARAM.AvailableAmt
                        EBSRV.GLBDATA.opsolid = BANCS.OUTPARAM.acctSolId
                        EBSRV.GLBDATA.acctClsFlg = BANCS.OUTPARAM.acctCloseflg
                        EBSRV.GLBDATA.opacctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
                endif
                if(EBSRV.GLBDATA.acctClsFlg=="Y")then
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                        sv_u = urhk_SetOrbOut("Message|Operative Account has been closed")
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                endif
                if(EBSRV.GLBDATA.RepayMode=="F")then
                        print(EBSRV.GLBDATA.RepayAmount)
                        print(EBSRV.GLBDATA.opclearBalance)
                        print(EBSRV.GLBDATA.opavalAmt)
                        print(EBSRV.GLBDATA.cclearBalance)
                        print(EBSRV.GLBDATA.upintAmt)
                        EBSRV.GLBDATA.totDue = cdouble(EBSRV.GLBDATA.cclearBalance) + cdouble(EBSRV.GLBDATA.upintAmt)
                        print(EBSRV.GLBDATA.totDue)
                        if(cdouble(EBSRV.GLBDATA.RepayAmount) > cdouble(EBSRV.GLBDATA.opavalAmt))then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|Full Payment Fails ,Insufficient Fund in Operative Account")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        endif
                        ##if(cdouble(EBSRV.GLBDATA.cclearBalance)>cdouble(EBSRV.GLBDATA.RepayAmount))then
                        if(cdouble(EBSRV.GLBDATA.totDue)>cdouble(EBSRV.GLBDATA.RepayAmount))then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|Full Payment Fails ,Enter Full Repaymnet Amount")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        endif
                        ##if(cdouble(EBSRV.GLBDATA.cclearBalance)<cdouble(EBSRV.GLBDATA.RepayAmount))then
                        if(cdouble(EBSRV.GLBDATA.totDue)<cdouble(EBSRV.GLBDATA.RepayAmount))then
                                print("excess in")
                                ##sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                ##sv_u = urhk_SetOrbOut("Message|Full Payment Fails , Excess Repaymnet Amount")
                                ##BANCS.OUTPUT.successOrFailure="F"
                                ##exitscript
                        endif
                        if(cdouble(EBSRV.GLBDATA.opclearBalance)<=0)then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|Full Payment Fails ,Insufficient Fund in Operative Account")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        endif
                endif
                if(EBSRV.GLBDATA.RepayMode=="P")then
                        print(EBSRV.GLBDATA.RepayAmount)
                        print(EBSRV.GLBDATA.opclearBalance)
                        print(EBSRV.GLBDATA.opavalAmt)
                        print(EBSRV.GLBDATA.cclearBalance)
                        print(EBSRV.GLBDATA.RepayMode)
                        if(cdouble(EBSRV.GLBDATA.RepayAmount)>cdouble(EBSRV.GLBDATA.opavalAmt))then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("Message|Payment Fails ,Insufficient Fund in Operative Account")
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        endif
                endif
        endif
        if(EBSRV.GLBDATA.crCif!=EBSRV.GLBDATA.drCif)then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|CifId Mismatch between OdLoan and Recovery Account")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        endif
        if(EBSRV.GLBDATA.AcctCloseYN=="")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|OD Loan Close Y Or N ")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        endif
        print(EBSRV.GLBDATA.OpAcctId)
        sv_q = urhk_B2k_ForacidToAcid(EBSRV.GLBDATA.OpAcctId)
        if(sv_q==0)then
                EBSRV.GLBDATA.opAcid = BANCS.OUTPARAM.Acid
                print(EBSRV.GLBDATA.opAcid)
        else
                EBSRV.GLBDATA.opAcid = ""
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Operative Account ")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        endif
        print(EBSRV.GLBDATA.OdAcctId)
        sv_q = urhk_B2k_ForacidToAcid(EBSRV.GLBDATA.OdAcctId)
        if(sv_q==0)then
                EBSRV.GLBDATA.odAcid = BANCS.OUTPARAM.Acid
        else
                EBSRV.GLBDATA.odAcid = ""
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Loan Account")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        endif
	if((cdouble(EBSRV.GLBDATA.RepayAmount) > cdouble(EBSRV.GLBDATA.cclearBalance)) and (cdouble(EBSRV.GLBDATA.cclearBalance)>0))then
		EBSRV.GLBDATA.RepayAmount = EBSRV.GLBDATA.cclearBalance
	endif
        if((EBSRV.GLBDATA.RepayMode=="F")or(EBSRV.GLBDATA.RepayMode=="P")) then
