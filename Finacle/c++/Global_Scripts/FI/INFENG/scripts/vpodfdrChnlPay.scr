                                EBSRV.GLBDATA.disbTranDate = BANCS.OUTPARAM.tranDate
                                print(EBSRV.GLBDATA.TranId)
                                print(EBSRV.GLBDATA.disbTranDate)
                        else
                                lv_j = urhk_dbSqlWithBind("rollback")
                                print(lv_j)
                                exitscript
                        endif
                endif

        if((EBSRV.GLBDATA.TranId!="")and((EBSRV.GLBDATA.RepayMode=="P")or(EBSRV.GLBDATA.RepayMode=="F")))then
        #{
