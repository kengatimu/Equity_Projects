                                        sv_u = urhk_SetOrbOut("Message|" + EBSRV.GLBDATA.srvMsg )
                                        BANCS.OUTPUT.successOrFailure="F"
                                        lv_j = urhk_dbSqlWithBind("rollback")
                                        print(lv_j)
                                        exitscript
                                endif
                        endif
                        if((BANCS.OUTPARAM.successOrFailure=="S") and (sv_u==0))then
                                print(BANCS.OUTPARAM.tranId)
                                print(BANCS.OUTPARAM.tranDate)
