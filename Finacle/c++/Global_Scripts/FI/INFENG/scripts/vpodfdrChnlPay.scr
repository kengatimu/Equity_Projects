                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+EBSRV.GLBDATA.tranAmt+"|"+ EBSRV.GLBDATA.opacctCrncyCode )
                else
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+EBSRV.GLBDATA.tranAmt+"|"+ BANCS.STDIN.homeCrncyCode )
                endif
