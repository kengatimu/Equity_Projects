                                                lv_i = urhk_dbSqlWithBind("commit")
                                        #}
                                        endif
                         #}
                        ENDIF
			###Lien Lift End

			lv_u = " update custom.odfdr_dmd_tbl set tot_adj_amt=dmd_amt,lchg_user_id=?SVAR,last_adj_date=to_date(?SVAR,'DD-MM-YYYY'),lchg_time=sysdate,host_machine_id=?SVAR,free_text_4=?SVAR,free_text_3='Full Payment Via Channel' where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and od_acid=?SVAR and flow_id in ('PRDEM','INDEM') and dmd_amt>0 "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + left$(BANCS.STDIN.BODDate,10) + "|" + EBSRV.GLBDATA.machineId + "|" + EBSRV.GLBDATA.TranId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.odAcid 
