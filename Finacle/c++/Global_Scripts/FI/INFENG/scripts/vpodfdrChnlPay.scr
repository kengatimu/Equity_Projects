                if(EBSRV.GLBDATA.RepayMode=="P")then
                        EBSRV.GLBDATA.drPart = "ODFDR payment for:" + EBSRV.GLBDATA.OdAcctId
                else
                        EBSRV.GLBDATA.drPart = "Payoff for:" + EBSRV.GLBDATA.OdAcctId
