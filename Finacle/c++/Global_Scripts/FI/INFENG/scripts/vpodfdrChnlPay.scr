                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+ EBSRV.GLBDATA.crPart )
                sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
                sv_o = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
                sv_u = urhk_ExecSrvNoCommit("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y")
                print(sv_u)
                if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
                       print(BANCS.OUTPARAM.successOrFailure)
                        if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
