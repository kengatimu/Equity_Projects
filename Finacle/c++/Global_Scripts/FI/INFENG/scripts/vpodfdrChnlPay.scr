                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+EBSRV.GLBDATA.tranAmt+"|"+ EBSRV.GLBDATA.odacctCrncyCode )
                else
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+ BANCS.STDIN.homeCrncyCode )
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+EBSRV.GLBDATA.tranAmt+"|"+ BANCS.STDIN.homeCrncyCode )
                endif
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+ EBSRV.GLBDATA.OdAcctId )
                sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
                if(EBSRV.GLBDATA.RepayMode=="P")then
