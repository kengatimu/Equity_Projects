			EQSRV.GLBDATA.autoRen = BANCS.OUTPARAM.autoRen
			EQSRV.GLBDATA.autoClose = BANCS.OUTPARAM.autoClose
			IF((EQSRV.GLBDATA.autoRen != "U") AND (EQSRV.GLBDATA.autoRen != "L") AND (EQSRV.GLBDATA.autoClose != "Y")) THEN
