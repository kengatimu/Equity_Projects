	#if(BANCS.STDIN.ScriptName=="SRV_OpenODAcct_pre_process_data.scr")then
	if(BANCS.STDIN.serviceName=="SRV_OpenODAcct")then
	#{
		if(cdouble(EQSRV.GLBDATA.odCnt)>=1)then
