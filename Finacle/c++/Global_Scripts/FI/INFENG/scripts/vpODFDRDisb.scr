#######Fetch TD collateral details
			sv_u=urhk_SetUrhkInp("entityId.foracid|"+EQSRV.GLBDATA.collAcct)
			PRINT(sv_u)
			sv_u=urhk_SetUrhkOut("entityId.foracid|Tdforacid")
			sv_u=urhk_SetUrhkOut("entityId.acid|acid")
