			PRINT(sv_a)
		
			sv_c = BANCS.OUTPARAM.successOrFailure
			print(sv_c)
		
			IF (sv_c != "S") THEN
			#{				
                                callscriptifexist("ebsrvHandler.scr")
                                if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
                                #{
                                        EQSRV.GLBDATA.srvMsg    = EQSRV.GLBDATA.SrvError
