			#EQSRV.GLBDATA.apportionedAmt = 1.11111 * cdouble(EQSRV.GLBDATA.sanctionLimit)
			#EQSRV.GLBDATA.apportionedAmt = FORMAT$(cdouble(EQSRV.GLBDATA.apportionedAmt),"%.2f")
			#print(EQSRV.GLBDATA.apportionedAmt)

			sv_u=urhk_SetUrhkInp("linkcollateralsDtls.linkcollateralsLL.<rec_0>.collateralCode.code|FDR")
