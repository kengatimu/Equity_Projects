		print(EQSRV.GLBDATA.odCnt)

		lv_p = "monthsIns|SELECT ceil(MONTHS_BETWEEN (TO_DATE(?SVAR,'DD-MM-YYYY'), TO_DATE(?SVAR,'DD-MM-YYYY')) ) FROM DUAL "
		BANCS.INPARAM.BINDVARS = mid$(EQSRV.GLBDATA.expiryDate,0,10) + "|" + mid$(BANCS.STDIN.BODDate,0,10)
