#ChargeOff Chk
	lv_m = "ChrgCnt| select count(*) from tbaadm.ta_cot where bank_id=?SVAR and acid in (select acid from tbaadm.gam where bank_id=?SVAR and cif_id=?SVAR and schm_code in ('OD542','OD543','OD544','OD545','OD546','ODFDR') and acct_cls_flg<>'Y' and acct_cls_date is null and entity_cre_flg='Y' and del_flg='N' ) and entity_cre_flg='Y' and del_flg='N' and chrge_off_principal-principal_recovery >0 "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.cifId 
	print(BANCS.INPARAM.BINDVARS)
	lv_c = urhk_dbSelectWithBind(lv_m)
	if(lv_c==0)then
	#{
		EQSRV.GLBDATA.ChrgCnt = BANCS.OUTPARAM.ChrgCnt
