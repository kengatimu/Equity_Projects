		lv_p = "autoRen,autoClose|SELECT AUTO_RENEWAL_FLG, CLOSE_ON_MATURITY_FLG FROM tbaadm.tam where acid=?SVAR and bank_id=?SVAR "
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.TDacid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		lv_p = urhk_dbSelectWithBind(lv_p)
		if(lv_p==0)then
