			sv_u=urhk_SetUrhkOut("depositAmt|depositAmt")
			sv_u=urhk_SetUrhkOut("balApprAmt|balApprAmt")
			
			sv_u = urhk_ExecSrvNoCommit("SRV_FetchLNColDetails|same_user_verify = Y|retain_all_output = Y|call_mode = N")
