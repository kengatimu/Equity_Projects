			#}
			ENDIF
#######End

#######Collateral Linkage
			sv_a= urhk_SetUrhkInp("linkColtrlCritDtls.loanAcct.foracid|"+EQSRV.GLBDATA.odAcctId)
 			sv_a= urhk_SetUrhkInp("linkColtrlCritDtls.loanAcct.crncyCode|"+EQSRV.GLBDATA.acctCrncyCode)

