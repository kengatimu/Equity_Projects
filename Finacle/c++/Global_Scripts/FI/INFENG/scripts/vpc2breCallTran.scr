#-------------------------------------------------------------------------------------------------------------
#    Name            : c2bre_file.scr
#    Description     : Bulk mpesa recon upload
#    Date            : 24-10-2022
#    Author          : SUNDAR
#    Input           : NA
#    Output          : NA
#    Calling Script  : NA
#    Menu Option     : C2BRE
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           24-oct-2022         SUNDAR              original Version         1.0
#  2           31-oct-2022         Irungu James        Correct Mispeling        1.1
#  3           31-oct-2022         Sundar         Validation of Mpesa ref        1.2
#-----------------------------------------------------------------------------------------------------------


IMPORT parse_xml
<--START
TRACE ON


        if(REPEXISTS("CUST")==0)THEN
        #{
                CREATEREP("CUST")
        #}
        endif

        if(CLASSEXISTS("CUST","DATA")==0)THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        endif

        #sv_x = urhk_B2k_PrintRepos("BANCS")
        #print(sv_x)

                CUST.DATA.ifilname = ""
                CUST.DATA.ibatchid =""
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                CUST.DATA.trSting = MTT.InputDetails.Argument1
                sv_l = strlen(CUST.DATA.trSting)
                sv_f = mid$(CUST.DATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.DATA.iRecNum  = mid$(sv_f,0,(sv_p-1))
                #--
                CUST.DATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(CUST.DATA.trSting)
                sv_f = mid$(CUST.DATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.DATA.iPaidIn  = mid$(sv_f,0,(sv_p-1))
                #--
                CUST.DATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(CUST.DATA.trSting)
                sv_f = mid$(CUST.DATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.DATA.iAcctNum  = mid$(sv_f,0,(sv_p-1))
                #--
                CUST.DATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(CUST.DATA.trSting)
                sv_f = mid$(CUST.DATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.DATA.iGlid  = mid$(sv_f,0,(sv_p-1))
                #--
                CUST.DATA.trSting = mid$(sv_f,sv_p,sv_l)
                sv_l = strlen(CUST.DATA.trSting)
                sv_f = mid$(CUST.DATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.DATA.ifilname  = mid$(sv_f,0,(sv_p-1))
                CUST.DATA.ibatchid = mid$(sv_f,sv_p,sv_l)
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                print("process failed")
                CUST.DATA.ifilname = ""
        endif
        if(CUST.DATA.ifilname=="")then
                exitscript
        endif


        sv_f="TeacesOutBound.txt"
        CUST.DATA.processed ="N"
        CUST.DATA.IsValAcc ="N"
        CUST.DATA.Status = " "
        CUST.DATA.tranId = ""
        CUST.DATA.MobileNo = ""
        CUST.DATA.mobileNumber = ""
        CUST.DATA.NOTIFICATIONPHONENUMBER = ""

                CUST.DATA.ResmpesaAccountReference = ""
                CUST.DATA.accountNumber = ""
                CUST.DATA.ACCOUNTNUMBER = ""
                CUST.DATA.ResXml = ""
                 sv_e = urhk_B2k_PID("")
                if(sv_e==0)then
                #{
                print(BANCS.OUTPARAM.PID)
                        CUST.DATA.randId = BANCS.OUTPARAM.PID
                else
                        CUST.DATA.randId = "1234567890"
                #}
                endif
        CUST.DATA.XMLReportFile =  CUST.DATA.randId+"_Req_Res.Txt"
        sv_t=system("echo ReqRes  > "+CUST.DATA.XMLReportFile)
        print(sv_t)

        CUST.DATA.ReportFile = CUST.DATA.ifilname+"_Upload_Report.TXT"

                Print (CUST.DATA.ifilname)
                Print (CUST.DATA.ReportFile)



        CUST.DATA.BODDate =  mid$(BANCS.STDIN.BODDate,0,10)
        sv_z = urhk_dbSelectWithBind("TimeStamp|select to_char(sysdate,'hh24miss') from dual ")
        CUST.DATA.TimeStamp                =       BANCS.OUTPARAM.TimeStamp

	sv_z = urhk_B2k_ForacidToAcid(CUST.DATA.iGlid)
	print(sv_z)
	IF(sv_z == 0)THEN
		 CUST.DATA.GLacid = BANCS.OUTPARAM.Acid
	ELSE
		CUST.DATA.message = "Invalid GL"
		GOTO NEXTREC
	ENDIF

	sv_a = " TransactionStatus,Details,RECEIPTNO,Paidin,Balance,resontype,otherpartyinfo,linkedtransactionID,acctnum,GL,date, VDATE,HTD  "
	sv_a =sv_a+"|select nvl(Transaction_Status,'NA'),"
	sv_a =sv_a+" nvl(Details,'NA'),"
	sv_a =sv_a+" nvl(RECEIPT_NO,'NA'),"
	sv_a =sv_a+" nvl(Paid_in,'NA'),"
	sv_a =sv_a+" nvl(Balance,'0'),"
	sv_a =sv_a+" nvl(reson_type,'NA'),"
	sv_a =sv_a+" nvl(other_party_info,'NA'),"
	sv_a =sv_a+" nvl(linked_transaction_ID,'NA'),"
	sv_a =sv_a+" nvl(acct_num,'NA'),"
	sv_a =sv_a+" nvl(GL,'NA') ,"
	sv_a =sv_a+" to_date(completion_time,'DD/MM/YYYY HH24:MI:SS'),"
	sv_a =sv_a+" to_char(to_date(substr (COMPLETION_TIME,0,10),'dd-MM-yyyy'),'DD-MON-YYYY') VDATE, "
	sv_a =sv_a+" case when to_date(completion_time,'dd-mm-yyyy hh24:mi:ss') < min_date then 'Y' ELSE 'N' END HTD "
	sv_a =sv_a+" from custom.CUST_MPESA_RECON_TBL "
	sv_a =sv_a+" where bank_id=?SVAR and processed =?SVAR and  FILE_NAME =?SVAR  "
	sv_a = sv_a + " and RECEIPT_NO=?SVAR and Paid_in=?SVAR and acct_num=?SVAR and GL=?SVAR and upl_batch_id=?SVAR"
	PRINT(sv_a)
	BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId  + "|" + CUST.DATA.processed + "|" + CUST.DATA.ifilname  +"|"+ CUST.DATA.iRecNum + "|" + CUST.DATA.iPaidIn + "|" + CUST.DATA.iAcctNum + "|" + CUST.DATA.iGlid + "|" + CUST.DATA.ibatchid
	print(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbSelectWithBind(sv_a)
	print(sv_c)
	if(sv_c == 0)then
	
		CUST.DATA.IsValAcc = "N"
		CUST.DATA.tranId = ""
		CUST.DATA.Sender = ""
		CUST.DATA.accountNumber = ""
		CUST.DATA.ACCOUNTNUMBER = ""
		CUST.DATA.AccountNo = ""
		CUST.DATA.NOTIFICATIONPHONENUMBER =""
		CUST.DATA.ResmpesaAccountReference = ""
		CUST.DATA.MobileNo = ""
		CUST.DATA.mobileNumber = ""
		CUST.DATA.acctnum= ""

		CUST.DATA.RECEIPTNO = BANCS.OUTPARAM.RECEIPTNO
		CUST.DATA.Details = BANCS.OUTPARAM.Details
		CUST.DATA.TransactionStatus = BANCS.OUTPARAM.TransactionStatus
		CUST.DATA.Paidin = BANCS.OUTPARAM.Paidin
		CUST.DATA.Balance = BANCS.OUTPARAM.Balance
		CUST.DATA.resontype = BANCS.OUTPARAM.resontype
		CUST.DATA.otherpartyinfo = BANCS.OUTPARAM.otherpartyinfo
		CUST.DATA.linkedtransactionID = BANCS.OUTPARAM.linkedtransactionID
		CUST.DATA.acctnum = BANCS.OUTPARAM.acctnum
		CUST.DATA.GL = BANCS.OUTPARAM.GL
		CUST.DATA.date = BANCS.OUTPARAM.date
		CUST.DATA.HTD = BANCS.OUTPARAM.HTD
		CUST.DATA.VDATE = BANCS.OUTPARAM.VDATE

		print(CUST.DATA.TransactionStatus)
		print(CUST.DATA.RECEIPTNO)
		print(CUST.DATA.Paidin)
		print(CUST.DATA.Balance)
		print(CUST.DATA.otherpartyinfo)
		print(CUST.DATA.linkedtransactionID)
		print(CUST.DATA.acctnum)
		print(CUST.DATA.resontype)
		print(CUST.DATA.GL)
		print(CUST.DATA.Details)
		print (CUST.DATA.HTD)
		print (CUST.DATA.VDATE)

		lv_a= GETPOSITION(CUST.DATA.Details,"-")
		lv_b = GETPOSITION(CUST.DATA.Details,"Acc.")
		lv_c =lv_b-lv_a

		CUST.DATA.Sender=mid$(CUST.DATA.Details,lv_a,lv_c-1)
		CUST.DATA.Sender=TRIM(CUST.DATA.Sender)
		print(CUST.DATA.Sender)

		lv_a= GETPOSITION(CUST.DATA.otherpartyinfo,"-")

		CUST.DATA.ReqMbl=mid$(CUST.DATA.otherpartyinfo,0,lv_a-1)
		CUST.DATA.ReqMbl=TRIM(CUST.DATA.ReqMbl)
		print(CUST.DATA.ReqMbl)

		CUST.DATA.DrAccountNo = CUST.DATA.GL
		CUST.DATA.IsFound = "N"
		CUST.DATA.Status = "Customer Account Not Found"
		CUST.DATA.MobileNo = ""


		IF (CUST.DATA.HTD == "N") THEN
			sv_a ="count|select count(*) from tbaadm.dtd where "
			sv_a = sv_a+ " acid = ?SVAR "
			sv_a = sv_a+ " and TRAN_PARTICULAR_2 = ?SVAR  and bank_id=?SVAR "
			print(sv_a)
			BANCS.INPARAM.BINDVARS=CUST.DATA.GLacid+"|"+CUST.DATA.RECEIPTNO+"|"+BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_b = urhk_dbSelectWithBind(sv_a)
			Print(sv_b)
			IF(sv_b==0) Then
				CUST.DATA.count               = BANCS.OUTPARAM.count
				IF(CUST.DATA.count>0)THEN
					CUST.DATA.IsFound = "Y"
				ENDIF
			ENDIF
		ELSE
			sv_a ="count|select count(*) from tbaadm.htd where "
			sv_a = sv_a+ " acid= ?SVAR "
			sv_a = sv_a+ " and TRAN_PARTICULAR_2 = ?SVAR and VALUE_DATE =?SVAR  "
			sv_a = sv_a+ "  and bank_id=?SVAR "
			print(sv_a)
			BANCS.INPARAM.BINDVARS=CUST.DATA.GLacid+"|"+CUST.DATA.RECEIPTNO+"|"+CUST.DATA.VDATE+"|"+BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_b = urhk_dbSelectWithBind(sv_a)
			Print(sv_b)
			IF(sv_b==0) Then
				CUST.DATA.count               = BANCS.OUTPARAM.count
				IF(CUST.DATA.count>0)THEN
					CUST.DATA.IsFound = "Y"
				ENDIF
			ENDIF
		ENDIF

		IF(CUST.DATA.IsFound =="Y")THEN
			CUST.DATA.Status = "Transaction Found in Finacle"
			GOTO NEXTREC
		ENDIF  

		CUST.DATA.ResmpesaAccountReference =  CUST.DATA.acctnum
		CUST.DATA.ResAmount = CUST.DATA.Paidin
		CUST.DATA.NOTIFICATIONPHONENUMBER = CUST.DATA.ReqMbl

		sv_o = STRLEN(TRIM(CUST.DATA.ResmpesaAccountReference))
		Print (sv_o)
		IF ((sv_o == 13) or (sv_o == 15)) THEN
			sv_a = urhk_valAcctNumber(CUST.DATA.ResmpesaAccountReference)
			IF(sv_a==0)THEN
				CUST.DATA.IsValAcc = "Y"
				CUST.DATA.ACCOUNTNUMBER = CUST.DATA.ResmpesaAccountReference			
			ENDIF
		ENDIF

		sv_o = STRLEN(TRIM(CUST.DATA.ResmpesaAccountReference))
		IF ((sv_o == 9) or (sv_o < 9))THEN
			IF(CUST.DATA.IsValAcc=="N")THEN
				CUST.DATA.ResponseFile = ""
				#CUST.DATA.FilePath     = "/finacle/EQPPROD/Fin10218/APP/Finacle/FC/app/MPESA/C2BRePhNum.jar" #ShortCode
				#CUST.DATA.URL  = "https://10.11.6.111:8087/mpesa/api/RegisterMpesaPayBill"

				CUST.DATA.FilePath     = "/finacle/EQPRODFI/BackEnd/Finacle/FC/app/MPESA/C2BRePhNum.jar"
				CUST.DATA.URL  = "http://10.11.15.63:2020/mpesa/api/RegisterMpesaPayBill"

				CUST.DATA.InputField   =  ""
				CUST.DATA.InputField   =  CUST.DATA.InputField + CUST.DATA.ResmpesaAccountReference + "  "
				CUST.DATA.InputField   =  CUST.DATA.InputField + CUST.DATA.URL
				print(CUST.DATA.InputField)
				sv_t=CUST.DATA.FilePath + "  "+ CUST.DATA.InputField
				print(sv_t)

				CUST.DATA.source = "C2BRe.com"
				CUST.DATA.ResXml= ""
				lv_u = urhk_getFileLocation("COM|"+CUST.DATA.source)
				
				IF (lv_u != 0) THEN
					CUST.DATA.message = "Cannot get COM file location.Please Clear before next operation"
					GOTO NEXTREC
				ELSE
					CUST.DATA.fileLocation = BANCS.OUTPARAM.fileLocation
					PRINT(CUST.DATA.fileLocation)
					lv_f = CUST.DATA.fileLocation + CUST.DATA.source
					PRINT(lv_f)

					lv_u = UREX(lv_f, "tmpFile.dat" ,sv_t)
					PRINT(lv_u)
					IF(lv_u != 0)THEN
						CUST.DATA.message = "COM Failed.Please Clear before next operation"
						GOTO NEXTREC
					ENDIF
					
					print(CUST.DATA.ResXml)
					CUST.DATA.filed = "accountNumber"
					lv_a = func_xmlParseFunc("CUST","DATA",CUST.DATA.filed,CUST.DATA.ResXml)
					print(lv_a)
					
					if(lv_a==0)then
						CUST.DATA.accountNumber = TRIM(CUST.DATA.accountNumber)
						print(CUST.DATA.accountNumber)
						sv_a = urhk_valAcctNumber(CUST.DATA.accountNumber)
						
						IF(sv_a==0)THEN
							CUST.DATA.IsValAcc = "Y"
							CUST.DATA.ACCOUNTNUMBER = CUST.DATA.accountNumber
						ENDIF
						
						CUST.DATA.filed = "mobileNumber"
						lv_a = func_xmlParseFunc("CUST","DATA",CUST.DATA.filed,CUST.DATA.ResXml)
						print(lv_a)
						CUST.DATA.MobileNo = CUST.DATA.mobileNumber
						CUST.DATA.NOTIFICATIONPHONENUMBER = CUST.DATA.mobileNumber
					else

						CUST.DATA.filed = "Status"
						lv_a = func_xmlParseFunc("CUST","DATA",CUST.DATA.filed,CUST.DATA.ResXml)
						IF(lv_a==0)THEN
							print(CUST.DATA.Status)
						ENDIF
					endif
				ENDIF

			ENDIF
		ENDIF

		sv_o = STRLEN(TRIM(CUST.DATA.ResmpesaAccountReference))
		IF(CUST.DATA.IsValAcc=="N")THEN
			IF((sv_o == "12") or (sv_o == "10"))THEN
				CUST.DATA.ResponseFile = ""
				#CUST.DATA.FilePath     = "/finacle/EQPPROD/Fin10218/APP/Finacle/FC/app/MPESA/C2BRe.jar" #Phone Number
				#CUST.DATA.URL  = "http://10.11.6.59:7007/mfmbsug/mbintf/CustomerEnquiry.jsp"

				CUST.DATA.FilePath     = "/finacle/EQPRODFI/BackEnd/Finacle/FC/app/MPESA/C2BRe.jar"
				CUST.DATA.URL  = "http://modefinprod-7004.ebsafrica.com:7004/mfmbs/mbintf/CustomerEnquiry.jsp"

				CUST.DATA.InputField   =  ""
				CUST.DATA.InputField   =  CUST.DATA.InputField + CUST.DATA.ResmpesaAccountReference + "  "
				CUST.DATA.InputField   =  CUST.DATA.InputField + CUST.DATA.URL
				print(CUST.DATA.InputField)
				sv_t=CUST.DATA.FilePath + "  "+ CUST.DATA.InputField
				print(sv_t)

				CUST.DATA.source = "C2BRe.com"
				CUST.DATA.ResXml= ""
				lv_u = urhk_getFileLocation("COM|"+CUST.DATA.source)
				
				IF (lv_u != 0) THEN
					CUST.DATA.message = "Cannot get COM file location.Please Clear before next operation"
					GOTO NEXTREC
				ELSE
					CUST.DATA.fileLocation = BANCS.OUTPARAM.fileLocation
					PRINT(CUST.DATA.fileLocation)
					lv_f = CUST.DATA.fileLocation + CUST.DATA.source
					PRINT(lv_f)
					lv_u = UREX(lv_f, "tmpFile.dat" ,sv_t)
					PRINT(lv_u)
					
					IF(lv_u != 0)THEN
						CUST.DATA.message = "COM Failed.Please Clear before next operation"
						GOTO NEXTREC
					ENDIF
					
					print(CUST.DATA.ResXml)
					CUST.DATA.responseCode = ""
					CUST.DATA.filed = "ACCOUNTNUMBER"
					lv_a = func_xmlParseFunc("CUST","DATA",CUST.DATA.filed,CUST.DATA.ResXml)
					print(lv_a)
					if(lv_a==0)then
						CUST.DATA.accountNumber = TRIM(CUST.DATA.ACCOUNTNUMBER)
						CUST.DATA.ACCOUNTNUMBER = TRIM(CUST.DATA.accountNumber)
						print(CUST.DATA.accountNumber)
						sv_a = urhk_valAcctNumber(CUST.DATA.accountNumber)
						IF(sv_a==0)THEN
						#{
							CUST.DATA.IsValAcc = "Y"
							CUST.DATA.MobileNo = CUST.DATA.acctnum
						#}
						ENDIF
					else
						CUST.DATA.filed = "Status"
						lv_a = func_xmlParseFunc("CUST","DATA",CUST.DATA.filed,CUST.DATA.ResXml)
						IF(lv_a==0)THEN
							print(CUST.DATA.Status)
						ENDIF
					endif
				ENDIF
			ENDIF
		ENDIF

		IF(CUST.DATA.IsValAcc=="Y")THEN
			CUST.DATA.AccountNo = CUST.DATA.ACCOUNTNUMBER
			sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.DrAccountNo)
			if(sv_u==0)then
				CUST.DATA.DName = BANCS.OUTPARAM.acctName
			ENDIF
			sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.AccountNo)
			if(sv_u==0)then
				CUST.DATA.CName = BANCS.OUTPARAM.acctName
			ENDIF
			IF(CUST.DATA.NOTIFICATIONPHONENUMBER=="")THEN
				sv_z = "phoneno|select p.phoneno from CRMUSER.PHONEEMAIL p, tbaadm.gam g where p.bank_id = ?SVAR and g.bank_id=?SVAR  and p.orgkey=g.cif_id "
				sv_z = sv_z+ " and p.preferredflag='Y' and  g.foracid= ?SVAR and rownum<=1 "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.AccountNo
				print(sv_z)
				sv_d = urhk_dbselectWithBind(sv_z)
				PRINT(sv_d)
				IF(sv_d==0)THEN
					CUST.DATA.NOTIFICATIONPHONENUMBER = BANCS.OUTPARAM.phoneno
					Print(CUST.DATA.NOTIFICATIONPHONENUMBER)
					CUST.DATA.NOTIFICATIONPHONENUMBER  = CUST.DATA.NOTIFICATIONPHONENUMBER
				ELSE
						CUST.DATA.MobileNo  ="0000000"
				ENDIF
			#}
			ENDIF

			CUST.DATA.Amount = TRIM(CUST.DATA.ResAmount)
			CUST.DATA.AccountNo = CUST.DATA.ACCOUNTNUMBER
			CUST.DATA.MobileNo = CUST.DATA.NOTIFICATIONPHONENUMBER
			call("c2bre_autopost_mtt.scr")
			GOTO NEXTREC
		ENDIF
NEXTREC:
		CUST.DATA.Posted = ""
		CUST.DATA.Manual_Posted = ""
		CUST.DATA.Linked_tran_id = "NA"
		IF(CUST.DATA.tranId!="")THEN
			CUST.DATA.Linked_tran_id="Acc."+CUST.DATA.AccountNo+"-TranId,"+CUST.DATA.tranId
			sv_t=system("echo  Account Number :'"+CUST.DATA.acctnum+"' ,Receipt No :'"+CUST.DATA.RECEIPTNO+"' ,Tran Id :'"+CUST.DATA.tranId+"' >> "+CUST.DATA.ReportFile)
			sv_t=system("echo  '"+CUST.DATA.acctnum+"': '"+CUST.DATA.ResXml+"' >> "+CUST.DATA.XMLReportFile)
			CUST.DATA.Posted = "Y"
			CUST.DATA.Manual_Posted = "N"
			#-------------------------------------------------------------------------------
			#Send Notification to Customer
			#-------------------------------------------------------------------------------
			IF(REPEXISTS("CUST") == 0 ) THEN
				CREATEREP("CUST")
			ENDIF
			IF (CLASSEXISTS("CUST","ALERTS") == 0) THEN
			    CREATECLASS("CUST","ALERTS",5)
			ENDIF
			CUST.ALERTS.CName = CUST.DATA.CName
			CUST.ALERTS.DName = CUST.DATA.DName

			CUST.ALERTS.phoneno  = CUST.DATA.NOTIFICATIONPHONENUMBER
			Print(CUST.DATA.MobileNo)

			CUST.ALERTS.trandate = mid$(BANCS.STDIN.BODDate,0,10)
			CUST.ALERTS.massage  = "Dear Customer, Your transaction of Kshs. "+ CUST.DATA.Amount + " has successfully been Deposited in Favour of  " + CUST.ALERTS.CName + " Ref. Number " + CUST.DATA.RECEIPTNO  + ". Thank you."
			#Print (CUST.ALERTS.massage )
			CALL("smspushothers.scr")

		ELSE
			CUST.DATA.Linked_tran_id = CUST.DATA.Status
			sv_t=system("echo  Account Number :'"+CUST.DATA.acctnum+"' ,Receipt No :'"+CUST.DATA.RECEIPTNO+"' , Status :'"+CUST.DATA.Status+"' >> "+CUST.DATA.ReportFile)
			sv_t=system("echo  '"+CUST.DATA.acctnum+"': '"+CUST.DATA.ResXml+"' >> "+CUST.DATA.XMLReportFile)
			CUST.DATA.Posted = "N"
			CUST.DATA.Manual_Posted = "N"
		ENDIF
		
		BANCS.INPARAM.BINDVARS = "Y|"+CUST.DATA.Posted+"|"+CUST.DATA.Linked_tran_id+"|"+CUST.DATA.acctnum+"|"+CUST.DATA.RECEIPTNO+"|N|N|" + CUST.DATA.ibatchid
		sv_s = "UPDATE CUSTOM.CUST_MPESA_RECON_TBL SET PROCESSED=?SVAR,POSTED=?SVAR,LINKED_TRANSACTION_ID=?SVAR , LCHG_TIME =sysdate WHERE ACCT_NUM=?SVAR and RECEIPT_NO = ?SVAR AND DEL_FLG=?SVAR AND PROCESSED=?SVAR and upl_batch_id=?SVAR"
		PRINT(sv_s)
		sv_d = urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d==0)THEN
			sv_d = urhk_dbSqlWithBind("COMMIT")
		ENDIF
	ENDIF

ENDOFSCRIPT:
exitscript
#TRACE OFF
END-->
