<--start
trace on

###########################################################################################
# Check whether CUST Repository exists else create it
###########################################################################################

sv_r = REPEXISTS("CUST")

IF(sv_r == 0) THEN
#{
        CREATEREP ("CUST")
#}
ENDIF

###########################################################################################
# Check whether CIETXN Class exists else create it
###########################################################################################

sv_r = CLASSEXISTS("CUST","DATA")

IF(sv_r == 0) THEN
#{
        CREATECLASS ("CUST","DATA",5)
#}
ENDIF

sv_f = CLASSEXISTS("CUST","CIETXN")

IF(sv_f == 0) THEN
#{
        CREATECLASS ("CUST","CIETXN",5)
#}
ENDIF

sv_f = CLASSEXISTS("CUST","ATM")

IF(sv_f == 0) THEN
#{
        CREATECLASS ("CUST","ATM",5)
#}
ENDIF

IF(BANCS.STDIN.moduleIdentity == "CDCI") THEN
#{

CUST.CIETXN.AcctID = CUST.ATM.AcctID
CUST.CIETXN.refAmt = CUST.ATM.tranamt

#}
ENDIF


sv_s = "RequestID1|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0)THEN
#{
        CUST.CIETXN.RequestID1 = BANCS.OUTPARAM.RequestID1
        print(CUST.CIETXN.RequestID1)
#}
ELSE
#{
        CUST.CIETXN.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2)+ MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)

        print(CUST.CIETXN.RequestID1)
#}
ENDIF

CUST.DATA.RequestID1=CUST.CIETXN.RequestID1

#-------------------------------------------------------------------------
# Fetch the current data time to send in request header
#-------------------------------------------------------------------------
sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
        CUST.DATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
        print(CUST.DATA.msgDateTime)
#}
ENDIF

#-------------------------------------------------------------------------
#- Forming the Header for XferTrnAdd
#-------------------------------------------------------------------------
CUST.DATA.headerXML = ""
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Header>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestHeader>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<MessageKey>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestUUID>"+ CUST.DATA.RequestID1 +"</RequestUUID>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ServiceRequestId>BalInq</ServiceRequestId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ChannelId>COR</ChannelId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<LanguageId></LanguageId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</MessageKey>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RequestMessageInfo>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<BankId>" + CUST.CIETXN.BankID + "</BankId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<TimeZone></TimeZone>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<EntityId></EntityId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<EntityType></EntityType>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<ArmCorrelationId></ArmCorrelationId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<MessageDateTime>" + CUST.DATA.msgDateTime + "</MessageDateTime>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</RequestMessageInfo>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Security>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Token>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<PasswordToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<UserId></UserId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<Password></Password>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</PasswordToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</Token>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<FICertToken></FICertToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUserLoginSessionId></RealUserLoginSessionId>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUser></RealUser>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<RealUserPwd></RealUserPwd>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "<SSOTransferToken></SSOTransferToken>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</Security>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</RequestHeader>"
CUST.DATA.headerXML = CUST.DATA.headerXML + "</Header>"


#-------------------------------------------------------------------------
#- Forming the Body for XferTrnAdd
#-------------------------------------------------------------------------
CUST.DATA.bodyXMLMsg = ""
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<body><BalInqRequest>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<BalInqRq>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "<AcctId>" + CUST.CIETXN.AcctID + "</AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</AcctId>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</BalInqRq>"
CUST.DATA.bodyXMLMsg = CUST.DATA.bodyXMLMsg + "</BalInqRequest></body>"

print(CUST.DATA.bodyXMLMsg)

#-------------------------------------------------------------------------
#Appending the header XML and body XML.
#-------------------------------------------------------------------------
CUST.DATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + "<FIXML>"
CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + CUST.DATA.headerXML
CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + CUST.DATA.bodyXMLMsg
CUST.DATA.reqXMLMsg = CUST.DATA.reqXMLMsg + "</FIXML>"

#-------------------------------------------------------------------------------
# Setting input values for urhk_ConnectToFIAndSendMsg userhook
#-------------------------------------------------------------------------------
BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
BANCS.INPARAM.SEND_RECV_FLG             = "R"
sv_a = CUST.DATA.reqXMLMsg
PRINT(sv_a)

#-------------------------------------------------------------------------
#- Executing the userhook to make the Outbound Call
#-------------------------------------------------------------------------
sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
print(sv_l)
IF (sv_l != 0) THEN
#{
        print(BANCS.OUTPARAM.ErrMsg)
        CUST.DATA.errorMsgFlg = "Y"
        CUST.DATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
        CUST.DATA.errorMsgCode = "FIERR"
        GOTO ENDOFSCRIPT
#}
ENDIF
IF (BANCS.OUTPARAM.ErrMsg != "") THEN
#{
        CUST.DATA.errorMsgFlg = "Y"
        CUST.DATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
        CUST.DATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
        CUST.DATA.errorMsgCode = "FIERR"
        GOTO ENDOFSCRIPT
#}
ELSE
#{
        CUST.DATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
        print(CUST.DATA.respXMLMsg)
        CUST.DATA.errorMsgFlg = ""
        CUST.DATA.errorMsgDesc = ""
#}
ENDIF

CUST.DATA.Status = ""
CUST.DATA.tranId = ""
CUST.DATA.errorCode = ""
CUST.DATA.errorDesc = ""
sv_x = CUST.DATA.respXMLMsg

                        sv_x = CUST.DATA.respXMLMsg
                        sv_y = "<Status>"
                        sv_z = "</Status>"
                        sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                        sv_e = GETPOSITION(sv_x, sv_z) - 1

                        IF (GETPOSITION(sv_x, sv_y) != 0) THEN
                        #{
                                CUST.DATA.Status = MID$(sv_x, sv_b, (sv_e - sv_b))
                        #}
                        ELSE
                        #{
                                CUST.DATA.Status = ""
                        #}
                        ENDIF
                        PRINT(CUST.DATA.Status)

IF(CUST.DATA.Status == "SUCCESS") THEN
#{
                                                sv_l = STRLEN(CUST.DATA.respXMLMsg)
						print(sv_l)
                                                sv_p = CUST.DATA.respXMLMsg
                                                sv_t = 0
						sv_v = "50"
sv_x = CUST.DATA.respXMLMsg
sv_y = "<BalType>"
sv_z = "</BalType>"


while(sv_v > sv_t)
#{

sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
print(sv_b)
sv_e = GETPOSITION(sv_x, sv_z) - 1
print(sv_e)

IF (GETPOSITION(sv_x, sv_y) != 0) THEN
#{
        CUST.DATA.BalType = MID$(sv_x, sv_b, (sv_e - sv_b))
	print(CUST.DATA.BalType)

        IF(CUST.DATA.BalType == "EFFAVL") THEN
        #{
                print(CUST.DATA.BalType)
		CUST.DATA.BalCat = CUST.DATA.BalType

		sv_x = RIGHT$(sv_x, STRLEN(sv_x) - sv_e - 1)
                sv_r = "<amountValue>"
                sv_o = "</amountValue>"
                sv_k = GETPOSITION(sv_x, sv_r) + STRLEN(sv_r) - 1
		print(sv_k)
                sv_j = GETPOSITION(sv_x, sv_o) - 1
		print(sv_j)

                IF(GETPOSITION(sv_x, sv_r) != 0) THEN
                #{
                        CUST.DATA.amountValue =  MID$(sv_x, sv_k, (sv_j - sv_k))
                        print(CUST.DATA.amountValue)
			sv_t=50
                #}
                ENDIF


        #}
        ENDIF

sv_x = RIGHT$(sv_x, STRLEN(sv_x) - sv_e - 1)

#}
ENDIF
sv_t = sv_t + 1
print(sv_t)

#}
do


print(CUST.DATA.amountValue)
print(CUST.CIETXN.refAmt)


IF(BANCS.STDIN.moduleIdentity == "CDCI") THEN
#{
CUST.ATM.BalType = CUST.DATA.BalType
CUST.ATM.amountValue = CUST.DATA.amountValue

#}
ENDIF


#}
ELSE
#{
        IF(CUST.DATA.Status == "FAILED") THEN
        #{
                sv_x = CUST.DATA.respXMLMsg
                sv_y = "<ErrorCode>"
                sv_z = "</ErrorCode>"
                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                sv_e = GETPOSITION(sv_x, sv_z) - 1
                IF (GETPOSITION(sv_x, sv_y) != 0) THEN
                #{
                        CUST.DATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
                #}
                ENDIF
                sv_x = CUST.DATA.respXMLMsg
                sv_y = "<ErrorDesc>"
                sv_z = "</ErrorDesc>"
                sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
                sv_e = GETPOSITION(sv_x, sv_z) - 1
                IF (GETPOSITION(sv_x, sv_y) != 0) THEN
                #{
                        CUST.DATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
                #}
                ENDIF
        #}
        ENDIF

	print("Failed Response")
	CUST.ATM.scriptSuccess = "N"
	CUST.CIETXN.scriptSuccess = "N"
	print(CUST.DATA.errorDesc)
        sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errorDesc)

#}
ENDIF


