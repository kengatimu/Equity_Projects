#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName       : LoanDetailsInq.scr
#Date           : 13/02/2024
#Author         : Dennis Chirchir
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif

        EQSRV.GLBDATA.upintAmt = "0"
        EQSRV.GLBDATA.totDue = "0"
        EQSRV.GLBDATA.nappAmt = "0"
        EQSRV.GLBDATA.naccrAmt = "0"
        EQSRV.GLBDATA.outstandingInt = "0"
                EQSRV.GLBDATA.dmdFlowId = " "
                EQSRV.GLBDATA.dmdDate = " "
                EQSRV.GLBDATA.schdlNum = " "
                EQSRV.GLBDATA.dOverDueDate = " "
                EQSRV.GLBDATA.dmdAmt = " "
                EQSRV.GLBDATA.lastAdjDate = " "
                EQSRV.GLBDATA.adjAmt = " "
                EQSRV.GLBDATA.isoverdue = " "
                EQSRV.GLBDATA.outsAmt = " "
                EQSRV.GLBDATA.dpdval = " "

	#+++++++++++
	#Inputs
	#++++++++++++
        sv_u = urhk_GetChannelInfo("")
        if(sv_u==0)then
                EQSRV.GLBDATA.chnlId = BANCS.OUTPARAM.DccId
        else
                EQSRV.GLBDATA.chnlId = "BATCH"
        endif
        if(fieldexists(BANCS.INPUT.CIFID)==1)then
                EQSRV.GLBDATA.CIFID = BANCS.INPUT.CIFID
        else
                EQSRV.GLBDATA.CIFID = ""
        endif
        if(fieldexists(BANCS.INPUT.SCHEMECODE)==1)then
                EQSRV.GLBDATA.SCHEMECODE = BANCS.INPUT.SCHEMECODE
        else
                EQSRV.GLBDATA.SCHEMECODE = ""
        endif

        if(EQSRV.GLBDATA.CIFID!="")then
        #{
		lv_j = "count|select count(foracid) from tbaadm.gam where cif_id =?SVAR and schm_type='LAA' and bank_id= ?SVAR "
	IF(EQSRV.GLBDATA.SCHEMECODE != "") THEN
		lv_j = lv_j + " and schm_code = ?SVAR "
	ENDIF
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.CIFID + "|" + BANCS.STDIN.contextBankId
	IF(EQSRV.GLBDATA.SCHEMECODE != "") THEN
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQSRV.GLBDATA.SCHEMECODE
	ENDIF
		lv_f = urhk_dbSelectWithBind(lv_j)
		if(lv_f == 0) then
			EQSRV.GLBDATA.count = BANCS.OUTPARAM.count
		else
			EQSRV.GLBDATA.count = "0"
		endif
        	sv_u = urhk_SetOrbOut("LoanAccountsCount|" + EQSRV.GLBDATA.count)
	ENDIF

	if(cdouble(EQSRV.GLBDATA.count)<=0) then
		exitscript
	endif

        if(EQSRV.GLBDATA.CIFID!="")then
        #{
		lv_j = "foracid|select foracid from tbaadm.gam where cif_id =?SVAR and schm_type='LAA' and bank_id= ?SVAR "
	IF(EQSRV.GLBDATA.SCHEMECODE != "") THEN
		lv_j = lv_j + " and schm_code = ?SVAR "
	ENDIF
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.CIFID + "|" + BANCS.STDIN.contextBankId
	IF(EQSRV.GLBDATA.SCHEMECODE != "") THEN
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQSRV.GLBDATA.SCHEMECODE
	ENDIF
		lv_j = lv_j + " order by acct_opn_date desc "
        lv_u = urhk_dbCursorOpenWithBind(lv_j)
        if(lv_u == 0)then
                EQSRV.GLBDATA.acctNums = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(EQSRV.GLBDATA.acctNums)
        else
                sv_u = urhk_SetOrbOut("LoanAcctRec.SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("LoanAcctRec.ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("LoanAcctRec.Message|No Loans for the Customer")
                goto SIFNO

        endif
        EQSRV.GLBDATA.recNum = 0
        EQSRV.GLBDATA.dpdVal = 0
        lv_t = urhk_dbCursorFetch(EQSRV.GLBDATA.acctNums)
	print(lv_t)
        if(lv_t !=0)then
                lv_u = urhk_dbCursorClose(EQSRV.GLBDATA.acctNums)
                print(lv_u)
                sv_u = urhk_SetOrbOut("LoanAcctRec.SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("LoanAcctRec.ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("LoanAcctRec.Message|Loan Demand Not Exists, Account Rescheduled")
                EQSRV.GLBDATA.isRecYN="N"
		exitscript
        else
                EQSRV.GLBDATA.isRecYN="Y"
        endif
	EQSRV.GLBDATA.recNum1 = 0
        while((lv_t ==0) and (cdouble(EQSRV.GLBDATA.recNum1) < 10))
	#{
	print(EQSRV.GLBDATA.recNum1)
	EQSRV.GLBDATA.LoanAcctId = BANCS.OUTPARAM.foracid
	print(EQSRV.GLBDATA.LoanAcctId)
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.LoanAcctId)
        if(sv_u==0)then
        #{
                print(BANCS.OUTPARAM.sanctionLimit)
                EQSRV.GLBDATA.csanctionLimit = BANCS.OUTPARAM.sanctionLimit
                print(BANCS.OUTPARAM.cleanAdhocLimit)
                print(BANCS.OUTPARAM.drawingPower)
                print(BANCS.OUTPARAM.usedUnclearOverDACC)
                print(BANCS.OUTPARAM.FXClearBalance)
                print(BANCS.OUTPARAM.FxAvailableAmt)
                print(BANCS.OUTPARAM.AvailableAmt)
                print(BANCS.OUTPARAM.ClearBalance)
                EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
                EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		EQSRV.GLBDATA.cClearBalance1 = BANCS.OUTPARAM.ClearBalance
                EQSRV.GLBDATA.acid = BANCS.OUTPARAM.acid
                print(EQSRV.GLBDATA.cClearBalance1)
                print(BANCS.OUTPARAM.DACCLimit)
                print(BANCS.OUTPARAM.FxFFDAvailableAmt)
                print(BANCS.OUTPARAM.FFDAvailableAmt)
                print(BANCS.OUTPARAM.lienAmt)
                print(BANCS.OUTPARAM.FxEffAvailableAmt)
                print(BANCS.OUTPARAM.EffAvailableAmt)
                print(BANCS.OUTPARAM.systemGeneratedLimit)
                print(BANCS.OUTPARAM.SystemReservedAmt)
                print(BANCS.OUTPARAM.singleTranLimit)
                print(BANCS.OUTPARAM.cleanSingleTranLimit)
        #}
        else
        #{
                sv_u = urhk_SetOrbOut("LoanAcctRec.SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("LoanAcctRec.Message|Invalid Account")
                exitscript
        #}
        endif

	IF(EQSRV.GLBDATA.schmType != "LAA") THEN
	#{
                sv_u = urhk_SetOrbOut("LoanAcctRec.SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("LoanAcctRec.ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("LoanAcctRec.Message|Invalid Loan Account, should be of LAA scheme type")
                exitscript
	#}
	ENDIF

        lv_e = "LoanPeriod,eiStartDt,eiEndDate,eiFreq,firstInst|select REP_PERD_MTHS,to_char(EI_PERD_START_DATE,'dd-mm-yyyy'),to_char(EI_PERD_END_DATE,'dd-mm-yyyy'),LR_FREQ_TYPE,to_char(DIS_SHDL_DATE,'dd-mm-yyyy') from "
	lv_e = lv_e + " tbaadm.lam,tbaadm.lrs where lam.acid = ?SVAR "
	lv_e = lv_e + " and lam.acid=lrs.acid and lam.bank_id=lrs.bank_id and lam.bank_id = ?SVAR and rownum='1'  "
	print(lv_e)
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.acid  + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	lv_f = urhk_dbSelectWithBind(lv_e)
	if(lv_f == 0) then
		EQSRV.GLBDATA.LoanPeriod = BANCS.OUTPARAM.LoanPeriod
		EQSRV.GLBDATA.eiStartDt  = BANCS.OUTPARAM.eiStartDt
		EQSRV.GLBDATA.eiEndDate = BANCS.OUTPARAM.eiEndDate
		EQSRV.GLBDATA.eiFreq = BANCS.OUTPARAM.eiFreq
		EQSRV.GLBDATA.firstInst = BANCS.OUTPARAM.firstInst
	else
        	lv_g = "LoanPeriod,eiStartDt,eiEndDate,eiFreq,firstInst|select REP_PERD_MTHS,to_char(EI_PERD_START_DATE,'dd-mm-yyyy'), to_char(EI_PERD_END_DATE,'dd-mm-yyyy'),LR_FREQ_TYPE,to_char(DIS_SHDL_DATE,'dd-mm-yyyy') from "
		lv_g = lv_g + " tbaadm.lam,tbaadm.lrsh where lam.acid = ?SVAR "
		lv_g = lv_g + " and lam.acid=lrsh.acid and lam.bank_id=lrsh.bank_id and lam.bank_id = ?SVAR and lrsh.SHDL_NUM=lam.REP_SHDL_NUM and rownum='1' "
		print(lv_g)
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.acid  + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		lv_h = urhk_dbSelectWithBind(lv_g)
		if(lv_h == 0) then
			EQSRV.GLBDATA.LoanPeriod = BANCS.OUTPARAM.LoanPeriod
			EQSRV.GLBDATA.eiStartDt  = BANCS.OUTPARAM.eiStartDt
			EQSRV.GLBDATA.eiEndDate = BANCS.OUTPARAM.eiEndDate
			EQSRV.GLBDATA.eiFreq = BANCS.OUTPARAM.eiFreq
			EQSRV.GLBDATA.firstInst = BANCS.OUTPARAM.firstInst
		else
			EQSRV.GLBDATA.LoanPeriod = " "
			EQSRV.GLBDATA.eiStartDt  = " "
			EQSRV.GLBDATA.eiEndDate = " "
			EQSRV.GLBDATA.eiFreq = " "
			EQSRV.GLBDATA.firstInst = " "
		endif
	endif

        if(EQSRV.GLBDATA.LoanAcctId!="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.LoanAccountId|" + EQSRV.GLBDATA.LoanAcctId)
        endif
        if(EQSRV.GLBDATA.schmCode !="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.LoanSchmCode|" + EQSRV.GLBDATA.schmCode )
        endif
        if(EQSRV.GLBDATA.csanctionLimit!="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.SanctionLimit|" + EQSRV.GLBDATA.csanctionLimit)
        endif
        if(EQSRV.GLBDATA.csanctionLimit!="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.AccountBalance|" + EQSRV.GLBDATA.cClearBalance1)
        endif
        if(EQSRV.GLBDATA.LoanPeriod!="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.LoanPeriodMonths|" + EQSRV.GLBDATA.LoanPeriod)
        endif
        if(EQSRV.GLBDATA.eiEndDate!="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.StartDate|" + EQSRV.GLBDATA.firstInst)
        endif
        if(EQSRV.GLBDATA.eiEndDate!="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.MaturityDate|" + EQSRV.GLBDATA.eiEndDate)
        endif
        if(EQSRV.GLBDATA.eiFreq!="")then
                sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.InstallmentFrequency|" + EQSRV.GLBDATA.eiFreq)
        endif
	###Get Request from Newgen or Johari
	lv_k = "applicationId,freeText3|select c.FREE_TEXT_3,"
	lv_k =  lv_k + " CASE WHEN c.FREE_TEXT_3 LIKE 'MICRO-00%' THEN 'MLOS' "
	lv_k =  lv_k + " WHEN c.FREE_TEXT_3 LIKE 'PB-00%' THEN 'RLOS' "
	lv_k =  lv_k + " WHEN c.FREE_TEXT_3 LIKE 'EAZZY-00%' OR c.FREE_TEXT_3 LIKE 'FACILE-00%' THEN 'CLOS' "
	lv_k =  lv_k + " WHEN c.FREE_TEXT_3 is null THEN 'FINACLE' "
	lv_k =  lv_k + " ELSE 'DIGITAL' END AS CHANNEL_MODULE "
	lv_k =  lv_k + " from tbaadm.gac c where acid = ?SVAR and bank_id = ?SVAR "
	print(lv_k)
	BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.acid  + "|" +BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	lv_l = urhk_dbSelectWithBind(lv_k)
	if(lv_l == 0) then
		EQSRV.GLBDATA.freeText3 =  BANCS.OUTPARAM.freeText3
		EQSRV.GLBDATA.applicationId =  BANCS.OUTPARAM.applicationId
	else
		EQSRV.GLBDATA.freeText3 =  ""
		EQSRV.GLBDATA.applicationId =  ""
	endif
	print(EQSRV.GLBDATA.freeText3)
	IF(EQSRV.GLBDATA.applicationId == "") THEN
		EQSRV.GLBDATA.freeText3 =  " "
		EQSRV.GLBDATA.applicationId =  " "	
	ENDIF
        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.ApplicationType|" + EQSRV.GLBDATA.freeText3)
        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.ApplicationID|" + EQSRV.GLBDATA.applicationId)	
	####End
        lv_e = "dmdFlowId,dmdDate,schdlNum,dOverDueDate,dmdAmt,lastAdjDate,adjAmt,isoverdue,outsAmt,dpdval,dmddt| "
	lv_e = lv_e + " select DMD_FLOW_ID,to_char(DMD_DATE,'dd-mm-yyyy'),SHDL_NUM,to_char(DMD_OVDU_DATE,'dd-mm-yyyy'),DMD_AMT,to_char(LAST_ADJ_DATE,'dd-mm-yyyy'),TOT_ADJ_AMT, "
	lv_e = lv_e + " (case when (to_date(LAST_ADJ_DATE,'dd-mm-yyyy') - to_date(dmd_date,'dd-mm-yyyy')) >0 then 'Y'  else 'N' end), dmd_amt-tot_adj_amt, "
        lv_e = lv_e + " (case when (to_date(LAST_ADJ_DATE,'dd-mm-yyyy') - to_date(dmd_date,'dd-mm-yyyy')) <0 or LAST_ADJ_DATE is null then 0 else (to_date(LAST_ADJ_DATE,'dd-mm-yyyy') - to_date(dmd_date,'dd-mm-yyyy')) end),dmd_date "
	lv_e = lv_e + " from tbaadm.ldt where acid = ?SVAR and bank_id=?SVAR "
	lv_e = lv_e + " union all "
	lv_e = lv_e + " select DMD_FLOW_ID,to_char(DMD_DATE,'dd-mm-yyyy'),SHDL_NUM,to_char(DMD_OVDU_DATE,'dd-mm-yyyy'),DMD_AMT,to_char(LAST_ADJ_DATE,'dd-mm-yyyy'),TOT_ADJ_AMT, "
	lv_e = lv_e + " (case when (to_date(LAST_ADJ_DATE,'dd-mm-yyyy') - to_date(dmd_date,'dd-mm-yyyy')) >0 then 'Y'  else 'N' end), dmd_amt-tot_adj_amt, "
        lv_e = lv_e + " (case when (to_date(LAST_ADJ_DATE,'dd-mm-yyyy') - to_date(dmd_date,'dd-mm-yyyy')) <0 or LAST_ADJ_DATE is null then 0 else (to_date(LAST_ADJ_DATE,'dd-mm-yyyy') - to_date(dmd_date,'dd-mm-yyyy')) end),dmd_date "
	lv_e = lv_e + " from tbaadm.ldth where acid = ?SVAR and bank_id=?SVAR "
	lv_e = lv_e + " order by DMD_DATE desc "
	print(lv_e)       
	#BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId  + "|" + EQSRV.GLBDATA.acid  + "|" +BANCS.STDIN.contextBankId 
	#BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS	+ "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId  + "|" + EQSRV.GLBDATA.acid  + "|" +BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.acid  + "|" +BANCS.STDIN.contextBankId 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS	+ "|" + EQSRV.GLBDATA.acid  + "|" +BANCS.STDIN.contextBankId     
        print(BANCS.INPARAM.BINDVARS)

        lv_u = urhk_dbCursorOpenWithBind(lv_e)
        if(lv_u == 0)then
                EQSRV.GLBDATA.gmainCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(EQSRV.GLBDATA.gmainCurNum)
        else
                sv_u = urhk_SetOrbOut("LoanAcctRec.SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("LoanAcctRec.ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("LoanAcctRec.Message|Loan Demand Not Exists, Account Rescheduled")
                goto SIFNO

        endif
        EQSRV.GLBDATA.recNum = 0
        EQSRV.GLBDATA.dpdVal = 0
        lv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.gmainCurNum)
	print(lv_f)
        if(lv_f !=0)then
                lv_f = urhk_dbCursorClose(EQSRV.GLBDATA.gmainCurNum)
                print(lv_f)
                #sv_u = urhk_SetOrbOut("LoanAcctRec.SuccessOrFailure|F")
                #sv_u = urhk_SetOrbOut("LoanAcctRec.ErrorCode|E9999")
                #sv_u = urhk_SetOrbOut("LoanAcctRec.Message|Loan Demand Not Exists, Account Rescheduled")
		EQSRV.GLBDATA.FlowIdd = " "
 		sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.FlowId|" + EQSRV.GLBDATA.FlowIdd) 
                EQSRV.GLBDATA.isRecYN="N"
		GOTO NEXTR
        else
                EQSRV.GLBDATA.isRecYN="Y"
        endif

        while(lv_f ==0)
                EQSRV.GLBDATA.dmdFlowId = BANCS.OUTPARAM.dmdFlowId
                EQSRV.GLBDATA.dmdDate = BANCS.OUTPARAM.dmdDate
                EQSRV.GLBDATA.schdlNum = BANCS.OUTPARAM.schdlNum
                EQSRV.GLBDATA.dOverDueDate = BANCS.OUTPARAM.dOverDueDate
                EQSRV.GLBDATA.dmdAmt = BANCS.OUTPARAM.dmdAmt
                EQSRV.GLBDATA.lastAdjDate = BANCS.OUTPARAM.lastAdjDate
                EQSRV.GLBDATA.adjAmt = BANCS.OUTPARAM.adjAmt
                EQSRV.GLBDATA.isoverdue = BANCS.OUTPARAM.isoverdue
                EQSRV.GLBDATA.outsAmt = BANCS.OUTPARAM.outsAmt
                EQSRV.GLBDATA.dpdval = BANCS.OUTPARAM.dpdval

                if(EQSRV.GLBDATA.schdlNum!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.FlowId |" + EQSRV.GLBDATA.schdlNum)
                endif
                if(EQSRV.GLBDATA.dmdFlowId!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdFlowCode |" + EQSRV.GLBDATA.dmdFlowId )
                endif
                if(EQSRV.GLBDATA.dmdDate!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdDate |" + EQSRV.GLBDATA.dmdDate)
                endif
                if(EQSRV.GLBDATA.dOverDueDate!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdOverDueDate |" + EQSRV.GLBDATA.dOverDueDate )
                endif
                if(EQSRV.GLBDATA.dmdAmt!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdAmount |" + EQSRV.GLBDATA.dmdAmt)
                endif
                if(EQSRV.GLBDATA.lastAdjDate!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.LastAdjDate |" + EQSRV.GLBDATA.lastAdjDate )
                endif
                if(EQSRV.GLBDATA.adjAmt!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotAdjAmt |" + EQSRV.GLBDATA.adjAmt)
                endif
                if(EQSRV.GLBDATA.isoverdue!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.isDmdOverdue |" +EQSRV.GLBDATA.isoverdue)
                endif
                if(EQSRV.GLBDATA.outsAmt!="")then
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotOutstandingAmt |" +EQSRV.GLBDATA.outsAmt)
                endif
                if(EQSRV.GLBDATA.dpdval!="")then
			print(EQSRV.GLBDATA.dpdval)
                        sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.FlowDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DPD |" +EQSRV.GLBDATA.dpdval)
                endif

                NXTREC:
                lv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.gmainCurNum)
                EQSRV.GLBDATA.recNum = cint(EQSRV.GLBDATA.recNum) + 1
		print(EQSRV.GLBDATA.recNum)
        do
        lv_f = urhk_dbCursorClose(EQSRV.GLBDATA.gmainCurNum)
        print(lv_f)

	NEXTR:
        lv_t = urhk_dbCursorFetch(EQSRV.GLBDATA.acctNums)
	print(lv_t)
        if(lv_t !=0)then
                lv_u = urhk_dbCursorClose(EQSRV.GLBDATA.acctNums)
                print(lv_u)
                #sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.SuccessOrFailure|F")
                #sv_u = urhk_SetOrbOut("LoanAcctRec.<rec_" + EQSRV.GLBDATA.recNum1 + ">.ErrorCode|E9999")
                #EQSRV.GLBDATA.isRecYN="N"
		exitscript
        endif
        EQSRV.GLBDATA.recNum1 = cint(EQSRV.GLBDATA.recNum1) + 1
	print(EQSRV.GLBDATA.recNum1)
	#}
	DO
        lv_u = urhk_dbCursorClose(EQSRV.GLBDATA.acctNums)
        print(lv_u)

trace off
