   		GOTO ENDSCRIPT
	ELSE
	CUST.DATA.account = BANCS.INPUT.Foracid
	PRINT(CUST.DATA.account)
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CUSTID"))== 0) ) THEN
   		CUST.DATA.errMsg="CIF OF THE Known Agent IS NULL"
		#sv_t = "executeFinacleScript_CustomData.ERROR | " +CUST.DATA.errMsg
		sv_t="ERROR| " + CUST.DATA.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
