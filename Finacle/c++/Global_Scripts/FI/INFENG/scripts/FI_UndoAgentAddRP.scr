	#}
	ELSE
	#{
		CUST.DATA.checkerUSERID=""
		PRINT(CUST.DATA.checkerUSERID)

	#}
	ENDIF
	
	



	#----------------------------------------------------------------------------------------------------------------------------
	#get refnum
	#-----------------------------------------------------------------------------------------------------------------------------
	sv_s = "refnum |"
	sv_s = sv_s + " SELECT TO_CHAR(TBAADM.TBA_ADT_REF_NUM_SEQ_54.NEXTVAL) FROM DUAL "

	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d==0)THEN
	#{
		PRINT(BANCS.OUTPARAM.refnum)	
		CUST.DATA.refnum= BANCS.OUTPARAM.refnum 
	#}
	ELSE
	#{
	   	GOTO ENDOFSCRIPT
	#}
	ENDIF

	

#################################REMOVE Known Agent####################################


		sv_s = "ACID,STYPE, SOL,GLSUB|"
		sv_s = sv_s + " SELECT ACID,SCHM_TYPE,SOL_ID,GL_SUB_HEAD_CODE FROM TBAADM.GAM WHERE "
		sv_s = sv_s + "FORACID=?SVAR AND BANK_ID=?SVAR"

		BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF(sv_d ==0) THEN
		#{
			PRINT(BANCS.OUTPARAM.ACID)	
			CUST.DATA.acid = BANCS.OUTPARAM.ACID

			PRINT(BANCS.OUTPARAM.STYPE)	
			CUST.DATA.STYPE= BANCS.OUTPARAM.STYPE

			PRINT(BANCS.OUTPARAM.SOL)	
			CUST.DATA.SOL= BANCS.OUTPARAM.SOL

			PRINT(BANCS.OUTPARAM.GLSUB)	
			CUST.DATA.GLSUB= BANCS.OUTPARAM.GLSUB

			sv_s = "COUNT|"
			sv_s = sv_s + " SELECT COUNT(*) FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "ACID=?SVAR AND BANK_ID=?SVAR AND ACCT_POA_AS_REC_TYPE='O'"

			BANCS.INPARAM.BINDVARS = CUST.DATA.acid +"|"+ BANCS.STDIN.contextBankId
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)		
			print(BANCS.OUTPARAM.COUNT)	
			CUST.DATA.count = BANCS.OUTPARAM.COUNT

			IF(CUST.DATA.count == 0)THEN
			#{
				CUST.DATA.msg1 = "No Known Agent for account " + CUST.DATA.account

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg1
				sv_t="MSG| " + CUST.DATA.msg1
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT	
			#}		
			ENDIF	

			#####Handle next print not null
			sv_s = "nextPrintDate|"
			sv_s = sv_s + " SELECT PS_NEXT_DUE_DATE FROM TBAADM.AST WHERE "
			sv_s = sv_s + " ACID=?SVAR AND BANK_ID=?SVAR"

			BANCS.INPARAM.BINDVARS = CUST.DATA.acid +"|"+ BANCS.STDIN.contextBankId		
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0)THEN
			#{
				PRINT(BANCS.OUTPARAM.nextPrintDate)	
				CUST.DATA.nextPrintDate= BANCS.OUTPARAM.nextPrintDate

			#}
			ELSE
			#{
				CUST.DATA.nextPrintDate=""
			#}
			ENDIF
		
	CUST.DATA.flag ="Y"

	##############################################SBA ACCOUNTS##############################	
	IF(CUST.DATA.STYPE == "SBA")THEN
	#{

		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.DATA.account)
		PRINT(sv_u)
			
		sv_u = urhk_ExecSrv("SRV_FetchSBAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)


		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)

			sv_s = "SERIALNUM|"
			sv_s = sv_s + " SELECT ACCT_POA_AS_SRL_NUM-1 FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "NMA_KEY_ID=?SVAR AND BANK_ID=?SVAR AND ACID=?SVAR AND DEL_FLG='N'"

			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acid

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				print(BANCS.OUTPARAM.SERIALNUM)	
				CUST.DATA.sn = BANCS.OUTPARAM.SERIALNUM
				print(CUST.DATA.sn)
				sv_e = CUST.DATA.sn
			#}
			ELSE
			#{
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " is not found."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			ENDIF	

			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.delFlg|"+ CUST.DATA.flag)
			print(sv_u)
			#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.authEndDate|"+CUST.AGENT.authEndDate)
			#print(sv_u)
			IF(CUST.DATA.nextPrintDate!="")THEN
			#{
				sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctCustInfo.psNextPrintDate|"+BANCS.STDIN.BODDate)

			#}
			ENDIF
					
			sv_u = urhk_ExecSrv("SRV_ModifySBAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)

			IF (sv_u == 0) THEN
			#{
			
			CUST.DATA.PHONE =""
			CUST.DATA.EMAIL =""
			CUST.DATA.AccountPHONE =""
			CUST.DATA.AccountEMAIL =""
			
			###Fetching Account Phone Number and Email
				
			sv_s = "EMAIL, PHONE|"
			sv_s = sv_s + " select email, phone from crmuser.cmg where cif_id in (select cif_id from tbaadm.gam where foracid =?SVAR) and bank_id =?SVAR "
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				
				CUST.DATA.AccountEMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.EMAIL)
				
				CUST.DATA.AccountPHONE = BANCS.OUTPARAM.PHONE
				print(CUST.DATA.PHONE)
				
			#}
			
			ENDIF
			
			
			###Fetching Agent Phone Number and Email

			CUST.DATA.CUST_NAME = ""
			sv_s = "EMAIL, PHONE, CUST_NAME|"
			sv_s = sv_s + " select email, phone, CUST_NAME from crmuser.cmg where cif_id =?SVAR AND BANK_ID=?SVAR "
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				
				CUST.DATA.EMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.EMAIL)
				
				CUST.DATA.PHONE = BANCS.OUTPARAM.PHONE
				print(CUST.DATA.PHONE)
				
				CUST.DATA.CUST_NAME = BANCS.OUTPARAM.CUST_NAME
				print(CUST.DATA.CUST_NAME)
				
			#}
			
			ENDIF
			
	
				
				SBASVSEND:
				
				print("SUCCESS")			
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " has been removed successfully."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				sv_k ="200"
				sv_t="ResponseCode| " + sv_k
				sv_m = urhk_SetOrbOut(sv_t)
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentEMAIL| " + CUST.DATA.EMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentPHONE| " + CUST.DATA.PHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountPHONE| " + CUST.DATA.AccountPHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountEMAIL| " + CUST.DATA.AccountEMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentName| " + CUST.DATA.CUST_NAME
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ELSE
			#{
					GOTO REMCHECKERROR
			#}
			ENDIF
 			CUST.DATA.tablekey = CUST.DATA.acid +"/" +BANCS.STDIN.mySolId + "/" + BANCS.STDIN.contextBankId
			PRINT(CUST.DATA.tablekey)


		#}
		ENDIF


	#}
	ENDIF



	#####################################################CAA ACCOUNT#############################################
	IF(CUST.DATA.STYPE == "CAA")THEN
	#{

		sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.DATA.account)
		PRINT(sv_u)
			
		sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)


		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)

			sv_s = "SERIALNUM|"
			sv_s = sv_s + " SELECT ACCT_POA_AS_SRL_NUM-1 FROM TBAADM.AAS WHERE "
			sv_s = sv_s + "NMA_KEY_ID=?SVAR AND BANK_ID=?SVAR AND ACID=?SVAR AND DEL_FLG='N'"

			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acid
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				print(BANCS.OUTPARAM.SERIALNUM)	
				CUST.DATA.sn = BANCS.OUTPARAM.SERIALNUM
				print(CUST.DATA.sn)
				sv_e = CUST.DATA.sn
			#}
			ELSE
			#{
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " is not found."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			ENDIF	

            CUST.DATA.flag ="Y"
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.delFlg|"+ CUST.DATA.flag)
			print(sv_u)
			#sv_u = urhk_SetUrhkInp("acctCommonInfo.acctJointHolder.acctJointHolderLL.<rec_"+sv_e+">.authEndDate|"+CUST.AGENT.authEndDate)
			#print(sv_u)
				
			sv_u = urhk_ExecSrv("SRV_ModifyCAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)

			IF (sv_u == 0) THEN
			#{
			
			CUST.DATA.PHONE =""
			CUST.DATA.EMAIL =""
			CUST.DATA.AccountPHONE =""
			CUST.DATA.AccountEMAIL =""
			
			###Fetching Account Phone Number and Email
				
			sv_s = "EMAIL, PHONE|"
			sv_s = sv_s + " select email, phone from crmuser.cmg where cif_id in (select cif_id from tbaadm.gam where foracid =?SVAR) and bank_id =?SVAR "
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.account +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				
				CUST.DATA.AccountEMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.EMAIL)
				
				CUST.DATA.AccountPHONE = BANCS.OUTPARAM.PHONE
				print(CUST.DATA.PHONE)
				
			#}
			
			ENDIF
			
	
				
			###Fetching Agent Phone Number and Email
			CUST.DATA.CUST_NAME = ""
			sv_s = "EMAIL, PHONE, CUST_NAME|"
			sv_s = sv_s + " select email, phone, CUST_NAME from crmuser.cmg where cif_id =?SVAR AND BANK_ID=?SVAR "
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.cif +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)

			IF(sv_d==0)THEN
			#{		
				
				CUST.DATA.EMAIL = BANCS.OUTPARAM.EMAIL
				print(CUST.DATA.EMAIL)
				
				CUST.DATA.PHONE = BANCS.OUTPARAM.PHONE
				print(CUST.DATA.PHONE)
				
				CUST.DATA.CUST_NAME = BANCS.OUTPARAM.CUST_NAME
				print(CUST.DATA.CUST_NAME)
				
			#}
			
			ENDIF
			
			
			
				CAASVSEND:
			
			
				print("SUCCESS")			
				#sending response to the user
				CUST.DATA.msg = "Known Agent " + CUST.DATA.cif + " for account " +CUST.DATA.account + " has been removed successfully."

				#sv_t = "executeFinacleScript_CustomData.MSG | " +CUST.DATA.msg
				sv_k ="200"
				sv_t="ResponseCode| " + sv_k
				sv_m = urhk_SetOrbOut(sv_t)
				sv_t="MSG| " + CUST.DATA.msg
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentEMAIL| " + CUST.DATA.EMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentPHONE| " + CUST.DATA.PHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountPHONE| " + CUST.DATA.AccountPHONE
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AccountEMAIL| " + CUST.DATA.AccountEMAIL
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t="AgentName| " + CUST.DATA.CUST_NAME
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ELSE
			#{
					GOTO REMCHECKERROR
			#}
			ENDIF

 			CUST.DATA.tablekey = CUST.DATA.acid +"/" +BANCS.STDIN.mySolId + "/" + BANCS.STDIN.contextBankId
			PRINT(CUST.DATA.tablekey)

		#}
		ENDIF
		
	#}
	ENDIF

	

	


	REMCHECKERROR:
	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error for Acct:"+CUST.DATA.account+" '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>loanMgr.log")
				print(sv_u)
				
				#Error response
				sv_t="ERROR| " + sv_e
				sv_u = urhk_SetOrbOut(sv_t)
				sv_k ="400"
				sv_t="ResponseCode| " + sv_k
				sv_m = urhk_SetOrbOut(sv_t)
				
				sv_t="MSG| " + sv_e
				sv_m = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			DO
			#}
		ENDIF
	#}
	ENDIF



########################################REMOVE Known Agent ENDS######################################################


ENDSCRIPT:
trace off

