		############################################

		BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId + "|" + CUST.DATA.Bacid + "|" + CUST.DATA.Crncy + "|" + CUST.DATA.SolID
 
					
		IF ((FIELDEXISTS(CUST.DATA.Bacid) ==1) and (FIELDEXISTS(CUST.DATA.Crncy) ==1)and (FIELDEXISTS(CUST.DATA.SolID) ==1)) THEN
	
	sv_s = "AcctId|SELECT count(1) "
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE GAM.BANK_ID = ?SVAR "
	sv_s = sv_s + " AND   GAM.BACID = ?SVAR "
	sv_s = sv_s + " AND   GAM.ACCT_CRNCY_CODE = ?SVAR "
       sv_s = sv_s + " AND   GAM.sol_id = ?SVAR "
	sv_s = sv_s + " AND   GAM.ACCT_CLS_FLG != 'Y' "
	sv_s = sv_s + " AND   GAM.ENTITY_CRE_FLG = 'Y' "
	sv_s = sv_s + " AND   GAM.DEL_FLG != 'Y' "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Bacid + "|" + CUST.DATA.Crncy + "|" + CUST.DATA.SolID

	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d == 0)THEN
	
                   PRINT(BANCS.OUTPARAM.AcctId)
				CUST.DATA.AcctId  = BANCS.OUTPARAM.AcctId
				PRINT(CUST.DATA.AcctId)
				#GOTO ENDOFSCRIPT

                       

	#{
		sv_h = BANCS.OUTPARAM.AcctId
		PRINT(sv_h)
		IF(sv_h == 1)THEN
		#{
			#------------------------------------------------------------------------
			# Only one account for the bacid and crncy combination
