		sv_x="Bacid"
		sv_J="Crncy"
              sv_k="SolID"

		


	IF ((FIELDEXISTS(("BANCS").("INPUT").(sv_x))== 1) OR (FIELDEXISTS(("BANCS").("INPUT").(sv_J))== 1) OR (FIELDEXISTS(("BANCS").("INPUT").(sv_k))== 1))THEN

                #========================================================
		#---Checking if the Bacid and Crncy exists or not-------
		#========================================================
	    IF (((FIELDEXISTS(("BANCS").("INPUT").(sv_x))== "1")) and ((FIELDEXISTS(("BANCS").("INPUT").(sv_J))== "1"))and ((FIELDEXISTS(("BANCS").("INPUT").(sv_k))== "1"))) THEN
				
			CUST.DATA.Bacid =BANCS.INPUT.Bacid
