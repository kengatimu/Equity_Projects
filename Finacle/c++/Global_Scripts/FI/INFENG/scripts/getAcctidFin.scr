			sv_s = sv_s + " FROM TBAADM.GAM "
			sv_s = sv_s + " WHERE GAM.BANK_ID = ?SVAR "
			sv_s = sv_s + " AND   GAM.BACID = ?SVAR "
			sv_s = sv_s + " AND   GAM.ACCT_CRNCY_CODE = ?SVAR "
                     	sv_s = sv_s + " AND   GAM.sol_id = ?SVAR "
			sv_s = sv_s + " AND   GAM.ACCT_CLS_FLG != 'Y' "
			sv_s = sv_s + " AND   GAM.ENTITY_CRE_FLG = 'Y' "
			sv_s = sv_s + " AND   GAM.DEL_FLG != 'Y' "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Bacid + "|" + CUST.DATA.Crncy+ "|" + CUST.DATA.SolID

			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			
			IF(sv_d == 0)THEN

			#{
				
                              CUST.DATA.AcctId = BANCS.OUTPARAM.AcctId
			          PRINT(CUST.DATA.AcctId)
 			     CUST.DATA.BACID = BANCS.OUTPARAM.BACID
				PRINT(CUST.DATA.BACID)									
 				CUST.DATA.SolID = BANCS.OUTPARAM.SolID
				PRINT(CUST.DATA.SolID)
                                 CUST.DATA.Curncy = BANCS.OUTPARAM.Curncy
                                 PRINT(CUST.DATA.Curncy)
				 CUST.DATA.SchmType = BANCS.OUTPARAM.SchmType
                                 PRINT(CUST.DATA.SchmType)
				 CUST.DATA.SchmCode = BANCS.OUTPARAM.SchmCode
                                 PRINT(CUST.DATA.SchmCode)
				 CUST.DATA.AcctName = BANCS.OUTPARAM.AcctName
                                 PRINT(CUST.DATA.AcctName)
                                  				  
				 ##CUST.DATA.AcctId  = BANCS.OUTPARAM.AcctId

				###PRINT( CUST.DATA.AcctId)
				 sv_a=urhk_SetOrbOut("AcctId|"+CUST.DATA.AcctId)
				 sv_a=urhk_SetOrbOut("BACID|"+CUST.DATA.BACID)
				 sv_a=urhk_SetOrbOut("SolID|"+CUST.DATA.SolID)
				 sv_a=urhk_SetOrbOut("Curncy|"+CUST.DATA.Curncy)
				 sv_a=urhk_SetOrbOut("SchmType|"+CUST.DATA.SchmType)
				 sv_a=urhk_SetOrbOut("SchmCode|"+CUST.DATA.SchmCode)
				 sv_a=urhk_SetOrbOut("AcctName|"+CUST.DATA.AcctName)

				 GOTO ENDOFSCRIPT

				
                                                
			ENDIF

ELSE     
           
                CUST.DATA.success="N"
                BANCS.OUTPUT.successOrFailure="F"
                sv_o=urhk_SetOrbOut("ErrorCode|No data found")
                GOTO ENDOFSCRIPT


			ENDIF
		#}
