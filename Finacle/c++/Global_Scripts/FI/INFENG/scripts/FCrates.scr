####################################################################################
# Name                  :       FCrates.scr
# Date                  :       19-05-2023
# Description           :       Fetch FCB/FCS rates
# Input                 :	ratecode, fromcurrency, tocurrency
# Output                :
# Author                :       James Maina
# Called Script         :
#####################################################################################
#--------------------------

<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","ACCT") == 0) THEN
        #{
                CREATECLASS("CUST","ACCT",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("RateCode"))== 0) ) THEN
	#{
   		CUST.ACCT.errMsg="Please enter RateCode"
		sv_t = "Msg| " +CUST.ACCT.errMsg
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("fromCurrency"))== 0) ) THEN
	#{
   		CUST.ACCT.errMsg="Please enter fromCurrency"
		sv_t = "Msg| " +CUST.ACCT.errMsg
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("ToCurrency"))== 0) ) THEN
	#{
   		CUST.ACCT.errMsg="Please enter ToCurrency"
		sv_t = "Msg| " +CUST.ACCT.errMsg
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF


	#---------------------------------------------------------------------------------------------------------------
	#Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.ACCT.RateCode= BANCS.INPUT.RateCode
	PRINT(CUST.ACCT.RateCode)
	CUST.ACCT.fromCurrency= BANCS.INPUT.fromCurrency
	PRINT(CUST.ACCT.fromCurrency)
	CUST.ACCT.ToCurrency= BANCS.INPUT.ToCurrency
	PRINT(CUST.ACCT.ToCurrency)
	#---------------------------------------------------------------------------------------------------------------
	#ratecode validation
	#---------------------------------------------------------------------------------------------------------------

	IF((CUST.ACCT.RateCode !="FCB") AND (CUST.ACCT.RateCode !="FCS"))THEN
	#{
   		CUST.ACCT.errMsg="only FCB/FCS ratecode allowed"
		sv_t = "Msg| " +CUST.ACCT.errMsg
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT

	#}
	ENDIF

	sv_s="rate, trearate|"
	sv_s = sv_s + " select var_crncy_units,CUST_VAR_CRNCY_UNITS from tbaadm.rtl where  "
	sv_s = sv_s + " ratecode= ?SVAR  AND fxd_crncy_code= ?SVAR  AND var_crncy_code= ?SVAR  AND bank_id =?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.ACCT.RateCode+ "|" + CUST.ACCT.fromCurrency + "|" + CUST.ACCT.ToCurrency+"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d==0)THEN
	#{
		CUST.ACCT.rate= BANCS.OUTPARAM.rate
		PRINT(CUST.ACCT.rate)
		CUST.ACCT.trearate= BANCS.OUTPARAM.trearate
		PRINT(CUST.ACCT.trearate)
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
		sv_z = urhk_SetOrbOut("rate|" + CUST.ACCT.rate)
		#sv_z = urhk_SetOrbOut("treaRate|" + CUST.ACCT.trearate)


	#}
	ELSE
	#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_z = urhk_SetOrbOut("Msg|Rate not maintained for the combination passed")

	#}
	ENDIF

ENDSCRIPT:

trace off

end-->

