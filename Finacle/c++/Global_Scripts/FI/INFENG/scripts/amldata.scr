		sv_c = sv_c + "?SVAR,?SVAR,?SVAR,to_date(?SVAR,'DD-MM-RRRR'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,sysdate,?SVAR,sysdate,'Y','N',?SVAR,?SVAR,null,null,null,null,null)"
		print(sv_c)
