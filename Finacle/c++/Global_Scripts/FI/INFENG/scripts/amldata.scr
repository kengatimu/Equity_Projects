			sv_s =""
			sv_s = sv_s + " delete"
			sv_s = sv_s + "  from custom.cust_tmaml_tbl " 
			sv_s = sv_s + " WHERE TRAN_ID=?SVAR  and TRAN_DATE =to_date(?SVAR,'DD-MM-YYYY') "
			sv_s = sv_s + " AND BANK_ID=?SVAR"
			print(sv_s) 
                                    BANCS.INPARAM.BINDVARS = CUST.DATA.tranid + "|" + CUST.DATA.trandate + "|" + BANCS.STDIN.contextBankId
			sv_e= urhk_dbsqlWithBind(sv_s)
			print(sv_e)
			if(sv_e==0) then
				CUST.DATA.FLG ="Y"
			endif 
		#}
		endif
	
	sv_d = 1
	while(sv_d <= 1)
	#{
		if (sv_d == 1) then
		#{
			if (fieldexists(BANCS.INPUT.cfName)) then
				CUST.DATA.cfName = BANCS.INPUT.cfName
				print(CUST.DATA.cfName)
			else
				CUST.DATA.cfName = ""
