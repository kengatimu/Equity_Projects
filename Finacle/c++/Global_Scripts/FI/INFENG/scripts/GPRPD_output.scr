	sv_q = sv_q + " AND BANK_ID = ?SVAR ) "
	sv_q = sv_q + " AND BANK_ID = ?SVAR "
	BANCS.INPARAM.BINDVARS = sv_u + "|" +  BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.contextBankId
