		MTT.LAAddnlDetails.DemandAmt = sv_a
		MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.RvrslTranId
		MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.RvrslDateDiff
		MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.PartTranSrlNum
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.FlowId

#print(MTT.LAAddnlDetails.ReversalTranId)
#print(MTT.LAAddnlDetails.ReversalTranDate)
#print(MTT.LAAddnlDetails.ReversalPtranSrlNum)
#print(MTT.LAAddnlDetails.DemandFlowId)
#print(MTT.LAAddnlDetails.ReversalTranDate)
#print(MTT.InputDetails.PartTranIden)
#print(MTT.InputDetails.PartTranIden)
#print(MTT.InputDetails.PartTranIden)
	
		sv_z = urhk_MTTS_DefineLoanPartTran(MTT.InputDetails.PartTranIden)
#print(sv_z)
		if (sv_z == 1) then
			exitscript
		endif
	#}
	else
	#{
		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.RateCode = MTT.InputDetails.RateCode
		MTT.PartTranDetails.RefAmount = sv_a
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.TranAcct 
