<--START
CHECKSUM="f00102ef8a7b0e84f71f82b3f40dcefbfbf57b9135f4fa29c6adcf062078e268"
TRACE ON

	print(COLL.GLBDATA.schmCode)
	print(COLL.GLBDATA.account)
	COLL.GLBDATA.chrgeS = "N"
	COLL.GLBDATA.BODDate = mid$(BANCS.STDIN.BODDate,0,10)
	lv_t = urhk_getAcctDetailsInRepository(COLL.GLBDATA.account)
	if(lv_t == 0) then
		COLL.GLBDATA.acid = BANCS.OUTPARAM.acid
	else
		COLL.GLBDATA.acid = ""
	endif		

	############get start and end date of the month
	BANCS.INPARAM.BINDVARS = COLL.GLBDATA.BODDate + "|" + COLL.GLBDATA.BODDate
	print(BANCS.INPARAM.BINDVARS)

	lv_v = "SstartDate,SendDate|SELECT TRUNC(LAST_DAY(ADD_MONTHS(to_date(?SVAR,'DD-MM-YYYY'),-1)))+1, TRUNC(LAST_DAY(to_date(?SVAR,'DD-MM-YYYY'))) FROM DUAL "
	print(lv_v)
	lv_x = urhk_dbSelectWithBind(lv_v)
	IF(lv_x == 0) THEN
		COLL.GLBDATA.SstartDate = BANCS.OUTPARAM.SstartDate
		COLL.GLBDATA.SendDate = BANCS.OUTPARAM.SendDate
	ELSE
		COLL.GLBDATA.SstartDate = ""
		COLL.GLBDATA.SendDate = ""
	ENDIF
	print(COLL.GLBDATA.SstartDate)
	print(COLL.GLBDATA.SendDate)

	#####Get number of transaction records for transaction month
	BANCS.INPARAM.BINDVARS = COLL.GLBDATA.acid + "|" + COLL.GLBDATA.SstartDate + "|" + COLL.GLBDATA.SendDate + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

 	lv_x = "countS|select count(*) from tbaadm.dctd_acli where acid=?SVAR and tran_date >= to_date(?SVAR) and tran_date <= to_date(?SVAR) and bank_id =?SVAR and PSTD_FLG ='Y' "
	lv_x = lv_x + "  and PART_TRAN_TYPE ='D' and TRAN_SUB_TYPE in('NP','CI') "
	print(lv_x)

	lv_y = urhk_dbSelectWithBind(lv_x)
	print(lv_y)

	IF(lv_y == 0 ) THEN
	#{
		COLL.GLBDATA.countS = BANCS.OUTPARAM.countS
		print(COLL.GLBDATA.countS)
	#}
	ELSE
	#{
		COLL.GLBDATA.countS = 0	
	#}
	ENDIF
	
	IF(((COLL.GLBDATA.schmCode == "SB130" ) OR (COLL.GLBDATA.schmCode == "SB137") OR (COLL.GLBDATA.schmCode == "SB145") OR (COLL.GLBDATA.schmCode == "SB146")) AND (cdouble(COLL.GLBDATA.countS)>1)) THEN
	#{
		COLL.GLBDATA.chrgeS = "Y"		
	#}
	ENDIF

	IF(((COLL.GLBDATA.schmCode == "SB135") OR (COLL.GLBDATA.schmCode == "SB136")) AND (cdouble(COLL.GLBDATA.countS)>2)) THEN
	#{
		COLL.GLBDATA.chrgeS = "Y"		
	#}
	ENDIF


EXITSCRIPT
END-->
