					sv_s = sv_s + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
					sv_s = sv_s + "?SVAR"
					sv_s = sv_s + ")"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.DATA.custID + "|" + CUST.DATA.srlnum + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.sysDate + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.BODDate + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						sv_d = urhk_dbSQLWithBind("COMMIT")
						PRINT(sv_d)
					#}
					ELSE
					#{
						sv_e = "A Database error has occured. Please contact your DBA"
						sv_e = "ERROR|"+ sv_e 
						sv_u = urhk_SetOrbOut(sv_e)
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF

		#}
                ELSE
                #{
                        sv_e = "Invalid cif ID"
			sv_e = "ERROR|"+ sv_e +" "
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDSCRIPT
                #}
                ENDIF

        #}
        ENDIF
	
	
ENDSCRIPT:
EXITSCRIPT
	
