<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(fieldexists(BANCS.INPUT.ODAcctId)==1)then
                EQSRV.GLBDATA.odAcctId = BANCS.INPUT.ODAcctId
        else
                EQSRV.GLBDATA.odAcctId = ""
        endif
        if(fieldexists(BANCS.INPUT.EventType)==1)then
                EQSRV.GLBDATA.EventType = BANCS.INPUT.EventType
        else
                EQSRV.GLBDATA.EventType = ""
        endif
	EQSRV.GLBDATA.dbankId = "" 
	EQSRV.GLBDATA.ddisbsrlNum = ""
	EQSRV.GLBDATA.dshdlNum = "" 
	EQSRV.GLBDATA.dFlowId = "" 
	EQSRV.GLBDATA.dodAcid = "" 
	EQSRV.GLBDATA.dOpAcid = "" 
	EQSRV.GLBDATA.dDmdDate = "" 
	EQSRV.GLBDATA.dDmdOvduDate = "" 
	EQSRV.GLBDATA.ddmdAmt = "" 
	EQSRV.GLBDATA.dtotAdjAmt = "" 
	EQSRV.GLBDATA.dDueAmt = "" 
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.odAcctId)
        if(sv_u==0)then
        #{
                print(BANCS.OUTPARAM.sanctionLimit)
                        EQSRV.GLBDATA.csanctionLimit = BANCS.OUTPARAM.sanctionLimit
                print(BANCS.OUTPARAM.cleanAdhocLimit)
                print(BANCS.OUTPARAM.drawingPower)
                print(BANCS.OUTPARAM.usedUnclearOverDACC)
                print(BANCS.OUTPARAM.FXClearBalance)
                print(BANCS.OUTPARAM.FxAvailableAmt)
                print(BANCS.OUTPARAM.AvailableAmt)
                print(BANCS.OUTPARAM.ClearBalance)
                        EQSRV.GLBDATA.cClearBalance = BANCS.OUTPARAM.ClearBalance
                EQSRV.GLBDATA.cClearBalance1 = BANCS.OUTPARAM.ClearBalance
                print(EQSRV.GLBDATA.cClearBalance1)
                print(BANCS.OUTPARAM.DACCLimit)
                print(BANCS.OUTPARAM.FxFFDAvailableAmt)
                print(BANCS.OUTPARAM.FFDAvailableAmt)
                print(BANCS.OUTPARAM.lienAmt)
                print(BANCS.OUTPARAM.FxEffAvailableAmt)
                print(BANCS.OUTPARAM.EffAvailableAmt)
                print(BANCS.OUTPARAM.systemGeneratedLimit)
                print(BANCS.OUTPARAM.SystemReservedAmt)
                print(BANCS.OUTPARAM.singleTranLimit)
                print(BANCS.OUTPARAM.cleanSingleTranLimit)
                EBSRV.GLBDATA.odsolid = BANCS.OUTPARAM.acctSolId
                print(EBSRV.GLBDATA.odsolid)
                EBSRV.GLBDATA.OdAcctId=EQSRV.GLBDATA.odAcctId
                print(EBSRV.GLBDATA.OdAcctId)
                EBSRV.GLBDATA.odSchmCode = BANCS.OUTPARAM.schmCode
                EBSRV.GLBDATA.odcrncyCdoe = BANCS.OUTPARAM.acctCrncyCode
	#}
	else
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Account")
                exitscript
	#}
	endif
	print(EQSRV.GLBDATA.EventType)
	#ChargeOff Chk
	lv_m = "ChrgCnt| select count(*) from tbaadm.ta_cot where bank_id='"+BANCS.STDIN.contextBankId+"' "
	lv_m = lv_m + " and acid in (select acid from tbaadm.gam "
	lv_m = lv_m + " where bank_id='"+BANCS.STDIN.contextBankId+"' "
	lv_m = lv_m + " and foracid='"+EQSRV.GLBDATA.odAcctId+"'"
	lv_m = lv_m + " and acct_cls_flg<>'Y' and acct_cls_date is null and entity_cre_flg='Y' and del_flg='N' ) "
	lv_m = lv_m + " and entity_cre_flg='Y' and del_flg='N' and CHRGE_OFF_DATE is not null "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_m)
	lv_c = urhk_dbSelectWithBind(lv_m)
	if(lv_c==0)then
	#{
		EQSRV.GLBDATA.ChrgCnt = BANCS.OUTPARAM.ChrgCnt
	else
		EQSRV.GLBDATA.ChrgCnt = 0
	#}
	endif
	print(EQSRV.GLBDATA.ChrgCnt)

        if(EQSRV.GLBDATA.EventType=="INTRUN")then
	#{
		IF(EQSRV.GLBDATA.ChrgCnt >CINT("0"))THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|F")	
			print(sv_u)
			sv_u = urhk_SetOrbOut("Message|charged Off Account")
			print(sv_u)
			exitscript
		#}
		ENDIF	

                goto LINTRUN
        endif

        lv_t = " odDisbAmt,odDisbDate,SchdlNum,numOfPay,EmiAmt,EmiIntAmt,EmiPrinAmt,odAcid,opAcid | "
        lv_t = lv_t + " select od_disb_amt,od_disb_tran_date,schl_number,number_of_payments,"
        lv_t = lv_t + " emi_amt,emi_int_amt,emi_principal_amt,od_acid,op_acid "
        lv_t = lv_t + " from custom.odfdr_schl_tbl "
#delflg should be Y
        lv_t = lv_t + " where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='Y' "
        lv_t = lv_t + " and od_acct_id=?SVAR "
        lv_t = lv_t + " and schl_number in (select max(schl_number) from custom.odfdr_schl_tbl "
        lv_t = lv_t + " where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='Y' "
        lv_t = lv_t + " and od_acct_id=?SVAR) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId
        print(BANCS.INPARAM.BINDVARS)
        print(lv_t)
        lv_y = urhk_dbSelectWithBind(lv_t)
        print(lv_y)
        if(lv_y==0)then
	#{
                EQSRV.GLBDATA.odDisbAmt = BANCS.OUTPARAM.odDisbAmt
                EQSRV.GLBDATA.odDisbDate = BANCS.OUTPARAM.odDisbDate
                EQSRV.GLBDATA.SchdlNum = BANCS.OUTPARAM.SchdlNum
                EQSRV.GLBDATA.numOfPay = BANCS.OUTPARAM.numOfPay
                EQSRV.GLBDATA.EmiAmt = BANCS.OUTPARAM.EmiAmt
                EQSRV.GLBDATA.EmiIntAmt = BANCS.OUTPARAM.EmiIntAmt
                EQSRV.GLBDATA.EmiPrinAmt = BANCS.OUTPARAM.EmiPrinAmt
                EQSRV.GLBDATA.odAcid = BANCS.OUTPARAM.odAcid
                EQSRV.GLBDATA.opAcid = BANCS.OUTPARAM.opAcid
	#}
        else
	#{
                EQSRV.GLBDATA.odDisbAmt = 0
                EQSRV.GLBDATA.odDisbDate = ""
                EQSRV.GLBDATA.SchdlNum = 0
                EQSRV.GLBDATA.numOfPay = 0
                EQSRV.GLBDATA.EmiAmt = 0
                EQSRV.GLBDATA.EmiIntAmt = 0
                EQSRV.GLBDATA.EmiPrinAmt = 0
                EQSRV.GLBDATA.odAcid = ""
                EQSRV.GLBDATA.opAcid = ""
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("ErrorCode|E9999")
		sv_u = urhk_SetOrbOut("Message|Loan Schedule Not Exists ,Schedule Creation was Failed at Loan Creation Process")
		goto SIFNO
	#}
        endif
	lv_h = " intExecCnt | select count(*) from custom.odfdr_dmd_tbl where bank_id=?SVAR and od_acid =?SVAR and entity_cre_flg='Y' and del_flg='N' and flow_id='INDEM' and free_text_5 like '%Int.Coll Executed%' and dmd_amt>0"
	print(lv_h)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSelectWithBind(lv_h)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.intExecCnt = BANCS.OUTPARAM.intExecCnt
	#}
        else
	#{
                EQSRV.GLBDATA.intExecCnt = 0
	#}
        endif
	lv_h = " intExectotCnt | select count(*) from custom.odfdr_dmd_tbl where bank_id=?SVAR and od_acid =?SVAR and entity_cre_flg='Y' and del_flg='N' and flow_id='INDEM' and dmd_amt>0" 
	print(lv_h)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSelectWithBind(lv_h)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.intExectotCnt = BANCS.OUTPARAM.intExectotCnt
	#}
        else
	#{
                EQSRV.GLBDATA.intExectotCnt = 0
	#}
        endif
	print(EQSRV.GLBDATA.intExecCnt)
	print(EQSRV.GLBDATA.intExectotCnt)
	#if(cdouble(EQSRV.GLBDATA.intExecCnt)==cdouble(EQSRV.GLBDATA.intExectotCnt))then
	#{
        #       	EQSRV.GLBDATA.InterestRunDate = "Y" 
	#else
        #       	EQSRV.GLBDATA.InterestRunDate = "N" 
	#}
	#endif
        lv_g = "cRepayAmt | select sum(tran_amt) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and pstd_flg='Y' and part_tran_type='C' and tran_date <= (select db_stat_date from tbaadm.gct where bank_id=?SVAR ) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +EQSRV.GLBDATA.odAcid  + "|" + BANCS.STDIN.contextBankId
        lv_r = urhk_dbSelectWithBind(lv_g)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.cRepayAmt = BANCS.OUTPARAM.cRepayAmt
	#}
        else
	#{
                EQSRV.GLBDATA.cRepayAmt = 0
	#}
        endif
        lv_g = "cDrAmt | select sum(tran_amt) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and pstd_flg='Y' and part_tran_type='D' and tran_date <= (select db_stat_date from tbaadm.gct where bank_id=?SVAR ) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +EQSRV.GLBDATA.odAcid  + "|" + BANCS.STDIN.contextBankId
        lv_r = urhk_dbSelectWithBind(lv_g)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.cDrAmt = BANCS.OUTPARAM.cDrAmt
	#}
        else
	#{
                EQSRV.GLBDATA.cDrAmt = 0
	#}
        endif
        lv_s = "lSanLim,lSanDate,lExpDate | select sanct_lim,lim_sanct_date,lim_exp_Date from tbaadm.lht where bank_id=?SVAR and acid=(select acid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR) and entity_cre_flg='Y' and del_flg='N' and status='A' and serial_num in (select max(serial_num)  from tbaadm.lht where bank_id=?SVAR and acid=(select acid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR) and entity_cre_flg='Y' and del_flg='N' and status='A') "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId
        print(lv_s)
        print(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSelectWithBind(lv_s)
        if(lv_r==0)then
        #{
                EQSRV.GLBDATA.lSanLim = BANCS.OUTPARAM.lSanLim
                EQSRV.GLBDATA.lSanDate = BANCS.OUTPARAM.lSanDate
                EQSRV.GLBDATA.lExpDate = BANCS.OUTPARAM.lExpDate
        #}
        else
        #{
                EQSRV.GLBDATA.lSanLim = ""
                EQSRV.GLBDATA.lSanDate = ""
                EQSRV.GLBDATA.lExpDate = ""
        #}
        endif
        print(EQSRV.GLBDATA.lSanLim)
        print(EQSRV.GLBDATA.lSanDate)
        print(EQSRV.GLBDATA.lExpDate)
        if(EQSRV.GLBDATA.odAcctId!="")then
	#{
                sv_u = urhk_SetOrbOut("ODAccountId|" + EQSRV.GLBDATA.odAcctId )
	#}
        endif
        if(EBSRV.GLBDATA.odSchmCode!="")then
	#{
                sv_u = urhk_SetOrbOut("ODSchmCode|" + EBSRV.GLBDATA.odSchmCode )
	#}
        endif
        if(EQSRV.GLBDATA.lSanLim!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSanctionLimit|" + EQSRV.GLBDATA.lSanLim )
	#}
        endif
        if(EQSRV.GLBDATA.lSanDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSanctionDate|" + EQSRV.GLBDATA.lSanDate )
	#}
        endif
        if(EQSRV.GLBDATA.lExpDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastExpiryDate|" + EQSRV.GLBDATA.lExpDate )
	#}
        endif
        if(EQSRV.GLBDATA.cClearBalance!="")then
	#{
                sv_u = urhk_SetOrbOut("TotalDue|" + EQSRV.GLBDATA.cClearBalance1 )
	#}
        endif
        if(EQSRV.GLBDATA.cDrAmt!="")then
	#{
                sv_u = urhk_SetOrbOut("TotalDisburseAmt|" + EQSRV.GLBDATA.cDrAmt )
	#}
        endif
        if(EQSRV.GLBDATA.odDisbDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastDisburseDate|" + EQSRV.GLBDATA.odDisbDate )
	#}
        endif
        if(EQSRV.GLBDATA.SchdlNum!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSchdlNum|" + EQSRV.GLBDATA.SchdlNum )
	#}
        endif
	############get interest details
        lv_i = " naccrAmt,nbookAmt,nappAmt,nintRate,inintFreqTy,nintFreqStD,accrDtDr,bookDtDr,calcDtDr,nxtDtDr,paccrAmt,pbookAmt,pappAmt | select nrml_accrued_amount_dr,nrml_booked_amount_dr,nrml_interest_amount_dr,interest_rate,int_freq_type_dr,int_freq_start_dd_dr,to_char(accrued_upto_date_dr,'DD-MM-RRRR'),to_char(booked_upto_date_cr,'DD-MM-RRRR'),to_char(interest_calc_upto_date_dr,'DD-MM-RRRR'),to_char(next_int_run_date_dr,'DD-MM-RRRR'),PENAL_ACCRUED_AMOUNT_DR,PENAL_BOOKED_AMOUNT_DR,PENAL_INTEREST_AMOUNT_DR from tbaadm.eit where bank_id=?SVAR and entity_id=?SVAR  "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
        lv_b = urhk_dbSelectWithBind(lv_i)
        if(lv_b==0)then
                EQSRV.GLBDATA.naccrAmt = BANCS.OUTPARAM.naccrAmt
                EQSRV.GLBDATA.nbookAmt = BANCS.OUTPARAM.nbookAmt
                EQSRV.GLBDATA.nappAmt = BANCS.OUTPARAM.nappAmt
                EQSRV.GLBDATA.nintRate = BANCS.OUTPARAM.nintRate
                EQSRV.GLBDATA.inintFreqTy = BANCS.OUTPARAM.inintFreqTy
                EQSRV.GLBDATA.nintFreqStD = BANCS.OUTPARAM.nintFreqStD
                EQSRV.GLBDATA.accrDtDr = BANCS.OUTPARAM.accrDtDr
                EQSRV.GLBDATA.bookDtDr = BANCS.OUTPARAM.bookDtDr
                EQSRV.GLBDATA.calcDtDr = BANCS.OUTPARAM.calcDtDr
                EQSRV.GLBDATA.nxtDtDr = BANCS.OUTPARAM.nxtDtDr
                EQSRV.GLBDATA.paccrAmt = BANCS.OUTPARAM.paccrAmt
                EQSRV.GLBDATA.pbookAmt = BANCS.OUTPARAM.pbookAmt
                EQSRV.GLBDATA.pappAmt = BANCS.OUTPARAM.pappAmt
        else
                EQSRV.GLBDATA.naccrAmt = ""
                EQSRV.GLBDATA.nbookAmt = ""
                EQSRV.GLBDATA.nappAmt = ""
                EQSRV.GLBDATA.paccrAmt = ""
                EQSRV.GLBDATA.pbookAmt = ""
                EQSRV.GLBDATA.pappAmt = ""
                EQSRV.GLBDATA.nintRate = ""
                EQSRV.GLBDATA.inintFreqTy = ""
                EQSRV.GLBDATA.nintFreqStD = ""
                EQSRV.GLBDATA.accrDtDr = ""
                EQSRV.GLBDATA.bookDtDr = ""
                EQSRV.GLBDATA.calcDtDr = ""
                EQSRV.GLBDATA.nxtDtDr = ""
        endif
        #if(cdouble(EQSRV.GLBDATA.nintRate)<=0)then
        #        EQSRV.GLBDATA.nintRate = -1 * cdouble(EQSRV.GLBDATA.nintRate)
        #endif
        if(EQSRV.GLBDATA.accrDtDr!="")then
                BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10)
                BANCS.INPARAM.date2 = EQSRV.GLBDATA.accrDtDr
                sv_u = urhk_B2K_dateDiff("")
                print(sv_u)
                if(sv_u == 0 ) then
                        EQSRV.GLBDATA.migdatediff = BANCS.OUTPARAM.dateDiff
                        EQSRV.GLBDATA.futmigdatediff = BANCS.OUTPARAM.dateDiff
                else
                        EQSRV.GLBDATA.migdatediff = "0"
                        EQSRV.GLBDATA.futmigdatediff = "0"
                endif
        else
                EQSRV.GLBDATA.migdatediff = "1"
                EQSRV.GLBDATA.futmigdatediff = "1"
        endif
        print(EQSRV.GLBDATA.migdatediff)
        print(EQSRV.GLBDATA.nappAmt)
        print(EQSRV.GLBDATA.cClearBalance)


        if(cdouble(EQSRV.GLBDATA.cClearBalance)<0)then
                EQSRV.GLBDATA.cClearBalance = -1 *cdouble(EQSRV.GLBDATA.cClearBalance)
                print(EQSRV.GLBDATA.cClearBalance)
        endif
	##############Get rates
        lv_t = " intTblCode | select int_tbl_code from tbaadm.csp where bank_id=?SVAR and schm_code=?SVAR and crncy_code=?SVAR and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odSchmCode + "|" + EQSRV.GLBDATA.acctCrncyCode
        print(lv_t)
        print(BANCS.INPARAM.BINDVARS)
        lv_u = urhk_dbSelectWithBind(lv_t)
        if(lv_u==0)then
        #{
                EQSRV.GLBDATA.intTblCode = BANCS.OUTPARAM.intTblCode
        #}
        else
        #{
                EQSRV.GLBDATA.intTblCode = ""
        #}
        endif

        lv_i = " drIntPcnt,drPenalInt| select NRML_INT_PCNT,PENAL_INT_PCNT from tbaadm.ivs where bank_id=?SVAR and int_tbl_code=?SVAR  and crncy_code=?SVAR and int_slab_dr_cr_flg='D' and int_tbl_ver_num in (select  max(int_tbl_ver_num) from tbaadm.icv where bank_id=?SVAR and int_tbl_code=?SVAR and crncy_code=?SVAR and entity_cre_flg='Y' and del_flg='N' and int_slab_dr_cr_flg='D' and int_slab_srl_num in (select max(int_slab_srl_num) from tbaadm.icv where bank_id=?SVAR and int_tbl_code=?SVAR and crncy_code=?SVAR and entity_cre_flg='Y' and del_flg='N' and int_slab_dr_cr_flg='D')) and entity_cre_flg='Y' and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId +"|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode
        print(lv_i)
        print(BANCS.INPARAM.BINDVARS)
        lv_d = urhk_dbSelectWithBind(lv_i)
        if(lv_d==0)then
        #{
                EQSRV.GLBDATA.drIntPcnt = BANCS.OUTPARAM.drIntPcnt
                EQSRV.GLBDATA.drPenalInt = BANCS.OUTPARAM.drPenalInt
        else
                EQSRV.GLBDATA.drIntPcnt = 0
                EQSRV.GLBDATA.drPenalInt = 0
        #}
        endif

        lv_i = "drIntPcntPre|select ID_DR_PREF_PCNT from tbaadm.itc where entity_id=?SVAR and INT_TBL_CODE_SRL_NUM in(select max(INT_TBL_CODE_SRL_NUM) from tbaadm.itc a where a.entity_id=?SVAR and bank_id=?SVAR) and bank_id=?SVAR "
        BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.odAcid + "|" + EQSRV.GLBDATA.odAcid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
        print(BANCS.INPARAM.BINDVARS)
        lv_d = urhk_dbSelectWithBind(lv_i)
        if(lv_d==0)then
        #{
                EQSRV.GLBDATA.drIntPcnt = cdouble(BANCS.OUTPARAM.drIntPcntPre) + cdouble(EQSRV.GLBDATA.drIntPcnt)
		print(EQSRV.GLBDATA.drIntPcnt)
        else
                EQSRV.GLBDATA.drIntPcnt = 0
        #}
        endif

	print(EQSRV.GLBDATA.drPenalInt)
	print(EQSRV.GLBDATA.drIntPcnt)
	###############

        if(cdouble(EQSRV.GLBDATA.migdatediff)<=0)then
                EQSRV.GLBDATA.migdatediff = -1 * cdouble(EQSRV.GLBDATA.migdatediff)
        endif
		print(EQSRV.GLBDATA.migdatediff)
        if(cdouble(EQSRV.GLBDATA.migdatediff)!=cdouble("0"))then
        #{
                print(EQSRV.GLBDATA.cClearBalance)
                print(EQSRV.GLBDATA.drIntPcnt)
                ##EQSRV.GLBDATA.upintAmt = cdouble(EQSRV.GLBDATA.cClearBalance)
		IF(EQSRV.GLBDATA.ChrgCnt >CINT("0"))THEN
			 EQSRV.GLBDATA.upintAmt = "0"
			 EQSRV.GLBDATA.ppintAmt = "0"
