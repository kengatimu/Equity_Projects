<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether INTERFACE Class exists else create it
	###########################################################################################
		
	sv_r = CLASSEXISTS("CUST","INTERFACE")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	
	CUST.INTERFACE.status = ""
	

	CUST.INTERFACE.sso_respCode = ""
	CUST.INTERFACE.sso_mesg = ""
	CUST.INTERFACE.sso_errorCode = ""
	CUST.INTERFACE.sso_errorDesc = ""
	
	sv_x = CUST.INTERFACE.respXMLMsg
	
	#--------------------------------------------------------------------------------------------------------
	# Fetching the status of the request
	#--------------------------------------------------------------------------------------------------------
	sv_y = "<HostTransaction>"
	sv_z = "</HostTransaction>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.ubusStuatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		sv_x = CUST.INTERFACE.ubusStuatus
		PRINT(sv_x)
		sv_y = "<Status>"
		sv_z = "</Status>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.status = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
			PRINT(CUST.INTERFACE.status)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.INTERFACE.status = ""
	#}
	ENDIF
	PRINT(CUST.INTERFACE.status)
	
	#--------------------------------------------------------------------------------------------------------
	# If Success the fetch other values from the response xml
	#--------------------------------------------------------------------------------------------------------
	IF(CUST.INTERFACE.status == "SUCCESS") THEN
	#{
		CUST.INTERFACE.sso_errorMsgFlg = "N"
		
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<SSOUserAddResponse>"
		sv_z = "</SSOUserAddResponse>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			
			sv_y = "<SSOUserAddRs>"
			sv_z = "</SSOUserAddRs>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<respCode>"
					sv_z = "</respCode>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.sso_respCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
						print(CUST.INTERFACE.sso_respCode)
					#}
					ENDIF
					
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<mesg>"
					sv_z = "</mesg>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.sso_mesg = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,100)
						print(CUST.INTERFACE.sso_mesg)
					#}
					ENDIF
					
				
			#}
			ENDIF
		#}
		ENDIF
		
		
		#}
	ELSE
		#{
		CUST.INTERFACE.sso_errorMsgFlg = "Y"
		IF(CUST.INTERFACE.status == "FAILURE") THEN
		#{
			sv_x = CUST.INTERFACE.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.INTERFACE.sso_errorCode = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,10)
				PRINT(CUST.INTERFACE.sso_errorCode)
			#}
			ENDIF
			IF(CUST.INTERFACE.sso_errorCode != "") THEN
			#{
				sv_x = CUST.INTERFACE.respXMLMsg
				sv_y = "<ErrorDesc>"
				sv_z = "</ErrorDesc>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.sso_errorDesc = MID$(MID$(sv_x, sv_b, (sv_e - sv_b)),0,120)
					PRINT(CUST.INTERFACE.sso_errorDesc)
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		IF((CUST.INTERFACE.sso_errorCode == "") AND (CUST.INTERFACE.sso_errorDesc == "")) THEN
		#{
			CUST.INTERFACE.sso_errorCode = "SYSERR"
			CUST.INTERFACE.sso_errorDesc = "Could not get response from server"
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.INTERFACE.sso_errorMsgFlg)
	
	PRINT(CUST.INTERFACE.sso_errorCode)
	PRINT(CUST.INTERFACE.sso_errorDesc)

	
	
	
	#TRACE OFF
END-->
