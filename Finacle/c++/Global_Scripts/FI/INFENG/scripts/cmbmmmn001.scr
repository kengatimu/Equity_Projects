#------------------------------------------------------------------------------------------------    
#    Name	     : cmbmmmn001.scr
#    Description     : The script is used Block/Unblock the solid.
#    Date            : 28-02-2013
#    Author          : Farhan
#    Input           : NA
#    Output	     : NA
#    Called Script   : NA
#    Calling Script  : NA
#    Menu Option     : CMBMM
#    Srl. No		Date			Author			Description.
#    ------		----------		-------			---------------
#    1.0		28-02-2013		Farhan			Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="83bf0a8ab45a6cddce70bb08c23038959c2f647a9cd04acf191eed84630f730e"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "MOBRMT") == 0) THEN
	#{
		CREATECLASS("CUST", "MOBRMT", 5)
	#}
	ENDIF
	
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.solId)
	PRINT(BANCS.INPUT.schmCode)
	PRINT(BANCS.INPUT.date)
	
	CUST.MOBRMT.funcCode = BANCS.INPUT.funcCode
	CUST.MOBRMT.Sol	  = BANCS.INPUT.solId
	CUST.MOBRMT.schmCode = BANCS.INPUT.schmCode
	CUST.MOBRMT.date   = BANCS.INPUT.date
	CUST.MOBRMT.errMsg = ""
	PRINT(CUST.MOBRMT.date)
	#---------------------------------------------------------------------------
	#	The following  step is to  validate SolID
	#---------------------------------------------------------------------------
	
	sv_u = urhk_B2k_valSolId(CUST.MOBRMT.Sol)
	print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_e = "Invalid solid  "
		sv_m = "solId"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#	The following  step is to  validate Scheme Code
	#---------------------------------------------------------------------------
	
	sv_s = "Count|SELECT COUNT(*) FROM TBAADM.GSP "
	sv_s = sv_s + "WHERE schm_code = ?SVAR "
	sv_s = sv_s + "AND del_flg = 'N'"
	sv_s = sv_s + "AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.MOBRMT.schmCode + "|"  + BANCS.STDIN.contextBankId
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d == 0)THEN
	#{
		PRINT(BANCS.OUTPARAM.Count)
		IF (CINT(BANCS.OUTPARAM.Count) == 0) THEN
		#{
			sv_e = "Invalid Scheme Code  "
			sv_m = "Scheme Code"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s = "schmType|SELECT schm_type FROM TBAADM.GSP "
	sv_s = sv_s + "WHERE schm_code = ?SVAR "
	sv_s = sv_s + "AND del_flg = 'N'"
	sv_s = sv_s + "AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.MOBRMT.schmCode + "|"  + BANCS.STDIN.contextBankId
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0)THEN
	#{
		PRINT(BANCS.OUTPARAM.schmType)
		IF (BANCS.OUTPARAM.schmType != "SBA") THEN
		#{
			sv_e = "Scheme Code should be under SBA Scheme type  "
			sv_m = "schmCode"
			sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	# The following step is to Validate Date
	#--------------------------------------------------------------------------
	
	sv_r = urhk_B2k_valDate(CUST.MOBRMT.date)
	IF (sv_r != 0) THEN
	#{
		sv_e = "Please enter Date"
		sv_m = "date_ui"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(BANCS.STDIN.BODDate)
	IF ((CUST.MOBRMT.date != left$(BANCS.STDIN.BODDate,10)) AND (CUST.MOBRMT.funcCode == "B")) THEN
	#{
		sv_e = "Date should be equal to BOD Date"
		sv_m = "date_ui"
		sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#Process Starting
	#---------------------------------------------------------------------------
	
	IF (CUST.MOBRMT.funcCode == "B") THEN
	#{
		sv_s = "Count|SELECT COUNT(*) FROM CUSTOM.C_MBM "
		sv_s = sv_s + "WHERE sol_id = ?SVAR "
		sv_s = sv_s + "AND schm_code = ?SVAR "
		sv_s = sv_s + "AND mbm_date = To_date(?SVAR ,'DD-MM-YYYY')"
		sv_s = sv_s + "AND mbm_status ='B'"
		sv_s = sv_s + "AND del_flg = 'N'"
		sv_s = sv_s + "AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.MOBRMT.Sol + "|" + CUST.MOBRMT.schmCode + "|" + CUST.MOBRMT.date + "|" + BANCS.STDIN.contextBankId
		PRINT(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF (sv_d == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.Count)
			IF (CINT(BANCS.OUTPARAM.Count) != 0) THEN
			#{
				sv_e = "This scheme is already blocked for this sol"
				sv_m = "schmCode"
				sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_s = "INSERT INTO CUSTOM.C_MBM VALUES("
				sv_s = sv_s + "?SVAR,"
				sv_s = sv_s + "?SVAR,"
				sv_s = sv_s + "to_date(?SVAR,'DD-MM-YYYY'),"
				sv_s = sv_s + "'B',"
				sv_s = sv_s + "?SVAR,"
				sv_s = sv_s + "SYSDATE,"
				sv_s = sv_s + "?SVAR,"
				sv_s = sv_s + "SYSDATE,"
				sv_s = sv_s + "'N',"
				sv_s = sv_s + "?SVAR)"
				BANCS.INPARAM.BINDVARS = CUST.MOBRMT.Sol + "|" + CUST.MOBRMT.schmCode + "|" + CUST.MOBRMT.date + "|"+ BANCS.STDIN.userId + "|"+ BANCS.STDIN.userId + "|"+ BANCS.STDIN.contextBankId
				print(sv_s)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				PRINT(sv_d)
				
				IF (sv_d == 0) THEN
				#{
					sv_d = urhk_dbSQLWithBind("COMMIT")
					
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
					sv_g = "RESULT_MSG| The scheme code  <b>" + CUST.MOBRMT.schmCode + "</b>" + " is blocked"
					sv_z = urhk_SetOrbOut(sv_g)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
					sv_g = "RESULT_MSG| INSERT into C_MBM failed"
					sv_z = urhk_SetOrbOut(sv_g)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.MOBRMT.funcCode == "U") THEN
	#{
		sv_s = "Count|SELECT count(*) FROM CUSTOM.C_MBM "
		sv_s = sv_s + "WHERE sol_id = ?SVAR "
		sv_s = sv_s + "AND schm_code = ?SVAR "
		sv_s = sv_s + "AND mbm_date = To_date(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + "AND mbm_status = 'B' "
		sv_s = sv_s + "AND del_flg = 'N' "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.MOBRMT.Sol + "|" + CUST.MOBRMT.schmCode + "|" + CUST.MOBRMT.date + "|"+BANCS.STDIN.contextBankId
		PRINT(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.Count)
			
			IF (CINT(BANCS.OUTPARAM.Count) != 0) THEN
			#{
				sv_s = "UPDATE CUSTOM.C_MBM SET mbm_status='U',del_flg='Y' "
				sv_s = sv_s + "WHERE sol_id = ?SVAR "
				sv_s = sv_s + "AND schm_code = ?SVAR "
				sv_s = sv_s + "AND mbm_date = to_date(?SVAR,'DD-MM-YYYY') "
				sv_s = sv_s + "AND mbm_status = 'B' "
				sv_s = sv_s + "AND del_flg = 'N' "
				sv_s = sv_s + "AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.MOBRMT.Sol + "|" + CUST.MOBRMT.schmCode + "|" + CUST.MOBRMT.date + "|"+BANCS.STDIN.contextBankId
				PRINT(sv_s)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					sv_d = urhk_dbSQLWithBind("COMMIT")
					
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
					sv_g = "RESULT_MSG| The <b>" + CUST.MOBRMT.schmCode + "</b>" + " is unblocked"
					sv_z = urhk_SetOrbOut(sv_g)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
					sv_g = "RESULT_MSG| UPDATE of C_MBM failed"
					sv_z = urhk_SetOrbOut(sv_g)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				#}
			ELSE
				#{
				
				#sv_e = "Date should be equal to BOD Date"
				sv_e = "This scheme is not yet blocked for this sol"
				sv_m = "SchmCode"
				sv_e = "Error_01|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		TRACE OFF
		EXITSCRIPT
		
END-->
