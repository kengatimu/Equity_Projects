<--start
trace on
        if(repexists("EQSRV")==0)then
        #{
                createrep("EQSRV")
        #}
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
        #{
                createclass("EQSRV","GLBDATA",5)
        #}
        endif
        EQSRV.GLBDATA.odAcctId = ""
        EQSRV.GLBDATA.OperativeAcctId = ""
        EQSRV.GLBDATA.sanLim = ""
        EQSRV.GLBDATA.disbTranId = ""
        EQSRV.GLBDATA.disbTranDate = ""
        EQSRV.GLBDATA.sanctDate = ""
        EQSRV.GLBDATA.expiryDate = ""
        EQSRV.GLBDATA.intTblCode = ""
        EQSRV.GLBDATA.acctCrncyCode = ""
        EQSRV.GLBDATA.repayFeq = ""
        EQSRV.GLBDATA.loanMode = ""
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
        #{
                print(MTT.InputDetails.Argument1)
                EQSRV.GLBDATA.odAcctId = MTT.InputDetails.Argument1
                EQSRV.GLBDATA.OperativeAcctId = MTT.InputDetails.Argument2
                EQSRV.GLBDATA.sanLim = MTT.InputDetails.Argument3
                EQSRV.GLBDATA.disbTranId = MTT.InputDetails.Argument4
                EQSRV.GLBDATA.disbTranDate = MTT.InputDetails.Argument5
                EQSRV.GLBDATA.sanctDate = MTT.InputDetails.Argument6
                EQSRV.GLBDATA.expiryDate = MTT.InputDetails.Argument7
                EQSRV.GLBDATA.intTblCode = MTT.InputDetails.Argument8
                EQSRV.GLBDATA.acctCrncyCode = MTT.InputDetails.Argument9
                EQSRV.GLBDATA.repayFeq = MTT.InputDetails.Argument10
                EQSRV.GLBDATA.loanMode = MTT.InputDetails.Argument11
                EQSRV.GLBDATA.disbSrlNum = MTT.InputDetails.Argument12
		EQSRV.GLBDATA.acctDrPrefPcnt = MTT.InputDetails.Argument13
        #}
        else
        #{
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                goto VAYU
        #}
        endif
        print(EQSRV.GLBDATA.odAcctId)
        print(EQSRV.GLBDATA.OperativeAcctId)
        print(EQSRV.GLBDATA.sanLim)
        print(EQSRV.GLBDATA.disbTranId)
        print(EQSRV.GLBDATA.disbTranDate)
        print(EQSRV.GLBDATA.sanctDate)
        print(EQSRV.GLBDATA.expiryDate)
        print(EQSRV.GLBDATA.intTblCode)
        print(EQSRV.GLBDATA.acctCrncyCode)
	print(EQSRV.GLBDATA.acctDrPrefPcnt)
        sv_q = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.OperativeAcctId)
        if(sv_q==0)then
        #{
                EQSRV.GLBDATA.OperAcid = BANCS.OUTPARAM.Acid
        #}
        else
        #{
                EQSRV.GLBDATA.OperAcid = ""
        #}
        endif
        sv_q = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.odAcctId)
        if(sv_q==0)then
        #{
                EQSRV.GLBDATA.odAcid = BANCS.OUTPARAM.Acid
        #}
        else
        #{
                EQSRV.GLBDATA.odAcid = ""
        #}
        endif
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.odAcctId)
        if(sv_u == 0)then
        #{
                EQSRV.GLBDATA.odsolid = BANCS.OUTPARAM.acctSolId
                print(BANCS.OUTPARAM.sanctionLimit)
                        EQSRV.GLBDATA.csanctionLimit = BANCS.OUTPARAM.sanctionLimit
                print(BANCS.OUTPARAM.cleanAdhocLimit)
                print(BANCS.OUTPARAM.drawingPower)
                print(BANCS.OUTPARAM.usedUnclearOverDACC)
                print(BANCS.OUTPARAM.FXClearBalance)
                print(BANCS.OUTPARAM.FxAvailableAmt)
                print(BANCS.OUTPARAM.AvailableAmt)
                print(BANCS.OUTPARAM.ClearBalance)
                        EQSRV.GLBDATA.cClearBalance = BANCS.OUTPARAM.ClearBalance
                print(BANCS.OUTPARAM.DACCLimit)
                print(BANCS.OUTPARAM.FxFFDAvailableAmt)
                print(BANCS.OUTPARAM.FFDAvailableAmt)
                print(BANCS.OUTPARAM.lienAmt)
                print(BANCS.OUTPARAM.FxEffAvailableAmt)
                print(BANCS.OUTPARAM.EffAvailableAmt)
                print(BANCS.OUTPARAM.systemGeneratedLimit)
                print(BANCS.OUTPARAM.SystemReservedAmt)
                print(BANCS.OUTPARAM.singleTranLimit)
                print(BANCS.OUTPARAM.cleanSingleTranLimit)
		print(BANCS.OUTPARAM.schmCode)
		EQSRV.GLBDATA.schmCcode = BANCS.OUTPARAM.schmCode
		print(EQSRV.GLBDATA.schmCcode)

        #}
        else
        #{
                EQSRV.GLBDATA.cClearBalance = ""
                EQSRV.GLBDATA.odsolid = ""
        #}
        endif
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.OperativeAcctId)
        if(sv_u == 0)then
        #{
                EQSRV.GLBDATA.opsolid = BANCS.OUTPARAM.acctSolId
        #}
        else
        #{
                EQSRV.GLBDATA.opsolid = ""
        #}
        endif
        if(EQSRV.GLBDATA.repayFeq=="D")then
                EQSRV.GLBDATA.addmnths = "0"
                EQSRV.GLBDATA.adddays = "14"
        endif
        if(EQSRV.GLBDATA.repayFeq=="M")then
        #{
                EQSRV.GLBDATA.addmnths = "1"
                EQSRV.GLBDATA.adddays = "0"
        #}
        endif
        if(EQSRV.GLBDATA.repayFeq=="W")then
        #{
                EQSRV.GLBDATA.addmnths = "0"
                EQSRV.GLBDATA.adddays = "7"
        #}
        endif
        if(EQSRV.GLBDATA.repayFeq=="B")then
        #{
                EQSRV.GLBDATA.addmnths = "0"
                EQSRV.GLBDATA.adddays = "14"
        #}
        endif
        if(EQSRV.GLBDATA.repayFeq=="H")then
        #{
                EQSRV.GLBDATA.addmnths = "6"
                EQSRV.GLBDATA.adddays = "0"
        #}
        endif
        if(EQSRV.GLBDATA.repayFeq=="Q")then
        #{
                EQSRV.GLBDATA.addmnths = "3"
                EQSRV.GLBDATA.adddays = "0"
        #}
        endif
        if(EQSRV.GLBDATA.repayFeq=="Y")then
        #{
                EQSRV.GLBDATA.addmnths = "12"
                EQSRV.GLBDATA.adddays = "0"
        #}
        endif
        print(EQSRV.GLBDATA.repayFeq)
        print(EQSRV.GLBDATA.addmnths)
        print(EQSRV.GLBDATA.adddays)
        EQSRV.GLBDATA.balDate = (EQSRV.GLBDATA.disbTranDate + "|" + EQSRV.GLBDATA.addmnths + "|" + EQSRV.GLBDATA.adddays)
        sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.balDate)
        if(sv_u != 0)then
        #{
                EQSRV.GLBDATA.nxtDmdDate = EQSRV.GLBDATA.disbTranDate
        #}
        else
        #{
                print(BANCS.OUTPARAM.MODIFIED_DATE)
                EQSRV.GLBDATA.nxtDmdDate = mid$(BANCS.OUTPARAM.MODIFIED_DATE,0,10)
        #}
        endif

        lv_i = " drIntPcnt | select nrml_int_pcnt from tbaadm.ivs where bank_id=?SVAR and int_tbl_code=?SVAR  and crncy_code=?SVAR and int_slab_dr_cr_flg='D' and int_tbl_ver_num in (select  max(int_tbl_ver_num) from tbaadm.icv where bank_id=?SVAR and int_tbl_code=?SVAR and crncy_code=?SVAR and entity_cre_flg='Y' and del_flg='N' and int_slab_dr_cr_flg='D' and int_slab_srl_num in (select max(int_slab_srl_num) from tbaadm.icv where bank_id=?SVAR and int_tbl_code=?SVAR and crncy_code=?SVAR and entity_cre_flg='Y' and del_flg='N' and int_slab_dr_cr_flg='D')) and entity_cre_flg='Y' and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId +"|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.intTblCode + "|" + EQSRV.GLBDATA.acctCrncyCode
        print(lv_i)
        print(BANCS.INPARAM.BINDVARS)
        lv_d = urhk_dbSelectWithBind(lv_i)
        if(lv_d==0)then
        #{
                EQSRV.GLBDATA.drIntPcnt = BANCS.OUTPARAM.drIntPcnt
		print(EQSRV.GLBDATA.drIntPcnt)
                EQSRV.GLBDATA.drIntPcnt = cdouble(EQSRV.GLBDATA.drIntPcnt) + cdouble(EQSRV.GLBDATA.acctDrPrefPcnt)
		print(EQSRV.GLBDATA.drIntPcnt)
        #}
        else
        #{
                EQSRV.GLBDATA.drIntPcnt = 10
        #}
        endif
        print(EQSRV.GLBDATA.drIntPcnt)
        BANCS.INPARAM.date1 = EQSRV.GLBDATA.expiryDate
        BANCS.INPARAM.date2 = EQSRV.GLBDATA.sanctDate
        sv_u = urhk_B2K_dateDiff("")
        print(sv_u)
        if(sv_u == 0 ) then
        #{
                BANCS.INPUT.migdatediff = BANCS.OUTPARAM.dateDiff
        #}
        else
        #{
                BANCS.INPUT.migdatediff = 365
        #}
        endif
        print(BANCS.INPUT.migdatediff)
        EQSRV.GLBDATA.numofMnths = cdouble(BANCS.INPUT.migdatediff) /30
        print(EQSRV.GLBDATA.numofMnths)
        lv_u = "numMonths,numofWeeks | select to_char(months_between(to_date(?SVAR,'DD-MM-RR'),to_date(?SVAR,'DD-MM-RR')),99),floor((to_date(?SVAR,'DD-MM-RR') - to_date(?SVAR,'DD-MM-RR'))/7)  from dual "
        BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.expiryDate + "|" + EQSRV.GLBDATA.sanctDate + "|" + EQSRV.GLBDATA.expiryDate + "|" + EQSRV.GLBDATA.sanctDate
        print(lv_u)
        print(BANCS.INPARAM.BINDVARS)
        lv_o = urhk_dbSelectWithBind(lv_u)
        if(lv_o==0)then
        #{
                BANCS.INPUT.numofMnths = BANCS.OUTPARAM.numMonths
                EQSRV.GLBDATA.numofWeeks = BANCS.OUTPARAM.numofWeeks
                EQSRV.GLBDATA.numofMnths = BANCS.INPUT.numofMnths
                print(BANCS.INPUT.numofMnths)
                print(EQSRV.GLBDATA.numofWeeks)
                print(EQSRV.GLBDATA.numofMnths)
        #}
        endif
        print(EQSRV.GLBDATA.sanLim)
        print(EQSRV.GLBDATA.cClearBalance)
        if(cdouble(EQSRV.GLBDATA.cClearBalance)<0)then
        #{
                EQSRV.GLBDATA.cClearBalance = -1 * cdouble(EQSRV.GLBDATA.cClearBalance)
        #}
        else
        #{
                EQSRV.GLBDATA.cClearBalance = "0"
        #}
        endif
        print(EQSRV.GLBDATA.sanLim)
        #+++++++++++++++++++++++++++++++++++++++++++++++++
#Derive IntPcnt & Numof Emi
        EQSRV.GLBDATA.fIntPcnt = cdouble(EQSRV.GLBDATA.drIntPcnt)/100
        print(EQSRV.GLBDATA.fIntPcnt)
#Monthly
        if(EQSRV.GLBDATA.repayFeq=="M")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/12
                EQSRV.GLBDATA.emiPyCnt = BANCS.INPUT.numofMnths
        #}
        endif
#Quaterly
        if(EQSRV.GLBDATA.repayFeq=="Q")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/3
                EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths)/3
        #}
        endif
#Half-Yearly
        if(EQSRV.GLBDATA.repayFeq=="H")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/6
                EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths)/6
        #}
        endif
#Yearly
        if(EQSRV.GLBDATA.repayFeq=="Y")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/12
                EQSRV.GLBDATA.emiPyCnt =  cdouble(BANCS.INPUT.numofMnths)/12
        #}
        endif
#Weekly
        if(EQSRV.GLBDATA.repayFeq=="W")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/52
                EQSRV.GLBDATA.emiPyCnt = EQSRV.GLBDATA.numofWeeks
        #}
        endif
#BiWeekly
        if(EQSRV.GLBDATA.repayFeq=="B")then
        #{
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/26
                EQSRV.GLBDATA.emiPyCnt = cdouble(BANCS.INPUT.numofMnths) * 2
        #}
        endif
#Daily
        if(EQSRV.GLBDATA.repayFeq=="D")then
                EQSRV.GLBDATA.fiIntPcnt = cdouble(EQSRV.GLBDATA.fIntPcnt)/26
                EQSRV.GLBDATA.emiPyCnt = cdouble("1")
        endif
        if(cdouble(EQSRV.GLBDATA.emiPyCnt)<=0)then
        #{
                EQSRV.GLBDATA.emiPyCnt = cdouble("1")
        #}
        endif
        print(EQSRV.GLBDATA.fiIntPcnt)
        print(EQSRV.GLBDATA.emiPyCnt)

        lv_p = "pmtamt | select to_char(custom.fn_pmt_val(?NVAR,?NVAR,?NVAR,0),999999999999999.99) as pmtamt from dual "
        BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.fiIntPcnt + "|" + EQSRV.GLBDATA.emiPyCnt + "|" +  EQSRV.GLBDATA.sanLim
        print(lv_p)
        print(BANCS.INPARAM.BINDVARS)
        lv_o = urhk_dbSelectWithBind(lv_p)
        if(lv_o==0)then
        #{
                EQSRV.GLBDATA.pmtamt = BANCS.OUTPARAM.pmtamt
                if(cdouble(EQSRV.GLBDATA.pmtamt)<=0)then
                #{
                        EQSRV.GLBDATA.pmtamt = -1 * cdouble(EQSRV.GLBDATA.pmtamt)
                #}
                endif
        #}
        else
        #{
                EQSRV.GLBDATA.pmtamt = 0
        #}
        endif
        print(EQSRV.GLBDATA.fiIntPcnt)
        print(cint(EQSRV.GLBDATA.fiIntPcnt))
        print(cdouble(EQSRV.GLBDATA.fiIntPcnt))
        EQSRV.GLBDATA.IntAmt = cdouble(EQSRV.GLBDATA.sanLim) * cdouble(EQSRV.GLBDATA.fiIntPcnt)
        print(EQSRV.GLBDATA.IntAmt)
        EQSRV.GLBDATA.IntAmt = FORMAT$(cdouble(EQSRV.GLBDATA.IntAmt),"%.2f")
        print(EQSRV.GLBDATA.IntAmt)
        EQSRV.GLBDATA.PrinAmt = cdouble(EQSRV.GLBDATA.pmtamt) - cdouble(EQSRV.GLBDATA.IntAmt)
        print(EQSRV.GLBDATA.PrinAmt)
        if(cdouble(EQSRV.GLBDATA.PrinAmt)<0)then
        #{
                EQSRV.GLBDATA.PrinAmt = -1 * cdouble(EQSRV.GLBDATA.PrinAmt)
        #}
        endif
        EQSRV.GLBDATA.PrinAmt = FORMAT$(cdouble(EQSRV.GLBDATA.PrinAmt),"%.2f")
        print(EQSRV.GLBDATA.PrinAmt)

	IF(EQSRV.GLBDATA.schmCcode == "ODFDR") THEN
        lv_d = "mxSchdlNum | select max(schl_number)+1 from custom.odfdr_schl_tbl where bank_id=?SVAR "
        lv_d = lv_d + " and od_acct_id=?SVAR and od_acid=?SVAR "
        lv_d = lv_d + " and entity_cre_flg='Y' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.odAcid
        print(lv_d)
        print(BANCS.INPARAM.BINDVARS)
        lv_g = urhk_dbSelectWithBind(lv_d)
        if(lv_g==0)then
        #{
                EQSRV.GLBDATA.mxSchdlNum = BANCS.OUTPARAM.mxSchdlNum
		if(EQSRV.GLBDATA.mxSchdlNum == "") then
			EQSRV.GLBDATA.mxSchdlNum = 1
		endif	
        #}
        else
        #{
                EQSRV.GLBDATA.mxSchdlNum = 1
        #}
        endif
	ENDIF
        print(EQSRV.GLBDATA.mxSchdlNum)

        lv_e = " insert into custom.odfdr_schl_tbl (bank_id,DISB_SRL_NUM,od_acct_id,od_acid,od_sol_id,op_acct_id,op_acid,op_sol_id,od_disb_amt,od_disb_tran_date,schl_number,schl_date,number_of_payments,emi_amt,emi_int_amt,emi_principal_amt,next_dmd_date,rcre_user_id,rcre_time,lchg_user_id,lchg_time,entity_cre_flg,del_flg,free_text1,free_text2,free_text3,free_text4,free_text5,free_text6) "
        lv_e = lv_e + "  values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?NVAR,to_date(?SVAR,'DD-MM-RR'),?NVAR,to_date(?SVAR,'DD-MM-RR'),?NVAR,?NVAR,?NVAR,?NVAR,to_date(?SVAR,'DD-MM-RR'),?SVAR,sysdate,?SVAR,sysdate,'Y','N',null,null,null,null,null,?SVAR) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.disbSrlNum + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.odAcid + "|" + EQSRV.GLBDATA.odsolid + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.OperAcid + "|" + EQSRV.GLBDATA.odsolid + "|" + EQSRV.GLBDATA.sanLim + "|" + EQSRV.GLBDATA.disbTranDate + "|" + EQSRV.GLBDATA.mxSchdlNum + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQSRV.GLBDATA.emiPyCnt + "|" + EQSRV.GLBDATA.pmtamt + "|" + EQSRV.GLBDATA.IntAmt + "|" + EQSRV.GLBDATA.PrinAmt + "|" + EQSRV.GLBDATA.nxtDmdDate + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.repayFeq
        print(lv_e)
        print(BANCS.INPARAM.BINDVARS)
        lv_i = urhk_dbSqlWithBind(lv_e)
        if(lv_i==0)then
        #{
                lv_d = "update custom.odfdr_disb_tbl set is_resh_yn='Y',resh_date=to_date(?SVAR,'DD-MM-RR'),lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and od_acct_id=?SVAR and op_acct_id=?SVAR and od_disb_tran_date=to_date(?SVAR,'DD-MM-RR') and free_text1=?SVAR "
                BANCS.INPARAM.BINDVARS =  mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.disbTranDate +"|" + EQSRV.GLBDATA.mxSchdlNum
                print(lv_d)
                print(BANCS.INPARAM.BINDVARS)
                lv_i = urhk_dbSqlWithBind(lv_d)
                print(lv_i)
                lv_i = urhk_dbSqlWithBind("commit")
                print(lv_i)
                sv_s = "nohup babx4061 $B2K_SESSION_ID  odfdrladgen_wbmyhq.scr " + EQSRV.GLBDATA.odAcctId + " " + EQSRV.GLBDATA.OperativeAcctId + " " + EQSRV.GLBDATA.odAcid + " " +EQSRV.GLBDATA.odsolid+ " " +EQSRV.GLBDATA.opsolid + " "+ EQSRV.GLBDATA.OperAcid + " " + EQSRV.GLBDATA.repayFeq + " " + EQSRV.GLBDATA.sanLim + " " + EQSRV.GLBDATA.drIntPcnt + " " + EQSRV.GLBDATA.expiryDate + " " +EQSRV.GLBDATA.sanctDate+ " " + EQSRV.GLBDATA.loanMode+ " " + EQSRV.GLBDATA.disbSrlNum + " @s &"
                sv_r = system(sv_s)
                print(sv_r)
        #}
        else
        #{
                lv_d = "update custom.odfdr_disb_tbl set is_resh_yn='N',resh_date=null,lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and od_acct_id=?SVAR and op_acct_id=?SVAR and od_disb_tran_date=to_date(?SVAR,'DD-MM-RR') and free_text1=?SVAR "
                BANCS.INPARAM.BINDVARS =  BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + EQSRV.GLBDATA.OperativeAcctId + "|" + EQSRV.GLBDATA.disbTranDate + "|" + EQSRV.GLBDATA.mxSchdlNum
                print(lv_d)
                print(BANCS.INPARAM.BINDVARS)
                lv_i = urhk_dbSqlWithBind(lv_d)
                print(lv_i)
                lv_i = urhk_dbSqlWithBind("commit")
                print(lv_i)
        #}
        endif

trace off
end-->
