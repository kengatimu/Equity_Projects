<--start
trace on
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF	
	sv_r = CLASSEXISTS("CUST", "CLS")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "CLS", 5)
	#}
	ENDIF
	print(CUST.CLS.lAcid)
	print(CUST.CLS.acid)
        lv_a= urhk_B2k_AcidToForacid(CUST.CLS.lAcid)
        if(lv_a==0)then
        #{
                CUST.CLS.TDAforacid = BANCS.OUTPARAM.Foracid
        #}
        else
        #{
                CUST.CLS.TDAforacid = ""
		exitscript
        #}
        endif
	print(CUST.CLS.TDAforacid)
	sv_a = "collSrlNum,acctId|select a.SECU_SRL_NUM,foracid from tbaadm.scmt a,tbaadm.gam b,tbaadm.sdr c where a.lien_acid=b.acid and a.bank_id= ?SVAR and a.bank_id=b.bank_id "
	sv_a = sv_a + " and acct_cls_flg='N' and a.del_flg='N' and b.acid=c.lien_acid and b.bank_id = c.bank_id and b.lien_amt ='0' and a.lien_acid = ?SVAR and c.acid = ?SVAR "

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CLS.lAcid + "|" + CUST.CLS.acid
	lv_j = urhk_dbSelectWithBind(sv_a)
	if(lv_j == 0) then
	#{
		CUST.CLS.collSerial = BANCS.OUTPARAM.collSrlNum
		print(CUST.CLS.collSerial)
	#}
	else
	#{
		CUST.CLS.collSerial = ""
		exitscript	
	#}
	endif
	sv_u = urhk_SetUrhkInp("coltrlCrit.coltrlLinkage.code|S")
	sv_u = urhk_SetUrhkInp("coltrlCrit.coltrlType.code|D")
	sv_u = urhk_SetUrhkInp("coltrlCrit.coltrlSrlNum|" + CUST.CLS.collSerial)

	sv_u = urhk_ExecSrv("SRV_FetchTermDepositsDtlForModify|retain_all_output = Y|same_user_verify = Y")
	PRINT(sv_u)

        if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
        #{
                print(BANCS.OUTPARAM.successOrFailure)
                sv_s = BANCS.OUTPARAM.successOrFailure
                        if((BANCS.OUTPARAM.successOrFailure=="F") or (sv_u!=0))then
                        #{
                                callscriptifexist("ebsrvHandler.scr")
                                if(fieldexists(CUST.CLS.SrvError)==1)then
                                #{
                                        CUST.CLS.srvMsg    = CUST.CLS.SrvError
                                        CUST.CLS.srvErrorCode = "E0012"
                                        CUST.CLS.srvSF     = "F"
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("Message|" + CUST.CLS.srvMsg )
                                        goto EOS
                                #}
                                endif
                        #}
                        endif
        #}
        else
        #{
                sv_s = "X"
        #}
        endif

	IF (sv_u != 0 ) THEN
	#{
                    callscriptifexist("ebsrvHandler.scr")
                    if(fieldexists(CUST.CLS.SrvError)==1)then
                    #{
                                        CUST.CLS.srvMsg    = CUST.CLS.SrvError
                                        CUST.CLS.srvErrorCode = "E0012"
                                        CUST.CLS.srvSF     = "F"
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("Message|" + CUST.CLS.srvMsg )
                    #}
                    endif
                    exitscript
	#}
	ENDIF

	sv_u = urhk_CopyOutToIn("")
	PRINT(sv_u)

	sv_u = urhk_SetUrhkInp("termDepositsDet.withdrawFlg|Y")
	sv_u = urhk_SetUrhkInp("termDepositsDet.withdrawReasonCode.refCode|VWD01")
	sv_u = urhk_SetUrhkInp("coltrlGenDtls.coltrlCode.code|FDR")
	sv_u = urhk_SetUrhkInp("coltrlGenDtls.coltrlType|D")
	sv_u = urhk_SetUrhkInp("termDepositsDet.withdrawDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("termDepositsDet.valueInd|M")
	sv_u = urhk_SetUrhkInp("termDepositsDet.depositAcctId.foracid|" + CUST.CLS.TDAforacid)

	sv_u = urhk_ExecSrv("SRV_WithdrawTermDepositsDtl|retain_all_output = Y|same_user_verify = Y")
	PRINT(sv_u)

	IF (sv_u != 0 ) THEN
	#{
                    callscriptifexist("ebsrvHandler.scr")
                    if(fieldexists(CUST.CLS.SrvError)==1)then
                    #{
                                        CUST.CLS.srvMsg    = CUST.CLS.SrvError
                                        CUST.CLS.srvErrorCode = "E0012"
                                        CUST.CLS.srvSF     = "F"
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("Message|" + CUST.CLS.srvMsg )
                    #}
                    endif
                    exitscript
	#}
	ENDIF

	sv_u = urhk_SetUrhkInp("coltrlCrit.coltrlLinkage.code|S")
	sv_u = urhk_SetUrhkInp("coltrlCrit.coltrlType.code|D")
	sv_u = urhk_SetUrhkInp("coltrlCrit.coltrlSrlNum|" + CUST.CLS.collSerial)

	sv_u = urhk_ExecSrv("SRV_FetchTermDepositsDtlForVerify|retain_all_output = Y|same_user_verify = Y")
	PRINT(sv_u)

	IF (sv_u != 0 ) THEN
	#{
                    callscriptifexist("ebsrvHandler.scr")
                    if(fieldexists(CUST.CLS.SrvError)==1)then
                    #{
                                        CUST.CLS.srvMsg    = CUST.CLS.SrvError
                                        CUST.CLS.srvErrorCode = "E0012"
                                        CUST.CLS.srvSF     = "F"
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("Message|" + CUST.CLS.srvMsg )
                    #}
                    endif
                    exitscript
	#}
	ENDIF

	sv_u = urhk_CopyOutToIn("")
	PRINT(sv_u)

	sv_u = urhk_SetUrhkInp("termDepositsDet.withdrawFlg|Y")
	sv_u = urhk_SetUrhkInp("termDepositsDet.withdrawReasonCode.refCode|VWD01")

	sv_u = urhk_ExecSrv("SRV_VerifyTermDepositsDtl|retain_all_output = Y|same_user_verify = Y")
	PRINT(sv_u)

	IF (sv_u != 0 ) THEN
	#{
                    callscriptifexist("ebsrvHandler.scr")
                    if(fieldexists(CUST.CLS.SrvError)==1)then
                    #{
                                        CUST.CLS.srvMsg    = CUST.CLS.SrvError
                                        CUST.CLS.srvErrorCode = "E0012"
                                        CUST.CLS.srvSF     = "F"
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("Message|" + CUST.CLS.srvMsg )
                    #}
                    endif
                    exitscript
	#}
	ENDIF

#trace off
end-->