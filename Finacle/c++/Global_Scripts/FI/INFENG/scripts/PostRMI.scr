#=============================================================================
# The below section checks if the account is a DD scheme type or the tran code
# is 12/16 and if so, then checks it there is a corresponding issue record
# available. If available, then populates the issue bank/branch, issue date
# and the payee name.
# The query users the dd num, scheme code of the dd account, dd crncy and
# dd amount to get the original issue record.

#sv_r=urhk_B2k_PrintRepos("BANCS")

#sv_a = MID$ (BANCS.INPUT.InputString, 61, 3)
###print(sv_a)
sv_c = BANCS.INPUT.InstNum
print(sv_c)
sv_d = CDOUBLE(BANCS.INPUT.InstAmount)
sv_d = format$(sv_d,"%17.02f")
print(sv_c)
print(sv_d)

    sv_x = 0
    sv_p = ""
    sv_z = BANCS.INPUT.TranCode
    sv_t = rtrim(ltrim(sv_z))
    print(sv_t)
        sv_n = BANCS.INPUT.AcctId
        sv_a = urhk_getAcctDetailsInRepository(sv_n)
        if (sv_a != 0)then
            sv_p = ""
            sv_l = ""
            sv_m = ""
            print(sv_p)
            print(sv_l)
            print(sv_m)
        else
            sv_p = BANCS.OUTPARAM.schmType
            sv_l = BANCS.OUTPARAM.schmCode
            sv_m = BANCS.OUTPARAM.acctCrncyCode
            print(sv_p)
            print(sv_l)
            print(sv_m)
        endif
print(sv_t)
    if ((sv_t == "12") or (sv_t == "16") or (sv_p == "DDA")) then
        sv_q = "sv_x|select count(*) from dst where dd_num = ?SVAR"
        sv_q = sv_q + " and  dd_crncy_code = ?SVAR"
        sv_q = sv_q + " and schm_code = ?SVAR"
        sv_q = sv_q + " and dd_amt = ?SVAR"
	sv_q = sv_q + " and BANK_ID = ?SVAR "
	sv_q = sv_q + " and dd_status = 'U'"
        print(sv_q)
        
		BANCS.INPARAM.BINDVARS = sv_c + "|" + sv_m + "|" + sv_l + "|" + sv_d + "|" + BANCS.STDIN.contextBankId
		sv_r = urhk_dbSelectWithBind(sv_q)
        sv_x = BANCS.OUTPARAM.sv_x
        print(sv_x)
        if (sv_x == 1) then
            sv_q = "issue_date,issu_br_code,issu_bank_code,payee_name|select TO_CHAR(issue_date,'D
D-MM-YYYY HH24:MI:SS'),"
            sv_q = sv_q + "issu_br_code,issu_bank_code , payee_name"
            sv_q = sv_q + " from dst where dd_num = ?SVAR"
			sv_q = sv_q + " and  dd_crncy_code = ?SVAR"
			sv_q = sv_q + " and schm_code = ?SVAR"
            sv_q = sv_q + " and dd_amt = ?SVAR"
			sv_q = sv_q + " and BANK_ID = ?SVAR "
            print(sv_q)
            
			BANCS.INPARAM.BINDVARS = sv_c + "|" + sv_m + "|" + sv_l + "|" + sv_d + "|" + BANCS.STDIN.contextBankId
			sv_r = urhk_dbSelectWithBind(sv_q)
            BANCS.OUTPUT.InstDate = BANCS.OUTPARAM.issue_date
            BANCS.OUTPUT.IssBranchCode = BANCS.OUTPARAM.issu_br_code
            BANCS.OUTPUT.IssBankCode = BANCS.OUTPARAM.issu_bank_code
            BANCS.OUTPUT.PayeeName = mid$(BANCS.OUTPARAM.payee_name,0,50)
        else
            BANCS.OUTPUT.InstDate = ""
            BANCS.OUTPUT.IssBranchCode = ""
            BANCS.OUTPUT.IssBankCode = ""
            BANCS.OUTPUT.PayeeName = ""
        endif
