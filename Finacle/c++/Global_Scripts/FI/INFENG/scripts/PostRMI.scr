#=============================================================================
#The below section checks if the sol_id of system derived AcctId is not same as
# the MySolId i.e context SolId then this script will chngae the output AcctId
# as null and the system will upload the details with Account Id as null.
# Basically this script can be used to override the a/c derived by system
==============================================================================
<--start
#trace on
        sv_n = BANCS.INPUT.AcctId
        sv_c = BANCS.STDIN.mySolId
		if (sv_n != "") then
        	sv_a = urhk_getAcctDetailsInRepository(sv_n)
			if (sv_a != 0) then
			sv_t = ""
			else
			sv_t = BANCS.OUTPARAM.acctSolId
			endif
			if (STRICMP(sv_c,sv_t) ==0 ) then
			   BANCS.OUTPUT.RemarksStr = "Account SolId and My SolId not same so upload with null a/c"
			   BANCS.OUTPUT.AcctId = ""
			endif
		endif
BANCS.OUTPUT.successOrFailure = "S"
#added for free text fields as output
	sv_c = BANCS.INPUT.AcctId
	print(sv_c)
	BANCS.OUTPUT.FreeText1 = sv_c
	BANCS.OUTPUT.FreeText2 = "freetext2"
	BANCS.OUTPUT.FreeText3 = "freetext3"
exitscript
end-->
#===============================================================================
# The below sections is added to check that if the ZoneSolId passed from sources
# to script is not matching with the SolId we are getting through drawee sort code
# in script then we can send back the ZoneSolId as the SolId which we got from
# drawee sort code in script.
# this will solve the banks problem that the instrument is not getting uploaded in
# the sol according to the sort code.



<--start
#trace on
    sv_r=urhk_B2k_PrintRepos("BANCS")
    sv_c = BANCS.INPUT.TranCode
    sv_b = trim(BANCS.INPUT.InstNum)
    sv_b = ltrim(sv_b,'0')
    sv_s = BANCS.INPUT.ZoneSolId
    print(sv_s)

#to get the sol_id based on drawee sort code present in the upload file.

    sv_i = BANCS.INPUT.InputString
    sv_l = mid$(sv_i,9,3)
    print(sv_l)
    sv_m = mid$(sv_i,12,3)
    print(sv_m)
    sv_n = mid$(sv_i,15,3)
    print(sv_n)

    sv_q = " drawee_sol_id|select sol_id from sol where micr_centre_code = ?SVAR "
    sv_q = sv_q + " and micr_bank_code = ?SVAR and micr_branch_code = ?SVAR"
	sv_q = sv_q + " and BANK_ID = ?SVAR "
    print(sv_q)
    
	BANCS.INPARAM.BINDVARS = sv_l + "|" + sv_m + "|" + sv_n + "|" + BANCS.STDIN.contextBankId
	sv_r = urhk_dbSelectWithBind(sv_q)
    print(sv_r)
    sv_z = BANCS.OUTPARAM.drawee_sol_id
    print(sv_z)

#_________________________________________________________

    if ( sv_s == sv_z ) then
#           Put all the business logic in it and pass back the ZoneSolId back to source for
#           further processing.

            BANCS.OUTPUT.ZoneSolId = sv_z

    else
#           send back the ZoneSolId based on the drawee sort code to source and other logic like
#           account number as NULL.
            BANCS.OUTPUT.ZoneSolId = sv_z
            BANCS.OUTPUT.AcctId = ""
    endif
    BANCS.OUTPUT.SuccessOrFailure = 'S'

#added for free text fields as output
	sv_c = BANCS.INPUT.AcctId
	BANCS.OUTPUT.FreeText1 = sv_c
	BANCS.OUTPUT.FreeText2 = "freetext2"
	BANCS.OUTPUT.FreeText3 = "freetext3"
exitscript
end-->
