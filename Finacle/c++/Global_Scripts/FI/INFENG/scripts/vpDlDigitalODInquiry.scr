                print(BANCS.OUTPARAM.FXClearBalance)
                print(BANCS.OUTPARAM.FxAvailableAmt)
                print(BANCS.OUTPARAM.AvailableAmt)
                print(BANCS.OUTPARAM.ClearBalance)
                        EQSRV.GLBDATA.cClearBalance = BANCS.OUTPARAM.ClearBalance
                EQSRV.GLBDATA.cClearBalance1 = BANCS.OUTPARAM.ClearBalance
                print(EQSRV.GLBDATA.cClearBalance1)
                print(BANCS.OUTPARAM.DACCLimit)
                print(BANCS.OUTPARAM.FxFFDAvailableAmt)
                print(BANCS.OUTPARAM.FFDAvailableAmt)
                print(BANCS.OUTPARAM.lienAmt)
                print(BANCS.OUTPARAM.FxEffAvailableAmt)
                print(BANCS.OUTPARAM.EffAvailableAmt)
                print(BANCS.OUTPARAM.systemGeneratedLimit)
                print(BANCS.OUTPARAM.SystemReservedAmt)
                print(BANCS.OUTPARAM.singleTranLimit)
                print(BANCS.OUTPARAM.cleanSingleTranLimit)
                EBSRV.GLBDATA.odsolid = BANCS.OUTPARAM.acctSolId
                print(EBSRV.GLBDATA.odsolid)
                EBSRV.GLBDATA.OdAcctId=EQSRV.GLBDATA.odAcctId
                print(EBSRV.GLBDATA.OdAcctId)
                EBSRV.GLBDATA.odSchmCode = BANCS.OUTPARAM.schmCode
                EBSRV.GLBDATA.odcrncyCdoe = BANCS.OUTPARAM.acctCrncyCode
	#}
	else
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Invalid Account")
                exitscript
	#}
	endif
	print(EQSRV.GLBDATA.EventType)
	if((EBSRV.GLBDATA.odSchmCode=="DL002")and(EQSRV.GLBDATA.EventType=="INTRUN"))then
	#{
		lv_j = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.odAcctId)
		if(lv_j == 0) then
			EBSRV.GLBDATA.digitOdAcid = BANCS.OUTPARAM.Acid
		else
			EBSRV.GLBDATA.digitOdAcid = ""
		endif
		callscriptifexist("vpDlDigitalOdIntCollSel.scr")
		##callscriptifexist("test_vpDlDigitalOdIntCollSel.scr")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                sv_u = urhk_SetOrbOut("Message|Interest Process Invoked Successfully for Digital Overdraft")
                exitscript
	#}
	endif
        lv_t = " odDisbAmt,odDisbDate,SchdlNum,numOfPay,EmiAmt,EmiIntAmt,EmiPrinAmt,odAcid,opAcid | "
        lv_t = lv_t + " select od_disb_amt,od_disb_tran_date,schl_number,number_of_payments,"
        lv_t = lv_t + " emi_amt,emi_int_amt,emi_principal_amt,od_acid,op_acid "
        lv_t = lv_t + " from custom.dlla_schl_tbl "
#delflg should be Y
        lv_t = lv_t + " where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='Y' "
        lv_t = lv_t + " and od_acct_id=?SVAR "
        lv_t = lv_t + " and schl_number in (select max(schl_number) from custom.dlla_schl_tbl "
        lv_t = lv_t + " where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='Y' "
        lv_t = lv_t + " and od_acct_id=?SVAR) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId
        print(BANCS.INPARAM.BINDVARS)
        print(lv_t)
        lv_y = urhk_dbSelectWithBind(lv_t)
        print(lv_y)
        if(lv_y==0)then
	#{
                EQSRV.GLBDATA.odDisbAmt = BANCS.OUTPARAM.odDisbAmt
                EQSRV.GLBDATA.odDisbDate = BANCS.OUTPARAM.odDisbDate
                EQSRV.GLBDATA.SchdlNum = BANCS.OUTPARAM.SchdlNum
                EQSRV.GLBDATA.numOfPay = BANCS.OUTPARAM.numOfPay
                EQSRV.GLBDATA.EmiAmt = BANCS.OUTPARAM.EmiAmt
                EQSRV.GLBDATA.EmiIntAmt = BANCS.OUTPARAM.EmiIntAmt
                EQSRV.GLBDATA.EmiPrinAmt = BANCS.OUTPARAM.EmiPrinAmt
                EQSRV.GLBDATA.odAcid = BANCS.OUTPARAM.odAcid
                EQSRV.GLBDATA.opAcid = BANCS.OUTPARAM.opAcid
	#}
        else
	#{
                EQSRV.GLBDATA.odDisbAmt = 0
                EQSRV.GLBDATA.odDisbDate = ""
                EQSRV.GLBDATA.SchdlNum = 0
                EQSRV.GLBDATA.numOfPay = 0
                EQSRV.GLBDATA.EmiAmt = 0
                EQSRV.GLBDATA.EmiIntAmt = 0
                EQSRV.GLBDATA.EmiPrinAmt = 0
                EQSRV.GLBDATA.odAcid = ""
                EQSRV.GLBDATA.opAcid = ""
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("ErrorCode|E9999")
		sv_u = urhk_SetOrbOut("Message|Loan Schedule Not Exists ,Schedule Creation was Failed at Loan Creation Process")
		goto SIFNO
	#}
        endif
	lv_h = " intExecCnt | select count(*) from custom.dlla_dmd_tbl where bank_id=?SVAR and od_acid =?SVAR and entity_cre_flg='Y' and del_flg='N' and flow_id='INDEM' and free_text_5 like '%Int.Coll Executed%' and dmd_amt>0"
	print(lv_h)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSelectWithBind(lv_h)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.intExecCnt = BANCS.OUTPARAM.intExecCnt
	#}
        else
	#{
                EQSRV.GLBDATA.intExecCnt = 0
	#}
        endif
	lv_h = " intExectotCnt | select count(*) from custom.dlla_dmd_tbl where bank_id=?SVAR and od_acid =?SVAR and entity_cre_flg='Y' and del_flg='N' and flow_id='INDEM' and dmd_amt>0" 
	print(lv_h)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSelectWithBind(lv_h)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.intExectotCnt = BANCS.OUTPARAM.intExectotCnt
	#}
        else
	#{
                EQSRV.GLBDATA.intExectotCnt = 0
	#}
        endif
	print(EQSRV.GLBDATA.intExecCnt)
	print(EQSRV.GLBDATA.intExectotCnt)
	if(cdouble(EQSRV.GLBDATA.intExecCnt)==cdouble(EQSRV.GLBDATA.intExectotCnt))then
	#{
               	EQSRV.GLBDATA.InterestRunDate = "Y" 
	else
               	EQSRV.GLBDATA.InterestRunDate = "N" 
	#}
	endif
        lv_g = "cRepayAmt | select sum(tran_amt) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and pstd_flg='Y' and part_tran_type='C' and tran_date <= (select db_stat_date from tbaadm.gct where bank_id=?SVAR ) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +EQSRV.GLBDATA.odAcid  + "|" + BANCS.STDIN.contextBankId
        lv_r = urhk_dbSelectWithBind(lv_g)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.cRepayAmt = BANCS.OUTPARAM.cRepayAmt
	#}
        else
	#{
                EQSRV.GLBDATA.cRepayAmt = 0
	#}
        endif
        lv_g = "cDrAmt | select sum(tran_amt) from tbaadm.dctd_acli where bank_id=?SVAR and acid=?SVAR and pstd_flg='Y' and part_tran_type='D' and tran_date <= (select db_stat_date from tbaadm.gct where bank_id=?SVAR ) "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +EQSRV.GLBDATA.odAcid  + "|" + BANCS.STDIN.contextBankId
        lv_r = urhk_dbSelectWithBind(lv_g)
        if(lv_r==0)then
	#{
                EQSRV.GLBDATA.cDrAmt = BANCS.OUTPARAM.cDrAmt
	#}
        else
	#{
                EQSRV.GLBDATA.cDrAmt = 0
	#}
        endif
        lv_s = "lSanLim,lSanDate,lExpDate | select sanct_lim,lim_sanct_date,lim_exp_Date from tbaadm.lht where bank_id=?SVAR and acid=(select acid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR) and entity_cre_flg='Y' and del_flg='N' and status='A' and serial_num in (select max(serial_num)  from tbaadm.lht where bank_id=?SVAR and acid=(select acid from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR) and entity_cre_flg='Y' and del_flg='N' and status='A') "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcctId
        print(lv_s)
        print(BANCS.INPARAM.BINDVARS)
        lv_r = urhk_dbSelectWithBind(lv_s)
        if(lv_r==0)then
        #{
                EQSRV.GLBDATA.lSanLim = BANCS.OUTPARAM.lSanLim
                EQSRV.GLBDATA.lSanDate = BANCS.OUTPARAM.lSanDate
                EQSRV.GLBDATA.lExpDate = BANCS.OUTPARAM.lExpDate
        #}
        else
        #{
                EQSRV.GLBDATA.lSanLim = ""
                EQSRV.GLBDATA.lSanDate = ""
                EQSRV.GLBDATA.lExpDate = ""
        #}
        endif
        print(EQSRV.GLBDATA.lSanLim)
        print(EQSRV.GLBDATA.lSanDate)
        print(EQSRV.GLBDATA.lExpDate)
        if(EQSRV.GLBDATA.odAcctId!="")then
	#{
                sv_u = urhk_SetOrbOut("ODAccountId|" + EQSRV.GLBDATA.odAcctId )
	#}
        endif
        if(EBSRV.GLBDATA.odSchmCode!="")then
	#{
                sv_u = urhk_SetOrbOut("ODSchmCode|" + EBSRV.GLBDATA.odSchmCode )
	#}
        endif
        if(EQSRV.GLBDATA.lSanLim!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSanctionLimit|" + EQSRV.GLBDATA.lSanLim )
	#}
        endif
        if(EQSRV.GLBDATA.lSanDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSanctionDate|" + EQSRV.GLBDATA.lSanDate )
	#}
        endif
        if(EQSRV.GLBDATA.lExpDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastExpiryDate|" + EQSRV.GLBDATA.lExpDate )
	#}
        endif
        if(EQSRV.GLBDATA.cClearBalance!="")then
	#{
                sv_u = urhk_SetOrbOut("TotalDue|" + EQSRV.GLBDATA.cClearBalance1 )
	#}
        endif
        if(EQSRV.GLBDATA.cDrAmt!="")then
	#{
                sv_u = urhk_SetOrbOut("TotalDisburseAmt|" + EQSRV.GLBDATA.cDrAmt )
	#}
        endif
        if(EQSRV.GLBDATA.odDisbDate!="")then
	#{
                sv_u = urhk_SetOrbOut("LastDisburseDate|" + EQSRV.GLBDATA.odDisbDate )
	#}
        endif
        if(EQSRV.GLBDATA.SchdlNum!="")then
	#{
                sv_u = urhk_SetOrbOut("LastSchdlNum|" + EQSRV.GLBDATA.SchdlNum )
	#}
        endif
	###########dkc
	lv_d = "pendingInt| select sum(dmd_amt) as InttotDue from custom.dlla_dmd_tbl where bank_id=?SVAR and od_acid=?SVAR and dmd_amt>0 and entity_cre_flg='Y' and del_flg='N' and FLOW_ID='INDEM' and FREE_TEXT_5 is null "

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  EQSRV.GLBDATA.odAcid
	print(BANCS.INPARAM.BINDVARS)
	print(lv_d)
        lv_u = urhk_dbSelectWithBind(lv_d)
	if(lv_u == 0) then
		IF(BANCS.OUTPARAM.pendingInt != "") then
			EQSRV.GLBDATA.pendingInt = BANCS.OUTPARAM.pendingInt
			print(EQSRV.GLBDATA.pendingInt)
		ELSE
			EQSRV.GLBDATA.pendingInt = "0"
		ENDIF
	else
		EQSRV.GLBDATA.pendingInt = "0"
	endif
	##############
                sv_u = urhk_SetOrbOut("uptoDateInt|" + EQSRV.GLBDATA.pendingInt )
                sv_u = urhk_SetOrbOut("InterestRunDate|" + EQSRV.GLBDATA.InterestRunDate )
                sv_u = urhk_SetOrbOut("TotalRepaidAmount|0") 
                sv_u = urhk_SetOrbOut("TotalRepaidAmount|0") 
                sv_u = urhk_SetOrbOut("NumberOfRepayment|0") 
                sv_u = urhk_SetOrbOut("InstallementAmount|0") 
                sv_u = urhk_SetOrbOut("InterestInstallementAmount|0") 
                sv_u = urhk_SetOrbOut("PrinInstallementAmount|0") 
	lv_d = " dbankId,ddisbsrlNum,dshdlNum,dFlowId,dodAcid,dOpAcid,dDmdDate,dDmdOvduDate,ddmdAmt,dtotAdjAmt,dDueAmt,isOverdue,dpdValue |  select bank_id,disb_srl_num,shdl_num,flow_id,od_acid,op_acid,dmd_date,dmd_ovdu_date,dmd_amt,tot_adj_amt,dmd_amt-tot_adj_amt as totDue,(case when dmd_date< (select db_stat_date from tbaadm.gct where bank_id=?SVAR) and dmd_amt-tot_adj_amt >0 then 'Y' else 'N' end)isoverdue,(case when dmd_date< (select db_stat_date from tbaadm.gct where bank_id=?SVAR) and  dmd_amt-tot_adj_amt >0 then (select to_date(trunc(db_stat_date),'DD-MM-RRRR') from tbaadm.gct where bank_id=?SVAR) - to_date(trunc(dmd_date),'DD-MM-RRRR') else 0 end)as dpd from custom.dlla_dmd_tbl where bank_id=?SVAR and od_acid=?SVAR and dmd_amt>0 and entity_cre_flg='Y' and del_flg='N' order by disb_srl_num,dmd_date "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.odAcid 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_d)
        lv_u = urhk_dbCursorOpenWithBind(lv_d)
        if(lv_u == 0)then
	#{
                EQSRV.GLBDATA.gmainCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	#}
        else
	#{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Loan Demand Not Exists ,Demand Creation was Failed on Loan Creation")
                goto SIFNO
	#}
        endif
        EQSRV.GLBDATA.recNum = 0
        EQSRV.GLBDATA.dpdVal = 0
        lv_f = urhk_dbCursorFetch(EQSRV.GLBDATA.gmainCurNum)
        if(lv_f !=0)then
	#{
                lv_f = urhk_dbCursorClose(EQSRV.GLBDATA.gmainCurNum)
                print(lv_f)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Loan Demand Not Exists ,Demand Creation was Failed on Loan Creation")
                EQSRV.GLBDATA.isRecYN="N"
                goto SIFNO
	#}
        else
	#{
                EQSRV.GLBDATA.isRecYN="Y"
	#}
        endif
        while(lv_f ==0)
	#{
		EQSRV.GLBDATA.dbankId = BANCS.OUTPARAM.dbankId
		EQSRV.GLBDATA.ddisbsrlNum = BANCS.OUTPARAM.ddisbsrlNum
		EQSRV.GLBDATA.dshdlNum = BANCS.OUTPARAM.dshdlNum
		EQSRV.GLBDATA.dFlowId = BANCS.OUTPARAM.dFlowId
		EQSRV.GLBDATA.dodAcid = BANCS.OUTPARAM.dodAcid
		EQSRV.GLBDATA.dOpAcid = BANCS.OUTPARAM.dOpAcid
		EQSRV.GLBDATA.dDmdDate = BANCS.OUTPARAM.dDmdDate
		EQSRV.GLBDATA.dDmdOvduDate = BANCS.OUTPARAM.dDmdOvduDate
		EQSRV.GLBDATA.ddmdAmt = BANCS.OUTPARAM.ddmdAmt
		EQSRV.GLBDATA.dtotAdjAmt = BANCS.OUTPARAM.dtotAdjAmt
		EQSRV.GLBDATA.dDueAmt = BANCS.OUTPARAM.dDueAmt
		EQSRV.GLBDATA.isOverdue = BANCS.OUTPARAM.isOverdue
		EQSRV.GLBDATA.dpdValue = BANCS.OUTPARAM.dpdValue
		if(EQSRV.GLBDATA.ddisbsrlNum!="")then
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DisbSrlNum |" + EQSRV.GLBDATA.ddisbsrlNum )
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DisbSrlNum |0")
		endif
		if(EQSRV.GLBDATA.dshdlNum!="")then
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.SchdlNum |" + EQSRV.GLBDATA.dshdlNum )
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.SchdlNum |0")
		endif
		if(EQSRV.GLBDATA.dFlowId!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.FlowId |" + EQSRV.GLBDATA.dFlowId ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdFlowCode |" + EQSRV.GLBDATA.dFlowId ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdFlowCode |NA")
		endif
		if(EQSRV.GLBDATA.dDmdDate!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DemandDate |" + EQSRV.GLBDATA.dDmdDate ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdDate |" + EQSRV.GLBDATA.dDmdDate ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdDate |NA")
		endif
		if(EQSRV.GLBDATA.dDmdOvduDate!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DemandOverDueDate |" + EQSRV.GLBDATA.dDmdOvduDate ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdOverDueDate |" + EQSRV.GLBDATA.dDmdOvduDate ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdOverDueDate |NA")
		endif
		if(EQSRV.GLBDATA.ddmdAmt!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DemandAmount |" + EQSRV.GLBDATA.ddmdAmt ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdAmount  |" + EQSRV.GLBDATA.ddmdAmt ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DmdAmount  |0")
		endif
		if(EQSRV.GLBDATA.dtotAdjAmt!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.PaidAmount |" + EQSRV.GLBDATA.dtotAdjAmt ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotAdjAmt |" + EQSRV.GLBDATA.dtotAdjAmt ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotAdjAmt |0")
		endif
		if(EQSRV.GLBDATA.dDueAmt!="")then
			##sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.DueAmount |" + EQSRV.GLBDATA.dDueAmt ) 
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotOutstandingAmt |" + EQSRV.GLBDATA.dDueAmt ) 
		else
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.TotOutstandingAmt |0")
		endif
		if(cdouble(EQSRV.GLBDATA.dDueAmt)>0)then
			sv_u = urhk_SetOrbOut("DemandDetails.<rec_" + EQSRV.GLBDATA.recNum + ">.isDmdValid |Y")
		else 
