#  Name            : vpValidateAcctManager.scr
#  Description     :
#  Date            : 03-12-2024
#  Author          : Chirchir K.
#--------------------------------------------------------------------------------------------
<--start
trace on

        if(repexists("ECOSL")==0)then
                createrep("ECOSL")
        endif
        if(classexists("ECOSL","GLBDATA")==0)then
                createclass("ECOSL","GLBDATA",5)
        endif
	ECOSL.GLBDATA.loginId = ""
	ECOSL.GLBDATA.sal = ""
	ECOSL.GLBDATA.fName = ""
	ECOSL.GLBDATA.mName = ""
	ECOSL.GLBDATA.lName = ""
	ECOSL.GLBDATA.gender = ""

        ECOSL.GLBDATA.ACCTMANAGERID = BANCS.INPUT.ACCTMANAGERID
        print(ECOSL.GLBDATA.ACCTMANAGERID)
        ECOSL.GLBDATA.SOLID = BANCS.INPUT.SOLID
        print(ECOSL.GLBDATA.SOLID)

	sv_a  = "count|SELECT count(*) FROM tbaadm.RMG,tbaadm.upr WHERE 1 = 1 AND RMG.bank_id = ?SVAR and upr.USER_ID=rmg.LOGIN_ID and  LOGIN_ID =?SVAR and sol_id = ?SVAR and upr.del_flg='N' and rownum<2 ORDER BY  RMG.login_id "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + ECOSL.GLBDATA.ACCTMANAGERID + "|" + ECOSL.GLBDATA.SOLID
	sv_c = urhk_dbSelectWithBind(sv_a)
	if(sv_c == 0) then
			ECOSL.GLBDATA.count = BANCS.OUTPARAM.count
	else
			ECOSL.GLBDATA.isValid = "N"
			ECOSL.GLBDATA.count = 0
	endif

	if(cdouble(ECOSL.GLBDATA.count)>0) then
	#{
	sv_a  = "loginId,sal,fName,mName,lName,gender|SELECT RMG.login_id,RMG.salutation,RMG.first_name,RMG.middle_name,RMG.last_name,RMG.gender FROM tbaadm.RMG,tbaadm.upr WHERE 1 = 1 AND RMG.bank_id = ?SVAR and upr.USER_ID=rmg.LOGIN_ID and  LOGIN_ID =?SVAR and sol_id = ?SVAR and upr.del_flg='N' and rownum<2 ORDER BY  RMG.login_id "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + ECOSL.GLBDATA.ACCTMANAGERID + "|" + ECOSL.GLBDATA.SOLID
	sv_c = urhk_dbSelectWithBind(sv_a)
	if(sv_c == 0) then
		ECOSL.GLBDATA.isValid = "Y"
		IF(BANCS.OUTPARAM.loginId != "") then
			ECOSL.GLBDATA.loginId = BANCS.OUTPARAM.loginId
			print(ECOSL.GLBDATA.loginId)
		ENDIF
		IF(BANCS.OUTPARAM.sal != "") then
			ECOSL.GLBDATA.sal = BANCS.OUTPARAM.sal
			print(ECOSL.GLBDATA.sal)
		ENDIF
		IF(BANCS.OUTPARAM.fName != "") then
			ECOSL.GLBDATA.fName = BANCS.OUTPARAM.fName
			print(ECOSL.GLBDATA.fName)
		ENDIF
		IF(BANCS.OUTPARAM.mName != "") then
			ECOSL.GLBDATA.mName = BANCS.OUTPARAM.mName
			print(ECOSL.GLBDATA.mName)
		ENDIF
		IF(BANCS.OUTPARAM.lName != "") then
			ECOSL.GLBDATA.lName = BANCS.OUTPARAM.lName
			print(ECOSL.GLBDATA.lName)
		ENDIF
		IF(BANCS.OUTPARAM.gender != "") then
			ECOSL.GLBDATA.gender = BANCS.OUTPARAM.gender
			print(ECOSL.GLBDATA.gender)
		ENDIF
	else
		ECOSL.GLBDATA.isValid = "N"
		ECOSL.GLBDATA.loginId = ""
		ECOSL.GLBDATA.sal = ""
		ECOSL.GLBDATA.fName = ""
		ECOSL.GLBDATA.mName = ""
		ECOSL.GLBDATA.lName = ""
		ECOSL.GLBDATA.gender = ""
	endif
	else
		ECOSL.GLBDATA.isValid = "N"
	ENDIF

	sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
        sv_u = urhk_SetOrbOut("isValid|" + ECOSL.GLBDATA.isValid)
	IF(ECOSL.GLBDATA.loginId != "") THEN
        	sv_u = urhk_SetOrbOut("loginId|" + ECOSL.GLBDATA.loginId)
	ENDIF
	IF(ECOSL.GLBDATA.sal != "") THEN
        	sv_u = urhk_SetOrbOut("Salutation|" + ECOSL.GLBDATA.sal)
	ENDIF
	IF(ECOSL.GLBDATA.fName != "") THEN
        	sv_u = urhk_SetOrbOut("Name|" + ECOSL.GLBDATA.fName)
	ENDIF
	IF(ECOSL.GLBDATA.gender != "") THEN
        	sv_u = urhk_SetOrbOut("Gender|" + ECOSL.GLBDATA.gender)	
	ENDIF

trace off
