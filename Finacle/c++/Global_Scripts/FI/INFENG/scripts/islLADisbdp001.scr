	PRINT(CUST.ISL.loanAcct)
	CUST.ISL.schmCode = ""
	
	BANCS.INPARAM.BINDVARS = CUST.ISL.loanAcct
	lv_s = "schmCode|SELECT SCHM_CODE FROM TBAADM.GAM WHERE FORACID = ?SVAR"
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	IF(lv_d == 0)THEN
	#{
		CUST.ISL.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(CUST.ISL.schmCode)
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = CUST.ISL.schmCode + "|" + BANCS.STDIN.contextBankId
	lv_s = "islProdType,comTranReqFlg,fwdIjarahApp|SELECT TRIM(ISLAMIC_PRODUCT_TYPE),COM_TRAN_REQ_FLG,FWD_IJARAH_APP FROM TBAADM.GSP WHERE SCHM_CODE = ?SVAR"
	lv_s = lv_s + " AND SCHM_TYPE = 'LAA'"
	lv_s = lv_s + " AND BANK_ID = ?SVAR"
	print(lv_s)
	lv_d = urhk_dbSelectWithBind(lv_s)
	print(lv_d)
	IF(lv_d == 0)THEN
	#{
		CUST.ISL.islProdType = BANCS.OUTPARAM.islProdType
		PRINT(CUST.ISL.islProdType)
		CUST.ISL.comTranReqFlg = BANCS.OUTPARAM.comTranReqFlg
		PRINT(CUST.ISL.comTranReqFlg)
		CUST.ISL.fwdIjarahApp = BANCS.OUTPARAM.fwdIjarahApp
		PRINT(CUST.ISL.fwdIjarahApp)
	#}
	ENDIF
	
	###########################################################################################
	
	PRINT(CUST.ISL.islProdType)
	PRINT(CUST.ISL.comTranReqFlg)
	PRINT(CUST.ISL.fwdIjarahApp)
	
	ENDOFSCRIPT:
		
