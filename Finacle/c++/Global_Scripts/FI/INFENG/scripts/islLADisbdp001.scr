	IF(lv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	lv_r = CLASSEXISTS("CUST","ISL")
	
	IF(lv_r == 0) THEN
	#{
		CREATECLASS ("CUST","ISL",5)
	#}
	ENDIF
	
	###########################################################################################
	
	CUST.ISL.islProdType = ""
	CUST.ISL.comTranReqFlg = "N"
	CUST.ISL.fwdIjarahApp = "N"
