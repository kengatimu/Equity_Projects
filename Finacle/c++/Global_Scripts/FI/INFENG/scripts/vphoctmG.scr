        sv_u = urhk_SetUrhkOut("setInfo.ocFabRefNum|ocFabRefNum")
        sv_u = urhk_SetUrhkOut("setInfo.creationMode|creationMode")

        OCTM.GLBDATA.counter_2 = "0"
	OCTM.GLBDATA.noOfInstrmnt = "1"
        While(cint(OCTM.GLBDATA.counter_2) < cint(OCTM.GLBDATA.noOfInstrmnt))
	#{
                OCTM.GLBDATA.counter_1 = OCTM.GLBDATA.counter_2
		#Account
		sv_u = urhk_SetUrhkOut("ptranLL.<rec_"+OCTM.GLBDATA.counter_1+">.key.serial_num|pserial_num_" + OCTM.GLBDATA.counter_1 )
		sv_u = urhk_SetUrhkOut("ptranLL.<rec_"+OCTM.GLBDATA.counter_1+">.partTranSrlNum|ppartTranSrlNum_" + OCTM.GLBDATA.counter_1 )
