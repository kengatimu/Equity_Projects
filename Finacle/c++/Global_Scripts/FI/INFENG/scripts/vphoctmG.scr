	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Enter Set Num")
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	#}
	endif
        OCTM.GLBDATA.funcCode = "G"
        sv_u = urhk_SetUrhkInp("zoneHeader.solId.solId|" + OCTM.GLBDATA.zsolid )
        sv_u = urhk_SetUrhkInp("zoneHeader.zoneDate|" + OCTM.GLBDATA.zoneDate )
        sv_u = urhk_SetUrhkInp("zoneHeader.zoneCode|" + OCTM.GLBDATA.zoneCode )
