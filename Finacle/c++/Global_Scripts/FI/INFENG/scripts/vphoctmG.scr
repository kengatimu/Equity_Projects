<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("ONS")==0)then
        #{
                createrep("ONS")
        #}
        endif
        if(repexists("OCTM")==0)then
        #{
                createrep("OCTM")
        #}
        endif
        if(classexists("OCTM","GLBDATA")==0)then
        #{
                createclass("OCTM","GLBDATA",5)
        #}
        endif
	if(fieldexists(BANCS.INPUT.zsolid)==1)then
		OCTM.GLBDATA.zsolid = BANCS.INPUT.zsolid
	else
		OCTM.GLBDATA.zsolid = ""
	endif
	if(fieldexists(BANCS.INPUT.zoneDate)==1)then
		OCTM.GLBDATA.zoneDate = BANCS.INPUT.zoneDate
		OCTM.GLBDATA.zoneDate = OCTM.GLBDATA.zoneDate + " 00:00:00"
	else
		OCTM.GLBDATA.zoneDate = ""
	endif
	if(fieldexists(BANCS.INPUT.zoneCode)==1)then
		OCTM.GLBDATA.zoneCode = BANCS.INPUT.zoneCode
	else
		OCTM.GLBDATA.zoneCode = ""
	endif
	if(fieldexists(BANCS.INPUT.setNum)==1)then
		OCTM.GLBDATA.setNum = BANCS.INPUT.setNum
	else
		OCTM.GLBDATA.setNum = ""
	endif

	if(OCTM.GLBDATA.zsolid=="")then
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Enter Zone Solid")
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	#}
	endif
	if(OCTM.GLBDATA.zoneDate=="")then
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_u = urhk_SetOrbOut("Message|Enter Zone Date")
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	#}
	endif
