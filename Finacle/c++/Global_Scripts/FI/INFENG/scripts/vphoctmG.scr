                OCTM.GLBDATA.srvErrCode = "Failed : SRV_RegulariseOcSet "
                OCTM.GLBDATA.srvSucFail = "F"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
		if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
			sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.SrvError )
		else
			sv_u = urhk_SetOrbOut("Message|urhk_CopyOutToInDiffStruct is failed")
		endif
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
        #}
        endif
trace off
end-->

