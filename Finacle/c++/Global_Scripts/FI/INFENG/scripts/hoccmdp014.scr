		sv_s = BANCS.OUTPARAM.successOrFailure
		sv_a = urhk_CopyOutToIn("")
		
		sv_a = urhk_SetUrhkInp("tranDtl.tranIdentifier.tranDate|" +CUST.HOCCM.tranDate)
		sv_a = urhk_SetUrhkInp("tranDtl.tranIdentifier.tranId|" +CUST.HOCCM.tranId)
		
		
		#-------------------------------------------------------------------------------
		# Calling the service to Post the transaction.
		#-------------------------------------------------------------------------------
