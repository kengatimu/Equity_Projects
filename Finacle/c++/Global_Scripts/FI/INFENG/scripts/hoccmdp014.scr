<--START
CHECKSUM="d1b08363015947bc531d793c21f25f588b8891eabd853be79b5197bf22764361"
	TRACE ON
	print(CUST.HOCCM.userId)
	print(CUST.HOCCM.bankId)
	print(CUST.HOCCM.funcCode)
	print(CUST.HOCCM.zoneCode)
	IF (CUST.HOCCM.funcCode == "R") THEN
	#{
		CUST.HOCCM.outboundId = "RELEASE"
	#}
	ENDIF
	#CUST.HOCCM.outboundRecValues = ""
	CUST.HOCCM.TransactionType = "T"
	CUST.HOCCM.TransactionSubType = "BI"
	CUST.HOCCM.acctLst = ""
	#--------------------------------------------------------------------------
	# selecting Bacid value from CPARAM, Id - HOCCM_BACID.
	#--------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = "VERACIOUS" + "|" + "HOCCM_BACID"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.HOCCM.bankId
	sv_s = "bacid|"
	sv_s = sv_s + "SELECT PARAMETER_VALUE FROM CUSTOM.C_CPVALUE "
	sv_s = sv_s + " WHERE MODULE_NAME = ?SVAR"
	sv_s = sv_s + " AND PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND BANK_ID = ?SVAR"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.HOCCM.bacid = BANCS.OUTPARAM.bacid
		print(CUST.HOCCM.bacid)
		#}
	ELSE
		#{
		CUST.HOCCM.errorMsg = "Could not fetch parameter description for " + "HOCCM_BACID"
		CUST.HOCCM.fieldName = "abc"
		CUST.HOCCM.successFlg = "F"
		sv_u = urhk_dbSqlWithBind("ROLLBACK")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#----------------------------------------------------------------------------------------
	# Bacid to Acid Converter script call added to get office account.
	#----------------------------------------------------------------------------------------
	BANCS.INPUT.inputBacid = CUST.HOCCM.bacid
	BANCS.INPUT.inputCcy   = CUST.HOCCM.zoneCCY
	BANCS.INPUT.inputSolID = BANCS.STDIN.mySolId
	BANCS.INPUT.inputBankId = CUST.HOCCM.bankId
	
	call("bacidtoacid.scr")
	
	
	CUST.HOCCM.CrAcct = BANCS.OUTPUT.AcctId
	print(CUST.HOCCM.CrAcct)
	
	
	#-------------------------------------------------------------------------------
	# Getting Channel Information
	#-------------------------------------------------------------------------------
	
	sv_a = urhk_GetChannelInfo("")
	IF (FIELDEXISTS(BANCS.OUTPARAM.DccId)) THEN
	#{
		CUST.HOCCM.ChannelId = BANCS.OUTPARAM.DccId
		print(CUST.HOCCM.ChannelId)
	#}
	ENDIF
	
	#sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	#sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	#sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+ BANCS.STDIN.BODDate)
	
	#sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltTranDtls|same_user_verify = Y|retain_all_output = Y")
	#print(sv_u)
	#sv_u = urhk_CopyOutToIn("")
	#print(sv_u)
	
	
	IF (CUST.HOCCM.smInstrument == "M") THEN
	#{
		#----------------------------------------------------
		# setting Instrument details
		#----------------------------------------------------
		#CUST.HOCCM.CrTranAmt = "0"
		sv_n = 0
		sv_g = 1
		IF(FIELDEXISTS(CUST.HOCCM.custMRH2_d2InstAmt_0) != "1") THEN
		#{
			CUST.INTERFACE.errorCode = "HOCCM_ERR_005"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.HOCCM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.HOCCM.fieldName = "abc"
			CUST.HOCCM.successFlg = "F"
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF(CUST.HOCCM.custMRH2_d2InstAmt_0 == "") THEN
		#{
			CUST.INTERFACE.errorCode = "HOCCM_ERR_005"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.HOCCM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.HOCCM.fieldName = "abc"
			CUST.HOCCM.successFlg = "F"
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------------------
		# Beginning of While Loop
		#----------------------------------------------------
		WHILE (sv_g)
		#{
			CUST.HOCCM.TODFlag = "N"
			sv_y = format$(sv_n,"%d")
			# custMRH2 d2InstAmt
			sv_f = "custMRH2_d2InstAmt_"+sv_y
			#----------------------------------------------------
			# Checking d2InstAmt field exits
			#----------------------------------------------------
			IF(FIELDEXISTS(("CUST").("HOCCM").(sv_f)) != "1") THEN
			#{
				# No more records
				GOTO CREDITLEG
			#}
			ENDIF
			CUST.HOCCM.d2InstAmt = ""
			CUST.HOCCM.d2InstAmt = ("CUST").("HOCCM").(sv_f)
			print(CUST.HOCCM.d2InstAmt)
			IF(CUST.HOCCM.d2InstAmt == "") THEN
			#{
				# No more records
				GOTO CREDITLEG
			#}
			ENDIF
			
			# custMRH2 d2InstNum
			sv_f = "custMRH2_d2InstNum_"+sv_y
			CUST.HOCCM.d2InstNum = ""
			CUST.HOCCM.d2InstNum = ("CUST").("HOCCM").(sv_f)
			print(CUST.HOCCM.d2InstNum)
			
			# custMRH2 d2PayingAcctNum
			sv_f = "custMRH2_d2PayingAcctNum_"+sv_y
			CUST.HOCCM.d2PayingAcctNum = ""
			CUST.HOCCM.d2PayingAcctNum = ("CUST").("HOCCM").(sv_f)
			print(CUST.HOCCM.d2PayingAcctNum)
			
			# custMRH2 d2TranId
			sv_f = "custMRH2_d2TranId_"+sv_y
			CUST.HOCCM.d2tranId = ""
			CUST.HOCCM.d2tranId = ("CUST").("HOCCM").(sv_f)
			print(CUST.HOCCM.d2tranId)
			
			#-------------------------------------------------------------------------------
			# chceking if TOD has to be granted or not.
			#-------------------------------------------------------------------------------
                        if(CUST.HOCCM.d2PayingAcctNum=="")then
                                CUST.HOCCM.errorMsg = "Invalid Paying Account! not Exist"
                                CUST.HOCCM.fieldName = "abc"
                                CUST.HOCCM.successFlg = "F"
                                sv_u = urhk_dbSqlWithBind("ROLLBACK")
                                GOTO ENDOFSCRIPT
                        endif
			sv_b = urhk_getAcctDetailsInRepository(CUST.HOCCM.d2PayingAcctNum)
			IF(sv_b == 0) THEN
			#{
				CUST.HOCCM.acctSolId = BANCS.OUTPARAM.acctSolId
				print(CUST.HOCCM.acctSolId)
				CUST.HOCCM.DrAcctBal = BANCS.OUTPARAM.EffAvailableAmt
				print(CUST.HOCCM.DrAcctBal)
				CUST.HOCCM.DrSchmCode = BANCS.OUTPARAM.schmCode
				print(CUST.HOCCM.DrSchmCode)
				CUST.HOCCM.DrSchmType = BANCS.OUTPARAM.schmType
				print(CUST.HOCCM.DrSchmType)
				CUST.HOCCM.DrAcctCrncyCode =  BANCS.OUTPARAM.acctCrncyCode
				CUST.HOCCM.DrAcctName = BANCS.OUTPARAM.acctName
				IF(CUST.HOCCM.DrSchmType == "DDA") THEN
				#{
					IF(CUST.HOCCM.DrSchmCode == "DIVID")THEN
					#{
						CUST.HOCCM.InstType = "DIV"
						#}
					ELSE
						#{
						CUST.HOCCM.InstType = "BC"
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.HOCCM.InstType = "CHQ"
					CUST.HOCCM.tempDrAcctBal = CUST.HOCCM.DrAcctBal
					print(CUST.HOCCM.acctLst)
					CUST.HOCCM.tempAcctLst = CUST.HOCCM.acctLst
					print(CUST.HOCCM.tempDrAcctBal)
					print(CUST.HOCCM.d2PayingAcctNum)
					print(CUST.HOCCM.zoneCode)
					IF(CUST.HOCCM.tempAcctLst == "") THEN
					#{
						IF(CDOUBLE(CUST.HOCCM.d2InstAmt) > CDOUBLE(CUST.HOCCM.DrAcctBal)) THEN
						#{
							CUST.HOCCM.TODFlag = "Y"
							CUST.HOCCM.TODAmount = CDOUBLE(CUST.HOCCM.d2InstAmt) - CDOUBLE(CUST.HOCCM.DrAcctBal)
							print(CUST.HOCCM.TODFlag)
							print(CUST.HOCCM.TODAmount)
						#}
						ENDIF
						CUST.HOCCM.acctLst = CUST.HOCCM.d2PayingAcctNum + "~" + CUST.HOCCM.d2InstAmt
						#}
					ELSE
						#{
						WHILE(GETPOSITION(CUST.HOCCM.tempAcctLst,"|") != 0)
						#{
							CUST.HOCCM.temprec = MID$(CUST.HOCCM.tempAcctLst,0,GETPOSITION(CUST.HOCCM.tempAcctLst,"|")-1)
							print(CUST.HOCCM.temprec)
							CUST.HOCCM.tempInstAcct = MID$(CUST.HOCCM.temprec,0,GETPOSITION(CUST.HOCCM.temprec,"~")-1)
							print(CUST.HOCCM.tempInstAcct)
							IF(CUST.HOCCM.tempInstAcct == CUST.HOCCM.d2PayingAcctNum) THEN
							#{
								CUST.HOCCM.tempInstAmt = MID$(CUST.HOCCM.temprec,GETPOSITION(CUST.HOCCM.temprec,"~"),STRLEN(CUST.HOCCM.temprec))
								print(CUST.HOCCM.tempInstAmt)
								print(CUST.HOCCM.tempDrAcctBal)
								CUST.HOCCM.tempDrAcctBal = CDOUBLE(CUST.HOCCM.tempDrAcctBal) - CDOUBLE(CUST.HOCCM.tempInstAmt)
								print(CUST.HOCCM.tempDrAcctBal)
							#}
							ENDIF
							CUST.HOCCM.tempAcctLst = MID$(CUST.HOCCM.tempAcctLst,GETPOSITION(CUST.HOCCM.tempAcctLst,"|"),STRLEN(CUST.HOCCM.tempAcctLst))
						#}
						DO
						print(CUST.HOCCM.tempDrAcctBal)
						print(CUST.HOCCM.d2InstAmt)
						IF(CDOUBLE(CUST.HOCCM.d2InstAmt) > CDOUBLE(CUST.HOCCM.tempDrAcctBal)) THEN
						#{
							CUST.HOCCM.TODFlag = "Y"
							CUST.HOCCM.TODAmount = CDOUBLE(CUST.HOCCM.d2InstAmt) - CDOUBLE(CUST.HOCCM.tempDrAcctBal)
							print(CUST.HOCCM.TODFlag)
							print(CUST.HOCCM.TODAmount)
						#}
						ENDIF
						
						CUST.HOCCM.acctLst = CUST.HOCCM.acctLst + "|" + CUST.HOCCM.d2PayingAcctNum + "~" + CUST.HOCCM.d2InstAmt
					#}
					ENDIF
					print(CUST.HOCCM.acctLst)
					
				#}
				ENDIF
				#}
			ELSE
				#{
				#throwing Error
				CUST.INTERFACE.errorCode = "HOCCM_ERR_001"
				CALL("Common_Interface_GetErrorDesc.scr")
				CUST.HOCCM.errorMsg = CUST.HOCCM.d2PayingAcctNum + " " + CUST.INTERFACE.errorDesc
				CUST.HOCCM.fieldName = "abc"
				CUST.HOCCM.successFlg = "F"
				sv_u = urhk_dbSqlWithBind("ROLLBACK")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			
			CUST.HOCCM.srNo = sv_n + 1
			print(CUST.HOCCM.srNo)
			IF ( CUST.HOCCM.InstType == "CHQ" ) THEN
			#{
				CUST.HOCCM.DrRemarks = "Payment For Cheque num " + CUST.HOCCM.d2InstNum
				
				#-------------------------------------------------------------------------------
				# TOD Details
				#-------------------------------------------------------------------------------
				IF(CUST.HOCCM.TODFlag == "Y") THEN
				#{
					sv_s = "advType,advCatg|select DISCRET_ADVN_TYPE,DISCRET_ADVN_CATGR "
					sv_s = sv_s + " from tbaadm.DAR where DAT_REF_TYPE = 'IN' "
					sv_s = sv_s + " AND schm_code = '" + CUST.HOCCM.DrSchmCode + "'"
					sv_s = sv_s + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
					sv_s = sv_s + " AND del_flg != 'Y'"
					print(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF(sv_d == 0) THEN
					#{
						CUST.HOCCM.advType = BANCS.OUTPARAM.advType
						CUST.HOCCM.advCatg = BANCS.OUTPARAM.advCatg
						#}
					ELSE
						#{
						CUST.HOCCM.advType = ""
						CUST.HOCCM.advCatg = ""
					#}
					ENDIF
					
					sv_s = ""
					sv_s = sv_s + "tranDtl.partTranDetailLL.<rec_" + sv_y + ">.grantTodFlg|Y"
					sv_a = urhk_SetUrhkInp(sv_s)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.discreteAdvnType.code|"+CUST.HOCCM.advType)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.discreteAdvnCatgr.code|"+CUST.HOCCM.advCatg)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.grantDate|" + BANCS.STDIN.BODDate)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.expiryDate|" + BANCS.STDIN.BODDate)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.acct.foracid|" + CUST.HOCCM.d2PayingAcctNum)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.acct.crncyCode|" + CUST.HOCCM.zoneCCY)
					sv_a= CUST.HOCCM.TODAmount
					sv_a= format$(CDOUBLE(sv_a),"%17.2f")
					sv_a= sv_a + "|" + CUST.HOCCM.zoneCCY
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.todAmtToBeGrntd|" + sv_a)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.todLevIntFlg|N")
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.permittedBy.userId|" + BANCS.STDIN.userId)
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.todEventType.type|TODIN")
					sv_a= urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instantTodDtl.todBasicDtl.penalDate|" + BANCS.STDIN.BODDate)
					
					# FiRespCode for cheque
					sv_f = "FiRespCode_"+sv_y
					("CUST").("HOCCM").(sv_f) = "100"
					print(("CUST").("HOCCM").(sv_f))
					#}
				ELSE
					#{
					# FiRespCode for cheque
					sv_f = "FiRespCode_"+sv_y
					("CUST").("HOCCM").(sv_f) = "000"
					print(("CUST").("HOCCM").(sv_f))
				#}
				ENDIF
				#-------------------------------------------------------------------------------
				# Debit Leg for multiple instrument
				#-------------------------------------------------------------------------------
				CUST.HOCCM.DrTranPart = "ChequeNo." + CUST.HOCCM.d2InstNum + " Presented"
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.key.serial_num|" + sv_y)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.valueDate|" + BANCS.STDIN.BODDate)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.partTranType.code|D")
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.refCrncyCode.crncyCode|" + CUST.HOCCM.zoneCCY)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.refAmt|" + CUST.HOCCM.d2InstAmt + "|" + CUST.HOCCM.zoneCCY)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.tranAmt|" + CUST.HOCCM.d2InstAmt + "|" + CUST.HOCCM.zoneCCY)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.acctId.foracid|" + CUST.HOCCM.d2PayingAcctNum)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.glDate|" + BANCS.STDIN.BODDate)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.tranParticulars|" + CUST.HOCCM.DrTranPart)
				#sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.tranParticulars2|" + CUST.HOCCM.DrTranPart2)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.tranRmks|" + CUST.HOCCM.DrRemarks)
				#sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.refNum|" + CUST.HOCCM.TranRefNum)
				
				sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instrmnt.instrmntType|"+ CUST.HOCCM.InstType)
				sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instrmnt.instrmntDate|" + BANCS.STDIN.BODDate)
				sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.instrmnt.instrmntNum|" + CUST.HOCCM.d2InstNum)
				
				#}
			ELSE
				#{
				sv_f = "FiRespCode_"+sv_y
				("CUST").("HOCCM").(sv_f) = "000"
				print(("CUST").("HOCCM").(sv_f))
				
				CUST.HOCCM.DrRemarks = "Payment For DD num " + CUST.HOCCM.d2InstNum
				CUST.HOCCM.CrTranAmt = CUST.HOCCM.d2InstAmt
				print(CUST.HOCCM.CrTranAmt)
				CUST.HOCCM.InstrumentNum = CUST.HOCCM.d2InstNum
				CUST.HOCCM.PayingAcctNum = CUST.HOCCM.d2PayingAcctNum
				CUST.HOCCM.InstrumentAmt = CUST.HOCCM.d2InstAmt
				# Call the script to do DD debit part tran
				call("hoccmdp026.scr")
			#}
			ENDIF
			# increasing value for next record
			sv_n = sv_n + 1
		#}
		DO
		CREDITLEG:
			IF ( CUST.HOCCM.InstType == "CHQ" ) THEN
			#{
				
				CUST.HOCCM.srNo = sv_n + 1
				
				print(CUST.HOCCM.srNo)
				CUST.HOCCM.CrTranAmt = CUST.HOCCM.totalCrAmt
				print(CUST.HOCCM.CrTranAmt)
				CUST.HOCCM.CrRemarks = "Payment for set Num " + CUST.HOCCM.setNum
				sv_n = CINT(CUST.HOCCM.srNo) - 1
				sv_y = format$(sv_n,"%d")
				#-------------------------------------------------------------------------------
				# Setting inputs and outputs for SRV_AddTransferTran.
				#-------------------------------------------------------------------------------
				sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranType|" + CUST.HOCCM.TransactionType)
				sv_a = urhk_SetUrhkInp("tranDtl.tranTypeSubType.tranSubType|" + CUST.HOCCM.TransactionSubType)
				sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
				sv_a = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
				sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|" + CUST.HOCCM.TransactionType)
				sv_a = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|" + CUST.HOCCM.TransactionSubType)
				
				sv_a = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_a = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_a = urhk_SetUrhkInp("tranDtl.deliveryChannelId|" + CUST.HOCCM.ChannelId)
				
				#-------------------------------------------------------------------------------
				# Credit Leg.
				#-------------------------------------------------------------------------------
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.key.serial_num|" + CUST.HOCCM.srNo)
				sv_a = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_" + sv_y + ">.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
