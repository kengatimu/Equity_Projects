<--START
CHECKSUM="eeca5d4e3dae43a472d1aad7cecd72cd20d8d393cb48e5914f40eab0f28f4502"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	sv_u = urhk_b2k_printrepos("BANCS")
	
	CUST.CIETXN.targetEntity = " "
	CUST.CIETXN.acctNum = " "
	CUST.CIETXN.debitEntity = " "
	CUST.CIETXN.creditEntity = " "
	CUST.CIETXN.drAcctNum = " "
	CUST.CIETXN.crAcctNum = " "
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.chargeAmt = " "
	CUST.CIETXN.chargeAmtFlg = "N"
	CUST.CIETXN.chargeAmtCcy = " "
	CUST.CIETXN.chargeAmtCcyFlg = "N"
	CUST.CIETXN.chargeEventId = " "
	CUST.CIETXN.chargeEventIdFlg = "N"
	CUST.CIETXN.nostroAcct = " "
	CUST.CIETXN.nostroAcctName = " "
	CUST.CIETXN.nostroAcctFlg = "N"
	CUST.CIETXN.vostroAcct = " "
	CUST.CIETXN.vostroAcctFlg = "N"
	CUST.CIETXN.acctNumSolId = " "
	CUST.CIETXN.acctNumCcy = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.debitEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.debitEntity) != "")THEN
		#{
			CUST.CIETXN.debitEntity = TOUPPER(TRIM(BANCS.INPUT.debitEntity))
			print(CUST.CIETXN.debitEntity)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.creditEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.creditEntity) != "")THEN
		#{
			CUST.CIETXN.creditEntity = TOUPPER(TRIM(BANCS.INPUT.creditEntity))
			print(CUST.CIETXN.creditEntity)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.drAcctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.drAcctNum) != "")THEN
		#{
			CUST.CIETXN.drAcctNum = TOUPPER(TRIM(BANCS.INPUT.drAcctNum))
			print(CUST.CIETXN.drAcctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.crAcctNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.crAcctNum) != "")THEN
		#{
			CUST.CIETXN.crAcctNum = TOUPPER(TRIM(BANCS.INPUT.crAcctNum))
			print(CUST.CIETXN.crAcctNum)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Unable to get charge amount;"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF(FIELDEXISTS(BANCS.INPUT.acctNumSolId))THEN
        #{
                IF(TRIM(BANCS.INPUT.acctNumSolId) != "")THEN
                #{
                        CUST.CIETXN.acctNumSolId = TOUPPER(TRIM(BANCS.INPUT.acctNumSolId))
                        print(CUST.CIETXN.acctNumSolId)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.CIETXN.errorFlg = "Y"
                CUST.CIETXN.errorMsg = "Unable to get charge amount;"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

		 IF(FIELDEXISTS(BANCS.INPUT.acctNumCcy))THEN
        #{
                IF(TRIM(BANCS.INPUT.acctNumCcy) != "")THEN
                #{
                        CUST.CIETXN.acctNumCcy = TOUPPER(TRIM(BANCS.INPUT.acctNumCcy))
                        print(CUST.CIETXN.acctNumCcy)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.CIETXN.errorFlg = "Y"
                CUST.CIETXN.errorMsg = "Unable to get charge amount;"
                GOTO ENDOFSCRIPT
        #}
        ENDIF
	
	IF((CUST.CIETXN.debitEntity == CUST.CIETXN.creditEntity) AND (CUST.CIETXN.debitEntity == BANCS.STDIN.contextBankId))THEN
	#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Same Entity Transaction Not Allowed"
		GOTO ENDOFSCRIPT
		CUST.CIETXN.targetEntity = BANCS.STDIN.contextBankId
	#}
	ENDIF
	
	IF((CUST.CIETXN.debitEntity == CUST.CIETXN.creditEntity) AND (CUST.CIETXN.debitEntity != BANCS.STDIN.contextBankId))THEN
	#{
		CUST.CIETXN.targetEntity = CUST.CIETXN.debitEntity
		PRINT(CUST.CIETXN.targetEntity)
		CUST.CIETXN.acctNum = CUST.CIETXN.drAcctNum
		PRINT(CUST.CIETXN.acctNum)
	#}
	ENDIF
	
	IF((CUST.CIETXN.debitEntity != CUST.CIETXN.creditEntity) AND (CUST.CIETXN.debitEntity == BANCS.STDIN.contextBankId))THEN
	#{
		CUST.CIETXN.targetEntity = CUST.CIETXN.creditEntity
		PRINT(CUST.CIETXN.targetEntity)
		CUST.CIETXN.acctNum = CUST.CIETXN.crAcctNum
		PRINT(CUST.CIETXN.acctNum)
	#}
	ENDIF
	
	IF((CUST.CIETXN.debitEntity != CUST.CIETXN.creditEntity) AND (CUST.CIETXN.creditEntity == BANCS.STDIN.contextBankId))THEN
	#{
		CUST.CIETXN.targetEntity = CUST.CIETXN.debitEntity
		PRINT(CUST.CIETXN.targetEntity)
		CUST.CIETXN.acctNum = CUST.CIETXN.drAcctNum
		PRINT(CUST.CIETXN.acctNum)
	#}
	ENDIF
	
	IF((CUST.CIETXN.debitEntity != CUST.CIETXN.creditEntity) AND (CUST.CIETXN.creditEntity != BANCS.STDIN.contextBankId) AND (CUST.CIETXN.debitEntity != BANCS.STDIN.contextBankId))THEN
	#{
		CUST.CIETXN.errorFlg = "Y"
		CUST.CIETXN.errorMsg = "Atleast one account should belong to Initiating Entity OR Both Cr AND Dr A/c should belong to same target entity"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###########################################################################################
	# Get the Nostro Account Id
	###########################################################################################
	
	NOSTRO:
		IF(CUST.CIETXN.debitEntity == BANCS.STDIN.contextBankId) THEN
		#{
			CUST.CIETXN.parameterId = "CD_NOSTRO_" + CUST.CIETXN.targetEntity
			#}
		ELSE
			#{
			CUST.CIETXN.parameterId = "CW_NOSTRO_" + CUST.CIETXN.targetEntity
		#}
		ENDIF
		
		#CUST.CIETXN.parameterId = "TT_NOSTRO_" + CUST.CIETXN.targetEntity
		print(CUST.CIETXN.parameterId)
		
		sv_s = "nostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account;"
			GOTO VOSTRO
		#}
		ENDIF
		
		CUST.CIETXN.nostroAcct = BANCS.OUTPARAM.nostroAcct
		print(CUST.CIETXN.nostroAcct)
		
		IF(TRIM(CUST.CIETXN.nostroAcct) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account;"
			GOTO VOSTRO
		#}
		ENDIF
		
		sv_s = "acctNumSolId,acctNumCcy|"
		sv_s = sv_s + " SELECT SOL_ID,ACCT_CRNCY_CODE"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE FORACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.acctNum
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
	#		CUST.CIETXN.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
	#		print(CUST.CIETXN.acctNumSolId)
	#		CUST.CIETXN.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
	#		print(CUST.CIETXN.acctNumCcy)
		#}
		ENDIF
		
		CUST.CIETXN.inputBankId = BANCS.STDIN.contextBankId
		CUST.CIETXN.inputBacid = CUST.CIETXN.nostroAcct
		CUST.CIETXN.inputSolId = BANCS.STDIN.mySolId
		CUST.CIETXN.inputCcy = CUST.CIETXN.acctNumCcy
		CUST.CIETXN.inputBacidOrForacid = CUST.CIETXN.nostroAcct
		
		CALL("cietxndp032.scr")
		
		PRINT(CUST.CIETXN.outputForacid)
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account;"
			GOTO VOSTRO
		#}
		ENDIF
		
		CUST.CIETXN.nostroAcct = CUST.CIETXN.outputForacid
		CUST.CIETXN.nostroAcctFlg = "Y"
		
		sv_s = "nostroAcctName|"
		sv_s = sv_s + " SELECT ACCT_NAME"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE FORACID = ?SVAR"
		sv_s = sv_s + " AND DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.nostroAcct
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.nostroAcctName = BANCS.OUTPARAM.nostroAcctName
			PRINT(CUST.CIETXN.nostroAcctName)
		#}
		ENDIF
		
		###########################################################################################
		# Get the Vostro Account Id
		###########################################################################################
		
	VOSTRO:
		
		IF(CUST.CIETXN.debitEntity == BANCS.STDIN.contextBankId) THEN
		#{
			CUST.CIETXN.parameterId = "CD_VOSTRO_" + CUST.CIETXN.targetEntity
			#}
		ELSE
			#{
			CUST.CIETXN.parameterId = "CW_VOSTRO_" + CUST.CIETXN.targetEntity
		#}
		ENDIF
		
		#CUST.CIETXN.parameterId = "TT_VOSTRO_" + CUST.CIETXN.targetEntity
		print(CUST.CIETXN.parameterId)
		
		sv_s = "vostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.vostroAcct = BANCS.OUTPARAM.vostroAcct
		print(CUST.CIETXN.vostroAcct)
		
		IF(TRIM(CUST.CIETXN.vostroAcct) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.inputBankId = CUST.CIETXN.targetEntity
		CUST.CIETXN.inputBacid = CUST.CIETXN.vostroAcct
		CUST.CIETXN.inputSolId = CUST.CIETXN.acctNumSolId
		CUST.CIETXN.inputCcy = CUST.CIETXN.acctNumCcy
		CUST.CIETXN.inputBacidOrForacid = CUST.CIETXN.vostroAcct
		
		CALL("cietxndp032.scr")
		
		PRINT(CUST.CIETXN.outputForacid)
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.vostroAcct = CUST.CIETXN.outputForacid
		CUST.CIETXN.vostroAcctFlg = "Y"
		
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("nostroAcct|"+CUST.CIETXN.nostroAcct)
		print(sv_u)
		sv_u = urhk_SetOrbOut("nostroAcctFlg|"+CUST.CIETXN.nostroAcctFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("vostroAcct|"+CUST.CIETXN.vostroAcct)
		print(sv_u)
		sv_u = urhk_SetOrbOut("vostroAcctFlg|"+CUST.CIETXN.vostroAcctFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("targetCcy|"+CUST.CIETXN.acctNumCcy)
		print(sv_u)
		sv_u = urhk_SetOrbOut("nostroAcctName|"+CUST.CIETXN.nostroAcctName)
		print(sv_u)
		
		
END-->
