<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EMPL")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EMPL", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CATEGORYTYPE"))== 0) ) THEN
	#{
   		CUST.EMPL.errMsg="please enter CATEGORYTYPE"
		sv_t = "ERROR | " +CUST.EMPL.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF


	#-----------------------------------------------------------------------------------------------------
	#REGION LIST
	#-----------------------------------------------------------------------------------------------------
	

	sv_s="REGION, Description|SELECT distinct c.value, l.localetext"
	sv_s=sv_s + " FROM crmuser.categories c, crmuser.category_lang l "
	sv_s=sv_s + "WHERE C.categorytype =?SVAR AND l.categoryid=c.categoryid "
	sv_s=sv_s + "AND c.bank_id=?SVAR AND l.BANK_ID=?SVAR" 
	print(sv_s)

	BANCS.INPARAM.BINDVARS = BANCS.INPUT.CATEGORYTYPE + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	IF(sv_c !=0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF


	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(sv_n)
	sv_f = urhk_dbCursorFetch(sv_n)
	print(sv_f)
	sv_i=1
	WHILE(sv_f==0)
	#{
		CUST.EMPL.REGION= BANCS.OUTPARAM.REGION
		print(CUST.EMPL.REGION)
		CUST.EMPL.Description= BANCS.OUTPARAM.Description
		print(CUST.EMPL.Description)


		sv_s="REGION"+Format$(sv_i,"%d")+ "| "+ CUST.EMPL.REGION
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)

		sv_s="Description"+Format$(sv_i, "%d")+ "| " + CUST.EMPL.Description
		print(sv_s)
		sv_u=urhk_SetOrbOut(sv_s)
		print(sv_u)

		sv_i = sv_i + 1 
		sv_f = urhk_dbCursorFetch(sv_n)			
		PRINT(sv_f)

		#}
		DO

		sv_c = urhk_dbCursorClose(sv_n)

ENDOFSCRIPT:
END-->

