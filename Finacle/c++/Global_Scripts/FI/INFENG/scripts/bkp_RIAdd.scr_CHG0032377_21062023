        #{
                CUST.RIADD.v_userid = ("BANCS").("INPUT").("RIAdd_REQ.UserID")
				print("Userid is")
				print(CUST.RIADD.v_userid)
				
				sv_p = STRLEN(CUST.RIADD.v_userid)
				PRINT(sv_p)
				IF (sv_p > 15 ) THEN
					PRINT("User Id cannot be greate than 15")
					sv_a = "RIAdd_RES.Status|ERROR"
					sv_u = urhk_SetOrbOut(sv_a)	
					sv_b = "RIAdd_RES.ErrorMessage|User ID cannot be greater than 15 characters"
					sv_u = urhk_SetOrbOut(sv_b)
