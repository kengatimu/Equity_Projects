                CUST.RIADD.v_DateFormat = ("BANCS").("INPUT").("RIAdd_REQ.DateFormat")
				print("DateFormat is")
				print(CUST.RIADD.v_DateFormat)
				
				IF ((CUST.RIADD.v_DateFormat == "dd/mm/yyyy") OR (CUST.RIADD.v_DateFormat == "mm/dd/yyyy")) THEN
				
