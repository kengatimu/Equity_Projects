				EXITSCRIPT
			
		ENDIF
		
		
		
		IF (FIELDEXISTS(("BANCS").("INPUT").("RIAdd_REQ.BankID")) == 1) THEN
        #{
                CUST.RIADD.v_BankID = ("BANCS").("INPUT").("RIAdd_REQ.BankID")
				print("Bank Id is")
				print(CUST.RIADD.v_BankID)
				
				BANCS.INPARAM.BINDVARS = CUST.RIADD.v_BankID 
				sv_s = "valBankID|"
				sv_s = sv_s + " SELECT bank_id"
				sv_s = sv_s + " FROM FINRIADM.BANK_MASTER_TABLE"
				sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
				
				print(sv_s)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				
				IF (sv_d != 0) THEN
			
					sv_a = "RIAdd_RES.Status|ERROR"
					sv_u = urhk_SetOrbOut(sv_a)	
