								sv_s = "INSERT INTO FINRIADM.UMT (RPT_NAME, USER_ID,   REPORT_MODE_ID,      REPORT_ID,    USER_GENERATE, USER_DISTRIBUTE, USER_PRINT,    USER_EXPORT,   RPT_NOTES, USER_REMOTE_PRINT,   BANK_ID,   DEL_FLAG, TS_CNT,USER_VIEW_RPT, MAIL_STATUS_NOTIFY)"
								sv_s = sv_s + "VALUES (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,'0','Y','Y')"
								PRINT(sv_s)
