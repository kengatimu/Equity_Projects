                CUST.RIADD.v_TimeFormat = ("BANCS").("INPUT").("RIAdd_REQ.TimeFormat")
				print("Time")
				print(CUST.RIADD.v_TimeFormat)
				
				IF ((CUST.RIADD.v_TimeFormat == "hh:mm:ss") OR (CUST.RIADD.v_TimeFormat == "hh:mm:ss aaa")) THEN
				
