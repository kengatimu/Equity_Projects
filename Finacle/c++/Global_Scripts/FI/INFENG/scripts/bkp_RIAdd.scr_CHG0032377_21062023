						sv_u = urhk_SetOrbOut(sv_b)
						EXITSCRIPT
                #}
                
               
			ELSE
				
				BANCS.INPARAM.BINDVARS = CUST.RIADD.v_BankID + "|" + CUST.RIADD.v_RoleID 
				sv_q = "RPT_NAME,REPORT_MODE_ID,REPORT_ID,RPT_GENERATE,RPT_DISTRIBUTE,RPT_PRINT,RPT_EXPORT,RPT_NOTES,RPT_REMOTE_PRINT,BANK_ID,DEL_FLAG |"
				sv_q = sv_q + " select RPT_NAME,REPORT_MODE_ID,REPORT_ID,RPT_GENERATE,RPT_DISTRIBUTE,RPT_PRINT,RPT_EXPORT,RPT_NOTES,RPT_REMOTE_PRINT,BANK_ID,DEL_FLAG "
				sv_q = sv_q + "from FINRIADM.REPORT_FORMAT_TABLE where bank_id = ?SVAR"  
				sv_q = sv_q + "and rpt_name in (select rpt_name from FINRIADM.ROLE_REPORT_MAP_TABLE where role_id = ?SVAR)"
				print(sv_q)
				sv_d = urhk_dbCursorOpenWithBind(sv_q)
				print(sv_d)
				sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				print(sv_m)
				IF(sv_d == 0) THEN
				#{
						sv_a=urhk_dbCursorFetch(sv_m)
						print(sv_a)
						WHILE(sv_a == 0)
						#{
								CUST.RIADD.v_RPT_NAME = BANCS.OUTPARAM.RPT_NAME
								print(CUST.RIADD.v_RPT_NAME)
								CUST.RIADD.v_REPORT_MODE_ID = BANCS.OUTPARAM.REPORT_MODE_ID
								print(CUST.RIADD.v_REPORT_MODE_ID)
								CUST.RIADD.v_REPORT_ID = BANCS.OUTPARAM.REPORT_ID
								print(CUST.RIADD.v_REPORT_ID)
