								print(CUST.RIADD.v_RPT_GENERATE)
								CUST.RIADD.v_RPT_DISTRIBUTE = BANCS.OUTPARAM.RPT_DISTRIBUTE
								print(CUST.RIADD.v_RPT_DISTRIBUTE)
								CUST.RIADD.v_RPT_PRINT = BANCS.OUTPARAM.RPT_PRINT
								print(CUST.RIADD.v_RPT_PRINT)
								CUST.RIADD.v_RPT_EXPORT = BANCS.OUTPARAM.RPT_EXPORT
								print(CUST.RIADD.v_RPT_EXPORT)
								CUST.RIADD.v_RPT_NOTES = BANCS.OUTPARAM.RPT_NOTES
								print(CUST.RIADD.v_RPT_NOTES)
								CUST.RIADD.v_RPT_REMOTE_PRINT = BANCS.OUTPARAM.RPT_REMOTE_PRINT
