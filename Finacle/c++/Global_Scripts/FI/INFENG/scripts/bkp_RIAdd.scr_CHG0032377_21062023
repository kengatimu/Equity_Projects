		IF (FIELDEXISTS(("BANCS").("INPUT").("RIAdd_REQ.RoleName")) == 1) THEN
        #{
				
				CUST.RIADD.v_RoleName = ("BANCS").("INPUT").("RIAdd_REQ.RoleName")
				print("RoleName is")
				print(CUST.RIADD.v_RoleName)
				
				##########  CHECK IF ROLE NAME EXISTS IN RDT TABLE  ##############
				
				BANCS.INPARAM.BINDVARS = CUST.RIADD.v_RoleName + "|" + CUST.RIADD.v_BankID
				sv_s = "valRoleName|"
				sv_s = sv_s + " SELECT role_name"
				sv_s = sv_s + " FROM FINRIADM.RDT"
				sv_s = sv_s + " WHERE UPPER(ROLE_NAME) =UPPER(?SVAR)"
