				ENDIF
		ELSE
				sv_a = "RIAdd_RES.Status|ERROR"
				sv_u = urhk_SetOrbOut(sv_a)	
				sv_b = "RIAdd_RES.ErrorMessage|Value of Time Format is mandatory"
				sv_u = urhk_SetOrbOut(sv_b)
				EXITSCRIPT
        #}
		ENDIF
			
		CUST.RIADD.v_gmttime = CUST.RIADD.v_DateFormat + "#" + CUST.RIADD.v_TimeFormat
		print(CUST.RIADD.v_gmttime)
		
		
		
			##########  CHECK IF USER ID AND BANK_ID COMBINATION EXISTS IN UDT TABLE  ##############
			
				BANCS.INPARAM.BINDVARS = CUST.RIADD.v_userid + "|" + CUST.RIADD.v_BankID
				sv_s = "valUser|"
				sv_s = sv_s + " SELECT USER_ID"
				sv_s = sv_s + " FROM FINRIADM.UDT"
				sv_s = sv_s + " WHERE UPPER(USER_ID) =UPPER(?SVAR)"
