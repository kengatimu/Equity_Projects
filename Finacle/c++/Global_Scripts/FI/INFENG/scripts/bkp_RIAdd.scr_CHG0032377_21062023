				print(sv_s)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				
				IF (sv_d == 0) THEN
			
					sv_a = "RIAdd_RES.Status|ERROR"
					sv_u = urhk_SetOrbOut(sv_a)	
					sv_b = "RIAdd_RES.ErrorMessage|"+CUST.RIADD.v_userid +" User Alredy exists for given Bank ID "
					sv_u = urhk_SetOrbOut(sv_b)
					
					EXITSCRIPT
				ENDIF
		
				
################################ INSERT VALUES IN UDT ##################################

			BANCS.INPARAM.BINDVARS = CUST.RIADD.v_userid + "|" + CUST.RIADD.v_BankID + "|" + CUST.RIADD.v_RoleID + "|" + CUST.RIADD.v_gmttime
			sv_s = "INSERT INTO FINRIADM.UDT (USER_ID,BANK_ID,ROLE_ID,DEL_FLAG,TS_CNT,GMT_TIME)"
            sv_s = sv_s + "VALUES (?SVAR,?SVAR,?SVAR,'N',0,?SVAR)"
            PRINT(sv_s)
            sv_d = urhk_dbSqlWithBind(sv_s)
            PRINT(sv_d)
            IF (sv_d != 0) THEN
                #{
                        BANCS.OUTPUT.successOrFailure = "F"
						sv_a = "RIAdd_RES.RIStatus|ERROR"
						sv_u = urhk_SetOrbOut(sv_a)	
