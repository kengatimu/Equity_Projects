<--start
trace on
#Rep/Class
        libname CUSTOMSO
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("CUST","HOCCM") == 0) then
                createclass("CUST","HOCCM",5)
        endif
	CUST.HOCCM.delRespVal = ""
	CUST.HOCCM.relRespVal = ""
	CUST.HOCCM.ServiceStat = ""
	CUST.HOCCM.ProcessStatus = ""
	CUST.HOCCM.ErrorCode = ""
	CUST.HOCCM.Data = ""
	CUST.HOCCM.respStatus = ""							
	CUST.HOCCM.respData = ""
	CUST.HOCCM.respmsg = ""
	CUST.HOCCM.ErrorCode = ""
	if(fieldexists(CUST.HOCCM.eventMode)==1)then
		print(CUST.HOCCM.eventMode)
	else
		CUST.HOCCM.eventMode = ""
	endif
	if(fieldexists(CUST.HOCCM.outboundId)==1)then
		print(CUST.HOCCM.outboundId)
	else
		CUST.HOCCM.outboundId = ""
	endif
	if(fieldexists(CUST.HOCCM.outboundRecValues)==1)then
		print(CUST.HOCCM.outboundRecValues)
	else
		CUST.HOCCM.outboundRecValues = ""
	endif
	if(fieldexists(CUST.HOCCM.FinTranId)==1)then
		print(CUST.HOCCM.FinTranId)
	else
		CUST.HOCCM.FinTranId = ""
	endif
	if(fieldexists(CUST.HOCCM.d1TranId)==1)then
		print(CUST.HOCCM.d1TranId)
	else
		CUST.HOCCM.d1TranId = ""
	endif
	if(fieldexists(CUST.HOCCM.d2CBStranId)==1)then
		print(CUST.HOCCM.d2CBStranId)
	else
		CUST.HOCCM.d2CBStranId = ""
	endif
        sv_a = urhk_getEnv("TBA_PROD_ROOT")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
		CUST.HOCCM.rootpath = "/finacle/EQPRODFI/BackEnd/Finacle/FC/app/cust/INFENG"
	else
		CUST.HOCCM.rootpath = BANCS.OUTPARAM.envValue
		CUST.HOCCM.rootpath = CUST.HOCCM.rootpath + "/cust/INFENG" 
        endif
        sv_a = urhk_getEnv("FIN_REPORTS_DIR")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
                CUST.INTERFACE.errorMsgFlg = "Y"
                CUST.INTERFACE.errorMsgDesc = "System Param Not Exists for Third Party Call Failed"
                goto ENDOFSCRIPT
        else
                CUST.HOCCM.ReptPath = BANCS.OUTPARAM.envValue
                CUST.HOCCM.ReptPath = CUST.HOCCM.ReptPath + "/" + BANCS.STDIN.userId
        endif
	print(CUST.HOCCM.rootpath)
        sv_s = "refNum|SELECT CONCAT(CONCAT('EQVPH',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5)))"
        sv_s = sv_s + " FROM DUAL"
        sv_d = urhk_dbSelectWithBind(sv_s)
        if(sv_d == 0)then
                CUST.HOCCM.refNum = BANCS.OUTPARAM.refNum
                print(CUST.HOCCM.refNum)
        endif
        CUST.HOCCM.edResp =  CUST.HOCCM.ReptPath + "/" +CUST.HOCCM.refNum + ".dat"
	print(CUST.HOCCM.edResp)
	if(CUST.HOCCM.outboundId=="RELEASE")then
		sv_d = "httpURL | select lower(v.parameter_value) from custom.c_cpvalue  v,custom.c_cpmaster m " 
		sv_d = sv_d + " where m.parameter_id=v.parameter_id "
		sv_d = sv_d + " and m.module_name =v.module_name " 
		sv_d = sv_d + " and m.module_name='CBSPRIMARY' " 
		sv_d = sv_d + " and m.parameter_level='BNKL' " 
		sv_d = sv_d + " and v.parameter_id=?SVAR " 
		sv_d = sv_d + " and m.entity_cre_flg='Y' " 
		sv_d = sv_d + " and v.entity_cre_flg='Y' " 
		sv_d = sv_d + " and m.del_flg='N' " 
		sv_d = sv_d + " and v.del_flg='N' " 
		sv_d = sv_d + " and m.bank_id=?SVAR "
		sv_d = sv_d + " and v.bank_id=?SVAR "  
		BANCS.INPARAM.BINDVARS = "RELURL|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.HOCCM.httpURL = BANCS.OUTPARAM.httpURL
		endif
	endif
	if(CUST.HOCCM.outboundId!="RELEASE")then
		sv_d = "httpURL | select lower(v.parameter_value) from custom.c_cpvalue  v,custom.c_cpmaster m " 
		sv_d = sv_d + " where m.parameter_id=v.parameter_id "
		sv_d = sv_d + " and m.module_name =v.module_name " 
		sv_d = sv_d + " and m.module_name='CBSPRIMARY' " 
		sv_d = sv_d + " and m.parameter_level='BNKL' " 
		sv_d = sv_d + " and v.parameter_id=?SVAR " 
		sv_d = sv_d + " and m.entity_cre_flg='Y' " 
		sv_d = sv_d + " and v.entity_cre_flg='Y' " 
		sv_d = sv_d + " and m.del_flg='N' " 
		sv_d = sv_d + " and v.del_flg='N' " 
		sv_d = sv_d + " and m.bank_id=?SVAR "
		sv_d = sv_d + " and v.bank_id=?SVAR "  
		BANCS.INPARAM.BINDVARS = "DELURL|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.HOCCM.httpURL = BANCS.OUTPARAM.httpURL
		endif
	endif
	CUST.HOCCM.ProductCode = "CCS_KEEQB" 
	CUST.HOCCM.ClientCode = "KEEQB" 
	CUST.HOCCM.CountryCode = "KE" 
	CUST.HOCCM.UserName = TRIM(BANCS.STDIN.userId) 
	if(CUST.HOCCM.eventMode=="RELEASE")then
		if(CUST.HOCCM.d1TranId!="")then
			CUST.HOCCM.FinnTranId = CUST.HOCCM.d1TranId 
		endif
		if(CUST.HOCCM.d2CBStranId!="")then
			CUST.HOCCM.FinnTranId = CUST.HOCCM.d2CBStranId 
		endif
	endif
	if((CUST.HOCCM.eventMode=="CANCEL")or(CUST.HOCCM.eventMode=="DELETE"))then
		if(CUST.HOCCM.d1TranId!="")then
			CUST.HOCCM.FinnTranId = CUST.HOCCM.d1TranId 
		endif
		if(CUST.HOCCM.d2CBStranId!="")then
			CUST.HOCCM.FinnTranId = CUST.HOCCM.d2CBStranId 
		endif
	endif
        CUST.HOCCM.jInp = CUST.HOCCM.httpURL + " " +  CUST.HOCCM.ProductCode+ " " + CUST.HOCCM.ClientCode + " " + CUST.HOCCM.CountryCode + " " + CUST.HOCCM.UserName + " " + CUST.HOCCM.FinnTranId 
        print(CUST.HOCCM.jInp)
	if(CUST.HOCCM.outboundId=="RELEASE")then
        sv_r=system("java -cp /finacle/jdk1.7.0_80/lib:/finacle/jdk1.7.0_80/custom:/finacle/jdk1.7.0_80/custom/json-simple-1.1.jar:/finacle/jdk1.7.0_80/custom/*.jar:" +CUST.HOCCM.rootpath+ " com.cubpEquityDirect.EBChequeRelease.EBChequeRelease "+ CUST.HOCCM.jInp + " >> " +CUST.HOCCM.edResp )
	print(sv_r)
	endif
	if(CUST.HOCCM.outboundId!="RELEASE")then
        sv_r=system("java -cp /finacle/jdk1.7.0_80/lib:/finacle/jdk1.7.0_80/custom:/finacle/jdk1.7.0_80/custom/json-simple-1.1.jar:/finacle/jdk1.7.0_80/custom/*.jar:" +CUST.HOCCM.rootpath+ " com.cubpEquityDirect.EBChequeDelete.EBChequeDelete "+ CUST.HOCCM.jInp + " >> " +CUST.HOCCM.edResp )
	print(sv_r)
	endif
        sv_a = urhk_getEnv("ONS_LOG_DIR")
        print(BANCS.OUTPARAM.envValue)
        if(sv_a == 1)then
                print("Env variable ONS/log not found")
                goto VAYU
        endif
        CUST.HOCCM.ONS_path = BANCS.OUTPARAM.envValue
        print(CUST.HOCCM.ONS_path)
        ##CUST.HOCCM.fileLoc = CUST.HOCCM.ONS_path +"/"+BANCS.STDIN.userId + "/" + CUST.HOCCM.edResp
        ##print(CUST.HOCCM.fileLoc)
        CUST.HOCCM.fileLoc = CUST.HOCCM.edResp 
        print(CUST.HOCCM.fileLoc)
	lv_u = system("chmod 755 " + CUST.HOCCM.fileLoc )
	print(lv_u)
        sv_r = urtn_fileAccess(CUST.HOCCM.fileLoc)
        print(sv_r)
        if(sv_r != 0)then
                CUST.HOCCM.excmessageField = "File does not exists"
                sv_z = urhk_SetOrbOut("Error_1|Error^File does not exist^txtFilename")
                goto VAYU
        else
                CUST.HOCCM.fileopen = "Y"
        endif
        print(CUST.HOCCM.fileopen)
        sv_s = urtn_fileOpen(CUST.HOCCM.fileLoc + "|r")
	print(sv_s)
        if(sv_s < 0)then
                print("error in openning file")
        else
		sv_k = urtn_fileRead(sv_s+"|CUST.HOCCM.Record1")
		CUST.HOCCM.recNum =1
		while(sv_k == 0)
		#{
			if(CUST.HOCCM.Record1 =="")then
				goto NEXTRECORD
			else
				print(CUST.HOCCM.Record1)
			endif
			if(CUST.HOCCM.eventMode=="RELEASE")then
				CUST.HOCCM.relRespVal = CUST.HOCCM.Record1	
			endif
			if(CUST.HOCCM.outboundId!="RELEASE")then
				CUST.HOCCM.delRespVal = CUST.HOCCM.Record1	
			endif
			NEXTRECORD:
			sv_k = urtn_fileRead(sv_s+"|CUST.HOCCM.Record1")
			print(CUST.HOCCM.recNum)
			CUST.HOCCM.recNum = CINT(CUST.HOCCM.recNum) +1
			print(CUST.HOCCM.recNum)
		#}
		do
        endif
	if(CUST.HOCCM.eventMode=="RELEASE")then
		CUST.HOCCM.trSting = CUST.HOCCM.relRespVal 
                sv_l = strlen(CUST.HOCCM.trSting)
                sv_f = mid$(CUST.HOCCM.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.HOCCM.ServiceStat  = mid$(sv_f,0,(sv_p-1))
                print(CUST.HOCCM.ServiceStat)
		CUST.HOCCM.trSting = mid$(sv_f,sv_p,sv_l)
                print(CUST.HOCCM.trSting)
                sv_l = strlen(CUST.HOCCM.trSting)
                sv_f = mid$(CUST.HOCCM.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.HOCCM.ProcessStatus  = mid$(sv_f,0,(sv_p-1))
                print(CUST.HOCCM.ProcessStatus)
                #--
		CUST.HOCCM.ErrorCode = mid$(sv_f,sv_p,sv_l)
                print(CUST.HOCCM.ErrorCode)
	endif
	###FAILURE|FAILURE|IDE_SERVICE_10005| NO JSON FOUND in CORE USER TABLE
	if((CUST.HOCCM.delRespVal!="") and ((CUST.HOCCM.eventMode=="CANCEL") or (CUST.HOCCM.eventMode=="DELETE")))then
		CUST.HOCCM.trSting = CUST.HOCCM.delRespVal 
                sv_l = strlen(CUST.HOCCM.trSting)
                sv_f = mid$(CUST.HOCCM.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                CUST.HOCCM.ServiceStat  = mid$(sv_f,0,(sv_p-1))
                print(CUST.HOCCM.ServiceStat)
                #--
		CUST.HOCCM.ProcessStatus = mid$(sv_f,sv_p,sv_l)
                print(CUST.HOCCM.ProcessStatus)
	endif

VAYU:
	##sv_s = system("rm -f " + CUST.HOCCM.fileLoc ) 
        ##print(sv_s)
        exitscript
######trace off
end-->
