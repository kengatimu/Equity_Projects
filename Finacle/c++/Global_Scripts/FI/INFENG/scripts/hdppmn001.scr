<--start
trace on
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
	if(repexists("EQSRV") == 0) then
	    createrep("EQSRV")
	endif 
	if(classexists("EQSRV","GLBDATA") == 0)then
	    createclass("EQSRV","GLBDATA",5)
	endif
	EQSRV.GLBDATA.errMsg	    = ""
	EQSRV.GLBDATA.srvYN	    = ""
	EQSRV.GLBDATA.userWorkClass1= ""
	EQSRV.GLBDATA.userWorkClass2= ""
	EQSRV.GLBDATA.acctcrncycode = ""
	EQSRV.GLBDATA.solid         = ""
	EQSRV.GLBDATA.foracid = ""

	EQSRV.GLBDATA.foracid 		= TRIM(BANCS.INPUT.accNum)
	print(EQSRV.GLBDATA.foracid)
	if(fieldexists(BANCS.INPUT.funcCode)==1)then
		EQSRV.GLBDATA.funCode = BANCS.INPUT.funcCode
	else
		EQSRV.GLBDATA.funCode = ""
	endif
	if(fieldexists(BANCS.INPUT.consentO)==1)then
		EQSRV.GLBDATA.consentO = BANCS.INPUT.consentO
	else
		EQSRV.GLBDATA.consentO = ""
	endif
	if(fieldexists(BANCS.INPUT.consentT)==1)then
		EQSRV.GLBDATA.consentT = BANCS.INPUT.consentT
	else
		EQSRV.GLBDATA.consentT = ""
	endif
	if(fieldexists(BANCS.INPUT.consentR)==1)then
		EQSRV.GLBDATA.consentR = BANCS.INPUT.consentR
	else
		EQSRV.GLBDATA.consentR = ""
	endif
	if(fieldexists(BANCS.INPUT.consentF)==1)then
		EQSRV.GLBDATA.consentF = BANCS.INPUT.consentF
	else
		EQSRV.GLBDATA.consentF = ""
	endif
	if(EQSRV.GLBDATA.consentO=="")then
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Value^consentO"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	if(EQSRV.GLBDATA.consentT=="")then
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Value^consentT"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	if(EQSRV.GLBDATA.consentR=="")then
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Value^consentR"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	if(EQSRV.GLBDATA.consentF=="")then
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Value^consentF"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	if(EQSRV.GLBDATA.funCode=="")then
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Function^funcCode"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	if(EQSRV.GLBDATA.foracid=="")then
		EQSRV.GLBDATA.errMsg = "Invalid Account"
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Account^accNum"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	if((EQSRV.GLBDATA.funCode=="C") and (BANCS.INPUT.gdprYn=="N"))then
		BANCS.STDIN.msg = "Error_1|Error.1 ^Customer Not Accepted GDPR Terms^gdprYn"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
        if(sv_u ==0)then
                EQSRV.GLBDATA.glSubHeadCode     = BANCS.OUTPARAM.glSubHeadCode
                EQSRV.GLBDATA.solId     =       BANCS.OUTPARAM.acctSolId
                EQSRV.GLBDATA.schmType  =       BANCS.OUTPARAM.schmType
                EQSRV.GLBDATA.schmCode  =       BANCS.OUTPARAM.schmCode
                EQSRV.GLBDATA.crncyCode =       BANCS.OUTPARAM.acctCrncyCode    
                EQSRV.GLBDATA.acctClsFlg        =       BANCS.OUTPARAM.acctCloseflg
                EQSRV.GLBDATA.clearBalance      = BANCS.OUTPARAM.clearBalance
	else
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Account^accNum"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
        endif
	if((EQSRV.GLBDATA.consentO=="N")and(EQSRV.GLBDATA.consentT=="N")and(EQSRV.GLBDATA.consentR=="N")and(EQSRV.GLBDATA.consentF=="N"))then
		EQSRV.GLBDATA.isconYN = "N"
	else
		EQSRV.GLBDATA.isconYN = "Y"
	endif
	lv_d = " cgdprCnt | select count(*) from custom.gdpr where bank_id=?SVAR  and foracid =?SVAR and entity_cre_flg='Y' and del_flg='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.foracid
	print(lv_d)
	print(BANCS.INPARAM.BINDVARS)
	lv_s = urhk_dbSelectWithBind(lv_d)
	print(lv_s)
	if(lv_s==0)then
		EQSRV.GLBDATA.cgdprCnt = BANCS.OUTPARAM.cgdprCnt
	else
		EQSRV.GLBDATA.cgdprCnt = "0"
	endif
	sv_u = "empSol,empBankId | select sol_id,home_bank_id from tbaadm.upr where user_id=?SVAR and del_flg='N' and entity_cre_flg='Y' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId 
	sv_u = urhk_dbSelectWithBind(sv_u)
	if(sv_u==0)then
		EQSRV.GLBDATA.empSol = BANCS.OUTPARAM.empSol
		EQSRV.GLBDATA.empBankId = BANCS.OUTPARAM.empBankId
	else
		EQSRV.GLBDATA.empSol = "" 
		EQSRV.GLBDATA.empBankId = "" 
	endif
	 EQSRV.GLBDATA.datee = mid$(BANCS.STDIN.BODDate,0,10)
##Employee/AcctSol Val
	if(EQSRV.GLBDATA.solId!=EQSRV.GLBDATA.empSol)then
		EQSRV.GLBDATA.errMsg = "Account and User Branch Differs ! GDPR Failed"
		EQSRV.GLBDATA.srvYN  = "F"
		##goto VAYU
	endif
	if(EQSRV.GLBDATA.empBankId!=BANCS.STDIN.contextBankId)then
		EQSRV.GLBDATA.errMsg = "HomeBank Differs ! GDPR Failed"
		EQSRV.GLBDATA.srvYN  = "F"
		BANCS.STDIN.msg = "Error_1|Error.1 ^HomeBank Differs ! GDPR Failed^accNum"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
	if(sv_u==0)then
		EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
		EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
		EQSRV.GLBDATA.acctSolId = BANCS.OUTPARAM.acctSolId
		EQSRV.GLBDATA.CifId = BANCS.OUTPARAM.cifId
		EQSRV.GLBDATA.custId = BANCS.OUTPARAM.custId
	else
		EQSRV.GLBDATA.errMsg = "HomeBank Differs ! GDPR Failed"
		EQSRV.GLBDATA.srvYN  = "F"
		BANCS.STDIN.msg = "Error_1|Error.1 ^Invalid Account^accNum"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	endif
	if((EQSRV.GLBDATA.funCode=="I") or (EQSRV.GLBDATA.funCode=="C"))then
	#{
		sv_d = "gdprVal | select free_text_19 from tbaadm.gac "
		sv_d = sv_d + " where acid in (select acid from tbaadm.gam where foracid='"+EQSRV.GLBDATA.foracid+"' "
		sv_d = sv_d + " and bank_id='"+BANCS.STDIN.contextBankId+"')"
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQSRV.GLBDATA.gdprVal = BANCS.OUTPARAM.gdprVal
		else
			EQSRV.GLBDATA.gdprVal = "N"
		endif
		if((EQSRV.GLBDATA.gdprVal=="GDPR")and(EQSRV.GLBDATA.funCode!="C"))then
			EQSRV.GLBDATA.errMsg = "GDPR Already Registered for Customer"
			EQSRV.GLBDATA.srvYN  = "F"
			BANCS.STDIN.msg = "Error_1|Error.1 ^GDPR Already Registered for Customer!^accNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		endif
		if((EQSRV.GLBDATA.funCode!="C") and (EQSRV.GLBDATA.gdprVal!="GDPR"))then
			EQSRV.GLBDATA.errMsg = "GDPR Already Registered for Customer"
			EQSRV.GLBDATA.srvYN  = "F"
			BANCS.STDIN.msg = "Error_1|Error.1 ^GDPR Not Maintained for Customer!^accNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		endif
	#}
	endif
	if(EQSRV.GLBDATA.isconYN=="Y")then
	sv_u = "update tbaadm.gac set free_text_19 ='GDPR' where bank_id='"+BANCS.STDIN.contextBankId+"' "  
	else
	sv_u = "update tbaadm.gac set free_text_19 =null where bank_id='"+BANCS.STDIN.contextBankId+"' "  
	endif
	##sv_u = "update tbaadm.gac set free_text_15 ='GDPR' where bank_id='"+BANCS.STDIN.contextBankId+"' "  
	sv_u = sv_u + " and acid in (select acid from tbaadm.gam where cif_id='"+EQSRV.GLBDATA.CifId+"' "
	sv_u = sv_u + " and bank_id='"+BANCS.STDIN.contextBankId+"') "
	#BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId 
	#print(BANCS.INPARAM.BINDVARS)
	print(sv_u)
	sv_d = urhk_dbSqlWithBind(sv_u)
	if(sv_d==0)then
	#{
		sv_d = urhk_dbSqlWithBind("Commit")
		print(sv_d)
		if(sv_d==0)then
		#{
			if(EQSRV.GLBDATA.isconYN=="Y")then
			sv_u = "update  crmuser.accounts set STRUSERFIELD14 ='GDPR' where orgkey =?SVAR and bank_id =?SVAR"	
			else
			sv_u = "update  crmuser.accounts set STRUSERFIELD14 =null where orgkey =?SVAR and bank_id =?SVAR"	
			endif
			BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.CifId + "|" + BANCS.STDIN.contextBankId
			print(sv_u)
			sv_d = urhk_dbSqlWithBind(sv_u)
			if(sv_d==0)then
			#{
				sv_d = urhk_dbSqlWithBind("Commit")
				print(sv_d)
				if(sv_d==0)then
				#{
					if(cdouble(EQSRV.GLBDATA.cgdprCnt)==0)then
					#{
					sv_i = "insert into custom.gdpr (bank_id,sol_id,foracid,gdpr_date,entity_cre_flg,del_flg,rcre_user_id,rcre_time,free_text,consent_status1,consent_status2,consent_status3,consent_status4) "
					sv_i = sv_i + "  values (?SVAR,?SVAR,?SVAR,to_date(?SVAR,'DD-MM-RRRR'),'Y','N',?SVAR,to_date(?SVAR,'DD-MM-RRRR'),'HDPP',?SVAR,?SVAR,?SVAR,?SVAR) "	
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.solId + "|" + EQSRV.GLBDATA.foracid + "|" + EQSRV.GLBDATA.datee + "|" + BANCS.STDIN.userId + "|" + EQSRV.GLBDATA.datee + "|" + EQSRV.GLBDATA.consentO + "|" + EQSRV.GLBDATA.consentT + "|" + EQSRV.GLBDATA.consentR + "|" + EQSRV.GLBDATA.consentF
					print(BANCS.INPARAM.BINDVARS)
					print(sv_i)
					sv_d = urhk_dbSqlWithBind(sv_i)
					if(sv_d==0)then
						sv_d = urhk_dbSqlWithBind("Commit")
						sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
						sv_g = "RESULT_MSG|DPP maintained Successfully"
						sv_z = urhk_SetOrbOut(sv_g)
						exitscript
					else
						EQSRV.GLBDATA.errMsg = "HomeBank Differs ! GDPR Failed"
						EQSRV.GLBDATA.srvYN  = "F"
						BANCS.STDIN.msg = "Error_1|Error.1 ^HomeBank Differs ! GDPR Failed^accNum"
						sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
						sv_z = "SuccessOrFailure|N"
						sv_u = urhk_SetOrbOut(sv_z)
						exitscript
					endif
					else
					lv_g = "update custom.gdpr set consent_status1=?SVAR,consent_status2=?SVAR,consent_status3=?SVAR,consent_status4=?SVAR,lchg_user_id=?SVAR,lchg_time=sysdate where bank_id=?SVAR and foracid=?SVAR and entity_cre_flg='Y' and del_flg='N' " 
					BANCS.INPARAM.BINVARS = EQSRV.GLBDATA.consentO + "|" + EQSRV.GLBDATA.consentT + "|" + EQSRV.GLBDATA.consentR + "|" + EQSRV.GLBDATA.consentF + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.foracid
					print(lv_g)
					print(BANCS.INPARAM.BINVARS)
					sv_d = urhk_dbSqlWithBind(lv_g)
					if(sv_d==0)then
						sv_d = urhk_dbSqlWithBind("Commit")
						sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
						sv_g = "RESULT_MSG|DPP maintained Successfully"
						sv_z = urhk_SetOrbOut(sv_g)
						exitscript
					else
						EQSRV.GLBDATA.errMsg = "HomeBank Differs ! GDPR Failed"
						EQSRV.GLBDATA.srvYN  = "F"
						BANCS.STDIN.msg = "Error_1|Error.1 ^HomeBank Differs ! GDPR Failed^accNum"
						sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
						sv_z = "SuccessOrFailure|N"
						sv_u = urhk_SetOrbOut(sv_z)
						exitscript
					endif
					#}	
					endif
				else
					EQSRV.GLBDATA.errMsg = "Update failed ! GDPR Failed"
					EQSRV.GLBDATA.srvYN  = "F"
					BANCS.STDIN.msg = "Error_1|Error.1 ^Update failed ! GDPR Failed^accNum"
					sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
					sv_z = "SuccessOrFailure|N"
					sv_u = urhk_SetOrbOut(sv_z)
					exitscript
				#}
				endif

			else
				EQSRV.GLBDATA.errMsg = "Update failed ! GDPR Failed"
				EQSRV.GLBDATA.srvYN  = "F"
				BANCS.STDIN.msg = "Error_1|Error.1 ^Update failed ! GDPR Failed^accNum"
				sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
				sv_z = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_z)
				exitscript
			#}
			endif

		else
			EQSRV.GLBDATA.errMsg = "Update failed ! GDPR Failed"
			EQSRV.GLBDATA.srvYN  = "F"
			BANCS.STDIN.msg = "Error_1|Error.1 ^Update failed ! GDPR Failed^accNum"
			sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			exitscript
		#}
		endif
	else
		EQSRV.GLBDATA.errMsg = "HomeBank Differs ! GDPR Failed"
		EQSRV.GLBDATA.srvYN  = "F"
		BANCS.STDIN.msg = "Error_1|Error.1 ^HomeBank Differs ! GDPR Failed^accNum"
		sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
		sv_z = "SuccessOrFailure|N"
		sv_u = urhk_SetOrbOut(sv_z)
		exitscript
	#}
	endif
trace off
end-->
