<--start
trace on
        if(repexists("VERRE")==0)then
                createrep("VERRE")
        endif
        if(classexists("VERRE","GLBDATA")==0)then
                createclass("VERRE","GLBDATA",5)
        endif
        if(fieldexists(BANCS.INPUT.zsolid)==1)then
                VERRE.GLBDATA.zoneSolId = BANCS.INPUT.zsolid
        else
                VERRE.GLBDATA.zoneSolId = ""
        endif
        if(fieldexists(BANCS.INPUT.zoneDate)==1)then
                VERRE.GLBDATA.zoneDate = BANCS.INPUT.zoneDate
                VERRE.GLBDATA.zoneDate = VERRE.GLBDATA.zoneDate + " 00:00:00"
        else
                VERRE.GLBDATA.zoneDate = ""
        endif
        if(fieldexists(BANCS.INPUT.zoneCode)==1)then
                VERRE.GLBDATA.zoneCode = BANCS.INPUT.zoneCode
        else
                VERRE.GLBDATA.zoneCode = ""
        endif

        if(VERRE.GLBDATA.zoneSolId=="")then
        #{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Enter Zone Solid")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        #}
        endif
        if(VERRE.GLBDATA.zoneDate=="")then
        #{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Enter Zone Date")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        #}
        endif
        if(VERRE.GLBDATA.zoneCode=="")then
        #{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|Enter Zone Code")
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        #}
        endif
	VERRE.GLBDATA.srvErrMsg = ""
	VERRE.GLBDATA.srvErrCode = ""
	VERRE.GLBDATA.srvSucFail = ""

	lv_j = " zsolid,zdate,zcode,zsetnum,zinstSrlNum,zinstId,zinstDate,zinstAmt,zstatusFlg,zstatusDesc,zvalueDate,zcrncyCode,zPayingAcct|select sol_id,clg_zone_date,clg_zone_code,set_num,instrmnt_srl_num,instrmnt_id,instrmnt_date,instrmnt_amt,status_flg,decode(status_flg,'R','Released to Shadow Balance','G','Regularized','P','Pending','W','Pending and Rejected','O','Released and Rejected','J','Regularized and Rejected') as status_desc,value_date,crncy_code,paying_acct_id "
	lv_j = lv_j + " from tbaadm.oci " 
	lv_j = lv_j + " where bank_id=?SVAR "
	lv_j = lv_j + " and clg_zone_date=to_date(?SVAR,'DD-MM-RRRR') "
	lv_j = lv_j + " and clg_zone_code=?SVAR "
	lv_j = lv_j + " and sol_id=?SVAR "
	lv_j = lv_j + " order by set_num "
	print(lv_j)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + left$(VERRE.GLBDATA.zoneDate,10) + "|" + VERRE.GLBDATA.zoneCode + "|" + VERRE.GLBDATA.zoneSolId 
	print(BANCS.INPARAM.BINDVARS)
	print(lv_j)
        sv_u = urhk_dbCursorOpenWithBind(lv_j)
        if(sv_u==0)then
        #{
                VERRE.GLBDATA.ocirecord = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        #}
        else
        #{
                VERRE.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                VERRE.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                VERRE.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        VERRE.GLBDATA.ocirecc = 0
        sv_z = urhk_dbCursorFetch(VERRE.GLBDATA.ocirecord)
        if(sv_z!=0)then
        #{
                VERRE.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                VERRE.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                VERRE.GLBDATA.srvSucFail = "F"
                goto Endofscript
        #}
        endif
        print(sv_z)
        while(sv_z ==0)
        ##{
			VERRE.GLBDATA.zsolid = BANCS.OUTPARAM.zsolid
			VERRE.GLBDATA.zdate = BANCS.OUTPARAM.zdate
			VERRE.GLBDATA.zcode = BANCS.OUTPARAM.zcode
			VERRE.GLBDATA.zsetnum = BANCS.OUTPARAM.zsetnum
			VERRE.GLBDATA.zinstSrlNum = BANCS.OUTPARAM.zinstSrlNum
			VERRE.GLBDATA.zinstId = BANCS.OUTPARAM.zinstId
			VERRE.GLBDATA.zinstDate = BANCS.OUTPARAM.zinstDate
			VERRE.GLBDATA.zinstAmt = BANCS.OUTPARAM.zinstAmt
			VERRE.GLBDATA.zstatusFlg = BANCS.OUTPARAM.zstatusFlg
			VERRE.GLBDATA.zstatusDesc = BANCS.OUTPARAM.zstatusDesc
			VERRE.GLBDATA.zvalueDate = BANCS.OUTPARAM.zvalueDate
			VERRE.GLBDATA.zcrncyCode = BANCS.OUTPARAM.zcrncyCode
			VERRE.GLBDATA.zPayingAcct = BANCS.OUTPARAM.zPayingAcct


			print(VERRE.GLBDATA.zsolid)
			print(VERRE.GLBDATA.zdate)
			print(VERRE.GLBDATA.zcode)
			print(VERRE.GLBDATA.zsetnum)
			print(VERRE.GLBDATA.zinstSrlNum)
			print(VERRE.GLBDATA.zinstId)
			print(VERRE.GLBDATA.zinstDate)
			print(VERRE.GLBDATA.zinstAmt)
			print(VERRE.GLBDATA.zstatusFlg) 
			print(VERRE.GLBDATA.zstatusDesc)
			print(VERRE.GLBDATA.zvalueDate) 
			print(VERRE.GLBDATA.zcrncyCode) 
			print(VERRE.GLBDATA.zPayingAcct)

			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneSolId |" + VERRE.GLBDATA.zsolid )
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneDate |" + VERRE.GLBDATA.zdate ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneCode |" + VERRE.GLBDATA.zcode ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneSetNumber |" + VERRE.GLBDATA.zsetnum ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.InstrumentSerialNumber |" + VERRE.GLBDATA.zinstSrlNum ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.InstrumentNumber |" + VERRE.GLBDATA.zinstId ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.InstrumentDate |" + VERRE.GLBDATA.zinstDate ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.InstrumentAmount |" + VERRE.GLBDATA.zinstAmt ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneStatusFlg |" + VERRE.GLBDATA.zstatusFlg ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneStatusDesc |" + VERRE.GLBDATA.zstatusDesc ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneValueDate |" + VERRE.GLBDATA.zvalueDate ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.ZoneCrncyCode |" + VERRE.GLBDATA.zcrncyCode ) 
			sv_u = urhk_SetOrbOut("ZoneDetails.<rec_" + VERRE.GLBDATA.ocirecc + ">.PayingAccountId |" + VERRE.GLBDATA.zPayingAcct ) 

                        print(VERRE.GLBDATA.srvErrMsg)
                        print(VERRE.GLBDATA.srvErrCode)
                        print(VERRE.GLBDATA.srvSucFail)
                        sv_u = urhk_dbCursorFetch(VERRE.GLBDATA.ocirecord)
                        print(sv_u)
                        if(sv_u!=0)then
                        #{
                                print("fetch failed")
                                sv_u = urhk_dbCursorClose(VERRE.GLBDATA.ocirecord)
                                print(sv_u)
                                VERRE.GLBDATA.srvErrMsg =  "Demand Cursor Fetch Failed"
                                VERRE.GLBDATA.srvErrCode = "DBCursor"
                                VERRE.GLBDATA.srvSucFail = "F"
                                goto Endofscript
                        #}
                        endif
                        VERRE.GLBDATA.ocirecc = cint(VERRE.GLBDATA.ocirecc) + 1
                        VERRE.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + VERRE.GLBDATA.ocirecc
                        print(VERRE.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(VERRE.GLBDATA.ocirecord)
        print(sv_u)
Endofscript:
        print(VERRE.GLBDATA.srvErrCode)
        print(VERRE.GLBDATA.srvErrMsg)
        print(VERRE.GLBDATA.srvSucFail)
        exitscript
###trace off
end-->
