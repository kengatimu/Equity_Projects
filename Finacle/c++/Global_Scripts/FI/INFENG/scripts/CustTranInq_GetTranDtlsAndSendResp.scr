#----------------------------------------------------------------------------------------------------------
# Filename              :       CustTranInq_GetTranDtlsAndSendResp.scr
# Author                :       Eshan Babbar
# Description           :       This script gets the values required as a part of response
# Input                 :       Transaction ID, Transaction Date, Reference Number
# Output                :       None
# Called Script         :       CustTranInq_SendResponse.scr
# Calling Script        :       CustTranInq_main.scr                                                            
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           14-03-2012         Eshan Babbar      Original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--start
TRACE ON

#========================================================	
# Fetching the details from DTD/HTD table
#========================================================
BANCS.INPARAM.BINDVARS = ""
BANCS.INPARAM.BINDVARS = CUST.INTERFACE.tranID
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|" + CUST.INTERFACE.tranDate
IF(CUST.INTERFACE.refNum != "") THEN
#{
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|" + CUST.INTERFACE.refNum
#}
ENDIF
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|" + CUST.INTERFACE.BankId
print(BANCS.INPARAM.BINDVARS)
sv_s = ""
sv_s = sv_s + "pstdDate,pstdFlag,tranType,acId,partTranType,partTranSrlNum,tranRmks,tranAmt,tranCrncy,tranPart,tranPart2|"
sv_s = sv_s + "SELECT TO_CHAR(" + CUST.INTERFACE.shortName + ".PSTD_DATE, 'YYYY-MM-DD HH:MM:SS')," 
sv_s = sv_s + CUST.INTERFACE.shortName + ".PSTD_FLG," + CUST.INTERFACE.shortName + ".TRAN_TYPE,GAM.FORACID,"
sv_s = sv_s + CUST.INTERFACE.shortName + ".PART_TRAN_TYPE," + CUST.INTERFACE.shortName + ".PART_TRAN_SRL_NUM,"
sv_s = sv_s + CUST.INTERFACE.shortName + ".TRAN_RMKS," + CUST.INTERFACE.shortName + ".TRAN_AMT,"
sv_s = sv_s + CUST.INTERFACE.shortName + ".TRAN_CRNCY_CODE," + CUST.INTERFACE.shortName + ".TRAN_PARTICULAR," 
sv_s = sv_s + CUST.INTERFACE.shortName + ".TRAN_PARTICULAR_2 FROM "
sv_s = sv_s + CUST.INTERFACE.tableName + " " + CUST.INTERFACE.shortName 
#sv_s = sv_s + ", TBAADM.GAM GAM WHERE TRIM(" + CUST.INTERFACE.shortName + ".TRAN_ID) = ?SVAR AND "
sv_s = sv_s + ", TBAADM.GAM GAM WHERE " + CUST.INTERFACE.shortName + ".TRAN_ID  = lpad(?SVAR,9,' ') AND "
sv_s = sv_s + CUST.INTERFACE.shortName + ".TRAN_DATE = TO_CHAR(TO_DATE(?SVAR,'DD-MM-YYYY'), 'DD-MON-YYYY') "

IF(CUST.INTERFACE.refNum != "") THEN
#{
	sv_s = sv_s + " AND CUST.INTERFACE.shortName.TRAN_RMKS = ?SVAR "
#}
ENDIF	
sv_s = sv_s + " AND " + CUST.INTERFACE.shortName + ".DEL_FLG = 'N' AND " + CUST.INTERFACE.shortName + ".BANK_ID = ?SVAR "
sv_s = sv_s + " AND GAM.ACID = " + CUST.INTERFACE.shortName + ".ACID"
print(sv_s)

sv_d = urhk_dbCursorOpenWithBind(sv_s)
#print(sv_d)
IF(sv_d == 0) THEN
#{
	sv_c = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	#print(sv_c)
	sv_r = urhk_dbCursorFetch(sv_c)
#}
ELSE
#{
	#print("No record exists for TranID, TranDate and BankID.")
	CUST.INTERFACE.successOrFailure="F"
	CUST.INTERFACE.errorCode="ERR041"
	GOTO ERROREXIT
#}
ENDIF
CUST.INTERFACE.pstdDate = BANCS.OUTPARAM.pstdDate
CUST.INTERFACE.tranType = BANCS.OUTPARAM.tranType
#changing date format to YYYY-MM-DDTHH:MM:SS.SSS
print(CUST.INTERFACE.pstdDate)
sv_y = strlen(CUST.INTERFACE.pstdDate)
sv_e = MID$(CUST.INTERFACE.pstdDate , 0, 10)
sv_p = MID$(CUST.INTERFACE.pstdDate , 11, sv_y)
CUST.INTERFACE.pstdDate = sv_e + "T" + sv_p + ".000"
sv_n = 0
sv_l = 0
WHILE (sv_r == 0)
	sv_l = sv_l + 1
	CUST.INTERFACE.acId = BANCS.OUTPARAM.acId
	CUST.INTERFACE.partTranType = BANCS.OUTPARAM.partTranType
	CUST.INTERFACE.partTranSrlNum = BANCS.OUTPARAM.partTranSrlNum
	CUST.INTERFACE.pstdFlag = BANCS.OUTPARAM.pstdFlag
	CUST.INTERFACE.tranRmks = BANCS.OUTPARAM.tranRmks
	CUST.INTERFACE.tranAmt = BANCS.OUTPARAM.tranAmt
	CUST.INTERFACE.tranCrncy = BANCS.OUTPARAM.tranCrncy
	CUST.INTERFACE.tranPart = BANCS.OUTPARAM.tranPart
	CUST.INTERFACE.tranPart2 = BANCS.OUTPARAM.tranPart2
	CALL("CustTranInq_SendResponse.scr")		
	# Fetching next record
	sv_r = urhk_dbCursorFetch(sv_c)
	sv_n = sv_n + 1
DO
sv_c = urhk_dbCursorClose(sv_c)
EXITSCRIPT
END-->
