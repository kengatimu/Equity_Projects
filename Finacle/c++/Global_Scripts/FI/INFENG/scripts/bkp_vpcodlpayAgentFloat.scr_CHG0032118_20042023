	print(EQOD.GLBDATA.opEffAmt)
	print(EQOD.GLBDATA.laEffAmt)
	#R partial pay P payoff
	if(cdouble(EQOD.GLBDATA.laEffAmt)  < 0 )then
	#{
		EQOD.GLBDATA.laEffAmt = -1 * cdouble(EQOD.GLBDATA.laEffAmt)
	#}
	endif
	if(EQOD.GLBDATA.funcCode=="P")then
	if(cdouble(EQOD.GLBDATA.laEffAmt) > cdouble(EQOD.GLBDATA.opEffAmt))then
	#{
                BANCS.STDIN.msg = "Error_1|Error.1 ^Insufficient Fund in operative account^refAmt"
                sv_u = urhk_SetOrbOut(BANCS.STDIN.msg)
                sv_z = "SuccessOrFailure|N"
                sv_u = urhk_SetOrbOut(sv_z)
                exitscript
	#}
	endif
	endif
	sv_u = urhk_getFileLocation("COM|vpcodlpayAgentFloat.com")
	print(sv_u)
	print(BANCS.OUTPARAM.fileLocation)
	if(sv_u == 0)then
	#{
		sv_a = "LoanAcctId|" + EQOD.GLBDATA.accNum
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		##sv_a = "OperAcctNum|" + EQOD.GLBDATA.OperaccNum
		sv_a = "OperAcctNum|" + EQOD.GLBDATA.ldrAcct 
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		sv_a = "RecoverAmt|" + EQOD.GLBDATA.refAmt
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		sv_a = "FunctionC|" + EQOD.GLBDATA.funcCode
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		sv_a = "stuserId|" + BANCS.STDIN.userId
