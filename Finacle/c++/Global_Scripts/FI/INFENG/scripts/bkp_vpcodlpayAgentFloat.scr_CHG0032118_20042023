		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		sv_a = "EventType|ONSPAY"
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		BANCS.INPARAM.scriptName = "vpcodlpayAgentFloat.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		if(sv_u != 0)then
		#{
			print("failed")
		#}
		else
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			EQOD.GLBDATA.msg = "Agent Float Loan Payment Initiated Successfully. Please Visit HPR Menu in While"
			sv_c = urhk_SetOrbOut("RESULT_MSG|" + EQOD.GLBDATA.msg )
			print(sv_c)
			exitscript
		#}
		endif
