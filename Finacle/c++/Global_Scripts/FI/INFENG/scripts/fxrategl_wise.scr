                                                                goto end
                                                        ELSE
                                                                IF (CUST.DATA.to_currency != CUST.DATA.from_currency) THEN
                                                                #{
                                                                        CUST.DATA.errMsg="Rate Not Maintained"
                                                                        sv_e=urhk_SetOrbOut("StatusCode|2")
                                                                        sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
                                                                #}
                                                                ENDIF
                                                                print("Rate Not Maintained")
                                                        endif
                                                endif
                                        #####
                                ENDIF

                        ####
                        print(CUST.DATA.FreeCode7)
                        sv_z = urhk_SetOrbOut("FXGROUP_CODE|"+CUST.DATA.FreeCode7)
                        print(sv_z)
                        sv_e=urhk_SetOrbOut("StatusCode|1")
                        #ELSE
                                #sv_e=urhk_SetOrbOut("StatusCode|2")
                                #CUST.DATA.errMsg="Customer Not Maintained for Special Rates"
                                #sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)

                        #ENDIF
        ELSE
                CUST.DATA.errMsg="Invalid Account"
                sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
                GOTO End
        ENDIF

        HandleError:
        if(CUST.DATA.errMsg!="")then
        sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
        endif

        End:
                EXITSCRIPT
                TRACE OFF
END-->
