<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	#----------------------------------------------------------------------------------------------
	# VALIDATIONS // INITIALIZATION
	#----------------------------------------------------------------------------------------------

	IF( (FIELDEXISTS(("BANCS").("INPUT").("TranDate"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="please enter Transaction Date"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
	ELSE 
		CUST.EZB.tranDate = ("BANCS").("INPUT").("TranDate")
		print(CUST.EZB.tranDate)
	#}
	ENDIF

	IF( (FIELDEXISTS(BANCS.INPUT.TranId)== 0) ) THEN
	#{
   		CUST.EZB.errMsg="please enter Transaction Id"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
	ELSE 
		CUST.EZB.tranId = BANCS.INPUT.TranId
		print(CUST.EZB.tranId)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("AccountNo"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Account Number"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
	ELSE 
		CUST.EZB.acctNum = TRIM( ("BANCS").("INPUT").("AccountNo") )
		print(CUST.EZB.acctNum)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("TranAmt"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Transaction Amount"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
	ELSE 
		CUST.EZB.tranAmt = TRIM( ("BANCS").("INPUT").("TranAmt") )
		print(CUST.EZB.tranAmt)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("TranType"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Part Tran Type"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
	ELSE 
		CUST.EZB.tranType = TRIM( ("BANCS").("INPUT").("TranType") )
		print(CUST.EZB.tranType)
	#}
	ENDIF

	sv_u = urhk_B2k_ForacidToAcid(CUST.EZB.acctNum)
    print(sv_u)
    if (sv_u ==0) then
    #{
        CUST.EZB.acid=BANCS.OUTPARAM.Acid
        print(CUST.EZB.acid)
    else
        CUST.EZB.errMsg = "Invaid Account Number."
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + " ["+CUST.EZB.acctNum+"] " + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
    #}
    endif

	sv_a = urhk_getAcctDetailsInRepository(CUST.EZB.acctNum)
	print(sv_a)

	IF(sv_a == 0)THEN
	#{
		CUST.EZB.acctName = BANCS.OUTPARAM.acctName
		print(CUST.EZB.acctName)
	ELSE
		CUST.EZB.errMsg = "Invaid Account Number."
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + " ["+CUST.EZB.acctNum+"] " + "^BE"
		sv_u = urhk_SetOrbErr(sv_c) 
		exitscript
	#}
	ENDIF

	lv_c = " "
	CUST.EZB.maxTranIdLen = "9"
	CUST.EZB.buyAmt = " "
	CUST.EZB.sellAmt = " "
	CUST.EZB.BODFlg = ""

	#---------------------------------------------------------------------------------------------------------------
	# IMPLEMENTATION
	#---------------------------------------------------------------------------------------------------------------

	sv_g = urhk_B2k_getDateDiffFromBODDate(CUST.EZB.tranDate)
	print(sv_g)

	IF(sv_g == 0)THEN
	#{
		lv_d = BANCS.OUTPARAM.DateDiff
		print(lv_d)

		IF(lv_d == 0)THEN
		#{
			CUST.EZB.BODFlg = "Y"
		ELSE
			CUST.EZB.BODFlg = "N"
		#}
		ENDIF
	ELSE
		CUST.EZB.BODFlg = ""
		CUST.EZB.errMsg = "Kindly Enter the Date in format:[dd-mm-yyyy]"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg +"^BE"
		sv_u = urhk_SetOrbErr(sv_c) 
		exitscript
	#}
	ENDIF

	CUST.EZB.tranIdLen = strlen(CUST.EZB.tranId)
	print(CUST.EZB.tranIdLen)

	CUST.EZB.DiffLen = cint(CUST.EZB.maxTranIdLen) - cint(CUST.EZB.tranIdLen)
	print(CUST.EZB.DiffLen)

	sv_a = CUST.EZB.tranId
	sv_b = lpad(sv_a, 9, ' ')

	CUST.EZB.formtdTranId = sv_b
	print(CUST.EZB.formtdTranId)

	##------------
	# DEBIT ADVICE
	##-------------


	IF(CUST.EZB.tranType == "D")THEN
	#{

	#}
	ENDIF

	lv_q = "tranId,tranAmt,tranParticular,tranRmks,valueDate,tranCrncy,tranCode,rate,dealRefNum,cif|"
	lv_q = lv_q + "select * from (select TRAN_ID,TRAN_AMT,TRAN_PARTICULAR,TRAN_RMKS,VALUE_DATE,TRAN_CRNCY_CODE,TRAN_PARTICULAR_CODE,RATE,TREA_REF_NUM, "
	lv_q = lv_q + "(select cif_id from tbaadm.gam where acid=h.acid and bank_id=h.bank_id) cif "
	
	IF(CUST.EZB.BODFlg !="")THEN
	#{
		IF(CUST.EZB.BODFlg =="Y")THEN
			lv_q = lv_q + " from tbaadm.dtd h"
		ELSE
			lv_q = lv_q + " from tbaadm.htd h"
		ENDIF
	#}
	ENDIF
	IF(CUST.EZB.tranType == "D")THEN
	#{
		lv_q = lv_q + " where acid=?SVAR and PART_TRAN_TYPE='D' and bank_id=?SVAR and tran_id=?SVAR and tran_date=to_date(?SVAR, 'DD-MM-YYYY') and tran_amt=?SVAR and rownum < 2 )"
	ELSE
		lv_q = lv_q + " where acid=?SVAR and PART_TRAN_TYPE='C' and bank_id=?SVAR and tran_id=?SVAR and tran_date=to_date(?SVAR, 'DD-MM-YYYY') and tran_amt=?SVAR and rownum < 2 )"
	#}
	ENDIF
	print(lv_q)
	BANCS.INPARAM.BINDVARS =  CUST.EZB.acid +"|"+BANCS.STDIN.contextBankId+"|"+CUST.EZB.formtdTranId +"|"+CUST.EZB.tranDate+"|"+CUST.EZB.tranAmt
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbSelectWithBind(lv_q)
	print(sv_c)

	IF(sv_c == 0)THEN
	#{
		CUST.EZB.tranId  = BANCS.OUTPARAM.tranId
		print(CUST.EZB.tranId)
		#CUST.EZB.tranAmt  = BANCS.OUTPARAM.tranAmt
		#print(CUST.EZB.tranAmt)
		CUST.EZB.narration  = BANCS.OUTPARAM.tranParticular
		print(CUST.EZB.narration)
		CUST.EZB.userReference  = BANCS.OUTPARAM.tranRmks
		print(CUST.EZB.userReference)
		CUST.EZB.valueDate  = BANCS.OUTPARAM.valueDate
		print(CUST.EZB.valueDate)
		CUST.EZB.tranCrncy  = BANCS.OUTPARAM.tranCrncy
		print(CUST.EZB.tranCrncy)
		CUST.EZB.tranCode  = BANCS.OUTPARAM.tranCode
		print(CUST.EZB.tranCode)
		CUST.EZB.rate  = BANCS.OUTPARAM.rate
		print(CUST.EZB.rate)
		CUST.EZB.dealRefNum  = BANCS.OUTPARAM.dealRefNum
		print(CUST.EZB.dealRefNum)
		CUST.EZB.cif  = BANCS.OUTPARAM.cif
		print(CUST.EZB.cif)

		lv_q = "benfName,benfAcctNum,acctOwnership,cif2|"
		lv_q = lv_q + "SELECT acct_name,foracid,acct_ownership,cif_id "
		lv_q = lv_q + " FROM tbaadm.gam  "

		IF(CUST.EZB.tranType == "D")THEN
			IF(CUST.EZB.BODFlg !="")THEN
			#{
				IF(CUST.EZB.BODFlg =="Y")THEN
					lv_q = lv_q + " WHERE acid IN (SELECT acid FROM tbaadm.dtd WHERE PART_TRAN_TYPE='C' AND bank_id=?SVAR AND tran_amt=?SVAR AND tran_id=?SVAR AND tran_date=to_date(?SVAR, 'DD-MM-YYYY') ) and rownum <2"
				ELSE
					lv_q = lv_q + " WHERE acid IN (SELECT acid FROM tbaadm.htd WHERE PART_TRAN_TYPE='C' AND bank_id=?SVAR AND tran_amt=?SVAR AND tran_id=?SVAR AND tran_date=to_date(?SVAR, 'DD-MM-YYYY') ) and rownum <2"
				ENDIF
			#}
			ENDIF
		ELSE
			IF(CUST.EZB.BODFlg !="")THEN
			#{
				IF(CUST.EZB.BODFlg =="Y")THEN
					lv_q = lv_q + " WHERE acid IN (SELECT acid FROM tbaadm.dtd WHERE PART_TRAN_TYPE='D' AND bank_id=?SVAR AND tran_amt=?SVAR AND tran_id=?SVAR AND tran_date=to_date(?SVAR, 'DD-MM-YYYY') ) and rownum <2"
				ELSE
					lv_q = lv_q + " WHERE acid IN (SELECT acid FROM tbaadm.htd WHERE PART_TRAN_TYPE='D' AND bank_id=?SVAR AND tran_amt=?SVAR AND tran_id=?SVAR AND tran_date=to_date(?SVAR, 'DD-MM-YYYY') ) and rownum <2"
				ENDIF
			#}
			ENDIF
		ENDIF

		print(lv_q)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId+"|"+CUST.EZB.tranAmt+"|"+CUST.EZB.formtdTranId+"|"+CUST.EZB.tranDate
		print(BANCS.INPARAM.BINDVARS)

		sv_c = urhk_dbSelectWithBind(lv_q)
		print(sv_c)

		IF(sv_c == 0)THEN
		#{
			CUST.EZB.acctOwnership  = BANCS.OUTPARAM.acctOwnership
			print(CUST.EZB.acctOwnership)

			CUST.EZB.benfName  = BANCS.OUTPARAM.benfName
			print(CUST.EZB.benfName)
			CUST.EZB.benfAcctNum  = BANCS.OUTPARAM.benfAcctNum
			print(CUST.EZB.benfAcctNum)
			CUST.EZB.cif2  = BANCS.OUTPARAM.cif2
			print(CUST.EZB.cif2)

			CUST.EZB.set1Len = strlen(CUST.EZB.benfAcctNum) - 6
			print(CUST.EZB.set1Len)

			CUST.EZB.set1 = left$(CUST.EZB.benfAcctNum,3)
			print(CUST.EZB.set1)

			CUST.EZB.set2 = right$(CUST.EZB.benfAcctNum,3)
			print(CUST.EZB.set2)

			CUST.EZB.middleLen = cint(CUST.EZB.set1Len) + 3
			print(CUST.EZB.middleLen)

			lv_b = rpad(CUST.EZB.set1, 10, '*')
			print(lv_b)

			IF(CUST.EZB.cif != CUST.EZB.cif2)THEN
				CUST.EZB.benfAcctNum = lv_b + CUST.EZB.set2
			ENDIF

			print(CUST.EZB.benfAcctNum)

			IF(CUST.EZB.dealRefNum != "")THEN
			#{
				sv_y = "refAmt,buySellFlg|SELECT ref_amt,buy_or_sell FROM tbaadm.ftrt WHERE tr_ref_num=?SVAR AND bank_id=?SVAR "
				BANCS.INPARAM.BINDVARS =  CUST.EZB.dealRefNum+"|"+BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_c = urhk_dbSelectWithBind(sv_y)
				print(sv_c)

				IF(sv_c == 0)THEN
				#{
					CUST.EZB.refAmt  = BANCS.OUTPARAM.refAmt
					print(CUST.EZB.refAmt)
					CUST.EZB.buySellFlg  = BANCS.OUTPARAM.buySellFlg
					print(CUST.EZB.buySellFlg)

					IF(CUST.EZB.buySellFlg == "S")THEN
					#{
						CUST.EZB.sellAmt  = CUST.EZB.refAmt
					ELSE
						CUST.EZB.buyAmt  = CUST.EZB.refAmt
					#}
					ENDIF
				ELSE
					CUST.EZB.sellAmt =""
					CUST.EZB.buyAmt = ""
				#}
				ENDIF
			#}
			ENDIF 

			sv_t = "TransacttionAdvice_RES.<rec_1>.TransactionId| " + CUST.EZB.tranId
			sv_u = urhk_SetOrbOut(sv_t)

			IF(CUST.EZB.tranType == "D")THEN
			#{
				sv_t = "TransacttionAdvice_RES.<rec_1>.DebitAccount| " + CUST.EZB.acctNum
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "TransacttionAdvice_RES.<rec_1>.CustomerName| " + CUST.EZB.acctName
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "TransacttionAdvice_RES.<rec_1>.CreditAccountNumber| " + CUST.EZB.benfAcctNum
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "TransacttionAdvice_RES.<rec_1>.BeneficiaryName| " + CUST.EZB.benfName
				sv_u = urhk_SetOrbOut(sv_t)
			ELSE
				sv_t = "TransacttionAdvice_RES.<rec_1>.DebitAccount| " + CUST.EZB.benfAcctNum
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "TransacttionAdvice_RES.<rec_1>.CustomerName| " + CUST.EZB.benfName
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "TransacttionAdvice_RES.<rec_1>.CreditAccountNumber| " + CUST.EZB.acctNum
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "TransacttionAdvice_RES.<rec_1>.BeneficiaryName| " + CUST.EZB.acctName
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ENDIF
	
			sv_t = "TransacttionAdvice_RES.<rec_1>.BeneficiaryBank| " + lv_c
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.BeneficiaryBranch| " + lv_c
			sv_u = urhk_SetOrbOut(sv_t)

			sv_t = "TransacttionAdvice_RES.<rec_1>.TransferAmount| " + CUST.EZB.tranAmt
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.Narration| " + CUST.EZB.narration
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.UserReference| " + CUST.EZB.userReference
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.ValueDate| " + CUST.EZB.valueDate
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.Currency| " + CUST.EZB.tranCrncy
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.TransactionCode| " + CUST.EZB.tranCode
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.TransactionCodeDesc| " + lv_c
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.Rate| " + CUST.EZB.rate
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.MNORef| " + lv_c
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.PaymentDetail| " + CUST.EZB.userReference
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.SellAmount| " + CUST.EZB.sellAmt
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.BuyAmount| " + CUST.EZB.buyAmt
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.DealReference| " + CUST.EZB.dealRefNum
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "TransacttionAdvice_RES.<rec_1>.AccountType| " + CUST.EZB.acctOwnership
			sv_u = urhk_SetOrbOut(sv_t)
		ELSE 
			CUST.EZB.errMsg = "Could not get record!! Check input data ["+CUST.EZB.tranId+"] and ["+CUST.EZB.acctNum+"] and ["+CUST.EZB.tranDate+"]" 
			lv_a = "E9999"
	        sv_c = lv_a + "^"+ CUST.EZB.errMsg+ "^BE"
			sv_u = urhk_SetOrbErr(sv_c) 
			exitscript
		#}
		ENDIF
	ELSE
		CUST.EZB.errMsg = "Could not get record!! Check input data ["+CUST.EZB.tranId+"] and ["+CUST.EZB.acctNum+"] and ["+CUST.EZB.tranDate+"]" 
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c) 
		exitscript	
	#}
	ENDIF
ENDSCRIPT:
trace off
