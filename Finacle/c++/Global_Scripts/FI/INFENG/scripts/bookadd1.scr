		BANCS.INPARAM.BINDVARS = CUST.CHQB.reqestId + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.mySolId + "|" + CUST.CHQB.srlNum + "|" + CUST.CHQB.noOfChq + "|" + CUST.CHQB.leaves + "|" + mid$(BANCS.STDIN.BODDate,0,10) +"|"+ BANCS.STDIN.userId  + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" +  BANCS.STDIN.contextBankId
