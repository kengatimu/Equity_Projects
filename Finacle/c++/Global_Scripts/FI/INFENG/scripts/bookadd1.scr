			IF( (CUST.CHQB.schmCode == CUST.CHQB.schmCode2) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode3) OR (sv_m == CUST.CHQB.schmCode4) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode5) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode6) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode7)  OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode8) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode13) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode14) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode15) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode16) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode17) OR (CUST.CHQB.schmCode == "CA288")) THEN
