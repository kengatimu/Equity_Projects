<--start
trace on
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("VERRE")==0)then
                createrep("VERRE")
        endif
        if(classexists("VERRE","GLBDATA")==0)then
                createclass("VERRE","GLBDATA",5)
        endif

        if(fieldexists(BANCS.INPUT.ModuleId)==1)then
                VERRE.GLBDATA.ModuleId = BANCS.INPUT.ModuleId
        else
                VERRE.GLBDATA.ModuleId = ""
        endif
        if(fieldexists(BANCS.INPUT.EventId)==1)then
                VERRE.GLBDATA.EventId = BANCS.INPUT.EventId
        else
                VERRE.GLBDATA.EventId = ""
        endif
        if(VERRE.GLBDATA.ModuleId=="")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                sv_u = urhk_SetOrbOut("Message|Enter Module Id")
        endif
        if(VERRE.GLBDATA.EventId=="")then
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                sv_u = urhk_SetOrbOut("Message|Enter Event Id")
        endif
        if(VERRE.GLBDATA.ModuleId=="CLEARING")then
        #{
                if(VERRE.GLBDATA.EventId=="REG")then
                #{
                        call("vphoctmG.scr")
                        exitscript
                #}
                endif
        #}
        endif
        if(VERRE.GLBDATA.ModuleId=="CLEARING")then
        #{
                if(VERRE.GLBDATA.EventId=="INQ")then
                #{
                        call("vphoctmInq.scr")
                        exitscript
                #}
                endif
        #}
        endif
        if(VERRE.GLBDATA.ModuleId=="CHQ")then
        #{
                if((VERRE.GLBDATA.EventId=="INQ")or(VERRE.GLBDATA.EventId=="UCS"))then
                #{
                        if(fieldexists(BANCS.INPUT.AcctId)==1)then
                        #{
                                VERRE.GLBDATA.AcctId = BANCS.INPUT.AcctId
                        else
                                VERRE.GLBDATA.AcctId = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Account Id")
                                exitscript
                        #}
                        endif
                        if(fieldexists(BANCS.INPUT.ChequeNum)==1)then
                        #{
                                VERRE.GLBDATA.ChequeNum = BANCS.INPUT.ChequeNum
                        else
                                VERRE.GLBDATA.AcctId = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Cheque Number")
                                exitscript
                        #}
                        endif
                        BANCS.INPARAM.AccountId=VERRE.GLBDATA.AcctId
                        BANCS.INPARAM.InstrumentNumber=VERRE.GLBDATA.ChequeNum
                        BANCS.INPARAM.InstrumentAlpha=""
                        sv_e = urhk_B2K_valInstrumentNumForAcct("")
                        if(sv_e==0)then
                        #{
                                print(BANCS.OUTPARAM.ReturnCode)
                                print(BANCS.OUTPARAM.ChqStatus)
                                VERRE.GLBDATA.ChqStatus = BANCS.OUTPARAM.ChqStatus
                        else
                                VERRE.GLBDATA.ChqStatus = ""
                        #}
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="")then
                        #{
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Invalid Instrument Number")
                                exitscript
                        #}
                        endif
                        if(VERRE.GLBDATA.EventId=="UCS")then
                        #{
                                if(fieldexists(BANCS.INPUT.StatusCode)==1)then
                                #{
                                        VERRE.GLBDATA.StatusCode = BANCS.INPUT.StatusCode
                                else
                                        VERRE.GLBDATA.StatusCode = ""
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                        sv_u = urhk_SetOrbOut("Message|Enter Cheque Status Code")
                                        exitscript
                                #}
                                endif
                                if((VERRE.GLBDATA.StatusCode!="J")and(VERRE.GLBDATA.StatusCode!="P")and(VERRE.GLBDATA.StatusCode!="U"))then
                                #{
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                        sv_u = urhk_SetOrbOut("Message|Invalid Cheque Status Code")
                                        exitscript
                                #}
                                endif
                                call("vphucsVfy.scr")
                                exitscript
                        #}
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="U")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                sv_u = urhk_SetOrbOut("Message|UnUsed")
                                exitscript
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="P")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                sv_u = urhk_SetOrbOut("Message|Passed")
                                exitscript
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="S")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                sv_u = urhk_SetOrbOut("Message|Stopped")
                                exitscript
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="C")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                sv_u = urhk_SetOrbOut("Message|Cautioned")
                                exitscript
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="D")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                sv_u = urhk_SetOrbOut("Message|Destroyed")
                                exitscript
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="R")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                sv_u = urhk_SetOrbOut("Message|Returned")
                                exitscript
                        endif
                        if(VERRE.GLBDATA.ChqStatus=="T")then
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                sv_u = urhk_SetOrbOut("Message|Transferred")
                                exitscript
                        endif
                #}
                endif
        #}
        endif
        if(VERRE.GLBDATA.ModuleId=="LIEN")then
        #{
                if(VERRE.GLBDATA.EventId=="ADD")then
                #{
                        if(fieldexists(BANCS.INPUT.AcctId)==1)then
                        #{
                                VERRE.GLBDATA.AcctId = BANCS.INPUT.AcctId
                        else
                                VERRE.GLBDATA.AcctId = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Account Id")
                        #}
                        endif
                        if(fieldexists(BANCS.INPUT.LienStartDate)==1)then
                        #{
                                VERRE.GLBDATA.LienStartDate = BANCS.INPUT.LienStartDate
                        else
                                VERRE.GLBDATA.LienStartDate = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Lien Start Date ")
                        #}
                        endif
                        if(fieldexists(BANCS.INPUT.LienExpiryDate)==1)then
                        #{
                                VERRE.GLBDATA.LienExpiryDate = BANCS.INPUT.LienExpiryDate
                        else
                                VERRE.GLBDATA.LienExpiryDate = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Lien Expiry Date ")
                        #}
                        endif
                        if(fieldexists(BANCS.INPUT.LienAmt)==1)then
                        #{
                                VERRE.GLBDATA.LienAmt = BANCS.INPUT.LienAmt
                        else
                                VERRE.GLBDATA.LienAmt = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Lien Amount")
                        #}
                        endif
                        if(fieldexists(BANCS.INPUT.LienReasonCode)==1)then
                        #{
                                VERRE.GLBDATA.LienReasonCode = BANCS.INPUT.LienReasonCode
                        else
                                VERRE.GLBDATA.LienReasonCode = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter LienReason Code")
                        #}
                        endif
                        if(fieldexists(BANCS.INPUT.LienRmks)==1)then
                        #{
                                VERRE.GLBDATA.LienRmks = BANCS.INPUT.LienRmks
                        else
                                VERRE.GLBDATA.LienRmks = ""
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Lien Remarks")
                        #}
                        endif
                        sv_z = urhk_B2k_ForacidToAcid(VERRE.GLBDATA.AcctId)
                        if(sv_z==0)then
                                VERRE.GLBDATA.Acid = BANCS.OUTPARAM.Acid
                        else
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Enter Valid Account")
                        endif
                        sv_s = "amount1,acid,b2kid|select trim (lien_amt),acid,b2k_id from tbaadm.alt "
                        sv_s = sv_s + " where b2k_id in (select trim(max(b2k_id))  from tbaadm.alt "
                        sv_s = sv_s + " where acid =?SVAR "
                        sv_s = sv_s + " and b2k_type = 'ULIEN' "
                        sv_s = sv_s + " and lien_reason_code='OTH' "
                        sv_s = sv_s + " and b2k_id is not null "
                        sv_s = sv_s + " and bank_id =?SVAR) "
                        sv_s = sv_s + " and b2k_type = 'ULIEN' "
                        sv_s = sv_s + " and lien_reason_code='OTH' "
                        sv_s = sv_s + " and b2k_id is not null "
                        sv_s = sv_s + " and acid =?SVAR "
                        sv_s = sv_s + " and bank_id =?SVAR "
                        BANCS.INPARAM.BINDVARS = VERRE.GLBDATA.Acid + "|" + BANCS.STDIN.contextBankId + "|" + VERRE.GLBDATA.Acid + "|" + BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)
                        print(sv_s)
                        sv_d = urhk_dbSelectWithBind(sv_s)
                        print(sv_d)
                        if(sv_d == 0)then
                        #{
                                VERRE.GLBDATA.amount1 = BANCS.OUTPARAM.amount1
                                VERRE.GLBDATA.acid = BANCS.OUTPARAM.acid
                                VERRE.GLBDATA.b2kid = BANCS.OUTPARAM.b2kid
                                VERRE.GLBDATA.Lib2kid = VERRE.GLBDATA.b2kid
                                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                sv_u = urhk_SetOrbOut("Message|Lien Already Exist Invoke Lien Modify/Inquiry API")
                                exitscript
                        #}
                        else
                        #{
                                VERRE.GLBDATA.amount1 = "0"
                                VERRE.GLBDATA.acid = ""
                                VERRE.GLBDATA.b2kid = ""
                                VERRE.GLBDATA.Lib2kid = ""
                        #}
                        endif

                                BANCS.INPARAM.acctNum = VERRE.GLBDATA.AcctId
                                BANCS.INPARAM.blockMode = "A"
                                BANCS.INPARAM.lienAmt = cdouble(VERRE.GLBDATA.LienAmt)
                                BANCS.INPARAM.expiryDate = left$(VERRE.GLBDATA.LienExpiryDate,10)
                                BANCS.INPARAM.remarks = left$(VERRE.GLBDATA.LienRmks,30)
                                BANCS.INPARAM.reasonCode = VERRE.GLBDATA.LienReasonCode
                                BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
                                BANCS.INPARAM.lienValueDate = left$(VERRE.GLBDATA.LienStartDate,10)
                                sv_u = urhk_updateLien("")
                                if(sv_u != 0)then
                                #{
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                                        sv_u = urhk_SetOrbOut("ErrorCode|E999")
                                        sv_u = urhk_SetOrbOut("Message|Lien Marking Failed")
                                        exitscript
                                #}
                                else
                                #{
                                        sv_u = urhk_SetOrbOut("SuccessOrFailure|S")
                                        sv_u = urhk_SetOrbOut("Message|Lien Added Successfully")
                                        exitscript
                                #}
                                endif

                #}
                endif
        #}
        endif


exitscript

trace off
