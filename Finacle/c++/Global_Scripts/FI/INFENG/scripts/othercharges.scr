					IF ((BANCS.INPUT.ReservedField2!="") AND (BANCS.INPUT.ReservedField1!="")) THEN
					#{
						
						IF (BANCS.INPUT.ReservedField2=="efrwithdrawal") THEN
						#{
							sv_s = "solid2,userworkclass2|"
							sv_s = sv_s + " select sol_id,user_work_class from tbaadm.upr  "
							sv_s = sv_s + "  where DEL_FLG='N' AND "
							sv_s = sv_s + "  user_id = ?SVAR "
							print(sv_s)
							BANCS.INPARAM.BINDVARS = BANCS.INPUT.ReservedField1
							sv_d = urhk_dbSelectWithBind(sv_s)
							print(sv_d)
							IF(sv_d == 0)THEN
							#{
								CUST.ATM.solid2= BANCS.OUTPARAM.solid2
								print(CUST.ATM.solid2)
								CUST.ATM.userworkclass2= BANCS.OUTPARAM.userworkclass2
								print(CUST.ATM.userworkclass2)
								IF (BANCS.STDIN.contextBankId=="54") THEN
								#{
									sv_w = MID$(CUST.ATM.crForacid,3,13)
									print(sv_w)
									CUST.ATM.crForacid = CUST.ATM.solid2 + sv_w
									print(CUST.ATM.crForacid)
									#}
								ELSE
									#{
									sv_w = MID$(CUST.ATM.crForacid,4,13)
									print(sv_w)
									CUST.ATM.crForacid = CUST.ATM.solid2 + sv_w
									print(CUST.ATM.crForacid)
								#}
								ENDIF
								#}
							ELSE
								#{
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure = "F"
								BANCS.OUTPUT.scriptError = "User Does not exist in finacle"
								GOTO ENDOFSCRIPT
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					
					
					#--------------------------------------------------
					# Income To EQUITY PURCHASES COMM A/C
					#--------------------------------------------------
					
					
					print(CUST.ATM.crForacid)
					MTT.PartTranDetails.Account = CUST.ATM.crForacid
					MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
