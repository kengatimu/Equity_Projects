					ENDIF
					
					#-------------------------------------------------------------------------------------------------------
					# Credit Leg
					#-------------------------------------------------------------------------------------------------------
					MTT.PartTranDetails.Account                             = CUST.ATM.crForacid
					IF( (CUST.ATM.partnType == "ACCNT") AND (CUST.ATM.partnFlg=="Y") ) THEN
