	#-----------------------------------------------------------------
	Initialise:
		#{
		sv_r = REPEXISTS("CUST")
		IF (sv_r == 0) THEN
		#{
			CREATEREP("CUST")
		#}
		ENDIF
		
		sv_r = CLASSEXISTS("CUST", "ATM")
		IF (sv_r == 0) THEN
		#{
			CREATECLASS("CUST", "ATM", 5)
		#}
		ENDIF
		#{
		#------------------------------------------------------------------
		#  Getting account to debit
		#
		#------------------------------------------------------------------
		print(BANCS.INPUT.CrForacid)
		print(BANCS.INPUT.Foracid)
		CUST.ATM.crAccount=BANCS.INPUT.CrForacid
		CUST.ATM.drAccount=BANCS.INPUT.Foracid
		CUST.ATM.DccId=BANCS.INPUT.DccId
		print(CUST.ATM.DccId)
		CUST.ATM.narr1="CHARGE"
		
		
		IF (BANCS.INPUT.Foracid == "") THEN
		#{
			CUST.ATM.Amount = "0"
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		IF (BANCS.INPUT.CrForacid == "") THEN
		#{
			CUST.ATM.Amount = "0"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (BANCS.INPUT.Command == "") THEN
		#{
			CUST.ATM.Amount = "0"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.ATM.cmd=BANCS.INPUT.Command
			print(CUST.ATM.cmd)
		#}
		ENDIF
		
		#--------------------------------------------------------------------------
		# getting the amount to split
		#--------------------------------------------------------------------------
		BANCS.INPUT.TranAmt=cdouble(BANCS.INPUT.TranAmt)/cdouble("100")
		print(BANCS.INPUT.TranAmt)
		PRINT(BANCS.INPUT.SerialNum)
		
		IF (CUST.ATM.DccId=="EFR") THEN
		#{
			CUST.ATM.statementflg="N"
			
			IF ((BANCS.INPUT.ReservedField2!="") OR (CUST.ATM.statementflg!="")) THEN
			#{
				
				IF ((BANCS.INPUT.ReservedField2!="efrwithdrawal") AND (BANCS.INPUT.ReservedField2!="efrstopCheque")) THEN
				#{
					sv_s = "countstsChrg "
					sv_s = sv_s + " | "
					sv_s = sv_s + " SELECT COUNT(*) "
					sv_s = sv_s + " FROM CUSTOM.EFR_STATEMENTS "
					sv_s = sv_s + " WHERE FORACID=?SVAR "
					sv_s = sv_s + " AND CHARGED_FLG='N' AND STATUS='N' AND bank_id=?SVAR "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.ATM.drAccount + "|" + BANCS.STDIN.contextBankId
					print(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						print(BANCS.OUTPARAM.countstsChrg)
						CUST.ATM.countstsChrg = BANCS.OUTPARAM.countstsChrg
						print(CUST.ATM.countstsChrg)
						CUST.ATM.statementflg="Y"
						IF (CUST.ATM.countstsChrg !=0) THEN
						#{
							sv_s = "countChrgsum "
							sv_s = sv_s + " | "
							sv_s = sv_s + " SELECT CEIL(sum(NO_RECRDS)/25) "
							sv_s = sv_s + " FROM CUSTOM.EFR_STATEMENTS "
							sv_s = sv_s + " WHERE FORACID=?SVAR "
							sv_s = sv_s + " AND CHARGED_FLG='N' AND STATUS='N' AND bank_id=?SVAR "
							print(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.ATM.drAccount + "|" + BANCS.STDIN.contextBankId
							print(sv_s)
							sv_d = urhk_dbSelectWithBind(sv_s)
							IF (sv_d == 0) THEN
							#{
								print(BANCS.OUTPARAM.countChrgsum)
								CUST.ATM.countChrgsum = BANCS.OUTPARAM.countChrgsum
								print(CUST.ATM.countChrgsum)
								#}
							ELSE
								#{
								CUST.ATM.statementflg="N"
								GOTO ENDOFSCRIPT
							#}
							ENDIF
							#}
						ELSE
							#{
							CUST.ATM.statementflg="N"
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						#}
					ELSE
						#{
						CUST.ATM.statementflg="N"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				
				
				IF ((CUST.ATM.statementflg=="Y") OR (BANCS.INPUT.ReservedField2=="efrwithdrawal") OR (BANCS.INPUT.ReservedField2=="efrstopCheque")) THEN
				#{
					
					
					#--------------------------------------------------------------------------
					# Create the narration
					#--------------------------------------------------------------------------
					sv_e = MID$(BANCS.STDIN.BODDate,0,10)
					print(sv_e)
					sv_s = "sysdate "
					sv_s = sv_s + " | "
					sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
					sv_s = sv_s + " FROM DUAL"
					BANCS.INPARAM.BINDVARS = sv_e
					sv_d = urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF (sv_d =="0") THEN
					#{
						CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
						IF (CUST.ATM.DccId=="EFR") THEN
						#{
							IF (BANCS.INPUT.Command=="FSIS") THEN
							#{
								CUST.ATM.narr1 ="EFRONT STATEMENT CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
								print(CUST.ATM.narr1)
							#}
							ENDIF
							IF (BANCS.INPUT.ReservedField2!="") THEN
							#{
								IF (BANCS.INPUT.ReservedField2=="efrstopCheque") THEN
								#{
									CUST.ATM.narr1 ="EFRONT STOPCHEQUE CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
									print(CUST.ATM.narr1)
								#}
								ENDIF
								IF (BANCS.INPUT.ReservedField2=="efrwithdrawal") THEN
								#{
									CUST.ATM.narr1 ="EFRONT WITHDRAWAL CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
									print(CUST.ATM.narr1)
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
						#}
					ELSE
						#{
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					#--------------------------------------------------------------------------
					# Initialise the MTT repository
					#--------------------------------------------------------------------------
					
					sv_r = REPEXISTS("MTT")
					IF (sv_r == 0) THEN
					#{
						CREATEREP("MTT")
					#}
					ENDIF
					
					sv_r = CLASSEXISTS("MTT","TranDetails")
					IF (sv_r == 0) THEN
					#{
						CREATECLASS("MTT","TranDetails",5)
					#}
					ENDIF
					
					sv_r = CLASSEXISTS("MTT","PartTranDetails")
					IF (sv_r == 0) THEN
					#{
						CREATECLASS("MTT","PartTranDetails",5)
					#}
					ENDIF
					
					sv_r = REPEXISTS("BANCS")
					IF (sv_r == 0) THEN
					#{
						CREATEREP("BANCS")
					#}
					ENDIF
					
					sv_r = CLASSEXISTS("BANCS","INPARAM")
					IF (sv_r == 0) THEN
					#{
						CREATECLASS("BANCS","INPARAM",5)
					#}
					ENDIF
					
					BANCS.INPARAM.PostTranFlg = "Y"
					BANCS.INPARAM.InsertTranWithValidnFlg = "N"
					BANCS.INPARAM.CommitFlg="Y"
					BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
					BANCS.INPARAM.ErrorCheckForLuw="Y"
					BANCS.INPARAM.CheckExceptions="N"
					
					sv_u = urhk_MTTS_Initialize("")
					print(sv_u)
					
					IF (FIELDEXISTS(CUST.ATM.drAccount) == 1) THEN
					#{
						IF(CUST.ATM.drAccount != "" ) THEN
						#{
							sv_t= urhk_getAcctDetailsInRepository(CUST.ATM.drAccount)
							print(sv_t)
							IF (sv_t == 0) THEN
							#{
								BANCS.INPUT.SolId = BANCS.OUTPARAM.acctSolId
								print(BANCS.INPUT.SolId)
								BANCS.OUTPUT.SolId = BANCS.OUTPARAM.acctSolId
								print(BANCS.OUTPUT.SolId)
								BANCS.OUTPUT.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
								print(BANCS.OUTPUT.acctCrncyCode)
								BANCS.OUTPUT.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
								print(BANCS.OUTPUT.EffAvailableAmt)
								BANCS.OUTPUT.FxEffAvailableAmt = BANCS.OUTPARAM.FxEffAvailableAmt
								print(BANCS.OUTPUT.FxEffAvailableAmt)
								sv_c = BANCS.OUTPARAM.schmCode
								print(sv_c)
								sv_t = BANCS.OUTPARAM.schmType
								print(sv_t)
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					
					
					IF (BANCS.INPUT.Command=="FSIS") THEN
					#{
						CUST.ATM.eventId="ADHOC"
						print(CUST.ATM.eventId)
						CUST.ATM.eventType="PSPA"
						print(CUST.ATM.eventType)
					#}
					ENDIF
					IF (BANCS.INPUT.ReservedField2!="") THEN
					#{
						IF (BANCS.INPUT.ReservedField2=="efrstopCheque") THEN
						#{
							CUST.ATM.eventId="STOP"
							print(CUST.ATM.eventId)
							CUST.ATM.eventType="STPMT"
							print(CUST.ATM.eventType)
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2=="efrwithdrawal") THEN
						#{
							CUST.ATM.eventId="WITHDRAW"
							print(CUST.ATM.eventId)
							CUST.ATM.eventType="TRANF"
							print(CUST.ATM.eventType)
						#}
						ENDIF
					#}
					ENDIF
					
					print(CUST.ATM.eventId)
					print(CUST.ATM.eventType)
