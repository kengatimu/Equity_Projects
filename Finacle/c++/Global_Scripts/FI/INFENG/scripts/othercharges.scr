					#{
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						BANCS.OUTPUT.scriptError = "urhk_MTTS_InitPtt returns FAILURE"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					sv_u = urhk_MTTS_GetPttRec(sv_y)
					print(sv_u)
					IF(sv_u == 0 ) THEN
					#{
						CUST.ATM.crForacid = MTT.PartTranDetails.Account
						CUST.ATM.RefCurrency = MTT.ChargeDetails.CollectionCrncy
						CUST.ATM.RefAmount = CDOUBLE(MTT.PartTranDetails.RefAmount)
						sv_b = CDOUBLE(MTT.PartTranDetails.RefAmount)
						print(sv_b)
						IF ((BANCS.INPUT.ReservedField2!="efrwithdrawal") AND (BANCS.INPUT.ReservedField2!="efrstopCheque")) THEN
						#{
							IF (CUST.ATM.statementflg=="Y") THEN
							#{
								print(CUST.ATM.countChrgsum)
								sv_b = sv_b * CDOUBLE(CUST.ATM.countChrgsum)
								print(sv_b)
								#}
							ELSE
								#{
								CUST.ATM.statementflg="N"
