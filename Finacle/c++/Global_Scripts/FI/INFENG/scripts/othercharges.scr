						print(MTT.PartTranDetails.Account)
						print(MTT.ChargeDetails.CollectionCrncy)
						print(MTT.PartTranDetails.RefAmount)
						
						sv_e = CDOUBLE(BANCS.OUTPUT.EffAvailableAmt)
						print(sv_e)
						IF (sv_c != "SB190") THEN
						#{
							print("charge")
							IF ((BANCS.INPUT.Command=="FSIS") OR (BANCS.INPUT.ReservedField2=="efrstopCheque") ) THEN
							#{
								print(sv_b)
								sv_y = sv_b
								print(sv_y)
								IF ( sv_e < sv_y ) THEN
								#{
									print(sv_e)
									print(sv_y)
									BANCS.OUTPUT.RespCode = "04"
									BANCS.OUTPUT.successOrFailure = "F"
									GOTO ENDOFSCRIPT
								#}
								ENDIF
							#}
