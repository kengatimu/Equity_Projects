					sv_v = "PurchaseComm"
					print(sv_v)
					
					sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
					
					sv_u = urhk_MTTS_PopulateInputDetails("")
					
					###################################################################################
					# Check whether Debit Account id is partition account or not
					###################################################################################
					sv_s = "partnType,partnFlg|"
					sv_s = sv_s + " select partitioned_type, partitioned_flg "
					sv_s = sv_s + " from TBAADM.GAM "
