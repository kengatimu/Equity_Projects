								sv_y = CDOUBLE(BANCS.INPUT.TranAmt) + CDOUBLE(MTT.PartTranDetails.RefAmount)
								print(sv_y)
								IF ( sv_e < sv_y ) THEN
								#{
									print(sv_e)
									print(sv_y)
									BANCS.OUTPUT.RespCode = "04"
									BANCS.OUTPUT.successOrFailure = "F"
									GOTO ENDOFSCRIPT
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
