<--START
CHECKSUM="c396aa58e6fa85efd4056a4b4d2b11c4c3f3a5b1f2922abbea73a6d6f5bd41e2"
	TRACE ON
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	#	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	CUST.LADISB.errMsg       	= ""
	CUST.LADISB.countt 	    	= 0
	CUST.LADISB.foracid      	= TOUPPER(BANCS.INPUT.foracid)
	print(CUST.LADISB.foracid)
	CUST.LADISB.disbamount1  	= BANCS.INPUT.disbamount1
	print(CUST.LADISB.disbamount1)
	CUST.LADISB.crdOpAcctNum 	= BANCS.INPUT.creditacctnum
	print(CUST.LADISB.crdOpAcctNum)
	CUST.LADISB.pyFlg 			= BANCS.INPUT.pyFlg
	print(CUST.LADISB.pyFlg)
	
	CUST.LADISB.cr			= "CR"
	CUST.LADISB.dr			= "DR"
	CUST.LADISB.totAmt		= 0
	sv_a	= 1
	
	#-----------------------------------------------------------------------------------------------
	#Getting rateCode from CPARAM values--'NOR'
	#-----------------------------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	print(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.LADISB.limitRateCode = BANCS.OUTPUT.parameterVal
		print(CUST.LADISB.limitRateCode)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "NORRATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------
	#getting scheme code
	#--------------------------------------------------------------------
	sv_s = ""
	sv_s = "schmCode|SELECT GAM.schm_code "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
	sv_s = sv_s + " AND GAM.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in calculating schm code"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.schmCode= BANCS.OUTPARAM.schmCode
		print(BANCS.OUTPARAM.schmCode)
	#}
	ENDIF
	
	#--------------------------------------------------------------------
	#getting Operative Account currency code
	#--------------------------------------------------------------------
	sv_s = ""
	sv_s = "OprAcctCrncyCode|SELECT GAM.acct_crncy_code "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
	sv_s = sv_s + " AND GAM.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.crdOpAcctNum + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	
	IF ( sv_d != 0 ) THEN
	#{
		CUST.LADISB.errMsg = "Error occured in getting account currency code"
		print(CUST.LADISB.errMsg)
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.OprAcctCrncyCode = BANCS.OUTPARAM.OprAcctCrncyCode
		print(CUST.LADISB.OprAcctCrncyCode)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting accounts, clearBalAmount  from GAM of old loan a/c's
	#--------------------------------------------------------------------------
	sv_s = ""
	sv_s = "oldForacid,acid,clrBalAmt,oldLoanCrncyCode|"
	sv_s = sv_s + " SELECT GAM.foracid,GAM.acid,GAM.clr_bal_amt,GAM.acct_crncy_code"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE GAM.schm_code = '"+CUST.LADISB.schmCode+"'"
	sv_s = sv_s + " AND GAM.cif_id = ("
	sv_s = sv_s +			   " SELECT GAM.cif_id"
	sv_s = sv_s +	                   	" FROM TBAADM.GAM"
	sv_s = sv_s +			   	" WHERE GAM.foracid = '"+CUST.LADISB.foracid+"'"
	sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
	sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
	sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s +			   	" AND GAM.bank_id = '"+BANCS.STDIN.contextBankId+"')"
	sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
	sv_s = sv_s + " AND GAM.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND GAM.clr_bal_amt < 0"
	sv_s = sv_s + " AND GAM.bank_id = '"+BANCS.STDIN.contextBankId+"'"
	sv_s = sv_s + " AND GAM.foracid != '"+CUST.LADISB.foracid+"'"
	
	sv_p = "recCount|"
	sv_p = sv_p +" SELECT"
	sv_p = sv_p +" COUNT(*)"
	sv_p = sv_p +" FROM"
	sv_p = sv_p +" TBAADM.GAM "
	sv_p = sv_p + " WHERE GAM.schm_code = ?SVAR "
	sv_p = sv_p + " AND GAM.cif_id = ("
	sv_p = sv_p +			   " SELECT GAM.cif_id"
	sv_p = sv_p +	                   	" FROM TBAADM.GAM"
	sv_p = sv_p +			   			" WHERE GAM.foracid = ?SVAR"
	sv_p = sv_p + 						" AND GAM.acct_cls_flg = 'N'"
	sv_p = sv_p + 						" AND GAM.del_flg = 'N'"
	sv_p = sv_p + 						" AND GAM.entity_cre_flg = 'Y'"
	sv_p = sv_p +			   			" AND GAM.bank_id = ?SVAR)"
	sv_p = sv_p + " AND GAM.acct_cls_flg = 'N'"
	sv_p = sv_p + " AND GAM.del_flg = 'N'"
	sv_p = sv_p + " AND GAM.entity_cre_flg = 'Y'"
	sv_p = sv_p + " AND GAM.clr_bal_amt != 0"
	sv_p = sv_p + " AND GAM.bank_id = ?SVAR"
	sv_p = sv_p + " AND GAM.foracid != ?SVAR"
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.schmCode + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid  + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid
	print(BANCS.INPARAM.BINDVARS)
	sv_q = urhk_dbselectWithBind(sv_p)
	sv_q = urhk_SetOrbOut("recCount|"+BANCS.OUTPARAM.recCount)
	
	print(sv_s)
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF( sv_c != 0) THEN
	#{
		CUST.LADISB.errMsg = "No records fetched for the entered Account Number"
		BANCS.OUTPUT.SuccessOrFailure = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(sv_l)
		sv_c = urhk_dbCursorFetch(sv_l)
		print(sv_c)
		
		WHILE( sv_c == 0)
		#{
			CUST.LADISB.oldForacid=BANCS.OUTPARAM.oldForacid
			print(CUST.LADISB.oldForacid)
			CUST.LADISB.acid = BANCS.OUTPARAM.acid
			print(CUST.LADISB.acid)
			CUST.LADISB.clrBalAmt = BANCS.OUTPARAM.clrBalAmt
			print(CUST.LADISB.clrBalAmt)
			CUST.LADISB.oldLoanCrncyCode = BANCS.OUTPARAM.oldLoanCrncyCode
			print(CUST.LADISB.oldLoanCrncyCode)
			CUST.LADISB.count = sv_a
			
			#--------------------------------------------------------------------------------------
			# getting Int route flag from LAM table
			#--------------------------------------------------------------------------------------
			sv_s = ""
			sv_s = sv_s + " intRoute|"
			sv_s = sv_s + " SELECT LAM.int_route_flg"
			sv_s = sv_s + "	FROM TBAADM.LAM"
			sv_s = sv_s + " WHERE LAM.acid ="
			sv_s = sv_s + 			" (SELECT GAM.ACID"
			sv_s = sv_s + 			" FROM TBAADM.GAM"
			sv_s = sv_s + 			" WHERE GAM.FORACID = ?SVAR"
			sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
			sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
			sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
			sv_s = sv_s + 			" AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.del_flg='N'"
			sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			
			print(sv_s)
			BANCS.INPARAM.BINDVARS = ""
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldForacid + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
			
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			
			IF ( sv_d != 0 ) THEN
			#{
				CUST.LADISB.errMsg = "Error occured in calculating old Loan O/S amount"
				print(CUST.LADISB.errMsg)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.LADISB.intRoute = BANCS.OUTPARAM.intRoute
				print(CUST.LADISB.intRoute)
			#}
			ENDIF
			
			#--------------------------------------------------------------------------------------
			#getting interest amt through loan a/c's
			#--------------------------------------------------------------------------------------
			IF(CUST.LADISB.intRoute == "L") THEN
			#{
				sv_s = "interest|"
				sv_s = sv_s + " SELECT"
				sv_s = sv_s + " (nvl(nrml_interest_amount_dr"
				sv_s = sv_s + " - nrml_booked_amount_dr,0) +"
				sv_s = sv_s + " nvl(penal_interest_amount_dr"
				sv_s = sv_s + " -penal_booked_amount_dr,0))"
				sv_s = sv_s + " FROM TBAADM.EIT"
				sv_s = sv_s + " WHERE EIT.entity_id = ?SVAR"
				sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
				sv_s = sv_s + " AND EIT.bank_id = ?SVAR"
				
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				
				sv_q = urhk_dbSelectWithBind(sv_s)
				CUST.LADISB.interest = BANCS.OUTPARAM.interest
				print(CUST.LADISB.interest)
				#}
			ELSE
				#{
				sv_s = "interest|"
				sv_s = sv_s + " SELECT"
				sv_s = sv_s + " (nvl(nrml_interest_amount_dr"
				sv_s = sv_s + " - nrml_booked_amount_dr,0) +"
				sv_s = sv_s + " nvl(penal_interest_amount_dr"
				sv_s = sv_s + " -penal_booked_amount_dr,0)"
				sv_s = sv_s + " + nvl(LAM.INT_DMD_OS,0)"
				sv_s = sv_s + " + nvl(LAM.BCHG_DMD_OS,0)"
				sv_s = sv_s + " + nvl(LAM.OCHG_DMD_OS,0))"
				sv_s = sv_s + " FROM TBAADM.EIT,TBAADM.LAM"
				sv_s = sv_s + " WHERE EIT.entity_id = ?SVAR"
				sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
				sv_s = sv_s + " AND EIT.bank_id = ?SVAR"
				sv_s = sv_s + " AND LAM.acid = ?SVAR"
				sv_s = sv_s + " AND LAM.del_flg='N'"
				sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
				
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				
				sv_q = urhk_dbSelectWithBind(sv_s)
				CUST.LADISB.interest = BANCS.OUTPARAM.interest
				print(CUST.LADISB.interest)
			#}
			ENDIF
			#-------------------------------------------------------------
			#calculating total amount of each old loan a/c
			#-------------------------------------------------------------
			
			CUST.LADISB.totAmt = CDOUBLE(CUST.LADISB.clrBalAmt) + CDOUBLE(CUST.LADISB.interest)
			IF(CDOUBLE(CUST.LADISB.totAmt) < 0) THEN
			#{
				CUST.LADISB.totAmt = -1 * CDOUBLE(CUST.LADISB.totAmt)
				print(CUST.LADISB.totAmt)
				sv_s= "totalAmount| "
				sv_s = sv_s + "SELECT TRUNC(?SVAR,2)"
				sv_s = sv_s + "FROM DUAL "
				
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.totAmt
				print(sv_s)
				sv_q = urhk_dbSelectWithBind(sv_s)
				IF(sv_q != 0) THEN
				#{
					CUST.LADISB.errMsg = "Error occured in Truncating the Amount"
					print(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CUST.LADISB.totalAmount = BANCS.OUTPARAM.totalAmount
					print(CUST.LADISB.totalAmount)
				#}
				ENDIF
			#}
			ENDIF
			
			#--------------------------------
			# for testing
			#--------------------------------
			#CUST.LADISB.OprAcctCrncyCode = "USD"
			
			#------------------------------------------------------------------------------
			#	If currency codes are different, Convert Amount
			#------------------------------------------------------------------------------
			IF(CUST.LADISB.oldLoanCrncyCode!=CUST.LADISB.OprAcctCrncyCode) THEN
			#{
				BANCS.INPARAM.InputAmount 	= CUST.LADISB.totalAmount
				BANCS.INPARAM.FromCurrency	= CUST.LADISB.oldLoanCrncyCode
				BANCS.INPARAM.ToCurrency 	= CUST.LADISB.OprAcctCrncyCode
				BANCS.INPARAM.RateCode 		= CUST.LADISB.limitRateCode
				BANCS.INPARAM.Rate 			= 0.00
				BANCS.INPARAM.CustId 		= ""
				
				sv_u = urhk_B2k_ConvertAmount("")
				print(sv_u)
				
				IF(sv_u == 0)THEN
				#{
					CUST.LADISB.operativeConvAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
					print(CUST.LADISB.operativeConvAmt)
					
					sv_s= "operativeConvTrcAmt| "
					sv_s = sv_s + "SELECT TRUNC(?SVAR,2)"
					sv_s = sv_s + "FROM DUAL "
					
					BANCS.INPARAM.BINDVARS = ""
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.operativeConvAmt
					print(sv_s)
					sv_q = urhk_dbSelectWithBind(sv_s)
					IF(sv_q != 0) THEN
					#{
						CUST.LADISB.errMsg = "Error occured in Truncating the Amount"
						print(CUST.LADISB.errMsg)
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						CUST.LADISB.operativeConvTrcAmt = BANCS.OUTPARAM.operativeConvTrcAmt
						print(CUST.LADISB.operativeConvTrcAmt)
						IF(CDOUBLE(CUST.LADISB.operativeConvTrcAmt) < 0) THEN
						#{
							CUST.LADISB.operativeConvTrcAmt = -1 * CDOUBLE(CUST.LADISB.operativeConvTrcAmt)
							print(CUST.LADISB.operativeConvTrcAmt)
							#}
						ELSE
							#{
							print(CUST.LADISB.operativeConvTrcAmt)
						#}
						ENDIF
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.LADISB.errMsg = "Error occured in converting the Amount"
					PRINT(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.LADISB.operativeConvTrcAmt = CUST.LADISB.totalAmount
				print(CUST.LADISB.operativeConvTrcAmt)
			#}
			ENDIF
			
			#================================================================
			#Putting Comma for the amt
			#================================================================
			sv_s= "operativeConvTrcAmt1| "
			sv_s = sv_s + "SELECT TO_CHAR(?SVAR,'999,999,999,999,999,999,999,990.99')"
			sv_s = sv_s + "FROM DUAL "
			BANCS.INPARAM.BINDVARS = ""
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.operativeConvTrcAmt
			
			sv_q = urhk_dbSelectWithBind(sv_s)
			CUST.LADISB.operativeConvTrcAmt = BANCS.OUTPARAM.operativeConvTrcAmt1
			
			#================================================================
			#Putting Comma for the amt
			#================================================================
			sv_s= "totalAmount1| "
			sv_s = sv_s + "SELECT TO_CHAR(?SVAR,'999,999,999,999,999,999,999,990.99')"
			sv_s = sv_s + "FROM DUAL "
			BANCS.INPARAM.BINDVARS = ""
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.totalAmount
			
			sv_q = urhk_dbSelectWithBind(sv_s)
			CUST.LADISB.totalAmount = BANCS.OUTPARAM.totalAmount1
			
			print(CUST.LADISB.OprAcctCrncyCode)
			print(CUST.LADISB.oldLoanCrncyCode)
			
			sv_z = "slno_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.count
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "acctno1_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.crdOpAcctNum
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "acctno1Crncy_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.OprAcctCrncyCode
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "crdr1_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.dr
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "amount1_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.operativeConvTrcAmt
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "acctno2_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.oldForacid
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "acctno2Crncy_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.oldLoanCrncyCode
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "crdr2_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.cr
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_z = "amount2_" + CUST.LADISB.count
			sv_z = sv_z + "|" + CUST.LADISB.totalAmount
			sv_u = urhk_SetOrbOut(sv_z)
			
			sv_c = urhk_dbCursorFetch(sv_l)
			print(sv_c)
			sv_a = sv_a + 1
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_l)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "") THEN
		#{
			print(CUST.LADISB.errMsg)
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
END-->
