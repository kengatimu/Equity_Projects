<--START
CHECKSUM="a89311d2850ebdd459977fcda94d43419be76f334e22c3890ac2f56fd9623374"
	trace on
	#LIBNAME ABGMASTER
	LIBNAME CUSTOMSO
	#-------------------------------------------------------------------------------
	# Creating Repository and Class
	#-------------------------------------------------------------------------------
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r ==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
