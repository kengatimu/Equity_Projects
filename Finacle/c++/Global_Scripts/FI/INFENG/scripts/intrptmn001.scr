	ENDIF
	
	#-------------------------------------------------------------------------------
	# Printing BANCS repository
	#-------------------------------------------------------------------------------
	#sv_u=urhk_b2k_PrintRepos("BANCS")
	#print (sv_u)
	
	#-------------------------------------------------------------------------------
	# Initializing the input variables
	#-------------------------------------------------------------------------------
	CUST.DATA.critType = BANCS.INPUT.radiobtn
	print(CUST.DATA.critType)
	CUST.DATA.BankID = BANCS.STDIN.contextBankId
	print(CUST.DATA.BankID)
	CUST.DATA.bacid = ""
	CUST.DATA.setID = ""
	CUST.DATA.ccy = ""
	CUST.DATA.StartDate = ""
	CUST.DATA.EndDate = ""
	CUST.DATA.glAcctNo = ""
	CUST.DATA.tranID = ""
	CUST.DATA.tranDate = ""
	CUST.DATA.valChk = "N"
	
	
	IF(CUST.DATA.critType =="crit1") THEN
	#{
		IF(FIELDEXISTS(BANCS.INPUT.bacid)) THEN
		#{
			CUST.DATA.bacid = BANCS.INPUT.bacid
			print(CUST.DATA.bacid)
		#}
		ENDIF
		IF(FIELDEXISTS(BANCS.INPUT.setID)) THEN
		#{
			CUST.DATA.setID = BANCS.INPUT.setID
			print(CUST.DATA.setID)
		#}
		ENDIF
		IF(FIELDEXISTS(BANCS.INPUT.ccy)) THEN
		#{
			CUST.DATA.ccy = BANCS.INPUT.ccy
			print(CUST.DATA.ccy)
		#}
		ENDIF
		IF(FIELDEXISTS(BANCS.INPUT.StartDate)) THEN
		#{
			CUST.DATA.StartDate = BANCS.INPUT.StartDate
			print(CUST.DATA.StartDate)
		#}
		ENDIF
		IF(FIELDEXISTS(BANCS.INPUT.EndDate)) THEN
		#{
			CUST.DATA.EndDate = BANCS.INPUT.EndDate
			print(CUST.DATA.EndDate)
		#}
		ENDIF
		#-------------------------------------------------------------------------
		# Validating the inputs
		#-------------------------------------------------------------------------
		IF(CUST.DATA.bacid != "") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.BankID + "|" + CUST.DATA.bacid + "|Y"
			print(BANCS.INPARAM.BINDVARS)
			sv_q = "COUNT_BACID|SELECT COUNT(1) "
			sv_q = sv_q + "FROM APH "
			sv_q = sv_q + "WHERE BANK_ID = ?SVAR "
			sv_q = sv_q + "AND BACID = ?SVAR "
			sv_q = sv_q + "AND DEL_FLG != ?SVAR "
			print(sv_q)
			sv_r = urhk_dbSelectWithBind(sv_q)
			print(sv_r)
			IF(sv_r == 0) THEN
			#{
				CUST.DATA.COUNT_BACID = BANCS.OUTPARAM.COUNT_BACID
				#}
			ELSE
				#{
				CUST.DATA.COUNT_BACID = 0
			#}
			ENDIF
			IF(CUST.DATA.COUNT_BACID == 0) THEN
			#{
				print("Invalid Bacid")
				#CUST.DATA.ErrMsg = urtn_getMsg("C03972")
				CUST.DATA.ErrMsg = "Invalid Bacid"
				sv_u = urhk_SetOrbOut("^Error_1|Error^" + CUST.DATA.ErrMsg + ".^bacid")
				sv_u = urhk_SetOrbOut("radiobtnval|1")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF
		IF(CUST.DATA.setID != "") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.BankID + "|" + CUST.DATA.setID
			print(BANCS.INPARAM.BINDVARS)
			sv_q = "COUNT_SETID|SELECT COUNT(1) "
			sv_q = sv_q + "FROM STID "
			sv_q = sv_q + "WHERE BANK_ID = ?SVAR "
			sv_q = sv_q + "AND SET_ID = ?SVAR "
			print(sv_q)
			sv_r = urhk_dbSelectWithBind(sv_q)
			print(sv_r)
			IF(sv_r == 0) THEN
			#{
				CUST.DATA.COUNT_SETID = BANCS.OUTPARAM.COUNT_SETID
				#}
			ELSE
				#{
				CUST.DATA.COUNT_SETID = 0
			#}
			ENDIF
			IF(CUST.DATA.COUNT_SETID == 0) THEN
			#{
				CUST.DATA.ErrMsg = "Invalid SET ID"
				print("Invalid SET ID")
				#CUST.DATA.ErrMsg = urtn_getMsg("C02560")
				sv_z = urhk_SetOrbOut("^Error_1|Error^" + CUST.DATA.ErrMsg + ".^setID")
				sv_z = urhk_SetOrbOut("radiobtnval|1")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF((CUST.DATA.ccy != "") AND (CUST.DATA.ccy != "ALL")) THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.BankID + "|" + CUST.DATA.ccy + "|Y|Y"
			print(BANCS.INPARAM.BINDVARS)
			sv_q = "COUNT_CCY|SELECT COUNT(1) "
			sv_q = sv_q + "FROM CNC "
			sv_q = sv_q + "WHERE BANK_ID = ?SVAR "
			sv_q = sv_q + "AND CRNCY_CODE = ?SVAR "
			sv_q = sv_q + "AND ENTITY_CRE_FLG = ?SVAR "
			sv_q = sv_q + "AND DEL_FLG != ?SVAR "
			print(sv_q)
			sv_r = urhk_dbSelectWithBind(sv_q)
			print(sv_r)
			IF(sv_r == 0) THEN
			#{
				CUST.DATA.COUNT_CCY = BANCS.OUTPARAM.COUNT_CCY
				#}
			ELSE
				#{
				CUST.DATA.COUNT_CCY = 0
			#}
			ENDIF
			IF(CUST.DATA.COUNT_CCY == 0) THEN
			#{
				print("Invalid CCY")
				CUST.DATA.ErrMsg = urtn_getMsg("C03211")
				CUST.DATA.ErrMsg = "Invalid Currency Code."
				sv_z = urhk_SetOrbOut("^Error_1|Error^" + CUST.DATA.ErrMsg + ".^ccy")
				sv_z = urhk_SetOrbOut("radiobtnval|1")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		CUST.DATA.valChk = "Y"
		#}
	ELSE
		#{
		CUST.DATA.glAcctNo = BANCS.INPUT.glAcctNo
		print(CUST.DATA.glAcctNo)
		CUST.DATA.tranID = BANCS.INPUT.tranID
		print(CUST.DATA.tranID)
		CUST.DATA.tranDate = BANCS.INPUT.TranDate
		print(CUST.DATA.tranDate)
		
		#-------------------------------------------------------------------------
		# Validating the inputs
		#-------------------------------------------------------------------------
		IF(CUST.DATA.glAcctNo != "") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.BankID + "|" + CUST.DATA.glAcctNo + "|O|Y|Y|Y"
			print(BANCS.INPARAM.BINDVARS)
			sv_q = "COUNT_GLACCTNO|SELECT COUNT(1) "
			sv_q = sv_q + "FROM GAM "
			sv_q = sv_q + "WHERE BANK_ID = ?SVAR "
			sv_q = sv_q + "AND FORACID = ?SVAR "
			sv_q = sv_q + "AND ACCT_OWNERSHIP = ?SVAR "
			sv_q = sv_q + "AND ENTITY_CRE_FLG = ?SVAR "
			sv_q = sv_q + "AND DEL_FLG != ?SVAR "
			sv_q = sv_q + "AND ACCT_CLS_FLG != ?SVAR "
			print(sv_q)
			sv_r = urhk_dbSelectWithBind(sv_q)
			print(sv_r)
			IF(sv_r == 0) THEN
			#{
				CUST.DATA.COUNT_GLACCTNO = BANCS.OUTPARAM.COUNT_GLACCTNO
				#}
			ELSE
				#{
				CUST.DATA.COUNT_GLACCTNO = 0
			#}
			ENDIF
			IF(CUST.DATA.COUNT_GLACCTNO == 0) THEN
			#{
				print("Invalid GL ACCOUNT NO.")
				#CUST.DATA.ErrMsg = urtn_getMsg("C03973")
				CUST.DATA.ErrMsg = "Invalid GL ACCOUNT NO."
				sv_z = urhk_SetOrbOut("^Error_1|Error^" + CUST.DATA.ErrMsg + ".^glAcctNo")
				sv_z = urhk_SetOrbOut("radiobtnval|2")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF((CUST.DATA.tranID != "") AND (CUST.DATA.tranDate != "")) THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.BankID + "|" + CUST.DATA.tranID + "|" + CUST.DATA.tranDate + "|Y|Y"
			print(BANCS.INPARAM.BINDVARS)
			sv_q = "COUNT_TRAN|SELECT COUNT(1) "
			sv_q = sv_q + "FROM DCTD_ACLI "
			sv_q = sv_q + "WHERE BANK_ID = ?SVAR "
			sv_q = sv_q + "AND TRAN_ID = lpad(?SVAR,9) "
			sv_q = sv_q + "AND TRAN_DATE = TO_DATE(?SVAR,'dd-mm-yyyy') "
			sv_q = sv_q + "AND PSTD_FLG = ?SVAR "
			sv_q = sv_q + "AND DEL_FLG != ?SVAR "
			print(sv_q)
			sv_r = urhk_dbSelectWithBind(sv_q)
			print(sv_r)
			IF(sv_r == 0) THEN
			#{
				CUST.DATA.COUNT_TRAN = BANCS.OUTPARAM.COUNT_TRAN
				#}
			ELSE
				#{
				CUST.DATA.COUNT_TRAN = 0
			#}
			ENDIF
			IF(CUST.DATA.COUNT_TRAN == 0) THEN
			#{
				print("No Transaction for this combination")
				#CUST.DATA.ErrMsg = urtn_getMsg("C03974")
				CUST.DATA.ErrMsg = "No Transaction for this combination"
				sv_z = urhk_SetOrbOut("^Error_1|Error^" + CUST.DATA.ErrMsg + CUST.DATA.tranID + " / " + CUST.DATA.tranDate + ".^tranID")
				sv_z = urhk_SetOrbOut("radiobtnval|2")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		CUST.DATA.valChk = "Y"
	#}
	ENDIF
	PRINT(CUST.DATA.valChk)
	IF(CUST.DATA.valChk == "Y") THEN
	#{
		
		#####################################################
		#Report Generatoin
		#####################################################
		CUST.DATA.comFile = "custEITRep_cr00719mn002.com"
		sv_u = urhk_getFileLocation("COM|" + CUST.DATA.comFile)
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.DATA.inputStr = CUST.DATA.bacid + "!" + CUST.DATA.setID + "!" + CUST.DATA.BankID + "!" + CUST.DATA.ccy + "!" + CUST.DATA.StartDate
			CUST.DATA.inputStr = CUST.DATA.inputStr + "!" + CUST.DATA.EndDate + "!" + CUST.DATA.glAcctNo + "!" + CUST.DATA.tranID + "!" + CUST.DATA.tranDate
			PRINT(CUST.DATA.inputStr)
			sv_a = "inputStr|" + CUST.DATA.inputStr
			sv_b = urhk_putEnvForCallShellScript(sv_a)
			PRINT(sv_b)
			BANCS.INPARAM.scriptName = "custEITRep_cr00719mn002.com"
			BANCS.INPARAM.arguments = ""
			sv_d = urhk_CallShellScript("b")
			print(sv_d)
			
			IF (sv_d == "0") THEN
			#{
				sv_p = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_p = urhk_SetOrbOut("RESULT_MSG|Report Generation Initiated. Please check HPR for the Report")
				#}
			ELSE
				#{
				sv_p = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_p = urhk_SetOrbOut("RESULT_MSG|No Records fetched for the combination")
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_p = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_p = urhk_SetOrbOut("RESULT_MSG|Report Generation Failed")
		#}
		ENDIF
		
		
	#}
	ENDIF
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	ENDOFSCRIPT:
		#=============================================
		# Delete the created Repositories and Classes
		#=============================================
		IF (REPEXISTS("CUST") == 1) THEN
		#{
			DELETEREP("CUST")
		#}
