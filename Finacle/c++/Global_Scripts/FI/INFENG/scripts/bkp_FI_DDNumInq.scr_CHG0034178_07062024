#------------------------------------------------------------------------------------------------
#  Name            : FI_DDNumInq.scr
#  Description     : DD Number Inquiry
#  Date            : 30-06-2023
#  Author          : James Maina
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             30-06-2023      James Maina		Original Version
#-----------------------------------------------------------------------------------------------

<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","PRINT") == 0) THEN
        #{
                CREATECLASS("CUST","PRINT",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("TranID"))== 0) ) THEN
	#{
   		CUST.PRINT.errMsg="TranID IS NULL"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.PRINT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("USERID"))== 0) ) THEN
	#{
   		CUST.PRINT.errMsg="USERID IS NULL"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.PRINT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#----------------------------------------------------------------------------------------------------
	# Variable initialization
	#----------------------------------------------------------------------------------------------------
	CUST.PRINT.TRANID= BANCS.INPUT.TranID	
	print(CUST.PRINT.TRANID)
	CUST.PRINT.USERID= BANCS.INPUT.USERID	
	print(CUST.PRINT.USERID)

	#----------------------------------------------------------------------------------------------------
	# get emp id
	#----------------------------------------------------------------------------------------------------
	sv_s = "delflg, empid, solid|"
	sv_s = sv_s + "select del_flg, user_emp_id,sol_id from "
	sv_s = sv_s + "tbaadm.upr where user_id=?SVAR "

	BANCS.INPARAM.BINDVARS = CUST.PRINT.USERID
	print(BANCS.INPARAM.BINDVARS)	
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d==0)THEN
	#{
		CUST.PRINT.delflg= BANCS.OUTPARAM.delflg
		print(CUST.PRINT.delflg)
		CUST.PRINT.empid= BANCS.OUTPARAM.empid
		print(CUST.PRINT.empid)
		CUST.PRINT.solid= BANCS.OUTPARAM.solid
		print(CUST.PRINT.solid)
		IF(CUST.PRINT.delflg=='N')THEN
		#{
   			CUST.PRINT.errMsg="The userid passed is deleted"
			sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_t = "Msg| " +CUST.PRINT.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
   		CUST.PRINT.errMsg="Invalid userid"
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.PRINT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT	
	#}
	ENDIF

	############################Get the correct format of the tranId, serialnum for srv######################

	sv_s = "tranid, trandate, srlnum, prntsol|"
	sv_s = sv_s + " select tran_id, to_char(tran_date,'DD-MM-YYYY'), part_tran_srl_num,print_sol_id from tbaadm.ddc where "
	sv_s = sv_s + "trim(tran_id)=?SVAR and tran_date=TO_DATE(?SVAR ,'DD-MM-YYYY HH24:MI:SS') and bank_Id=?SVAR "

	BANCS.INPARAM.BINDVARS = CUST.PRINT.TRANID+"|"+ BANCS.STDIN.BODDate +"|"+BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d==0)THEN
	#{
		CUST.PRINT.tranid= BANCS.OUTPARAM.tranid
		print(CUST.PRINT.tranid)
		CUST.PRINT.trandate= BANCS.OUTPARAM.trandate
		CUST.PRINT.trandate= CUST.PRINT.trandate+ " 00:00:00"
		print(CUST.PRINT.trandate)
		CUST.PRINT.srlnum= BANCS.OUTPARAM.srlnum
		PRINT(CUST.PRINT.srlnum)
		CUST.PRINT.prntsol= BANCS.OUTPARAM.prntsol
		PRINT(CUST.PRINT.prntsol)
	#}
	ELSE
	#{
   		CUST.PRINT.errMsg="The demand draft record is not found."
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "Msg| " +CUST.PRINT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT	
	#}
	ENDIF
	

	IF(CUST.PRINT.prntsol !=BANCS.STDIN.mySolId)THEN
	#{
		sv_u = urhk_SetUrhkInp("sol.solId|"+CUST.PRINT.prntsol)
		sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
		IF(sv_u !=0)THEN
		#{
   			CUST.PRINT.errMsg="Failed to switch sol"
			sv_t = "Msg| " +CUST.PRINT.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	sv_u = urhk_SetUrhkInp("ddDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("pTran.tranId|" + CUST.PRINT.tranid)
	sv_u = urhk_SetUrhkInp("pTran.partTranSrlNum|" + CUST.PRINT.srlnum)
	sv_u = urhk_SetUrhkOut("inventory.num|dnum")
		
	sv_u = urhk_ExecSrv("SRV_FetchDDDtlForPrint|retain_all_output = Y|same_user_verify = Y")
	PRINT(sv_u)
	IF (sv_u == 0)THEN
	#{
		print(BANCS.OUTPARAM.dnum)
		CUST.PRINT.dnum= trim(BANCS.OUTPARAM.dnum)
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Success")
		sv_t = "DemandDraftNo| " +CUST.PRINT.dnum
		sv_u = urhk_SetOrbOut(sv_t)
	#}
	ELSE
	#{
		GOTO CHECKERROR
	#}
	ENDIF

	CHECKERROR:
	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error'")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>ddnumInq.log")
				print(sv_u)
				
				#Error response
				sv_t = "Msg| " +sv_e
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT

			#}
			DO
			#}
		ENDIF
	#}
	ENDIF
ENDSCRIPT:
trace off
end-->