<--START
TRACE ON

  #---------------------------------------------------------
        # Create the necessary repos and classes
        #---------------------------------------------------------

        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

        #---------------------------------------------------------
        #       Bancs Repository Printing
        #---------------------------------------------------------

        sv_x = urhk_B2k_PrintRepos("BANCS")
        PRINT(sv_x)

        CUST.DATA.succFail="F"
        CUST.DATA.count = "0"

        IF(FIELDEXISTS(BANCS.INPUT.bankId)==0) THEN
        #{
                CUST.DATA.bankId = ""
        #}
        ELSE
        #{
                CUST.DATA.bankId = BANCS.INPUT.bankId
                PRINT(CUST.DATA.bankId)
        #}
        ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.schmType)==0) THEN
        #{
                CUST.DATA.schmType = ""
        #}
        ELSE
        #{
                CUST.DATA.schmType = BANCS.INPUT.schmType
                PRINT(CUST.DATA.schmType)
        #}
        ENDIF

	IF(CUST.DATA.bankId == "") THEN
	#{
		sv_u = urhk_SetOrbOut("Failed| Please enter Bank Id")
                print(sv_u)
		
		EXITSCRIPT
	#}
	ENDIF

	IF(CUST.DATA.schmType == "")THEN
        #{
                sv_u = urhk_SetOrbOut("Failed| Please enter Scheme Type")
                print(sv_u)

                EXITSCRIPT
        #}
        ENDIF

	IF((CUST.DATA.bankId != "") and (CUST.DATA.schmType != ""))THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.schmType+ "|" +CUST.DATA.bankId
		print(BANCS.INPARAM.BINDVARS)

		sv_a = "schmCode,schmDesc|select unique schm_code,schm_desc"
		sv_a = sv_a + " from tbaadm.gsp"
		sv_a = sv_a + " where schm_type=?SVAR and del_flg ='N' and bank_id=?SVAR "
		print(sv_a)
	
		sv_d = urhk_dbCursorOpenWithBind(sv_a)
		print(sv_d)

		IF(sv_d!=0) THEN
		#{
			sv_u = urhk_dbCursorClose(sv_a)
			print(sv_u)

			sv_u = urhk_SetOrbOut("Status| No record found")
			print(sv_u)
		#}
		ELSE
		#{
			CUST.DATA.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(CUST.DATA.DB_CURSOR_NUMBER)

			sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
			print(sv_c)

			IF(sv_c != "0")THEN
			#{
				sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
				sv_u = urhk_SetOrbOut("Failure| No record found")	
				print(sv_u) 
			#}
			ENDIF

			while(sv_c ==0)
			#{
				CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
				print(CUST.DATA.schmCode)
				CUST.DATA.schmDesc = BANCS.OUTPARAM.schmDesc
				print(CUST.DATA.schmDesc)

				CUST.DATA.count = CINT(CUST.DATA.count)+ 1
				print(CUST.DATA.count)

				sv_c = urhk_SetOrbOut("SchemeDetails.<rec_"+CUST.DATA.count+">.SchemeCode"+"| "+CUST.DATA.schmCode)
				print(sv_c)
				
				sv_c = urhk_SetOrbOut("SchemeDetails.<rec_"+CUST.DATA.count+">.SchemeDesc"+"| "+CUST.DATA.schmDesc)
				print(sv_c)
				
				sv_c = urhk_dbCursorFetch(CUST.DATA.DB_CURSOR_NUMBER)
				print(sv_c)
			#}
			do
			sv_c = urhk_dbCursorClose(CUST.DATA.DB_CURSOR_NUMBER)
			print(sv_c)
		#}
		ENDIF
	#}
	ENDIF

EXITSCRIPT




