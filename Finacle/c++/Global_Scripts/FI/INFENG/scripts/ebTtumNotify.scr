<--start
trace on
#Rep/Class
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(classexists("CUST","ALERTS")==0)then
                createclass("CUST","ALERTS",5)
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                ##print(MTT.InputDetails.Argument1)
                ##EBSRV.GLBDATA.TranAmt = trim(MTT.InputDetails.Argument1)
                ##EBSRV.GLBDATA.TranAmt = cdouble(LEFT$(EBSRV.GLBDATA.TranAmt,14))
                ##EBSRV.GLBDATA.CrAcctId = MTT.InputDetails.Argument2
                ##EBSRV.GLBDATA.DccId = MTT.InputDetails.Argument3
                ##EBSRV.GLBDATA.TranId = MTT.InputDetails.Argument4
                ##EBSRV.GLBDATA.tranRemarks = EBSRV.GLBDATA.TranId
                ##EBSRV.GLBDATA.ptranType = MTT.InputDetails.Argument5
                ##EBSRV.GLBDATA.ModuleId = MTT.InputDetails.Argument6
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                ###goto VAYU
        endif
	if(CUST.ALERTS.AlertModule=="TTALERT")then
                EBSRV.GLBDATA.TranAmt = trim(CUST.ALERTS.TranAmt)
                ###EBSRV.GLBDATA.TranAmt = cdouble(LEFT$(EBSRV.GLBDATA.TranAmt,14))
                EBSRV.GLBDATA.TranAmt = left$(EBSRV.GLBDATA.TranAmt,14)
                EBSRV.GLBDATA.CrAcctId = CUST.ALERTS.AcctNum 
                EBSRV.GLBDATA.DccId = CUST.ALERTS.DeliveryChnlId 
                EBSRV.GLBDATA.TranId = CUST.ALERTS.TranId 
                EBSRV.GLBDATA.tranRemarks = CUST.ALERTS.TranId 
                EBSRV.GLBDATA.ptranType = CUST.ALERTS.partTranType 
                EBSRV.GLBDATA.ModuleId = CUST.ALERTS.moduleId 
	endif
	##sv_s = "dtdCnt | select count(*) from tbaadm.dtd where tran_id = lpad(?SVAR,9,' ') "
	##sv_s = sv_s + " and bank_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR') and pstd_flg='Y' "
	##print(sv_s)
	##BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.TranId + "|" + BANCS.STDIN.contextBankId + "|" + mid$(BANCS.STDIN.BODDate,0,10) 
	##print(BANCS.INPARAM.BINDVARS)
	##sv_u = urhk_dbSelectWithBind(sv_s)
	##if(sv_u==0)then
##		EBSRV.GLBDATA.dtdCnt = BANCS.OUTPARAM.dtdCnt
##	else
##		EBSRV.GLBDATA.dtdCnt = 0
##	endif
##	if(cdouble(EBSRV.GLBDATA.dtdCnt)<=0)then
##		goto VAYU
##	endif
	sv_u = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.CrAcctId)
	print(sv_u)
	if(sv_u==0)then
		EBSRV.GLBDATA.drBalance = BANCS.OUTPARAM.ClearBalance
		EBSRV.GLBDATA.drCif  = BANCS.OUTPARAM.cifId
	else
		EBSRV.GLBDATA.drBalance = ""
		EBSRV.GLBDATA.drCif = ""
	endif
	sv_m = "smsNum,cntryCode,cityCode,localCode|"
	sv_m = sv_m + " select phoneno,phonenocountrycode,phonenocitycode,phonenolocalcode"
	sv_m = sv_m + " from crmuser.cphone "
	sv_m = sv_m + " where bank_id=?SVAR "
	sv_m = sv_m + " and phone_b2kid=?SVAR "
	sv_m = sv_m + " and preferredflag='Y' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.drCif 
	print(sv_m)
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_m)
	if(sv_u==0)then
		EBSRV.GLBDATA.smsNum = BANCS.OUTPARAM.smsNum
		EBSRV.GLBDATA.cntryCode = BANCS.OUTPARAM.cntryCode
		EBSRV.GLBDATA.cityCode = BANCS.OUTPARAM.cityCode
		EBSRV.GLBDATA.localCode = BANCS.OUTPARAM.localCode
	else
		EBSRV.GLBDATA.smsNum = ""
		EBSRV.GLBDATA.cntryCode = ""
		EBSRV.GLBDATA.cityCode = ""
		EBSRV.GLBDATA.localCode = ""
	endif
        sv_d = "idO,idT| select substr(?SVAR,1,4),lpad(substr(?SVAR,-4),10,'X') from dual "
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.CrAcctId +"|"+ EBSRV.GLBDATA.CrAcctId
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.idO = BANCS.OUTPARAM.idO
		EBSRV.GLBDATA.idT = BANCS.OUTPARAM.idT
		EBSRV.GLBDATA.foracid = EBSRV.GLBDATA.idO +""+EBSRV.GLBDATA.idT
		print(EBSRV.GLBDATA.foracid)
	endif
	EBSRV.GLBDATA.SmsVal = "Txn: A fee has been deducted from your account Acct:" + EBSRV.GLBDATA.foracid + " Amt:KES " +EBSRV.GLBDATA.TranAmt+ " Desc: Annual Debit Card Fee Date:" +BANCS.STDIN.sysDate+ " Use Equity USSD on Any Telco."
	CUST.ALERTS.massage = EBSRV.GLBDATA.SmsVal
	print(CUST.ALERTS.massage)
	CUST.ALERTS.phoneno = EBSRV.GLBDATA.smsNum
	CUST.ALERTS.trandate = mid$(BANCS.STDIN.BODDate,0,10)
	callscriptifexist("smspushothers.scr")
VAYU:
        ####if(classexists("EBSRV","GLBDATA")==1) then
                ####deleteclass("EBSRV","GLBDATA")
        ####endif
        #####if(repexists("EBSRV")==1) then
                #####deleterep("EBSRV")
        #####endif
        exitscript
trace off
end-->
