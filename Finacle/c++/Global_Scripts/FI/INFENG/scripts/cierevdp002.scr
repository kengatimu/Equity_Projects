	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIEREV Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIEREV")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIEREV",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIEREV.targetEntity = " "
	CUST.CIEREV.errorFlg = "N"
	CUST.CIEREV.errorMsg = " "
	CUST.CIEREV.targetEntityDesc = " "
	
	sv_u = urhk_b2k_printrepos("BANCS")
	print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.targetEntity))THEN
	#{
		IF(TRIM(BANCS.INPUT.targetEntity) != "")THEN
		#{
			CUST.CIEREV.targetEntity = TOUPPER(TRIM(BANCS.INPUT.targetEntity))
			print(CUST.CIEREV.targetEntity)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CIEREV.errorFlg = "Y"
		CUST.CIEREV.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "targetEntity,targetEntityDesc|"
	sv_s = sv_s + " SELECT BANK_ID,GROUP_DESC"
	sv_s = sv_s + " FROM TBAADM.GCT "
	sv_s = sv_s + " WHERE BANK_ID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIEREV.targetEntity
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CIEREV.targetEntity = BANCS.OUTPARAM.targetEntity
		print(CUST.CIEREV.targetEntity)
		CUST.CIEREV.targetEntityDesc = BANCS.OUTPARAM.targetEntityDesc
		print(CUST.CIEREV.targetEntityDesc)
		
		#}
	ELSE
		#{
		CUST.CIEREV.errorFlg = "Y"
		CUST.CIEREV.errorMsg = "Invalid Entity ID"
	#}
	ENDIF
	
	CUST.CIEREV.targetEntityDesc = TOUPPER(CUST.CIEREV.targetEntityDesc)
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIEREV.errorFlg)
		print(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIEREV.errorMsg)
		print(sv_u)
