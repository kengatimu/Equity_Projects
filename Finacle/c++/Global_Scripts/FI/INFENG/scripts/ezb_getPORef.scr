<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	#-------------------------------------------------------------------------------------------
	# Variable Initialization
	#-------------------------------------------------------------------------------------------

    IF( (FIELDEXISTS(("BANCS").("INPUT").("paymentRefNum"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please enter payment reference number."
		lv_a = "E9999"
		sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
    ELSE
        CUST.EZB.refNum = BANCS.INPUT.paymentRefNum
        print(CUST.EZB.refNum)
	#}
	ENDIF

	lv_q = " freeText,valueDate,refNum, tranDate | "
	lv_q = lv_q + " SELECT P.FREE_TEXT,P.CR_VALUE_DATE,P.PYMT_REF_NUM, S.TRAN_DATE FROM TBAADM.PORD P, TBAADM.SMH S "
	lv_q = lv_q + " WHERE P.BANK_ID =S.BANK_ID AND P.PYMT_REF_NUM=S.SENDER_REF_NUM AND P.BANK_ID=?SVAR AND P.PYMT_REF_NUM=?SVAR AND P.DELETE_PYMT='N' "
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+ CUST.EZB.refNum
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbSelectWithBind(lv_q)
	PRINT(sv_c)

	IF(sv_c == 0)THEN
	#{
		CUST.EZB.valueDate = BANCS.OUTPARAM.valueDate
		print(CUST.EZB.valueDate)
		CUST.EZB.freeText = BANCS.OUTPARAM.freeText
		print(CUST.EZB.freeText)
		CUST.EZB.refNum = BANCS.OUTPARAM.refNum
		print(CUST.EZB.refNum)
		CUST.EZB.tranDate = BANCS.OUTPARAM.tranDate
		print(CUST.EZB.tranDate)

		IF(CUST.EZB.freeText !="")THEN
		#{
			sv_t = "Payment_RES.<rec_1>.reference |" + CUST.EZB.freeText
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "Payment_RES.<rec_1>.valueDate |" + CUST.EZB.valueDate
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "Payment_RES.<rec_1>.transactionId |" + CUST.EZB.refNum
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "Payment_RES.<rec_1>.tranDate |" + CUST.EZB.tranDate
			sv_u = urhk_SetOrbOut(sv_t)
		ELSE
			CUST.EZB.errMsg="Error: Could not get the reference."
			lv_a = "E9999"
			sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
			sv_u = urhk_SetOrbErr(sv_c)
			exitscript
		#}
		ENDIF
	ELSE
		CUST.EZB.errMsg="Error: Could not fetch the record."
        lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(sv_c)
		exitscript
	#}
	ENDIF

ENDSCRIPT:
trace off
END-->