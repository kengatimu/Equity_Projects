<--START
CHECKSUM="8ba2df8fe35de604997a735af5480b6f9e8fb512dbce02133a901a6e36ddcfb2"
	TRACE ON
	#---------------------------------------------------------------------------------
	# CREATING NEW REPOSITORY AND CLASS
	#---------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.foracid)
	PRINT(BANCS.INPUT.instrNo)
	PRINT(BANCS.INPUT.bgChqNo)
	PRINT(BANCS.INPUT.noOfLeav)
	#---------------------------------------------------------------------------
	#The foll step is to Validate Foracid
	#---------------------------------------------------------------------------
	CUST.DATA.funcCode = BANCS.INPUT.funcCode
	CUST.DATA.foracid = BANCS.INPUT.foracid
	CUST.DATA.instType = BANCS.INPUT.instrNo
	CUST.DATA.beginChqNo = BANCS.INPUT.bgChqNo
	CUST.DATA.noOfLvs = BANCS.INPUT.noOfLeav
	
	IF (CUST.DATA.funcCode == "") THEN
	#{
		sv_e = "Function code should be be entered"
		sv_m = "funcCode"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF ((CUST.DATA.funcCode != "I") AND (CUST.DATA.funcCode != "D") AND (CUST.DATA.funcCode != "S")) THEN
		#{
			sv_e = "Invalid function code I-Inquire,D-Destroy,S-Stop"
			sv_m = "funcCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	#---------------------------------------------------------------------------
	#The foll step is to Validate Foracid
	#---------------------------------------------------------------------------
	IF (CUST.DATA.foracid == "") THEN
	#{
		sv_e = "Account Number should be entered"
		sv_m = "foracid"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_s = "Count|select count(1) "
		sv_s = sv_s + "from tbaadm.GAM where "
		sv_s = sv_s + "foracid= ?SVAR "
		sv_s = sv_s + "AND acct_cls_flg !='Y' "
		sv_s = sv_s + "AND del_flg !='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.DATA.foracid   + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		sv_q = BANCS.OUTPARAM.Count
		PRINT(sv_q)
		IF (sv_q != "1") THEN
		#{
			sv_e = "Invalid Account Number"
			sv_m = "foracid"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Instrument Type
	#---------------------------------------------------------------------------
	IF (CUST.DATA.instType == "") THEN
	#{
		sv_e = "Instrument Type should be entered"
		sv_m = "instrNo"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_x = "count|select count(1) from custom.c_cbt_int where del_flg!='Y' "
		sv_x = sv_x + " AND inst_type = ?SVAR "
		sv_x = sv_x + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType  + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_x = urhk_dbSelectWithBind(sv_x)
		PRINT(sv_x)
		IF (CINT(BANCS.OUTPARAM.count) == 0) THEN
		#{
			sv_e = "Invalid Instrument Type"
			sv_m = "instrNo"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.DATA.instType == "CHQ") THEN
	#{
		sv_e = "CHQ Type Instrumnet Not allowded. Use CHQM Menu"
		sv_m = "instrNo"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------
	# General Validation
	#--------------------------------------------
	
	sv_a = urhk_getAcctDetailsInRepository(CUST.DATA.foracid)
	print(sv_a)
	IF (sv_a == 0) THEN
	#{
		print(BANCS.STDIN.mySolId)
		print(BANCS.OUTPARAM.acctSolId)
		print(BANCS.OUTPARAM.schmCode)
		IF (BANCS.INPUT.funcCode != "I") THEN
		#{
			IF (BANCS.STDIN.mySolId != BANCS.OUTPARAM.acctSolId) THEN
			#{
				sv_e = "Account belongs to different SOL"
				sv_m = "foracid"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = "countInst | "
		sv_s = sv_s + " SELECT COUNT(*) "
		sv_s = sv_s + " FROM CUSTOM.C_CBT_MOD "
		sv_s = sv_s + " WHERE foracid = ?SVAR "
		sv_s = sv_s + " AND inst_type = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND del_flg != 'Y' "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + CUST.DATA.instType + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		print(BANCS.OUTPARAM.countInst)
		
		IF(CINT(BANCS.OUTPARAM.countInst) > 0 ) THEN
		#{
			sv_e = "Cheque Already Destroy/Stop"
			sv_m = "foracid"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.DATA.funcCode!= "I") THEN
	#{
		IF (CUST.DATA.beginChqNo == "") THEN
		#{
			sv_e = "Begin Chq Number should be entered"
			sv_m = "bgChqNo"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (CUST.DATA.noOfLvs == "") THEN
		#{
			sv_e = "Number of lvs should be entered"
			sv_m = "noOfLeav"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#----------------------------------------------------------
	# DESTROY INHOUSE CHQ BOOKS
	#----------------------------------------------------------
	IF ((CUST.DATA.funcCode == "S") OR (CUST.DATA.funcCode == "D")) THEN
	#{
		PRINT(CUST.DATA.funcCode)
		PRINT(CUST.DATA.foracid)
		PRINT(CUST.DATA.instType)
		PRINT(CUST.DATA.beginChqNo)
		PRINT(CUST.DATA.noOfLvs)
		
		sv_s = "ACID,CHQ_ISSU_DATE,BEGIN_CHQ_NUM,CHQ_NUM_OF_LVS,CHQ_LVS_STAT,NUM_PAID,NUM_UNUSED,NUM_STOPED,NUM_DESTROYED|"
		sv_s = sv_s + "select ACID,CHQ_ISSU_DATE,BEGIN_CHQ_NUM,CHQ_NUM_OF_LVS,CHQ_LVS_STAT,NUM_PAID,NUM_UNUSED,NUM_STOPED,"
		sv_s = sv_s + "NUM_DESTROYED FROM CUSTOM.C_CBT WHERE "
		sv_s = sv_s + "INST_TYPE= ?SVAR "
		sv_s = sv_s + "AND FORACID=?SVAR "
		sv_s = sv_s + "AND BEGIN_CHQ_NUM <= ?SVAR "
		sv_s = sv_s + "AND (BEGIN_CHQ_NUM+CHQ_NUM_OF_LVS-1) >= ?SVAR "
		sv_s = sv_s + "AND ( ?SVAR between BEGIN_CHQ_NUM "
		sv_s = sv_s + "AND (BEGIN_CHQ_NUM + CHQ_NUM_OF_LVS - 1)) "
		sv_s = sv_s + "AND DEL_FLG!='Y' "
		sv_s = sv_s + "AND BANK_ID = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + CUST.DATA.foracid + "|" + CUST.DATA.beginChqNo + "|" + CUST.DATA.beginChqNo + "|" + CUST.DATA.beginChqNo + "|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		PRINT(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF (sv_d != 0) THEN
		#{
			sv_e = "No Record Found"
			sv_m = "funcCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.DATA.ACID = BANCS.OUTPARAM.ACID
		CUST.DATA.CHQ_ISSU_DATE = BANCS.OUTPARAM.CHQ_ISSU_DATE
		CUST.DATA.BEGIN_CHQ_NUM = BANCS.OUTPARAM.BEGIN_CHQ_NUM
		CUST.DATA.CHQ_NUM_OF_LVS = BANCS.OUTPARAM.CHQ_NUM_OF_LVS
		CUST.DATA.CHQ_LVS_STAT = BANCS.OUTPARAM.CHQ_LVS_STAT
		CUST.DATA.NUM_PAID = BANCS.OUTPARAM.NUM_PAID
		CUST.DATA.NUM_UNUSED = BANCS.OUTPARAM.NUM_UNUSED
		CUST.DATA.NUM_STOPED = BANCS.OUTPARAM.NUM_STOPED
		CUST.DATA.NUM_DESTROYED = BANCS.OUTPARAM.NUM_DESTROYED
		#----------------------------------------------------------
		#--Checking for no of leaves
		#----------------------------------------------------------
		sv_n = CINT(CUST.DATA.BEGIN_CHQ_NUM) + cint(CUST.DATA.CHQ_NUM_OF_LVS)
		print(sv_n)
		
		sv_k = cint(CUST.DATA.BEGIN_CHQ_NUM) + cint(CUST.DATA.noOfLvs)
		print(sv_k)
		IF (sv_k > sv_n) THEN
		#{
			sv_e = "No of Leaves are more"
			sv_m = "noOfLeav"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------------------------
		#--selecting spilted status from c_cbt
		#----------------------------------------------------------
		print(CUST.DATA.beginChqNo)
		print(CUST.DATA.BEGIN_CHQ_NUM)
		IF (CUST.DATA.beginChqNo != CUST.DATA.BEGIN_CHQ_NUM) THEN
		#{
			CUST.DATA.temp = cint(CUST.DATA.beginChqNo) - cint(CUST.DATA.BEGIN_CHQ_NUM)
			print(CUST.DATA.temp)
			#}
		ELSE
			#{
			CUST.DATA.temp  = "0"
		#}
		ENDIF
		
		sv_n = "substr(CHQ_LVS_STAT,1," + CUST.DATA.temp + "),"
		print(sv_n)
		#----------------------------------------------------------
		#Second split(affected part) - small user input
		#----------------------------------------------------------
		print(CUST.DATA.temp)
		CUST.DATA.temp = cint(CUST.DATA.temp) + cint("1")
		print(CUST.DATA.temp)
		sv_n = sv_n + "substr(CHQ_LVS_STAT," + CUST.DATA.temp + "," + CUST.DATA.noOfLvs + "),"
		print(sv_n)
		
		#----------------------------------------------------------
		# Last split (end part)   - small user input
		#----------------------------------------------------------
		
		CUST.DATA.temp = cint(CUST.DATA.temp) + cint(CUST.DATA.noOfLvs)
		print(CUST.DATA.temp)
		sv_n = sv_n + "substr(CHQ_LVS_STAT," + CUST.DATA.temp + ","
		print(sv_n)
		
		CUST.DATA.temp = cint(CUST.DATA.CHQ_NUM_OF_LVS) - (cint(CUST.DATA.temp) - cint("1"))
		print(CUST.DATA.temp)
		IF (trim(CUST.DATA.temp) == "") THEN
		#{
			CUST.DATA.temp = "0"
		#}
		ENDIF
		
		sv_n = sv_n + CUST.DATA.temp + ") "
		PRINT(sv_n)
		
		sv_s = "FIRST_PART,SECOND_PART,LAST_PART|"
		sv_s = sv_s + "select " + sv_n + " FROM CUSTOM.C_CBT WHERE "
		sv_s = sv_s + "INST_TYPE = ?SVAR "
		sv_s = sv_s + "AND FORACID = ?SVAR "
		sv_s = sv_s + "AND (BEGIN_CHQ_NUM+CHQ_NUM_OF_LVS-1) >= ?SVAR "
		sv_s = sv_s + "AND ( ?SVAR between BEGIN_CHQ_NUM "
		sv_s = sv_s + "AND (BEGIN_CHQ_NUM + CHQ_NUM_OF_LVS - 1)) "
		sv_s = sv_s + "AND DEL_FLG != 'Y' "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + CUST.DATA.foracid + "|" + CUST.DATA.beginChqNo + "|" + CUST.DATA.beginChqNo + "|"+ BANCS.STDIN.contextBankId
		PRINT(	BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			sv_e = "DataBase Error. Contact your DBA"
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.DATA.FIRST_PART = BANCS.OUTPARAM.FIRST_PART
		CUST.DATA.SECOND_PART = BANCS.OUTPARAM.SECOND_PART
		CUST.DATA.LAST_PART = BANCS.OUTPARAM.LAST_PART
		sv_n = STRLEN(CUST.DATA.FIRST_PART)
		print(sv_n)
		sv_n = STRLEN(CUST.DATA.LAST_PART)
		print(sv_n)
		sv_n = STRLEN(CUST.DATA.SECOND_PART)
		print(sv_n)
		CUST.DATA.new_second_part = ""
		sv_x = CUST.DATA.funcCode
		print(sv_x)
		CUST.DATA.temp1 = "0"
		CUST.DATA.temp2 = "1"
		CUST.DATA.temp3 = "0"
		CUST.DATA.temp4 = "0"
		
		WHILE(sv_n)
		#{
			print(sv_n)
			sv_a = MID$(CUST.DATA.SECOND_PART,cint(CUST.DATA.temp1),cint(CUST.DATA.temp2))
			print(sv_a)
			IF (sv_a == "P") THEN
			#{
				sv_e = "Chq Already Passed"
				sv_m = "count"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
				CUST.DATA.new_second_part = CUST.DATA.new_second_part + "P"
				print(CUST.DATA.new_second_part)
			#}
			ELSE
				#{
				print(sv_x)
				CUST.DATA.new_second_part = CUST.DATA.new_second_part + sv_x
				print(CUST.DATA.new_second_part)
				CUST.DATA.temp3 = cint(CUST.DATA.temp3) + 1
				print(CUST.DATA.temp3)
				IF (sv_a == "U") THEN
				#{
					CUST.DATA.temp4 = cint(CUST.DATA.temp4) + 1
					print(CUST.DATA.temp4)
				#}
				ENDIF
			#}
			ENDIF
			
			CUST.DATA.temp1 = cint(CUST.DATA.temp1) + 1
			print(CUST.DATA.temp1)
			print(CUST.DATA.temp2)
			sv_n = sv_n - 1
			print(sv_n)
		#}
		DO
		print(CUST.DATA.FIRST_PART)
		print(CUST.DATA.new_second_part)
		print(CUST.DATA.LAST_PART)
		CUST.DATA.new_status = CUST.DATA.FIRST_PART + CUST.DATA.new_second_part + CUST.DATA.LAST_PART
		print(CUST.DATA.new_status)
		print(CUST.DATA.temp3)
		print(CUST.DATA.temp4)
		
		IF (CUST.DATA.funcCode == "D") THEN
		#{
			CUST.DATA.new_destroyed = cint(CUST.DATA.NUM_DESTROYED) + cint(CUST.DATA.temp3)
			CUST.DATA.new_num_stoped = CUST.DATA.NUM_STOPED
			CUST.DATA.new_num_unused = cint(CUST.DATA.NUM_UNUSED) - cint(CUST.DATA.temp4)
			print(CUST.DATA.new_destroyed)
			print(CUST.DATA.new_num_stoped)
			print(CUST.DATA.new_num_unused)
			#}
		ELSE
			#{
			CUST.DATA.new_destroyed = CUST.DATA.NUM_DESTROYED
			CUST.DATA.new_num_stoped = cint(CUST.DATA.NUM_STOPED) + cint(CUST.DATA.temp3)
			CUST.DATA.new_num_unused = cint(CUST.DATA.NUM_UNUSED) - cint(CUST.DATA.temp4)
			print(CUST.DATA.new_destroyed)
			print(CUST.DATA.new_num_stoped)
			print(CUST.DATA.new_num_unused)
		#}
		ENDIF
		#-------------------------------------------------------------
		# Inserting into C_CBT_MOD table
		#-------------------------------------------------------------
		sv_x = "INSERT INTO CUSTOM.C_CBT_MOD VALUES("
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "'N',"
		sv_x = sv_x + "'N',"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "0,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "SYSDATE,"
		sv_x = sv_x + "?SVAR,"
		sv_x = sv_x + "SYSDATE,"
		sv_x = sv_x + "?SVAR)"
		BANCS.INPARAM.BINDVARS = CUST.DATA.BEGIN_CHQ_NUM + "|" + CUST.DATA.ACID + "|" + CUST.DATA.foracid + "|" + CUST.DATA.instType  + "|" + CUST.DATA.instType + "|" + CUST.DATA.CHQ_ISSU_DATE  + "|" +  CUST.DATA.CHQ_NUM_OF_LVS + "|" + CUST.DATA.new_status  + "|" + CUST.DATA.NUM_PAID + "|" +  CUST.DATA.new_num_unused  + "|" + CUST.DATA.new_num_stoped + "|" + CUST.DATA.new_destroyed + "|" +  CUST.DATA.funcCode + "|" + CUST.DATA.BEGIN_CHQ_NUM + "|" + CUST.DATA.noOfLvs  + "|" +  BANCS.STDIN.userId + "|" +  BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		print(sv_x)
		sv_d = urhk_dbSQLWithBind(sv_x)
		IF (sv_d != 0) THEN
		#{
			sv_e = "DataBase Error. Contact your DBA"
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			print(sv_d)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_u = urhk_SetOrbOut("RESULT_MSG|Record Modified Verify through ICHBM menu.")
		#}
		ENDIF
	#}
	ENDIF
	ENDOFSCRIPT:
		
		TRACE OFF
		EXITSCRIPT
END-->
