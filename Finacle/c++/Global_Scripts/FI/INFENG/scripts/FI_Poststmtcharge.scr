<--START
TRACE ON
        #------------------------------------#
        #-- Repository And Class Creation  --#
        #------------------------------------#


	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST", "STMT") == 0) THEN
	#{
		CREATECLASS("CUST", "STMT", 5)
	#}
	ENDIF	

	sv_q = urhk_B2k_PrintRepos("BANCS")
	print(sv_q)	


	IF( (FIELDEXISTS(("BANCS").("INPUT").("NOPGS"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg="Please enter the Pagess "
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("FORACID"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg="please enter the Account number"
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

      IF( (FIELDEXISTS(("BANCS").("INPUT").("CERTIFYFLAG"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg=" Please indicate if Certify or not "
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	
	   IF( (FIELDEXISTS(("BANCS").("INPUT").("COMMFLAG"))== 0) ) THEN
	#{
   		CUST.STMT.errMsg=" Please indicate if Commission is charged  or not "
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
 
	#-----------------------------
	## Variable Intialization
	#-----------------------------
		CUST.STMT.errMsg   = ""

		CUST.STMT.drAcct =BANCS.INPUT.FORACID				
		print(CUST.STMT.drAcct)

    BANCS.INPARAM.BINDVARS = BANCS.INPUT.FORACID
   sv_k =" OfficeAcct| SELECT foracid from tbaadm.gam where bacid='PMFP_SH' "
   sv_k = sv_k + " AND sol_id  IN (select sol_id from tbaadm.gam where foracid=?SVAR) "
	PRINT(sv_k)
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_k)
    IF(sv_b==0)THEN
		#{
    CUST.STMT.crAcct  = BANCS.OUTPARAM.OfficeAcct 
	CUST.STMT.VATcrAcct = BANCS.OUTPARAM.OfficeAcct
      print(CUST.STMT.crAcct)
         #}
      ENDIF
	  
       CUST.STMT.CERTIFYFLAG = BANCS.INPUT.CERTIFYFLAG 
      print(CUST.STMT.CERTIFYFLAG)
	IF(CUST.STMT.CERTIFYFLAG == "Y") THEN
	#{
	CUST.STMT.CERTFEE=1000
	#}
	ELSE
	#{
	CUST.STMT.CERTFEE=0
	#}
	ENDIF
	  
	CUST.STMT.COMMFLAG = BANCS.INPUT.COMMFLAG 
     print(CUST.STMT.COMMFLAG)
	IF(CUST.STMT.COMMFLAG == "Y") THEN
	#{
	CUST.STMT.CertificationFee=1000
	CUST.STMT.COMMFEE= (CINT(BANCS.INPUT.NOPGS) * 180) + CINT(CUST.STMT.CERTFEE) *0.1
	#}
	ELSE
	#{
	CUST.STMT.COMMFEE=0
	#}
     ENDIF

		CUST.STMT.NOPGS = BANCS.INPUT.NOPGS
		print(CUST.STMT.NOPGS)
		
		#CUST.STMT.charge =(CINT(BANCS.INPUT.NOPGS) * 180) + CINT(CUST.STMT.CERTFEE)+ CINT(CUST.STMT.COMMFEE)
		CUST.STMT.charge =(CINT(BANCS.INPUT.NOPGS) * 180) 
		print(CUST.STMT.charge)
		CUST.STMT.tcharge= CINT(CUST.STMT.charge)
        	print(CUST.STMT.charge)
		CUST.STMT.exduty = CINT(CUST.STMT.charge) * 0.2
		print(CUST.STMT.exduty)
		CUST.STMT.exduty = CINT(CUST.STMT.exduty)
		PRINT(CUST.STMT.exduty)
	    	CUST.STMT.exduty1 = CINT(CUST.STMT.exduty)
		PRINT(CUST.STMT.exduty1)
		

    	#---------------------------------
        # Populate MTT details
        #---------------------------------

		sv_r = urhk_MTTS_PopulateInputDetails("")
		Print(sv_r)

		IF (sv_r != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.STMT.errMsg = MTT.Error.Description
			PRINT(CUST.STMT.errMsg)
			EXITSCRIPT      
		#}
		ENDIF

	#---------------------------------
        #  Closing of MTT if it is opened
        #-----------------------------------

		sv_g = urhk_MTTS_Close("")
		print(sv_g)
	
		IF (sv_g != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.STMT.errMsg = MTT.Error.Description
			PRINT(CUST.STMT.errMsg)
			EXITSCRIPT
		#}
		ENDIF

        #-----------------------------
        #--- Initialize MTT details
        #-----------------------------

		BANCS.INPARAM.PostTranFlg               = "Y"
		BANCS.INPARAM.CommitFlg                 = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
		BANCS.INPARAM.ValidationFlag            = "N"
		BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw          = "Y"
		BANCS.INPARAM.CheckExceptions           = "Y"

		sv_o = urhk_MTTS_Initialize("")
		PRINT(sv_o)
		
		IF(sv_o != 0)THEN
		#{
			sv_o = urhk_MTTS_ReportErrorCondition("")
			CUST.STMT.errMsg = MTT.Error.Description
			PRINT(CUST.STMT.errMsg)
			EXITSCRIPT
		#}
		ENDIF


        #-------------------------------
        # Define the transaction
        #-------------------------------

		MTT.TranDetails.TranDate        = "0"
		MTT.TranDetails.TranType        = "T"
		MTT.TranDetails.TranSubType     = "BI"
		MTT.TranDetails.ValidationFlag  = "N"
		MTT.TranDetails.IgnoreExcp      = "I"
		MTT.TranDetails.CommitFlg       = "Y"
		MTT.TranDetails.PostFlag        = "Y"

		sv_r = urhk_MTTS_DefineTransaction("STMT/CRG_TranDetails")
		print(sv_r)

		IF (sv_r != 0) THEN
		#{
			sv_r = urhk_MTTS_ReportErrorCondition("")
			CUST.STMT.errMsg = MTT.Error.Description
			PRINT(CUST.STMT.errMsg)
			EXITSCRIPT
		#}
		ENDIF



	#------------------------------------
	# DR/CR
	#--------------------------------------
		CUST.STMT.NOPGS1= CDOUBLE(CUST.STMT.charge) * 1
		PRINT(CUST.STMT.NOPGS1)
		print(CUST.STMT.drAcct)
		print(CUST.STMT.crAcct)

		CUST.STMT.exduty= CDOUBLE(CUST.STMT.exduty) * 1
		print(CUST.STMT.exduty)
	
	IF(CUST.STMT.CERTIFYFLAG == "N") THEN
	
	GOTO SKIPCERTIFICATIONCHARGING
	ENDIF


	#-----------------------------------------------------------------------
	#Debit customer customer the statment charges
	#-----------------------------------------------------------------------
        print("debit customer total charges")
		print(CUST.STMT.tcharge)
			MTT.PartTranDetails.Account = CUST.STMT.drAcct

			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.STMT.CertificationFee)*-1
			#MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.STMT.tcharge)*-1

			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "Statement Certification Charge ("+ CUST.STMT.drAcct + ")"
			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "STMT/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("DR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.STMT.errMsg = MTT.Error.Description
				PRINT(CUST.STMT.errMsg)
			#}
			ENDIF

	#----------------------------------------------------------------------				
	#Credit statment charges NOPGS to the respective GL
	#----------------------------------------------------------------------
	    print("credut GL   total charges")
		print(CUST.STMT.tcharge)
			MTT.PartTranDetails.Account        = CUST.STMT.crAcct
			#MTT.PartTranDetails.RefAmount      = CUST.STMT.tcharge
			MTT.PartTranDetails.RefAmount      = CUST.STMT.CertificationFee
			MTT.PartTranDetails.RefCurrency    = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "Statement Certification Charge ("+ CUST.STMT.crAcct + ")"

			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "STMT/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("CR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.STMT.errMsg = MTT.Error.Description
				PRINT(CUST.STMT.errMsg)
			#}
			ENDIF


	SKIPCERTIFICATIONCHARGING:

	#-----------------------------------------------------------------------
	#Debit customer account the excise duty fee
	#-----------------------------------------------------------------------
            print("Debiting the excise duty")
			print(CUST.STMT.exduty)
			MTT.PartTranDetails.Account = CUST.STMT.drAcct

			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.STMT.charge)*-1

			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "Statement Charge ("+ CUST.STMT.drAcct + ")"
			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "STMT/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("DR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.STMT.errMsg = MTT.Error.Description
				PRINT(CUST.STMT.errMsg)
			#}
			ENDIF


	#----------------------------------------------------------------------				
	#Credit excise duty to the respective GL
	#----------------------------------------------------------------------
	         print("Crediting the excise duty")
			print(CUST.STMT.exduty)
			MTT.PartTranDetails.Account        = CUST.STMT.VATcrAcct
			MTT.PartTranDetails.RefAmount      = CUST.STMT.charge

			MTT.PartTranDetails.RefCurrency    = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "Statement Charge ("+ CUST.STMT.VATcrAcct + ")"

			MTT.PartTranDetails.Remarks        = ""
			MTT.PartTranDetails.TranIdentifier = "STMT/CRG_TranDetails"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = ""
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			
			sv_i = urhk_MTTS_DefinePartTran("CR_TEMP")
			PRINT(sv_i)
			
			IF (sv_i != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				CUST.STMT.errMsg = MTT.Error.Description
				PRINT(CUST.STMT.errMsg)
			#}
			ENDIF


	#--------------------------------------------------------------
        # MTT ending definition to create transaction
        #--------------------------------------------------------------
	
		sv_r = urhk_MTTS_EndDefinition("")
		PRINT(sv_r)

		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			CUST.STMT.tranId = TRIM(BANCS.OUTPARAM.MTTTranId)
			PRINT(CUST.STMT.tranId)

			
		#}
		ENDIF

	#--------------------------------------------------------------
        # MTT Closing an initialized MTT
        #--------------------------------------------------------------
	
		sv_r = urhk_MTTS_Close("")
		print(sv_r)

	#--------------------------------------------------------------
        # SENDING RESPONSE
        #--------------------------------------------------------------

	IF(CUST.STMT.tranId != "")THEN
	#{

		sv_t = "TRAN_ID| " + CUST.STMT.tranId
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "TRAN_DATE| " + BANCS.STDIN.sysDate
		sv_u = urhk_SetOrbOut(sv_t)

	#}
	ELSE
	#{
   		CUST.STMT.errMsg="The transaction was not posted"
		sv_t = "ERROR| " +CUST.STMT.errMsg
		sv_u = urhk_SetOrbOut(sv_t)

	#}
	ENDIF

	ENDOFSCRIPT:
	EXITSCRIPT


TRACE OFF
END-->