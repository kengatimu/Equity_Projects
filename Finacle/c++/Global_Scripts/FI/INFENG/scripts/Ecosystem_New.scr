                EQSRV.GLBDATA.srvSucFail = "F"
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.srvErrMsg )
                goto EOS
        #}
        endif
EOS:
        exitscript
trace off
end-->
