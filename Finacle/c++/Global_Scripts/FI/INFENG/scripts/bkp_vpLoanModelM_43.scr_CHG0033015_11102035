        print(LAMOD.GLBDATA.srvSucFail)
        if(classexists("LAMOD","GLBDATA")==1)then
                deleteclass("LAMOD","GLBDATA")
        endif
        if(repexists("LAMOD")==1)then
                deleterep("LAMOD")
        endif
        exitscript
##trace off
