#------------------------------------------------------------------------------------------------
#  Name            : AcctActivationError.scr
#  Description     : This script will get data required by <AcctActivationError.com>
#  Date            : 13-10-2020
#  Author          : Edwin Zico
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : InactiveAcctActivationTB.scr
#  Menu Option     : TBJMS
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             13-10-2020      Edwin Zico           Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_r = urhk_MTTS_PopulateInputDetails("")
        print(sv_r)
        if(sv_r==0)then
                EBSRV.GLBDATA.foracid = MTT.InputDetails.Argument1
                EBSRV.GLBDATA.solid = MTT.InputDetails.Argument2
                EBSRV.GLBDATA.boddate = MTT.InputDetails.Argument3
                EBSRV.GLBDATA.errorsact = MTT.InputDetails.Argument4
        else
                EBSRV.GLBDATA.foracid= ""
                EBSRV.GLBDATA.PoAmount = ""
                EBSRV.GLBDATA.boddate = ""
                EBSRV.GLBDATA.errorsact = ""
        endif
        print(EBSRV.GLBDATA.foracid)
        print(EBSRV.GLBDATA.solid)
        print(EBSRV.GLBDATA.boddate)
        print(EBSRV.GLBDATA.errorsact)
        EBSRV.GLBDATA.isModuleType = "AAE"
       # EBSRV.GLBDATA.toAddr = "vino.palani@simbatech.biz,Edwin.Mureithi@equitybank.coke"

	sv_s = "empemail|select listagg(e.emp_email_id,',') within group(order by e.emp_email_id)"                  
	sv_s = sv_s + "  from tbaadm.upr g,tbaadm.get e"
        sv_s = sv_s + "  where e.emp_id = g.user_emp_id and g.user_work_class  in ('200','150')"
	sv_s = sv_s + " and home_bank_id =?SVAR and g.del_flg ='N' and g.sol_id =?SVAR"
	sv_s = sv_s + " and e.emp_email_id is not null and rownum <=5 order by g.user_work_class desc"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.solid
	print(sv_s)
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	if(sv_d == 0)then
	#{
		EBSRV.GLBDATA.toAddr = BANCS.OUTPARAM.empemail 
		print(EBSRV.GLBDATA.toAddr)
	#}
	else
	#{
		EBSRV.GLBDATA.toAddr = "NA"
	#}
	endif
#	EBSRV.GLBDATA.toAddr = "vino.palani@simbatech.biz,edwin.mureithi@equitybank.co.ke"
        sv_u = urhk_getFileLocation("COM|AcctActivationError.com")
        if(sv_u ==0)then
                print(BANCS.OUTPARAM.fileLocation)
                EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "AcctActivationError.com"
                print(EBSRV.GLBDATA.comfil)
                print(EBSRV.GLBDATA.toAddr)
                if(EBSRV.GLBDATA.isModuleType=="AAE")then
                EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " +'"'+ EBSRV.GLBDATA.toAddr + '"'+" " +'"'+ EBSRV.GLBDATA.foracid +'"'+ " " +'"'+ EBSRV.GLBDATA.solid +'"'+ " " +'"'+ EBSRV.GLBDATA.boddate +'"'+ " " +'"'+ EBSRV.GLBDATA.errorsact +'"'+ " " +'"'+EBSRV.GLBDATA.isModuleType +'"'+ " "
                endif
        else
                EBSRV.GLBDATA.comfil   = ""
        endif
        if(EBSRV.GLBDATA.comfil != "")then
                print(EBSRV.GLBDATA.comfil)
                sv_u = system(EBSRV.GLBDATA.comfil)
                if(sv_u ==0)then
                        print("smtp success")
                else
                        print("failed smtp")
                endif
        endif
trace off
end-->
