#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------
	CUST.EZB.null = " "
	CUST.EZB.iciCount = ""
	CUST.EZB.dtFlg = "N" 
	CUST.EZB.chqNoFlg = "N"


	IF( (FIELDEXISTS(("BANCS").("INPUT").("AccountNumber"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Account Number" 
        lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
   	ELSE
   		CUST.EZB.accountNum = trim(BANCS.INPUT.AccountNumber)
   		print(CUST.EZB.accountNum)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("FromDate"))== 0) AND (FIELDEXISTS(("BANCS").("INPUT").("BeginChequeNumber"))== 0)  ) THEN
	#{
   		CUST.EZB.errMsg="Please Provide either FromDate or BeginChequeNumber or Both "
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
   	#}
   	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("FromDate"))== 1) ) THEN
	#{
		CUST.EZB.fromDate = BANCS.INPUT.FromDate
   		print(CUST.EZB.fromDate)

   		IF( (FIELDEXISTS(("BANCS").("INPUT").("EndDate"))== 0) ) THEN
		#{
			CUST.EZB.errMsg="Please Enter End Date. Format DD-MON-YYYY"
			lv_a = "E9999"
	        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
	        sv_u = urhk_SetOrbErr(sv_c)
	        exitscript
	    ELSE
	    	CUST.EZB.endDate = BANCS.INPUT.EndDate
   			print(CUST.EZB.endDate)
   			CUST.EZB.dtFlg = "Y"
		#}
		ENDIF 
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("BeginChequeNumber"))== 1) ) THEN
	#{
		CUST.EZB.beginChequeNumber = BANCS.INPUT.BeginChequeNumber
   		print(CUST.EZB.beginChequeNumber)

   		IF( (FIELDEXISTS(("BANCS").("INPUT").("EndChequeNumber"))== 0) ) THEN
		#{
	   		CUST.EZB.errMsg="Please Enter EndChequeNumber."
			lv_a = "E9999"
	        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
	        sv_u = urhk_SetOrbErr(sv_c)
	        exitscript
	   	ELSE 
	   		CUST.EZB.endChequeNumber = BANCS.INPUT.EndChequeNumber
	   		print(CUST.EZB.endChequeNumber)
	   		CUST.EZB.chqNoFlg = "Y"
		#}
		ENDIF
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("EndDate"))== 1) AND (FIELDEXISTS(("BANCS").("INPUT").("FromDate"))== 0) ) THEN
	#{
		CUST.EZB.errMsg="Please Enter FromDate. Format DD-MON-YYYY"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
   	#}
   	ENDIF

   	IF( (FIELDEXISTS(("BANCS").("INPUT").("EndChequeNumber"))== 1) AND (FIELDEXISTS(("BANCS").("INPUT").("BeginChequeNumber"))== 0)) THEN
   	#{
   		CUST.EZB.errMsg="Please Enter BeginChequeNumber. Format DD-MON-YYYY"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("InOutFlg"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter the flg. (I or O)"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
   	ELSE 
   		CUST.EZB.inOutFlg = TOUPPER(TRIM(BANCS.INPUT.InOutFlg))
   		print(CUST.EZB.inOutFlg)

   		IF( (CUST.EZB.inOutFlg != "I") AND (CUST.EZB.inOutFlg != "O") )THEN 
   		#{
   			CUST.EZB.errMsg="The InOutFlg tag should be either [I or O]"
			lv_a = "E9999"
	        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
	        sv_u = urhk_SetOrbErr(sv_c)
	        exitscript
   		#}
   		#ENDIF
	#}
	ENDIF

	sv_a = urhk_getAcctDetailsInRepository(CUST.EZB.accountNum)
	print(sv_a)

	IF(sv_a == 0)THEN
	#{
		#CUST.EZB.acctOwnerShip = trim(BANCS.OUTPARAM.acctOwnerShip)
		#print(CUST.EZB.acctOwnerShip)

		#IF(CUST.EZB.acctOwnerShip =="O")THEN
		##{
		#	CUST.EZB.errMsg="Office Accounts not allowed ^"+CUST.EZB.accountNum +"^"
		#	lv_a = "E9999"
	    #    sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
	    #    sv_u = urhk_SetOrbErr(sv_c)
	    #    exitscript
		##}
		#ENDIF 

		CUST.EZB.acctName = trim(BANCS.OUTPARAM.acctName)
		print(CUST.EZB.acctName)

		sv_u = urhk_B2k_ForacidToAcid(CUST.EZB.accountNum)
	    print(sv_u)
	    if (sv_u ==0) then
	    #{
	        CUST.EZB.acid=BANCS.OUTPARAM.Acid
	        print(CUST.EZB.acid)
	    else
	        CUST.EZB.errMsg="Invalid Account Number ^"+CUST.EZB.accountNum +"^"
			lv_a = "E9999"
	        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
	        sv_u = urhk_SetOrbErr(sv_c)
	        exitscript
	    #}
	    endif
	ELSE
		CUST.EZB.errMsg="Invalid Account Number ^"+CUST.EZB.accountNum +"^"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
        exitscript
	#}
	ENDIF

	#----------------------------------------------------------------------------------------------
	# GET INWARD RECORDS
	#----------------------------------------------------------------------------------------------

	IF(CUST.EZB.inOutFlg =="I")THEN
	#{
		CUST.EZB.chqType = "INWARD"

		##CASE ONE - QUERY WITH BOTH DATE CHEQUE NUMBER

		IF( (CUST.EZB.dtFlg == "Y") AND (CUST.EZB.chqNoFlg == "Y") )THEN
		#{
			sv_q = "crncy_code,inst_num,inst_amt,entry_date,value_date,status,payee |"
			sv_q = sv_q + " select i.crncy_code, i.inst_num, i.inst_amt,to_char(i.entry_date,'DD-MM-YYYY'), to_char( i.value_date,'DD-MM-YYYY'), i.status_ind,i.tran_particulars from tbaadm.ici i, tbaadm.icp p where "
			sv_q = sv_q + " i.bank_id=?SVAR and p.bank_id=i.bank_id and i.acid=?SVAR and p.acid=i.acid and  "
			sv_q = sv_q + " i.inst_num >= "+CUST.EZB.beginChequeNumber+" and i.inst_num <= "+CUST.EZB.endChequeNumber+" and "
			sv_q = sv_q + " i.zone_date >=to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and i.zone_date <= to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and "
			sv_q = sv_q + " i.sol_id=p.sol_id and i.zone_code=p.zone_code and i.zone_date=p.zone_date and i.zone_srl_num=p.zone_srl_num and i.inst_amt =p.tran_amt "
			print(sv_q)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+CUST.EZB.acid+"|"+CUST.EZB.fromDate+"|"+CUST.EZB.endDate
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF 

		##CASE TWO - QUERY WITH DATE ONLY
		
		IF( (CUST.EZB.dtFlg == "Y") AND (CUST.EZB.chqNoFlg == "N") )THEN
		#{
			sv_q = "crncy_code,inst_num,inst_amt,entry_date,value_date,status,payee |"
			sv_q = sv_q + " select i.crncy_code, i.inst_num, i.inst_amt,to_char(i.entry_date,'DD-MM-YYYY'), to_char( i.value_date,'DD-MM-YYYY'), i.status_ind,i.tran_particulars from tbaadm.ici i, tbaadm.icp p where "
			sv_q = sv_q + " i.bank_id=?SVAR and p.bank_id=i.bank_id and i.acid=?SVAR and p.acid=i.acid and  "
			sv_q = sv_q + " i.zone_date >=to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and i.zone_date <= to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and "
			sv_q = sv_q + " i.sol_id=p.sol_id and i.zone_code=p.zone_code and i.zone_date=p.zone_date and i.zone_srl_num=p.zone_srl_num and i.inst_amt =p.tran_amt "
			print(sv_q)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+CUST.EZB.acid+"|"+CUST.EZB.fromDate+"|"+CUST.EZB.endDate
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF 


		##CASE THREE - QUERY WITH CHEQUE NUMBER ONLY

		IF( (CUST.EZB.dtFlg == "N") AND (CUST.EZB.chqNoFlg == "Y") )THEN
		#{
			sv_q = "crncy_code,inst_num,inst_amt,entry_date,value_date,status,payee |"
			sv_q = sv_q + " select i.crncy_code, i.inst_num, i.inst_amt,to_char(i.entry_date,'DD-MM-YYYY'), to_char( i.value_date,'DD-MM-YYYY'), i.status_ind,i.tran_particulars from tbaadm.ici i, tbaadm.icp p where "
			sv_q = sv_q + " i.bank_id=?SVAR and p.bank_id=i.bank_id and i.acid=?SVAR and p.acid=i.acid and  "
			sv_q = sv_q + " i.inst_num >= "+CUST.EZB.beginChequeNumber+" and i.inst_num <= "+CUST.EZB.endChequeNumber+" and "
			sv_q = sv_q + " i.sol_id=p.sol_id and i.zone_code=p.zone_code and i.zone_date=p.zone_date and i.zone_srl_num=p.zone_srl_num and i.inst_amt =p.tran_amt "
			print(sv_q)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+CUST.EZB.acid
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
	#}
	ENDIF

	IF(CUST.EZB.inOutFlg =="O")THEN
	#{
		CUST.EZB.chqType = "OUTWARD"

		##CASE ONE - QUERY WITH BOTH DATE & CHEQUE NUMBER

		IF( (CUST.EZB.dtFlg == "Y") AND (CUST.EZB.chqNoFlg == "Y") )THEN
		#{
			sv_q = "crncy_code,inst_num,inst_amt,entry_date,value_date,status, payee |"
			sv_q = sv_q + " select o.crncy_code, o.instrmnt_id,o.instrmnt_amt,to_char(o.entry_date,'DD-MM-YYYY'),to_char(o.tran_value_date,'DD-MM-YYYY'),o.status_flg,o.payee_name from tbaadm.oci o,tbaadm.ocp p where "
			sv_q = sv_q + " o.bank_id=?SVAR and p.bank_id=o.bank_id and p.acid=?SVAR and  "
			sv_q = sv_q + " o.instrmnt_id >= "+CUST.EZB.beginChequeNumber+" and  o.instrmnt_id <= "+CUST.EZB.endChequeNumber+" and"
			sv_q = sv_q + " o.clg_zone_date >=to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and o.clg_zone_date <= to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and"
			sv_q = sv_q + " o.sol_id=p.sol_id and o.clg_zone_code=p.clg_zone_code and o.clg_zone_date=p.clg_zone_date and o.set_num=p.set_num "
			print(sv_q)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+CUST.EZB.acid+"|"+CUST.EZB.fromDate+"|"+CUST.EZB.endDate
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF 

		##CASE TWO - QUERY WITH DATE ONLY

		IF( (CUST.EZB.dtFlg == "Y") AND (CUST.EZB.chqNoFlg == "N") )THEN
		#{
			sv_q = "crncy_code,inst_num,inst_amt,entry_date,value_date,status, payee |"
			sv_q = sv_q + " select o.crncy_code, o.instrmnt_id,o.instrmnt_amt,to_char(o.entry_date,'DD-MM-YYYY'),to_char(o.tran_value_date,'DD-MM-YYYY'),o.status_flg,o.payee_name from tbaadm.oci o,tbaadm.ocp p where "
			sv_q = sv_q + " o.bank_id=?SVAR and p.bank_id=o.bank_id and p.acid=?SVAR and "
			sv_q = sv_q + " o.clg_zone_date >=to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and o.clg_zone_date <= to_date(?SVAR, 'DD-MM-YYYY HH24:MI:SS') and"
			sv_q = sv_q + " o.sol_id=p.sol_id and o.clg_zone_code=p.clg_zone_code and o.clg_zone_date=p.clg_zone_date and o.set_num=p.set_num "
			print(sv_q)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+CUST.EZB.acid+"|"+CUST.EZB.fromDate+"|"+CUST.EZB.endDate
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF

		##CASE THREE - QUERY WITH CHEQUE NUMBER ONLY

		IF( (CUST.EZB.dtFlg == "N") AND (CUST.EZB.chqNoFlg == "Y") )THEN
		#{
			sv_q = "crncy_code,inst_num,inst_amt,entry_date,value_date,status, payee |"
			sv_q = sv_q + " select o.crncy_code, o.instrmnt_id,o.instrmnt_amt,to_char(o.entry_date,'DD-MM-YYYY'),to_char(o.tran_value_date,'DD-MM-YYYY'),o.status_flg,o.payee_name from tbaadm.oci o,tbaadm.ocp p where "
			sv_q = sv_q + " o.bank_id=?SVAR and p.bank_id=o.bank_id and p.acid=?SVAR and  "
			sv_q = sv_q + " o.instrmnt_id >= "+CUST.EZB.beginChequeNumber+" and  o.instrmnt_id <= "+CUST.EZB.endChequeNumber+" and "
			sv_q = sv_q + " o.sol_id=p.sol_id and o.clg_zone_code=p.clg_zone_code and o.clg_zone_date=p.clg_zone_date and o.set_num=p.set_num "
			print(sv_q)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+CUST.EZB.acid
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
	#}
	ENDIF

	sv_c = urhk_dbcursorOpenWithBind(sv_q)
	PRINT(sv_c)

	IF (sv_c == 0)THEN
	#{
		CUST.EZB.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.EZB.cursor_number)

		sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
		print(sv_d)

		IF(sv_d == 0)THEN
		#{
 			sv_q = 0
			print(sv_q)

			WHILE (sv_d == 0)
			#{
				sv_q = sv_q + 1
				print(sv_q)

				sv_v = "AcctNum_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = CUST.EZB.accountNum

				sv_v = "AcctName_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = CUST.EZB.acctName

				sv_v = "CrncyCode_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.crncy_code

				sv_v = "InstNum_" + FORMAT$(sv_q, "%d") 
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.inst_num

				sv_v = "InstAmt_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.inst_amt

				sv_v = "EntryDate_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.entry_date

				sv_v = "ValueDate_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.value_date

				sv_v = "Status_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.status

				IF(("CUST").("EZB").(sv_v) == "R")THEN
					("CUST").("EZB").(sv_v) = "Released to Shadow balance"
				ENDIF
				IF(("CUST").("EZB").(sv_v) == "G")THEN
					("CUST").("EZB").(sv_v) = "Regularised"
				ENDIF
				IF(("CUST").("EZB").(sv_v) == "P")THEN
					("CUST").("EZB").(sv_v) = "Pending"
				ENDIF
				IF(("CUST").("EZB").(sv_v) == "W")THEN
					("CUST").("EZB").(sv_v) = "Pending and Rejected"
				ENDIF
				IF(("CUST").("EZB").(sv_v) == "O")THEN
					("CUST").("EZB").(sv_v) = "Released and rejected"
				ENDIF
				IF(("CUST").("EZB").(sv_v) == "J")THEN
					("CUST").("EZB").(sv_v) = "Regularised and rejected"
				ENDIF

				sv_v = "PayeeName_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.payee

				sv_v = "ChqType_" + FORMAT$(sv_q, "%d")
				("CUST").("EZB").(sv_v) = CUST.EZB.chqType

				sv_v = "AcctNum_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountNumber| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "AcctName_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.AccountName| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "CrncyCode_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequeCurrency| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "InstNum_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequeNumber| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "InstAmt_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequeAmount| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "EntryDate_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequeReceivedDate| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "ValueDate_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequePaidDate| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "Status_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequeStatus| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "PayeeName_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequePayeeName| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "ChqType_" + FORMAT$(sv_q, "%d")
				sv_t = "ChequeStatus_RES.<rec_" + FORMAT$(sv_q,"%d") + ">.ChequeType| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
				print(sv_d)
			#} 
			DO 

			sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
			print(sv_x)
			print(CUST.EZB.cursor_number)
		ELSE 
			sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
			print(sv_x)
			print(CUST.EZB.cursor_number)

			CUST.EZB.errMsg = "No records fetched for cheques."
			lv_a = "E9999"
            sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
            sv_u = urhk_SetOrbErr(sv_c)
		#}
		ENDIF
	ELSE
		CUST.EZB.errMsg = "Unable to fetch the records"
		lv_a = "E9999"
        sv_c = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(sv_c)
	#}
	ENDIF

ENDSCRIPT:
trace off
