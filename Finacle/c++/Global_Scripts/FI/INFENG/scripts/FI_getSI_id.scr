<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "CSEG")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "CSEG", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CIFID"))== 0) ) THEN
	#{
   		CUST.CSEG.errMsg="please enter CIFID"
		sv_t = "ERROR | " +CUST.CSEG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.CSEG.CIFID= BANCS.INPUT.CIFID
	print(CUST.CSEG.CIFID)		


	sv_s="SOID, SIPRIORITY, CUSTID |"
	sv_s=sv_s + "SELECT DISTINCT S.si_srl_num,S.si_priority,S.cust_id FROM TBAADM.SIH S, TBAADM.PYRD P, TBAADM.PYRH H WHERE  "
	sv_s=sv_s + "S.CUST_ID =  (SELECT CUST_ID FROM TBAADM.CMG WHERE CIF_ID =?SVAR  AND CMG.bank_id =?SVAR) "
	sv_s=sv_s + "AND (P.PR_SRL_NUM = H.PR_SRL_NUM) AND P.ENTITY_CRE_FLG = 'Y' AND P.DEL_FLG = 'N' AND H.ENTITY_CRE_FLG = 'Y' " 
	sv_s=sv_s + "AND H.DEL_FLG = 'N' AND H.PR_B2K_TYPE = 'SI' AND (H.pr_b2k_id = S.SI_SRL_NUM) AND S.ENTITY_CRE_FLG = 'Y' " 
	sv_s=sv_s + "AND S.bank_id = ?SVAR   AND P.bank_id = ?SVAR   AND H.bank_id = ?SVAR    AND S.DEL_FLG = 'N' " 
	sv_s=sv_s + "ORDER BY  to_number (S.si_priority),S.SI_SRL_NUM " 
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.CSEG.CIFID + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_v = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_v)	

	IF(sv_v == 0) THEN
       	 #{
        	CUST.CSEG.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       		print(CUST.CSEG.CURSOR_NUMBER)
       		sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
        	print(sv_b)
		BANCS.INPUT.RECCOUNT = CINT("1")
        	print(BANCS.INPUT.RECCOUNT)

		sv_i=1
		print(sv_i)

		WHILE(sv_b == "0")
        	#{
			CUST.CSEG.SOID= BANCS.OUTPARAM.SOID
			print(CUST.CSEG.SOID)

			#---------------------------------------------------------------------------------------------------------------
			#inquiry starts
			#---------------------------------------------------------------------------------------------------------------
			sv_s="enddate|"
			sv_s=sv_s + "SELECT TO_CHAR(SI_END_DATE,'DD-MM-YYYY HH24:MI:SS') FROM  TBAADM.SIH WHERE "
			sv_s=sv_s + "SI_SRL_NUM=?SVAR AND BANK_ID='54'"
			print(sv_s)

			BANCS.INPARAM.BINDVARS = CUST.CSEG.SOID
			print(BANCS.INPARAM.BINDVARS)

			sv_v = urhk_dbSelectWithBind(sv_s)
       			PRINT(sv_v)
			IF(sv_v==0)THEN
			#{
				CUST.CSEG.enddate = BANCS.OUTPARAM.enddate 
				print(CUST.CSEG.enddate)


			#}
			ELSE
			#{
				PRINT("DB ERROR")	
			#}
			ENDIF



			CUST.CSEG.SOIDStarts=" "

			sv_s="SOIDStarts_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.SOIDStarts
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="SOID_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.SOID
			sv_u = urhk_SetOrbOut(sv_s)


			sv_s="prb2kid, prsrlnum |"
			sv_s=sv_s + "SELECT  pr_b2k_id  ,pr_srl_num  FROM  TBAADM.PYRH  WHERE  "
			sv_s=sv_s + "PYRH.bank_id = ?SVAR AND PR_B2K_TYPE = 'SI' AND PR_B2K_ID =?SVAR"
			sv_s=sv_s + " ORDER BY  PR_SRL_NUM desc OFFSET 0 ROWS FETCH NEXT 1 ROWS ONLY " 
			print(sv_s)

			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CSEG.SOID
			print(BANCS.INPARAM.BINDVARS)

			sv_v = urhk_dbSelectWithBind(sv_s)
       			PRINT(sv_v)
			IF(sv_v==0)THEN
			#{


				CUST.CSEG.prb2kid= TRIM(BANCS.OUTPARAM.prb2kid)
				print(CUST.CSEG.prb2kid)
				CUST.CSEG.prsrlnum = TRIM(BANCS.OUTPARAM.prsrlnum) 
				print(CUST.CSEG.prsrlnum)

				sv_s="mandate|"
				sv_s=sv_s + "SELECT MANDATE_SRL_NUM  FROM TBAADM.EMD  WHERE  "
				sv_s=sv_s + "EMD.BANK_ID=?SVAR  AND  B2K_TYPE ='SI'"
				sv_s=sv_s + " AND TRIM(B2K_ID) =?SVAR AND TRIM(PR_SRL_NUM) =?SVAR ORDER BY  RCRE_TIME desc OFFSET 0 ROWS FETCH NEXT 1 ROWS ONLY" 
				print(sv_s)

				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CSEG.prb2kid + "|" + CUST.CSEG.prsrlnum
				print(BANCS.INPARAM.BINDVARS)

				sv_v = urhk_dbSelectWithBind(sv_s)
       				PRINT(sv_v)
				IF(sv_v==0)THEN
				#{
					CUST.CSEG.mandate= BANCS.OUTPARAM.mandate
					print(CUST.CSEG.mandate)
					
					sv_s="otheraccount, othername, othercity, otherbank,otherbranch, ref1, ref2|"
					sv_s=sv_s + "select  other_party_acct, other_party_name, other_bank_city_code, other_bank_code, other_branch_code,  "
					sv_s=sv_s + " reference_id_1, reference_id_2  FROM TBAADM.TBA_ECS_MANDATE_TABLE  WHERE "
					sv_s=sv_s + " mandate_srl_num = ?SVAR   AND bank_id = ?SVAR" 
					print(sv_s)

					BANCS.INPARAM.BINDVARS =CUST.CSEG.mandate + "|" +  BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
	
					sv_v = urhk_dbSelectWithBind(sv_s)
       					PRINT(sv_v)
					IF(sv_v==0)THEN
					#{

						CUST.CSEG.otheraccount= BANCS.OUTPARAM.otheraccount
						print(CUST.CSEG.otheraccount)

						CUST.CSEG.othername= BANCS.OUTPARAM.othername
						print(CUST.CSEG.othername)

						CUST.CSEG.othercity= BANCS.OUTPARAM.othercity
						print(CUST.CSEG.othercity)

						CUST.CSEG.otherbank= BANCS.OUTPARAM.otherbank
						print(CUST.CSEG.otherbank)

						CUST.CSEG.otherbranch= BANCS.OUTPARAM.otherbranch
						print(CUST.CSEG.otherbranch)

						CUST.CSEG.ref1= BANCS.OUTPARAM.ref1
						print(CUST.CSEG.ref1)

						CUST.CSEG.ref2= BANCS.OUTPARAM.ref2
						print(CUST.CSEG.ref2)



					#}
					ENDIF


				#}
				ELSE
				#{
   					CUST.CSEG.errMsg="SO to local bank details not maintained"
					sv_t = "ERROR_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.errMsg
					sv_u = urhk_SetOrbOut(sv_t)
   					GOTO END
				#}
				ENDIF
				

			#}
			ENDIF





	#---------------------------------------------------------------------------------------------------------------
	#inquiry starts
	#---------------------------------------------------------------------------------------------------------------

	sv_u = urhk_SetUrhkInp("siHdr.siSrlNum|"+CUST.CSEG.SOID)
	print(sv_u)

	sv_a = urhk_SetUrhkOut("siHdr.cust.cifId|cifId")
	sv_a = urhk_SetUrhkOut("siHdr.frequency.type|freqtype")
	sv_a = urhk_SetUrhkOut("siHdr.execCode.code|EXECUTIONTIME")
	sv_a = urhk_SetUrhkOut("siHdr.nextExecDate|NEXTEXECDATE")
	#sv_a = urhk_SetUrhkOut("siHdr.endDate|endDate")
	sv_a = urhk_SetUrhkOut("siHdr.chrgDrAcct.foracid|foracid")
	sv_a = urhk_SetUrhkOut("siHdr.rmksFreeText|notes")
	sv_a = urhk_SetUrhkOut("subInstrLL.<rec_0>.subInstr.refCrncy.crncyCode|AMTCRNCY")
	sv_a = urhk_SetUrhkOut("subInstrLL.<rec_0>.subInstr.fixedAmt|FIXEDAMT")
	sv_a = urhk_SetUrhkOut("subInstrLL.<rec_0>.prDtlLL.<rec_0>.particulars|particulars")
	#sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.addnlDtl.mandateDtl.otherPartyAcctId|otherPartyAcctId")
	#sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.addnlDtl.mandateDtl.otherPartyName|otherPartyName")
	#sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.addnlDtl.mandateDtl.otherPartyCity.refCode|CITY")
	#sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.addnlDtl.mandateDtl.bank.bankCode|bankCode")
	#sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.addnlDtl.mandateDtl.branch.brCode|brCode")
	#sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.addnlDtl.mandateDtl.refId1|refId1")
	#sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.addnlDtl.mandateDtl.refId2|refId2")
        sv_a = urhk_SetUrhkOut("subInstrLL.<rec_0>.prDtlLL.<rec_0>.acctCrncyCode.crncyCode|CrncyCode")




	sv_u = urhk_ExecSrv("SRV_InquireSI|retain_all_output = Y|same_user_verify = Y")
	print(sv_u)
	IF(sv_u==0)THEN
	#{
		CUST.CSEG.particulars= BANCS.OUTPARAM.particulars
		print(CUST.CSEG.particulars)

		CUST.CSEG.CrncyCode= BANCS.OUTPARAM.CrncyCode
		print(CUST.CSEG.CrncyCode)


		CUST.CSEG.cifId= BANCS.OUTPARAM.cifId
		print(CUST.CSEG.cifId)
		CUST.CSEG.freqtype= BANCS.OUTPARAM.freqtype
		print(CUST.CSEG.freqtype)

		CUST.CSEG.EXECUTIONTIME= BANCS.OUTPARAM.EXECUTIONTIME
		print(CUST.CSEG.EXECUTIONTIME)

		CUST.CSEG.NEXTEXECDATE= BANCS.OUTPARAM.NEXTEXECDATE
		print(CUST.CSEG.NEXTEXECDATE)

		#CUST.CSEG.endDate= BANCS.OUTPARAM.endDate
		#print(CUST.CSEG.endDate)

		CUST.CSEG.foracid= BANCS.OUTPARAM.foracid
		print(CUST.CSEG.foracid)

		CUST.CSEG.notes= BANCS.OUTPARAM.notes
		print(CUST.CSEG.notes)

		CUST.CSEG.AMTCRNCY= BANCS.OUTPARAM.AMTCRNCY
		print(CUST.CSEG.AMTCRNCY)

		CUST.CSEG.FIXEDAMT= BANCS.OUTPARAM.FIXEDAMT
		print(CUST.CSEG.FIXEDAMT)





	#}
	ELSE
	#{
		sv_u = urhk_dbCursorClose(CUST.CSEG.CURSOR_NUMBER)
		GOTO CHECKERROR
	#}
	ENDIF




			#call("FI_SOinquire.scr")


		#---------------------------------------------------------------------------------------------------------------
		#Sending responses
		#---------------------------------------------------------------------------------------------------------------
     
	
		sv_t = "CIFID_" +Format$(sv_i, "%d")+ "|" +CUST.CSEG.cifId
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "FORACID_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.foracid
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "FIXEDAMT_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.FIXEDAMT
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "AMTCRNCY_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.AMTCRNCY
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "NEXTEXECDATE_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.NEXTEXECDATE
		sv_u = urhk_SetOrbOut(sv_t)
		
		IF(CUST.CSEG.enddate !="")THEN
		#{
			sv_t = "ENDDATE_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.enddate
			sv_u = urhk_SetOrbOut(sv_t)

		#}
		ENDIF


		sv_t = "FREQTYPE_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.freqtype
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "EXECUTIONTIME_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.EXECUTIONTIME
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "PARTICULARS_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.particulars
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "NOTES_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.notes
		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "OTHERPARTYACCT_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.otheraccount
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "OTHERPARTYNAME_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.othername
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "CITYCODE_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.othercity
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "BRCODE_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.otherbranch
		sv_u = urhk_SetOrbOut(sv_t)

		sv_t = "OTHERBANKCODE_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.otherbank
		sv_u = urhk_SetOrbOut(sv_t)

		############james - 21/10/2022 CHG0031358#########################
		IF(CUST.CSEG.ref1 !="")THEN
		#{
			sv_t = "REFID1_" +Format$(sv_i, "%d")+ "|"+CUST.CSEG.ref1
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF

		IF(CUST.CSEG.ref2 !="")THEN
		#{
			sv_t = "REFID2_"+Format$(sv_i, "%d")+ "|" +CUST.CSEG.ref2
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF
		############james - 21/10/2022 CHG0031358#########################


		IF((CUST.CSEG.freqtype=="M") OR (CUST.CSEG.freqtype=="H") OR (CUST.CSEG.freqtype=="Q") OR (CUST.CSEG.freqtype=="Y"))THEN
		#{
			sv_u = urhk_SetUrhkInp("siHdr.siSrlNum|"+CUST.CSEG.SOID)

			sv_u = urhk_SetUrhkOut("siHdr.frequency.startDd|STARTDd")
			sv_u = urhk_ExecSrv("SRV_InquireSI|retain_all_output = Y|same_user_verify = Y")
			IF(sv_u==0)THEN
			#{
				CUST.CSEG.STARTDd= BANCS.OUTPARAM.STARTDd
				print(CUST.CSEG.STARTDd)
				sv_t = "STARTDd_" +Format$(sv_i, "%d")+ "|" +CUST.CSEG.STARTDd
				sv_u = urhk_SetOrbOut(sv_t)

			#}
			ELSE
			#{
				sv_u = urhk_dbCursorClose(CUST.CSEG.CURSOR_NUMBER)	
				GOTO CHECKERROR

			#}
			ENDIF

		#}
		ENDIF

		IF(CUST.CSEG.AMTCRNCY !=CUST.CSEG.CrncyCode)THEN
		#{
			sv_u = urhk_SetUrhkInp("siHdr.siSrlNum|"+CUST.CSEG.SOID)

        		sv_a = urhk_SetUrhkOut("subInstrLL.<rec_1>.prDtlLL.<rec_1>.rateCode.refCode|RATECODE")
			sv_u = urhk_ExecSrv("SRV_InquireSI|retain_all_output = Y|same_user_verify = Y")
			IF(sv_u==0)THEN
			#{
				CUST.SIMOD.RATECODE= BANCS.OUTPARAM.RATECODE
				print(CUST.SIMOD.RATECODE)
				sv_t = "RATECODE_" +Format$(sv_i, "%d")+ "|"  +CUST.SIMOD.SIFREQNDAYS
				sv_u = urhk_SetOrbOut(sv_t)

			#}
			ELSE
			#{
				sv_u = urhk_dbCursorClose(CUST.CSEG.CURSOR_NUMBER)	
				GOTO CHECKERROR

			#}
			ENDIF




		#}
		ENDIF



			END:


			CUST.CSEG.SOIDEnds=" "
			sv_s="SOIDEnd_"+Format$(sv_i, "%d")+ "|" + CUST.CSEG.SOIDEnds
			sv_u = urhk_SetOrbOut(sv_s)







       			GOTO NEXTREC

      			BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
        		PRINT(BANCS.INPUT.RECCOUNT)

        		NEXTREC:
			sv_i = sv_i + 1 
       			sv_b = urhk_dbCursorFetch(CUST.CSEG.CURSOR_NUMBER)
       			print(sv_b)
		#}
		DO
	sv_u = urhk_dbCursorClose(CUST.CSEG.CURSOR_NUMBER)
	#}
	ENDIF

	CHECKERROR:

	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>siInquiryMgr.log")
				print(sv_u)
				
				#Error response
				sv_t = "ERROR|"+Format$(sv_i, "%d")+ "|"  +sv_e
				sv_u = urhk_SetOrbOut(sv_t)

			#}
			DO
			#}
		ENDIF
	#}
	ENDIF



