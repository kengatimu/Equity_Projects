set head off
set verify off
set feed off
set term off
set pages 0
set linesize 250
set trims on
set maxdata 60000
set serveroutput on size 1000000
spool image.lst

select SOL_ID||'|'||ACTIVITY||'|'||ACCTID||'|'||OCCUREDAT||'|'||USER_ID from 
(select b.sol_id, activity , acctid, OCCUREDAT, b.user_id from 
(select    a.acctid, B.LASTACTIVITY activity ,    case when LASTACTIVITY ='ADD'  then to_date (cast (b.CREATEDDATE as date),'DD-MM-YY')  
else to_date (cast (b.MODIFIEDDATE as date),'DD-MM-YY')  end OCCUREDAT , case when LASTACTIVITY ='ADD'  then b.CREATEDBY  else  b.MODIFIEDBY  end user_id from SVSUSER.NSIGNOTHERINFO a, 
SVSUSER.NSIGNMAINTENANCE  b  where a.signid = b.signid  and  a.acctid is not null and a.acctid !=' '   and a.entityid ='&2' )a,
(select user_id , sol_id,home_bank_id  from tbaadm.upr where del_flg ='N')b where b.user_id =a.user_id and b.home_bank_id ='&2' and b.sol_id ='&1' and OCCUREDAT >'20-OCT-2019'
union
select  b.sol_id,a.activity ,a.acctid ,a.OCCUREDAT, b.user_id from 
(select CUSTID||'-CIF'  acctid , a.LASTACTIVITY activity,   case when a.LASTACTIVITY ='ADD'  then to_date (cast (a.CREATEDDATE as date),'DD-MM-YY')  
else to_date (cast (a.MODIFIEDDATE as date),'DD-MM-YY')  end OCCUREDAT , case when b.LASTACTIVITY ='ADD'  then b.CREATEDBY  else  b.MODIFIEDBY  end user_id from SVSUSER.NSIGNCUSTINFO a, 
SVSUSER.NSIGNMAINTENANCE  b    where a.signid = b.signid and CUSTID is not null and CUSTID !=' ' )a,
(select user_id , sol_id,home_bank_id  from tbaadm.upr where del_flg ='N')b where b.user_id =a.user_id and b.home_bank_id ='&2' and b.sol_id ='&1' and OCCUREDAT >'20-OCT-2019');

spool off;
exit;