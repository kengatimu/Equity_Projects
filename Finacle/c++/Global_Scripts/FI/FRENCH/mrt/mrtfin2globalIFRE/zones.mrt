# Template Name :		zones.mrt
# Description	:		unverified closed accounts
# Author			E.G.KAROBIA,27-05-2006
# 
#########################################################################
RECORDLAYOUT

SOL_ID		 stringType
CLG_ZONE_DATE	 stringtype
CLG_ZONE_CODE	 stringtype
ZONE_STAT 	 stringType
SETS_ENTERED	 stringtype
SETS_VERIFIED	 stringtype

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 73
columnsperline 73
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 70 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
 begin
        execute pipe	
	print SOL_ID  column 4
	print CLG_ZONE_DATE      column 11
	print CLG_ZONE_CODE     column 23
	print ZONE_STAT   column 40		
	print SETS_ENTERED  column 52
	print SETS_VERIFIED  column 64

end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL ID" column  3
	print "ZONE DATE "     column 11	
	print "ZONE CODE"   column 23
	print "ZONE STATUS"   column  35		
	print "SETS ENTERED" column  47
	print "SETS VERIFIED" column  60
	Separatorline
end 
	
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 73 center 
	nextline
	print branchName  size 73 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 73 center
	nextline
	print " MORE THAN SEVEN OPEN OR SUPENDED OUTWARD ZONES EXIST "  size 73 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 73 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 2
	print "|"   column 9
	print "|"   column 21
	print "|"   column 34
	print "|"  column  46
	print "|"  column  59
	print "|"  column  73



end


