##########################################################################
#	Report Name         : dormant_01.mrt 
#	Template File Name  : dormant_01.mrt
#	Description         : Gives details of the A/Cs whose acct_status is modifed
#						  during the batch job babx4006
#   Modification log
#   ----------------
#   Srl. No.    Date    Author  Description
#   -------     ----    ------  -----------
#   1.         15-10-98 TRNAIDU Original version
##########################################################################
RecordLayout
##########################################################################
$$$include dormant.mri
##########################################################################
LOCALVARIABLES
localdate		numbertype
localyears		numbertype
mrtForacid		stringType
callscript		numbertype
setDesc			stringType
##########################################################################
GROUPANDSORT
##########################################################################
    new_acct_status
##########################################################################
REPOSITORY bankRepos.rip readonly
##########################################################################
	    bankName                stringType
	    branchName              stringType
	    localYearsToAdd		stringType
	    

##########################################################################
REPOSITORY argv4
##########################################################################
page_number             numberType
##########################################################################
MASSAGERECORD
##########################################################################

##########################################################################
IGNORERECORD
	if (old_acct_status = "A" and new_acct_status = "A")
##########################################################################
##########################################################################
PAGEFORMAT
##########################################################################
		LinesPerPage 64
		LeftMargin 2
		rightMargin 2
		Topmargin   2
		BottomMargin 2
		columnsPerLine 132
		pageHeaderLines 12
		pageFooterLines 2
		IgnoreBlankRecord
##########################################################################
ONSTARTOFREPORT
##########################################################################
		set localyears = strToNum localYearsToAdd
		set pageNumber = 1
		execute page_detail
		execute pageHeader
##########################################################################
PAGEHEADER
##########################################################################
		execute commonPageHdr
		execute pageHeader
##########################################################################
PAGEFOOTER
##########################################################################
		separatorLine
##########################################################################
BEFOREBREAKOF new_acct_status
##########################################################################
		if new_acct_status = "I"
			begin
				nextline
				print " DETAILS OF A/C's marked as InActive" column 1 size 80 center
				nextline
				print " ------------------------- " column 1 size 80 center
				nextline
			end
		if new_acct_status = "D"
			begin
				nextline
				nextline
				print " DETAILS OF A/C's marked as Dormant " column 1 size 80 center
				nextline
				print " ------------------------- " column 1 size 80 center
			end
##########################################################################
AFTERBREAKOF new_acct_status
##########################################################################
##########################################################################
ONEVERYRECORD
##########################################################################
		
		set mrtForacid = foracid
		set callscript = runscript "ops0185mn001.scr" "mrtForacid" "setDesc"
		execute prntDetails
		
##########################################################################
ONENDOFREPORT
##########################################################################
		execute prntEndOfReport
##########################################################################
		PROCEDURE commonPageHdr
##########################################################################
		print today     column 1
		print bankName  column 35
		print "Page:" column 65
		print pageNumber column 71 precision 0
		nextline
		print branchName column 37
		nextLine
		print "DETAILS OF INACTIVE / DORMANT accounts Report" column 20
		nextLine
		print "---------------------------------------------" column 20
		nextline
		nextline
##########################################################################
		PROCEDURE pageHeader
##########################################################################
		nextline
		nextline
		separatorline
		nextline
		print "ACCT NUM"         column 1
		print "BALANCE "         column 33
		print "CRN"              column 42
		print "OLD"      		 column 47
		print "OLD"	 			 column 55
		print "LAST"   			 column 69
		nextline
	    print "STATUS"			 column 47
		print "STATUS DATE"		 column 55
		print "TRAN DATE"		 column 69	
		separatorline
##########################################################################
		PROCEDURE prntEndOfReport
##########################################################################
		if totalCount acct_balance = 0
			begin
				nextline
				print " *********   No Records Selected   ********" size 80 center
				nextline
			end
		nextLine
		print "********* END OF REPORT*********" size 80 center
		nextline
		print "Signature" size 12 column 80
       set page_number = pageNumber
##########################################################################
PROCEDURE page_detail
	    execute commonPageHdr
##########################################################################
PROCEDURE prntDetails
##########################################################################
		print foracid 		          	size 18 column 1
		print acct_balance           	autocomma size 20 column 20 
		print acct_crncy_code    		size 3 column 42
		print old_acct_status      		size 2 column 50
		set localdate = stringToDate  old_acct_status_date
		set localdate = periodAdd localdate localyears Y
		print localdate DateFormat "DD-MM-YYYY" column 55 

		set localdate = stringToDate  last_tran_date
		set localdate = periodAdd localdate localyears Y
		print localdate DateFormat "DD-MM-YYYY" column 69 

		nextline


