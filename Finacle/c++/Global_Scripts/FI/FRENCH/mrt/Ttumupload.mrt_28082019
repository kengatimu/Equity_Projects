# ******************************************************************
#    Report Name		: Ttumupload.mrt
# ******************************************************************
#

RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include      Ttumupload.mri  

LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
locTranId				stringType
count					numberType
localdate               numberType
localyears              numberType
callscript              stringType
inputFileName		stringType
output			stringType
####################################################################
GROUPANDSORT
tranId
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################

REPOSITORY bankRepos.rip readonly
	bankName		stringType
	branchName		stringType
	uniformBrCode	stringType
	branchDistrict	stringType
	branchState		stringType
	localYearsToAdd stringType

REPOSITORY argv4
	report_to		stringType
	tran_sub_type		stringType
	fire_bfti_flg		stringType
	remarks		stringType
	inp_file_name		stringType
	rename_inp_file	stringType
    errorRptFileName    stringType
    errorRecFileName    stringType
	page_number		numberType

MASSAGERECORD
IGNORERECORD

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
	widowOrphanLines 2
	LinesPerPage 64
	LeftMargin 2 
	rightMargin 2
	Topmargin	2
	BottomMargin 2
	columnsPerLine 132
    pageHeaderLines	10
    pageFooterLines 2
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
	set localyears = strToNum localYearsToAdd
	set pageNumber = 1
	set locTranId = ""
	set count = 0

	nextline
	execute bankBrLineProc
	nextline
	print  "VALIDATION REPORT ON TRANSFER TRANSACTION UPLOAD"
	nextline
	nextline
	print  "Report To             :  "
	print  report_to
	nextline
	print  "Transaction  Sub Type :  "
	print  tran_sub_type
	nextline
	print  "Upload File Name      :  "
	print  inp_file_name
	nextline
	print  "Creation  of Tran     :  "
	print  fire_bfti_flg
	nextline
	print  "Remarks               :  "
	print  remarks
	nextline
	print  "Rename Input File     :  "
	print  rename_inp_file
	nextline
	nextline

ONENDOFREPORT
if (fire_bfti_flg != "T")
begin
	if (count = 0)
	begin	
		nextline
		nextline
		if (tranId != "")
		begin
			print "*********** File uploaded successfully **************" center size 132
			set inputFileName = inp_file_name	
			set callscript = runscript "ttumdp003.scr" "inputFileName" "output" 	
		end
		else
		begin
			print "*********** No records to upload **************" center size 132
		end
		nextline
		separatorline
	end
	else
	begin
		print "Error Record File Name : "
		print errorRecFileName
		nextline
		print "Error Report File Name : "
		print errorRptFileName
		nextline
		nextline
		nextline
		print "*********** File uploaded with errors **************" center size 132
		nextline
		separatorline
	end
end
else
begin
	if (count = 0)
	begin	
		nextline
		nextline
		print "*********** Validations Successful **************" center size 132
		nextline
		separatorline
	end
	else
	begin
		print "Error Record File Name : "
		print errorRecFileName
		nextline
		print "Error Report File Name : "
		print errorRptFileName
		nextline
		nextline
		nextline
		print "*********** Errors exist in the upload file **************" center size 132
		nextline
		separatorline
	end
end
	set PAGE_NUMBER = pageNumber
PAGEHEADER
execute bankBrLineProc
###################################################################
ONEVERYRECORD 

if (successOrfailure = "F")  
	begin
		set count = count + 1
	end

if (fire_bfti_flg != "T" AND successOrfailure = "S")
	begin
		if (tranId != locTranId)
		begin
			print "Tran Id               :  "
			print  tranId
			set locTranId = tranId
		end
	end
####################################################################
#   Here the valid statements are actions.
####################################################################
execute printOneRecord

######################################################################
#  Procedure Block
######################################################################
PROCEDURE printOneRecord
nextline
nextline
######################################################################
#  Procedure 
######################################################################
PROCEDURE bankBrLineProc
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat ""
print " "
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "HH24:NN:SS"
nextLine
print bankName center
print " "
print branchName center size 132
nextline
print "Validation Report On Transfer Transaction Upload" center size 132
nextline
