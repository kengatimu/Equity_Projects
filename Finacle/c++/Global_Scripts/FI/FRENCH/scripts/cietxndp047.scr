			BANCS.INPARAM.InputAmount = CUST.CIETXN.refAmt
			BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.ToCurrency = "USD"
			BANCS.INPARAM.RateCode = "CNS"
			BANCS.INPARAM.Rate = 0.0
			BANCS.INPARAM.CustId = ""
			
			sv_u = urhk_B2k_ConvertAmount("")
			PRINT(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				#CUST.CIETXN.refAmtInHomeCcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				#PRINT(CUST.CIETXN.refAmtInHomeCcy)
				CUST.CIETXN.refAmtInHomeCcy= TOUPPER(TRIM(BANCS.OUTPARAM.OutputAmount))
				PRINT(CUST.CIETXN.refAmtInHomeCcy)
				CUST.CIETXN.chargeAmtCcy = "USD"
				#}
			ELSE
				#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Unable to derive charge amount;"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF

		IF(TRIM(CUST.CIETXN.rateCode) == "")THEN
		#{
			CUST.CIETXN.parameterId = "FCY_DFLT_RATE_CODE_FOR_CHRG_" + CUST.CIETXN.targetEntity
			PRINT(CUST.CIETXN.parameterId)
			
			CUST.CIETXN.chargeRateCode = ""
			sv_s = "chargeRateCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			PRINT(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				IF((CUST.CIETXN.txnType == "PA_TT") OR (CUST.CIETXN.txnType == "PA_CD"))THEN
				#{
					CUST.CIETXN.chargeRateCode = "CNB"
					GOTO RATECODE_SET
					#}
				ELSE
					#{
					CUST.CIETXN.errorFlg = "Y"
					CUST.CIETXN.errorMsg = "Default Rate Code for Charge is not set in CPARAM"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			CUST.CIETXN.chargeRateCode = BANCS.OUTPARAM.chargeRateCode
			PRINT(CUST.CIETXN.chargeRateCode)
			
			IF(TRIM(CUST.CIETXN.chargeRateCode) == "")THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Default Rate Code for Charge is not set in CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
				RATECODE_SET:
				CUST.CIETXN.rateCode = CUST.CIETXN.chargeRateCode
				PRINT(CUST.CIETXN.rateCode)
				CUST.CIETXN.rate = "0.00"
				PRINT(CUST.CIETXN.rate)
				
		#}
		ENDIF
			
			BANCS.INPARAM.InputAmount = CUST.CIETXN.refAmt
			BANCS.INPARAM.FromCurrency = CUST.CIETXN.refCrncy
			BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.RateCode = CUST.CIETXN.rateCode
			#BANCS.INPARAM.Rate = 0.0
			
			BANCS.INPARAM.Rate = CUST.CIETXN.rate
			BANCS.INPARAM.CustId = ""
			
			sv_u = urhk_B2k_ConvertAmount("")
			PRINT(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				CUST.CIETXN.refAmtInHomeCcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(CUST.CIETXN.refAmtInHomeCcy)
				CUST.CIETXN.refAmtInHomeCcy1= TOUPPER(TRIM(BANCS.OUTPARAM.OutputAmount))
				PRINT(CUST.CIETXN.refAmtInHomeCcy1)
				#}
			ELSE
				#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = "Unable to derive charge amount;"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF (CUST.CIETXN.refCrncy == "USD") THEN
				CUST.CIETXN.refAmtInHomeCcy= CUST.CIETXN.refAmt
				PRINT(CUST.CIETXN.refAmtInHomeCcy)
				CUST.CIETXN.chargeAmtCcy = "USD"
			ENDIF
			
			IF (CUST.CIETXN.refCrncy == "EUR") THEN
				CUST.CIETXN.refAmtInHomeCcy= CUST.CIETXN.refAmt
				PRINT(CUST.CIETXN.refAmtInHomeCcy)
				CUST.CIETXN.chargeAmtCcy = "EUR"
			ENDIF
			IF (CUST.CIETXN.refCrncy == "GBP") THEN
				CUST.CIETXN.refAmtInHomeCcy= CUST.CIETXN.refAmt
				PRINT(CUST.CIETXN.refAmtInHomeCcy)
				CUST.CIETXN.chargeAmtCcy = "GBP"
			ENDIF
		#}
		ENDIF

		IF((CUST.CIETXN.txnType == "CD") OR (CUST.CIETXN.txnType == "PA_CD"))THEN
		#{
			IF ((CUST.CIETXN.refCrncy == "KES") AND (BANCS.STDIN.contextBankId == "50"))THEN
				CUST.CIETXN.refAmtInHomeCcy = CUST.CIETXN.refAmt
				print(CUST.CIETXN.refAmtInHomeCcy)

				CUST.CIETXN.chargeAmtCcy = CUST.CIETXN.refCrncy
				print(CUST.CIETXN.chargeAmtCcy)
			ENDIF
		ENDIF
	
		
		###########################################################################################
		# Get the Charge Amt
		###########################################################################################
		
	CHARGE_CALC:
		
		#-----------------------------------------------------------------------------------------
		# Get a dummy home currency account to derive charge amount
		#-----------------------------------------------------------------------------------------
		
		CUST.CIETXN.dummyAcct = ""
		
		#sv_s = "dummyAcct|SELECT FORACID FROM TBAADM.GAM"
		sv_s = "dummyAcct|SELECT /*+ INDEX_JOIN(GAM) */ FORACID FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE  BANK_ID = ?SVAR"
		#sv_s = sv_s + " AND SOL_ID = ?SVAR"
		sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR"
		sv_s = sv_s + " AND SCHM_TYPE ='SBA'"
		#sv_s = sv_s + " AND SCHM_TYPE NOT IN ('LAA','CLA','TDA','TUA','BIA','FBA')"
		sv_s = sv_s + " AND ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND DEL_FLG = 'N'"
		sv_s = sv_s + " AND ACCT_CLS_FLG = 'N'"
		sv_s = sv_s + " AND NVL(TRIM(FREZ_CODE),'Z') = 'Z'"
		sv_s = sv_s + " AND ACCT_OWNERSHIP = 'C'"
		sv_s = sv_s + " AND ROWNUM < 2"
		PRINT(sv_s)
		
		IF ((BANCS.STDIN.contextBankId=="11") AND (CUST.CIETXN.refCrncy == "USD") OR (BANCS.STDIN.contextBankId=="54"))THEN
		
			IF (BANCS.STDIN.contextBankId=="54") THEN			
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.chargeAmtCcy
				print(BANCS.INPARAM.BINDVARS)
			ELSE
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.refCrncy
				print(BANCS.INPARAM.BINDVARS)
			ENDIF

		ELSE
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			CUST.CIETXN.dummyAcct = BANCS.OUTPARAM.dummyAcct
			PRINT(CUST.CIETXN.dummyAcct)
		#}
		ENDIF
		
		#-----------------------------------------------------------------------------------------
		# Set Input for GCHRG SRV
		#-----------------------------------------------------------------------------------------
		
		sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" +CUST.CIETXN.chargeEventId)
		sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" +CUST.CIETXN.chargeAmtCcy)
	
		sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgAmt|"+CUST.CIETXN.refAmtInHomeCcy +"|"+ CUST.CIETXN.chargeAmtCcy)
		
		
		IF((CUST.CIETXN.txnType == "CD") OR (CUST.CIETXN.txnType == "PA_CD"))THEN
		#{
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|C")
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|CR")
			sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.CIETXN.chargeAmtCcy)
		#}
		ENDIF
		
		IF((CUST.CIETXN.txnType == "CW") OR (CUST.CIETXN.txnType == "TF") OR (CUST.CIETXN.txnType == "PA_TT"))THEN
		#{
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|T")
			sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|BI")
			print(CUST.CIETXN.chargeAmtCcy)
			sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.CIETXN.chargeAmtCcy)
			sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.CIETXN.dummyAcct)
		#}
		ENDIF
		
		sv_u = urhk_SetUrhkOut("genChrgDtl.calcAmt|calcAmt")
		
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchDfltGenChrgDtl|retain_all_output = Y")
		PRINT(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			CUST.CIETXN.errorFlg = "Y"
			sv_n = BANCS.OUTPARAM.Error_num
			IF(sv_n != 0)THEN
			#{
				sv_s = BANCS.OUTPARAM.ErrorMesg_1
				PRINT(sv_s)
				CUST.CIETXN.errorMsg = sv_s
			#}
			ENDIF
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + ";  " + "Unable to get Charge Details;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIETXN.calcAmt = BANCS.OUTPARAM.calcAmt
		PRINT(CUST.CIETXN.calcAmt)
		
		IF(CUST.CIETXN.crAcctNum=="2011211305798") THEN
		#{
			CUST.CIETXN.calcAmt="0.00|" + CUST.CIETXN.chargeAmtCcy
		#}
		ENDIF
		
		sv_p = GETPOSITION(CUST.CIETXN.calcAmt,"|")
		PRINT(sv_p)
		
		IF(sv_p > 0)THEN
		#{
			sv_a = MID$(CUST.CIETXN.calcAmt,0,sv_p-1)
			PRINT(sv_a)
			CUST.CIETXN.chargeAmt = sv_a
			PRINT(CUST.CIETXN.chargeAmt)
			
			sv_c = MID$(CUST.CIETXN.calcAmt,sv_p,3)
			PRINT(sv_c)
			CUST.CIETXN.chargeAmtCcy = sv_c
			PRINT(CUST.CIETXN.chargeAmtCcy)
			#}
		ELSE
			#{
			CUST.CIETXN.errorFlg = "Y"
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to get Charge Details;"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#IF(CUST.CIETXN.chargeAmt > 0) THEN
			CUST.CIETXN.chargeAmtFlg = "Y"
			CUST.CIETXN.chargeAmtCcyFlg = "Y"
		#ELSE
		#	CUST.CIETXN.chargeAmtFlg = "N"
		#	CUST.CIETXN.chargeAmtCcyFlg = "N"
		#ENDIF
		
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		PRINT(sv_u)
		
		###############################################
		# Check for staff accounts - no charge
		###############################################
		IF(CUST.CIETXN.txnType == "PA_CD")THEN
		#{
			GOTO ENDSCRIPT
		#}
		ENDIF
		CUST.INTERFACE.bankID=CUST.CIETXN.targetEntity
		IF(CUST.CIETXN.txnType == "TF")THEN
		#{
			CUST.CIETXN.targetEntity=CUST.CIETXN.crAcctNumEntityId
		#}
		ENDIF
		CUST.INTERFACE.bankID=CUST.CIETXN.targetEntity
		CALL("getBoxType.scr")
		
		PRINT(CUST.CIETXN.boxType)
		PRINT(CUST.CIETXN.errorFlg)
		PRINT(CUST.CIETXN.errorMsg)
		CUST.CIETXN.Remarks = CUST.CIETXN.errorMsg
		IF(CUST.CIETXN.txnType == "CD")THEN
		#{
			
			IF((CUST.CIETXN.errorFlg == "N") AND (CUST.CIETXN.boxType == "I")) THEN
			#{
				CALL("getEndPoint.scr")
				
				
				IF (CUST.CIETXN.errorFlg!="Y") THEN
				#{
					CUST.INTERFACE.endPointUrl = CUST.CIETXN.endPointUrl
					PRINT(CUST.INTERFACE.endPointUrl)
				#	CUST.INTERFACE.inputdata = CUST.CIETXN.crAcctNum+"|"+CUST.CIETXN.txnType
					CUST.INTERFACE.inputData = CUST.CIETXN.crAcctNum+"|"+CUST.CIETXN.txnType+"|"
					print(CUST.INTERFACE.inputData)
					CUST.INTERFACE.callScript="cietxndp147.scr"
					CALL("cietxndp147_fi.scr")
					CUST.CIETXN.staffCount = BANCS.OUTPUT.staffCount
					PRINT(CUST.CIETXN.staffCount)
					#}
				ELSE
					#{
					PRINT("END POINT URL not fetched")
					
					CUST.CIETXN.staffCount=0
				#}
				ENDIF
				
				
				
				
				
				
				
				#}
				
				#}
			ELSE
				#{
				
				sv_s = "staffCount|"
				sv_s = sv_s + " SELECT count(1) "
				sv_s = sv_s + " FROM TBAADM.GAM "
				sv_s = sv_s + " WHERE FORACID = ?SVAR"
				sv_s = sv_s + " AND BANK_ID = ?SVAR"
				sv_s = sv_s + " AND SCHM_TYPE = 'SBA'"
				sv_s = sv_s + " AND SCHM_CODE = 'SB190'"
				sv_s = sv_s + " AND DEL_FLG != 'Y'"
				PRINT(sv_s)
				
				BANCS.INPARAM.BINDVARS = CUST.CIETXN.crAcctNum + "|" + CUST.CIETXN.targetEntity
				PRINT(BANCS.INPARAM.BINDVARS)
				IF (FIELDEXISTS(sv_s)) THEN
				#{
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					
					IF(sv_d == 0)THEN
					#{
						CUST.CIETXN.staffCount = BANCS.OUTPARAM.staffCount
						PRINT(CUST.CIETXN.staffCount)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		IF((CUST.CIETXN.txnType == "TF") OR(CUST.CIETXN.txnType == "PA_TT"))THEN
		#{
			
			IF((CUST.CIETXN.errorFlg == "N") AND (CUST.CIETXN.boxType == "I")AND (CUST.CIETXN.targetEntity == CUST.CIETXN.drAcctNumEntityId)) THEN
			#{
				CALL("getEndPoint.scr")
				
				
				IF (CUST.CIETXN.errorFlg!="Y") THEN
				#{
					CUST.INTERFACE.endPointUrl = CUST.CIETXN.endPointUrl
					PRINT(CUST.INTERFACE.endPointUrl)
				#	CUST.INTERFACE.inputdata = CUST.CIETXN.drAcctNum+"|"+CUST.CIETXN.txnType
					CUST.INTERFACE.inputData = CUST.CIETXN.drAcctNum+"|"+CUST.CIETXN.txnType+"|"
					CUST.INTERFACE.callScript="cietxndp147.scr"
					CALL("cietxndp147_fi.scr")
					CUST.CIETXN.staffCount = BANCS.OUTPUT.staffCount
					PRINT(CUST.CIETXN.staffCount)
					#}
				ELSE
					#{
					PRINT("END POINT URL not fetched")
					
					CUST.CIETXN.staffCount=0
				#}
				ENDIF
				
				
				
				
				
				
				
				
				#}
			ELSE
				#{
				sv_s = "staffCount|"
				sv_s = sv_s + " SELECT count(1) "
				sv_s = sv_s + " FROM TBAADM.GAM "
				sv_s = sv_s + " WHERE FORACID = ?SVAR"
				sv_s = sv_s + " AND BANK_ID = ?SVAR"
				#sv_s = sv_s + " AND SCHM_TYPE = 'SBA'"
				#sv_s = sv_s + " AND SCHM_CODE = 'SB190'"
				sv_s = sv_s + " AND ((schm_type ='OAB') OR ((schm_type ='SBA') AND (schm_code ='SB190')))"
				sv_s = sv_s + " AND DEL_FLG != 'Y'"
				PRINT(sv_s)
				
				BANCS.INPARAM.BINDVARS = CUST.CIETXN.drAcctNum + "|" + CUST.CIETXN.drAcctNumEntityId
				PRINT(BANCS.INPARAM.BINDVARS)
				
				IF (FIELDEXISTS(sv_s)) THEN
				#{
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					
					IF(sv_d == 0)THEN
					#{
						CUST.CIETXN.staffCount = BANCS.OUTPARAM.staffCount
						PRINT(CUST.CIETXN.staffCount)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		
		
		IF(CUST.CIETXN.staffCount != 0)THEN
		#{
			CUST.CIETXN.chargeAmt = "0"
		#}
		ENDIF
		
		
#		IF (BANCS.STDIN.contextBankId != "11") THEN
#		#{
#			IF ((CUST.CIETXN.txnType == "TF") OR (CUST.CIETXN.txnType == "PA_TT") OR (CUST.CIETXN.txnType == "CD") OR (CUST.CIETXN.txnType == "PA_CD")) THEN
