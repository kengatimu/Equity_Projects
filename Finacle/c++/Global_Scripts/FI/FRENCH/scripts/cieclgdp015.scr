		sv_u = urhk_SetOrbOut(sv_s)
		sv_i = sv_i + 1
	#}
	ENDIF
	
	IF(sv_i > 1)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF((CUST.CIECLG.creditEntity == CUST.CIECLG.instrumentEntity) AND (CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId))THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Both Credit Account ID AND Instrument belong to Init Entity. Please use HOCTM menu^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF((CUST.CIECLG.creditEntity != BANCS.STDIN.contextBankId) AND (CUST.CIECLG.instrumentEntity != BANCS.STDIN.contextBankId))THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Either Credit Account Entity OR Instrument Entity should be Init Entity^creditEntity"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Clearing Amount Limit Check
	######################################################################################
	
	CUST.CIECLG.scriptSuccess = "Y"
	
	CALL("cieclgdp005.scr")
	
	IF(CUST.CIECLG.scriptSuccess == "N")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Get Bank Id, Branch Id, Sort Code from CPARAM
	######################################################################################
	
	IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
	#{
		CUST.CIECLG.parameterId = "DEFAULT_BANK_CODE_" + CUST.CIECLG.instrumentEntity
		#}
	ELSE
		#{
		CUST.CIECLG.parameterId = "DEFAULT_BANK_CODE_" + CUST.CIECLG.creditEntity
	#}
	ENDIF
	
	print(CUST.CIECLG.parameterId)
	
	sv_s = "defaultBankCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Bank Code to lodge instrument in " + CUST.CIECLG.creditEntity + " is not set in CPARAM^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.defaultBankCode = BANCS.OUTPARAM.defaultBankCode
	print(CUST.CIECLG.defaultBankCode)
	
	IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
	#{
		CUST.CIECLG.parameterId = "DEFAULT_BRANCH_CODE_" + CUST.CIECLG.instrumentEntity
		#}
	ELSE
		#{
		CUST.CIECLG.parameterId = "DEFAULT_BRANCH_CODE_" + CUST.CIECLG.creditEntity
	#}
	ENDIF
	
	print(CUST.CIECLG.parameterId)
	
	sv_s = "defaultBranchCode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIECLG.parameterId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Branch Code to lodge instrument in " + CUST.CIECLG.creditEntity + " is not set in CPARAM^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIECLG.defaultBranchCode = BANCS.OUTPARAM.defaultBranchCode
	print(CUST.CIECLG.defaultBranchCode)
	
	CUST.CIECLG.defaultSortCode = "100200300"
	
	######################################################################################
	# Verify Instrument in current entity
	######################################################################################
	
	CUST.CIECLG.scriptSuccess = "Y"
	
	CALL("cieclgdp037.scr")
	
	IF(CUST.CIECLG.scriptSuccess == "Y")THEN
	#{
		#----------------------------------------------------------------------------------------
		# Instrument Bank Code is an Equity Bank Code.
		# Payee Account Validation Done in cieclgdp037.scr
		#----------------------------------------------------------------------------------------
		
		CUST.CIECLG.equityBankInstrument = "Y"
		
	#}
	ENDIF
	
	sv_s = MID$(TRIM(CUST.CIECLG.setNum),0,1)
	print(sv_s)
	IF(sv_s == "D")THEN
	#{
		GOTO CHARGE_COLLECTION_AT_INIT_ENTITY
	#}
	ENDIF
	
	CUST.CIECLG.scriptSuccess = "Y"
	
	CALL("cieclgdp016.scr")
	
	IF(CUST.CIECLG.scriptSuccess == "N")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Collect Charge at init entity
	######################################################################################
	
	CHARGE_COLLECTION_AT_INIT_ENTITY:
		
		IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIECLG.chrgDebitAcct = CUST.CIECLG.crAcctNum
			#}
		ELSE
			#{
			CUST.CIECLG.chrgDebitAcct = CUST.CIECLG.nostroAcct
		#}
		ENDIF
		
		CUST.CIECLG.chargeTranId = ""
		CUST.CIECLG.chargeTranDate = ""
		CUST.CIECLG.scriptSuccess = "Y"
		
		CALL("cieclgdp008.scr")
		
		IF(CUST.CIECLG.scriptSuccess == "N")THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		print(CUST.CIECLG.chargeTranId)
		print(CUST.CIECLG.chargeTranDate)
		
		CUST.CIECLG.chargeTranDate = MID$(CUST.CIECLG.chargeTranDate,0,10)
		
		######################################################################################
		# Lodge and Verify Instrument in Other Entity
		######################################################################################
		
		sv_s = MID$(TRIM(CUST.CIECLG.setNum),0,1)
		print(sv_s)
		
		IF((CUST.CIECLG.equityBankInstrument == "Y") AND (sv_s != "D"))THEN
		#{
			sv_s = "recordCount|SELECT TO_CHAR((COUNT(*)+ 1)) FROM CUSTOM.IECD"
			sv_s = sv_s + " WHERE ZONE_CODE = ?SVAR"
			sv_s = sv_s + " AND ZONE_DATE = TO_DATE(?SVAR,'DD-MM-YYYY')"
			sv_s = sv_s + " AND SOL_ID = ?SVAR"
			sv_s = sv_s + " AND BANK_ID = ?SVAR"
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.CIECLG.zoneCode + "|" + CUST.CIECLG.zoneDate + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF(sv_d == 0)THEN
			#{
				PRINT(BANCS.OUTPARAM.recordCount)
				CUST.CIECLG.targetSetNum = "D" + BANCS.OUTPARAM.recordCount
				PRINT(CUST.CIECLG.targetSetNum)
				#}
			ELSE
				#{
				CUST.CIECLG.targetSetNum = "D1"
			#}
			ENDIF
			
			CUST.CIECLG.targetSetNum = LPAD(CUST.CIECLG.targetSetNum,6)
			PRINT(CUST.CIECLG.targetSetNum)
			
			GOTO CHARGE_COLLECTION_AT_TARGET_ENTITY
		#}
		ENDIF
		
		sv_r = CLASSEXISTS("CUST","INTERFACE")
		IF(sv_r == 0) THEN
		#{
			CREATECLASS ("CUST","INTERFACE",5)
		#}
		ENDIF
		
		CUST.CIECLG.bankId = ""
		CUST.CIECLG.bankCode = ""
		CUST.CIECLG.branchCode = ""
		CUST.CIECLG.targetAcctId = ""
		
		IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
		#{
			CUST.CIECLG.bankId = CUST.CIECLG.instrumentEntity
			CUST.CIECLG.bankCode = CUST.CIECLG.instrumentBankCode
			CUST.CIECLG.branchCode = CUST.CIECLG.instrumentBranchCode
			CUST.CIECLG.sortCode = CUST.CIECLG.instrumentSortCode
			CUST.CIECLG.targetAcctId = CUST.CIECLG.vostroAcct
			CUST.CIECLG.chrgDebitAcct = CUST.CIECLG.crAcctNum
			#}
		ELSE
			#{
			CUST.CIECLG.bankId = CUST.CIECLG.creditEntity
			CUST.CIECLG.bankCode = CUST.CIECLG.defaultBankCode
			CUST.CIECLG.branchCode = CUST.CIECLG.defaultBranchCode
			CUST.CIECLG.sortCode = CUST.CIECLG.defaultSortCode
			CUST.CIECLG.targetAcctId = CUST.CIECLG.crAcctNum
			CUST.CIECLG.chrgDebitAcct = CUST.CIECLG.nostroAcct
		#}
		ENDIF
		
		print(BANCS.STDIN.sysDate)
		
		sv_s = "RequestID|SELECT CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')) FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0)THEN
		#{
			CUST.CIECLG.RequestID = BANCS.OUTPARAM.RequestID
			print(CUST.CIECLG.RequestID)
			#}
		ELSE
			#{
			CUST.CIECLG.RequestID = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
			print(CUST.CIECLG.RequestID)
		#}
		ENDIF
		
		CUST.INTERFACE.funcCode = "V"
		CUST.INTERFACE.RequestID = CUST.CIECLG.RequestID
		CUST.INTERFACE.channelID = "COR"
		CUST.INTERFACE.bankID = CUST.CIECLG.bankId
		CUST.INTERFACE.zoneCode = CUST.CIECLG.targetZoneCode
		CUST.INTERFACE.zoneDate = CUST.CIECLG.targetZoneDate
		CUST.INTERFACE.solId = CUST.CIECLG.targetSolId
		CUST.INTERFACE.setNum = ""
		CUST.INTERFACE.acctId = CUST.CIECLG.targetAcctId
		CUST.INTERFACE.instrumentAmt = CUST.CIECLG.instrumentAmt
		CUST.INTERFACE.instrumentAmtCcy = CUST.CIECLG.instrumentAmtCcy
		CUST.INTERFACE.sortCode = CUST.CIECLG.sortCode
		CUST.INTERFACE.bankCode = CUST.CIECLG.bankCode
		CUST.INTERFACE.branchCode = CUST.CIECLG.branchCode
		CUST.INTERFACE.instrumentNum = CUST.CIECLG.instrumentNum
		CUST.INTERFACE.instrumentDate = CUST.CIECLG.instrumentDate
		CUST.INTERFACE.valueDate = CUST.CIECLG.valueDate
		CUST.INTERFACE.payingAcct = CUST.CIECLG.payingAcct
		CUST.INTERFACE.rejectReasonCode = ""
		CUST.INTERFACE.errorCode = ""
		CUST.INTERFACE.errorMsg = ""
		CUST.INTERFACE.errorDesc = ""
		CUST.INTERFACE.errorMsgFlg = "N"
		
		CALL("cieclgmn004.scr")
		
		IF(CUST.INTERFACE.errorMsgFlg == "Y")THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_s = "Error_1|Error^Unable to lodge AND verify instrument in the target entity^creditEntity"
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			sv_s = "Error_2|Error^" + CUST.INTERFACE.errorDesc + "^creditEntity"
			print(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.CIECLG.targetSetNum = CUST.INTERFACE.setNum
		CUST.CIECLG.targetSetNum = LPAD(CUST.CIECLG.targetSetNum,6)
		PRINT(CUST.CIECLG.targetSetNum)
		
		######################################################################################
		# Collect Charge at target entity
		######################################################################################
		
	CHARGE_COLLECTION_AT_TARGET_ENTITY:
		
		CUST.CIECLG.targetChargeTranId = ""
		CUST.CIECLG.targetChargeTranDate = ""
		
		IF(CUST.CIECLG.chrgDebitAcct == CUST.CIECLG.nostroAcct)THEN
		#{
			CUST.CIECLG.scriptSuccess = "Y"
			#CALL("cieclgdp009.scr")
			
			IF(CUST.CIECLG.scriptSuccess == "N")THEN
			#{
				sv_u = urhk_dbSqlWithBind("ROLLBACK")
				print(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		print(CUST.CIECLG.targetChargeTranId)
		print(CUST.CIECLG.targetChargeTranDate)
		CUST.CIECLG.targetChargeTranDate = MID$(CUST.CIECLG.targetChargeTranDate,0,10)
		
		######################################################################################
		# Update status in IECD Custom Table
		######################################################################################
		
	UPDATE_STATUS:
		
		sv_s = "UPDATE CUSTOM.IECD SET "
		sv_s = sv_s + " STATUS_FLG = 'V',"
		sv_s = sv_s + " TARGET_SET_NUM = ?SVAR" + ","
		sv_s = sv_s + " CHARGE_TRAN_ID = ?SVAR" + ","
		sv_s = sv_s + " CHARGE_TRAN_DATE = to_date(?SVAR,'DD-MM-YYYY')" + ","
		
		IF(CUST.CIECLG.targetChargeTranId != "")THEN
		#{
			sv_s = sv_s + " TARGET_CHARGE_TRAN_ID = ?SVAR" + ","
			sv_s = sv_s + " TARGET_CHARGE_TRAN_DATE = to_date(?SVAR,'DD-MM-YYYY')" + ","
		#}
		ENDIF
		
		sv_s = sv_s + " LCHG_USER_ID = ?SVAR" + ","
		sv_s = sv_s + " LCHG_TIME = sysdate"
		sv_s = sv_s + " WHERE ZONE_CODE = ?SVAR"
		sv_s = sv_s + " AND ZONE_DATE = to_date(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " AND SOL_ID = ?SVAR"
		sv_s = sv_s + " AND TRIM(SET_NUM) = ?SVAR"
		sv_s = sv_s + " AND BANK_ID = ?SVAR"
		sv_s = sv_s + " AND REVERSE_FLG = 'N'"
		
		BANCS.INPARAM.BINDVARS = ""
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.targetSetNum	+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.chargeTranId	+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.chargeTranDate	+ "|"
		
		IF(CUST.CIECLG.targetChargeTranId != "")THEN
		#{
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.targetChargeTranId      + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.targetChargeTranDate    + "|"
		#}
		ENDIF
		
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId 		+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.zoneCode 		+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIECLG.zoneDate 		+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId 		+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + TRIM(CUST.CIECLG.setNum) 	+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
		
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSqlWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			CUST.CIECLG.scriptSuccess = "N"
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Database Update Operation Failed ON Custom Table^funcCode")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		######################################################################################
		# Result Message
		######################################################################################
		
		sv_s = CUST.CIECLG.resultMsg
		sv_s = sv_s + "!" + CUST.CIECLG.funcCode + "!" + CUST.CIECLG.zoneCode + "!" + CUST.CIECLG.zoneDate + "!" + BANCS.STDIN.mySolId + "!" + CUST.CIECLG.setNum
		sv_s = sv_s + "!" + CUST.CIECLG.targetZoneCode + "!" + CUST.CIECLG.targetZoneDate + "!" + CUST.CIECLG.targetSolId + "!" + CUST.CIECLG.targetSetNum
		sv_s = sv_s + "!" + CUST.CIECLG.chargeTranId + "!" + CUST.CIECLG.chargeTranDate
		sv_s = sv_s + "!" + CUST.CIECLG.targetChargeTranId + "!" + CUST.CIECLG.targetChargeTranDate
		print(sv_s)
		sv_u = urhk_SetOrbOut(sv_s)
		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		print(sv_u)
		
	ENDOFSCRIPT:
END-->
