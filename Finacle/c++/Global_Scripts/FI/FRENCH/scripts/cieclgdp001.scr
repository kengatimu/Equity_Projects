	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Zone is already Released to Shadow Balance^zoneCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CIECLG.zoneStatus == "G")THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Zone is already Regularised^zoneCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.CIECLG.zoneStatus == "C")THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
