	sv_u = urhk_SetUrhkOut("zoneHeader.zoneStat.code|zoneStatus")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_ZoneInquiry|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	CUST.CIECLG.zoneCcy = BANCS.OUTPARAM.zoneCcy
	print(CUST.CIECLG.zoneCcy)
	CUST.CIECLG.zoneStatus = BANCS.OUTPARAM.zoneStatus
	print(CUST.CIECLG.zoneStatus)
	
	IF(CUST.CIECLG.zoneStatus == "S")THEN
	#{
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
