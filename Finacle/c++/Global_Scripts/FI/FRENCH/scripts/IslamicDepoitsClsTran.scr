<--START
CHECKSUM="b3976db71d30764fd7a2da6d01f47d64f3d5c701c7d9366e3de90154ccc97c31"
	TRACE ON
	#	This script handles the Closure transactions for deposit accounts in
	#	Islamic Banking
	#	Below part transactions have been taken care in this script
	#	1. Reversal of Profit that is Booked but not applied
	#	2. Adjustments for revised tenors
	#	3. Penalty if applicable
	#	4. Recovery adjustments
	#	5. Principal Closure
	#	6. Customer Payoff
	IF (REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF(CLASSEXISTS("CUST","WITHTAX")==0)THEN
	#{
		CREATECLASS("CUST","WITHTAX",5)
	#}
	ENDIF
	sv_r = urhk_MTTS_PopulateInputDetails("")
	sv_r = urhk_B2k_PrintRepos("MTT")
	sv_e = ""
	MTT.OutputDetails.maxTrans=""
	MTT.OutputDetails.revTranExists=""
	PRINT(MTT.InputDetails.preClsFlg)
	PRINT(MTT.InputDetails.partClsFlg)
	# Closure transactions for - on Maturity closure
	IF((MTT.InputDetails.preClsFlg == "N") AND (MTT.InputDetails.partClsFlg == "N")) THEN
	#{
		IF(MTT.InputDetails.matClsPayFlg == "I") THEN
		#{
			# Maturity closure at INDICATIVE rate
			
			# Transaction for Booking Reversal starts here
			#{
			IF(CDOUBLE(MTT.InputDetails.bookedPrNotAppl) != 0 ) THEN
			#{
				MTT.TranDetails.TranDate="0"
				MTT.TranDetails.TranType="T"
				MTT.TranDetails.TranSubType="BI"
				MTT.TranDetails.Remarks="ACCOUNT CLOSURE TRANSACTION"
				MTT.TranDetails.IgnoreExcp="I"
				MTT.TranDetails.Consolidate="N"
				MTT.TranDetails.InitSolId=BANCS.STDIN.mySolId
				MTT.TranDetails.RestrictModifyInd="1"
				MTT.TranDetails.EventType="TDCLS"
				MTT.PartTranDetails.Refnum=""
				
				sv_r=urhk_MTTS_DefineTransaction("ClsBookingReversal")
				MTT.OutputDetails.OVDUECRAccount=""
				MTT.OutputDetails.INTAMTToPARKAccount=0
				MTT.OutputDetails.tdForacid=MTT.InputDetails.tdForacid
				MTT.OutputDetails.acctCrncyCode=MTT.InputDetails.acctCrncyCode
				MTT.OutputDetails.homeCrncyCode=MTT.InputDetails.homeCrncyCode
				MTT.OutputDetails.valueDate=MTT.InputDetails.clsValueDate
				MTT.OutputDetails.tranDate=BANCS.STDIN.BODDate
				BANCS.OUTPUT.PartTranNum="0"
				sv_h=MTT.InputDetails.homeCrncyCode
				MTT.PartTranDetails.Refnum="          "+MTT.InputDetails.flowCode
				MTT.PartTranDetails.Acoount=MTT.InputDetails.tdForacid
				
				#Debit Part Transactions for Booking Reversal starts here
				MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Booking Reversal ON closure"
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.nrmlIntPaidAcct
				MTT.PartTranDetails.RefAmount= -1 * CDOUBLE(MTT.InputDetails.bookedPrNotAppl)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
				MTT.PartTranDetails.Remarks="Debiting Profit Payabable Acct"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="ClsBookingReversal"
				BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
				#print(BANCS.OUTPUT.PartTranNum)
				PRINT(MTT.PartTranDetails.RefAmount)
				PRINT(MTT.PartTranDetails.Account)
				sv_r=urhk_MTTS_DefinePartTran("BookingReversal")
				
				#CREDIT Part Transactions for Booking Reversal starts here
				MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Booking Reversal ON closure"
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.nrmlPandlAcct
				MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.InputDetails.bookedPrNotAppl)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
				MTT.PartTranDetails.Remarks="Crediting P&L Acct"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="ClsBookingReversal"
				BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
				#print(BANCS.OUTPUT.PartTranNum)
				PRINT(MTT.PartTranDetails.RefAmount)
				PRINT(MTT.PartTranDetails.Account)
				sv_r=urhk_MTTS_DefinePartTran("BookingReversal")
				
				MTT.OutputDetails.maxTrans=CINT(MTT.OutputDetails.maxTrans) + 1
				MTT.OutputDetails.revTranExists="Y"
				sv_r = urhk_MTTS_EndDefinition("")
			#}
			ENDIF
			#Part Transactions for Booking Reversal END here
			#}
			#Transaction for Booking Reversal End here
			
			#Transaction for Closure Starts here
			#{
			MTT.TranDetails.TranDate="0"
			MTT.TranDetails.TranType="T"
			MTT.TranDetails.TranSubType="BI"
			MTT.TranDetails.Remarks="ACCOUNT CLOSURE TRANSACTION"
			MTT.TranDetails.IgnoreExcp="I"
			MTT.TranDetails.Consolidate="N"
			MTT.TranDetails.InitSolId=BANCS.STDIN.mySolId
			MTT.TranDetails.RestrictModifyInd="1"
			MTT.TranDetails.EventType="TDCLS"
			MTT.PartTranDetails.Refnum=""
			
			sv_r=urhk_MTTS_DefineTransaction("ClosureTransaction")
			MTT.OutputDetails.OVDUECRAccount=""
			MTT.OutputDetails.INTAMTToPARKAccount=0
			MTT.OutputDetails.tdForacid=MTT.InputDetails.tdForacid
			MTT.OutputDetails.acctCrncyCode=MTT.InputDetails.acctCrncyCode
			MTT.OutputDetails.homeCrncyCode=MTT.InputDetails.homeCrncyCode
			MTT.OutputDetails.valueDate=MTT.InputDetails.clsValueDate
			MTT.OutputDetails.tranDate=BANCS.STDIN.BODDate
			BANCS.OUTPUT.PartTranNum="0"
			sv_h=MTT.InputDetails.homeCrncyCode
			MTT.PartTranDetails.Refnum="          "+MTT.InputDetails.flowCode
			MTT.PartTranDetails.Acoount=MTT.InputDetails.tdForacid
			
			IF(CDOUBLE(MTT.InputDetails.repayAmt) != 0 ) THEN
			#{
				MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Principal Closure"
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.depAcct
				MTT.PartTranDetails.RefAmount= -1 * CDOUBLE(MTT.InputDetails.repayAmt)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
				MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
				MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
				MTT.PartTranDetails.Remarks="Debiting Deposit Acct"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
				BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
				#print(BANCS.OUTPUT.PartTranNum)
				PRINT(MTT.PartTranDetails.RefAmount)
				PRINT(MTT.PartTranDetails.Account)
				sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
			#}
			ENDIF
			IF((CDOUBLE(MTT.InputDetails.bpProfit) != 0) OR (CDOUBLE(MTT.InputDetails.prefProfAmt) != 0)) THEN
			#{
				sv_a = MTT.InputDetails.bppiaAcct
				sv_r = "Debiting BPPIA"
				IF(MTT.InputDetails.maturityProductFlg == "I") THEN
				#{
					sv_a = MTT.InputDetails.mppiaAcct
					sv_r = "Debiting MPPIA"
				#}
				ENDIF
				IF(MTT.InputDetails.islSchProd == "K") THEN
				#{
					MTT.PartTranDetails.Particulars=MTT.InputDetails.bppiaAcct+" : Profit for Wakala"
					#}
				ELSE
					#{
					MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Profit at Indicative"
				#}
				ENDIF
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.bppiaAcct
				MTT.PartTranDetails.RefAmount= -1 * CDOUBLE(MTT.InputDetails.bpProfit)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
				MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
				MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
				MTT.PartTranDetails.Remarks="Debiting BPPIA"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
				BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
				#print(BANCS.OUTPUT.PartTranNum)
				PRINT(MTT.PartTranDetails.RefAmount)
				PRINT(MTT.PartTranDetails.Account)
				sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
				IF(MTT.InputDetails.islSchProd != "K") THEN
				#{
					sv_a = MTT.InputDetails.depAcid
					sv_q = "poolCode|"
					sv_q = sv_q + " SELECT POOL_CODE FROM TBAADM.ILPPT "
					sv_q = sv_q + " WHERE SCHM_CODE = ( "
					sv_q = sv_q + " 	SELECT SCHM_CODE FROM TBAADM.GAM "
					sv_q = sv_q + " 	WHERE ACID = ?SVAR "
					sv_q = sv_q + " 	AND BANK_ID = ?SVAR "
					sv_q = sv_q + " ) "
					sv_q = sv_q + " AND BANK_ID = ?SVAR "
					sv_q = sv_q + " AND ENTITY_CRE_FLG = 'Y' "
					sv_q = sv_q + " AND DEL_FLG != 'Y' "
					BANCS.INPARAM.BINDVARS = sv_a + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
					sv_r = urhk_dbSelectWithBind(sv_q)
					sv_p = BANCS.OUTPARAM.poolCode
					
					sv_q = "bankProfShrBacid|"
					sv_q = sv_q + " SELECT BANK_PROF_SHARE_BACID FROM TBAADM.ILPGT "
					sv_q = sv_q + " WHERE POOL_CODE = ?SVAR "
					sv_q = sv_q + " AND BANK_ID = ?SVAR "
					sv_q = sv_q + " AND ENTITY_CRE_FLG = 'Y' "
					sv_q = sv_q + " AND DEL_FLG != 'Y' "
					BANCS.INPARAM.BINDVARS = sv_p + "|" + BANCS.STDIN.contextBankId
					sv_r = urhk_dbSelectWithBind(sv_q)
					
					sv_q = "profShrAcct|"
					sv_q = sv_q + " SELECT FORACID FROM TBAADM.GAM "
					sv_q = sv_q + " WHERE BACID = ?SVAR "
					sv_q = sv_q + " AND SOL_ID = ?SVAR "
					sv_q = sv_q + " AND ACCT_CRNCY_CODE = ?SVAR "
					sv_q = sv_q + " AND BANK_ID = ?SVAR "
					sv_q = sv_q + " AND ENTITY_CRE_FLG = 'Y' "
					sv_q = sv_q + " AND DEL_FLG != 'Y' "
					
					sv_v = BANCS.OUTPARAM.bankProfShrBacid + "|" + BANCS.STDIN.mySolId
					sv_v = sv_v + "|" + MTT.InputDetails.acctCrncyCode
					sv_v = sv_v + "|" + BANCS.STDIN.contextBankId
					BANCS.INPARAM.BINDVARS = sv_v
					sv_r = urhk_dbSelectWithBind(sv_q)
					sv_e = BANCS.OUTPARAM.profShrAcct
					
					IF ((sv_e != "") AND (CDOUBLE(MTT.InputDetails.prefProfAmt) != 0)) THEN
					#{
						MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Profit at Pref Rate"
						MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
						MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
						MTT.PartTranDetails.Account=sv_e
						MTT.PartTranDetails.RefAmount= -1 * CDOUBLE(MTT.InputDetails.prefProfAmt)
						MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
						MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
						#print(MTT.PartTranDetails.RateCode)
						MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
						MTT.PartTranDetails.Remarks="Debiting Shareholders Account"
						MTT.PartTranDetails.Consolidate="N"
						MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
						BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
						#print(BANCS.OUTPUT.PartTranNum)
						PRINT(MTT.PartTranDetails.RefAmount)
						PRINT(MTT.PartTranDetails.Account)
						sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			IF(MTT.InputDetails.freqBasedProdFlg == "Y") THEN
			#{
				# MPPIA adjustment in case of Frequency based
				#{
				IF(CDOUBLE(MTT.InputDetails.totPayoutAmt) != 0 ) THEN
				#{
					MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Adjustment of profit paid in advance"
					MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.Account=MTT.InputDetails.mppiaAcct
					MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.InputDetails.totPayoutAmt)
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
					MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
					MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
					MTT.PartTranDetails.Remarks="Crediting MPPIA"
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
					BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
					#print(BANCS.OUTPUT.PartTranNum)
					PRINT(MTT.PartTranDetails.RefAmount)
					PRINT(MTT.PartTranDetails.Account)
					sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
				#}
				ENDIF
				IF(MTT.InputDetails.islSchProd != "K") THEN
				#{
					IF(CDOUBLE(MTT.InputDetails.ParkAmt) != 0 ) THEN
					#{
						MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Movement of Profit Amt from Payable to Deposit A/c OR Repayment A/c "
						MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
						MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
						MTT.PartTranDetails.Account=MTT.InputDetails.tempacctPayable
						MTT.PartTranDetails.RefAmount=-1 * CDOUBLE(MTT.InputDetails.ParkAmt)
						MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
						MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
						MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
						MTT.PartTranDetails.Remarks="Parked Amt Adjustment"
						MTT.PartTranDetails.Consolidate="N"
						MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
						BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
						#print(BANCS.OUTPUT.PartTranNum)
						PRINT(MTT.PartTranDetails.RefAmount)
						PRINT(MTT.PartTranDetails.Account)
						sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
						
					#}
					ENDIF
					IF(CDOUBLE(MTT.InputDetails.PrefAmt) != 0 ) THEN
					#{
						MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Movement of preferential profit Amt from Sundry to Deposit A/c OR Repayment A/c "
						MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
						MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
						MTT.PartTranDetails.Account=MTT.InputDetails.sundryAcct
						MTT.PartTranDetails.RefAmount=-1 * CDOUBLE(MTT.InputDetails.PrefAmt)
						MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
						MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
						MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
						MTT.PartTranDetails.Remarks="Pref Amt Adjustment"
						MTT.PartTranDetails.Consolidate="N"
						MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
						BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
						PRINT(MTT.PartTranDetails.RefAmount)
						PRINT(MTT.PartTranDetails.Account)
						sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			IF (CDOUBLE(MTT.InputDetails.RecoveryAmt)!= 0 ) THEN
			#{
				MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Recovery Amt for previous PD cycle"
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.sundryAcct
				MTT.PartTranDetails.RefAmount = CDOUBLE(MTT.InputDetails.RecoveryAmt)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
				MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
				MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
				MTT.PartTranDetails.Remarks="Crediting Other Interest Account"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
				BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
				PRINT(MTT.PartTranDetails.RefAmount)
				PRINT(MTT.PartTranDetails.Account)
				sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
			#}
			ENDIF
			IF((MTT.InputDetails.matClsPayFlg == "I") AND (MTT.InputDetails.ProdLevelMatClsPayFlg == "A")) THEN
			#{
				IF(CDOUBLE(MTT.InputDetails.penAmt) != 0 ) THEN
				#{
					MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Penalty for Closure at Indicative Rate"
					MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.Account=MTT.InputDetails.nrmlPandlAcct
					MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.InputDetails.penAmt)
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
					MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
					MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
					MTT.PartTranDetails.Remarks="Crediting P&L"
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
					BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
					PRINT(MTT.PartTranDetails.RefAmount)
					PRINT(MTT.PartTranDetails.Account)
					sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
				#}
				ENDIF
			#}
			ENDIF
			
			#Credit Part Tran Sundry
			IF(MTT.InputDetails.ageEligible == "N") THEN
			#{
				MTT.PartTranDetails.Particulars=MTT.InputDetails.repayAcct+" : Broken period profit ON closure"
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.sundryAcct
				MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.InputDetails.bpProfit) + CDOUBLE(MTT.InputDetails.payableAmt) + CDOUBLE(MTT.InputDetails.prefProfAmt)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
				MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
				MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
				MTT.PartTranDetails.Remarks="Crediting sundry"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
				BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
				PRINT(MTT.PartTranDetails.RefAmount)
				PRINT(MTT.PartTranDetails.Account)
				sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
			#}
			ENDIF
			MTT.PartTranDetails.Particulars=MTT.InputDetails.repayAcct+" : Customer payout"
			MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
			MTT.PartTranDetails.Account=MTT.InputDetails.repayAcct
			IF(MTT.InputDetails.freqBasedProdFlg == "N") THEN
			#{
				MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.InputDetails.repayAmt)
				#}
			ELSE
				#{
				IF(MTT.InputDetails.islSchProd != "K") THEN
				#{
					MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.InputDetails.repayAmt) - CDOUBLE(MTT.InputDetails.RecoveryAmt) - CDOUBLE(MTT.InputDetails.totPayoutAmt) + CDOUBLE(MTT.InputDetails.ParkAmt)+ CDOUBLE(MTT.InputDetails.PrefAmt)
					#}
				ELSE
					#{
					MTT.PartTranDetails.RefAmount=CDOUBLE(MTT.InputDetails.repayAmt) + CDOUBLE(MTT.InputDetails.prefProfAmt)- CDOUBLE(MTT.InputDetails.RecoveryAmt) - CDOUBLE(MTT.InputDetails.totPayoutAmt)
				#}
				ENDIF
			#}
			ENDIF
			IF((MTT.InputDetails.matClsPayFlg == "I") AND (MTT.InputDetails.ProdLevelMatClsPayFlg == "A")) THEN
			#{
				MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.PartTranDetails.RefAmount) - CDOUBLE(MTT.InputDetails.penAmt)
			#}
			ENDIF
			IF(MTT.InputDetails.ageEligible != "N") THEN
			#{
				MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.PartTranDetails.RefAmount) + CDOUBLE(MTT.InputDetails.bpProfit) + CDOUBLE(MTT.InputDetails.payableAmt) + CDOUBLE(MTT.InputDetails.prefProfAmt)
			#}
			ENDIF
			
			IF(MTT.InputDetails.PartitionedAcct == "Y") THEN
			#{
				MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.depAcct
				MTT.PartTranDetails.ACPARTB2kType="ACCNT"
			#}
			ENDIF
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
			MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
			MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
			MTT.PartTranDetails.Remarks="Crediting Customer"
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
			BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
			#print(BANCS.OUTPUT.PartTranNum)
			CUST.WITHTAX.RefAmount = MTT.PartTranDetails.RefAmount
			PRINT(MTT.PartTranDetails.RefAmount)
			PRINT(MTT.PartTranDetails.Account)
			sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
			###############################################################################
			# Customization for collection of With Holding Tax Starts
			###############################################################################
			#################################################################
			# Getting value for "DEP_INSTALL_PAYOUT_FLG" from GSP table
			#################################################################
			BANCS.INPARAM.BINDVARS = ""
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + MTT.InputDetails.repayAcct + "|" + BANCS.STDIN.contextBankId+ "|" + BANCS.STDIN.contextBankId
			
			sv_s = "dep_install_payout_flg |SELECT DEP_INSTALL_PAYOUT_FLG"
			sv_s = sv_s + " FROM TBAADM.GSP"
			sv_s = sv_s + " WHERE  SCHM_CODE = ( SELECT SCHM_CODE FROM GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR)"
			sv_s = sv_s + " AND   BANK_ID = ?SVAR"
			sv_s = sv_s + " AND NVL(DEL_FLG,'N') = 'N'"
			
			PRINT(sv_s)
			sv_v = urhk_dbselectWithBind(sv_s)
			PRINT(sv_v)
			IF(sv_v == 0) THEN
			#{
				CUST.WITHTAX.dep_install_payout_flg = BANCS.OUTPARAM.dep_install_payout_flg
				PRINT(CUST.WITHTAX.dep_install_payout_flg)
				#}
			ELSE
				#{
				BANCS.OUTPUT.successOrFailure ="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			PRINT(CUST.WITHTAX.RefAmount)
			PRINT(MTT.InputDetails.repayAmt)
			PRINT(CUST.WITHTAX.dep_install_payout_flg)
			IF(CUST.WITHTAX.dep_install_payout_flg != "O") THEN
			#{
				CUST.WITHTAX.tranAmt = CDOUBLE(CUST.WITHTAX.RefAmount) - CDOUBLE(MTT.InputDetails.repayAmt)
				PRINT(CUST.WITHTAX.tranAmt)
				PRINT(MTT.InputDetails.repayAcct)
				PRINT(MTT.InputDetails.rateCode)
				PRINT(MTT.InputDetails.repRate)
				CUST.WITHTAX.drAccount				= 	MTT.InputDetails.repayAcct
				CUST.WITHTAX.wthFlgChkAcct			=   MTT.InputDetails.depAcct
				#CUST.WITHTAX.RateCode 				= 	MTT.InputDetails.rateCode
				CUST.WITHTAX.RateCode				=   ""
				CUST.WITHTAX.Rate		    	    = 	MTT.InputDetails.repRate
				CUST.WITHTAX.tranIdentifier			=   "ClosureTransaction"
				IF(CDOUBLE(CUST.WITHTAX.tranAmt)>0) THEN
				#{
					CALL("wthmn037.scr")
				#}
				ENDIF
			#}
			ENDIF
			###############################################################################
			# Customization for collection With Holding Tax Ends
			###############################################################################
			CUSTOMEND1:
				MTT.OutputDetails.maxTrans=CINT(MTT.OutputDetails.maxTrans) + 1
				
				sv_r = urhk_MTTS_EndDefinition("")
				#}
				# Transaction for Closure Starts here
				#}
			ELSE
				#{
				# Maturity closure at ACTUAL rate
				
				# Transaction for Closure Starts here
				#{
				MTT.TranDetails.TranDate="0"
				MTT.TranDetails.TranType="T"
				MTT.TranDetails.TranSubType="BI"
				MTT.TranDetails.Remarks="ACCOUNT CLOSURE TRANSACTION"
				MTT.TranDetails.IgnoreExcp="I"
				MTT.TranDetails.Consolidate="N"
				MTT.TranDetails.InitSolId=BANCS.STDIN.mySolId
				MTT.TranDetails.RestrictModifyInd="1"
				MTT.TranDetails.EventType="TDCLS"
				MTT.PartTranDetails.Refnum=""
				
				sv_r=urhk_MTTS_DefineTransaction("ClosureTransaction")
				MTT.OutputDetails.OVDUECRAccount=""
				MTT.OutputDetails.INTAMTToPARKAccount=0
				MTT.OutputDetails.tdForacid=MTT.InputDetails.tdForacid
				MTT.OutputDetails.acctCrncyCode=MTT.InputDetails.acctCrncyCode
				MTT.OutputDetails.homeCrncyCode=MTT.InputDetails.homeCrncyCode
				MTT.OutputDetails.valueDate=MTT.InputDetails.clsValueDate
				MTT.OutputDetails.tranDate=BANCS.STDIN.BODDate
				BANCS.OUTPUT.PartTranNum="0"
				sv_h=MTT.InputDetails.homeCrncyCode
				MTT.PartTranDetails.Refnum="          "+MTT.InputDetails.flowCode
				MTT.PartTranDetails.Acoount=MTT.InputDetails.tdForacid
				
				
				MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Principal Closure"
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.depAcct
				MTT.PartTranDetails.RefAmount= -1 * CDOUBLE(MTT.InputDetails.repayAmt)
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
				MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
				MTT.PartTranDetails.Rate = MTT.InputDetails.repRate
				MTT.PartTranDetails.Remarks="Debiting Deposit Acct"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="ClosureTransaction"
				BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
				#print(BANCS.OUTPUT.PartTranNum)
				PRINT(MTT.PartTranDetails.RefAmount)
				PRINT(MTT.PartTranDetails.Account)
				sv_r=urhk_MTTS_DefinePartTran("ClosureTransaction")
				
				IF((CDOUBLE(MTT.InputDetails.bpProfit) != 0) AND (MTT.InputDetails.islSchProd == "K")) THEN
				#{
					MTT.PartTranDetails.Particulars     = MTT.InputDetails.depAcct+" : Broken period profit ON closure"
					MTT.PartTranDetails.ReportCode      = MTT.InputDetails.intPaidRptCode
					MTT.PartTranDetails.ValueDate       = MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.Account         = MTT.InputDetails.bppiaAcct
					MTT.PartTranDetails.RefAmount       = -1 * CDOUBLE(MTT.InputDetails.bpProfit)
					MTT.PartTranDetails.RefCurrency     = MTT.InputDetails.acctCrncyCode
					MTT.PartTranDetails.RateCode        = MTT.InputDetails.rateCode
					MTT.PartTranDetails.Rate            = MTT.InputDetails.repRate
					MTT.PartTranDetails.Remarks         = "Debiting BPPIA"
					MTT.PartTranDetails.Consolidate     = "N"
					MTT.PartTranDetails.TranIdentifier  = "ClosureTransaction"
					BANCS.OUTPUT.PartTranNum            = CINT(BANCS.OUTPUT.PartTranNum) + 1
					
					sv_r = urhk_MTTS_DefinePartTran("ClosureTransaction")
				#}
				ENDIF
				
				MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Customer payout"
				MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
				MTT.PartTranDetails.Account=MTT.InputDetails.repayAcct
				IF(MTT.InputDetails.islSchProd == "K") THEN
				#{
					MTT.PartTranDetails.RefAmount = CDOUBLE(MTT.InputDetails.repayAmt) + CDOUBLE(MTT.InputDetails.bpProfit)
					#}
				ELSE
