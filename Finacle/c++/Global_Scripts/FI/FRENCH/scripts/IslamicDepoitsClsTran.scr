					MTT.OutputDetails.tranDate=BANCS.STDIN.BODDate
					BANCS.OUTPUT.PartTranNum="0"
					sv_h=MTT.InputDetails.homeCrncyCode
					MTT.PartTranDetails.Refnum="          "+MTT.InputDetails.flowCode
					MTT.PartTranDetails.Acoount=MTT.InputDetails.tdForacid
					
					#Debit Part Transactions for Booking Reversal starts here
					MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Booking Reversal ON closure"
					MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.Account=MTT.InputDetails.nrmlIntPaidAcct
					MTT.PartTranDetails.RefAmount= -1 * CDOUBLE(MTT.InputDetails.bookedPrNotAppl)
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
					MTT.PartTranDetails.Remarks="Debiting Profit Payabable Acct"
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="ClsBookingReversal"
					BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
					#print(BANCS.OUTPUT.PartTranNum)
					PRINT(MTT.PartTranDetails.RefAmount)
					PRINT(MTT.PartTranDetails.Account)
					sv_r=urhk_MTTS_DefinePartTran("BookingReversal")
					
					
					#CREDIT Part Transactions for Booking Reversal starts here
					MTT.PartTranDetails.Particulars=MTT.InputDetails.depAcct+" : Booking Reversal ON closure"
					MTT.PartTranDetails.ReportCode=MTT.InputDetails.intPaidRptCode
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
					MTT.PartTranDetails.Account=MTT.InputDetails.nrmlPandlAcct
					MTT.PartTranDetails.RefAmount= CDOUBLE(MTT.InputDetails.bookedPrNotAppl)
					MTT.PartTranDetails.RefCurrency=MTT.InputDetails.acctCrncyCode
					MTT.PartTranDetails.Remarks="Crediting P&L Acct"
					MTT.PartTranDetails.Consolidate="N"
					MTT.PartTranDetails.TranIdentifier="ClsBookingReversal"
					BANCS.OUTPUT.PartTranNum=CINT(BANCS.OUTPUT.PartTranNum) + 1
					#print(BANCS.OUTPUT.PartTranNum)
					PRINT(MTT.PartTranDetails.RefAmount)
					PRINT(MTT.PartTranDetails.Account)
					sv_r=urhk_MTTS_DefinePartTran("BookingReversal")
					
					MTT.OutputDetails.maxTrans=CINT(MTT.OutputDetails.maxTrans) + 1
					MTT.OutputDetails.revTranExists="Y"
					sv_r = urhk_MTTS_EndDefinition("")
				#}
				ENDIF
				#Part Transactions for Booking Reversal END here
				#}
