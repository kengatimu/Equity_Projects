	CUST.SLAMNT.error_file = CUST.SLAMNT.empID + "_Salary_Processor_" + CUST.SLAMNT.sysdate + ".ERR"
	CUST.SLAMNT.suc_file = CUST.SLAMNT.empID + "_Salary_Processor_" + CUST.SLAMNT.sysdate + ".SUC"
	
	sv_a = "test -f " + CUST.SLAMNT.error_file
	sv_r = SYSTEM(sv_a)
	PRINT(sv_r)
	IF(sv_r == 0) THEN
	#{
		sv_a = SYSTEM("rm -f " + CUST.SLAMNT.error_file)
	#}
	ENDIF
	
	sv_a = "test -f " + CUST.SLAMNT.suc_file
	sv_r = SYSTEM(sv_a)
	PRINT(sv_r)
	IF(sv_r == 0) THEN
	#{
		sv_a = SYSTEM("rm -f " + CUST.SLAMNT.suc_file)
	#}
	ENDIF
	
	sv_u = urhk_getFileLocation("COM|ebkSalProof.com")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		#----------------------------------------------------------------------------------
		#---    Setting Env variables
		#----------------------------------------------------------------------------------
		sv_a = "sqlInput|" + CUST.SLAMNT.empID + "," + BANCS.STDIN.userId + "," + BANCS.STDIN.contextBankId + "," + CUST.SLAMNT.sysdate
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.SLAMNT.errorMsg = "Error in setting env variable fileName"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "fileName|" + CUST.SLAMNT.empID + "_" + CUST.SLAMNT.sysdate
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.SLAMNT.errorMsg = "Error in setting env variable fileName"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "drAcctCrncy|" + CUST.SLAMNT.drAcctCrncy
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.SLAMNT.errorMsg = "Error in setting env variable drAcctCrncy"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "inputFilePath|" + CUST.SLAMNT.upldPath + CUST.SLAMNT.fileName
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.SLAMNT.errorMsg = "Error in setting env variable drAcctCrncy"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_a = "bankId|" + BANCS.STDIN.contextBankId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.SLAMNT.errorMsg = "Error in setting env variable drAcctCrncy"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------
		#---    Executing com file in background
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.scriptName = "ebkSalProof.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.SLAMNT.errorMsg = "Upload process failed please retry"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.SLAMNT.errorMsg = "Unable to load com file"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
