<--START
CHECKSUM="64c3c2fe5ab0d352c4f3ec4420a7d1317dca72e7cc22642e6f9f02eef869219c"
	TRACE ON
	
	CUST.SLAMNT.Suspence = "N"
	CUST.SLAMNT.Error_num = 0
	
	sv_s = "sysdate|SELECT to_char(SYSDATE,'ddmmyyyyhhmiss') FROM DUAL"
