#----------------------------------------------------------------------------------------------------------
# Filename              :       OutwardRejectUpl_ValidateInputDetails.scr
# Description           :       This script validates the value passed in Request XML
# Input                 :       
# Output                :       None
# Called Script         :       OutwardRejectUpl_main.scr
# Calling Script        :       None
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           20-06-2013      	   Anik Soni         Original Version         1.0
#---------------------------------------------------------------------------------
<--START
TRACE ON

	#---------------------------------------------------------------------------------
	# Validating the Reject Reason Code 
	#---------------------------------------------------------------------------------
	CUST.INTERFACE.RejCode = CUST.INTERFACE.RejResCode
	print(CUST.INTERFACE.RejCode)

	lv_q = "count|SELECT count(*)"
	lv_q = lv_q + " FROM TBAADM.CRC"
	lv_q = lv_q + " WHERE CLG_REJ_CODE = '" + CUST.INTERFACE.RejResCode + "'"
	lv_q = lv_q + " AND DEL_FLG = 'N' "
	lv_q = lv_q + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "'"
	
	lv_e = urhk_dbSelectWithBind(lv_q)
	lv_p=BANCS.OUTPARAM.count
	
	IF(lv_p == 0)THEN
	#{
		CUST.INTERFACE.errorCode = "ERR087" 
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ENDIF

	#---------------------------------------------------------------------------------
	# Validating the Cr Account(Customer Account)
	#---------------------------------------------------------------------------------
	sv_b = urhk_getAcctDetailsInRepository(CUST.INTERFACE.CrAcct)
	IF(sv_b == 1) THEN
	#{
		CUST.INTERFACE.errorCode = "ERR068"
		CUST.INTERFACE.successOrFailure = "F"
		GOTO FINISH
	#}
	ELSE
	#{	
		#---------------------------------------------------------------------------------
		# Getting the Account Closed Flag for Customer Account (Cr. Account)
		#---------------------------------------------------------------------------------
		lv_i = BANCS.OUTPARAM.acctCloseflg

		#---------------------------------------------------------------------------------
		# Getting the Freeze Code for Customer Account (Cr. Account)
		#---------------------------------------------------------------------------------
		lv_m = BANCS.OUTPARAM.freezeCode

		#---------------------------------------------------------------------------------
		# Getting the Scheme Code and Scheme type of Customer Account (Cr. Account)
		#---------------------------------------------------------------------------------
		CUST.INTERFACE.CrSchmCode = BANCS.OUTPARAM.schmCode
		CUST.INTERFACE.CrSchmType = BANCS.OUTPARAM.schmType

		CUST.INTERFACE.acctBalance = BANCS.OUTPARAM.EffAvailableAmt
		print(CUST.INTERFACE.acctBalance)
		CUST.INTERFACE.solId = BANCS.OUTPARAM.acctSolId
		print(CUST.INTERFACE.solId)
		lv_s = "bankCode|"
		lv_s = lv_s + "SELECT BANK_CODE FROM TBAADM.SOL "
		lv_s = lv_s + " WHERE SOL_ID ='"+CUST.INTERFACE.solId+"'"
		lv_s = lv_s + " AND BANK_ID = '" + BANCS.STDIN.contextBankId + "'"
		print(lv_s)
		lv_d = urhk_dbSelectWithBind(lv_s)

		IF(lv_d == 0)THEN
		#{
			CUST.INTERFACE.bankCode = BANCS.OUTPARAM.bankCode
			print(CUST.INTERFACE.bankCode)
		#}
		ENDIF

		#---------------------------------------------------------------------------------
		#Getting the acid for Cr Account
		#---------------------------------------------------------------------------------
		lv_a = urhk_B2k_ForacidToAcid(CUST.INTERFACE.CrAcct)

		IF(lv_a == 0) THEN
		#{
			 CUST.INTERFACE.CrAcid = BANCS.OUTPARAM.Acid
		#}
		ENDIF

		#---------------------------------------------------------------------------------
		# Checking if the Customer Account is closed or there is a Credit or Total
		# Freeze on the account
		#---------------------------------------------------------------------------------
		IF((lv_i == "Y")) THEN
		#{
			CUST.INTERFACE.errorCode = "ERR051"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH
		#}
		ENDIF

		IF ((lv_m == "C") OR (lv_m == "T") OR (lv_m == 'D')) THEN
		#{
			CUST.INTERFACE.errorCode = "ERR061"
			CUST.INTERFACE.successOrFailure = "F"
			GOTO FINISH	
		#}
		ENDIF

		#---------------------------------------------------------------------------------
		# Checking if the Customer Account is Dormant or Inactive
		#---------------------------------------------------------------------------------
		BANCS.INPARAM.acid=CUST.INTERFACE.CrAcid
		lv_y = urhk_getAcctStatus("")

		IF(lv_y==0) THEN
		#{
			lv_i = BANCS.OUTPARAM.acctStatus
			IF( (lv_i == "D") OR (lv_i == "I") ) THEN
			#{
				CUST.INTERFACE.errorCode = "ERR062"
				CUST.INTERFACE.successOrFailure = "F"
				GOTO FINISH	
			#}
			ENDIF
		#}
		ENDIF
	  #}
	  ENDIF

	
END-->
