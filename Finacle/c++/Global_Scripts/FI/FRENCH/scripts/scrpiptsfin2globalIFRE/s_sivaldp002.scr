#------------------------------------------------------------------------------------------------    
#    Name			 : s_sivaldp002.scr
#    Description     : The script is used to check for the given scheme code during debit transaction customer is treated as staff. 
#					 : If tran type is .C. and credit account is office account, then it is treated as an external SI. When it is an external SI 
#					 : and tran type is credit, tran particular should not be entered, else tran particular should be entered. 
#					 : During Insurance premium, ref num field is made mandatory and tran particulars details are being populated from C_CIC custom table 
#					 : and validates the reference amount to be multiple of 5 cents. 
#    Date            : 13-02-2013
#    Author          : Divya 
#    Input           : NA
#    Output			 : NA
#    Called Script	 : NA
#    Calling Script	 : getcparamvalue.scr 
#    Menu Option	 : HSIM, HSSIM 
#    Srl. No			Date			Author			Description.   
#    ------			----------			-------			---------------			
#    1.0			13-02-2013			Divya			Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#	Creating repository and class
#	Initializing the variables
# 	Getting all the values from CPARAM  
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","SIVAL1") == 0) THEN
#{
    CREATECLASS("CUST","SIVAL1",5)
#}
ENDIF

CUST.SIVAL1.errMsg		= ""
CUST.SIVAL1.noOfRecords	= ""
CUST.SIVAL1.schmCode	= ""
CUST.SIVAL1.acctNum		= ""
CUST.SIVAL1.var1		= ""
CUST.SIVAL1.var2		= ""
CUST.SIVAL1.foracid1	= ""
CUST.SIVAL1.external	= ""
CUST.SIVAL1.srlNum		= ""
CUST.SIVAL1.staff       = ""

BANCS.INPUT.moduleName  = "SIVAL1"
BANCS.INPUT.parameterId = "SIVAL1_SC"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.SIVAL1.schmCode = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.SIVAL1.errMsg = "Scheme Code setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "SIVAL1_ACCTNUM"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
    CUST.SIVAL1.acctNum = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.SIVAL1.errMsg = "Account Number setup not done CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF



#-------------------------------------------------------------------------------------------------------
# Get the number of accounts
#-------------------------------------------------------------------------------------------------------
sv_u = urhk_SRV_NumOfRecs("partInstrLL")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	CUST.SIVAL1.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.SIVAL1.noOfRecords)
#}
ELSE
#{
	CUST.SIVAL1.errMsg = "Error:urhk_SRV_NumOfRecs failed"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_l = 0 
sv_m = 0
sv_a = "" 
sv_b = 0
sv_c = "" 
sv_e = 0
sv_f = "" 
sv_g = 0
sv_h = "" 
sv_i = 0
sv_j = ""
sv_k = 0 
WHILE (sv_l < CUST.SIVAL1.noOfRecords)
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"
	PRINT(sv_r)

	sv_u = Format$(sv_m,"%d")
    sv_t = "<rec_"+sv_u+">"
	PRINT(sv_t)				
	#-------------------------------------------------------------------------------------------
	# Fetch PartTranType 
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".partInstruction.partTranType.code")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.SIVAL1.code = BANCS.OUTPARAM.srvValue
		PRINT(CUST.SIVAL1.code)
	#}
	ELSE
	#{
		CUST.SIVAL1.errMsg = "Error: urhk_SRV_GetVal failed for PartTranType"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
    #-------------------------------------------------------------------------------------------
    # Fetch Foracid 
    #-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".prDetail.acct.foracid")
    PRINT(sv_u)
	IF (sv_u == 0) THEN
    #{
      	CUST.SIVAL1.foracid = BANCS.OUTPARAM.srvValue 
		PRINT(CUST.SIVAL1.foracid)
    #}
    ELSE
    #{
		CUST.SIVAL1.errMsg = "Error: urhk_SRV_GetVal failed for Foracid"
        GOTO ENDOFSCRIPT
    #}
    ENDIF

    #-------------------------------------------------------------------------------------------
    # Fetch Particulars
    #-------------------------------------------------------------------------------------------
    sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".prDetail.tranParticulars")
    PRINT(sv_u)
    IF (sv_u == 0) THEN
    #{
        CUST.SIVAL1.tranPart = BANCS.OUTPARAM.srvValue
        PRINT(CUST.SIVAL1.tranPart)
    #}
    ELSE
    #{
		CUST.SIVAL1.errMsg = "Error: urhk_SRV_GetVal failed for TranParticular"
        GOTO ENDOFSCRIPT
    #}
    ENDIF

    #-------------------------------------------------------------------------------------------
    # Fetch Key serial number 
    #-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".key.serial_num")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.SIVAL1.srlNum =	BANCS.OUTPARAM.srvValue
		PRINT(CUST.SIVAL1.srlNum)
	#}
	ELSE
	#{
		CUST.SIVAL1.errMsg = "Error: urhk_SRV_GetVal failed for serial number"
		GOTO ENDOFSCRIPT
	#}	
	ENDIF

    #-------------------------------------------------------------------------------------------
    # Fetch Reference Number 
    #-------------------------------------------------------------------------------------------
    sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".prDetail.refNum")
    PRINT(sv_u)
    IF (sv_u == 0) THEN
    #{
        CUST.SIVAL1.refNo = BANCS.OUTPARAM.srvValue
        PRINT(CUST.SIVAL1.refNo)
    #}
    ELSE
    #{
		CUST.SIVAL1.errMsg = "Error: urhk_SRV_GetVal failed for Reference Number"
        GOTO ENDOFSCRIPT
    #}
    ENDIF

	#-------------------------------------------------------------------------------------------
	# Fetch Fixed Amount
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".partInstruction.fixedAmt")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
    #{
		CUST.SIVAL1.tranAmt = BANCS.OUTPARAM.srvValue
		PRINT(CUST.SIVAL1.tranAmt)
	#}
	ELSE
	#{
		CUST.SIVAL1.errMsg = "Error: urhk_SRV_GetVal failed for Tran Amount"
        GOTO ENDOFSCRIPT
	#}
	ENDIF

	PRINT(CUST.SIVAL1.code)
	PRINT(CUST.SIVAL1.foracid)
	IF ((CUST.SIVAL1.code != "") AND (CUST.SIVAL1.foracid != "")) THEN
	#{
		sv_u = urhk_getAcctDetailsInRepository(CUST.SIVAL1.foracid)
		PRINT(sv_u)
		IF (sv_u ==0) THEN
		#{
			IF (CUST.SIVAL1.code == "C") THEN
			#{
				CUST.SIVAL1.crcust = BANCS.OUTPARAM.custId
				PRINT(CUST.SIVAL1.crcust)
			#}
			ELSE
			#{
				CUST.SIVAL1.drcust = BANCS.OUTPARAM.custId
				PRINT(CUST.SIVAL1.drcust)
			#}
			ENDIF
			CUST.SIVAL1.schm = BANCS.OUTPARAM.schmCode
			PRINT(CUST.SIVAL1.schm)
			PRINT(CUST.SIVAL1.schmCode)
			IF ((CUST.SIVAL1.schm == CUST.SIVAL1.schmCode) AND (CUST.SIVAL1.code == "D")) THEN
			#{
				CUST.SIVAL1.staff = "Y"
			#}
			ENDIF
			PRINT(CUST.SIVAL1.staff)
		#}
		ENDIF
	#}
	ENDIF

	PRINT(BANCS.STDIN.contextBankId)
	IF ((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "43") OR (BANCS.STDIN.contextBankId == "11") OR (BANCS.STDIN.contextBankId == "50")) THEN
	#{
		CUST.SIVAL1.foracid1 = MID$(CUST.SIVAL1.foracid,3,10)
		PRINT(CUST.SIVAL1.foracid1)
	#}
	ELSE
	#{
		CUST.SIVAL1.foracid1 = MID$(CUST.SIVAL1.foracid,4,9)
		PRINT(CUST.SIVAL1.foracid1)
	#}
	ENDIF
	IF ((CUST.SIVAL1.code == "C") AND (CUST.SIVAL1.acctNum == CUST.SIVAL1.foracid1)) THEN
	#{
		CUST.SIVAL1.external = "Y"
	#}
	ENDIF
	PRINT(CUST.SIVAL1.external)

	PRINT(CUST.SIVAL1.acctNum)
	PRINT(CUST.SIVAL1.foracid1)
	PRINT(CUST.SIVAL1.code)
	PRINT(CUST.SIVAL1.tranPart)
	PRINT(CUST.SIVAL1.srlNum)
	IF ((CUST.SIVAL1.code == "C") AND (CUST.SIVAL1.acctNum == CUST.SIVAL1.foracid1) AND (TRIM(CUST.SIVAL1.tranPart) != "")) THEN
	#{
		sv_u = urhk_SRV_SetVal("partInstrLL." +sv_r+ ".prDetail.tranParticulars| ")
		PRINT(sv_u)	
		sv_a = sv_a + CUST.SIVAL1.srlNum + ","
		PRINT(sv_a)

		sv_b = sv_b + 1
		PRINT(sv_b)
	#}
	ENDIF

	PRINT(CUST.SIVAL1.acctNum)
	PRINT(CUST.SIVAL1.foracid1)
	PRINT(CUST.SIVAL1.srlNum)
	IF ((CUST.SIVAL1.acctNum != CUST.SIVAL1.foracid1) AND (CUST.SIVAL1.tranPart == "")) THEN
	#{
		PRINT(CUST.SIVAL1.srlNum)
		sv_c = sv_c + CUST.SIVAL1.srlNum + ","
		PRINT(sv_c)

		sv_e = sv_e + 1
	#}
	ENDIF

#----Inclusion for insuarance companies

	PRINT(CUST.SIVAL1.foracid)
	PRINT(BANCS.STDIN.contextBankId)
	IF (CUST.SIVAL1.code == "C") THEN
	#{
		sv_s = "count|"
		sv_s = sv_s + "SELECT COUNT(1) "
		sv_s = sv_s + "FROM CUSTOM.C_CIC "
		sv_s = sv_s + "WHERE acctnum = ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.SIVAL1.foracid + "|" + BANCS.STDIN.contextBankId
		sv_d =  urhk_dbselectWithBind(sv_s)
		PRINT(sv_d)
		CUST.SIVAL1.count = BANCS.OUTPARAM.count
		PRINT(CUST.SIVAL1.count)
		CUST.SIVAL1.tranPart = TRIM(CUST.SIVAL1.tranPart)
		PRINT(CUST.SIVAL1.tranPart)
		IF (CINT(CUST.SIVAL1.count) != 0) THEN
		#{
			PRINT(CUST.SIVAL1.refNo)
			IF (CUST.SIVAL1.refNo == "") THEN
			#{
				sv_f = sv_f + CUST.SIVAL1.srlNum + ","
				PRINT(sv_f)

				sv_g = sv_g + 1	
				PRINT(sv_g)		
			#}
			ELSE
			#{
				sv_s = "REFNUM,NAME|"
				sv_s = sv_s + "SELECT refnum,name "
				sv_s = sv_s + "FROM CUSTOM.C_CIC "
				sv_s = sv_s + "WHERE acctnum = ?SVAR "
				sv_s = sv_s + "AND refnum = ?SVAR "
				sv_s = sv_s + "AND del_flg = 'N'"
				sv_s = sv_s + "AND bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.SIVAL1.foracid + "|" + CUST.SIVAL1.refNo + "|" + BANCS.STDIN.contextBankId
				PRINT(sv_s)
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				IF (sv_d != 0) THEN
				#{
					sv_h = sv_h + CUST.SIVAL1.srlNum + ","
					PRINT(sv_h)

					sv_i = sv_i + 1
					PRINT(sv_i)
				#}
				ELSE
				#{
					CUST.SIVAL1.refNo = BANCS.OUTPARAM.REFNUM
					PRINT(CUST.SIVAL1.refNo)
					CUST.SIVAL1.name  = BANCS.OUTPARAM.NAME
					PRINT(CUST.SIVAL1.name)
					CUST.SIVAL1.var1  = "For " + CUST.SIVAL1.name + " Policy No. " + CUST.SIVAL1.refNo
					PRINT(CUST.SIVAL1.var1)
					sv_u = urhk_SRV_SetVal("partInstrLL." +sv_r+ ".prDetail.tranParticulars| " + CUST.SIVAL1.var1)
#					sv_u = urhk_SRV_SetVal()
					BANCS.OUTPUT.successOrFailure = "F"
			 	#}	
				ENDIF 
			#}
			ENDIF
		#}
		ENDIF 
	#}
	ENDIF

	PRINT(CUST.SIVAL1.tranAmt)
	CUST.SIVAL1.var2 = "."
	PRINT(CUST.SIVAL1.var2)
	CUST.SIVAL1.amt = LEFT$(CUST.SIVAL1.tranAmt,GETPOSITION(CUST.SIVAL1.tranAmt,"|") -1 )
	PRINT(CUST.SIVAL1.amt)
	CUST.SIVAL1.amtPos = getposition(CUST.SIVAL1.amt , CUST.SIVAL1.var2)
	PRINT(CUST.SIVAL1.amtPos)
	CUST.SIVAL1.amtLen = STRLEN(CUST.SIVAL1.amt)
	PRINT(CUST.SIVAL1.amtLen)
	CUST.SIVAL1.getVal = MID$(CUST.SIVAL1.amt,CINT(CUST.SIVAL1.amtPos),CINT(CUST.SIVAL1.amtLen))
	PRINT(CUST.SIVAL1.getVal)
	IF (CINT(CUST.SIVAL1.getVal) > 0) THEN
	#{
		CUST.SIVAL1.intNum = CINT(CUST.SIVAL1.getVal) / 5
		PRINT(CUST.SIVAL1.intNum)
		CUST.SIVAL1.doubNum = CDOUBLE(CUST.SIVAL1.getVal) / 5
		PRINT(CUST.SIVAL1.doubNum)
		IF (CDOUBLE(CUST.SIVAL1.doubNum) > CDOUBLE(CUST.SIVAL1.intNum)) THEN
		#{
			sv_j = sv_j + CUST.SIVAL1.srlNum + ","
	    		PRINT(sv_j)
	
	    		sv_k = sv_k + 1
			PRINT(sv_k)
	
			sv_u = urhk_SRV_SetVal("partInstrLL." +sv_r+ ".partInstruction.fixedAmt| ")
		#}
		ENDIF	
	#}
	ENDIF
sv_l = sv_l + 1
PRINT(sv_l)
#}
DO


IF (sv_b > 0) THEN
#{
	BANCS.OUTPUT.successOrFailure = "F"
	sv_a = RTRIM(sv_a,',')
	sv_a = "The Particulars field should be left blank for the part tran srl no : " + sv_a
	sv_u = urhk_SRV_SetErr(sv_a)	
#}
ENDIF

IF (sv_e  > 0) THEN
#{
	BANCS.OUTPUT.successOrFailure = "F"
	sv_c = RTRIM(sv_c,',')
	sv_c = "Please enter transacion particulars in the particulars field for the part tran srl no : " + sv_c
	sv_u = urhk_SRV_SetErr(sv_c)
#}
ENDIF

IF (sv_g > 0) THEN
#{
	BANCS.OUTPUT.successOrFailure = "F"
	sv_f = RTRIM(sv_f,',')
	sv_f = "Enter the ADMIN/REG/POLICY NO in the Ref Num field for the part tran srl no : " + sv_f
	sv_u = urhk_SRV_SetErr(sv_f)
#}
ENDIF


IF (sv_i > 0) THEN
#{
    BANCS.OUTPUT.successOrFailure = "F"
    sv_h = RTRIM(sv_h,',')
    sv_h = "Invalid ADMIN/REG/PLOCY number for the part tran srl no : " + sv_h
    sv_u = urhk_SRV_SetErr(sv_h)
#}
ENDIF

IF (sv_k > 0) THEN
#{
    BANCS.OUTPUT.successOrFailure = "F"
    sv_j = RTRIM(sv_j,',')
    sv_j = "Decimal value should be multiple of 5 cents for the part tran srl no : " + sv_j
    sv_u = urhk_SRV_SetErr(sv_j)
#}
ENDIF

ENDOFSCRIPT:

IF (CUST.SIVAL1.errMsg != "") THEN
#{
    sv_u = urhk_SRV_SetErr(CUST.SIVAL1.errMsg)
    BANCS.OUTPUT.successOrFailure = "F"
#}
ENDIF


TRACE OFF
EXITSCRIPT
END-->	
