	BANCS.INPARAM.BINDVARS = CUST.UPM.addUserId
	sv_s = "tempRoleId,expiryDate| "
	sv_s = sv_s + "SELECT TEMPORARY_ROLE_ID,TO_CHAR((TO_DATE(EXPIRY_DATE,'DD-MON-YY HH:MI:SS')), 'DD-MM-YYYY') "
