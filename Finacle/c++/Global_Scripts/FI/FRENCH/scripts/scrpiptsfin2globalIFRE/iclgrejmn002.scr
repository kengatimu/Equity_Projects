<--START
CHECKSUM="c2e63008f96531ba777cf04d0e28da45ba68015a6025af985e6e19b3a52965ef"
	TRACE ON
	#==========================================================*
	# CREATING NEW REPOSITORY AND CLASS
	#==========================================================*
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	print(BANCS.INPUT.foracid)
	print(BANCS.INPUT.instNo)
	print(BANCS.INPUT.instAmt)
	print(BANCS.INPUT.funcCode)
	
	CUST.DATA.foracid = BANCS.INPUT.foracid
	print(CUST.DATA.foracid)
	CUST.DATA.instNo= BANCS.INPUT.instNo
	print(CUST.DATA.instNo)
	CUST.DATA.instAmt = BANCS.INPUT.instAmt
	print(CUST.DATA.instAmt)
	CUST.DATA.funcCode= BANCS.INPUT.funcCode
	print(CUST.DATA.funcCode)
	
	
	
	##########################################################################################################
	# To validate account Number
	#########################################################################################################
	sv_s = "count|SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE foracid = ?SVAR"
	sv_s = sv_s + " AND del_flg ='N'"
	sv_s = sv_s + " AND entity_cre_flg = 'Y'"
	sv_s = sv_s + " AND acct_cls_flg ='N'"
	sv_s = sv_s + " AND bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
	sv_r = urhk_dbselectWithBind(sv_s)
	print(BANCS.INPARAM.BINDVARS)
	print (sv_r)
	sv_j = BANCS.OUTPARAM.count
	print(sv_j)
	IF (sv_j == 0 ) THEN
	#{
		sv_e = "Enter Valid Account Number"
		sv_m = "foracid"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO FINISH
		#}
	ELSE
		#{
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	#}
	ENDIF
	
	
	##########################################################################################################
	#The foll step is to Validate record in ICI
	##########################################################################################################
	
	CUST.DATA.date1 = LEFT$(BANCS.STDIN.BODDate,10)
	print(CUST.DATA.date1)
	
	
	sv_d = "v_day|SELECT to_char((to_date(?SVAR,'DD-MM-YYYY')),'DAY') from DUAL"
	
	BANCS.INPARAM.BINDVARS = CUST.DATA.date1
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_d)
	PRINT(sv_u)
	sv_e = trim(BANCS.OUTPARAM.v_day)
	print(sv_e)
	
	IF (sv_e == "MONDAY") THEN
	#{
		sv_t = (CUST.DATA.date1  + "|" + "0" + "|" + "-3")
