		sv_g = urhk_SetOrbOut(sv_z)
		print(sv_g)
		sv_z = "tranrmks" +"|"+ CUST.DATA.tranrmks + "|"
		sv_g = urhk_SetOrbOut(sv_z)
		print(sv_g)
		sv_z = "solId" +"|"+ CUST.DATA.solId + "|"
		sv_g = urhk_SetOrbOut(sv_z)
		print(sv_g)
