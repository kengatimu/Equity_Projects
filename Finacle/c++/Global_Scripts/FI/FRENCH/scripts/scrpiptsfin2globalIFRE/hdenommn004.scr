#----------------------------------------------------------------------------------------------------------
# Filename              :       hdenommn004.scr
# Author                :       Nitin Prabhakar
# Description           :       This is the script to validate criteria page and call script to fetch data for delete mode.
# Input                 :       crncyCode
# Output                :       None
# Called Script         :       hdenomdp002.scr
# Calling Script        :       None
#
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           03-05-2013         Nitin Prabhakar   original Version          1.0
#-----------------------------------------------------------------------------------------------------------
<--START
CHECKSUM="977abd7ee64ad4efa67d4fde171d77242ae88c9cafeb99bd922e672fa92d22e3"
	TRACE ON
	# In rak bank.
	# In DELETE mode, they are not validating that denomination value are still in use or not.
	
	# In this code flow,
	# we are validating before fetching for Deleting that denomination value are still in use or not.
	#------------------------------------------------------------------------------
	# Creation of  repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST", "DENOM", 5)
	#}
	ENDIF
	IF (CLASSEXISTS("CUST", "INTERFACE") == 0) THEN
	#{
		CREATECLASS("CUST", "INTERFACE", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#  Declaration of variables used in script
	#------------------------------------------------------------------------------
	CUST.DENOM.userId = TRIM(BANCS.STDIN.userId)
	print(CUST.DENOM.userId)
	CUST.DENOM.bankId = TRIM(BANCS.STDIN.contextBankId)
	print(CUST.DENOM.bankId)
	CUST.DENOM.funcCode = TRIM(BANCS.INPUT.funcCode)
	print(CUST.DENOM.funcCode)
	CUST.DENOM.crncyCode = TRIM(TOUPPER(BANCS.INPUT.crncyCode))
	print(CUST.DENOM.crncyCode)
	CUST.DENOM.crncyName = TRIM(BANCS.INPUT.crncyName)
	print(CUST.DENOM.crncyName)
	CUST.DENOM.decimalPointAllow = TRIM(BANCS.INPUT.decimalPointAllow)
	print(CUST.DENOM.decimalPointAllow)
	CUST.DENOM.successFlg = "S"
	#--------------------------------------------------------------------------------------
	# VALIDATE CURRENCY CODE
	#--------------------------------------------------------------------------------------
	sv_a = CUST.DENOM.crncyCode
	sv_u = urhk_B2k_valCrncy(sv_a)
	print(sv_u)
	IF (sv_u == 1) THEN
	#{
		# throwing error
		#CUST.DENOM.errorMsg = "Invalid Currency Code"
		CUST.INTERFACE.errorCode = "DENOM_ERR_001"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "crncyCode"
		CUST.DENOM.successFlg = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#--------------------------------------------------------------------------------------
	# Checking for currency Denomination already present or not.
	#--------------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.DENOM.crncyCode + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s = "counter|"
	sv_s = sv_s + " SELECT count(*) "
	sv_s = sv_s + " FROM CUSTOM.C_MDNM "
	sv_s = sv_s + " WHERE CRNCY_CODE = ?SVAR AND bank_id = ?SVAR "
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# throwing error
		#CUST.DENOM.errorMsg = "Oracle Error - Try after sometime."
		CUST.INTERFACE.errorCode = "DENOM_ERR_002"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "abc"
		CUST.DENOM.successFlg = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DENOM.counter = BANCS.OUTPARAM.counter
		print(CUST.DENOM.counter)
		IF (CUST.DENOM.counter == "0") THEN
		#{
			# throwing error
			#CUST.DENOM.errorMsg = "Denomination details not maintained for this Currency."
			CUST.INTERFACE.errorCode = "DENOM_ERR_004"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.DENOM.fieldName = "abc"
			CUST.DENOM.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	#--------------------------------------------------------------------------------------
	# Checking for any undeleted currency Denomination present or not.
	#--------------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.DENOM.crncyCode + "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|N"
	print(BANCS.INPARAM.BINDVARS)
	sv_t = " AND del_flg = ?SVAR"
	sv_s = sv_s + sv_t
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# throwing error
		#CUST.DENOM.errorMsg = "Oracle Error - Try after sometime."
		CUST.INTERFACE.errorCode = "DENOM_ERR_002"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "abc"
		CUST.DENOM.successFlg = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DENOM.counter = BANCS.OUTPARAM.counter
		print(CUST.DENOM.counter)
		IF (CUST.DENOM.counter == "0") THEN
		#{
			# throwing error
			#CUST.DENOM.errorMsg = "Record Already deleted."
			CUST.INTERFACE.errorCode = "DENOM_ERR_009"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.DENOM.fieldName = "abc"
			CUST.DENOM.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	#------------------------------------------------------------------------------
	# validating before Deleting, denomination value are still in use or not.
	#------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = "E"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.crncyCode + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_s="counter|"
	sv_s= sv_s + "SELECT COUNT(crncy_code) "
	sv_s= sv_s + " FROM CUSTOM.C_DETD "
	sv_s= sv_s + " WHERE DXFER_FLG =?SVAR "
	sv_s= sv_s + " AND CRNCY_CODE =?SVAR AND bank_id = ?SVAR"
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d != 0)THEN
	#{
		# throwing error
		#CUST.DENOM.errorMsg = "DataBase Error."
		CUST.INTERFACE.errorCode = "DENOM_ERR_006"
		CALL("Common_Interface_GetErrorDesc.scr")
		CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
		CUST.DENOM.fieldName = "abc"
		CUST.DENOM.successFlg = "F"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DENOM.counter = ""
		CUST.DENOM.counter = BANCS.OUTPARAM.counter
		print(CUST.DENOM.counter)
		IF(CINT(CUST.DENOM.counter)>0)THEN
		#{
			# throwing error
			#CUST.DENOM.errorMsg = "Transactions are in entered state cannot delete denomination"
			CUST.INTERFACE.errorCode = "DENOM_ERR_010"
			CALL("Common_Interface_GetErrorDesc.scr")
			CUST.DENOM.errorMsg = CUST.INTERFACE.errorDesc
			CUST.DENOM.fieldName = "abc"
			CUST.DENOM.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	#------------------------------------------------------------------------------
	# calling script to fetch data for detail page.
	#------------------------------------------------------------------------------
	CALL("hdenomdp002.scr")
	IF (CUST.DENOM.successFlg == "F") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.OUTPUT.SuccessOrFailure = "S"
	sv_w = ""
	sv_w = "SuccessOrFailure|Y"
	sv_u = urhk_SetOrbOut(sv_w)
	ENDOFSCRIPT:
		IF (CUST.DENOM.successFlg == "F") THEN
		#{
			sv_w = "SUCCESSORFAILURE|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_z = "Error_0|ERROR^" + CUST.DENOM.errorMsg + "^" + CUST.DENOM.fieldName
			sv_u = urhk_SetOrbOut(sv_z)
			CUST.DENOM.successFlg = "F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#----------------------------------------
		# deleting repositories and calsses.
		#----------------------------------------
		IF (CLASSEXISTS("CUST","DENOM") != 0) THEN
		#{
			DELETECLASS ("CUST","DENOM")
		#}
		ENDIF
		IF (REPEXISTS ("CUST") != 0) THEN
		#{
			DELETEREP ("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
