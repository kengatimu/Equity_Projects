CHECKSUM="19ecaf3c6bf6b489dd2b3092c8e6bd6ce9d2c874e192e4ee7f843534a3b36a05"
	#TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
