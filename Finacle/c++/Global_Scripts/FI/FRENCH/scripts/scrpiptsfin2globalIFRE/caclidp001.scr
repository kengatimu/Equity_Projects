	CUST.CACLI.errorMsg = " "
	CUST.CACLI.acctNumEntityId = " "
	CUST.CACLI.acctNumSolId = " "
	CUST.CACLI.acctNumCcy = " "
	CUST.CACLI.acctName = " "
	CUST.CACLI.entityCreFlg = " "
	CUST.CACLI.acctClsFlg = " "
	CUST.CACLI.schmType = " "
	CUST.CACLI.cifIdForSig = " "
	CUST.CACLI.bankDesc = " "
	
	#sv_u = urhk_b2k_printrepos("BANCS")
	#print(sv_u)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctID))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctID) != "")THEN
		#{
			CUST.CACLI.acctID = TOUPPER(TRIM(BANCS.INPUT.acctID))
			print(CUST.CACLI.acctID)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CACLI.errorFlg = "Y"
		CUST.CACLI.errorMsg = "Invalid Input for fnExecuteScript"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "acctNumEntityId,acctNumSolId,acctNumCcy,acctName,entityCreFlg,acctClsFlg,schmType,cifId|"
	sv_s = sv_s + " SELECT BANK_ID,SOL_ID,ACCT_CRNCY_CODE,ACCT_NAME,ENTITY_CRE_FLG,ACCT_CLS_FLG,SCHM_TYPE,CIF_ID"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE FORACID = ?SVAR"
	sv_s = sv_s + " AND DEL_FLG != 'Y'"
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CACLI.acctID
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.CACLI.acctNumEntityId = BANCS.OUTPARAM.acctNumEntityId
		print(CUST.CACLI.acctNumEntityId)
		CUST.CACLI.acctNumSolId = BANCS.OUTPARAM.acctNumSolId
		print(CUST.CACLI.acctNumSolId)
		CUST.CACLI.acctNumCcy = BANCS.OUTPARAM.acctNumCcy
		print(CUST.CACLI.acctNumCcy)
		CUST.CACLI.acctName = BANCS.OUTPARAM.acctName
		print(CUST.CACLI.acctName)
		CUST.CACLI.entityCreFlg = BANCS.OUTPARAM.entityCreFlg
		print(CUST.CACLI.entityCreFlg)
		CUST.CACLI.acctClsFlg = BANCS.OUTPARAM.acctClsFlg
		print(CUST.CACLI.acctClsFlg)
		CUST.CACLI.schmType = BANCS.OUTPARAM.schmType
		print(CUST.CACLI.schmType)
		CUST.CACLI.cifIdForSig = BANCS.OUTPARAM.cifId
		print(CUST.CACLI.cifIdForSig)
		
		IF(CUST.CACLI.entityCreFlg == "N")THEN
		#{
			CUST.CACLI.errorFlg = "Y"
			CUST.CACLI.errorMsg = "Account Creation Not Authorised"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.CACLI.acctClsFlg == "Y")THEN
		#{
			CUST.CACLI.errorFlg = "Y"
			CUST.CACLI.errorMsg = "Account is closed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.CACLI.schmType != "SBA") AND (CUST.CACLI.schmType != "CAA") AND (CUST.CACLI.schmType != "CCA") AND (CUST.CACLI.schmType != "ODA"))THEN
		#{
			CUST.CACLI.errorFlg = "Y"
			CUST.CACLI.errorMsg = "Only SBA/CAA/CCA/ODA Type of Accounts are allowed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
