	BANCS.INPARAM.BINDVARS = "" + CUST.CACLI.acctNumEntityId
	print(BANCS.INPARAM.BINDVARS)
	sv_a = ""
	sv_a = sv_a + "bankDesc|Select GROUP_DESC "
	sv_a = sv_a + " FROM TBAADM.GCT  "
	sv_a = sv_a + " WHERE BANK_ID = ?SVAR "
	sv_u = urhk_dbSelectWithBind(sv_a)
	print(sv_u)
	IF(sv_u == 0) THEN
	#{
		CUST.CACLI.bankDesc		= BANCS.OUTPARAM.bankDesc
		print(CUST.CACLI.bankDesc)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CACLI.errorFlg)
