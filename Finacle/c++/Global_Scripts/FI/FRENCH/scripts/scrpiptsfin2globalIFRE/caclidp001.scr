		print(sv_u)
		sv_u = urhk_SetOrbOut("acctName|"+CUST.CACLI.acctName)
		print(sv_u)
		sv_u = urhk_SetOrbOut("acctID|"+CUST.CACLI.acctID)
		print(sv_u)
		sv_u = urhk_SetOrbOut("bankId|"+CUST.CACLI.acctNumEntityId)
		print(sv_u)
		sv_u = urhk_SetOrbOut("bankDesc|"+CUST.CACLI.bankDesc)
		print(sv_u)
		
		
		
		
