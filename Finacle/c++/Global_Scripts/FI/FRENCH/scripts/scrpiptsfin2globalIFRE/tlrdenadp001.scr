		sv_l = STRLEN(CUST.DENOM.cab)
		PRINT(sv_l)
		IF (sv_l > sv_g) THEN
		#{
			IF (sv_g != 0) THEN
			#{
				sv_d = sv_l - sv_g
				WHILE(sv_d < CINT(CUST.DENOM.numDecPoint))
				#{
					CUST.DENOM.cab = CUST.DENOM.cab + "0"
					sv_d = sv_d + 1
				#}
				DO
