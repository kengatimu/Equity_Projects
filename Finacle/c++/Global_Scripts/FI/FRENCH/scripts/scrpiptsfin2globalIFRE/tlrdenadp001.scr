				BANCS.OUTPARAM.DENOM_COUNT = "  "
			#}
			ENDIF
			
			("CUST").("DENOM").("denomInd" + FORMAT$(sv_p, "%d")) = BANCS.OUTPARAM.DENOM_IND
			PRINT(("CUST").("DENOM").("denomInd" + FORMAT$(sv_p, "%d")))
			("CUST").("DENOM").("denomValue" + FORMAT$(sv_p, "%d")) = BANCS.OUTPARAM.DENOM_VALUE
			PRINT(("CUST").("DENOM").("denomValue" + FORMAT$(sv_p, "%d")))
			("CUST").("DENOM").("denomCount" + FORMAT$(sv_p, "%d")) = BANCS.OUTPARAM.DENOM_COUNT
			PRINT(("CUST").("DENOM").("denomCount" + FORMAT$(sv_p, "%d")))
			("CUST").("DENOM").("denomCntOrg" + FORMAT$(sv_p, "%d")) = BANCS.OUTPARAM.DENOM_COUNT
			PRINT(("CUST").("DENOM").("denomCntOrg" + FORMAT$(sv_p, "%d")))
			sv_p = sv_p + 1
			sv_c = urhk_dbCursorFetch(sv_m)
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_m)
		IF (sv_c != 0) THEN
		#{
			sv_u = urhk_setOrbOut("Message|N")
			sv_u = urhk_setOrbOut("Details|DENOMBase Error")
			GOTO FINISH
			#}
		ELSE
			#{
			PRINT("Cursor closed")
		#}
		ENDIF
		#}
	ELSE
		#{
		PRINT("No records fetched")
	#}
	ENDIF
	CUST.DENOM.totalRecords = sv_p
	PRINT(CUST.DENOM.totalRecords)
	IF (CUST.DENOM.totalRecords == 0) THEN
	#{
		#CUST.DENOM.MESSAGE = urtn_getMsg("V201157")
		#print(CUST.DENOM.MESSAGE)
		CUST.DENOM.MESSAGE = "No Records Fetched."
		sv_a = urhk_SetOrbOut("^Error_1|Error:^" + CUST.DENOM.MESSAGE + "^funcCode")
		PRINT(sv_a)
		GOTO FINISH
		#}
	ELSE
		#{
		PRINT("More than 0 records fetched")
	#}
