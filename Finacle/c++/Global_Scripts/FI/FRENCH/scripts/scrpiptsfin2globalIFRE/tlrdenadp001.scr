		sv_z = urhk_SetOrbOut(sv_o)
		PRINT(sv_z)
		sv_m = ("CUST").("DENOM").("denomValue" + sv_p)
		sv_n = ("CUST").("DENOM").("denomCount" + sv_p)
		CUST.DENOM.denomAmt = CDOUBLE(sv_m) * CDOUBLE(sv_n)
		CUST.DENOM.denomAmt = FORMAT$(CDOUBLE(CUST.DENOM.denomAmt),"%.2f")
		PRINT(CUST.DENOM.denomAmt)
		IF ( CUST.DENOM.denomAmt =="") THEN
		#{
			CUST.DENOM.denomAmt = "0"
		#}
		ENDIF
		sv_o = "txtfld4name" + sv_p + "|" + CUST.DENOM.denomAmt
		PRINT(sv_o)
		sv_z = urhk_SetOrbOut(sv_o)
		PRINT(sv_z)
		sv_p = CINT(sv_p) + 1
		PRINT(sv_p)
	#}
	DO
	CUST.DENOM.MaxRecords = CUST.DENOM.totalRecords
	
	PRINT(CUST.DENOM.totalRecords)
	IF (CUST.DENOM.totalRecords <= 10) THEN
	#{
		CUST.DENOM.MaxPage = (CDOUBLE(CUST.DENOM.totalRecords) / CDOUBLE(CUST.DENOM.MaxRecords))
