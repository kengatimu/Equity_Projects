				WHILE(sv_d < CINT(CUST.DENOM.numDecPoint))
				#{
					CUST.DENOM.cab = CUST.DENOM.cab + "0"
					sv_d = sv_d + 1
				#}
				DO
				PRINT(CUST.DENOM.cab)
			#}
			ENDIF
			#}
		ELSE
			#{
			PRINT("cash account balance is undefined")
		#}
		ENDIF
		#}
	ELSE
		#{
		PRINT("No decimal precision required")
	#}
	ENDIF
	
	sv_o = "cashAcctBalance|" + CUST.DENOM.cab
	PRINT(sv_o)
	sv_z = urhk_SetOrbOut(sv_o)
	PRINT(sv_z)
	
	
	#----------If it is head teller- no verifictn----------#
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.tellerId + "|" + CUST.DENOM.crncy
	IF (CUST.DENOM.funcCode == "V")THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DENOM.tellerId + "|" + CUST.DENOM.crncy
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DENOM.bank_id + "|" + CUST.DENOM.solId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_v = "DENOM_IND,DENOM_VALUE,DENOM_COUNT |SELECT "
	sv_v = sv_v + "distinct denom_ind ,denom_value,denom_count"
	IF ((CUST.DENOM.funcCode == "M") OR (CUST.DENOM.funcCode == "I")) THEN
	#{
		sv_v = sv_v + " FROM custom.c_denm "
		#}
	ELSE
		#{
		sv_v = sv_v + " FROM custom.c_denm_mod "
	#}
	ENDIF
	sv_v = sv_v + " WHERE teller_id =?SVAR "
	sv_v = sv_v + "AND crncy_code = ?SVAR "
	sv_v = sv_v + "AND bank_id =?SVAR "
	sv_v = sv_v + "AND sol_id =?SVAR "
	sv_v = sv_v + "ORDER BY denom_ind desc ,denom_value desc"
	PRINT(sv_v)
	sv_c = urhk_dbCursorOpenWithBind(sv_v)
	IF (sv_c != 0) THEN
	#{
		#CUST.DENOM.MESSAGE = urtn_getMsg("V201157")
		#print(CUST.DENOM.MESSAGE)
		CUST.DENOM.MESSAGE = "No records fetched.."
		sv_a = urhk_SetOrbOut("^Error_1|Error:^" + CUST.DENOM.MESSAGE + "^funcCode")
		PRINT(sv_a)
		GOTO FINISH
		
		#}
	ELSE
		#{
		PRINT("Records fetched")
	#}
	ENDIF
	
	sv_p = 1
	IF (sv_c == 0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_m)
		sv_c = urhk_dbCursorFetch(sv_m)
		PRINT(sv_c)
		
		WHILE(sv_c == 0)
		#{
