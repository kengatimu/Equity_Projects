			PRINT(sv_a)
			GOTO FINISH
			#}
		ELSE
			#{
			PRINT("Cursor open")
		#}
		ENDIF
		sv_p = 0
		IF (sv_c == 0) THEN
		#{
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_m)
			sv_c = urhk_dbCursorFetch(sv_m)
			PRINT(sv_c)
			
			WHILE(sv_c == 0)
			#{
				("CUST").("DENOM").("denomCntOrg" + FORMAT$(sv_p, "%d")) = BANCS.OUTPARAM.DENOM_COUNT
				PRINT(("CUST").("DENOM").("denomCntOrg" + FORMAT$(sv_p, "%d")))
				sv_p = sv_p + 1
				sv_c = urhk_dbCursorFetch(sv_m)
			#}
			DO
			sv_c = urhk_dbCursorClose(sv_m)
			IF (sv_c != 0) THEN
			#{
				sv_u = urhk_setOrbOut("Message|N")
				sv_u = urhk_setOrbOut("Details|DENOMBase Error")
				GOTO FINISH
				#}
			ELSE
				#{
				PRINT("Cursor closed")
			#}
			ENDIF
			
			#}
		ELSE
			#{
			PRINT("No records fetched")
		#}
		ENDIF
	#}
	ENDIF
	
	sv_p = 1
	sv_k = CINT(CUST.DENOM.totalRecords)
	WHILE(sv_p < sv_k)
	#{
		sv_p = FORMAT$(sv_p, "%d")
		
		sv_o = "txtfld1name" + sv_p + "|" + ("CUST").("DENOM").("denomInd" + sv_p)
		PRINT(sv_o)
		sv_z = urhk_SetOrbOut(sv_o)
