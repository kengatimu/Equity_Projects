		sv_a = urhk_SetOrbOut("^Error_1|Error:^" + CUST.DENOM.MESSAGE + "^funcCode")
		PRINT(sv_a)
		GOTO FINISH
	#}
	ENDIF
	sv_p = 0
	
	IF (CUST.DENOM.numDecPoint != 0) THEN
	#{
		#	sv_v = CUST.DENOM.cab + '.'
		#	WHILE(sv_p < CINT(CUST.DENOM.numDecPoint))
		#		sv_v = sv_v + '0'
