	ENDIF
	
	CUST.DENOM.MaxPage = CINT(CUST.DENOM.MaxPage)
	
	PRINT(CUST.DENOM.MaxPage)
	sv_a = CUST.DENOM.MaxPage
	sv_z = urhk_SetOrbOut("maxPage|" + CUST.DENOM.MaxPage)
	sv_z = urhk_SetOrbOut("setSize|" + CUST.DENOM.MaxPage)
	sv_z = urhk_SetOrbOut("MaxRecords|" + CUST.DENOM.MaxRecords)
	sv_r = urhk_SetOrbOut("totalRecords|" + CUST.DENOM.totalRecords)
	sv_z = urhk_SetOrbOut("numOfDecPoints|" + CUST.DENOM.numDecPoint)
	IF (CUST.DENOM.totalRecords <= 20) THEN
	#{
		sv_r = urhk_SetOrbOut("MaxRecsPerPage|" + CUST.DENOM.MaxRecords)
