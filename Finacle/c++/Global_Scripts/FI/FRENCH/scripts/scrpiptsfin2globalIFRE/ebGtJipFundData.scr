#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Name                   : ebGtJipFundData.scr 
#   Date                   : 19-Jul-2019
#   Description            :
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Rep/Class
        if(repexists("EQGTG")==0)then
                createrep("EQGTG")
        endif
        if(classexists("EQGTG","GLBDATA")==0)then
                createclass("EQGTG","GLBDATA",5)
        endif
#Inp/Out
	EQGTG.GLBDATA.ErrMsg	= ""
	BANCS.INPUT.goaldts	= ""
	BANCS.INPUT.wkbAcct	= ""
	BANCS.INPUT.wkbthlmt	= ""
	BANCS.INPUT.wkbdeppcnt	= ""
	BANCS.INPUT.wksAcct	= ""
	BANCS.INPUT.wksDepPcnt	= ""
	BANCS.INPUT.wkJipAcct	= ""
	EQGTG.GLBDATA.jipAcct   = ""		
	EQGTG.GLBDATA.ModuleId	= ""
	EQGTG.GLBDATA.isKenyaTea = "0"
	if(fieldexists(BANCS.INPUT.DrCrInd)==1)then
		EQGTG.GLBDATA.DrCrInd	= BANCS.INPUT.DrCrInd
	else
		EQGTG.GLBDATA.DrCrInd	= ""
	endif
	if(EQGTG.GLBDATA.DrCrInd == "C")then
		if(fieldexists(BANCS.INPUT.AcctNum)==1)then
			EQGTG.GLBDATA.CrAcctNum	= BANCS.INPUT.AcctNum
		else
			EQGTG.GLBDATA.CrAcctNum	= ""
		endif
		if(fieldexists(BANCS.INPUT.TranCurrency)==1)then
			EQGTG.GLBDATA.TranCurrency	= BANCS.INPUT.TranCurrency
		else
			EQGTG.GLBDATA.TranCurrency	= ""
		endif
		if(fieldexists(BANCS.INPUT.RefCurrency)==1)then
			EQGTG.GLBDATA.RefCurrency	= BANCS.INPUT.RefCurrency
		else
			EQGTG.GLBDATA.RefCurrency	= ""
		endif
		if(fieldexists(BANCS.INPUT.TranAmt)==1)then
			EQGTG.GLBDATA.TranAmt	= BANCS.INPUT.TranAmt
		else
			EQGTG.GLBDATA.TranAmt	= ""
		endif
		if(fieldexists(BANCS.INPUT.SchemeType)==1)then
			EQGTG.GLBDATA.SchemeType	= BANCS.INPUT.SchemeType
		else
			EQGTG.GLBDATA.SchemeType	= ""
		endif
		if(fieldexists(BANCS.INPUT.TranParticulars)==1)then
			EQGTG.GLBDATA.TranParticulars	= BANCS.INPUT.TranParticulars
		else
			EQGTG.GLBDATA.TranParticulars	= ""
		endif
		if(fieldexists(BANCS.INPUT.TranId)==1)then
			EQGTG.GLBDATA.TranId	= BANCS.INPUT.TranId
		else
			EQGTG.GLBDATA.TranId	= BANCS.INPUT.TranId
		endif
	else
		EQGTG.GLBDATA.ErrMsg = "No Goals Funding"
		goto VAYU
	endif
#FundChk
	if((EQGTG.GLBDATA.CrAcctNum!="") and (EQGTG.GLBDATA.SchemeType !="OAB") and (EQGTG.GLBDATA.SchemeType != "OSP") and (EQGTG.GLBDATA.SchemeType !="DDA") and (EQGTG.GLBDATA.SchemeType != "HOA") and cdouble(EQGTG.GLBDATA.TranAmt)>0)then
		sv_d = "isKenyaTea | select custom.ebgtgoal_master_fun('"+EQGTG.GLBDATA.CrAcctNum+"',"+EQGTG.GLBDATA.TranAmt+",'KES',"
		sv_d = sv_d + " '"+EQGTG.GLBDATA.TranParticulars+"','remarks','refnum','"+BANCS.STDIN.contextBankId+"','T') from dual"
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.isKenyaTea = BANCS.OUTPARAM.isKenyaTea	
		else
			EQGTG.GLBDATA.isKenyaTea = "0"
		endif
		sv_d ="goalsDtls | select custom.ebgtgoal_master_fun('"+EQGTG.GLBDATA.CrAcctNum+"',"+EQGTG.GLBDATA.TranAmt+",'KES',"
		sv_d = sv_d + " '"+EQGTG.GLBDATA.TranParticulars+"','remarks','refnum','"+BANCS.STDIN.contextBankId+"','P') from dual "
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			BANCS.INPUT.goaldts = BANCS.OUTPARAM.goalsDtls
		else
			BANCS.INPUT.goaldts = "NA"
		endif
	else
		EQGTG.GLBDATA.ErrMsg = "No Goals Funding"
		goto VAYU
	endif
	if(cint(EQGTG.GLBDATA.isKenyaTea)<=0)then 
		EQGTG.GLBDATA.ErrMsg = "No Goals Funding"
		goto VAYU
	endif
#To Check KTDA Salary should be funded to Jipange or not
	EQGTG.GLBDATA.jipangeFundYN = "N"
	sv_d = left$(BANCS.STDIN.BODDate,10)
	print(sv_d)
	sv_y = mid$(sv_d,8,10)
	print(sv_y)
	sv_m = mid$(sv_d,3,2)
	print(sv_m)
	if((cint(sv_m) == 3) or (cint(sv_m) ==4 ))then
		print("april KTDA Salary Tran Ok, for funding to jipange")
		EQGTG.GLBDATA.jipangeFundYN = "Y"
	endif
	if((cint(sv_m) == 9) or (cint(sv_m) ==10 ))then
		print("october KTDA Salary Tran Ok, for funding to jipange")
		EQGTG.GLBDATA.jipangeFundYN = "Y"
	endif
	if((BANCS.INPUT.goaldts != "NA") and (EQGTG.GLBDATA.jipangeFundYN!="Y"))then
		EQGTG.GLBDATA.ErrMsg = "no jipanage funding , since ktda salary is not under april/october"
		##goto VAYU
	endif
#To get goal details
	sv_l = strlen(BANCS.INPUT.goaldts)
	sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.wkbAcct  = mid$(sv_f,0,(sv_p-1))
	print(BANCS.INPUT.wkbAcct)
	#-- Wekeza Threshold Limit
	BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
	sv_l = strlen(BANCS.INPUT.goaldts)
	sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.wkbthlmt  = mid$(sv_f,0,(sv_p-1))
	print(BANCS.INPUT.wkbthlmt)
	#-- Wekeza Deposit Pcnt
	BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
	sv_l = strlen(BANCS.INPUT.goaldts)
	sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.wkbdeppcnt  = mid$(sv_f,0,(sv_p-1))
	print(BANCS.INPUT.wkbdeppcnt)
	#--Wekeza Sasa Acct
	BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
	sv_l = strlen(BANCS.INPUT.goaldts)
	sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.wksAcct  = mid$(sv_f,0,(sv_p-1))
	print(BANCS.INPUT.wksAcct)
	#--Wekeza Sasa Dep Pcnt
	BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
	sv_l = strlen(BANCS.INPUT.goaldts)
	sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.wksDepPcnt  = mid$(sv_f,0,(sv_p-1))
	print(BANCS.INPUT.wksDepPcnt)
	#--Wekeza Oct Jipange Acct
	BANCS.INPUT.goaldts = mid$(sv_f,sv_p,sv_l)
	sv_l = strlen(BANCS.INPUT.goaldts)
	sv_f = mid$(BANCS.INPUT.goaldts,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.wksOctJipAcct  = mid$(sv_f,0,(sv_p-1))
	print(BANCS.INPUT.wksOctJipAcct)
	#--Wekeza Apr Jipange Acct
	BANCS.INPUT.wksAprJipAcct = mid$(sv_f,sv_p,sv_l)
	print(BANCS.INPUT.wksAprJipAcct)

	##if((BANCS.INPUT.wkbAcct != "") and (BANCS.INPUT.wkbAcct!="NA"))then
	##	EQGTG.GLBDATA.ModuleId = "GTWKB"
	##	EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wkbAcct
	##endif
	##if((BANCS.INPUT.wksAcct != "") and (BANCS.INPUT.wksAcct!="NA"))then
	##	EQGTG.GLBDATA.ModuleId = "GTWKS"
	##	EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAcct
	##endif
	if((BANCS.INPUT.wksOctJipAcct != "") and (BANCS.INPUT.wksOctJipAcct!="NA"))then
		EQGTG.GLBDATA.ModuleId = "GTJIP"
		EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksOctJipAcct
	endif
	if((BANCS.INPUT.wksAprJipAcct != "") and (BANCS.INPUT.wksAprJipAcct!="NA"))then
		EQGTG.GLBDATA.ModuleId = "GTJIP"
		EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAprJipAcct
	endif
	#+++++++++++++++++++++++++++++++++++++++++++++++++++++++
	#to derive which account has to credit October or April
	#+++++++++++++++++++++++++++++++++++++++++++++++++++++++
	sv_d = left$(BANCS.STDIN.BODDate,10)
	print(sv_d)
	sv_y = mid$(sv_d,8,10)
	print(sv_y)
	sv_m = mid$(sv_d,3,2)
	print(sv_m)
	if((cint(sv_m) == 1) or (cint(sv_m) == 2) or (cint(sv_m) == 3) or (cint(sv_m) ==4 ))then
		print("april KTDA Salary Tran Ok, for funding to jipange")
		EQGTG.GLBDATA.jipangeFundYN = "Y"
		EQGTG.GLBDATA.ModuleId = "GTJIP"
		EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksAprJipAcct
	endif
	##if((cint(sv_m) == 9) or (cint(sv_m) ==10 ))then
	if((cint(sv_m) == 5) or (cint(sv_m) == 6) or (cint(sv_m) == 7) or (cint(sv_m) == 8) or (cint(sv_m) == 9) or (cint(sv_m) ==10 ))then
		print("october KTDA Salary Tran Ok, for funding to jipange")
		EQGTG.GLBDATA.jipangeFundYN = "Y"
		EQGTG.GLBDATA.ModuleId = "GTJIP"
		EQGTG.GLBDATA.jipAcct = BANCS.INPUT.wksOctJipAcct
	endif
	if((EQGTG.GLBDATA.jipAcct != "") and (EQGTG.GLBDATA.CrAcctNum!="") and (cdouble(EQGTG.GLBDATA.TranAmt)>0) and (EQGTG.GLBDATA.TranId !="")) then
		sv_d = "fundCnt | select count(*) from custom.ebgtgoal_jipange_funding " 
		sv_d = sv_d + " where bank_id=?SVAR and upl_tranid=ltrim(?SVAR) and FUND_YN='N' and DR_ACCTID=?SVAR and CR_ACCTID=?SVAR "
		sv_d = sv_d + " and UPL_TRANAMT =?NVAR "  
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQGTG.GLBDATA.TranId + "|" + EQGTG.GLBDATA.CrAcctNum + "|" +EQGTG.GLBDATA.jipAcct + "|" + EQGTG.GLBDATA.TranAmt 
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQGTG.GLBDATA.fundCnt = BANCS.OUTPARAM.fundCnt
		else
			EQGTG.GLBDATA.fundCnt = "0"
		endif
		if(cint(EQGTG.GLBDATA.fundCnt)>=1)then
			EQGTG.GLBDATA.ErrMsg = "Funding Data Already Exist"
			goto VAYU
		endif
		print(EQGTG.GLBDATA.jipAcct)
		#+++++++++++++++++++++++++
		#Funding Data 
		#+++++++++++++++++++++++++
		sv_i = "Insert into CUSTOM.EBGTGOAL_JIPANGE_FUNDING (BANK_ID, "
		sv_i = sv_i + "DR_ACCTID,"
		sv_i = sv_i + "CR_ACCTID,"
		sv_i = sv_i + "UPL_TRANID,UPL_TRANDATE,UPL_TRANAMT,FUND_YN,"
		sv_i = sv_i + "FUND_TRANID,FUND_TRANDATE,RCRE_USER_ID,RCRE_TIME,"
		sv_i = sv_i + "LCHG_USER_ID,LCHG_TIME,FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,DEL_FLG) values "
		sv_i = sv_i + "(?SVAR,?SVAR,?SVAR,ltrim(?SVAR),to_date(?SVAR,'DD-MM-RR'),?SVAR,'N',null,null,?SVAR,sysdate,?SVAR,sysdate,'Y',null,null,'N') "
		#print(BANCS.STDIN.contextBankId)
		#print(EQGTG.GLBDATA.CrAcctNum)
		#print(EQGTG.GLBDATA.jipAcct)
		#print(EQGTG.GLBDATA.TranId)
		#print(BANCS.STDIN.BODDate)
		#print(EQGTG.GLBDATA.TranAmt)
		
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQGTG.GLBDATA.CrAcctNum + "|" + EQGTG.GLBDATA.jipAcct + "|" + EQGTG.GLBDATA.TranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + EQGTG.GLBDATA.TranAmt + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId 
		print(BANCS.INPARAM.BINDVARS)
		print(sv_i)
		sv_u = urhk_dbSqlWithBind(sv_i)
		if(sv_u==0)then
			sv_u = urhk_dbSqlWithBind("Commit")
		else
			exitscript
		endif
	else
			EQGTG.GLBDATA.ErrMsg = "No Goal Funding"
			goto VAYU
	endif
VAYU:
	print(EQGTG.GLBDATA.ErrMsg)
	exitscript
trace off
end-->
