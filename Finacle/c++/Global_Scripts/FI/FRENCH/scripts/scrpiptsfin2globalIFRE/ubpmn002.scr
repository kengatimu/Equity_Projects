			#{
			
			CUST.UBP.clearBalance=CDOUBLE(BANCS.OUTPARAM.clearBalance)
			CUST.UBP.EffAvailableAmt =CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt)
			CUST.UBP.payAcctCrncy=BANCS.OUTPARAM.acctCrncyCode
