	#==========================================================*
	#For D- DELETE
	#==========================================================*
	IF(CUST.CCPRM.funcCode == "D") THEN
	#{
		sv_s = "recCount|SELECT 1 FROM DUAL WHERE EXISTS("
		sv_s = sv_s + " SELECT 1 FROM custom.CUSTOM_CCPRMOD"
		sv_s = sv_s + " WHERE"
		sv_s = sv_s + " EVENT_ID = ?SVAR AND EVENT_TYPE = ?SVAR  AND SCHM_CODE=?SVAR AND CRNCY_CODE = ?SVAR AND BANK_ID = ?SVAR AND SRL_NUM=?SVAR)"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CCPRM.evntId + "|" + CUST.CCPRM.evntType + "|" + CUST.CCPRM.schmCode + "|" + CUST.CCPRM.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CCPRM.srlNum
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d == 0) THEN
		#{
			sv_s = "delete from custom.CUSTOM_CCPRMOD where EVENT_ID = ?SVAR AND EVENT_TYPE = ?SVAR  AND SCHM_CODE=?SVAR AND CRNCY_CODE = ?SVAR  AND BANK_ID=?SVAR AND SRL_NUM=?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CCPRM.evntId + "|" + CUST.CCPRM.evntType + "|" + CUST.CCPRM.schmCode + "|" + CUST.CCPRM.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CCPRM.srlNum
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d != 0) THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error|Database delete failed")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_s = "delete from custom.CUSTOM_CCPRM where EVENT_ID = ?SVAR AND EVENT_TYPE = ?SVAR  AND SCHM_CODE=?SVAR AND CRNCY_CODE = ?SVAR AND BANK_ID=?SVAR AND SRL_NUM=?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CCPRM.evntId + "|" + CUST.CCPRM.evntType + "|" + CUST.CCPRM.schmCode + "|" + CUST.CCPRM.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CCPRM.srlNum
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d != 0) THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error|Database delete failed")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		CUST.CCPRM.resultMsg = "Record has been deleted successfully"
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.CCPRM.resultMsg)
		PRINT(sv_u)
		
	#}
	ENDIF
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	PRINT(sv_z)
	TRACE OFF
	ENDOFSCRIPT:
END-->

