<--START
CHECKSUM="e2204a47fa86da9a29202ab9b52ab6ca2ca31db0317334651e50a6a67316a199"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.ieTxnRefNo = ""
	CUST.CIETXN.initEntityId = ""
	CUST.CIETXN.targetEntityId = ""
	CUST.CIETXN.tranAmtInHardCcy = ""
	CUST.CIETXN.hardCcy = ""
	CUST.CIETXN.chargeAmtInUsd = ""
	CUST.CIETXN.centralEntity1NostroAcct = ""
	CUST.CIETXN.centralEntity2NostroAcct = ""
	CUST.CIETXN.centralSettlementAcct = ""
	CUST.CIETXN.chargeAmtInHardCcy = ""
	CUST.CIETXN.currentDateTime = ""
	CUST.CIETXN.reportFileName = ""
	CUST.CIETXN.successOrFailure = ""
	CUST.CIETXN.errorMsg = ""
	
	###########################################################################################
	# Get system date-time and clear report file
	###########################################################################################
	
	sv_s = "currentDateTime|SELECT TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS') FROM DUAL"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.currentDateTime = BANCS.OUTPARAM.currentDateTime
		print(CUST.CIETXN.currentDateTime)
	#}
	ENDIF
	
	CUST.CIETXN.reportFileName = "CIETXN_CW_CENTRAL_SETTLEMENT_" + CUST.CIETXN.currentDateTime + ".LST"
	print(CUST.CIETXN.reportFileName)
	
	sv_s = "> "+  CUST.CIETXN.reportFileName
	sv_a = SYSTEM(sv_s)
	print(sv_a)
	
	###########################################################################################
	# Fetch Records which are Eligible for Settlement
	###########################################################################################
	
	BANCS.INPARAM.BINDVARS = ""
	PRINT(BANCS.INPARAM.BINDVARS)
	
	lv_s = "ieTxnRefNo,initEntityId,targetEntityId,tranAmtInHardCcy,hardCcy,chargeAmtInUsd|"
	lv_s = lv_s + " SELECT IE_TXN_REF_NO,INIT_ENTITY_ID,TARGET_ENTITY_ID,TRAN_AMT_IN_HARD_CCY,HARD_CRNCY_CODE,CHARGE_AMT_IN_USD"
	lv_s = lv_s + " FROM CUSTOM.IECWD"
	lv_s = lv_s + " WHERE NVL(CENTRAL_SETTLEMENT_STATUS,'X') != 'S'"
	print(lv_s)
	
	lv_c = urhk_dbCursorOpenWithBind(lv_s)
	print(lv_c)
	
	IF(lv_c != 0)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	lv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(lv_n)
	
	lv_f = urhk_dbCursorFetch(lv_n)
	print(lv_f)
	
	lv_i = 1
	
	WHILE(lv_f == 0)
	#{
		CUST.CIETXN.centralSettlementStatus = "F"
		CUST.CIETXN.centralSettlementTranId = ""
		CUST.CIETXN.centralSettlementTranDate = ""
		CUST.CIETXN.errorMsg = ""
		
		CUST.CIETXN.ieTxnRefNo = BANCS.OUTPARAM.ieTxnRefNo
		PRINT(CUST.CIETXN.ieTxnRefNo)
		
		CUST.CIETXN.initEntityId = BANCS.OUTPARAM.initEntityId
		PRINT(CUST.CIETXN.initEntityId)
		
		CUST.CIETXN.targetEntityId = BANCS.OUTPARAM.targetEntityId
		PRINT(CUST.CIETXN.targetEntityId)
		
		CUST.CIETXN.tranAmtInHardCcy = BANCS.OUTPARAM.tranAmtInHardCcy
		PRINT(CUST.CIETXN.tranAmtInHardCcy)
		
		CUST.CIETXN.hardCcy = BANCS.OUTPARAM.hardCcy
		PRINT(CUST.CIETXN.hardCcy)
		
		CUST.CIETXN.chargeAmtInUsd = BANCS.OUTPARAM.chargeAmtInUsd
		PRINT(CUST.CIETXN.chargeAmtInUsd)
		
		CUST.CIETXN.initEntityName = ""
		
		IF(CUST.CIETXN.initEntityId == "54")THEN
		#{
			CUST.CIETXN.initEntityName = "KENYA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "56")THEN
		#{
			CUST.CIETXN.initEntityName = "UGANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "11")THEN
		#{
			CUST.CIETXN.initEntityName = "SUDAN"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "50")THEN
		#{
			CUST.CIETXN.initEntityName = "RWANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "55")THEN
		#{
			CUST.CIETXN.initEntityName = "TANZANIA"
		#}
		ENDIF
		
		CUST.CIETXN.targetEntityName = ""
		
		IF(CUST.CIETXN.targetEntityId == "54")THEN
		#{
			CUST.CIETXN.targetEntityName = "KENYA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "56")THEN
		#{
			CUST.CIETXN.targetEntityName = "UGANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "11")THEN
		#{
			CUST.CIETXN.targetEntityName = "SUDAN"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "50")THEN
		#{
			CUST.CIETXN.targetEntityName = "RWANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.targetEntityId == "55")THEN
		#{
			CUST.CIETXN.targetEntityName = "TANZANIA"
		#}
		ENDIF
		
		#-----------------------------------------------------------------
		# Get Central-Entity1 Nostro Account
		#-----------------------------------------------------------------
		CUST.CIETXN.parameterId = "CENTRAL_ENTITY1_NOSTRO"
		print(CUST.CIETXN.parameterId)
		
		sv_s = "centralEntity1NostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.initEntityId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Entity1 Nostro Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		CUST.CIETXN.centralEntity1NostroAcct = BANCS.OUTPARAM.centralEntity1NostroAcct
		print(CUST.CIETXN.centralEntity1NostroAcct)
		
		IF(TRIM(CUST.CIETXN.centralEntity1NostroAcct) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Entity1 Nostro Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------------
		# Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		BANCS.INPUT.inputBacid = CUST.CIETXN.centralEntity1NostroAcct
		BANCS.INPUT.inputCcy   = CUST.CIETXN.hardCcy
		BANCS.INPUT.inputSolID = BANCS.STDIN.mySolId
		BANCS.INPUT.inputBankId = BANCS.STDIN.contextBankId
		
		CALL("bacidtoacid.scr")
		CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
		print(CUST.CIETXN.outputForacid)
		
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Entity1 Nostro Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		CUST.CIETXN.centralEntity1NostroAcct = CUST.CIETXN.outputForacid
		PRINT(CUST.CIETXN.centralEntity1NostroAcct)
		
		#-----------------------------------------------------------------
		# Get Central-Entity2 Nostro Account
		#-----------------------------------------------------------------
		CUST.CIETXN.parameterId = "CENTRAL_ENTITY2_NOSTRO"
		print(CUST.CIETXN.parameterId)
		
		sv_s = "centralEntity2NostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.targetEntityId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Entity2 Nostro Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		CUST.CIETXN.centralEntity2NostroAcct = BANCS.OUTPARAM.centralEntity2NostroAcct
		print(CUST.CIETXN.centralEntity2NostroAcct)
		
		IF(TRIM(CUST.CIETXN.centralEntity2NostroAcct) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Entity2 Nostro Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------------
		# Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		BANCS.INPUT.inputBacid = CUST.CIETXN.centralEntity2NostroAcct
		BANCS.INPUT.inputCcy   = CUST.CIETXN.hardCcy
		BANCS.INPUT.inputSolID = BANCS.STDIN.mySolId
		BANCS.INPUT.inputBankId = BANCS.STDIN.contextBankId
		
		CALL("bacidtoacid.scr")
		CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
		print(CUST.CIETXN.outputForacid)
		
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Entity2 Nostro Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		CUST.CIETXN.centralEntity2NostroAcct = CUST.CIETXN.outputForacid
		PRINT(CUST.CIETXN.centralEntity2NostroAcct)
		
		#-----------------------------------------------------------------
		# Get Central Settlement Account
		#-----------------------------------------------------------------
		CUST.CIETXN.parameterId = "CENTRAL_SETTLEMENT_ACCOUNT"
		print(CUST.CIETXN.parameterId)
		
		sv_s = "centralSettlementAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
		sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
		sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
		sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
		sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
		sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
		sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
		sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
		sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
		sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0)THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Settlement Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		CUST.CIETXN.centralSettlementAcct = BANCS.OUTPARAM.centralSettlementAcct
		print(CUST.CIETXN.centralSettlementAcct)
		
		IF(TRIM(CUST.CIETXN.centralSettlementAcct) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Settlement Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------------
		# Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		BANCS.INPUT.inputBacid = CUST.CIETXN.centralSettlementAcct
		BANCS.INPUT.inputCcy   = CUST.CIETXN.hardCcy
		BANCS.INPUT.inputSolID = BANCS.STDIN.mySolId
		BANCS.INPUT.inputBankId = BANCS.STDIN.contextBankId
		
		CALL("bacidtoacid.scr")
		CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
		print(CUST.CIETXN.outputForacid)
		
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Central Settlement Account;"
			GOTO NEXTFETCH
		#}
		ENDIF
		
		CUST.CIETXN.centralSettlementAcct = CUST.CIETXN.outputForacid
		PRINT(CUST.CIETXN.centralSettlementAcct)
		
		#-----------------------------------------------------------------
		# Get charge Amt in Hard Ccy
		#-----------------------------------------------------------------
		
		IF(CUST.CIETXN.hardCcy != "USD")THEN
		#{
			#Convert to Hard Ccy
			#currently hard coded to chargeAmtInUsd
			CUST.CIETXN.chargeAmtInHardCcy = CUST.CIETXN.chargeAmtInUsd
			#}
		ELSE
			#{
			CUST.CIETXN.chargeAmtInHardCcy = CUST.CIETXN.chargeAmtInUsd
			PRINT(CUST.CIETXN.chargeAmtInHardCcy)
		#}
		ENDIF
		
		#-----------------------------------------------------------------
		# Create Transaction
		#-----------------------------------------------------------------
		
		CUST.CIETXN.refCrncy = ""
		
		CUST.CIETXN.crAcct1 = ""
		CUST.CIETXN.drAcct1 = ""
		CUST.CIETXN.refAmt1 = ""
		CUST.CIETXN.tranParticularCr1 = ""
		CUST.CIETXN.tranParticularDr1 = ""
		CUST.CIETXN.tranRmksCr1 = ""
		CUST.CIETXN.tranRmksDr1 = ""
		CUST.CIETXN.crAcct2 = ""
		CUST.CIETXN.drAcct2 = ""
		CUST.CIETXN.refAmt2 = ""
		CUST.CIETXN.tranParticularCr2 = ""
		CUST.CIETXN.tranParticularDr2 = ""
		CUST.CIETXN.tranRmksCr2 = ""
		CUST.CIETXN.tranRmksDr2 = ""
		CUST.CIETXN.crAcct3 = ""
		CUST.CIETXN.drAcct3 = ""
		CUST.CIETXN.refAmt3 = ""
		CUST.CIETXN.tranParticularCr3 = ""
		CUST.CIETXN.tranParticularDr3 = ""
		CUST.CIETXN.tranRmksCr3 = ""
		CUST.CIETXN.tranRmksDr3 = ""
		
		CUST.CIETXN.refCrncy = CUST.CIETXN.hardCcy
		CUST.CIETXN.crAcct1 = CUST.CIETXN.centralSettlementAcct
		CUST.CIETXN.drAcct1 = CUST.CIETXN.centralEntity2NostroAcct
		CUST.CIETXN.refAmt1 = CDOUBLE(CUST.CIETXN.tranAmtInHardCcy) + CDOUBLE(CUST.CIETXN.chargeAmtInHardCcy)
		CUST.CIETXN.tranParticularCr1 = "IECW: CENTRAL - " + CUST.CIETXN.targetEntityName + " SETTLEMENT"
		CUST.CIETXN.tranParticularDr1 = "IECW: CENTRAL - " + CUST.CIETXN.targetEntityName + " SETTLEMENT"
		CUST.CIETXN.tranRmksCr1 = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.tranRmksDr1 = CUST.CIETXN.ieTxnRefNo
		
		CUST.CIETXN.crAcct2 = CUST.CIETXN.centralEntity1NostroAcct
		CUST.CIETXN.drAcct2 = CUST.CIETXN.centralSettlementAcct
		CUST.CIETXN.refAmt2 = CDOUBLE(CUST.CIETXN.tranAmtInHardCcy)
		CUST.CIETXN.rateCode2 = "CNB"
		CUST.CIETXN.tranParticularCr2 = "IECW: CENTRAL - " + CUST.CIETXN.initEntityName + " SETTLEMENT"
		CUST.CIETXN.tranParticularDr2 = "IECW: CENTRAL - " + CUST.CIETXN.initEntityName + " SETTLEMENT"
		CUST.CIETXN.tranRmksCr2 = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.tranRmksDr2 = CUST.CIETXN.ieTxnRefNo
		
		CUST.CIETXN.crAcct3 = CUST.CIETXN.centralEntity1NostroAcct
		CUST.CIETXN.drAcct3 = CUST.CIETXN.centralSettlementAcct
		CUST.CIETXN.refAmt3 = CDOUBLE(CUST.CIETXN.chargeAmtInHardCcy)
		CUST.CIETXN.rateCode3 = "CNB"
		CUST.CIETXN.tranParticularCr3 = "IECW: CENTRAL - " + CUST.CIETXN.initEntityName + " CHRG SETTLEMENT"
		CUST.CIETXN.tranParticularDr3 = "IECW: CENTRAL - " + CUST.CIETXN.initEntityName + " CHRG SETTLEMENT"
		CUST.CIETXN.tranRmksCr3 = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.tranRmksDr3 = CUST.CIETXN.ieTxnRefNo
		
		PRINT(CUST.CIETXN.refCrncy)
		
		PRINT(CUST.CIETXN.crAcct1)
		PRINT(CUST.CIETXN.drAcct1)
		PRINT(CUST.CIETXN.refAmt1)
		PRINT(CUST.CIETXN.tranParticularCr1)
		PRINT(CUST.CIETXN.tranParticularDr1)
		PRINT(CUST.CIETXN.tranRmksCr1)
		PRINT(CUST.CIETXN.tranRmksDr1)
		
		PRINT(CUST.CIETXN.crAcct2)
		PRINT(CUST.CIETXN.drAcct2)
		PRINT(CUST.CIETXN.refAmt2)
		PRINT(CUST.CIETXN.rateCode2)
		PRINT(CUST.CIETXN.tranParticularCr2)
		PRINT(CUST.CIETXN.tranParticularDr2)
		PRINT(CUST.CIETXN.tranRmksCr2)
		PRINT(CUST.CIETXN.tranRmksDr2)
		
		PRINT(CUST.CIETXN.crAcct3)
		PRINT(CUST.CIETXN.drAcct3)
		PRINT(CUST.CIETXN.refAmt3)
		PRINT(CUST.CIETXN.rateCode3)
		PRINT(CUST.CIETXN.tranParticularCr3)
		PRINT(CUST.CIETXN.tranParticularDr3)
		PRINT(CUST.CIETXN.tranRmksCr3)
		PRINT(CUST.CIETXN.tranRmksDr3)
		
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
		sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
		
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|C")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+CUST.CIETXN.refAmt1+"|"+ CUST.CIETXN.refCrncy)
