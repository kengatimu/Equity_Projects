<--START
CHECKSUM="efe52df04aa0a8ea68ff770ef2477a19a990ebe8dffff902123a9d98dcccf3a9"
	TRACE ON
	
	PRINT(CUST.CIECLG.zoneCode)
	PRINT(CUST.CIECLG.zoneDate)
	PRINT(CUST.CIECLG.zoneCcy)
	PRINT(CUST.CIECLG.setNum)
	PRINT(CUST.CIECLG.creditEntity)
	PRINT(CUST.CIECLG.crAcctNum)
	PRINT(CUST.CIECLG.crAcctNumEntityId)
	PRINT(CUST.CIECLG.crAcctNumCcy)
	PRINT(CUST.CIECLG.chargeEventId)
	PRINT(CUST.CIECLG.chargeAmt)
	PRINT(CUST.CIECLG.chargeAmtCcy)
	PRINT(CUST.CIECLG.nostroAcct)
	PRINT(CUST.CIECLG.vostroAcct)
	PRINT(CUST.CIECLG.valueDate)
	PRINT(CUST.CIECLG.payingAcct)
	PRINT(CUST.CIECLG.targetZoneCode)
	PRINT(CUST.CIECLG.targetZoneDate)
	PRINT(CUST.CIECLG.targetSolId)
	PRINT(CUST.CIECLG.targetSetNum)
	PRINT(CUST.CIECLG.tranParticular)
	PRINT(CUST.CIECLG.tranRmks)
	PRINT(CUST.CIECLG.instrumentEntity)
	PRINT(CUST.CIECLG.instrumentAlpha)
	PRINT(CUST.CIECLG.instrumentNum)
	PRINT(CUST.CIECLG.instrumentDate)
	PRINT(CUST.CIECLG.instrumentAmt)
	PRINT(CUST.CIECLG.instrumentAmtCcy)
	PRINT(CUST.CIECLG.instrumentBankCode)
	PRINT(CUST.CIECLG.instrumentBranchCode)
	PRINT(CUST.CIECLG.instrumentSortCode)
	
	PRINT(CUST.CIECLG.defaultBankCode)
	PRINT(CUST.CIECLG.defaultBranchCode)
	PRINT(CUST.CIECLG.defaultSortCode)
	
	CUST.CIECLG.setNum = ""
	
	##################################################################################
	# SRV Input
	##################################################################################
	
	sv_u = urhk_SetUrhkInp("zoneCode|"+CUST.CIECLG.zoneCode)
	sv_u = urhk_SetUrhkOut("settlementToAcctCrncyRateCode.refCode|sttlToAcctCrncyRateCode")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_InquireOcZoneTmpl|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	CUST.CIECLG.sttlToAcctCrncyRateCode = BANCS.OUTPARAM.sttlToAcctCrncyRateCode
	PRINT(CUST.CIECLG.sttlToAcctCrncyRateCode)
	
	IF(TRIM(CUST.CIECLG.sttlToAcctCrncyRateCode) == "")THEN
	#{
		CUST.CIECLG.sttlToAcctCrncyRateCode = "MEAN"
	#}
	ENDIF
	
	CUST.CIECLG.sttlToAcctCrncyRate = " "
	BANCS.INPARAM.InputAmount = 1
	BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode
	BANCS.INPARAM.ToCurrency = CUST.CIECLG.instrumentAmtCcy
	BANCS.INPARAM.RateCode = CUST.CIECLG.sttlToAcctCrncyRateCode
	BANCS.INPARAM.Rate = 0.00
	BANCS.INPARAM.CustId = ""
	sv_u = urhk_B2k_ConvertAmount("")
	print(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.CIECLG.sttlToAcctCrncyRate = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		PRINT(CUST.CIECLG.sttlToAcctCrncyRate)
		#}
	ELSE
		#{
		CUST.CIECLG.scriptSuccess = "N"
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_s = "Error_1|Error^Could not get rate value for currency pair " +BANCS.STDIN.homeCrncyCode+ " AND " + CUST.CIECLG.instrumentAmtCcy + "^crAcctNum"
		sv_u = urhk_SetOrbOut(sv_s)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	##################################################################################
	# SRV Input
	##################################################################################
	
	sv_u = urhk_SetUrhkInp("zoneHeader.zoneCode|"+CUST.CIECLG.zoneCode)
	sv_s = CUST.CIECLG.zoneDate + " 00:00:00"
	sv_u = urhk_SetUrhkInp("zoneHeader.zoneDate|"+sv_s)
	sv_u = urhk_SetUrhkInp("zoneHeader.solId.solId|"+BANCS.STDIN.mySolId)
	
	CUST.CIECLG.bankCode = ""
	CUST.CIECLG.branchCode = ""
	IF(CUST.CIECLG.creditEntity == BANCS.STDIN.contextBankId)THEN
	#{
		sv_a = CUST.CIECLG.crAcctNum
		print(sv_a)
		CUST.CIECLG.bankCode = CUST.CIECLG.defaultBankCode
		CUST.CIECLG.branchCode = CUST.CIECLG.defaultBranchCode
		#}
	ELSE
		#{
		sv_a = CUST.CIECLG.nostroAcct
		print(sv_a)
		CUST.CIECLG.bankCode = CUST.CIECLG.instrumentBankCode
		CUST.CIECLG.branchCode = CUST.CIECLG.instrumentBranchCode
	#}
	ENDIF
	sv_u = urhk_SetUrhkInp("zoneHeader.crAcctId.foracid|"+sv_a)
	sv_u = urhk_SetUrhkInp("zoneHeader.totCrPartTranAmt|"+CUST.CIECLG.instrumentAmt + "|" + CUST.CIECLG.instrumentAmtCcy)
	sv_u = urhk_SetUrhkInp("zoneHeader.totInstrmntAmt|"+CUST.CIECLG.instrumentAmt + "|" + CUST.CIECLG.instrumentAmtCcy)
	
	sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.key.serial_num|1")
	sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.ptranAcctId.foracid|"+sv_a)
	sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.tranAmt|"+CUST.CIECLG.instrumentAmt + "|" + CUST.CIECLG.instrumentAmtCcy)
	sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.partTranAmtInInstCrncy|"+CUST.CIECLG.instrumentAmt + "|" + CUST.CIECLG.instrumentAmtCcy)
	
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.key.serial_num|1")
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.sortCode|"+CUST.CIECLG.instrumentSortCode)
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.bankBranchCode.bankCode|"+CUST.CIECLG.bankCode)
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.bankBranchCode.brCode|"+CUST.CIECLG.branchCode)
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.instrmntId|"+CUST.CIECLG.instrumentNum)
	sv_s = CUST.CIECLG.instrumentDate + " 00:00:00"
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.instrmntDate|"+sv_s)
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.instrmntAmt|"+CUST.CIECLG.instrumentAmt + "|" + CUST.CIECLG.instrumentAmtCcy)
	sv_s = CUST.CIECLG.valueDate + " 00:00:00"
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.valueDate|"+sv_s)
	sv_u = urhk_SetUrhkInp("instrLL.<rec_0>.payingAcctId|"+CUST.CIECLG.payingAcct)
	
	sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.sttlToAcctCrncyRateCode.refCode|"+CUST.CIECLG.sttlToAcctCrncyRateCode)
	sv_u = urhk_SetUrhkInp("ptranLL.<rec_0>.sttlToAcctCrncyRate|"+CUST.CIECLG.sttlToAcctCrncyRate)
	
	##################################################################################
	# SRV Output
	##################################################################################
	
	sv_u = urhk_SetUrhkOut("setInfo.setNum|setNum")
	
	##################################################################################
	# SRV Execution
	##################################################################################
	
	sv_u = urhk_ExecSrvNoCommit("SRV_LodgeOcSet|same_user_verify = Y|retain_all_output = Y")
	print(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		CALL("cieclgdp010.scr")
		
		IF(CUST.CIECLG.srvError == "Y")THEN
		#{
			CUST.CIECLG.scriptSuccess = "N"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.setNum)
	
	CUST.CIECLG.setNum = BANCS.OUTPARAM.setNum
	
	ENDOFSCRIPT:
END-->
