				sv_q = sv_q + "  SELECT  a.NRML_INT_PCNT,a.INT_TBL_CODE"
				sv_q = sv_q + " FROM tbaadm.lavs a"
				sv_q = sv_q + " WHERE a.INT_TBL_CODE IN  (SELECT b.INT_TBL_CODE  FROM tbaadm.csp b WHERE  b.bank_id = ?SVAR and b.schm_code = ?SVAR AND b.crncy_code = ?SVAR  AND b.del_flg != 'Y')"
				sv_q = sv_q + " AND a.crncy_code = ?SVAR "
				sv_q = sv_q + " AND a.INT_TBL_VER_NUM = (SELECT MAX (c.INT_TBL_VER_NUM)  FROM tbaadm.lavs c WHERE a.INT_TBL_CODE = c.INT_TBL_CODE AND a.crncy_code =c.crncy_code)"
				sv_q = sv_q + " AND bank_id =?SVAR "
			#{
			ELSE
			#}
				sv_q = "IntRate,IntTblCode|"
				sv_q = sv_q + "  SELECT  a.NRML_INT_PCNT,a.INT_TBL_CODE"
				sv_q = sv_q + " FROM tbaadm.ivs a"
				sv_q = sv_q + " WHERE a.INT_TBL_CODE IN  (SELECT b.INT_TBL_CODE  FROM tbaadm.csp b WHERE  b.bank_id = ?SVAR and b.schm_code = ?SVAR AND b.crncy_code = ?SVAR  AND b.del_flg != 'Y')"
				sv_q = sv_q + " AND a.crncy_code = ?SVAR "
				sv_q = sv_q + " AND a.INT_TBL_VER_NUM = (SELECT MAX (c.INT_TBL_VER_NUM)  FROM tbaadm.ivs c WHERE a.INT_TBL_CODE = c.INT_TBL_CODE AND a.crncy_code =c.crncy_code)"
				sv_q = sv_q + " AND bank_id =?SVAR AND NRML_INT_PCNT !=0"

			#}
			ENDIF
		
		print(sv_q)
		
		sv_e=urhk_dbSelectWithBind(sv_q)
		print(sv_e)
		IF(sv_e!=0) THEN
		#{
			INSU.LOAN.success="N"
			BANCS.OUTPUT.successOrFailure="F"
			sv_o=urhk_SetOrbOut("ErrorCode|No data found")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			INSU.LOAN.IntRate =BANCS.OUTPARAM.IntRate
			print(INSU.LOAN.IntRate)
			INSU.LOAN.IntTblCode =BANCS.OUTPARAM.IntTblCode
			print(INSU.LOAN.IntTblCode)
			IF (INSU.LOAN.IntTblCode == "INLAA")THEN
			#{	
				BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId + "|" +  BANCS.INPUT.inputCrncy
				print (BANCS.INPARAM.BINDVARS)
				sv_q = "maxVerNum,BaseRate|"
				sv_q = sv_q + "  SELECT MAX(INT_TBL_VER_NUM), BASE_PCNT_DR FROM TBAADM.TBA_INT_CODE_VERSION_TBL "
				sv_q = sv_q + "  WHERE BANK_ID = ?SVAR  "
				sv_q = sv_q + "  AND INT_TBL_CODE = 'BASER' "
				sv_q = sv_q + "  AND CRNCY_CODE = ?SVAR group by BASE_PCNT_DR "
				print(sv_q)

				sv_e=urhk_dbSelectWithBind(sv_q)
				print(sv_e)
				IF(sv_e!=0) THEN
				#{
					INSU.LOAN.success="N"
					BANCS.OUTPUT.successOrFailure="F"
					sv_o=urhk_SetOrbOut("ErrorCode|No data found")
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					INSU.LOAN.BaseRate =BANCS.OUTPARAM.BaseRate
					print(INSU.LOAN.BaseRate)
					INSU.LOAN.IntRate = CINT(INSU.LOAN.BaseRate) + CINT(INSU.LOAN.IntRate)
					PRINT(INSU.LOAN.IntRate)
				#}
				ENDIF
			#}
			ENDIF
			print(INSU.LOAN.IntRate)
			sv_a=urhk_SetOrbOut("IntRate|"+INSU.LOAN.IntRate)
		#}
		ENDIF
        INSU.LOAN.insAmt = "0"
        INSU.LOAN.laceAmt = "0"
        if((INSU.LOAN.DccId=="CRS")and ((INSU.LOAN.schmcode=="OD542") or (INSU.LOAN.schmcode=="OD543") or (INSU.LOAN.schmcode=="OD544") or (INSU.LOAN.schmcode=="OD545") or (INSU.LOAN.schmcode=="OD546")))then
                sv_u = urhk_getAcctDetailsInRepository(INSU.LOAN.Foracid)
                IF (sv_u != 0) THEN
                #{
                        INSU.LOAN.success="N"
                        BANCS.OUTPUT.successOrFailure="F"
                        sv_o=urhk_SetOrbOut("ErrorCode|Invalid Operative Account")
                        GOTO ENDOFSCRIPT
                        #}
                ELSE
                        #{
                        sv_o = BANCS.OUTPARAM.acctSolId
                        print(sv_o)
                        sv_c = BANCS.OUTPARAM.schmCode
                        print(sv_c)
                        sv_t = BANCS.OUTPARAM.schmType
                        print(sv_t)
                        INSU.LOAN.EffAmt = BANCS.OUTPARAM.EffAvailableAmt
                #}
                ENDIF
                INSU.LOAN.laceAmt = cdouble(INSU.LOAN.amnt) * 5/100
                print(INSU.LOAN.laceAmt)
                INSU.LOAN.insAmt = cdouble(INSU.LOAN.amnt) * 1/100
                print(INSU.LOAN.insAmt)
                INSU.LOAN.exciseDuty = cdouble(INSU.LOAN.laceAmt) *20/100
                print(INSU.LOAN.exciseDuty)
                INSU.LOAN.totalChrgAmt = cdouble(INSU.LOAN.laceAmt) + cdouble(INSU.LOAN.insAmt) + cdouble(INSU.LOAN.exciseDuty)
                print(INSU.LOAN.totalChrgAmt)
               sv_z = urhk_SetOrbOut("INSURANCE_AMT|"+INSU.LOAN.insAmt )
               print(sv_z)
               sv_z = urhk_SetOrbOut("LACE_AMT|"+INSU.LOAN.laceAmt )
               print(sv_z)
               sv_z = urhk_SetOrbOut("ExciseDuty|"+INSU.LOAN.exciseDuty)
               print(sv_z)
               sv_z = urhk_SetOrbOut("TotalChrgAmt|"+INSU.LOAN.totalChrgAmt )
               print(sv_z)
               sv_z = urhk_SetOrbOut("ACCT_EFFAVAILABLEAMT|"+INSU.LOAN.EffAmt )
               print(sv_z)
               sv_z = urhk_SetOrbOut("IntRate|"+INSU.LOAN.IntRate )
               print(sv_z)
        endif
	
	
	ENDOFSCRIPT:
		
		TRACE OFF
