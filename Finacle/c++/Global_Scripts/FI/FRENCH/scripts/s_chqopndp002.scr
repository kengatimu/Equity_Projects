#-------------------------------------------------------------------------------------
#    Name				: s_chqopndp002.scr
#    Description     	: In this script,during add and modify mode in TM, picks the details from dtd table
#						: for the instrument type present in c_cbt_int. then it picks the record from c_cbt for those cheques
#						: and updates the details for the cheque status for that record in C_CBT table.
#    Date            	: 15-03-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: NA
#    Menu Option		: HTM
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0			15-03-2013		Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="a46a2c239aa292b7a6d6e8ea1ecac5e84416d05a7dc5e5ccab76a8f89306048c"
	TRACE ON
	
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","ICHQ") == 0) THEN
	#{
		CREATECLASS("CUST","ICHQ",5)
	#}
	ENDIF
	
	
	BANCS.INPUT.moduleName  = "CHQOPN"
	BANCS.INPUT.parameterId = "NUMOFLVS"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ICHQ.noOflvs = BANCS.OUTPUT.parameterVal
		PRINT(CUST.ICHQ.noOflvs)
		
		#}
	ELSE
		#{
		CUST.ICHQ.errMsg = "Num of leaves setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	CUST.ICHQ.tranType = BANCS.OUTPARAM.srvValue
	PRINT(CUST.ICHQ.tranType)
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	CUST.ICHQ.tranSubType = BANCS.OUTPARAM.srvValue
	PRINT(CUST.ICHQ.tranSubType)
	
	
	sv_l = 0
	sv_a = ""
	sv_b = 0
	sv_c = ""
	sv_e = 0
	sv_f = ""
	sv_g = 0
	sv_i = ""
	sv_j = 0
	sv_k = ""
	sv_m = 0
	sv_n = ""
	sv_o = 0
	sv_p = ""
	sv_q = 0
	
	
	
	IF ((CUST.ICHQ.tranType != "C") AND (CUST.ICHQ.tranSubType != "NP")) THEN
	#{
		IF ((CUST.ICHQ.tranType != "T") AND (CUST.ICHQ.tranSubType != "CI")) THEN
		#{
			IF ((CUST.ICHQ.tranType != "T") AND (CUST.ICHQ.tranSubType != "BI")) THEN
			#{
				GOTO Finish
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------------
	# Get the number of accounts
	#-------------------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ICHQ.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.ICHQ.noOfRecords)
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_l = 0
	sv_a = ""
	sv_b = 0
	sv_c = ""
	sv_e = 0
	sv_f = ""
	sv_g = 0
	sv_i = ""
	sv_j = 0
	sv_k = ""
	sv_m = 0
	sv_n = ""
	sv_o = 0
	sv_p = ""
	sv_q = 0
	WHILE (sv_l < CUST.ICHQ.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		PRINT(sv_r)
		
		
		#-------------------------------------------------------------------------------------------
		# Fetch Foracid
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ICHQ.foracid = BANCS.OUTPARAM.srvValue
			PRINT(CUST.ICHQ.foracid)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Account Number")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO Finish
		#}
		ENDIF
		
		
		#-------------------------------------------------------------------------------------------
		# Fetch Instrument Type
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".instrmnt.instrmntType")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ICHQ.instrType = BANCS.OUTPARAM.srvValue
			PRINT(CUST.ICHQ.instrType)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Instrument Type")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO Finish
		#}
		ENDIF
		
		
		#-------------------------------------------------------------------------------------------
		# Fetch Key serial number
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ICHQ.srlNum = BANCS.OUTPARAM.srvValue
			PRINT(CUST.ICHQ.srlNum)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serial number")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO Finish
		#}
		ENDIF
		
		
		#-------------------------------------------------------------------------------------------
		# Fetch Instrument Number
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".instrmnt.instrmntNum")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ICHQ.instrNum = TRIM(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.ICHQ.instrNum)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Instrument Number")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO Finish
		#}
		ENDIF
		
		
		#-------------------------------------------------------------------------------------------
		# Fetch Instrument Date
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".instrmnt.instrmntDate")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ICHQ.instrDate = LEFT$(BANCS.OUTPARAM.srvValue,10)
			PRINT(CUST.ICHQ.instrDate)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Instrument Date")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO Finish
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch Part Tran Type
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ICHQ.pTranType = BANCS.OUTPARAM.srvValue
			PRINT(CUST.ICHQ.pTranType)
			#}
		ELSE
			#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Part Tran Type")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO Finish
		#}
		ENDIF
		
		IF (CUST.ICHQ.instrType == "") THEN
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		sv_s = "count|SELECT COUNT(1) "
		sv_s = sv_s + "FROM CUSTOM.C_CBT_INT "
		sv_s = sv_s + "WHERE inst_type = ?SVAR "
		sv_s = sv_s + "AND del_flg != 'Y' "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ICHQ.instrType + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF (sv_d == 0) THEN
		#{
			CUST.ICHQ.count = BANCS.OUTPARAM.count
			PRINT(CUST.ICHQ.count)
			#}
		ELSE
			#{
			CUST.ICHQ.count = ""
		#}
		ENDIF
		
		PRINT(CUST.ICHQ.count)
		IF (CINT(CUST.ICHQ.count) != 0) THEN
		#{
			IF (CUST.ICHQ.instrNum == "") THEN
			#{
				sv_a = sv_a + CUST.ICHQ.srlNum + ","
				PRINT(sv_a)
				
				sv_b = sv_b + 1
				PRINT(sv_b)
				GOTO NEXTREC
			#}
			ENDIF
			
			IF (CUST.ICHQ.instrDate == "") THEN
			#{
				sv_c = sv_c + CUST.ICHQ.srlNum + ","
				PRINT(sv_c)
				
				sv_e = sv_e + 1
				PRINT(sv_e)
				GOTO NEXTREC
			#}
			ENDIF
			#}
		ELSE
			#{
			GOTO Finish
		#}
		ENDIF
		
		IF ((CUST.ICHQ.foracid == "") OR (CUST.ICHQ.instrType == "") OR (CUST.ICHQ.instrNum == "") OR (CUST.ICHQ.instrDate == "")) THEN
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		
		CUST.ICHQ.num_lvs = CUST.ICHQ.noOflvs
		
		
		sv_s = "acid,chq_issu_date,begin_chq_num,chq_num_of_lvs,chq_lvs_stat,num_paid,num_unused,num_stoped,num_destroyed|"
		sv_s = sv_s + "SELECT acid,chq_issu_date,begin_chq_num,chq_num_of_lvs,chq_lvs_stat,num_paid,num_unused,num_stoped,num_destroyed "
		sv_s = sv_s + "FROM CUSTOM.C_CBT "
		sv_s = sv_s + "WHERE inst_type = ?SVAR "
		sv_s = sv_s + "AND foracid = ?SVAR "
		sv_s = sv_s + "AND begin_chq_num <= TO_NUMBER(?SVAR) "
		sv_s = sv_s + "AND (begin_chq_num+chq_num_of_lvs-1) >= TO_NUMBER(?SVAR) "
		sv_s = sv_s + "AND (TO_NUMBER(?SVAR) BETWEEN begin_chq_num "
		sv_s = sv_s + "AND (begin_chq_num + chq_num_of_lvs - 1)) "
		sv_s = sv_s + "AND chq_issu_date <= TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + "AND DEL_FLG != 'Y' "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ICHQ.instrType + "|" + CUST.ICHQ.foracid + "|" + CUST.ICHQ.instrNum + "|" + CUST.ICHQ.instrNum + "|" + CUST.ICHQ.instrNum + "|" + CUST.ICHQ.instrDate + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d != 0) THEN
		#{
			sv_f = sv_f + CUST.ICHQ.srlNum + ","
			PRINT(sv_f)
			
			sv_g = sv_g + 1
			PRINT(sv_g)
			#}
		ELSE
			#{
			
			CUST.ICHQ.acid           = BANCS.OUTPARAM.acid
			CUST.ICHQ.chq_issu_date  = BANCS.OUTPARAM.chq_issu_date
			CUST.ICHQ.begin_chq_num  = BANCS.OUTPARAM.begin_chq_num
			CUST.ICHQ.chq_num_of_lvs = BANCS.OUTPARAM.chq_num_of_lvs
			CUST.ICHQ.chq_lvs_stat   = BANCS.OUTPARAM.chq_lvs_stat
			CUST.ICHQ.num_paid       = BANCS.OUTPARAM.num_paid
			CUST.ICHQ.num_unused     = BANCS.OUTPARAM.num_unused
			CUST.ICHQ.num_stoped     = BANCS.OUTPARAM.num_stoped
			CUST.ICHQ.num_destroyed  = BANCS.OUTPARAM.num_destroyed
			
			PRINT(CUST.ICHQ.begin_chq_num)
			PRINT(CUST.ICHQ.chq_num_of_lvs)
			PRINT(CUST.ICHQ.chq_lvs_stat)
			PRINT(CUST.ICHQ.num_paid)
			PRINT(CUST.ICHQ.num_unused)
			PRINT(CUST.ICHQ.num_stoped)
			PRINT(CUST.ICHQ.num_destroyed)
			#---------------------------------
			# Finding The status of the field
			#---------------------------------
			#PRINT(CUST.ICHQ.instrmnt_num)
			PRINT(CUST.ICHQ.instrNum)
			#PRINT(CUST.ICHQ.begin_chq_num)
			
			IF (CUST.ICHQ.instrNum != CUST.ICHQ.begin_chq_num) THEN
			#{
				CUST.ICHQ.temp = CINT(CUST.ICHQ.instrNum) - CINT(CUST.ICHQ.begin_chq_num)
				PRINT(CUST.ICHQ.temp)
				#}
			ELSE
				#{
				CUST.ICHQ.temp = "0"
				PRINT(CUST.ICHQ.temp)
			#}
			ENDIF
			
			PRINT(CUST.ICHQ.temp)
			CUST.ICHQ.temp = CINT(CUST.ICHQ.temp) + 1
			PRINT(CUST.ICHQ.temp)
			
			CUST.ICHQ.currStatus = "SUBSTR(CHQ_LVS_STAT," + CUST.ICHQ.temp + "," + CUST.ICHQ.num_lvs + ")"
			PRINT(CUST.ICHQ.currStatus)
			
			
			sv_s = "current_status|"
			sv_s = sv_s + "SELECT "
			sv_s = sv_s + CUST.ICHQ.currStatus
			sv_s = sv_s + "FROM CUSTOM.C_CBT "
			sv_s = sv_s + "WHERE inst_type = ?SVAR "
			sv_s = sv_s + "AND foracid = ?SVAR "
			sv_s = sv_s + "AND begin_chq_num <= TO_NUMBER(?SVAR) "
			sv_s = sv_s + "AND (begin_chq_num+chq_num_of_lvs-1) >= TO_NUMBER(?SVAR) "
			sv_s = sv_s + "AND (TO_NUMBER(?SVAR) BETWEEN begin_chq_num "
			sv_s = sv_s + "AND (begin_chq_num + chq_num_of_lvs - 1)) "
			sv_s = sv_s + "AND chq_issu_date <= TO_DATE(?SVAR,'DD-MM-YYYY') "
			sv_s = sv_s + "AND DEL_FLG != 'Y' "
			sv_s = sv_s + "AND bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.ICHQ.instrType + "|" + CUST.ICHQ.foracid + "|" + CUST.ICHQ.instrNum + "|" + CUST.ICHQ.instrNum + "|" + CUST.ICHQ.instrNum + "|" + CUST.ICHQ.instrDate + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d != 0) THEN
			#{
				sv_i = sv_i + CUST.ICHQ.srlNum + ","
				PRINT(sv_i)
				
				sv_j = sv_j + 1
				PRINT(sv_j)
				#}
			ELSE
				#{
				CUST.ICHQ.current_status = TRIM(BANCS.OUTPARAM.current_status)
				PRINT(CUST.ICHQ.current_status)
				
				IF (CUST.ICHQ.current_status == "P") THEN
				#{
					sv_k = sv_k + CUST.ICHQ.srlNum + ","
					PRINT(sv_k)
					
					sv_m = sv_m + 1
					PRINT(sv_m)
				#}
				ENDIF
				IF (CUST.ICHQ.current_status == "S") THEN
				#{
					sv_n = sv_n + CUST.ICHQ.srlNum + ","
					PRINT(sv_n)
					
					sv_o = sv_o + 1
					PRINT(sv_o)
				#}
				ENDIF
				IF (CUST.ICHQ.current_status == "D") THEN
				#{
					sv_p = sv_p + CUST.ICHQ.srlNum + ","
					PRINT(sv_p)
					
					sv_q = sv_q + 1
					PRINT(sv_q)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		NEXTREC:
			sv_l = sv_l + 1
			PRINT(sv_l)
		#}
		DO
		
	Finish:
		
		IF (sv_b > 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_a = RTRIM(sv_a,',')
			PRINT(sv_a)
			sv_a = "Instrument Number should be enterd for the part tran srl no :  " + sv_a
			PRINT(sv_a)
			sv_u = urhk_SRV_SetErr(sv_a)
		#}
		ENDIF
		
		IF (sv_e > 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_c = RTRIM(sv_c,',')
			sv_c = "Instrument Date should be enterd for the part tran srl no :  " + sv_c
			PRINT(sv_c)
			sv_u = urhk_SRV_SetErr(sv_c)
		#}
		ENDIF
		
		IF (sv_g > 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_f = RTRIM(sv_f,',')
			sv_f = "Cheque not issued for the part tran srl no :  " + sv_f
			PRINT(sv_f)
			sv_u = urhk_SRV_SetErr(sv_f)
		#}
		ENDIF
		
		IF (sv_j > 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_i = RTRIM(sv_i,',')
			sv_i = "DataBase Error. Contact your DBA for the part tran srl no :  " + sv_i
			PRINT(sv_i)
			sv_u = urhk_SRV_SetErr(sv_i)
		#}
		ENDIF
		
		IF (sv_m > 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_k = RTRIM(sv_k,',')
			sv_k = "Chq already paid for the part tran srl no :  " + sv_k
			PRINT(sv_k)
			sv_u = urhk_SRV_SetErr(sv_k)
		#}
		ENDIF
		
		IF (sv_o > 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_n = RTRIM(sv_n,',')
			sv_n = "Chq stoped for the part tran srl no :  " + sv_n
			PRINT(sv_n)
			sv_u = urhk_SRV_SetErr(sv_n)
		#}
		ENDIF
		
		IF (sv_q > 0) THEN
		#{
			BANCS.OUTPUT.successOrFailure = "F"
			sv_p = RTRIM(sv_p,',')
			sv_p = "Chq destroyed for the part tran srl no :  " + sv_p
			PRINT(sv_p)
			sv_u = urhk_SRV_SetErr(sv_p)
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
