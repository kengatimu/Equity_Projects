		sv_q = "hldyPerdIntFlg, hldyPerdFreqType, hldyPerdFreqWeekNum, hldyPerdFreqWeekDay, hldyPerdFreqStartDD, hldyPerdFreqHldyStat, hldyPerdFreqCalBase, autoReshdlAfterHldyPerd "
