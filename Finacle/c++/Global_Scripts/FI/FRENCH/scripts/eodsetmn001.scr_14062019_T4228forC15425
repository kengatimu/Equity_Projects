		print(CUST.DATA.userId)
		IF ((CUST.DATA.userId!="Y") AND (CUST.DATA.userId!="N")) THEN
			CUST.DATA.resultMsg = "Please Enter N/Y to Change Status .... Status Change Failed"
			GOTO ENDOFSCRIPT
		ENDIF
		sv_a = " update CUSTOM.TRANS_STATUS set STATUS=?SVAR ,STATUS_EXMP =?SVAR  "
		sv_a = sv_a + " where bank_id=?SVAR and MENU_OPTION=?SVAR and del_flg='N' "
		print(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.DATA.userId + "|" + CUST.DATA.userId + "|" + BANCS.STDIN.contextBankId + "|" +  CUST.DATA.funcCode
		print(BANCS.INPARAM.BINDVARS)
		sv_b =  urhk_dbSqlWithBind(sv_a)
		print(sv_b)
		IF(sv_b == 0)THEN
		#{
