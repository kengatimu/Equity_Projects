IF ( CUST.DATA.funcCode == "LOAN" ) THEN
#{
	sv_a = " update tbaadm.ldt set del_flg='Y' where bank_id=?SVAR and acid in (select acid from tbaadm.gam where bank_id=?SVAR  "
	sv_a = sv_a + " and foracid=?SVAR ) and DMD_FLOW_ID='OCDEM' "
	print(sv_a)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.contextBankId  + "|" + CUST.DATA.userId 
	print(BANCS.INPARAM.BINDVARS)
	sv_b =  urhk_dbSqlWithBind(sv_a)
	print(sv_b)
	IF(sv_b == 0)THEN
	#{
		sv_d = urhk_dbSqlWithBind("COMMIT")
		print(sv_d)
		CUST.DATA.resultMsg = "LOAN Reset is Successful"
		sv_a = " update tbaadm.lam set OCHG_DMD_OS=0 where bank_id=?SVAR and acid in (select acid from tbaadm.gam where bank_id=?SVAR  "
		sv_a = sv_a + " and foracid=?SVAR ) "
		print(sv_a)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.contextBankId  + "|" + CUST.DATA.userId 
		print(BANCS.INPARAM.BINDVARS)
		sv_b =  urhk_dbSqlWithBind(sv_a)
		print(sv_b)
		IF(sv_b == 0)THEN
		#{
			sv_d = urhk_dbSqlWithBind("COMMIT")
			print(sv_d)
			CUST.DATA.resultMsg = "LOAN Reset is Successful"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			sv_d = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_d)
			CUST.DATA.resultMsg = "LOAN Reset Failed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		sv_d = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_d)
		CUST.DATA.resultMsg = "LOAN Reset Failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF


