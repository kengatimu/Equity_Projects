ENDOFSCRIPT:
IF (CUST.DATA.errMsg != "") THEN
#{
	sv_s = "Error_01|ERROR:^"+ CUST.DATA.errMsg +"^"+CUST.DATA.errFld
	sv_u = urhk_SetOrbOut(sv_s)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
#}
ELSE
#{
	sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
	sv_g = "RESULT_MSG|" + CUST.DATA.resultMsg
	sv_z = urhk_SetOrbOut(sv_g)
