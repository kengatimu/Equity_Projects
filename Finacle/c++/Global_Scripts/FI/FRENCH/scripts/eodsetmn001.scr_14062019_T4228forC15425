IF  ((CUST.DATA.funcCode == "P") OR (CUST.DATA.funcCode == "Q") OR (CUST.DATA.funcCode == "R") OR (CUST.DATA.funcCode == "S") OR (CUST.DATA.funcCode == "T") OR (CUST.DATA.funcCode == "U")  OR (CUST.DATA.funcCode == "V")  OR (CUST.DATA.funcCode == "W")) THEN
#{
	IF ( CUST.DATA.funcCode =="P" ) THEN 
	CUST.DATA.jobid="PRSL1"
	print(CUST.DATA.jobid)
	ENDIF

	IF ( CUST.DATA.funcCode =="Q" ) THEN 
		CUST.DATA.jobid="PRSL2"
		print(CUST.DATA.jobid)
	ENDIF
	IF ( CUST.DATA.funcCode =="R" ) THEN 
		CUST.DATA.jobid="PRDC1"
		print(CUST.DATA.jobid)
	ENDIF
	IF ( CUST.DATA.funcCode =="S" ) THEN 
		CUST.DATA.jobid="PRDC2"
		print(CUST.DATA.jobid)
	ENDIF
	IF ( CUST.DATA.funcCode =="T" ) THEN 
		CUST.DATA.jobid="PSDCD"
		print(CUST.DATA.jobid)
	ENDIF
	IF ( CUST.DATA.funcCode =="U" ) THEN 
		CUST.DATA.jobid="PSSCD"
		print(CUST.DATA.jobid)
	ENDIF
	IF ( CUST.DATA.funcCode =="V" ) THEN 
		CUST.DATA.jobid="DCCOP"
		print(CUST.DATA.jobid)
	ENDIF
	IF ( CUST.DATA.funcCode =="W" ) THEN 
		CUST.DATA.jobid="SLCOP"
		print(CUST.DATA.jobid)
	ENDIF
	sv_a = " update tbaadm.bjs set next_exec_date= ?SVAR  where job_type='EOD'  "
	sv_a = sv_a + " and bank_id= ?SVAR  and sol_id = ?SVAR and job_id=?SVAR "
	print(sv_a)
	BANCS.INPARAM.BINDVARS = CUST.DATA.userId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + CUST.DATA.jobid 
	print(BANCS.INPARAM.BINDVARS)
	sv_b =  urhk_dbSqlWithBind(sv_a)
	print(sv_b)
	IF(sv_b == 0)THEN
	#{
		sv_d = urhk_dbSqlWithBind("COMMIT")
		print(sv_d)
