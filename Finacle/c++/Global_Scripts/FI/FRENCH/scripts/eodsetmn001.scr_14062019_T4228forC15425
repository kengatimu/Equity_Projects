IF ( CUST.DATA.funcCode == "BGD" ) THEN
#{
	IF (BANCS.STDIN.userWorkClass> 514) THEN
	
		print(CUST.DATA.userId)
		CUST.DATA.phone= MID$(CUST.DATA.userId,0,12)
		print(CUST.DATA.phone)
		CUST.DATA.phonelen = STRLEN(CUST.DATA.phone)
			IF (CINT(CUST.DATA.phonelen) != 12) THEN
				CUST.DATA.resultMsg = "FORMAT 254763123456000 FOR SOL_ID 000 . Failed"
				GOTO ENDOFSCRIPT
			ENDIF
		CUST.DATA.sol= MID$(CUST.DATA.userId,12,15)
		print(CUST.DATA.sol)
		CUST.DATA.sollen = STRLEN(CUST.DATA.sol)
			IF (CINT(CUST.DATA.sollen) < 3) THEN
				CUST.DATA.resultMsg = "FORMAT 254763123456000 FOR SOL_ID 000. Failed"
			GOTO ENDOFSCRIPT
		ENDIF

#Search if the sol has another record if yes set del_flg yes
		sv_a = " count|"
		sv_a = sv_a + " select count(*) from CUSTOM.OTHERS_EXEMPTION_TABLE where SOL_ID = ?SVAR  "
		sv_a = sv_a + "  and bank_id = ?SVAR and del_flg ='N' "
		print(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.DATA.sol  + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_a)
		print(sv_b)
			IF(sv_b == 0)THEN
			IF (CINT(BANCS.OUTPARAM.count) > 0) THEN
					BANCS.INPARAM.BINDVARS = CUST.DATA.sol + "|" + BANCS.STDIN.contextBankId 
					PRINT(BANCS.INPARAM.BINDVARS)						
					sv_a=" delete  CUSTOM.OTHERS_EXEMPTION_TABLE where SOL_ID = ?SVAR AND BANK_ID = ?SVAR "
					#sv_a = " update CUSTOM.OTHERS_EXEMPTION_TABLE  SET DEL_FLG = 'Y' WHERE SOL_ID = ?SVAR AND BANK_ID = ?SVAR "	
					sv_d = urhk_dbSQLWithBind(sv_a)
					print(sv_d)
				ELSE
					GOTO PHONESEARCH
				ENDIF

			ELSE
				GOTO PHONESEARCH

			ENDIF
PHONESEARCH:
#Search if phone exist, if yes update , if no insert
		sv_a = " count2|"
		sv_a = sv_a + " select count(*) from CUSTOM.OTHERS_EXEMPTION_TABLE where PHONE_NUMBER = ?SVAR  "
		sv_a = sv_a + " and bank_id = ?SVAR "
		print(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.DATA.phone + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_b = urhk_dbSelectWithBind(sv_a)
		print(sv_b)
		IF(sv_b == 0)THEN
			print(BANCS.OUTPARAM.count2)		
			IF (CINT(BANCS.OUTPARAM.count2) > 0) THEN
				BANCS.INPARAM.BINDVARS = CUST.DATA.sol + "|" + CUST.DATA.phone + "|" + BANCS.STDIN.contextBankId  
				PRINT(BANCS.INPARAM.BINDVARS)				
				sv_a=" delete  CUSTOM.OTHERS_EXEMPTION_TABLE where SOL_ID = ?SVAR AND BANK_ID = ?SVAR "
				sv_a = " update CUSTOM.OTHERS_EXEMPTION_TABLE  SET DEL_FLG = 'N', SOL_ID = ?SVAR  WHERE PHONE_NUMBER = ?SVAR AND BANK_ID = ?SVAR "	
				sv_d = urhk_dbSQLWithBind(sv_a)
				print(sv_d)
					IF(sv_b == 0)THEN
					#{
						sv_d = urhk_dbSqlWithBind("COMMIT")
						print(sv_d)
						CUST.DATA.resultMsg = "Adding phone no. is Successful"
						GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						sv_d = urhk_dbSqlWithBind("ROLLBACK")
						print(sv_d)
						CUST.DATA.resultMsg = "Adding phone no. Failed"
						GOTO ENDOFSCRIPT
					#}
					ENDIF	
			
			ELSE
					sv_a = " Insert into CUSTOM.OTHERS_EXEMPTION_TABLE(SOL_ID,PHONE_NUMBER,EXEMPT_CODE, BANK_ID, DEL_FLG)  "
					sv_a = sv_a + " Values   (?SVAR,?SVAR,'DISBURSE', ?SVAR, 'N') "
					print(sv_a)
					BANCS.INPARAM.BINDVARS = CUST.DATA.sol + "|" + CUST.DATA.phone + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					sv_b =  urhk_dbSqlWithBind(sv_a)
					print(sv_b)
					IF(sv_b == 0)THEN
					#{
						sv_d = urhk_dbSqlWithBind("COMMIT")
						print(sv_d)
						CUST.DATA.resultMsg = "Adding phone no. is Successful"
						GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						sv_d = urhk_dbSqlWithBind("ROLLBACK")
						print(sv_d)
						CUST.DATA.resultMsg = "Adding phone no. Failed"
						GOTO ENDOFSCRIPT
					#}
					ENDIF	
			ENDIF

		ELSE
			GOTO ENDOFSCRIPT

		ENDIF


	
	ELSE
			CUST.DATA.resultMsg = "Work Class 515 and Above .. Failed"
			GOTO ENDOFSCRIPT
	ENDIF
#}
ENDIF

