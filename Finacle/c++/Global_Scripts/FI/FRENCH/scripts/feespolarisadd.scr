<--START
CHECKSUM="49988e43706e18db404f1467b3dcd029a6ddbdf3b1d0f2e9be554927d3d99f3d"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	
	MISS.CHRG.errMsg    = ""
	MISS.CHRG.crAccount = ""
	MISS.CHRG.drAccount = ""
	MISS.CHRG.zoneCode  = ""
	MISS.CHRG.zoneSolid = ""
	MISS.CHRG.desc      = ""
	MISS.CHRG.amount    = "0"
	MISS.CHRG.zoneDate  = ""
	MISS.CHRG.refCode   = ""
	
	MISS.CHRG.crAccountincomee ="6500304382"
	print(MISS.CHRG.crAccountincomee)
	print(MISS.CHRG.solidsh)
	MISS.CHRG.crAccount = MISS.CHRG.solidsh + MISS.CHRG.crAccountincomee
	PRINT(MISS.CHRG.crAccount)
	
	
	MISS.CHRG.drAccount = MISS.CHRG.chrgs_accnt
	
	
	MISS.CHRG.amount = MISS.CHRG.sum_fees
	PRINT(MISS.CHRG.amount)
	
	MISS.CHRG.zoneDate="Salary Charges"
	print(MISS.CHRG.zoneDate)
	MISS.CHRG.parttrnrmks = MID$(MISS.CHRG.parttrnrmks,0,30)
	print(MISS.CHRG.parttrnrmks)
	MISS.CHRG.desc = MISS.CHRG.parttrnrmks
	print(MISS.CHRG.desc)
	MISS.CHRG.narr = MISS.CHRG.parttrnrmks
	PRINT(MISS.CHRG.narr)
	MISS.CHRG.narr2 = MISS.CHRG.zoneDate + " " + MISS.CHRG.desc
	PRINT(MISS.CHRG.narr2)
	MISS.CHRG.narr2 = MID$(MISS.CHRG.narr2,0,50)
	PRINT(MISS.CHRG.narr2)
	#---------------------------------------------------------------
	# Passing transaction inputs to the service
	# Adding and Posting the transaction
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+MISS.CHRG.narr)
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	sv_w = "tranDtl.partTranDetailLL.<rec_0>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|1")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|C")
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+MISS.CHRG.crAccount)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+MISS.CHRG.narr2)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks|"+MISS.CHRG.narr)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+MISS.CHRG.amount+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+MISS.CHRG.amount+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + MISS.CHRG.refCode)
	
	sv_w = "tranDtl.partTranDetailLL.<rec_1>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|2")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|D")
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+MISS.CHRG.drAccount)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+MISS.CHRG.narr2)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks|"+MISS.CHRG.narr)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+MISS.CHRG.amount+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|"+MISS.CHRG.narr2)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+MISS.CHRG.amount+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + MISS.CHRG.refCode)
	
	sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
	PRINT(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
		PRINT(sv_u)
	#}
	ENDIF
	
	IF (sv_u == 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (sv_u != 0) THEN
	#{
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
	#{
		PRINT(BANCS.OUTPARAM.tranId)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (MISS.CHRG.errMsg != "") THEN
		#{
			PRINT(MISS.CHRG.errMsg)
			sv_u = system("echo '"+MISS.CHRG.errMsg+"' >>RGZN1.log")
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
