#-------------------------------------------------------------------------------------
#     NAME            : denomdp012.scr
#     DATE            : 25-JUL-2010
#     DESCRIPTION     : This script performs the MTT transaction between the teller
#                       accounts and the PandL accounts for Round off Amounts and sends
#			the result to denomdp014.scr file to be recorded as a report
#     MENU OPTION     : HDENRO
#     CALLING SCRIPT  : denomdp014.scr
#     AUTHOR NAME     : Sandeep Patil
#     MODULE CODE     :	DENOM
#     MODIFICATION
#     HISTORY         :
#                       Serial.No       Date	   AuthorName      Description
#-------------------------------------------------------------------------------------

<--START
CHECKSUM="8dae04470f40dcbb8bf3631516da5ef4e9ca744fc4db602d6aa70a44f6d8c613"
	TRACE ON
	
	sv_q = urhk_B2k_PrintRepos("BANCS")
	print(sv_q)
	
	#-------------------------------------------------------------------------------------
	# CREATION OF REPOSITORIES
	#-------------------------------------------------------------------------------------
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST","DENOM",5)
	#}
	ENDIF
	
	sv_k = 0
	sv_l = 0
	
	IF(REPEXISTS("MTT") == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT","InputDetails")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS("MTT","InputDetails",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("MTT", "TranDetails") == 0) THEN
	#{
		CREATECLASS("MTT", "TranDetails", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("MTT", "PartTranDetails") == 0) THEN
	#{
		CREATECLASS("MTT", "PartTranDetails", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("MTT", "Error") == 0) THEN
	#{
		CREATECLASS("MTT", "Error", 5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------
	# DEFINE TRANSACTION
	#-----------------------------------------------------------------------------------
	
	BANCS.INPARAM.PostTranFlg               = "Y"
	BANCS.INPARAM.CommitFlg                 = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
	BANCS.INPARAM.ValidationFlag            = "Y"
	BANCS.INPARAM.RestrictModifyInd         = "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw          = "Y"
	BANCS.INPARAM.CheckExceptions           = "N"
	BANCS.INPARAM.proxyPostFlg              = "Y"
	
	sv_u = urhk_MTTS_Initialize("")
	print(sv_u)
	
	#-----------PRINT OUT THE VALUES OBTAINED FROM FRONT END : START ---------------------
	
	print(CUST.DENOM.teller_acct)
	print(CUST.DENOM.crncy_code)
	print(CUST.DENOM.value_date)
	print(CUST.DENOM.pandl_acct)
	print(CUST.DENOM.round_off_amt)
	print(CUST.DENOM.Parttran)
	
	#-----------PRINT OUT THE VALUES OBTAINED FROM FRONT END : END ---------------------
	
	CUST.DENOM.MTTErrMsg = ""
	CUST.DENOM.status = "Y"
	#----------------------------------------------------------------------------------------
	#	MTT Main Tran Details - TRANSFER C-CR TYPE
	#----------------------------------------------------------------------------------------
	
	MTT.TranDetails.TranDateDiff            = "0"
	MTT.TranDetails.TranType                = "C"
	MTT.TranDetails.IgnoreExcp              = "I"
	MTT.TranDetails.Consolidate             = "N"
	MTT.TranDetails.ReversalFlag            = "N"
	MTT.TranDetails.Remarks                 = "TRANSFER"
	MTT.TranDetails.PostFlag                = "Y"
	MTT.TranDetails.TranDate                = "0"
	MTT.TranDetails.ErrorCheckForLuw        = "N"
	CUST.DENOM.tran_identifier		= "DENOM"
	IF(CUST.DENOM.Parttran == "C") THEN
	#{
		MTT.TranDetails.TranSubType = "CP"
		#}
	ELSE
		#{
		MTT.TranDetails.TranSubType = "CR"
	#}
	ENDIF
	print(MTT.TranDetails.TranSubType)
	
	sv_r = urhk_MTTS_DefineTransaction(CUST.DENOM.tran_identifier)
	print(sv_r)
	
	IF(sv_r == 1) THEN
	#{
		IF(fieldexists(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
			sv_p = "echo " + MTT.Error.Description+ " >> " + CUST.DENOM.SuccessFile
			sv_a = system(sv_p)
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.FLAG2 = "Y"
			GOTO FAIL
			#}
		ELSE
			#{
			IF(CUST.DENOM.FLAG4 == "N")THEN
			#{
				sv_x = rpad("TELLERID",15)+rpad("CRNCYCODE",15)+rpad("SOLID",10)+"---------- "+ rpad("Message",20)
				print(sv_x)
				sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
				print(sv_v)
				sv_b = system(sv_v)
				sv_a = "---------------------------------------------------------------------------"
				print(sv_a)
				sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
				print(sv_c)
				sv_d = system(sv_c)
				CUST.DENOM.FLAG4 = "Y"
			#}
			ENDIF
			print(CUST.DENOM.SuccessFile)
			sv_y = rpad(CUST.DENOM.teller_id,15)+","+rpad(CUST.DENOM.crncy_code,15)+","+rpad(CUST.DENOM.solId,10)+"---------Could not define the Transaction"
			print(sv_y)
			sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
			print(sv_p)
			sv_a = system(sv_p)
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.FLAG2 = "Y"
			GOTO FAIL
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------POPULATE INPUT DETAILS : START ------------------------------------------------------------------------
	
	sv_r = urhk_MTTS_PopulateInputDetails("")
	print(sv_r)
	
	IF (sv_r != 0) THEN
	#{
		IF(CUST.DENOM.MTTErrMsg == "") THEN
		#{
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				sv_p = "echo " + MTT.Error.Description + " >> " + CUST.DENOM.SuccessFile
				sv_a = system(sv_p)
				BANCS.OUTPUT.successOrFailure = "F"
				CUST.DENOM.FLAG2 = "Y"
				GOTO FAIL
				#}
			ELSE
				#{
				IF(CUST.DENOM.FLAG4 == "N")THEN
				#{
					sv_x = rpad("TELLERID",15)+rpad("CRNCYCODE",15)+rpad("SOLID",10)+"---------- "+ rpad("Message",20)
					print(sv_x)
					sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
					print(sv_v)
					sv_b = system(sv_v)
					sv_a = "---------------------------------------------------------------------------"
					print(sv_a)
					sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
					print(sv_c)
					sv_d = system(sv_c)
					CUST.DENOM.FLAG4 = "Y"
				#}
				ENDIF
				print(CUST.DENOM.SuccessFile)
				sv_y = rpad(CUST.DENOM.teller_id,15)+","+rpad(CUST.DENOM.crncy_code,15)+","+rpad(CUST.DENOM.solId,10)+"--------Unable to Define MTT transaction"
				print(sv_y)
				sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
				print(sv_p)
				sv_a = system(sv_p)
				BANCS.OUTPUT.successOrFailure = "F"
				CUST.DENOM.FLAG2 = "Y"
				GOTO FAIL
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------POPULATE INPUT DETAILS : END ------------------------------------------------------------------------------------------
	
	sv_a = urhk_B2k_getDateDiffFromBODDate(CUST.DENOM.value_date)
	print(sv_a)
	
	IF(sv_a == 0) THEN
	#{
		CUST.DENOM.DateDiff = BANCS.OUTPARAM.DateDiff
		print(CUST.DENOM.DateDiff)
		#}
	ELSE
		#{
		CUST.DENOM.DateDiff = "0"
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------
	# POPULATE THE DETAILS AND CREDIT THE FIRST PART TRAN
	#-------------------------------------------------------------------------------------
	
	MTT.PartTranDetails.RefAmount		= CDOUBLE(CUST.DENOM.round_off_amt)
	MTT.PartTranDetails.Amount		= CDOUBLE(CUST.DENOM.round_off_amt)
	MTT.PartTranDetails.Account		= CUST.DENOM.teller_acct
	print(MTT.PartTranDetails.Amount)
	print(MTT.PartTranDetails.Account)
	MTT.PartTranDetails.RefCurrency	        = CUST.DENOM.crncy_code
	MTT.PartTranDetails.TranCurrency	= CUST.DENOM.crncy_code
	MTT.PartTranDetails.CarveAmtFlg		= "Y"
	MTT.PartTranDetails.Refnum		= ""
	MTT.PartTranDetails.Remarks		= ""
	MTT.PartTranDetails.Particulars		= "Denomination Round OFF"
	MTT.PartTranDetails.TranIdentifier	= CUST.DENOM.tran_identifier
	print(MTT.PartTranDetails.TranIdentifier)
	#MTT.PartTranDetails.Consolidate	= "Y"
	MTT.PartTranDetails.TODRefType		= "IC"
	MTT.PartTranDetails.ValueDateDiff	= CUST.DENOM.DateDiff
	MTT.PartTranDetails.ValueDate		= CUST.DENOM.DateDiff
	#MTT.PartTranDetails.PTranBusinessType	= "CREDIT"
	sv_y = "DENOM ROUND OFF"
	print(sv_y)
	
	sv_r = urhk_MTTS_DefinePartTran(sv_y)
	print(sv_r)
	
	print(MTT.PartTranDetails.Amount)
	IF (sv_r != 0) THEN
	#{
		IF(CUST.DENOM.MTTErrMsg == "") THEN
		#{
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				sv_p = "echo " + MTT.Error.Description + " >> " + CUST.DENOM.SuccessFile
				sv_a = system(sv_p)
				BANCS.OUTPUT.successOrFailure = "F"
				CUST.DENOM.FLAG2 = "Y"
				CUST.DENOM.status = "N"
				GOTO FAIL
				#}
			ELSE
				#{
				IF(CUST.DENOM.FLAG4 == "N")THEN
				#{
					sv_x = rpad("TELLERID",15)+rpad("CRNCYCODE",15)+rpad("SOLID",10)+"---------- "+ rpad("Message",20)
					print(sv_x)
					sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
					print(sv_v)
					sv_b = system(sv_v)
					sv_a = "---------------------------------------------------------------------------"
					print(sv_a)
					sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
					print(sv_c)
					sv_d = system(sv_c)
					CUST.DENOM.FLAG4 = "Y"
				#}
				ENDIF
				print(CUST.DENOM.SuccessFile)
				sv_y = rpad(CUST.DENOM.teller_id,15)+","+rpad(CUST.DENOM.crncy_code,15)+","+rpad(CUST.DENOM.solId,10)+"--------Unable to Define the Part Transaction"
				print(sv_y)
				sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
				print(sv_p)
				sv_a = system(sv_p)
				BANCS.OUTPUT.successOrFailure = "F"
				CUST.DENOM.FLAG2 = "Y"
				CUST.DENOM.status = "N"
				GOTO FAIL
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	#-------------------------------------------------------------------------------------
	# POPULATE THE DETAILS AND DEBIT THE SECOND PART TRAN
	#-------------------------------------------------------------------------------------
	
	MTT.PartTranDetails.RefAmount		= -CDOUBLE(CUST.DENOM.round_off_amt)
	MTT.PartTranDetails.Amount		= -CDOUBLE(CUST.DENOM.round_off_amt)
	MTT.PartTranDetails.Account		= CUST.DENOM.pandl_acct
	print(MTT.PartTranDetails.Amount)
	print(MTT.PartTranDetails.Account)
	MTT.PartTranDetails.RefCurrency		= CUST.DENOM.crncy_code
	MTT.PartTranDetails.TranCurrency	= CUST.DENOM.crncy_code
	MTT.PartTranDetails.CarveAmtFlg		= "Y"
	MTT.PartTranDetails.Refnum		= ""
	MTT.PartTranDetails.Remarks		= ""
	MTT.PartTranDetails.Particulars		= "Denomination Round OFF"
	MTT.PartTranDetails.TranIdentifier	= CUST.DENOM.tran_identifier
	print(MTT.PartTranDetails.TranIdentifier)
	#MTT.PartTranDetails.Consolidate	= "Y"
	MTT.PartTranDetails.TODRefType		= "IC"
	MTT.PartTranDetails.ValueDateDiff	= CUST.DENOM.DateDiff
	MTT.PartTranDetails.ValueDate		= CUST.DENOM.DateDiff
	#MTT.PartTranDetails.PTranBusinessType	= "DEBIT"
	sv_y = "DENOM ROUND OFF"
	print(sv_y)
	
	sv_r = urhk_MTTS_DefinePartTran(sv_y)
	print(sv_r)
	
	print(MTT.PartTranDetails.Amount)
	IF (sv_r != 0) THEN
	#{
		IF(CUST.DENOM.MTTErrMsg == "") THEN
		#{
			IF(fieldexists(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				sv_p = "echo " + MTT.Error.Description + " >> " + CUST.DENOM.SuccessFile
				print(sv_p)
				sv_a = system(sv_p)
				BANCS.OUTPUT.successOrFailure = "F"
				CUST.DENOM.FLAG2 = "Y"
				CUST.DENOM.status = "N"
				GOTO FAIL
				#}
			ELSE
				#{
				IF(CUST.DENOM.FLAG4 == "N")THEN
				#{
					sv_x = rpad("TELLERID",15)+rpad("CRNCYCODE",15)+rpad("SOLID",10)+"---------- "+ rpad("Message",20)
					print(sv_x)
					sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
					print(sv_v)
					sv_b = system(sv_v)
					sv_a = "---------------------------------------------------------------------------"
					print(sv_a)
					sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
					print(sv_c)
					sv_d = system(sv_c)
					CUST.DENOM.FLAG4 = "Y"
				#}
				ENDIF
				print(CUST.DENOM.SuccessFile)
				sv_y = rpad(CUST.DENOM.teller_id,15)+","+rpad(CUST.DENOM.crncy_code,15)+","+rpad(CUST.DENOM.solId,10)+"--------Unable to Define the Part Transaction"
				print(sv_y)
				sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
				print(sv_p)
				sv_a = system(sv_p)
				BANCS.OUTPUT.successOrFailure = "F"
				CUST.DENOM.FLAG2 = "Y"
				CUST.DENOM.status = "N"
				GOTO FAIL
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------
	# CLOSE THE TRANSACTION
	#-------------------------------------------------------------------------------------
	
	sv_r = urhk_MTTS_EndDefinition("")
	print(sv_r)
	
	IF(sv_r == 1) THEN
	#{
		IF(fieldexists(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
			sv_y = CUST.DENOM.teller_id+" "+CUST.DENOM.teller_acct+" "+CUST.DENOM.crncy_code+" "+CUST.DENOM.round_off_amt + "---------"+MTT.Error.Description
			print(sv_y)
			sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
			print(sv_p)
			sv_a = system(sv_p)
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.FLAG2 = "Y"
			GOTO NEXT
			#}
		ELSE
			#{
			IF(CUST.DENOM.FLAG4 == "N")THEN
			#{
				sv_x = rpad("TELLERID",15)+rpad("CRNCYCODE",15)+rpad("SOLID",10)+"---------- "+ rpad("Message",20)
				print(sv_x)
				sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
				print(sv_v)
				sv_b = system(sv_v)
				sv_a = "---------------------------------------------------------------------------"
				print(sv_a)
				sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
				print(sv_c)
				sv_d = system(sv_c)
				CUST.DENOM.FLAG4 = "Y"
			#}
			ENDIF
			print(CUST.DENOM.SuccessFile)
			sv_y = rpad(CUST.DENOM.teller_id,15)+","+rpad(CUST.DENOM.crncy_code,15)+","+rpad(CUST.DENOM.solId,10)+" --------- Could not Proceed End Definition"
			print(sv_y)
			sv_p = "echo " + sv_y + " >> " + CUST.DENOM.SuccessFile
			print(sv_p)
			sv_a = system(sv_p)
			BANCS.OUTPUT.successOrFailure = "F"
			CUST.DENOM.FLAG2 = "Y"
			GOTO NEXT
		#}
		ENDIF
	#}
	ELSE
		#{
		CUST.DENOM.tran_id = BANCS.OUTPARAM.MTTTranId
		print(CUST.DENOM.tran_id)
		IF(CUST.DENOM.FLAG3 == "N")THEN
		#{
			sv_x = rpad("TELLERID",15)+rpad("SOLID",10)+rpad("TELLERACCT",22)+rpad("CRNCYCODE",15)+rpad("ROFFAMT",20)+"---------- "+ rpad("TRAN ID",20)
			print(sv_x)
			sv_v = "echo " + sv_x + " >> " + CUST.DENOM.SuccessFile
			print(sv_v)
			sv_b = system(sv_v)
			sv_a = "----------------------------------------------------------------------------------------------------"
			print(sv_a)
			sv_c = "echo " + sv_a + " >> " + CUST.DENOM.SuccessFile
			print(sv_c)
			sv_d = system(sv_c)
			CUST.DENOM.FLAG3 = "Y"
		#}
		ENDIF
		print(CUST.DENOM.SuccessFile)
		CUST.DENOM.MTTErrMsg = rpad(CUST.DENOM.teller_id,15)+rpad(CUST.DENOM.solId,10)+rpad(CUST.DENOM.teller_acct,22)+rpad(CUST.DENOM.crncy_code,15)+rpad(CUST.DENOM.round_off_amt,20)+ " ---------- "+rpad(CUST.DENOM.tran_id,20)
		print(CUST.DENOM.MTTErrMsg)
		sv_p = "echo " + CUST.DENOM.MTTErrMsg + " >> " + CUST.DENOM.SuccessFile
		print(sv_p)
		sv_a = system(sv_p)
		CUST.DENOM.FLAG1 = "Y"
	#}
	ENDIF
	
	FAIL:
		
		sv_u = urhk_MTTS_Close("")
		print(sv_u)
		
		IF((CUST.DENOM.status == "N") AND (CUST.DENOM.CURSOR_NUMBER == 0))THEN
		#{
			GOTO NEXT
			#}
		ELSE
			#{
			GOTO FINISH
		#}
		ENDIF
		#---------------------------------------------------------------------------------------------------------
		# THIS STEP IS TO EXIT FROM THE SCRIPT
		#---------------------------------------------------------------------------------------------------------
		
	FINISH:
		
		#trace off
		exitscript
END-->
