#-------------------------------------------------------------------------------------    
#    Name				: shareorddp002.scr
#    Description     	: This script is used tovalidate the CDS number.
#    Date            	: 21-01-2013
#    Author          	: Prakash
#    Input           	: BANCS.INPUT.crdno1
#    Output				: NA
#    Called jsp		 	: shareorddp001.jsp
#    Calling Script	 	: getcparamvalue.scr
#    Menu Option		: HTM
#    Srl. No		Date			Author			Description.   
#    -------		----			------			----------------
#    1.0			01-01-2013		Prakash	 		Original Version
#------------------------------------------------------------------------------------- 
<--START 
TRACE ON

#------------------------------------------------------------------------------
# Creating repository and class
# Initializing the variables
# Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF(REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF(CLASSEXISTS("CUST","SHRORD") == 0) THEN
#{
	CREATECLASS("CUST","SHRORD",5)
#}
ENDIF

CUST.SHRORD.cdsnumber = BANCS.INPUT.crdno1
PRINT(CUST.SHRORD.cdsnumber)
CUST.SHRORD.cdsno  = ""
CUST.SHRORD.errMsg = ""
CUST.SHRORD.shtext = ""

BANCS.INPUT.moduleName = "SHAREORDERING"
BANCS.INPUT.parameterId = "SR_CDSNO"
CALL ("getcparamvalue.scr")
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.SHRORD.cdsno = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.SHRORD.errMsg = "Bacid setup not done CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

IF (MID$(CUST.SHRORD.cdsnumber,0,3) == CUST.SHRORD.cdsno ) THEN
#{
	CUST.SHRORD.CDUP_PREFIX = CUST.SHRORD.cdsnumber
#}
ELSE
#{
	sv_s = " CDUP_MEM_CODE ,CDUP_MEM_TYPE, CDUP_PREFIX | SELECT SUBSTR( ?SVAR ,1,INSTR( ?SVAR ,'/') - 1) , "
	sv_s = sv_s + "SUBSTR(?SVAR,INSTR( ?SVAR ,'/') + 1 ,1 ) , "
	sv_s = sv_s + "LTRIM(SUBSTR(?SVAR,INSTR(?SVAR ,'-')+1),'0') "
	sv_s = sv_s + "FROM DUAL"
	BANCS.INPARAM.BINDVARS = CUST.SHRORD.cdsnumber + "|" + CUST.SHRORD.cdsnumber + "|" + CUST.SHRORD.cdsnumber + "|" + CUST.SHRORD.cdsnumber + "|" + CUST.SHRORD.cdsnumber + "|" + CUST.SHRORD.cdsnumber
	PRINT(sv_s)
	
	sv_d =  urhk_dbselectWithBind(sv_s)
	IF ( sv_d != 0 ) THEN
	#{
		CUST.SHRORD.errMsg = "Invalid CDC Number Value or Format"
		GOTO ENDOFSCRIPT
	
	#}
	ENDIF
		
	CUST.SHRORD.CDUP_MEM_CODE = BANCS.OUTPARAM.CDUP_MEM_CODE
	CUST.SHRORD.CDUP_PREFIX = BANCS.OUTPARAM.CDUP_PREFIX
	PRINT(CUST.SHRORD.CDUP_MEM_CODE)
	PRINT(CUST.SHRORD.CDUP_PREFIX)
	PRINT(BANCS.OUTPARAM.CDUP_MEM_TYPE)
#}
ENDIF

IF ( MID$(CUST.SHRORD.cdsnumber,0,3) == CUST.SHRORD.cdsno) THEN
#{
	PRINT(CUST.SHRORD.CDUP_PREFIX)
	sv_s = "IDnumber,Surname,Othername | "
	sv_s = sv_s + "SELECT  ctn_id_pps_registration_no,ctn_surname, ctn_other_names "
	sv_s = sv_s + " FROM CUSTOM.CDSC_TEMP_NUMBERS "
	sv_s = sv_s + "WHERE ctn_serial_no = ?SVAR "
	sv_s = sv_s + "AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.SHRORD.CDUP_PREFIX + "|" + BANCS.STDIN.contextBankId
#}
ELSE
#{
	sv_s = "IDnumber,Surname,Othername|"
	sv_s = sv_s + "SELECT cdup_id_pps_number,cdup_surname,cdup_other_names "
	sv_s = sv_s + " FROM CUSTOM.CDSC_DMP "
	sv_s = sv_s + " WHERE TO_CHAR(cdup_prefix) = ?SVAR "
	sv_s = sv_s + " AND cdup_mem_code = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS =  CUST.SHRORD.CDUP_PREFIX + "|" + CUST.SHRORD.CDUP_MEM_CODE + "|" + BANCS.STDIN.contextBankId
#}
ENDIF

PRINT(sv_s)
sv_d =  urhk_dbselectWithBind(sv_s)
PRINT(sv_d)
IF ( sv_d != 0 ) THEN
#{
	CUST.SHRORD.errMsg = "INVALID CDS NUMBER"
    GOTO ENDOFSCRIPT

#}
ELSE
#{
	CUST.SHRORD.cdcidnumber = BANCS.OUTPARAM.IDnumber
	PRINT(CUST.SHRORD.cdcidnumber)
	
	IF (MID$(CUST.SHRORD.cdsnumber,0,3) != CUST.SHRORD.cdsno ) THEN
	#{
		CUST.SHRORD.cdsnumber = CUST.SHRORD.CDUP_MEM_CODE + "/C-" + CUST.SHRORD.CDUP_PREFIX
		PRINT(CUST.SHRORD.cdsnumber)
	#}
	ENDIF
	
	CUST.SHRORD.sname = BANCS.OUTPARAM.Surname
	CUST.SHRORD.oname = BANCS.OUTPARAM.Othername
	CUST.SHRORD.name = CUST.SHRORD.sname + " "+ CUST.SHRORD.oname
	CUST.SHRORD.cdcidnumber = BANCS.OUTPARAM.IDnumber
	PRINT(CUST.SHRORD.sname)
	PRINT(CUST.SHRORD.oname)
	PRINT(CUST.SHRORD.name)
	PRINT(CUST.SHRORD.cdcidnumber)
	
	sv_b = "status|" + CUST.SHRORD.name 
    sv_z = urhk_SetOrbOut(sv_b)
    EXITSCRIPT
#}
ENDIF

ENDOFSCRIPT :

IF (CUST.SHRORD.errMsg != "") THEN
#{
    sv_b = "Error|" + CUST.SHRORD.errMsg
    sv_z = urhk_SetOrbOut(sv_b)
#}
ENDIF

TRACE OFF
EXITSCRIPT
END-->
