#------------------------------------------------------------------------------------------------
#  Name            : ezb_dtdMod.scr   
#  Description     : Updates Transaction Narrations   
#  Date            : 05-09-2023
#  Author          : Harrison Ruiru
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             18-10-2024     Harrison Ruiru        Original Version
#-----------------------------------------------------------------------------------------------
##########
#-----------------------------------------------------------------------------------------------

<--start
trace on

	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","CHQB") == 0) THEN
	#{
		CREATECLASS("CUST","CHQB",5)
	#}
	ENDIF

	IF((CUST.CHQB.chargeTranId !="")  AND (CUST.CHQB.chargeTranDate!="") AND (CUST.CHQB.refNum !=""))THEN


		#sv_s = "UPDATE TBAADM.DTD SET REF_NUM = ?SVAR WHERE TRAN_ID = LPAD(?SVAR,9)"
		#sv_s = sv_s + " AND TRAN_DATE = to_date(?SVAR,'dd-mm-yyyy') "
		#sv_s = sv_s + " AND BANK_ID = ?SVAR "
		#print(sv_s)
		#BANCS.INPARAM.BINDVARS = CUST.CHQB.refNum + "|" + CUST.CHQB.chargeTranId + "|" + CUST.CHQB.chargeTranDate + "|" + BANCS.STDIN.contextBankId
		#print(BANCS.INPARAM.BINDVARS)
		#sv_w = urhk_dbSQLWithBind(sv_s)
		#print(sv_w)
		#sv_w = urhk_dbSQLWithBind("COMMIT")
		#IF(sv_w == 0)THEN
		##{
		#	sv_d = urhk_dbSqlWithBind("COMMIT")
		#	print(sv_d)
		##}
		#ENDIF
	
		sv_y="TRAN, particular, serial, type|"
		sv_y = sv_y + " select TRAN_ID, TRAN_PARTICULAR,PART_TRAN_SRL_NUM, PART_TRAN_TYPE from tbaadm.DTD WHERE BANK_ID=?SVAR AND tran_id= lpad(?SVAR,9,' ') and tran_date=to_date(?SVAR,'dd-mm-yyyy') "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CHQB.chargeTranId +"|"+ CUST.CHQB.chargeTranDate
		print(BANCS.INPARAM.BINDVARS)
		print (sv_y)

		sv_v = urhk_dbcursorOpenWithBind(sv_y)
		PRINT(sv_v)


		IF(sv_v == 0) THEN
			CUST.CHQB.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(CUST.CHQB.CURSOR_NUMBER)
			sv_b = urhk_dbCursorFetch(CUST.CHQB.CURSOR_NUMBER)
			print(sv_b)
			BANCS.INPUT.RECCOUNT = CINT("1")
			print(BANCS.INPUT.RECCOUNT)
			CUST.CHQB.tranDate= BANCS.STDIN.BODDate
			WHILE(sv_b == "0")
			
				CUST.CHQB.partTranSrlNum = BANCS.OUTPARAM.serial
				print(CUST.CHQB.partTranSrlNum)

				CUST.CHQB.tranPartclrs = BANCS.OUTPARAM.particular
				print(CUST.CHQB.tranPartclrs)
				lv_x  = trim(MID$(CUST.CHQB.tranPartclrs,0,7))
				print(lv_x)

				IF( (lv_x == "Cheque") OR (lv_x == "CHEQUE"))THEN
						CUST.CHQB.tranPrtcls = CUST.CHQB.tranPartclrs +" "+ CUST.CHQB.refNum
						print(CUST.CHQB.tranPrtcls)
						CUST.CHQB.tranRmks = CUST.CHQB.tranPartclrs +" " + CUST.CHQB.refNum
						print(CUST.CHQB.tranRmks)
				ELSE
					CUST.CHQB.tranPrtcls = CUST.CHQB.tranPartclrs
					CUST.CHQB.tranRmks = CUST.CHQB.tranPartclrs
				ENDIF 

				sv_u = urhk_SetUrhkInp("pTran.tranId|" + CUST.CHQB.chargeTranId)
				sv_u = urhk_SetUrhkInp("pTran.tranDate|" +  CUST.CHQB.tranDate)
				sv_u = urhk_SetUrhkInp("pTran.partTranSrlNum|" + CUST.CHQB.partTranSrlNum)
				sv_u = urhk_ExecSrv("SRV_FetchPartTranForModify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)

				IF (sv_u == 0) THEN
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_SetUrhkInp("tranPrtcls|"+MID$(CUST.CHQB.tranPrtcls,0,50))
					sv_u = urhk_SetUrhkInp("tranRmks|"+MID$(CUST.CHQB.tranRmks,0,30))
					sv_u = urhk_ExecSrv("SRV_ModifyPartTran|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)
					IF (sv_u == 0) THEN
						print("SUCCESS")
					ENDIF
				ELSE
						callscriptifexist("trapSRVError.scr")
				ENDIF

				NEXTREC:
				sv_b = urhk_dbCursorFetch(CUST.CHQB.CURSOR_NUMBER)
				print(sv_b)
			DO
		ENDIF

		#----------------------------------------------------------------------------------------------------
		# SRV Error check
		#----------------------------------------------------------------------------------------------------
		IF (sv_u != 0) THEN
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
			ELSE
				sv_v = 0
			ENDIF
			IF (sv_v > 0) then
				sv_u = system("echo 'Error for Acct:"+CUST.CHQB.chargeTranId+" '")
				sv_i = 1
				WHILE (sv_i <= sv_v)
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
					sv_u = system("echo '"+sv_e+"' >>loanMgr.log")
					print(sv_u)
				DO
			ENDIF
		ENDIF
	ENDIF

trace off
end-->
