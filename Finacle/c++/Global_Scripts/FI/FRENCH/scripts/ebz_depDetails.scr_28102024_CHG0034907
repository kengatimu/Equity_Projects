#  1.0             05-09-2023     Harrison Ruiru		Original Version
#-----------------------------------------------------------------------------------------------

#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("CIFId"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="please enter CIFId"
		sv_t = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_t = "MSG | " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ELSE
		CUST.EZB.cifID = BANCS.INPUT.CIFId
		print(CUST.EZB.cifID)
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------
	CUST.EZB.schm_type = "TDA"
	lv_q = 0
	print(lv_q)

	#----------------------------------------------------------------------------------------------
	# validations
	#----------------------------------------------------------------------------------------------

	sv_q = "acct_crncy_code,dep_acct_no,schm_code,schm_desc,accrued_amt_cr, accrued_amt_dr,booking_Date,rate_of_interest,deposit_amt,tenor_mths,tenor_dys,maturity_date,maturity_amt,deposit_bal |"
	sv_q = sv_q + " select g.acct_crncy_code,g.foracid, g.schm_code,gsp.SCHM_DESC, "
	sv_q = sv_q + " e.NRML_ACCRUED_AMOUNT_CR,e.NRML_ACCRUED_AMOUNT_DR, to_char(e.BOOKED_UPTO_DATE_CR, 'DD-MON-YYYY'), "
	sv_q = sv_q + " ( SELECT NRML_PCNT_CR FROM TBAADM.ITC c WHERE c.ENTITY_ID=g.acid and del_flg='N' and entity_cre_flg='Y' and int_tbl_code_srl_num in (select max(INT_TBL_CODE_SRL_NUM) from tbaadm.itc where  ENTITY_ID=c.entity_id )) rate_of_interest, "
	sv_q = sv_q + " t.ORIGINAL_DEPOSIT_AMOUNT,t.DEPOSIT_PERIOD_MTHS,t.DEPOSIT_PERIOD_DAYS,to_char(t.MATURITY_DATE, 'DD-MON-YYYY'),t.MATURITY_AMOUNT,t.CUMULATIVE_INSTL_PAID "
	sv_q = sv_q + " from tbaadm.gam g, tbaadm.eit e, tbaadm.tam t, tbaadm.gsp gsp "
	sv_q = sv_q + " where g.cif_id=?SVAR and g.schm_type=?SVAR and g.acct_cls_flg='N' and g.del_flg='N' and g.entity_cre_flg='Y' and g.bank_id=?SVAR and "
	sv_q = sv_q + " t.ACID=g.acid and t.bank_id=g.bank_id and "
	sv_q = sv_q + " e.ENTITY_ID=g.acid and e.bank_id=g.bank_id and "
	sv_q = sv_q + " gsp.SCHM_CODE=g.schm_code AND gsp.BANK_ID=g.bank_id and gsp.del_flg='N' "
	print(sv_q)
	BANCS.INPARAM.BINDVARS =  CUST.EZB.cifID +"|"+ CUST.EZB.schm_type+"|"+BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbcursorOpenWithBind(sv_q)
	PRINT(sv_c)

	IF (sv_c == 0)THEN
	#{
		CUST.EZB.cursor_number = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.EZB.cursor_number)

		sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
		print(sv_d)

		IF(sv_d == 0)THEN
		#{
			WHILE (sv_d == 0)
			#{
				lv_q = lv_q + 1
				print(lv_q)

				sv_v = "DepAcctNo_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.dep_acct_no

				sv_v = "DepSchmCode_" + FORMAT$(lv_q, "%d") 
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.schm_code

				sv_v = "DepAmount_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.deposit_amt

				sv_v = "BookingDate_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.booking_Date

				sv_v = "Currency_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.acct_crncy_code

				sv_v = "TenorMths_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.tenor_mths

				sv_v = "TenorDys_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.tenor_dys

				sv_v = "MaturityDate_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.maturity_date

				sv_v = "MaturityAmount_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.maturity_amt

				sv_v = "RateOfInterest_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.rate_of_interest

				sv_v = "DepositBalance_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.deposit_bal

				sv_v = "DepositDescription_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.schm_desc

				sv_v = "AccrDrInterest_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.accrued_amt_dr

				sv_v = "AccrCrInterest_" + FORMAT$(lv_q, "%d")
				("CUST").("EZB").(sv_v) = BANCS.OUTPARAM.accrued_amt_cr

				print(sv_v)

				sv_v = "DepAcctNo_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositAccountNumber| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "DepSchmCode_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositTypeCode| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "DepAmount_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositAmount| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "BookingDate_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.BookingDate| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "Currency_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.Currency| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "TenorMths_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.TenorMonths| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "TenorDys_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.TenorDays| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "MaturityDate_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.MaturityDate| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "MaturityAmount_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.MaturityAmount| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "RateOfInterest_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.RateOfInterest| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "DepositBalance_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositBalance| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "DepositDescription_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositDescription| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "AccrDrInterest_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.accrdrinterest| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_v = "AccrCrInterest_" + FORMAT$(lv_q, "%d")
				sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.accrcrinterest| " + ("CUST").("EZB").(sv_v)
				sv_u = urhk_SetOrbOut(sv_t)

				sv_d = urhk_dbCursorFetch(CUST.EZB.cursor_number)
				print(sv_d)

			#} 
			DO 

			sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
			print(sv_x)
			print(CUST.EZB.cursor_number)

		ELSE
			CUST.EZB.errMsg="Could not fetch data for the given CIF:"+ CUST.EZB.cifID
			sv_t = "SuccessOrFailure.<rec_" + FORMAT$(lv_q,"%d") + ">|F"
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "MSG.<rec_" + FORMAT$(lv_q,"%d") + "> | " + CUST.EZB.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF 

	ELSE
		sv_x = urhk_dbCursorClose(CUST.EZB.cursor_number)
		print(sv_x)
		print(CUST.EZB.cursor_number)

		CUST.EZB.errMsg="Could not fetch data for the given CIF:"+ CUST.EZB.cifID
		sv_t = "SuccessOrFailure.<rec_" + FORMAT$(lv_q,"%d") + ">|F"
		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "MSG.<rec_" + FORMAT$(lv_q,"%d") + "> | " + CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
	#}
	ENDIF


ENDSCRIPT:
trace off
END-->

