<--start
trace on

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
sv_a=urhk_B2k_PrintRepos("BANCS")
print(sv_a)

sv_r = REPEXISTS("CUSTS")
IF (sv_r == 0) THEN
	CREATEREP("CUSTS")
ENDIF

sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
IF (sv_r == 0) THEN
	 CREATECLASS("CUSTS", "GLBDATA", 5)
ENDIF

sv_q="foracid,schemcode,solid|"
sv_q = sv_q + "select foracid,acct_pref,sol_id from custom.int_change where bank_id = ?SVAR and  ENTITY_CRE_FLG='T'"
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
    sv_q = urhk_dbCursorFetch(sv_m)
    print(sv_q)

	while(sv_q==0)
		print(BANCS.STDIN.mySolId)
		print(BANCS.OUTPARAM.solid)

		CUSTS.GLBDATA.foracid=BANCS.OUTPARAM.foracid
		print (CUSTS.GLBDATA.foracid)
		CUSTS.GLBDATA.SolId=BANCS.OUTPARAM.solid 
		print (CUSTS.GLBDATA.SolId)
		CUSTS.GLBDATA.schemcode=BANCS.OUTPARAM.schemcode 
		print (CUSTS.GLBDATA.schemcode)

			
		sv_u = "acctSolId|"
		sv_u = sv_u + "SELECT SOL_ID FROM tbaadm.gam  "
		sv_u = sv_u + " where FORACID = ?SVAR "
		print(sv_u)

		BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.foracid
		print(BANCS.INPARAM.BINDVARS)

		sv_w =  urhk_dbSelectWithBind(sv_u)
		print(sv_w)

		IF (sv_w==0) THEN  
			CUSTS.GLBDATA.sol_id = BANCS.OUTPARAM.acctSolId
			print(CUSTS.GLBDATA.sol_id)
			CUSTS.GLBDATA.SolId = CUSTS.GLBDATA.sol_id
			print (CUSTS.GLBDATA.SolId)
			
		ELSE
			CUSTS.GLBDATA.sol_id=""
		ENDIF

		IF(CUSTS.GLBDATA.sol_id != BANCS.STDIN.mySolId)THEN
		#{
			sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.GLBDATA.sol_id)
			print(sv_u)
			sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
			print(sv_u)
		#}
		ENDIF
		print(CUSTS.GLBDATA.sol_id)
		print(CUSTS.GLBDATA.SolId)
	
		
		sv_a=urhk_SetUrhkInp("xferAcct.foracid|" + CUSTS.GLBDATA.foracid)

		sv_a=urhk_SetUrhkInp("crncy.crncyCode|KES")

		sv_a=urhk_SetUrhkInp("sourceSchm.schmCode|" + CUSTS.GLBDATA.schemcode)

		sv_a=urhk_SetUrhkInp("targetSchm.schmCode|SB137")
		print(BANCS.STDIN.mySolId)



		sv_u = urhk_ExecSrv("SRV_XferAcctBtwnSchmsAndVerify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)

		IF(sv_u == 0) THEN
		#{
			#print (BANCS.OUTPARAM.foracid)
			sv_s = "UPDATE CUSTOM.INT_CHANGE "
			sv_s = sv_s + " SET INT_CHANGE.entity_cre_flg = 'C',"
			sv_s = sv_s + " INT_CHANGE.acct_opn_date= SYSDATE"
			sv_s = sv_s + " WHERE INT_CHANGE.foracid= ?SVAR"
			sv_s = sv_s + " AND INT_CHANGE.bank_id = ?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSQLWithBind(sv_s)
			IF (sv_d == 0) THEN
			#{
				sv_c = urhk_dbSQLWithBind("commit")
				print(sv_c)
			#}
			ENDIF
		#}
		ENDIF
	
		IF (sv_u != 0) THEN
			#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}
				ELSE
				#{
					sv_v = 0
				#}
			ENDIF

					IF (sv_v > 0) THEN
					#{
						sv_u = system("echo 'Error for Acct:"+CUSTS.GLBDATA.foracid+" ' >>transfer.log")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>transfer.log")
							print(sv_u)
						#}
						DO
					#}
					ENDIF
			#}
		ENDIF


	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)

	do
	sv_d = urhk_dbCursorClose(sv_m)
	print(sv_d)
                print("ALL ACCOUNTS ARE TRANSFERED")
ENDIF


trace off
exitscript
end-->
