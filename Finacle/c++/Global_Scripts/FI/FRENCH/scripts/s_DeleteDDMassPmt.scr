<--START
TRACE ON
sv_r = REPEXISTS("CUST")
IF (sv_r == 0) THEN
#{
    CREATEREP("CUST")
#}
ENDIF
sv_r = CLASSEXISTS("CUST", "DENOM")
IF (sv_r == 0) THEN
#{
    CREATECLASS("CUST", "DENOM", 5)
#}
ENDIF
sv_q = urhk_B2k_PrintRepos("BANCS")
PRINT(sv_q)
IF (BANCS.STDIN.moduleIdentity == "FI" ) THEN
    GOTO FINISH
ENDIF
IF((FIELDEXISTS(ONS.CUSTOM.custDataIn)==0) OR (TRIM(ONS.CUSTOM.custDataIn) == "")) THEN
    GOTO FINISH
ENDIF

sv_q = urhk_SRV_GetVal("ddMassPmtHdr.tranId")
CUST.DENOM.tranId = BANCS.OUTPARAM.srvValue
sv_q = urhk_SRV_GetVal("ddMassPmtHdr.tranDate")
CUST.DENOM.tranDate = LEFT$(BANCS.OUTPARAM.srvValue,10)
PRINT(CUST.DENOM.tranId)
PRINT(CUST.DENOM.tranDate)
#------- to release the blocked denominations and to update the status of in C_DETD and C_DERD -------#
CALL("denomdp021.scr")

GOTO FINISH

FINISH:
TRACE OFF
END-->

