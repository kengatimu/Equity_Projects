#------------------------------------------------------------------------------------------------
#  Name            : ebz_depSummary.scr
#  Description     : fetchs Term Deposit accounts attached to a CIF
#  Date            : 05-09-2023
#  Author          : Harrison Ruiru
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             05-09-2024     Harrison Ruiru		Original Version
#-----------------------------------------------------------------------------------------------

#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)


	#----------------------------------------------------------------------------------------------
	# validations
	#----------------------------------------------------------------------------------------------

	IF( (FIELDEXISTS(("BANCS").("INPUT").("AcctList"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Account list"
		sv_t = "SuccessOrFailure|F"
		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "Message| " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
   	ELSE
   		CUST.EZB.inputRecord = ("BANCS").("INPUT").("AcctList")
   		print(CUST.EZB.inputRecord)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("TotRec"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please enter Number of Accounts Passed in the List"
		sv_t = "SuccessOrFailure|F"
		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "Message| " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
   	ELSE 
   		CUST.EZB.totRec = ("BANCS").("INPUT").("TotRec")
		print(CUST.EZB.totRec)
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------
	
	CUST.EZB.schm_type = "TDA"
	lv_q = 0
	CUST.EZB.errMsg = ""

	#---------------------------------------------------------------------------------------------------------------
	# IMPLEMENTATION
	#---------------------------------------------------------------------------------------------------------------

	lv_m = urhk_B2k_isStringNumeric(CUST.EZB.totRec)
	print(lv_m)

	IF(lv_m !=0)THEN
	#{
		CUST.EZB.errMsg="Invalid Input ["+CUST.EZB.totRec+"] for TotRec Tag"
		sv_t = "SuccessOrFailure|F"
		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "Message| " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
	#}
	ENDIF

	lv_z = CUST.EZB.inputRecord
    print(lv_z)
    lv_y = getposition(lv_z,",")
    print(lv_y)

    lv_x = 0

    WHILE(lv_y > 0)
    #{
        lv_x = lv_x + 1
        print(lv_x)

        CUST.EZB.inputRecord1 = CUST.EZB.inputRecord
        print(CUST.EZB.inputRecord1)

        sv_l = STRLEN (CUST.EZB.inputRecord1)
        print(sv_l)
        sv_l = sv_l - lv_y
        print(sv_l)

        lv_z = mid$(lv_z,lv_y,sv_l)
        print(lv_z)
        CUST.EZB.inputRecord1 = lv_z
        print(CUST.EZB.inputRecord1)

        lv_y = getposition(lv_z,",")
        print(lv_y)
    #}
    DO

    lv_x = lv_x + 1
    print(lv_x)

    IF(lv_x != CUST.EZB.totRec)THEN
    #{
        CUST.EZB.errMsg="Account List Passed does not Match TotRec tag!!"
		sv_t = "SuccessOrFailure|F"
		sv_u = urhk_SetOrbOut(sv_t)
		sv_t = "Message| " +CUST.EZB.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		exitscript
    #}
    ENDIF

	WHILE(lv_q < CUST.EZB.totRec)
	#{
		lv_q = lv_q + 1
		print(lv_q)

		CUST.EZB.created_flg = ""
		CUST.EZB.acct_ownership = ""
		CUST.EZB.del_flg = ""
		CUST.EZB.schm_type = ""
		CUST.EZB.acct_cls_flg = ""

		sv_v = "rec_" + FORMAT$(lv_q, "%d")
		
		IF(lv_q == 1)THEN
		#{
	 		sv_c = CUST.EZB.inputRecord
			print(sv_c)
			sv_q = getposition(sv_c,",")
			print(sv_q)

			IF(sv_q > 0)THEN
			#{
				("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
				print(("CUST").("EZB").(sv_v))
			ELSE 
				("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
				print(("CUST").("EZB").(sv_v))
			#}
			ENDIF 
		ELSE
			sv_q = getposition(sv_c,",")
			print(sv_q)

			IF(sv_q > 0)THEN
			#{
				sv_l = STRLEN (CUST.EZB.inputRecord)
				print(sv_l)
				print(CUST.EZB.inputRecord)
				sv_l = sv_l - sv_q
				print(sv_l)
				sv_c = mid$(sv_c,sv_q,sv_l)
				print(sv_c)
				CUST.EZB.inputRecord = sv_c
				print(CUST.EZB.inputRecord)

				sv_q = getposition(sv_c,",")
				print(sv_q)

				("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
				print(("CUST").("EZB").(sv_v))

				IF(lv_q == CUST.EZB.totRec)THEN
				#{
					("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
					print(("CUST").("EZB").(sv_v))
				#}
				ENDIF
			ELSE 
				("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
				print(("CUST").("EZB").(sv_v))
			#}
			ENDIF 
		#}
		ENDIF

		IF( ("CUST").("EZB").(sv_v) != "")THEN
		#{

			sv_q = "created_flg,del_flg,acct_ownership,schm_type,acct_cls_flg|"
			sv_q = sv_q + "SELECT ENTITY_CRE_FLG, DEL_FLG,ACCT_OWNERSHIP,SCHM_TYPE,ACCT_CLS_FLG FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR "
			print(sv_q)

			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ ("CUST").("EZB").(sv_v)
			print(BANCS.INPARAM.BINDVARS)

			lv_s = urhk_dbSelectWithBind(sv_q)
			print(lv_s)

			IF(lv_s == 0)THEN
			#{
				CUST.EZB.created_flg = BANCS.OUTPARAM.created_flg
				print(CUST.EZB.created_flg)
				CUST.EZB.del_flg = BANCS.OUTPARAM.del_flg
				print(CUST.EZB.del_flg)
				CUST.EZB.acct_ownership = BANCS.OUTPARAM.acct_ownership
				print(CUST.EZB.acct_ownership)
				CUST.EZB.schm_type = BANCS.OUTPARAM.schm_type
				print(CUST.EZB.schm_type)
				CUST.EZB.acct_cls_flg = BANCS.OUTPARAM.acct_cls_flg
				print(CUST.EZB.acct_cls_flg)
			ELSE 
				CUST.EZB.errMsg="Could not get the account ^" + ("CUST").("EZB").(sv_v) + "^"
				sv_t = "SuccessOrFailure.<rec_" + FORMAT$(lv_q,"%d") + ">|F"
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "Message.<rec_" + FORMAT$(lv_q,"%d") + ">| " +CUST.EZB.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ENDIF

			IF( (CUST.EZB.acct_ownership !="O") AND (CUST.EZB.created_flg =="Y") AND (CUST.EZB.del_flg == "N") AND ( (CUST.EZB.schm_type == "TDA") OR (CUST.EZB.schm_type == "TUA") ) AND (CUST.EZB.acct_cls_flg == "N") )THEN
			#{
				sv_q = "acct_crncy_code,dep_acct_no,schm_code,schm_desc,accrued_amt_cr, accrued_amt_dr,booking_Date,rate_of_interest,deposit_amt,tenor_mths,tenor_dys,maturity_date,maturity_amt,deposit_bal |"
				sv_q = sv_q + " select g.acct_crncy_code,g.foracid, g.schm_code,gsp.SCHM_DESC, "
				sv_q = sv_q + " e.NRML_ACCRUED_AMOUNT_CR,e.NRML_ACCRUED_AMOUNT_DR, to_char(e.BOOKED_UPTO_DATE_CR, 'DD-MON-YYYY'), "
				sv_q = sv_q + " ( SELECT NRML_PCNT_CR FROM TBAADM.ITC c WHERE c.ENTITY_ID=g.acid and del_flg='N' and entity_cre_flg='Y' and int_tbl_code_srl_num in (select max(INT_TBL_CODE_SRL_NUM) from tbaadm.itc where  ENTITY_ID=c.entity_id )) rate_of_interest, "
				sv_q = sv_q + " t.ORIGINAL_DEPOSIT_AMOUNT,t.DEPOSIT_PERIOD_MTHS,t.DEPOSIT_PERIOD_DAYS,to_char(t.MATURITY_DATE, 'DD-MON-YYYY'),t.MATURITY_AMOUNT,t.CUMULATIVE_INSTL_PAID "
				sv_q = sv_q + " from tbaadm.gam g, tbaadm.eit e, tbaadm.tam t, tbaadm.gsp gsp "
				sv_q = sv_q + " where g.foracid=?SVAR and g.schm_type=?SVAR and g.acct_cls_flg='N' and g.del_flg='N' and g.entity_cre_flg='Y' and g.bank_id=?SVAR and "
				sv_q = sv_q + " t.ACID=g.acid and t.bank_id=g.bank_id and "
				sv_q = sv_q + " e.ENTITY_ID=g.acid and e.bank_id=g.bank_id and "
				sv_q = sv_q + " gsp.SCHM_CODE=g.schm_code AND gsp.BANK_ID=g.bank_id and gsp.del_flg='N' "
				print(sv_q)
				BANCS.INPARAM.BINDVARS =  ("CUST").("EZB").(sv_v) +"|"+ CUST.EZB.schm_type +"|"+ BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				sv_f = urhk_dbSelectWithBind(sv_q)
				print(sv_f)

				IF(sv_f == 0)THEN
				#{
					CUST.EZB.dep_acct_no  = BANCS.OUTPARAM.dep_acct_no
					print(CUST.EZB.dep_acct_no)
					CUST.EZB.schm_code  = BANCS.OUTPARAM.schm_code
					print(CUST.EZB.schm_code)
					CUST.EZB.deposit_amt  = BANCS.OUTPARAM.deposit_amt
					print(CUST.EZB.deposit_amt)
					CUST.EZB.booking_Date  = BANCS.OUTPARAM.booking_Date
					print(CUST.EZB.booking_Date)
					CUST.EZB.acct_crncy_code  = BANCS.OUTPARAM.acct_crncy_code
					print(CUST.EZB.acct_crncy_code)
					CUST.EZB.tenor_mths  = BANCS.OUTPARAM.tenor_mths
					print(CUST.EZB.tenor_mths)
					CUST.EZB.tenor_dys  = BANCS.OUTPARAM.tenor_dys
					print(CUST.EZB.tenor_dys)
					CUST.EZB.maturity_date  = BANCS.OUTPARAM.maturity_date
					print(CUST.EZB.maturity_date)
					CUST.EZB.maturity_amt  = BANCS.OUTPARAM.maturity_amt
					print(CUST.EZB.maturity_amt)
					CUST.EZB.deposit_bal  = BANCS.OUTPARAM.deposit_bal
					print(CUST.EZB.deposit_bal)
					CUST.EZB.schm_desc  = BANCS.OUTPARAM.schm_desc
					print(CUST.EZB.schm_desc)
					CUST.EZB.accrued_amt_dr  = BANCS.OUTPARAM.accrued_amt_dr
					print(CUST.EZB.accrued_amt_dr)
					CUST.EZB.accrued_amt_cr  = BANCS.OUTPARAM.accrued_amt_cr
					print(CUST.EZB.accrued_amt_cr)
					CUST.EZB.rate_of_interest  = BANCS.OUTPARAM.rate_of_interest
					print(CUST.EZB.rate_of_interest)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositAccountNumber| " + CUST.EZB.dep_acct_no
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositTypeCode| " + CUST.EZB.schm_code
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositAmount| " + CUST.EZB.deposit_amt
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.BookingDate| " + CUST.EZB.booking_Date
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.Currency| " + CUST.EZB.acct_crncy_code
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.TenorMonths| " + CUST.EZB.tenor_mths
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.TenorDays| " + CUST.EZB.tenor_dys
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.MaturityDate| " + CUST.EZB.maturity_date
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.MaturityAmount| " + CUST.EZB.maturity_amt
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.RateOfInterest| " + CUST.EZB.rate_of_interest
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositBalance| " + CUST.EZB.deposit_bal
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.DepositDescription| " + CUST.EZB.schm_desc
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccrDrInterest| " + CUST.EZB.accrued_amt_dr
					sv_u = urhk_SetOrbOut(sv_t)

					sv_t = "DepositSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccrCrInterest| " + CUST.EZB.accrued_amt_cr
					sv_u = urhk_SetOrbOut(sv_t)
				ELSE
					CUST.EZB.errMsg="Error Occurred fetching the data"
					sv_t = "SuccessOrFailure.<rec_" + FORMAT$(lv_q,"%d") + ">|F"
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "Message.<rec_" + FORMAT$(lv_q,"%d") + ">| " +CUST.EZB.errMsg
					sv_u = urhk_SetOrbOut(sv_t)
				#}
				ENDIF
			ELSE 
				IF( (CUST.EZB.acct_ownership =="O") AND (CUST.EZB.acct_ownership != "") )THEN
					CUST.EZB.errMsg = "Account not Allowed"
				ENDIF
				IF( (CUST.EZB.created_flg =="N") AND (CUST.EZB.created_flg !="") )THEN
					CUST.EZB.errMsg = "Account creation not yet authorised : "+ ("CUST").("EZB").(sv_v)
				ENDIF
				IF( (CUST.EZB.del_flg =="Y") AND (CUST.EZB.del_flg !="") )THEN
					CUST.EZB.errMsg = "The record is deleted : "+("CUST").("EZB").(sv_v)
				ENDIF
				IF((CUST.EZB.acct_cls_flg =="Y") AND (CUST.EZB.acct_cls_flg !=""))THEN
					CUST.EZB.errMsg = "Account has been closed : "+ ("CUST").("EZB").(sv_v)
				ENDIF

				IF( (CUST.EZB.schm_type !="TDA") AND (CUST.EZB.schm_type !=""))THEN
					CUST.EZB.errMsg = "Scheme Type not allowed : "+ CUST.EZB.schm_type
				ENDIF
				sv_t = "SuccessOrFailure.<rec_" + FORMAT$(lv_q,"%d") + ">|F"
				sv_u = urhk_SetOrbOut(sv_t)
				sv_t = "Message.<rec_" + FORMAT$(lv_q,"%d") + ">| " +CUST.EZB.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ENDIF
		ELSE
			CUST.EZB.errMsg="Error Occurred!! Account Number is Empty"
			sv_t = "SuccessOrFailure.<rec_" + FORMAT$(lv_q,"%d") + ">|F"
			sv_u = urhk_SetOrbOut(sv_t)
			sv_t = "Message.<rec_" + FORMAT$(lv_q,"%d") + "> | " +CUST.EZB.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
		#}
		ENDIF
	#}
	DO
ENDSCRIPT:
trace off
END-->

