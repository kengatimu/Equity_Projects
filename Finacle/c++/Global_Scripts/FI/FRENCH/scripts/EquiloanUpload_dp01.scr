<--START
trace on

sv_b = cint(INTBAF.INTBAFC.TbafEventStep)
if (sv_b == 0) then
        GOTO STEP0
endif
exitscript

STEP0:
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
		CREATEREP("CUST")
	ENDIF

	sv_r = CLASSEXISTS("CUST", "PORT")
	IF (sv_r == 0) THEN
    		CREATECLASS("CUST", "PORT", 5)
	ENDIF

	sv_a = urhk_TBAF_GetCurFldName("")
	sv_a = B2KTEMP.TEMPSTD.TBAFRESULT

	sv_d = sv_a

	sv_b = GETPOSITION(sv_a, '.')
    	sv_c = STRLEN(sv_a)
    	sv_a = MID$(sv_a, sv_b, sv_c-sv_b)

    	CUST.PORT.CurFieldName = sv_a

    	sv_b = GETPOSITION(sv_a, '.')
    	sv_c = STRLEN(sv_a)
	sv_a = MID$(sv_a, sv_b, sv_c-sv_b)

	CUST.PORT.field_num=sv_a

	sv_a = urhk_TBAF_InquireFieldValue(CUST.PORT.CurFieldName)
	CUST.PORT.CurFieldVal      =       trim(B2KTEMP.TEMPSTD.TBAFRESULT)

	print(CUST.PORT.field_num)

	if (CUST.PORT.field_num=="field_3") then
		sv_u = urhk_TBAF_DispMesg("Enter The Valid upload file name             -X")
	endif


	if (CUST.PORT.field_num=="field_4") then
		sv_u = urhk_TBAF_DispMesg("Enter The Valid test flag Y-yes N-No              -X")
	endif


	DELETEREP("CUST")

	If (STDWFS.WFSOUTPUT.ErrorCode=="-9999") THEN
		goto complete
	endif


exitscript
end-->
