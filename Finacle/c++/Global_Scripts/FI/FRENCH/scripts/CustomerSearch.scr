ENDIF

############################################
#Assigns the values to the variables
###########################################

IF( (FIELDEXISTS(("BANCS").("INPUT").("CustName"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Customer Name"
   GOTO HandleError
ENDIF

#IF( (FIELDEXISTS(("BANCS").("INPUT").("BankId"))== 0) ) THEN
   #CUST.DATA.errMsg="Kindly Supply Bank Id"
   #GOTO HandleError
#ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("BranchId"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Branch Id"
   GOTO HandleError
ENDIF


CUST.DATA.CustName=BANCS.INPUT.CustName
#CUST.DATA.BankId=BANCS.INPUT.BankId
CUST.DATA.BranchId=BANCS.INPUT.BranchId






sv_f="CIF_ID,CUST_NAME|select CIF_ID,CUST_NAME FROM TBAADM.CMG  WHERE bank_id=?SVAR and PRIMARY_SOL_ID=?SVAR and cust_name like ?SVAR"
BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + CUST.DATA.BranchId + "|" +"%" + CUST.DATA.CustName +"%"
print(BANCS.INPARAM.BINDVARS)


sv_f= urhk_dbCursorOpenWithBind(sv_f)

CUST.DATA.RecordCount=0
sv_g =0


############################################
#Check to see if Record Retrieved from DB
###########################################

IF( sv_f == 0 ) THEN
 #{
   sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
   print(sv_m)
   sv_n = urhk_dbCursorFetch(sv_m)
    print(sv_n)



 ############################################
 #Check to see if Record Exists in DB 
  ###########################################
    IF (sv_n==1) THEN
       	CUST.DATA.errMsg="Records Do not Exist"
	sv_f = urhk_dbCursorClose(sv_m)
       	GOTO HandleError
    ENDIF

      CUST.DATA.number = 0
      WHILE(sv_n == 0)
         #{
              CUST.DATA.CIF_ID = BANCS.OUTPARAM.CIF_ID
	      CUST.DATA.CUST_NAME = BANCS.OUTPARAM.CUST_NAME

               sv_p = "CustDet.<rec_" + CUST.DATA.number + ">.CIF_ID|" + CUST.DATA.CIF_ID 								
	       sv_k = "CustDet.<rec_" + CUST.DATA.number + ">.CUST_NAME|" + CUST.DATA.CUST_NAME
	       
	   sv_u = urhk_SetOrbOut(sv_p)
           sv_u = urhk_SetOrbOut(sv_k)

           sv_n = urhk_dbCursorFetch(sv_m)
	   sv_g = sv_g + 1  
	   CUST.DATA.number = sv_g
	 #}					
	DO

sv_f = urhk_dbCursorClose(sv_m)

         CUST.DATA.RecordCount = sv_g
	 sv_e=urhk_SetOrbOut("NumberOfRecord|"+CUST.DATA.RecordCount)
	 EXITSCRIPT
  #}
   
ELSE
    CUST.DATA.DB_ERRCODE= BANCS.OUTPARAM.DB_ERRCODE
    CUST.DATA.DB_ERRMSG= BANCS.OUTPARAM.DB_ERRMSG
     
     sv_e=urhk_SetOrbOut("Error | Database Error")
     sv_e=urhk_SetOrbOut("ErrrorCode|"+CUST.DATA.DB_ERRCODE)
     sv_e=urhk_SetOrbOut("ErrorMsg|"+CUST.DATA.DB_ERRMSG)
     EXITSCRIPT
 
ENDIF



HandleError:
  sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 

EXITSCRIPT
trace off
end-->	
