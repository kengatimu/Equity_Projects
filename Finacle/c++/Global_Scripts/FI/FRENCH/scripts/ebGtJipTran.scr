        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+BANCS.STDIN.BODDate )
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refNum|" + EQSRV.GLBDATA.drrefNum )
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|" + EQSRV.GLBDATA.drtranParti )
