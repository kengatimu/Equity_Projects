        ##sv_u = urhk_ExecSrvNoCommit("SRV_AddXferTran|same_user_verify = Y|retain_all_output = Y")
        sv_u = urhk_ExecSrvNoCommit("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y")
        print(sv_u)
        if(fieldexists(BANCS.OUTPARAM.successOrFailure)==1)then
                print(BANCS.OUTPARAM.successOrFailure)
                EQSRV.GLBDATA.srvSF = BANCS.OUTPARAM.successOrFailure
        else
                EQSRV.GLBDATA.srvSF = "F"
        endif
        if((EQSRV.GLBDATA.srvSF =="F") or (sv_u!=0))then
                callscriptifexist("ebsrvHandler.scr")
                if(fieldexists(EQSRV.GLBDATA.SrvError)==1)then
                        EQSRV.GLBDATA.srvMsg    = EQSRV.GLBDATA.SrvError
                        EQSRV.GLBDATA.srvErrorCode = "E0012"
                        EQSRV.GLBDATA.srvSF     = "F"
                        goto SRVEND
                endif
        endif
        if((EQSRV.GLBDATA.srvSF =="S") and (sv_u==0))then
                print(BANCS.OUTPARAM.tranId)
                print(BANCS.OUTPARAM.tranDate)
                EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
                EQSRV.GLBDATA.tranDate = BANCS.OUTPARAM.tranDate
        endif
SRVEND:
	print(EQSRV.GLBDATA.srvMsg)
	print(EQSRV.GLBDATA.srvErrorCode)
	print(EQSRV.GLBDATA.srvSF)
	print(EQSRV.GLBDATA.tranId)
	print(EQSRV.GLBDATA.tranDate)	
trace off
