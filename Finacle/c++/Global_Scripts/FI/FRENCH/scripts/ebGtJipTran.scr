        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate )
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refNum|" + EQSRV.GLBDATA.crrefNum )
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|" + EQSRV.GLBDATA.crtranParti )
