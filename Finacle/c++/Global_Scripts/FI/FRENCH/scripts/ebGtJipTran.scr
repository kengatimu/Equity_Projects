        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars2|" + EQSRV.GLBDATA.drtranPartit )
		
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate )
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate )
        sv_i = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
        sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
	sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|" + EQSRV.GLBDATA.TranCrncy )
	sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|" + EQSRV.GLBDATA.TranAmt + "|" + EQSRV.GLBDATA.TranCrncy )
			print("tranDtl.partTranDetailLL.<rec_1>.refAmt|" +EQSRV.GLBDATA.TranAmt+ "|" + EQSRV.GLBDATA.TranCrncy )
