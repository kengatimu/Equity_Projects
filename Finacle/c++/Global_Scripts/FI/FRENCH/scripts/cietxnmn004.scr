<--START
CHECKSUM="2d893918430ee91d7891d2b1acb23bbcd25402789262fc6cab36c051a7246e4b"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.ieTxnRefNo = ""
	CUST.CIETXN.tranAmtInHardCcy = ""
	CUST.CIETXN.hardCcy = ""
	CUST.CIETXN.chargeAmtInUsd = ""
	CUST.CIETXN.incomingCPAccount = ""
	CUST.CIETXN.entity1TranId = ""
	CUST.CIETXN.entity1TranDate = ""
	CUST.CIETXN.entity1CentralVostroAcct = ""
	CUST.CIETXN.entity1IncomeAcct = ""
	CUST.CIETXN.chargeAmtInHardCcy = ""
	CUST.CIETXN.currentDateTime = ""
	CUST.CIETXN.countryName = ""
	CUST.CIETXN.reportFileName = ""
	CUST.CIETXN.successOrFailure = ""
	CUST.CIETXN.errorMsg = ""
	
	###########################################################################################
	# Get system date-time and clear report file
	###########################################################################################
	
	sv_s = "currentDateTime|SELECT TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS') FROM DUAL"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = ""
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d == 0)THEN
	#{
		CUST.CIETXN.currentDateTime = BANCS.OUTPARAM.currentDateTime
		PRINT(CUST.CIETXN.currentDateTime)
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "KES")THEN
	#{
		CUST.CIETXN.countryName = "KENYA"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "UGX")THEN
	#{
		CUST.CIETXN.countryName = "UGANDA"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "SSP")THEN
	#{
		CUST.CIETXN.countryName = "SUDAN"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "RWF")THEN
	#{
		CUST.CIETXN.countryName = "RWANDA"
	#}
	ENDIF
	
	IF(BANCS.STDIN.homeCrncyCode == "TZS")THEN
	#{
		CUST.CIETXN.countryName = "TANZANIA"
	#}
	ENDIF
	
	CUST.CIETXN.reportFileName = "CIETXN_CW_" + CUST.CIETXN.countryName + "_SETTLEMENT1_" + CUST.CIETXN.currentDateTime + ".LST"
	PRINT(CUST.CIETXN.reportFileName)
	
	sv_s = "> "+  CUST.CIETXN.reportFileName
	sv_a = SYSTEM(sv_s)
	PRINT(sv_a)
	
	
	
	
	
	###########################################################################################
	#1) Get Entity1-Central Vostro Account
	###########################################################################################
	CUST.CIETXN.parameterId = "ENTITY1_CENTRAL_VOSTRO"
	PRINT(CUST.CIETXN.parameterId)
	
	sv_s = "entity1CentralVostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find the Parameter value for " + CUST.CIETXN.parameterId
		CUST.CIETXN.flag1="0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.entity1CentralVostroAcct = BANCS.OUTPARAM.entity1CentralVostroAcct
	PRINT(CUST.CIETXN.entity1CentralVostroAcct)
	
	IF(TRIM(CUST.CIETXN.entity1CentralVostroAcct) == "")THEN
	#{
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "The Parameter value for " + CUST.CIETXN.parameterId + " cannot be NULL"
		CUST.CIETXN.flag1="0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	
	###########################################################################################
	#2) Get Entity1 Charge Income Account
	###########################################################################################
	
	CUST.CIETXN.parameterId = "ENTITY1_INCOME_ACCT"
	CUST.CIETXN.flag1="1"
	PRINT(CUST.CIETXN.parameterId)
	
	sv_s = "entity1IncomeAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
	sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
	sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
	sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
	sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
	sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
	sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
	sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
	sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
	sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find the Parameter value for " + CUST.CIETXN.parameterId
		CUST.CIETXN.flag1="0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.CIETXN.entity1IncomeAcct = BANCS.OUTPARAM.entity1IncomeAcct
	PRINT(CUST.CIETXN.entity1IncomeAcct)
	
	IF(TRIM(CUST.CIETXN.entity1IncomeAcct) == "")THEN
	#{
		CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "The Parameter value for " + CUST.CIETXN.parameterId + " cannot be NULL"
		CUST.CIETXN.flag1="0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	###########################################################################################
	# Fetch Records which are Eligible for Settlement
	###########################################################################################
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	lv_s = "ieTxnRefNo,initEntityId,targetEntityId,tranAmtInHardCcy,hardCcy,chargeAmtInUsd,incomingCPAccount,entity1TranId,entity1TranDate|"
	lv_s = lv_s + " SELECT IE_TXN_REF_NO,INIT_ENTITY_ID,TARGET_ENTITY_ID,TRAN_AMT_IN_HARD_CCY,HARD_CRNCY_CODE,CHARGE_AMT_IN_USD,IN_CP_ACCOUNT_ID,"
	lv_s = lv_s + " ENTITY1_TRAN_ID,TO_CHAR(ENTITY1_TRAN_DATE,'DD-MM-YYYY')"
	lv_s = lv_s + " FROM CUSTOM.IECWD"
	lv_s = lv_s + " WHERE INIT_ENTITY_ID = ?SVAR"
	lv_s = lv_s + " AND NVL(ENTITY1_SETTLEMENT_STATUS,'X') != 'S'"
	lv_s = lv_s + " AND IE_TXN_REF_NO not in (select IE_TXN_REF_NO from CUSTOM.IETD where REVERSE_FLG='Y')"
	PRINT(lv_s)
	
	lv_c = urhk_dbCursorOpenWithBind(lv_s)
	PRINT(lv_c)
	
	IF(lv_c != 0)THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	lv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(lv_n)
	
	lv_f = urhk_dbCursorFetch(lv_n)
	PRINT(lv_f)
	
	lv_i = 1
	
	WHILE(lv_f == 0)
	#{
		CUST.CIETXN.flag2="1"
		CUST.CIETXN.entity1SettlementStatus = "F"
		CUST.CIETXN.entity1SettlementTranId = ""
		CUST.CIETXN.entity1SettlementTranDate = ""
		CUST.CIETXN.errorMsg = ""
		
		CUST.CIETXN.ieTxnRefNo = BANCS.OUTPARAM.ieTxnRefNo
		PRINT(CUST.CIETXN.ieTxnRefNo)
		
		CUST.CIETXN.initEntityId = BANCS.OUTPARAM.initEntityId
		PRINT(CUST.CIETXN.initEntityId)
		
		CUST.CIETXN.targetEntityId = BANCS.OUTPARAM.targetEntityId
		PRINT(CUST.CIETXN.targetEntityId)
		
		CUST.CIETXN.tranAmtInHardCcy = BANCS.OUTPARAM.tranAmtInHardCcy
		PRINT(CUST.CIETXN.tranAmtInHardCcy)
		
		CUST.CIETXN.hardCcy = BANCS.OUTPARAM.hardCcy
		PRINT(CUST.CIETXN.hardCcy)
		
		CUST.CIETXN.chargeAmtInUsd = BANCS.OUTPARAM.chargeAmtInUsd
		PRINT(CUST.CIETXN.chargeAmtInUsd)
		
		CUST.CIETXN.incomingCPAccount = BANCS.OUTPARAM.incomingCPAccount
		PRINT(CUST.CIETXN.incomingCPAccount)
		
		CUST.CIETXN.entity1TranId = BANCS.OUTPARAM.entity1TranId
		PRINT(CUST.CIETXN.entity1TranId)
		
		CUST.CIETXN.entity1TranDate = BANCS.OUTPARAM.entity1TranDate
		PRINT(CUST.CIETXN.entity1TranDate)
		
		
		CUST.CIETXN.initEntityName = ""
		
		IF(CUST.CIETXN.initEntityId == "54")THEN
		#{
			CUST.CIETXN.initEntityName = "KENYA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "56")THEN
		#{
			CUST.CIETXN.initEntityName = "UGANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "11")THEN
		#{
			CUST.CIETXN.initEntityName = "SUDAN"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "50")THEN
		#{
			CUST.CIETXN.initEntityName = "RWANDA"
		#}
		ENDIF
		
		IF(CUST.CIETXN.initEntityId == "55")THEN
		#{
			CUST.CIETXN.initEntityName = "TANZANIA"
		#}
		ENDIF
		
		
		#----------------------------------------------------------------------------------------
		#1) Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		BANCS.INPUT.inputBacid = CUST.CIETXN.entity1CentralVostroAcct
		BANCS.INPUT.inputCcy   = CUST.CIETXN.hardCcy
		BANCS.INPUT.inputSolID = BANCS.STDIN.mySolId
		BANCS.INPUT.inputBankId = BANCS.STDIN.contextBankId
		
		CALL("bacidtoacid.scr")
		CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
		PRINT(CUST.CIETXN.outputForacid)
		
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find the Account ID for "+CUST.CIETXN.entity1CentralVostroAcct
			CUST.CIETXN.flag2="0"
			GOTO NEXTFETCH1
		#}
		ENDIF
		
		CUST.CIETXN.entity1CentralVostroAcct = CUST.CIETXN.outputForacid
		PRINT(CUST.CIETXN.entity1CentralVostroAcct)
		
		
		#----------------------------------------------------------------------------------------
		#2) Get Initiating Sol Id
		#----------------------------------------------------------------------------------------
		
		lv_s = "incomeAcctSolId|SELECT DTH_INIT_SOL_ID FROM TBAADM.DTD WHERE TRAN_ID = ?SVAR"
		lv_s = lv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') AND PART_TRAN_SRL_NUM = ?SVAR UNION"
		lv_s = lv_s + " SELECT DTH_INIT_SOL_ID FROM TBAADM.HTD WHERE TRAN_ID = ?SVAR"
		lv_s = lv_s + " AND TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') AND PART_TRAN_SRL_NUM = ?SVAR"
		
		PRINT(lv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.entity1TranId + "|" + CUST.CIETXN.entity1TranDate + "|" + "   1" + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CIETXN.entity1TranId + "|" + CUST.CIETXN.entity1TranDate + "|" + "   1"
		
		lv_d = urhk_dbSelectWithBind(lv_s)
		PRINT(lv_d)
		
		IF(lv_d != 0)THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Entity1 Charge Income Account Sol Id;"
			CUST.CIETXN.flag2="0"
			GOTO NEXTFETCH1
		#}
		ENDIF
		
		CUST.CIETXN.incomeAcctSolId = BANCS.OUTPARAM.incomeAcctSolId
		PRINT(CUST.CIETXN.incomeAcctSolId)
		
		#----------------------------------------------------------------------------------------
		#2) Bacid to Acid Converter script call
		#----------------------------------------------------------------------------------------
		
		BANCS.INPUT.inputBacid = CUST.CIETXN.entity1IncomeAcct
		BANCS.INPUT.inputCcy   = BANCS.STDIN.homeCrncyCode
		BANCS.INPUT.inputSolID = CUST.CIETXN.incomeAcctSolId
		BANCS.INPUT.inputBankId = BANCS.STDIN.contextBankId
		
		CALL("bacidtoacid.scr")
		CUST.CIETXN.outputForacid = BANCS.OUTPUT.AcctId
		PRINT(CUST.CIETXN.outputForacid)
		
		IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
		#{
			CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find the Account ID for "+CUST.CIETXN.entity1IncomeAcct
			CUST.CIETXN.flag2="0"
			GOTO NEXTFETCH1
		#}
		ENDIF
		
		CUST.CIETXN.entity1IncomeAcct = CUST.CIETXN.outputForacid
		PRINT(CUST.CIETXN.entity1IncomeAcct)
		
		#-----------------------------------------------------------------
		# Get charge Amt in Hard Ccy
		#-----------------------------------------------------------------
		
		IF(CUST.CIETXN.hardCcy != "USD")THEN
		#{
			#Convert to Hard Ccy
			#currently assigned with usd value
			CUST.CIETXN.chargeAmtInHardCcy = CUST.CIETXN.chargeAmtInUsd
			PRINT(CUST.CIETXN.chargeAmtInHardCcy)
			#}
		ELSE
			#{
			CUST.CIETXN.chargeAmtInHardCcy = CUST.CIETXN.chargeAmtInUsd
			PRINT(CUST.CIETXN.chargeAmtInHardCcy)
		#}
		ENDIF
		
		#-----------------------------------------------------------------
		# Create Transaction
		#-----------------------------------------------------------------
		
		CUST.CIETXN.refCrncy = ""
		
		CUST.CIETXN.crAcct1 = ""
		CUST.CIETXN.drAcct1 = ""
		CUST.CIETXN.refAmt1 = ""
		CUST.CIETXN.tranParticularCr1 = ""
		CUST.CIETXN.tranParticularDr1 = ""
		CUST.CIETXN.tranRmksCr1 = ""
		CUST.CIETXN.tranRmksDr1 = ""
		CUST.CIETXN.crAcct2 = ""
		CUST.CIETXN.drAcct2 = ""
		CUST.CIETXN.refAmt2 = ""
		CUST.CIETXN.tranParticularCr2 = ""
		CUST.CIETXN.tranParticularDr2 = ""
		CUST.CIETXN.tranRmksCr2 = ""
		CUST.CIETXN.tranRmksDr2 = ""
		
		CUST.CIETXN.refCrncy = CUST.CIETXN.hardCcy
		CUST.CIETXN.crAcct1 = CUST.CIETXN.incomingCPAccount
		CUST.CIETXN.drAcct1 = CUST.CIETXN.entity1CentralVostroAcct
		CUST.CIETXN.refAmt1 = CDOUBLE(CUST.CIETXN.tranAmtInHardCcy)
		CUST.CIETXN.tranParticularCr1 = "IECW - " + CUST.CIETXN.initEntityName + " SETTLEMENT"
		CUST.CIETXN.tranParticularDr1 = "IECW - " + CUST.CIETXN.initEntityName + " SETTLEMENT"
		CUST.CIETXN.tranRmksCr1 = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.tranRmksDr1 = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.crAcct2 = CUST.CIETXN.entity1IncomeAcct
		CUST.CIETXN.drAcct2 = CUST.CIETXN.entity1CentralVostroAcct
		CUST.CIETXN.refAmt2 = CDOUBLE(CUST.CIETXN.chargeAmtInHardCcy)
		CUST.CIETXN.rateCode2 = "CNB"
		CUST.CIETXN.tranParticularCr2 = "IECW - " + CUST.CIETXN.initEntityName + " CHRG SETTLEMENT"
		CUST.CIETXN.tranParticularDr2 = "IECW - " + CUST.CIETXN.initEntityName + " CHRG SETTLEMENT"
		CUST.CIETXN.tranRmksCr2 = CUST.CIETXN.ieTxnRefNo
		CUST.CIETXN.tranRmksDr2 = CUST.CIETXN.ieTxnRefNo
		
		PRINT(CUST.CIETXN.refCrncy)
		PRINT(CUST.CIETXN.crAcct1)
		PRINT(CUST.CIETXN.drAcct1)
		PRINT(CUST.CIETXN.refAmt1)
		PRINT(CUST.CIETXN.tranParticularCr1)
		PRINT(CUST.CIETXN.tranParticularDr1)
		PRINT(CUST.CIETXN.tranRmksCr1)
		PRINT(CUST.CIETXN.tranRmksDr1)
		PRINT(CUST.CIETXN.crAcct2)
		PRINT(CUST.CIETXN.drAcct2)
		PRINT(CUST.CIETXN.refAmt2)
		PRINT(CUST.CIETXN.tranParticularCr2)
		PRINT(CUST.CIETXN.tranParticularDr2)
		PRINT(CUST.CIETXN.tranRmksCr2)
		PRINT(CUST.CIETXN.tranRmksDr2)
		
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
		sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
		sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_a = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
		
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|C")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+CUST.CIETXN.refAmt1+"|"+ CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+CUST.CIETXN.crAcct1)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|"+CUST.CIETXN.tranParticularCr1)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|"+CUST.CIETXN.tranRmksCr1)
		
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|D")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.CIETXN.refAmt1+"|"+ CUST.CIETXN.refCrncy)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.CIETXN.drAcct1)
