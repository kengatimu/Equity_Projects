			CUST.CIETXN.outRecord = CUST.CIETXN.ieTxnRefNo
			CUST.CIETXN.outRecord = CUST.CIETXN.outRecord + "|" + CUST.CIETXN.successOrFailure
			CUST.CIETXN.outRecord = CUST.CIETXN.outRecord + "|" + CUST.CIETXN.errorMsg
			
