			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CIETXN.ieTxnRefNo
			PRINT(BANCS.INPARAM.BINDVARS)
			
			lv_s = "UPDATE CUSTOM.IECWD SET "
			lv_s = lv_s + " ENTITY1_SETTLEMENT_STATUS = ?SVAR,"
			lv_s = lv_s + " ENTITY1_SETTLEMENT_TRAN_ID = ?SVAR,"
			lv_s = lv_s + " ENTITY1_SETTLEMENT_TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY'),"
			lv_s = lv_s + " ENTITY1_VOSTRO_ACCOUNT_ID = ?SVAR,"
			lv_s = lv_s + " ENTITY1_INCOME_ACCOUNT_ID = ?SVAR"
			lv_s = lv_s + " WHERE IE_TXN_REF_NO = ?SVAR"
			PRINT(lv_s)
			
			lv_d = urhk_dbSqlWithBind(lv_s)
			PRINT(lv_d)
			
			IF(lv_d != 0)THEN
			#{
				CUST.CIETXN.entity1SettlementStatus = "F"
				CUST.CIETXN.errorMsg = "Update Operation Failed ON Custom Table"
			#}
			ENDIF
			
			IF(CUST.CIETXN.entity1SettlementStatus == "S")THEN
			#{
				CUST.CIETXN.successOrFailure = "SUCCESS"
				#}
			ELSE
				#{
				CUST.CIETXN.successOrFailure = "FAILURE"
			#}
			ENDIF
			
			lv_u = urhk_dbSqlWithBind("COMMIT")
