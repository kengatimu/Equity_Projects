		NEXTFETCH:
			
			BANCS.INPARAM.BINDVARS = CUST.CIETXN.entity1SettlementStatus
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CIETXN.entity1SettlementTranId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CIETXN.entity1SettlementTranDate
