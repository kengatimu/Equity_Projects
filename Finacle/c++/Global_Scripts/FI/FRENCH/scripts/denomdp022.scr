#     DESCRIPTION     : This script performs the validation for the SOL ID that is been
#			entered by the user in HDENRO menu option to check if any record
#			exists or not
#     MENU OPTION     : HDENRO
#     CALLING JSP     : denommn004.jsp
#     AUTHOR NAME     : Sandeep Patil
#     MODULE CODE     :	DENOM
#     MODIFICATION
#     HISTORY         :
#                       Serial.No       Date	   AuthorName      Description
#-------------------------------------------------------------------------------------

<--START
CHECKSUM="083ce7f2e663fab1ef9aa4550db280d787b78b5797863d60b3dac8165053fa89"
	TRACE ON
	
	sv_r = urhk_B2k_PrintRepos("BANCS")
	#print(sv_r)
	
	#-------------------------------------------------------------------------------------
	# CREATION OF REPOSITORIES
	#-------------------------------------------------------------------------------------
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST", "DENOM") == 0) THEN
	#{
		CREATECLASS("CUST","DENOM",5)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------
	# INITIALIZE THE VARIABLES
	#-------------------------------------------------------------------------------------
	
	#-----------GETTING THE VALUES OF THE FIELD FROM THE FRONT END : START --------------
	
	#print(BANCS.INPUT.SolId)
	CUST.DENOM.SolId = toupper(BANCS.INPUT.SolId)
	#print (CUST.DENOM.SolId)
	CUST.DENOM.flag2 = "Y"
	
	#-----------GETTING THE VALUES OF THE FIELD FROM THE FRONT END :END-------------------
	
	#-----------QUERY IN C_DERD TABLE IF ANY RECORD EXISTS FOR THE ENTERED SOLID OR NOT  : START -------------
	
	BANCS.INPARAM.BINDVARS = CUST.DENOM.SolId + "|" + BANCS.STDIN.contextBankId
	
	
	sv_a = "count1 | SELECT count(*) "
	sv_a = sv_a + "FROM c_derd "
	sv_a = sv_a + "WHERE status = 'N' AND bank_id = ?SVAR  "
	IF (CUST.DENOM.SolId != "ALL") THEN
	#{
		sv_a = sv_a + "AND sol_id = ?SVAR "
	#}
	ENDIF
	print(sv_a)
	
	sv_q = urhk_dbSelectWithbind(sv_a)
	print(sv_q)
	
	IF(sv_q == 0) THEN
	#{
		CUST.DENOM.count1 = BANCS.OUTPARAM.count1
		#print(CUST.DENOM.count1)
		IF(CUST.DENOM.count1 == 0) THEN
		#{
			CUST.DENOM.ErrMsg = "No records are fetched for this Sol Id"
			sv_u = urhk_setOrbOut("Failure|"+CUST.DENOM.ErrMsg)
			#print(sv_u)
			GOTO FINISH
			#}
		ELSE
			#{
			CUST.DENOM.ErrMsg = "Records are found for this Sol Id"
			sv_u = urhk_setOrbOut("Success|"+CUST.DENOM.ErrMsg)
			#print(sv_u)
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------QUERY IN C_DERD TABLE IF ANY RECORD EXISTS FOR THE ENTERED SOLID OR NOT  : END -------------
	
	#---------------------------------------------------------------------------
	# THIS STEP IS TO EXIT FROM THE SCRIPT
	#---------------------------------------------------------------------------
	
	FINISH:
		TRACE OFF
		exitscript
END-->
