<--START
CHECKSUM="383a238a61102ccaf808fba50baaf3936a66650716160b2926420949781fcb7a"
	TRACE ON
	#---------------------------------------------------------------------------------
	# CREATING NEW REPOSITORY AND CLASS
	#---------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "GCHRG") == 0) THEN
	#{
		CREATECLASS("CUST", "GCHRG", 5)
	#}
	ENDIF
	CUST.DATA.amount = ""
	
	BANCS.INPUT.moduleName = "CHQB"
	BANCS.INPUT.parameterId = "EVENTID_CHQCH"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.DATA.eventid = BANCS.OUTPUT.parameterVal
		
		#}
	ELSE
		#{
		CUST.DATA.errMsg = " Evevt Id setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "CHQB"
	BANCS.INPUT.parameterId = "CHRG_AMOUNT1"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.DATA.amount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.errMsg = " Charge  setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.DATA.ChrgAmt	= ""
	PRINT(BANCS.INPUT.funcCode)
	PRINT(BANCS.INPUT.foracid)
	PRINT(BANCS.INPUT.instrNo)
	PRINT(BANCS.INPUT.bgChqNo)
	PRINT(BANCS.INPUT.noOfLeav)
	#---------------------------------------------------------------------------
	#The foll step is to Validate Foracid
	#---------------------------------------------------------------------------
	CUST.DATA.funcCode = BANCS.INPUT.funcCode
	CUST.DATA.foracid = BANCS.INPUT.foracid
	CUST.DATA.instType = BANCS.INPUT.instrNo
	CUST.DATA.beginChqNo = BANCS.INPUT.bgChqNo
	CUST.DATA.noOfLvs = BANCS.INPUT.noOfLeav
	
	IF (CUST.DATA.funcCode == "") THEN
	#{
		sv_e = "Function code should be be entered"
		sv_m = "funcCode"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF ((CUST.DATA.funcCode != "V") AND (CUST.DATA.funcCode != "X")) THEN
		#{
			sv_e = "Invalid function code V-Verify,X-Cancel"
			sv_m = "funcCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	#---------------------------------------------------------------------------
	#The foll step is to Validate Foracid
	#---------------------------------------------------------------------------
	IF (CUST.DATA.foracid == "") THEN
	#{
		sv_e = "Account Number should be entered"
		sv_m = "foracid"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_s = "Count|select count(1) "
		sv_s = sv_s + "from tbaadm.GAM where "
		sv_s = sv_s + "foracid= ?SVAR "
		sv_s = sv_s + "AND acct_cls_flg !='Y' "
		sv_s = sv_s + "AND del_flg !='Y' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS =  CUST.DATA.foracid   + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		sv_q = BANCS.OUTPARAM.Count
		PRINT(sv_q)
		IF (sv_q != "1") THEN
		#{
			sv_e = "Invalid Account Number"
			sv_m = "foracid"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Instrument Type
	#---------------------------------------------------------------------------
	IF (CUST.DATA.instType == "") THEN
	#{
		sv_e = "Instrument Type should be entered"
		sv_m = "instrNo"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_x = "count|select count(1) from custom.c_cbt_int where del_flg!='Y' "
		sv_x = sv_x + " AND inst_type = ?SVAR "
		sv_x = sv_x + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType  + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_x = urhk_dbSelectWithBind(sv_x)
		PRINT(sv_x)
		IF (CINT(BANCS.OUTPARAM.count) == 0) THEN
		#{
			sv_e = "Invalid Instrument Type"
			sv_m = "instrNo"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.DATA.instType == "CHQ") THEN
	#{
		sv_e = "CHQ Type Instrumnet Not allowded. Use CHQM Menu"
		sv_m = "instrNo"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------
	# General Validation
	#--------------------------------------------
	
	sv_a = urhk_getAcctDetailsInRepository(CUST.DATA.foracid)
	print(sv_a)
	IF (sv_a == 0) THEN
	#{
		print(BANCS.STDIN.mySolId)
		print(BANCS.OUTPARAM.acctSolId)
		print(BANCS.OUTPARAM.schmCode)
		IF (BANCS.INPUT.funcCode != "I") THEN
		#{
			IF (BANCS.STDIN.mySolId != BANCS.OUTPARAM.acctSolId) THEN
			#{
				sv_e = "Account belongs to different SOL"
				sv_m = "foracid"
				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	IF (CUST.DATA.beginChqNo == "") THEN
	#{
		sv_e = "Begin Chq Number should be entered"
		sv_m = "bgChqNo"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.DATA.noOfLvs == "") THEN
	#{
		sv_e = "Number of lvs should be entered"
		sv_m = "noOfLeav"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF ((CUST.DATA.funcCode == "V") OR (CUST.DATA.funcCode == "X")) THEN
	#{
		#----------------------------------------------------------
		# VERIFICATION OF INHOUSE CHQ BOOKS
		#----------------------------------------------------------
		
		sv_s =" chqLvsStat,numUnused,numStoped,numDestroyed,function,inpBeginChqNum,inpNumOfLvs,lchgUserId|"
		sv_s = sv_s + " SELECT chq_lvs_stat,num_unused,num_stoped,num_destroyed,function,inp_begin_chq_num,"
		sv_s = sv_s + " inp_num_of_lvs,lchg_user_id "
		sv_s = sv_s + " FROM CUSTOM.C_CBT_MOD "
		sv_s = sv_s + " WHERE inst_type = ?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		sv_s = sv_s + " AND del_flg != 'Y' "
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d != 0) THEN
		#{
			sv_e = "Nothing to Verify OR Cancel"
			sv_m = "Err"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.DATA.chqLvsStat    = BANCS.OUTPARAM.chqLvsStat
		CUST.DATA.numUnused     = BANCS.OUTPARAM.numUnused
		CUST.DATA.numStoped     = BANCS.OUTPARAM.numStoped
		CUST.DATA.numDestroyed  = BANCS.OUTPARAM.numDestroyed
		CUST.DATA.inpFunction       = BANCS.OUTPARAM.function
		print(CUST.DATA.inpFunction)
		CUST.DATA.inpBeginChqNum    = BANCS.OUTPARAM.inpBeginChqNum
		print(CUST.DATA.inpBeginChqNum)
		CUST.DATA.inpNumOfLvs   = BANCS.OUTPARAM.inpNumOfLvs
		CUST.DATA.lchgUserId    = BANCS.OUTPARAM.lchgUserId
		
	#}
	ENDIF
	
	IF (CUST.DATA.inpFunction == "D") THEN
	#{
		CUST.DATA.inpFunction = "DESTROY"
		#}
	ELSE
		#{
		CUST.DATA.inpFunction = "STOPPED"
	#}
	ENDIF
	IF (CUST.DATA.funcCode == "V")THEN
	#{
		IF ( CUST.DATA.lchgUserId == BANCS.STDIN.userId) THEN
		#{
			sv_e = "Same user cant verify"
			sv_m = "funcCode"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_s = "UPDATE CUSTOM.C_CBT SET chq_lvs_stat = ?SVAR, "
		sv_s = sv_s + " num_unused = ?SVAR, "
		sv_s = sv_s + " num_stoped = ?SVAR, "
		sv_s = sv_s + " num_destroyed = ?SVAR, "
		sv_s = sv_s + " lchg_user_id = ?SVAR, "
		sv_s = sv_s + " lchg_time = sysdate "
		sv_s = sv_s + " WHERE "
		sv_s = sv_s + " begin_chq_num = ?SVAR "
		sv_s = sv_s + " AND inst_type = ?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND del_flg != 'Y'"
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.chqLvsStat + "|" + CUST.DATA.numUnused + "|" + CUST.DATA.numStoped + "|" + CUST.DATA.numDestroyed + "|" + BANCS.STDIN.userId + "|" + CUST.DATA.inpBeginChqNum + "|" + CUST.DATA.instType + "|" + CUST.DATA.foracid  + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_u = urhk_SetOrbOut("Error_01|ERROR:^A Database error has occured. Please contact your DBA.")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_s = "UPDATE CUSTOM.C_CBT_MOD SET del_flg = 'Y',entity_cre_flg = 'Y' "
			sv_s = sv_s + " WHERE "
			sv_s = sv_s + " inst_type = ?SVAR "
			sv_s = sv_s + " AND foracid = ?SVAR "
			sv_s = sv_s + " AND del_flg != 'Y' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			
			BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSQLWithBind(sv_s)
			print(sv_d)
			
			IF (sv_d != 0) THEN
			#{
				sv_u = urhk_SetOrbOut("Error_01|ERROR:^A Database error has occured. Please contact your DBA.")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_d = urhk_dbSQLWithBind("COMMIT")
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_a = urhk_SetOrbOut("RESULT_MSG|Record Verified")
				
				IF(CUST.DATA.inpFunction == "STOPPED") THEN
				#{
					sv_n = "echo > sucess.lst "
					sv_a = "echo > failure.lst "
					
					sv_b = SYSTEM(sv_n)
					PRINT(sv_b)
					sv_b = SYSTEM(sv_a)
					sv_b = "STOPPAY"
					sv_i = sv_b + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
					sv_u = urhk_B2k_BacidToAcctId(sv_i)
					IF (sv_u == 1 ) THEN
					#{
						sv_a = urhk_SetOrbOut("Error_01|Account doesn't exists for the bacid STOPPAY")
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					CUST.DATA.stopAcct = BANCS.OUTPARAM.AcctId
					print(CUST.DATA.stopAcct)
					
					CUST.DATA.ChrgAmt = CDOUBLE(CUST.DATA.amount) * CDOUBLE(CUST.DATA.inpNumOfLvs)
					print(CUST.DATA.ChrgAmt)
					
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CUST.DATA.foracid
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.eventId = CUST.DATA.eventid
					#				CUST.GCHRG.chrgAmt = CUST.DATA.ChrgAmt
					CUST.GCHRG.chrgAmt = CUST.DATA.ChrgAmt + "|" + BANCS.STDIN.homeCrncyCode
					
					CALL("gchrgcommon.scr")
					
					IF( CUST.GCHRG.successOrFailure == "S" ) THEN
					#{
						sv_m ="echo '"+ CUST.DATA.foracid + "|" + CUST.GCHRG.tranId + "| Chages collected SuccessFull' >>sucess.lst"
						PRINT(sv_m)
						sv_c = SYSTEM(sv_m)
						print(sv_c)
						#}
					ELSE
						#{
						sv_m ="echo'"+ CUST.DATA.foracid + "|" + "| |Chages not collected' >>failure.lst"
						sv_c = SYSTEM(sv_m)
						
					#}
					ENDIF
					
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.DATA.funcCode == "X")THEN
	#{
		sv_s = " UPDATE CUSTOM.C_CBT_MOD SET del_flg = 'Y',entity_cre_flg = 'N' "
		sv_s = sv_s + " WHERE "
		sv_s = sv_s + " inst_type = ?SVAR "
		sv_s = sv_s + " AND foracid = ?SVAR "
		sv_s = sv_s + " AND del_flg != 'Y'"
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.instType + "|" + CUST.DATA.foracid + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			sv_a = urhk_SetOrbOut("Error_01|DataBase Error. Contact your DBA" )
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			sv_a = urhk_SetOrbOut("RESULT_MSG|Record Canceled")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	ENDOFSCRIPT:
		
		TRACE OFF
		EXITSCRIPT
END-->
