#------------------------------------------------------------------------------------------------
#  Name            : loanintmodificationmn001.scr
#  Description     : This script will call HINTTM modifiation services to modify data present in custom table
#  Date            : 10-02-2013
#  Author          : Dhana Prabhakaran
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :  (Batch Job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             10-02-2013      Dhana Prabhakaran    Original Version
#  2.0             16-09-2013      Bharath				Modified for new porting items
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="a4526aa8d950f2404ad2598721477f49b3f482c79b4257a4b80e2339a7ec74db"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LNTMN") == 0) THEN
	#{
		CREATECLASS("CUST","LNTMN",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM", 5)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUST.LNTMN.errMsg = ""
	
	#------------------------------------------------------------------------------
	#Getting LOANINT_PIDR values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "LOANINT"
	BANCS.INPUT.parameterId = "LOANINT_PIDR"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.custPrefIntDr= BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.custPrefIntDr)
		#}
	ELSE
		#{
		CUST.LNTMN.errMsg = "CPARAM setup not done for CustPrefIntDr "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting LOANINT_STRDT values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "LOANINT"
	BANCS.INPUT.parameterId = "LOANINT_STRDT"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.startDate= BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.startDate)
		#}
	ELSE
		#{
		CUST.LNTMN.errMsg = "CPARAM setup not done for StartDate "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Getting LOANINT_MINDR values from CPARAM
	#------------------------------------------------------------------------------
	BANCS.INPUT.moduleName  = "LOANINT"
	BANCS.INPUT.parameterId = "LOANINT_MINDR"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.minIntCr= BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.minIntCr)
		#}
	ELSE
		#{
		CUST.LNTMN.errMsg = "CPARAM setup not done for MinIntDr "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) "
	sv_s = sv_s + " FROM CUSTOM.INT_CHANGE2 "
	sv_s = sv_s + " WHERE INT_CHANGE2.entity_cre_flg='A' "
	sv_s = sv_s + " AND INT_CHANGE2.sol_id= ?SVAR"
	sv_s = sv_s + " AND INT_CHANGE2.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
	#{
		CUST.LNTMN.errMsg = "DB ERROR!"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.custcount)
		IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s="foracid,custpref,acctpref|"
	sv_s = sv_s + " SELECT INT_CHANGE2.foracid,INT_CHANGE2.cust_pref,INT_CHANGE2.acct_Pref "
	sv_s = sv_s + " FROM CUSTOM.INT_CHANGE2 "
	sv_s = sv_s + " WHERE INT_CHANGE2.entity_cre_flg='A' "
	sv_s = sv_s + " AND INT_CHANGE2.sol_id= ?SVAR"
	sv_s = sv_s + " AND INT_CHANGE2.bank_id = ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUST.LNTMN.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUST.LNTMN.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUST.LNTMN.foracid	= BANCS.OUTPARAM.foracid
			CUST.LNTMN.custpref	= BANCS.OUTPARAM.custpref
			CUST.LNTMN.acctpref	= BANCS.OUTPARAM.acctpref
			
			print(CUST.LNTMN.foracid)
			print(CUST.LNTMN.custpref)
			print(CUST.LNTMN.acctpref)
			
			#----------------------------------------------------------------------------------------------------
			# Modify and verify using services
			#----------------------------------------------------------------------------------------------------
			sv_u = urhk_SetUrhkInp("IntTblCrit.entityType.type|ACCNT")
			print(sv_u)
			sv_u = urhk_SetUrhkInp("IntTblCrit.entityId.entityDispId|" + CUST.LNTMN.foracid)
			print(sv_u)
			
			sv_u = urhk_ExecSrv("SRV_FetchIntTblDtlForModify|retain_all_output = Y")
			print(sv_u)
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				print(sv_u)
				#new porting changes
				CUST.LNTMN.custpref ="0"
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.custPrefIntCr|" + CUST.LNTMN.custpref)
				print(sv_u)
				CUST.LNTMN.acctpref ="0"
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.acctPrefIntCr|" + CUST.LNTMN.acctpref)
				print(sv_u)
				
				CUST.CPARAM.startDate="15-09-2016"
				print(CUST.CPARAM.startDate)
				
				sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.startDate|" + CUST.CPARAM.startDate)
				print(sv_u)
				###############
				sv_h = urhk_getAcctDetailsInRepository(CUST.LNTMN.foracid)
				print(sv_h)
				IF (sv_h==0) THEN
				#{
					CUST.LNTMN.solidsh = BANCS.OUTPARAM.acctSolId
					print(CUST.LNTMN.solidsh)
					CUST.LNTMN.schmcodesh = BANCS.OUTPARAM.schmCode
					print(CUST.LNTMN.schmcodesh)
					CUST.LNTMN.schmType = BANCS.OUTPARAM.schmType
					print(CUST.LNTMN.schmType)
					
					sv_s="gspschm_code,int_tbl_code,min_int_pcnt_cr,max_int_pcnt_cr|"
					sv_s = sv_s + " SELECT gsp.SCHM_CODE,INT_TBL_CODE,MIN_INT_PCNT_CR,MAX_INT_PCNT_CR FROM TBAADM.csp,TBAADM.gsp WHERE gsp.SCHM_CODE=csp.SCHM_CODE AND csp.CRNCY_CODE='KES' AND gsp.BANK_ID='54' "
					sv_s = sv_s + " AND csp.BANK_ID='54' AND gsp.del_flg='N' AND gsp.schm_type ='TDA' AND gsp.schm_code =?SVAR "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.LNTMN.schmcodesh
					print(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUST.LNTMN.int_tbl_code	= BANCS.OUTPARAM.int_tbl_code
						PRINT(CUST.LNTMN.int_tbl_code)
						CUST.CPARAM.intTblCode=CUST.LNTMN.int_tbl_code
						print(CUST.CPARAM.intTblCode)
						CUST.LNTMN.min_int_pcnt_cr= BANCS.OUTPARAM.min_int_pcnt_cr
						PRINT(CUST.LNTMN.min_int_pcnt_cr)
						CUST.CPARAM.minIntCr=CUST.LNTMN.min_int_pcnt_cr
						print(CUST.CPARAM.minIntCr)
						CUST.LNTMN.max_int_pcnt_cr= BANCS.OUTPARAM.max_int_pcnt_cr
						PRINT(CUST.LNTMN.max_int_pcnt_cr)
						CUST.CPARAM.maxIntCr=CUST.LNTMN.max_int_pcnt_cr
						print(CUST.CPARAM.maxIntCr)
						sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.intTblCode.tblCode|" + CUST.CPARAM.intTblCode)
						print(sv_u)
						#new porting changes
						CUST.CPARAM.minIntCr ="7"
						CUST.CPARAM.maxIntCr = "7"
						sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.minIntCr|" + CUST.CPARAM.minIntCr)
						print(sv_u)
						sv_u = urhk_SetUrhkInp("IntTblDtlLL.<rec_0>.maxIntCr|" + CUST.CPARAM.maxIntCr)
					#}
					ENDIF
				#}
				ENDIF
				###############
				
				sv_u = urhk_ExecSrv("SRV_ModifyIntTblDtlAndVerify|retain_all_output = Y|same_user_verify = Y")
				print(sv_u)
				IF(sv_u == 0) THEN
				#{
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					sv_s = "UPDATE CUSTOM.INT_CHANGE2 "
					sv_s = sv_s + " SET INT_CHANGE2.entity_cre_flg = 'P',"
					sv_s = sv_s + " INT_CHANGE2.acct_opn_date= SYSDATE"
					sv_s = sv_s + " WHERE INT_CHANGE2.foracid= ?SVAR"
					sv_s = sv_s + " AND INT_CHANGE2.bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.LNTMN.foracid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_u = system("echo 'Error for Acct:"+CUST.LNTMN.foracid+" ' >>tdaintmod.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>tdaintmod.log")
						print(sv_u)
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUST.LNTMN.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUST.LNTMN.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.LNTMN.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUST.LNTMN.errMsg+"' >>tdaintmod.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
