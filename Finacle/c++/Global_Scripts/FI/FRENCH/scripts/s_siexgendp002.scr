#-------------------------------------------------------------------------------------
#    Name				: s_siexgendp002.scr
#    Description     	: The script is used to make the general details tab to enter
#						: success charge event when it is an external SI and not for
#						: staff and same customer 
#    Date            	: 21-01-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: getcparamvalue.scr, SRV_AddSimpleSI_validate_data.scr, SRV_ModifySimpleSI_validate_data.scr
#    Menu Option		: HSSIM 
#    Srl. No		Date			Author			Description.   
#    -------		----			------			----------------
#    1.0			21-01-2013		Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
TRACE ON


#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","SIEXGEN") == 0) THEN
#{
	CREATECLASS("CUST","SIEXGEN",5)
#}
ENDIF

CUST.SIEXGEN.errMsg   = ""
CUST.SIEXGEN.DUMMY    = ""

BANCS.INPUT.moduleName 	= "SIEXECUTION"
BANCS.INPUT.parameterId = "SIEXGEN_SC"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.SIEXGEN.schmCode = BANCS.OUTPUT.parameterVal
	PRINT(CUST.SIEXGEN.schmCode)
#}
ELSE
#{
	CUST.SIEXGEN.errMsg = "Scheme Code setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "SIEXGEN_ACCTNUM"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
    CUST.SIEXGEN.acctNum = BANCS.OUTPUT.parameterVal
	PRINT(CUST.SIEXGEN.acctNum)
#}
ELSE
#{
    CUST.SIEXGEN.errMsg = "Account Number setup not done CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_GetVal("siHeader.failChrg.eventId")
CUST.SIEXGEN.fail = BANCS.OUTPARAM.srvValue
PRINT(CUST.SIEXGEN.fail)

sv_u = urhk_SRV_GetVal("siHeader.execChrg.eventId")
CUST.SIEXGEN.exec = BANCS.OUTPARAM.srvValue
PRINT(CUST.SIEXGEN.exec)

#-------------------------------------------------------------------------------------------------------
# Get the number of accounts
#-------------------------------------------------------------------------------------------------------
sv_u = urhk_SRV_NumOfRecs("partInstrLL")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	CUST.SIEXGEN.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.SIEXGEN.noOfRecords)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
	BANCS.OUTPUT.successOrFailure = "F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_l = 0
sv_m = 0
sv_a = ""
sv_b = 0
WHILE (sv_l < CUST.SIEXGEN.noOfRecords)
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"
	PRINT(sv_r)

			
	#-------------------------------------------------------------------------------------------
	# Fetch PartTranType 
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".partInstruction.partTranType.code")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.SIEXGEN.code = BANCS.OUTPARAM.srvValue
		PRINT(CUST.SIEXGEN.code)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for PartTranType")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF


    #-------------------------------------------------------------------------------------------
    # Fetch Foracid 
    #-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".prDetail.acct.foracid")
   	PRINT(sv_u)
	IF (sv_u == 0) THEN
   	#{
   		CUST.SIEXGEN.foracid = BANCS.OUTPARAM.srvValue 
		PRINT(CUST.SIEXGEN.foracid)
   	#}
   	ELSE
   	#{
       	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Foracid")
       	BANCS.OUTPUT.successOrFailure = "F"
       	GOTO ENDOFSCRIPT
   	#}
   	ENDIF


    #-------------------------------------------------------------------------------------------
    # Fetch Key serial number 
    #-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("partInstrLL." +sv_r+ ".key.serial_num")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.SIEXGEN.srlNum = BANCS.OUTPARAM.srvValue
		PRINT(CUST.SIEXGEN.srlNum)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serial number")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}	
	ENDIF


	PRINT(CUST.SIEXGEN.code)
	PRINT(CUST.SIEXGEN.foracid)
	IF ((CUST.SIEXGEN.code != "") AND (CUST.SIEXGEN.foracid != "")) THEN
	#{
		sv_u = urhk_getAcctDetailsInRepository(CUST.SIEXGEN.foracid)
		PRINT(sv_u)
		IF (sv_u ==0) THEN
		#{
			IF (CUST.SIEXGEN.code == "C") THEN
			#{
				CUST.SIEXGEN.crcust = BANCS.OUTPARAM.custId
				PRINT(CUST.SIEXGEN.crcust)
			#}
			ELSE
			#{
				CUST.SIEXGEN.drcust = BANCS.OUTPARAM.custId
				PRINT(CUST.SIEXGEN.drcust)
			#}
			ENDIF
			CUST.SIEXGEN.schm = BANCS.OUTPARAM.schmCode
			PRINT(CUST.SIEXGEN.schm)
			PRINT(CUST.SIEXGEN.schmCode)
			IF ((CUST.SIEXGEN.schm == CUST.SIEXGEN.schmCode) AND (CUST.SIEXGEN.code == "D")) THEN
			#{
				CUST.SIEXGEN.staff = "Y"
				PRINT(CUST.SIEXGEN.staff)
			#}
			ENDIF	
		#}
		ENDIF
	#}
	ENDIF

	CUST.SIEXGEN.foracid1 = MID$(CUST.SIEXGEN.foracid,3,10)
	PRINT(CUST.SIEXGEN.acctNum)
	PRINT(CUST.SIEXGEN.foracid1)
	IF ((CUST.SIEXGEN.code == "C") AND (CUST.SIEXGEN.acctNum == CUST.SIEXGEN.foracid1)) THEN
	#{
		CUST.SIEXGEN.external = "Y"
		PRINT(CUST.SIEXGEN.external)
	#}
	ENDIF



	IF ((FIELDEXISTS(CUST.SIEXGEN.fail)) AND (FIELDEXISTS(CUST.SIEXGEN.exec))) THEN
	#{
		PRINT(CUST.SIEXGEN.fail)
		PRINT(CUST.SIEXGEN.exec)
		IF (FIELDEXISTS(CUST.SIEXGEN.staff)) THEN
		#{
			PRINT(CUST.SIEXGEN.staff)
			CUST.SIEXGEN.DUMMY = "Y"
			PRINT(CUST.SIEXGEN.DUMMY)
		#}
		ELSE
		#{
			PRINT("HAI")

			IF ((FIELDEXISTS(CUST.SIEXGEN.crcust)) AND (FIELDEXISTS(CUST.SIEXGEN.drcust))) THEN
			#{
				PRINT(CUST.SIEXGEN.crcust)
				PRINT(CUST.SIEXGEN.drcust)
				IF (CUST.SIEXGEN.crcust != CUST.SIEXGEN.drcust) THEN
				#{
					
					IF (FIELDEXISTS(CUST.SIEXGEN.external)) THEN
					#{
						PRINT(CUST.SIEXGEN.external)
						IF (CUST.SIEXGEN.exec == "") THEN
						#{
							PRINT(CUST.SIEXGEN.exec)
							sv_a = sv_a + CUST.SIEXGEN.srlNum + ","
							PRINT(sv_a)

							sv_b = sv_b + 1
							PRINT(sv_b)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}	
	ENDIF

	sv_l = sv_l + 1
	PRINT(sv_l)
#}
DO

IF (sv_b > 0) THEN
#{
    BANCS.OUTPUT.successOrFailure = "F"
    sv_a = RTRIM(sv_a,',')
    sv_a = "Please visit the general details and put Success charge events for the part tran serial no : " + sv_a
    sv_u = urhk_SRV_SetErr(sv_a)
#}
ENDIF

ENDOFSCRIPT:
IF (CUST.SIEXGEN.errMsg != "") THEN
#{
    sv_u = urhk_SRV_SetErr(CUST.SIEXGEN.errMsg)
    BANCS.OUTPUT.successOrFailure = "F"
#}
ENDIF


TRACE OFF
EXITSCRIPT

END-->
