<--START
CHECKSUM="53f90e0e6b79b2fb61284c84ebe3e27d345941f86caf4b70816c38a9559c395c"
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	lv_r = REPEXISTS("CUST")
	
	IF(lv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CIETXN Class exists else create it
	###########################################################################################
	
	lv_r = CLASSEXISTS("CUST","CIETXN")
	
	IF(lv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CIETXN",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	
	CUST.CIETXN.startEntityId = BANCS.STDIN.contextBankId
	CUST.CIETXN.targetEntityId = " "
	CUST.CIETXN.fromCcy = " "
	CUST.CIETXN.toCcy = " "
	CUST.CIETXN.refAmt = " "
	CUST.CIETXN.splRateCode = " "
	CUST.CIETXN.customerRate = " "
	
	CUST.CIETXN.errorFlg = "N"
	CUST.CIETXN.errorMsg = " "
	CUST.CIETXN.tranAmt = " "
	CUST.CIETXN.tranAmtCcy = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.targetEntityId))THEN
	#{
		IF(TRIM(BANCS.INPUT.targetEntityId) != "")THEN
		#{
			CUST.CIETXN.targetEntityId = TOUPPER(TRIM(BANCS.INPUT.targetEntityId))
			print(CUST.CIETXN.targetEntityId)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.fromCcy))THEN
	#{
		IF(TRIM(BANCS.INPUT.fromCcy) != "")THEN
		#{
			CUST.CIETXN.fromCcy = TOUPPER(TRIM(BANCS.INPUT.fromCcy))
			print(CUST.CIETXN.fromCcy)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.toCcy))THEN
	#{
		IF(TRIM(BANCS.INPUT.toCcy) != "")THEN
		#{
			CUST.CIETXN.toCcy = TOUPPER(TRIM(BANCS.INPUT.toCcy))
			print(CUST.CIETXN.toCcy)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.refAmt))THEN
	#{
		IF(TRIM(BANCS.INPUT.refAmt) != "")THEN
		#{
			CUST.CIETXN.refAmt = TOUPPER(TRIM(BANCS.INPUT.refAmt))
			print(CUST.CIETXN.refAmt)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.splRateCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.splRateCode) != "")THEN
		#{
			CUST.CIETXN.splRateCode = TOUPPER(TRIM(BANCS.INPUT.splRateCode))
			print(CUST.CIETXN.splRateCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.customerRate))THEN
	#{
		IF(TRIM(BANCS.INPUT.customerRate) != "")THEN
		#{
			CUST.CIETXN.customerRate = TOUPPER(TRIM(BANCS.INPUT.customerRate))
			print(CUST.CIETXN.customerRate)
		#}
		ENDIF
	#}
	ENDIF
	
	###########################################################################################
	# Context Switch to Target Entity
	###########################################################################################
	
	CUST.CIETXN.entityId = CUST.CIETXN.targetEntityId
	PRINT(CUST.CIETXN.entityId)
	CALL("cietxndp010.scr")
	
	###########################################################################################
	# Convery Ref Amt to Tran Amt
	###########################################################################################
	
	BANCS.INPARAM.InputAmount = CUST.CIETXN.refAmt
	BANCS.INPARAM.FromCurrency = CUST.CIETXN.fromCcy
	BANCS.INPARAM.ToCurrency = CUST.CIETXN.toCcy
	BANCS.INPARAM.RateCode = CUST.CIETXN.splRateCode
	BANCS.INPARAM.Rate = CUST.CIETXN.customerRate
	BANCS.INPARAM.CustId = ""
	
	sv_u = urhk_B2k_ConvertAmount("")
	print(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.CIETXN.tranAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		PRINT(CUST.CIETXN.tranAmt)
		CUST.CIETXN.tranAmtCcy = CUST.CIETXN.toCcy
		PRINT(CUST.CIETXN.tranAmtCcy)
	#}
	ENDIF
	
	###########################################################################################
	# Context Switch to Home Entity
	###########################################################################################
	
	CUST.CIETXN.entityId = CUST.CIETXN.startEntityId
	PRINT(CUST.CIETXN.entityId)
	CALL("cietxndp010.scr")
	
	
	ENDOFSCRIPT:
		
		lv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
		print(lv_u)
		lv_u = urhk_SetOrbOut("errorMsg|"+CUST.CIETXN.errorMsg)
		print(lv_u)
		lv_u = urhk_SetOrbOut("tranAmt|"+CUST.CIETXN.tranAmt)
		print(lv_u)
		lv_u = urhk_SetOrbOut("tranAmtCcy|"+CUST.CIETXN.tranAmtCcy)
		print(lv_u)
		
END-->
