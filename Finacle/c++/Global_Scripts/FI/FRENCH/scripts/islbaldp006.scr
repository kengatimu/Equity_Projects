	sv_s = "INSERT INTO CUSTOM.ISLBAL("
	sv_s = sv_s + "TRAN_ID,TRAN_DATE,CRNCY_CODE,SOL_ID,BANK_ID)"
	sv_s = sv_s + "VALUES(?SVAR,to_date(?SVAR,'DD-MM-YYYY'),?SVAR,?SVAR,?SVAR)"
	PRINT(sv_s)
	
	sv_d = urhk_dbSQLWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
