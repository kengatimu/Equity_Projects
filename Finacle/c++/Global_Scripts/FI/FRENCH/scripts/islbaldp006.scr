			CUST.ISLAMIC.writeToRpt = CUST.ISLAMIC.solId + "|" + CUST.ISLAMIC.crncyCode + "|" + CUST.ISLAMIC.errorMsg
			sv_u = urtn_fileWrite(CUST.ISLAMIC.dataFileIndex + "|"+ CUST.ISLAMIC.writeToRpt)
