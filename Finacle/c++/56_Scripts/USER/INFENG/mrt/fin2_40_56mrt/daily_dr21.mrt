# ******************************************************************
#    Report Name		: Inward Clearing register Report
#    Author     		: Erick G. Karobia 
#
# ******************************************************************
#
RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#	
####################################################################
TRNID  stringType
BNK	stringType
BRCH 	stringType
SCHM 	stringType
ACC	stringType
ACNAM	stringType
PAYEE	stringType
INSTNO	stringType
AMT	numberType
NARR	stringType
OPER	stringType
SUPER	stringType
ZONE_CODE  	stringtype
####################################################################
LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
grcount	        numberType
grtotal		 numberType
totali		 numberType
totala		 numberType
page_number     numberType
lv_setid	    stringType  
callscript      stringType
lv_setdesc	    stringType
lv_userId	    stringType 
ipstype		    stringtype

####################################################################
GROUPANDSORT
ZONE_CODE,schm
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
 bankName		stringType
 branchName		stringType
###################################################################
REPOSITORY argv4
ipSetId				stringType
ipDate				stringType
ipzone				stringType
####################################################################
IGNORERECORd
####################################################################
#
####################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines   3
linesPerPage       70
leftMargin 	   2 
rightMargin	   2
topMargin	   6
bottomMargin	   2
columnsPerLine 	   212
pageHeaderLines	   8 
pageFooterLines	   2 
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
execute brBankHdg
execute pageHdr
set pagenumber=1

PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
execute pageHdr
separatorline

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
separatorline
#
BEFOREBREAKOF ZONE_CODE
###################################################################
#BEFOREBREAKOF  
####################################################################
print "Transcations for clearing zone  " column 3
print ZONE_CODE 
nexTline

#
#
#
AFTERBREAKOF ZONE_CODE
###################################################################
#
#afterbreakof 
####################################################################
nextline
set grtotal = groupsum  amt
set grcount = groupcount instno
separatorline 
nextline
print "Sub Total" column 25
print grcount    column 55
print grtotal size 20 autocomma precision 2  column 135 
nextline
separatorline
nextline

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute printOneRecord

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
nextline
if totalCount instno = 0
begin
	print "********************   No Records Printed   ****************" size  212 center
	nextline
	nextline
	nextline
end
separatorline
set totala = totalsum  amt
set totali = totalcount instno
print "Grand Total" column 25
print totali     column 55
print totala size 20 autocomma precision 2  column 135 
separatorline
print "Printed By:" column 1
print lv_userId column 20
nextline
nextline
print "Verified By:"
nextline
separatorline
######################################################################
#  Procedure Block
######################################################################
PROCEDURE pageHdr
separatorline
print "TRAN ID"      column 1
print "BANK"         column 9
print "BRANCH"       Column 20
print "SCHM CODE"    column 35
print "A/C NO."      column 50
print "A/C NAME"     column 60
print "PAYEE  "      column 90 
print "INSTR NO"     column 125
print "AMOUNT "      column 141
print "NARRATION "   column 158
print "OPERATOR "    column 180 
print "SUPERVISOR"   column 195
separatorline

####################################################################
PROCEDURE printOneRecord
####################################################################
print LTRIM trnid " " 	 column 1
print bnk   	column 9
set brch = splitstring brch 1,15
print brch  	column 18
print schm  	column 35
print acnam  	column 45
set acc = splitstring acc 1,32
print acc    column 60
set payee = splitstring payee 1,28
print payee     column 90
print instno    column 125
print amt size 20 autocomma precision 2  column 135 
set narr = splitstring narr 1,20
print narr      column  158
set oper = splitstring oper 1,15
print oper      column  180
set super = splitstring super 1,15
print super     column  195
####################################################################
PROCEDURE brBankHdg

begin
        print "Page No. "   column 190
        print page_number precision 0
        nextline
        print today column 190
        nextline
        nextline
	print "EQUITY BANK LIMITED" size  212 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 212 center
	nextline
	print "INWARD CLEARING REPORT"  size 212 center
	nextline
	print "ZONE DATE/CODE: " column 95
	print ipDate size 10
        print "/ " 
        print ipzone 
        nextline
        set page_number= page_number+1
        nextline
end
####################################################################
# End of File
######################################################################


