# Template Name :		Safipo.mrt
# Description	:		Unrecocilied IPO
# Author			E.G.KAROBIA, 31-03-2008
# 
#########################################################################
RECORDLAYOUT

sol_id	StringType
tran_date	StringType
FIN_TRANS	StringType
FINTRANAMT	StringType
IPO_TRANS	StringType
IPOTOTAL_PAYMENT	StringType
iposhare_applied	StringType

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 70
columnsperline 120
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId				stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 70 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print sol_id  column 2	
	print tran_date    column 7
	print FIN_TRANS column  20
	print FINTRANAMT column  35
	print  IPO_TRANS column  70
	print IPOTOTAL_PAYMENT column  90
	print iposhare_applied column  110

end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL" column 2	
	print "Date"     column 8
	print "Finacle App." column  20
	print "Finacle Amt." column  35
	print "IPO Sys App." column  70
	print "IPO Sys Amt." column  90
	print "Total Shares Applied" column  110
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 120 center 
	nextline
	print branchName  size 120 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 120 center
	nextline
	Print " UNRECONCILIED SAFARICOM IPO REPORT " size 120 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 120 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|" column 1	
	print "|"  column 7
	print "|" column  19
	print "|" column  34
	print "|" column  69
	print "|" column  89
	print "|" column  119

end


