#print iss_br_name column 19 
#print dd_num column 51 	 precision 0
nextline
nextline
nextline
nextline
nextline
print ceiling_amt column 27
nextline
print dd_date column  80
nextline
nextline
#nextline 
#nextline
print "                           " 
Print payee_name_1 column 6
nextline
nextline
print payee_name_2 column 8
nextline
print amt_str  column 62 size 30  rightjustify
nextline
if ( dd_amt < 1 )
 begin
  print "NIL" column 45
  print s1 column 36
 end
else
 begin
# nextline
print "                           "
 print s1 column 16
end
if ( deplen1 <= 40 )
begin
 if ( deplen2 = 0 )
  begin
   if ( deplen1 < 35 )
    begin
     print "Only"
    end
   else
   begin
    nextline
    print "Only"
   end
  end
end
nextline
nextline
nextline
print s2 column 8
if ( deplen2 > 0 )
begin
 if ( deplen3 = 0 )
 begin
  if ( deplen2 < 40 )
  begin
   print "Only"
  end
  else
  begin
   nextline
   print "Only"
  end
 end
end
nextline
nextline
print s3 column 15
if ( deplen3 > 0 )
begin
 print "Only"
end	
