<--start
trace on
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_r = urhk_MTTS_PopulateInputDetails("")
        print(sv_r)
        if(sv_r==0)then
                EBSRV.GLBDATA.PoNumber = MTT.InputDetails.Argument1
                EBSRV.GLBDATA.PoAmount = MTT.InputDetails.Argument2
                EBSRV.GLBDATA.PoCrAcctId = MTT.InputDetails.Argument3
                EBSRV.GLBDATA.PoStatus = MTT.InputDetails.Argument4
        else
                EBSRV.GLBDATA.PoNumber = "" 
                EBSRV.GLBDATA.PoAmount = "" 
                EBSRV.GLBDATA.PoCrAcctId = "" 
                EBSRV.GLBDATA.PoStatus = "" 
        endif
	print(EBSRV.GLBDATA.PoNumber)
	print(EBSRV.GLBDATA.PoAmount)
	print(EBSRV.GLBDATA.PoCrAcctId)
	print(EBSRV.GLBDATA.PoStatus)
	EBSRV.GLBDATA.isModuleType = "MTN"
	EBSRV.GLBDATA.toAddr = "UGCentralMonitoring@equitybank.co.ug,UGProcessing@equitybank.co.ug,UGTreasury@equitybank.co.ug"
	##EBSRV.GLBDATA.toAddr = "vino.palani@simbatech.biz,Edwin.Mureithi@equitybank.co.ke,godwin.twinobusingye@equitybank.co.ug"
	sv_u = urhk_getFileLocation("COM|ebMtnAlert.com")
	if(sv_u ==0)then
		print(BANCS.OUTPARAM.fileLocation)
		EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "ebMtnAlert.com"
		print(EBSRV.GLBDATA.comfil)
		print(EBSRV.GLBDATA.toAddr)
		if(EBSRV.GLBDATA.isModuleType=="MTN")then
		EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " +'"'+ EBSRV.GLBDATA.toAddr + '"'+" " +'"'+ EBSRV.GLBDATA.PoNumber+'"'+ " " +'"'+ EBSRV.GLBDATA.PoAmount +'"'+ " " +'"'+ EBSRV.GLBDATA.PoCrAcctId +'"'+ " " +'"'+ EBSRV.GLBDATA.PoStatus +'"'+ " " +'"'+EBSRV.GLBDATA.isModuleType +'"'+ " "
		endif
	else
		EBSRV.GLBDATA.comfil   = ""
	endif
	if(EBSRV.GLBDATA.comfil != "")then
		print(EBSRV.GLBDATA.comfil)
		sv_u = system(EBSRV.GLBDATA.comfil)
		if(sv_u ==0)then
			print("smtp success")
		else
			print("failed smtp")
		endif
	endif
trace off
end-->
