<--start
trace on
# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether HTM Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","HTM")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","HTM",5)
	#}
	ENDIF
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	CUST.HTM.acctCrncy =" "
	CUST.HTM.refCrncy=" "
	CUST.HTM.tranType=" "
	CUST.HTM.rateCode =" "
	CUST.HTM.rate=" "
	CUST.HTM.treaRate=" "
	CUST.HTM.errorFlg="N"
	CUST.HTM.errorMsg =" "
	CUST.HTM.rateCodeCash =" "
	CUST.HTM.rateCodetran = " "
	CUST.HTM.drCrInd = " "


IF(CUST.HTM.drCrInd == "D") THEN
					#{
					#CUST.HTM.foracid1= "0130179836963"
					sv_s = "acctId,AccontName,clr_bal_amt1,SchmCode,cifid,rcretime,dbstatdate|"
					sv_s = sv_s + "select g.foracid,g.acct_name,clr_bal_amt, schm_code,cif_id,TO_CHAR(a.rcre_time,'DD-MM-YYYY'),TO_CHAR(DB_STAT_DATE,'DD-MM-YYYY')"
					sv_s = sv_s + " from tbaadm.gam g,CUSTOM.ALERT_ODCA1 a,tbaadm.gct t where schm_type in('ODA') and g.bank_id=?SVAR and g.bank_id=t.bank_id and"
					sv_s = sv_s + " g.entity_cre_flg='Y' and g.del_flg='N' and g.foracid=?SVAR and cif_id in (select cif_id from tbaadm.gam where schm_code in ('ODCA1'))"
					sv_s = sv_s + " and g.acid in(select acid from CUSTOM.ALERT_ODCA1  where amount>0) AND ROWNUM<=1"
							
					print(sv_s)
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+ CUST.HTM.acctId
					print(BANCS.INPARAM.BINDVARS)
	
					sv_e = urhk_dbSelectWithBind(sv_s)
					print(sv_e)
	
					IF(sv_e == 0) THEN
					#{
					CUST.HTM.SchmCode=BANCS.OUTPARAM.SchmCode
					print(CUST.HTM.SchmCode)
					BANCS.INPARAM.date1 = BANCS.OUTPARAM.rcretime
					PRINT(BANCS.INPARAM.date1)
					BANCS.INPARAM.date2 = BANCS.OUTPARAM.dbstatdate
					PRINT(BANCS.INPARAM.date2)
					sv_i = urhk_B2k_dateDiff("")
					print(sv_i)
					PRINT(BANCS.OUTPARAM.dateDiff)
					CUST.HTM.DATEDIFF = BANCS.OUTPARAM.dateDiff
						
						if(CUST.HTM.DATEDIFF <0) then
						sv_a=CUST.HTM.DATEDIFF
						sv_b=MID$(sv_a,1,4)
						sv_k=TRIM(sv_b)
						print(sv_k)
						CUST.HTM.DATEDIFF = sv_k
						print(CUST.HTM.DATEDIFF)
						
						else
						print(CUST.HTM.DATEDIFF)
						endif

						IF((CUST.HTM.DATEDIFF) >= CINT("1")) THEN
						#{
							#sv_u=urhk_SetOrbOut("Account is linked to a overdraft account with 30 days in arrears| Error")
							CUST.HTM.errorMsg = "Account is linked to a overdraft account with 3 days in arrears"
							#PRINT(CUST.HTM.errorMsg)
							CUST.HTM.errorFlg="Y"
							#GOTO ENDOFSCRIPT1

						#}	
						ENDIF			
						#}
						endif
						#GOTO ENDOFSCRIPT
	#}
	ENDIF

trace off
end-->