-------------------------------------------------------------------------------------------------------------
#    Name            : AutoVirtualAccountOpen.scr
#    Description     : Automation menu for virtual cards account opening
#    Date            : 24-June-2024
#    Input           : NA
#    Output          : NA
#    Calling Script  : NA
#    Menu Option     : CAUTOMNU
# Sl. #           Date             Author             Modification           Version
# -----        ----------         --------------    ----------------        ---------
#  1           24-June-2024      Anand Pansare      Original Version         1.0
#  2           15-Aug-2024 	     Osuka S      		Original Version         1.1
#------------------------------------------------------------------------------------------------------

<--START
TRACE ON



	#==============================================================================
	#       Intialising Variables
	#=============================================================================
	IF (REPEXISTS("CUST") == 0) THEN
	#{
	CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r == 0) THEN
	#{
	CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
        
	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)

	IF(FIELDEXISTS(BANCS.STDIN.contextBankId)) THEN
		IF(CINT(BANCS.STDIN.contextBankId) == "56") THEN
			PRINT("Bank ID okay")
		ELSE
			CUST.DATA.msg = "Bank ID Error"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			EXITSCRIPT
		ENDIF
	ELSE
		CUST.DATA.msg = "Bank ID Error"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ENDIF

	IF(FIELDEXISTS(BANCS.STDIN.userWorkClass)) THEN
		IF(CINT(BANCS.STDIN.userWorkClass) == 144) THEN
			PRINT("User work class okay")
		ELSE
			CUST.DATA.msg = "User work class error"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			EXITSCRIPT
		ENDIF
	ELSE
		CUST.DATA.msg = "User work class error"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ENDIF

	IF(FIELDEXISTS(BANCS.STDIN.mySolId)) THEN
		CUST.DATA.mySolId = BANCS.STDIN.mySolId
	ELSE
		CUST.DATA.msg = "Sol ID  error"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ENDIF

	CUST.DATA.SOURCEFILE = CUST.DATA.FilePath
	print(CUST.DATA.SOURCEFILE)

	sv_r = urtn_fileAccess(CUST.DATA.SOURCEFILE)
	print(sv_r)
	IF ( sv_r != 0 ) THEN
		CUST.DATA.msg = "Unable to Access FILE_LIST"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ENDIF

	#--------------------------
	#	OPENING THE FILE
	#--------------------------

	sv_t = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	print(sv_t)
	IF (sv_t < 0) THEN
		CUST.DATA.msg = "Unable to open the file"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ELSE
		print("File Opened SuccessFully")
		CUST.DATA.succIndex = sv_t
	ENDIF

	#===================================================================================================================
	#       Read The File Data
	#===================================================================================================================

	CUST.DATA.fileRec = urtn_fileOpen(CUST.DATA.SOURCEFILE + "|r")
	PRINT(CUST.DATA.fileRec)
	sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
	PRINT(sv_t)
	IF(sv_t != 0) THEN
		CUST.DATA.msg = "Upload file is empty"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ENDIF

	sv_z = 0
	sv_y = 0
	CUST.DATA.RECCNT = 0
	#=======================================================================================
	#       Split And Storage Of data in file
	#=======================================================================================

	WHILE(sv_t == 0)
	#{
		CUST.DATA.OperAcctId 		= ""
		CUST.DATA.SolId			= ""
		CUST.DATA.LoanAcctId		= ""
		CUST.DATA.LoanAmt 		    	= ""
		CUST.DATA.Term		 	= ""
		CUST.DATA.Lace	 		= ""
		CUST.DATA.Insurance			= ""
		CUST.DATA.SchemeCode		= "LA581"
		CUST.DATA.BankId 			= BANCS.STDIN.contextBankId
		CUST.DATA.GracePeriod	 	= ""
		CUST.DATA.StartDate			= ""
		CUST.DATA.StartFlowDate		= ""
		CUST.DATA.RepaymentDay		= ""
		CUST.DATA.Currency 			= ""
		CUST.DATA.InterestPref		= ""
		CUST.DATA.cifId 			= ""
		CUST.DATA.ErrorCode			= ""
		CUST.DATA.userId 			= BANCS.STDIN.userId
		CUST.DATA.VerifiedBy		= ""
		CUST.DATA.DisbursedBy		= ""
		
		sv_y = format$(sv_z,"%d")
		CUST.DATA.RECCNT = cint(CUST.DATA.RECCNT)+1
		CUST.DATA.inputRecord = TOUPPER(CUST.DATA.inputRecord)
		sv_k = CUST.DATA.inputRecord
		print(sv_k)
		sv_q = getposition(sv_k,",")
		print(sv_q)
		if(sv_q == 0) then
			sv_z = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_z)
			sv_z = "Error_03|ERROR^Enter an Valid file^upldFile"
			sv_u = urhk_SetOrbOut(sv_z)
			GOTO ENDOFSCRIPT
		ENDIF
	
		sv_g = 0
		sv_n = 1

		sv_l = STRLEN(CUST.DATA.inputRecord)
		sv_c = CUST.DATA.inputRecord
		print(sv_c)
		sv_q = getposition(sv_c,",")
		print(sv_q)
		CUST.DATA.OperAcctId= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.OperAcctId)

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.LoanAmt= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.LoanAmt)

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.Term= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.Term)

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.Lace= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.Lace)		

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.Insurance= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.Insurance)

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.GracePeriod= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.GracePeriod)		

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.StartDate= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.StartDate)

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.RepaymentDay= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.RepaymentDay)

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		sv_q = getposition(sv_c,",")
		CUST.DATA.Currency= Left$(sv_c,sv_q - 1)
		print(CUST.DATA.Currency)

		sv_l = sv_l - sv_q
		sv_c = mid$(sv_c,sv_q,sv_l)
		CUST.DATA.InterestPref= sv_c
		print(CUST.DATA.InterestPref)

		IF(CINT(CUST.DATA.GracePeriod) > 0) THEN
			sv_b = "0"
			sv_f = CUST.DATA.StartDate + "|" + CUST.DATA.GracePeriod + "|" + sv_b
			Print(sv_f)
			sv_e = urhk_B2k_Add_MonthsDays_To_date(sv_f)
			if ( sv_e == 1 ) then
    				CUST.DATA.StartFlowDate	= CUST.DATA.StartDate	
			else
    				CUST.DATA.StartFlowDate	= MID$(BANCS.OUTPARAM.MODIFIED_DATE,0,10)
			ENDIF
		ELSE
			CUST.DATA.StartFlowDate	= CUST.DATA.StartDate		
		ENDIF

		sv_a = "op_sol_id|select sol_id from tbaadm.gam where foracid = ?SVAR AND BANK_ID = ?SVAR "
		print(sv_a)	
		BANCS.INPARAM.BINDVARS = CUST.DATA.OperAcctId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_s = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_s)
		IF (sv_s == 0) THEN
			CUST.DATA.SolId = BANCS.OUTPARAM.op_sol_id
			PRINT(CUST.DATA.SolId)
		ENDIF

		print(CUST.DATA.OperAcctId)
		print(CUST.DATA.SolId)
		print(CUST.DATA.LoanAcctId)
		print(CUST.DATA.LoanAmt)
		print(CUST.DATA.Term)
		print(CUST.DATA.Lace)
		print(CUST.DATA.Insurance)
		print(CUST.DATA.SchemeCode)
		print(CUST.DATA.BankId)
		print(CUST.DATA.GracePeriod)
		print(CUST.DATA.StartDate)
		print(CUST.DATA.StartFlowDate)
		print(CUST.DATA.RepaymentDay)
		print(CUST.DATA.Currency)
		print(CUST.DATA.cifId)
		print(CUST.DATA.InterestPref)
		print(CUST.DATA.ErrorCode)
		print(CUST.DATA.userId)
		print(CUST.DATA.file_name)
		
		#===================================================================================================
		#       STORAGE OF DATA INTO CUSTOM TABLE
		#===================================================================================================
		
		sv_s = ""
		sv_s = sv_s + " insert into CUSTOM.BULK_LOAN "
		sv_s = sv_s + " (OPACC, ENTITY_CRE_FLG, SOL_ID, LOANAC, LOANAMT, PERIOD, LACE, INSURANCE, SCHM_CODE, GRACE_PERIOD, STARTDATE, STARTFDATE, OTHER, CRNCY_CODE, CIF_ID, INTEREST_PREF, ERROR_CODE, USER_ID, FILE_NAME, BANK_ID) "
		sv_s = sv_s + " values (?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, to_date(?SVAR, 'DD-MM-YYYY'), to_date(?SVAR, 'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR )"
		print(sv_s)
			
		BANCS.INPARAM.BINDVARS  = CUST.DATA.OperAcctId + "|" + "N"
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.SolId
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.LoanAcctId
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.LoanAmt
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.Term
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.Lace
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.Insurance
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.SchemeCode
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.GracePeriod
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.StartDate
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.StartFlowDate
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.RepaymentDay
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.Currency
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.cifId
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.InterestPref
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.ErrorCode
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.userId
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.file_name
		BANCS.INPARAM.BINDVARS  = BANCS.INPARAM.BINDVARS  + "|" + CUST.DATA.BankId
		print(BANCS.INPARAM.BINDVARS)

		sv_r =  urhk_dbSQLwithbind(sv_s)
		print(sv_r)
		if(sv_r == 0)then
			sv_r = urhk_dbSQLwithbind("commit")
			print(sv_r)
			if(sv_r == 0)then
				CUST.DATA.sucess = "UPDATE SUCCESSFUL"
				CUST.DATA.scnt="1"
			else
				CUST.DATA.errorMsg  = " UPDATE FAILED"
				sv_r = urhk_dbSQLwithbind("ROLLBACK")
				GOTO NEXTREC1
			endif
		else
			CUST.DATA.errorMsg  = "UPDATE SOME ERROR IN THIS"
			sv_w =CUST.DATA.errorMsg+"  "+CUST.DATA.SOURCEFILE
			print(sv_w)
			sv_r = urhk_dbSQLwithbind("ROLLBACK")
			GOTO NEXTREC1
		endif

		NEXTREC1:
		sv_t = urtn_fileRead(CUST.DATA.fileRec + "|CUST.DATA.inputRecord")
		PRINT(sv_t)
		sv_z = sv_z + 1
		PRINT(sv_z)


		CUST.DATA.recCount = sv_z
		print(CUST.DATA.recCount)
		sv_y = format$(sv_z,"%d")
		PRINT(sv_y)
	DO
	#===================================================================================#
	# Closing the files                                                                 #
	#===================================================================================#
	sv_j = urtn_fileClose(CUST.DATA.SOURCEFILE)
	print(sv_j)
	sv_t = urtn_fileClose(CUST.DATA.fileRec)
	PRINT(sv_t)
	sv_e = system("mv "+CUST.DATA.FilePath+" "+CUST.DATA.FilePath+"_Done")
	print(sv_e)	

ENDOFSCRIPT:
	#-- Report for successfully uploaded records
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) "
	sv_s = sv_s + " FROM CUSTOM.BULK_LOAN "
	sv_s = sv_s + " WHERE ENTITY_CRE_FLG = 'N' "
	sv_s = sv_s + " AND SOL_ID= ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR AND CIF_ID is null AND FILE_NAME = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name 
	
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
		CUSTS.DATA.msg = "DB ERROR!"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
	ELSE
		print(BANCS.OUTPARAM.custcount)
		CUST.DATA.count = BANCS.OUTPARAM.custcount
		IF (CINT(CUST.DATA.count)== 0) THEN
			CUST.DATA.msg = "No records found"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			EXITSCRIPT
		ENDIF

		IF(CUST.DATA.count<1)THEN
			CUST.DATA.msg = "No records found"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			EXITSCRIPT
		ENDIF

		lv_d = urhk_B2k_PID("")
		IF (lv_d == 0) THEN
			CUST.DATA.pid = BANCS.OUTPARAM.PID
			PRINT(CUST.DATA.pid)
		ENDIF

		#-----------------------------------------------------------------------------------------
		#Calling the sql to create the report
		#-----------------------------------------------------------------------------------------
		CUST.DATA.lstFile = "Bulk_Loan_Acct_Upload_Success_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"

		CUST.DATA.status = "N"
		CUST.DATA.inputStr = CUST.DATA.file_name + "!" + BANCS.STDIN.contextBankId + "!" + BANCS.STDIN.mySolId + "!" + CUST.DATA.status
		print(CUST.DATA.inputStr)

		CUST.DATA.ReportHeader = "OPERATIVE A/C   |LOAN A/C          |LOANAMT     |TERM|LACE    |INSURANCE|STARTDATE |CIF ID          |OTHER|CURRENCY|USER ID |DISB      |STARTFDATE|INT PREF|GRACE PRD|VERIFIED|DISBD BY|ERROR CODE                                                                      |"

		lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
		PRINT(lv_a)
		lv_s = SYSTEM(lv_a)
		PRINT(lv_s)
		
		sv_a = "exebatch spbx4001" + " " + "CUSTOM.BULK_LOAN_ACCT_OPN.BULK_LOAN_ACCT_OPN_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
		PRINT(sv_a)
		lv_u = SYSTEM(sv_a)
		PRINT(lv_u)
		IF (lv_u != 0) THEN
		#{
			CUST.DATA.errMsg = "Report generation Failed"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.errMsg)
			EXITSCRIPT
		ELSE
			#=====================================================================
			# Move the file to HPR menu
			#=====================================================================
			CUST.DATA.userId = BANCS.STDIN.userId
			CUST.DATA.title = "Bulk Loan Acct Upload " + CUST.DATA.file_name + " Success Rpt"
			PRINT(CUST.DATA.title)
			lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
			PRINT(lv_a)
			lv_x = SYSTEM(lv_a)
			PRINT(lv_x)
			if(lv_x == 0) then
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.file_name+". Check status in HPR"
				sv_z = urhk_SetOrbOut(sv_g)
				PRINT(sv_z)
			ELSE
				CUST.DATA.msg = "Error_2|Error.2^Virtual Account Opening Report Generation Failed "
				sv_c = urhk_setorbout("SuccessOrFailure|N")
				sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
				EXITSCRIPT
			ENDIF
		ENDIF
	ENDIF

	#-- Report for failed uploaded records
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) "
	sv_s = sv_s + " FROM CUSTOM.BULK_LOAN "
	sv_s = sv_s + " WHERE ENTITY_CRE_FLG = 'E' "
	sv_s = sv_s + " AND SOL_ID= ?SVAR"
	sv_s = sv_s + " AND bank_id = ?SVAR AND CIF_ID is null AND FILE_NAME = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.file_name 
	
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
		CUSTS.DATA.msg = "DB ERROR!"
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
	ELSE
		print(BANCS.OUTPARAM.custcount)
		CUST.DATA.count = BANCS.OUTPARAM.custcount
		IF (CINT(CUST.DATA.count)== 0) THEN
			CUST.DATA.msg = "No records found"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			EXITSCRIPT
		ENDIF

		IF(CUST.DATA.count<1)THEN
			CUST.DATA.msg = "No records found"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			EXITSCRIPT
		ENDIF

		lv_d = urhk_B2k_PID("")
		IF (lv_d == 0) THEN
			CUST.DATA.pid = BANCS.OUTPARAM.PID
			PRINT(CUST.DATA.pid)
		ENDIF

		#-----------------------------------------------------------------------------------------
		#Calling the sql to create the report
		#-----------------------------------------------------------------------------------------
		CUST.DATA.lstFile = "Bulk_Loan_Acct_Upload_Failure_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"

		CUST.DATA.status = "E"
		CUST.DATA.inputStr = CUST.DATA.file_name + "!" + BANCS.STDIN.contextBankId + "!" + BANCS.STDIN.mySolId + "!" + CUST.DATA.status
		print(CUST.DATA.inputStr)

		CUST.DATA.ReportHeader = "OPERATIVE A/C   |LOAN A/C          |LOANAMT     |TERM|LACE    |INSURANCE|STARTDATE |CIF ID          |OTHER|CURRENCY|USER ID |DISB      |STARTFDATE|INT PREF|GRACE PRD|VERIFIED|DISBD BY|ERROR CODE                                                                      |"

		lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
		PRINT(lv_a)
		lv_s = SYSTEM(lv_a)
		PRINT(lv_s)
		
		sv_a = "exebatch spbx4001" + " " + "CUSTOM.BULK_LOAN_ACCT_OPN.BULK_LOAN_ACCT_OPN_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
		PRINT(sv_a)
		lv_u = SYSTEM(sv_a)
		PRINT(lv_u)
		IF (lv_u != 0) THEN
		#{
			CUST.DATA.errMsg = "Report generation Failed"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.errMsg)
			EXITSCRIPT
		ELSE
			#=====================================================================
			# Move the file to HPR menu
			#=====================================================================
			CUST.DATA.userId = BANCS.STDIN.userId
			CUST.DATA.title = "Bulk Loan Acct Upload " + CUST.DATA.file_name + " Failure Rpt"
			PRINT(CUST.DATA.title)
			lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
			PRINT(lv_a)
			lv_x = SYSTEM(lv_a)
			PRINT(lv_x)
			if(lv_x == 0) then
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.file_name+". Check status in HPR"
				sv_z = urhk_SetOrbOut(sv_g)
				PRINT(sv_z)
			ELSE
				CUST.DATA.msg = "Error_2|Error.2^Virtual Account Opening Report Generation Failed "
				sv_c = urhk_setorbout("SuccessOrFailure|N")
				sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
				EXITSCRIPT
			ENDIF
		ENDIF
	ENDIF
		
EXITSCRIPT
TRACE OFF
END-->
