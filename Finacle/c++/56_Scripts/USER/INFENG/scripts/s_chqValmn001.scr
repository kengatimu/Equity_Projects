	sv_u = urhk_SRV_NumOfRecs("ptranLL")
	CUST.DATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.DATA.noOfRecords)
	
	sv_l = 0
	WHILE(sv_l < CUST.DATA.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		
		sv_u = urhk_SRV_GetVal("ptranLL." +sv_r+ ".ptranAcctId.foracid")
