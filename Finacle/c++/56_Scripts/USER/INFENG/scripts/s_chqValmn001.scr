		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Amount cannot exceed 6000")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ((CUST.DATA.zoneCcy==CUST.DATA.chqValCcy4) AND (CDOUBLE(CUST.DATA.pTranAmt) >CDOUBLE(CUST.DATA.chqValCAmt4))) THEN
		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Amount cannot exceed 800000")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF (CUST.DATA.pTranAmt =="" ) THEN
		#{
			sv_u = urhk_SRV_SetErr("ptranLL." +sv_r+ ".partTranAmtInInstCrncy|Error: Amount should be entered")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			IF (CUST.DATA.zoneCcy==CUST.DATA.chqValCcy) THEN
			#{
				print(CUST.DATA.pTranAmt)
				sv_b = ""
				sv_c = getposition(CUST.DATA.pTranAmt, sv_b)
				print(sv_c)
				sv_d = STRLEN(CUST.DATA.pTranAmt )
				print(sv_d)
				sv_e = MID$(CUST.DATA.pTranAmt ,sv_c,sv_d)
				print(sv_e)
				
				sv_a = CINT(sv_e)
				print(sv_a)
				sv_c = CDOUBLE(sv_e)
				print(sv_c)
				IF (sv_c > sv_a) THEN
				#{
					IF((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "56")) THEN
					#{
						IF(CUST.DATA.chqValCcy == BANCS.STDIN.homeCrncyCode) THEN
						#{
