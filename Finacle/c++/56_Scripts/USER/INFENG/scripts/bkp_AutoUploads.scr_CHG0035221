<--START
TRACE ON
	sv_u = urhk_B2k_PrintRepos("BANCS")
	print(sv_u)

	libname CUSTOMSO
	#======================================================================
	#Repository And Class Creation
	#=====================================================================
	IF (REPEXISTS("CUST") == 0) THEN
		CREATEREP("CUST")
	ENDIF
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
		CREATECLASS("CUST", "DATA", 5)
	ENDIF

	if(classexists("MTT","InputDetails")==0)then
		createclass("MTT","InputDetails",5)
	endif
	sv_a = urhk_MTTS_PopulateInputDetails("")
	print(sv_a)
	if(sv_a==0)then
		CUST.DATA.FilePath= MTT.InputDetails.Argument1
		print(CUST.DATA.FilePath)
		CUST.DATA.file_name= MTT.InputDetails.Argument2
		print(CUST.DATA.file_name)
		CUST.DATA.FunCode= MTT.InputDetails.Argument3
		print(CUST.DATA.FunCode)
	else
		CUST.DATA.FilePath= ""
		CUST.DATA.file_name= ""
		CUST.DATA.FunCode= ""
	endif

	IF  (CUST.DATA.FunCode == "LI") THEN
		call ("AutoLienInq.scr")
	ENDIF
	IF  (CUST.DATA.FunCode == "OA") THEN
		call ("AutoOpLoan.scr")
	ENDIF
	IF  (CUST.DATA.FunCode == "UL") THEN
		call ("AutoLienLift.scr")
	ENDIF
	IF  (CUST.DATA.FunCode == "UC") THEN
			call ("AutoAccountClosure.scr")
	ENDIF
	IF  (CUST.DATA.FunCode == "US") THEN
			call ("AutoAcctSchmChange.scr")
	ENDIF
	IF  (CUST.DATA.FunCode == "UA") THEN
			call ("AutoAcctMgrChange.scr")
	ENDIF
	
	#---------------- MODIFIED BY OSUKA: funcCodes TO Reverse credit balance to operative account for charged off loans ------------#
	IF  (CUST.DATA.FunCode == "UB") THEN
			call ("AutoRevCrdBalClsChgoffLAA.scr")
	ENDIF

	#----------------- MODIFIED BY OSUKA: Adding UD - 15-MAY-24 --------------------------------------------------------------------#
	IF  (CUST.DATA.FunCode == "UD") THEN
		call ("AutoAccountActivation.scr")
	ENDIF

	#==========================================================
	# Virtual Account Opening Added By Anand 
	#==========================================================
	IF(CUST.DATA.FunCode == "VA") THEN
	#{
		call ("AutoVirtualAccountOpen.scr")
	#}
	ENDIF
	#==========================================================

	#----------- Upload details for bulk loan accounts opening - 16-SEP-2024 --------
	IF(CUST.DATA.FunCode == "SC") THEN
	#{
		callscriptifexist("BulkCifSuspension.scr")
	#}
	ENDIF
 	IF(CUST.DATA.FunCode  == "VC")THEN
                    callscriptifexist("BulkCIFSuspensionVerify.scr")
	ENDIF

	IF(CUST.DATA.FunCode == "LO") THEN
		call ("AutoBulkLoanUpload.scr")
	ENDIF

	IF(CUST.DATA.FunCode == "LV") THEN
		call ("AutoBulkLoan.scr")
	ENDIF

        IF(CUST.DATA.FunCode == "VL") THEN
                call ("AutoLienVerifyLift.scr")
        ENDIF

	IF(CUST.DATA.FunCode == "LD") THEN
		call ("AutoBulkLoanDisb.scr")
	ENDIF



ENDOFSCRIPT:
