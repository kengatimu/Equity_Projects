#------------------------------------------------------------------------------------------------
#  Name            : ebodCloseAcct.scr
#  Description     : Close accounts after payment
#  Date            : 21-05-2024
<--start
trace on
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	
		CREATEREP("CUST")
	
	ENDIF	
	sv_r = CLASSEXISTS("CUST", "CLS")
	IF (sv_r == 0) THEN
	
		CREATECLASS("CUST", "CLS", 5)
	
	ENDIF
	#---------------------------------------------------------------------------
	#-variable initialization
	#---------------------------------------------------------------------------
	print(CUST.CLS.Foracid)
	print(CUST.CLS.SourceAcct)
			
				
	IF(CUST.CLS.schmcode =="SB777")THEN
		PRINT("Account Allowed for closure")
	ELSE
   		CUST.CLS.errMsg="Account Closure not allowed for that scheme " 
		sv_z = urhk_SetOrbOut("SuccessOrFailure|F")
		sv_t = "Msg| " +CUST.CLS.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	
	ENDIF
	
	print(BANCS.STDIN.mySolId)
	IF(CUST.CLS.solid != BANCS.STDIN.mySolId)THEN
		sv_u = urhk_SetUrhkInp("sol.solId|"+CUST.CLS.solid)
		sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
		print(sv_u)
		IF(sv_u !=0)THEN
			CUST.CLS.errMsg="Failed to switch sol "
			sv_z = urhk_SetOrbOut("SuccessOrFailure|F")
			sv_t = "Msg| " +CUST.CLS.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		ENDIF
	ENDIF
						
	sv_a=urhk_SetUrhkInp("acctBasic.foracid|" + CUST.CLS.Foracid)
	sv_a= urhk_SetUrhkInp("acctBasic.solId.solId|" + CUST.CLS.solid) 
	sv_a= urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
	sv_a= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + CUST.CLS.SourceAcct)
	sv_a= urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")

	sv_u = urhk_ExecSrv("SRV_FetchOperAcctDtlForClosure|retain_all_output = Y")
	print(sv_u)					
	IF (sv_u == 0 ) THEN
	
		sv_u = urhk_CopyOutToIn("")
		print(sv_u)
		sv_u = urhk_SetUrhkInp("acctBasic.foracid|" + CUST.CLS.Foracid)
		sv_u = urhk_SetUrhkInp("acctBasic.acid|" + CUST.CLS.acid)
		sv_u = urhk_SetUrhkInp("acctBasic.schmCode.schmCode|" + CUST.CLS.schmcode)
		sv_u = urhk_SetUrhkInp("acctBasic.solId.solId|" + CUST.CLS.solid) 
		sv_u = urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
		sv_u= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + CUST.CLS.SourceAcct)
		sv_u = urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")

		sv_u = urhk_ExecSrv("NAPI_CloseOperAcct|retain_all_output = Y")
		PRINT(sv_u)			
		IF(sv_u == 0)THEN
		
			sv_u=urhk_SetUrhkInp("acctBasic.foracid|" + CUST.CLS.Foracid)
			sv_u = urhk_SetUrhkInp("acctBasic.solId.solId|" + CUST.CLS.solid) 
			sv_u = urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
			sv_u= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + CUST.CLS.SourceAcct)
			sv_u = urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")					
					
			sv_u = urhk_ExecSrv("SRV_FetchOperAcctClsrDtlForVerify|retain_all_output = Y|same_user_verify = Y")
			print(sv_u)			
			IF (sv_u == 0 ) THEN
			
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctBasic.foracid|" + CUST.CLS.Foracid)
				sv_u = urhk_SetUrhkInp("acctBasic.acid|" + CUST.CLS.acid)
				sv_u = urhk_SetUrhkInp("acctBasic.schmCode.schmCode|" + CUST.CLS.schmcode)
				sv_u = urhk_SetUrhkInp("acctBasic.solId.solId|" + CUST.CLS.solid) 
				sv_u = urhk_SetUrhkInp("clsrProcCrit.tranType.tranType|T")
				sv_u= urhk_SetUrhkInp("clsrProcCrit.xferAcct.foracid|" + CUST.CLS.SourceAcct)
				sv_u = urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|Y")
						
				sv_u = urhk_ExecSrv("SRV_VerifyOperAcctClsrDtl|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF(sv_u == 0) THEN
						CUST.CLS.MSG = "A/c. ID "+ CUST.CLS.Foracid +" Closed Successfully. Proceeds of Closure Transferred to A/c. " + CUST.CLS.SourceAcct
						sv_z = urhk_SetOrbOut("SuccessOrFailure|S")
						sv_t = "Msg| " + CUST.CLS.MSG
						sv_u = urhk_SetOrbOut(sv_t)
						GOTO ENDSCRIPT		
				ELSE			
					GOTO CHECKERROR				
				ENDIF			
			ELSE
			
				GOTO CHECKERROR
			
			ENDIF
		
		ELSE
		
			GOTO CHECKERROR
		
		ENDIF
	
	ELSE
	
		GOTO CHECKERROR
	
	ENDIF

	CHECKERROR:

	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
											
		ELSE
		
			sv_v = 0
		
		ENDIF
		IF (sv_v > 0) then
		
			sv_u = system("echo 'Error '")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>acctclose.log")
				print(sv_u)
				
				#Error response
				sv_t = "Msg| " +sv_e
				sv_z = urhk_SetOrbOut("SuccessOrFailure|F")
				sv_u = urhk_SetOrbOut(sv_t)
				GOTO ENDSCRIPT
			
			DO
			
		ENDIF
	
	ENDIF
ENDSCRIPT:
#exitscript
#trace off
end-->
