#{
	print(BANCS.OUTPARAM.ErrMsg)
	CUST.INTERFACE.errorMsgFlg = "Y"
	CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
	CUST.INTERFACE.errorMsgCode = "FIERR"  
	GOTO ENDOFSCRIPT
#}
ENDIF
IF (BANCS.OUTPARAM.ErrMsg != "") THEN
#{
	CUST.INTERFACE.errorMsgFlg = "Y"
	CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
	CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg 
	CUST.INTERFACE.errorMsgCode = "FIERR" 
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
	print(CUST.INTERFACE.respXMLMsg)
	CUST.INTERFACE.errorMsgFlg = ""
	CUST.INTERFACE.errorMsgDesc = ""
	
CUST.INTERFACE.opndate = ""
CUST.INTERFACE.cifid = ""
CUST.INTERFACE.errorCode = ""
CUST.INTERFACE.errorDesc = ""
sv_x = CUST.INTERFACE.respXMLMsg

#--------------------------------------------------------------------------------------------------------
# Fetching the status of the request
#--------------------------------------------------------------------------------------------------------
sv_y = "<Status>"
sv_z = "</Status>"
sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
sv_e = GETPOSITION(sv_x, sv_z) - 1
IF (GETPOSITION(sv_x, sv_y) != 0) THEN
#{
	CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
#}
ELSE
#{
	CUST.INTERFACE.tranStatus = ""
#}
ENDIF
print(CUST.INTERFACE.tranStatus)
#--------------------------------------------------------------------------------------------------------
# If Success fetching cif id and cif opn date else fetching error code and description
#--------------------------------------------------------------------------------------------------------
IF (CUST.INTERFACE.tranStatus =="SUCCESS")  THEN
#{
	CUST.INTERFACE.errorMsgFlg = "N"
	sv_x = CUST.INTERFACE.respXMLMsg
	sv_y = "<TrnId>"
	sv_z = "</TrnId>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.DisbTran = MID$(sv_x, sv_b, (sv_e - sv_b))
		print(CUST.INTERFACE.DisbTran )
	#}
	ENDIF
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				sv_s = "UPDATE CUSTOM.BULK_LOAN "
				sv_s = sv_s + " SET entity_cre_flg = 'S', disb = ?SVAR, DISBURSED_BY=?SVAR"
				sv_s = sv_s + " WHERE loanac = ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR and FILE_NAME= '"+ CUST.DATA.file_name +"'   "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.INTERFACE.DisbTran  + "|" +  BANCS.STDIN.userId  + "|" + CUST.INTERFACE.LOANAC + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
		
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
		
	IF (CUST.INTERFACE.DisbTran == "") THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorCode = "SYSERR"
		CUST.INTERFACE.errorDesc = "Could not get response from server"
	#}
	ENDIF
#}
ELSE
#{
	CUST.INTERFACE.errorMsgFlg = "Y"
	IF(CUST.INTERFACE.tranStatus != "SUCCESS") THEN
	#{
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<ErrorCode>"
		sv_z = "</ErrorCode>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
		ENDIF
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<ErrorDesc>"
		sv_z = "</ErrorDesc>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
		ENDIF

			#----------------------------------------------------------------------------------------------------
			# Update custom table failure status
			#----------------------------------------------------------------------------------------------------
			IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
			#{
				CUST.INTERFACE.errorCode = "SYSERR"
				CUST.INTERFACE.errorDesc = "Could not get response from server"
			#}
			ENDIF

			sv_s = "UPDATE CUSTOM.BULK_LOAN "
			sv_s = sv_s + " SET entity_cre_flg = 'E',ERROR_CODE =?SVAR  "
			sv_s = sv_s + " WHERE loanac = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR and FILE_NAME= '"+ CUST.DATA.file_name +"' "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.errorDesc + "|" + CUST.INTERFACE.LOANAC  + "|" + BANCS.STDIN.contextBankId 
			print(BANCS.INPARAM.BINDVARS)
	
			sv_d = urhk_dbSQLWithBind(sv_s)
			IF (sv_d == 0) THEN
			#{
				sv_c = urhk_dbSQLWithBind("commit")
				print(sv_c)
			#}
			ENDIF
	#}
	ENDIF
	IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
	#{
		CUST.INTERFACE.errorCode = "SYSERR"
		CUST.INTERFACE.errorDesc = "Could not get response from server"
	#}
	ENDIF
#}
ENDIF

print(CUST.INTERFACE.errorMsgFlg)
print(CUST.INTERFACE.errorCode)
print(CUST.INTERFACE.errorDesc)
#}

ENDIF

	sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
	print(sv_k)

	#}
	DO

	sv_c = urhk_dbCursorClose(CUST.INTERFACE.DbcursorNumber)
	print(sv_c)
#}
ENDIF

lv_d = urhk_B2k_PID("")
        IF (lv_d == 0) THEN
                CUST.DATA.pid = BANCS.OUTPARAM.PID
                PRINT(CUST.DATA.pid)
        ENDIF
   

#-----------------------------------------------------------------------------------------
#Calling the sql to create the report
#-----------------------------------------------------------------------------------------
CUST.DATA.lstFile = "Bulk_Loan_Verified_Success_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"

CUST.DATA.status = "S"
CUST.DATA.inputStr = CUST.DATA.file_name + "!" + BANCS.STDIN.contextBankId + "!" + BANCS.STDIN.mySolId + "!" + CUST.DATA.status
print(CUST.DATA.inputStr)

CUST.DATA.ReportHeader = "OPERATIVE A/C   |LOAN A/C          |LOANAMT     |TERM|LACE    |INSURANCE|STARTDATE |CIF ID          |OTHER|CURRENCY|USER ID |DISB      |STARTFDATE|INT PREF|GRACE PRD|VERIFIED|DISBD BY|ERROR CODE                                                                      |"

lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
PRINT(lv_a)
lv_s = SYSTEM(lv_a)
PRINT(lv_s)

sv_a = "exebatch spbx4001" + " " + "CUSTOM.BULK_LOAN_ACCT_OPN.BULK_LOAN_ACCT_OPN_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
PRINT(sv_a)
lv_u = SYSTEM(sv_a)
PRINT(lv_u)
IF (lv_u != 0) THEN
#{
	CUST.DATA.errMsg = "Report generation Failed"
	sv_c = urhk_setorbout("SuccessOrFailure|N")
	sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.errMsg)
	EXITSCRIPT
ELSE
	#=====================================================================
	# Move the file to HPR menu
	#=====================================================================
	CUST.DATA.userId = BANCS.STDIN.userId
	CUST.DATA.title = "Bulk Loan Verified " + CUST.DATA.file_name + " Success Rpt"
	PRINT(CUST.DATA.title)
	lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
	PRINT(lv_a)
	lv_x = SYSTEM(lv_a)
	PRINT(lv_x)
	if(lv_x == 0) then
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.file_name +". Check status in HPR"
		sv_z = urhk_SetOrbOut(sv_g)
		PRINT(sv_z)
	ELSE
		CUST.DATA.msg = "Error_2|Error.2^Loan Account Opening Report Generation Failed "
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ENDIF
ENDIF

#-----------------------------------------------------------------------------------------
#Calling the sql to create the report
#-----------------------------------------------------------------------------------------
CUST.DATA.lstFile = "Bulk_Loan_Verified_Failure_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"

CUST.DATA.status = "E"
CUST.DATA.inputStr = CUST.DATA.file_name + "!" + BANCS.STDIN.contextBankId + "!" + BANCS.STDIN.mySolId + "!" + CUST.DATA.status
print(CUST.DATA.inputStr)

CUST.DATA.ReportHeader = "OPERATIVE A/C   |LOAN A/C          |LOANAMT     |TERM|LACE    |INSURANCE|STARTDATE |CIF ID          |OTHER|CURRENCY|USER ID |DISB      |STARTFDATE|INT PREF|GRACE PRD|VERIFIED|DISBD BY|ERROR CODE                                                                      |"

lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
PRINT(lv_a)
lv_s = SYSTEM(lv_a)
PRINT(lv_s)

sv_a = "exebatch spbx4001" + " " + "CUSTOM.BULK_LOAN_ACCT_OPN.BULK_LOAN_ACCT_OPN_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
PRINT(sv_a)
lv_u = SYSTEM(sv_a)
PRINT(lv_u)
IF (lv_u != 0) THEN
#{
	CUST.DATA.errMsg = "Report generation Failed"
	sv_c = urhk_setorbout("SuccessOrFailure|N")
	sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.errMsg)
	EXITSCRIPT
ELSE
	#=====================================================================
	# Move the file to HPR menu
	#=====================================================================
	CUST.DATA.userId = BANCS.STDIN.userId
	CUST.DATA.title = "Bulk Loan Verified " + CUST.DATA.file_name + " Failure Rpt"
	PRINT(CUST.DATA.title)
	lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
	PRINT(lv_a)
	lv_x = SYSTEM(lv_a)
	PRINT(lv_x)
	if(lv_x == 0) then
		sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
		sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.file_name +". Check status in HPR"
		sv_z = urhk_SetOrbOut(sv_g)
		PRINT(sv_z)
	ELSE
		CUST.DATA.msg = "Error_2|Error.2^Loan Account Opening Report Generation Failed "
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		EXITSCRIPT
	ENDIF
ENDIF
                             

ENDOFSCRIPT:
EXITSCRIPT
#trace off
end-->


