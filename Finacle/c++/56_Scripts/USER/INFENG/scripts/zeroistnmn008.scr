CHECKSUM="a9fbbe7dad7913a52b9bb1342b5fe11aac660e9cf1a99f8fcf1b7f30831510ee"
	TRACE ON
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "MGRAM") == 0) THEN
