	CUST.MGRAM.crAct = ""
	CUST.MGRAM.narr1 = ""
	CUST.MGRAM.crDr1 = ""
	CUST.MGRAM.crDr2 = ""
	CUST.MGRAM.drAmt = ""
	CUST.MGRAM.refCode = ""
