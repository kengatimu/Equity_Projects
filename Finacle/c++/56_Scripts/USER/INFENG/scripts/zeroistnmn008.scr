	BANCS.INPUT.parameterId = "MGRAM_CRACT"
	CALL("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.MGRAM.crAct =  BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.MGRAM.errMsg = "CPARAM setup not done for Credit account number"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "MGRAM_TRNPRT"
	CALL("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.MGRAM.narr1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.MGRAM.narr1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.MGRAM.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.MGRAM.refCode)
		#}
	ELSE
		#{
		CUST.MGRAM.errMsg = "Ratecode set up not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(CUST.MGRAM.drAct)
	PRINT(CUST.MGRAM.crAct)
	PRINT(CUST.MGRAM.narr1)
	
	#------------------------------------------------------------------
	#  Getting account to credit/debit and amount
	#------------------------------------------------------------------
	
	sv_s = "clearBalance |SELECT clr_bal_amt "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.MGRAM.drAct
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0)THEN
	#{
		CUST.MGRAM.drAmt = BANCS.OUTPARAM.clearBalance
		PRINT(CUST.MGRAM.drAmt)
		#}
	ELSE
		#{
		CUST.MGRAM.drAmt = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(CUST.MGRAM.drAmt)
	
	
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("MTT")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT","TranDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT","TranDetails",5)
	#}
	ENDIF
	
	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("BANCS")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("BANCS","INPARAM")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("BANCS","INPARAM",5)
	#}
	ENDIF
	
	#===================================
	# STEP 1 : INITIALIZE THE MTT
	#===================================
	
	BANCS.INPARAM.PostTranFlg 		= "Y"
	BANCS.INPARAM.CommitFlg 		= "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg 	= "Y"
	BANCS.INPARAM.ValidationFlag 		= "Y"
	BANCS.INPARAM.RestrictModifyInd 	= "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw 		= "Y"
	BANCS.INPARAM.CheckExceptions 		= "N"
	
	
	sv_u = urhk_MTTS_PopulateInputDetails("")
	
	
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
	MTT.TranDetails.Remarks = CUST.MGRAM.narr1
	
	sv_v = "PurchaseComm"
	PRINT(sv_v)
	
	#sv_k = urhk_MTTS_Initialize("")
	#print(sv_k)
	
	#IF(sv_k != 0) THEN
	#{
	#	sv_u = urhk_SRV_SetErr("MTT initialized failed")
	#	GOTO Finsh
	#}
	#ENDIF
	
	sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
	
	
	
	
	#--------------------------------------------------
	# Credit to HO
	#--------------------------------------------------
	
	MTT.PartTranDetails.Account = CUST.MGRAM.crAct
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.MGRAM.narr1
	MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.MGRAM.drAmt)
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_e = "PurchaseIncome"
	sv_r = urhk_MTTS_definePartTran(sv_e)
	PRINT(sv_r)
	
	#------------------------------------------------------------------
	# Debit From BR
	#------------------------------------------------------------------
	
	MTT.PartTranDetails.Account = CUST.MGRAM.drAct
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.MGRAM.narr1
	sv_a = CDOUBLE(CUST.MGRAM.drAmt)
	sv_a = -(sv_a)
	PRINT(sv_a)
	MTT.PartTranDetails.RefAmount = sv_a
	PRINT(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = "D" + CUST.MGRAM.drAct
	
	
	sv_r = urhk_MTTS_definePartTran(sv_h)
	IF (sv_r == 1) THEN
	#{
		PRINT("Unable to create MTT Part transaction")
		GOTO Finish
	#}
	ENDIF
	
	#############################
	# Commit the transaction
	#############################
	sv_u = urhk_MTTS_EndDefinition("")
	PRINT(sv_u)
	
	CUST.MGRAM.TranId = BANCS.OUTPARAM.MTTTranId
	PRINT(CUST.MGRAM.TranId)
	
	
	##################################################
	# If any error tran id will not be created
	##################################################
	IF ((sv_u != 0)  OR (CUST.MGRAM.TranId==""))THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		PRINT (MTT.Error.Description)
		CUST.MGRAM.ResStatus = "F"
		CUST.MGRAM.Response = "Transaction creation Failed."
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO EndOfScript
	#}
	ENDIF
	#sv_r = urhk_MTTS_Close("")
	#print(sv_r)
	
	Finish:
		IF(CUST.MGRAM.Response != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.MGRAM.Response+"' >>ZNFXT8.log")
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
END-->
