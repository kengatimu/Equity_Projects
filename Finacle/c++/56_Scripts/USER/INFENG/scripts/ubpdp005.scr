	CONTINUE1:


	#CHARGE CALCULATION
	IF((CUST.UBP.chgEvetId!="") AND (CUST.UBP.funcCode =="T") AND (CUST.UBP.payAcctIdschmType != "OAB") AND (CUST.UBP.payAcctId != "1036200484307")) THEN
