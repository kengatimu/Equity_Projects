		 if ((CUST.UBP.billerId=="OMIG") OR (CUST.UBP.billerId=="3051") OR (CUST.UBP.billerId=="2560005") OR (CUST.UBP.billerId=="SCHPAY") OR (CUST.UBP.billerId=="3072") OR (CUST.UBP.billerId=="3040") OR (CUST.UBP.billerId=="INKOMOKOSS") OR (CUST.UBP.billerId=="MUKURU") OR (CUST.UBP.billerId=="JUBLEE3071") OR (CUST.UBP.billerId=="2872") OR (CUST.UBP.billerId=="1227") OR (CUST.UBP.billerId=="1225") OR (CUST.UBP.billerId=="1226") OR (CUST.UBP.billerId=="3070") OR (CUST.UBP.billerId=="3067") OR (CUST.UBP.billerId=="3068") OR (CUST.UBP.billerId=="1230") OR (CUST.UBP.billerId=="3044") OR (CUST.UBP.billerId=="MTNPCUSTNO") OR (CUST.UBP.billerId=="NSSFUND") OR (CUST.UBP.billerId=="3063") OR (CUST.UBP.billerId=="3064") OR (CUST.UBP.billerId=="3006") OR (CUST.UBP.billerId=="3007") OR (CUST.UBP.billerId=="TRINTY1") OR (CUST.UBP.billerId=="TRINTY") OR (CUST.UBP.billerId=="CELLGOTV") OR (CUST.UBP.billerId=="CELLUDSTV") OR (CUST.UBP.billerId=="CELLULANT") OR (CUST.UBP.billerId=="JKUATKAKA") OR (CUST.UBP.billerId=="1023") OR (CUST.UBP.billerId=="1093") OR (CUST.UBP.billerId=="3016") OR (CUST.UBP.billerId=="3017") OR (CUST.UBP.billerId=="3019") OR (CUST.UBP.billerId=="3023") OR (CUST.UBP.billerId=="3025") OR (CUST.UBP.billerId=="3027") OR (CUST.UBP.billerId=="3028") OR (CUST.UBP.billerId=="3033") OR (CUST.UBP.billerId=="3032") OR (CUST.UBP.billerId=="3034") OR (CUST.UBP.billerId=="RSSBPENSIO") OR (CUST.UBP.billerId=="RSSBMEDICA") OR (CUST.UBP.billerId=="RSSBCHBI") OR (CUST.UBP.billerId=="RSSBMTRNT") OR (CUST.UBP.billerId=="EJOHEZANID") OR (CUST.UBP.billerId=="EJOHEZA") OR (CUST.UBP.billerId=="RURA")) then
