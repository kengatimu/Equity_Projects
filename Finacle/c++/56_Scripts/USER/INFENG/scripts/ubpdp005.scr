		CUST.UBP.chgEvetId=""
		CUST.UBP.chgAmt=""
		CUST.UBP.ChargepayRefCrncy=""
		CUST.UBP.ChargeTranId=""
		CUST.UBP.ChargeTranDate=""
	#}
	ENDIF

