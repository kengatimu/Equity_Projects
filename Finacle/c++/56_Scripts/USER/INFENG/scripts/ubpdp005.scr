		#}
		ENDIF

		# Update the charge tran id and tran date to the ubp table
		sv_q = "UPDATE CUSTOM.C_UBP SET CHARGE_TRAN_ID = ?SVAR , CHARGE_TRAN_DATE = to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'), "
		sv_q = sv_q + " CHARGE_CRNCY = ?SVAR "
		sv_q = sv_q + "WHERE BILL_PAY_REF_NUM=  ?SVAR "
		sv_q = sv_q + "AND BILLER_BNK_ID=  ?SVAR "

		BANCS.INPARAM.BINDVARS = CUST.UBP.ChargeTranId + "|" + CUST.UBP.ChargeTranDate + "|" +  CUST.UBP.ChargepayRefCrncy
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.UBP.billPayRefNum + "|" + CUST.UBP.billerBnkId

		sv_e = urhk_dbSqlWithBind(sv_q)
		print(sv_e)

		#}
	ELSE
