					print(STDWFS.GLBDATA.srlnum)
					sv_u = "INSERT INTO CUSTOM.C_NWSCCHQ VALUES ("
					sv_u = sv_u + "'"+STDWFS.GLBDATA.status + "',"
					sv_u = sv_u + "'"+STDWFS.GLBDATA.srlnum + "',"
					sv_u = sv_u + "'"+STDWFS.GLBDATA.waterrefnum  + "',"
					sv_u = sv_u + "'"+STDWFS.GLBDATA.customername + "',"
					sv_u = sv_u + "'"+STDWFS.GLBDATA.Location + "',"
					sv_u = sv_u + "'"+STDWFS.GLBDATA.phonenumber3 + "',"
					sv_u = sv_u + "'"+STDWFS.GLBDATA.systemDatem + "',"
					sv_u = sv_u + "'"+OCTR.GLBVAR.instrmntAmt + "',"
					sv_u = sv_u + "'"+sv_k + "',"
					sv_u = sv_u + "'"+OCTR.GLBVAR.instrmntId + "',"
					sv_u = sv_u + "'"+STDWFS.GLBDATA.narrative + "',"
					sv_u = sv_u + "'"+BANCS.STDIN.userId + "',"
					sv_u = sv_u + "'"+BANCS.STDIN.contextBankId +"')"
					sv_w = urhk_dbsqlWithBind(sv_u)
					sv_w = urhk_dbsqlWithBind("COMMIT")
					print(sv_u)
					IF (sv_w == 0 ) THEN
					#{
						OCTR.GLBVAR.errMsg = "A Database error has occured. Please contact your DBA."
						GOTO FINISH
					#}
					ENDIF
					print(STDWFS.GLBDATA.Location)
					sv_e = STDWFS.GLBDATA.Location
					print(sv_e)
					sv_s = "Locationup|SELECT UPPER(?SVAR) FROM DUAL"
					BANCS.INPARAM.BINDVARS = sv_e
					sv_d = urhk_dbSelect(sv_s)
					print(sv_d)
					IF (sv_d =="0") THEN
					#{
						STDWFS.GLBDATA.Locationup = BANCS.OUTPARAM.Locationup
						print(STDWFS.GLBDATA.Locationup)
					#}
					ENDIF
					sv_s = "count|SELECT COUNT(1) FROM  CUSTOM.C_CICUG"
					sv_s = sv_s + " WHERE location=?SVAR"
					sv_s = sv_s + " AND refnum=?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.Locationup +"|"+ STDWFS.GLBDATA.waterrefnum
					sv_d=urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF (sv_d == 0)THEN
					#{
						STDWFS.GLBDATA.count = BANCS.OUTPARAM.count
						print(STDWFS.GLBDATA.count)
						IF  (STDWFS.GLBDATA.count == 0 ) THEN
						#{
							STDWFS.GLBDATA.delflg="N"
							print(STDWFS.GLBDATA.delflg)
							print(OCTR.GLBVAR.acctnum1)
							print(STDWFS.GLBDATA.waterrefnum)
							print(STDWFS.GLBDATA.customername)
							print(STDWFS.GLBDATA.delflg)
							sv_u = "INSERT INTO CUSTOM.C_CICUG VALUES ("
							sv_u = sv_u + "'"+OCTR.GLBVAR.acctnum1 + "',"
							sv_u = sv_u + "'"+STDWFS.GLBDATA.waterrefnum + "',"
							sv_u = sv_u + "'"+STDWFS.GLBDATA.customername + "',"
							sv_u = sv_u + "'"+STDWFS.GLBDATA.delflg + "',"
							sv_u = sv_u + "'"+STDWFS.GLBDATA.Locationup + "',"
							sv_u = sv_u + "'"+BANCS.STDIN.contextBankId +"')"
							sv_w = urhk_dbSQLWithBind(sv_u)
							sv_w = urhk_dbSQLWithBind("COMMIT")
							print(sv_u)
							IF (sv_w != 0 ) THEN
							#{
								OCTR.GLBVAR.errMsg = "A Database error has occured. Please contact your DBA."
								GOTO FINISH
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				OCTR.GLBVAR.errMsg = " Error: "+ STDWFS.GLBDATA.response
				GOTO FINISH
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	FINISH:
		IF (OCTR.GLBVAR.errMsg != "") THEN
		#{
			sv_a = urhk_SRV_SetErr(OCTR.GLBVAR.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
