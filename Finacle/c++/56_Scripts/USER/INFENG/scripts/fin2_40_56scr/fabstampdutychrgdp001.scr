#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="a3f0d5f9b8e377bece2b1ac23227c4a90d3da0ceaffa7c12910b771dea05bd3c"
	TRACE ON
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	
	#--------------------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	# 	Getting all the values from CPARAM
	#--------------------------------------------------------------------------------------------
	IF (REPEXISTS("STMP") == 0) THEN
	#{
		CREATEREP("STMP")
	#}
	ENDIF
	
	IF (CLASSEXISTS("STMP","CHRG") == 0) THEN
	#{
		CREATECLASS("STMP","CHRG",5)
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------------------------
	#Initializing required variables
	#--------------------------------------------------------------------------------------------
	STMP.CHRG.errMsg = ""
	STMP.CHRG.var1   = ""
	STMP.CHRG.var2   = ""
	
	BANCS.INPUT.moduleName = "FABSTMPDUTYCHRG"
	BANCS.INPUT.parameterId = "TRANPART1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		STMP.CHRG.tranPart1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		STMP.CHRG.errMsg = "Tran Particular 1 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TRANPART2"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		STMP.CHRG.tranPart2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		STMP.CHRG.errMsg = "Tran Particular 2 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CUSBACID1"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		STMP.CHRG.cusBacid1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		STMP.CHRG.errMsg = "Bacid 1 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CUSBACID2"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		STMP.CHRG.cusBacid2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		STMP.CHRG.errMsg = "Bacid 2 setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	BANCS.INPUT.parameterId = "TRANAMT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		STMP.CHRG.tranAmt = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		STMP.CHRG.errMsg = "Tran Amt setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	BANCS.INPUT.moduleName  = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	
	CALL ("getcparamvalue.scr")
	print(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		STMP.CHRG.refCode = BANCS.OUTPUT.parameterVal
		PRINT(STMP.CHRG.refCode)
		#}
	ELSE
		#{
		STMP.CHRG.errMsg = "Ratecode set up not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------------------------
	#  Hardcoding the bacid for Cashwithdrawal Cahrge Income Account & validation for the bacid.
	#--------------------------------------------------------------------------------------------
	STMP.CHRG.vBacid1 = STMP.CHRG.cusBacid1
	STMP.CHRG.var1 = STMP.CHRG.vBacid1 + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
	sv_u = urhk_B2k_BacidToAcctId(STMP.CHRG.var1)
	IF (sv_u == 1) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	STMP.CHRG.With_Account = BANCS.OUTPARAM.AcctId
	PRINT(STMP.CHRG.With_Account)
	
	#--------------------------------------------------------------------------------------------
	# Selecting total number of accounts which are not charged
	#--------------------------------------------------------------------------------------------
	STMP.CHRG.startDate = LEFT$(BANCS.STDIN.BODDate,10)
	STMP.CHRG.midDtae   = MID$(STMP.CHRG.startDate,6,4)
	PRINT(STMP.CHRG.midDtae)
	
	PRINT(BANCS.STDIN.mySolId)
	
	sv_s = "dtd_Count|"
	sv_s = sv_s + "SELECT COUNT(1) "
	sv_s = sv_s + "FROM TBAADM.DTD "
	sv_s = sv_s + "WHERE DTD.acid = ("
	sv_s = sv_s + "SELECT acid FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE foracid = ?SVAR"
	sv_s = sv_s + "AND entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND del_flg = 'N' "
	sv_s = sv_s + "AND bank_id = ?SVAR"
	sv_s = sv_s + ") "
	sv_s = sv_s + "AND DTD.del_flg! = 'Y' "
	sv_s = sv_s + "AND DTD.tran_id LIKE '%F%' "
	sv_s = sv_s + "AND DTD.tran_type = 'C' "
	sv_s = sv_s + "AND DTD.tran_sub_type IN ('CR','CP') "
	sv_s = sv_s + "AND DTD.part_tran_type = 'C' "
	sv_s = sv_s + "AND DTD.tran_amt = ?SVAR "
	sv_s = sv_s + "AND DTD.sol_id = ?SVAR "
	sv_s = sv_s + "AND bank_id = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = STMP.CHRG.With_Account + "|" + BANCS.STDIN.contextBankId + "|" + STMP.CHRG.tranAmt + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	STMP.CHRG.dtdCount = BANCS.OUTPARAM.dtd_Count
	PRINT(STMP.CHRG.dtdCount)
	
	IF (STMP.CHRG.dtdCount == "0") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	STMP.CHRG.count = STMP.CHRG.dtdCount
	PRINT(STMP.CHRG.count)
	
	
	#--------------------------------------------------------------------------------------------
	#  Hardcoding the bacid for Stamp Duty Cahrge Income Account & validation for the bacid
	#--------------------------------------------------------------------------------------------
	STMP.CHRG.vBacid2 = STMP.CHRG.cusBacid2
	STMP.CHRG.var2 = STMP.CHRG.vBacid2 + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
	sv_u = urhk_B2k_BacidToAcctId(STMP.CHRG.var2)
	IF (sv_u == 1) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	STMP.CHRG.Stmp_Account = BANCS.OUTPARAM.AcctId
	PRINT(STMP.CHRG.Stmp_Account)
	
	
	STMP.CHRG.amt = CDOUBLE(STMP.CHRG.count) * CDOUBLE("2")
	PRINT(STMP.CHRG.amt)
	
	
	#--------------------------------------------------------------------------------------------
	# Passing transaction inputs to the service
	# Adding and Posting the transaction
	#--------------------------------------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	#--------------------------------------------------------------------------------------------
	# Income To cashwith stamp chrg Account
	#--------------------------------------------------------------------------------------------
	sv_w = "tranDtl.partTranDetailLL.<rec_0>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|1")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|C")
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|" + STMP.CHRG.Stmp_Account)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|" + STMP.CHRG.tranPart1)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
	sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|" + STMP.CHRG.amt + "|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|" + STMP.CHRG.amt + "|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + STMP.CHRG.refCode)
	PRINT(sv_u)
	
	
	#--------------------------------------------------------------------------------------------
	# Debiting cash with charge Account
	#--------------------------------------------------------------------------------------------
	sv_w = "tranDtl.partTranDetailLL.<rec_1>."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|2")
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|D")
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|" + STMP.CHRG.With_Account)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|" + STMP.CHRG.tranPart2)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
	sv_u = urhk_SetUrhkInp(sv_w + "refNum| ")
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|" + STMP.CHRG.amt + "|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|" + STMP.CHRG.amt + "|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + STMP.CHRG.refCode)
	
	
	sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
	PRINT(sv_u)
	IF(sv_u != 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
		PRINT(sv_u)
	#}
	ENDIF
	
	IF(sv_u == 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
		PRINT(sv_u)
		IF(sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			PRINT(sv_u)
			IF(sv_u != 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
	#{
		PRINT(BANCS.OUTPARAM.tranId)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(STMP.CHRG.errMsg != "") THEN
		#{
			sv_u = system("echo '"+STMP.CHRG.errMsg+"' >>RGZN1.log")
		#}
		ENDIF
		
		EXITSCRIPT
		
		TRACE OFF
		
END-->
