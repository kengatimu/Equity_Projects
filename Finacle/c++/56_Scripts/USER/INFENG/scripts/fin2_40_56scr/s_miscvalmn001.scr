				#{
					CUST.ACCTOPEN.retMsg = "Enter the loan Account Number Being Rescheduled in Free Text 10"
					CUST.ACCTOPEN.sucFail = "N"
					CUST.ACCTOPEN.fieldId = "misFreeText10"
					GOTO ENDOFSCRIPT
				ELSE
					sv_w = urhk_getAcctDetailsInRepository(CUST.ACCTOPEN.misFreeText10)

					IF(sv_w!=0)THEN
					#{
					CUST.ACCTOPEN.retMsg = "Enter a correct account number"
					CUST.ACCTOPEN.sucFail = "N"
					CUST.ACCTOPEN.misFreeText10 = ""
					CUST.ACCTOPEN.fieldId = "misFreeText10"
					GOTO ENDOFSCRIPT

					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF

			IF (sv_d == "N") THEN
			#{	
				IF(CUST.ACCTOPEN.misFreeText10 == "") THEN
				#{
					CUST.ACCTOPEN.retMsg = "Enter the Operative Account Number for Customer in Free Text 10"
					CUST.ACCTOPEN.sucFail = "N"
					CUST.ACCTOPEN.fieldId = "misFreeText10"
					GOTO ENDOFSCRIPT
				ELSE
					sv_w = urhk_getAcctDetailsInRepository(CUST.ACCTOPEN.misFreeText10)

					IF(sv_w!=0)THEN
					#{
					CUST.ACCTOPEN.retMsg = "Enter a correct account number"
					CUST.ACCTOPEN.sucFail = "N"
					CUST.ACCTOPEN.misFreeText10 = ""
					CUST.ACCTOPEN.fieldId = "misFreeText10"
					GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
					CUST.ACCTOPEN.cifId = BANCS.OUTPARAM.cifId
					sv_s = "CountNPA|select count(1) from tbaadm.acd where bank_id = ?SVAR "
						sv_s = sv_s + "and B2K_ID in (select acid from tbaadm.gam "
						sv_s = sv_s + "where cif_id = ?SVAR and acct_cls_flg !='Y') "
						sv_s = sv_s + "and MAIN_CLASSIFICATION_SYSTEM = 'NPA' "
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|"  + CUST.ACCTOPEN.cifId
						PRINT(BANCS.INPARAM.BINDVARS)

						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
								
						IF (sv_d == 0) THEN
						#{
							CUST.ACCTOPEN.CountNPA = BANCS.OUTPARAM.CountNPA
							print(CUST.ACCTOPEN.CountNPA)

							IF(CUST.ACCTOPEN.CountNPA > 0)THEN
							#{
							CUST.ACCTOPEN.retMsg = "There is an account in NPA for Reschedulement. Please Put FreeText9 as Y"
							CUST.ACCTOPEN.sucFail = "N"
							CUST.ACCTOPEN.misFreeText9 = ""
							CUST.ACCTOPEN.fieldId = "misFreeText9"
							GOTO ENDOFSCRIPT

							#}
							ENDIF
						#}
						ENDIF

					#}
					ENDIF
				#}
				ENDIF
				
		#}			
		ENDIF
		
		####################################################################################################################
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		IF(CUST.ACCTOPEN.sucFail != "Y") THEN
		#{
			PRINT(CUST.ACCTOPEN.retMsg)
			PRINT(CUST.ACCTOPEN.sucFail)
			PRINT(CUST.ACCTOPEN.fieldId)
			
			sv_u = urhk_SetOrbOut("retMsg|" + CUST.ACCTOPEN.retMsg)
			sv_u = urhk_SetOrbOut("sucFail|" + CUST.ACCTOPEN.sucFail)
			sv_u = urhk_SetOrbOut("fieldId|" + CUST.ACCTOPEN.fieldId)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("retMsg| ")
			sv_u = urhk_SetOrbOut("sucFail|" + CUST.ACCTOPEN.sucFail)
			sv_u = urhk_SetOrbOut("fieldId| ")
		#}
		ENDIF
		TRACE OFF
		EXITSCRIPT
