		#{
			CUST.ACCTOPEN.retMsg = "Enter (Y-YES / N-NO) in Free Text 9 - Indicate Y-YES if Rescheduling Loan and N-NO if NOT Rescheduling"
			CUST.ACCTOPEN.sucFail = "N"
			CUST.ACCTOPEN.fieldId = "misFreeText9"
