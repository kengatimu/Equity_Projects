	PRINT(CUST.IPHTD.crActNo)
	BANCS.INPUT.parameterId = "IPHTD_DRACT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.drActNo = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.IPHTD.errMsg = "Debit Account setup not done in CPARAM"
