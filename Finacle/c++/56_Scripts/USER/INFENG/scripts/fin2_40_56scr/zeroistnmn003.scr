	ELSE
		#{
		CUST.IPHTD.tranParts3 = ""
	#}
	ENDIF
	
	
	BANCS.INPUT.parameterId = "IPHTD_REFNMCR"
	CALL("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.refNumCr1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPHTD.refNumCr1)
		#}
	ELSE
		#{
		CUST.IPHTD.refNumCr1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPHTD_REFNMCR1"
	CALL("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.refNumCr2= BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPHTD.refNumCr2)
		#}
	ELSE
		#{
		CUST.IPHTD.refNumCr2 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPHTD_REFNMDR"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.refNumDr1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPHTD.refNumDr1)
		#}
	ELSE
		#{
		CUST.IPHTD.refNumDr1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPHTD_BACID"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.bacid1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPHTD.bacid1)
		#}
	ELSE
		#{
		CUST.IPHTD.bacid1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPHTD_RTCDE"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.rateCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPHTD.rateCode)
		#}
	ELSE
		#{
		CUST.IPHTD.rateCode = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPHTD_RATE"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.rate = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPHTD.rate)
		#}
	ELSE
		#{
		CUST.IPHTD.rate = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPHTD_TRNRMK"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPHTD.tranRmrk = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPHTD.tranRmrk)
		#}
	ELSE
		#{
		CUST.IPHTD.tranRmrk = ""
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#   Clear balance of debit account no
	#---------------------------------------------------------------------------
	
	sv_s= BANCS.STDIN.mySolId
	PRINT(sv_s)
	CUST.IPHTD.drActNo = sv_s +CUST.IPHTD.drActNo
	sv_u=CUST.IPHTD.drActNo
	PRINT(sv_u)
	
	sv_s = "clearBalance,acctCrncyCode |SELECT clr_bal_amt,acct_crncy_code "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.IPHTD.drActNo
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.IPHTD.drClrBal=BANCS.OUTPARAM.clearBalance
		CUST.IPHTD.drActCrncy = BANCS.OUTPARAM.acctCrncyCode
		PRINT(CUST.IPHTD.drClrBal)
		IF (CDOUBLE(CUST.IPHTD.drClrBal)==0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.IPHTD.drClrBal = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------
	# Charges collected (appFee)
	#--------------------------------------------------------------
	sv_s = "appFee|SELECT count(1)*30 FROM tbaadm.GAM, tbaadm.HTD "
	sv_s = sv_s + " WHERE GAM.acid = HTD.acid"
	sv_s = sv_s + " AND GAM.bank_id = HTD.bank_id"
	sv_s = sv_s + " AND GAM.foracid = ?SVAR"
	sv_s = sv_s + " AND HTD.part_tran_type = 'C'"
	sv_s = sv_s + "AND HTD.ENTRY_USER_ID!='CDCI'"
	sv_s = sv_s + "AND HTD.TRAN_DATE =?SVAR"
	sv_s = sv_s + " AND HTD.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.IPHTD.drActNo + "|" + CUST.IPHTD.tranDate + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		CUST.IPHTD.appFee=BANCS.OUTPARAM.appFee
		PRINT(CUST.IPHTD.appFee)
		#}
	ELSE
		#{
		CUST.IPHTD.appFee = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------
	# Charges collected (revfee)
	#--------------------------------------------------------------
	sv_s = "revfee|SELECT count(1)*30 FROM tbaadm.GAM, tbaadm.HTD "
	sv_s = sv_s + " WHERE GAM.acid = HTD.acid"
	sv_s = sv_s + " AND GAM.bank_id = HTD.bank_id"
	sv_s = sv_s + " AND GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND HTD.part_tran_type = 'D'"
	sv_s = sv_s + " AND HTD.ENTRY_USER_ID!='CDCI'"
	sv_s = sv_s + " AND (HTD.ref_num is null OR htd.REF_NUM! = ?SVAR)"
	sv_s = sv_s + " AND HTD.TRAN_DATE =?SVAR"
	sv_s = sv_s + " AND HTD.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.IPHTD.drActNo + "|" + CUST.IPHTD.refNumDr1 + "|" + CUST.IPHTD.tranDate + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.IPHTD.revfee=BANCS.OUTPARAM.revfee
		PRINT(CUST.IPHTD.revfee)
		PRINT(CUST.IPHTD.appFee)
		CUST.IPHTD.appFee = CDOUBLE(CUST.IPHTD.appFee) - CDOUBLE(CUST.IPHTD.revfee)
		PRINT(CUST.IPHTD.appFee)
		#}
	ELSE
		#{
		CUST.IPHTD.appFee = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------
	#totalAmount
	#---------------------------------------------------------------
	sv_s = "clearBalance|select sum(tran_amt) FROM tbaadm.GAM, tbaadm.HTD "
	sv_s = sv_s + " WHERE GAM.acid = HTD.acid"
	sv_s = sv_s + " AND GAM.bank_id = HTD.bank_id"
	sv_s = sv_s + " AND GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND HTD.part_tran_type = 'C'"
	sv_s = sv_s + " AND HTD.TRAN_DATE =?SVAR"
	sv_s = sv_s + " AND HTD.del_flg = 'N'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.IPHTD.drActNo + "|" + CUST.IPHTD.tranDate + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.IPHTD.totalamt=BANCS.OUTPARAM.clearBalance
		PRINT(CUST.IPHTD.totalamt)
		#}
	ELSE
		#{
		CUST.IPHTD.totalamt="0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#----------------------------------------------------------------
	#revamt
	#----------------------------------------------------------------
	sv_s = "revamt|select sum(tran_amt) FROM tbaadm.GAM, tbaadm.HTD "
	sv_s = sv_s + " WHERE GAM.acid = HTD.acid"
	sv_s = sv_s + " AND GAM.bank_id = HTD.bank_id"
	sv_s = sv_s + " AND GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND HTD.part_tran_type = 'D'"
	sv_s = sv_s + " AND (HTD.ref_num is null OR HTD.REF_NUM!= ?SVAR)"
	sv_s = sv_s + " AND HTD.TRAN_DATE = ?SVAR"
	sv_s = sv_s + " AND HTD.del_flg != 'Y'"
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.IPHTD.drActNo + "|" + CUST.IPHTD.refNumDr1 + "|" + CUST.IPHTD.tranDate + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.IPHTD.revamt=BANCS.OUTPARAM.revamt
		PRINT(CUST.IPHTD.revamt)
		
		#}
	ELSE
		#{
		CUST.IPHTD.totalamt= "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.IPHTD.totalamt=CDOUBLE(CUST.IPHTD.totalamt)-cdouble(CUST.IPHTD.revamt)
	PRINT(CUST.IPHTD.totalamt)
	
	IF ((CUST.IPHTD.appFee==0) AND (CUST.IPHTD.totalamt==0))THEN
	#{
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.IPHTD.ipoamt=CDOUBLE(CUST.IPHTD.totalamt)-cdouble(CUST.IPHTD.appFee)
		PRINT(CUST.IPHTD.ipoamt)
	#}
	ENDIF
	PRINT(CUST.IPHTD.appFee)
	PRINT(CUST.IPHTD.totalamt)
	PRINT(CUST.IPHTD.ipoamt)
	
	IF((CDOUBLE(CUST.IPHTD.appFee)==0) AND (CDOUBLE(CUST.IPHTD.ipoamt)==0)) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#------------------------------------------------------------------
	# The account not having balance then control goes to end ofscript
	#------------------------------------------------------------------
	IF (CDOUBLE(CUST.IPHTD.appFee) != 0) THEN
	#{
		sv_i = CUST.IPHTD.bacid1+"|" + BANCS.STDIN.homeCrncyCode+"|" + BANCS.STDIN.mySolId
		PRINT(sv_i)
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		PRINT(sv_u)
		IF (sv_u == 1 ) THEN
		#{
			sv_s = "IPO CDS Application Fee Collection A/C not set up "
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.IPHTD.CrAplictAct = BANCS.OUTPARAM.AcctId
		PRINT(CUST.IPHTD.CrAplictAct)
	#}
	ENDIF
	
	#---------------------------------------------------------------
	# Get the transaction level header details from BANCS repository
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.IPHTD.tranRmrk)
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.IPHTD.CrAplictAct)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.IPHTD.CrAplicCrncy = BANCS.OUTPARAM.acctCrncyCode
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.IPHTD.crActNo)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.IPHTD.crAcctCrncy = BANCS.OUTPARAM.acctCrncyCode
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------
	# Add partTran 0 and 1
	#-----------------------------------------------------
	sv_k = 0
	PRINT(CUST.IPHTD.appFee)
	IF (CDOUBLE(CUST.IPHTD.appFee) < 0) THEN
	#{
		CUST.IPHTD.appFee = ( CDOUBLE(CUST.IPHTD.appFee) * -1 )
		CUST.IPHTD.crdr0 = "D"
		CUST.IPHTD.crdr1 = "C"
		PRINT(CUST.IPHTD.appFee)
		#}
	ELSE
		#{
		CUST.IPHTD.crdr0 = "C"
		CUST.IPHTD.crdr1 = "D"
	#}
	ENDIF
	
	PRINT(CUST.IPHTD.ipoamt)
	IF (CDOUBLE(CUST.IPHTD.ipoamt) < 0) THEN
	#{
		CUST.IPHTD.ipoamt = ( CDOUBLE(CUST.IPHTD.ipoamt) * -1 )
		CUST.IPHTD.crdr0 = "D"
		CUST.IPHTD.crdr1 = "C"
		PRINT(CUST.IPHTD.ipoamt)
		#}
	ELSE
		#{
		CUST.IPHTD.crdr0 = "C"
		CUST.IPHTD.crdr1 = "D"
	#}
	ENDIF
	
	PRINT(CUST.IPHTD.totalamt)
	IF (CDOUBLE(CUST.IPHTD.totalamt) < 0) THEN
	#{
		CUST.IPHTD.totalamt = ( CDOUBLE(CUST.IPHTD.totalamt) * -1 )
		CUST.IPHTD.crdr0 = "D"
		CUST.IPHTD.crdr1 = "C"
		PRINT(CUST.IPHTD.totalamt)
		#}
	ELSE
		#{
		CUST.IPHTD.crdr0 = "C"
		CUST.IPHTD.crdr1 = "D"
	#}
	ENDIF
	
	IF(CDOUBLE(CUST.IPHTD.appFee)!=0) THEN
	#{
		sv_a = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_k,"%d")  +">."
		
		sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+FORMAT$(sv_k,"%d"))
		sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|"+CUST.IPHTD.crdr0)
		sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.IPHTD.CrAplictAct)
		sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.IPHTD.appFee+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refNum|"+CUST.IPHTD.refNumCr2)
		sv_u = urhk_SetUrhkInp(sv_a + "tranRmks| ")
		sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.IPHTD.appFee+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
		sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
		sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|" + CUST.IPHTD.tranParts1)
		sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.IPHTD.rateCode)
		sv_k = sv_k + 1
	#}
	ENDIF
	
	IF(CDOUBLE(CUST.IPHTD.ipoamt)!=0) THEN
	#{
		sv_a = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_k,"%d")  +">."
		
		sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+FORMAT$(sv_k,"%d"))
		sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|"+CUST.IPHTD.crdr0)
		sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.IPHTD.crActNo)
		sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.IPHTD.ipoamt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refNum|"+CUST.IPHTD.refNumCr1)
		sv_u = urhk_SetUrhkInp(sv_a + "tranRmks| ")
		sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.IPHTD.ipoamt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
		sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
		sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|" + CUST.IPHTD.tranParts2)
		sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.IPHTD.rateCode)
		sv_k = sv_k + 1
	#}
	ENDIF
	
	#---------------------------------------------------------
	# Add partTran 2
	#---------------------------------------------------------
	IF (CDOUBLE(CUST.IPHTD.totalamt) != 0) THEN
	#{
		sv_b = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_k,"%d")  +">."
		
		sv_u = urhk_SetUrhkInp(sv_b + "key.serial_num|"+FORMAT$(sv_k,"%d"))
		sv_u = urhk_SetUrhkInp(sv_b + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_b + "partTranType.code|"+CUST.IPHTD.crdr1)
		sv_u = urhk_SetUrhkInp(sv_b + "acctId.foracid|"+CUST.IPHTD.drActNo)
		sv_u = urhk_SetUrhkInp(sv_b + "valueDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_b + "glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_b + "tranAmt|"+CUST.IPHTD.totalamt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_b + "refNum|"+CUST.IPHTD.refNumDr1)
		sv_u = urhk_SetUrhkInp(sv_b + "tranRmks| ")
		sv_u = urhk_SetUrhkInp(sv_b + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_b + "refAmt|"+CUST.IPHTD.totalamt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_b + "tranParticulars|" + CUST.IPHTD.tranParts3)
		sv_u = urhk_SetUrhkInp(sv_b + "rateCode.refCode|" + CUST.IPHTD.rateCode)
	#}
	ENDIF
	sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
	PRINT(sv_u)
	
	IF(sv_u == 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
		PRINT(sv_u)
		IF(sv_u ==0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			PRINT(sv_u)
			IF(sv_u != 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	IF (sv_u != 0) THEN
	#{
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			sv_v = BANCS.OUTPARAM.Error_num
			PRINT(BANCS.OUTPARAM.Error_num)
			IF (sv_v > 0) THEN
			#{
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					PRINT(sv_e)
					sv_i = sv_i + 1
				#}
				DO
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
	#{
		PRINT(BANCS.OUTPARAM.tranId)
	#}
	ENDIF
	ENDOFSCRIPT:
		IF(CUST.IPHTD.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.IPHTD.errMsg+"' >>ZRTN3.log")
		#}
		ENDIF
		
		EXITSCRIPT
		
		TRACE OFF
END-->
