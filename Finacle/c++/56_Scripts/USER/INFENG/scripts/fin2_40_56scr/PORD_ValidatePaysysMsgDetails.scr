	ELSE
		#{
		PAYSYS.PORD.custNreFlg  = "N"
	#}
	ENDIF
	###############################################################################
	#	This script does the validations in the HPAYSYS menu					  #
	###############################################################################
	PAYSYS.PORD.successOrFailure	=	"S"
	PAYSYS.PORD.ErrorDesc			=	""
	PAYSYS.PORD.MsgId       =   ""
	BANCS.OUTPUT.failedFieldTag = ""
	
	#Adding a check for OAT, If Order Type = OT then only RTGS is to be allowed
	IF((PAYSYS.PORD.OrderType == "OT")) THEN
	#{
		IF(PAYSYS.PORD.ReroutePaysysID == "RTGS") THEN
		#{
			PAYSYS.PORD.MsgId = "R10"
			GOTO ENDOFMSGSPVAL
			#}
		ELSE
			#{
			PAYSYS.PORD.successOrFailure = "F"
			GOTO ENDOFMSGSPVAL
		#}
		ENDIF
	#}
	ENDIF
	
	
	#Message speciic validations are done here based on the routed paysys id
	IF(PAYSYS.PORD.ReroutePaysysID == "SWIFT") THEN
	#{
		IF((PAYSYS.PORD.OrderType == "CT"))  THEN
		#{
			PAYSYS.PORD.MsgId		=	"103"
			#}
		ELSE
			#{
			IF((PAYSYS.PORD.OrderType == "BT")) THEN
			#{
				PAYSYS.PORD.MsgId       =   "202"
				#}
			ELSE
				#{
				PAYSYS.PORD.successOrFailure = "F"
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(PAYSYS.PORD.ReroutePaysysID == "RTGS")  THEN
	#{
		IF((PAYSYS.PORD.OrderType != "CT") AND (PAYSYS.PORD.OrderType != "BT") AND (PAYSYS.PORD.OrderType != "OT")) THEN
		#{
			PAYSYS.PORD.successOrFailure = "F"
			#}
		ELSE
			#{
			IF((PAYSYS.PORD.OrderType == "CT"))  THEN
			#{
				PAYSYS.PORD.MsgId       =   "103"
			#}
			ENDIF
			IF((PAYSYS.PORD.OrderType == "BT")) THEN
			#{
				PAYSYS.PORD.MsgId       =   "202"
			#}
			ENDIF
			IF((PAYSYS.PORD.OrderType == "OT")) THEN
			#{
				PAYSYS.PORD.MsgId       =   "103"
			#}
			ENDIF
		#}
		ENDIF
		
		#if((PAYSYS.PORD.OrderType == "CT") AND (PAYSYS.PORD.custNreFlg == "Y")) then
		#{
		# if((PAYSYS.PORD.OrdInstnBIC == "") AND (PAYSYS.PORD.OrdInstnAcct == "") AND (PAYSYS.PORD.OrdInstnName == "") AND (PAYSYS.PORD.OrdInstnAddr1 == "")) then
		#{
		#  PAYSYS.PORD.ErrorDesc = "The Debit account is NRE account.Either enter Ordering Institution Acct/Name/address or Ordering Institution Bic"
		#  PAYSYS.PORD.successOrFailure="F"
		#  GOTO endOfScript
		#}
		# endif
		#}
		#endif
	#}
	ENDIF
	PRINT(PAYSYS.PORD.MsgId)
	
	IF(PAYSYS.PORD.ReroutePaysysID == "NEFT") THEN
	#{
		IF((PAYSYS.PORD.OrderType != "CT")) THEN
		#{
			PAYSYS.PORD.successOrFailure = "F"
			#}
		ELSE
			#{
			PAYSYS.PORD.MsgId       =   "N06"
		#}
		ENDIF
	#}
	ENDIF
	IF(PAYSYS.PORD.ReroutePaysysID == "SFMS") THEN
	#{
		IF((PAYSYS.PORD.OrderType != "CT")) THEN
		#{
			PAYSYS.PORD.successOrFailure = "F"
			#}
		ELSE
			#{
			PAYSYS.PORD.MsgId       =   "100"
		#}
		ENDIF
	#}
	ENDIF
	IF(PAYSYS.PORD.ReroutePaysysID == "ACH") THEN
	#{
		IF((PAYSYS.PORD.OrderType != "CT")) THEN
		#{
			
			PAYSYS.PORD.successOrFailure = "F"
			
		#}
		ENDIF
	#}
	ENDIF
	IF(PAYSYS.PORD.ReroutePaysysID == "ECS") THEN
	#{
		IF((PAYSYS.PORD.OrderType != "CT")) THEN
		#{
			
			PAYSYS.PORD.successOrFailure = "F"
			
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFMSGSPVAL:
		
		IF(PAYSYS.PORD.successOrFailure=="F") THEN
		#{
			PAYSYS.PORD.ErrorDesc = "The Message type is not supported for paysysId ["+PAYSYS.PORD.ReroutePaysysID +"]"
			GOTO endOfScript
			
		#}
		ENDIF
		
		######################################################################################################
		# Validation for the Tag50F
		######################################################################################################
		
		IF((PAYSYS.PORD.orderingDocType != "") AND (PAYSYS.PORD.orderingDocNum != "")) THEN
		#{
			CALL("ValidateTag50F.scr")
		#}
		ENDIF
		
		#################################################################
		#Check for Paysys base currency and remit currency being the same
		#################################################################
		sv_s = "paysysBaseCrncy,internalFlg,dfltOutRateCode|SELECT base_crncy_code,internal_flg,dflt_out_rate_code FROM tbaadm.PPRM "
		sv_s = sv_s + "where paysys_id = ?SVAR "
		sv_s = sv_s + " AND PPRM.bank_id = ?SVAR "
		
		BANCS.INPARAM.BINDVARS = PAYSYS.PORD.ReroutePaysysID + "|" + BANCS.STDIN.contextBankId
		sv_r = urhk_dbselectWithBind(sv_s)
		IF(sv_r == 0) THEN
		#{
			#Store the default rate code, will be used later if required
			PAYSYS.PORD.DfltRateCode = BANCS.OUTPARAM.dfltOutRateCode
			
			IF((BANCS.OUTPARAM.internalFlg == "N") AND (PAYSYS.PORD.reRoutePymtSysType !="H")) THEN
			#{
				IF((BANCS.OUTPARAM.paysysBaseCrncy != "") AND (BANCS.OUTPARAM.paysysBaseCrncy != PAYSYS.PORD.RemitCrncy)) THEN
				#{
					PAYSYS.PORD.ErrorDesc = "The specified currency cannot be remitted through this Paysys"
					PAYSYS.PORD.successOrFailure="F"
					GOTO endOfScript
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#print(PAYSYS.PORD.DfltRateCode)
		#############################################################################
		#Get the default rate code from HPOSP setup if not available at HPAYSYS level
		#############################################################################
		IF(PAYSYS.PORD.DfltRateCode == "") THEN
		#{
			sv_s = "defaultFxRateCode |SELECT default_fx_rate_code FROM tbaadm.POBP "
			sv_s = sv_s + " where bank_id = ?SVAR "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
			sv_r = urhk_dbselectWithBind(sv_s)
			IF(sv_r == 0) THEN
			#{
				PAYSYS.PORD.DfltRateCode = BANCS.OUTPARAM.defaultFxRateCode
			#}
			ENDIF
		#}
		ENDIF
		
		#print(PAYSYS.PORD.DfltRateCode)
		#################################################################
		#Checks for Min Tran., Max Tran. and Max STP amt limits
		#################################################################
		IF((PAYSYS.PORD.reRoutePymtSysType != "H") AND (PAYSYS.PORD.reRoutePymtSysType != "B")) THEN
		#{
			sv_s = "MinAmt,MinCrncy,MaxAmt,MaxCrncy|SELECT min_tran_amt,min_amt_crncy,max_tran_amt,max_amt_crncy FROM tbaadm.PMSG "
			sv_s = sv_s + "where  paysys_id = ?SVAR "
			sv_s = sv_s + " AND msg_id= ?SVAR "
			sv_s = sv_s + " AND in_out_ind='O' "
			sv_s = sv_s + " AND PMSG.bank_id = ?SVAR "
			
			BANCS.INPARAM.BINDVARS = PAYSYS.PORD.ReroutePaysysID + "|" + PAYSYS.PORD.MsgId + "|" + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			PRINT(PAYSYS.PORD.MsgId)
			PRINT(PAYSYS.PORD.ReroutePaysysID)
			sv_r = urhk_dbselectWithBind(sv_s)
			IF(sv_r == 0) THEN
			#{
				PAYSYS.PORD.MinAmt   = BANCS.OUTPARAM.MinAmt
				PAYSYS.PORD.MinCrncy = BANCS.OUTPARAM.MinCrncy
				PAYSYS.PORD.MaxAmt   = BANCS.OUTPARAM.MaxAmt
				PAYSYS.PORD.MaxCrncy = BANCS.OUTPARAM.MaxCrncy
				
				sv_a = CDOUBLE(BANCS.INPUT.remitAmt)
				
				#------------------------------
				#Checks for MinCrncy and MinAmt
				#------------------------------
				IF((PAYSYS.PORD.MinCrncy != "") AND (PAYSYS.PORD.MinAmt != "")) THEN
				#{
					sv_b = CDOUBLE(PAYSYS.PORD.MinAmt)
					
					#If currencies are same, compare directly
					IF(PAYSYS.PORD.MinCrncy == PAYSYS.PORD.RemitCrncy) THEN
					#{
						IF(sv_a < sv_b) THEN
						#{
							PAYSYS.PORD.ErrorDesc = "Remit Amount is less than Min. Tran Amount Limit in HPAYSYS setup"
							PAYSYS.PORD.successOrFailure="F"
							GOTO endOfScript
						#}
						ENDIF
					#}
					ENDIF
					
					#If currencies are different, convert to common currency and compare
					IF(PAYSYS.PORD.MinCrncy != PAYSYS.PORD.RemitCrncy) THEN
					#{
						IF(PAYSYS.PORD.DfltRateCode == "") THEN
						#{
							PAYSYS.PORD.ErrorDesc = "Rate code not available For Min. Tran Amount Limit Check"
							PAYSYS.PORD.successOrFailure="F"
							GOTO endOfScript
						#}
						ENDIF
						
						BANCS.INPARAM.InputAmount = PAYSYS.PORD.MinAmt
						BANCS.INPARAM.FromCurrency = PAYSYS.PORD.MinCrncy
						BANCS.INPARAM.ToCurrency = PAYSYS.PORD.RemitCrncy
						BANCS.INPARAM.RateCode = PAYSYS.PORD.DfltRateCode
						BANCS.INPARAM.Rate = 0
						IF(PAYSYS.PORD.MinAmt > 0 ) THEN
						#{
							sv_r=urhk_B2k_ConvertAmount("")
							
							IF(sv_r != 0) THEN
							#{
								PAYSYS.PORD.ErrorDesc = "Error converting amount for Min. Tran Amount Limit check with rate code " + PAYSYS.PORD.DfltRateCode
								PAYSYS.PORD.successOrFailure="F"
								GOTO endOfScript
							#}
							ENDIF
							sv_z= CDOUBLE(BANCS.OUTPARAM.OutputAmount)
							#print(BANCS.OUTPARAM.OutputAmount)
							
							IF(sv_a < sv_z) THEN
							#{
								PAYSYS.PORD.ErrorDesc = "Remit Amount is less than Min. Tran Amount Limit in HPAYSYS setup"
								PAYSYS.PORD.successOrFailure="F"
								GOTO endOfScript
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					
				#}
				ENDIF
				
				#------------------------------
				#Checks for MaxCrncy and MaxAmt
				#------------------------------
				IF((PAYSYS.PORD.MaxCrncy != "") AND (PAYSYS.PORD.MaxAmt != "")) THEN
				#{
					sv_c = CDOUBLE(PAYSYS.PORD.MaxAmt)
					IF(PAYSYS.PORD.MaxCrncy ==  PAYSYS.PORD.RemitCrncy) THEN
					#{
						IF(sv_a > sv_c) THEN
						#{
							PAYSYS.PORD.ErrorDesc = "Remit Amt is greater than Tran Amount Limit in HPAYSYS setup"
							PAYSYS.PORD.successOrFailure="F"
							GOTO endOfScript
						#}
						ENDIF
					#}
					ENDIF
					
					IF(PAYSYS.PORD.MaxCrncy !=  PAYSYS.PORD.RemitCrncy) THEN
					#{
						IF(PAYSYS.PORD.DfltRateCode == "") THEN
						#{
							PAYSYS.PORD.ErrorDesc = "Rate code not available For Max. Tran Amount Limit Check"
							PAYSYS.PORD.successOrFailure="F"
							GOTO endOfScript
						#}
						ENDIF
						
						BANCS.INPARAM.InputAmount = PAYSYS.PORD.MaxAmt
						BANCS.INPARAM.FromCurrency = PAYSYS.PORD.MaxCrncy
						BANCS.INPARAM.ToCurrency = PAYSYS.PORD.RemitCrncy
						BANCS.INPARAM.RateCode = PAYSYS.PORD.DfltRateCode
						BANCS.INPARAM.Rate = 0
						
						IF(PAYSYS.PORD.MaxAmt > 0 ) THEN
						#{
							sv_r=urhk_B2k_ConvertAmount("")
							IF(sv_r != 0) THEN
							#{
								PAYSYS.PORD.ErrorDesc = "Error converting amount for Max. Tran Amount Limit check with rate code " + PAYSYS.PORD.DfltRateCode
								PAYSYS.PORD.successOrFailure="F"
								GOTO endOfScript
							#}
							ENDIF
							sv_z= CDOUBLE(BANCS.OUTPARAM.OutputAmount)
							#print(sv_z)
							IF(sv_a > sv_z) THEN
							#{
								PAYSYS.PORD.ErrorDesc = "Remit Amt is greater than Tran Amount Limit in HPAYSYS setup"
								PAYSYS.PORD.successOrFailure="F"
								GOTO endOfScript
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		
		######################################################################################################
		# Validation for the Final Settlement Account ( Credit Account ) for Gross and
		# Bulk payment systems
		######################################################################################################
		IF(PAYSYS.PORD.finalStlmtAcct != "") THEN
		#{
			PRINT(PAYSYS.PORD.finalStlmtAcct)
			PRINT(PAYSYS.PORD.reRoutePymtSysType)
			PRINT(PAYSYS.PORD.successOrFailure)
			PRINT(PAYSYS.PORD.ErrorDesc)
			IF((PAYSYS.PORD.reRoutePymtSysType == "H") OR (PAYSYS.PORD.reRoutePymtSysType == "G")) THEN
			#{
				sv_q = "accBacid | SELECT bacid FROM GAM where bacid = ("
				sv_q = sv_q + "SELECT settlement_bacid_out_cr FROM tbaadm.EPT "
				sv_q = sv_q + "where paysys_id =?SVAR "
				sv_q = sv_q + "AND EPT.bank_id = ?SVAR) AND "
				sv_q = sv_q + "foracid = ?SVAR"
				sv_q = sv_q + " AND GAM.bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = PAYSYS.PORD.ReroutePaysysID + "|" + BANCS.STDIN.contextBankId + "|" + PAYSYS.PORD.finalStlmtAcct + "|" + BANCS.STDIN.contextBankId
				PRINT(sv_q)
				sv_r = urhk_dbselectWithBind(sv_q)
				IF(sv_r != 0) THEN
				#{
					PAYSYS.PORD.ErrorDesc = "Credit Account not belong to the settlement account of the Payment SYSTEM "
					PAYSYS.PORD.successOrFailure="F"
					GOTO endOfScript
					#}
					#}
					#}
					PRINT(PAYSYS.PORD.finalStlmtAcct)
				#}
				ENDIF
				PRINT(PAYSYS.PORD.ErrorDesc)
			endOfScript:
				BANCS.OUTPUT.successOrFailure=PAYSYS.PORD.successOrFailure
				PRINT(BANCS.OUTPUT.successOrFailure)
				BANCS.OUTPUT.errorMessage=PAYSYS.PORD.ErrorDesc
				PRINT(BANCS.OUTPUT.errorMessage)
				#BANCS.OUTPUT.ErrorDesc=PAYSYS.PORD.ErrorDesc
				#trace off
				EXITSCRIPT
				
				TRACE OFF
		END-->
		
		
		
		
