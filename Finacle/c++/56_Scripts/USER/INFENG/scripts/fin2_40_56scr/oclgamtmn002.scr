		#{
		sv_u = urhk_SetOrbOut("Error|Parameter value not set in C_CPARAM_VALUE_TABLE")
		GOTO FINISH
	#}
	ENDIF
	
	
	IF ( STDWFS.CHQVAL.acctNo == OCTR.GLBVAR.pAcct) THEN
	#{
		IF (OCTR.GLBVAR.tranRmk =="")THEN
		#{
			sv_u = urhk_SetOrbOut("Error|ENTER PRN No. In Remarks Field")
			GOTO FINISH
			#}
		ELSE
			#{
			sv_r = urhk_B2k_isStringNumeric (OCTR.GLBVAR.tranRmk)
			sv_z = STRLEN(OCTR.GLBVAR.tranRmk)
			IF( (sv_r != 0) OR (sv_z != CINT(OCTR.GLBVAR.rmrkLen)) ) THEN
			#{
				sv_u = urhk_SetOrbOut("Error|The PRN is not Correct..Numbers Only")
				GOTO FINISH
				#}
			ELSE
				#{
				sv_s="count|SELECT COUNT(1) FROM URA_REG a WHERE STATUS='A'"
				sv_s = sv_s + "AND a.EXPIRESAT >=TRUNC(SYSDATE) AND NOT EXISTS (SELECT 1 FROM URA_PAY b WHERE a.regno = b.regno) "
				sv_s = sv_s + "AND a.REGNO = ?SVAR "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = OCTR.GLBVAR.tranRmk + "|" + BANCS.STDIN.contextBankId
