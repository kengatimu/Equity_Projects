							sv_u = urhk_SetOrbOut("Error|QUIT .......ENTERED AMOUNT DOES NOT TALLY WITH URA AMOUNT: " + OCTR.GLBVAR.amt)
							GOTO FINISH
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
