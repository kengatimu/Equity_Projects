					sv_u = urhk_SetOrbOut("Error|Reg No. Incorrect OR Has expired try again")
					GOTO FINISH
					#}
				ELSE
					#{
					sv_s = "REG,NAME,AMOUNT|"
					sv_s = sv_s + "SELECT a.REGNO,a.TAXPAYERNAME,a.AMOUNT FROM URA_REG a WHERE STATUS='A' "
					sv_s = sv_s + "AND a.EXPIRESAT >=TRUNC(SYSDATE) AND NOT EXISTS (SELECT 1 FROM URA_PAY b WHERE a.regno = b.regno) "
					sv_s = sv_s + "SELECT a.REGNO,a.TAXPAYERNAME,a.AMOUNT FROM URA_REG a WHERE STATUS='A' "
					sv_s = sv_s + "AND a.REGNO = ?SVAR "
					sv_s = sv_s + "AND bank_id = ?SVAR"
					print(sv_s)
					BANCS.INPARAM.BINDVARS = OCTR.GLBVAR.tranRmk + "|" + BANCS.STDIN.contextBankId
					sv_d=urhk_dbSelectWithBind(sv_s)
