IF (BANCS.INPUT.DccId == "WPD")  THEN
	IF (BANCS.OUTPUT.ReservedField1 !="") THEN
		print(BANCS.OUTPUT.ReservedField1)
		sv_u = urhk_getAcctDetailsInRepository(BANCS.OUTPUT.ReservedField1)
		IF (sv_u == 0) THEN
			print(BANCS.OUTPARAM.acctSolId)
			print(BANCS.OUTPARAM.acctName)
			print(BANCS.OUTPARAM.custId)
			
			print(BANCS.OUTPUT.ReservedField1)
			sv_k = MID$(BANCS.OUTPARAM.acctName,0,45)
			print(sv_k)
			BANCS.OUTPUT.ReservedField1 = sv_k
			print(BANCS.OUTPUT.ReservedField1)
			BANCS.OUTPUT.ReservedField2 =""

			IF (BANCS.OUTPUT.DeviceId != "") THEN

				sv_s = "solId,account "
				sv_s = sv_s + " | "
				sv_s = sv_s + " SELECT AGT.sol_id,GAM.foracid "
				sv_s = sv_s + " FROM TBAADM.AGT,TBAADM.GAM "
				sv_s = sv_s + " WHERE AGT.oper_credit_acid = GAM.acid "
				sv_s = sv_s + " AND GAM.acct_cls_flg != 'Y'"
				sv_s = sv_s + " AND agent_code = ?SVAR"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
				sv_s = sv_s + " AND AGT.del_flg !='Y' AND rownum<2"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|"+ BANCS.STDIN.contextBankId
				sv_d =urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF  (sv_d == "0") then
					CUST.ATM.Agentaccount=BANCS.OUTPARAM.account
					print(CUST.ATM.Agentaccount)
					sv_o = CUST.ATM.Agentaccount
					print(sv_o)
					IF (sv_o !="") THEN
						BANCS.OUTPUT.ReservedField1 = sv_o + BANCS.OUTPUT.ReservedField1
						print(BANCS.OUTPUT.ReservedField1)
					ENDIF
				ENDIF
			ENDIF
		ELSE
			sv_z = BANCS.OUTPUT.ReservedField1
			print(sv_z)
			sv_s = "acctNum,name "
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT acctnum,name "
			sv_s = sv_s + " FROM CUSTOM.C_CIC_BILLS "
			sv_s = sv_s + " WHERE refnum = ?SVAR"
			sv_s = sv_s + " AND del_flg ='N' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			BANCS.INPARAM.BINDVARS = sv_z + "|" + BANCS.STDIN.contextBankId
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == "0") THEN
				sv_n =BANCS.OUTPARAM.name
				print(sv_n)
				BANCS.OUTPUT.ReservedField1 = BANCS.OUTPARAM.acctNum +sv_n 
				print(BANCS.OUTPUT.ReservedField1)
			ENDIF
		ENDIF
	ENDIF
ENDIF



IF (BANCS.INPUT.DccId == "WYM")  THEN
	IF (BANCS.OUTPUT.ReservedField2 =="P2PInter") THEN
		print(BANCS.OUTPUT.CardAcceptorName) 

		sv_r = REPEXISTS("COLL")
		IF (sv_r == 0) THEN
			CREATEREP("COLL")
		ENDIF

		sv_r = CLASSEXISTS("COLL", "GLBDATA")
		IF (sv_r == 0) THEN
			CREATECLASS("COLL", "GLBDATA", 5)
		ENDIF


		sv_s = BANCS.OUTPUT.CardAcceptorName
		print(sv_s)
		sv_u = "waterrefnum,EslipDetails1|select substr(?SVAR,1,instr(?SVAR,'/') - 1) ,substr(?SVAR,instr(?SVAR,'/') + 1) from dual "
		print(sv_u)
		BANCS.INPARAM.BINDVARS= sv_s+"|"+sv_s+"|"+sv_s+"|"+sv_s
		sv_w=urhk_dbSelectWithBind(sv_u)
		print(sv_w)
		COLL.GLBDATA.waterrefnum = trim(BANCS.OUTPARAM.waterrefnum)
		print(COLL.GLBDATA.waterrefnum)
		COLL.GLBDATA.EslipDetails1 = BANCS.OUTPARAM.EslipDetails1
		print(COLL.GLBDATA.EslipDetails1)

		sv_q = COLL.GLBDATA.EslipDetails1
		print(sv_q)

		sv_u = " uraamt,EslipDetails2|select substr(?SVAR,1,instr(?SVAR,'/') - 1) ,substr(?SVAR,instr(?SVAR,'/') + 1) from dual "
		print(sv_u)
		BANCS.INPARAM.BINDVARS= sv_q+"|"+sv_q+"|"+sv_q+"|"+sv_q
		sv_w=urhk_dbSelectWithBind(sv_u)
		print(sv_w)
		COLL.GLBDATA.uraamt = trim(BANCS.OUTPARAM.uraamt)
		print(COLL.GLBDATA.uraamt)

		BANCS.OUTPUT.ReservedField1 = COLL.GLBDATA.waterrefnum + COLL.GLBDATA.uraamt
		print(BANCS.OUTPUT.ReservedField1)

	ENDIF
ENDIF

## beba ##
IF (BANCS.INPUT.CrForacid!="") THEN
	IF  ((BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "WYM"))  THEN
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1) THEN	
		IF ((BANCS.INPUT.ReservedField2 =="Otherbill") OR (BANCS.INPUT.ReservedField2 =="AgentBill")) THEN		
			CUST.ATM.crForAcid1 =""
				CUST.ATM.crForAcid2 =""
					CUST.ATM.crForAcid3 =""
			IF ((BANCS.INPUT.CrForacid==CUST.ATM.crForAcid1) OR (BANCS.INPUT.CrForacid==CUST.ATM.crForAcid2) OR (BANCS.INPUT.CrForacid==CUST.ATM.crForAcid3)) THEN

				sv_u = "billercode,accountnumber,accountname |"
				sv_u = sv_u + " select FREE_TEXT5,FREE_TEXT1,BILLER_NAME from tbaadm.brgt where FREE_TEXT1=?SVAR "
				print(sv_u)
				BANCS.INPARAM.BINDVARS=BANCS.INPUT.CrForacid
				sv_w=urhk_dbSelectWithBind(sv_u)
				print(sv_w)
				IF (sv_w !=0) THEN 
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					exitscript
				ELSE
					CUST.ATM.billercode = BANCS.OUTPARAM.billercode
					print(CUST.ATM.billercode)
					CUST.ATM.accountnumber = BANCS.OUTPARAM.accountnumber
					print(CUST.ATM.accountnumber)
					CUST.ATM.accountname = BANCS.OUTPARAM.accountname
					print(CUST.ATM.accountname)
					print(BANCS.INPUT.CardAcceptorName)
					print(BANCS.INPUT.TranAmt)
					sv_g = MID$(BANCS.INPUT.TranAmt,0,14)
					print(sv_g)
					CUST.ATM.amountsvg = cdouble(sv_g)
					print(CUST.ATM.amountsvg)

					sv_q = " Eslipdetails| select custom.TPB_PKG.CALLUPGBVWSFUNCTION(?SVAR,?SVAR,?SVAR) from dual"
					print(sv_q)
					BANCS.INPARAM.BINDVARS=CUST.ATM.billercode + "|" + BANCS.INPUT.CardAcceptorName + "|" + CUST.ATM.amountsvg
					print(BANCS.INPARAM.BINDVARS)
					sv_w=urhk_dbSelectWithBind(sv_q)
					print(sv_w)
					IF ( sv_w != 0 ) then
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.ReservedField3 = "803"
						print(BANCS.OUTPUT.ReservedField3)
						BANCS.OUTPUT.successOrFailure="F"
					ELSE
						CUST.ATM.Eslipdetails = BANCS.OUTPARAM.Eslipdetails
						print(CUST.ATM.Eslipdetails)
						IF (CUST.ATM.Eslipdetails=="") THEN
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.ReservedField3 = "804"
							print(BANCS.OUTPUT.ReservedField3)
							BANCS.OUTPUT.successOrFailure="F"
						ELSE
							sv_s = CUST.ATM.Eslipdetails
							print(sv_s)
							sv_u = "statusbill,EslipDetails1|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
							print(sv_u)
							BANCS.INPARAM.BINDVARS = sv_s + "|" + sv_s + "|" + sv_s + "|" + sv_s
							sv_w=urhk_dbSelectWithBind(sv_u)
							print(sv_w)
							CUST.ATM.statusbill = BANCS.OUTPARAM.statusbill
							print(CUST.ATM.statusbill)
							CUST.ATM.EslipDetails1 = BANCS.OUTPARAM.EslipDetails1
							print(CUST.ATM.EslipDetails1)

							IF (CUST.ATM.statusbill=="false") THEN
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.ReservedField3 = "805"
								print(BANCS.OUTPUT.ReservedField3)
								BANCS.OUTPUT.successOrFailure="F"
							ELSE
								BANCS.OUTPUT.successOrFailure="S"
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	ENDIF
ENDIF

BANCS.OUTPUT.successOrFailure="S"
IF (BANCS.INPUT.DccId == "EFR")  THEN
#{

	IF((BANCS.OUTPUT.Command == "CDAS")  OR (BANCS.OUTPUT.Command == "CWDS")) THEN
	#{
		BANCS.OUTPUT.ReservedField3 = BANCS.OUTPUT.TranId
	#}
	ENDIF
#}
ENDIF
IF (BANCS.INPUT.DccId == "EFR") THEN
	IF (BANCS.INPUT.Command=="FSIS") THEN
		IF (BANCS.INPUT.ReservedField1!="") THEN
			sv_g = MID$(BANCS.INPUT.ReservedField1,0,1)
			print(sv_g)
			sv_h = MID$(BANCS.INPUT.ReservedField1,1,2)
			print(sv_h)			
			IF (BANCS.INPUT.Foracid!="") THEN
				print(BANCS.INPUT.Foracid)
				IF (sv_h !="20") THEN
					sv_s = "update CUSTOM.EFR_STATEMENTS set NO_RECRDS=?SVAR where FORACID=?SVAR and STATUS ='N' and rownum<2"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = sv_h + "|" + BANCS.INPUT.Foracid
					PRINT(BANCS.INPARAM.BINDVARS)

					sv_d = urhk_dbSQLWithBind(sv_s)
					print(sv_d)
					if (sv_d==0) then
						call("copyBancsToCustC24.scr")
						call("othercharges.scr")
						call("copyCust24ToBancs.scr")
						print("success")
					endif
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

IF (CLASSEXISTS("CUST","DATA") != 1) THEN
      CREATECLASS("CUST","DATA",5)
ENDIF

sv_r=urhk_b2k_printRepos("BANCS")

#IF ((BANCS.INPUT.DccId == "COR") OR (BANCS.INPUT.DccId == "EFR")) THEN

        IF(BANCS.INPUT.Command == "FSIS")THEN
                 
		sv_r=BANCS.OUTPUT.ReservedField1

                #SEPERATING THE NEEDED DATA
					
		sv_a=MID$(sv_r,36,17)
		PRINT("Transaction Amount")
		PRINT(sv_a)
		
		#sv_b=MID$(sv_r,125,17) FOR 7X VERSION
		
		#FOR 10X VERSION
		sv_b=MID$(sv_r,133,17)
		PRINT("Balance at the End of Transaction")
		PRINT(sv_b)
		
		sv_i=MID$(sv_r,27,1)
		PRINT("Transaction Indicator")
		PRINT(sv_i)

                sv_m=CDOUBLE(sv_a)  
                sv_n=CDOUBLE(sv_b) 
                
                IF(sv_i=="C")THEN
			#Balance-Transaction Amount
			
			sv_z=sv_n-sv_m 			
                ELSE   
			#Balance+Transaction Amount

			sv_z=sv_n+sv_m     
		ENDIF
				
			CUST.DATA.Fwd=sv_z
			
			IF(sv_z>0)THEN
				CUST.DATA.Fwd="+"+CUST.DATA.Fwd
			ENDIF
			
			print("Balance Brought Forward:")
			print(CUST.DATA.Fwd)
			CUST.DATA.Fwd = MID$(CUST.DATA.Fwd,0,GETPOSITION(CUST.DATA.Fwd,".") ) +  MID$(CUST.DATA.Fwd,GETPOSITION(CUST.DATA.Fwd,"."),3)
			print(CUST.DATA.Fwd)
         	            
			BANCS.OUTPUT.UserDefBal = CUST.DATA.Fwd
			print(BANCS.OUTPUT.UserDefBal)
			sv_r=urhk_b2k_printRepos("BANCS")
	ENDIF
#ENDIF

ENDOFSCRIPT:
exitscript

trace off
