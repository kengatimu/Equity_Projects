<--start
trace on

CALL("Common_Interface_CreateRepos.scr")

sv_b = "N"
print(sv_b)

sv_q="charge_amt,foracid,solid,remitCrncy,awinstAcct,benefName,benfaddress1,benefCtryCode,Bic,others,amount,sequence,freetext1,swift_code,salrtgschargeaccno,eventid|"
sv_q = sv_q + " select CHARGE_AMT,DEBIT_ACCTNUM,sol_id,remitCrncy,BENEF_ACCTNUM,benefName,NARATIONS,benefCtryCode,BENEF_BANKCODE,BENEF_BRANCHCODE,amount,sequence,CBK_CLEARING_ACCOUNT,SWIFT_CODE,SAL_RTGS_CHARGE_ACC_NO,EVENT_ID from "
sv_q = sv_q + " CUSTOM.PORDM where ENTITY_CRE_FLG= ?SVAR and BANK_ID =?SVAR "
print(sv_q)
BANCS.INPARAM.BINDVARS = sv_b + "|" + BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
                
sv_c = urhk_dbCursorOpenWithBind(sv_q)
print(sv_c)

IF (sv_c==0) then
#{

                CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
                print(sv_k)

WHILE (sv_k == 0)
#{


CUST.INTERFACE.interfaceRequestID = "executeFinacleScript"
CUST.INTERFACE.interfaceRequestVersion = "10.2"
CUST.INTERFACE.bankID ="56"
CUST.INTERFACE.channelID = "COR"
CUST.INTERFACE.BODDate=BANCS.STDIN.BODDate
print(CUST.INTERFACE.BODDate)
CUST.INTERFACE.foracid=BANCS.OUTPARAM.foracid
print(CUST.INTERFACE.foracid)
CUST.INTERFACE.solid=BANCS.OUTPARAM.solid
print(CUST.INTERFACE.solid)
CUST.INTERFACE.remitCrncy=BANCS.OUTPARAM.remitCrncy
print(CUST.INTERFACE.remitCrncy)
CUST.INTERFACE.awinstAcct=BANCS.OUTPARAM.awinstAcct
print(CUST.INTERFACE.awinstAcct)
CUST.INTERFACE.benefName=MID$(BANCS.OUTPARAM.benefName,0,35)
print(CUST.INTERFACE.benefName)
CUST.INTERFACE.benfaddress1=BANCS.OUTPARAM.benfaddress1
print(CUST.INTERFACE.benfaddress1)
CUST.INTERFACE.benefCtryCode=BANCS.OUTPARAM.benefCtryCode
print(CUST.INTERFACE.benefCtryCode)
CUST.INTERFACE.Bic=BANCS.OUTPARAM.Bic
print(CUST.INTERFACE.Bic)
CUST.INTERFACE.amount=BANCS.OUTPARAM.amount
print(CUST.INTERFACE.amount)
CUST.INTERFACE.BODDate=BANCS.STDIN.BODDate
print(CUST.INTERFACE.BODDate)
CUST.INTERFACE.others=BANCS.OUTPARAM.others
print(CUST.INTERFACE.others)
CUST.INTERFACE.sequence=BANCS.OUTPARAM.sequence
print(CUST.INTERFACE.sequence)
CUST.INTERFACE.freetext1=BANCS.OUTPARAM.freetext1
print(CUST.INTERFACE.freetext1)
CUST.INTERFACE.swift_code=BANCS.OUTPARAM.swift_code
print(CUST.INTERFACE.swift_code)
CUST.INTERFACE.charge_amt=BANCS.OUTPARAM.charge_amt
print(CUST.INTERFACE.charge_amt)

CUST.INTERFACE.salrtgschargeaccno=BANCS.OUTPARAM.salrtgschargeaccno
print(CUST.INTERFACE.salrtgschargeaccno)

CUST.INTERFACE.eventid=BANCS.OUTPARAM.eventid
print(CUST.INTERFACE.eventid)
IF (CUST.INTERFACE.foracid=="0003000103538") THEN
	CUST.INTERFACE.eventid="MERRTGS"
	print(CUST.INTERFACE.eventid)
ENDIF

IF ((CUST.INTERFACE.salrtgschargeaccno=="") OR (CUST.INTERFACE.salrtgschargeaccno=="null")) THEN
	CUST.INTERFACE.salrtgschargeaccno = CUST.INTERFACE.foracid
	print(CUST.INTERFACE.salrtgschargeaccno)
ENDIF
print(CUST.INTERFACE.benfaddress1)
IF (CUST.INTERFACE.benfaddress1!="") THEN
	CUST.INTERFACE.Narrations=CUST.INTERFACE.benfaddress1
	print(CUST.INTERFACE.Narrations)
ELSE
	CUST.INTERFACE.Narrations=""
	print(CUST.INTERFACE.Narrations)
ENDIF
CUST.INTERFACE.benfaddress1="null"
print(CUST.INTERFACE.benfaddress1)
IF ((CUST.INTERFACE.benfaddress1=="") OR (CUST.INTERFACE.benfaddress1=="null") OR (CUST.INTERFACE.benfaddress1=="||||")) THEN
	sv_s = "foracida,acct_name,address_line1,zip|select foracid,acct_name,ADDRESS_LINE1,ZIP from tbaadm.gam,crmuser.address s where gam.bank_id=s.bank_id and gam.cif_id=s.orgkey  "
	sv_s = sv_s + " and gam.foracid=?SVAR and gam.bank_id=?SVAR and ADDRESSCATEGORY='Mailing' and s.bank_id=?SVAR and rownum<2 "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.salrtgschargeaccno + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d =="0") THEN
		CUST.INTERFACE.foracida = BANCS.OUTPARAM.foracida 
		print(CUST.INTERFACE.foracida)
		CUST.INTERFACE.acct_name = MID$(BANCS.OUTPARAM.acct_name,0,35)
		print(CUST.INTERFACE.acct_name)
		CUST.INTERFACE.address_line1 = MID$(BANCS.OUTPARAM.address_line1,0,35)
		print(CUST.INTERFACE.address_line1)
		CUST.INTERFACE.zip = MID$(BANCS.OUTPARAM.zip,0,35)
		print(CUST.INTERFACE.zip)
		CUST.INTERFACE.benfaddress1 = CUST.INTERFACE.acct_name
		print(CUST.INTERFACE.benfaddress1)
		CUST.INTERFACE.benfaddress2 = CUST.INTERFACE.address_line1
		print(CUST.INTERFACE.benfaddress2)
		CUST.INTERFACE.benfaddress3 = CUST.INTERFACE.zip 
		print(CUST.INTERFACE.benfaddress3)
		CUST.INTERFACE.benfaddress4 = "UGANDA"
		print(CUST.INTERFACE.benfaddress4)
		CUST.INTERFACE.benfaddress3 = CUST.INTERFACE.zip + " " + CUST.INTERFACE.benfaddress4
		print(CUST.INTERFACE.benfaddress3) 
	ELSE
		CUST.INTERFACE.benfaddress1 = "EQUITY BANK "
		print(CUST.INTERFACE.benfaddress1)
		CUST.INTERFACE.benfaddress2 = "P.O.BOX 75104 "
		print(CUST.INTERFACE.benfaddress2)
		CUST.INTERFACE.benfaddress3 = "00200"
		print(CUST.INTERFACE.benfaddress3)
		CUST.INTERFACE.benfaddress4 = "UGANDA"
		print(CUST.INTERFACE.benfaddress4)
		CUST.INTERFACE.benfaddress3 = CUST.INTERFACE.zip + " " + CUST.INTERFACE.benfaddress4
		print(CUST.INTERFACE.benfaddress3)
	ENDIF
ENDIF

#-------------------------------------------------------------------------
# Fetch the current data time to send in request header
#-------------------------------------------------------------------------
sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0) THEN
#{
                CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
                print(CUST.INTERFACE.msgDateTime)
#}
ENDIF

#-------------------------------------------------------------------------
#- Forming the Header for RetCustAdd
#-------------------------------------------------------------------------

sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
sv_d = urhk_dbSelectWithBind(sv_s)
IF(sv_d == 0)THEN
#{
                CUST.INTERFACE.RequestID1 = BANCS.OUTPARAM.RequestID
                print(CUST.INTERFACE.RequestID1)
#}
ELSE
#{
                CUST.INTERFACE.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
                print(CUST.INTERFACE.RequestID1)
#}
ENDIF

CUST.INTERFACE.headerXML = ""
CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Header>"
