if(repexists("CUST")==0)then
	createrep("CUST")
endif

if(classexists("CUST","DATA")==0)then
    createclass("CUST","DATA",5)
endif

	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)

	CUST.DATA.funcCode = BANCS.INPUT.funcCode
	print(CUST.DATA.funcCode)
	CUST.DATA.fileName = BANCS.INPUT.fileName
	print(BANCS.INPUT.fileName)

	sv_s = "filename |"
        sv_s = sv_s + " select substr('"+ CUST.DATA.fileName +"',instr('"+ CUST.DATA.fileName +"' ,'\',-1)+1) "
        sv_s = sv_s + " from dual "
        print(sv_s)
        sv_d = urhk_dbSelectWithBind(sv_s)
        print(sv_d)
        if(sv_d == 0) then
		CUST.DATA.filename = BANCS.OUTPARAM.filename
		print(CUST.DATA.filename)
	ELSE
		CUST.DATA.filename = ""
		
		CUST.DATA.msg = "Error_2|Error.2^Select a valid file "
		sv_c = urhk_setorbout("SuccessOrFailure|N")
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
		GOTO ENDOFSCRIPT
	ENDIF


IF (CUST.DATA.funcCode == "B2C")  THEN
		sv_r = urhk_getEnv("ONS_LOG_DIR")
		if(sv_r == 0) then
			CUST.DATA.FilePath = BANCS.OUTPARAM.envValue
			CUST.DATA.File_Path = BANCS.OUTPARAM.envValue

			print(CUST.DATA.FilePath)
		endif
		CUST.DATA.FilePath = CUST.DATA.FilePath +"/"+BANCS.STDIN.userId+"/"+CUST.DATA.filename
		print(CUST.DATA.FilePath)
		call("cdataupdp004.scr")
		sv_r = system("sleep 5")
		CUST.DATA.File_Path = CUST.DATA.File_Path +"/"+BANCS.STDIN.userId

	Print(CUST.DATA.File_Path)
	Print(BANCS.STDIN.userId)
	Print(CUST.DATA.filename)


	sv_u = urhk_getFileLocation("COM|B2C.com")
	print(sv_u)
	print(BANCS.OUTPARAM.fileLocation)
	if(sv_u == 0)then
		sv_a = "stuserId|" + BANCS.STDIN.userId
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		sv_a = "dfilpth|" + CUST.DATA.File_Path
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		sv_a = "dfilname|" + CUST.DATA.filename
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		print(sv_u)
		BANCS.INPARAM.scriptName = "B2C.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		if(sv_u != 0)then
		print("failed")
		else
			print("success")
		endif
	endif
lv_b = urhk_SetOrbOut("SuccessOrFailure|Y")
sv_x="File Uploaded successfully. Pull report after sometime for results"
CUST.DATA.message = "RESULT_MSG|"+sv_x
sv_u = urhk_SetOrbOut(CUST.DATA.message)

ENDIF


