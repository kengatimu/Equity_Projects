	#----------------- MODIFIED BY OSUKA: Adding Virtual Account Verification by managers - 16-AUG-24 ------------------------------#
	IF(CUST.DATA.funcCode == "VV")THEN
		IF(FIELDEXISTS(BANCS.STDIN.userWorkClass)) THEN
			IF((CINT(BANCS.STDIN.userWorkClass) == 150) OR (CINT(BANCS.STDIN.userWorkClass) == 200)) THEN
				PRINT("User work class okay")
				callscriptifexist("ppveronlinecifcreation.scr")

				##Create Report the accounts opened
				sv_s="custcount|"
				sv_s = sv_s + " SELECT COUNT(1) "
				sv_s = sv_s + " FROM CUSTOM.BULK_CIF2 "
				sv_s = sv_s + " WHERE ENTITY_CRE_FLG ='V' "
				sv_s = sv_s + " AND SOL_ID= ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR AND CIF_ID is not null and file_name = ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.filename
				
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF (sv_d != 0) THEN
					CUSTS.SBAAA.errMsg = "DB ERROR!"
					GOTO ENDOFSCRIPT
				ELSE
					print(BANCS.OUTPARAM.custcount)
					CUST.DATA.count = BANCS.OUTPARAM.custcount
					IF (CINT(CUST.DATA.count)== 0) THEN
						CUST.DATA.msg = "No records found"
						sv_c = urhk_setorbout("SuccessOrFailure|N")
						sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
						GOTO ENDOFSCRIPT
					ENDIF

					IF(CUST.DATA.count<1)THEN
						CUST.DATA.msg = "File name Doesn't Exists"
						sv_c = urhk_setorbout("SuccessOrFailure|N")
						sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
						GOTO ENDOFSCRIPT
					ENDIF

					lv_d = urhk_B2k_PID("")
					IF (lv_d == 0) THEN
						CUST.DATA.pid = BANCS.OUTPARAM.PID
						PRINT(CUST.DATA.pid)
					ENDIF

					#-----------------------------------------------------------------------------------------
					#Calling the sql to create the report
					#-----------------------------------------------------------------------------------------
					CUST.DATA.lstFile = "Virtual_Acct_Opening_Report_"+CUST.DATA.pid+"_"+MID$(BANCS.STDIN.BODDate,0,10)+".lst"

					# 'testdata.txt|54|129|V'
					CUST.DATA.status = "V"
					CUST.DATA.inputStr = CUST.DATA.filename + "!" + BANCS.STDIN.contextBankId + "!" + BANCS.STDIN.mySolId + "!" + CUST.DATA.status
					print(CUST.DATA.inputStr)

					CUST.DATA.ReportHeader = "SCHM  CODE|NATIONAL ID |FIRST NAME     |SURNAME             |DATE OF BIRTH  |CIF ID     |ACCOUNT NUMBER    |PHONE NUMBER|ERROR CODE                                                                 "

					lv_a = "echo " + '"' + CUST.DATA.ReportHeader + '"' + " > " + CUST.DATA.lstFile
					PRINT(lv_a)
					lv_s = SYSTEM(lv_a)
					PRINT(lv_s)
					
					sv_a = "exebatch spbx4001" + " " + "CUSTOM.VIRTUAL_ACCT_OPN.VIRTUAL_ACCT_OPN_PROC" + " '" + CUST.DATA.inputStr +"'>>" + CUST.DATA.lstFile
					PRINT(sv_a)
					lv_u = SYSTEM(sv_a)
					PRINT(lv_u)
					IF (lv_u != 0) THEN
					#{
						CUST.DATA.errMsg = "Report generation Failed"
						sv_c = urhk_setorbout("SuccessOrFailure|N")
						sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.errMsg)
						GOTO ENDOFSCRIPT
					ELSE
						#=====================================================================
						# Move the file to HPR menu
						#=====================================================================
						CUST.DATA.userId = BANCS.STDIN.userId
						CUST.DATA.title = "Virtual Account Opening "+CUST.DATA.filename + " Success Rpt"
						PRINT(CUST.DATA.title)
						lv_a = "exebatch babx4040 $B2K_SESSION_ID '" + CUST.DATA.lstFile + "' '" +CUST.DATA.title + "' '" + CUST.DATA.userId + "' '1' N"
						PRINT(lv_a)
						lv_x = SYSTEM(lv_a)
						PRINT(lv_x)
						if(lv_x == 0) then
							sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
							sv_g = "RESULT_MSG|Report generation Process Initiated Successfully For the file "+CUST.DATA.filename+". Check status in HPR"
							sv_z = urhk_SetOrbOut(sv_g)
							PRINT(sv_z)
						ELSE
							CUST.DATA.msg = "Error_2|Error.2^Virtual Account Opening Report Generation Failed "
							sv_c = urhk_setorbout("SuccessOrFailure|N")
							sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
							GOTO ENDOFSCRIPT
						ENDIF
					ENDIF	
				ENDIF
			ELSE
				PRINT("User work class error")
				CUST.DATA.msg = "User work class error! Only 150 and 200 can verify"
				sv_c = urhk_setorbout("SuccessOrFailure|N")
				sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
				GOTO ENDOFSCRIPT
			ENDIF
				
		ELSE
			PRINT("User work class error")
			CUST.DATA.msg = "User work class error"
			sv_c = urhk_setorbout("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.msg)
			GOTO ENDOFSCRIPT
		ENDIF
	ENDIF

    #----------------- MODIFIED BY OSUKA: Adding Bulk CIF Suspension - 27-SEP-24 ------------------------------#
	IF(CUST.DATA.funcCode == "VC1")THEN
		IF(FIELDEXISTS(BANCS.STDIN.userWorkClass)) THEN
			IF(CINT(BANCS.STDIN.userWorkClass) == 150)  THEN
				CUST.DATA.file_name=	CUST.DATA.filename
				PRINT("User work class okay")
				callscriptifexist("BulkCIFSuspensionVerify.scr")
			ELSE
				sv_w = "SuccessOrFailure|N"
				sv_u = urhk_SetOrbOut(sv_w)
				sv_w = "Error_03|ERROR^User workclass error ^fileName"
				sv_u = urhk_SetOrbOut(sv_w)
				GOTO ENDOFSCRIPT
			ENDIF
				
		ELSE
			sv_w = "SuccessOrFailure|N"
			sv_u = urhk_SetOrbOut(sv_w)
			sv_w = "Error_03|ERROR^User workclass error ^fileName"
			sv_u = urhk_SetOrbOut(sv_w)
			GOTO ENDOFSCRIPT
		ENDIF
	ENDIF

	

ENDOFSCRIPT:
exitscript
