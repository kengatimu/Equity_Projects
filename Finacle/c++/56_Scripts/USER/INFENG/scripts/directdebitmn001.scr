		sv_s = sv_s + " AND del_flg!='Y'"
		BANCS.INPARAM.BINDVARS = CUST.CDDUM.Originator + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		
		sv_q = BANCS.OUTPARAM.Count
		print(sv_q)
		
		IF (sv_q == 0) THEN
		#{
			sv_e = "Invalid orginator code"
			sv_m = "Originator"
			#	sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			#	sv_u = urhk_SetOrbOut(sv_s)
			#	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			#	GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		
	#}
	ENDIF
	
	
	
	
	########################################################################################
	# Validation of Filename
	########################################################################################
	IF (CUST.CDDUM.FileName== "") THEN
	#{
		sv_e = "Upload file name should be entered"
		sv_m = "FileName"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	
	#########################################################################
	# Upload file
	###########################################################################
	
	sv_u = urhk_getEnv("CTL_PATH")
	PRINT(sv_u)
	#sv_u = 0
	IF (sv_u != 0) THEN
	#{
		PRINT("User Id Password is not set")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Control file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.envValue)
		CUST.CDDUM.ctlFilePath = BANCS.OUTPARAM.envValue
		PRINT(CUST.CDDUM.ctlFilePath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("DATA_PATH")
	PRINT(sv_u)
	sv_u = 0
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Data file path is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		PRINT(BANCS.OUTPARAM.envValue)
		CUST.CDDUM.dataPath = BANCS.OUTPARAM.envValue
		PRINT(CUST.CDDUM.dataPath)
		
		#----------TOL - 367144-------------#
		BANCS.INPUT.upldPath = CUST.CDDUM.dataPath
		#---------------------------------------------------------------
		# Calling common script to append userId to upload file path
		#---------------------------------------------------------------
		CALL("appendUserId.scr")
		CUST.CDDUM.dataPath = BANCS.INPUT.upldPath
		PRINT(CUST.CDDUM.dataPath)
		CUST.CDDUM.FilePath = CUST.CDDUM.dataPath + CUST.CDDUM.FileName
		PRINT(CUST.CDDUM.FilePath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("FIN_REPORTS_DIR")
	print(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CDDUM.rptPath = BANCS.OUTPARAM.envValue
		print(CUST.CDDUM.rptPath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("USER_PASS")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		print("User Id Password is not set, taking default value")
		sv_z = urhk_SetOrbOut("Error_01|ERROR^User Id Password is not set in common ENV^testMode")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.CDDUM.userPass = BANCS.OUTPARAM.envValue
		print(CUST.CDDUM.userPass)
	#}
	ENDIF
	
	BANCS.INPUT.moduleName  = "CDDUM"
	BANCS.INPUT.parameterId = "CRNCYCODE"
	
	CALL ("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CDDUM.crncyCode = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.BILLS.errMsg = "Upload file Path setup not done CPARAM"
