	#}
	ENDIF
	
	
	
	IF (CUST.CDDUM.Function == "P") THEN
	#{
		CUST.CDDUM.Chrg_flg = "N"
		CUST.CDDUM.Chrg_upl_flg = "N"
	#}
	ENDIF
	print(CUST.CDDUM.Chrg_flg)
	print(CUST.CDDUM.Chrg_upl_flg)
	
	#-------------------------------------------------------------------
	# Insert the record into the Upload Status table
	#-------------------------------------------------------------------
	
	sv_s = " filSrlNum "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT NVL(MAX(upld_srl_num),0) + 1 "
	sv_s = sv_s + " FROM CUSTOM.C_UPLD_EQT_TBL "
	sv_S = sv_S + " WHERE upld_file_name = ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CDDUM.FileName + "|" + BANCS.STDIN.contextBankId
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0 ) THEN
	#{
		CUST.CDDUM.fileSrlNum = BANCS.OUTPARAM.filSrlNum
		print(CUST.CDDUM.fileSrlNum)
		#}
	ELSE
		#{
		CUST.BILLS.fileSrlNum = "1"
		print(CUST.CDDUM.fileSrlNum)
	#}
	ENDIF
	
	sv_s = " INSERT INTO CUSTOM.C_UPLD_EQT_TBL "
	sv_s = sv_s + " ( "
	sv_s = sv_s + " upld_file_name, "
	sv_s = sv_s + " upld_srl_num, "
	sv_s = sv_s + " status, "
	sv_s = sv_s + " status_desc,"
	sv_s = sv_s + " tran_id, "
	sv_s = sv_S + " bank_id, "
	sv_s = sv_s + " rcre_time, "
	sv_s = sv_s + " rcre_user_id, "
	sv_s = sv_s + " del_flg "
	sv_s = sv_s + " ) "
	sv_s = sv_s + " VALUES "
	sv_s = sv_s + " ( "
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "'P',"
	sv_s = sv_s + "'Initial insertionion',"
	sv_s = sv_s + " '', "
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "sysdate,"
	sv_s = sv_s + "?SVAR,"
	sv_s = sv_s + "'N'"
	sv_s = sv_s + " ) "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CDDUM.FileName + "|" + CUST.CDDUM.fileSrlNum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSQLWithBind(sv_s)
	print(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		sv_d = urhk_dbSQLWithBind("COMMIT")
		print(sv_d)
	#}
	ENDIF
	
	sv_c = urhk_getFileLocation("COM|directdebitdp003.com")
	print(sv_c)
	IF(sv_c == 0) THEN
	#{
		CUST.CDDUM.comFileLocation = BANCS.OUTPARAM.fileLocation
		print(CUST.CDDUM.comFileLocation)
		#}
	ELSE
		#{
		CUST.CDDUM.errMsg = "Technical Error - Com file Not exists"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_a = CUST.CDDUM.comFileLocation + "directdebitdp003.com"
	print(sv_a)
	
	sv_d = urex(sv_a,"file.dat",CUST.CDDUM.FilePath+ "|" + BANCS.STDIN.contextBankId + "|" + CUST.CDDUM.FileName)
	print(sv_d)
	print(CUST.CDDUM.fileExist)
	
	IF(CUST.CDDUM.fileExist != "Y" ) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^File Does not Exists in the Specific path^upldFileName")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#####################################################################
	# delete from C_CKBADDS
	######################################################################
	IF(CUST.CDDUM.Function == "P") THEN
	#{
		
		#---------------------------------------------------------------------------
		#Changing file name to 'KBA_Directdebit.TXT' for process/upload
		#---------------------------------------------------------------------------
		
		CUST.CDDUM.txtfile = "KBA_Directdebit.TXT"
		PRINT(CUST.CDDUM.FileName)
		sv_s = "cp " + CUST.CDDUM.FilePath + " " + CUST.CDDUM.txtfile
		print(sv_s)
		sv_r = system(sv_s)
		print(sv_r)
		PRINT(CUST.CDDUM.FileName)
		
		sv_s = "delete from custom.C_KBADDS "
