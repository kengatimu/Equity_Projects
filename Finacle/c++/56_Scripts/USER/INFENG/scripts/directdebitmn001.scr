			CUST.CDDUM.ctlFilePath ="/finacle/EQPROD/BackEnd/Finacle/FC/app/cust/56/INFENG/ctl/"
		ENDIF

		CUST.CDDUM.ctlFilePath = CUST.CDDUM.ctlFilePath + "KBA_DDA.ctl"
		print(CUST.CDDUM.FileName)
		
		#sv_b = "sqlldr " + CUST.CDDUM.userPass + "  control=" + CUST.CDDUM.ctlFilePath + "   data=" + CUST.CDDUM.FileName + " " + BANCS.STDIN.contextBankId
		#print(sv_b)
		
		#sv_a = SYSTEM(sv_b)
		#print(sv_a)
		
		sv_u = urhk_getFileLocation("COM|directdebitdp005.com")
		print(sv_u)
		
		sv_l = BANCS.OUTPARAM.fileLocation
		
		sv_t = sv_l + "directdebitdp005.com" + " " + BANCS.STDIN.contextBankId + " " + CUST.CDDUM.userPass + " " + CUST.CDDUM.ctlFilePath  + " " + CUST.CDDUM.dataPath + " " + CUST.CDDUM.FileName
		
		PRINT(sv_t)
		sv_a = SYSTEM(sv_t)
		PRINT(sv_a)
		
		IF(sv_a != 0 ) THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^Technical Error - Com file for loading a file^upldFileName")
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#---------------------------------------------------------------------------
		# Updating the user name and orignator code and divides the amount by 100
		#---------------------------------------------------------------------------
		
		sv_s = "UPDATE  CUSTOM.C_KBADDS "
		sv_S = sv_s + " SET Originator_code = ?SVAR "
		sv_s = sv_s + ", RCRE_USER_ID = ?SVAR "
