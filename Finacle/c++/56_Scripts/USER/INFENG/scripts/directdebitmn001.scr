	CALL ("getcparamvalue.scr")
	
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CDDUM.amount = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		#CUST.BILLS.errMsg = "Upload file Path setup not done CPARAM"
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Amount setup not done in CPARAM")
		sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------
	# checking if the upload file exists
	#------------------------------------------------------------
	
	sv_a = "chmod 777 " + CUST.CDDUM.FilePath
	print(sv_a)
	sv_a = "test -f " + CUST.CDDUM.FilePath
	print(sv_a)
	sv_r = SYSTEM(sv_a)
	PRINT(sv_r)
	IF (sv_r != 0) THEN
	#{
		sv_e = "Invalid File Name"
		sv_m = "FileName"
		sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	########################################################################################
	#  validating account number
	########################################################################################
	
	IF ((CUST.CDDUM.Function == "U") AND (CUST.CDDUM.Dracno == "")) THEN
	#{
		sv_e = "Enter Account Number"
		sv_m = "Dracno"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_s)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF (CUST.CDDUM.Dracno != "" ) THEN
	#{
		sv_s = "count|SELECT count(1) "
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE foracid = ?SVAR"
		sv_s = sv_s + " AND del_flg ='N'"
		sv_s = sv_s + " AND entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND acct_cls_flg ='N'"
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CDDUM.Dracno + "|" + BANCS.STDIN.contextBankId
		sv_r = urhk_dbselectWithBind(sv_s)
		print(BANCS.INPARAM.BINDVARS)
		print (sv_r)
		sv_q = BANCS.OUTPARAM.count
		print(sv_q)
		
		IF (sv_q == 0) THEN
		#{
			sv_e = "Invalid account number"
			sv_m = "Dracno"
			sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#############################################################################################
	# Validation of fiele
	################################################################################################
	IF ((CUST.CDDUM.Function == "U") AND (CUST.CDDUM.Test == "")) THEN
	#{
		sv_e = "Test Mode Flag should be entered"
		sv_m = "Test"
		sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
