				#}
			ELSE
				#{
				CUST.CDDUM.ChrgAmt = BANCS.OUTPARAM.OutputAmount
				print(CUST.CDDUM.ChrgAmt)
				
				IF (CUST.CDDUM.ChrgAmt  != "0") THEN
				#{
					print(CUST.CDDUM.ChrgAmt)
					CUST.CDDUM.Chrg_flg = "Y"
					CUST.CDDUM.Chrg_upl_flg = "Y"
					#}
				ELSE
					#{
					print(CUST.CDDUM.ChrgAmt)
					CUST.CDDUM.Chrg_flg = "N"
					CUST.CDDUM.Chrg_upl_flg = "N"
				#}
				ENDIF
			#}
			ENDIF
			
			#####################################################################################
			#The foll step is to Validate Charge code
			####################################################################################
			sv_s = "Count|SELECT count(1) "
			sv_s = sv_s + " FROM TBAADM.RCT  "
			sv_s = sv_s + " WHERE REF_CODE = ?SVAR "
			sv_s = sv_s + " AND ref_rec_type='34' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND del_flg!='Y'"
			BANCS.INPARAM.BINDVARS = CUST.CDDUM.ChargeCode + "|" + BANCS.STDIN.contextBankId
			print(sv_s)
			
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_s)
			
			sv_q = BANCS.OUTPARAM.Count
			print(sv_q)
			
			IF (sv_q == 0) THEN
			#{
				sv_e = "Invalid Charge code"
				sv_m = "ChargeCode"
				sv_s = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_s)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
