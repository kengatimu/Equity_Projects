		#{
			BANCS.INPARAM.InputAmount = CUST.CDDUM.amount
			PRINT(CUST.CDDUM.amount)
			BANCS.INPARAM.CurrencyCode = CUST.CDDUM.crncyCode
			PRINT(CUST.CDDUM.crncyCode)
