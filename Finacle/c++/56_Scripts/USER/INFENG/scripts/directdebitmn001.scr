		sv_s = sv_s + " WHERE bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.CDDUM.Originator + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		sv_d = urhk_dbSQLWithBind(sv_s)
		IF(sv_d == 0 ) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
