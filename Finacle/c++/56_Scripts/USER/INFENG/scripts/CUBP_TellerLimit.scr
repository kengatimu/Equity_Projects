#------------------------------------------------------------------------------------------------
#    Name                        : CUBP_TellerLimit
#    Description     : Main script for check teller balance for CUBP
#    Date            : 25-04-2025
#    Author          : Ayaa Michael
#    Input           : NA
#    Output          : NA
#    Called Script   : CUBP_TellerLimit.scr
#    Calling Script  : SRV_AddCashTran_pre_process_data.scr
#    Menu Option     : CUBP
#    Srl. No                    Date                    Author                  Description.
#    ------                     ----------              -------                 ---------------
#    1.0                        25-04-2025              Ayaa Michael            Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
lv_r = urhk_B2k_PrintRepos("BANCS")
print(lv_r)


#========================================================
# Check whether CUST Repository exists else create it
#========================================================
sv_r = REPEXISTS("CUST")
IF(sv_r == 0) THEN
#{
    CREATEREP ("CUST")
#}
ENDIF
#========================================================
# Check whether UBP Class exists else create it
#========================================================
sv_r = CLASSEXISTS("CUST","UBP")
IF(sv_r == 0) THEN
#{
    CREATECLASS ("CUST","UBP",5)
#}
ENDIF
#========================================================
#Initialization
#========================================================

#--------------------------------------
CUST.UBP.errMsg = ""

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
        CUST.UBP.tran_type = BANCS.OUTPARAM.srvValue
        PRINT(CUST.UBP.tran_type)
#}
ELSE
#{
        CUST.UBP.errMsg = "Error: urhk_SRV_GetVal failed for tran type"
        GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
    CUST.UBP.sub_type = BANCS.OUTPARAM.srvValue
    PRINT(CUST.UBP.sub_type)
#}
ELSE
#{
    CUST.UBP.errMsg = "Error: urhk_SRV_GetVal failed for part tran type"
    GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
        CUST.UBP.noOfRecords = BANCS.OUTPARAM.srvValue
        PRINT(CUST.UBP.noOfRecords)
#}
ELSE
#{
        CUST.UBP.errMsg = "Error:urhk_SRV_NumOfRecs failed"
        GOTO ENDOFSCRIPT
#}
ENDIF

sv_m = 0
sv_a = "\n"
sv_l = 0
PRINT(sv_l)

WHILE(sv_l < CUST.UBP.noOfRecords)
#{
    sv_v = Format$(sv_l,"%d")
    sv_r = "<rec_"+sv_v+">"

    #-------------------------------------------------------------------------------------------
    # Fetch serial num
    #-------------------------------------------------------------------------------------------

    sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
    PRINT(sv_u)
    IF (sv_u == 0) THEN
    #{
            CUST.UBP.serialnum = BANCS.OUTPARAM.srvValue
            PRINT(CUST.UBP.serialnum)
    #}
    ELSE
    #{
            CUST.UBP.errMsg = "Error: urhk_SRV_GetVal failed for serialnum"
            BANCS.OUTPUT.successOrFailure = "F"
            GOTO ENDOFSCRIPT
    #}
    ENDIF

    sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".pTranIdentifier.partTranSrlNum")
    PRINT(sv_u)
    IF (sv_u == 0) THEN
    #{
        CUST.UBP.parttrnNum = BANCS.OUTPARAM.srvValue
        PRINT(CUST.UBP.parttrnNum)
    #}
    ELSE
    #{
        CUST.UBP.errMsg = "Error: urhk_SRV_GetVal failed for serialnum"
        BANCS.OUTPUT.successOrFailure = "F"
        GOTO ENDOFSCRIPT
    #}
    ENDIF

    #-------------------------------------------------------------------------------------------
    # Fetch A/c - foracid
    #-------------------------------------------------------------------------------------------
    sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
    PRINT(sv_u)
    IF (sv_u == 0) THEN
    #{
            CUST.UBP.account = BANCS.OUTPARAM.srvValue
            PRINT(CUST.UBP.account)
    #}
    ELSE
    #{
            CUST.UBP.errMsg = "Error: urhk_SRV_GetVal failed for Account Number"
            BANCS.OUTPUT.successOrFailure = "F"
            GOTO ENDOFSCRIPT
    #}
    ENDIF

    #-------------------------------------------------------------------------------------------
    # Fetch PartTranType
    #-------------------------------------------------------------------------------------------
    sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
    PRINT(sv_u)
    IF (sv_u == 0) THEN
    #{
            CUST.UBP.partTrantype = BANCS.OUTPARAM.srvValue
            PRINT(CUST.UBP.partTrantype)
    #}
    ELSE
    #{
            CUST.UBP.errMsg = "Error: urhk_SRV_GetVal failed for PartTranType"
            BANCS.OUTPUT.successOrFailure = "F"
            GOTO ENDOFSCRIPT
    #}
    ENDIF

    #-------------------------------------------------------------------------------------------
    # Fetch Tran Amount
    #-------------------------------------------------------------------------------------------
    sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".tranAmt")
    PRINT(sv_u)
    IF (sv_u == 0) THEN
    #{
            CUST.UBP.tran_amt = BANCS.OUTPARAM.srvValue
            PRINT(CUST.UBP.tran_amt)
            CUST.UBP.tranAmount = LEFT$(CUST.UBP.tran_amt,GETPOSITION(CUST.UBP.tran_amt,"|") -1 )
            print(CUST.UBP.tranAmount)
    #}
    ELSE
    #{
            CUST.UBP.errMsg = "Error: urhk_SRV_GetVal failed for Ref Amount"
            BANCS.OUTPUT.successOrFailure = "F"
            GOTO ENDOFSCRIPT
    #}
    ENDIF


    sv_l= sv_l+1
#}
DO

IF ((CUST.UBP.tran_type == "C") AND (CUST.UBP.sub_type == "NR")) THEN
#{
    PRINT(CUST.UBP.tran_amt)
    CUST.UBP.tranAmount1 = LEFT$(CUST.UBP.tran_amt,GETPOSITION(CUST.UBP.tran_amt,"|") -1 )
    print(CUST.UBP.tranAmount1)

    CUST.UBP.tranCrncy1 = RIGHT$(CUST.UBP.tran_amt,3)
    print(CUST.UBP.tranCrncy1)

        IF (CUST.UBP.tranCrncy1 != BANCS.STDIN.homeCrncyCode) THEN
        #{
            BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
            BANCS.INPARAM.InputAmount = CUST.UBP.tranAmount1 
            BANCS.INPARAM.FromCurrency = CUST.UBP.tranCrncy1  
            BANCS.INPARAM.RateCode="MEAN" 
            BANCS.INPARAM.Rate=cdouble("0") 
            Sv_r = urhk_B2k_ConvertAmount("")  
            if (sv_r ==1) then  
            #{
                CUST.UBP.errMsg = "A Database error has occured. Please contact your DBA."
                BANCS.OUTPUT.successOrFailure = "F"
                GOTO ENDOFSCRIPT
            #}
            ELSE
            #{
                CUST.UBP.tranAmountUgx = cdouble(BANCS.OUTPARAM.OutputAmount)
                print(CUST.UBP.tranAmountUgx)
            #}
            ENDIF

        #}
        ELSE
        #{
            CUST.UBP.tranAmountUgx = cdouble(CUST.UBP.tranAmount1)
            print(CUST.UBP.tranAmountUgx)
        #}
        ENDIF

        sv_a = "empId,roleId| "
        sv_a = sv_a + "select USER_EMP_ID,ROLE_ID from tbaadm.upr where home_bank_id = ?SVAR "
        sv_a = sv_a + "and sol_id = ?SVAR and del_flg != 'Y' "
        sv_a = sv_a + "and USER_WORK_CLASS = '060' AND user_id = ?SVAR "
        print(sv_a)
        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.userId
        print(BANCS.INPARAM.BINDVARS)

            sv_k = urhk_dbSelectWithBind(sv_a)
            print(sv_k)

            IF (sv_k==0) THEN
            #{
                CUST.UBP.roleId= BANCS.OUTPARAM.roleId
                print(CUST.UBP.roleId)
                CUST.UBP.valueId = CUST.UBP.roleId + BANCS.STDIN.mySolId
                print(CUST.UBP.valueId)
                CUST.UBP.empId= BANCS.OUTPARAM.empId
                print(CUST.UBP.empId)
            #}
            ELSE
            #{
                CUST.UBP.errMsg = "Invalid User Id!"
                GOTO ENDOFSCRIPT
            #}
            ENDIF

            sv_b = "tellerLimit| "
            sv_b = sv_b + "select REF_DESC from tbaadm.rct "
            sv_b = sv_b + "where bank_id = ?SVAR "
            sv_b = sv_b + "and REF_REC_TYPE = 'GW' "
            sv_b = sv_b + "AND LONG_REF_CODE = ?SVAR "
            print(sv_b)
            BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.UBP.valueId
            print(BANCS.INPARAM.BINDVARS)

            sv_j = urhk_dbSelectWithBind(sv_b)
            print(sv_j)

            IF (sv_j==0) THEN
            #{
                CUST.UBP.tellerLimit= BANCS.OUTPARAM.tellerLimit
                print(CUST.UBP.tellerLimit)
            #}
            ELSE
            #{
                CUST.UBP.errMsg = "No Teller Limit maintained for this RoleId!"
                GOTO ENDOFSCRIPT
            #}
            ENDIF

        sv_c = "glBalance, glCrncyCode| "
        sv_c = sv_c + "select clr_bal_amt,acct_crncy_code from tbaadm.gam "
        sv_c = sv_c + "where bank_id = ?SVAR and sol_id = ?SVAR and clr_bal_amt !='0' "
        sv_c = sv_c + "and bacid in (select emp_cash_acct from tbaadm.gec "
        sv_c = sv_c + "where bank_id = ?SVAR and sol_id = ?SVAR and emp_id = ?SVAR) "
        print(sv_c)
        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + CUST.UBP.empId
        print(BANCS.INPARAM.BINDVARS)

        sv_e = urhk_dbCursorOpenWithBind(sv_c)
        print (sv_e)
        
        IF(sv_e==0) THEN
        #{
            CUST.UBP.glBalTotal = cdouble("0")
            print(CUST.UBP.glBalTotal)
            sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
            sv_q = urhk_dbCursorFetch(sv_m)
            PRINT(sv_q)
            
            IF(sv_q == 1) THEN
            #{
                sv_x = urhk_dbCursorClose(sv_m)
                PRINT(sv_x)
                EXITSCRIPT
            #}
            ENDIF
            PRINT(sv_q)
            
            WHILE (sv_q==0)
            #{
                #print(CUST.UBP.glBalTotal)
                CUST.UBP.glBalance= BANCS.OUTPARAM.glBalance
                print(CUST.UBP.glBalance)
                CUST.UBP.glCrncyCode= BANCS.OUTPARAM.glCrncyCode
                print(CUST.UBP.glCrncyCode)


                IF(CUST.UBP.glCrncyCode != BANCS.STDIN.homeCrncyCode) THEN
                #{
                    BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
                    BANCS.INPARAM.InputAmount = CUST.UBP.glBalance 
                    BANCS.INPARAM.FromCurrency = CUST.UBP.glCrncyCode  
                    BANCS.INPARAM.RateCode="MEAN" 
                    BANCS.INPARAM.Rate=cdouble("0") 
                    Sv_r = urhk_B2k_ConvertAmount("")  
                    if (sv_r ==1) then  
                    #{
                        CUST.UBP.errMsg = "A Database error has occured. Please contact your DBA."
                        BANCS.OUTPUT.successOrFailure = "F"
                        GOTO ENDOFSCRIPT
                    #}
                    ELSE
                    #{
                        CUST.UBP.glBalInUgx = cdouble(BANCS.OUTPARAM.OutputAmount)
                        print(CUST.UBP.glBalInUgx)
                    #}
                    ENDIF

                #}
                ELSE
                #{
                    CUST.UBP.glBalInUgx = cdouble(CUST.UBP.glBalance)
                    print(CUST.UBP.glBalInUgx)
                #}
                ENDIF
            CUST.UBP.glBalTotal = cdouble(CUST.UBP.glBalTotal) + cdouble(CUST.UBP.glBalInUgx)
            print (CUST.UBP.glBalTotal)

            sv_q = urhk_dbCursorFetch(sv_m)
            print(sv_q)
            #}
            DO
        #}
        ENDIF

        CUST.UBP.tellerBal = -1 * cdouble(CUST.UBP.glBalTotal)
        PRINT (CUST.UBP.tellerBal)
        ##CUST.UBP.totalBalance = cdouble(CUST.UBP.tranAmountUgx) + cdouble(CUST.UBP.tellerBal)
        ##print(CUST.UBP.totalBalance)
        IF (CUST.UBP.tellerBal > cdouble(CUST.UBP.tellerLimit)) THEN
        #{
            CUST.UBP.errMsg = "Teller Limit Exceeded!!!!!"
            BANCS.OUTPUT.successOrFailure = "F"
            GOTO ENDOFSCRIPT
        #}
        ENDIF
#}        
ENDIF

ENDOFSCRIPT:


IF (CUST.UBP.errMsg != "") THEN
#{
	sv_u = urhk_SRV_SetErr(CUST.UBP.errMsg)
	PRINT(sv_u)
#}
ENDIF

TRACE OFF
END-->

