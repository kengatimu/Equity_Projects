<--start
trace on
#Repos&Classes
        if (repexists("CUST") == 0) then
                createrep("CUST")
        endif
        if (classexists("CUST","CLS") == 0) then
                createclass("CUST","CLS",5)
        endif

CUST.CLS.srvErrMsg = ""
CUST.CLS.srvErrCode = ""
CUST.CLS.srvSucFail = ""
CUST.CLS.valerr    = ""


	IF (CUST.CLS.freezeUnFreeze == "FZ") THEN
		CUST.CLS.freezeCode1 = "OTH"
		CUST.CLS.freezecode = "D"
		CUST.CLS.freezeRemarks1= "SB777 Freeze 30 days"
	ENDIF
        print(CUST.CLS.frezChk)
        if(CUST.CLS.frezChk !=" ")then
                CUST.CLS.modifyYN = "Y"
        endif

        if((CUST.CLS.frezChk=="") or (CUST.CLS.frezChk==" "))then
                CUST.CLS.modifyYN = "N"
        endif

        if(CUST.CLS.freezeUnFreeze=="UZ")then
		sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+CUST.CLS.Foracid)
		sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|N")
		sv_u = urhk_SetUrhkOut("acctFreezeCriteria.freezeCode.code|freezecode")
		sv_u = urhk_SetUrhkOut("acctFreezeCriteria.freezeReason.refCode|freezeReason")
		sv_u = urhk_SetUrhkOut("acctFreezeCriteria.freezeRemarks|freezeRemarks")
		sv_u = urhk_ExecSrv("SRV_FetchAcctsForUnfreeze|same_user_verify=Y|retain_all_output = Y|call_mode = N")
		print(sv_u)
		if(sv_u != "0") then
			CUST.CLS.srvAcctId = CUST.CLS.Foracid
			callscriptifexist("errorCheck.scr")
			CUST.CLS.srvErrMsg = CUST.CLS.SrvError
			CUST.CLS.srvErrCode = "Failed : SRV_FetchAcctsForUnfreeze"
			CUST.CLS.srvSucFail = "F"
			goto VAYU
		else
			CUST.CLS.freezecode = BANCS.OUTPARAM.freezecode
			CUST.CLS.freezeReason = BANCS.OUTPARAM.freezeReason
			CUST.CLS.freezeRemarks = BANCS.OUTPARAM.freezeRemarks
		endif
		if(CUST.CLS.srvSucFail!="F")then
			print(CUST.CLS.freezecode)
			print(CUST.CLS.freezeReason)
			print(CUST.CLS.freezeRemarks)
			sv_u = urhk_copyOutToIn("")
			print(sv_u)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+CUST.CLS.Foracid)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeCode.code|"+CUST.CLS.freezecode)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|N")
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.acctId.foracid|"+CUST.CLS.Foracid)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeCode.code|"+CUST.CLS.freezecode)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeReason.refCode|"+CUST.CLS.freezeReason)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeReason.refCode|"+CUST.CLS.freezeReason)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeRemarks|"+CUST.CLS.freezeRemarks)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeRemarks|"+CUST.CLS.freezeRemarks)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.selFlg|t")
			sv_u = urhk_ExecSrv("SRV_UnFreezeAcctsAutoVerify|same_user_verify=Y|retain_all_output = Y|call_mode = N")
			print(sv_u)
			if ( sv_u != "0" ) then
				CUST.CLS.srvAcctId = CUST.CLS.Foracid
				callscriptifexist("ebsrvHandler.scr")
				CUST.CLS.srvErrMsg = CUST.CLS.SrvError
				CUST.CLS.srvErrCode = "Failed : SRV_UnFreezeAcctsAutoVerify "
				CUST.CLS.srvSucFail = "F"
				goto VAYU
			else
				CUST.CLS.Onvforacid        = CUST.CLS.Foracid
				CUST.CLS.srvErrMsg = "Account UNFreezed and Verified Successfully"
				CUST.CLS.srvSucFail = "S"
				goto VAYU
			endif
		endif
        endif


        if(CUST.CLS.freezeUnFreeze=="FZ")then

		#Freeze Service Inputs
		sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|"+CUST.CLS.modifyYN)
		sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+CUST.CLS.Foracid)
		sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeCode.code|"+CUST.CLS.freezecode)
		sv_u = urhk_ExecSrv("SRV_FetchAcctsForFreeze|same_user_verify=Y|retain_all_output = Y|call_mode = N")
		print(sv_u)
		if(sv_u != "0") then
			CUST.CLS.srvAcctId = CUST.CLS.Foracid
			callscriptifexist("ebsrvHandler.scr")
			CUST.CLS.srvErrMsg = CUST.CLS.SrvError
			CUST.CLS.srvErrCode = "Failed : SRV_FetchAcctsForFreeze| "
			CUST.CLS.srvSucFail = "F"
			goto VAYU
		endif
		IF (CUST.CLS.srvSucFail !="F") Then
			sv_u = urhk_copyOutToIn("")
			print(sv_u)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.acctId.foracid|"+CUST.CLS.Foracid)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeCode.code|"+CUST.CLS.freezecode)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.modFreezeInd|"+CUST.CLS.modifyYN)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.acctId.foracid|"+CUST.CLS.Foracid)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeCode.code|"+CUST.CLS.freezecode)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeReason.refCode|"+CUST.CLS.freezeCode1)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeReason.refCode|"+CUST.CLS.freezeCode1)
			sv_u = urhk_SetUrhkInp("acctFreezeCriteria.freezeRemarks|"+CUST.CLS.freezeRemarks1)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.freezeRemarks|"+CUST.CLS.freezeRemarks1)
			sv_u = urhk_SetUrhkInp("acctFreezeLL.<rec_0>.selFlg|t")
			sv_u = urhk_ExecSrv("SRV_FreezeAcctsAutoVerify|same_user_verify=Y|retain_all_output = Y|call_mode = N")
			print(sv_u)
			if ( sv_u != "0" ) then
				CUST.CLS.srvAcctId = CUST.CLS.Foracid
				callscriptifexist("ebsrvHandler.scr")
				CUST.CLS.srvErrMsg = CUST.CLS.SrvError
				CUST.CLS.srvErrCode = "Failed : SRV_FreezeAcctsAutoVerify "
				CUST.CLS.srvSucFail = "F"
				goto VAYU
			else
				CUST.CLS.Onvforacid        = CUST.CLS.Foracid
				CUST.CLS.srvErrMsg = "Account Frozen and Verified Successfully"
				CUST.CLS.srvSucFail = "S"
				goto VAYU
			endif
		ENDIF
        endif
VAYU:
exitscript
end-->
