		    ### END CA214,CA232

						
		    ###################### ADDED MAWAZO FOR PREMIUM CA251,SB151 ##############################
                        IF ((CUST.GCHRG.acctCrncy == "UGX") AND ((CASH.WITH.schmCode == "CA251") OR (CUST.GCHRG.schmCode == "SB151"))) THEN
