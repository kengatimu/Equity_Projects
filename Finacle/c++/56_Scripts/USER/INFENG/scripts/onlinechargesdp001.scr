                                    sv_q = sv_q + " TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') and acid in (select acid from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR) "
                                    print(sv_q)
                                    BANCS.INPARAM.BINDVARS = CUST.GCHRG.acctCrncy +"|"+ BANCS.STDIN.contextBankId +"|"+ MID$(BANCS.STDIN.BODDate,0,10) +"|"+ CASH.WITH.ac_num +"|"+ BANCS.STDIN.contextBankId
                                    print(BANCS.INPARAM.BINDVARS)
                                    sv_c = urhk_dbSelectWithBind(sv_q)
                                    PRINT(sv_c)
                                    IF(sv_c == 0)THEN
                                    #{
                                        CUST.GCHRG.totDbsum = BANCS.OUTPARAM.totamt
                                        print(CUST.GCHRG.totDbsum)
                                        #--Total dbSum before this withdrawal
                                        CUST.GCHRG.totamt = CDOUBLE(CUST.GCHRG.totDbsum) - CDOUBLE(CASH.WITH.tran_amt)
                                        print(CUST.GCHRG.totamt)
                                        #--- Convert amount to USD for other currencies
                                        IF( CUST.GCHRG.acctCrncy != "USD")THEN
                                        #{
                                            #Convert transacting amount
                                            BANCS.INPARAM.InputAmount  = CASH.WITH.tran_amt
                                            BANCS.INPARAM.FromCurrency = CUST.GCHRG.acctCrncy
                                            BANCS.INPARAM.ToCurrency   = "USD"
                                            BANCS.INPARAM.RateCode     = CUST.GCHRG.toUsdCode
                                            BANCS.INPARAM.Rate         = ""
                                            sv_z=urhk_B2k_ConvertAmount("")
                                            print(sv_z)
                                            IF(sv_z == 0)THEN
                                            #{
                                                CASH.WITH.tran_amt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                                print(CASH.WITH.tran_amt)
                                            ELSE  
                                                exitscript
                                            #}
                                            ENDIF
                                            IF( CDOUBLE(CUST.GCHRG.totamt) > 0 )THEN
                                            #{
                                                #CONVERT dbsum 
                                                BANCS.INPARAM.InputAmount  = CUST.GCHRG.totamt
                                                BANCS.INPARAM.FromCurrency = CUST.GCHRG.acctCrncy
                                                BANCS.INPARAM.ToCurrency   = "USD"
                                                BANCS.INPARAM.RateCode     = CUST.GCHRG.toUsdCode
                                                BANCS.INPARAM.Rate         = ""

                                                sv_z=urhk_B2k_ConvertAmount("")
                                                print(sv_z)
                                                IF(sv_z == 0)THEN
                                                #{
                                                    CUST.GCHRG.totamt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                                    print(CUST.GCHRG.totamt)
                                                ELSE 
                                                    exitscript
                                                #}
                                                ENDIF
                                            #}
                                            ENDIF 
                                        #}
                                        ENDIF 

                                        #--- CASE 1 when dbsum greater than limitAmt - charge 0.3 0f current tran amount
                                        IF( CDOUBLE(CUST.GCHRG.totamt) > CDOUBLE(CUST.GCHRG.limitAmt) )THEN
                                        #{
                                            print("dbsum greater than limitAmt.Customer Eligible for charge.")
                                            IF( (CUST.GCHRG.acctCrncy != "USD") AND CDOUBLE(CASH.WITH.tran_amt) > 0 )THEN
                                            #{
                                                #-- Convert amount to acctCrncy
                                                BANCS.INPARAM.InputAmount  = CASH.WITH.tran_amt
                                                BANCS.INPARAM.FromCurrency = "USD"
                                                BANCS.INPARAM.ToCurrency   = CUST.GCHRG.acctCrncy
                                                BANCS.INPARAM.RateCode     = CUST.GCHRG.fromUsdCode
                                                BANCS.INPARAM.Rate         = ""

                                                sv_z=urhk_B2k_ConvertAmount("")
                                                print(sv_z)
                                                IF(sv_z == 0)THEN
                                                #{
                                                    CASH.WITH.tran_amt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                                    print(CASH.WITH.tran_amt)
                                                ELSE 
                                                    exitscript
                                                #}
                                                ENDIF
                                            #}
                                            ENDIF 
                                            CUST.GCHRG.limitChrgFlg = "Y"
                                            CUST.GCHRG.xcessAmt = CASH.WITH.tran_amt
                                            print(CUST.GCHRG.xcessAmt)
                                        ELSE 
                                            #CASE 2 when dbsum less than limitAmt - sum the current tran amount and dbsum
                                            print("summing tranAmount and dbsum")
                                            CUST.GCHRG.totSum  = CDOUBLE(CASH.WITH.tran_amt) + CDOUBLE(CUST.GCHRG.totamt)
                                            print(CUST.GCHRG.totSum)

                                            #CASE 2.1 check whether customer is eligible for charge
                                            IF( CDOUBLE(CUST.GCHRG.totSum) > CDOUBLE(CUST.GCHRG.limitAmt) )THEN
                                            #{
                                                print("customer elligible for charge. Getting excess amount")
                                                CUST.GCHRG.xcessAmt = CDOUBLE(CUST.GCHRG.totSum) - CDOUBLE(CUST.GCHRG.limitAmt)
                                                #Convert amount to acctCrncy from USD 
                                                IF( (CUST.GCHRG.acctCrncy != "USD") AND CDOUBLE(CUST.GCHRG.xcessAmt) > 0 )THEN
                                                #{
                                                    BANCS.INPARAM.InputAmount  = CUST.GCHRG.xcessAmt
                                                    BANCS.INPARAM.FromCurrency = "USD"
                                                    BANCS.INPARAM.ToCurrency   = CUST.GCHRG.acctCrncy
                                                    BANCS.INPARAM.RateCode     = CUST.GCHRG.fromUsdCode
                                                    BANCS.INPARAM.Rate         = ""
                                                    sv_z=urhk_B2k_ConvertAmount("")
                                                    print(sv_z)
                                                    IF(sv_z == 0)THEN
                                                    #{
                                                        CUST.GCHRG.xcessAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                                        print(CUST.GCHRG.xcessAmt)
                                                    ELSE 
                                                        exitscript
                                                    #}
                                                    ENDIF
                                                #}
                                                ENDIF 
                                                print(CUST.GCHRG.xcessAmt)
                                                CUST.GCHRG.limitChrgFlg = "Y"
                                            ELSE 
                                                CUST.GCHRG.limitChrgFlg = "N"
                                            #}
                                            ENDIF 
                                        #}
                                        ENDIF
                                    ELSE 
                                        print("Error occured fetching record.Exiting script")
                                        exitscript
                                    #}
                                    ENDIF

                                    IF( (CDOUBLE(CUST.GCHRG.xcessAmt) > 0) AND (CUST.GCHRG.limitChrgFlg == "Y") )THEN
                                    #{
                                        CUST.GCHRG.calcChrg = (CDOUBLE(CUST.GCHRG.xcessAmt) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
                                        print(CUST.GCHRG.calcChrg)
                                        BANCS.INPARAM.InputAmount  = CUST.GCHRG.calcChrg
                                        BANCS.INPARAM.FromCurrency = CUST.GCHRG.acctCrncy
                                        BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode
                                        BANCS.INPARAM.RateCode     = CUST.GCHRG.toHomeCode
                                        BANCS.INPARAM.Rate         = ""
                                        sv_z=urhk_B2k_ConvertAmount("")
                                        IF(sv_z == 0)THEN
                                            CUST.GCHRG.convAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                            print(CUST.GCHRG.convAmt)
                                        ELSE 
                                            exitscript
                                        ENDIF
                                        CUST.GCHRG.chrgAmt = CUST.GCHRG.convAmt + "|" + BANCS.STDIN.homeCrncyCode
                                        print(CUST.GCHRG.chrgAmt)
                                        CUST.GCHRG.eventId = CUST.CPARAM.supWdEvt
                                        CALL("ChargeLien.scr")
                                        CALL("gchrgcommon.scr")
                                    #}
                                    ENDIF
                                ELSE
                                    print("No for charge")
                                #}
                                ENDIF
                            ELSE
                                #NON-SUPREME CUSTOMER Check the teller     
                                IF(BANCS.STDIN.roleId == "STL")THEN
                                #{
                                    print("Customer served by Supreme teller")
                                    CUST.GCHRG.supChrgFlg = "Y"
                                    CASH.WITH.tran_amt = LEFT$(CASH.WITH.tran_amt,GETPOSITION(CASH.WITH.tran_amt,"|") -1 )
                                    print(CASH.WITH.tran_amt)
                                    CUST.GCHRG.eventId = CUST.CPARAM.nonSupChrgEvent
                                    CUST.GCHRG.chrgAmt = CUST.CPARAM.nonSupCustChrg + "|" + BANCS.STDIN.homeCrncyCode
                                    CALL("ChargeLien.scr")
                                    CALL("gchrgcommon.scr")
                                    IF( (CUST.GCHRG.acctCrncy == "USD") OR (CUST.GCHRG.acctCrncy == "GBP") OR (CUST.GCHRG.acctCrncy == "EUR") OR (CUST.GCHRG.acctCrncy == "KES"))THEN
                                    #{
                                        IF( CUST.GCHRG.acctCrncy != "USD")THEN
                                        #{
                                            BANCS.INPARAM.InputAmount  = CASH.WITH.tran_amt
                                            BANCS.INPARAM.FromCurrency = CUST.GCHRG.acctCrncy
                                            BANCS.INPARAM.ToCurrency   = "USD"
                                            BANCS.INPARAM.RateCode     = CUST.GCHRG.toUsdCode
                                            BANCS.INPARAM.Rate         = ""
                                            sv_z=urhk_B2k_ConvertAmount("")
                                            print(sv_z)
                                            IF(sv_z == 0)THEN
                                            #{
                                                CASH.WITH.tranAmtUSD = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                                print(CASH.WITH.tranAmtUSD)
                                            ELSE 
                                                exitscript
                                            #}
                                            ENDIF
                                        ELSE 
                                            CASH.WITH.tranAmtUSD = CASH.WITH.tran_amt
                                        #}
                                        ENDIF 
                                        CUST.GCHRG.chrgUSD = (CDOUBLE(CASH.WITH.tranAmtUSD) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
                                        print(CUST.GCHRG.chrgUSD)
                                        IF( CDOUBLE(CASH.WITH.tran_amt) > 0 )THEN
                                        #{
                                            call("onlinechargesfx001.scr")        
                                        #}
                                        ENDIF
                                    #}
                                    ENDIF
                                ELSE
                                    print("Non Supreme Customer served by retail teller. No supreme charges")
                                    CUST.GCHRG.supChrgFlg = "Y"
                                    CASH.WITH.tran_amt = LEFT$(CASH.WITH.tran_amt,GETPOSITION(CASH.WITH.tran_amt,"|") -1 )
                                    print(CASH.WITH.tran_amt)
                                    IF( (CUST.GCHRG.acctCrncy == "USD") OR (CUST.GCHRG.acctCrncy == "GBP") OR (CUST.GCHRG.acctCrncy == "EUR") OR (CUST.GCHRG.acctCrncy == "KES"))THEN
                                    #{
                                        IF( CUST.GCHRG.acctCrncy != "USD")THEN
                                        #{  
                                            BANCS.INPARAM.InputAmount  = CASH.WITH.tran_amt
                                            BANCS.INPARAM.FromCurrency = CUST.GCHRG.acctCrncy
                                            BANCS.INPARAM.ToCurrency   = "USD"
                                            BANCS.INPARAM.RateCode     = CUST.GCHRG.toUsdCode
                                            BANCS.INPARAM.Rate         = ""
                                            sv_z=urhk_B2k_ConvertAmount("")
                                            print(sv_z)
                                            IF(sv_z == 0)THEN
                                            #{
                                                CASH.WITH.tranAmtUSD = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                                print(CASH.WITH.tranAmtUSD)
                                            ELSE 
                                                exitscript
                                            #}
                                            ENDIF
                                        ELSE 
                                            CASH.WITH.tranAmtUSD = CASH.WITH.tran_amt
                                        #}
                                        ENDIF 

                                        CUST.GCHRG.chrgUSD = (CDOUBLE(CASH.WITH.tranAmtUSD) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
                                        print(CUST.GCHRG.chrgUSD)

                                        IF( CDOUBLE(CASH.WITH.tran_amt) > 0 )THEN
                                        #{
											call("onlinechargesfx001.scr")
                                        #}
                                        ENDIF
                                    #}
                                    ENDIF
                                #}
                                ENDIF
                            #}
                            ENDIF
                        #}
                        ENDIF
                        ## charge for UGX
                        #Local Currency withdrawal above the limit
                        if((CUST.GCHRG.acctCrncy == "UGX") AND (CASH.WITH.schmCode != "CA232") AND (CASH.WITH.schmCode != "CA214") AND (CASH.WITH.schmCode != "SB102") AND (CASH.WITH.schmCode != "CA217") AND (CUST.GCHRG.schmCode != "SB188") AND (CUST.GCHRG.schmCode != "CA286") AND (CUST.GCHRG.schmCode != "CA288") AND (CUST.GCHRG.schmCode != "CA251") AND (CUST.GCHRG.schmCode != "SB151"))THEN
                        #{
                            CUST.GCHRG.check = GETPOSITION(CASH.WITH.tran_amt,"|")
                            print(CUST.GCHRG.check)
                            IF(CUST.GCHRG.check > 0)THEN
                            #{
                                CASH.WITH.tran_amt = LEFT$(CASH.WITH.tran_amt,GETPOSITION(CASH.WITH.tran_amt,"|") -1 )
                            #}
                            ENDIF
                            sv_a = "chrgAmt|"
                            sv_a = sv_a + "SELECT  nvl(CHARGE_AMOUNT,'0') "
                            sv_a = sv_a + "from CUSTOM.NON_SUP_WD_TIER  "
                            sv_a = sv_a + "WHERE  '"+CASH.WITH.tran_amt+"' BETWEEN FROM_AMOUNT and TO_AMOUNT "
                            sv_a = sv_a + "AND BANK_ID = '"+BANCS.STDIN.contextBankId+"' "
                            print(sv_a)
                            sv_q = urhk_dbSelectWithBind(sv_a)
                            print(sv_q)
                            IF (sv_q == "0") THEN
                            #{
                                CUST.GCHRG.chrgAmt = BANCS.OUTPARAM.chrgAmt
                                print(CUST.GCHRG.chrgAmt)
                                CUST.GCHRG.chrgAmt = CUST.GCHRG.chrgAmt + "|" + BANCS.STDIN.homeCrncyCode
                                CUST.GCHRG.eventId = CUST.CPARAM.nonSupWdEvt
                                CALL("ChargeLien.scr")
                                CALL("gchrgcommon.scr")
                            #}
                            else
                            #{
                                CUST.GCHRG.chrgAmt= "0"
                                exitscript
                            #}
                            ENDIF
                        #}
                        ENDIF

                        ###################### ADDED MAWAZO/HARRISON FOR RELIGIOUS CA217 ##############################
                        IF ((CUST.GCHRG.acctCrncy == "UGX") AND (CASH.WITH.schmCode == "CA217")) THEN
                        #{
                            BANCS.INPARAM.InputAmount = LEFT$(CASH.WITH.tran_amt,GETPOSITION(CASH.WITH.tran_amt,"|") -1 )
                            BANCS.INPARAM.CurrencyCode = CUST.GCHRG.acctCrncy
                            BANCS.INPARAM.AmountTableCode="CA217"
                            PRINT(BANCS.INPARAM.AmountTableCode)
                            
                            sv_u = urhk_B2k_GetASTMAmount ("") 
                            IF (sv_u == 1) THEN
                            #{
                                CASH.WITH.errMsg = "Invalid AmountTableCode"
                                #GOTO ENDOFSCRIPT #HARRISON
                            #}             
                            ENDIF
                            sv_q = BANCS.OUTPARAM.OutputAmount
                            PRINT(sv_q)

                            CASH.WITH.CA217 = sv_q
                            PRINT(CASH.WITH.CA217)
                            CUST.GCHRG.chrgAmt = CASH.WITH.CA217 + "|" + BANCS.STDIN.homeCrncyCode
                            CUST.GCHRG.eventId = CUST.CPARAM.nonSupWdEvt
                            CALL("ChargeLien.scr")
                            CALL("gchrgcommon.scr")
                        #}
                        ENDIF
                        ###################### END RELIGIOUS ##################################################

		    ### Mawazo SB102
                        IF ((CUST.GCHRG.acctCrncy == "UGX") AND (CASH.WITH.schmCode == "SB102")) THEN
                        #{
                                print("We are here")
                                CALL("SB102_otccharges.scr")
                        #}
                        ENDIF	
		    ### END SB102
						
		    ### Mawazo CA214,CA232
                        IF ((CUST.GCHRG.acctCrncy == "UGX") AND ((CASH.WITH.schmCode == "CA214") OR (CUST.GCHRG.schmCode == "CA232"))) THEN
                        #{
                                print("We are here")
                                CALL("SACCO_otccharges.scr")
                        #}
                        ENDIF	
		    ### END CA214,CA232
						
		    ###################### ADDED MAWAZO FOR PREMIUM CA251,SB151 ##############################
                        IF ((CUST.GCHRG.acctCrncy == "UGX") AND ((CASH.WITH.schmCode == "CA251") OR (CUST.GCHRG.schmCode == "SB151"))) THEN
                        #{
                        	PRINT(CASH.WITH.tran_amt)
                            BANCS.INPARAM.InputAmount = LEFT$(CASH.WITH.tran_amt,GETPOSITION(CASH.WITH.tran_amt,"|") -1 )
                            BANCS.INPARAM.CurrencyCode = CUST.GCHRG.acctCrncy
                            IF(CASH.WITH.tran_amt > CDOUBLE(CUST.CPARAM.premiumlimit)) THEN
				CASH.WITH.PREMI = CUST.CPARAM.premiumchrg
		        ELSE 
				CASH.WITH.PREMI = CUST.CPARAM.premiumminchrg
		        ENDIF
							
		        CASH.WITH.PREMI = CDOUBLE(CASH.WITH.PREMI)
                            PRINT(CASH.WITH.PREMI)
                            CUST.GCHRG.chrgAmt = CASH.WITH.PREMI + "|" + BANCS.STDIN.homeCrncyCode
                            CUST.GCHRG.eventId = CUST.CPARAM.nonSupWdEvt
                            CALL("ChargeLien.scr")
                            CALL("gchrgcommon.scr")
                        #}
                        ENDIF
		###################### END PREMIUM ##################################################

                    #}
                    ENDIF
                ELSE 
                    PRINT("Failure in fetchig acct details")
                    CALL("ChargeLien.scr")
                    CALL("gchrgcommon.scr")
                #}
                ENDIF
            ELSE
                CALL("ChargeLien.scr")
                CALL("gchrgcommon.scr")
            #}
            ENDIF
            
            #---HARRISON SUPREME/NON SUPREME CUSTOMER END

            IF (CUST.GCHRG.successOrFailure == "S") THEN
            #{
                PRINT("Charge collected")
            #}
            ELSE
            #{
                PRINT("Failure")
            #}
            ENDIF           
        #} 
        ENDIF
    
        #--------------------------------------------------
        # Income To cashwith stamp chrg Account
        #--------------------------------------------------
    
        #IF (CASH.WITH.Stmp_Flg == "Y") THEN
        #{
        #   PRINT(COLL.GLBDATA.stmpevent)
        #   #CUST.GCHRG.eventId = "TMSTMP1"
        #   CUST.GCHRG.eventId = COLL.GLBDATA.stmpevent
        #   CALL("gchrgcommon.scr")
        #   IF (CUST.GCHRG.successOrFailure == "S") THEN
        #   #{
        #       PRINT("Charge collected")
        #   #}
        #   ELSE
        #   #{
        #       PRINT("Failure")
        #   #}
        #   ENDIF       
        #}
        #ENDIF
    
        #--------------------------------------------------
        # Income To shadow balance chrg Account(Script based)
        #--------------------------------------------------
    
        IF (CASH.WITH.Shd_Flg == "Y") THEN
        #{
            CUST.GCHRG.chrgAmt = CASH.WITH.Shd_Amt + "|" + BANCS.STDIN.homeCrncyCode
            PRINT(COLL.GLBDATA.shdwevent)
            #CUST.GCHRG.eventId = "TMSHDW1"
            CUST.GCHRG.eventId = COLL.GLBDATA.shdwevent
            CALL("gchrgcommon.scr")
            IF (CUST.GCHRG.successOrFailure == "S") THEN
            #{
                PRINT("Charge collected")
            #}
            ELSE
            #{
                PRINT("Failure")
            #}
            ENDIF       
        #}
        ENDIF
    
        #--------------------------------------------------
        # Income To MinBal chrg Account(Script based)
        #--------------------------------------------------
    
        IF (CASH.WITH.Min_Flg == "Y") THEN
        #{
            CUST.GCHRG.chrgAmt = CASH.WITH.Min_Amt + "|" + BANCS.STDIN.homeCrncyCode
            PRINT(COLL.GLBDATA.minevent)
            #CUST.GCHRG.eventId = "TMMIN1"
            CUST.GCHRG.eventId = COLL.GLBDATA.minevent
            CALL("gchrgcommon.scr")
            IF (CUST.GCHRG.successOrFailure == "S") THEN
            #{
                PRINT("Charge collected")
            #}
            ELSE
            #{
                PRINT("Failure")
            #}
            ENDIF   
        #}
        ENDIF
    #}
    ENDIF
#}
ENDIF

