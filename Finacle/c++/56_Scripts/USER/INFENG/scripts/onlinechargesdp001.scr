                        #}
                        ELSE
                        #{
                            CASH.WITH.RRate = "1"
                        #}
                        ENDIF
                        #sv_n ="10000" 
                        sv_n ="0" #HARRISON
                        sv_k =cdouble(sv_n) * cdouble(CASH.WITH.RRate)
                        CASH.WITH.tran_amt = cdouble(CASH.WITH.tran_amt) - (sv_k)
                        BANCS.INPARAM.InputAmount=CASH.WITH.tran_amt
                        BANCS.INPARAM.RoundOffAmt=.5
                        BANCS.INPARAM.RoundOffFlag="N"
                        sv_u=urhk_B2k_Roundoff("")
                        IF (sv_u  == 0) THEN
                            CASH.WITH.tran_amt = BANCS.OUTPARAM.OutputAmount
                            CASH.WITH.tran_amt = cint(CASH.WITH.tran_amt)
                        ENDIF
                        print(CASH.WITH.tran_amt)
                    ENDIF
                ENDIF
                
                sv_p = CASH.WITH.tran_amt 
                BANCS.INPARAM.InputAmount = sv_p 
