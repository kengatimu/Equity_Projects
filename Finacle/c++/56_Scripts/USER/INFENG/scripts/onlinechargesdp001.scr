                                CUST.GCHRG.chrgAmt = BANCS.OUTPARAM.chrgAmt
                                print(CUST.GCHRG.chrgAmt)
                                CUST.GCHRG.chrgAmt = CUST.GCHRG.chrgAmt + "|" + BANCS.STDIN.homeCrncyCode
                                CUST.GCHRG.eventId = CUST.CPARAM.nonSupWdEvt
