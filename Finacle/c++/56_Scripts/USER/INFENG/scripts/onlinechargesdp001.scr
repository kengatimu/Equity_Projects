                    PRINT(lv_s)
                    BANCS.INPARAM.BINDVARS = CUST.GCHRG.fromCrncy + "|" + CUST.GCHRG.toCrncy + "|" + BANCS.STDIN.contextBankId
                    PRINT(BANCS.INPARAM.BINDVARS)
