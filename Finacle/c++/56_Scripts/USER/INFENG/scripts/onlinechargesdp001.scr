                            CUST.GCHRG.eventId = CUST.CPARAM.nonSupWdEvt
                            CALL("ChargeLien.scr")
                            CALL("gchrgcommon.scr")
                        #}
                        ENDIF
                        ###################### END RELIGIOUS ##################################################

		    ### Mawazo SB102
