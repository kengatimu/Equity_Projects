                    CUST.GCHRG.toCrncy = BANCS.STDIN.homeCrncyCode
                    lv_s = "ratecode | select RATECODE_TRAN  from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
                    PRINT(lv_s)
                    BANCS.INPARAM.BINDVARS = CUST.GCHRG.fromCrncy + "|" + CUST.GCHRG.toCrncy + "|" + BANCS.STDIN.contextBankId
