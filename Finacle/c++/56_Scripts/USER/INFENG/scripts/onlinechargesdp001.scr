IF (FIELDEXISTS(CASH.WITH.type) AND FIELDEXISTS(CASH.WITH.stype)) THEN
#{      
    PRINT(CASH.WITH.type)
    PRINT(CASH.WITH.stype)
    PRINT(BANCS.STDIN.mySolId)
    PRINT(CUST.CPARAM.mySolId1)

    IF (BANCS.STDIN.contextBankId == "56") THEN
    #{
        IF ((CASH.WITH.type == "T") AND (CASH.WITH.stype == "CI") AND (BANCS.STDIN.mySolId != CUST.CPARAM.mySolId1)) THEN
        #{


            sv_s = "owner,schmtype|"
            sv_s = sv_s + " SELECT GAM.acct_ownership,GAM.schm_type"
            sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
            sv_s = sv_s + " WHERE GAM.acid = DTD.acid"
            sv_s = sv_s + " AND DTD.tran_id = LPAD(?SVAR,9)"
            sv_s = sv_s + " AND DTD.part_tran_type='C'"
            sv_s = sv_s + " AND DTD.del_flg != 'Y'"
            sv_s = sv_s + " AND GAM.bank_id = DTD.bank_id"
            #sv_s = sv_s + " AND part_tran_srl_num = LPAD(?SVAR,4) "
            sv_s = sv_s + " AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
            sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
            sv_s = sv_s + " AND rownum < 2"
            print(sv_s)
            #BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.parttrnNum + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
            BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
            PRINT(BANCS.INPARAM.BINDVARS)
            sv_d=urhk_dbSelectWithBind(sv_s)
            print(sv_d)
            IF (sv_d != 0) THEN
            #{
                CUST.TMCHRG.errMMsg = "Error in selecting records"
                GOTO ENDOFSCRIPT
                #}
            ELSE
                #{
                CASH.WITH.nocharge = BANCS.OUTPARAM.owner
                CASH.WITH.stype = BANCS.OUTPARAM.schmtype
                print(CASH.WITH.nocharge)
                print(CASH.WITH.stype)

            #}
            ENDIF
            
            IF ((CASH.WITH.Trf_Flg == "Y") AND ((CASH.WITH.stype == "CAA") OR (CASH.WITH.stype == "SBA")))THEN
            #{
                #CASH.WITH.tfee = "55"
                #Changes done as per porting3
                CASH.WITH.tfee = "1500"
                print(CASH.WITH.tfee)
            

                IF (CASH.WITH.schmCode == "CA217") then
                    CASH.WITH.tfee = "2600"
                    print(CASH.WITH.tfee)
                ENDIF   

                CASH.WITH.negat ="-1"
                CASH.WITH.Tot_Amt = cdouble(CASH.WITH.tfee)* cdouble(CASH.WITH.negat)
                CASH.WITH.with_amt = CASH.WITH.tfee
                print (CASH.WITH.Tot_Amt)
                print (CASH.WITH.with_amt)
                #CALL("trfchargedp001.scr")
                
                CUST.GCHRG.tranType = "T"
                CUST.GCHRG.tranSubType = "BI"
                CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
                CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
                CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
                PRINT(COLL.GLBDATA.trfevent)
                #CUST.GCHRG.eventId = "TMTRF1"
                CUST.GCHRG.eventId = COLL.GLBDATA.trfevent
                CALL("gchrgcommon.scr")
                IF (CUST.GCHRG.successOrFailure == "S") THEN
                #{
                    PRINT("Charge collected")
                    #}
                ELSE
                    #{
                    PRINT("Failure")
                #}
                ENDIF
                #}
            ELSE
                #{

                CASH.WITH.Tot_Amt = "0"

            #}
            ENDIF
            #}
        ELSE
            #{

            CASH.WITH.Tot_Amt = "0"

        #}
        ENDIF

        IF ((CASH.WITH.type == "C") AND (CASH.WITH.stype == "NR")) THEN
        #{
            sv_a = urhk_getAcctDetailsInRepository(CASH.WITH.ac_num)
            print(sv_a)

            IF(sv_a == 0)THEN
            #{
                CUST.GCHRG.schmCode = BANCS.OUTPARAM.schmCode
                CUST.GCHRG.acctCrncy = BANCS.OUTPARAM.acctCrncyCode
                CUST.GCHRG.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
                IF(CUST.GCHRG.acctOwnerShip != "O")THEN
                #{
                    CUST.GCHRG.tranType = "T"
                    CUST.GCHRG.tranSubType = "BI"
                    CUST.GCHRG.drAcctId = CASH.WITH.ac_num
                    CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
                    CUST.GCHRG.eventId = CUST.CPARAM.supDepChrgEvent
                    CUST.GCHRG.limitAmt = "0"
                    CUST.GCHRG.limitChrgFlg = "N"
                    CUST.GCHRG.crAmt = CASH.WITH.tran_amt

                    sv_c =  GETPOSITION(CUST.GCHRG.crAmt, "|") - 1
                    sv_b = MID$(CUST.GCHRG.crAmt,0,sv_c)
                    CUST.GCHRG.crAmt = sv_b

                    CASH.WITH.tran_amt = CUST.GCHRG.crAmt 
                    CUST.GCHRG.chrgFlg = ""
                    CUST.GCHRG.xcessAmt = "0"

                    IF (CUST.GCHRG.acctCrncy == "USD")THEN
                    #{
                        CUST.GCHRG.limitAmt = CUST.CPARAM.limUSD
                    #}
                    ENDIF
                    IF (CUST.GCHRG.acctCrncy == "KES")THEN
                    #{
                        CUST.GCHRG.limitAmt = CUST.CPARAM.limKES
                    #}
                    ENDIF
                    IF (CUST.GCHRG.acctCrncy == "EUR")THEN
                    #{
                        CUST.GCHRG.limitAmt = CUST.CPARAM.limEUR
                    #}
                    ENDIF
                    IF (CUST.GCHRG.acctCrncy == "GBP")THEN
                    #{
                        CUST.GCHRG.limitAmt = CUST.CPARAM.limGBP
                    #}
                    ENDIF

                    IF( (CUST.GCHRG.acctCrncy == "USD") OR (CUST.GCHRG.acctCrncy == "KES") OR (CUST.GCHRG.acctCrncy == "EUR") OR (CUST.GCHRG.acctCrncy == "GBP") )THEN
                    #{

                        sv_q = "totamt |select case when sum(REF_AMT) is null then 0 else sum (REF_AMT)  end total  from tbaadm.dtd WHERE "
                        sv_q = sv_q + " REF_CRNCY_CODE=?SVAR and tran_sub_type = 'NR' and PART_TRAN_TYPE ='C' and TRAN_TYPE='C' and PSTD_FLG='Y' and DEL_FLG='N' and BANK_ID=?SVAR and "
                        sv_q = sv_q + " TRAN_DATE = TO_DATE(?SVAR,'DD-MM-YYYY') and acid in (select acid from tbaadm.gam where foracid=?SVAR and bank_id=?SVAR) "
                        print(sv_q)
                        BANCS.INPARAM.BINDVARS = CUST.GCHRG.acctCrncy +"|"+ BANCS.STDIN.contextBankId +"|"+ MID$(BANCS.STDIN.BODDate,0,10) +"|"+ CASH.WITH.ac_num +"|"+ BANCS.STDIN.contextBankId
                        print(BANCS.INPARAM.BINDVARS)
                        sv_c = urhk_dbSelectWithBind(sv_q)
                        PRINT(sv_c)
                        IF(sv_c == 0)THEN
                        #{
                            CUST.GCHRG.totDbsum = BANCS.OUTPARAM.totamt
                            print(CUST.GCHRG.totDbsum)
                            #--Total dbSum before this deposit
                            CUST.GCHRG.totamt = CDOUBLE(CUST.GCHRG.totDbsum) - CDOUBLE(CUST.GCHRG.crAmt)
                            print(CUST.GCHRG.totamt)
                            #--- CASE 1 when dbsum greater than limitAmt - charge 0.3 0f current tran amount
                            IF( CDOUBLE(CUST.GCHRG.totamt) > CDOUBLE(CUST.GCHRG.limitAmt) )THEN
                            #{
                                print("dbsum greater than limitAmt.Customer Eligible for charge. Getting excess amount")
                                CUST.GCHRG.limitChrgFlg = "Y"
                                CUST.GCHRG.xcessAmt = CUST.GCHRG.crAmt
                                print(CUST.GCHRG.xcessAmt)
                            ELSE 
                                #--- CASE 2 when dbsum less than limitAmt - sum the current tran amount and dbsum
                                print("summing tranAmount and dbsum")
                                CUST.GCHRG.totSum  = CDOUBLE(CUST.GCHRG.crAmt) + CDOUBLE(CUST.GCHRG.totamt)
                                print(CUST.GCHRG.totSum)

                                #--- CASE 2.1 check whether customer is eligible for charge
                                IF( CDOUBLE(CUST.GCHRG.totSum) > CDOUBLE(CUST.GCHRG.limitAmt) )THEN
                                #{
                                    print("customer elligible for charge. Getting excess amount")
                                    CUST.GCHRG.xcessAmt = CDOUBLE(CUST.GCHRG.totSum) - CDOUBLE(CUST.GCHRG.limitAmt)
                                    print(CUST.GCHRG.xcessAmt)
                                    CUST.GCHRG.limitChrgFlg = "Y"
                                ELSE 
                                    CUST.GCHRG.limitChrgFlg = "N"
                                #}
                                ENDIF 
                            #}
                            ENDIF
                        ELSE 
                            exitscript
                        #}
                        ENDIF
                    #}
                    ENDIF 

                    # toHomeCode
                    CUST.GCHRG.fromCrncy = CUST.GCHRG.acctCrncy
                    CUST.GCHRG.toCrncy = BANCS.STDIN.homeCrncyCode
                    lv_s = "ratecode | select RATECODE_TRAN  from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
                    PRINT(lv_s)
                    BANCS.INPARAM.BINDVARS = CUST.GCHRG.fromCrncy + "|" + CUST.GCHRG.toCrncy + "|" + BANCS.STDIN.contextBankId
                    PRINT(BANCS.INPARAM.BINDVARS)
                    sv_d = urhk_dbSelectWithBind(lv_s)
                    PRINT(sv_d)
                    IF(sv_d ==0) THEN
                        CUST.GCHRG.toHomeCode = BANCS.OUTPARAM.ratecode
                        PRINT(CUST.GCHRG.toHomeCode)
                    ELSE 
                        print("Currency Combination not maintained")
                        CUST.GCHRG.toHomeCode = ""
                    ENDIF

                    IF((CUST.GCHRG.schmCode != "SB126") AND (CUST.GCHRG.schmCode != "CA207"))THEN
                    #{
                        IF( (CUST.GCHRG.schmCode == "SB188") OR (CUST.GCHRG.schmCode == "CA286") OR (CUST.GCHRG.schmCode == "CA288") )THEN
                        #{
                            IF(FIELDEXISTS(CASH.WITH.tran_amt) == 1 )THEN
                            #{
                                IF( (CUST.GCHRG.acctCrncy == "USD") OR (CUST.GCHRG.acctCrncy == "KES") OR (CUST.GCHRG.acctCrncy == "GBP") OR (CUST.GCHRG.acctCrncy == "EUR") )THEN
                                #{
                                    IF( (CDOUBLE(CUST.GCHRG.xcessAmt) > 0) AND (CUST.GCHRG.limitChrgFlg == "Y") )THEN
                                    #{
										
										IF(CUST.GCHRG.acctCrncy != "KES") THEN
                                        CUST.GCHRG.calcChrg = (CDOUBLE(CUST.GCHRG.xcessAmt) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
										CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
                                        print(CUST.GCHRG.calcChrg)
                                        IF(cdouble(CUST.GCHRG.calcChrg) > CUST.CPARAM.fxmaxdpchrg) THEN
											CUST.GCHRG.calcChrg = CUST.CPARAM.fxmaxdpchrg
											PRINT(CUST.GCHRG.calcChrg)
										ELSE
											CUST.GCHRG.calcChrg = CUST.GCHRG.calcChrg
											PRINT(CUST.GCHRG.calcChrg)
										ENDIF
										ENDIF
										
										IF(CUST.GCHRG.acctCrncy == "KES") THEN
                                        CUST.GCHRG.calcChrg = (CDOUBLE(CUST.GCHRG.xcessAmt) * CDOUBLE(CUST.CPARAM.keschrgpct)) / 100
										CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
                                        print(CUST.GCHRG.calcChrg)
                                        IF(CUST.GCHRG.calcChrg > CDOUBLE(CUST.CPARAM.maxkesdpchrg)) THEN
											CUST.GCHRG.calcChrg = CDOUBLE(CUST.CPARAM.maxkesdpchrg)
											CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
											PRINT(CUST.GCHRG.calcChrg)
										ELSE
											IF(CUST.GCHRG.calcChrg < CDOUBLE(CUST.CPARAM.minkesdpchrg)) THEN
												CUST.GCHRG.calcChrg = CDOUBLE(CUST.CPARAM.minkesdpchrg)
												CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
												PRINT(CUST.GCHRG.calcChrg)
											ELSE										
												CUST.GCHRG.calcChrg = CUST.GCHRG.calcChrg
												PRINT(CUST.GCHRG.calcChrg)
											ENDIF
										ENDIF
										ENDIF
                                        BANCS.INPARAM.InputAmount  = CUST.GCHRG.calcChrg
                                        BANCS.INPARAM.FromCurrency = CUST.GCHRG.acctCrncy
                                        BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode
                                        BANCS.INPARAM.RateCode     = CUST.GCHRG.toHomeCode
                                        BANCS.INPARAM.Rate         = ""
                                        sv_z=urhk_B2k_ConvertAmount("")
                                        IF(sv_z == 0)THEN
                                            CUST.GCHRG.convAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                            print(CUST.GCHRG.convAmt)
                                        ELSE 
                                            exitscript    
                                        ENDIF 
                                        CUST.GCHRG.chrgAmt = CUST.GCHRG.convAmt + "|" + BANCS.STDIN.homeCrncyCode
                                        CALL("ChargeLien.scr")
                                        CALL("gchrgcommon.scr")
                                    #}
                                    ENDIF
                                #}
                                ENDIF
                            ELSE 
                                PRINT("NO tran amount passed")
                            #}
                            ENDIF
                        ELSE
                            print("Non supreme customer")
                            IF(FIELDEXISTS(CASH.WITH.tran_amt) == 1 )THEN
                            #{
                                IF( (CUST.GCHRG.acctCrncy == "USD") OR (CUST.GCHRG.acctCrncy == "KES") OR (CUST.GCHRG.acctCrncy == "GBP") OR (CUST.GCHRG.acctCrncy == "EUR") )THEN
                                #{
                                    IF( (CDOUBLE(CUST.GCHRG.xcessAmt) > 0) AND (CUST.GCHRG.limitChrgFlg == "Y") )THEN
                                    #{
                                        #CUST.GCHRG.calcChrg = (CDOUBLE(CUST.GCHRG.xcessAmt) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
										#CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
                                        #print(CUST.GCHRG.calcChrg)
										
										IF(CUST.GCHRG.acctCrncy != "KES") THEN
                                        CUST.GCHRG.calcChrg = (CDOUBLE(CUST.GCHRG.xcessAmt) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
										CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
                                        print(CUST.GCHRG.calcChrg)
                                        IF(CDOUBLE(CUST.GCHRG.calcChrg) > CUST.CPARAM.fxmaxdpchrg) THEN
											CUST.GCHRG.calcChrg = CUST.CPARAM.fxmaxdpchrg
											PRINT(CUST.GCHRG.calcChrg)
										ELSE
											CUST.GCHRG.calcChrg = CUST.GCHRG.calcChrg
											PRINT(CUST.GCHRG.calcChrg)
										ENDIF
										ENDIF
										
										IF(CUST.GCHRG.acctCrncy == "KES") THEN
                                        CUST.GCHRG.calcChrg = (CDOUBLE(CUST.GCHRG.xcessAmt) *CDOUBLE(CUST.CPARAM.keschrgpct)) / 100
										CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
                                        print(CUST.GCHRG.calcChrg)
                                        IF(CUST.GCHRG.calcChrg > CDOUBLE(CUST.CPARAM.maxkesdpchrg)) THEN
											CUST.GCHRG.calcChrg = CDOUBLE(CUST.CPARAM.maxkesdpchrg)
											CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
											PRINT(CUST.GCHRG.calcChrg)
										ELSE
											IF(CUST.GCHRG.calcChrg < CDOUBLE(CUST.CPARAM.minkesdpchrg)) THEN
												CUST.GCHRG.calcChrg = CDOUBLE(CUST.CPARAM.minkesdpchrg)
												CUST.GCHRG.calcChrg = CDOUBLE(CUST.GCHRG.calcChrg)
												PRINT(CUST.GCHRG.calcChrg)
											ELSE										
												CUST.GCHRG.calcChrg = CUST.GCHRG.calcChrg
												PRINT(CUST.GCHRG.calcChrg)
											ENDIF
										ENDIF
										ENDIF 
                                        
                                        BANCS.INPARAM.InputAmount  = CUST.GCHRG.calcChrg
                                        BANCS.INPARAM.FromCurrency = CUST.GCHRG.acctCrncy
                                        BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode
                                        BANCS.INPARAM.RateCode     = CUST.GCHRG.toHomeCode
                                        BANCS.INPARAM.Rate         = ""
                                        sv_z=urhk_B2k_ConvertAmount("")
                                        IF(sv_z == 0)THEN
                                            CUST.GCHRG.convAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                                            print(CUST.GCHRG.convAmt)
                                        ELSE 
                                            exitscript    
                                        ENDIF
                                        CUST.GCHRG.eventId = CUST.CPARAM.supDepChrgEvent                                    
                                        CUST.GCHRG.chrgAmt = CUST.GCHRG.convAmt + "|" + BANCS.STDIN.homeCrncyCode
                                        CALL("ChargeLien.scr")
                                        CALL("gchrgcommon.scr")
                                    #}
                                    ENDIF
                                #}
                                ENDIF
                            ELSE 
                                PRINT("NO tran amount passed")
                            #}
                            ENDIF
                            
                            IF( BANCS.STDIN.roleId == "STL" )THEN
                            #{
                                print("Non supreme customer in supreme branch")
                                print(CUST.CPARAM.nonSupCustChrg)
                                CUST.GCHRG.tranType = "T"
                                CUST.GCHRG.tranSubType = "BI"
