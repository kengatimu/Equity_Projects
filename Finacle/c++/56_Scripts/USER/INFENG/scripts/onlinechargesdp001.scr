                                        ELSE 
                                            CASH.WITH.tranAmtUSD = CASH.WITH.tran_amt
                                        #}
                                        ENDIF 

                                        CUST.GCHRG.chrgUSD = (CDOUBLE(CASH.WITH.tranAmtUSD) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
                                        print(CUST.GCHRG.chrgUSD)

                                        IF( CDOUBLE(CASH.WITH.tran_amt) > 0 )THEN
                                        #{
											call("onlinechargesfx001.scr")
                                        #}
                                        ENDIF
                                    #}
                                    ENDIF
                                #}
                                ENDIF
                            #}
                            ENDIF
                        #}
                        ENDIF
                        ## charge for UGX
                        #Local Currency withdrawal above the limit/ exempt supreme clients
                        if((CUST.GCHRG.acctCrncy == "UGX") AND (CASH.WITH.schmCode != "CA232") AND (CASH.WITH.schmCode != "CA214") AND (CASH.WITH.schmCode != "SB102") AND (CASH.WITH.schmCode != "CA217") AND (CUST.GCHRG.schmCode != "SB188") AND (CUST.GCHRG.schmCode != "CA286") AND (CUST.GCHRG.schmCode != "CA288") AND (CUST.GCHRG.schmCode != "CA251") AND (CUST.GCHRG.schmCode != "SB151"))THEN
                        #{
                            CUST.GCHRG.check = GETPOSITION(CASH.WITH.tran_amt,"|")
