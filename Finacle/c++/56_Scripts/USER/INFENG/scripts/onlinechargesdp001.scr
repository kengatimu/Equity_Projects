            #sv_q contains the charge amount 
            sv_m = (CDOUBLE(sv_q) * CDOUBLE(CASH.WITH.Rate))    
            #CASH.WITH.negat = CASH.WITH.neg1
            CASH.WITH.negat = "-1"
            CASH.WITH.Tot_Amt = ((sv_m) * CDOUBLE(CASH.WITH.negat))
            CASH.WITH.with_amt = (sv_m)
            PRINT(sv_m)

            CASH.WITH.with_desc = CASH.WITH.withDesc2
            PRINT(CASH.WITH.Tot_Amt)
            PRINT(sv_m)
    
            CASH.WITH.With_Flg = "N"
