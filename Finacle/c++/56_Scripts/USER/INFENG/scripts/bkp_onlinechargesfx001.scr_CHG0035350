PRINT("Customer withdrawal Charge for usd above 2000")
lv_c = CDOUBLE(CUST.CPARAM.fxminwdchrg)
lv_d = CDOUBLE(CUST.CPARAM.fxmaxwdchrg)
lv_d = lv_d + 1

CUST.GCHRG.calcChrg = (CDOUBLE(CASH.WITH.tran_amt) * CDOUBLE(CUST.CPARAM.supChrgPct) ) / 100
print(CUST.GCHRG.calcChrg)

IF( (CDOUBLE(CUST.GCHRG.chrgUSD) < lv_c) OR (CDOUBLE(CUST.GCHRG.chrgUSD) == lv_c))THEN
#{
    #Default charge 3usd                                           
    IF( (CUST.GCHRG.acctCrncy == "GBP") OR (CUST.GCHRG.acctCrncy == "EUR") OR (CUST.GCHRG.acctCrncy == "KES") )THEN
    #{
        BANCS.INPARAM.InputAmount  = lv_c
        BANCS.INPARAM.FromCurrency = "USD"
        BANCS.INPARAM.ToCurrency   = CUST.GCHRG.acctCrncy
        BANCS.INPARAM.RateCode     = CUST.GCHRG.fromUsdCode
        BANCS.INPARAM.Rate         = ""
        sv_z=urhk_B2k_ConvertAmount("")
        IF(sv_z == 0)THEN
        #{
            CUST.GCHRG.calcChrg = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
            print(CUST.GCHRG.calcChrg)
        ELSE 
            exitscript
        #}
        ENDIF
    ELSE 
        CUST.GCHRG.calcChrg = lv_c
        print(CUST.GCHRG.calcChrg)
    #}
    ENDIF 
#}
ELSE 
#{
	IF(CDOUBLE(CUST.GCHRG.chrgUSD) > CDOUBLE(CUST.CPARAM.fxmaxwdchrg)) THEN
	#{
		#MAX CHARGE USD 5000                                         
		IF( (CUST.GCHRG.acctCrncy == "GBP") OR (CUST.GCHRG.acctCrncy == "EUR") OR (CUST.GCHRG.acctCrncy == "KES") )THEN
		#{
			BANCS.INPARAM.InputAmount  = CUST.CPARAM.fxmaxwdchrg
			BANCS.INPARAM.FromCurrency = "USD"
			BANCS.INPARAM.ToCurrency   = CUST.GCHRG.acctCrncy
			BANCS.INPARAM.RateCode     = CUST.GCHRG.fromUsdCode
			BANCS.INPARAM.Rate         = ""
			sv_z=urhk_B2k_ConvertAmount("")
			IF(sv_z == 0)THEN
			#{
				CUST.GCHRG.calcChrg = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				print(CUST.GCHRG.calcChrg)
			ELSE 
				exitscript
			#}
			ENDIF
		#}
		ELSE 
		#{
			CUST.GCHRG.calcChrg = CUST.CPARAM.fxmaxwdchrg
			print(CUST.GCHRG.calcChrg)
		#}
		ENDIF
		#}  
		ELSE
		#{
		
		IF((CDOUBLE(CUST.GCHRG.chrgUSD) < lv_d) AND (CDOUBLE(CUST.GCHRG.chrgUSD) > lv_c)) THEN
		#{
			#CHARGE BETWEEN 3 AND 5000                                         
			IF( (CUST.GCHRG.acctCrncy == "GBP") OR (CUST.GCHRG.acctCrncy == "EUR") OR (CUST.GCHRG.acctCrncy == "KES") )THEN
			#{
				BANCS.INPARAM.InputAmount  = CUST.GCHRG.chrgUSD
