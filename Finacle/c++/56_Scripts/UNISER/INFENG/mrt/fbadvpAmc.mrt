##################################################################
#  FILE   :  fbadvpAmc.mrt ( A part of mc mrt)
#  DATE   :  09-11-95
#  AUTHOR :  Praveen Kumar
#  DESC   :  This is the Mahareport specs for generating FOREIGN 
#            BILLS TRANSACTION ADVICE - TRANSACTION PART
#			 (Another Part is Interest Part)
# MODIFICATION: ERIC KAROBIA  11/11/2005
#
###################################################################
#
#
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include FxBillMain.mri
$$$include langDetails.mri
$$$include FxBillExportImport.mri
$$$include FxBillHistory.mri
$$$include FxBillTran.mri
$$$include FxBillConv.mri
#
#
LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
purch_sale_flg stringType

GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in 
#   RECORDLAYOUT section.
####################################################################
FBHtranId  alreadySorted

#############################################################################
#
#	REPOSITORY (Optional Section) - Fixed-Type Repository.
#	This section tells about the Repository Information. A  Repository  is  a 
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#	Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#   
#############################################################################
REPOSITORY  argv4
bankName		stringType
branchName		stringType
branchAddr1		stringType
branchAddr2		stringType
branchCity		stringType
branchState		stringType
branchPinCode	stringType
bodDate			stringType
languageCode	stringType
PAGE_NUMBER	numberType

MASSAGERECORD
#############################################################################
#
# 	MASSAGERECORD (Optional Section).
# 	The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#	later. This Block is executed every time a new record is read.
#
#############################################################################
if FAEAcctOwnerShip = "O" 
	set FAEaccountId = "Office Acct"


#############################################################################
#
# 	IGNORERECORD (Optional Section).
# 	The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
# 	for input records), the record is Ignored.
#
#############################################################################
IGNORERECORD
if FAEpartTranRefIndicator = "N"
if (languageCode != "" and (languageCode != langCode))
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    65
columnsperline  80
topMargin        0
bottomMargin     0
leftMargin       0



BEFOREBREAKOF FBHtranId
####################################################################
#   This section will be print heading for a single Advice
####################################################################
#
print "" size 80 fillAscii 45 
nextLine
#
print "To," column 1
print " | " column 39
print bankName size 38
nextLine
#
print PartyName size 38 column 1
print " | "
print branchName size 38
nextLine
#
print PartyAddr1 size 38 column 1
print " | "
print branchAddr1 size 38
nextLine
#
print PartyAddr2 size 38 column 1
print " | "
print branchAddr2 size 38
nextLine
#
print PartyAddr3 size 38 column 1
print " | "
print branchCity
print ", "
print branchState
print " -"
print branchPinCode
nextLine
#
print PartyCountryName size 38 column 1
print " | "
print bodDate size 10 column 70
nextLine
#
print "" size 80 fillAscii 45 
nextLine
#
print "FOREIGN BILLS TRANSACTION ADVICE"  center size 80 column 1
nextLine
#
#
print "" size 80 fillAscii 45 
nextLine
#
#
  if(UnformattedBillId != multiTenorBillId)
    begin
       print "Multi Tenor Bill Id:"
       print multiTenorBillId column 22 size 15
    end

nextline
print "Bill No.  " column 1
print UnformattedBillId 
#
print "Operation : " column 45
execute printCurrentOperation
nextLine
#
print "Transaction Id : "
print FBHtranId size 15
print "Transaction Date : " column 48
print FAEtranDate
nextline
nextline
#
# Print PST details if they are dumped.
execute printConvDetails
#
#print "Transaction Details are as below : "
print " We advice having debited your account  "  
if  FAEAcctOwnerShip = "C"
begin
 print FAEaccountId
end
# print " as under: "	
print " With "
print PSTpurchasedCrncy_1 
print " "
print PSTpurchasedAmt_1 size 17 column 52 rightJustify
nextline
print "" size 80 fillAscii 45 
nextline
print  "Description                                      Amount                  "
nextline
#print  "Type                                            Currency --   Amount Dr "
nextline
print "" size 80 fillAscii 45
nextline
#
#
AFTERBREAKOF FBHtranId
####################################################################
#   This section will be responsible for  ending advice for a single tran_id
####################################################################
print "" size 80 fillAscii 45 
nextPage
#
#
ONEVERYRECORD
####################################################################
#   This section will be responsible for actual printing of TRANSACTION
#	ADVICE. It will be executed once for each recod.
####################################################################
#
if FAEAcctOwnerShip != "C"
begin
 execute printAcctType	
 print FAEaccountId  size 16 column 13
 print FAEAccountName size 20 column 30
 print FAEtranCurrencyCode size 3 column 55
 print TranAmount size 15 column 63 rightJustify
 if FAEpartTranType = "C"
    print "Cr" column 59
 if FAEpartTranType = "D"
    print "Dr" column 59
 if ((FAErate != 1) and (FAErate != 0))
    print FAErate size 12 column 49 rightJustify
 nextline
 end
#
ONENDOFREPORT
#############################################################################
#
#	ONENDOFREPORT (Optional Section).
#	This Section  will be  executed  Only  Once  during the Processing of the 
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#	NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#	If, Else, execute, DontFlushAfterSection.
#
#############################################################################
#print "" size 80 fillAscii 45 
set PAGE_NUMBER = PAGE_NUMBER + pageNumber
#############################################################################
#
# 	PROCEDURE BLOCK.
#  	Procedure  itself is a Independent  Block  and  defined at the end of the 
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#	Template File, Makes  it  Structured  and  avoids burring the same set of 
#   codes at several places.
#
#############################################################################
PROCEDURE printAcctType
if FAEpartTranIndex = 0
	print "Purchase" 
if FAEpartTranIndex = 1
	print "Interest"
if FAEpartTranIndex = 2
	print "Commission"
if FAEpartTranIndex = 3
	print "Postage"
if FAEpartTranIndex = 4
	print "Swift"
if FAEpartTranIndex = 5
	print "P&T Charge"
if FAEpartTranIndex = 6
	print "NAAC"
if FAEpartTranIndex = 7
	print "Realisation"
if FAEpartTranIndex = 8
	print "Delink"
if FAEpartTranIndex = 9
	print "Operative"
if FAEpartTranIndex = 10
	print "Misclaneous"
if FAEpartTranIndex = 11
	print "Misclaneous"
if FAEpartTranIndex = 12
	print "Misclaneous"
if FAEpartTranIndex = 13
	print "Misclaneous"
if FAEpartTranIndex = 14
	print "Misclaneous"
if FAEpartTranIndex = 15
	print "Misclaneous"
if FAEpartTranIndex = 16
	print "Misclaneous"
if FAEpartTranIndex = 17
	print "Misclaneous"
if FAEpartTranIndex = 18
	print "Misclaneous"
if FAEpartTranIndex = 19
	print "PackingCr"
if FAEpartTranIndex = 20
	print "EEFC"
if FAEpartTranIndex = 21
	print "HC Advance"
if FAEpartTranIndex = 22
	print "FrBankChrg"
if FAEpartTranIndex = 23
	print "Int Advance"
if FAEpartTranIndex = 24
	print "Int Recv."
if FAEpartTranIndex = 25
	print "Int Adjust"
if FAEpartTranIndex = 26
	print "Consolidate"
if FAEpartTranIndex = 27
	print "SG Margin"
if FAEpartTranIndex = 28
	print "RPC"
if FAEpartTranIndex = 29
	print "FB Int"
if FAEpartTranIndex = 30
	print "Swap"
if FAEpartTranIndex = 31
	print "SendBkChrg"
if FAEpartTranIndex = 32
	print "RecvBkChrg"
#############################################################################
#
# 	PROCEDURE BLOCK.
#  	Procedure  itself is a Independent  Block  and  defined at the end of the 
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#	Template File, Makes  it  Structured  and  avoids burring the same set of 
#   codes at several places.
#
#############################################################################
PROCEDURE printCurrentOperation
if FBHbillFunc = "G"
	print "LODGE"
if FBHbillFunc = "H"
	print "Advance"
if FBHbillFunc = "P"
	print "Purchase"
if FBHbillFunc = "R"
	print "Realisation"
if FBHbillFunc = "K"
	print "Delink"
if FBHbillFunc = "O"
	print "Recovery"
if FBHbillFunc = "N"
	print "Dishonour"
if FBHbillFunc = "#"
    print "Extended"
#############################################################################
# PROCEDURE to print currency conversion details.
#############################################################################
PROCEDURE printConvDetails
if PSTtype_1 != ""
begin
    print "Currency Conversion Details are as below : "
    nextline
    print "" size 80 fillAscii 45
    nextline
    print "From Currency  / Amount" column 11
    print "Rate" column 40
    print "To Currency  / Amount" column 46
    nextline
    print "" size 80 fillAscii 45
    nextline
    set purch_sale_flg = substr PSTtype_1 2 1
    if purch_sale_flg = "P"
    begin
        print "Purchase : "
        print PSTpurchasedCrncy_1 column 16
        print PSTpurchasedAmt_1 size 17 column 19 rightJustify
        print PSTrate_1 size 12 column 35 rightJustify 
        print PSTsoldCrncy_1 column 49
        print PSTsoldAmt_1 size 17 column 52 rightJustify
        nextline
    end
    else
    begin
        print "Sale : "
        print PSTsoldCrncy_1 column 16
        print PSTsoldAmt_1 size 17 column 19 rightJustify
        print PSTrate_1 size 12 column 35 rightJustify 
        print PSTpurchasedCrncy_1 column 49
        print PSTpurchasedAmt_1 size 17 column 52 rightJustify
        nextline
    end
end

if PSTtype_2 != ""
begin
    set purch_sale_flg = substr PSTtype_2 2 1
    if purch_sale_flg = "P"
    begin
        print "Purchase : "
        print PSTpurchasedCrncy_2 column 16
        print PSTpurchasedAmt_2 size 17 column 19 rightJustify
        print PSTrate_2 size 12 column 35 rightJustify 
        print PSTsoldCrncy_2 column 49
        print PSTsoldAmt_2 size 17 column 52 rightJustify
        nextline
    end
    else
    begin
        print "Sale : "
        print PSTsoldCrncy_2 column 16
        print PSTsoldAmt_2 size 17 column 19 rightJustify
        print PSTrate_2 size 12 column 35 rightJustify 
        print PSTpurchasedCrncy_2 column 49
		print PSTsoldAmt_2 size 17 column 52 rightJustify
        nextline
    end
end

if PSTtype_3 != ""
begin
    set purch_sale_flg = substr PSTtype_3 2 1
    if purch_sale_flg = "P"
    begin
        print "Purchase : "
        print PSTpurchasedCrncy_3 column 16
        print PSTpurchasedAmt_3 size 17 column 19 rightJustify
        print PSTrate_3 size 12 column 35 rightJustify 
        print PSTsoldCrncy_3 column 49
        print PSTsoldAmt_3 size 17 column 52 rightJustify
        nextline
    end
	else
    begin
        print "Sale : "
        print PSTsoldCrncy_3 column 16
        print PSTsoldAmt_3 size 17 column 19 rightJustify
        print PSTrate_3 size 12 column 35 rightJustify 
        print PSTpurchasedCrncy_3 column 49
        print PSTpurchasedAmt_3 size 17 column 52 rightJustify
        nextline
    end
end

if PSTtype_1 != ""
begin
    print "" size 80 fillAscii 45
    nextline
    nextline
end
