###################################################################
recordlayout
###################################################################
# 
####################################################################
sol_id 	            stringtype
schm_type           stringtype	
schm_code           stringtype 
foracid             stringtype	
acct_name           stringtype 
clr_bal_amt         numbertype
un_clr_bal_amt      numbertype
sanct_lim           numbertype
tran_date           stringtype
max_int_pcnt_dr     numbertype
cust_perm_phone_num stringtype
lim_exp_date        stringtype
#____________________________________________________________________
localvariables
######################################################
#localvariables are defined here
#####################################################################
total1           numbertype
total2           numbertype 	
total3           numbertype 
total4           numbertype
total5           numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType

groupandsort
#####################################################################
# 
####################################################################
foracid 
repository bankRepos.rip  
######################################################
bankname	stringtype
branchName      stringtype

REPOSITORY  argv4
#############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#____________________________________________________________________________
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################

PAGEFORMAT
####################################################################
# 
####################################################################
linesperPage   65
columnsperline 200 
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13
pagefooterlines 4
######################################################

onstartofreport
#####################################################

execute brBankHdg 
execute pageHdg

#
################################################################
PAGEHEADER
################################################################
execute brBankHdg 
execute pageHdg
#
#_______________________________________________________________

oneveryrecord
###############################################################
print foracid column 3
print acct_name column 17
print schm_code column 50
print lim_exp_date column 65
print clr_bal_amt column 70
print un_clr_bal_amt column 80
begin
     set total1=( clr_bal_amt + un_clr_bal_amt )
     print total1 column 90 format "#,###.##" 
     set total2=( sanct_lim - total1 ) 
     if total2 <0
     print total2 column 100 format "#,###.##"
end
print max_int_pcnt_dr column 132
print cust_perm_phone_num column 138
#
#############################################################################
#afterbreakof 
#############################################################################
#
#############################################################################
onendofreport
#############################################################################
#
#############################################################################
set total3 = totalsum clr_bal_amt 
#set total4 = totalsum un_clr_bal_amt
#set total5 = totalsum total1
#set total6 = totalsum total2

print "Total value" column 3 
print total3 column 70 format "##,###,###,###,###.##" 
print total4 column 80 format "##,###,###,###,###.##"
separatorline
separatorline
nextline
begin
     print "printed by:"  size  100 center
     print  lv_userId
     nextline
     nextline
     nextline
     print "verified by:" size  100 center
     print "........................" column  100
     nextline
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 200 center
     separatorline
end
#
#
############################################################################
Procedure  pageHdg
#############################################################################
begin
     nextline
     print "          Excess Advances Report  "  size  200 center 
     nextline
     nextline
     print " From  " column  90 
     print ipFrmDate  column  98 
     print "  &  "
     print ipToDate   column   114 
     nextline
     print "        ======================================================"  size 200 center 
     nextline
     nextline
     separatorline
     nextline
end

begin
     print "AccNo" column 3
     print "ACC NAME" column 17
     print "Product" column 40
     print "ExpiryDate" column 65
     print "ClearBal" column 77
     print "Effects" column 90
     print "Total" column  105
     print "Overlimt" column  120
     print "Creditdate" column 135
     print "Rate" column 140
     print "Phonecontact" column  145
     separatorline
end
#
######################################################################
PROCEDURE brBankHdg
####################################################################

begin
     print "Page No. "   column   180
     print page_number precision 0
     nextline
     print today column   175 
     nextline
     nextline
     print "            EQUITY BANK LIMITED"  size  200 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 200 center 
     nextline
     separatorline
end
