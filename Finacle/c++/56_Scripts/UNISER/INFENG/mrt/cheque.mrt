# Template Name :		cheque.mrt
# Description	:		unverified customer cheques
# Author			E.G.KAROBIA,08-07 -2006
# 
#########################################################################
RECORDLAYOUT
REQ_ID  stringType 
FORACID stringType
BRANCH_ID stringType
BEGIN_CHQ_NUM stringType
NUM_OF_CHB stringType
NUM_OF_CHQ_LVS stringType
REQ_DATE stringType

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 70
columnsperline 70
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 70 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print REQ_ID  column 2 
        print FORACID  column 13
        print NUM_OF_CHB column 32
        print NUM_OF_CHQ_LVS column 39
	print BEGIN_CHQ_NUM column 49
	print REQ_DATE   column 60
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "REQ_ID"  column 2 
        print "ACCNT NUM" column 13
        print " NUM_OF  " column 28
        print "NUM_OF " column 39
	print "BEGIN_CHQ" column 49
	print "REQ_DATE"   column 60
	nextline
        print " CHQ BKS " column 28
        print "CHQ_LVS " column 39
	print " NUMBER " column 49
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 70 center 
	nextline
	print branchName  size 70 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 70 center
	nextline
	print " UNVERIFIED CUSTOMER CHEQUE REPORT"  size 70 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 70 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"  column 1 
        print "|" column 12
        print "|" column 27
        print "|" column 38
	print "|" column 48
	print "|"   column 59
	print "|" column 70
		
end


