#  This is the Mahareport for Detailed Balance Sheet Branchwise 
###############################################################################
RECORDLAYOUT
###############################################################################
acct_name                                    stringtype
fgn_cny                                      numbertype
hom_cny                                      numbertype
gl_sub_head_code	                     numbertype 
gl_code                                      numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript    			               stringType
lv_setid       				       stringType  
lv_setdesc    				       stringType
flag					       numbertype	 
flag1                                          numbertype
flag2                                          numbertype
flag3                                          numbertype
flag4                                          numbertype
flag5                                          numbertype
flag6                                          numbertype
flag7                                          numbertype
flag8                                          numbertype
flag9                                          numbertype
flag10                                          numbertype
flag11                                          numbertype
flag12                                          numbertype
flag13                                          numbertype
flag14                                          numbertype
flag15                                          numbertype
flag16                                          numbertype
flag17                                          numbertype
flag18                                          numbertype
flag19                                         	numbertype
flag20                                          numbertype
flag21                                          numbertype
flag22                                          numbertype
flag23                                          numbertype
flag24						numbertype
flag25						numbertype
total						numbertype
grand_total					numbertype
t11						numbertype
################################################################################
GROUPANDSORT
###############################################################################
gl_code,gl_sub_head_code
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
############################################################################
#IGNORERECORD
###########################################################################
###############################################################################
PAGEFORMAT
##############################################################################
ColumnsPerLine   100 
LinesPerPage     55 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "EQUITY BANK LIMITED"  column 1 size 100 center
nextline
print  "Branch: "   column 1 size 100 center
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 1 size 100 center  
nextline
nextline
print   "Detailed Balance Sheet"  column 1 size 100 center  
nextline
nextline
print asondate column 1 size 100 center   
nextline
nextline
separatorline 
print "ACCOUNT DESCRIPTION"  column 09
print "FCY BALANCE" column 57 
print "LCY BALANCE" column 80 
separatorline
set flag  = 0                                
set flag1 = 0                                 
set flag2 = 0                                  
set flag3 = 0                                   
set flag4 = 0                                    
set flag5 = 0                                     
set flag6 = 0                                      
set flag7 = 0                                       
set flag8 = 0                                        
set flag9 = 0                                         
set flag10  = 0                        
set flag11  = 0                                 
set flag12  = 0                                  
set flag13  = 0                                   
set flag14  = 0                                    
set flag15  = 0                                     
set flag16  = 0                                      
set flag17  = 0                                       
set flag18  = 0                                        
set flag19  = 0                                      
set flag20  = 0              
set flag21  = 0                    
set flag22  = 0                               
set flag23  = 0 
set flag24  = 0 
set flag25  = 0                                
set total   = 0                             
set grand_total = 0 
end
#############################################################################
ONEVERYRECORD
#############################################################################
begin
if( gl_code = 10 )
	begin
	if (flag1 = 0)
	begin
	print   "CASH"                          		column 03
	nextline
	set flag1 = 1
	end
	execute onEveryRecord
	end
if( gl_code = 11 )
	begin
	if (flag2 = 0)
	begin
	separatorline
	print	"TOTAL CASH"					column 03
	execute TOTAL 
	separatorline
	print  	"BANK BALANCES"					column 03
	set flag2 = 1
	end
	execute	onEveryRecord
	end
if( gl_code = 12 )
	begin
	if (flag3 = 0)
	begin
	separatorline
	print	"TOTAL BANK BALANCES"				column 03
	execute TOTAL 
	separatorline
	print	"INVESTMENTS"					column  03
	nextline 
	set flag3 = 1
	end
	execute	onEveryRecord
	end
if( gl_code = 13 )
	begin
	if (flag4 = 0)
	begin
	separatorline
	print	"TOTAL INVESTMENTS"				column 03
	execute TOTAL 
	separatorline
	print	"DEBTORS/PREPAYMENTS"				column 03
	nextline 
	set flag4 = 1
	end
	execute	onEveryRecord
	end
if( gl_code = 14 )
	begin
	if (flag5 = 0)
	begin
	separatorline
	print	"TOTAL DEBTORS/PREPAYMENTS"			column 03
	execute TOTAL   
	separatorline
	print 	"CONSUMABLE STOCKS"				column 03
	nextline 
	set flag5 = 1
	end
	execute	onEveryRecord
	end	
if( gl_code = 15 )
	begin
	if ( gl_sub_head_code = 15001 )
	begin
	if ( flag = 0)
        begin
	separatorline
        print   "Total Stocks"                                  column 03
        execute TOTAL
	separatorline
        set flag = 1
        end
	execute onEveryRecord 	
	end
	end
	

if( gl_code = 16 )
	begin
	if (flag6 = 0)
	begin
	separatorline
	print	"TOTAL ADVANCES"				column 03
	execute TOTAL  
	separatorline
	print	"CONTINGENT ASSETS"				column 03
	set flag6 = 1
	end
	execute	onEveryRecord
	end

if( gl_code = 17 )
	begin
	if (flag7 = 0)
	begin
	separatorline
	print	"TOTAL CONTINGENT ASSETS"			column 03
	execute TOTAL  
	separatorline
	print	"INTANGIBLE ASSETS"				column 03
	nextline 
	set flag7 = 1
	end
	execute	onEveryRecord
	end

if( gl_code = 18 )
	begin
	if (flag8 = 0)
	begin
	separatorline
	print	"TOTAL INTANGIBLE ASSETS"			column 03
	execute TOTAL  
	separatorline
	print	"FIXED ASSETS"					column 03
	nextline 
	set flag8 = 1
	end
	execute	onEveryRecord
	end

if( gl_code = 19 )
	begin
	if (flag9 = 0)
	begin
	separatorline
	print	"TOTAL FIXED ASSETS"				column 03
	execute TOTAL  
	separatorline
	print	"OTHER ASSETS"					column 03
	nextline 
	set flag9 = 1
	end
	execute	onEveryRecord
	end

if( gl_code = 30 )
	begin 
	if( gl_sub_head_code = 30001 )  
	begin
	if (flag10 = 0)
	begin
		print	"TOTAL OTHER ASSETS"				column 03
		execute TOTAL 
		nextline
		separatorline
		print	"TOTAL ASSETS"					column 03
        	print    grand_total 	column 70 size 20 autocomma precision 2 
		set grand_total = 0
		separatorline
		nextline
		print	"CURRENT LIABILITIES"				column 03 
		nextline 
		set flag10 = 1
	end
	execute	onEveryRecord
	end
	end
if( gl_code = 30 )
	begin 
	if( gl_sub_head_code = 30002 )
	begin
		execute onEveryRecord
	end
	end

if( gl_code = 30 )
	begin 
	if( gl_sub_head_code = 30003)
	begin
	if (flag11 = 0)
	begin	
	separatorline
	print	"TOTAL CURRENT LIABILITIES"			column 03
	execute TOTAL  
	separatorline
	nextline
	print	"MARGIN HELD"					column 03
	nextline 
	set flag11 = 1
	end
	execute	onEveryRecord
	end
	end

if( gl_code = 30 )
	begin 
	if( gl_sub_head_code = 30004)
	begin
	if (flag12 = 0)
	begin
	separatorline
	print	"TOTAL MARGIN HELD"				column 03
	execute TOTAL 
	separatorline
	set flag12 = 1
	end 
	execute	onEveryRecord
	end
	end

if( gl_code = 30 )
	begin
	if( gl_sub_head_code = 30008)
	begin
	execute	onEveryRecord
	end
	end
if( gl_code = 30 )
	begin
	if( gl_sub_head_code = 30009)
	begin
	execute	onEveryRecord
	end
	end
if( gl_code = 31 )
	begin 
        if (flag12 = 0)
        begin
        separatorline
        print   "TOTAL MARGIN HELD"                             column 03
        execute TOTAL
        separatorline
        set flag12 = 1
        end
	if( gl_sub_head_code = 31001)
	begin
	if (flag13 = 0)
	begin
	print	"ACCRUED INTEREST ON DEPOSITS"			column 03
	nextline 
	set flag13 = 1
	end
	execute	onEveryRecord
	end
	end
if( gl_code = 31 )
	begin 
	if( gl_sub_head_code = 31002)
	begin
	if (flag14 = 0)
	begin
	separatorline
	print	"TOTAL ACCRUED INTEREST ON DEPOSITS"		column 03
	execute TOTAL 
	separatorline
	print	"UNEARNED INTEREST INCOME"			column 03
	nextline 
	set flag14 = 1
	end
	execute	onEveryRecord
	end
	end
if( gl_code = 32 )
	begin
	if( gl_sub_head_code = 32001 )
	begin
		if (flag15 = 0)
		begin
		print	"TOTAL UNEARNED INTEREST INCOME"		column 03
		execute TOTAL 
		print	"PROVISIONS ON LOANS"				column 03
		nextline 
		set flag15 = 1
		end
	execute	onEveryRecord
	end
	end
if( gl_code = 32 )
	begin
	if ( gl_sub_head_code = 32002 )
	begin
		execute onEveryRecord
        end
	end
#	if ( gl_sub_head_code = 32004 )
#        begin
#        execute onEveryRecord
#        end
#	end

if( gl_code = 32 )
	begin
	if( gl_sub_head_code = 32003)
	begin
	if (flag24 = 0)
	begin
	print	"TOTAL SPECIFIC PROVISIONS ON LOANS"		column 03
	execute TOTAL
	print	"PROVISION ON DEPRECIATION"			column 03
	nextline 
	set flag24 = 1
	end
	execute	onEveryRecord
	end
	end
if( gl_code = 33 )
	begin 
	if ( gl_sub_head_code = 33001)
	begin
	if (flag17 = 0)
	begin
	print	"TOTAL PROVISION ON DEPRECIATION"		column 03
	execute TOTAL
	print	"SUSPENDED INTEREST"				column 03
	nextline 
	set flag17 = 1
	end
	execute	onEveryRecord
	end
	end
if( gl_code = 34)
	begin
	if (flag18 = 0)
	begin
	print	"TOTAL SUSPENDED INTEREST"			column 03
	execute TOTAL
	print	"TAXES PAYABLE"					column 03 
	nextline 
	set flag18 = 1
	end
	execute	onEveryRecord
	end

if( gl_code = 35)
	begin
	if (flag19 = 0)
	begin
	print	"TOTAL TAXES PAYABLE"				column 03
	execute TOTAL
	print	"DEPOSITS"					column 03
	nextline 
	set flag19 = 1
	end
	execute onEveryRecord 
	end
if( gl_code = 36)
	begin
	if (flag20 = 0)
	begin
	separatorline
	print   "TOTAL DEPOSITS"                           column 03   
	execute TOTAL
	separatorline 
	print	"CONTIGENT LIABILITIES"				column 03
	nextline	
	set flag20 = 1
	end
	execute	onEveryRecord
	end
if(gl_code = 37)
	begin
	if (flag21 = 0)
	begin
	print	"TOTAL CONTIGENT LIABILITIES"			column 03
	execute TOTAL
	print	"BORROWINGS"					column 03
	nextline 
	set flag21 = 1
	end
	execute	onEveryRecord
	end

if( gl_code = 50 )
	begin
	if (flag21 = 0)
        begin
        print   "TOTAL CONTIGENT LIABILITIES"                   column 03
        execute TOTAL
        nextline
        set flag21 = 1
	end
	if( gl_sub_head_code = 50001)
	begin
	if (flag22 = 0)
	begin
	print	"TOTAL BORROWINGS"				column 03
	execute TOTAL
	print	"CAPITAL"					column 03
	nextline 
	set flag22 = 1
	end
	execute	onEveryRecord
	end
	end
if( gl_code = 50 )
	begin
	if( gl_sub_head_code = 50002)
	begin
	execute onEveryRecord
        end
	end

if( gl_code = 50 )
	begin
	if( gl_sub_head_code = 50003)
	begin
	if (flag23 = 0)
	begin
	print	"TOTAL CAPITAL"					column 03
	execute	TOTAL
	set flag23 = 1
	end
	execute	onEveryRecord
	end
	end

if( gl_code = 100 )
        begin
        execute onEveryRecord
        end

end

###############################################################################
ONENDOFREPORT
###############################################################################
begin
set grand_total = grand_total + total
execute disp_grand_tot
end

##############################################################################
PROCEDURE disp_grand_tot
###############################################################################
begin
nextline
separatorline
print	"TOTAL LIABILITIES & CAPITAL" 	column 03
print  grand_total 	column 70 size 20 autocomma precision 2
separatorline
end
################################################################################
PROCEDURE onEveryRecord
################################################################################
begin
print  acct_name  column 03
if (gl_code < 19)
        begin
        if (hom_cny < 0)
                begin
                print   hom_cny   column 70 size 20 autocomma precision 2
                end
        if(hom_cny > 0)
                begin
                print hom_cny   column 70 size 20 autocomma precision 2
                end
        end
if(gl_code > 19)
        begin
        if(hom_cny > 0)
                begin
                print   hom_cny   column 70 size 20 autocomma precision 2
                end
        if(hom_cny < 0)
                begin
                print hom_cny   column 70 size 20 autocomma precision 2
                end
        end

print      fgn_cny   column 42 size 20 autocomma precision 2 
set total = total + hom_cny
end
###################################################################################
PROCEDURE       TOTAL 
###################################################################################
begin
        begin
        print total  column 70 size 20 autocomma precision  2 
        set grand_total = grand_total + total
        set total = 0
        nextline
        end
end
