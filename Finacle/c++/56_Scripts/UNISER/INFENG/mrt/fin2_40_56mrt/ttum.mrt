###############################################################################
RECORDLAYOUT
###############################################################################
sol_id				stringtype
bacid				stringtype
foracid				stringtype
clr_bal				stringtype
schm_code			stringtype
###############################################################################
LOCALVARIABLES
###############################################################################
ind_000				stringtype
ind_sol				stringtype
crncy				stringtype
sol_lpad			stringtype
for_lpad			stringtype
clr_lpad			stringtype
takataka			stringtype
taka_lp				stringtype
clr_bal_amt			numbertype
lbal				stringtype
flg				numbertype
###############################################################################
GROUPANDSORT
###############################################################################
bacid,sol_id descending
###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine  900
LinesPerPage    500 
LeftMargin       00
RightMargin      00
Topmargin        00
BottomMargin     00
pageHeaderLines  00
pageFooterLines  00

##############################################################################
ONEVERYRECORD
##############################################################################
set clr_bal_amt = StrToNum clr_bal

if(sol_id != "000")
begin
if (clr_bal_amt < 0) 
begin
	set ind_000 = "D"
	set ind_sol = "C"
	set flg = 0
end

if (clr_bal_amt > 0)
begin
	set ind_000 = "C"
	set ind_sol = "D"
	set flg = 0
end
end
if(sol_id != "000")
begin
if (clr_bal_amt = 0)
begin
set flg = 1
end
end
if (flg = 0)
begin
set clr_bal_amt = abs clr_bal_amt
set clr_bal = numToStr clr_bal_amt

set for_lpad = rpad foracid 16 " "
print for_lpad size 16 column 1
print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20
if (sol_id = "000") 
begin
	print ind_000 column 28
	set clr_bal = lbal
	set lbal = "0"
end
if (sol_id != "000")
begin
	print ind_sol column 28
	set lbal = clr_bal
end

set clr_lpad = lpad clr_bal 17 " "
print clr_lpad size 17 column 29
set takataka = lpad takataka 830 " "
print takataka size 830 column 46
end
##############################################################################
ONSTARTOFREPORT
##############################################################################
set crncy = "KES"
set takataka = " " 
set lbal = "0"
set flg = 0
##############################################################################
ONENDOFREPORT
##############################################################################
##############################################################################
PAGEHEADER
##############################################################################
