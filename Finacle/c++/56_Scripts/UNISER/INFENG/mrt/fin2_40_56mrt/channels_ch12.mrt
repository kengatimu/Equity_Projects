#  DESC   :  ATM Commissions For Transactions 
######################################################################
RECORDLAYOUT
####################################################################
#   
####################################################################

sol_id			stringType
rcre_time 		stringType
tran_id 		stringType
foracid			stringType
acct_name 		stringType
tran_rmks 		numberType
tran_amt		numberType
tran_particular 	stringType


LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################

total_tran		numberType
gr_total_tran		numberType

total_transactions	numberType
gr_total_transactions	numberType

total_pages		numberType
totalpages		numberType

page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType

GROUPANDSORT
####################################################################
#
#################################################################### 
sol_id ascending
#
#
#REPOSITORY bankRepos.rip  
############################################################################

#bankName        stringType
#branchName      stringType

############################################################################
REPOSITORY  argv4
############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#############################################################################
#
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
pageformat
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################

widowOrphanLines 3
LinesPerPage 64
Topmargin       2
BottomMargin 2
columnsPerLine 125 
pageHeaderLines 8
pageFooterLines 2
#
ONSTARTOFREPORT
####################################################################  

set total_tran = 0
set gr_total_tran = 0
set total_transactions = 0
set gr_total_transactions = 0

execute brBankHdg 
execute pageHdg

#
PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
print "Pg:" column 2
print pagenumber column 5
print "of" column 7
print "<<TOP>>" column 10
nextline
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################

set total_tran = total_tran + tran_amt

print rcre_time 	column 2
print tran_id		column 15
print foracid		column 25
print acct_name		column 42
print tran_rmks 	column 72
print tran_amt 		column 97
print tran_particular 	column 111

AFTERBREAKOF sol_id
####################################################################
# After break of sol id
####################################################################

set total_transactions = groupcount tran_id
print "Total Reversed Transactions  "column 2
print total_transactions column 30
nextline 
print TOTAL column 2
print total_tran column 97
separatorline
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
     set gr_total_transactions = totalcount tran_id
     print "TOTAL TRANSACTIONS: " column 2
     print gr_total_transactions column 25
     separatorline 
     set gr_total_tran = totalsum tran_amt
     print "Grand Total : " column 2
     print gr_total_tran column 97
     separatorline
end

begin
     print "printed by:" column 55 
     print  lv_userId
     nextline
     nextline
     print "verified by:" column  55 
     print "............" column  70 
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 125 center
     separatorline
end 
#
#
#############################################################################
Procedure  pageHdg
###############################################################################
begin
     print " ATM Commissions Report  "  size 125 center 
     nextline
     print "  FROM  " column 46  
     print ipFrmDate  
     print " TO "
     print ipToDate 
     separatorline
end

begin
     print "TRAN DATE" column 2
     print "TRAN ID" column 15
     print "A/C NUM" column 25
     print "A/C NAME" column 42
     print "CARD NUMBER" column 72
     print "TRAN AMNT" column 92
     print "TRAN DETAILS" column 111
     separatorline
end
########################################################################
PROCEDURE brBankHdg
##############################################################################
begin
     print "Page No. "   column  85 
     print page_number precision 0
     nextline
     print today column 85 
     nextline
     print "EQUITY BANK LIMITED"  size 125 center 
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 125 center 
     nextline 
end
####################################################################
# End of File
######################################################################
