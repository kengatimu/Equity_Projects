######################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
foracid stringtype
acct_name stringtype
acct_crncy_code stringtype
cust_comu_addr1 stringtype
deposit_amount numbertype
maturity_date stringtype

#
#
LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################

GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is already sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in
#   RECORDLAYOUT section.
#################################################################### 
foracid 
#
#
REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
branchName      stringtype
#############################################################################
#
#   REPOSITORY (Optional Section) - Fixed-Type Repository.
#   This section tells about the Repository Information. A  Repository  is  a
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#   Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#
#############################################################################
#REPOSITORY argv4
#ipsetId         stringtype
#ipacnumber      stringtype
#ipdate		stringtype
# 
#MASSAGERECORD
#############################################################################
#
#   MASSAGERECORD (Optional Section).
#   The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#   later. This Block is executed every time a new record is read.
#
#############################################################################
# 
#
#IGNORERECORD
#############################################################################
#
#   IGNORERECORD (Optional Section).
#   The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
#   for input records), the record is Ignored.
#
#############################################################################
#
#
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
LinesPerPage 64
Topmargin       1
BottomMargin 1
columnsPerLine 100
pageHeaderLines 1
pageFooterLines 1
#
ONSTARTOFREPORT
#################################################################### 

#
#
PAGEHEADER
####################################################################
#pageheader on each page
####################################################################

#
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
separatorline
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################

print "DATE:  " column 2
print today size 10
nextline
nextline
print "FROM " column 2
nextline
nextline
print "EQUITY BANK LTD, " column 2
nextline
print "P.O. BOX 75104," column 2
nextline
print "NAIROBI," column 2
nextline
print "KENYA. " column 2
nextline
nextline
nextline
print "TO "  column 2
nextline
nextline
print acct_name column 2
nextline
print cust_comu_addr1  column 2
nextline
nextline
nextline

print "Dear Sir / Madam , " column 2
nextline
nextline
print "RE: DEPOSIT ACCOUNT NO.  " column 2
print foracid
nextline
print "______________________________________________" column 2
nextline
nextline
print "We write to advise you that your deposit for the above mentioned account for " column 2
print acct_crncy_code
print " "
print deposit_amount format "###,###,###.##"
print "/- "
nextline
print "will fall due on " column 2
print maturity_date
print "."
nextline
print "We will be most happy to renew the said deposit if you will let us have your instructions to " column 2
nextline
print "that effect by returning to us the fixed deposit receipt duly signed on reverse.If you require " column 2
nextline
print "any clarifications or information, please do not hesitate to contact the undersigned." column 2
nextline
print "In the absence of any instructions, upon maturity the deposit will be transferred to a " column 2
nextline
print "call deposit account where it will continue to earn interest at a prevailing rate until " column 2
nextline
print "we hear from you. We thank you for your support and await your early response." column 2
nextline
nextline
nextline
nextline
print "Yours faithfully, " column 2
nextline
nextline
nextline
nextline
nextline
nextline
nextline
print "Branch Manager " column 2
nextline
nextline
nextline
nextpage

