#---------------------------------------------------------------
#######################################################################
<--start

#===========================================================================================*
#  <Serial No.>  <Date>         <AuthorName>          	<Description>
#--------------------------------------------------------------------------
# 	
# 	
#============================================================================================*


TRACE ON

#-----------------------------------------------------------------
# Initialise is used to Check whether Class ATM exists.
# If not then creates that class.
# 5 stands for String Type data.
#-----------------------------------------------------------------
Initialise:
#{
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
		CREATEREP("CUST")
	ENDIF

	sv_r = CLASSEXISTS("CUST", "ATM")
	IF (sv_r == 0) THEN
		CREATECLASS("CUST", "ATM", 5)
	ENDIF
	
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------

	sv_r = REPEXISTS("MTT")
	IF (sv_r == 0) THEN
		CREATEREP("MTT")
	ENDIF

	sv_r = CLASSEXISTS("MTT","TranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","TranDetails",5)
	ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","PartTranDetails",5)
	ENDIF

	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
		CREATEREP("BANCS")
	ENDIF

	sv_r = CLASSEXISTS("BANCS","INPARAM")
	IF (sv_r == 0) THEN
		CREATECLASS("BANCS","INPARAM",5)
	ENDIF
	IF(REPEXISTS("CUST") == 0 ) THEN
		CREATEREP("CUST")
	ENDIF

	IF (CLASSEXISTS("CUST","ATM") == 0) THEN
		CREATECLASS("CUST","ATM",5)
	ENDIF
	
	
	sv_r = urhk_MTTS_PopulateInputDetails("")
	print(sv_r)
	
	if(sv_r==0)then
	#{
		#BANCS.OUTPUT.CrForacid = MTT.InputDetails.Argument1
		#print(BANCS.OUTPUT.CrForacid)
		BANCS.OUTPUT.Foracid = MTT.InputDetails.Argument1
		print(BANCS.OUTPUT.Foracid)
		BANCS.OUTPUT.DccId = MTT.InputDetails.Argument2
		print(BANCS.OUTPUT.DccId)
		BANCS.INPUT.TranAmt = MTT.InputDetails.Argument3
		print(BANCS.INPUT.TranAmt)
		BANCS.INPUT.SerialNum = MTT.InputDetails.Argument4
		print(BANCS.INPUT.SerialNum)
		BANCS.OUTPUT.TranCrncy = MTT.InputDetails.Argument5
		print(BANCS.OUTPUT.TranCrncy)
		BANCS.INPUT.Command = MTT.InputDetails.Argument6
		print(BANCS.INPUT.Command)
	#}
	else
	#{
		exitscript
	#}
	endif
	
	#------------------------------------------------------------------
	
	CUST.ATM.drAccount=BANCS.OUTPUT.Foracid
	CUST.ATM.DccId=BANCS.OUTPUT.DccId
	CUST.ATM.narr1="MINISTATEMENT-CHARGE"
	
	#*** GET THE COMMISION GL ***#



IF(CUST.ATM.drAccount != "" ) THEN
#{
	sv_t= urhk_getAcctDetailsInRepository(CUST.ATM.drAccount)
	print(sv_t)
	
	IF (sv_t == 0) THEN
	#{
		BANCS.INPUT.SolId = BANCS.OUTPARAM.acctSolId
		BANCS.OUTPUT.SolId = BANCS.OUTPARAM.acctSolId
		CUST.ATM.TranCrncy = BANCS.OUTPARAM.acctCrncyCode
		Print(CUST.ATM.TranCrncy)
	#}
	ENDIF
#}
ENDIF


CUST.ATM.pnlBacid = "PNLSAATM"		

sv_a = CUST.ATM.pnlBacid+"|"+BANCS.STDIN.homeCrncyCode+"|"+BANCS.INPUT.SolId
sv_k =  urhk_B2k_BacidToAcctId(sv_a)
print(sv_k)

if (sv_k == 0) then
	CUST.ATM.crAccount= BANCS.OUTPARAM.AcctId
	PRINT(CUST.ATM.crAccount)
ELSE
	CUST.ATM.crAccount = ""
endif

IF (BANCS.INPUT.Command == "") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE

	CUST.ATM.cmd=BANCS.INPUT.Command 
	
ENDIF

BANCS.INPUT.moduleName = "ATM"
BANCS.INPUT.parameterId = "EVENT_ID"
CALL ("atmgetcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.ATM.eventId= BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.ATM.errMsg = "eventid setup not done in CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "EVENT_TYPE_1"
CALL ("atmgetcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.ATM.eventType = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.ATM.errMsg = "eventid setup not done in CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF


#--------------------------------------------------------------------------
# getting the amount to split
#--------------------------------------------------------------------------
BANCS.INPUT.TranAmt=cdouble(BANCS.INPUT.TranAmt)/cdouble("100")
print(BANCS.INPUT.TranAmt)
PRINT(BANCS.INPUT.SerialNum)

CUST.ATM.serialrrn=""
print(CUST.ATM.serialrrn)

CUST.ATM.serialauthcode= LTRIM(BANCS.INPUT.SerialNum,'0') 
print(CUST.ATM.serialauthcode)

IF (BANCS.INPUT.TranAmt == "0") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE
	CUST.ATM.Amount=BANCS.INPUT.TranAmt
	print(CUST.ATM.Amount)

	IF (CUST.ATM.DccId=="KEN") THEN
		IF (FIELDEXISTS(CUST.ATM.FeeAmount)) THEN
			print(CUST.ATM.FeeAmount)
			CUST.ATM.Amount=CUST.ATM.FeeAmount
			print(CUST.ATM.Amount)
		ENDIF
	ENDIF
	
	#--------------------------------------------------------------------------
	# Create the narration
	#--------------------------------------------------------------------------
	
	sv_e = MID$(BANCS.STDIN.BODDate,0,10)
	print(sv_e)
	sv_s = "sysdate "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
	sv_s = sv_s + " FROM DUAL"
	BANCS.INPARAM.BINDVARS = sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d =="0") THEN
		CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
		IF (CUST.ATM.DccId=="SMS") THEN 
			CUST.ATM.narr1 ="M-KESHO MINISTATEMENT CHARGE" + "/" + CUST.ATM.serialauthcode + "/" + CUST.ATM.sysdate
		ENDIF
		IF (CUST.ATM.DccId=="EAZ") THEN 
			CUST.ATM.narr1 ="EAZZY-MINISTATEMENT-CHARGE" + "/" + CUST.ATM.serialauthcode + "/" + CUST.ATM.sysdate
		ENDIF
		IF (CUST.ATM.DccId=="OMK") THEN 
			CUST.ATM.narr1 ="ORANGEM-MINISTATEMENT-CHARGE" + "/" + CUST.ATM.serialauthcode + "/" + CUST.ATM.sysdate
		ENDIF
		IF (FIELDEXISTS(BANCS.INPUT.ReservedField3)) THEN 
			CUST.ATM.serialrrn = ltrim(BANCS.INPUT.ReservedField3,'0')
			print(CUST.ATM.serialrrn)
		ENDIF

		IF (CUST.ATM.DccId=="KEN") THEN 
			IF (BANCS.INPUT.Command == "MSIR") THEN
				CUST.ATM.narr1 ="INT-MINIST-CHARGE" + "/" + CUST.ATM.serialrrn + "/" + CUST.ATM.serialauthcode + "/" +  CUST.ATM.sysdate 
				print(CUST.ATM.narr1)
			ENDIF
			IF (BANCS.INPUT.Command == "BLIR") THEN
				CUST.ATM.narr1 ="INT-BAL_INQ-CHARGE" + "/" + CUST.ATM.serialrrn + "/" + CUST.ATM.serialauthcode + "/" +  CUST.ATM.sysdate
				print(CUST.ATM.narr1)
			ENDIF
		ENDIF
		
		#*** BAL INQ && MINSTATEMENT START - HARRISON ***#
		
		IF (CUST.ATM.DccId=="SWT") THEN 
		
			IF (FIELDEXISTS(BANCS.OUTPUT.ReservedField3)) THEN 
				CUST.ATM.serialrrn = ltrim(BANCS.I.ReservedField3,'0')
				print(CUST.ATM.serialrrn)
			ENDIF
			
			IF (BANCS.INPUT.Command == "MSIR") THEN
				CUST.ATM.narr1 ="INT-MINIST-CHARGE" + "/" + CUST.ATM.serialauthcode + "/" +  CUST.ATM.sysdate 
				print(CUST.ATM.narr1)
			ENDIF
			IF (BANCS.INPUT.Command == "BLIR") THEN
				CUST.ATM.narr1 ="INT-BAL_INQ-CHARGE" + "/" + CUST.ATM.serialauthcode + "/" +  CUST.ATM.sysdate
				print(CUST.ATM.narr1)
			ENDIF
		ENDIF
		
		#*** BAL INQ && MINSTATEMENT END - HARRISON ***#
	ELSE
		GOTO ENDOFSCRIPT
	ENDIF
	
	

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType="T"
	MTT.TranDetails.TranSubType="BI"

	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="N"
	BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"

	#sv_u = urhk_MTTS_Initialize("")
	#print(sv_u)

	sv_v = "PurchaseComm"
	print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
	print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		CUST.ATM.errMsg = MTT.Error.Description
		PRINT(CUST.ATM.errMsg)
		exitscript
	#}
	ENDIF

	#sv_u = urhk_MTTS_PopulateInputDetails("")
	
	sv_b = BANCS.INPUT.TranAmt
	print(sv_b)
	
	CUST.ATM.chrgAmt = sv_b
	print(CUST.ATM.chrgAmt)
	
	IF (CUST.ATM.DccId=="KEN") THEN
		IF (FIELDEXISTS(CUST.ATM.FeeAmount)) THEN
			print(CUST.ATM.FeeAmount)
			sv_b=CUST.ATM.FeeAmount
			print(sv_b)
			
			CUST.ATM.chrgAmt = sv_b
			print(CUST.ATM.chrgAmt)
		ENDIF
	ENDIF
		#--------------------------------------------------
		# Income To EQUITY PURCHASES COMM A/C
		#--------------------------------------------------
			print(CUST.ATM.TranCrncy)
			print(BANCS.STDIN.homeCrncyCode)
	
	
	if((CUST.ATM.TranCrncy) != (BANCS.STDIN.homeCrncyCode))then
	#{
	
		CUST.ATM.ref_crncy_code = BANCS.STDIN.homeCrncyCode
		CUST.ATM.rateCode = "TTS"
		CUST.ATM.fcyFlg = "Y"
		CUST.ATM.ref_amt = CDOUBLE(CUST.ATM.chrgAmt)
		CUST.ATM.tran_crncy = CUST.ATM.TranCrncy
		
		#=======================================#
		#      Conver amount to other currency  #
		#=======================================#
		BANCS.INPARAM.InputAmount       = CDOUBLE(CUST.ATM.chrgAmt)
		BANCS.INPARAM.FromCurrency      = BANCS.STDIN.homeCrncyCode
		#BANCS.INPARAM.ToCurrency        = CUST.ATM.ref_crncy_code
		BANCS.INPARAM.ToCurrency        = CUST.ATM.TranCrncy
		#BANCS.INPARAM.RateCode          = "TTS"
		BANCS.INPARAM.RateCode          = CUST.ATM.rateCode
		BANCS.INPARAM.Rate              = ""
		
		sv_r = urhk_B2k_ConvertAmount("")
		print(sv_r)
		IF(sv_r == 0) THEN
		#{
			CUST.ATM.tran_amt = BANCS.OUTPARAM.OutputAmount
			print(CUST.ATM.tran_amt)
		#}
		ENDIF
	else
		CUST.ATM.rateCode = "NOR"
		CUST.ATM.tran_amt = CDOUBLE(CUST.ATM.chrgAmt)
		print(CUST.ATM.tran_amt)
		CUST.ATM.fcyFlg = "N"
		CUST.ATM.ref_amt = CDOUBLE(CUST.ATM.chrgAmt)
		print(CUST.ATM.ref_amt)
		CUST.ATM.tran_crncy = CUST.ATM.TranCrncy
		print(CUST.ATM.tran_crncy)
	#}
	ENDIF
		
	#------------------------------------------------------------------
	# Credit Leg 
	#-----------------------------------------------------------------
	
	
	MTT.PartTranDetails.Account             = CUST.ATM.crAccount
	MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.TranCurrency        = CUST.ATM.tran_crncy
	MTT.PartTranDetails.Particulars         = CUST.ATM.narr1
	MTT.PartTranDetails.RefAmount           = (cdouble(CUST.ATM.ref_amt))
	MTT.PartTranDetails.Amount              = (cdouble(CUST.ATM.tran_amt))
	print(MTT.PartTranDetails.Amount)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.RateCode            = ""
	MTT.PartTranDetails.TranIdentifier      = sv_v
	MTT.PartTranDetails.Consolidate         = "N"
	MTT.PartTranDetails.ValueDateDiff       = "0"
	MTT.PartTranDetails.Remarks             = ""
	MTT.PartTranDetails.IgnoreExcp = "I"

	sv_e = "PurchaseIncome"
	sv_u = urhk_MTTS_definePartTran(sv_e)
	print(sv_u)

	#------------------------------------------------------------------
	# Debit Customer
	#-----------------------------------------------------------------

	MTT.PartTranDetails.Account = CUST.ATM.drAccount
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.TranCurrency = CUST.ATM.tran_crncy
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATM.narr1
	MTT.PartTranDetails.RefAmount = -1 * CDOUBLE(CUST.ATM.ref_amt)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.RateCode = CUST.ATM.rateCode
	MTT.PartTranDetails.Rate                = ""
	MTT.PartTranDetails.Amount = -1 * CDOUBLE(CUST.ATM.tran_amt)
	print(MTT.PartTranDetails.Amount)
	MTT.PartTranDetails.Remarks = "" 
	MTT.PartTranDetails.RefNum = "" 
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = "D" + CUST.ATM.drAccount
	
	sv_u = urhk_MTTS_definePartTran(sv_h)
	print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		CUST.ATM.errMsg = MTT.Error.Description
		PRINT(CUST.ATM.errMsg)
		exitscript
	#}
	ENDIF
	
	sv_u = urhk_MTTS_EndDefinition("")
	print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		CUST.ATM.errMsg = MTT.Error.Description
		PRINT(CUST.ATM.errMsg)
		exitscript
	#}
	ENDIF
		
	sv_u = urhk_MTTS_Close("")
	print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_r = urhk_MTTS_ReportErrorCondition("")
		CUST.ATM.errMsg = MTT.Error.Description
		PRINT(CUST.ATM.errMsg)
		exitscript
	#}
	ENDIF

	if(FieldExists(BANCS.OUTPARAM.MTTTranId)) then
		print(BANCS.OUTPARAM.MTTTranId)
	endif
	
ENDIF

ENDOFSCRIPT:
	exitscript

TRACE OFF
END-->
