<--start
trace on
IF(REPEXISTS("CUST") == 0 ) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","ATM") == 0) THEN
#{
        CREATECLASS("CUST","ATM",5)
#}
ENDIF
CUST.ATM.errMsg = ""

#BANCS.OUTPUT.successOrFailure = "S"
#sv_r = urhk_MTTS_PopulateInputDetails("")
#print (sv_r)
#sv_r=urhk_B2K_PRINTREPOS("MTT")
#print (sv_r)
#sv_b = urhk_MTTS_DefineTransaction("charges")
#print(sv_b)

BANCS.OUTPUT.userTranCode="" 

#sv_a=urhk_B2K_PrintRepos("BANCS")
#print(sv_a)

if ((BANCS.INPUT.DccId =="BWY") AND ((BANCS.INPUT.Command=="TRTR") OR (BANCS.INPUT.Command=="TRRR")))  then
	#print("BANKADM")
	BANCS.OUTPUT.ConsCustPtrans = "N"
	BANCS.OUTPUT.ConsContraPtrans = "N"
endif


sv_a= MID$(BANCS.INPUT.CustCardId,0,6)
#print(sv_a)

BANCS.INPUT.moduleName  = "ATM"
BANCS.INPUT.parameterId = "CUSTCARDID1"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATM.custCardId1 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.ATM.errMsg = "Cust Card Id 1 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.moduleName  = "ATM"
BANCS.INPUT.parameterId = "CUSTCARDID2"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATM.custCardId2 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.ATM.errMsg = "Cust Card Id 2 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "CUSTCARDID10"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.ATM.custCardId10 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.ATM.errMsg = "Cust Card Id 2 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF


IF ((sv_a != CUST.ATM.custCardId1) AND (sv_a != CUST.ATM.custCardId2) AND (sv_a != CUST.ATM.custCardId10)) THEN
	print("LORO")
	BANCS.OUTPUT.successOrFailure = "S"
	GOTO ENDOFSCRIPT
ENDIF

BANCS.OUTPUT.ConsCustPtrans="N"
BANCS.OUTPUT.ConsContraPtrans="N"

#sv_a=urhk_B2K_PrintRepos("BANCS")
                #print(sv_a)

ENDOFSCRIPT:
exitscript
end-->
