	sv_s = sv_s + " FROM DUAL"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.tran_date
	sv_u = urhk_dbselectWithBind(sv_s)
	PRINT(sv_u)
	IF ( sv_u == "0" ) THEN
