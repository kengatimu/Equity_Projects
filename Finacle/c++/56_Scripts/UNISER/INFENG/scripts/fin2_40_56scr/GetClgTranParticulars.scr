		ENDIF
		sv_q = "freetext5,biller_id,biller_ref_num,tran_particulars,clg_zone_code,set_num|select FREETEXT5,BILLER_ID,BILLER_REF_NUM,TRAN_PARTICULARS,CLG_ZONE_CODE,SET_NUM from custom.C_UBP_details where BILLER_ID='2587' AND MODE_OF_PAY='L'  "
		sv_q = sv_q + " AND BILLER_ACCT_ID='1000200319006' AND BILLER_BNK_ID='56' "
		sv_q = sv_q + " AND set_num=?SVAR AND TRAN_DATE=?SVAR AND CLG_ZONE_CODE=?SVAR AND ROWNUM = 1 "
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.setNum + "|" + STDWFS.GLBDATA.getsysdate + "|" + BANCS.INPUT.clgZoneCode
		sv_d = urhk_dbSelectWithBind(sv_q)
		print(sv_d)
		IF(sv_d == 0)THEN
		#{
			STDWFS.GLBDATA.freetext5 = BANCS.OUTPARAM.freetext5
			print(STDWFS.GLBDATA.freetext5)
			STDWFS.GLBDATA.biller_id = BANCS.OUTPARAM.biller_id
			print(STDWFS.GLBDATA.biller_id)
			STDWFS.GLBDATA.biller_ref_num = BANCS.OUTPARAM.biller_ref_num
			print(STDWFS.GLBDATA.biller_ref_num)
			STDWFS.GLBDATA.tran_particulars = BANCS.OUTPARAM.tran_particulars
			print(STDWFS.GLBDATA.tran_particulars)
			
			BANCS.INPUT.instNum = TRIM(BANCS.INPUT.instNum)
			sv_d = BANCS.INPUT.instNum
			print(sv_d)
			sv_f ="Chq:"
			print(sv_f)
			BANCS.OUTPUT.tranParticulars = sv_f + " " + sv_d
			print(BANCS.OUTPUT.tranParticulars)
			BANCS.OUTPUT.tranParticulars = BANCS.OUTPUT.tranParticulars + " " + STDWFS.GLBDATA.tran_particulars
			print(BANCS.OUTPUT.tranParticulars)
			BANCS.OUTPUT.tranParticulars = Mid$(BANCS.OUTPUT.tranParticulars,0,50)
			print(BANCS.OUTPUT.tranParticulars)
			BANCS.OUTPUT.tranRemarks = STDWFS.GLBDATA.biller_ref_num + "||" + STDWFS.GLBDATA.freetext5
			print(BANCS.OUTPUT.tranRemarks)
			BANCS.OUTPUT.tranRemarks = LEFT$(BANCS.OUTPUT.tranRemarks,30)
			print(BANCS.OUTPUT.tranRemarks)
		#}
		ENDIF
		
	#}
	ENDIF
	print(BANCS.OUTPUT.tranParticulars)
	BANCS.OUTPUT.tranParticulars = LEFT$(BANCS.OUTPUT.tranParticulars,50)
	print(BANCS.OUTPUT.tranParticulars)
	
	BANCS.OUTPUT.tranRemarks = LEFT$(BANCS.OUTPUT.tranRemarks,30)
	print(BANCS.OUTPUT.tranRemarks)
	
	
	
	#BANCS.OUTPUT.tranRemarks = ""
	FINISH:
		IF (OCTR.GLBVAR.errMsg != "") THEN
		#{
			sv_a = urhk_SRV_SetErr(OCTR.GLBVAR.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
