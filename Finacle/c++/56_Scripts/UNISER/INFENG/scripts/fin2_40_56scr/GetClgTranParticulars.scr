	IF(sv_d == 0) THEN
	#{
		# Biller transaction
		print(BANCS.OUTPARAM.cnt)
		IF(CINT(BANCS.OUTPARAM.cnt) != 0)THEN
		#{
			OCTR.GLBVAR.billerFlg = "Y"
			sv_q = "billerId|SELECT BILLER_ID FROM CUSTOM.C_UBP "
			sv_q = sv_q + " WHERE FREETEXT7 = ?SVAR AND BILLER_BNK_ID = ?SVAR "
