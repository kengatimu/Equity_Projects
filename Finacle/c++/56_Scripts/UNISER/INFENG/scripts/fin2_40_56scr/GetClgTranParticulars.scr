			#{
				IF(BANCS.OUTPARAM.billerId == "2588")THEN
				#{
					IF(FIELDEXISTS(BANCS.INPUT.OCPFreeText1))THEN
					#{
						BANCS.OUTPUT.tranRemarks = BANCS.INPUT.OCPFreeText1 + " " + BANCS.OUTPUT.tranRemarks
