#----------Getting the bacid
#-------------------------------------------Un commsion
BANCS.INPUT.parameterId = "TRANFEEACCT_17"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.ATM.tranFeeAcct17 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.ATM.errMsg = "Fee Account setup not done CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF
#-------------------------------------------End


IF (BANCS.INPUT.DccId == "SWT")  THEN
 CUST.ATM.bacid=CUST.ATM.bacid8
print(CUST.ATM.bacid)
ENDIF

IF ((BANCS.INPUT.DccId == "HPD")OR (BANCS.INPUT.DccId == "WPD"))  THEN
	CUST.ATM.bacid=CUST.ATM.bacid9
	print(CUST.ATM.bacid)
ENDIF

IF (BANCS.INPUT.DccId == "EAZ")  THEN
 CUST.ATM.bacid=CUST.ATM.bacid1
 #print(CUST.ATM.bacid)
ENDIF

IF (BANCS.INPUT.DccId == "TPG")  THEN
 CUST.ATM.bacid=CUST.ATM.bacid1
 #print(CUST.ATM.bacid)
ENDIF

IF (BANCS.INPUT.DccId == "EAZ")  THEN
	IF (BANCS.INPUT.ReservedField2=="UNBLOCK")  THEN
		CUST.ATM.bacid="AGENTPOOLWD"
		print(CUST.ATM.bacid)
	ENDIF
ENDIF
IF (BANCS.INPUT.DccId == "EAZ") THEN
	IF ((BANCS.INPUT.ReservedField2=="P2PIntraMerWCB") OR (BANCS.INPUT.ReservedField2=="P2MEazPayOnline") OR (BANCS.INPUT.ReservedField2=="P2PIntraMerCB") OR (BANCS.INPUT.ReservedField2=="P2PIntraMer") OR (BANCS.INPUT.ReservedField2=="P2PIntraMerPayBill")) THEN
		CUST.ATM.bacid="EAZZYPAYINCOME"
		print(CUST.ATM.bacid)
		IF (BANCS.INPUT.ReservedField2=="P2PIntraMerCB") THEN
			CUST.ATM.bacid="EAZZYCASHBKPOOL"
			print(CUST.ATM.bacid)
		ENDIF
		IF (BANCS.INPUT.CrForacid!="") THEN
			sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
			IF (sv_u != 0) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ELSE
			 CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
			ENDIF
		ENDIF
		IF ((BANCS.INPUT.ReservedField2=="P2PIntraMer") OR (BANCS.INPUT.ReservedField2=="P2PIntraMerPayBill")) THEN
			IF (FIELDEXISTS(BANCS.INPUT.DeviceId) == 1) THEN
				CUST.ATM.solid = mid$(BANCS.INPUT.DeviceId,0,4)
				print(CUST.ATM.solid)
				sv_k = "Countsolid| SELECT count(1) "
				sv_k = sv_k + " from tbaadm.sol "
				sv_k = sv_k + " where sol_id = ?SVAR "
				sv_k = sv_k + " AND BANK_ID = ?SVAR "
				sv_k = sv_k + " AND del_flg = 'N' "
				BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				PRINT(sv_k)
				sv_h = urhk_dbselectWithBind(sv_k)
				PRINT(sv_h)
				IF (sv_h  == 0) THEN
					CUST.ATM.Countsolid = BANCS.OUTPARAM.Countsolid
					PRINT(CUST.ATM.Countsolid)
					IF (CINT(CUST.ATM.Countsolid)<1) THEN
						BANCS.OUTPUT.ReservedField3 = "Please Supply Valid Sol_id "
						print(BANCS.OUTPUT.ReservedField3)
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						EXITSCRIPT
					ENDIF
				ELSE
					BANCS.OUTPUT.ReservedField3 = "Please Supply Valid Sol_id "
					print(BANCS.OUTPUT.ReservedField3)
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					EXITSCRIPT
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
IF (BANCS.INPUT.DccId == "AIR")  THEN
	#CUST.ATM.bacid=CUST.ATM.bacid1
	#print(CUST.ATM.bacid)
ENDIF

IF (BANCS.INPUT.DccId == "WAR")  THEN
	CUST.ATM.bacid=CUST.ATM.bacid11
	#print(CUST.ATM.bacid)
ENDIF

IF (BANCS.INPUT.DccId == "OMU")  THEN
	CUST.ATM.bacid= CUST.ATM.bacid3
	#print(CUST.ATM.bacid)
ENDIF

IF (BANCS.INPUT.DccId == "MTI")  THEN
	CUST.ATM.bacid=CUST.ATM.bacid11
	#print(CUST.ATM.bacid)
ENDIF

######## start ebanking fee contra account ###3

IF (BANCS.INPUT.DccId == "BWY")  THEN
	CUST.ATM.bacid=CUST.ATM.bacid7
	print(CUST.ATM.bacid)
ENDIF
IF ((BANCS.INPUT.DccId == "OMU") OR (BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "WAR") ) THEN
	IF ((BANCS.INPUT.ReservedField2=="BulkHD") OR (BANCS.INPUT.ReservedField2=="BulkTR")) THEN
		CUST.ATM.bacid= CUST.ATM.bacid4
		#print(CUST.ATM.bacid)
	ENDIF
ENDIF

#--- Inculusion for WAY4 POS
IF (BANCS.INPUT.DccId=="WPD") THEN
	#PRINT("WAY4 POS")
	BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.tranFeeAcct12
	IF (BANCS.INPUT.DeviceId!="") THEN
		sv_a= MID$(BANCS.INPUT.DeviceId,0,2) 
		print(sv_a) 
		IF (sv_a=="BP") THEN
			CUST.ATM.bacid="AGENTPOOLWDPOS"
			print(CUST.ATM.bacid)
		ENDIF
		IF (sv_a=="UA") THEN
			CUST.ATM.bacid="AGENTPOOLWDPOS"
			print(CUST.ATM.bacid)
		ENDIF
		#-----------------------------Un pos
		if((sv_a=="UN")or(sv_a=="UW"))then
			sv_s = "sol_id,account,freetext|select agt.sol_id,gam.foracid,agt.FREE_TEXT from agt,gam "
			sv_s = sv_s + "where agt.OPER_CREDIT_ACID=gam.acid and gam.ACCT_CLS_FLG!='Y'"
			sv_s = sv_s + " and Agent_code = ?SVAR"
			sv_s = sv_s + " AND AGT.del_flg !='Y' AND rownum<2"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF  (sv_d == "0") then
				print(BANCS.OUTPARAM.account)
				CUST.ATM.posaccount=BANCS.OUTPARAM.account
				CUST.ATM.possol=BANCS.OUTPARAM.sol_id
				print(BANCS.OUTPARAM.sol_id)
				print(BANCS.OUTPARAM.freetext)
				print(CUST.ATM.posaccount)
				print(CUST.ATM.possol)

				BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.possol + CUST.ATM.tranFeeAcct17
				print(BANCS.OUTPUT.TranFeeContraAcct1)
			else
				BANCS.OUTPUT.RespCode = "03"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			endif

				
		endif
	ENDIF
ENDIF
#--- Inculusion for WAY4 POS
IF (BANCS.INPUT.DccId=="WPD") THEN
	sv_a= MID$(BANCS.INPUT.DeviceId,0,2) 
	print(sv_a) 
	IF (sv_a=="UA") THEN
		sv_s = "sol_id,account,freetext|select agt.sol_id,gam.foracid,agt.FREE_TEXT from agt,gam "
		sv_s = sv_s + "where agt.OPER_CREDIT_ACID=gam.acid and gam.ACCT_CLS_FLG!='Y'"
		sv_s = sv_s + " and Agent_code = ?SVAR"
		sv_s = sv_s + " AND AGT.del_flg !='Y' AND rownum<2"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId
		sv_d =urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF  (sv_d == "0") then
			print(BANCS.OUTPARAM.account)
			CUST.ATM.posaccount=BANCS.OUTPARAM.account
			CUST.ATM.possol=BANCS.OUTPARAM.sol_id
			print(BANCS.OUTPARAM.sol_id)
			print(BANCS.OUTPARAM.freetext)
			print(CUST.ATM.posaccount)
			print(CUST.ATM.possol)
			BANCS.OUTPARAM.freetext=rtrim(ltrim(BANCS.OUTPARAM.freetext))
			IF ((BANCS.OUTPARAM.freetext !="CASHLESS") AND (BANCS.OUTPARAM.freetext !="KCEP")) THEN 
				IF ((BANCS.INPUT.Command == "CDAR") OR (BANCS.INPUT.Command == "CDRR")) THEN 
					IF (BANCS.INPUT.Foracid != "") THEN
						BANCS.OUTPUT.TranFeeContraAcct1=BANCS.INPUT.Foracid
					ELSE
						BANCS.OUTPUT.TranFeeContraAcct1=BANCS.OUTPARAM.account
					ENDIF
						call("AgentShare.scr")
						IF ( (FIELDEXISTS(CUST.ATM.DbCrncyCode)) AND (FIELDEXISTS(CUST.ATM.CrCrncyCode)) ) THEN
							IF (CUST.ATM.DbCrncyCode!=CUST.ATM.CrCrncyCode) THEN
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure = "F"
								GOTO ENDOFSCRIPT
							ENDIF
						ENDIF
				ELSE
					BANCS.OUTPUT.TranFeeContraAcct1=CUST.ATM.possol + CUST.ATM.tranFeeAccount3
					print(BANCS.OUTPUT.TranFeeContraAcct1) 
					sv_y=BANCS.INPUT.ReservedField2
					sv_c=mid$(sv_y,0,5)
					print(sv_c)
					IF ((sv_c =="BILL:") OR (sv_c =="COLL:") OR (sv_c =="ACCT:")) THEN
						call("Thirdparty.scr")
						IF ( (FIELDEXISTS(CUST.ATM.DbCrncyCode)) AND (FIELDEXISTS(CUST.ATM.CrCrncyCode)) ) THEN
							IF (CUST.ATM.DbCrncyCode!=CUST.ATM.CrCrncyCode) THEN
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure = "F"
								GOTO ENDOFSCRIPT
							ENDIF
						ENDIF
					ELSE
						call("AgentShare.scr")
						IF ( (FIELDEXISTS(CUST.ATM.DbCrncyCode)) AND (FIELDEXISTS(CUST.ATM.CrCrncyCode)) ) THEN
							IF (CUST.ATM.DbCrncyCode!=CUST.ATM.CrCrncyCode) THEN
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure = "F"
								GOTO ENDOFSCRIPT
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ELSE
				print("cashless distribution pos")
				BANCS.OUTPUT.TranFeeContraAcct1=BANCS.OUTPARAM.sol_id+CUST.ATM.tranFeeAccount4
				print(BANCS.OUTPUT.TranFeeContraAcct1)
			ENDIF
		ENDIF
	else
		#-----------------------------------Un split
		if((sv_a=="UN")or (sv_a=="UW"))then
			call("AgentUNShare.scr")
			IF ( (FIELDEXISTS(CUST.ATM.DbCrncyCode)) AND (FIELDEXISTS(CUST.ATM.CrCrncyCode)) ) THEN
				IF (CUST.ATM.DbCrncyCode!=CUST.ATM.CrCrncyCode) THEN
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					GOTO ENDOFSCRIPT
				ENDIF
			ENDIF
		endif

	ENDIF
ENDIF

#------Getting the contra account BWY added ####

IF ((BANCS.INPUT.DccId == "SWT") OR (BANCS.INPUT.DccId == "TPG") OR (BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "BWY") OR (BANCS.INPUT.DccId == "WAR") OR (BANCS.INPUT.DccId == "OMU") OR (BANCS.INPUT.DccId == "MTI") OR (BANCS.INPUT.DccId == "AIR")) then
	print("amin")
	print(CUST.ATM.bacid)
	#-----------------Edwin for Agent commission
	if((BANCS.INPUT.DccId == "EAZ") and (BANCS.INPUT.ReservedField2=="UNBLOCK"))then
		sv_b = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
		if(sv_b==0)then
			CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
		CUST.ATM.bacid = "AGENTCOMMINC"
		else
			print(CUST.ATM.solid)
		endif
	endif
	#-----------------------------------------Edwin for Agent commission
	sv_x = "contra|select foracid from tbaadm.GAM where BANK_ID = ?SVAR AND sol_id = ?SVAR"
	sv_x = sv_x + " and BACID = ?SVAR"
	sv_x = sv_x + " and DEL_FLG ='N' "
	sv_x = sv_x + " AND acct_crncy_code = ?SVAR "
	print(sv_x)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.ATM.solid + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.homeCrncyCode
	sv_r =urhk_dbSelectWithBind(sv_x)
	print(sv_r)
	IF (sv_r == "0") THEN
		BANCS.OUTPUT.TranFeeContraAcct1= BANCS.OUTPARAM.contra
		#print(BANCS.OUTPUT.TranFeeContraAcct1)
		
		#--- Inculusion for Eazzy and Orange money Agecy
		IF (BANCS.INPUT.DccId == "OMU") THEN
			IF ((BANCS.INPUT.ReservedField2=="ATMWd") OR (BANCS.INPUT.ReservedField2=="CashIn") OR (BANCS.INPUT.ReservedField2=="CashOut") OR (BANCS.INPUT.ReservedField2=="UNBLOCK") OR (BANCS.INPUT.ReservedField2=="SendMoney")  OR (BANCS.INPUT.ReservedField2 == "WithDrawNon")) THEN

				IF (BANCS.INPUT.DccId=="OMU") THEN
					BANCS.OUTPUT.TranFeeContraAcct1=CUST.ATM.tranFeeAcct11
				ENDIF

				IF (BANCS.INPUT.ReservedField2 == "WithDrawNon")THEN
					BANCS.OUTPUT.TranFeeCustAcct1=BANCS.INPUT.CrForacid
					#print(BANCS.OUTPUT.TranFeeCustAcct1)
				ENDIF

			ENDIF
			IF (BANCS.INPUT.DccId == "OMU") THEN 
				IF ((BANCS.INPUT.ReservedField2=="P2PInter") OR (BANCS.INPUT.ReservedField2=="P2PIntra")) THEN
					BANCS.OUTPUT.TranFeeContraAcct1=CUST.ATM.tranFeeAcct11
					#print(BANCS.OUTPUT.TranFeeContraAcct1)
				ENDIF
			ENDIF
			IF ( BANCS.INPUT.ReservedField2 == "BulkTR")THEN
				BANCS.OUTPUT.TranFeeCustAcct1=BANCS.INPUT.CrForacid
				#print(BANCS.OUTPUT.TranFeeCustAcct1)
			ENDIF
		ENDIF
		
		BANCS.OUTPUT.successOrFailure = "S"		
	ELSE
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	ENDIF
	
ENDIF

IF (BANCS.INPUT.DccId=="TPG") THEN
	#------------------------------------------------------Edwin for TPG BROKER 01022023 CHG0032008 CTASK0014435
	#IF (BANCS.INPUT.ReservedField2=="CashOut") THEN
	IF ((BANCS.INPUT.ReservedField2=="CashOut") or (BANCS.INPUT.ReservedField2=="bankToWallet") or (BANCS.INPUT.ReservedField2=="airtimePurchase"))then
		IF (FIELDEXISTS(BANCS.INPUT.Foracid)) THEN
			BANCS.OUTPUT.TranFeeCustAcct1=BANCS.INPUT.Foracid
			print(BANCS.OUTPUT.TranFeeCustAcct1)
		ENDIF
	ELSE
		IF (FIELDEXISTS(BANCS.INPUT.CrForacid)) THEN
			BANCS.OUTPUT.TranFeeCustAcct1=BANCS.INPUT.CrForacid
			print(BANCS.OUTPUT.TranFeeCustAcct1)
		ENDIF
	ENDIF
ENDIF
#--- Inculusion for POS
IF (BANCS.INPUT.DccId == "HPD") THEN
	IF (BANCS.INPUT.CrForacid =="") THEN
		IF (FIELDEXISTS(BANCS.OUTPUT.TranFeeContraAcct1)) THEN
			print(BANCS.OUTPUT.TranFeeContraAcct1)
			sv_x = "contra|select MERCH_PURCHASE_PAYABLE from CUSTOM.C_MERCHANTS where BANK_ID = ?SVAR AND MERCHANT_ID = ?SVAR"
			sv_x = sv_x + "  and ENTITY_CRE_FLG = 'Y' and DEL_FLG ='N' "
			print(sv_x)
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.DeviceId
			sv_r =urhk_dbSelectWithBind(sv_x)
			print(sv_r)
			IF (sv_r == "0") THEN
				BANCS.OUTPUT.TranFeeContraAcct1= BANCS.OUTPARAM.contra
			ELSE
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ENDIF
			print(BANCS.OUTPUT.TranFeeContraAcct1)
		ENDIF
		
	ELSE
		sv_x = "contra|select foracid from tbaadm.GAM where BANK_ID = ?SVAR AND sol_id = ?SVAR"
		sv_x = sv_x + " and BACID = ?SVAR"
		sv_x = sv_x + " and DEL_FLG ='N' "
		sv_x = sv_x + " AND acct_crncy_code = ?SVAR "
		print(sv_x)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.ATM.solid + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.homeCrncyCode
		sv_r =urhk_dbSelectWithBind(sv_x)
		print(sv_r)
		IF (sv_r == "0") THEN
			BANCS.OUTPUT.TranFeeContraAcct1= BANCS.OUTPARAM.contra
			BANCS.OUTPUT.successOrFailure = "S"
			GOTO ENDOFSCRIPT
		ELSE
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		ENDIF
	ENDIF	
ENDIF

IF (BANCS.INPUT.DccId=="BWY") THEN
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
		print(BANCS.INPUT.ReservedField2)
		IF (BANCS.INPUT.ReservedField2=="SAI") THEN
			BANCS.OUTPUT.TranFeeCustAcct1 = BANCS.INPUT.CrForacid
			BANCS.OUTPUT.TranFeeCustAcct2 = BANCS.INPUT.CrForacid
			BANCS.OUTPUT.TranFeeCustAcct3 = BANCS.INPUT.CrForacid
		ENDIF
	ENDIF
	IF (FIELDEXISTS(BANCS.OUTPUT.TranFeeContraAcct1)) THEN
                BANCS.OUTPUT.TranFeeContraAcct1 = BANCS.OUTPUT.TranFeeContraAcct1
                print(BANCS.OUTPUT.TranFeeContraAcct1)
                BANCS.OUTPUT.TranFeeContraAcct2= BANCS.OUTPUT.TranFeeContraAcct1
                print(BANCS.OUTPUT.TranFeeContraAcct2)
                BANCS.OUTPUT.TranFeeContraAcct3 = BANCS.OUTPUT.TranFeeContraAcct1
                print(BANCS.OUTPUT.TranFeeContraAcct3)
        ENDIF
ENDIF

IF (BANCS.INPUT.DccId=="SWT") THEN
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
		sv_k = MID$(BANCS.INPUT.ReservedField2,0,3)
		print(sv_k)
		IF (sv_k=="SCO") THEN
			call("copyBancsToCustC24.scr")
			call("sacfeeug.scr")
			call("copyCust24ToBancs.scr")
		ENDIF
	ENDIF
ENDIF

IF (BANCS.INPUT.DccId=="EAZ") THEN
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
		IF ((BANCS.INPUT.ReservedField2=="CashIn") OR (BANCS.INPUT.ReservedField2 == "UNBLOCK")  OR (BANCS.INPUT.ReservedField2 == "Otherbill")) THEN
			print(CUST.ATM.solid)
			IF ((BANCS.INPUT.ReservedField2=="CashIn") or (BANCS.INPUT.ReservedField2 == "Otherbill")) THEN
				CUST.ATM.agtsolsolid=BANCS.INPUT.Foracid
				print(CUST.ATM.agtsolsolid)
			ENDIF
			IF (BANCS.INPUT.ReservedField2=="UNBLOCK") THEN
				CUST.ATM.agtsolsolid=BANCS.INPUT.CrForacid
				print(CUST.ATM.agtsolsolid)
			ENDIF
			sv_h = urhk_getAcctDetailsInRepository(CUST.ATM.agtsolsolid)
			IF (sv_h != 0) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ELSE
				 CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
				 print(CUST.ATM.solid)
			ENDIF
			print(CUST.ATM.solid)
			CUST.ATM.possol = CUST.ATM.solid
			print(CUST.ATM.possol)
			IF (FIELDEXISTS(BANCS.OUTPUT.TranFeeContraAcct1)) THEN
				print(BANCS.OUTPUT.TranFeeContraAcct1)
			ENDIF
			#---------------------------------------------Commission Waive Edwin z -INC0124123
			IF (FIELDEXISTS(BANCS.INPUT.CardAcceptorName)) THEN
				sv_a = mid$(BANCS.INPUT.CardAcceptorName,0,17)
				print(sv_a)
			ELSE
				 sv_a = ""	
			ENDIF
			if(sv_a !="EAZZY DEPOSIT_ABC")then
				call("copyBancsToCustC24.scr")
				call("AgentSharemob.scr")
				call("copyCust24ToBancs.scr")
			endif
			IF (FIELDEXISTS(BANCS.OUTPUT.successOrFailure)) THEN
				print(BANCS.OUTPUT.successOrFailure)
				IF (BANCS.OUTPUT.successOrFailure=="F") THEN
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.ReservedField3 = "Charges not collected"
					print(BANCS.OUTPUT.ReservedField3)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

