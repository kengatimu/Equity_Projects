IF ((BANCS.INPUT.DccId == "EFR") OR (BANCS.INPUT.DccId == "EFI")) THEN
	IF (BANCS.INPUT.ReservedField2=="efrwithdrawal") THEN
		print("amin")
		CUST.ATM.bacid="PNLCAC"
		print(CUST.ATM.bacid)
		IF (FIELDEXISTS(BANCS.INPUT.SolId)) THEN
			CUST.ATM.solid = BANCS.INPUT.SolId
			print(CUST.ATM.solid)
		ELSE
			CUST.ATM.solid ="1000"
			print(CUST.ATM.solid)
		ENDIF
		sv_x = "contra|select foracid from tbaadm.GAM where BANK_ID = ?SVAR AND sol_id = ?SVAR"
		sv_x = sv_x + " and BACID = ?SVAR"
		sv_x = sv_x + " and DEL_FLG ='N' "
		sv_x = sv_x + " AND acct_crncy_code = ?SVAR "
		print(sv_x)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.ATM.solid + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.homeCrncyCode
		sv_r =urhk_dbSelectWithBind(sv_x)
		print(sv_r)
		IF (sv_r == "0") THEN
			BANCS.OUTPUT.TranFeeContraAcct1= BANCS.OUTPARAM.contra
			print(BANCS.OUTPUT.TranFeeContraAcct1)
		ENDIF
	ENDIF
ENDIF

IF (BANCS.INPUT.DccId == "TPG") THEN
	IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum) == 1) THEN
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.ConsumerNum)
		IF (sv_u == 0) THEN
			IF (BANCS.OUTPARAM.schmCode=="INCOM") THEN
				BANCS.OUTPUT.TranFeeContraAcct1 = BANCS.INPUT.ConsumerNum
			ENDIF
		ENDIF
	ENDIF
ENDIF

########Cash Cloud Charge Collection Logic: CHG0034907 ##########
IF (BANCS.INPUT.DccId == "POL") THEN
	IF (BANCS.INPUT.ReservedField2 !="") THEN
		IF ( (BANCS.INPUT.ReservedField2 =="EAZYBIZ") OR (BANCS.INPUT.ReservedField2 =="EAZYBIZEFT") ) THEN
			IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum) == 1) THEN
				IF (BANCS.INPUT.ConsumerNum !="") THEN
					sv_p = getposition(BANCS.INPUT.ConsumerNum,"|")
					print (sv_p)
					IF (sv_p ==0 ) THEN
						sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.ConsumerNum)
						IF (sv_u == 0) THEN
							IF (BANCS.OUTPARAM.schmCode=="INCOM") THEN
								BANCS.OUTPUT.TranFeeContraAcct1 = BANCS.INPUT.ConsumerNum
							ELSE
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.ReservedField3 = "Income Account Defined is not INCOM Type GL:Field 63"
								BANCS.OUTPUT.successOrFailure="F"
							ENDIF
						ELSE
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.ReservedField3 = "Income Account Defined is invalid:Field 63"
							BANCS.OUTPUT.successOrFailure="F"
						ENDIF
					ELSE
						sv_m = MID$(BANCS.INPUT.ConsumerNum, 0, sv_p-1)
						PRINT(sv_m)
						sv_u = urhk_getAcctDetailsInRepository(sv_m)
						IF (sv_u == 0) THEN
							BANCS.OUTPUT.TranFeeCustAcct1 = sv_m			
						ELSE
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.ReservedField3 = "Debit Fee Acct Defined is invalid:Field 63"
							BANCS.OUTPUT.successOrFailure="F"			
						ENDIF
						sv_m = MID$(BANCS.INPUT.ConsumerNum,sv_p, 16)
						PRINT(sv_m)	
						sv_u = urhk_getAcctDetailsInRepository(sv_m)
						IF (sv_u == 0) THEN
							IF (BANCS.OUTPARAM.schmCode=="INCOM") THEN				
								BANCS.OUTPUT.TranFeeContraAcct1 = sv_m
							ELSE
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.ReservedField3 = "Income Account Defined is not INCOM Type GL:Field 63"
								BANCS.OUTPUT.successOrFailure="F"
							ENDIF
						ELSE
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.ReservedField3 = "Income Account Defined is invalid:Field 63"
							BANCS.OUTPUT.successOrFailure="F"
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
########END of Cash Cloud: CHG0034907 ##########

