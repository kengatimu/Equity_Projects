IF (sv_h != 0) THEN
	BANCS.OUTPUT.RespCode = "99"
	BANCS.OUTPUT.successOrFailure = "F"
	GOTO ENDOFSCRIPT
ELSE
 CUST.ATM.solid = BANCS.OUTPARAM.acctSolId

ENDIF
#print(CUST.ATM.solid)

