	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
		IF ((BANCS.INPUT.ReservedField2=="P2PIntraMerWCB") OR (BANCS.INPUT.ReservedField2=="P2PIntraMer") OR (BANCS.INPUT.ReservedField2=="P2PIntraMerPayBill") ) THEN
