CUST.ATM.Mpesa  = mid$(CUST.ATM.MpesaLenX,0,cint(CUST.ATM.MpesaLenPos)-1)
print(CUST.ATM.Mpesa)
CUST.ATM.RMKS  = mid$(CUST.ATM.MpesaLenX,cint(CUST.ATM.MpesaLenPos),12)
print(CUST.ATM.RMKS)

if(CUST.ATM.ReqServ=="EAZINQ")then	
