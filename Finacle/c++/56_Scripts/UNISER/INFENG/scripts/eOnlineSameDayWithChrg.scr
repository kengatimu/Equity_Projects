<--START
CHECKSUM="2f2d9b88241d43c8b9e7a945546318e708c02810a81c95150a17656fe02280c1"
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
sv_u = urhk_b2k_printrepos("BANCS")
print(sv_u)

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","WITH") == 0) THEN
#{
	CREATECLASS("CUST","WITH",5)
#}
ENDIF

CUST.WITH.errMsg = ""

#-------------------------------------------------------------------------------------------------------
# Get the trantype and transubtype
#-------------------------------------------------------------------------------------------------------

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	CUST.WITH.tranType = BANCS.OUTPARAM.srvValue
	PRINT(CUST.WITH.tranType)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Type")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
PRINT(sv_u)
IF (sv_u == 0) THEN
#{
	CUST.WITH.tranSubType = BANCS.OUTPARAM.srvValue
	PRINT(CUST.WITH.tranSubType)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Tran Sub Type")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
print(sv_u)
if (sv_u == 0) then
#{
        CUST.WITH.intranId = TRIM(BANCS.OUTPARAM.srvValue)
        print(CUST.WITH.intranId)
#}
else
#{
	sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for TranId")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
endif

#-------------------------------------------------------------------------------------------------------
# Get the number of accounts entered from HTM menu option
#-------------------------------------------------------------------------------------------------------

sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
PRINT(sv_u)
IF(sv_u == 0) THEN
#{
	CUST.WITH.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.WITH.noOfRecords)
#}
ELSE
#{
	sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
	BANCS.OUTPUT.successOrFailure="F"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_l = 0
sv_m = ""
sv_n = 0
sv_a = "\n"
sv_x = 0
sv_z = 0
sv_c = 0
sv_e = 0


WHILE(sv_l < CUST.WITH.noOfRecords)
#{
	sv_v = Format$(sv_l,"%d")
	sv_r = "<rec_"+sv_v+">"
	
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.WITH.serialnum = BANCS.OUTPARAM.srvValue
		PRINT(CUST.WITH.serialnum)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serialnum")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------
	# Fetch A/c - foracid
	#-------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.WITH.foracid = BANCS.OUTPARAM.srvValue
		PRINT(CUST.WITH.foracid)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Account Number")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." + sv_r +".partTranType.code")
	IF (sv_u == 0) THEN
	#{
		CUST.WITH.partTranType=BANCS.OUTPARAM.srvValue
		print(CUST.WITH.partTranType)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for partTranType code")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refAmt")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.WITH.tranAmt = BANCS.OUTPARAM.srvValue
		PRINT(CUST.WITH.tranAmt)		
                CUST.WITH.tranAmt = LEFT$(CUST.WITH.tranAmt,GETPOSITION(CUST.WITH.tranAmt,"|") - 1)
                print(CUST.WITH.tranAmt)
	#}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for Ref Amount")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF	
	sv_u = urhk_getAcctDetailsInRepository(CUST.WITH.foracid)
	IF (sv_u == 0)THEN
	#{
		CUST.WITH.schmType = BANCS.OUTPARAM.schmType
		PRINT(CUST.WITH.schmType)
		CUST.WITH.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(CUST.WITH.schmCode)
		CUST.WITH.AvaBal = BANCS.OUTPARAM.EffAvailableAmt
		Print(CUST.WITH.AvaBal)
		CUST.WITH.Crncy= BANCS.OUTPARAM.acctCrncyCode
		Print (CUST.WITH.Crncy)
		CUST.WITH.schemeType = BANCS.OUTPARAM.schemeType
		Print(CUST.WITH.schemeType)
		CUST.WITH.acid = BANCS.OUTPARAM.acid
		print(CUST.WITH.acid)
		CUST.WITH.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
		print(CUST.WITH.acctOwnerShip)

	else
		CUST.WITH.schmType = ""
		CUST.WITH.cifId = ""
		CUST.WITH.schmCode =""	
		CUST.WITH.AvaBal =""
		CUST.WITH.Crncy =""
		CUST.WITH.schemeType =""
		CUST.WITH.acid =""
		CUST.WITH.acctOwnerShip = ""
	#}
	ENDIF
	IF((CUST.WITH.partTranType =="C") OR (CUST.WITH.acctOwnerShip =="O") or (cdouble(CUST.WITH.tranAmt)<1000000))THEN
	#{
		GOTO NEXTREC
	#}
	ENDIF

	sv_s = "pstdFlg|select pstd_flg from tbaadm.dtd where acid =?SVAR and tran_id = lpad(?SVAR,9,' ') and "
	sv_s = sv_s + "  bank_id=?SVAR and tran_date = "
	#sv_s = sv_s + " LCHG_USER_ID <>'FIVUSR56'  and tran_date ='11-aug-2020' "
	sv_s = sv_s + " (select to_char(db_stat_date ,'DD-MON-RRRR')  from tbaadm.gct where  Bank_id='56' )"	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS =CUST.WITH.acid + "|" + CUST.WITH.intranId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)			
	sv_u= urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)				
	IF(sv_u == 0) THEN
	#{
		CUST.WITH.pstdFlg = BANCS.OUTPARAM.pstdFlg
	#}
	else
	#{
		CUST.WITH.pstdFlg = ""
	#}
	endif

	if((CUST.WITH.pstdFlg =="N") or (CUST.WITH.pstdFlg=="") or (CUST.WITH.pstdFlg==""))then
		print("Source Tran are Not Posted")
		exitscript
	endif	
	#------------------------------------------Get total credit for the account
	IF ((CUST.WITH.schmCode =="CA201") OR (CUST.WITH.schmCode =="SB100") OR (CUST.WITH.schmCode=="SB102") OR (CUST.WITH.schmCode =="SB103") OR (CUST.WITH.schmCode=="SB104") OR (CUST.WITH.schmCode =="SB105") OR (CUST.WITH.schmCode =="SB106") OR (CUST.WITH.schmCode =="SB108") OR (CUST.WITH.schmCode =="SB110") OR (CUST.WITH.schmCode =="SB115") OR (CUST.WITH.schmCode =="SB117") OR (CUST.WITH.schmCode =="SB118") OR (CUST.WITH.schmCode =="SB124") OR (CUST.WITH.schmCode =="SB132") OR (CUST.WITH.schmCode =="SB140") OR (CUST.WITH.schmCode =="SB148") OR (CUST.WITH.schmCode =="SB152")) THEN
	#{	
		IF ((CUST.WITH.acid !="") and (CUST.WITH.Crncy =="UGX"))THEN
		
			sv_s ="CRtranAmt|"
			sv_s = sv_s + " select sum(tran_amt) from tbaadm.dtd where acid =?SVAR and part_tran_type ='C' and"
			sv_s = sv_s + " LCHG_USER_ID not in('FIVUSR56','CDCI56')and tran_sub_type ='NR' and DTH_INIT_SOL_ID <>?SVAR and tran_date = "
			#sv_s = sv_s + " LCHG_USER_ID <>'FIVUSR56'  and tran_date ='11-aug-2020' "
			sv_s = sv_s + " (select to_char(db_stat_date ,'DD-MON-RRRR')  from tbaadm.gct where  Bank_id='56' )"	
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS =CUST.WITH.acid + "|" + BANCS.STDIN.mySolId
			print(BANCS.INPARAM.BINDVARS)			
			sv_u= urhk_dbSelectWithBind(sv_s)
			PRINT(sv_u)				
			IF(sv_u == 0) THEN
			#{
				CUST.WITH.CRtranAmt=BANCS.OUTPARAM.CRtranAmt
				print(CUST.WITH.CRtranAmt)
				IF (CUST.WITH.CRtranAmt =="") THEN
				#{
					CUST.WITH.CRtranAmt = "0"
					print(CUST.WITH.CRtranAmt)
				#}
				ELSE
				#{
					print(CUST.WITH.CRtranAmt)
				#}
				ENDIF
			#}
			ELSE
			#{
				CUST.WITH.errMsg ="No Data."
				sv_e=urhk_SetOrbOut("StattusCode|Error")
				sv_e=urhk_SetOrbOut("Error|"+CUST.WITH.errMsg)
				GOTO NEXTREC
			#}
			ENDIF
		#}
		ELSE
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		print(CUST.WITH.tranAmt)
		print(CUST.WITH.CRtranAmt)		

		#----------------------------------------------Get Debit amount total excluive the current debit
		IF (CUST.WITH.acid !="") THEN
		#{
			sv_s ="DRtranAmt|"
			sv_s = sv_s + " select sum(tran_amt) from tbaadm.dtd where acid =?SVAR and part_tran_type ='D' and"
			sv_s = sv_s + " LCHG_USER_ID not in('FIVUSR56','CDCI56')and tran_sub_type ='NP' and tran_date = "
			#sv_s = sv_s + " LCHG_USER_ID <>'FIVUSR56'  and tran_date ='11-aug-2020' "
			sv_s = sv_s + " (select to_char(db_stat_date ,'DD-MON-RRRR')  from tbaadm.gct where  Bank_id='56' ) and tran_id <> lpad(?SVAR,9,' ')"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS =CUST.WITH.acid +"|" + CUST.WITH.intranId 
			print(BANCS.INPARAM.BINDVARS)
			sv_u= urhk_dbSelectWithBind(sv_s)
			PRINT(sv_u)

			IF(sv_u == 0) THEN
			#{

				CUST.WITH.DRtranAmt=BANCS.OUTPARAM.DRtranAmt
				print(CUST.WITH.DRtranAmt)
				IF (CUST.WITH.DRtranAmt =="") THEN
				#{
					CUST.WITH.DRtranAmt = "0"
					print(CUST.WITH.DRtranAmt)
				#}
				ELSE
				#{
					print(CUST.WITH.DRtranAmt)
				#}
				ENDIF
			#}
			ELSE
			#{
				CUST.WITH.errMsg ="No Data."
				sv_e=urhk_SetOrbOut("StattusCode|Error")
				sv_e=urhk_SetOrbOut("Error|"+CUST.WITH.errMsg )
				GOTO NEXTREC
			#}
			ENDIF
			#---------------------Total debits inclusive of current debit
			sv_s ="DRtranAmt2|"
                        sv_s = sv_s + " select sum(tran_amt) from tbaadm.dtd where acid =?SVAR and part_tran_type ='D' and"
                        sv_s = sv_s + " LCHG_USER_ID not in('FIVUSR56','CDCI56')and tran_sub_type ='NP' and tran_date = "
                        #sv_s = sv_s + " LCHG_USER_ID <>'FIVUSR56'  and tran_date ='11-aug-2020' "
                        sv_s = sv_s + " (select to_char(db_stat_date ,'DD-MON-RRRR')  from tbaadm.gct where  Bank_id='56' )"
                        PRINT(sv_s)
                        BANCS.INPARAM.BINDVARS =CUST.WITH.acid
                        print(BANCS.INPARAM.BINDVARS)
                        sv_u= urhk_dbSelectWithBind(sv_s)
                        PRINT(sv_u)

                        IF(sv_u == 0) THEN
                        #{
                                CUST.WITH.DRtranAmt2=BANCS.OUTPARAM.DRtranAmt2
                                print(CUST.WITH.DRtranAmt2)
			else
				CUST.WITH.DRtranAmt2 = ""
			endif
		#}
		ENDIF
		print(CUST.WITH.tranAmt)
		print(CUST.WITH.CRtranAmt)
		print(CUST.WITH.DRtranAmt)
		print(CUST.WITH.AvaBal)
		#------------------------------------------Check when to charge
		print(CUST.WITH.CRtranAmt)
		CUST.WITH.OriginalBal =	 cdouble(CUST.WITH.AvaBal) + cdouble(CUST.WITH.DRtranAmt2)
		print(CUST.WITH.OriginalBal)
		CUST.WITH.OriginalBal = cdouble(CUST.WITH.OriginalBal) - cdouble(CUST.WITH.CRtranAmt)
		print(CUST.WITH.OriginalBal)
		if(cdouble(CUST.WITH.OriginalBal) >0)then
			print(CUST.WITH.CRtranAmt)
			print(CUST.WITH.OriginalBal)
			if (cdouble(CUST.WITH.CRtranAmt) < cdouble(CUST.WITH.OriginalBal))then
				GOTO NEXTREC
			endif
		endif

		#-------------------------------------------Get amount difference between deposits and withdraws ± UGX 0 and ± UGX 200,000
	

		IF ((cdouble(CUST.WITH.CRtranAmt) >0) and (cdouble(CUST.WITH.tranAmt) >0)) THEN
		#{
			CUST.WITH.amtDiff = cdouble(CUST.WITH.CRtranAmt) - cdouble(CUST.WITH.tranAmt)
			print(CUST.WITH.amtDiff)
		#}
		ELSE
		#{
			GOTO NEXTREC
		#}
		ENDIF

		IF (cdouble(CUST.WITH.amtDiff) <0) THEN
		#{
			print(cdouble(CUST.WITH.amtDiff))
			CUST.WITH.amtDiff = cdouble(CUST.WITH.amtDiff) * -1
			print(CUST.WITH.amtDiff)
		#}
		ELSE
		#{
			print(cdouble(CUST.WITH.amtDiff))
		#}
		ENDIF

		IF ((cdouble(CUST.WITH.amtDiff) >= 0) AND (cdouble(CUST.WITH.amtDiff) <= 200000)) THEN
		#{
			
			IF (CUST.WITH.schemeType =="SBA") THEN
			#{
				CUST.WITH.SameDayChrge = cdouble(CUST.WITH.tranAmt) * (0.5/100)
				print(CUST.WITH.SameDayChrge)	
			#}
			ELSE
			#{
				CUST.WITH.SameDayChrge = cdouble(CUST.WITH.tranAmt) * (0.5/100)
				print(CUST.WITH.SameDayChrge)
			#}
			ENDIF
		#}
		ELSE
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		#CUST.WITH.SameDayChrge = cdouble(CUST.WITH.tranAmt) * (0.5/100)
		#print(CUST.WITH.SameDayChrge)	
		
		CUST.WITH.crChrBacid = "PNLCAC"
		CUST.WITH.eventId = "SAMDC"	
		#--------------------------------------------CrAcct end
		
		#---------------------------------------------lien start
		IF (cdouble(CUST.WITH.SameDayChrge) > cdouble(CUST.WITH.AvaBal)) THEN
		#{
			IF(CLASSEXISTS("CUST","DATA")==0) THEN
				CREATECLASS("CUST","DATA",5)
			ENDIF
			CUST.DATA.foracid = CUST.WITH.foracid
			CUST.DATA.amt = CUST.WITH.SameDayChrge
			CUST.DATA.EventID = "SAMDC"
			CUST.DATA.RateCode  = "TTB"
			CUST.DATA.lienRemarks = "SAME DAY CHARGE"
			CALL("AutoLienMain.scr")
			GOTO NEXTREC
		#}
		ENDIF
		#--------------------------------------------lien end
		IF(CLASSEXISTS("CUST","GCHRG")==0) THEN
			CREATECLASS("CUST","GCHRG",5)
		ENDIF
		CUST.GCHRG.tranType = "T"
		CUST.GCHRG.tranSubType = "BI"
		CUST.GCHRG.drAcctId = CUST.WITH.foracid
		CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
		CUST.GCHRG.chrgAmt = CUST.WITH.SameDayChrge + "|" + BANCS.STDIN.homeCrncyCode
		CUST.GCHRG.eventId = CUST.WITH.eventId

		if(CUST.WITH.SameDayChrge >0 ) then
		CALL("gchrgcommon.scr")

		ENDIF

		IF (CUST.GCHRG.successOrFailure == "S") THEN
		#{
			PRINT("Charge collected")
		#}
		endif
	#}
	ENDIF

	NEXTREC:
	PRINT(sv_m)	
	sv_l = sv_l + 1
	PRINT (sv_l)
#}
DO
PRINT(sv_m)
IF (sv_m != "") THEN 
#{
	BANCS.OUTPUT.successOrFailure = "F"
#}
ENDIF

EXITSCRIPT

trace off
end-->
	


