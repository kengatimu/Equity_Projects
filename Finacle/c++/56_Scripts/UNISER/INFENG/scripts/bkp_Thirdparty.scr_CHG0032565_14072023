			sv_s = sv_s + " card_number, "
			sv_s = sv_s + " account_number, "
			sv_s = sv_s + " transaction_amount, "
			sv_s = sv_s + " private_data_c_100, "
			sv_s = sv_s + " original_data_elements, "
			sv_s = sv_s + " bank_id "
			sv_s = sv_s + " ) "
			sv_s = sv_s + " values "
			sv_s = sv_s + " ( "
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR,"
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR )"

			BANCS.INPARAM.BINDVARS = BANCS.INPUT.Command + "|" + BANCS.INPUT.SerialNum+"|"+BANCS.INPUT.DeviceId + "|" + BANCS.INPUT.CustCardId + "|"+BANCS.INPUT.Foracid+"|"+BANCS.INPUT.StlmntFeeAmount1+"|"+BANCS.INPUT.DccId+"|"+BANCS.INPUT.OrigDataElements + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			print(sv_s)
			sv_d = urhk_dbSqlWithBind(sv_s)

			IF (sv_d == 0) then
			#{
				#sv_d = urhk_dbSqlWithBind("COMMIT")
			#}
			ENDIF
		ENDIF

		#################################################
		# Inserting Values into Success/Failure Table C_POS_TRX_AGENT
		#################################################

		IF ((BANCS.INPUT.Command == "TRTR") OR (BANCS.INPUT.Command == "TRRR")) THEN 
			IF (BANCS.INPUT.DccId =="WPD") THEN
				BANCS.INPUT.Foracid = BANCS.INPUT.CrForacid
				print(BANCS.INPUT.Foracid)
			ELSE
				BANCS.INPUT.Foracid = BANCS.INPUT.Foracid
				print(BANCS.INPUT.Foracid)
			ENDIF
		ENDIF
			
		IF ((CUST.ATM.Sucessfail1 == "Y") AND (CUST.ATM.Sucessfail2 == "Y") AND (BANCS.INPUT.DccId =="WPD")) then
			
			
			IF (FIELDEXISTS(BANCS.INPUT.ReservedField3) == 1) THEN
				CUST.ATM.serialrrn= LTRIM(BANCS.INPUT.ReservedField3,'0') 
				print(CUST.ATM.serialrrn)
			ELSE
				CUST.ATM.serialrrn = BANCS.INPUT.OrigDataElements 
				print(CUST.ATM.serialrrn)
			ENDIF
			
			IF (FIELDEXISTS(CUST.ATM.Amount) == 1) THEN
				CUST.ATM.Amount = CUST.ATM.Amount 
				print(CUST.ATM.Amount)
			ELSE
				CUST.ATM.Amount = BANCS.INPUT.TranAmt 
				print(CUST.ATM.Amount)
			ENDIF
			
			sv_s = " INSERT INTO "
			sv_s = sv_s + " CUSTOM.C_POS_TRX_AGENTS "
			sv_s = sv_s + " ( "
			sv_s = sv_s + " message_type, "
			sv_s = sv_s + " trace_audit_number, "
			sv_s = sv_s + " deviceid, "
			sv_s = sv_s + " card_number, "
			sv_s = sv_s + " account_number,"
			sv_s = sv_s + " transaction_fee_way4, "
			sv_s = sv_s + " transaction_fee_finacle, "
			sv_s = sv_s + " private_data_c_100, "
			sv_s = sv_s + " original_data_elements, "
			sv_s = sv_s + " agent_account_no,"
			sv_s = sv_s + " tran_date_time, "
			sv_s = sv_s + " bank_id ) "
			sv_s = sv_s + " values "
			sv_s = sv_s + " ( "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + " ?SVAR )"
			print(sv_s)

			BANCS.INPARAM.BINDVARS = BANCS.INPUT.Command+"|"+ CUST.ATM.serialrrn +"|"+BANCS.INPUT.DeviceId+"|"+BANCS.INPUT.CustCardId+"|"+BANCS.INPUT.Foracid+"|"+BANCS.INPUT.StlmntFeeAmount1+"|"+CUST.ATM.AgentShare+"|"+BANCS.INPUT.DccId+"|"+ CUST.ATM.Amount +"|"+CUST.ATM.accountagt+"|" + CUST.ATM.sysdateagt + "|" +BANCS.STDIN.contextBankId

			sv_d = urhk_dbSqlWithBind(sv_s)

			If (sv_d == 0) then
			#{
				#sv_d = urhk_dbSqlWithBind("COMMIT")
			#}
			endif
		ENDIF
