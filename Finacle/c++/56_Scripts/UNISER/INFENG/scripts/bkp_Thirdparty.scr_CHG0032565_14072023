                MTT.PartTranDetails.Particulars = CUST.ATM.narr1
		MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
                sv_a = cdouble(CUST.ATM.drcramount) 
		sv_a = -(sv_a)
		print(sv_a)
                MTT.PartTranDetails.RefAmount = sv_a
                print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = BANCS.INPUT.CustCardId
		print(BANCS.INPUT.CustCardId)
                MTT.PartTranDetails.RefNum = BANCS.INPUT.DeviceId
