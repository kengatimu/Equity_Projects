				sv_s = sv_s + 	"(SELECT 1 "
				sv_s = sv_s + 	"FROM URA_PAY b "
				sv_s = sv_s + 	"WHERE a.regno = b.regno "
				sv_s = sv_s + 	"AND bank_id = ?SVAR) "
				sv_s = sv_s + "AND a.regno = ?SVAR "
				sv_s = sv_s + "AND bank_id = ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.tranRmk +"|"+ BANCS.STDIN.contextBankId
