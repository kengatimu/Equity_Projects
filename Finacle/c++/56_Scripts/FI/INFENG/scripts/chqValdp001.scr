	CUST.DATA.particulars=BANCS.INPUT.pertiC
	print(CUST.DATA.particulars)
	#------------------------------------------------
	#----cparam
	#------------------------------------------------
	BANCS.INPUT.moduleName = "CLEARING"
	
	BANCS.INPUT.parameterId = "CHQVAL_SCHMCD1"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.chqValSchm1=BANCS.OUTPUT.parameterVal
