	CUST.DATA.schmCode = ""
	CUST.DATA.count = ""
	
	CUST.DATA.acctNo= BANCS.INPUT.acctNo
	print(CUST.DATA.acctNo)
	
	CUST.DATA.tranRmk= BANCS.INPUT.tranRmk
	print(CUST.DATA.tranRmk)
	
	CUST.DATA.pTranAmt= BANCS.INPUT.pTranAmt
