		#{
		sv_u = urhk_SetOrbOut("Err|arameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CHQVAL_SCHMCD2"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.chqValSchm2=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("Err|arameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CHQVAL_ACCT2"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.chqValAcct2=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("Err|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE")
		BANCS.OUTPUT.successOrFailure="F"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------
	#Finding Schm Code
	#--------------------------------------------------
	sv_s = "schmCode|SELECT schm_code "
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE foracid=?SVAR"
	sv_s = sv_s + " AND del_flg='N'"
	sv_s = sv_s + " AND entity_cre_flg='Y'"
	sv_s = sv_s + " AND bank_id=?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.acctNo +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		CUST.DATA.schmCode= BANCS.OUTPARAM.schmCode
		print(CUST.DATA.schmCode)
	#}
	ENDIF
	
	#new porting code added
	IF((CUST.DATA.schmCode==CUST.DATA.chqValSchm1) OR (CUST.DATA.schmCode==CUST.DATA.chqValSchm2) OR (CUST.DATA.acctNo==CUST.DATA.chqValAcct2) OR (CUST.DATA.acctNo=="1036200484307") ) THEN
	#{
		sv_s = "count|"
		sv_s = sv_s + "SELECT count(*) from CUSTOM.C_CIC "
		sv_s = sv_s + " WHERE ACCTNUM = ?SVAR "
		sv_s = sv_s + " AND bank_id= ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.acctNo +"|"+BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_w = urhk_dbSelectWithBind(sv_s)
		print(sv_w)
		IF (sv_w == 0) THEN
		#{
			CUST.DATA.count = BANCS.OUTPARAM.count
			print(CUST.DATA.count)
			IF (CUST.DATA.count !=0) THEN
			#{
				CUST.DATA.name = CUST.DATA.particulars
				#print(CUST.DATA.name)
				print(CUST.DATA.tranRmk)
				IF (CUST.DATA.tranRmk=="") THEN
				#{
					print("ENTER THE ADMIN/REG/BILL/REF NO IN THE Tran. Remarks FIELD.........")
					sv_u = urhk_SetOrbOut("eMsg|ENTER THE ADMIN/REG/BILL/REF NO IN THE Tran. Remarks FIELD.........")
					sv_u = urhk_SetOrbOut("Tran|Dummy")
					sv_u = urhk_SetOrbOut("Parti|Dummy")
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					sv_s = "REFNUM,NAME|"
					sv_s = sv_s + "select REFNUM,NAME from CUSTOM.C_CIC "
					sv_s = sv_s + " where ACCTNUM = ?SVAR "
					sv_s = sv_s + " AND REFNUM = ?SVAR "
					sv_s = sv_s + " AND DEL_FLG = 'N' "
					sv_s = sv_s + " AND bank_id =?SVAR "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.DATA.acctNo+"|"+CUST.DATA.tranRmk +"|"+BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_w = urhk_dbselectWithBind(sv_s)
					print(sv_w)
					IF ( sv_w != 0 ) THEN
					#{
						print("INVALID ADMIN/REG/BILL/REF NUMBER...")
						sv_u = urhk_SetOrbOut("eMsg|INVALID ADMIN/REG/BILL/REF NUMBER...")
						sv_u = urhk_SetOrbOut("Tran|Dummy")
						sv_u = urhk_SetOrbOut("Parti|Dummy")
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						CUST.DATA.refnum = BANCS.OUTPARAM.REFNUM
						CUST.DATA.name = BANCS.OUTPARAM.NAME
						sv_a = " REG NO :  "
						sv_a = sv_a +CUST.DATA.refnum + "    NAME : "
						sv_a = sv_a + CUST.DATA.name
						print(sv_a)
						sv_u = urhk_SetOrbOut("eMsg|"+sv_a)
						sv_u = urhk_SetOrbOut("Tran|" + CUST.DATA.refnum)
						sv_u = urhk_SetOrbOut("Parti|" + CUST.DATA.name)
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				#}
			ELSE
				#{
				print(CUST.DATA.tranRmk)
				IF (CUST.DATA.tranRmk=="") THEN
				#{
					sv_u = urhk_SetOrbOut("eMsg|ENTER THE ADMIN/REG/BILL/REF NO IN THE Tran. Remarks FIELD.........")
					sv_u = urhk_SetOrbOut("Tran|Dummy")
					sv_u = urhk_SetOrbOut("Parti|Dummy")
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					IF (CUST.DATA.acctNo==CUST.DATA.chqValAcct2) THEN
					#{
						sv_u = urhk_SetOrbOut("URL|popWindow")
						sv_u = urhk_SetOrbOut("tran|Dummy")
						sv_u = urhk_SetOrbOut("Parti|Dummy")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT :
