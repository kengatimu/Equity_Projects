<--start
#trace on
###############################################################################
# Define the Transaction
###############################################################################
sv_a = urhk_MTTS_PopulateInputDetails("")

MTT.TranDetails.TranDate="0"
MTT.TranDetails.TranType="T"
MTT.TranDetails.TranSubType="BI"
MTT.TranDetails.Remarks="Reverse Charge Off transaction"
MTT.TranDetails.IgnoreExcp="Y"
MTT.TranDetails.Consolidate="Y"
MTT.TranDetails.PrintAdviceInd="B"
MTT.TranDetails.sysTranCode = "LOANAA008"

sv_z = urhk_MTTS_DefineTransaction("revChargeOff")

###############################################################################
# Get all the amounts into local variables . Please do not set these variables
# anywhere else in this script. The variables are : -
# sv_l = pending principal
# sv_p = pending interest
# sv_o = pending interest book Amount.
# sv_r = recovered principal Amount.
# sv_v = provision amount
###############################################################################	
	sv_l = CDOUBLE(MTT.InputDetails.prinTranAmt)
	sv_p = CDOUBLE(MTT.InputDetails.intTranAmt)
	sv_b = CDOUBLE(MTT.InputDetails.penalIntTranAmt)
	sv_o = CDOUBLE(MTT.InputDetails.bookTranAmt)
	sv_d = CDOUBLE(MTT.InputDetails.penalBookTranAmt)
	sv_r = CDOUBLE(MTT.InputDetails.revTranAmt)
    sv_v = CDOUBLE(MTT.InputDetails.provisionAmt)
	sv_i = CDOUBLE(MTT.InputDetails.intSuspenseAmt)
	sv_s = CDOUBLE(MTT.InputDetails.penalIntSuspenseAmt)

###############################################################################
# Debit Interest Suspense Account
###############################################################################
	if(sv_i != 0) then
		MTT.PartTranDetails.Account = MTT.InputDetails.intSuspAcct
		MTT.PartTranDetails.RefAmount = -(sv_i)
		MTT.PartTranDetails.Particulars=MTT.InputDetails.intSuspAcct+ " - debit int suspense a/c"
		MTT.PartTranDetails.Remarks="debit to Suspense Account"

		MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
		MTT.PartTranDetails.PTranBusinessType="NONE"
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.sysPartTranCode = "PTRN00565"

	sv_c = urhk_MTTS_DefinePartTran("suspense")
endif	

###############################################################################
# Debit Penal Interest Suspense Account
###############################################################################
if(sv_s != 0) then
		MTT.PartTranDetails.Account = MTT.InputDetails.penalIntSuspAcct
		MTT.PartTranDetails.RefAmount = -(sv_s)
		MTT.PartTranDetails.Particulars=MTT.InputDetails.intSuspAcct+ " - debit penal int suspense a/c"
		MTT.PartTranDetails.Remarks="debit to Penal Suspense Account"

		MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
		MTT.PartTranDetails.PTranBusinessType="NONE"
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.sysPartTranCode = "PTRN00566"


	sv_c = urhk_MTTS_DefinePartTran("penalsuspense")
endif
###############################################################################
# Credit PNL Account (Normal interest amount)
###############################################################################
if(sv_i != 0) then
	MTT.PartTranDetails.Account=MTT.InputDetails.pAndLAcct
    MTT.PartTranDetails.RefAmount = sv_i
    MTT.PartTranDetails.Particulars=MTT.InputDetails.pAndLAcct+ " - Credit PNL a/c"
    MTT.PartTranDetails.Remarks="Credit to P&L Normal Interest Account"

MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
MTT.PartTranDetails.Consolidate="Y"
MTT.PartTranDetails.TranIdentifier="revChargeOff"
MTT.PartTranDetails.PTranBusinessType="NONE"
MTT.PartTranDetails.ACPARTB2kType="ACCNT"
MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
MTT.PartTranDetails.sysPartTranCode = "PTRN00567"

sv_c = urhk_MTTS_DefinePartTran("interest")

endif
###############################################################################
# Credit PNL Account (Penal interest amount)
###############################################################################
if(sv_s != 0) then    
	MTT.PartTranDetails.Account=MTT.InputDetails.penalPandLAcct
    MTT.PartTranDetails.RefAmount = sv_s
    MTT.PartTranDetails.Particulars=MTT.InputDetails.penalPandLAcct+ " - Credit PNL a/c"
    MTT.PartTranDetails.Remarks="Credit to P&L Penal Interest Account"

MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
MTT.PartTranDetails.Consolidate="Y"
MTT.PartTranDetails.TranIdentifier="revChargeOff"
MTT.PartTranDetails.PTranBusinessType="NONE"
MTT.PartTranDetails.ACPARTB2kType="ACCNT"
MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
MTT.PartTranDetails.sysPartTranCode = "PTRN00568"

sv_c = urhk_MTTS_DefinePartTran("penalInt")
endif
###############################################################################
# Credit Suspense account
###############################################################################
	if (sv_o !=0 OR sv_p !=0 ) then 
		MTT.PartTranDetails.Account=MTT.InputDetails.intSuspAcct
		MTT.PartTranDetails.RefAmount=(sv_p + sv_o)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode	
		MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Credit to Interest Suspense account "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
###############################################################################
# Imp:- Do Not Change the PTranBusinessType. This is used for ACPART entries.
###############################################################################
        MTT.PartTranDetails.PTranBusinessType="SUSP"

		MTT.LAAddnlDetails.OriginOfTran = "REVCH"
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.sysPartTranCode = "PTRN00569"

		sv_z = urhk_MTTS_DefinePartTran("suspenseAccount")
	endif

###############################################################################
# Credit Penal Suspense account
###############################################################################
if (sv_b !=0 OR sv_d !=0 ) then 
		MTT.PartTranDetails.Account=MTT.InputDetails.penalIntSuspAcct
		MTT.PartTranDetails.RefAmount=(sv_b + sv_d)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode	
		MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Credit to Penal Interest Suspense account "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
###############################################################################
# Imp:- Do Not Change the PTranBusinessType. This is used for ACPART entries.
###############################################################################
        MTT.PartTranDetails.PTranBusinessType="SUSP"

		MTT.LAAddnlDetails.OriginOfTran = "REVCH"
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.sysPartTranCode = "PTRN00570"

		sv_z = urhk_MTTS_DefinePartTran("penalsuspenseAccount")
endif
##############################################################################
# Debit Customer Account (applied interest)
##############################################################################
#if(sv_p != 0) then 
if(sv_p != 0 OR sv_b != 0) then
#{ 
	# For int debit account configured as parking account, credit should
	# happen to parking account
	if(MTT.InputDetails.intDrAcctFlg == "P") then
		MTT.PartTranDetails.Account=MTT.InputDetails.parkingAcct
	else
		MTT.PartTranDetails.Account=MTT.InputDetails.tranAcct
	endif
	
	MTT.PartTranDetails.RefAmount = -(sv_p + sv_b) 
	MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct+" - Debit to Interest Routing a/c" 
	MTT.PartTranDetails.Remarks="Debit to Customer Account" 
	MTT.PartTranDetails.RateCode = "" 
	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy 
	MTT.PartTranDetails.Consolidate="Y" 
	MTT.PartTranDetails.TranIdentifier="revChargeOff" 
	MTT.PartTranDetails.PTranBusinessType="NONE" 
	MTT.PartTranDetails.ACPARTB2kType="ACCNT" 
	MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct 

	MTT.PartTranDetails.TODRefType          = "IN"
        MTT.PartTranDetails.TodEntityType       = "TODIN"
        MTT.PartTranDetails.TodEntityId         = MTT.InputDetails.tranAcct
        MTT.PartTranDetails.TodLevIntFlg        = "N"
        MTT.PartTranDetails.TodExpiryDate       = BANCS.STDIN.BODDate
        MTT.PartTranDetails.TodPenalDate        = BANCS.STDIN.BODDate
        MTT.PartTranDetails.TodPermittedBy      = "SYSTEM"
        MTT.PartTranDetails.TodRemarks          = "Auto Renewal Charges TOD"
        MTT.PartTranDetails.Consolidate     = "N"

	sv_c = urhk_MTTS_DefinePartTran("interest") 
	endif 
#} 
###############################################################################
# Debit Interest Collect account
###############################################################################
	if (sv_o !=0 ) then
            if(MTT.InputDetails.chrgOffNonPdFlg == "Y") then
                MTT.PartTranDetails.Account=MTT.InputDetails.intBookAcct
            else
                MTT.PartTranDetails.Account=MTT.InputDetails.pdIntBookAcct
            endif
		MTT.PartTranDetails.RefAmount=-sv_o
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Debit to Interest Collect Account "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
		MTT.PartTranDetails.PTranBusinessType="tranS"
		MTT.PartTranDetails.sysPartTranCode = "PTRN00571"

		sv_z = urhk_MTTS_DefinePartTran("intCollect")
	endif

###############################################################################
# Debit Penal Interest Collect account
###############################################################################
	if (sv_d !=0 ) then 
		if(MTT.InputDetails.chrgOffNonPdFlg == "Y") then
            MTT.PartTranDetails.Account=MTT.InputDetails.penalIntBookAcct
        else
            MTT.PartTranDetails.Account=MTT.InputDetails.pdPenalIntBookAcct
        endif
		MTT.PartTranDetails.RefAmount=-sv_d
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Debit to Penal Interest Collect Account "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
		MTT.PartTranDetails.PTranBusinessType="tranS"
		MTT.PartTranDetails.sysPartTranCode = "PTRN00572"

		sv_z = urhk_MTTS_DefinePartTran("penalIntCollect")
	endif
###############################################################################
# Credit Principal Loss Line
###############################################################################

	if (sv_l !=0 ) then
		MTT.PartTranDetails.Account=MTT.InputDetails.prinLossLine
		MTT.PartTranDetails.RefAmount=sv_l
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Credit to Principal Loss Line account "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
		MTT.PartTranDetails.PTranBusinessType="OFDEB"
        MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.PTranBusinessType="tranS"
		MTT.PartTranDetails.sysPartTranCode = "PTRN00573"

		sv_z = urhk_MTTS_DefinePartTran("prinLossLine")
	endif	
###############################################################################
# Debit Charge Off Loss Line
###############################################################################
sv_p = sv_p + sv_b
	if (sv_l !=0) then
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeOffLine
		MTT.PartTranDetails.RefAmount=-(sv_l)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Debit to Charge Off Account "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="revChargeOff"
		MTT.PartTranDetails.PTranBusinessType="tranS"
		MTT.PartTranDetails.sysPartTranCode = "PTRN00574"

		sv_z = urhk_MTTS_DefinePartTran("chargeOffLossLine")
	endif
###############################################################################
# Debit Recovery Loss Line
###############################################################################
    if (sv_r !=0 ) then
        MTT.PartTranDetails.Account=MTT.InputDetails.recoveryLine
        MTT.PartTranDetails.RefAmount=-sv_r
        MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
        MTT.PartTranDetails.RateCode = ""
        MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Debit to Recovery Account "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

        MTT.PartTranDetails.Consolidate="Y"
        MTT.PartTranDetails.TranIdentifier="revChargeOff"
        MTT.PartTranDetails.PTranBusinessType="tranS"
		MTT.PartTranDetails.sysPartTranCode = "PTRN00575"

        sv_z = urhk_MTTS_DefinePartTran("recovLine")
###############################################################################
# Credit Principal Loss Line
###############################################################################
        MTT.PartTranDetails.Account=MTT.InputDetails.prinLossLine
        MTT.PartTranDetails.RefAmount=sv_r
        MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
        MTT.PartTranDetails.RateCode = ""
        MTT.PartTranDetails.Particulars=MTT.InputDetails.tranAcct + " - Credit to Principal Loss Line "

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LACHO"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

        MTT.PartTranDetails.Consolidate="Y"
        MTT.PartTranDetails.TranIdentifier="revChargeOff"
        MTT.PartTranDetails.PTranBusinessType="tranS"
		MTT.PartTranDetails.sysPartTranCode = "PTRN00576"

        sv_z = urhk_MTTS_DefinePartTran("prinLine")
    endif

###############################################################################
# Debit Provision Amount
###############################################################################
    if (sv_v != 0 ) then
    	MTT.PartTranDetails.Account=MTT.InputDetails.provisionCrAcct
        MTT.PartTranDetails.RefAmount=-sv_v
        MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
        MTT.PartTranDetails.RateCode = "" 
        MTT.PartTranDetails.Particulars=MTT.InputDetails.provisionCrAcct + " - Reversal of provisioning"
        MTT.PartTranDetails.Consolidate="Y"
        MTT.PartTranDetails.TranIdentifier="revChargeOff"
        MTT.PartTranDetails.PTranBusinessType="OFDEB"
        MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.sysPartTranCode = "PTRN00577"
   
        sv_z = urhk_MTTS_DefinePartTran("provisionCrAcct") 
##############################################################################
# Credit Provision Amount 
###############################################################################
        MTT.PartTranDetails.Account=MTT.InputDetails.provisionDrAcct
        MTT.PartTranDetails.RefAmount=sv_v
        MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
       	MTT.PartTranDetails.RateCode = MTT.InputDetails.ProvRateCode 
		MTT.PartTranDetails.Particulars=MTT.InputDetails.provisionDrAcct + " - Reversal of provisioning"
        MTT.PartTranDetails.Consolidate="Y"
        MTT.PartTranDetails.TranIdentifier="revChargeOff"
        MTT.PartTranDetails.PTranBusinessType="OFCRE"
        MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.tranAcct
		MTT.PartTranDetails.sysPartTranCode = "PTRN00578"

        sv_z = urhk_MTTS_DefinePartTran("provisionDrAcct")
    endif
    sv_z = urhk_MTTS_EndDefinition("")
#trace off
end-->


