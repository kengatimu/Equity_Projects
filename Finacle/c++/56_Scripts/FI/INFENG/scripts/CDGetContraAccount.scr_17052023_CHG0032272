#--- Fix to block fx transactions for Ebanking
IF (BANCS.INPUT.DccId == "BWY") THEN
	IF ((BANCS.INPUT.Command=="CDAR") OR (BANCS.INPUT.Command=="CDRR")) THEN
		print(BANCS.OUTPUT.contraAccount)
		print(BANCS.INPUT.CrForacid)
		CUST.ATM.DebitAccount=BANCS.OUTPUT.contraAccount
		CUST.ATM.CreditAccount=BANCS.INPUT.CrForacid
		
	ELSE
		print(BANCS.OUTPUT.contraAccount)
		print(BANCS.INPUT.Foracid)
		CUST.ATM.DebitAccount=BANCS.INPUT.Foracid
		CUST.ATM.CreditAccount=BANCS.OUTPUT.contraAccount
	ENDIF

	sv_h = urhk_getAcctDetailsInRepository(CUST.ATM.DebitAccount)
	IF (sv_h != 0) THEN
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure = "F"
		exitscript
	ELSE
		CUST.ATM.Debitcurrency = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.ATM.Debitcurrency)
	ENDIF
	sv_h = urhk_getAcctDetailsInRepository(CUST.ATM.CreditAccount)
	IF (sv_h != 0) THEN
		BANCS.OUTPUT.RespCode = "99"
		BANCS.OUTPUT.successOrFailure = "F"
		exitscript
	ELSE
		CUST.ATM.creditcurrency = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.ATM.creditcurrency)
	ENDIF
	IF (CUST.ATM.Debitcurrency!=CUST.ATM.creditcurrency) THEN
		IF (FIELDEXISTS(BANCS.INPUT.ReservedField3)) THEN
			IF (strlen(BANCS.INPUT.ReservedField3)>0)THEN
				CUST.ATM.crncyebank  = MID$(BANCS.INPUT.ReservedField3,0,3)
				print(CUST.ATM.crncyebank)
				sv_x = "count2cyc|select count(1) from tbaadm.cnc where del_flg='N' and bank_id=?SVAR  and ENTITY_CRE_FLG='Y' and CRNCY_CODE =?SVAR " 
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ATM.crncyebank 
				sv_r =urhk_dbSelectWithBind(sv_x)
				print(sv_r)
				IF (sv_r != "0") then
					CUST.ATM.count2cyc= BANCS.OUTPARAM.count2cyc
					print(CUST.ATM.count2cyc)
					IF (CUST.ATM.count2cyc=="0")  THEN
						IF ((BANCS.INPUT.DccId == "BWY") AND (CUST.ATM.Debitcurrency=="UGX"))  THEN
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.successOrFailure = "F"
							exitscript
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
