					BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
				ELSE
					BANCS.OUTPUT.contraAccount=CUST.ATM.Agentaccount
	
				ENDIF

			ENDIF

		ELSE
			IF (BANCS.INPUT.CrForacid !="") THEN
				BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
				print(BANCS.OUTPUT.contraAccount)
			ELSE
				BANCS.OUTPUT.contraAccount=CUST.ATM.contraAcct7

			ENDIF
			
		ENDIF
	
	ENDIF
