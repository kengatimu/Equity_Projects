						                print(BANCS.INPARAM.FromCurrency)
						                print(BANCS.INPARAM.ToCurrency)
						                print(BANCS.INPARAM.RateCode)
						                print(BANCS.INPARAM.Rate)

						               	sv_z=urhk_B2k_ConvertAmount("")
