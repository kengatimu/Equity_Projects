						               	print(CUST.GCHRG.convAmt)
						               	CUST.GCHRG.eventId = CUST.CPARAM.supDepChrgEvent
										
										CUST.GCHRG.chrgAmt = CUST.GCHRG.convAmt + "|" + BANCS.STDIN.homeCrncyCode
										CALL("ChargeLien.scr")
										CALL("gchrgcommon.scr")
										EXITSCRIPT
									#}
									ENDIF
								#}
								ENDIF
