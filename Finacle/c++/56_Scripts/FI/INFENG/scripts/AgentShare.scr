		BANCS.INPARAM.BINDVARS = BANCS.INPUT.Command + "|" + BANCS.INPUT.SerialNum+"|"+BANCS.INPUT.DeviceId + "|" + BANCS.INPUT.CustCardId + "|"+BANCS.INPUT.Foracid+"|"+BANCS.INPUT.StlmntFeeAmount1+"|"+BANCS.INPUT.DccId+"|"+BANCS.INPUT.OrigDataElements + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
