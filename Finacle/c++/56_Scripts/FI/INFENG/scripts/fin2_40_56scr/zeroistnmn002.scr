	#{
		CUST.IPODTD.drActNo = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.IPODTD.errMsg = "Debit Account setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPODTD_TRNPRT1"
	CALL("getcparamvalue.scr")
