	CUST.IPODTD.drClrBal   	= ""
	CUST.IPODTD.errMsg     	= ""
	CUST.IPODTD.drActNo   	= ""
	CUST.IPODTD.crActNo   	= ""
	CUST.IPODTD.tranParts1  = ""
	CUST.IPODTD.tranParts2  = ""
	CUST.IPODTD.tranParts3	= ""
	CUST.IPODTD.tranRmks1   = ""
	CUST.IPODTD.refNumCr1   = ""
	CUST.IPODTD.refNumCr2	= ""
	CUST.IPODTD.bacid1      = ""
	CUST.IPODTD.refNumDr1   = ""
	CUST.IPODTD.refCode     = ""
	CUST.IPODTD.tranRmrk    = ""
	CUST.IPODTD.partSrlNo   = 0
	CUST.IPODTD.recVal      = ""
	
	
	
	BANCS.INPUT.moduleName = "ZEROISTN"
