		#{
		CUST.IPODTD.refNumCr2 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPODTD_REFNMDR"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPODTD.refNumDr1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPODTD.refNumDr1)
		#}
	ELSE
		#{
		CUST.IPODTD.refNumDr1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPODTD_BACID"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPODTD.bacid1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPODTD.bacid1)
		#}
	ELSE
		#{
		CUST.IPODTD.errMsg = "Bacid setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPODTD.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPODTD.refCode)
		#}
	ELSE
		#{
		CUST.IPODTD.errMsg = "Ratecode set up not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPODTD_TRNRMK"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.IPODTD.tranRmrk = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPODTD.tranRmrk)
		#}
	ELSE
		#{
		CUST.IPODTD.errMsg = "Tran remarks setup not done in CPARAM"
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#   Clear balance of debit account no
	#---------------------------------------------------------------------------
	
	sv_s = BANCS.STDIN.mySolId
	PRINT(sv_s)
	CUST.IPODTD.drActNo = sv_s + CUST.IPODTD.drActNo
	PRINT(CUST.IPODTD.drActNo)
	sv_s = "clearBalance |SELECT clr_bal_amt "
	sv_s = sv_s + "FROM TBAADM.GAM "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND  foracid = ?SVAR "
	sv_s = sv_s + "AND entity_cre_flg ='Y' "
	sv_s = sv_s + "AND acct_cls_flg ='N' "
	sv_s = sv_s + "AND del_flg ='N' "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.IPODTD.drActNo
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF (sv_d == 0) THEN
	#{
		CUST.IPODTD.drClrBal = BANCS.OUTPARAM.clearBalance
		PRINT(CUST.IPODTD.drClrBal)
		IF (CDOUBLE(CUST.IPODTD.drClrBal)==0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.IPODTD.drClrBal = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------
	# Charges collected (appFee)
	#--------------------------------------------------------------
	sv_s = "appFee|SELECT count(1)*30 FROM TBAADM.GAM, TBAADM.DTD "
	sv_s = sv_s + "WHERE GAM.acid = DTD.acid "
	sv_s = sv_s + "AND GAM.bank_id = DTD.bank_id "
	sv_s = sv_s + "AND GAM.foracid = ?SVAR "
	sv_s = sv_s + "AND DTD.part_tran_type = 'C' "
	sv_s = sv_s + "AND DTD.ENTRY_USER_ID!='CDCI' "
	sv_s = sv_s + "AND DTD.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.IPODTD.drActNo + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		CUST.IPODTD.appFee = BANCS.OUTPARAM.appFee
		PRINT(CUST.IPODTD.appFee)
		#}
	ELSE
		#{
		CUST.IPODTD.appFee = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------
	# Charges collected (revfee)
	#--------------------------------------------------------------
	sv_s = "revfee|SELECT count(1)*30 FROM TBAADM.GAM, TBAADM.DTD "
	sv_s = sv_s + "WHERE GAM.acid = DTD.acid "
	sv_s = sv_s + "AND GAM.bank_id = DTD.bank_id "
	sv_s = sv_s + "AND GAM.foracid = ?SVAR "
	sv_s = sv_s + "AND DTD.part_tran_type = 'D' "
	sv_s = sv_s + "AND DTD.ENTRY_USER_ID!='CDCI' "
	sv_s = sv_s + "AND (DTD.ref_num is NULL OR DTD.ref_num != ?SVAR) "
	sv_s = sv_s + "AND DTD.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.IPODTD.drActNo + "|" + CUST.IPODTD.refNumDr1 + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.IPODTD.revfee = BANCS.OUTPARAM.revfee
		PRINT(CUST.IPODTD.revfee)
		PRINT(CUST.IPODTD.appFee)
		CUST.IPODTD.appFee = CDOUBLE(CUST.IPODTD.appFee) - CDOUBLE(CUST.IPODTD.revfee)
		PRINT(CUST.IPODTD.appFee)
		#}
	ELSE
		#{
		CUST.IPODTD.appFee = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------
	#totalAmount
	#---------------------------------------------------------------
	sv_s = "totalamt|SELECT sum(tran_amt) FROM TBAADM.GAM,TBAADM.DTD "
	sv_s = sv_s + " WHERE GAM.acid = DTD.acid "
	sv_s = sv_s + " AND GAM.bank_id = DTD.bank_id "
	sv_s = sv_s + " AND GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND DTD.part_tran_type = 'C'"
	sv_s = sv_s + " AND DTD.del_flg = 'N' "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.IPODTD.drActNo + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.IPODTD.totalamt = BANCS.OUTPARAM.totalamt
		PRINT(CUST.IPODTD.totalamt)
		#}
	ELSE
		#{
		CUST.IPODTD.totalamt = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#----------------------------------------------------------------
	#revamt
	#----------------------------------------------------------------
	sv_s = "revamt|SELECT sum(tran_amt) FROM TBAADM.GAM,TBAADM.DTD "
	sv_s = sv_s + "WHERE GAM.acid = DTD.acid "
	sv_s = sv_s + "AND GAM.bank_id = DTD.bank_id "
	sv_s = sv_s + "AND GAM.foracid = ?SVAR "
	sv_s = sv_s + "AND DTD.part_tran_type = 'D' "
	sv_s = sv_s + "AND (DTD.ref_num is NULL OR DTD.ref_num!= ?SVAR) "
	sv_s = sv_s + "AND DTD.del_flg != 'Y' "
	sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.IPODTD.drActNo + "|" + CUST.IPODTD.refNumDr1 + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.IPODTD.revamt = BANCS.OUTPARAM.revamt
		PRINT(CUST.IPODTD.revamt)
		#}
	ELSE
		#{
		CUST.IPODTD.totalamt = "0"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.IPODTD.totalamt = (CDOUBLE(CUST.IPODTD.totalamt)) - (CDOUBLE(CUST.IPODTD.revamt))
	PRINT(CUST.IPODTD.totalamt)
	
	IF ((CUST.IPODTD.appFee == 0) AND (CUST.IPODTD.totalamt == 0))THEN
	#{
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.IPODTD.ipoamt = (CDOUBLE(CUST.IPODTD.totalamt)) - (CDOUBLE(CUST.IPODTD.appFee))
		PRINT(CUST.IPODTD.ipoamt)
	#}
	ENDIF
	
	PRINT(CUST.IPODTD.appFee)
	PRINT(CUST.IPODTD.totalamt)
	PRINT(CUST.IPODTD.ipoamt)
	
	#------------------------------------------------------------------
	# The account not having balance then control goes to end ofscript
	#------------------------------------------------------------------
	IF (CDOUBLE(CUST.IPODTD.appFee) != 0) THEN
	#{
		sv_i = CUST.IPODTD.bacid1 + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
		PRINT(sv_i)
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		PRINT(sv_u)
		IF (sv_u == 1 ) THEN
		#{
			sv_s = "IPO CDS Application Fee Collection A/C not set up "
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.IPODTD.CrAplictAct = BANCS.OUTPARAM.AcctId
		PRINT(CUST.IPODTD.CrAplictAct)
	#}
	ENDIF
	
	#---------------------------------------------------------------
	# Get the transaction level header details from BANCS repository
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.IPODTD.tranRmrk)
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.IPODTD.CrAplictAct)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.IPODTD.CrAplicCrncy = BANCS.OUTPARAM.acctCrncyCode
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.IPODTD.crActNo)
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.IPODTD.crAcctCrncy = BANCS.OUTPARAM.acctCrncyCode
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------
	# Add partTran 0 and 1
	#-----------------------------------------------------
	sv_k = 0
	PRINT(CUST.IPODTD.appFee)
	IF (CDOUBLE(CUST.IPODTD.appFee) < 0) THEN
	#{
		CUST.IPODTD.appFee = ( CDOUBLE(CUST.IPODTD.appFee) * -1 )
		CUST.IPODTD.crdr0 = "D"
		CUST.IPODTD.crdr1 = "C"
		PRINT(CUST.IPODTD.appFee)
		#}
	ELSE
		#{
		CUST.IPODTD.crdr0 = "C"
		CUST.IPODTD.crdr1 = "D"
	#}
	ENDIF
	
	PRINT(CUST.IPODTD.ipoamt)
	
	CUST.IPODTD.partSrlNo = CINT(CUST.IPODTD.partSrlNo) + 1
	PRINT(CUST.IPODTD.partSrlNo)
	CUST.IPODTD.recVal=FORMAT$(CINT(CUST.IPODTD.partSrlNo) - 1,"%d")
	
	sv_w = "tranDtl.partTranDetailLL.<rec_"+CUST.IPODTD.recVal+">."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|"+CUST.IPODTD.partSrlNo)
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|"+CUST.IPODTD.crdr0)
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.IPODTD.CrAplictAct)
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	PRINT(CUST.IPODTD.appFee)
	PRINT(BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.IPODTD.appFee+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum|"+CUST.IPODTD.refNumCr2)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.IPODTD.appFee+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|" + CUST.IPODTD.tranParts1)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.IPODTD.refCode)
	#sv_k = sv_k + 1
	
	IF (CDOUBLE(CUST.IPODTD.ipoamt) < 0) THEN
	#{
		CUST.IPODTD.ipoamt = ( CDOUBLE(CUST.IPODTD.ipoamt) * -1 )
		CUST.IPODTD.crdr0 = "D"
		CUST.IPODTD.crdr1 = "C"
		PRINT(CUST.IPODTD.ipoamt)
		#}
	ELSE
		#{
		CUST.IPODTD.crdr0 = "C"
		CUST.IPODTD.crdr1 = "D"
	#}
	ENDIF
	
	PRINT(CUST.IPODTD.crdr0)
	PRINT(CUST.IPODTD.crdr1)
	CUST.IPODTD.partSrlNo = CINT(CUST.IPODTD.partSrlNo) + 1
	PRINT(CUST.IPODTD.partSrlNo)
	CUST.IPODTD.recVal=FORMAT$(CINT(CUST.IPODTD.partSrlNo) - 1,"%d")
	
	sv_w = "tranDtl.partTranDetailLL.<rec_"+CUST.IPODTD.recVal+">."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|"+CUST.IPODTD.partSrlNo)
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "partTranType.code|"+CUST.IPODTD.crdr0)
	sv_u = urhk_SetUrhkInp(sv_w + "acctId.foracid|"+CUST.IPODTD.crActNo)
	sv_u = urhk_SetUrhkInp(sv_w + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_w + "tranAmt|"+CUST.IPODTD.ipoamt+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "refNum|"+CUST.IPODTD.refNumCr1)
	sv_u = urhk_SetUrhkInp(sv_w + "tranRmks| ")
	sv_u = urhk_SetUrhkInp(sv_w + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
	PRINT(CUST.IPODTD.ipoamt)
	sv_u = urhk_SetUrhkInp(sv_w + "refAmt|"+CUST.IPODTD.ipoamt+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_w + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_w + "tranParticulars|" + BANCS.STDIN.mySolId + CUST.IPODTD.tranParts2)
	sv_u = urhk_SetUrhkInp(sv_w + "rateCode.refCode|" + CUST.IPODTD.refCode)
	#sv_k = sv_k + 1
	
	#---------------------------------------------------------
	# Add partTran 2
	#---------------------------------------------------------
	IF (CDOUBLE(CUST.IPODTD.totalamt) < 0) THEN
	#{
		CUST.IPODTD.totalamt = ( CDOUBLE(CUST.IPODTD.totalamt) * -1 )
		CUST.IPODTD.crdr0 = "D"
		CUST.IPODTD.crdr1 = "C"
		PRINT(CUST.IPODTD.totalamt)
		#}
	ELSE
		#{
		CUST.IPODTD.crdr0 = "C"
		CUST.IPODTD.crdr1 = "D"
	#}
	ENDIF
	
	PRINT(CUST.IPODTD.crdr0)
	PRINT(CUST.IPODTD.crdr1)
	CUST.IPODTD.partSrlNo = CINT(CUST.IPODTD.partSrlNo) + 1
	PRINT(CUST.IPODTD.partSrlNo)
	CUST.IPODTD.recVal=FORMAT$(CINT(CUST.IPODTD.partSrlNo) - 1,"%d")
	
	sv_w = "tranDtl.partTranDetailLL.<rec_"+CUST.IPODTD.recVal+">."
	sv_u = urhk_SetUrhkInp(sv_w + "key.serial_num|"+CUST.IPODTD.partSrlNo)
	sv_u = urhk_SetUrhkInp(sv_w + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
