	#{
		CUST.IPODTD.refNumCr1 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPODTD.refNumCr1)
		#}
	ELSE
		#{
		CUST.IPODTD.refNumCr1 = ""
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "IPODTD_REFNMCR1"
	CALL("getcparamvalue.scr")
