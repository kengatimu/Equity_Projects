	#{
		CUST.IPODTD.tranParts3 = BANCS.OUTPUT.parameterVal
		PRINT(CUST.IPODTD.tranParts3)
		#}
	ELSE
		#{
		CUST.IPODTD.tranParts3 = ""
	#}
	ENDIF
	
	
	BANCS.INPUT.parameterId = "IPODTD_REFNMCR"
	CALL("getcparamvalue.scr")
