if((MTT.InputDetails.isMURTAWFlg != "Y") AND (MTT.InputDetails.isIjarahFlg != "Y") AND (MTT.InputDetails.isMushyarakahFlg != "Y") AND (MTT.InputDetails.isSalamFlg != "Y")) then
if(sv_u < 0)  then
