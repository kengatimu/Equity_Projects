<--start
#trace on
sv_z = urhk_MTTS_PopulateInputDetails("")
sv_p = CDOUBLE(MTT.InputDetails.pendPrincipalAmount)
sv_i = CDOUBLE(MTT.InputDetails.pendInterestAmount)
sv_b = CDOUBLE(MTT.InputDetails.bankChargeAmount)
sv_o = CDOUBLE(MTT.InputDetails.otherChargeAmount)
sv_l = CDOUBLE(MTT.InputDetails.amountInLoanPaymentAcct)
