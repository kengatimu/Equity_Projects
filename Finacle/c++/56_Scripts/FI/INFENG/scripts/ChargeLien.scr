	CREATEREP("CASH")
#}
ENDIF

if (CLASSEXISTS("CASH", "WITH") == 0) then
#{
    CREATECLASS("CASH", "WITH", 5)
#}
ENDIF


IF (FIELDEXISTS(CASH.WITH.Rate) == 1) THEN
	CUST.GCHRG.Rate =  CASH.WITH.Rate
ENDIF

sv_r = urhk_B2k_printRepos("BANCS")
print (sv_r)
sv_z = urhk_B2k_printRepos("CUST")
print (sv_z)

CUST.GCHRG.LienSuccessOrFailure =""
CUST.GCHRG.LienFailureReason =""
