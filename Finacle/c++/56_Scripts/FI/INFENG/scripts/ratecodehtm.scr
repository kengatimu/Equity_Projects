							PRINT(CUST.HTM.rate)
							
							CUST.HTM.treaRate = BANCS.OUTPARAM.treaRate
							PRINT(CUST.HTM.treaRate)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ELSE
				#{
					#CUST.HTM.errorFlg="Y"
					#CUST.HTM.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			
			IF((CUST.HTM.tranType == "T") AND (CUST.HTM.drCrInd == "C")) THEN
			#{
				sv_s = "rateCode| select ratecode_tran from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.HTM.refCrncy + "|" + CUST.HTM.acctCrncy + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF(sv_d ==0) THEN
				#{
					CUST.HTM.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.HTM.rateCode)
					CUST.HTM.BS = MID$(CUST.HTM.rateCode,2,1)
					PRINT(CUST.HTM.BS)
					sv_u = urhk_getAdvanceDetailsForAccount(CUST.HTM.acctId)
					print(sv_u)
					if(sv_u==0)then
						print(BANCS.OUTPARAM.FreeCode7)
						CUST.HTM.FreeCode7 = BANCS.OUTPARAM.FreeCode7
						print(CUST.HTM.FreeCode7)
						IF (((CUST.HTM.refCrncy=="USD") AND (CUST.HTM.acctCrncy =="UGX")) OR ((CUST.HTM.refCrncy=="UGX") AND (CUST.HTM.acctCrncy =="USD")) OR ((CUST.HTM.refCrncy=="GBP") AND (CUST.HTM.acctCrncy =="UGX")) OR ((CUST.HTM.refCrncy=="UGX") AND (CUST.HTM.acctCrncy =="GBP")) OR ((CUST.HTM.refCrncy=="EUR") AND (CUST.HTM.acctCrncy =="UGX")) OR ((CUST.HTM.refCrncy=="UGX") AND (CUST.HTM.acctCrncy =="EUR")) OR ((CUST.HTM.refCrncy=="KES") AND (CUST.HTM.acctCrncy =="UGX")) OR ((CUST.HTM.refCrncy=="UGX") AND (CUST.HTM.acctCrncy =="KES"))) THEN						 
												
							IF ((CUST.HTM.FreeCode7=="FXGA") OR (CUST.HTM.FreeCode7=="FXGB") OR (CUST.HTM.FreeCode7=="FXGC") OR (CUST.HTM.FreeCode7=="FXGD")) THEN
								IF  (CUST.HTM.FreeCode7=="FXGA") THEN
									CUST.HTM.rateCode = "FA" + CUST.HTM.BS
									PRINT (CUST.HTM.rateCode)
								ENDIF
								IF  (CUST.HTM.FreeCode7=="FXGB") THEN
									CUST.HTM.rateCode = "FB" + CUST.HTM.BS
									PRINT (CUST.HTM.rateCode)
								ENDIF
								IF  (CUST.HTM.FreeCode7=="FXGC") THEN
									CUST.HTM.rateCode = "FC" + CUST.HTM.BS
									PRINT (CUST.HTM.rateCode)
								ENDIF
								IF  (CUST.HTM.FreeCode7=="FXGD") THEN
									CUST.HTM.rateCode = "FD" + CUST.HTM.BS
									PRINT (CUST.HTM.rateCode)
								ENDIF	
							ELSE 							
								IF ((FIELDEXISTS(BANCS.INPUT.AmtVal) == 1) AND (CINT(CUST.HTM.AmtVal)> 0 ))  THEN
										print (CUST.HTM.AmtVal)

										BANCS.INPARAM.InputAmount  = CUST.HTM.AmtVal
												BANCS.INPARAM.FromCurrency = CUST.HTM.refCrncy
												BANCS.INPARAM.ToCurrency   = "USD"
												BANCS.INPARAM.RateCode     = CUST.HTM.rateCode
												BANCS.INPARAM.Rate         = CDOUBLE("0.0")
												sv_u = urhk_B2k_ConvertAmount("")
												CUST.HTM.AmtVal = BANCS.OUTPARAM.OutputAmount
												PRINT(CUST.HTM.AmtVal)

								IF (CDOUBLE(CUST.HTM.AmtVal) <= 10000) THEN

									IF (CDOUBLE(CUST.HTM.AmtVal) >= 101) THEN
										CUST.HTM.rateCode  = "FA" + CUST.HTM.BS
										PRINT(CUST.HTM.rateCode)
									ENDIF
									IF (CDOUBLE(CUST.HTM.AmtVal) >= 501) THEN
										CUST.HTM.rateCode  = "FB" + CUST.HTM.BS
										PRINT(CUST.HTM.rateCode)
									ENDIF
									IF (CDOUBLE(CUST.HTM.AmtVal) >= 1001) THEN
										CUST.HTM.rateCode  = "FC" + CUST.HTM.BS
										PRINT(CUST.HTM.rateCode)
									ENDIF	
									IF (CDOUBLE(CUST.HTM.AmtVal) >= 2001) THEN
										CUST.HTM.rateCode  = "FD" + CUST.HTM.BS
										PRINT(CUST.HTM.rateCode)
									ENDIF	
									
								ENDIF
				
								ELSE				
									PRINT(CUST.HTM.rateCode)
								ENDIF														
							ENDIF
						ENDIF
					ENDIF
					sv_s ="rate,treaRate| select var_crncy_units,CUST_VAR_CRNCY_UNITS from tbaadm.rtl where ratecode=?SVAR AND fxd_crncy_code=?SVAR AND var_crncy_code=?SVAR AND bank_id =?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.HTM.rateCode + "|" + CUST.HTM.refCrncy + "|" + CUST.HTM.acctCrncy + "|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)

					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF(sv_d ==0) THEN
					#{
						CUST.HTM.rate = BANCS.OUTPARAM.rate
						PRINT(CUST.HTM.rate)

						CUST.HTM.treaRate = BANCS.OUTPARAM.treaRate
						PRINT(CUST.HTM.treaRate)
					#}
					ELSE
					#{
						sv_s ="rate,treaRate| select var_crncy_units,CUST_VAR_CRNCY_UNITS from tbaadm.rtl where ratecode=?SVAR AND fxd_crncy_code=?SVAR AND var_crncy_code=?SVAR AND bank_id =?SVAR"
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.HTM.rateCode + "|" + CUST.HTM.acctCrncy + "|" + CUST.HTM.refCrncy + "|" + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)

						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						IF(sv_d ==0) THEN
						#{
							CUST.HTM.rate = BANCS.OUTPARAM.rate
							PRINT(CUST.HTM.rate)

							CUST.HTM.treaRate = BANCS.OUTPARAM.treaRate
							PRINT(CUST.HTM.treaRate)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ELSE
				#{
					#CUST.HTM.errorFlg="Y"
					#CUST.HTM.errorMsg ="enter the values manually"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:


PRINT(CUST.HTM.rateCode)
PRINT(CUST.HTM.rate)
PRINT(CUST.HTM.treaRate)
PRINT(CUST.HTM.errorFlg)
PRINT(CUST.HTM.errorMsg)

		sv_u = urhk_SetOrbOut("rateCode|"+CUST.HTM.rateCode)
