					sv_x = "comm|select MERCH_PURCHASE_COMM from CUSTOM.c_merchants where BANK_ID = ?SVAR AND MERCHANT_ID =?SVAR"
					sv_x = sv_x + " AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG ='N' "
