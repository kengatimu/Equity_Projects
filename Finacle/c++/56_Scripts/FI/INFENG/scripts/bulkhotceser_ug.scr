				CUSTS.SBACT.ratecode = "TTB"
				print(CUSTS.SBACT.ratecode)
			ENDIF

			CUSTS.SBACT.branchcode = BANCS.OUTPARAM.branchcode
			print(CUSTS.SBACT.branchcode)
			CUSTS.SBACT.bank_id = BANCS.OUTPARAM.bank_id
			print(CUSTS.SBACT.bank_id)
			CUSTS.SBACT.entity_cre_flg = BANCS.OUTPARAM.entity_cre_flg
			print(CUSTS.SBACT.entity_cre_flg)
			CUSTS.SBACT.bod_date = BANCS.OUTPARAM.bod_date
			print(CUSTS.SBACT.bod_date)
			CUSTS.SBACT.sequence = BANCS.OUTPARAM.sequence
			print(CUSTS.SBACT.sequence)
			CUSTS.SBACT.channel_id = BANCS.OUTPARAM.channel_id
			print(CUSTS.SBACT.channel_id)
			CUSTS.SBACT.charge_amt = BANCS.OUTPARAM.charge_amt
			print(CUSTS.SBACT.charge_amt)
			CUSTS.SBACT.waive_flg = BANCS.OUTPARAM.waive_flg
			print(CUSTS.SBACT.waive_flg)
			CUSTS.SBACT.error_desc = BANCS.OUTPARAM.error_desc
			print(CUSTS.SBACT.error_desc)
			CUSTS.SBACT.channel_ref_no = BANCS.OUTPARAM.channel_ref_no
			print(CUSTS.SBACT.channel_ref_no)
			CUSTS.SBACT.core_ref_no = BANCS.OUTPARAM.core_ref_no
			print(CUSTS.SBACT.core_ref_no)
			CUSTS.SBACT.narations = MID$(BANCS.OUTPARAM.narations,0,50)
			print(CUSTS.SBACT.narations)
			CUSTS.SBACT.saleftchargeaccno=BANCS.OUTPARAM.saleftchargeaccno
			print(CUSTS.SBACT.saleftchargeaccno)
				IF (FIELDEXISTS(CUSTS.SBACT.saleftchargeaccno) == 1)  THEN
				#{
					IF ((CUSTS.SBACT.saleftchargeaccno != "") AND (CUSTS.SBACT.saleftchargeaccno != "null")) THEN
					#{
						BANCS.INPARAM.BINDVARS = CUSTS.SBACT.saleftchargeaccno + "|" + BANCS.STDIN.contextBankId 
						sv_s = "acid,solid|SELECT ACID,sol_id FROM TBAADM.GAM WHERE ENTITY_CRE_fLG='Y' AND DEL_FLG='N' AND FORACID = ?SVAR AND BANK_ID = ?SVAR"
						sv_u = urhk_dbselectWithBind(sv_s)
						IF(sv_u != 0) THEN
						#{
							CUSTS.SBACT.errMsg="The charge account does not exist"
							sv_h = mid$(BANCS.STDIN.BODDate,0,10)
							print(sv_h)

							sv_k ="E"
							sv_y = mid$(CUSTS.SBACT.errMsg,0,90)
							CUSTS.SBACT.core_ref_no =""
							GOTO STEP3
						#}
						ENDIF
					ELSE
						CUSTS.SBACT.saleftchargeaccno = CUSTS.SBACT.debit_acctnum
						print(CUSTS.SBACT.saleftchargeaccno)
					#}
					ENDIF
				ELSE
					CUSTS.SBACT.saleftchargeaccno = CUSTS.SBACT.debit_acctnum
					print(CUSTS.SBACT.saleftchargeaccno)
				#}
				ENDIF
			CUSTS.SBACT.errMsg =""
			CUSTS.SBACT.tranType = "T"
			CUSTS.SBACT.foracid=CUSTS.SBACT.debit_acctnum
			print(CUSTS.SBACT.foracid)
			IF (FIELDEXISTS(CUSTS.SBACT.foracid) == 1)  THEN
			#{
				IF(CUSTS.SBACT.foracid != "")THEN
				#{
					BANCS.INPARAM.BINDVARS = CUSTS.SBACT.foracid + "|" + BANCS.STDIN.contextBankId 
					sv_s = "acid,solid|SELECT ACID,sol_id FROM TBAADM.GAM WHERE ENTITY_CRE_fLG='Y' AND DEL_FLG='N' AND FORACID = ?SVAR AND BANK_ID = ?SVAR"
					sv_u = urhk_dbselectWithBind(sv_s)
					IF(sv_u != 0) THEN
					#{
						CUSTS.SBACT.errMsg="The account does not exist"
						sv_h = mid$(BANCS.STDIN.BODDate,0,10)
						print(sv_h)

						sv_k ="E"
						sv_y = mid$(CUSTS.SBACT.errMsg,0,90)
						CUSTS.SBACT.core_ref_no =""

						GOTO STEP3
					ELSE
						CUSTS.SBACT.sol_id = BANCS.OUTPARAM.solid
						print(CUSTS.SBACT.sol_id)
						sv_h = urhk_getAcctDetailsInRepository(CUSTS.SBACT.foracid)
						print(sv_h)
						IF (sv_h==0) THEN
							CUSTS.SBACT.solidsh = BANCS.OUTPARAM.acctSolId
							print(CUSTS.SBACT.solidsh)
							CUSTS.SBACT.schmcodesh = BANCS.OUTPARAM.schmCode
							print(CUSTS.SBACT.schmcodesh)
							CUSTS.SBACT.schmType = BANCS.OUTPARAM.schmType
							print(CUSTS.SBACT.schmType)
							CUSTS.SBACT.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
							print(CUSTS.SBACT.EffAvailableAmttr)
							IF (CINT(CUSTS.SBACT.EffAvailableAmttr) < CINT(CUSTS.SBACT.amount)) THEN 
								CUSTS.SBACT.errMsg="Insufficient funds"
								sv_k ="E"
								sv_y = mid$(CUSTS.SBACT.errMsg,0,90)
								CUSTS.SBACT.core_ref_no =""
								BANCS.INPARAM.BINDVARS = sv_k + "|" + sv_y + "|" + CUSTS.SBACT.core_ref_no + "|" +  CUSTS.SBACT.sequence + "|" + CUSTS.SBACT.debit_acctnum + "|" + BANCS.STDIN.contextBankId
								print(BANCS.INPARAM.BINDVARS)
								sv_j = "update  CUSTOM.EFTAUTO set ENTITY_CRE_FLG=?SVAR,ERROR_DESC=?SVAR,CORE_REF_NO=?SVAR where SEQUENCE=?SVAR and DEBIT_ACCTNUM=?SVAR  and bank_id=?SVAR "
								sv_w = urhk_dbSQLWithBind(sv_j)
								sv_w = urhk_dbSQLWithBind("COMMIT")
								print(sv_w)
								GOTO STEP3
							ENDIF
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			CUSTS.SBACT.solid=CUSTS.SBACT.sol_id
			print(CUSTS.SBACT.solid)
			CUSTS.SBACT.remitCrncy=CUSTS.SBACT.remitcrncy
			print(CUSTS.SBACT.remitCrncy)
			CUSTS.SBACT.amount=CUSTS.SBACT.amount
			print(CUSTS.SBACT.amount)
			CUSTS.SBACT.amount = CUSTS.SBACT.amount + "|" + CUSTS.SBACT.remitCrncy 
			print(CUSTS.SBACT.amount)
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)
			CUSTS.SBACT.date=" 00:00:00"
			CUSTS.SBACT.date = sv_h + CUSTS.SBACT.date
			print(CUSTS.SBACT.date)
			CUSTS.SBACT.tranCode = CUSTS.SBACT.trans_code
			print(CUSTS.SBACT.tranCode)
			CUSTS.SBACT.rateCode = CUSTS.SBACT.ratecode
			print(CUSTS.SBACT.rateCode)
			CUSTS.SBACT.rate=CUSTS.SBACT.rate
			print(CUSTS.SBACT.rate)
			CUSTS.SBACT.eventId=CUSTS.SBACT.event_id
			print(CUSTS.SBACT.eventId)
			CUSTS.SBACT.waiveflg=CUSTS.SBACT.waive_flg
			print(CUSTS.SBACT.waiveflg)
			CUSTS.SBACT.chargeamt=CUSTS.SBACT.charge_amt
			print(CUSTS.SBACT.chargeamt)
			CUSTS.SBACT.netOrGrossFlg="N"
			CUSTS.SBACT.bacid5 ="BRCLG"
			sv_s = "suspenseAcct| "
			sv_s = sv_s + " SELECT foracid "
			sv_s = sv_s + " FROM tbaadm.GAM "
			sv_s = sv_s + " WHERE bacid = ?SVAR  "
			sv_s = sv_s + " AND sol_id = ?SVAR"
			sv_s = sv_s + " AND acct_ownership = 'O' "
			sv_s = sv_s + " AND acct_cls_flg = 'N' "
			sv_s = sv_s + " AND del_flg ='N'"
			sv_s = sv_s + " AND bank_id = ?SVAR "
			sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUSTS.SBACT.bacid5 + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS	+ CUSTS.SBACT.solid + "|" + BANCS.STDIN.contextBankId + "|" + CUSTS.SBACT.remitCrncy
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == "0") then
				CUSTS.SBACT.suspenseAcct = trim(BANCS.OUTPARAM.suspenseAcct)
				print(CUSTS.SBACT.suspenseAcct)
				#CUSTS.SBACT.suspenseAcct = "0001100204590"
				#print(CUSTS.SBACT.suspenseAcct)
			ELSE
				CUSTS.SBACT.errMsg="Suspense Account for the currency does not Exist"
				sv_h = mid$(BANCS.STDIN.BODDate,0,10)
				print(sv_h)

				sv_k ="E"
				sv_y = mid$(CUSTS.SBACT.errMsg,0,90)
				CUSTS.SBACT.core_ref_no =""

				BANCS.INPARAM.BINDVARS = sv_k + "|" + sv_y + "|" + CUSTS.SBACT.core_ref_no + "|" +  CUSTS.SBACT.sequence + "|" + CUSTS.SBACT.debit_acctnum + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_j = "update  CUSTOM.EFTAUTO set ENTITY_CRE_FLG=?SVAR,ERROR_DESC=?SVAR,CORE_REF_NO=?SVAR where SEQUENCE=?SVAR and DEBIT_ACCTNUM=?SVAR and bank_id=?SVAR "
				sv_w = urhk_dbSQLWithBind(sv_j)
				sv_w = urhk_dbSQLWithBind("COMMIT")
				print(sv_w)
				GOTO STEP3
			ENDIF
			CUSTS.SBACT.destAcct=CUSTS.SBACT.destacct
			print(CUSTS.SBACT.destAcct)
			CUSTS.SBACT.destCustName=mid$(CUSTS.SBACT.dest_cust_name,0,35)
			print(CUSTS.SBACT.destCustName)
			CUSTS.SBACT.bankCode=CUSTS.SBACT.bankcode
			print(CUSTS.SBACT.bankCode)
			CUSTS.SBACT.brCode=CUSTS.SBACT.branchcode
			print(CUSTS.SBACT.brCode)
			CUSTS.SBACT.freeText5 = CUSTS.SBACT.foracid
			print(CUSTS.SBACT.freeText5)
			
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account lien services
			# urhk_SetUrhkInp is used to set inputs 
			#--------------------------------------------------------------------------------------------------------------

				
			sv_u = urhk_SetUrhkInp("ecsTranCrit.tranType|" + CUSTS.SBACT.tranType)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("ecsTranCrit.solId.solId|" + CUSTS.SBACT.solid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("ecsTranCrit.paysysId.refCode|ECS")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("ecsTranGenDet.custAcct.foracid|" + CUSTS.SBACT.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("ecsTranGenDet.tranCode.refCode|" + CUSTS.SBACT.tranCode)
			print(sv_u)
			sv_u = urhk_SetUrhkInp("ecsTranGenDet.settlementDate|" + CUSTS.SBACT.date)
			print(sv_u)
			sv_u = urhk_SetUrhkInp("ecsTranGenDet.remitAmt|" + CUSTS.SBACT.amount)
			print(sv_u)
			sv_u = urhk_SetUrhkInp("ecsTranGenDet.remitCrncy|" + CUSTS.SBACT.remitCrncy)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.rateCode.refCode|" + CUSTS.SBACT.rateCode)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.rate|" + CUSTS.SBACT.rate)
			print(sv_u)
			IF (CUSTS.SBACT.waive_flg!="Y") THEN
				sv_u = urhk_SetUrhkInp("ecsTranGenDet.chrgEventId.eventId|" + CUSTS.SBACT.eventId)
				print(sv_u)
			ENDIF

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.chrgAcct.foracid|" + CUSTS.SBACT.saleftchargeaccno)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.netOrGrossFlg|" + CUSTS.SBACT.netOrGrossFlg)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.suspenseAcct.foracid|" + CUSTS.SBACT.suspenseAcct)
			print(sv_u)
			
			sv_u = urhk_SetUrhkInp("ecsTranGenDet.destAcct|" + CUSTS.SBACT.destAcct)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.destCustName|" + CUSTS.SBACT.destCustName)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.destBankBranch.brCode|" + CUSTS.SBACT.brCode)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.destBankBranch.bankCode|" + CUSTS.SBACT.bankCode)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText4|" + CUSTS.SBACT.sequence)
			print(sv_u)

			sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText5|" + CUSTS.SBACT.freeText5)
			print(sv_u)
			
			sv_u = urhk_SetUrhkInp("ecsTranGenDet.freeText3|" + CUSTS.SBACT.charge_amt)
			print(sv_u)
		
			sv_u = urhk_ExecSrv("SRV_AddEcsTranDtlsAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)


				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						print(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
					#}									
					ELSE
					#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) then
						#{
						sv_u = system("echo 'Error for Acct:"+CUSTS.SBACT.foracid +" ' >>lienedacct.log")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
						sv_f = FORMAT$(sv_i,"%d")
				
							IF (FIELDEXISTS(("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)) == 1) THEN
								sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
								sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
								sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
								print(sv_e)
								CUSTS.SBACT.errMsg=sv_e
								sv_f=urhk_SetOrbOut("Error|"+CUSTS.SBACT.errMsg)
								sv_i = sv_i + 1
								sv_u = system("echo '"+sv_e+"' >>lienedacct.log")
								print(sv_u)
								CUSTS.SBACT.errMsg=CUSTS.SBACT.errMsg

								##################
								sv_h = mid$(BANCS.STDIN.BODDate,0,10)
								print(sv_h)

								sv_k ="E"
								sv_y = mid$(CUSTS.SBACT.errMsg,0,90)
								CUSTS.SBACT.core_ref_no =""
							
								BANCS.INPARAM.BINDVARS = sv_k + "|" + sv_y + "|" + CUSTS.SBACT.core_ref_no + "|" +  CUSTS.SBACT.sequence + "|" + CUSTS.SBACT.debit_acctnum + "|" + BANCS.STDIN.contextBankId
								print(BANCS.INPARAM.BINDVARS)
								sv_j = "update  CUSTOM.EFTAUTO set ENTITY_CRE_FLG=?SVAR,ERROR_DESC=?SVAR,CORE_REF_NO=?SVAR where SEQUENCE=?SVAR and DEBIT_ACCTNUM=?SVAR and bank_id=?SVAR "
								sv_w = urhk_dbSQLWithBind(sv_j)
								sv_w = urhk_dbSQLWithBind("COMMIT")
								print(sv_w)
							ELSE
								GOTO STEP2

							ENDIF
						#}
						DO
						#}
STEP2:
					ENDIF
				ELSE
					

					CUSTS.SBACT.errMsg="SUCCESS"
					##################
					sv_h = mid$(BANCS.STDIN.BODDate,0,10)
					print(sv_h)

					IF (CUSTS.SBACT.errMsg=="SUCCESS") THEN
						sv_k ="P"
						sv_y ="SUCCESS"
						
						sv_s = "core_ref_no|"
						sv_s = sv_s + " select TRAN_ID from tbaadm.otc where bank_id=?SVAR and  free_text5=?SVAR and FREE_TEXT4=?SVAR and rownum<2 "
						BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUSTS.SBACT.debit_acctnum + "|" + CUSTS.SBACT.sequence 
						print(BANCS.INPARAM.BINDVARS)
						sv_d=urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF (sv_d != 0) THEN
						#{
							CUSTS.SBACT.errMsg 	= "Error in finding ref_desc"
							GOTO End
						#}
						ELSE
						#{
							CUSTS.SBACT.core_ref_no= BANCS.OUTPARAM.core_ref_no
							print(CUSTS.SBACT.core_ref_no)
							##
							IF (FIELDEXISTS(CUSTS.SBACT.core_ref_no) == 1) THEN
								IF (FIELDEXISTS(CUSTS.SBACT.narations) == 1) THEN
									IF (CUSTS.SBACT.narations!="") THEN
										print(CUSTS.SBACT.core_ref_no)
										sv_h = mid$(BANCS.STDIN.BODDate,0,10)
										sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
										BANCS.INPARAM.BINDVARS =  sv_h
										sv_d = urhk_dbSelectWithBind(sv_s)
										##print(sv_d)
										IF (sv_d =="0") THEN
											CUSTS.SBACT.getboddate = BANCS.OUTPARAM.getboddate
											print(CUSTS.SBACT.getboddate)
										ENDIF
										sv_s = "UPDATE TBAADM.DTD SET TRAN_PARTICULAR = ?SVAR WHERE TRAN_ID = LPAD(?SVAR,9)"
										sv_s = sv_s + " AND TRAN_DATE = ?SVAR "
										sv_s = sv_s + " AND BANK_ID = ?SVAR "
										print(sv_s)
										BANCS.INPARAM.BINDVARS = CUSTS.SBACT.narations + "|" + CUSTS.SBACT.core_ref_no + "|" + CUSTS.SBACT.getboddate
										BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
										print(BANCS.INPARAM.BINDVARS)
										sv_w = urhk_dbSQLWithBind(sv_s)
										print(sv_w)
										sv_w = urhk_dbSQLWithBind("COMMIT")
										IF(sv_w == 0)THEN
										#{
											sv_d = urhk_dbSqlWithBind("COMMIT")
											print(sv_d)
										#}
										ENDIF
									ENDIF
								ENDIF
							ENDIF
							##
						#}
						ENDIF

					ELSE
						sv_k ="E"
						sv_y = mid$(CUSTS.SBACT.errMsg,0,90)
						CUSTS.SBACT.core_ref_no =""
					ENDIF
STEP3:
					BANCS.INPARAM.BINDVARS = sv_k + "|" + sv_y + "|" + CUSTS.SBACT.core_ref_no + "|" +  CUSTS.SBACT.sequence + "|" + CUSTS.SBACT.debit_acctnum + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					sv_j = "update  CUSTOM.EFTAUTO set ENTITY_CRE_FLG=?SVAR,ERROR_DESC=?SVAR,CORE_REF_NO=?SVAR where SEQUENCE=?SVAR and DEBIT_ACCTNUM=?SVAR and bank_id=?SVAR  "
					sv_w = urhk_dbSQLWithBind(sv_j)
					sv_w = urhk_dbSQLWithBind("COMMIT")
					print(sv_w)
				#}
				ENDIF

		ENDIF
	DO
	sv_c = urhk_dbCursorClose(CUSTS.SBACT.MainCursor) 
End:
TRACE OFF
EXITSCRIPT

end-->
