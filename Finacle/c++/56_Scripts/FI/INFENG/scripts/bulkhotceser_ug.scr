#{
	CREATEREP("CUSTS")
#}
ENDIF

IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
#{
	CREATECLASS("CUSTS","SBACT",5)
#}
ENDIF

IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
#{
    CREATECLASS("CUSTS","SBACT", 5)
#}
ENDIF

sv_s="narations,remitcrncy,rate,dest_cust_name,destacct,event_id,debit_acctnum,trans_code,amount,bankcode,sol_id,ratecode,branchcode,bank_id,entity_cre_flg,bod_date,sequence,channel_id,charge_amt,waive_flg,error_desc,channel_ref_no,core_ref_no,saleftchargeaccno|"
sv_s = sv_s + " select NARATIONS,REMITCRNCY,RATE,DEST_CUST_NAME,DESTACCT,EVENT_ID,DEBIT_ACCTNUM,TRANS_CODE,AMOUNT,BANKCODE,SOL_ID,RATECODE,BRANCHCODE,BANK_ID,ENTITY_CRE_FLG,BOD_DATE,SEQUENCE,CHANNEL_ID,CHARGE_AMT,WAIVE_FLG,ERROR_DESC,CHANNEL_REF_NO,CORE_REF_NO,SAL_EFT_CHARGE_ACC_NO "
sv_s = sv_s + " from CUSTOM.EFTAUTO where ENTITY_CRE_FLG='N' and BANK_ID='56' "
print(sv_s)

	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_o)

	print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUSTS.SBACT.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(CUSTS.SBACT.MainCursor)

	#------------------------------------------------------------------
	#  Variable Initialisation for counter. It should be Zero
	#------------------------------------------------------------------
		sv_z = 0

	while (sv_o == 0)
		sv_c = urhk_dbCursorFetch(CUSTS.SBACT.MainCursor)
		print(sv_c)
		IF (sv_c != 0) THEN
		#{ 
			print("in")

            		print(sv_c)
	    		sv_o = 1
		#}
		ELSE 
		#{

			CUSTS.SBACT.remitcrncy = BANCS.OUTPARAM.remitcrncy
			print(CUSTS.SBACT.remitcrncy)
			CUSTS.SBACT.rate = BANCS.OUTPARAM.rate
			print(CUSTS.SBACT.rate)
			CUSTS.SBACT.dest_cust_name = BANCS.OUTPARAM.dest_cust_name
			print(CUSTS.SBACT.dest_cust_name)
			CUSTS.SBACT.destacct = BANCS.OUTPARAM.destacct
			print(CUSTS.SBACT.destacct)
			CUSTS.SBACT.event_id = BANCS.OUTPARAM.event_id
			print(CUSTS.SBACT.event_id)
			CUSTS.SBACT.debit_acctnum = BANCS.OUTPARAM.debit_acctnum
			print(CUSTS.SBACT.debit_acctnum)
			CUSTS.SBACT.trans_code = BANCS.OUTPARAM.trans_code
			print(CUSTS.SBACT.trans_code)
			CUSTS.SBACT.amount = BANCS.OUTPARAM.amount
			print(CUSTS.SBACT.amount)
			CUSTS.SBACT.bankcode = BANCS.OUTPARAM.bankcode
			print(CUSTS.SBACT.bankcode)
			CUSTS.SBACT.ratecode = BANCS.OUTPARAM.ratecode
			print(CUSTS.SBACT.ratecode)
