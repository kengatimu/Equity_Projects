#------------------------------------------------------------------------------------------------    
#   Name			: laadisbdp002.scr
#   Description		: Insu charge amount is calculated in this script
#   Date			: 31-03-2013
#   Author			: Sateesh
#   Input			: NA
#   Output			: NA
#   Called Script	: s_laadisbdp007.scr
#   Calling Script	: laadisbdp008.scr
#   Menu Option		:
#	Srl. No         Date            Author          	Description.
#	-------         ------          ------          	------------
#   1.0             31-03-2013      Sateesh				Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="138503e8d2d3c6a21263e0ffa257f4b9f8ac4659a663a3d387356c2b9daaf92d"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Initializing required variables
	#------------------------------------------------------------------------------
	sv_u = urhk_Setorbout("Error|dummy")
	sv_u = urhk_Setorbout("Fld|dummy")
	CUST.LADISB.errMsg		= ""
	CUST.LADISB.fld			= ""
	CUST.LADISB.shares 		= ""
	CUST.LADISB.disbAmt 	= ""
	CUST.LADISB.idNumber	= ""
	CUST.LADISB.cdsNumber	= ""
	CUST.LADISB.name 		= ""
	CUST.LADISB.shar		= "dummy"
	CUST.LADISB.regNum		= "dummy"
	CUST.LADISB.cds			= "dummy"
	CUST.LADISB.cdupMemCode = ""
	
	CUST.LADISB.loanAcctId 			= BANCS.INPUT.loanAcctId
	print(CUST.LADISB.loanAcctId)
	CUST.LADISB.cdsNumber			= BANCS.INPUT.cdsNo
	print(CUST.LADISB.cdsNumber)
	CUST.LADISB.category			= BANCS.INPUT.category
	print(CUST.LADISB.category)
	CUST.LADISB.idNumber			= BANCS.INPUT.regNum
	print(CUST.LADISB.idNumber)
	CUST.LADISB.shares				= BANCS.INPUT.shares
	print(CUST.LADISB.shares)
	CUST.LADISB.disbAmt				= BANCS.INPUT.disbAmt
	print(CUST.LADISB.disbAmt)
	
	#-------------------------------------------------------------------------
	# Creating CPARAM Setup
	#--------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "LOANDISB"
	
	#----------------------------------------------------------------
	# Getting parameter value for SP_DIV5---5
	#----------------------------------------------------------------
	BANCS.INPUT.parameterId = "SP_DIV5"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.div5 = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.div5)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "CPARAM setup is not done for SP_DIV5"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#----------------------------------------------------------------
	# Getting parameter value for SP_EXPSHARE---'2000'
	#----------------------------------------------------------------
	BANCS.INPUT.parameterId = "SP_EXPSHARE"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.expshare = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.expshare)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "CPARAM setup is not done for SP_EXPSHARE"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#----------------------------------------------------------------
	# Getting parameter value for SP_CDSEQT---'EQT'
	#----------------------------------------------------------------
	BANCS.INPUT.parameterId = "SP_CDSEQT"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.cdsEqt = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.cdsEqt)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "CPARAM setup is not done for SP_CDSEQT"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#----------------------------------------------------------------
	# Getting parameter value for SP_CDSC---'/C-'
	#----------------------------------------------------------------
	BANCS.INPUT.parameterId = "SP_CDSC"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.cdsC = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.cdsC)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "CPARAM setup is not done for SP_CDSC"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	#Getting categoryRDBlock values from CPARAM--R,D--'500' I--50000 E--1000
	#-----------------------------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "LOANDISB"
	BANCS.INPUT.parameterId = "SP_"+ CUST.LADISB.category + "_BLK"
	CALL ("getcparamvalue.scr")
	CUST.CPARAM.ctgryBlk = BANCS.OUTPUT.parameterVal
	
	#-----------------------------------------------------------------------------------------------
	#Getting categoryRDMinimum values from CPARAM--R,D,E-'2000' I--'100000'
	#-----------------------------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "LOANDISB"
	BANCS.INPUT.parameterId = "SP_" + CUST.LADISB.category + "_MIN"
	CALL ("getcparamvalue.scr")
	CUST.CPARAM.ctgryMin = BANCS.OUTPUT.parameterVal
	
	#-----------------------------------------------------------------------------------------------
	#Getting categoryRDSHBlock values from CPARAM--R,D--'100' I--'10000' E--'200'
	#-----------------------------------------------------------------------------------------------
	BANCS.INPUT.moduleName = "LOANDISB"
	BANCS.INPUT.parameterId = "SP_" + CUST.LADISB.category + "_SHB"
	CALL ("getcparamvalue.scr")
	CUST.CPARAM.ctgryShBlk = BANCS.OUTPUT.parameterVal
	print(CUST.CPARAM.ctgryShBlk)
	
	#--------------------------------------------------------------------------
	#The foll step is to Validate amount
	#---------------------------------------------------------------------------
	IF (CUST.LADISB.disbAmt == "") THEN
	#{
		CUST.LADISB.errMsg = "Please Enter the amount"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF (CUST.LADISB.disbAmt == "0") THEN
		#{
			CUST.LADISB.errMsg = "Amount should be greater that zero"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.expshares = CDOUBLE(CUST.LADISB.disbAmt)/CDOUBLE(CUST.CPARAM.div5)
			print(CUST.LADISB.expshares)
			IF (CDOUBLE(CUST.LADISB.expshares) < CDOUBLE(CUST.CPARAM.expshare)) THEN
			#{
				CUST.LADISB.tempVal = CINT(CUST.CPARAM.expshare) * 5
				CUST.LADISB.errMsg = "The minimum number of shares is" + CUST.CPARAM.expshare + ". Minimum Disbursement amount should be " + CUST.LADISB.tempVal
				CUST.LADISB.fld = "amt"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate shares
	#---------------------------------------------------------------------------
	IF (CDOUBLE(CUST.LADISB.expshares) != CDOUBLE(CUST.LADISB.shares) ) THEN
	#{
		CUST.LADISB.tempVal = CINT(CUST.LADISB.expshares)
		CUST.LADISB.errMsg = "The Number of shares is not equal to amount entered" + CUST.LADISB.tempVal
		CUST.LADISB.fld = "share"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Category
	#---------------------------------------------------------------------------
	IF (CDOUBLE(CUST.LADISB.disbAmt) < CDOUBLE(CUST.CPARAM.ctgryMin)) THEN
	#{
		CUST.LADISB.errMsg = "The minimum application amount for this category is " + CUST.CPARAM.ctgryMin
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s= ""
	sv_s = sv_s + " reminder|"
	sv_s = sv_s + " SELECT"
	sv_s = sv_s + " MOD ( " + CUST.LADISB.disbAmt + "," + CUST.CPARAM.ctgryBlk + ")"
	sv_s = sv_s + " FROM DUAL"
	print(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0) THEN
	#{
		print(BANCS.OUTPARAM.reminder)
		IF (BANCS.OUTPARAM.reminder != 0) THEN
		#{
			CUST.LADISB.errMsg = "The Shares applied must be in mutiples of " + CUST.CPARAM.ctgryBlk
			CUST.LADISB.fld = "share"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "Database error ask for assistance from the dba.."
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s= ""
	sv_s = sv_s + " shreminder|"
	sv_s = sv_s + " SELECT"
	sv_s = sv_s + " MOD ( " + CUST.LADISB.shares + "," + CUST.CPARAM.ctgryShBlk + ")"
	sv_s = sv_s + " FROM DUAL"
	print(sv_s)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == 0) THEN
	#{
		print(BANCS.OUTPARAM.shreminder)
		IF (BANCS.OUTPARAM.shreminder!=0) THEN
		#{
			CUST.LADISB.errMsg = "The Shares applied must be in mutiples of " + CUST.CPARAM.ctgryShBlk
			CUST.LADISB.fld = "share"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "Database error ask for assistance from the dba.."
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (FIELDEXISTS(CUST.LADISB.cdsNumber)) THEN
	#{
		IF (MID$(CUST.LADISB.cdsNumber,0,3) == CUST.CPARAM.cdsEqt) THEN
		#{
			CUST.LADISB.cdupPrefix = CUST.LADISB.cdsNumber
			print(CUST.LADISB.cdupPrefix)
			#}
		ELSE
			#{
			sv_s = "cdupMemCode, cdupMemType, cdupPrefix|"
			sv_s = sv_s + " SELECT SUBSTR('" +CUST.LADISB.cdsNumber + "',1,INSTR('" +CUST.LADISB.cdsNumber + "','/') - 1) ,"
			sv_s = sv_s + " SUBSTR('" + CUST.LADISB.cdsNumber + "' ,INSTR('" +CUST.LADISB.cdsNumber + "','/') + 1 ,1 ) ,"
			sv_s = sv_s + " LTRIM(SUBSTR('" +CUST.LADISB.cdsNumber + "',INSTR('" +CUST.LADISB.cdsNumber + "' ,'-') + 1 ),'0')"
			sv_s = sv_s + " FROM DUAL"
			print(sv_s)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			IF ( sv_d != 0 ) THEN
			#{
				CUST.LADISB.errMsg = "Invalid CDC Number Value OR Format."
				CUST.LADISB.fld = "cdcNo"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			CUST.LADISB.cdupMemCode		= BANCS.OUTPARAM.cdupMemCode
			CUST.LADISB.cdupPrefix		= BANCS.OUTPARAM.cdupPrefix
			print(CUST.LADISB.cdupMemCode)
			print(CUST.LADISB.cdupPrefix)
		#}
		ENDIF
		
		IF (MID$(CUST.LADISB.cdsNumber,0,3)== CUST.CPARAM.cdsEqt) THEN
		#{
			sv_s = "idNumber,surName,otherName|"
			sv_s = sv_s + " SELECT "
			sv_s = sv_s + " A.ctn_id_pps_registration_no,A.ctn_surname,A.ctn_other_names"
			sv_s = sv_s + " FROM"
			sv_s = sv_s + " CUSTOM.CDSC_TEMP_NUMBERS A"
			sv_s = sv_s + " WHERE"
			sv_s = sv_s + " A.ctn_serial_no =?SVAR"
			sv_s = sv_s + " AND A.bank_id =?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = ""
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.cdupPrefix 	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			#}
		ELSE
			#{
			sv_s = "idNumber,surName,otherName|"
			sv_s = sv_s + " SELECT"
			sv_s = sv_s + " B.cdup_id_pps_number,B.cdup_surname,B.cdup_other_names"
			sv_s = sv_s + " FROM CUSTOM.CDSC_DMP B"
			sv_s = sv_s + " WHERE"
			sv_s = sv_s + " TO_CHAR(B.cdup_prefix) =?SVAR"
			sv_s = sv_s + " AND B.cdup_mem_code =?SVAR"
			sv_s = sv_s + " AND B.bank_id =?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS = ""
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.cdupPrefix 	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.cdupMemCode 	+ "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
		#}
		ENDIF
		print(sv_s)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		IF ( sv_d != 0 ) THEN
		#{
			CUST.LADISB.errMsg = "Invalid CDS number."
			CUST.LADISB.fld = "cdcNo"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.cdcIdNumber = BANCS.OUTPARAM.idNumber
			print(CUST.LADISB.cdcIdNumber)
			print(CUST.LADISB.idNumber)
			IF (CUST.LADISB.idNumber != CUST.LADISB.cdcIdNumber) THEN
			#{
				CUST.LADISB.errMsg = "Invalid ID/PP/REG number."
				CUST.LADISB.fld = "regNo"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			IF (MID$(CUST.LADISB.cdsNumber,0,3) != CUST.CPARAM.cdsEqt) THEN
			#{
				CUST.LADISB.cdsNumber= CUST.LADISB.cdupMemCode + CUST.CPARAM.cdsC + CUST.LADISB.cdupPrefix
				print(CUST.LADISB.cdsNumber)
			#}
			ENDIF
			CUST.LADISB.sname 		= BANCS.OUTPARAM.surName
			CUST.LADISB.oname 		= BANCS.OUTPARAM.otherName
			CUST.LADISB.name 		= CUST.LADISB.sname + " " + CUST.LADISB.oname
			CUST.LADISB.cdcIdNumber = BANCS.OUTPARAM.idNumber
		#}
		ENDIF
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "" ) THEN
		#{
			sv_u = urhk_Setorbout("Error|"+CUST.LADISB.errMsg)
			sv_u = urhk_Setorbout("Fld|"+CUST.LADISB.fld)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
