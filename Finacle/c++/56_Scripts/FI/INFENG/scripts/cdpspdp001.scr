		sv_h ="AcctStat|SELECT ACCT_STATUS FROM TBAADM.SMT WHERE BANK_ID = ?SVAR AND ACID IN"
		sv_h = sv_h + " (SELECT ACID FROM GAM WHERE  FORACID = ?SVAR "
