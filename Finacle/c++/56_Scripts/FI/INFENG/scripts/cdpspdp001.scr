	########################################################
	## NO OF TRANSACTIONS
	#######################################################
	print(CUST.PORT.frmdate)
	print(CUST.PORT.cut_over_date)
	BANCS.INPARAM.date1 = CUST.PORT.frmdate
	BANCS.INPARAM.date2 = CUST.PORT.cut_over_date

    sv_u = urhk_B2k_dateDiff("")
    IF (sv_u == 0) THEN
    #{
    print(BANCS.OUTPARAM.dateDiff)
    IF (BANCS.OUTPARAM.dateDiff < 0) THEN
    	sv_s = "trans|"
    	sv_s = sv_s + " SELECT COUNT(1) FROM("
        sv_s = sv_s + " SELECT"
    	#sv_s = sv_s + " distinct DTD.TRAN_ID"
	sv_s = sv_s + " DTD.TRAN_ID"
    	sv_s = sv_s + " FROM"
    	sv_s = sv_s + " TBAADM.DTD,TBAADM.GAM"
    	sv_s = sv_s + " WHERE"
    	sv_s = sv_s + " GAM.acid=DTD.acid"
    	sv_s = sv_s + " AND GAM.foracid=?SVAR"
    	sv_s = sv_s + " AND DTD.tran_date BETWEEN TO_DATE(?SVAR,'DD-MM-YYYY') AND TO_DATE(?SVAR,'DD-MM-YYYY')"
    	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
    	sv_s = sv_s + " AND GAM.del_flg = 'N'"
    	sv_s = sv_s + " AND DTD.del_flg = 'N'"
        sv_s = sv_s + " AND DTD.PSTD_flg= 'Y'"
    	sv_s = sv_s + " AND GAM.bank_id =?SVAR"
    	sv_s = sv_s + " UNION"
    	sv_s = sv_s + " SELECT"
    	#sv_s = sv_s + " distinct HTD.TRAN_ID"
	sv_s = sv_s + " HTD.TRAN_ID"
    	sv_s = sv_s + " FROM"
    	sv_s = sv_s + " TBAADM.HTD,TBAADM.GAM"
    	sv_s = sv_s + " WHERE"
    	sv_s = sv_s + " GAM.acid=HTD.acid"
    	sv_s = sv_s + " AND GAM.foracid=?SVAR"
    	sv_s = sv_s + " AND HTD.tran_date BETWEEN TO_DATE(?SVAR,'DD-MM-YYYY') AND TO_DATE(?SVAR,'DD-MM-YYYY')"
    	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
    	sv_s = sv_s + " AND GAM.del_flg = 'N'"
    	sv_s = sv_s + " AND HTD.del_flg = 'N'"
        sv_s = sv_s + " AND HTD.PSTD_flg= 'Y'"
    	sv_s = sv_s + " AND GAM.bank_id =?SVAR"
        sv_s = sv_s + " UNION"
        sv_s = sv_s + " SELECT"
        #sv_s = sv_s + " distinct C_HTD.TRAN_ID"
	sv_s = sv_s + " C_HTD.TRAN_ID"
        sv_s = sv_s + " FROM"
        sv_s = sv_s + " CUSTOM.C_HTD,TBAADM.GAM"
        sv_s = sv_s + " WHERE"
        sv_s = sv_s + " GAM.acid=C_HTD.acid"
        sv_s = sv_s + " AND GAM.foracid=?SVAR"
        sv_s = sv_s + " AND C_HTD.tran_date BETWEEN TO_DATE(?SVAR,'DD-MM-YYYY') AND TO_DATE(?SVAR,'DD-MM-YYYY')"
        sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
        sv_s = sv_s + " AND GAM.del_flg = 'N'"
        sv_s = sv_s + " AND C_HTD.del_flg = 'N'"
        sv_s = sv_s + " AND C_HTD.PSTD_flg= 'Y'"
        sv_s = sv_s + " AND GAM.bank_id =?SVAR)"
        BANCS.INPARAM.BINDVARS = CUST.PORT.acctNum + "|" + CUST.PORT.frmdate +"|"+ CUST.PORT.todate +"|"+ BANCS.STDIN.contextBankId + "|"+CUST.PORT.acctNum + "|" + CUST.PORT.frmdate +"|"+ CUST.PORT.todate +"|"+ BANCS.STDIN.contextBankId+ "|"+CUST.PORT.acctNum + "|" + CUST.PORT.frmdate +"|"+ CUST.PORT.todate +"|"+ BANCS.STDIN.contextBankId
    ELSE
        sv_s = "trans|"
        sv_s = sv_s + " SELECT COUNT(1) FROM("
        sv_s = sv_s + " SELECT"
        #sv_s = sv_s + " distinct DTD.TRAN_ID"
	sv_s = sv_s + " DTD.TRAN_ID"
        sv_s = sv_s + " FROM"
        sv_s = sv_s + " TBAADM.DTD,TBAADM.GAM"
        sv_s = sv_s + " WHERE"
        sv_s = sv_s + " GAM.acid=DTD.acid"
        sv_s = sv_s + " AND GAM.foracid=?SVAR"
        sv_s = sv_s + " AND DTD.tran_date BETWEEN TO_DATE(?SVAR,'DD-MM-YYYY') AND TO_DATE(?SVAR,'DD-MM-YYYY')"
        sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
        sv_s = sv_s + " AND GAM.del_flg = 'N'"
        sv_s = sv_s + " AND DTD.del_flg = 'N'"
        sv_s = sv_s + " AND DTD.PSTD_flg= 'Y'"
        sv_s = sv_s + " AND GAM.bank_id =?SVAR"
        sv_s = sv_s + " UNION"
        sv_s = sv_s + " SELECT"
        #sv_s = sv_s + " distinct HTD.TRAN_ID"
	sv_s = sv_s + " HTD.TRAN_ID"
        sv_s = sv_s + " FROM"
        sv_s = sv_s + " TBAADM.HTD,TBAADM.GAM"
        sv_s = sv_s + " WHERE"
        sv_s = sv_s + " GAM.acid=HTD.acid"
        sv_s = sv_s + " AND GAM.foracid=?SVAR"
        sv_s = sv_s + " AND HTD.tran_date BETWEEN TO_DATE(?SVAR,'DD-MM-YYYY') AND TO_DATE(?SVAR,'DD-MM-YYYY')"
        sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
        sv_s = sv_s + " AND GAM.del_flg = 'N'"
        sv_s = sv_s + " AND HTD.del_flg = 'N'"
        sv_s = sv_s + " AND HTD.PSTD_flg= 'Y'"
        sv_s = sv_s + " AND GAM.bank_id =?SVAR)"
        BANCS.INPARAM.BINDVARS = CUST.PORT.acctNum + "|" + CUST.PORT.frmdate +"|"+ CUST.PORT.todate +"|"+ BANCS.STDIN.contextBankId + "|"+CUST.PORT.acctNum + "|" + CUST.PORT.frmdate +"|"+ CUST.PORT.todate +"|"+ BANCS.STDIN.contextBankId
    ENDIF
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
    print(BANCS.OUTPARAM.trans)
	CUST.PORT.trans = CINT(BANCS.OUTPARAM.trans)
	print(CINT(CUST.PORT.trans))
	IF (sv_d == 0) THEN
	#{
		IF (CINT(CUST.PORT.trans) > 0) THEN
		#{	
            		CUST.PORT.noofpages=CDOUBLE(CUST.PORT.trans)/(CDOUBLE(CUST.PORT.trnpg)+CINT("1"))
			print(CUST.PORT.noofpages)
            		sv_s =  "nopg|SELECT"
            		sv_s = sv_s + " CEIL(?SVAR)"
            		sv_s = sv_s + " FROM"
            		sv_s = sv_s + " DUAL"
			BANCS.INPARAM.BINDVARS = CUST.PORT.noofpages
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(BANCS.OUTPARAM.nopg)
			CUST.PORT.nopg = BANCS.OUTPARAM.nopg

				IF (BANCS.STDIN.contextBankId=="56")  THEN
					IF (CUST.PORT.schmcode=="CA217") THEN
						CUST.PORT.crgamt="5000"
						print(CUST.PORT.crgamt)
					ENDIF
				ENDIF

				IF (BANCS.STDIN.contextBankId=="50")  THEN
				#{
					IF ((CUST.PORT.schmcode=="SB190") OR (CUST.PORT.schmcode=="CA217") OR (CUST.PORT.schmcode=="CA219") OR (CUST.PORT.schmcode=="CA202")) THEN
					#{
						CUST.PORT.chargeamt="0"
						print(CUST.PORT.chargeamt)
					#}
					ELSE
					#{

						CUST.PORT.chargeamt=(CDOUBLE(CUST.PORT.nopg) * CDOUBLE(CUST.PORT.crgamt))
						print(CUST.PORT.chargeamt)
					#}
					ENDIF
				#}
				ELSE
				#{
					IF ((CUST.PORT.schmcode=="SB190") OR (CUST.PORT.schmcode=="CA217") OR (CUST.PORT.schmcode=="CA219")OR (CUST.PORT.schmcode=="CA218")) THEN
					#{
						CUST.PORT.chargeamt="0"
						print(CUST.PORT.chargeamt)
					#}
					ELSE
					#{

						CUST.PORT.chargeamt=(CDOUBLE(CUST.PORT.nopg) * CDOUBLE(CUST.PORT.crgamt))
						print(CUST.PORT.chargeamt)
					#}
					ENDIF
				#}
				ENDIF

							
			
			## No of Pages
			sv_m = "NoOfPg|"+CUST.PORT.nopg
			sv_u = urhk_SetOrbOut(sv_m)

			## Charge Per pages
			sv_m = "chrgAmt|"+CUST.PORT.crgamt
			sv_u = urhk_SetOrbOut(sv_m)
			
			## Charge Per pages
			sv_m = "chargeamt|"+CUST.PORT.chargeamt
			sv_u = urhk_SetOrbOut(sv_m)

		       IF(CDOUBLE(CUST.PORT.chargeamt) > CDOUBLE(CUST.PORT.effAvlAmt)) THEN
                    	#{
				sv_m = "chrgAvl|N"
				sv_u = urhk_SetOrbOut(sv_m)
			#}
			ELSE
			#{
				sv_m = "chrgAvl|Y"
				sv_u = urhk_SetOrbOut(sv_m)
			#}
			ENDIF
		#}
		ELSE
		#{
			if(CUST.PORT.print_no_tran == "Y") then
			#{
			
				CUST.PORT.nopg = "1"
				CUST.PORT.chargeamt=(CDOUBLE(CUST.PORT.nopg) * CDOUBLE(CUST.PORT.crgamt))
				print(CUST.PORT.chargeamt)
				## No of Pages
				sv_m = "NoOfPg|"+CUST.PORT.nopg
				sv_u = urhk_SetOrbOut(sv_m)

				## Charge Per pages
				sv_m = "chrgAmt|"+CUST.PORT.crgamt
				sv_u = urhk_SetOrbOut(sv_m)

				## Charge Per pages
				sv_m = "chargeamt|"+CUST.PORT.chargeamt
				sv_u = urhk_SetOrbOut(sv_m)

				IF(CDOUBLE(CUST.PORT.chargeamt) > CDOUBLE(CUST.PORT.effAvlAmt)) THEN
				#{
					sv_m = "chrgAvl|N"
					sv_u = urhk_SetOrbOut(sv_m)
				#}
				ELSE
				#{
					sv_m = "chrgAvl|Y"
					sv_u = urhk_SetOrbOut(sv_m)
				#}
				ENDIF
			
			#}			
			else
			#{
				sv_e = "No transactions available for the details entered."
				sv_m = "ErrOcc|"
				sv_s = sv_m+sv_e
				sv_u = urhk_SetOrbOut(sv_s)
			#}
			endif
		
		#}
		ENDIF
	#}
	ENDIF	
   
ENDOFSCRIPT:

