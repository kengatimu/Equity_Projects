        # Setting input values for urhk_ConnectToFIAndSendMsg userhook
        #-------------------------------------------------------------------------------
        BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
        BANCS.INPARAM.SEND_RECV_FLG             = "R"
        sv_a = CUST.DATA.reqXMLMsg
        PRINT(sv_a)

        #-------------------------------------------------------------------------
        #- Executing the userhook to make the Outbound Call
        #-------------------------------------------------------------------------
        sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
        PRINT(sv_l)
        IF (sv_l != 0) THEN
        #{
                PRINT(BANCS.OUTPARAM.ErrMsg)
                CUST.DATA.errorMsgFlg = "Y"
                CUST.DATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
                CUST.DATA.errorMsgCode = "FIERR"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

  IF (BANCS.OUTPARAM.ErrMsg != "") THEN
        #{
                CUST.DATA.errorMsgFlg = "Y"
                CUST.DATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                CUST.DATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
                CUST.DATA.errorMsgCode = "FIERR"
                GOTO ENDOFSCRIPT
                #}
        ELSE
                #{
                CUST.DATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
                PRINT(CUST.DATA.respXMLMsg)
                CUST.DATA.errorMsgFlg = ""
                CUST.DATA.errorMsgDesc = ""
                
				CUST.DATA.tranDate = ""
	CUST.DATA.tranId = ""
	CUST.DATA.errorCode = ""
	CUST.DATA.errorDesc = ""
	sv_x = CUST.DATA.respXMLMsg
	
	#--------------------------------------------------------------------------------------------------------
	# Fetching the status of the request
	#--------------------------------------------------------------------------------------------------------
	sv_y = "<Status>"
	sv_z = "</Status>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.DATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
	ELSE
		#{
		CUST.DATA.tranStatus = ""
	#}
	ENDIF
	PRINT(CUST.DATA.tranStatus)
	#--------------------------------------------------------------------------------------------------------
	# If Success fetching tran id else fetching error code and description
	#--------------------------------------------------------------------------------------------------------
	IF(CUST.DATA.tranStatus == "SUCCESS") THEN
	#{
		CUST.DATA.errorMsgFlg = "N"
		sv_x = CUST.DATA.respXMLMsg
		sv_y = "<RevTrnId>"
		sv_z = "</RevTrnId>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.DATA.tranId = MID$(sv_x, sv_b, (sv_e - sv_b))
			print(CUST.DATA.tranId)
		#}
		ENDIF
		
		
		
		IF(CUST.DATA.tranId == "") THEN
		#{
			CUST.DATA.errorMsgFlg = "Y"
			CUST.DATA.errorCode = "SYSERR"
			CUST.DATA.errorDesc = "Could not get response from server"
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.DATA.errorMsgFlg = "Y"
		IF(CUST.DATA.tranStatus == "FAILED") THEN
		#{
			sv_x = CUST.DATA.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.DATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
			#}
			ENDIF
			sv_x = CUST.DATA.respXMLMsg
			sv_y = "<ErrorDesc>"
			sv_z = "</ErrorDesc>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.DATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
			#}
			ENDIF
		#}
		ENDIF
		IF((CUST.DATA.errorCode == "") AND (CUST.DATA.errorDesc == "")) THEN
		#{
			CUST.DATA.errorCode = "SYSERR"
			CUST.DATA.errorDesc = "Could not get response from server"
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.DATA.errorMsgFlg)
	PRINT(CUST.DATA.tranId)
	PRINT(CUST.DATA.tranDate)
	PRINT(CUST.DATA.errorCode)
	PRINT(CUST.DATA.errorDesc)
        #}
        ENDIF



	CUST.GCHRG.tranType = "T"
	CUST.GCHRG.tranSubType= "BI"
	CUST.GCHRG.drAcctId = VERL.GLBDATA.chrgforacid
	CUST.GCHRG.acctCrncyCode = "UGX"
	CUST.GCHRG.eventId = "LODGECH"
	CUST.GCHRG.chrgAmt = "5000" 
	
call("addlienVer.scr")
        ENDOFSCRIPT:
                EXITSCRIPT

	
	TRACE OFF
END-->
