					sv_l = strlen(VERL.GLBDATA.tran_amt)
					sv_f = mid$(VERL.GLBDATA.tran_amt,0,sv_l)
					sv_l = strlen(VERL.GLBDATA.tran_amt)
					sv_p = getposition(sv_f,"|")
					VERL.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
					VERL.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
					print(VERL.GLBDATA.trans_amt)
					print(VERL.GLBDATA.trans_crncy)
					print(VERL.GLBDATA.tran_amt)
			if(VERL.GLBDATA.partTranType=="D")then
			#{
				print(VERL.GLBDATA.trans_amt)
				print(VERL.GLBDATA.drEffAvailableAmt)
				VERL.GLBDATA.totalDrAmt = cdouble(VERL.GLBDATA.trans_amt) + cdouble(VERL.GLBDATA.totalDrAmt)
				print(VERL.GLBDATA.totalDrAmt)
			#}
			endif
			#Inhouse
			if((VERL.GLBDATA.cracctOwnerShip!="O") and (VERL.GLBDATA.partTranType=="C") and (cdouble(VERL.GLBDATA.ExecCnt)>=1))then
			#{
				print("inhouse")
				VERL.GLBDATA.isInOutI = "IN"
				#VERL.GLBDATA.isCrAcctId = VERL.GLBDATA.foracid
				
			#}
			endif	
			#Outward
			if((VERL.GLBDATA.cracctOwnerShip=="O") and (VERL.GLBDATA.partTranType=="C") and (VERL.GLBDATA.schmCode!="INCOM") and (cdouble(VERL.GLBDATA.ExecCnt)>=1))then
			#{
				print("Outward")
				VERL.GLBDATA.isInOutO = "OUT"
			#}
			endif
			if((cdouble(VERL.GLBDATA.ChrgCnt)>=1) and (VERL.GLBDATA.partTranType=="D"))then
			#{
				print(VERL.GLBDATA.trans_amt)
				print(VERL.GLBDATA.drEffAvailableAmt)
				print(VERL.GLBDATA.drAvailableAmt)
				if(cdouble(VERL.GLBDATA.trans_amt) >cdouble (VERL.GLBDATA.drAvailableAmt))then
				#{
					VERL.GLBDATA.isChrgOverDraw = "Y"
				else
					VERL.GLBDATA.isChrgOverDraw = "N"
				#}
				endif
				VERL.GLBDATA.chrgAmt = 1*cdouble(VERL.GLBDATA.trans_amt)
			#}
			endif
			if((cdouble(VERL.GLBDATA.ExecCnt)>=1) and (VERL.GLBDATA.partTranType=="C"))then
			#{
				print(VERL.GLBDATA.trans_amt)
				print(VERL.GLBDATA.drEffAvailableAmt)
				print(VERL.GLBDATA.drAvailableAmt)
				if(cdouble(VERL.GLBDATA.trans_amt)>cdouble(VERL.GLBDATA.drAvailableAmt))then
				#{
					VERL.GLBDATA.isTranOverDraw = "Y"
				else
					VERL.GLBDATA.isTranOverDraw = "N"
				#}
				endif
				VERL.GLBDATA.maintranAmt = 1*cdouble(VERL.GLBDATA.trans_amt)
			#}
			endif
			if((VERL.GLBDATA.isInOutI!="") and (VERL.GLBDATA.isInOutO!=""))then
				VERL.GLBDATA.isInOut = VERL.GLBDATA.isInOutI + "-" + VERL.GLBDATA.isInOutO
				print(VERL.GLBDATA.isInOut)
			else
				if(VERL.GLBDATA.isInOutI!="")then
					VERL.GLBDATA.isInOut = VERL.GLBDATA.isInOutI
				endif
				if(VERL.GLBDATA.isInOutO!="")then
					VERL.GLBDATA.isInOut = VERL.GLBDATA.isInOutO
				endif
				if(VERL.GLBDATA.isInOutO!="")then
					VERL.GLBDATA.isInOut = VERL.GLBDATA.isInOutSP
				endif
				
				print(VERL.GLBDATA.isInOut)
				
			endif
			
			sv_j = CINT(sv_j) + 1
			sv_j = FORMAT$(sv_j,"%d")
		#}
		DO
	#}
	endif
	
	
	
	#Check if the tran is SI Setup, Si execution or DD transfer.
	
	IF((VERL.GLBDATA.SISUChrgCnt !="") and (VERL.GLBDATA.SISUChrgCnt > 0))THEN
	#{
		VERL.GLBDATA.isInOut = "SISU"
		print(VERL.GLBDATA.isInOut)
