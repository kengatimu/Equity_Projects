					#{
							sv_u = "ChrgCnt | select regexp_count(?SVAR, 'SI Execution Charge')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'si execution charge')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'SI EXECUTION CHARGE')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'SI Execution Charges')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'si execution charges')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'SI EXECUTION CHARGES')from dual "
							BANCS.INPARAM.BINDVARS = VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars
							print(BANCS.INPARAM.BINDVARS)
							print(sv_u)
							sv_d = urhk_dbSelectWithBind(sv_u)
