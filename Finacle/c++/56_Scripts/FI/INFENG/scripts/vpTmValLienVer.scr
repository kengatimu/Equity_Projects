					#{
						VERL.GLBDATA.isCrAcctId = VERL.GLBDATA.foracid
						VERL.GLBDATA.isInOutSP = "SISU"
					#}
					ENDIF
					
					#Capture the Income account for DD setup
					print(VERL.GLBDATA.tranParticulars)
					VERL.GLBDATA.DDExecTrans = left$(VERL.GLBDATA.tranParticulars,12)
					print(VERL.GLBDATA.DDExecTrans)
					IF(VERL.GLBDATA.DDExecTrans=="DD EXECUTION")THEN
					#{
						VERL.GLBDATA.isCrAcctId = VERL.GLBDATA.foracid
						VERL.GLBDATA.isInOutSP = "DDEX"
					#}
					ENDIF
					
					
				#}
				ENDIF
				
				
				
			#}
			endif
			
			
							
					# Check for SI Setup Transaction
					if((VERL.GLBDATA.tranParticulars!="") and (VERL.GLBDATA.partTranType=="D"))then
					#{
							sv_u = "SISUchrgCnt| select regexp_count(?SVAR, 'SI Setup Charge')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'SI SETUP CHARGE') from dual "
							BANCS.INPARAM.BINDVARS = VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars 
							print(BANCS.INPARAM.BINDVARS)
							print(sv_u)
							sv_d = urhk_dbSelectWithBind(sv_u)
							if(sv_d==0)then
							#{
									VERL.GLBDATA.SISUChrgCnt = BANCS.OUTPARAM.SISUchrgCnt
							#}
							else
							#{
									VERL.GLBDATA.SISUChrgCnt = 0
							#}
							endif
							print(VERL.GLBDATA.SISUChrgCnt)
					#}
					endif
					
					# Check for Demand Draft Execution Transaction
					if((VERL.GLBDATA.tranParticulars!="") and (VERL.GLBDATA.partTranType=="D"))then
					#{
							sv_u = "DDExeccount| select regexp_count(?SVAR, 'DD EXECUTION')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'dd execution')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'DD execution')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'dd EXECUTION') from dual "
							BANCS.INPARAM.BINDVARS = VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars  + "|" + VERL.GLBDATA.tranParticulars  + "|" + VERL.GLBDATA.tranParticulars 
							print(BANCS.INPARAM.BINDVARS)
							print(sv_u)
							sv_d = urhk_dbSelectWithBind(sv_u)
							if(sv_d==0)then
							#{
									VERL.GLBDATA.DDExec = BANCS.OUTPARAM.DDExeccount
							#}
							else
							#{
									VERL.GLBDATA.DDExec = 0
							#}
