					IF((VERL.GLBDATA.tranId !="") and (VERL.GLBDATA.chrgdrAvailableAmt<=0) and (VERL.GLBDATA.chrgacctOwnerShip !="O"))then
					#call("revEFTUnpaidTran.scr")
					VERL.GLBDATA.collectChrg ="Y"
					endif
				endif
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
				VERL.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
				print(VERL.GLBDATA.tran_amt)
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
				VERL.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
				print(VERL.GLBDATA.partTranType)
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
				VERL.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
				print(VERL.GLBDATA.tran_rmks)
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
				VERL.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
				print(VERL.GLBDATA.tranParticulars)
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
				VERL.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
				print(VERL.GLBDATA.tranParticulars2)
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg")
				VERL.GLBDATA.recDelYN=BANCS.OUTPARAM.srvValue
				print(VERL.GLBDATA.recDelYN)
			if((VERL.GLBDATA.foracid!="") and (VERL.GLBDATA.partTranType=="D"))then
			#{
				VERL.GLBDATA.isDrAcctId = VERL.GLBDATA.foracid
				sv_u = urhk_getAcctDetailsInRepository(VERL.GLBDATA.foracid)
				if(sv_u==0)then
				#{
					VERL.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
					VERL.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
					print(BANCS.OUTPARAM.schmCode)
					VERL.GLBDATA.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
					print(VERL.GLBDATA.acctOwnerShip)
					VERL.GLBDATA.drEffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
					print(VERL.GLBDATA.drEffAvailableAmt)
					VERL.GLBDATA.drAvailableAmt = BANCS.OUTPARAM.AvailableAmt 
					print(VERL.GLBDATA.drAvailableAmt)
				#}
				endif
			#}
			endif
			if((VERL.GLBDATA.foracid!="") and (VERL.GLBDATA.partTranType=="C"))then
			#{
				#VERL.GLBDATA.isCrAcctId = VERL.GLBDATA.foracid
				sv_u = urhk_getAcctDetailsInRepository(VERL.GLBDATA.foracid)
				if(sv_u==0)then
				#{
					VERL.GLBDATA.laSolId = BANCS.OUTPARAM.acctSolId
					VERL.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
					print(VERL.GLBDATA.schmCode)
					VERL.GLBDATA.cracctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
					print(VERL.GLBDATA.cracctOwnerShip)
					VERL.GLBDATA.crEffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
					print(VERL.GLBDATA.crEffAvailableAmt)
					VERL.GLBDATA.crAvailableAmt = BANCS.OUTPARAM.AvailableAmt 
