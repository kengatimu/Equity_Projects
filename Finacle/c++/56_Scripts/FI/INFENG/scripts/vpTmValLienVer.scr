		sv_j = FORMAT$(sv_j,"%d")
		while(sv_j < sv_i)
		#{
			print("sv_i")
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
				VERL.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
				print(VERL.GLBDATA.foracid)
				if(sv_j =="0")then
				print(VERL.GLBDATA.foracid)
				VERL.GLBDATA.chrgforacid = VERL.GLBDATA.foracid
				print(VERL.GLBDATA.tranId)
				
				sv_u = urhk_getAcctDetailsInRepository(VERL.GLBDATA.chrgforacid)
				if(sv_u==0)then
				#{
					
					VERL.GLBDATA.chrgacctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
					print(VERL.GLBDATA.chrgacctOwnerShip)
					VERL.GLBDATA.chrgdrEffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
