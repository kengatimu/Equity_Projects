				#}
				endif
				if(VERL.GLBDATA.schmCode!="INCOM")then
				#{
					VERL.GLBDATA.isCrAcctId = VERL.GLBDATA.foracid
				#}
				else
				#{
					#Capture the Income account for SI setup
					print(VERL.GLBDATA.tranParticulars)
					VERL.GLBDATA.SISETUPTrans = left$(VERL.GLBDATA.tranParticulars,15)
					print(VERL.GLBDATA.SISETUPTrans)				
