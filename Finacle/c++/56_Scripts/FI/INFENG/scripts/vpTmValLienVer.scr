	endif
	print(VERL.GLBDATA.chrgAmt)
	print(VERL.GLBDATA.maintranAmt)
	print(VERL.GLBDATA.totalDrAmt)
	print(VERL.GLBDATA.drEffAvailableAmt)
	print(VERL.GLBDATA.drAvailableAmt)
	print(VERL.GLBDATA.clearBal)
	#if(cdouble(VERL.GLBDATA.clearBal)>=0)then
	if(cdouble(VERL.GLBDATA.clearBal)>0)then
	#{
		VERL.GLBDATA.istotalVerDraw = "N"
		VERL.GLBDATA.isChrgOverDraw = "N"
		VERL.GLBDATA.isTranOverDraw = "N"
	#}
	endif
	if(cdouble(VERL.GLBDATA.clearBal)<=0)then
	#{
		VERL.GLBDATA.clearBal = -1 * cdouble(VERL.GLBDATA.clearBal)
		print(VERL.GLBDATA.clearBal)
		if(cdouble(VERL.GLBDATA.clearBal)==cdouble(VERL.GLBDATA.chrgAmt))then
		#{
			VERL.GLBDATA.istotalVerDraw = "N"
			VERL.GLBDATA.isChrgOverDraw = "Y"
			VERL.GLBDATA.isTranOverDraw = "N"
		#}
		endif
		if(cdouble(VERL.GLBDATA.clearBal)==cdouble(VERL.GLBDATA.maintranAmt))then
		#{
			VERL.GLBDATA.istotalVerDraw = "N"
			VERL.GLBDATA.isChrgOverDraw = "N"
			VERL.GLBDATA.isTranOverDraw = "Y"
		#}
		endif
		if(cdouble(VERL.GLBDATA.clearBal)==cdouble(VERL.GLBDATA.totalDrAmt))then
		#{
			VERL.GLBDATA.istotalVerDraw = "Y"
			VERL.GLBDATA.isChrgOverDraw = "Y"
			VERL.GLBDATA.isTranOverDraw = "Y"
		#}
		endif
		if(cdouble(VERL.GLBDATA.clearBal)>cdouble(VERL.GLBDATA.maintranAmt))then
		#{
			VERL.GLBDATA.istotalVerDraw = "Y"
			VERL.GLBDATA.isChrgOverDraw = "Y"
			VERL.GLBDATA.isTranOverDraw = "Y"
		#}
		endif
		if(cdouble(VERL.GLBDATA.clearBal)>cdouble(VERL.GLBDATA.chrgAmt))then
		#{
			VERL.GLBDATA.istotalVerDraw = "Y"
			VERL.GLBDATA.isChrgOverDraw = "Y"
			VERL.GLBDATA.isTranOverDraw = "Y"
		#}
		endif
	#}
	endif
	if(cdouble(VERL.GLBDATA.totalDrAmt)>cdouble(VERL.GLBDATA.drEffAvailableAmt))then
	#{
		VERL.GLBDATA.istotalVerDraw = "Y"
	else
		VERL.GLBDATA.istotalVerDraw = "N"
	#}
	endif
	print(VERL.GLBDATA.isDrAcctId)
	print(VERL.GLBDATA.isCrAcctId)
	print(VERL.GLBDATA.isTranOverDraw)
	print(VERL.GLBDATA.isChrgOverDraw)
	print(VERL.GLBDATA.isInOut)
	print(VERL.GLBDATA.istotalVerDraw)
	
	
	IF(VERL.GLBDATA.isTranOverDraw == "Y")THEN
	#{
	
		IF(VERL.GLBDATA.SISUChrgCnt > 0)THEN
		#{
			VERL.GLBDATA.errMsg = "Insufficient funds for SI setup"
			VERL.GLBDATA.errCod = "SISU"
			
		#}
		ENDIF
		
		IF(VERL.GLBDATA.ExecCnt > 0)THEN
		#{
			VERL.GLBDATA.errMsg = "Insufficient balance for SI Execution"
			VERL.GLBDATA.lienRemarks = "Failed Standing Instruction Execution charge"
			VERL.GLBDATA.errCod = "SIE"
		#}
		ENDIF
		IF(VERL.GLBDATA.DDExec > 0)THEN
		#{
			VERL.GLBDATA.errMsg = "Insufficient balance for DD Execution"
			VERL.GLBDATA.lienRemarks = "Failed Demand Draft Execution charge"
			VERL.GLBDATA.errCod = "DDE"
		#}
		ENDIF
		
		IF((VERL.GLBDATA.errMsg != "") and (VERL.GLBDATA.errCod!="") and (VERL.GLBDATA.errCod!="SISU"))THEN
		#{
			
			IF((VERL.GLBDATA.clearBalOrg) >= 5000)THEN
			#{
				
				CUST.GCHRG.drAcctId= VERL.GLBDATA.isDrAcctId
				CUST.GCHRG.chrgAmt = "5000" + "|" + BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.acctCrncyCode = "UGX"
				CUST.GCHRG.eventId = "SIDDFE"
				#CUST.GCHRG.eventId = COLL.GLBDATA.minevent
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "BI"
				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
					VERL.GLBDATA.isChrgCol = "C"
				#}
				ELSE
				#{
					PRINT("Failure")
					VERL.GLBDATA.isChrgCol = "F"
				#}
				ENDIF	
			#}
			else
			#{
				print("Lien account")
				call("SRV_VerAddlLien.scr")
				IF(FIELDEXISTS(CUSS.VERVAL.SuccessOrFailure))then
				#{
					print(CUSS.VERVAL.SuccessOrFailure)
					IF(CUSS.VERVAL.SuccessOrFailure =="S")THEN
					#{
						VERL.GLBDATA.isChrgCol = "L"
					#}
					ELSE 
					#{
						VERL.GLBDATA.isChrgCol = "F"
					#}
					ENDIF
					
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF

		sv_u = urhk_GetChannelInfo("")
		if(sv_u==0)then
				BANCS.INPUT.dccIdd = BANCS.OUTPARAM.DccId
				BANCS.INPUT.DccReqRefNum = BANCS.OUTPARAM.DccReqRefNum
		else
				BANCS.INPUT.dccIdd = ""
				BANCS.INPUT.DccReqRefNum = ""
		endif
		
		
		
		lv_j = " Insert into custom.cust_ver_sidd_tbl (bank_id,dcc_id,dcc_req_num,module_type,dr_acct_id,cr_acct_id,tran_type_inout,is_tran_overdraw,is_charge_overdraw,is_total_overdraw,total_dr_amt,tra_amt,charge_amt,is_charge_lien_yn,rcre_user_id,rcre_time,lchg_user_id,lchg_time,entity_cre_flg,del_flg,free_text_1,free_text_2,free_text_3,free_text_4,free_text_5,tran_id,tran_date) values (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?NVAR,?NVAR,?NVAR,?SVAR,?SVAR,sysdate,?SVAR,sysdate,'Y','N',null,null,null,null,null,?SVAR,to_date(?SVAR,'DD-MM-YYYY')) "
		print(lv_j)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.dccIdd + "|" + BANCS.INPUT.DccReqRefNum + "|" + VERL.GLBDATA.isInOut + "|" + VERL.GLBDATA.isDrAcctId + "|" + VERL.GLBDATA.isCrAcctId + "|" + VERL.GLBDATA.isInOut + "|" + VERL.GLBDATA.isTranOverDraw + "|" + VERL.GLBDATA.isChrgOverDraw + "|" + VERL.GLBDATA.istotalVerDraw + "|" + VERL.GLBDATA.totalDrAmt + "|" +  VERL.GLBDATA.maintranAmt + "|" + VERL.GLBDATA.chrgAmt + "|" + VERL.GLBDATA.isChrgOverDraw + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + VERL.GLBDATA.tranId + "|" + left$(VERL.GLBDATA.tranDate,10) 
		print(lv_j)
		print(BANCS.INPARAM.BINDVARS)
		lv_j = urhk_dbSqlWithBind(lv_j)
		if(lv_j==0)then
			lv_j = urhk_dbSqlWithBind("commit")
		endif
	#}	
	ENDIF


	
IF (VERL.GLBDATA.errMsg != "") THEN
#{
	sv_u = urhk_SRV_SetErr(VERL.GLBDATA.errMsg)
	PRINT(sv_u)
#}
ENDIF	
	
VAYU:	
	#if(classexists("VERL","GLBDATA")==1) then
	#	deleteclass("VERL","GLBDATA")
	#endif
	#if(repexists("VERL")==1) then
	#	deleterep("VERL")
	#endif
	#
	#if(classexists("CUST","GCHRG")==1) then
	#	deleteclass("CUST","GCHRG")
	#endif
	#if(repexists("CUST")==1) then
	#	deleterep("CUST")
	#endif
	
	exitscript
trace off
end-->
