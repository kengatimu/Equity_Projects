					#Check for Main transaction
					
					if((VERL.GLBDATA.tranParticulars!="")and(VERL.GLBDATA.partTranType=="C"))then
					#{
							sv_u = "ExecCnt | select regexp_count(?SVAR, 'si IFO')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'si ifo')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'SI IFO')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'SI IFO')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'si IFo')+ "
							sv_u = sv_u + " regexp_count(?SVAR, 'SI ifO')from dual "
							BANCS.INPARAM.BINDVARS = VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars + "|" + VERL.GLBDATA.tranParticulars
							print(BANCS.INPARAM.BINDVARS)
							print(sv_u)
							sv_d = urhk_dbSelectWithBind(sv_u)
							if(sv_d==0)then
							#{
								IF(VERL.GLBDATA.ExecCnt != 0)then
								#{
									print("Main tran already exist")
								#}
								ELSE
								#{
									VERL.GLBDATA.ExecCnt = BANCS.OUTPARAM.ExecCnt
								#}
								endif	
								
								
							#}
							endif
							print(VERL.GLBDATA.ExecCnt)
