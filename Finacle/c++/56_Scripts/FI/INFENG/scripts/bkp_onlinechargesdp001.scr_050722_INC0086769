					IF (sv_u  == 0) THEN
					CASH.WITH.tran_amt = BANCS.OUTPARAM.OutputAmount
					CASH.WITH.tran_amt = cint(CASH.WITH.tran_amt)
        				ENDIF
					print(CASH.WITH.tran_amt)
