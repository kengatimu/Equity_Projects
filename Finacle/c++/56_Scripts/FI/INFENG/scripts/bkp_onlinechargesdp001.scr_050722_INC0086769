COLL.GLBDATA.tranDate = LEFT$(COLL.GLBDATA.tranDate,10)
PRINT(COLL.GLBDATA.tranDate)
IF (FIELDEXISTS(CASH.WITH.type) AND FIELDEXISTS(CASH.WITH.stype)) THEN
#{		
	PRINT(CASH.WITH.type)
	PRINT(CASH.WITH.stype)
	PRINT(BANCS.STDIN.mySolId)
	PRINT(CUST.CPARAM.mySolId1)

	IF (BANCS.STDIN.contextBankId == "56") THEN
		#{
			IF ((CASH.WITH.type == "T") AND (CASH.WITH.stype == "CI") AND (BANCS.STDIN.mySolId != CUST.CPARAM.mySolId1)) THEN
			#{
				sv_s = "owner,schmtype|"
				sv_s = sv_s + " SELECT GAM.acct_ownership,GAM.schm_type"
				sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
				sv_s = sv_s + " WHERE GAM.acid = DTD.acid"
				sv_s = sv_s + " AND DTD.tran_id = LPAD(?SVAR,9)"
				sv_s = sv_s + " AND DTD.part_tran_type='C'"
				sv_s = sv_s + " AND DTD.del_flg != 'Y'"
				sv_s = sv_s + " AND GAM.bank_id = DTD.bank_id"
				#sv_s = sv_s + " AND part_tran_srl_num = LPAD(?SVAR,4) "
				sv_s = sv_s + " AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
				sv_s = sv_s + " AND rownum < 2"
				print(sv_s)
				#BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.parttrnNum + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
				BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d=urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d != 0) THEN
				#{
					CUST.TMCHRG.errMMsg = "Error in selecting records"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CASH.WITH.nocharge = BANCS.OUTPARAM.owner
					CASH.WITH.stype = BANCS.OUTPARAM.schmtype
					print(CASH.WITH.nocharge)
					print(CASH.WITH.stype)
				#}
				ENDIF
				
				IF ((CASH.WITH.Trf_Flg == "Y") AND ((CASH.WITH.stype == "CAA") OR (CASH.WITH.stype == "SBA")))THEN
				#{
					#CASH.WITH.tfee = "55"
					#Changes done as per porting3
					CASH.WITH.tfee = "1000"
					print(CASH.WITH.tfee)
				

					IF (CASH.WITH.schmCode == "CA217") then
						CASH.WITH.tfee = "2600"
						print(CASH.WITH.tfee)
					ENDIF	
					CASH.WITH.negat ="-1"
					CASH.WITH.Tot_Amt = cdouble(CASH.WITH.tfee)* cdouble(CASH.WITH.negat)
					CASH.WITH.with_amt = CASH.WITH.tfee
					print (CASH.WITH.Tot_Amt)
					print (CASH.WITH.with_amt)
					#CALL("trfchargedp001.scr")
					
					CUST.GCHRG.tranType = "T"
					CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(COLL.GLBDATA.trfevent)
					#CUST.GCHRG.eventId = "TMTRF1"
					CUST.GCHRG.eventId = COLL.GLBDATA.trfevent
					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
						#}
					ELSE
						#{
						PRINT("Failure")
					#}
					ENDIF
					#}
				ELSE
					#{
					CASH.WITH.Tot_Amt = "0"
				#}
				ENDIF
				#}
			ELSE
				#{
				CASH.WITH.Tot_Amt = "0"
			#}
			ENDIF
		#}
		ENDIF

	IF ((CASH.WITH.type == "C") AND (CASH.WITH.stype == "NP")) THEN

		sv_s = "schmcode|"
		sv_s = sv_s + " SELECT GAM.schm_code "
		sv_s = sv_s + " FROM TBAADM.GAM WHERE BANK_ID =?SVAR AND FORACID =?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CASH.WITH.Ac_Number
		PRINT(BANCS.INPARAM.BINDVARS)
				sv_d=urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d != 0) THEN
				#{
					CUST.TMCHRG.errMMsg = "Error in selecting records"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CASH.WITH.schmCode = BANCS.OUTPARAM.schmcode
					print(CASH.WITH.schmCode)
					
				#}
				ENDIF
	#{
		IF (CASH.WITH.Int_Flg == "Y") THEN
		
		#{
			sv_s = "fxdcrncycode,ratecode,Rate|SELECT fxd_crncy_code,ratecode,var_crncy_units "
			sv_s = sv_s + "FROM TBAADM.RTL "
			sv_s = sv_s + "WHERE fxd_crncy_code = ?SVAR " 
			sv_s = sv_s + "AND var_crncy_code = ?SVAR "
			sv_s = sv_s + "AND ratecode = ?SVAR "
			sv_s = sv_s + "AND fxd_crncy_code != ?SVAR "
			sv_s = sv_s + "AND bank_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CASH.WITH.CrncyCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + CASH.WITH.refCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN 
			#{
		        	CASH.WITH.fxdcrncycode = BANCS.OUTPARAM.fxdcrncycode
				PRINT(CASH.WITH.fxdcrncycode)

				CASH.WITH.ratecode = BANCS.OUTPARAM.ratecode 
				PRINT(CASH.WITH.ratecode)
        
				CASH.WITH.Rate = BANCS.OUTPARAM.Rate 
				PRINT(CASH.WITH.Rate)
			#}
			ELSE
			#{
				CASH.WITH.Rate = "1"
			#}
			ENDIF
			
			sv_p = CASH.WITH.tran_amt 
			BANCS.INPARAM.InputAmount = sv_p 
			BANCS.INPARAM.CurrencyCode = CASH.WITH.CrncyCode
			IF (CASH.WITH.CrncyCode == BANCS.STDIN.homeCrncyCode) THEN
			#{
				BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode1
			#}
			ELSE
			#{
