	print(CASH.WITH.Shd_Flg)
	IF (CASH.WITH.Shd_Flg == "Y") THEN
	#{	
		CASH.WITH.percnt = "100"
		CASH.WITH.percnt = CDOUBLE(CASH.WITH.percnt)
		CASH.WITH.Shd_Amt = (cdouble(CASH.WITH.Shd_Amt) * cdouble("3.5"))  / cdouble(CASH.WITH.percnt)
		print(CASH.WITH.Shd_Amt)
	
		IF (cdouble(CASH.WITH.Shd_Amt) < cdouble(CASH.WITH.amt8)) THEN
		#{
