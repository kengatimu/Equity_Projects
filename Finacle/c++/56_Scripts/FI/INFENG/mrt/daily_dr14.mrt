ONSTARTOFREPORT
##################################################################
print bankName COLUMN 20
nextline
print branchName COLUMN 20
nextline
print "P.O BOX 75104 NAIROBI 00200" COLUMN 20
nextline
print "CLIENT DIRECTION REPORT" COLUMN 20 
separatorline
print "CUST ID" COLUMN 1 SIZE 9
print "ACC ID" COLUMN 11 SIZE 16
print "ACCOUNT NO" COLUMN 28 SIZE 20 
print "COMM ADDRESS"  COLUMN 49 SIZE 15
