print "ACC ID" COLUMN 11 SIZE 16
print "ACCOUNT NO" COLUMN 28 SIZE 20
print "COMM ADDRESS"  COLUMN 49 SIZE 15
print "PERM ADDRESS" COLUMN 65 SIZE 15
