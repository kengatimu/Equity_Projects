# Template Name :		Inter.mrt
# Description	:		unposted Inter-country transactions
# Author			E.G.KAROBIA,17-jul-2009
# 
#########################################################################
RECORDLAYOUT
INIT_SOL_ID	stringType
tran_id		stringType
tran_date	stringType
tran_amt	stringType
BenAccnt	stringType
BenName		stringType
BenCountry	stringType
ENTRY_USER_ID	stringType
PSTD_USER_ID	stringType
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 90
columnsperline 120
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 100 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
	print INIT_SOL_ID column 3	
	print tran_id column 11	
	print tran_date	column 18	
	print tran_amt	column 30	
	print BenAccnt	column 43		
	print BenName column 58		
	print BenCountry column 81	
	print ENTRY_USER_ID column 90	
	print PSTD_USER_ID column 100	

end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	print "Branch" column 2	
	print "Tran_id" column 10	
	print "Tran_date"	column 18	
	print "Tran_amt"	column 30	
	print "Benificiary"	column 43		
	print "Benificiary" column 59		
	print "Benificiary" column 79	
	print "Entry" column 91
	print "Posted" column 100
	nextline
	print "Code" column 3	
	print "Account"	column 45		
	print "Name" column 62		
	print "Country" column 80	
	print "User_id" column 91	
	print "User_id" column 100

	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 100 center 
	nextline
	print branchName  size 100 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 100 center
	nextline
	print " UP-POSTED INTER-COUNTRY TRANSCATIONS "  size 100 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 100 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end



