#********************************************************************************
#    Report Name                        :       daily_dr03.mrt                  *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    Sr.no.  Date        Author                 Description                     *
#    ------  --------    -----------------      ----------------                *
#    1.0     28-10-2005  Eric Karobia           Original Version                *
#                                                                               *
#################################################################################
RECORDLAYOUT  

tran_id stringtype
schm_code stringType
foracid stringtype
acct_name stringType
instr_num stringtype
tran_amt numberType
luser_id stringtype
value_date stringType
tran_part stringType
fx_tran_amt numberType
vuser_id stringType
part_trntype stringType


#################################################################################
LOCALVARIABLES
record_counter          numberType

page_number     numberType
lv_setid	stringType  
callscript      stringType
lv_setdesc	stringType
lv_userId	stringType
drtran_amt      numberType
crtran_amt      numberType
tdrtran_amt      numberType
tcrtran_amt      numberType
ttrancrdt	numberType
ttrandrdt 	numberType
gtrancrdt       numberType
gtrandrdt       numberType

#################################################################################
GROUPANDSORT
value_date,tran_id

#################################################################################
PAGEFORMAT

widowOrphanLines 2
LinesPerPage 	65 
LeftMargin 	2 
rightMargin 	2	
columnsPerLine 	165
pageHeaderLines	13
pageFooterLines 1 
ignoreblankrecord

#################################################################################
REPOSITORY  bankRepos.rip

bankName       StringType
branchName     StringType

#################################################################################  
REPOSITORY argv4  

ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType

#################################################################################
ONSTARTOFREPORT
set page_number  = 1
set record_counter=0
set ttrancrdt = 0
set ttrandrdt = 0
set gtrandrdt = 0
set gtrancrdt = 0
execute header
execute pageHdg 


################################################################################# 
PAGEHEADER 
execute header
execute pageHdg

################################################################################# 
BEFOREBREAKOF tran_id
set drtran_amt = 0
set crtran_amt = 0

#################################################################################
AFTERBREAKOF tran_id
 print "" size 64 fillAscii 45  column 10
 print "" size 55 fillAscii 45  column 86
 nextline
 print "Subtotal" column 10
 print drtran_amt  size 20 autocomma precision 2 column 57
 print "Subtotal" column 86
 print crtran_amt size 20 autocomma precision 2 column 123
 nextline
 print "" size 64 fillAscii 45  column 10
 print "" size 55 fillAscii 45  column 86
 set tdrtran_amt = tdrtran_amt + drtran_amt 
 set tcrtran_amt = tcrtran_amt + crtran_amt
 nextline
################################################################################ 
ONEVERYRECORD 
print tran_id column 2 
if part_trntype = "D" 
 begin
    print schm_code column 10
  print foracid column 16
  print acct_name column 30
  print instr_num column 68
  print tran_amt size 20 autocomma precision 2  column 57
  set drtran_amt =  drtran_amt+tran_amt 
  nextline
  print luser_id column 10
  print value_date column 16
  print tran_part column 30
  print fx_tran_amt column 70
end
  if part_trntype = "C"
 begin
  print schm_code column 86
  print foracid column 92
  print acct_name column 106
  print tran_amt size 20 autocomma precision 2 column 123
  set crtran_amt =  crtran_amt+tran_amt
  nextline
  print luser_id column 86
  print value_date column 92
  print tran_part column 106
  print fx_tran_amt column 136
end
print vuser_id column 150

################################################################################# 
ONENDOFREPORT
 separatorline
 print "Grand total"
 print tdrtran_amt size 20 autocomma precision 2  column 57
 print tcrtran_amt size 20 autocomma precision 2 column 123
separatorline

begin

                if ( totalCount foracid = 0 )
        begin
                nextline
                nextline
                nextline
                separatorline
                print " NO RECORD SELECTED FOR THE GIVEN CRITERIA " size 165 center
                separatorline
        end
		else

	begin
                nextline
                nextline
		nextline
		nextline
		nextline
		print "       Printed By:  " column 20
		print lv_userId
		print "                          Verified By: " 
                nextline
		print today  column 20  
	end
end

################################################################################# 
PROCEDURE header

begin
        print "Page No. "   column 140
        print page_number precision 0
        nextline
        print today column 140 
        nextline
        nextline
	print "    EQUITY BANK LIMITED" size 165 center
	nextline
	set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 165 center
        nextline
end

################################################################################# 
PROCEDURE pageHdg

begin
       	print "   Transfer Transaction Register   " size 165 center
	nextline
	print "Report For Date: " column 75
	print ipFrmDate
	nextline
	print "For Operator:  " column 75
	print ipToDate
        nextline
        print "==========================================" size 165 center
        nextline
	nextline
	nextline
	print "DEBIT "   column 30
	print "CREDIT"  column  106

	separatorline
	print "Tran_id"		column 2
	print "Schm_code"       column 10
	print "A/C No."		column 16
	print "A/c Name."	column 30
	print "Chq #."  	column 68
        print "Amount"        column 70

	print "Schm_code"       column 86
	print "A/C No."         column 92
        print "A/c Name."       column 106
	print "Amount"        column 136
        nextline
        print "Operator"  column 10
        print "V/Date"    column 16
        print "Description" column 30
        print "F/Amount" column 70

        print "Operator"  column 86
        print "V/Date"    column 92
        print "Description" column 106
        print "F/Amount"  column 136
	print "Supervisor" column 150
	separatorline
	set page_number= page_number+1

end	
#################################--END--################################################

