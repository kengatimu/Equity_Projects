#***************************************************************************************
#***************************************************************************************

#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
sol_id			stringType
sol_desc 		stringType
region			stringType
tot_assets		numberType
tot_adv			numberType
tot_dep 		numberType
tot_pro 		numberType
bad			numberType
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
DESCRIPTION      	stringType
AMOUNT			numberType
tot_amount		numberType
flag			numberType
grand_tot_ass		numberType
grand_tot_adv		numberType
grand_tot_dep		numberType 
grand_tot_pro		numberType
tot_bad			numberType
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId 		stringtype
asondate	stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg 
set tot_amount  = 0 
set flag = 0
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   55 
columnsperline 212
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13 
pagefooterlines 4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
execute header
execute pageHdg 
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#execute Line 
#**************************************************************************************
IGNORERECORD 
#**************************************************************************************
ONEVERYRECORD
#***************************************************************************************
begin
execute pipe
set grand_tot_ass = grand_tot_ass + tot_assets 
set grand_tot_adv = grand_tot_adv + tot_adv
set grand_tot_dep = grand_tot_dep + tot_dep
set grand_tot_pro = grand_tot_pro + tot_pro
set tot_bad  = tot_bad + bad
print sol_desc column 3 size 30
print region column 36 size 17
print region column 56 size 20
if (flag =1)
print "BRANCH" column 80 size 15
print tot_assets column 103 size 19 autocomma precision 2
print tot_adv column 125 size 19 autocomma precision 2
print tot_dep column 146 size 19 autocomma precision 2
print tot_pro column 167 size 19 autocomma precision 2
print bad column 192  size 19 autocomma precision 2
set flag = 1
end
#**************************************************************************************
ONENDOFREPORT
#**************************************************************************************
begin
separatorline
execute pipe
print "Total " column 3 
print grand_tot_ass column 103 size 19 autocomma precision 2 
print grand_tot_adv column 125 size 19 autocomma precision 2 
print grand_tot_dep column 146 size 19 autocomma precision 2
print grand_tot_pro column 167 size 19 autocomma precision 2  
print tot_bad column 192 size 19 autocomma precision 2  
separatorline
nextline
nextline
print "N.B: The Head Office Should be Listed first"  column 3
nextline
nextline
nextline
nextline
print "Name:.........................." column 3
print "Designation: Chief Executive" column 40
print "Signature......................" column 90 
print "Date: .............." column 144 
nextline
nextline
nextline
end 
#**************************************************************************************
#PROCEDURE Line

#begin
#    print "-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" column 1 

#end
#***************************************************************************************

PROCEDURE pipe

begin
        print "|"               column 1
	print "|"               column 41
	print "|"               column 61 
	print "|"               column 100
end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
nextline
print "EXM/29" column 166 
print "INSTITUTION: EQUITY BANK LTD" column 5
nextline
print "DATE:" column 166  
print asondate column 171 size 10
nextline
print "BRANCH: CONSOLIDATED 						(SHS) " column 5
nextline
nextline
nextline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
separatorline
print " DESCRIPTION " column 3 size 30  center
print "LOCATION" column 35 size 19  center 
print "STATUS" column 77 size 20 center
print "ASSETS" column 102 size 19  center
print "ADVANCES" column 124 size 20 center
print "DEPOSITS" column 145 size 20 center
print "PROFIT & LOSS" column 167 size 20 center
print "BAD &" column 188 size 15 center
nextline
print "DISTRICT" column 35 size 19 center 
print "DISTRICT" column 56 size 19 center
print "(Branch, Sub-Branch," column 77  size 20 center
print "DOUBT FUL" column 188 size 15 center
nextline
print "Agency, etc)" column 77 size 20 center
nextline
print "DEBTS" column 188 size 15 center
nextline
separatorline
end
#****************************************************************************************
