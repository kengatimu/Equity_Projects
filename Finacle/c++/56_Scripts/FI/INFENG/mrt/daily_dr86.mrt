# ******************************************************************
#    Report Name		: Inward Clearing exemption Report
#    Author     		: Erick G. Karobia 
#
# ******************************************************************
#
RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#	
####################################################################
SOL_ID      stringType
ZONE_DATE   stringType
ZONE_CODE   stringType
FORACID     stringType
ACCT_NAME   stringType
CLR_BAL_AMT numberType
INST_NUM    stringType
INST_AMT    numberType
####################################################################
LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
page_number         numberType
lv_setid	    stringType  
callscript          stringType
lv_setdesc	    stringType
lv_userId	    stringType 
ipstype		    stringtype
sforacid	    numberType	
tforacid	    numberType	
sclr_bal_amt	    numberType
tclr_bal_amt        numberType
sinst_amt	    numberType
tinst_amt           numberType

####################################################################
GROUPANDSORT
sol_id
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
 bankName		stringType
 branchName		stringType
###################################################################
REPOSITORY argv4
ipSetId				stringType
ipDate				stringType
####################################################################
IGNORERECORd
####################################################################
#
####################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines   3
linesPerPage       70
leftMargin 	   2 
rightMargin	   2
topMargin	   6
bottomMargin	   2
columnsPerLine 	   145
pageHeaderLines	   8 
pageFooterLines	   2 
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
execute brBankHdg
execute pageHdr
set pagenumber=1

PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
execute pageHdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
separatorline
#
BEFOREBREAKOF sol_id
###################################################################
#BEFOREBREAKOF  
####################################################################
print "Transcations for Branch " column 3
print sol_id 
nexTline
#
#
#
AFTERBREAKOF sol_id
###################################################################
#
#afterbreakof 
####################################################################
nextline
set sforacid = groupcount foracid
set sclr_bal_amt = groupsum clr_bal_amt
set sinst_amt = groupsum inst_amt
separatorline 
nextline
print "Sub Total" column 1
print sFORACID     column 30
print sINST_AMT  column 100
print sCLR_BAL_AMT   column 120
nextline
separatorline
nextline

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute printOneRecord

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
nextline
set tforacid=totalcount foracid
set tclr_bal_amt = totalsum clr_bal_amt
set tinst_amt = totalsum inst_amt
if tforacid = 0
begin
	print "********************   No Records Printed   ****************" size  130 center
	nextline
	nextline
	nextline
end
separatorline
print "Grand Total" column 1
print tFORACID     column 30
print tINST_AMT  column 100
print tCLR_BAL_AMT   column 120
separatorline
print "Printed By:" column 1
print lv_userId column 20
nextline
nextline
print "Verified By:"
nextline
separatorline
######################################################################
#  Procedure Block
######################################################################
PROCEDURE pageHdr
separatorline
print "SOL_ID "      column 1
print "ZONE_DATE"    column 5
print "ZONE_CODE"    Column 17
print "A/C NO"      column 30
print "A/C NAME"    column 45
print "INST_NO"     column 75
print "INST_AMOUNT " column 100
print " A/C BALANCE "    column 115
separatorline

####################################################################
PROCEDURE printOneRecord
####################################################################
print SOL_ID      column 1
print ZONE_DATE    column 5
print ZONE_CODE    Column 17
print FORACID     column 30
print ACCT_NAME    column 45
print INST_NUM   column 75
print INST_AMT   column 100
print CLR_BAL_AMT  column 120

####################################################################
PROCEDURE brBankHdg

begin
        print "Page No. "   column 100
        print page_number precision 0
        nextline
        print today column 100
        nextline
        nextline
	print "EQUITY BANK LIMITED" size  130 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 130 center
	nextline
	print "INWARD CLEARING EXEPTIONS REPORT"  size 130 center
	nextline
	print "ZONE DATE: " column 55
	print ipDate size 10
        nextline
        set page_number= page_number+1
        nextline
end
####################################################################
# End of File
######################################################################


