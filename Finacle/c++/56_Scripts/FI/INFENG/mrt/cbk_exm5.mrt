#  This is the Mahareport for Detailed Balance Sheet Branchwise 
###############################################################################
RECORDLAYOUT
###############################################################################
cnt                             numbertype
cust_id                         numbertype
acct_name			stringtype
credif				stringtype
acct_opn_date			stringtype
eabbal				numbertype
sanct_lim			numbertype	
cont_liab_amt			numbertype
lc_sanct_lim			numbertype
lc_date_opnd			stringtype
bg_liab_amt			numbertype
bg_sanct_lim			numbertype
bg_issue_date			stringtype
secu_code			stringtype	
secu_value			numbertype
chrg_amt			numbertype
recv_date			stringtype
valuer				stringtype
int_amt				numbertype
prov_amt			numbertype
cont				numbertype 
################################################################################
LOCALVARIABLES
###############################################################################
callscript    			               stringType
count						numbertype
total						numbertype
lv_setid      				       stringType  
lv_setdesc    				       stringType
################################################################################
GROUPANDSORT
###############################################################################
eabbal,cust_id,cnt
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
############################################################################
#IGNORERECORD
###########################################################################
###############################################################################
PAGEFORMAT
##############################################################################
ColumnsPerLine  280
LinesPerPage    500 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "EQUITY BANK LIMITED"  column 1 size 80 center
nextline
print  "Branch: "   column 1 size 80 center
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 1 size 80 center  
set count = 1
nextline
nextline
nextline
nextline
print asondate column 1 size 80 center   
nextline
nextline
execute header
end
#############################################################################
ONEVERYRECORD
#############################################################################
if count <= cont
begin
if (cnt = 1)
begin
nextline
execute proc_1
end

if (cnt = 2)
begin
execute proc_2
end

if (cnt = 3)
begin
execute proc_3
end

if (cnt = 4)
begin
execute proc_4
end

if (cnt = 5)
begin
execute proc_5
end

end
###############################################################################
ONENDOFREPORT
###############################################################################
nextline
separatorline 
print "TOTAL" column 07
print total column 93 size 17 autocomma precision 2
separatorline
################################################################################
PROCEDURE proc_1
################################################################################
begin
print   count           column  02
print   acct_name       column  07 size 30
print   credif          column  40 size 20 center
print   acct_opn_date   column  62 size 10 center
print   sanct_lim       column  73 size 17 autocomma precision 2
print   eabbal          column  93 size 17 autocomma precision 2
print   eabbal          column  128 size 17 autocomma precision 2
print   int_amt         column  221 size 17 autocomma precision 2
print   prov_amt        column  239 size 17 autocomma precision 2
set count = count + 1
set total = total + eabbal
execute pipes
end
################################################################################
PROCEDURE proc_2
################################################################################
begin
execute pipes 
print   secu_code       column 151
print   secu_value      column 157 size 17 autocomma precision 2
print   chrg_amt	column 175 size 17 autocomma precision 2 
print   recv_date       column 193
print   valuer          column 205
end
################################################################################
PROCEDURE proc_3
################################################################################
begin
nextline
execute pipes 
print   credif          column  40 size 20 center
print   lc_date_opnd    column  62 size 10 center
print   lc_sanct_lim    column  73 size 17 autocomma precision 2
print   cont_liab_amt   column  114 size 17 autocomma precision 2
print   cont_liab_amt   column  128 size 17 autocomma precision 2
end
################################################################################
PROCEDURE proc_4
################################################################################
begin
nextline 
execute pipes 
print	credif		column 40 size 20 center
print   bg_issue_date   column  62 size 10 center
print 	bg_sanct_lim	column  73 size 17 autocomma precision 2  
print	bg_liab_amt	column	114 size 17 autocomma precision 2
print 	bg_liab_amt	 column  128 size 17 autocomma precision 2
end
################################################################################
PROCEDURE proc_5
################################################################################
begin
nextline
execute pipes 
print	acct_name column 07
end
##################################################################################
#************************************************************
PROCEDURE header
#************************************************************
separatorline
execute pipe
print "Srno " size 4  column 2 center
print "COMPANY GROUP & DIRECTORS" size 30  column 7 center
print "CREDIT"  size 20 column 40  center
print "DATE"    size 10 column 62 center
print "LIMIT " size 17 column 73 center
print "OUTSTANDING BALANCE" size 51 column 95 center
print "SECURITY" column 179
print "INTEREST IN" column 221  size 17 center
print "PROVISIONS" column 239 size 16 center
print "ADDITIONAL PROVISIONS" column 259 size 21
nextline
execute pipes
print "|" column 203
print "FACILITIES" size 20 column 40 center
nextline
execute pipes
print "On-Balance" size 20 column  93 center
print "Off-Balance" size 13 column 114 center
print "Total " size 20 column 128 center
print "Type" column 151
print "Value" column 157 size 17 center
print "Amount Charged" column 175
print "Date of " column 193 size 10
print "Valuer" column 204 size 15 center
print "SUSPENSE" column 221 size 17 center
print "HELD" column 239 size 17 center
print "REQUIRED" column 259 size 20 center
nextline
execute pipes
print "Sheet" column 93 size 20  center
print "Sheet" column 114 size 20  center 
print "Valuation" column 193 size 10
nextline
separatorline
#************************************************************************
#************************************************************************
PROCEDURE pipe

begin

print "|"   column 1
print "|"   column 6
print "|"   column 39
print "|"   column 61
print "|"   column 72
print "|"   column 92
print "|"   column 174
print "|"   column 203
print "|"   column 218
print "|"   column 242
print "|"   column 255
print "|"   column 273
end

#**************************************************************
PROCEDURE pipes

begin
print "|"   column 1
print "|"   column 6
print "|"   column 39
print "|"   column 61
print "|"   column 72
print "|"   column 92
print "|"   column 113
print "|"   column 127
print "|"   column 150
print "|"   column 156
print "|"   column 174
print "|"   column 192
print "|"   column 203
print "|"   column 218
print "|"   column 242
print "|"   column 255
print "|"   column 273
end
###########################################################################

