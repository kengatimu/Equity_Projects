PAGEFORMAT
##############################################################################
ColumnsPerLine   440
LinesPerPage     48 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  05 
pageFooterLines  04
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
set total_assets = 0
set tot_asset_total=0
set total_liability =0
set  tot_liabl_total =0
set cash_total =0
set bank_total =0
set investments_total = 0
set debtors_total =0
set stocks_total  = 0
set advances_total =0
set contigent_total = 0
set intangble_total=0
set  fixed_total =0
set other_total  = 0
set current_total =0
set accrual_total =0
set provosion_total =0
set suspended_total =0
set tax_total =0
set deposit_total=0
set borrowing_total  =0
set capital_total =0
nextline
separatorline
print   "CASH"                                            column 16
print   "BANK"	                                          column 36
print   "INVESTMENTS"                                     column 56
print   "DEBTORS / PREPAYMENTS"                           column 76
print   "STOCKS"                                          column 98 
print   "ADVANCES"                                        column 118
print   "CONTIGENT ASSETS"                                column 138 
print   "INTANGIBLE ASSETS"                               column 158
print   "FIXED ASSETS"                                    column 178
print   "OTHER ASSETS"                                    column 198  
print   "TOTAL ASSETS"                                    column 218
print   "CURRENT LIABILITIES"                             column 238
print   "ACCRUALS"                                        column 258
print   "PROVISIONS"                                      column 278
print   "SUSPENDED INTEREST"                              column 298
print   "TAX"                                             column 318
print   "DEPOSITS"                                        column 338
print   "CONTIGENT LIABILITIES"                           column 360
print   "BORROWING"                                       column 380
print   "CAPITAL"                                         column 400
print   "TOTAL LIABILITIES"                               column 420
nextline
print   "BRANCH"                                          column 01
print   "TOTAL FOR GL 10"                                 column 16 
print   "TOTAL FOR GL 11"                                 column 36
print   "TOTAL FOR GL 12"                                 column 56
print   "(TOTAL FOR GLSH 13)"                             column 76
print   "(TOTAL FOR GLSH 14)"                             column 98
print   "TOTAL FOR GL 15"                                 column 118
print   "TOTAL FOR GL 16"                                 column 138
print   "TOTAL FOR GL 17"                                 column 158
print   "TOTAL FOR GL 18"                                 column 178
print   "TOTAL FOR GL 19"                                 column 198
print   "TOTAL FOR GL 30"                                 column 238
print   "TOTAL FOR GL 31"                                 column 258
print   "TOTAL FOR GL 32"                                 column 278
print   "TOTAL FOR GL 33"                                 column 298
print   "TOTAL FOR GL 34"                                 column 318
print   "TOTAL FOR GL 35"                                 column 338
print   "TOTAL FOR GL 36"                                 column 360
print   "TOTAL FOR GL 37"                                 column 380
print   "TOTAL FOR GL 50"                                 column 400
nextline
separatorline
end

#############################################################################
ONEVERYRECORD
#############################################################################
begin
set total_assets =  cash +bank+invest+ debt + stcks  +advnc+contgnt+intngble+fixed+other
set tot_asset_total=tot_asset_total+total_assets
set total_liability = current +accrual+provision +suspended 
set total_liability= total_liability +tax +deposit+contgnt_liability+borrowing +capital

set  tot_liabl_total =  tot_liabl_total+total_liability
print total_liability column 420
print total_assets column 218
print brnch                    column 01
print cash                      column 16
set cash_total = cash_total + cash 
print bank                      column 36
set bank_total = bank_total + bank
print invest                    column 56
set investments_total = investments_total + invest
print debt                      column 76
set debtors_total = debtors_total + debt
print stcks                     column 98
set stocks_total  = stocks_total  + stcks  
print advnc                     column 118
set advances_total = advances_total + advnc 
print contgnt                   column 138
set contigent_total = contigent_total + contgnt
print intngble                  column 158
set intangble_total= intangble_total + intngble 
print fixed                     column 178 
set  fixed_total = fixed_total +  fixed    
print other                     column 198
set other_total  = other_total  + other
print current                   column 238
set current_total = current_total + current
print accrual                   column 258
set accrual_total = accrual_total + accrual
print provision                 column 278
set provosion_total =provosion_total + provision 
print suspended                 column 298
set suspended_total =suspended_total +suspended
print tax                       column 318
set tax_total =tax_total + tax
print deposit                   column 338
set deposit_total=deposit_total + deposit
print contgnt_liability         column 360
set contigent_liabl_total =contigent_liabl_total +contgnt_liability
print borrowing                 column 380
set borrowing_total  =borrowing_total  + borrowing
print capital                   column 400
set capital_total = capital_total +capital 
nextline  
end
###############################################################################
PAGEHEADER
###############################################################################
###############################################################################
ONENDOFREPORT
###############################################################################
separatorline
print   "TOTAL"                        column 01
print   cash_total                     column 16
print   bank_total                     column 36  
print   investments_total              column 56
print   debtors_total                  column 76 
print   stocks_total                   column 98
print   advances_total                 column 118
print   contigent_total                column 138
print   intangble_total                column 158
print   fixed_total                    column 178
print   other_total                    column 198
print   tot_asset_total                column 218
print   current_total                  column 238
print   accrual_total                  column 258
print   provosion_total                column 278
print   suspended_total                column 298
print   tax_total                      column 318
print   deposit_total                  column 338
print   contigent_liabl_total          column 360
print   borrowing_total                column 380
print   capital_total                  column 400
print   tot_liabl_total                column 420                                                                      
separatorline

