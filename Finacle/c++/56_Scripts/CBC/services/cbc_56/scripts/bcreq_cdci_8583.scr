#####################################################################################
#   Source Name                 :   bcreq8583.scr
#   Date                        :   05-Apr-2013
#   Description                 :   This script is used to convert the message in ISO-8583 variant
#				    of the DCC to the native variant of ISO 8583 format of Bancs Connect .
#				    It is executed Immediately after receiving the request from the DCC.
#   Input                       :   None
#   Output                      :   None
#   Author                      :   
#   Calling Script              :   None
#   Called Script               :   None
#   Reference                   :
#   Modification History        :
#   <Serial No>  <Date>      <Author>             <Description>
#	1			05-Apr-2013	 Dileep Rajan	  BankId - Uniser allocation
#####################################################################################
<--start
trace on

# For getting the Sol id and Bank Id from Account Number
CDCI.Request8583.BankId=""
CDCI.Request8583.Field102BankId=""

IF (FIELDEXISTS(CDCI.Request8583.Field102)) THEN
#{
	
	CDCI.Request8583.OrigField102 = CDCI.Request8583.Field102
	CDCI.Request8583.Field102BankId = MID$(CDCI.Request8583.Field102,0,11)
	print(CDCI.Request8583.Field102BankId)
	IF((strlen(trim(CDCI.Request8583.Field102BankId)) == 0) OR (strlen(trim(CDCI.Request8583.Field102BankId)) > 2) ) THEN
	#{
		CDCI.Request8583.Action = "F"
		CDCI.Response8583.Field127 = "Bank Id is null/Invalid Bank Id"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CDCI.Request8583.Field102SolId = MID$(CDCI.Request8583.Field102,11,8)
	print(CDCI.Request8583.Field102SolId)
	CDCI.Request8583.Field102AcctNo = MID$(CDCI.Request8583.Field102,19,19)
	print(CDCI.Request8583.Field102AcctNo)	
	
	CDCI.Request8583.Field102 = trim(CDCI.Request8583.Field102AcctNo)
	print(CDCI.Request8583.Field102)
	CDCI.Request8583.BankId=CDCI.Request8583.Field102BankId
#}
ENDIF
	IF(FIELDEXISTS(CDCI.Request8583.Field103)) THEN
	#{
	   
		CDCI.Request8583.OrigField103 = CDCI.Request8583.Field103
		CDCI.Request8583.Field103CC  = MID$(CDCI.Request8583.Field103,0,2)
		print(CDCI.Request8583.Field103CC)
		
		CDCI.Request8583.Field103BankId = MID$(CDCI.Request8583.Field103,2,11)
		print(CDCI.Request8583.Field103BankId)
		IF((strlen(trim(CDCI.Request8583.Field103BankId)) == 0) OR (strlen(trim(CDCI.Request8583.Field103BankId)) > 2) ) THEN
		#{
			CDCI.Request8583.Action = "F"
			CDCI.Response8583.Field127 = "Bank Id is null/Invalid Bank Id"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CDCI.Request8583.Field103SolId = MID$(CDCI.Request8583.Field103,13,8)
		print(CDCI.Request8583.Field103SolId)
		CDCI.Request8583.Field103AcctNo = MID$(CDCI.Request8583.Field103,21,19)
		print(CDCI.Request8583.Field103AcctNo)	
		
		CDCI.Request8583.Field103 = trim(CDCI.Request8583.Field103AcctNo)
		print(CDCI.Request8583.Field103)
		
		IF((FIELDEXISTS(CDCI.Request8583.Field102BankId)) AND (CDCI.Request8583.Field102BankId==""))THEN
		#{
			CDCI.Request8583.BankId=CDCI.Request8583.Field103BankId
		#}
		ENDIF

	#}
	ENDIF

CDCI.Request8583.BankId=trim(CDCI.Request8583.BankId)
print(CDCI.Request8583.BankId)

CDCI.Request8583.Field49Exist="N"

IF(FIELDEXISTS(CDCI.Request8583.Field49))THEN
#{
	CDCI.Request8583.Field49Exist="Y"
#}
ENDIF


IF ((CDCI.Request8583.BankId ==  "11") OR (CDCI.Request8583.BankId ==  "50") OR (CDCI.Request8583.BankId ==  "54") OR (CDCI.Request8583.BankId ==  "55") OR (CDCI.Request8583.BankId ==  "56")) THEN
#{
	IF(CDCI.Request8583.BankId ==  "11") THEN
	#{ EQUITY BANK SUDAN LTD
		IF((CDCI.Request8583.Field49Exist=="Y") AND (CDCI.Request8583.Field49 == "XXX"))THEN
		#{
			CDCI.Request8583.Field49 = "SSP"
		#}
		ENDIF
		call("../scripts","bcreq8583_SS.scr")
	#}
	ELSE
	#{
	        IF(CDCI.Request8583.BankId ==  "50") THEN
                #{ Equity Bank Rwanda limited
                        IF(CDCI.Request8583.Field49Exist=="Y") THEN
                        #{
                                IF(CDCI.Request8583.Field49 == "XXX")THEN
                                #{
                                        CDCI.Request8583.Field49 = "RWF"
                                #}
                                ENDIF
                        #}
                        ENDIF
                        call("../scripts","bcreq8583_RW.scr")
		#}
		ELSE
		#{
			IF(CDCI.Request8583.BankId ==  "54") THEN
			#{ Equity Bank limited
				IF((CDCI.Request8583.Field49Exist=="Y") AND (CDCI.Request8583.Field49 == "XXX"))THEN
				#{
					CDCI.Request8583.Field49 = "KES"
				#}
				ENDIF
				call("../scripts","bcreq8583_KE.scr")
			#}
			ELSE
			#{
				IF(CDCI.Request8583.BankId ==  "55") THEN
				#{ Equity Bank Tanzania Limited
					IF((CDCI.Request8583.Field49Exist=="Y") AND (CDCI.Request8583.Field49 == "XXX"))THEN
 	                                #{
						CDCI.Request8583.Field49 = "TZS"	
					#}
					ENDIF
					call("../scripts","bcreq8583_TZ.scr")
				#}
				ELSE
				#{
					IF(CDCI.Request8583.BankId ==  "56") THEN
					#{ EQUITY BANK UGANDA LTD
	                                        IF(CDCI.Request8583.Field49Exist=="Y") THEN
                  			        #{
                                	          	 IF(CDCI.Request8583.Field49 == "XXX")THEN
                                			 #{
                                        			CDCI.Request8583.Field49 = "UGX"
                                			 #}
                               				 ENDIF 	                                        
						#}
        	                                ENDIF
						call("../scripts","bcreq8583_UG.scr")
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF


	# Printing the field from the entity specific scripts
	
	IF (FIELDEXISTS(CDCI.Request8583.Field102)) THEN
	#{
		print(CDCI.Request8583.Field102)
		#Storing as <SolID>.<BankID>.<AcctNo>
		IF (trim(CDCI.Request8583.Field102) == trim(CDCI.Request8583.Field102AcctNo)) THEN
		#{
			CDCI.Request8583.Field102Full= RPAD(trim(CDCI.Request8583.Field102SolId),11)+ RPAD(trim(CDCI.Request8583.Field102BankId),8)+ trim(CDCI.Request8583.Field102)
		#}
		ELSE
		#{
			CDCI.Request8583.Field102Full=RPAD(trim(CDCI.Request8583.Field102SolId),11)+ RPAD(trim(CDCI.Request8583.Field102BankId),8) + MID$(CDCI.Request8583.Field102,19,19)
		#}
		ENDIF
		CDCI.Request8583.Field102 = CDCI.Request8583.Field102Full
		print(CDCI.Request8583.Field102)
	#}
	ENDIF
		IF(FIELDEXISTS(CDCI.Request8583.Field103)) THEN
		#{
			# Printing the field from the entity specific scripts
			print(CDCI.Request8583.Field103)
			IF (FIELDEXISTS(CDCI.Request8583.Field103AcctNo)) THEN
			#{
			#Storing as <SolID>.<BankID>.<AcctNo>
			IF (trim(CDCI.Request8583.Field103) == trim(CDCI.Request8583.Field103AcctNo)) THEN
			#{
				CDCI.Request8583.Field103Full= CDCI.Request8583.Field103CC + RPAD(trim(CDCI.Request8583.Field103SolId),11) + RPAD(trim(CDCI.Request8583.Field103BankId),8) + trim(CDCI.Request8583.Field103)
			#}
			ELSE
			#{
				CDCI.Request8583.Field103Full= CDCI.Request8583.Field103CC + RPAD(trim(CDCI.Request8583.Field103SolId),11)+ RPAD(trim(CDCI.Request8583.Field103BankId),8)  + MID$(CDCI.Request8583.Field103,21,19)
			#}
			ENDIF	
			CDCI.Request8583.Field103 = CDCI.Request8583.Field103Full
			#}
			ENDIF
			print(CDCI.Request8583.Field103)
		#}
		ENDIF
#}
ELSE
#{
	#Invalid Bank ID
	CDCI.Request8583.Action = "F"
	CDCI.Response8583.Field127 = "Invalid Bank Id"
	GOTO ENDOFSCRIPT
#}
ENDIF


ENDOFSCRIPT:

trace off
end-->
