				IF ((sv_a == "669932" ) OR (sv_a == "519896") OR (sv_a == "457669") OR (sv_a == "519601") OR (sv_a == "627851") OR (sv_a =="447815") OR (sv_a =="420345") OR (sv_a =="420346")) THEN
				#---Inter country transactions Advise 
