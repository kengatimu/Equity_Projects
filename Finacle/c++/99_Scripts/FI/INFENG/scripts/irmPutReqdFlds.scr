	# irmGetAcctNumFromIBAN.scr has been made as a product level script.
	
	IF(sv_a != "") THEN
	#{
		
		sv_i = "acct_format_val_reqd | SELECT acct_format_val_reqd "
		sv_i = sv_i + " FROM PPRM "
		sv_i = sv_i + " WHERE "
		sv_i = sv_i + " PPRM.BANK_ID = ?SVAR AND "
		sv_i = sv_i + " paysys_id = ?SVAR"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.PaysysId
		sv_y = urhk_dbselectWithBind(sv_i)
		
		IF(sv_y == 0) THEN
		#{
			sv_w = BANCS.OUTPARAM.acct_format_val_reqd
