	IF (fieldexists(BANCS.INPUT.tag71a1)) THEN
	#{
		
		IF (BANCS.INPUT.tag71a1 == "BEN") THEN
		#{
			# In case of beneficairy, the sending bank will deduct the SB charge amount from
			# the Instructed amount and then transfer the balance.
			# As we are using tag32 as Remit amount. No need to use tag71f anymore.
			# Sample Transaction at Originating bank will be :
			# Applicant/Customer A/C for remit amount   = 1000 Dr
			# Charge (Sending bank) A/c					= 10 Cr
			# Nostro A/C								= 990 Cr
			# Thus, incoming message will be having :
			# tag 32:990USD  (Remit Amt)
			# tag 33:1000 USD(Instructed Amt)
			# tag 71A:BEN      tag 71F:10USD
			#
			sv_a = 0
			IF (BANCS.INPUT.tag33b2 != "") THEN
			#{
				IF (BANCS.INPUT.tag32a2 == BANCS.INPUT.tag33b1) THEN
				#{
					sv_m = CDOUBLE(BANCS.INPUT.tag33b2)
					sv_o = CDOUBLE(BANCS.INPUT.tag32a3)
					BANCS.OUTPUT.NostroSendgBankChrg = sv_m - sv_o
					#}
				ELSE
					#{
					sv_m = CDOUBLE(BANCS.INPUT.tag33b2)
					sv_n = CDOUBLE(BANCS.INPUT.tag361)
					sv_o = CDOUBLE(BANCS.INPUT.tag32a3)
					BANCS.OUTPUT.NostroSendgBankChrg = (sv_m * sv_n) - sv_o
				#}
				ENDIF
				BANCS.OUTPUT.NostroSendgBankChrgCrncy = BANCS.INPUT.tag33b1
				BANCS.OUTPUT.NostroRecvBankChrg = sv_a
				BANCS.OUTPUT.NostroRecvBankChrgCrncy = ""
				#}
			ELSE
				#{
				BANCS.OUTPUT.NostroSendgBankChrg = "0"
				BANCS.OUTPUT.NostroSendgBankChrgCrncy = ""
				BANCS.OUTPUT.NostroRecvBankChrg = "0"
				BANCS.OUTPUT.NostroRecvBankChrgCrncy = ""
			#}
			ENDIF
			
			IF (BANCS.INPUT.tag71a1 == "SHA") THEN
			#{
				BANCS.OUTPUT.NostroRecvBankChrg = "0"
				BANCS.OUTPUT.NostroRecvBankChrgCrncy = ""
				BANCS.OUTPUT.NostroSendgBankChrg = "0"
				BANCS.OUTPUT.NostroSendgBankChrgCrncy = ""
			#}
			ENDIF
			
			
			IF (BANCS.INPUT.tag71a1 == "OUR") THEN
			#{
				# In case of OUR, 71G is charges due to the Receiver, which have been prepaid
				# and included in the interbank settlement amount.(tag32).
				# Sample Transaction at Originating bank will be :
				# Applicant/Customer A/C for remit amount   = 1015 Dr
				# Charge (Receiver bank) A/c				= 15 Cr
				# Nostro A/C (Remit Amt + RB charges)		= 1015 Cr
				# Thus, incoming message will be having :
				# tag 32:1015USD  (Remit Amt)
				# tag 33:1000 USD(Instructed Amt)
				# tag 71A:OUR      tag 71G:15USD
				#
				BANCS.OUTPUT.NostroRecvBankChrg = "0"
				BANCS.OUTPUT.NostroRecvBankChrgCrncy = ""
				BANCS.OUTPUT.NostroSendgBankChrg = "0"
				BANCS.OUTPUT.NostroSendgBankChrgCrncy = ""
				IF ((BANCS.INPUT.tag32a2 == BANCS.INPUT.tag33b1) AND (BANCS.INPUT.tag33b1 == BANCS.INPUT.tag71g1) AND (BANCS.INPUT.tag71g1 == BANCS.INPUT.tag32a2)) THEN
				#{
					BANCS.INPUT.tag361 = 1
				#}
				ENDIF
				IF (BANCS.INPUT.tag71g2 == "")  THEN
				#{
					BANCS.OUTPUT.NostroRecvBankChrg = "0"
					BANCS.OUTPUT.NostroRecvBankChrgCrncy = ""
					BANCS.OUTPUT.RemitAmt = CDOUBLE(BANCS.INPUT.tag32a3)
					BANCS.OUTPUT.RemitCrncy = BANCS.INPUT.tag32a2
				#}
				ENDIF
				IF ((BANCS.INPUT.tag32a3 != "") AND (BANCS.INPUT.tag71g2 != "")) THEN
				#{
					# Assumption : The currency code in the fields 71G and 32A must be the same.
					# validation rule C19.
					BANCS.OUTPUT.NostroRecvBankChrg = CDOUBLE(BANCS.INPUT.tag71g2)
					BANCS.OUTPUT.NostroRecvBankChrgCrncy = BANCS.INPUT.tag32a2
					BANCS.OUTPUT.RemitAmt = (CDOUBLE(BANCS.INPUT.tag32a3) - CDOUBLE(BANCS.INPUT.tag71g2))
					BANCS.OUTPUT.RemitCrncy = BANCS.INPUT.tag32a2
					#
				#}
				ENDIF
				
