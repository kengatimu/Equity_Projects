<--START
CHECKSUM="7798a8d238d5220548587fc94249fb31388e7ca43a715aada0d269fe4dffd359"
	TRACE ON
	############################################################################
	#Custom Repository creation
	#############################################################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","CLRREST") == 0) THEN
	#{
		CREATECLASS("CUST","CLRREST",5)
	#}
	ENDIF
	
	CUST.CLRREST.zoneCode = ""
	CUST.CLRREST.solid = ""
	CUST.CLRREST.zoneCode1 = ""
	CUST.CLRREST.errMsg  = ""
	
	############################################################################
	#Getting the values
	############################################################################
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="SOL_000"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CLRREST.solid = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.CLRREST.errMsg = "Sol id setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	print(CUST.CLRREST.solid)
	print(BANCS.STDIN.homeSolId)
	
	IF (BANCS.STDIN.mySolId!=CUST.CLRREST.solid) THEN
	#{
		sv_a = urhk_SRV_SetErr("Deletion Not Allowed!...Contact H/O Clearing" )
		print(sv_a)
		GOTO FINISH
	#}
	ENDIF
	FINISH:
		IF (CUST.CLRREST.errMsg != "") THEN
		#{
			sv_u=urhk_SRV_SetErr(CUST.CLRREST.errMsg)
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
