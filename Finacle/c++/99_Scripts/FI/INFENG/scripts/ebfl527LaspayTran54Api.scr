#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName	: ebfl527LaspayTran54Api.scr 
#Desc		: Creates Suspense Transaction in 54 respective to mkey(99) Loan Laspay 
#MenuId		: NA
#Module		: MKEY -API
#Date		: 07/12/2018
#Author		: Vino Palani
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#+++++++++++++
#Rep&Class
#+++++++++++++
	if(repexists("MKEY")==0)then
		createrep("MKEY")
	endif
	if(classexists("MKEY","GLBDATA")==0)then
		createclass("MKEY","GLBDATA",5)
	endif
#+++++++++++++
#Inputs
#+++++++++++++
        CUST.INTERFACE.tranSubType = "BI"
        CUST.INTERFACE.tranType = "T"
        print(CUST.INTERFACE.lapaytype)
        print(BANCS.STDIN.BODDate)
        if(fieldexists(CUST.INTERFACE.AccountID)==1)then
                MKEY.GLBDATA.loanAcct   = CUST.INTERFACE.AccountID
        else
                MKEY.GLBDATA.loanAcct   = ""
        endif
        if(fieldexists(CUST.INTERFACE.sourceAcId)==1)then
                MKEY.GLBDATA.sourceAcId = CUST.INTERFACE.sourceAcId
        else
                MKEY.GLBDATA.sourceAcId = ""
        endif
        if(fieldexists(CUST.INTERFACE.enteredAmt)==1)then
                MKEY.GLBDATA.dmdAmt     = CUST.INTERFACE.enteredAmt
        else
                MKEY.GLBDATA.dmdAmt     = 0
        endif
        if(fieldexists(CUST.INTERFACE.lapaytype)==1)then
                MKEY.GLBDATA.lapaytype  = CUST.INTERFACE.lapaytype
        else
                MKEY.GLBDATA.lapaytype  = 0
        endif
#++++++++++++++++++++
#Derive Charge Amount
#++++++++++++++++++++
        sv_s = "ChrgAmt| select tran_amt from tbaadm.htd where bank_id='99' and pstd_flg='Y' and del_flg='N' "
        sv_s = sv_s + " and tran_type='T' and tran_sub_type='CI' and part_tran_type='D' "
        sv_s = sv_s + " and acid in (select acid from tbaadm.gam where foracid='"+ MKEY.GLBDATA.loanAcct +"' and bank_id='99') "
        sv_s = sv_s + " and tran_particular like '%Capitalize Charges%' "
        print(sv_s)
        sv_u = urhk_dbSelectWithBind(sv_s)
        if(sv_u==0)then
                MKEY.GLBDATA.ChrgAmt    = BANCS.OUTPARAM.ChrgAmt
        else
                MKEY.GLBDATA.ChrgAmt    = 0
        endif
        if(cdouble(MKEY.GLBDATA.ChrgAmt) <=0)then
                sv_s = "ChrgAmt| select tran_amt from tbaadm.dtd where bank_id='99' and pstd_flg='Y' and del_flg='N' "
                sv_s = sv_s + " and tran_type='T' and tran_sub_type='CI' and part_tran_type='D' "
                sv_s = sv_s + " and acid in (select acid from tbaadm.gam where foracid='"+ MKEY.GLBDATA.loanAcct +"' and bank_id='99') "
                sv_s = sv_s + " and tran_particular like '%Capitalize Charges%' "
                print(sv_s)
                sv_u = urhk_dbSelectWithBind(sv_s)
                if(sv_u==0)then
                        MKEY.GLBDATA.ChrgAmt    = BANCS.OUTPARAM.ChrgAmt
                else
                        MKEY.GLBDATA.ChrgAmt    = 0
                endif
        endif

	MKEY.GLBDATA.RequestID1		= ""
	MKEY.GLBDATA.channelID		= "FNT"
	MKEY.GLBDATA.bankID		= "54"
	MKEY.GLBDATA.tranType		= "T"
	MKEY.GLBDATA.tranSubType	= "BI"
	MKEY.GLBDATA.msgDateTime	= ""
	MKEY.GLBDATA.drRate		= "1.00"
	MKEY.GLBDATA.rateCode		= ""
	MKEY.GLBDATA.crRate		= "1.00"
	MKEY.GLBDATA.rateCode		= ""
	##PreProd
	MKEY.GLBDATA.drMkeySusAcct	= "0001300105035"
	##PreProd
	MKEY.GLBDATA.crLoanFinAcct	= "0810277983345"
	##PreProd
	MKEY.GLBDATA.crLoanPayAcct	= "0003000105247"
	MKEY.GLBDATA.drMkeySusAmt	= 0 
	MKEY.GLBDATA.drMkeySusCrncy	= "KES"
	MKEY.GLBDATA.drMkeyParticular	= "Laspay Dr For:" +MKEY.GLBDATA.crLoanFinAcct+ "/" + MKEY.GLBDATA.crLoanPayAcct 
	MKEY.GLBDATA.drMkeyRemarks	= MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.crLoanFinAmt	= 0 
	MKEY.GLBDATA.crLoanFinCrncy	= "KES"
	MKEY.GLBDATA.crLoanFinParticular= "Laspay Cr From:" +MKEY.GLBDATA.drMkeySusAcct+ "/" + MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.crLoanFinRemarks	= MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.crLoanPayAmt	= 0 
	MKEY.GLBDATA.crLoanPayCrncy	= "KES"
	MKEY.GLBDATA.crLoanPayParticular= "Laspay Cr From:" +MKEY.GLBDATA.drMkeySusAcct+ "/" + MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.crLoanPayRemarks	= MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.commRefNum		= MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.drMkeyParticular2	= MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.crLoanFinParticular2= MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.crLoanPayParticular2= MKEY.GLBDATA.loanAcct 
	MKEY.GLBDATA.chrgAmt		= 0
	MKEY.GLBDATA.prinAmt		= 0
	MKEY.GLBDATA.KenyLpayTranId	= ""
#+++++++++++++
#DeriveInputs
#+++++++++++++
        sv_s = "loanAmt | select sanct_lim  from tbaadm.gam where schm_type='LAA' and bank_id='99' and foracid='" + MKEY.GLBDATA.loanAcct +"' "
        sv_u = urhk_dbSelectWithBind(sv_s)
        if(sv_u==0)then
                MKEY.GLBDATA.loanAmt = BANCS.OUTPARAM.loanAmt
        else
                MKEY.GLBDATA.loanAmt = 0
        endif
        print(MKEY.GLBDATA.loanAmt)
        print(MKEY.GLBDATA.ChrgAmt)
        print(MKEY.GLBDATA.chrgAmt)
        print(MKEY.GLBDATA.prinAmt)
        MKEY.GLBDATA.loanAmt = cdouble(MKEY.GLBDATA.loanAmt) + cdouble(MKEY.GLBDATA.ChrgAmt)
        MKEY.GLBDATA.chrgAmt = ( cdouble(MKEY.GLBDATA.dmdAmt) / cdouble(MKEY.GLBDATA.loanAmt) ) * cdouble(MKEY.GLBDATA.ChrgAmt)
        MKEY.GLBDATA.prinAmt = cdouble(MKEY.GLBDATA.dmdAmt) - cdouble(MKEY.GLBDATA.chrgAmt)
        print(MKEY.GLBDATA.loanAmt)
        print(MKEY.GLBDATA.ChrgAmt)
        print(MKEY.GLBDATA.chrgAmt)
        print(MKEY.GLBDATA.prinAmt)
        MKEY.GLBDATA.crLoanFinAmt       = MKEY.GLBDATA.prinAmt
        MKEY.GLBDATA.crLoanPayAmt       = MKEY.GLBDATA.chrgAmt
        MKEY.GLBDATA.drMkeySusAmt       = cdouble(MKEY.GLBDATA.prinAmt) + cdouble(MKEY.GLBDATA.chrgAmt)

	sv_s = "RequestID1|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0)then
		MKEY.GLBDATA.RequestID1 = BANCS.OUTPARAM.RequestID1
		print(MKEY.GLBDATA.RequestID1)
	else
		MKEY.GLBDATA.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
		print(MKEY.GLBDATA.RequestID1)
	endif
	MKEY.GLBDATA.RequestID1=MKEY.GLBDATA.RequestID1
	sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
	sv_d = urhk_dbSelectWithBind(sv_s)
	if(sv_d == 0) then
		MKEY.GLBDATA.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
		print(MKEY.GLBDATA.msgDateTime)
	endif
#+++++++++++++
#Header XML
#+++++++++++++
	MKEY.GLBDATA.headerXML = ""
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Header>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RequestHeader>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<MessageKey>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RequestUUID>"+ MKEY.GLBDATA.RequestID1 +"</RequestUUID>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ServiceRequestId>XferTrnAdd</ServiceRequestId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ChannelId>" + MKEY.GLBDATA.channelID + "</ChannelId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<LanguageId></LanguageId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</MessageKey>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RequestMessageInfo>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<BankId>" + MKEY.GLBDATA.bankID + "</BankId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<TimeZone></TimeZone>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<EntityId></EntityId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<EntityType></EntityType>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<ArmCorrelationId></ArmCorrelationId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<MessageDateTime>" + MKEY.GLBDATA.msgDateTime + "</MessageDateTime>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</RequestMessageInfo>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Security>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Token>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<PasswordToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<UserId></UserId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<Password></Password>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</PasswordToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</Token>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<FICertToken></FICertToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RealUserLoginSessionId></RealUserLoginSessionId>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RealUser></RealUser>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<RealUserPwd></RealUserPwd>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "<SSOTransferToken></SSOTransferToken>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</Security>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</RequestHeader>"
	MKEY.GLBDATA.headerXML = MKEY.GLBDATA.headerXML + "</Header>"
#+++++++++++++
#Body XML
#+++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = ""
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<body><XferTrnAddRequest>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnAddRq>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnHdr>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnType>" + MKEY.GLBDATA.tranType + "</TrnType>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnSubType>" + MKEY.GLBDATA.tranSubType + "</TrnSubType>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnHdr>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnDetail>"
#+++++++++++++++++++++++++
#Dr: mKey Suspense Account
#+++++++++++++++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRec>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>" + MKEY.GLBDATA.drMkeySusAcct + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<CreditDebitFlg>D</CreditDebitFlg>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<amountValue>" + MKEY.GLBDATA.drMkeySusAmt + "</amountValue>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<currencyCode>" + MKEY.GLBDATA.drMkeySusCrncy + "</currencyCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnParticulars>" + MKEY.GLBDATA.drMkeyParticular + "</TrnParticulars>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRmks>" + MKEY.GLBDATA.drMkeyRemarks + "</PartTrnRmks>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<ValueDt>"+ MKEY.GLBDATA.msgDateTime + "</ValueDt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<Rate>" + MKEY.GLBDATA.drRate + "</Rate>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<RateCode>" + MKEY.GLBDATA.rateCode + "</RateCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SerialNum>1</SerialNum>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PartTrnRec>"
#++++++++++++++++++++++++++++++
#Cr:Finserve mKey Fund Account
#++++++++++++++++++++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRec>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>" + MKEY.GLBDATA.crLoanFinAcct + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<CreditDebitFlg>C</CreditDebitFlg>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<amountValue>" + MKEY.GLBDATA.crLoanFinAmt + "</amountValue>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<currencyCode>" + MKEY.GLBDATA.crLoanFinCrncy + "</currencyCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnParticulars>" + MKEY.GLBDATA.crLoanFinParticular + "</TrnParticulars>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRmks>" + MKEY.GLBDATA.crLoanFinRemarks + "</PartTrnRmks>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<ValueDt>"+ MKEY.GLBDATA.msgDateTime + "</ValueDt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<Rate>" + MKEY.GLBDATA.crRate + "</Rate>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<RateCode>" + MKEY.GLBDATA.rateCode + "</RateCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SerialNum>2</SerialNum>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PartTrnRec>"
#+++++++++++++++++++++++++++++++++++++++
#Cr:Finserve mKey  Loans payable Account
#+++++++++++++++++++++++++++++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRec>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<AcctId>" + MKEY.GLBDATA.crLoanPayAcct + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</AcctId>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<CreditDebitFlg>C</CreditDebitFlg>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<amountValue>" + MKEY.GLBDATA.crLoanPayAmt + "</amountValue>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<currencyCode>" + MKEY.GLBDATA.crLoanPayCrncy + "</currencyCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</TrnAmt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TrnParticulars>" + MKEY.GLBDATA.crLoanPayParticular + "</TrnParticulars>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PartTrnRmks>" + MKEY.GLBDATA.crLoanPayRemarks + "</PartTrnRmks>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<ValueDt>"+ MKEY.GLBDATA.msgDateTime + "</ValueDt>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<Rate>" + MKEY.GLBDATA.crRate + "</Rate>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<RateCode>" + MKEY.GLBDATA.rateCode + "</RateCode>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SerialNum>3</SerialNum>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PartTrnRec>"

	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnDetail>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnAddRq>"

	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<XferTrnAdd_CustomData>"
#+++++++++++++++++++++++++
#Dr: mKey Suspense Account
#+++++++++++++++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PARTTRANDTLS isMultiRec='Y'>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SRLNUM>1</SRLNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<REFNUM>" + MKEY.GLBDATA.commRefNum + "</REFNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TRANPARTICULARS2>" + MKEY.GLBDATA.drMkeyParticular2 + "</TRANPARTICULARS2>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PARTTRANDTLS>"
#++++++++++++++++++++++++++++++
#Cr:Finserve mKey Fund Account
#++++++++++++++++++++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PARTTRANDTLS isMultiRec='Y'>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SRLNUM>2</SRLNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<REFNUM>" + MKEY.GLBDATA.commRefNum + "</REFNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TRANPARTICULARS2>" + MKEY.GLBDATA.crLoanFinParticular2 + "</TRANPARTICULARS2>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PARTTRANDTLS>"
#+++++++++++++++++++++++++++++++++++++++
#Cr:Finserve mKey  Loans payable Account
#+++++++++++++++++++++++++++++++++++++++
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<PARTTRANDTLS isMultiRec='Y'>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<SRLNUM>3</SRLNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<REFNUM>" + MKEY.GLBDATA.commRefNum + "</REFNUM>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "<TRANPARTICULARS2>" + MKEY.GLBDATA.crLoanPayParticular2 + "</TRANPARTICULARS2>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</PARTTRANDTLS>"
	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnAdd_CustomData>"

	MKEY.GLBDATA.bodyXMLMsg = MKEY.GLBDATA.bodyXMLMsg + "</XferTrnAddRequest></body>"

	print(MKEY.GLBDATA.bodyXMLMsg)
#+++++++++++++++++++++++++++++++++++++
#Appending the header XML and body XML.
#+++++++++++++++++++++++++++++++++++++
	MKEY.GLBDATA.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + "<FIXML>"
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + MKEY.GLBDATA.headerXML
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + MKEY.GLBDATA.bodyXMLMsg
	MKEY.GLBDATA.reqXMLMsg = MKEY.GLBDATA.reqXMLMsg + "</FIXML>"
#+++++++++++++++++++
# FI Call 
#+++++++++++++++++++
	BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
	BANCS.INPARAM.SEND_RECV_FLG             = "R"
	sv_a = MKEY.GLBDATA.reqXMLMsg
	PRINT(sv_a)
	sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
	print(sv_l)
	if(sv_l != 0)then
		print(BANCS.OUTPARAM.ErrMsg)
		MKEY.GLBDATA.errorMsgFlg = "Y"
		MKEY.GLBDATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		MKEY.GLBDATA.errorMsgCode = "FIERR"
	endif
	if(BANCS.OUTPARAM.ErrMsg != "") then
		MKEY.GLBDATA.errorMsgFlg = "Y"
		MKEY.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
		MKEY.GLBDATA.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
		MKEY.GLBDATA.errorMsgCode = "FIERR"
		GOTO ENDOFSCRIPT
	else
		MKEY.GLBDATA.respXMLMsg = BANCS.OUTPARAM.RespMesg
		print(MKEY.GLBDATA.respXMLMsg)
		MKEY.GLBDATA.errorMsgFlg = ""
		MKEY.GLBDATA.errorMsgDesc = ""
	endif
	sv_x = MKEY.GLBDATA.respXMLMsg
#++++++++++++++++++
#FI Response
#++++++++++++++++++
	sv_y = "<Status>"
	sv_z = "</Status>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	if (GETPOSITION(sv_x, sv_y) != 0) then
		MKEY.GLBDATA.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
	else
		MKEY.GLBDATA.tranStatus = ""
	endif
	print(MKEY.GLBDATA.tranStatus)
	if(MKEY.GLBDATA.tranStatus == "SUCCESS") then
		MKEY.GLBDATA.errorMsgFlg = "N"
		sv_x = MKEY.GLBDATA.respXMLMsg
		sv_y = "<TrnId>"
		sv_z = "</TrnId>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		if (GETPOSITION(sv_x, sv_y) != 0) then
			MKEY.GLBDATA.tranId = MID$(sv_x, sv_b, (sv_e - sv_b))
		endif
		if(MKEY.GLBDATA.tranId == "") then
			MKEY.GLBDATA.errorMsgFlg = "Y"
			MKEY.GLBDATA.errorCode = "SYSERR"
			MKEY.GLBDATA.errorDesc = "Could not get response from server"
		else
			print(MKEY.GLBDATA.tranId)
			MKEY.GLBDATA.KenyLpayTranId = MKEY.GLBDATA.tranId
		endif
	else
		MKEY.GLBDATA.errorMsgFlg = "Y"
		if(MKEY.GLBDATA.tranStatus == "FAILED") then
			sv_x = MKEY.GLBDATA.respXMLMsg
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			if(GETPOSITION(sv_x, sv_y) != 0) then
				MKEY.GLBDATA.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
			endif
			sv_x = MKEY.GLBDATA.respXMLMsg
			sv_y = "<ErrorDesc>"
			sv_z = "</ErrorDesc>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			if(GETPOSITION(sv_x, sv_y) != 0) then
				MKEY.GLBDATA.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
			endif
		endif
		if((MKEY.GLBDATA.errorCode == "") AND (MKEY.GLBDATA.errorDesc == "")) then
			MKEY.GLBDATA.errorCode = "SYSERR"
			MKEY.GLBDATA.errorDesc = "Could not get response from server"
		endif
	endif
end-->
