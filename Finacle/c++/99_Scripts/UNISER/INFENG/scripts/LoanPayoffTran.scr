			MTT.PartTranDetails.PTranBusinessType="SUSP"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefineLoanPartTran("INT_COLL")
		ENDIF
	ENDIF
	sv_u = CDOUBLE(MTT.InputDetails.normaltranBookAmount)
	sv_v = CDOUBLE(MTT.InputDetails.pendingInterestDmds)
	sv_x = CDOUBLE(MTT.InputDetails.tranIarAmount)
	sv_u = sv_u + sv_x
	sv_c = CDOUBLE(MTT.InputDetails.penaltranBookAmount)
	IF(MTT.InputDetails.bookAdvIntFlg=="N") THEN
		sv_u = sv_u + sv_x
		IF(MTT.InputDetails.isSalamFlg == "Y") THEN
			sv_u = sv_u - sv_v
		ENDIF
	ELSE
		sv_u = sv_x
		IF(MTT.InputDetails.isSalamFlg == "Y") THEN
			sv_u = sv_u - sv_v
		ENDIF
	ENDIF
	IF((MTT.InputDetails.penalMethod != "C") AND (MTT.InputDetails.isSalamFlg == "Y")) THEN
		sv_u = sv_u - sv_c
	ENDIF
	IF(MTT.InputDetails.unEarnIncFlg != "Y") THEN
		IF(sv_u != 0.0) THEN
			MTT.PartTranDetails.Account=MTT.InputDetails.normal_pandl_acct
			IF(MTT.InputDetails.funcCode == "R") THEN
				MTT.PartTranDetails.RefAmount=-(sv_u)
				MTT.PartTranDetails.sysPartTranCode ="PTRN02708"
			ELSE
				MTT.PartTranDetails.RefAmount=(sv_u)
				MTT.PartTranDetails.sysPartTranCode ="PTRN02709"
			ENDIF
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff Book Adj to PandL a/c"
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Remarks="Dr Int book -Payoff"
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="SUSP"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("INT_BOOK")
		ENDIF
	ENDIF
	sv_u = CDOUBLE(MTT.InputDetails.penaltranBookAmount)
	IF(MTT.InputDetails.penalMethod != "C") THEN
		IF(MTT.InputDetails.bookAdvIntFlg=="N") THEN
			IF(MTT.InputDetails.penaltranBookAmount != 0) THEN
				MTT.PartTranDetails.Account=MTT.InputDetails.penal_pandl_acct
				IF(MTT.InputDetails.funcCode == "R") THEN
					MTT.PartTranDetails.RefAmount=-(sv_u)
					MTT.PartTranDetails.sysPartTranCode ="PTRN02710"
				ELSE
					MTT.PartTranDetails.RefAmount=(sv_u)
					MTT.PartTranDetails.sysPartTranCode ="PTRN02711"
				ENDIF
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
				MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff Int book "
				MTT.PartTranDetails.ScriptEventType = "LATPA"
				sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				IF (sv_m == 0) THEN
					CALL("getMTTTranPart.scr")
				ENDIF
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
				MTT.PartTranDetails.Remarks="Dr Int book -Payoff"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="poff"
				MTT.PartTranDetails.PTranBusinessType="SUSP"
				MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
				MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
				sv_z = urhk_MTTS_DefinePartTran("INT_BOOK")
			ENDIF
		ENDIF
	ENDIF
	sv_u = CDOUBLE(MTT.InputDetails.ovdutranBookAmount)
	IF(MTT.InputDetails.ovdutranBookAmount != 0) THEN
		MTT.PartTranDetails.Account=MTT.InputDetails.normal_pandl_acct
		IF(MTT.InputDetails.funcCode == "R") THEN
			MTT.PartTranDetails.RefAmount=-(sv_u)
			MTT.PartTranDetails.sysPartTranCode ="PTRN02712"
		ELSE
			MTT.PartTranDetails.RefAmount=(sv_u)
			MTT.PartTranDetails.sysPartTranCode ="PTRN02713"
		ENDIF
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
		MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff Int book Ovdu"
		MTT.PartTranDetails.ScriptEventType = "LATPA"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
			CALL("getMTTTranPart.scr")
		ENDIF
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Remarks="Dr Int book -Payoff"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="poff"
		MTT.PartTranDetails.PTranBusinessType="SUSP"
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		sv_z = urhk_MTTS_DefinePartTran("INT_BOOK")
	ENDIF
	sv_m = ""
	sv_g = 0
	sv_w = CDOUBLE(MTT.InputDetails.actualAdvIntRefundAmt)
	sv_f = CDOUBLE(MTT.InputDetails.excessCreditAmount)
	sv_g = CDOUBLE(MTT.InputDetails.rebateBenefitAmt)
	sv_u =  CDOUBLE(MTT.InputDetails.leaseAssetValue)
	IF(MTT.InputDetails.isMURTAWFlg == "Y" AND  (MTT.InputDetails.isISTISNAFlg=="N")) THEN
		sv_g = 0
	ENDIF
	IF(MTT.InputDetails.funcCode == "R") THEN
		sv_w = -sv_w
		sv_g = -sv_g
	ENDIF
	IF(MTT.InputDetails.funcCode == "R") THEN
		MTT.PartTranDetails.sysPartTranCode ="PTRN02714"
	ELSE
		MTT.PartTranDetails.sysPartTranCode ="PTRN02715"
	ENDIF
	sv_c = 0
	IF(sv_u >0) THEN
		IF((MTT.InputDetails.funcCode== "P") AND (MTT.InputDetails.recovTermPandlFrm == "L") AND (MTT.InputDetails.entityType == "F")) THEN
			sv_a = sv_a - sv_u
		ENDIF
		IF((MTT.InputDetails.funcCode== "P") AND (MTT.InputDetails.recovTermPandlFrm == "O") AND (MTT.InputDetails.entityType == "F")) THEN
			sv_c = sv_a - sv_u
			sv_a = 0
		ENDIF
		IF((MTT.InputDetails.funcCode == "R") AND (MTT.InputDetails.recovTermPandlFrm == "L") AND (MTT.InputDetails.entityType == "F")) THEN
			sv_a = sv_a + sv_u
		ENDIF
		IF((MTT.InputDetails.funcCode == "R") AND (MTT.InputDetails.recovTermPandlFrm == "O") AND (MTT.InputDetails.entityType == "F")) THEN
			sv_c = sv_a + sv_u
			sv_a = 0
		ENDIF
	ENDIF
	IF(sv_f == 0) THEN
		IF(sv_a!=0) THEN
			IF((MTT.InputDetails.advIntRefundFlg != "Y") OR ((MTT.InputDetails.int_route_flg == "O") AND (MTT.InputDetails.unEarnIncFlg == "Y"))) THEN
				IF((MTT.InputDetails.isMURTAWFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "Y")) THEN
					sv_a = sv_a - sv_s -  sv_w
				ELSE
					sv_a = sv_a - sv_s - sv_g - sv_w
				ENDIF
			ELSE
				sv_a = sv_a - sv_w - sv_g
			ENDIF
			
			IF( (sv_a != 0) AND (MTT.InputDetails.isIjarahFlg=="Y") ) THEN
				sv_a = 0
			ENDIF
			
			sv_m=MTT.InputDetails.tranCrncy
			sv_g=MTT.InputDetails.source_acct_crncy
			MTT.PartTranDetails.Account=MTT.InputDetails.source_acct_num
			MTT.PartTranDetails.RefAmount=-sv_a
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			IF(MTT.InputDetails.TranType == "T") THEN
				IF(MTT.InputDetails.TranSubType == "CI") THEN
					IF(MTT.InputDetails.funcCode != "R") THEN
						MTT.PartTranDetails.InstrmntType = MTT.InputDetails.instrmntType
						IF(MTT.InputDetails.instrmntDate !="") THEN
							BANCS.INPARAM.date1 = MID$(MTT.InputDetails.instrmntDate,0,10)
							BANCS.INPARAM.date2 = MID$(BANCS.STDIN.BODDate,0,10)
							sv_r = urhk_B2k_dateDiff("")
							MTT.PartTranDetails.InstrmntDate=BANCS.OUTPARAM.dateDiff
						ENDIF
						MTT.PartTranDetails.InstrmntNum = MTT.InputDetails.instrmntNum
						MTT.PartTranDetails.InstrmntAlpha = MTT.InputDetails.instrmntAlpha
					ENDIF
				ENDIF
			ENDIF
			IF (sv_m != sv_g) THEN
				MTT.PartTranDetails.RateCode = MTT.InputDetails.tranRateCode
				MTT.PartTranDetails.Rate = MTT.InputDetails.tranRate
				MTT.PartTranDetails.TreaRate = MTT.InputDetails.tranTreaRate
				MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.tranTreaRefNum
			ELSE
				MTT.PartTranDetails.RateCode = ""
				MTT.PartTranDetails.TreaRefNum = ""
			ENDIF
			MTT.PartTranDetails.Particulars=MTT.InputDetails.source_acct_num + " - Payoff Source a/c"
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
			#{
				CALL("PayOffIntRateCal.scr")
			#}
			ENDIF
			#new code end
			IF((MTT.InputDetails.TranType == "T") AND (MTT.InputDetails.OAPSchmTypeFlg != "Y")) THEN
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Remarks="Debit Source Account"
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			IF(MTT.InputDetails.OAPSchmTypeFlg == "Y") THEN
				MTT.PartTranDetails.Refnum=MTT.InputDetails.refNum
				IF(MTT.InputDetails.funcCode != "R") THEN
					MTT.OAPAddnlDetails.OffsetAmount = sv_a
				ELSE
					MTT.OAPAddnlDetails.OffsetAmount = -sv_a
				ENDIF
				MTT.OAPAddnlDetails.OrgTranID = MTT.InputDetails.OAPTranId
				MTT.OAPAddnlDetails.OrgTranDate = MTT.InputDetails.OAPTranDate
				MTT.OAPAddnlDetails.OrgPartTran = MTT.InputDetails.OAPPTranSrlNum
			ENDIF
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			MTT.PartTranDetails.svsTranId=MTT.InputDetails.svsTranId
			sv_z = urhk_MTTS_DefinePartTran("SRC_DEBIT_PTRAN")
		ENDIF
	ENDIF
	IF(sv_c != 0) THEN
		IF(MTT.InputDetails.recovTermPandlFrm == "O") THEN
			MTT.PartTranDetails.Account=MTT.InputDetails.terminationPandLAcct
			MTT.PartTranDetails.RefAmount=-sv_c
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.TreaRefNum = ""
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff Termination P&L a/c"
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Remarks="Debit Termination P&L a/c"
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			MTT.PartTranDetails.svsTranId=MTT.InputDetails.svsTranId
			sv_z = urhk_MTTS_DefinePartTran("TERM_DEBIT_PTRAN")
		ENDIF
	ENDIF
	sv_y=sv_d+sv_o+sv_b+sv_i
	IF(MTT.InputDetails.int_route_flg=="O") THEN
		sv_y=sv_y-sv_i
		MTT.LAAddnlDetails.PrincipalAmt = "0"
	ENDIF
	IF(MTT.InputDetails.chrg_route_flg=="O") THEN
		sv_y=sv_y-sv_o-sv_b
	ENDIF
	sv_a = CDOUBLE(MTT.InputDetails.netPayOffAmount)
	
	IF ( MTT.InputDetails.isIjarahFlg=="Y") THEN
		sv_d=CDOUBLE(MTT.InputDetails.pendPrincipalDemandAmount)
		sv_x=CDOUBLE(MTT.InputDetails.rshdlRevDepAmt)
		IF ( MTT.InputDetails.funcCode == "R" ) THEN
			sv_x=sv_d-sv_x
		ELSE
			sv_x=sv_d+sv_x
		ENDIF
		sv_y=sv_y-sv_x
	ENDIF
	IF(sv_y != 0) THEN
		sv_y = sv_y - sv_s
		MTT.PartTranDetails.Account=MTT.InputDetails.foracid
		MTT.PartTranDetails.RefAmount=sv_y
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = ""
		IF((sv_f - sv_a) >= 0) THEN
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Demand Satisfaction From Excess Credit"
		ELSE
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff - Demand satisfaction"
		ENDIF
		
		IF(MTT.InputDetails.isIjarahFlg=="Y" ) THEN
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Reversal of Depreciation Since Last Application"
		ENDIF
		
		MTT.PartTranDetails.ScriptEventType = "LATPA"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
			CALL("getMTTTranPart.scr")
		ENDIF
		#new code start
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			CALL("PayOffIntRateCal.scr")
		#}
		ENDIF
		#new code end
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Remarks="Credit Loan Account "
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="poff"
		MTT.PartTranDetails.PTranBusinessType="LOAN1"
		MTT.PartTranDetails.sysPartTranCode ="PTRN02716"
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
		
		IF ( MTT.InputDetails.isIjarahFlg=="Y") THEN
			MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.transferFlowId
		ENDIF
		
		MTT.LAAddnlDetails.LoanAcctId = ""
		MTT.LAAddnlDetails.AdvancePaymentFlg ="N"
		MTT.LAAddnlDetails.OriginOfTran = "POFF"
		MTT.LAAddnlDetails.intRefundPrePymntFlg=MTT.InputDetails.advIntRefundFlg
		MTT.LAAddnlDetails.DemandSatisfyFlg = "Y"
		MTT.LAAddnlDetails.TypeOfDemand = "A"
		IF ( MTT.InputDetails.funcCode == "R" ) THEN
			MTT.PartTranDetails.Particulars = "Loan Payoff Reversal For :" + MTT.InputDetails.foracid
			MTT.PartTranDetails.sysPartTranCode ="PTRN02717"
			
			MTT.PartTranDetails.Refnum = "PYOFRVSL"
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.reversalTranId
			MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.reversalTranDate
			MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.loanRevPartTranNum1
			MTT.LAAddnlDetails.PrincipalAmt = "0"
			MTT.LAAddnlDetails.InterestAmt  = "0"
			MTT.LAAddnlDetails.BankChrgAmt  = "0"
			MTT.LAAddnlDetails.OtherChrgAmt = "0"
		ENDIF
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		sv_z = urhk_MTTS_DefinePartTran("LOAN_CREDIT_PTRAN")
	ENDIF
	
	# Moved code to LoanPayoffIjarah.scr to bring the file size less than 131072.
	
	IF (MTT.InputDetails.isIjarahFlg=="Y") THEN
		sv_m=urhk_getFileLocation("SCRIPT|LoanPayoffIjarah.scr")
		IF (sv_m==0) THEN
			CALL("LoanPayoffIjarah.scr")
		ENDIF
	ENDIF
	
	IF(MTT.InputDetails.AddAdvRentAcntngFlg=="Y") THEN
		sv_C=CDOUBLE(MTT.InputDetails.AddAdvRentAmt)
		IF(sv_C != "0") THEN
			MTT.PartTranDetails.Account             =       MTT.InputDetails.AddAdvRentAcct
			MTT.PartTranDetails.Particulars         =       MTT.InputDetails.foracid+ " : Payoff Additional Adv. Rent Debit"
			MTT.PartTranDetails.RefCurrency         =       MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode            =       ""
			IF ( MTT.InputDetails.funcCode == "R" ) THEN
				MTT.PartTranDetails.RefAmount       =       sv_C
			ELSE
				MTT.PartTranDetails.RefAmount       =       -sv_C
			ENDIF
			MTT.PartTranDetails.ValueDate           =       MTT.InputDetails.valueDate
			MTT.PartTranDetails.TreaRefNum          =       ""
			
			MTT.PartTranDetails.ScriptEventType     =   	"LATPA"
			sv_z=urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_z==0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			
			MTT.PartTranDetails.EntryUserId         =       MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime           =       MTT.InputDetails.EntryTime
			MTT.PartTranDetails.ACPARTB2kType       =       "ACCNT"
			MTT.PartTranDetails.ACPARTB2kId         =       MTT.InputDetails.foracid
			MTT.PartTranDetails.TranIdentifier      =       "poff"
			MTT.PartTranDetails.PTranBusinessType   =       "ADDADVDR"
			MTT.PartTranDetails.Consolidate         =       "N"
			MTT.PartTranDetails.Remarks             =       "Additional Adv. Rent Debit"
			
			IF ( MTT.InputDetails.funcCode == "R" ) THEN
				MTT.PartTranDetails.Remarks         =       "Additional Adv. Rent Credit"
				MTT.PartTranDetails.Particulars     =       MTT.InputDetails.foracid + " : Payoff reversal Additional Adv. Rent Credit"
			ENDIF
			
			sv_z = urhk_MTTS_DefinePartTran("ADDADVDR")
			
			MTT.PartTranDetails.Account                 =       MTT.InputDetails.LoanIntAcct
			MTT.PartTranDetails.Particulars             =       MTT.InputDetails.LoanIntAcct+":Cr LoanProfit from AddAdvRent"
			MTT.PartTranDetails.RefCurrency             =       MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode                =       ""
			IF ( MTT.InputDetails.funcCode == "R" ) THEN
				MTT.PartTranDetails.RefAmount           =       -sv_C
			ELSE
				MTT.PartTranDetails.RefAmount           =       sv_C
			ENDIF
			MTT.PartTranDetails.ValueDate               =       MTT.InputDetails.valueDate
			MTT.PartTranDetails.TreaRefNum              =       ""
			
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_z=urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_z==0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.EntryUserId             =       MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime               =       MTT.InputDetails.EntryTime
			MTT.PartTranDetails.ACPARTB2kType           =       "ACCNT"
			MTT.PartTranDetails.ACPARTB2kId             =       MTT.InputDetails.foracid
			MTT.PartTranDetails.TranIdentifier          =       "poff"
			MTT.PartTranDetails.PTranBusinessType       =       "ADDADVCR"
			MTT.PartTranDetails.Consolidate             =       "N"
			MTT.PartTranDetails.Remarks                 =       "Cr LoanProfit from AddAdvRent"
			MTT.LAAddnlDetails.DemandFlowId             =   MTT.InputDetails.transferFlowId
			MTT.LAAddnlDetails.OriginOfTran             =   "POFF"
			MTT.LAAddnlDetails.DemandSatisfyFlg         =   "N"
			MTT.LAAddnlDetails.LoanAcctId               =   MTT.InputDetails.foracid
			MTT.LAAddnlDetails.AdvancePaymentFlg        =   "N"
			IF ( MTT.InputDetails.funcCode == "R" ) THEN
				MTT.PartTranDetails.Particulars         =   MTT.InputDetails.LoanIntAcct+":Dr LoanProfit to AddAdvRent"
				MTT.PartTranDetails.ScriptEventType     =   "LATPA"
				sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				IF (sv_z == 0) THEN
					CALL("getMTTTranPart.scr")
				ENDIF
				MTT.PartTranDetails.Remarks             =   "Dr LoanProfit to AddAdvRent"
				MTT.LAAddnlDetails.ReversalTranId       =   MTT.InputDetails.reversalTranId
				MTT.LAAddnlDetails.ReversalTranDate     =   MTT.InputDetails.reversalTranDate
				MTT.LAAddnlDetails.ReversalPtranSrlNum  =   MTT.InputDetails.AddAdvRentRevPrtSrlNum
				MTT.LAAddnlDetails.PrincipalAmt         =   "0"
				MTT.LAAddnlDetails.InterestAmt          =   "0"
				MTT.LAAddnlDetails.BankChrgAmt          =   "0"
				MTT.LAAddnlDetails.OtherChrgAmt         =   "0"
			ENDIF
			sv_z = urhk_MTTS_DefineLoanPartTran("ADDADVCR")
		ENDIF
	ENDIF
	
	sv_g = 0
	sv_g = CDOUBLE(MTT.InputDetails.rebateBenefitAmt)
	sv_w = CDOUBLE(MTT.InputDetails.actualAdvIntRefundAmt)
	sv_v = CDOUBLE(MTT.InputDetails.securityAmt)
	sv_X = 0
	sv_Y = 0
	IF(FIELDEXISTS(MTT.InputDetails.pendFee)) THEN
		sv_X = CDOUBLE(MTT.InputDetails.pendFee)
		sv_Y = CDOUBLE(MTT.InputDetails.prepayFee)
	ENDIF
	IF((MTT.InputDetails.isMURTAWFlg == "Y")  AND  (MTT.InputDetails.isISTISNAFlg=="N") AND (MTT.InputDetails.cpOvrFlg != "Y")) THEN
		sv_g = 0
	ENDIF
	IF(MTT.InputDetails.funcCode == "R") THEN
		sv_w = -sv_w
		sv_g = -sv_g
	ENDIF
	
	IF(MTT.InputDetails.funcCode == "R") THEN
		MTT.PartTranDetails.sysPartTranCode ="PTRN02718"
	ELSE
		MTT.PartTranDetails.sysPartTranCode ="PTRN02719"
	ENDIF
	
	IF(MTT.InputDetails.advIntRefundFlg=="Y") THEN
		sv_t = sv_p-sv_w-sv_d-sv_g
	ELSE
		sv_t = sv_p-sv_d-sv_g
	ENDIF
	IF((MTT.InputDetails.int_route_flg == "O") AND (MTT.InputDetails.unEarnIncFlg == "Y"))THEN
		IF((MTT.InputDetails.isMURTAWFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "Y")) THEN
			sv_t = sv_p-sv_d
		ELSE
			sv_t = sv_p-sv_d-sv_g
		ENDIF
	ENDIF
	IF((MTT.InputDetails.int_route_flg == "L") AND (MTT.InputDetails.unEarnIncFlg == "Y"))THEN
		sv_t = sv_a-sv_d-sv_i-sv_g - sv_X - sv_Y
	ENDIF
	IF(MTT.InputDetails.entityType == "F") THEN
		IF((MTT.InputDetails.funcCode== "P") AND (MTT.InputDetails.typeOfPyoff == "T")) THEN
			sv_t = sv_t + sv_v
		ENDIF
		IF((MTT.InputDetails.funcCode == "R")  AND (MTT.InputDetails.typeOfPyoff == "T")) THEN
			sv_t = sv_t - sv_v
		ENDIF
	ENDIF
	IF((MTT.InputDetails.advIntRefundFlg=="Y")  AND (MTT.InputDetails.unEarnIncFlg == "Y") AND (MTT.InputDetails.isMURTAWFlg == "Y")  AND (MTT.InputDetails.isISTISNAFlg=="N") AND (MTT.InputDetails.int_route_flg == "L")) THEN
		sv_t = sv_t - sv_w
	ENDIF
	
	IF(sv_t != 0) THEN
		IF( (sv_t != 0) AND (MTT.InputDetails.isIjarahFlg=="Y") ) THEN
			sv_t = 0
		ENDIF
		MTT.PartTranDetails.Account=MTT.InputDetails.foracid
		MTT.PartTranDetails.RefAmount=sv_t
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff -Loan Account "
		IF((MTT.InputDetails.entityType == "F") OR (MTT.InputDetails.entityType == "O") OR (MTT.InputDetails.entityType == "I")) THEN
			IF(MTT.InputDetails.typeOfPyoff == "T") THEN
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Termination - Termination amount "
			ENDIF
		ENDIF
		MTT.PartTranDetails.ScriptEventType = "LATPA"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
			CALL("getMTTTranPart.scr")
		ENDIF
		#new code start
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			CALL("PayOffIntRateCal.scr")
		#}
		ENDIF
		#new code end
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Remarks="Credit Loan Account "
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="poff"
		MTT.PartTranDetails.PTranBusinessType="LOAN2"
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
		MTT.LAAddnlDetails.LoanAcctId = ""
		MTT.LAAddnlDetails.AdvancePaymentFlg ="Y"
		MTT.LAAddnlDetails.OriginOfTran = "POFF"
		MTT.LAAddnlDetails.intRefundPrePymntFlg=MTT.InputDetails.advIntRefundFlg
		MTT.LAAddnlDetails.DemandSatisfyFlg = "N"
		IF ( MTT.InputDetails.funcCode == "R" ) THEN
			MTT.PartTranDetails.Particulars = "Loan Payoff Reversal For :" + MTT.InputDetails.foracid
			MTT.PartTranDetails.Refnum = "PYOFRVSL"
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.reversalTranId
			MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.reversalTranDate
			MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.loanRevPartTranNum2
			MTT.LAAddnlDetails.PrincipalAmt = "0"
			MTT.LAAddnlDetails.InterestAmt  = "0"
			MTT.LAAddnlDetails.BankChrgAmt  = "0"
			MTT.LAAddnlDetails.OtherChrgAmt = "0"
		ENDIF
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		sv_z = urhk_MTTS_DefinePartTran("LOAN_CREDIT_PTRAN")
	ENDIF
	IF(MTT.InputDetails.int_route_flg == "O") THEN
		IF ((MTT.InputDetails.unEarnIncFlg == "Y") AND (MTT.InputDetails.isISTISNAFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "N")) THEN
			sv_B = CDOUBLE(MTT.InputDetails.plAdvIntRefundAdjAmt)
			IF(MTT.InputDetails.funcCode == "R") THEN
				sv_i = -(sv_B) + sv_i
			ELSE
				sv_i = sv_B + sv_i
			ENDIF
		ENDIF
		
		IF( (sv_i != 0) AND (MTT.InputDetails.isIjarahFlg=="Y") ) THEN
			sv_i = 0
		ENDIF
		
		IF(((sv_i > 0) AND (MTT.InputDetails.funcCode == "P")) OR ((sv_i <0) AND (MTT.InputDetails.funcCode == "R")) OR (CDOUBLE(MTT.InputDetails.outUEI) > 0)) THEN
			MTT.PartTranDetails.Account=MTT.InputDetails.officeAcct
			IF((MTT.InputDetails.isMURTAWFlg == "Y")  AND  (MTT.InputDetails.cpOvrFlg == "Y") ) THEN
				sv_w = CDOUBLE(MTT.InputDetails.actualAdvIntRefundAmt)
				IF(MTT.InputDetails.funcCode == "R") THEN
					sv_g = -(sv_g) + CDOUBLE(MTT.InputDetails.outUEI) - sv_w
					MTT.PartTranDetails.RefAmount=-(-sv_i+sv_g+CDOUBLE(MTT.InputDetails.emiDeferredInterest)+CDOUBLE(MTT.InputDetails.deferredIntAmt))
				ELSE
					sv_g = sv_g + CDOUBLE(MTT.InputDetails.outUEI) - sv_w
					MTT.PartTranDetails.RefAmount=sv_i+sv_g+CDOUBLE(MTT.InputDetails.emiDeferredInterest)+CDOUBLE(MTT.InputDetails.deferredIntAmt)
				ENDIF
			ELSE
				MTT.PartTranDetails.RefAmount=sv_i+CDOUBLE(MTT.InputDetails.emiDeferredInterest)
			ENDIF
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff Int collection"
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
