			MTT.LAAddnlDetails.BankChrgAmt  = sv_b
			MTT.LAAddnlDetails.OtherChrgAmt = sv_o
			MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
			MTT.LAAddnlDetails.OriginOfTran = "POFF"
			MTT.LAAddnlDetails.AdvancePaymentFlg="N"
