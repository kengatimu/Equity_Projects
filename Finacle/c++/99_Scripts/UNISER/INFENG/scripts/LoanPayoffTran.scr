				MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.loanIntRevPartTranNum2
				MTT.LAAddnlDetails.PrincipalAmt = "0"
				MTT.LAAddnlDetails.InterestAmt  = "0"
