				MTT.PartTranDetails.Particulars=MTT.InputDetails.securityAmtAcct + " -Security amt Dr. Reversal"
				MTT.PartTranDetails.Remarks="Cr Security Deposit Placeholder"
				MTT.PartTranDetails.sysPartTranCode = "PTRN03891"
			ELSE
				MTT.PartTranDetails.RefAmount=-sv_w
				MTT.PartTranDetails.Particulars=MTT.InputDetails.securityAmtAcct + " - Security amount Debit"
				MTT.PartTranDetails.Remarks="Dr Security Deposit Placeholder"
				MTT.PartTranDetails.sysPartTranCode = "PTRN03892"
			ENDIF
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("SRC_DEBIT_PTRAN")
		ENDIF
	ENDIF
	sv_m = ""
	IF(MTT.InputDetails.isIjarahFlg=="Y") THEN
		sv_w = CDOUBLE(MTT.InputDetails.securityAmt)
		IF(sv_w>0) THEN
			MTT.PartTranDetails.Account=MTT.InputDetails.foracid
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.TreaRefNum = ""
			IF(MTT.InputDetails.funcCode == "R") THEN
				MTT.PartTranDetails.RefAmount=-sv_w
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " -Security amt Cr. Reversal"
				MTT.PartTranDetails.Remarks="Dr Security Amt from Loan Acct"
				MTT.PartTranDetails.sysPartTranCode = "PTRN03893"
			ELSE
				MTT.PartTranDetails.RefAmount=sv_w
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Security amount Credit"
				MTT.PartTranDetails.Remarks="Cr Security Amt to Loan Acct"
				MTT.PartTranDetails.sysPartTranCode = "PTRN03894"
			ENDIF
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			IF ( MTT.InputDetails.funcCode == "R" ) THEN
				MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.reversalTranId
				MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.reversalTranDate
				MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.loanRevPartTranNumSd
			ENDIF
			sv_z = urhk_MTTS_DefinePartTran("LOAN_CREDIT_PTRAN")
		ENDIF
	ENDIF
	IF(( MTT.InputDetails.entityType == "F") OR (MTT.InputDetails.entityType == "O") OR (MTT.InputDetails.entityType == "I")) THEN
		sv_m = urhk_getFileLocation("SCRIPT|LeasePayoffTran.scr")
		IF( sv_m == 0 )THEN
			CALL("LeasePayoffTran.scr")
		ENDIF
	ENDIF
	CANCELFEE:
		sv_t = 0
		sv_r = urhk_MTTS_PopulateInputDetails("")
		sv_f = "T"
		WHILE ((sv_r < 1) AND (sv_f == "T"))
			IF(MTT.InputDetails.subsidy_avl_flg == "Y") THEN
				sv_f = "T"
				sv_w = CDOUBLE(MTT.InputDetails.subsidyDmdAmt)
				MTT.PartTranDetails.Account=MTT.InputDetails.subsidyRecvForacid
				IF(MTT.InputDetails.funcCode == "R") THEN
					MTT.PartTranDetails.RefAmount = sv_w
					MTT.PartTranDetails.sysPartTranCode ="PTRN02759"
				ELSE
					MTT.PartTranDetails.RefAmount = -sv_w
					MTT.PartTranDetails.sysPartTranCode ="PTRN02760"
				ENDIF
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
				MTT.PartTranDetails.RateCode = ""
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Subsidy Recv. Amount"
				MTT.PartTranDetails.ScriptEventType = "LATPA"
				sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				IF (sv_m == 0) THEN
					CALL("getMTTTranPart.scr")
				ENDIF
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
				MTT.PartTranDetails.Remarks="Subsidy Interest PartTran -Payoff"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="poff"
				MTT.PartTranDetails.PTranBusinessType="LOANS"
				MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
				MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
				sv_t = sv_t + sv_w
				sv_z = urhk_MTTS_DefinePartTran("NORMAL_PL_DEBIT")
			ELSE
				sv_f = "F"
			ENDIF
			sv_r = urhk_MTTS_PopulateInputDetails("")
		DO
		IF(sv_t != 0) THEN
			MTT.PartTranDetails.Account=MTT.InputDetails.normal_pandl_acct
			IF(MTT.InputDetails.funcCode == "R") THEN
				MTT.PartTranDetails.RefAmount=-sv_t
				MTT.PartTranDetails.sysPartTranCode ="PTRN02761"
			ELSE
				MTT.PartTranDetails.RefAmount=sv_t
				MTT.PartTranDetails.sysPartTranCode ="PTRN02762"
			ENDIF
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + " - Payoff Subsidy Book Adj to PandL a/c"
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Remarks="Subsidy Int book -Payoff"
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("INT_BOOK")
		ENDIF
		sv_t = 0
		sv_f = "T"
		WHILE ((sv_r < 1) AND (sv_f == "T"))
			IF(MTT.InputDetails.clawback_avl_flg == "Y") THEN
				sv_f = "T"
				sv_l = CDOUBLE(MTT.InputDetails.usrCalcClawBkAmt)
				MTT.PartTranDetails.Account=MTT.InputDetails.clawBkCreditAccount
				IF(MTT.InputDetails.funcCode == "R") THEN
					MTT.PartTranDetails.RefAmount=-sv_l
					MTT.PartTranDetails.sysPartTranCode ="PTRN02763"
				ELSE
					MTT.PartTranDetails.RefAmount=sv_l
					MTT.PartTranDetails.sysPartTranCode ="PTRN02764"
				ENDIF
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.clawBkCreditCrncy
				MTT.PartTranDetails.RateCode = ""
				IF (MTT.InputDetails.funcCode != "R") THEN
					MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid+" - Claw Back Collection during Payoff"
				ELSE
					MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid+" - Claw Back Reversal"
				ENDIF
				MTT.PartTranDetails.ScriptEventType = "LATPA"
				sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				IF (sv_m == 0) THEN
					CALL("getMTTTranPart.scr")
				ENDIF
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="poff"
				MTT.PartTranDetails.PTranBusinessType="LOANS"
				MTT.ChargeDetails.EventType = MTT.InputDetails.rebateType
				MTT.ChargeDetails.EventId = MTT.InputDetails.clawBkEventId
				sv_x = CDOUBLE(MTT.InputDetails.sysCalcClawBkAmt)
				MTT.ChargeDetails.CalculatedAmount = sv_x
				MTT.ChargeDetails.ActualAmount = sv_l
				MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.clawBkCreditCrncy
				MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.clawBkCifId
				MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.foracid
				MTT.ChargeDetails.RecordType  = "R"
				MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
				MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
				sv_z = urhk_MTTS_DefineChargePartTran("CLWCR")
			ELSE
				sv_f = "F"
			ENDIF
			sv_r = urhk_MTTS_PopulateInputDetails("")
		DO
		sv_S = CDOUBLE(MTT.InputDetails.payoffAmt)
		IF(MTT.InputDetails.synDistApplFlg == "Y") THEN
			MTT.PartTranDetails.Account=MTT.InputDetails.synContingentAccount
			MTT.PartTranDetails.RefAmount=-sv_S
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = ""
			IF (MTT.InputDetails.funcCode != "R") THEN
				MTT.PartTranDetails.Particulars="Syndication contingent account debit"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02765"
			ELSE
				MTT.PartTranDetails.Particulars="Syndication contingent account credit"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02766"
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="SYND"
			
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("SYNCONDR")
			MTT.PartTranDetails.Account=MTT.InputDetails.synParkingAccount
			MTT.PartTranDetails.RefAmount=sv_S
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = ""
			IF (MTT.InputDetails.funcCode != "R") THEN
				MTT.PartTranDetails.Particulars="Syndication parking account credit"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02767"
			ELSE
				MTT.PartTranDetails.Particulars="Syndication parking account debit"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02768"
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="SYND"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("SYNPARCR")
		ENDIF
		IF(sv_r >= 1) THEN
			sv_z = urhk_MTTS_EndDefinition("")
			EXITSCRIPT
		ENDIF
		sv_l = CDOUBLE(MTT.InputDetails.totCollAmt)
		IF(sv_l == 0) THEN
			sv_z = urhk_MTTS_EndDefinition("")
			EXITSCRIPT
		ENDIF
		sv_a=MTT.InputDetails.chargeCreditCrncy
		sv_b=MTT.InputDetails.tranCrncy
		IF(sv_a!=sv_b) THEN
			MTT.PartTranDetails.Account=MTT.InputDetails.consolAcct
			MTT.PartTranDetails.RefAmount=-sv_l
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
			MTT.PartTranDetails.RateCode = MTT.InputDetails.chrgRateCode
			MTT.PartTranDetails.Rate = MTT.InputDetails.chrgRate
			MTT.PartTranDetails.TreaRate = MTT.InputDetails.chrgTreaRate
			MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.chrgTreaRefNum
			IF (MTT.InputDetails.funcCode != "R") THEN
				MTT.PartTranDetails.Particulars="Parking account debit for loan fee collection"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02769"
			ELSE
				MTT.PartTranDetails.Particulars="Parking account credit for loan fee reversal"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02770"
			ENDIF
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LAFEECOLL"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("FEEPARKDR")
			BANCS.INPARAM.InputAmount=sv_l
			BANCS.INPARAM.FromCurrency=MTT.InputDetails.chargeCreditCrncy
			BANCS.INPARAM.ToCurrency=MTT.InputDetails.tranCrncy
			BANCS.INPARAM.RateCode=MTT.InputDetails.chrgRateCode
			BANCS.INPARAM.Rate=MTT.InputDetails.chrgRate
			sv_y=urhk_B2k_ConvertAmount("")
			sv_l= CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			MTT.PartTranDetails.Account=MTT.InputDetails.consolAcct
			MTT.PartTranDetails.RefAmount=sv_l
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = ""
			#new code start
			IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
			#{
				CALL("PayOffIntRateCal.scr")
			#}
			ENDIF
			#new code end
			IF (MTT.InputDetails.funcCode != "R") THEN
				MTT.PartTranDetails.Particulars="Parking account credit for loan fee collection"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02771"
			ELSE
				MTT.PartTranDetails.Particulars="Parking account debit for loan fee reversal"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02772"
			ENDIF
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LAFEECOLL"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("FEEPARKCR")
		ENDIF
		sv_l=CDOUBLE(MTT.InputDetails.chargeCreditAmt)
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeCreditAccount
		MTT.PartTranDetails.RefAmount=sv_l
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
		MTT.PartTranDetails.RateCode = ""
		#new code start
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			CALL("PayOffIntRateCal.scr")
		#}
		ENDIF
		#new code end
		IF (MTT.InputDetails.funcCode != "R") THEN
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid+" - Fee Collection during Payoff"
			MTT.PartTranDetails.sysPartTranCode ="PTRN02773"
		ELSE
			MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid+" - Fee Reversal"
			MTT.PartTranDetails.sysPartTranCode ="PTRN02774"
		ENDIF
		MTT.PartTranDetails.ScriptEventType = "LATPA"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
			CALL("getMTTTranPart.scr")
		ENDIF
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="poff"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.ChargeDetails.EventType = MTT.InputDetails.eventType
		MTT.ChargeDetails.EventId = MTT.InputDetails.eventId
		MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
		IF(FIELDEXISTS(MTT.InputDetails.PtranBusType)) THEN
			MTT.ChargeDetails.PtranBusType = MTT.InputDetails.PtranBusType
		ENDIF
		sv_x = CDOUBLE(MTT.InputDetails.calcAmt)
		MTT.ChargeDetails.CalculatedAmount = sv_x
		MTT.ChargeDetails.ActualAmount = sv_l
		MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.chargeCreditCrncy
		MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
		MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.foracid
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		IF (MTT.ChargeDetails.EventType == "LNKED") THEN
			sv_j = MTT.InputDetails.foracid+" "+LTRIM(RTRIM(MID$(MTT.InputDetails.tranParticulars,0,32)))
			MTT.PartTranDetails.Particulars=sv_j
		ENDIF
		sv_z = urhk_MTTS_DefineChargePartTran("FEECR")
		sv_r = urhk_MTTS_PopulateInputDetails("")
		sv_c =0
		sv_c = sv_l
		WHILE (sv_r < 1)
			sv_l = CDOUBLE(MTT.InputDetails.chargeCreditAmt)
			MTT.PartTranDetails.Account=MTT.InputDetails.chargeCreditAccount
			sv_c= sv_c+sv_l
			MTT.PartTranDetails.RefAmount=sv_l
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
			MTT.PartTranDetails.RateCode = ""
			#new code start
			IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
			#{
				CALL("PayOffIntRateCal.scr")
			#}
			ENDIF
			#new code end
			IF (MTT.InputDetails.funcCode != "R") THEN
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid+" - Fee Collection Credit during Payoff"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02773"
			ELSE
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid+" - Fee Credit Reversal"
				MTT.PartTranDetails.sysPartTranCode ="PTRN02774"
			ENDIF
			MTT.PartTranDetails.ScriptEventType = "LATPA"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
				CALL("getMTTTranPart.scr")
			ENDIF
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.ChargeDetails.EventType = MTT.InputDetails.eventType
			MTT.ChargeDetails.EventId = MTT.InputDetails.eventId
			MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
			IF(FIELDEXISTS(MTT.InputDetails.PtranBusType)) THEN
				MTT.ChargeDetails.PtranBusType = MTT.InputDetails.PtranBusType
			ENDIF
			sv_x = CDOUBLE(MTT.InputDetails.calcAmt)
			MTT.ChargeDetails.CalculatedAmount = sv_x
			MTT.ChargeDetails.ActualAmount = sv_l
			MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.chargeCreditCrncy
			MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
			MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.foracid
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			IF (MTT.ChargeDetails.EventType == "LNKED") THEN
				sv_j = MTT.InputDetails.foracid+" "+LTRIM(RTRIM(MID$(MTT.InputDetails.tranParticulars,0,32)))
				MTT.PartTranDetails.Particulars=sv_j
			ENDIF
			sv_z = urhk_MTTS_DefineChargePartTran("FEECR")
			sv_r = urhk_MTTS_PopulateInputDetails("")
		DO
		IF((MTT.InputDetails.entityType == "F") OR (MTT.InputDetails.entityType =="O") OR (MTT.InputDetails.entityType == "I")) THEN
			IF(MTT.InputDetails.typeOfPyoff == "C") THEN
				sv_m=MTT.InputDetails.tranCrncy
				sv_g=MTT.InputDetails.source_acct_crncy
				MTT.PartTranDetails.Account=MTT.InputDetails.source_acct_num
				MTT.PartTranDetails.RefAmount=-sv_c
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
				IF(MTT.InputDetails.TranType == "C") THEN
					IF(MTT.InputDetails.TranSubType == "CI") THEN
						IF(MTT.InputDetails.funcCode != "R") THEN
							MTT.PartTranDetails.InstrmntType = MTT.InputDetails.instrmntType
							IF(MTT.InputDetails.instrmntDate !="") THEN
								BANCS.INPARAM.date1 = MID$(MTT.InputDetails.instrmntDate,0,10)
								BANCS.INPARAM.date2 = MID$(BANCS.STDIN.BODDate,0,10)
								sv_r = urhk_B2k_dateDiff("")
								MTT.PartTranDetails.InstrmntDate=BANCS.OUTPARAM.dateDiff
							ENDIF
							MTT.PartTranDetails.InstrmntNum = MTT.InputDetails.instrmntNum
							MTT.PartTranDetails.InstrmntAlpha = MTT.InputDetails.instrmntAlpha
						ENDIF
					ENDIF
				ENDIF
				IF (sv_m != sv_g) THEN
					MTT.PartTranDetails.RateCode = MTT.InputDetails.tranRateCode
					MTT.PartTranDetails.Rate = MTT.InputDetails.tranRate
					MTT.PartTranDetails.TreaRate = MTT.InputDetails.tranTreaRate
					MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.tranTreaRefNum
				ELSE
					MTT.PartTranDetails.RateCode = ""
					MTT.PartTranDetails.TreaRefNum = ""
				ENDIF
				MTT.PartTranDetails.Particulars=MTT.InputDetails.source_acct_num + " - Payoff Source a/c"
				MTT.PartTranDetails.ScriptEventType = "LATPA"
				sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				IF (sv_m == 0) THEN
					CALL("getMTTTranPart.scr")
				ENDIF
				IF((MTT.InputDetails.TranType == "T") AND (MTT.InputDetails.OAPSchmTypeFlg != "Y")) THEN
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
				ENDIF
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
				MTT.PartTranDetails.Remarks="Debit Source Account"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="poff"
				MTT.PartTranDetails.PTranBusinessType="LOANS"
				IF(MTT.InputDetails.OAPSchmTypeFlg == "Y") THEN
					MTT.PartTranDetails.Refnum=MTT.InputDetails.refNum
					MTT.OAPAddnlDetails.OffsetAmount = sv_l
					MTT.OAPAddnlDetails.OrgTranID = MTT.InputDetails.OAPTranId
					MTT.OAPAddnlDetails.OrgTranDate = MTT.InputDetails.OAPTranDate
					MTT.OAPAddnlDetails.OrgPartTran = MTT.InputDetails.OAPPTranSrlNum
				ENDIF
				MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
				MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
				MTT.PartTranDetails.svsTranId=MTT.InputDetails.svsTranId
				sv_z = urhk_MTTS_DefinePartTran("SRC_DEBIT_PTRAN")
			ENDIF
		ENDIF
		sv_z = urhk_MTTS_EndDefinition("")
END-->