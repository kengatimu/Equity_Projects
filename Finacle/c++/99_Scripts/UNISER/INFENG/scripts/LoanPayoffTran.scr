		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		sv_z = urhk_MTTS_DefinePartTran("LOAN_PAYMENT")
	ENDIF
	IF(MTT.InputDetails.pd_flg == "Y" ) THEN
