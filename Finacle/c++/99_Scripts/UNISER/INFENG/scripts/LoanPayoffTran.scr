					MTT.OAPAddnlDetails.OrgTranID = MTT.InputDetails.OAPTranId
					MTT.OAPAddnlDetails.OrgTranDate = MTT.InputDetails.OAPTranDate
					MTT.OAPAddnlDetails.OrgPartTran = MTT.InputDetails.OAPPTranSrlNum
				ENDIF
			ENDIF
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("REFUND AMOUNT")
		ENDIF
	ENDIF
	sv_B = ""
	sv_A = ""
