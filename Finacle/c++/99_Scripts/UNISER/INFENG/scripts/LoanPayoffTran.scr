					IF ((MTT.InputDetails.unEarnIncFlg == "Y") AND (MTT.InputDetails.isISTISNAFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "N")) THEN
						IF(MTT.InputDetails.spUEIPayoff == "N") THEN
							MTT.PartTranDetails.RefAmount=(sv_A + CDOUBLE(MTT.InputDetails.spUEI))
						ELSE
							MTT.PartTranDetails.RefAmount=sv_A
						ENDIF
					ELSE
						IF((MTT.InputDetails.isMURTAWFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "Y")) THEN
							MTT.PartTranDetails.RefAmount=sv_A
						ELSE
							MTT.PartTranDetails.RefAmount=(sv_A + CDOUBLE(MTT.InputDetails.plAdvIntRefundAdjAmt))
						ENDIF
					ENDIF
					MTT.LAAddnlDetails.TypeOfDemand = "T"
					MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
					MTT.LAAddnlDetails.DemandSatisfyFlg="N"
					MTT.LAAddnlDetails.AdvancePaymentFlg ="Y"
					MTT.LAAddnlDetails.LoanAcctId=MTT.InputDetails.foracid
					MTT.LAAddnlDetails.OriginOfTran = "POFF"
					MTT.LAAddnlDetails.intRefundPrePymntFlg=MTT.InputDetails.advIntRefundFlg
					MTT.PartTranDetails.PTranBusinessType="UNERN"
					IF(MTT.InputDetails.funcCode == "R") THEN
						IF ((MTT.InputDetails.unEarnIncFlg == "Y") AND (MTT.InputDetails.isISTISNAFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "N")) THEN
							IF(MTT.InputDetails.spUEIPayoff == "N") THEN
								MTT.PartTranDetails.RefAmount=(sv_A - CDOUBLE(MTT.InputDetails.spUEI))
							ELSE
								MTT.PartTranDetails.RefAmount=sv_A
							ENDIF
						ELSE
							IF((MTT.InputDetails.isMURTAWFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "Y")) THEN
								MTT.PartTranDetails.RefAmount=sv_A
							ELSE
								MTT.PartTranDetails.RefAmount=(sv_A - CDOUBLE(MTT.InputDetails.plAdvIntRefundAdjAmt))
							ENDIF
						ENDIF
						MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.reversalTranId
						MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.reversalTranDate
						MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.loanIntRevPartTranNum11
						MTT.LAAddnlDetails.PrincipalAmt = "0"
						MTT.LAAddnlDetails.InterestAmt  = "0"
						MTT.LAAddnlDetails.BankChrgAmt  = "0"
						MTT.LAAddnlDetails.OtherChrgAmt = "0"
					ENDIF
				ENDIF
				lv_d = CDOUBLE(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + "- Advance Int Refund"
				MTT.PartTranDetails.ScriptEventType = "LATPA"
