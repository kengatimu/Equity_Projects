			ENDIF
			#new code start
			IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
			#{
				CALL("PayOffIntRateCal.scr")
			#}
			ENDIF
			#new code end
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Remarks="Credit Office Account for interest pending "
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="poff"
			MTT.PartTranDetails.PTranBusinessType="OFF10"
			MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.foracid
			MTT.LAAddnlDetails.TypeOfDemand = "I"
			MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
			MTT.LAAddnlDetails.OriginOfTran = "POFF"
			MTT.LAAddnlDetails.intRefundPrePymntFlg=MTT.InputDetails.advIntRefundFlg
			MTT.LAAddnlDetails.AdvancePaymentFlg ="N"
			MTT.LAAddnlDetails.DemandSatisfyFlg = "Y"
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.foracid
			MTT.PartTranDetails.ACPARTB2kType="ACCNT"
			MTT.PartTranDetails.sysPartTranCode ="PTRN02720"
			
			IF ( MTT.InputDetails.funcCode == "R" ) THEN
				MTT.PartTranDetails.Particulars = "Loan Payoff Reversal For :" + MTT.InputDetails.foracid
				MTT.PartTranDetails.sysPartTranCode ="PTRN02721"
				
				MTT.PartTranDetails.Refnum = "PYOFRVSL"
				MTT.PartTranDetails.ScriptEventType = "LATPA"
				sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				IF (sv_m == 0) THEN
					CALL("getMTTTranPart.scr")
				ENDIF
				MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.reversalTranId
				MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.reversalTranDate
				MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.loanIntRevPartTranNum10
				MTT.LAAddnlDetails.PrincipalAmt = "0"
				MTT.LAAddnlDetails.InterestAmt  = "0"
				MTT.LAAddnlDetails.BankChrgAmt  = "0"
				MTT.LAAddnlDetails.OtherChrgAmt = "0"
			ENDIF
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			sv_z = urhk_MTTS_DefinePartTran("OFFICE_CREDIT_PTRAN")
		ENDIF
	ENDIF
	sv_b = CDOUBLE(MTT.InputDetails.bankChargeAmount)
	sv_y=sv_b+sv_o
	IF(MTT.InputDetails.chrg_route_flg == "O") THEN
		IF(((sv_y > 0) AND (MTT.InputDetails.funcCode == "P")) OR ((sv_y < 0) AND (MTT.InputDetails.funcCode == "R"))) THEN
