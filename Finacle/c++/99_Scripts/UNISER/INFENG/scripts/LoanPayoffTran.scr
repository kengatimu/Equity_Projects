					CALL("getMTTTranPart.scr")
				ENDIF
				IF((MTT.InputDetails.TranType == "T") AND (MTT.InputDetails.OAPSchmTypeFlg != "Y")) THEN
					MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
				ENDIF
				MTT.PartTranDetails.Remarks="credit source Account"
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="poff"
				MTT.PartTranDetails.PTranBusinessType="LOANS"
				IF((MTT.InputDetails.int_route_flg == "O") AND (MTT.InputDetails.unEarnIncFlg == "Y")) THEN
					MTT.PartTranDetails.PTranBusinessType="UNERN"
				ENDIF
				MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
				MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
				sv_z = urhk_MTTS_DefinePartTran("REFUND AMOUNT")
				sv_m = ""
				sv_g = CDOUBLE(MTT.InputDetails.rebateBenefitAmt)
				MTT.PartTranDetails.Account=MTT.InputDetails.normal_pandl_acct
				IF (MTT.InputDetails.unEarnIncFlg == "Y") THEN
					IF ((MTT.InputDetails.isISTISNAFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "N")) THEN
						IF(MTT.InputDetails.funcCode == "R") THEN
							MTT.PartTranDetails.RefAmount = -(sv_g+CDOUBLE(MTT.InputDetails.outUEI)+CDOUBLE(MTT.InputDetails.tranInterestAmount)-CDOUBLE(MTT.InputDetails.actualAdvIntRefundAmt))
						ELSE
							MTT.PartTranDetails.RefAmount = sv_g+CDOUBLE(MTT.InputDetails.outUEI)+CDOUBLE(MTT.InputDetails.tranInterestAmount)-CDOUBLE(MTT.InputDetails.actualAdvIntRefundAmt)
						ENDIF
					ELSE
						MTT.PartTranDetails.RefAmount= -(lv_c + lv_d)
					ENDIF
				ELSE
					MTT.PartTranDetails.RefAmount= sv_B
				ENDIF
				IF ((MTT.InputDetails.unEarnIncFlg == "Y") AND (MTT.InputDetails.isISTISNAFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "N")) THEN
					IF(MTT.InputDetails.funcCode == "R") THEN
						MTT.PartTranDetails.RefAmount = -(CDOUBLE(MTT.InputDetails.outUEI))
					ELSE
						MTT.PartTranDetails.RefAmount = CDOUBLE(MTT.InputDetails.outUEI)
					ENDIF
				ENDIF
				
				MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
				MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
				MTT.PartTranDetails.Particulars=MTT.InputDetails.foracid + "- Normal P&L Account"
				
				IF(MTT.InputDetails.funcCode == "R") THEN
					MTT.PartTranDetails.sysPartTranCode ="PTRN02755"
				ELSE
					MTT.PartTranDetails.sysPartTranCode ="PTRN02756"
				ENDIF
				
				MTT.PartTranDetails.ScriptEventType = "LATPA"
				sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
				IF (sv_m == 0) THEN
					CALL("getMTTTranPart.scr")
				ENDIF
				MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
				MTT.PartTranDetails.Consolidate="N"
				MTT.PartTranDetails.TranIdentifier="poff"
				IF ((MTT.InputDetails.unEarnIncFlg == "Y") AND (MTT.InputDetails.isISTISNAFlg == "Y") AND (MTT.InputDetails.cpOvrFlg == "N")) THEN
					MTT.PartTranDetails.PTranBusinessType="UNERN"
				ELSE
					MTT.PartTranDetails.PTranBusinessType="LOANS"
				ENDIF
				IF(MTT.InputDetails.OAPSchmTypeFlg == "Y") THEN
					MTT.PartTranDetails.Refnum=MTT.InputDetails.refNum
