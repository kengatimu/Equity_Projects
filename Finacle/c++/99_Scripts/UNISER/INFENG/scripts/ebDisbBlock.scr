#++++++++++++++++++++++++++++++++++++++
#FileName	: ebDisbBlock.scr 
#Author	: Vino Palani
#Date	: 05Jul2019
#Desc	: disb block
#++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Rep/Class
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
	EQSRV.GLBDATA.laSchmCode = ""
	EQSRV.GLBDATA.laAcctId = ""
	EQSRV.GLBDATA.disbCifId = ""
	EQSRV.GLBDATA.disbCnt = ""
#srv
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	EQSRV.GLBDATA.laAcctId=BANCS.OUTPARAM.srvValue
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.acid")
	EQSRV.GLBDATA.laAcid=BANCS.OUTPARAM.srvValue
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.schmCode.schmCode")
	EQSRV.GLBDATA.laSchmCode=BANCS.OUTPARAM.srvValue
	if(EQSRV.GLBDATA.laSchmCode=="FL527")then
		sv_d = "disbCifId,disbCnt | "
		sv_d = sv_d + " select cif_id,count(gam.cif_id) "
		sv_d = sv_d + " from tbaadm.gam,tbaadm.lam  "
		sv_d = sv_d + " where gam.bank_id=?SVAR "
		sv_d = sv_d + " and lam.bank_id=?SVAR "
		sv_d = sv_d + " and gam.acid=lam.acid "
		sv_d = sv_d + " and gam.acct_cls_flg<>'Y' "
		sv_d = sv_d + " and gam.acct_cls_date is null "
		sv_d = sv_d + " and gam.entity_cre_flg='Y' "
		sv_d = sv_d + " and gam.del_flg='N' "
		sv_d = sv_d + " and gam.schm_code='FL527' "
		sv_d = sv_d + " and lam.entity_cre_flg='Y'  "
		sv_d = sv_d + " and lam.del_flg='N' "
		sv_d = sv_d + " and lam.final_disb_flg='Y' "
		sv_d = sv_d + " and gam.cif_id in (select cif_id from tbaadm.gam where acid='"+EQSRV.GLBDATA.laAcid+"' and bank_id='99' ) " 
		sv_d = sv_d + " and exists (select 1 from tbaadm.ltd where gam.acid = ltd.acid and bank_id=?SVAR " 
		sv_d = sv_d + " and flow_id='DISBT' and entity_cre_flg='Y' and del_flg='N') "
		sv_d = sv_d + " group by cif_id "
		sv_d = sv_d + " having count(gam.cif_id)>1 "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQSRV.GLBDATA.disbCifId = BANCS.OUTPARAM.disbCifId
			EQSRV.GLBDATA.disbCnt = BANCS.OUTPARAM.disbCnt
		else
			EQSRV.GLBDATA.disbCifId = ""
			EQSRV.GLBDATA.disbCnt = 0
		endif
		if((EQSRV.GLBDATA.disbCifId !="") and (cint(EQSRV.GLBDATA.disbCnt) >=1 ))then
			sv_u = urhk_SRV_SetErr("Disbursement Not Allowed")
			BANCS.OUTPUT.successOrFailure="F"
			exitscript
		endif
	endif
	exitscript	
trace off
end-->
