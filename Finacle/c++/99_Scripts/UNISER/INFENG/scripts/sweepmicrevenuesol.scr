	sv_s = sv_s + " AND htd.del_flg='N'AND htd.PSTD_FLG='Y'AND htd.tran_date=?SVAR AND gam.foracid='0001400303015' AND PART_TRAN_TYPE='C' AND ENTRY_USER_ID='CDCI54' )  group by htd.PART_TRAN_TYPE ,gam.foracid "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS =   BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.contextBankId + "|" + MISS.CHRG.getboddate + "|" + BANCS.STDIN.contextBankId + "|" +  BANCS.STDIN.contextBankId + "|" + MISS.CHRG.getboddate
