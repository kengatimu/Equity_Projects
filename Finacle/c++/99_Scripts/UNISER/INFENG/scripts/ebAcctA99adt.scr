#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Name                   : ebAcctA99adt.scr 
#   Date                   : 08-May-2019
#   Description            : mkey 
#   Input                  :
#   Output                 :
#   Author                 : Vino Palani
#   Called Script          :
#   Calling Script         :
#   Reference              :
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#   Modification History   :
#
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Added to Activate the Account for 99 Entity [vino palani]
# Account Active Starts
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        if(fieldexists(BANCS.STDIN.contextBankId)==1)then
                if(BANCS.STDIN.contextBankId=="99")then
                        if((BANCS.INPUT.DrCrInd=="C") and (BANCS.INPUT.AcctNum!="") and (BANCS.INPUT.SchemeType!=""))then
                                if((cdouble(BANCS.INPUT.TranAmt)>=50) and (BANCS.INPUT.SchemeCode =="FS100"))then
					sv_q = urhk_B2k_ForacidToAcid(BANCS.INPUT.AcctNum)
					if(sv_q==0)then
						BANCS.INPUT.drAcid = BANCS.OUTPARAM.Acid
					else
						BANCS.INPUT.drAcid = ""
					endif
					BANCS.INPARAM.acid = BANCS.INPUT.drAcid 
					sv_a = urhk_getAcctStatus("")
					if (sv_a == 0) then
						sv_f = BANCS.OUTPARAM.acctStatus
					else
						sv_f = ""
					endif
				if(sv_f!="A")then
                                        BANCS.INPARAM.AcctNum = BANCS.INPUT.AcctNum
                                        BANCS.INPARAM.SchemeType = BANCS.INPUT.SchemeType
                                        sv_u = urhk_FTS_ActivateAccount("")
                                        print(sv_u)
                                        if(sv_u==0)then
					#{
							sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.AcctNum)
							if(sv_u ==0)then
								BANCS.INPUT.acctSolId = BANCS.OUTPARAM.acctSolId
								BANCS.INPUT.acctGlsubCode = BANCS.OUTPARAM.glSubHeadCode
							endif
							#Audit
							#+++++
							if(repexists("AUDIT")==0)then
								createrep("AUDIT")
							endif
							if(classexists("AUDIT","NEW")==0)then
								createclass("AUDIT","NEW",5)
							endif
							if(classexists("AUDIT","OLD")==0)then
								createclass("AUDIT","OLD",5)
							endif
							if(classexists("AUDIT","KEY")==0)then
								createclass("AUDIT","KEY",5)
							endif
							if(repexists("BANCS")==0)then
								createrep("BANCS")
							endif
							if(classexists("BANCS","INPARAM")==0)then
								createclass("BANCS","INPARAM",5)
							endif
							sv_d = urhk_InitAudit("")
							print(sv_d)
							if(sv_d!=0)then
								print(BANCS.OUTPARAM.successOrFailure)
								print(BANCS.OUTPARAM.errorMesg)
							endif
							AUDIT.OLD.acct_status="D"
							AUDIT.NEW.acct_status="A"
							
							BANCS.INPARAM.AUDITSOLID=BANCS.INPUT.acctSolId
							BANCS.INPARAM.TABLENAME="SMT"
							BANCS.INPARAM.TABLEKEY=BANCS.INPUT.drAcid
							BANCS.INPARAM.ACCTNUM=BANCS.INPUT.AcctNum
							BANCS.INPARAM.GLSUBHEADCODE=BANCS.INPUT.acctGlsubCode
							BANCS.INPARAM.OPERCODE="M"
							##BANCS.INPARAM.REFNUM="D11189692"
							BANCS.INPARAM.REFNUM=""
							BANCS.INPARAM.AUTOVERIFY="Y"
							
							sv_d = urhk_Audit("")
							print(sv_d)
							if(sv_d != 0)then	
								print(BANCS.OUTPARAM.successOrFailure)
								print(BANCS.OUTPARAM.errorMesg)
								sv_d = urhk_dbSQLWithBind("Rollback")
								print(sv_d)
							else
								sv_d = urhk_dbSQLWithBind("Commit")
								print(sv_d)

							endif
							exitscript
                                                        print("activated")
					#}
                                        endif
				endif
                                endif
                        endif
                endif
        endif
#Ends
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#trace off
end-->

