<--start
trace on

sv_r = REPEXISTS("CUSTS")
IF (sv_r == 0) THEN
	CREATEREP("CUSTS")
ENDIF

sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
IF (sv_r == 0) THEN
     CREATECLASS("CUSTS", "GLBDATA", 5)
ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.AcctNum))THEN
