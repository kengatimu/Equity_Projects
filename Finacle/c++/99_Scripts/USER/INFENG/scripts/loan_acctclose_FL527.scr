				PRINT(sv_u)
				sv_u = urhk_ExecSrv(" SRV_CloseLoanAcctAndVerify|retain_all_output = Y")
				PRINT(sv_u)
				
		#}
		ENDIF	
		
		IF (sv_u != 0) THEN
			#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}
				ELSE
				#{
					sv_v = 0
				#}
			ENDIF

			IF (sv_v > 0) THEN
			#{
				sv_u = system("echo 'Error for Acct:"+CUSTS.GLBDATA.AcctNum+" ' >>closed.log")
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
					sv_u = system("echo '"+sv_e+"' >>closed.log")
					print(sv_u)
				#}
				DO
			#}
			ENDIF
	        #}	
			ELSE
            #{

                    CUSTS.GLBDATA.status="The Account is Closed Successfully!"
                    sv_e=urhk_SetOrbOut("Status|"+CUSTS.GLBDATA.status)
                    sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
                    print(sv_u)	



			#}
			ENDIF

 
ENDOFSCRIPT:
trace off
exitscript
