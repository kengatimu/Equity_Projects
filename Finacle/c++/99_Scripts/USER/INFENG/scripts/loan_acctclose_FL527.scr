		CUSTS.GLBDATA.clsflg=BANCS.OUTPARAM.clsflg
		print(CUSTS.GLBDATA.clsflg)

		CUSTS.GLBDATA.clrbal=BANCS.OUTPARAM.clrbal
		print(CUSTS.GLBDATA.clrbal)
		
		
		IF(CUSTS.GLBDATA.schmcode != "FL527") THEN
            #{

                print("The provide account is not FL527 Loan acoount")
                CUSTS.GLBDATA.errMsg="The Account is not relate to FL527 loan acct"
                sv_e=urhk_SetOrbOut("Error|"+CUSTS.GLBDATA.errMsg)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                print(sv_u)
                GOTO ENDOFSCRIPT
            #}
        ENDIF

        IF (CUSTS.GLBDATA.clsflg =="Y") THEN
            #{
                print("The provide account is Already Closed")
                CUSTS.GLBDATA.errMsg="The Account is Already Closed "
                sv_e=urhk_SetOrbOut("Error|"+CUSTS.GLBDATA.errMsg)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                print(sv_u)
                GOTO ENDOFSCRIPT

            #}
        ENDIF

        IF (CUSTS.GLBDATA.clrbal !="0") THEN
            #{
                print("The provide account have Balance")
                CUSTS.GLBDATA.errMsg="The Account have Balance "
                sv_e=urhk_SetOrbOut("Error|"+CUSTS.GLBDATA.errMsg)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                print(sv_u)
                GOTO ENDOFSCRIPT

            #}
         ENDIF
	
		IF(CUSTS.GLBDATA.solid != BANCS.STDIN.mySolId)THEN
            #{
                sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.GLBDATA.solid)
                print(sv_u)
                sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
                print(sv_u)
            #}
		ENDIF
	
	#}
	
	ELSE
