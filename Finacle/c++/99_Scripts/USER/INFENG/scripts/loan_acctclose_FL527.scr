			CUSTS.GLBDATA.errMsg="Invalid account number"
			sv_e=urhk_SetOrbOut("Error|"+CUSTS.GLBDATA.errMsg)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")	
	        	GOTO ENDOFSCRIPT
	#}
	ENDIF

	
	 sv_a=urhk_SetUrhkInp("acctBasic.foracid|" + CUSTS.GLBDATA.AcctNum)
	 sv_u = urhk_ExecSrv("SRV_FetchLoanAcctDtlForClsr|retain_all_output = Y")
	print(sv_u)

		IF (sv_u == 0 ) THEN
		#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctBasic.foracid|" + CUSTS.GLBDATA.AcctNum)
