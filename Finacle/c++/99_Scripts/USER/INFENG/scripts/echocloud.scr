<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Bank id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Bankid=BANCS.INPUT.Bankid
	print(CUST.DATA.Bankid)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("Acctnum"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Account Number"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	sv_e=urhk_SetOrbOut("StattusCode|Error")
	GOTO End
ELSE
	CUST.DATA.Acctnum=BANCS.INPUT.Acctnum
	print(CUST.DATA.Acctnum)
ENDIF

############################################
# Fetching the value from table
############################################
sv_q = "balance,closerflag| "
sv_q = sv_q + " select clr_bal_amt balance,acct_cls_flg closerflag from tbaadm.gam where bank_id = ?SVAR and foracid= ?SVAR and schm_type='LAA'   "

print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum  
print(BANCS.INPARAM.BINDVARS)

sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.balance = BANCS.OUTPARAM.balance
		print (CUST.DATA.balance)
		CUST.DATA.closerflag = BANCS.OUTPARAM.closerflag
		print (CUST.DATA.closerflag)	
			
		
			sv_z = urhk_SetOrbOut("ACCT_CLS_FLG |"+CUST.DATA.closerflag)
			sv_z = urhk_SetOrbOut("BALANCE |"+CUST.DATA.balance)
			print(sv_z)
		
		
	ELSE
		CUST.DATA.errMsg="Data Fetch Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error |"+CUST.DATA.errMsg)
	ENDIF
	
###################
sv_q = "lastpayment| "
sv_q = sv_q + "select max(last_adj_date) lastpayment from tbaadm.ldt where bank_id= ?SVAR  and  last_adj_date is not null   "
sv_q = sv_q + "and acid in (select acid from tbaadm.gam where bank_id= ?SVAR and foracid = ?SVAR) group by acid  "


print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum 
print(BANCS.INPARAM.BINDVARS)

	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.lastpayment = BANCS.OUTPARAM.lastpayment
		print (CUST.DATA.lastpayment)
		                 
		IF (CUST.DATA.lastpayment != "") THEN
			sv_z = urhk_SetOrbOut("LAST_PAYMENT_DATE |"+CUST.DATA.lastpayment)
			print(sv_z)
			
		ENDIF
		
		
	ELSE
	
		CUST.DATA.msg="ACCT_CLOSED_NO_LAST_PAYMENT_DATE"
		print (CUST.DATA.msg)
		sv_z = urhk_SetOrbOut("ACCT_STATUS| " +CUST.DATA.msg)
		
	ENDIF
	
##########################
sv_q = "payoff| "
sv_q = sv_q + "select payoff_date payoff from tbaadm.lam where bank_id=?SVAR and acid in (select acid from tbaadm.gam where foracid =?SVAR) "	

print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Acctnum 
print(BANCS.INPARAM.BINDVARS)

	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.payoff = BANCS.OUTPARAM.payoff
		print (CUST.DATA.payoff)
		                 
		IF (CUST.DATA.payoff != "") THEN
			sv_z = urhk_SetOrbOut("PAYOFF_DATE |"+CUST.DATA.payoff)
			print(sv_z)
			
		ENDIF
		
		sv_e=urhk_SetOrbOut("StattusCode|Success")
	ELSE
	
		CUST.DATA.errMsg="Data Fetch Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error |"+CUST.DATA.errMsg)
		
	ENDIF

END:
EXITSCRIPT
trace off
END-->