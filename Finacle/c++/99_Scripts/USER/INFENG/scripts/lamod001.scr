#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

#-----------------------------------------------------------------------------------------------
# Creating Repositories and classes
#-----------------------------------------------------------------------------------------------
sv_u = REPEXISTS("CUST")
IF (sv_u == 0) THEN
	CREATEREP("CUST")
ENDIF

sv_u = CLASSEXISTS("CUST", "DATA")
IF (sv_u == 0) THEN
	CREATECLASS("CUST", "DATA", 5)
ENDIF

#-----------------------------------------------------------------------------------------------
# Getting inputs from frond end
#-----------------------------------------------------------------------------------------------

sv_a = urhk_B2k_PrintRepos("BANCS")

IF( (FIELDEXISTS(("BANCS").("INPUT").("schmCode"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply The Scheme Code"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("loanAmt"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply The Loan Amt"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("loanTenorMonths"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Loan Period"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("interestRate"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Interet Rate"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("insChrgPCT"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Insurance Charge Rate"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("lacepct"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply The LAce Chrg Rate"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

		CUST.DATA.totalLoanAmt		=	""
		CUST.DATA.loanInstallment 	=	""
        CUST.DATA.schmCode			=BANCS.INPUT.schmCode
        CUST.DATA.loanAmt			=cdouble(BANCS.INPUT.loanAmt)
        CUST.DATA.loanTenorMonths	=cdouble(BANCS.INPUT.loanTenorMonths)
        CUST.DATA.interestRate		=cdouble(BANCS.INPUT.interestRate)
        CUST.DATA.insChrgPCT		=cdouble(BANCS.INPUT.insChrgPCT)
		CUST.DATA.lacepct			=cdouble(BANCS.INPUT.lacepct)
#-----------------------------------------------------------------------------------------------
# LIMITING TO LA527
#-----------------------------------------------------------------------------------------------
sv_b = CUST.DATA.schmCode
        print(sv_b)
        IF(sv_b !="LA527")THEN
            CUST.DATA.errMsg="CALCULATION VALID FOR LA527 ONLY"
			sv_e=urhk_SetOrbOut("Error | "+CUST.DATA.errMsg)
			sv_u = urhk_SetOrbOut("SuccessOrFailure| N")
			GOTO End
		ENDIF
		

#-----------------------------------------------------------------------------------------------
# CALCULATION
#-----------------------------------------------------------------------------------------------

sv_a =""
print(CUST.DATA.interestRate)
CUST.DATA.interestRate = (CDOUBLE(CUST.DATA.interestRate) / 100)
print(CUST.DATA.interestRate)
CUST.DATA.interestRate = CDOUBLE(CUST.DATA.interestRate) + 1
print(CUST.DATA.interestRate)

CUST.DATA.lacepct=(CDOUBLE(CUST.DATA.lacepct)* CDOUBLE(CUST.DATA.loanAmt))/100
CUST.DATA.insChrgPCT=(CDOUBLE(CUST.DATA.insChrgPCT)* CDOUBLE(CUST.DATA.loanAmt))/100
		
CUST.DATA.totalLoanAmt = CDOUBLE(CUST.DATA.loanAmt) + CDOUBLE(CUST.DATA.lacepct) + CDOUBLE(CUST.DATA.insChrgPCT)
print (CUST.DATA.totalLoanAmt)

CUST.DATA.loanInstallment = (CDOUBLE(CUST.DATA.totalLoanAmt) * CDOUBLE(CUST.DATA.interestRate))/ CINT(CUST.DATA.loanTenorMonths)
CUST.DATA.loanInstallment =Format$(CDOUBLE(CUST.DATA.loanInstallment),"%.4f")
print (CUST.DATA.loanInstallment)

sv_f = urhk_SetOrbOut("LOAN_INSTALLMENT: |"+CUST.DATA.loanInstallment)

End :
EXITSCRIPT
END-->


