sv_a = urhk_MTTS_PopulateInputDetails("")
print(sv_a)
if(sv_a==0)then
                EBSRV.GLBDATA.trSting = MTT.InputDetails.Argument1
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.drAcct  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.drAcct)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.crAcct  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.crAcct)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdAmt  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdAmt)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdsrlNum  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdsrlNum)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdAcct  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdAcct)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.drBalance  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.drBalance)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdDate  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdDate)
                #--
                EBSRV.GLBDATA.trSting = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.trSting)
                sv_l = strlen(EBSRV.GLBDATA.trSting)
                sv_f = mid$(EBSRV.GLBDATA.trSting,0,sv_l)
                sv_p = getposition(sv_f,"|")
                EBSRV.GLBDATA.dmdOvduDate  = mid$(sv_f,0,(sv_p-1))
                print(EBSRV.GLBDATA.dmdOvduDate)
                #--
                EBSRV.GLBDATA.orgDmdAmt = mid$(sv_f,sv_p,sv_l)
                print(EBSRV.GLBDATA.orgDmdAmt)

else
        EBSRV.GLBDATA.drAcct   = ""
        EBSRV.GLBDATA.crAcct   = ""
        EBSRV.GLBDATA.dmdAmt   = ""
        EBSRV.GLBDATA.dmdsrlNum = ""
        EBSRV.GLBDATA.dmdAcct  = ""
        EBSRV.GLBDATA.drBalance = ""
endif
print(EBSRV.GLBDATA.drAcct)
sv_b = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.drAcct)
if(sv_b == 0) then
        EBSRV.GLBDATA.drclBalance= BANCS.OUTPARAM.ClearBalance
        EBSRV.GLBDATA.EffAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
        EBSRV.GLBDATA.lienAmtB = BANCS.OUTPARAM.lienAmt
	EBSRV.GLBDATA.drAcid = BANCS.OUTPARAM.acid
	EBSRV.GLBDATA.drCif = BANCS.OUTPARAM.cifId
else
        EBSRV.GLBDATA.drclBalance = 0
        EBSRV.GLBDATA.lienAmtB = 0
        EBSRV.GLBDATA.EffAvailableAmt = 0
	EBSRV.GLBDATA.drAcid = ""
	EBSRV.GLBDATA.drCif = ""
endif
print(EBSRV.GLBDATA.EffAvailableAmt)
IF(EBSRV.GLBDATA.drAcct != EBSRV.GLBDATA.dmdAcct) then
	sv_b = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.dmdAcct)
	if(sv_b == 0) then
		EBSRV.GLBDATA.drAcid = BANCS.OUTPARAM.acid
	else
		EBSRV.GLBDATA.drAcid = ""
	endif
ENDIF

		IF(cdouble(EBSRV.GLBDATA.drclBalance) > 0) then
		#{
			####Check and Lift Existing liens before rocovery
                        print("Lien Lift")
                        sv_s = "amount1,acid,b2kid|select trim (lien_amt),acid,b2k_id from tbaadm.alt "
                        sv_s = sv_s + " where b2k_id in (select trim(max(b2k_id))  from tbaadm.alt "
                        sv_s = sv_s + " where acid =?SVAR "
                        sv_s = sv_s + " and b2k_type = 'ULIEN' "
                        sv_s = sv_s + " and lien_reason_code='AGTOD' "
                        sv_s = sv_s + " and b2k_id is not null "
                        sv_s = sv_s + " and bank_id =?SVAR) "
                        sv_s = sv_s + " and b2k_type = 'ULIEN' "
                        sv_s = sv_s + " and lien_reason_code='AGTOD' "
                        sv_s = sv_s + " and b2k_id is not null "
                        sv_s = sv_s + " and acid =?SVAR "
                        sv_s = sv_s + " and bank_id =?SVAR "
                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.drAcid + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.drAcid + "|" + BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)
                        print(sv_s)
                        sv_d = urhk_dbSelectWithBind(sv_s)
                        print(sv_d)
                        if(sv_d == 0)then
                        #{
                                EBSRV.GLBDATA.amount1 = BANCS.OUTPARAM.amount1
                                EBSRV.GLBDATA.acid = BANCS.OUTPARAM.acid
                                EBSRV.GLBDATA.b2kid = BANCS.OUTPARAM.b2kid
                                EBSRV.GLBDATA.Lib2kid = EBSRV.GLBDATA.b2kid
                        #}
                        else
                        #{
                                EBSRV.GLBDATA.amount1 = "0"
                                EBSRV.GLBDATA.acid = ""
                                EBSRV.GLBDATA.b2kid = ""
                                EBSRV.GLBDATA.Lib2kid = ""
                        #}
                        endif
                        print(EBSRV.GLBDATA.amount1)

                        if(EBSRV.GLBDATA.b2kid!="")then
                        #{
                                BANCS.INPARAM.b2kId = EBSRV.GLBDATA.b2kid
                                BANCS.INPARAM.acctNum = EBSRV.GLBDATA.dmdAcct
                                BANCS.INPARAM.blockMode = "M"
                                BANCS.INPARAM.lienAmt = cdouble(EBSRV.GLBDATA.amount1) * -1
                                BANCS.INPARAM.expiryDate = left$(BANCS.STDIN.BODDate,10)
                                BANCS.INPARAM.remarks = "Lien due to Agent OD"
                                BANCS.INPARAM.reasonCode = "AGTOD"
                                BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
                                BANCS.INPARAM.lienValueDate = LEFT$(BANCS.STDIN.BODDate,10)
                                sv_u = urhk_updateLien("")
                        #}
                        endif
		#}
		endif
		#############
print(EBSRV.GLBDATA.drclBalance)
if(cdouble(EBSRV.GLBDATA.drclBalance)<=0)then
	EBSRV.GLBDATA.lienAmt = EBSRV.GLBDATA.dmdAmt
	print(EBSRV.GLBDATA.lienAmt)
        goto LIENADD
else
	EBSRV.GLBDATA.lienAmt = cdouble(EBSRV.GLBDATA.dmdAmt) - cdouble(EBSRV.GLBDATA.drclBalance)
	print(EBSRV.GLBDATA.lienAmt)
endif

####Prevent going to credit on recovery
sv_b = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.crAcct)
if(sv_b == 0) then
        EBSRV.GLBDATA.crclrBalance = BANCS.OUTPARAM.ClearBalance
	print(EBSRV.GLBDATA.crclrBalance)
	if(cdouble(EBSRV.GLBDATA.crclrBalance) < 0) then
		EBSRV.GLBDATA.crclrBalance1 = cdouble(EBSRV.GLBDATA.crclrBalance) * -1
		print(EBSRV.GLBDATA.crclrBalance1)
		if(cdouble(EBSRV.GLBDATA.dmdAmt) > cdouble(EBSRV.GLBDATA.crclrBalance1)) then
			EBSRV.GLBDATA.dmdAmt = EBSRV.GLBDATA.crclrBalance1
			print(EBSRV.GLBDATA.dmdAmt)
		endif
	else
		goto VAYU	
	endif
else
        EBSRV.GLBDATA.crclrBalance = 0
	goto VAYU
endif

sv_r = urhk_MTTS_DefineTransaction("BGAMORT")
print(sv_r)

IF (sv_r != 0)THEN
        MTT.Error.Description = "Error encountered in Define Transaction"
        sv_r = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ENDIF
#Creation of Debit leg
MTT.PartTranDetails.Account             = EBSRV.GLBDATA.drAcct
MTT.PartTranDetails.RefCurrency         = BANCS.STDIN.homeCrncyCode
MTT.PartTranDetails.TranCurrency        = BANCS.STDIN.homeCrncyCode
MTT.PartTranDetails.Particulars         = "Agent OD recovery:" + EBSRV.GLBDATA.crAcct
if(cdouble(EBSRV.GLBDATA.drclBalance)>= cdouble(EBSRV.GLBDATA.dmdAmt))then
        MTT.PartTranDetails.RefAmount           = -(cdouble(EBSRV.GLBDATA.dmdAmt))
        MTT.PartTranDetails.Amount              = -(cdouble(EBSRV.GLBDATA.dmdAmt))
else
        MTT.PartTranDetails.RefAmount           = -(cdouble(EBSRV.GLBDATA.drclBalance))
        MTT.PartTranDetails.Amount              = -(cdouble(EBSRV.GLBDATA.drclBalance))
	EBSRV.GLBDATA.lienAmt = cdouble(EBSRV.GLBDATA.dmdAmt) - cdouble(MTT.PartTranDetails.Amount)
	print(EBSRV.GLBDATA.lienAmt)
endif
MTT.PartTranDetails.Refnum              = EBSRV.GLBDATA.dmdsrlNum
MTT.PartTranDetails.RateCode            = ""
MTT.PartTranDetails.Rate                = ""
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "N"
MTT.PartTranDetails.CarveAmtFlg         = "Y"
MTT.PartTranDetails.ReportCode          = "AGNTDMD"
MTT.PartTranDetails.ValueDateDiff       = "0"
