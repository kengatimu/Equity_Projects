if(cdouble(EBSRV.GLBDATA.drclBalance)>= cdouble(EBSRV.GLBDATA.dmdAmt))then
        MTT.PartTranDetails.RefAmount           = cdouble(EBSRV.GLBDATA.dmdAmt)
        MTT.PartTranDetails.Amount              = cdouble(EBSRV.GLBDATA.dmdAmt)
else
        MTT.PartTranDetails.RefAmount           = cdouble(EBSRV.GLBDATA.drclBalance)
        MTT.PartTranDetails.Amount              = cdouble(EBSRV.GLBDATA.drclBalance)
endif
MTT.PartTranDetails.Refnum              = EBSRV.GLBDATA.dmdsrlNum
MTT.PartTranDetails.RateCode            = ""
MTT.PartTranDetails.Rate                = ""
MTT.PartTranDetails.TranIdentifier      = "BGAMORT"
MTT.PartTranDetails.Consolidate         = "N"
MTT.PartTranDetails.ReportCode          = "AGNTDMD"
MTT.PartTranDetails.ValueDateDiff       = "0"
MTT.PartTranDetails.Remarks             = EBSRV.GLBDATA.drAcct
MTT.PartTranDetails.PstFlg              = "Y"

sv_t = urhk_MTTS_DefinePartTran("AMORT1")
print(sv_t)
IF(sv_t!=0)THEN
        MTT.Error.Description = "Unable to define credit part tran"
        sv_t = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ENDIF
#Tran Status
MTT.Error.Description   = ""
BANCS.INPUT.TranStatus  = "S"
sv_r = urhk_MTTS_EndDefinition("")
print(sv_r)
##sv_p = urhk_MTTS_HandleExceptions("POST")
##print(sv_p)
IF(sv_r!=0)THEN
        MTT.Error.Description = "Unable to end definition"
        sv_r = urhk_MTTS_ReportErrorCondition("")
        goto VAYU
ELSE
        EBSRV.GLBDATA.MTTTranId = BANCS.OUTPARAM.MTTTranId
        print(EBSRV.GLBDATA.MTTTranId)
        goto VAYU
ENDIF
sv_r = urhk_MTTS_Close("")
print(sv_r)

VAYU:
        if(EBSRV.GLBDATA.MTTTranId!="")then
                sv_d = "update custom.agddt set tot_adj_amt=tot_adj_amt+ ?NVAR,"
                sv_d = sv_d + " last_adj_date=to_date(?SVAR,'DD-MM-RR'),free_text2=?SVAR "
                sv_d = sv_d + " where bank_id=?SVAR and foracid=?SVAR  and dep_srl_num=?SVAR and dmd_Date=to_date(?SVAR,'DD-MM-YYYY') and dmd_ovdu_Date=to_Date(?SVAR,'DD-MM-YYYY') and dmd_amt=?NVAR"
                if(cdouble(EBSRV.GLBDATA.drclBalance)>= cdouble(EBSRV.GLBDATA.dmdAmt))then
                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.dmdAmt + "|" +mid$(BANCS.STDIN.BODDate,0,10) + "|" + EBSRV.GLBDATA.MTTTranId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.dmdAcct + "|" + EBSRV.GLBDATA.dmdsrlNum + "|" + EBSRV.GLBDATA.dmdDate + "|" + EBSRV.GLBDATA.dmdOvduDate + "|" +  EBSRV.GLBDATA.orgDmdAmt
                else
                        BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.drclBalance + "|" +mid$(BANCS.STDIN.BODDate,0,10)+ "|" + EBSRV.GLBDATA.MTTTranId + "|" + BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.dmdAcct + "|" + EBSRV.GLBDATA.dmdsrlNum + "|" + EBSRV.GLBDATA.dmdDate + "|" + EBSRV.GLBDATA.dmdOvduDate + "|" +  EBSRV.GLBDATA.orgDmdAmt
                endif
                print(sv_d)
                print(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_dbSqlWithBind(sv_d)
                if(sv_u==0)then
                        sv_u = urhk_dbSqlWithBind("commit")
                        print(sv_u)
                endif
        endif

	lv_b = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.crAcct)
