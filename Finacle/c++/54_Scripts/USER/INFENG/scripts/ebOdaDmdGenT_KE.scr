	#####Lien for overdue
        lv_p = "tplienAmt |  select sum(dmd_amt)-sum(tot_adj_amt) from custom.agddt where bank_id=?SVAR and del_flg='N' and entity_cre_flg='Y' and foracid =?SVAR and dmd_amt>0 "
        lv_p = lv_p + " and dmd_date <= to_date(?SVAR,'DD-MM-RR') "

        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.dmdAcct + "|" + mid$(BANCS.STDIN.BODDate,0,10)
        print(BANCS.INPARAM.BINDVARS)
        print(lv_p)
        lv_p = urhk_dbSelectWithBind(lv_p)
        if(lv_p==0)then
        #{
                  EBSRV.GLBDATA.lienAmt = BANCS.OUTPARAM.tplienAmt
         else
                  EBSRV.GLBDATA.lienAmt = "0"
         #}
         endif

	print(EBSRV.GLBDATA.lienAmt)
	print(EBSRV.GLBDATA.lienAmtB)
