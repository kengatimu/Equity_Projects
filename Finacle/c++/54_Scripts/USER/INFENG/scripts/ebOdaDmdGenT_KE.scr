                                                sv_u = urhk_updateLien("")
						print(sv_u)
                                	#}
					endif
                        		sv_z = urhk_dbCursorFetch(EBSRV.GLBDATA.lienSrlNum)
                        		print(sv_z)
				#}
        			do
        			sv_z = urhk_dbCursorClose(EBSRV.GLBDATA.lienSrlNum)
        			print(sv_z)
			#}
			endif
			#############
        		BANCS.INPARAM.acctNum = EBSRV.GLBDATA.drAcct
        		BANCS.INPARAM.blockMode = "A"
        		BANCS.INPARAM.lienAmt = cdouble(EBSRV.GLBDATA.lienAmt)
       			BANCS.INPARAM.expiryDate = "31-12-2099"
        		BANCS.INPARAM.remarks = "Lien due to Agent OD"
        		BANCS.INPARAM.reasonCode = "AGTOD"
        		BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
        		BANCS.INPARAM.lienValueDate = LEFT$(BANCS.STDIN.BODDate,10)
        		sv_u = urhk_updateLien("")
        		if(sv_u != 0)then
        		#{
                     		EBSRV.GLBDATA.srvErrMsg =  "Failed to Lien on operative account for loan recovery"
                     		EBSRV.GLBDATA.srvErrCode = "Lien"
                     		EBSRV.GLBDATA.srvSucFail = "S"
                     		exitscript
        		#}
        		else
        		#{
                     		EBSRV.GLBDATA.srvErrMsg =  "Lien on operative account for loan recovery success"
                     		EBSRV.GLBDATA.srvErrCode = "Lien"
                    		EBSRV.GLBDATA.srvSucFail = "S"
                     		lv_i = urhk_dbSqlWithBind("commit")
                     		exitscript
        		#}
        		endif

	#}
	endif

exitscript
TRACE OFF
END-->
