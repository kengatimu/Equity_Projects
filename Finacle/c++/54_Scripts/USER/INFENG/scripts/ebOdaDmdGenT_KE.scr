		print(EBSRV.GLBDATA.crclrBalance2)
	else
		EBSRV.GLBDATA.crclrBalance2 = "0"
	endif

	IF(cdouble(EBSRV.GLBDATA.crclrBalance2) >= cdouble("0")) then
