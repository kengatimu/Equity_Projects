                endif
                if(BANCS.INPUT.OdAcct!="")then
                #{
                        sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.OdAcct)
                        print(sv_u)
                        if(sv_u==0)then
                        #{
                                BANCS.INPUT.odsancLim = BANCS.OUTPARAM.sanctionLimit
