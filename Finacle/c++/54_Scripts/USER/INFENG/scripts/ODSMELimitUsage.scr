				ETSRV.GLBDATA.oDAcid = BANCS.OUTPARAM.acid
				ETSRV.GLBDATA.schmtypeOD = BANCS.OUTPARAM.schmType
				print(ETSRV.GLBDATA.schmtypeOD)
                                print(BANCS.INPUT.totchrg)
                                print(BANCS.OUTPARAM.sanctionLimit)
                                print(BANCS.OUTPARAM.AvailableAmt)
                                print(BANCS.OUTPARAM.ClearBalance)
                                BANCS.INPUT.actualLimit = cdouble(BANCS.OUTPARAM.AvailableAmt) - cdouble(BANCS.INPUT.totchrg)
                                print(BANCS.INPUT.actualLimit)
                                BANCS.INPUT.AgntOdAvailableAmt=cdouble(BANCS.INPUT.actualLimit)
