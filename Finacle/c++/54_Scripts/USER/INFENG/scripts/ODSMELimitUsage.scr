                print(BANCS.INPUT.AgntAvailableAmt)
                print(BANCS.INPUT.AgntOdAvailableAmt)
                #print(BANCS.INPUT.totchrg)
                print(BANCS.INPUT.odsancLim)
                ETSRV.GLBDATA.dueCnt = "0"
                if(fieldexists(BANCS.INPUT.TranAmt)==1)then
                #{
                        #For DPD Loans
                        lv_f = " dpdCnt | select count(*) from tbaadm.gac where bank_id=?SVAR  and acid in (select acid from tbaadm.gam where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg<>'Y' and del_flg<>'Y' and entity_cre_flg='Y' and del_flg='N' and cust_id=?SVAR) and DPD_CNTR>30 "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" +  ETSRV.GLBDATA.custIDD
                        print(lv_f)
                        print(BANCS.INPARAM.BINDVARS)
                        lv_f = urhk_dbSelectWithBind(lv_f)
                        if(lv_f==0)then
                        #{
                                ETSRV.GLBDATA.dpdCnt = BANCS.OUTPARAM.dpdCnt
                        #}
                        else
                        #{
                                ETSRV.GLBDATA.dpdCnt = "0"
                        #}
                        endif
                        #For Overdue Validation
                        lv_p = "dueCnt |  select count(*) from custom.odsme_new where bank_id=?SVAR and foracid=?SVAR "
                        #######and free_text1= ?SVAR "
                        lv_p = lv_p + " and dmd_eff_date<=to_date(?SVAR,'DD-MM-RRRR') and dep_tran_id='BATCH' and dep_dccid='BATCH' "
                        lv_p = lv_p + " and dep_command='CSWOP' and dmd_amt - tot_adj_amt + penal_int >0 and dep_srl_num='NOSWEEPDIRECT_CREDIT' "
                        lv_p = lv_p + " and entity_cre_flg='Y' and del_flg='N' "
                        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.acctNum + "|" + left$(BANCS.STDIN.BODDate,10)
                        print(BANCS.INPARAM.BINDVARS)
                        print(lv_p)
                        lv_g = urhk_dbSelectWithBind(lv_p)
                        if(lv_g==0)then
                        #{
                                ETSRV.GLBDATA.dueCnt = BANCS.OUTPARAM.dueCnt
                        #}
                        else
                        #{
                                ETSRV.GLBDATA.dueCnt = "0"

                        #}
                        endif
                        BANCS.OUTPUT.agntTrnAmt = left$(BANCS.INPUT.TranAmt,14)
                        print(BANCS.OUTPUT.agntTrnAmt)
                        if(cdouble(BANCS.INPUT.AgntAvailableAmt)>0)then
                        #{
                                if(cdouble(BANCS.OUTPUT.agntTrnAmt)>cdouble(BANCS.INPUT.AgntAvailableAmt))then
                                #{
                                        ETSRV.GLBDATA.needAmtfrmOd = cdouble(BANCS.OUTPUT.agntTrnAmt) - cdouble(BANCS.INPUT.AgntAvailableAmt) + cdouble(ETSRV.GLBDATA.fee1)
                                        print(ETSRV.GLBDATA.needAmtfrmOd)
					ETSRV.GLBDATA.needAmtfrmOd1 = ETSRV.GLBDATA.needAmtfrmOd
					print(ETSRV.GLBDATA.needAmtfrmOd1)
					#########Fees inclusion to determine amount to debit
                                	BANCS.INPUT.chrgLace = cdouble(ETSRV.GLBDATA.needAmtfrmOd) * 2 /100
					BANCS.INPUT.chrgexduty = cdouble(BANCS.INPUT.chrgLace) * 20 / 100
					#---- ROUNDING OFF CHARGES TO 2dp before Collectionn -------

					lv_l = "chrgLace ,chrgexduty|SELECT ROUND(?SVAR, 2), ROUND(?SVAR, 2) FROM dual"
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.chrgLace +"|"+BANCS.INPUT.chrgexduty
					sv_x = urhk_dbSelectWithBind(lv_l)
					IF(sv_x == 0)THEN
					#{
						BANCS.INPUT.chrgLace = BANCS.OUTPARAM.chrgLace 
						PRINT(BANCS.INPUT.chrgLace)
						BANCS.INPUT.chrgexduty= BANCS.OUTPARAM.chrgexduty
						PRINT(BANCS.INPUT.chrgexduty)
					#}
					ENDIF
                                	CUST.GCHRG.totchrg = cdouble(BANCS.INPUT.chrgLace) + cdouble(BANCS.INPUT.chrgexduty)
					ETSRV.GLBDATA.needAmtFeefrmOd = cdouble(ETSRV.GLBDATA.needAmtfrmOd) + cdouble(CUST.GCHRG.totchrg)
					print(CUST.GCHRG.totchrg)
					print(ETSRV.GLBDATA.needAmtFeefrmOd)
					########Fees
                                        ETSRV.GLBDATA.needAmtfrmOd = cdouble(ETSRV.GLBDATA.needAmtFeefrmOd)
                                        print(ETSRV.GLBDATA.needAmtfrmOd)

                                        if(cdouble(ETSRV.GLBDATA.needAmtfrmOd)>cdouble(BANCS.INPUT.AgntOdAvailableAmt))then
                                        #{
                                                #Agent Related OD has insufficient Fund
                                                BANCS.OUTPUT.agntValYN = "NOCR"
                                                ETSRV.GLBDATA.needAmtfrmOd = "0"
						exitscript
                                        #}
                                        else
                                        #{
                                                #agent Releated OD has sufficient Fund with agent account balance
                                                BANCS.OUTPUT.agntValYN = ""
                                                print(ETSRV.GLBDATA.needAmtfrmOd)
                                        #}
                                        endif
                                #}
                                else
                                #{
                                        #Agent Account itself has sufficient Fund,No Od Tran
                                        ##BANCS.OUTPUT.agntValYN = "NODR"
                                        BANCS.OUTPUT.agntValYN = "NOTRAN"
                                        ETSRV.GLBDATA.needAmtfrmOd = "0"
					exitscript
                                #}
                                endif
                        #}
                        else
                        #{
				if(cdouble(ETSRV.GLBDATA.ClearBalanceMain) < cdouble("0")) then
                                	ETSRV.GLBDATA.needAmtfrmOd = cdouble(BANCS.OUTPUT.agntTrnAmt) - cdouble(ETSRV.GLBDATA.ClearBalanceMain) + cdouble(ETSRV.GLBDATA.fee1)
				else
                                	ETSRV.GLBDATA.needAmtfrmOd = cdouble(BANCS.OUTPUT.agntTrnAmt) + cdouble(ETSRV.GLBDATA.fee1)
				endif
                                print(ETSRV.GLBDATA.needAmtfrmOd)
				ETSRV.GLBDATA.needAmtfrmOd1 = ETSRV.GLBDATA.needAmtfrmOd
				#########Fees inclusion to determine amount to debit
                                BANCS.INPUT.chrgLace = cdouble(ETSRV.GLBDATA.needAmtfrmOd) * 2 /100
				BANCS.INPUT.chrgexduty = cdouble(BANCS.INPUT.chrgLace) * 20 / 100

				#---- ROUNDING OFF CHARGES TO 2dp before Collectionn -------

				lv_l = "chrgLace ,chrgexduty|SELECT ROUND(?SVAR, 2), ROUND(?SVAR, 2) FROM dual"
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.chrgLace +"|"+BANCS.INPUT.chrgexduty
				sv_x = urhk_dbSelectWithBind(lv_l)
				IF(sv_x == 0)THEN
				#{
					BANCS.INPUT.chrgLace = BANCS.OUTPARAM.chrgLace 
					PRINT(BANCS.INPUT.chrgLace)
					BANCS.INPUT.chrgexduty= BANCS.OUTPARAM.chrgexduty
					PRINT(BANCS.INPUT.chrgexduty)
				#}
				ENDIF
                                CUST.GCHRG.totchrg = cdouble(BANCS.INPUT.chrgLace) + cdouble(BANCS.INPUT.chrgexduty)
				ETSRV.GLBDATA.needAmtFeefrmOd = cdouble(ETSRV.GLBDATA.needAmtfrmOd) + cdouble(CUST.GCHRG.totchrg)
				print(CUST.GCHRG.totchrg)
				print(BANCS.INPUT.chrgLace)
				print(BANCS.INPUT.chrgexduty)
				print(ETSRV.GLBDATA.needAmtFeefrmOd)
				########Fees
                                ETSRV.GLBDATA.needAmtfrmOd = cdouble(ETSRV.GLBDATA.needAmtFeefrmOd)
                                print(ETSRV.GLBDATA.needAmtfrmOd)

                                #print(BANCS.INPUT.AgntOdAvailableAmt)
                                if(cdouble(ETSRV.GLBDATA.needAmtfrmOd) > cdouble(BANCS.INPUT.AgntOdAvailableAmt))then
                                #{
                                                #Agent Related OD has insufficient Fund
                                                BANCS.OUTPUT.agntValYN = "NOCR"
                                                ETSRV.GLBDATA.needAmtfrmOd = "0"
						exitscript
                                #}
                                else
                                #{
                                                #agent Releated OD has sufficient Fund with agent account balance
                                                BANCS.OUTPUT.agntValYN = ""
                                                print(ETSRV.GLBDATA.needAmtfrmOd)
                                #}
                                endif

                        #}
                        endif
                        if(cdouble(ETSRV.GLBDATA.dpdCnt)>=1)then
                        #{
                                BANCS.OUTPUT.agntValYN = "DPD"
                                ETSRV.GLBDATA.needAmtfrmOd = "0"
                                exitscript
                        #}
                        endif

        		##########Check unposted disbursements
                	sv_s = "dtdCnt,trnId | select count(*),tran_id from tbaadm.dtd where acid = ?SVAR "
                	sv_s = sv_s + " and bank_id=?SVAR and pstd_flg='N' and del_flg ='N' and rownum='1' group by tran_id "
                	print(sv_s)
                	BANCS.INPARAM.BINDVARS = ETSRV.GLBDATA.oDAcid + "|" + BANCS.STDIN.contextBankId
                	print(BANCS.INPARAM.BINDVARS)
                	sv_u = urhk_dbSelectWithBind(sv_s)
                	if(sv_u==0)then
                        	ETSRV.GLBDATA.dtdCnt = BANCS.OUTPARAM.dtdCnt
                        	ETSRV.GLBDATA.trnId = BANCS.OUTPARAM.trnId
                	else
                        	ETSRV.GLBDATA.dtdCnt = 0
                        	ETSRV.GLBDATA.trnId = ""
                	endif

        		if(cdouble(ETSRV.GLBDATA.dtdCnt)>0)then
				#######No read access for scheme to transact"
                                BANCS.OUTPUT.agntValYN = "NOCR"
                                ETSRV.GLBDATA.needAmtfrmOd = "0"
                		sv_u = urhk_SRV_SetErr("Unposted Transaction Exists ["+ ETSRV.GLBDATA.trnId + "]")
				exitscript
        		endif

			#############Check limits for referral
			lv_l = "drCashLim,drXferLim,drInterSlLim,drCrncy|select TO_CHAR(user_cash_dr_lim), TO_CHAR(user_xfer_dr_lim), "
			lv_l = lv_l + " TO_CHAR(user_intersol_xfer_dr_limit), dr_lim_crncy_code FROM tbaadm.TBA_ROLE_CRNCY_LIMIT_TBL  WHERE  role_id = ?SVAR AND crncy_code = ?SVAR  AND bank_id = ?SVAR and del_flg='N' "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.roleId +"|"+ EQSRV.GLBDATA.refCrncy + "|" + BANCS.STDIN.contextBankId
			sv_x = urhk_dbSelectWithBind(lv_l)
			IF(sv_x == 0)THEN
			#{
				ETSRV.GLBDATA.drCashLim= BANCS.OUTPARAM.drCashLim
				ETSRV.GLBDATA.drXferLim= BANCS.OUTPARAM.drXferLim
				ETSRV.GLBDATA.drInterSlLim= BANCS.OUTPARAM.drInterSlLim
				ETSRV.GLBDATA.drCrncy= BANCS.OUTPARAM.drCrncy
				PRINT(ETSRV.GLBDATA.drCashLim)
				PRINT(ETSRV.GLBDATA.drXferLim)
				PRINT(ETSRV.GLBDATA.drInterSlLim)
				PRINT(ETSRV.GLBDATA.drCrncy)
				print(EQSRV.GLBDATA.refAmnt)
				###Check if referral approved
				lv_l = "refStatus|select count(*) from tbaadm.rfh where referral_id in "
				lv_l = lv_l + " (select referral_id from tbaadm.rfd where AUTH_STATUS ='C' and ACCT_NUM = ?SVAR and TRAN_AMT=?SVAR and bank_id = ?SVAR) "
				lv_l = lv_l + " and REFERRAL_STATUS ='C' and BOD_DATE = to_date(?SVAR,'DD-MM-YYYY') and bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.acct +"|"+ EQSRV.GLBDATA.refAmnt + "|" + BANCS.STDIN.contextBankId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				sv_x = urhk_dbSelectWithBind(lv_l)
				IF(sv_x == 0)THEN
				#{
					ETSRV.GLBDATA.refStatus = BANCS.OUTPARAM.refStatus
					print(ETSRV.GLBDATA.refStatus)
				#}
				ELSE
				#{
					ETSRV.GLBDATA.refStatus = "0"
				#}
				ENDIF
				###End
				IF(cdouble(ETSRV.GLBDATA.refStatus) == cdouble("0")) THEN
				#{
				IF(EQSRV.GLBDATA.tranType=="T") THEN
					if(cdouble(ETSRV.GLBDATA.drXferLim) < cdouble(EQSRV.GLBDATA.refAmnt)) then
						##########Role limit exceeded for transfer - Referral
                                		BANCS.OUTPUT.agntValYN = "NOCR"
                                		ETSRV.GLBDATA.needAmtfrmOd = "0"
						exitscript
					endif
				ENDIF
				IF(EQSRV.GLBDATA.tranType=="C") THEN
					if(cdouble(ETSRV.GLBDATA.drCashLim) < cdouble(EQSRV.GLBDATA.refAmnt)) then
						##########Role limit exceeded for cash - Referral
                                		BANCS.OUTPUT.agntValYN = "NOCR"
                                		ETSRV.GLBDATA.needAmtfrmOd = "0"
						exitscript
					endif
				ENDIF
				#}
				ENDIF
			#}
			ELSE
			#{
                                BANCS.OUTPUT.agntValYN = "NOCR"
                                ETSRV.GLBDATA.needAmtfrmOd = "0"
				exitscript
			#}
			ENDIF

                        #Starts
                        print(BANCS.OUTPUT.agntValYN)
                        print(ETSRV.GLBDATA.dueCnt)
                        print(ETSRV.GLBDATA.needAmtfrmOd)
                        if((cdouble(ETSRV.GLBDATA.dueCnt)<=0)and(cdouble(ETSRV.GLBDATA.needAmtfrmOd)>0))then
                        #{
			##Call sweep transaction API
			call("od553sweepTransFI.scr")
			print(CUST.INTERFACE.errorMsgFlg)
			print(CUST.INTERFACE.tranId)
                        if((CUST.INTERFACE.tranId != "") and (CUST.INTERFACE.errorMsgFlg == "N")) then
                        #{
				#####Collect Fee
                        	CUST.GCHRG.tranType = "T"
                        	CUST.GCHRG.tranSubType = "BI"
                        	CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				print(CUST.GCHRG.totchrg)
				print(BANCS.STDIN.homeCrncyCode)
				print(ETSRV.GLBDATA.needAmtfrmOd)
				BANCS.INPUT.totchrg = format$(CDOUBLE(ETSRV.GLBDATA.needAmtfrmOd1),"%17.2f")
				print(BANCS.INPUT.totchrg)
                        	CUST.GCHRG.chrgAmt = BANCS.INPUT.totchrg + "|" + BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.chrgAmt1 = BANCS.INPUT.totchrg
				print(CUST.GCHRG.chrgAmt)
                        	CUST.GCHRG.drAcctId = CUST.GCHRG.OdAcct
                        	print(CUST.GCHRG.drAcctId)
                        	CUST.GCHRG.ModuleCode = "ODLOAN"
				#####Collect Fee start
				sv_s = "nohup babx4061 $B2K_SESSION_ID ODSMEcommOnline.scr " + CUST.GCHRG.chrgAmt1 + " " + CUST.GCHRG.drAcctId + " " + CUST.GCHRG.ModuleCode + " " + CUST.INTERFACE.tranId + " " + BANCS.STDIN.BODDate + " @s &"
				sv_r = system(sv_s)
				#####Collect Fee end

                                BANCS.OUTPUT.agntValYN = "S"
                        #}
                        else
                        #{
                                                if(BANCS.OUTPUT.agntValYN!="NOTRAN")then
                                                BANCS.OUTPUT.agntValYN = "F"
                                                else
                                                BANCS.OUTPUT.agntValYN = "S"
                                                endif
                         #}
                         endif

                         if(cdouble(ETSRV.GLBDATA.dueCnt)>=1)then
                         #{
                                        BANCS.OUTPUT.agntValYN = "O"
                         #}
                         endif
                         ##ends


                #}
                else
                #{
                        BANCS.OUTPUT.agntValYN = "Y"
                #}
                endif
######trace off
