                BANCS.INPUT.AgntAvailableAmt = 0
        #}
        endif

                sv_d = "OdAcct|select foracid from tbaadm.gam where bank_id=?SVAR and cust_id=?SVAR "
                sv_d = sv_d + " and schm_code='OD553' and acct_cls_flg<>'Y' and entity_cre_flg='Y' "
                sv_d = sv_d + " and del_flg='N' and rownum<=1"
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + ETSRV.GLBDATA.custIDD
                print(sv_d)
                print(BANCS.INPARAM.BINDVARS)
                sv_u = urhk_dbSelectWithBind(sv_d)
                if(sv_u==0)then
                #{
                        BANCS.INPUT.OdAcct = BANCS.OUTPARAM.OdAcct
			CUST.GCHRG.OdAcct = BANCS.INPUT.OdAcct 
