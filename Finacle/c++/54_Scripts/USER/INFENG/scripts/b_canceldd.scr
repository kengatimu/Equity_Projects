		print(sv_a)

		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + sv_p + "|" + sv_c
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + sv_e
		print(BANCS.INPARAM.BINDVARS)
		sv_q = urhk_dbSelectWithBind(sv_a)
		print(sv_q)
		IF (sv_q !=0) then
			exitscript
		else	
			sv_i= BANCS.OUTPARAM.tranid
		ENDIF
		print(sv_i)

	sv_a = "foracid|select foracid from tbaadm.gam,tbaadm.htd where tbaadm.gam.BANK_ID =?SVAR AND tbaadm.htd.BANK_ID =?SVAR AND tbaadm.gam.acid=tbaadm.htd.acid"
	sv_a = sv_a + " and tbaadm.htd.tran_date =?SVAR"
