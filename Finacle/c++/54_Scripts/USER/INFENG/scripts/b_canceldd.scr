	sv_a = sv_a + " and tbaadm.dtd.tran_date =?SVAR"
	sv_a = sv_a + " and tbaadm.dtd.tran_id=?SVAR"
	sv_a = sv_a + " and tbaadm.dtd.tran_amt !='100'"
	sv_a = sv_a + " and tbaadm.dtd.part_tran_type = 'D'"
