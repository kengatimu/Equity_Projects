	print(BANCS.INPARAM.BINDVARS)

	sv_l = urhk_dbSelectWithBind(sv_a)

	print(sv_l)
		IF (sv_l !=0) then
			exitscript
			else	
			sv_n= BANCS.OUTPARAM.CASHACC
		ENDIF
		print(sv_n)
		print(sv_p)
		
		
	sv_a = "SUSPCRDT|select foracid from tbaadm.gam where BANK_ID = ?SVAR AND substr(tbaadm.gam.foracid, 4)='3000103494' and tbaadm.gam.sol_id =?SVAR"
	sv_a = sv_a + "and tbaadm.gam.del_flg='N' and schm_type ='OAP' and schm_code='POIN' and tbaadm.gam.acct_cls_flg !='Y' and tbaadm.gam.gl_sub_head_code='30001'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  sv_p
	print(BANCS.INPARAM.BINDVARS)

	sv_l = urhk_dbSelectWithBind(sv_a)

	print(sv_l)

		IF (sv_l !=0) then
			exitscript
			else	
			sv_h= BANCS.OUTPARAM.SUSPCRDT
		ENDIF
		print(sv_h)

	if (sv_n == "CASH") then
	IF (BANCS.STDIN.userWorkClass != "510") THEN
        sv_a = urhk_SRV_SetVal("ddBasicDtl.purAcct.foracid|" + sv_h)
        else
        sv_a = urhk_SRV_SetVal("ddBasicDtl.purAcct.foracid|" + sv_v)
