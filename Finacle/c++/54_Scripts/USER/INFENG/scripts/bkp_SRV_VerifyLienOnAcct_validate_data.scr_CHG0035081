<--START
CHECKSUM="ba752508d4a7a46385113de7ecc07eaaf1d33b6b76e0a27d8f235de53bc99ad8"
TRACE ON
print(BANCS.STDIN.userWorkClass)
print(BANCS.STDIN.userId)
print(BANCS.STDIN.EmployeeId)
        #------------------------------------------------------------------------------
        #       Creating repository and class
        #       Initializing the variables
        #------------------------------------------------------------------------------
        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

	sv_u = urhk_SRV_GetVal("acctLienMaintCrit.acctNum.foracid")
	IF (sv_u == 0) THEN
        #{
                CUST.DATA.foracid = BANCS.OUTPARAM.srvValue
                PRINT(CUST.DATA.foracid)
        #}
	ELSE
	#{
		sv_u = urhk_SRV_SetErr("Enter A Valid Account")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}
        ENDIF
	sv_u = urhk_SRV_GetVal("acctLienMaintCrit.acctNum.acid")
	IF (sv_u == 0) THEN
        #{
                CUST.DATA.acid = BANCS.OUTPARAM.srvValue
                PRINT(CUST.DATA.acid)
        #}
	ENDIF

	lv_j = "tempClass|select USER_TEMP_WORK_CLASS from tbaadm.upr where user_id=?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId
	lv_i = urhk_dbSelectWithBind(lv_j)
	if(lv_i == 0) then
                CUST.DATA.tempClass = BANCS.OUTPARAM.tempClass
	else
		CUST.DATA.tempClass = ""	
	endif
		
	sv_u = urhk_SRV_NumOfRecs("lienMaintLL")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
			CUST.DATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.DATA.noOfRecords)
	#}
	ELSE
	#{
			sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
	#}
	ENDIF
				
	sv_l = 0
        sv_m = ""
        sv_p = ""
        sv_n = 0
        sv_t = 0

        WHILE(sv_l < CUST.DATA.noOfRecords)
        #{
                sv_v = Format$(sv_l,"%d")
                sv_r = "<rec_"+sv_v+">"
				
                sv_u = urhk_SRV_GetVal("lienMaintLL." +sv_r+ ".key.serial_num")
                PRINT(sv_u)
                IF (sv_u == 0) THEN
                #{
                        CUST.DATA.serial_num = BANCS.OUTPARAM.srvValue
                        PRINT(CUST.DATA.serial_num)
		#}
                ENDIF
		sv_u = urhk_SRV_GetVal("lienMaintLL." +sv_r+ ".b2kId")
                PRINT(sv_u)
                IF (sv_u == 0) THEN
                #{
                        CUST.DATA.b2kId = BANCS.OUTPARAM.srvValue
                        PRINT(CUST.DATA.b2kId)
		#}
                ENDIF
		sv_u = urhk_SRV_GetVal("lienMaintLL." +sv_r+ ".b2kType")
                PRINT(sv_u)
                IF (sv_u == 0) THEN
                #{
                        CUST.DATA.b2kType = BANCS.OUTPARAM.srvValue
                        PRINT(CUST.DATA.b2kType)
		#}
                ENDIF
				
		sv_u = urhk_SRV_GetVal("lienMaintLL." +sv_r+ ".lienReasonCode.refCode")
                PRINT(sv_u)
                IF (sv_u == 0) THEN
                #{
                        CUST.DATA.lienReasonCode = BANCS.OUTPARAM.srvValue
                        PRINT(CUST.DATA.lienReasonCode)
		#}
                ENDIF

		sv_u = urhk_SRV_GetVal("lienMaintLL." +sv_r+ ".newLienAmt")
                PRINT(sv_u)
                IF (sv_u == 0) THEN
                #{
                        CUST.DATA.newLienAmt = BANCS.OUTPARAM.srvValue
                        PRINT(CUST.DATA.newLienAmt)
		#}
                ENDIF

		sv_u = urhk_SRV_GetVal("lienMaintLL." +sv_r+ ".oldLienAmt")
                PRINT(sv_u)
                IF (sv_u == 0) THEN
                #{
                        CUST.DATA.oldLienAmt = BANCS.OUTPARAM.srvValue
                        PRINT(CUST.DATA.oldLienAmt)
		#}
                ENDIF
		######
		lv_i = "existingCode|select LIEN_REASON_CODE from tbaadm.alt where B2K_ID = ?SVAR and bank_id = ?SVAR and acid = ?SVAR and rownum='1' "
		BANCS.INPARAM.BINDVARS = CUST.DATA.b2kId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.acid
		lv_j = urhk_dbSelectWithBind(lv_i)
		if(lv_j == 0) then
			CUST.DATA.existingCode = BANCS.OUTPARAM.existingCode
			print(CUST.DATA.existingCode)
		else
			CUST.DATA.existingCode = ""			
		endif
		######
		IF((CUST.DATA.lienReasonCode == "FDRLA") OR (CUST.DATA.existingCode =="FDRLA")) THEN
		#{
		####################Get The work class allowed to modify
		CUST.DATA.UserAllowed = "N"
                BANCS.INPUT.moduleName = "ACCTMAINTENCE"
                BANCS.INPUT.parameterId = "CADFDR"
                CALL("getcparamvalue.scr")
                IF(BANCS.OUTPUT.parameterVal != "")THEN
                #{
                        print(BANCS.OUTPUT.parameterVal)
                        lv_l = STRLEN(BANCS.OUTPUT.parameterVal)
                        print(lv_l)
                        CUST.DATA.AllowedEmpId=BANCS.OUTPUT.parameterVal
                        print(CUST.DATA.AllowedEmpId)
                        WHILE(lv_l > 0)
                        #{
                                sv_g = GETPOSITION(CUST.DATA.AllowedEmpId,",")
                                print(sv_g)
                                IF (sv_g == 0) THEN
                                #{
                                        CUST.DATA.allEmpId = CUST.DATA.AllowedEmpId
                                        print(CUST.DATA.allEmpId)
                                        CUST.DATA.AllowedEmpId = ""
                                        #}
                                ELSE
                                        #{
                                        CUST.DATA.allEmpId = TRIM(MID$(CUST.DATA.AllowedEmpId,0,sv_g - 1))
                                        CUST.DATA.AllowedEmpId = MID$(CUST.DATA.AllowedEmpId,sv_g,lv_l)
                                #}
                                ENDIF
                                print(CUST.DATA.allEmpId)
				IF(BANCS.STDIN.EmployeeId == CUST.DATA.allEmpId)THEN
				#{
						CUST.DATA.UserAllowed = "Y"
                            			GOTO ENDOFSCRIPT				
				#}
				ENDIF
				IF(BANCS.STDIN.EmployeeId != CUST.DATA.allEmpId)THEN
				#{
					IF((CUST.DATA.lienReasonCode != CUST.DATA.existingCode) OR (CUST.DATA.newLienAmt != CUST.DATA.oldLienAmt)) THEN
					#{
						CUST.DATA.UserAllowed = "N"
					#}
					ELSE
					#{
						CUST.DATA.UserAllowed = "Y"
					#}
					ENDIF			
				#}
				ENDIF
                                print(CUST.DATA.AllowedEmpId)
                                lv_l = STRLEN(CUST.DATA.AllowedEmpId)
                                print(sv_l)
                        #}
                        DO
                #}
		ELSE
		#{
				BANCS.OUTPUT.successOrFailure="F"
	                        sv_m = "Users to Alter this Lien Are not Maintained. Please contact Administrator"
                            	sv_u = urhk_SRV_SetErr(sv_m)
				GOTO ENDOFSCRIPT	
		#}
                ENDIF

		OUTPUT:
		IF(CUST.DATA.UserAllowed == "N") THEN
		#{
				BANCS.OUTPUT.successOrFailure="F"
	                        sv_m = "This lien lifting/mod/add is not allowed to your work class: FDRLA"
                            	sv_u = urhk_SRV_SetErr(sv_m)
				GOTO ENDOFSCRIPT
		#}
		ENDIF	
		#}
		ENDIF
		####################		
		NEXTREC:
                sv_l = sv_l + 1
                PRINT(sv_l)
            #}
            DO
ENDOFSCRIPT:         
EXITSCRIPT
#TRACE OFF
END-->
