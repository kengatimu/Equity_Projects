sv_s = sv_s + "(SELECT BANK_ID,(case when FXD_CRNCY_CODE = 'SDG' THEN  VAR_CRNCY_UNITS END )SDG  "
sv_s = sv_s + "FROM TBAADM.RTL WHERE FXD_CRNCY_CODE = 'SDG' AND VAR_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR)m, "
