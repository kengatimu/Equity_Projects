sv_s = sv_s + "FROM TBAADM.RTL WHERE VAR_CRNCY_CODE = 'RWF' AND FXD_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR)s, "
