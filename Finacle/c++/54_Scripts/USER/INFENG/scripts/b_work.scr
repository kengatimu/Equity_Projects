sv_s = " euroRate,gbpRate,usdRate,aedRate,audRate,cadRate,chfRate,cnyRate,dkkRate,inrRate,jpyRate,nokRate,sdgRate,sekRate, "
sv_s = sv_s + " sspRate,yenRate,zarRate,ugxRate,rwfRate,tzsRate|"
sv_s = sv_s + "select EUR as CRNCY_EUR,GBP as CRNCY_GBP,USD as CRNCY_USD,AED as CRNCY_AED,AUD as CRNCY_AUD, "
sv_s = sv_s + "CAD as CRNCY_CAD,CHF as CRNCY_CHF,CNY as CRNCY_CNY,DKK as CRNCY_DKK,INR as CRNCY_INR,JPY as CRNCY_JPY, "
sv_s = sv_s + "NOK as CRNCY_NOK,SDG as CRNCY_SDG,SEK as CRNCY_SEK,SSP as CRNCY_SSP,YEN as CRNCY_YEN,ZAR as CRNCY_ZAR, "
sv_s = sv_s + "UGX as CRNCY_UGX,RWF as CRNCY_RWF,TZS as CRNCY_TZS from "
sv_s = sv_s + "(SELECT BANK_ID,(case when FXD_CRNCY_CODE = 'EUR' THEN  VAR_CRNCY_UNITS END )EUR "  
sv_s = sv_s + "FROM TBAADM.RTL WHERE FXD_CRNCY_CODE = 'EUR' AND VAR_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR)a,  "
sv_s = sv_s + "(SELECT BANK_ID,(case when FXD_CRNCY_CODE = 'GBP' THEN  VAR_CRNCY_UNITS END )GBP  "
