sv_s = sv_s + "WHERE a.BANK_ID = b.BANK_ID  and b.BANK_ID = c.BANK_ID and c.BANK_ID = d.BANK_ID and d.BANK_ID = e.BANK_ID "
sv_s = sv_s + "and e.BANK_ID = f.BANK_ID and f.BANK_ID = g.BANK_ID and g.BANK_ID = h.BANK_ID and h.BANK_ID = i.BANK_ID and i.BANK_ID = j.BANK_ID "
sv_s = sv_s + "and j.BANK_ID = k.BANK_ID and k.BANK_ID = l.BANK_ID and l.BANK_ID = m.BANK_ID and m.BANK_ID = n.BANK_ID and n.BANK_ID = o.BANK_ID "
sv_s = sv_s + "and o.BANK_ID = p.BANK_ID and p.BANK_ID = q.BANK_ID and q.BANK_ID = r.BANK_ID and r.BANK_ID = s.BANK_ID and s.BANK_ID = t.BANK_ID "
print (sv_s)
