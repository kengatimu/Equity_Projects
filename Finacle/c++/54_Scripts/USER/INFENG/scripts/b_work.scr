sv_s = sv_s + "FROM TBAADM.RTL WHERE FXD_CRNCY_CODE = 'SEK' AND VAR_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR)n, "
