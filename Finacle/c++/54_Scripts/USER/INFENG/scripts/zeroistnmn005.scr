	sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|" + CUST.KCBR.narr1)
	sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.KCBR.refCode)
	
	#---------------------------------------------------------
