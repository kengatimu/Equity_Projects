<--start
trace on
sv_a=urhk_B2k_PrintRepos("BANCS")
sv_a = urhk_SRV_GetVal("sourceSchm.schmCode")
sv_b=BANCS.OUTPARAM.srvValue
print(sv_b)

sv_c=urhk_SRV_GetVal("xferAcct.foracid")
sv_d=BANCS.OUTPARAM.srvValue
PRINT(sv_d)
sv_e=""


IF ((sv_b=="SB199") OR (sv_b=="CA299")) THEN
	IF ((BANCS.STDIN.userWorkClass!="150") AND (BANCS.STDIN.userWorkClass!="200") AND (BANCS.STDIN.userWorkClass!="999"))THEN
		sv_u = urhk_SRV_SetErr(" Verification can only be done by WC 150/200 for SB199/CA299......." )
		BANCS.OUTPUT.successOrFailure = "F"
		exitscript


	ENDIF



ENDIF

	sv_s = "AcctStatus|select acct_status FROM tbaadm.smt WHERE bank_id =?SVAR and acid in (select acid from tbaadm.gam where foracid =?SVAR ) "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + sv_d
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF(sv_d == 0 ) THEN
	#{
		print(BANCS.OUTPARAM.AcctStatus)
		sv_e=BANCS.OUTPARAM.AcctStatus

	#}
	ENDIF
	IF ((sv_e =="D") OR (sv_e =="I")) THEN
		IF ((BANCS.STDIN.userWorkClass!="150") AND (BANCS.STDIN.userWorkClass!="200") AND (BANCS.STDIN.userWorkClass !="999")) THEN
			PRINT(BANCS.STDIN.userWorkClass)
			sv_u = urhk_SRV_SetErr(" User does not have enough permission for Dormant/Inactive.Transfer to be done by 150/200")
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		ENDIF
	ENDIF


trace off
end-->