<--START
	TRACE ON
	
	
	sv_r = urhk_B2k_PrintRepos("BANCS")
	print(sv_r)
			
			BANCS.INPUT.TranId=""
			print(CUST.SALTTUM.LienAmt)
			print(CUST.SALTTUM.drAcctId)
		BANCS.INPARAM.BINDVARS=BANCS.INPUT.TranId+ "|"+ mid$(BANCS.STDIN.BODDate,0,10)+"|"
        BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "N" + "|"
        BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + CUST.SALTTUM.LienAmt + "|"
		BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + CUST.SALTTUM.drAcctId
		
		sv_s = "INSERT INTO  CUSTOM.csalbpp_trans ("
         sv_s = sv_s + "TRAN_ID, TRAN_DATE, LIEN_FLG, BANK_ID, TRAN_AMT, FORACID) VALUES ("
        sv_s = sv_s + "?SVAR,"
        sv_s = sv_s + "to_date(?SVAR,'dd-mm-yyyy'),"
        sv_s = sv_s + "?SVAR,"
		sv_s = sv_s + "?SVAR,"
		sv_s = sv_s + "?SVAR,"
		sv_s = sv_s + "?SVAR)"

        PRINT(sv_s)
        sv_d= urhk_dbSqlWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d!=0) THEN
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	

        
        
	TRACE OFF
