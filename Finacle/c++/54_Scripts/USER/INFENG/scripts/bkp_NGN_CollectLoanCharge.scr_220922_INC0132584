		print(CUST.LADIS.netDisbChrge)
		print(("CUST").("LADIS").("data_chargeType" + sv_d))
		sv_o = urhk_SetUrhkInp("collRefundMsg.collRefundRsltLL.<rec_"+sv_b+">.key.chrgType|"+("CUST").("LADIS").("data_chargeType" + sv_d))
