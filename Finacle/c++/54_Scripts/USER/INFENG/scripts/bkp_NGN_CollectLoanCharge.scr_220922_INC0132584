		sv_o = urhk_SetUrhkInp("collRefundMsg.collRefundRsltLL.<rec_"+sv_b+">.chrgAmt|"+CUST.LADIS.UserChargeCrncy)
		sv_o = urhk_SetUrhkInp("collRefundMsg.collRefundRsltLL.<rec_"+sv_b+">.userCalcChrgAmt|"+CUST.LADIS.UserChargeCrncy)
		sv_o = urhk_SetUrhkInp("collRefundMsg.collRefundRsltLL.<rec_"+sv_b+">.currentCollRefundAmt|"+CUST.LADIS.UserChargeCrncy)
		sv_o = urhk_SetUrhkInp("collRefundMsg.collRefundRsltLL.<rec_"+sv_b+">.assmntCollFlg|Y")
		
