<--start
trace on
	BANCS.INPUT.OdAcct = ""
	sv_u = urhk_SRV_GetVal("acct.foracid")
	lv_i=BANCS.OUTPARAM.srvValue
	print(lv_i)

	sv_u = urhk_SRV_GetVal("effAvailBal")
	lv_j=BANCS.OUTPARAM.srvValue
	print(lv_j)

	sv_u = urhk_SRV_GetVal("availBal")
	lv_k=BANCS.OUTPARAM.srvValue
	print(lv_k)

	sv_u = urhk_SRV_GetVal("ledgerBalAmt")
	lv_l=BANCS.OUTPARAM.srvValue
	print(lv_l)
	BANCS.INPUT.OdAcct = ""
	sv_b = urhk_getAcctDetailsInRepository(lv_i)
	if(sv_b == 0) then
		sv_e = BANCS.OUTPARAM.sanctionLimit
		sv_s = BANCS.OUTPARAM.cleanAdhocLimit
		sv_o = BANCS.OUTPARAM.FxEffAvailableAmt
		sv_t = BANCS.OUTPARAM.EffAvailableAmt
		BANCS.INPUT.aSchmCode = BANCS.OUTPARAM.schmCode
		BANCS.INPUT.acustId = BANCS.OUTPARAM.custId
	endif

				lv_b = "allowSmeLimit | select count(*) from tbaadm.fcftt,tbaadm.gam where  gam.bank_id=?SVAR and fcftt.bank_id=?SVAR and gam.acid=fcftt.acid and gam.foracid=?SVAR and fcftt.FREE_CODE_19='SMEODA-ACCESS' and gam.entity_cre_flg='Y' and gam.del_flg='N' and fcftt.entity_cre_flg='Y' and fcftt.del_flg='N' "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + lv_i
				lv_b = urhk_dbSelectWithBind(lv_b)
				if(lv_b==0)then
				#{
						lv_e = BANCS.OUTPARAM.allowSmeLimit
				#}
				else
				#{
						lv_e = "0"
				#}
				endif
				if(cdouble(lv_e)>=1)then
				#{
					sv_d = "OdAcct|select foracid from tbaadm.gam where bank_id=?SVAR and cust_id=?SVAR " 	
					sv_d = sv_d + " and schm_code='OD553' and acct_cls_flg='N' and entity_cre_flg='Y' "
					sv_d = sv_d + " and del_flg='N' and rownum<=1"
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.acustId
					sv_u = urhk_dbSelectWithBind(sv_d)
					if(sv_u==0)then
						BANCS.INPUT.OdAcct = BANCS.OUTPARAM.OdAcct
					else
						BANCS.INPUT.OdAcct = ""
					endif
				#}
				endif
	IF(BANCS.INPUT.OdAcct != "") THEN
		sv_b = urhk_getAcctDetailsInRepository(BANCS.INPUT.OdAcct)
		if(sv_b == 0) then
			lv_e = BANCS.OUTPARAM.sanctionLimit
			lv_s = BANCS.OUTPARAM.cleanAdhocLimit
			lv_o = BANCS.OUTPARAM.FxEffAvailableAmt
			lv_t = BANCS.OUTPARAM.EffAvailableAmt
			BANCS.INPUT.crncy_code = BANCS.OUTPARAM.acctCrncyCode
			BANCS.INPUT.aSchmCode = BANCS.OUTPARAM.schmCode
			BANCS.INPUT.acustId = BANCS.OUTPARAM.custId
		endif
		lv_u = cdouble(lv_t) + cdouble(sv_t)
		print(lv_u)

	if (lv_u != "") then
		BANCS.INPARAM.InputAmount = lv_u
		BANCS.INPARAM.FromCurrency = BANCS.INPUT.crncy_code 
		BANCS.INPARAM.AmountWidth = 25 
		sv_z = urhk_B2k_floatWithComma("") 
		if(sv_z == 0) then 
			lv_j = BANCS.OUTPARAM.OutputAmount
			print(lv_j)
    		endif 
	endif
		print(lv_j)
		sv_u = urhk_SRV_SetVal("effAvailBal|" +lv_j)
		print(sv_u)
	ENDIF
##trace off
end-->
