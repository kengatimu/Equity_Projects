<--start
trace on

        sv_r = REPEXISTS("CUST")
        IF (sv_r == 0) THEN
        #{
		 CREATEREP("CUST")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST", "DATA")
        IF (sv_r == 0) THEN
        #{
		 CREATECLASS("CUST", "DATA", 5)
        #}
        ENDIF

	print(CUST.DATA.sol_id)
	print(CUST.DATA.tot_payble)
	print(CUST.DATA.tot_excise)
	print(CUST.DATA.dr_acct_income)
	print(CUST.DATA.cr_acct_payble)
	print(CUST.DATA.cr_acct_excise)	

	CUST.DATA.BODDate = MID$(BANCS.STDIN.BODDate,0,10)

	#===================================
	# STEP 1 : INITIALIZE THE MTT
	#===================================

        BANCS.INPARAM.PostTranFlg                       = "Y"
        BANCS.INPARAM.CommitFlg                         = "Y"
        BANCS.INPARAM.CheckExceptions                   = "N"
        BANCS.INPARAM.InsertTranWithValidnFlg           = "N"
        BANCS.INPARAM.ValidationFlag                    = "N"
        BANCS.INPARAM.RestrictModifyInd                 = "FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw                  = "Y"
        BANCS.INPARAM.IgnoreExcp                        = "I"

        lv_z = urhk_MTTS_Initialize("")
        PRINT (lv_z)

	sv_u = urhk_MTTS_PopulateInputDetails("")

	print(BANCS.STDIN.BODDate)
	MTT.TranDetails.TranType 	= "T" 
	MTT.TranDetails.TranSubType 	= "BI" 
	MTT.TranDetails.IgnoreExcp 	= "I"
	MTT.TranDetails.Consolidate 	= "Y"
	MTT.TranDetails.Remarks 	= "DATE"

	sv_v = "DATA"
	print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("DATA")
	print(sv_u)
	

	#---------------------------------
	# Debit 
	#---------------------------------
		#================
		# Payble
		#================
			MTT.PartTranDetails.Account             = CUST.DATA.dr_acct_income 
			MTT.PartTranDetails.RefCurrency         = CUST.DATA.tran_crncy_code  
			MTT.PartTranDetails.TranCurrency        = CUST.DATA.tran_crncy_code  
			MTT.PartTranDetails.Amount              = ""
			MTT.PartTranDetails.Particulars         = "SMS INCOME PAYBLE " + CUST.DATA.sol_id 
			MTT.PartTranDetails.RefAmount           = -CDOUBLE(CUST.DATA.tot_payble) 
			MTT.PartTranDetails.TranIdentifier      = sv_v
			MTT.PartTranDetails.Consolidate         = "N"
			MTT.PartTranDetails.ValueDate           = "0" 
			MTT.PartTranDetails.Remarks             = CUST.DATA.remarks 
			MTT.PartTranDetails.RateCode            = "TTS"
			MTT.PartTranDetails.Rate                = ""
			MTT.PartTranDetails.ParticularsCode     = ""		

			sv_a=urhk_B2K_PrintRepos("MTT")
			
			sv_b = urhk_MTTS_definePartTran("D_DATA")
			print(sv_b)
			
		#==================
		# excise
		#==================
			
			MTT.PartTranDetails.Account             = CUST.DATA.dr_acct_income
                        MTT.PartTranDetails.RefCurrency         = CUST.DATA.tran_crncy_code 
                        MTT.PartTranDetails.TranCurrency        = CUST.DATA.tran_crncy_code 
                        MTT.PartTranDetails.Amount              = ""
                        MTT.PartTranDetails.Particulars         = "SMS INCOME EXCISE " + CUST.DATA.sol_id 
                        MTT.PartTranDetails.RefAmount           = -CDOUBLE(CUST.DATA.tot_excise)
                        MTT.PartTranDetails.TranIdentifier      = sv_v
                        MTT.PartTranDetails.Consolidate         = "N"
                        MTT.PartTranDetails.ValueDate           = "0"
                        MTT.PartTranDetails.Remarks             = CUST.DATA.remarks
                        MTT.PartTranDetails.RateCode            = "TTS"
                        MTT.PartTranDetails.Rate                = ""
			MTT.PartTranDetails.ParticularsCode     = ""		

			sv_a=urhk_B2K_PrintRepos("MTT")

			sv_b = urhk_MTTS_definePartTran("D_DATA")
			print(sv_b)

	#------------------------------------
	# Credit  
	#------------------------------------
		#================
		# Payble 
		#================
			MTT.PartTranDetails.Account             = CUST.DATA.cr_acct_payble 
			MTT.PartTranDetails.RefCurrency         = CUST.DATA.tran_crncy_code  
			MTT.PartTranDetails.TranCurrency        = CUST.DATA.tran_crncy_code  
			MTT.PartTranDetails.Amount              = ""
			MTT.PartTranDetails.Particulars         = "SMS INCOME PAYBLE " + CUST.DATA.sol_id 
			MTT.PartTranDetails.RefAmount           = CDOUBLE(CUST.DATA.tot_payble) 
			MTT.PartTranDetails.TranIdentifier      = sv_v
			MTT.PartTranDetails.Consolidate         = "N"
			MTT.PartTranDetails.ValueDate           = "0" 
			MTT.PartTranDetails.Remarks             = CUST.DATA.remarks 
			MTT.PartTranDetails.RateCode            = "TTS"
			MTT.PartTranDetails.Rate                = ""
			MTT.PartTranDetails.ParticularsCode     = ""		

			sv_a=urhk_B2K_PrintRepos("MTT")
			
			sv_b = urhk_MTTS_definePartTran("C_DATA")
			print(sv_b)
			
		#==================
		# excise duty
		#==================
			
			MTT.PartTranDetails.Account             = CUST.DATA.cr_acct_excise 
                        MTT.PartTranDetails.RefCurrency         = CUST.DATA.tran_crncy_code 
                        MTT.PartTranDetails.TranCurrency        = CUST.DATA.tran_crncy_code 
                        MTT.PartTranDetails.Amount              = ""
                        MTT.PartTranDetails.Particulars         = "SMS INCOME EXCISE " + CUST.DATA.sol_id 
                        MTT.PartTranDetails.RefAmount           = CDOUBLE(CUST.DATA.tot_excise)
                        MTT.PartTranDetails.TranIdentifier      = sv_v
                        MTT.PartTranDetails.Consolidate         = "N"
                        MTT.PartTranDetails.ValueDate           = "0"
                        MTT.PartTranDetails.Remarks             = CUST.DATA.remarks
                        MTT.PartTranDetails.RateCode            = "TTS"
                        MTT.PartTranDetails.Rate                = ""
			MTT.PartTranDetails.ParticularsCode     = ""		

			sv_a=urhk_B2K_PrintRepos("MTT")

			sv_b = urhk_MTTS_definePartTran("C_DATA")
			print(sv_b)

	#-----------------------------------
	# CLOSE THE DATASACTION
	#-----------------------------------
	
	sv_b = urhk_MTTS_EndDefinition("")
	print(sv_b)
	
        sv_a = urhk_B2k_PrintRepos("MTT")


	sv_u = urhk_MTTS_Close("")
	print(sv_u)


	IF (FIELDEXISTS(BANCS.OUTPARAM.MTTPostingStatus)) then
	#{
		print(BANCS.OUTPARAM.MTTPostingStatus)
	#}
	ENDIF

	IF (FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) then
	#{
		print(BANCS.OUTPARAM.MTTTranId)
		CUST.DATA.TRAN_ID = BANCS.OUTPARAM.MTTTranId
	#}
	ENDIF
	
	#IF (FIELDEXISTS(MTT.Error.Description)) then
	#{
	#		print(MTT.Error.Description)
	#		CUST.DATA.Error_Description = MTT.Error.Description
	#		print(CUST.DATA.Error_Description)
	#}
	#ENDIF

END_DEFINITION:

exitscript
TRACE OFF
END-->

