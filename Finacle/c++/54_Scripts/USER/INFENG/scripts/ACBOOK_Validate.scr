<--start
trace on
	sv_a = ""
	sv_b = ""
	sv_c = ""
	sv_d = ""
	if(BANCS.STDIN.contextBankId!="54")then
		exitscript
	endif
	sv_c=urhk_VAL_GetVal("from_acct_num")
	sv_a=BANCS.OUTPARAM.fldValue

	sv_c=urhk_VAL_GetVal("to_acct_num")
	sv_b=BANCS.OUTPARAM.fldValue

	sv_c=urhk_VAL_GetVal("from_schm_code")
	sv_c=BANCS.OUTPARAM.fldValue

	sv_c=urhk_VAL_GetVal("to_schm_code")
	sv_d=BANCS.OUTPARAM.fldValue
	if(sv_a!="")then
		sv_u = urhk_getAcctDetailsInRepository(sv_a)
		if(sv_u!=0)then
			exitscript
		else
			BANCS.INPUT.odSchmCode = BANCS.OUTPARAM.schmCode
			print(BANCS.INPUT.odSchmCode)
			BANCS.INPUT.crCif  = BANCS.OUTPARAM.cifId
			BANCS.INPUT.EffBal = BANCS.OUTPARAM.EffAvailableAmt
			print(BANCS.INPUT.EffBal)
			BANCS.INPUT.cClearBalance = BANCS.OUTPARAM.clearBalance
			print(BANCS.INPUT.cClearBalance)
		endif
		if((BANCS.INPUT.odSchmCode=="OD542")or(BANCS.INPUT.odSchmCode=="OD543")or(BANCS.INPUT.odSchmCode=="OD544")or(BANCS.INPUT.odSchmCode=="OD545")or(BANCS.INPUT.odSchmCode=="OD546"))then
			if(cdouble(BANCS.INPUT.cClearBalance)>=0)then
				sv_g = urhk_VAL_SetErr("FLD_NAME=from_acct_num|ERR_TYPE=M|ERR_CODE=MSG0337981")
			endif
		endif
	endif
trace off
end-->
