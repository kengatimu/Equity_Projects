					#}
					ENDIF
					
					IF ((CASH.WITH.ac_sol == CUST.CPARAM.acSol1) OR (CASH.WITH.ac_sol == "177") OR (CASH.WITH.ac_sol == "056")) THEN
					#{
						CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.Tot_Amt)
						CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.with_amt)
						CASH.WITH.with_desc = CUST.CPARAM.withDesc2 + BANCS.STDIN.mySolId
					#}
					ENDIF

					IF (CASH.WITH.ac_sol == "160") THEN
					#{
						CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.Tot_Amt)
						CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.with_amt)
						CASH.WITH.with_desc = CUST.CPARAM.withDesc2 + BANCS.STDIN.mySolId
					#}
					ENDIF
				#}
				ENDIF
				
				CASH.WITH.With_Flg = "N"
				print(CASH.WITH.With_Flg)
				#}
			ELSE
				#{
				IF ((CASH.WITH.With_Flg == "Y") AND (CASH.WITH.Trf_Flg != "Y")) THEN
				#{
					#IF (CASH.WITH.With_Flg == "Y") THEN
					#{
					CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt4)
