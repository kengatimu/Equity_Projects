				#{
					IF ((CASH.WITH.ac_sol != "177") AND (CASH.WITH.ac_sol != CUST.CPARAM.acSol1) AND (CASH.WITH.ac_sol != "056") AND (CASH.WITH.ac_sol != "160") AND (CASH.WITH.mySolIdal3!="Y")) THEN
					#{
						CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt2)
						PRINT(CASH.WITH.Tot_Amt)
						CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt2)
						PRINT(CASH.WITH.with_amt)
						CASH.WITH.with_desc = CUST.CPARAM.withDesc2
					#}
					ENDIF
					IF ((CASH.WITH.ac_sol == CUST.CPARAM.acSol2) OR (CASH.WITH.ac_sol == CUST.CPARAM.acSol3) OR (CASH.WITH.ac_sol == CUST.CPARAM.acSol4))  THEN
					#{
						CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.Tot_Amt)
						CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.with_amt)
						CASH.WITH.with_desc = CUST.CPARAM.withDesc2
					#}
					ENDIF
				#}
				ENDIF
				#new porting code
				#changes done as per porting3
				IF ((BANCS.STDIN.mySolId == CUST.CPARAM.mySolId3) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId5) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId6) OR (CASH.WITH.mySolIdal2=="Y")) THEN
				#{
					IF  ((CASH.WITH.ac_sol != CUST.CPARAM.acSol3) AND (CASH.WITH.ac_sol != CUST.CPARAM.acSol5) AND (CASH.WITH.ac_sol != CUST.CPARAM.acSol6) AND (CASH.WITH.ac_solsup=="N") AND (CASH.WITH.Ac_Number!="0950260559692") AND (CASH.WITH.Ac_Number!="0950261420369") AND (CASH.WITH.Ac_Number!="0950266393031")) THEN
					#{
						IF (CASH.WITH.schmCode != CUST.CPARAM.schmCode1) THEN
						#{
							CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt3)
							PRINT(CASH.WITH.Tot_Amt)
							CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt3)
							PRINT(CASH.WITH.with_amt)
							CASH.WITH.with_desc = CUST.CPARAM.withDesc2  + BANCS.STDIN.mySolId
						#}
