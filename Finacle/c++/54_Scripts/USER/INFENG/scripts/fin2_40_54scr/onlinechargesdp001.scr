				ENDIF
				#}
			ELSE
				#{
				CASH.WITH.Tot_Amt = "0"
			#}
			ENDIF
		#}
		ENDIF
		
		IF ((CASH.WITH.type == "C") AND (CASH.WITH.stype == "NP")) THEN
		#{
			IF (CASH.WITH.Int_Flg == "Y") THEN
			#{
				CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt1)
				PRINT(CASH.WITH.Tot_Amt)
				CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt1)
