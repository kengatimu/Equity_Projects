#------------------------------------------------------------------------------------------------    
#   Name			: laadisbdp005.scr
#   Description		: Inclusion for Merchandizing system--Laptop projects
#   Date			: 31-03-2013
#   Author			: Sateesh
#   Input			: NA
#   Output			: NA
#   Called Script	: None
#   Calling Script	: laadisbdp008.scr
#   Menu Option		:
#	Srl. No         Date            Author          	Description.
#	-------         ------          ------          	------------
#   1.0             31-03-2013      Sateesh				Original Version
#   2.0             07-08-2013      Bharath				Added different cust id condition
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="ae80ad59b3eae2a02c495874dce5a1beafadbb2138e98075d8ce66c18cc768b1"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	CUST.LADISB.loanAcctId	= TRIM(BANCS.INPUT.loanAcctId)
	CUST.LADISB.disbAmt		= BANCS.INPUT.disbAmt
	CUST.LADISB.refNum		= TRIM(BANCS.INPUT.refNum)
	CUST.LADISB.crAcctId	= TRIM(BANCS.INPUT.crAcctId)
	
	PRINT(CUST.LADISB.loanAcctId)
	PRINT(CUST.LADISB.disbAmt)
	PRINT(CUST.LADISB.refNum)
	print(CUST.LADISB.crAcctId)
	
	#################################################################################
	# Getting values from cparam by calling common script
	#################################################################################
	
	PRINT(CUST.LADISB.loanAcctId)
	CALL("laadisbdp004.scr")
	IF (CUST.LADISB.errMsg != "" ) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.LADISB.stepVal	="5"
	CALL("laadisbdp008.scr")
	IF (CUST.LADISB.errMsg != "" ) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(CUST.LADISB.amtAvailForDisb)
	
	#################################################################################
	# Inclusion for Stima Loan (loanType S-SmitaLoan)
	#################################################################################
	IF (CUST.LADISB.loanType == "S") THEN
	#{
		IF (CUST.LADISB.crAcctId != CUST.CPARAM.stCrAcctId) THEN
		#{
			CUST.LADISB.errMsg = "Credit Account number is invalid, SmitaLoan Credit account should be " + CUST.CPARAM.stCrAcctId
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	#----------------------------------------------------------------
	# Getting parameter value for DIFF_CUST_LIST---!LA531!LA514!
	#----------------------------------------------------------------
	BANCS.INPUT.moduleName = "LOANDISB"
	BANCS.INPUT.parameterId = "DIFF_CUST_LIST"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.custDiffList = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.custDiffList)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "CPARAM setup is not done for DIFF_CUST_LIST"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_a = GETPOSITION(CUST.CPARAM.custDiffList,CUST.LADISB.laSchmCode)
	IF(sv_a == 0 ) THEN
	#{
		#---------------------------------------------------------------------
		#---Getting the credit account's cif id
		#---------------------------------------------------------------------
		sv_s=""
		sv_s = sv_s + " crAcctCifId|"
		sv_s = sv_s + " SELECT gam.cif_id"
		sv_s = sv_s + " FROM TBAADM.GAM"
		sv_s = sv_s + " WHERE GAM.foracid = ?SVAR"
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = ""
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.crAcctId 	+ "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		IF ( sv_d != 0 ) THEN
		#{
			CUST.LADISB.errMsg = "Error in finding cifid of credit account"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.crAcctCifId	 = BANCS.OUTPARAM.crAcctCifId
			print(CUST.LADISB.crAcctCifId)
		#}
		ENDIF
		
		#################################################################################
		# To Stop different Cust Id Disbursal
		#################################################################################
		print(CUST.LADISB.laCifId)
		IF (CUST.LADISB.crAcctCifId != CUST.LADISB.laCifId) THEN
		#{
			CUST.LADISB.errMsg = "Different Cust IDs...cannot proceed"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#################################################################################
	# Initializing required variables
	#################################################################################
	CUST.LADISB.ysum			= ""
	CUST.LADISB.errMsg			= ""
	sv_u = urhk_Setorbout("Error|dummy")
	sv_u = urhk_Setorbout("crAcctId|dummy")
	
	#################################################################################
	# Inclusion for Merchandizing system--Laptop projects
	#################################################################################
	IF ((CUST.LADISB.crAcctId != "")  AND (CUST.LADISB.loanAcctId != "")) THEN
	#{
		IF ((CUST.LADISB.laSchmCode == CUST.CPARAM.lpSchmCode)) THEN
		#{
			sv_u = urhk_getAcctDetailsInRepository (CUST.LADISB.crAcctId)
			PRINT(sv_u)
			
			IF (sv_u != 0) THEN
			#{
				CUST.LADISB.errMsg = "Credit Account number is invalid "
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.LADISB.crCustId 			= trim(BANCS.OUTPARAM.custId)
				PRINT(CUST.LADISB.crCustId)
				
				PRINT(BANCS.OUTPARAM.EffAvailableAmt)
				CUST.LADISB.availableAmtCr		= BANCS.OUTPARAM.EffAvailableAmt
				PRINT(CUST.LADISB.availableAmtCr)
			#}
			ENDIF
			
			sv_s = " repPerdMths|"
			sv_s = sv_s + " SELECT"
			sv_s = sv_s + " LAM.rep_perd_mths"
			sv_s = sv_s + " FROM"
			sv_s = sv_s + " TBAADM.GAM,TBAADM.LAM"
			sv_s = sv_s + " WHERE"
			sv_s = sv_s + " GAM.acid = LAM.acid"
			sv_s = sv_s + " AND LAM.bank_id = GAM.bank_id"
			sv_s = sv_s + " AND GAM.foracid=?SVAR"
			sv_s = sv_s + " AND GAM.bank_id =?SVAR"
			
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS =  CUST.LADISB.loanAcctId + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbselectWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d != 0) THEN
			#{
				CUST.LADISB.errMsg = "Error in getting rows from Gam AND LAM tables"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.LADISB.repPerdMths	= BANCS.OUTPARAM.repPerdMths
				PRINT(CUST.LADISB.repPerdMths)
				
				CUST.LADISB.laceAmt1 = (CDOUBLE(CUST.LADISB.amtAvailForDisb) * CDOUBLE(CUST.CPARAM.lpLacePrcnt))/100
				PRINT(CUST.LADISB.laceAmt1)
				
				CUST.LADISB.insurance1 = (((CDOUBLE(CUST.LADISB.amtAvailForDisb) * CDOUBLE(CUST.CPARAM.lpInsurPrcnt))/100) * (CDOUBLE(CUST.LADISB.repPerdMths)/CDOUBLE(CUST.CPARAM.lpRepMonDiv)))
				PRINT(CUST.LADISB.insurance1)
			#}
			ENDIF
			
			IF (CUST.LADISB.refNum == "") THEN
			#{
				CUST.LADISB.errMsg = "Pls put Loan A/c No as Transaction Remarks"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_s = "countt|"
				sv_s = sv_s + " SELECT"
				sv_s = sv_s + " COUNT(1)"
				sv_s = sv_s + " FROM"
				sv_s = sv_s + " CUSTOM.ORDER_DETAILS OD,CUSTOM.ORDER_HEADER OH"
				sv_s = sv_s + " WHERE OD.det_ord_id = OH.ord_id"
				sv_s = sv_s + " AND OD.bank_id = OH.bank_id"
				sv_s = sv_s + " AND OD.det_ord_order_no =?SVAR"
				sv_s = sv_s + " AND OH.ord_status ='V'"
				sv_s = sv_s + " AND OD.bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.LADISB.refNum + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				PRINT(sv_d)
				
				IF ( sv_d != 0 ) THEN
				#{
					CUST.LADISB.errMsg = "DB Error!"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					PRINT(BANCS.OUTPARAM.countt)
					CUST.LADISB.countt 	=BANCS.OUTPARAM.countt
					PRINT(CUST.LADISB.countt)
					
					IF (CINT(CUST.LADISB.countt) <= 0) THEN
					#{
						CUST.LADISB.errMsg = "Id entered in Transaction Remarks is incorrect"
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					IF (CINT(CUST.LADISB.countt) == 1) THEN
					#{
						sv_s = ""
						sv_s = sv_s + " detSupBasePrice|"
						sv_s = sv_s + " SELECT"
						sv_s = sv_s + " OD.det_sup_base_price"
						sv_s = sv_s + " FROM"
						sv_s = sv_s + " CUSTOM.ORDER_DETAILS OD"
						sv_s = sv_s + " WHERE"
						sv_s = sv_s + " OD.det_ord_order_no=?SVAR"
						sv_s = sv_s + " AND OD.bank_id =?SVAR"
						PRINT(sv_s)
						BANCS.INPARAM.BINDVARS =  CUST.LADISB.refNum + "|" + BANCS.STDIN.contextBankId
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbselectWithBind(sv_s)
						PRINT(sv_d)
						
						IF (sv_d != 0) THEN
						#{
							CUST.LADISB.errMsg = "Error in getting rows from ORDER_DETAILS table"
							GOTO ENDOFSCRIPT
							#}
						ELSE
							#{
							CUST.LADISB.ysum	= BANCS.OUTPARAM.detSupBasePrice
							PRINT(CUST.LADISB.ysum)
						#}
						ENDIF
						
						IF (CUST.LADISB.operAcctFlg == "N" ) THEN
						#{
							CUST.LADISB.errMsg = "No Operative account Linked to Loan account"
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						#}
					ELSE
						#{
						IF (CINT(CUST.LADISB.countt) > 1) THEN
						#{
							sv_s = "ysum|"
							sv_s = sv_s + " SELECT"
							sv_s = sv_s + " SUM(OD.det_sup_base_price)"
							sv_s = sv_s + " FROM"
							sv_s = sv_s + " CUSTOM.ORDER_DETAILS OD"
							sv_s = sv_s + " WHERE"
							sv_s = sv_s + " OD.det_ord_order_no =?SVAR"
							sv_s = sv_s + " AND OD.bank_id 		=?SVAR"
							PRINT(sv_s)
							
							BANCS.INPARAM.BINDVARS =  CUST.LADISB.refNum + "|" + BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbselectWithBind(sv_s)
							PRINT(sv_d)
							
							IF (sv_d != 0) THEN
							#{
								CUST.LADISB.errMsg = "Error in getting rows from ORDER_DETAILS tables"
								GOTO ENDOFSCRIPT
								#}
							ELSE
								#{
								PRINT(BANCS.OUTPARAM.ysum)
								CUST.LADISB.ysum	= BANCS.OUTPARAM.ysum
								PRINT(CUST.LADISB.ysum)
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					
					PRINT(CUST.LADISB.ysum)
					PRINT(CUST.LADISB.disbAmt)
					
					PRINT(CUST.LADISB.laceAmt1)
					PRINT(CUST.LADISB.insurance1)
					PRINT(CUST.LADISB.availableAmtCr)
					
					CUST.LADISB.finalAmnt 		= CDOUBLE(CUST.LADISB.laceAmt1) + CDOUBLE(CUST.LADISB.insurance1) + CDOUBLE(CUST.LADISB.ysum)
					PRINT(CUST.LADISB.finalAmnt)
					
					CUST.LADISB.totalBal 		= CDOUBLE(CUST.LADISB.availableAmtCr) + CDOUBLE(CUST.LADISB.disbAmt)
					PRINT(CUST.LADISB.totalBal)
					
					CUST.LADISB.diff 			= CDOUBLE(CUST.LADISB.totalBal) - CDOUBLE(CUST.LADISB.finalAmnt)
					PRINT(CUST.LADISB.diff)
					
					IF ( CDOUBLE(CUST.LADISB.totalBal) < CDOUBLE(CUST.LADISB.finalAmnt)) THEN
					#{
						CUST.LADISB.errMsg = "Amount being disbursed is less than txn cost."
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "" ) THEN
		#{
			sv_u = urhk_Setorbout("Error|"+CUST.LADISB.errMsg)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
