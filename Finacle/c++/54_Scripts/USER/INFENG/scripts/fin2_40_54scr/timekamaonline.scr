##########################
CUST.ATM.sysDateadt = BANCS.STDIN.sysDate
print(CUST.ATM.sysDateadt)
	CUST.ATM.getsysdateadtstart="99"
	CUST.ATM.getsysdateadtend="88"
	CUST.ATM.getsysdateadt00flg="N"
	CUST.ATM.getsysdateadt06flg="N"
	#sv_s = "getsysdate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
	sv_s = "getsysdateampm,getsysdateadttime|select substr(to_char(sysdate ,'DD-MON-RRRR HH:MI:SS AM'),22,2) ampm, substr(to_char(sysdate ,'DD-MON-RRRR HH:MI:SS AM'),13,2) adttime from dual "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.ATM.sysDateadt
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
		CUST.ATM.getsysdateampm = BANCS.OUTPARAM.getsysdateampm
		print(CUST.ATM.getsysdateampm)
		CUST.ATM.getsysdateadttime= BANCS.OUTPARAM.getsysdateadttime
		print(CUST.ATM.getsysdateadttime)
		IF (CUST.ATM.getsysdateampm=="AM") THEN
			CUST.ATM.getsysdateadt00="00"
			print(CUST.ATM.getsysdateadt00)
			IF ( cint(CUST.ATM.getsysdateadttime) > cint(CUST.ATM.getsysdateadt00) ) THEN
				print("intime")
				CUST.ATM.getsysdateadt00flg="Y"
				print(CUST.ATM.getsysdateadt00flg)
			ENDIF
			CUST.ATM.getsysdateadt06="06"
			print(CUST.ATM.getsysdateadt06)

			IF (cint(CUST.ATM.getsysdateadttime) < cint(CUST.ATM.getsysdateadt06)) THEN
				print("intime")
				CUST.ATM.getsysdateadt06flg="Y"
				print(CUST.ATM.getsysdateadt06flg)
			ENDIF
			IF (CUST.ATM.getsysdateadttime == "12") THEN
				CUST.ATM.getsysdateadt06flg="Y"
				print(CUST.ATM.getsysdateadt06flg)
			ENDIF
		ENDIF
		IF ((CUST.ATM.getsysdateadt00flg=="Y") AND (CUST.ATM.getsysdateadt06flg=="Y")) THEN
				print("stoptrans")
				CUST.ATM.statusalert="Y"
				print(CUST.ATM.statusalert)
		ELSE
				print("allowtrans")
				CUST.ATM.statusalert="N"
				print(CUST.ATM.statusalert)
		ENDIF
	ENDIF

###########################
IF (CUST.ATM.statusalert == "Y") THEN
	print("okay record")
ELSE
	print("okay skip")
	GOTO ENDOFSCRIPT
ENDIF
IF (BANCS.INPUT.PartTranIdentifier == "CUST") THEN
	CUST.ATM.FreeCode6="0"
	CUST.ATM.FreeCode6alert="Y"
	sv_u = urhk_getAdvanceDetailsForAccount(CUST.ATM.DebitAccount)
	print(sv_u)
	if(sv_u==0)then
		print(BANCS.OUTPARAM.FreeCode6)
		CUST.ATM.FreeCode6 = BANCS.OUTPARAM.FreeCode6
		print(CUST.ATM.FreeCode6)
		IF ((CUST.ATM.FreeCode6=="") OR (CUST.ATM.FreeCode6==" ")) THEN
			CUST.ATM.FreeCode6="0"
			print(CUST.ATM.FreeCode6)
		ENDIF
		if (CINT(CUST.ATM.FreeCode6) > 0) then 
			CUST.ATM.FreeCode6alert="Y"
			print(CUST.ATM.FreeCode6alert)
		else	
			CUST.ATM.FreeCode6alert="N"
		endif
	endif
	IF ((CUST.ATM.FreeCode6alert=="Y") OR (CUST.ATM.FreeCode6alert=="N")) THEN
		IF (FIELDEXISTS(BANCS.INPUT.ReservedField3) == 1) THEN
			CUST.ATM.serialrrn= LTRIM(BANCS.INPUT.ReservedField3,'0') 
			print(CUST.ATM.serialrrn)
		ELSE
			CUST.ATM.serialrrn = BANCS.INPUT.OrigDataElements 
			print(CUST.ATM.serialrrn)
		ENDIF
		CUST.ATM.Amount = CDOUBLE(BANCS.INPUT.TranAmt)/CDOUBLE("100")
		print(CUST.ATM.Amount)
		CUST.ATM.Amount = FORMAT$(CDOUBLE(CUST.ATM.Amount),"%.2f")
		PRINT(CUST.ATM.Amount)
		print(BANCS.INPUT.Command)
		print(BANCS.INPUT.DeviceId)
		BANCS.INPUT.CustCardId = BANCS.OUTPUT.RefNum
		print(BANCS.INPUT.CustCardId)
		print(BANCS.INPUT.Foracid)
		CUST.ATM.agentShare  =  BANCS.OUTPUT.TranRemarks 
		print(CUST.ATM.agentShare)
		print(BANCS.INPUT.DccId)
		print(CUST.ATM.Amount)
		CUST.ATM.accountagt = BANCS.OUTPUT.TranParticulars2
		print(CUST.ATM.accountagt)
		sv_e = mid$(BANCS.STDIN.BODDate,0,10)
		print(sv_e)
		sv_s = "sysdate,serialrrnNo|"
		sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-RRRR')),'DD-MON-RRRR'),(?SVAR + 1 ) as serialrrn "
		sv_s = sv_s + " FROM DUAL"
		BANCS.INPARAM.BINDVARS = sv_e + "|" + CUST.ATM.FreeCode6
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
			CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
			print(CUST.ATM.sysdate)
			BANCS.INPUT.StlmntFeeAmount1 = BANCS.OUTPARAM.serialrrnNo
			print(BANCS.INPUT.StlmntFeeAmount1)
		ENDIF
		CUST.ATM.sysDateAgt = CUST.ATM.sysdate
		print(CUST.ATM.sysDateAgt) 
		print(BANCS.STDIN.contextBankId)
		CUST.ATM.serialrrn = BANCS.OUTPUT.TranParticulars
		print(CUST.ATM.serialrrn)
		CUST.ATM.countalerts = BANCS.INPUT.StlmntFeeAmount1
		print(CUST.ATM.countalerts)
		IF (CUST.ATM.FreeCode6alert=="N") THEN
			CUST.ATM.countalerts = "0"
			print(CUST.ATM.countalerts)
		ENDIF
		sv_s = " INSERT INTO "
		sv_s = sv_s + " CUSTOM.C_ADT_OTHERS_TABLE "
		sv_s = sv_s + " ( "
		sv_s = sv_s + " TRAN_TYPE, "
		sv_s = sv_s + " TRAN_PARTICULAR, "
		sv_s = sv_s + " deviceid, "
		sv_s = sv_s + " RRN, "
		sv_s = sv_s + " account_number,"
		sv_s = sv_s + " TRANS_NUMBER, "
		sv_s = sv_s + " PHONE_FROM, "
		sv_s = sv_s + " CHANNEL_ID, "
		sv_s = sv_s + " TRAN_AMT, "
		sv_s = sv_s + " PHONE_TO,"
		sv_s = sv_s + " tran_date_time, "
		sv_s = sv_s + " bank_id,DATEANDTIME,MENUID,STATUS ) "
		sv_s = sv_s + " values "
		sv_s = sv_s + " ( "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR , sysdate,?SVAR,?SVAR )"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.Command+"|"+ CUST.ATM.serialrrn +"|"+BANCS.INPUT.DeviceId+"|"+BANCS.INPUT.CustCardId+"|"+BANCS.INPUT.Foracid+"|"+ CUST.ATM.countalerts +"|"+CUST.ATM.agentShare+"|"+BANCS.INPUT.DccId+"|"+ CUST.ATM.Amount +"|"+CUST.ATM.accountagt+"|"+CUST.ATM.sysDateAgt + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ATM.menuId + "|" + CUST.ATM.FreeCode6alert
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSqlWithBind(sv_s)
		If (sv_d == 0) then
			#sv_d = urhk_dbSqlWithBind("COMMIT")
			#print(sv_d)
			If (sv_d == 0) then
				IF (CUST.ATM.FreeCode6alert=="Y") THEN
					BANCS.INPARAM.BINDVARS = CUST.ATM.countalerts + "|"+ BANCS.STDIN.contextBankId + "|"+ BANCS.STDIN.contextBankId + "|"+ BANCS.INPUT.Foracid 
					print(BANCS.INPARAM.BINDVARS)
					sv_s = " update tbaadm.gac  set  FREE_CODE_6=?SVAR where bank_id=?SVAR and acid in (select acid  from tbaadm.gam where bank_id=?SVAR and  foracid=?SVAR ) "
					sv_d = urhk_dbSqlWithBind(sv_s)
					IF(sv_d == 0) THEN
						#sv_d = urhk_dbSqlWithBind("COMMIT")
						#print(sv_d)
					ENDIF
				ENDIF
				IF (CUST.ATM.FreeCode6alert=="N") THEN
					print(" Transaction Not allowed now ")
					BANCS.OUTPUT.ReservedField3="Transaction Not allowed now..."
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					exitscript
				ENDIF
			endif
		endif
	ENDIF
ENDIF

