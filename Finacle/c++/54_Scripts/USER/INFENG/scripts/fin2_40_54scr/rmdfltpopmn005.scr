<--START
CHECKSUM="084debfb4a419899cc203a9db6eced128ef9bb5883de7181b54a6b11cea2d1e5"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","ORM") == 0) THEN
	#{
		CREATECLASS("CUST","ORM",5)
	#}
	ENDIF
	
	
	CUST.ORM.corrBank = BANCS.INPUT.corrBank
	PRINT(CUST.ORM.corrBank )
	CUST.ORM.corrBranch = BANCS.INPUT.corrBranch
	PRINT(CUST.ORM.corrBranch)
	
	#--------------------------------------------------
	#Bank Validation.
	#--------------------------------------------------
	sv_q = "swiftcode|SELECT bank_identifier"
	sv_q = sv_q + " FROM TBAADM.BRBIC "
	sv_q = sv_q + " WHERE del_flg='N'"
	sv_q = sv_q + " AND paysys_id='SWIFT' "
	sv_q = sv_q + " AND bank_id= ?SVAR "
	sv_q = sv_q + " AND bank_code = ?SVAR"
	sv_q = sv_q + " AND branch_code = ?SVAR"
	
	PRINT(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ORM.corrBank + "|" +CUST.ORM.corrBranch
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_u = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_u)
	IF (sv_u == 0 ) THEN
	#{
		CUST.ORM.swiftcode = BANCS.OUTPARAM.swiftcode
		PRINT(CUST.ORM.swiftcode)
		sv_b = "val2|" +  CUST.ORM.swiftcode
		sv_g = urhk_SetOrbOut(sv_b)
		#}
	ELSE
		#{
		sv_g = urhk_SetOrbOut("val2| ")
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	# Validation of Local Bank..
	#---------------------------------------------------------------------------
	sv_q = "cntryCode|SELECT cntry_code"
	sv_q = sv_q + " FROM TBAADM.BCT "
	sv_q = sv_q + " WHERE "
	sv_q = sv_q + " bank_id= ?SVAR "
	sv_q = sv_q + " AND bank_code =?SVAR "
	sv_q = sv_q + " AND br_code =?SVAR "
	
	PRINT(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ORM.corrBank + "|" +CUST.ORM.corrBranch
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_u)
	IF (sv_u == 0 ) THEN
	#{
		CUST.ORM.cntryCode= BANCS.OUTPARAM.cntryCode
		PRINT(CUST.ORM.cntryCode)
		sv_b = "val3|" +  CUST.ORM.cntryCode
		sv_g = urhk_SetOrbOut(sv_b)
		#}
	ELSE
		#{
		sv_g = urhk_SetOrbOut("val3| ")
	#}
	ENDIF
	
	
	#####################################################################
	# Calling getcparamvalue.scr script for contrycode
	#####################################################################
	
	BANCS.INPUT.moduleName = "TRADE_FINANCE"
	BANCS.INPUT.parameterId = "CNTYCODE"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.ORM.cntycode= BANCS.OUTPUT.parameterVal
		sv_b = "val1|" +  CUST.ORM.cntycode
		sv_z = urhk_SetOrbOut(sv_b)
		PRINT(sv_z)
		#}
	ELSE
		#{
		CUST.ORM.errMsg = "CNTYCODE IS NOT SET"
		GOTO FINISH
	#}
	ENDIF
	FINISH :
		TRACE OFF
		EXITSCRIPT
END-->
