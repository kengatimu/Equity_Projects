	ELSE
		#{
		CUST.PAYDATA.errMsg ="TranName setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#################################################
	# TO FETCH THE PARTICULAR VALUE FROM CPVALUE TABLE
	################################################
	BANCS.INPUT.moduleName = "ERP"
	BANCS.INPUT.parameterId = "PARTICULAR"
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.PAYDATA.particular= BANCS.OUTPUT.parameterVal
		PRINT(CUST.PAYDATA.particular)
		#}
	ELSE
		#{
		CUST.PAYDATA.errMsg ="PARTICULAR setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#################################################
	#TO FETCH THE RATECODE VALUE FROM CPVALUE TABLE
	################################################
	BANCS.INPUT.moduleName = "ERP"
	BANCS.INPUT.parameterId = "RATECODE"
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.PAYDATA.rateCode= BANCS.OUTPUT.parameterVal
		PRINT(CUST.PAYDATA.rateCode)
		#}
	ELSE
		#{
		CUST.PAYDATA.errMsg ="RATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting Records from c_intercountry that are not posted
	#--------------------------------------------------------------------------
	sv_s = "count|"
	sv_s = sv_s + " select "
	sv_s = sv_s + " count(1) "
	sv_s = sv_s + " from "
	sv_s = sv_s + " CUSTOM.xxeb_pay_bank_transfer "
	sv_s = sv_s + " where "
	sv_s = sv_s + " status='N' "
	sv_s = sv_s + " AND bank_id = ?SVAR and payroll_id ='147' "
	sv_s = sv_s + " AND NVL(COMMENTS,'A') != 'FINACLE PROCESSING FAILED' "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	PRINT(sv_d)
	CUST.PAYDATA.count = BANCS.OUTPARAM.count
	PRINT(CUST.PAYDATA.count)
	IF (CINT(CUST.PAYDATA.count) == 0 ) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CINT(CUST.PAYDATA.count) > CINT(CUST.PAYDATA.tranCount) ) THEN
	#{
		CUST.PAYDATA.tranCount = CINT(CUST.PAYDATA.tranCount) - 1
		PRINT(CUST.PAYDATA.tranCount)
		
	#}
	ENDIF
	
	
	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="Y"
	BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.InsertTranWithValidnFlg="Y"
	BANCS.INPARAM.CheckExceptions="N"
	
	sv_u = urhk_MTTS_PopulateInputDetails("")
	
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.Remarks = ""
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "Y"
	sv_v = CUST.PAYDATA.tranName
	PRINT(sv_v)
	
	sv_u = urhk_MTTS_DefineTransaction(sv_v)
	
	IF(sv_u != 0 ) THEN
	#{
		CUST.PAYDATA.errIdent = "Transaction Definition Failed"
	#}
	ENDIF
	
	sv_s = "PAYROLL,TRANSFER_ID, PRE_PAYMENT, ASSIGNMENT_ACTION,"
	sv_s = sv_s + "ASSIGNMENT_ID,WF_ITEM_KEY, WF_ITEM_TYPE,ACCOUNT_NO,"
	sv_s = sv_s + "EMPLOYEE_NO, AMOUNT, SOL_ID, DR_CR_FLG,"
	sv_s = sv_s + "TRAN_DATE, STATUS, COMMENTS,PAY_PERIOD|"
	sv_s = sv_s + " SELECT "
	sv_s = sv_s + " PAYROLL_ACTION_ID,TRANSFER_ID, PRE_PAYMENT_ID, ASSIGNMENT_ACTION_ID, "
	sv_s = sv_s + " ASSIGNMENT_ID, WF_ITEM_KEY, WF_ITEM_TYPE, ACCOUNT_NO, EMPLOYEE_NO, "
	sv_s = sv_s + " AMOUNT, SOL_ID, DEBIT_CREDIT_FLG, TRAN_DATE,STATUS, COMMENTS,P_PAY_PERIOD "
	sv_s = sv_s + " FROM "
	sv_s = sv_s + " CUSTOM.xxeb_pay_bank_transfer "
	sv_s = sv_s + " WHERE "
	sv_s = sv_s + " status='N' "
	sv_s = sv_s + " AND bank_id = ?SVAR and payroll_id ='147' "
	sv_s = sv_s + " AND NVL(COMMENTS,'A') != 'FINACLE PROCESSING FAILED' "
	sv_s = sv_s + " order by PAYROLL_ACTION_ID "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	CUST.PAYDATA.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(CUST.PAYDATA.MainCursor)
	
	CUST.PAYDATA.TMPPAYROLL=""
	sv_c = urhk_dbCursorFetch(CUST.PAYDATA.MainCursor)
	PRINT(sv_c)
	
	IF(sv_c== 0) THEN
	#{
		CUST.PAYDATA.TMPPAYROLL = BANCS.OUTPARAM.PAYROLL
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_c = 0
	WHILE (sv_c == 0)
	#{
		CUST.PAYDATA.TRANSFER_ID = BANCS.OUTPARAM.TRANSFER_ID
		PRINT(CUST.PAYDATA.TRANSFER_ID)
		CUST.PAYDATA.PRE_PAYMENT = BANCS.OUTPARAM.PRE_PAYMENT
		PRINT(CUST.PAYDATA.PRE_PAYMENT)
		CUST.PAYDATA.ASSIGNMENT_ACTION=BANCS.OUTPARAM.ASSIGNMENT_ACTION
		PRINT(CUST.PAYDATA.ASSIGNMENT_ACTION)
		CUST.PAYDATA.ASSIGNMENT_ID = BANCS.OUTPARAM.ASSIGNMENT_ID
		PRINT(CUST.PAYDATA.ASSIGNMENT_ID)
		CUST.PAYDATA.PAYROLL= BANCS.OUTPARAM.PAYROLL
		PRINT(CUST.PAYDATA.PAYROLL)
		CUST.PAYDATA.WF_ITEM_KEY= BANCS.OUTPARAM.WF_ITEM_KEY
		PRINT(CUST.PAYDATA.WF_ITEM_KEY)
		CUST.PAYDATA.WF_ITEM_TYPE=BANCS.OUTPARAM.WF_ITEM_TYPE
		PRINT(CUST.PAYDATA.WF_ITEM_TYPE)
		CUST.PAYDATA.ACCOUNT_NO=BANCS.OUTPARAM.ACCOUNT_NO
		PRINT(CUST.PAYDATA.ACCOUNT_NO)
		CUST.PAYDATA.EMPLOYEE_NO=BANCS.OUTPARAM.EMPLOYEE_NO
		PRINT(CUST.PAYDATA.EMPLOYEE_NO)
		CUST.PAYDATA.AMOUNT=BANCS.OUTPARAM.AMOUNT
		PRINT(CUST.PAYDATA.AMOUNT)
		CUST.PAYDATA.SOL_ID=BANCS.OUTPARAM.SOL_ID
		PRINT(CUST.PAYDATA.SOL_ID)
		CUST.PAYDATA.DR_CR_FLG=BANCS.OUTPARAM.DR_CR_FLG
		PRINT(CUST.PAYDATA.DR_CR_FLG)
		CUST.PAYDATA.PAY_PERIOD=BANCS.OUTPARAM.PAY_PERIOD
		PRINT(CUST.PAYDATA.PAY_PERIOD)
		CUST.PAYDATA.TRAN_DATE=BANCS.OUTPARAM.TRAN_DATE
		PRINT(CUST.PAYDATA.TRAN_DATE)
		
		
		#--------------------------------------------------------------------
		# Fetching the key from third party database using DB links
		#--------------------------------------------------------------------
		sv_s= "key|"
		sv_s = sv_s +" select"
		sv_s = sv_s +" xx_eqt_prl_apprv_pkg.GET_ATTR_VAL@ERPLINK('" + CUST.PAYDATA.WF_ITEM_KEY + "' ,'" + CUST.PAYDATA.WF_ITEM_TYPE + "' ,'XX_PASS_KEY')"
		sv_s = sv_s +" from"
		sv_s = sv_s +" dual"
		PRINT(sv_s)
		sv_z = urhk_dbselectWithBind(sv_s)
		PRINT(sv_z)
		IF (sv_z==0) THEN
		#{
			CUST.PAYDATA.key= BANCS.OUTPARAM.key
			PRINT(CUST.PAYDATA.key)
		#}
		ENDIF
		
		#--------------------------------------------------------------------
		# Using the key transforming the encrypted account no, employee id
		# and amount
		#--------------------------------------------------------------------
		sv_s = "acctno,employee,amount|"
		sv_s = sv_s +" select"
		sv_s = sv_s +" apps.eb_pay_bank_transfer_pkg.eb_decrypt@ERPLINK('" +CUST.PAYDATA.ACCOUNT_NO + "','" +CUST.PAYDATA.key + "'),"
		sv_s = sv_s +" apps.eb_pay_bank_transfer_pkg.eb_decrypt@ERPLINK('" +CUST.PAYDATA.EMPLOYEE_NO + "','" +CUST.PAYDATA.key + "'),"
		sv_s = sv_s +" apps.eb_pay_bank_transfer_pkg.eb_decrypt@ERPLINK('" +CUST.PAYDATA.AMOUNT + "','" +CUST.PAYDATA.key + "')"
		sv_s = sv_s +" from"
		sv_s = sv_s +" dual"
		PRINT(sv_s)
		sv_z = urhk_dbselectWithBind(sv_s)
		PRINT(sv_z)
		IF (sv_z == 0) THEN
		#{
			CUST.PAYDATA.ACCOUNT_NO= BANCS.OUTPARAM.acctno
			PRINT(CUST.PAYDATA.ACCOUNT_NO)
			CUST.PAYDATA.EMPLOYEE_NO= BANCS.OUTPARAM.employee
			PRINT(CUST.PAYDATA.EMPLOYEE_NO)
			CUST.PAYDATA.AMOUNT= BANCS.OUTPARAM.amount
			PRINT(CUST.PAYDATA.AMOUNT)
		#}
		ENDIF
		#--------------------------------------------------------------------
		# In case the account is invalid the transaction corresponding to
		# that account would be passed into Suspense Account
		#--------------------------------------------------------------------
		IF(TRIM(CUST.PAYDATA.ACCOUNT_NO) != "") THEN
		#{
			sv_q = urhk_getAcctDetailsInRepository(CUST.PAYDATA.ACCOUNT_NO)
			IF(sv_q != 0) THEN
			#{
				CUST.PAYDATA.ACCOUNT_NO_TMP = CUST.PAYDATA.ACCOUNT_NO
				CUST.PAYDATA.ACCOUNT_NO = CUST.PAYDATA.acctNum
				CUST.PAYDATA.errIdent = "Invalid Account"
				#}
			ELSE
				#{
				CUST.PAYDATA.ACCOUNT_NO_TMP = ""
				CUST.PAYDATA.errIdent = ""
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.PAYDATA.ACCOUNT_NO_TMP = CUST.PAYDATA.ACCOUNT_NO
			CUST.PAYDATA.ACCOUNT_NO = CUST.PAYDATA.acctNum
			CUST.PAYDATA.errIdent = "Invalid Account"
		#}
		ENDIF
		
		
		#--------------------------------------------------
		# Checking the Part Tran Type and doing the Dr/Cr
		# accordingly
		#--------------------------------------------------
		
		IF (CUST.PAYDATA.DR_CR_FLG=="C") THEN
		#{
			#--------------------------------------------------
			# credit part transaction
			#--------------------------------------------------
			MTT.PartTranDetails.Account=CUST.PAYDATA.ACCOUNT_NO
			PRINT (BANCS.STDIN.homeCrncyCode)
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.RateCode = CUST.PAYDATA.rateCode
			MTT.PartTranDetails.Rate = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.PAYDATA.particular + CUST.PAYDATA.PAY_PERIOD
			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.PAYDATA.AMOUNT)
			PRINT(MTT.PartTranDetails.RefAmount)
			IF(CUST.PAYDATA.ACCOUNT_NO_TMP != "") THEN
			#{
				MTT.PartTranDetails.Remarks ="SUSP POSTING FOR: " +CUST.PAYDATA.ACCOUNT_NO_TMP
				#}
			ELSE
				#{
				MTT.PartTranDetails.Remarks =" "
			#}
			ENDIF
			MTT.PartTranDetails.RefNum = " "
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = CUST.PAYDATA.tranName
			sv_f = "brfocredit"
			sv_r = urhk_MTTS_definePartTran(sv_f)
			IF(sv_r != 0 ) THEN
			#{
				CUST.PAYDATA.errIdent = "Part Transaction Definition Failed"
				#}
			ELSE
				#{
				CUST.PAYDATA.sumCr = CDOUBLE(CUST.PAYDATA.sumCr) + CDOUBLE(CUST.PAYDATA.AMOUNT)
				PRINT(CUST.PAYDATA.sumCr)
			#}
			ENDIF
			#}
		ELSE
			#{
			#--------------------------------------------------
			# Debit part transaction
			#--------------------------------------------------
			MTT.PartTranDetails.Account = CUST.PAYDATA.ACCOUNT_NO
			PRINT (BANCS.STDIN.homeCrncyCode)
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.RateCode =CUST.PAYDATA.rateCode
			MTT.PartTranDetails.Rate = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.PAYDATA.particular + CUST.PAYDATA.PAY_PERIOD
			sv_a = CDOUBLE(CUST.PAYDATA.AMOUNT)
			sv_a = -(sv_a)
			MTT.PartTranDetails.RefAmount = sv_a
			PRINT(MTT.PartTranDetails.RefAmount)
			IF(CUST.PAYDATA.ACCOUNT_NO_TMP != "") THEN
			#{
				MTT.PartTranDetails.Remarks = "SUSP POSTING FOR: " +CUST.PAYDATA.ACCOUNT_NO_TMP
				#}
			ELSE
				#{
				MTT.PartTranDetails.Remarks = " "
			#}
			ENDIF
			MTT.PartTranDetails.RefNum = ""
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = CUST.PAYDATA.tranName
			sv_h = "D" + CUST.PAYDATA.ACCOUNT_NO
			sv_u = urhk_MTTS_definePartTran(sv_h)
			IF(sv_u != 0 ) THEN
			#{
				CUST.PAYDATA.errIdent = "Part Transaction Definition Failed"
				#}
			ELSE
				#{
				CUST.PAYDATA.sumDr=CDOUBLE(CUST.PAYDATA.sumDr) + CDOUBLE(CUST.PAYDATA.AMOUNT)
				PRINT(CUST.PAYDATA.sumDr)
			#}
			ENDIF
		#}
		ENDIF
		
		
		CUST.PAYDATA.tmpCount = CINT(CUST.PAYDATA.tmpCount) + 1
		CUST.PAYDATA.tmpRecCount = CINT(CUST.PAYDATA.tmpRecCount) + 1
		
		PRINT(CUST.PAYDATA.TMPPAYROLL)
		PRINT(CUST.PAYDATA.PAYROLL)
		PRINT(CUST.PAYDATA.tranCount)
		PRINT(CUST.PAYDATA.tmpCount)
		PRINT(CUST.PAYDATA.tmpRecCount)
		
		#--------------------------------------------------------------------
		# In case processing failed for account the status would be retained
		# as 'N' and comments would be updated as 'FINACLE PROCESSING FAILED'
		#--------------------------------------------------------------------
		sv_s = " UPDATE "
		sv_s = sv_s + " custom.xxeb_pay_bank_transfer SET "
		IF( CUST.PAYDATA.errIdent != "") THEN
		#{
			sv_s = sv_s + " COMMENTS = 'FINACLE PROCESSING FAILED' "
			#}
		ELSE
			#{
			sv_s = sv_s + " COMMENTS = '1' "
		#}
		ENDIF
		sv_s = sv_s + " where TRANSFER_ID = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR and payroll_id ='147' "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.PAYDATA.TRANSFER_ID +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		
		IF((CUST.PAYDATA.TMPPAYROLL != CUST.PAYDATA.PAYROLL) OR (CINT(CUST.PAYDATA.tranCount) == CINT(CUST.PAYDATA.tmpCount)) OR (CINT(CUST.PAYDATA.count) == CINT(CUST.PAYDATA.tmpRecCount))) THEN
		#{
			PRINT(CUST.PAYDATA.sumCr)
			PRINT(CUST.PAYDATA.sumDr)
			IF(CDOUBLE(CUST.PAYDATA.sumCr) != CDOUBLE(CUST.PAYDATA.sumDr)) THEN
			#{
				IF(CDOUBLE(CUST.PAYDATA.sumCr) > CDOUBLE(CUST.PAYDATA.sumDr)) THEN
				#{
					CUST.PAYDATA.supAmt= CDOUBLE(CUST.PAYDATA.sumCr)-CDOUBLE(CUST.PAYDATA.sumDr)
					sv_m = CDOUBLE(CUST.PAYDATA.supAmt)
					sv_m = -sv_m
					MTT.PartTranDetails.RefAmount = sv_m
					#}
				ELSE
					#{
					CUST.PAYDATA.supAmt= CDOUBLE(CUST.PAYDATA.sumDr)-CDOUBLE(CUST.PAYDATA.sumCr)
					MTT.PartTranDetails.RefAmount = CUST.PAYDATA.supAmt
					PRINT(MTT.PartTranDetails.RefAmount)
				#}
				ENDIF
				
				PRINT(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Account = CUST.PAYDATA.acctNum
				PRINT (BANCS.STDIN.homeCrncyCode)
				MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
				MTT.PartTranDetails.RateCode = CUST.PAYDATA.rateCode
				MTT.PartTranDetails.Rate = "0"
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = CUST.PAYDATA.particular  + CUST.PAYDATA.PAY_PERIOD
				MTT.PartTranDetails.Remarks =""
				MTT.PartTranDetails.RefNum = ""
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "Y"
				MTT.PartTranDetails.TranIdentifier = CUST.PAYDATA.tranName
				sv_h = "D" + CUST.PAYDATA.ACCOUNT_NO
				sv_u = urhk_MTTS_definePartTran(sv_h)
			#}
			ENDIF
			
			sv_r = urhk_MTTS_EndDefinition("")
			PRINT(sv_r)
			IF (sv_r == 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
				#{
					CUST.PAYDATA.tranid = BANCS.OUTPARAM.MTTTranId
					PRINT(CUST.PAYDATA.tranid)
					#}
				ELSE
					#{
					CUST.PAYDATA.tranid = ""
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT (MTT.Error.Description)
				CUST.PAYDATA.tranid = ""
			#}
			ENDIF
			
			sv_r = urhk_MTTS_HandleExceptions("POST")
			PRINT(sv_r)
			
			#Changes done for porting
			#sv_r = urhk_MTTS_Close("")
			#print(sv_r)
			
			#--------------------------------------------------------------------
			# Update needs to checked (unique key is available in table or not)
			#--------------------------------------------------------------------
			sv_s = " UPDATE "
			sv_s = sv_s + " custom.xxeb_pay_bank_transfer SET TRAN_ID=?SVAR "
			sv_s = sv_s + ", TRAN_date = substr(?SVAR,1,11) "
			sv_s = sv_s + ", STATUS='P' "
			sv_s = sv_s + ", COMMENTS='PROCESSED IN FINACLE'"
			sv_s = sv_s + " where PAYROLL_ACTION_ID=?SVAR "
			sv_s = sv_s + " AND COMMENTS = '1' "
			sv_s = sv_s + " AND bank_id = ?SVAR and payroll_id ='147' "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.PAYDATA.tranid  + "|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.PAYDATA.bodDate +"|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.PAYDATA.PAYROLL +"|"
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSQLWithBind(sv_s)
			
			#--------------------------------------------------------------------
			# Intiating new transaction
			#--------------------------------------------------------------------
			BANCS.INPARAM.PostTranFlg = "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg = "N"
			BANCS.INPARAM.CommitFlg="Y"
			BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
			BANCS.INPARAM.ErrorCheckForLuw="Y"
			BANCS.INPARAM.InsertTranWithValidnFlg="Y"
			BANCS.INPARAM.CheckExceptions="N"
			#Changes done for porting
			#sv_r = urhk_MTTS_Initialize("")
			
			MTT.TranDetails.TranDate="0"
			MTT.TranDetails.TranType = "T"
			#Changes done for porting
			MTT.TranDetails.TranSubType = "BI"
			MTT.TranDetails.Remarks = ""
			#Changes doen for porting
			MTT.TranDetails.IgnoreExcp = "I"
			MTT.TranDetails.Consolidate = "Y"
			sv_v = CUST.PAYDATA.tranName
			PRINT(sv_v)
			sv_u = urhk_MTTS_DefineTransaction(sv_v)
			sv_u = urhk_MTTS_PopulateInputDetails("")
			
			CUST.PAYDATA.TMPPAYROLL = CUST.PAYDATA.PAYROLL
			CUST.PAYDATA.sumCr = "0"
			CUST.PAYDATA.sumDr = "0"
			CUST.PAYDATA.tmpCount = "0"
		#}
		ENDIF
		
		sv_c = urhk_dbCursorFetch(CUST.PAYDATA.MainCursor)
		PRINT(sv_c)
		
	#}
	DO
	
	sv_c = urhk_dbCursorClose(CUST.PAYDATA.MainCursor)
	#Changes doen for porting
	#sv_r = urhk_MTTS_Close("")
	
	ENDOFSCRIPT:
		IF(CUST.PAYDATA.errMsg != "") THEN
		#{
			sv_s = SYSTEM("echo '"+ CUST.PAYDATA.errMsg + "' >>payroll.log")
			PRINT(sv_s)
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
END-->
