<--start
trace on
IF (FIELDEXISTS(BANCS.OUTPUT.TranRemarks) == 1) THEN
        BANCS.OUTPUT.TranRemarks=MID$(BANCS.OUTPUT.TranRemarks,0,30)
        print(BANCS.OUTPUT.TranRemarks)
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.RefNum) == 1) THEN
        BANCS.OUTPUT.RefNum=MID$(BANCS.OUTPUT.RefNum,0,20)
        print(BANCS.OUTPUT.RefNum)
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.TranParticulars) == 1) THEN
        BANCS.OUTPUT.TranParticulars = MID$(BANCS.OUTPUT.TranParticulars,0,50)
        print(BANCS.OUTPUT.TranParticulars)
        #vp Mkey Fix
        if(BANCS.INPUT.ReservedField2=="MPESADT")then
                if(fieldexists(BANCS.INPUT.ReservedField1)==1)then
                        BANCS.INPUT.cdate = left$(BANCS.STDIN.sysDate,10)
                        BANCS.INPUT.ctime = trim(mid$(BANCS.STDIN.sysDate,10,9))
                        ##BANCS.OUTPUT.TranParticulars = BANCS.INPUT.ReservedField1 + "/MkeyLoanVal" + BANCS.OUTPUT.RefNum
                        BANCS.OUTPUT.TranParticulars = BANCS.INPUT.ReservedField1 + "/" + BANCS.INPUT.cdate + "/" +BANCS.INPUT.ctime
                        BANCS.OUTPUT.TranParticulars = mid$(BANCS.OUTPUT.TranParticulars,0,50)
                else
                        BANCS.OUTPUT.TranParticulars = mid$(BANCS.OUTPUT.TranParticulars,0,50)
                endif
        endif
        #vp Otherbank Fix 02/07/2019
        if ((BANCS.INPUT.DccId=="TPG") OR (BANCS.INPUT.DccId=="PWE"))then
        if((BANCS.INPUT.ReservedField2=="REMITTANCE") and (BANCS.INPUT.CrForacid=="0180263995747"))then
                sv_s = "rrnNum,otherBank,freeTxt| "
                sv_s = sv_s + "select regexp_substr('"+BANCS.INPUT.CardAcceptorName+"' ,'[^  ]+',1,1) as rrnNum, "
                sv_s = sv_s + " regexp_substr('"+BANCS.INPUT.CardAcceptorName+"' ,'[^  ]+',1,2)as otherBank, "
                sv_s = sv_s + " regexp_substr('"+BANCS.INPUT.CardAcceptorName+"' ,'[^  ]+',1,3)as freeTxt from dual "
                print(sv_s)
                sv_u = urhk_dbSelectWithBind(sv_s)
                if(sv_u==0)then
                        BANCS.INPUT.rrnNum = BANCS.OUTPARAM.rrnNum
                        BANCS.INPUT.otherBank = BANCS.OUTPARAM.otherBank
                        BANCS.INPUT.freeTxt = BANCS.OUTPARAM.freeTxt
                else
                        BANCS.INPUT.rrnNum = "NA"
                        BANCS.INPUT.otherBank = "NA"
                        BANCS.INPUT.freeTxt = "NA"
                endif
                BANCS.OUTPUT.TranParticulars = BANCS.INPUT.DccId +"/" +BANCS.INPUT.rrnNum+"/" +BANCS.INPUT.otherBank+ "/" + BANCS.INPUT.freeTxt
                BANCS.OUTPUT.TranParticulars = mid$(BANCS.OUTPUT.TranParticulars,0,50)
        endif
        endif
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.TranParticulars2) == 1) THEN
        BANCS.OUTPUT.TranParticulars2 = MID$(BANCS.OUTPUT.TranParticulars2,0,50)
        print(BANCS.OUTPUT.TranParticulars2)
ENDIF
IF (BANCS.INPUT.DccId == "EAZ")  THEN
        IF (BANCS.INPUT.ReservedField2 =="P2PIntra")  THEN
                BANCS.OUTPUT.TranParticulars2 = BANCS.INPUT.ReservedField2 + "/" + LTRIM(BANCS.INPUT.ReservedField3,'0')
                print(BANCS.OUTPUT.TranParticulars2)
        ENDIF
        IF (BANCS.INPUT.ReservedField2 =="UNBLOCK")  THEN
                IF ((BANCS.INPUT.PartTranType=="C") OR (BANCS.INPUT.PartTranType=="D")) THEN
                        BANCS.OUTPUT.TranParticulars2 = BANCS.INPUT.CardAcceptorName +"/" + BANCS.INPUT.ReservedField2 +"/" + BANCS.OUTPUT.RefNum
                        print(BANCS.OUTPUT.TranParticulars2)
                ENDIF
        ENDIF
        IF (BANCS.INPUT.ReservedField2 =="Evalue") THEN
                sv_r=mid$(CUST.ATM.command,2,4)
                print(sv_r)
                IF (sv_r!="RR") THEN
                        ##CALL ("timekamaonline.scr")
                ENDIF
        ENDIF
ENDIF
#------Edwin mpesarecon RRN mapping 03/03/2020
if (fieldexists(BANCS.INPUT.CrForacid)==1) then
        if ((BANCS.INPUT.CrForacid=="0001400303015") OR (BANCS.INPUT.CrForacid=="0001400301528")) then
                BANCS.OUTPUT.TranParticulars2= LTRIM(BANCS.INPUT.ReservedField3,'0')
                if (BANCS.INPUT.Foracid!="")then
                        BANCS.OUTPUT.TranParticulars2= LTRIM(BANCS.INPUT.ReservedField3,'0')
                endif
                if (BANCS.INPUT.DccId=="BWY") then
                        if (fieldexists(CUST.ATM.statusbillebb)==1) then
                                BANCS.OUTPUT.TranParticulars2 = CUST.ATM.statusbillebb
                                BANCS.OUTPUT.TranRemarks = MID$(BANCS.INPUT.ReservedField3,0,50)
                                if (BANCS.INPUT.Foracid!="") then
                                        BANCS.OUTPUT.TranParticulars2 = CUST.ATM.statusbillebb
                                        BANCS.OUTPUT.TranRemarks = MID$(BANCS.INPUT.ReservedField3,0,50)
                                endif
                        endif
                endif
        endif
endif
#---------------------------Edwin for PWE name customer name inclusion INC0169002 01122022/CHG0031592-08122022/09122022
IF ((BANCS.INPUT.DccId == "TPG") OR (BANCS.INPUT.DccId=="PWE"))  THEN
	if(fieldexists(BANCS.INPUT.CrForacid)==1) then
		if(fieldexists(BANCS.INPUT.ReservedField1)==1)then
			if((BANCS.INPUT.ReservedField2=="MPAYBILL") and (BANCS.INPUT.PartTranType=="C"))then
				if((BANCS.INPUT.ReservedField1 !="") and (BANCS.INPUT.CrForacid !=""))then	
					BANCS.OUTPUT.TranRemarks=MID$(CUST.ATM.serial,0,30)
                                        print(BANCS.OUTPUT.TranRemarks)
					if(BANCS.INPUT.CrForacid =="0510290969842")then
						BANCS.OUTPUT.TranParticulars2 = MID$(BANCS.INPUT.ReservedField1,0,50)
					endif
				endif
			endif
		endif
	endif	
	#---------------------------Edwin for IMT narrations
	if(CUST.ATM.dccid =="TPG")then
		if((FIELDEXISTS(BANCS.INPUT.ReservedField1) == 1) and (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1))then
			if(BANCS.INPUT.ReservedField2=="IMT")then
				BANCS.OUTPUT.TranParticulars = mid$(BANCS.INPUT.ReservedField1,0,50)
				print(BANCS.OUTPUT.TranParticulars)
			endif
		endif
		IF  (BANCS.INPUT.ReservedField2=="walletToBank") THEN
         		IF (FIELDEXISTS(BANCS.INPUT.DevOwnerId) == 1) THEN
                		BANCS.OUTPUT.TranParticulars2=BANCS.INPUT.DevOwnerId
        		ENDIF
		ENDIF
		if(BANCS.INPUT.ReservedField2=="airtimePurchase")then
			sv_z="EAZZY-AIRTIME/AIRTEL/"
			BANCS.OUTPUT.TranParticulars = sv_z+CUST.ATM.serial+"/"+CUST.ATM.time
		endif
		if(BANCS.INPUT.ReservedField2=="bankToWallet")then
			sv_l = strlen(BANCS.INPUT.CardAcceptorName)
			sv_f = mid$(BANCS.INPUT.CardAcceptorName,0,sv_l)
			sv_p = getposition(sv_f,"/")
			CUST.ATM.narration1  = mid$(sv_f,0,(sv_p-1))
			print(CUST.ATM.narration1)
			CUST.ATM.mobile = mid$(sv_f,sv_p,sv_l)
			print(CUST.ATM.mobile)

			BANCS.OUTPUT.RefNum = MID$(CUST.ATM.serial,0,20)
			BANCS.OUTPUT.TranRemarks=MID$(CUST.ATM.serial,0,30)
			BANCS.OUTPUT.TranParticulars2 = MID$(CUST.ATM.mobile,0,50)

			if((BANCS.INPUT.PartTranIdentifier=="FEECUST1")or(BANCS.INPUT.PartTranIdentifier=="FEECONTRA1"))then
                                BANCS.OUTPUT.TranParticulars = "MOBILE MONEY CHARGES"
                        else
				BANCS.OUTPUT.TranParticulars = CUST.ATM.narration1
			endif 

			if(BANCS.INPUT.Command=="TRRR")then
				sv_z="REV"
				BANCS.OUTPUT.TranParticulars = sv_z + "" + BANCS.OUTPUT.TranParticulars
			endif		
		endif
		BANCS.OUTPUT.TranParticulars =  mid$(BANCS.OUTPUT.TranParticulars,0,50)
		print(BANCS.OUTPUT.TranParticulars)
	endif
	#---------------------------End
ENDIF
ENDOFSCRIPT:
IF (BANCS.INPUT.DccId == "EAZ")  THEN
        IF (BANCS.INPUT.ReservedField1 !="") THEN
                CUST.ATM.unblockstk = MID$(BANCS.INPUT.ReservedField1,0,3)
                print(CUST.ATM.unblockstk)
                IF ((CUST.ATM.unblockstk=="STK") OR (CUST.ATM.unblockstk=="APP") OR (CUST.ATM.unblockstk=="SSD")) THEN
                        BANCS.OUTPUT.TranParticularsCode = CUST.ATM.unblockstk
                        print(BANCS.OUTPUT.TranParticularsCode)
                ENDIF
        ENDIF
        IF (BANCS.INPUT.ReservedField2 == "UNBLOCK") THEN
                CUST.ATM.unblockstk="STK"
                BANCS.OUTPUT.TranParticularsCode = CUST.ATM.unblockstk
                print(BANCS.OUTPUT.TranParticularsCode)
        ENDIF
ENDIF
#---------------------------------------------Charles Ndirangu for tran codes ----CHG0031646
IF (BANCS.INPUT.DccId == "SWT")  THEN
        IF (BANCS.INPUT.Command !="") THEN
                IF((BANCS.INPUT.Command == "CWDR")  OR (BANCS.INPUT.Command == "CWRR")) THEN
			CUST.ATM.newreportcodes ="91110" 
			print(CUST.ATM.newreportcodes)
                        BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
                        print(BANCS.OUTPUT.TranParticularsCode)
			IF (fieldexists(BANCS.INPUT.CrForacid)==1) THEN
				IF (BANCS.INPUT.CrForacid=="VODAFONE") THEN
					CUST.ATM.newreportcodes ="93110"
					print(CUST.ATM.newreportcodes)
					BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
					print(BANCS.OUTPUT.TranParticularsCode)
				ENDIF
			ENDIF
			IF ((BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3")) THEN
				CUST.ATM.newreportcodes ="91111" 
				print(CUST.ATM.newreportcodes)
				BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
				print(BANCS.OUTPUT.TranParticularsCode)
				IF (FIELDEXISTS(BANCS.INPUT.TranCrncy) == 1) THEN
					IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
						CUST.ATM.newreportcodes ="91112" 
						print(CUST.ATM.newreportcodes)
						BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
						print(BANCS.OUTPUT.TranParticularsCode)
					ENDIF
				ENDIF
			ENDIF
                ENDIF
		IF ((BANCS.INPUT.Command == "TRTR")  OR (BANCS.INPUT.Command == "TRRR")) THEN
			IF (BANCS.INPUT.ReservedField2 =="CashIn") THEN
				CUST.ATM.newreportcodes ="92110" 
				print(CUST.ATM.newreportcodes)
				BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
				print(BANCS.OUTPUT.TranParticularsCode)
			ENDIF
		ENDIF
        ENDIF
ENDIF
IF (BANCS.INPUT.DccId == "WPD") THEN
        IF (BANCS.INPUT.Command !="") THEN
                IF ((BANCS.INPUT.Command == "CWDR") OR (BANCS.INPUT.Command == "CWRR")) THEN
			IF (BANCS.INPUT.ReservedField2 =="WAY4RETAIL") THEN
				CUST.ATM.newreportcodes ="M1110" 
				print(CUST.ATM.newreportcodes)
				BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
				print(BANCS.OUTPUT.TranParticularsCode)
			ENDIF
			IF (BANCS.INPUT.ReservedField2 == "WAY4CASHBACK") THEN
				CUST.ATM.newreportcodes ="M2110" 
				print(CUST.ATM.newreportcodes)
				BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
				print(BANCS.OUTPUT.TranParticularsCode)
			ENDIF
			IF (BANCS.INPUT.DeviceId!="") THEN
				sv_a= MID$(BANCS.INPUT.DeviceId,0,2) 
				print(sv_a) 
				IF (sv_a=="MP") THEN
					CUST.ATM.newreportcodes ="W1110" 
					print(CUST.ATM.newreportcodes)
					BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
					print(BANCS.OUTPUT.TranParticularsCode)
				ENDIF
			ENDIF
		ENDIF
		####### Agent POS start
		sv_s = "sol_id,account|"
		sv_s = sv_s + " SELECT agt.sol_id,gam.foracid "
		sv_s = sv_s + " FROM AGT,GAM "
		sv_s = sv_s + " WHERE AGT.OPER_CREDIT_ACID=GAM.acid "
		sv_s = sv_s + " AND GAM.acct_cls_flg!='Y'"
		sv_s = sv_s + " AND agent_code = ?SVAR"
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
		sv_s = sv_s + " AND AGT.del_flg !='Y' AND rownum<2"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId + "|" + BANCS.STDIN.contextBankId
		sv_d =urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF  (sv_d == "0") then
			CUST.ATM.Agentaccount=BANCS.OUTPARAM.account
			print(CUST.ATM.Agentaccount)
			IF ((BANCS.INPUT.Command == "CWDR") OR (BANCS.INPUT.Command == "CWRR")) THEN
				CUST.ATM.newreportcodes ="P1110"
				print(CUST.ATM.newreportcodes)
				BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
				print(BANCS.OUTPUT.TranParticularsCode)
				IF ((BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3")) THEN
					CUST.ATM.newreportcodes ="P1111" 
					print(CUST.ATM.newreportcodes)
					BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
					print(BANCS.OUTPUT.TranParticularsCode)
					IF (FIELDEXISTS(BANCS.INPUT.TranCrncy) == 1) THEN
						IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
							CUST.ATM.newreportcodes ="P1112" 
							print(CUST.ATM.newreportcodes)
							BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
							print(BANCS.OUTPUT.TranParticularsCode)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF  ((BANCS.INPUT.Command=="CDAR") OR (BANCS.INPUT.Command=="CDRR") OR (BANCS.INPUT.Command == "TRTR") OR (BANCS.INPUT.Command == "TRRR")) THEN
				CUST.ATM.newreportcodes ="P2110"
				print(CUST.ATM.newreportcodes)
				BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
				print(BANCS.OUTPUT.TranParticularsCode)
				IF ((BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3")) THEN
					CUST.ATM.newreportcodes ="P1111" 
					print(CUST.ATM.newreportcodes)
					BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
					print(BANCS.OUTPUT.TranParticularsCode)
					IF (FIELDEXISTS(BANCS.INPUT.TranCrncy) == 1) THEN
						IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
							CUST.ATM.newreportcodes ="P1112" 
							print(CUST.ATM.newreportcodes)
							BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
							print(BANCS.OUTPUT.TranParticularsCode)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		####### Agent POS end
	ENDIF
ENDIF
IF (BANCS.INPUT.DccId == "TPG") THEN
	IF (BANCS.INPUT.ReservedField2=="REMITTANCE") THEN
		CUST.ATM.newreportcodes ="16110" 
		print(CUST.ATM.newreportcodes)
		BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
		print(BANCS.OUTPUT.TranParticularsCode)
		IF ((BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3")) THEN
			CUST.ATM.newreportcodes ="16111" 
			print(CUST.ATM.newreportcodes)
			BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
			print(BANCS.OUTPUT.TranParticularsCode)
			IF (FIELDEXISTS(BANCS.INPUT.TranCrncy) == 1) THEN
				IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
					CUST.ATM.newreportcodes ="16112" 
					print(CUST.ATM.newreportcodes)
					BANCS.OUTPUT.TranParticularsCode = CUST.ATM.newreportcodes
					print(BANCS.OUTPUT.TranParticularsCode)
				ENDIF
			ENDIF
		ENDIF
		BANCS.OUTPUT.TranParticulars2= LTRIM(BANCS.INPUT.ReservedField3,'0')
	ENDIF
ENDIF
#---------------------------------------------Charles Ndirangu for tran codes ----CHG0031646
#------------------------------------------------------------------------Edwin for Transaction codes Add CHG0031244
if(BANCS.INPUT.DccId == "EAZ")then
	if(BANCS.INPUT.ReservedField1 !="")then
		CUST.ATM.channel = MID$(BANCS.INPUT.ReservedField1,0,3)
		print(CUST.ATM.channel)
		if(CUST.ATM.channel=="STK")then
			#-----stk paybill
			if(BANCS.INPUT.ReservedField2=="Otherbill")then	
				BANCS.OUTPUT.TranParticularsCode = "41110"
			endif
			#--stk equity account
                        if(BANCS.INPUT.ReservedField2=="P2PIntra")then
                                BANCS.OUTPUT.TranParticularsCode = "42210"
                        endif
			if(BANCS.INPUT.ReservedField2=="TOPUP")then
				CUST.ATM.telco = MID$(BANCS.INPUT.ReservedField3,0,5)
				print(CUST.ATM.telco)
				#--Airtel
				if(CUST.ATM.telco=="25473")then
					BANCS.OUTPUT.TranParticularsCode = "43210"
				endif
				#--Equitel
				if(CUST.ATM.telco=="25476")then
                                        BANCS.OUTPUT.TranParticularsCode = "43110"
                                endif
				#--safcom
				#if((CUST.ATM.telco=="25472") or (BANCS.INPUT.CrForacid=="0001400305240"))then
				if(CUST.ATM.telco=="25472")then
					BANCS.OUTPUT.TranParticularsCode = "43310"
				endif
				#---You
				if((CUST.ATM.telco=="25477")or(BANCS.INPUT.CrForacid=="0001400305242"))then
					BANCS.OUTPUT.TranParticularsCode = "43410"
				endif

			endif
		endif
		if(CUST.ATM.channel=="APP")then
			BANCS.OUTPUT.TranParticularsCode = "21110"
		endif
		if(CUST.ATM.channel=="SSD")then
                        BANCS.OUTPUT.TranParticularsCode = "21110"
                endif

	endif
	#------Buy Goods
	if(BANCS.INPUT.ReservedField2=="P2PIntraMer")then
		BANCS.OUTPUT.TranParticularsCode = "41210"
	endif
	#--------Mpesa
	if(BANCS.INPUT.CrForacid=="0001400301528")then
		BANCS.OUTPUT.TranParticularsCode = "42410"
	endif
	#--------Airtel
	if(BANCS.INPUT.CrForacid=="0001400303320")then
		BANCS.OUTPUT.TranParticularsCode = "42510"
	endif	
endif

#-------------------------------------------------------------------------End
