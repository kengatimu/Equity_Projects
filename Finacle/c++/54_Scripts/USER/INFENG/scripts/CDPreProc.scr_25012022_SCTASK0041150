        IF ((CUST.ATM.DbCrncyCode != CUST.ATM.CrCrncyCode) OR (BANCS.INPUT.TranCrncy != CUST.ATM.DbCrncyCode) OR (BANCS.INPUT.TranCrncy != CUST.ATM.CrCrncyCode)) THEN
        #{
                IF (FIELDEXISTS(BANCS.INPUT.ReservedField1)) THEN
                #{
                        IF (STRLEN(BANCS.INPUT.ReservedField1) >= 1) THEN
                        #{
				 IF (FIELDEXISTS(BANCS.INPUT.ReservedField3)) THEN
				 	IF ((BANCS.INPUT.ReservedField3=="RTG") OR (BANCS.INPUT.ReservedField3=="SWT")) THEN
						CUST.ATM.RateCode = MID$(BANCS.INPUT.ReservedField1,getposition(BANCS.INPUT.ReservedField1,"-"),STRLEN(BANCS.INPUT.ReservedField1))
						print(CUST.ATM.RateCode)
					ELSE
						#CUST.ATM.RateCode = MID$(BANCS.INPUT.ReservedField1,getposition(BANCS.INPUT.ReservedField1,"-"),STRLEN(BANCS.INPUT.ReservedField1))
						CUST.ATM.RateCode = MID$(BANCS.INPUT.ReservedField1,82,5)
						print(CUST.ATM.RateCode)
					ENDIF
				 ELSE
					#CUST.ATM.RateCode = MID$(BANCS.INPUT.ReservedField1,getposition(BANCS.INPUT.ReservedField1,"-"),STRLEN(BANCS.INPUT.ReservedField1))
					CUST.ATM.RateCode = MID$(BANCS.INPUT.ReservedField1,82,5)
					print(CUST.ATM.RateCode)
				 ENDIF
				CUST.ATM.RateCode  = trim(CUST.ATM.RateCode)
				print(CUST.ATM.RateCode)
				print(BANCS.INPUT.ReservedField1)
				#BANCS.INPUT.ReservedField1 =  MID$(BANCS.INPUT.ReservedField1,0,getposition(BANCS.INPUT.ReservedField1,"-")-1)
				BANCS.OUTPUT.ReservedField1 =  MID$(BANCS.INPUT.ReservedField1,0,50)
				print(BANCS.OUTPUT.ReservedField1)
				CUST.ATM.RateCode ="CDCI_RATE_CODE|" + CUST.ATM.RateCode
				CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
