					IF (FIELDEXISTS(CUST.ATM.Sucessfail1)) THEN
						IF (CUST.ATM.Sucessfail1=="N") THEN
							CUST.ATM.errMsg ="Check Data and Account "
							BANCS.OUTPUT.ReservedField3 = CUST.ATM.errMsg
							 BANCS.OUTPUT.successOrFailure = "F"
							 BANCS.OUTPUT.RespCode = "99"
							 exitscript
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
#++++++++++++Recycler Double Deposit
if(fieldexists(BANCS.INPUT.DccId)==1)then
if(fieldexists(BANCS.INPUT.Command)==1)then
	if(fieldexists(BANCS.INPUT.Foracid)==1)then
		print(BANCS.INPUT.Foracid)
	else
		BANCS.INPUT.Foracid = ""
	endif
	if((BANCS.INPUT.DccId=="SWT")and(BANCS.INPUT.Command=="CDAR")and(BANCS.INPUT.Foracid=="0001300501773"))then
		CUST.ATM.errMsg = "Transaction Not Allowed"
	endif
endif
endif
	

#trace off
ENDOFSCRIPT:
IF(CUST.ATM.errMsg != "" ) THEN
#{
        print(CUST.ATM.errMsg)
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.RespCode = "99"
#}
ENDIF

exitscript
