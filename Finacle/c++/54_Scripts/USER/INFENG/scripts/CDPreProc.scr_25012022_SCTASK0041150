		CUST.ATM.vdrCrncyCode = ""
	endif
	if(fieldexists(BANCS.INPUT.CrForacid)==1)then
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
		if(sv_u==0)then
			CUST.ATM.vcrCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		else
			CUST.ATM.vcrCrncyCode = ""
		endif
	else
		CUST.ATM.vcrCrncyCode = ""
	endif
	if((CUST.ATM.vdrCrncyCode!="")and(CUST.ATM.vcrCrncyCode!=""))then
	#{
		if(CUST.ATM.vdrCrncyCode!=CUST.ATM.vcrCrncyCode)then
		#{
			lv_d = "rtdtls|select custom.fn_rtpop_chk(?SVAR,?SVAR,?SVAR,'T','HLADISB')from dual "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ATM.vdrCrncyCode + "|" + CUST.ATM.vcrCrncyCode
			print(BANCS.INPARAM.BINDVARS)
			lv_f = urhk_dbSelectWithBind(lv_d)
			if(lv_f==0)then
			#{
				CUST.ATM.rtdtls = BANCS.OUTPARAM.rtdtls
			#}
			else
			#{
				CUST.ATM.rtdtls = "N|No"
			#}
			endif
			if(CUST.ATM.rtdtls!="")then
			#{
				CUST.ATM.rtYN = left$(CUST.ATM.rtdtls,1)
				if(CUST.ATM.rtYN=="Y")then
				#{
					CUST.ATM.rtCode = mid$(CUST.ATM.rtdtls,2,3)
				#}
				else
				#{
					CUST.ATM.rtCode = "TTS"
				#}
				endif
				CUST.ATM.RateCode ="CDCI_RATE_CODE|" + CUST.ATM.rtCode
				CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
				print(CUST.ATM.Put)

				CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
				IF(CUST.ATM.Get == 0 ) THEN
				#{
					print(BANCS.OUTPARAM.envValue)
				#}
				ENDIF
			#}
			endif
		#}
		endif
	#}
	endif
#}
ENDIF

