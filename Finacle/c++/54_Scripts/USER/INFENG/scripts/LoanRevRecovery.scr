                    MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
                    MTT.PartTranDetails.RefAmount=-sv_v
					MTT.PartTranDetails.RateCode =MTT.InputDetails.intRateCode
                    if(sv_q == "Y") then
                        MTT.PartTranDetails.Account=MTT.InputDetails.penalIntBookAcct
                        MTT.PartTranDetails.Particulars="Dr Penal P&L Interest A/c"
						MTT.PartTranDetails.sysPartTranCode ="PTRN01374"
                    else
                        MTT.PartTranDetails.Account=MTT.InputDetails.PenalIntSuspenseAcct
                        MTT.PartTranDetails.Particulars="Dr Penal Suspense A/c"
						MTT.PartTranDetails.sysPartTranCode ="PTRN01375"
                    endif

                    # Call to common script to modify tran particulars if script is present
                    MTT.PartTranDetails.ScriptEventType = "LARRT"
                    sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
                    if (sv_m == 0) then
                        call("getMTTTranPart.scr")
                    endif

                    MTT.PartTranDetails.Consolidate="N"
	            MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
	            MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
                    MTT.PartTranDetails.TranIdentifier="Recovery"
                    MTT.PartTranDetails.PTranBusinessType="LOANS"

                    sv_z = urhk_MTTS_DefinePartTran("LADR")
        endif

        if(sv_i!=0) then
            #----------------------------------------------------------------------------
            # Debit Booked Interest Collection account
            #----------------------------------------------------------------------------
                    MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
                    MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
                    MTT.PartTranDetails.RefAmount=-sv_i
                    MTT.PartTranDetails.Account=MTT.InputDetails.normalPDRcvblAcct
                    MTT.PartTranDetails.Particulars="Dr booked Int Recievable A/c"
                    # Call to common script to modify tran particulars if script is present
                    MTT.PartTranDetails.ScriptEventType = "LARRT"
                    sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
                    if (sv_m == 0) then
                        call("getMTTTranPart.scr")
                    endif
                    MTT.PartTranDetails.Consolidate="N"
                    MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
                    MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
                    MTT.PartTranDetails.TranIdentifier="Recovery"
                    MTT.PartTranDetails.PTranBusinessType="LOANS"
					MTT.PartTranDetails.sysPartTranCode ="PTRN01376"
                    sv_z = urhk_MTTS_DefinePartTran("LADR")
        endif

        if(sv_j!=0) then
            #----------------------------------------------------------------------------
            # Debit Booked Interest Collection account
            #----------------------------------------------------------------------------
                    MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
                    MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
                    MTT.PartTranDetails.RefAmount=-sv_j
                    MTT.PartTranDetails.Account=MTT.InputDetails.penalPDRcvblAcct
                    MTT.PartTranDetails.Particulars="Dr Booked Penal Int Recievable A/c"
                    # Call to common script to modify tran particulars if script is present
                    MTT.PartTranDetails.ScriptEventType = "LARRT"
                    sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
                    if (sv_m == 0) then
                        call("getMTTTranPart.scr")
                    endif
                    MTT.PartTranDetails.Consolidate="N"
                    MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
                    MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
                    MTT.PartTranDetails.TranIdentifier="Recovery"
                    MTT.PartTranDetails.PTranBusinessType="LOANS"
					MTT.PartTranDetails.sysPartTranCode ="PTRN01377"
                    sv_z = urhk_MTTS_DefinePartTran("LADR")
        endif

		#---------------------------------------------------------------------------- 
		# Debit Parking Account
		#---------------------------------------------------------------------------- 
		if(MTT.InputDetails.totCollAmt != 0 ) then
			MTT.PartTranDetails.Account=MTT.InputDetails.consolAcctForCharge
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate	
			MTT.PartTranDetails.RefAmount=-sv_x+sv_p+sv_l + sv_v + sv_h
			MTT.PartTranDetails.RateCode = MTT.InputDetails.chrgRateCode
			MTT.PartTranDetails.Rate = MTT.InputDetails.chrgRate
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.Particulars="Parking A/c Dr"

			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LARRT"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			if (sv_m == 0) then
				call("getMTTTranPart.scr")
			endif

			MTT.PartTranDetails.Consolidate="Y"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			MTT.PartTranDetails.TranIdentifier="Recovery"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.PartTranDetails.sysPartTranCode ="PTRN01378"

			sv_z = urhk_MTTS_DefinePartTran("PARKDR")
		endif
		#---------------------------------------------------------------------------- 
		# Credit Parking Account
		#---------------------------------------------------------------------------- 
		if(MTT.InputDetails.totCollAmt != 0 ) then
			MTT.PartTranDetails.Account=MTT.InputDetails.consolAcctForCharge

				BANCS.INPARAM.InputAmount=-sv_x+sv_p+sv_l+sv_v+sv_h
				BANCS.INPARAM.FromCurrency=MTT.InputDetails.tranCrncy
				BANCS.INPARAM.ToCurrency=MTT.InputDetails.chargeCreditCrncy
				BANCS.INPARAM.RateCode=MTT.InputDetails.chrgRateCode
				BANCS.INPARAM.Rate=MTT.InputDetails.chrgRate

				sv_z=urhk_B2k_ConvertAmount("")
				sv_x= CDOUBLE(BANCS.OUTPARAM.OutputAmount)

			MTT.PartTranDetails.RefAmount=-sv_x
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
			MTT.PartTranDetails.Particulars="Parking A/c Cr" 

			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LARRT"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			if (sv_m == 0) then
				call("getMTTTranPart.scr")
			endif

			MTT.PartTranDetails.Consolidate="Y"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
			MTT.PartTranDetails.TranIdentifier="Recovery"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.PartTranDetails.sysPartTranCode ="PTRN01379"

			sv_z = urhk_MTTS_DefinePartTran("PARKCR")
		endif
	endif
	#}
endif
#}

#----------------------------------------------------------------------------  
# Creating charge part tran....
#----------------------------------------------------------------------------  
if (sv_c != 0) then 
	MTT.PartTranDetails.Account=MTT.InputDetails.chargeCreditAccount
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
	MTT.PartTranDetails.RefAmount=-sv_c
	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
	MTT.PartTranDetails.RateCode = ""
	MTT.PartTranDetails.Particulars="Dr Charge A/c" 

	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LARRT"
	sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	if (sv_m == 0) then
		call("getMTTTranPart.scr")
	endif

	MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
	MTT.PartTranDetails.TranIdentifier="Recovery"
	MTT.PartTranDetails.PTranBusinessType="LOANS"
	MTT.PartTranDetails.sysPartTranCode ="PTRN01380"
	MTT.ChargeDetails.EventType = MTT.InputDetails.eventType
	MTT.ChargeDetails.EventId = MTT.InputDetails.eventId
	MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
	MTT.ChargeDetails.CalculatedAmount = sv_k
	MTT.ChargeDetails.ActualAmount = sv_c
	MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.chargeCreditCrncy
	MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
	MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct

	if (MTT.ChargeDetails.EventType == "LNKED") then
		sv_j = MTT.InputDetails.loanAcct+" "+LTRIM(RTRIM(MID$(MTT.InputDetails.tranParticulars,0,32)))
		MTT.PartTranDetails.Particulars=sv_j
	endif
	sv_z = urhk_MTTS_DefineChargePartTran("FEEDR")
endif
	sv_r = urhk_MTTS_PopulateInputDetails("")
# Now we will have to go in a while loop for next records
while (sv_r < 1)
    sv_c = CDOUBLE(MTT.InputDetails.chargeCreditAmt)
	if (sv_c != 0 ) then 
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeCreditAccount
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.RefAmount=-sv_c
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars="Dr Charge A/c" 

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARRT"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.PartTranDetails.sysPartTranCode ="PTRN01380"
		MTT.ChargeDetails.EventType = MTT.InputDetails.eventType
		MTT.ChargeDetails.EventId = MTT.InputDetails.eventId
		MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
		sv_k = CDOUBLE(MTT.InputDetails.calcAmt)
		MTT.ChargeDetails.CalculatedAmount = sv_k
		MTT.ChargeDetails.ActualAmount = sv_c
		MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.chargeCreditCrncy
		MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
		MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct

		if (MTT.ChargeDetails.EventType == "LNKED") then
			sv_j = MTT.InputDetails.loanAcct+" "+LTRIM(RTRIM(MID$(MTT.InputDetails.tranParticulars,0,32)))
			MTT.PartTranDetails.Particulars=sv_j
		endif
		sv_z = urhk_MTTS_DefineChargePartTran("FEEDR")
	endif
    sv_r = urhk_MTTS_PopulateInputDetails("")
DO

#----------------------------------------------------------------------------  
# Credit Recovery Line Account 
#----------------------------------------------------------------------------  
if(sv_h!=0) then 	
		MTT.PartTranDetails.Account=MTT.InputDetails.RecoveryLine
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.RefAmount=-sv_h
		MTT.PartTranDetails.Particulars="Dr Recovery A/c" 

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARRT"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.PartTranDetails.sysPartTranCode ="PTRN01381"
	sv_z = urhk_MTTS_DefinePartTran("RECDR")
endif
#----------------------------------------------------------------------------  
# Debit Charge Off Account 
#----------------------------------------------------------------------------  
if(sv_h!=0) then 	
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeOffLine
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		# Ref Currencty will be the Loan A/c Currency
		MTT.PartTranDetails.RefAmount=sv_h
		MTT.PartTranDetails.Particulars="Cr ChargeOff A/c"

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARRT"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="Y"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.PartTranDetails.sysPartTranCode ="PTRN01382"
	sv_z = urhk_MTTS_DefinePartTran("RECCR")
endif
#----------------------------------------------------------------------------
# Creating Accrued Interest Amount Part Tran..(This is not the same as
# Cash/Accrul basis Acrd Int fucntionality)
#----------------------------------------------------------------------------
if (sv_e != 0) then
    MTT.PartTranDetails.RefAmount=-sv_e
    MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
	MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
	if(sv_q == "Y") then
		MTT.PartTranDetails.Account=MTT.InputDetails.intBookAcct
		MTT.PartTranDetails.Particulars="Dr P&L Interest A/c"
		MTT.PartTranDetails.sysPartTranCode ="PTRN01383"
	else                
		MTT.PartTranDetails.Account=MTT.InputDetails.IntSuspenseAcct   
		MTT.PartTranDetails.Particulars="Dr Suspense A/c"  
		MTT.PartTranDetails.sysPartTranCode ="PTRN01384" 
	endif 


	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LARRT"
	sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	if (sv_m == 0) then
		call("getMTTTranPart.scr")
	endif

    MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
    MTT.PartTranDetails.TranIdentifier="Recovery"
    MTT.PartTranDetails.PTranBusinessType="LOANS"
    MTT.ChargeDetails.EventType = "ACCR"
    MTT.ChargeDetails.EventId = MTT.InputDetails.accrEventId
	if(fieldexists(MTT.InputDetails.CompB2kId)) then 
		MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId 
	endif 

    MTT.ChargeDetails.CalculatedAmount = sv_f
    MTT.ChargeDetails.ActualAmount = sv_e
    MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.tranCrncy
    MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
    MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct
    sv_z = urhk_MTTS_DefineChargePartTran("ACCRDR")
endif

#----------------------------------------------------------------------------
# Creating Accrued Penal Interest Amount Part Tran..(This is not the same as
# Cash/Accrul basis Acrd Int fucntionality)
#----------------------------------------------------------------------------
if (sv_u != 0) then
    MTT.PartTranDetails.RefAmount=-sv_u
    MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
    MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
	MTT.PartTranDetails.RateCode = MTT.InputDetails.intRateCode
    
	if(sv_q == "Y") then 
	    MTT.PartTranDetails.Account=MTT.InputDetails.penalIntBookAcct
    	MTT.PartTranDetails.Particulars="Dr Penal P&L Interest A/c"
		MTT.PartTranDetails.sysPartTranCode ="PTRN01385"
    else
        MTT.PartTranDetails.Account=MTT.InputDetails.PenalIntSuspenseAcct
        MTT.PartTranDetails.Particulars="Dr Penal Suspense A/c"
		MTT.PartTranDetails.sysPartTranCode ="PTRN01386"
    endif

    # Call to common script to modify tran particulars if script is present
    MTT.PartTranDetails.ScriptEventType = "LARRT"
    sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
    if (sv_m == 0) then
        call("getMTTTranPart.scr")
    endif

    MTT.PartTranDetails.Consolidate="N"
            MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
            MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
    MTT.PartTranDetails.TranIdentifier="Recovery"
    MTT.PartTranDetails.PTranBusinessType="LOANS"
    MTT.ChargeDetails.EventType = "ACCR"
    MTT.ChargeDetails.EventId = MTT.InputDetails.accrEventId
	if(fieldexists(MTT.InputDetails.CompB2kId)) then 
		MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId 
	endif 

    MTT.ChargeDetails.CalculatedAmount = sv_f
    MTT.ChargeDetails.ActualAmount = sv_u
    MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.tranCrncy
    MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
    MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct
    sv_z = urhk_MTTS_DefineChargePartTran("ACCRDR")
endif

#----------------------------------------------------------------------------
# Debit Office A/c for bank charge and other charges.
#----------------------------------------------------------------------------
sv_t = sv_a + sv_d
if ( (sv_t  != 0) and ( MTT.InputDetails.chargeRouteFlg == "O" )) then 
#--{
		MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAccount
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate	
		MTT.PartTranDetails.RefAmount=-sv_t
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.Particulars="Dr office A/c for charges"

		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAREC"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_m == 0) then
			call("getMTTTranPart.scr")
		endif

		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime
		MTT.PartTranDetails.TranIdentifier="Recovery"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.LAAddnlDetails.OriginOfTran = "RVREC"
		MTT.LAAddnlDetails.TypeOfDemand="A"
		MTT.LAAddnlDetails.DemandSatisfyFlg="Y"
		MTT.LAAddnlDetails.DemandFlowId=MTT.InputDetails.DmdFlow
		MTT.LAAddnlDetails.PrincipalAmt=0
		MTT.LAAddnlDetails.InterestAmt  = 0           
		MTT.LAAddnlDetails.OtherChrgAmt=sv_d
		MTT.LAAddnlDetails.BankChrgAmt=sv_a
		MTT.LAAddnlDetails.LoanAcctId=MTT.InputDetails.loanAcct   
		MTT.LAAddnlDetails.ReversalFlg="Y"
		MTT.LAAddnlDetails.ReversalPtranSrlNum=MTT.InputDetails.RevOfficePartTranSrlNum
		MTT.LAAddnlDetails.ReversalTranId=MTT.InputDetails.RevTranId
		MTT.LAAddnlDetails.ReversalTranDate=MTT.InputDetails.diffDate

		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
        MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		MTT.PartTranDetails.sysPartTranCode ="PTRN01387"

		sv_z = urhk_MTTS_DefinePartTran("CR")
endif
sv_z = urhk_MTTS_EndDefinition("")
#trace off
