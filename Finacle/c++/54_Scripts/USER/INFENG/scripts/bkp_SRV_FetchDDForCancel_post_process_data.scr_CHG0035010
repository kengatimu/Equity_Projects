<--START
TRACE ON
	sv_r = urhk_B2k_PrintRepos("BANCS")
	print(sv_r)

        IF ((REPEXISTS("CUST")) == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF((CLASSEXISTS("CUST","DATA")) == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

	sv_a = urhk_SRV_GetVal("ddBasicDtl.funcCode")
	CUST.DATA.funcCode = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.funcCode)


	sv_a = urhk_SRV_GetVal("ddCancelMiscDtl.rptCode.refCode")
	CUST.DATA.rptCode = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.rptCode)

	sv_a = urhk_SRV_GetVal("ddBasicDtl.ddAcct.crncyCode")
	CUST.DATA.ddAcctcrncyCode = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.ddAcctcrncyCode)

	sv_a = urhk_SRV_GetVal("ddBasicDtl.ddAcct.solId")
	CUST.DATA.ddAcctsolId = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.ddAcctsolId)

	sv_a = urhk_SRV_GetVal("ddBasicDtl.ddNum")
	CUST.DATA.ddNum = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.ddNum)

	sv_a = urhk_SRV_GetVal("ddBasicDtl.ddIssDate")
	CUST.DATA.ddIssDate = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.ddIssDate)

	sv_a = urhk_SRV_GetVal("ddBasicDtl.pTranIdentifier.tranId")
	CUST.DATA.tranId = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.tranId)

	IF((CUST.DATA.ddNum != "") AND (CUST.DATA.rptCode == "UFAA"))THEN
	#{
		sv_a = ""
		sv_a = sv_a + " foracid,acid,acct_crncy_code,acct_name,acct_short_name|"
		sv_a = sv_a + " select foracid,acid,acct_crncy_code,acct_name,acct_short_name  from tbaadm.gam "
		sv_a = sv_a + " where bank_id = '"+BANCS.STDIN.contextBankId+"' "
		sv_a = sv_a + " and entity_cre_flg = 'Y' " 
		sv_a = sv_a + " and del_flg = 'N' " 
		sv_a = sv_a + " and sol_id  = '"+BANCS.STDIN.mySolId+"' " 
		sv_a = sv_a + " and acct_crncy_code = '"+CUST.DATA.ddAcctcrncyCode+"' "	
		sv_a = sv_a + " and to_date('"+MID$(CUST.DATA.ddIssDate,0,10)+"','DD-MM-YYYY') <= add_months(to_date('"+MID$(BANCS.STDIN.BODDate,0,10)+"','DD-MM-YYYY'),-24) "
		IF(CUST.DATA.ddAcctcrncyCode == "KES")THEN
		#{
			sv_a = sv_a + " and bacid = 'SUNDRYTD' " 
		ELSE
			IF(CUST.DATA.ddAcctcrncyCode == "USD")THEN
			#{
				lv_t = "" 	
				lv_t = lv_t + BANCS.STDIN.mySolId
				lv_t = lv_t + "3000102791"	
				
				sv_a = sv_a + " and foracid =  '"+lv_t+"'  " 
			ELSE
				sv_a = sv_a + " and foracid =  ''"
			#}
			ENDIF
		#}
		ENDIF

		print(sv_a)
		lv_z = urhk_dbSelectWithBind(sv_a)
		print(lv_z)
		IF(lv_z==0) THEN
		#{
			CUST.DATA.purAcct   		= BANCS.OUTPARAM.foracid
			CUST.DATA.acid   		= BANCS.OUTPARAM.acid
			CUST.DATA.acct_crncy_code   	= BANCS.OUTPARAM.acct_crncy_code
			CUST.DATA.acct_name   		= BANCS.OUTPARAM.acct_name
			CUST.DATA.acct_short_name   	= BANCS.OUTPARAM.acct_short_name
		ELSE
			CUST.DATA.purAcct     		= ""
			CUST.DATA.acid   		= ""
			CUST.DATA.acct_crncy_code   	= ""
			CUST.DATA.acct_name   		= ""
			CUST.DATA.acct_short_name   	= ""
		#}
		endif
		
		print(CUST.DATA.purAcct)
		print(CUST.DATA.acid)
		print(CUST.DATA.acct_crncy_code)
		print(CUST.DATA.acct_name)
		print(CUST.DATA.acct_short_name)
				
		IF(CUST.DATA.purAcct!= "")THEN
		#{
			sv_a = urhk_SRV_SetVal("ddBasicDtl.purAcct.foracid|" + CUST.DATA.purAcct)
			print(sv_a)
			sv_a = urhk_SRV_SetVal("ddBasicDtl.purAcct.acid|" + CUST.DATA.acid)
			print(sv_a)
			sv_a = urhk_SRV_SetVal("ddBasicDtl.purAcct.crncyCode|" + CUST.DATA.acct_crncy_code)
			print(sv_a)
			sv_a = urhk_SRV_SetVal("ddBasicDtl.purAcct.acctName|" + CUST.DATA.acct_name)
			print(sv_a)
			sv_a = urhk_SRV_SetVal("ddBasicDtl.purName|" + CUST.DATA.acct_name)
			print(sv_a)
		#}
		ENDIF
	#}
	ENDIF

TRACE OFF
