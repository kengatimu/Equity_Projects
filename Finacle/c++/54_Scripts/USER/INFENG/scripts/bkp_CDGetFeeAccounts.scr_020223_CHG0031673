IF (BANCS.INPUT.DccId=="C24") THEN
	CUST.ATM.IBLI= MID$(BANCS.INPUT.ReservedField1,0,4)
	print(CUST.ATM.IBLI)
	IF ((CUST.ATM.IBLI != "IBLI") AND (CUST.ATM.IBLI != "CLAI"))  THEN
		sv_s = "contra "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT merch_purchase_payable "
		sv_s = sv_s + " FROM C_MERCHANTS "
		sv_s = sv_s + " WHERE merchant_id = ?SVAR "
		sv_s = sv_s + " AND del_flg ='N' "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		sv_d =urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF  (sv_d == "0") then
			BANCS.OUTPUT.contraAccount= BANCS.OUTPARAM.contra
			print(BANCS.OUTPUT.contraAccount)
		ELSE
			BANCS.OUTPUT.RespCode = "99"
				print(BANCS.OUTPUT.RespCode)
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		ENDIF
		BANCS.OUTPUT.TranFeeCustAcct1=BANCS.OUTPUT.contraAccount
		BANCS.OUTPUT.TranFeeContraAcct1=CUST.ATM.tranFeeAccount7
		BANCS.OUTPUT.TranFeeCustAcct2=CUST.ATM.tranFeeAccount7
		BANCS.OUTPUT.TranFeeContraAcct2=CUST.ATM.tranFeeAccount8
		print(BANCS.OUTPUT.TranFeeContraAcct1)
		print(BANCS.OUTPUT.TranFeeCustAcct1)
		print(BANCS.OUTPUT.TranFeeContraAcct2)
		print(BANCS.OUTPUT.TranFeeCustAcct2)
	ELSE
		BANCS.OUTPUT.TranFeeCustAcct1=BANCS.INPUT.CrForacid
		print(BANCS.OUTPUT.TranFeeCustAcct1)
	ENDIF
ENDIF

