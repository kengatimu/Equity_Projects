IF ((BANCS.INPUT.DccId == "SWT") OR(BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "WYM") OR (BANCS.INPUT.DccId == "OMK") OR (BANCS.INPUT.DccId == "WPD")) THEN
