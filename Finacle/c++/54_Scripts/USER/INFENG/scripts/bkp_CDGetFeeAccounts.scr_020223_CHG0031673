				PRINT(BANCS.INPARAM.BINDVARS)
				PRINT(sv_k)
				sv_h = urhk_dbselectWithBind(sv_k)
				PRINT(sv_h)
				IF (sv_h  == 0) THEN
					CUST.ATM.Countsolid = BANCS.OUTPARAM.Countsolid
					PRINT(CUST.ATM.Countsolid)
					IF (CINT(CUST.ATM.Countsolid)<1) THEN
						BANCS.OUTPUT.ReservedField3 = "Please Supply Valid Sol_id "
						print(BANCS.OUTPUT.ReservedField3)
