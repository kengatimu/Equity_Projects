			IF ((BANCS.INPUT.ReservedField2=="CashIn") OR (BANCS.INPUT.ReservedField2 == "OtherbillAgent")) THEN
				CUST.ATM.agtsolsolid=BANCS.INPUT.Foracid
				print(CUST.ATM.agtsolsolid)
			ENDIF
			IF (BANCS.INPUT.ReservedField2=="UNBLOCK") THEN
				CUST.ATM.agtsolsolid=BANCS.INPUT.CrForacid
				print(CUST.ATM.agtsolsolid)
			ENDIF
			sv_h = urhk_getAcctDetailsInRepository(CUST.ATM.agtsolsolid)
			IF (sv_h != 0) THEN
				BANCS.OUTPUT.RespCode = "99"
				print(BANCS.OUTPUT.RespCode)
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ELSE
				 CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
				 print(CUST.ATM.solid)
			ENDIF
			print(CUST.ATM.solid)
			CUST.ATM.possol = CUST.ATM.solid
			print(CUST.ATM.possol)
			####
		
				### start restrict the agent limit wpd
				IF (BANCS.INPUT.ReservedField2=="CashIn") THEN
					IF (FIELDEXISTS(BANCS.INPUT.TranAmt)) THEN
						CUST.ATM.Amountlimit = CDOUBLE(BANCS.INPUT.TranAmt)
						CUST.ATM.Amountlimit = CDOUBLE(CUST.ATM.Amountlimit)/CDOUBLE("100")
						print(CUST.ATM.Amountlimit)
						if (CINT(CUST.ATM.Amountlimit) > 100000) then 
							print(" Transaction Not allowed now ")
							BANCS.OUTPUT.ReservedField3="Transaction Not allowed,limit is 100,000..."
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.successOrFailure = "F"
							GOTO ENDOFSCRIPT
						endif
					ENDIF
				ENDIF
				### End restrict the agent limit wpd
			IF (FIELDEXISTS(BANCS.INPUT.DeviceId) == 1) THEN
				CUST.ATM.solid = mid$(BANCS.INPUT.DeviceId,0,3)
				print(CUST.ATM.solid)
				CUST.ATM.possol = CUST.ATM.solid
				print(CUST.ATM.possol)
				sv_k = "Countsolid| SELECT count(1) "
				sv_k = sv_k + " from tbaadm.sol "
				sv_k = sv_k + " where sol_id = ?SVAR "
				sv_k = sv_k + " AND BANK_ID = ?SVAR "
				sv_k = sv_k + " AND del_flg = 'N' "
				BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				PRINT(sv_k)
				sv_h = urhk_dbselectWithBind(sv_k)
				PRINT(sv_h)
				IF (sv_h  == 0) THEN
					CUST.ATM.Countsolid = BANCS.OUTPARAM.Countsolid
					PRINT(CUST.ATM.Countsolid)
					IF (CINT(CUST.ATM.Countsolid)<1) THEN
						BANCS.OUTPUT.ReservedField3 = "Please Supply Valid Sol_id "
						print(BANCS.OUTPUT.ReservedField3)
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						EXITSCRIPT
					ENDIF
				ELSE
					BANCS.OUTPUT.ReservedField3 = "Please Supply Valid Sol_id "
					print(BANCS.OUTPUT.ReservedField3)
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					EXITSCRIPT
				ENDIF
			ENDIF
			####
			IF (FIELDEXISTS(BANCS.OUTPUT.TranFeeContraAcct1)) THEN
				print(BANCS.OUTPUT.TranFeeContraAcct1)
				print(CUST.ATM.possol)
				print(mid$(BANCS.OUTPUT.TranFeeContraAcct1,3,10))
				BANCS.OUTPUT.TranFeeContraAcct1=  CUST.ATM.possol + mid$(BANCS.OUTPUT.TranFeeContraAcct1,3,10)
				print(BANCS.OUTPUT.TranFeeContraAcct1)
				IF (BANCS.INPUT.ReservedField2=="UNBLOCK") THEN
					CUST.ATM.TranFeeContraAcct1 ="6500502997"
					print(CUST.ATM.TranFeeContraAcct1)
					BANCS.OUTPUT.TranFeeContraAcct1=  CUST.ATM.possol + CUST.ATM.TranFeeContraAcct1
					print(BANCS.OUTPUT.TranFeeContraAcct1)
				ENDIF
			ENDIF
			call("copyBancsToCustC24.scr")
			call("AgentSharemob.scr")
			call("copyCust24ToBancs.scr")
			IF (FIELDEXISTS(BANCS.OUTPUT.successOrFailure)) THEN
				print(BANCS.OUTPUT.successOrFailure)
				IF (BANCS.OUTPUT.successOrFailure=="F") THEN
					BANCS.OUTPUT.RespCode = "99"
				print(BANCS.OUTPUT.RespCode)
					BANCS.OUTPUT.ReservedField3 = "Charges not collected"
					print(BANCS.OUTPUT.ReservedField3)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
#--- Inculusion for VISA
IF (BANCS.INPUT.DccId=="BS1") THEN
	#PRINT("VISA")
	BANCS.OUTPUT.TranFeeContraAcct1 = CUST.ATM.tranFeeAccount6

ENDIF
