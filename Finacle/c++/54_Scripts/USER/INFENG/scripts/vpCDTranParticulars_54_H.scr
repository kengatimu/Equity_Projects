#{

CUST.ATM.narr1="ABC/"
CUST.ATM.narr2="TRANSACTIONS"
CUST.ATM.command = BANCS.INPUT.Command
CUST.ATM.dccid = BANCS.INPUT.DccId
CUST.ATM.Particulars = BANCS.OUTPUT.TranParticulars
CUST.ATM.acceptorName = BANCS.INPUT.CardAcceptorName
CUST.ATM.DeviceId = BANCS.INPUT.DeviceId
CUST.ATM.serial= BANCS.INPUT.SerialNum
IF (CUST.ATM.dccid !="SMS") THEN
        CUST.ATM.serial= LTRIM(CUST.ATM.serial,'0')
ELSE
        CUST.ATM.serial=MID$(CUST.ATM.serial,6,6)
ENDIF
IF (CUST.ATM.dccid =="EFR") THEN
        IF (BANCS.INPUT.ReservedField2!="") THEN
                IF (BANCS.INPUT.ReservedField2=="efrstopCheque") THEN
                        CUST.ATM.narr1="Efront/"
                        CUST.ATM.narr2="STOP Cheque"
                ELSE
                        IF (BANCS.INPUT.ReservedField2=="efrdeposit") THEN
                                CUST.ATM.narr1="Efront/"
                                CUST.ATM.narr2="CASH DEPOSIT"
                        ELSE
                                CUST.ATM.narr1="Efront/"
                                CUST.ATM.narr2="CASH WITHDRAWAL"
                        ENDIF
                ENDIF
        ELSE
                CUST.ATM.narr1="Efront/"
                CUST.ATM.narr2="CASH WITHDRAWAL"
        ENDIF
ENDIF
IF ( (CUST.ATM.dccid =="MPA") OR (CUST.ATM.dccid =="KEN") OR (CUST.ATM.dccid =="INT") OR (CUST.ATM.dccid =="POL") OR (CUST.ATM.dccid =="TPG") OR (CUST.ATM.dccid =="OMK")OR (CUST.ATM.dccid =="SMS")OR (CUST.ATM.dccid =="EAZ") OR (CUST.ATM.dccid =="SWT") OR (CUST.ATM.dccid =="WPD") OR (CUST.ATM.dccid =="BS1") OR (CUST.ATM.dccid =="WYM") OR (CUST.ATM.dccid =="AME") OR (CUST.ATM.dccid =="MC1")) THEN
        IF (CUST.ATM.dccid =="WPD") THEN
                IF (BANCS.INPUT.ReservedField2 != "") THEN
                        CUST.ATM.reversed2 = BANCS.INPUT.ReservedField2
                        print(CUST.ATM.reversed2)
                        sv_k = MID$(BANCS.INPUT.ReservedField2,0,5)
                        print(sv_k)
                        sv_w = MID$(BANCS.INPUT.ReservedField2,5,14)
                        print(sv_w)
                        IF ((sv_k=="ACCT:") OR (sv_k=="BILL:") OR (sv_k =="COLL:")) THEN
                                BANCS.INPUT.ReservedField3 = sv_w
                                print(BANCS.INPUT.ReservedField3)
                                CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0')
                                print(CUST.ATM.serial)
                                IF ((sv_k=="ACCT:") OR (sv_k =="COLL:")) THEN
                                        IF (BANCS.INPUT.ReservedField1=="6800001") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                ##print(BANCS.OUTPUT.RespCode)
                                                BANCS.OUTPUT.successOrFailure="F"
                                                GOTO ENDOFSCRIPT
                                        ENDIF
                                        sv_v=MID$(CUST.ATM.reversed2,19,20)
                                        print(sv_v)
                                        BANCS.OUTPUT.RefNum = trim(sv_v)
                                        #print(BANCS.OUTPUT.RefNum)
                                        IF (sv_k=="ACCT:") THEN
                                                CUST.ATM.narr2="T-BY:"
                                                CUST.ATM.narr2=CUST.ATM.narr2 + BANCS.OUTPUT.RefNum
                                                sv_g = MID$(CUST.ATM.narr2,0,22)
                                                #print(sv_g)
                                                CUST.ATM.narr2=sv_g
                                                #print(CUST.ATM.narr2)
                                                IF ((BANCS.INPUT.CrForacid=="0820272032149") OR (BANCS.INPUT.CrForacid=="0240290235686") OR (BANCS.INPUT.CrForacid=="0550293271157")) THEN
                                                        IF (BANCS.OUTPUT.RefNum=="") THEN
                                                                BANCS.OUTPUT.RespCode = "99"
                                                #print(BANCS.OUTPUT.RespCode)
                                                                BANCS.OUTPUT.successOrFailure="F"
                                                                GOTO ENDOFSCRIPT
                                                        ENDIF
                                                        IF ((BANCS.INPUT.CrForacid=="0550293271157") OR (BANCS.INPUT.CrForacid=="0240290235686") OR (BANCS.INPUT.CrForacid=="0010201200504")) THEN
                                                                BANCS.OUTPUT.RespCode = "99"
                                                #print(BANCS.OUTPUT.RespCode)
                                                                BANCS.OUTPUT.successOrFailure="F"
                                                                GOTO ENDOFSCRIPT
                                                        ENDIF
                                                ENDIF
                                        ENDIF
                                        IF (sv_k=="COLL:") THEN
                                                CUST.ATM.narr2="C-BY:"
                                                CUST.ATM.narr2=CUST.ATM.narr2 + BANCS.OUTPUT.RefNum
                                                sv_g = MID$(CUST.ATM.narr2,0,22)
                                                #print(sv_g)
                                                CUST.ATM.narr2=sv_g
                                                #print(CUST.ATM.narr2)
                                                IF ((BANCS.INPUT.CrForacid=="0180293054495") OR (BANCS.INPUT.CrForacid=="0240290235686") OR (BANCS.INPUT.CrForacid=="0820272032149") OR (BANCS.INPUT.CrForacid=="0550293271157")) THEN
                                                        IF (BANCS.OUTPUT.RefNum=="") THEN
                                                                BANCS.OUTPUT.RespCode = "99"
                                                #print(BANCS.OUTPUT.RespCode)
                                                                BANCS.OUTPUT.successOrFailure="F"
                                                                GOTO ENDOFSCRIPT
                                                        ENDIF
                                                        IF ((BANCS.INPUT.CrForacid=="0550293271157") OR (BANCS.INPUT.CrForacid=="0240290235686") OR (BANCS.INPUT.CrForacid=="0010201200504"))  THEN
                                                                BANCS.OUTPUT.RespCode = "99"
                                                #print(BANCS.OUTPUT.RespCode)
                                                                BANCS.OUTPUT.successOrFailure="F"
                                                                GOTO ENDOFSCRIPT
                                                        ENDIF
                                                ENDIF
                                        ENDIF
                                ENDIF
                                IF (sv_k =="BILL:") THEN
                                        sv_v=MID$(CUST.ATM.reversed2,19,20)
                                        print(sv_v)
                                        BANCS.OUTPUT.RefNum = trim(sv_v)
                                        print(BANCS.OUTPUT.RefNum)
                                        sv_z = BANCS.INPUT.ReservedField1
                                        print(sv_z)
                                        sv_s = "acctnum "
                                        sv_s = sv_s + " | "
                                        sv_s = sv_s + " SELECT acctnum "
                                        sv_s = sv_s + " FROM CUSTOM.C_CIC_BILLS "
                                        sv_s = sv_s + " WHERE refnum = ?SVAR "
                                        sv_s = sv_s + " AND del_flg ='N' "
                                        sv_s = sv_s + " AND bank_id = '54' "
                                        BANCS.INPARAM.BINDVARS = sv_z
                                        sv_d =urhk_dbSelectWithBind(sv_s)
                                        print(sv_d)
                                        IF (sv_d == "0") THEN
                                                CUST.ATM.crForacid1 = BANCS.OUTPARAM.acctnum
                                                print(CUST.ATM.crForacid1)
                                        ELSE
                                                BANCS.OUTPUT.RespCode = "99"
                                                #print(BANCS.OUTPUT.RespCode)
                                                BANCS.OUTPUT.successOrFailure = "F"
                                                GOTO ENDOFSCRIPT
                                        ENDIF
                                        sv_s = "count|"
                                        sv_s = sv_s + "SELECT COUNT(1) "
                                        sv_s = sv_s + " FROM DUAL "
                                        sv_s = sv_s + " WHERE EXISTS( "
                                        sv_s = sv_s + "                 SELECT 1 "
                                        sv_s = sv_s + "                 FROM CUSTOM.C_CIC  "
                                        sv_s = sv_s + "                 WHERE acctnum = ?SVAR "
                                        sv_s = sv_s + "             ) "
                                        BANCS.INPARAM.BINDVARS = CUST.ATM.crForacid1
                                        print(sv_s)
                                        sv_d=urhk_dbSelectWithBind(sv_s)
                                        print(sv_d)
                                        IF (sv_d == 0) THEN
                                                CUST.ATM.count = BANCS.OUTPARAM.count
                                        ELSE
                                                CUST.ATM.count ="0"
                                        ENDIF
                                        IF (CUST.ATM.count!=0) THEN
                                            IF ((CUST.ATM.crForacid1!=CUST.ATM.crForAcid4) AND (CUST.ATM.crForacid1!=CUST.ATM.crForAcid2) AND (CUST.ATM.crForacid1!=CUST.ATM.crForAcid3) AND (CUST.ATM.crForacid1!=CUST.ATM.crForAcid5)) THEN
                                                BANCS.OUTPUT.RefNum = TOUPPER(BANCS.OUTPUT.RefNum)
                                                print(BANCS.OUTPUT.RefNum)
                                                sv_s = "sol_id,account,freetext|select agt.sol_id,gam.foracid,agt.FREE_TEXT from agt,gam "
                                                sv_s = sv_s + "where agt.OPER_CREDIT_ACID=gam.acid and gam.ACCT_CLS_FLG!='Y'"
                                                sv_s = sv_s + " and Agent_code = ?SVAR"
                                                sv_s = sv_s + " AND AGT.del_flg !='Y' AND rownum<2"
                                                print(sv_s)
                                                BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId
                                                sv_d =urhk_dbSelectWithBind(sv_s)
                                                print(sv_d)
                                                IF (sv_d == "0") then
                                                        print(BANCS.OUTPARAM.account)
                                                        CUST.ATM.posaccount=BANCS.OUTPARAM.account
                                                        CUST.ATM.possol=BANCS.OUTPARAM.sol_id
                                                        print(BANCS.OUTPARAM.sol_id)
                                                        print(BANCS.OUTPARAM.freetext)
                                                        print(CUST.ATM.posaccount)
                                                        print(CUST.ATM.possol)
                                                        BANCS.OUTPARAM.freetext=rtrim(ltrim(BANCS.OUTPARAM.freetext))
                                                        CUST.ATM.freetextagtt =BANCS.OUTPARAM.freetext
                                                        print(CUST.ATM.freetextagtt)
                                                        IF (CUST.ATM.freetextagtt =="TRACOM") THEN
                                                                sv_s = BANCS.OUTPUT.RefNum
                                                                print(sv_s)
                                                                sv_u = "statusbill,EslipDetails1|select substr(?SVAR,1,instr(?SVAR,':') - 1) ,substr(?SVAR,instr(?SVAR,':') + 1) from dual "
                                                                print(sv_u)
                                                                BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s
                                                                sv_w=urhk_dbSelectWithBind(sv_u)
                                                                print(sv_w)
                                                                CUST.ATM.statusbill = BANCS.OUTPARAM.statusbill
                                                                print(CUST.ATM.statusbill)
                                                                CUST.ATM.EslipDetails1 = BANCS.OUTPARAM.EslipDetails1
                                                                print(CUST.ATM.EslipDetails1)
                                                                IF (FIELDEXISTS(CUST.ATM.statusbill) == 1) THEN
                                                                        IF (CUST.ATM.statusbill!="") THEN
                                                                                BANCS.OUTPUT.RefNum=CUST.ATM.statusbill
                                                                                print(BANCS.OUTPUT.RefNum)
                                                                        ENDIF
                                                                ENDIF
                                                        ENDIF
                                                ENDIF
                                                IF (FIELDEXISTS(BANCS.OUTPUT.RefNum) == 1) THEN
                                                        CUST.ATM.valueone=BANCS.OUTPUT.RefNum
                                                        print(CUST.ATM.valueone)
                                                        IF (FIELDEXISTS(CUST.ATM.valueone)==1) THEN
                                                                print(CUST.ATM.valueone)
                                                                sv_z="|"
                                                                sv_x=STRLEN(CUST.ATM.valueone)
                                                                WHILE(sv_x > 0)
                                                                sv_y=CHARAT(CUST.ATM.valueone,sv_x-1)
                                                                #PRINT(sv_y)
                                                                IF (STRICMP(sv_y,sv_z)) THEN
                                                                        CUST.ATM.valueone=MID$(CUST.ATM.valueone,0,sv_x-1)+""+MID$(CUST.ATM.valueone,sv_x,STRLEN(CUST.ATM.valueone))
                                                                        #print(CUST.ATM.valueone)
                                                                ENDIF
                                                                sv_x=sv_x-1
                                                                DO
                                                                PRINT(CUST.ATM.valueone)
                                                                BANCS.OUTPUT.RefNum = CUST.ATM.valueone
                                                                print(BANCS.OUTPUT.RefNum)
                                                        ENDIF
                                                ENDIF
                                                #### tracom start 1
                                                IF (CUST.ATM.freetextagtt != "TRACOM") THEN
                                                        sv_s = "refNum,name "
                                                        sv_s = sv_s + " |"
                                                        sv_s = sv_s + " select refnum,name "
                                                        sv_s = sv_s + " FROM CUSTOM.C_CIC "
                                                        sv_s = sv_s + " WHERE acctnum = ?SVAR  "
                                                        sv_s = sv_s + " AND refNum = ?SVAR "
                                                        sv_s = sv_s + " AND del_flg = 'N' "
                                                        sv_s = sv_s + " AND bank_id = '54' "
                                                        BANCS.INPARAM.BINDVARS = CUST.ATM.crForacid1 + "|" + BANCS.OUTPUT.RefNum
                                                        print(sv_s)
                                                        sv_d = urhk_dbSelectWithBind(sv_s)
                                                        print(sv_d)
                                                        IF ( sv_d != 0 ) then
                                                                BANCS.OUTPUT.RespCode = "99"
                                                #print(BANCS.OUTPUT.RespCode)
                                                                BANCS.OUTPUT.successOrFailure="F"
                                                                GOTO ENDOFSCRIPT
                                                        ELSE
                                                                BANCS.OUTPUT.TranRemarks=BANCS.OUTPARAM.name
                                                                BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
                                                                IF (BANCS.INPUT.PartTranType=="D") THEN
                                                                        CUST.ATM.narr2="BPAY:"
                                                                        print(CUST.ATM.narr2)
                                                                        print(BANCS.OUTPARAM.refNum)
                                                                        CUST.ATM.narr2 = CUST.ATM.narr2 + "/" + BANCS.OUTPARAM.refNum
                                                                        sv_g = MID$(CUST.ATM.narr2,0,22)
                                                                        print(sv_g)
                                                                        CUST.ATM.narr2=sv_g
                                                                        print(CUST.ATM.narr2)
                                                                        CUST.ATM.narr1=""
                                                                ELSE
                                                                        CUST.ATM.narr2=""
                                                                        print(CUST.ATM.narr2)
                                                                        CUST.ATM.narr2 = CUST.ATM.narr2 + "" + BANCS.OUTPARAM.refNum + "/" + MID$(BANCS.OUTPUT.TranRemarks,0,20)
                                                                        sv_g = MID$(CUST.ATM.narr2,0,22)
                                                                        print(sv_g)
                                                                        CUST.ATM.narr2=sv_g
                                                                        print(CUST.ATM.narr2)
                                                                        CUST.ATM.narr1=""
                                                                        BANCS.INPUT.CardAcceptorName=""
                                                                ENDIF
                                                                IF (FIELDEXISTS(CUST.ATM.freetextagtt) == 1) THEN
                                                                        IF (CUST.ATM.freetextagtt == "TRACOM") THEN
                                                                                IF (FIELDEXISTS(CUST.ATM.EslipDetails1) == 1) THEN
                                                                                        IF (CUST.ATM.EslipDetails1!="") THEN
                                                                                                print(CUST.ATM.EslipDetails1)
                                                                                                IF (FIELDEXISTS(CUST.ATM.narr2) == 1) THEN
                                                                                                        CUST.ATM.narr2=CUST.ATM.narr2 + "/" + LTRIM(BANCS.INPUT.ReservedField3,'0') + "/" + CUST.ATM.EslipDetails1
                                                                                                        print(CUST.ATM.narr2)
                                                                                                        print(BANCS.INPUT.CardAcceptorName)
                                                                                                        BANCS.INPUT.CardAcceptorName=""
                                                                                                        print(BANCS.INPUT.CardAcceptorName)
                                                                                                ENDIF
                                                                                        ENDIF
                                                                                ENDIF
                                                                        ENDIF
                                                                ENDIF
                                                        ENDIF
                                                ENDIF
                                                ##### tracom 1 end
                                            ENDIF
                                        ELSE
						if(sv_k =="BILL:")then
							BANCS.INPUT.CardAcceptorName=""
                                                        print(BANCS.INPUT.CardAcceptorName)
							CUST.ATM.narr2 = BANCS.OUTPUT.RefNum
							print(CUST.ATM.narr2)
						endif
					ENDIF
                                ENDIF
                        ELSE
                                CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0')
                                print(CUST.ATM.serial)
                        ENDIF
                ELSE
                        CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0')
                        print(CUST.ATM.serial)
                ENDIF
                BANCS.OUTPUT.TranParticulars2=BANCS.INPUT.DeviceId
                print(BANCS.OUTPUT.TranParticulars2)
        ELSE
                CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0')
##CHG0031013
		IF (CUST.ATM.dccid =="EAZ") THEN
			Print(BANCS.INPUT.ReservedField3)
			CUST.ATM.serial=Mid$(BANCS.INPUT.ReservedField3,2,20)
			print(CUST.ATM.serial)
		ENDIF
##CHG0031013
		print(CUST.ATM.serial)

        ENDIF
ENDIF
sv_b  = "/"
sv_a = sv_b + CUST.ATM.serial
sv_a = sv_a + sv_b
CUST.ATM.time = MID$(CUST.ATM.Particulars,18,19)
sv_a = sv_a + CUST.ATM.time
CUST.ATM.narr3 = sv_a

##################################################
#---Getting the channel header
##################################################

IF (CUST.ATM.dccid =="SWT") THEN
        #CUST.ATM.narr1="ATM-"
        sv_d = "/"
        sv_a=MID$(BANCS.INPUT.CardAcceptorName,0,16) + sv_d
        print(sv_a)
        #sv_b ="ATM-"
        sv_c =  sv_a
        print(sv_c)
        CUST.ATM.narr1= sv_c
ENDIF
IF (CUST.ATM.dccid =="FAB") THEN
        CUST.ATM.narr1="FAB-"
ENDIF
IF (CUST.ATM.dccid =="BWY") THEN
        CUST.ATM.narr1="EBANK-"
ENDIF
IF (CUST.ATM.dccid == "NKI")THEN
        CUST.ATM.narr1="MCHNT-"
ENDIF
IF (CUST.ATM.dccid == "KEN") THEN
        CUST.ATM.narr1="KEN-"
ENDIF
IF (CUST.ATM.dccid == "INT") THEN
        CUST.ATM.narr1="INT-"
ENDIF
IF ( (CUST.ATM.dccid == "WPD") OR (CUST.ATM.dccid == "HPD"))THEN
        CUST.ATM.narr1="POS-"
ENDIF
IF (CUST.ATM.dccid == "BS1")THEN
        sv_d = "/"
        sv_a=MID$(BANCS.INPUT.CardAcceptorName,0,18) + sv_d
        print(sv_a)
        sv_b ="VISA-"
        sv_h= MID$(CUST.ATM.DeviceId,0,3)
         print(sv_h)
         print(CUST.ATM.command)
         IF (BANCS.INPUT.ReservedField1=="VMTIN") THEN
                 IF (CUST.ATM.command=="DBTR")  THEN
                         sv_b ="VMTOCT-"
                        print(sv_b)
                 ENDIF
                 IF (CUST.ATM.command=="DBRR")  THEN
                         sv_b ="REV_VMTOCT-"
                         print(sv_b)
                 ENDIF
         ENDIF
         print(sv_b)
         sv_c = sv_b + sv_a
         print(sv_c)
         CUST.ATM.narr1= sv_c
 ENDIF
 IF (CUST.ATM.dccid == "MC1")THEN
         sv_d = "/"
         sv_a=mid$(BANCS.INPUT.CardAcceptorName,0,18) + sv_d
         print(sv_a)
         sv_b ="MasterCard-"
        sv_h= MID$(CUST.ATM.DeviceId,0,3)
        print(sv_h)
        print(CUST.ATM.command)
        IF (BANCS.INPUT.ReservedField1=="VMTIN") THEN
                IF (CUST.ATM.command=="DBTR")  THEN
                        sv_b ="VMTOCT-"
                        print(sv_b)
                ENDIF
                IF (CUST.ATM.command=="DBRR")  THEN
                        sv_b ="REV_VMTOCT-"
                        print(sv_b)
                ENDIF
        ENDIF
        print(sv_b)
        sv_c = sv_b + sv_a
        print(sv_c)
        CUST.ATM.narr1= sv_c
ENDIF
IF (CUST.ATM.dccid == "AME")THEN
         sv_d = "/"
         sv_a=mid$(BANCS.INPUT.CardAcceptorName,0,18) + sv_d
         print(sv_a)
         sv_b ="AMEX-"
        sv_h= MID$(CUST.ATM.DeviceId,0,3)
        print(sv_h)
        print(CUST.ATM.command)
        IF (BANCS.INPUT.ReservedField1=="VMTIN") THEN
                IF (CUST.ATM.command=="DBTR")  THEN
                        sv_b ="VMTOCT-"
                        print(sv_b)
                ENDIF
                IF (CUST.ATM.command=="DBRR")  THEN
                        sv_b ="REV_VMTOCT-"
                        print(sv_b)
                ENDIF
        ENDIF
        print(sv_b)
        sv_c = sv_b + sv_a
        print(sv_c)
