print (sv_a)


########SOS/CHG0032139/24042023#########
	#------------------------------------------------------------------------------------------------------------------------
	#FETCHING ELIGIBLE LAA ACCOUNTS
	#------------------------------------------------------------------------------------------------------------------------
	sv_s = "ACID"
	sv_s = sv_s + " |  SELECT   ENTITY_ID   FROM    (select  itc.entity_id,INT_TBL_CODE   from    tbaadm.itc  ,(select  max(INT_TBL_CODE_SRL_NUM)max_srl ,entity_id,bank_id from    tbaadm.itc  where   bank_id='54'  " 
	sv_s = sv_s + "and entity_id in (SELECT L.ACID FROM TBAADM.ACD A, TBAADM.LAM L,TBAADM.GAM G  WHERE "
	sv_s = sv_s + "L.BANK_ID=?SVAR AND L.DEL_FLG='N' AND  G.SOL_ID=?SVAR AND L.ACID=G.ACID AND L.BANK_ID=G.BANK_ID AND L.ENTITY_CRE_FLG='Y' AND "
	sv_s = sv_s + " (L.INT_DMD_OS <= ((CLR_BAL_AMT*-1)-INT_DMD_OS)) AND A.MAIN_CLASSIFICATION_USER='PA' "
	sv_s = sv_s + "AND A.B2K_ID= L.ACID AND L.CHRGE_OFF_FLG!='Y')  group    by  bank_id,entity_id)a "
	sv_s = sv_s + "where itc.bank_id=a.bank_id "
	sv_s = sv_s + "and  itc.entity_id=a.entity_id "
	sv_s = sv_s + "and  itc.INT_TBL_CODE_SRL_NUM=max_srl) "
	sv_s = sv_s + "where INT_TBL_CODE='CZERO'"

	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.mySolId
	PRINT(BANCS.INPARAM.BINDVARS)
########SOS/CHG0032139/24042023#########
	#sv_s = sv_s + " |SELECT B2K_ID FROM TBAADM.ACD WHERE"
