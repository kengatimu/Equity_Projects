	#BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	#PRINT(BANCS.INPARAM.BINDVARS)

	sv_v = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_v)	

	IF(sv_v == 0) THEN
       	 #{
        	CUST.LAA.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       		print(CUST.LAA.CURSOR_NUMBER)
       		sv_b = urhk_dbCursorFetch(CUST.LAA.CURSOR_NUMBER)
        	print(sv_b)
		#BANCS.INPUT.RECCOUNT = CINT("1")
        	#print(BANCS.INPUT.RECCOUNT)

		WHILE(sv_b == "0")
        	#{

			CUST.LAA.ACID = BANCS.OUTPARAM.ACID 
			print(CUST.LAA.ACID)

			#------------------------------------------------------------------------------------------------------------------------
			#Getting the current interest table code
			#------------------------------------------------------------------------------------------------------------------------
			sv_s="code|"
			sv_s = sv_s + " SELECT INT_TBL_CODE FROM TBAADM.ITC WHERE "
			sv_s = sv_s + " BANK_ID=?SVAR AND ENTITY_ID=?SVAR order by INT_TBL_CODE_SRL_NUM desC "
			sv_s = sv_s + " OFFSET 0 ROWS FETCH NEXT 1 ROWS ONLY "
			print(sv_s)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.LAA.ACID
			print(BANCS.INPARAM.BINDVARS)

			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d==0)THEN
			#{
			  	CUST.LAA.code= BANCS.OUTPARAM.code
				print(CUST.LAA.code)
				IF(CUST.LAA.code == "CZERO")THEN
				#{

					#------------------------------------------------------------------------------------------------------------------------
					#Getting the foracid
					#------------------------------------------------------------------------------------------------------------------------

 					sv_u = urhk_B2k_AcidToForacid(CUST.LAA.ACID)
					IF(sv_u==0)THEN
					#{
						CUST.LAA.Foracid= BANCS.OUTPARAM.Foracid
						PRINT(CUST.LAA.Foracid)
					#}
					ENDIF

					#------------------------------------------------------------------------------------------------------------------------
					#Getting the account currency
					#------------------------------------------------------------------------------------------------------------------------
					sv_a = urhk_getAcctDetailsInRepository(CUST.LAA.Foracid)
					print(sv_a)

					IF(sv_a==0)THEN
					#{
						CUST.LAA.crncyCode = trim(BANCS.OUTPARAM.acctCrncyCode)
						print(CUST.LAA.crncyCode)

					#}
					ENDIF

					#------------------------------------------------------------------------------------------------------------------------
					#Getting the previous interest table code
					#------------------------------------------------------------------------------------------------------------------------
					sv_s="tablecode,iddrprefpcnt,minintpntdr,maxintpntdr|"
					sv_s = sv_s + " SELECT INT_TBL_CODE,ID_DR_PREF_PCNT,MIN_INT_PCNT_DR,MAX_INT_PCNT_DR FROM TBAADM.ITC WHERE "
					sv_s = sv_s + " BANK_ID=?SVAR AND ENTITY_ID=?SVAR AND INT_TBL_CODE !='CZERO' order by INT_TBL_CODE_SRL_NUM desC "
					sv_s = sv_s + " OFFSET 0 ROWS FETCH NEXT 1 ROWS ONLY "
					print(sv_s)

					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + CUST.LAA.ACID
					print(BANCS.INPARAM.BINDVARS)

					sv_d = urhk_dbSelectWithBind(sv_s)
					IF(sv_d==0)THEN
					#{
			  			CUST.LAA.tablecode= BANCS.OUTPARAM.tablecode
						print(CUST.LAA.tablecode)						
						CUST.LAA.iddrprefpcnt= BANCS.OUTPARAM.iddrprefpcnt
						print(CUST.LAA.iddrprefpcnt)
						CUST.LAA.minintpntdr= BANCS.OUTPARAM.minintpntdr
						print(CUST.LAA.minintpntdr)
						CUST.LAA.maxintpntdr= BANCS.OUTPARAM.maxintpntdr
						print(CUST.LAA.maxintpntdr)	
					#}
					ELSE
					#{
						GOTO NEXTREC
			
					#}
					ENDIF
					sv_s="acctopndate|"
			                sv_s = sv_s + " SELECT TO_CHAR(db_stat_date,'DD-MM-YYYY') "
                			sv_s = sv_s + " FROM tbaadm.gct "
                			sv_s = sv_s + " WHERE bank_id= ?SVAR"
               				print(sv_s)
			                BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
                			print(BANCS.INPARAM.BINDVARS)
                			sv_d = urhk_dbSelectWithBind(sv_s)
                			PRINT(sv_d)

                			IF (sv_d == 0) THEN
                #{
                        			CUST.LAA.acctopndate  = BANCS.OUTPARAM.acctopndate
                        			PRINT(CUST.LAA.acctopndate)
                			ENDIF

					#------------------------------------------------------------------------------------------------------------------------
					#Changing the table code
					#------------------------------------------------------------------------------------------------------------------------
					sv_u = urhk_SetUrhkInp("loanIntTblCrit.funcCode|M")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("loanIntTblCrit.laAcct.foracid|" + CUST.LAA.Foracid)
					PRINT(sv_u)
			
					sv_u = urhk_ExecSrv("SRV_FetchLoanIntTblDtl|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)

					IF(sv_u==0)THEN
					#{
						PRINT("SUCCESS1")
						sv_u = urhk_CopyOutToIn("")
						PRINT(sv_u)
	
						#sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.key.serial_num|1")
						#PRINT(sv_u)
						CUST.LAA.peggedFlg="N"
						#sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.peggedFlg|" + CUST.LAA.peggedFlg)
						#print(sv_u)
						CUST.LAA.intTblVerNum=""
						sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.intTblVerNum|" + CUST.LAA.intTblVerNum)
						print(sv_u)

						sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.intTblCode.tblCode|" + CUST.LAA.tablecode)
						PRINT(sv_u)

						sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.startDate|" + CUST.LAA.acctopndate)
						PRINT(sv_u)

						sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.acctPrefInt|" + CUST.LAA.iddrprefpcnt)
						print(sv_u)	


						sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.minInt|" + CUST.LAA.minintpntdr)
						print(sv_u)
						sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.maxInt|" + CUST.LAA.maxintpntdr)
						print(sv_u)

						sv_u = urhk_ExecSrv("SRV_processLoanIntTblDtlAndVerify|retain_all_output = Y|same_user_verify = Y")
						PRINT(sv_u)

						IF(sv_u==0)THEN
						#{
							PRINT("SUCCESS2")

						#}
						ELSE
						#{
							GOTO CHECKERROR
						#}
						ENDIF

					#}
					ELSE
					#{
						GOTO CHECKERROR

					#}
					ENDIF

				#}
				ELSE
				#{
					GOTO NEXTREC
				#}
				ENDIF			

			#}
			ENDIF





				CHECKERROR:
				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}									
					ELSE
					#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) then
					#{
						sv_u = system("echo 'Error'")
						sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>loanMgr.log")
							print(sv_u)			

						#}
						DO
					#}
					ENDIF
				#}
				ENDIF		

			

       			GOTO NEXTREC

      			 BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
        		 PRINT(BANCS.INPUT.RECCOUNT)

