#  DESC   :        Active Users Report
######################################################################
RECORDLAYOUT
####################################################################
# 
####################################################################
SOL_ID	stringtype  
foracid stringtype
Name stringtype 
Depositamt numbertype
Matureamnt numbertype 
OpenDate stringtype 
EndDate stringtype 

LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
grforacid numberType
toforacid numberType
grDepositamt numbertype
toDepositamt numbertype
grMatureamnt  numbertype
toMatureamnt  numbertype
total_pages stringtype
totalpages stringtype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType

#
GROUPANDSORT
####################################################################
#   
#################################################################### 
SOL_ID ascending
#
#
REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
branchName      stringtype

REPOSITORY  argv4
#############################################################################

ipSetId				stringType
ipFrmDate			stringType
#
#############################################################################
#MASSAGERECORD
#############################################################################
#
#############################################################################
#IGNORERECORD
#############################################################################
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines  3
LinesPerPage     64
Topmargin         2
BottomMargin      2 
columnsPerLine  130
pageHeaderLines   8
pageFooterLines   2
#
ONSTARTOFREPORT
####################################################################  

execute brBankHdg 
execute pageHdg
#
####################################################################
PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg
#
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
separatorline
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################
Print SOL_ID column 2  
Print foracid column 10
print Name column 25 
print Depositamt column 57 
Print Matureamnt column 73 
Print OpenDate column 89 
Print EndDate column 100

BEFOREBREAKOF SOL_ID
####################################################################
print "Branch ID" column 1
print SOL_ID  column 15
nextline
nextline
#
#
AFTERBREAKOF SOL_ID
####################################################################
# After break of SOL_ID
####################################################################
nextline
separatorline
print " Total :  " column 2
set grforacid = groupcount foracid
set grDepositamt = groupsum Depositamt
set grMatureamnt = groupsum Matureamnt
Print grforacid column 15 
print grDepositamt column 57 
Print grMatureamnt column 73 
nextline
separatorline
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
	separatorline
	print " Grand Total :  " column 2
	set toforacid = totalcount foracid
	set toDepositamt = totalsum Depositamt
	set toMatureamnt = totalsum Matureamnt
	Print toforacid column 15 
	print toDepositamt column 57
	Print toMatureamnt column 73 
	nextline
	separatorline
	nextline
end

begin
     print "printed by:"  size  70 center
     print  lv_userId
     nextline
     nextline
     nextline
     print "verified by:" size  70 center
     nextline
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 130 center
     end
begin
     set total_pages = numtostr pagenumber
     set totalpages = prntagval "TOP" total_pages
end
#
#
############################################################################
Procedure  pageHdg
############################################################################

begin
     print "MATURE TERM DEPOSIT ACCOUNTS  "  size  130 center 
     nextline
     print " AS AT " column   53
     print ipFrmDate  
     nextline
     nextline
 
 end

begin
     separatorline
     print "SOL_ID " column  2
     print "ACCOUNT No." column 10
     print "NAME" column 25
     print "DEPOSIT_AMNT" column 57
     print "MATURE_AMNT" column 73
     print "OPEN_DATE" column 89
     print "END_DATE" column  100
     separatorline
     nextline
end
#
#############################################################################
PROCEDURE brBankHdg
#############################################################################
#
begin
     print "Page No. "   column  110 
     print page_number precision 0
     nextline
     print today column  110
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 130 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 130 center 
   end

####################################################################
# End of File
######################################################################
