####################################################################
RecordLayout
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include psp.mri

LocalVariables
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
page_tot_printed        stringType
total_pages             numberType
cl_flg                  stringType
string1                 stringType
string2                 stringType
emailId                 stringType
footer_printed          stringType
callscript              stringType
lvfacid			stringType
lvtaxamt		numbertype
inst			stringType
inst1			stringType
inst2			stringType
part			stringType
part1			stringType
part2			stringType
instlen			numbertype
address1                stringType
address2		stringType
address3		stringType
conn			stringType
KU			stringType
KU1			stringType
KU2			stringType
KU3			stringType
KU4			stringType
KU5			stringType
Ku6			stringType
particular2		stringType
space                    stringType
tran_part1                stringType
tran_part2                stringType
dot                       stringType
tran_part3                stringType
localdate                  numbertype
localyears                  numbertype
var1 numbertype
var2 numbertype
var3 numbertype
ret stringType
asample stringType
bsample stringType
###################################################################
#   MANDATORY SECTION (3rd Section)
GROUPANDSORT
###################################################################
despatch_mode, acctNum, srl_num, gl_date_in_YYYY_MM_DD, pstd_date_YYYY_MM_DD, tran_id,part_tran_srl_num

repository argv4
page_number         numberType
pr_station          stringType
email_post_ind     stringType

IGNORERECORD
if ( tran_particular = "B/F." )

ONSTARTOFREPORT
set localyears = strToNum localYearsToAdd
set total_pages = 0

ONENDOFREPORT
set page_number = total_pages + 1

pageFormat
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
#linesperPage    68
#columnsperline 150
#pageHeaderLines 7
#pageFooterLines 7
#TopMargin       9
#BottomMargin    5

linesperPage   93
columnsperline 155
pageHeaderLines 17
pageFooterLines 29
TopMargin       3
BottomMargin    0

onEveryRecord
   if pr_station = "N"
      begin
       print tran_date column 3   size 11
#       print instrmnt_num size 11  column 64
	if gl_date_in_YYYY_MM_DD != value_date_in_YYYY_MM_DD
	print Value_date column 23 size 5

## STAR ERIC ################################################################
If schm_code ="CA203"
Begin
	set part1=tran_particular
	set part2 =inst
	set part = strcat part1 part2
	set tran_rmks = ltrim tran_rmks " "
	set ref_num = ltrim ref_num " "
	set KU = ref_num
	set KU1= " "
	set KU2 = tran_rmks
	set KU3 = strcat Ku2 KU1
	Set KU4 = strcat Ku KU1
	set Ku5 = strcat Ku4 Ku3
	set KU6 = strcat KU5 part
	print KU6 size 45 column 32
   end
Else
begin
     set tran_particular = ltrim tran_particular " "
     set instlen = strlen instrmnt_num
     if instlen != 0
     set inst1= "-CHQ-"
     set inst2=ltrim instrmnt_num " "
     set inst=strcat inst1 inst2
     if instlen = 0
     set  inst=""
     set particular2 = substr tran_particular 1 11
     if particular2 ="Chq Deposit"
     begin
     	set space = " "
     	set tran_rmks = ltrim tran_rmks " "
     	set tran_part1= substr tran_particular 1 7
     	set tran_part2= substr tran_particular 12 12
     	set tran_particular=strcat tran_part1 tran_part2
     	set tran_particular = strcat tran_particular space
     	set tran_particular = strcat tran_particular tran_rmks
     end
     set part1=tran_particular
     set part2 =inst
     set part = strcat part1 part2
#        print tran_particular size 45 column 32
     print part size 40 column 32
End
## END ERIC ################################################################
         if ( dr_tran_amt != 0)
	        print dr_tran_amt column 74 autocomma size 16 precision 2
        if ( cr_tran_amt != 0)
        print cr_tran_amt column 91 autocomma size 16 precision 2
        print abs bal_amt column 110 autocomma size 16 precision 2
         print " "
	 print bal_amt format "$$"
        set page_tot_printed = "n"
      end
     else
       begin
        print tran_date column 1   size 11
        print instrmnt_num size 11  column 12
        set tran_particular = ltrim tran_particular " "
        print tran_particular size 30 column 24
        if ( dr_tran_amt != 0)
	        print dr_tran_amt column 74 autocomma size 16 precision 2
        if ( cr_tran_amt != 0)
        print cr_tran_amt column 91 autocomma size 16 precision 2
        print abs bal_amt column 110 autocomma size 16 precision 2
         print " "
	 print bal_amt format "$$"
        set page_tot_printed = "n"
      end
afterBreakOf srl_num
        if groupCount srl_num = 1
        begin
                nextLine
                nextLine
                nextLine
                print "No transactions for this period" column 20
                nextLine
                nextLine
                nextLine
        end
        set cl_flg="Y"
        if linesleftinpage <=5
        begin
        nextPage
        end
        else
        begin
        execute         pageTotProc
        end
beforeBreakOf srl_num
        if totalCount srl_num != 0
                nextpage
        set pagenumber = 1
pageHeader
######################################################################
#   This section tell about the header Layout
######################################################################
        set footer_printed = "Y"
	        nextLine
                nextLine
                nextLine
                nextLine
	set localdate = stringToDate  today
	set localdate = periodAdd localdate localyears Y
	if(despatch_mode = "A" or despatch_mode = "B" or despatch_mode = "D" or despatch_mode = "E")
	begin
		If email_id = ""
		set email_id="equity.statements@equitybank.co.ke"
	end
	set emailId = email_id
	if pr_station = "N"
        begin
#		nextline
#		nextline
#		nextLine
#		nextLine
#		nextLine
#		nextLine
#		nextLine
	if(despatch_mode = "A" or despatch_mode = "B" or despatch_mode = "D" or despatch_mode = "E")
	begin
			print emailId column 15
			nextline
	end
	        print acct_name column 15
                nextline
		execute address2
		nextline
                print   acctNum column 85
                print " - "
		print schm_desc
		print " - "
		print acct_crncy_code
              	nextline
                nextline
         	print   acctDateRange size 10 column 85
                set acctDateRange =splitstring acctDateRange 15, 10
                print acctDateRange   column 108
end
else
        begin
#	       	nextline
#		nextline
#		nextline
#		nextline
#		nextline
#		nextline
#		nextline
#		nextline
		if(despatch_mode = "A" or despatch_mode = "B" or despatch_mode = "D" or despatch_mode = "E")
 		begin
        		print emailid column 15
        		nextline
  		end
	        print acct_name column 15
                nextline
		execute address2
		nextline
#              	nextline
#              	nextline
                print   acctNum column 85
                print " - "
		print schm_desc
		print " - "
		print acct_crncy_code
              	nextline
                nextline
         	print   acctDateRange size 10 column 85
                set acctDateRange =splitstring acctDateRange 15, 10
                print acctDateRange   column 108
                nextLine
                nextLine
                nextLine
                nextLine
                nextLine
     end
 pageFooter
######################################################################
#   This section tells about the footer Layout
######################################################################
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
        set total_pages = total_pages + 1
        execute footerprint
        set footer_printed = "Y"
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
	nextLine
procedure footerPrint
        execute pageTotProc
#        nextLine
        set string1 = substr user_rmks_1 1,75
        print   string1 column 1 size 75
nextLine
nextline
nextline
print " Do you need foreign exchange services? Contact your Manager or The Equity Treasury team on 0711026941-8/0732112941-8/0202262941-8 " column 1
# print "Visit any of our branches for more information. " column 1
     nextLine
       	set string2 = substr user_rmks_2 1,75
	print   string2 column 1 size 75
#        nextLine

procedure       pageTotProc
#     if ( dr_tran_amt != 0)
#                print dr_tran_amt column 50 format "###,###,###,###.##"
#        if ( cr_tran_amt != 0)
#        print cr_tran_amt column 67 autocomma size 14 precision 2
#        print abs bal_amt column 81 autocomma size 12 precision 2
#         print " "
#	 print bal_amt format "$$"
        if page_tot_printed = "n"
        if pr_station = "N"
        begin
                separatorLine
              	print   "Page Total:  "  column 1
                print pageSum dr_tran_amt autocomma size 16   column 74
                print pageSum cr_tran_amt autocomma size 16   column 91
                set var1 = pageSum cr_tran_amt
                set var2 = pageSum dr_tran_amt
                set var3 = var1 - var2
                set var3 = bal_amt
#                print var3  autocomma size 15   column 114
                 if(var3 < 0)
                begin
                print abs var3  autocomma size 16   column 110
                print " Dr"
                end
                else
                begin
                print abs var3  autocomma size 16   column 110
                print " Cr"
                end
                separatorLine
                set page_tot_printed = "y"
        end
     else
             begin
                separatorLine
                print   "Page Total:  "  column 1
#                print pageSum dr_tran_amt column 76  format "###,###,###.##"
		print pagesum dr_tran_amt column 74 autocomma size 16 precision 2
		print pagesum cr_tran_amt column 91 autocomma size 16 precision 2
                set var1 = pageSum cr_tran_amt
                set var2 = pageSum dr_tran_amt
                set var3 = var1 - var2
                set var3 = bal_amt
                if(var3 < 0)
                begin
                print abs var3  autocomma size 16   column 110
                print " Dr"
                end
                else
                begin
                print abs var3  autocomma size 16   column 110
                print " Cr"
                end
                separatorLine
                set page_tot_printed = "y"
             end
        if cl_flg = "Y"
          if pr_station = "N"
           begin
                print   "Grand Total:  "  column 1
#                 print groupSum dr_tran_amt column 76 format "###,###,###.##"
		print groupSum dr_tran_amt column 74 autocomma size 16 precision 2
		print groupSum cr_tran_amt column 91 autocomma size 16 precision 2
                set var1 = groupSum cr_tran_amt
                set var2 = groupSum dr_tran_amt
                set var3 = var1 - var2
                set var3 = bal_amt
#                print var3  autocomma size 15   column 117
                 if(var3 < 0)
                begin
                print abs var3  autocomma size 16   column 110
                print " Dr"
                end
                else
                begin
                print abs var3  autocomma size 16   column 110
                print " Cr"
                end
		separatorLine
		print   "Uncleared Cheques:  "  column 1
		print abs un_clr_bal_amt column 110 autocomma size 16 precision 2
		print " "
	        print un_clr_bal_amt format "$$"
                set cl_flg="N"
	        separatorLine
                print Close_date column 10
            end
           else
            begin
                print   "Grand Total:  "  column 1
#                 print groupSum dr_tran_amt column 76 format "###,###,###.##"
		print groupSum dr_tran_amt column 74 autocomma size 16 precision 2
		print groupSum cr_tran_amt column 91 autocomma size 16 precision 2
#                print groupSum cr_tran_amt column 67 format "###,###,###.##"
#                print abs bal_amt column 80 format "###,###,###.##"
                set var1 = groupSum cr_tran_amt
                set var2 = groupSum dr_tran_amt
                set var3 = var1 - var2
                set var3 = bal_amt
#                print var3  autocomma size 15   column 108
                 if(var3 < 0)
                begin
                print abs var3  autocomma size 16   column 110
                    print " Dr"
                end
                else
                begin
                print abs var3  autocomma size 16   column 110
                    print " Cr"
                end
		separatorLine
		print   "Uncleared Cheques:  "  column 1
		print abs un_clr_bal_amt column 110 autocomma size 16 precision 2
                print " "
		print un_clr_bal_amt format "$$"
                set cl_flg="N"
	         separatorLine
		 print Close_date column 10
            end
###########################################################################
procedure address2
###########################################################################
begin
if address_type = "Mailing"
begin
	if cust_comu_addr1 ="."
	set cust_comu_addr1="  "
	if pin_code = "."
	set pin_code =" "
	if pin_code = "."
		print " " column 15
	else
	Set address1 = StrCat cust_comu_addr1 "-"
	Set address2 =  strcat address1 pin_code
	print address2  column 15
	nextline
	If city_desc = "."
	set city_desc = " "
	if city_desc = "MISSING @MIGRATION"
		print " "
	else
		print city_desc column 15
end
if (address_type="Home" or address_type="Registered")
begin
       if cust_perm_addr1="."
        set cust_perm_addr1=" "
	if perm_pin_code = "."
	set perm_pin_code= " "
		if perm_pin_code = "."
		print " "
	else
		Set address1 = StrCat cust_perm_addr1 "-"
                Set address2 =  strcat address1 perm_pin_code
		print address2  column 15
                nextline
		If perm_city_desc = "."
		set perm_city_desc = " "
		if perm_city_desc = "MISSING @MIGRATION"
		print " "
		else
		print perm_city_desc column 15
  end
if (address_type="Work" or address_type="Head Office")
begin
       if cust_emp_addr1="."
        set cust_emp_addr1 =" "
#       print cust_emp_addr1  column 15
#         nextline
#       if cust_emp_addr2 = "."
#        set cust_emp_addr2=" "
#       print cust_emp_addr2 column 15
		if emp_pin_code = "."
		set emp_pin_code= " "
		if emp_pin_code = "."
		print " "
	else
		Set address1 = StrCat cust_emp_addr1 "-"
                Set address2 =  strcat address1 emp_pin_code
		print address2  column 15
                nextline
		If emp_city_desc = "."
		set emp_city_desc = " "
		if emp_city_desc = "MISSING @MIGRATION"
		print " "
	else
		print emp_city_desc column 15
end
end
