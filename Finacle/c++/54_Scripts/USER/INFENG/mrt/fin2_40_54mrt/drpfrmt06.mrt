RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include drp.mri

LOCALVARIABLES 
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
attribute				stringType
deposit_amount_in_words stringType
s1 			stringType
s2 			stringType
s3 			stringType
s4 			stringType
s5 			stringType
deplen1     numberType
deplen2     numberType
row_num     numberType
localdate		numberType
localyears		numberType
callscript              stringType
depAcctId		stringType
lvTranId		stringType
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
localYearsToAdd		stringType

IGNORERECORD
	
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
	LinesPerPage 64
#	LeftMargin 3 
#	rightMargin 2	
#	Topmargin	2
	BottomMargin 2
#	columnsPerLine 80
	columnsPerLine 90
      pageHeaderLines	1
      pageFooterLines 2

ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
set localyears = strToNum localYearsToAdd
PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
set deposit_amount_in_words = numToWords deposit_amount
	if crncy_code = "INR"
	begin
		set crncy_code = "Rs."
	end
set deposit_amount_in_words = crncyNumToWords deposit_amount desiDesc
#set s1 = splitstring deposit_amount_in_words 1 40
set s1 = splitstring deposit_amount_in_words 1 40
set deplen1 = strlen s1
set deplen1 = deplen1 + 1
set row_num = 1
set s2 = splitstring deposit_amount_in_words deplen1 80
set deplen2 = strlen s2
set deplen1 = deplen1 + deplen2
	if deplen2 > 0
	begin
		set row_num = 2
	end
set s3 = splitstring deposit_amount_in_words deplen1 45
set deplen2 = strlen s3
set deplen1 = deplen1 + deplen2
	if deplen2 > 0
	begin
		set row_num = 3
	end
set s4 = splitstring deposit_amount_in_words deplen1 45
set deplen2 = strlen s4
set deplen1 = deplen1 + deplen2
	if deplen2 > 0
	begin
		set row_num = 4
	end
set s5 = splitstring deposit_amount_in_words deplen1 45
set deplen2 = strlen s5
	if deplen2 > 0
	begin
		set row_num = 5
	end

execute dep1Details
#BEFOREBREAKOF srlnum

#AFTERBREAKOF srlnum

#BEFOREBREAKOF pt_type
#AFTERBREAKOF pt_type
ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
######################################################################
#  PROCEDURE BLOCK
######################################################################
PROCEDURE dep1Details
#nextline 
#nextline 
nextline
nextline
nextline
nextline 
nextline
nextline
nextline
nextline 
nextline
nextline
nextline
print "CERTIFICATE OF DEPOSIT" column 30 size 30
nextline
print "(Not transferable/Not negotiable)" column 29 
nextline
nextline
print "Branch Name:" column 1
print branchName column 18
nextline
nextline
print "Date:" column 1
set localdate = stringToDate  acct_open_date
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 18
nextline
nextline
print "Customer Account Name:" column 1
#print customerName 
print accountName 
#accountName
nextline
nextline
print "Account Number:" column 1
print accountNumber column 18
nextline
nextline 
print "PRINCIPAL AMOUNT:" column 1
print deposit_amount    column 18  autocomma leftjustify size 17
nextline
nextline
print "CURRENCY:" column 1
print crncy_code column 18
nextline
nextline
set depAcctId  = accountNumber
set callscript = runscript "ebGetDrp.scr" "depAcctId" "lvTranId" 
print "INTEREST RATE:" column 1
print interest_rate column 18 
print "% P.A" column 22
nextline
nextline
print "REF NO:" column 1
print lvTranId column 18 
nextline
nextline
if schemeCode ="TD401"
begin
print "DEPOSIT TYPE:" column 1
print "CALL DEPOSIT" column 18 
end
if schemeCode != "TD401"
begin
print "PERIOD:" column 1
if years=1
begin
		print years column 18 
		print "year" column 20
	end
if years > 1
	begin
		print years column 18 
		print "years" column 20
	end
if months=1
	begin
		print months column 18 
		print "month" column 20
	end
if months > 1
	begin
		print months column 18 
		print "months" column 20
	end
if deposit_period_days > 0
	begin
		print deposit_period_days column 18 
		print "days" column 22
	end 
end
nextline
nextline
#print "DEPOSIT TYPE:" column 1 
#print deposit_type column 18
#nextline
#nextline
if schemeCode != "TD401"
begin
print "MATURITY DATE:" column 1
set localdate = stringToDate  maturity_date
set localdate = periodAdd localdate localyears Y
print localdate DateFormat ""  column 18
end
nextline
nextline
if schemeCode != "TD401"
begin
print "MATURITY AMOUNT:" column 1 
print maturity_amount    column 18  autocomma leftjustify size 17
nextline
nextline
nextline 
nextline
nextline
end
nextline
print "We accept your deposit with us with the following terms:-" column 1 
nextline
nextline
#print "PAYMENT AT MATURITY" column 1
#nextline
#nextline
#print "PRINCIPAL AMOUNT:" column 3
#print crncy_code column 39 
#print  abs deposit_amount autocomma size 17  column 43 precision 2
#nextline
#nextline
#print "ACCRUED INTEREST AMOUNT:" column 3
#print crncy_code column 39
#print  abs total_interest autocomma size 17  column 43 precision 2
#nextline
#nextline
#print "LESS WITHHOLDING TAX:" column 3
#print crncy_code column 39
#print  abs total_interest autocomma size 17  column 43 precision 2
#nextline
#nextline
#print "TOTAL AMOUNT:" column 3
#print crncy_code column 39
#print  abs total_interest autocomma size 17  column 43 precision 2
#nextline
#nextline
#print "Note:-" column 1 
#nextline
#nextline
print "1. Interest rate is subject to change based on CBK regulations and the Bank's  " column 1
nextline
print " policies in place from time to time." column 3
nextline
print "2. Interest shall be paid in accordance with the Account Terms and Conditions." column 1
nextline
print "3. Interest earned is subject to the applicable tax deductions in accordance with " column 1
nextline
print " the applicable tax laws unless a copy of an exemption certificate is presented to " column 3
nextline
print " the Bank prior to payment." column 3
nextline
nextline
nextline
print "Yours Faithfully," column 3
nextline 
nextline
nextline
print"(FOR EQUITY BANK (KENYA) LIMITED)" column 3
nextline 
nextline
nextline 
nextline 
nextline
nextline
print "...................." column 3 
print "...................." column 60
nextline
print"AUTHORISED SIGNATORY" column 3
print"AUTHORISED SIGNATORY" column 60
nextline
nextline
print prtg_rmks column 3 size 70
nextline
nextline
if menu_parm = 'D'
	begin
 		set attribute = "DUPLICATE"
		print "**** "  column 19
		print attribute  column 24 size 50
		print "**** "  column 33
	end
#nextpage
###############################################################################
