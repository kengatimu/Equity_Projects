#********************************************************************************
#    Report Name                        :       daily_dr06.mrt                 *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    GENERAL REPORT DESCRIPTION                                                 *
#    --------------------------                                                 *
#    This is the Mahareport specs for generating the Security Portfolio by Type Report	*					# 
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    MODIFICATION LOG                                                           *
#    ----------------                                                           *
#                                                                               *
#    Sr.no.  Date           Author                 Description                  *
#    ------  --------       ------------           -----------                  *
#    1.0     07-9-2005     Timothy Muchemi         Original Version             *
#                                                                               *
#################################################################################

#**********************************************************************
#  DESC   :   Security Portfolio Report 
######################################################################
RECORDLAYOUT
####################################################################
#   
####################################################################

secu_srl_num           		numbertype
acct_num           		numbertype 
acct_name                       stringType 
secu_type_ind			stringtype
secu_desc			stringtype
secu_value			numbertype
clr_bal_amt			numbertype
lodge_date			stringtype

LOCALVARIABLES
####################################################################
####################################################################

total_sec            numbertype
total_bal            numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType

#
GROUPANDSORT 
####################################################################
#   
####################################################################
#
REPOSITORY bankRepos.rip
############################################################################
bankName        stringType
branchName      stringtype
#
#############################################################################
REPOSITORY  argv4
#############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
ONSTARTOFREPORT
#############################################################################
set total_sec = 0
set total_bal = 0

execute brBankHdg 
execute pageHdg
#
PAGEHEADER
###################################################################
execute brBankHdg 
execute pageHdg
#
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    66
columnsperline 175 
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 7
pagefooterlines 4
#
#AFTERBREAKOF 
####################################################################
#AFTERBREAKOF
####################################################################
#
ONEVERYRECORD
####################################################################

####################################################################
begin
     nextline
     set total_sec = total_sec + secu_value
     set total_bal = total_bal + clr_bal_amt
     print secu_srl_num   		 column 1 
     print acct_num        		 column 11  
     print acct_name                  column 25 
     print secu_type_ind		 column 70 
     print secu_desc			 column 80 
     print secu_value 		 column 110 format "###,###,###.##" 
     print clr_bal_amt 		 column 130 format "###,###,###.##" 
     print lodge_date		 column 150 
end 
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################

 begin
     nextline
     nextline
     separatorline
     print "Total : " column 1
     print total_sec  column 110  precision 2
     print total_bal column 133 precision 2
     separatorline 
     nextline
    end

begin
     print "       Printed By:  " column 20
     Print lv_userId
     print "   " 
     print today  
     nextline
	print "       Authorised Signatory (BRANCH)" column 20	
	print "       Authorised Signatory"  column 77
	nextline
	nextline
	nextline
	print "       Signature" column 77
	nextline
	nextline
     print "*************************END OF REPORT****************************" size 175 center
  
end

#
Procedure  pageHdg
######################################################################n
begin
     nextline
     print "SECURITY PORTFOLIO BY TYPE "  size  175 center 
     nextline
     nextline
     print " From  " column   73 
     print ipFrmDate  
     print "  &  "
     print ipToDate   
     nextline
     nextline
end

begin
     separatorline
     print "SRL NO"            column 1
     print "A/C NO"            column 11
     print "A/C NAME"          column 25
     print "SEC_TYPE"          column 70
     print "SEC DESC"          column 80
     print "SECURITY VALUE"    column 110
     print "CLR BAL AMT"       column 130
     print "LODGEMENT DATE"    column 150
     nextline
     separatorLine
end

#######################################################################
PROCEDURE brBankHdg
#############################################################################
begin
     print "Page No. "   column  130 
     print page_number precision 0
     nextline
     print today column  130
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 175 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 175 center 
end

####################################################################
# End of File
######################################################################
