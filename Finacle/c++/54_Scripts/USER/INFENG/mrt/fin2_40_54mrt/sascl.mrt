# ***************************************************************************
#    Report Name				: 	    SASCL						    	*
#    Template File Name			:	    sascl.mrt                  		    *
#																			*
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    GENERAL REPORT DESCRIPTION                                     		*
#    --------------------------                                     		*
#    SYSTEM ASSET CLASSIFICATION                                			*
# 																			*
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    MODIFICATION LOG	                                            		*
#	 ----------------														*
#																			*
#    Sr.no.  Date        Author      Description                    		*
#    ------  ----------  --------    ----------------               		*
#     01     25-12-1998  santhosh    Original Ver              	         	*
#	  02	 14-09-2002  Srinath R	 Modification for 7.0 release			*
#									 [ SASCL and MAPD merger ]				*
# ***************************************************************************


RECORDLAYOUT  
#############################################################################
#
#   RECORDLAYOUT (Mandatory Section) - 1st Section.
#   This section tells the record layout of the input ASCII file. This has
#   to be the  First Section in  the  template file, The  fields  datatype
#   can be either "stringType" or "numberType". It assumes that in the in-
#	coming records, the fields are separated by Pipe (i.e '|').
#
#############################################################################
$$$include sascl.mri

LOCALVARIABLES
#############################################################################
#
#   LOCALVARIABLES (Mandatory Section) - 2nd Section.
#   This is the Second Mandatory Section in the Template File.The name of the
#   Section "LOCALVARIABLES" must be there even though there are no local var
#   -iables to be declared.Here also, the local variables must have a type as
#	either "stringType" or "numberType".
#
#############################################################################

GROUPANDSORT
#############################################################################
#
#   GROUPANDSORT (Mandatory Section) - 3rd Section.
#   This has to be the Third Section (Mandatory) in the  template file.  Even 
#   though there are no fields(Sorting field),the Section name must be there.
#   This section  tells  how  the input file is to be sorted. All the  fields
#   present  in this section must have been defined in the RECORDLAYOUT sect-
#   ion.Further,the direction of sort(ASCENDING, DESCENDING or ALREADYSORTED)
#   can be set by typing the word to the right of the field.The Default  Sort
#   order is ASCENDING. If there are more than ONE sorting field, the records
#   are sorted first based on the first field, then within that based on  the 
#   second field and like-wise.... .  The Maximum No. of  Sorting  Fields  at  
#   present supported is 8 only.
#
#############################################################################
customerId, typeOfAsset, assetCrncyCode, assetId, mapdRpdaInd

#############################################################################
#
#	REPOSITORY (Optional Section) - Fixed-Type Repository.
#	This section tells about the Repository Information. A  Repository  is  a 
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#	Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#   
#############################################################################
REPOSITORY  bankRepos.rip 
	bankName 				    StringType
	branchName					StringType

#############################################################################
#
#	REPOSITORY (Optional Section) - Variable-Type Repository.
#	Variable-Type  Repository  differs from  the  Fixed-Type is that its name
#	(Repository File Name) is decided at RUN-TIME and can be substituted  for
#   argv4 in the Template File. Its Name Fields and Field Values is also  set
#   during RUN-TIME. However, Its Values can be used in the Template File.
#
#############################################################################
REPOSITORY argv4
	reportTo			    stringType
	setId               	stringType
	custId                	stringType
	schmType			    stringType
	schmCodeList            stringType
	glSubHeadCode           stringType
	regType               	stringType
	regSubType				stringType
	foracid                 stringType
	crncyCode               stringType
	acctManager             stringType
	billId					stringType
 	assetType               stringType
	trialRun                stringType
	onlyOverdueAssets		stringType
	PAGE_NUMBER				numberType
	DelinquencyReportRqd   	stringType
	MapdRpdaReq				stringType	

MASSAGERECORD
#############################################################################
#
# 	MASSAGERECORD (Optional Section).
# 	The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#	later. This Block is executed every time a new record is read.
#
#############################################################################

#############################################################################
#
# 	IGNORERECORD (Optional Section).
# 	The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
# 	for input records), the record is Ignored.
#
#############################################################################
IGNORERECORD
	
PAGEFORMAT
#############################################################################
#
# 	PAGEFORMAT (Optional Section).
#   This section tells about the page Layout (Printed Page). Here  the  valid
#   pageformat keywords are Linesperpage, Leftmargin, Rightmargin, Topmargin, 
#   BottomMargin, ColumnsperLine, PageHeaderLines, PageFooterLines,noPageFeed
#   widowOrphanLines.
#
#############################################################################
	widowOrphanLines 	3
	LinesPerPage 		64
	LeftMargin 			0 
	rightMargin		 	0	
	Topmargin			2
	BottomMargin 		2
	columnsPerLine 		132
    pageHeaderLines		18
    pageFooterLines 	4

ONSTARTOFREPORT
#############################################################################
#
#	ONSTARTOFREPORT (Optional Section).
#	This Section  will be  executed  Only  Once  during the Processing of the 
#   the Report (i.e in the beginning of the Report).Here the valid statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#	NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#	If, Else, execute, DontFlushAfterSection.
#
#############################################################################
	set pageNumber = 1
	nextline
	execute printReportHdr
	nextline
	execute printCriteria
PAGEHEADER 
#############################################################################
#
#	PAGEHEADER (Optional Section).
#	This Section is Called for whenver there is a PageBreak or NextPage. Here
#   the valid  Statements  are  Actions only, as described in ONSTARTOFREPORT 
#   section. However,the Number of lines printed through the action statement
#   can not exceed the value (no. of lines) specified for pageHeaderLines  in
#   in PAGEFORMAT Section.
#
#############################################################################
execute printHdr
nextline
nextline 
separatorline
execute printDetailsHdr
separatorline

PAGEFOOTER
#############################################################################
#
#	PAGEFOOTER (Optional Section).
#	This Section is Called for whenver there is a PageBreak or NextPage. Here
#   the valid  Statements  are  Actions only, as described in ONSTARTOFREPORT 
#   section. However,the Number of lines printed through the action statement
#   can not exceed the value (no. of lines) specified for pageFooterLines  in
#   in PAGEFORMAT Section.
#
#############################################################################
separatorline

BEFOREBREAKOF  customerId
################################################################################
#	BEFOREBREAKOF
#
################################################################################
#nextline
#separatorline
#nextline
#
AFTERBREAKOF  customerId 
################################################################################
#	AFTERBREAKOF
#
################################################################################
if ( customerId = "")
	begin
		separatorline
		nextline
		nextline
		nextline
		print " **************  No records selected for system Classification **************" column 30
		nextline
		nextline
		nextline
		separatorline
	end
else 
	begin 
		separatorline
		nextline
 	end	

ONEVERYRECORD 
#############################################################################
#i
#	ONEVERYRECORD (Optional Section).
#   This section  is  executed  Once  for all input  records. Here, the valid 
#	Statements are Actions only as described in ONSTARTOFREPORT Section.
#
#############################################################################
execute printDetails

ONENDOFREPORT
#############################################################################
#
#	ONENDOFREPORT (Optional Section).
#	This Section  will be  executed  Only  Once  during the Processing of the 
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#	NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#	If, Else, execute, DontFlushAfterSection.
#
#############################################################################
nextline
nextline
	print "Prepared by" column 15
	print "Checked by" column 33
	print "Manager/Senior Manager" column 67
	nextline
nextline
nextline
# ===========================================================================
# Set the values back for repository variables
# ===========================================================================
	set PAGE_NUMBER = pageNumber

#############################################################################
#
# 	PROCEDURE BLOCK.
#  	Procedure  itself is a Independent  Block  and  defined at the end of the 
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#	Template File, Makes  it  Structured  and  avoids burring the same set of 
#   codes at several places.
#
#############################################################################

PROCEDURE printHdr
#############################################################################
#
#	PROCEDURE printHdr
#   This procedure is called from PAGEHEADER Section and ONSTARTOFREPORT
#   Section. This prints the Header of the Report on EveryPage.
#
#############################################################################
begin
	nextline
	print "Page: " column 120
	print pageNumber column 126 precision 0
	nextline
end
PROCEDURE printReportHdr
#############################################################################
#
#	PROCEDURE printReportHdr
#   This procedure is called from ONSTARTOFREPORT Section. 
#
#############################################################################
begin
	print today column 1
	print bankName column 35
	print "     "
	print branchName 
	nextline
	nextline
	print "SYSTEM ASSET CLASSIFICATION REPORT" size 128  center
	nextline
	print "WITH PASTDUE/REVERSE PASTDUE DETAILS" size 128 center
	nextline
	print "----------------------------------" size 128  center

end


PROCEDURE printCriteria
#############################################################################
#
#	PROCEDURE printCriteria
#   This procedure is called from ONSTARTOFREPORT Section. 
#
#############################################################################
	begin
		separatorline
		print	"SELECTION CRITERIA" column 20 
		nextline
		print	"------------------" column 20
		nextline
		nextline
        print "Report To                  : " column 10
   		print  reportTo          
        nextline
        print "SOL Set Id                 : " column 10
   		print  setId          
        nextline
        print "Asset Type                 : " column 10
   		print  assetType          
        nextline
        print "Customer Id                : " column 10
   		print  custId         
        nextline
        print "Scheme Type                : " column 10
   		print  schmType          
        nextline
        print "Scheme Code                : " column 10
   		print  schmCodeList          
        nextline
		print "GL Sub Head Code           : " column 10
        print  glSubHeadCode
        nextline
        print "Register Type              : " column 10
   		print  regType          
        nextline
        print "Register Sub Type          : " column 10
   		print  regSubType          
        nextline
        print "Account No.                : " column 10
   		print  foracid          
        nextline
		print "Currency Code              : " column 10
        print  crncyCode
        nextline
        print "Account Manager            : " column 10
   		print  acctManager          
        nextline
        print "Bill Id                    : " column 10
   		print  billId          
        nextline
        print "Only Overdue Assets?       : " column 10
   		print  onlyOverdueAssets          
        nextline
        print "Trial Mode                 : " column 10
   		print  trialRun          
		nextline
		print "Delinqueny Report Required : " column 10
		print DelinquencyReportRqd
        nextline
		print "Update Past Due Required   : " column 10
		print MapdRpdaReq
        nextline
		separatorline
		nextpage
	end

######################################################################################
PROCEDURE printDetailsHdr
######################################################################################
# To be printed after each page break
######################################################################################
begin
		print "ASSET DETAILS :"					column 1
		nextline
        print "A/c No./Bill Id/Cust Id " 		column 1
#        print "Name " 							column 36
        print "Past Due"						column 118
        nextline
		print "DPD Counter"                     column 12
        print "Liability "  				    column 36 
		print "Old System Classification "    	column 50
		print "Old User Classification "    	column 76
		print "New Sys Classfn "    			column 102
		print "New User Classfn "    			column 116
        nextline
		print " Main "	    					column 52
        print " Sub " 							column 59
		print " Date "			    			column 66
		print " Main "    						column 78
        print " Sub " 							column 85
		print " Date "    						column 92
		print " Main "   			 			column 104
        print " Sub " 							column 111
		print " Main "  			  			column 118
        print " Sub " 							column 125
        nextline
        print "Remarks " 						column 10
		nextline
		nextline
		print "PAST DUE DETAILS : "				column 1
		nextline
		print "Tran Id"							column 1
		print "  Int Suspense Amt" 				column 14
		print "Penal Int Suspense Amt"			column 37
		print "Date Accrue/Non Accrue"			column 61
		print "Present GL Code"					column 86
		print "New GL Code"						column 103
		nextline
		print " Past Due Remarks "				column 2
		nextline
end
########################################################################################
PROCEDURE printDetails
######################################################################################
#
######################################################################################
begin
	if mapdRpdaInd = "A" 
	begin
		print typeOfAsset		size 5  column 1 
		print assetId  			size 16 column 7 
#		print assetPartyName	size 80 column 36
		print pastDueFlg		size 1  column 121
		nextline
		print maxDPDCounter		size 4  column 15
		if ( liability < 0 )
		begin
			set liability = -1 * liability
			print liability autocomma size 17 column 26
			print "Dr" column 44
		end
		else
		begin
			print liability autocomma size 17 column 26
			print "Cr" column 44
		end
		print assetCrncyCode					size 3  column 47
		print oldMainClassificationSystem  		size 5	column 52
		print oldSubClassificationSystem  		size 5	column 59
		print oldSystemClassificationDate  		size 10	column 66
		print oldMainClassificationUser  		size 5	column 78
		print oldSubClassificationUser     		size 5	column 85
		print oldUserClassificationDate    		size 10	column 92
		print mainClassificationSystem     		size 5	column 104
		print subClassificationSystem      		size 5	column 111
		print mainClassificationUser       		size 5	column 118
		print subClassificationUser        		size 5	column 125
		nextline
		print remarks   						size 110 column 10
#		nextline
	end
	if mapdRpdaInd = "M"
	begin
		print "******* PAST DUE DETAILS ******* " column 5
		nextline
		execute pastDueDetails
	end
	else
	if mapdRpdaInd = "R"
	begin
		print "******* REVERSE PAST DUE DETAILS ******" column 5
		nextline
		execute pastDueDetails
	end
	nextline
	nextline
end
########################################################################################
#################################################################################
#################################################################################
PROCEDURE pastDueDetails
##################################################################################
begin 
	    print tranId 							size 10 column 1
        if ( intSuspenceAmt < 0 )
        begin
            set intSuspenceAmt = -1 * intSuspenceAmt
            print intSuspenceAmt autocomma 		size 17 column 14
            print "Dr" column 32
        end
        else
        begin
            print intSuspenceAmt autocomma 		size 17 column 14
            print "Cr" column 32
        end
        if ( penalIntSuspenceAmt < 0 )
        begin
            set penalIntSuspenceAmt = -1 * penalIntSuspenceAmt
            print penalIntSuspenceAmt autocomma size 17 column 37
            print "Dr" column 55
        end
        else
        begin
            print penalIntSuspenceAmt autocomma size 17 column 37
             print "Cr" column 55
        end
		if mapdRpdaInd = "M"
		begin
        	print dateNonAccrue 				size 10 column 65
        end
		else 
		begin
        	print dateNonAccrue 				size 10 column 65
		end
		print presentGLCode 					size 5  column 90
		if ( newGLCode = "" )
		begin
        	print presentGLCode	     				size 5  column 105
		end
		else
		begin
			print newGLCode					size 5	column 105
		end
        nextline
        print mpdaRpdaRemarks     				size 120 column 1
		nextline
		nextline
end
##################################################################################
#end of Mrt #######
