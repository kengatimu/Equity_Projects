###########################################################################
RECORDLAYOUT
##########################################################################
AcctNO        stringType
Name          stringType
tranid        stringType
Detail       stringType

################################################################################
LOCALVARIABLES
################################################################################
sINo            numberType
pageNo          numberType
total           numberTYpe
tot_page        stringType
totpage         numberType

###############################################################################
GROUPANDSORT
###############################################################################

##############################################################################
PAGEFORMAT
############################################################################
linesperpage    50
columnsperline  90 
pageheaderlines 10
pagefooterlines 5
topmargin   1
bottomMargin    1

#########################################################################
ONSTARTOFREPORT
#######################################################################
print "SALPAY CHARGE COLLECTION LIST" column 1 size 90  center
set sINo = 0
set pageNo = 0
set tot_page=0
set totpage=0
nextline
nextline
separatorline
execute pageHdr
separatorline
##########################################################################
ONENDOFREPORT
######################################################################

nextline
print "END OF REPORT " column 40
nextline

#######################################################################
PAGEHEADER
######################################################################
print "SALPAY CHARGE COLLECTION LIST" column 0 size 90 center
nextline
execute pageHdr

####################################################################
PAGEFOOTER
########################################################################
nextline
execute pageFot

#######################################################################
ONEVERYRECORD
########################################################################3
BEGIN

set SINO = SINO + 1
nextline
print "|"                   column  3
print   SINO                column  4
print "|"                   column  7
print   AcctNO              column  8 
print "|"                   column  25
print   Name                column  26
print "|"                   column  45
print   tranid              column  46
print "|"                   column  57
print   Detail              column  58
print "|"                   column  90
END
#############################################################################
PROCEDURE pageHdr
############################################################################
BEGIN
print "|"                   column  3
print   "SINO "             column  4
print "|"                   column  7
print   "AcctNO "           column  8 
print "|"                   column  25
print   "Account Name"      column  26
print "|"                   column  45
print   "TRAN ID"           column  46
print "|"                   column  57
print   "DETAIL"            column  58
print "|"                   column  90
END
###############################################################################
PROCEDURE pageFot
################################################################################
BEGIN
separatorline
set pageNo = pageNo + 1
print "Page "column 45
print pageNo
End
