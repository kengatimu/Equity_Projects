#  DESC   :        Active Users Report
######################################################################
RECORDLAYOUT
####################################################################
# 
####################################################################

USER_ID 		stringtype
SOL_ID 			stringtype
USER_EMP_ID 		stringtype
USER_SOL_TENOR 		stringtype
RECRE_TIME 		stringtype
LCHG_TIME 		stringtype
ROLE_ID 		stringtype
USER_WORK_CLASS 	stringtype
USER_APPL_NAME 		stringtype
USER_ACCT_EXPY_DATE 	stringtype

LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
total_users numberType
gr_total_users numbertype
totalpages stringtype
total_pages stringtype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType

#
GROUPANDSORT
####################################################################
#   
#################################################################### 
SOL_ID ascending
#
#
REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
branchName      stringtype

REPOSITORY  argv4
#############################################################################

ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#
#############################################################################
#MASSAGERECORD
#############################################################################
#
#############################################################################
#IGNORERECORD
#############################################################################
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines  3
LinesPerPage     64
Topmargin         2
BottomMargin      2 
columnsPerLine  130
pageHeaderLines   8
pageFooterLines   2
#
ONSTARTOFREPORT
####################################################################  

execute brBankHdg 
execute pageHdg
#
####################################################################
PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg
#
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
separatorline
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################
Print USER_ID column 2  
Print SOL_ID column 15 
print USER_EMP_ID column 25 
print USER_SOL_TENOR column 35 
Print RECRE_TIME column 45 
Print LCHG_TIME column 60 
Print ROLE_ID column 85 
Print USER_WORK_CLASS column 105
Print USER_APPL_NAME column 110 
Print USER_ACCT_EXPY_DATE column 120

BEFOREBREAKOF SOL_ID
####################################################################
print "Branch ID" column 1
print SOL_ID  column 15
nextline
nextline
#
#
AFTERBREAKOF SOL_ID
####################################################################
# After break of SOL_ID
####################################################################
nextline
separatorline
print " Total Active Users:  " column 2
set total_users = groupcount user_id
print total_users column 25
nextline
separatorline
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
     separatorline
     set gr_total_users= totalcount user_id
     print " Total No. Of Active Users: " column 2 
     print gr_total_users column 30
     nextline
     separatorline
     nextline
end

begin
     print "printed by:"  size  70 center
     print  lv_userId
     nextline
     nextline
     nextline
     print "verified by:" size  70 center
     nextline
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 130 center
     end
begin
     set total_pages = numtostr pagenumber
     set totalpages = prntagval "TOP" total_pages
end
#
#
############################################################################
Procedure  pageHdg
############################################################################

begin
     print "ACTIVE USERS REPORT  "  size  130 center 
     nextline
     print " From  " column   53
     print ipFrmDate  
     print "  &  "
     print ipToDate   
     nextline
     nextline
 
 end

begin
     separatorline
     print "USER ID " column  2
     print "BRANCH" column 15
     print "EMP NO" column 25
     print "TENOR" column 35
     print "CREATED" column 45
     print "LAST CHANGE" column 60
     print "ROLE ID" column  85
     print "WORKCLASS" column 105
     print "APPL NAME" column 110
     print "EXPIRYDATE" column 120 
     separatorline
     nextline
end
#
#############################################################################
PROCEDURE brBankHdg
#############################################################################
#
begin
     print "Page No. "   column  110 
     print page_number precision 0
     nextline
     print today column  110
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 130 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 130 center 
   end

####################################################################
# End of File
######################################################################
