	print(BANCS.INPUT.PartTranIdentifier)
endif
if(fieldexists(BANCS.INPUT.TranId)==1)then
	print(BANCS.INPUT.TranId)
endif
if(fieldexists(BANCS.INPUT.ReservedField1)==1)then
	print(BANCS.INPUT.ReservedField1)
endif
if(fieldexists(BANCS.INPUT.ReservedField2)==1)then
	print(BANCS.INPUT.ReservedField2)
endif
if(fieldexists(BANCS.INPUT.ReservedField3)==1)then
	print(BANCS.INPUT.ReservedField3)
endif
if(BANCS.INPUT.ReservedField2!="")then
	sv_l = strlen(BANCS.INPUT.ReservedField2)
	sv_f = mid$(BANCS.INPUT.ReservedField2,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.TranType  = mid$(sv_f,0,(sv_p-1))
		print(BANCS.INPUT.TranType)
	BANCS.INPUT.ReservedField2 = mid$(sv_f,sv_p,sv_l)
	print(BANCS.INPUT.ReservedField2)
	sv_l = strlen(BANCS.INPUT.ReservedField2)
	sv_f = mid$(BANCS.INPUT.ReservedField2,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.TranParti  = mid$(sv_f,0,(sv_p-1))
		print(BANCS.INPUT.TranParti)
	if(BANCS.INPUT.TranParti!="")then
		BANCS.OUTPUT.TranParticulars = mid$(BANCS.INPUT.TranParti,0,50)
	endif
	BANCS.INPUT.ReservedField2 = mid$(sv_f,sv_p,sv_l)
	print(BANCS.INPUT.ReservedField2)
	sv_l = strlen(BANCS.INPUT.ReservedField2)
	sv_f = mid$(BANCS.INPUT.ReservedField2,0,sv_l)
	sv_p = getposition(sv_f,"|")
	BANCS.INPUT.TranRemarks  = mid$(sv_f,0,(sv_p-1))
		print(BANCS.INPUT.TranRemarks)
	if(BANCS.INPUT.TranRemarks!="")then
		BANCS.OUTPUT.TranRemarks = mid$(BANCS.INPUT.TranRemarks,0,30)
	endif
	BANCS.INPUT.rrnNum = mid$(sv_f,sv_p,sv_l)
		print(BANCS.INPUT.rrnNum)
	if(BANCS.INPUT.rrnNum!="")then
		BANCS.OUTPUT.RefNum = mid$(BANCS.INPUT.rrnNum,0,20) 
	endif
endif


