                                print(CUST.ATM.acctname)
                                CUST.ATM.cifid = BANCS.OUTPARAM.cifid
                                print(CUST.ATM.cifid)

                                IF  ((CUST.ATM.schmCode == "SB100") OR (CUST.ATM.schmCode == "SB777") OR (CUST.ATM.schmCode == "SB109") OR (CUST.ATM.schmCode == "SB117") OR (CUST.ATM.schmCode == "SB118") OR (CUST.ATM.schmCode == "SB190") OR (CUST.ATM.schmCode == "SB140") OR (CUST.ATM.schmCode == "SB104") OR (CUST.ATM.schmCode == "SB103")) THEN

                                        IF (CUST.ATM.schmCode == "SB777") THEN
                                                IF (CUST.ATM.solid=="777") THEN
                                                        print("Not Allowed Contact Branch")
                                                        BANCS.OUTPUT.RespCode = "99"
                                                        BANCS.OUTPUT.successOrFailure = "F"
                                                        BANCS.OUTPUT.ReservedField3 = "Not Allowed Contact Branch"
                                                        exitscript
                                                ENDIF
                                        ENDIF
                                        IF (BANCS.OUTPARAM.frezCode == "D") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure = "F"
                                                BANCS.OUTPUT.ReservedField3 = "84|TOD CREATION FAILED"
                                                exitscript
                                        ENDIF
                                        IF (BANCS.OUTPARAM.frezCode == "T") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure = "F"
                                                BANCS.OUTPUT.ReservedField3 = "84|TOD CREATION FAILED"
                                                exitscript
                                        ENDIF
                                        IF (BANCS.OUTPARAM.acctStatus == "D") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure = "F"
                                                BANCS.OUTPUT.ReservedField3 = "84|TOD CREATION FAILED"
                                                exitscript
                                        ENDIF
                                        ###### loan start
                                        IF (BANCS.INPUT.ReservedField2=="AUTOTODAVAILREQMC") THEN

                                                CUST.ATM.solid = CUST.ATM.solid
                                                print(CUST.ATM.solid)
