                                                sv_g = MID$(BANCS.INPUT.TranAmt,0,14)
                                                print(sv_g)
                                                sv_j =  "0.01"
                                                print(sv_j)
                                                sv_k =  "0.1"
                                                print(sv_k)
                                                sv_q = "sumamountj|select ( ( ('" + sv_g + "' * '"+ sv_j +"')  +  ( ('" + sv_g + "' * '"+ sv_j +"')))  + '" + sv_g + "')  from dual "
                                                print(sv_q)
                                                sv_w=urhk_dbSelectWithBind(sv_q)
                                                if (sv_w == 0) then
                                                        print("sumamountj")
                                                        CUST.ATM.amountsvggmt = cdouble(BANCS.OUTPARAM.sumamountj)
                                                        print(CUST.ATM.amountsvggmt)
                                                endif
                                                CUST.ATM.loanamount = cdouble(sv_g)
                                                print(CUST.ATM.loanamount)

                                                ###############
                                                CUST.ATM.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
                                                print(CUST.ATM.BODDate)

                                                sv_a = "count|select count(1) FROM custom.CATOD_MASTER_TABLE  WHERE bank_id=?SVAR and acct_num=?SVAR and contract_amt!=0 "
                                                print(sv_a)
                                                BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId + "|" +  CUST.ATM.operaccnt

                                                print(BANCS.INPARAM.BINDVARS)
