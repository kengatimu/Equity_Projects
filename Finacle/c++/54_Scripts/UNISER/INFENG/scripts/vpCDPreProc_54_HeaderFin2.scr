# Validation to check whether the account is verified
#--------------------------------------------------------------------
IF((FIELDEXISTS(BANCS.INPUT.Foracid) == 1) AND (BANCS.INPUT.Command != "RTXR")) THEN
#{
IF(BANCS.INPUT.Foracid != "")THEN
#{
        BANCS.INPARAM.BINDVARS = BANCS.INPUT.Foracid + "|" + BANCS.STDIN.contextBankId
        sv_s = "acid|SELECT ACID FROM TBAADM.GAM WHERE (ENTITY_CRE_fLG='Y' OR (ENTITY_CRE_fLG='N' and schm_code='VA302')) AND DEL_FLG='N' AND FORACID = ?SVAR AND BANK_ID = ?SVAR"
        sv_u = urhk_dbselectWithBind(sv_s)
        IF(sv_u != 0) THEN
        #{
                IF (BANCS.INPUT.DccId=="SMS") THEN
                        IF (BANCS.INPUT.Command=="ACIR") THEN
                                sv_t= urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
                                print(sv_t)
                                IF (sv_t == 0) THEN
                                        sv_t = BANCS.OUTPARAM.schmType
                                        print(sv_t)
                                        sv_c = BANCS.OUTPARAM.schmCode
                                        print(sv_c)
                                        IF (sv_c=="SB777") THEN
                                                print("okay")
                                                IF ((BANCS.INPUT.DccId == "SMS" ) AND (BANCS.INPUT.DeviceId=="CAMPAIGN") AND (BANCS.OUTPUT.Command=="ACIR")) THEN
                                                        print(BANCS.INPUT.Foracid)
                                                        sv_s = "schmcodex,name,custId,number,id "
                                                        sv_s = sv_s + " | "
                                                        sv_s = sv_s + " SELECT gam.schm_code,RPAD(GAM.acct_name,80,' '),GAM.cif_id,PHONENO,CMG.nat_id_card_num "
                                                        sv_s = sv_s + " FROM tbaadm.cphone cphone,TBAADM.GAM , TBAADM.CMG "
                                                        sv_s = sv_s + " WHERE cphone.PHONE_B2KID=GAM.cif_id and cphone.PHONE_B2KID=CMG.cif_id  and GAM.schm_code='SB777' and CMG.cif_id=GAM.cif_id "
                                                        sv_S = sv_s + " AND cphone.PREFERREDFLAG='Y' "
                                                        sv_s = sv_s + " AND GAM.foracid = ?SVAR "
                                                        sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
                                                        sv_s = sv_s + " AND GAM.bank_id = cphone.bank_id AND CMG.bank_id = cphone.bank_id   AND GAM.bank_id = CMG.bank_id and rownum<2 "
                                                        BANCS.INPARAM.BINDVARS = BANCS.INPUT.Foracid + "|" + BANCS.STDIN.contextBankId
                                                        print(sv_s)
                                                        sv_d = urhk_dbSelectWithBind(sv_s)
                                                        print(sv_d)
                                                        if (sv_d == 0) then
                                                                print(BANCS.OUTPARAM.name)
                                                                print(BANCS.OUTPARAM.id)
                                                                print(BANCS.OUTPARAM.custId)
                                                                print(BANCS.OUTPARAM.number)
                                                                BANCS.OUTPUT.ReservedField1=BANCS.OUTPARAM.name+"/"+BANCS.OUTPARAM.id+"/"+BANCS.OUTPARAM.number
                                                                print(BANCS.OUTPUT.ReservedField1)
                                                                print(BANCS.OUTPARAM.schmcodex)
                                                                IF (BANCS.OUTPARAM.schmcodex=="SB777") THEN
                                                                        BANCS.OUTPUT.RespCode = "00"
                                                                        print(BANCS.OUTPUT.RespCode)
                                                                        BANCS.OUTPUT.successOrFailure = "F"
                                                                        print(BANCS.OUTPUT.successOrFailure)
                                                                        exitscript
                                                                ENDIF
                                                        ELSE
                                                                print(BANCS.INPUT.Foracid)
                                                                sv_s = "schmcodex,name,custId,number,id "
                                                                sv_s = sv_s + " | "
                                                                sv_s = sv_s + " SELECT gam.schm_code,RPAD(GAM.acct_name,80,' '),GAM.cif_id,gam.del_flg,CMG.nat_id_card_num "
                                                                sv_s = sv_s + " FROM TBAADM.GAM , TBAADM.CMG "
                                                                sv_s = sv_s + " WHERE CMG.cif_id=GAM.cif_id "
                                                                sv_s = sv_s + " AND GAM.foracid = ?SVAR "
                                                                sv_s = sv_s + " AND GAM.bank_id = ?SVAR  and GAM.schm_code='SB777' "
                                                                sv_s = sv_s + " AND GAM.bank_id = CMG.bank_id and rownum<2 "
                                                                print(sv_s)
                                                                BANCS.INPARAM.BINDVARS = BANCS.INPUT.Foracid + "|" + BANCS.STDIN.contextBankId
                                                                print(sv_s)
                                                                sv_d = urhk_dbSelectWithBind(sv_s)
                                                                print(sv_d)
                                                                if (sv_d == 0) then
                                                                        print(BANCS.OUTPARAM.name)
                                                                        print(BANCS.OUTPARAM.id)
                                                                        print(BANCS.OUTPARAM.custId)
                                                                        BANCS.OUTPARAM.number=""
                                                                        print(BANCS.OUTPARAM.number)
                                                                        BANCS.OUTPUT.ReservedField1=BANCS.OUTPARAM.name+"/"+BANCS.OUTPARAM.id+"/"+BANCS.OUTPARAM.number
                                                                        print(BANCS.OUTPUT.ReservedField1)
                                                                        print(BANCS.OUTPARAM.schmcodex)
                                                                        IF (BANCS.OUTPARAM.schmcodex=="SB777") THEN
                                                                                BANCS.OUTPUT.RespCode = "00"
                                                                                print(BANCS.OUTPUT.RespCode)
                                                                                BANCS.OUTPUT.successOrFailure = "F"
                                                                                print(BANCS.OUTPUT.successOrFailure)
                                                                                exitscript
                                                                        ENDIF
                                                                ENDIF
                                                        ENDIF
                                                ENDIF

                                        ELSE
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure="F"
                                                exitscript
                                        ENDIF
                                ELSE
                                        BANCS.OUTPUT.RespCode = "99"
                                        BANCS.OUTPUT.successOrFailure="F"
                                        exitscript
                                ENDIF
                        ELSE
                                BANCS.OUTPUT.RespCode = "99"
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        ENDIF
                ELSE
                        BANCS.OUTPUT.RespCode = "99"
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                ENDIF
        #}
        ENDIF
#}
ENDIF
