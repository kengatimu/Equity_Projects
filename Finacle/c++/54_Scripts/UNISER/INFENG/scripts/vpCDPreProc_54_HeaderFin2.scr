                                                                        print("Not Qualified")
                                                                        BANCS.OUTPUT.RespCode = "99"
                                                                        BANCS.OUTPUT.successOrFailure = "F"
                                                                        BANCS.OUTPUT.ReservedField3 = "Not Qualified"
                                                                        exitscript
                                                                endif
                                                        endif
                                                ENDIF
                                                ###############

                                                CUST.ATM.loanperiod = "1"
                                                print(CUST.ATM.loanperiod)
                                                sv_s = "reqid|"
                                                sv_s = sv_s + " SELECT CUSTOM.EAZZY_LOAN_SEQ.nextval "
                                                sv_s = sv_s + " FROM DUAL"
                                                PRINT(sv_s)
                                                sv_d = urhk_dbSelectWithBind(sv_s)
                                                PRINT(sv_d)
                                                IF(sv_d!=0)THEN
                                                #{
                                                        BANCS.OUTPUT.RespCode = "99"
                                                        BANCS.OUTPUT.ReservedField3 = "Bad Sequence"
                                                        print(BANCS.OUTPUT.ReservedField3)
                                                        #}
                                                ELSE
                                                        #{
                                                        CUST.ATM.reqid = BANCS.OUTPARAM.reqid
                                                        PRINT(CUST.ATM.reqid)
                                                        #}
                                                ENDIF
                                                CUST.ATM.phonenumber = BANCS.INPUT.CardAcceptorName
                                                print(CUST.ATM.phonenumber)
                                                CUST.ATM.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
                                                print(CUST.ATM.BODDate)
                                                CUST.ATM.regdate = CUST.ATM.BODDate
                                                print(CUST.ATM.regdate)
                                                CUST.ATM.currency = "KES"
                                                print(CUST.ATM.currency)
                                                CUST.ATM.status ="0"
                                                print(CUST.ATM.status)
                                                CUST.ATM.channelid = "COR"
                                                print(CUST.ATM.channelid)
                                                CUST.ATM.bankid = "54"
                                                print(CUST.ATM.bankid)
                                                CUST.ATM.processed = "1"
                                                print(CUST.ATM.processed)

                                                sv_s = "INSERT INTO "
                                                sv_s = sv_s + " custom.MICALOANSS "
                                                sv_s = sv_s + " (SOL_ID,OPER_ACCNT,ACCT_NAME,CUST_ID,LOAN_AMOUNT,LOAN_PERIOD,REQ_ID,PHONE_NUMBER,REG_DATE,CURRENCY,STATUS,CHANNEL_ID,BANK_ID,PROCESSED) "
                                                sv_s = sv_s + " values "
                                                sv_s = sv_s + " ( ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR)"
                                                BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + CUST.ATM.operaccnt +"|"+ CUST.ATM.acctname + "|" +CUST.ATM.custid + "|"+ CUST.ATM.loanamount +"|" + CUST.ATM.loanperiod +"|" + CUST.ATM.reqid  +"|" + CUST.ATM.phonenumber +"|" + CUST.ATM.regdate +"|" + CUST.ATM.currency +"|" + CUST.ATM.status +"|" + CUST.ATM.channelid +"|" + CUST.ATM.bankid +"|" + CUST.ATM.processed
                                                print(BANCS.INPARAM.BINDVARS)
                                                print(sv_s)
                                                sv_d = urhk_dbSqlWithBind(sv_s)

                                                IF (sv_d == 0) then
