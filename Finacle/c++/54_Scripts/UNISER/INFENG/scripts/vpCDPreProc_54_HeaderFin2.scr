                                                                print (CUST.ATM.MaxAmtcontract)
                                                        ELSE
                                                                CUST.ATM.MaxAmtcontract="0"
                                                        ENDIF
                                                        sv_s = "limit,contractId,maxAvailAmt,contractPeriodMM,todAmt|SELECT SANCT_AMT,REQUEST_ID,REQ_AMT,REQ_PERIOD,TOD_AMT from custom.CATOD_SANCTION_TABLE "
