    #----------------------------------------------

        IF ((FIELDEXISTS(BANCS.INPUT.CrForacid) == 1) AND (BANCS.INPUT.DccId != "C24") AND (BANCS.INPUT.CrForacid != "VODAFONE")) THEN
        #{
