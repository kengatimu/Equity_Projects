                                                sv_k = sv_k + " and g.cif_id=(select cif_id from tbaadm.gam where  foracid=?SVAR and BANK_ID = ?SVAR )  "
                                                BANCS.INPARAM.BINDVARS = CUST.ATM.operaccnt  + "|" + BANCS.STDIN.contextBankId
                                                PRINT(BANCS.INPARAM.BINDVARS)
                                                PRINT(sv_k)
                                                sv_h = urhk_dbselectWithBind(sv_k)
                                                PRINT(sv_h)
                                                IF (sv_h  == 0) THEN
                                                #{
                                                        IF (BANCS.OUTPARAM.brgtCountsum !="") THEN
                                                                CUST.ATM.brgtCountsum = BANCS.OUTPARAM.brgtCountsum
                                                                PRINT(CUST.ATM.brgtCountsum)
