                                                print(sv_s)

                                                IF (BANCS.OUTPARAM.count=="0") THEN
                                                        print("Not Scored")
                                                        BANCS.OUTPUT.RespCode = "99"
                                                        BANCS.OUTPUT.successOrFailure = "F"
                                                        BANCS.OUTPUT.ReservedField3 = "Not Scored"
                                                        exitscript
                                                ELSE

                                                        sv_a = "MaxAmtcontract|select contract_amt FROM custom.CATOD_MASTER_TABLE  WHERE bank_id=?SVAR and acct_num =?SVAR and contract_amt!=0  and  rownum <2  "
                                                        print(sv_a)
                                                        BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId + "|" +  CUST.ATM.operaccnt
                                                        print(BANCS.INPARAM.BINDVARS)
                                                        sv_s= urhk_dbSelectWithBind(sv_a)
                                                        print(sv_s)
