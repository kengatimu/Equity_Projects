                sv_s = sv_s + " and acct_ownership!='O' AND GAM.foracid = ?SVAR  AND GAM.bank_id = ?SVAR  "
                BANCS.INPARAM.BINDVARS = BANCS.INPUT.Foracid + "|" + BANCS.STDIN.contextBankId
                print(sv_s)
                sv_d = urhk_dbSelectWithBind(sv_s)
                print(sv_d)
                IF(sv_d == 0) THEN
                        print(BANCS.OUTPARAM.chrgeoffflg)
