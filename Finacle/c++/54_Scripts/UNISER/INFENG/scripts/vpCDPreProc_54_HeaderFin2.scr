                                                                print (CUST.ATM.limit)
                                                                CUST.ATM.contractId = BANCS.OUTPARAM.contractId
                                                                print (CUST.ATM.contractId)
                                                                CUST.ATM.maxAvailAmt = BANCS.OUTPARAM.maxAvailAmt
                                                                print (CUST.ATM.maxAvailAmt)
                                                                CUST.ATM.contractPeriodMM = BANCS.OUTPARAM.contractPeriodMM
                                                                print (CUST.ATM.contractPeriodMM)
                                                                CUST.ATM.todAmt = BANCS.OUTPARAM.todAmt
                                                                print (CUST.ATM.todAmt)
                                                        ELSE
                                                                CUST.ATM.limit="0"
                                                        ENDIF

                                                        print(CUST.ATM.MaxAmtcontract)
                                                        print(CUST.ATM.limit)
                                                        CUST.ATM.loanamount = CUST.ATM.loanamount
                                                        print(CUST.ATM.loanamount)

                                                        sv_q = "countsumm|select  ((('"+ CUST.ATM.MaxAmtcontract +"' - '"+CUST.ATM.limit+"')  - '"+CUST.ATM.loanamount+"') - '"+CUST.ATM.brgtCountsum+"')  from dual  "
                                                        print(sv_q)
                                                        sv_w=urhk_dbSelectWithBind(sv_q)
                                                        print(sv_w)
                                                        if (sv_w == 0) then
                                                                print("countsumm")
                                                                CUST.ATM.countsumm = BANCS.OUTPARAM.countsumm
                                                                print(CUST.ATM.countsumm)
