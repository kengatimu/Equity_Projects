                                                sv_k = sv_k + " and g.cif_id=c.cif_id and g.bank_id=c.bank_id  and g.bank_id='54' and g.acct_cls_flg='N' and g.clr_bal_amt!='0' "
                                                sv_k = sv_k + " and g.cif_id=(select cif_id from tbaadm.gam where  foracid=?SVAR and BANK_ID = ?SVAR )  "
                                                BANCS.INPARAM.BINDVARS = CUST.ATM.operaccnt  + "|" + BANCS.STDIN.contextBankId
                                                PRINT(BANCS.INPARAM.BINDVARS)
                                                PRINT(sv_k)
                                                sv_h = urhk_dbselectWithBind(sv_k)
                                                PRINT(sv_h)
                                                IF (sv_h  == 0) THEN
                                                #{
                                                        IF (BANCS.OUTPARAM.forCountsum !="") THEN
                                                                CUST.ATM.forCountsum = BANCS.OUTPARAM.forCountsum
                                                                PRINT(CUST.ATM.forCountsum)
                                                        ELSE
                                                                CUST.ATM.forCountsum = "0"
                                                                PRINT(CUST.ATM.forCountsum)
                                                        ENDIF
                                                #}
                                                ELSE
                                                #{
                                                        CUST.ATM.forCountsum = "0"
                                                #}
                                                ENDIF

                                                IF (CINT(CUST.ATM.forCountsum)>0 ) THEN
