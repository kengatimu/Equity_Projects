IF (BANCS.INPUT.DccId == "WPD") THEN
        IF ((BANCS.OUTPUT.CrForacid =="0090291251426") or (BANCS.OUTPUT.CrForacid =="1520265128490") or (BANCS.OUTPUT.CrForacid =="1120297065141"))  THEN
                print(" Transaction Not allowed now ")
                BANCS.OUTPUT.ReservedField3="Transaction Not allowed now on POS"
                BANCS.OUTPUT.RespCode = "99"
                BANCS.OUTPUT.successOrFailure = "F"
                exitscript
        ENDIF
ENDIF
#--------------------------------------------------------Edwin for NIBS BLOCK
if((BANCS.INPUT.DccId == "WPD") or (BANCS.INPUT.DccId == "EAZ"))then
        if((BANCS.OUTPUT.CrForacid =="0010201200681") or (BANCS.OUTPUT.CrForacid =="0870260668087"))then
                BANCS.OUTPUT.ReservedField3="Transaction Not allowed use 0870262385517"
                BANCS.OUTPUT.RespCode = "99"
                BANCS.OUTPUT.successOrFailure = "F"
                exitscript
        endif
endif
