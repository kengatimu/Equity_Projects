                                                        BANCS.OUTPUT.successOrFailure = "F"
                                                        BANCS.OUTPUT.ReservedField3 = "Eazzy loan Exist."
                                                        exitscript
                                                ENDIF

                                                sv_a = "countzero|select count(1) FROM custom.MICALOANSS where BANK_ID=?SVAR and OPER_ACCNT =?SVAR and STATUS='0' "
                                                print(sv_a)
                                                BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId + "|" +  CUST.ATM.operaccnt
                                                print(BANCS.INPARAM.BINDVARS)
                                                sv_s= urhk_dbSelectWithBind(sv_a)
                                                print(sv_s)
                                                print(BANCS.OUTPARAM.countzero)
