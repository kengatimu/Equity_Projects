## start restrict overdrawing
IF (BANCS.INPUT.Foracid!="") THEN
        print(BANCS.INPUT.Foracid)
        IF ((BANCS.INPUT.Foracid=="0001100305020") OR (BANCS.INPUT.Foracid=="0001100405021") OR (BANCS.INPUT.Foracid=="0541100405249") OR (BANCS.INPUT.Foracid=="0541100404593") OR (BANCS.INPUT.Foracid=="0541100405260")) THEN
                sv_h = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
                print(sv_h)
                IF (sv_h==0) THEN
                        sv_r = REPEXISTS("STDWFS")
                        IF (sv_r == 0) THEN
                                CREATEREP("STDWFS")
                        ENDIF
                        sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
                        IF (sv_r == 0) THEN
                                CREATECLASS("STDWFS", "GLBDATA", 5)
                        ENDIF
                        STDWFS.GLBDATA.solidsh = BANCS.OUTPARAM.acctSolId
                        print(STDWFS.GLBDATA.solidsh)
                        STDWFS.GLBDATA.schmcodesh = BANCS.OUTPARAM.schmCode
                        print(STDWFS.GLBDATA.schmcodesh)
                        STDWFS.GLBDATA.schmType = BANCS.OUTPARAM.schmType
                        print(STDWFS.GLBDATA.schmType)
                        STDWFS.GLBDATA.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
                        print(STDWFS.GLBDATA.EffAvailableAmttr)
                        IF (FIELDEXISTS(BANCS.INPUT.TranAmt) == 1) THEN
                                print(BANCS.OUTPUT.TranAmt)
                                STDWFS.GLBDATA.dedittr = cdouble(BANCS.INPUT.TranAmt)/cdouble("100")
                                print(STDWFS.GLBDATA.dedittr)
                                if (CINT(STDWFS.GLBDATA.EffAvailableAmttr) < CINT(STDWFS.GLBDATA.dedittr)) then
                                        print(" less amount exit ")
                                        CUST.ATM.errMsg =" Overdrawing not allowed "
                                        BANCS.OUTPUT.ReservedField3 = CUST.ATM.errMsg
                                        BANCS.OUTPUT.RespCode = "04"
                                        BANCS.OUTPUT.successOrFailure = "F"
                                        exitscript
                                endif
                        ENDIF
                ENDIF
        ENDIF
ENDIF
## end restrict overdrawing

##---For Checking holiday status in Full Statement ---#
IF (BANCS.INPUT.DccId == "POL") THEN
        PRINT(BANCS.INPUT.SolId)
        PRINT(BANCS.INPUT.ReservedField1)

        IF(BANCS.INPUT.Command == "FSIR")THEN
        #{
                CUST.ATM.SOLID = BANCS.INPUT.SolId
                PRINT(CUST.ATM.SOLID)

                CUST.ATM.endDate = MID$(BANCS.INPUT.ReservedField1,8,8)
                PRINT(CUST.ATM.endDate)

                CUST.ATM.endDate = BANCS.INPUT.ReservedField1
                PRINT(CUST.ATM.endDate)

                CUST.ATM.YYYY = MID$(CUST.ATM.endDate,0,4)
                PRINT(CUST.ATM.YYYY)

                CUST.ATM.MM = MID$(CUST.ATM.endDate,4,2)
                PRINT(CUST.ATM.MM)

                CUST.ATM.DD = MID$(CUST.ATM.endDate,6,2)
                PRINT(CUST.ATM.DD)

                CUST.ATM.endDateInDDMMYY = CUST.ATM.DD + "-" + CUST.ATM.MM + "-" + CUST.ATM.YYYY
                PRINT(CUST.ATM.endDateInDDMMYY)

                CUST.ATM.holidayStatusArgument = CUST.ATM.SOLID + "|" + CUST.ATM.endDateInDDMMYY
                PRINT(CUST.ATM.holidayStatusArgument)
                sv_a = urhk_scrIsDcHoliday(CUST.ATM.endDateInDDMMYY)
                PRINT(sv_a)
                IF(sv_a == 1)THEN
                #{
                        BANCS.OUTPUT.successOrFailure = "F"
                #}
                ENDIF

                PRINT(BANCS.OUTPARAM.IsDcHoliday)

                IF(BANCS.OUTPARAM.IsDcHoliday == "Y")THEN
                #{
                        sv_a = urhk_GetNextWorkingDate(CUST.ATM.holidayStatusArgument)
                        PRINT(sv_a)
                        PRINT(BANCS.OUTPARAM.NextDataCentreWorkingDate)

                        CUST.ATM.nextDataCentreWorkingDate = BANCS.OUTPARAM.NextDataCentreWorkingDate
                        PRINT(CUST.ATM.nextDataCentreWorkingDate)

                        CUST.ATM.nextDataCentreWorkingDD = MID$(CUST.ATM.nextDataCentreWorkingDate,0,2)
                        CUST.ATM.nextDataCentreWorkingMM = MID$(CUST.ATM.nextDataCentreWorkingDate,3,2)
                        CUST.ATM.nextDataCentreWorkingYYYY = MID$(CUST.ATM.nextDataCentreWorkingDate,6,4)

                        CUST.ATM.nextDataCentreWorkingYYYYMMDD = CUST.ATM.nextDataCentreWorkingYYYY + CUST.ATM.nextDataCentreWorkingMM + CUST.ATM.nextDataCentreWorkingDD

                        CUST.ATM.RFPart1 = MID$(BANCS.INPUT.ReservedField1,0,8)
                        CUST.ATM.RFPart2 = CUST.ATM.nextDataCentreWorkingYYYYMMDD
                        CUST.ATM.RFPart3 = MID$(BANCS.INPUT.ReservedField1,16,STRLEN(BANCS.INPUT.ReservedField1))

                        PRINT(CUST.ATM.RFPart1)
                        PRINT(CUST.ATM.RFPart2)
                        PRINT(CUST.ATM.RFPart3)

                        BANCS.OUTPUT.ReservedField1 = CUST.ATM.RFPart1 + CUST.ATM.RFPart2 + CUST.ATM.RFPart3

                        PRINT(BANCS.OUTPUT.ReservedField1)
                        BANCS.OUTPUT.successOrFailure = "S"
                #}
                ELSE
                #{
                        PRINT("The End Date is not a holiday")
                #}
                ENDIF
        #}
        ENDIF
ENDIF
##--- End of Checking Holiday Status for Full Statement ---#

