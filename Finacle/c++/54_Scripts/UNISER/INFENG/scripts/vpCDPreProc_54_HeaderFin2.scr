#-------muthokinjo/Biller direct transfer block Edwin Zico
sv_s ="CountBill|select count(*) from tbaadm.brgt where free_text1 =?SVAR and del_flg ='N' and bank_id =?SVAR and entity_cre_flg ='Y' and FREE_TEXT4 in ('R','L','LR','N')"
BANCS.INPARAM.BINDVARS = BANCS.OUTPUT.CrForacid + "|" + BANCS.STDIN.contextBankId
print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
if(sv_d == 0)then
        CUST.ATM.CountBill = BANCS.OUTPARAM.CountBill
else
        CUST.ATM.CountBill = 0
endif
if(cdouble(CUST.ATM.CountBill) >=1)then
        if(BANCS.INPUT.DccId == "EAZ")then
                if ((BANCS.INPUT.ReservedField2 =="P2PIntra") or (BANCS.INPUT.ReservedField2=="CashIn")) then
                        BANCS.OUTPUT.ReservedField3="Transaction Not allowed...Use Bill Option"
                        BANCS.OUTPUT.RespCode = "99"
                        BANCS.OUTPUT.successOrFailure = "F"
                        exitscript
                endif
        endif
        if(BANCS.INPUT.DccId == "WPD")then
                sv_k = MID$(BANCS.INPUT.ReservedField2,0,5)
                print(sv_k)
                if(sv_k !="BILL:")then
                        BANCS.OUTPUT.ReservedField3="Transaction Not allowed...Use Bill Option"
                        BANCS.OUTPUT.RespCode = "99"
                        BANCS.OUTPUT.successOrFailure = "F"
                        exitscript
                endif
        endif
endif
#------Muthokinjo block end

#-------VA300 BAL check Edwin
if(fieldexists(BANCS.INPUT.CrForacid)==1)then
        if(BANCS.INPUT.CrForacid!="")then
                #-------------Safaricom Trust Account Block

                if(BANCS.INPUT.CrForacid =="0810295233054")then
                        BANCS.OUTPUT.ReservedField3="Transaction Not allowed On mobile Channel"
                        BANCS.OUTPUT.RespCode = "99"
                        BANCS.OUTPUT.successOrFailure = "F"
                        exitscript
                endif
                #-----------------
                sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
                if(sv_u==0)then
                        CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
                        CUST.ATM.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
                endif
                IF (FIELDEXISTS(CUST.ATM.schmcodesh) == 1) THEN
                        IF (CUST.ATM.schmcodesh =="VA300")  THEN
                                IF (FIELDEXISTS(BANCS.INPUT.TranAmt) == 1) THEN
                                        print(BANCS.INPUT.TranAmt)
                                        CUST.ATM.dedittr = cdouble(BANCS.INPUT.TranAmt)/cdouble("100")
                                        print(CUST.ATM.dedittr)
                                        sv_q = "sumamountVA|select ('" + CUST.ATM.EffAvailableAmttr + "' + '" + CUST.ATM.dedittr + "') from dual "
                                        print(sv_q)
                                        sv_w=urhk_dbSelectWithBind(sv_q)
                                        if (sv_w == 0) then
                                                CUST.ATM.sumamountVA = cdouble(BANCS.OUTPARAM.sumamountVA)
                                                print(CUST.ATM.sumamountVA)
                                                if (cint(CUST.ATM.sumamountVA) > 100000) then
                                                        print(" am in sumamountVA")
                                                        BANCS.OUTPUT.RespCode = "99"
                                                        BANCS.OUTPUT.successOrFailure = "F"
                                                        exitscript
                                                endif
                                        endif
                                ENDIF
                        ENDIF
                ENDIF
        endif
endif
#----------VA300 BAL check End

