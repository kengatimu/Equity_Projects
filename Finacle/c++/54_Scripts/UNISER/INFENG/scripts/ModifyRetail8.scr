sv_s = "update   custom.int_change set ENTITY_CRE_FLG ='MO1' where  bank_id =?SVAR and ENTITY_CRE_FLG ='VE'and foracid  in   (select orgkey   from crmuser.accounts_mod ) and rownum < 1000   "
#sv_s = "update   custom.int_change set ENTITY_CRE_FLG ='MO4' where  bank_id =?SVAR and ENTITY_CRE_FLG ='MOD'and rownum < 700 "
print(sv_s)
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId  
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSQLWithBind(sv_s)
IF (sv_d == 0) THEN
	sv_c = urhk_dbSQLWithBind("commit")
	print(sv_c)
ENDIF
	
	sv_s=" CIF_ID, RETCOPR  |"
	sv_s = sv_s + " select foracid  ,case when  corp_id is null then 'RET' else 'CORP' end RETCORP  from CUSTOM.INT_CHANGE a, crmuser.accounts c   "
	sv_s = sv_s + "  WHERE a.BANK_ID = ?SVAR and orgkey = foracid and  A.ENTITY_CRE_FLG ='MO1'  " 

#sv_s = sv_s + " select orgkey   ,case when  corp_id is null then 'RET' else 'CORP' end RETCORP  from crmuser.accounts   WHERE orgkey in  ('54316038268','54316038260','54316038257','54316038237','54316038231','54316038230','54316038229','54316038221','54316038214','54316038212','54316038210','54316038208','54316038206','54316038200','54316038198','54316038192','54316038182','54316038180','54316038178','54316038168') "

	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		
		CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			
			CUST.INTERFACE.interfaceRequestID = "verifyCustomerDetails"
			CUST.INTERFACE.interfaceRequestVersion = "10.2"
			CUST.INTERFACE.bankID =BANCS.STDIN.contextBankId
			CUST.INTERFACE.channelID = "COR"
			
			CUST.INTERFACE.CIF=BANCS.OUTPARAM.CIF_ID
			print(CUST.INTERFACE.CIF)
			CUST.INTERFACE.RETCOPR =BANCS.OUTPARAM.RETCOPR
			print(CUST.INTERFACE.RETCOPR)
			
			CUST.INTERFACE.lastdatepart ="T00:00:00.000"
			print(CUST.INTERFACE.lastdatepart)
			
			CUST.INTERFACE.sign ="-"
			print(CUST.INTERFACE.sign)	
			
	
			
			#-------------------------------------------------------------------------
			# Fetch the current data time to send in request header
			#-------------------------------------------------------------------------
			sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
			#{
				CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
				print(CUST.INTERFACE.msgDateTime)
			#}
			ENDIF
			
			#-------------------------------------------------------------------------
			#- Forming the Header for RetCustAdd
			#-------------------------------------------------------------------------
			
			sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0)THEN
			#{
				CUST.INTERFACE.RequestID1 = BANCS.OUTPARAM.RequestID
				print(CUST.INTERFACE.RequestID1)
				#}
			ELSE
				#{
				CUST.INTERFACE.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
				print(CUST.INTERFACE.RequestID1)
			#}
			ENDIF
			
			CUST.INTERFACE.headerXML = ""
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Header>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestHeader>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageKey>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestUUID>"+ CUST.INTERFACE.RequestID1 +"</RequestUUID>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestId>"+ CUST.INTERFACE.interfaceRequestID +"</ServiceRequestId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ServiceRequestVersion>10.2</ServiceRequestVersion>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<ChannelId>" + CUST.INTERFACE.channelID + "</ChannelId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</MessageKey>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestMessageInfo>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<BankId>" + CUST.INTERFACE.bankID + "</BankId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<TimeZone>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</TimeZone>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</EntityId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<EntityType>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</EntityType>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageDateTime>" + CUST.INTERFACE.msgDateTime + "</MessageDateTime>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestMessageInfo>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Security>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Token>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<PasswordToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<UserId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</UserId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Password>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Password>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</PasswordToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Token>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<FICertToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</FICertToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserLoginSessionId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RealUserLoginSessionId>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUser>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RealUser>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RealUserPwd>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RealUserPwd>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<SSOTransferToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</SSOTransferToken>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Security>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</RequestHeader>"
			CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "</Header>"
			
			#-------------------------------------------------------------------------
			#- Forming the Body for RetCustAdd
			#-------------------------------------------------------------------------
			CUST.INTERFACE.bodyXMLMsg = ""
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Body>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<verifyCustomerDetailsRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustomerVerifyRq>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<cifId>" + CUST.INTERFACE.CIF + "</cifId>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<decision>Approve</decision>"
			
			IF (CUST.INTERFACE.RETCOPR == "CORP") THEN
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<entityName>CorporateCustomer</entityName>"
			ELSE
				CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<entityName>RetailCustomer</entityName>"
			ENDIF
			
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CustomerVerifyRq>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</verifyCustomerDetailsRequest>"
			CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Body>"
			
			#-------------------------------------------------------------------------
			#Appending the header XML and body XML.
			#-------------------------------------------------------------------------
			CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
			CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"
			
			#-------------------------------------------------------------------------------
			# Setting input values for urhk_ConnectToFIAndSendMsg userhook
			#-------------------------------------------------------------------------------
			BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
			print(BANCS.INPARAM.SERVICE_NAME)
			BANCS.INPARAM.SEND_RECV_FLG             = "R"
			sv_a = CUST.INTERFACE.reqXMLMsg
			PRINT(sv_a)
			
			#-------------------------------------------------------------------------
			#- Executing the userhook to make the Outbound Call
			#-------------------------------------------------------------------------
			sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
			print(sv_l)
			IF (sv_l != 0) THEN
			#{
				print(BANCS.OUTPARAM.ErrMsg)
				CUST.INTERFACE.errorMsgFlg = "Y"
				CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.INTERFACE.errorMsgCode = "FIERR"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			IF (BANCS.OUTPARAM.ErrMsg != "") THEN
			#{
				CUST.INTERFACE.errorMsgFlg = "Y"
				CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
				CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
				CUST.INTERFACE.errorMsgCode = "FIERR"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
				print(CUST.INTERFACE.respXMLMsg)
				CUST.INTERFACE.errorMsgFlg = ""
				CUST.INTERFACE.errorMsgDesc = ""
				
				CUST.INTERFACE.opndate = ""
				#CUST.INTERFACE.cifid = ""
				CUST.INTERFACE.errorCode = ""
				CUST.INTERFACE.errorDesc = ""
				sv_x = CUST.INTERFACE.respXMLMsg
				
				#--------------------------------------------------------------------------------------------------------
				# Fetching the status of the request
				#--------------------------------------------------------------------------------------------------------
				sv_y = "<Status>"
				sv_z = "</Status>"
				sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
				sv_e = GETPOSITION(sv_x, sv_z) - 1
				IF (GETPOSITION(sv_x, sv_y) != 0) THEN
				#{
					CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
					#}
				ELSE
					#{
					CUST.INTERFACE.tranStatus = ""
				#}
				ENDIF
				print(CUST.INTERFACE.tranStatus)
				#--------------------------------------------------------------------------------------------------------
				# If Success fetching cif id and cif opn date else fetching error code and description
				#--------------------------------------------------------------------------------------------------------
				IF (CUST.INTERFACE.tranStatus =="SUCCESS")  THEN
				#{
					CUST.INTERFACE.errorMsgFlg = "N"
					sv_x = CUST.INTERFACE.respXMLMsg
					sv_y = "<CustId>"
					sv_z = "</CustId>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.INTERFACE.cifid = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.INTERFACE.cifid)
					#}
					ENDIF
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					
					
					
					sv_s = "UPDATE CUSTOM.INT_CHANGE  SET ENTITY_CRE_FLG = 'V', CUST_PREF ='VERIFIED' "
					sv_s = sv_s + " WHERE FORACID  = ?SVAR  AND bank_id = ?SVAR    "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId 
					print(BANCS.INPARAM.BINDVARS)
			
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
									
					IF (CUST.INTERFACE.CIF == "") THEN
					#{
						CUST.INTERFACE.errorMsgFlg = "Y"
						CUST.INTERFACE.errorCode = "SYSERR"
						CUST.INTERFACE.errorDesc = "Could not get response from server"
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.INTERFACE.errorMsgFlg = "Y"
					IF(CUST.INTERFACE.tranStatus != "SUCCESS") THEN
					#{
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<ErrorCode>"
						sv_z = "</ErrorCode>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
						#}
						ENDIF
						sv_x = CUST.INTERFACE.respXMLMsg
						sv_y = "<ErrorDesc>"
						sv_z = "</ErrorDesc>"
						sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
						sv_e = GETPOSITION(sv_x, sv_z) - 1
						IF (GETPOSITION(sv_x, sv_y) != 0) THEN
						#{
							CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
						#}
						ENDIF
						
						#----------------------------------------------------------------------------------------------------
						# Update custom table failure status
						#----------------------------------------------------------------------------------------------------
						IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
						#{
							CUST.INTERFACE.errorCode = "SYSERR"
							CUST.INTERFACE.errorDesc = "Could not get response from server"
						#}
						ENDIF
						
						sv_s = "UPDATE  CUSTOM.INT_CHANGE SET ENTITY_CRE_FLG = 'VE', CUST_PREF = SUBSTR (replace (q'["+CUST.INTERFACE.errorDesc+"]',q'[|]',q'[ ]'),1,100) "
						sv_s = sv_s + " WHERE foracid  = ?SVAR AND bank_id = ?SVAR   "
						print(sv_s)
						BANCS.INPARAM.BINDVARS =  CUST.INTERFACE.CIF   + "|" + BANCS.STDIN.contextBankId 
						print(BANCS.INPARAM.BINDVARS)
				
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
						#{
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						#}
						ENDIF
					#}
					ENDIF
					IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
					#{
						CUST.INTERFACE.errorCode = "SYSERR"
						CUST.INTERFACE.errorDesc = "Could not get response from server"
					#}
					ENDIF
				#}
				ENDIF
				

			#}
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUST.INTERFACE.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
		#trace off
END-->
