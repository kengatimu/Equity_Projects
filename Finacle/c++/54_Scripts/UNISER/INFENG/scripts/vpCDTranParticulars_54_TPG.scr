<--start
trace on
sv_u = urhk_B2K_PrintRepos("BANCS")
print(sv_u)
print(BANCS.OUTPUT.TranParticulars)
print(BANCS.OUTPUT.TranParticulars2)
print(BANCS.OUTPUT.TranRemarks)
print(BANCS.OUTPUT.TranParticularsCode)
print(BANCS.OUTPUT.RefNum)
if(fieldexists(BANCS.INPUT.Command)==1)then
        print(BANCS.INPUT.Command)
endif
if(fieldexists(BANCS.INPUT.Foracid)==1)then
        print(BANCS.INPUT.Foracid)
endif
if(fieldexists(BANCS.INPUT.CrForacid)==1)then
        print(BANCS.INPUT.CrForacid)
endif
if(fieldexists(BANCS.INPUT.PartTranType)==1)then
        print(BANCS.INPUT.PartTranType)
endif
if(fieldexists(BANCS.INPUT.PartTranIdentifier)==1)then
        print(BANCS.INPUT.PartTranIdentifier)
endif
if(fieldexists(BANCS.INPUT.TranId)==1)then
        print(BANCS.INPUT.TranId)
endif
if(fieldexists(BANCS.INPUT.ReservedField1)==1)then
        print(BANCS.INPUT.ReservedField1)
endif
if(fieldexists(BANCS.INPUT.ReservedField2)==1)then
        print(BANCS.INPUT.ReservedField2)
endif
if(fieldexists(BANCS.INPUT.ReservedField3)==1)then
        print(BANCS.INPUT.ReservedField3)
endif
if((BANCS.INPUT.ReservedField2!="")and(BANCS.INPUT.ReservedField2=="PESALINKIN"))then
        if(BANCS.INPUT.ReservedField1!="")then
                sv_l = strlen(BANCS.INPUT.ReservedField1)
                sv_f = mid$(BANCS.INPUT.ReservedField1,0,sv_l)
                sv_p = getposition(sv_f,"|")
                BANCS.INPUT.pesnum  = mid$(sv_f,0,(sv_p-1))
                print(BANCS.INPUT.pesnum)
                BANCS.INPUT.ReservedField1 = mid$(sv_f,sv_p,sv_l)
                print(BANCS.INPUT.ReservedField1)
                sv_l = strlen(BANCS.INPUT.ReservedField1)
                sv_f = mid$(BANCS.INPUT.ReservedField1,0,sv_l)
                sv_p = getposition(sv_f,"|")
                BANCS.INPUT.pesname  = mid$(sv_f,0,(sv_p-1))
                print(BANCS.INPUT.pesname)
                BANCS.INPUT.pesrlnum = mid$(sv_f,sv_p,sv_l)
                print(BANCS.INPUT.pesrlnum)
        endif
        lv_p = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
        if(lv_p==0)then
                BANCS.INPUT.custName = BANCS.OUTPARAM.acctName
        else
                BANCS.INPUT.custName = ""
        endif
        if((BANCS.INPUT.PartTranIdentifier=="CONTRA")and(BANCS.INPUT.PartTranType=="C"))then
                BANCS.INPUT.istpgSkip = "N"
        endif
        if((BANCS.INPUT.PartTranIdentifier=="CUST")and(BANCS.INPUT.PartTranType=="D"))then
                BANCS.INPUT.ccustName = "TPG/" + BANCS.INPUT.pesnum + "/" + BANCS.INPUT.custName
                BANCS.OUTPUT.TranParticulars = mid$(BANCS.INPUT.ccustName,0,50)
                print(BANCS.OUTPUT.TranParticulars)
                BANCS.OUTPUT.TranRemarks = mid$(BANCS.INPUT.pesnum,0,30)
                print(BANCS.OUTPUT.TranRemarks)
                BANCS.OUTPUT.RefNum = mid$(BANCS.INPUT.pesnum,0,20)
                print(BANCS.OUTPUT.RefNum)
                BANCS.INPUT.istpgSkip = "Y"
        endif
else
                BANCS.INPUT.istpgSkip = "N"
endif
##trace off
end-->
