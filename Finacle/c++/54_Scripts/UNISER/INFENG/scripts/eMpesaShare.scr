##	###################################
##	#  End Revarsal part
##	#######################################



# COPY REPO

call("copyBancsToCustC24.scr")

	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------

	IF(REPEXISTS("MTT") == 0 ) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	sv_r = CLASSEXISTS("MTT","Error")
        IF (sv_r == 0) THEN
                CREATECLASS("MTT","Error",5)
        ENDIF
	  
	IF (CLASSEXISTS("MTT","TranDetails")==0) THEN
	#{
		CREATECLASS("MTT","TranDetails",5)
	#}
	ENDIF  

	IF (CLASSEXISTS("MTT","PartTranDetails")==0) THEN
	#{
		CREATECLASS("MTT","PartTranDetails",5)
	#}
	ENDIF

	IF (REPEXISTS("BANCS")==0) THEN
	#{
	   CREATEREP("BANCS")
	#}
	ENDIF
	  
	IF (CLASSEXISTS("BANCS","PartTranDetails")==0) THEN
	#{
		CREATECLASS("BANCS","PartTranDetails",5)
	#}
	ENDIF  

	IF (CLASSEXISTS("BANCS","INPARAM")==0) THEN
	#{
	CREATECLASS("BANCS","INPARAM",5)
	#}
	ENDIF

	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="N"
	BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
	MTT.TranDetails.Remarks = CUST.ATM.narr1

	sv_u = urhk_MTTS_Initialize("")
	#print(sv_r)

	sv_v = "CashBackComm"
	#print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("CashBackComm")
	print(sv_u)

	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)

	#--------------------------------------------------
	# Income To Branch A/c
	#--------------------------------------------------
	print(CUST.ATM.CrMpesaSelfServiceIncome)
	MTT.PartTranDetails.Account = CUST.ATM.CrMpesaSelfServiceIncome
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATM.narr1
	MTT.PartTranDetails.Particulars2 = CUST.ATM.narr2	 
	MTT.PartTranDetails.RefAmount = cdouble(CUST.ATM.drCrAmount)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = CUST.ATM.narr3 
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_e = "CashBackIncome"	
	sv_u = urhk_MTTS_definePartTran(sv_e)
	print(sv_u)

	print(CUST.ATM.CrMpesaCommDepPool)
	MTT.PartTranDetails.Account = CUST.ATM.CrMpesaCommDepPool
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATM.narr1
	MTT.PartTranDetails.Particulars2 = CUST.ATM.narr2 
	MTT.PartTranDetails.RefAmount = cdouble(CUST.ATM.SplitAmt)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = CUST.ATM.narr3 
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_e = "CashBackIncome"	
	sv_u = urhk_MTTS_definePartTran(sv_e)
	print(sv_u)

	#------------------------------------------------------------------
	# Debit Partran To Agent Pool A/C
	#------------------------------------------------------------------
	print(CUST.ATM.DrMpesaReceivable)
	MTT.PartTranDetails.Account = CUST.ATM.DrMpesaReceivable
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATM.narr1
	MTT.PartTranDetails.Particulars2 = CUST.ATM.narr2 
	MTT.PartTranDetails.RefAmount = -1 * cdouble(CUST.ATM.drCrAmount)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = "" 
	MTT.PartTranDetails.RefNum = CUST.ATM.narr3 
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = "D" + CUST.ATM.DrMpesaReceivable
	sv_u = urhk_MTTS_definePartTran(sv_h)
	print(sv_u)

	print(CUST.ATM.DrMpesaExpense)
	MTT.PartTranDetails.Account = CUST.ATM.DrMpesaExpense
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATM.narr1
	MTT.PartTranDetails.Particulars2 = CUST.ATM.narr2 
	MTT.PartTranDetails.RefAmount = -1 * cdouble(CUST.ATM.SplitAmt)
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = "" 
	MTT.PartTranDetails.RefNum = CUST.ATM.narr3 
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = "D" + CUST.ATM.DrMpesaExpense 
	sv_u = urhk_MTTS_definePartTran(sv_h)
	print(sv_u)
	

	sv_u = urhk_MTTS_EndDefinition("")
	print(sv_r)

	IF(fieldexists(MTT.Error.Description)) THEN
		print(MTT.Error.Description)
	ENDIF

	
	sv_r = urhk_MTTS_EndDefinition("")
	sv_r = urhk_MTTS_Close("")
	print(sv_r)

	IF(fieldexists(BANCS.OUTPARAM.MTTTranId)) THEN
		print(BANCS.OUTPARAM.MTTTranId)
		CUST.ATM.tranid = BANCS.OUTPARAM.MTTTranId
		print(CUST.ATM.tranid)
	ENDIF



# COPY REPO
 call("copyCust24ToBancs.scr")

