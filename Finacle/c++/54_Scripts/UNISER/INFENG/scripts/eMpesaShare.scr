<--START

trace on

#####----------------------------------------------####
# Creating of  Repositories and Classes
#####----------------------------------------------####

IF(REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","ATM") == 0) THEN
#{
    CREATECLASS("CUST","ATM",5)
#}
ENDIF



	#------------------------------------------------------------------
	#  Getting fee amount
	#------------------------------------------------------------------
	print(BANCS.INPUT.TranFeeAmount1)

	IF (BANCS.INPUT.TranFeeAmount1 == "") THEN
	#{
		CUST.ATM.FeeAmount = "0"   		
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.ATM.FeeAmount = CDOUBLE(BANCS.INPUT.TranFeeAmount1)
		print(CUST.ATM.FeeAmount)
	#}
	ENDIF
	#------------------------------------------------------------------
	#  Getting transaction amount
	#------------------------------------------------------------------
	
	print(BANCS.INPUT.TranAmt)

	IF (BANCS.INPUT.TranAmt == "") THEN
	#{
		CUST.ATM.Amount = "0"   		
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.ATM.Amount = CDOUBLE(BANCS.INPUT.TranAmt)
		CUST.ATM.Amount = CDOUBLE(CUST.ATM.Amount)/CDOUBLE("100")
		print(CUST.ATM.Amount)
		
		IF (BANCS.INPUT.Command == "TRTR") THEN 
	
			CUST.ATM.tableCode="MPESA"
		ENDIF
		
		#---------------------------------------------------------
		# getting amount to share 
		#---------------------------------------------------------
		
		BANCS.INPARAM.InputAmount = CUST.ATM.Amount
		BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
		BANCS.INPARAM.AmountTableCode = CUST.ATM.tableCode
		
		sv_u = urhk_B2k_GetASTMAmount ("") 
		print(sv_u)
		
		If (sv_u ==1)  then 
		#{
			sv_u = urhk_SRV_SetErr("Invalid Charge Code")
			BANCS.OUTPUT.successOrFailure = "F" 
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.ATM.drCrAmount= BANCS.OUTPARAM.OutputAmount
			print(CUST.ATM.drCrAmount)
		#}	
		ENDIF 
		#----------------------50%split
		CUST.ATM.SplitAmt = cdouble("0")	
		if(CUST.ATM.drCrAmount !="")then
			CUST.ATM.SplitAmt =cdouble(CUST.ATM.drCrAmount)* 0.5
			print(CUST.ATM.SplitAmt)
		endif	
	#}	
	ENDIF
	
	#---------------------------------------------------------
	# Getting contra accounts
	#---------------------------------------------------------
	#MPESA receivable
	#CUST.ATM.DrMpesaReceivable=CUST.ATM.possol+"1300106894"
	CUST.ATM.DrMpesaReceivable="0001300106894"
	print(CUST.ATM.DrMpesaReceivable)
	#MPESA Self service
	CUST.ATM.CrMpesaSelfServiceIncome=CUST.ATM.possol+"6500106014"
	print(CUST.ATM.CrMpesaSelfServiceIncome)
	#MPESA Expense GL
	CUST.ATM.DrMpesaExpense=CUST.ATM.possol+"8100306895"
	print(CUST.ATM.DrMpesaExpense)
	#MPESA CommDepPool
	CUST.ATM.CrMpesaCommDepPool=CUST.ATM.possol+"3000104365"
	print(CUST.ATM.CrMpesaCommDepPool)
	
	
	#--------------------------------------------------------------------------
	# Create the narration add reversal
	#--------------------------------------------------------------------------
	
	sv_e = mid$(BANCS.STDIN.BODDate,0,10)
	#print(sv_e)
	sv_s = "sysdate|"
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
	sv_s = sv_s + " FROM DUAL"
	BANCS.INPARAM.BINDVARS = sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	#print(sv_d)
	
	IF (sv_d =="0") THEN
	#{
		CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate

		IF  (BANCS.INPUT.Command == "TRTR") THEN
		#{
			CUST.ATM.narr1 ="MPESA FLOAT COMM" + "/" +BANCS.INPUT.ReservedField3 + "/" + CUST.ATM.sysdate
		#}
		ELSE
		#{
			CUST.ATM.narr1 ="REV MPESA FLOAT COMM" + "/" +BANCS.INPUT.ReservedField3 + "/" + CUST.ATM.sysdate
		#}
		ENDIF
	#}
	ENDIF
	CUST.ATM.narr2 = mid$(BANCS.INPUT.CardAcceptorName,0,50)
	print(CUST.ATM.narr2)
	CUST.ATM.narr3=Mid$(BANCS.INPUT.ReservedField3,2,20)
	print(CUST.ATM.narr3)

##	sv_s = "sysDateAgt "
##	sv_s = sv_s + " | "
##	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') "
##	sv_s = sv_s + " FROM DUAL"
##	BANCS.INPARAM.BINDVARS = sv_e
##	sv_d = urhk_dbSelectWithBind(sv_s)
##	#print(sv_d)
##	
##	IF (sv_d =="0") THEN
##	#{
##		CUST.ATM.sysDateAgt = BANCS.OUTPARAM.sysDateAgt
##	#}
##	ELSE
##	#{
##		GOTO ENDOFSCRIPT
##	#}
##	ENDIF

	
##	###################################
##	#  start Revarsal part
##	#######################################
##
##	IF  ((BANCS.INPUT.Command == "CDRR") OR  (BANCS.INPUT.Command == "CWRR"))  THEN 
##	#{
##		sv_c = CUST.ATM.CrAccount
##		print(sv_c)
##		
##		sv_k = CUST.ATM.DrMpesaReceivable
##		print(sv_k)
##		
##		CUST.ATM.CrAccount = sv_k
##		print(CUST.ATM.CrAccount)
##		
