	ELSE
		#{
		CUST.WTRCHRG.errMsg = "countVal setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------
	# CPARAM Setup for bacid
	#-----------------------------------------------------
	BANCS.INPUT.moduleName  = "WTRCHRGS"
	BANCS.INPUT.parameterId = "BACID_VAL"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.bacid= BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.bacid)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "bacid setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------
	# CPARAM Setup for tranRmksHdr
	#-----------------------------------------------------
	BANCS.INPUT.moduleName  = "WTRCHRGS"
	BANCS.INPUT.parameterId = "TRAN_HDR_RMK"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.tranRmksHdr= BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tranRmksHdr)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "tranRmksHdr setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------
	# CPARAM Setup for refNum
	#-----------------------------------------------------
	BANCS.INPUT.moduleName  = "WTRCHRGS"
	BANCS.INPUT.parameterId = "TRAN_REF_NUM"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.refNum= BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.refNum)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "refNum setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------
	# CPARAM Setup for tranParticular
	#-----------------------------------------------------
	BANCS.INPUT.moduleName  = "WTRCHRGS"
	BANCS.INPUT.parameterId = "TRAN_PARTICULAR"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.tranParticular= BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tranParticular)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "tranParticular setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-----------------------------------------------------
	# CPARAM Setup for rateCode
	#-----------------------------------------------------
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.rateCode= BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.rateCode)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "rateCode setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------
	#  Getting Credit account id and Debit account id
	#------------------------------------------------------------------
	PRINT(CUST.CPARAM.brAccount)
	PRINT(CUST.CPARAM.hoAccount)
	
	#------------------------------------------------------------------
	#  selecting clr_bal_amt from GAM table for brAccount
	#------------------------------------------------------------------
	sv_s = "bal|"
	sv_s = sv_s + " SELECT GAM.clr_bal_amt"
	sv_s = sv_s + " FROM TBAADM.GAM "
	sv_s = sv_s + " WHERE GAM.foracid=?SVAR"
	sv_s = sv_s + " AND GAM.del_flg='N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg='Y'"
	sv_s = sv_s + " AND GAM.acct_cls_flg='N' "
	sv_s = sv_s + " AND GAM.bank_id=?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CPARAM.brAccount + "|"+ BANCS.STDIN.contextBankId
	
	sv_d =  urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.WTRCHRG.bal=BANCS.OUTPARAM.bal
		PRINT(CUST.WTRCHRG.bal)
		IF (CDOUBLE(CUST.WTRCHRG.bal)==CDOUBLE(CUST.WTRCHRG.zeroBal)) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "Error WHILE selecting clr_bal_amt from GAM table"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------
	#  Calculating Appfee from GAM,DTD
	#------------------------------------------------------------------
	sv_s = "Appfee|"
	sv_s = sv_s + " SELECT COUNT(1) * "
	sv_s = sv_s + " ?SVAR"
	sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
	sv_s = sv_s + " WHERE GAM.acid=DTD.acid"
	sv_s = sv_s + " AND GAM.bank_id=DTD.bank_id"
	sv_s = sv_s + " AND GAM.foracid=?SVAR"
	sv_s = sv_s + " AND DTD.part_tran_type='C'"
	sv_s = sv_s + " AND DTD.del_flg='N'"
	sv_s = sv_s + " AND GAM.del_flg='N'"
	sv_s = sv_s + " AND GAM.acct_cls_flg='N' "
	sv_s = sv_s + " AND GAM.entity_cre_flg='Y'"
	sv_s = sv_s + " AND GAM.bank_id=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.CPARAM.countVal + "|" + CUST.CPARAM.brAccount
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.WTRCHRG.Appfee=BANCS.OUTPARAM.Appfee
		PRINT(CUST.WTRCHRG.Appfee)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "Error WHILE Calculating Appfee"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------
	#  Calculating totalamt from GAM,DTD
	#------------------------------------------------------------------
	sv_s = "totalamt|"
	sv_s = sv_s + " SELECT SUM(tran_amt)"
	sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
	sv_s = sv_s + " WHERE GAM.acid=DTD.acid"
	sv_s = sv_s + " AND GAM.bank_id=DTD.bank_id"
	sv_s = sv_s + " AND GAM.foracid=?SVAR"
	sv_s = sv_s + " AND DTD.part_tran_type='C'"
	sv_s = sv_s + " AND DTD.del_flg='N'"
	sv_s = sv_s + " AND GAM.del_flg='N'"
	sv_s = sv_s + " AND GAM.entity_cre_flg='Y'"
	sv_s = sv_s + " AND GAM.bank_id=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.CPARAM.brAccount + "|" +BANCS.STDIN.contextBankId
	PRINT(sv_s)
	sv_d =  urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		CUST.WTRCHRG.totalamt=BANCS.OUTPARAM.totalamt
		PRINT(CUST.WTRCHRG.totalamt)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "Error WHILE Calculating totalamt"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ((CDOUBLE(CUST.WTRCHRG.Appfee)==CDOUBLE(CUST.WTRCHRG.zeroBal)) AND (CDOUBLE(CUST.WTRCHRG.totalamt)==CDOUBLE(CUST.WTRCHRG.zeroBal)))THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------
	#  Hardcoding the bacid
	#------------------------------------------------------------------
	IF (CDOUBLE(CUST.WTRCHRG.Appfee)!=CDOUBLE(CUST.WTRCHRG.zeroBal)) THEN
	#{
		sv_i = CUST.CPARAM.bacid + "|" + BANCS.STDIN.homeCrncyCode+ "|" + BANCS.STDIN.mySolId
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		PRINT(sv_u)
		IF (sv_u == 1 ) THEN
		#{
			CUST.WTRCHRG.errMsg = "The Application Fee A/C not set up "
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.WTRCHRG.CrAcnt = CUST.CPARAM.hoAccount
		PRINT(CUST.WTRCHRG.CrAcnt)
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Defining Transaction Header
	#--------------------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.CPARAM.tranRmksHdr)
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	
	#-----------------------------------------------------------------------
	# Defining Transaction Amount
	#-----------------------------------------------------------------------
	CUST.WTRCHRG.refAmt=CDOUBLE(CUST.WTRCHRG.Appfee)
	
	#-----------------------------------------------------
	# Add partTran0 (credit)
	#-----------------------------------------------------
	sv_a = "tranDtl.partTranDetailLL.<rec_0>."
	PRINT(sv_a)
	sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|1")
	sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|C")
	sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.WTRCHRG.CrAcnt)
	sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.WTRCHRG.refAmt+"|"+ BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|"+CUST.CPARAM.tranParticular)
	sv_u = urhk_SetUrhkInp(sv_a + "refNum| "+CUST.CPARAM.refNum)
	sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.WTRCHRG.refAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.CPARAM.rateCode)
	
	#---------------------------------------------------------
	# Add partTran1  (debit)
	#---------------------------------------------------------
	sv_b = "tranDtl.partTranDetailLL.<rec_1>."
	PRINT(sv_b)
	sv_u = urhk_SetUrhkInp(sv_b + "key.serial_num|2")
	sv_u = urhk_SetUrhkInp(sv_b + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_b + "partTranType.code|D")
	sv_u = urhk_SetUrhkInp(sv_b + "acctId.foracid|"+CUST.CPARAM.brAccount)
	sv_u = urhk_SetUrhkInp(sv_b + "valueDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_b + "glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp(sv_b + "tranAmt|"+CUST.WTRCHRG.refAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_b + "tranParticulars|"+CUST.CPARAM.tranParticular)
	sv_u = urhk_SetUrhkInp(sv_b + "refNum| "+CUST.CPARAM.refNum)
	sv_u = urhk_SetUrhkInp(sv_b + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_b + "refAmt|"+CUST.WTRCHRG.refAmt+"|"+BANCS.STDIN.homeCrncyCode)
	sv_u = urhk_SetUrhkInp(sv_b + "entryUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_b + "vfdUserId.userId|" + BANCS.STDIN.userId)
	sv_u = urhk_SetUrhkInp(sv_b + "rateCode.refCode|" + CUST.CPARAM.rateCode)
	
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
	sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
	PRINT(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
		PRINT(sv_u)
	#}
	ENDIF
	
	IF (sv_u == 0) THEN
	#{
		IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.tranId)
			#}
		ELSE
			#{
			CUST.WTRCHRG.errMsg = "Tansaction Id not generated"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
		sv_u = urhk_CopyOutToIn("")
		sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
		
		IF (sv_u != 0 ) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			PRINT(sv_u)
		#}
		ENDIF
	#}
	ENDIF
	
	IF (sv_u != 0) THEN
	#{
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_i = sv_i + 1
				sv_u = SYSTEM("echo '"+sv_e+"' >>waterchrg.log")
				PRINT(sv_u)
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		#---------------------------------------------------------------------
		# Error Logging
		#---------------------------------------------------------------------
		IF (CUST.WTRCHRG.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.WTRCHRG.errMsg+"' >>waterchrg.log")
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
