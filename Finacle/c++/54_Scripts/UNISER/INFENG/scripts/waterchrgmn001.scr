<--START
CHECKSUM="ac69ce47ebbe0fd628fa8f2fda26d888423067de7fa31b9d3ed10239c2ad12a3"
	TRACE ON
	
	#-----------------------------------------------------------------
	# Creating Repository and classes
	#-----------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","WTRCHRG") == 0) THEN
	#{
		CREATECLASS("CUST","WTRCHRG",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------
	# Initializing required variables
	#-----------------------------------------------------------------
	CUST.WTRCHRG.errMsg		= ""
	CUST.WTRCHRG.zeroBal		= "0"
	
	#-----------------------------------------------------
	# CPARAM Setup for brAccount
	#-----------------------------------------------------
	BANCS.INPUT.moduleName  = "WTRCHRGS"
	BANCS.INPUT.parameterId = "BR_ACCT"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.brAccount = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.brAccount)
		#}
	ELSE
		#{
		CUST.WTRCHRG.errMsg = "brAccount setup not done in CPARAM"
		GOTO ENDOFSCRIPT
