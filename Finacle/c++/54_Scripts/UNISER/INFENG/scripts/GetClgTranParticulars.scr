		print(OCTR.GLBVAR.Chq)
		#BANCS.OUTPUT.tranRemarks = ""
		print(BANCS.OUTPUT.tranRemarks)
		
		OCTR.GLBVAR.billerFlg = "N"
		sv_q = "cnt|SELECT COUNT(1) FROM CUSTOM.C_UBP "
		sv_q = sv_q + " WHERE FREETEXT7 = ?SVAR AND BILLER_BNK_ID = ?SVAR "
		BANCS.INPARAM.BINDVARS = OCTR.GLBVAR.FreeText2 + "|" + BANCS.STDIN.contextBankId
		sv_d = urhk_dbSelectWithBind(sv_q)
		print(sv_d)
		IF(sv_d == 0) THEN
		#{
			# Biller transaction
			print(BANCS.OUTPARAM.cnt)
			IF(CINT(BANCS.OUTPARAM.cnt) != 0)THEN
			#{
				OCTR.GLBVAR.billerFlg = "Y"
				
				sv_s = "billerid|SELECT biller_id FROM CUSTOM.C_UBP "
				sv_s = sv_s + " WHERE FREETEXT7 = ?SVAR AND BILLER_BNK_ID = ?SVAR AND rownum<2 "
				BANCS.INPARAM.BINDVARS = OCTR.GLBVAR.FreeText2 + "|" + BANCS.STDIN.contextBankId
				sv_e = urhk_dbSelectWithBind(sv_s)
				print(sv_e)
				IF(sv_e == 0) THEN
				#{
					OCTR.GLBVAR.billerid=BANCS.OUTPARAM.billerid
					print(OCTR.GLBVAR.billerid)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.OCPFreeText1))THEN
		#{
			IF((TRIM(BANCS.INPUT.OCPFreeText1) != "") AND (OCTR.GLBVAR.billerFlg == "Y"))THEN
			#{
				
				IF ((OCTR.GLBVAR.billerid=="1348") OR (OCTR.GLBVAR.billerid=="KPA112") OR (OCTR.GLBVAR.billerid=="NAIROBIKRA") OR (OCTR.GLBVAR.billerid=="KAPEMATT")) THEN
				#{
					BANCS.OUTPUT.tranRemarks = BANCS.INPUT.OCPFreeText1
					BANCS.OUTPUT.tranParticulars = BANCS.OUTPUT.tranParticulars + " " + BANCS.OUTPUT.tranRemarks
					#}
				ELSE
					#{
					BANCS.OUTPUT.tranParticulars = BANCS.OUTPUT.tranParticulars + " " + BANCS.OUTPUT.tranRemarks
					BANCS.OUTPUT.tranRemarks = BANCS.INPUT.OCPFreeText1
				#}
				ENDIF
				
				#}
			ELSE
				#{
				BANCS.OUTPUT.tranParticulars = BANCS.OUTPUT.tranParticulars + " " + BANCS.OUTPUT.tranRemarks
				BANCS.OUTPUT.tranRemarks = ""
			#}
			ENDIF
		#}
		ENDIF
		if(fieldexists(OCTR.GLBVAR.billerid)==1)then
			if(OCTR.GLBVAR.billerid == "MPESALTD")then
				if(BANCS.INPUT.clgZoneCode=="CTSINHSE")then
					#BANCS.INPUT.tempParticuls = "CLEARING-TRANSFER/" + trim(BANCS.INPUT.instNum) + "-" + BANCS.INPUT.OCPFreeText2
					BANCS.INPUT.tempParticuls = "Inhouse Cheque/" + BANCS.INPUT.OCPFreeText1 + "-" + BANCS.INPUT.OCPFreeText2
					print(BANCS.INPUT.tempParticuls)
					BANCS.OUTPUT.tranRemarks = OCTR.GLBVAR.Chq 
					print(BANCS.OUTPUT.tranRemarks)
				else
					BANCS.INPUT.tempParticuls = "CLEARING-TRANSFER/" + BANCS.INPUT.OCPFreeText1 + "-" + BANCS.INPUT.OCPFreeText2
                                        print(BANCS.INPUT.tempParticuls)
					BANCS.OUTPUT.tranRemarks = OCTR.GLBVAR.Chq
                                        print(BANCS.OUTPUT.tranRemarks)
				endif
			else
				BANCS.INPUT.tempParticuls = BANCS.OUTPUT.tranParticulars
			endif
			print(BANCS.INPUT.tempParticuls)
			BANCS.OUTPUT.tranParticulars = LEFT$(BANCS.INPUT.tempParticuls,50)
			print(BANCS.OUTPUT.tranParticulars)
		else
			print(BANCS.OUTPUT.tranParticulars)
			BANCS.OUTPUT.tranParticulars = LEFT$(BANCS.OUTPUT.tranParticulars,50)
		endif
		print(BANCS.OUTPUT.tranParticulars)
		print(BANCS.OUTPUT.tranRemarks)
		
		
		
		FINISH:
			IF (OCTR.GLBVAR.errMsg != "") THEN
			#{
				sv_a = urhk_SRV_SetErr(OCTR.GLBVAR.errMsg)
				BANCS.OUTPUT.successOrFailure="F"
			#}
			ENDIF
			#TRACE OFF
			EXITSCRIPT
	END-->
	
	
