		BANCS.INPUT.parameterId="STR4"
		CALL("getcparamvalue.scr")
		IF(BANCS.OUTPUT.parameterVal != "") THEN
		#{
			OCTR.GLBVAR.str4 = BANCS.OUTPUT.parameterVal
			#}
		ELSE
			#{
			OCTR.GLBVAR.errMsg = BANCS.INPUT.parameterId+" setup is not done in CPARAM"
			GOTO FINISH
		#}
		ENDIF
		
		IF (BANCS.INPUT.clgZoneCode == OCTR.GLBVAR.zone1) THEN
		#{
			BANCS.OUTPUT.tranParticulars = BANCS.INPUT.instNum  + OCTR.GLBVAR.str3
		#}
		ENDIF
		
		IF ((BANCS.INPUT.clgZoneCode == OCTR.GLBVAR.zone2) OR (BANCS.INPUT.clgZoneCode == OCTR.GLBVAR.zone3)) THEN
		#{
			BANCS.OUTPUT.tranParticulars = BANCS.INPUT.OCPParticulars
			#}
		ELSE
			#{
			BANCS.OUTPUT.tranParticulars = OCTR.GLBVAR.str4 + BANCS.INPUT.instNum
		#}
		ENDIF
		
		BANCS.OUTPUT.tranRemarks = BANCS.INPUT.OCPRemarks
		BANCS.OUTPUT.valueDate = BANCS.INPUT.clgZoneDate
		print(BANCS.OUTPUT.valueDate)
		#-----------------------------------------------------------------
		#Inculusion of Kiambu Water company CBS primary
		#----------------------------------------------------------------
		
		IF (BANCS.INPUT.OCPParticulars == OCTR.GLBVAR.forAcid1 ) THEN
		#{
			sv_s = "refNum,name|"
			sv_s = sv_s + "SELECT refnum,name "
			sv_s = sv_s + " FROM CUSTOM.C_CIC "
			sv_s = sv_s + " WHERE acctnum = ?SVAR "
			sv_s = sv_s + " AND refnum = ?SVAR "
			sv_s = sv_s + " AND del_flg = 'N' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.OCPParticulars + "|" + BANCS.INPUT.OCPRemarks +"|" +BANCS.STDIN.contextBankId
			sv_d=urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF ( sv_d != 0 ) THEN
			#{
				sv_u = urhk_SRV_SetErr("INVALID ADMIN/REG/BILL/REF NUMBER...")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO FINISH
				#}
			ELSE
				#{
				STDWFS.GLBDATA.refNum = BANCS.OUTPARAM.refNum
				print(STDWFS.GLBDATA.refNum)
				STDWFS.GLBDATA.name = BANCS.OUTPARAM.name
				print(STDWFS.GLBDATA.name)
			#}
			ENDIF
			
			BANCS.OUTPUT.tranParticulars = STDWFS.GLBDATA.name
			print(BANCS.OUTPUT.tranParticulars)
		#}
		ENDIF
		
		#-----------------------------------------------------------------------
		#Inculusion of safaricom Dealearship for CBS Primary by Eric Karobia
		#-----------------------------------------------------------------------
		IF (MID$(BANCS.INPUT.OCPParticulars,0,15) == OCTR.GLBVAR.str1 ) THEN
		#{
			sv_w = OCTR.GLBVAR.forAcid2
			sv_s = "refNum,name|"
			sv_s = sv_s + " SELECT refnum,name"
			sv_s = sv_s + " FROM CUSTOM.C_CIC "
			sv_s = sv_s + " WHERE acctnum = ?SVAR "
			sv_s = sv_s + " AND refnum = ?SVAR "
			sv_s = sv_s + " AND del_flg = 'N' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = sv_w + "|" + BANCS.INPUT.OCPRemarks + "|" + BANCS.STDIN.contextBankId
			sv_d=urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			
			IF ( sv_d != 0 ) THEN
			#{
				sv_a = urhk_SRV_SetErr("INVALID ADMIN/REG/BILL/REF NUMBER...")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO FINISH
				#}
			ELSE
				#{
				STDWFS.GLBDATA.refNum = BANCS.OUTPARAM.refNum
				print(STDWFS.GLBDATA.refNum)
				STDWFS.GLBDATA.name = BANCS.OUTPARAM.name
				print(STDWFS.GLBDATA.name)
				STDWFS.GLBDATA.instNum = trim(BANCS.INPUT.instNum)
				BANCS.OUTPUT.tranParticulars = OCTR.GLBVAR.str1+STDWFS.GLBDATA.instNum+"/"+STDWFS.GLBDATA.refNum + "/" + STDWFS.GLBDATA.name
				BANCS.OUTPUT.tranParticulars = MID$(BANCS.OUTPUT.tranParticulars,0,50)
				print(BANCS.OUTPUT.tranParticulars)
			#}
			ENDIF
			
			print(BANCS.OUTPUT.tranParticulars)
		#}
		ENDIF
		#-----------------------------------------------------------------------
		#Inculusion of safaricom Dealearship for CTS Primary by Eric Karobia
		#-----------------------------------------------------------------------
		IF ((BANCS.INPUT.clgZoneCode == OCTR.GLBVAR.zone4) OR (BANCS.INPUT.clgZoneCode == OCTR.GLBVAR.zone5)) THEN
		#{
			IF (FIELDEXISTS(OCTR.GLBVAR.ctsprimary)) THEN
			#{
				print(OCTR.GLBVAR.name)
				print(OCTR.GLBVAR.refnum)
				print(OCTR.GLBVAR.particulars)
				sv_a = OCTR.GLBVAR.str2 + BANCS.INPUT.instNum
				BANCS.OUTPUT.tranParticulars = sv_a + "/" +OCTR.GLBVAR.particulars
				BANCS.OUTPUT.tranParticulars = MID$(BANCS.OUTPUT.tranParticulars,0,50)
				BANCS.OUTPUT.tranRemarks = MID$(OCTR.GLBVAR.refNum,0,30)
				#}
			ELSE
				#{
				BANCS.OUTPUT.tranRemarks = BANCS.INPUT.OCPParticulars
				print(BANCS.OUTPUT.tranRemarks)
				sv_r = MID$(BANCS.OUTPUT.tranRemarks,0,30)
				print(sv_r)
				BANCS.OUTPUT.tranRemarks = sv_r
				print(BANCS.OUTPUT.tranRemarks)
			#}
			ENDIF
		#}
		ENDIF
		
		#-----------------------------------------------------------------------
		# Tran Remarks column updated with the Payee name
		#-----------------------------------------------------------------------
		
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.clgZoneCode + "|" + BANCS.INPUT.clgZoneDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.mySolId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.OCISet
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.OCIInstNo
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.instNum
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
		
		sv_q = "FreeText3,FreeText2|SELECT FREETEXT3, FREETEXT2 FROM TBAADM.OCI "
		sv_q = sv_q + " WHERE CLG_ZONE_CODE= ?SVAR AND CLG_ZONE_DATE=TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
		sv_q = sv_q + " AND SOL_ID = ?SVAR AND SET_NUM = LPAD(?SVAR ,6) "
		sv_q = sv_q + " AND INSTRMNT_SRL_NUM = LPAD(?SVAR,4) "
		sv_q = sv_q + " AND INSTRMNT_ID = LPAD(?SVAR,16) "
		sv_q = sv_q + " AND BANK_ID = ?SVAR"
		
		sv_d = urhk_dbSelectWithBind(sv_q)
		print(sv_d)
		
		IF(sv_d == 0) THEN
		#{
			
			BANCS.OUTPUT.tranRemarks = BANCS.OUTPARAM.FreeText3
			OCTR.GLBVAR.FreeText2 = BANCS.OUTPARAM.FreeText2
		#}
