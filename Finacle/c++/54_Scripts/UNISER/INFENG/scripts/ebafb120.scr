<--start
trace on
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        if(repexists("EBRPT")==0)then
                createrep("EBRPT")
        endif
        if(classexists("EBRPT","DATA")==0)then
                createclass("EBRPT","DATA",5)
        endif
	if(fieldexists(EBRPT.DATA.rptModule)==1)then
		print(EBRPT.DATA.rptModule)
	endif
	if(fieldexists(EBRPT.DATA.rptDiv)==1)then
		print(EBRPT.DATA.rptDiv)
	endif
	if(fieldexists(EBRPT.DATA.rptName)==1)then
		print(EBRPT.DATA.rptName)
	endif
	if(fieldexists(BANCS.INPUT.fromDate)==1)then
		print(BANCS.INPUT.fromDate)
		EQSRV.GLBDATA.uStmtDate = BANCS.INPUT.fromDate
		sv_a = urhk_B2k_valDate(EQSRV.GLBDATA.uStmtDate)
		if (sv_a != 0) then
			sv_r = "Invalid Statement Date - " + EQSRV.GLBDATA.uStmtDate 
			sv_r = "ERROR|" + sv_r
			sv_w = urhk_SetOrbOut(sv_r)
			exitscript
		endif
	else
		EQSRV.GLBDATA.uStmtDate = mid$(BANCS.STDIN.BODDate,0,10) 
	endif
	sv_a = "rm -f AFB120.lst" 
	sv_a = system(sv_a)
	sv_a = "touch AFB120.lst" 
	sv_a = system(sv_a)
	sv_d = "cifId | select cif_id from custom.afb120_cust_tbl where bank_id=?SVAR and entity_cre_flg='Y' and del_flg='N' "
	print(sv_d)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	sv_u = urhk_dbCursorOpenWithBind(sv_d)
	if(sv_u==0)then
		EQSRV.GLBDATA.afb120CurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	else
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
	endif
        EQSRV.GLBDATA.afbRec = 0
	sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.afb120CurNum)
        if(sv_z!=0)then
                EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
                EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
                EQSRV.GLBDATA.srvSucFail = "F"
                goto VAYU
        endif
        print(sv_z)
        while(sv_z ==0)
	##{
		sv_a = BANCS.OUTPARAM.cifId + "|" + EQSRV.GLBDATA.uStmtDate
		sv_q = "echo '" + sv_a + "' >> AFB120.lst"
                print(sv_q)
                sv_s = system(sv_q)
                print(sv_s)
                sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.afb120CurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.afb120CurNum)
                        print(sv_u)
                        EQSRV.GLBDATA.srvErrMsg =  "120 Cursor Fetch Failed"
                        EQSRV.GLBDATA.srvErrCode = "DBCursor"
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto VAYURUN
                endif
                EQSRV.GLBDATA.afbRec = cint(EQSRV.GLBDATA.afbRec) + 1
                EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.afbRec
                print(EQSRV.GLBDATA.recmsg)
        ##}vploop Ends
        do
        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.afb120CurNum)
        print(sv_u)
	VAYURUN:
        sv_s = "echo $B2K_SESSION_ID"
	sv_n = "1"
        sv_a = "nohup exebatch -n "+sv_n+" -i AFB120.lst babx4061 $B2K_SESSION_ID ebotz.scr @s"
        sv_r = system(sv_a)
        print(sv_r)	
VAYU:	
	exitscript
trace off
end-->
