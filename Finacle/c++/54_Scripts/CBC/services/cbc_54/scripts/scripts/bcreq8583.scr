#####################################################################################
#   Source Name                 :   bcreq8583.scr
#   Date                        :   05-Apr-2013
#   Description                 :   This script is used to convert the message in ISO-8583 variant
#				    of the DCC to the native variant of ISO 8583 format of Bancs Connect .
#				    It is executed Immediately after receiving the request from the DCC.
#   Input                       :   None
#   Output                      :   None
#   Author                      :   
#   Calling Script              :   None
#   Called Script               :   None
#   Reference                   :
#   Modification History        :
#   <Serial No>  <Date>      <Author>             <Description>
#	1			05-Apr-2013	 Dileep Rajan	  BankId - Uniser allocation
#####################################################################################
<--start
#trace on

call("../scripts","bcreq8583_KE.scr")

GOTO ENDOFSCRIPT


IF ((CDCI.Request8583.Field123=="EAZ") OR (CDCI.Request8583.Field123=="OMK") OR (CDCI.Request8583.Field123=="AIR")) THEN
	IF (FIELDEXISTS(CDCI.Request8583.Field49)) THEN

		if (CDCI.Request8583.Field49=="SSP") then
			CDCI.Request8583.Field102BankId="11"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field49=="RWF") then
			CDCI.Request8583.Field102BankId="50"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field49=="KES") then
			CDCI.Request8583.Field102BankId="54"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field49=="TZS") then
			CDCI.Request8583.Field102BankId="55"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field49=="UGX") then
			CDCI.Request8583.Field102BankId="56"
			print(CDCI.Request8583.Field102BankId)
		endif

		#Changes done by Finacle  Team - 10.2.18  -- Starts here
		
		if (CDCI.Request8583.Field49=="CDF") then
			CDCI.Request8583.Field102BankId="43"
			print(CDCI.Request8583.Field102BankId)
		endif
		
		
		#Calling the bank specific validation
		CDCI.Request8583.Field102BankId= trim(CDCI.Request8583.Field102BankId)
	ELSE
		CDCI.Request8583.Field102BankId="99"
		CDCI.Request8583.Action = "F"
		CDCI.Response8583.Field127 = "Bank Id is null/Invalid Bank Id"
		GOTO ENDOFSCRIPT
	ENDIF
ELSE

	IF (FIELDEXISTS(CDCI.Request8583.Field32)) THEN

		if (CDCI.Request8583.Field32=="005049") then
			CDCI.Request8583.Field102BankId="11"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field32=="000192") then
			CDCI.Request8583.Field102BankId="50"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field32=="000068") then
			CDCI.Request8583.Field102BankId="54"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field32=="000059") then
			CDCI.Request8583.Field102BankId="55"
			print(CDCI.Request8583.Field102BankId)
		endif
		#Changes done by Finacle Team - 10.2.18 -- Starts here
		if (CDCI.Request8583.Field32=="000000") then
			CDCI.Request8583.Field102BankId="43"
			print(CDCI.Request8583.Field102BankId)
		endif

		#Calling the bank specific validation
		CDCI.Request8583.Field102BankId= trim(CDCI.Request8583.Field102BankId)
	ELSE
		CDCI.Request8583.Field102BankId="99"
		CDCI.Request8583.Action = "F"
		CDCI.Response8583.Field127 = "Bank Id is null/Invalid Bank Id"
		GOTO ENDOFSCRIPT
	ENDIF
ENDIF

IF ((CDCI.Request8583.Field102BankId ==  "11") OR (CDCI.Request8583.Field102BankId ==  "50") OR (CDCI.Request8583.Field102BankId ==  "54") OR (CDCI.Request8583.Field102BankId ==  "55") OR (CDCI.Request8583.Field102BankId ==  "56") OR (CDCI.Request8583.Field102BankId == "43")) THEN
#{
	IF(CDCI.Request8583.Field102BankId ==  "11") THEN
	#{ EQUITY BANK SUDAN LTD
		call("../scripts","bcreq8583_SS.scr")
	#}
	ELSE
	#
		IF(CDCI.Request8583.Field102BankId ==  "50") THEN
		#{ Equity Bank Rwanda limited
			call("../scripts","bcreq8583_RW.scr")
		#}
		ELSE
		#{
			IF(CDCI.Request8583.Field102BankId ==  "54") THEN
			#{ Equity Bank limited
				call("../scripts","bcreq8583_KE.scr")
			#}
			ELSE
			#{
				IF(CDCI.Request8583.Field102BankId ==  "55") THEN
				#{ Equity Bank Tanzania Limited
					call("../scripts","bcreq8583_TZ.scr")
				#}
				ELSE
				#{
					IF(CDCI.Request8583.Field102BankId ==  "56") THEN
					#{ EQUITY BANK UGANDA LTD
						call("../scripts","bcreq8583_UG.scr")
					#}
					ELSE 
					#{
							#Changes done by Finacle  Team - 10.2.18  -- Starts here
							
							IF(CDCI.Request8583.Field102BankId ==  "43") THEN
							#{ EQUITY BANK CONGO DRC 
								call("../scripts","bcreq8583_43.scr")
							#}
							ENDIF
							
					#}
					ENDIF
					
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
#}
ELSE
#{
	#Invalid Bank ID
	CDCI.Request8583.Action = "F"
	CDCI.Response8583.Field127 = "Invalid Bank Id"
	GOTO ENDOFSCRIPT
#}
ENDIF


ENDOFSCRIPT:

#trace off
end-->
