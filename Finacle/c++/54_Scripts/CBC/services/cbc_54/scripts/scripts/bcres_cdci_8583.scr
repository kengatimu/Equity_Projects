#####################################################################################
#   Source Name                 :   bcres8583.scr
#   Date                        :   05-Apr-2013
#   Description                 :   It is used to convert the response from CDCI variation of 
#									8583 to vendor specific format 
#   Input                       :   None
#   Output                      :   None
#   Author                      :   
#   Calling Script              :   None
#   Called Script               :   None
#   Reference                   :
#   Modification History        :
#   <Serial No>  <Date>      <Author>             <Description>
#	1			05-Apr-2013	 Dileep Rajan	  BankId - Uniser allocation
#####################################################################################
<--start
#trace on

IF (FIELDEXISTS(CDCI.Response8583.Field3) == 1) THEN
	IF ( CDCI.Response8583.Field3 == "930000" ) THEN
		IF (FIELDEXISTS(CDCI.Response8583.Field48) == 1) THEN
			sv_z=MID$(CDCI.Response8583.Field48,68,17)
			print(sv_z)
			
			IF(sv_z!=0)THEN
				
				IF ( REPEXISTS("CUST") != 1) THEN
					CREATEREP("CUST")
				ENDIF

				IF (CLASSEXISTS("CUST","DATA") != 1) THEN
				      CREATECLASS("CUST","DATA",5)
				ENDIF
				
				CUST.DATA.UserField1=sv_z
				sv_w="."
				sv_p=GETPOSITION(CUST.DATA.UserField1,sv_w)
				sv_r=sv_p-2
				sv_e=MID$(CUST.DATA.UserField1,1,sv_r)
				print(sv_e)
				sv_e=LTRIM(sv_e,'0')
				print(sv_e)
				sv_d=MID$(CUST.DATA.UserField1,sv_p,2)
				print(sv_d)
				sv_j=sv_e+"."+sv_d  
				print(sv_j)
				
				IF(sv_z<0)THEN                                          
						sv_j="-"+sv_j   
						print(sv_j) 				
				ENDIF
			ELSE
				sv_j="00.00"
			ENDIF	
			
			 
			CDCI.Response8583.Field63=sv_j
			
			PRINT(CDCI.Response8583.Field63)
			
			CDCI.Response8583.Field48 = MID$(CDCI.Response8583.Field48,0,68) + MID$(CDCI.Response8583.Field48,0,17) + MID$(CDCI.Response8583.Field48,85,300)
			PRINT(CDCI.Response8583.Field48)
		ENDIF
	ENDIF
ENDIF
 
GOTO ENDOFSCRIPT
# For getting the Sol id and Bank Id from Account Number
IF (FIELDEXISTS(CDCI.Request8583.OrigField102)) THEN
#{
    print(CDCI.Request8583.OrigField102)
	
	CDCI.Request8583.Field102BankId = MID$(CDCI.Request8583.OrigField102,0,11)
	print(CDCI.Request8583.Field102BankId)
	CDCI.Request8583.Field102SolId = MID$(CDCI.Request8583.OrigField102,11,8)
	print(CDCI.Request8583.Field102SolId)
	CDCI.Request8583.Field102AcctNo = MID$(CDCI.Request8583.OrigField102,19,19)
	print(CDCI.Request8583.Field102AcctNo)	
	
	CDCI.Request8583.Field102 = trim(CDCI.Request8583.Field102AcctNo)
	print(CDCI.Request8583.Field102)
	
		
	IF(FIELDEXISTS(CDCI.Request8583.OrigField103)) THEN
	#{
		
		CDCI.Request8583.Field103CC  = MID$(CDCI.Request8583.OrigField103,0,2)
		print(CDCI.Request8583.Field103CC)
		CDCI.Request8583.Field103BankId = MID$(CDCI.Request8583.OrigField103,2,11)
		print(CDCI.Request8583.Field103BankId)
		CDCI.Request8583.Field103SolId = MID$(CDCI.Request8583.OrigField103,13,8)
		print(CDCI.Request8583.Field103SolId)
		CDCI.Request8583.Field103AcctNo = MID$(CDCI.Request8583.OrigField103,21,19)
		print(CDCI.Request8583.Field103AcctNo)	
		
		CDCI.Request8583.Field103 = trim(CDCI.Request8583.Field103AcctNo)
		print(CDCI.Request8583.Field103)

	#}
	ENDIF
	
	# Calling the bank specific validation
	sv_a= trim(CDCI.Request8583.Field102BankId)

	IF ((sv_a ==  "11") OR (sv_a ==  "50") OR (sv_a ==  "54") OR (sv_a ==  "55") OR (sv_a ==  "56")) THEN
	#{
		IF(sv_a ==  "11") THEN
		#{ EQUITY BANK SUDAN LTD
			call("../scripts","bcres8583_SS.scr")
		#}
		ELSE
		#
			IF(sv_a ==  "50") THEN
			#{ Equity Bank Rwanda limited
				call("../scripts","bcres8583_RW.scr")
			#}
			ELSE
			#{
				IF(sv_a ==  "54") THEN
				#{ Equity Bank limited
					call("../scripts","bcres8583_KE.scr")
				#}
				ELSE
				#{
					IF(sv_a ==  "55") THEN
					#{ Equity Bank Tanzania Limited
						call("../scripts","bcres8583_TZ.scr")
					#}
					ELSE
					#{
						IF(sv_a ==  "56") THEN
						#{ EQUITY BANK UGANDA LTD
							call("../scripts","bcres8583_UG.scr")
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		# Printing the field from the entity specific scripts
		print(CDCI.Request8583.Field102)
		#Storing as <SolID>.<BankID>.<AcctNo>
		CDCI.Request8583.Field102Full= trim(CDCI.Request8583.Field102BankId) + "      " + CDCI.Request8583.Field102SolId +"   " + CDCI.Request8583.Field102
		print(CDCI.Request8583.Field102Full)
		CDCI.Response8583.Field102 = CDCI.Request8583.Field102Full
		print(CDCI.Request8583.Field102)

		IF(FIELDEXISTS(CDCI.Request8583.OrigField103)) THEN
		#{
			# Printing the field from the entity specific scripts
			print(CDCI.Request8583.Field103)
			#Storing as <SolID>.<BankID>.<AcctNo>
			CDCI.Request8583.Field103Full= CDCI.Request8583.Field103CC + CDCI.Request8583.Field103SolId +"   "+ trim(CDCI.Request8583.Field103BankId) + "      "  + MID$(CDCI.Request8583.Field103,21,19)
			CDCI.Request8583.Field103 = CDCI.Request8583.Field103Full
			print(CDCI.Request8583.Field103)

		#}
		ENDIF
	#}
	ELSE
	#{
		#Invalid Bank ID
		CDCI.Response8583.Action = "F"
		CDCI.Response8583.Field127 = "Invalid Bank Id"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF

ENDOFSCRIPT:

#trace off
end-->
