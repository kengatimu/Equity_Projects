CDCI.Response8583.successOrFailure="S" 

IF (CDCI.Request8583.Field123 != "BWY") THEN
#{
	IF (FIELDEXISTS(CDCI.Request8583.Field2) == 1) THEN   
	   CDCI.Response8583.Field2 = CDCI.Request8583.Field2
	ENDIF
	#CDCI.Response8583.Field3 = "312000"
	IF (FIELDEXISTS(CDCI.Request8583.Field4) == 1) THEN 
	   CDCI.Response8583.Field4 = RIGHT$(CDCI.Request8583.Field4,12)
	ENDIF
	IF (FIELDEXISTS(CDCI.Request8583.Field11) == 1) THEN 
	   CDCI.Response8583.Field11 = RIGHT$(CDCI.Request8583.Field11,6)
	   #print(CDCI.Response8583.Field11)
	ENDIF
	IF (FIELDEXISTS(CDCI.Request8583.Field125) == 1) THEN 
	   #print(CDCI.Response8583.Field125)
		IF (FIELDEXISTS(CDCI.Request8583.Field4) == 1) THEN 
			CDCI.Response8583.Field4="000000000000"
			#print(CDCI.Response8583.Field4)
			
		ENDIF
		IF (FIELDEXISTS(CDCI.Request8583.Field3) == 1) THEN
			#print(CDCI.Request8583.Field3)
			CDCI.Response8583.Field3="310000"
			#print(CDCI.Response8583.Field3)
		ENDIF	
	ENDIF
	IF (CDCI.Request8583.Field123 == "BRK") THEN
		IF (FIELDEXISTS(CDCI.Request8583.Field3) == 1) THEN
			IF (CDCI.Request8583.Field3=="360000") THEN
				print("Exchange rate exempt")
			ELSE
				IF (FIELDEXISTS(CDCI.Request8583.Field12) == 1) THEN 
				   CDCI.Response8583.Field12 = RIGHT$(CDCI.Request8583.Field12,12)
				   #print(CDCI.Response8583.Field12)
				ENDIF
			ENDIF
		ELSE
			IF (FIELDEXISTS(CDCI.Request8583.Field12) == 1) THEN 
			   CDCI.Response8583.Field12 = RIGHT$(CDCI.Request8583.Field12,12)
			   #print(CDCI.Response8583.Field12)
			ENDIF
		ENDIF
	ELSE
		IF (FIELDEXISTS(CDCI.Request8583.Field12) == 1) THEN 
		   CDCI.Response8583.Field12 = RIGHT$(CDCI.Request8583.Field12,12)
		   #print(CDCI.Response8583.Field12)
		ENDIF
	ENDIF
	IF (FIELDEXISTS(CDCI.Request8583.Field17) == 1) THEN 
	   CDCI.Response8583.Field17 = RIGHT$(LTRIM(RTRIM(CDCI.Request8583.Field17)),4)
	   #print(CDCI.Response8583.Field17)
	ENDIF
	IF (FIELDEXISTS(CDCI.Request8583.Field102) == 1) THEN 
	   CDCI.Response8583.Field102 = RIGHT$(LTRIM(RTRIM(CDCI.Request8583.Field102)),13)
		IF (FIELDEXISTS(CDCI.Request8583.Field2) == 1) THEN
			sv_a = MID$(CDCI.Request8583.Field2,0,6)
			#print(sv_a)
			IF ((sv_a !="627851") AND (sv_a != "447815")) THEN	
				#print ("LORO")
				CDCI.Request8583.Field102=""
				IF (FIELDEXISTS(CDCI.Request8583.Field24) == 1) THEN
					#print(CDCI.Request8583.Field24)  
					IF (CDCI.Request8583.Field24 == "200") THEN	
						CDCI.Request8583.Field24 = "290"
					ENDIF 
					#print(CDCI.Request8583.Field24)
				ENDIF
			ENDIF
			

		ENDIF
	ENDIF
	IF (FIELDEXISTS(CDCI.Request8583.Field103) == 1) THEN 
	   CDCI.Response8583.Field103 = RIGHT$(LTRIM(RTRIM(CDCI.Request8583.Field103)),13)
	ENDIF
	IF (FIELDEXISTS(CDCI.Response8583.Field48) == 1) THEN
		#print (CDCI.Response8583.Field48)

	sv_a = MID$(CDCI.Response8583.Field48,0,1)
	#print (sv_a)
	sv_b = MID$(CDCI.Response8583.Field48,68,1)
	#print (sv_b)

	sv_d= sv_a + MID$(CDCI.Response8583.Field48,6,11)
	sv_e= sv_b + MID$(CDCI.Response8583.Field48,74,11)
	sv_f=sv_d + sv_e 
	#print(sv_d)
	#print(sv_e)
	#print(sv_f)
	IF (CDCI.Request8583.Field123 == "SWT") THEN
		IF (FIELDEXISTS(CDCI.Response8583.Field126) == 1) THEN
		#{
			IF (trim(CDCI.Response8583.Field126) == "CashIn") THEN
				sv_a = MID$(CDCI.Response8583.Field48,102,1)
				print (sv_a)
				sv_b = MID$(CDCI.Response8583.Field48,170,1)
				print (sv_b)

				sv_d= sv_a + MID$(CDCI.Response8583.Field48,108,11)
				sv_e= sv_b + MID$(CDCI.Response8583.Field48,176,11)
				sv_f=sv_d + sv_e 
				print(sv_d)
				print(sv_e)
				print(sv_f)
				CDCI.Response8583.Field48 = sv_f
				print(CDCI.Response8583.Field48)
			ENDIF
		#}
		ENDIF
	ENDIF
	CDCI.Response8583.Field48 = sv_f 
ENDIF

