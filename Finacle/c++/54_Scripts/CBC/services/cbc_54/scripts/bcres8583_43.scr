			#-- Interbank Account
			IF (FIELDEXISTS(CDCI.Response8583.Field125) == 1) THEN
				print(CDCI.Response8583.Field125)
				CDCI.Response8583.Field103 = CDCI.Response8583.Field125
				print(CDCI.Response8583.Field103)
				CDCI.Response8583.Field125=""
			ENDIF
		ENDIF
		IF (CDCI.Request8583.Field126=="P2PInterKSKEN") THEN
			#-- ken Account
			IF (FIELDEXISTS(CDCI.Response8583.Field125) == 1) THEN
				print(CDCI.Response8583.Field125)
				CDCI.Response8583.Field103 = CDCI.Response8583.Field125
				print(CDCI.Response8583.Field103)
				CDCI.Response8583.Field125=""
				CDCI.Response8583.Field3="440000"
				print(CDCI.Response8583.Field3)
				IF (FIELDEXISTS(CDCI.Request8583.Field5) == 1) THEN
					#Print(CDCI.Request8583.Field5)
					CDCI.Response8583.Field4 = CDCI.Request8583.Field5
					#print(CDCI.Response8583.Field4)
				ENDIF
			ENDIF
		ENDIF
		IF (CDCI.Request8583.Field126=="P2PInterKS") THEN
			#-- ken Account
			IF (FIELDEXISTS(CDCI.Response8583.Field125) == 1) THEN
				IF (FIELDEXISTS(CDCI.Response8583.Field125) == 1) THEN
					print(CDCI.Response8583.Field125)
					CDCI.Response8583.Field3="440000"
					print(CDCI.Response8583.Field3)
					CDCI.Response8583.Field103 = CDCI.Response8583.Field125
					print(CDCI.Response8583.Field103)
					CDCI.Response8583.Field125=""
				ENDIF
				IF (FIELDEXISTS(CDCI.Request8583.Field5) == 1) THEN
					#Print(CDCI.Request8583.Field5)
					CDCI.Response8583.Field4 = CDCI.Request8583.Field5
					#print(CDCI.Response8583.Field4)
				ENDIF
			ENDIF
		ENDIF
		
		IF  ((CDCI.Request8583.Field126=="BLOCK") OR (CDCI.Request8583.Field126=="UNBLOCK")) THEN
			IF (FIELDEXISTS(CDCI.Request8583.Field5) == 1) THEN
				#Print(CDCI.Request8583.Field5)
				CDCI.Response8583.Field4 = CDCI.Request8583.Field5
				#print(CDCI.Response8583.Field4)
			ENDIF
		ENDIF
		IF (FIELDEXISTS(CDCI.Response8583.Field126) == 1) THEN
			IF  ((CDCI.Request8583.Field126=="MinStat") OR (CDCI.Request8583.Field126=="BalEnq")) THEN
				CDCI.Response8583.Field4 ="000000000000"
				print(CDCI.Response8583.Field4)
				Print(CDCI.Request8583.Field46)
				print(CDCI.Response8583.Field46)
			ENDIF
		ENDIF
		IF (FIELDEXISTS(CDCI.Request8583.Field126) == 1) THEN
			IF (CDCI.Request8583.Field126=="MinStat") THEN
				CDCI.Response8583.Field4 ="000000000000"
				print(CDCI.Response8583.Field4)
			ENDIF
		ENDIF
	ENDIF
ENDIF
