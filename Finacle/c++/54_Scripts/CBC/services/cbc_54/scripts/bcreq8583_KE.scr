	ENDIF
	IF (FIELDEXISTS(CDCI.Request8583.Field103) == 1) THEN
                sv_a = "  068        " + MID$(CDCI.Request8583.Field103,0,3) + "     "
                CDCI.Request8583.Field103 = sv_a + LTRIM(RTRIM(CDCI.Request8583.Field103))
                print(CDCI.Request8583.Field103)
        ENDIF
ENDIF  



