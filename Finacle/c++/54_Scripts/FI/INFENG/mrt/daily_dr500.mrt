# ******************************************************************
#    Report Name		: IN-HOUSE ZONE INWARD EXEMPTION REPORT
#    Author     		: Erick G. Karobia 
#
# ******************************************************************
#
RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#	
####################################################################
DrawerSolid	stringType
DrawerNum	stringType
DrawerName	stringType
Acc_ClrBAlAmt   NumberType
Acc_Un_clrBalAmt	NumberType
ChqNumber	stringType
ChqAmnt		numberType
PayeeSolid	stringType
####################################################################
LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
page_number         numberType
lv_setid	    stringType  
callscript          stringType
lv_setdesc	    stringType
lv_userId	    stringType 
ipstype		    stringtype
sforacid	    numberType	
tforacid	    numberType	
sclr_bal_amt	    numberType
tclr_bal_amt        numberType
sunclr_bal_amt	    numberType
tunclr_bal_amt        numberType
sinst_amt	    numberType
tinst_amt           numberType

####################################################################
GROUPANDSORT
DrawerSolid
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
 bankName		stringType
 branchName		stringType
###################################################################
REPOSITORY argv4
ipSetId				stringType
ipdate				stringType
####################################################################
IGNORERECORd
####################################################################
#
####################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines   3
linesPerPage       70
leftMargin 	   2 
rightMargin	   2
topMargin	   6
bottomMargin	   2
columnsPerLine 	   145
pageHeaderLines	   8 
pageFooterLines	   2 
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
execute brBankHdg
execute pageHdr
set pagenumber=1
PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
execute pageHdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
separatorline
#
BEFOREBREAKOF DrawerSolid
###################################################################
#BEFOREBREAKOF  
####################################################################
print "Transcations for Branch " column 3
print DrawerSolid 
nexTline
#
#
#
AFTERBREAKOF DrawerSolid
###################################################################
#
#afterbreakof 
####################################################################
nextline
set sforacid = groupcount DrawerNum
set sclr_bal_amt = groupsum Acc_ClrBAlAmt
set sunclr_bal_amt = groupsum Acc_Un_clrBalAmt
set sinst_amt = groupsum ChqAmnt	
separatorline 
print "Sub Total" column 1
print sforacid     column 12
print sclr_bal_amt  column 57
print sunclr_bal_amt    column 73
print sinst_amt  column 99
separatorline
nextline

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute printOneRecord

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
nextline

set tforacid=totalcount DrawerSolid
set tclr_bal_amt = totalsum Acc_ClrBAlAmt
set tunclr_bal_amt = totalsum Acc_Un_clrBalAmt
set tinst_amt = totalsum ChqAmnt

if tforacid = 0
begin
	print "********************   No Records Printed   ****************" size  130 center
	nextline
	nextline
	nextline
end
separatorline
print "Grand Total" column 1
print tforacid     column 12
print tclr_bal_amt  column 57
print tunclr_bal_amt    column 73
print tinst_amt  column 99
separatorline
print "Printed By:" column 1
print lv_userId column 20
nextline
nextline
print "Verified By:"
nextline
separatorline
######################################################################
#  Procedure Block
######################################################################
PROCEDURE pageHdr
separatorline
print "DrawerSolid"  column 1
print "DrawerNum"    column 14
print "DrawerName"    Column 26
print "Balance"      column 57
print "Effects"    column 73
print "ChqNumber"     column 89
print "ChqAmnt" column 99
print "PayeeSolid "    column 115
separatorline

####################################################################
PROCEDURE printOneRecord
####################################################################
print DrawerSolid  column 1
print DrawerNum    column 10
print DrawerName    Column 26
print Acc_ClrBAlAmt      column 57
print Acc_Un_clrBalAmt   column 73
print ChqNumber   column 89
print ChqAmnt column 99
print PayeeSolid    column 115
####################################################################
PROCEDURE brBankHdg

begin
        print "Page No. "   column 100
        print page_number precision 0
        nextline
        print today column 100
        nextline
        nextline
	print "EQUITY BANK LIMITED" size  130 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 130 center
	nextline
	print "IN-HOUSE ZONE INWARD EXEMPTION REPORT"  size 130 center
	nextline
	print "ZONE CODE/DATE:  " column 48
	print "EQBOW INHS" 
	print "/ "
	print ipDate size 10
        nextline
        set page_number= page_number+1
        nextline
end
####################################################################
# End of File
######################################################################


