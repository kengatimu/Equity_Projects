# Template Name :		daily_dr94.mrt
# Description	:		Summary Loan Classification Report
# Author			E.G.KAROBIA, 13-04-2006
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
$$$include monthly_dr94.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT

PAGEFORMAT
#
linesperpage 70
columnsperline 180
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
set total = 0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter != 0)
 separatorline
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
nextline
print "********************End Of Report*********************" column 70

#BEFOREBREAKOF
#
#AFTERBREAKOF 
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
        execute pipe
	print SOL_ID  column 2 
	print NORM   column 11 format "##,###,###,###.##"
	PRINT WATC    column 31  format "##,###,###,###.##"
	print SUBS column 51  format "##,###,###,###.##"
	print DBTL  column 71 format "##,###,###,###.##"
	print LOSS    column 91 format "##,###,###,###.##"
	print TOTAL   column 111 format "##,###,###,###.##"
	print NORM%   column 131 
	print WATC%  column 141 
	print SUBS%    column 151 
	print DBTL%    column 161 
	print LOSS% column 171 
 
 nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "BRANCH"   column 2
	print "NORMAL"   column 15
	PRINT "WATCH"    column 35 
	print "SUBSTANDARD" column 55  
	print "DOUBTFUL"  column 75
	print "LOSS"    column 95
	print "TOTAL"   column 115
	print "NORM%"   column 131
	print "WATCH%"  column 141
	print "SUBS%"    column 151
	print "DBTL%"     column 161
	print "LOSS%" column 171
	separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 65
	nextline
	print branchName column 70
	nextLine
	print "SUMMARY LOANS CLASSISFICATION"  column 64
	nextline
	print " FOR " column 64
	print ipSetId
	nextline
	print "AS AT :" column 64
	print "   "
	print ipFrmDate
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 1
	print "|"   column 9
	PRINT "|"    column 29 
	print "|" column 49  
	print "|"  column 69
	print "|"    column 89
	print "|"   column 109
	print "|"   column 119
	print "|"  column 129
	print "|"    column 139
	print "|"     column 149
	print "|" column 159
	print "|" column 169
	print "|" column 180
	
end


