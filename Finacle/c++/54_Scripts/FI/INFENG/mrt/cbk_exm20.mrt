#********************************************************************************
#    Report Name                        :       cbk_exm20.mrt                   *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    GENERAL REPORT DESCRIPTION                                                 *
#    --------------------------                                                 *
#    Schedule of Savings Accounts                                               *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    MODIFICATION LOG                                                           *
#    ----------------                                                           *
#                                                                               *
#    Sr.no.  Date           Author                 Description                  *
#    ------  --------       ------------           -----------                  *
#    1.0     22-07-2005     P.Senthil kumar        Original Version             *
#                                                                               *
#################################################################################
#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
Acctnumber              stringType
Name                    stringType
balance                 numberType 
status			stringType
accint                  numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
callscript      stringType
lv_setid        stringType
lv_setdesc      stringType
total           numberType
recordcnt       numberType
amountinTho     numberType
amountinTho1    numberType
inttot          numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
#***************************************************************************************
setId           stringType
asondate        stringType
#***************************************************************************************
IGNORERECORD
#**************************************************************************************
if (balance = 0)
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg
set total = 0
set accint = 0
set recordcnt = 0
set amountinTho = 0
set amountinTho1 = 0
set inttot = 0
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   55
columnsperline  115
topMargin        2 
bottomMargin     2 
leftMargin       0
pageheaderlines  4 
pagefooterlines  4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
execute pageHdg
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
separatorline
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
if (status = "D")
begin
print "*" column 20
end
begin
execute pipe
set amountinTho = (balance  / 1000)
set amountinTho1 =(accint / 1000)
set amountinTho1 = roundoff amountinTho1 N 1
print   Acctnumber      column  3       size    16
print   Name            column  23      size    25
print balance column  51      size    20  autocomma precision 2
print accint column  75      size    20  autocomma precision 2
#print   amountinTho     column  51      size    20  autocomma precision 2 
#print   amountinTho1    column  75      size    15  precision 2 
set recordcnt = recordcnt + 1
#set total = total + amountinTho
#set inttot = inttot + amountinTho1
set total = total + balance
set inttot = inttot + accint
end
#**************************************************************************************
#**************************************************************************************
#***************************************************************************************
PROCEDURE pipe

begin
        print "|"               column 1
        print "|"               column 22
        print "|"               column 49
        print "|"               column 74
        print "|"               column 93
        print "|"               column 115

end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
print "EXM2O" column 75
nextline
print "INSTITUTION:  EQUITY BANK LIMITED " column 5
print "DATE:" column 75
print asondate column 80
nextline
nextline
print " BRANCH    :"  column 5
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc size 20
print "(SHS'000')" column  85
nextline
nextline
print "SCHEDULE OF SAVINGS ACCOUNTS" size 105 center
nextline
print "____________________________" size 105 center
nextline
nextline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
separatorline 
print "|" column 1
print "ACCOUNT NUMBER" column 3
print "|" column 22
print "NAME" column 23  center size 25
print "|" column 49
print "BALANCE" column 50 size 20 center
print "|" column 74
print "ACCRUED" column  75 center size 14
print "|" column 93
print "REMARKS" column 95 center size 10
print "|" column 115
nextline
print "|" column 1
print "|" column 22
print "|" column 49
print "|" column 74
print "INTEREST" column 75 center size 14
print "|" column 93
print "|" column 115
nextline
separatorline
end
#****************************************************************************************
#**************************************************************************************
ONENDOFREPORT
#**************************************************************************************
if (recordcnt=0)
begin
        nextline
        print "No Data Found for SOL " column 25
end
begin
separatorline
execute pipe
print "Total :" column 5
print total size 20 column 51 autocomma precision 2 rightjustify
print inttot size 18 column 73 autocomma precision 2 rightjustify 
nextline
separatorline
nextline
#print "* Highlight the dormant accounts" column 5
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:_______________________________________" column 20
nextline
end
nextline
#*******************************************************************************************
