#******************************************************************
#  Report Name        : RATE CHANGES REPORT 
#    Description        : This generates a report on rate changes
#    Driver function    :
#    Author             : Dominic M Karanja
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
foracid			stringtype
schm_code		stringtype
receipt_number		stringtype
deposit_amount		numbertype 
original_maturity_amount	numbertype 
avail_deposit_amt	numbertype 
lchg_user_id		stringtype
lchg_time		stringtype
rcre_user_id		stringtype
rcre_time		stringtype
sol_id			stringtype
##################################################################
##################################################################
LOCALVARIABLES
##################################################################
GROUPANDSORT
##################################################################
#################################################################
REPOSITORY bankRepos.rip
bankName        stringType
branchName      stringtype
##################################################################
IGNORERECORD
##################################################################
if avail_deposit_amt = 0
##################################################################

#MASSAGERECORD
##################################################################

##################################################################
PAGEFORMAT
##################################################################
LinesPerPage           120 
LeftMargin              0
rightMargin             1
Topmargin               3
BottomMargin            2
columnsPerLine         140
pageHeaderLines         10
pageFooterLines         1
##################################################################
ONSTARTOFREPORT
##################################################################
print bankName column 50
nextline
print branchName column 50
nextline
print "P.O BOX 75104 NAIROBI 00200" column 50
nextline
print "RATE CHANGES REPORT" column 50
nextline
print today column 50
nextline
separatorline
print "ACC NUMBER" column 1 size 16
print "|" column 17
print "SCHEME CODE" column 19 size 8 
print "|" column 28
print "RECEIPT NO" column 30 size 9 
print "|" column 40
print "DEPOSIT AMOUNT" column 41 size 20
print "|" column 62
Print "AVAILABLE DEPOSIT AMT" column 63 size 20
print "|" column 84
print "MODIFIED BY" column 85 size 10
print "|" column 96
print "MODIFIED ON" column 97 size 12
print "|" column 110
print "SUPERVISED BY" column 111 size 10
print "|" column 122
print "SUPERVISED ON" column 123 size 15
print "|" column 137
separatorline
nextline
##################################################################
#PAGEHEADER
#################################################################
#execute printPageHdr
##################################################################
ONEVERYRECORD
##################################################################
print foracid column 1 size 16
print "|" column 17
print schm_code column 19 size 8
print "|" column 28
print receipt_number column 29 size 10 
print "|" column 40
print deposit_amount column 41 format "###,###,###.##"
print "|" column 62
print avail_deposit_amt column 63 format "###,###,###.##"    
print "|" column 84
print lchg_user_id column 85 size 10
print "|" column 96
print lchg_time column 97 size 12
print "|" column 110
print rcre_user_id column 111 size 10  
print "|" column 122
print rcre_time column 123 size 12
print "|" column 137
##################################################################
PAGEHEADER
##################################################################
print bankName column 30
nextline
print branchName column 30
nextline
print "P.O BOX 75104 NAIROBI 00200" column 30
nextline
print "RATE CHANGES REPORT" column 30
nextline
print today column 30
nextline
separatorline
print "ACC NUMBER" column 1 size 16
print "|" column 17
print "SCHEME CODE" column 19 size 8
print "|" column 28
print "RECEIPT NO" column 30 size 9
print "|" column 40
print "DEPOSIT AMOUNT" column 41 size 20
print "|" column 62
Print "AVAILABLE DEPOSIT AMT" column 63 size 20
print "|" column 84
print "MODIFIED BY" column 85 size 10
print "|" column 96
print "MODIFIED ON" column 97 size 12
print "|" column 110
print "SUPERVISED BY" column 111 size 10
print "|" column 122
print "SUPERVISED ON" column 123 size 15
print "|" column 137
separatorline
nextline
##################################################################
#AFTERBREAKOF  
##################################################################

#################################################################
#AFTERBREAKOF part_sl_num
#################################################################

#################################################################
PAGEFOOTER
##################################################################
separatorline
print page: column 5
print pagenumber column 20
#################################################################
ONENDOFREPORT
##################################################################
separatorline
print "Printed by" column 20
print "_______________________" column 35
nextline
print "Authorized by" column 20
print "_______________________" column 35  
##################################################################
#PROCEDURE printPageHdr
##################################################################
#################################################################
#PROCEDURE column_header1
##################################################################
