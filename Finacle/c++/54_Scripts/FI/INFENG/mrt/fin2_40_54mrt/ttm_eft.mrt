###############################################################################
RECORDLAYOUT
###############################################################################
var1				stringtype 
var2				stringtype 
var3				stringtype 
clr_bal                         stringtype
foracid                         stringtype
var4				stringtype
var5				stringtype
sol_id				stringtype
ind				stringtype
###############################################################################
LOCALVARIABLES
###############################################################################
crncy				stringtype
sol_lpad			stringtype
for_lpad			stringtype
clr_lpad			stringtype
takataka			stringtype
taka_lp				stringtype
lbal				stringtype
str_clr_bal_cr 			stringtype
str_clr_bal_dr 			stringtype
br_off_acc 			stringtype
off_acc 			stringtype
ho_off_acc 			stringtype
tran_part_1			stringtype
trap_lpad			stringtype
num_clr_bal			numbertype
tran_amt_cr			numbertype 
tran_amt_dr 			numbertype
callscript                                     stringType
lv_foracid                                       stringType
lv_solid					stringType
lv_for_acd					stringType
###############################################################################
GROUPANDSORT
###############################################################################
sol_id 
###############################################################################
###############################################################################

###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine  900
LinesPerPage    500 
LeftMargin       00
RightMargin      00
Topmargin        00
BottomMargin     00
pageHeaderLines  00
pageFooterLines  00
##############################################################################
AFTERBREAKOF sol_id
##############################################################################
execute afterBreakOf
##############################################################################
ONEVERYRECORD
##############################################################################
set lv_foracid = foracid
set lv_solid  = sol_id
set callscript = runscript "oldtonew.scr" "lv_foracid" "lv_solid" "lv_for_acd"
##############################################################################
set num_clr_bal = StrToNum clr_bal
if (ind = "C")
begin
	set tran_amt_cr = tran_amt_cr + num_clr_bal
end

if (ind = "D")
begin
	set tran_amt_dr = tran_amt_dr + num_clr_bal
end

set for_lpad = rpad lv_for_acd 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print ind column 28

set clr_lpad = lpad clr_bal 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 750 " "
print takataka size 750 column 76
##############################################################################
ONSTARTOFREPORT
##############################################################################
set crncy = "KES"
set takataka = " " 
set off_acc = "1100200414"
set ho_off_acc = "0001100200414"
set tran_part_1 = "EFT TRANSFER"
set lbal = "0"
##############################################################################
ONENDOFREPORT
##############################################################################
##############################################################################
PAGEHEADER
##############################################################################
PROCEDURE afterBreakOf 
begin
set str_clr_bal_cr = numToStr tran_amt_cr
set str_clr_bal_dr = numToStr tran_amt_dr
set br_off_acc = StrCat sol_id off_acc

set for_lpad = rpad br_off_acc 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print "D" column 28

set clr_lpad = lpad str_clr_bal_cr 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 750 " "
print takataka size 750 column 76

nextline

set for_lpad = rpad br_off_acc 16 " "
print for_lpad size 16 column 1

print crncy column 17 

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print "C" column 28 

set clr_lpad = lpad str_clr_bal_dr 17 " " 
print clr_lpad size 17 column 29 

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 750 " "
print takataka size 750 column 76

nextline

set for_lpad = rpad br_off_acc 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print "C" column 28

set clr_lpad = lpad str_clr_bal_cr 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 750 " "
print takataka size 750 column 76

nextline

set for_lpad = rpad br_off_acc 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print "D" column 28

set clr_lpad = lpad str_clr_bal_dr 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 750 " "
print takataka size 750 column 76

nextline

set for_lpad = rpad ho_off_acc 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print "D" column 28

set clr_lpad = lpad str_clr_bal_cr 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 750 " "
print takataka size 750 column 76

nextline

set for_lpad = rpad ho_off_acc 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print "C" column 28

set clr_lpad = lpad str_clr_bal_dr 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 750 " "
print takataka size 750 column 76

set tran_amt_cr = 0
set tran_amt_dr = 0

end
