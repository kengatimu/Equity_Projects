#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
acct_name		stringType
acct_bal		numberType
secu_type		stringType
secu_value		numberType
prov_amt		numberType
capital                 numberType  
status			stringType
risk_class		stringType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
total			numberType
core			numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId 		stringtype
asondate	stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg 
set total = 0
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   60 
columnsperline 205
topMargin       2 
bottomMargin     0
leftMargin       0
pageheaderlines 13 
pagefooterlines 4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
set total = acct_bal  
set core = total/capital*100
begin
execute pipe1
print acct_name column 3 size 30
print acct_bal column 36 size 17 autocomma precision 2
print total column  69 size 20 autocomma precision 2  
print secu_type column 91
print secu_value column 104 size 19 autocomma precision 2 
print core column 152 size 10
print status column 166
print risk_class column 184
print prov_amt column 195  
end
#**************************************************************************************
PROCEDURE pageHdg
#***************************************************************************************
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
nextline
print "ADVANCES, BILL DISCOUNTS AND OTHER FACILITIES TO STAFF MEMBERS" column 5
print "FORM CBK/PR4" column 110
nextline
print "SHARE HOLDERS,DIRECTORS AND THEIR ASSOCIATES " column 5 
nextline
nextline
print "Name of Institution:  EQUITY BANK LIMITED " column 5
nextline
nextline
print "Period ending.................................."  column 5
nextline
nextline
print "Core Capital (shs)............................." column 5
nextline
nextline
separatorline
execute pipe
print "NAME OF ACCOUNT" column 5 size 30 center
print "Outstanding Balance" column 40  size 40 center
print "Security" column 113 
print "%age of" column 149 size 13 center
print "Status" column 165  size 13 center
print "Risk" column 183 size 10 center
print "Provisions" column 194
nextline
separatorline
execute pipe1
print "On-Balance" column 37
print "Off-Balance" column 55
print "Total" column 68 size 20 center
print "Nature" column 91
print "Value" column 109
print "Valuer" column 128
print "Date" column 137 size 10 center
print "Outstanding" column 151
print "(Performing/" column 165
print "Class" column 186
print "Made" column 194 size 11 center
nextline
execute pipe1
print "Sheet" column 37
print "Sheet" column 57
print "of" column 138 size 9 center
print "balance to" column 151
print "Non-Performing)" column 165
nextline
execute pipe1
print "Valuation" column 138 size 10 center
print "Core capital" column 151
nextline
separatorline
end
#**************************************************************************************
ONENDOFREPORT
#***************************************************************************************
separatorline
nextline
print "Name of Officer" column 2
nextline
nextline
print "Designation" column 2
nextline
nextline
print "Signature" column 2
print "Date" column 30
#***************************************************************************************
PROCEDURE PIPE
#***************************************************************************************
begin
print "|" column 1
print "|" column 35
print "|" column 89
print "|" column 148
print "|" column 164 
print "|" column 181
print "|" column 193
print "|" column 205
end
#****************************************************************************************
PROCEDURE pipe1
#**************************************************************************************
begin
print "|" column 1
print "|" column 35
print "|" column 54
print "|" column 67
print "|" column 89 
print "|" column 103
print "|" column 123
print "|" column 135
print "|" column 148
print "|" column 164
print "|" column 181
print "|" column 193
print "|" column 205
end
#************************************************************************************
