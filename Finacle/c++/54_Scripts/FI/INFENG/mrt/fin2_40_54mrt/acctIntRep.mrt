#=========================================================================
#	Report Name			: INTEREST REPORT FOR ACCOUNTS
#	Template File Name	: acctIntRep.mrt
#	Description 		: This MRT File will be used to print the report
#						  of Interest for Accounts.
#	Modification log
#	----------------
#	Srl.No.		Date		Author		Description		   Bancs2000 Ver
#	------   ----------     ------      ----------------   --------------
#	1.		 04-12-1998     Vishal		Original version   1.6.37
#=========================================================================
RecordLayout
#=========================================================================
$$$include intRep.mri

#=========================================================================
LOCALVARIABLES
#=========================================================================
	totCrInterestAmt		numberType
	totDrInterestAmt		numberType
	totNumOfAccts 			numberType
	locdailyCompIntFlg  	stringType
	totBookedAmtDr			numberType	
	totAccruedAmtDr			numberType
	method					stringType
	interestLevelToPrint    stringType
#=========================================================================
GROUPANDSORT
#=========================================================================
entityId
interestInd
recInd
interestType
interestLevel

#=========================================================================
REPOSITORY bankRepos.rip readonly
#=========================================================================
	bankName                stringType
	branchName              stringType

#=========================================================================
REPOSITORY argv4
#=========================================================================
	report_to               StringType
	sol_set_id              StringType
	schm_type               StringType
	crncy_code              StringType
	from_acct_num           StringType
	to_acct_num             StringType
	from_gl_sub_head_code   StringType
	to_gl_sub_head_code     StringType
	from_schm_code          StringType
	to_schm_code            StringType
	from_date               StringType
	to_date                 StringType
	from_cust_id            StringType
	to_cust_id              StringType
	dr_cr_int_flg           StringType
	int_type                StringType
	include_closed_acct     StringType
	include_npa_acct        StringType
	include_disabled_acct   StringType
	include_dormant_acct    StringType
	include_frozen_acct     StringType
	include_linked_acct_det StringType
	page_number				numberType

#=========================================================================
PAGEFORMAT
#=========================================================================
	LinesPerPage 64
	LeftMargin 2
	rightMargin 2
	Topmargin   2
	BottomMargin 2
	columnsPerLine 150  
	pageHeaderLines 12
	pageFooterLines 2
	IgnoreBlankRecord

#=========================================================================
ONSTARTOFREPORT
#=========================================================================
	execute commonPageHdr
	nextline
	execute printCriteria
	nextPage
	set pageNumber = 1
	set totNumOfAccts = 0

#=========================================================================
BEFOREBREAKOF entityId
#=========================================================================
	set locdailyCompIntFlg = dailyCompIntFlg
	set totCrInterestAmt = 0.0
	set totDrInterestAmt = 0.0
    begin
		execute printHeaderDetails
	end
	
#=========================================================================
AFTERBREAKOF entityId
#=========================================================================
	nextline
	if( totNumOfAccts != 0)
	begin
		separatorLine
		print "Total CREDIT Interest Amount For " column 2
		print entityId 
		print " from "
		print from_date size 10
		print " to "
		print to_date size 10 
		print " is "
		print totCrInterestAmt autocomma size 19
		nextline
        if (locdailyCompIntFlg = "Y")
        begin
            nextline
            print "DEBIT Interest on Account " column 2
            print entityId
            print " is DAILY COMPOUNDED "
            nextline
        end
		if (locdailyCompIntFlg = "M")
        begin
            nextline
            print "DEBIT Interest on Account " column 2
            print entityId
            print " is MONTHLY COMPOUNDED "
            nextline
        end
		if (locdailyCompIntFlg = "Q")
        begin
            nextline
            print "DEBIT Interest on Account " column 2
            print entityId
            print " is QUARTERLY COMPOUNDED "
            nextline
        end
		print "Total DEBIT Interest Amount For " column 2
		print entityId 
		print " from "
		print from_date size 10
		print " to "
		print to_date size 10 
		print " is "
		print totDrInterestAmt autocomma size 19
		nextline
		print "Advance Interest Amount Collected is" column 2
		print AdvIntAmtColl size 19 column 75 rightJustify
		separatorLine
		nextline
		nextline
	end
	if (totNumOfAccts = 0)
	begin
		print "No Account Selected " column 10
	end
	set locdailyCompIntFlg = "N" 

#=========================================================================
BEFOREBREAKOF recInd
#=========================================================================
#if Adjusment record then print Header 
	if (recInd = "J")
	begin
	nextline
	nextline
	execute adjDetHdr
	end

	if (recInd = "R")
	begin
	nextline
	nextline
	execute adjDetHdr 
	end
#==============================================================================
AFTERBREAKOF interestType
#==============================================================================
if (recInd = "D")
begin
    separatorLine
end
############################################
BEFOREBREAKOF interestType
############################################
if(recInd = "D")
begin
    if(interestType = "0N")
    begin
     nextline
     print "Normal Interest" column 2
    end

    if(interestType = "1P")
    begin
        nextline
        print "Penal Interest" column 2
    end

    if(interestType = "2A")
    begin
        nextline
        print "Additional Interest" column 2
    end

    if(interestType = "3Q")
    begin
        nextline
        print "QIS Interest" column 2
    end

    if(interestType = "4S")
    begin
        nextline
        print "Stock Interest" column 2
    end

    if(interestType = "5O")
    begin
        nextline
        print "Ovdu Interest" column 2
    end

    execute detailHeader
end
#==============================================================================
BEFOREBREAKOF interestLevel
#==============================================================================
set interestLevelToPrint = ""
if(recInd = "D")
begin
    if(interestLevel="A" or interestLevel = "")
    begin
        set interestLevelToPrint = "Acct level"
    end
    if(interestLevel="T")
    begin
        set interestLevelToPrint = "TOD level"
    end
    if(interestLevel="L")
    begin
        set interestLevelToPrint = "Limit level"
    end
end
#=========================================================================
BEFOREBREAKOF interestInd
#=========================================================================
separatorLine
if(interestInd = "D")
begin
	print "*** DEBIT INTEREST REPORT ***"
end
else
begin
	print "*** CREDIT INTEREST REPORT ***"
end
separatorLine
#=========================================================================
PAGEHEADER
#=========================================================================
	execute commonPageHdr
	nextline

#=========================================================================
PAGEFOOTER
#=========================================================================
	print "" size  132 fillAscii 45

#=========================================================================
ONEVERYRECORD
#=========================================================================
	if (interestInd = "C")
		set totCrInterestAmt = totCrInterestAmt + intAmount
	if (interestInd = "D")
		set totDrInterestAmt = totDrInterestAmt + intAmount

	set totNumOfAccts = totNumOfAccts + 1
	if (recInd = "D")
	begin
		execute printDetails
		nextline
	end
	if (recInd = "J")
	begin
		execute printAdjDet
		nextline
	end
	if (recInd = "R")
	begin
		execute printAdjDet
		nextline
	end

#=========================================================================
ONENDOFREPORT
#=========================================================================
	nextline
	nextline
	nextline
	print "***   " column 1
	print pageNumber size 3 column 8 precision 0
	print "PAGES PRINTED. ****END OF REPORT****" size 40 column 12
	set page_number = pageNumber

#=========================================================================
PROCEDURE commonPageHdr
#=========================================================================
	print today     column 1
	print bankName 	column 35 
	print "Page:" column 85
	print pageNumber column 91  precision 0
	nextline
	print branchName column 35 
	nextLine
	nextLine
	print "INTEREST REPORT FOR ACCOUNTS" column 25
	nextline


#=========================================================================
PROCEDURE adjDetHdr
#=========================================================================
	if(recInd = "R")
		begin
		print "Recalc Entries from "
		end
	else
		begin
		print "Adjustment Details from " column 2
		end
	print from_date size 10
	print " to "
	print to_date size 10
	separatorLine
	print "ADJUSTMANT TYPE"		column 2
	print "TRAN ID"				column 20 
	print "TRAN DATE" 			column 33
	print "ADJUSMANT AMOUNT"  	column 51			
	nextline

	if (recInd = "R")
	begin
	print "RECALC REASON"         column 10
	nextline
	end
	separatorLine

#=========================================================================
PROCEDURE printDetails
#=========================================================================
	if(detRecdIntMethod = "D")
	begin
		set Method = "Daily"
	end
	if(detRecdIntMethod = "M")
	begin
		set Method = "Mnthly"
	end
	
	print interestLevelToPrint      column 2
	
#when to print is decided by BEFOREBREAKOF interestLevel
	set interestLevelToPrint = ""

	print startDate	size 10 column 15 
	print endDate	size 10 column 26
	print product	autocomma size 20 column 38
	print fullRate  autocomma size 14 column 60 
	print intAmount	autocomma size 19 column 76 
	nextline
	print intTblCode		column 15 
	print intMethod     	column 21
	print intVersion		column 27 
	print baseDaysInYear	column 33 
	print productForIntRate autocomma size 20	column 38
	print compoundDate		size 10 column 60
	print compoundAmount	autocomma size 20 column 76
	nextline
	
nextline
#=========================================================================
PROCEDURE printAdjDet
#=========================================================================
	if (drCrInd = "C")
	begin 
	print "CREDIT" column 5
	end

	if (drCrInd = "D")
	begin 
	print "DEBIT" column 5
	end

	print tranId column 20
	print tranDate size 10 column 33
	print adjAmount autocomma size 19 column 51
	if(recInd = "R")
	begin
	nextline
	print recalcReason column 5 
	end

#=========================================================================
PROCEDURE printCriteria
#=========================================================================
	nextLine
	nextLine
	separatorLine
	nextline
	nextline
	print   "SELECTION CRITERIA" 			column 20
	nextline
	print   "-------------------" 			column 20
	nextline
	nextline
	print   "Sol Id             : " 	column 10
	print 	sol_set_id						
	nextLine
	print   "Report To          : " 	column 10
	print 	report_to						
	nextLine
	print	"Scheme Type        : "  column 10 
	print schm_type 
	nextLine
	print	"Crncy Code         : "  column 10 
	print crncy_code 
	nextLine
    print   "Acct Range         : "  column 10 
	print from_acct_num 
	print   " To "  column 57 
	print to_acct_num column 61 
	nextLine
	print	"GL Subhead Code    : "  column 10 
	print from_gl_sub_head_code  
	print   " To " 	column 47
	print to_gl_sub_head_code column 52 
	nextLine
	print	"Scheme Code        : "  column 10 
	print from_schm_code 
	print   " To " 	column  47 
	print to_schm_code  column 51 
	nextLine
	print	"Customer Id        : "  column 10 
	print from_cust_id 
	print   " To " 	column 51 
	print to_cust_id  column 56 
	nextLine
	print	"Date Range         : "  column 10 
	print from_date  size 10
	print   " To " 	column  51 
	print to_date  size 10 column 56
	nextLine
	print	"Dr/Cr Indicator    : "  column 10 
	print dr_cr_int_flg
	nextLine
	print	"Interest Type?     : "  column 10 
	print int_type 
	nextLine
	print	"Incl Closed A/c?   : "  column 10 
	print include_closed_acct
	nextLine
	print	"Incl NPA Acct?     : "  column 10 
	print include_npa_acct
	nextLine
	print	"Incl Disabled A/c? : "  column 10 
	print include_disabled_acct 
	nextLine
	print	"Incl Dormant A/c?  : "  column 10 
	print include_dormant_acct
	nextLine
	print	"Incl Frozen A/c?   : "  column 10 
	print include_frozen_acct
	nextLine
	print   "Incl Linked A/c Details? : "  column 10
	print include_linked_acct_det
	nextLine
	separatorLine
#==============================================================================
PROCEDURE printHeaderDetails
#==============================================================================

separatorLine
print "Entity Type       : " column 2
print entityType
print "Entity            : " column 51
print entityId
print "Interest Method   : " column 101
nextline
#The booked/accrued amts/dates are as of prior to this run
print "Booked amt        : " column 2
if(interestInd = "C")
begin
    print acctCrncyCode
    print " "
    print nrml_booked_amount_cr
end
else
begin
    set totBookedAmtDr = nrml_booked_amount_dr + penal_booked_amount_dr + addnl_booked_amount_dr + qis_booked_amount_dr + stock_booked_amount_dr
    print acctCrncyCode
    print " "
    print totBookedAmtDr
#does not include overdue? to be checked
end
print "Last book date    : " column 51
if(interestInd = "C")
begin
    print booked_upto_date_cr
end
else
begin
    print booked_upto_date_dr
end
print "Num Days in Year  : " column 101
if(interestInd = "C")
begin
    print days_in_year_for_int_cr
end
else
begin
    print days_in_year_for_int_dr
end
nextline
print "Accrued amt       : " column 2
if(interestInd = "C")
begin
    print acctCrncyCode
    print " "
    print nrml_accrued_amount_cr
end
else
begin
    set totAccruedAmtDr =  nrml_accrued_amount_dr + penal_accrued_amount_dr + addnl_accrued_amount_dr + qis_accrued_amount_dr + stock_accrued_amount_dr
    print acctCrncyCode
    print " "
    print totAccruedAmtDr
end
print "Last accrued date : " column 51
if(interestInd = "C")
begin
    print accrued_upto_date_cr
end
else
begin
    print accrued_upto_date_dr
end
print "Leap Year adj     : " column 101
if(interestInd = "C")
begin
    print leap_adj_days_for_int_cr
end
else
begin
    print leap_adj_days_for_int_dr
end
nextline
print "Tran Id           : " column 2
print tranId
print "Tran Date         : " column 51
print tranDate
nextline
print "Dr/Cr Interest    : "  column 2
print interestInd
print "Compound freq     : " column 51

if(dailyCompIntFlg = "D")
begin
    print "Daily"
end
else if(dailyCompIntFlg = "M" )
begin
    print "Monthly"
end
else if(dailyCompIntFlg = "Q" )
begin
    print "Quarterly"
end
else
begin
    print "None"
end
separatorLine
nextline
#==============================================================================
PROCEDURE DetailHeader
#==============================================================================
separatorLine
print "Int Level"       column 2
print "From Date"           column 15
print "End date"            column 26
print "   Actual Product"   column 41
print "full rate "          column 68
print "Interest amount"     column 81
nextline

if(recInd = "D")
begin
    print "Int Tbl Code"            column 8
    print "Method"          column 21
    print "Ver."            column 28
    print "Days/Yr"         column 33
    print "   Product for int"  column 40
    print "Compound Date"           column 60
    print "Compound Amount"         column 81
    nextline
end
separatorLine
#============================ End Of File ================================
