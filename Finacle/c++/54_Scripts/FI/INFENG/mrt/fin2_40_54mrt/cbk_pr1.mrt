#***************************************************************************************
#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
cnt		numberType
eabbal		numberType
security	numberType
tranamt		numberType
glbal		numberType
glbal1		numberType
normalcnt               numberType
losscnt                 numberType 
substcnt                numberType 
doubtcnt                numberType  
watchcnt                numberType
prov_amt		numberType
gen_amt			numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
recordcnt		numberType
totalcnt		numberType
normalpcnt		numberType
watchpcnt		numberType
substpcnt		numberType
doubtpcnt		numberType
losspcnt		numberType
totalpcnt		numberType
normalamt		numberType
watchamt		numberType
substamt		numberType
doubtamt		numbertype
lossamt			numberType
totalamt		numberType
normalamtpcnt           numberType
watchamtpcnt            numberType
substamtpcnt            numberType
doubtamtpcnt            numbertype
lossamtpcnt             numberType
totbaddou		numberType
totbaddoupcnt		numberType
totbaddouamt		numberType
totbaddouamtpcnt	numberType
shortfallcnt		numberType
shortfallpcnt		numberType
shortfallamt		numbertype
int_sub			numbertype
s_val			numbertype
int_bad			numbertype
#SPECIFIC PROVISIONS
speprocnt		numberType
speproamt		numberType
#GENERAL PROVISIONS
genprocnt		numberType
genproamt		numberType
#SHORTFALL EXCESS IN (SPECIFIC PROVISIONS)
shortcnt		numberType
shortamt		numberType
#SHORTFALL EXCESS IN GENERAL
shortgencnt		numberType
shortgenamt		numberType
#SHORTFLL EXCESS TOTAL
shorttotcnt		numberType
shorttotamt		numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId 		stringtype
asondate	stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
#execute pageHdg 
set recordcnt  = 0 
set normalcnt  = 0 
set watchcnt   = 0 
set substcnt   = 0  
set doubtcnt   = 0   
set losscnt    = 0  
set totalcnt   = 0  
set normalpcnt = 0
set watchpcnt  = 0
set substpcnt  = 0
set doubtpcnt  = 0
set losspcnt   = 0
set totalpcnt  = 0
set normalamt  = 0
set watchamt   = 0
set substamt   = 0
set doubtamt   = 0
set lossamt    = 0
set totalamt   = 0
set normalamtpcnt = 0         
set watchamtpcnt = 0      
set substamtpcnt = 0    
set doubtamtpcnt = 0   
set lossamtpcnt  = 0
set totbaddou    = 0
set totbaddoupcnt = 0
set totbaddouamt = 0
set totbaddouamtpcnt = 0
set shortfallcnt = 0
set shortfallpcnt = 0
set shortfallamt  = 0
#SPECIFIC PROVISIONS
set speprocnt   = 0 
set speproamt   = 0 
#GENERAL PROVISIONS
set genprocnt  = 0 
set genproamt  = 0
#SHORTFALL EXCESS IN (SPECIFIC PROVISIONS)
set shortcnt   = 0
set shortamt   = 0 
#SHORTFALL EXCESS IN GENERAL
set shortgencnt = 0            
set shortgenamt = 0           
#SHORTFLL EXCESS TOTAL
set shorttotcnt = 0 
set shorttotamt = 0   
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   500 
columnsperline 105
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13 
pagefooterlines 4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
if (cnt = 1)
begin
	set int_sub = int_sub + eabbal
	set s_val = s_val + security
end
if (cnt = 2)
begin
	set int_bad = int_bad + eabbal
	set s_val = s_val + security
end
if (cnt = 3)
begin
set recordcnt  = recordcnt + 1 
set normalamt = eabbal
set watchamt = glbal1 
set substamt = tranamt
set doubtamt = glbal
set lossamt = security
set totalamt = normalamt + watchamt + substamt + doubtamt + lossamt
set totalcnt = normalcnt + losscnt + substcnt + doubtcnt + watchcnt
#TOTAL BAD & DOUBTFUL DEBTS (4+5) 
begin
set totbaddou = doubtcnt + losscnt
set totbaddouamt = doubtamt + lossamt
end
end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
print "FORM CBK/PR1" column 80
nextline
nextline
print "LOANS AND ADVANCES CLASSIFICATION PROVISIONING" column 5
nextline
nextline
print "Name of Institution:  EQUITY BANK LIMITED " column 5 
nextline
nextline
print "Period ending:"  column 5 
print asondate column 22
nextline
nextline
nextline
nextline
separatorline
execute pipe
print "CLASSIFICATION" column 5
print "NUMBER OF" column 40
print "%AGE OF" column 52
print "AMOUNT" column 65 size 20 center
print "%AGE OF" column 94
nextline
execute pipe
print "ACCOUNTS" column 40
print "TOTAL" column 52
print "OUTSTANDING" column 65 size 20 center
print "TOTAL" column 94
nextline
execute pipe
print "SHS'000'" column 65 size 20 center
end
separatorline
#**************************************************************************************
ONENDOFREPORT
#***************************************************************************************
begin
execute pipe
print "1. NORMAL RISK" column 2
print normalcnt column  40 size 10 rightjustify
set normalpcnt = normalcnt/totalcnt * 100
print  normalpcnt column 53 size 6  precision 2
print normalamt column 65 size 20 autocomma precision 2
set normalamtpcnt = normalamt/totalamt * 100
set normalamtpcnt = roundOff normalamtpcnt N 1 
print normalamtpcnt column 90 size 5 precision 2 
nextline
execute pipe
nextline
execute pipe
print "2. WATCH" column 2
print watchcnt column 40 size 10 rightjustify
set watchpcnt = watchcnt/totalcnt * 100
print watchpcnt column 53 size 6 precision 2
print watchamt column 65 size 20 autocomma precision 2
set watchamtpcnt = watchamt/totalamt * 100
print watchamtpcnt column 90 size 5 precision 2 
nextline
execute pipe
nextline
execute pipe
print "3. SUB STANDARD" column 2
print substcnt column 40 size 10 rightjustify
set substpcnt = substcnt/totalcnt * 100
print substpcnt column 53 size 6 precision 2 
print substamt column 65 size 20 autocomma precision 2
set substamtpcnt = substamt/totalamt * 100 
print substamtpcnt column 90  size 5 precision 2 
nextline
execute pipe
nextline
execute pipe
print "4. DOUBTFUL" column 2
print doubtcnt column 40 size 10 rightjustify
set doubtpcnt = doubtcnt/totalcnt * 100 
print doubtpcnt column 53 size 6 precision 2 
print doubtamt column 65 size 20 autocomma precision 2
set doubtamtpcnt = doubtamt/totalamt * 100
print doubtamtpcnt column 90  size 5 precision 2 
nextline
execute pipe
nextline
execute pipe
print "5. LOSS" column 2
print losscnt column 40 size 10 rightjustify
set losspcnt = losscnt/totalcnt * 100
print losspcnt column 53 size 6 precision 2 
print lossamt column 65 size 20 autocomma precision 2
set lossamtpcnt = lossamt/totalamt * 100
print lossamtpcnt column 90 size 5 precision 2 
nextline 
execute pipe
nextline
execute pipe
print "6. TOTAL" column 2
print totalcnt column 40 size 10 rightjustify
print totalamt column 65 size 20 autocomma precision 2
nextline
execute pipe
nextline
execute pipe
print "PROVISIONING" column 10
nextline
execute pipe
nextline
execute pipe
print "7. TOTAL BAD & DOUBTFUL DEBTS (4+5)"  column 2
print totbaddou column 40  size 10 rightjustify 
set totbaddoupcnt = doubtpcnt + losspcnt 
print totbaddoupcnt column 55 size 3
print totbaddouamt column 65 size 20 autocomma precision 2
nextline
execute pipe
nextline
execute pipe
print "8. INTEREST IN SUSPENSE FOR" column 2
print int_sub column 65 size 20 autocomma precision 2 
nextline 
execute pipe
print "SUB-STANDARD ACCOUNTS" column 6 
nextline
execute pipe
nextline
execute pipe
print "9. INTEREST IN SUSPENSE FOR" column 2
print int_bad column 65 size 20 autocomma precision 2
nextline
execute pipe
print "DOUBTFUL AND LOSS ACCOUNTS" column 6 
nextline
execute pipe
nextline
execute pipe
print "10. REALIZABLE VALUE OF SECURITY" column 2
begin
print s_val column 65 size 20 autocomma precision 2
end
nextline
execute pipe
print "FOR DOUBTFUL AND LOSS ACCOUNTS" column 6 
nextline
execute pipe
nextline
execute pipe
print "11. TOTAL SPECIFIC PROVISIONS HELD" column  2
print prov_amt column 65 size 20 autocomma precision 2
nextline 
execute pipe
nextline
execute pipe
print "12. SHORTFALL(EXCESS)IN SPECIFIC" column 2
set shortamt = totbaddouamt - s_val - prov_amt
print shortamt column 65 size 20 autocomma precision 2
nextline
execute pipe
print "PROVISIONS (7-9-10-11)"  column 6 
nextline
execute pipe
nextline
execute pipe
print "13. GENERAL PROVISION REQUIRED" column 2
set shortgenamt = glbal1 + eabbal
set shortgenamt = 0.01 * shortgenamt
print shortgenamt column 65 size 20 autocomma precision 2
nextline
execute pipe
print "1% (1+2)" column 6 
nextline
execute pipe
nextline
execute pipe
print "14. GENERAL PROVISIONS HELD" column 2
print gen_amt column 65 size 20 autocomma precision 2
nextline
execute pipe
nextline 
execute pipe
print "15. SHORTFALL (EXCESS)IN GENERAL" column 2
set shortgenamt = shortgenamt - gen_amt 
print shortgenamt column 65 size 20 autocomma precision 2
nextline
execute pipe
print "PROVISIONS (13-14)" column 6 
nextline
execute pipe
nextline
execute pipe
print "15. SHORTFALL (EXCESS)IN TOTAL" column 2
set shorttotamt = shortamt + shortgenamt
print shorttotamt column 65 size 20 autocomma precision 2
nextline
execute pipe
print "PROVISIONS (12+15)" column 6 
end
separatorline
nextline
if (recordcnt = 0)
begin
    print "NO DATA FOUND FOR SOL-ID: " column 20
end
nextline
print "Name of Officer" column 2
nextline
nextline
print "Designation" column 2
nextline
nextline
print "Signature" column 2
print "Date" column 30 
#***************************************************************************************
PROCEDURE PIPE
#***************************************************************************************
begin
print "|" column 1
print "|" column 38
print "|" column 50
print "|" column 60
print "|" column 85
print "|" column 105
end
