#This is the Mahareport for Branch Profit & Loss Detailed rpt
###############################################################################
RECORDLAYOUT
###############################################################################
acct_name                                    stringtype
fgn_cny                                      numbertype
hom_cny                                      numbertype
gl_sub_head_code                             numbertype
gl_code                                      numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript                                    stringType
lv_setid                                      stringType
lv_setdesc                                    stringType
flag                                           numbertype
flag1                                          numbertype
flag2                                          numbertype
flag3                                          numbertype
flag4                                          numbertype
flag5                                          numbertype
flag6                                          numbertype
flag7                                          numbertype
flag8                                          numbertype
flag9                                          numbertype
flag61						numbertype
flag41						numbertype
total                                           numbertype
grand_total                                     numbertype
inc_tot                                       numbertype
exp_tot						numbertype
incom_tot					 numbertype 
netinc 						numberType
profloss                                        numbertype
################################################################################
GROUPANDSORT
###############################################################################
gl_code,gl_sub_head_code
#**************************************************************************************
#REPOSITORY bankRepos.rip
#*************************************************************************************
#bankName        stringType
#branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
###############################################################################
PAGEFORMAT
##############################################################################
ColumnsPerLine   84
LinesPerPage     60 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "EQUITY BANK LIMITED"  column 1 size 80 center
nextline
nextline
print  "Branch: "   column 33 
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 40 
nextline
nextline
print   "Detailed Profit & Loss"  column 1 size 80 center
nextline
nextline
print asondate column 1 size 80 center
nextline
nextline
separatorline
print "ACCOUNT DESCRIPTION"  column 09
print "LCY BALANCE" column 70
separatorline
set flag  = 0
set flag1 = 0
set flag2 = 0
set flag3 = 0
set flag4 = 0
set flag5 = 0
set flag6 = 0
set flag7 = 0
set flag8 = 0
set flag9 = 0
set flag61 = 0
set flag41 = 0
set total   = 0
set grand_total = 0
end
#############################################################################
ONEVERYRECORD
#############################################################################
begin
if ( gl_code = 1 )
begin
        if (flag1 = 0)
        begin
        print   "Interest Income" column 03
        nextline
        set flag1 = 1
        end
        execute onEveryRecord
end

if (gl_code = 2)
begin
	if (flag2 = 0)
	begin
	separatorline
	print "Totol Interest Income" column 03
	set inc_tot = total
	execute TOTAL
	separatorline
	nextline
	print "Interest Expense" column 03 
	nextline
	set flag2 = 1  
	nextline	
	end
        execute onEveryRecord 	
	end
if (gl_code = 3) 
begin
        if (flag3 = 0)
        begin
	separatorline
        print "Totol Interest Expense" column 03
	set exp_tot = total
 	execute TOTAL
	separatorline
        nextline
	print "Net Interest Income"	column 03
        set netinc = inc_tot + exp_tot	
	print  netinc     column 63 size 20 autocomma precision 2
	nextline
	nextline
        print "Commission Fees" column 03
        nextline
        set flag3 = 1
        nextline
        end
        execute onEveryRecord
        end

if (gl_code = 4)
	begin
       execute onEveryRecord
       end

if (gl_code = 5)
begin
        if (flag5 = 0)
        begin
        nextline
	separatorline
        print "Totol Commission Fees" column 03
	set netinc = netinc + total
        execute TOTAL
        separatorline
        nextline
        print "Other Income" column 03
        nextline
        set flag5 = 1
        nextline
        end
        execute onEveryRecord
        end

if( gl_code = 81 )
        begin
	if ( gl_sub_head_code = 1 )
        begin
	if (flag4 = 0)
	begin
	print "Total Other Income" column 03
	set netinc = netinc + total
        execute TOTAL
        separatorline
        print "Total Income"    column 03 
        print netinc         column 63 size 20 autocomma precision 2
	set grand_total = 0
        separatorline 
	nextline
        print   "Employment Expense"   column 03
        nextline
        set flag4 = 1
        end
        execute onEveryRecord
        end
	end
if( gl_code = 81)
        begin
        if ( gl_sub_head_code = 2 )
        begin
        if ( flag = 0)
        begin
        print   "Total Employment Expnese"                                  column 03
        execute TOTAL
        nextline
        print "Operation Expense" column 03
	nextline
        set flag = 1
        end
        execute onEveryRecord
        end
        end


if( gl_code = 81 )
        begin
	if ( gl_sub_head_code = 3 )
        begin
	if (flag6 = 0)
	begin
        print   "Total Operation  Expense"                      column 03
        execute TOTAL
        print   "Management expense"                         column 03
	nextline
        set flag6 = 1
        end
        execute onEveryRecord
        end
	end
if( gl_code = 81 )
        begin
	if ( gl_sub_head_code = 4 )
        begin
	if (flag61 = 0)
	begin
        print   "Total Management expense "                        column 03  
        execute TOTAL
        print   "Establishment Expense"                         column 03
        nextline
	set flag61 = 1
        end
        execute onEveryRecord
        end
	end

if ( gl_code = 81 )
        begin
	if ( gl_sub_head_code = 81005 ) 
        	begin
		if (flag7 = 0)
		    begin
	        	print   "Total Establishment Expense"           column 03
        		execute TOTAL
        		nextline
        		print   "Marketing Expense"                  column 03
        		nextline
        		set flag7 = 1
        	     end
		     execute onEveryRecord
                 end
	end
if( gl_code = 82 )
        begin
        if (flag41 = 0)
        begin
        print   "Total Marketing Expense"                       column 03
        execute TOTAL
        nextline
        print   "Depreciation Expenses"                         column 03
        nextline
        set flag41 = 1
        end
        execute onEveryRecord
        end

if( gl_code = 83 )
        begin
        if (flag8 = 0)
        begin
        print   "Total Depreciation Expense"            column 03
        execute TOTAL
        nextline
        print   "Provisions"               column 03
        nextline
        set flag8 = 1
        end
        execute onEveryRecord
        end

end



###############################################################################
ONENDOFREPORT
###############################################################################
begin
print "Total Provisions" column 03
print  total column 63 size 20 autocomma precision 2
nextline
print "TOTAL COSTS" column 5
set grand_total = grand_total + total
print  grand_total	column 63 size 20 autocomma precision 2
nextline
nextline
separatorline
print "PROFIT & LOSS" column 5
set profloss = netinc + grand_total
print  profloss column 63 size 20 autocomma precision 2
separatorline
nextline
end
##############################################################################
PROCEDURE onEveryRecord
################################################################################
begin
print  acct_name  column 03
print   hom_cny   column 63 size 20 autocomma precision 2
set total = total + hom_cny
end
###################################################################################
PROCEDURE       TOTAL
###################################################################################
begin
        print  total  column 63 size 20 autocomma precision  2
        set grand_total = grand_total + total
        set total = 0
        nextline
end
##################################################################################
