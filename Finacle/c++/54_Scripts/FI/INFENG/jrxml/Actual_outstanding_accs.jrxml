sql.Timestamp%7::CATOD_AVAILMENT_VIEW%LODGED_USER%CATOD_AVAILMENT_VIEW_LODGED_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%LODGED_DATE%CATOD_AVAILMENT_VIEW_LODGED_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%VERIFIED_USER%CATOD_AVAILMENT_VIEW_VERIFIED_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%VERIFIED_DATE%CATOD_AVAILMENT_VIEW_VERIFIED_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%RCRE_USER%CATOD_AVAILMENT_VIEW_RCRE_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%RCRE_DATE%CATOD_AVAILMENT_VIEW_RCRE_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%LCHG_USER%CATOD_AVAILMENT_VIEW_LCHG_USER%java.lang.String%15::CATOD_AVAILMENT_VIEW%LCHG_DATE%CATOD_AVAILMENT_VIEW_LCHG_DATE%java.sql.Timestamp%7::CATOD_AVAILMENT_VIEW%MSG_IND%CATOD_AVAILMENT_VIEW_MSG_IND%java.lang.String%1::CATOD_AVAILMENT_VIEW%EMAIL_FLG%CATOD_AVAILMENT_VIEW_EMAIL_FLG%java.lang.String%1::CATOD_AVAILMENT_VIEW%SMS_FLG%CATOD_AVAILMENT_VIEW_SMS_FLG%java.lang.String%1::CATOD_AVAILMENT_VIEW%IS_DELETED%CATOD_AVAILMENT_VIEW_IS_DELETED%java.lang.String%1::CATOD_AVAILMENT_VIEW%MAX_LIMIT%CATOD_AVAILMENT_VIEW_MAX_LIMIT%java.math.BigDecimal%22::CATOD_AVAILMENT_VIEW%FREE_TEXT_1%CATOD_AVAILMENT_VIEW_FREE_TEXT_1%java.lang.String%50::|!NULL!|CATOD_AVAILMENT_VIEW%SANCT_ID%CATOD_AVAILMENT_VIEW_SANCT_ID%java.lang.String%16::CATOD_AVAILMENT_VIEW%ACCT_NAME%CATOD_AVAILMENT_VIEW_ACCT_NAME%java.lang.String%80::|!NULL!|CATOD_AVAILMENT_VIEW%SANCT_ID%CATOD_AVAILMENT_VIEW_SANCT_ID%java.lang.String%16::CATOD_AVAILMENT_VIEW%ACCT_NAME%CATOD_AVAILMENT_VIEW_ACCT_NAME%java.lang.String%80::|where%CATOD_AVAILMENT_VIEW.SOL_ID%=%$P{SOL_ID}%Parameter%String::and%CATOD_AVAILMENT_VIEW.GRANT_DATE%=%$P{CREATE_DATE}%Parameter%Date::|SOL_ID%java.lang.String%8%!NULL!%SOL_ID@DBQUERY%PRODUCT!@!SolID_List#@#N%java.lang.String!@!DEFAULT!@!0!@!8%CONSTANT%N%N::CREATE_DATE%java.sql.Timestamp%10%!NULL!%CREATE_DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::|!NULL!|!NULL!|!NULL!|select     CATOD_AVAILMENT_VIEW.SANCT_ID as *CATOD_AVAILMENT_VIEW_SANCT_ID* ,     CATOD_AVAILMENT_VIEW.ACCT_NAME as *CATOD_AVAILMENT_VIEW_ACCT_NAME* from     CUSTOM.CATOD_AVAILMENT_VIEW CATOD_AVAILMENT_VIEW  where    CATOD_AVAILMENT_VIEW.SOL_ID = $P{SOL_ID}     and CATOD_AVAILMENT_VIEW.GRANT_DATE = TO_DATE( CAST ( $P{CREATE_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )|select     CATOD_AVAILMENT_VIEW.SANCT_ID as *CATOD_AVAILMENT_VIEW_SANCT_ID* ,     CATOD_AVAILMENT_VIEW.ACCT_NAME as *CATOD_AVAILMENT_VIEW_ACCT_NAME* from     CUSTOM.CATOD_AVAILMENT_VIEW CATOD_AVAILMENT_VIEW  where    CATOD_AVAILMENT_VIEW.SOL_ID = $P{SOL_ID}     and CATOD_AVAILMENT_VIEW.GRANT_DATE = TO_DATE( CAST ( $P{CREATE_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )|false"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT A.SOL_ID,
  B.ACCT_NUM,
  B.ACCT_NAME,
  A.DISCRET_ADVN_START_DATE TOD_START_DATE,
  A.DISCRET_ADVN_DUE_DATE TOD_DUE_DATE,
  A.DISCRET_ADVN_AMT TOD_AMOUNT,
  A.DISCRET_ADVN_REGLR_IND TOD_STATUS,
  NVL(TO_CHAR(tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE),'DD/MM/YYYY'),'-') REGULARIZATION_DATE ,
  A.REGULARISED_AMT,
  'CATOD' TOD_TYPE,
  B.CREATED_BY,
  A.RCRE_TIME CREATED_TIME ,
  C.CLR_BAL_AMT ACCT_BAL,
  DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(D.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') NO_OF_DAYS_OVERDUE,
  CASE 
    WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(D.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN 0 AND 30
    THEN 'NORMAL'
    WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(D.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  31 AND 90
     THEN 'WATCH'
     WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(D.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  91 AND 180
     THEN 'SUBSTANDARD'
     WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(D.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  181 AND 365
     THEN 'DOUBTFUL'
    ELSE 'LOSS'
  END AS CLASSFICATION,
  TRUNC(D.DB_STAT_DATE) REPORT_AS_ON
FROM CUSTOM.CATOD_AVAILMENT_VIEW B ,
  TBAADM.DAT A,
  TBAADM.GAM C,
  TBAADM.GCT D
WHERE C.ACID                  = A.ACID
AND A.DISCRET_ADVN_START_DATE = B.GRANT_DATE
AND A.DISCRET_ADVN_DUE_DATE   = B.EXPIRY_DATE
AND tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE)IS  NULL
AND A.DISCRET_ADVN_REGLR_IND in ('U')
AND A.FREE_TEXT               = B.FREE_TEXT_1
AND (B.SOL_ID                 = $P{SOL_ID}
OR NVL($P{SOL_ID},'ALL')      ='ALL')                    
AND TRUNC(B.GRANT_DATE)      >= to_date(CAST ( $P{CREATE_DATE} AS VARCHAR(10) ),'DD-MM-YYYY') 

UNION

SELECT A.SOL_ID,
  B.FORACID,
  B.ACCT_NAME,
  A.DISCRET_ADVN_START_DATE TOD_START_DATE,
  A.DISCRET_ADVN_DUE_DATE TOD_DUE_DATE,
  A.DISCRET_ADVN_AMT TOD_AMOUNT,
  A.DISCRET_ADVN_REGLR_IND TOD_STATUS,
  NVL(TO_CHAR(tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE),'DD/MM/YYYY'),'-') REGULARIZATION_DATE ,
  A.REGULARISED_AMT,
  'FINACLE',
  A.RCRE_USER_ID,
  A.RCRE_TIME,
  B.CLR_BAL_AMT,
  DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(C.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') NO_OF_DAYS_OVERDUE,
  CASE 
    WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(C.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN 0 AND 30
    THEN 'NORMAL'
    WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(C.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  31 AND 90
     THEN 'WATCH'
     WHEN DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(C.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  91 AND 180
     THEN 'SUBSTANDARD'
     WHEN   DECODE(A.DISCRET_ADVN_REGLR_IND,'E',(C.DB_STAT_DATE - A.DISCRET_ADVN_DUE_DATE),'0') BETWEEN  181 AND 365
     THEN 'DOUBTFUL'
    ELSE 'LOSS'
  END AS CLASSFICATION,
  C.DB_STAT_DATE
FROM TBAADM.DAT A ,
  TBAADM.GAM B,
  TBAADM.GCT C
WHERE B.ACID                   = A.ACID
AND A.DISCRET_ADVN_START_DATE >= to_date(CAST ( $P{CREATE_DATE} AS VARCHAR(10) ),'DD-MM-YYYY') 
AND (A.SOL_ID                  = $P{SOL_ID}
OR NVL($P{SOL_ID},'ALL')       ='ALL')
AND A.ENTITY_TYPE              = 'TODMN'
AND tod_regularized_date(a.acid,a.DISCRET_ADVN_START_DATE)IS  NULL
AND A.DISCRET_ADVN_REGLR_IND in ('U')
AND A.FREE_TEXT               IS NOT NULL
AND A.FREE_TEXT NOT           IN
  (SELECT FREE_TEXT_1
  FROM CUSTOM.CATOD_AVAILMENT_VIEW
  WHERE GRANT_DATE    >= to_date(CAST ( $P{CREATE_DATE} AS VARCHAR(10) ),'DD-MM-YYYY')
  AND FREE_TEXT_1     IS NOT NULL
  AND (SOL_ID          = $P{SOL_ID}
  OR NVL($P{SOL_ID},'ALL')='ALL')
  )



]]></queryString>

