<--start
TRACE ON
sv_k=""
sv_y=""
sv_w=""

sv_q="custId,entitycreflg,acctBal|"
sv_q = sv_q + " Select foracid,ENTITY_CRE_FLG,BANK_ID from custom.int_change3 where bank_id='54' and ENTITY_CRE_FLG='C' "
print(sv_q)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

if(sv_e==0) then
       sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        sv_q = urhk_dbCursorFetch(sv_m)
        print(sv_q)
        if(sv_q == 1) then
               sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        endif
        print(sv_q)
        while(sv_q==0)
			##################
			# Get account balance as on BOD date.

			sv_a=BANCS.OUTPARAM.custId
			print(sv_a)
			sv_w = sv_a
			print(sv_w)
			sv_c=BANCS.OUTPARAM.entitycreflg
			print(sv_c)
			sv_b=BANCS.OUTPARAM.acctBal
			print(sv_b)

			

			sv_s = "phoneno,phoneemailid|select PHONENO,PHONEEMAILID from crmuser.phoneemail where PHONEOREMAIL='PHONE' and bank_id='54' and PHONENO=?SVAR and rownum<2 "
			BANCS.INPARAM.BINDVARS =  sv_a
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				print(BANCS.OUTPARAM.phoneno)
				print(BANCS.OUTPARAM.phoneemailid)
				sv_r = "000000000000"
				print(sv_r)
				IF (BANCS.OUTPARAM.phoneno!="") THEN
					BANCS.INPARAM.BINDVARS = sv_r + "|" + sv_r + "|" + BANCS.OUTPARAM.phoneno + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.OUTPARAM.phoneno
					print(BANCS.INPARAM.BINDVARS)
					sv_j = "update crmuser.phoneemail set PHONENO =?SVAR ,PHONENOLOCALCODE=?SVAR,USERFIELD1=?SVAR where BanK_id=?SVAR and PHONEOREMAIL='PHONE' and PHONENO=?SVAR "
					sv_w = urhk_dbSQLWithBind(sv_j)
					sv_w = urhk_dbSQLWithBind("COMMIT")
					print(sv_j)
					sv_k="P"
				ELSE
					sv_k="F"
				ENDIF
			ELSE
				sv_k="F"
			ENDIF
			##################
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)
			sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			BANCS.INPARAM.BINDVARS =  sv_h
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				print(BANCS.OUTPARAM.getboddate)
				sv_y = BANCS.OUTPARAM.getboddate
				print(sv_y)

				sv_k="P"
				print(sv_k)
				BANCS.INPARAM.BINDVARS = sv_k + "|" + sv_y + "|" + BANCS.STDIN.contextBankId + "|" + sv_a
				print(BANCS.INPARAM.BINDVARS)
				sv_j = "update  custom.int_change3 set ENTITY_CRE_FLG =?SVAR,ACCT_OPN_DATE=?SVAR where BanK_id=?SVAR and foracid=?SVAR  "
				sv_w = urhk_dbSQLWithBind(sv_j)
				sv_w = urhk_dbSQLWithBind("COMMIT")
				print(sv_j)
			ENDIF

		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
        do
TRACE OFF
EXITSCRIPT

end-->
