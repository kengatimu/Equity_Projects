	#{
		sv_s = "phoneno,trandate,name,FLOW_AMT,foracid,NEXT_DMD_DATE,bank_id |"
		sv_s = sv_s + " SELECT FREE_TEXT_15 ,(select TO_CHAR(db_stat_date, 'DD-Mon-RRRR') as  from tbaadm.gct where bank_id='54') as TRAN_DATE  "
		sv_s = sv_s + " , SUBSTR (LTRIM (GAM.ACCT_NAME),1,INSTR (LTRIM (GAM.ACCT_NAME), ' ') - 1), "
		sv_s = sv_s + " abs(gam.clr_bal_amt),gam.foracid,  "
		sv_s = sv_s + " TO_CHAR(NEXT_DMD_DATE, 'DD-Mon-RRRR'), gam.bank_id  "
		sv_s = sv_s + " FROM TBAADM.lrs,tbaadm.cphone c,tbaadm.gam,tbaadm.gac WHERE lrs.ACID=gam.acid  AND gam.cif_id=c.PHONE_B2KID  "
