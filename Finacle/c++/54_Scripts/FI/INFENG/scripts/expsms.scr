			print(CUST.LADISB.thanks)
			
			CUST.LADISB.massage= CUST.LADISB.Dear + CUST.LADISB.name + CUST.LADISB.repay + CUST.LADISB.FLOW_AMT + CUST.LADISB.repayloan + CUST.LADISB.foracid + CUST.LADISB.repaywill + CUST.LADISB.NEXT_DMD_DATE + CUST.LADISB.thanks
			print(CUST.LADISB.massage)
			
			###################################################################################################
			# Insert into CUSTOM.MOBEE_PUSH_SMS TABLE
			###################################################################################################
			
			sv_s = " insert into  CUSTOM.MOBEE_PUSH_SMS (REF_NO, LANGUAGE, INSTITUTION_CODE, MOBILE_NUMBER, MESSAGE_ARRIEVED_DATE, MESSAGE_PRIORITY,  "
			sv_s = sv_s + " MESSAGE_STATUS, MESSAGE_VALIDITY_PERIOD, DEPARTMENT, MESSAGE_TEXT,retry_count, BANK_ID ) values ( "
			sv_s = sv_s + " CUSTOM.MOBEE_PUSH_SMS_SEQUENCE.nextval,'EN','068', ?SVAR ,?SVAR,'4','0','86400000','Finaexp', ?SVAR,0,?SVAR) "
			print(sv_s)
			BANCS.INPARAM.BINDVARS =  CUST.LADISB.phoneno + "|" + CUST.LADISB.trandate + "|" + CUST.LADISB.massage + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSqlWithBind(sv_s)
