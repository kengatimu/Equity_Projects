		sv_s = sv_s + " AND gac.bank_id='54'  AND GAM.ACCT_CLS_FLG='N' AND lrs.FLOW_ID='EIDEM' AND lrs.LAST_REC_FLG='Y' AND gam.foracid= ?SVAR  AND gam.bank_id= ?SVAR  "
