			CUST.LADISB.massage= CUST.LADISB.repay + CUST.LADISB.merchant + CUST.LADISB.FLOW_AMT + CUST.LADISB.repayloan + CUST.LADISB.FLOW_AMT + CUST.LADISB.repaywill + CUST.LADISB.NEXT_DMD_DATE + CUST.LADISB.thanks + CUST.LADISB.foracid
			print(CUST.LADISB.massage)
			
			###################################################################################################
			# Insert into CUSTOM.MOBEE_PUSH_SMS TABLE
			###################################################################################################
			
			sv_s = " insert into  CUSTOM.MOBEE_PUSH_SMS (REF_NO, LANGUAGE, INSTITUTION_CODE, MOBILE_NUMBER, MESSAGE_ARRIEVED_DATE, MESSAGE_PRIORITY,  "
			sv_s = sv_s + " MESSAGE_STATUS, MESSAGE_VALIDITY_PERIOD, DEPARTMENT, MESSAGE_TEXT,retry_count, BANK_ID ) values ( "
