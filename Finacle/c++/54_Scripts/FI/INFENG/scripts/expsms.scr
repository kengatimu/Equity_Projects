			print(CUST.LADISB.bank_id)
			CUST.LADISB.merchant=BANCS.OUTPARAM.merchant
			print(CUST.LADISB.bank_id)
			
			#CUST.LADISB.Dear="Dear "
			#print(CUST.LADISB.Dear)
