			print(CUST.LADISB.FLOW_AMT)
			CUST.LADISB.NEXT_DMD_DATE=BANCS.OUTPARAM.NEXT_DMD_DATE
			print(CUST.LADISB.NEXT_DMD_DATE)
			CUST.LADISB.bank_id=BANCS.OUTPARAM.bank_id
			print(CUST.LADISB.bank_id)
			
