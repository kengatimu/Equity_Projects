			print(CUST.LADISB.repay)
			CUST.LADISB.repayloan="to finance your Order.You will repay Kshs "
			print(CUST.LADISB.repayloan)
			CUST.LADISB.repaywill=" on "
			print(CUST.LADISB.repaywill)
			CUST.LADISB.thanks=".Your loan A/C is "
