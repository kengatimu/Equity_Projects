#####No of loans to be allocated to each user within a branch

	#CUSTS.BIASH.CasesToAllocate = cint(CUSTS.BIASH.custcount)/cint(CUSTS.BIASH.AcctMgrcount)
	CUSTS.BIASH.CasesToAllocate = CDOUBLE(CUSTS.BIASH.custcount)/CDOUBLE(CUSTS.BIASH.AcctMgrcount)
	print(CUSTS.BIASH.CasesToAllocate)

	IF(CINT(CUSTS.BIASH.CasesToAllocate)>=10) THEN
