####selecting the users	
	sv_y="acctMgr|"
	sv_y = sv_y + " select user_id from tbaadm.upr where home_bank_id = ?SVAR "
	sv_y = sv_y + " and sol_id = ?SVAR and user_work_class = '075'"
	sv_y = sv_y + " and role_id = 'CCL-BB' and del_flg !='Y' "
	print (sv_y)

	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
	print(BANCS.INPARAM.BINDVARS)
	sv_x = urhk_dbCursorOpenWithBind(sv_y)
	print(sv_x)
	IF (sv_x == 0) THEN 
	#{
		CUSTS.BIASH.DbNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUSTS.BIASH.DbNumber)
		sv_m = urhk_dbCursorFetch(CUSTS.BIASH.DbNumber)
		print(sv_m)
		
		IF (sv_m == 1) THEN 
		#{		
			sv_y="acctMgr|"
			sv_y = sv_y + " select user_id from tbaadm.upr where home_bank_id = ?SVAR "
			#sv_y = sv_y + " and sol_id = ?SVAR and user_work_class = '075'"
			sv_y = sv_y + " and sol_id = ?SVAR "
			sv_y = sv_y + " and role_id = 'CAD' and del_flg !='Y' "
			print (sv_y)

			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
			print(BANCS.INPARAM.BINDVARS)
			sv_x = urhk_dbCursorOpenWithBind(sv_y)
			print(sv_x)
			IF (sv_x == 0) THEN 
			#{
				CUSTS.BIASH.DbNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				PRINT(CUSTS.BIASH.DbNumber)
				sv_m = urhk_dbCursorFetch(CUSTS.BIASH.DbNumber)
				print(sv_m)
				
				IF (sv_m == 1) THEN 
				#{		
					sv_y="acctMgr|"
					sv_y = sv_y + " select user_id from tbaadm.upr where home_bank_id = ?SVAR "
					#sv_y = sv_y + " and sol_id = ?SVAR and user_work_class = '075'"
					sv_y = sv_y + " and sol_id = ?SVAR "
					sv_y = sv_y + " and role_id = 'CRM' and del_flg !='Y' "
					print (sv_y)

					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
					print(BANCS.INPARAM.BINDVARS)
					sv_x = urhk_dbCursorOpenWithBind(sv_y)
					print(sv_x)
					IF (sv_x == 0) THEN 
					#{
						CUSTS.BIASH.DbNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
						PRINT(CUSTS.BIASH.DbNumber)
						sv_m = urhk_dbCursorFetch(CUSTS.BIASH.DbNumber)
						print(sv_m)			
				
					#}
					ELSE
					#{
						GOTO CHECK
					#}
					ENDIF
				#}
				ELSE
				#{
					GOTO CHECK
				#}
				ENDIF

			#}
			ENDIF
		#}
		ENDIF
			
		CHECK:
		WHILE (sv_m == 0) 
		#{

			CUSTS.BIASH.acctMgr= BANCS.OUTPARAM.acctMgr
			print(CUSTS.BIASH.acctMgr)



			sv_s="foracid,solid|"
			sv_s = sv_s + " select foracid,sol_id from tbaadm.gam where bank_id = ?SVAR "
			sv_s = sv_s + " and sol_id = ?SVAR "
			sv_s = sv_s + " and schm_code ='LA571'"
			sv_s = sv_s + " and ACCT_CLS_FLG ! = 'Y' "
			sv_s = sv_s + " and ACCT_MGR_USER_ID = 'JT01651' "
			sv_s = sv_s + " and ROWNUM <= ?SVAR"
			print(sv_s)

			#BANCS.INPARAM.BINDVARS =BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId +"|"+ CUSTS.BIASH.currAcctmgr +"|"+ CUSTS.BIASH.CasesToAllocate
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|"  + CUSTS.BIASH.CasesToAllocate
			print(BANCS.INPARAM.BINDVARS)

			sv_c = urhk_dbCursorOpenWithBind(sv_s)
			print(sv_c)

			IF (sv_c==0) then
			#{
				CUSTS.BIASH.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				sv_k = urhk_dbCursorFetch(CUSTS.BIASH.DbcursorNumber)
				print(sv_k)
				sv_q = 0
				WHILE ((sv_k == 0) AND (sv_q <= CUSTS.BIASH.CasesToAllocate))
				#{
					sv_q = sv_q + 1
					print(sv_q)
					CUSTS.BIASH.foracid= BANCS.OUTPARAM.foracid
					print(CUSTS.BIASH.foracid)

			
					#--------------------------------------------------------------------------------------------------------------
					#--------------------------------------------------------------------------------------------------------------
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUSTS.BIASH.foracid)
					PRINT(sv_u)
			
					sv_u = urhk_ExecSrv("SRV_FetchLAAcctDtlForModify|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)

					IF (sv_u == 0) THEN
			
						sv_u = urhk_CopyOutToIn("")
						PRINT(sv_u)
				
						sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.acctMgrAtAcct.userId|" + CUSTS.BIASH.acctMgr)
						PRINT(sv_u)

						sv_u = urhk_ExecSrv("SRV_ModifyLAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
						PRINT(sv_u)

						IF (sv_u == 0) THEN
							print("SUCCESS")
						ENDIF

					ENDIF

					#----------------------------------------------------------------------------------------------------
					# SRV Error check
					#----------------------------------------------------------------------------------------------------
					IF (sv_u != 0) THEN
					#{
						IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
						#{
							print(BANCS.OUTPARAM.Error_num)
							sv_v = BANCS.OUTPARAM.Error_num
						#}									
						ELSE
						#{
							sv_v = 0
						#}
						ENDIF
						IF (sv_v > 0) then
						#{
							sv_u = system("echo 'Error for Acct:"+CUSTS.BIASH.foracid+" ' >>loanMgr.log")
							sv_i = 1
						WHILE (sv_i <= sv_v)
						#{
							sv_f = FORMAT$(sv_i,"%d")
							sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)
							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>loanMgr.log")
							print(sv_u)
						#}
						DO
						#}
						ENDIF
					#}
					ENDIF
			ERROR:
			sv_k = urhk_dbCursorFetch(CUSTS.BIASH.DbcursorNumber)
			print(sv_k)
		
			#}
			DO

			sv_c = urhk_dbCursorClose(CUSTS.BIASH.DbcursorNumber)
			print(sv_c)
		#}
		ENDIF
	
		ERROR1:
		sv_m = urhk_dbCursorFetch(CUSTS.BIASH.DbNumber)
		print(sv_m)
	
		#}
		DO

		sv_g = urhk_dbCursorClose(CUSTS.BIASH.DbNumber)
		print(sv_g)
	#}
	
	ENDIF

