#------------------------------------------------------------------------------------------------
#  Name            : ePayoffVal.scr	 
#  Description     : Script used for validating proxxy records before payoff 	 
#  Date            : 06-07-2021
#  Author          : Edwin Zico
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0              06-07-2021      Edwin Zico         Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

sv_u = REPEXISTS("CUST")
IF (sv_u == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

sv_u = CLASSEXISTS("CUST", "DATA")
IF (sv_u == 0) THEN
#{
	CREATECLASS("CUST", "DATA", 5)
#}
ENDIF



sv_b = urhk_SRV_GetVal("payOffCrit.laAcct.foracid")
print(sv_b)
IF (sv_b == 0) THEN
#{
	CUST.DATA.Laforacid = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.Laforacid)
	#}
ELSE
	#{
	CUST.DATA.errorMsg = "Error in getting value of foracid"
	GOTO ENDOFSCRIPT
#}
ENDIF

sv_b = urhk_getAcctDetailsInRepository(CUST.DATA.Laforacid)
if(sv_b == 0) then
CUST.DATA.acctOpenDate = BANCS.OUTPARAM.acctOpenDate
	print(CUST.DATA.acctOpenDate)
	CUST.DATA.acctOpenDate = mid$(CUST.DATA.acctOpenDate,0,10)
	print(CUST.DATA.acctOpenDate)	
endif

sv_u = urhk_B2k_ForacidToAcid(CUST.DATA.Laforacid)
if(sv_u==0)then
	CUST.DATA.acid = BANCS.OUTPARAM.Acid
endif
sv_s = "originalAmt,offSetAmt|select sum(ORG_TRAN_AMT) orginal ,sum(TOTAL_OFFSET_AMT) offset  from tbaadm.ott where org_acid =?SVAR and tran_date >= to_date (?SVAR,'DD-MM-YYYY') and bank_id =?SVAR"
print(sv_s)
BANCS.INPARAM.BINDVARS = CUST.DATA.acid  + "|" + CUST.DATA.acctOpenDate + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)
sv_h = urhk_dbselectWithBind(sv_s)
PRINT(sv_h)
if(sv_h == 0)then
	CUST.DATA.originalAmt = BANCS.OUTPARAM.originalAmt
	CUST.DATA.offSetAmt = BANCS.OUTPARAM.offSetAmt 	
else
	CUST.DATA.originalAmt = ""
	CUST.DATA.offSetAmt = ""
endif	
#CUST.DATA.offSetAmt ="1"
print(CUST.DATA.offSetAmt)
print(CUST.DATA.originalAmt)
if((CUST.DATA.originalAmt !="") or (CUST.DATA.offSetAmt !=""))then
	if(cdouble(CUST.DATA.offSetAmt) != cdouble(CUST.DATA.originalAmt))then
		sv_u = urhk_SRV_SetErr("PayOff Not allowed !!!Proxxy Amount Exists for the loan acct:" +CUST.DATA.Laforacid)
		BANCS.OUTPUT.successOrFailure = "F"
		exitscript
	endif
endif

TRACE OFF
EXITSCRIPT
END-->
	
