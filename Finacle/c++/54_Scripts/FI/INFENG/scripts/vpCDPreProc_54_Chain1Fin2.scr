<--start
trace on
IF (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1) THEN
        IF (BANCS.INPUT.ReservedField2 == "P2PInterKS") THEN

                #sv_u=urhk_B2k_PrintRepos("BANCS")
                #print(sv_u)
                IF (BANCS.INPUT.Foracid != "")THEN
                        sv_s = "frezCode,acctStatus,schmCode "
                        sv_s = sv_s + " ,acctnamed,solidd,cifid,schmtype | "
                        sv_s = sv_s + " SELECT nvl(trim(GAM.frez_code),'N'),smt.acct_status, "
                        sv_s = sv_s + " GAM.schm_code, gam.acct_name,gam.sol_id,gam.cif_id, gam.schm_type "
                        sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.SMT WHERE GAM.acid = smt.acid "
                        sv_s = sv_s + " AND GAM.foracid = ?SVAR "
                        sv_s = sv_s + " AND GAM.bank_id = SMT.bank_id "
                        sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
                        BANCS.INPARAM.BINDVARS = BANCS.INPUT.Foracid + "|" + BANCS.STDIN.contextBankId
                        print(sv_s)
                        sv_d = urhk_dbSelectWithBind(sv_s)
                        print(sv_d)
                        IF(sv_d == 0) THEN
                                print(BANCS.OUTPARAM.frezCode)
                                print(BANCS.OUTPARAM.acctStatus)
                                print(BANCS.INPUT.Command)
                                print(BANCS.OUTPUT.DccId)
                                CUST.ATM.schmCode = BANCS.OUTPARAM.schmCode
                                print(CUST.ATM.schmCode)
                                print(BANCS.OUTPARAM.acctStatus)
                                CUST.ATM.solid = BANCS.OUTPARAM.solidd
                                print(CUST.ATM.solid)
                                CUST.ATM.acctname = BANCS.OUTPARAM.acctnamed
                                print(CUST.ATM.acctname)
                                CUST.ATM.cifid = BANCS.OUTPARAM.cifid
                                print(CUST.ATM.cifid)
                                CUST.ATM.schmtype = BANCS.OUTPARAM.schmtype
                                print(CUST.ATM.schmtype)

                                IF  ((CUST.ATM.schmtype == "SBA") OR (CUST.ATM.schmtype == "CAA")) THEN
                                        IF (BANCS.OUTPARAM.frezCode == "D") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure = "F"
                                                BANCS.OUTPUT.ReservedField3 = "Frezed Account"
                                                exitscript
                                        ENDIF
                                        IF (BANCS.OUTPARAM.frezCode == "T") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure = "F"
                                                BANCS.OUTPUT.ReservedField3 = "Frezed Account"
                                                exitscript
                                        ENDIF
                                        IF (BANCS.OUTPARAM.acctStatus == "D") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure = "F"
                                                BANCS.OUTPUT.ReservedField3 = "Dormant Account"
                                                exitscript
                                        ENDIF

                                        CUST.ATM.idrt = BANCS.INPUT.Foracid
                                        print(CUST.ATM.idrt)
                                        CUST.ATM.statusrt ="0"
                                        print(CUST.ATM.statusrt)
                                        CUST.ATM.tranamtrt = MID$(BANCS.INPUT.TranAmt,0,14)
                                        print(CUST.ATM.tranamtrt)
                                        CUST.ATM.tranrmksrt = BANCS.INPUT.CardAcceptorName
                                        print(CUST.ATM.tranrmksrt)
                                        sv_s = BANCS.INPUT.ReservedField3
                                        print(sv_s)
                                        sv_u = "waterrefnumc,EslipDetails1c|select substr(?SVAR,1,instr(?SVAR,'/') - 1) ,substr(?SVAR,instr(?SVAR,'/') + 1) from dual "
                                        print(sv_u)
                                        BANCS.INPARAM.BINDVARS= sv_s+"|"+sv_s+"|"+sv_s+"|"+sv_s
                                        sv_w=urhk_dbSelectWithBind(sv_u)
                                        print(sv_w)
                                        CUST.ATM.waterrefnumc = trim(BANCS.OUTPARAM.waterrefnumc)
                                        print(CUST.ATM.waterrefnumc)
                                        CUST.ATM.EslipDetails1c = BANCS.OUTPARAM.EslipDetails1c
                                        print(CUST.ATM.EslipDetails1c)
                                        sv_q = CUST.ATM.EslipDetails1c
                                        print(sv_q)
                                        CUST.ATM.uraamtc = trim(CUST.ATM.EslipDetails1c)
                                        print(CUST.ATM.uraamtc)
                                        sv_z = "RTGS"
                                        print(sv_z)
                                        CUST.ATM.refnumrt = sv_z + CUST.ATM.waterrefnumc
                                        print(CUST.ATM.refnumrt)
                                        CUST.ATM.remarksrt = LTRIM(CUST.ATM.uraamtc,'0')
                                        print(CUST.ATM.remarksrt)
                                        CUST.ATM.tranparticularrt = BANCS.INPUT.CardAcceptorName
                                        print(CUST.ATM.tranparticularrt)
                                        CUST.ATM.BODDate = MID$(BANCS.STDIN.BODDate,0,10)
                                        print(CUST.ATM.BODDate)

                                        sv_s = "INSERT INTO "
                                        sv_s = sv_s + " custom.MICARTGSTABLE "
                                        sv_s = sv_s + "  (ID, STATUS, TRAN_AMT, TRAN_RMKS, REMARKS, REF_NUM, TRAN_PARTICULAR,TRAN_DATE) "
                                        sv_s = sv_s + " values "
                                        sv_s = sv_s + " ( ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR)"
                                        BANCS.INPARAM.BINDVARS = CUST.ATM.idrt + "|" + CUST.ATM.statusrt +"|"+ CUST.ATM.tranamtrt + "|" +CUST.ATM.tranrmksrt + "|"+ CUST.ATM.remarksrt +"|" + CUST.ATM.refnumrt +"|" + CUST.ATM.tranparticularrt +"|" + CUST.ATM.BODDate
                                        print(BANCS.INPARAM.BINDVARS)
                                        print(sv_s)
                                        sv_d = urhk_dbSqlWithBind(sv_s)

                                        IF (sv_d == 0) then
                                        #{
                                                #sv_d = urhk_dbSqlWithBind("COMMIT")
                                                CUST.ATM.SuccessOrFailure = "S"
                                                print(CUST.ATM.SuccessOrFailure)
                                        #}
                                        ENDIF

                                        IF (CUST.ATM.SuccessOrFailure == "S") THEN
                                        #{
                                                        BANCS.OUTPUT.RespCode = "00"
                                                        BANCS.OUTPUT.ReservedField3 = "Good One"
                                                        print(BANCS.OUTPUT.ReservedField3)
                                        #}
                                        ELSE
                                        #{
                                                        BANCS.OUTPUT.RespCode = "99"
                                                        BANCS.OUTPUT.ReservedField3 = "Bad One"
                                                        print(BANCS.OUTPUT.ReservedField3)
                                        #}
                                        ENDIF
                                ELSE
                                        print("Scheme code Not allowed")
                                        BANCS.OUTPUT.RespCode = "99"
                                        BANCS.OUTPUT.successOrFailure = "F"
                                        BANCS.OUTPUT.ReservedField3 = "Scheme code Not allowed"
                                        exitscript
                                ENDIF
                        ENDIF
                ENDIF
        ENDIF
ENDIF

#sv_u=urhk_B2k_PrintRepos("CUST")
#print(sv_u)

sv_a= MID$(BANCS.INPUT.CustCardId,0,6)
print(sv_a)
IF  (BANCS.INPUT.DccId == "SWT")  THEN
        IF ((sv_a != CUST.ATM.custCard1) AND (sv_a !="469636") AND (sv_a !="516229") AND (sv_a !="523523") AND (sv_a !="518819") AND (sv_a !="410382") AND (sv_a !="424145") AND (sv_a !=CUST.ATM.custCard2) AND (sv_a !=CUST.ATM.custCard3) AND (sv_a !=CUST.ATM.custCard4) AND (sv_a !=CUST.ATM.custCard5) OR (mid$(BANCS.INPUT.ReservedField2,0,8)=="VODAFONE") OR (BANCS.INPUT.ReservedField2=="CreditCard") OR (BANCS.INPUT.ReservedField2=="CashIn")) THEN
                print ("Loro")
                #--checking if record exists
                sv_s = "Count "
                sv_s = sv_s + " | "
                sv_s = sv_s + " SELECT COUNT(1) "
                sv_s = sv_s + " FROM CUSTOM.C_SAF_DUP "
                sv_s = sv_s + " WHERE custcardid = ?SVAR "
                sv_s = sv_s + " AND dccid = ?SVAR "
                sv_s = sv_s + " AND foracid= ?SVAR "
                sv_s = sv_s + " AND tranamt= ?SVAR "
                sv_s = sv_s + " AND trancrncy= ?SVAR "
                sv_s = sv_s + " AND deviceid= ?SVAR "
                sv_s = sv_s + " AND reservedfield2= ?SVAR "
                sv_s = sv_s + " AND bank_id = ?SVAR "
                BANCS.INPARAM.BINDVARS = BANCS.INPUT.CustCardId + "|" + BANCS.INPUT.DccId + "|" + BANCS.INPUT.Foracid + "|" + BANCS.INPUT.TranAmt + "|" + BANCS.INPUT.TranCrncy + "|" + BANCS.INPUT.DeviceId + "|" + BANCS.INPUT.ReservedField3 + "|" + BANCS.STDIN.contextBankId
                print(sv_s)
                sv_d = urhk_dbSelectWithBind(sv_s)
                IF ( sv_d != 0 ) then
                        BANCS.OUTPUT.RespCode = "99"
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                ELSE
                        print(BANCS.OUTPARAM.Count)
                        IF (BANCS.OUTPARAM.Count!="0")  then
                                BANCS.OUTPUT.RespCode = "77"
                                print(BANCS.OUTPUT.RespCode)
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        ENDIF
                ENDIF
                IF (BANCS.INPUT.ReservedField2=="CashIn") THEN
                        print(BANCS.INPUT.CrForacid)
                        print(BANCS.INPUT.CrSolId)

                        sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
                        IF (sv_u == 0) then
                                print(BANCS.OUTPARAM.acctSolId)
                                BANCS.INPUT.CrSolId = BANCS.OUTPARAM.acctSolId
                                print(BANCS.INPUT.CrSolId)
                                BANCS.OUTPUT.CrSolId = BANCS.OUTPARAM.acctSolId
                                print(BANCS.OUTPUT.CrSolId)
                        ELSE
                                BANCS.OUTPUT.RespCode = "03"
                                BANCS.OUTPUT.successOrFailure = "F"
                                exitscript
                        ENDIF
                ENDIF
                print(BANCS.INPUT.CrSolId)
                print(BANCS.OUTPUT.CrSolId)

                BANCS.OUTPUT.successOrFailure = "S"
                exitscript
        ENDIF
        IF (BANCS.INPUT.CustCardId == CUST.ATM.custCard6) THEN
                print ("Loro-Cash by code ")
                BANCS.OUTPUT.successOrFailure = "S"
                exitscript
        ENDIF
        IF (mid$(BANCS.INPUT.ReservedField2,0,8)=="VODAFONE") THEN
                print ("M-PESA ATM ")
                BANCS.OUTPUT.successOrFailure = "S"
                exitscript
        ENDIF
ENDIF
IF ((BANCS.INPUT.DccId == "SMS") AND (BANCS.INPUT.ReservedField2 != "CAMPAIGN"))  THEN
        CUST.ATM.Ownership="False"
        print(CUST.ATM.Ownership)
        IF ((BANCS.INPUT.Command=="CDAR") OR (BANCS.INPUT.Command=="CANR")) THEN
                sv_d = BANCS.INPUT.CrForacid
                CUST.ATM.acctnt = BANCS.INPUT.CrForacid
                print(CUST.ATM.acctnt)
        ELSE
                sv_d = BANCS.INPUT.Foracid
                CUST.ATM.acctnt = BANCS.INPUT.Foracid
                print(CUST.ATM.acctnt)
        ENDIF
        #--- Check for ownership
        IF (CUST.ATM.acctnt!=CUST.ATM.account1) THEN
                sv_s = "phoneNumber "
                sv_s = sv_s + " | "
                sv_s = sv_s + " SELECT PHONEEMAIL.Phoneno "
                sv_s = sv_s + " FROM CRMUSER.PHONEEMAIL,TBAADM.GAM "
