        IF ((BANCS.INPUT.ReservedField2!="BulkHD") AND(BANCS.INPUT.ReservedField2!="CAMPAIGN") AND(BANCS.INPUT.ReservedField2!="BulkTR")AND (BANCS.INPUT.ReservedField2!="CashIn") AND (BANCS.INPUT.ReservedField2!="CashOut")AND (BANCS.INPUT.ReservedField2!="SendMoney") AND (BANCS.INPUT.ReservedField2!="WithDrawNon")AND (BANCS.INPUT.ReservedField2!="SendMoneyEx") AND (BANCS.INPUT.ReservedField2!="P2PIntraMerPayBill")) THEN
