IF (BANCS.INPUT.SolId != "") THEN
        print(BANCS.INPUT.SolId)
        print(BANCS.INPUT.Foracid)
        sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
        IF (sv_u != 0) THEN
                BANCS.OUTPUT.RespCode = "03"
                BANCS.OUTPUT.successOrFailure = "F"
                exitscript
        ENDIF

        IF ((BANCS.INPUT.Command !="MSCR") AND (BANCS.INPUT.Command !="FSIR")) THEN
                IF (BANCS.OUTPARAM.acctCloseflg=="Y") THEN
                        BANCS.OUTPUT.RespCode = "84"
                        BANCS.OUTPUT.successOrFailure = "F"
                        exitscript
                ENDIF
        ENDIF
        print(BANCS.INPUT.TranAmt)
        sv_o = BANCS.OUTPARAM.acctSolId
        print(sv_o)
        sv_c = BANCS.OUTPARAM.schmCode
        print(sv_c)
        sv_t = BANCS.OUTPARAM.schmType
        print(sv_t)
        sv_e = BANCS.OUTPARAM.EffAvailableAmt
        print(sv_e)

        #----inculusion for MTI Ministatement Checking for minimum balance

        IF ((BANCS.OUTPUT.DccId=="MTI") AND (BANCS.OUTPUT.Command == "MSIR")) THEN
                IF (sv_c != CUST.ATM.schmCode3 )THEN
                        print("MINI BAL")
                        sv_y = CDOUBLE(BANCS.OUTPUT.TranAmt)/CDOUBLE("100")
                        print(sv_y)
                        IF ( sv_e < sv_y ) THEN
