                sv_S = sv_s + " AND PHONEEMAIL.PhoneEmailType = 'CELLPH' "
                sv_s = sv_s + " AND GAM.foracid = ?SVAR "
                sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
                sv_s = sv_s + " AND GAM.bank_id = PHONEEMAIL.bank_id "
                ##BANCS.INPARAM.BINDVARS = CUST.ATM.schmCode2 + "|" + CUST.ATM.acctnt + "|" + BANCS.STDIN.contextBankId
                BANCS.INPARAM.BINDVARS = CUST.ATM.acctnt + "|" + BANCS.STDIN.contextBankId
                print(BANCS.INPARAM.BINDVARS)
                print(sv_s)
                sv_d = urhk_dbSelectWithBind(sv_s)
                IF ( sv_d != 0 ) then
                        BANCS.OUTPUT.RespCode = "99"
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                ELSE
                #       print(BANCS.OUTPARAM.phoneNumber)
                        IF (BANCS.OUTPARAM.phoneNumber== mid$(BANCS.INPUT.CardAcceptorName,0,12))  then
                                CUST.ATM.Ownership="True"
                                print(CUST.ATM.Ownership)
                        ENDIF
                        CUST.ATM.phn = "0" + mid$(BANCS.INPUT.CardAcceptorName,3,9)
                        print(CUST.ATM.phn)
                        IF (BANCS.OUTPARAM.phoneNumber == CUST.ATM.phn)  then
                                CUST.ATM.Ownership="True"
                                print(CUST.ATM.Ownership)
                        ENDIF
                        IF (CUST.ATM.Ownership=="False")  then
                                BANCS.OUTPUT.RespCode = "99"
                                print(BANCS.OUTPUT.RespCode)
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        ENDIF
                ENDIF
        ENDIF

        IF (BANCS.OUTPUT.ReservedField2=="Insurance") THEN
                print ("Loro")
                #--checking if record exists
                sv_h = mid$(BANCS.STDIN.BODDate,0,10)
                sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
                BANCS.INPARAM.BINDVARS =  sv_h
                sv_d = urhk_dbSelectWithBind(sv_s)
                ##print(sv_d)
                IF (sv_d =="0") THEN
                        CUST.ATM.getboddate = BANCS.OUTPARAM.getboddate
                        print(CUST.ATM.getboddate)
                ENDIF
                sv_s = "Count "
                sv_s = sv_s + " | "
                sv_s = sv_s + " SELECT COUNT(1) "
                sv_s = sv_s + " FROM CUSTOM.C_MPESAEQTYINSU "
                sv_s = sv_s + " WHERE mobilephone = ?SVAR "
                sv_s = sv_s + " AND expiry_date >= ?SVAR "
                sv_s = sv_s + " AND bank_id = ?SVAR "
                BANCS.INPARAM.BINDVARS = MID$(BANCS.INPUT.CardAcceptorName,0,12) + "|" + CUST.ATM.getboddate + "|" + BANCS.STDIN.contextBankId
                print(sv_s)
                sv_d = urhk_dbSelectWithBind(sv_s)
                IF ( sv_d != 0 ) then
                        BANCS.OUTPUT.RespCode = "99"
                        BANCS.OUTPUT.successOrFailure="F"
                        exitscript
                ELSE
                        print(BANCS.OUTPARAM.Count)
                        IF (BANCS.OUTPARAM.Count!="0")  then
                                BANCS.OUTPUT.RespCode = "77"
                                print(BANCS.OUTPUT.RespCode)
                                BANCS.OUTPUT.successOrFailure="F"
                                exitscript
                        ENDIF
                ENDIF
        ENDIF
        IF (BANCS.OUTPUT.ReservedField2=="AUTOTODTXNREQ") THEN
                BANCS.OUTPUT.RespCode = "99"
                BANCS.OUTPUT.successOrFailure="F"
                exitscript
        ENDIF
ENDIF

