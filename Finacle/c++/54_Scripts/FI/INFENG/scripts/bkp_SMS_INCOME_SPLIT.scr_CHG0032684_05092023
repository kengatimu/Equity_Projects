		sv_s = sv_s + " (select foracid  from tbaadm.gam  where bank_id =s.bank_id and gam.sol_id =s.sol_id  and acct_crncy_code ='KES' and bacid = 'EXCISEDUTY') as cr_excise"
		sv_s = sv_s + " from custom.sms_income_split_tbl s "
