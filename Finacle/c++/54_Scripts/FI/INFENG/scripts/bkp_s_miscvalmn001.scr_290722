#---------------------------------------------------------------------------
# check if scheme code field is blank or not.
#---------------------------------------------------------------------------

	IF (CUST.ACCTOPEN.schmCode != "" ) THEN
	#{
		sv_s = "schmtype|SELECT schm_type "
		sv_s = sv_s + "FROM TBAADM.GSP "
		sv_s = sv_s + "WHERE  del_flg ='N' "
		sv_s = sv_s + "AND schm_code=?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR "
		
		BANCS.INPARAM.BINDVARS = CUST.ACCTOPEN.schmCode + "|"  + BANCS.STDIN.contextBankId
		PRINT(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
				
		IF (sv_d == 0) THEN
		#{
			CUST.ACCTOPEN.schmtype = BANCS.OUTPARAM.schmtype
			print(CUST.ACCTOPEN.schmtype)
		#}
		ENDIF
	#}
	ENDIF

	IF ((CUST.ACCTOPEN.schmtype == "LAA") OR (CUST.ACCTOPEN.schmtype == "CLA")) THEN
	#{
		IF(CUST.ACCTOPEN.purpAdv == "") THEN
		#{

			CUST.ACCTOPEN.retMsg = "Purpose of advance field is mandatory"
			CUST.ACCTOPEN.sucFail = "N"
			CUST.ACCTOPEN.fieldId = "purpAdv"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF
		IF(CUST.ACCTOPEN.natAdv == "") THEN
		#{

			CUST.ACCTOPEN.retMsg = "Nature of advance field is mandatory"
			CUST.ACCTOPEN.sucFail = "N"
			CUST.ACCTOPEN.fieldId = "natAdv"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF
		IF(CUST.ACCTOPEN.misFreeText1 == "") THEN
		#{
			CUST.ACCTOPEN.retMsg = "Enter the number of Partners/Lives in Free Text 1 If Partnership"
			CUST.ACCTOPEN.sucFail = "N"
			CUST.ACCTOPEN.fieldId = "misFreeText1"
			GOTO ENDOFSCRIPT	
		#}
		ELSE
		#{
				sv_a = CUST.ACCTOPEN.misFreeText1
				sv_r = urhk_B2k_isStringNumeric(sv_a) 
				IF (sv_r == 1) THEN
				#{		
					CUST.ACCTOPEN.retMsg = "Only numeric values are allowed"
					CUST.ACCTOPEN.sucFail = "N"
					CUST.ACCTOPEN.fieldId = "misFreeText1"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
		#}			
		ENDIF

		IF(CUST.ACCTOPEN.misFreeText2 == "") THEN
		#{
			CUST.ACCTOPEN.retMsg = "Enter (Y-YES / N-NO) in Free Text 2 If Ltd Liability Company by shares and not by gurantee or Society/College/School/Institute/Church loan"
			CUST.ACCTOPEN.sucFail = "N"
			CUST.ACCTOPEN.fieldId = "misFreeText2"
			GOTO ENDOFSCRIPT	
		#}
		ELSE
		#{
			sv_a = CUST.ACCTOPEN.misFreeText2
			IF (( sv_a != "Y" ) AND (sv_a != "N")) THEN
			#{
				CUST.ACCTOPEN.retMsg = "Invalid Code . Valid codes Y-YES or N-NO"
				CUST.ACCTOPEN.sucFail = "N"
				CUST.ACCTOPEN.fieldId = "misFreeText2"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}			
		ENDIF

