#SOLiD 000

	IF(BANCS.STDIN.mySolId==000)THEN
	#{

		#selecting authoriser user id
		sv_s = "authuser" 
		sv_s = sv_s + " |SELECT USER_ID FROM TBAADM.UPR where role_id!='CCL' AND SOL_ID=?SVAR AND ROWNUM=1"
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.mySolId
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		CUSTS.ROLE.authuser=BANCS.OUTPARAM.authuser
		PRINT(CUSTS.ROLE.authuser)

		

		sv_s = "user" 
		sv_s = sv_s + " |SELECT USER_ID FROM TBAADM.UPR where role_id='CCL' AND SOL_ID=?SVAR"
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.mySolId

		sv_v = urhk_dbcursorOpenWithBind(sv_s)
       		PRINT(sv_v)	

		IF(sv_v == 0) THEN
       	 	#{
        		CUSTS.ROLE.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       			print(CUSTS.ROLE.CURSOR_NUMBER)
       			sv_b = urhk_dbCursorFetch(CUSTS.ROLE.CURSOR_NUMBER)
        		print(sv_b)
			BANCS.INPUT.RECCOUNT = CINT("1")
        		print(BANCS.INPUT.RECCOUNT)

			WHILE(sv_b == "0")
        		#{
				CUSTS.ROLE.user= BANCS.OUTPARAM.user
				print(CUSTS.ROLE.user)
				CUSTS.ROLE.authuser=BANCS.OUTPARAM.authuser
				PRINT(CUSTS.ROLE.authuser)

				IF(CUSTS.ROLE.user=="FL07616") THEN
				#{

					sv_u = urhk_SetUrhkInp("usrGenDtl.usrId|" + CUSTS.ROLE.user)
					PRINT(sv_u)

					sv_u = urhk_ExecSrv("SRV_FetchUsrProfileForModify|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)

					IF (sv_u == 0) THEN
					#{
			
						sv_u = urhk_CopyOutToIn("")
						PRINT(sv_u)
				
						sv_u = urhk_SetUrhkInp("usrGenDtl.usrRole.id|" + CUSTS.ROLE.PB)
						PRINT(sv_u)

						sv_u = urhk_SetUrhkInp("usrGenDtl.authUsr.userId|" + CUSTS.ROLE.authuser)
						PRINT(sv_u)


						sv_u = urhk_ExecSrv("SRV_ModifyUsrProfileAndVerify|retain_all_output = Y|same_user_verify = Y")
						PRINT(sv_u)

						IF (sv_u == 0) THEN
						#{
							print("SUCCESS")
						#}
						ENDIF
					#}
					ENDIF

				#}
				ENDIF
		

       				GOTO NEXTREC

      			 	BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
        			PRINT(BANCS.INPUT.RECCOUNT)

        			NEXTREC:
       			 	sv_b = urhk_dbCursorFetch(CUSTS.ROLE.CURSOR_NUMBER)
       				print(sv_b)
				
			#}
			DO


		#}
		ENDIF	
		
				
	#}
	ENDIF

