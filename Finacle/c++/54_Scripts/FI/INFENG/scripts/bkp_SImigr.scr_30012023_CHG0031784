			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}									
				ELSE
				#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) then
				#{
					sv_u = system("echo 'Error '")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						PRINT(sv_f)
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)


						sv_s = "UPDATE CUSTOM.SPIRE_SI"
						sv_s = sv_s + " SET cre_flg  = 'E', FAILURES = ?SVAR  where CIFID= ?SVAR and  REFID2 = ?SVAR "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = sv_e + "|" + CUST.SI.CIFID + "|" + CUST.SI.REFID2
						print(BANCS.INPARAM.BINDVARS)
						sv_h = urhk_dbSQLWithBind(sv_s)
						IF (sv_h == 0) THEN
						#{
							sv_g = urhk_dbSQLWithBind("commit")
							print(sv_g)
						#}
						ENDIF


						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>loanMgr.log")
						print(sv_u)
						GOTO NextRec
						

					#}
					DO
					#}
				ENDIF
			#}
			ENDIF

			NextRec:
			
			sv_k = urhk_dbCursorFetch(CUST.SI.DbcursorNumber)
			print(sv_k)
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUST.SI.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		EXITSCRIPT
		#trace off
END-->

