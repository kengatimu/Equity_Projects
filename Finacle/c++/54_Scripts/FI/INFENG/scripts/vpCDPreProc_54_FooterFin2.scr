#####Customization Added By Charles
IF ((BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "WYM") OR (BANCS.INPUT.DccId == "EBK") OR (BANCS.INPUT.DccId == "SWT") OR (BANCS.INPUT.DccId == "WPD")) THEN
        IF (BANCS.INPUT.Foracid!="") THEN
                print(BANCS.INPUT.Foracid)
                sv_h = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
                print(sv_h)
                IF (sv_h==0) THEN
                        sv_r = REPEXISTS("STDWFS")
                        IF (sv_r == 0) THEN
                                CREATEREP("STDWFS")
                        ENDIF
                        sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
                        IF (sv_r == 0) THEN
                                CREATECLASS("STDWFS", "GLBDATA", 5)
                        ENDIF
                        STDWFS.GLBDATA.solidsh = BANCS.OUTPARAM.acctSolId
                        print(STDWFS.GLBDATA.solidsh)
                        STDWFS.GLBDATA.schmcodesh = BANCS.OUTPARAM.schmCode
                        print(STDWFS.GLBDATA.schmcodesh)
                        STDWFS.GLBDATA.schmType = BANCS.OUTPARAM.schmType
                        print(STDWFS.GLBDATA.schmType)
                        STDWFS.GLBDATA.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
                        print(STDWFS.GLBDATA.EffAvailableAmttr)

                        IF ((STDWFS.GLBDATA.schmcodesh =="SB777") AND (STDWFS.GLBDATA.solidsh=="777")) THEN
                                if (CINT(STDWFS.GLBDATA.EffAvailableAmttr) > 100000) then
                                        print(" am in ")
                                        BANCS.OUTPUT.RespCode = "99"
                                        BANCS.OUTPUT.successOrFailure = "F"
                                        exitscript
                                endif
                                sv_x = "dedit,credit|select (select  sum(tran_amt) from tbaadm.dtd where acid in (select acid from tbaadm.gam where foracid='" + BANCS.INPUT.Foracid + "' and schm_code='SB777' and Bank_id=?SVAR ) and PART_TRAN_TYPE='D' and del_flg='N' and tran_date=(select db_stat_date from tbaadm.gct where DC_ALIAS=?SVAR ) and bank_id=?SVAR) debit ,(select  sum(tran_amt) from tbaadm.dtd where acid in (select acid from tbaadm.gam where foracid='" + BANCS.INPUT.Foracid + "' and schm_code='SB777' and bank_id=?SVAR) and PART_TRAN_TYPE='C' and del_flg='N' and tran_date=(select db_stat_date from tbaadm.gct where DC_ALIAS=?SVAR ) and bank_id=?SVAR) credit  from dual"
                                print(sv_x)
                                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
                                print(sv_x)
                                sv_w = urhk_dbSelectWithBind(sv_x)
                                if (sv_w==0) then
                                        STDWFS.GLBDATA.dedit = cdouble(BANCS.OUTPARAM.dedit)
                                        print(STDWFS.GLBDATA.dedit)
                                        STDWFS.GLBDATA.credit = cdouble(BANCS.OUTPARAM.credit)
                                        print(STDWFS.GLBDATA.credit)
                                        IF (FIELDEXISTS(BANCS.INPUT.TranAmt) == 1) THEN
                                                print(BANCS.OUTPUT.TranAmt)
                                                STDWFS.GLBDATA.dedittr = cdouble(BANCS.INPUT.TranAmt)/cdouble("100")
                                                print(STDWFS.GLBDATA.dedittr)
                                                if (CINT(STDWFS.GLBDATA.dedittr) > 35000) then
                                                        print(" am in ")
                                                        BANCS.OUTPUT.RespCode = "99"
                                                        BANCS.OUTPUT.successOrFailure = "F"
                                                        exitscript
                                                endif
                                                sv_q = "sumamount|select ('" + STDWFS.GLBDATA.dedit + "' + '" + STDWFS.GLBDATA.dedittr + "') from dual "
                                                print(sv_q)
                                                sv_w=urhk_dbSelectWithBind(sv_q)
                                                if (sv_w == 0) then
                                                        print("sumamount")
                                                        STDWFS.GLBDATA.sumamount = cdouble(BANCS.OUTPARAM.sumamount)
                                                        print(STDWFS.GLBDATA.sumamount)
                                                        STDWFS.GLBDATA.sumamount = CINT(STDWFS.GLBDATA.sumamount)
                                                                print(STDWFS.GLBDATA.sumamount)

                                                        if (CINT(STDWFS.GLBDATA.sumamount) > 70000) then
                                                                print(" am in ")
                                                                BANCS.OUTPUT.RespCode = "99"
                                                                BANCS.OUTPUT.successOrFailure = "F"
                                                                exitscript
                                                        endif
                                                endif
                                        ENDIF
                                endif
                        ENDIF
                ELSE
                        BANCS.OUTPUT.RespCode = "03"
                        BANCS.OUTPUT.successOrFailure = "F"
                        exitscript
                ENDIF
        ENDIF
ENDIF

IF (BANCS.INPUT.DccId=="TPG") THEN
        IF (BANCS.INPUT.ReservedField2 =="MPAYBILL") THEN
                sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
                print(sv_u)
                CUST.ATM.acctCrncyCodeeftpg = BANCS.OUTPARAM.acctCrncyCode
                print(CUST.ATM.acctCrncyCodeeftpg)
                IF (CUST.ATM.acctCrncyCodeeftpg!=BANCS.STDIN.homeCrncyCode) THEN
                        CUST.ATM.RateCode ="CDCI_RATE_CODE|TTS"
                        CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
                        print(CUST.ATM.Put)
                        CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
                        IF(CUST.ATM.Get == 0 ) THEN
                                print(BANCS.OUTPARAM.envValue)
                        ENDIF
                ENDIF
        ENDIF
ENDIF

### start stop  pesalink reversal
#IF (BANCS.INPUT.DccId=="TPG") THEN
#       IF (BANCS.INPUT.ReservedField2 =="REMITTANCE") THEN
#               IF (BANCS.INPUT.Command == "TRRR") THEN
#                       IF (BANCS.INPUT.DeviceId=="PESALNK") THEN
#                               CUST.ATM.errMsg =" Pesalink reversal not allowed"
#                               BANCS.OUTPUT.ReservedField3 = CUST.ATM.errMsg
#                               BANCS.OUTPUT.successOrFailure = "F"
#                               BANCS.OUTPUT.RespCode = "99"
#                               exitscript
#                       ENDIF
#               ENDIF
#       ENDIF
#ENDIF
### start stop  pesalink reversal
IF ((BANCS.INPUT.DccId =="EAZ") OR (BANCS.INPUT.DccId=="TPG")) THEN
        IF (BANCS.INPUT.ReservedField2 !="") THEN
                IF ((BANCS.INPUT.ReservedField2=="P2PIntraMerWCB")  OR (BANCS.INPUT.ReservedField2 =="PAYPALWD") OR (BANCS.INPUT.ReservedField2=="P2PIntraMer") OR (BANCS.INPUT.ReservedField2=="P2PIntraMerPayBill") ) THEN
                        sv_t= urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
                        print(sv_t)
                        IF (sv_t == 0) THEN
                                CUST.ATM.solidsh = BANCS.OUTPARAM.acctSolId
                                #print(CUST.ATM.solidsh)
                                CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
                                #print(CUST.ATM.schmcodesh)
                                CUST.ATM.schmType = BANCS.OUTPARAM.schmType
                                print(CUST.ATM.schmType)
                                CUST.ATM.clearBalance = BANCS.OUTPARAM.clearBalance
                                print(CUST.ATM.clearBalance)
                                CUST.ATM.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
                                print(CUST.ATM.EffAvailableAmttr)
                                CUST.ATM.lienAmt = BANCS.OUTPARAM.lienAmt
                                print(CUST.ATM.lienAmt)
                                IF (FIELDEXISTS(BANCS.OUTPUT.StlmntFee)) THEN
                                        #print(BANCS.OUTPUT.StlmntFee)
                                        IF (BANCS.OUTPUT.StlmntFee == "") THEN
                                                CUST.ATM.FeeAmount = "0"
                                        ELSE
                                                CUST.ATM.FeeAmount = mid$(BANCS.OUTPUT.StlmntFee,20,12)
                                                #print(CUST.ATM.FeeAmount)
                                                CUST.ATM.FeeAmount = CDOUBLE(CUST.ATM.FeeAmount)/CDOUBLE("100")
                                                #print(CUST.ATM.FeeAmount)
                                        ENDIF
                                        IF (BANCS.INPUT.DccId=="TPG") THEN
                                                IF (BANCS.INPUT.ReservedField2=="PAYPALWD") THEN
                                                        sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
                                                        print(sv_u)
                                                        CUST.ATM.acctCrncyCodeef = BANCS.OUTPARAM.acctCrncyCode
                                                        print(CUST.ATM.acctCrncyCodeef)
                                                        IF (CUST.ATM.acctCrncyCodeef!=BANCS.INPUT.TranCrncy) THEN
                                                                CUST.ATM.rate_code ="MEAN"
                                                                print(CUST.ATM.rate_code)
                                                                CUST.ATM.from_cncy = BANCS.INPUT.TranCrncy
                                                                print(CUST.ATM.from_cncy)
                                                                CUST.ATM.to_crncy = BANCS.STDIN.homeCrncyCode
                                                                print(CUST.ATM.to_crncy)
                                                                BANCS.INPARAM.BINDVARS =CUST.ATM.from_cncy + "|" + CUST.ATM.to_crncy
                                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.ATM.rate_code + "|" +BANCS.STDIN.contextBankId
                                                                print(BANCS.INPARAM.BINDVARS)
                                                                sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
                                                                sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
                                                                sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
                                                                sv_u = sv_u + " AND RATECODE= ?SVAR "
                                                                sv_u = sv_u + " AND BANK_ID = ?SVAR  and rownum<2 "
                                                                print(sv_u)
                                                                sv_y=urhk_dbSelectWithBind(sv_u)
                                                                print(sv_y)
                                                                IF (sv_y == "0") THEN
                                                                        sv_k = BANCS.OUTPARAM.fxdcrncycode
                                                                        print(sv_k)
                                                                        sv_j = BANCS.OUTPARAM.ratecode
                                                                        print(sv_j)
                                                                        sv_p = BANCS.OUTPARAM.Rate
                                                                        print(sv_p)
                                                                        CUST.ATM.rate = sv_p
                                                                        print(CUST.ATM.rate)
                                                                        sv_x= BANCS.OUTPARAM.treaRate
                                                                        print(sv_x)
                                                                        CUST.ATM.treaRate = sv_x
                                                                        print(CUST.ATM.treaRate)
                                                                        CUST.ATM.fixed_crncy = CUST.ATM.from_cncy
                                                                        print(CUST.ATM.fixed_crncy)
                                                                        CUST.ATM.var_crncy = CUST.ATM.to_crncy
                                                                        print(CUST.ATM.var_crncy)
                                                                        CUST.ATM.diffAmt = cdouble(CUST.ATM.FeeAmount) *  cdouble(CUST.ATM.rate)
                                                                        print(CUST.ATM.diffAmt)
                                                                        CUST.ATM.FeeAmount = CUST.ATM.diffAmt
                                                                        print(CUST.ATM.FeeAmount)
                                                                ENDIF
                                                        ENDIF
                                                ENDIF
                                        ENDIF
                                        IF (CDOUBLE(CUST.ATM.EffAvailableAmttr) < CDOUBLE(CUST.ATM.FeeAmount)) THEN
                                                IF (BANCS.INPUT.DccId =="EAZ") THEN
                                                        IF (CINT(CUST.ATM.lienAmt) > 0)  THEN
                                                                IF ((CINT(CUST.ATM.clearBalance) < 0) OR (CINT(CUST.ATM.clearBalance) ==0) OR (CINT(CUST.ATM.clearBalance) < CINT(CUST.ATM.lienAmt))) THEN
                                                                        IF (FIELDEXISTS(CUST.ATM.FeeAmount)) THEN
                                                                                print(CUST.ATM.FeeAmount)
                                                                                CUST.ATM.FeeAmountabs = CDOUBLE(CUST.ATM.FeeAmount)
                                                                                print(CUST.ATM.FeeAmountabs)
                                                                                CUST.ATM.ReservedField3abs = LTRIM(BANCS.OUTPUT.ReservedField3,'0')
                                                                                print(CUST.ATM.ReservedField3abs)
                                                                                BANCS.INPUT.Fee=""
                                                                                print(BANCS.INPUT.Fee)
                                                                                BANCS.OUTPUT.Fee=""
                                                                                print(BANCS.OUTPUT.Fee)
                                                                                IF (FIELDEXISTS(CUST.ATM.FeeAmountabs)) THEN
                                                                                        print(CUST.ATM.FeeAmountabs)
                                                                                        call("merlimercheapay.scr")
                                                                                ENDIF
                                                                                EXITSCRIPT
                                                                        ENDIF
                                                                ENDIF
                                                        ENDIF
                                                ENDIF
                                                call("copyBancsToCustC24.scr")
                                                call("feesadd01.scr")
                                                call("copyCust24ToBancs.scr")
                                        ENDIF
                                ENDIF
                        ENDIF
                ENDIF
        ENDIF
ENDIF
IF (BANCS.INPUT.DccId =="POL")  THEN
        IF (BANCS.INPUT.ReservedField2 !="") THEN
                IF (BANCS.INPUT.ReservedField2 =="EAZYBIZCHRG") THEN
                        sv_t= urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
                        print(sv_t)
                        IF (sv_t == 0) THEN
                                CUST.ATM.solidsh = BANCS.OUTPARAM.acctSolId
                                #print(CUST.ATM.solidsh)
                                CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
                                #print(CUST.ATM.schmcodesh)
                                CUST.ATM.schmType = BANCS.OUTPARAM.schmType
                                print(CUST.ATM.schmType)
                                CUST.ATM.clearBalance = BANCS.OUTPARAM.clearBalance
                                print(CUST.ATM.clearBalance)
                                CUST.ATM.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
                                print(CUST.ATM.EffAvailableAmttr)
                                CUST.ATM.lienAmt = BANCS.OUTPARAM.lienAmt
                                print(CUST.ATM.lienAmt)
                                CUST.ATM.FeeAmount = CDOUBLE(BANCS.OUTPUT.TranAmt)/CDOUBLE("100")
                                print(CUST.ATM.FeeAmount)
                                IF (FIELDEXISTS(CUST.ATM.FeeAmount)) THEN
                                        call("copyBancsToCustC24.scr")
                                        call("feesadd01pol.scr")
                                        call("copyCust24ToBancs.scr")
                                        IF (FIELDEXISTS(CUST.ATM.Sucessfail1)) THEN
                                                IF (CUST.ATM.Sucessfail1=="N") THEN
                                                        CUST.ATM.errMsg ="Check Data and Account "
                                                        BANCS.OUTPUT.ReservedField3 = CUST.ATM.errMsg
                                                         BANCS.OUTPUT.successOrFailure = "F"
                                                         BANCS.OUTPUT.RespCode = "99"
                                                         exitscript
                                                ENDIF
                                        ENDIF
                                ENDIF
                        ENDIF
                ENDIF
        ENDIF
ENDIF
#++++++++++++Recycler Double Deposit
if(fieldexists(BANCS.INPUT.DccId)==1)then
if(fieldexists(BANCS.INPUT.Command)==1)then
        if(fieldexists(BANCS.INPUT.Foracid)==1)then
                print(BANCS.INPUT.Foracid)
        else
                BANCS.INPUT.Foracid = ""
        endif
        if((BANCS.INPUT.DccId=="SWT")and(BANCS.INPUT.Command=="CDAR")and(BANCS.INPUT.Foracid=="0001300501773"))then
                CUST.ATM.errMsg = "Transaction Not Allowed"
        endif
endif
endif


#trace off
ENDOFSCRIPT:
IF(CUST.ATM.errMsg != "" ) THEN
#{
        print(CUST.ATM.errMsg)
        BANCS.OUTPUT.successOrFailure = "F"
        BANCS.OUTPUT.RespCode = "99"
#}
ENDIF

exitscript
