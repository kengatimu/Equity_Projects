IF (BANCS.INPUT.DccId == "POL") THEN
        IF (BANCS.OUTPUT.ReservedField2=="EAZYBIZFOREX") THEN
                CUST.ATM.RateCode="CRC"
                IF (FIELDEXISTS(BANCS.OUTPUT.DeviceId) == 1) THEN
                        CUST.ATM.RateCode=BANCS.OUTPUT.DeviceId
                        print(CUST.ATM.RateCode)
                        CUST.ATM.RateCode ="CDCI_RATE_CODE|" + CUST.ATM.RateCode
                        CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
                        print(CUST.ATM.Put)
                        CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
                        IF (CUST.ATM.Get == 0 ) THEN
                                print(BANCS.OUTPARAM.envValue)
                        ENDIF
                ENDIF
        ENDIF
ENDIF

IF ((BANCS.INPUT.DccId == "SWT")  AND  (BANCS.INPUT.Command =="BLIR")) THEN
        #sv_u=urhk_B2k_PrintRepos("BANCS")

        sv_c = CUST.ATM.acctnt
        print(sv_c)

        sv_s = "msg "
        sv_s = sv_s + " | "
        sv_s = sv_s + " SELECT CUSTOM.get_acct_status(?SVAR,?SVAR)  "
        sv_s = sv_s + " FROM DUAL"
        BANCS.INPARAM.BINDVARS = sv_c + "|" + BANCS.STDIN.contextBankId
        print(sv_s)
        sv_d = urhk_dbSelectWithBind(sv_s)
        sv_w = BANCS.OUTPARAM.msg
        print(sv_w)
print("54")

        BANCS.INPARAM.BINDVARS = "HI"
        print(BANCS.INPARAM.BINDVARS)

        if ( sv_w == "SUCCESS" ) then
                print(BANCS.INPARAM.BINDVARS)
                sv_q = sv_c + "|" + BANCS.STDIN.contextBankId
                print(sv_q)
                sv_t = "msg|SELECT CUSTOM.CHK_CONTRACT(?SVAR,'01',?SVAR) FROM DUAL"
                print(sv_t)
                BANCS.INPARAM.BINDVARS = sv_c +"|"+ BANCS.STDIN.contextBankId
                sv_e = urhk_dbSelectWithBind(sv_t)
                sv_m = BANCS.OUTPARAM.msg
                print(sv_m)
                #sv_m = "TEST"

                sv_t = "message,todbal|select substr(?SVAR,1,instr(?SVAR,'.') - 1) message,substr(?SVAR,instr(?SVAR,'.') + 1) todbal from dual "
                BANCS.INPARAM.BINDVARS = sv_m + "|" + sv_m + "|" + sv_m + "|" + sv_m
                sv_y = urhk_dbSelectWithBind(sv_t)
                print(sv_y)
                IF (sv_y =="0") THEN
                        CUST.ATM.message = BANCS.OUTPARAM.message
                        print(CUST.ATM.message)
                        CUST.ATM.todbal = BANCS.OUTPARAM.todbal
                        print(CUST.ATM.todbal)

               # Check the TOD amount available for the customer
                #---------------------------------------------------------
                BANCS.INPUT.acctId = CUST.ATM.acctnt
                CUST.ATM.acctstat=""
                CUST.ATM.todamt=""
                CUST.ATM.todAcctStatus = ""
                CALL("catod_contract_ATM.scr")
                print(CUST.ATM.acctstat)
                print(CUST.ATM.todamt)
                print(CUST.ATM.todAcctStatus)
                CUST.ATM.todbal = CUST.ATM.todamt


                        IF (CUST.ATM.todbal=="") THEN
                                CUST.ATM.todbal="00000000000"
                                print(CUST.ATM.todbal)
                        ELSE
                                CUST.ATM.todbal = CUST.ATM.todbal
                                print(CUST.ATM.todbal)
                        ENDIF

                        BANCS.INPUT.ReservedField3 = CUST.ATM.todbal
                                print(BANCS.INPUT.ReservedField3)
                        BANCS.OUTPUT.ReservedField3 = BANCS.INPUT.ReservedField3
                                print(BANCS.OUTPUT.ReservedField3)

                        IF  (BANCS.OUTPUT.ReservedField3==" NEW TOD ARE NOT ALLOWED") THEN
                                BANCS.INPUT.ReservedField3 = "00000000000"
                                print(BANCS.INPUT.ReservedField3)
                                BANCS.OUTPUT.ReservedField3 = BANCS.INPUT.ReservedField3
                                print(BANCS.OUTPUT.ReservedField3)
                        ELSE
                                sv_s=BANCS.OUTPUT.ReservedField3
                                sv_x = "todbal1|SELECT (?SVAR*100) from dual "
                                BANCS.INPARAM.BINDVARS = sv_s
                                print(sv_x)
                                sv_t = urhk_dbSelectWithBind(sv_x)
                                sv_w = BANCS.OUTPARAM.todbal1
                                print(sv_w)

                                sv_t = "todbal2|SELECT lpad(?SVAR,11,'0') from dual "
                                BANCS.INPARAM.BINDVARS = sv_w
                                print(sv_t)
                                sv_t = urhk_dbSelectWithBind(sv_t)
                                sv_p = BANCS.OUTPARAM.todbal2
                                print(sv_p)
                                BANCS.OUTPUT.ReservedField3=sv_p
                                print(BANCS.OUTPUT.ReservedField3)
                        ENDIF
                ENDIF
                        BANCS.INPUT.ReservedField3 = "00000000000"
                        print(BANCS.INPUT.ReservedField3)
                        BANCS.OUTPUT.ReservedField3 = BANCS.INPUT.ReservedField3
                        print(BANCS.OUTPUT.ReservedField3)
        ELSE
                BANCS.INPUT.ReservedField3 = "00000000000"
                        print(BANCS.INPUT.ReservedField3)
                BANCS.OUTPUT.ReservedField3 = BANCS.INPUT.ReservedField3
                        print(BANCS.OUTPUT.ReservedField3)
        ENDIF
ENDIF
########CatTod balance end #####
