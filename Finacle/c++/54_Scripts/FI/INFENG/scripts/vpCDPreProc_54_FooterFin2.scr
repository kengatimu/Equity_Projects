                IF ((BANCS.INPUT.ReservedField2 =="Otherbill") OR (BANCS.INPUT.ReservedField2 =="AgentBill")) THEN

                        IF ((BANCS.INPUT.CrForacid==CUST.ATM.crForAcid1) OR (BANCS.INPUT.CrForacid==CUST.ATM.crForAcid2) OR (BANCS.INPUT.CrForacid==CUST.ATM.crForAcid3) OR (BANCS.INPUT.CrForacid=="0003000104091")) THEN

                                sv_u = "billercode,accountnumber,accountname |"
