IF (FIELDEXISTS(BANCS.INPUT.Foracid) == 1) THEN
        IF (BANCS.INPUT.Foracid!="") THEN
                print(BANCS.INPUT.Foracid)
                sv_h = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
                print(sv_h)
                IF (sv_h==0) THEN
                        sv_r = REPEXISTS("STDWFS")
                        IF (sv_r == 0) THEN
                                CREATEREP("STDWFS")
                        ENDIF
                        sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
                        IF (sv_r == 0) THEN
                                CREATECLASS("STDWFS", "GLBDATA", 5)
                        ENDIF
                        STDWFS.GLBDATA.solidsh = BANCS.OUTPARAM.acctSolId
                        print(STDWFS.GLBDATA.solidsh)
                        STDWFS.GLBDATA.schmcodeshn = BANCS.OUTPARAM.schmCode
                        print(STDWFS.GLBDATA.schmcodeshn)
                        STDWFS.GLBDATA.schmType = BANCS.OUTPARAM.schmType
                        print(STDWFS.GLBDATA.schmType)
                        STDWFS.GLBDATA.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
                        print(STDWFS.GLBDATA.EffAvailableAmttr)

                        IF ((STDWFS.GLBDATA.schmcodeshn =="SB135") OR (STDWFS.GLBDATA.schmcodeshn =="SB136")) THEN
                                sv_u = "natidcard |"
                                sv_u = sv_u + " select NAT_ID_CARD_NUM from tbaadm.gam ,tbaadm.cmg where  gam.bank_id=cmg.bank_id and gam.cif_id=cmg.cif_id and gam.bank_id='54' and cmg.bank_id='54' and gam.foracid=?SVAR and rownum<2 "
                                print(sv_u)
                                BANCS.INPARAM.BINDVARS = BANCS.INPUT.Foracid
                                sv_w=urhk_dbSelectWithBind(sv_u)
                                print(sv_w)
                                IF (sv_w !=0) THEN
                                        BANCS.OUTPUT.RespCode = "99"
                                        BANCS.OUTPUT.successOrFailure="F"
                                        exitscript
                                ELSE
                                        STDWFS.GLBDATA.natidcard = BANCS.OUTPARAM.natidcard
                                        print(STDWFS.GLBDATA.natidcard)
                                        STDWFS.GLBDATA.natidcard=MID$(STDWFS.GLBDATA.natidcard,0,4)
                                        print(STDWFS.GLBDATA.natidcard)
                                        IF (STDWFS.GLBDATA.natidcard == "HSNP") THEN
                                                BANCS.OUTPUT.RespCode = "99"
                                                BANCS.OUTPUT.successOrFailure="F"
                                                exitscript
                                        ENDIF
