			EBRT.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.tranParticulars)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
			EBRT.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.tranParticulars2)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.valueDate")
			EBRT.GLBDATA.valueDate=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.valueDate)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.glDate")
			EBRT.GLBDATA.glDate=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.glDate)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.refAmt")
			EBRT.GLBDATA.refAmt=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.refAmt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rate")
			EBRT.GLBDATA.rate=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.rate)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.rateCode.refCode") 
			EBRT.GLBDATA.rateCode=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.rateCode)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.treaRate")
			EBRT.GLBDATA.treaRate=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.treaRate)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranCrncyCode.crncyCode")
			EBRT.GLBDATA.tranCrncyCode=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.tranCrncyCode)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.refCrncyCode.crncyCode")
			EBRT.GLBDATA.refCrncyCode=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.refCrncyCode)
		if(EBRT.GLBDATA.tran_amt!="")then
		#{
			sv_l = strlen(EBRT.GLBDATA.tran_amt)
			sv_f = mid$(EBRT.GLBDATA.tran_amt,0,sv_l)
			sv_l = strlen(EBRT.GLBDATA.tran_amt)
			sv_p = getposition(sv_f,"|")
			EBRT.GLBDATA.trans_amt   = mid$(sv_f,0,(sv_p-1))
			EBRT.GLBDATA.trans_crncy = mid$(sv_f,sv_p,sv_l)
		#}
		endif
		if(EBRT.GLBDATA.refAmt!="")then
		#{
			sv_l = strlen(EBRT.GLBDATA.refAmt)
			sv_f = mid$(EBRT.GLBDATA.refAmt,0,sv_l)
			sv_l = strlen(EBRT.GLBDATA.refAmt)
			sv_p = getposition(sv_f,"|")
			EBRT.GLBDATA.arefAmt   = mid$(sv_f,0,(sv_p-1))
			EBRT.GLBDATA.arefCrncy = mid$(sv_f,sv_p,sv_l)
		#}
		endif	
		print(EBRT.GLBDATA.trans_amt)
		print(EBRT.GLBDATA.trans_crncy)
		print(EBRT.GLBDATA.acctCrncy)
		print(EBRT.GLBDATA.refCrncyCode)
		print(EBRT.GLBDATA.tranCrncyCode)
		if(EBRT.GLBDATA.CrDrcode=="C")then
		#{
			EBRT.GLBDATA.isrtgs = left$(EBRT.GLBDATA.tranParticulars,4)
			print(EBRT.GLBDATA.isrtgs)
			EBRT.GLBDATA.isswift = left$(EBRT.GLBDATA.tranParticulars,5)
			print(EBRT.GLBDATA.isswift)
			if(EBRT.GLBDATA.isrtgs=="RTGS")then
				EBRT.GLBDATA.isYN = "Y"
			endif
			if(EBRT.GLBDATA.isswift=="SWIFT")then
				EBRT.GLBDATA.isYN = "Y"
			endif
		#}
		else
		#{
			EBRT.GLBDATA.isrtgs = ""
			EBRT.GLBDATA.isswift = ""
		#}
		endif
	NEXTREC:
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	#}
	endif	
	if(EBRT.GLBDATA.isYN=="Y")then
