	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBRT.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	if((EBRT.GLBDATA.tranType=="T") and ((EBRT.GLBDATA.tranSubType=="CI") or (EBRT.GLBDATA.tranSubType=="BI")))then
	#{
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.partTranType.code")
			EBRT.GLBDATA.CrDrcode=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.CrDrcode)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.key.serial_num")
			EBRT.GLBDATA.serialnum=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.serialnum)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EBRT.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.crncyCode")
			EBRT.GLBDATA.acctCrncy=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.acctCrncy)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBRT.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBRT.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EBRT.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EBRT.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.refNum")
                        EBRT.GLBDATA.refNum=BANCS.OUTPARAM.srvValue
