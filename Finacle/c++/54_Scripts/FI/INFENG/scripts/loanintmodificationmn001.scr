#------------------------------------------------------------------------------------------------
#  Name            : loanintmodificationmn001.scr
#  Description     : This script will call HINTTM modifiation services to modify data present in custom table
#  Date            : 10-02-2013
#  Author          : Dhana Prabhakaran
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : getcparamvalue.scr
#  Menu Option     :  (Batch Job)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             10-02-2013      Dhana Prabhakaran    Original Version
#  2.0             16-09-2013      Bharath				Modified for new porting items
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","LNTMN") == 0) THEN
#{
	CREATECLASS("CUST","LNTMN",5)
#}
ENDIF

IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
#{
    CREATECLASS("CUST","CPARAM", 5)
#}
ENDIF

#------------------------------------------------------------------------------
#Initialisig required repository variables 
#------------------------------------------------------------------------------
CUST.LNTMN.errMsg = ""

#------------------------------------------------------------------------------
#Getting LOANINT_PIDR values from CPARAM
#------------------------------------------------------------------------------
BANCS.INPUT.moduleName  = "LOANINT"
BANCS.INPUT.parameterId = "LOANINT_PIDR"
CALL("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
    CUST.CPARAM.custPrefIntDr= BANCS.OUTPUT.parameterVal
    print(CUST.CPARAM.custPrefIntDr)
#}
ELSE
#{
    CUST.LNTMN.errMsg = "CPARAM setup not done for CustPrefIntDr "
    GOTO ENDOFSCRIPT 
#}
ENDIF

#------------------------------------------------------------------------------
#Getting LOANINT_STRDT values from CPARAM
#------------------------------------------------------------------------------
BANCS.INPUT.moduleName  = "LOANINT"
BANCS.INPUT.parameterId = "LOANINT_STRDT"
CALL("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
    CUST.CPARAM.startDate= BANCS.OUTPUT.parameterVal
    print(CUST.CPARAM.startDate)
#}
ELSE
#{
    CUST.LNTMN.errMsg = "CPARAM setup not done for StartDate "
    GOTO ENDOFSCRIPT 
#}
ENDIF

#------------------------------------------------------------------------------
#Getting LOANINT_MINDR values from CPARAM
#------------------------------------------------------------------------------
BANCS.INPUT.moduleName  = "LOANINT"
BANCS.INPUT.parameterId = "LOANINT_MINDR"
CALL("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
    CUST.CPARAM.minIntDr= BANCS.OUTPUT.parameterVal
    print(CUST.CPARAM.minIntDr)
#}
ELSE
#{
    CUST.LNTMN.errMsg = "CPARAM setup not done for MinIntDr "
    GOTO ENDOFSCRIPT 
#}
ENDIF

#------------------------------------------------------------------------------
#Finding count of records that need to be processed
#------------------------------------------------------------------------------
sv_s="custcount|"
sv_s = sv_s + " SELECT COUNT(1) "
sv_s = sv_s + " FROM CUSTOM.INT_CHANGE5 "
sv_s = sv_s + " WHERE INT_CHANGE5.entity_cre_flg='L' "
sv_s = sv_s + " AND INT_CHANGE5.sol_id= ?SVAR"
sv_s = sv_s + " AND INT_CHANGE5.bank_id = ?SVAR  "
print(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
IF (sv_d != 0) THEN 
#{
	CUST.LNTMN.errMsg = "DB ERROR!"
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	print(BANCS.OUTPARAM.custcount)
	IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
#}
ENDIF

sv_s="foracid,custpreff,acctpreff|"
sv_s = sv_s + " SELECT INT_CHANGE5.foracid,INT_CHANGE5.cust_pref,INT_CHANGE5.acct_Pref "
sv_s = sv_s + " FROM CUSTOM.INT_CHANGE5 "
sv_s = sv_s + " WHERE INT_CHANGE5.entity_cre_flg='L' "
sv_s = sv_s + " AND INT_CHANGE5.sol_id= ?SVAR"
sv_s = sv_s + " AND INT_CHANGE5.bank_id = ?SVAR  "
print(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)

sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c==0) then
#{
	CUST.LNTMN.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_k = urhk_dbCursorFetch(CUST.LNTMN.DbcursorNumber)
	print(sv_k)

	WHILE (sv_k == 0)
	#{
	##############################/INC0196510/sos/03-02-2023
		CUST.LNTMN.foracid	= BANCS.OUTPARAM.foracid
		CUST.LNTMN.custpreff	= BANCS.OUTPARAM.custpreff
		CUST.LNTMN.acctpreff	= BANCS.OUTPARAM.acctpreff

		print(CUST.LNTMN.foracid)
		print(CUST.LNTMN.custpreff)
		print(CUST.LNTMN.acctpreff)

		sv_s="acctopndate|"
		sv_s = sv_s + " SELECT TO_CHAR(db_stat_date,'DD-MM-YYYY') "
		sv_s = sv_s + " FROM tbaadm.gct "
		sv_s = sv_s + " WHERE bank_id= ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)

		IF (sv_d == 0) THEN 
		#{ 
			CUST.LNTMN.acctopndate	= BANCS.OUTPARAM.acctopndate
			PRINT(CUST.LNTMN.acctopndate)
##############################/INC0196510/sos/03-02-2023
			CUST.LNTMN.acctopndate	= "01-02-2023"
			PRINT(CUST.LNTMN.acctopndate)
##############################/INC0196510/sos/03-02-2023
#}
		ENDIF
		
		#----------------------------------------------------------------------------------------------------
		# Modify and verify using services
		#----------------------------------------------------------------------------------------------------
		#sv_u = urhk_SetUrhkInp("IntTblCrit.entityType.type|ACCNT")
		#print(sv_u)
		sv_u = urhk_SetUrhkInp("loanIntTblCrit.laAcct.foracid|" + CUST.LNTMN.foracid)
		print(sv_u)
		sv_u = urhk_SetUrhkInp("loanIntTblCrit.funcCode|M")
		print(sv_u)
		
		sv_u = urhk_ExecSrv("SRV_FetchLoanIntTblDtl|retain_all_output = Y")
		print(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			print(sv_u)
			#new porting changes
			CUST.LNTMN.peggedFlg="N"
			sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.peggedFlg|" + CUST.LNTMN.peggedFlg)
			print(sv_u)
			CUST.LNTMN.acctpref="0"
			sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.acctPrefInt|" + CUST.LNTMN.acctpref)
			print(sv_u)
			CUST.LNTMN.custpref="0"
			sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.custPrefInt|" + CUST.LNTMN.custpref)
			print(sv_u)
			sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.startDate|" + CUST.LNTMN.acctopndate)
			print(sv_u)
			CUST.LNTMN.intTblVerNum=""
			sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.intTblVerNum|" + CUST.LNTMN.intTblVerNum)
			print(sv_u)

			CUST.LNTMN.peggedFreqInMnths=""
			sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.peggedFreqInMnths|" + CUST.LNTMN.peggedFreqInMnths)
			print(sv_u)
			CUST.LNTMN.peggedFreqInDays=""
			sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.peggedFreqInDays|" + CUST.LNTMN.peggedFreqInDays)
			print(sv_u)

			sv_h = urhk_getAcctDetailsInRepository(CUST.LNTMN.foracid)
			print(sv_h)
			IF (sv_h==0) THEN
				CUST.LNTMN.solidsh = BANCS.OUTPARAM.acctSolId
				print(CUST.LNTMN.solidsh)
				CUST.LNTMN.schmcodesh = BANCS.OUTPARAM.schmCode
				print(CUST.LNTMN.schmcodesh)
				CUST.LNTMN.schmType = BANCS.OUTPARAM.schmType
				print(CUST.LNTMN.schmType)

				sv_s="gspschm_code,int_tbl_code,min_int_pcnt_dr,max_int_pcnt_dr|"
				sv_s = sv_s + " SELECT gsp.SCHM_CODE,INT_TBL_CODE,MIN_INT_PCNT_DR,MAX_INT_PCNT_DR FROM TBAADM.csp,TBAADM.gsp WHERE gsp.SCHM_CODE=csp.SCHM_CODE AND csp.CRNCY_CODE='KES' and gsp.BANK_ID='54' "
				sv_s = sv_s + " AND csp.BANK_ID='54' and gsp.del_flg='N' and gsp.schm_type ='LAA' and gsp.schm_code =?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS =  CUST.LNTMN.schmcodesh 
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN 
				#{ 
					CUST.LNTMN.int_tbl_code	= BANCS.OUTPARAM.int_tbl_code
					PRINT(CUST.LNTMN.int_tbl_code)

					CUST.CPARAM.intTblCode=CUST.LNTMN.int_tbl_code
					print(CUST.CPARAM.intTblCode)
					#CUST.CPARAM.intTblCode="LZERO"
					#print(CUST.CPARAM.intTblCode)
					##############################/INC0196510/sos/03-02-2023
					CUST.LNTMN.min_int_pcnt_dr= CUST.LNTMN.custpreff
					PRINT(CUST.LNTMN.min_int_pcnt_dr)
					CUST.CPARAM.minIntDr=CUST.LNTMN.custpreff
					print(CUST.CPARAM.minIntDr)
					CUST.LNTMN.max_int_pcnt_dr= CUST.LNTMN.custpreff
					PRINT(CUST.LNTMN.custpreff)
					CUST.CPARAM.maxIntDr=CUST.LNTMN.custpreff
					print(CUST.LNTMN.custpreff)
					sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.intTblCode.tblCode|" + CUST.CPARAM.intTblCode)
					print(sv_u)
					#new porting changes
					sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.minInt|" + CUST.CPARAM.minIntDr)
					print(sv_u)
					sv_u = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.maxInt|" + CUST.CPARAM.maxIntDr)
					print(sv_u)
				#}
				ENDIF
			ENDIF
			
			sv_u = urhk_ExecSrv("SRV_processLoanIntTblDtlAndVerify|retain_all_output = Y|same_user_verify = Y")
			print(sv_u)
			IF(sv_u == 0) THEN
			#{
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				sv_s = "UPDATE CUSTOM.INT_CHANGE5 "
				sv_s = sv_s + " SET INT_CHANGE5.entity_cre_flg = 'P',"
				sv_s = sv_s + " INT_CHANGE5.acct_opn_date= SYSDATE"
				sv_s = sv_s + " WHERE INT_CHANGE5.foracid= ?SVAR"
				sv_s = sv_s + " AND INT_CHANGE5.bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.LNTMN.foracid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
		
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

		#----------------------------------------------------------------------------------------------------
		# SRV Error check
		#----------------------------------------------------------------------------------------------------
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
			#}									
			ELSE
			#{
				sv_v = 0
			#}
			ENDIF
			IF (sv_v > 0) then
			#{
				sv_u = system("echo 'Error for Acct:"+CUST.LNTMN.foracid+" ' >>laaintmodA.log")
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
					sv_u = system("echo '"+sv_e+"' >>laaintmodA.log")
					print(sv_u)
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF

		sv_k = urhk_dbCursorFetch(CUST.LNTMN.DbcursorNumber)
		print(sv_k)

	#}
	DO

	sv_c = urhk_dbCursorClose(CUST.LNTMN.DbcursorNumber)
	print(sv_c)
#}
ENDIF

ENDOFSCRIPT:
IF(CUST.LNTMN.errMsg != "") THEN
#{
    sv_u = system("echo '"+CUST.LNTMN.errMsg+"' >>laaintmodA.log")
#}
ENDIF

EXITSCRIPT
END-->
