<--start
trace on
sv_u = urhk_B2k_PrintRepos("BANCS")
print(sv_u)

sv_r = REPEXISTS("CUST")
IF (sv_r == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","CUSTEFT") == 0) THEN
#{
    CREATECLASS("CUST","CUSTEFT",5)
#}
ENDIF

CUST.CUSTEFT.Mainpayab=""
CUST.CUSTEFT.Mainexpen=""
CUST.CUSTEFT.Mainincome=""

print(CUST.CUSTEFT.Mainpayab)
print(CUST.CUSTEFT.Mainexpen)
print(CUST.CUSTEFT.Mainincome)

sv_a = urhk_SRV_GetVal("ecsTranGenDet.custAcct.foracid")
CUST.CUSTEFT.foracid=BANCS.OUTPARAM.srvValue
print(CUST.CUSTEFT.foracid)

sv_a = urhk_SRV_GetVal("ecsTranGenDet.chrgAcct.foracid")
CUST.CUSTEFT.foracidcharge=BANCS.OUTPARAM.srvValue
print(CUST.CUSTEFT.foracidcharge)

sv_a = urhk_SRV_GetVal("ecsTranGenDet.remitAmt")
CUST.CUSTEFT.remitAmt=BANCS.OUTPARAM.srvValue
print(CUST.CUSTEFT.remitAmt)

sv_a = urhk_SRV_GetVal("ecsTranCrit.solId.solId")
CUST.CUSTEFT.solIdInt=BANCS.OUTPARAM.srvValue
print(CUST.CUSTEFT.solIdInt)

sv_a = urhk_SRV_GetVal("ecsTranGenDet.remitCrncy")
CUST.CUSTEFT.remitCrncy=BANCS.OUTPARAM.srvValue
print(CUST.CUSTEFT.remitCrncy)

IF (FIELDEXISTS(CUST.CUSTEFT.foracidcharge)) THEN
	IF (CUST.CUSTEFT.foracidcharge!="") THEN
		CUST.CUSTEFT.foracid = CUST.CUSTEFT.foracidcharge
		print(CUST.CUSTEFT.foracid)
	ENDIF
ENDIF

IF (CUST.CUSTEFT.foracid!="") THEN
	print(CUST.CUSTEFT.foracid)
	sv_u = urhk_getAcctDetailsInRepository(CUST.CUSTEFT.foracid)
	IF (sv_u != "0") THEN
	#{
		sv_c = urhk_SRV_SetErr("Invalid charge Account.")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.CUSTEFT.solidsh = BANCS.OUTPARAM.acctSolId
		print(CUST.CUSTEFT.solidsh)
		CUST.CUSTEFT.schmcodesh = BANCS.OUTPARAM.schmCode
		print(CUST.CUSTEFT.schmcodesh)
		CUST.CUSTEFT.schmType = BANCS.OUTPARAM.schmType
		print(CUST.CUSTEFT.schmType)
		CUST.CUSTEFT.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.CUSTEFT.acctCrncyCode)
		CUST.CUSTEFT.DrAccount=CUST.CUSTEFT.foracid
		print(CUST.CUSTEFT.DrAccount)
		CUST.CUSTEFT.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
		print(CUST.CUSTEFT.EffAvailableAmttr)
	#}
	ENDIF
ENDIF

	CUST.CUSTEFT.rate="1"
	CUST.CUSTEFT.rate_code ="MEAN"
	IF (CUST.CUSTEFT.acctCrncyCode!= BANCS.STDIN.homeCrncyCode) THEN
		CUST.CUSTEFT.rate_code ="MEAN"
		print(CUST.CUSTEFT.rate_code)
		CUST.CUSTEFT.from_cncy = CUST.CUSTEFT.acctCrncyCode
		print(CUST.CUSTEFT.from_cncy)
		CUST.CUSTEFT.to_crncy = BANCS.STDIN.homeCrncyCode
		print(CUST.CUSTEFT.to_crncy)
		BANCS.INPARAM.BINDVARS =CUST.CUSTEFT.from_cncy + "|" + CUST.CUSTEFT.to_crncy
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.CUSTEFT.rate_code + "|" +BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_u = "fxdcrncycode,ratecode,Rate,treaRate|SELECT FXD_CRNCY_CODE,RATECODE,VAR_CRNCY_UNITS,CUST_VAR_CRNCY_UNITS FROM tbaadm.rtl "
		sv_u = sv_u + " WHERE FXD_CRNCY_CODE = ?SVAR"
		sv_u = sv_u + " AND VAR_CRNCY_CODE= ?SVAR"
		sv_u = sv_u + " AND RATECODE= ?SVAR "
		sv_u = sv_u + " AND BANK_ID = ?SVAR  and rownum<2 "
		print(sv_u)
		sv_y=urhk_dbSelectWithBind(sv_u)
		print(sv_y)
		IF (sv_y == "0") THEN
			sv_k = BANCS.OUTPARAM.fxdcrncycode
			print(sv_k)
			sv_j = BANCS.OUTPARAM.ratecode
			print(sv_j)
			sv_p = BANCS.OUTPARAM.Rate
			print(sv_p)
			CUST.CUSTEFT.rate = sv_p
			print(CUST.CUSTEFT.rate)
			sv_x= BANCS.OUTPARAM.treaRate
			print(sv_x)
			CUST.CUSTEFT.treaRate = sv_x
			print(CUST.CUSTEFT.treaRate)
			CUST.CUSTEFT.fixed_crncy = CUST.CUSTEFT.from_cncy
			print(CUST.CUSTEFT.fixed_crncy)
			CUST.CUSTEFT.var_crncy = CUST.CUSTEFT.to_crncy
			print(CUST.CUSTEFT.var_crncy)
		ENDIF
	ENDIF

	CUST.CUSTEFT.bacid="ROBINHOODTAX"
	print(CUST.CUSTEFT.bacid)
	sv_s = "contra "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT foracid "
	sv_s = sv_s + " FROM GAM "
	sv_s = sv_s + " WHERE sol_id = ?SVAR "
	sv_s = sv_s + " AND bacid = ?SVAR "
	sv_s = sv_s + " AND del_flg ='N' "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUST.CUSTEFT.solIdInt + "|" + CUST.CUSTEFT.bacid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
	print(sv_s)
	sv_d =urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == "0") THEN
		CUST.CUSTEFT.Mainincome= BANCS.OUTPARAM.contra
		print(CUST.CUSTEFT.Mainincome)
		CUST.CUSTEFT.CrAccount = CUST.CUSTEFT.Mainincome
		print(CUST.CUSTEFT.CrAccount)
	ELSE
		sv_c = urhk_SRV_SetErr("Invalid Tax GL Account.")
		BANCS.OUTPUT.successOrFailure = "F"
		GOTO ENDOFSCRIPT
	ENDIF
	#------------------------------------------------------------------
	#  Getting fee amount
	#------------------------------------------------------------------
	IF (FIELDEXISTS(CUST.CUSTEFT.remitAmt)) THEN
		print(CUST.CUSTEFT.remitAmt)
		
		if (CINT(CUST.CUSTEFT.remitAmt) > 499999) then 
			CUST.CUSTEFT.tran_amt = CDOUBLE(CUST.CUSTEFT.remitAmt)
			print(CUST.CUSTEFT.tran_amt)
			CUST.CUSTEFT.dedittr="0.0005"
			sv_q = "sumamountfee,sumamountfeePamount|select ('" + CUST.CUSTEFT.tran_amt + "' * '" + CUST.CUSTEFT.dedittr + "'),(('" + CUST.CUSTEFT.tran_amt + "' * '" + CUST.CUSTEFT.dedittr + "') + '" + CUST.CUSTEFT.tran_amt + "')  from dual "
			print(sv_q)
			sv_w=urhk_dbSelectWithBind(sv_q)
			if (sv_w == 0) then
				print("sumamountfee")
				CUST.CUSTEFT.FeeAmount = CDOUBLE(BANCS.OUTPARAM.sumamountfee)
				print(CUST.CUSTEFT.FeeAmount)
				CUST.CUSTEFT.sumamountfeePamount = CDOUBLE(BANCS.OUTPARAM.sumamountfeePamount)
				print(CUST.CUSTEFT.sumamountfeePamount)
				
				IF (CDOUBLE(CUST.CUSTEFT.EffAvailableAmttr) < CDOUBLE(CUST.CUSTEFT.sumamountfeePamount)) THEN
					sv_c = urhk_SRV_SetErr("Insufficient fund for charges.")
					BANCS.OUTPUT.successOrFailure = "F"
					exitscript
				ENDIF
			endif
		ELSE
			GOTO ENDOFSCRIPT
		endif
	ENDIF

	#--------------------------------------------------------------------------
	# Create the narration add reversal
	#--------------------------------------------------------------------------
	sv_e = mid$(BANCS.STDIN.BODDate,0,10)
	#print(sv_e)
	sv_s = "sysdate "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
	sv_s = sv_s + " FROM DUAL"
	BANCS.INPARAM.BINDVARS =  sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
		CUST.CUSTEFT.sysdate = BANCS.OUTPARAM.sysdate
		CUST.CUSTEFT.narr0="EFT additional Charges"
		print(CUST.CUSTEFT.narr0)
		print(CUST.CUSTEFT.DrAccount)
		print(CUST.CUSTEFT.FeeAmount)
		CUST.CUSTEFT.narr1 = CUST.CUSTEFT.narr0 + "/" + CUST.CUSTEFT.DrAccount + "/" + CUST.CUSTEFT.FeeAmount
		print(CUST.CUSTEFT.narr1)
		CUST.CUSTEFT.narr1 = MID$(CUST.CUSTEFT.narr1,0,50)
		print(CUST.CUSTEFT.narr1)
	ELSE
		GOTO ENDOFSCRIPT
	ENDIF
	print(CUST.CUSTEFT.CrAccount)
	print(CUST.CUSTEFT.DrAccount)



print("HIHI")

#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------

        sv_r = REPEXISTS("MTT")
        IF (sv_r == 0) THEN
                CREATEREP("MTT")
        ENDIF

        sv_r = CLASSEXISTS("MTT","TranDetails")
        IF (sv_r == 0) THEN
                CREATECLASS("MTT","TranDetails",5)
        ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","PartTranDetails",5)
	ENDIF

        sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        ENDIF

        sv_r = CLASSEXISTS("BANCS","INPARAM")
        IF (sv_r == 0) THEN
                CREATECLASS("BANCS","INPARAM",5)
        ENDIF

        BANCS.INPARAM.PostTranFlg = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg = "N"
        BANCS.INPARAM.CommitFlg="N"
        BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw="Y"
        BANCS.INPARAM.CheckExceptions="N"
        MTT.TranDetails.TranDate="0"
        MTT.TranDetails.TranType = "T"
        MTT.TranDetails.TranSubType = "CI"
        MTT.TranDetails.IgnoreExcp = "I"
        MTT.TranDetails.Consolidate = "N"
        MTT.TranDetails.Remarks = CUST.CUSTEFT.narr1

        sv_r = urhk_MTTS_Initialize("")
        #print(sv_r)

        sv_v = "CashBackComm"
        #print(sv_v)

        sv_u = urhk_MTTS_DefineTransaction("CashBackComm")

        sv_u = urhk_MTTS_PopulateInputDetails("")

	#--------------------------------------------------
        # Income To Branch A/c
        #--------------------------------------------------

                MTT.PartTranDetails.Account = CUST.CUSTEFT.CrAccount
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		IF (CUST.CUSTEFT.acctCrncyCode!= CUST.CUSTEFT.remitCrncy) THEN
			MTT.PartTranDetails.RateCode = CUST.CUSTEFT.rate_code
			MTT.PartTranDetails.Rate = CUST.CUSTEFT.rate
		ENDIF
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.CUSTEFT.narr1
		MTT.PartTranDetails.Particulars2 = CUST.CUSTEFT.foracid
                MTT.PartTranDetails.RefAmount = cdouble(CUST.CUSTEFT.FeeAmount)
                print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = CUST.CUSTEFT.narr0
                MTT.PartTranDetails.RefNum = CUST.CUSTEFT.foracid
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_e = "CashBackIncome"
                sv_r = urhk_MTTS_definePartTran(sv_e)
		print(sv_r)
		if (sv_r != 0) then
			CUST.CUSTEFT.Sucessfail1     = "N"
			
			BANCS.OUTPUT.successOrFailure = "F"
			sv_c = urhk_SRV_SetErr("Transaction failure check data.")
			exitscript
		ELSE
			CUST.CUSTEFT.Sucessfail1     = "Y"
		ENDIF

	#------------------------------------------------------------------
        # Debit Partran To Agent Pool A/C
        #------------------------------------------------------------------

                MTT.PartTranDetails.Account = CUST.CUSTEFT.DrAccount
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		IF (CUST.CUSTEFT.acctCrncyCode!= CUST.CUSTEFT.remitCrncy) THEN
			MTT.PartTranDetails.RateCode = CUST.CUSTEFT.rate_code
			MTT.PartTranDetails.Rate = CUST.CUSTEFT.rate
		ENDIF
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.CUSTEFT.narr1
		MTT.PartTranDetails.Particulars2 = CUST.CUSTEFT.foracid
                sv_a = cdouble(CUST.CUSTEFT.FeeAmount) 
		sv_a = -(sv_a)
		print(sv_a)
                MTT.PartTranDetails.RefAmount = sv_a
                print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = CUST.CUSTEFT.narr0
		print(CUST.CUSTEFT.EffAvailableAmttr)
		print(CUST.CUSTEFT.FeeAmount)
		IF (CDOUBLE(CUST.CUSTEFT.EffAvailableAmttr) < CDOUBLE(CUST.CUSTEFT.sumamountfeePamount)) THEN
			    MTT.PartTranDetails.TODRefType          = "BH"
			    MTT.PartTranDetails.TodEntityType   = "TODBH"
			    print(CUST.CUSTEFT.DrAccount)
			    MTT.PartTranDetails.TodEntityId     = CUST.CUSTEFT.DrAccount
			    MTT.PartTranDetails.TodLevIntFlg    = "N"
			    MTT.PartTranDetails.TodExpiryDate       = BANCS.STDIN.BODDate
			    MTT.PartTranDetails.TodPenalDate    = BANCS.STDIN.BODDate
			    MTT.PartTranDetails.TodPermittedBy  = BANCS.STDIN.userId
			    MTT.PartTranDetails.TodRemarks      = "Charges TOD"
			    MTT.PartTranDetails.Consolidate     = "N"
		ENDIF
                MTT.PartTranDetails.RefNum = CUST.CUSTEFT.foracid
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_h = "D" + CUST.CUSTEFT.DrAccount
                sv_u = urhk_MTTS_definePartTran(sv_h)
		print(sv_u)
		if (sv_u != 0) then
			CUST.CUSTEFT.Sucessfail1     = "N"
			sv_c = urhk_SRV_SetErr("Transaction failure check data.")
			BANCS.OUTPUT.successOrFailure = "F"
			exitscript
		ELSE
			CUST.CUSTEFT.Sucessfail1     = "Y"
		ENDIF
                sv_r = urhk_MTTS_EndDefinition("")
		print(sv_r)
                sv_r = urhk_MTTS_Close("")
                print(sv_r)

ENDOFSCRIPT:

exitscript

END-->
