##+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Repos&Classes
	if (repexists("EQSRV") == 0) then
		createrep("EQSRV")
	endif
	if (classexists("EQSRV","GLBDATA") == 0) then
		createclass("EQSRV","GLBDATA",5)
	endif
#Variables
     
	EQSRV.GLBDATA.ORGKEY  	= ""

		sv_q = "ORGKEY  | select foracid from custom.int_credit where bank_id=?SVAR and CLASSFROM='F' "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
		sv_e = urhk_dbCursorOpenWithBind(sv_q)
		IF(sv_e==0) THEN
		#{
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print (sv_m)
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			IF(sv_q == 1) THEN
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
				exitscript
			ENDIF
			print(sv_q)
			WHILE (sv_q==0)

				EQSRV.GLBDATA.ORGKEY  = BANCS.OUTPARAM.ORGKEY
				Print (EQSRV.GLBDATA.ORGKEY  )

				sv_s="cifcount|"
				sv_s = sv_s + " SELECT COUNT(1) "
				sv_s = sv_s + " FROM CRMUSER.ACCOUNTS "
				sv_s = sv_s + " WHERE ORGKEY =  ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.ORGKEY  
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == 0) THEN		
					IF (CINT(BANCS.OUTPARAM.cifcount)== 1) THEN 			
						sv_s="ADDcount|"
						sv_s = sv_s + " SELECT COUNT(1) "
						sv_s = sv_s + " FROM crmuser.address "
						sv_s = sv_s + " WHERE ORGKEY =  ?SVAR and preferredaddress='Y' "
						##sv_s = sv_s + " and ADDRESSCATEGORY ='Mailing' "
						print(sv_s)
						BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.ORGKEY
						print(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF (sv_d == 0) THEN		
							
							IF (CINT(BANCS.OUTPARAM.ADDcount)<2) THEN 									
								EQSRV.GLBDATA.resultMsg = "preferredaddress address ok "
								GOTO ENDOFSCRIPT									
							ELSE
								
								BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS
								print(BANCS.INPARAM.BINDVARS)
								sv_a = " update crmuser.address set preferredaddress='N' where bank_id='54' and ADDRESSCATEGORY ='Mailing' and orgkey= ?SVAR  "
								sv_b = urhk_dbSQLWithBind(sv_a)
								print(sv_b)
								IF(sv_b != 0) THEN																							
									EQSRV.GLBDATA.resultMsg = " Failed"
									GOTO ENDOFSCRIPT											
								ELSE																					
									EQSRV.GLBDATA.resultMsg = " Preferredaddress Successful"
									GOTO ENDOFSCRIPT
								ENDIF									
							ENDIF
						ENDIF
				
					ELSE
						EQSRV.GLBDATA.resultMsg = "CIF DOES NOT EXIST"
						GOTO ENDOFSCRIPT					
					ENDIF	
				ELSE 
					
					EQSRV.GLBDATA.resultMsg = "ERROR  Failed"
					GOTO ENDOFSCRIPT
				ENDIF
ENDOFSCRIPT:
				print (sv_m)
				sv_q = urhk_dbCursorFetch(sv_m)
				print(sv_q)
			DO
		ENDIF

        
	if(classexists("EQSRV","GLBDATA")==1)then
                deleteclass("EQSRV","GLBDATA")
        endif
        if(repexists("EQSRV")==1)then
                deleterep("EQSRV")
        endif
        exitscript
trace off
end-->