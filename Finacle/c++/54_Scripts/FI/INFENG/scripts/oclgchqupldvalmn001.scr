	#---------------------------------------------------------------------------
	print(CUST.CLRUPD.inFileName)
	sv_p = trim(CUST.CLRUPD.inFileName)
	print(sv_p)
	sv_m = MID$(sv_p,0,4)
	print(sv_m)
	
