		BANCS.INPARAM.BINDVARS = CUST.CLRUPD.inZoneCode +"|" +CUST.CLRUPD.inZoneDate +"|" +CUST.CLRUPD.zoneCode1 + "|" +CUST.CLRUPD.zoneCode2 + "|" + CUST.CLRUPD.zoneCode3 + "|" + CUST.CLRUPD.zoneCode4 + "|" +CUST.CLRUPD.zoneCode5 + "|" + CUST.CLRUPD.zoneCode6 + "|" +CUST.CLRUPD.zoneCode7 + "|" + CUST.CLRUPD.zoneCode8 + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
