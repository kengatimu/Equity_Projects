		#{
		CUST.CLRUPD.userBakPath = BANCS.OUTPARAM.envValue
		print(CUST.CLRUPD.userBakPath)
	#}
	ENDIF
	
	sv_a=CUST.CLRUPD.inZoneCode
	#######################################################################
	# Validation for zone code
	#######################################################################
	IF ((sv_a != CUST.CLRUPD.zoneCode1) AND (sv_a != CUST.CLRUPD.zoneCode2) AND (sv_a != CUST.CLRUPD.zoneCode3) AND (sv_a != CUST.CLRUPD.zoneCode4) AND (sv_a != CUST.CLRUPD.zoneCode5) AND (sv_a != CUST.CLRUPD.zoneCode6) AND (sv_a != CUST.CLRUPD.zoneCode7) AND (sv_a != CUST.CLRUPD.zoneCode8)) THEN
