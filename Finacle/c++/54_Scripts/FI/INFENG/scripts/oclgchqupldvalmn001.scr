			#}
		ELSE
			#{
			CUST.CLRUPD.count2 = BANCS.OUTPARAM.count2
			print(CUST.CLRUPD.count2)
		#}
		ENDIF
		
		IF (CUST.CLRUPD.count2 ==0)THEN
		#{
			sv_e = "CTS Upload Zone Not Opened"
			sv_m = "RESULT_MSG"
			sv_s = "Error_0|Error :^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_s)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO FINISH
		#}
		ENDIF
	#}
	ENDIF
	
	#============================================================================*
	# CALLING THE COM FILE
	#============================================================================*
	sv_u = urhk_getFileLocation("COM|oclgchqupldvalmn001.com")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		#----------------------------------------------------------------------------------
		#---    Setting Env variables
		#----------------------------------------------------------------------------------
		sv_a = "inFileName|" + CUST.CLRUPD.inFileName
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.CLRUPD.errorMsg = "Error in setting env variable fileName"
			GOTO FINISH
		#}
		ENDIF
		
		sv_a = "inZoneDate|" + CUST.CLRUPD.inZoneDate
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.CLRUPD.errorMsg = "Error in setting env variable fileName"
			GOTO FINISH
		#}
		ENDIF
		
		sv_a = "inZoneCode|" + CUST.CLRUPD.inZoneCode
		sv_u = urhk_putEnvForCallShellScript(sv_a)
		PRINT(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.CLRUPD.errorMsg = "Error in setting env variable drAcctCrncy"
			GOTO FINISH
		#}
		ENDIF
		
		#----------------------------------------------------------------------------------
		#---    Executing com file in background
		#----------------------------------------------------------------------------------
		BANCS.INPARAM.scriptName = "oclgchqupldvalmn001.com"
		BANCS.INPARAM.arguments = ""
		sv_u = urhk_CallShellScript("b")
		print(sv_u)
		IF (sv_u != 0) THEN
		#{
			CUST.CLRUPD.errorMsg = "Upload process failed please retry"
			GOTO FINISH
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.CLRUPD.errorMsg = "Unable to load com file"
		GOTO FINISH
	#}
	ENDIF
	
	FINISH:
		IF (CUST.CLRUPD.errorMsg !="" ) THEN
		#{
			sv_z = urhk_SetOrbOut("Error_01|ERROR^"+CUST.CLRUPD.errorMsg)
			sv_z = urhk_SetOrbOut("SuccessOrFailure|N")
			#}
		ELSE
			#{
			sv_d = urhk_SetOrbOut("RESULT_MSG|Upload initiated successfully.")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
