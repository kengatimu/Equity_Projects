	#---------------------------------------------------------------------------
	#Validating Whether Specified Zones have been opened
	#---------------------------------------------------------------------------
	sv_s = "count| "
	sv_s = sv_s + " SELECT count(1) "
	sv_s = sv_s + " FROM tbaadm.ozh "
	sv_s = sv_s + " WHERE ZONE_STAT='O' "
	sv_s = sv_s + " AND CLG_ZONE_DATE=TO_DATE(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND CLG_ZONE_CODE IN (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR) "
	sv_s = sv_s + " AND sol_id= ?SVAR "
	sv_s = sv_s + " AND DEL_FLG ='N' "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CLRUPD.inZoneDate + "|" + CUST.CLRUPD.zoneCode1 + "|" +CUST.CLRUPD.zoneCode2 + "|" + CUST.CLRUPD.zoneCode9 + "|" + CUST.CLRUPD.zoneCode4 + "|" +CUST.CLRUPD.zoneCode5 + "|" + CUST.CLRUPD.zoneCode6 + "|" +CUST.CLRUPD.zoneCode7 + "|" + CUST.CLRUPD.zoneCode8 + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
