<--start
#trace on
#Rep/Class
	sv_a = urhk_MTTS_Close("")
	print(sv_a)
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(repexists("BANCS")==0)then
                createrep("BANCS")
        endif
        if(classexists("MTT","XCPN")==0)then
                createclass("MTT","XCPN",5)
        endif
        if(classexists("MTT","Error")==0)then
                createclass("MTT","Error",5)
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        if(classexists("MTT","TranDetails")==0)then
                createclass("MTT","TranDetails",5)
        endif
        if(classexists("MTT","PartTranDetails")==0)then
                createclass("MTT","PartTranDetails",5)
        endif
        if(classexists("BANCS","INPARAM")==0)then
                createclass("BANCS","INPARAM",5)
        endif
        if(classexists("CUST","ATM")==0)then
                createclass("CUST","ATM",5)
        endif
#
	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="Y"
	BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"
	sv_u = urhk_MTTS_Initialize("")
	print(sv_u)
	if(sv_u != 0 ) then
	#{
		GOTO ENDOFSCRIPT
	#}
	endif
	CUST.ATM.overDrawnAmt = CUST.DATA.ADmdAmt 
	if(CUST.DATA.LiquidityModule=="MERNT-LM")then
		CUST.ATM.eventId = "MERCOMM"
	else
		CUST.ATM.eventId = "ODUTLCOMM"
	endif 
	CUST.ATM.eventType = "GCHRG"
	
	if(CUST.DATA.LiquidityModule=="MERNT-LM")then
		MTT.ChargeDetails.EventId = "MERCOMM" 
	else
		MTT.ChargeDetails.EventId = "ODUTLCOMM" 
	endif 
	MTT.ChargeDetails.EventType = "GCHRG" 
	MTT.ChargeDetails.ChrgInpCrncy = BANCS.STDIN.homeCrncyCode

	sv_y = "OverDrawCommision"
	sv_u = urhk_MTTS_InitPtt(sv_y)
	print(sv_u)
	if(sv_u != 0 ) then
	#{
		GOTO ENDOFSCRIPT
	#}
	endif
	sv_u = urhk_MTTS_GetPttRec(sv_y)
	print(sv_u)
	if(sv_u!=0)then
		goto ENDOFSCRIPT
	endif
	if(sv_u == 0 ) then
	#{
		CUST.ATM.crForacid = MTT.PartTranDetails.Account
		CUST.ATM.RefCurrency = MTT.ChargeDetails.CollectionCrncy
		CUST.ATM.RefAmount = CDOUBLE(MTT.PartTranDetails.RefAmount)
		sv_d = "commPct | select amt_pcnt from tbaadm.ptt,tbaadm.adm"
		if(CUST.DATA.LiquidityModule=="MERNT-LM")then
		sv_d = sv_d + " where adm.bank_id=?SVAR and ptt.bank_id=?SVAR and ptt.event_id='MERNT-LM' "
		else
		sv_d = sv_d + " where adm.bank_id=?SVAR and ptt.bank_id=?SVAR and ptt.event_id='ODUTLCOMM' "
		endif 
		sv_d = sv_d + " and ptt.event_type='GCHRG' "
		sv_d = sv_d + " and ptt.amt_derv_srl_num =adm.amt_drv_srl_num "
		sv_d = sv_d + " and adm.amt_ind='P' and adm.entity_cre_flg='Y' and adm.del_flg='N' " 
		sv_d = sv_d + " and ptt.ENTITY_CRE_FLG='Y' and ptt.del_flg='N' and rownum <=1 "
		print(sv_d)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.ATM.commPct = BANCS.OUTPARAM.commPct
		else
			CUST.ATM.commPct = 0.3 
		endif
		if(cdouble(CUST.ATM.overDrawnAmt)>=1)then
			sv_b = (cdouble(CUST.ATM.overDrawnAmt) * cdouble(CUST.ATM.commPct))/100  
			print(sv_b)
		endif
	#}
	endif

	CUST.ATM.drAccount = CUST.DATA.agentDrAcct 
	if(CUST.DATA.LiquidityModule=="AGENT-LM")then
		CUST.ATM.narr1 = "Agent OverDrawn Comm"
	endif
	if(CUST.DATA.LiquidityModule=="MERNT-LM")then
		CUST.ATM.narr1 = "Merchant OverDrawn Comm"
	endif

	sv_a = urhk_MTTS_Close("")
	print(sv_a)

	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg = "N"
	BANCS.INPARAM.CommitFlg="Y"
	BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw="Y"
	BANCS.INPARAM.CheckExceptions="N"

	sv_u = urhk_MTTS_Initialize("")
	print(sv_u)

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "CI"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.Consolidate = "N"
	MTT.TranDetails.Remarks = CUST.ATM.narr1
	sv_v = "PurchaseComm"
	print(sv_v)
	sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")
	if(sv_u!=0)then
		goto ENDOFSCRIPT
	endif
	sv_u = urhk_MTTS_PopulateInputDetails("")
	if(sv_u!=0)then
		goto ENDOFSCRIPT
	endif
	print(CUST.ATM.crForacid)
	MTT.PartTranDetails.Account = CUST.ATM.crForacid
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.RateCode ="TTS"
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATM.narr1
	MTT.PartTranDetails.RefAmount = sv_b
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	MTT.ChargeDetails.EventType = CUST.ATM.eventType
	MTT.ChargeDetails.EventId = CUST.ATM.eventId
	sv_e = "PurchaseIncome"
	sv_u = urhk_MTTS_DefineChargePartTran(sv_e)
	print(sv_u)
	if(sv_u!=0)then
		goto ENDOFSCRIPT
	endif
	print(CUST.ATM.drAccount)
	MTT.PartTranDetails.Account = CUST.ATM.drAccount
	MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
	MTT.PartTranDetails.RateCode ="TTS"
	MTT.PartTranDetails.ValueDateDiff = "0"
	MTT.PartTranDetails.Particulars = CUST.ATM.narr1
	MTT.PartTranDetails.RefAmount = -sv_b
	print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.Remarks = ""
	MTT.PartTranDetails.RefNum = ""
	MTT.PartTranDetails.IgnoreExcp = "I"
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.TranIdentifier = sv_v
	sv_h = "D" + CUST.ATM.drAccount
	sv_u = urhk_MTTS_definePartTran(sv_h)
	if(sv_u!=0)then
		goto ENDOFSCRIPT
	endif
	sv_u = urhk_MTTS_EndDefinition("")
	if(sv_u!=0)then
		goto ENDOFSCRIPT
	endif
	sv_u = urhk_MTTS_Close("")
	print(sv_u)
	print(BANCS.OUTPARAM.MTTTranId)
	if (BANCS.OUTPARAM.MTTTranId!="") then
	#{
		print(BANCS.OUTPARAM.MTTTranId)
	#}
	endif
ENDOFSCRIPT:
        exitscript
###trace off
