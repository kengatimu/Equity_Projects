IF (FIELDEXISTS(BANCS.OUTPUT.TranRemarks) == 1) THEN
        BANCS.OUTPUT.TranRemarks=MID$(BANCS.OUTPUT.TranRemarks,0,30)
        print(BANCS.OUTPUT.TranRemarks)
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.RefNum) == 1) THEN
        BANCS.OUTPUT.RefNum=MID$(BANCS.OUTPUT.RefNum,0,20)
        print(BANCS.OUTPUT.RefNum)
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.TranParticulars) == 1) THEN
        BANCS.OUTPUT.TranParticulars = MID$(BANCS.OUTPUT.TranParticulars,0,50)
        print(BANCS.OUTPUT.TranParticulars)
        #vp Mkey Fix
        if(BANCS.INPUT.ReservedField2=="MPESADT")then
                if(fieldexists(BANCS.INPUT.ReservedField1)==1)then
                        BANCS.INPUT.cdate = left$(BANCS.STDIN.sysDate,10)
                        BANCS.INPUT.ctime = trim(mid$(BANCS.STDIN.sysDate,10,9))
                        ##BANCS.OUTPUT.TranParticulars = BANCS.INPUT.ReservedField1 + "/MkeyLoanVal" + BANCS.OUTPUT.RefNum
                        BANCS.OUTPUT.TranParticulars = BANCS.INPUT.ReservedField1 + "/" + BANCS.INPUT.cdate + "/" +BANCS.INPUT.ctime
                        BANCS.OUTPUT.TranParticulars = mid$(BANCS.OUTPUT.TranParticulars,0,50)
                else
                        BANCS.OUTPUT.TranParticulars = mid$(BANCS.OUTPUT.TranParticulars,0,50)
                endif
        endif
        #vp Otherbank Fix 02/07/2019
        if ((BANCS.INPUT.DccId=="TPG") OR (BANCS.INPUT.DccId=="PWE"))then
        if((BANCS.INPUT.ReservedField2=="REMITTANCE") and (BANCS.INPUT.CrForacid=="0180263995747"))then
                sv_s = "rrnNum,otherBank,freeTxt| "
                sv_s = sv_s + "select regexp_substr('"+BANCS.INPUT.CardAcceptorName+"' ,'[^  ]+',1,1) as rrnNum, "
                sv_s = sv_s + " regexp_substr('"+BANCS.INPUT.CardAcceptorName+"' ,'[^  ]+',1,2)as otherBank, "
                sv_s = sv_s + " regexp_substr('"+BANCS.INPUT.CardAcceptorName+"' ,'[^  ]+',1,3)as freeTxt from dual "
                print(sv_s)
                sv_u = urhk_dbSelectWithBind(sv_s)
                if(sv_u==0)then
                        BANCS.INPUT.rrnNum = BANCS.OUTPARAM.rrnNum
                        BANCS.INPUT.otherBank = BANCS.OUTPARAM.otherBank
                        BANCS.INPUT.freeTxt = BANCS.OUTPARAM.freeTxt
                else
                        BANCS.INPUT.rrnNum = "NA"
                        BANCS.INPUT.otherBank = "NA"
                        BANCS.INPUT.freeTxt = "NA"
                endif
                BANCS.OUTPUT.TranParticulars = BANCS.INPUT.DccId +"/" +BANCS.INPUT.rrnNum+"/" +BANCS.INPUT.otherBank+ "/" + BANCS.INPUT.freeTxt
                BANCS.OUTPUT.TranParticulars = mid$(BANCS.OUTPUT.TranParticulars,0,50)
        endif
        endif
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.TranParticulars2) == 1) THEN
        BANCS.OUTPUT.TranParticulars2 = MID$(BANCS.OUTPUT.TranParticulars2,0,50)
        print(BANCS.OUTPUT.TranParticulars2)
ENDIF
IF (BANCS.INPUT.DccId == "EAZ")  THEN
        IF (BANCS.INPUT.ReservedField2 =="P2PIntra")  THEN
                BANCS.OUTPUT.TranParticulars2 = BANCS.INPUT.ReservedField2 + "/" + LTRIM(BANCS.INPUT.ReservedField3,'0')
                print(BANCS.OUTPUT.TranParticulars2)
        ENDIF
        IF (BANCS.INPUT.ReservedField2 =="UNBLOCK")  THEN
                IF ((BANCS.INPUT.PartTranType=="C") OR (BANCS.INPUT.PartTranType=="D")) THEN
                        BANCS.OUTPUT.TranParticulars2 = BANCS.INPUT.CardAcceptorName +"/" + BANCS.INPUT.ReservedField2 +"/" + BANCS.OUTPUT.RefNum
                        print(BANCS.OUTPUT.TranParticulars2)
                ENDIF
        ENDIF
        IF (BANCS.INPUT.ReservedField2 =="Evalue") THEN
                sv_r=mid$(CUST.ATM.command,2,4)
                print(sv_r)
                IF (sv_r!="RR") THEN
                        ##CALL ("timekamaonline.scr")
                ENDIF
        ENDIF
ENDIF
#------Edwin mpesarecon RRN mapping 03/03/2020
if (fieldexists(BANCS.INPUT.CrForacid)==1) then
        if ((BANCS.INPUT.CrForacid=="0001400303015") OR (BANCS.INPUT.CrForacid=="0001400301528")) then
                BANCS.OUTPUT.TranParticulars2= LTRIM(BANCS.INPUT.ReservedField3,'0')
                if (BANCS.INPUT.Foracid!="")then
                        BANCS.OUTPUT.TranParticulars2= LTRIM(BANCS.INPUT.ReservedField3,'0')
                endif
                if (BANCS.INPUT.DccId=="BWY") then
