                                BANCS.OUTPUT.TranParticulars2 = CUST.ATM.statusbillebb
                                BANCS.OUTPUT.TranRemarks = MID$(BANCS.INPUT.ReservedField3,0,50)
                                if (BANCS.INPUT.Foracid!="") then
                                        BANCS.OUTPUT.TranParticulars2 = CUST.ATM.statusbillebb
                                        BANCS.OUTPUT.TranRemarks = MID$(BANCS.INPUT.ReservedField3,0,50)
                                endif
                        endif
                endif
        endif
endif
