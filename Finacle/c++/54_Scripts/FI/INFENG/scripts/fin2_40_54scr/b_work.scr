sv_q = sv_q + "select foracid,schm_code,del_flg,gl_sub_head_code,schm_type,ACCT_STATUS,acct_crncy_code,clr_bal_amt "
sv_q = sv_q + "from tbaadm.gam a,tbaadm.smt b where a.BANK_ID = ?SVAR and sol_id = ?SVAR AND a.acid=b.acid and a.bank_id=b.bank_id and b.ACCT_STATUS='D' "
sv_q = sv_q + "and schm_type in ('CAA','SBA') and schm_code not in ('SB199','CA299','SB135','SB136') and clr_bal_amt > ?SVAR "
sv_q = sv_q + "and acct_crncy_code = 'EUR' "
sv_q = sv_q + "union "
sv_q = sv_q + "select foracid,schm_code,del_flg,gl_sub_head_code,schm_type,ACCT_STATUS,acct_crncy_code,clr_bal_amt "
sv_q = sv_q + "from tbaadm.gam a,tbaadm.smt b where a.BANK_ID = ?SVAR and sol_id = ?SVAR AND a.acid=b.acid and a.bank_id=b.bank_id and b.ACCT_STATUS='D' "
sv_q = sv_q + "and schm_type in ('CAA','SBA') and schm_code not in ('SB199','CA299','SB135','SB136') and clr_bal_amt > ?SVAR "
sv_q = sv_q + "and acct_crncy_code = 'GBP' "
sv_q = sv_q + "union "
sv_q = sv_q + "select foracid,schm_code,del_flg,gl_sub_head_code,schm_type,ACCT_STATUS,acct_crncy_code,clr_bal_amt "
sv_q = sv_q + "from tbaadm.gam a,tbaadm.smt b where a.BANK_ID = ?SVAR and sol_id = ?SVAR AND a.acid=b.acid and a.bank_id=b.bank_id and b.ACCT_STATUS='D' "
sv_q = sv_q + "and schm_type in ('CAA','SBA') and schm_code not in ('SB199','CA299','SB135','SB136') and clr_bal_amt > ?SVAR "
