#sv_q="custId,schmcode,delflg,glsubheadcode,schmtype,acctstatus|"
#sv_q = sv_q + "select foracid,schm_code,del_flg,gl_sub_head_code,schm_type,ACCT_STATUS from tbaadm.gam a,tbaadm.smt b where a.BANK_ID = ?SVAR AND a.acid=b.acid and b.ACCT_STATUS='D' and  sol_id=?SVAR and schm_type in ('CAA','SBA') and schm_code not in ('SB199','CA299') and clr_bal_amt >100000"
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  sv_b + "|" + CUST.DATA.kesAmount
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" +  sv_b + "|" + CUST.DATA.eurAmount
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" +  sv_b + "|" + CUST.DATA.gbpAmount
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId + "|" +  sv_b + "|" + CUST.DATA.usdAmount
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
    sv_q = urhk_dbCursorFetch(sv_m)
    print(sv_q)

       IF(sv_q == 1) THEN
         sv_x = urhk_dbCursorClose(sv_m)
         print(sv_x)
         exitscript
       ENDIF
       print(sv_q)

while(sv_q==0)
        sv_r = REPEXISTS("STDWFS")
	IF (sv_r == 0) THEN
		CREATEREP("STDWFS")
	ENDIF

	sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
	IF (sv_r == 0) THEN
	     CREATECLASS("STDWFS", "GLBDATA", 5)
	ENDIF

	sv_r = CLASSEXISTS("STDWFS", "WFSLIST")
