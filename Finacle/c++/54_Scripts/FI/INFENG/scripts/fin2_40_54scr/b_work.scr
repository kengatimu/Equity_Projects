sv_q = sv_q + "from tbaadm.gam a,tbaadm.smt b where a.BANK_ID = ?SVAR and sol_id = ?SVAR AND a.acid=b.acid and a.bank_id=b.bank_id and b.ACCT_STATUS='D' "
