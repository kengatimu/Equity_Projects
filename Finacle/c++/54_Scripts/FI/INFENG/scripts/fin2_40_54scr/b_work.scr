sv_s = " euroRate,gbpRate,usdRate|"
sv_s = sv_s + "select EUR as CRNCY_EUR,GBP as CRNCY_GBP,USD as CRNCY_USD from "
sv_s = sv_s + "(SELECT BANK_ID,(case when FXD_CRNCY_CODE = 'EUR' THEN  VAR_CRNCY_UNITS END )EUR "
sv_s = sv_s + "FROM TBAADM.RTL WHERE FXD_CRNCY_CODE = 'EUR'  "
sv_s = sv_s + "AND VAR_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR)a, "
sv_s = sv_s + "(SELECT BANK_ID,(case when FXD_CRNCY_CODE = 'GBP' THEN  VAR_CRNCY_UNITS END )GBP "
sv_s = sv_s + "FROM TBAADM.RTL WHERE FXD_CRNCY_CODE = 'GBP'  "
sv_s = sv_s + "AND VAR_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR)b, "
sv_s = sv_s + "(SELECT BANK_ID,(case when FXD_CRNCY_CODE = 'USD' THEN  VAR_CRNCY_UNITS END )USD "
sv_s = sv_s + "FROM TBAADM.RTL WHERE FXD_CRNCY_CODE = 'USD'  "
sv_s = sv_s + "AND VAR_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR)c "
sv_s = sv_s + "WHERE a.BANK_ID = b.BANK_ID "
sv_s = sv_s + "and a.BANK_ID = c.BANK_ID "
print (sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)

sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF (sv_d == 0) THEN
#{
	CUST.DATA.euroRate = BANCS.OUTPARAM.euroRate 
