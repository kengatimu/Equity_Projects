	STDWFS.GLBDATA.acctstatus=BANCS.OUTPARAM.acctstatus
	print(STDWFS.GLBDATA.acctstatus)

	
	  sv_a=urhk_SetUrhkInp("xferAcct.foracid|" + STDWFS.GLBDATA.custId)

