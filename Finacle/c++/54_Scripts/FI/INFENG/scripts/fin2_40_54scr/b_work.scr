	CUST.DATA.gbpAmount = CDOUBLE(CUST.DATA.kesAmount)/CDOUBLE(CUST.DATA.gbpRate)
	PRINT(CUST.DATA.gbpAmount)
	CUST.DATA.usdAmount = CDOUBLE(CUST.DATA.kesAmount)/CDOUBLE(CUST.DATA.usdRate)
	PRINT(CUST.DATA.usdAmount)
#}
