#----------------------------------------------------
# Main Logic
#----------------------------------------------------
	### BILLERS START ###
	#----Inclusion for Billers
	sv_s = "countbiller|"
	sv_s = sv_s + "SELECT collection_type FROM CUSTOM.EXTERNAL_SERVICES_ACCNT "
	sv_s = sv_s + " WHERE foracid = ?SVAR AND bank_id= ?SVAR"
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CHQVAL.foracid +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		CUST.CHQVAL.countBiller= BANCS.OUTPARAM.countbiller
		print(CUST.CHQVAL.countBiller)

		IF (CUST.CHQVAL.countBiller==CUST.CHQVAL.collType) THEN
		#{
			CUST.CHQVAL.countBiller ="N"
			print(CUST.CHQVAL.countBiller)
		#}
		ELSE
		#{
			CUST.CHQVAL.countBiller ="Y"
			print(CUST.CHQVAL.countBiller)
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.CHQVAL.countBiller ="O"
	#}
	ENDIF

### BILLERS END ###
	IF ((CUST.CHQVAL.foracid==CUST.CHQVAL.pforacid1) OR (CUST.CHQVAL.foracid==CUST.CHQVAL.pforacid2) OR (CUST.CHQVAL.countBiller =="Y") )THEN
	#{
		#---filter maintained temporary to allow Safaricom dealership validations 

		#--------------------------------------------
		# Setting enviroment variable
		#--------------------------------------------

			#-------------------------------------
			# default Enviroment variable
			#--------------------------------------
			CUST.CHQVAL.OPT="ABC"
			print(CUST.CHQVAL.OPT)
			CUST.CHQVAL.inculude="N"
			CUST.CHQVAL.fee=CUST.CHQVAL.feeGen
			CUST.CHQVAL.refnarrative="Ref. Number"
			CUST.CHQVAL.bennarrative="Benficiary"
			CUST.CHQVAL.partnarrative="Tran Particulars"
			CUST.CHQVAL.inclforcount="Y"
			CUST.CHQVAL.count="0"
			CUST.CHQVAL.refchoice="N"
			CUST.CHQVAL.Product=""
			CUST.CHQVAL.errormsg1="ENTER THE ADMIN/REG/REF NO IN THE Ref. Number FIELD........."
			CUST.CHQVAL.errormsg2="INVALID ADMIN/REG/REF NUMBER"
			CUST.CHQVAL.errormsg3="ENTER VALID REMARKS IN THE Tran Particulars FIELD........."
			
			#-----------------------------------------
			# inculusion for safaricom dealers account
			#-----------------------------------------
			IF (CUST.CHQVAL.foracid==CUST.CHQVAL.pforacid1) THEN 
			#{
				CUST.CHQVAL.OPT="XYZ"
				CUST.CHQVAL.ctsprimary="Y"
				CUST.CHQVAL.fee=CUST.CHQVAL.feeAc1
				CUST.CHQVAL.count ="0"
				CUST.CHQVAL.inculude="Y"
				CUST.CHQVAL.inclforcount="N"
				CUST.CHQVAL.refnarrative="Dealer Code"
				CUST.CHQVAL.bennarrative="Dealer Name"
				CUST.CHQVAL.errormsg1="ENTER THE DEALER CODE IN THE Dealer Code. FIELD........."
				CUST.CHQVAL.errormsg2="INVALID DEALER CODE"
				CUST.CHQVAL.errormsg4="ENTER THE DEALER NAME IN THE Dealer Name. FIELD........."
			#}
			ENDIF
			
			#-----------------------------------------
			#-----Equity Insuarance Env
			#-----------------------------------------
			IF (CUST.CHQVAL.foracid==CUST.CHQVAL.pforacid2) THEN 
			#{
				CUST.CHQVAL.OPT="UVW"
				CUST.CHQVAL.ctsprimary="Y"
				CUST.CHQVAL.fee=CUST.CHQVAL.feeAc2
				CUST.CHQVAL.count ="0"
				CUST.CHQVAL.inculude="Y"
				CUST.CHQVAL.inclforcount="N"
				CUST.CHQVAL.refnarrative="Risk Note(Y/N)"
				CUST.CHQVAL.bennarrative="Client Name"
				CUST.CHQVAL.partnarrative="Description"
				CUST.CHQVAL.count="1"
				CUST.CHQVAL.errormsg1="ENTER THE RISK NOTE NUMBER/ CLIENT ID.........."
				CUST.CHQVAL.errormsg2="INVALID RISK NOTE NUMBER/ CLIENT ID"
			#}
			ENDIF

			IF (CUST.CHQVAL.countBiller =="Y") THEN
			#{
				CUST.CHQVAL.OPT="RST"
				CUST.CHQVAL.ctsprimary="Y"
				CUST.CHQVAL.fee=CUST.CHQVAL.feebil
				CUST.CHQVAL.count ="0"
				CUST.CHQVAL.inculude="Y"
				CUST.CHQVAL.inclforcount="N"
				CUST.CHQVAL.refnarrative="Bill Code"
				CUST.CHQVAL.bennarrative="Bill Name"
				CUST.CHQVAL.errormsg1="ENTER THE BILL CODE IN THE Bill Code. FIELD........."
				CUST.CHQVAL.errormsg2="INVALID BILL CODE"
				CUST.CHQVAL.errormsg4="ENTER THE BILL NAME IN THE Bill Name. FIELD........."
			#}
			ENDIF


		#--------------------------------------------
		# Customization for CTS zones 
		#--------------------------------------------
		IF ((CUST.CHQVAL.zoneCode==CUST.CHQVAL.pZoneCd1) OR (CUST.CHQVAL.zoneCode==CUST.CHQVAL.pZoneCd2))  THEN
		#{
			print("Starting the CTS  addtional data cupture process...........")
			IF ((CUST.CHQVAL.zoneDate!="") and (CUST.CHQVAL.zoneCode!="") and (CUST.CHQVAL.setNum!="")) THEN
			#{
				#--------------------------------------------
				# checking for collection accounts
				#--------------------------------------------
					sv_s = "acctName,schmCode|"
					sv_s = sv_s + "SELECT acct_name, schm_code "
					sv_s = sv_s + "FROM TBAADM.GAM "
					sv_s = sv_s + "WHERE foracid=?SVAR "
					sv_s = sv_s + "AND entity_cre_flg='Y' "
					sv_s = sv_s + "AND del_flg='N' "
					sv_s = sv_s + "AND bank_id=?SVAR"
					print(sv_s)
	
					BANCS.INPARAM.BINDVARS = CUST.CHQVAL.foracid +"|"+ BANCS.STDIN.contextBankId
                    			PRINT(BANCS.INPARAM.BINDVARS)
                    			sv_d = urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF (sv_d==0) THEN
					#{
						CUST.CHQVAL.acctName= BANCS.OUTPARAM.acctName
						CUST.CHQVAL.schmCode= BANCS.OUTPARAM.schmCode
						print(CUST.CHQVAL.acctName)		
						print(CUST.CHQVAL.schmCode)
					#}
					ENDIF

					IF ((CUST.CHQVAL.schmCode==CUST.CHQVAL.pSchmCd1) OR (CUST.CHQVAL.schmCode==CUST.CHQVAL.pSchmCd2) OR (CUST.CHQVAL.inculude=="Y")) THEN
					#{
						CUST.CHQVAL.inculude="Y"
						CUST.CHQVAL.ctsprimary="Y"
						#Send to JSP
						GOTO Finish
					#}
					ELSE
					#{
						GOTO Finish
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
Finish:
