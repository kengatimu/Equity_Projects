<--START
CHECKSUM="229405a1e683714586299ad10bee7b014f3427e551a4d03a5a5a4fe1e771854d"
	TRACE ON
	
	#-----------------------------------------------------------------------------------------------
	# Creating Repository
	#-----------------------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LAATRANTREV") == 0) THEN
	#{
		CREATECLASS("CUST","LAATRANTREV", 5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM", 5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# Initializing the variables
	#-----------------------------------------------------------------------------------------------
	CUST.LAATRANTREV.errMsg     = ""
	CUST.LAATRANTREV.foracid1   = ""
	CUST.LAATRANTREV.BODDate 	= LEFT$(BANCS.STDIN.BODDate,10)
	PRINT(CUST.LAATRANTREV.BODDate)
	
	#-----------------------------------------------------------------------------------------------
	# Getting all the values from CPARAM
	#-----------------------------------------------------------------------------------------------
	BANCS.INPUT.moduleName 	= "LAA_TRANT_REV"
	BANCS.INPUT.parameterId = "LA_TR_BACID"
	CALL ("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.bacid = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.bacid)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "CPARAM setup not done for Bacid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "LAA_TRANT_REV"
	BANCS.INPUT.parameterId = "LA_TR_DATE"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.date = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.date)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "CPARAM setup not done for Date"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "LAA_TRANT_REV"
	BANCS.INPUT.parameterId = "LA_TR_MAN_C_SYS"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.mainClassSys = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.mainClassSys)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "CPARAM setup not done for mainClassSys "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "LAA_TRANT_REV"
	BANCS.INPUT.parameterId = "LA_TR_BACID_CR"
	CALL ("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.crBacid = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.crBacid)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "CPARAM setup not done for Bacid1"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "LAA_TRANT_REV"
	BANCS.INPUT.parameterId = "LA_TR_TRAN_RMKS"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.tranRmks = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tranRmks)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "CPARAM setup not done Tran Remark"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "LAA_TRANT_REV"
	BANCS.INPUT.parameterId = "LA_TR_TRAN_PART"
	CALL("getcparamvalue.scr")
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.tranParts = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tranParts)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "CPARAM setup not done for Trans Particular"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	CALL ("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.refCode = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.refCode)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "NORRATECODE setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------
	#  The bacid for Shadow Balance Cahrge Income Account
	#  & validation for the bacid. if the account is not exist then
	#  it will generate a report and send to PR menu
	#------------------------------------------------------------------
	sv_i = CUST.CPARAM.crBacid+ "|" +BANCS.STDIN.homeCrncyCode+ "|" +BANCS.STDIN.mySolId
	PRINT(sv_i)
	sv_u = urhk_B2k_BacidToAcctId(sv_i)
	PRINT(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.LAATRANTREV.crAcctNo = BANCS.OUTPARAM.AcctId
		PRINT(CUST.LAATRANTREV.crAcctNo)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "CPARAM setup not done for bacid1 is not correct "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Selecting transactions to be reversed
	#--------------------------------------------------------------------------
	sv_s =          " foracid,tranAmt,opacid,bacid1,cforacid|"
	sv_s = sv_s +   " SELECT GAM.foracid,ACPART.tran_amt,ACPART.b2k_id,GAM.bacid,GAM.foracid"
	sv_s = sv_s +   " FROM TBAADM.ACPART,TBAADM.GAM,TBAADM.ACD,TBAADM.GAC "
	sv_s = sv_s +   " WHERE GAM.acid = ACPART.partitioned_acid"
	sv_s = sv_s +   " AND GAM.bank_id = ACPART.bank_id"
	sv_s = sv_s +   " AND GAC.acid=ACPART.b2k_id"
	sv_s = sv_s +   " AND GAC.bank_id = ACPART.bank_id"
	sv_s = sv_s +   " AND ACPART.b2k_id = ACD.b2k_id"
	sv_s = sv_s +   " AND ACPART.bank_id = ACD.bank_id"
	sv_s = sv_s +   " AND GAM.acid = ACPART.b2k_id"
	sv_s = sv_s +   " AND ACPART.b2k_type = ACD.b2k_type"
	sv_s = sv_s +   " AND ACPART.b2k_type = 'ACCNT'"
	sv_s = sv_s +   " AND ACD.main_classification_system = ?SVAR"
	sv_s = sv_s +   " AND ACPART.partitioned_acid IN"
	sv_s = sv_s +                           " (SELECT acid"
	sv_s = sv_s +                           " FROM TBAADM.GAM"
	sv_s = sv_s +                           " WHERE bacid = ?SVAR"
	sv_s = sv_s +                           " AND sol_id = ?SVAR"
	sv_s = sv_s +                           " AND GAM.bank_id = ACD.bank_id)"
	sv_s = sv_s +   " AND ACPART.pstd_flg = 'Y'"
	sv_s = sv_s +   " AND ACPART.part_tran_type = 'C'"
	sv_s = sv_s +   " AND tran_date >nvl(to_date(FREE_TEXT_14,'dd-mm-yyyy'),to_date(?SVAR,'dd-mm-yyyy'))"
	sv_s = sv_s +   " AND GAM.SOL_ID  = ?SVAR"
	sv_s = sv_s +   " AND GAM.bank_id = ?SVAR"
	
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.mainClassSys + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.bacid + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.CPARAM.date + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.mySolId + "|"
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
	
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbcursorOpenWithBind(sv_s)
	PRINT(sv_c)
	IF (sv_c == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
		CUST.LAATRANTREV.mainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.LAATRANTREV.mainCursor)
		#}
	ELSE
		#{
		CUST.LAATRANTREV.errMsg = "Error in opening cursor"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	#--------------------------------------------------------------------------
	# code for creating tranxs like individual debit from customer and
	# consolidated credit to the income Account.
	#--------------------------------------------------------------------------
	
	WHILE (sv_c == 0)
	#{
		CUST.LAATRANTREV.partSrlNo 	= 0
		sv_c = urhk_dbCursorFetch(CUST.LAATRANTREV.mainCursor)
		PRINT(sv_c)
		IF (sv_c != 0) THEN
		#{
			sv_s = ""
			sv_s = sv_s + " DELETE"
			sv_s = sv_s + " FROM CUSTOM.C_MOC"
			sv_s = sv_s + " WHERE sol_id= ?SVAR"
			sv_s = sv_s + " AND tran_date= to_date(?SVAR,'dd-mm-yyyy')"
			sv_s = sv_s + " AND bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS= BANCS.STDIN.mySolId + "|" + CUST.LAATRANTREV.BODDate + "|" + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			sv_d = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_d)
			
			IF (sv_d == 0) THEN
			#{
				sv_d = urhk_dbSQLWithBind("COMMIT")
				PRINT(sv_d)
				#}
			ELSE
				#{
				CUST.LAATRANTREV.errMsg = "Problem in Deletion of Record of Custom Table"
			#}
			ENDIF
			
			#------------------------------------------------------------------------------------------------------------------
			#--Closing the Cursor
			#------------------------------------------------------------------------------------------------------------------
			sv_d = urhk_dbCursorClose(CUST.LAATRANTREV.mainCursor )
			PRINT(sv_d)
			sv_c = 1
			
			#}
		ELSE
			#{
			CUST.LAATRANTREV.foracid1   = BANCS.OUTPARAM.foracid
			CUST.LAATRANTREV.foracid    = BANCS.OUTPARAM.opacid
			CUST.LAATRANTREV.cforacid   = BANCS.OUTPARAM.cforacid
			CUST.LAATRANTREV.tranAmt    = BANCS.OUTPARAM.tranAmt
			CUST.LAATRANTREV.bacid      = BANCS.OUTPARAM.bacid1
			PRINT(CUST.LAATRANTREV.foracid1)
			PRINT(CUST.LAATRANTREV.foracid)
			PRINT(CUST.LAATRANTREV.tranAmt)
			PRINT(CUST.LAATRANTREV.bacid)
			PRINT(CUST.LAATRANTREV.cforacid)
			
			#---------------------------------------------------------------
			# Passing transaction inputs to the service
			# Adding and Posting the transaction
			#---------------------------------------------------------------
			sv_i = CUST.LAATRANTREV.bacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
			PRINT(sv_i)
			sv_u = urhk_B2k_BacidToAcctId(sv_i)
			PRINT(sv_u)
			
			IF (sv_u == 1 ) THEN
			#{
				CUST.LAATRANTREV.errMsg = "Debit account Bacid is incorrent"
				GOTO NEXTREC
			#}
			ENDIF
			
			CUST.LAATRANTREV.drAcctNo = BANCS.OUTPARAM.AcctId
			PRINT(CUST.LAATRANTREV.drAcctNo)
			
			CUST.LAATRANTREV.totalAmt=CDOUBLE(CUST.LAATRANTREV.tranAmt)
			
			#-----------------------------------------------------------------------------------------------------
			#--Transaction Header
			#-----------------------------------------------------------------------------------------------------
			sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
			sv_u = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
			sv_u = urhk_SetUrhkInp("tranHdr.tranRmks|"+CUST.CPARAM.tranRmks)
			sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
			sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
			
			#-----------------------------------------------------
			# Add partTran0 (credit)
			#-----------------------------------------------------
			CUST.LAATRANTREV.partSrlNo = CINT(CUST.LAATRANTREV.partSrlNo) + 1
			CUST.LAATRANTREV.recVal=FORMAT$(CINT(CUST.LAATRANTREV.partSrlNo) - 1,"%d")
			sv_a = "tranDtl.partTranDetailLL.<rec_"+CUST.LAATRANTREV.recVal+">."
			PRINT(sv_a)
			sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+CUST.LAATRANTREV.partSrlNo)
			sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|C")
			sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.LAATRANTREV.crAcctNo)
			sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.LAATRANTREV.totalAmt+"|"+ BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|"+CUST.CPARAM.tranParts)
			sv_u = urhk_SetUrhkInp(sv_a + "refNum| ")
			sv_u = urhk_SetUrhkInp(sv_a + "tranRmks|"+CUST.LAATRANTREV.foracid)
			sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.LAATRANTREV.totalAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.CPARAM.refCode)
			
			#---------------------------------------------------------
			# Add partTran1  (debit)
			#---------------------------------------------------------
			CUST.LAATRANTREV.partSrlNo = CINT(CUST.LAATRANTREV.partSrlNo) + 1
			CUST.LAATRANTREV.recVal=FORMAT$(CINT(CUST.LAATRANTREV.partSrlNo) - 1,"%d")
			sv_b = "tranDtl.partTranDetailLL.<rec_"+CUST.LAATRANTREV.recVal+">."
			PRINT(sv_b)
			sv_u = urhk_SetUrhkInp(sv_b + "key.serial_num|"+CUST.LAATRANTREV.partSrlNo)
			sv_u = urhk_SetUrhkInp(sv_b + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "partTranType.code|D")
			sv_u = urhk_SetUrhkInp(sv_b + "acctId.foracid|"+CUST.LAATRANTREV.drAcctNo)
			sv_u = urhk_SetUrhkInp(sv_b + "valueDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "glDate|"+BANCS.STDIN.BODDate)
			sv_u = urhk_SetUrhkInp(sv_b + "tranAmt|"+CUST.LAATRANTREV.totalAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "tranParticulars|"+CUST.CPARAM.tranParts)
			sv_u = urhk_SetUrhkInp(sv_b + "refNum| ")
			sv_u = urhk_SetUrhkInp(sv_b + "tranRmks|"+CUST.LAATRANTREV.foracid)
			sv_u = urhk_SetUrhkInp(sv_b + "refCrncyCode.crncyCode|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "refAmt|"+CUST.LAATRANTREV.totalAmt+"|"+BANCS.STDIN.homeCrncyCode)
			sv_u = urhk_SetUrhkInp(sv_b + "entryUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_b + "vfdUserId.userId|" + BANCS.STDIN.userId)
			sv_u = urhk_SetUrhkInp(sv_b + "addnlDtl.parttnDtl.parttnDtlEntered|1")
			sv_u = urhk_SetUrhkInp(sv_b + "addnlDtl.parttnDtl.entity.entityType|ACCNT")
			sv_u = urhk_SetUrhkInp(sv_b + "addnlDtl.parttnDtl.entity.entityDispId|"+CUST.LAATRANTREV.cforacid)
			sv_u = urhk_SetUrhkInp(sv_b + "rateCode.refCode|" + CUST.CPARAM.refCode)
			
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			
			sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
			
			PRINT(sv_u)
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_AddXferTran|retain_all_output = Y")
				PRINT(sv_u)
				IF (sv_u != 0) THEN
				#{
					GOTO TRANERR
				#}
				ENDIF
			#}
			ENDIF
			
			IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
			#{
				PRINT(BANCS.OUTPARAM.tranId)
				#}
			ELSE
				#{
				CUST.LAATRANTREV.errMsg = "Tansaction Id not generated"
				GOTO NEXTREC
			#}
			ENDIF
			
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
			PRINT(sv_u)
			
			IF (sv_u != 0) THEN
			#{
				GOTO TRANERR
			#}
			ENDIF
			
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
			
			PRINT(sv_u)
			
			IF (sv_u != 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_ExecSrv("SRV_PostTran|retain_all_output = Y")
				PRINT(sv_u)
				IF (sv_u != 0) THEN
				#{
					GOTO TRANERR
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		#-----------------------------------------------------------------------------------------------------
		#---updating gac
		#-----------------------------------------------------------------------------------------------------
		
		IF(CUST.LAATRANTREV.foracid1 != "" ) THEN
		#{
			sv_u = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|"+CUST.LAATRANTREV.foracid1)
			sv_u = urhk_ExecSrv("SRV_FetchLAAcctDtlForModify|retain_all_output = Y")
			PRINT(sv_u)
			
			IF (sv_u == 0) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText14|"+CUST.LAATRANTREV.BODDate)
				sv_u = urhk_ExecSrv("SRV_ModifyLAAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
			#}
			ENDIF
		#}
		ENDIF
		
		TRANERR:
			IF (sv_u != 0) THEN
			#{
				IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_i = sv_i + 1
						sv_u = SYSTEM("echo '"+sv_e+"' >>LAATRANTREV.log")
						PRINT(sv_u)
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			
		NEXTREC:
			
		#}
		DO
		
	ENDOFSCRIPT:
		
		IF (CUST.LAATRANTREV.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.LAATRANTREV.errMsg+"' >>LAATRANTREV.log")
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
END-->
