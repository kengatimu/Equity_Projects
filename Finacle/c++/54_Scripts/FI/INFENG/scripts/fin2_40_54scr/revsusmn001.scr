#----------------------------------------------------------------------------------------------
<--START
CHECKSUM="3005897a3fb4777b7b052edd82a028b6ee996f45aa9f5609ee6076b7de84d8d3"
	TRACE ON
	
	IF(REPEXISTS("CUST") == 0)THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "SUSP")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "SUSP", 5)
	#}
	ENDIF
	
	CUST.SUSP.errMsg = ""
	
	BANCS.INPUT.moduleName = "REVSUSP"
	BANCS.INPUT.parameterId = "SUSPBACID"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SUSP.suspBacid = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SUSP.errMsg = "CPARAM setup not done for BACID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CLASSSYSTEM"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SUSP.classSystem = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SUSP.errMsg = "CPARAM setup not done for Main Classification System"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TRANDATE"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SUSP.tranDate = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SUSP.errMsg = "CPARAM setup not done for TRAN DATE"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "PLBACID"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SUSP.plBacid = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SUSP.errMsg = "CPARAM setup not done for BACID"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TRANRMKS"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SUSP.tranRmks = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SUSP.tranRmks = "Batch reversal of suspended Interest"
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TRANPARTCLRS"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SUSP.tranPartclrs = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SUSP.errMsg = "Susp Rev Batch"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "GENERAL"
	BANCS.INPUT.parameterId = "NORRATECODE"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.SUSP.rateCode = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.SUSP.errMsg = "CPARAM setup not done for RATE CODE"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#--------------------------------------------------------------------------
	# SELECTing BOD DATE AND SOLID
	#--------------------------------------------------------------------------
	
	CUST.SUSP.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
	#sv_y = MID$(CUST.SUSP.bodDate,6,4)
	#PRINT(sv_y)
	
	PRINT(BANCS.STDIN.mySolId)
	
	sv_s = "timestamp|"
	sv_s = sv_s + " select to_char(sysdate,'ddmmyyhh24miss')"
	sv_s = sv_s + " from dual"
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d ==0) THEN
	#{
		CUST.SUSP.timestamp = BANCS.OUTPARAM.timestamp
		#}
	ELSE
		#{
		CUST.SUSP.timestamp = ""
	#}
	ENDIF
	
	#--------------------------------------------------------------------------
	# Fetch PL account
	#--------------------------------------------------------------------------
	PRINT(CUST.SUSP.plBacid)
	PRINT(BANCS.STDIN.homeCrncyCode)
	PRINT(BANCS.STDIN.mySolId)
	sv_i = CUST.SUSP.plBacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
	PRINT(sv_i)
	sv_u = urhk_B2k_BacidToAcctId(sv_i)
	PRINT(sv_u)
	IF (sv_u == 1) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.SUSP.pnlAccnt = BANCS.OUTPARAM.AcctId
	PRINT(CUST.SUSP.pnlAccnt)
	
	#---------------------------------------------------------------
	# Get the transaction level header details from BANCS repository
	#---------------------------------------------------------------
	sv_u = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranType|T")
	sv_u = urhk_SetUrhkInp("transferTranHdr.tranTypeSubType.tranSubType|BI")
	sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|I")
	sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
	sv_u = urhk_SetUrhkInp("tranDtl.remarks|"+CUST.SUSP.tranRmks)
	
	
	#--------------------------------------------------------------------------
	# SELECTing transactions to be reversed
	#--------------------------------------------------------------------------
	
	sv_s = "foracid,tranAmt,opAcid,bacid1,custForacid|"
	sv_s = sv_s + "SELECT GAM.foracid,SUM(DECODE(part_tran_type,'D',-1*tran_amt,tran_amt)),ACPART.b2k_id,GAM.bacid,GAM.foracid "
	sv_s = sv_s + "FROM TBAADM.ACPART,TBAADM.GAM,TBAADM.ACD,TBAADM.GAC "
	sv_s = sv_s + "WHERE GAM.acid = ACPART.partitioned_acid "
	sv_s = sv_s + "AND GAC.acid = ACPART.b2k_id "
	sv_s = sv_s + "AND ACPART.b2k_id = ACD.b2k_id "
	#sv_s = sv_s + "AND GAM.acid = ACPART.b2k_id "
	sv_s = sv_s + "AND ACPART.b2k_type = ACD.b2k_type "
	sv_s = sv_s + "AND ACPART.b2k_type = 'ACCNT' "
	sv_s = sv_s + "AND ACD.main_classification_system = ?SVAR "
	sv_s = sv_s + "AND pstd_flg = 'Y' "
	sv_s = sv_s + "AND GAM.bank_id = ACD.bank_id "
	sv_s = sv_s + "AND GAM.bank_id = GAC.bank_id "
	sv_s = sv_s + "AND GAM.bank_id = ACPART.bank_id "
	sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
	sv_s = sv_s + "AND GAM.del_flg = 'N' "
	sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + "AND tran_date >= NVL(TO_DATE(free_text_10,'DD-MM-YYYY'),TO_DATE(?SVAR,'DD-MM-YYYY')) "
	sv_s = sv_s + "AND GAM.bacid = ?SVAR "
	sv_s = sv_s + "AND GAM.acct_crncy_code = ?SVAR "
	sv_s = sv_s + "AND GAM.SOL_ID  = ?SVAR "
	sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + "GROUP BY GAM.foracid,ACPART.b2k_id,GAM.bacid "
	sv_s = sv_s + "HAVING SUM(DECODE(part_tran_type, 'D', -1 * tran_amt, tran_amt)) > 0 "
	PRINT(sv_s)
	CUST.SUSP.revsusqry = sv_s
	BANCS.INPARAM.BINDVARS =  CUST.SUSP.classSystem + "|" + CUST.SUSP.tranDate + "|" + CUST.SUSP.suspBacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	CUST.SUSP.revbindvar = BANCS.INPARAM.BINDVARS
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF (sv_c == 0) THEN
	#{
		CUST.SUSP.cursorNo = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.SUSP.cursorNo)
		#}
	ELSE
		#{
		CUST.SUSP.errMsg = "Cursor opening failed"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_q = urhk_dbCursorFetch(CUST.SUSP.cursorNo)
	PRINT(sv_q)
	sv_k = 0
	WHILE(sv_q == 0)
	#{
		CUST.SUSP.susForacid = BANCS.OUTPARAM.foracid
		CUST.SUSP.opAcid = BANCS.OUTPARAM.opAcid
		CUST.SUSP.custForacid = BANCS.OUTPARAM.custForacid
		CUST.SUSP.tranAmt = BANCS.OUTPARAM.tranAmt
		CUST.SUSP.bacid1 = BANCS.OUTPARAM.bacid1
		
		PRINT(CUST.SUSP.susForacid)
		PRINT(CUST.SUSP.opAcid)
		PRINT(CUST.SUSP.tranAmt)
		PRINT(CUST.SUSP.bacid1)
		PRINT(CUST.SUSP.custForacid)
		#--------------------------------------------------------------------------
		# Fetch PL account
		#--------------------------------------------------------------------------
		sv_i = CUST.SUSP.bacid1 + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		IF (sv_u == 1) THEN
		#{
			GOTO NEXTREC
		#}
		ENDIF
		
		CUST.SUSP.SuspAccount = BANCS.OUTPARAM.AcctId
		PRINT(CUST.SUSP.SuspAccount)
		CUST.SUSP.totAmt = CDOUBLE(CUST.SUSP.tranAmt)
		PRINT(CUST.SUSP.totAmt)
		
		#-----------------------------------------------------
		# Passing transaction inputs to the service
		# Adding and Posting the transaction
		#-----------------------------------------------------
		
		IF(CDOUBLE(CUST.SUSP.totAmt) < 0) THEN
		#{
			CUST.SUSP.crDr1 = "D"
			CUST.SUSP.crDr2 = "C"
			CUST.SUSP.totAmt = -1 * CDOUBLE(CUST.SUSP.totAmt)
			print(CUST.SUSP.totAmt)
			#}
		ELSE
			#{
			CUST.SUSP.crDr1 = "C"
			CUST.SUSP.crDr2 = "D"
		#}
		ENDIF
		
		PRINT(CUST.SUSP.crDr1)
		PRINT(CUST.SUSP.crDr2)
		PRINT(CUST.SUSP.totAmt)
		
		PRINT(sv_k)
		sv_a = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_k,"%d")  +">."
		sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+FORMAT$(sv_k,"%d"))
		sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|"+CUST.SUSP.rateCode)
		sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|"+CUST.SUSP.crDr1)
		sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.SUSP.pnlAccnt)
		sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.SUSP.totAmt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refNum| ")
		sv_u = urhk_SetUrhkInp(sv_a + "tranRmks|"+CUST.SUSP.opAcid)
		sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.SUSP.totAmt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "entryUserId.userId|" + BANCS.STDIN.userId)
		sv_u = urhk_SetUrhkInp(sv_a + "vfdUserId.userId|" + BANCS.STDIN.userId)
		sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|" + CUST.SUSP.tranPartclrs)
		sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.SUSP.rateCode)
		sv_k = sv_k + 1
		PRINT(sv_k)
		
		sv_a = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_k,"%d")  +">."
		sv_u = urhk_SetUrhkInp(sv_a + "key.serial_num|"+FORMAT$(sv_k,"%d"))
		sv_u = urhk_SetUrhkInp(sv_a + "pTranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|"+CUST.SUSP.rateCode)
		sv_u = urhk_SetUrhkInp(sv_a + "partTranType.code|"+CUST.SUSP.crDr2)
		sv_u = urhk_SetUrhkInp(sv_a + "acctId.foracid|"+CUST.SUSP.SuspAccount)
		sv_u = urhk_SetUrhkInp(sv_a + "valueDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp(sv_a + "tranAmt|"+CUST.SUSP.totAmt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refNum| ")
		sv_u = urhk_SetUrhkInp(sv_a + "tranRmks|"+CUST.SUSP.opAcid)
		sv_u = urhk_SetUrhkInp(sv_a + "refCrncyCode.crncyCode|" + BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "refAmt|"+CUST.SUSP.totAmt+"|"+ BANCS.STDIN.homeCrncyCode)
		sv_u = urhk_SetUrhkInp(sv_a + "tranParticulars|" + CUST.SUSP.tranPartclrs)
		sv_u = urhk_SetUrhkInp(sv_a + "addnlDtl.parttnDtl.parttnDtlEntered|1")
		sv_u = urhk_SetUrhkInp(sv_a + "addnlDtl.parttnDtl.entity.entityType|ACCNT")
		sv_u = urhk_SetUrhkInp(sv_a + "addnlDtl.parttnDtl.entity.entityDispId|"+CUST.SUSP.custForacid)
		sv_u = urhk_SetUrhkInp(sv_a + "rateCode.refCode|" + CUST.SUSP.rateCode)
		sv_k = sv_k + 1
		
		NEXTREC:
			sv_q = urhk_dbCursorFetch(CUST.SUSP.cursorNo)
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUST.SUSP.cursorNo)
		
		sv_u = urhk_ExecSrv("SRV_AddTransferTran|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			sv_u = urhk_ExecSrv("SRV_PostTransferTran|retain_all_output = Y")
			print(sv_u)
			IF(sv_u != 0 ) THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				sv_u = urhk_ExecSrv("SRV_PostTransferTran|retain_all_output = Y")
			#}
			ENDIF
			
		#}
		ENDIF
		
		IF (sv_u != 0) THEN
		#{
			print(sv_u)
			IF (sv_u != 0) THEN
			#{
				sv_v = BANCS.OUTPARAM.Error_num
				print(BANCS.OUTPARAM.Error_num)
				IF (sv_v > 0) THEN
				#{
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
					#}
					DO
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.tranId)
		#}
		ENDIF
		
		CUST.SUSP.suspAcct = ""
		BANCS.INPARAM.BINDVARS = CUST.SUSP.revbindvar
		sv_c = urhk_dbCursorOpenWithBind(CUST.SUSP.revsusqry)
		PRINT(sv_c)
		IF(sv_c == 0) THEN
		#{
			CUST.SUSP.cursorNo1 = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(CUST.SUSP.cursorNo1)
			WHILE(sv_q ==0)
			#{
				CUST.SUSP.opAcid = BANCS.OUTPARAM.opAcid
				PRINT(CUST.SUSP.opAcid)
				sv_s = "opForacid|SELECT foracid FROM TBAADM.GAM "
				sv_s = sv_s + "WHERE del_flg = 'N' "
				sv_s = sv_s + "AND entity_cre_flg = 'Y' "
				sv_s = sv_s + "AND acid = ?SVAR "
				sv_s = sv_s + "AND bank_id = ?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.SUSP.opAcid + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				#sv_i = CUST.SUSP.bacid1 + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
				#sv_u = urhk_B2k_BacidToAcctId(sv_i)
				IF (sv_d != 0) THEN
				#{
					GOTO NEXTREC1
				#}
				ENDIF
				
				#SBA
				#BANCS.OUTPARAM.opForacid = "0300160656958"
				
				#CAA
				#BANCS.OUTPARAM.opForacid = "0300260656948"
				#BANCS.OUTPARAM.opForacid = "0300260656984"
				
				#Office
				#BANCS.OUTPARAM.opForacid = "0303300100347"
				
				#CLA
				BANCS.OUTPARAM.opForacid = "TEST1234"
				
				#LAA
				#BANCS.OUTPARAM.opForacid = "0300560657005"
				
				CUST.SUSP.opForacid = BANCS.OUTPARAM.opForacid
				PRINT(CUST.SUSP.opForacid)
				
				sv_a = urhk_getAcctDetailsInRepository(CUST.SUSP.opForacid)
				PRINT(sv_a)
				IF(sv_a == 0) THEN
				#{
					CUST.SUSP.schmType = BANCS.OUTPARAM.schmType
					PRINT(CUST.SUSP.schmType)
					CUST.SUSP.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
					PRINT(CUST.SUSP.acctOwnerShip)
					IF ((CUST.SUSP.schmType != "CAA") AND (CUST.SUSP.schmType != "CCA") AND (CUST.SUSP.schmType != "ODA") AND (CUST.SUSP.schmType != "LAA") AND (CUST.SUSP.schmType != "CLA") AND (CUST.SUSP.schmType != "SBA") AND (CUST.SUSP.acctOwnerShip != "O")) THEN
					#{
						GOTO NEXTREC1
					#}
					ENDIF
					#}
				ELSE
					#{
					GOTO NEXTREC1
				#}
				ENDIF
				
				IF (CUST.SUSP.acctOwnerShip == "O") THEN
				#{
					sv_u = urhk_SetUrhkInp("officeAcctDtls.officeOtherDtlsMsg.officeOtherDtls.freeText10|"+LEFT$(BANCS.STDIN.BODDate,10))
					PRINT(sv_u)
					PRINT(CUST.SUSP.opForacid)
					sv_a = urhk_SetUrhkInp("officeAcctDtls.acctBasic.foracid|" + CUST.SUSP.opForacid)
					PRINT(sv_a)
					#}
				ELSE
					#{
					sv_u = urhk_SetUrhkInp("acctCommonInfo.acctClassMISC.freeText10|" + LEFT$(BANCS.STDIN.BODDate,10))
					print(sv_u)
					PRINT("Customer")
					sv_a = urhk_SetUrhkInp("acctCommonInfo.acctGeneralInfo.acctBasic.foracid|" + CUST.SUSP.opForacid)
					print(sv_a)
				#}
				ENDIF
				
				#------------------------------------------------------------------------------------------------------
				# CAA Acct
				#------------------------------------------------------------------------------------------------------
				
				IF (CUST.SUSP.schmType == "CAA") THEN
				#{
					sv_u = urhk_ExecSrv("SRV_FetchCAAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
					print(sv_u)
				#}
				ENDIF
				
				#------------------------------------------------------------------------------------------------------
				# CCA Acct
				#------------------------------------------------------------------------------------------------------
				
				IF (CUST.SUSP.schmType == "CCA") THEN
				#{
					sv_u = urhk_ExecSrv("SRV_FetchCCAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
					print(sv_u)
				#}
				ENDIF
				
				#------------------------------------------------------------------------------------------------------
				# ODA Acct
				#------------------------------------------------------------------------------------------------------
				
				IF (CUST.SUSP.schmType == "ODA") THEN
				#{
					sv_u = urhk_ExecSrv("SRV_FetchODAcctMaintDtlForModify|retain_all_output = Y|same_user_verify = Y")
					print(sv_u)
					
				#}
				ENDIF
				
				#------------------------------------------------------------------------------------------------------
				# LAA Acct
				#------------------------------------------------------------------------------------------------------
				IF (CUST.SUSP.schmType == "LAA") THEN
				#{
					sv_u = urhk_ExecSrv("SRV_FetchLAAcctDtlForModify|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)
				#}
				ENDIF
				
				#------------------------------------------------------------------------------------------------------
				# CLA Acct
				#------------------------------------------------------------------------------------------------------
				IF(CUST.SUSP.schmType == "CLA")THEN
				#{
