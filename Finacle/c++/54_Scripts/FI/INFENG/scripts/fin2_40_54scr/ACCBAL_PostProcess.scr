#------------------------------------------------
	if((sv_u == "") AND (sv_v == "Y") AND (sv_w != "") AND (sv_x == "") AND (sv_e == "Y")) then
    sv_b = urhk_getPoolEffAvailAmt(sv_a)
    if(sv_b == 0) then
        sv_z = BANCS.OUTPARAM.PoolEffAvailableAmt
	if(fieldexists(BANCS.INPUT.oAvailableAmt)==1)then
		print(BANCS.INPUT.mAvailableAmt)
		print(BANCS.INPUT.oAvailableAmt)
		if(cdouble(BANCS.INPUT.mAvailableAmt) >0)then
			if(cdouble(BANCS.INPUT.oAvailableAmt)>0)then
				BANCS.INPUT.cuPoolAmt =	cdouble(BANCS.INPUT.mAvailableAmt) + cdouble(BANCS.INPUT.oAvailableAmt)	
			else
				BANCS.INPUT.cuPoolAmt = BANCS.INPUT.mAvailableAmt
			endif
		else
			if(cdouble(BANCS.INPUT.oAvailableAmt)>0)then
				BANCS.INPUT.cuPoolAmt =	BANCS.INPUT.oAvailableAmt	
			else
				BANCS.INPUT.cuPoolAmt = 0
			endif
		endif
	else
		BANCS.INPUT.cuPoolAmt = 0
	endif
	print(BANCS.INPUT.cuPoolAmt)
	print(sv_z)
	if(cdouble(BANCS.INPUT.cuPoolAmt)>0 and ((BANCS.INPUT.aSchmCode=="SB126") or (BANCS.INPUT.aSchmCode=="CA207")))then
		BANCS.OUTPUT.accbal_eff_avail_amt_sweeps = BANCS.INPUT.cuPoolAmt
	else
		BANCS.OUTPUT.accbal_eff_avail_amt_sweeps = 0 
	endif
	if((BANCS.INPUT.aSchmCode!="SB126") and (BANCS.INPUT.aSchmCode!="CA207"))then
		BANCS.OUTPUT.accbal_eff_avail_amt_sweeps = sv_z
	endif
    else
        BANCS.OUTPUT.accbal_eff_avail_amt_sweeps = ""
    endif
else
    BANCS.OUTPUT.accbal_eff_avail_amt_sweeps = "N.A."
endif

#+++++++++++++++++++++++++++++++++VP
#Population of accbal_eff_avail_amt
#----------------------------------
print(sv_u)
print(sv_o)
if(sv_u != "") then
    if(sv_o != "") then
                sv_c = BANCS.INPUT.crncy_code
		if(fieldexists(BANCS.INPUT.cuPoolAmt)==1)then
			BANCS.INPARAM.InputAmount = BANCS.INPUT.cuPoolAmt 
		else
			BANCS.INPARAM.InputAmount = sv_o
		endif
                BANCS.INPARAM.FromCurrency = sv_c
                BANCS.INPARAM.AmountWidth = 25
                #AMT_WIDTH in precision.h is 17
                sv_z = urhk_B2k_floatWithComma("")
                if(sv_z == 0) then
                        sv_a = BANCS.OUTPARAM.OutputAmount
                        sv_f = getPosition(sv_a,"|")
                        if(sv_f == 0) then
                        sv_f = strlen(sv_a) + 1
                        endif
                        sv_g = MID$(sv_a,0,(sv_f-1))
                        if (sv_g < 0 ) then
                                sv_g= LTRIM(sv_g, ' ')
                                sv_g= LTRIM(sv_g, '-')
                        sv_m = " Dr"
                        else
                        sv_m = " Cr"
                        endif
                        BANCS.OUTPUT.accbal_eff_avail_amt = sv_g + sv_m
                endif
    else
        BANCS.OUTPUT.accbal_eff_avail_amt = ""
    endif
	print(BANCS.OUTPUT.accbal_eff_avail_amt)
else
    if(sv_t != "") then
        sv_c = BANCS.INPUT.crncy_code
	if(fieldexists(BANCS.INPUT.cuPoolAmt)==1)then
		BANCS.INPARAM.InputAmount = BANCS.INPUT.cuPoolAmt 
	else
		BANCS.INPARAM.InputAmount = sv_t
	endif
        BANCS.INPARAM.FromCurrency = sv_c
        BANCS.INPARAM.AmountWidth = 25
        #AMT_WIDTH in precision.h is 17
        sv_z = urhk_B2k_floatWithComma("")
        if(sv_z == 0) then
            sv_a = BANCS.OUTPARAM.OutputAmount
            sv_f = getPosition(sv_a,"|")
            if(sv_f == 0) then
                sv_f = strlen(sv_a) + 1
            endif
            sv_g = MID$(sv_a,0,(sv_f-1))
            if (sv_g < 0 ) then
                sv_g= LTRIM(sv_g, ' ')
                sv_g= LTRIM(sv_g, '-')
                sv_m = " Dr"
            else
                sv_m = " Cr"
            endif
            BANCS.OUTPUT.accbal_eff_avail_amt = sv_g + sv_m
        endif
        else
        BANCS.OUTPUT.accbal_eff_avail_amt = ""
    endif
	print(BANCS.OUTPUT.accbal_eff_avail_amt)
endif
#++++++++++++++++++++
#VP
#++++++++++++++++++++
sv_a = BANCS.INPUT.foracid
sv_b = urhk_getAcctDetailsInRepository(sv_a)
if(sv_b == 0) then
        sv_p = BANCS.OUTPARAM.futureBalContribAmt
        sv_q = BANCS.OUTPARAM.avblAmtAtLoC
        sv_r = BANCS.OUTPARAM.adhocLimit
        sv_t = BANCS.OUTPARAM.EffAvailableAmt
        sv_v = BANCS.OUTPARAM.singleTranLimit
        sv_x = BANCS.OUTPARAM.cleanEmergencyAdvance
        sv_w = BANCS.OUTPARAM.cleanSingleTranLimit
        sv_u = BANCS.OUTPARAM.FCNRCrncyCode
        sv_n = BANCS.OUTPARAM.FFDAvailableAmt

        BANCS.INPARAM.InputAmount = BANCS.OUTPARAM.DafaLimit
    BANCS.INPARAM.FromCurrency =BANCS.INPUT.crncy_code
    BANCS.INPARAM.AmountWidth = 25
    sv_z = urhk_B2k_floatWithComma("")
    if(sv_z == 0) then
        sv_a = BANCS.OUTPARAM.OutputAmount
        BANCS.OUTPUT.accbal_dafa_lim = sv_a
    endif
endif

if(sv_p != "") then
	if(fieldexists(BANCS.INPUT.cuPoolAmt)==1)then
		sv_h = (cdouble(sv_p)) + (cdouble(BANCS.INPUT.cuPoolAmt))
	else
		sv_h = (cdouble(sv_p)) + (cdouble(sv_t))
	endif
        BANCS.OUTPUT.accbal_eff_avail_amt_fut_cont = format$(sv_h,"%.6f")
        #Formatting the accbal_eff_avail_amt_fut_cont in Lakh/Million format
        #----------------------------------------------------------
        sv_a = BANCS.OUTPUT.accbal_eff_avail_amt_fut_cont
        sv_c = BANCS.INPUT.crncy_code
        BANCS.INPARAM.InputAmount = sv_a
        BANCS.INPARAM.FromCurrency = sv_c
        BANCS.INPARAM.AmountWidth = 25
        #AMT_WIDTH in precision.h is 17
        sv_z = urhk_B2k_floatWithComma("")
        if(sv_z == 0) then
                sv_a = BANCS.OUTPARAM.OutputAmount
                sv_f = getPosition(sv_a,"|")
                if(sv_f == 0) then
                        sv_f = strlen(sv_a) + 1
                endif

                sv_g = MID$(sv_a,0,(sv_f-1))
                if (sv_g < 0 ) then
                        sv_g= LTRIM(sv_g, ' ')
                        sv_g= LTRIM(sv_g, '-')
                        sv_m = " Dr"
                else
                        sv_m = " Cr"
                endif

                BANCS.OUTPUT.accbal_eff_avail_amt_fut_cont = sv_g + sv_m
        endif
else
    BANCS.OUTPUT.accbal_eff_avail_amt_fut_cont = ""
endif
print(BANCS.OUTPUT.accbal_eff_avail_amt_fut_cont)

#Future Val Req(futValReq)
#-------------------------
sv_i = "futValDate,futDrDate,futCrValReq|select future_value_dt_cr_flg,future_value_dt_dr_flg,calc_dafa_lim_based_on_cr_comp from GCT where BANK_ID = ?SVAR "
BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId
sv_k = urhk_dbSelectWithBind(sv_i)
if(sv_k == 0) then
        sv_m = BANCS.OUTPARAM.futValDate
        BANCS.INPARAM.futValDate = sv_m
        sv_n = BANCS.OUTPARAM.futDrDate
        sv_o = BANCS.OUTPARAM.futCrValReq
    if (sv_m == "Y" AND sv_n == "Y") then
        sv_a = "Y"
    else
        sv_a = "N"
    endif
endif
if (sv_a == "N") then
    BANCS.OUTPUT.accbal_dafa_lim = "N.A."
    BANCS.OUTPUT.accbal_future_bal_amt = "N.A."
    BANCS.OUTPUT.accbal_eff_avail_amt_fut_cont = "N.A."
endif

#Future Cr.Val req(futCrValReq)
#------------------------------

if (sv_o == "Y") then
    sv_b = "Y"
else
    sv_b = "N"
endif
#if (sv_b == "N") then
#    BANCS.OUTPUT.accbal_future_cr_amt = "N.A."
#    BANCS.OUTPUT.accbal_future_clr_bal_amt = "N.A."
#    BANCS.OUTPUT.accbal_future_un_clr_bal_amt = "N.A."
#else
    #population of accbal_future_clr_bal_amt
    #----------------------------------------
	sv_a = BANCS.INPUT.foracid
    sv_b = urhk_getAcctDetailsInRepository(sv_a)
    if(sv_b == 0) then	
    	sv_c =  BANCS.OUTPARAM.FutureClrBalance
		sv_d = BANCS.OUTPARAM.FutureUnClrBalance
	endif
	
    if(sv_c != "") then
		sv_f = getPosition(sv_c,"|")
        if(sv_f == 0) then
            sv_f = strlen(sv_c) + 1
        endif
        sv_g = MID$(sv_c,0,(sv_f-1))
        sv_g = CDOUBLE(sv_g)
        sv_g = Format$(sv_g, "%.6f")
        if (sv_g < 0 ) then
		sv_g= LTRIM(sv_g, ' ')
            sv_g= LTRIM(sv_g, '-')
            sv_m = " Dr"
        else
            sv_m = " Cr"
        endif
		BANCS.INPARAM.InputAmount = sv_g
    	BANCS.INPARAM.FromCurrency = BANCS.INPUT.crncy_code 
    	BANCS.INPARAM.AmountWidth = 25
    	#AMT_WIDTH in precision.h is 17
    	sv_z = urhk_B2k_floatWithComma("")
    	if(sv_z == 0) then
        	sv_g = BANCS.OUTPARAM.OutputAmount
        	BANCS.OUTPUT.accbal_future_clr_bal_amt = sv_g + sv_m
		endif
    else
       BANCS.OUTPUT.accbal_future_clr_bal_amt  = ""
    endif
    #population of accbal_future_un_clr_bal_amt
    #-------------------------------------------
    if(sv_d != "") then
        sv_f = getPosition(sv_d,"|")
        if(sv_f == 0) then
            sv_f = strlen(sv_d) + 1
        endif
        sv_g = MID$(sv_d,0,(sv_f-1))
        sv_g = CDOUBLE(sv_g)
        sv_g = Format$(sv_g, "%.6f")
        if (sv_g < 0 ) then
		sv_g= LTRIM(sv_g, ' ')
            sv_g= LTRIM(sv_g, '-')
            sv_m = " Dr"
        else
            sv_m = " Cr"
        endif
		BANCS.INPARAM.InputAmount = sv_g
        BANCS.INPARAM.FromCurrency = BANCS.INPUT.crncy_code
        BANCS.INPARAM.AmountWidth = 25
        #AMT_WIDTH in precision.h is 17
        sv_z = urhk_B2k_floatWithComma("")
        if(sv_z == 0) then
    		sv_g = BANCS.OUTPARAM.OutputAmount
        	BANCS.OUTPUT.accbal_future_un_clr_bal_amt = sv_g + sv_m
        endif
    else
       BANCS.OUTPUT.accbal_future_un_clr_bal_amt = ""
    endif
    #population of accbal_future_cr_amt
    #-----------------------------------

	sv_k= BANCS.OUTPUT.accbal_future_bal_amt 
    sv_k = LTRIM(sv_k) 
    sv_e = strlen(sv_k) 
    sv_f = getPosition(sv_k," ") 
    sv_i = MID$(sv_k,sv_f,sv_e) 
    
    if(sv_i == "Cr" ) then 
		sv_t = CDOUBLE(BANCS.OUTPUT.accbal_future_bal_amt) + CDOUBLE(BANCS.OUTPUT.accbal_util_future_bal_amt) + CDOUBLE(BANCS.OUTPUT.accbal_overdue_fut_liab)
	endif

	if( sv_i == "Dr") then
   	 	sv_t = CDOUBLE(BANCS.OUTPUT.accbal_util_future_bal_amt) - CDOUBLE(BANCS.OUTPUT.accbal_future_bal_amt) + CDOUBLE(BANCS.OUTPUT.accbal_overdue_fut_liab)
    endif
	
	BANCS.OUTPUT.accbal_future_cr_amt = Format$(sv_t,"%.6f")
#endif
	sv_k = BANCS.OUTPUT.accbal_future_bal_amt 
	BANCS.INPARAM.InputAmount = sv_k 
	BANCS.INPARAM.FromCurrency = BANCS.INPUT.crncy_code 
	sv_z = urhk_B2k_floatWithComma("") 
	if(sv_z == 0) then 
	sv_k = BANCS.OUTPARAM.OutputAmount 
	BANCS.OUTPUT.accbal_future_bal_amt = sv_k + " " + sv_i 
	else 
	BANCS.OUTPUT.accbal_future_bal_amt = "" 
	endif 

	sv_k = BANCS.OUTPUT.accbal_future_cr_amt 
	BANCS.INPARAM.InputAmount = sv_k 
	BANCS.INPARAM.FromCurrency = BANCS.INPUT.crncy_code 
	sv_z = urhk_B2k_floatWithComma("") 
	if(sv_z == 0) then 
	sv_k = BANCS.OUTPARAM.OutputAmount 
	sv_c = "Cr"
	BANCS.OUTPUT.accbal_future_cr_amt = sv_k + " " + sv_c 
	else 
	BANCS.OUTPUT.accbal_future_cr_amt = "" 
	endif 

	sv_k = BANCS.OUTPUT.accbal_util_future_bal_amt 
	BANCS.INPARAM.InputAmount = sv_k 
	BANCS.INPARAM.FromCurrency = BANCS.INPUT.crncy_code 
	BANCS.INPARAM.AmountWidth = 25
	sv_z = urhk_B2k_floatWithComma("") 
	if(sv_z == 0) then 
	sv_k = BANCS.OUTPARAM.OutputAmount 
	BANCS.OUTPUT.accbal_util_future_bal_amt = sv_k 
	endif

	sv_k = BANCS.OUTPUT.accbal_overdue_fut_liab 
	BANCS.INPARAM.InputAmount = sv_k 
	BANCS.INPARAM.FromCurrency = BANCS.INPUT.crncy_code 
	BANCS.INPARAM.AmountWidth = 25
	sv_z = urhk_B2k_floatWithComma("") 
	if(sv_z == 0) then 
	sv_k = BANCS.OUTPARAM.OutputAmount 
	BANCS.OUTPUT.accbal_overdue_fut_liab = sv_k 
	endif

#Populating Account name and Balance
#-----------------------------------
call("getAcctBalance.scr")

#Scheme Description
#------------------
sv_a = BANCS.INPUT.foracid
sv_b = urhk_getAcctDetailsInRepository(sv_a)
if(sv_b == 0) then
