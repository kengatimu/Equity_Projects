endif

sv_a = BANCS.INPUT.foracid
sv_b = urhk_getAcctDetailsInRepository(sv_a)
if(sv_b == 0) then
    sv_z = BANCS.OUTPARAM.cifId
else
    sv_z = ""
endif


#Populating the unclear balance and float balance
#------------------------------------------------
if(sv_s != "") then
    sv_a = urhk_getFloatBalanceAmountAndUnclearBalance(sv_s)
    if(sv_a == 0) then
   		sv_b = BANCS.OUTPARAM.float_bal
        sv_c = BANCS.OUTPARAM.funds_in_clearing
		sv_c = CDOUBLE(sv_c)
	    sv_c = Format$(sv_c, "%.6f")
		BANCS.INPARAM.InputAmount =sv_c
		BANCS.INPARAM.FromCurrency =BANCS.INPUT.crncy_code
		BANCS.INPARAM.AmountWidth = 25
		sv_z = urhk_B2k_floatWithComma("")
		if(sv_z == 0) then
			sv_c = BANCS.OUTPARAM.OutputAmount
        	BANCS.OUTPUT.accbal_un_clear_balance = sv_c
		endif
	else
        BANCS.OUTPUT.accbal_un_clear_balance = ""
	endif
    if(sv_b != "") then
		BANCS.INPARAM.InputAmount =sv_b
        BANCS.INPARAM.FromCurrency =BANCS.INPUT.crncy_code
        BANCS.INPARAM.AmountWidth = 25
        sv_z = urhk_B2k_floatWithComma("")
        if(sv_z == 0) then
            sv_d = BANCS.OUTPARAM.OutputAmount
			#Formatting the float balance in Lakh/Million format
			#---------------------------------------------------
			sv_f = getPosition(sv_d,"|")
			if(sv_f == 0) then
				sv_f = strlen(sv_d) + 1
			endif
			sv_g = MID$(sv_d,0,(sv_f-1))
			if (sv_g < 0 ) then
				sv_g= LTRIM(sv_g, ' ')
				sv_g= LTRIM(sv_g, '-')
    			sv_m = " Dr"
			else
   	 			sv_m = " Cr"
			endif
			BANCS.OUTPUT.accbal_float_balance = sv_g + sv_m
		endif
    else
        BANCS.OUTPUT.accbal_float_balance = ""
    endif
endif

#Formatting the accbal_eff_avail_amt_sweeps in Lakh/Million format
#-----------------------------------------------------------------
sv_a = BANCS.OUTPUT.accbal_eff_avail_amt_sweeps
sv_c = BANCS.INPUT.crncy_code
BANCS.INPARAM.InputAmount = sv_a
BANCS.INPARAM.FromCurrency = sv_c
BANCS.INPARAM.AmountWidth = 25
#AMT_WIDTH in precision.h is 17
