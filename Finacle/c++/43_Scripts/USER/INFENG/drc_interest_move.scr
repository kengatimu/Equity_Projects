#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
#FileName	: ebfl527Tran54Api.scr
#Desc		: Creates Suspense Transaction in 99 respective to mkey(99) Loan Disb 
#MenuId		: NA
#Module		: MKEY -API
#Date		: 07/12/2018
#Author		: Vino Palani
# Replication to fin2 and fin4 31052025
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#+++++++++++++
#Rep&Class
#+++++++++++++
	if(repexists("MKEY")==0)then
		createrep("MKEY")
	endif
	if(classexists("MKEY","GLBDATA")==0)then
		createclass("MKEY","GLBDATA",5)
	endif
#+++++++++++++
#Inputs
#+++++++++++++

## kenyaside start 
	MKEY.GLBDATA.bankID="43"
	MKEY.GLBDATA.bankIDke="54"
	MKEY.GLBDATA.loanAcctNum="0810279759387"
	MKEY.GLBDATA.tranCcyDr="USD"
	MKEY.GLBDATA.TranCrncyagt = MKEY.GLBDATA.tranCcyDr
	print(MKEY.GLBDATA.TranCrncyagt)

        sv_s = "foracid,tran_amt,tran_particular,acct_crncy_code,uniqueid| SELECT gam.foracid,abs(dtd.TRAN_AMT*0.85),dtd.TRAN_PARTICULAR,gam.acct_crncy_code ,CONCAT(trim(dtd.tran_id),TO_CHAR(dtd.TRAN_DATE,':DD-MON-RRRR')) UNIQUEID "
        sv_s = sv_s + " from tbaadm.dtd dtd ,tbaadm.gam WHERE gam.acid=dtd.ACID   and dtd.bank_id =gam.bank_id  and dtd.bank_id = '"+ MKEY.GLBDATA.bankIDke +"' and dtd.del_flg='N' and dtd.PSTD_FLG='Y'  "
	sv_s = sv_s + " and dtd.tran_date>='01-jan-2023' and dtd.PART_TRAN_TYPE='C'  and dtd.TRAN_SUB_TYPE='IP' and gam.foracid ='"+ MKEY.GLBDATA.loanAcctNum +"' and rownum<2 "
	print(sv_s)
        sv_u = urhk_dbSelectWithBind(sv_s)
        if(sv_u == 0)then
		#foracid,tran_amt,tran_particular,acct_crncy_code,uniqueid
                MKEY.GLBDATA.foracid      = BANCS.OUTPARAM.foracid
		print(MKEY.GLBDATA.foracid)
		MKEY.GLBDATA.tran_amt      = BANCS.OUTPARAM.tran_amt
		print(MKEY.GLBDATA.tran_amt)
		MKEY.GLBDATA.tranAmtDr = MKEY.GLBDATA.tran_amt
		print(MKEY.GLBDATA.tranAmtDr)
		MKEY.GLBDATA.drCrAmount = MKEY.GLBDATA.tranAmtDr
		print(MKEY.GLBDATA.drCrAmount)
		MKEY.GLBDATA.tran_particular      = BANCS.OUTPARAM.tran_particular
		print(MKEY.GLBDATA.tran_particular)
		MKEY.GLBDATA.acct_crncy_code      = BANCS.OUTPARAM.acct_crncy_code
		print(MKEY.GLBDATA.acct_crncy_code)
		MKEY.GLBDATA.uniqueid      = BANCS.OUTPARAM.uniqueid
		print(MKEY.GLBDATA.uniqueid)

        else
                MKEY.GLBDATA.KenySucYN       = "N"
                MKEY.GLBDATA.valerr     = "No Transaction Found for: " + MKEY.GLBDATA.loanAcctNum 
                goto ENDSCR
        endif

	MKEY.GLBDATA.tranId	= ""
	MKEY.GLBDATA.RequestID1	= ""
	MKEY.GLBDATA.tranAmtDr	= MKEY.GLBDATA.tranAmtDr 
	MKEY.GLBDATA.tranCcyDr	= MKEY.GLBDATA.tranCcyDr 
	MKEY.GLBDATA.tranAmtCr	= MKEY.GLBDATA.tranAmtDr 
	MKEY.GLBDATA.tranCcyCr	= MKEY.GLBDATA.tranCcyDr 
	#preprod
	MKEY.GLBDATA.drAcctID	= "15000117040039"
	print(MKEY.GLBDATA.drAcctID)
	#preprod
	MKEY.GLBDATA.crAcctID	= "15000607080002"
	print(MKEY.GLBDATA.crAcctID)
	MKEY.GLBDATA.commRefNum	= "15000117040039"
	MKEY.GLBDATA.KenySucYN  = ""
	MKEY.GLBDATA.valerr     = ""
	MKEY.GLBDATA.errorCode	= ""
	MKEY.GLBDATA.errorDesc	= ""
	MKEY.GLBDATA.drCnt	= ""
	MKEY.GLBDATA.crCnt	= ""
	MKEY.GLBDATA.tranParticularsDr	= "Transfer Int For:" +MKEY.GLBDATA.loanAcctNum+ "/" + MKEY.GLBDATA.crAcctID 
	MKEY.GLBDATA.tranRmksDr	= MKEY.GLBDATA.uniqueid
	MKEY.GLBDATA.tranParticularsCr	= "Transfer Int From:" +MKEY.GLBDATA.loanAcctNum+ "/" + MKEY.GLBDATA.drAcctID 
	MKEY.GLBDATA.tranRmksCr	= MKEY.GLBDATA.uniqueid
	MKEY.GLBDATA.tranParticulars2Dr	= MKEY.GLBDATA.loanAcctNum + "/" + MKEY.GLBDATA.crAcctID 
	MKEY.GLBDATA.tranParticulars2Cr	= MKEY.GLBDATA.loanAcctNum + "/" + MKEY.GLBDATA.drAcctID 
	MKEY.GLBDATA.tranIdKeDisb	= ""
#++++++++++++
#Validations
#++++++++++++
        sv_s = "drCnt | select count(*) from tbaadm.gam where foracid='"+ MKEY.GLBDATA.drAcctID +"'  and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg='N' "
        sv_s = sv_s + " and bank_id = '"+ MKEY.GLBDATA.bankID +"' "
        sv_u = urhk_dbSelectWithBind(sv_s)
        if(sv_u == 0)then
                MKEY.GLBDATA.drCnt      = BANCS.OUTPARAM.drCnt
        else
                MKEY.GLBDATA.drCnt      = ""
        endif
        sv_s = "crCnt | select count(*) from tbaadm.gam where foracid='"+ MKEY.GLBDATA.crAcctID +"'  and entity_cre_flg='Y' and del_flg='N' and acct_cls_flg='N' "
        sv_s = sv_s + " and bank_id = '"+ MKEY.GLBDATA.bankID +"' "
        sv_u = urhk_dbSelectWithBind(sv_s)
        if(sv_u == 0)then
                MKEY.GLBDATA.crCnt      = BANCS.OUTPARAM.crCnt
        else
                MKEY.GLBDATA.crCnt      = ""
        endif
        if(MKEY.GLBDATA.drCnt != "1")then
                MKEY.GLBDATA.KenySucYN       = "N"
                MKEY.GLBDATA.valerr     = "43 Dr Account Not Found ! " + MKEY.GLBDATA.drAcctID
                goto ENDSCR
        endif
        if(MKEY.GLBDATA.crCnt != "1")then
                MKEY.GLBDATA.KenySucYN       = "N"
                MKEY.GLBDATA.valerr     = "43 Cr Account Not Found ! " + MKEY.GLBDATA.crAcctID
                goto ENDSCR
        endif
#####

MKEY.GLBDATA.drAccount = MKEY.GLBDATA.drAcctID
print(MKEY.GLBDATA.drAccount)

MKEY.GLBDATA.CrAccount = MKEY.GLBDATA.crAcctID
print(MKEY.GLBDATA.CrAccount)

#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------

	IF(REPEXISTS("MTT") == 0 ) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF

          
	IF (CLASSEXISTS("MTT","TranDetails")==0) THEN
	#{
		CREATECLASS("MTT","TranDetails",5)
	#}
	ENDIF  
	
	IF (CLASSEXISTS("MTT","PartTranDetails")==0) THEN
	#{
		CREATECLASS("MTT","PartTranDetails",5)
	#}
	ENDIF

	IF (REPEXISTS("BANCS")==0) THEN
	#{
	   CREATEREP("BANCS")
	#}
	ENDIF
          
	IF (CLASSEXISTS("BANCS","PartTranDetails")==0) THEN
	#{
		CREATECLASS("BANCS","PartTranDetails",5)
	#}
	ENDIF  

    IF (CLASSEXISTS("BANCS","INPARAM")==0) THEN
    #{
        CREATECLASS("BANCS","INPARAM",5)
    #}
    ENDIF

    BANCS.INPARAM.PostTranFlg = "Y"
    BANCS.INPARAM.InsertTranWithValidnFlg = "N"
    BANCS.INPARAM.CommitFlg="N"
    BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
    BANCS.INPARAM.ErrorCheckForLuw="Y"
    BANCS.INPARAM.CheckExceptions="N"
    MTT.TranDetails.TranDate="0"
    MTT.TranDetails.TranType = "T"
    MTT.TranDetails.TranSubType = "BI"
    MTT.TranDetails.IgnoreExcp = "I"
    MTT.TranDetails.Consolidate = "N"
    MTT.TranDetails.Remarks = MKEY.GLBDATA.uniqueid

    sv_u = urhk_MTTS_Initialize("")
    print(sv_u)

    sv_v = "CashBackComm"
    print(sv_v)

    sv_u = urhk_MTTS_DefineTransaction("CashBackComm")
	print(sv_u)

    sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	
	#--------------------------------------------------
    # Income To Branch A/c
    #--------------------------------------------------

    MTT.PartTranDetails.Account = MKEY.GLBDATA.CrAccount
    MTT.PartTranDetails.RefCurrency = MKEY.GLBDATA.TranCrncyagt
    IF (MKEY.GLBDATA.TranCrncyagt!=BANCS.STDIN.homeCrncyCode) THEN
	MTT.PartTranDetails.RateCode = "MEAN"
	MTT.PartTranDetails.Rate = ""
    ENDIF
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.Particulars = MKEY.GLBDATA.tran_particular 
    MTT.PartTranDetails.Particulars2 = MKEY.GLBDATA.tranParticularsCr
    MTT.PartTranDetails.RefAmount = cdouble(MKEY.GLBDATA.drCrAmount)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = MKEY.GLBDATA.uniqueid 
    MTT.PartTranDetails.RefNum = "Interest run"
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = sv_v
    sv_e = "CashBackIncome"
	
    sv_u = urhk_MTTS_definePartTran(sv_e)
	#print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		MKEY.GLBDATA.Sucessfail1     = "N"
	#}
	ELSE
	#{
		MKEY.GLBDATA.Sucessfail1     = "Y"
	#}
	ENDIF

	#------------------------------------------------------------------
    # Debit Partran To Agent Pool A/C
    #------------------------------------------------------------------

    MTT.PartTranDetails.Account = MKEY.GLBDATA.drAccount
    MTT.PartTranDetails.RefCurrency = MKEY.GLBDATA.TranCrncyagt
    IF (MKEY.GLBDATA.TranCrncyagt!=BANCS.STDIN.homeCrncyCode) THEN
	MTT.PartTranDetails.RateCode = "MEAN"
	MTT.PartTranDetails.Rate = ""
    ENDIF
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.Particulars = MKEY.GLBDATA.tran_particular  
    MTT.PartTranDetails.Particulars2 = MKEY.GLBDATA.tranParticularsDr
    sv_a = cdouble(MKEY.GLBDATA.drCrAmount)
	
	sv_a = -(sv_a)
	print(sv_a)
	
    MTT.PartTranDetails.RefAmount = sv_a
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = MKEY.GLBDATA.uniqueid 
    MTT.PartTranDetails.RefNum = "Interest run"
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = sv_v
    sv_h = "D" + MKEY.GLBDATA.drAccount
    sv_u = urhk_MTTS_definePartTran(sv_h)
	
	sv_u = urhk_MTTS_EndDefinition("")
	print(sv_u)
	if(sv_u ==0) then
	#{
		MKEY.GLBDATA.TestTranID     = BANCS.OUTPARAM.MTTTranId
		print(MKEY.GLBDATA.TestTranID)
	#}
	ENDIF

######
ENDSCR:
	print(MKEY.GLBDATA.KenySucYN)
	print(MKEY.GLBDATA.valerr)
	print(MKEY.GLBDATA.tranIdKeDisb)
end-->
