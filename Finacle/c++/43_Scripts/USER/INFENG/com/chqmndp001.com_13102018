set -vx

#-----------------------------------------------------------------------------------
#------Checking if directory is present and creating directory
#-----------------------------------------------------------------------------------
userid=`pwd|awk -F "/" '{print $NF}'`
upldpath="${UPLOAD_INPUT_FILE_PATH}/${userid}"
rptpath="$FIN_REPORTS_DIR/${userid}"
lstFile3=`basename ${lstFile1} .txt`_1.txt
lstFile4=`basename ${lstFile2} .txt`_1.txt
lstFile5=`basename ${lstFile1} .txt`
lstFile6=`basename ${lstFile2} .txt`

test -d $FIN_REPORTS_DIR/${userid}
if [ $? -ne 0 ]
then
        mkdir $FIN_REPORTS_DIR/${userid}
fi

#---------------------------------------------------------------------------------
# Executing a package which fetches the required data and writes it to the file.
#---------------------------------------------------------------------------------
#spbx4001 CUSTOM.GETCHQDETAILDWNLD_${bankId}.GETCHQDETAILDWNLD ${sqlParam} > ${lstFile1}
spbx4001 CUSTOM.GETCHQDETAILXLS_${bankId}.GETCHQDETAILXLS ${sqlParam} > ${lstFile3}
#if [ -s "${lstFile1}" ]
if [ -s "${lstFile3}" ]
then
        cp ${lstFile3} ${rptpath}/${lstFile3}
        #spbx4001 CUSTOM.GETCHQDETAILXLS_${bankId}.GETCHQDETAILXLS ${sqlParam} > ${lstFile3}
        exebatch mrbx4004 $B2K_SESSION_ID  ${jsprfile}  ${lstFile3}  ${lstFile5}
        #cp ${lstFile5} ${rptpath}/${lstFile5}
        exebatch babx4040 ${B2K_SESSION_ID} ${rptpath}/${lstFile5}.XLS "CHEQUE DETAIL SBA DOWNLOAD" "MANAGER" "1" "N"
fi

#spbx4001 CUSTOM.GETCHQDETAILDWNLDCAA_${bankId}.GETCHQDETAILDWNLDCAA ${sqlParam} > ${lstFile2}
#if [ -s "${lstFile2}" ]
spbx4001 CUSTOM.GETCHQDETAILXLSCAA_${bankId}.GETCHQDETAILXLS ${sqlParam} > ${lstFile4}
if [ -s "${lstFile4}" ]
then
        cp ${lstFile4} ${rptpath}/${lstFile4}
        #spbx4001 CUSTOM.GETCHQDETAILXLSCAA_${bankId}.GETCHQDETAILXLS ${sqlParam} > ${lstFile4}
        exebatch mrbx4004 $B2K_SESSION_ID  ${jsprfile}  ${lstFile4}  ${lstFile6}
        #cp ${lstFile6} ${rptpath}/${lstFile6}
        exebatch babx4040 ${B2K_SESSION_ID} ${rptpath}/${lstFile6}.XLS "CHEQUE DETAIL CAA DOWNLOAD" "MANAGER" "1" "N"
fi



