#This script calls the java APIs for excel based Uploads
#Call JAVA APIs


if [ "$POI_API_PATH" = "" ]
then
		echo "POI jar not set properly. Set the JAR to env variable POI_API_PATH" 
		echo "The env variable POI_API_PATH should have the POI jar filename
		also."
    	exit 2
fi

if [ ! -f "$POI_API_PATH" ]
then
	echo "The file $POI_API_PATH  does not exist."
   	exit 2
fi
	
#Set POI_API_PATH to CLASSPATH
echo $CLASSPATH
export CLASSPATH=./:$POI_API_PATH:$CLASSPATH

callType=$1
if [ ${callType} = "CONV" ]
then
	if [ $# -ne 5 ]
	then
		echo "Invalid Number of parameters for Excel Conversion" 
    	exit 1
	fi
	# $2-xlsfile, $3-xmlfile, $4-datfile $5-resultxls
        $JAVA_HOME/bin/java upload.service.ExcelConvertor $2 $3 $4 $5 
	exit $?
else if [ ${callType} = "UPLD" ] 
then
	# $2-xlsfile, $3-successfile, $4-failurefile
	if [ $# -ne 4 ]
	then
		echo "Invalid Number of parameters to Upload Results" 
    	exit 1
	fi

	$JAVA_HOME/bin/java upload.service.UploadResultInExcel $2 $3 $4 
	exit $?
fi
fi

