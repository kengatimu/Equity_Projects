        else
                if(fieldexists(BANCS.INPUT.CrForacid)==1)then
                        print(BANCS.INPUT.CrForacid)
                        sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
                        if(sv_u==0)then
                                CUST.ATM.crAcctName = BANCS.OUTPARAM.acctName
                        else
                                CUST.ATM.crAcctName = ""
                        endif
                        print(CUST.ATM.crAcctName)
                        if(CUST.ATM.crAcctName!="")then
                                print(left$(CUST.ATM.crAcctName,8))
                                lv_a = left$(CUST.ATM.crAcctName,8)
                                if(lv_a=="AFRICELL")then
                                        CUST.ATM.narr2="Achat credit Africell"
                                        CUST.ATM.phoneaddedflg ="Y"
                                endif
                                print(left$(CUST.ATM.crAcctName,6))
                                lv_o = left$(CUST.ATM.crAcctName,6)
                                if(lv_o=="ORANGE")then
                                        CUST.ATM.narr2="Achat credit Orange"
                                        CUST.ATM.phoneaddedflg ="Y"
                                endif
                        endif
                endif
	ENDIF
		IF (FIELDEXISTS(BANCS.INPUT.Command) == 1) THEN
			sv_r=mid$(BANCS.INPUT.Command,2,4)
			print(sv_r)
			IF (sv_r =="RR") THEN
				CUST.ATM.reval="REV "
				CUST.ATM.narr2 =  CUST.ATM.reval + CUST.ATM.narr2
				print(CUST.ATM.narr2)
			ENDIF
		ENDIF
		#CUST.ATM.narr2 = CUST.ATM.narr2 + "/" + LTRIM(BANCS.INPUT.ReservedField3,'0') + "/" +  MID$(BANCS.INPUT.CardAcceptorName,0,6) 
		#print(CUST.ATM.narr2)
		IF ((BANCS.INPUT.ReservedField2=="EBAINTRABANK") OR (CUST.ATM.phoneaddedflg =="Y") OR (BANCS.INPUT.ReservedField2=="BROKER_CASH_DEPO") OR (BANCS.INPUT.ReservedField2=="POSDEP") OR (BANCS.INPUT.ReservedField2=="MPESA_BANK_TO_WALLET")) THEN
			CUST.ATM.narr2 = CUST.ATM.narr2 + "/" + LTRIM(BANCS.INPUT.ReservedField3,'0') + "/" 
			print(CUST.ATM.narr2)
		ELSE
			CUST.ATM.narr2 = CUST.ATM.narr2 + "/" + LTRIM(BANCS.INPUT.ReservedField3,'0') + "/" +  MID$(BANCS.INPUT.CardAcceptorName,0,6) 
			print(CUST.ATM.narr2)
		ENDIF
ENDIF
