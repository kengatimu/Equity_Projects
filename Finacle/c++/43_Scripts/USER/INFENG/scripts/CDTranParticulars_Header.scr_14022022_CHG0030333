			CUST.ATM.narr2="Transaction Carte - CREANCES UNIONPAY"
		ENDIF
		IF (BANCS.INPUT.ReservedField2=="UPIPAY") THEN
			CUST.ATM.narr2="Transaction Carte - DETTES UNIONPAY"
		ENDIF
