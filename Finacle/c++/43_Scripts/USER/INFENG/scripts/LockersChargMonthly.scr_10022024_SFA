				CUST.CHRG.date="01-12-2099 12:11:48"
				
				IF(CUST.CHRG.solid != BANCS.STDIN.mySolId)THEN
				#{
					sv_u = urhk_SetUrhkInp("sol.solId|"+CUST.CHRG.solid)
					print(sv_u)
					sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
					print(sv_u)
				#}
				ENDIF
				
				#--------------------------------------------------------------------------------------------------------------
				# Inputs for Account lien services
				# urhk_SetUrhkInp is used to set inputs
				#--------------------------------------------------------------------------------------------------------------
				
				
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" + CUST.CHRG.actcrncy)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.CHRG.amount+"|" + CUST.CHRG.actcrncy)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUST.CHRG.amount1)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUST.CHRG.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|OTH")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.CHRG.narration)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestedBy|" + CUST.CHRG.bacid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.CHRG.bacid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUST.CHRG.date)
				PRINT(sv_u)
				
				sv_u = urhk_ExecSrv("SRV_AddLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF (sv_u == 0) THEN
				#{
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					sv_s = "UPDATE CUSTOM.LOCKERS_CHRG "
					sv_s = sv_s + " SET LOCKERS_CHRG.entity_cre_flg = 'L' "
					sv_s = sv_s + " WHERE LOCKERS_CHRG.foracid= ?SVAR"
					sv_s = sv_s + " AND LOCKERS_CHRG.bank_id = ?SVAR"
					sv_s = sv_s + " AND LOCKERS_CHRG.free_text5 = ?SVAR"					
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CHRG.free_text5
					print(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
					GOTO NEXTACID
				#}
				ENDIF
				
				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.foracid)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" + CUST.CHRG.actcrncy)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.CHRG.amount+"|" + CUST.CHRG.actcrncy)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUST.CHRG.amount1)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUST.CHRG.date)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|OTH")
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.CHRG.narration)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestedBy|" + CUST.CHRG.bacid)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.CHRG.bacid)
					PRINT(sv_u)
					sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUST.CHRG.date)
					PRINT(sv_u)
					
					sv_u = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
					PRINT(sv_u)
					IF (sv_u == 0) THEN
					#{
						#----------------------------------------------------------------------------------------------------
						# Update custom table status
						#----------------------------------------------------------------------------------------------------
						sv_s = "UPDATE CUSTOM.LOCKERS_CHRG "
						sv_s = sv_s + " SET LOCKERS_CHRG.entity_cre_flg = 'L' "
						sv_s = sv_s + " WHERE LOCKERS_CHRG.foracid= ?SVAR"
						sv_s = sv_s + " AND LOCKERS_CHRG.bank_id = ?SVAR"
						sv_s = sv_s + " AND LOCKERS_CHRG.free_text5 = ?SVAR"
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUST.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CHRG.free_text5
						print(BANCS.INPARAM.BINDVARS)
						
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
						#{
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						#}
						ENDIF
						GOTO NEXTACID
					#}
					ENDIF
					
					#----------------------------------------------------------------------------------------------------
					# SRV Error check
					#----------------------------------------------------------------------------------------------------
					IF (sv_u != 0) THEN
					#{
						IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
						#{
							print(BANCS.OUTPARAM.Error_num)
							sv_v = BANCS.OUTPARAM.Error_num
							#}
						ELSE
							#{
							sv_v = 0
						#}
						ENDIF
						IF (sv_v > 0) THEN
						#{
							sv_u = system("echo 'Error for Acct:"+CUST.CHRG.foracid+" ' >>lienedacctCDF.log")
							sv_i = 1
							WHILE (sv_i <= sv_v)
							#{
								sv_f = FORMAT$(sv_i,"%d")
								sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
								sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
								sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
								print(sv_e)
								sv_i = sv_i + 1
								sv_u = system("echo '"+sv_e+"' >>lienedacctCDF.log")
								print(sv_u)

								sv_s = "UPDATE CUSTOM.LOCKERS_CHRG "
								sv_s = sv_s + " SET LOCKERS_CHRG.entity_cre_flg = 'E', ERRORS=?SVAR "
								sv_s = sv_s + " WHERE LOCKERS_CHRG.foracid= ?SVAR"
								sv_s = sv_s + " AND LOCKERS_CHRG.bank_id = ?SVAR"
								sv_s = sv_s + " AND LOCKERS_CHRG.free_text5 = ?SVAR"
								print(sv_s)
								BANCS.INPARAM.BINDVARS = CUST.CHRG.remark + "|" + CUST.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CHRG.free_text5 
								print(BANCS.INPARAM.BINDVARS)
								
								sv_d = urhk_dbSQLWithBind(sv_s)
								IF (sv_d == 0) THEN
								#{
									sv_c = urhk_dbSQLWithBind("commit")
									print(sv_c)
								#}
								ENDIF
							#}
							DO
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			ENDIF
			#################  end lien
		NEXTACID:
		#----------------------------------------------------------------------------------------------------
		# Update custom table status
		#----------------------------------------------------------------------------------------------------
		
		sv_s = "UPDATE CUSTOM.LOCKERS_CHRG "
		sv_s = sv_s + " SET LOCKERS_CHRG.entity_cre_flg =  'P' || LOCKERS_CHRG.entity_cre_flg "
		sv_s = sv_s + " WHERE LOCKERS_CHRG.foracid= ?SVAR"
		sv_s = sv_s + " AND LOCKERS_CHRG.bank_id = ?SVAR"
		sv_s = sv_s + " AND LOCKERS_CHRG.free_text5 = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.CHRG.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CHRG.free_text5
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		IF (sv_d == 0) THEN
		#{
			sv_c = urhk_dbSQLWithBind("commit")
			print(sv_c)
		#}
		ENDIF

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	DO

		
	ENDOFSCRIPT:
		IF(CUST.CHRG.errMsg == "") THEN
		#{
			CUST.CHRG.errMsg = " Other Accounts|Batch Job executed with out any Errors"

		ENDIF
				
		
	FINISH:
TRACE OFF
		
