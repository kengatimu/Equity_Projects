<--START
TRACE ON
if (REPEXISTS("CUST") == 0)then
	CREATEREP("CUST")
endif

IF (CLASSEXISTS("CUST","DATA") == 0)then
	CREATECLASS("CUST", "DATA", 5)
endif

	sv_u = urhk_B2K_PrintRepos("BANCS")
	print(sv_u)


	IF(FIELDEXISTS(BANCS.INPUT.funcCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.funcCode) != "")THEN
		#{
			CUST.DATA.funcCode = TOUPPER(TRIM(BANCS.INPUT.funcCode))
			PRINT(CUST.DATA.funcCode)
		#}
		ENDIF
	#}
	ENDIF

	
	print(BANCS.INPUT.agentcode)
	CUST.DATA.agentcode        = BANCS.INPUT.agentcode
	print(CUST.DATA.agentcode)
	CUST.DATA.solId = BANCS.INPUT.agentshortname  
	PRINT(CUST.DATA.solId)
        CUST.DATA.crncyCode        =  BANCS.INPUT.crncyCode 
        CUST.DATA.agenttitlecode   =  BANCS.INPUT.agenttitlecode
        CUST.DATA.agentname        =  BANCS.INPUT.agentname
        #CUST.DATA.agentshortname   = BANCS.STDIN.mySolId
		CUST.DATA.agentshortname   = CUST.DATA.solId
        CUST.DATA.agentphonenum    = BANCS.INPUT.agentphonenum
        CUST.DATA.agentaddr1       = BANCS.INPUT.agentaddr1
        CUST.DATA.agentaddr2       = BANCS.INPUT.agentaddr2
        CUST.DATA.agentaddr3       = BANCS.INPUT.agentaddr3
        CUST.DATA.agentcitycode    = BANCS.INPUT.agentcitycode
        CUST.DATA.agentstatecode   = BANCS.INPUT.agentstatecode
        CUST.DATA.agentcntrycode   = BANCS.INPUT.agentcntrycode
        CUST.DATA.agentpin         = BANCS.INPUT.agentpin
        CUST.DATA.crncycode        = BANCS.INPUT.crncycode
        CUST.DATA.operacctnum      = BANCS.INPUT.operacctnum
        CUST.DATA.inoperacctnum    = BANCS.INPUT.inoperacctnum
        CUST.DATA.itaxpcnt         = BANCS.INPUT.itaxpcnt
        CUST.DATA.dummyintamtceiling= BANCS.INPUT.dummyintamtceiling
        CUST.DATA.dummysecurityamt  = BANCS.INPUT.dummysecurityamt
        CUST.DATA.dummyexceptedcollection  = BANCS.INPUT.dummyexceptedcollection
        CUST.DATA.noofacctopened          = BANCS.INPUT.noofacctopened
        CUST.DATA.freetext           = BANCS.INPUT.freetext
        #CUST.DATA.DrAcctId           = BANCS.INPUT.DrAcctId
        #CUST.DATA.CrAcctId           = BANCS.INPUT.CrAcctId

	IF(CUST.DATA.funcCode == "M")  THEN
	#{
		CALL("cagtmModify.scr")
				
		EXITSCRIPT
	#}
	ENDIF

	IF(CUST.DATA.funcCode == "V")THEN
	#{
		CALL("cagtmverify.scr")
				
		EXITSCRIPT
	#}
	ENDIF
	
	IF(CUST.DATA.funcCode == "D")THEN
	#{
		CALL("cagtmdelete.scr")
				
		EXITSCRIPT
	#}
	ENDIF
	
	IF(CUST.DATA.funcCode == "U")THEN
	#{
		#Insert into custom table
		
		##------------------------------------------------------------------------------
		## Acid
		#-------------------------------------------------------------------------------
		IF(CUST.DATA.operacctnum != "")THEN
		#{
			sv_s = "operAcid|select acid from tbaadm.gam where foracid = ?SVAR and bank_id = ?SVAR"
			print(sv_s)

			BANCS.INPARAM.BINDVARS = CUST.DATA.operacctnum + "|" +BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_a = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_a)
			if(sv_a == 0)then
			#{
				CUST.DATA.operAcid = BANCS.OUTPARAM.operAcid
				print(CUST.DATA.operAcid)

			#}

			endif



		#}
		ENDIF
		IF(CUST.DATA.inoperacctnum != "")THEN
		#{
			sv_s = "inoperAcid|select acid from tbaadm.gam where foracid = ?SVAR and bank_id = ?SVAR"
			print(sv_s)

			BANCS.INPARAM.BINDVARS = CUST.DATA.inoperacctnum + "|" +BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_a = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_a)
			if(sv_a == 0)then
			#{
				CUST.DATA.inoperAcid = BANCS.OUTPARAM.inoperAcid
				print(CUST.DATA.inoperAcid)

			#}

			endif



		#}
		ENDIF
		
		sv_c = "INSERT INTO CUSTOM.CUSTOM_AGT_MOD VALUES("
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "'N',"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "SYSDATE,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "SYSDATE,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "0,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR,"
		sv_c = sv_c + "?SVAR)"
		print(sv_c)

		BANCS.INPARAM.BINDVARS = ""
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +  CUST.DATA.solId + "|" + CUST.DATA.agentcode + "|" + CUST.DATA.agentshortname + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DATA.agenttitlecode + "|" + CUST.DATA.agentname + "|" + CUST.DATA.agentaddr1 + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DATA.agentaddr2 + "|" + CUST.DATA.agentcitycode + "|" + CUST.DATA.agentstatecode + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DATA.agentpin + "|" +CUST.DATA.agentphonenum + "|" + CUST.DATA.dummysecurityamt + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DATA.dummyexceptedcollection + "|" + CUST.DATA.noofacctopened + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DATA.operAcid + "|" + CUST.DATA.inoperAcid + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.DATA.itaxpcnt + "|" + CUST.DATA.dummyintamtceiling + "|" + CUST.DATA.freetext + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + CUST.DATA.crncyCode + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|" + CUST.DATA.agentaddr3 + "|" + CUST.DATA.agentcntrycode

		PRINT(BANCS.INPARAM.BINDVARS )
		PRINT(sv_c)
		sv_d = urhk_dbSQLWithBind(sv_c)
		PRINT(sv_d)
		sv_d = urhk_dbSQLWithBind("commit")
		PRINT(sv_d)


		IF(sv_d != 0)THEN
		#{
			#ERROR
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Database Insertion failed^agentcode")
			PRINT(sv_u)
			GOTO ENDOFSCRIPT
		#}
		else
		#{
			CUST.DATA.resultMsg = "Agent code: " + CUST.DATA.agentcode + " undeleted Successfully. Continue to verify. "
			sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.DATA.resultMsg)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			PRINT(sv_u)
		#}
		ENDIF
				
		EXITSCRIPT
	#}
	ENDIF


	sv_t = urhk_SetOrbOut("SuccessOrFailure|Y")
	PRINT(sv_t)


TRACE OFF
END-->