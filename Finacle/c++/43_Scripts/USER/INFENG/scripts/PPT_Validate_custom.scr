sv_s = "proxyFlgstatus,statusexmpproxyFlg|"
sv_s = sv_s + "SELECT STATUS,STATUS_EXMP_PROXYFLG FROM CUSTOM.PROXY_STATUS_EXMP WHERE  DEL_FLG='N' and BANK_ID=?SVAR   "
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
PRINT(BANCS.INPARAM.BINDVARS)
sv_d = urhk_dbSelectWithBind(sv_s)
PRINT(sv_d)
IF (sv_d == 0) THEN
#{
	CUST.HPPTDATA.proxyFlgstatus = BANCS.OUTPARAM.proxyFlgstatus
	PRINT(CUST.HPPTDATA.proxyFlgstatus)
	CUST.HPPTDATA.statusexmpproxyFlg = BANCS.OUTPARAM.statusexmpproxyFlg
