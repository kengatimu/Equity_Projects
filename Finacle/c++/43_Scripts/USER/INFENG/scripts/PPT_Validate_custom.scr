	CUST.HPPTDATA.statusexmpproxyFlg="N"
#}
ENDIF

print(CUST.HPPTDATA.proxyFlgstatus)
IF (CUST.HPPTDATA.proxyFlgstatus=="Y") THEN
	CUST.HPPTDATA.COUNT="0"
