	CUST.HPPTDATA.tran_particular="Proceed"
	print(CUST.HPPTDATA.tran_particular)
	sv_z = urhk_SetOrbOut("output|"+ CUST.HPPTDATA.COUNT)
	print(sv_z)
	sv_z = urhk_SetOrbOut("output1|"+ CUST.HPPTDATA.tran_particular)
	print(sv_z)
