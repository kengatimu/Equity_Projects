			MTT.PartTranDetails.RefCurrency     = EQT.ODP.operacctCrncy 
			MTT.PartTranDetails.Particulars     = "DR FOR ODA PENALTY "+EQT.ODP.pnlDrAcct
			MTT.PartTranDetails.Remarks         = "Penalty on OD Account"
			MTT.PartTranDetails.RefAmount       = -CDOUBLE(EQT.ODP.pnlDrAmt)
			MTT.PartTranDetails.Consolidate     = "Y"
			MTT.PartTranDetails.TranIdentifier  = "ODA_PNL_TXN"
			MTT.PartTranDetails.CarveAmtFlg     = "Y"
			MTT.PartTranDetails.RateCode		= ""
			MTT.PartTranDetails.Rate 			= ""
			
			sv_r = urhk_MTTS_DefinePartTran("ODA_PNL_TXN_DR")
			PRINT(sv_r)
			
			IF (sv_r != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				
				EQT.ODP.errMsg=MTT.Error.Description
				PRINT(EQT.ODP.errMsg)
						EQT.ODP.errMsg = EQT.ODP.pnlDrAcct+"|"+EQT.ODP.errMsg
                		sv_b = urtn_fileWrite(EQT.ODP.failFileIndex1 + "|" + EQT.ODP.errMsg)
				EQT.ODP.errFlg = "Y"
				GOTO FETCH_NEXT_RECORD
			#}
			ENDIF
			
			############################################
			#          Define Credit Part Tran         #
			############################################
			
			print(EQT.ODP.pnlCrAcct)
			
			MTT.PartTranDetails.Account           = EQT.ODP.pnlCrAcct
			MTT.PartTranDetails.RefCurrency       = EQT.ODP.acctCrncy
			MTT.PartTranDetails.RefAmount         = CDOUBLE(EQT.ODP.pnlDrAmt)
			MTT.PartTranDetails.Particulars       = "CR FOR ODA PENALTY "+EQT.ODP.pnlDrAcct
			MTT.PartTranDetails.Remarks           = "Penalty on OD Account"
			MTT.PartTranDetails.ValueDate         = "0"
			MTT.PartTranDetails.ReportCode        = ""
			MTT.PartTranDetails.Consolidate       = "Y"
			MTT.PartTranDetails.TranIdentifier    = "ODA_PNL_TXN"
			MTT.PartTranDetails.PTranBusinessType = ""
			MTT.PartTranDetails.RateCode		  = EQT.ODP.rateCode
			
			sv_o = urhk_MTTS_DefinePartTran("ODA_PNL_TXN_CR")
			PRINT(sv_o)
			
			IF(sv_o != 0) THEN
			#{
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				
				EQT.ODP.errMsg=MTT.Error.Description
				PRINT(EQT.ODP.errMsg)
						EQT.ODP.errMsg = EQT.ODP.pnlDrAcct+"|"+EQT.ODP.errMsg
                		sv_b = urtn_fileWrite(EQT.ODP.failFileIndex1 + "|" + EQT.ODP.errMsg)
				EQT.ODP.errFlg = "Y"
				GOTO FETCH_NEXT_RECORD
			#}
			ENDIF
			
			sv_w = urhk_MTTS_EndDefinition("")
			PRINT(sv_w)
			
			IF(sv_w != 0) THEN
			#{
				PRINT("Transaction Commit Failed")
				
				sv_h = urhk_MTTS_ReportErrorCondition("")
				PRINT(sv_h)
				
				IF(sv_h == 0)THEN
				#{
					EQT.ODP.errMsg = MTT.Error.Description
					PRINT(EQT.ODP.errMsg)
						
                			EQT.ODP.errMsg = EQT.ODP.pnlDrAcct+"|"+EQT.ODP.errMsg
                			sv_b = urtn_fileWrite(EQT.ODP.failFileIndex1 + "|" + EQT.ODP.errMsg)
					IF(TRIM(EQT.ODP.errMsg) == "")THEN
					#{
						EQT.ODP.errMsg = "Error in Posting Transaction"
					#}
					ENDIF
					
					sv_b = "Update custom.c_pnat set PENAL_APPL_FAILURE_DATE = TO_DATE(?SVAR, 'DD-MM-YYYY'), PENAL_APPL_FAILURE_REMARKS = substr(?SVAR,1,150) ,"
					sv_b = sv_b + " LCHG_USER_ID = ?SVAR, LCHG_TIME = sysdate where acid = ?SVAR and bank_id = ?SVAR"
					
					print(sv_b)
					
					BANCS.INPARAM.BINDVARS = MID$(BANCS.STDIN.BODDate,0,10) + "|" + EQT.ODP.errMsg + "|" +  BANCS.STDIN.userId  + "|" + EQT.ODP.pnlDrAcid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_b = urhk_dbSqlWithBind(sv_b)
					PRINT(sv_b)
					
					IF(sv_b != 0)THEN
					#{
						print("Error in Updating Record in Custom Table!")
						GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
                                        	EQT.ODP.errMsg = EQT.ODP.pnlDrAcct +"|"+ ":Record added for penal Amount-"+EQT.ODP.pnlAmt
                                        	sv_b = urtn_fileWrite(EQT.ODP.failFileIndex1 + "|" + EQT.ODP.errMsg)
					#}
					ENDIF
					
					GOTO FETCH_NEXT_RECORD
				#}
				ENDIF
			#}
			ENDIF
			
			IF(sv_w == 0)THEN
			#{
				PRINT(BANCS.OUTPARAM.MTTTranId)
				EQT.ODP.mttTranId = BANCS.OUTPARAM.MTTTranId
			#}
			endif
			
			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)
			
			IF(sv_w == 0)THEN
			#{
				IF(EQT.ODP.mttTranId != "" )THEN
				#{
					sv_b = "Insert into custom.c_pntd (FORACID, ACID, SOL_ID, ACCT_CCY_CODE, TRAN_ID, TRAN_DATE, TRAN_AMT, RATE_CODE,"
					sv_b = sv_b + " RCRE_USER_ID , RCRE_TIME, LCHG_USER_ID, LCHG_TIME, BANK_ID) values (?SVAR, ?SVAR, ?SVAR, ?SVAR,"
					sv_b = sv_b + " ?SVAR, TO_DATE(?SVAR, 'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, sysdate, ?SVAR, sysdate, ?SVAR)"
					
					print(sv_b)
					
					BANCS.INPARAM.BINDVARS = EQT.ODP.pnlDrAcct + "|" + EQT.ODP.pnlDrAcid + "|" + EQT.ODP.acctSolId + "|" + EQT.ODP.acctCrncyCode + "|" + EQT.ODP.mttTranId + "|" + MID$(BANCS.STDIN.BODDate,0,10)
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQT.ODP.pnlDrAmt + "|" + EQT.ODP.rateCode + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_b = urhk_dbSqlWithBind(sv_b)
					PRINT(sv_b)
					
					IF(sv_b != 0)THEN
					#{
						print("Error in Adding Record in Table!")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					
					sv_b = "Update custom.c_pnat set PENAL_APPL_UP_TO_DATE_DR = TO_DATE(?SVAR, 'DD-MM-YYYY'), PENAL_APPLIED_AMOUNT_DR = nvl(PENAL_APPLIED_AMOUNT_DR ,0) + ?SVAR,"
					sv_b = sv_b + " LCHG_USER_ID = ?SVAR, LCHG_TIME = sysdate where acid = ?SVAR and bank_id = ?SVAR"
					
					print(sv_b)
					
					BANCS.INPARAM.BINDVARS = MID$(BANCS.STDIN.BODDate,0,10) + "|" + EQT.ODP.pnlDrAmt + "|" +  BANCS.STDIN.userId  + "|" + EQT.ODP.pnlDrAcid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_b = urhk_dbSqlWithBind(sv_b)
					PRINT(sv_b)
					print(EQT.ODP.pnlDrAcid)
					print(EQT.ODP.pnlDrAmt)
	
					IF(sv_b != 0)THEN
					#{
						print("Error in Updating Record in Custom Table!")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
                                        	
						print("inside error message")	
						EQT.ODP.errMsg = EQT.ODP.pnlDrAcct +"|"+ ":Record added for penal Amount-"+EQT.ODP.pnlDrAmt
                                        	print(EQT.ODP.errMsg)	
						sv_b = urtn_fileWrite(EQT.ODP.successFileIndex1 + "|" + EQT.ODP.errMsg)
						print(sv_b)	
					#}
				ELSE
					#{
					EQT.ODP.errMsg = "Unable to Post the Transaction."
					
					sv_b = "Update custom.c_pnat set PENAL_APPL_FAILURE_DATE = TO_DATE(?SVAR, 'DD-MM-YYYY'), PENAL_APPL_FAILURE_REMARKS = substr(?SVAR,1,150) ,"
					sv_b = sv_b + " LCHG_USER_ID = ?SVAR, LCHG_TIME = sysdate where acid = ?SVAR and bank_id = ?SVAR"
					
					print(sv_b)
					
					BANCS.INPARAM.BINDVARS = MID$(BANCS.STDIN.BODDate,0,10) + "|" + EQT.ODP.errMsg + "|" +  BANCS.STDIN.userId  + "|" + EQT.ODP.pnlDrAcid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_b = urhk_dbSqlWithBind(sv_b)
					PRINT(sv_b)
					
					IF(sv_b != 0)THEN
					#{
						print("Error in Updating Record in Custom Table!")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			
			FETCH_NEXT_RECORD:
				
				IF(EQT.ODP.errFlg == "Y")THEN
				#{
					IF(TRIM(EQT.ODP.errMsg)=="")THEN
					#{
						EQT.ODP.errMsg = "Unable to Post the Transaction."
					#}
					ENDIF
					
					sv_b = "Update custom.c_pnat set PENAL_APPL_FAILURE_DATE = TO_DATE(?SVAR, 'DD-MM-YYYY'), PENAL_APPL_FAILURE_REMARKS = substr(?SVAR,1,150) ,"
					sv_b = sv_b + " LCHG_USER_ID = ?SVAR, LCHG_TIME = sysdate where acid = ?SVAR and bank_id = ?SVAR"
					
					print(sv_b)
					
					BANCS.INPARAM.BINDVARS = MID$(BANCS.STDIN.BODDate,0,10) + "|" + EQT.ODP.errMsg1 + "|" +  BANCS.STDIN.userId  + "|" + EQT.ODP.pnlDrAcid + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					
					sv_b = urhk_dbSqlWithBind(sv_b)
					PRINT(sv_b)
					
					IF(sv_b != 0)THEN
					#{
						print("Error in Updating Record in Custom Table!")
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				
				sv_z = urhk_dbCursorFetch(sv_m)
				PRINT(sv_z)
			#}
			DO
			sv_z = urhk_dbCursorClose(sv_m)
			print(sv_z)
			#}
		ELSE
			#{
			print("Unable to Open Cursor!")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	ENDOFSCRIPT:
                IF(EQT.ODP.errMsg == "") THEN
                #{
                        EQT.ODP.errMsg = " Other Accounts|Batch Job executed with out any Errors"
                        sv_b = urtn_fileWrite(EQT.ODP.failFileIndex1 + "|" + EQT.ODP.errMsg)
                        PRINT(sv_b)
                #}
                ENDIF

                sv_c = urtn_fileClose(EQT.ODP.failFileIndex1)
                PRINT(sv_c)
                sv_c = urtn_fileClose(EQT.ODP.successFileIndex1)
                PRINT(sv_c)

                EQT.ODP.ERR000002 = "Failed "
                PRINT(EQT.ODP.list_file_name)
                sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + EQT.ODP.mrt_file_name + " " + EQT.ODP.list_file_name + " " + EQT.ODP.rpt
                PRINT(sv_r)
                sv_r = SYSTEM(sv_r)
                IF (sv_r != 0) THEN
                #{
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                        sv_u = urhk_SetOrbOut("Error_1|ERR^" + EQT.ODP.ERR000002 + "")
                        GOTO FINISH
                #}
                ENDIF
                sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ EQT.ODP.rpt_file_name+" '" + EQT.ODP.title+"' MANAGER 1 N"
                PRINT(sv_q)
                sv_r = SYSTEM(sv_q)

                ##############

                PRINT(EQT.ODP.list_file_nameSuccess )
                sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + EQT.ODP.mrt_file_name1 + " " + EQT.ODP.list_file_nameSuccess  + " " + EQT.ODP.rptSuccess
                PRINT(sv_r)
                sv_r = SYSTEM(sv_r)
                IF (sv_r != 0) THEN
                #{
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                        sv_u = urhk_SetOrbOut("Error_1|ERR^" + EQT.ODP.ERR000002 + "")
                        GOTO FINISH
                #}
                ENDIF
                sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ EQT.ODP.rpt_file_nameSuccess+" '" + EQT.ODP.titleSuccess+"' MANAGER 1 N"
                PRINT(sv_q)
                sv_r = SYSTEM(sv_q)


                ##############


                IF (sv_r != 0) THEN
                #{
                        sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                        sv_u = urhk_SetOrbOut("Error_1|ERR^" + EQT.ODP.ERR000002 + "^DATE")
                        GOTO FINISH
                #}
                ENDIF

                sv_c = urtn_fileClose(EQT.ODP.failFileIndex1)
                PRINT(sv_c)
	FINISH:

		DELETECLASS("EQT", "ODP")
		DELETEREP("EQT")
		
		EXITSCRIPT
		TRACE OFF
END-->

