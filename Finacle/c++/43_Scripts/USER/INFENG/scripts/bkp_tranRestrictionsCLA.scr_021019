<--START
	# Script body goes here
	
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CLA Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CLA")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CLA",5)
	#}
	ENDIF
	
	###########################################################################################
	# initializing variables
	###########################################################################################
	
	CUST.CLA.claAcct = ""
	CUST.CLA.claDrFlg = "N"
	CUST.CLA.claCrFlg = "N"
	CUST.CLA.claCrCount = 0
	CUST.CLA.claDrCount = 0
	
	CUST.CLA.linkAcFlg = "N"
	CUST.CLA.linkAcCrCount = 0
	CUST.CLA.linkAcDrCount = 0
	
	CUST.CLA.scriptSuccess=""
	CUST.CLA.paramVal =""
	CUST.CLA.moduleName = ""
	CUST.CLA.msgStr = ""
	CUST.CLA.parameterId = ""
	CUST.CLA.partTranType = ""
	CUST.CLA.schmCode = ""
	CUST.CLA.schmType = ""
	CUST.CLA.linkAc = ""
	CUST.CLA.testPartTran = ""
	
	CUST.CLA.claCount = 0
	CUST.CLA.linkedAcCount = 0
	
	IF(FIELDEXISTS(BANCS.STDIN.menuId))THEN
	#{
		CUST.CLA.menuId = BANCS.STDIN.menuId
		#}
	ELSE
		#{
		IF(FIELDEXISTS(BANCS.STDIN.INIT_MENU_ID))THEN
		#{
			CUST.CLA.menuId = BANCS.STDIN.INIT_MENU_ID
		#}
		ENDIF
	#}
	ENDIF
	
	IF((CUST.CLA.menuId != "HTM") AND (CUST.CLA.menuId != "HXFER") AND (CUST.CLA.menuId != "HCASHDEP") AND (CUST.CLA.menuId != "HCASHWD") AND (CUST.CLA.menuId != "HCASHDX") AND (CUST.CLA.menuId != "HCASHX"))THEN
	#{
		EXITSCRIPT
	#}
	ENDIF
	
	##############################################################################################
	#Checking the cparam setup if the account that is being opened is of Creditline type
	##############################################################################################
	
	CUST.CLA.parameterId = "CREDITLINE_SCHEMES"
	CUST.CLA.moduleName = "OT"
	
	PRINT(BANCS.STDIN.contextBankId)
	PRINT(CUST.CLA.moduleName)
	PRINT(CUST.CLA.parameterId)
	
	sv_a = ""
	sv_a = sv_a + "paramVal|select parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER "
	sv_a = sv_a + " WHERE C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
	sv_a = sv_a + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
	sv_a = sv_a + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
	sv_a = sv_a + " C_CPVALUE.del_flg != 'Y' AND "
	sv_a = sv_a + " C_CPVALUE.entity_cre_flg = 'Y' AND "
	sv_a = sv_a + " C_CPMASTER.bank_id = ?SVAR AND "
	sv_a = sv_a + " C_CPMASTER.module_name = ?SVAR AND "
	sv_a = sv_a + " C_CPVALUE.parameter_id = ?SVAR "
	PRINT(sv_a)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CLA.moduleName + "|" + CUST.CLA.parameterId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.paramVal)
		CUST.CLA.paramVal = BANCS.OUTPARAM.paramVal
		#}
	ELSE
		#{
		CUST.CLA.errorMsg = "CPARAM set up not available for CREDITLINE_SCHEMES"
		sv_u = urhk_SRV_SetErr(CUST.CLA.errorMsg)
		EXITSCRIPT
	#}
	ENDIF
	
	#####################################################
	##fetching the partrans of the transaction
	#####################################################
	
	PRINT(CUST.CLA.paramVal)
	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	PRINT(sv_u)
	
	IF(sv_u != 0)THEN
	#{
		PRINT("no records available!!")
		EXITSCRIPT
	#}
	ENDIF
	
	sv_j = CINT(BANCS.OUTPARAM.srvValue)
	PRINT(sv_j)
	
	sv_n = 0
	
	WHILE(sv_n < sv_j)
	#{
		######################################################
		#fetching the part tran type
		######################################################
		
		CUST.CLA.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.partTranType.code"
		sv_u = urhk_SRV_GetVal(CUST.CLA.msgStr)
		IF(sv_u != 0) THEN
		#{
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.CLA.partTranType = BANCS.OUTPARAM.srvValue
		
		###############################################
		#fetching the foracid of the part tran
		###############################################
		CUST.CLA.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.acctId.foracid"
		sv_u = urhk_SRV_GetVal(CUST.CLA.msgStr)
		IF(sv_u != 0) THEN
		#{
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.CLA.foracid = BANCS.OUTPARAM.srvValue
		
		###################################################
		#fetching schmCode of the tran account
		####################################################
		
		sv_r = urhk_getAcctDetailsInRepository(CUST.CLA.foracid)
		
		IF(sv_r == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.schmCode)
			CUST.CLA.schmCode = BANCS.OUTPARAM.schmCode
			
			PRINT(BANCS.OUTPARAM.schmType)
			CUST.CLA.schmType = BANCS.OUTPARAM.schmType
			#}
		ELSE
			#{
			PRINT("Invalid acct")
			GOTO NEXTFETCH
		#}
		ENDIF
		
		PRINT(CUST.CLA.schmCode)
		PRINT(CUST.CLA.schmType)
		PRINT(CUST.CLA.paramVal)
		
		
		###################################################################
		# checking if the schm code belongs to Credit line schemes
		###################################################################
		
		sv_c = "avail|select decode(count(1),0,'N','Y') from dual where INSTR(?SVAR,?SVAR) != 0"
		PRINT(sv_c)
		
		BANCS.INPARAM.BINDVARS = CUST.CLA.paramVal + "|" + CUST.CLA.schmCode
		
		sv_l = urhk_dbSelectWithBind(sv_c)
		PRINT(sv_l)
		
		IF(sv_l != 0)THEN
		#{
			PRINT("Error in query")
		#}
		ENDIF
		
		PRINT(BANCS.OUTPARAM.avail)
		
		IF(BANCS.OUTPARAM.avail == "Y")THEN
		#{
			IF(CUST.CLA.menuId == "HCASHDEP")THEN
			#{
				CUST.CLA.errorMsg = "Direct Cash Deposit cannot be done into Creditline Accounts!!"
				sv_u = urhk_SRV_SetErr(CUST.CLA.errorMsg)
				EXITSCRIPT
			#}
			ENDIF
			
			sv_b = CINT(CUST.CLA.claCount)
			CUST.CLA.claCount = sv_b + 1
			
			IF(CUST.CLA.partTranType == "C")THEN
			#{
				sv_c = CINT(CUST.CLA.claCrCount)
				CUST.CLA.claCrCount = sv_c + 1
			#}
			ENDIF
			
			IF(CUST.CLA.partTranType == "D")THEN
			#{
				sv_c = CINT(CUST.CLA.claDrCount)
				CUST.CLA.claDrCount = sv_c + 1
			#}
			ENDIF
			CUST.CLA.crlineAcct = CUST.CLA.foracid
			PRINT(CUST.CLA.crlineAcct)
			
			sv_c = "2"
			IF(CINT(CUST.CLA.claCount) > CINT(sv_c))THEN
			#{
				CUST.CLA.errorMsg = "Multiple Credit Line Acs cannot exist in single transaction!!"
				sv_u = urhk_SRV_SetErr(CUST.CLA.errorMsg)
				EXITSCRIPT
			#}
			ENDIF
			
			
			IF((CUST.CLA.partTranType == "C") AND (CINT(CUST.CLA.claCount) <= 1))THEN
			#{
				CUST.CLA.claCrFlg = "Y"
				CUST.CLA.claAcct = CUST.CLA.foracid
			#}
			ENDIF
			
			IF((CUST.CLA.partTranType == "D") AND (CINT(CUST.CLA.claCount) <= 1))THEN
			#{
				CUST.CLA.claDrFlg = "Y"
				CUST.CLA.claAcct = CUST.CLA.foracid
			#}
			ENDIF
			
			#}
		ELSE
			#{
			GOTO NEXTFETCH
		#}
		ENDIF
		
		NEXTFETCH:
			
			sv_n = sv_n + 1
		#}
		DO
		
		
		##################################################################
		# if the CLA account is not existing, exiting the script
		##################################################################
		
		IF(CUST.CLA.claAcct == "")THEN
		#{
			EXITSCRIPT
		#}
		ENDIF
		
		################################################################
		#fetching the linked current account from FCFTT for the CL acs
		################################################################
		
		BANCS.INPARAM.BINDVARS = CUST.CLA.claAcct + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_q = "linkAc|SELECT FORACID  from tbaadm.GAM,TBAADM.GAC WHERE GAM.ACID = GAC.INT_DR_ACID "
		sv_q = sv_q + " AND GAC.acid = (select acid from TBAADM.gam where foracid = ?SVAR"
		sv_q = sv_q + " AND entity_cre_flg = 'Y' AND del_flg = 'N' AND bank_id = ?SVAR) "
		sv_q = sv_q + " AND GAC.bank_id = ?SVAR  AND GAM.bank_id = GAC.bank_id"
		PRINT(sv_q)
		
		sv_r = urhk_dbselectWithBind(sv_q)
		PRINT(sv_r)
		
		IF(sv_r == 0)THEN
		#{
			PRINT(BANCS.OUTPARAM.linkAc)
			CUST.CLA.linkAc = BANCS.OUTPARAM.linkAc
		#}
		ENDIF
		
		PRINT(CUST.CLA.linkAc)
		
		##################################################
		##fetching the partrans of the transaction
		##################################################
		
		sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
		PRINT(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			PRINT("no records available!!")
			EXITSCRIPT
		#}
		ENDIF
		
		sv_j = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(sv_j)
		
		sv_n = 0
		
		WHILE(sv_n < sv_j)
		#{
			
			##########################################
			#fetching the part tran type
			############################################
			
			CUST.CLA.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.partTranType.code"
			sv_u = urhk_SRV_GetVal(CUST.CLA.msgStr)
			IF(sv_u != 0) THEN
			#{
				GOTO NEXTFETCH1
			#}
			ENDIF
			
			PRINT(BANCS.OUTPARAM.srvValue)
			CUST.CLA.partTranType = BANCS.OUTPARAM.srvValue
			
			#############################################
			#fetching the foracid of the part tran
			###############################################
			
			CUST.CLA.msgStr = "tranDtl.partTranDetailLL.<rec_" + FORMAT$(sv_n, "%d") + ">.acctId.foracid"
			sv_u = urhk_SRV_GetVal(CUST.CLA.msgStr)
			IF(sv_u != 0) THEN
			#{
				GOTO NEXTFETCH1
			#}
			ENDIF
			
			PRINT(BANCS.OUTPARAM.srvValue)
			CUST.CLA.foracid = BANCS.OUTPARAM.srvValue
			IF((CUST.CLA.foracid != CUST.CLA.linkAc) AND (CUST.CLA.claAcct != CUST.CLA.foracid))THEN
			#{
				CUST.CLA.linkAcFlg = "F"
			#}
			ENDIF
			
		NEXTFETCH1:
			
			sv_n = sv_n + 1
		#}
		DO
		
		IF(CUST.CLA.linkAcFlg == "F")THEN
		#{
			CUST.CLA.errorMsg = "Transactions are allowed between Credit Line Acs AND their Linked Current Acs only!!"
			sv_u = urhk_SRV_SetErr(CUST.CLA.errorMsg)
			EXITSCRIPT
		#}
		ENDIF
		
END-->
