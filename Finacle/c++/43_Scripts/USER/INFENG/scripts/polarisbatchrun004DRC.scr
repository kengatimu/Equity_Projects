								ENDIF
								
								MISS.CHRG.foracid=MISS.CHRG.charge_acc
								print(MISS.CHRG.foracid)
								
								#--------------------------------------------------------------------------------------------------------------
								# Inputs for Account lien services
								# urhk_SetUrhkInp is used to set inputs
								#--------------------------------------------------------------------------------------------------------------
								sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + MISS.CHRG.foracid)
								PRINT(sv_u)
								sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
								PRINT(sv_u)
								sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" + MISS.CHRG.transaction_currencycode)
								PRINT(sv_u)
								sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
								PRINT(sv_u)
								sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + MISS.CHRG.amount)
								PRINT(sv_u)
								sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + MISS.CHRG.amount1)
								PRINT(sv_u)
