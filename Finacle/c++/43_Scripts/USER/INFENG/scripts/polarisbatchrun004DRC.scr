									PRINT(sv_u)
									sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + MISS.CHRG.amount)
									PRINT(sv_u)
									sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + MISS.CHRG.amount1)
									PRINT(sv_u)
									sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + MISS.CHRG.date)
									PRINT(sv_u)
									sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + MISS.CHRG.date)
									PRINT(sv_u)
									sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|CHRGL")
									PRINT(sv_u)
									sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + MISS.CHRG.credit_accountidvat)
									PRINT(sv_u)
									sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + MISS.CHRG.narr4)
									
									sv_u = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
									PRINT(sv_u)
									
									IF (sv_u==0) THEN
									#{
										PRINT(MISS.CHRG.foracid)
										PRINT(BANCS.STDIN.contextBankId)
									#}
									ENDIF
									
									#----------------------------------------------------------------------------------------------------
									# SRV Error check
									#----------------------------------------------------------------------------------------------------
									IF (sv_u != 0) THEN
									#{
										
										MISS.CHRG.errMsg="Error Creating Lien"
										#{
										IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
										#{
											PRINT(BANCS.OUTPARAM.Error_num)
											sv_v = BANCS.OUTPARAM.Error_num
											#}
										ELSE
											#{
											sv_v = 0
										#}
										ENDIF
										IF (sv_v > 0) THEN
										#{
											sv_u = SYSTEM("echo 'Error for Acct:"+MISS.CHRG.foracid+" ' >>lienedacct.log")
											sv_i = 1
											sv_f = FORMAT$(sv_i,"%d")
											sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
											sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
											sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
											PRINT(sv_e)
