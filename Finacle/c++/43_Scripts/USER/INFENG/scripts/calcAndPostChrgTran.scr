						lv_s = lv_s + " SELECT AMT_DERV_SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+CUST.TRAN.chrgEvntId+"' AND "
						lv_s = lv_s + " EVENT_TYPE = 'GCHRG' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"') "
						print(lv_s)
						
						lv_q = urhk_dbSelectWithBind(lv_s)
						print(lv_q)
						
						IF(lv_q == 0)THEN
						#{
							CUST.TRAN.chrg_amt_ind = BANCS.OUTPARAM.chrg_amt_ind
							PRINT(CUST.TRAN.chrg_amt_ind)
							CUST.TRAN.chrg_amt_pcnt = BANCS.OUTPARAM.chrg_amt_pcnt
							PRINT(CUST.TRAN.chrg_amt_pcnt)
							
							IF(CUST.TRAN.chrg_amt_ind == "P")THEN
							#{
								CUST.TRAN.chrgAmt_new = CDOUBLE(CUST.TRAN.tranAmt) * (CDOUBLE(lv_o) / CDOUBLE(CUST.TRAN.chrg_amt_pcnt))
								PRINT(CUST.TRAN.chrgAmt_new)
								
								CUST.TRAN.tranAmt = CUST.TRAN.chrgAmt_new
								PRINT(CUST.TRAN.tranAmt)
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}	
			ELSE
			#{
				PRINT("ERROR")
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	###--Preferential Charges on Acct levels etc START
	CUST.PREF.drAcctId = CUST.TRAN.foracid
	#CUST.PREF.inputAmt = CUST.TRAN.tranAmt
	CUST.PREF.inputAmt = CUST.TRAN.tranAmt_1
	CUST.PREF.eventId = CUST.TRAN.chrgEvntId
				PRINT(CUST.PREF.drAcctId)
				PRINT(CUST.PREF.inputAmt)
				PRINT(CUST.PREF.eventId)
				
				sv_s = "entityId, foracid, cust_id|"
				sv_s = sv_s + "SELECT ACID, FORACID, CIF_ID FROM TBAADM.GAM WHERE FORACID = '"+CUST.PREF.drAcctId+"'"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN	
					BANCS.INPUT.entityId = BANCS.OUTPARAM.entityId
					BANCS.INPUT.foracid = BANCS.OUTPARAM.foracid
					BANCS.INPUT.cust_id = BANCS.OUTPARAM.cust_id
					
					BANCS.INPUT.eventtype = "GCHRG"
					BANCS.INPUT.eventid = CUST.PREF.eventId
					
					PRINT(BANCS.INPUT.eventtype)
					PRINT(BANCS.INPUT.eventid)
					PRINT(BANCS.INPUT.entityId)
					PRINT(BANCS.INPUT.foracid)
					PRINT(BANCS.INPUT.cust_id)
				ELSE
					PRINT("Error occurred.")
					exitscript
				ENDIF
				
				##Variable Initialization
				BANCS.INPUT.AMTIND="N"
				BANCS.INPUT.AMT="0"
				BANCS.INPUT.PRCNT="0"
				
				#Acid
				IF(FIELDEXISTS(BANCS.INPUT.entityId))THEN
					
					print(BANCS.INPUT.entityId)
					
					sv_s = " corp_id, SEGMENT, foracid,cust_id,ccy| select corp_id, SEGMENTATION_CLASS,foracid,cif_id,acct_crncy_code from crmuser.accounts,tbaadm.gam " 
					sv_s = sv_s + " where orgkey =cif_id  and acid ='"+BANCS.INPUT.entityId+"'"
					sv_s = sv_s + " and gam.bank_id='"+BANCS.STDIN.contextBankId+"'     and  rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN		

						if(BANCS.OUTPARAM.corp_id !="") then
							BANCS.INPUT.custtype="C"
						else
							BANCS.INPUT.custtype="R"
						endif
						BANCS.INPUT.SME=BANCS.OUTPARAM.SEGMENT
						BANCS.INPUT.foracid=BANCS.OUTPARAM.foracid
						BANCS.INPUT.ccy=BANCS.OUTPARAM.ccy
						BANCS.INPUT.cust_id=BANCS.OUTPARAM.cust_id
					else
						BANCS.INPUT.SME=""
						BANCS.INPUT.foracid=""
						BANCS.INPUT.cust_id=""
						BANCS.INPUT.custtype=""
					ENDIF
				
				ELSE
					BANCS.INPUT.eventid="XXXXX"
					BANCS.INPUT.eventtype="XXXXX"
					BANCS.INPUT.foracid=""
					BANCS.INPUT.cust_id="XXXX"
					BANCS.INPUT.cifid="XXX"
					BANCS.INPUT.AGREEMENT_CODE=""
					BANCS.INPUT.SME=""
					BANCS.INPUT.custtype=""
					print(BANCS.INPUT.cust_id) 
					BANCS.INPUT.AMT1= 0
				ENDIF
				
				
				#Foracid
				sv_s =" AMTIND, PRCNT,AMT | select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
				sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
				sv_s = sv_s + " and foracid ='"+BANCS.INPUT.foracid +"'"
				sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
				sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN

					BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
					BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
					BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
					BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					print(BANCS.INPUT.AMT)
				else
					##BANCS.INPUT.AMTIND="N"
					##BANCS.INPUT.AMT="0"
					##BANCS.INPUT.PRCNT="0"
					BANCS.INPUT.TEST="1"
					
					BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
					BANCS.INPUT.AMT=BANCS.INPUT.AMT
					BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
				ENDIF
				
				
				#Cif id
				sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
				sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
				sv_s = sv_s + " and cust_id ='"+BANCS.INPUT.cust_id+"'"
				sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
				sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN
					BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
					BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
					BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
					BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
				else
					##BANCS.INPUT.AMTIND="N"
					##BANCS.INPUT.AMT="0"
					##BANCS.INPUT.PRCNT="0"
					BANCS.INPUT.TEST="2"
					
								
					BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
					BANCS.INPUT.AMT=BANCS.INPUT.AMT
					BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
				ENDIF					
				
				#check agreement level	
				IF (BANCS.INPUT.AMTIND=="N") THEN
					
					sv_s =" AGREEMENT_CODE| select employerid from CRMUSER.DEMOGRAPHIC where orgkey = "
					sv_s = sv_s + " (select  cif_id from tbaadm.cmg where CIF_ID ='"+BANCS.INPUT.cust_id+"')"
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN
						BANCS.INPUT.AGREEMENT_CODE=BANCS.OUTPARAM.AGREEMENT_CODE
					else
						BANCS.INPUT.AGREEMENT_CODE=""
					ENDIF
						
					sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
					sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
					sv_s = sv_s + " and AGREEMENT_CODE='"+BANCS.INPUT.AGREEMENT_CODE+"'"
					sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN
						BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
						BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
						BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
						BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					else
						##BANCS.INPUT.AMTIND="N"
						##BANCS.INPUT.AMT="0"
						##BANCS.INPUT.PRCNT="0"
						BANCS.INPUT.TEST="3"
						
						BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
						BANCS.INPUT.AMT=BANCS.INPUT.AMT
						BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
					ENDIF
				ENDIF
				

				#check SME level
				
				IF (BANCS.INPUT.AMTIND=="N") THEN
				#{
					sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
					sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
					sv_s = sv_s + " and SME ='"+BANCS.INPUT.SME+"'"
					sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN		
						BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
						BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
						BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
						BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					else
						##BANCS.INPUT.AMTIND="N"
						##BANCS.INPUT.AMT="0"
						##BANCS.INPUT.PRCNT="0"
						BANCS.INPUT.TEST="4"
						
						BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
						BANCS.INPUT.AMT=BANCS.INPUT.AMT
						BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
					ENDIF
				#}
				ENDIF


				#check BANk level
				
				IF (BANCS.INPUT.AMTIND=="N") THEN
				
					sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
					sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
					sv_s = sv_s + " and  cust_type ='"+BANCS.INPUT.custtype+"'"
					sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN
						BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
						BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
						BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
						BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					else
						##BANCS.INPUT.AMTIND="N"
						##BANCS.INPUT.AMT="0"
						##BANCS.INPUT.PRCNT="0"
						BANCS.INPUT.TEST="5"
						
						BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
						BANCS.INPUT.AMT=BANCS.INPUT.AMT
						BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
					ENDIF
				ENDIF
				
				print(BANCS.INPUT.AMTIND)
				print(BANCS.INPUT.AMT)
				print(BANCS.INPUT.PRCNT)
				
				IF ((BANCS.INPUT.AMTIND=="A") or (BANCS.INPUT.AMTIND=="P")) then
					IF(BANCS.INPUT.AMTIND=="A")then
						CUST.PREF.chrgAmt = BANCS.INPUT.AMT
					ENDIF

					IF(BANCS.INPUT.AMTIND=="P")THEN
						print(BANCS.INPUT.PRCNT)
						IF (BANCS.INPUT.PRCNT!="") then
							IF (BANCS.INPUT.PRCNT <100) THEN
								#IF(BANCS.INPUT.PRCNT < 1 )THEN
								IF(BANCS.INPUT.PRCNT <= 0 )THEN
									PRINT("Zero charge")
									CHRG.TXN.toChrg = "N"
									GOTO CHARGING
								ENDIF
								CUST.PREF.chrgAmt = CDOUBLE(CUST.PREF.inputAmt) * CDOUBLE(BANCS.INPUT.PRCNT) * (0.01)
								print(CUST.PREF.chrgAmt)
								
								lv_s = "chrg_amt_ind, chrg_amt_pcnt| "
								lv_s = lv_s + " SELECT AMT_IND, AMT_PCNT FROM TBAADM.ADM WHERE AMT_DRV_SRL_NUM IN ( "
								lv_s = lv_s + " SELECT AMT_DERV_SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+CUST.PREF.eventId+"' AND "
								lv_s = lv_s + " EVENT_TYPE = 'GCHRG' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"') "
								print(lv_s)
								
								lv_q = urhk_dbSelectWithBind(lv_s)
								print(lv_q)
								
								IF(lv_q == 0)THEN
								#{
									CUST.PREF.chrg_amt_ind = BANCS.OUTPARAM.chrg_amt_ind
									PRINT(CUST.PREF.chrg_amt_ind)
									CUST.PREF.chrg_amt_pcnt = BANCS.OUTPARAM.chrg_amt_pcnt
									PRINT(CUST.PREF.chrg_amt_pcnt)
									
									IF(CUST.PREF.chrg_amt_ind == "P")THEN
									#{
										print(CUST.PREF.chrgAmt)
										
										CUST.PREF.chrgAmt = CDOUBLE(CUST.PREF.chrgAmt) / (CDOUBLE(CUST.PREF.chrg_amt_pcnt) * (0.01))
										#CUST.PREF.chrgAmt = CDOUBLE(CUST.PREF.inputAmt) * (CDOUBLE(BANCS.INPUT.PRCNT) / CDOUBLE(CUST.PREF.chrg_amt_pcnt))
										print(CUST.PREF.chrgAmt)
										CUST.TRAN.tranAmt = CUST.PREF.chrgAmt
									#}
									ENDIF
								#}
								ENDIF
							ELSE
								BANCS.INPUT.PRCNT=0
								#CUST.PREF.chrgAmt = cdouble(CUST.PREF.inputAmt) - cdouble(CUST.PREF.inputAmt) * cdouble(BANCS.INPUT.PRCNT)* 0.01
								CUST.PREF.chrgAmt = 0
								CUST.TRAN.tranAmt = CUST.PREF.chrgAmt
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				
#				print(CUST.PREF.chrgAmt)
	
	###--Preferential Charges on Acct levels etc END
		
	###########################

	#---------------------------------------------------------------#
	#Calling GCHRG script for Charge Transaction			#
	#---------------------------------------------------------------#
	
	CHARGING:
	
	CUST.GCHRG.tranType	= "T"
	CUST.GCHRG.tranSubType	= "CI"
	CUST.GCHRG.drAcctId	= CUST.TRAN.foracid
	CUST.GCHRG.acctCrncyCode= CUST.TRAN.acctCrncy
	CUST.GCHRG.eventId	= CUST.TRAN.chrgEvntId
	#CUST.GCHRG.chrgAmt	= ""
	CUST.GCHRG.chrgAmt	= CUST.TRAN.tranAmt+"|"+CUST.TRAN.acctCrncy

	IF(CHRG.TXN.toChrg == "N")THEN
	#{
		PRINT("Zero charge")
		CUST.GCHRG.successOrFailure = "S"
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		print(CUST.TRAN.acctCrncy)
		IF(CUST.TRAN.acctCrncy == "CDF")THEN
			PRINT("Zero charge")
			CUST.GCHRG.successOrFailure = "S"
			GOTO ENDOFSCRIPT
		ELSE
			CALL("gchrgcommon.scr")
		ENDIF
	#}
	ENDIF	
		

		IF(FIELDEXISTS(CUST.GCHRG.successOrFailure))THEN
		#{
			print(CUST.GCHRG.successOrFailure)
		#{
		else
		#}	
			CUST.GCHRG.successOrFailure="F"
		#}
		ENDIF
	IF(CUST.GCHRG.successOrFailure == "S") THEN
	#{
		IF(FIELDEXISTS(CUST.GCHRG.chargeTranId))THEN
		#{
			PRINT(CUST.TRAN.vatacnt)
			#{
			else
			#}
			CUST.GCHRG.chargeTranId="NIL"

		#}
		ENDIF

		IF(FIELDEXISTS(CUST.GCHRG.chargeTranDate))THEN
		#{
			PRINT(CUST.GCHRG.chargeTranDate)
			#{
			else
			#}
			CUST.GCHRG.chargeTranDate="01-jan-1900"

		#}
		ENDIF

		PRINT(CUST.GCHRG.chargeTranId)
		PRINT(CUST.GCHRG.chargeTranDate)

		IF(FIELDEXISTS(CUST.GCHRG.chrgacnt))THEN
		#{
			CUST.TRAN.chrgacnt = CUST.GCHRG.chrgacnt
			PRINT(CUST.TRAN.chrgacnt)
			#{
			else
			#}
			CUST.GCHRG.chrgacnt="NIL"
		#}
		ENDIF


		IF(FIELDEXISTS(CUST.GCHRG.vatacnt))THEN
		#{
			CUST.TRAN.vatacnt= CUST.GCHRG.vatacnt
			PRINT(CUST.TRAN.vatacnt)
		#{
		else
		#}
			CUST.GCHRG.vatacnt="NIL"
		#}
		ENDIF
	#}
	ELSE
	#{
		IF (FIELDEXISTS(CUST.GCHRG.calcAmt)) THEN
			IF (CDOUBLE(CUST.GCHRG.calcAmt) == CDOUBLE("0")) THEN
			#{
				CUST.TRAN.errorFlg = "N"
				CUST.TRAN.errorMsg = " "
			#}
			ELSE
			#{
				CUST.TRAN.errorFlg = "Y"
				CUST.TRAN.errorMsg = CUST.GCHRG.gchrgErrMsg
			#}
			ENDIF
		ENDIF
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	##########Fetching Amount for Custom Table Entry########
	
	CUST.TRAN.vatAmt = "0"
	CUST.TRAN.chrgAmt = "0"
	CUST.TRAN.evntChrgCrncy = " "
	
	sv_a = "refCrncy, refAmt|select REF_CRNCY_CODE,REF_AMT from tbaadm.dtd where tran_id = ?SVAR and tran_date = to_date(?SVAR,'dd-mm-yyyy') and bank_id = ?SVAR and cust_id is not null "
	BANCS.INPARAM.BINDVARS = CUST.GCHRG.chargeTranId + "|" + CUST.GCHRG.chargeTranDate  + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbCursorOpenWithBind(sv_a)
	PRINT(sv_r)
	sv_k = 1
	IF(sv_r == 0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_m)
		sv_z = urhk_dbCursorFetch(sv_m)
		WHILE (sv_z != 1)
		#{
			print(BANCS.OUTPARAM.refCrncy)
			print(BANCS.OUTPARAM.refAmt)
			
			IF(sv_k ==1)THEN
			#{
				CUST.TRAN.evntChrgCrncy = BANCS.OUTPARAM.refCrncy
				CUST.TRAN.chrgAmt = BANCS.OUTPARAM.refAmt
			#}
			ELSE
			#{
				CUST.TRAN.evntVATCrncy = BANCS.OUTPARAM.refCrncy
				CUST.TRAN.vatAmt = BANCS.OUTPARAM.refAmt
			#}
			ENDIF
			
			sv_z = urhk_dbCursorFetch(sv_m)
			PRINT(sv_z)
			sv_k = 2
		#}
		DO
		sv_z = urhk_dbCursorClose(sv_m)
		print(sv_z)
		#}
	ELSE
		#{
		CUST.TRAN.errorFlg = "Y"
		CUST.TRAN.errorMsg = "Unable to fetch Charge details"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	########################################################
	print(CUST.TRAN.chrgAmt)
	print(CUST.TRAN.vatAmt)
	print(CUST.TRAN.evntChrgCrncy)
	print(CUST.TRAN.chrgAmt )	
	print(CUST.TRAN.vatAmt )
	print(CUST.TRAN.foracid)
	print(CUST.GCHRG.vatacnt)
	print(CUST.GCHRG.chrgacnt)



	sv_s = "Insert into CUSTOM.C_CTDT (PARENT_TRAN_ID, PARENT_TRAN_DATE, EVENT_TYPE, EVENT_ID, SERVICE_SOL_ID, CHRG_TRAN_ID, CHRG_TRAN_DATE, COLL_CRNCY_CODE, CHRG_AMT, VAT_AMT, RCRE_USER_ID"
	sv_s = sv_s + " ,RCRE_TIME, BANK_ID,ACCT_ID,VAT_ACCT_ID,CHRG_ACCT_ID) Values(?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, ?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, ?SVAR, sysdate , ?SVAR,?SVAR,?SVAR,?SVAR )"
	
	BANCS.INPARAM.BINDVARS = CUST.TRAN.origTranId + "|" + CUST.TRAN.origTranDate + "|" + "GCHRG" + "|" + CUST.TRAN.chrgEvntId  + "|" + BANCS.STDIN.mySolId + "|" + CUST.GCHRG.chargeTranId + "|" + CUST.GCHRG.chargeTranDate
	print(BANCS.INPARAM.BINDVARS)
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.TRAN.evntChrgCrncy + "|" + CUST.TRAN.chrgAmt + "|" + CUST.TRAN.vatAmt + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.TRAN.foracid  + "|" +  CUST.GCHRG.vatacnt + "|"+ CUST.GCHRG.chrgacnt
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.TRAN.errorFlg ="Y"
		CUST.TRAN.errorMsg ="Error in DB Operation!!"
	#}
	ENDIF

	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errFlg|"+CUST.TRAN.errorFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("message|"+CUST.TRAN.errorMsg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("cxlTranId|"+CUST.GCHRG.chargeTranId)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("cxlTranDate|"+CUST.GCHRG.chargeTranDate)
		PRINT(sv_u)
		
		DELETECLASS("CUST","GCHRG")
		DELETECLASS("CUST","TRAN")
		DELETEREP("CUST")
		
		IF (CLASSEXISTS("CHRG","TXN") == 1) THEN
		#{
			DELETECLASS("CHRG","TXN")
		#}
		ENDIF
		
		IF (REPEXISTS("CHRG") == 1) THEN
		#{
			DELETEREP("CHRG")
		#}
		ENDIF
END-->
