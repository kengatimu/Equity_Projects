#------------------------------------------------------------------------------------------------
#  Name            : FI_DestroyChq.scr
#  Description     : Destroy cheque API
#  Date            : 06-04-2023
#  Author          : James Maina
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             06-04-2023      James Maina		Original Version
#-----------------------------------------------------------------------------------------------

<--start
trace on

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","CHQ") == 0) THEN
        #{
                CREATECLASS("CUST","CHQ",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print (sv_a)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("AcctNo"))== 0) ) THEN
	#{
   		CUST.CHQ.errMsg="AcctNo IS NULL"
		sv_t = "MSG | " +CUST.CHQ.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Function"))== 0) ) THEN
	#{
   		CUST.CHQ.errMsg="FunctionIS NULL"
		sv_t = "MSG | " +CUST.CHQ.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("BeginCheqNo"))== 0) ) THEN
	#{
   		CUST.CHQ.errMsg="BeginCheqNo IS NULL"
		sv_t = "MSG | " +CUST.CHQ.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	#}
	ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("NoOfLeaves"))== 1) ) THEN
	#{
		CUST.CHQ.NoOfLeaves= BANCS.INPUT.NoOfLeaves
		PRINT(CUST.CHQ.NoOfLeaves)
	#}
	ELSE
	#{
		CUST.CHQ.NoOfLeaves=""
		PRINT(CUST.CHQ.NoOfLeaves)
	#}
	ENDIF
	
	#----------------------------------------------------------------------------------
	#Variable Initialization
	#----------------------------------------------------------------------------------
	CUST.CHQ.AcctNo= TRIM(BANCS.INPUT.AcctNo)
	print(CUST.CHQ.AcctNo)
	CUST.CHQ.Function= BANCS.INPUT.Function
	print(CUST.CHQ.Function)
	CUST.CHQ.BeginCheqNo= BANCS.INPUT.BeginCheqNo
	print(CUST.CHQ.BeginCheqNo)
	
	IF(CUST.CHQ.NoOfLeaves=="")THEN
	#{
		IF(CUST.CHQ.Function =="D")THEN
		#{
   			CUST.CHQ.errMsg="NoOfLeaves is null"
			sv_t = "MSG | " +CUST.CHQ.errMsg
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
			sv_u = urhk_SetOrbOut(sv_t)
   			GOTO ENDSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	#----------------------------------------------------------------------------------
	#Function code validation
	#----------------------------------------------------------------------------------
	IF((CUST.CHQ.Function !="D") AND (CUST.CHQ.Function !="V") )THEN
	#{
   		CUST.CHQ.errMsg="Invalid Function code. valid[D,V]"
		sv_t = "MSG | " +CUST.CHQ.errMsg
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT

	#}
	ENDIF
	#----------------------------------------------------------------------------------
	#Destroy process
	#----------------------------------------------------------------------------------
	IF(CUST.CHQ.Function=="D")THEN
	#{
		sv_u = urhk_SetUrhkInp("acct.foracid|" + CUST.CHQ.AcctNo)
		sv_u = urhk_SetUrhkInp("newStat.code|" + CUST.CHQ.Function)
		sv_u = urhk_SetUrhkInp("beginChqNum|" + CUST.CHQ.BeginCheqNo)
		sv_u = urhk_SetUrhkInp("numOfLvs|" + CUST.CHQ.NoOfLeaves)
		
		sv_u = urhk_ExecSrv("SRV_FetchChqBookDtlForMaint|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_MaintChqBook|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
   				CUST.CHQ.errMsg="Successfully Destroyed.Pendind Verification"
				sv_t = "MSG | " +CUST.CHQ.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Success")
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ELSE
			#{
				GOTO ERRORCHECK
			#}
			ENDIF
		#}
		ELSE
		#{
			GOTO ERRORCHECK
		#}
		ENDIF
	#}
	ENDIF
	#----------------------------------------------------------------------------------
	#verification process
	#----------------------------------------------------------------------------------
	IF(CUST.CHQ.Function=="V")THEN
	#{
		sv_u = urhk_SetUrhkInp("acct.foracid|" + CUST.CHQ.AcctNo)
		sv_u = urhk_SetUrhkInp("newStat.code|" + CUST.CHQ.Function)
		sv_u = urhk_SetUrhkInp("beginChqNum|" + CUST.CHQ.BeginCheqNo)
	
		sv_u = urhk_ExecSrv("SRV_FetchChqBookMaintDtlForVerify|retain_all_output = Y|same_user_verify = Y")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			PRINT(sv_u)
			sv_u = urhk_ExecSrv("SRV_VerifyChqBookMaint|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
   				CUST.CHQ.errMsg="Successfully Verified"
				sv_t = "MSG | " +CUST.CHQ.errMsg
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Success")
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ELSE
			#{
				GOTO ERRORCHECK
			#}
			ENDIF
		#}
		ELSE
		#{
			GOTO ERRORCHECK
		#}
		ENDIF
	#}
	ENDIF


	ERRORCHECK:
	#----------------------------------------------------------------------------------------------------
	# SRV Error check
	#----------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}									
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) then
		#{
			sv_u = system("echo 'Error'")
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
				sv_u = system("echo '"+sv_e+"' >>DestroyChq.log")
				print(sv_u)
				
				#Error response
				sv_t = "MSG | " +sv_e
				sv_u = urhk_SetOrbOut("SuccessOrFailure|Failed")
				sv_u = urhk_SetOrbOut(sv_t)

			#}
			DO
			#}
		ENDIF
	#}
	ENDIF




ENDSCRIPT:


trace off

end-->