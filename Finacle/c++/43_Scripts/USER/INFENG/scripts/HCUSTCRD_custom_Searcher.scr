<--START

TRACE ON

##------------------------------------
## Creation of Repository and Classes
##------------------------------------
 IF (REPEXISTS("CUST") == 0) THEN
 #{
                 CREATEREP("CUST")
 #}
 ENDIF
 IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
 #{
                 CREATECLASS("CUST", "DATA", 5)
 #}
 ENDIF

CUST.DATA.FORACID = ""
CUST.DATA.cif_id = ""
CUST.DATA.AGREEMENT = ""

CUST.DATA.funcCode             =BANCS.INPUT.funcCode
print(CUST.DATA.funcCode)
CUST.DATA.Level                 =  BANCS.INPUT.Level
PRINT(CUST.DATA.Level)


		#================================================================================
		# Category Type and Account Type Searcher
		#================================================================================

		CUST.DATA.recCount = "0"

		sv_s = ""
		IF (CUST.DATA.Level == "C" ) THEN
                #{
			sv_s = sv_s + " cif_id,evttyp,evtid|select CUST_ID,EVENT_TYPE,EVENT_ID "			
                #}
                ENDIF

                IF (CUST.DATA.Level == "A" ) THEN
                #{
                        sv_s = sv_s + " FORACID,evttyp,evtid|select FORACID,EVENT_TYPE,EVENT_ID  "
                #}
                ENDIF

                IF (CUST.DATA.Level == "AG" ) THEN
                #{
                        sv_s = sv_s + " AGREEMENT,evttyp,evtid|select AGREEMENT ,EVENT_TYPE,EVENT_ID  "
                #}
                ENDIF
		IF ((CUST.DATA.funcCode == "M") or (CUST.DATA.funcCode == "I")) THEN
		#{
		     sv_s = sv_s + "from C_HCUSTCRG_MAIN "
		#}
		ENDIF
		IF ((CUST.DATA.funcCode == "V") or (CUST.DATA.funcCode == "X")) THEN
		#{
		     sv_s = sv_s + "from C_HCUSTCRG_MOD "
		#}
		ENDIF

		sv_s = sv_s + " WHERE  DEL_FLG !='Y'"

                IF (CUST.DATA.Level == "C" ) THEN
                #{
                        sv_s = sv_s + " and CUST_ID is not null "
                #}
                ENDIF

                IF (CUST.DATA.Level == "A" ) THEN
                #{
                        sv_s = sv_s + " and FORACID is not null "
                #}
                ENDIF

                IF (CUST.DATA.Level == "AG" ) THEN
                #{
                        sv_s = sv_s + " and AGREEMENT is not null "
                #}
                ENDIF
		
		PRINT(sv_s)
		lv_c = urhk_dbCursorOpenWithBind(sv_s)
		PRINT(lv_c)

		IF(lv_c == 0) THEN
		#{
			lv_e = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(lv_e)

			lv_f = urhk_dbCursorFetch(lv_e)
			PRINT(lv_f)

			CUST.DATA.recCount = 0

			lv_x = 1
			WHILE(lv_f == 0)
			#{
				CUST.DATA.recCount    =       CINT(CUST.DATA.recCount) + 1
				PRINT(CUST.DATA.recCount)

				IF (CUST.DATA.Level == "C" ) THEN
				#{
					CUST.DATA.cif_id = BANCS.OUTPARAM.cif_id
					print(CUST.DATA.cif_id)
				#}
				ENDIF

				IF (CUST.DATA.Level == "A" ) THEN
				#{
					CUST.DATA.FORACID = BANCS.OUTPARAM.FORACID
					print(CUST.DATA.FORACID)
				#}
				ENDIF

				IF (CUST.DATA.Level == "AG" ) THEN
				#{
					CUST.DATA.AGREEMENT = BANCS.OUTPARAM.AGREEMENT
					print(CUST.DATA.AGREEMENT)
				#}
				ENDIF
                                CUST.DATA.evttyp   =  BANCS.OUTPARAM.evttyp
                                CUST.DATA.evtid    =  BANCS.OUTPARAM.evtid
	
				lv_z = urhk_SetOrbOut("count|"+CUST.DATA.recCount)
				PRINT(lv_z)
			

				lv_y = FORMAT$(lv_x,"%d")	

				PRINT(lv_y)

                                IF (CUST.DATA.evttyp == "") THEN
                                #{
                                        lv_r = "evtType_" + CUST.DATA.recCount + "| "
                                        PRINT(lv_r)
                                #}
                                ELSE
                                #{
                                        lv_r = "evtType_" + CUST.DATA.recCount + "|" + CUST.DATA.evttyp
                                        PRINT(lv_r)
                                #}
                                ENDIF
                                lv_m = urhk_SetOrbOut(lv_r)
                                PRINT(lv_m)

                                IF (CUST.DATA.evtid == "") THEN
				#{
					lv_r = "evtId_" + CUST.DATA.recCount + "| "
					PRINT(lv_r)
				#}
				ELSE
				#{
					lv_r = "evtId_" + CUST.DATA.recCount + "|" + CUST.DATA.evtid
					PRINT(lv_r)
				#}
				ENDIF
				lv_m = urhk_SetOrbOut(lv_r)
				PRINT(lv_m)


				IF (CUST.DATA.Level == "C" ) THEN
                                #{

					IF (CUST.DATA.cif_id == "") THEN
					#{
						lv_r = "cifId_" + CUST.DATA.recCount + "| "
						PRINT(lv_r)
					#}
					ELSE
					#{
						lv_r = "cifId_" + CUST.DATA.recCount + "|" + CUST.DATA.cif_id
						PRINT(lv_r)
					#}
					ENDIF
					lv_m = urhk_SetOrbOut(lv_r)
					PRINT(lv_m)
				#}
				ENDIF	
				
				 IF (CUST.DATA.Level == "A" ) THEN
                                #{
					IF (CUST.DATA.FORACID  == "") THEN
					#{
						lv_r = "acctNum_" + CUST.DATA.recCount + "| "
						PRINT(lv_r)
					#}
					ELSE
					#{
						lv_r = "acctNum_" + CUST.DATA.recCount + "|" + CUST.DATA.FORACID 
						PRINT(lv_r)
					#}
					ENDIF
					lv_m = urhk_SetOrbOut(lv_r)
					PRINT(lv_m)

				#}
				ENDIF
				
				IF (CUST.DATA.Level == "AG" ) THEN
                                #{
	
					IF (CUST.DATA.AGREEMENT == "") THEN
					#{
						lv_r = "EmpId_" + CUST.DATA.recCount + "| "
						PRINT(lv_r)
					#}
					ELSE
					#{
						lv_r = "EmpId_" + CUST.DATA.recCount + "|" + CUST.DATA.AGREEMENT
						PRINT(lv_r)
					#}
					ENDIF
					lv_m = urhk_SetOrbOut(lv_r)
					PRINT(lv_m)
	
				#}
				ENDIF	

				lv_x = lv_x + 1
				lv_f = urhk_dbCursorFetch(lv_e)
				PRINT(lv_f)
			#}
			DO
			lv_a = urhk_dbCursorClose(lv_e)
			PRINT(lv_a)	
		#}
		ENDIF

ENDOFSCRIPT:

	EXITSCRIPT
	TRACE OFF

END-->
