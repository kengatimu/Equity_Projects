
<--START
	# Script body goes here
	TRACE ON
	
	#==================================================================================================
	# Repository and Class Creation
	#==================================================================================================
	IF (REPEXISTS("CUST")== 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST" , "DATA",5)
	#}
	ENDIF
	
	CUST.DATA.nostro = ""
	CUST.DATA.bic = ""
	CUST.DATA.susAcct = ""
	CUST.DATA.outEvntId = ""
	CUST.DATA.inEvntId = ""
	CUST.DATA.errMsg = ""
	
	
	IF (FIELDEXISTS(BANCS.INPUT.nostroAcct)) THEN
	#{
		CUST.DATA.nostro = BANCS.INPUT.nostroAcct
		PRINT(CUST.DATA.nostro)
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.INPUT.BICCode)) THEN
	#{
		CUST.DATA.bic = BANCS.INPUT.BICCode
		PRINT(CUST.DATA.bic)
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.INPUT.suspenseAcct)) THEN
	#{
		CUST.DATA.susAcct = BANCS.INPUT.suspenseAcct
		PRINT(CUST.DATA.susAcct)
	#}
	ENDIF
	
	IF (FIELDEXISTS(BANCS.INPUT.outEventId)) THEN
	#{
		CUST.DATA.outEvntId = BANCS.INPUT.outEventId
		PRINT(CUST.DATA.outEvntId)
	#}
	ENDIF
	
	
	IF (FIELDEXISTS(BANCS.INPUT.inEventId)) THEN
	#{
		CUST.DATA.inEvntId = BANCS.INPUT.inEventId
		PRINT(CUST.DATA.inEvntId)
	#}
	ENDIF
	
	
	IF (CUST.DATA.nostro != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.nostro +"|"+ BANCS.STDIN.contextBankId
		sv_a = "count|SELECT COUNT(*) FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR AND ACCT_CLS_FLG = 'N' AND FREZ_REASON_CODE IS NULL"
		
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF (sv_b == 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.count
			PRINT(sv_c)
			IF (CINT(sv_c) == 0) THEN
			#{
				CUST.DATA.errMsg = "Invalid Nostro Account."
				sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF (CUST.DATA.susAcct != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.susAcct +"|"+ BANCS.STDIN.contextBankId
		sv_a = "count|SELECT COUNT(*) FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR AND ACCT_CLS_FLG = 'N' AND FREZ_REASON_CODE IS NULL"
		
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF (sv_b == 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.count
			PRINT(sv_c)
			IF (CINT(sv_c) == 0) THEN
			#{
				CUST.DATA.errMsg = "Invalid Suspense Account."
				sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF (CUST.DATA.bic != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.bic +"|"+ BANCS.STDIN.contextBankId
		sv_a = "count|SELECT COUNT(*) FROM TBAADM.BRBIC WHERE BANK_IDENTIFIER = ?SVAR AND BANK_ID = ?SVAR"
		
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF (sv_b == 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.count
			PRINT(sv_c)
			IF (CINT(sv_c) == 0) THEN
			#{
				CUST.DATA.errMsg = "Invalid Central Bank BIC."
				sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF (CUST.DATA.outEvntId != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.outEvntId +"|"+ BANCS.STDIN.contextBankId
		sv_a = "count|SELECT COUNT(*) FROM TBAADM.PTT WHERE EVENT_ID = ?SVAR AND BANK_ID = ?SVAR"
		
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF (sv_b == 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.count
			PRINT(sv_c)
			IF (CINT(sv_c) == 0) THEN
			#{
				CUST.DATA.errMsg = "Invalid RTGS OUT Event ID."
				sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF (CUST.DATA.inEvntId != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.inEvntId +"|"+ BANCS.STDIN.contextBankId
		sv_a = "count|SELECT COUNT(*) FROM TBAADM.PTT WHERE EVENT_ID = ?SVAR AND BANK_ID = ?SVAR"
		
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF (sv_b == 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.count
			PRINT(sv_c)
			IF (CINT(sv_c) == 0) THEN
			#{
				CUST.DATA.errMsg = "Invalid RTGS IN Event ID."
				sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		IF(CLASSEXISTS("CUST","DATA")!=0) THEN
		#{
			DELETECLASS("CUST","DATA")
		#}
		ENDIF
		IF(REPEXISTS("CUST")!=0) THEN
		#{
			DELETEREP("CUST")
		#}
		ENDIF
		TRACE OFF
		EXITSCRIPT
END-->
