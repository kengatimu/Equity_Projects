			CUST.CHRG.frezCode = BANCS.OUTPARAM.freezeCode
			CUST.CHRG.FORACIDNAME = BANCS.OUTPARAM.acctName 
			
			sv_e = BANCS.OUTPARAM.EffAvailableAmt
			PRINT(sv_e)
			CUST.CHRG.effavlamt = sv_e
		ENDIF

		PRINT(CUST.CHRG.actcrncy)
		PRINT(CUST.CHRG.CHARGE_CRNCY_CODE)
		
		##########################################################
		#RateCode######
		##########################################################
		
			IF (CUST.CHRG.CHARGE_CRNCY_CODE != CUST.CHRG.actcrncy) THEN
				sv_r = REPEXISTS("CUST")
				
				IF(sv_r == 0) THEN
					CREATEREP ("CUST")
				ENDIF
				sv_r = CLASSEXISTS("CUST","RATE")
