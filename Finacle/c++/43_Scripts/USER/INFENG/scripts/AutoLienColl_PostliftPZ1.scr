			sv_u = urhk_MTTS_EndDefinition("")
			PRINT(sv_u)
			
			PRINT(BANCS.OUTPARAM.MTTTranId)
			CUST.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
			print(CUST.CHRG.tranid)

			IF (CUST.CHRG.tranid !="") THEN
				sv_h = mid$(BANCS.STDIN.BODDate,0,10)
				print(sv_h)
				sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
				BANCS.INPARAM.BINDVARS =  sv_h
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d =="0") THEN
					print(BANCS.OUTPARAM.getboddate)
					sv_y = BANCS.OUTPARAM.getboddate
					print(sv_y)
					BANCS.INPARAM.BINDVARS =CUST.CHRG.tranid  + "|" + sv_y  + "|" + CUST.CHRG.LIEN_AMT  + "|" + CUST.CHRG.FORACID  + "|" + CUST.CHRG.B2K_ID 
					print(BANCS.INPARAM.BINDVARS)
					sv_j = " update custom.BULK_LIEN_COLLECTION_DRC set ACTUAL_ADJ_FLG='S', TRAN_ID=?SVAR , LAST_ADJ_DATE=?SVAR ,ADJ_AMT_LIEN=?SVAR where FORACID=?SVAR and B2K_ID = ?SVAR and ACTUAL_ADJ_FLG like '%PZ%' "
					print(sv_j)
					sv_w = urhk_dbSQLWithBind(sv_j)
					print(sv_w)
					sv_w = urhk_dbSQLWithBind("COMMIT")
					print(sv_w)
				ENDIF
			ENDIF

			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)

			sv_d = " Sleep 3"
			PRINT(sv_d)
			sv_u = SYSTEM(sv_d)
			PRINT(sv_u)
				
			NEXTACID:
		sv_q = urhk_dbCursorFetch(CUST.CHRG.DbcursorNumberPost)
