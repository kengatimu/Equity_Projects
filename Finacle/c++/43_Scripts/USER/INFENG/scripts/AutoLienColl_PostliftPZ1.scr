				CUST.CHRG.ErrorMessage=MTT.Error.Description
				PRINT(CUST.CHRG.ErrorMessage)
				CUST.CHRG.remark = CUST.CHRG.ErrorMessage
				CUST.CHRG.errMsg = CUST.CHRG.FORACID + "|" +CUST.CHRG.remark
				GOTO NEXTACID

			ENDIF
			############################################
			#Define Transaction
			#############################################
			MTT.TranDetails.TranID 					= ""
			MTT.TranDetails.TranDate                = "0"
			MTT.TranDetails.TranType                = "T"
			MTT.TranDetails.PostFlag                = "Y"
			MTT.TranDetails.TranSubType             = "BI"
			MTT.TranDetails.ReversalFlag            = "N"
			MTT.TranDetails.IgnoreExcp              = "I"
			MTT.TranDetails.Consolidate             = "Y"
			MTT.TranDetails.Remarks                 = "LienAutoCollection"
			sv_t = urhk_MTTS_DefineTransaction("Auto_Lien_Coll")
			
			IF(sv_t != 0) THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				CUST.CHRG.ErrorMessage=MTT.Error.Description
				PRINT(CUST.CHRG.ErrorMessage)
				CUST.CHRG.remark = CUST.CHRG.ErrorMessage
				CUST.CHRG.errMsg = CUST.CHRG.FORACID + "|" +CUST.CHRG.remark
				PRINT(CUST.CHRG.errMsg)
				GOTO NEXTACID
			ENDIF

			CUST.CHRG.debitAmt = CUST.CHRG.LIEN_AMT
			print(CUST.CHRG.debitAmt)
				##select  (case when (4000 - 2000)<0 then '1' when (4000 - 2000)>=0 then '0' end) fundsflg  from dual
                                ###sv_s = "Diff| select (to_date(?SVAR,'DD-MON-YYYY')-to_date(?SVAR,'DD-MON-YYYY')) as diff from dual"
                                sv_s = "Diff| select (case when (?SVAR - ?SVAR)<0 then '1' when (?SVAR - ?SVAR)>=0 then '0' end) as  fundsflg  from dual "
                                PRINT(sv_s)
                                BANCS.INPARAM.BINDVARS = CUST.CHRG.effavlamt + "|" + CUST.CHRG.debitAmt + "|" + CUST.CHRG.effavlamt + "|" + CUST.CHRG.debitAmt
                                PRINT(BANCS.INPARAM.BINDVARS)
                                sv_d = urhk_dbSelectWithBind(sv_s)
                                PRINT(sv_d)
                                IF(sv_d == 0) THEN
                                #{
                                        CUST.CHRG.differ = BANCS.OUTPARAM.Diff
                                        PRINT(CUST.CHRG.differ)
                                        if (CUST.CHRG.differ =="1") then
						CUST.CHRG.remark = "Insuffecient Funds"
						CUST.CHRG.errMsg = CUST.CHRG.FORACID+ "|"+CUST.CHRG.remark
						PRINT(CUST.CHRG.errMsg)
						GOTO NEXTACID
                                        endif
                                #}
                                ENDIF
			######################################
			# Debit part tran for charge
			######################################
			
			MTT.PartTranDetails.Account     = CUST.CHRG.FORACID
			MTT.PartTranDetails.RefCurrency= CUST.CHRG.CHARGE_CRNCY_CODE
			MTT.PartTranDetails.Particulars = CUST.CHRG.LIEN_REMARKS 
			MTT.PartTranDetails.Particulars2 = CUST.CHRG.B2K_ID
