		CUST.CHRG.DbcursorNumberPost = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(CUST.CHRG.DbcursorNumberPost)
		sv_q = urhk_dbCursorFetch(CUST.CHRG.DbcursorNumberPost)
