					CREATECLASS ("CUST","RATE",5)
				ENDIF
				
				CUST.RATE.acctCrncy = CUST.CHRG.actcrncy
				CUST.RATE.refCrncy = CUST.CHRG.CHARGE_CRNCY_CODE	
				CUST.RATE.TranType = "T"
				CALL("fetchRateCode.scr")
				
				CUST.CHRG.rateCode = CUST.RATE.rateCode
				CUST.CHRG.rate = CUST.RATE.rate
			ENDIF

			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)
			
			BANCS.INPARAM.PostTranFlg = "Y"
			BANCS.INPARAM.CommitFlg = "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
