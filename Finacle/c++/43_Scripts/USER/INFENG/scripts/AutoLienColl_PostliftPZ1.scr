	ENDIF
	
	sv_s = " ACID,B2K_TYPE, B2K_ID,LIEN_AMT,LIEN_REASON_CODE,LIEN_REMARKS, ALT_CRNCY_CODE,REQUEST_DEPARTMENT,FORACID,Acct_status | "
	sv_s = sv_s + "  select gg.acid,B2K_TYPE, B2K_ID,cc.LIEN_AMT,LIEN_REASON_CODE,LIEN_REMARKS, ALT_CRNCY_CODE,COLLECTION_ACCOUNT,cc.FORACID,ACTUAL_ADJ_FLG    " 
	sv_s = sv_s + "  from  custom.BULK_LIEN_COLLECTION_DRC cc ,tbaadm.gam gg,tbaadm.smt  where ACTUAL_ADJ_FLG='PZ1'   "
	sv_s = sv_s + "   and gg.FREZ_CODE not in ('T','D') and smt.acid=gg.acid  and smt.bank_id=gg.bank_id and smt.acct_status='A' and smt.bank_id='43' "
	sv_s = sv_s + "  and cc.foracid=gg.foracid and gg.bank_id='43' and  (gg.clr_bal_amt-gg.lien_amt)>=cc.LIEN_AMT  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUST.CHRG.FORACID
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_e = urhk_dbCursorOpenWithBind(sv_s)
