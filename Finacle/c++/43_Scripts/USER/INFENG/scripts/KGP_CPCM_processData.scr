        #---------------------------------------------
        #       Amount formating
        #---------------------------------------------

                BANCS.INPARAM.BINDVARS = CUST.CPCM.value1 +"|"+ CUST.CPCM.value2 +"|"+ CUST.CPCM.maxamt+"|"+ CUST.CPCM.minamt

                print(BANCS.INPARAM.BINDVARS)

		sv_z = "value1,value2,maxamt,minamt|SELECT REPLACE(REPLACE(?SVAR,'.',''),',','.'),REPLACE(REPLACE(?SVAR,'.',''),',','.'),REPLACE(REPLACE(?SVAR,'.',''),',','.'),REPLACE(REPLACE(?SVAR,'.',''),',','.') FROM DUAL"
                print(sv_z)

                sv_q = urhk_dbSelectWithBind(sv_z)
