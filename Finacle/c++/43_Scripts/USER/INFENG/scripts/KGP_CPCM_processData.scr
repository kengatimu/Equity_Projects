                sv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_DATA WHERE PREFERENTIAL_LEVEL = ?SVAR AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
                PRINT(sv_q)

                BANCS.INPARAM.BINDVARS = CUST.CPCM.preferentialLevel +"|"+ BANCS.STDIN.contextBankId
