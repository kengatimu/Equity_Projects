                        CUST.CPCM.value2 = BANCS.OUTPARAM.value2
                        print(CUST.CPCM.value2)
                        CUST.CPCM.maxamt = BANCS.OUTPARAM.maxamt 
                        print(CUST.CPCM.maxamt )
                        CUST.CPCM.minamt = BANCS.OUTPARAM.minamt 
                        print(CUST.CPCM.minamt)

                #}
                ENDIF

	#---------------------------------------------
	#	Checking mandatory fields
	#---------------------------------------------
	
	#---------------------------------------------
	#	Fetching account details
	#---------------------------------------------

	IF(CUST.CPCM.preferentialLevel == "A") THEN
        #{	
		sv_q = "acid,acctSolId|SELECT ACID,SOL_ID FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR"
		PRINT(sv_q)

		BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_u = urhk_dbSelectWithBind(sv_q)
		PRINT(sv_u)

		IF(sv_u == "0") THEN
		#{
			CUST.CPCM.acid = BANCS.OUTPARAM.acid
			PRINT(CUST.CPCM.acid)

			CUST.CPCM.acctSolId = BANCS.OUTPARAM.acctSolId
			PRINT(CUST.CPCM.acctSolId)
		#}
		ENDIF

	#---------------------------------------------
	#	Fetching table counts
	#---------------------------------------------

		sv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_DATA WHERE FORACID = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR"
		PRINT(sv_q)

		BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_u = urhk_dbSelectWithBind(sv_q)
		PRINT(sv_u)

		IF(sv_u == "0") THEN
		#{
			CUST.CPCM.mainTableCount = BANCS.OUTPARAM.mainTableCount
			PRINT(CUST.CPCM.mainTableCount)
		#}
		ENDIF

		sv_q = "modTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_MOD WHERE FORACID = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR"
		PRINT(sv_q)

		BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_u = urhk_dbSelectWithBind(sv_q)
		PRINT(sv_u)

		IF(sv_u == "0") THEN
		#{
			CUST.CPCM.modTableCount = BANCS.OUTPARAM.modTableCount
			PRINT(CUST.CPCM.modTableCount)
		#}
		ENDIF

	#-------------------------
	#	A - Add Function
	#------------------------
	
		IF(CUST.CPCM.funcCode == "A") THEN
		#{

			IF(CDOUBLE(CUST.CPCM.mainTableCount) > 0) THEN	
			#{
				CUST.CPCM.error      = "Record already exists."
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF

			IF(CDOUBLE(CUST.CPCM.modTableCount) > 0) THEN	
			#{
				CUST.CPCM.error      = "Record already exists and pending verification."
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF

#---------validate min max amount
		if((CUST.CPCM.maxamt !="") and (CUST.CPCM.minamt !="")) then
			#{		
			if(cdouble(CUST.CPCM.maxamt) < cdouble(CUST.CPCM.minamt)) then
			#{
				CUST.CPCM.error      = "Minimum charge amount cannot be greater than maximum charge"
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			endif
			#}
		endif

#----
			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctSolId  +"|"+ CUST.CPCM.acctId +"|"+ CUST.CPCM.acid +"|"+ CUST.CPCM.funcCode
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.preferentialLevel +"|"+ CUST.CPCM.evtType
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.evtId +"|"+ CUST.CPCM.startDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.endDate +"|"+ CUST.CPCM.percent +"|"+CUST.CPCM.value1+"|"+CUST.CPCM.value2 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ 'N'+ "|" +'N'+ "|" +BANCS.STDIN.userId+ "|" +BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +BANCS.STDIN.contextBankId+ "|" +CUST.CPCM.maxamt+ "|" +CUST.CPCM.minamt


			PRINT(BANCS.INPARAM.BINDVARS)

			sv_q = "INSERT INTO CUSTOM.C_CPCM_MOD (SOL_ID,FORACID,ACID,FUNCTION,PREFERENTIAL_LEVEL,EVENT_TYPE,EVENT_ID,"
			sv_q = sv_q + " START_DATE,END_DATE,PERCENT,PERCENT_VALUE,AMT_VALUE,ENTITY_CRE_FLG,DEL_FLG,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,max_amt,min_amt)"
			sv_q = sv_q + " VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
			sv_q = sv_q + " TO_DATE(?SVAR,'DD-MM-YYYY'),TO_DATE(?SVAR,'DD-MM-YYYY'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(sysdate,'dd-mm-yyyy'),?SVAR,"
			sv_q = sv_q + " to_date(sysdate,'dd-mm-yyyy'),?SVAR,?SVAR,?SVAR)"
			PRINT(sv_q)
			
			sv_r = urhk_dbSQLWithBind(sv_q)
			PRINT(sv_r)

			IF(sv_r == "0") THEN
			#{
				sv_r = urhk_dbSQLWithBind("COMMIT")
				PRINT(sv_r)

				CUST.CPCM.messageField = "Record Added Successfully for Account Id " + CUST.CPCM.acctId + ",Please Verify"
				CUST.CPCM.SuccessOrFailure="Y"
				GOTO sentMessage	
			#}
			ELSE
			#{
				CUST.CPCM.error      = "Technical Error! Please contact administrator"
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF
		#}
		ENDIF
		
		#-------------------------
		#	M - Modify Function
		#------------------------
		
		IF(CUST.CPCM.funcCode == "M") THEN
		#{
			IF(CDOUBLE(CUST.CPCM.mainTableCount) == 0) THEN	
			#{
				CUST.CPCM.error      = "Record does not exists."
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF

			IF(CDOUBLE(CUST.CPCM.modTableCount) > 0) THEN	
			#{
				CUST.CPCM.error      = "Verification is pending"
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF

		if((CUST.CPCM.maxamt !="") and (CUST.CPCM.minamt !="")) then
			#{		
			if(cdouble(CUST.CPCM.maxamt) < cdouble(CUST.CPCM.minamt)) then
			#{
				CUST.CPCM.error      = "Minimum charge amount cannot be greater than maximum charge"
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			endif
			#}
		endif

			
			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctSolId  +"|"+ CUST.CPCM.acctId +"|"+ CUST.CPCM.acid +"|"+ CUST.CPCM.funcCode
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.preferentialLevel +"|"+ CUST.CPCM.evtType
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.evtId +"|"+ CUST.CPCM.startDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.endDate +"|"+ CUST.CPCM.percent +"|"+CUST.CPCM.value1+"|"+CUST.CPCM.value2
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ 'N'+ "|" +'N'+ "|" +BANCS.STDIN.userId+ "|" +BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +BANCS.STDIN.contextBankId+ "|" +CUST.CPCM.maxamt+ "|" +CUST.CPCM.minamt
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_q = "INSERT INTO CUSTOM.C_CPCM_MOD (SOL_ID,FORACID,ACID,FUNCTION,PREFERENTIAL_LEVEL,EVENT_TYPE,EVENT_ID,"
			sv_q = sv_q + " START_DATE,END_DATE,PERCENT,PERCENT_VALUE,AMT_VALUE,ENTITY_CRE_FLG,DEL_FLG,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,max_amt,min_amt)"
			sv_q = sv_q + " VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
			sv_q = sv_q + " TO_DATE(?SVAR,'DD-MM-YYYY'),TO_DATE(?SVAR,'DD-MM-YYYY'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(sysdate,'dd-mm-yyyy'),?SVAR,"
			sv_q = sv_q + " to_date(sysdate,'dd-mm-yyyy'),?SVAR,?SVAR,?SVAR)"
			PRINT(sv_q)
			
			sv_r = urhk_dbSQLWithBind(sv_q)
			PRINT(sv_r)

			IF(sv_r == "0") THEN
			#{
				sv_r = urhk_dbSQLWithBind("COMMIT")
				PRINT(sv_r)

				CUST.CPCM.messageField = "Record modified Successfully for Account Id " + CUST.CPCM.acctId + ",Please Verify"
				CUST.CPCM.SuccessOrFailure="Y"
				GOTO sentMessage
			#}
			ELSE
			#{
				CUST.CPCM.error      = "Technical Error! Please contact administrator"
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF
		#}
		ENDIF
		
		#-------------------------
		#	V - Verify Function
		#------------------------
		
		IF(CUST.CPCM.funcCode == "V") THEN
		#{
			IF(CDOUBLE(CUST.CPCM.modTableCount) == 0) THEN
			#{
				CUST.CPCM.error      = "There is nothing to verify or cancel."
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF

			sv_s = " DELETE FROM CUSTOM.C_CPCM_DATA WHERE FORACID = ?SVAR AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR"
			PRINT(sv_s)

			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId+"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_r = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_r)


			BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ CUST.CPCM.acctId+"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_s = ""
			sv_s = sv_s + " INSERT INTO CUSTOM.C_CPCM_DATA (SOL_ID,FORACID,ACID,FUNCTION,PREFERENTIAL_LEVEL,EVENT_TYPE,EVENT_ID,START_DATE,"
			sv_s = sv_s + " END_DATE,PERCENT,PERCENT_VALUE,AMT_VALUE,ENTITY_CRE_FLG,DEL_FLG,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,MIN_AMT,MAX_AMT)"
			sv_s = sv_s + " SELECT SOL_ID,FORACID,ACID,FUNCTION,PREFERENTIAL_LEVEL,EVENT_TYPE,EVENT_ID,START_DATE, "
			sv_s = sv_s + " END_DATE,PERCENT,PERCENT_VALUE,AMT_VALUE,'Y' ENTITY_CRE_FLG, DEL_FLG, RCRE_USER_ID, "
			sv_s = sv_s + " RCRE_TIME,?SVAR LCHG_USER_ID,LCHG_TIME,BANK_ID,MIN_AMT,MAX_AMT from CUSTOM.C_CPCM_MOD "
			sv_s = sv_s + " where FORACID = ?SVAR AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR"
			PRINT(sv_s)

			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)

			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId+"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_s = " DELETE FROM CUSTOM.C_CPCM_MOD WHERE FORACID = ?SVAR AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR"
			PRINT(sv_s)

			sv_r = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_r)

			CUST.CPCM.messageField = "Record verified Successfully for Account Id " + CUST.CPCM.acctId
			CUST.CPCM.SuccessOrFailure="Y"
			GOTO sentMessage	
		#}
		ENDIF

		#-------------------------
		#	X - Cancel Function
		#------------------------
		
		IF(CUST.CPCM.funcCode == "X") THEN
		#{
			IF(CDOUBLE(CUST.CPCM.modTableCount) == 0) THEN	
			#{
				CUST.CPCM.error      = "There is nothing to verify or cancel."
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF
		
			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = " DELETE FROM CUSTOM.C_CPCM_MOD WHERE FORACID = ?SVAR AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR"
			PRINT(sv_q)
			
			sv_r = urhk_dbSQLWithBind(sv_q)
			PRINT(sv_r)

			IF(sv_r == "0") THEN
			#{
				sv_r = urhk_dbSQLWithBind("COMMIT")
				PRINT(sv_r)

				CUST.CPCM.messageField = "Record cancelled Successfully for Account Id " + CUST.CPCM.acctId + "."
				CUST.CPCM.SuccessOrFailure="Y"
                                GOTO sentMessage	
			#}
			ELSE
			#{
				CUST.CPCM.error      = "Technical Error! Please contact administrator"
				CUST.CPCM.errorFocus = "dummy"
				GOTO ERROR
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF

	IF(CUST.CPCM.preferentialLevel == "C") THEN
        #{
	
	#---------------------------------------------
        #       Fetching table counts
        #---------------------------------------------

                sv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_DATA WHERE CUST_ID = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR"
                PRINT(sv_q)

                BANCS.INPARAM.BINDVARS = CUST.CPCM.custId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

                sv_u = urhk_dbSelectWithBind(sv_q)
                PRINT(sv_u)

                IF(sv_u == "0") THEN
                #{
                        CUST.CPCM.mainTableCount = BANCS.OUTPARAM.mainTableCount
                        PRINT(CUST.CPCM.mainTableCount)
