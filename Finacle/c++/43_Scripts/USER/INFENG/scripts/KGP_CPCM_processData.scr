if((CUST.CPCM.percent =="A") and ((CUST.CPCM.funcCode=="M") or (CUST.CPCM.funcCode=="A"))) then
	print("here")
	CUST.CPCM.maxamt=CUST.CPCM.value1
	CUST.CPCM.minamt=CUST.CPCM.value1
