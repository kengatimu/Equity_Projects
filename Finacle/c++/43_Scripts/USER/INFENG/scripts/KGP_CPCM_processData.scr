        ENDIF	
	#--------------------------------------------------------------------
	#	Setting success or error message
	#--------------------------------------------------------------------
	
ERROR:
        sv_x=urhk_SetOrbOut("Error_0|Error^" + CUST.CPCM.error  + "^" +CUST.CPCM.errorFocus)
        sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
        EXITSCRIPT

Success:
        sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
        EXITSCRIPT

sentMessage:

        sv_z   =   urhk_SetOrbOut("SuccessOrFailure|Y")
        sv_z   =   urhk_SetOrbOut("RESULT_MSG| "+ CUST.CPCM.messageField)
        GOTO ENDOFSCRIPT
	
ENDOFSCRIPT:
