                        sv_s = sv_s + " END_DATE,PERCENT,PERCENT_VALUE,AMT_VALUE,ENTITY_CRE_FLG,DEL_FLG,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,max_amt,min_amt)"
                        sv_s = sv_s + " SELECT FUNCTION,PREFERENTIAL_LEVEL,EVENT_TYPE,EVENT_ID,START_DATE, "
                        sv_s = sv_s + " END_DATE,PERCENT,PERCENT_VALUE,AMT_VALUE,'Y' ENTITY_CRE_FLG, DEL_FLG, RCRE_USER_ID, "
                        sv_s = sv_s + " RCRE_TIME,?SVAR LCHG_USER_ID,LCHG_TIME,BANK_ID,max_amt,min_amt from CUSTOM.C_CPCM_MOD "
                        sv_s = sv_s + " where PREFERENTIAL_LEVEL = ?SVAR AND BANK_ID = ?SVAR"
                        PRINT(sv_s)

                        sv_d = urhk_dbSqlWithBind(sv_s)
                        PRINT(sv_d)

			BANCS.INPARAM.BINDVARS = CUST.CPCM.preferentialLevel+"|"+ BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)

                        sv_s = " DELETE FROM CUSTOM.C_CPCM_MOD WHERE PREFERENTIAL_LEVEL = ?SVAR AND BANK_ID = ?SVAR"
