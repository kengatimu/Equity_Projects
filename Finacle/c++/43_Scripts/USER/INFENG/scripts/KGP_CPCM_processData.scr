                        ENDIF

                        BANCS.INPARAM.BINDVARS = CUST.CPCM.funcCode
                        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.preferentialLevel +"|"+ CUST.CPCM.evtType
                        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.evtId +"|"+ CUST.CPCM.startDate
                        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CPCM.endDate +"|"+ CUST.CPCM.percent +"|"+CUST.CPCM.value1+"|"+CUST.CPCM.value2
                        BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ 'N'+ "|" +'N'+ "|" +BANCS.STDIN.userId+ "|" +BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +BANCS.STDIN.contextBankId+ "|" +CUST.CPCM.maxamt+ "|" +CUST.CPCM.minamt
                        PRINT(BANCS.INPARAM.BINDVARS)

                        sv_q = "INSERT INTO CUSTOM.C_CPCM_MOD (FUNCTION,PREFERENTIAL_LEVEL,EVENT_TYPE,EVENT_ID,"
                        sv_q = sv_q + " START_DATE,END_DATE,PERCENT,PERCENT_VALUE,AMT_VALUE,ENTITY_CRE_FLG,DEL_FLG,RCRE_USER_ID,RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,max_amt,min_amt)"
                        sv_q = sv_q + " VALUES(?SVAR,?SVAR,?SVAR,?SVAR,"
                        sv_q = sv_q + " TO_DATE(?SVAR,'DD-MM-YYYY'),TO_DATE(?SVAR,'DD-MM-YYYY'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(sysdate,'dd-mm-yyyy'),?SVAR,"
			sv_q = sv_q + " to_date(sysdate,'dd-mm-yyyy'),?SVAR,?SVAR,?SVAR)"
                        PRINT(sv_q)

                        sv_r = urhk_dbSQLWithBind(sv_q)
                        PRINT(sv_r)

			IF(sv_r == "0") THEN
                        #{
                                sv_r = urhk_dbSQLWithBind("COMMIT")
                                PRINT(sv_r)

                                CUST.CPCM.messageField = "Record modified Successfully, Please Verify"
                                CUST.CPCM.SuccessOrFailure="Y"
                                GOTO sentMessage
