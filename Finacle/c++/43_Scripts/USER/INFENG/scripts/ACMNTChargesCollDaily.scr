####			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
####			print(sv_r)
####
####			IF(fieldexists(MTT.Error.Description)) THEN
####				print(MTT.Error.Description)
####				CUST.WITH.MTTErrDesc = MTT.Error.Description
####			ENDIF
####
####			MTT.PartTranDetails.Account     = CUST.WITH.INCOM
####			MTT.PartTranDetails.RefCurrency = CUST.WITH.CHARGE_CCY
####			MTT.PartTranDetails.RateCode    ="TTB"
####			MTT.PartTranDetails.Rate        = "0"
####			MTT.PartTranDetails.ValueDateDiff = "0"
####			MTT.PartTranDetails.Particulars = "COMM " + CUST.WITH.Narration 
####			MTT.PartTranDetails.RefAmount = (cdouble(CUST.WITH.CHARGE_AMOUNT))
####			print(MTT.PartTranDetails.RefAmount)
####			MTT.PartTranDetails.Remarks = CUST.WITH.foracid
####			MTT.PartTranDetails.IgnoreExcp = "I"
####			MTT.PartTranDetails.Consolidate = "N"
####			MTT.PartTranDetails.TranIdentifier = sv_v
####			sv_r = urhk_MTTS_DefinePartTran("WITHIncome")
####			print(sv_r)
####
####			IF(fieldexists(MTT.Error.Description)) THEN
####				print(MTT.Error.Description)
####				CUST.WITH.MTTErrDesc = MTT.Error.Description
####
####			ENDIF
####
####			sv_r = urhk_MTTS_EndDefinition("")
####			print(sv_r)
			#####################################
			##### Start VAT_charges
			CUST.WITH.TranId=""
			CUST.WITH.trnparticulars= "VAT " + CUST.WITH.Narration 
			print(CUST.WITH.trnparticulars)
			CUST.WITH.VAT_AMT=CUST.WITH.VAT_AMT +"|" +  CUST.WITH.acctcrncy
			print(CUST.WITH.VAT_AMT)
			CUST.WITH.amount1="0.00|" +  CUST.WITH.acctcrncy
			print(CUST.WITH.amount1)
			sv_s = "srlnum|select to_char(to_date('" + BANCS.STDIN.BODDate + "','DD-MM-YYYY HH24:MI:SS') + 10000 , 'DD-MM-RRRR') from dual"
			sv_s = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_s)
			
			IF (sv_s==0) THEN
			#{
				CUST.WITH.date=BANCS.OUTPARAM.srlnum
				PRINT(CUST.WITH.date)
				sv_k =" 00:00:00"
				CUST.WITH.date =CUST.WITH.date + sv_k
				PRINT(CUST.WITH.date)
			#}
			ENDIF

			### check lien for duplicate VAT
			CUST.WITH.checklienflg="Y"
			print(CUST.WITH.checklienflg)
			CUST.WITH.lienreasoncode="CHRGL"
			print(CUST.WITH.lienreasoncode)
			##check alt
			sv_s = "lienid|"
			sv_s = sv_s + " select   TRIM(max(B2K_ID)) from tbaadm.alt l ,tbaadm.gam g  where  l.acid=g.acid  AND l.bank_id=g.bank_id AND g.bank_id=?SVAR "
			sv_s = sv_s + " AND l.LIEN_REASON_CODE=?SVAR AND g.foracid =?SVAR AND l.LIEN_REMARKS=?SVAR  "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.WITH.lienreasoncode + "|" + CUST.WITH.foracid + "|" +  CUST.WITH.trnparticulars 
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d =  urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				CUST.WITH.TranIdlienid=BANCS.OUTPARAM.lienid
				print(CUST.WITH.TranIdlienid)
				CUST.WITH.checklienflg="N"
				print(CUST.WITH.checklienflg)
				CUST.WITH.TranId=""
				print(CUST.WITH.TranId)
			#}
			ENDIF
			##check alh
			sv_s = "lienid|"
			sv_s = sv_s + " select   TRIM(max(B2K_ID)) from tbaadm.alh l ,tbaadm.gam g  where  l.acid=g.acid  AND l.bank_id=g.bank_id AND g.bank_id=?SVAR "
			sv_s = sv_s + " AND l.LIEN_REASON_CODE=?SVAR AND g.foracid =?SVAR AND l.LIEN_REMARKS=?SVAR and l.RCRE_TIME >(select sysdate-30 from dual)  "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.WITH.lienreasoncode + "|" + CUST.WITH.foracid + "|" +  CUST.WITH.trnparticulars 
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d =  urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF (sv_d == 0) THEN
			#{
				CUST.WITH.TranIdlienidalh=BANCS.OUTPARAM.lienid
				print(CUST.WITH.TranIdlienidalh)
				CUST.WITH.checklienflg="N"
				print(CUST.WITH.checklienflg)
				CUST.WITH.TranId=""
				print(CUST.WITH.TranId)
			#}
			ENDIF
			print(CUST.WITH.checklienflg)
			IF (CUST.WITH.checklienflg=="Y") THEN
				#--------------------------------------------------------------------------------------------------------------
				# Inputs for Account lien services
				# urhk_SetUrhkInp is used to set inputs
				#--------------------------------------------------------------------------------------------------------------
				print(CUST.WITH.foracid)
				print(CUST.WITH.VAT_AMT)
				print( CUST.WITH.acctcrncy)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.WITH.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" +  CUST.WITH.acctcrncy)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.WITH.VAT_AMT)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUST.WITH.amount1)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUST.WITH.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUST.WITH.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|CHRGL")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.WITH.VatCrAcctId)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.WITH.trnparticulars)
				
				sv_u = urhk_ExecSrv("SRV_AddLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				
				IF (sv_u==0) THEN
				#{
					PRINT(CUST.WITH.foracid)
					PRINT(BANCS.STDIN.contextBankId)
					CUST.WITH.lienreasoncode="CHRGL"
					print(CUST.WITH.lienreasoncode)
					sv_s = "lienid|"
					sv_s = sv_s + " select   TRIM(max(B2K_ID)) from tbaadm.alt l ,tbaadm.gam g  where  l.acid=g.acid  AND l.bank_id=g.bank_id AND g.bank_id=?SVAR "
					sv_s = sv_s + " AND l.LIEN_REASON_CODE=?SVAR AND g.foracid =?SVAR AND l.LIEN_REMARKS=?SVAR AND l.RCRE_USER_ID=?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.WITH.lienreasoncode + "|" + CUST.WITH.foracid + "|" +  CUST.WITH.trnparticulars + "|"+ BANCS.STDIN.userId
					PRINT(BANCS.INPARAM.BINDVARS)
