                                PRINT(sv_d)
                                IF(sv_d ==0) THEN
                                #{
                                        CUST.CIETXN.rateCode = BANCS.OUTPARAM.rateCode
                                        PRINT(CUST.CIETXN.rateCode)
                                #}
				ENDIF


			IF((CUST.CIETXN.refCrncy != "") AND (CUST.CIETXN.rateCode != ""))THEN
			#{
				#IF(CUST.CIETXN.refCrncy == CUST.CIETXN.ieTxnRefCrncy)THEN
				IF(CUST.CIETXN.refCrncy == CUST.CIETXN.tranCrncy)THEN
				#{
					CUST.CIETXN.refAmt = CUST.CIETXN.ieTxnRefAmt
					CUST.CIETXN.refCrncy = CUST.CIETXN.ieTxnRefCrncy
					CUST.CIETXN.rate = "1.00"
					CUST.CIETXN.treaRate = "0.00"
					CUST.CIETXN.rateCode = " "
					#}
				ELSE
					#{
					###########################################################################################
					# Get Rate From SRV
					###########################################################################################
					
					#sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.CIETXN.ieTxnRefCrncy)
					sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.CIETXN.tranCrncy)
					sv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.CIETXN.refCrncy)
					sv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.CIETXN.rateCode)
					sv_u = urhk_SetUrhkInp("fromAmt|"+CUST.CIETXN.tranAmt+"|"+CUST.CIETXN.tranCrncy)
					
					IF(CUST.CIETXN.rate != "")THEN
					#{
						sv_u = urhk_SetUrhkInp("rate|"+CUST.CIETXN.rate)
					#}
					ENDIF
					
					IF(CUST.CIETXN.treaRate != "")THEN
					#{
						sv_u = urhk_SetUrhkInp("treaRate|"+CUST.CIETXN.treaRate)
					#}
					ENDIF
					
					sv_u = urhk_SetUrhkOut("rate|rate")
					sv_u = urhk_SetUrhkOut("treaRate|treaRate")
					sv_u = urhk_SetUrhkOut("toAmt|toAmt")
					
					sv_u = urhk_ExecSrvNoCommit("SRV_TieredConvCrncy")
					PRINT(sv_u)
					
					IF(sv_u == 0)THEN
					#{
						CUST.CIETXN.rate = BANCS.OUTPARAM.rate
						PRINT(CUST.CIETXN.rate)
						
						CUST.CIETXN.treaRate = BANCS.OUTPARAM.treaRate
						PRINT(CUST.CIETXN.treaRate)
						
						CUST.CIETXN.toAmt = BANCS.OUTPARAM.toAmt
						PRINT(CUST.CIETXN.toAmt)
						
						sv_p = GETPOSITION(CUST.CIETXN.toAmt,"|")
						PRINT(sv_p)
						
						IF(sv_p > 0)THEN
						#{
							CUST.CIETXN.refAmt = MID$(CUST.CIETXN.toAmt,0,sv_p-1)
							PRINT(CUST.CIETXN.refAmt)
							CUST.CIETXN.refCrncy = MID$(CUST.CIETXN.toAmt,sv_p,3)
							PRINT(CUST.CIETXN.refCrncy)
						#}
						ENDIF
						
						#}
					ELSE
						#{
						PRINT(BANCS.OUTPARAM.Fatal_num)
						PRINT(BANCS.OUTPARAM.Error_num)
						PRINT(BANCS.OUTPARAM.Warning_num)
						PRINT(BANCS.OUTPARAM.UserInfo_num)
						PRINT(BANCS.OUTPARAM.Xcpn_num)
						PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
						PRINT(BANCS.OUTPARAM.Xcpn_Xcpn_num)
						PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
						
						sv_d = 1
						sv_j = 1
						sv_c = CINT(BANCS.OUTPARAM.Error_num)
						WHILE (sv_d <= sv_c)
						#{
							sv_f = FORMAT$(sv_d,"%d")
							sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
							PRINT(sv_b)
							sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							PRINT(sv_e)
							sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
							PRINT(sv_a)
							sv_d = sv_d + 1
							sv_j = sv_j + 1
							sv_d = sv_c + 1
						#}
						DO
						CUST.CIETXN.errorFlg = "Y"
						CUST.CIETXN.errorMsg = sv_b
						CUST.CIETXN.rate = " "
						GOTO OUTPUT
						
					#}
					ENDIF
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.CIETXN.refAmt = CUST.CIETXN.ieTxnRefAmt

					IF(TRIM(CUST.CIETXN.refAmt) != "")THEN
						IF(BANCS.STDIN.contextBankId == "43")THEN
							sv_t = "0"
							sv_t = GETPOSITION(CUST.CIETXN.refAmt,".")
							IF(sv_t > 0)THEN
								BANCS.INPARAM.BINDVARS = CUST.CIETXN.refAmt
								sv_z = "refAmt |SELECT  replace (replace ( replace (Trim( to_char(?SVAR, '999,999,999,999,999.99')),'.','X'),',','.'),'X',',') from dual "
								print(sv_z)
								sv_q = urhk_dbSelectWithBind(sv_z)
								print(sv_q)
								IF(sv_q ==0) THEN
									CUST.CIETXN.refAmt  = BANCS.OUTPARAM.refAmt
									print(CUST.CIETXN.refAmt)
								ENDIF
							ENDIF
						ENDIF
					ENDIF


				CUST.CIETXN.refCrncy = CUST.CIETXN.ieTxnRefCrncy
				CUST.CIETXN.rate = "1,00"
				CUST.CIETXN.treaRate = "0,00"
				CUST.CIETXN.rateCode = " "
			#}
			ENDIF
			
			####################################################################
			# Find the Nostro Account Number
			####################################################################
			
			CUST.CIETXN.targetEntity = MID$(CUST.CIETXN.refNum,0,2)
			PRINT(CUST.CIETXN.targetEntity)
			
			CUST.CIETXN.nostroAcct = ""
			
			IF(CUST.CIETXN.targetEntity == BANCS.STDIN.contextBankId)THEN
			#{
				CUST.CIETXN.nostroAcct = CUST.CIETXN.ieCrAcctId
				GOTO OUTPUT
			#}
			ENDIF
			
		NOSTRO:
			CUST.CIETXN.parameterId = CUST.CIETXN.txnType + "_NOSTRO_" + CUST.CIETXN.targetEntity
			PRINT(CUST.CIETXN.parameterId)
			
			sv_s = "nostroAcct|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPMASTER M ,CUSTOM.C_CPVALUE V"
			sv_s = sv_s + " WHERE M.MODULE_NAME = V.MODULE_NAME"
			sv_s = sv_s + " AND M.MODULE_NAME = 'IETX'"
			sv_s = sv_s + " AND M.BANK_ID = V.BANK_ID"
			sv_s = sv_s + " AND M.BANK_ID = ?SVAR"
			sv_s = sv_s + " AND M.PARAMETER_ID = V.PARAMETER_ID"
			sv_s = sv_s + " AND M.PARAMETER_ID = ?SVAR"
			sv_s = sv_s + " AND M.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND M.DEL_FLG != 'Y'"
			sv_s = sv_s + " AND V.ENTITY_CRE_FLG = 'Y'"
			sv_s = sv_s + " AND V.DEL_FLG != 'Y'"
			PRINT(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.CIETXN.parameterId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account"
				CUST.CIETXN.nostroAcct = " "
				GOTO OUTPUT
			#}
			ENDIF
			
			CUST.CIETXN.nostroAcct = BANCS.OUTPARAM.nostroAcct
			PRINT(CUST.CIETXN.nostroAcct)
			
			IF(TRIM(CUST.CIETXN.nostroAcct) == "")THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account"
				CUST.CIETXN.nostroAcct = " "
				GOTO OUTPUT
			#}
			ENDIF
			
			CUST.CIETXN.acctNumSolId = BANCS.STDIN.mySolId
			#CUST.CIETXN.acctNumCcy = CUST.CIETXN.ieTxnRefCrncy
			CUST.CIETXN.acctNumCcy = CUST.CIETXN.tranCrncy
			
			CUST.CIETXN.inputBankId = BANCS.STDIN.contextBankId
			CUST.CIETXN.inputBacid = CUST.CIETXN.nostroAcct
			CUST.CIETXN.inputSolId = CUST.CIETXN.acctNumSolId
			CUST.CIETXN.inputCcy = CUST.CIETXN.acctNumCcy
			CUST.CIETXN.inputBacidOrForacid = CUST.CIETXN.nostroAcct
			
			CALL("cietxndp032.scr")
			
			PRINT(CUST.CIETXN.outputForacid)
			IF(TRIM(CUST.CIETXN.outputForacid) == "")THEN
			#{
				CUST.CIETXN.errorFlg = "Y"
				CUST.CIETXN.errorMsg = CUST.CIETXN.errorMsg + "  " + "Unable to find Nostro/Vostro Account"
				CUST.CIETXN.nostroAcct = " "
				GOTO OUTPUT
			#}
			ENDIF
			
			CUST.CIETXN.nostroAcct = CUST.CIETXN.outputForacid
			CUST.CIETXN.nostroAcctFlg = "Y"
			
			CUST.CIETXN.errorMsg = " _ "
			
			###################################################################################
			
		OUTPUT:
			
			IF(CUST.CIETXN.refNum == "")THEN
			#{
				CUST.CIETXN.refNum = " "
			#}
			ENDIF
			sv_s = "refNum_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.refNum
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			
			IF(CUST.CIETXN.ieTxnRefNo == "")THEN
			#{
				CUST.CIETXN.ieTxnRefNo = " "
			#}
			ENDIF
			sv_s = "ieTxnRefNo_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.ieTxnRefNo
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.tranParticular == "")THEN
			#{
				CUST.CIETXN.tranParticular = " "
			#}
			ENDIF
			sv_s = "tranParticular_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.tranParticular
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.tranRmks == "")THEN
			#{
				CUST.CIETXN.tranRmks = " "
			#}
			ENDIF
			sv_s = "tranRmks_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.tranRmks
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.tranRmks2 == "")THEN
			#{
				CUST.CIETXN.tranRmks2 = " "
			#}
			ENDIF
			sv_s = "tranRmks2_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.tranRmks2
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.nostroAcct == "")THEN
			#{
				CUST.CIETXN.nostroAcct = " "
			#}
			ENDIF
			
			sv_s = "ieTxnAcctId_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.nostroAcct
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.ieTxnRefAmt == "")THEN
			#{
				CUST.CIETXN.ieTxnRefAmt = " "
			#}
			ENDIF
			sv_s = "ieTxnRefAmt_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.ieTxnRefAmt
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.ieTxnRefCrncy == "")THEN
			#{
				CUST.CIETXN.ieTxnRefCrncy = " "
			#}
			ENDIF
			sv_s = "ieTxnRefCrncy_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.ieTxnRefCrncy
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.refAmt == "")THEN
			#{
				CUST.CIETXN.refAmt = " "
			#}
			ENDIF
			sv_s = "refAmt_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.refAmt
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.refCrncy == "")THEN
			#{
				CUST.CIETXN.refCrncy = " "
			#}
			ENDIF
			sv_s = "refCrncy_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.refCrncy
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.rateCode == "")THEN
			#{
				CUST.CIETXN.rateCode = " "
			#}
			ENDIF
			sv_s = "rateCode_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.rateCode
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.rate == "")THEN
			#{
				CUST.CIETXN.rate = " "
			#}
			ENDIF
			sv_s = "rate_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.rate
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.treaRate == "")THEN
			#{
				CUST.CIETXN.treaRate = " "
			#}
			ENDIF
			sv_s = "treaRate_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.treaRate
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			IF(CUST.CIETXN.errorMsg == "")THEN
			#{
				CUST.CIETXN.errorMsg = " "
			#}
			ENDIF
			sv_s = "errorMsg_" + Format$(sv_i,"%d") + "|" + CUST.CIETXN.errorMsg
			PRINT(sv_s)
			sv_u = urhk_SetOrbOut(sv_s)
			PRINT(sv_u)
			
			sv_i = sv_i + 1
			
			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(sv_n)
		PRINT(sv_c)
		
		
	ENDOFSCRIPT:
		
