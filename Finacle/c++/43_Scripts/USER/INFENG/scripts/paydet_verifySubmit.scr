
<--START
	# Script body goes here
	TRACE ON
	BANCS.OUTPARAM.MTTTranId=""
	#call transaction passing script

	sv_r=urhk_B2k_PrintRepos("BANCS")

	sv_u=urhk_B2k_PrintRepos("CUST")

	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF(CLASSEXISTS("CUST","GCHRG")==0) THEN
	#{
		CREATECLASS("CUST","GCHRG",5)
	#}
	ENDIF
	#### Check Maker Checker
	BANCS.INPARAM.BINDVARS = CUST.DATA.Ecstranrefnum+"|"+ CUST.DATA.paysysid+"|"+ CUST.DATA.trantype+"|"+ BANCS.STDIN.contextBankId 
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_a = "count|select count(*) from custom.ECS_TRAN where Ecstranrefnum = ?SVAR AND paysysid = ?SVAR AND trantype=?SVAR"
	sv_a = sv_a + " AND bank_id = ?SVAR AND DEL_FLG = 'N' and bank_id ='43' and entity_cre_flg='N' "
	sv_b = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_b)
	IF (sv_b == 0) THEN
		sv_c = BANCS.OUTPARAM.count
		PRINT(sv_c)
		IF (CINT(sv_c) > 0 ) THEN
			BANCS.INPARAM.BINDVARS = CUST.DATA.Ecstranrefnum+"|"+ CUST.DATA.paysysid+"|"+ CUST.DATA.trantype+"|"+ BANCS.STDIN.contextBankId 
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_a = "countrcre_user_id|select rcre_user_id from custom.ECS_TRAN where Ecstranrefnum = ?SVAR AND paysysid = ?SVAR AND trantype=?SVAR"
			sv_a = sv_a + " AND bank_id = ?SVAR AND DEL_FLG = 'N' and bank_id ='43' and entity_cre_flg='N' and rownum<2 "
			sv_b = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_b)
			IF (sv_b == 0) THEN
				CUST.DATA.countrcre_user_id = BANCS.OUTPARAM.countrcre_user_id
				PRINT(CUST.DATA.countrcre_user_id)
				IF (CUST.DATA.countrcre_user_id==BANCS.STDIN.userId) THEN
					CUST.DATA.errMsg = "Same User Cannot Verify"
					sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
					GOTO ENDOFSCRIPT
				ENDIF
			ENDIF
		ELSE
			CUST.DATA.errMsg = "No Records to Verify"
			sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
			GOTO ENDOFSCRIPT
		ENDIF
	ENDIF
	
	call("paydet_mtt.scr")	

	BANCS.INPUT.MTTTranId=""
	BANCS.INPUT.Trandate=""	
	CUST.GCHRG.paydet_tran_id = "NULL"
	CUST.GCHRG.paydet_tran_date = LEFT$(BANCS.STDIN.BODDate,10)
	CUST.DATA.errMsg =""
	print(CUST.DATA.errMsg)

	IF (FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
	#{
		IF(TRIM(BANCS.OUTPARAM.MTTTranId) != "")THEN
		#{
			BANCS.INPUT.MTTTranId=BANCS.OUTPARAM.MTTTranId
			BANCS.INPUT.Trandate =LEFT$(BANCS.STDIN.BODDate,10)
			print(BANCS.INPUT.Trandate)
			
			CUST.GCHRG.paydet_tran_id = BANCS.OUTPARAM.MTTTranId
			CUST.GCHRG.paydet_tran_date = LEFT$(BANCS.STDIN.BODDate,10)

			#sv_a = "UPDATE CUSTOM.ECS_TRAN SET"
