							#SYSTEM_DATE ,  FORACID,  B2K_ID ,    LIEN_AMT ,  NARRATIONS ,  ERROR_DESC ,  BANK_ID

							BANCS.INPARAM.BINDVARS = sv_y + "|" + CUST.CHRG.FORACID + "|" + CUST.CHRG.B2K_ID + "|" + CUST.CHRG.LIEN_AMT + "|" + CUST.CHRG.LIEN_REMARKS  + "|" + sv_e  + "|" +  BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_j = "insert into CUSTOM.AUTO_LIEN_CHECK values ( ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR)"
							sv_w = urhk_dbSQLWithBind(sv_j)
