				MTT.PartTranDetails.TodExpiryDate   = BANCS.STDIN.BODDate
				MTT.PartTranDetails.TodPenalDate    = BANCS.STDIN.BODDate
				MTT.PartTranDetails.TodPermittedBy  = "SYSTEM"
				MTT.PartTranDetails.TodRemarks      = "LienRecover TOD"
				MTT.PartTranDetails.Consolidate     = "N"
			#}
			endif

			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "Auto_Lien_Coll"
			MTT.PartTranDetails.CarveAmtFlg="Y"
			
			#----------------------------------------------------------------------------------
			# Defining the Debit Part Tran for Charge amount
			#----------------------------------------------------------------------------------
			sv_u = urhk_MTTS_DefinePartTran("Delayed_Chrg_Debit_Tran")
			PRINT(sv_u)
			
			IF (sv_u != 0) THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				CUST.CHRG.ErrorMessage=MTT.Error.Description
				PRINT(CUST.CHRG.ErrorMessage)
				CUST.CHRG.remark = CUST.CHRG.ErrorMessage
				CUST.CHRG.errMsg = CUST.CHRG.FORACID+ "|"+CUST.CHRG.remark
				PRINT(CUST.CHRG.errMsg)
				GOTO NEXTACID
			ENDIF
				
			
			######################################
			# Credit part tran for charge
			######################################
			MTT.PartTranDetails.Account=CUST.CHRG.chrgAcnt
			MTT.PartTranDetails.RefAmount= CDOUBLE(CUST.CHRG.collChargeAmt)
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Particulars = CUST.CHRG.LIEN_REMARKS 
			MTT.PartTranDetails.Remarks =  "LienAutoCollection"
			MTT.PartTranDetails.Particulars2 = MID$(CUST.CHRG.FORACIDNAME,0,50)
