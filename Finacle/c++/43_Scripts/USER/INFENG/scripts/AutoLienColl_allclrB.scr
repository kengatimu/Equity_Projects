				MTT.PartTranDetails.RateCode= CUST.CHRG.rateCode
				MTT.PartTranDetails.Rate = CUST.CHRG.rate
			ENDIF
			MTT.PartTranDetails.RefAmount = -cdouble(CUST.CHRG.debitAmt)
			PRINT(MTT.PartTranDetails.RefAmount)
			print(cdouble(CUST.CHRG.effavlamt))
			if (cdouble(CUST.CHRG.effavlamt) < cdouble(CUST.CHRG.debitAmt)) then
			#{
				MTT.PartTranDetails.TODRefType          = "IN"
				MTT.PartTranDetails.TodEntityType   = "TODIN"
				print(CUST.CHRG.FORACID)
				MTT.PartTranDetails.TodEntityId     = CUST.CHRG.FORACID
