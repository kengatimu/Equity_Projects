	sv_s = sv_s + " from tbaadm.alt , tbaadm.gam A, tbaadm.smt  where alt.bank_id = ?SVAR  and A.acid =alt.acid and A.acid =smt.acid and A.bank_id =smt.bank_id and A.bank_id =alt.bank_id  "
	sv_s = sv_s + " and A.acid =alt.acid and A.acid =smt.acid  and A.bank_id =smt.bank_id  and A.bank_id =alt.bank_id   AND LIEN_REASON_CODE ='CHRGL' and REQUEST_DEPARTMENT  is not  null  "
	sv_s = sv_s + " and Acct_status ='A' and  FREZ_CODE not in ('T','D') and REGEXP_INSTR(REQUEST_DEPARTMENT,'[^[:digit:] ]')  ='0'  " 
	sv_s = sv_s + " and trim(alt.REQUEST_DEPARTMENT) in (select foracid from tbaadm.gam where bank_id='43' and acct_ownership='O' and schm_code in  ('INCBC','INCOM') and acct_cls_flg='N')   "
