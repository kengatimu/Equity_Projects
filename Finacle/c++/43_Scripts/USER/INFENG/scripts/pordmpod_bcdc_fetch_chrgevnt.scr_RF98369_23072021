<--START
TRACE ON
	
	IF (REPEXISTS("CUST") == 0 ) THEN	
		CREATEREP("CUST")	
	ENDIF

	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
		CREATECLASS("CUST","DATA",5)
	ENDIF

	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)

	CUST.DATA.errFlg = "N"
	CUST.DATA.errMsg = " "
	CUST.DATA.paysysId = " "
	CUST.DATA.eventid= " "
	CUST.DATA.ConvAmount =0

	IF(FIELDEXISTS(BANCS.INPUT.remitCrncy))THEN
		IF(BANCS.INPUT.remitCrncy !="")THEN

			CUST.DATA.remitCrncy = TOUPPER(TRIM(BANCS.INPUT.remitCrncy))
			PRINT(CUST.DATA.remitCrncy)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Remittance Currency Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Remittance Currency Not Entered"
		GOTO ENDOFSCRIPT

	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.remitAmt))THEN
		IF(BANCS.INPUT.remitAmt !="")THEN
			CUST.DATA.remitAmt = TOUPPER(TRIM(BANCS.INPUT.remitAmt))
			PRINT(CUST.DATA.remitAmt)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Remittance Amount Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Remittance Amount Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.paysysId))THEN
		IF(BANCS.INPUT.paysysId !="")THEN

			CUST.DATA.paysysId = TOUPPER(TRIM(BANCS.INPUT.paysysId))
			PRINT(CUST.DATA.paysysId)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Remittance Amount Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Remittance Amount Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF

	IF(CUST.DATA.remitCrncy == "ZAR")THEN
	#{
		IF(TOUPPER(CUST.DATA.paysysId) != "SWIFT")THEN
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "For Remittance Currency "+CUST.DATA.remitCrncy+" Payment Method should be SWIFT"
			GOTO ENDOFSCRIPT

		ELSE
			CUST.DATA.errFlg = "N"
			CUST.DATA.errMsg = " "


		ENDIF
	ENDIF
			
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.drAccount)
		PRINT(sv_u)

		IF(sv_u == 0)THEN
			CUST.DATA.avblAmt = BANCS.OUTPARAM.EffAvailableAmt
			CUST.DATA.custId = BANCS.OUTPARAM.custId
			CUST.DATA.acctSolId= BANCS.OUTPARAM.acctSolId
			CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
			print(CUST.DATA.custId)
			print(CUST.DATA.acctSolId)


			sv_d = "isBCDC | select count(*) from tbaadm.sst where bank_id=?SVAR and set_id='BCDC' and sol_id=?SVAR "
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.acctSolId
			print(BANCS.INPARAM.BINDVARS)
			print(sv_d)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
			CUST.DATA.isBCDC = BANCS.OUTPARAM.isBCDC
			print (CUST.DATA.isBCDC)
			endif

			IF ((CUST.DATA.schmCode =="CA205") OR(CUST.DATA.schmCode =="CA213") OR (CUST.DATA.schmCode =="CA266") OR (CUST.DATA.schmCode =="CA268") OR (CUST.DATA.schmCode =="CA209") OR (CUST.DATA.schmCode =="CA217") OR (CUST.DATA.schmCode =="CA215") OR (CUST.DATA.schmCode =="CA265") OR (CUST.DATA.schmCode =="CA214") OR (CUST.DATA.schmCode =="CA264") OR (CUST.DATA.schmCode =="CA257") OR (CUST.DATA.schmCode =="CA212") OR (CUST.DATA.schmCode =="CA258") OR (CUST.DATA.schmCode =="SB102") OR (CUST.DATA.schmCode =="SB105") OR (CUST.DATA.schmCode =="SB139") OR (CUST.DATA.schmCode =="CA200")) THEN
				CUST.DATA.isBCDC ="0"
			ENDIF
			
			IF (CUST.DATA.schmCode =="SB722") THEN
				CUST.DATA.isBCDC ="1"
			ENDIF


		ELSE
			CUST.DATA.custId=""
			CUST.DATA.acctSolId=""
		ENDIF





	#IF(MID$(CUST.DATA.acctSolId,0,3) == "150" ) THEN

	IF (cdouble(CUST.DATA.isBCDC)>=1) THEN

		sv_s =" CORP_ID | select corp_id from tbaadm.cmg where  bank_id='"+BANCS.STDIN.contextBankId+"' and cust_id='"+CUST.DATA.custId+"' and rownum=1"
		print(sv_s)
		sv_u = urhk_dbselectwithBind(sv_s)
		print(sv_u)
		IF (sv_u == 0) THEN		
			BANCS.INPUT.CORP_ID=BANCS.OUTPARAM.CORP_ID

			IF(BANCS.INPUT.CORP_ID != "") THEN
				BANCS.INPUT.RETCORP="CORP"
			ELSE
				BANCS.INPUT.RETCORP="RET"
			ENDIF
		ELSE
			BANCS.INPUT.RETCORP="NIL"
		ENDIF

		CUST.DATA.corpret=BANCS.INPUT.RETCORP
		print(CUST.DATA.corpret)


		IF(CUST.DATA.corpret =="NIL") THEN
			CUST.DATA.eventid="BCDC_OFFICE_ACCT"
		ENDIF

		#convert amount to USD

		IF(BANCS.INPUT.remitCrncy !="USD") THEN
			BANCS.INPARAM.InputAmount = BANCS.INPUT.remitAmt
			BANCS.INPARAM.FromCurrency = BANCS.INPUT.remitCrncy
			BANCS.INPARAM.ToCurrency = "USD"
			BANCS.INPARAM.RateCode = "TTS"
			BANCS.INPARAM.Rate=0
			sv_r = urhk_B2k_ConvertAmount("")
			CUST.DATA.ConvAmount =CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		ELSE
			CUST.DATA.ConvAmount =BANCS.INPUT.remitAmt
		ENDIF

		print(CUST.DATA.ConvAmount)

		IF (BANCS.INPUT.paysysId=="SWIFT") THEN	

			IF(BANCS.INPUT.bencntry=="CD") THEN

				IF(CUST.DATA.corpret =="CORP") THEN
					CUST.DATA.eventid="OUTWRDLOCALTRSF-CORPUSD"
				ENDIF

				IF(CUST.DATA.corpret =="RET") THEN			
					CUST.DATA.eventid="OUTWRDLOCALTRSF-RETUSD"		
				ENDIF	
			ELSE
				IF(CUST.DATA.corpret =="CORP") THEN
					CUST.DATA.eventid="BCDC-SWIFTOUTWD-CORPUSD"
				ENDIF
				IF(CUST.DATA.corpret =="RET") THEN
					CUST.DATA.eventid="BCDC-SWIFTOUTWD-RETUSD"
				ENDIF
			ENDIF
		ELSE
			IF(BANCS.INPUT.remitCrncy =="CDF") THEN 
				IF(CUST.DATA.ConvAmount > 25000) THEN

					IF(CUST.DATA.corpret =="CORP") THEN
						CUST.DATA.eventid="BCDC-SWIFTBEN-COP>25000US"
					ENDIF

					IF(CUST.DATA.corpret =="RET") THEN
						CUST.DATA.eventid="BCDC-SWIFTBEN-RET>25000US"
					ENDIF	
				ELSE
					IF(CUST.DATA.corpret =="CORP") THEN
						CUST.DATA.eventid="BCDC-SWIFTBEN-CORP"
					ENDIF

					IF(CUST.DATA.corpret =="RET") THEN
						CUST.DATA.eventid="BCDC-SWIFTBEN-RETAIL"
					ENDIF
				ENDIF
			ELSE
				IF(CUST.DATA.corpret =="CORP") THEN
					CUST.DATA.eventid="OUTWRDLOCALTRSF-CORPUSD"
				ENDIF
				
				IF(CUST.DATA.corpret =="RET") THEN
					CUST.DATA.eventid="OUTWRDLOCALTRSF-RETUSD"
				ENDIF
			ENDIF
		ENDIF

		print(CUST.DATA.eventid)
	ELSE

		IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="OUR") and (BANCS.INPUT.bencntry=="CD")) then
			CUST.DATA.eventid="RTGSOUR"
			print(CUST.DATA.eventid)
		ENDIF

		IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="OUR") and (BANCS.INPUT.bencntry !="CD")) then
			CUST.DATA.eventid="SWIFTOUR"
			print(CUST.DATA.eventid)
		ENDIF

		IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="BEN") and (BANCS.INPUT.bencntry =="CD")) then
			CUST.DATA.eventid="RTGSBEN"
			print(CUST.DATA.eventid)
		ENDIF

		IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="BEN") and (BANCS.INPUT.bencntry !="CD")) then
			CUST.DATA.eventid="SWIFTBEN"
			print(CUST.DATA.eventid)
		ENDIF

		IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="SHA") and (BANCS.INPUT.bencntry =="CD")) then
			CUST.DATA.eventid="RTGSSHR"
			print(CUST.DATA.eventid)
		ENDIF

		IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="SHA") and (BANCS.INPUT.bencntry !="CD")) then
			CUST.DATA.eventid="SWIFTSHR"
			print(CUST.DATA.eventid)
		ENDIF

		IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="SHA") ) then
			CUST.DATA.eventid="SWIFTSHR"
			print(CUST.DATA.eventid)
		ENDIF

		
		IF((BANCS.INPUT.paysysId=="RTGS") and (BANCS.INPUT.chargeOption=="SHA")) then
			CUST.DATA.eventid="RTGSSHR"
			print(CUST.DATA.eventid)
		ENDIF
		IF((BANCS.INPUT.paysysId=="RTGS") and (BANCS.INPUT.chargeOption=="OUR")) then
			CUST.DATA.eventid="RTGSOUR"
			print(CUST.DATA.eventid)
		ENDIF
		
		IF((BANCS.INPUT.paysysId=="RTGS") and (BANCS.INPUT.chargeOption=="BEN") ) then		
			CUST.DATA.eventid="RTGSBEN"
			print(CUST.DATA.eventid)
		ENDIF
	ENDIF

ENDOFSCRIPT:

	IF(BANCS.STDIN.userId !="FIVUSR43") THEN
		sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
		sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
		sv_u = urhk_SetOrbOut("eventid|"+CUST.DATA.eventid)
	ELSE
		print(CUST.DATA.eventid)
	ENDIF

TRACE OFF
END-->
