	#--------------------------------------
	# checking for intersol transaction
	#--------------------------------------
	
	IF((CUST.CEXCH.initSol== CUST.CEXCH.acctSol) AND (CUST.CEXCH.acctSol == CUST.CEXCH.mySol) AND (CUST.CEXCH.initSol == CUST.CEXCH.mySol))THEN
	#{
