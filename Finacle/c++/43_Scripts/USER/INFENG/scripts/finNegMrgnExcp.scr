			CUST.CEXCH.cash_margin_amt =BANCS.OUTPARAM.cash_margin_amt
			PRINT(CUST.CEXCH.cash_margin_amt)
			CUST.CEXCH.custRate = BANCS.OUTPARAM.rate
			PRINT(CUST.CEXCH.custRate)
			
			PRINT(CUST.CEXCH.acctCrncyAmt)
			PRINT(CUST.CEXCH.rate)
			PRINT(CUST.CEXCH.refAmt)
			PRINT(CUST.CEXCH.custRate)
			
			
			sv_x = CDOUBLE(CUST.CEXCH.acctCrncyAmt)
			sv_y = CDOUBLE(CUST.CEXCH.custRate)
			sv_z = CDOUBLE(CUST.CEXCH.refAmt)
			
			sv_m = sv_y * sv_z
			
			sv_d = sv_x - sv_m
			PRINT(sv_d)
			
			IF(sv_d < 0)THEN
			#{
				sv_d = (sv_d)*(-1)
				PRINT(sv_d)
			#}
			ENDIF
			
			IF(CUST.CEXCH.isCrTranFlag == "Y") THEN
			#{
				IF(CDOUBLE(CUST.CEXCH.cash_margin_amt) < (sv_d)) THEN
				#{
					BANCS.OUTPUT.successOrFailure = "F"
					BANCS.OUTPUT.ErrorDesc = "Account Currency Amount shouldn't be greater than Cash margin amount"
					
               			GOTO ENDOFSCRIPT
					
				#}
				ENDIF
				
				#}
			ELSE
				#{
				IF(CDOUBLE(CUST.CEXCH.transfer_margin_amt) < (sv_d)) THEN
				#{

					BANCS.OUTPUT.successOrFailure = "F"
					BANCS.OUTPUT.ErrorDesc = "Account Currency Amount shouldn't be greater than Transfer margin amount"
					GOTO ENDOFSCRIPT
					
				#}
				ENDIF
				
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		TRACE OFF
		
