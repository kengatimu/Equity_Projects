			sv_s = "INSERT INTO CUSTOM.BCCALC_CHARGE_COLLECTION (CHARGE_TYPE,charge_event_id,SRL_NUM,ACCT_NUM,SOL_ID,ACCT_CRNCY_CODE,"
			sv_s = sv_s + "TRAN_DATE,CHARGE_AMT,VAT_AMT,TOTAL_CHARGE_AMT,CHARGE_CRNCY_CODE,TOT_ADJ_AMT,"
			sv_s = sv_s + "LAST_ADJUSTED_DATE,FULLY_ADJUSTED_FLG,LIEN_STATUS_FLG,LIEN_APPLIED_AMT,RCRE_USER_ID,"
			sv_s = sv_s + "RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,FAILURE_REMARKS,INSTR_NUM,INSTR_TYPE,ROW_NUM,charge_acct) values "
			sv_s = sv_s + "(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
			sv_s = sv_s + "TO_DATE(sysdate,'DD-MM-YY'),?SVAR,?SVAR,?SVAR,?SVAR,0,"
			sv_s = sv_s + "'','N','N',0,?SVAR,"
			sv_s = sv_s + "SYSDATE,'','',?SVAR,?SVAR,?SVAR,?SVAR,CUSTOM.BCCALC_CUSTOM_SEQUENCE.NEXTVAL,?SVAR)"

			BANCS.INPARAM.BINDVARS = BANCS.INPUT.eventType + "|" + BANCS.INPUT.eventId + "|" + CUST.DATA.slCount + "|" + CUST.DATA.debitAcct + "|" + CUST.DATA.acctSolId + "|" +  CUST.DATA.acctCrncy 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.chrgAmt + "|" + CUST.DATA.vatcollAmount 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.chrgAmount
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +  CUST.DATA.acctCrncy + "|" + BANCS.STDIN.userId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.DATA.remark
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + TRIM(CUST.DATA.instrNum) + "|" + TRIM(CUST.DATA.instrType+ "|" + BANCS.INPUT.Custchargeacct)

			sv_q = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_q)

			IF(sv_q != 0)THEN
				CUST.DATA.errMsg = ""
			ELSE
				sv_q = urhk_dbSQLWithBind("COMMIT")
			ENDIF
		print("ZERO CHARGE")
