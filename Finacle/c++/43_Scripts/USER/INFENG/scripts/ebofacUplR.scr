<--start
trace on
	sv_u=urhk_B2K_PrintRepos("BANCS")
	print(sv_u)
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_r = urhk_MTTS_PopulateInputDetails("")
	print(sv_r)
	if(sv_r==0)then
		EQSRV.GLBDATA.ctlPth  = MTT.InputDetails.Argument1
		EQSRV.GLBDATA.fileLoc = MTT.InputDetails.Argument2
		EQSRV.GLBDATA.cuserpass = MTT.InputDetails.Argument3
		EQSRV.GLBDATA.batchId = MTT.InputDetails.Argument4
		EQSRV.GLBDATA.ModuleId = MTT.InputDetails.Argument5
		print(EQSRV.GLBDATA.batchId)
		print(EQSRV.GLBDATA.ModuleId)	
	else
		EQSRV.GLBDATA.ctlPth  = ""
		EQSRV.GLBDATA.fileLoc = ""
		EQSRV.GLBDATA.cuserpass = ""
		EQSRV.GLBDATA.batchId = ""
		EQSRV.GLBDATA.ModuleId  = ""
	endif
	if((EQSRV.GLBDATA.fileLoc=="R") and (EQSRV.GLBDATA.cuserpass=="R"))then
		EQSRV.GLBDATA.processR = "Y"
	else
		EQSRV.GLBDATA.processR = "N"
	endif
	EQSRV.GLBDATA.mainBatId = EQSRV.GLBDATA.batchId
	sv_u = urhk_getFileLocation("COM|ebofacM.com")
	print(sv_u)
	sv_l = BANCS.OUTPARAM.fileLocation
	if(EQSRV.GLBDATA.processR=="N")then
	sv_t = sv_l + "ebofacM.com" + " " +BANCS.STDIN.userId+ " "+ BANCS.STDIN.contextBankId + " " + EQSRV.GLBDATA.ctlPth + " " + EQSRV.GLBDATA.fileLoc + " " + EQSRV.GLBDATA.cuserpass + " " + EQSRV.GLBDATA.batchId + " " + EQSRV.GLBDATA.ModuleId + " " +EQSRV.GLBDATA.mainBatId
	else
	EQSRV.GLBDATA.ctlPth ="N"
	EQSRV.GLBDATA.fileLoc= "N"
	EQSRV.GLBDATA.cuserpass = "N"
	EQSRV.GLBDATA.batchId = "N"
	EQSRV.GLBDATA.ModuleId = "RPT"
	sv_t = sv_l + "ebofacM.com" + " " +BANCS.STDIN.userId+ " "+ BANCS.STDIN.contextBankId + " " + EQSRV.GLBDATA.ctlPth + " " + EQSRV.GLBDATA.fileLoc + " " + EQSRV.GLBDATA.cuserpass + " " + EQSRV.GLBDATA.batchId + " " + EQSRV.GLBDATA.ModuleId + " " +EQSRV.GLBDATA.mainBatId
	endif
	print(sv_t)
	sv_u = system(sv_t)
	print(sv_u)
	exitscript
trace off
end-->
