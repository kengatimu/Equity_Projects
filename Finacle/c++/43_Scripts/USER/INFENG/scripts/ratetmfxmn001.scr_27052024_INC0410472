IF (BANCS.STDIN.contextBankId == "43") THEN
	PRINT(BANCS.STDIN.userId)
	IF ( (BANCS.STDIN.userId != "CDCI") AND (BANCS.STDIN.userId != "FIVUSR") AND (BANCS.STDIN.userId != "BJMS") ) THEN
		CUST.RATE.sysDateadt = BANCS.STDIN.sysDate
		print(CUST.RATE.sysDateadt)
		CUST.RATE.getsysdateadtstart="99"
		CUST.RATE.getsysdateadtend="88"
		CUST.RATE.getsysdateadt00flg="N"
		CUST.RATE.getsysdateadt06flg="N"
		#sv_s = "getsysdate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
		sv_s = "getsysdateampm,getsysdateadttime|select substr(to_char(sysdate ,'DD-MON-RRRR HH:MI:SS AM'),22,2) ampm, substr(to_char(sysdate ,'DD-MON-RRRR HH:MI:SS AM'),13,2) adttime from dual "
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  CUST.RATE.sysDateadt
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
			CUST.RATE.getsysdateampm = BANCS.OUTPARAM.getsysdateampm
			print(CUST.RATE.getsysdateampm)
			CUST.RATE.getsysdateadttime= BANCS.OUTPARAM.getsysdateadttime
			print(CUST.RATE.getsysdateadttime)
			IF (CUST.RATE.getsysdateampm=="AM") THEN
				CUST.RATE.getsysdateadt06="08"
				print(CUST.RATE.getsysdateadt06)
				IF (cint(CUST.RATE.getsysdateadttime) < cint(CUST.RATE.getsysdateadt06)) THEN
					print("intime")
					CUST.RATE.getsysdateadt06flg="Y"
					print(CUST.RATE.getsysdateadt06flg)
				ENDIF
				IF (CUST.RATE.getsysdateadttime == "12") THEN
					CUST.RATE.getsysdateadt06flg="Y"
					print(CUST.RATE.getsysdateadt06flg)
				ENDIF
			ELSE
				CUST.RATE.getsysdateadt06flg="Y"
				print(CUST.RATE.getsysdateadt06flg)
			ENDIF
			IF (CUST.RATE.getsysdateadt06flg=="Y") THEN
				print(BANCS.STDIN.mySolId)
				sv_s = "gct_bod_date| select TO_CHAR((TO_DATE(db_stat_date,'DD-MM-RRRR')),'DD-MM-RRRR')  from  tbaadm.gct where bank_id=?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId 
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0 ) THEN
					CUST.RATE.gct_bod_date = BANCS.OUTPARAM.gct_bod_date
					print(CUST.RATE.gct_bod_date)
				ENDIF
				sv_s = "sol_bod_date| select TO_CHAR((TO_DATE(SOL_BOD_DATE,'DD-MM-RRRR')),'DD-MM-RRRR')  from  tbaadm.sol where bank_id=?SVAR and sol_id=?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId +"|" + BANCS.STDIN.mySolId 
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0 ) THEN
					CUST.RATE.sol_bod_date = BANCS.OUTPARAM.sol_bod_date
					print (CUST.RATE.sol_bod_date)
				ENDIF
				IF (CUST.RATE.sol_bod_date!=CUST.RATE.gct_bod_date) THEN
					print("stoptrans")
					CUST.RATE.statusalert="Y"
					print(CUST.RATE.statusalert)
					sv_u = urhk_SRV_SetErr("Error: Transaction Not Allowed At This Time.")
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ENDIF
			ELSE
				print("allowtrans")
				CUST.RATE.statusalert="N"
				print(CUST.RATE.statusalert)
			ENDIF
		ENDIF
	ENDIF
ENDIF


