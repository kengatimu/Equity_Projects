	VATCALC:
		
		########## getting the charge % from CPARAM ################
		sv_s = "vatPcnt | select CUSTOM.getCparamValue('VAT_FOR_CHRG_PCNT','OT',?SVAR)  from dual "
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.VAT.vatPcnt = BANCS.OUTPARAM.vatPcnt
			PRINT (CUST.VAT.vatPcnt)
			#}
		ELSE
			#{
			#### charge percentage is not set up in CPARAM
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		########## End of getting the charge % from CPARAM ################
		
		########## calculating the charges ################
		IF (CUST.VAT.vatPcnt > 0) THEN
		#{
			PRINT(CUST.VAT.inputAmount)
			PRINT(CUST.VAT.vatPcnt)
			PRINT(CUST.VAT.vatcollAmount)
			CUST.VAT.vatcollAmount = CDOUBLE(CUST.VAT.inputAmount) * (CDOUBLE(CUST.VAT.vatPcnt)/100)
			#}
		ELSE
			#{
			#### charge percentage is 0
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
