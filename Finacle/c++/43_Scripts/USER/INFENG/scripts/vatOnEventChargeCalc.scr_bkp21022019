                				BANCS.INPARAM.Rate         = CDOUBLE("0.0")
                				sv_u = urhk_B2k_ConvertAmount("")
                				CUST.VAT.effavlamt = BANCS.OUTPARAM.OutputAmount
        				#}
        				ENDIF
        				PRINT(CUST.VAT.effavlamt)

					IF(CUST.VAT.effavlamt < sv_c)THEN
