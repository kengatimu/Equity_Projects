		sv_s = "count|select count(1) from TBAADM.FCFTT where ACID IN (SELECT ACID FROM TBAADM.GAM WHERE foracid=?SVAR AND BANK_ID=?SVAR) AND FREE_CODE_2='N' "
		sv_s = sv_s+ "AND bank_id=?SVAR "
