						############################################################
						# insert record into CUSTOM.C_CHARGE_COLLECTION
						############################################################
						#######sl no generation

						CUST.VAT.slCount = ""
						sv_s = "slCount|SELECT COUNT(1) FROM  CUSTOM.C_CHARGE_COLLECTION WHERE "
						sv_s = sv_s + " ACCT_NUM = ?SVAR AND TRAN_DATE = TO_DATE(sysdate,'DD-MM-YY') AND"
						sv_s = sv_s + " BANK_ID = ?SVAR "
						BANCS.INPARAM.BINDVARS = CUST.VAT.debitAccount + "|"+ BANCS.STDIN.contextBankId

						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)

						IF(sv_d == 0)THEN
						#{
							sv_l = BANCS.OUTPARAM.slCount
							sv_l = sv_l + 1
							CUST.VAT.slCount = sv_l
							PRINT(CUST.VAT.slCount)
						#}
						ENDIF

						#######sl no generation- END

						CUST.VAT.remark ="Insufficient balance"

						sv_s = "INSERT INTO CUSTOM.C_CHARGE_COLLECTION (CHARGE_TYPE,SRL_NUM,ACCT_NUM,SOL_ID,ACCT_CRNCY_CODE,"
						sv_s = sv_s + "TRAN_DATE,CHARGE_AMT,VAT_AMT,TOTAL_CHARGE_AMT,CHARGE_CRNCY_CODE,TOT_ADJ_AMT,"
						sv_s = sv_s + "LAST_ADJUSTED_DATE,FULLY_ADJUSTED_FLG,LIEN_STATUS_FLG,LIEN_APPLIED_AMT,RCRE_USER_ID,"
