        sv_o = mid$(BANCS.INPUT.OrderingInstitutionName,0,35)
        sv_m = sv_m + ":52d2:E:" +sv_o + "|"

        sv_p = strlen(BANCS.INPUT.OrderingInstitutionAddress1)
        sv_q = strlen(BANCS.INPUT.OrderingInstitutionAddress2)
        sv_r = strlen(BANCS.INPUT.OrderingInstitutionAddress3)
        if( (sv_p <= 35) AND (sv_q <= 35) AND (sv_r <= 35) ) then
            sv_m = sv_m + ":52d3:E:" +BANCS.INPUT.OrderingInstitutionAddress1 + "|"
            sv_m = sv_m + ":52d4:E:" +BANCS.INPUT.OrderingInstitutionAddress2 + "|"
            sv_m = sv_m + ":52d5:E:" +BANCS.INPUT.OrderingInstitutionAddress3 + "|"
        else
            sv_s = ""
            sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.OrderingInstitutionAddress1)) + " "
            sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.OrderingInstitutionAddress2)) + " "
            sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.OrderingInstitutionAddress3)) + " "
            sv_t = mid$(sv_s,0,35)
            sv_m = sv_m + ":52d3:E:" +sv_t + "|"
            sv_u = mid$(sv_s,35,35)
            sv_m = sv_m + ":52d4:E:" +sv_u + "|"
            sv_v = mid$(sv_s,70,35)
            sv_m = sv_m + ":52d5:E:" +sv_v + "|"
        endif
	endif
endif
