sv_e = " Refnum|Select FREE_TEXT  FROM TBAADM.PORD " 
sv_e = sv_e + " WHERE PYMT_REF_NUM = ?SVAR "
sv_e = sv_e + " AND BANK_ID  = ?SVAR "

BANCS.INPARAM.BINDVARS = BANCS.INPUT.TransactionReferenceNo + "|" + BANCS.STDIN.contextBankId 
