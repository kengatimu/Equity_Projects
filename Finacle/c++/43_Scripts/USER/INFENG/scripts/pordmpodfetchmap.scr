			CUST.DATA.ourCorrespBankCode= BANCS.OUTPARAM.ourCorrespBankCode
			PRINT(CUST.DATA.ourCorrespBankCode)
			CUST.DATA.ourCorrespBranchCode= BANCS.OUTPARAM.ourCorrespBranchCode
			PRINT(CUST.DATA.ourCorrespBranchCode)
			CUST.DATA.crAcct= BANCS.OUTPARAM.crAcct
			PRINT(CUST.DATA.crAcct)


			IF(CUST.DATA.interInstnBic != "")THEN
			#{

				print(CUST.DATA.interInstnBic)
				sv_p = "bankCode,branchCode,paysysId,bankIdentifier|SELECT bank_code,Branch_Code,Paysys_Id,"
				sv_p = sv_p + "bank_identifier FROM TBAADM.BRBIC  where Paysys_Id ='SWIFT' "
				sv_p = sv_p + "and bank_id =?SVAR and bank_identifier = ?SVAR "

				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+CUST.DATA.interInstnBic
				PRINT(sv_p)
				PRINT(BANCS.INPARAM.BINDVARS)

				sv_d=urhk_dbSelectWithBind(sv_p)

				if(sv_d == "0")then
				#{
					CUST.DATA.bankCode= BANCS.OUTPARAM.bankCode
					PRINT(CUST.DATA.bankCode)
					CUST.DATA.branchCode= BANCS.OUTPARAM.branchCode
					PRINT(CUST.DATA.branchCode)
					CUST.DATA.paysysId= BANCS.OUTPARAM.paysysId
					PRINT(CUST.DATA.paysysId)
					CUST.DATA.bankIdentifier= BANCS.OUTPARAM.bankIdentifier
					PRINT(CUST.DATA.bankIdentifier)

				else
	                		CUST.DATA.errFlg="Y"
	               	 		CUST.DATA.errMsg="Bank code/Branch code is/are NULL"
	                		GOTO ENDOFSCRIPT	
				            
			    	#}
			    	ENDIF
			ENDIF
			GOTO ENDOFSCRIPT
		ELSE
			GOTO ENDOFSCRIPT
		
		ENDIF
	ENDIF


ENDOFSCRIPT:
   
	PRINT(CUST.DATA.branchCode)
	PRINT(CUST.DATA.bankCode)
	PRINT(CUST.DATA.bankIdentifier)
	PRINT(CUST.DATA.interInstnBic)

       	 sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
       	 sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)

	sv_u = urhk_SetOrbOut("interInstnBic|"+CUST.DATA.interInstnBic)
	sv_u = urhk_SetOrbOut("ourCorrespBic|"+CUST.DATA.ourCorrespBic)
	sv_u = urhk_SetOrbOut("crAcct|"+CUST.DATA.crAcct)
	sv_u = urhk_SetOrbOut("ourCorrespBankCode|"+CUST.DATA.ourCorrespBankCode)
	sv_u = urhk_SetOrbOut("ourCorrespBranchCode|"+CUST.DATA.ourCorrespBranchCode)
	sv_u = urhk_SetOrbOut("interInstnBankCode|"+CUST.DATA.bankCode)
	sv_u = urhk_SetOrbOut("interInstnBranchCode|"+CUST.DATA.branchCode)
	


TRACE OFF
END-->