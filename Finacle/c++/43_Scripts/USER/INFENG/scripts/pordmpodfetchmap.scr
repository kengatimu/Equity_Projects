
<--START
TRACE ON
	
	IF (REPEXISTS("CUST") == 0 ) THEN
		CREATEREP("CUST")
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
		CREATECLASS("CUST","DATA",5)
	ENDIF

sv_u=urhk_B2k_PrintRepos("BANCS")
print(sv_u)


	CUST.DATA.errFlg = "N"
	CUST.DATA.errMsg = " "
	CUST.DATA.recvrCorrespBic=" "
	CUST.DATA.interInstnBic = " "
	CUST.DATA.ourCorrespBic=" "
	CUST.DATA.crAcct=" "
	CUST.DATA.ourCorrespBankCode=" "
	CUST.DATA.ourCorrespBranchCode=" "
	CUST.DATA.recvrCorrespBankCode=" "
	CUST.DATA.recvrCorrespBranchCode=" "
    	CUST.DATA.branchCode= " "
	CUST.DATA.bankCode=" "
	CUST.DATA.bankIdentifier=" "
	CUST.DATA.interInstnBic = " "

	IF(FIELDEXISTS(BANCS.INPUT.remitCrncy))THEN
		IF(BANCS.INPUT.remitCrncy !="")THEN
			CUST.DATA.remitCrncy = TOUPPER(TRIM(BANCS.INPUT.remitCrncy))
			PRINT(CUST.DATA.remitCrncy)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Remittance Currency Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Remittance Currency Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.awiBic))THEN
		IF(BANCS.INPUT.awiBic!="")THEN
			CUST.DATA.awiBic= TOUPPER(TRIM(BANCS.INPUT.awiBic))
			PRINT(CUST.DATA.awiBic)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "acct with Bic Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "acct with Bic Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.orderType))THEN
		IF(BANCS.INPUT.orderType!="")THEN
			CUST.DATA.orderType= TOUPPER(TRIM(BANCS.INPUT.orderType))
			PRINT(CUST.DATA.orderType)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Order type Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Order type Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF


	IF ((CUST.DATA.awiBic !="") and (CUST.DATA.remitCrncy !="") and (CUST.DATA.orderType !="BT")and (CUST.DATA.remitCrncy !="CDF")) THEN

		
		#sv_s = "recvrCorrespBic,ourCorrespBic,ourCorrespBankCode,ourCorrespBranchCode,crAcct|SELECT   rpad(BEN_CORR_CODE,11,'X')  BEN_CORR_CODE,  rpad(CORR_SWIFT_CODE,11,'X') CORR_SWIFT_CODE,CORR_BANK  , CORR_BRNCH, CORR_ACCT  from custom.bcdc_local_route WHERE BANK_ID=?SVAR AND ben_swift_code=?SVAR AND crncy_code=?SVAR and rownum=1"
	       sv_s = "recvrCorrespBic,ourCorrespBic,ourCorrespBankCode,ourCorrespBranchCode,crAcct|"
	       sv_s = sv_s + "SELECT  BEN_CORR_CODE,  rpad(CORR_SWIFT_CODE,11,'X') CORR_SWIFT_CODE,"
	       sv_s = sv_s + "CORR_BANK  , CORR_BRNCH, CORR_ACCT  from custom.bcdc_local_route WHERE BANK_ID=?SVAR"
	       sv_s = sv_s + "AND ben_swift_code=?SVAR AND crncy_code=?SVAR AND PAYSYS_ID='SWIFT' and rownum=1"

		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.awiBic +"|"+ CUST.DATA.remitCrncy 
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		IF(sv_d == "0")THEN

			#CUST.DATA.recvrCorrespBic= BANCS.OUTPARAM.recvrCorrespBic
			#PRINT(CUST.DATA.recvrCorrespBic)

			CUST.DATA.interInstnBic= BANCS.OUTPARAM.recvrCorrespBic
