<--START
	TRACE ON
	
	#-------------------------------------------------------------------------------------------------------
	# Create repository and class
	#-------------------------------------------------------------------------------------------------------
	IF(REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","DATA")==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF

	#-------------------------------------------------------------------------------------------------------
	# Intialising repository variables
	#-------------------------------------------------------------------------------------------------------
	CUST.DATA.remitInfo4 = ""
	CUST.DATA.count = ""
	CUST.DATA.reqCounter = 0
	
	#-------------------------------------------------------------------------------------------------------
	#Count from CUSTOM.C_POP_CODES"
	#-------------------------------------------------------------------------------------------------------
	sv_s = "count|"
	sv_s = sv_s + " SELECT COUNT(*) FROM CUSTOM.C_POP_CODES "
	
	sv_c = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_c)
	PRINT(BANCS.OUTPARAM.count)
	IF(sv_c != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.DATA.count = BANCS.OUTPARAM.count
		PRINT(CUST.DATA.count)
	#}
	ENDIF
	
	sv_u = urhk_SetOrbOut("recCount|" + CUST.DATA.count)
	PRINT(sv_u)
	
	#-------------------------------------------------------------------------------------------------------
	# Fetch POP_CODE,POP_DESCRIPTION,COMMISSIONS_D_AGENCE from CUSTOM.C_POP_CODES
	#-------------------------------------------------------------------------------------------------------
	
	lv_s = "remitInfo4,popCodeDesc,commissionsDAgence|"
	lv_s = lv_s + " SELECT UPPER(POP_CODE), UPPER(POP_DESCRIPTION), UPPER(COMMISSIONS_D_AGENCE)"
	lv_s = lv_s + " FROM CUSTOM.C_POP_CODES "
	PRINT(lv_s)

	sv_c = urhk_dbCursorOpenWithBind(lv_s)
	PRINT(sv_c)
	
	IF(sv_c != 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.DATA.cursorNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(CUST.DATA.cursorNum)
		sv_r = urhk_dbCursorFetch(CUST.DATA.cursorNum)
		PRINT(sv_r)
		IF(sv_r == 0) THEN
		#{
			WHILE (sv_r == 0)
			#{
				CUST.DATA.reqCounter = CINT(CUST.DATA.reqCounter) + 1
				CUST.DATA.remitInfo4 = BANCS.OUTPARAM.remitInfo4
				CUST.DATA.popCodeDesc = BANCS.OUTPARAM.popCodeDesc
				CUST.DATA.commissionsDAgence = BANCS.OUTPARAM.commissionsDAgence
				PRINT(CUST.DATA.reqCounter)
				PRINT(CUST.DATA.remitInfo4)
				PRINT(CUST.DATA.popCodeDesc)
				PRINT(CUST.DATA.commissionsDAgence)
				
				sv_z = "remitInfo4_" + CUST.DATA.reqCounter
				sv_z = sv_z + "|" + CUST.DATA.remitInfo4
				sv_u = urhk_SetOrbOut(sv_z)
				sv_z = "popCodeDesc_" + CUST.DATA.reqCounter
				sv_z = sv_z + "|" + CUST.DATA.popCodeDesc
				sv_u = urhk_SetOrbOut(sv_z)
				sv_z = "commissionsDAgence_" + CUST.DATA.reqCounter
				sv_z = sv_z + "|" + CUST.DATA.commissionsDAgence
				sv_u = urhk_SetOrbOut(sv_z)
				
				PRINT(CUST.DATA.cursorNum)
				sv_r = urhk_dbCursorFetch(CUST.DATA.cursorNum)
			#}
			DO
		#}
		ELSE
		#{
			PRINT("No records fetched")
		#}
		ENDIF
		
		PRINT(CUST.DATA.cursorNum)
		sv_r = urhk_dbCursorClose(CUST.DATA.cursorNum)
	#}
	ENDIF
	
	PRINT(CUST.DATA.count)
	
	ENDOFSCRIPT:
		EXITSCRIPT
		TRACE OFF
END-->

