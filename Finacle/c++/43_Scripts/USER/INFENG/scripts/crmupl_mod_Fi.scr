			sv_a = "exebatch babx4040 $B2K_SESSION_ID "  +CUST.CCRRM.reportfile+ " "+CUST.CCRRM.reportfile+ " 1 N"
			#sv_r=system("rm -f"+ CUST.CCRRM.reportfile)
			print(sv_a)
			
			sv_i = SYSTEM(sv_a)
		#}
		ELSE
		#{
			CUST.CCRRM.errorMsg = "Unable to load the com file"
  				 exitscript
