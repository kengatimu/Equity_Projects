						#{
							PRINT("MODIFY RETAIL CIF")
							
								call("crmuplRetModReqDRC.scr")
						#}		
						else	
							#{
								call("crmuplCorpModReqDRC.scr")
							#}
						ENDIF
						
					#}
					ELSE
					#{
						print("Invalid customer cif id")
