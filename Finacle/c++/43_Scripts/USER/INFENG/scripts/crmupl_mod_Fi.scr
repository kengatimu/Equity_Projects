			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_m)
			sv_n = urhk_dbCursorFetch(sv_m)
			PRINT(sv_n)
			IF(sv_n != 0)THEN
			#{
					CUST.CCRRM.SorFmessage = "No records found in the upload table"
					print(CUST.CCRRM.SorFmessage)
					sv_c=urhk_dbCursorClose(sv_m)
					
					sv_r = system("echo '\t"+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
					print(sv_r)
					GOTO UPDATERPT
			#}		
			ELSE
			#{
				CUST.CCRRM.sleepcount=0
				

				WHILE (sv_n == 0)
				#{
					CUST.CCRRM.customer_id  	= BANCS.OUTPARAM.CIF_ID
					CUST.CCRRM.newRM		= BANCS.OUTPARAM.RM
					CUST.CCRRM.customertype             = BANCS.OUTPARAM.customertype				
					CUST.CCRRM.ModSuccessflg 	= "F"
					CUST.CCRRM.SorFmessage      = ""
					CUST.CCRRM.Statuscode    	= "U"
					
					print(CUST.CCRRM.customer_id)
					print(CUST.CCRRM.newRM)
					

					# Check for sleep counter

					IF(CUST.CCRRM.sleepcount==50)then
					#{
						sv_r = system("sleep 10")
						print(sv_r)
						CUST.CCRRM.sleepcount = 0
					#}
					ENDIF
					
					IF ((CUST.CCRRM.customertype=="I") OR (CUST.CCRRM.customertype=="C") )THEN
