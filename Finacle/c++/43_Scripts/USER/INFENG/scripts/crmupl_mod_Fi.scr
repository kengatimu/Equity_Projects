	# ********* Fetch Records and modify using CRM FI request
	
	
	
	print("Breakpoint 1")
	
	#IF(CUST.CCRRM.funCode == "U")THEN
	#{
		#====================  FETCHING RECORDS FROM THE TABLE Start
		
			#Start of acct Modification
			print(CUST.CCRRM.refnumber)
			
			sv_s = "CIF_ID,RM,customertype| select CIF_ID,RM,CUST_TYPE from custom.CUSTOM_RM_UPDATE_CIF   where  "
