#		sv_q = "drAcct,acct_crncy_code,clrBalAmt,schmCode,cifId|SELECT FORACID ,ACCT_CRNCY_CODE,-1* CLR_BAL_AMT,SCHM_CODE, CIF_ID"

		sv_q = "drAcct,acct_crncy_code,clrBalAmt,schmCode,cifId,intdracid|SELECT FORACID ,gam.ACCT_CRNCY_CODE, sum(lht.sanct_lim),gam.SCHM_CODE, gam.CIF_ID,gac.int_dr_acid"
		sv_q = sv_q + " FROM TBAADM.GAM ,TBAADM.LHT,TBAADM.GAC"
