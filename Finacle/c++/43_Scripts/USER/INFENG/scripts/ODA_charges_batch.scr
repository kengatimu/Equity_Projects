		sv_q = sv_q + " AND ACCT_CLS_FLG='N' "
		sv_q = sv_q + " AND GAM.DEL_FLG='N' "
		sv_q = sv_q + " AND GAM.ENTITY_CRE_FLG='Y' "
		sv_q = sv_q + " AND GAM.BANK_ID = ?SVAR and frez_code not in ('TX','CX','DX')"
		#sv_q = sv_q + " AND SOL_ID= ?SVAR AND SCHM_CODE IN ('CA700', 'CA701', 'CA703', 'CA704', 'CA705', 'CA706', 'CA707', 'CA708', 'CA790', 'CA702','CAGEN') AND ROWNUM < 10 AND ACCT_CRNCY_CODE != 'KES'"
		sv_q = sv_q + " AND GAM.SOL_ID= ?SVAR AND SCHM_CODE IN ('CA700', 'CA701', 'CA703', 'CA704', 'CA705', 'CA706', 'CA707', 'CA708', 'CA790', 'CA702','OD700','OD701')"
		###sv_q = sv_q + " AND GAM.SOL_ID= ?SVAR AND SCHM_CODE IN ('CA700','OD700','OD701','OD702')"
		sv_q = sv_q + " AND GAM.foracid not in (select foracid from tbaadm.gam where bank_id='43' and schm_code='OD701' and acct_crncy_code ='USD' and sol_id=?SVAR)  "
		sv_q = sv_q + " and gac.acid=gam.acid and gac.acid=lht.acid and gac.bank_id=gam.bank_id and gac.bank_id=lht.bank_id"
		sv_q = sv_q + " And LHT.status='A' and (lht.lim_exp_date -lht.applicable_date) >179 "
		##sv_q = sv_q + " And rownum <10 "

#---2 line to be hushed below
##		sv_q = sv_q + " and foracid in ('710000138972333') "
		sv_q = sv_q + " and foracid not  in ('511200000022389') "
