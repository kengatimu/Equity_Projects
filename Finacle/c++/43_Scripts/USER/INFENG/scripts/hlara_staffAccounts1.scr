                sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.racodCurNum)
                print(sv_u)
                if(sv_u!=0)then
                        print("fetch failed")
                        sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.racodCurNum)
                        print(sv_u)
                        EQSRV.GLBDATA.srvErrMsg =  "lara Cursor Fetch Failed"
                        EQSRV.GLBDATA.srvErrCode = "DBCursor"
                        EQSRV.GLBDATA.srvSucFail = "F"
                        goto Endofscript
                endif
#		######
#			BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.AcctNum 
#			print(BANCS.INPARAM.BINDVARS)
#			sv_j = "update  custom.Reschedule_drc_table  set pull_flg='Z'  where foracid=?SVAR  and pull_flg='Y' "
#			sv_w = urhk_dbSQLWithBind(sv_j)
#			sv_w = urhk_dbSQLWithBind("COMMIT")
#			print(sv_w)
#		#####
                EQSRV.GLBDATA.racodrec = cint(EQSRV.GLBDATA.racodrec) + 1
                EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.racodrec
                print(EQSRV.GLBDATA.recmsg)

        #}vploop Ends
       do
      sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.racodCurNum)
       print(sv_u)

Endofscript:
        print(EQSRV.GLBDATA.srvErrMsg)
        print(EQSRV.GLBDATA.srvErrCode)
        print(EQSRV.GLBDATA.srvSucFail)
 exitscript
