<--START
CHECKSUM="22c624c4bbff5129ffa2aea2cc57403435624a8919345e2117c653c57a4a288f"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.SBACT.errMsg = ""
	CUSTS.SBACT.b2kidnew = ""
	CUSTS.SBACT.b2kidnewflg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) from  custom.BULK_LIEN_COLLECTION_DRC where ROLLBACK_FREETEXT1='LIEN_AND_POST_ROLL_BACK' and ROLLBACK_LIEN_FLGYESORNO='DONE_FOR_POST'  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
	#{
		CUSTS.SBACT.errMsg = "DB ERROR!"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.custcount)
		IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s=" foracid,sol_id, narr, cyc_code,lien_amt,foracid_recover,lienreasoncode,b2kid|"
	sv_s = sv_s + " select  foracid,sol_id, LIEN_REMARKS, ACCT_CRNCY_CODE,lien_amt,COLLECTION_ACCOUNT,LIEN_REASON_CODE,B2K_ID "
	sv_s = sv_s + " from  custom.BULK_LIEN_COLLECTION_DRC where ROLLBACK_FREETEXT1='LIEN_AND_POST_ROLL_BACK' and ROLLBACK_LIEN_FLGYESORNO='DONE_FOR_POST' order by lien_amt desc  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.SBACT.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUSTS.SBACT.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.SBACT.sol_id	= BANCS.OUTPARAM.sol_id
			CUSTS.SBACT.narr	= BANCS.OUTPARAM.narr
			CUSTS.SBACT.cyc_code = BANCS.OUTPARAM.cyc_code
			print(CUSTS.SBACT.cyc_code)
			CUSTS.SBACT.lien_amt = BANCS.OUTPARAM.lien_amt
			print(CUSTS.SBACT.lien_amt)
			CUSTS.SBACT.amount = CUSTS.SBACT.lien_amt
			print(CUSTS.SBACT.amount)
			CUSTS.SBACT.foracid_recover = BANCS.OUTPARAM.foracid_recover
			print(CUSTS.SBACT.foracid_recover)
			CUSTS.SBACT.lienreasoncode = BANCS.OUTPARAM.lienreasoncode
			print(CUSTS.SBACT.lienreasoncode)
			CUSTS.SBACT.b2kid = BANCS.OUTPARAM.b2kid
			print(CUSTS.SBACT.b2kid)
			CUSTS.SBACT.narr=MID$(CUSTS.SBACT.narr,0,50)
			print(CUSTS.SBACT.narr)
			
			print(CUSTS.SBACT.foracid)
			print(CUSTS.SBACT.sol_id)
			print(CUSTS.SBACT.amount)
			
			CUSTS.SBACT.b2kidnewflg="Y"
			print(CUSTS.SBACT.b2kidnewflg)

			IF (CUSTS.SBACT.b2kidnewflg=="Y")  THEN
				print("Ok go to posting")
				 CALL("AutoLienColl_Post_rollbMain.scr")
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.SBACT.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.SBACT.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUSTS.SBACT.errMsg+"' >>lienedfttgyhuj.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
