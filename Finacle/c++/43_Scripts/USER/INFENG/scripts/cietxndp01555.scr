	#------------------------------------
	# get the charge and the account
	#------------------------------------


	#------------------------------------
	# DR/CR
	#--------------------------------------
		#PRINT(CUST.CIETXN.contextChrgAmt)
		CUST.CIETXN.ChargeAmt1 ="0.05"
		CUST.CIETXN.tranAmt = CUST.CIETXN.refAmt
		print(CUST.CIETXN.tranAmt)
		sv_k = (CDOUBLE(CUST.CIETXN.ChargeAmt1) * CDOUBLE(CUST.CIETXN.tranAmt))/100
		CUST.CIETXN.ChargeAmt = sv_k
		PRINT(CUST.CIETXN.ChargeAmt)
		print(CUST.CIETXN.drAcct1)
		MTT.PartTranDetails.Account = CUST.CIETXN.nostroAcct
		print(MTT.PartTranDetails.Account)		
		print(MTT.ChargeDetails.CollectionCrncy)
		PRINT(CUST.CIETXN.ieRate)
		MTT.PartTranDetails.Rate= CUST.CIETXN.ieRate
		print(MTT.PartTranDetails.Rate)
		MTT.PartTranDetails.Amount = CUST.CIETXN.ChargeAmt
		CUST.CIETXN.Charge = MTT.PartTranDetails.Amount
		print(CUST.CIETXN.refCrncy)
		MTT.PartTranDetails.TranIdentifier = CUST.CIETXN.tran_identifier
		MTT.PartTranDetails.RefCurrency = CUST.CIETXN.refCrncy
		print(MTT.PartTranDetails.RefCurrency)
		MTT.PartTranDetails.TranCurrency = CUST.CIETXN.refCrncy
		CUST.CIETXN.rateCode = CUST.CIETXN.chargeRateCode
		print(CUST.CIETXN.rateCode)
		MTT.PartTranDetails.RefAmount = MTT.PartTranDetails.Amount
		print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.RateCode = CUST.CIETXN.rateCode
		print(MTT.PartTranDetails.RateCode)
		sv_a = urhk_MTTS_DefineChargePartTran("CREDIT")
		print(sv_a)
		
		
		
		
