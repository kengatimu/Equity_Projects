							sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
							print(sv_e)

							sv_i = sv_i + 1
							sv_u = system("echo '"+sv_e+"' >>BatchChAcctError.log")
