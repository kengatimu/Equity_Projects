<--START
TRACE ON

        if(repexists("CUST") == 0)then
                createrep("CUST")
        endif
        if(classexists("CUST","DATA") == 0)then
                createclass("CUST","DATA",5)
        endif
		
		CUST.DATA.sysDate = mid$(BANCS.STDIN.sysDate,0,2) + mid$(BANCS.STDIN.sysDate,3,2) + mid$(BANCS.STDIN.sysDate,6,4)
		CUST.DATA.sysDate = CUST.DATA.sysDate + mid$(BANCS.STDIN.sysDate,11,2) + mid$(BANCS.STDIN.sysDate,14,2)+mid$(BANCS.STDIN.sysDate,17,2)
		print(CUST.DATA.sysDate)
		
		sv_s = "chrgOffAcctNum,acid,crncyCode,solId,acctName|SELECT a.ORIGINAL_PROD_NUM, acid, acct_crncy_code,sol_id,acct_name" 
		sv_s = sv_s + " FROM CUSTOM.HCOLA_LOANS_DRC a,tbaadm.gam  WHERE POSTED_MAKER = 'V' and a.ORIGINAL_PROD_NUM = gam.foracid and bank_id =?SVAR "
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
	
		sv_e = urhk_dbCursorOpenWithBind(sv_s)
		print(sv_e)

		IF(sv_e==0) THEN
		#{
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(sv_m)
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)

			BANCS.INPUT.RECOUNT = cint("1")
			print(BANCS.INPUT.RECOUNT)

			IF(sv_q == 1) THEN
			#{
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
				exitscript
			#}
			ENDIF
			print(sv_q)

		
			
		WHILE(sv_q==0)
		#{

				CUST.DATA.chrgOffAcctNum = BANCS.OUTPARAM.chrgOffAcctNum
				print(CUST.DATA.chrgOffAcctNum)

				CUST.DATA.acid = BANCS.OUTPARAM.acid
				print(CUST.DATA.acid)
				CUST.DATA.crncyCode = BANCS.OUTPARAM.crncyCode
				print(CUST.DATA.crncyCode)
				CUST.DATA.solId = BANCS.OUTPARAM.solId
				print(CUST.DATA.solId)
				CUST.DATA.acctName = BANCS.OUTPARAM.acctName
				print(CUST.DATA.acctName)
					
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.foracid|" +CUST.DATA.chrgOffAcctNum)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.acid|" +CUST.DATA.acid)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.crncyCode|" +CUST.DATA.crncyCode)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.solId|" +CUST.DATA.solId)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.acctName|" +CUST.DATA.acctName)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.chargeOffType|F")
				sv_i = urhk_SetUrhkInp("chrgOffCrit.modeOfOper|V")

				sv_q = urhk_ExecSrv("SRV_FetchChargeOffForVerify|retain_all_output = Y|ignore_excp_flg=Y")
				print(sv_q)
				
				if(sv_q == 1) then
					 callscriptifexist("ebsrvHandler.scr")
					 GOTO NEXTREC
				else
					CUST.DATA.rptFileName	= "bvcola"+ CUST.DATA.sysDate +".SUC"
					PRINT(CUST.DATA.rptFileName) 
					sv_s = urhk_CopyOutToIn("")
				endif
				
				sv_q = urhk_ExecSrv("SRV_FetchChrgOffPartTranList|retain_all_output = Y|ignore_excp_flg=Y")
				print(sv_q)
				
				if(sv_q == 1) then
					 callscriptifexist("ebsrvHandler.scr")
					 GOTO NEXTREC
				else
				
					CUST.DATA.rptFileName	= "bvcola"+ CUST.DATA.sysDate +".SUC"
					PRINT(CUST.DATA.rptFileName) 
					sv_s = urhk_CopyOutToIn("")

				endif

				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.foracid|" +CUST.DATA.chrgOffAcctNum)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.acid|" +CUST.DATA.acid)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.crncyCode|" +CUST.DATA.crncyCode)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.solId|" +CUST.DATA.solId)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.laAcct.acctName|" +CUST.DATA.acctName)
				sv_i = urhk_SetUrhkInp("chrgOffCrit.chargeOffType|F")
				sv_i = urhk_SetUrhkInp("chrgOffCrit.modeOfOper|V")
				sv_q = urhk_ExecSrv("SRV_VerifyChargeOff|retain_all_output = Y|ignore_excp_flg=Y")
				print(sv_q)
				if(sv_q == 1) then
					callscriptifexist("ebsrvHandler.scr")
					print("KAMA1")
					GOTO NEXTREC
				else
				#{
					CUST.DATA.rptFileName	= "bvcola"+ CUST.DATA.sysDate +".SUC"
					PRINT(CUST.DATA.rptFileName)
					#print(CUST.DATA.rptName)
					print("KAMA1")
					GOTO NEXTREC
				#}
				endif
				
				
				sv_u = urhk_SRV_GetVal("tranObj.tranIdentifier.tranDate")
				print(sv_u)
				CUST.DATA.tranDate = TRIM(BANCS.OUTPARAM.srvValue)
				print(CUST.DATA.tranDate)

				sv_u = urhk_SRV_GetVal("tranObj.tranIdentifier.tranId")
				print(sv_u)
				CUST.DATA.tranId = TRIM(BANCS.OUTPARAM.srvValue)
				print(CUST.DATA.tranId)
						
				sv_u = urhk_SRV_GetVal("tranObj.pstFlg")
				print(sv_u)
				CUST.DATA.pstFlg = TRIM(BANCS.OUTPARAM.srvValue)
				print(CUST.DATA.pstFlg)
				
					 sv_a = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranDate|"+CUST.DATA.tranDate)
					PRINT(sv_a)

					sv_a = urhk_SetUrhkInp("tranDetail.tranIdentifier.tranId|   "+CUST.DATA.tranId)
					PRINT(sv_a)

					sv_a = urhk_SetUrhkInp("tranDetail.ignoreXcpnFlg|Y")
					PRINT(sv_a)
					sv_a = urhk_SetUrhkInp("tranDetail.onlineOrBatchMode|B")
					PRINT(sv_a)
					sv_a = urhk_SetUrhkOut("tranDetail.tranIdentifier.tranId|tranId")
					PRINT(sv_a)
					sv_a = urhk_SetUrhkOut("tranDetail.tranIdentifier.tranDate|tranDate")
					PRINT(sv_a)

				
				sv_q = urhk_ExecSrv("SRV_PostAnEnteredTransaction|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
				print(sv_q)
				
				if(sv_q == 1) then
					callscriptifexist("ebsrvHandler.scr")
					
					GOTO NEXTREC
				else
					print(CUST.DATA.chrgOffAcctNum)

					CUST.DATA.rptFileName	= "bvcola"+ CUST.DATA.sysDate +".SUC"
					PRINT(CUST.DATA.rptFileName) 

					
					BANCS.INPARAM.BINDVARS = CUST.DATA.chrgOffAcctNum
					PRINT(BANCS.INPARAM.BINDVARS)

					sv_s = "UPDATE CUSTOM.HCOLA_LOANS_DRC set POSTED_VERIFY = 'V' WHERE ORIGINAL_PROD_NUM = ?SVAR  and POSTED_MAKER = 'V'"
					print(sv_s)
					sv_d = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_d)
					
					IF(sv_d == 0)THEN
					#{
						sv_r  = urhk_dbSQLWithBind("COMMIT")
						PRINT(sv_r)
						#}
					ELSE
						#{
						sv_r  = urhk_dbSQLWithBind("ROLLBACK")
						PRINT(sv_r)
					#}
					ENDIF
					GOTO NEXTREC
				endif
				GOTO NEXTREC

			BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
			PRINT(BANCS.INPUT.RECCOUNT)

			NEXTREC:

			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
		#}
		DO

		sv_x = urhk_dbCursorClose(sv_m)
		print(sv_x)
	

	ENDIF
		TRACE OFF
		EXITSCRIPT
END-->

