<--start
trace on
#Repos&Classes
	if (repexists("EQSRV") == 0) then
		createrep("EQSRV")
	endif
	if (classexists("EQSRV","GLBDATA") == 0) then
		createclass("EQSRV","GLBDATA",5)
	endif
#Variables
     
	EQSRV.GLBDATA.Tran_Date	= ""


		sv_q = "TranDate | select CONCAT(CONCAT(ott.tran_date,ott.tran_id),ott.PART_TRAN_SRL_NUM) from tbaadm.ott , tbaadm.tct , tbaadm.gam where ott.bank_id ='43' "
		sv_q = sv_q + " and ott.bank_id =gam.bank_id and ott.acid =gam.acid and gam.bacid ='PROXY' and gam.bank_id =?SVAR  "
		sv_q = sv_q + " and   CONCAT(CONCAT(ott.tran_date,ott.tran_id),ott.PART_TRAN_SRL_NUM)  IN  CONCAT(CONCAT(tct.tran_date,tct.tran_id),tct.PART_TRAN_SRL_NUM)  "
		sv_q = sv_q + " and tct.eNTITY_CRE_FLG ='N' and ORG_TRAN_AMT = AMT_OFFSET "
		print(sv_q)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
		sv_e = urhk_dbCursorOpenWithBind(sv_q)
		IF(sv_e==0) THEN
		#{
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print (sv_m)
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			IF(sv_q == 1) THEN
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
				exitscript
			ENDIF
		print(sv_q)
		WHILE (sv_q==0)

		EQSRV.GLBDATA.TranDate= BANCS.OUTPARAM.TranDate
		Print (EQSRV.GLBDATA.TranDate)

				sv_s = "update tbaadm.ott set TOTAL_OFFSET_AMT= ORG_TRAN_AMT, NUM_OFFSET_PTRAN='1' where  bank_id ='43'  and (tran_date||tran_id||PART_TRAN_SRL_NUM) = ?SVAR "
                                print(sv_s)
                               	BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.TranDate
                                print(BANCS.INPARAM.BINDVARS)
                                sv_d = urhk_dbSQLWithBind(sv_s)
                                IF (sv_d == 0) THEN
                                #{
                                        sv_c = urhk_dbSQLWithBind("commit")
                                        print(sv_c)
                                #}
                                ENDIF 
	
				sv_s = "update tbaadm.tct set ENTITY_CRE_FLG='Y' where  bank_id ='43'  and (tran_date||tran_id||PART_TRAN_SRL_NUM) = ?SVAR "
                                print(sv_s)
                               	BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.TranDate
                                print(BANCS.INPARAM.BINDVARS)
                                sv_d = urhk_dbSQLWithBind(sv_s)
                                IF (sv_d == 0) THEN
                                #{
                                        sv_c = urhk_dbSQLWithBind("commit")
                                        print(sv_c)
                                #}
                                ENDIF 

	print (sv_m)
	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	DO
#}
ENDIF

#EndofScript

        
	if(classexists("EQSRV","GLBDATA")==1)then
                deleteclass("EQSRV","GLBDATA")
        endif
        if(repexists("EQSRV")==1)then
                deleterep("EQSRV")
        endif
        exitscript
trace off
end-->

