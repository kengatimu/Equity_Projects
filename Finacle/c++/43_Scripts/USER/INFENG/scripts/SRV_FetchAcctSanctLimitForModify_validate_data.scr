			PRINT(BANCS.OUTPARAM.schmCode)
			EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
			print(EQSRV.GLBDATA.schmCode)

			IF(EQSRV.GLBDATA.schmCode == "CA243")THEN
				sv_u = urhk_SRV_SetErr("Limit Maintenance not Allowed for Scheme Code:CA243!!!")
				exitscript

			ENDIF

		ENDIF

else
	EQSRV.GLBDATA.foracid = ""
endif

if(EQSRV.GLBDATA.foracid !="")then
