					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.currency +"|"+ CUST.DATA.InOutIndctr +"|"+ BANCS.STDIN.contextBankId+"|"+ CUST.DATA.pymntIndctr
					PRINT(BANCS.INPARAM.BINDVARS)
