					BANCS.INPARAM.BINDVARS = CUST.DATA.currency +"|"+ CUST.DATA.InOutIndctr+"|"+ CUST.DATA.pymntIndctr +"|"+ BANCS.STDIN.contextBankId
					sv_a = "tsCount|SELECT TS_CNT FROM CUSTOM.C_PAYPM WHERE  currency_code = ?SVAR AND inw_out_ind = ?SVAR AND rtgs_ach_ind=?SVAR"
					sv_a = sv_a + " AND bank_id = ?SVAR AND del_flg = 'N'"
					
					sv_b = urhk_dbSelectWithBind(sv_a)
