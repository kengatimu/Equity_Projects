<--START
	TRACE ON

	
	sv_r = REPEXISTS("CHGRC")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CHGRC")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CHGRC", "CRCDT")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CHGRC", "CRCDT", 5)
	#}
	ENDIF



	IF(FIELDEXISTS(BANCS.INPUT.treaRate)) THEN
		IF(TRIM(BANCS.INPUT.treaRate) == "")THEN
		BANCS.INPUT.treaRate="TTB"
		print(BANCS.INPUT.treaRate)
		ENDIF
	ENDIF
				####------------------------------------------------####
					# Define  the transaction
					####------------------------------------------------####
					BANCS.INPARAM.PostTranFlg               	= "Y"
					BANCS.INPARAM.CommitFlg                	= "Y"
					BANCS.INPARAM.ValidationFlag           	= "Y"
					BANCS.INPARAM.InsertTranWithValidnFlg   = "Y"
					BANCS.INPARAM.RestrictModifyInd         	= "FIRST_GROUP"
					BANCS.INPARAM.ErrorCheckForLuw          	= "Y"
					BANCS.INPARAM.CheckExceptions         	= "Y"	

					sv_u = urhk_MTTS_initialize("")
					print(sv_u)          
					sv_u = urhk_MTTS_PopulateInputDetails("")
					PRINT(sv_u)
#sv_a= urhk_B2k_printrepos("MTT")
					MTT.TranDetails.TranDate="0"
					MTT.TranDetails.TranType = "T"
					MTT.TranDetails.TranSubType = "BI"
					MTT.TranDetails.Remarks = "ECS TRANSACTION"
					MTT.TranDetails.IgnoreExcp = "I"
					MTT.TranDetails.Consolidate = "N"
					MTT.TranDetails.PostFlag="Y"
					sv_u = urhk_MTTS_DefineTransaction("TCC")	
										PRINT(sv_u)
					#-------------------------------------------------
					# Debit Part MAIN TRANSACTION
					#--------------------------------------------------
#					MTT.PartTranDetails.Account = "000000088120085"
					MTT.PartTranDetails.Account= CUST.DATA.custacc #BANCS.INPUT.custacc
#					MTT.PartTranDetails.RefCurrency = "USD"
					MTT.PartTranDetails.RefCurrency = CUST.DATA.tranccy #BANCS.INPUT.tranccy
#BANCS.INPUT.Ecstranrefnum + " ECS TRANSACTION "
					MTT.PartTranDetails.ValueDateDiff = "0"
					MTT.PartTranDetails.Particulars = CUST.DATA.tranrmks # BANCS.INPUT.tranrmks
					MTT.PartTranDetails.RefAmount =-cdouble(CUST.DATA.remitamt) # -cdouble(BANCS.INPUT.remitamt)
#					MTT.PartTranDetails.tran_crncy_code ="USD"
					MTT.PartTranDetails.tran_crncy_code= CUST.DATA.tranccy #BANCS.INPUT.tranccy
					MTT.PartTranDetails.tran_amt =-cdouble(CUST.DATA.remitamt) #-cdouble(BANCS.INPUT.remitamt)
					MTT.PartTranDetails.Remarks = CUST.DATA.Ecstranrefnum # BANCS.INPUT.Ecstranrefnum  
					MTT.PartTranDetails.IgnoreExcp = "I"
					MTT.PartTranDetails.Consolidate = "N"
					MTT.PartTranDetails.TranIdentifier = "TCC"
					MTT.PartTranDetails.RateCode =  CUST.DATA.treaRate # BANCS.INPUT.treaRate

					if(CUST.DATA.trearefcode != "") THEN
					MTT.PartTranDetails.TreaRefNum=CUST.DATA.trearefcode
					MTT.PartTranDetails.TreaRate=CUST.DATA.treaRefNum					
					ENDIF

					sv_e = "DrLeg"
					sv_r = urhk_MTTS_definePartTran(sv_e)
					
												PRINT(sv_r)			
					#------------------------------------------------------------------
					# Cr Part MAIN AMOUNT
					#------------------------------------------------------------------
#					MTT.PartTranDetails.Account = "000000189110083"
					MTT.PartTranDetails.Account = CUST.DATA.suspacc# BANCS.INPUT.suspacc
					MTT.PartTranDetails.RefCurrency = CUST.DATA.tranccy # BANCS.INPUT.tranccy
					MTT.PartTranDetails.ValueDateDiff = "0"
					MTT.PartTranDetails.Particulars = CUST.DATA.tranrmks #  BANCS.INPUT.tranrmks
					MTT.PartTranDetails.RefAmount =cdouble(CUST.DATA.remitamt) #  cdouble(BANCS.INPUT.remitamt)
					MTT.PartTranDetails.Remarks = CUST.DATA.Ecstranrefnum # BANCS.INPUT.Ecstranrefnum				
					MTT.PartTranDetails.RefNum = ""
					MTT.PartTranDetails.IgnoreExcp = "I"
					MTT.PartTranDetails.Consolidate = "N"
					MTT.PartTranDetails.TranIdentifier = "TCC"
					MTT.PartTranDetails.RateCode = CUST.DATA.treaRate # BANCS.INPUT.treaRate

						if(CUST.DATA.trearefcode != "") THEN
#					MTT.PartTranDetails.TreaRefNum=CUST.DATA.trearefcode
#					MTT.PartTranDetails.RefNum =CUST.DATA.trearefcode
#					MTT.PartTranDetails.TreaRate=CUST.DATA.treaRefNum
						ENDIF

					MTT.PartTranDetails.tran_crncy_code ="CDF"


			BANCS.INPARAM.InputAmount =cdouble(CUST.DATA.remitamt) #cdouble(BANCS.INPUT.remitamt)
			BANCS.INPARAM.FromCurrency =  CUST.DATA.tranccy # BANCS.INPUT.tranccy
			BANCS.INPARAM.ToCurrency = "CDF"
			BANCS.INPARAM.RateCode = CUST.DATA.treaRate # BANCS.INPUT.treaRate
			BANCS.INPARAM.Rate = CDOUBLE("0.0")
			sv_f = urhk_B2k_ConvertAmount("")	
			sv_f = CDOUBLE(BANCS.OUTPARAM.OutputAmount)

					MTT.PartTranDetails.tran_amt =sv_f

					
					sv_h = "CrLeg"
					sv_u = urhk_MTTS_definePartTran(sv_h)
					PRINT(sv_u)
					#------------------------------
					sv_r = urhk_MTTS_EndDefinition("")
					PRINT(sv_r)
					sv_r = urhk_MTTS_Close("")
					PRINT(sv_r)
					
					IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
					#{
						PRINT(BANCS.OUTPARAM.MTTTranId)
					#}
					ENDIF
					
					
					
	EXITSCRIPT
	TRACE OFF
END-->

