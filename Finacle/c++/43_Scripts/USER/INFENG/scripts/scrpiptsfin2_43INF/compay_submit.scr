			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + LPAD(EQT.COMM.tTranId, 9, ' ') + "|" + EQT.COMM.tTranDate + "|" + BANCS.STDIN.contextBankId
