#-----------------------------------------------------------------
# Initialise is used to Check whether Class ATM exists.
# If not then creates that class.
# 5 stands for String Type data.
#-----------------------------------------------------------------

#####----------------------------------------------####
# Creating of  Repositories and Classes
#####----------------------------------------------####

IF(REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","ATM") == 0) THEN
#{
    CREATECLASS("CUST","ATM",5)
#}
ENDIF

CUST.ATM.Mainpayab=""
CUST.ATM.Mainexpen=""
CUST.ATM.Mainincome=""

	#################################################
	# Checking if the transaction exist 
	#################################################

	IF (BANCS.INPUT.Foracid!="") THEN
		print(BANCS.INPUT.Foracid)
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
		IF (sv_u != "0") THEN
		#{
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.ATM.solidsh = BANCS.OUTPARAM.acctSolId
			print(CUST.ATM.solidsh)
			CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
			print(CUST.ATM.schmcodesh)
			CUST.ATM.schmType = BANCS.OUTPARAM.schmType
			print(CUST.ATM.schmType)
		#}
		ENDIF
	ENDIF

	IF (BANCS.INPUT.CrForacid!="") THEN
		print(BANCS.INPUT.CrForacid)
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
		IF (sv_u != "0") THEN
		#{
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		#}
		ELSE
		#{
			CUST.ATM.solidshcr = BANCS.OUTPARAM.acctSolId
			print(CUST.ATM.solidshcr)
			CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
			print(CUST.ATM.schmcodesh)
			CUST.ATM.schmType = BANCS.OUTPARAM.schmType
			print(CUST.ATM.schmType)
			#IF (FIELDEXISTS(BANCS.INPUT.DeviceId) == 1) THEN
			#	CUST.ATM.solidshcr = mid$(BANCS.INPUT.DeviceId,0,3)
			#	print(CUST.ATM.solidshcr)
			#ENDIF
		#}
		ENDIF
	ENDIF
	IF (BANCS.INPUT.ReservedField2 !="") THEN
		CUST.ATM.bacid="EAZZYPAYINCOME"
		print(CUST.ATM.bacid)
		sv_s = "contra "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT foracid "
		sv_s = sv_s + " FROM GAM "
		sv_s = sv_s + " WHERE sol_id = ?SVAR "
		sv_s = sv_s + " AND bacid = ?SVAR "
		sv_s = sv_s + " AND del_flg ='N' "
		sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
		sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
		BANCS.INPARAM.BINDVARS = CUST.ATM.solidshcr + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
		print(sv_s)
		sv_d =urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == "0") THEN
			CUST.ATM.Mainincome= BANCS.OUTPARAM.contra
			print(CUST.ATM.Mainincome)
		ELSE
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		ENDIF
		IF (BANCS.INPUT.DccId=="TPG") THEN
			IF (BANCS.INPUT.ReservedField2=="PAYPALWD") THEN
				CUST.ATM.Mainincome = "0546500503470"
				print(CUST.ATM.Mainincome)
			ENDIF
		ENDIF
	ENDIF
	#------------------------------------------------------------------
	#  Getting fee amount
	#------------------------------------------------------------------

	IF (FIELDEXISTS(CUST.ATM.FeeAmountabs)) THEN
		print(CUST.ATM.FeeAmountabs)
		CUST.ATM.FeeAmount = CDOUBLE(CUST.ATM.FeeAmountabs)
		print(CUST.ATM.FeeAmount)
	ENDIF

	#---------------------------------------------------------
	# Getting contra account
	#---------------------------------------------------------
	IF ((BANCS.INPUT.Command == "TRTR") OR (BANCS.INPUT.Command == "TRTS")) THEN 

		CUST.ATM.CrAccount = CUST.ATM.Mainincome
		print(CUST.ATM.CrAccount)
		CUST.ATM.DrAccount = BANCS.INPUT.CrForacid
		print(CUST.ATM.DrAccount)
	ENDIF
	#--------------------------------------------------------------------------
	# Create the narration add reversal
	#--------------------------------------------------------------------------
	sv_e = mid$(BANCS.STDIN.BODDate,0,10)
	#print(sv_e)
	sv_s = "sysdate "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
	sv_s = sv_s + " FROM DUAL"
	BANCS.INPARAM.BINDVARS =  sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	#print(sv_d)
	IF (sv_d =="0") THEN
		CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
		IF (FIELDEXISTS(CUST.ATM.ReservedField3abs) == 1) THEN
			BANCS.INPUT.ReservedField3 = CUST.ATM.ReservedField3abs
			print(BANCS.INPUT.ReservedField3)
		ENDIF
		IF  ((BANCS.INPUT.Command == "TRTR") OR (BANCS.INPUT.Command == "TRTS"))  THEN
			CUST.ATM.narr1 ="EAZZYPAY-CHARGES" + "/" +BANCS.INPUT.ReservedField3 + "/" + CUST.ATM.sysdate
		ENDIF
		IF ((BANCS.INPUT.Command == "TRRR") OR (BANCS.INPUT.Command == "TRRR")) THEN
			CUST.ATM.narr1 ="REV EAZZYPAY-CHARGES" + "/" +BANCS.INPUT.ReservedField3 + "/" + CUST.ATM.sysdate
		ENDIF
		IF (BANCS.INPUT.DccId=="TPG") THEN
			IF  ((BANCS.INPUT.Command == "TRTR") OR (BANCS.INPUT.Command == "TRTS"))  THEN
				CUST.ATM.narr1 ="PAYPAL-CHARGES" + "/" +BANCS.INPUT.ReservedField3 + "/" + CUST.ATM.sysdate
			ENDIF
			IF ((BANCS.INPUT.Command == "TRRR") OR (BANCS.INPUT.Command == "TRRR")) THEN
				CUST.ATM.narr1 ="REV PAYPAL-CHARGES" + "/" +BANCS.INPUT.ReservedField3 + "/" + CUST.ATM.sysdate
			ENDIF
		ENDIF
	ELSE
		GOTO ENDOFSCRIPT
	ENDIF

	sv_s = "sysdateagt "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') "
	sv_s = sv_s + " FROM DUAL "
	BANCS.INPARAM.BINDVARS =  sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	#print(sv_d)
	IF (sv_d =="0") THEN
		CUST.ATM.sysdateagt = BANCS.OUTPARAM.sysdateagt
	ELSE
		GOTO ENDOFSCRIPT
	ENDIF

	###################################
	#  start Revarsal part
	#######################################

	
	IF (BANCS.INPUT.Command == "TRRR") THEN 

		sv_c = CUST.ATM.CrAccount
		print(sv_c)
		sv_k = CUST.ATM.DrAccount
		print(sv_k)
		CUST.ATM.CrAccount = sv_k
		print(CUST.ATM.CrAccount)
		CUST.ATM.DrAccount = sv_c
		print(CUST.ATM.DrAccount)
	ENDIF
	###################################
	#  End Revarsal part
	#######################################

	print(CUST.ATM.CrAccount)
	print(CUST.ATM.DrAccount)


# COPY REPO

call("copyBancsToCustC24.scr")

#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------

        sv_r = REPEXISTS("MTT")
        IF (sv_r == 0) THEN
                CREATEREP("MTT")
        ENDIF

        sv_r = CLASSEXISTS("MTT","TranDetails")
        IF (sv_r == 0) THEN
                CREATECLASS("MTT","TranDetails",5)
        ENDIF

	sv_r = CLASSEXISTS("MTT","PartTranDetails")
	IF (sv_r == 0) THEN
		CREATECLASS("MTT","PartTranDetails",5)
	ENDIF

        sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        ENDIF

        sv_r = CLASSEXISTS("BANCS","INPARAM")
        IF (sv_r == 0) THEN
                CREATECLASS("BANCS","INPARAM",5)
        ENDIF

        BANCS.INPARAM.PostTranFlg = "Y"
        BANCS.INPARAM.InsertTranWithValidnFlg = "N"
        BANCS.INPARAM.CommitFlg="N"
        BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
        BANCS.INPARAM.ErrorCheckForLuw="Y"
        BANCS.INPARAM.CheckExceptions="N"
        MTT.TranDetails.TranDate="0"
        MTT.TranDetails.TranType = "T"
        MTT.TranDetails.TranSubType = "CI"
        MTT.TranDetails.IgnoreExcp = "I"
        MTT.TranDetails.Consolidate = "N"
        MTT.TranDetails.Remarks = CUST.ATM.narr1

        sv_r = urhk_MTTS_Initialize("")
        #print(sv_r)

        sv_v = "CashBackComm"
        #print(sv_v)

        sv_u = urhk_MTTS_DefineTransaction("CashBackComm")

        sv_u = urhk_MTTS_PopulateInputDetails("")

	#--------------------------------------------------
        # Income To Branch A/c
        #--------------------------------------------------

                MTT.PartTranDetails.Account = CUST.ATM.CrAccount
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		#MTT.PartTranDetails.RateCode ="MEAN"
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.ATM.narr1
		MTT.PartTranDetails.Particulars2 = BANCS.INPUT.ReservedField3
                MTT.PartTranDetails.RefAmount = cdouble(CUST.ATM.FeeAmount)
                print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = BANCS.INPUT.ReservedField1
		print(BANCS.INPUT.CustCardId)
                MTT.PartTranDetails.RefNum = BANCS.INPUT.DeviceId
		print(BANCS.INPUT.DeviceId)
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_e = "CashBackIncome"
                sv_r = urhk_MTTS_definePartTran(sv_e)
		#print(sv_r)
		if (sv_r != 0) then
			CUST.ATM.Sucessfail1     = "N"
		ELSE
			CUST.ATM.Sucessfail1     = "Y"
		ENDIF

	#------------------------------------------------------------------
        # Debit Partran To Agent Pool A/C
        #------------------------------------------------------------------

                MTT.PartTranDetails.Account = CUST.ATM.DrAccount
                MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		#MTT.PartTranDetails.RateCode ="MEAN"
                MTT.PartTranDetails.ValueDateDiff = "0"
                MTT.PartTranDetails.Particulars = CUST.ATM.narr1
		MTT.PartTranDetails.Particulars2 = BANCS.INPUT.ReservedField3
                sv_a = cdouble(CUST.ATM.FeeAmount) 
		sv_a = -(sv_a)
		print(sv_a)
                MTT.PartTranDetails.RefAmount = sv_a
                print(MTT.PartTranDetails.RefAmount)
                MTT.PartTranDetails.Remarks = BANCS.INPUT.ReservedField1
		print(BANCS.INPUT.CustCardId)
		    MTT.PartTranDetails.TODRefType          = "BH"
		    MTT.PartTranDetails.TodEntityType   = "TODBH"
		    print(CUST.ATM.DrAccount)
		    MTT.PartTranDetails.TodEntityId     = CUST.ATM.DrAccount
		    MTT.PartTranDetails.TodLevIntFlg    = "N"
		    MTT.PartTranDetails.TodExpiryDate       = BANCS.STDIN.BODDate
		    MTT.PartTranDetails.TodPenalDate    = BANCS.STDIN.BODDate
		    MTT.PartTranDetails.TodPermittedBy  = BANCS.STDIN.userId
		    MTT.PartTranDetails.TodRemarks      = "Charges TOD"
		    MTT.PartTranDetails.Consolidate     = "N"
                MTT.PartTranDetails.RefNum = BANCS.INPUT.DeviceId
		print(BANCS.INPUT.DeviceId)
                MTT.PartTranDetails.IgnoreExcp = "I"
                MTT.PartTranDetails.Consolidate = "N"
                MTT.PartTranDetails.TranIdentifier = sv_v
                sv_h = "D" + CUST.ATM.DrAccount
                sv_u = urhk_MTTS_definePartTran(sv_h)
                sv_r = urhk_MTTS_EndDefinition("")
		#print(sv_r)
                sv_r = urhk_MTTS_Close("")
               #print(sv_r)

# COPY REPO
 call("copyCust24ToBancs.scr")

