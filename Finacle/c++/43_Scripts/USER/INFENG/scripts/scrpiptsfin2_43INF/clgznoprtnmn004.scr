<--START
CHECKSUM="6043fd418c00de3bf6e7fe24f580059644dbfb324cfb55bfca3daf86c111c5f3"
	TRACE ON
	
	#############################################################################
	#Custom Repository creation
	#############################################################################
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CLRREST") == 0) THEN
	#{
		CREATECLASS("CUST","CLRREST",5)
	#}
	ENDIF
	
	CUST.CLRREST.errMsg = ""
	CUST.CLRREST.zone1  = ""
	######################################################
	# Inputs from jsp
	######################################################
	print(BANCS.INPUT.zoneCode)
	sv_z = BANCS.INPUT.zoneCode
	
	BANCS.INPUT.moduleName="CLEARING"
	
	BANCS.INPUT.parameterId="ZONE_ALL"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CLRREST.zone1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.CLRREST.errMsg = "CPARAM set up not done for zone code ICLZ"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId="SOL_000"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CLRREST.headOffSol = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.CLRREST.headOffSol = ""
		CUST.CLRREST.errMsg = "CPARAM set up not done for head offc sol"
		GOTO FINISH
	#}
	ENDIF
	
	IF (BANCS.STDIN.homeSolId != CUST.CLRREST.headOffSol) THEN
	#{
		sv_w = getPosition(CUST.CLRREST.zone1,"|" +  sv_z + "|")
		IF ( sv_w > 0 ) THEN
		#{
			print("true")
			sv_u = urhk_SetOrbOut("paramV|Y")
		#}
		ENDIF
	#}
	ENDIF
	
	FINISH:
		IF (CUST.CLRREST.errMsg != "") THEN
		#{
			print("false2")
			sv_u = urhk_SetOrbOut("paramV|X")
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
