#}
ELSE
#{
	CUST.DATA.count =""
#}
ENDIF

IF (CUST.DATA.count =="0") THEN
#{

	CUST.DATA.errorMsg="Invalid Event Type or Event Id"
#	GOTO ERROR
#}
ENDIF



sv_s = ""
sv_s = sv_s + " count6|SELECT count(1) from C_HCUSTCRG_MOD "
sv_s = sv_s + " WHERE  CUST_LEVEL ='"+CUST.DATA.Level+"'"
sv_s = sv_s + " AND DEL_FLG !='Y' and EVENT_TYPE = '"+CUST.DATA.evtType+"' and EVENT_ID= '"+CUST.DATA.event_id+"'"

IF (CUST.DATA.Level == "C" ) THEN
#{
	sv_s = sv_s + "AND  CUST_ID= '"+CUST.DATA.cifId+"' "
#}
ENDIF

IF (CUST.DATA.Level == "A" ) THEN
#{
	sv_s = sv_s + "AND FORACID = '"+CUST.DATA.acctNum+"' "
#}
ENDIF

IF (CUST.DATA.Level == "AG" ) THEN
#{
	sv_s = sv_s + "AND AGREEMENT = '"+CUST.DATA.EmpId+"' "
#
ENDIF

print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF (sv_d == 0) THEN
#{
	PRINT(BANCS.OUTPARAM.count6)
	CUST.DATA.count1=BANCS.OUTPARAM.count6
	print(CUST.DATA.count1)
#}
ELSE
#{
	CUST.DATA.count1 =""
#}
ENDIF

sv_s = ""
sv_s = sv_s + " count2|SELECT count(1) from C_HCUSTCRG_MAIN "
sv_s = sv_s + " WHERE  CUST_LEVEL ='"+CUST.DATA.Level+"'"
sv_s = sv_s + " AND DEL_FLG !='Y' and EVENT_TYPE = '"+CUST.DATA.evtType+"' and EVENT_ID= '"+CUST.DATA.event_id+"'"

IF (CUST.DATA.Level == "C" ) THEN
#{
        sv_s = sv_s + "AND  CUST_ID= '"+CUST.DATA.cifId+"' "
#}
ENDIF

IF (CUST.DATA.Level == "A" ) THEN
#{
        sv_s = sv_s + "AND FORACID = '"+CUST.DATA.acctNum+"' "
#}
ENDIF

IF (CUST.DATA.Level == "AG" ) THEN
#{
        sv_s = sv_s + "AND AGREEMENT = '"+CUST.DATA.EmpId+"' "
#}
ENDIF

print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)
IF (sv_d == 0) THEN
#{
	CUST.DATA.count2=BANCS.OUTPARAM.count2
	print(CUST.DATA.count2)
#}
ELSE
#{
	CUST.DATA.count2 =""
#}
ENDIF

IF (CUST.DATA.funcCode == "V") THEN
#{
        IF (CUST.DATA.count1 == "0") THEN
        #{
                CUST.DATA.errorMsg="Nothing to  Verify"
                GOTO ERROR
        #}
        ENDIF
#}
ENDIF

IF (CUST.DATA.funcCode == "A") THEN
#{
        IF ((CINT(CUST.DATA.count1) > 0) or (CINT(CUST.DATA.count2) > 0)) THEN
        #{
                CUST.DATA.errorMsg="Record Already Exist"
                GOTO ERROR
        #}
        ENDIF
#}
ENDIF

IF (CUST.DATA.funcCode == "X") THEN
#{
        IF (CUST.DATA.count1 == "0") THEN
        #{
                CUST.DATA.errorMsg="Nothing To Cancel"
                GOTO ERROR
        #}
        ENDIF
#}
ENDIF

IF ((CUST.DATA.funcCode == "M") or (CUST.DATA.funcCode == "I")) THEN
#{
        IF(CUST.DATA.funcCode == "M") THEN
        #{
              IF ((CINT(CUST.DATA.count1) > 0)  and  (CINT(CUST.DATA.count2) > 0)) THEN
              #{
                      CUST.DATA.errorMsg="Verification Pending"
                      GOTO ERROR
              #}
              ENDIF 
              
        #}
        ENDIF 

        IF ((CINT(CUST.DATA.count1) > 0) or  (CUST.DATA.count2 == "0")) THEN
