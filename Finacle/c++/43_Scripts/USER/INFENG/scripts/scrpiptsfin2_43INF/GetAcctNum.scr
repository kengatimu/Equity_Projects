#=================================================
# script: GetAcctNum.scr
# event: NA
# description: To get account number during
#                               account opening.
#Input Value:
#BANCS.INPUT.acctPrefixNum
#BANCS.INPUT.schmCode
#BANCS.INPUT.schmType
#BANCS.INPUT.glSubHeadCode
#BANCS.INPUT.crncyCode
#BANCS.INPUT.cifId
#BANCS.INPUT.solId
#BANCS.INPUT.solAlias
#BANCS.INPUT.dcAlias
#BANCS.INPUT.acctType
#BANCS.INPUT.crncyAlias
#BANCS.INPUT.noOfAccts
#BANCS.INPUT.acctOwnership
#
#Output value:
#BANCS.OUTPUT.newForacid
# Changes done by Ankit Raj on 07-04-2018
#
#=================================================

<--start
trace on 
#==================================================
# Creation of Custom Repository
#==================================================
IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
#{
        CREATECLASS("CUST", "DATA", 5)
#}
ENDIF

	sv_a = CLASSEXISTS("BANCS", "CHKDGT")
	IF (sv_a == 0) THEN
	#{
		CREATECLASS("BANCS", "CHKDGT", 5)
	#}
	ENDIF

BANCS.CHKDGT.nextNum ="" 
BANCS.CHKDGT.ribKey = ""
BANCS.CHKDGT.tempAcct =""
BANCS.CHKDGT.IBANNumber =""
BANCS.CHKDGT.applyString =""

sv_a = urhk_B2k_PrintRepos("BANCS")

#If the foracid is passed as NULL, the existing logic of forming the account number from NNT will continue.
#The custom logic for account number needs to be put here.
#Account number should be unique for every execution.


PRINT(BANCS.INPUT.schmCode)
PRINT(BANCS.STDIN.contextBankId)
BANCS.OUTPUT.newForacid = ""
#this DB sequence logic only for scheme code LA527 and only for entity 54 
IF(BANCS.INPUT.schmCode == "LA527") THEN
#{
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.schmCode
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_a = "nextNum|SELECT DECODE(NEXT_ACCT_NUM_PREFIX,'EQBCA',LPAD(CUSTOM.FORACID_SEQ_EQABC_54.NEXTVAL,8,'0'),'') FROM TBAADM.GSP WHERE SCHM_CODE= ?SVAR AND BANK_ID= '54'"

	sv_b = urhk_dbSelectWithBind(sv_a)
	IF (sv_b == 0) THEN
	#{
        	CUST.DATA.nextNum = BANCS.OUTPARAM.nextNum
        	print(CUST.DATA.nextNum)
	#}
	ENDIF

	IF(CUST.DATA.nextNum != "") THEN
	#{
		BANCS.OUTPUT.newForacid = BANCS.INPUT.solId + "" + BANCS.INPUT.acctType + "" + CUST.DATA.nextNum
		PRINT(BANCS.OUTPUT.newForacid)
	#}
	ENDIF
#}
ENDIF

print(BANCS.INPUT.solId)


sv_a=strlen(BANCS.INPUT.solId)

if(sv_a <5 ) then
	BANCS.INPUT.solId="0"+BANCS.INPUT.solId
	print(BANCS.INPUT.solId)
Endif

	sv_a = "schm_type|SELECT schm_type FROM TBAADM.GSP WHERE SCHM_CODE= ?SVAR AND BANK_ID= '43' and rownum=1"
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.schmCode
	PRINT(BANCS.INPARAM.BINDVARS)

	sv_b = urhk_dbSelectWithBind(sv_a)
	IF (sv_b == 0) THEN
	#{
        	CUST.DATA.schmtype= BANCS.OUTPARAM.schm_type
        	print(CUST.DATA.schmtype)
		BANCS.INPUT.schmType =CUST.DATA.schmtype
	#}
	ENDIF


#IF((BANCS.INPUT.schmCode == "SB700") or (BANCS.INPUT.schmCode == "SB777") and (BANCS.INPUT.acctPrefixNum=="EQACA"))  THEN

IF((BANCS.INPUT.schmType == "SBA") or (BANCS.INPUT.schmType == "CAA")) THEN
	BANCS.INPUT.seq =cint(BANCS.INPUT.noOfAccts) +1
	print(BANCS.INPUT.seq)
	
#
	sv_a = "nextNum|SELECT CUSTOM.FORACID_SEQ_ECBEQBK_43.NEXTVAL FROM DUAL "
	sv_b = urhk_dbSelectWithBind(sv_a)
	IF (sv_b == 0) THEN
	#{
        	BANCS.INPUT.seq = BANCS.OUTPARAM.nextNum
        	print(BANCS.INPUT.seq)
	#}
	ENDIF

#

	BANCS.INPUT.seq = LPAD(BANCS.INPUT.seq, 9, '0')
	PRINT(BANCS.INPUT.seq)
	BANCS.INPUT.nextNum=BANCS.INPUT.seq

		BANCS.INPUT.BankId ="00011"   
		BANCS.INPUT.BankSolId=BANCS.INPUT.solId
		BANCS.INPUT.NewacctNum=MID$(BANCS.INPUT.BankSolId, 3, 2) +""+MID$(BANCS.INPUT.BankSolId, 4, 1) + "" + BANCS.INPUT.acctType + "" + BANCS.INPUT.seq
		BANCS.INPUT.NewacctNum1=MID$(BANCS.INPUT.BankSolId, 4, 1)  + "" + BANCS.INPUT.acctType + "" + BANCS.INPUT.seq
		print(BANCS.INPUT.NewacctNum1)
	print(MID$(BANCS.INPUT.BankSolId, 4, 1))
	print(MID$(BANCS.INPUT.BankSolId, 3, 2))


	PRINT(BANCS.INPUT.NewacctNum)

   	sv_s = "IBANChk|select 97-( mod( "
	sv_s= sv_s+ "((89* ?SVAR) +  (15 * ?SVAR) + (3 * ?SVAR)) "
	sv_s= sv_s+ "   ,97)) from dual "

		BANCS.INPARAM.BINDVARS = BANCS.INPUT.BankId  + "|" + BANCS.INPUT.BankSolId + "|" +BANCS.INPUT.NewacctNum1
		print(BANCS.INPARAM.BINDVARS)

	sv_q = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_q!=0) THEN
	#{
		BANCS.OUTPUT.message= "Unable to Perform Mod Operation"
		PRINT(BANCS.OUTPUT.message)
		BANCS.OUTPUT.successOrFailure = "N"
		#}
	ELSE
		#{
		BANCS.OUTPUT.IBANChk=BANCS.OUTPARAM.IBANChk
		BANCS.OUTPUT.IBANChk = LPAD(BANCS.OUTPUT.IBANChk, 2, '0')
		PRINT (BANCS.OUTPUT.IBANChk)
		BANCS.OUTPUT.ribKey=BANCS.OUTPUT.IBANChk

	#}
	ENDIF

	BANCS.OUTPUT.newForacid=BANCS.INPUT.NewacctNum+ "" + BANCS.OUTPUT.IBANChk

	PRINT(BANCS.OUTPUT.newForacid)
	PRINT(BANCS.INPUT.BankId)
	PRINT(BANCS.INPUT.BankSolId)
	PRINT(BANCS.OUTPUT.newForacid)

	sv_u = urhk_getAcctDetailsInRepository(BANCS.OUTPUT.newForacid)
	IF (sv_u == 0) THEN
		BANCS.CHKDGT.MGS  = "FORACID EXIST"
		print(BANCS.CHKDGT.MGS)
	ENDIF
	

BANCS.OUTPUT.newIban= BANCS.INPUT.BankId + "" + BANCS.INPUT.BankSolId +""+MID$(BANCS.INPUT.BankSolId, 5, 1) + "" +  BANCS.INPUT.NewacctNum1 + "" + BANCS.OUTPUT.IBANChk

print(BANCS.OUTPUT.newIban)


print(BANCS.INPUT.nextNum)
print(BANCS.OUTPUT.IBANChk)

BANCS.CHKDGT.nextNum=	BANCS.INPUT.nextNum
BANCS.CHKDGT.ribKey = BANCS.OUTPUT.IBANChk
BANCS.CHKDGT.tempAcct =BANCS.OUTPUT.newIban
BANCS.CHKDGT.IBANNumber=BANCS.OUTPUT.newIban
BANCS.INPUT.applyString =  BANCS.INPUT.nextNum

	BANCS.OUTPUT.successOrFailure = "S"
	BANCS.OUTPUT.nextNum = BANCS.CHKDGT.nextNum
	BANCS.OUTPUT.checkDigit = BANCS.CHKDGT.ribKey
	BANCS.OUTPUT.applyString = BANCS.INPUT.applyString
	PRINT(BANCS.OUTPUT.nextNum)
	PRINT(BANCS.OUTPUT.checkDigit)
	PRINT(BANCS.OUTPUT.applyString)

	sv_g =MID$(BANCS.STDIN.mySolId,2,3) +  BANCS.INPUT.acctType + BANCS.CHKDGT.nextNum
	print (sv_g )
	BANCS.OUTPUT.applyString = sv_g
	BANCS.INPUT.applyString  = sv_g
	BANCS.CHKDGT.applyString = sv_g


ENDIF
#=======================================================================
#REPOSITORY DELETION
#=======================================================================

IF (REPEXISTS("CUST") != 0) THEN
#{
        DELETEREP("CUST")
#}
ENDIF

exitScript
trace off
end-->





















