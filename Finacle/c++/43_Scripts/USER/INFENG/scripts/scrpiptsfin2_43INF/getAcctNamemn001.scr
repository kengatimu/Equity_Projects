<--START
CHECKSUM="40f7745e5d77e16afb5a7b609aad9ae9fb0c25f1df59a164d578d6b0e3fc12a7"
	#TRACE ON
	LIBNAME GETMMSG
	#-------------------------------------------------------------------------------
	# SECTION: Creation of Repository and Class
	#-------------------------------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	lv_r = CLASSEXISTS("CUST","SVSINBOUND")
	IF (lv_r == 0) THEN
	#{
		CREATECLASS("CUST","SVSINBOUND",5)
	#}
	ENDIF
	
	lv_r = CLASSEXISTS("CUST","SVSOUTBOUND")
	IF (lv_r == 0) THEN
	#{
		CREATECLASS("CUST","SVSOUTBOUND",5)
	#}
	ENDIF
	#sv_a = urhk_B2k_PrintRepos("BANCS")
	
	CUST.SVSINBOUND.bankId  = BANCS.STDIN.contextBankId
	
	IF(FIELDEXISTS(("BANCS").("INPUT").("ReqVal")) != 0) THEN
	#{
		CUST.SVSINBOUND.acctId = ("BANCS").("INPUT").("ReqVal")
		print(CUST.SVSINBOUND.acctId)
		#}
	ELSE
		#{
		CUST.SVSINBOUND.acctId = "0"
		print(CUST.SVSINBOUND.acctId)
	#}
	ENDIF
	
	####################################################################################
	# Validating the Event Type for its existence.
	####################################################################################
	
	BANCS.INPARAM.BINDVARS = CUST.SVSINBOUND.acctId + "|" + CUST.SVSINBOUND.bankId
	
	sv_q = "acctName|"
	sv_q = sv_q + " SELECT ACCT_NAME "
	sv_q = sv_q + " FROM   TBAADM.GAM "
	sv_q = sv_q + " WHERE  FORACID = ?SVAR "
	sv_q = sv_q + " AND    BANK_ID  = ?SVAR "
	sv_q = sv_q + " AND    DEL_FLG  = 'N'"
	sv_q = sv_q + " AND    ENTITY_CRE_FLG  = 'Y'"
	print(sv_q)
	sv_r = urhk_dbSelectWithBind(sv_q)
	
	IF(sv_r == "0") THEN
	#{
		CUST.SVSOUTBOUND.acctName = BANCS.OUTPARAM.acctName
		#}
	ELSE
		#{
		CUST.SVSOUTBOUND.acctName = "Account Does Not Exist"
	#}
	ENDIF
	
	sv_r = urhk_SetOrbOut("AcctName|" + CUST.SVSOUTBOUND.acctName)
	
	
	#TRACE OFF
END-->
