		CUST.CIETXN.tranAmt = " "
		CUST.CIETXN.tranAmtCcy = " "
		
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.CIETXN.errorFlg)
