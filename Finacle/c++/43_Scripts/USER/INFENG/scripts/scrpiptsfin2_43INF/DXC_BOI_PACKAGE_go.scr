########################################################################################################################

<--START
TRACE ON

	#----------------------------------------------------------------------
	# Create the necessary repos and classes
	#----------------------------------------------------------------------
	
	IF (REPEXISTS("PACKAGE") == 0 ) THEN
	#{
		CREATEREP("PACKAGE")
	#}
	ENDIF
	IF (CLASSEXISTS("PACKAGE","DATA") == 0) THEN
	#{
		CREATECLASS("PACKAGE","DATA",5)
	#}
	ENDIF

	#----------------------------------------------------------------------
	#Printing Bancs Repository
	#----------------------------------------------------------------------
	
	sv_a = urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_a)

	#----------------------------------------------------------------------
	#Variable Initialization
	#---------------------------------------------------------------------

	PACKAGE.DATA.error           	= ""
        PACKAGE.DATA.errorFocus      	= "dummy"
	PACKAGE.DATA.packageDesc     	= ""
	PACKAGE.DATA.product1        	= ""
	PACKAGE.DATA.product2  		= ""
	PACKAGE.DATA.product3          	= ""
	PACKAGE.DATA.product4 		= ""
	PACKAGE.DATA.product5         	= ""
	PACKAGE.DATA.product6           = ""
        PACKAGE.DATA.product7           = ""
        PACKAGE.DATA.product8           = ""
        PACKAGE.DATA.product9           = ""
        PACKAGE.DATA.product10          = ""
	PACKAGE.DATA.schmCode1		= ""
	PACKAGE.DATA.schmCode2		= ""
	PACKAGE.DATA.schmCode3          = ""
	PACKAGE.DATA.schmCode4          = ""
	PACKAGE.DATA.schmCode5          = ""
	PACKAGE.DATA.schmCode6          = ""
	PACKAGE.DATA.schmCode7          = ""
	PACKAGE.DATA.schmCode8          = ""
	PACKAGE.DATA.schmCode9          = ""
	PACKAGE.DATA.schmCode10          = ""
	PACKAGE.DATA.packagePrising     = ""
	PACKAGE.DATA.value1		= ""
	PACKAGE.DATA.value2		= ""	
	PACKAGE.DATA.modTableCount	= "0"
	PACKAGE.DATA.mainTableCount	= "0"
	
	#=================================================================
	# Fetching fields from front end
	#=================================================================
		
         PACKAGE.DATA.funcCode = BANCS.INPUT.funcCode
         print(PACKAGE.DATA.funcCode)

	 PACKAGE.DATA.packageCode = BANCS.INPUT.packageCode
         print(PACKAGE.DATA.packageCode)

	 PACKAGE.DATA.userId = BANCS.STDIN.userId
         print(PACKAGE.DATA.userId)
	
	#---------------------------------------------
	#	Fetching table counts
	#---------------------------------------------

	sv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_PACKAGE_DATA WHERE PACKAGE_CODE = ?SVAR AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
	PRINT(sv_q)

	BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	sv_u = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_u)

	IF(sv_u == "0") THEN
	#{
		PACKAGE.DATA.mainTableCount = BANCS.OUTPARAM.mainTableCount
		PRINT(PACKAGE.DATA.mainTableCount)
	#}
	ENDIF

	sv_q = "modTableCount|SELECT COUNT(1) FROM CUSTOM.C_PACKAGE_MOD WHERE PACKAGE_CODE = ?SVAR AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
	PRINT(sv_q)

	BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	sv_u = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_u)

	IF(sv_u == "0") THEN
	#{
		PACKAGE.DATA.modTableCount = BANCS.OUTPARAM.modTableCount
		PRINT(PACKAGE.DATA.modTableCount)
	#}
	ENDIF
	
	#=================================================================
        #       Basic Validation
        #=================================================================

	IF (PACKAGE.DATA.funcCode == "A") THEN
        #{
		IF(CDOUBLE(PACKAGE.DATA.modTableCount) > 0) THEN	
		#{
			PACKAGE.DATA.error      = "Record already exists and pending verification."
			PACKAGE.DATA.errorFocus = "funcCode"
			GOTO ERROR
		#}
		ENDIF

		IF(CDOUBLE(PACKAGE.DATA.mainTableCount) > 0) THEN	
		#{
			PACKAGE.DATA.error      = "Record already exists, Only can Modify"
			PACKAGE.DATA.errorFocus = "funcCode"
			GOTO ERROR
		#}
		ENDIF
        #}
        ENDIF

	IF(PACKAGE.DATA.funcCode=="V") THEN
        #{
                BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

                sv_x="rcreuser,del_flg,entity_cre_flg|select rcre_user_id,del_flg,entity_cre_flg,package_code from CUSTOM.C_PACKAGE_MOD where PACKAGE_CODE= ?SVAR "
                sv_x = sv_x + " and del_flg='N' and entity_cre_flg='N' AND BANK_ID = ?SVAR and rownum<2 "
                print(sv_x)
                sv_d=urhk_dbselectWithBind(sv_x)
                PRINT(sv_d)

                IF(sv_d==0) THEN
                #{
                        PACKAGE.DATA.rcreuser=BANCS.OUTPARAM.rcreuser
                        PACKAGE.DATA.del_flg=BANCS.OUTPARAM.del_flg
                        PACKAGE.DATA.entity_cre_flg=BANCS.OUTPARAM.entity_cre_flg

                #}
                ELSE
                #{
                         PACKAGE.DATA.error = "No records found"
                         PACKAGE.DATA.erroFocus = "funcCode"
                         GOTO ERROR
                #}
                ENDIF

                  IF(PACKAGE.DATA.rcreuser==PACKAGE.DATA.userId) THEN
                #{
                        PACKAGE.DATA.error = "Same user cannot verify"
                        PACKAGE.DATA.erroFocus = "funcCode"
                        GOTO ERROR

                #}
                ENDIF

        #}
        ENDIF	


	#=================================================================
        #      VERIFY AND CANCEL Block
        #=================================================================
	
	IF((PACKAGE.DATA.funcCode == "V") OR (PACKAGE.DATA.funcCode == "X"))THEN
	#{
		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

                sv_s = ""
                sv_s = sv_s + "packagedesc,product1,product2,product3,product4,product5,product6,product7,product8,product9,product10,schmCode1,schmCode2,schmCode3,"
		sv_s = sv_s + "schmCode4,schmCode5,schmCode6,schmCode7,schmCode8,schmCode9,schmCode10,packageprising,value1,value2|"
                sv_s = sv_s + "SELECT PACKAGE_DESC,PRODUCT_1,PRODUCT_2,PRODUCT_3,PRODUCT_4,PRODUCT_5,PRODUCT_6,PRODUCT_7,PRODUCT_8,PRODUCT_9,PRODUCT_10, "
                sv_s = sv_s + " SCHMCODE_1,SCHMCODE_2,SCHMCODE_3,SCHMCODE_4,SCHMCODE_5,SCHMCODE_6,SCHMCODE_7,SCHMCODE_8,SCHMCODE_9,SCHMCODE_10,"
		sv_s = sv_s + " PACKAGE_PRISING,AMT_VALUE,PERCENT_VALUE FROM CUSTOM.C_PACKAGE_MOD  "
                sv_s = sv_s + " where PACKAGE_CODE = ?SVAR AND ENTITY_CRE_FLG = 'N' AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
                PRINT(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
                PRINT(sv_d)

                IF (sv_d == 0) THEN
                #{
                        PACKAGE.DATA.packageDesc = BANCS.OUTPARAM.packagedesc
                        print(PACKAGE.DATA.packageCode)
                        PACKAGE.DATA.product1 = BANCS.OUTPARAM.product1
                        PACKAGE.DATA.product2 = BANCS.OUTPARAM.product2
                        PACKAGE.DATA.product3 = BANCS.OUTPARAM.product3
                        PACKAGE.DATA.product4 = BANCS.OUTPARAM.product4
                        PACKAGE.DATA.product5 = BANCS.OUTPARAM.product5
			PACKAGE.DATA.product6 = BANCS.OUTPARAM.product6
                        PACKAGE.DATA.product7 = BANCS.OUTPARAM.product7
                        PACKAGE.DATA.product8 = BANCS.OUTPARAM.product8
                        PACKAGE.DATA.product9 = BANCS.OUTPARAM.product9
                        PACKAGE.DATA.product10 = BANCS.OUTPARAM.product10	
			PACKAGE.DATA.schmCode1 = BANCS.OUTPARAM.schmCode1	
			PACKAGE.DATA.schmCode2	= BANCS.OUTPARAM.schmCode2
			PACKAGE.DATA.schmCode3	= BANCS.OUTPARAM.schmCode3
			PACKAGE.DATA.schmCode4	= BANCS.OUTPARAM.schmCode4
			PACKAGE.DATA.schmCode5	= BANCS.OUTPARAM.schmCode5
			PACKAGE.DATA.schmCode6	= BANCS.OUTPARAM.schmCode6
			PACKAGE.DATA.schmCode7	= BANCS.OUTPARAM.schmCode7
			PACKAGE.DATA.schmCode8	= BANCS.OUTPARAM.schmCode8
			PACKAGE.DATA.schmCode9	= BANCS.OUTPARAM.schmCode9
			PACKAGE.DATA.schmCode10	= BANCS.OUTPARAM.schmCode10
			PACKAGE.DATA.packagePrising = BANCS.OUTPARAM.packageprising
			PACKAGE.DATA.value1	= BANCS.OUTPARAM.value1
			print(PACKAGE.DATA.value1)
			PACKAGE.DATA.value2	= BANCS.OUTPARAM.value2
			print(PACKAGE.DATA.value2)
			print(PACKAGE.DATA.packagePrising)	
		#}
		ELSE
		#{
			IF(CDOUBLE(PACKAGE.DATA.mainTableCount) > 0) THEN	
			#{
				PACKAGE.DATA.error      = "There is nothing to verify or cancel."
				PACKAGE.DATA.errorFocus = "funcCode"
				GOTO ERROR
			#}
			ELSE
			#{
				PACKAGE.DATA.error      = "Record is not found for the given criteria."
				PACKAGE.DATA.errorFocus = "acctId"
				GOTO ERROR
			#}
			ENDIF
		#}
		ENDIF

	#}
	ENDIF
	
	#---------------------------------------------
	#	Inquire and Modify block
	#---------------------------------------------

	IF((PACKAGE.DATA.funcCode == "M") OR (PACKAGE.DATA.funcCode == "I"))THEN
	#{
		IF(PACKAGE.DATA.funcCode != "I") THEN
		#{
			IF(CDOUBLE(PACKAGE.DATA.modTableCount) > 0) THEN	
			#{
				PACKAGE.DATA.error      = "Record modified, Verification is pending"
				PACKAGE.DATA.errorFocus = "funcCode"
				GOTO ERROR
			#}
			ENDIF
			
		#}
		ENDIF	

		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_s = ""
		sv_s = sv_s + "packagedesc,product1,product2,product3,product4,product5,product6,product7,product8,product9,product10,"
		sv_s = sv_s + "schmCode1,schmCode2,schmCode3,schmCode4,schmCode5,schmCode6,schmCode7,schmCode8,schmCode9,schmCode10,packageprising,value1,value2|"
		sv_s = sv_s + "SELECT PACKAGE_DESC,PRODUCT_1,PRODUCT_2,PRODUCT_3,PRODUCT_4,PRODUCT_5,PRODUCT_6,PRODUCT_7,PRODUCT_8,PRODUCT_9,PRODUCT_10,"
		sv_s = sv_s + "SCHMCODE_1,SCHMCODE_2,SCHMCODE_3,SCHMCODE_4,SCHMCODE_5,SCHMCODE_6,SCHMCODE_7,SCHMCODE_8,SCHMCODE_9,SCHMCODE_10,"
		sv_s = sv_s + " PACKAGE_PRISING,AMT_VALUE,PERCENT_VALUE FROM CUSTOM.C_PACKAGE_DATA  "
		sv_s = sv_s + "where PACKAGE_CODE = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND BANK_ID = ?SVAR"
		PRINT(sv_s)

		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)

		IF (sv_d == 0) THEN
		#{
			PACKAGE.DATA.packageDesc = BANCS.OUTPARAM.packagedesc
			print(PACKAGE.DATA.packageCode)
			PACKAGE.DATA.product1 = BANCS.OUTPARAM.product1
			PACKAGE.DATA.product2 = BANCS.OUTPARAM.product2
			PACKAGE.DATA.product3 = BANCS.OUTPARAM.product3
			PACKAGE.DATA.product4 = BANCS.OUTPARAM.product4
			PACKAGE.DATA.product5 = BANCS.OUTPARAM.product5
			PACKAGE.DATA.product6 = BANCS.OUTPARAM.product6
                        PACKAGE.DATA.product7 = BANCS.OUTPARAM.product7
                        PACKAGE.DATA.product8 = BANCS.OUTPARAM.product8
                        PACKAGE.DATA.product9 = BANCS.OUTPARAM.product9
                        PACKAGE.DATA.product10 = BANCS.OUTPARAM.product10
                       	PACKAGE.DATA.schmCode1 = BANCS.OUTPARAM.schmCode1
                        PACKAGE.DATA.schmCode2  = BANCS.OUTPARAM.schmCode2
                        PACKAGE.DATA.schmCode3  = BANCS.OUTPARAM.schmCode3
                        PACKAGE.DATA.schmCode4  = BANCS.OUTPARAM.schmCode4
                        PACKAGE.DATA.schmCode5  = BANCS.OUTPARAM.schmCode5
                        PACKAGE.DATA.schmCode6  = BANCS.OUTPARAM.schmCode6
                        PACKAGE.DATA.schmCode7  = BANCS.OUTPARAM.schmCode7
                        PACKAGE.DATA.schmCode8  = BANCS.OUTPARAM.schmCode8
                        PACKAGE.DATA.schmCode9  = BANCS.OUTPARAM.schmCode9
                        PACKAGE.DATA.schmCode10 = BANCS.OUTPARAM.schmCode10 
			PACKAGE.DATA.packagePrising = BANCS.OUTPARAM.packageprising
			PACKAGE.DATA.value1     = BANCS.OUTPARAM.value1
			print(PACKAGE.DATA.value1)
                        PACKAGE.DATA.value2     = BANCS.OUTPARAM.value2
			print(PACKAGE.DATA.value2)
		#}
		ELSE
		#{
			PACKAGE.DATA.error      = "Record does not exists."
			PACKAGE.DATA.errorFocus = "acctId"
			GOTO ERROR
		#}
		ENDIF
	#}
	ENDIF	

        #---------------------------------------------
        #       Amount formating
        #---------------------------------------------

                BANCS.INPARAM.BINDVARS = PACKAGE.DATA.value1 +"|"+ PACKAGE.DATA.value2
                print(BANCS.INPARAM.BINDVARS)

                sv_z = "value1,value2|SELECT REPLACE(?SVAR,'.',','),REPLACE(?SVAR,'.',',') FROM DUAL"
                print(sv_z)

                sv_q = urhk_dbSelectWithBind(sv_z)
                print(sv_q)

                IF(sv_q ==0) THEN
                #{
                        PACKAGE.DATA.value1 = BANCS.OUTPARAM.value1
                        print(PACKAGE.DATA.value1)
                        PACKAGE.DATA.value2 = BANCS.OUTPARAM.value2
                        print(PACKAGE.DATA.value2)
                #}
                ENDIF

	#------------------------------------------------------
        # Setting the values to detail page
        #------------------------------------------------------

         sv_a = urhk_setOrbOut("packageDesc| "        + PACKAGE.DATA.packageDesc)
         sv_a = urhk_setOrbOut("product1| "           + PACKAGE.DATA.product1)
         sv_a = urhk_setOrbOut("product2| "           + PACKAGE.DATA.product2)
         sv_a = urhk_setOrbOut("product3| "           + PACKAGE.DATA.product3)
         sv_a = urhk_setOrbOut("product4| "           + PACKAGE.DATA.product4)
         sv_a = urhk_setOrbOut("product5| "           + PACKAGE.DATA.product5)
	 sv_a = urhk_setOrbOut("product6| "           + PACKAGE.DATA.product6)
         sv_a = urhk_setOrbOut("product7| "           + PACKAGE.DATA.product7)
         sv_a = urhk_setOrbOut("product8| "           + PACKAGE.DATA.product8)
         sv_a = urhk_setOrbOut("product9| "           + PACKAGE.DATA.product9)
         sv_a = urhk_setOrbOut("product10| "           + PACKAGE.DATA.product10)      	 
	 sv_a = urhk_setOrbOut("schmCode1| "           + PACKAGE.DATA.schmCode1)
	 sv_a = urhk_setOrbOut("schmCode2| "           + PACKAGE.DATA.schmCode2)
	 sv_a = urhk_setOrbOut("schmCode3| "           + PACKAGE.DATA.schmCode3)
	 sv_a = urhk_setOrbOut("schmCode4| "           + PACKAGE.DATA.schmCode4)
	 sv_a = urhk_setOrbOut("schmCode5| "           + PACKAGE.DATA.schmCode5)
	 sv_a = urhk_setOrbOut("schmCode6| "           + PACKAGE.DATA.schmCode6)
	 sv_a = urhk_setOrbOut("schmCode7| "           + PACKAGE.DATA.schmCode7)
	 sv_a = urhk_setOrbOut("schmCode8| "           + PACKAGE.DATA.schmCode8)
	 sv_a = urhk_setOrbOut("schmCode9| "           + PACKAGE.DATA.schmCode9)
	 sv_a = urhk_setOrbOut("schmCode10| "           + PACKAGE.DATA.schmCode10)	 
	sv_a = urhk_setOrbOut("packagePrising| "           + PACKAGE.DATA.packagePrising)
	 sv_a = urhk_setOrbOut("value1| "           + PACKAGE.DATA.value1)
	 sv_a = urhk_setOrbOut("value2| "           + PACKAGE.DATA.value2)	 
	GOTO SUCCESS

Success:

	 sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
         EXITSCRIPT



ERROR:
        sv_x=urhk_SetOrbOut("Error_0|Error^" + PACKAGE.DATA.error  + "^" +PACKAGE.DATA.errorFocus)
        sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
        EXITSCRIPT


EXITSCRIPT

TRACE OFF
END-->
