<--START
	# Script body goes here
	TRACE ON
	IF (REPEXISTS("EQT") == 0) THEN
	#{
		CREATEREP("EQT")
	#}
	ENDIF
	
	IF (CLASSEXISTS("EQT","SICHRG") == 0) THEN
	#{
		CREATECLASS("EQT","SICHRG",5)
	#}
	ENDIF
	
	EQT.SICHRG.errFlg = "N"
	EQT.SICHRG.errMsg = " "
	EQT.SICHRG.addrs1 = " "
	EQT.SICHRG.addrs2 = " "
	EQT.SICHRG.addrs3 = " "
	EQT.SICHRG.cntryCode = " "
	EQT.SICHRG.acctId = " "
	EQT.SICHRG.cifId = " "
	
        IF(FIELDEXISTS(BANCS.INPUT.acctId))THEN
        #{
                IF(TRIM(BANCS.INPUT.acctId) != "")THEN
                #{
                        EQT.SICHRG.acctId = TOUPPER(TRIM(BANCS.INPUT.acctId))
                        print(EQT.SICHRG.acctId)
                #}
		ELSE
		#{
                	EQT.SICHRG.errFlg = "N"
                	EQT.SICHRG.errMsg = " "
                	GOTO ENDOFSCRIPT
		#}	
                ENDIF
	ELSE
	#{
               	EQT.SICHRG.errFlg = "N"
               	EQT.SICHRG.errMsg = " "
               	GOTO ENDOFSCRIPT
        #}
        ENDIF

	
	#------------------------------------------------#
	sv_s = "cifId|select cif_id from tbaadm.gam where bank_id=?SVAR and foracid=?SVAR"

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ EQT.SICHRG.acctId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		EQT.SICHRG.cifId = BANCS.OUTPARAM.cifId
		PRINT(EQT.SICHRG.cifId)
	#}
	ENDIF

	#------------------------------------------------#
	sv_s = "addrs1,addrs2,addrs3,cntryCode,name|select address_line1,address_line2,address_line3,country_code,name from crmuser.address where addresscategory = ("
	sv_s = sv_s + "select address_type from tbaadm.cmg where bank_id=?SVAR and cif_id=?SVAR) and bank_id=?SVAR and orgkey=?SVAR"

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ EQT.SICHRG.cifId +"|"+ BANCS.STDIN.contextBankId +"|"+ EQT.SICHRG.cifId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		EQT.SICHRG.addrs1 = BANCS.OUTPARAM.addrs1
		PRINT(EQT.SICHRG.addrs1)
		EQT.SICHRG.addrs2 = BANCS.OUTPARAM.addrs2
		PRINT(EQT.SICHRG.addrs2)
		EQT.SICHRG.addrs3 = BANCS.OUTPARAM.addrs3
		PRINT(EQT.SICHRG.addrs3)
		EQT.SICHRG.cntryCode = BANCS.OUTPARAM.cntryCode
		PRINT(EQT.SICHRG.cntryCode)
		EQT.SICHRG.name = BANCS.OUTPARAM.name
		PRINT(EQT.SICHRG.name)
		#}
	ELSE
		#{
		EQT.SICHRG.errFlg = "Y"
		EQT.SICHRG.errMsg = "Address Details Not available for Remitter"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		print(EQT.SICHRG.errMsg)
		sv_u = urhk_SetOrbOut("errFlg|"+EQT.SICHRG.errFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("errMsg|"+EQT.SICHRG.errMsg)
		PRINT(sv_u)

                IF(TRIM(EQT.SICHRG.addrs1) == "")THEN
                #{
                        EQT.SICHRG.addrs1 = " "
                #}
                ENDIF

                IF(TRIM(EQT.SICHRG.addrs2) == "")THEN
                #{
                        EQT.SICHRG.addrs2 = " "
                #}
                ENDIF

                IF(TRIM(EQT.SICHRG.addrs3) == "")THEN
                #{
                        EQT.SICHRG.addrs3 = " "
                #}
                ENDIF

                IF(TRIM(EQT.SICHRG.cntryCode) == "")THEN
                #{
                        EQT.SICHRG.cntryCode = " "
                #}
                ENDIF

                IF(TRIM(EQT.SICHRG.name) == "")THEN
                #{
                        EQT.SICHRG.name = " "
                #}
                ENDIF

		sv_u = urhk_SetOrbOut("addrs1|"+EQT.SICHRG.addrs1)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("addrs2|"+EQT.SICHRG.addrs2)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("addrs3|"+EQT.SICHRG.addrs3)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("cntryCode|"+EQT.SICHRG.cntryCode)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("name|"+EQT.SICHRG.name)
		PRINT(sv_u)
		
TRACE OFF
END-->
