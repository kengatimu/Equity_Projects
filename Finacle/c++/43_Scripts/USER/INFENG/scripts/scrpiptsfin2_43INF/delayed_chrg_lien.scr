			sv_s = CUST.CHRG.acct+ "|" + "More than one similar lien,Lien Operation failed"
			PRINT(sv_s)
			sv_b = urtn_fileWrite(CUST.CHRG.failFileIndex1 + "|" + sv_s)
			PRINT(sv_b)
			GOTO ENDOFSCRIPT_LIEN_MOD
		#}
		ENDIF
	#}
	ENDIF
	
	#----------------------Query for choice of ADD or MODIFY Operation ---------------#
	BANCS.INPARAM.BINDVARS = CUST.CHRG.acid + "|" + BANCS.STDIN.contextBankId
	sv_a = "count|select count(*) from tbaadm.alt where acid = ?SVAR AND b2k_type='ULIEN' AND BANK_ID= ?SVAR"
	PRINT(sv_a)
	
	sv_s = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_s)
	IF (sv_s !=0) THEN
	#{
		CUST.CHRG.LienSuccessOrFailure = "F"
		CUST.CHRG.LienFailureReason = "Query to fetch count of lien record details of normal lien ON ALT table failed"
		sv_s = CUST.CHRG.acct+ "|" + "Query to fetch count of lien record details of normal lien ON ALT table failed"
		PRINT(sv_s)
		sv_b = urtn_fileWrite(CUST.CHRG.failFileIndex1 + "|" + sv_s)
		PRINT(sv_b)
		
		GOTO ENDOFSCRIPT_LIEN_MOD
	#}
	ENDIF
	
	CUST.CHRG.NewRecNum = BANCS.OUTPARAM.count
	PRINT(CUST.CHRG.NewRecNum)
	
	IF (CINT(CUST.CHRG.NewRecNum) > 0) THEN
	#{
		#The query to decide whether a lien record needs to be modified or a new lien
		#has to be added
		BANCS.INPARAM.BINDVARS = CUST.CHRG.acid + "|" +CUST.CHRG.reasonCode + "|" +  CUST.CHRG.lienRemarks + "|" + BANCS.STDIN.contextBankId
		sv_a = "b2kid,b2ktype,expdate,startdate,lienamt,altCrncyCode|"
		sv_a = sv_a + "select TRIM(B2K_ID),TRIM(B2K_TYPE),LIEN_EXPIRY_DATE,to_char(LIEN_START_DATE,'DD-MM-YYYY'),TRIM(lien_amt),alt_crncy_code"
		sv_a = sv_a + " from tbaadm.ALT "
		sv_a = sv_a + " where ACID = ?SVAR"
		sv_a = sv_a + " AND LIEN_REASON_CODE = ?SVAR"
		sv_a = sv_a + " AND LIEN_REMARKS = ?SVAR "
		sv_a = sv_a + " AND BANK_ID= ?SVAR"
		PRINT(sv_a)
		
		sv_s = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_s)
		
		IF (sv_s != 0) THEN
		#{
			IF (CUST.CHRG.lienMark == "Y") THEN
			#{
				#-------------- Adding a new Lien Record when some other lien exist other than DCHRG ----------------#
				CUST.CHRG.newLienFlg = "Y"
				sv_a = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.dracctNum)
				sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00") 
				
				sv_a = urhk_ExecSrvNoCommit("SRV_FetchLienDtlsOnAcForMod|retain_all_output = Y")
				PRINT(sv_a)
				
				IF (sv_a != 0) THEN
				#{
					GOTO ERROR_HANDLING
				#}
				ENDIF
				
				sv_a = urhk_CopyOutToIn("")
				PRINT(sv_a)
				
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.key.serial_num|0")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.newLienAmt|" + CUST.CHRG.blockAmt +  "|"+CUST.CHRG.actcrncy)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.oldLienAmt|0|"+CUST.CHRG.actcrncy)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.expiryDate|31-12-2099 00:00:00")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.lienRemarks|" + CUST.CHRG.lienRemarks)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.lienReasonCode.refCode|" + CUST.CHRG.reasonCode)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.effFromDate|" + BANCS.STDIN.BODDate)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.requestedBy|")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.requestDept|")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.contactNum|")
				
				sv_a = urhk_ExecSrvNoCommit("SRV_ModifyLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
				PRINT(sv_a)
				
				IF (sv_a != 0) THEN
				#{
					GOTO ERROR_HANDLING
				#}
				ENDIF
				
			#}
			ENDIF
			#}
		ELSE
			#{
			#--------------Increment and decrement of Lien--------------------#
			
			CUST.CHRG.B2KID=BANCS.OUTPARAM.b2kid
			CUST.CHRG.OldLienAmt = BANCS.OUTPARAM.lienamt
			
			PRINT(CUST.CHRG.B2KID)
			PRINT(CUST.CHRG.OldLienAmt)
			
			IF (CUST.CHRG.newLienFlg == "Y") THEN
			#{
				CUST.CHRG.NewLienAmt = CUST.CHRG.blockAmt
				#}
			ELSE
				#{
				CUST.CHRG.NewLienAmt = CDOUBLE(CUST.CHRG.OldLienAmt) + CDOUBLE(CUST.CHRG.blockAmt)
				IF(CDOUBLE(CUST.CHRG.NewLienAmt) < CDOUBLE(CUST.CHRG.OldLienAmt))THEN
				#{
					CUST.CHRG.lienAmt = CUST.CHRG.NewLienAmt
				#}
				ENDIF
			#}
			ENDIF
			
			PRINT(CUST.CHRG.NewLienAmt)
			
			IF (CDOUBLE(CUST.CHRG.NewLienAmt) < 0) THEN
			#{
				CUST.CHRG.LienSuccessOrFailure = "F"
				CUST.CHRG.LienFailureReason = "Unblock amt is more than Existing Lien ,Lien removal failed"
				sv_s = CUST.CHRG.acct+ "|" + "Unblock amt is more than Existing Lien ,Lien removal failed"
				sv_b = urtn_fileWrite(CUST.CHRG.failFileIndex1 + "|" + sv_s)
				PRINT(sv_b)
				
				GOTO ENDOFSCRIPT_LIEN_MOD
			#}
			ENDIF
			
			#Exisiting lien needs to be modified. Populate the criteria to
			#fetch all the details of the exisiting lien.
			
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.dracctNum)
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleId|" + CUST.CHRG.B2KID)
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00") 
			
			#Call the SRV to fetch the details for the given criteria
			sv_a = urhk_ExecSrvNoCommit("SRV_FetchLienDtlsOnAcForMod|retain_all_output = Y")
			PRINT(sv_a)
			
			IF (sv_a != 0) THEN
			#{
				GOTO ERROR_HANDLING
			#}
			ENDIF
			
			#Copy the result to the input message structure
			sv_a = urhk_CopyOutToIn("")
			PRINT(sv_a)
			
			#setting new input
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.CHRG.NewLienAmt + "|"+CUST.CHRG.actcrncy)
			
			#Call the service to modify and verify the changes.
			sv_a = urhk_ExecSrvNoCommit("SRV_ModifyLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
			PRINT(sv_a)
			
			IF (sv_a != 0) THEN
			#{
				GOTO ERROR_HANDLING
			#}
			ENDIF
		#}
		ENDIF
		#}
	ELSE
		#{
		IF (CUST.CHRG.lienMark == "Y") THEN
		#{
			#-----------Adding 1st lien Record ---------------------------#
			#A new lien needs to be added . Set all the input values into the
			#message structure
			sv_l = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.dracctNum)
			sv_l = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00") 
			
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.CHRG.blockAmt + "|"+CUST.CHRG.actcrncy)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|0|"+CUST.CHRG.actcrncy)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|31-12-2099 00:00:00")
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.CHRG.lienRemarks)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|" + CUST.CHRG.reasonCode)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.effFromDate|" + BANCS.STDIN.BODDate)
			
			#Call the service for adding and verifying the new lien.
			sv_a = urhk_ExecSrvNoCommit("SRV_AddLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
			PRINT(sv_a)
			
			IF (sv_a != 0) THEN
			#{
				GOTO ERROR_HANDLING
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ERROR_HANDLING:
		
		#-------------Error handling when the SRV returns failure.--------------------#
		IF (sv_a != 0) THEN
		#{
			CUST.CHRG.LienSuccessOrFailure = "F"
			PRINT(CUST.CHRG.LienSuccessOrFailure)
			sv_c = BANCS.OUTPARAM.Error_num
			PRINT(sv_c)
			
			IF (sv_c > 0) THEN
			#{
				IF (STRLEN(BANCS.OUTPARAM.ErrorMesg_1) > 0) THEN
				#{
					CUST.CHRG.LienFailureReason = BANCS.OUTPARAM.ErrorMesg_1
					PRINT(CUST.CHRG.LienFailureReason)
					
					sv_s = CUST.CHRG.acct+ "|" + CUST.CHRG.LienFailureReason
					PRINT(sv_s)
					sv_b = urtn_fileWrite(CUST.CHRG.failFileIndex1 + "|" + sv_s)
					PRINT(sv_b)
				#}
				ENDIF
				
				sv_d = 1
				PRINT(sv_c)
				PRINT(sv_d)
				
				WHILE(sv_d <= sv_c)
				#{
					sv_f = FORMAT$(sv_d, "%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("Tag_" + sv_f)
					PRINT(sv_e)
					sv_d = sv_d + 1
				#}
				DO
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.CHRG.LienSuccessOrFailure = "S"
		#}
		ENDIF
		
	ENDOFSCRIPT_LIEN_MOD:
		PRINT(CUST.CHRG.LienSuccessOrFailure)
		EXITSCRIPT
		
