	BANCS.INPARAM.BINDVARS = CUST.CHRG.acid + "|" + CUST.CHRG.reasonCode+ "|" + CUST.CHRG.lienRemarks + "|" + BANCS.STDIN.contextBankId
	sv_a = "count|"
	sv_a = sv_a + "SELECT COUNT(1) "
	sv_a = sv_a + "FROM tbaadm.ALT "
