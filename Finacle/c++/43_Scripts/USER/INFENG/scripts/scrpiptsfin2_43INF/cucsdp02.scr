		#sv_s = urhk_ExecSrv("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y") 
		sv_s = urhk_ExecSrvNoCommit("SRV_AddAndPostXferTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_s)

