            		sv_u = urhk_SetOrbOut(sv_l)
					sv_d = sv_d + 1
				do
			#}
			endif
        	print(BANCS.OUTPUT.successOrFailure)
    	    print(BANCS.OUTPUT.ErrorMesg)
			CUST.CUCS.remark = BANCS.OUTPUT.ErrorMesg
			CUST.CUCS.chk_tran ="F"
	        exitscript
