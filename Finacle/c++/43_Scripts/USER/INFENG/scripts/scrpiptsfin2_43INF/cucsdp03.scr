<--START

	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether CUCS Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","CUCS")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CUCS",5)
	#}
	ENDIF
	
	
	#-------------------------------------------------------------------------------
	# Calling the service to Fetch Cheque Details for Update
	#-------------------------------------------------------------------------------
		CUST.CUCS.InstrType = "CHQ"
		 print(CUST.CUCS.acctNo)
		 print(CUST.CUCS.InstrType)
		 print(CUST.CUCS.chqNo)

	 	 sv_a = urhk_SetUrhkInp("acct.foracid|" + CUST.CUCS.acctNo)
	 	 sv_a = urhk_SetUrhkInp("instrmnt.instrmntType|" + CUST.CUCS.InstrType)
	  	 sv_a = urhk_SetUrhkInp("instrmnt.instrmntNum|" + CUST.CUCS.chqNo)
		 sv_a = urhk_SetUrhkInp("instrmnt.instrmntAlpha|") 
		 
	  	sv_d = urhk_ExecSrvNoCommit("SRV_FetchChqStatForModify|same_user_verify = Y|retain_all_output = Y|call_mode = N")
	  	IF(sv_d != "0") THEN
	  	#{
			CUST.CUCS.update_stat = "Failure"
			CUST.CUCS.successOrFailure = "F"
			GOTO ENDOFSCRIPT1
	  	#}
	  	ENDIF
		
		#-------------------------------------------------------------------------------
		# Calling the service to copy all details.
		#-------------------------------------------------------------------------------
		sv_a = urhk_CopyOutToIn("")
		sv_a = urhk_SetUrhkInp("newStat.code|P")

		#-------------------------------------------------------------------------------
		# Calling the service to Update Cheque Status in Finacle
		#-------------------------------------------------------------------------------
		sv_d = urhk_ExecSrvNoCommit("SRV_UpdateChqStat|same_user_verify = Y|retain_all_output = Y|call_mode = N")
		IF(sv_d != "0") THEN
		#{
			CUST.CUCS.update_stat = "Failure"
			CUST.CUCS.successOrFailure = "F"
			GOTO ENDOFSCRIPT1
		#}
		ENDIF

		#-------------------------------------------------------------------------------
		# Calling the service to copy all details.
		#-------------------------------------------------------------------------------
		sv_a = urhk_CopyOutToIn("")

		#-------------------------------------------------------------------------------
		# Calling the service to Fetch Cheque Details for verify
		#-------------------------------------------------------------------------------
		sv_d = urhk_ExecSrvNoCommit("SRV_FetchChqStatForVerify|same_user_verify = Y|retain_all_output = Y|call_mode = N")
		IF(sv_d != "0") THEN
		#{
			CUST.CUCS.update_stat = "Failure"
			CUST.CUCS.successOrFailure = "F"
			GOTO ENDOFSCRIPT1
		#}
		ENDIF

		#-------------------------------------------------------------------------------
		# Calling the service to copy all details.
		#-------------------------------------------------------------------------------
		sv_a = urhk_CopyOutToIn("")
		print(sv_a)
		#-------------------------------------------------------------------------------
		# Calling the service to Verify Cheque Status in Finacle
		#-------------------------------------------------------------------------------
		sv_d = urhk_ExecSrvNoCommit("SRV_VerifyChqStat|same_user_verify = Y|retain_all_output = Y|call_mode = N")
		print(sv_d)
		IF(sv_d != "0") THEN
		#{
			CUST.CUCS.update_stat = "Failure"
			CUST.CUCS.successOrFailure = "F"
			GOTO ENDOFSCRIPT1
		#}
		ELSE
		#{
			CUST.CUCS.srvErrFlg = "N"
		#}
		ENDIF

	
	ENDOFSCRIPT1:
	
exitscript
end-->
