sv_s = sv_s + " SELECT regexp_replace(?SVAR,'[^0-9A-Za-z .]','') from dual"
BANCS.INPARAM.BINDVARS =BANCS.INPUT.acct_name
PRINT(BANCS.INPARAM.BINDVARS)
sv_r = urhk_dbSelectWithBind(sv_s)
PRINT(sv_r)
IF (sv_r == 0) THEN
#{
	CUST.DATA.acct_name = BANCS.OUTPARAM.acct_name
	PRINT(CUST.DATA.acct_name)
#}
ENDIF

	
	#================================================
