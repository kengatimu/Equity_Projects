	CUST.DATA.DR_TRAN_AMT 	= ""
	
	
	#================================================
	# Replacing single quotes with space
	#================================================
	sv_s = "acct_name,city_desc|select replace(q'["+CUST.DATA.acct_name+"]',q'[']',q'[ ]'), replace(q'["+CUST.DATA.city_desc+"]',q'[']',q'[ ]')  from dual"
