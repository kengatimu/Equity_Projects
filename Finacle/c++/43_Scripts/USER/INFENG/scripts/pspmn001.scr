				sv_s = sv_s + "TO_CHAR(PSTD_DATE,'DD-MM-YYYY'),"
				sv_s = sv_s + "TO_CHAR(TRAN_DATE,'DD-MM-YYYY'),"
				sv_s = sv_s + "TO_CHAR(VALUE_DATE,'DD-MM-YYYY'),"
				sv_s = sv_s + "TRAN_AMT,"
				sv_s = sv_s + "TRAN_PARTICULAR,"
				sv_s = sv_s + "PART_TRAN_TYPE,"
				sv_s = sv_s + " TO_CHAR(GL_DATE,'YYYY-MM-DD'), "
				sv_s = sv_s + " TO_CHAR(GL_DATE,'DD-MM-YYYY'), "
				sv_s = sv_s + " TO_CHAR(PSTD_DATE,'YYYY-MM-DDHH24:MI:SS'), "
				sv_s = sv_s + " tran_id, "
				sv_s = sv_s + " part_tran_srl_num "
				sv_s = sv_s + " from CUSTOM.C_HTD"
				sv_s = sv_s + " WHERE ACID = ?SVAR AND DEL_FLG = 'N' AND BANK_ID = ?SVAR AND PSTD_flg= 'Y'"
				sv_s = sv_s + " AND tran_date BETWEEN TO_DATE(?SVAR,'DD-MM-YYYY') AND TO_DATE(?SVAR,'DD-MM-YYYY')"
				sv_s = sv_s + " AND tran_particular != 'BALANCE TRANSFER'"
				sv_s = sv_s + " ORDER BY gl_date, pstd_date, tran_id, part_tran_srl_num"
