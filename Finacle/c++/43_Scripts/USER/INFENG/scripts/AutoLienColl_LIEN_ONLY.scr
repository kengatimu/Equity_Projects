<--START
CHECKSUM="22c624c4bbff5129ffa2aea2cc57403435624a8919345e2117c653c57a4a288f"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.SBACT.errMsg = ""
	CUSTS.SBACT.b2kidnew = ""
	CUSTS.SBACT.b2kidnewflg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="custcount|"
	sv_s = sv_s + " SELECT COUNT(1) from  custom.BULK_LIEN_COLLECTION_DRC where ROLLBACK_FREETEXT1='LIEN_ONLY' and ROLLBACK_LIEN_FLGYESORNO is null  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
	#{
		CUSTS.SBACT.errMsg = "DB ERROR!"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.custcount)
		IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s=" foracid,sol_id, narr, cyc_code,lien_amt,foracid_recover,lienreasoncode,b2kid|"
	sv_s = sv_s + " select  foracid,sol_id, LIEN_REMARKS, ACCT_CRNCY_CODE,lien_amt,COLLECTION_ACCOUNT,LIEN_REASON_CODE,B2K_ID "
	sv_s = sv_s + " from  custom.BULK_LIEN_COLLECTION_DRC where ROLLBACK_FREETEXT1='LIEN_ONLY' and ROLLBACK_LIEN_FLGYESORNO is null  order by lien_amt desc "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.SBACT.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUSTS.SBACT.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.SBACT.sol_id	= BANCS.OUTPARAM.sol_id
			CUSTS.SBACT.narr	= BANCS.OUTPARAM.narr
			CUSTS.SBACT.cyc_code = BANCS.OUTPARAM.cyc_code
			print(CUSTS.SBACT.cyc_code)
			CUSTS.SBACT.lien_amt = BANCS.OUTPARAM.lien_amt
			print(CUSTS.SBACT.lien_amt)
			CUSTS.SBACT.amount = CUSTS.SBACT.lien_amt
			print(CUSTS.SBACT.amount)
			CUSTS.SBACT.foracid_recover = BANCS.OUTPARAM.foracid_recover
			print(CUSTS.SBACT.foracid_recover)
			CUSTS.SBACT.lienreasoncode = BANCS.OUTPARAM.lienreasoncode
			print(CUSTS.SBACT.lienreasoncode)
			CUSTS.SBACT.b2kid = BANCS.OUTPARAM.b2kid
			print(CUSTS.SBACT.b2kid)
			CUSTS.SBACT.narr=MID$(CUSTS.SBACT.narr,0,50)
			print(CUSTS.SBACT.narr)
			
			print(CUSTS.SBACT.foracid)
			print(CUSTS.SBACT.sol_id)
			print(CUSTS.SBACT.amount)
			
			CUSTS.SBACT.amount1="0.00|" + CUSTS.SBACT.cyc_code
			CUSTS.SBACT.date="01-12-2099 12:11:48"
			
			IF (CUSTS.SBACT.sol_id != BANCS.STDIN.mySolId) THEN
			#{
				sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.SBACT.sol_id)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
			#}
			ENDIF
			
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account lien services
			# urhk_SetUrhkInp is used to set inputs
			#--------------------------------------------------------------------------------------------------------------
			
			
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUSTS.SBACT.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" + CUSTS.SBACT.cyc_code)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUSTS.SBACT.amount+"|" + CUSTS.SBACT.cyc_code )
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUSTS.SBACT.amount1)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUSTS.SBACT.date)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|" + CUSTS.SBACT.lienreasoncode)
			PRINT(sv_u)
			###sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUSTS.SBACT.foracid_recover)
			####PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestedBy|" + CUSTS.SBACT.b2kid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUSTS.SBACT.narr)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUSTS.SBACT.date)
			PRINT(sv_u)

			sv_u = urhk_ExecSrv("SRV_AddLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			IF (sv_u == 0) THEN
			#{
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				print(CUSTS.SBACT.lienreasoncode)
				print(CUSTS.SBACT.b2kid)
				print(CUSTS.SBACT.narr)
				PRINT(BANCS.STDIN.contextBankId)
				print(BANCS.STDIN.userId)
				sv_s = "lienid|"
				sv_s = sv_s + " select   TRIM(max(B2K_ID)) from tbaadm.alt l ,tbaadm.gam g  where  l.acid=g.acid  AND l.bank_id=g.bank_id AND g.bank_id=?SVAR "
				sv_s = sv_s + " AND l.LIEN_REASON_CODE=?SVAR AND g.foracid =?SVAR AND l.LIEN_REMARKS=?SVAR AND l.RCRE_USER_ID=?SVAR "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUSTS.SBACT.lienreasoncode + "|" + CUSTS.SBACT.foracid + "|" +  CUSTS.SBACT.narr + "|"+ BANCS.STDIN.userId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUSTS.SBACT.b2kidnew=BANCS.OUTPARAM.lienid
					print(CUSTS.SBACT.b2kidnew)
					sv_s = "update custom.BULK_LIEN_COLLECTION_DRC set  ROLLBACK_LIEN_FLGYESORNO='DONE' ,ROLLBACK_LIEN_ID=?SVAR   "
					sv_s = sv_s + " where ROLLBACK_FREETEXT1='LIEN_ONLY' and ROLLBACK_LIEN_FLGYESORNO is null and foracid=?SVAR and B2K_ID=?SVAR  "
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUSTS.SBACT.b2kidnew + "|" +  CUSTS.SBACT.foracid + "|" + CUSTS.SBACT.b2kid
					print(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					#}
					ENDIF
				ENDIF
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUSTS.SBACT.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" + CUSTS.SBACT.cyc_code)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUSTS.SBACT.amount+"|" + CUSTS.SBACT.cyc_code)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUSTS.SBACT.amount1)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUSTS.SBACT.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|" + CUSTS.SBACT.lienreasoncode)
				PRINT(sv_u)
				##sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUSTS.SBACT.foracid_recover)
				##PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestedBy|" + CUSTS.SBACT.b2kid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUSTS.SBACT.narr)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUSTS.SBACT.date)
				PRINT(sv_u)
				
				sv_u = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				IF (sv_u == 0) THEN
				#{
					#----------------------------------------------------------------------------------------------------
					# Update custom table status
					#----------------------------------------------------------------------------------------------------
					print(CUSTS.SBACT.lienreasoncode)
					print(CUSTS.SBACT.b2kid)
					print(CUSTS.SBACT.narr)
					PRINT(BANCS.STDIN.contextBankId)
					print(BANCS.STDIN.userId)
					sv_s = "lienid|"
					sv_s = sv_s + " select   TRIM(max(B2K_ID)) from tbaadm.alt l ,tbaadm.gam g  where  l.acid=g.acid  AND l.bank_id=g.bank_id AND g.bank_id=?SVAR "
					sv_s = sv_s + " AND l.LIEN_REASON_CODE=?SVAR AND g.foracid =?SVAR AND l.LIEN_REMARKS=?SVAR AND l.RCRE_USER_ID=?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUSTS.SBACT.lienreasoncode + "|" + CUSTS.SBACT.foracid + "|" +  CUSTS.SBACT.narr + "|"+ BANCS.STDIN.userId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d =  urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUSTS.SBACT.b2kidnew=BANCS.OUTPARAM.lienid
						print(CUSTS.SBACT.b2kidnew)
						sv_s = "update custom.BULK_LIEN_COLLECTION_DRC set  ROLLBACK_LIEN_FLGYESORNO='DONE' ,ROLLBACK_LIEN_ID=?SVAR   "
						sv_s = sv_s + " where ROLLBACK_FREETEXT1='LIEN_ONLY' and ROLLBACK_LIEN_FLGYESORNO is null and foracid=?SVAR and B2K_ID=?SVAR  "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = CUSTS.SBACT.b2kidnew + "|" +  CUSTS.SBACT.foracid + "|" + CUSTS.SBACT.b2kid
						print(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
						#{
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						#}
						ENDIF
					ENDIF
				#}
				ENDIF
				
				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						print(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) THEN
					#{
						sv_i = 1
						print(sv_i)
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_s = "update custom.BULK_LIEN_COLLECTION_DRC set  ROLLBACK_LIEN_FLGYESORNO='ERROR_TO_ADD_LIEN' ,ROLLBACK_LIEN_ERROR=?SVAR   "
						sv_s = sv_s + " where ROLLBACK_FREETEXT1='LIEN_ONLY' and ROLLBACK_LIEN_FLGYESORNO is null and foracid=?SVAR and B2K_ID=?SVAR  "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = sv_e + "|" +  CUSTS.SBACT.foracid + "|" + CUSTS.SBACT.b2kid
						print(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
						#{
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF

			IF (CUSTS.SBACT.b2kidnewflg!="")  THEN
				print("Ok go to next record no posting")
			ENDIF
			
			sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.SBACT.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.SBACT.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUSTS.SBACT.errMsg+"' >>lienedfttgyhuj.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
