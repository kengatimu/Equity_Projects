	CUST.INTERFACE.interfaceRequestID = "gloryoutbounddate"
	print(CUST.INTERFACE.interfaceRequestID)
	
	CUST.INTERFACE.interfaceRequestVersion = "10.2"
	print(CUST.INTERFACE.interfaceRequestVersion)
	
	
	CUST.INTERFACE.URL="10.1.9.214"
	print(CUST.INTERFACE.URL)
	
	CUST.INTERFACE.port="9001"
	print(CUST.INTERFACE.port)
	
	BANCS.INPARAM.Day=LEFT$(BANCS.STDIN.sysDate,2)
	print(BANCS.INPARAM.Day)
	BANCS.INPARAM.Month=MID$(BANCS.STDIN.sysDate,3,2)
	print(BANCS.INPARAM.Month)
