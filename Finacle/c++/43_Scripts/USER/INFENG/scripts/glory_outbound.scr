		IF(BANCS.OUTPARAM.ErrMsg!="") THEN
		#{
			PRINT(BANCS.OUTPARAM.ErrMsg)
		#}
		ENDIF
		
		sv_x = CUST.INTERFACE.response
		sv_y = "<journal_id>"
		sv_z = "</journal_id>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.journal_id = MID$(sv_x, sv_b, (sv_e - sv_b))
			print(CUST.INTERFACE.journal_id)
			#}
		ELSE
			#{
			CUST.INTERFACE.journal_id = ""
		#}
		ENDIF
		sv_y =""
		sv_z =""
