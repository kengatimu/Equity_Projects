<--START
CHECKSUM="2db360b548955e40b1f8e2a01dfd7fe76c8c87afaec00ce28d32fb12d759f7cf"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","INTERFACE") == 0) THEN
	#{
		CREATECLASS ("CUST","INTERFACE",5)
	#}
	ENDIF
	
	##Printing Bancs
	
	sv_a = urhk_B2k_PrintRepos("BANCS")
