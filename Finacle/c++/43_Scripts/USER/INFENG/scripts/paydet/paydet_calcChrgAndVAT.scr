		CUST.DATA.chrgAmt = FORMAT$(CDOUBLE(CUST.DATA.chrgAmt),"%.2f")
    		PRINT (CUST.DATA.chrgAmt)
		
		PRINT (CUST.DATA.chrgAmt)
		CUST.DATA.chrgAmt = FORMAT$(CDOUBLE(CUST.DATA.chrgAmt),"%.2f")
    		PRINT (CUST.DATA.chrgAmt)


		PRINT(CUST.DATA.totalAmt)
		IF(CDOUBLE(CUST.DATA.totalAmt) > CDOUBLE(CUST.DATA.avblAmt))THEN
		#{
			CUST.DATA.balcheck = "N"
		#}
		ENDIF


	exitscript		
END-->
