<--start
trace on
	if(BANCS.STDIN.contextBankId == "43")then
		sv_a = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.acctClassMISCEntered")
		if(sv_a == 0)then
			sv_e = BANCS.OUTPARAM.srvValue
			if(sv_e == 0)then
				sv_e = urhk_SRV_setErr("Visit MIS Codes Tab.")
				BANCS.OUTPUT.successOrFailure = "F"
			endif
		endif
	endif

trace off
end-->
