<--START
CHECKSUM="b874e45444124f4b46719ce8318d00f33848e37f181752329be2cd339c21c35f"
	TRACE ON
	#CHG0037085/07112025INFENG

	sv_r = REPEXISTS("CUSTB")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUSTB")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUSTB","MTTCUSTB")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUSTB","MTTCUSTB",5)
	#}
	ENDIF
	
	CUSTB.MTTCUSTB.remark = " "	
	CUSTB.MTTCUSTB.errMsg = ""
	CUSTB.MTTCUSTB.credit_account = ""
	
	sv_s = " sol_id,credit_account,acct_name,acct_crncy_code,tran_amt,tran_particular,tran_particular_2,tran_id,tran_date,pull_flg,ref_num,tran_rmks,sequenceno,debit_account | "
	sv_s = sv_s + "  select SOL_ID,CREDIT_ACCOUNT,ACCT_NAME,ACCT_CRNCY_CODE,TRAN_AMT,TRAN_PARTICULAR,TRAN_PARTICULAR_2,TRAN_ID, to_char((to_date(TRAN_DATE,'DD-MM-RRRR')),'DD-MON-RRRR') as TRAN_DATE,PULL_FLG,REF_NUM,TRAN_RMKS,SEQUENCENO,DEBIT_ACCOUNT " 
	sv_s = sv_s + "   from custom.tran_posting_table where PULL_FLG='N'  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  CUSTB.MTTCUSTB.credit_account
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_e = urhk_dbCursorOpenWithBind(sv_s)
	IF(sv_e==0) THEN
		CUSTB.MTTCUSTB.DbcursorNumberTrans = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(CUSTB.MTTCUSTB.DbcursorNumberTrans)
		sv_q = urhk_dbCursorFetch(CUSTB.MTTCUSTB.DbcursorNumberTrans)
		print(sv_q)
		IF(sv_q == 1) THEN
			sv_x = urhk_dbCursorClose(CUSTB.MTTCUSTB.DbcursorNumberTrans)
			print(sv_x)
			exitscript
		ENDIF
		print(sv_q)

	WHILE (sv_q==0)

		CUSTB.MTTCUSTB.sol_id = BANCS.OUTPARAM.sol_id
		print(CUSTB.MTTCUSTB.sol_id)
		CUSTB.MTTCUSTB.credit_account = BANCS.OUTPARAM.credit_account
		print(CUSTB.MTTCUSTB.credit_account)
		CUSTB.MTTCUSTB.acct_name = BANCS.OUTPARAM.acct_name
		print(CUSTB.MTTCUSTB.acct_name)
		CUSTB.MTTCUSTB.acct_crncy_code = BANCS.OUTPARAM.acct_crncy_code
		print(CUSTB.MTTCUSTB.acct_crncy_code)
		CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE = CUSTB.MTTCUSTB.acct_crncy_code
		print(CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE)
		CUSTB.MTTCUSTB.tran_amt = BANCS.OUTPARAM.tran_amt
		print(CUSTB.MTTCUSTB.tran_amt)
		CUSTB.MTTCUSTB.tran_particular = BANCS.OUTPARAM.tran_particular
		print(CUSTB.MTTCUSTB.tran_particular)
		CUSTB.MTTCUSTB.tran_particular_2 = BANCS.OUTPARAM.tran_particular_2
		print(CUSTB.MTTCUSTB.tran_particular_2)
		CUSTB.MTTCUSTB.tran_id = BANCS.OUTPARAM.tran_id
		print(CUSTB.MTTCUSTB.tran_id)
		CUSTB.MTTCUSTB.tran_date = BANCS.OUTPARAM.tran_date
		print(CUSTB.MTTCUSTB.tran_date)
		CUSTB.MTTCUSTB.pull_flg = BANCS.OUTPARAM.pull_flg
		print(CUSTB.MTTCUSTB.pull_flg)
		CUSTB.MTTCUSTB.ref_num = BANCS.OUTPARAM.ref_num
		print(CUSTB.MTTCUSTB.ref_num)
		CUSTB.MTTCUSTB.tran_rmks = BANCS.OUTPARAM.tran_rmks
		print(CUSTB.MTTCUSTB.tran_rmks)
		CUSTB.MTTCUSTB.sequenceno = BANCS.OUTPARAM.sequenceno
		print(CUSTB.MTTCUSTB.sequenceno)
		CUSTB.MTTCUSTB.debit_account = BANCS.OUTPARAM.debit_account
		print(CUSTB.MTTCUSTB.debit_account)

		sv_r = urhk_getAcctDetailsInRepository(CUSTB.MTTCUSTB.debit_account)
		IF(sv_r != 0)THEN
			sv_q ="Account not valid"
			PRINT(sv_q)
			sv_q = CUSTB.MTTCUSTB.credit_account +"|"+ sv_q
			print(sv_q)
			GOTO NEXTACID
		ELSE		
			CUSTB.MTTCUSTB.acctSolId = BANCS.OUTPARAM.acctSolId
			CUSTB.MTTCUSTB.actcrncy = BANCS.OUTPARAM.acctCrncyCode
			CUSTB.MTTCUSTB.frezCode = BANCS.OUTPARAM.freezeCode
			CUSTB.MTTCUSTB.FORACIDNAME = BANCS.OUTPARAM.acctName
			
			sv_e = BANCS.OUTPARAM.EffAvailableAmt
			PRINT(sv_e)
			PRINT(CUSTB.MTTCUSTB.actcrncy)
			PRINT(CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE)
		ENDIF


		
		##########################################################
		#RateCode######
		##########################################################
		
			IF (CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE != CUSTB.MTTCUSTB.actcrncy) THEN
				sv_r = REPEXISTS("CUSTB")
				
				IF(sv_r == 0) THEN
					CREATEREP ("CUSTB")
				ENDIF
				sv_r = CLASSEXISTS("CUSTB","RATE")
				IF(sv_r == 0) THEN
					CREATECLASS ("CUSTB","RATE",5)
				ENDIF
				
				CUSTB.RATE.acctCrncy = CUSTB.MTTCUSTB.actcrncy
				CUSTB.RATE.refCrncy = CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE
				CUSTB.RATE.TranType = "T"
			ENDIF

			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)
			
			BANCS.INPARAM.PostTranFlg = "Y"
			BANCS.INPARAM.CommitFlg = "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
			BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
			BANCS.INPARAM.ErrorCheckForLuw = "Y"
			BANCS.INPARAM.CheckExceptions = "Y"
			sv_r = urhk_MTTS_Initialize("")
			PRINT(sv_r)
			IF(sv_r != 0)THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				CUSTB.MTTCUSTB.ErrorMessage=MTT.Error.Description
				PRINT(CUSTB.MTTCUSTB.ErrorMessage)
				CUSTB.MTTCUSTB.remark = CUSTB.MTTCUSTB.ErrorMessage
				CUSTB.MTTCUSTB.errMsg = CUSTB.MTTCUSTB.credit_account + "|" +CUSTB.MTTCUSTB.remark
				GOTO NEXTACID

			ENDIF
			############################################
			#Define Transaction
			#############################################
			MTT.TranDetails.TranID 					= ""
			MTT.TranDetails.TranDate                = "0"
			MTT.TranDetails.TranType                = "T"
			MTT.TranDetails.PostFlag                = "Y"
			MTT.TranDetails.TranSubType             = "BI"
			MTT.TranDetails.ReversalFlag            = "N"
			MTT.TranDetails.IgnoreExcp              = "I"
			MTT.TranDetails.Consolidate             = "Y"
			MTT.TranDetails.Remarks                 = "transaction_posting"
			sv_t = urhk_MTTS_DefineTransaction("mtt_trans_indictor")
			
			IF(sv_t != 0) THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				CUSTB.MTTCUSTB.ErrorMessage=MTT.Error.Description
				PRINT(CUSTB.MTTCUSTB.ErrorMessage)
				CUSTB.MTTCUSTB.remark = CUSTB.MTTCUSTB.ErrorMessage
				CUSTB.MTTCUSTB.errMsg = CUSTB.MTTCUSTB.credit_account + "|" +CUSTB.MTTCUSTB.remark
				PRINT(CUSTB.MTTCUSTB.errMsg)
				GOTO NEXTACID
			ENDIF

			CUSTB.MTTCUSTB.debitAmt = CUSTB.MTTCUSTB.tran_amt
			print(CUSTB.MTTCUSTB.debitAmt)

			######################################
			# Debit part tran for charge
			######################################
			
			MTT.PartTranDetails.Account     = CUSTB.MTTCUSTB.debit_account
			MTT.PartTranDetails.RefCurrency= CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE
			MTT.PartTranDetails.Particulars = CUSTB.MTTCUSTB.tran_particular 
			MTT.PartTranDetails.Particulars2 = CUSTB.MTTCUSTB.tran_id + "/"+ CUSTB.MTTCUSTB.tran_date
			MTT.PartTranDetails.Refnum = CUSTB.MTTCUSTB.ref_num 
			MTT.PartTranDetails.Remarks = CUSTB.MTTCUSTB.tran_rmks
			IF(CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE != CUSTB.MTTCUSTB.actcrncy)THEN
				MTT.PartTranDetails.RateCode= "TTB"
				MTT.PartTranDetails.Rate = "0"
			ENDIF
			MTT.PartTranDetails.RefAmount = -cdouble(CUSTB.MTTCUSTB.debitAmt)
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "mtt_trans_indictor"
			MTT.PartTranDetails.CarveAmtFlg="Y"
			
			#----------------------------------------------------------------------------------
			# Defining the Debit Part Tran for Charge amount
			#----------------------------------------------------------------------------------
			sv_u = urhk_MTTS_DefinePartTran("MTTCUSTB_Debit_Tran")
			PRINT(sv_u)
			
			IF (sv_u != 0) THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				CUSTB.MTTCUSTB.ErrorMessage=MTT.Error.Description
				PRINT(CUSTB.MTTCUSTB.ErrorMessage)
				CUSTB.MTTCUSTB.remark = CUSTB.MTTCUSTB.ErrorMessage
				CUSTB.MTTCUSTB.errMsg = CUSTB.MTTCUSTB.credit_account+ "|"+CUSTB.MTTCUSTB.remark
				PRINT(CUSTB.MTTCUSTB.errMsg)
				GOTO NEXTACID
			ENDIF
			
			######################################
			# Credit part tran for charge
			######################################
			MTT.PartTranDetails.Account= CUSTB.MTTCUSTB.credit_account
			MTT.PartTranDetails.RefAmount= CDOUBLE(CUSTB.MTTCUSTB.debitAmt)
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Particulars = CUSTB.MTTCUSTB.tran_particular 
			MTT.PartTranDetails.Refnum = CUSTB.MTTCUSTB.ref_num 
			MTT.PartTranDetails.Remarks =  CUSTB.MTTCUSTB.tran_rmks
			MTT.PartTranDetails.Particulars2 = CUSTB.MTTCUSTB.tran_id + "/"+ CUSTB.MTTCUSTB.tran_date
			IF(CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE != CUSTB.MTTCUSTB.actcrncy)THEN
				MTT.PartTranDetails.RateCode= "TTB"
				MTT.PartTranDetails.Rate = "0"
			ENDIF
			MTT.PartTranDetails.RefCurrency= CUSTB.MTTCUSTB.TRANSS_CRNCY_CODE
			MTT.PartTranDetails.ValueDate="0"
			MTT.PartTranDetails.ReportCode = ""
			MTT.PartTranDetails.Consolidate="Y"
                        ###MTT.PartTranDetails.ACPARTB2kId = CUSTB.MTTCUSTB.Acid
                        ###MTT.PartTranDetails.ACPARTB2kType="ACCNT"
			MTT.PartTranDetails.TranIdentifier="mtt_trans_indictor"
			MTT.PartTranDetails.TranBusinessType=""
						
			sv_u = urhk_MTTS_DefineChargePartTran("MTTCUSTB_Credit_Tran")
			PRINT(sv_u)
			
			IF (sv_u != 0) THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				CUSTB.MTTCUSTB.ErrorMessage=MTT.Error.Description
				PRINT(CUSTB.MTTCUSTB.ErrorMessage)
				CUSTB.MTTCUSTB.remark = CUSTB.MTTCUSTB.ErrorMessage
				CUSTB.MTTCUSTB.errMsg = CUSTB.MTTCUSTB.credit_account + "|"+CUSTB.MTTCUSTB.remark
				PRINT(CUSTB.MTTCUSTB.errMsg)
				GOTO NEXTACID
			ENDIF
			
			#--------------------------------------------------------------------------------------------------	
			
			sv_r = urhk_putExceptionsIntoRepository("")
			PRINT(sv_r)			
			sv_s = urhk_b2k_printRepos("EXCP")
			sv_r = urhk_MTTS_EndDefinition("")
			PRINT(sv_r)			
			IF(sv_r !=0) THEN
				sv_a = "Transaction Commit Failed"
				PRINT(sv_a)
				sv_h = urhk_MTTS_ReportErrorCondition("")
				PRINT(sv_h)
				PRINT(MTT.Error.Description)
				CUSTB.MTTCUSTB.remark = MTT.Error.Description
				sv_h = urhk_MTTS_HandleExceptions("POST")
				PRINT(sv_h)
				sv_h=urhk_B2k_PrintRepos("MTT")
				PRINT(sv_h)
				CUSTB.MTTCUSTB.errMsg = CUSTB.MTTCUSTB.credit_account  + "|"+CUSTB.MTTCUSTB.remark
				CUSTB.MTTCUSTB.pstdFlg = "N"
				GOTO NEXTACID
			ENDIF

			sv_u = urhk_MTTS_EndDefinition("")
			PRINT(sv_u)
			
			PRINT(BANCS.OUTPARAM.MTTTranId)
			CUSTB.MTTCUSTB.tranid = BANCS.OUTPARAM.MTTTranId
			print(CUSTB.MTTCUSTB.tranid)

			IF (CUSTB.MTTCUSTB.tranid !="") THEN
				sv_h = mid$(BANCS.STDIN.BODDate,0,10)
				print(sv_h)
				sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
				BANCS.INPARAM.BINDVARS =  sv_h
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d =="0") THEN
					print(BANCS.OUTPARAM.getboddate)
					sv_y = BANCS.OUTPARAM.getboddate
					print(sv_y)
					BANCS.INPARAM.BINDVARS = CUSTB.MTTCUSTB.credit_account  + "|" + CUSTB.MTTCUSTB.sequenceno 
					print(BANCS.INPARAM.BINDVARS)
					sv_j = " update custom.tran_posting_table set PULL_FLG='Y'  where PULL_FLG='N' and  credit_account=?SVAR and sequenceno=?SVAR  "
					print(sv_j)
					sv_w = urhk_dbSQLWithBind(sv_j)
					print(sv_w)
					sv_w = urhk_dbSQLWithBind("COMMIT")
					print(sv_w)
				ENDIF
			ENDIF

			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)

			sv_d = " Sleep 3"
			PRINT(sv_d)
			sv_u = SYSTEM(sv_d)
			PRINT(sv_u)
				
			NEXTACID:
		sv_q = urhk_dbCursorFetch(CUSTB.MTTCUSTB.DbcursorNumberTrans)
		print(sv_q)
	DO

	sv_x = urhk_dbCursorClose(CUSTB.MTTCUSTB.DbcursorNumberTrans)
	print(sv_x)

	ENDOFSCRIPT:
		IF(CUSTB.MTTCUSTB.errMsg == "") THEN
			CUSTB.MTTCUSTB.errMsg = "All Successful Posted"
		ENDIF
		
	FINISH:
TRACE OFF

END-->

