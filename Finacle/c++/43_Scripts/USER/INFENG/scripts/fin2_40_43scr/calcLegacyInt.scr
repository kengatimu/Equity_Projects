<--START
	# Script body goes here
	TRACE ON
	
	sv_r = urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_r)
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	PRINT(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether EQB Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","EQB")
	PRINT(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","EQB",5)
	#}
	ENDIF
	
	
	PRINT(CUST.EQB.intDate)
	PRINT(CUST.EQB.lAcid)
	
	CUST.EQB.errorFlg="N"
	CUST.EQB.errorMsg="NA"
	CUST.EQB.legInt=CDOUBLE("0.00")
	
	##################################
	# Calculate Legacy System Interest #
	##################################
	
	sv_s = "intAmt1|"
	sv_s = sv_s + "select sum(interest_amount) from custom.c_lsbt where acid=?SVAR AND start_date <= to_date(?SVAR,'dd-mm-yyyy') AND bank_id=?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+CUST.EQB.intDate+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.intAmt1=BANCS.OUTPARAM.intAmt1
		PRINT(CUST.EQB.intAmt1)
		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to retrieve Legacy SYSTEM Interest"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	sv_s = "totDays,intDays,totAmt2,intAmt2|"
	sv_s = sv_s + "select (end_date - start_date)+1,(to_date(?SVAR,'dd-mm-yyyy')-start_date)+1,CURRENT_INTEREST_AMOUNT,"
	sv_s = sv_s + " cast((CURRENT_INTEREST_AMOUNT/(end_date - start_date+1))*(to_date(?SVAR,'dd-mm-yyyy')-start_date+1) as numeric(20,2)) "
	sv_s = sv_s + "from custom.c_lsbt where acid=?SVAR  AND start_date <= to_date(?SVAR,'dd-mm-yyyy') AND end_date >= to_date(?SVAR,'dd-mm-yyyy') AND bank_id=?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.intDate+"|"+CUST.EQB.intDate+"|"+CUST.EQB.lAcid+"|"+CUST.EQB.intDate+"|"+CUST.EQB.intDate+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.totDays=BANCS.OUTPARAM.totDays
		PRINT(CUST.EQB.totDays)
		
		CUST.EQB.intDays=BANCS.OUTPARAM.intDays
		PRINT(CUST.EQB.intDays)
		
		CUST.EQB.totAmt2=BANCS.OUTPARAM.totAmt2
		PRINT(CUST.EQB.totAmt2)
		
		CUST.EQB.intAmt2=BANCS.OUTPARAM.intAmt2
		PRINT(CUST.EQB.intAmt2)
		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to retrieve Legacy SYSTEM Interest"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.EQB.legInt=CDOUBLE(CUST.EQB.intAmt2)+CDOUBLE(CUST.EQB.intAmt1)
	PRINT(CUST.EQB.legInt)
	
	
	
	ENDOFSCRIPT:
		PRINT(CUST.EQB.errorFlg)
		PRINT(CUST.EQB.errorMsg)
		
		EXITSCRIPT
END-->
