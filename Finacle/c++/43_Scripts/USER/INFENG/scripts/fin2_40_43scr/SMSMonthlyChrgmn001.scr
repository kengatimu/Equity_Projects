				#GOTO FAILURE
				GOTO NEXTREC
				#}
			ELSE
				#{
				CUST.GCHRG.opsolid = BANCS.OUTPARAM.acctSolId
				CUST.GCHRG.actcrncy = BANCS.OUTPARAM.acctCrncyCode
				CUST.GCHRG.frezCode = BANCS.OUTPARAM.freezeCode
				CUST.GCHRG.schmCode = BANCS.OUTPARAM.schmCode
				
				sv_e = BANCS.OUTPARAM.EffAvailableAmt
				PRINT(sv_e)
				
				
				CUST.GCHRG.effavlamt = sv_e
				
			#}
			ENDIF
			IF ((CUST.GCHRG.frezCode == "D") OR (CUST.GCHRG.frezCode == "T"))THEN
