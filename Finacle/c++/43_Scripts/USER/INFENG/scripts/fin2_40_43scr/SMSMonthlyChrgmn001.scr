				#}
			ELSE
				#{
				sv_q= "acctStat|select ACCT_STATUS from tbaadm.SMT where acid = ?SVAR "
			#}
			ENDIF
			sv_q= sv_q + " AND bank_id=?SVAR"
			PRINT(sv_q)
			BANCS.INPARAM.BINDVARS = CUST.GCHRG.acid + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_r = urhk_dbselectWithBind(sv_q)
			PRINT(sv_r)
			IF (sv_r == 0) THEN
			#{
				CUST.GCHRG.acctStat = BANCS.OUTPARAM.acctStat
				IF(CUST.GCHRG.acctStat!="A")THEN
				#{
					
					sv_q =" account is not active"
					CUST.GCHRG.remark = sv_q
					CUST.GCHRG.errMsg = CUST.GCHRG.foracid + "|" + sv_q
					sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
					PRINT(sv_b)
					GOTO NEXTREC
				#}
				ENDIF
			#}
			ENDIF
			                        #----------------------- chrg & VAT Charge Calculation Part starts here-----------------------------------------#

                sv_s="chrgType,eventchrgAmt,chrgpcnt,minAmt,maxAmt,slabCode|SELECT CHARGE_TYPE,CHRG_AMT,PRCNT,MIN_AMT,MAX_AMT,SLAB_CODE FROM CUSTOM.CUSTOM_CCPRM WHERE"
                sv_s = sv_s + " EVENT_TYPE='GCHRG' AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
        sv_s = sv_s + " AND SCHM_CODE=?SVAR AND CRNCY_CODE=?SVAR AND BANK_ID=?SVAR "
        BANCS.INPARAM.BINDVARS = CUST.GCHRG.chargevent + "|" +CUST.GCHRG.schmCode + "|" + CUST.GCHRG.actcrncy + "|" + BANCS.STDIN.contextBankId

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)
        sv_p = urhk_dbCursorOpenWithBind(sv_s)
        PRINT(sv_p)
        IF(sv_p!=0) THEN
        #{
            sv_q = "Charge details not maintained for Account schme Code and currency Code"
            CUST.GCHRG.errMsg = CUST.GCHRG.foracid + "|" + sv_q
            sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
            PRINT(sv_b)
            GOTO NEXTREC

        #}
        ENDIF


        sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        PRINT(sv_n)

        sv_f = urhk_dbCursorFetch(sv_n)
        PRINT(sv_f)
        WHILE(sv_f == 0)
        #{
                CUST.GCHRG.chrgType=BANCS.OUTPARAM.chrgType
                CUST.GCHRG.eventchrgAmt=BANCS.OUTPARAM.eventchrgAmt
                CUST.GCHRG.chrgpcnt=BANCS.OUTPARAM.chrgpcnt
                CUST.GCHRG.minAmt=BANCS.OUTPARAM.minAmt
                CUST.GCHRG.maxAmt=BANCS.OUTPARAM.maxAmt
                CUST.GCHRG.slabCode=BANCS.OUTPARAM.slabCode
                PRINT(CUST.GCHRG.chrgpcnt)
                PRINT(CUST.GCHRG.minAmt)
                PRINT(CUST.GCHRG.maxAmt)
                PRINT(CUST.GCHRG.eventchrgAmt)
                PRINT(CUST.GCHRG.slabCode)
                IF(CUST.GCHRG.chrgType == "P")THEN
                #{
                        CUST.GCHRG.eventchrgAmt = CDOUBLE(CUST.GCHRG.tranAmt) * CDOUBLE(CUST.GCHRG.chrgpcnt) * (0.01)
                        IF(CUST.GCHRG.eventchrgAmt < CUST.GCHRG.minAmt)THEN
                        #{
                                CUST.GCHRG.eventchrgAmt = CUST.GCHRG.minAmt
                        #}
                        ENDIF
                        IF(CUST.GCHRG.eventchrgAmt > CUST.GCHRG.maxAmt)THEN
                        #{
                                CUST.GCHRG.eventchrgAmt = CUST.GCHRG.maxAmt
                        #}
                        ENDIF
                #}
                ENDIF

                IF(CUST.GCHRG.chrgType == "S")THEN
                #{
                        IF(CUST.GCHRG.slabCode == "")THEN
                        #{
                                sv_q = "Amount slab Code is Not Maintained"
                                CUST.GCHRG.errMsg = CUST.GCHRG.foracid + "|" + sv_q
                                sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
                                PRINT(sv_b)

                        #}
                        ENDIF
                        BANCS.INPARAM.CurrencyCode = CUST.GCHRG.crncy
                        BANCS.INPARAM.AmountTableCode = CUST.GCHRG.slabCode
                        BANCS.INPARAM.InputAmount = CUST.GCHRG.tranAmt
                        PRINT(BANCS.INPARAM.AmountTableCode)
                        PRINT(BANCS.INPARAM.CurrencyCode)
                        PRINT(BANCS.INPARAM.InputAmount)

                        # -----------------------------------------------------------------------------
                        # Amount slab Userhook to determine the COT amount
                        # -----------------------------------------------------------------------------
                        sv_r = urhk_B2k_GetASTMAmount("")
                        print(sv_r)


                        IF (sv_r != 0) THEN
                        #{
                                sv_q="Unable to determine the charge Amount for the table Code:"+CUST.GCHRG.slabCode
                                CUST.GCHRG.errMsg = CUST.GCHRG.foracid + "|" + sv_q
                                sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
                                PRINT(sv_b)
                       #}
                       ENDIF

                       # -----------------------------------------------------------------------------
                       # Charge amount for the account
                       # -----------------------------------------------------------------------------
                       CUST.GCHRG.eventchrgAmt = BANCS.OUTPARAM.OutputAmount
                       print(CUST.GCHRG.eventchrgAmt)
                #}
                ENDIF

                CUST.GCHRG.totalchrgAmt = (CUST.GCHRG.totalchrgAmt) + (CUST.GCHRG.eventchrgAmt)
                sv_f = urhk_dbCursorFetch(sv_n)
                PRINT(sv_f)

        #}
        DO
        sv_p = urhk_dbCursorClose(sv_n)
        PRINT(sv_p)
        CUST.GCHRG.chargeAmt = CUST.GCHRG.totalchrgAmt
	IF(CUST.GCHRG.chargeAmt == 0)THEN
	#{
               sv_q = "Charge Amount is 0"
               CUST.GCHRG.errMsg = CUST.GCHRG.foracid + "|" + sv_q
               sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
               PRINT(sv_b)
               GOTO NEXTREC
	#}
	ENDIF
	
			CUST.GCHRG.drAcctId                     = CUST.GCHRG.foracid
        		CUST.GCHRG.acctCrncyCode                = CUST.GCHRG.actcrncy
        		CUST.GCHRG.eventId                      = CUST.GCHRG.chargevent
        		CUST.GCHRG.chrgAmt                      = CUST.GCHRG.tranAmt + "|" + CUST.GCHRG.actcrncy
        		CUST.GCHRG.tranType                     = "T"
        		CUST.GCHRG.tranSubType                  = "CI"

        		CALL("gchrgcommon.scr")
        		IF(CUST.GCHRG.successOrFailure == "S") THEN
        		#{
                		PRINT(CUST.GCHRG.chargeTranId)
				CUST.GCHRG.errMsg = CUST.GCHRG.foracid  + "|" + CUST.GCHRG.chargeTranId + "|" + "Charge is collected"
				sv_b = urtn_fileWrite(CUST.GCHRG.successFileIndex1 + "|" + CUST.GCHRG.errMsg)
				PRINT(sv_b)
                	#}
        		ELSE
                	#{
                		sv_q = CUST.GCHRG.gchrgErrMsg
				CUST.GCHRG.errMsg = CUST.GCHRG.foracid + "|" + sv_q
				sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
				PRINT(sv_b)
				GOTO NEXTREC
        		#}
        		ENDIF


			
	
			NEXTREC:
				
				sv_z = urhk_dbCursorFetch(CUST.GCHRG.CursorPointer)
				PRINT(sv_z)
				
				CUST.GCHRG.fetchReturn = sv_z
				PRINT(CUST.GCHRG.fetchReturn)
			#}
			DO
			
			sv_a = urhk_dbCursorClose(CUST.GCHRG.CursorPointer)
			PRINT(sv_a)
			
		#}
		ENDIF
		
	ENDOFSCRIPT:
		IF(CUST.GCHRG.errMsg == "") THEN
		#{
			CUST.GCHRG.errMsg = " Other Accounts|Batch Job executed with out any Errors"
			sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
			PRINT(sv_b)
		#}
		ENDIF
		
		sv_c = urtn_fileClose(CUST.GCHRG.failFileIndex1)
		PRINT(sv_c)
		sv_c = urtn_fileClose(CUST.GCHRG.successFileIndex1)
		PRINT(sv_c)
		
		CUST.GCHRG.ERR000002 = "Failed "
		PRINT(CUST.GCHRG.list_file_name)
		sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.GCHRG.mrt_file_name + " " + CUST.GCHRG.list_file_name + " " + CUST.GCHRG.rpt
		PRINT(sv_r)
		sv_r = SYSTEM(sv_r)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.GCHRG.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.GCHRG.rpt_file_name+" '" + CUST.GCHRG.title+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		
		##############
		
		PRINT(CUST.GCHRG.list_file_nameSuccess )
		sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.GCHRG.mrt_file_name1 + " " + CUST.GCHRG.list_file_nameSuccess  + " " + CUST.GCHRG.rptSuccess
		PRINT(sv_r)
		sv_r = SYSTEM(sv_r)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.GCHRG.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.GCHRG.rpt_file_nameSuccess+" '" + CUST.GCHRG.titleSuccess+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		
		
		##############
		
		
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.GCHRG.ERR000002 + "^DATE")
			GOTO FINISH
		#}
		ENDIF
		
		sv_c = urtn_fileClose(CUST.GCHRG.failFileIndex1)
		PRINT(sv_c)
		
		
	FINISH:
		TRACE OFF				
END-->

