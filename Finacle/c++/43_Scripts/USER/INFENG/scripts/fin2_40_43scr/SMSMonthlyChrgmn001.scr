			PRINT(sv_b)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#---------------------------------------------------------------------------
		# Opening the loop to process the records one by one
		#---------------------------------------------------------------------------
		WHILE(CUST.GCHRG.fetchReturn == 0)
		#{
			
			CUST.GCHRG.acid = BANCS.OUTPARAM.acid
			PRINT(CUST.GCHRG.acid)
			CUST.GCHRG.vatFlg = BANCS.OUTPARAM.vatFlg
			PRINT(CUST.GCHRG.vatFlg)
			
			####################################################
			#CPARAM VAT
			####################################################
			
			
			IF(CUST.GCHRG.vatFlg == "Y")THEN
			#{
				
				sv_s = "vatPcnt|select CUSTOM.getCparamValue('VAT_FOR_GCHRG_PCNT','OT',?SVAR)  from dual"
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_r = urhk_dbSelectWithBind(sv_s)
				
				IF(sv_r == 0) THEN
				#{
					CUST.GCHRG.vatPcnt = BANCS.OUTPARAM.vatPcnt
					PRINT (CUST.GCHRG.vatPcnt)
					#}
				ELSE
					#{
					CUST.GCHRG.errMsg = "Error|VAT Percentage is not maintained in CPARAM"
					PRINT(CUST.GCHRG.errMsg)
					sv_b = urtn_fileWrite(CUST.GCHRG.failFileIndex1 + "|" + CUST.GCHRG.errMsg)
					PRINT(sv_b)
					#GOTO ENDOFSCRIPT
					GOTO NEXTREC
				#}
				ENDIF
				#}
			ELSE
				#{
				CUST.GCHRG.vatPcnt = "0"
