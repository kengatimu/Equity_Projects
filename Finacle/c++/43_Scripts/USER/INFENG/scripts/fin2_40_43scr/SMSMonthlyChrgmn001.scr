		#}
		ENDIF
		
		CUST.GCHRG.CursorPointer = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		
		#---------------------------------------------------------------------------
		# Fetching the records from the cursor for processing records
		#---------------------------------------------------------------------------
		sv_z = urhk_dbCursorFetch(CUST.GCHRG.CursorPointer)
		
