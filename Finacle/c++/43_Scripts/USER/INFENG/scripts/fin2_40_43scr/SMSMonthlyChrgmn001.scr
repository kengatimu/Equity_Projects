			sv_s= "foracid|SELECT foracid FROM TBAADM.GAM WHERE ACID=?SVAR AND BANK_ID=?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
			BANCS.INPARAM.BINDVARS = CUST.GCHRG.acid + "|" + BANCS.STDIN.contextBankId
			sv_q = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_q)
			IF(sv_q == 0)THEN
			#{
				CUST.GCHRG.foracid = BANCS.OUTPARAM.foracid
				PRINT(CUST.GCHRG.foracid)
			#}
			ENDIF
			
			###############################################################3
			#SMS Charge collection  - ACCt details and validation
			################################################################
			
			CUST.GCHRG.acct = CUST.GCHRG.foracid
			
			sv_r = urhk_getAcctDetailsInRepository(CUST.GCHRG.foracid)
			IF(sv_r != 0)THEN
			#{
				CUST.GCHRG.remark ="Account is not found"
				sv_q =" Account is not found"
