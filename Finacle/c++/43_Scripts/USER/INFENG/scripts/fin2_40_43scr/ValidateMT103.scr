# Tag 59F validation - start
# The first line must start with number 1 in name and address details of benef cust validation
if (BANCS.INPUT.tag59f2 != "") then
	if(MID$(BANCS.INPUT.tag59f2, 0, 2) != "1/") then
		BANCS.OUTPUT.errorMessage = "The first line in name and address details of benef cust must start with 1/"
    	BANCS.OUTPUT.failedFieldTag = "tag59f2"
    	BANCS.OUTPUT.successOrFailure = "F"
    	exitscript
	endif
endif

# Numbers must appear in numerical order in 59F 
if (BANCS.INPUT.tag59f2 != "") then
    if(MID$(BANCS.INPUT.tag59f2, 0, 2) == "1/") then
	    sv_a= "0"
    	sv_b= "0"
    	sv_c= "0"
    	sv_d= "0"

		sv_a=MID$(BANCS.INPUT.tag59f2, 0, 1)
		if (BANCS.INPUT.tag59f3 != "") then
			sv_b=MID$(BANCS.INPUT.tag59f3, 0, 1)
