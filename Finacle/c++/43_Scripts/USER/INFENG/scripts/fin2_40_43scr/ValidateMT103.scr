		if (LEFT$(sv_c,1) == "/") then
			sv_z = ((STRLEN(sv_c)) - 1)
			BANCS.INPUT.IBANNumber = MID$(sv_c,1,sv_z)
		else
			BANCS.INPUT.IBANNumber = sv_c
		endif

		call(BANCS.OUTPARAM.fileLocation, "validateIBAN.scr") 
		if(BANCS.OUTPUT.successOrFailure == "F") then
    		
			if (sv_c == BANCS.INPUT.tag59a1) then
				BANCS.OUTPUT.errorMessage = "Enter a valid Beneficiary IBAN - Field 59a1"
