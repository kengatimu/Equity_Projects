			sv_q = "count|select count(ref_code) from RCT where"
			sv_q = sv_q + " RCT.BANK_ID = ?SVAR AND "
			sv_q = sv_q + " ref_rec_type = '03' and ltrim(ref_code)=?SVAR "
			BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + sv_l
			sv_q=urhk_dbselectWithBind(sv_q)
			sv_q=BANCS.OUTPARAM.count

			if(sv_q == 0) then
				sv_f  = urhk_getMSGCodeErrDesc("MSG0007282")
				if(sv_f == 0) then
					BANCS.OUTPUT.errorMessage = BANCS.OUTPARAM.errDesc + " " + "-Tag59F"
					BANCS.OUTPUT.successOrFailure = "F"
					BANCS.OUTPUT.failedFieldTag = sv_t 
					exitscript
				endif
				exitscript
			endif
		endif
