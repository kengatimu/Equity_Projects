sv_a = STRLEN(BANCS.INPUT.tag23e1)
if (sv_a >= 4) then
	sv_b = LEFT$(BANCS.INPUT.tag23e1,4)
	if ((sv_b == "CHQB") AND ((BANCS.INPUT.tag59a1 != "") OR (BANCS.INPUT.tag591 != "") OR (BANCS.INPUT.tag59f1 != "")))  then
		BANCS.OUTPUT.errorMessage = "Beneficiary Customer Account must not be entered in this case"
		if (BANCS.INPUT.tag59a1 != "") then
			BANCS.OUTPUT.failedFieldTag = "tag59a1"
		else
		if (BANCS.INPUT.tag591 != "") then
			BANCS.OUTPUT.failedFieldTag = "tag591"
		else
			BANCS.OUTPUT.failedFieldTag = "tag59f1"
		endif
		BANCS.OUTPUT.successOrFailure = "F"
		exitscript
	endif
endif	


