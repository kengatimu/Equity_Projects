##---------------Validations for 13c--------------------------##

#
#
if(fieldexists(BANCS.INPUT.tag13c1)) then
if (BANCS.INPUT.tag13c1 != "") then
    if (LEFT$(BANCS.INPUT.tag13c1,1) != "/") then
        BANCS.OUTPUT.errorMessage = "This field should start with a /"
        BANCS.OUTPUT.failedFieldTag = "tag13c1"
        BANCS.OUTPUT.successOrFailure = "F"
        exitscript
    endif

    sv_a = MID$(BANCS.INPUT.tag13c1,1,7)
    if ((STRICMP(sv_a, "CLSTIME") != 1) AND (STRICMP(sv_a, "RNCTIME") != 1) AND (STRICMP(sv_a, "SNDTIME") != 1)) then
        BANCS.OUTPUT.errorMessage = "Invalid value for field 13C. Valid Codes are CLSTIME, RNCTIME and SNDTIME"
        BANCS.OUTPUT.failedFieldTag = "tag13c1"
        BANCS.OUTPUT.successOrFailure = "F"
        exitscript
    endif

    if (MID$(BANCS.INPUT.tag13c1,8,1) != "/") then
        BANCS.OUTPUT.errorMessage = "A valid code should be succeded by a /"
        BANCS.OUTPUT.failedFieldTag = "tag13c1"
        BANCS.OUTPUT.successOrFailure = "F"
        exitscript
    endif

    sv_b = MID$(BANCS.INPUT.tag13c1,9,4)
    sv_c = MID$(BANCS.INPUT.tag13c1,13,1)
    sv_d = RIGHT$(BANCS.INPUT.tag13c1,4)

	if (sv_b != "") then
		if(urhk_B2k_isStringNumeric(sv_b) == 0) then
			if (CDOUBLE(sv_b) >=0)  then
                sv_e = LEFT$(sv_b,2)
                sv_f = RIGHT$(sv_b,2)
                if ((sv_e < 0) or (sv_e > 12) or (sv_f < 0) or (sv_f > 60)) then
                    BANCS.OUTPUT.errorMessage = "HH must be in the range 00 through 12, and the MM must be in the range 00 through 59"
                    BANCS.OUTPUT.failedFieldTag = "tag13c1"
                    BANCS.OUTPUT.successOrFailure = "F"
                    exitscript
                endif
	    	else
				BANCS.OUTPUT.errorMessage = "Time Offset must be expressed as HHMM"
            	BANCS.OUTPUT.failedFieldTag = "tag13c1"
            	BANCS.OUTPUT.successOrFailure = "F"
            	exitscript	
			endif
		else
			BANCS.OUTPUT.errorMessage = "Time Offset must be expressed as HHMM"
            BANCS.OUTPUT.failedFieldTag = "tag13c1"
            BANCS.OUTPUT.successOrFailure = "F"
            exitscript	
		endif
	endif
	
	if (sv_c != "") then
        if ((sv_c != "+") AND (sv_c != "-")) then
            BANCS.OUTPUT.errorMessage = "Sign can be either (+) or (-)"
            BANCS.OUTPUT.failedFieldTag = "tag13c1"
            BANCS.OUTPUT.successOrFailure = "F"
            exitscript
        endif
	endif

	if (sv_d != "") then
		if(urhk_B2k_isStringNumeric(sv_d) == 0) then
			if (CDOUBLE(sv_d) >=0)  then
                sv_e = LEFT$(sv_d,2)
                sv_f = RIGHT$(sv_d,2)
                if ((sv_e < 0) or (sv_e > 12) or (sv_f < 0) or (sv_f > 60)) then
                    BANCS.OUTPUT.errorMessage ="HH must be in the range 00 through 12, and the MM must be in the range 00 through 59"
                    BANCS.OUTPUT.failedFieldTag = "tag13c1"
                    BANCS.OUTPUT.successOrFailure = "F"
                    exitscript
                endif
	    	else
				BANCS.OUTPUT.errorMessage = "Time Offset must be expressed as HHMM"
            	BANCS.OUTPUT.failedFieldTag = "tag13c1"
            	BANCS.OUTPUT.successOrFailure = "F"
            	exitscript	
			endif
		else
			BANCS.OUTPUT.errorMessage = "Time Offset must be expressed as HHMM"
            BANCS.OUTPUT.failedFieldTag = "tag13c1"
            BANCS.OUTPUT.successOrFailure = "F"
            exitscript	
		endif
	endif
endif
endif
#
#

##-------------End of Validations for 13c--------------------##


