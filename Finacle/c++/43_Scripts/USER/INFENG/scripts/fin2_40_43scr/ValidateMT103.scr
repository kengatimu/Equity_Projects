#------------------- Start of Validation for Multirec Fields ------------------# 
    
   MULTIREC: 
    
   #----------------------- Validation for Mandatory Fields ----------------------# 
    
   #For old messages 71F handling 
   if (FIELDEXISTS(BANCS.INPUT.tag71f2_1) == 0) then 
   #{ 
           GOTO ENDOFSCRIPT 
   #} 
endif
 sv_u = 1 
   sv_w = "" 
   while (fieldexists (("BANCS").("INPUT").("tag71f2_" + FORMAT$(sv_u,"%d")))) 
   #{ 
           sv_w =  (("BANCS").("INPUT").("tag71f2_" + FORMAT$(sv_u,"%d"))) 
           sv_x = ltrim(rtrim(Mid$(sv_w,0,17))) 
           sv_u = sv_u +1 
           sv_g = STRLEN(sv_x) 
    
           if (sv_g > 15) then 
           #{ 
                   BANCS.OUTPUT.errorMessage = "Sender's charge amount is too large." 
                   BANCS.OUTPUT.failedFieldTag = "tag71f2_1" 
                   BANCS.OUTPUT.successOrFailure = "F" 
                   exitscript 
           #} 
           endif 
   #} 
   do 
    
   if((BANCS.INPUT.tag71a1 == "OUR") AND (CDOUBLE(ltrim(rtrim(Mid$(BANCS.INPUT.tag71f2_1,0,17)))) != 0)) then 
   #{ 
           BANCS.OUTPUT.errorMessage = "Sender's charge must not be entered when Dtls of Charge is OUR." 
           BANCS.OUTPUT.failedFieldTag = "tag71f1_1" 
           BANCS.OUTPUT.successOrFailure = "F" 
           exitscript 
   #} 
   endif 
    
   ENDOFSCRIPT: 

BANCS.OUTPUT.errorMessage = ""
BANCS.OUTPUT.failedFieldTag = ""
BANCS.OUTPUT.successOrFailure = "S"

exitscript
