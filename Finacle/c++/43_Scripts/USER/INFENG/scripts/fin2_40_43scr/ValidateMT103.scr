		sv_e = sv_a + sv_b + sv_c + sv_d
# To check if number 2, 3  is present in  details string
		sv_f = getPosition(sv_e, "2")
		sv_g = getPosition(sv_e, "3")
# Number 2 must not be used without number 3 for Tag 59F
		if (((sv_f != "0") and (sv_g == "0"))) then
			BANCS.OUTPUT.errorMessage = "Number 2 must not be used without number 3 in name and address details of benef cust"
