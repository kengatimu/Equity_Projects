sv_b =  BANCS.INPUT.tag591
print(sv_b)
sv_x = strlen(sv_b)
sv_g = MID$(sv_b, 1, sv_x+1)
print(sv_g)

    sv_s = " func_code | select func_code from ga0 where "
	sv_s = sv_s + " ga0.BANK_ID =?SVAR AND "
	sv_s = sv_s + " acid =  "
    sv_f = " ( select acid from gam where "
	sv_f = sv_f + " gam.BANK_ID = ?SVAR AND "
	sv_f = sv_f + " foracid = ?SVAR)"
    sv_q = sv_s + sv_f
    BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + sv_g
	sv_r = urhk_dbselectWithBind(sv_q)

    IF (sv_r == 0) THEN
        IF (BANCS.OUTPARAM.func_code == "Z") THEN
            BANCS.OUTPUT.errorMessage = " Beneficiary account closure verification is pending."
            BANCS.OUTPUT.failedFieldTag = "tag591"
            BANCS.OUTPUT.successOrFailure = "F"
            exitscript
        ENDIF
    ENDIF

