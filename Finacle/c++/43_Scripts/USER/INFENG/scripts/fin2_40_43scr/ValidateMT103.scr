if (((BANCS.INPUT.tag23b1 == "SPRI") OR (BANCS.INPUT.tag23b1 == "SSTD") OR                           (BANCS.INPUT.tag23b1 == "SPAY")) AND ((BANCS.INPUT.tag57b1 != "") OR                              (BANCS.INPUT.tag57b2 != ""))) then
#then{
	BANCS.OUTPUT.errorMessage = "Field 57B must not be entered for this Bank Operation Code(23B)."
	BANCS.OUTPUT.failedFieldTag = "tag57b1"
	BANCS.OUTPUT.successOrFailure = "F"
