if (((BANCS.INPUT.tag55a1 != "") OR (BANCS.INPUT.tag55a2 != "") OR (BANCS.INPUT.tag55b1 != "")       OR (BANCS.INPUT.tag55b2 != "") OR (BANCS.INPUT.tag55d1 != "") OR (BANCS.INPUT.tag55d2 != "")      OR (BANCS.INPUT.tag55d3 != "") OR (BANCS.INPUT.tag55d4 != "") OR (BANCS.INPUT.tag55d5 != ""))     AND ((BANCS.INPUT.tag54a1 == "") AND (BANCS.INPUT.tag54a2 == "") AND                              (BANCS.INPUT.tag54b1 == "") AND (BANCS.INPUT.tag54b2 == "") AND (BANCS.INPUT.tag54d1 == "") AND   (BANCS.INPUT.tag54d2 == "") AND (BANCS.INPUT.tag54d3 == "") AND (BANCS.INPUT.tag54d4 == "") AND   (BANCS.INPUT.tag54d5 == "")))  then 
