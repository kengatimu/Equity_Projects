        if (BANCS.INPUT.tag59f5 != "") then
        	sv_d=MID$(BANCS.INPUT.tag59f5, 0, 1)
        endif
		if(((sv_a != "0") and (sv_b != "0")) and (sv_a > sv_b)) then
    		BANCS.OUTPUT.errorMessage = "The numbers must appear in numerical order in name and address details of benef cust"
    		BANCS.OUTPUT.failedFieldTag = "tag59f2"
    		BANCS.OUTPUT.successOrFailure = "F"
    		exitscript
    	endif
