<--START
CHECKSUM="d36dae7e69960197e008689cb27c6a8e94e91fa0adc6580a6dab695e961f8e88"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# Initializing Out Variables
	#-----------------------------------------------------------------------------------------------
	sv_u = urhk_SetOrbOut("Error| ")
	sv_u = urhk_SetOrbOut("brCode| ")
	
	#----------------------------------------------------------------
	# Getting parameter value for BRCODE---000
	#----------------------------------------------------------------
	BANCS.INPUT.moduleName = "LOANDISB"
	BANCS.INPUT.parameterId = "BRCODE"
	CALL ("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.brCode = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.brCode)
		print(BANCS.STDIN.myBrCode)
		
		IF (BANCS.STDIN.myBrCode != CUST.CPARAM.brCode) THEN
		#{
			sv_u = urhk_SetOrbOut("brCode|"+CUST.CPARAM.brCode)
		#}
		ENDIF
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("Error|CPARAM setup is not done for BRCODE")
	#}
	ENDIF
	
	EXITSCRIPT
END-->
