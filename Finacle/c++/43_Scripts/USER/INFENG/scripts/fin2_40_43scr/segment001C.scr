<--start
TRACE ON
sv_k=""
sv_y=""
sv_w=""

sv_q="cifid,segment,subsegment|"
sv_q = sv_q + " select FORACID,CLASSTO,CLASSFROM from custom.int_credit  where bank_id='C'  "
print(sv_q)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

if(sv_e==0) then
       sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        sv_q = urhk_dbCursorFetch(sv_m)
        print(sv_q)
        if(sv_q == 1) then
               sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        endif
        print(sv_q)
        while(sv_q==0)
			##################
			# Get account balance as on BOD date.

			sv_a=BANCS.OUTPARAM.cifid
			print(sv_a)
			sv_w = sv_a
			print(sv_w)
			sv_c=BANCS.OUTPARAM.segment
			print(sv_c)
			sv_b=BANCS.OUTPARAM.subsegment
			print(sv_b)
			IF (sv_c=="RETAIL") THEN
				IF (sv_b=="1") THEN
					sv_b ="LOW INCOME  1"
					print(sv_b)
				ENDIF
				IF (sv_b=="2") THEN
					sv_b ="LOWER MIDDLE INCOME 2"
					print(sv_b)
				ENDIF
				IF (sv_b=="3") THEN
					sv_b ="UPPER MIDDLE INCOME 3"
					print(sv_b)
				ENDIF
				IF (sv_b=="4") THEN
					sv_b ="HIGH NET WORTH 4"
					print(sv_b)
				ENDIF
			ENDIF
			IF (sv_c=="BUSINESS") THEN
				IF (sv_b=="1") THEN
					sv_b ="BUSINESS MICRO 1"
					print(sv_b)
				ENDIF
				IF (sv_b=="2") THEN
					sv_b ="BUSINESS LOWER SME 2"
					print(sv_b)
				ENDIF
				IF (sv_b=="3") THEN
					sv_b ="BUSINESS UPPER SME 3"
					print(sv_b)
				ENDIF
				IF (sv_b=="4") THEN
					sv_b ="BUSINESS COOPERATE 4"
					print(sv_b)
				ENDIF
			ENDIF

			sv_s = "segmentationclass,subsegment|select SEGMENTATION_CLASS,SUBSEGMENT from crmuser.accounts where bank_id='54'  and orgkey=?SVAR and rownum<2 "
			BANCS.INPARAM.BINDVARS =  sv_a
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				print(BANCS.OUTPARAM.segmentationclass)
				print(BANCS.OUTPARAM.subsegment)
				IF (sv_a!="") THEN
					BANCS.INPARAM.BINDVARS = sv_c + "|" + sv_b + "|" + BANCS.OUTPARAM.segmentationclass + "|" + BANCS.OUTPARAM.subsegment + "|" + sv_a + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					sv_j = "update crmuser.accounts set SEGMENTATION_CLASS =?SVAR ,SUBSEGMENT=?SVAR,STRFIELD14=?SVAR ,STRFIELD15=?SVAR where orgkey=?SVAR  and bank_id=?SVAR and rownum<2 "
					sv_w = urhk_dbSQLWithBind(sv_j)
					sv_w = urhk_dbSQLWithBind("COMMIT")
					print(sv_j)
					sv_k="P"
				ELSE
					sv_k="F"
				ENDIF
			ELSE
				sv_k="F"
			ENDIF
			##################
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)
			sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			BANCS.INPARAM.BINDVARS =  sv_h
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				print(BANCS.OUTPARAM.getboddate)
				sv_y = BANCS.OUTPARAM.getboddate
				print(sv_y)

				sv_k="P"
				print(sv_k)
				BANCS.INPARAM.BINDVARS = sv_k + "|" + sv_y + "|" + sv_a
				print(BANCS.INPARAM.BINDVARS)
				sv_j = "update  custom.int_credit  set BANK_ID =?SVAR,TRAN_DATE=?SVAR where BanK_id='C' and foracid=?SVAR  "
				sv_w = urhk_dbSQLWithBind(sv_j)
				sv_w = urhk_dbSQLWithBind("COMMIT")
				print(sv_j)
			ENDIF

		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
        do
TRACE OFF
EXITSCRIPT

end-->
