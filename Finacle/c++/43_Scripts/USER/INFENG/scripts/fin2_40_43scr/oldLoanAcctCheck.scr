<--START
TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
        	CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
        	CREATECLASS ("CUST","DATA",5)
	#}
	ENDIF

        CUST.DATA.flg = "N"
        CUST.DATA.loanAcctId = " "

        IF(FIELDEXISTS(BANCS.INPUT.loanAcctId))THEN
        #{
                IF(BANCS.INPUT.loanAcctId !="")THEN
                #{
                        CUST.DATA.loanAcctId = TOUPPER(TRIM(BANCS.INPUT.loanAcctId))
                        PRINT(CUST.DATA.loanAcctId)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_a = "count|SELECT COUNT(*) FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND CIF_ID = (SELECT CIF_ID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR)"
	sv_a = sv_a + " AND FORACID != ?SVAR AND SCHM_TYPE='LAA' AND ENTITY_CRE_FLG='Y' AND DEL_FLG='N' AND ACCT_CLS_FLG='N'"
        PRINT(sv_a)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.loanAcctId+ "|" + CUST.DATA.loanAcctId

        sv_d = urhk_dbSelectWithBind(sv_a)
        PRINT(sv_a)
        PRINT(sv_d)

        IF(sv_d == 0) THEN
        #{
                PRINT(BANCS.OUTPARAM.count)
                CUST.DATA.count = BANCS.OUTPARAM.count
        #}
        ENDIF


	IF(CUST.DATA.count > 0 )THEN
	#{
		CUST.DATA.flg = "Y"
                GOTO ENDOFSCRIPT
        #}
        ENDIF


ENDOFSCRIPT:
        sv_u = urhk_SetOrbOut("flg|"+CUST.DATA.flg)
TRACE OFF
END-->
