					lv_s = lv_s + " BANK_ID ='"+BANCS.STDIN.contextBankId+"' and EVENT_TYPE='GCHRG' and EVENT_ID = '"+CHRG.TXN.CWNOINSTR+"' and rownum = 1 "
					print(lv_s)
					
					lv_q = urhk_dbSelectWithBind(lv_s)
					print(lv_q)
					
					IF(lv_q == 0)THEN
					#{
						CHRG.TXN.chrg_min_amt = BANCS.OUTPARAM.chrg_min_amt
						PRINT(CHRG.TXN.chrg_min_amt)
						CHRG.TXN.chrg_max_amt = BANCS.OUTPARAM.chrg_max_amt
						PRINT(CHRG.TXN.chrg_max_amt)
						
						lv_s = "minCheck| SELECT CASE WHEN TO_NUMBER('"+CUST.PREF.scheme_chrg_Amt+"') < TO_NUMBER('"+CHRG.TXN.chrg_min_amt+"') THEN 'L' ELSE 'G' END FROM DUAL"
						print(lv_s)
						lv_q = urhk_dbSelectWithBind(lv_s)
						print(lv_q)
						
						CHRG.TXN.minCheck = ""
						
						IF(lv_q ==0)THEN
							CHRG.TXN.minCheck = BANCS.OUTPARAM.minCheck
						ENDIF
						
						IF(CHRG.TXN.minCheck == "L")THEN
							CUST.PREF.scheme_chrg_Amt = CHRG.TXN.chrg_min_amt
						ENDIF
						
						
						lv_s = "maxCheck| SELECT CASE WHEN TO_NUMBER('"+CUST.PREF.scheme_chrg_Amt+"') > TO_NUMBER('"+CHRG.TXN.chrg_max_amt+"') THEN 'G' ELSE 'L' END FROM DUAL"
						print(lv_s)
						lv_q = urhk_dbSelectWithBind(lv_s)
						print(lv_q)
						
						CHRG.TXN.maxCheck = ""
						
						IF(lv_q ==0)THEN
							CHRG.TXN.maxCheck = BANCS.OUTPARAM.maxCheck
						ENDIF
						
						IF(CHRG.TXN.maxCheck == "G")THEN
							CUST.PREF.scheme_chrg_Amt = CHRG.TXN.chrg_max_amt
						ENDIF
				
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}	
	ELSE
	#{
