	sv_s = sv_s + " EVENT_ID IN '"+CHRG.TXN.eventId+"' AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y' AND SCHM_CODE ='"+CHRG.TXN.schmCode+"' AND CRNCY_CODE='"+CHRG.TXN.evntChrgCrncy+"' "
	sv_s = sv_s + " AND BANK_ID='"+BANCS.STDIN.contextBankId+"' and SRL_NUM IN (SELECT SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+CHRG.TXN.eventId+"' AND  "
	sv_s = sv_s + " EVENT_TYPE='GCHRG' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"') AND ROWNUM = 1"
