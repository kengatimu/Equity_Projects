		#{
			PRINT("Zero charge")
			CUST.PREF.scheme_chrg_Amt = CDOUBLE("0")
		#}
		ENDIF
		
		IF((lv_m == "F") AND (lv_n == "C0"))THEN
		#{
			PRINT("Zero charge")
			CUST.PREF.scheme_chrg_Amt = CDOUBLE("0")
		#}
		ENDIF
		
		IF((lv_m == "P") AND (lv_n == "C0"))THEN
		#{
			print(lv_o)
			IF(lv_o != "")THEN
			#{
				CHRG.TXN.temp = (CDOUBLE(CHRG.TXN.refAmt) * CDOUBLE(lv_o)) / 100
				PRINT(CHRG.TXN.temp)
				CUST.PREF.scheme_chrg_Amt = CHRG.TXN.temp
