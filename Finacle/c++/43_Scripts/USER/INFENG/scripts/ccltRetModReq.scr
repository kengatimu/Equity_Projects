        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</CustModData>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</RetCustModMainData>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</RetCustModRq>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</RetCustModRequest>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</Body>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</FIXML>"
        print(CUST.CRMREQ.XmlMessage)

            
        BANCS.INPARAM.SERVICE_NAME="FIJCA"
        BANCS.INPARAM.SEND_RECV_FLG="R"
        sv_l=urhk_ConnectToFIAndSendMsg(CUST.CRMREQ.XmlMessage)
        print(sv_l)

        if(fieldexists(BANCS.OUTPARAM.ErrCode)==1)then
        #{
            print(BANCS.OUTPARAM.ErrCode)
        #}
        endif
        if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
        #{
            print(BANCS.OUTPARAM.ErrMsg)
        #}
        endif

        if(fieldexists(BANCS.OUTPARAM.RespMesg))then
        #{
            print("Response message is ["+BANCS.OUTPARAM.RespMesg+"]")
            sv_d = BANCS.OUTPARAM.RespMesg
            sv_l = strlen(sv_d)
            CUST.CRMREQ.Response = BANCS.OUTPARAM.RespMesg
            CUST.CRMREQ.Status = GETPOSITION(CUST.CRMREQ.Response,"<Status>")
            print(CUST.CRMREQ.Status)
            
            if (CUST.CRMREQ.Status != "") then
            #{
                CUST.CRMREQ.Status1 = GETPOSITION(CUST.CRMREQ.Response,"</Status>")
                print(CUST.CRMREQ.Status1)
                CUST.CRMREQ.StatusFlag= mid$(CUST.CRMREQ.Response,cint(CUST.CRMREQ.Status)+7,cint(CUST.CRMREQ.Status1)-cint(CUST.CRMREQ.Status)-8)
                print(CUST.CRMREQ.StatusFlag)
            #}
            else
            #{
                CUST.CRMREQ.StatusFlag = ""
            #}
            endif
        IF(trim(CUST.CRMREQ.StatusFlag)=="SUCCESS")THEN
		#{
			CUST.CRMREQ.SuccessOrFailure = "S"
			print("CIF Verification Success")
		#}
		ENDIF
		if(trim(CUST.CRMREQ.StatusFlag)!="SUCCESS")THEN
		#{
			CUST.CRMREQ.SuccessOrFailure = "F"
			print("CIF Verification failed")
			
			#----- Error Capturing Starts
			
			sv_x = CUST.CRMREQ.Response
			sv_y = "<ErrorCode>"
			sv_z = "</ErrorCode>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.CRMREQ.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
				print(CUST.CRMREQ.errorCode)
			#}
			ENDIF
			sv_x = CUST.CRMREQ.Response
			sv_y = "<ErrorDesc>"
			sv_z = "</ErrorDesc>"
			sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
			sv_e = GETPOSITION(sv_x, sv_z) - 1
			IF (GETPOSITION(sv_x, sv_y) != 0) THEN
			#{
				CUST.CRMREQ.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
				print(CUST.CRMREQ.errorDesc)
			#}
			ENDIF

			
			#----- Error Capturing Ends
			
		#}
		ENDIF


	#}
	else
	#{
		if(fieldexists(BANCS.OUTPARAM.ErrCode)==1)then
		#{
			print(BANCS.OUTPARAM.ErrCode)
			CUST.CRMREQ.SuccessOrFailure = "F"
		#}
		endif
		if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
		#{
			print(BANCS.OUTPARAM.ErrMsg)
			CUST.CRMREQ.SuccessOrFailure = "F"
		#}
		endif
		CUST.CRMREQ.SuccessOrFailure = "F"
	#}
	endif
	

        EXITSCRIPT
        TRACE OFF	
                
        end-->        