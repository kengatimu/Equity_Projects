			if(CUST.CRMREQ.staffFlag == "Y")then
				CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<StaffEmployeeID>"+CUST.CRMREQ.staffEmployeeID+"</StaffEmployeeID>"
