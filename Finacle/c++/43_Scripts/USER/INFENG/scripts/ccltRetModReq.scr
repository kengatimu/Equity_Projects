        ##.3
			sv_d = "count|select count(*)  from crmuser.categories c,  crmuser.category_lang l  where L.bank_id=c.bank_id and l.CATEGORYID=c.CATEGORYID"
			sv_d = sv_d + " and c.bank_id=?SVAR and LOCALECODE='en_US' and CATEGORYTYPE like '%SEGMENT' "
			sv_d = sv_d + " and value = ?SVAR and  value !='.' "
			print(sv_d)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CRMREQ.subSegment
