							CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<PhoneOrEmail>"+CUST.CRMREQ.PHONEOREMAIL1+"</PhoneOrEmail>"
							CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<PrefFlag>Y</PrefFlag>"
