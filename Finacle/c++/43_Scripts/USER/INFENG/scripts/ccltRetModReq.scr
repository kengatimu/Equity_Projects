<--start
trace on
        if(repexists("CUST") == 0) then
                createrep("CUST")
        endif
        if (classexists("CUST", "CRMREQ") == 0) then
                createclass("CUST", "CRMREQ", 5)
        endif
        
	
        #----------------------------------------------------------------------
        # Printing Bancs Repository
        #----------------------------------------------------------------------

            sv_x = urhk_B2k_PrintRepos("BANCS")
            print(sv_x)



        CUST.CRMREQ.cif_id = trim(CUST.CCLT.customerId)
        print(CUST.CRMREQ.cif_id)
        CUST.CRMREQ.cltId = trim(CUST.CCLT.cltId)
        print(CUST.CRMREQ.cltId)

        sv_o = "state,StatusCode,PlaceofBirth,subSegment,staffEmployeeID,defaultaddressType,manager,SECONDARYRM_ID,managerID,emailAccounts,zip,PRIMARY_SOL_ID,RELATIONSHIPMGRID,staffFlag"
	    sv_o = sv_o + " |select state,status_code,placeofbirth,subsegment,staffEmployeeID,defaultaddresstype,manager,SECONDARYRM_ID,relationshipmgrid,a.email,zip,"
	    sv_o = sv_o + " a.PRIMARY_SOL_ID,RELATIONSHIPMGRID,staffFlag"
        sv_o = sv_o + " from crmuser.accounts a where a.bank_id ='43'"
	    sv_o = sv_o + " and a.orgkey = ?SVAR "
        print(sv_o)
        BANCS.INPARAM.BINDVARS = CUST.CRMREQ.cif_id  
        PRINT(BANCS.INPARAM.BINDVARS)
        sv_d = urhk_dbSelectWithBind(sv_o)
        
        if(sv_d ==0)then
			CUST.CRMREQ.state = BANCS.OUTPARAM.state
			PRINT(CUST.CRMREQ.state)
			sv_n = "18"
			CUST.CRMREQ.StatusCode = BANCS.OUTPARAM.StatusCode
			print(CUST.CRMREQ.StatusCode) 
			
			CUST.CRMREQ.PlaceofBirth = BANCS.OUTPARAM.PlaceofBirth
			print(CUST.CRMREQ.PlaceofBirth)
			#sv_n = "KIN"
			CUST.CRMREQ.subSegment  = BANCS.OUTPARAM.subSegment
			print(CUST.CRMREQ.subSegment)
			#sv_o = "MIDDLE"
			CUST.CRMREQ.staffEmployeeID = BANCS.OUTPARAM.staffEmployeeID
			print(CUST.CRMREQ.staffEmployeeID)
			CUST.CRMREQ.defaultaddressType = BANCS.OUTPARAM.defaultaddressType
			print(CUST.CRMREQ.defaultaddressType)
			sv_p = "Mailing"
			CUST.CRMREQ.manager = BANCS.OUTPARAM.manager
			print(CUST.CRMREQ.manager)
			CUST.CRMREQ.SECONDARYRM_ID = BANCS.OUTPARAM.SECONDARYRM_ID
			print(CUST.CRMREQ.SECONDARYRM_ID)
			CUST.CRMREQ.managerID = BANCS.OUTPARAM.managerID
			print(CUST.CRMREQ.managerID)
			CUST.CRMREQ.emailAccounts = BANCS.OUTPARAM.emailAccounts
			print(CUST.CRMREQ.emailAccounts)
			CUST.CRMREQ.zip  = BANCS.OUTPARAM.zip
			print(CUST.CRMREQ.zip)


			#RELATIONSHIPMGRID
			CUST.CRMREQ.RELATIONSHIPMGRID = BANCS.OUTPARAM.RELATIONSHIPMGRID
			print(CUST.CRMREQ.RELATIONSHIPMGRID)
			CUST.CRMREQ.staffFlag = BANCS.OUTPARAM.staffFlag
			print(CUST.CRMREQ.staffFlag)
			CUST.CRMREQ.PRIMARY_SOL_ID = BANCS.OUTPARAM.PRIMARY_SOL_ID
			print(CUST.CRMREQ.PRIMARY_SOL_ID)			

	    endif

        ##ADDRESS DETAILS

            sv_s = "ADDRESSID,ADDRESSCATEGORY, CITY, STATE,COUNTRY , ZIP | select  ADDRESSID,ADDRESSCATEGORY, city, state,country , zip from CRMUSER.address"
            sv_s = sv_s + " where orgkey  = ?SVAR and   PREFERREDADDRESS  ='Y' and bank_id = ?SVAR and rownum = 1 "
            print(sv_s)
            BANCS.INPARAM.BINDVARS = CUST.CRMREQ.cif_id   + "|" + BANCS.STDIN.contextBankId
            PRINT(BANCS.INPARAM.BINDVARS)
            sv_d = urhk_dbSelectWithBind(sv_s)
            IF(sv_d == 0) THEN
                CUST.CRMREQ.ADDRESSID = BANCS.OUTPARAM.ADDRESSID
                CUST.CRMREQ.ADDRESSCATEGORY = BANCS.OUTPARAM.ADDRESSCATEGORY
                CUST.CRMREQ.STATE = BANCS.OUTPARAM.STATE
                CUST.CRMREQ.COUNTRY = BANCS.OUTPARAM.COUNTRY
                CUST.CRMREQ.CITY = BANCS.OUTPARAM.CITY
                CUST.CRMREQ.ZIP = BANCS.OUTPARAM.ZIP
            ENDIF





        CUST.CRMREQ.chanelCode = "CRM"
        CUST.CRMREQ.SuccessOrFailure = "F"
        
        CUST.CRMREQ.Approval = "Y"
	

        sv_a = "messagedatatime,reqUUId,timeStampFF3|SELECT to_char(systimestamp,'yyyy-mm-ddhh:mi:ssxff'),regexp_replace(rawtohex(sys_guid()),'([A-F0-9]{8})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{12})', '\1-\2-\3-\4-\5'),to_char(systimestamp,'DD-MM-YYYY HH24:MI:SS:FF3') from dual"
        sv_b = urhk_dbSelectWithBind(sv_a)
	    print(sv_b)
        
        if(sv_b == 0)then
        #{
                CUST.CRMREQ.reqUUId = BANCS.OUTPARAM.reqUUId
                print(CUST.CRMREQ.reqUUId)
                CUST.CRMREQ.messagedatatime = BANCS.OUTPARAM.messagedatatime
                print(CUST.CRMREQ.messagedatatime)
                CUST.CRMREQ.tt = MID$(CUST.CRMREQ.messagedatatime,0,10)
                CUST.CRMREQ.ttt = MID$(CUST.CRMREQ.messagedatatime,10,12)
                CUST.CRMREQ.messagedatatime = CUST.CRMREQ.tt + "T" + CUST.CRMREQ.ttt
                BANCS.INPARAM.SYSDATE = BANCS.OUTPARAM.timeStampFF3
                print(BANCS.INPARAM.SYSDATE)

        #}
        else
        #{
                CUST.CRMREQ.messagedatatime = "2022-01-11T15:18:54.167"
		        CUST.CRMREQ.reqUUId = ""
        #}

        endif

        if(CUST.CRMREQ.reqUUId=="")then
		    CUST.CRMREQ.RequestUUID =BANCS.INPARAM.SYSDATE
	    else
		    CUST.CRMREQ.RequestUUID = CUST.CRMREQ.reqUUId
	    endif

        BANCS.INPARAM.milliSec = MID$(BANCS.INPARAM.SYSDATE,20,3)
        BANCS.INPARAM.Day = LEFT$(BANCS.INPARAM.SYSDATE,2)
        BANCS.INPARAM.Month = MID$(BANCS.INPARAM.SYSDATE,3,2)
        BANCS.INPARAM.Year = MID$(BANCS.INPARAM.SYSDATE,8,2)
        BANCS.INPARAM.MesgYear = MID$(BANCS.INPARAM.SYSDATE,6,4)
        BANCS.INPARAM.Hour = MID$(BANCS.INPARAM.SYSDATE,11,2)
        BANCS.INPARAM.Minute = MID$(BANCS.INPARAM.SYSDATE,14,2)
        BANCS.INPARAM.Second = MID$(BANCS.INPARAM.SYSDATE,17,2)

        BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second + BANCS.INPARAM.milliSec
	    BANCS.INPARAM.MESSAGEDATETIME = BANCS.INPARAM.MesgYear + "-" + BANCS.INPARAM.Month + "-" + BANCS.INPARAM.Day + "T" + BANCS.INPARAM.Hour + ":" +  BANCS.INPARAM.Minute + ":" + BANCS.INPARAM.Second + "."+BANCS.INPARAM.milliSec

        BANCS.INPARAM.UserId = BANCS.STDIN.userId
        BANCS.INPARAM.BANKID = BANCS.STDIN.contextBankId
        BANCS.INPARAM.REQUESTUUID = CUST.CRMREQ.RequestUUID 
        
        BANCS.INPARAM.SERVICEREQUESTID = "RetCustMod" 
        BANCS.INPARAM.CHANNELID = "CRM"
        BANCS.INPARAM.SERVICEREQUESTVERSION = "10.2"
        BANCS.INPARAM.TIMEZONE = "EAT+05:30"
        BANCS.INPARAM.UserApplId = "CRM"
        BANCS.INPARAM.UserChannelId = "FI"
        BANCS.INPARAM.SERVICE_NAME = "FIJCA"
        BANCS.INPARAM.SEND_RECV_FLG = "R"

            
        CUST.CRMREQ.fiChnId	= "CRM"
        CUST.CRMREQ.XmlMessage = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"				
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<?xml version='1.0' encoding='UTF-8'?>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<FIXML xsi:schemaLocation='http://www.finacle.com/fixml executeFinacleScript.xsd' xmlns='http://www.finacle.com/fixml' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'><Header>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RequestHeader>" 
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<MessageKey>" 
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RequestUUID>"+CUST.CRMREQ.RequestUUID+"</RequestUUID>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ServiceRequestId>"+BANCS.INPARAM.SERVICEREQUESTID+"</ServiceRequestId>" 
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ServiceRequestVersion>"+BANCS.INPARAM.SERVICEREQUESTVERSION+"</ServiceRequestVersion>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ChannelId>"+CUST.CRMREQ.fiChnId+"</ChannelId>" 
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<LanguageId></LanguageId>" 
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</MessageKey>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RequestMessageInfo>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<BankId>"+BANCS.STDIN.contextBankId+"</BankId>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<TimeZone></TimeZone>" 
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<EntityId></EntityId>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<EntityType></EntityType>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ArmCorrelationId></ArmCorrelationId>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<MessageDateTime>"+CUST.CRMREQ.messagedatatime+"</MessageDateTime>" 
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</RequestMessageInfo>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</RequestHeader>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</Header>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<Body>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RetCustModRequest>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RetCustModRq>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RetCustModMainData>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<CustModData>"
        CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<SUBMITFORKYC />"
        ### query for category value validation state.
        ##.1
        sv_d = "count|select count(*) from crmuser.categories c,  crmuser.category_lang l  where L.bank_id=c.bank_id and l.CATEGORYID=c.CATEGORYID"
        sv_d = sv_d + " and c.bank_id=?SVAR and LOCALECODE='en_US' and CATEGORYTYPE like '%STATE'  "
        sv_d = sv_d + " and value = ?SVAR  and value !='.' "

        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CRMREQ.state
        print(BANCS.INPARAM.BINDVARS)

        sv_u = urhk_dbSelectWithBind(sv_d)
        PRINT(sv_u)	
                
        if(sv_u == 0)then
            sv_a = BANCS.OUTPARAM.count
            if(sv_a == 0)then
            CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<State>"+sv_n+"</State>"			
            endif
        endif
        

    	##.2
			#CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<PlaceofBirth>"+CUST.CRMREQ.PlaceofBirth+"</PlaceofBirth>"

			#sv_d = "count|select count(*) from crmuser.categories c,  crmuser.category_lang l  where L.bank_id=c.bank_id"
