<--START
CHECKSUM="241077deeab9cbb9e4c1515546cbf9adfad83c186db837736eac8aa8569ed600"
TRACE ON
#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
sv_u = urhk_b2k_printrepos("BANCS")
print(sv_u)

IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","WITH") == 0) THEN
#{
        CREATECLASS("CUST","WITH",5)
#}
ENDIF
CUST.WITH.BodDate =  mid$(BANCS.STDIN.BODDate,0,10)
print(CUST.WITH.BodDate)

sv_d = "StartDate|select to_char (to_date(?SVAR,'DD-MM-YYYY') - 0,'DD-MON-YYYY')  as StartDate FROM dual"
BANCS.INPARAM.BINDVARS = CUST.WITH.BodDate
print(sv_d)
print(BANCS.INPARAM.BINDVARS)
sv_u = urhk_dbSelectWithBind(sv_d)
if(sv_u==0)then
#{
    CUST.WITH.StartDate =BANCS.OUTPARAM.StartDate
    print(CUST.WITH.StartDate)

#}
endif

sv_s = "acid,solid,foracid,acctname,schmtype,schmcode,acctcrncy,clramt,intdd ,operacct,vat,clrbalop,NARRATION |"
sv_s = sv_s + " select acid,sol_id,foracid,acct_name,schm_type,schm_code,acct_crncy_code,clr_bal_amt,ADJ_AMT ,opereative_account , VAT_TO_COLLECT  ,clr_bal_amt_Op,NARRATION   from   "
sv_s = sv_s + " ((select  a.acid, a.sol_id ,foracid, a.acct_name , a.schm_type , a.schm_code, a.acct_crncy_code,a.clr_bal_amt ,c.ADJ_AMT , (select foracid from tbaadm.gam g where g.bank_id='43' and g.acid=b.op_acid) opereative_account,(0.16*ADJ_AMT)  VAT_TO_COLLECT,  "
sv_s = sv_s + " (select clr_bal_amt from tbaadm.gam s where s.bank_id='43' and s.acid=b.op_acid) clr_bal_amt_Op, concat  ( to_char (to_date(tran_date,'DD-MM-RRRR'),'DD-MM-RR') , concat  ( '/', concat( trim(tran_id) , concat  ( '/' ,trim (PART_TRAN_SRL_NUM))))) NARRATION  "
sv_s = sv_s + " from tbaadm.gam a , tbaadm.lam b, tbaadm.ldah  c where a.acid =b.acid  and  a.acid =c.acid and  a.bank_id  =b.bank_id  and  a.bank_id =c.bank_id and  a.schm_code in ('LA768','LA711','LA712','LA767','ML711','LA769','LA734','ML791','LA776','ML790','LA775','LA777','LA796','LA790','LA803','ML712')  "
sv_s = sv_s + " and a.schm_type ='LAA' and a.sol_id in (select sol_id from  tbaadm.sst where set_id ='BCDC') and c.DMD_FLOW_ID='INDEM' and a.bank_id ='43' and tran_date =?SVAR ) UNION  "
sv_s = sv_s + " (select  a.acid, a.sol_id , foracid, a.acct_name , a.schm_type , a.schm_code, a.acct_crncy_code,a.clr_bal_amt ,c.ADJ_AMT ,(select foracid from tbaadm.gam g where g.bank_id='43' and g.acid=b.op_acid) opereative_account,(0.16*ADJ_AMT)  VAT_TO_COLLECT,  "
sv_s = sv_s + " (select clr_bal_amt from tbaadm.gam s where s.bank_id='43' and s.acid=b.op_acid) clr_bal_amt_Op, concat  ( to_char (to_date(tran_date,'DD-MM-RRRR'),'DD-MM-RR') , concat  ( '/', concat( trim(tran_id) , concat  ( '/' ,trim (PART_TRAN_SRL_NUM))))) NARRATION  "
sv_s = sv_s + " from tbaadm.gam a , tbaadm.lam b, tbaadm.lda  c where a.acid =b.acid  and  a.acid =c.acid and  a.bank_id  =b.bank_id  and  a.bank_id =c.bank_id and  a.schm_code in ('LA768','LA711','LA712','LA767','ML711','LA769','LA734','ML791','LA776','ML790','LA775','LA777','LA796','LA790','LA803','ML712')  "
sv_s = sv_s + " and a.schm_type ='LAA' and a.sol_id in (select sol_id from  tbaadm.sst where set_id ='EBC') and c.DMD_FLOW_ID='INDEM' and a.bank_id ='43' and tran_date =?SVAR )) "
BANCS.INPARAM.BINDVARS = CUST.WITH.StartDate +"|" + CUST.WITH.StartDate
print(BANCS.INPARAM.BINDVARS)
sv_e = urhk_dbCursorOpenWithBind(sv_s)
PRINT(sv_e)
IF(sv_e == 0) THEN
#{
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)

	IF(sv_q == 1) THEN
	#{
		sv_x = urhk_dbCursorClose(sv_m)
		print(sv_x)
		CUST.WITH.errMsg ="No Data."
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.WITH.errMsg )
		EXITSCRIPT
	#}
	ENDIF
	print(sv_q)

	WHILE (sv_q==0)

	CUST.WITH.foracid = BANCS.OUTPARAM.foracid
	CUST.WITH.vat=BANCS.OUTPARAM.vat

	CUST.WITH.clramt=BANCS.OUTPARAM.clrbalop

	CUST.WITH.acctcrncy = BANCS.OUTPARAM.acctcrncy

	CUST.WITH.operacct = BANCS.OUTPARAM.operacct
	print(CUST.WITH.operacct)	
	CUST.WITH.solid = BANCS.OUTPARAM.solid
	print(CUST.WITH.solid)
	CUST.WITH.NARRATION = BANCS.OUTPARAM.NARRATION
	print(CUST.WITH.NARRATION)


	print(CUST.WITH.clramt)

	##Check Effective available bal & Status to Create Lien Start

	sv_h = urhk_getAcctDetailsInRepository(CUST.WITH.operacct)
	print(sv_h)
	if(sv_h==0)then
		CUST.WITH.clramt = BANCS.OUTPARAM.EffAvailableAmt
		CUST.WITH.DrfreezeCode = BANCS.OUTPARAM.freezeCode

		sv_z = urhk_B2k_ForacidToAcid(CUST.WITH.operacct)
		print(sv_z)
		IF(sv_z == 0)THEN
			CUST.WITH.Acid = BANCS.OUTPARAM.Acid
			BANCS.INPARAM.acid = BANCS.OUTPARAM.Acid
			sv_u = urhk_getAcctStatus("")
			IF(sv_u == 0)THEN
				CUST.WITH.DracctStatus = BANCS.OUTPARAM.acctStatus                              
			ENDIF
		ENDIF
	ENDIF

	print(CUST.WITH.foracid)
	print(CUST.WITH.clramt)
	print(CUST.WITH.vat)
	print(CUST.WITH.acctcrncy)
	print(CUST.WITH.DrfreezeCode)
	print(CUST.WITH.DracctStatus)

	##if  ((cdouble(CUST.WITH.clramt) < cdouble(CUST.WITH.vat)) or ((CUST.WITH.DrfreezeCode =="D") OR  (CUST.WITH.DrfreezeCode =="T")) or (CUST.WITH.DracctStatus =="D"))THEN  
	
	CUST.WITH.VatCrAcctId = "347010005"
	print(CUST.WITH.VatCrAcctId)
	print(CUST.WITH.solid)
	CUST.WITH.VatCrAcctId = CUST.WITH.solid + CUST.WITH.VatCrAcctId
	print(CUST.WITH.VatCrAcctId)

	###### New VAT 15000 start
	CUST.WITH.bacidagt = "VAT"
	print(CUST.WITH.bacidagt)
	sv_s = "contraagt "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT foracid "
	sv_s = sv_s + " FROM GAM "
	sv_s = sv_s + " WHERE sol_id = ?SVAR "
	sv_s = sv_s + " AND bacid = ?SVAR "
	sv_s = sv_s + " AND del_flg ='N' "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR and foracid like '%347010005' "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.WITH.solid + "|" + CUST.WITH.bacidagt + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
	print(BANCS.INPARAM.BINDVARS)
	sv_d =urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d == "0") THEN
		CUST.WITH.Tax_account = BANCS.OUTPARAM.contraagt
		print(CUST.WITH.Tax_account)
		CUST.WITH.VatCrAcctId = CUST.WITH.Tax_account
		print(CUST.WITH.VatCrAcctId)
	ENDIF
	######  New VAT 15000 end

	CUST.WITH.EventID= CUST.WITH.VatCrAcctId
	CUST.WITH.foracid= CUST.WITH.operacct
	CUST.WITH.TOTAL= CUST.WITH.vat
	CUST.WITH.reasonCode = "CHRGL"
	CUST.WITH.Narration = "INTVAT/"+ CUST.WITH.NARRATION +"/"+ CUST.WITH.foracid 
	CUST.WITH.acid = CUST.WITH.Acid
	CUST.WITH.acctcrncy = CUST.WITH.acctcrncy
	call("LienMarking.scr")
		
	##GOTO NEXTREC

	##ENDIF
	
	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	#}
	DO
#}
ELSE
#{
	CUST.WITH.errMsg ="Data Error"
	sv_e=urhk_SetOrbOut("StattusCode|Error")
	sv_e=urhk_SetOrbOut("Error|"+CUST.WITH.errMsg)
#}
ENDIF


EXITSCRIPT
trace off
end-->







