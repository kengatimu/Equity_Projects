<--start
trace on

sv_a=BANCS.INPUT.crncy_code
sv_d=BANCS.INPUT.future_position

sv_s=BANCS.INPUT.today_position
print(sv_a)
print(sv_d)
print(sv_s)
sv_w=CDOUBLE(sv_d)
sv_z=CDOUBLE(sv_s)

if(sv_w<0) then
sv_p=-sv_w
else
sv_p=sv_w
endif
print(sv_p)

if(sv_z<0) then
sv_q=-sv_z
else
sv_q=sv_z
endif
print(sv_q)

sv_t = FORMAT$(sv_q,"%2.2f") + "|" + sv_a
#sv_t = sv_q + "|" + sv_a 
print(sv_t)
sv_s = urhk_B2k_validateAmtWithCrncy(sv_t)
sv_l=BANCS.OUTPARAM.OutputAmount

sv_m = FORMAT$(sv_p,"%2.2f") + "|" + sv_a
sv_n = urhk_B2k_validateAmtWithCrncy(sv_m)
sv_o = BANCS.OUTPARAM.OutputAmount
	

sv_x = BANCS.INPUT.emp_id

sv_c=BANCS.INPUT.context_sol_id
if(BANCS.INPUT.numOfRec == "") then
     sv_c = 0
else
	 sv_c = CINT(BANCS.INPUT.numOfRec)
endif

sv_c = sv_c + 1

BANCS.OUTPUT.numOfRec=sv_c

BANCS.OUTPUT.crncy_desc = ""
BANCS.OUTPUT.future_position = ""

sv_b=urhk_GetDesc("validateCrncyCode|crncyCode=" + sv_a + "|crncyCodeDesc=&crncyDesc")

if(sv_b == 0) then
sv_c = BANCS.OUTPARAM.crncyDesc
BANCS.OUTPUT.crncy_desc = sv_c
endif

if(sv_w < 0) then
BANCS.OUTPUT.future_position = sv_o
BANCS.OUTPUT.future_crd_dbt="Dr."
else
BANCS.OUTPUT.future_position = sv_o
BANCS.OUTPUT.future_crd_dbt="Cr."
endif

if(sv_z < 0) then
BANCS.OUTPUT.today_position = sv_l
BANCS.OUTPUT.crd_dbt="Dr."
else
BANCS.OUTPUT.today_position = sv_l
BANCS.OUTPUT.crd_dbt="Cr."
endif

#trace off
end-->
