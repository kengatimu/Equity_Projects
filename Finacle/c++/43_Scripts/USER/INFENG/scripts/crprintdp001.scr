		PRINT(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
		
		sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_n)
		IF(CINT(BANCS.OUTPARAM.DB_CURSOR_NUMBER) == 0)THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^"+BANCS.STDIN.EmployeeId +" has no cash account^funcCode")
			PRINT(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_f = urhk_dbCursorFetch(sv_n)
		PRINT(sv_f)
		IF(sv_f!=0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			PRINT(sv_u)
			#sv_u = urhk_SetOrbOut("Error_1|Error^Failed to fetch the Account details^funcCode")
			PRINT(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		WHILE(sv_f == 0)
		#{
			
			CUST.DATA.crncy_code 	= BANCS.OUTPARAM.crncy_code
			CUST.DATA.CRNCY_NAME 	= BANCS.OUTPARAM.CRNCY_NAME
			CUST.DATA.foracid 		= BANCS.OUTPARAM.foracid
			CUST.DATA.today_position = BANCS.OUTPARAM.today_position
			CUST.DATA.DR_CR1 		= BANCS.OUTPARAM.DR_CR1
			CUST.DATA.future_position = BANCS.OUTPARAM.future_position
			CUST.DATA.DR_CR2 		= BANCS.OUTPARAM.DR_CR2
			
			
			
			
			CUST.DATA.resMsg = CUST.DATA.crncy_code + "|" + CUST.DATA.CRNCY_NAME  + "|" + CUST.DATA.foracid + "|" + CUST.DATA.today_position
			CUST.DATA.resMsg = CUST.DATA.resMsg + "|" + CUST.DATA.DR_CR1 + "|" + CUST.DATA.future_position  + "|" + CUST.DATA.DR_CR2
			PRINT(CUST.DATA.resMsg)
			sv_b = urtn_fileWrite(CUST.DATA.successFileIndex1  + "|" + CUST.DATA.resMsg)
	
			NEXTACID:

			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_n)
		PRINT(sv_c)
	
	
	ENDOFSCRIPT:
		
		sv_c = urtn_fileClose(CUST.DATA.successFileIndex1)
		PRINT(sv_c)
		
		CUST.DATA.ERR000002 = "Failed "
		
		##############
		
		PRINT(CUST.DATA.list_file_nameSuccess )
		sv_r = "exebatch mrbx4004 $B2K_SESSION_ID " + CUST.DATA.mrt_file_name1 + " " + CUST.DATA.list_file_nameSuccess  + " " + CUST.DATA.rptSuccess
		PRINT(sv_r)
		sv_r = SYSTEM(sv_r)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.DATA.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		sv_q = "exebatch babx4040 $B2K_SESSION_ID " + " "+ CUST.DATA.rpt_file_nameSuccess+" '" + CUST.DATA.titleSuccess+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.DATA.ERR000002 + "^DATE")
			GOTO FINISH
		#}
		ENDIF
		
		
		
	FINISH:
		TRACE OFF
		
END-->