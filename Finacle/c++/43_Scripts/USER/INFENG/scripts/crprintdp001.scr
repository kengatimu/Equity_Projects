	sv_s = "crncy_code,CRNCY_NAME,foracid,today_position,DR_CR1,future_position,DR_CR2|SELECT GEC.crncy_code,cnc.CRNCY_NAME,GAM.foracid,"
	sv_s = sv_s + " replace(replace(REPLACE((to_char((abs(nvl(nvl(GAM.clr_bal_amt,0)+nvl(GAM.un_clr_bal_amt,0),0))),'999G999G999G999D99')), '.', 'xyz') ,',','.'),'xyz',',')today_position,"
	sv_s = sv_s + "(case when  nvl(nvl(GAM.clr_bal_amt,0)+nvl(GAM.un_clr_bal_amt,0),0)<0 then 'DR' else 'CR' end ) DR_CR,"
	sv_s = sv_s + "(case when nvl(GAM.future_bal_amt,0)='0' then '0' else replace(replace(REPLACE((to_char((abs(nvl(GAM.future_bal_amt,0)) ),'999G999G999G999D99')),'.', 'xyz') ,',','.'),'xyz',',')  end) future_position ,"
	sv_s = sv_s + "(case when  nvl(GAM.future_bal_amt,0)<0 then 'DR' else 'CR' end ) future_DR_CR "
	sv_s = sv_s + " FROM tbaadm.GEC,tbaadm.GAM,tbaadm.cnc WHERE 1 = 1 AND GEC.emp_id= ?SVAR AND GAM.ACCT_CRNCY_CODE=GEC.crncy_code AND "
	sv_s = sv_s + " GEC.del_flg != 'Y' AND GAM.bacid=GEC.emp_cash_acct AND GAM.sol_id=GEC.sol_id and gam.del_flg='N' and gam.entity_cre_flg='Y' and "
	sv_s = sv_s + " gam.acct_cls_flg='N' AND GEC.sol_id = ?SVAR  AND GEC.bank_id = ?SVAR  AND GAM.bank_id = ?SVAR  and cnc.bank_id=?SVAR and cnc.bank_id=?SVAR "
	sv_s = sv_s + " and cnc.crncy_code=gam.acct_crncy_code ORDER BY GEC.CRNCY_CODE"

	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.EmployeeId + "|" + BANCS.STDIN.mySolId + "|" +BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId 
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
