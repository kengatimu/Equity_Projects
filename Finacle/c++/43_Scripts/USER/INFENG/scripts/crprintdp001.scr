	PRINT(CUST.DATA.bodDate)
	sv_e = "bod|select TO_CHAR(TO_DATE(?SVAR,'DD-MM-YYYY'),'DD-MON-YY') from dual"
	BANCS.INPARAM.BINDVARS =CUST.DATA.bodDate
	sv_f = urhk_dbSelectWithBind(sv_e)
	IF(sv_f == 0)then
		CUST.DATA.BODDate= BANCS.OUTPARAM.bod
	print(CUST.DATA.BODDate)
	endif
	
	CUST.DATA.errMsg = ""
	
	CUST.DATA.successFile = "TCPI_Cash_Position_Inq_" + BANCS.STDIN.contextBankId + ".lst"
	CUST.DATA.successFileIndex1 = ""
