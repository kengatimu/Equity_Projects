	#sv_s = sv_s + "(case when  nvl(nvl(GAM.clr_bal_amt,0)+nvl(GAM.un_clr_bal_amt,0),0)<0 then 'DR' else 'CR' end ) DR_CR1,"
	#sv_s = sv_s + "nvl(GAM.future_bal_amt,0) future_position,(case when  nvl(GAM.future_bal_amt,0)<0 then 'DR' else 'CR' end ) DR_CR2 "
	#sv_s = sv_s + " FROM tbaadm.GEC,tbaadm.GAM,tbaadm.cnc WHERE 1 = 1 AND GEC.emp_id= ?SVAR AND GAM.ACCT_CRNCY_CODE=GEC.crncy_code "
	#sv_s = sv_s + " AND GEC.del_flg != 'Y' AND GAM.bacid=GEC.emp_cash_acct AND GAM.sol_id=GEC.sol_id and gam.del_flg='N' and gam.entity_cre_flg='Y'"
	#sv_s = sv_s + " and gam.acct_cls_flg='N' AND GEC.sol_id = ?SVAR  AND GEC.bank_id = ?SVAR  AND GAM.bank_id = ?SVAR "
