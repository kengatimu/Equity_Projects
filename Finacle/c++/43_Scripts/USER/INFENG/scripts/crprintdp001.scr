	CUST.DATA.mrt_file_name1 = "TCPI_Cash_Position_Inq.mrt"
	CUST.DATA.rpt_file_nameSuccess = "TCPI_Cash_Position_Inq_" + CUST.DATA.timeStamp + ".rpt"
