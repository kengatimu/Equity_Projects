			endif
			if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
			#{
				print(BANCS.OUTPARAM.ErrMsg)
			#}
			endif
			if(fieldexists(BANCS.OUTPARAM.RespMesg))then
			#{
				print("Response message is ["+BANCS.OUTPARAM.RespMesg+"]")
				sv_d = BANCS.OUTPARAM.RespMesg
				sv_l = strlen(sv_d)
				CUST.CRMREQ.Response = BANCS.OUTPARAM.RespMesg
				CUST.CRMREQ.Status = GETPOSITION(CUST.CRMREQ.Response,"<Status>")
				print(CUST.CRMREQ.Status)
						
			if (CUST.CRMREQ.Status != "") then
				#{
					CUST.CRMREQ.Status1 = GETPOSITION(CUST.CRMREQ.Response,"</Status>")
					print(CUST.CRMREQ.Status1)
					CUST.CRMREQ.StatusFlag= mid$(CUST.CRMREQ.Response,cint(CUST.CRMREQ.Status)+7,cint(CUST.CRMREQ.Status1)-cint(CUST.CRMREQ.Status)-8)
					print(CUST.CRMREQ.StatusFlag)
				#}
			else
				#{
			    CUST.CRMREQ.StatusFlag = ""
				#}
			endif
				IF(trim(CUST.CRMREQ.StatusFlag)=="SUCCESS")THEN
