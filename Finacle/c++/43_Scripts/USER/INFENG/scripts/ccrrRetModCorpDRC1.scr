	#print(CUST.CRMREQ.cif_id)
	#print(CUST.CRMREQ.riskrating)
	#print(CUST.CRMREQ.riskscore)
	
	## CIF Modification

	

	CUST.CCRRM.ModSuccessflg 	= "F"
	CUST.CCRRM.SorFmessage      = ""
	CUST.CCRRM.Statuscode    	= "U"

	sv_c = "state,StatusCode,PlaceofBirth,subSegment,segment,staffEmployeeID,defaultaddressType,manager,managerID,SECONDARYRM_ID,emailAccounts,zip,EmailP,phonenolocalcode,PRIMARY_SOL_ID,RELATIONSHIPMGRID,staffFlag,FINAL_RISK_SCORE,RISK_RATING,CIF_ID,"
	sv_c = sv_c + " |select state,status_code,placeofbirth,subsegment,SEGMENTATION_CLASS,staffEmployeeID,defaultaddresstype,manager,relationshipmgrid,SECONDARYRM_ID,a.email,zip,"
	sv_c = sv_c + " (select pp.email from crmuser.phoneemail pp where pp.PHONEOREMAIL = 'EMAIL' and PREFERREDFLAG ='Y' and pp.orgkey = a.orgkey and rownum<2)EMAILP,"
	sv_c = sv_c + " (select PHONENOLOCALCODE from crmuser.phoneemail pp where"
	sv_c = sv_c + " pp.PHONEOREMAIL = 'PHONE' and pp.orgkey = a.orgkey and pp.bank_id =?SVAR and PREFERREDFLAG ='Y' and rownum<2)phonenolocalcode,a.PRIMARY_SOL_ID,RELATIONSHIPMGRID,staffFlag,c.FINAL_RISK_SCORE,c.RISK_RATING,c.CIF_ID"
        sv_c = sv_c + " from crmuser.accounts a,CUSTOM.INT_CREDIT_CRA_DRC c where a.bank_id ='43' and  "
	sv_c = sv_c + " c.CIF_ID = a.orgkey and a.corp_id is not null and c.bank_id=a.bank_id and status_flg='N1' "
	print(sv_c)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)

	sv_e = urhk_dbCursorOpenWithBind(sv_c)
	print(sv_e)

	if(sv_e == 0)then
	#{
			###
			sv_z = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(sv_z)
			print(sv_q)

			BANCS.INPUT.RECOUNT = cint("1")
			print(BANCS.INPUT.RECOUNT)

			IF(sv_q == 1) THEN
			#{
				sv_x = urhk_dbCursorClose(sv_z)
				print(sv_x)
				exitscript
			#}
			ENDIF
			print(sv_q)

		WHILE(sv_q==0)
		#{
			CUST.CRMREQ.state = BANCS.OUTPARAM.state
			PRINT(CUST.CRMREQ.state)
			sv_m = "18"
			CUST.CRMREQ.StatusCode = BANCS.OUTPARAM.StatusCode
			print(CUST.CRMREQ.StatusCode) 
			
			CUST.CRMREQ.PlaceofBirth = BANCS.OUTPARAM.PlaceofBirth
			print(CUST.CRMREQ.PlaceofBirth)
			sv_n = "KIN"
