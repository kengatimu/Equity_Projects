			print(CUST.CRMREQ.EmailP)
			CUST.CRMREQ.phonenolocalcode = BANCS.OUTPARAM.phonenolocalcode
			print(CUST.CRMREQ.phonenolocalcode)

			#RELATIONSHIPMGRID
			CUST.CRMREQ.RELATIONSHIPMGRID = BANCS.OUTPARAM.RELATIONSHIPMGRID
			print(CUST.CRMREQ.RELATIONSHIPMGRID)
			CUST.CRMREQ.staffFlag = BANCS.OUTPARAM.staffFlag
			print(CUST.CRMREQ.staffFlag)
			CUST.CRMREQ.PRIMARY_SOL_ID = BANCS.OUTPARAM.PRIMARY_SOL_ID
			print(CUST.CRMREQ.PRIMARY_SOL_ID)
			CUST.CRMREQ.CIF_ID = BANCS.OUTPARAM.CIF_ID
			print(CUST.CRMREQ.CIF_ID)
			CUST.CRMREQ.RISK_RATING = BANCS.OUTPARAM.RISK_RATING
			print(CUST.CRMREQ.RISK_RATING)
			CUST.CRMREQ.FINAL_RISK_SCORE = BANCS.OUTPARAM.FINAL_RISK_SCORE
			print(CUST.CRMREQ.FINAL_RISK_SCORE)



			##ADDRESS DETAILS

			sv_s = "ADDRESSID,ADDRESSCATEGORY, CITY, STATE,COUNTRY , ZIP | select  ADDRESSID,ADDRESSCATEGORY, city, state,country , zip from CRMUSER.address"
			sv_s = sv_s + " where orgkey  = ?SVAR and   PREFERREDADDRESS  ='Y' and bank_id = ?SVAR and rownum = 1 "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.CRMREQ.CIF_ID   + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
			CUST.CRMREQ.ADDRESSID = BANCS.OUTPARAM.ADDRESSID
			CUST.CRMREQ.ADDRESSCATEGORY = BANCS.OUTPARAM.ADDRESSCATEGORY
			CUST.CRMREQ.STATE = BANCS.OUTPARAM.STATE
			CUST.CRMREQ.COUNTRY = BANCS.OUTPARAM.COUNTRY
			CUST.CRMREQ.CITY = BANCS.OUTPARAM.CITY
			CUST.CRMREQ.ZIP = BANCS.OUTPARAM.ZIP
			ENDIF
			##phone NUMBER LOCAL missing

			sv_s = " PHONEEMAILID,PHONENO,PHONENOCITYCODE,PHONEOREMAIL,START_DATE,PHONEEMAILTYPE,EMAIL,PHONENOCOUNTRYCODE,PHONENOLOCALCODE |" 
			sv_s = sv_s +"select PHONEEMAILID,PHONENO,PHONENOCITYCODE,PHONEOREMAIL,START_DATE,PHONEEMAILTYPE,EMAIL,SUBSTR(PHONENO,1,3) PHONENOCOUNTRYCODE,SUBSTR(PHONENO,4)PHONENOLOCALCODE"
			#sv_s = sv_s + " CASE WHEN PHONENO LIKE '+243%' THEN SUBSTR(PHONENO,2,3) ELSE SUBSTR(PHONENO,1,3) END AS PHONENOCOUNTRYCODE,"
			#sv_s = sv_s + " CASE WHEN PHONENO LIKE '+243%' THEN SUBSTR(PHONENO,5)ELSE  SUBSTR(PHONENO,4)END AS PHONENOLOCALCODE"
			sv_s = sv_s + " from crmuser.phoneemail where orgkey  = ?SVAR and   PREFERREDFLAG  ='Y' and bank_id = ?SVAR and PHONEOREMAIL = 'PHONE' and rownum = 1 "
			print (sv_s)

			BANCS.INPARAM.BINDVARS = CUST.CRMREQ.CIF_ID   + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)	
			IF(sv_d == 0) THEN

					CUST.CRMREQ.PHONEEMAILID = BANCS.OUTPARAM.PHONEEMAILID
					CUST.CRMREQ.PHONENO = BANCS.OUTPARAM.PHONENO
					CUST.CRMREQ.PHONENOCITYCODE = BANCS.OUTPARAM.PHONENOCITYCODE
					CUST.CRMREQ.PHONENOCOUNTRYCODE = BANCS.OUTPARAM.PHONENOCOUNTRYCODE
					CUST.CRMREQ.PHONENOLOCALCODE = BANCS.OUTPARAM.PHONENOLOCALCODE
					CUST.CRMREQ.PHONEOREMAIL = BANCS.OUTPARAM.PHONEOREMAIL
					CUST.CRMREQ.START_DATE = BANCS.OUTPARAM.START_DATE + "T00:00:00.000"
					CUST.CRMREQ.PHONEEMAILTYPE = BANCS.OUTPARAM.PHONEEMAILTYPE
					CUST.CRMREQ.EMAIL = BANCS.OUTPARAM.EMAIL

			ENDIF


			sv_a = "messagedatatime,reqUUId,timeStampFF3|SELECT to_char(systimestamp,'yyyy-mm-ddhh:mi:ssxff'),regexp_replace(rawtohex(sys_guid()),'([A-F0-9]{8})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{12})', '\1-\2-\3-\4-\5'),to_char(systimestamp,'DD-MM-YYYY HH24:MI:SS:FF3') from dual"
			sv_b = urhk_dbSelectWithBind(sv_a)
			print(sv_b)
			if(sv_b ==0)then
			#{
				CUST.CRMREQ.reqUUId = BANCS.OUTPARAM.reqUUId
				CUST.CRMREQ.messagedatatime = BANCS.OUTPARAM.messagedatatime
				print(CUST.CRMREQ.messagedatatime)
				CUST.CRMREQ.tt  = MID$(CUST.CRMREQ.messagedatatime,0,10)
				CUST.CRMREQ.ttt = MID$(CUST.CRMREQ.messagedatatime,10,12)
				CUST.CRMREQ.messagedatatime = CUST.CRMREQ.tt  + "T" + CUST.CRMREQ.ttt
				BANCS.INPARAM.SYSDATE = BANCS.OUTPARAM.timeStampFF3
				print(BANCS.INPARAM.SYSDATE)
			#}
			else
			#{
			#2022-01-2604:57:34.290868
			CUST.CRMREQ.messagedatatime = "2022-01-11T15:18:54.167"
				CUST.CRMREQ.reqUUId = ""
			#}
			endif
			if(CUST.CRMREQ.reqUUId=="")then
				CUST.CRMREQ.RequestUUID =BANCS.INPARAM.SYSDATE
			else
				CUST.CRMREQ.RequestUUID = CUST.CRMREQ.reqUUId
			endif
			BANCS.INPARAM.milliSec = MID$(BANCS.INPARAM.SYSDATE,20,3)
			BANCS.INPARAM.Day = LEFT$(BANCS.INPARAM.SYSDATE,2)
			BANCS.INPARAM.Month = MID$(BANCS.INPARAM.SYSDATE,3,2)
			BANCS.INPARAM.Year = MID$(BANCS.INPARAM.SYSDATE,8,2)
			BANCS.INPARAM.MesgYear = MID$(BANCS.INPARAM.SYSDATE,6,4)
			BANCS.INPARAM.Hour = MID$(BANCS.INPARAM.SYSDATE,11,2)
			BANCS.INPARAM.Minute = MID$(BANCS.INPARAM.SYSDATE,14,2)
			BANCS.INPARAM.Second = MID$(BANCS.INPARAM.SYSDATE,17,2)

			BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second + BANCS.INPARAM.milliSec
			BANCS.INPARAM.MESSAGEDATETIME = BANCS.INPARAM.MesgYear + "-" + BANCS.INPARAM.Month + "-" + BANCS.INPARAM.Day + "T" + BANCS.INPARAM.Hour + ":" +  BANCS.INPARAM.Minute + ":" + BANCS.INPARAM.Second + "."+BANCS.INPARAM.milliSec

			BANCS.INPARAM.UserId = BANCS.STDIN.userId
			BANCS.INPARAM.BANKID = BANCS.STDIN.contextBankId
			BANCS.INPARAM.REQUESTUUID = CUST.CRMREQ.RequestUUID 
			
		
			BANCS.INPARAM.SERVICEREQUESTID = "updateCorpCustomer" 
			BANCS.INPARAM.CHANNELID = "CRM"
			BANCS.INPARAM.SERVICEREQUESTVERSION = "10.2"
			BANCS.INPARAM.TIMEZONE = "EAT+05:30"
			BANCS.INPARAM.UserApplId = "CRM"
			CUST.CRMREQ.startdate = MID$(BANCS.STDIN.BODDate,0,10)
			CUST.CRMREQ.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
			CUST.CRMREQ.instDate = ""
			CUST.CRMREQ.lastdatepart ="T00:00:00.000"
			print(CUST.CRMREQ.lastdatepart)
			CUST.CRMREQ.sign ="-"
			print(CUST.CRMREQ.sign)
			BANCS.INPARAM.UserChannelId = "FI"
			BANCS.INPARAM.SERVICE_NAME = "FIJCA"
			BANCS.INPARAM.SEND_RECV_FLG = "R"

			CUST.CRMREQ.fiChnId	= "CRM"
			CUST.CRMREQ.XmlMessage = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"				
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<?xml version='1.0' encoding='UTF-8'?>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<FIXML xsi:schemaLocation='http://www.finacle.com/fixml executeFinacleScript.xsd' xmlns='http://www.finacle.com/fixml' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'><Header>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RequestHeader>" 
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<MessageKey>" 
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RequestUUID>"+CUST.CRMREQ.RequestUUID+"</RequestUUID>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ServiceRequestId>"+BANCS.INPARAM.SERVICEREQUESTID+"</ServiceRequestId>" 
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ServiceRequestVersion>"+BANCS.INPARAM.SERVICEREQUESTVERSION+"</ServiceRequestVersion>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ChannelId>"+CUST.CRMREQ.fiChnId+"</ChannelId>" 
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<LanguageId></LanguageId>" 
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</MessageKey>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<RequestMessageInfo>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<BankId>"+BANCS.STDIN.contextBankId+"</BankId>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<TimeZone></TimeZone>" 
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<EntityId></EntityId>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<EntityType></EntityType>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<ArmCorrelationId></ArmCorrelationId>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<MessageDateTime>"+CUST.CRMREQ.messagedatatime+"</MessageDateTime>" 
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</RequestMessageInfo>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</RequestHeader>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "</Header>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<Body>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<updateCorpCustomerRequest>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<CorpCustomerModData>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<mainData>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<corpCustomerModCorporateData>"
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<corp_key>" + CUST.CRMREQ.CIF_ID  + "</corp_key>"
				
				
			
			##add tags for state,StatusCode,PlaceofBirth,subSegment,staffEmployeeID,defaultaddressType,manager,managerID,emailAccounts,zip,EmailP,phonenolocalcode
			#####
			### query for category value validation state.
			##.1
			sv_d = "count|select count(*) from crmuser.categories c,  crmuser.category_lang l  where L.bank_id=c.bank_id and l.CATEGORYID=c.CATEGORYID"
			sv_d = sv_d + " and c.bank_id=?SVAR and LOCALECODE='en_US' and CATEGORYTYPE like '%STATE' "
			sv_d = sv_d + " and value = ?SVAR and value !='.' "

			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CRMREQ.state
			print(BANCS.INPARAM.BINDVARS)

			sv_u = urhk_dbSelectWithBind(sv_d)
			PRINT(sv_u)	
			
			if(sv_u == 0)then
				sv_a = BANCS.OUTPARAM.count
				if(sv_a == 0)then
					CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<State>"+sv_m+"</State>"			
				endif
			endif

			##CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<State>"+CUST.CRMREQ.state+"</State>"
			
			
			##.2
			sv_d = "count|select count(*)  from crmuser.categories c,  crmuser.category_lang l  where L.bank_id=c.bank_id and l.CATEGORYID=c.CATEGORYID"
			sv_d = sv_d + " and c.bank_id=?SVAR and LOCALECODE='en_US' and CATEGORYTYPE like '%CORP_SUB_SEGMENT'  and RATING = ?SVAR "
			sv_d = sv_d + " and value = ?SVAR  and value !='.' "
			print(sv_d)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CRMREQ.subSegment + "|" + CUST.CRMREQ.segment
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			PRINT(sv_u)
			if(sv_u == 0)then
				sv_a = BANCS.OUTPARAM.count
				if(sv_a == 0)then
					sv_d = "subsegment|select value from crmuser.categories c,  crmuser.category_lang l  where L.bank_id=c.bank_id and l.CATEGORYID=c.CATEGORYID"
					sv_d = sv_d + " and c.bank_id=?SVAR and LOCALECODE='en_US' and CATEGORYTYPE like '%CORP_SUB_SEGMENT'  and RATING = ?SVAR and rownum < 2 "
					print(sv_d)

					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.CRMREQ.segment
					print(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbSelectWithBind(sv_d)
					
					if(sv_u == 0)then
						sv_o = BANCS.OUTPARAM.subsegment
						PRINT(sv_o)
						CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<SUBSEGMENT>"+sv_o+"</SUBSEGMENT>"
					endif
				endif
			endif
			##.3
			CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<DefaultAddressType>"+CUST.CRMREQ.defaultaddressType+"</DefaultAddressType>"
			
			##.4
			sv_d = "count|select COUNT(*) from crmuser.categories c, "
			sv_d = sv_d + " crmuser.category_lang l  where L.bank_id=c.bank_id and l.CATEGORYID=c.CATEGORYID and c.bank_id=?SVAR and LOCALECODE='en_US' " 
			sv_d = sv_d + " and CATEGORYTYPE like '%STATUS'and value = ?SVAR  and value !='.'  "
			print(sv_d)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CRMREQ.StatusCode
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			PRINT(sv_u)
			if(sv_u == 0)then
				sv_a = BANCS.OUTPARAM.count
				if(sv_a == 0)then
					CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<StatusCode>"+CUST.CRMREQ.StatusCode+"</StatusCode>"
				endif
			endif
			#CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<Manager>"+CUST.CRMREQ.manager+"</Manager>"
			##.5
			sv_d = "count|select count(*) from CRMUSER.AGENTS a ,  CRMUSER.BIZCENTER b ,CRMUSER.USERS  c ,tbaadm.upr d  , tbaadm.get e where d.user_id =c.loginid"
			sv_d = sv_d + " and a.personid =c.personid and  b.BCID =a.BCID and   d.home_bank_id =?SVAR"
			sv_d = sv_d + " and d.del_flg  ='N' and e.emp_id =d.user_emp_id  and BCCODE = d.sol_id and loginid =?SVAR and CUSTRELATION='Y' and rownum<2 " 
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CRMREQ.SECONDARYRM_ID
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			PRINT(sv_u)

			IF(sv_u == 0)THEN
			#{
				sv_b = BANCS.OUTPARAM.count
				IF  (sv_b <= 0) THEN
					sv_d = "manager|select LOGINID  from CRMUSER.AGENTS a ,  CRMUSER.BIZCENTER b ,CRMUSER.USERS  c ,tbaadm.upr d  , tbaadm.get e"
					sv_d = sv_d + " where d.user_id =c.loginid and a.personid =c.personid and  b.BCID =a.BCID and   d.home_bank_id =?SVAR "
					sv_d = sv_d + " and d.del_flg  ='N' and e.emp_id =d.user_emp_id and d.sol_id=?SVAR and d.user_work_class in ('150','200','110') and CUSTRELATION='Y' "
					sv_d = sv_d + " and BCCODE=d.sol_id and rownum<2 "
					
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CRMREQ.PRIMARY_SOL_ID 
					print(BANCS.INPARAM.BINDVARS)
					sv_u = urhk_dbSelectWithBind(sv_d)
					PRINT(sv_u)
					if(sv_u == 0)then
						CUST.CRMREQ.new_manager = BANCS.OUTPARAM.manager
						print(CUST.CRMREQ.new_manager)
						
						#CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<Manager>"+CUST.CRMREQ.manager+"</Manager>"
						CUST.CRMREQ.XmlMessage = CUST.CRMREQ.XmlMessage + "<SECONDRMLOGINID>"+CUST.CRMREQ.new_manager+"</SECONDRMLOGINID>"
					else
						sv_d = "manager|select LOGINID  from CRMUSER.AGENTS a ,  CRMUSER.BIZCENTER b ,CRMUSER.USERS  c ,tbaadm.upr d  , tbaadm.get e"
