					CUST.CRMREQ.SuccessOrFailure = "S"
					print("CIF Verification Success")
				#}
				ENDIF
				if(trim(CUST.CRMREQ.StatusFlag)!="SUCCESS")THEN
				#{
					CUST.CRMREQ.SuccessOrFailure = "F"
					print("CIF Verification failed")
					
					#----- Error Capturing Starts
					
					sv_x = CUST.CRMREQ.Response
					sv_y = "<ErrorCode>"
					sv_z = "</ErrorCode>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.CRMREQ.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.CRMREQ.errorCode)
					#}
					ENDIF
					sv_x = CUST.CRMREQ.Response
					sv_y = "<ErrorDesc>"
					sv_z = "</ErrorDesc>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.CRMREQ.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.CRMREQ.errorDesc)
						IF (CUST.CRMREQ.errorCode=="CRMEJB0071") THEN
							print(CUST.CRMREQ.errorDesc)
							CUST.CRMREQ.errorDesc="CRMEJB0071.Record cant be edited when record is under verification"
							print(CUST.CRMREQ.errorDesc)
						ENDIF
						IF (CUST.CRMREQ.errorCode=="MSGJAVA51079") THEN
							print(CUST.CRMREQ.errorDesc)
							CUST.CRMREQ.errorDesc="MSGJAVA51079.The E-mail ID should be in userdomain.com format."
							print(CUST.CRMREQ.errorDesc)
						ENDIF
						print(CUST.CRMREQ.errorDesc)
					#}
					ENDIF					
					#----- Error Capturing Ends	
				#}
				ENDIF
				#}
				else
				#{
					if(fieldexists(BANCS.OUTPARAM.ErrCode)==1)then
					#{
						print(BANCS.OUTPARAM.ErrCode)
						CUST.CRMREQ.SuccessOrFailure = "F"
					#}
					endif
					if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
					#{
						print(BANCS.OUTPARAM.ErrMsg)
						CUST.CRMREQ.SuccessOrFailure = "F"
					#}
					endif
					CUST.CRMREQ.SuccessOrFailure = "F"
				#}
				endif
				
				##################################################################
				IF(FIELDEXISTS(CUST.CRMREQ.SuccessOrFailure) == 1)THEN
					#{
						print(CUST.CRMREQ.SuccessOrFailure)
						IF(trim(CUST.CRMREQ.SuccessOrFailure) == "S")THEN
						#{
							CUST.CCRRM.ModSuccessflg ="M"
							CUST.CCRRM.Statuscode = "V"
							CUST.CCRRM.SorFmessage = "CIF Modified successfully"		
						#}ss
						ELSE
						#{
							IF(FIELDEXISTS(CUST.CRMREQ.errorDesc) == 1)THEN
							#{
								CUST.CCRRM.SorFmessage = CUST.CRMREQ.errorDesc
							#}
							ELSE
							#{
								CUST.CCRRM.SorFmessage = "CIF Modification failed,Manual update required"
							#}
							ENDIF
							CUST.CCRRM.Statuscode = "F"
						#}
						ENDIF	
					ENDIF
					
					# ======= UPDATE THE MODIFCATION FLAGS
					 
					
						print(CUST.CCRRM.ModSuccessflg)
						CUST.CCRRM.SorFmessage = CUST.CRMREQ.CIF_ID+"   "+CUST.CCRRM.SorFmessage 
						print(CUST.CCRRM.SorFmessage)
						
						#sv_r = system("echo '   "+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
						#print(sv_r)
						
						
						#++++++++++ Start Update 
						
						#------------------------------------------------------------
						#------Updating the INT_CREDIT_CRA_DRC table on the success condition  ---
						#------status U - uploaded no modifification done yet----------
						#------status F - Failed to do modifification 			  ---
						#------status V - modification done, pending verification ---
						#------status P - uploaded , modified done and verified -----
						#------------------------------------------------------------
						
						
						sv_s = "update CUSTOM.INT_CREDIT_CRA_DRC set STATUS_FLG=?SVAR,"
						sv_s = sv_s + "REMARKS= substr(replace (q'["+CUST.CCRRM.SorFmessage+"]',q'[|]',q'[ ]'),0,200) "
						sv_s = sv_s + "where CIF_ID=?SVAR "
						#sv_s = sv_s + "and REF_CODE=?SVAR "
						sv_s = sv_s + "and bank_id=?SVAR"
						print(sv_s)
						BANCS.INPARAM.BINDVARS =  CUST.CCRRM.Statuscode + "|" + CUST.CRMREQ.CIF_ID  +"|"+ BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						print(sv_s)
						sv_d=urhk_dbSqlWithBind(sv_s)
						IF (sv_d == 0)  THEN
							sv_d = urhk_dbSQLWithBind("COMMIT")
						ENDIF
			GOTO NEXTREC
			#BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
			#PRINT(BANCS.INPUT.RECCOUNT)

			NEXTREC:
			sv_q = urhk_dbCursorFetch(sv_z)
			print(sv_q)
		#}
		DO
		sv_q = urhk_dbCursorClose(sv_z)
		print(sv_q)
	#}
	ENDIF

TRACE OFF	
EXITSCRIPT	
