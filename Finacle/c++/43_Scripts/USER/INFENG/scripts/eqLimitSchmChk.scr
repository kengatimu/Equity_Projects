<--start
trace on
	if(fieldexists(BANCS.INPUT.acctNum) == 1)then
		sv_a = urhk_getAcctDetailsInRepository(BANCS.INPUT.acctNum)
		if(sv_a == 0)then
			sv_s = BANCS.OUTPARAM.schmType	
			if((sv_s == "ODA") or (sv_s == "CAA"))then
				goto drceqty
			else
				exitscript
			endif
		else
			exitscript
		endif
	else
		exitscript
	endif

drceqty:
sv_f = "Y"
sv_u = urhk_SetOrbOut("odChkFlg|"+sv_f)
exitscript
trace off
end-->
