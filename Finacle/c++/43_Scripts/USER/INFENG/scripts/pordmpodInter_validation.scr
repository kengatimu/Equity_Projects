<--START

	# Script body goes here
	TRACE ON
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether DATA Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","DATA")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","DATA",5)
	#}
	ENDIF

	
	sv_a=urhk_B2k_PrintRepos("BANCS")
	print(sv_a)

	#-############################################################################################
	## Initialiaze Variables
	#############################################################################################
	CUST.DATA.errFlg = "N"
	CUST.DATA.errMsg = " "


	IF(FIELDEXISTS(BANCS.INPUT.remitCrncy))THEN
		IF(BANCS.INPUT.remitCrncy !="")THEN
			CUST.DATA.remitCrncy = TOUPPER(TRIM(BANCS.INPUT.remitCrncy))
			PRINT(CUST.DATA.remitCrncy)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Remittance Currency Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Remittance Currency Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.awiBic))THEN
		IF(BANCS.INPUT.awiBic!="")THEN
			CUST.DATA.awiBic= TOUPPER(TRIM(BANCS.INPUT.awiBic))
			PRINT(CUST.DATA.awiBic)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "acct with Bic Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "acct with Bic Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.orderType))THEN
		IF(BANCS.INPUT.orderType!="")THEN
			CUST.DATA.orderType= TOUPPER(TRIM(BANCS.INPUT.orderType))
			PRINT(CUST.DATA.orderType)
		ELSE
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Order type Not Entered"
			GOTO ENDOFSCRIPT
		ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Order type Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF

	sv_s = "count|select count(*) from custom.bcdc_local_route where BEN_CORR_CODE != 'BKTRUS33XXX' and ben_swift_code =?SVAR and"
	sv_s = sv_s + " bank_id = ?SVAR"
	print(sv_s)

	BANCS.INPARAM.BINDVARS=CUST.DATA.awiBic +"|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == "0")then

	#{

		CUST.DATA.count = BANCS.OUTPARAM.count
		print(CUST.DATA.count)

		IF(CUST.DATA.count > 0)THEN

		#{
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = "Intermediary Details needs to be maintained. Visit Intermediary Section"
			GOTO ENDOFSCRIPT


		#}
		ELSE

		#{
			EXITSCRIPT

		#}


	#}

	ENDIF


		ENDOFSCRIPT:
		print(CUST.DATA.errFlg)
		print(CUST.DATA.errMsg)
		 sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
		sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)

		PRINT(sv_u)
		
		
END-->