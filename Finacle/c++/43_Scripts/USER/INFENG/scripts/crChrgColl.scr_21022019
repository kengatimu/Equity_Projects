			BANCS.INPARAM.BINDVARS = CUST.CLA.acctId +"|"+ CUST.CLA.intdracnt +"|"+ CUST.CLA.sanclmt +"|"+ CUST.CLA.chrgPcnt
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CLA.sanclmt +"|"+ CUST.CLA.vatAmt +"|"+ CUST.CLA.intcrncy
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CLA.tranId + "|" +  MID$(CUST.CLA.tranDate,0,10) + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
