 <--START
CHECKSUM="72cfea39df01ad866f594a9080210fd4b4bfdb3f818d390903b4d3f4e2a7d82d"
TRACE ON

CALL("b_pordvalidate.scr")


GOTO ENDOFSCRIPT

IF (BANCS.STDIN.moduleIdentity != "FI") THEN
	IF(BANCS.STDIN.menuId == "HPORDM") THEN
	#{
		
		IF(FIELDEXISTS(ONS.CUSTOM.custDataIn))THEN
	       #{
			sv_z = ONS.CUSTOM.custDataIn
		#}
		ELSE
		#{
			sv_a = urhk_SRV_SetErr("Please visit Reimbursement Details tab")
			GOTO ENDOFSCRIPT
		#}
		ENDIF


		#*******************
		# Parsing custData
		#*******************
		BANCS.INPUT.pordmmapdet_FIELD_1 =""
		BANCS.INPUT.pordmreimdet_FIELD_1 =""
		sv_j=urhk_ParseONSCustData(sv_z)

		IF (sv_j == 0) THEN
		#{
		print(BANCS.INPUT.pordmreimdet_FIELD_1)
		print(BANCS.INPUT.pordmmapdet_FIELD_1)

		if(BANCS.INPUT.pordmreimdet_FIELD_1 !="Y") THEN
		#{
			sv_a = urhk_SRV_SetErr("Please visit Reimbursement Details tab")
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		if(BANCS.INPUT.pordmmapdet_FIELD_1 !="Y") THEN
		#{
			sv_a = urhk_SRV_SetErr("please visit Outward Message Details tab")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
		ENDIF
	#}
	ENDIF
ENDIF
ENDOFSCRIPT:


IF(BANCS.STDIN.contextBankId=="43")THEN
	#{
	IF (REPEXISTS("CUST") == 0) THEN
		CREATEREP("CUST")
	ENDIF
	IF (CLASSEXISTS("CUST","RATE") == 0) THEN
	    CREATECLASS("CUST","RATE",5)
	ENDIF
	CUST.RATE.OPTION = "PORDTRAN"
	callscriptifexist("ForexLimitChkDrc.scr")
ENDIF



EXITSCRIPT
TRACE OFF

END-->  


