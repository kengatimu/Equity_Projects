<--start
trace on

CALL("Common_Interface_CreateRepos.scr")


sv_s=" CIF , COUNTRYINCORPORATION,BUILDING_N0,STREET_NAME, CITY ,   REGION ,   COUNTRY  ,  StretN0 ,     ADDRESS_LABEL ,   ADDRESS_LINE1 ,   ADDRESS_LINE2 , ADDRESS_LINE3  ,  STATE   |"
sv_s = sv_s + " select FREE_TEXT1,FREE_TEXT2,FREE_TEXT3,FREE_TEXT4,FREE_TEXT5,FREE_TEXT6,FREE_TEXT7,FREE_TEXT8,FREE_TEXT9,FREE_TEXT10,FREE_TEXT11,FREE_TEXT12,FREE_TEXT13   "
sv_s = sv_s + "   from CUSTOM.INT_CHANGE_ALL where bank_id =?SVAR and  FREE_TEXT25 ='EZB'  and FREE_TEXT1   in (select corp_key  from crmuser.corporate   where bank_id ='43') "
print(sv_s)
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)
sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c==0) then


		CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
		print(sv_k)

	WHILE (sv_k == 0)

		
		CUST.INTERFACE.interfaceRequestVersion = "10.2"
		CUST.INTERFACE.bankID =BANCS.STDIN.contextBankId
		CUST.INTERFACE.channelID = "CRM"
		CUST.INTERFACE.startdate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.crValueDate = MID$(BANCS.STDIN.BODDate,0,10)
		CUST.INTERFACE.instDate = ""
		CUST.INTERFACE.lastdatepart ="T00:00:00.000"
		print(CUST.INTERFACE.lastdatepart)
		CUST.INTERFACE.sign ="-"
		print(CUST.INTERFACE.sign)


		CUST.INTERFACE.CIF =BANCS.OUTPARAM.CIF
		CUST.INTERFACE.COUNTRYINCORPORATION =BANCS.OUTPARAM.COUNTRYINCORPORATION
		CUST.INTERFACE.BUILDING_N0 =BANCS.OUTPARAM.BUILDING_N0
		CUST.INTERFACE.STREET_NAME =BANCS.OUTPARAM.STREET_NAME
		CUST.INTERFACE.CITY = BANCS.OUTPARAM.CITY
		CUST.INTERFACE.REGION =BANCS.OUTPARAM.REGION
		CUST.INTERFACE.COUNTRY =BANCS.OUTPARAM.COUNTRY
		CUST.INTERFACE.StretN0 =BANCS.OUTPARAM.StretN0
		CUST.INTERFACE.ADDRESS_LABEL =BANCS.OUTPARAM.ADDRESS_LABEL
		CUST.INTERFACE.ADDRESS_LINE1 =BANCS.OUTPARAM.ADDRESS_LINE1
		CUST.INTERFACE.ADDRESS_LINE2 =BANCS.OUTPARAM.ADDRESS_LINE2
		CUST.INTERFACE.ADDRESS_LINE3 =BANCS.OUTPARAM.ADDRESS_LINE3
		CUST.INTERFACE.STATE =BANCS.OUTPARAM.STATE

		CUST.INTERFACE.interfaceRequestID = "updateCorpCustomer"
		
				
			CUST.INTERFACE.MODMAIL ="N"
			CUST.INTERFACE.MODREG ="N"

			sv_a = " ADDRESSID  |select  ADDRESSID  from CRMUSER.address where orgkey  = ?SVAR  and  ADDRESSCATEGORY ='Registered' and  bank_id =?SVAR and  rownum =1   "					
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_d)
			IF(sv_d == 0) THEN
				CUST.INTERFACE.ADDRESSREGID = BANCS.OUTPARAM.ADDRESSID
				CUST.INTERFACE.MODREG ="Y"
			ENDIF

			sv_a = " ADDRESSID  |select  ADDRESSID  from CRMUSER.address where orgkey  = ?SVAR  and  ADDRESSCATEGORY ='Mailing' and  bank_id =?SVAR and  rownum =1   "					
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_d)
			IF(sv_d == 0) THEN
				CUST.INTERFACE.ADDRESSMAILID = BANCS.OUTPARAM.ADDRESSID	
				CUST.INTERFACE.MODMAIL ="Y"
			ENDIF

			sv_a = " SWIFT_NAME  |select  SWIFT_NAME  from CRMUSER.address where orgkey  = ?SVAR  and  ADDRESSCATEGORY ='Swift' and  bank_id =?SVAR and  rownum =1   "					
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_d)
			IF(sv_d == 0) THEN
				CUST.INTERFACE.SWIFT_NAME = BANCS.OUTPARAM.SWIFT_NAME	
				IF (CUST.INTERFACE.SWIFT_NAME =="") THEN
					sv_s = " update CRMUSER.address  set SWIFT_NAME = (select substr (name, 0,35)  from CRMUSER.accounts   where orgkey = ?SVAR and bank_id =?SVAR)  "
					sv_s = sv_s + "where   ADDRESSCATEGORY ='Swift'  and orgkey =?SVAR and bank_id = ?SVAR " 					
					print(sv_s)
					BANCS.INPARAM.BINDVARS = CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.CIF  + "|" + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)			
					sv_d = urhk_dbSQLWithBind(sv_s)
					IF (sv_d == 0) THEN
						sv_c = urhk_dbSQLWithBind("commit")
						print(sv_c)
					ENDIF
				ENDIF
			ENDIF		
			
			#CUST.INTERFACE.RM  = CUST.INTERFACE.NEWRM		
			#CUST.INTERFACE.SEGMNET =  "MSME"
			#CUST.INTERFACE.SUBSEGMENT = "UPPERCOPR"

			#CUST.INTERFACE.RM = ""
		
		#-------------------------------------------------------------------------
		# Fetch the current data time to send in request header
		#-------------------------------------------------------------------------
		sv_s = "date,time|SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD'),TO_CHAR(SYSDATE,'HH:MM:SS') FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.INTERFACE.msgDateTime = BANCS.OUTPARAM.date + "T" + BANCS.OUTPARAM.time + ".000"
			print(CUST.INTERFACE.msgDateTime)
		#}
		ENDIF

		#-------------------------------------------------------------------------
		#- Forming the Header for RetCustAdd
		#-------------------------------------------------------------------------

		sv_s = "RequestID|SELECT CONCAT(CONCAT('Req_',TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS')),(DBMS_RANDOM.STRING('A',5))) FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0)THEN
		#{
			CUST.INTERFACE.RequestID1 = BANCS.OUTPARAM.RequestID
			print(CUST.INTERFACE.RequestID1)
		#}
		ELSE
		#{
			CUST.INTERFACE.RequestID1 = "Req_" + MID$(BANCS.STDIN.sysDate,6,4) + MID$(BANCS.STDIN.sysDate,3,2) + MID$(BANCS.STDIN.sysDate,0,2) + MID$(BANCS.STDIN.sysDate,11,2) + MID$(BANCS.STDIN.sysDate,14,2) + MID$(BANCS.STDIN.sysDate,17,2)
			print(CUST.INTERFACE.RequestID1)
		#}
		ENDIF

		CUST.INTERFACE.headerXML = ""
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<Header>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<RequestHeader>"
		CUST.INTERFACE.headerXML = CUST.INTERFACE.headerXML + "<MessageKey>"
