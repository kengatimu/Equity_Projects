										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<isAddressProofRcvd>N</isAddressProofRcvd>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<start_date>2021-10-01T14:04:17.017</start_date>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<addresscategory>Registered</addresscategory>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<FreeTextLabel>R</FreeTextLabel>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<cif_att_id>ADD</cif_att_id>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<hidden_cif_fld>Registered</hidden_cif_fld>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<deleteFlag>N</deleteFlag>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<building_level>" + CUST.INTERFACE.BUILDING_N0  + "</building_level>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<street_no>" + CUST.INTERFACE.StretN0 + "</street_no>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<house_no>" + CUST.INTERFACE.BUILDING_N0  + "</house_no>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<street_name>" + CUST.INTERFACE.STREET_NAME  + "</street_name>"										
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<city>" + CUST.INTERFACE.CITY  + "</city>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<country>" + CUST.INTERFACE.COUNTRY  + "</country>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<state>" + CUST.INTERFACE.STATE  + "</state>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<zip>243</zip>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<preferredAddress>N</preferredAddress>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<holdMailFlag>N</holdMailFlag>"
									CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</CorpAddressModData>"
								ENDIF
								
								IF (CUST.INTERFACE.MODMAIL == "Y") THEN 
									CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CorpAddressModData>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<preferredFormat>FREE_TEXT_FORMAT</preferredFormat>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<address_line1>" + CUST.INTERFACE.ADDRESS_LINE1  + "</address_line1>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<address_line2>" + CUST.INTERFACE.ADDRESS_LINE2  + "</address_line2>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<address_line3>" + CUST.INTERFACE.ADDRESS_LINE3  + "</address_line3>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<addressID>" + CUST.INTERFACE.ADDRESSMAILID  + "</addressID>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<isAddressProofRcvd>N</isAddressProofRcvd>"
										CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<addresscategory>Mailing</addresscategory>"
