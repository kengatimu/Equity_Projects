#    Report Name        : ator.mrt
#    Form Name          : bafe3024.bas
#    Menu Option        : ATOR
#	 Description		: This is the first pass mrt for the report
#    Spool File Name	:
#
#    Modification History :
#    Sl#  Date         Author            Modification
#    ---  --------     ------            ------------
#    1.   31-03-98     Dinesh           original Version
#    2.   29-08-2005   Agatha		modified the original version	 
################################################################################

RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include ator.mri

LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
numOfAccts 	numberType
slno		numberType	
cnt 		numberType	
dr_tot_thou numberType
avg_tot_cr_bal_thou numberType
avg_tot_dr_bal_thou numberType
high_dr_bal_thou numberType
high_cr_bal_thou numberType
 
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
####################################################################
foracid

REPOSITORY bankRepos.rip readonly
####################################################################
#   REPOSITORY SECTION
####################################################################
bankName		stringType
branchName		stringType
uniformBrCode	stringType
branchDistrict	stringType
branchState		stringType

REPOSITORY argv4
####################################################################
#   REPOSITORY SECTION
####################################################################
sol_id					stringType
page_number				numberType
report_to				stringType
crncy_code				stringType
start_date				stringType
end_date				stringType
acct_num_beg			stringType
acct_num_end			stringType
acct_num				stringType
schm_code				stringType

PAGEFORMAT
widowOrphanLines 2
LinesPerPage 64
LeftMargin 2
rightMargin 2
Topmargin	2
BottomMargin 2
columnsPerLine 132
pageHeaderLines	8
pageFooterLines 1

ONSTARTOFREPORT
	execute bankBrLineProc
	print"ACCOUNT TURNOVER REPORT" center size 132
	execute pageHdr
	execute SelectCrit
	nextPage
	set pageNumber = 1
	set numOfAccts = 0
	set slno = 1
	set cnt = 1

PAGEHEADER
	execute bankBrLineProc
	print "ACCOUNTS TURNOVER REPORT" center size 132
	execute pageHdr

PAGEFOOTER
separatorline


ONEVERYRECORD
begin
  if (cnt < 2)
  begin
   execute pageHdr
  end
  print slno precision 0
  print foracid column 5
  print crncy_code column 20
  print acct_name size 14 column 25
  print subStr startdate 1 10 column 40
  print subStr enddate 1 10 column 51
  set dr_tot_thou = dr_tot/1000
  set dr_tot_thou = roundoff dr_tot_thou H 1
  if (tot_cr_bal_day > 0)
   begin
	set avg_tot_cr_bal_thou = (tot_cr_bal/tot_cr_bal_day)/1000
   end
  else
   begin
	set avg_tot_cr_bal_thou = (tot_cr_bal/1000)
   end
   set avg_tot_cr_bal_thou = roundoff avg_tot_cr_bal_thou H 1
   if (tot_dr_bal_day > 0)
     begin
	set avg_tot_dr_bal_thou = (tot_dr_bal/tot_dr_bal_day)/1000
     end
   else
    begin
	set avg_tot_dr_bal_thou = (tot_dr_bal/1000)
   end
    set avg_tot_dr_bal_thou = roundoff avg_tot_dr_bal_thou H 1
    set high_dr_bal_thou = high_dr_bal/1000
    set high_dr_bal_thou = roundoff high_dr_bal_thou N 1
    set high_cr_bal_thou = high_cr_bal/1000
    set high_cr_bal_thou = roundoff high_cr_bal_thou N 1
    print dr_tot_thou column 62  precision 0
    print avg_tot_cr_bal_thou column 70 autocomma size 5 precision 0
   print tot_cr_bal_day column 80 autocomma size 5 precision 0 
   print avg_tot_dr_bal_thou column 88 autocomma size 5 precision 0
   print tot_dr_bal_day column 98 autocomma size 5 precision 0
   print high_dr_bal_thou column 106 autocomma size 5 precision 0
   print high_cr_bal_thou column 114 autocomma size 5 precision 0
   print no_of_dr_trans column 121 autocomma size 3 precision 0
   print no_of_cr_trans column 125 autocomma size 3 precision 0
   set numOfAccts = numOfAccts + 1
   set slno = slno + 1
   set cnt = cnt + 1
   nextline
   nextline
  end
##############################################################################

ONENDOFREPORT
if numOfAccts = 0
begin
	nextline
	separatorLine
	nextline
	print   " ****************   No accounts processed   **************"
	nextline
	separatorLine
	nextline
end
else
begin
	nextline
	separatorline	
	nextline
	nextline
	print "Signature :" column 90
	nextline
end
set page_number = pageNumber

##############################################################################

PROCEDURE bankBrLineProc
begin
	print today column 1
	print bankName column 35
	print " "
	print branchName
	print "Page: " column 120
	print pageNumber size 3 precision 0
	nextLine
	nextLine 
end

PROCEDURE pageHdr
begin
	nextLine
	nextLine
	print "ALL AMOUNTS IN THOUSAND" column 106	
	separatorLine
	print "Sl."
	print "Account" column 5
	print "Curr " column 20
	print "Account" column 25
	print "Start Date" column 40 
	print "End Date" column 51
	print "Turn" column 62
	print "Average" column 70
	print "Cr Bal" column 80
	print "Average" column 88
	print "Dr Bal" column 98
	print "Max Dr" column 106
	print "Max Cr" column 114
	print "No. Tran" column 121
	nextline
	print "No" 
	print "Number" column 5
	print "Code" column 20
	print "Name" column 25
	print "Over" column 62
	print "Cr Bal" column 70
	print "Days" column 80
	print "Dr Bal" column 88
	print "Days" column 98
	print "Amt" column 106
	print "Amt" column 114
	print "Dr  Cr" column 121
	nextline
	separatorLine
end
####################################################################
PROCEDURE SelectCrit
####################################################################
begin
	separatorLine
	nextline
	nextline
	print	"SELECTION CRITERIA"  center size 132 
	nextline
	print	"--------------------"  center size 132 
	nextline
	nextline
	print	"Report Name " column 20	
	print	" : " column 40	
	print	"ACCOUNTS TURNOVER REPORT"		
	nextline
	print	"Report To " column 20	
	print	" : " column 40	
	print	report_to	
	nextline
	print	"Service OutLet " column 20
	print	" : " column 40	
	print	sol_id
	nextline
	print	"Currency Code " column 20	
	print	" : " column 40	
	if crncy_code = ""
	begin
		print   "ALL"
	end
	else
	begin
		print	crncy_code	
	end
	nextline
	print	"Start Acct Number " column 20
	print	" : " column 40	
    print acct_num_beg
	nextline
	print	"End Acct Number " column 20
	print	" : " column 40	
    print acct_num_end
	nextline	
	print	"Scheme Code " column 20
	print	" : " column 40	
	print	schm_code
	nextline
	print	"Date Range From " column 20
	print	" : " column 40	
    print subStr start_date 1 10
	nextline
	print	"Date Range To " column 20
	print	" : " column 40	
    print subStr end_date 1 10
	nextline
	separatorLine
end

nextLine
#print " Account Number" column 5
#print " Account Name" column 20
#print "Debit Tunover" column 35
#print "Credit Turnover" column 50
#separatorline
