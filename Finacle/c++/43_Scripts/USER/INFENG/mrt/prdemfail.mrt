##################################################################
#  FILE   :  prdemfail.mrt
#  DATE   :  02-04-99
#  AUTHOR :  Sampath Kumar
#  DESC   :  This is the Mahareport specs for generating 
#
###################################################################
#
#
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
loanAcctId              stringType
solId                   stringType
crncyCode               stringType
customerId              stringType
reasonForFail           stringType
shdlNum                 stringType
flowStartDate           stringType
nextDmdDate             stringType
nextIntDmdDate          stringType
flowAmt                 numberType
sumPrincipalDmdAmt      numberType 
pendPrincipalAmt        numberType 
deferredIntAmt          numberType 
overdueShdlPrinAmt      numberType 
overdueShdlInterestAmt  numberType 
numOfFlows              numberType 
numOfDmds               numberType 

#
#
LOCALVARIABLES
SlNo                    numberType
localdate   			numberType
localyears  			numberType
recordKey               stringType
errorCode               stringType
exeName                 stringType
errorMsg                stringType
callscript              numberType

####################################################################
# Local variables are defined here
####################################################################
#
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in 
#   RECORDLAYOUT section.
####################################################################
#############################################################################
#
#	REPOSITORY (Optional Section) - Fixed-Type Repository.
#	This section tells about the Repository Information. A  Repository  is  a 
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#	Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#   
#############################################################################
#REPOSITORY  argv4
#PAGE_NUMBER                numberType
#
#==============================================================================
REPOSITORY bankRepos.rip readonly
#==============================================================================

localYearsToAdd     stringType
bankName			stringType
branchName			stringType
uniformBrCode		stringType
branchCity			stringType
branchPinCode		stringType
branchState			stringType
branchAddr1			stringType
branchAddr2			stringType
branchAddr3			stringType  

#==============================================================================
REPOSITORY argv4 
#==============================================================================
report_to				stringType
set_id					stringType
acct_crncy_code			stringType
concat_schm_code		stringType
low_foracid				stringType
high_foracid			stringType
print_int_detail		stringType
inc_npa_acct			stringType
inc_disabled_acct		stringType
force_int_run			stringType
force_int_run_till_date	stringType
type_of_dmd             stringType
trial_mode				stringType
ovNPAIntFlg             stringType 
productGroup            stringType			
menu_parm               stringType
page_number             numberType
#MASSAGERECORD
#############################################################################
#
# 	MASSAGERECORD (Optional Section).
# 	The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#	later. This Block is executed every time a new record is read.
#
#############################################################################


#############################################################################
#
# 	IGNORERECORD (Optional Section).
# 	The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
# 	for input records), the record is Ignored.
#
#############################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage     65
columnsperline   132
topMargin         0
bottomMargin      0
leftMargin        0
pageHeaderLines	  6
pageFooterLines   2
#
PAGEHEADER
####################################################################
# This section prints the header
####################################################################
execute pageHeader
####################################################################
# This section printd the footer
####################################################################
PAGEFOOTER
print "Page: " column 72
print pageNumber size 3 precision 0
ONSTARTOFREPORT
####################################################################
# This section initializes all the local variables.
####################################################################
set SlNo = 1
set localyears = strToNum localYearsToAdd
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 1
print " "
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "HH24:NN:SS"
print bankName  column 35
print "Page:" column 65
print pageNumber column 71 precision 0


nextline
print branchName column 35
nextline
nextline

print "Demand Creation - Failure Report " column 25
nextline
nextline
execute pageHeader
nextline
####################################################################
####################################################################
####################################################################
####################################################################
####################################################################
#
#
#
####################################################################
####################################################################
#
#
####################################################################
#	It will be executed once for each recod.
####################################################################
ONEVERYRECORD

set callscript = runscript "prdemfail.scr" "reasonForFail|loanAcctId" "dummy"

print  SlNo             	column 2  size 5 precision 0
print  loanAcctId           column 8  size 16
print  solId				column 25 size 9
print  crncyCode     		column 35 size 10
print  customerId 			column 46 size 33
nextLine
print  reasonForFail        column 8  size 125
nextLine
set SlNo=SlNo+1
#
ONENDOFREPORT
#############################################################################
#
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
#
#############################################################################
nextline
set page_number = pageNumber
if ((totalCount loanAcctId) = 0)
begin
    print " ******************* NO RECORD FOUND *********************"
end
nextLine
SeparatorLine
#set PAGE_NUMBER = pagenumber
#
#############################################################################
#
# 	PROCEDURE BLOCK.
#  	Procedure  itself is a Independent  Block  and  defined at the end of the 
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#	Template File, Makes  it  Structured  and  avoids burring the same set of 
#   codes at several places.
#
#############################################################################
PROCEDURE pageHeader
nextLine
SeparatorLine
nextLine
print  "Sl.No" 						column 2  size 6
if ( menu_parm = "E" )
begin
print  "Lease Account"          	column 8 size 16
end
else
begin
print  "Loan Account" 				column 8  size 16
end
print  "Sol Id"                		column 25 size 9
print  "Crncy Code"            		column 35 size 10
print  "CIF ID "             		column 48 size 8 
nextLine
print  "Reason For Failure"        	column 8  size 120
nextLine
SeparatorLine
nextLine
#############################################################################
#========================================================================


