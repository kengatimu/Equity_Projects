GROUPANDSORT
###############################################################################
###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine 1000 
LinesPerPage   	5000 
LeftMargin       00
RightMargin      00
Topmargin        00
BottomMargin     00
pageHeaderLines  00
pageFooterLines  00
##############################################################################
ONEVERYRECORD
##############################################################################
set for_lpad = rpad foracid 16 " "
print for_lpad size 16 column 1

set crncy_code = rpad crncy 3 " "
print crncy_code size 3 column 17


set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print ind column 28

set clr_lpad = lpad amt 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set refamt_lpad	 = rpad ref_amt 17 " "
print refamt_lpad size 17 column 131

set refcrncy_code = rpad ref_crncy_code 3 " "
print refcrncy_code size 3 column 148


set ratecode_lpad = rpad rate_code 5 " "
print ratecode_lpad size 5 column 151


set rate_lpad = rpad rate 15 " "
print rate_lpad size 15 column 156

set takataka = lpad takataka 705 " "
print takataka size 705 column 171

#print "COLLC" size 5 column 931
