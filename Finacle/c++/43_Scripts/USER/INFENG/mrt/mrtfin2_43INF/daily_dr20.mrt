#    ------  --------       ------------           -----------                  *
#    1.0     17-10-2005     Robert Oduor         Original Version             *
#                                                                               *
#################################################################################

#**********************************************************************
#  DESC   :    Outward Clearing Value Date Report 
######################################################################
RECORDLAYOUT
####################################################################
#   
####################################################################
tran_date         stringtype
tran_id           stringtype
bank_name         stringtype
br_name           stringtype
sol_id            stringtype
foracid           stringtype
acct_name         stringtype
tran_amt          numberType
instrmnt_num      stringType
######################################################################
LOCALVARIABLES
####################################################################
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType
#
GROUPANDSORT 
####################################################################
bank_name
br_name
foracid
####################################################################
#
#REPOSITORY bankRepos.rip
############################################################################
#bankName        stringType
#branchName      stringtype
#
#############################################################################
REPOSITORY  argv4
#############################################################################
ipSetId 			stringType
ipFrmDate			stringType
ipToDate			stringType
#
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
ONSTARTOFREPORT
#############################################################################

execute brBankHdg 
execute pageHdg
#
PAGEHEADER
###################################################################
execute brBankHdg 
execute pageHdg
#
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    66
columnsperline 140
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 7
pagefooterlines 4
#
#AFTERBREAKOF 
####################################################################
#AFTERBREAKOF
####################################################################
#
ONEVERYRECORD
####################################################################

####################################################################
begin
     print tran_date column 2 
     print tran_id  column 13
     print foracid column 23
     print acct_name  column 40 
     print bank_name column  70 
     print br_name  column 90 
     print instrmnt_num column 110 
     print tran_amt column  120  format "###,###,###.##"
     nextline
end 
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
nextline
print " Grand Total " column 5 
print totalsum tran_amt  column 115 format "###,###,###.##"
     separatorline
     print "printed by:" column 45 
     print  lv_userId
     nextline
     nextline
     print "verified by:" column 45 
     print "........................" column   58 
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 140 center
end
#
Procedure  pageHdg
######################################################################n
begin
     nextline
     print "Outward Clearing Value Date Report "  size  140 center 
     nextline
     nextline
     print " From  " column 50 
     print ipFrmDate  
     print "  &  "
     print ipToDate   
     nextline
     separatorline
end

begin
	print "Tran Date" column 2  size 11 center
        print "Trans code" column  13 size 10 center
	print "Account no" column 23 size 17 center
	print "Account Name" column  40  size 30 center
	print "Bank name" column  70 size 20 center
	print "Branch name" column  90 size 20 center
	print "inst. No" column 110 size 10 center
	print "trans Amt" column 120 size 20 center 
        separatorline	
end

#######################################################################
PROCEDURE brBankHdg
#############################################################################
begin
        print "Page No. "   column 100 
        print page_number precision 0
        nextline
        print today column   100 
        nextline
        nextline
	print " EQUITY BANK LIMITED"  size 140 center 
	nextline
        set lv_setid = ipsetId
        set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 140 center 

end

####################################################################
# End of File
######################################################################
