# **********************************************************************************
#    Advice Name                : Monthly Lien on CA accounts
#    Template name File Name    : ODCALien.mrt
#
#    Modification Log   :
#    Sr.no.  Date        Author      Description
#    ------  --------    ------      ----------------
#    1.0     11/12/2018  SHIVA    Monthly Lien on CA accounts
# **********************************************************************************

####################################################################
RECORDLAYOUT
####################################################################
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
foracid                 stringType
description             stringType

####################################################################
LOCALVARIABLES
####################################################################
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
srlnum2 numberType

GROUPANDSORT
foracid


IGNORERECORD

REPOSITORY bankRepos.rip readonly
            bankName   stringType
            branchName stringType
			
####################################################################
PAGEFORMAT
####################################################################
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
        LinesPerPage 60
        LeftMargin 0
        rightMargin 0
        Topmargin       0
        BottomMargin 0
        columnsPerLine 144
        pageHeaderLines  9
        pageFooterLines  1
        IgnoreBlankRecord

####################################################################
ONEVERYRECORD
####################################################################
begin
        nextline
        print foracid column 7 size 25
        print description column 55 size 50
        nextline
end

####################################################################
PAGEHEADER
####################################################################
        execute pageheader

####################################################################
PAGEFOOTER
####################################################################
        separatorline

####################################################################		
ONSTARTOFREPORT
####################################################################
####################################################################
#   This section will be executed only once during the processing of
#               report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
        set srlnum2 = 0
		
####################################################################
ONENDOFREPORT
####################################################################
        nextline
        separatorline
        nextline
        print " *** End of Report *** " size 130 center
####################################################################
PROCEDURE pageheader
####################################################################
        begin
        nextline
        print bankName column 3
        nextline
        print "Monthly Lien on CA accounts" column 3
	nextline
        separatorline
        nextline 
	nextline
	print "Account No." column 7
	print "Description" column 55
	end
