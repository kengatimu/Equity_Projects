# Template Name :		monthly_dr100.mrt
# Description	:		Head Office Cost Allocation
# Author			E.G.KAROBIA, 05-05-2006
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
$$$include monthly_dr100.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
tDeposits		numberType		
tLoans			numberType
tcash			numberType	
tbank			numberType
tinterSolBal		numberType
tdepreciation		numberType
tOperating		numberType
tAdmin			numberType
ttotalOperExp		numberType
testablishment		numberType
tmarketing		numberType	
tTotEstMktExp		numberType

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 70
columnsperline 250
pageheaderlines 10
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipDate				stringType


#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter != 0)
 begin
 separatorline
 set tDeposits= totalsum deposits			
 set tLoans= totalsum Loans			
 set tcash= totalsum cash				
 set tbank= totalsum bank			
 set tinterSolBal= totalsum interSolBal		
 set tdepreciation= totalsum depreciation		
 set tOperating	= totalsum Operating		
 set tAdmin = totalsum Admin			
 set ttotalOperExp= totalsum totalOperExp		
 set testablishment= totalsum establishment		
 set tmarketing	= totalsum marketing		
 set tTotEstMktExp= totalsum TotEstMktExp		
	execute pipe
        print "TOTAL" column 2
	print tDeposits		column 10 format "###,###,###,###.##"		
	print tLoans		column 30 format "###,###,###,###.##"		
	print tcash		column 50 format "###,###,###,###.##"			
	print tbank		column 70 format "###,###,###,###.##"		
	print tinterSolBal	column  90 format "###,###,###,###.##"	
	print tdepreciation	column 110 format "###,###,###,###.##"	
	print tOperating	column 130 format "###,###,###,###.##"
	print tAdmin		column 150 format "###,###,###,###.##"		
	print ttotalOperExp	column 170 format "###,###,###,###.##"	
	print testablishment	column 190 format "###,###,###,###.##" 	
	print tmarketing	column 210 format "###,###,###,###.##"	
	print tTotEstMktExp	column 230 format "###,###,###,###.##"
 separatorline
 end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 50
Print lv_userId
print "   " 
print today  
print "       Authorised Signatory"  column 100
nextline
nextline
nextline
nextline
print "********************End Of Report*********************" size 250 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF sol_id
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
       execute pipe
	print sol_id column 2			
	print Deposits 	column 10 format "##,###,###,###.##"		
	print Loans column 30 format "###,###,###,###.##"		
	print cash column 50 format "###,###,###,###.##"			
	print bank column 70 format "###,###,###,###.##"		
	print interSolBal column  90 format "###,###,###,###.##"	
	print depreciation column 110 format "###,###,###,###.##"	
	print Operating	column 130 format "###,###,###,###.##"
	print Admin column 150 format "###,###,###,###.##"		
	print totalOperExp column 170 format "###,###,###,###.##"	
	print establishment column 190 format "###,###,###,###.##" 	
	print marketing	column 210 format "###,###,###,###.##"	
	print TotEstMktExp column 230 format "###,###,###,###.##"
		
  nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
        execute pipe
	print "BRANCH" column 2			
	print "DEPOSITS" column 16 		
	print "LOANS" column 38		
	print "CASH" column 59 			
	print "BANK" column 79 		
	print "INTER_SOL_BAL" column  93 	
	print "DEPRECIATION" column 115 	
	print "OPERATING"	column 137 
	print "ADMINISTRATION" column 153 		
	print "TOT_OPER_EXP" column 175	
	print "ESTABLISHMENT" column 195  	
	print "MARKETING" column 217	
	print "TOT_EST_MKT_EXP" column 234
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 240 center 
	nextline
	print "HEAD COST ALLOCATION"  size  250 center
	nextline
	print "FOR BRANCH:" column 117
	print ipSetId
	nextline
	print "DATE :" column 116
	print "   "
	print ipDate
	
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 250 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

     begin
	print "|" column 1			
	print "|" column 9 		
	print "|" column 29 		
	print "|" column 49			
	print "|" column 69 		
	print "|" column  89 	
	print "|" column 109	
	print "|" column 129
	print "|" column 149 		
	print "|" column 169	
	print "|" column 189 	
	print "|" column 209 	
	print "|" column 229
	print "|" column 250
	
	end


