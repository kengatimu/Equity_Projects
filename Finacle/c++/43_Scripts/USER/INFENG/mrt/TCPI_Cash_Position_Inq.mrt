# **********************************************************************************
#    Advice Name                : tcpi
#    Template name File Name    : 
#
#    Modification Log   :
#    Sr.no.  Date        Author      Description
#    ------  --------    ------      ----------------
#
# **********************************************************************************

####################################################################
RECORDLAYOUT
####################################################################
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
ccy                 stringType
ccydesc			stringType
foracid             stringType
todayp                 stringType
dc1			stringType
futurep             stringType
dc2                 stringType
####################################################################
LOCALVARIABLES
####################################################################
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
srlnum2 numberType
empId	stringType
empName stringType
noofrec	numberType
callscript		stringType
GROUPANDSORT
foracid


IGNORERECORD

REPOSITORY bankRepos.rip readonly
            bankName   stringType
            branchName stringType
			
####################################################################
PAGEFORMAT
####################################################################
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
        LinesPerPage 60
        LeftMargin 0
        rightMargin 0
        Topmargin       0
        BottomMargin 0
        columnsPerLine 144
        pageHeaderLines  9
        pageFooterLines  1
        IgnoreBlankRecord

####################################################################
ONEVERYRECORD
####################################################################
begin
        nextline
		print ccy column 1 size 5
	print ccydesc column 6 size 20
        print foracid column 31 size 20
        print todayp column 51 size 25
	print dc1 column 78 size 10
        print futurep column 98 size 25
		print dc2 column 125 size 10
        nextline
end
####################################################################
PAGEHEADER
####################################################################
        execute pageheader

####################################################################
PAGEFOOTER
####################################################################
        separatorline

####################################################################		
ONSTARTOFREPORT
####################################################################
####################################################################
#   This section will be executed only once during the processing of
#               report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
        set srlnum2 = 0
		set callscript = runscript "crprintdp002.scr" "srlnum2" "empId|empName"
####################################################################
ONENDOFREPORT
####################################################################
        nextline
        separatorline
        nextline
        print " *** End of Report *** " size 130 center
####################################################################
PROCEDURE pageheader
####################################################################
        begin
        print bankName column 3
        nextline
        print "Cash Position Inquiry by Teller" column 3
	nextline
        separatorline
        nextline
		nextline
		print "EmployeeId:" column 3
		print empId column 15
		print "Employee Name:" column 40
		print empName column 55
		nextline
		separatorline
		nextline
        print "CCY" column 1
	print "CCY Description" column 6
        print "Cash A/c." column 31
		print "Today Position" column 51
	print "Debit/Credit" column 78
        print "Future Position" column 98
		print "Debit/Credit" column 125
        end