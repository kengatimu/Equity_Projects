#=========================================================================
#	Report Name			: INTEREST CALC REPORT OF ACCOUNTS
#	Template File Name	: acctIntFail.mrt
#	Description 		: This MRT File will be used to print the report
#						  of FAILURE of Interest Calculation for accounts.
#	Modification log
#	----------------
#	Srl.No.		Date		Author		Description		   Bancs2000 Ver
#	------   ----------     ------      ----------------   --------------
#	1.		 01-12-1998     Vishal		Original version   1.6.37
#=========================================================================

############################################
# This report is not suitable for pretty report
# generation as either the output file name or
# the output file suffix is being hard coded in
# the source <icuu9133.cxx>
############################################
RECORDLAYOUT
#=========================================================================
$$$include intFail.mri

#=========================================================================
LOCALVARIABLES
#=========================================================================
localdate				  numberType
localyears				  numberType
subString1      		  stringType
subString2      		  stringType
recordKey       		  stringType
errorCode       		  stringType
exeName         		  stringType
callscript                numberType

#=========================================================================
GROUPANDSORT
#=========================================================================

#=========================================================================
REPOSITORY bankRepos.rip readonly
#=========================================================================
	localYearsToAdd		stringType
	bankName                stringType
	branchName              stringType

#=========================================================================
REPOSITORY argv4
#=========================================================================
	ReportTo           stringType
	SolId              stringType
	CurrencyCode       stringType
	FromAccount        stringType
	ToAccount          stringType
	FromGLshCode       stringType
	ToGLshCode         stringType
	FromSchmCode       stringType
	ToSchmCode         stringType
	FromCustId         stringType
	ToCustId           stringType
	SchmType           stringType
	FromDate           stringType
	ToDate             stringType
	ValueDate		   stringType
	PostFlag 		   stringType
	FlowType 		   stringType
	FreqBasedIntRun    stringType
	DrCrInd            stringType
	AdHocMode 		   stringType
	InterestDetail 	   stringType
	InclClosedAcct     stringType
	InclNPAAcct        stringType
	InclDisabledAcct   stringType
	InclDormantAcct    stringType
	InclFrozenAcct     stringType
	BookForRev		   stringType
	PrintIntAdvc	   stringType
	page_number		   numberType
	CurrentSolId       stringType
	ovNPAIntFlg        stringType
	MenuParm           stringType
	InputFileName      stringType
	productGroup       stringType
	
#=========================================================================
MASSAGERECORD
#=========================================================================

#=========================================================================
IGNORERECORD
#=========================================================================

#=========================================================================
PAGEFORMAT
#=========================================================================
	LinesPerPage 64
	LeftMargin 2
	rightMargin 2
	Topmargin   2
	BottomMargin 2
	columnsPerLine 132  
	pageHeaderLines 12
	pageFooterLines 2
	IgnoreBlankRecord

#=========================================================================
ONSTARTOFREPORT
#=========================================================================
	set localyears = strToNum localYearsToAdd
	set pageNumber = 1
	execute commonPageHdr
	nextline
	execute printCriteria
	nextPage

#=========================================================================
PAGEHEADER
#=========================================================================
	execute commonPageHdr
	execute pageHeader

#=========================================================================
PAGEFOOTER
#=========================================================================
	print "" size  132 fillAscii 45
	separatorLine

#=========================================================================
ONEVERYRECORD
#=========================================================================
	print 	entity 		size 16 	column 2
	if(interestInd = "C")
	begin
		print "CR."  	size 4      column 28
	end
	else if(interestInd = "D")
	begin
		print "DR."   	size 4      column 28
	end
	if (startDate > endDate)
    begin
        set localdate = stringToDate  endDate
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 35

    end
    else
    begin
        set localdate = stringToDate  startDate
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 35
	
    end
	set localdate = stringToDate  endDate
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 46
	print masteracctnum	column 60 size 16
	
    nextline	
	set subString1 = substr errorMsg,1,125
	set subString2 = substr errorMsg,126,150
	print 	subString1		size 125	column 2
    nextline	
	print 	subString2		size 125	column 2
	
	execute LogErrorToDB
#=========================================================================
ONENDOFREPORT
#=========================================================================
	nextline
	nextline
	separatorLine
	print "***   " column 1
	print pageNumber size 3 column 8 precision 0
	print "PAGES PRINTED. ****END OF REPORT****" size 40 column 12
	set page_number = pageNumber

#=========================================================================
PROCEDURE commonPageHdr
#=========================================================================
    set localdate = stringToDate  today
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 1
    print " " 
    set localdate = stringToDate  today 
    set localdate = periodAdd localdate localyears Y 
    print localdate DateFormat "HH24:NN:SS"
	print bankName 	column 35 
	print "Page:" column 65
	print pageNumber column 71  precision 0
	nextline
	print branchName column 35 
	nextLine
	nextLine
	if( MenuParm = "BOOKING" OR MenuParm = "LMBOOKING")
	begin
		print "INTEREST BOOKING FAILURE REPORT" column 25
	end
	else if( MenuParm = "ACCRUAL" OR MenuParm = "LMACCRUAL")
	begin
		print "INTEREST ACCRUAL FAILURE REPORT" column 25
	end
	else if( MenuParm = "INTRUN" OR MenuParm = "LMINTRUN")
	begin
		print "INTEREST APPLICATION FAILURE REPORT" column 25
	end
	else
	begin
		print "INTEREST CALCULATION REPORT OF FAILURES" column 25
	end

#=========================================================================
PROCEDURE pageHeader
#=========================================================================
	nextline
	separatorLine
	nextline
	print "ACCOUNT NUM"  		column 2
	print "DR/CR "		 		column 28
	print "START DATE"    		column 35
	print "END DATE"    		column 46
	print "MASTER A/C"			column 60
    nextline
	print "ERROR MESSAGE"		column 2
	separatorLine

#=========================================================================
PROCEDURE printCriteria
#=========================================================================
	nextLine
	nextLine
	separatorLine
	nextline
	nextline
	print   "SELECTION CRITERIA" 			column 20
	nextline
	print   "-------------------" 			column 20
	nextline
	nextline
	print   "Report To                 : "  column 10
	print 	ReportTo						
	nextLine
	print   "Sol Id                    : "  column 10 
	print 	SolId						
	nextLine
	print   "Crncy Code                : "  column 10
	print CurrencyCode 
	nextLine
	print   "Acct Range                : "  column 10 
	print FromAccount 
	print   " To "  column 54 
	print ToAccount column 58 
	nextLine
	print   "GL Subhead Code           : "  column 10
	print FromGLshCode  
	print   " To " 	column 43
	print ToGLshCode column 47 
	nextLine
	print   "Scheme Code               : "  column 10
	print FromSchmCode 
	print   " To " 	column  43 
	print ToSchmCode  column 47 
	nextLine
	print   "CIF ID                    : "  column 10 
	print FromCustId 
	print   " To " 	column 89 
	print ToCustId  column 94 
	nextLine
	print   "Scheme Type               : "  column 10 
	print SchmType 
	nextLine
	print   "Date Range                : "  column 10
	set localdate = stringToDate  FromDate
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat ""
	print   " To " 	column  49 
	set localdate = stringToDate  ToDate
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 55
	 
	nextLine
	print   "Value Date                : "  column 10   
	set localdate = stringToDate  ValueDate
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat ""
	
	nextLine
	print   "Post Flag                 : "  column 10 
	print PostFlag 
	nextLine
	print   "Flow Type                 : "  column 10
	print FlowType 
	nextLine
	print   "Freq Based Int Run?       : "  column 10 
	print FreqBasedIntRun
	nextLine
	print   "Dr/Cr Indicator           : "  column 10
	print DrCrInd
	nextLine
	print   "Adhoc Mode?               : "  column 10 
	print AdHocMode 
	nextLine
	print   "Interest Detail?          : "  column 10
	print InterestDetail 
	nextLine
	print   "Incl Closed A/c?          : "  column 10 
	print InclClosedAcct
	nextLine
	print   "Incl NPA Acct?            : "  column 10 
	print InclNPAAcct
	nextLine
	print   "Incl Disabled A/c?        : "  column 10
	print InclDisabledAcct 
	nextLine
	print   "Incl Dormant A/c?         : "  column 10
	print InclDormantAcct
	nextLine
	print   "Incl Frozen A/c?          : "  column 10
	print InclFrozenAcct
	nextLine
	print   "Book For Rev?             : "  column 10
	print BookForRev
	nextLine
	print   "Print Int Advc?           : "  column 10   
	print PrintIntAdvc
	nextLine
	print   "Override NPA Int Flag?    : "  column 10
	print ovNPAIntFlg
	nextLine
    if (CurrentSolId != SolId)
    begin
		print "Running For Sol           : " column 10
        print CurrentSolId
        nextLine
    end
	print   "Input File Name    : "  column 10
	print InputFileName 
	nextLine
	print  "Product Group     : " column 10
    print productGroup
    nextLine
	separatorLine

#========================================================================
PROCEDURE LogErrorToDB
nextline
set recordKey = entity
set errorCode = ""
set exeName = "icbx4012"
set callscript = runscript "errorLogIntoDB.scr" "recordKey|errorCode|exeName|errorMsg" "|"
nextline

#============================ End Of File ================================

