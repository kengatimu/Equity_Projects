#vp
<--start
trace on
#Rep/Class
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_p = urhk_B2k_PrintRepos("BANCS")
        print(sv_p)
	if(fieldexists(BANCS.STDIN.menuId)==1)then
		print(BANCS.STDIN.menuId)	
	endif
	if((BANCS.STDIN.menuId=="HPORDM"))then
	#{
		if(fieldexists(BANCS.INPUT.pymtRefNum)==1)then
			EQSRV.GLBDATA.pymtRefNum = BANCS.INPUT.pymtRefNum
		else
			EQSRV.GLBDATA.pymtRefNum = ""
		endif
		sv_d = " isPolCnt | select count(*) from tbaadm.pord "
		sv_d = sv_d + " where bank_id=?SVAR and pymt_ref_num=?SVAR "
		sv_d = sv_d + " and rcre_user_id='FIVUSR43'  "
		sv_d = sv_d + " and exists ( select 1 from tbaadm.sst "
		sv_d = sv_d + " where bank_id=?SVAR and set_id='ALL' and sol_id=pord.sol_id and entity_cre_flg='Y') " 
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.pymtRefNum + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		print(sv_d)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EQSRV.GLBDATA.isPolCnt = BANCS.OUTPARAM.isPolCnt
		else
			EQSRV.GLBDATA.isPolCnt = 0
		endif

		if(cdouble(EQSRV.GLBDATA.isPolCnt)>=1)then			
			sv_d = " Channel | select FREE_TEXT1 from tbaadm.pord "
			sv_d = sv_d + " where bank_id=?SVAR and pymt_ref_num=?SVAR "
			sv_d = sv_d + " and rcre_user_id='FIVUSR43'  "
			sv_d = sv_d + " and exists ( select 1 from tbaadm.sst "
			sv_d = sv_d + " where bank_id=?SVAR and set_id='ALL' and sol_id=pord.sol_id and entity_cre_flg='Y') " 
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.pymtRefNum + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			print(sv_d)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EQSRV.GLBDATA.Channel = BANCS.OUTPARAM.Channel
			else
				EQSRV.GLBDATA.Channel = "NA"
			endif			
						

			IF ((EQSRV.GLBDATA.Channel =="POL") or (EQSRV.GLBDATA.Channel =="OMN"))   THEN
				EQSRV.GLBDATA.output = "Y"
				sv_a = urhk_SetOrbOut("resultMsg|" + EQSRV.GLBDATA.output)
				sv_u = urhk_SetOrbOut("Channel|"+EQSRV.GLBDATA.Channel)
			ELSE
				EQSRV.GLBDATA.output = "N"
				EQSRV.GLBDATA.Channel ="NA"			
				sv_a = urhk_SetOrbOut("resultMsg|" + EQSRV.GLBDATA.output)
				sv_u = urhk_SetOrbOut("Channel|"+EQSRV.GLBDATA.Channel)
			ENDIF
		else
			EQSRV.GLBDATA.output = "N"
			EQSRV.GLBDATA.Channel ="NA"			
			sv_a = urhk_SetOrbOut("resultMsg|" + EQSRV.GLBDATA.output)
			sv_u = urhk_SetOrbOut("Channel|"+EQSRV.GLBDATA.Channel)
		endif
	#}
	endif
exitscript
trace off
end-->
