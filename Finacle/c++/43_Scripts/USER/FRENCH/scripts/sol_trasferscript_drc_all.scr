<--START
CHECKSUM="12bc5eba98f2095abab1281d4352ba23d3dfd39f92cf51e1d8f4c66717c80772"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	sv_r = REPEXISTS("CUSTS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUSTS", "GLBDATA", 5)
	#}
	ENDIF
	
	sv_q=" schm_type, foracid,acct_crncy_code,schm_code,to_sol, from_sol,gl_sub_head_code, status |"
	sv_q = sv_q + " select schm_type, foracid,acct_crncy_code, schm_code, to_sol, from_sol, gl_sub_head_code, "
	sv_q = sv_q + " case when schm_type in  ( 'SBA','CAA') then  SMT  when schm_type= 'ODA' then CAM  "
	sv_q = sv_q + " when schm_type in ('TUA','TDA') then TAM  when schm_type= 'LAA' then 'N' end Status  "
	sv_q = sv_q + " from (select a.foracid, acct_crncy_code ,schm_code,  a.sol_id to_sol ,cust_pref, "
	sv_q = sv_q + " gam.sol_id from_sol , gl_sub_head_code , schm_type, (select acct_status from  "
	sv_q = sv_q + " tbaadm.tam where acid = gam.acid and bank_id = gam.bank_id) TAM, "
	sv_q = sv_q + " (select acct_status from  tbaadm.cam where acid = gam.acid and bank_id = gam.bank_id) CAM, "
	sv_q = sv_q + " (select acct_status from  tbaadm.smt where acid = gam.acid and bank_id = gam.bank_id) SMT "
	sv_q = sv_q + " from custom.transfer_drc_accounts a, tbaadm.gam  where a.bank_id = ?SVAR and a.entity_cre_flg='S'  "
	sv_q = sv_q + " and a.foracid =gam.foracid   and a.bank_id =gam.bank_id )order by from_sol "
	
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	
	sv_e = urhk_dbCursorOpenWithBind(sv_q)
	
	IF(sv_e==0) THEN
	#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		
		WHILE(sv_q==0)
		#{
			CUSTS.GLBDATA.foracid=BANCS.OUTPARAM.foracid
			print (CUSTS.GLBDATA.foracid)
			CUSTS.GLBDATA.acct_crncy_code =BANCS.OUTPARAM.acct_crncy_code
			print (CUSTS.GLBDATA.acct_crncy_code)
			CUSTS.GLBDATA.schm_code=BANCS.OUTPARAM.schm_code
			print (CUSTS.GLBDATA.schm_code)
			CUSTS.GLBDATA.to_sol=BANCS.OUTPARAM.to_sol
			print (CUSTS.GLBDATA.to_sol)
			CUSTS.GLBDATA.from_sol=BANCS.OUTPARAM.from_sol
			print (CUSTS.GLBDATA.from_sol)
			CUSTS.GLBDATA.gl_sub_head_code=BANCS.OUTPARAM.gl_sub_head_code
			print (CUSTS.GLBDATA.gl_sub_head_code)
			CUSTS.GLBDATA.status=BANCS.OUTPARAM.status
			print (CUSTS.GLBDATA.status)
			CUSTS.GLBDATA.schm_type=BANCS.OUTPARAM.schm_type
			print (CUSTS.GLBDATA.schm_type)
			
			IF(CUSTS.GLBDATA.from_sol != BANCS.STDIN.mySolId)THEN
			#{
				sv_u = urhk_SetUrhkInp("sol.solId|"+CUSTS.GLBDATA.from_sol)
				print(sv_u)
				sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
				print(sv_u)
			#}
			ENDIF

			sv_a=urhk_SetUrhkInp("fromSol.solId|" + CUSTS.GLBDATA.from_sol)
			print(sv_a)			
			sv_a=urhk_SetUrhkInp("toSol.solId|" + CUSTS.GLBDATA.to_sol)
			print(sv_a)			
			sv_a=urhk_SetUrhkInp("xferAcct.foracid|" + CUSTS.GLBDATA.foracid)
			print(sv_a)			
			IF (CUSTS.GLBDATA.schm_type != "LAA") THEN
				sv_a=urhk_SetUrhkInp("acctStat.code|" + CUSTS.GLBDATA.status)
				print(sv_a)
			ENDIF		
			sv_a=urhk_SetUrhkInp("xferAcct.crncyCode|" + CUSTS.GLBDATA.acct_crncy_code)
			print(sv_a)			
			sv_a=urhk_SetUrhkInp("schm.schmCode|" + CUSTS.GLBDATA.schm_code)
			print(sv_a)			
			sv_a=urhk_SetUrhkInp("glSubHead.glSubHeadCode|" + CUSTS.GLBDATA.gl_sub_head_code)
			print(sv_a)			
			sv_a=urhk_SetUrhkInp("verifyStat|Y")
			print(sv_a)			
			sv_u = urhk_ExecSrv("SRV_XferAcctBtwnSolAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			
			IF(sv_u == 0) THEN
			#{
				sv_s = "UPDATE CUSTOM.transfer_drc_accounts "
				sv_s = sv_s + " SET entity_cre_flg = 'P' "
				sv_s = sv_s + " WHERE foracid= ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUSTS.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
			#}
			ENDIF
			
			IF (sv_u != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				
				IF (sv_v > 0) THEN
				#{
					sv_u = system("echo 'Error for Acct:"+CUSTS.GLBDATA.foracid+" ' >>transfer.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)

						sv_s = "UPDATE CUSTOM.transfer_drc_accounts "
						sv_s = sv_s + " SET entity_cre_flg = 'Z', CUST_PREF = ?SVAR "
						sv_s = sv_s + " WHERE foracid= ?SVAR"
						sv_s = sv_s + " AND bank_id = ?SVAR"
						print(sv_s)
						BANCS.INPARAM.BINDVARS = sv_e + "|" + CUSTS.GLBDATA.foracid + "|" + BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)						
						sv_d = urhk_dbSQLWithBind(sv_s)
						IF (sv_d == 0) THEN
							sv_c = urhk_dbSQLWithBind("commit")
							print(sv_c)
						ENDIF

						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>transfer.log")
						print(sv_u)
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
			
			
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			
		#}
		DO
		print("ALL ACCOUNTS ARE TRANSFERED")
	#}
	ENDIF
	
	
	TRACE OFF
	exitscript
END-->
