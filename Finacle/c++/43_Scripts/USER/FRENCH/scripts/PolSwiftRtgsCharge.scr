<--START
TRACE ON
IF (REPEXISTS("CUST") == 0 ) THEN
	CREATEREP("CUST")
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	CREATECLASS("CUST","DATA",5)
ENDIF

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
CUST.DATA.errFlg = "N"
CUST.DATA.errMsg = " "
CUST.DATA.paysysId = " "
CUST.DATA.eventid= " "
CUST.DATA.ConvAmount =0



IF(FIELDEXISTS(BANCS.INPUT.RemitCrncyCode))THEN
	IF(BANCS.INPUT.RemitCrncyCode !="")THEN
		CUST.DATA.remitCrncy = TOUPPER(TRIM(BANCS.INPUT.RemitCrncyCode))
		PRINT(CUST.DATA.remitCrncy)
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Remittance Currency Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF
ELSE
	CUST.DATA.errFlg = "Y"
	CUST.DATA.errMsg = "Remittance Currency Not Entered"
	GOTO ENDOFSCRIPT
ENDIF

IF(FIELDEXISTS(BANCS.INPUT.RemitAmt))THEN
	IF(BANCS.INPUT.RemitAmt !="")THEN
		CUST.DATA.remitAmt = TOUPPER(TRIM(BANCS.INPUT.RemitAmt))
		PRINT(CUST.DATA.remitAmt)
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "Remittance Amount Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF
ELSE
	CUST.DATA.errFlg = "Y"
	CUST.DATA.errMsg = "Remittance Amount Not Entered"
	GOTO ENDOFSCRIPT
ENDIF



IF(FIELDEXISTS(BANCS.INPUT.POType))THEN
	IF(BANCS.INPUT.POType !="")THEN
		CUST.DATA.paysysId = TOUPPER(TRIM(BANCS.INPUT.POType))
		PRINT(CUST.DATA.paysysId)
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.errMsg = "PAYSYSID Not Entered"
		GOTO ENDOFSCRIPT
	ENDIF
ELSE
	CUST.DATA.errFlg = "Y"
	CUST.DATA.errMsg = "PAYSYSIDt Not Entered"
	GOTO ENDOFSCRIPT
ENDIF

#IF ((CUST.DATA.remitCrncy == "ZAR") OR (CUST.DATA.remitCrncy == "JPY")) THEN
#        IF(BANCS.INPUT.POType != "SWIFT")THEN
#                CUST.DATA.errFlg = "Y"
#                CUST.DATA.errMsg = "For Remittance Currency "+CUST.DATA.remitCrncy+" Payment Method should be SWIFT"
#                GOTO ENDOFSCRIPT
#        ELSE
#                CUST.DATA.errFlg = "N"
#                CUST.DATA.errMsg = " "
#                IF ((CUST.DATA.remitCrncy != "ZAR") AND (CUST.DATA.remitCrncy != "JPY")) THEN
#                        GOTO ENDOFSCRIPT
#                ENDIF
#        ENDIF
#ENDIF
		

############Fecthinh scheme codes from CPARAM ###########################
sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.DrAcct)
PRINT(sv_u)

IF(sv_u == 0)THEN
	CUST.DATA.avblAmt = BANCS.OUTPARAM.EffAvailableAmt
	CUST.DATA.custId = BANCS.OUTPARAM.custId
	print(CUST.DATA.custId)
ELSE
	CUST.DATA.custId=""
ENDIF

sv_s =""
sv_s = sv_s + " CORP_ID | select corp_id from tbaadm.cmg where  bank_id='"+BANCS.STDIN.contextBankId+"' and cust_id='"+CUST.DATA.custId+"' and rownum=1"
print(sv_s)
sv_u = urhk_dbselectwithBind(sv_s)
print(sv_u)
IF (sv_u == 0) THEN
	BANCS.INPUT.CORP_ID=BANCS.OUTPARAM.CORP_ID
	IF (BANCS.INPUT.CORP_ID != "") THEN
		BANCS.INPUT.RETCORP="CORP"
	ELSE
		BANCS.INPUT.RETCORP="RET"
	ENDIF
ELSE
	BANCS.INPUT.RETCORP="NIL"
ENDIF

CUST.DATA.corpret=BANCS.INPUT.RETCORP
print(CUST.DATA.corpret)


IF(CUST.DATA.corpret =="NIL") THEN
	CUST.DATA.eventid="BCDC_OFFICE_ACCT"
ENDIF

#convert amount to USD

IF(BANCS.INPUT.RemitCrncyCode !="USD") THEN
	BANCS.INPARAM.InputAmount = BANCS.INPUT.RemitAmt
	BANCS.INPARAM.FromCurrency = BANCS.INPUT.RemitCrncyCode
	BANCS.INPARAM.ToCurrency = "USD"
	BANCS.INPARAM.RateCode = "TTB"
	BANCS.INPARAM.Rate=0
	sv_r = urhk_B2k_ConvertAmount("")
	CUST.DATA.ConvAmount =CDOUBLE(BANCS.OUTPARAM.OutputAmount)
ELSE
	CUST.DATA.ConvAmount =BANCS.INPUT.RemitAmt
ENDIF



IF(BANCS.INPUT.RemitCrncyCode !="CDF") THEN
	BANCS.INPARAM.InputAmount = BANCS.INPUT.RemitAmt
	BANCS.INPARAM.FromCurrency = BANCS.INPUT.RemitCrncyCode
	BANCS.INPARAM.ToCurrency = "CDF"
	BANCS.INPARAM.RateCode = "TTB"
	BANCS.INPARAM.Rate=0
	sv_r = urhk_B2k_ConvertAmount("")
	CUST.DATA.ConvCDFAmount =CDOUBLE(BANCS.OUTPARAM.OutputAmount)
ELSE
	CUST.DATA.ConvCDFAmount =BANCS.INPUT.RemitAmt
ENDIF

print(CUST.DATA.ConvAmount)
	


IF (BANCS.INPUT.POType=="SWIFT") THEN

	IF(BANCS.INPUT.CountryCode=="CD") THEN
		
		IF (CUST.DATA.DccId =="ERP") THEN
			CUST.DATA.eventid="BCDC_OFFICE_ACCT" 
		ELSE
			CUST.DATA.eventid="POLSWIFTBC"
		ENDIF
	ELSE		
		IF (CUST.DATA.DccId =="ERP") THEN
			CUST.DATA.eventid="SWIFT_OFFICE_ACCT" 
		ELSE
			CUST.DATA.eventid="POLSWIFT"
		ENDIF
	ENDIF
ELSE		
	IF ((CUST.DATA.DccId =="POL") OR (CUST.DATA.DccId =="H2H")) THEN			
		CUST.DATA.eventid="POLRTGS"	
	ELSE
		CUST.DATA.eventid="ERTGS"
	ENDIF

	IF (CUST.DATA.DccId =="ERP") THEN
		CUST.DATA.eventid="RTGS_OFFICE_ACCT" 
	ENDIF
ENDIF


# Start check for charge account INC0033115

BANCS.INPUT.Custchargeacct = ""
BANCS.INPUT.BODDATE=mid$(BANCS.STDIN.BODDate,0,10)
BANCS.INPUT.foracid = BANCS.INPUT.DrAcct
IF(BANCS.INPUT.Custchargeacct =="") then
                sv_s =" Custchargeacct|select chrg_acct_no from custom.C_HCUSTCRG_MAIN where foracid ='"+ BANCS.INPUT.foracid +"'  "
                sv_s = sv_s + " and EVENT_TYPE ='FBCH' and  EVENT_ID = '"+ CUST.DATA.eventid +"'    "
		sv_s = sv_s + " and start_date  < = to_date('"+BANCS.INPUT.BODDATE+"','DD-MM-YYYY') "
                sv_s = sv_s + " and end_date  > = to_date('"+BANCS.INPUT.BODDATE+"','DD-MM-YYYY') "
                sv_s = sv_s + " and entity_cre_flg='Y' and del_flg='N' and rownum=1"
                print(sv_s)
                sv_u = urhk_dbselectwithBind(sv_s)
                print(sv_u)
                        IF (sv_u == 0) THEN
                                BANCS.INPUT.Custchargeacct=BANCS.OUTPARAM.Custchargeacct
                        ELSE
                                BANCS.INPUT.Custchargeacct=""
                        ENDIF
                print(BANCS.INPUT.Custchargeacct)
ENDIF
IF(BANCS.INPUT.Custchargeacct=="") then
                sv_s ="Custchargeacct| select chrg_acct_no from custom.C_HCUSTCRG_MAIN where cust_id = (select cif_id from tbaadm.gam where foracid ='"+ BANCS.INPUT.foracid +"') "
                sv_s = sv_s + " and  EVENT_TYPE ='FBCH' and  EVENT_ID = '"+ CUST.DATA.eventid +"'    "
		sv_s = sv_s + " and  start_date  < = to_date('"+BANCS.INPUT.BODDATE+"','DD-MM-YYYY')"
                sv_s = sv_s + " and  end_date  > = to_date('"+BANCS.INPUT.BODDATE+"','DD-MM-YYYY')"
                sv_s = sv_s + " and entity_cre_flg='Y' and del_flg='N' and rownum=1"
                print(sv_s)
                sv_u = urhk_dbselectwithBind(sv_s)
                print(sv_u)
                        IF (sv_u == 0) THEN
                                BANCS.INPUT.Custchargeacct=BANCS.OUTPARAM.Custchargeacct
                        ELSE
                                BANCS.INPUT.Custchargeacct=""
                        ENDIF

                print(BANCS.INPUT.Custchargeacct)
ENDIF
IF(BANCS.INPUT.Custchargeacct=="") then
                sv_s ="Custchargeacct| select chrg_acct_no from custom.C_HCUSTCRG_MAIN where AGREEMENT =(select EMPLOYERID from CRMUSER.DEMOGRAPHIC where "
		sv_s = sv_s + " orgkey =(select cif_id from tbaadm.gam where foracid ='"+ BANCS.INPUT.foracid +"')) "
                sv_s = sv_s + " and  EVENT_TYPE ='FBCH' and  EVENT_ID = '"+ CUST.DATA.eventid +"'    "
		sv_s = sv_s + " and  start_date  < = to_date('"+BANCS.INPUT.BODDATE+"','DD-MM-YYYY')"
                sv_s = sv_s + " and  end_date  > = to_date('"+BANCS.INPUT.BODDATE+"','DD-MM-YYYY')"
                sv_s = sv_s + " and entity_cre_flg='Y' and del_flg='N' and rownum=1"
                print(sv_s)
                sv_u = urhk_dbselectwithBind(sv_s)
                print(sv_u)
                        IF (sv_u == 0) THEN
                                BANCS.INPUT.Custchargeacct=BANCS.OUTPARAM.Custchargeacct
                        ELSE
                                BANCS.INPUT.Custchargeacct=""
                        ENDIF

                print(BANCS.INPUT.Custchargeacct)
ENDIF
IF (BANCS.INPUT.Custchargeacct != "") Then
	CUST.DATA.ChrgAcct = BANCS.INPUT.Custchargeacct
ENDIF

# END check for charge account INC0033115

print(CUST.DATA.eventid)

ENDOFSCRIPT:
