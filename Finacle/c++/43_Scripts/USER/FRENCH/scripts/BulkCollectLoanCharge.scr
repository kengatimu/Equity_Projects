	CUST.GCHRG.tranSubType = "BI"
	CUST.GCHRG.drAcctId = CUST.GCHRG.CrForacid
	CUST.GCHRG.acctCrncyCode = "USD"
	CUST.GCHRG.chrgAmt = CUST.GCHRG.chrgAmt
	print(CUST.GCHRG.chrgAmt)
