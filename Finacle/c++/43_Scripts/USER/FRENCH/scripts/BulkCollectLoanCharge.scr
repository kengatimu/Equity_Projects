print(CUST.LADIS.Foracid)

BANCS.INPARAM.BINDVARS = CUST.GCHRG.entityId + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)
sv_a = "chrgAmtForacid|SELECT FREE_TEXT_3 FROM TBAADM.gac WHERE acid= ?SVAR AND BANK_ID= ?SVAR "
print(sv_a)
sv_b = urhk_dbSelectWithBind(sv_a)
IF (sv_b == 0) THEN
#{
	CUST.GCHRG.chrgAmtForacid = BANCS.OUTPARAM.chrgAmtForacid
	print(CUST.GCHRG.chrgAmtForacid)
	CUST.GCHRG.acctCrncyCodefx = "USD"
