<--START
CHECKSUM="d24e95e7718342acf32e641bbe97e61719499adbb752d202783f4d1a042b52e8"
	TRACE ON
	LIBNAME CUSTOMSO
	sv_u=urhk_B2k_PrintRepos("BANCS")
	print(sv_u)
	
	#-----------------------------------------------------------------
	# Creating Repository and classes
	#-----------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CATOD") == 0) THEN
	#{
		CREATECLASS("CUST","CATOD",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------
	# Initialiizing required variables
	#-----------------------------------------------------------------
	CUST.CATOD.selectedRec = ""
	CUST.CATOD.Function = ""
	CUST.CATOD.errColl =""
	CUST.CATOD.errMsg = ""
	#-----------------------------------------------------------------
	# Getting Input Parameters
	#-----------------------------------------------------------------
	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		CUST.CATOD.fileName = MTT.InputDetails.Argument1
		print(CUST.CATOD.fileName)
		CUST.CATOD.functionCode = MTT.InputDetails.Argument2
		print(CUST.CATOD.functionCode)
		#}
	ELSE
		#{
		sv_u = urhk_MTTS_Close("")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	CUST.CATOD.Function = CUST.CATOD.functionCode
	print(CUST.CATOD.Function)
	CUST.CATOD.FName = CUST.CATOD.fileName
	print(CUST.CATOD.FName)
	
		sv_l = STRLEN(CUST.CATOD.FName)
		print(sv_l)
		sv_p = GETPOSITION(CUST.CATOD.FName, ".")
		print(sv_p)
		sv_a = LEFT$(CUST.CATOD.FName, sv_p - 1)
		print(sv_a)
		CUST.CATOD.FName = TOUPPER(sv_a)
		Print (CUST.CATOD.FName)
	


		IF (CUST.CATOD.FName == "MASSACCT") then	
			call("MassAcctUpld.scr")
		ENDIF
		IF (CUST.CATOD.FName == "POLARIS") then	
			call("PolarisUpld.scr")
		ENDIF
	EXITSCRIPT
