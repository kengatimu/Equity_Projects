MTT.TranDetails.PrintAdviceInd="B"
MTT.TranDetails.TranIdOnline="Y"
MTT.TranDetails.sysTranCode="LOANAA003"

sv_z = urhk_MTTS_DefineTransaction("revChargeOff")

###############################################################################
# Get all the amounts into local variables . Please do not set these variables
# anywhere else in this script. The variables are : -
# sv_l = pending principal
# sv_p = pending interest
# sv_g = pending penal interest
# sv_o = pending interest book Amount.
# sv_h = pending penal interest book Amount.
# sv_r = recovered principal Amount.
# sv_v = provision amount
###############################################################################	
	sv_c = MTT.InputDetails.intRouteFlg
	sv_l = CDOUBLE(MTT.InputDetails.prinTranAmt)
	sv_d = MTT.InputDetails.nonPastDueFlg
	sv_p = CDOUBLE(MTT.InputDetails.intTranAmt)
	sv_g = CDOUBLE(MTT.InputDetails.penalIntTranAmt)
	sv_o = CDOUBLE(MTT.InputDetails.bookTranAmt)
	sv_h = CDOUBLE(MTT.InputDetails.penalBookTranAmt) 
	sv_r = CDOUBLE(MTT.InputDetails.revTranAmt)
        sv_v = CDOUBLE(MTT.InputDetails.provisionAmt)
        sv_n = CDOUBLE(MTT.InputDetails.intSuspAmt)
        sv_e = CDOUBLE(MTT.InputDetails.penalIntSuspAmt)
	sv_u = CDOUBLE(MTT.InputDetails.outUEIAmt)
	sv_i = MTT.InputDetails.islamicProductTypeFlg
	sv_w = MTT.InputDetails.unearnedIncAppFlg
	sv_j = MTT.InputDetails.chargeoffFlg

#unearned income is added in pending interest in actap107. Hence subtracting it here
sv_p = sv_p - sv_u
sv_p = sv_p - sv_g 
sv_o = sv_o - sv_h 

###############################################################################
# Credit Suspense account or credit P&L/Penal P&L account
###############################################################################
#print (MTT.InputDetails.intSuspAcct)
#sv_d will be Y when a past due account is being chrged off. Else it will be N
	if (sv_d == "Y") then
		if (sv_o !=0 OR sv_p !=0 ) then 
			MTT.PartTranDetails.Account=MTT.InputDetails.intSuspAcct
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDateDiff
			MTT.PartTranDetails.RefAmount=(sv_p + sv_o)
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode = MTT.InputDetails.rateCode
			#new code start
			IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
			#{
				sv_s = "intRateCode|SELECT ds_rate_code "
				sv_s = sv_s + "FROM tbaadm.LAM "
				sv_s = sv_s + "WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR) "
				sv_s = sv_s + "AND LAM.bank_id = ?SVAR "
				BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
