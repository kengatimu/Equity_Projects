			MTT.LAAddnlDetails.OriginOfTran = "REVCH"
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
			MTT.PartTranDetails.EntryUserId="SYSTEM"
			MTT.PartTranDetails.EntryTime=BANCS.STDIN.BODDate
			MTT.PartTranDetails.sysPartTranCode ="PTRN01164"		
			sv_z = urhk_MTTS_DefinePartTran("interest")
		endif
	endif 

###############################################################################
# Credit Penal Suspense account or credit P&L/Penal P&L account
###############################################################################
