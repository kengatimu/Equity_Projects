					print(sv_t)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		
		CUST.ATM.eventId="TODCEVT"
		print(CUST.ATM.eventId)
		CUST.ATM.eventType="GCHRG"
		print(CUST.ATM.eventType)
		
		
		print(CUST.ATM.eventId)
		print(CUST.ATM.eventType)
		print(BANCS.OUTPUT.acctCrncyCode)
		
		CUST.CONTRACT.contractAmt=CUST.ATM.contractAmt
		print(CUST.CONTRACT.contractAmt )
		CUST.CONTRACT.acctNum=CUST.ATM.acctNo
		print(CUST.CONTRACT.acctNum)
		CUST.CONTRACT.crncyCode=BANCS.OUTPUT.acctCrncyCode
		print(CUST.CONTRACT.crncyCode)
		
		call ("copyBancsToCustC24.scr")
		
		MTT.ChargeDetails.EventId = CUST.ATM.eventId
		MTT.ChargeDetails.EventType = CUST.ATM.eventType
		MTT.ChargeDetails.ChrgInpCrncy = BANCS.STDIN.homeCrncyCode
		
		sv_y = "MiniCharges"
		sv_u = urhk_MTTS_InitPtt(sv_y)
		print(sv_u)
		IF(sv_u != 0 ) THEN
		#{
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			BANCS.OUTPUT.scriptError = "urhk_MTTS_InitPtt returns FAILURE"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_u = urhk_MTTS_GetPttRec(sv_y)
		print(sv_u)
		IF(sv_u == 0 ) THEN
		#{
			CUST.ATM.crForacid = MTT.PartTranDetails.Account
			CUST.ATM.RefCurrency = MTT.ChargeDetails.CollectionCrncy
			CUST.ATM.RefAmount = CDOUBLE(MTT.PartTranDetails.RefAmount)
			sv_b = CDOUBLE(MTT.PartTranDetails.RefAmount)
			print(MTT.PartTranDetails.Account)
			print(MTT.ChargeDetails.CollectionCrncy)
			print(MTT.PartTranDetails.RefAmount)
			
			sv_e = CDOUBLE(BANCS.OUTPUT.EffAvailableAmt)
			print(sv_e)
		#}
		ENDIF
		
		#call ("copyCust24ToBancs.scr")
		
		sv_a = urhk_MTTS_Close("")
		print(sv_a)
		
		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "N"
		BANCS.INPARAM.CommitFlg="Y"
		BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw="Y"
		BANCS.INPARAM.CheckExceptions="N"
		
		sv_u = urhk_MTTS_Initialize("")
