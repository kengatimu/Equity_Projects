<--START
TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
        	CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
        	CREATECLASS ("CUST","DATA",5)
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","RATE") == 0) THEN
	#{
        	CREATECLASS ("CUST","RATE",5)
	#}
	ENDIF

        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.flg = "N"
        CUST.DATA.remitAmt = "0"
        CUST.DATA.convertedAmt = "0"
        CUST.DATA.limitAmt = "0"

        IF(FIELDEXISTS(BANCS.INPUT.remitAmt))THEN
        #{
                IF(BANCS.INPUT.remitAmt !="")THEN
                #{
                        CUST.DATA.remitAmt = TOUPPER(TRIM(BANCS.INPUT.remitAmt))
                        PRINT(CUST.DATA.remitAmt)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.convertedAmt))THEN
        #{
                IF(BANCS.INPUT.convertedAmt !="")THEN
                #{
                        CUST.DATA.convertedAmt = TOUPPER(TRIM(BANCS.INPUT.convertedAmt))
                        PRINT(CUST.DATA.convertedAmt)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        CUST.DATA.parameterId = "REMIT_LIMIT"
        CUST.DATA.moduleName = "OT"

        PRINT(BANCS.STDIN.contextBankId)
        PRINT(CUST.DATA.moduleName)
        PRINT(CUST.DATA.parameterId)

        sv_a = ""

        sv_a = sv_a + "paramVal|select parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER "
        sv_a = sv_a + " WHERE C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
        sv_a = sv_a + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
        sv_a = sv_a + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
        sv_a = sv_a + " C_CPVALUE.del_flg != 'Y' AND "
        sv_a = sv_a + " C_CPVALUE.entity_cre_flg = 'Y' AND "
        sv_a = sv_a + " C_CPMASTER.bank_id = ?SVAR AND "
        sv_a = sv_a + " C_CPMASTER.module_name = ?SVAR AND "
        sv_a = sv_a + " C_CPVALUE.parameter_id = ?SVAR "

        PRINT(sv_a)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.moduleName + "|" + CUST.DATA.parameterId

        sv_d = urhk_dbSelectWithBind(sv_a)
        PRINT(sv_a)
        PRINT(sv_d)

        IF(sv_d == 0) THEN
        #{
                PRINT(BANCS.OUTPARAM.paramVal)
                CUST.DATA.limitAmt = BANCS.OUTPARAM.paramVal
        #}
        ELSE
        #{
		CUST.DATA.errflg = "N"
                CUST.DATA.errMsg = "CPARAM set up not available for REMITT_LIMIT"
		GOTO ENDOFSCRIPT
	#}
        ENDIF


	IF(CDOUBLE(CUST.DATA.limitAmt) > CDOUBLE(CUST.DATA.remitAmt))THEN
	#{
		CUST.DATA.flg = "Y"
                GOTO ENDOFSCRIPT
        #}
        ENDIF


ENDOFSCRIPT:
        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
        sv_u = urhk_SetOrbOut("flg|"+CUST.DATA.flg)
TRACE OFF
END-->
