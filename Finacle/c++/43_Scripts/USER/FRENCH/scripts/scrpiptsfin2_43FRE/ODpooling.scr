			IF(sv_u != 0) THEN
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF

			sv_g = BANCS.OUTPARAM.srvValue
			PRINT(sv_g)

			IF(sv_g == CUST.ODACT.DrActNum)THEN
			#{
				sv_o=sv_b
				PRINT(sv_o)
			#}
			ENDIF
			
			IF(sv_g == CUST.ODACT.foracid)THEN
			#{
				sv_t=sv_b
				PRINT(sv_t)
			#}
			ENDIF

			NEXTFETCH:

			sv_b = sv_b + 1
		
		#}
		DO
		sv_u = urhk_CopyOutToIn("")
		PRINT(sv_u)
		
		sv_a = urhk_SetUrhkOut("poolInfo.pool.id|id")
		PRINT(sv_a)
		
		sv_b = 0
		WHILE(sv_b < sv_j)
		#{
			sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_b, "%d") + ">.allowSweeps|N")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_b, "%d") + ">.delFlg|Y")
			PRINT(sv_u)
			
			sv_b = sv_b + 1
		
		#}
		DO
		
		sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_o, "%d") + ">.allowSweeps|Y")
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_o, "%d") + ">.delFlg|N")
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_t, "%d") + ">.allowSweeps|Y")
		PRINT(sv_u)
		sv_u = urhk_SetUrhkInp("poolLL.<rec_" + FORMAT$(sv_t, "%d") + ">.delFlg|N")
		PRINT(sv_u)

		sv_u = urhk_ExecSrvNoCommit("SRV_CreatePoolAndVerify|same_user_verify = Y|retain_all_output = Y")		
		PRINT(sv_u)
		
		IF (sv_u != 0) THEN
		#{

			IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				PRINT(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
			#}
			ELSE
			#{
				sv_v = 0
			#}
			ENDIF
			IF (sv_v > 0) THEN
			#{
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					PRINT(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					PRINT(sv_e)
					sv_i = sv_i + 1
				#}
				DO
			#}
			ENDIF
			
			##Calling script to Freeze the account
			CALL("ODfreeze.scr")	

		#}
		ELSE
		#{
			PRINT(BANCS.OUTPARAM.id)
			CUST.ODACT.id = BANCS.OUTPARAM.id	
		#}
		ENDIF

	#}
	ELSE
	#{
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			PRINT(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
		#}
		ELSE
		#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				PRINT(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				PRINT(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
	#}
	ENDIF

TRACE OFF
END-->
