<--START
TRACE ON
	CUST.ODACT.id = ""
   
    sv_a=urhk_SetUrhkInp("poolInfo.pool.ptype|S")
    PRINT(sv_a)
    sv_a=urhk_SetUrhkInp("poolInfo.pool.reglflag|Y")
    PRINT(sv_a)
    sv_a=urhk_SetUrhkInp("poolInfo.poolDesc|ODACNTPOOL")
    PRINT(sv_a)
    sv_a=urhk_SetUrhkInp("poolInfo.acct.foracid|"+CUST.ODACT.foracid)
    PRINT(sv_a)
    sv_u = urhk_ExecSrvNoCommit("SRV_FetchPoolForCreate|same_user_verify = Y|retain_all_output = Y")	
    print(sv_u)

    IF (sv_u == 0 ) THEN
    #{	
		sv_u = urhk_GetUrhkNum("poolLL")
