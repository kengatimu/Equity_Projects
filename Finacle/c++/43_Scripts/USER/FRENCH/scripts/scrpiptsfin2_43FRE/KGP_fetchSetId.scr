<--START
TRACE ON
	
	#-----------------------------------------
	#  Create the required repository Classes
	#------------------------------------------
	
                IF(REPEXISTS("CUST") == 0) THEN
                #{
                        CREATEREP("CUST")
                #}
                ENDIF

                IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
                #{
                        CREATECLASS("CUST", "DATA", 5)
                #}
                ENDIF

	#--------------------------------
	# Fetching input values
	#-------------------------------

		IF(FIELDEXISTS(BANCS.INPUT.foracid)) THEN
		#{
			CUST.DATA.foracid = BANCS.INPUT.foracid
			PRINT(CUST.DATA.foracid)
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.acctNum)) THEN
		#{
			CUST.DATA.foracid = BANCS.INPUT.acctNum
			PRINT(CUST.DATA.foracid)
		#}
		ENDIF
	
	#--------------------------------
	# Intialization of Local Fields
	#-------------------------------
	
		CUST.DATA.bcdcCnt	= "0"
		CUST.DATA.bcdcFlg	= "N"
	
	#---------------------------------------------
	#	Fetching Event details from PTT table
	#---------------------------------------------

		lv_q = "bcdcCnt|SELECT COUNT(1) FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR AND "
		lv_q = lv_q + " EXISTS (SELECT 1 FROM TBAADM.SST WHERE SOL_ID = GAM.SOL_ID "
		lv_q = lv_q + " AND SET_ID = 'BCDC' AND BANK_ID = ?SVAR)"
		PRINT(lv_q)

		BANCS.INPARAM.BINDVARS = CUST.DATA.foracid +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		lv_u = urhk_dbSelectWithBind(lv_q)
		PRINT(lv_u)

		IF(lv_u == "0") THEN
		#{
			CUST.DATA.bcdcCnt	 = BANCS.OUTPARAM.bcdcCnt
			PRINT(CUST.DATA.bcdcCnt)

			IF(CINT(CUST.DATA.bcdcCnt) > 0) THEN
			#{
				CUST.DATA.bcdcFlg = "Y"
			#}
			ENDIF
		#}
		ENDIF

                IF(CUST.DATA.foracid == "") THEN
                #{
                       CUST.DATA.bcdcFlg = "Y"
                #}
                ENDIF

	#---------------------------------------------
	#	Sending values back to mrt
	#---------------------------------------------
	
		BANCS.OUTPUT.bcdcFlg      = CUST.DATA.bcdcFlg
END-->
