		#}
	ELSE
		#{
		print("Bacid not maintained in CPARAM!")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(TRIM(EQT.ODP.bacid) == "")THEN
	#{
		print("Bacid not maintained in CPARAM!")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###########################################
	#      	Getting Foracid from BACID        #
	###########################################
	
	sv_b = EQT.ODP.bacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
	print(sv_b)
	
	sv_b = urhk_B2k_BacidToAcctId(sv_b)
	print(sv_b)
	
	IF(sv_b == 1)THEN
	#{
		print("No Account Found for the given Bacid, Currency Code and Sol Id!")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
