	EQT.ODP.pnlCrAcct = BANCS.OUTPARAM.AcctId
	
	sv_r = urhk_getAcctDetailsInRepository(EQT.ODP.pnlCrAcct)
	print(sv_r)
	
	IF(sv_r != 0)THEN
	#{
		print("Error in Getting Account Details!")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	print(BANCS.OUTPARAM.acctCloseflg)
	print(BANCS.OUTPARAM.freezeCode)
	print(BANCS.OUTPARAM.entityCreFlag)
	
	IF(BANCS.OUTPARAM.entityCreFlag != "Y")THEN
	#{
		print("Account Creation is not yet Authorized.")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(BANCS.OUTPARAM.acctCloseflg == "Y")THEN
	#{
		print("Account Closed!")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF((BANCS.OUTPARAM.freezeCode == "C") OR (BANCS.OUTPARAM.freezeCode == "T"))THEN
	#{
		print("Account Frozen!")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###########################################
	#             Opening Cursor              #
	###########################################
	
	sv_s = "foracid, acid, acctCrncy, pnlAccrAmt, pnlApplAmt, pnlOutstdngAmt|select foracid, acid, ACCT_CCY_CODE, nvl(PENAL_ACCRUED_AMOUNT_DR,0), nvl(PENAL_APPLIED_AMOUNT_DR, 0 ),  nvl(PENAL_ACCRUED_AMOUNT_DR, 0) - nvl(PENAL_APPLIED_AMOUNT_DR, 0) "
	sv_s = sv_s + " from custom.c_pnat where bank_id = ?SVAR and sol_id = ?SVAR and nvl(PENAL_APPL_UP_TO_DATE_DR, TO_DATE('11-06-1900', 'DD-MM-YYYY') ) <  TO_DATE(?SVAR, 'DD-MM-YYYY') and PENAL_ACCRUED_AMOUNT_DR - nvl(PENAL_APPLIED_AMOUNT_DR, 0) > 0"
	
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + MID$(BANCS.STDIN.BODDate,0,10)
	print(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_r)
	
	IF(sv_r == 0) THEN
