<--START
CHECKSUM="96f18fea1c68dce2c11c7eaac066df55f89cf954905586781db3210849da487b"
	# Script body goes here
	TRACE ON
	
	###########################################
	#      Creating Repository and Class      #
	###########################################
	
	sv_a = REPEXISTS("EQT")
	IF (sv_a == 0) THEN
	#{
		CREATEREP("EQT")
	#}
	ENDIF
	
	sv_a = CLASSEXISTS("EQT", "ODP")
	IF (sv_a == 0 ) THEN
	#{
		CREATECLASS("EQT", "ODP", 5)
	#}
	ENDIF
	
	EQT.ODP.mttTranId = ""
	EQT.ODP.rateCode = ""
	
	###########################################
	#        Getting BACID From CPARAM        #
	###########################################
	
	sv_b = "bacid|select CUSTOM.getCparamValue('OD_PENALTY_BACID','OT',?SVAR)  from dual "
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	
	sv_b = urhk_dbSelectWithBind(sv_b)
	
	IF(sv_b == 0) THEN
	#{
		EQT.ODP.bacid = BANCS.OUTPARAM.bacid
