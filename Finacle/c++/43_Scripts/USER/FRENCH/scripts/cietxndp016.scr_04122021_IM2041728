		CUST.INTERFACE.nextPartTran = CINT(CUST.INTERFACE.nextPartTran)+1
		print(CUST.INTERFACE.nextPartTran)
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SerialNum>" + CUST.INTERFACE.nextPartTran +"</SerialNum>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PartTrnRec>"
	#}
	ENDIF
	## END OF LOGIC ##
	
	SKIP_DMG_PART_TRAN:
		
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</XferTrnDetail>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</XferTrnAddRq>"
		
