		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<amountValue>" + CUST.INTERFACE.vatAmt + "</amountValue>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<currencyCode>" + CUST.INTERFACE.tranCcyCr + "</currencyCode>"
