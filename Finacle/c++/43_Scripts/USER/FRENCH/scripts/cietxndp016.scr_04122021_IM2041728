		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PartTrnRmks>" + sv_f + "</PartTrnRmks>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<ValueDt>"+ CUST.INTERFACE.crValueDate + "</ValueDt>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Rate>" + CUST.CIETXN.dmgRate + "</Rate>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RateCode>" + CUST.CIETXN.dmgRateCode + "</RateCode>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<SerialNum>" + CUST.INTERFACE.nextPartTran +"</SerialNum>"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PartTrnRec>"
	#}
	ENDIF
	IF(CUST.INTERFACE.vatAmt!="0")THEN
	#{
		sv_f = "VAT on Damaged Notes"
		CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PartTrnRec>"
