#		MTT.InputDetails.LoanPaymentAccount		Loan Payment account
#		MTT.InputDetails.LoanInterestAccount	Loan Interest Account
#		MTT.InputDetails.IntSuspenceAccount 	Interest Suspence Account
#		MTT.InputDetails.ExcessCreditAccount 	Excess Credit Account
#		MTT.InputDetails.SourceDebitAccount 	Source Debit Account
#		MTT.InputDetails.OAPTranId 				Tran Id (valid in case the SourceDebitAccount is of
#												OAP schme type only)
#		MTT.InputDetails.OAPTranDate 			Tran Date (valid in case the SourceDebitAccount is 
#												of OAP schme type only)
#		MTT.InputDetails.OAPPTranSrlNum			Part Tran Serial Number (valid in case the 
#												SourceDebitAccount is of OAP schme type only)
#		MTT.InputDetails.LoanAccountCrncyCode	Loan Account Currency Code   
#		MTT.InputDetails.CifId					Loan Account Customer CIF Id
#		MTT.InputDetails.NonBookingModeFlg      Past Due Flag
#		MTT.InputDetails.PrinDmdAdj				Principal Demand To be satisfied 
#		MTT.InputDetails.IntDmdAdj				Interest demand to be satisfied 
#		MTT.InputDetails.BankChrgDmdAdj			Bank Charges to be satisfied
#		MTT.InputDetails.OtherChrgDmdAdj		Other charges to be satisfied 
#		MTT.InputDetails.FeeAdj					Fees(excluding Pre-Payment Fee) to be satisfied 
#		MTT.InputDetails.PrePaymentFeeAdj		Pre-Payment Fee to be satisfied    
#		MTT.InputDetails.ExcessCreditAmount		Excess Amount available after satisfying demands.  
#		MTT.InputDetails.CreditAmt				Total Credit Amount available for satisfaction
#		MTT.InputDetails.SourceAcctTranAmt		Amount to be Debited from Source Account
#		MTT.InputDetails.LoanAcctTranAmt		Amount to be Credited to Loan Account
#		MTT.InputDetails.LoanInterestAcctTranAmtAmount to be Credited to Loan Interest Account
#		MTT.InputDetails.LoanPaymentAcctTranAmt	Amount to be Credited to Loan Payment Account  
#		MTT.InputDetails.ExcessCrAcctTranAmt	Amount to be Credited to Excess Credit Account  
#		MTT.InputDetails.ExcessCrToLAPayAcctFlg	Flag indicating whether Excess Credit should be 
#												Credited to Loan Payment Account or not 
#		MTT.InputDetails.ReferenceNumber		Reference Number 
#		MTT.InputDetails.TranRemarks			Transaction Remarks
#		MTT.InputDetails.ValueDate				Value Date of transaction
#		MTT.InputDetails.IntRouteFlg			Flag indicating whether Interest is routed through 
#												Loan Account("L") or Loan Interest Account("O")
#		MTT.InputDetails.ChrgRouteFlg			Flag indicating whether Charge is routed through
#												Loan Account("L") or Loan Interest Account("O")
#		MTT.InputDetails.DefaultCollecFlowId	Default collection Flow-Id
#		MTT.InputDetails.FuncCode				Function Code of LAPAY menu


#-----------------------------------------------------------
# The Script starts here 							
#-----------------------------------------------------------

<--start
trace on

sv_r = CDOUBLE("0")      
sv_r = urhk_MTTS_PopulateInputDetails("")
sv_u = urhk_b2k_printrepos("BANCS")
if(sv_r == 1) then
	exitscript	
endif

sv_r = urhk_B2k_printRepos("MTT")
#print(MTT.InputDetails.CreditAmt)

MTT.TranDetails.TranDate="0"


MTT.TranDetails.TranType=MTT.InputDetails.tranType
if (MTT.InputDetails.tranType == "C" ) then 
	if (MTT.InputDetails.FuncCode != "R") then 
		MTT.TranDetails.TranSubType = "CR" 
	else 
	   MTT.TranDetails.TranSubType = "CP"
	endif
else 
MTT.TranDetails.TranSubType="BI"							
endif 
#MSG0008815 = "Loan Recovery"
sv_c = urhk_getMSGCodeErrDesc("MSG0008815")
if(sv_c == 0) then
    MTT.TranDetails.Remarks = BANCS.OUTPARAM.errDesc
    endif
MTT.TranDetails.IgnoreExcp="N"								
MTT.TranDetails.Consolidate="Y"						
MTT.TranDetails.PrintAdviceInd="Y"							
MTT.TranDetails.ReversalFlg="N"			
MTT.TranDetails.sysTranCode="LOANAA050"	
# newly added the tranId while verification
MTT.TranDetails.TranID = MTT.InputDetails.tranId 
#MTT.TranDetails.ReversalDate=MTT.InputDetails.reversalDate	

sv_r = urhk_MTTS_DefineTransaction("LoanRecovery")
if(sv_r == 1) then
	MTT.Error.Description="Transaction definition could not be created"
	sv_r = urhk_MTTS_ReportErrorCondition("")
	exitscript	
endif

sv_p = 0

while(sv_r < 1)
#{

	sv_h = CDOUBLE(MTT.InputDetails.PrinDmdAdj)
	sv_i = CDOUBLE(MTT.InputDetails.IntDmdAdj)
	sv_j = CDOUBLE(MTT.InputDetails.BankChrgDmdAdj)
	sv_k = CDOUBLE(MTT.InputDetails.OtherChrgDmdAdj)
	sv_l = CDOUBLE(MTT.InputDetails.FeeAdj)
	sv_m = CDOUBLE(MTT.InputDetails.PrePaymentFeeAdj)
	sv_n = CDOUBLE(MTT.InputDetails.ExcessCreditAmount)
	sv_o = CDOUBLE(MTT.InputDetails.CreditAmt)
	sv_p = CDOUBLE(MTT.InputDetails.SourceAcctTranAmt)
	sv_q = CDOUBLE(MTT.InputDetails.LoanAcctTranAmt)
	sv_s = CDOUBLE(MTT.InputDetails.LoanInterestAcctTranAmt)
	#sv_t = CDOUBLE(MTT.InputDetails.LoanPaymentAcctTranAmt)
	sv_u = CDOUBLE(MTT.InputDetails.ExcessCrAcctTranAmt)
	sv_b = CDOUBLE(MTT.InputDetails.WaivedAcctTranAmt)
    # Added for deferred interest
    sv_d = CDOUBLE(MTT.InputDetails.DefIntAdj)
    sv_e = CDOUBLE(MTT.InputDetails.DefIntAdj)
	if ((MTT.InputDetails.RevOriginOfTran == "LDS") AND (MTT.InputDetails.FuncCode == "R") AND (MTT.InputDetails.LoanAccountCrncyCode != MTT.InputDetails.DebitAcctCrncyCode )) then 
		sv_a = "1"  
	else 
		sv_a = "0"  
	endif


	if (MTT.InputDetails.FuncCode == "R") then 
		sv_t = CDOUBLE(MTT.InputDetails.RevFeeAdj)
	endif
	##################################

#----------------------------------------------------------------------------
# Debit the source account for the complete amount
#----------------------------------------------------------------------------

	

	sv_y = 0 
	sv_y=CDOUBLE(MTT.InputDetails.TodAmount)
   
  	# Changes made to populate value date as BOD DATE for office type of accounts
	IF (MTT.InputDetails.SourceDebitAccount != "") THEN 
	sv_u = "acctOwnership,acctOpnDate |select acct_ownership,to_char(acct_opn_date,'DD-MM-YYYY') from GAM" 
		sv_u = sv_u + " where foracid = '" + MTT.InputDetails.SourceDebitAccount +"'"
		sv_t = urhk_dbSelectWithBind(sv_u)

		if (sv_t == 0) then
			sv_v = BANCS.OUTPARAM.acctOwnership
	 		sv_w = urhk_B2k_getDateDiffFromBODDate(BANCS.OUTPARAM.acctOpnDate) 
	                sv_w = cint(BANCS.OUTPARAM.DateDiff) 
		endif 

	ENDIF

	# Checking for account ownership and if it is an OFFICE type of
	# accounts,comparing input value date with the account open date.
	# If value date is less than acct open date then putting BODDate in part tran value date
	if (sv_v == "O")  then
		# We should compare the difference of dates from BOD since input to 
                # script is the difference of date with BOD and not the date itself 
		if((MTT.InputDetails.ValueDate) >= (sv_w)) then
			MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate 
		endif
	else
		MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
	endif
    	
	MTT.PartTranDetails.Account = MTT.InputDetails.SourceDebitAccount 
	MTT.PartTranDetails.RefCurrency = MTT.InputDetails.DebitAcctCrncyCode
	    #MSG0309578 = "Loan Account Payments For : " + MTT.InputDetails.LoanAccount
    sv_c =urhk_getMSGCodeErrDesc("MSG0309578")
    if(sv_c == 0) then
        sv_f = BANCS.OUTPARAM.errDesc
    endif
    MTT.PartTranDetails.Particulars = sv_f + " " + MTT.InputDetails.LoanAccount	
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.RefAmount = -sv_p
	MTT.PartTranDetails.sysPartTranCode ="PTRN02589"
	#print(MTT.PartTranDetails.RefAmount)

	if (MTT.InputDetails.FuncCode == "R") then
	#{ 
		MTT.PartTranDetails.RefAmount = sv_p
	#print(MTT.PartTranDetails.RefAmount)
	    #MSG0309174 = "Loan Payment Reversal For : " + MTT.InputDetails.LoanAccount
	MTT.PartTranDetails.sysPartTranCode ="PTRN02590"
    sv_c =urhk_getMSGCodeErrDesc("MSG0309174")
    if(sv_c == 0) then
        sv_f = BANCS.OUTPARAM.errDesc
    endif
    MTT.PartTranDetails.Particulars = sv_f + " " + MTT.InputDetails.LoanAccount	
	#} 
	endif
		
	#--------------------------------------------
	# TOD Particulars are entered here
	#--------------------------------------------
	if (sv_y != 0) then
	#{
		MTT.PartTranDetails.TODRefType = MTT.InputDetails.TodRefType
		MTT.PartTranDetails.TodEntityType = MTT.InputDetails.TodEntityType
		MTT.PartTranDetails.TodAmount = sv_y
		MTT.PartTranDetails.TodLevIntFlg = MTT.InputDetails.TodLevIntFlg
		MTT.PartTranDetails.TodExpiryDate = MTT.InputDetails.TodExpiryDate
		MTT.PartTranDetails.TodPenalDate = MTT.InputDetails.TodPenalDate
		MTT.PartTranDetails.TodNrmlIntPcnt = MTT.InputDetails.TodNrmlIntPcnt
		MTT.PartTranDetails.TodPenalIntPcnt = MTT.InputDetails.TodPenalIntPcnt
		MTT.PartTranDetails.TodPermittedBy = MTT.InputDetails.TodPermittedBy
		MTT.PartTranDetails.TodRemarks = MTT.InputDetails.TodRemarks
	#}
	endif
		
	MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
	MTT.PartTranDetails.PartTranIdentifier = "SOURCE_DEBIT"
	MTT.PartTranDetails.PTranBusinessType = "RECOV"								
	MTT.PartTranDetails.ACPARTB2kId = MTT.InputDetails.LoanAccount
	MTT.PartTranDetails.ACPARTB2kType = "ACCNT"

	MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime 
	MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId 

	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LAPAY"
	sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	if (sv_z == 0) then
		call("getMTTTranPart.scr")
	endif
		
	#--------------------------------------------
    # Enter OAP Details if account is of OAP Type
    #--------------------------------------------		
	if(MTT.InputDetails.OAPSchmTypeFlg == "Y")then
	#{
		MTT.PartTranDetails.Refnum = MTT.InputDetails.OAPRefNum
		MTT.OAPAddnlDetails.OffsetAmount = sv_p
		#print(sv_p)
		MTT.OAPAddnlDetails.OrgTranID = MTT.InputDetails.OAPTranId
		MTT.OAPAddnlDetails.OrgTranDate = MTT.InputDetails.OAPTranDate 
		MTT.OAPAddnlDetails.OrgPartTran = MTT.InputDetails.OAPPTranSrlNum 
	#}
	endif
	
	MTT.PartTranDetails.svsTranId = MTT.InputDetails.svsTranId

	#------------------------------------------
	# Dump the instrument Details
	#-------------------------------------------
	if(MTT.InputDetails.tranType == "T") then
		if (MTT.InputDetails.FuncCode != "R") then
			MTT.PartTranDetails.InstrmntType = MTT.InputDetails.instrmntType

			if(MTT.InputDetails.instrmntDate !="") then
				BANCS.INPARAM.date1 = MID$(MTT.InputDetails.instrmntDate,0,10)
				BANCS.INPARAM.date2 = MID$(BANCS.STDIN.BODDate,0,10)
				sv_r = urhk_B2k_dateDiff("")
				MTT.PartTranDetails.InstrmntDate=BANCS.OUTPARAM.dateDiff
			endif	
	
			MTT.PartTranDetails.InstrmntNum = MTT.InputDetails.instrmntNum
			MTT.PartTranDetails.InstrmntAlpha = MTT.InputDetails.instrmntAlpha
		endif
	endif
	
PRINT(" Account=["+MTT.PartTranDetails.Account+"]RefCurrency["+MTT.PartTranDetails.RefCurrency+"]RefAmount=["+MTT.PartTranDetails.RefAmount)
	sv_r = urhk_MTTS_DefineLoanPartTran("SOURCE_DEBIT")

	if (sv_r == 1) then
		exitscript
	endif

	#-------------------------------------------------------------------
	#If loan account currency is different from  source account currency	
	#-------------------------------------------------------------------
	if (MTT.InputDetails.LoanAccountCrncyCode != MTT.InputDetails.DebitAcctCrncyCode) then 
	#{

		#--------------------------------------------
		# Loan Acct Xfer Parking Credit 					
		#--------------------------------------------
		MTT.PartTranDetails.Account = MTT.InputDetails.XferParkAcct 
		        #MSG0309578 = "Loan Account Payments For : " + MTT.InputDetails.LoanAccount
        sv_c =urhk_getMSGCodeErrDesc("MSG0309578")
        if(sv_c == 0) then
            sv_f = BANCS.OUTPARAM.errDesc
        endif
        MTT.PartTranDetails.Particulars = sv_f + " " + MTT.InputDetails.LoanAccount
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAPAY"
		sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_z == 0) then
			call("getMTTTranPart.scr")
		endif
	    MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate 	
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.DebitAcctCrncyCode
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.RefAmount = sv_p
		MTT.PartTranDetails.sysPartTranCode ="PTRN02591"
	
		#print(MTT.PartTranDetails.RefAmount)
		if (MTT.InputDetails.FuncCode == "R") then 
			MTT.PartTranDetails.RefAmount = -sv_p
			MTT.PartTranDetails.sysPartTranCode ="PTRN02592"			
		#print(MTT.PartTranDetails.RefAmount)
		endif

		if (sv_a == "1" ) then 
			MTT.PartTranDetails.Account = MTT.InputDetails.ConsolLoanParkAcct 
			MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAccountCrncyCode 
			MTT.PartTranDetails.RefAmount = -(sv_s + sv_q) + sv_t
		#print(MTT.PartTranDetails.RefAmount)
		endif

		MTT.PartTranDetails.RateCode=MTT.InputDetails.TranRateCode
		MTT.PartTranDetails.Rate=MTT.InputDetails.TranRate
		MTT.PartTranDetails.TreaRate = MTT.InputDetails.TranTreaRate
	    MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.TreaRefNum
		MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
		MTT.PartTranDetails.PartTranIdentifier = "SOURCE_DEBIT"
		MTT.PartTranDetails.PTranBusinessType = "RECOV"	
PRINT(" Account=["+MTT.PartTranDetails.Account+"]RefCurrency["+MTT.PartTranDetails.RefCurrency+"]RefAmount=["+MTT.PartTranDetails.RefAmount)
		sv_r = urhk_MTTS_DefineLoanPartTran("LA_PARK_CREDIT")
		if (sv_r == 1) then
			exitscript
		endif

		BANCS.INPARAM.InputAmount=sv_p
		BANCS.INPARAM.FromCurrency=MTT.InputDetails.DebitAcctCrncyCode
		BANCS.INPARAM.ToCurrency=MTT.InputDetails.LoanAccountCrncyCode
		if (sv_a == "1" ) then 
			BANCS.INPARAM.InputAmount=(sv_s + sv_q) - sv_t
			BANCS.INPARAM.FromCurrency= MTT.InputDetails.LoanAccountCrncyCode
			BANCS.INPARAM.ToCurrency=MTT.InputDetails.DebitAcctCrncyCode
		endif
		BANCS.INPARAM.RateCode=MTT.InputDetails.TranRateCode
		BANCS.INPARAM.Rate=MTT.InputDetails.TranRate
		sv_z=urhk_B2k_ConvertAmount("")
		sv_x= CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		
		#-----------------------------------------------
		# Loan Acct Xfer Parking Debit 					
		#-----------------------------------------------

		MTT.PartTranDetails.Account = MTT.InputDetails.XferParkAcct 
		        #MSG0309578 = "Loan Account Payments For : " + MTT.InputDetails.LoanAccount
        sv_c =urhk_getMSGCodeErrDesc("MSG0309578")
        if(sv_c == 0) then
            sv_f = BANCS.OUTPARAM.errDesc
        endif
        MTT.PartTranDetails.Particulars = sv_f + " " + MTT.InputDetails.LoanAccount	
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAPAY"
		sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_z == 0) then
			call("getMTTTranPart.scr")
		endif
        MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate 	
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAccountCrncyCode
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.RefAmount = -sv_x
		#print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.sysPartTranCode ="PTRN02593"

		if (MTT.InputDetails.FuncCode == "R") then 
			MTT.PartTranDetails.RefAmount = sv_x
			MTT.PartTranDetails.sysPartTranCode ="PTRN02594"
		#print(MTT.PartTranDetails.RefAmount)
		endif
		if (sv_a == "1" ) then 
			MTT.PartTranDetails.Account = MTT.InputDetails.ConsolLoanParkAcct 
			MTT.PartTranDetails.RefCurrency = MTT.InputDetails.DebitAcctCrncyCode
		endif 
		MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
		MTT.PartTranDetails.PartTranIdentifier = "SOURCE_DEBIT"
		MTT.PartTranDetails.PTranBusinessType = "RECOV"								
PRINT(" Account=["+MTT.PartTranDetails.Account+"]RefCurrency["+MTT.PartTranDetails.RefCurrency+"]RefAmount=["+MTT.PartTranDetails.RefAmount)
		sv_r = urhk_MTTS_DefineLoanPartTran("LA_PARK_CREDIT")
		if (sv_r == 1) then
			exitscript
		endif
	#}
	endif

#-----------------------------------------------------------
# Loan Acct Credit			 					 
#-----------------------------------------------------------

    if((MTT.InputDetails.ExcessCrToLAPayAcctFlg == "Y") and (sv_n != 0 ) AND (sv_d == 0))then
        sv_q = sv_h + sv_i+ sv_j + sv_k + sv_d
    else
        sv_q = sv_h + sv_i+ sv_j + sv_k + sv_d + sv_n
    endif

# For Ijarah Accounts Principal Amount is to be subtracted from Loan Account Credit
    if ( MTT.InputDetails.isIjarahFlg == "Y" ) then
	    sv_q = sv_q - sv_h	
		    endif
# For Forward Ijarah Account in Construction Period Interest Amount is to be subtracted from Loan Account
# Credit
	if ( MTT.InputDetails.AddAdvRentAcntng == "Y" ) then
	    sv_q = sv_q - sv_i	
	endif
	if (sv_q != 0) then
	#{
		MTT.PartTranDetails.Account = MTT.InputDetails.LoanAccount
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAccountCrncyCode

##Changing tran particulars
#        #MSG0309175 = "Loan Recovery From : " + MTT.InputDetails.SourceDebitAccount
#        sv_c =urhk_getMSGCodeErrDesc("MSG0309175")
#        if(sv_c == 0) then
#            sv_f = BANCS.OUTPARAM.errDesc
#        endif
#        MTT.PartTranDetails.Particulars = sv_f + " " + MTT.InputDetails.SourceDebitAccount
		MTT.PartTranDetails.Particulars = "SCH Loan Recovery From :  " + MTT.InputDetails.SourceDebitAccount
		# Particular modification for leasing : Change done for the Call ID 369283
		# In case the payment for the residual is done / partially done, then we need 
		# to display the same in the particular detail for the transaction.
		if((MTT.InputDetails.PartFlgForLease == "F")) then
			MTT.PartTranDetails.Particulars = MTT.PartTranDetails.Particulars + ":Incl.RV Amt." 
		endif
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAPAY"
		sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_z == 0) then
			call("getMTTTranPart.scr")
		endif
		
		MTT.PartTranDetails.RefAmount = sv_q 

		#print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
		MTT.PartTranDetails.PartTranIdentifier = "LA_CR"
		MTT.PartTranDetails.PTranBusinessType = "RECOV"
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime 
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId 
		MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
		MTT.PartTranDetails.Remarks = MTT.InputDetails.TranRemarks
		MTT.PartTranDetails.RateCode=MTT.InputDetails.TranRateCode
		MTT.PartTranDetails.Refnum = MTT.InputDetails.ReferenceNumber
		MTT.PartTranDetails.sysPartTranCode ="PTRN02595"
		MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.LoanAccount
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.DefaultCollecFlowId
		MTT.LAAddnlDetails.OriginOfTran = "LAPAY"
		MTT.LAAddnlDetails.TypeOfDemand = "A"	

		# For Ijarah Accounts Principal Amount is to be cedited to Receivable
		# Hence making PrincipalAmt zero for Ijarah
		if ( MTT.InputDetails.isIjarahFlg == "Y" ) then
			MTT.LAAddnlDetails.PrincipalAmt = "0"
		else
			MTT.LAAddnlDetails.PrincipalAmt	= sv_h	
		endif	
       # For Forward Ijarah Accounts in construction Period,Interest  Amount is to be cedited to Receivable
       # Hence making InterestAmt zero for Ijarah
	    if ( MTT.InputDetails.AddAdvRentAcntng == "Y" ) then
		    MTT.LAAddnlDetails.InterestAmt = "0"
	    else
		    MTT.LAAddnlDetails.InterestAmt = sv_i
	    endif	

		MTT.LAAddnlDetails.BankChrgAmt	= sv_j
		MTT.LAAddnlDetails.OtherChrgAmt	= sv_k
		MTT.LAAddnlDetails.DeferredInterestAmt	= sv_d

		#print(MTT.LAAddnlDetails.PrincipalAmt)			
		#print(MTT.LAAddnlDetails.InterestAmt)			
		#print(MTT.LAAddnlDetails.BankChrgAmt)			
		#print(MTT.LAAddnlDetails.OtherChrgAmt)			
		#print(MTT.LAAddnlDetails.DeferredInterestAmt)			
		if (MTT.InputDetails.FuncCode == "R") then
		#{
			            #MSG0309176 = "Loan Recovery Reversal From :" + MTT.InputDetails.SourceDebitAccount
			MTT.PartTranDetails.sysPartTranCode ="PTRN02596"
            sv_c =urhk_getMSGCodeErrDesc("MSG0309176")
            if(sv_c == 0) then
                sv_f = BANCS.OUTPARAM.errDesc
            endif
            MTT.PartTranDetails.Particulars = sv_f + " " + MTT.InputDetails.SourceDebitAccount
			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LAPAY"
			sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			if (sv_z == 0) then
				call("getMTTTranPart.scr")
			endif
		
			MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.RevTranId	
			MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.RevTranDate	
			MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.RevLoanAcctPTranSrlNum	
			if(MTT.InputDetails.IntRouteFlg == "O") then
                MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.RevLoanIntAcctFlowId
            else
