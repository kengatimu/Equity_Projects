	IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
	#{
		CREATECLASS("CUST","GCHRG",5)
	#}
	ENDIF
	#sv_a = urhk_B2k_PrintRepos("BANCS")
	########## Initializing the variables ################
	CUST.DATA.eventId = BANCS.INPUT.eventId
	PRINT(CUST.DATA.eventId)
	CUST.DATA.eventType = BANCS.INPUT.eventType
	PRINT(CUST.DATA.eventType)
	
	CUST.DATA.debitAcct = ""
	CUST.DATA.schmCode= ""
	CUST.DATA.crncy =""
	CUST.DATA.chrgAmt = 0
	CUST.DATA.rateCode=""
	CUST.DATA.debitAcid = ""

	############Fetching of Debit Account number###############
	
	###############################################################
	###### For Bankers Cheque Charge collection Debit Account######
	###############################################################
	IF((BANCS.STDIN.menuId == "HDDMI") OR (BANCS.STDIN.menuId == "HDDXMI") OR (BANCS.STDIN.menuId == "HTM"))THEN
    	#{
    		IF(FIELDEXISTS(BANCS.INPUT.purchase_acid))THEN
    		#{
			CUST.DATA.debitAcid = BANCS.INPUT.purchase_acid
			PRINT(CUST.DATA.debitAcid)
			GOTO FINALDEBIT 
		#}
		ENDIF
    	#}
    	ENDIF
	#####################################################################
	###### For Standing Instruction Charge collection Debit Account######
	#####################################################################
    	IF(FIELDEXISTS(BANCS.INPUT.chrgDrAcid))THEN
    	#{
        	CUST.DATA.debitAcid = BANCS.INPUT.chrgDrAcid 
        	PRINT(CUST.DATA.debitAcid) 
        	GOTO FINALDEBIT 
    	#}
   	ENDIF
	##############################################################
	###### Inward Remittance Charge collection Debit Account######
	##############################################################
	IF(BANCS.STDIN.menuId == "HIRM")THEN
	#{
		IF(BANCS.INPUT.BillCurrency != BANCS.STDIN.homeCrncyCode)THEN
		#{
			CUST.DATA.debitAcid = BANCS.INPUT.entityId
			PRINT(CUST.DATA.debitAcid)
			GOTO FINALDEBIT    
		#}
		ELSE
		#{
			# Inward Remittance is of home currency type. Charges not applicable.
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
   	ENDIF

	###############################################################
	#### Charges for outward remittance,cash withdrawal and transfers ####
	###############################################################
	IF((BANCS.STDIN.menuId == "HTM") OR (BANCS.STDIN.menuId == "HXFER") OR (BANCS.STDIN.menuId == "HCASHWD") OR (BANCS.STDIN.menuId == "HORM"))THEN
        #{
               	IF(FIELDEXISTS(BANCS.INPUT.entityId))THEN  
		#{
			CUST.DATA.debitAcid = BANCS.INPUT.entityId
			PRINT(CUST.DATA.debitAcid)
			GOTO FINALDEBIT 
		#}
		ENDIF
        #}
    	ENDIF

	FINALDEBIT:
		sv_z = urhk_B2k_AcidToForacid(CUST.DATA.debitAcid)
		PRINT(sv_z)
		CUST.DATA.debitAcct =  BANCS.OUTPARAM.Foracid
		PRINT(CUST.DATA.debitAcct)
	
	IF(CUST.DATA.debitAcct == "")THEN
	#{
		## Charge Debit account is not set 
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
		##########Fetching of schemecode and crncycode from GAM table############
		
		sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.debitAcct)
		IF (sv_n != 0)THEN
		#{
			sv_e="Invalid Account"
			sv_u = urhk_SetOrbErr(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			print(BANCS.OUTPARAM.acctCrncyCode)
			print(BANCS.OUTPARAM.schmCode)
			
			CUST.DATA.crncy = BANCS.OUTPARAM.acctCrncyCode
			CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
			
		#}
		ENDIF
		
		#############Fetching of Charge Amount for respective EventId from the custom table#########
	
	sv_s="chrgAmt|SELECT CHRG_AMT FROM CUSTOM.CUSTOM_CCPRM WHERE EVENT_TYPE=?SVAR AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
	sv_s = sv_s + " AND SCHM_CODE=?SVAR AND CRNCY_CODE=?SVAR AND BANK_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.DATA.eventType + "|" + CUST.DATA.eventId + "|" + CUST.DATA.schmCode + "|" + CUST.DATA.crncy + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d=urhk_dbSelectWithBind(sv_s)
	IF(sv_d != "0")THEN
	#{
		sv_e="Charge Amount not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
		sv_u = urhk_SetOrbErr(sv_e)
