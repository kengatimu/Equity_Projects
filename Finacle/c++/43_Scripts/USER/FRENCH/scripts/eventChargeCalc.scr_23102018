		GOTO ENDOFSCRIPT
	#}
	ELSE
	#{
		CUST.DATA.chrgAmt=BANCS.OUTPARAM.chrgAmt	
	#}
	ENDIF
	
	PRINT(CUST.DATA.chrgAmt)
	
	ENDOFSCRIPT:
		BANCS.OUTPUT.collAmount = CUST.DATA.chrgAmt
		BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
		BANCS.OUTPUT.AmountWithNoDiscount = CUST.DATA.chrgAmt
		
