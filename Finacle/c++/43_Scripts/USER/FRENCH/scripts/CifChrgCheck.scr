<--START
TRACE ON

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
        #{
                CREATECLASS("CUST", "DATA", 5)
        #}
        ENDIF

	CUST.DATA.cifID = ""
	CUST.DATA.cifId_dr = " "
	CUST.DATA.cifId_cr = " "
	CUST.DATA.cifStatus = "N"
	PRINT(CUST.DATA.cifStatus)
        sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
        PRINT(sv_u)
        CUST.DATA.tranType = BANCS.OUTPARAM.srvValue

        sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
        PRINT(sv_u)
        CUST.DATA.tranSubType = BANCS.OUTPARAM.srvValue
		
	IF((CUST.DATA.tranType == "T") AND (CUST.DATA.tranSubType == "CI"))THEN
	#{
			
		sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
                	CUST.DATA.NumOfRecs = BANCS.OUTPARAM.srvValue
                	PRINT(CUST.DATA.NumOfRecs)
                	IF(CUST.DATA.NumOfRecs != 0)THEN
                	#{
                        	sv_l = 0
                        	PRINT(sv_l)
                        	WHILE(sv_l < CUST.DATA.NumOfRecs)
                        	#{
                                	sv_v = Format$(sv_l,"%d")
                                	sv_r = "<rec_"+sv_v+">"
                                	PRINT(sv_r)

                                	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
                                	PRINT(sv_u)		
					PRINT(BANCS.OUTPARAM.srvValue)
					CUST.DATA.partTranType = BANCS.OUTPARAM.srvValue
                                	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
					PRINT(BANCS.OUTPARAM.srvValue)
					CUST.DATA.foracid = BANCS.OUTPARAM.srvValue

				if(CUST.DATA.partTranType=="D")then
				#{

					if(CUST.DATA.foracid != "")then
					#{
						sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.foracid)

						CUST.DATA.drschmcode= BANCS.OUTPARAM.schmCode
						print(CUST.DATA.drschmcode)

					#}
					endif

				#}
				else
				#{

					if(CUST.DATA.foracid != "")then
					#{
						sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.foracid)

						CUST.DATA.crschmcode= BANCS.OUTPARAM.schmCode
						print(CUST.DATA.crschmcode)

					#}
					endif

				#}
				endif

					
                                	sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctDtl.custId.cifId")
                                	PRINT(sv_u)	
					PRINT(BANCS.OUTPARAM.srvValue)

					IF(TRIM(BANCS.OUTPARAM.srvValue) == "")THEN
					#{
						sv_s = "cifId|SELECT CIF_ID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR"
						BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId +"|"+ CUST.DATA.foracid
					        sv_k = urhk_dbSelectWithBind(sv_s)
        					PRINT(sv_s)
						IF(sv_k == "0")THEN
						#{
							CUST.DATA.cifID = BANCS.OUTPARAM.cifId
						#}
						ENDIF
					#}
					ELSE
					#{
						CUST.DATA.cifID = BANCS.OUTPARAM.srvValue
					#}
					ENDIF
	
					PRINT(CUST.DATA.cifID)

					IF(CUST.DATA.partTranType == "D")THEN
					#{
						#clement
						CUST.DATA.drcif =CUST.DATA.cifID
						IF(TRIM(CUST.DATA.cifId_dr) != "")THEN
						#{
							CUST.DATA.cifId_dr = CUST.DATA.cifId_dr +","+CUST.DATA.cifID
						#}
						ELSE
						#{
							CUST.DATA.cifId_dr = CUST.DATA.cifID
						#}
						ENDIF
					#}
					ELSE
					#{
						#clement
						CUST.DATA.crcif =CUST.DATA.cifID

						IF(TRIM(CUST.DATA.cifId_cr) != "")THEN
						#{
							CUST.DATA.cifId_cr = CUST.DATA.cifId_cr +","+CUST.DATA.cifID
						#}
						ELSE
						#{
							CUST.DATA.cifId_cr = CUST.DATA.cifID
						#}
						ENDIF
					#}
					ENDIF


								
                                	PRINT(CUST.DATA.cifId_dr)
					PRINT(CUST.DATA.cifId_cr)
					
							      #clement
						IF   ((FIELDEXISTS(CUST.DATA.drschmcode)) and (FIELDEXISTS(CUST.DATA.crschmcode)))  THEN
								if((CUST.DATA.drschmcode =="CA243") OR (CUST.DATA.crschmcode =="CA243"))then
								#{
									if(CUST.DATA.drcif !=CUST.DATA.crcif)then
									#{
										
											CUST.DATA.cifStatus = "Y"
											PRINT(CUST.DATA.cifStatus)

									#}
									endif
								#}
								endif
						endif
					sv_l= sv_l+1
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF

		      #clement
				if(CUST.DATA.cifStatus == "Y")then
					#{
					    sv_u = urhk_SRV_SetErr("transfer not allowed for accounts of scheme code CA243")
						BANCS.OUTPUT.successOrFailure="F"
						GOTO ENDOFSCRIPT
					#}
				endif
					
					

		sv_a = ""
		sv_b = CUST.DATA.cifId_cr
		sv_c = GETPOSITION(sv_b,",")
		IF(sv_c!=0) THEN
		#{
	
			sv_l =STRLEN(sv_b)
			PRINT(sv_l)
			PRINT(sv_c)
			WHILE(sv_c !=0)
			#{
				sv_a =MID$(sv_b,0,sv_c - 1)
				PRINT(sv_a)
				sv_d = GETPOSITION(CUST.DATA.cifId_dr,"sv_a")
							
				IF(sv_d != "0")THEN
				#{
					GOTO REMOVECHRG
				#}
				ENDIF
				sv_b=MID$(sv_b,sv_c,sv_l)
				PRINT(sv_b)
				sv_c = GETPOSITION(sv_b,",")
				sv_l =STRLEN(sv_b)
				PRINT(sv_l)
				PRINT(sv_c)
				IF(sv_c == "0")THEN
				#{
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			DO
			sv_y = sv_a
		#}
		ELSE
		#{
			IF(TRIM(CUST.DATA.cifId_cr) != "")THEN
			#{
				sv_d = GETPOSITION(CUST.DATA.cifId_dr,CUST.DATA.cifId_cr)
                	        IF(sv_d != "0")THEN
                                #{
                                        GOTO REMOVECHRG
                                #}
				ELSE
				#{
					GOTO ENDOFSCRIPT
				#}
                                ENDIF
			#}
			ELSE
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
			
		REMOVECHRG:
                sv_l = 0
                PRINT(sv_l)
                WHILE(sv_l < CUST.DATA.NumOfRecs)
                #{
                        sv_v = Format$(sv_l,"%d")
                        sv_r = "<rec_"+sv_v+">"
                        PRINT(sv_r)

                        sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
                        PRINT(sv_u)		
			CUST.DATA.partTranType = BANCS.OUTPARAM.srvValue
			IF(CUST.DATA.partTranType == "D")THEN
			#{
				sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL." +sv_r+ ".pTranChrgEventId.eventId| ")
			#}
			ENDIF
			sv_l= sv_l+1
		#}
		DO		
			

	#}
	ENDIF
ENDOFSCRIPT:
	TRACE OFF
END-->

