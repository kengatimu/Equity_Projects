<--start
trace on
sv_a=urhk_B2k_PrintRepos("BANCS")
sv_a = urhk_SRV_GetVal("sourceSchm.schmCode")
sv_b=BANCS.OUTPARAM.srvValue
print(sv_b)

sv_k="N"
IF ((sv_b=="SB199") OR (sv_b=="CA299")) THEN
	IF ((BANCS.STDIN.userWorkClass=="150") OR (BANCS.STDIN.userWorkClass=="200") OR (BANCS.STDIN.userWorkClass=="198") OR (BANCS.STDIN.userWorkClass=="650") OR (BANCS.STDIN.userWorkClass=="510") OR (BANCS.STDIN.userWorkClass=="515") OR (BANCS.STDIN.userWorkClass=="600") OR (BANCS.STDIN.userWorkClass=="999")) THEN
		sv_k="Y"
	ENDIF
	IF ((BANCS.STDIN.userWorkClass=="160") OR (BANCS.STDIN.userWorkClass=="161") OR (BANCS.STDIN.userWorkClass=="162") OR (BANCS.STDIN.userWorkClass=="163") OR (BANCS.STDIN.userWorkClass=="164") OR (BANCS.STDIN.userWorkClass=="165") ) THEN
		sv_k="Y"
	ENDIF
	IF ((BANCS.STDIN.userWorkClass=="204") OR (BANCS.STDIN.userWorkClass=="205") OR (BANCS.STDIN.userWorkClass=="206") OR (BANCS.STDIN.userWorkClass=="207") OR (BANCS.STDIN.userWorkClass=="208") OR (BANCS.STDIN.userWorkClass=="209") ) THEN
		sv_k="Y"
	ENDIF
	IF (sv_k=="N") THEN
		sv_u = urhk_SRV_SetErr("Verification can only be done by 150,198,200,160,161,162,163,164,165,204,205,206,207,208,209.......")
		BANCS.OUTPUT.successOrFailure = "F"
		exitscript
	ENDIF
ENDIF

trace off
end-->
