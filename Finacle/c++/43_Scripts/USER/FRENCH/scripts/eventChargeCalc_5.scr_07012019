                			ENDIF

					sv_s = "recCount|SELECT COUNT(1) FROM CUSTOM.C_CHARGE_COLLECTION WHERE ACCT_NUM = ?SVAR AND TRAN_DATE = "
					sv_s = sv_s + "TO_DATE(sysdate,'DD-MM-YY') AND BANK_ID = ?SVAR AND INSTR_NUM = ?SVAR AND INSTR_TYPE=?SVAR AND "
					sv_s = sv_s + "CHARGE_TYPE='REJCHRG' AND TOTAL_CHARGE_AMT = ?SVAR AND CHARGE_CRNCY_CODE=?SVAR"

					BANCS.INPARAM.BINDVARS = CUST.DATA.debitAcct + "|"+ BANCS.STDIN.contextBankId + "|" + CUST.DATA.instrNum
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.instrType + "|" + CUST.DATA.chrgAmount
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.homeCrncyCode

					PRINT(sv_s)
					PRINT(BANCS.INPARAM.BINDVARS)
                                        sv_d = urhk_dbSelectWithBind(sv_s)
                                        PRINT(sv_d)

                                        IF(sv_d == 0)THEN
                                        #{
                                        	CUST.DATA.recCount = BANCS.OUTPARAM.recCount
                                        #}
                                        ENDIF
					IF(CUST.DATA.recCount > 0) THEN
					#{
						#Below table entries added to store the instrutment number,type,accountId and user details temporarily
						sv_s = "INSERT INTO CUSTOM.CHRG_TEMP_TBL(INSTR_NUM,INSTR_TYPE,ACCTID,RCRE_TIME,USER_ID,BANK_ID) "
						sv_s = sv_s + "VALUES (?SVAR,?SVAR,?SVAR,sysdate,?SVAR,?SVAR)"
						BANCS.INPARAM.BINDVARS=TRIM(CUST.DATA.instrNum) + "|" + TRIM(CUST.DATA.instrType) + "|" + CUST.DATA.debitAcct
						BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
						PRINT(sv_s)
						PRINT(BANCS.INPARAM.BINDVARS)
                                        	sv_q = urhk_dbSQLWithBind(sv_s)
                                        	PRINT(sv_q)
                                        	IF(sv_q != 0)THEN
                                        	#{
                                                        CUST.DATA.errMsg = ""
                                                        CUST.DATA.errMsg = CUST.DATA.debitAcct + " Record insert failed"
                                                        PRINT(CUST.DATA.errMsg)
                                                        GOTO ENDOFSCRIPT
                                        	#}
                                        	ELSE
                                        	#{
                                                	sv_q = urhk_dbSQLWithBind("COMMIT")
                                        	#}
                                        	ENDIF
                                        	CUST.DATA.chrgAmt = "0"
                                        	PRINT(CUST.DATA.chrgAmt)
                                        	GOTO ENDOFSCRIPT
					#}
					ENDIF

					CUST.DATA.slCount = ""
					sv_s = "slCount|SELECT COUNT(1) FROM  CUSTOM.C_CHARGE_COLLECTION WHERE "
					sv_s = sv_s + " ACCT_NUM = ?SVAR AND TRAN_DATE = TO_DATE(sysdate,'DD-MM-YY') AND"
					sv_s = sv_s + " BANK_ID = ?SVAR "
					BANCS.INPARAM.BINDVARS = CUST.DATA.debitAcct + "|"+ BANCS.STDIN.contextBankId
	
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
	
					IF(sv_d == 0)THEN
					#{
							sv_l = BANCS.OUTPARAM.slCount
							sv_l = CINT(sv_l) + 1
							CUST.DATA.slCount = sv_l
							PRINT(CUST.DATA.slCount)
					#}
					ENDIF
	
					#######sl no generation- END
	
					CUST.DATA.remark ="Insufficient balance"
	
					sv_s = "INSERT INTO CUSTOM.C_CHARGE_COLLECTION (CHARGE_TYPE,SRL_NUM,ACCT_NUM,SOL_ID,ACCT_CRNCY_CODE,"
					sv_s = sv_s + "TRAN_DATE,CHARGE_AMT,VAT_AMT,TOTAL_CHARGE_AMT,CHARGE_CRNCY_CODE,TOT_ADJ_AMT,"
					sv_s = sv_s + "LAST_ADJUSTED_DATE,FULLY_ADJUSTED_FLG,LIEN_STATUS_FLG,LIEN_APPLIED_AMT,RCRE_USER_ID,"
					sv_s = sv_s + "RCRE_TIME,LCHG_USER_ID,LCHG_TIME,BANK_ID,FAILURE_REMARKS,INSTR_NUM,INSTR_TYPE) values "
					sv_s = sv_s + "(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
					sv_s = sv_s + "TO_DATE(sysdate,'DD-MM-YY'),?SVAR,?SVAR,?SVAR,?SVAR,0,"
					sv_s = sv_s + "'','N','N',0,?SVAR,"
					sv_s = sv_s + "SYSDATE,'','',?SVAR,?SVAR,?SVAR,?SVAR)"
	
					BANCS.INPARAM.BINDVARS = "REJCHRG" + "|" + CUST.DATA.slCount + "|" + CUST.DATA.debitAcct + "|" + CUST.DATA.acctSolId + "|" + CUST.DATA.acctCrncy
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.DATA.chrgAmt + "|" + CUST.DATA.vatcollAmount + "|" + CUST.DATA.chrgAmount
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.userId
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.DATA.remark
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + TRIM(CUST.DATA.instrNum) + "|" + TRIM(CUST.DATA.instrType)
	
					sv_q = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_q)
					IF(sv_q != 0)THEN
					#{
							CUST.DATA.errMsg = ""
							CUST.DATA.errMsg = CUST.DATA.debitAcct + " Record insert failed"
							PRINT(CUST.DATA.errMsg)
							GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						sv_q = urhk_dbSQLWithBind("COMMIT")
					#}
					ENDIF

					sv_s = "INSERT INTO CUSTOM.CHRG_TEMP_TBL(INSTR_NUM,INSTR_TYPE,ACCTID,RCRE_TIME,USER_ID,BANK_ID) "
					sv_s = sv_s + "VALUES (?SVAR,?SVAR,?SVAR,sysdate,?SVAR,?SVAR)"
					BANCS.INPARAM.BINDVARS=TRIM(CUST.DATA.instrNum) + "|" + TRIM(CUST.DATA.instrType) + "|" + CUST.DATA.debitAcct
					BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
					PRINT(sv_s)
					PRINT(BANCS.INPARAM.BINDVARS)
                                        sv_q = urhk_dbSQLWithBind(sv_s)
                                        PRINT(sv_q)
                                        IF(sv_q != 0)THEN
                                        #{
                                                        CUST.DATA.errMsg = ""
                                                        CUST.DATA.errMsg = CUST.DATA.debitAcct + " Record insert failed"
                                                        PRINT(CUST.DATA.errMsg)
                                                        GOTO ENDOFSCRIPT
                                        #}
                                        ELSE
                                        #{
                                                sv_q = urhk_dbSQLWithBind("COMMIT")
                                        #}
                                        ENDIF

					CUST.DATA.chrgAmt = "0"
					PRINT(CUST.DATA.chrgAmt)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF

        #IF((CUST.DATA.crncy != BANCS.STDIN.homeCrncyCode) AND (CUST.DATA.CallMode != "SCRIPT") AND (CUST.DATA.eventId != "SWIFTOUR") AND (CUST.DATA.eventId != "SWIFTBEN") AND (CUST.DATA.eventId != "SWIFTSHR"))THEN
        IF((CUST.DATA.crncy != BANCS.INPUT.chrgCollCrncy) AND (CUST.DATA.CallMode != "SCRIPT"))THEN
        #{
                BANCS.INPARAM.InputAmount  = CUST.DATA.chrgAmt
                BANCS.INPARAM.FromCurrency = CUST.DATA.crncy
                BANCS.INPARAM.ToCurrency   = BANCS.INPUT.chrgCollCrncy
                BANCS.INPARAM.RateCode     = BANCS.INPUT.rateCode
                BANCS.INPARAM.Rate         = CDOUBLE("0.0")

                sv_u = urhk_B2k_ConvertAmount("")

                CUST.DATA.chrgAmt = BANCS.OUTPARAM.OutputAmount
        #}
        ENDIF
        PRINT(CUST.DATA.chrgAmt)

        ENDOFSCRIPT:
                BANCS.OUTPUT.collAmount = CUST.DATA.chrgAmt
                BANCS.OUTPUT.collCrncy = BANCS.INPUT.chrgCollCrncy
                BANCS.OUTPUT.AmountWithNoDiscount = CUST.DATA.chrgAmt

