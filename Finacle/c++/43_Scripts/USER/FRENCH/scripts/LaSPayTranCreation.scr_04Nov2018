				MTT.PartTranDetails.sysPartTranCode ="PTRN02599"
				PRINT(MTT.PartTranDetails.RefAmount)
				IF (MTT.InputDetails.FuncCode == "R") THEN
				#{
					MTT.PartTranDetails.RefAmount=sv_x
					PRINT(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.sysPartTranCode ="PTRN02600"
