					CUST.VAT.crDrInd = "CR"
					#MTT.PartTranDetails.Particulars         = "Loan VAT Cr : " +MTT.InputDetails.LoanAccount
					CUST.VAT.RemarksCRPenal           = "Loan Recovery VAT CR Penal"
					CUST.VAT.ParticularsCRPenal         = " Loan VAT Cr:" + MTT.InputDetails.LoanAccount
					#}
				ELSE
					#{
					IF (MTT.InputDetails.FuncCode == "R" ) THEN
					#{
						
						CUST.VAT.crDrInd = "DR"
						#MTT.PartTranDetails.Particulars         = "Loan VAT Dr : " +MTT.InputDetails.LoanAccount
						CUST.VAT.RemarksCRPenal           = "Loan Recovery VAT CR Penal"
						CUST.VAT.ParticularsCRPenal         = " Loan VAT Cr:" + MTT.InputDetails.LoanAccount
					#}
					ENDIF
				#}
				ENDIF
				
			#}
			ENDIF
			
		#}
		ENDIF
		
		IF((sv_k !=0) OR (sv_l !=0))THEN
		#{
			CALL("VATLoanTranCreate.scr")
			#}
		ELSE
			#{
			CUST.VAT.tranId = "NA"
			PRINT(CUST.VAT.tranId)
		#}
		ENDIF
		
		IF (FIELDEXISTS(CUST.VAT.vatTranId) AND (CUST.VAT.tranId != "NA")) THEN
		#{
			
			PRINT(CUST.VAT.vatTranId)
			CUST.VAT.tranId = CUST.VAT.vatTranId
			PRINT(CUST.VAT.tranId)
			
			
		#}
		ENDIF
		
		################### End of customization #####################################
		
		
		GET_NEXT_REC:
			sv_r = urhk_MTTS_PopulateInputDetails("")
			PRINT(sv_r)
			IF(sv_r == 1) THEN
			#{
				sv_r = urhk_MTTS_EndDefinition("")
				PRINT(sv_r)
				PRINT(sv_z)
				
				IF (FIELDEXISTS(CUST.VAT.tranId) AND (CUST.VAT.tranFailed =="N")) THEN
				#{
					PRINT(CUST.VAT.tranId)
					#}
				ELSE
					#{
					if(CUST.VAT.tranId !="")then
					#{
					CUST.VAT.tranId = "NA"
					PRINT(CUST.VAT.tranId)
					#}
					endif	
				#}
				ENDIF
				
				IF (FIELDEXISTS(CUST.VAT.SattranId)) THEN
				#{
					PRINT(CUST.VAT.SattranId)
				#}
				ENDIF
				
				
				CALL("vatTableUpdate.scr")
				#trace off
				
				EXITSCRIPT
			#}
			ENDIF
		#}
		DO
		#}
		
		TRACE OFF
