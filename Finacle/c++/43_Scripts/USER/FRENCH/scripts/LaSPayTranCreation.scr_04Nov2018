			# For Forward Ijarah Accounts in construction Period,Interest  Amount is to be cedited to Receivable
			# Hence making InterestAmt zero for Ijarah
			IF ( MTT.InputDetails.AddAdvRentAcntng == "Y" ) THEN
			#{
				MTT.LAAddnlDetails.InterestAmt = "0"
				#}
			ELSE
				#{
				MTT.LAAddnlDetails.InterestAmt = sv_i
			#}
			ENDIF
			
			MTT.LAAddnlDetails.BankChrgAmt	= sv_j
			MTT.LAAddnlDetails.OtherChrgAmt	= sv_k
			MTT.LAAddnlDetails.DeferredInterestAmt	= sv_d
			
			#print(MTT.LAAddnlDetails.PrincipalAmt)
			#print(MTT.LAAddnlDetails.InterestAmt)
			#print(MTT.LAAddnlDetails.BankChrgAmt)
			#print(MTT.LAAddnlDetails.OtherChrgAmt)
