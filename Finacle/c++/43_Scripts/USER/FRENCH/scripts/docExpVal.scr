			ENDIF
		    #}  
		ENDIF
		#}
		ENDIF
		###########################################################################################
		# validation to check the transaction type
		###########################################################################################
		IF(FIELDEXISTS(BANCS.INPUT.TranType))THEN
		#{
			IF((BANCS.INPUT.TranType == "T") OR (BANCS.INPUT.TranType == "C"))THEN
			#{	
				IF ((BANCS.INPUT.TranSubType == "CI") OR (BANCS.INPUT.TranSubType == "NP") OR (BANCS.INPUT.TranSubType == "NR")) THEN
				#{
					CUST.DOC.tranType = BANCS.INPUT.TranType
					CUST.DOC.tranSubType = BANCS.INPUT.TranSubType
					PRINT(CUST.DOC.tranType)
					PRINT(CUST.DOC.tranSubType)
				#}
				ELSE
				#{
				CUST.DOC.errorMsg = "Document expiry validation not required for this transaction type"
				PRINT(CUST.DOC.errorMsg)
				GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			
			ELSE
			#{
			CUST.DOC.errorFlg = "Y"
			PRINT(CUST.DOC.errorFlg)
			CUST.DOC.errorMsg = "Document expiry validation not required for this transaction type"
			PRINT(CUST.DOC.errorMsg)
			GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF
		###########################################################################################
		IF(FIELDEXISTS(BANCS.INPUT.AcctNum))THEN
		#{
			IF(TRIM(BANCS.INPUT.AcctNum) != "")THEN
			#{
				CUST.DOC.acctId = TOUPPER(TRIM(BANCS.INPUT.AcctNum))
				PRINT(CUST.DOC.acctId)
			#}
			ENDIF
