		###########################################################################################
		# Fetching cifId for the accountId from GAM table
		###########################################################################################
	
		sv_a = "cifId|select cif_id from tbaadm.gam where foracid=?SVAR AND del_flg!='Y' AND bank_id=?SVAR"
		PRINT(sv_a)
	
		BANCS.INPARAM.BINDVARS=CUST.DOC.acctId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
	
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF(sv_b ==0) THEN
		#{
			CUST.DOC.cifId = BANCS.OUTPARAM.cifId
			PRINT(CUST.DOC.cifId)
		#}
		ENDIF
		
		###########################################################################################
		# Fetching bodDate for the transaction from GCT table
		###########################################################################################
		
		sv_q = "bodDate|select to_char((db_stat_date),'DD-MON-YYYY') from tbaadm.gct where bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_r = urhk_dbSelectWithBind(sv_q)
		IF(sv_r ==0) THEN
		#{
		CUST.DOC.bodDate = BANCS.OUTPARAM.bodDate
		PRINT(CUST.DOC.bodDate)
		#}
		ENDIF
		
		###########################################################################################
		# Fetching expDate for the document from crmuser's entitydocument table
		###########################################################################################
		sv_s = "count|select count(1) from crmuser.entitydocument where orgkey =?SVAR AND bank_id=?SVAR AND docexpirydate <?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS=CUST.DOC.cifId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DOC.bodDate
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d == 0) THEN
		#{
			CUST.DOC.expCount = BANCS.OUTPARAM.count
			PRINT(CUST.DOC.expCount)
			
			IF(CUST.DOC.expCount > 0) THEN
			#{
			CUST.DOC.errorFlg = "Y"
			PRINT(CUST.DOC.errorFlg)
			CUST.DOC.errorMsg = "One of the Customer's Document is expired. Transaction not allowed"
			PRINT(CUST.DOC.errorMsg)
			
			#Gettiing Exception from CPARAM Parameter value
			
			sv_v = "parmVal | select CUSTOM.getCparamValue('DOC_EXP_VAL_EXCP','OT',?SVAR)  from dual"
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_e = urhk_dbSelectWithBind(sv_v)
			IF(sv_e == 0) THEN
				#{
				CUST.DOC.parmVal = BANCS.OUTPARAM.parmVal
                PRINT (CUST.DOC.parmVal)
         
			print(BANCS.INPUT.ValMode)
			print(BANCS.INPUT.DrCrInd)
			print(BANCS.INPUT.ExceptionIgnoreFlg)
			BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
			BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
			BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
			sv_u = urhk_FTS_RaiseException(CUST.DOC.parmVal)
			GOTO ENDOFSCRIPT
				#}
			ELSE
			#{
				#CPARAM value is not set
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
