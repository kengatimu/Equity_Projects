		###########################################################################################
		# validation to check the transaction is charge collection or not
		###########################################################################################
		IF(FIELDEXISTS(BANCS.INPUT.TranParticulars))THEN
		#{
			IF(BANCS.INPUT.TranParticulars != "")THEN
			#{
				CUST.DOC.tranPartcls1 = BANCS.INPUT.TranParticulars
				sv_x = "tp_count|select count(1) from tbaadm.ptt where tran_partcls =?SVAR and bank_id=?SVAR"
				PRINT(sv_x)
				BANCS.INPARAM.BINDVARS=CUST.DOC.tranPartcls1 + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_y = urhk_dbSelectWithBind(sv_x)
				PRINT(sv_y)
			
			IF(sv_y == 0)THEN
				#{
				CUST.DOC.tpCount = BANCS.OUTPARAM.tp_count
				PRINT(CUST.DOC.tpCount)
					
				IF(CUST.DOC.tpCount > 0) THEN
				#{
					CUST.DOC.errorFlg = "Y"
					PRINT(CUST.DOC.errorFlg)
