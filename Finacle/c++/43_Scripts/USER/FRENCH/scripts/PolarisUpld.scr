########################################################################################
# Source Name         			: catodscoredp002.scr
# Author              			: Saurabh Sinha
# Date                			: 09-MAY-13
# Title               			: Bulk Account transfer through uploads
# Description         			: This Script selects records from uploaded CSV file and read the record
# Input               			: CSV
# Output              			: None.
# Calling script      			:
# Called  Script      			: None
# RS Approach Document			:
# Design Document     			:
# ModIFication History			:
#   <Serial No.>     	<Date>         <Author Name>			<Description>
#		0.00a			09-May-13		Saurabh Sinha			Original version
#		0.00b			23-May-13		Saurabh Sinha			Success and Failure report generation logic updated
#		0.00c			28-May-13		Saurabh Sinha			Logic Updated for Upload File data segregration
#		0.00d			27-Jul-13		Bharath					Modified for csv input file
#		0.00e			15-Aug-13		Priyansh			Modified for TOL:361668
#
#########################################################################################
<--START
CHECKSUM="d24e95e7718342acf32e641bbe97e61719499adbb752d202783f4d1a042b52e8"
	TRACE ON
	LIBNAME CUSTOMSO
	sv_u=urhk_B2k_PrintRepos("BANCS")
	print(sv_u)
	
	#--------------------------------------------------------------------------------------------------
	# Creating the log File
	#--------------------------------------------------------------------------------------------------
	sv_s = "startTime|"
	sv_s = sv_s + " SELECT TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') "
	sv_s = sv_s + " FROM DUAL"
	print(sv_s)
	sv_r = urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	
	CUST.CATOD.startTime = BANCS.OUTPARAM.startTime
	CUST.CATOD.successlogFile = "Upload_Success_" + CUST.CATOD.startTime + ".log"
	CUST.CATOD.failurelogFile = "Upload_Failure_" + CUST.CATOD.startTime + ".log"
	print(CUST.CATOD.startTime)
	print(CUST.CATOD.successlogFile)
	print(CUST.CATOD.successlogFile)
	
	#--------------------------------------------------------------------------------------------------
	# Creating the Sucess and Failure report files
	#--------------------------------------------------------------------------------------------------
	sv_s = "touch " + CUST.CATOD.successlogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	
	sv_s = "touch " + CUST.CATOD.failurelogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	
	#=================================================================================*
	#	Start Reading the CSV file
	#=================================================================================*
	
	sv_o = urtn_fileOpen(CUST.CATOD.fileName + "|r")
	print(sv_o)
	IF (sv_o == 0) THEN
	#{
		CUST.CATOD.fileindex = sv_o
		print(CUST.CATOD.fileindex)
		print(CUST.CATOD.selectedRec)
		
		sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")

		IF(sv_x == 0) THEN
		#{
			sv_n = "1"
			sv_v = "Y"
			WHILE(sv_x==0)
			#{
				sv_c = 0
				print(CUST.CATOD.selectedRec)
				print(BANCS.OUTPARAM.buffer)
				CUST.CATOD.selectedRec = BANCS.OUTPARAM.buffer
				CUST.CATOD.recBackUp = CUST.CATOD.selectedRec
				print(CUST.CATOD.selectedRec)
				print(CUST.CATOD.recBackUp)
				#=================================================================================*
				# Reading the data from CSV file
				#=================================================================================*
				#sv_l = STRLEN(CUST.CATOD.selectedRec)
				#print(sv_l)

				CUST.CATOD.selectedRec = ltrim(rtrim(CUST.CATOD.selectedRec))
				print(CUST.CATOD.selectedRec)
				sv_l = STRLEN(CUST.CATOD.selectedRec)
				print(sv_l)
				IF (sv_l == 0)THEN
					GOTO NEXTREC
				ENDIF
				CUST.CATOD.selectedRec = CUST.CATOD.selectedRec + "|"
				print(CUST.CATOD.selectedRec)
				sv_z=CUST.CATOD.selectedRec
				sv_h="1"
				sv_t = 0
				WHILE(sv_l > 0)
				#{
					sv_l = STRLEN(sv_z)
					print(sv_l)
					sv_p = GETPOSITION(sv_z, "|")
					print(sv_p)
					sv_t = sv_t + 1
					print(sv_t)
					CUST.CATOD.numOfValues = sv_t
					print(CUST.CATOD.numOfValues)
					
					IF(sv_p==0)THEN
					#{
						sv_l=-1
						print(sv_l)
					#}
					ENDIF
					
					sv_a = LEFT$(sv_z, sv_p - 1)
					print(sv_a)
					CUST.CATOD.num=sv_h
					print(CUST.CATOD.num)
					("CUST").("CATOD").("fieldData" + CUST.CATOD.num) = sv_a
					print(sv_a)
					
					
					IF (CUST.CATOD.num=="1") THEN
					#{
						CUST.CATOD.Foracid=sv_a
						print(CUST.CATOD.Foracid)
					#}
					ENDIF
					IF (CUST.CATOD.num=="2") THEN
					#{
						CUST.CATOD.Amount=sv_a
						print(CUST.CATOD.Amount)
					#}
					ENDIF
					
					
					sv_h=CINT(CUST.CATOD.num)+1
					print(sv_h)
					
					sv_z = RIGHT$(sv_z, STRLEN(sv_z) - sv_p)
					print(sv_z)
					sv_l=sv_l-sv_p
					print(sv_l)
					
					IF((sv_l == 0)AND(sv_h < 3))THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
				#}
				DO
				Print (CUST.CATOD.numOfValues)

				IF (CINT(CUST.CATOD.numOfValues) != 2) THEN
				#{				

					IF (CINT(CUST.CATOD.numOfValues) > 2) THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						GOTO RECORDSEXCEED
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
					
				#}
				ENDIF
				
				
				
				#--------------- Get Account number from the file ------------------------
				print(CUST.CATOD.Foracid)
				print(CUST.CATOD.Amount)

				IF(FIELDEXISTS(CUST.CATOD.Foracid))THEN
					IF (CUST.CATOD.Foracid=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Foracid is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF
					sv_u = urhk_getAcctDetailsInRepository(CUST.CATOD.Foracid)
					print(sv_u)			
					IF (sv_u == 0) THEN
						CUST.CATOD.acctSolId  = BANCS.OUTPARAM.acctSolId
						CUST.CATOD.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
						CUST.CATOD.schmType = BANCS.OUTPARAM.schmType
						CUST.CATOD.schmCode = BANCS.OUTPARAM.schmCode
						CUST.CATOD.acctOwner = BANCS.OUTPARAM.acctOwnerShip
						CUST.CATOD.frezCode = BANCS.OUTPARAM.freezeCode
						print(CUST.CATOD.acctCrncyCode)
						print(CUST.CATOD.schmType)
						print(CUST.CATOD.schmCode)
						print(CUST.CATOD.acctOwner)			

						IF ((CUST.CATOD.schmType !="SBA") and  (CUST.CATOD.schmType !="CAA"))THEN
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Schmtype Invalid Account "
							sv_v = "N"
							sv_c = sv_c + 1
							GOTO INVALID
						ENDIF
						IF  (CUST.CATOD.schmType =="O") THEN
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Office Account not allowed "
							sv_v = "N"
							sv_c = sv_c + 1
							GOTO INVALID
						ENDIF
						IF  ((CUST.CATOD.frezCode =="D") OR  (CUST.CATOD.frezCode =="T")) THEN
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Frozen  Account "
							sv_v = "N"
							sv_c = sv_c + 1
							GOTO INVALID
						ENDIF

						sv_z = urhk_B2k_ForacidToAcid(CUST.CATOD.Foracid)
						print(sv_z)
						IF(sv_z == 0)THEN
							BANCS.INPARAM.acid = BANCS.OUTPARAM.Acid
							sv_u = urhk_getAcctStatus("")
							IF(sv_u == 0) THEN
								CUST.CATOD.acctStatus = BANCS.OUTPARAM.acctStatus
								print (CUST.CATOD.acctStatus)					
									IF  ((CUST.CATOD.acctStatus !="A")) THEN								
										CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Dormant/Inactive   Account "
										sv_v = "N"
										sv_c = sv_c + 1
										GOTO INVALID
									ENDIF	
							ELSE
								Print ("Could not get acid")
							ENDIF
								
						ELSE						
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Check account  Account "
							sv_v = "N"
							sv_c = sv_c + 1
							GOTO INVALID
							
						ENDIF
								
						sv_s = "count| SELECT COUNT(1) FROM CUSTOM.POLARIS_CHARGES WHERE ACCOUNT_NUMBER = ?SVAR AND bank_id = ?SVAR"
						sv_s = sv_s + " AND del_flg in ('Y','N') and CHARGE_TYPE='ANNUAL' "			
						print(sv_s)			
						BANCS.INPARAM.BINDVARS = CUST.CATOD.Foracid + "|" +BANCS.STDIN.contextBankId
						sv_d=urhk_dbSelectWithBind(sv_s)
						print(sv_d)			
						IF (sv_d == 0)  THEN				
							CUST.CATOD.count = BANCS.OUTPARAM.count
							print(CUST.CATOD.count)						
							IF (CINT(CUST.CATOD.count) >= 1)  THEN
								CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Already Existing "
								sv_v = "N"
								sv_c = sv_c + 1
								GOTO INVALID								
							ENDIF
						ENDIF 
					ELSE
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Invalid Account "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					
					ENDIF

				 ENDIF


				 IF(FIELDEXISTS(CUST.CATOD.Amount))THEN
					IF (CUST.CATOD.Amount=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Charge Amount is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF
					sv_u = urhk_B2k_isStringNumeric (CUST.CATOD.Amount)
					IF(sv_u != 0) THEN
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "Charge Amount is not in numeric format"
						GOTO INVALID
					ENDIF

				 ENDIF

					BANCS.INPUT.funcCode ="Y"
					BANCS.INPUT.foracid = CUST.CATOD.Foracid
					BANCS.INPUT.Chargeforacid = CUST.CATOD.Foracid
					BANCS.INPUT.employer= ""
					BANCS.INPUT.amount = CUST.CATOD.Amount
					BANCS.INPUT.period = "0"
					BANCS.INPUT.score ="100"

					
					CALL("polarismn001.scr")
					print(CUST.CATOD.numOfValues)
					print(sv_c)
					IF ((CINT(CUST.CATOD.numOfValues) == 2 ) AND (sv_c == 0)) THEN
					#{
						sv_s = "echo" + " '" +  CUST.CATOD.recBackUp + "||||' >>" + " " + CUST.CATOD.successlogFile
						sv_d = system(sv_s)
						print(sv_d)
						#}
					ELSE
						#{
						GOTO INVALID
					#}
					ENDIF

					IF (CUST.CATOD.errColl != "") THEN
					#{
						GOTO INVALID
					#}
					ENDIF
				INVALID:
					print(sv_c)
					IF (sv_c  != 0 ) THEN
					#{
						
						CUST.CATOD.error = CUST.CATOD.recBackUp + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				RECORDSEXCEED:
					IF (sv_c  != 0 ) THEN
					#{
						CUST.CATOD.error = CUST.CATOD.fieldData1 + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				NEXTREC:
					#=================================================================================*
					# Reading the data from CSV file
					#=================================================================================*
					print(CUST.CATOD.fileindex)
					sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")
					print(sv_x)
					print(sv_n)
					CUST.CATOD.recCnt = sv_n
					sv_n = CINT(CUST.CATOD.recCnt) + 1
					CUST.CATOD.recCnt = sv_n
					sv_n = CUST.CATOD.recCnt
					print(sv_n)
				#}
				DO
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Upload Process Initiated Success fully - Check status in HPR after some time "
				print(sv_g)
				sv_z = urhk_SetOrbOut(sv_g)
				print(sv_z)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_e = "File Opened but Unable to Read."
				sv_m = "fileName"
				CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				GOTO FAILURE
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_e = "Not able to open the file for upload."
			sv_m = "fileName"
			CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
			GOTO FAILURE
		#}
		ENDIF
		
	FAILURE:
		sv_z = "SuccessOrFailure|N"
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		sv_z = CUST.CATOD.errMsg
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		
		
	ENDOFSCRIPT:
		
		IF (CUST.CATOD.errMsg == "") THEN
		#{
			#==========================================================================*
			#Pushing the Reports to HPR menu
			#==========================================================================*
			#-----------------------------------
			# Report Generation
			#-----------------------------------
			
			sv_b = urhk_getEnv("FIN_REPORTS_DIR")
			print(sv_b)
			IF (sv_b==0) THEN
			#{
				CUST.CATOD.envValue = BANCS.OUTPARAM.envValue
				print(CUST.CATOD.envValue)
			#}
			ENDIF
			
			CUST.CATOD.envValue =CUST.CATOD.envValue
			print(CUST.CATOD.envValue)
			
			#sv_a = urhk_B2K_printRepos("CUST")
			#print(sv_a)
			
			#-----------------------------------
			# Success Report
			#-----------------------------------
			sv_s = "mrbx4004 $B2K_SESSION_ID PolarisUploadSuc.mrt " + CUST.CATOD.successlogFile + " " + CUST.CATOD.successlogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.successlogFile = CUST.CATOD.successlogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/" + BANCS.STDIN.userId  +"/" + CUST.CATOD.successlogFile+  " 'SUCCESS UPLOAD REPORT FOR POLARIS' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			#-----------------------------------
			# Failure Report
			#-----------------------------------
			
			sv_s = "mrbx4004 $B2K_SESSION_ID PolarisUploadFai.mrt " + CUST.CATOD.failurelogFile + " " + CUST.CATOD.failurelogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.failurelogFile = CUST.CATOD.failurelogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/"+ BANCS.STDIN.userId +"/"+CUST.CATOD.failurelogFile+" 'FAILURE UPLOAD REPORT FOR POLARIS' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			
		#}
		ENDIF
		
		EXITSCRIPT
END-->
