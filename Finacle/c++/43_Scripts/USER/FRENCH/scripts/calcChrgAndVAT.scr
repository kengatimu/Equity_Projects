						print(sv_q)
						
						if(sv_q != 0)then
							CHRG.TXN.ttb_OutputAmount = ""
							CHRG.TXN.ttb_Rate = ""
						else
							PRINT(BANCS.OUTPARAM.OutputAmount)
							PRINT(BANCS.OUTPARAM.Rate)
							CHRG.TXN.ttb_OutputAmount = TRIM(BANCS.OUTPARAM.OutputAmount)
							CHRG.TXN.ttb_Rate = TRIM(BANCS.OUTPARAM.Rate)
						endif
						
						CUST.ATM.amount = sv_r
						sv_a = sv_b
						sv_b = "EUR"
						sv_c = "TTB"
						
						BANCS.INPARAM.InputAmount = CHRG.TXN.ttb_OutputAmount
						BANCS.INPARAM.FromCurrency = "CDF"
						BANCS.INPARAM.ToCurrency = CHRG.TXN.crncy
						BANCS.INPARAM.RateCode = "TTB"
						BANCS.INPARAM.Rate = CDOUBLE("0.0")
						
						sv_q = urhk_B2K_ConvertAmount("")
						print(sv_q)
						
						if(sv_q != 0)then
							CHRG.TXN.ttb_OutputAmount = ""
							CHRG.TXN.ttb_Rate = ""
						else
							PRINT(BANCS.OUTPARAM.OutputAmount)
							PRINT(BANCS.OUTPARAM.Rate)
							CHRG.TXN.ttb_OutputAmount = TRIM(BANCS.OUTPARAM.OutputAmount)
							CHRG.TXN.ttb_Rate = TRIM(BANCS.OUTPARAM.Rate)
						endif
						
						CHRG.TXN.minAmt = CHRG.TXN.ttb_OutputAmount
						PRINT(CHRG.TXN.minAmt)
					#}
					ENDIF
					
					PRINT(CHRG.TXN.temp)
					PRINT(CHRG.TXN.minAmt)
					PRINT(CHRG.TXN.maxAmt)
					
					IF((CHRG.TXN.minInd == "Y") AND (CHRG.TXN.minAmt != ""))THEN
					#{
						lv_s = "minCheck| SELECT CASE WHEN TO_NUMBER('"+CHRG.TXN.temp+"') < TO_NUMBER('"+CHRG.TXN.minAmt+"') THEN 'L' ELSE 'G' END FROM DUAL"
						print(lv_s)
						lv_q = urhk_dbSelectWithBind(lv_s)
						print(lv_q)
						
						CHRG.TXN.minCheck = ""
						
						IF(lv_q ==0)THEN
							CHRG.TXN.minCheck = BANCS.OUTPARAM.minCheck
						ENDIF
						
						IF(CHRG.TXN.minCheck == "L")THEN
							CHRG.TXN.temp = CHRG.TXN.minAmt
						ENDIF
						
						#IF(CHRG.TXN.temp < CHRG.TXN.minAmt)THEN
						##{
						#	CHRG.TXN.temp = CHRG.TXN.minAmt
						##}
						#ENDIF
					#}
					ENDIF
					
					lv_s = "maxCheck| SELECT CASE WHEN TO_NUMBER('"+CHRG.TXN.temp+"') > TO_NUMBER('"+CHRG.TXN.maxAmt+"') THEN 'G' ELSE 'L' END FROM DUAL"
					print(lv_s)
					lv_q = urhk_dbSelectWithBind(lv_s)
					print(lv_q)
					
					CHRG.TXN.maxCheck = ""
					
					IF(lv_q ==0)THEN
						CHRG.TXN.maxCheck = BANCS.OUTPARAM.maxCheck
					ENDIF
					
					IF(CHRG.TXN.maxCheck == "G")THEN
						CHRG.TXN.temp = CHRG.TXN.maxAmt
					ENDIF
					
					#IF(CHRG.TXN.temp >CHRG.TXN.maxAmt) THEN
					##{
					#	CHRG.TXN.temp = CHRG.TXN.maxAmt
					##}
					#ENDIF
					
					CHRG.TXN.vatAmt =CDOUBLE(CHRG.TXN.vatAmt) + CDOUBLE(CHRG.TXN.temp)
					print(CHRG.TXN.chrgAmt)
					CHRG.TXN.evntVATCrncy = BANCS.OUTPARAM.maxAmtCrncy
				#}
				ENDIF
			#}
			ENDIF
			
			sv_s  = "vatScrName|select file_name from tbaadm.ptt, tbaadm.adm where ptt.bank_id=?SVAR and ptt.bank_id = adm.bank_id"
			sv_s = sv_s + " and event_type = ?SVAR and event_id = ?SVAR and"
			sv_s = sv_s + " ptt.amt_derv_srl_num = adm.amt_drv_srl_num and adm.amt_ind='S' and ptt.ENTITY_CRE_FLG='Y' "
			sv_s = sv_s + " and ptt.ENTITY_CRE_FLG = adm.ENTITY_CRE_FLG and ptt.DEL_FLG = 'N' and ptt.DEL_FLG = adm.DEL_FLG"
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + "LNKED" + "|" + CHRG.TXN.lnkdEvntId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
			#{
				print(BANCS.OUTPARAM.vatScrName)
				
				BANCS.INPUT.inputCrncy = CHRG.TXN.evntChrgCrncy
				BANCS.INPUT.inputAmount = CHRG.TXN.chrgAmt
				BANCS.INPUT.entityId = CHRG.TXN.acid
				
				BANCS.INPUT.chrgCollCrncy = CHRG.TXN.crncy
				BANCS.INPUT.CallMode = "SCRIPT"
				CALL(BANCS.OUTPARAM.vatScrName)
				CUST.VAT.vatcollAmount = BANCS.OUTPUT.collAmount
				print(CUST.VAT.vatcollAmount)
				CHRG.TXN.vatAmt = CDOUBLE(CHRG.TXN.vatAmt) +  CDOUBLE(CUST.VAT.vatcollAmount)
				#CHRG.TXN.vatAmt = CHRG.TXN.vatAmt +  CUST.VAT.vatcollAmount
				print(CHRG.TXN.vatAmt)

				sv_y = GETPOSITION(CHRG.TXN.vatAmt, ".")
				PRINT(sv_y)

				IF(sv_y > 0)THEN
				#{
				sv_w = MID$(CHRG.TXN.vatAmt,0, sv_y - 1)
				PRINT(sv_w)
				sv_x = MID$(CHRG.TXN.vatAmt,sv_y,2)
				PRINT(sv_x)

				CHRG.TXN.vatAmt = sv_w+"."+sv_x
				PRINT(CHRG.TXN.vatAmt)
				#}
				ENDIF					

				print(BANCS.OUTPUT.collCrncy)
				#CHRG.TXN.evntVATCrncy = BANCS.OUTPUT.collCrncy
				CHRG.TXN.evntVATCrncy = CHRG.TXN.crncy
			#}
			ENDIF
			
			IF((CHRG.TXN.isCorporate == "G") OR (CHRG.TXN.isPSI =="G"))THEN
			#{
				sv_s = "amt_ind_1, amt_pcnt_1, fixed_amt_1, file_name_1, min_eq_amt_1, max_eq_amt_1, maxAmtCrncy_1|"
				sv_s = sv_s + " SELECT AMT_IND, AMT_PCNT, FIXED_AMT, FILE_NAME, MIN_EQ_AMT, MAX_EQ_AMT, MAX_EQ_CRNCY FROM TBAADM.ADM WHERE AMT_DRV_SRL_NUM in ( "
				sv_s = sv_s + " SELECT AMT_DERV_SRL_NUM FROM TBAADM.PTT WHERE EVENT_TYPE = 'LNKED' AND EVENT_ID IN ( "
				sv_s = sv_s + " SELECT LINKED_EVENT_ID FROM TBAADM.PTT WHERE BANK_ID= ?SVAR AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR)) "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CHRG.TXN.eventType + "|" + CHRG.TXN.eventId
				
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF(sv_d == 0) THEN
				#{
					print(BANCS.OUTPARAM.amt_ind_1)
					print(BANCS.OUTPARAM.amt_pcnt_1)
					print(BANCS.OUTPARAM.fixed_amt_1)
					print(BANCS.OUTPARAM.file_name_1)
					print(BANCS.OUTPARAM.min_eq_amt_1)
					print(BANCS.OUTPARAM.max_eq_amt_1)
					print(BANCS.OUTPARAM.maxAmtCrncy_1)
					CHRG.TXN.amt_ind_1 = BANCS.OUTPARAM.amt_ind_1
					CHRG.TXN.amt_pcnt_1 = BANCS.OUTPARAM.amt_pcnt_1
					CHRG.TXN.fixed_amt_1 = BANCS.OUTPARAM.fixed_amt_1
					CHRG.TXN.file_name_1 = BANCS.OUTPARAM.file_name_1
					CHRG.TXN.min_eq_amt_1 = BANCS.OUTPARAM.min_eq_amt_1
					CHRG.TXN.max_eq_amt_1 = BANCS.OUTPARAM.max_eq_amt_1
					CHRG.TXN.maxAmtCrncy_1 = BANCS.OUTPARAM.maxAmtCrncy_1
					
					IF(CHRG.TXN.amt_ind_1 == "F")THEN
					#{
						CHRG.TXN.vatAmt =  CDOUBLE(CHRG.TXN.fixed_amt_1)
						CHRG.TXN.evntVATCrncy = CUST.DATA.crncy
					#}
					ENDIF
					
					IF(CHRG.TXN.amt_ind_1 == "P")THEN
					#{
						print(CHRG.TXN.amt_pcnt_1)
						CHRG.TXN.temp = (CDOUBLE(CHRG.TXN.chrgAmt) * CDOUBLE(CHRG.TXN.amt_pcnt_1)) / 100
						
						IF((BANCS.OUTPARAM.minInd == "Y") AND (CHRG.TXN.min_eq_amt_1 != ""))THEN
						#{
							IF(CHRG.TXN.temp < CHRG.TXN.min_eq_amt_1)THEN
							#{
								CHRG.TXN.temp = CHRG.TXN.min_eq_amt_1
							#}
							ENDIF
						#}
						ENDIF
						
						IF(CHRG.TXN.temp >CHRG.TXN.max_eq_amt_1) THEN
						#{
							CHRG.TXN.temp = CHRG.TXN.max_eq_amt_1
						#}
						ENDIF
						
						CHRG.TXN.vatAmt =CDOUBLE(CHRG.TXN.vatAmt) + CDOUBLE(CHRG.TXN.temp)
						print(CHRG.TXN.chrgAmt)
						CHRG.TXN.evntVATCrncy = CHRG.TXN.maxAmtCrncy_1
					#}
					ENDIF
					
					IF(CHRG.TXN.amt_ind_1 == "S")THEN
					#{
						sv_u = urhk_B2k_ForacidToAcid(CHRG.TXN.acctId)
						print(sv_u)
						
						IF(sv_u == 0)THEN
						#{
							PRINT(BANCS.OUTPARAM.Acid)
							CHRG.TXN.acid= BANCS.OUTPARAM.Acid
							PRINT(CHRG.TXN.acid)
							#}
						ELSE
							#{
							CHRG.TXN.errorFlg ="Y"
							CHRG.TXN.errorMsg ="Unable to Get the Acid!"
							GOTO ENDOFSCRIPT
						#}
						ENDIF
						BANCS.INPUT.inputCrncy = CHRG.TXN.evntChrgCrncy
						BANCS.INPUT.inputAmount = CHRG.TXN.chrgAmt
						BANCS.INPUT.entityId = CHRG.TXN.acid
						
						BANCS.INPUT.chrgCollCrncy = CHRG.TXN.crncy
						BANCS.INPUT.CallMode = "SCRIPT"
						
						PRINT(CHRG.TXN.vatAmt)
						IF(CHRG.TXN.vatAmt == "0")THEN
						#{
							CALL(CHRG.TXN.file_name_1)
						
							CUST.VAT.vatcollAmount = BANCS.OUTPUT.collAmount
							print(CUST.VAT.vatcollAmount)
							CHRG.TXN.vatAmt = CDOUBLE(CHRG.TXN.vatAmt) +  CDOUBLE(CUST.VAT.vatcollAmount)
							#CHRG.TXN.vatAmt = CHRG.TXN.vatAmt +  CUST.VAT.vatcollAmount
							print(CHRG.TXN.vatAmt)

							sv_y = GETPOSITION(CHRG.TXN.vatAmt, ".")
							PRINT(sv_y)

							IF(sv_y > 0)THEN
							#{
							sv_w = MID$(CHRG.TXN.vatAmt,0, sv_y - 1)
							PRINT(sv_w)
							sv_x = MID$(CHRG.TXN.vatAmt,sv_y,2)
							PRINT(sv_x)

							CHRG.TXN.vatAmt = sv_w+"."+sv_x
							PRINT(CHRG.TXN.vatAmt)
							#}
							ENDIF					

							print(BANCS.OUTPUT.collCrncy)
							#CHRG.TXN.evntVATCrncy = BANCS.OUTPUT.collCrncy
							CHRG.TXN.evntVATCrncy = CHRG.TXN.crncy
						#}
						ENDIF
					#}
					ENDIF
					
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		CHRG.TXN.lnkdEvntId = ""
		sv_z = urhk_dbCursorFetch(sv_m)
		PRINT(sv_z)
	#}
	DO

		sv_z = urhk_dbCursorClose(sv_m)
		
Fetch_ScrName:

		IF(sv_f == "Y")THEN
		#{
			GOTO ENDOFSCRIPT_BAL_CHECK
		#}
		ENDIF
		
		sv_s  = "scrName,lnkdEvntId,srl_num|select file_name,linked_event_id,ptt.srl_num from tbaadm.ptt, tbaadm.adm "
		sv_s = sv_s + " where ptt.bank_id=?SVAR and ptt.bank_id = adm.bank_id  and event_type = ?SVAR and event_id = ?SVAR"
		sv_s = sv_s + " and ptt.amt_derv_srl_num = adm.amt_drv_srl_num and adm.amt_ind='S' and ptt.ENTITY_CRE_FLG='Y'"
		sv_s = sv_s + " and ptt.ENTITY_CRE_FLG = adm.ENTITY_CRE_FLG and ptt.DEL_FLG = 'N' and ptt.DEL_FLG = adm.DEL_FLG"
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CHRG.TXN.eventType + "|" + CHRG.TXN.eventId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_r = urhk_dbCursorOpenWithBind(sv_s)
		PRINT(sv_r)
		
		IF (sv_r != 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		PRINT(sv_m)
		sv_z = urhk_dbCursorFetch(sv_m)
		
		WHILE (sv_z != 1)
		#{
			print(BANCS.OUTPARAM.scrName)
			print(BANCS.OUTPARAM.srl_num)
			print(BANCS.OUTPARAM.lnkdEvntId)
			CHRG.TXN.lnkdEvntId = BANCS.OUTPARAM.lnkdEvntId
			BANCS.INPUT.inputAmount = CHRG.TXN.refAmt
			if(((CHRG.TXN.tranSubType == "PI") AND (CHRG.TXN.tranType == "C")))then
				#BANCS.INPUT.inputAmount = BANCS.INPUT.refAmt
				BANCS.INPUT.inputAmount = CHRG.TXN.refAmt
			else
				BANCS.INPUT.inputAmount = CHRG.TXN.refAmt
			endif			
			BANCS.STDIN.ScriptName = BANCS.OUTPARAM.scrName
			BANCS.INPUT.CallMode = "SCRIPT"
			if(((CHRG.TXN.tranSubType == "PI") AND (CHRG.TXN.tranType == "C")))then
				BANCS.INPUT.chrgCollCrncy = CHRG.TXN.crncy
			else
				#BANCS.INPUT.chrgCollCrncy = CHRG.TXN.refcrncy
				BANCS.INPUT.chrgCollCrncy = CHRG.TXN.refCrncy
			endif
			
			
			IF(CHRG.TXN.eventId == "CLTRF")THEN
			#{
				CUST.DATA.ODacnt = CHRG.TXN.acctId
			#}
			ENDIF

			CALL(BANCS.OUTPARAM.scrName)
			CUST.DATA.chrgAmt = BANCS.OUTPUT.collAmount
			PRINT(CUST.DATA.chrgAmt)
			CHRG.TXN.chrgAmt =  CDOUBLE(CHRG.TXN.chrgAmt) +  CDOUBLE(CUST.DATA.chrgAmt)
			print(CHRG.TXN.chrgAmt)
			print(BANCS.OUTPUT.collCrncy)
			#CHRG.TXN.evntChrgCrncy = BANCS.OUTPUT.collCrncy
			CHRG.TXN.evntChrgCrncy = CUST.DATA.crncy
			
			IF(CHRG.TXN.lnkdEvntId != "")THEN
			#{
				IF(CUST.DATA.chrg_Amt != "NULL")THEN
				#{
					CHRG.TXN.chrgAmt = CUST.DATA.chrg_Amt
				#}
				ENDIF
				sv_s  = "vatScrName|select file_name from tbaadm.ptt, tbaadm.adm where ptt.bank_id=?SVAR and ptt.bank_id = adm.bank_id"
				sv_s = sv_s + " and event_type = ?SVAR and event_id = ?SVAR and"
				sv_s = sv_s + " ptt.amt_derv_srl_num = adm.amt_drv_srl_num and adm.amt_ind='S' and ptt.ENTITY_CRE_FLG='Y' "
				sv_s = sv_s + " and ptt.ENTITY_CRE_FLG = adm.ENTITY_CRE_FLG and ptt.DEL_FLG = 'N' and ptt.DEL_FLG = adm.DEL_FLG"
				
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + "LNKED" + "|" + CHRG.TXN.lnkdEvntId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF(sv_d == 0) THEN
				#{
					print(BANCS.OUTPARAM.vatScrName)
					
					BANCS.INPUT.inputCrncy = CHRG.TXN.evntChrgCrncy
					BANCS.INPUT.inputAmount = CUST.DATA.chrgAmt
					BANCS.INPUT.entityId = CHRG.TXN.acid
					
					BANCS.INPUT.chrgCollCrncy = CHRG.TXN.crncy
					BANCS.INPUT.CallMode = "SCRIPT"
					CALL(BANCS.OUTPARAM.vatScrName)
					CUST.VAT.vatcollAmount = BANCS.OUTPUT.collAmount
					print(CUST.VAT.vatcollAmount)
					CHRG.TXN.vatAmt = CDOUBLE(CHRG.TXN.vatAmt) +  CDOUBLE(CUST.VAT.vatcollAmount)
					#CHRG.TXN.vatAmt = CHRG.TXN.vatAmt +  CUST.VAT.vatcollAmount
					print(CHRG.TXN.vatAmt)

					sv_y = GETPOSITION(CHRG.TXN.vatAmt, ".")
					PRINT(sv_y)

					IF(sv_y > 0)THEN
					#{
					sv_w = MID$(CHRG.TXN.vatAmt,0, sv_y - 1)
					PRINT(sv_w)
					sv_x = MID$(CHRG.TXN.vatAmt,sv_y,2)
					PRINT(sv_x)

					CHRG.TXN.vatAmt = sv_w+"."+sv_x
					PRINT(CHRG.TXN.vatAmt)
					#}
					ENDIF					

					print(BANCS.OUTPUT.collCrncy)
					#CHRG.TXN.evntVATCrncy = BANCS.OUTPUT.collCrncy
					CHRG.TXN.evntVATCrncy = CUST.DATA.crncy
				#}
				ENDIF
			#}
			ENDIF
			
			CHRG.TXN.lnkdEvntId = ""
			PRINT(sv_m)
			sv_z = urhk_dbCursorFetch(sv_m)
			PRINT(sv_z)
		#}
		DO
		sv_z = urhk_dbCursorClose(sv_m)
		
		ENDOFSCRIPT_BAL_CHECK:
		sv_u = urhk_getAcctDetailsInRepository(CHRG.TXN.acctId)
		PRINT(sv_u)
		
		IF(sv_u == 0)THEN
		#{
			CHRG.TXN.avblAmt = BANCS.OUTPARAM.EffAvailableAmt
			PRINT(CHRG.TXN.avblAmt)
		#}
		ENDIF
		
		#--------------------------------------------
		lv_x = 0
		IF(FIELDEXISTS(CHRG.TXN.refCrncy))THEN
			PRINT(CHRG.TXN.refCrncy)
			lv_x = lv_x + 1
		ENDIF
		IF(FIELDEXISTS(CHRG.TXN.tranType))THEN
			PRINT(CHRG.TXN.tranType)
			lv_x = lv_x + 1
		ENDIF
		IF(FIELDEXISTS(CHRG.TXN.tranSubType))THEN
			PRINT(CHRG.TXN.tranSubType)
			lv_x = lv_x + 1
		ENDIF
		
		IF(lv_x > 2)THEN
		#{
			sv_n = urhk_getAcctDetailsInRepository(CHRG.TXN.acctId)
			IF (sv_n != 0)THEN
			#{
				CHRG.TXN.acct_crncy = BANCS.STDIN.homeCrncyCode
			#}
			ELSE
			#{
				CHRG.TXN.acct_crncy = BANCS.OUTPARAM.acctCrncyCode
			#}
			ENDIF
			
			PRINT(CHRG.TXN.acct_crncy)
			#IF((CHRG.TXN.refCrncy == "CDF") AND (CHRG.TXN.tranType == "C") AND (CHRG.TXN.tranSubType == "NP"))THEN
			IF((CHRG.TXN.acct_crncy == "CDF") AND (CHRG.TXN.tranType == "C"))THEN
				PRINT("No charges for OTC withdraw on CDF acct")
				CHRG.TXN.vatAmt = 0
				CHRG.TXN.chrgAmt = 0
			ENDIF
		#}
		ENDIF
		#--------------------------------------------

		CHRG.TXN.totalAmt = CDOUBLE(CHRG.TXN.refAmt) + CDOUBLE(CHRG.TXN.chrgAmt) + CDOUBLE(CHRG.TXN.vatAmt) 
		PRINT (CHRG.TXN.chrgAmt)
		CHRG.TXN.chrgAmt = FORMAT$(CDOUBLE(CHRG.TXN.chrgAmt),"%.2f")
		PRINT (CHRG.TXN.chrgAmt)
		
		PRINT (CHRG.TXN.chrgAmt)
		CHRG.TXN.chrgAmt = FORMAT$(CDOUBLE(CHRG.TXN.chrgAmt),"%.2f")
		PRINT (CHRG.TXN.chrgAmt)


		PRINT(CHRG.TXN.totalAmt)
		IF(CDOUBLE(CHRG.TXN.totalAmt) > CDOUBLE(CHRG.TXN.avblAmt))THEN
		#{
			CHRG.TXN.balcheck = "N"
		#}
		ENDIF
		
		#-----------------------------------------------------START
		# Checking for unverified/entered transactions
		
		#lv_s = "bal_amt, tran_dr, tran_cr, eff_balance|"
		#lv_s = lv_s + " SELECT "
		#lv_s = lv_s + " '"+TRIM(CHRG.TXN.avblAmt)+"'AS CLR_BAL_AMT, "
		#lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'D' THEN DTD.TRAN_AMT END), 0) AS TRAN_DR, "
		#lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'C' THEN DTD.TRAN_AMT END), 0) AS TRAN_CR, "
		#lv_s = lv_s + " ('"+TRIM(CHRG.TXN.avblAmt)+"' + COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'C' THEN DTD.TRAN_AMT END), 0) " 
		#lv_s = lv_s + " - COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'D' THEN DTD.TRAN_AMT END), 0)) AS EFFECTIVE_AVAILABLE_BALANCE "
		#lv_s = lv_s + " FROM TBAADM.GAM "
		#lv_s = lv_s + " JOIN TBAADM.DTD ON GAM.ACID = DTD.ACID "
		#lv_s = lv_s + " WHERE GAM.FORACID = '"+CHRG.TXN.acctId+"' AND DTD.PSTD_FLG = 'N' AND DTD.DEL_FLG = 'N' "
		#lv_s = lv_s + " AND GAM.BANK_ID = '"+BANCS.STDIN.contextBankId+"' AND DTD.BANK_ID = GAM.BANK_ID "
		#lv_s = lv_s + " GROUP BY GAM.CLR_BAL_AMT "
		
		lv_s = "bal_amt, tran_dr, tran_cr, eff_balance, minimum_balance, eff_available_balance|"
		lv_s = lv_s + " WITH DTD_SUM AS ( "
		lv_s = lv_s + " SELECT GAM.ACID, '"+TRIM(CHRG.TXN.avblAmt)+"' AS CLR_BAL_AMT, "
		lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'D' THEN DTD.TRAN_AMT END), 0) AS TRAN_DR, "
		lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'C' THEN DTD.TRAN_AMT END), 0) AS TRAN_CR "
		lv_s = lv_s + " FROM TBAADM.GAM GAM LEFT JOIN TBAADM.DTD DTD " 
		lv_s = lv_s + " ON GAM.ACID = DTD.ACID AND DTD.PSTD_FLG = 'N' AND DTD.DEL_FLG = 'N' AND DTD.BANK_ID = GAM.BANK_ID "
		lv_s = lv_s + " WHERE GAM.FORACID = '"+CHRG.TXN.acctId+"' AND GAM.BANK_ID = '"+BANCS.STDIN.contextBankId+"' GROUP BY GAM.ACID), "
		lv_s = lv_s + " MIN_BAL AS (SELECT GAM.ACID, COALESCE(S.ACCT_MIN_BALANCE, 0) AS MIN_BAL " 
		lv_s = lv_s + " FROM TBAADM.GAM GAM LEFT JOIN TBAADM.GSP G ON G.SCHM_CODE = GAM.SCHM_CODE AND G.BANK_ID = GAM.BANK_ID "
		lv_s = lv_s + " LEFT JOIN TBAADM.CRNCY_SCHM_PARM_TBL S ON S.SCHM_CODE = G.SCHM_CODE AND S.CRNCY_CODE = GAM.ACCT_CRNCY_CODE "
		lv_s = lv_s + " AND S.BANK_ID = G.BANK_ID LEFT JOIN TBAADM.EXCEPTION_CODE_TABLE E ON E.EXCP_CODE = G.BEL_MIN_BAL_EXCP_CODE " 
		lv_s = lv_s + " AND E.BANK_ID = G.BANK_ID AND E.DEL_FLG = 'N' WHERE GAM.FORACID = '"+CHRG.TXN.acctId+"' AND GAM.BANK_ID = '"+BANCS.STDIN.contextBankId+"') "
		lv_s = lv_s + " SELECT D.CLR_BAL_AMT, D.TRAN_DR, D.TRAN_CR, "
		lv_s = lv_s + " (D.CLR_BAL_AMT + D.TRAN_CR - D.TRAN_DR) AS EFFECTIVE_AVAILABLE_BALANCE, "
		lv_s = lv_s + " M.MIN_BAL AS MINIMUM_BALANCE, "
		lv_s = lv_s + " (D.CLR_BAL_AMT + D.TRAN_CR - D.TRAN_DR - M.MIN_BAL) AS FINAL_AVAILABLE_BALANCE "
		lv_s = lv_s + " FROM DTD_SUM D LEFT JOIN MIN_BAL M ON D.ACID = M.ACID "
		
		PRINT(lv_s)
		lv_q = urhk_dbSelectWithBind(lv_s)
		PRINT(lv_q)
		
		IF(lv_q == 0)THEN
		#{
			CHRG.TXN.bal_amt = BANCS.OUTPARAM.bal_amt
			PRINT(CHRG.TXN.bal_amt)
			CHRG.TXN.tran_dr = BANCS.OUTPARAM.tran_dr
			PRINT(CHRG.TXN.tran_dr)
			CHRG.TXN.tran_cr = BANCS.OUTPARAM.tran_cr
			PRINT(CHRG.TXN.tran_cr)
			CHRG.TXN.eff_balance = BANCS.OUTPARAM.eff_balance
			PRINT(CHRG.TXN.eff_balance)
			CHRG.TXN.minimum_balance = BANCS.OUTPARAM.minimum_balance
			PRINT(CHRG.TXN.minimum_balance)
			CHRG.TXN.eff_available_balance = BANCS.OUTPARAM.eff_available_balance
			PRINT(CHRG.TXN.eff_available_balance)
			
			PRINT(CHRG.TXN.totalAmt)
			PRINT(CHRG.TXN.newRefAmt)
			#IF(CDOUBLE(CHRG.TXN.totalAmt) > (CHRG.TXN.eff_balance))THEN
			IF(CDOUBLE(CHRG.TXN.totalAmt) > (CHRG.TXN.eff_available_balance))THEN
			#{
				CHRG.TXN.balcheck = "N"
			#}
			ENDIF
		#}
		ELSE
		#{
			PRINT("SELECT ERROR OCCURRED")
		#}
		ENDIF
		
		#-----------------------------------------------------END
		
	ENDOFSCRIPT:
	
		IF(FIELDEXISTS(CHRG.TXN.refAmt))THEN
			IF(TRIM(CHRG.TXN.refAmt) != "")THEN
				PRINT(CHRG.TXN.refAmt)
			ELSE
				GOTO ENDOFSCRIPT2
			ENDIF
		ELSE
			GOTO ENDOFSCRIPT2
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.refAmt))THEN
			IF(TRIM(BANCS.INPUT.refAmt) != "")THEN
				PRINT(BANCS.INPUT.refAmt)
			ELSE
				GOTO ENDOFSCRIPT2
			ENDIF
		ELSE
			GOTO ENDOFSCRIPT2
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.acctId))THEN
			IF(TRIM(BANCS.INPUT.acctId) != "")THEN
				PRINT(BANCS.INPUT.acctId)
			ELSE
				GOTO ENDOFSCRIPT2
			ENDIF
		ELSE
			GOTO ENDOFSCRIPT2
		ENDIF
	
		PRINT(CHRG.TXN.refAmt)
		PRINT(BANCS.INPUT.refAmt)
		PRINT(BANCS.INPUT.acctId)
		#IF(CHRG.TXN.refAmt == "0")THEN
		IF((CHRG.TXN.refAmt == "0") OR (sv_h == "Y"))THEN
		#{
			sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.acctId)
			PRINT(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				CHRG.TXN.avblAmt = BANCS.OUTPARAM.EffAvailableAmt
				PRINT(CHRG.TXN.avblAmt)
			#}
			ENDIF
			
			#lv_s = "bal_amt, tran_dr, tran_cr, eff_balance|"
			#lv_s = lv_s + " SELECT "
			#lv_s = lv_s + " '"+TRIM(CHRG.TXN.avblAmt)+"'AS CLR_BAL_AMT, "
			#lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'D' THEN DTD.TRAN_AMT END), 0) AS TRAN_DR, "
			#lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'C' THEN DTD.TRAN_AMT END), 0) AS TRAN_CR, "
			#lv_s = lv_s + " ('"+TRIM(CHRG.TXN.avblAmt)+"' + COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'C' THEN DTD.TRAN_AMT END), 0) " 
			#lv_s = lv_s + " - COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'D' THEN DTD.TRAN_AMT END), 0)) AS EFFECTIVE_AVAILABLE_BALANCE "
			#lv_s = lv_s + " FROM TBAADM.GAM "
			#lv_s = lv_s + " JOIN TBAADM.DTD ON GAM.ACID = DTD.ACID "
			#lv_s = lv_s + " WHERE GAM.FORACID = '"+BANCS.INPUT.acctId+"' AND DTD.PSTD_FLG = 'N' AND DTD.DEL_FLG = 'N' "
			#lv_s = lv_s + " AND GAM.BANK_ID = '"+BANCS.STDIN.contextBankId+"' AND DTD.BANK_ID = GAM.BANK_ID "
			#lv_s = lv_s + " GROUP BY GAM.CLR_BAL_AMT "
			
			lv_s = "bal_amt, tran_dr, tran_cr, eff_balance, minimum_balance, eff_available_balance|"
			lv_s = lv_s + " WITH DTD_SUM AS ( "
			lv_s = lv_s + " SELECT GAM.ACID, '"+TRIM(CHRG.TXN.avblAmt)+"' AS CLR_BAL_AMT, "
			lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'D' THEN DTD.TRAN_AMT END), 0) AS TRAN_DR, "
			lv_s = lv_s + " COALESCE(SUM(CASE WHEN DTD.PART_TRAN_TYPE = 'C' THEN DTD.TRAN_AMT END), 0) AS TRAN_CR "
			lv_s = lv_s + " FROM TBAADM.GAM GAM LEFT JOIN TBAADM.DTD DTD " 
			lv_s = lv_s + " ON GAM.ACID = DTD.ACID AND DTD.PSTD_FLG = 'N' AND DTD.DEL_FLG = 'N' AND DTD.BANK_ID = GAM.BANK_ID "
			lv_s = lv_s + " WHERE GAM.FORACID = '"+BANCS.INPUT.acctId+"' AND GAM.BANK_ID = '"+BANCS.STDIN.contextBankId+"' GROUP BY GAM.ACID), "
			lv_s = lv_s + " MIN_BAL AS (SELECT GAM.ACID, COALESCE(S.ACCT_MIN_BALANCE, 0) AS MIN_BAL " 
			lv_s = lv_s + " FROM TBAADM.GAM GAM LEFT JOIN TBAADM.GSP G ON G.SCHM_CODE = GAM.SCHM_CODE AND G.BANK_ID = GAM.BANK_ID "
			lv_s = lv_s + " LEFT JOIN TBAADM.CRNCY_SCHM_PARM_TBL S ON S.SCHM_CODE = G.SCHM_CODE AND S.CRNCY_CODE = GAM.ACCT_CRNCY_CODE "
			lv_s = lv_s + " AND S.BANK_ID = G.BANK_ID LEFT JOIN TBAADM.EXCEPTION_CODE_TABLE E ON E.EXCP_CODE = G.BEL_MIN_BAL_EXCP_CODE " 
			lv_s = lv_s + " AND E.BANK_ID = G.BANK_ID AND E.DEL_FLG = 'N' WHERE GAM.FORACID = '"+BANCS.INPUT.acctId+"' AND GAM.BANK_ID = '"+BANCS.STDIN.contextBankId+"') "
			lv_s = lv_s + " SELECT D.CLR_BAL_AMT, D.TRAN_DR, D.TRAN_CR, "
			lv_s = lv_s + " (D.CLR_BAL_AMT + D.TRAN_CR - D.TRAN_DR) AS EFFECTIVE_AVAILABLE_BALANCE, "
			lv_s = lv_s + " M.MIN_BAL AS MINIMUM_BALANCE, "
			lv_s = lv_s + " (D.CLR_BAL_AMT + D.TRAN_CR - D.TRAN_DR - M.MIN_BAL) AS FINAL_AVAILABLE_BALANCE "
			lv_s = lv_s + " FROM DTD_SUM D LEFT JOIN MIN_BAL M ON D.ACID = M.ACID "

			
			PRINT(lv_s)
			lv_q = urhk_dbSelectWithBind(lv_s)
			PRINT(lv_q)
			
			IF(lv_q == 0)THEN
			#{
				CHRG.TXN.bal_amt = BANCS.OUTPARAM.bal_amt
				PRINT(CHRG.TXN.bal_amt)
				CHRG.TXN.tran_dr = BANCS.OUTPARAM.tran_dr
				PRINT(CHRG.TXN.tran_dr)
				CHRG.TXN.tran_cr = BANCS.OUTPARAM.tran_cr
				PRINT(CHRG.TXN.tran_cr)
				CHRG.TXN.eff_balance = BANCS.OUTPARAM.eff_balance
				PRINT(CHRG.TXN.eff_balance)
				CHRG.TXN.minimum_balance = BANCS.OUTPARAM.minimum_balance
				PRINT(CHRG.TXN.minimum_balance)
				CHRG.TXN.eff_available_balance = BANCS.OUTPARAM.eff_available_balance
				PRINT(CHRG.TXN.eff_available_balance)
				
				PRINT(BANCS.INPUT.refAmt)
				PRINT(CHRG.TXN.newRefAmt)
				#IF(CDOUBLE(BANCS.INPUT.refAmt) > (CHRG.TXN.eff_balance))THEN
				IF(CDOUBLE(BANCS.INPUT.refAmt) > (CHRG.TXN.eff_available_balance))THEN
				#{
					CHRG.TXN.balcheck = "N"
				#}
				ENDIF
			#}
			ELSE
			#{
				PRINT("SELECT ERROR OCCURRED")
			#}
			ENDIF
		#}
		ENDIF
		
		ENDOFSCRIPT2:
		
		#--------------------------------------------
		lv_x = 0
		IF(FIELDEXISTS(CHRG.TXN.refCrncy))THEN
			PRINT(CHRG.TXN.refCrncy)
			lv_x = lv_x + 1
		ENDIF
		IF(FIELDEXISTS(CHRG.TXN.tranType))THEN
			PRINT(CHRG.TXN.tranType)
			lv_x = lv_x + 1
		ENDIF
		IF(FIELDEXISTS(CHRG.TXN.tranSubType))THEN
			PRINT(CHRG.TXN.tranSubType)
			lv_x = lv_x + 1
		ENDIF
		
		IF(lv_x > 2)THEN
		#{
			IF(FIELDEXISTS(CHRG.TXN.acctId))THEN
			#{	
				sv_n = urhk_getAcctDetailsInRepository(CHRG.TXN.acctId)
				IF (sv_n != 0)THEN
				#{
					CHRG.TXN.acct_crncy = BANCS.STDIN.homeCrncyCode
				#}
				ELSE
				#{
					CHRG.TXN.acct_crncy = BANCS.OUTPARAM.acctCrncyCode
				#}
				ENDIF
			#}
			ELSE
			#{
				CHRG.TXN.acct_crncy = BANCS.STDIN.homeCrncyCode
			#}
			ENDIF
			
			PRINT(CHRG.TXN.acct_crncy)
			#IF((CHRG.TXN.refCrncy == "CDF") AND (CHRG.TXN.tranType == "C") AND (CHRG.TXN.tranSubType == "NP"))THEN
			IF((CHRG.TXN.acct_crncy == "CDF") AND (CHRG.TXN.tranType == "C"))THEN
				PRINT("No charges for OTC withdraw on CDF acct")
				CHRG.TXN.vatAmt = 0
				CHRG.TXN.chrgAmt = 0
			ENDIF
		#}
		ENDIF
		#--------------------------------------------
		
		
		CHRG.TXN.vatAmt = FORMAT$(CDOUBLE(CHRG.TXN.vatAmt),"%.2f")
		CHRG.TXN.chrgAmt = FORMAT$(CDOUBLE(CHRG.TXN.chrgAmt),"%.2f")
		
		IF(FIELDEXISTS(CHRG.TXN.acctId))THEN
		#{	
			sv_n = urhk_getAcctDetailsInRepository(CHRG.TXN.acctId)
			IF (sv_n != 0)THEN
			#{
				CHRG.TXN.crncy = BANCS.STDIN.homeCrncyCode
			#}
			ELSE
			#{
				CHRG.TXN.crncy = BANCS.OUTPARAM.acctCrncyCode
			#}
			ENDIF
		#}
		ELSE
		#{
			CHRG.TXN.crncy = BANCS.STDIN.homeCrncyCode
		#}
		ENDIF
		
		##sv_n = urhk_getAcctDetailsInRepository(CHRG.TXN.acctId)
		##IF (sv_n != 0)THEN
		###{
		##	CHRG.TXN.crncy = BANCS.STDIN.homeCrncyCode
		###}
		##ELSE
		###{
		##	CHRG.TXN.crncy = BANCS.OUTPARAM.acctCrncyCode
		###}
		##ENDIF
		
		PRINT(CHRG.TXN.crncy)
	
		sv_u = urhk_SetOrbOut("errorFlg|"+CHRG.TXN.errorFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CHRG.TXN.errorMsg)
		PRINT(sv_u)
		#sv_u = urhk_SetOrbOut("evntChrgCrncy|"+CHRG.TXN.evntChrgCrncy)
		sv_u = urhk_SetOrbOut("evntChrgCrncy|"+CHRG.TXN.crncy)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("evntChrgAmt|"+CHRG.TXN.chrgAmt)
		PRINT(sv_u)
