		sv_u = urhk_SetOrbOut("evntVATCrncy|"+CHRG.TXN.crncy)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("evntVATAmt|"+CHRG.TXN.vatAmt)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("balcheck|"+CHRG.TXN.balcheck)
		PRINT(sv_u)
		
