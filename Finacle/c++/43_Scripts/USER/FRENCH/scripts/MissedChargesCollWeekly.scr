					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.WITH.lienreasoncode + "|" + CUST.WITH.foracid + "|" +  CUST.WITH.trnparticulars + "|"+ BANCS.STDIN.userId
