			print(CUST.WITH.trnparticulars)
			CUST.WITH.CHARGE_AMOUNT=CUST.WITH.CHARGE_AMOUNT +"|" +  CUST.WITH.acctcrncy
			print(CUST.WITH.CHARGE_AMOUNT)
			CUST.WITH.amount1="0.00|" +  CUST.WITH.acctcrncy
			print(CUST.WITH.amount1)
			sv_s = "srlnum|select to_char(to_date('" + BANCS.STDIN.BODDate + "','DD-MM-YYYY HH24:MI:SS') + 10000 , 'DD-MM-RRRR') from dual"
			sv_s = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_s)
			
			IF (sv_s==0) THEN
			#{
				CUST.WITH.date=BANCS.OUTPARAM.srlnum
				PRINT(CUST.WITH.date)
				sv_k =" 00:00:00"
				CUST.WITH.date =CUST.WITH.date + sv_k
				PRINT(CUST.WITH.date)
			#}
			ENDIF
			#--------------------------------------------------------------------------------------------------------------
			# Inputs for Account lien services
			# urhk_SetUrhkInp is used to set inputs
			#--------------------------------------------------------------------------------------------------------------
			print(CUST.WITH.foracid)
			print(CUST.WITH.CHARGE_AMOUNT)
			print( CUST.WITH.acctcrncy)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.WITH.foracid)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" +  CUST.WITH.acctcrncy)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.WITH.CHARGE_AMOUNT)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUST.WITH.amount1)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUST.WITH.date)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUST.WITH.date)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|CHRGL")
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.WITH.INCOM)
			PRINT(sv_u)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.WITH.trnparticulars)
			
			sv_u = urhk_ExecSrv("SRV_AddLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			PRINT(sv_u)
			
			IF (sv_u==0) THEN
			#{
				PRINT(CUST.WITH.foracid)
				PRINT(BANCS.STDIN.contextBankId)
			#}
			ENDIF
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				print(CUST.WITH.foracid)
				print(CUST.WITH.CHARGE_AMOUNT)
				print( CUST.WITH.acctcrncy)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.WITH.foracid)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" +  CUST.WITH.acctcrncy)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.WITH.CHARGE_AMOUNT)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUST.WITH.amount1)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUST.WITH.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUST.WITH.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|CHRGL")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.WITH.INCOM)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.WITH.trnparticulars)
				
				sv_u = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				
				IF (sv_u==0) THEN
				#{
					PRINT(CUST.WITH.foracid)
					PRINT(BANCS.STDIN.contextBankId)
				#}
				ENDIF
				
				#----------------------------------------------------------------------------------------------------
				# SRV Error check
				#----------------------------------------------------------------------------------------------------
				IF (sv_u != 0) THEN
				#{
					CUST.WITH.errMsg="Error Creating Lien"
					#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						PRINT(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					IF (sv_v > 0) THEN
					#{
						sv_u = SYSTEM("echo 'Error for Acct:"+ CUST.WITH.foracid +" ' >>lienedacct.log")
						sv_i = 1
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						goto NEXTREC
					#}
					ENDIF
				#}
				ELSE
				#{
					CUST.WITH.lienreasoncode="CHRGL"
					print(CUST.WITH.lienreasoncode)
					sv_s = "lienid|"
					sv_s = sv_s + " select   TRIM(max(B2K_ID)) from tbaadm.alt l ,tbaadm.gam g  where  l.acid=g.acid  AND l.bank_id=g.bank_id AND g.bank_id=?SVAR "
					sv_s = sv_s + " AND l.LIEN_REASON_CODE=?SVAR AND g.foracid =?SVAR AND l.LIEN_REMARKS=?SVAR AND l.RCRE_USER_ID=?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + CUST.WITH.lienreasoncode + "|" + CUST.WITH.foracid + "|" +  CUST.WITH.trnparticulars + "|"+ BANCS.STDIN.userId
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_d =  urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUST.WITH.TranId=BANCS.OUTPARAM.lienid
						print(CUST.WITH.TranId)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			##### End Main_charges
			############################################################################
		IF (fieldexists(CUST.WITH.TranId)) THEN
		#{
			print(CUST.WITH.TranId)
			CUST.WITH.tranid = CUST.WITH.TranId
			print(CUST.WITH.tranid)
			IF (CUST.WITH.TranId!="") THEN
				sv_s = " UPDATE CUSTOM.UNCOLLECTED_CHARGE SET Collected = 'Y', COLLECTED_TRAN_ID  = ?SVAR, COLLECTED_DATE   = sysdate  , processed ='Y' "
				sv_s = sv_s + " WHERE foracid = ?SVAR AND row_num = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.WITH.tranid + "|"  + CUST.WITH.foracid  + "|" + CUST.WITH.ROW_NUM
				print(BANCS.INPARAM.BINDVARS)
				sv_d=urhk_dbSqlWithBind(sv_s)
				IF (sv_d == 0)  THEN
				#{
					sv_d = urhk_dbSQLWithBind("COMMIT")
				#}
				ENDIF
			ELSE
				CUST.WITH.tranid="Error"
				print(CUST.WITH.tranid)
				sv_s = " UPDATE CUSTOM.UNCOLLECTED_CHARGE SET Collected = 'E', COLLECTED_TRAN_ID  = ?SVAR, COLLECTED_DATE   = sysdate  , processed ='E' "
				sv_s = sv_s + " WHERE foracid = ?SVAR AND row_num = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.WITH.tranid + "|"  + CUST.WITH.foracid  + "|" + CUST.WITH.ROW_NUM
				print(BANCS.INPARAM.BINDVARS)
				sv_d=urhk_dbSqlWithBind(sv_s)
				IF (sv_d == 0)  THEN
				#{
					sv_d = urhk_dbSQLWithBind("COMMIT")
				#}
				ENDIF
			ENDIF
		#}
		ENDIF
		
	NEXTREC:
	sv_d = " sleep 3"
	PRINT(sv_d)
	sv_u = SYSTEM(sv_d)
	PRINT(sv_u)

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
