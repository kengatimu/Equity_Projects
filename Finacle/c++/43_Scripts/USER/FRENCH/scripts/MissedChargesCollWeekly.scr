###sv_s = sv_s + " select sol_id, foracid, tran_date, trim (tran_id) ,  tran_amt, CHARGE_AMOUNT, VAT_AMT, CHARGE_CCY , CHARGE_AMOUNT +VAT_AMT  TOTAL, ROW_NUM   "
####sv_s = sv_s + " from  CUSTOM.UNCOLLECTED_CHARGE  where sol_id =?SVAR  and  PROCESSED ='Y' and  CHARGE_AMOUNT !='0' and  COLLECTED is null and tran_date >= '01-JUN-2021'   "
sv_s = sv_s + " select sol_id, foracid, tran_date, trim (tran_id) ,  tran_amt, CHARGE_AMOUNT, VAT_AMT, CHARGE_CCY , CHARGE_AMOUNT +VAT_AMT  TOTAL, ROW_NUM,   "
sv_s = sv_s + "  (select acct_status from tbaadm.gam,tbaadm.smt  where gam.bank_id='43' and smt.bank_id='43' and gam.acid=smt.acid and gam.bank_id=smt.bank_id and gam.foracid=ff.foracid and rownum<2) acct_status_flg,  "
sv_s = sv_s + " ( select STP_CR_DR_IND from tbaadm.gam,tbaadm.gsp  where gam.bank_id='43' and gsp.bank_id='43' and gam.bank_id=gsp.bank_id  and gam.schm_code=gsp.schm_code and gam.foracid= ff.foracid and rownum<2) STP_CR_DR_IND,  "
sv_s = sv_s + " (select FREZ_CODE from tbaadm.gam where gam.bank_id='43'  and gam.foracid = ff.foracid and rownum<2)  as FREZ_CODE  "
#sv_s = sv_s + "  from  CUSTOM.UNCOLLECTED_CHARGE  ff where sol_id =?SVAR  and  PROCESSED ='N' and  CHARGE_AMOUNT !='0' and  COLLECTED is null and tran_date >= '12-jun-2025' and ff.foracid  in (select foracid from tbaadm.gam where bank_id='43' and acct_cls_flg='N') "
sv_s = sv_s + "  from  CUSTOM.UNCOLLECTED_CHARGE  ff where sol_id =?SVAR  and  PROCESSED ='Y' and  CHARGE_AMOUNT !='0' and  COLLECTED is null and tran_date >= '12-jun-2025' and ff.foracid  in (select foracid from tbaadm.gam where bank_id='43' and acct_cls_flg='N') "
Print  (sv_s)
BANCS.INPARAM.BINDVARS = CUST.WITH.SOL  
print(BANCS.INPARAM.BINDVARS)
sv_e = urhk_dbCursorOpenWithBind(sv_s)
PRINT(sv_e)
IF(sv_e == 0) THEN
#{
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
