				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.WITH.VAT_AMT)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + CUST.WITH.amount1)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + CUST.WITH.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + CUST.WITH.date)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|CHRGL")
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.WITH.VatCrAcctId)
				PRINT(sv_u)
				sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.WITH.trnparticulars)
				
				sv_u = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
				PRINT(sv_u)
				
