<--START
TRACE ON
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","ODA")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","ODA",5)
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		CUST.ODA.acctNum = BANCS.INPUT.acctNum
		PRINT(CUST.ODA.acctNum)
		sv_s = "schmCode,schmType|SELECT SCHM_CODE,schm_type FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.ODA.acctNum +"|"+ BANCS.STDIN.contextBankId

        	PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
        	sv_d = urhk_dbSelectWithBind(sv_s)
        	PRINT(sv_s)
		IF(sv_d == "0")THEN
		#{
			CUST.ODA.schmCode = BANCS.OUTPARAM.schmCode
			PRINT(CUST.ODA.schmCode)
			CUST.ODA.schmType = BANCS.OUTPARAM.schmType  #BR7 Code.
			print(CUST.ODA.schmType)
		#}
		ENDIF
	#}
	ELSE
	#{	
		CUST.ODA.schmCode = BANCS.INPUT.schmCode
		PRINT(CUST.ODA.schmCode)
	#}
	ENDIF

        CUST.ODA.sanlmtschm = "N"

        CUST.ODA.parameterId = "ODSAN_SCHMS"
        CUST.ODA.moduleName = "OT"

        PRINT(BANCS.STDIN.contextBankId)
        PRINT(CUST.ODA.moduleName)
        PRINT(CUST.ODA.parameterId)

        sv_a = ""

        sv_a = sv_a + "paramVal|select parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER "
        sv_a = sv_a + " WHERE C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
        sv_a = sv_a + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
        sv_a = sv_a + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
        sv_a = sv_a + " C_CPVALUE.del_flg != 'Y' AND "
        sv_a = sv_a + " C_CPVALUE.entity_cre_flg = 'Y' AND "
        sv_a = sv_a + " C_CPMASTER.bank_id = ?SVAR AND "
        sv_a = sv_a + " C_CPMASTER.module_name = ?SVAR AND "
        sv_a = sv_a + " C_CPVALUE.parameter_id = ?SVAR "

        PRINT(sv_a)
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ODA.moduleName + "|" + CUST.ODA.parameterId

        sv_d = urhk_dbSelectWithBind(sv_a)
        PRINT(sv_a)
        PRINT(sv_d)

        IF(sv_d == 0) THEN
        #{
                PRINT(BANCS.OUTPARAM.paramVal)
                CUST.ODA.paramVal = BANCS.OUTPARAM.paramVal
                #}
        ELSE
                #{
                CUST.ODA.errorMsg = "CPARAM set up not available for ODSAN_SCHMS"
                sv_u = urhk_SRV_SetErr(CUST.ODA.errorMsg)
                EXITSCRIPT

        #}
        ENDIF
        sv_c = "avail|select decode(count(1),0,'N','Y') from dual where INSTR(?SVAR,?SVAR) != 0"

        PRINT(sv_c)
        BANCS.INPARAM.BINDVARS = CUST.ODA.paramVal + "|" + CUST.ODA.schmCode

        sv_l = urhk_dbSelectWithBind(sv_c)

        PRINT(sv_l)

        IF(sv_l != 0)THEN
        #{
                  PRINT("Error in query")
        #}
        ENDIF

        PRINT(BANCS.OUTPARAM.avail)

	IF(BANCS.OUTPARAM.avail == "Y")THEN
	#{
		CUST.ODA.sanlmtschm = "Y"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	

ENDOFSCRIPT:
	sv_u = urhk_SetOrbOut("crlinFlg|"+CUST.ODA.sanlmtschm)
#++BR7 Starts.
if((CUST.ODA.schmType == "ODA") or (CUST.ODA.schmType == "CAA"))then
	CUST.ODA.schmTypeFlg = "Y"
	sv_u = urhk_SetOrbOut("schmTypeFlg|"+CUST.ODA.schmTypeFlg) #++BR7 Code.
endif
#++BR7 Ends.

TRACE OFF
END-->

