#------------------------------------------------------------------------------------------------
#  Name            : HCCAauto.scr  
#  Description     :
#  Date            : 10-01-2020
#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             10-01-2020      Vino Palani          Original Version
#  2.0             27-09-2021      Irungu James         DRC data clean up
#-----------------------------------------------------------------------------------------------
<--start
trace on
	if(repexists("EQSRV")==0)then	
		createrep("EQSRV")
	endif
	if(classexists("EQSRV","GLBDATA")==0)then	
		createclass("EQSRV","GLBDATA",5)
	endif
	##sv_u = urhk_B2K_PrintRepos("BANCS")
	##print(sv_u)
	EQSRV.GLBDATA.srvErrMsg = "" 
	EQSRV.GLBDATA.srvErrCode = ""
	EQSRV.GLBDATA.srvSucFail = ""
	EQSRV.GLBDATA.ocifid  = "" 
	EQSRV.GLBDATA.ocustid = "" 
	EQSRV.GLBDATA.octitcode = ""
	EQSRV.GLBDATA.ocname   = "" 
	EQSRV.GLBDATA.ocsname  = "" 
	EQSRV.GLBDATA.AcctId = ""
	EQSRV.GLBDATA.ncifid = ""
	EQSRV.GLBDATA.ncifid = ""
	EQSRV.GLBDATA.NEWCIF =""
	EQSRV.GLBDATA.OLDCID =""
	
	sv_a = " OldCIF, NewCIF |  select foracid,sol_id from custom.HCCA_CIF_TABLE_DRC where bank_id=?SVAR and entity_cre_flg='CIF' " 
	print(sv_a)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	sv_e = urhk_dbCursorOpenWithBind(sv_a)
	IF(sv_e==0) THEN
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
			IF(sv_q == 1) THEN
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
				exitscript
			ENDIF
		print(sv_q)

		WHILE (sv_q==0)

		EQSRV.GLBDATA.OLDCIF = BANCS.OUTPARAM.OldCIF
		EQSRV.GLBDATA.NEWCIF = BANCS.OUTPARAM.NewCIF
		Print (EQSRV.GLBDATA.OLDCIF)
		Print (EQSRV.GLBDATA.NEWCIF)

				sv_d = " Foracid | select foracid from tbaadm.gam  where bank_id=?SVAR and entity_cre_flg='Y' and  foracid =?SVAR and schm_type  in   ('SBA','CAA') and acct_cls_flg ='N' "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId   + "|" + EQSRV.GLBDATA.OLDCIF 
				print(BANCS.INPARAM.BINDVARS)
				print(sv_d)
				sv_u = urhk_dbCursorOpenWithBind(sv_d)
				if(sv_u==0)then
					EQSRV.GLBDATA.intCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
				else
					EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
					EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
					EQSRV.GLBDATA.srvSucFail = "F"
					goto VAYU
				endif
				EQSRV.GLBDATA.intRec = 0
				print(EQSRV.GLBDATA.intCurNum)
				sv_z = urhk_dbCursorFetch(EQSRV.GLBDATA.intCurNum)
				if(sv_z!=0)then
					EQSRV.GLBDATA.srvErrCode = BANCS.OUTPARAM.DB_ERRCODE
					EQSRV.GLBDATA.srvErrMsg = BANCS.OUTPARAM.DB_ERRMSG
					EQSRV.GLBDATA.srvSucFail = "F"
					goto NXTLP
				endif
				print(sv_z)
				while(sv_z ==0)
					##{ vploop starts
					#+++++++++++++++++
					print("int loop in")
					EQSRV.GLBDATA.AcctId = BANCS.OUTPARAM.Foracid
					EQSRV.GLBDATA.ncifid = EQSRV.GLBDATA.NEWCIF
					Print (EQSRV.GLBDATA.AcctId)

					sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.AcctId)
					if(sv_u==0)then
						EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
						EQSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
						EQSRV.GLBDATA.acctSolId = BANCS.OUTPARAM.acctSolId
						EQSRV.GLBDATA.cifid = BANCS.OUTPARAM.cifId
						EQSRV.GLBDATA.custId = BANCS.OUTPARAM.custId
					else
						EQSRV.GLBDATA.srvErrMsg =       "urhk_getAcctDetailsInRepository Failed"
						EQSRV.GLBDATA.srvErrCode = "Failed : urhk_getAcctDetailsInRepository "
						EQSRV.GLBDATA.srvSucFail = "F"
						goto NXTLP
					endif
					#ContextSol
					#++++++++++
						print(BANCS.STDIN.mySolId)
						print(EQSRV.GLBDATA.acctSolId)
						if ( BANCS.STDIN.mySolId != EQSRV.GLBDATA.acctSolId ) then
							sv_u = urhk_SetUrhkInp("sol.solId|" +EQSRV.GLBDATA.acctSolId)
							sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
							if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
								print(BANCS.OUTPARAM.successOrFailure)
								sv_s = BANCS.OUTPARAM.successOrFailure
							else
								sv_s = "X"
							endif
							if (( sv_u != 0 ) and ( sv_s != "S"))then
								EQSRV.GLBDATA.srvErrMsg =       "CCS Failed"
								EQSRV.GLBDATA.srvErrCode = "Failed : SRV_ModifyContextSol "
								EQSRV.GLBDATA.srvSucFail = "F"
								goto NXTLP
							endif
						endif
					sv_u = urhk_SetUrhkInp("acct.foracid|" + EQSRV.GLBDATA.AcctId)
					sv_u = urhk_SetUrhkOut("oldCust.cifId|ocifid")
					sv_u = urhk_SetUrhkOut("oldCust.custId|ocustid")
					sv_u = urhk_SetUrhkOut("oldCust.custTitleCode|octitcode")
					sv_u = urhk_SetUrhkOut("oldCust.custName|ocname")
					sv_u = urhk_SetUrhkOut("oldCust.custShortName|ocsname")
					sv_u = urhk_ExecSrv("SRV_FetchCustOfAcctForModify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
					print(sv_u)
					if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
						print(BANCS.OUTPARAM.successOrFailure)
						sv_s = BANCS.OUTPARAM.successOrFailure
					else
						sv_s = "X"
					endif
					if (( sv_u == 0 ) and ( sv_s=="S") ) then
						EQSRV.GLBDATA.ocifid	= BANCS.OUTPARAM.ocifid
						EQSRV.GLBDATA.ocustid	= BANCS.OUTPARAM.ocustid
						EQSRV.GLBDATA.octitcode	= BANCS.OUTPARAM.octitcode
						EQSRV.GLBDATA.ocname	= BANCS.OUTPARAM.ocname
						EQSRV.GLBDATA.ocsname	= BANCS.OUTPARAM.ocsname
					else
						print(EQSRV.GLBDATA.AcctId)
						EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.AcctId 
						callscriptifexist("ebsrvHandler.scr")
						EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
						EQSRV.GLBDATA.srvErrCode = "Failed : SRV_FetchCustOfAcctForModify "
						EQSRV.GLBDATA.srvSucFail = "F"
						goto NXTLP
					endif
					sv_u = urhk_CopyOutToIn("")
					sv_u = urhk_SetUrhkInp("acct.foracid|" + EQSRV.GLBDATA.AcctId)
					sv_u = urhk_SetUrhkInp("oldCust.cifId|" + EQSRV.GLBDATA.ocifid )
					sv_u = urhk_SetUrhkInp("oldCust.custId|" + EQSRV.GLBDATA.ocustid )
					sv_u = urhk_SetUrhkInp("oldCust.custTitleCode|" + EQSRV.GLBDATA.octitcode )
					sv_u = urhk_SetUrhkInp("oldCust.custName|" + EQSRV.GLBDATA.ocname )
					sv_u = urhk_SetUrhkInp("oldCust.custShortName|" + EQSRV.GLBDATA.ocsname )
					sv_u = urhk_SetUrhkInp("newCust.cifId|" + EQSRV.GLBDATA.ncifid )
					##sv_u = urhk_SetUrhkInp("newCust.custId|" + EQSRV.GLBDATA.ncustid )
					sv_u = urhk_ExecSrv("SRV_ModifyCustOfAcctAndVerify|retain_all_output = Y|same_user_verify = Y|ignore_excp_flg=Y")
					print(sv_u)
					if (fieldexists(BANCS.OUTPARAM.successOrFailure) == 1)then
						print(BANCS.OUTPARAM.successOrFailure)
						sv_s = BANCS.OUTPARAM.successOrFailure
					else
						sv_s = "X"
					endif
					
					if (( sv_u == 0 ) and ( sv_s=="S") ) then
						EQSRV.GLBDATA.srvErrMsg = "Customer Id changed for account " + EQSRV.GLBDATA.AcctId + "from " + EQSRV.GLBDATA.ocifid + "to " + EQSRV.GLBDATA.ncifid
						Print (EQSRV.GLBDATA.srvErrMsg )
						EQSRV.GLBDATA.srvSucFail = "S"
						
						#sv_d = " update custom.HCCA_CIF_TABLE_DRC set entity_cre_flg='FIC', ACCT_PREF = 'OK'  where bank_id=?SVAR and sol_id =?SVAR   and foracid  =?SVAR "
						#BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" +  EQSRV.GLBDATA.ncifid + "|" +  EQSRV.GLBDATA.ocifid
						sv_d = " update custom.HCCA_CIF_TABLE_DRC set entity_cre_flg='FIC', ACCT_PREF = concat (ACCT_PREF , ( concat (',' , ?SVAR)))  where bank_id=?SVAR and sol_id =?SVAR   and foracid  =?SVAR "
						BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.AcctId + "|" +  BANCS.STDIN.contextBankId + "|" +  EQSRV.GLBDATA.ncifid + "|" +  EQSRV.GLBDATA.ocifid

						Print (BANCS.INPARAM.BINDVARS)
						print  (sv_d)
						sv_u = urhk_dbSqlWithBind(sv_d)
						if(sv_u==0)then
							sv_u = urhk_dbSqlWithBind("commit")
						else
							goto NXTLP
						endif
					else
						print(EQSRV.GLBDATA.AcctId)
						EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.AcctId 
						callscriptifexist("ebsrvHandler.scr")
						EQSRV.GLBDATA.srvErrMsg = EQSRV.GLBDATA.SrvError
						EQSRV.GLBDATA.srvErrCode = "Failed : SRV_ModifyCustOfAcctAndVerify "
						EQSRV.GLBDATA.srvSucFail = "F"
						goto NXTLP
					endif
						
					NXTLP:	
						
						sv_u = urhk_dbCursorFetch(EQSRV.GLBDATA.intCurNum)
						print(sv_u)
						if(sv_u!=0)then
							print("fetch failed")
							sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.intCurNum)
							print(sv_u)
							EQSRV.GLBDATA.srvErrMsg =  "int Cursor Fetch Failed"
							EQSRV.GLBDATA.srvErrCode = "DBCursor"
							EQSRV.GLBDATA.srvSucFail = "F"
							goto VAYU
						endif
						EQSRV.GLBDATA.intRec = cint(EQSRV.GLBDATA.intRec) + 1
						EQSRV.GLBDATA.recmsg    = "VVVVVVVVVVVVVVVVV Processing Record Num: VVVVVVVVVVVVVVVV  " + EQSRV.GLBDATA.intRec
						print(EQSRV.GLBDATA.recmsg)
					##}vploop Ends
					
				do
				sv_u = urhk_dbCursorClose(EQSRV.GLBDATA.intCurNum)
				print(sv_u)
			VAYU:
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
		DO
	VAYUMAIN:
	sv_u = urhk_dbCursorClose(sv_m)
	print(sv_u)	
	ENDIF

	print(EQSRV.GLBDATA.srvErrMsg)
	print(EQSRV.GLBDATA.srvErrCode)
	print(EQSRV.GLBDATA.srvSucFail)
        if(classexists("EQSRV","GLBDATA")==1)then
                deleteclass("EQSRV","GLBDATA")
        endif
        if(repexists("EQSRV")==1)then
                deleterep("EQSRV")
        endif
        exitscript
trace off
end-->
