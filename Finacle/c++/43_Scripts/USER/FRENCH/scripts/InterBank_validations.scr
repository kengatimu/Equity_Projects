<--START
TRACE ON

	IF(REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF


	sv_a = urhk_SRV_GetVal("pordHeaderDtls.relatedRefNum")
	CUST.DATA.relatedRefNum = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.relatedRefNum)

	IF(CUST.DATA.relatedRefNum == "") THEN
	#{
		sv_c = urhk_SRV_SetErr("Field must be entered: Related Ref.")
		print(sv_c)
		exitscript
	#}
	ENDIF 

	sv_a = urhk_SRV_GetVal("pordPaymentDtls.tranRefNum")
	CUST.DATA.tranRefNum = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.tranRefNum)

	IF(CUST.DATA.tranRefNum == "") THEN
	#{
		sv_c = urhk_SRV_SetErr("Field must be entered: Transaction Ref.")
		print(sv_c)
		exitscript
	#}
	ENDIF 

	sv_a = urhk_SRV_GetVal("pordPaymentDtls.remitInfo1")
	CUST.DATA.remitInfo1 = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.remitInfo1)

	IF(CUST.DATA.remitInfo1 == "") THEN
	#{
		sv_c = urhk_SRV_SetErr("Field must be entered: Line 1")
		print(sv_c)
		exitscript
	#}
	ENDIF 

exitscript

TRACE OFF

END-->





