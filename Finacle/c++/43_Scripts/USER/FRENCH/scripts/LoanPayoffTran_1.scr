<--START
TRACE ON
##This script is to make LoanPayoffTran.scr size less than 131070. Intial few steps from LoanPayoffTran.scr are added in this script
        IF (REPEXISTS("CUST") == 0) THEN
        #{
           CREATEREP("CUST")
        #}
        ENDIF
        IF (CLASSEXISTS("CUST", "VAT") == 0) THEN
        #{
           CREATECLASS("CUST", "VAT", 5)
        #}
        ENDIF
        CUST.VAT.InsertCalled = "N"
sv_z = urhk_MTTS_PopulateInputDetails("")
sv_z = urhk_B2k_PrintRepos("MTT")
sv_p = CDOUBLE(MTT.InputDetails.pendPrincipalAmount)
sv_i = CDOUBLE(MTT.InputDetails.pendInterestAmount)
sv_b = CDOUBLE(MTT.InputDetails.bankChargeAmount)
sv_o = CDOUBLE(MTT.InputDetails.otherChargeAmount)
sv_l = CDOUBLE(MTT.InputDetails.amountInLoanPaymentAcct)
sv_n = CDOUBLE(MTT.InputDetails.normalIntAmtReverse)
sv_e = CDOUBLE(MTT.InputDetails.penalIntAmtReverse)
sv_q = CDOUBLE(MTT.InputDetails.SuspenseIntAmtReverse)
sv_a = CDOUBLE(MTT.InputDetails.netPayOffAmount)
sv_d = CDOUBLE(MTT.InputDetails.pendPrincipalDemandAmount)
sv_s = CDOUBLE(MTT.InputDetails.subAdjAmount)
MTT.InputDetails.tranPenalInterestAmount =  CDOUBLE(MTT.InputDetails.tranPenalInterestAmount) +CDOUBLE(MTT.InputDetails.tranPenaltyOnOvduPrncAmount) +CDOUBLE(MTT.InputDetails.tranPenaltyOnOvduIntAmount)
MTT.InputDetails.penaltranBookAmount = CDOUBLE(MTT.InputDetails.penaltranBookAmount) +CDOUBLE(MTT.InputDetails.penalPrncBookAmount)+CDOUBLE(MTT.InputDetails.penalIntBookAmount)
lv_c = 0
lv_d = 0
MTT.TranDetails.TranDate="0"
MTT.TranDetails.TranType=MTT.InputDetails.TranType
MTT.TranDetails.TranSubType=MTT.InputDetails.TranSubType
sv_f=CDOUBLE(MTT.InputDetails.excessCreditAmount)
    if((sv_a != 0) OR (sv_f !=0)) then
        if (MTT.TranDetails.TranType == "C") then
            if ((MTT.TranDetails.TranSubType == "CR") AND ((sv_a < 0) OR ((sv_f - sv_a)  > 0))) then
                MTT.TranDetails.TranSubType = "CP"
            else
                if ((MTT.TranDetails.TranSubType == "CP") AND ((sv_a > 0) OR ((sv_f + sv_a) > 0))) then
                    MTT.TranDetails.TranSubType = "CR"

                endif
            endif
            if(((sv_f - sv_a)== 0) OR ((sv_f + sv_a)== 0)) then
                MTT.InputDetails.TranType = "T"
                MTT.InputDetails.TranSubType = "BI"
                MTT.TranDetails.TranType = MTT.InputDetails.TranType
                MTT.TranDetails.TranSubType=MTT.InputDetails.TranSubType
           endif
        endif
    endif
MTT.TranDetails.Remarks="Payoff transaction"
if((MTT.InputDetails.entityType == "F") OR (MTT.InputDetails.entityType == "O") OR (MTT.InputDetails.entityType == "I")) then
   if(MTT.InputDetails.typeOfPyoff == "C") then
      MTT.TranDetails.Remarks="Lease Cancellation transaction"
   endif
endif
END-->
