#------------------------------------------------------------------------------------------------
#  Name            : eAccOpenNotify.scr
#  Description     : This script will get data required by <eAccOpenNotify.com> for email notification
#  Date            : 01-07-2021
#  Author          : Edwin Zico
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Calling Script  : SRV_OpenCAAcct_post_process_data.scr
#  Menu Option     : TBJMS
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             01-07-2021      Edwin Zico           Original Version
#-----------------------------------------------------------------------------------------------
<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_r = urhk_MTTS_PopulateInputDetails("")
        print(sv_r)
        if(sv_r==0)then
		EBSRV.GLBDATA.foracid = MTT.InputDetails.Argument1
		EBSRV.GLBDATA.schmCode = MTT.InputDetails.Argument2
		EBSRV.GLBDATA.cifId = MTT.InputDetails.Argument3
		EBSRV.GLBDATA.BODDate = MTT.InputDetails.Argument4
		EBSRV.GLBDATA.solId = MTT.InputDetails.Argument5
		EBSRV.GLBDATA.crncyCode = MTT.InputDetails.Argument6
		EBSRV.GLBDATA.Iban = MTT.InputDetails.Argument7
        else
              	EBSRV.GLBDATA.foracid = ""
		EBSRV.GLBDATA.schmCode = ""
		EBSRV.GLBDATA.cifId = ""
		EBSRV.GLBDATA.BODDate = ""
		EBSRV.GLBDATA.solId = ""
		EBSRV.GLBDATA.crncyCode = ""
		EBSRV.GLBDATA.Iban = ""

        endif
	
		sv_s = " toAddr |select email from tbaadm.cemail where email_b2kid =?SVAR "
		sv_s = sv_s + " and preferredflag='Y' "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.cifId
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u==0)then
			EBSRV.GLBDATA.toAddr = BANCS.OUTPARAM.toAddr			
			print(EBSRV.GLBDATA.toAddr)
		else
			EBSRV.GLBDATA.toAddr = "NA"
		endif


	EBSRV.GLBDATA.isModuleType = "AN"
	EBSRV.GLBDATA.toAddr = EBSRV.GLBDATA.toAddr 
	EBSRV.GLBDATA.toCCAddr = "diaspora@equitybcdc.cd,JANNY.MULANGA@EQUITYBCDC.CD"
	EBSRV.GLBDATA.toAddr =  EBSRV.GLBDATA.toAddr + "," + EBSRV.GLBDATA.toCCAddr

        sv_u = urhk_getFileLocation("COM|eAccOpenNotify.com")
        if(sv_u ==0)then
                print(BANCS.OUTPARAM.fileLocation)
                EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "eAccOpenNotify.com"
                print(EBSRV.GLBDATA.comfil)
                print(EBSRV.GLBDATA.toAddr)
                if(EBSRV.GLBDATA.isModuleType=="AN")then
			EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " +'"'+ EBSRV.GLBDATA.toAddr + '"'+" " +'"'+ EBSRV.GLBDATA.foracid+'"'+ " " +'"'+ EBSRV.GLBDATA.schmCode + '"' + " " +'"'+ EBSRV.GLBDATA.cifId+ '"' + " " +'"'+EBSRV.GLBDATA.BODDate+ '"' + " " +'"'+EBSRV.GLBDATA.solId + '"' + " " +'"'+ EBSRV.GLBDATA.isModuleType+ '"' + " " +'"'+ EBSRV.GLBDATA.crncyCode+ '"' + " " +'"'+ EBSRV.GLBDATA.Iban+ '"' + " " +'"'+EBSRV.GLBDATA.toCCAddr +'"'+ " "
                endif
        else
                EBSRV.GLBDATA.comfil   = ""
        endif
        if(EBSRV.GLBDATA.comfil != "")then
                print(EBSRV.GLBDATA.comfil)
                sv_u = system(EBSRV.GLBDATA.comfil)
                if(sv_u ==0)then
                        print("smtp success")
                else
                        print("failed smtp")
                endif
        endif
trace off
end-->

