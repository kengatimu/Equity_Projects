<--START

	TRACE ON
	#==========================================================*
	# Intilializing the Variables
	#==========================================================*
	
	CUST.PLAMR.vattranId = ""
	CUST.PLAMR.vatErrMsg = ""
	CUST.PLAMR.Fccyvatacnt = ""
	CUST.PLAMR.Hccyvatacnt = ""
	CUST.PLAMR.vatfailRmks = ""
	CUST.PLAMR.FvatCrncy = ""
	CUST.PLAMR.vatTranrmks = ""

	sv_s = "Fccyvatacnt,FvatCrncy|select foracid,acct_crncy_code from tbaadm.gam where bank_id=?SVAR and del_flg='N' and acct_cls_flg='N'"
	sv_s = sv_s +" 	and entity_cre_flg='Y' and bacid='VAT' and acct_crncy_code in ('USD','EUR') and sol_id=?SVAR"

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF(sv_c != 0)THEN
	#{
		CUST.PLAMR.vatErrMsg = "There are no Foriegn Currency VAT accounts exists for Sol " + BANCS.STDIN.mySolId
		PRINT(CUST.PLAMR.vatErrMsg)
		sv_b = urtn_fileWrite(CUST.PLAMR.failFileIndex1 + "|" + CUST.PLAMR.vatErrMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(sv_n)
	
	sv_f = urhk_dbCursorFetch(sv_n)
	PRINT(sv_f)
	
	IF(sv_f != 0)THEN
	#{
		CUST.PLAMR.vatErrMsg = "There are no Foriegn Currency VAT accounts exists for Sol " + BANCS.STDIN.mySolId
		PRINT(CUST.PLAMR.vatErrMsg)
		sv_b = urtn_fileWrite(CUST.PLAMR.failFileIndex1 + "|" + CUST.PLAMR.vatErrMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	WHILE(sv_f == 0)
	#{
		CUST.PLAMR.Fccyvatacnt = BANCS.OUTPARAM.Fccyvatacnt
		CUST.PLAMR.FvatCrncy = BANCS.OUTPARAM.FvatCrncy
		PRINT(CUST.PLAMR.Fccyvatacnt)
		PRINT(CUST.PLAMR.FvatCrncy)
		CUST.PLAMR.vattranAmt = ""	
		CUST.PLAMR.vattranId = ""
		CUST.PLAMR.pstdFlg = "N"
		CUST.PLAMR.Hccyvatacnt = ""
		CUST.PLAMR.Msg = ""
		
		sv_u = urhk_getAcctDetailsInRepository(CUST.PLAMR.Fccyvatacnt)
		IF(sv_u == 0) THEN
		#{
			CUST.PLAMR.vattranAmt = BANCS.OUTPARAM.EffAvailableAmt
		#}
		ENDIF

		#-------------------------------------------------------------------------------------------*
		# fetching the Home Currency account
		#--------------------------------------------------------------------------------------------*
		
		sv_s = "Hccyacnt|select foracid from tbaadm.gam where del_flg='N' and acct_cls_flg='N' and entity_cre_flg='Y' and"
		sv_s = sv_s +" bacid ='VAT' and bank_id=?SVAR and acct_crncy_code =?SVAR and sol_id=?SVAR"

		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode	+"|"+ BANCS.STDIN.mySolId
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.PLAMR.Hccyvatacnt = BANCS.OUTPARAM.Hccyacnt
			PRINT(CUST.PLAMR.Hccyvatacnt)
		#}
		ELSE
		#{
			CUST.PLAMR.vatErrMsg = "There are no Home Currency VAT accounts exists for Sol " + BANCS.STDIN.mySolId
			PRINT(CUST.PLAMR.vatErrMsg)
			sv_b = urtn_fileWrite(CUST.PLAMR.failFileIndex1 + "|" + CUST.PLAMR.vatErrMsg)
			GOTO NXTBACID			
		#}
		ENDIF	
		
		IF(CUST.PLAMR.FvatCrncy == BANCS.STDIN.homeCrncyCode) THEN
		#{
			CUST.PLAMR.vattranAmt = CDOUBLE(CUST.PLAMR.vattranAmt)
			PRINT(CUST.PLAMR.vattranAmt)
			#}
		ELSE
			#{
			BANCS.INPARAM.FromCurrency = CUST.PLAMR.FvatCrncy
			PRINT(BANCS.INPARAM.FromCurrency)
			BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
			PRINT(BANCS.INPARAM.ToCurrency)
			BANCS.INPARAM.RateCode = CUST.PLAMR.rateCode
			PRINT(BANCS.INPARAM.RateCode)
			BANCS.INPARAM.Rate = CDOUBLE("0.0")
			BANCS.INPARAM.CustId = ""
			BANCS.INPARAM.InputAmount = CUST.PLAMR.vattranAmt
			sv_u = urhk_B2k_ConvertAmount("")
			PRINT(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				CUST.PLAMR.vattranAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(CUST.PLAMR.vattranAmt)
				
				#}
			ELSE
				#{
				CUST.PLAMR.vatErrMsg = "VAT Amount Conversion is failed From Currency "+CUST.PLAMR.FvatCrncy
				PRINT(CUST.PLAMR.vatErrMsg)
				sv_b = urtn_fileWrite(CUST.PLAMR.failFileIndex1 + "|" + CUST.PLAMR.vatErrMsg)
				GOTO NXTBACID			
			#}
			ENDIF
		#}
		ENDIF
		
		
		
		#==========================================================*
		# Transaction part starts here
		#==========================================================*
		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.CommitFlg = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
		BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw = "Y"
		BANCS.INPARAM.CheckExceptions = "Y"
		#sv_r = urhk_MTTS_Initialize("")
		#PRINT(sv_r)
		#---------------------------------------------------------------------------------*
		# Populate Transaction details
		#---------------------------------------------------------------------------------*
		MTT.TranDetails.TranID = ""
		MTT.TranDetails.TranDate = "0"
		MTT.TranDetails.TranType = "T"
		MTT.TranDetails.TranSubType = "BI"
		MTT.TranDetails.IgnoreExcp = "I"
		MTT.TranDetails.Consolidate = "N"
		MTT.TranDetails.ReversalFlag ="N"
		MTT.TranDetails.ValidationFlag = "Y"
		MTT.TranDetails.PostFlag = "Y"
		MTT.TranDetails.CommitFlg = "Y"
		MTT.TranDetails.CheckExceptions = "Y"
		MTT.TranDetails.Remarks = "Fccy to Hccy VAT settlement"
		MTT.TranDetails.PostTranFlg = "Y"
		MTT.TranDetails.flgPostTransaction = "Y"
		CUST.PLAMR.vatTranrmks = MTT.TranDetails.Remarks
		
		#------------------------------------------------------------------*
		# Defining the Transaction
		#------------------------------------------------------------------*
		
		sv_u = urhk_MTTS_DefineTransaction("TRAN")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.PLAMR.vatErrMsg = "Error Encountered in Defining the Transaction"
			PRINT(CUST.PLAMR.vatErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		
		MTT.PartTranDetails.TODRefType = ""
		
		MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.PLAMR.vattranAmt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Account = CUST.PLAMR.Fccyvatacnt
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		
		IF(CUST.PLAMR.FvatCrncy == BANCS.STDIN.homeCrncyCode) THEN
		#{
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.Rate = ""
			#}
		ELSE
			#{
			MTT.PartTranDetails.RateCode = CUST.PLAMR.rateCode
			MTT.PartTranDetails.Rate = "0.00"
		#}
		ENDIF
		#MTT.PartTranDetails.CarveAmtFlg = "Y"
		MTT.PartTranDetails.TranIdentifier = "TRAN"
		MTT.PartTranDetails.Particulars = "Debiting the Foreign Currency VAT Account" + ":" + CUST.PLAMR.Fccyvatacnt
		
		sv_u = urhk_MTTS_DefinePartTran("PARTTRAN1")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.PLAMR.vatErrMsg = "Error Encountered in Defining the Debit part Transaction"
			PRINT(CUST.PLAMR.vatErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		
		#------------------------------------------------------------*
		# Crediting the central Account
		#------------------------------------------------------------*
		
		MTT.PartTranDetails.TODRefType = ""
		
		MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.PLAMR.vattranAmt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Account = CUST.PLAMR.Hccyvatacnt
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Rate = ""
		#MTT.PartTranDetails.CarveAmtFlg = "Y"
		MTT.PartTranDetails.TranIdentifier = "TRAN"
		MTT.PartTranDetails.Particulars = "Crediting the Home Currency VAT Account" + ":" + CUST.PLAMR.Hccyvatacnt
		
		sv_u = urhk_MTTS_DefinePartTran("PARTTRAN1")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.PLAMR.vatErrMsg = "Error Encountered in Defining the Credit part Transaction"
			PRINT(CUST.PLAMR.vatErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		sv_r = urhk_putExceptionsIntoRepository("")
		PRINT(sv_r)
		
		sv_s = urhk_b2k_printRepos("EXCP")
		#---------------------------------------------------------*
		# Committing the Transaction
		#---------------------------------------------------------*
		sv_u = urhk_MTTS_EndDefinition("")
		PRINT(sv_u)
		IF(sv_u !=0) THEN
		#{
			sv_a = "Transaction Commit Failed"
			PRINT(sv_a)
			sv_r = urhk_MTTS_ReportErrorCondition("")
			PRINT(sv_r)
			PRINT(MTT.Error.Description)
			CUST.PLAMR.vatErrMsg = MTT.Error.Description
			sv_r = urhk_MTTS_HandleExceptions("POST")
			PRINT(sv_r)
			sv_r=urhk_B2k_PrintRepos("MTT")
			PRINT(sv_r)
			#sv_r = urhk_dbSQL("rollback")
			#PRINT(sv_r)
			#BANCS.INPARAM.BINDVARS=""
			#sv_d = urhk_dbSelectWithBind("rollback")
			#PRINT(sv_d)
			
			CUST.PLAMR.pstdFlg = "N"
			#}
		ELSE
			#{
			PRINT(BANCS.OUTPARAM.MTTTranId)
			CUST.PLAMR.vattranId = BANCS.OUTPARAM.MTTTranId
			PRINT(CUST.PLAMR.vattranId)
			#			CUST.PLAMR.errmsg = MTT.Error.Description
			#			PRINT(CUST.PLAMR.errmsg)
			IF(CUST.PLAMR.vattranId != "") THEN
			#{
				sv_a = "Transaction is successful"
				PRINT(sv_a)
				#BANCS.INPARAM.BINDVARS=""
				#sv_d = urhk_dbSelectWithBind("commit")
				#PRINT(sv_d)
				CUST.PLAMR.pstdFlg = "Y"
				#}
			ELSE
				#{
				#sv_d = urhk_dbSQL("rollback")
				#PRINT(sv_d)
				#BANCS.INPARAM.BINDVARS=""
				#sv_d = urhk_dbSelectWithBind("rollback")
				#PRINT(sv_d)
				sv_r=urhk_B2k_PrintRepos("MTT")
				PRINT(sv_r)
				CUST.PLAMR.vatErrMsg = "Transcation failed for bacid " + CUST.PLAMR.Fccybacid
				CUST.PLAMR.pstdFlg = "N"
				
			#}
			ENDIF
			
			
		#}
		ENDIF
			
                #sv_z = urhk_MTTS_Close("")
                #PRINT(sv_z)

		IF(TRIM(CUST.PLAMR.vattranId) != "")THEN
		#{	
		
			CUST.PLAMR.Msg = "Amount is settled From Currency "+CUST.PLAMR.FvatCrncy+" tran Id:"+CUST.PLAMR.vattranId
			PRINT(CUST.PLAMR.Msg)
			sv_b = urtn_fileWrite(CUST.PLAMR.successFileIndex1 + "|" + CUST.PLAMR.Msg)
				
			sv_s = "insert into custom.FPLTRAN (TRAN_ID,TRAN_DATE,CR_ACCT_ID,DR_ACCT_ID,FCCY,HCCY,TRAN_AMT,DR_ACCT_SOLID,TRAN_PARTICULAR,POSTED_FLG,"
			sv_s = sv_s + "POSTED_USER_ID,BANK_ID)"
			sv_s = sv_s + " values(?SVAR,sysdate,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
			BANCS.INPARAM.BINDVARS = CUST.PLAMR.vattranId + "|" + CUST.PLAMR.Hccyvatacnt + "|" + CUST.PLAMR.Fccyvatacnt + "|" + CUST.PLAMR.FvatCrncy 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.homeCrncyCode + "|" + CUST.PLAMR.vattranAmt + "|" + BANCS.STDIN.mySolId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.PLAMR.vatTranrmks + "|" + CUST.PLAMR.pstdFlg
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		#}
		ENDIF
		
		PRINT(sv_s)
		
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_u = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_u)
		sv_u = urhk_dbSQLWithBind("COMMIT")
		BANCS.STDIN.InsrtFlag = "Y"
		#sv_r = urhk_MTTS_Close("")
		CUST.PLAMR.vatErrMsg = ""
		
		NXTBACID:
		sv_f = urhk_dbCursorFetch(sv_n)
		PRINT(sv_f)
	#}
	DO
	
        sv_c = urhk_dbCursorClose(sv_n)
        PRINT(sv_c)

	ENDOFSCRIPT:
	
