<--START
TRACE ON
IF(REPEXISTS("CUST")==0)THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF(CLASSEXISTS("CUST","DATA")==0)THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

	sv_u = urhk_B2K_PrintRepos("BANCS")
        PRINT(sv_u)

        CUST.DATA.funcCode    = BANCS.INPUT.funcCode
        CUST.DATA.agentcode  = BANCS.INPUT.agentcode
        CUST.DATA.crncyCode   = BANCS.INPUT.crncyCode
	
	

        PRINT(CUST.DATA.funcCode)
        PRINT(CUST.DATA.agentcode)
        PRINT(CUST.DATA.crncyCode)

	
        IF(CUST.DATA.funcCode  == "V") THEN
        #{
                IF((CUST.DATA.agentcode !="") AND (CUST.DATA.crncyCode !=""))THEN
                #{


                        sv_b = "AGENT_TITLE_CODE,AGENT_NAME,AGENT_SHORT_NAME,AGENT_PHONE_NUM,"
                        sv_b = sv_b + "AGENT_ADDR1,AGENT_ADDR2,AGENT_ADDR3,AGENT_CITY_CODE,"
                        sv_b = sv_b + "AGENT_STATE_CODE,AGENT_CNTRY_CODE,AGENT_PIN,CRNCY_CODE,"
                        sv_b = sv_b + "OPER_CREDIT_ACID,INOPER_CREDIT_ACID,ITAX_PCNT,INT_AMT_CEILING,"
                        sv_b = sv_b + "SECURITY_AMT,EXPECTED_COLLECTION,NO_OF_ACCT_OPENED,FREE_TEXT,SOL_ID,LCHG_USER_ID| "
                        sv_b = sv_b + "SELECT AGENT_TITLE_CODE,AGENT_NAME,AGENT_SHORT_NAME,AGENT_PHONE_NUM,"
                        sv_b = sv_b + "AGENT_ADDR1,AGENT_ADDR2,AGENT_ADDR3,AGENT_CITY_CODE,"
                        sv_b = sv_b + "AGENT_STATE_CODE,AGENT_CNTRY_CODE,AGENT_PIN,CRNCY_CODE,"
                        sv_b = sv_b + "OPER_CREDIT_ACID,INOPER_CREDIT_ACID,ITAX_PCNT,INT_AMT_CEILING,"
                        sv_b = sv_b + "SECURITY_AMT,EXPECTED_COLLECTION,NO_OF_ACCT_OPENED,FREE_TEXT ,SOL_ID,LCHG_USER_ID"
                        sv_b = sv_b + " FROM CUSTOM.CUSTOM_AGT_MOD WHERE AGENT_CODE = ?SVAR "
                        #sv_b = sv_b + " AND CRNCY_CODE = ?SVAR AND DEL_FLG = 'N' and rownum<2 "
						sv_b = sv_b + " AND CRNCY_CODE = ?SVAR and rownum<2 "

                        BANCS.INPARAM.BINDVARS = CUST.DATA.agentcode + "|" + CUST.DATA.crncyCode
                        PRINT(BANCS.INPARAM.BINDVARS)

                        PRINT(sv_b)

                        sv_a = urhk_dbSelectWithBind(sv_b)
                        PRINT(sv_a)

                        IF(sv_a!=0)THEN
                        #{
                                sv_z = "SuccessOrFailure|N"
                                sv_z = urhk_SetOrbOut(sv_z)
                                sv_z = urhk_SetOrbOut("Error_1|Error^No Record Found to .^agentcode")
                                EXITSCRIPT
                        #}
                        ELSE
                        #{
				 CUST.DATA.agenttitlecode           = BANCS.OUTPARAM.AGENT_TITLE_CODE
				 CUST.DATA.agentname                 = BANCS.OUTPARAM.AGENT_NAME
				 CUST.DATA.agentshortname           = BANCS.OUTPARAM.AGENT_SHORT_NAME
				 #CUST.DATA.agentshortname           = BANCS.OUTPARAM.SOL_ID
				 CUST.DATA.agentphonenum            = BANCS.OUTPARAM.AGENT_PHONE_NUM
				 CUST.DATA.agentaddr1                = BANCS.OUTPARAM.AGENT_ADDR1
				 CUST.DATA.agentaddr2                = BANCS.OUTPARAM.AGENT_ADDR2
				 CUST.DATA.agentaddr3                = BANCS.OUTPARAM.AGENT_ADDR3
				 CUST.DATA.agentcitycode            = BANCS.OUTPARAM.AGENT_CITY_CODE
				 CUST.DATA.agentstatecode           = BANCS.OUTPARAM.AGENT_STATE_CODE
				 CUST.DATA.agentcntrycode           = BANCS.OUTPARAM.AGENT_CNTRY_CODE
				 CUST.DATA.agentpin                  = BANCS.OUTPARAM.AGENT_PIN
				 CUST.DATA.crncycode                 = BANCS.OUTPARAM.CRNCY_CODE
				 CUST.DATA.operacctnum              = BANCS.OUTPARAM.OPER_CREDIT_ACID
				 CUST.DATA.inoperacctnum            = BANCS.OUTPARAM.INOPER_CREDIT_ACID
				 CUST.DATA.itaxpcnt                  = BANCS.OUTPARAM.ITAX_PCNT
				 CUST.DATA.dummyintamtceiling      = BANCS.OUTPARAM.INT_AMT_CEILING
				 CUST.DATA.dummysecurityamt         = BANCS.OUTPARAM.SECURITY_AMT
				 CUST.DATA.dummyexceptedcollection  = BANCS.OUTPARAM.EXPECTED_COLLECTION
				 CUST.DATA.noofacctopened          = BANCS.OUTPARAM.NO_OF_ACCT_OPENED
				 CUST.DATA.freetext                  = BANCS.OUTPARAM.FREE_TEXT
				 #CUST.DATA.solId                     = BANCS.OUTPARAM.SOL_ID
				 CUST.DATA.solId                     = BANCS.OUTPARAM.AGENT_SHORT_NAME
				 CUST.DATA.lchgUserId                = BANCS.OUTPARAM.LCHG_USER_ID

			#}
			ENDIF

				PRINT(CUST.DATA.agenttitlecode)         
				PRINT(CUST.DATA.agentname)            
				PRINT(CUST.DATA.agentshortname)         
				PRINT(CUST.DATA.agentphonenum)         
				PRINT(CUST.DATA.agentaddr1)             
				PRINT(CUST.DATA.agentaddr2)             
				PRINT(CUST.DATA.agentaddr3)             
				PRINT(CUST.DATA.agentcitycode)          
				PRINT(CUST.DATA.agentstatecode)         
				PRINT(CUST.DATA.agentcntrycode)         
				PRINT(CUST.DATA.agentpin)               
				PRINT(CUST.DATA.crncycode)              
				PRINT(CUST.DATA.operacctnum)           
				PRINT(CUST.DATA.inoperacctnum)         
				PRINT(CUST.DATA.itaxpcnt)               
				PRINT(CUST.DATA.dummyintamtceiling)    
				PRINT(CUST.DATA.dummysecurityamt)       
				PRINT(CUST.DATA.dummyexceptedcollection)
				PRINT(CUST.DATA.noofacctopened)         
				PRINT(CUST.DATA.freetext)               
				print(CUST.DATA.solId)


			IF(CUST.DATA.lchgUserId == BANCS.STDIN.userId)THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Same user cannot verify^agentcode")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF

			IF(CUST.DATA.agenttitlecode !="") THEN
			#{
			    sv_t = urhk_SetOrbOut("agenttitlecode|"+CUST.DATA.agenttitlecode)
			    PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.agentname !="") THEN
			#{
			    sv_t = urhk_SetOrbOut("agentname|"+CUST.DATA.agentname)
			    PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.agentshortname !="") THEN
