				#sv_t = urhk_SetOrbOut("agentshortname|"+CUST.DATA.solId)
				sv_t = urhk_SetOrbOut("agentshortname|"+CUST.DATA.agentshortname)
				PRINT(sv_t)
			#}
			IF(CUST.DATA.agentphonenum !="") THEN
			#{
			    sv_t = urhk_SetOrbOut("agentphonenum|"+CUST.DATA.agentphonenum)
			    PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.agentaddr1 !="") THEN
