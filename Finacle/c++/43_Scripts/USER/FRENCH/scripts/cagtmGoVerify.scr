			#{
			    sv_t = urhk_SetOrbOut("agentaddr3|"+CUST.DATA.agentaddr3)
			    PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.agentpin !="") THEN
			#{
				sv_t = urhk_SetOrbOut("agentpin|"+CUST.DATA.agentpin)
				PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.agentcitycode !="") THEN
			#{
			    sv_t = urhk_SetOrbOut("agentcitycode|"+CUST.DATA.agentcitycode)
			    PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.agentstatecode !="") THEN
			#{
			    sv_t = urhk_SetOrbOut("agentstatecode|"+CUST.DATA.agentstatecode)
			    PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.agentcntrycode !="") THEN
			#{
			    sv_t = urhk_SetOrbOut("agentcntrycode|"+CUST.DATA.agentcntrycode)
			    PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.operacctnum !="") THEN
			#{
				sv_a= urhk_B2k_AcidToForacid(CUST.DATA.operacctnum)
				IF(sv_a==0)THEN
				#{
					CUST.DATA.drAcctId = BANCS.OUTPARAM.Foracid
				#}
				ELSE
				#{
					CUST.DATA.drAcctId = ""
				#}
				ENDIF
			    	sv_t = urhk_SetOrbOut("operacctnum|"+CUST.DATA.drAcctId)
			    	PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.inoperacctnum !="") THEN
			#{
				sv_a= urhk_B2k_AcidToForacid(CUST.DATA.inoperacctnum)
                                IF(sv_a==0)THEN
                                #{
                                        CUST.DATA.CrAcctId = BANCS.OUTPARAM.Foracid
                                #}
                                ELSE
                                #{
                                        CUST.DATA.CrAcctId = ""
                                #}
                                ENDIF
			    	sv_t = urhk_SetOrbOut("inoperacctnum|"+CUST.DATA.CrAcctId)
			    	PRINT(sv_t)
			#}
			ENDIF
			IF(CUST.DATA.itaxpcnt !="") THEN
			#{
			    sv_t = urhk_SetOrbOut("itaxpcnt|"+CUST.DATA.itaxpcnt)
			    PRINT(sv_t)
