<--START
CHECKSUM="1aefc47124e1e53be31b7ecdca025c11244029d406be79399412e26b49df1a69"
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_a = urhk_B2K_printRepos("BANCS")
	print(sv_a)
	
	sv_a = urhk_B2K_printRepos("CUST")
	print(sv_a)
	
	CUST.LADISB.payofflag = "N"
	CUST.LADISB.newLoanForacid = CUST.LADISB.foracid
	CUST.LADISB.totalCount=CUST.LADISB.count
	
	CUST.LADISB.ConvTrcAmt  = 0 
		
	#Hardcoding for now 
	CUST.LADISB.limitRateCode ="EXPB"
	
	IF(BANCS.STDIN.menuId=="HLADISB") THEN
	#{
			
		#------------------------------------------------------------------------------
		# Exitscript if function code is Reversal
		#------------------------------------------------------------------------------
		#sv_b = urhk_SRV_GetVal("acctDisburseTranLA.reversalTranId")
		#CUST.LADISB.reversalTran = BANCS.OUTPARAM.srvValue
		#print(CUST.LADISB.reversalTran)
		#IF (CUST.LADISB.reversalTran != "") THEN
		#{
		#	GOTO ENDOFSCRIPT
		#}
		#ENDIF
		
		#--------------------------------------------------------------------
		#Getting operative acct Currency
		#--------------------------------------------------------------------
		sv_s = ""
		sv_s = "OprAcctCrncyCode|SELECT GAM.acct_crncy_code "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE GAM.foracid = ?SVAR "
		sv_s = sv_s + "AND GAM.bank_id = ?SVAR "
		sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
		sv_s = sv_s + "AND GAM.del_flg = 'N' "
		sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y'"
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS = ""
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.creditAcctNum + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		
		IF ( sv_d != 0 ) THEN
		#{
			CUST.LADISB.errMsg = "Error occured in calculating new loan account currency code"
			print(CUST.LADISB.errMsg)
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.OprAcctCrncyCode= BANCS.OUTPARAM.OprAcctCrncyCode
			print(BANCS.OUTPARAM.OprAcctCrncyCode)
		#}
		ENDIF
			
		sv_g = 1
		sv_t = 1
		
		WHILE( sv_g <= CUST.LADISB.totalCount)
			#{
				sv_a = sv_a+1
				PRINT(sv_a)
				PRINT(CUST.LADISB.selFlg)
				
				sv_b = "!~"+FORMAT$(sv_a,"%d")+"!"
				PRINT(sv_b)
				
				sv_c = "!~"+FORMAT$((sv_a+1),"%d")+"!"
				PRINT(sv_c)
				
				#-----------
				# Get selFlg 
				#-----------
				sv_d = GETPOSITION(CUST.LADISB.selFlg,sv_b)
				PRINT(sv_d)
				if(sv_a >9) THEN
				#{
					sv_d = sv_d +4
				#}
				else
				#{
					sv_d = sv_d +3
				#}
				endif
				
				PRINT(sv_d)
				sv_e = GETPOSITION(CUST.LADISB.selFlg,sv_c)
				PRINT(sv_e)
				sv_h= sv_e - sv_d

				if(sv_a == CUST.LADISB.totalCount) THEN
				#{
					sv_l = STRLEN(CUST.LADISB.selFlg)
					#sv_h = sv_l - sv_d
					sv_h = sv_l
				#}
				ENDIF
				
				sv_f = MID$(CUST.LADISB.selFlg,sv_d,(sv_h-1))
				PRINT(sv_f)
				
				IF(sv_f == "Y") THEN
				#{
					
					#-----------------
					# Get oldLoanacct 
					#-----------------
					sv_d = GETPOSITION(CUST.LADISB.oldLoanacct,sv_b)
					PRINT(sv_d)
					if(sv_a >9) THEN
					#{
						sv_d = sv_d +4
					#}
					else
					#{
						sv_d = sv_d +3
					#}
					endif
					PRINT(sv_d)
					sv_e = GETPOSITION(CUST.LADISB.oldLoanacct,sv_c)
					PRINT(sv_e)
					sv_h= sv_e - sv_d
					if(sv_a == CUST.LADISB.totalCount) THEN
					#{
						sv_l = STRLEN(CUST.LADISB.oldLoanacct)
						#sv_h = sv_l - sv_d
						sv_h = sv_l
					#}
					ENDIF
					CUST.LADISB.oldLoanacctNo = MID$(CUST.LADISB.oldLoanacct,sv_d,(sv_h-1))
					PRINT(CUST.LADISB.oldLoanacctNo)
					
					#-----------------
					# Get oldacctCrncy 
					#-----------------
					sv_d = GETPOSITION(CUST.LADISB.oldacctCrncy,sv_b)
					PRINT(sv_d)
					if(sv_a >9) THEN
					#{
						sv_d = sv_d +4
					#}
					else
					#{
						sv_d = sv_d +3
					#}
					endif
					PRINT(sv_d)
					sv_e = GETPOSITION(CUST.LADISB.oldacctCrncy,sv_c)
					PRINT(sv_e)
					sv_h= sv_e - sv_d
					if(sv_a == CUST.LADISB.totalCount) THEN
					#{
						sv_l = STRLEN(CUST.LADISB.oldacctCrncy)
						#sv_h = sv_l - sv_d
						sv_h = sv_l
					#}
					ENDIF
					CUST.LADISB.oldLoanCrncyCode = MID$(CUST.LADISB.oldacctCrncy,sv_d,(sv_h-1))
					PRINT(CUST.LADISB.oldLoanCrncyCode)
					
					#--------------
					# Get oldTotAmt 
					#--------------
					sv_d = GETPOSITION(CUST.LADISB.oldTotAmt,sv_b)
					PRINT(sv_d)
					if(sv_a >9) THEN
					#{
						sv_d = sv_d +4
					#}
					else
					#{
						sv_d = sv_d +3
					#}
					endif
					PRINT(sv_d)
					sv_e = GETPOSITION(CUST.LADISB.oldTotAmt,sv_c)
					PRINT(sv_e)
					sv_h= sv_e - sv_d
					sv_h = sv_h -1
					if(sv_a == CUST.LADISB.totalCount) THEN
					#{
						sv_l = STRLEN(CUST.LADISB.oldTotAmt)
						#sv_h = sv_l - sv_d
						sv_h = sv_l
					#}
					ENDIF				
					CUST.LADISB.totalAmount = MID$(CUST.LADISB.oldTotAmt,sv_d,(sv_h-1))
					PRINT(CUST.LADISB.totalAmount)
					
					lv_s = "convtotalAmount|SELECT REPLACE(?SVAR,',','') FROM DUAL"
					PRINT(lv_s)
					BANCS.INPARAM.BINDVARS = CUST.LADISB.totalAmount
					PRINT(BANCS.INPARAM.BINDVARS)

					lv_d = urhk_dbSelectWithBind(lv_s)
					PRINT(lv_d)

					IF(lv_d == 0)THEN
					#{
						CUST.LADISB.totalAmount = BANCS.OUTPARAM.convtotalAmount
						PRINT(CUST.LADISB.totalAmount)
					#}
					ENDIF

					#------------------------------------------------------------------------------
					#If currency codes are different, Convert Amount
					#------------------------------------------------------------------------------
					IF(CUST.LADISB.oldLoanCrncyCode!=CUST.LADISB.OprAcctCrncyCode) THEN
					#{
						PRINT(CUST.LADISB.oldLoanCrncyCode)
						PRINT(CUST.LADISB.OprAcctCrncyCode)
						PRINT(CUST.LADISB.totalAmount)
						PRINT(CUST.LADISB.limitRateCode)

						
						BANCS.INPARAM.InputAmount 	= CUST.LADISB.totalAmount
						BANCS.INPARAM.FromCurrency	= CUST.LADISB.oldLoanCrncyCode
						BANCS.INPARAM.ToCurrency 	= CUST.LADISB.OprAcctCrncyCode
						BANCS.INPARAM.RateCode 		= CUST.LADISB.limitRateCode
						BANCS.INPARAM.Rate 			= 0.00
						BANCS.INPARAM.CustId 		= ""
						
						sv_u = urhk_B2k_ConvertAmount("")
						print(sv_u)
						
						IF(sv_u == 0)THEN
						#
							CUST.LADISB.ConvTrcAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
							print(CUST.LADISB.ConvTrcAmt)
								
							IF(CDOUBLE(CUST.LADISB.ConvTrcAmt) < 0) THEN
							#{
								CUST.LADISB.ConvTrcAmt = -1 * CDOUBLE(CUST.LADISB.ConvTrcAmt)
								print(CUST.LADISB.ConvTrcAmt)
								#}
							ELSE
								#{
								print(CUST.LADISB.ConvTrcAmt)
							#}
							ENDIF
						ELSE
						#{
							CUST.LADISB.statFlg = "E"
							CUST.LADISB.errMsg = "Error occured in converting the Amount"
							PRINT(CUST.LADISB.errMsg)
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ELSE
					#{
						CUST.LADISB.ConvTrcAmt = CUST.LADISB.totalAmount
					#}
					ENDIF
					
					#-----------------------------------------------------------------------------
					# Inserting rows into LADISB_PAYOFF_OLDLOAN custom table
					#-----------------------------------------------------------------------------
					sv_s = "INSERT INTO CUSTOM.C_LADISB_PAYOFF_OLDLOAN("
					sv_s = sv_s + " srno,loan_foracid,loan_op_foracid,"
					sv_s = sv_s + " la_op_amt,la_op_crncy_code,old_foracid,"
					sv_s = sv_s + " old_la_amt,old_la_crncy_code,payoff_flg,"
					sv_s = sv_s + " del_flg,entity_cre_flg,rcre_time,"
					sv_s = sv_s + " lchg_user_id,rcre_user_id,lchg_time,bank_id)"
					sv_s = sv_s + " VALUES ("
					sv_s = sv_s + "?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",'N'"
					sv_s = sv_s + ",'N'"
					sv_s = sv_s + ",sysdate"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ",sysdate"
					sv_s = sv_s + ",?SVAR"
					sv_s = sv_s + ")"
					print(sv_s)
					PRINT(CUST.LADISB.foracid)
					
					CUST.LADISB.count = sv_t
					
					BANCS.INPARAM.BINDVARS = ""
					BANCS.INPARAM.BINDVARS = CUST.LADISB.count + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.creditAcctNum + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.ConvTrcAmt + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.OprAcctCrncyCode + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldLoanacctNo + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.totalAmount + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldLoanCrncyCode + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.payofflag + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					print(BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSQLWithBind(sv_s)
					print(sv_d)

					IF (sv_d == 0) THEN
					#{
						sv_d = urhk_dbSqlWithBind("COMMIT")
							   PRINT(sv_d)
					#}
					ENDIF
					sv_t = sv_t +1
				#}
				ENDIF		
				
			sv_g = sv_g +1
		#}
		DO
		
	#}
	ENDIF
		
TRACE OFF
end-->
