			CUST.DATA.lnkdEvntId = BANCS.OUTPARAM.lnkdEvntId
			BANCS.INPUT.inputAmount = CUST.DATA.tranAmt		
			BANCS.STDIN.ScriptName = BANCS.OUTPARAM.scrName
			BANCS.INPUT.CallMode = "SCRIPT"
			BANCS.INPUT.chrgCollCrncy = CUST.DATA.acctCrncyCode
			
			IF(CUST.DATA.eventId == "CLTRF")THEN
			#{
				CUST.DATA.ODacnt = CUST.DATA.custacc
			#}
			ENDIF

			CALL(BANCS.OUTPARAM.scrName)
			CUST.DATA.chrgAmt = BANCS.OUTPUT.collAmount
			PRINT(CUST.DATA.chrgAmt)
			CUST.DATA.chrgAmt =  CDOUBLE(CUST.DATA.chrgAmt) +  CDOUBLE(CUST.DATA.chrgAmt)
			print(CUST.DATA.chrgAmt)
			print(BANCS.OUTPUT.collCrncy)
			#CUST.DATA.evntChrgCrncy = BANCS.OUTPUT.collCrncy
			CUST.DATA.evntChrgCrncy = CUST.DATA.acctCrncyCode
			
			IF(CUST.DATA.lnkdEvntId != "")THEN
			#{
				sv_s  = "vatScrName|select file_name from tbaadm.ptt, tbaadm.adm where ptt.bank_id=?SVAR and ptt.bank_id = adm.bank_id"
				sv_s = sv_s + " and event_type = ?SVAR and event_id = ?SVAR and"
				sv_s = sv_s + " ptt.amt_derv_srl_num = adm.amt_drv_srl_num and adm.amt_ind='S' and ptt.ENTITY_CRE_FLG='Y' "
				sv_s = sv_s + " and ptt.ENTITY_CRE_FLG = adm.ENTITY_CRE_FLG and ptt.DEL_FLG = 'N' and ptt.DEL_FLG = adm.DEL_FLG"
				
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + "LNKED" + "|" + CUST.DATA.lnkdEvntId
				print(BANCS.INPARAM.BINDVARS)
				
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF(sv_d == 0) THEN
				#{
					print(BANCS.OUTPARAM.vatScrName)
					
					BANCS.INPUT.inputCrncy = CUST.DATA.evntChrgCrncy
					BANCS.INPUT.inputAmount = CUST.DATA.chrgAmt
					BANCS.INPUT.entityId = CUST.DATA.acid
					
					BANCS.INPUT.chrgCollCrncy = CUST.DATA.acctCrncyCode
					BANCS.INPUT.CallMode = "SCRIPT"
					CALL(BANCS.OUTPARAM.vatScrName)
					CUST.VAT.vatcollAmount = BANCS.OUTPUT.collAmount
					print(CUST.VAT.vatcollAmount)
					CUST.DATA.vatAmt = CDOUBLE(CUST.DATA.vatAmt) +  CDOUBLE(CUST.VAT.vatcollAmount)
					#CUST.DATA.vatAmt = CUST.DATA.vatAmt +  CUST.VAT.vatcollAmount
					print(CUST.DATA.vatAmt)					

					print(BANCS.OUTPUT.collCrncy)
					#CUST.DATA.evntVATCrncy = BANCS.OUTPUT.collCrncy
					CUST.DATA.evntVATCrncy = CUST.DATA.acctCrncyCode
				#}
				ENDIF
			#}
			ENDIF
			
			CUST.DATA.lnkdEvntId = ""
			PRINT(sv_m)
			sv_z = urhk_dbCursorFetch(sv_m)
			PRINT(sv_z)
		#}
		DO
		sv_z = urhk_dbCursorClose(sv_m)
		
		print(CUST.DATA.vatAmt)
		print(CUST.DATA.chrgAmt)
		print(CUST.DATA.tranAmt)
		
		CUST.DATA.TotalTranAmt = CDOUBLE(CUST.DATA.tranAmt) + CDOUBLE(CUST.DATA.chrgAmt) + CDOUBLE(CUST.DATA.vatAmt)
		PRINT(CUST.DATA.TotalTranAmt)
		
		#-------------Get Charge Amt and VAT -----End (11-JUL-2025)
		
		print(CUST.DATA.EffAvailableAmt)
		
			#CUST.DATA.totalAmt =CUST.DATA.tranAmt
			CUST.DATA.totalAmt =CUST.DATA.TotalTranAmt


				IF(CDOUBLE(CUST.DATA.totalAmt) > CDOUBLE(CUST.DATA.EffAvailableAmt))THEN
				#{
					CUST.DATA.balcheck = "N"

					CUST.DATA.errMsg = "Transaction Amount plus charge Exceeds Available Balance"
					sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
					GOTO ENDOFSCRIPT

				#}	
				ENDIF
			

		ENDIF


		
	#}
#	ENDIF
	
	#}
      ENDIF
	


