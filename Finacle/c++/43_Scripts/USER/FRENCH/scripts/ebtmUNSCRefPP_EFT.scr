<--start
trace on
sv_r = urhk_B2k_PrintRepos("BANCS")
PRINT(sv_r)
#Rep/Class

IF(FIELDEXISTS(CUST.GETDATADRC.destCustNameeft))THEN

	print(CUST.GETDATADRC.destCustNameeft)

	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	EBSRV.GLBDATA.InfName = ""
	EBSRV.GLBDATA.Address = ""
	EBSRV.GLBDATA.IdNo = ""
	EBSRV.GLBDATA.TypeOfId = ""
	EBSRV.GLBDATA.DateOfIssue = ""
	BANCS.INPUT.ValMode = ""

	sv_r = urhk_B2k_PrintRepos("EBSRV")
	print(sv_r)
	#####exitscript
	#SrvValues
	EBSRV.GLBDATA.trans_amt ="" 
	EBSRV.GLBDATA.trans_crncy = ""
	EBSRV.GLBDATA.totCAmt = 0
	EBSRV.GLBDATA.totDAmt = 0
	EBSRV.GLBDATA.chrgDrYN = ""
	EBSRV.GLBDATA.sdnCnt = ""
	EBSRV.GLBDATA.MatchCnt = 0
	EBSRV.GLBDATA.MMatchCnt = 0
	EBSRV.GLBDATA.stCnt = ""
	EBSRV.GLBDATA.tranParticulars = CUST.GETDATADRC.destCustNameeft
	print(EBSRV.GLBDATA.tranParticulars)
	EBSRV.GLBDATA.tran_rmks  = CUST.GETDATADRC.destCustNameeft
	print(EBSRV.GLBDATA.tran_rmks)
	EBSRV.GLBDATA.partTranType ="C"
	print(EBSRV.GLBDATA.partTranType)
	EBSRV.GLBDATA.InfName = CUST.GETDATADRC.destCustNameeft
	print(EBSRV.GLBDATA.InfName)
	EBSRV.GLBDATA.tranParticulars  = CUST.GETDATADRC.destCustNameeft
	print(EBSRV.GLBDATA.tranParticulars)

	BANCS.INPUT.ExceptionIgnoreFlg="C"
	print(BANCS.INPUT.ExceptionIgnoreFlg)

	BANCS.INPARAM.ValMode=""
	print(BANCS.INPARAM.ValMode)

	lv_d = "pString | select regexp_replace(?SVAR,'[^[:alnum:]'' '']', NULL) from dual "
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars 
	lv_u = urhk_dbSelectWithBind(lv_d)
	if(lv_u==0)then
		lv_i = BANCS.OUTPARAM.pString
		print(lv_i)
	endif
	
	### SDN
	EBSRV.GLBDATA.tranParticulars = EBSRV.GLBDATA.tranParticulars
	print(EBSRV.GLBDATA.tranParticulars)
	sv_d = "sdnCnt| select count(*) from custom.ofac_sdn_tbl where bank_id='43' and sdn_name = '" + EBSRV.GLBDATA.tranParticulars+  "' "
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.sdnCnt = BANCS.OUTPARAM.sdnCnt
		print(EBSRV.GLBDATA.sdnCnt)
	else
		EBSRV.GLBDATA.sdnCnt = "0"
		print(EBSRV.GLBDATA.sdnCnt)
	endif
	print(EBSRV.GLBDATA.sdnCnt)

	## OFAC
	sv_d = "sdnaltTcn| select count(*) sdnaltTcnt  from custom.ofac_alt_tbl alt where alt.ENT_NUM is not null  and alt.bank_id='43'  and trim(alt.ALT_NAME) = '" + EBSRV.GLBDATA.tranParticulars+  "'  and alt.entity_cre_flg='Y' and alt.del_flg='N' "
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.sdnaltTcn = BANCS.OUTPARAM.sdnaltTcn
		print(EBSRV.GLBDATA.sdnaltTcn)
	else
		EBSRV.GLBDATA.sdnaltTcn=0
		print(EBSRV.GLBDATA.sdnaltTcn)
	endif
	## LOCAL_BCDC
	sv_d = "locbcdcCnt| select count(*) locbcdcCnt  from custom.local_bcdc lbcdc where lbcdc.BLACKLIST_NAME is not null  and trim(lbcdc.BLACKLIST_NAME) = '" + EBSRV.GLBDATA.tranParticulars+  "' "
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.locbcdcCnt = BANCS.OUTPARAM.locbcdcCnt
		print(EBSRV.GLBDATA.locbcdcCnt)
	else
		EBSRV.GLBDATA.locbcdcCnt=0
		print(EBSRV.GLBDATA.locbcdcCnt)
	endif
	## LOCAL EBC
	sv_d = "locebcCnt| select count(*)  locebcCnt from custom.local_ebc lebc   where lebc.NAME is not null  and trim(lebc.NAME) = '" + EBSRV.GLBDATA.tranParticulars+  "' "
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.locebcCnt = BANCS.OUTPARAM.locebcCnt
		print(EBSRV.GLBDATA.locebcCnt)
	else
		EBSRV.GLBDATA.locebcCnt=0
		print(EBSRV.GLBDATA.locebcCnt)
	endif

	## UN
	sv_d = "euSnCnt| select count(*)  euSnCnt  from CUSTOM.EB_EU_UK_UN_SANCT_TBL eu where eu.NAME is not null and trim(eu.FIRST_NAME_2)= '" + EBSRV.GLBDATA.tranParticulars+  "' "
	BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars 
	print(BANCS.INPARAM.BINDVARS)
	print(sv_d)
	sv_u = urhk_dbSelectWithBind(sv_d)
	if(sv_u==0)then
		EBSRV.GLBDATA.euSnCnt = BANCS.OUTPARAM.euSnCnt
		print(EBSRV.GLBDATA.euSnCnt)
	else
		EBSRV.GLBDATA.euSnCnt=0
		print(EBSRV.GLBDATA.euSnCnt)
	endif
endif

USNCHK:
	print(EBSRV.GLBDATA.MatchCnt)
	if((cdouble(EBSRV.GLBDATA.sdnCnt)>=1) or (cdouble(EBSRV.GLBDATA.sdnaltTcn)>=1)  or (cdouble(EBSRV.GLBDATA.locbcdcCnt)>=1) or (cdouble(EBSRV.GLBDATA.locebcCnt)>=1) or (cdouble(EBSRV.GLBDATA.euSnCnt)>=1) )then
			print("Restrict")
		IF (BANCS.STDIN.userWorkClass!="215") THEN
			lv_e = "EFT Transaction for  "+ EBSRV.GLBDATA.tranParticulars +" AML CHECK FAILED CONTACT COMPLIANCE - Workclass 215 "
			print(lv_e)
			sv_r = urhk_SRV_SetErr(lv_e)
			PRINT(sv_r)
		ENDIF
	endif
VAYU:

end-->

