#------------------------------------------------------------------------
#  Name            : ccrrVerifyReq.scr
#  Description     : Verify CIF request.
#  Date            : 05-10-2023
#  Author          : JAMES GICHIRI
#  Menu Option     : CCRRM
#  Srl. No         : 
#  Version		   Date            Author                 Description.
#  -------         ------          ------                 ------------
#  1.0             05-10-2023      James Gichiri          Original Version
#-------------------------------------------------------------------------
<--start
trace on
        if(repexists("CUST") == 0) then
                createrep("CUST")
        endif
        if (classexists("CUST", "CRRMVER") == 0) then
                createclass("CUST", "CRRMVER", 5)
        endif
	 

	if (classexists("CUST", "CCRRM") == 0) then
                createclass("CUST", "CCRRM", 5)
        endif
	
	CUST.CCRRM.Statuscode = ""
	sv_c = "FINAL_RISK_SCORE,RISK_RATING,CIF_ID"
	sv_c = sv_c + " |select"
	sv_c = sv_c + " c.FINAL_RISK_SCORE,c.RISK_RATING,c.CIF_ID"
        sv_c = sv_c + " from crmuser.accounts a,CUSTOM.INT_CREDIT_CRA_DRC c where a.bank_id ='43' and  "
	sv_c = sv_c + " c.CIF_ID = a.orgkey and a.corp_id is null and c.bank_id=a.bank_id and STATUS_FLG='V5'"
	print(sv_c)

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
	print(BANCS.INPARAM.BINDVARS)
	
	sv_e = urhk_dbCursorOpenWithBind(sv_c)
	print(sv_e)

	if(sv_e == 0)then
	#{
			###
			sv_z = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			sv_q = urhk_dbCursorFetch(sv_z)
			print(sv_q)

			BANCS.INPUT.RECOUNT = cint("1")
			print(BANCS.INPUT.RECOUNT)

			IF(sv_q == 1) THEN
			#{
				sv_x = urhk_dbCursorClose(sv_z)
				print(sv_x)
				exitscript
			#}
			ENDIF
			print(sv_q)

		WHILE(sv_q==0)
		#{

			#CUST.CRRMVER.custtype=trim(CUST.CCRRM.customertype)
			CUST.CRRMVER.cif_id = trim(BANCS.OUTPARAM.CIF_ID)
			CUST.CRRMVER.ChannelCode = "CRM"
			CUST.CRRMVER.SuccessOrFailure = "F"
			
	
			#IF(CUST.CRRMVER.custtype=="I")THEN
			#{
				CUST.CRRMVER.custtypeservice = "RetailCustomer"
			#}
			#ENDIF
			
			#IF(CUST.CRRMVER.custtype=="C")THEN
			#{
				##CUST.CRRMVER.custtypeservice = "CorporateCustomer"
			#}
			#ENDIF

			sv_a = "messagedatatime,reqUUId,timeStampFF3|SELECT to_char(systimestamp,'yyyy-mm-ddhh:mi:ssxff'),regexp_replace(rawtohex(sys_guid()),'([A-F0-9]{8})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{12})', '\1-\2-\3-\4-\5'),to_char(systimestamp,'DD-MM-YYYY HH24:MI:SS:FF3') from dual"
			sv_b = urhk_dbSelectWithBind(sv_a)
			print(sv_b)
			if(sv_b ==0)then
			#{
				CUST.CRRMVER.reqUUId = BANCS.OUTPARAM.reqUUId
				CUST.CRRMVER.messagedatatime = BANCS.OUTPARAM.messagedatatime
				print(CUST.CRRMVER.messagedatatime)
				CUST.CRRMVER.tt  = MID$(CUST.CRRMVER.messagedatatime,0,10)
				CUST.CRRMVER.ttt = MID$(CUST.CRRMVER.messagedatatime,10,12)
				CUST.CRRMVER.messagedatatime = CUST.CRRMVER.tt  + "T" + CUST.CRRMVER.ttt
				BANCS.INPARAM.SYSDATE = BANCS.OUTPARAM.timeStampFF3
				print(BANCS.INPARAM.SYSDATE)
			#}
			else
			#{
			#2022-01-2604:57:34.290868
			CUST.CRRMVER.messagedatatime = "2022-01-11T15:18:54.167"
				CUST.CRRMVER.reqUUId = ""
			#}
			endif
			if(CUST.CRRMVER.reqUUId=="")then
				CUST.CRRMVER.RequestUUID =BANCS.INPARAM.SYSDATE
			else
				CUST.CRRMVER.RequestUUID = CUST.CRRMVER.reqUUId
			endif
			BANCS.INPARAM.milliSec = MID$(BANCS.INPARAM.SYSDATE,20,3)
			BANCS.INPARAM.Day = LEFT$(BANCS.INPARAM.SYSDATE,2)
			BANCS.INPARAM.Month = MID$(BANCS.INPARAM.SYSDATE,3,2)
			BANCS.INPARAM.Year = MID$(BANCS.INPARAM.SYSDATE,8,2)
			BANCS.INPARAM.MesgYear = MID$(BANCS.INPARAM.SYSDATE,6,4)
			BANCS.INPARAM.Hour = MID$(BANCS.INPARAM.SYSDATE,11,2)
			BANCS.INPARAM.Minute = MID$(BANCS.INPARAM.SYSDATE,14,2)
			BANCS.INPARAM.Second = MID$(BANCS.INPARAM.SYSDATE,17,2)

			BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second + BANCS.INPARAM.milliSec
			BANCS.INPARAM.MESSAGEDATETIME = BANCS.INPARAM.MesgYear + "-" + BANCS.INPARAM.Month + "-" + BANCS.INPARAM.Day + "T" + BANCS.INPARAM.Hour + ":" +  BANCS.INPARAM.Minute + ":" + BANCS.INPARAM.Second + "."+BANCS.INPARAM.milliSec

			BANCS.INPARAM.UserId = BANCS.STDIN.userId
			BANCS.INPARAM.BANKID = BANCS.STDIN.contextBankId
			BANCS.INPARAM.REQUESTUUID = CUST.CRRMVER.RequestUUID 
			
			
			BANCS.INPARAM.SERVICEREQUESTID = "verifyCustomerDetails" 
			BANCS.INPARAM.CHANNELID = "CRM"
			BANCS.INPARAM.SERVICEREQUESTVERSION = "10.2"
			BANCS.INPARAM.TIMEZONE = "EAT+05:30"
			BANCS.INPARAM.UserApplId = "CRM"
			BANCS.INPARAM.UserChannelId = "FI"
			BANCS.INPARAM.SERVICE_NAME = "FIJCA"
			BANCS.INPARAM.SEND_RECV_FLG = "R"

			CUST.CRRMVER.fiChnId	= "CRM"
			CUST.CRRMVER.XmlMessage = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"				
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<?xml version='1.0' encoding='UTF-8'?>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<FIXML xsi:schemaLocation='http://www.finacle.com/fixml verifyCustomerDetails.xsd' xmlns='http://www.finacle.com/fixml' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<Header>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<RequestHeader>" 
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<MessageKey>" 
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<RequestUUID>"+CUST.CRRMVER.RequestUUID+"</RequestUUID>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<ServiceRequestId>"+BANCS.INPARAM.SERVICEREQUESTID+"</ServiceRequestId>" 
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<ServiceRequestVersion>"+BANCS.INPARAM.SERVICEREQUESTVERSION+"</ServiceRequestVersion>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<ChannelId>"+CUST.CRRMVER.fiChnId+"</ChannelId>" 
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<LanguageId></LanguageId>" 
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</MessageKey>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<RequestMessageInfo>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<BankId>"+BANCS.STDIN.contextBankId+"</BankId>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<TimeZone></TimeZone>" 
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<EntityId></EntityId>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<EntityType></EntityType>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<ArmCorrelationId></ArmCorrelationId>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<MessageDateTime>"+CUST.CRRMVER.messagedatatime+"</MessageDateTime>" 
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</RequestMessageInfo>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</RequestHeader>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</Header>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<Body>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<verifyCustomerDetailsRequest>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<CustomerVerifyRq>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<cifId>"+CUST.CRRMVER.cif_id+"</cifId>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<decision>Approve</decision>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "<entityName>"+CUST.CRRMVER.custtypeservice+"</entityName>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</CustomerVerifyRq>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</verifyCustomerDetailsRequest>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</Body>"
			CUST.CRRMVER.XmlMessage = CUST.CRRMVER.XmlMessage + "</FIXML>"
			print(CUST.CRRMVER.XmlMessage)

			BANCS.INPARAM.SERVICE_NAME="FIJCA"
			BANCS.INPARAM.SEND_RECV_FLG="R"
			sv_l=urhk_ConnectToFIAndSendMsg(CUST.CRRMVER.XmlMessage)
			print(sv_l)
			if(fieldexists(BANCS.OUTPARAM.ErrCode)==1)then
			#{
				print(BANCS.OUTPARAM.ErrCode)
			#}
			endif
			if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
			#{
				print(BANCS.OUTPARAM.ErrMsg)
			#}
			endif
			IF(fieldexists(BANCS.OUTPARAM.RespMesg))THEN
			#{
				print("Response message is ["+BANCS.OUTPARAM.RespMesg+"]")
				sv_d = BANCS.OUTPARAM.RespMesg
				sv_l = strlen(sv_d)
				CUST.CRRMVER.Response = BANCS.OUTPARAM.RespMesg
				CUST.CRRMVER.Status = GETPOSITION(CUST.CRRMVER.Response,"<Status>")
				print(CUST.CRRMVER.Status)
				IF (CUST.CRRMVER.Status != "") THEN
				#{
					CUST.CRRMVER.Status1 = GETPOSITION(CUST.CRRMVER.Response,"</Status>")
					print(CUST.CRRMVER.Status1)
					CUST.CRRMVER.StatusFlag= mid$(CUST.CRRMVER.Response,cint(CUST.CRRMVER.Status)+7,cint(CUST.CRRMVER.Status1)-cint(CUST.CRRMVER.Status)-8)
					print(CUST.CRRMVER.StatusFlag)
				#}
			ELSE
				#{
			    CUST.CRRMVER.StatusFlag = ""
				#}
			ENDIF
				
				IF(trim(CUST.CRRMVER.StatusFlag)=="SUCCESS")THEN
				#{
					CUST.CRRMVER.SuccessOrFailure = "S"
					print("CIF Verification Success")
				#}
				ENDIF
				if(trim(CUST.CRRMVER.StatusFlag)!="SUCCESS")THEN
				#{
					CUST.CRRMVER.SuccessOrFailure = "F"
					print("CIF Verification failed")
					
					#----- Error Capturing Starts
					
					sv_x = CUST.CRRMVER.Response
					sv_y = "<ErrorCode>"
					sv_z = "</ErrorCode>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.CRRMVER.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.CRRMVER.errorCode)
					#}
					ENDIF
					sv_x = CUST.CRRMVER.Response
					sv_y = "<ErrorDesc>"
					sv_z = "</ErrorDesc>"
					sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
					sv_e = GETPOSITION(sv_x, sv_z) - 1
					IF (GETPOSITION(sv_x, sv_y) != 0) THEN
					#{
						CUST.CRRMVER.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
						print(CUST.CRRMVER.errorDesc)
					#}
					ENDIF

					
					#----- Error Capturing Ends
			#}
				#}
				ENDIF

			#}
			else
			#{
				if(fieldexists(BANCS.OUTPARAM.ErrCode)==1)then
				#{
					print(BANCS.OUTPARAM.ErrCode)
					CUST.CRRMVER.SuccessOrFailure = "F"
				#}
				endif
				if(fieldexists(BANCS.OUTPARAM.ErrMsg)==1)then
				#{
					print(BANCS.OUTPARAM.ErrMsg)
					CUST.CRRMVER.SuccessOrFailure = "F"
				#}
				endif
				CUST.CRRMVER.SuccessOrFailure = "F"
			#}
			endif

				##################################################################
				IF(FIELDEXISTS(CUST.CRRMVER.SuccessOrFailure) == 1)THEN
					#{
						print(CUST.CRRMVER.SuccessOrFailure)
						IF(trim(CUST.CRRMVER.SuccessOrFailure) == "S")THEN
						#{
							CUST.CCRRM.ModSuccessflg ="M"
							CUST.CCRRM.Statuscode = "P"
							CUST.CCRRM.SorFmessage = "CIF Verified successfully"		
						#}ss
						ELSE
						#{
							IF(FIELDEXISTS(CUST.CRRMVER.errorDesc) == 1)THEN
							#{
								CUST.CCRRM.SorFmessage = CUST.CRRMVER.errorDesc
							#}
							ELSE
							#{
								CUST.CCRRM.SorFmessage = "CIF Modification failed,Manual update required"
							#}
							ENDIF
							CUST.CCRRM.Statuscode = "F"
						#}
						ENDIF	
					ENDIF
			
						sv_s = "update CUSTOM.INT_CREDIT_CRA_DRC set STATUS_FLG=?SVAR,"
						sv_s = sv_s + "REMARKS= substr(replace (q'["+CUST.CCRRM.SorFmessage+"]',q'[|]',q'[ ]'),0,200) "
						sv_s = sv_s + "where CIF_ID=?SVAR "
						#sv_s = sv_s + "and REF_CODE=?SVAR "
						sv_s = sv_s + "and bank_id=?SVAR"
						print(sv_s)
						BANCS.INPARAM.BINDVARS =  CUST.CCRRM.Statuscode + "|" + CUST.CRRMVER.cif_id  +"|"+ BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						print(sv_s)
						sv_d=urhk_dbSqlWithBind(sv_s)
						IF (sv_d == 0)  THEN
							sv_d = urhk_dbSQLWithBind("COMMIT")
						ENDIF
						
			GOTO NEXTREC
			#BANCS.INPUT.RECCOUNT = CINT(BANCS.INPUT.RECCOUNT) + 1
			#PRINT(BANCS.INPUT.RECCOUNT)

			NEXTREC:
			sv_q = urhk_dbCursorFetch(sv_z)
			print(sv_q)
		#}
		DO
		sv_q = urhk_dbCursorClose(sv_z)
		print(sv_q)
	#}
	ENDIF
	
EXITSCRIPT
TRACE OFF	
	
end-->

