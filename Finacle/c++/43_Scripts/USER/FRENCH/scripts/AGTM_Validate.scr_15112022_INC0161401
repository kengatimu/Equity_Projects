<--start
trace on

#--------------------------------------------------------------------
# Executing the dbSelect Operation to get the del_flg value
#--------------------------------------------------------------------
sv_a = urhk_VAL_GetVal("agent_code")
sv_b = BANCS.OUTPARAM.fldValue

sv_a = urhk_VAL_GetVal("sol_id")
sv_z = BANCS.OUTPARAM.fldValue

sv_f="N"

sv_c = "count|select count (*) from tbaadm.AGT where AGT.BANK_ID = ?SVAR AND " 
sv_c = sv_c + " agent_code= ?SVAR and sol_id= ?SVAR "
BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId + "|" + sv_b + "|" + sv_z
sv_d = urhk_dbSelectWithBind(sv_c)
IF(sv_d == 0) THEN
	PRINT(BANCS.OUTPARAM.count)
	IF(BANCS.OUTPARAM.count > 2) THEN			
		sv_e="0"	
	else	
		sv_e="1"	
	ENDIF
ENDIF

#--------------------------------------------------------------------
# Executing the validation function ExecVal for accept criteria for  
# FETCH for ADD
#--------------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "S") then
	#To check for the existence of the record for the criteria field Agent Code
	if (sv_e == "0") then
		sv_g = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=004")
	endif
endif

#--------------------------------------------------------------------
# Executing the validation function ExecVal for FETCH for MODIFY
#--------------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "m") then	
	#To check for the existence of the record for the criteria field Agent Code
	if (sv_e != "0") then
		sv_z = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=005")
	else
        if (sv_f == "Y") then
			#To check the del_flg value for the criteria field Agent Code
			sv_p = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=007")
        endif
	endif
endif

#--------------------------------------------------------------------
# Executing the validation function ExecVal for  ADD, MODIFY
#--------------------------------------------------------------------
if ((BANCS.INPUT.VAL_CALL_MODE == "A") OR (BANCS.INPUT.VAL_CALL_MODE == "M")) then
	#Updating the acid value of the corresponding foracid for the field oper_acct_num
    sv_n = urhk_VAL_GetVal("oper_acct_num")
    sv_o = BANCS.OUTPARAM.fldValue
    sv_c = "operacid|select acid from GAM where" 
    sv_c = sv_c + " GAM.BANK_ID = ?SVAR AND " 
    sv_c = sv_c + " foracid= ?SVAR "
    BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId + "|" + sv_o
	sv_d = urhk_dbSelectWithBind(sv_c)
    if (fieldexists(BANCS.OUTPARAM.operacid)) then
        sv_k = BANCS.OUTPARAM.operacid
        sv_l = "oper_credit_acid|"+sv_k
        sv_m = urhk_VAL_SetVal(sv_l)
    endif

	#Updating the acid value of the corresponding foracid for the field inoper_acct_num
    sv_n = urhk_VAL_GetVal("inoper_acct_num")
    sv_p = BANCS.OUTPARAM.fldValue
    sv_q = "inoperacid|select acid from GAM where" 
    sv_q = sv_q + " GAM.BANK_ID = ?SVAR AND " 
    sv_q = sv_q + " foracid= ?SVAR "
    BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId + "|" + sv_p
	sv_r = urhk_dbSelectWithBind(sv_q)
    if (fieldexists(BANCS.OUTPARAM.inoperacid)) then
        sv_s = BANCS.OUTPARAM.inoperacid
        sv_t = "inoper_credit_acid|"+sv_s
        sv_u = urhk_VAL_SetVal(sv_t)
    endif
    
	sv_a = urhk_ExecVal("validateRefCode|refCode=&agent_title_code|refRecType=45|refDesc=&h_desc|MANDATORY")
	sv_c = urhk_ExecVal("validateRefCode|refCode=&agent_city_code|refRecType=01|refDesc=&agent_city_desc|MANDATORY")
	sv_d = urhk_ExecVal("validateRefCode|refCode=&agent_state_code|refRecType=02|refDesc=&agent_state_desc")
	sv_d = urhk_ExecVal("validateRefCode|refCode=&agent_cntry_code|refRecType=03|refDesc=&agent_cntry_desc")
	sv_e = urhk_ExecVal("validateCrncyCode|crncyCode=&crncy_code|crncyCodeDesc=&h_crncy_code_desc")
	sv_f = urhk_ExecVal("validateAcctIdForTranCreation|foracid=&oper_acct_num|acid=&oper_credit_acid|crncyCode=&oper_credit_crncy_code|solId=&oper_sol_id|acctName=&oper_acct_name|MANDATORY")
	if (sv_f == 0) then
		sv_g = urhk_ExecVal("validateAcctIdWithSolCheck|foracid=&oper_acct_num|acid=&oper_credit_acid")
	endif
	if ((sv_f == 0) AND (sv_g == 0)) then
    	sv_h = urhk_ExecVal("validateSystemOnlyAcct|foracid=&oper_acct_num|acid=&oper_credit_acid")
	endif
	sv_i = urhk_ExecVal("validateAcctIdForTranCreation|foracid=&inoper_acct_num|acid=&inoper_credit_acid|crncyCode=&inoper_credit_crncy_code|solId=&inoper_sol_id|acctName=&inoper_acct_name|MANDATORY")
    if (sv_i == 0) then
    	sv_j = urhk_ExecVal("validateAcctIdWithSolCheck|foracid=&inoper_acct_num|acid=&inoper_credit_acid")
	endif
	if ((sv_i == 0) AND (sv_j == 0)) then
 		sv_k = urhk_ExecVal("validateSystemOnlyAcct|foracid=&inoper_acct_num|acid=&inoper_credit_acid")
	endif
	sv_p = urhk_ExecVal("validatePercentage|pcnt=&itax_pcnt")
	if (sv_e == 0) then
		sv_g=urhk_VAL_GetVal("int_amt_ceiling")
		sv_h=BANCS.OUTPARAM.fldValue
		if (sv_h!="") then
			sv_q=getposition (sv_h,"|")
			if(sv_q != 0) then
				sv_t=sv_q - 1
				sv_h=LEFT$(sv_h,sv_t)
			endif
			if (CDOUBLE(sv_h)!=0) then
				sv_t = urhk_ExecVal("validateAmountString|amtStr=&int_amt_ceiling") 
			endif
		endif

		sv_g=urhk_VAL_GetVal("security_amt")
		sv_h=BANCS.OUTPARAM.fldValue
		if (sv_h!="") then
			sv_q=getposition (sv_h,"|")
			if(sv_q != 0) then
				sv_t=sv_q - 1
				sv_h=LEFT$(sv_h,sv_t)
			endif
			if (CDOUBLE(sv_h)!=0) then
				sv_u = urhk_ExecVal("validateAmountString|amtStr=&security_amt")
    		endif
		endif

		sv_g=urhk_VAL_GetVal("expected_collection")
		sv_h=BANCS.OUTPARAM.fldValue
		if (sv_h!="") then
			sv_q=getposition (sv_h,"|")
			if(sv_q != 0) then
				sv_t=sv_q - 1
				sv_h=LEFT$(sv_h,sv_t)
			endif
			if (CDOUBLE(sv_h)!=0) then
				sv_v = urhk_ExecVal("validateAmountString|amtStr=&expected_collection")
			endif
		endif
	endif

	sv_n = urhk_VAL_GetVal("no_of_acct_opened")
	sv_z = BANCS.OUTPARAM.fldValue
	
	if (sv_z != "") then
	sv_y = urhk_ExecVal("validateNumber|srlNum=&no_of_acct_opened|IGNORE_ERROR")
    	if (sv_y != 0) then
        	sv_s = urhk_VAL_SetErr("FLD_NAME=no_of_acct_opened|ERR_TYPE=B|ERR_CODE=089")
    	endif
	endif	
    
	#To check if the value of the amount fields is null
    sv_n = urhk_VAL_GetVal("int_amt_ceiling")
	sv_t = BANCS.OUTPARAM.fldValue
	if (sv_t == "") then
		sv_w = "int_amt_ceiling|0.0000"
		sv_x = urhk_VAL_SetVal(sv_w)
	endif
	
	sv_n = urhk_VAL_GetVal("security_amt")
	sv_y = BANCS.OUTPARAM.fldValue
    if (sv_y == "") then
		sv_w = "security_amt|0.0000"
		sv_v = urhk_VAL_SetVal(sv_w)
	endif
	
	sv_n = urhk_VAL_GetVal("expected_collection")
	sv_q = BANCS.OUTPARAM.fldValue
    if (sv_q == "") then
    	sv_w = "expected_collection|0.0000"
    	sv_u = urhk_VAL_SetVal(sv_w)
    endif

	sv_n = urhk_VAL_GetVal("crncy_code")
	sv_r = BANCS.OUTPARAM.fldValue
	sv_n = BANCS.STDIN.homeCrncyCode
    if (sv_r == "") then
        sv_w = "crncy_code|"+sv_n
        sv_a = urhk_VAL_SetVal(sv_w)
    endif    
 
	#Co_mandatory check of the crncy_code when anyof the three amounts fields are entered
	if (sv_r == "") then
		if ((sv_t != "") OR (sv_y != "") OR (sv_q != "")) then
			sv_s = urhk_VAL_SetErr("FLD_NAME=crncy_code|ERR_TYPE=B|ERR_CODE=Z44")
	    endif
	endif

    sv_n = urhk_VAL_GetVal("oper_credit_crncy_code")
	sv_u = BANCS.OUTPARAM.fldValue
 
	sv_n = urhk_VAL_GetVal("oper_sol_id")
	sv_v = BANCS.OUTPARAM.fldValue

    if (sv_e == "0") then  
		#Co_mandatory check of the oper_credit_crncy_code when oper_acct_num and oper_sol_id are entered
		if (((sv_o != "") OR (sv_v != "")) AND (sv_u == "")) then
            sv_x = urhk_VAL_SetErr("FLD_NAME=oper_credit_crncy_code|ERR_TYPE=B|ERR_CODE=Z44")
        endif
        #Co_mandatory check of the sol_id when oper_acct_num and oper_credit_crncy_code are entered
	    if (((sv_o != "") OR (sv_u != "")) AND (sv_v == "")) then
			sv_x = urhk_VAL_SetErr("FLD_NAME=oper_sol_id|ERR_TYPE=B|ERR_CODE=Z44") 
	    endif
    endif

	sv_n = urhk_VAL_GetVal("inoper_credit_crncy_code")
	sv_z = BANCS.OUTPARAM.fldValue

	sv_n = urhk_VAL_GetVal("inoper_sol_id")
	sv_s = BANCS.OUTPARAM.fldValue

	if (sv_i == "0") then 
		#Co_mandatory check of the inoper_credit_crncy_code when inoper_acct_num and inoper_sol_id are entered
	    if (((sv_p != "") OR (sv_s != "")) AND (sv_z == "")) then
			sv_w = urhk_VAL_SetErr("FLD_NAME=inoper_credit_crncy_code|ERR_TYPE=B|ERR_CODE=Z44")
        endif
	
	    #Co_mandatory check of the inoper_sol_id when inoper_acct_num and inoper_credit_crncy_code are entered
	    if (((sv_p != "") OR (sv_z != "")) AND (sv_s == "")) then
	        sv_x = urhk_VAL_SetErr("FLD_NAME=inoper_sol_id|ERR_TYPE=B|ERR_CODE=Z44")
	    endif
	endif
endif

#--------------------------------------------------------------------
# Executing the validation function ExecVal for INQUIRE
#--------------------------------------------------------------------
if (BANCS.INPUT.VAL_CALL_MODE == "I") then
	#To check for the existence of the record for the criteria field Agent Code
	if (sv_e != "0") then
		sv_x = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=005")
	endif
endif

#--------------------------------------------------------------------
# Executing the validation function ExecVal for fetch for DELETE
#--------------------------------------------------------------------
if ((BANCS.INPUT.VAL_CALL_MODE == "e") OR (BANCS.INPUT.VAL_CALL_MODE == "D")) then
    #To check for the existence of the record for the criteria field Agent Code
    if (sv_e != "0") then
        sv_z = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=005")
    else
        if (sv_f == "Y") then
        	#To check the del_flg value for the criteria field Agent Code
            sv_p = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=007")
        endif
    endif	
endif

#--------------------------------------------------------------------
# Executing the validation function ExecVal for Fetch for UNDELETE,
# UNDELETE
#--------------------------------------------------------------------
if ((BANCS.INPUT.VAL_CALL_MODE == "f") OR (BANCS.INPUT.VAL_CALL_MODE == "F")) then      
    #To check for the existence of the record for the criteria field Agent Code
    if (sv_e != "0") then
        sv_z = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=005")
    else
        if (sv_f != "Y") then
        	#To check the del_flg value for the criteria field Agent Code
            sv_p = urhk_VAL_SetErr("FLD_NAME=agent_code|ERR_TYPE=B|ERR_CODE=006")
        endif
    endif 
endif

#--------------------------------------------------------------------------
#  Validation to restrict the user from performing CROSS SOL/SET operations
#   As Sol Id is hidden field Inquiry also not allowed
#--------------------------------------------------------------------------
if (BANCS.STDIN.EffectiveTenor == "C") then
	sv_b=urhk_VAL_GetVal("sol_id")
	sv_s=BANCS.OUTPARAM.fldValue

	if (BANCS.STDIN.mySolId != sv_s) then
		sv_c=urhk_VAL_SetErr("FLD_NAME=sol_id|ERR_TYPE=M|ERR_CODE=MSG0316488")
	endif
endif

