###########################################################################################
#
#  Script Name : SWIFTToOtherPaymentSystem.scr
#
#  Description : This script is used to map the SWIFT message number with
#  other payment system message number
#
#  Author      : Pradeep B.R
#				 Rakesh B.N
#
#  Date        : 12-05-2010
#
###########################################################################################
#
<--start
#trace on

#-------------------------- Initializing Variables ----------------------------#

BANCS.OUTPUT.MappedOtherPaysysMsgNum = ""
if((BANCS.INPUT.PaysysIdForMap=="SWIFT") or (BANCS.INPUT.PaysysIdForMap=="RTGS")) then
        BANCS.OUTPUT.MappedOtherPaysysMsgNum = BANCS.INPUT.SWIFTMsgNum
endif

#------------------------------------------------------------------------------# 
if(BANCS.INPUT.PaysysIdForMap=="SFMS")  then

    if(BANCS.INPUT.SWIFTMsgNum=="103") then
        BANCS.OUTPUT.MappedOtherPaysysMsgNum = "100"
		exitscript
    endif
	
    if(BANCS.INPUT.SWIFTMsgNum=="202CV") then
        BANCS.OUTPUT.MappedOtherPaysysMsgNum = "202"
		exitscript
    endif
    if(BANCS.INPUT.SWIFTMsgNum=="754") then
        BANCS.OUTPUT.MappedOtherPaysysMsgNum = ""
		exitscript
    endif

	BANCS.OUTPUT.MappedOtherPaysysMsgNum = BANCS.INPUT.SWIFTMsgNum
endif

exitscript
#trace off
end-->
#------------------------------- END OF SCRIPT --------------------------------#
