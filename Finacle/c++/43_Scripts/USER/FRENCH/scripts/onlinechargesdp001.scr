		#PRINT(CASH.WITH.Tot_Amt)
		#CASH.WITH.with_amt = CUST.CPARAM.amt1
		#PRINT(CASH.WITH.with_amt)
		#CASH.WITH.with_desc = CUST.CPARAM.withDesc1
		#call("nochqchargedp001.scr")
		#print (CASH.WITH.Tot_Amt)
		#print (CASH.WITH.with_amt)
	#}
	ELSE
	#{
		CASH.WITH.Tot_Amt = "0"
		PRINT(CASH.WITH.Tot_Amt)
	#}
	ENDIF
	
	COLL.GLBDATA.tranDate = LEFT$(COLL.GLBDATA.tranDate,10)
	PRINT(COLL.GLBDATA.tranDate)
	IF (FIELDEXISTS(CASH.WITH.type) AND FIELDEXISTS(CASH.WITH.stype)) THEN
	#{
		PRINT(CASH.WITH.type)
		PRINT(CASH.WITH.stype)
		PRINT(BANCS.STDIN.mySolId)
		PRINT(CUST.CPARAM.mySolId1)
		IF (BANCS.STDIN.contextBankId != "56") THEN
		#{
			IF ((CASH.WITH.type == "T") AND (CASH.WITH.stype == "CI") AND (BANCS.STDIN.mySolId != CUST.CPARAM.mySolId1)) THEN
			#{
				sv_s = "owner,schmtype|"
				sv_s = sv_s + " SELECT GAM.acct_ownership,GAM.schm_type"
				sv_s = sv_s + " FROM TBAADM.GAM,TBAADM.DTD"
				sv_s = sv_s + " WHERE GAM.acid = DTD.acid"
				sv_s = sv_s + " AND DTD.tran_id = LPAD(?SVAR,9)"
				sv_s = sv_s + " AND DTD.part_tran_type='C'"
				sv_s = sv_s + " AND DTD.del_flg != 'Y'"
				sv_s = sv_s + " AND GAM.bank_id = DTD.bank_id"
				#sv_s = sv_s + " AND part_tran_srl_num = LPAD(?SVAR,4) "
				sv_s = sv_s + " AND tran_date = TO_DATE(?SVAR,'DD-MM-YYYY')"
				sv_s = sv_s + " AND GAM.bank_id = ?SVAR"
				sv_s = sv_s + " AND rownum < 2"
				print(sv_s)
				#BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.parttrnNum + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
				BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + COLL.GLBDATA.tranDate  + "|"  + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d=urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d != 0) THEN
				#{
					CUST.TMCHRG.errMMsg = "Error in selecting records"
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CASH.WITH.nocharge = BANCS.OUTPARAM.owner
					CASH.WITH.stype = BANCS.OUTPARAM.schmtype
					print(CASH.WITH.nocharge)
					print(CASH.WITH.stype)
				#}
				ENDIF
				
				IF ((CASH.WITH.Trf_Flg == "Y") AND ((CASH.WITH.stype == "CAA") OR (CASH.WITH.stype == "SBA")))THEN
				#{
					#CASH.WITH.tfee = "55"
					#Changes done as per porting3
					CASH.WITH.tfee = "110"
					print(CASH.WITH.tfee)
					
					CASH.WITH.negat ="-1"
					CASH.WITH.Tot_Amt = cdouble(CASH.WITH.tfee)* cdouble(CASH.WITH.negat)
					CASH.WITH.with_amt = CASH.WITH.tfee
					print (CASH.WITH.Tot_Amt)
					print (CASH.WITH.with_amt)
					#CALL("trfchargedp001.scr")
					
					CUST.GCHRG.tranType = "T"
					#CUST.GCHRG.tranSubType = "BI"
					CUST.GCHRG.tranSubType = "CI"
					CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
					CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
					CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
					PRINT(COLL.GLBDATA.trfevent)
					#CUST.GCHRG.eventId = "TMTRF1"
					CUST.GCHRG.eventId = COLL.GLBDATA.trfevent
					CALL("gchrgcommon.scr")
					IF (CUST.GCHRG.successOrFailure == "S") THEN
					#{
						PRINT("Charge collected")
						#}
					ELSE
						#{
						PRINT("Failure")
					#}
					ENDIF
					#}
				ELSE
					#{
					CASH.WITH.Tot_Amt = "0"
				#}
				ENDIF
				#}
			ELSE
				#{
				CASH.WITH.Tot_Amt = "0"
			#}
			ENDIF
		#}
		ENDIF
		
		IF ((CASH.WITH.type == "C") AND (CASH.WITH.stype == "NP")) THEN
		#{
			IF (CASH.WITH.Int_Flg == "Y") THEN
			#{
				CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt1)
				PRINT(CASH.WITH.Tot_Amt)
				CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt1)
				PRINT(CASH.WITH.with_amt)
				CASH.WITH.with_desc = CUST.CPARAM.withDesc2
				IF ((BANCS.STDIN.mySolId == CUST.CPARAM.mySolId2) OR (BANCS.STDIN.mySolId == "177")) THEN
				#{
					IF ((CASH.WITH.ac_sol != "177") AND (CASH.WITH.ac_sol != CUST.CPARAM.acSol1)) THEN
					#{
						CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt2)
						PRINT(CASH.WITH.Tot_Amt)
						CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt2)
						PRINT(CASH.WITH.with_amt)
						CASH.WITH.with_desc = CUST.CPARAM.withDesc2
					#}
					ENDIF
					IF ((CASH.WITH.ac_sol == CUST.CPARAM.acSol2) OR (CASH.WITH.ac_sol == CUST.CPARAM.acSol3) OR (CASH.WITH.ac_sol == CUST.CPARAM.acSol4))  THEN
					#{
						CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.Tot_Amt)
						CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt1)
						PRINT(CASH.WITH.with_amt)
						CASH.WITH.with_desc = CUST.CPARAM.withDesc2
					#}
					ENDIF
				#}
				ENDIF
				#new porting code
				#changes done as per porting3
				IF ((BANCS.STDIN.mySolId == CUST.CPARAM.mySolId3) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId4) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId5) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId6) OR (CASH.WITH.mySolIdal2=="Y")) THEN
				#{
					IF  ((CASH.WITH.ac_sol != CUST.CPARAM.acSol3) AND (CASH.WITH.ac_sol != CUST.CPARAM.acSol2) AND (CASH.WITH.ac_sol != CUST.CPARAM.acSol5) AND (CASH.WITH.ac_sol != CUST.CPARAM.acSol6) AND (CASH.WITH.ac_solsup=="N") AND (CASH.WITH.Ac_Number!="0950260559692") AND (CASH.WITH.Ac_Number!="0950261420369") AND (CASH.WITH.Ac_Number!="0950266393031")) THEN
					#{
						IF (CASH.WITH.schmCode != CUST.CPARAM.schmCode1) THEN
						#{
							CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt3)
							PRINT(CASH.WITH.Tot_Amt)
							CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt3)
							PRINT(CASH.WITH.with_amt)
							CASH.WITH.with_desc = CUST.CPARAM.withDesc2  + BANCS.STDIN.mySolId
						#}
						ENDIF
					#}
					ENDIF
					
					IF ((CASH.WITH.ac_sol == CUST.CPARAM.acSol1) OR (CASH.WITH.ac_sol == "177")) THEN
					#{
						CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt10)
						PRINT(CASH.WITH.Tot_Amt)
						CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt10)
						PRINT(CASH.WITH.with_amt)
						CASH.WITH.with_desc = CUST.CPARAM.withDesc2 + BANCS.STDIN.mySolId
					#}
					ENDIF
				#}
				ENDIF
				
				CASH.WITH.With_Flg = "N"
				print(CASH.WITH.With_Flg)
				#}
			ELSE
				#{
				IF ((CASH.WITH.With_Flg == "Y") AND (CASH.WITH.Trf_Flg != "Y")) THEN
				#{
					#IF (CASH.WITH.With_Flg == "Y") THEN
					#{
					CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.amt4)
					CASH.WITH.with_amt = cdouble(CUST.CPARAM.amt4)
					CASH.WITH.with_desc = CUST.CPARAM.withDesc1
					PRINT(CASH.WITH.Tot_Amt)
					PRINT(CASH.WITH.with_amt)
