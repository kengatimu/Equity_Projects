			#}
			ENDIF

			IF(CASH.WITH.isPSI == "G")THEN
			#{
				IF( (FIELDEXISTS(("CUST").("DATA").("chrgAmt_amt"))== 1) ) THEN
				#{
					print(CUST.DATA.chrgAmt_amt)
					
					lv_q = "isZero| SELECT CASE WHEN ?SVAR = 0 THEN 'Zero' ELSE 'Non-Zero' END AS amount_status FROM dual"
					print(lv_q)
					BANCS.INPARAM.BINDVARS = CDOUBLE(CUST.DATA.chrgAmt_amt)
					PRINT(BANCS.INPARAM.BINDVARS)
					lv_q = urhk_dbSelectWithBind(lv_q)
					print(lv_q)
