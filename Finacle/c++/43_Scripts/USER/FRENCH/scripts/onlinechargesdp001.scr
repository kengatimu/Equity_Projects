						sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
						sv_s = sv_s + " and  cust_type ='"+BANCS.INPUT.custtype+"'"
						sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
						sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum=1"
