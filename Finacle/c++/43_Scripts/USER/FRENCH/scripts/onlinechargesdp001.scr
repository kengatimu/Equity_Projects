			print(CASH.WITH.Min_Amt)
		#}
		ENDIF
		
		IF (CASH.WITH.Shd_Flg == "Y") THEN
		#{
			#new porting code
			#changes done as per porting3
			IF ((CASH.WITH.Ac_Number ==CUST.CPARAM.acctNum31) OR (CASH.WITH.Ac_Number ==CUST.CPARAM.acctNum32) OR (CASH.WITH.Ac_Number ==CUST.CPARAM.acctNum33) OR (CASH.WITH.Ac_Number =="0110200177304") OR (CASH.WITH.Ac_Number =="0110200177304") OR (CASH.WITH.Ac_Number == "0490260899266")) THEN
			#{
				CASH.WITH.percnt = "100"
				CASH.WITH.percnt = CDOUBLE(CASH.WITH.percnt)
				CASH.WITH.Shd_Amt = (cdouble(CASH.WITH.Shd_Amt) * cdouble("1"))  / cdouble(CASH.WITH.percnt)
				print(CASH.WITH.Shd_Amt)
				
				IF (cdouble(CASH.WITH.Shd_Amt) < cdouble(CUST.CPARAM.amt6)) THEN
				#{
					CASH.WITH.Shd_Amt = cdouble(CUST.CPARAM.amt6)
					print(CASH.WITH.Shd_Amt)
				#}
				ENDIF
				
				#print(CASH.WITH.Shd_Amt)
				CASH.WITH.Shd_Amt = cint(CASH.WITH.Shd_Amt)
				#}
			ELSE
				#{
				#print(CASH.WITH.Shd_Amt)
				CASH.WITH.percnt = "100"
				CASH.WITH.percnt = CDOUBLE(CASH.WITH.percnt)
				CASH.WITH.Shd_Amt = (cdouble(CASH.WITH.Shd_Amt) * cdouble(CUST.CPARAM.amt8))  / cdouble(CASH.WITH.percnt)
				print(CASH.WITH.Shd_Amt)
				
				IF ((CASH.WITH.CrncyCode)!=(BANCS.STDIN.homeCrncyCode)) THEN
				#{
					
					BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode
					BANCS.INPARAM.InputAmount  = CDOUBLE(CASH.WITH.Shd_Amt)
					BANCS.INPARAM.FromCurrency = CASH.WITH.CrncyCode
					BANCS.INPARAM.RateCode     = COLL.GLBDATA.refCode
					BANCS.INPARAM.Rate         = CDOUBLE(COLL.GLBDATA.tmRate)
					sv_u = urhk_B2k_ConvertAmount("")
					
					IF (sv_u == 0) THEN
					#{
						CASH.WITH.Shd_Amt = BANCS.OUTPARAM.OutputAmount
						PRINT(CASH.WITH.Shd_Amt)
						
					#}
					ENDIF
					
				#}
				ENDIF
				
				IF (cdouble(CASH.WITH.Shd_Amt) < cdouble(CUST.CPARAM.amt6)) THEN
				#{
					CASH.WITH.Shd_Amt = cdouble(CUST.CPARAM.amt6)
					print(CASH.WITH.Shd_Amt)
				#}
				ENDIF
				#print(CASH.WITH.Shd_Amt)
				
				CASH.WITH.Shd_Amt = cint(CASH.WITH.Shd_Amt)
			#}
			ENDIF
		#}
		ENDIF
		
		
		#--------------------------------------------------------------------------
		# Transaction
		#--------------------------------------------------------------------------
		
		IF ((CASH.WITH.Int_Flg == "Y") OR (CASH.WITH.Min_Flg == "Y") OR (CASH.WITH.Stmp_Flg == "Y") OR (CASH.WITH.Shd_Flg == "Y") OR (CASH.WITH.With_Flg == "Y") ) THEN
		#{
			CUST.GCHRG.tranType = "T"
			#CUST.GCHRG.tranSubType = "BI"
			CUST.GCHRG.tranSubType = "CI"
			CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
			CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
