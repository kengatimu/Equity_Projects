				WHILE (sv_z != 1)
				#{
					print(BANCS.OUTPARAM.refCrncy)
					print(BANCS.OUTPARAM.refAmt)
					
					IF(sv_k ==1)THEN
					#{
						CUST.TRAN.evntChrgCrncy = BANCS.OUTPARAM.refCrncy
						CUST.TRAN.chrgAmt = BANCS.OUTPARAM.refAmt
					#}
					ELSE
					#{
						CUST.TRAN.evntVATCrncy = BANCS.OUTPARAM.refCrncy
						CUST.TRAN.vatAmt = BANCS.OUTPARAM.refAmt
					#}
					ENDIF
					
					sv_z = urhk_dbCursorFetch(sv_m)
					PRINT(sv_z)
					sv_k = 2
				#}
				DO
				sv_z = urhk_dbCursorClose(sv_m)
				print(sv_z)
			#}
			ELSE
			#{
				CUST.TRAN.errorFlg = "Y"
				CUST.TRAN.errorMsg = "Unable to fetch Charge details"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		
			########################################################
			print(CUST.TRAN.chrgAmt)
			print(CUST.TRAN.vatAmt)
			print(CUST.TRAN.evntChrgCrncy)
			print(CUST.TRAN.chrgAmt )	
			print(CUST.TRAN.vatAmt )
			print(CUST.GCHRG.drAcctId)
			print(CUST.GCHRG.vatacnt)
			print(CUST.GCHRG.chrgacnt)

			sv_s = "Insert into CUSTOM.C_CTDT (PARENT_TRAN_ID, PARENT_TRAN_DATE, EVENT_TYPE, EVENT_ID, SERVICE_SOL_ID, CHRG_TRAN_ID, CHRG_TRAN_DATE, COLL_CRNCY_CODE, CHRG_AMT, VAT_AMT, RCRE_USER_ID"
			sv_s = sv_s + " ,RCRE_TIME, BANK_ID,ACCT_ID,VAT_ACCT_ID,CHRG_ACCT_ID) Values(?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, ?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, ?SVAR, sysdate , ?SVAR,?SVAR,?SVAR,?SVAR )"
			
			BANCS.INPARAM.BINDVARS = CASH.WITH.tran_id + "|" + CUST.GCHRG.chargeTranDate + "|" + "GCHRG" + "|" + CUST.GCHRG.eventId  + "|" + BANCS.STDIN.mySolId + "|" + CUST.GCHRG.chargeTranId + "|" + CUST.GCHRG.chargeTranDate
			print(BANCS.INPARAM.BINDVARS)
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" + CUST.TRAN.evntChrgCrncy + "|" + CUST.TRAN.chrgAmt + "|" + CUST.TRAN.vatAmt + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.GCHRG.drAcctId  + "|" +  CUST.GCHRG.vatacnt + "|"+ CUST.GCHRG.chrgacnt
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			
			IF(sv_d != 0)THEN
			#{
				sv_d = urhk_dbSqlWithBind("ROLLBACK")
				PRINT(sv_d)
			#}
			ELSE
			#{
				sv_d = urhk_dbSqlWithBind("COMMIT")
				PRINT(sv_d)
			#}
			ENDIF
		#}
		ENDIF
		
		JUMP_CAA_USD:
		
		#print("NI TA CHARGE")
		#PRINT(CUST.CPARAM.amt1)
