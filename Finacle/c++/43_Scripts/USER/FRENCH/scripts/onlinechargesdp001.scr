						CUST.DATA.isZero = BANCS.OUTPARAM.isZero
					ELSE
						CUST.DATA.isZero = ""
					ENDIF
					PRINT(CUST.DATA.isZero)
					
					IF(CUST.DATA.isZero == "Zero")THEN
					#{
						PRINT("Zero charge")
						GOTO JUMP_CAA_USD
					#}
					ENDIF
				#}
				ENDIF
				
				PRINT(CASH.WITH.Tran_Amt)
				IF(CDOUBLE(CASH.WITH.Tran_Amt) > "9999.99") THEN
				#{
					#TMNOCHQ10K
					BANCS.INPUT.moduleName = "TMCHARGES"
					BANCS.INPUT.parameterId = "NOCHQ10K"
					print(BANCS.INPUT.parameterId)
					
					CALL("getCustomParamValue.scr")
					IF(sv_h =="Y")THEN
					#{
						CHRG.TXN.errorFlg = "Y"
						CHRG.TXN.errorMsg = sv_i
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					PRINT(BANCS.OUTPARAM.parameterVal)
					CASH.WITH.newEventId = BANCS.OUTPARAM.parameterVal
					PRINT(CASH.WITH.newEventId)

