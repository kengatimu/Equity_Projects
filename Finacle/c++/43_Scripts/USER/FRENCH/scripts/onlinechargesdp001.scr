										PRINT(lv_t)
										lv_j = BANCS.OUTPARAM.myChrgAmt
										lv_k = BANCS.OUTPARAM.myChrgCrncy
										PRINT(lv_j)
										PRINT(lv_k)
										
										CUST.GCHRG.chrgAmt = lv_j + "|" + lv_k
										PRINT(CUST.GCHRG.chrgAmt)
										
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}	
					ELSE
					#{
						PRINT("ERROR")
					#}
					ENDIF
				#}
				ELSE
				#{
					sv_s = "cwNoInstChrgType, cwNoInstChrgAmt, cwNoInstPcnt|"
					sv_s = sv_s + " SELECT CHARGE_TYPE, CASE WHEN NVL(CHRG_AMT, 0) = 0 THEN 'C0' ELSE TO_CHAR(NVL(CHRG_AMT, 0)) "
