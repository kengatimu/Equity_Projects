			IF ((CASH.WITH.ac_sol == "018") OR (CASH.WITH.ac_sol == "081") OR (CASH.WITH.ac_sol == "140") OR (CASH.WITH.ac_sol == "141") OR (CASH.WITH.ac_sol == "147") OR (CASH.WITH.ac_sol == "151")OR (CASH.WITH.ac_sol == "170")) THEN
			#{
				#CASH.WITH.Min_Amt = "-2000"
				CASH.WITH.Min_Flg = "N"
