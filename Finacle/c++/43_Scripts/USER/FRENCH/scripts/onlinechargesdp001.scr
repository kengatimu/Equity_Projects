	IF( (FIELDEXISTS(("CUST").("DATA").("chrgAmt"))== 1) ) THEN
	#{
		PRINT(CUST.DATA.chrgAmt)
	#}
	ENDIF
	

	BANCS.INPUT.moduleName = "TMCHRG"
	#----------------------------------------------------------------
	#  ParameterId for TMCH_AMT10
	#---------------------------------------------------------------
	BANCS.INPUT.parameterId = "TMCH_AMT10"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.amt10 = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.amt10)
		#}
	ELSE
		#{
		CUST.TMCHRG.errMsg = "CPARAM setup not done for amt10"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#----------------------------------------------------------------
	#  ParameterId for SUPSOL
	#---------------------------------------------------------------
	BANCS.INPUT.parameterId = "SUPSOL"
	CALL ("getcparamvaluelong.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.supsol = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.supsol)
		#}
	ELSE
		#{
		CUST.CPARAM.errMsg = "CPARAM setup not done for Supreme Branches"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "SUPSCHEMES"
	CALL ("getcparamvaluelong.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.CPARAM.supschm = BANCS.OUTPUT.parameterVal
		print(CUST.CPARAM.supschm)
		#}
	ELSE
		#{
		CUST.CPARAM.errMsg = "CPARAM setup not done for Supreme Schemes"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	print(BANCS.STDIN.mySolId)
	print(CUST.CPARAM.supsol)
	
	sv_w = getPosition(CUST.CPARAM.supsol,"," +  BANCS.STDIN.mySolId + ",")
	print(sv_w)
	
	IF (sv_w > 0) THEN
	#{
		
		#CASH.WITH.mySolIdal2=BANCS.STDIN.mySolId
		CASH.WITH.mySolIdal2="Y"
		print(CASH.WITH.mySolIdal2)
		
		sv_s = getPosition(CUST.CPARAM.supsol,"," +  CASH.WITH.ac_sol + ",")
		print(sv_s)
		print(CASH.WITH.ac_sol)
		
		sv_q = getPosition(CUST.CPARAM.supschm,"," +  CASH.WITH.schmCode + ",")
		print(sv_q)
		
		IF ((sv_s > 0) OR ((CASH.WITH.ac_sol == "138") AND (sv_q > 0))) THEN
		#{
			
			#CASH.WITH.ac_solsup=CASH.WITH.ac_sol
			CASH.WITH.ac_solsup="Y"
			print(CASH.WITH.ac_solsup)
			
			#}
		ELSE
			#{
			
			CASH.WITH.ac_solsup="N"
			
		#}
		ENDIF
		#}
	ELSE
		#{
		CASH.WITH.mySolIdal2="N"
		CASH.WITH.ac_solsup="N"
		
		
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TMCH_INW"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF(BANCS.OUTPUT.parameterVal != "")THEN
	#{
		CUST.CPARAM.tminwchrg = BANCS.OUTPUT.parameterVal
		PRINT(CUST.CPARAM.tminwchrg)
		#}
	ELSE
		#{
		CUST.CPARAM.errMsg = "Inward Charge event setup not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF ((BANCS.STDIN.contextBankId == "43") AND (COLL.GLBDATA.sub_type == "I"))THEN
	#{
		print(CASH.WITH.type)
		print(COLL.GLBDATA.sub_type)
		PRINT(CASH.WITH.stype)
		CASH.WITH.ac_sol = COLL.GLBDATA.ac_sol
		print(CASH.WITH.ac_sol)
		CASH.WITH.CrncyCode = COLL.GLBDATA.CrncyCode
		print(CASH.WITH.CrncyCode)
		
		IF ((CASH.WITH.type == "T") AND (COLL.GLBDATA.sub_type == "I")AND (COLL.GLBDATA.partTrantype == "D")) THEN
		#{
			CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.tminwchrg)
			PRINT(CASH.WITH.Tot_Amt)
			CASH.WITH.trf_amt = cdouble(CUST.CPARAM.tminwchrg)
			PRINT(CASH.WITH.trf_amt)
			#}
		ELSE
			#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		CUST.GCHRG.tranType = "T"
		#CUST.GCHRG.tranSubType = "BI"
		CUST.GCHRG.tranSubType = "CI"
		#CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
		CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
		CUST.GCHRG.chrgAmt = CASH.WITH.trf_amt + "|" + BANCS.STDIN.homeCrncyCode
		PRINT(COLL.GLBDATA.tminwevent)
		#CUST.GCHRG.eventId = "INWCHRG"
		CUST.GCHRG.eventId = COLL.GLBDATA.tminwevent
		CUST.GCHRG.drAcctId = COLL.GLBDATA.account1
		print(CUST.GCHRG.drAcctId)
		CALL("gchrgcommon.scr")
		IF (CUST.GCHRG.successOrFailure == "S") THEN
		#{
			PRINT("Charge collected")
			#}
		ELSE
			#{
			PRINT("Failure")
		#}
		ENDIF
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#-----------------------------------------------------------
	#Initializing required variables
	#----------------------------------------------------------
	CUST.TMCHRG.errMsg = ""
	#------------------------
	#Hardcoding value for testing
	#---------------------------
	print(CASH.WITH.Ac_Number)
	print(CASH.WITH.Int_Flg)
	print(CASH.WITH.Min_Flg)
	print(CASH.WITH.Stmp_Flg)
	print(CASH.WITH.Shd_Flg)
	print(CASH.WITH.With_Flg)
	print(CASH.WITH.tran_id)
	print(CASH.WITH.Trf_Flg)
	print(CASH.WITH.caanochq_Flg)
	PRINT(COLL.GLBDATA.tranDate)
	PRINT(COLL.GLBDATA.parttrnNum)
	
	IF (FIELDEXISTS(CASH.WITH.type) AND FIELDEXISTS(CASH.WITH.stype)) THEN
	#{
		PRINT(CASH.WITH.type)
		PRINT(CASH.WITH.stype)
		IF ((CASH.WITH.type == "T") AND (CASH.WITH.stype == "CI")) THEN
		#{
			PRINT(CASH.WITH.Min_Flg)
			PRINT(CASH.WITH.Shd_Flg)
			IF ((CASH.WITH.Min_Flg == "Y") OR (CASH.WITH.Shd_Flg == "Y")) THEN
			#{
				call("onlinetranmindp001.scr")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
			#ELSE
			#{
			#	CASH.WITH.Min_Flg = "N"
			#	CASH.WITH.Shd_Flg = "N"
		#}
		ENDIF
	#}
	ENDIF
	
	##OTC withdraw charges with chq
	Print("To be handled on calcAndPostChrgTran.scr")
	
	##OTC withdraw charges without chq
	IF (CASH.WITH.caanochq_Flg == "Y") THEN
	#{
	
		PRINT("HI")
		CUST.GCHRG.tranType = "T"
		#CUST.GCHRG.tranSubType = "BI"
		CUST.GCHRG.tranSubType = "CI"
		CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
		CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
		CUST.GCHRG.chrgAmt = "|"+BANCS.STDIN.homeCrncyCode
		PRINT(COLL.GLBDATA.nochqevent)
		PRINT(COLL.GLBDATA.nochqevent_10k)
		#CUST.GCHRG.eventId = "TMNOCHQ1"
		IF ((BANCS.STDIN.mySolId == CUST.CPARAM.mySolId3) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId4) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId5) OR (BANCS.STDIN.mySolId == CUST.CPARAM.mySolId6) OR (CASH.WITH.mySolIdal2=="Y")) THEN
		#{
			CUST.GCHRG.eventId = "TMNOCHQSUP"
			#}
		ELSE
			#{
			CUST.GCHRG.eventId = COLL.GLBDATA.nochqevent
		#}
		ENDIF
		
		PRINT(CASH.WITH.Tran_Amt)
		lv_d=CDOUBLE(CASH.WITH.Tran_Amt)
		PRINT(lv_d)
		#lv_d = CDOUBLE(lv_d)
		#PRINT(lv_d)
		
		lv_f = urhk_getAcctDetailsInRepository(CUST.GCHRG.drAcctId)	
		CUST.GCHRG.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.GCHRG.acctCrncyCode)
		CUST.TMCHRG.acctSchmCode = BANCS.OUTPARAM.schmCode
		print(CUST.TMCHRG.acctSchmCode)
		
		#Check if the tran_amount is greater than 10k usd
		IF((CASH.WITH.stype == "NP") AND (CASH.WITH.type == "C")) THEN
		#{
			CUST.RATE.acctCrncy = CUST.GCHRG.acctCrncyCode
			CUST.RATE.refCrncy = "USD"
			CUST.RATE.TranType = CASH.WITH.type
			CALL("fetchRateCode.scr")

			IF(CUST.RATE.errorFlg != "Y")THEN
			#{
				BANCS.INPARAM.InputAmount = lv_d
				BANCS.INPARAM.FromCurrency = CUST.RATE.acctCrncy
				BANCS.INPARAM.ToCurrency = CUST.RATE.refCrncy
				BANCS.INPARAM.RateCode = CUST.RATE.rateCode
				BANCS.INPARAM.Rate = CDOUBLE("0.0")
				sv_u = urhk_B2k_ConvertAmount("")
				IF(sv_u != 0)THEN
					PRINT(lv_d)
				ELSE
					lv_d = BANCS.OUTPARAM.OutputAmount
					PRINT(lv_d)
				ENDIF
				
			#}
			ELSE
			#{
				CUST.DATA.err_Msg = "RateCode does not exist from " +CUST.RATE.acctCrncy+ " to " +CUST.RATE.refCrncy
				PRINT(CUST.DATA.err_Msg)
			#}
			ENDIF
			
			IF (lv_d > "9999.99")THEN
				#CUST.GCHRG.eventId = "TMNOCHQ10K"
				CUST.GCHRG.eventId = COLL.GLBDATA.nochqevent_10k
				CUST.GCHRG.chrgAmt = CASH.WITH.Tran_Amt
			ELSE
				CUST.GCHRG.eventId = CUST.GCHRG.eventId 
				CUST.GCHRG.chrgAmt = CASH.WITH.Tran_Amt
			ENDIF
			PRINT(CUST.GCHRG.eventId)
		#}
		ENDIF
		
		lv_s= "chrgType,chrgamt,chrgpcnt,minAmt,maxAmt|"
		lv_s = lv_s + " SELECT CHARGE_TYPE, CHRG_AMT, PRCNT,MIN_AMT,MAX_AMT FROM CUSTOM.CUSTOM_CCPRM WHERE EVENT_TYPE='GCHRG' AND EVENT_ID='"+CUST.GCHRG.eventId+"' AND " 
		lv_s = lv_s + " DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y' AND SCHM_CODE='"+CUST.TMCHRG.acctSchmCode+"' AND "
		lv_s = lv_s + " CRNCY_CODE='"+CUST.GCHRG.acctCrncyCode+"' AND BANK_ID='"+BANCS.STDIN.contextBankId+"' " 
		lv_s = lv_s + " AND SRL_NUM IN (SELECT SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+CUST.GCHRG.eventId+"' AND EVENT_TYPE='GCHRG' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"')"
		PRINT(lv_s)
		
		lv_q = urhk_dbSelectWithBind(lv_s)
		IF(lv_q == 0)THEN
			CUST.TMCHRG.chrgType=TRIM(BANCS.OUTPARAM.chrgType)
			CUST.TMCHRG.chrgpcnt=CDOUBLE(BANCS.OUTPARAM.chrgpcnt)
			CUST.TMCHRG.minAmt=CDOUBLE(BANCS.OUTPARAM.minAmt)
			CUST.TMCHRG.maxAmt=CDOUBLE(BANCS.OUTPARAM.maxAmt)
			CUST.TMCHRG.chrgamt=CDOUBLE(BANCS.OUTPARAM.chrgamt)
		ELSE
			PRINT("Failure")
			GOTO JUMP_CAA_USD
		ENDIF
		
		PRINT(CUST.GCHRG.chrgAmt)
		lv_r = CDOUBLE(CUST.GCHRG.chrgAmt)
		PRINT(lv_r)
		PRINT(CUST.GCHRG.eventId)
		PRINT(CUST.TMCHRG.chrgpcnt)
		PRINT(CUST.TMCHRG.chrgamt)
		PRINT(CUST.TMCHRG.chrgType)
		PRINT(CUST.GCHRG.acctCrncyCode)
		IF((CUST.TMCHRG.chrgpcnt > 0) OR (CUST.TMCHRG.chrgpcnt != "") OR (CUST.TMCHRG.chrgamt != "") OR (CUST.TMCHRG.chrgamt > 0) OR (CUST.TMCHRG.chrgType == "S"))THEN
			#IF((CUST.TMCHRG.chrgType == "P") OR (CUST.TMCHRG.chrgType == "S"))THEN
			IF(CUST.TMCHRG.chrgType == "P")THEN
				sv_h = "myPcnt|"
				sv_h = sv_h + " select AMT_PCNT from tbaadm.adm where AMT_DRV_SRL_NUM in "
				sv_h = sv_h + " (select AMT_DERV_SRL_NUM from tbaadm.ptt where event_type = 'GCHRG' "
				sv_h = sv_h + " AND EVENT_ID = '"+CUST.GCHRG.eventId+"' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"') AND AMT_IND = '"+CUST.TMCHRG.chrgType+"' "
				PRINT(sv_h)
				sv_i = urhk_dbSelectWithBind(sv_h)
				IF(sv_i == 0)THEN
					lv_z = BANCS.OUTPARAM.myPcnt
					PRINT(lv_z)
					
					IF((CUST.TMCHRG.chrgpcnt > 0) AND (CUST.TMCHRG.chrgamt > 0)) THEN
						lv_h = (((lv_d) * (CDOUBLE(CUST.TMCHRG.chrgpcnt)/100)) / (CDOUBLE(lv_z)/100))
						PRINT(lv_h)
						
						lv_s = "myChrgAmt, myChrgCrncy| "
						lv_s = lv_s + " SELECT ?SVAR, '"+CUST.GCHRG.acctCrncyCode+"' FROM DUAL "
						PRINT(lv_s)
						BANCS.INPARAM.BINDVARS = lv_h
						lv_t = urhk_dbSelectWithBind(lv_s)
						PRINT(lv_t)
						lv_j = BANCS.OUTPARAM.myChrgAmt
						lv_k = BANCS.OUTPARAM.myChrgCrncy
						PRINT(lv_j)
						PRINT(lv_k)
						CUST.GCHRG.chrgAmt = lv_j + "|" + lv_k
						PRINT(CUST.GCHRG.chrgAmt)
					ENDIF
				ELSE
					PRINT ("Failure")
				ENDIF
			ENDIF
			
			IF(CUST.TMCHRG.chrgType == "S")THEN
				IF (lv_d > "9999.99")THEN
					CUST.GCHRG.eventId = COLL.GLBDATA.nochqevent_10k
				ELSE
					PRINT(COLL.GLBDATA.CWNOINSTR)	
					CUST.GCHRG.eventId = COLL.GLBDATA.CWNOINSTR
				ENDIF
			ENDIF
			
			###
			IF(CUST.TMCHRG.chrgType != "S")THEN
				PRINT(CUST.GCHRG.drAcctId)
				sv_s = "entityId, foracid, cust_id|"
				sv_s = sv_s + "SELECT ACID, FORACID, CIF_ID FROM TBAADM.GAM WHERE FORACID = '"+CUST.GCHRG.drAcctId+"'"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN	
					BANCS.INPUT.entityId = BANCS.OUTPARAM.entityId
					BANCS.INPUT.foracid = BANCS.OUTPARAM.foracid
					BANCS.INPUT.cust_id = BANCS.OUTPARAM.cust_id
					
					BANCS.INPUT.eventtype = "GCHRG"
					BANCS.INPUT.eventid = COLL.GLBDATA.CWNOINSTR
					
					PRINT(BANCS.INPUT.eventtype)
					PRINT(BANCS.INPUT.eventid)
					PRINT(BANCS.INPUT.entityId)
					PRINT(BANCS.INPUT.foracid)
					PRINT(BANCS.INPUT.cust_id)
				ELSE
					PRINT("Error occurred.")
					exitscript
				ENDIF
				
				##Variable Initialization
				BANCS.INPUT.AMTIND="N"
				BANCS.INPUT.AMT="0"
				BANCS.INPUT.PRCNT="0"
				
				#Acid
				IF(FIELDEXISTS(BANCS.INPUT.entityId))THEN
					
					print(BANCS.INPUT.entityId)
					
					sv_s = " corp_id, SEGMENT, foracid,cust_id,ccy| select corp_id, SEGMENTATION_CLASS,foracid,cif_id,acct_crncy_code from crmuser.accounts,tbaadm.gam " 
					sv_s = sv_s + " where orgkey =cif_id  and acid ='"+BANCS.INPUT.entityId+"'"
					sv_s = sv_s + " and gam.bank_id='"+BANCS.STDIN.contextBankId+"'     and  rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN		

						if(BANCS.OUTPARAM.corp_id !="") then
							BANCS.INPUT.custtype="C"
						else
							BANCS.INPUT.custtype="R"
						endif
						BANCS.INPUT.SME=BANCS.OUTPARAM.SEGMENT
						BANCS.INPUT.foracid=BANCS.OUTPARAM.foracid
						BANCS.INPUT.ccy=BANCS.OUTPARAM.ccy
						BANCS.INPUT.cust_id=BANCS.OUTPARAM.cust_id
					else
						BANCS.INPUT.SME=""
						BANCS.INPUT.foracid=""
						BANCS.INPUT.cust_id=""
						BANCS.INPUT.custtype=""
					ENDIF
				
				ELSE
					BANCS.INPUT.eventid="XXXXX"
					BANCS.INPUT.eventtype="XXXXX"
					BANCS.INPUT.foracid=""
					BANCS.INPUT.cust_id="XXXX"
					BANCS.INPUT.cifid="XXX"
					BANCS.INPUT.AGREEMENT_CODE=""
					BANCS.INPUT.SME=""
					BANCS.INPUT.custtype=""
					print(BANCS.INPUT.cust_id) 
					BANCS.INPUT.AMT1= 0
				ENDIF
				
				
				#Foracid
				sv_s =" AMTIND, PRCNT,AMT | select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
				sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
				sv_s = sv_s + " and foracid ='"+BANCS.INPUT.foracid +"'"
				sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
				sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN

					BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
					BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
					BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
					BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					print(BANCS.INPUT.AMT)
				else
					##BANCS.INPUT.AMTIND="N"
					##BANCS.INPUT.AMT="0"
					##BANCS.INPUT.PRCNT="0"
					BANCS.INPUT.TEST="1"
					
					BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
					BANCS.INPUT.AMT=BANCS.INPUT.AMT
					BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
				ENDIF
				
				
				#Cif id
				sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
				sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
				sv_s = sv_s + " and cust_id ='"+BANCS.INPUT.cust_id+"'"
				sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
				sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN
					BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
					BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
					BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
					BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
				else
					##BANCS.INPUT.AMTIND="N"
					##BANCS.INPUT.AMT="0"
					##BANCS.INPUT.PRCNT="0"
					BANCS.INPUT.TEST="2"
					
								
					BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
					BANCS.INPUT.AMT=BANCS.INPUT.AMT
					BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
				ENDIF					
				
				#check agreement level	
				IF (BANCS.INPUT.AMTIND=="N") THEN
					
					sv_s =" AGREEMENT_CODE| select employerid from CRMUSER.DEMOGRAPHIC where orgkey = "
					sv_s = sv_s + " (select  cif_id from tbaadm.cmg where CIF_ID ='"+BANCS.INPUT.cust_id+"')"
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN
						BANCS.INPUT.AGREEMENT_CODE=BANCS.OUTPARAM.AGREEMENT_CODE
					else
						BANCS.INPUT.AGREEMENT_CODE=""
					ENDIF
						
					sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
					sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
					sv_s = sv_s + " and AGREEMENT_CODE='"+BANCS.INPUT.AGREEMENT_CODE+"'"
					sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN
						BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
						BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
						BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
						BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					else
						##BANCS.INPUT.AMTIND="N"
						##BANCS.INPUT.AMT="0"
						##BANCS.INPUT.PRCNT="0"
						BANCS.INPUT.TEST="3"
						
						BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
						BANCS.INPUT.AMT=BANCS.INPUT.AMT
						BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
					ENDIF
				ENDIF
				

				#check SME level
				
				IF (BANCS.INPUT.AMTIND=="N") THEN
				#{
					sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
					sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
					sv_s = sv_s + " and SME ='"+BANCS.INPUT.SME+"'"
					sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN		
						BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
						BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
						BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
						BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					else
						##BANCS.INPUT.AMTIND="N"
						##BANCS.INPUT.AMT="0"
						##BANCS.INPUT.PRCNT="0"
						BANCS.INPUT.TEST="4"
						
						BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
						BANCS.INPUT.AMT=BANCS.INPUT.AMT
						BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
					ENDIF
				#}
				ENDIF


				#check BANk level
				
				IF (BANCS.INPUT.AMTIND=="N") THEN
				
					sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
					sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
					sv_s = sv_s + " and  cust_type ='"+BANCS.INPUT.custtype+"'"
					sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN
						BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
						BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
						BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
						BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					else
						##BANCS.INPUT.AMTIND="N"
						##BANCS.INPUT.AMT="0"
						##BANCS.INPUT.PRCNT="0"
						BANCS.INPUT.TEST="5"
						
						BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
						BANCS.INPUT.AMT=BANCS.INPUT.AMT
						BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
					ENDIF
				ENDIF
				
				print(BANCS.INPUT.AMTIND)
				print(BANCS.INPUT.AMT)
				print(BANCS.INPUT.PRCNT)
				
				IF ((BANCS.INPUT.AMTIND=="A") or (BANCS.INPUT.AMTIND=="P")) then
					IF(BANCS.INPUT.AMTIND=="A")then
						CUST.DATA.chrgAmt_amt = BANCS.INPUT.AMT
					ENDIF

					IF(BANCS.INPUT.AMTIND=="P")THEN
						print(BANCS.INPUT.PRCNT)
						IF (BANCS.INPUT.PRCNT!="") then
							IF (BANCS.INPUT.PRCNT <100) THEN
								#IF(BANCS.INPUT.PRCNT < 1 )THEN
								IF(BANCS.INPUT.PRCNT < 0 )THEN
									PRINT("Zero charge")
									goto JUMP_CAA_USD
								ENDIF
								print(lv_r)
								CUST.DATA.inputAmt = lv_r
								CUST.DATA.chrgAmt_amt = CDOUBLE(CUST.DATA.inputAmt) * CDOUBLE(BANCS.INPUT.PRCNT) * (0.01)
								print(CUST.DATA.chrgAmt_amt)
								
								lv_s = "chrg_amt_ind, chrg_amt_pcnt| "
								lv_s = lv_s + " SELECT AMT_IND, AMT_PCNT FROM TBAADM.ADM WHERE AMT_DRV_SRL_NUM IN ( "
								lv_s = lv_s + " SELECT AMT_DERV_SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+CUST.GCHRG.eventId+"' AND "
								lv_s = lv_s + " EVENT_TYPE = 'GCHRG' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"') "
								print(lv_s)
								
								lv_q = urhk_dbSelectWithBind(lv_s)
								print(lv_q)
								
								IF(lv_q == 0)THEN
								#{
									CUST.DATA.chrg_amt_ind = BANCS.OUTPARAM.chrg_amt_ind
									PRINT(CUST.DATA.chrg_amt_ind)
									CUST.DATA.chrg_amt_pcnt = BANCS.OUTPARAM.chrg_amt_pcnt
									PRINT(CUST.DATA.chrg_amt_pcnt)
									
									IF(CUST.DATA.chrg_amt_ind == "P")THEN
									#{
										print(CUST.DATA.chrgAmt_amt)
										
										CUST.DATA.chrgAmt_amt = CDOUBLE(CUST.DATA.chrgAmt_amt) / (CDOUBLE(CUST.DATA.chrg_amt_pcnt) * (0.01))
										print(CUST.DATA.chrgAmt_amt)
									#}
									ENDIF
								#}
								ENDIF
							ELSE
								BANCS.INPUT.PRCNT=0
								#CUST.DATA.chrgAmt_amt = cdouble(CUST.DATA.inputAmt) - cdouble(CUST.DATA.inputAmt) * cdouble(BANCS.INPUT.PRCNT)* 0.01
								CUST.DATA.chrgAmt_amt = 0
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				
#				print(CUST.DATA.chrgAmt_amt)
#				PRINT(CUST.GCHRG.acctCrncyCode)
				
				IF( (FIELDEXISTS(("CUST").("DATA").("chrgAmt_amt"))== 1) ) THEN
				#{
					print(CUST.DATA.chrgAmt_amt)
					CUST.DATA.chrgAmt_1 = CUST.DATA.chrgAmt_amt
					
					lv_s = "myChrgAmt, myChrgCrncy| "
					lv_s = lv_s + " SELECT ?SVAR, '"+CUST.GCHRG.acctCrncyCode+"' FROM DUAL "
					PRINT(lv_s)
					#BANCS.INPARAM.BINDVARS = CUST.DATA.chrgAmt_amt
					BANCS.INPARAM.BINDVARS = CDOUBLE(CUST.DATA.chrgAmt_amt)
					lv_t = urhk_dbSelectWithBind(lv_s)
					PRINT(lv_t)
					lv_j = BANCS.OUTPARAM.myChrgAmt
					lv_k = BANCS.OUTPARAM.myChrgCrncy
					PRINT(lv_j)
					PRINT(lv_k)
					CUST.GCHRG.chrgAmt = lv_j + "|" + lv_k
					PRINT(CUST.GCHRG.chrgAmt)
					
					#IF(lv_j > 0)THEN
						CUST.GCHRG.eventId = COLL.GLBDATA.CWNOINSTR
					#ENDIF
				#}
				ENDIF
				
				
			ENDIF
			
			PRINT(COLL.GLBDATA.CWNOINSTR)
			IF(CUST.GCHRG.eventId == COLL.GLBDATA.CWNOINSTR)THEN
			#{
				PRINT(CASH.WITH.Tran_Amt)
				CUST.GCHRG.chrgAmt = CASH.WITH.Tran_Amt
				PRINT(CUST.GCHRG.chrgAmt)
			#}
			ENDIF
			
			lv_f = urhk_getAcctDetailsInRepository(CUST.GCHRG.drAcctId)	
			sv_f = BANCS.OUTPARAM.acctCrncyCode
			print(sv_f)
			sv_h = BANCS.OUTPARAM.schmCode
			print(sv_h)
			
			sv_s = "cwNoInstChrgType, cwNoInstChrgAmt, cwNoInstPcnt|"
			sv_s = sv_s + " SELECT CHARGE_TYPE, CASE WHEN NVL(CHRG_AMT, 0) = 0 THEN 'C0' ELSE TO_CHAR(NVL(CHRG_AMT, 0)) "
			sv_s = sv_s + " END AS CHRG_AMT,CASE WHEN PRCNT IS NULL OR PRCNT = '0' THEN 'P0' ELSE TO_CHAR(PRCNT) END AS PRCNT "
			sv_s = sv_s + " FROM CUSTOM.CUSTOM_CCPRM c WHERE EVENT_TYPE='GCHRG' AND CHARGE_TYPE !='S' AND "
			sv_s = sv_s + " EVENT_ID IN '"+COLL.GLBDATA.CWNOINSTR+"' AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y' AND SCHM_CODE ='"+sv_h+"' AND CRNCY_CODE='"+sv_f+"' "
			sv_s = sv_s + " AND BANK_ID='"+BANCS.STDIN.contextBankId+"' and SRL_NUM IN (SELECT SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+COLL.GLBDATA.CWNOINSTR+"' AND  "
			sv_s = sv_s + " EVENT_TYPE='GCHRG' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"') AND ROWNUM = 1"
			PRINT(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN
				lv_n=BANCS.OUTPARAM.cwNoInstChrgAmt
				lv_o=BANCS.OUTPARAM.cwNoInstPcnt
				lv_m=BANCS.OUTPARAM.cwNoInstChrgType
				print(lv_n)
				print(lv_o)
				
				IF((lv_m == "P")AND (lv_o == "P0"))THEN
				#{
					PRINT("Zero charge")
					goto JUMP_CAA_USD
				#}
				ELSE
				#{
					IF(lv_m == "P")THEN
					#{
						CUST.GCHRG.eventId = COLL.GLBDATA.CWNOINSTR
						PRINT(lv_r)
						lv_s = "myChrgAmt, myChrgCrncy| "
						lv_s = lv_s + " SELECT ?SVAR, '"+sv_f+"' FROM DUAL "
						PRINT(lv_s)
						BANCS.INPARAM.BINDVARS = lv_r
						lv_t = urhk_dbSelectWithBind(lv_s)
						PRINT(lv_t)
						lv_j = BANCS.OUTPARAM.myChrgAmt
						lv_k = BANCS.OUTPARAM.myChrgCrncy
						PRINT(lv_j)
						PRINT(lv_k)
						CUST.GCHRG.chrgAmt = lv_j + "|" + lv_k
						PRINT(CUST.GCHRG.chrgAmt)
					#}
					ENDIF
				#}
				ENDIF
				IF((lv_m == "F") AND (lv_n == "C0"))THEN
				#{
					PRINT("Zero charge")
					goto JUMP_CAA_USD
				#}
				ELSE
				#{
					IF(lv_m == "F")THEN
					#{
						CUST.GCHRG.eventId = COLL.GLBDATA.CWNOINSTR
						
						PRINT(lv_n)
						lv_s = "myChrgAmt, myChrgCrncy| "
						lv_s = lv_s + " SELECT ?SVAR, '"+sv_f+"' FROM DUAL "
						PRINT(lv_s)
						BANCS.INPARAM.BINDVARS = lv_n
						lv_t = urhk_dbSelectWithBind(lv_s)
						PRINT(lv_t)
						lv_j = BANCS.OUTPARAM.myChrgAmt
						lv_k = BANCS.OUTPARAM.myChrgCrncy
						PRINT(lv_j)
						PRINT(lv_k)
						CUST.GCHRG.chrgAmt = lv_j + "|" + lv_k
						PRINT(CUST.GCHRG.chrgAmt)
					#}
					ENDIF
				#}
				ENDIF
			else
				PRINT("ERROR")
			ENDIF
			
			###
			
			##Fetching the Region of the initiating branch Cash withdraw over the counter
			
			lv_s = "region_sol|SELECT SOL_ID FROM TBAADM.GAM WHERE FORACID = '"+CUST.GCHRG.drAcctId+"' and bank_id='"+BANCS.STDIN.contextBankId+"' "
			PRINT(lv_s)
			
			sv_u = urhk_dbselectwithBind(lv_s)
			print(sv_u)
			CASH.WITH.region_sol = ""
			IF (sv_u == 0) THEN
			#{
				CASH.WITH.region_sol =BANCS.OUTPARAM.region_sol
				print(CASH.WITH.region_sol)
			#}
			ENDIF

			#sv_s = "region|select region  from CUSTOM.AGENT_FOREX where Sol_id='"+CASH.WITH.region_sol+"' and bank_id='"+BANCS.STDIN.contextBankId+"' "
			sv_s = "region|select region  from CUSTOM.AGENT_FOREX where Sol_id='"+BANCS.STDIN.mySolId+"' and bank_id='"+BANCS.STDIN.contextBankId+"' "
			print(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN
			#{
				CASH.WITH.region =BANCS.OUTPARAM.region
				print(CASH.WITH.region)
			#}
			ENDIF
			
			sv_s="isCorporate|SELECT CASE WHEN COUNT(1) > 0 THEN 'G' ELSE 'Z' END FROM CRMUSER.CORPORATE WHERE CORP_KEY IN "
			sv_s=sv_s+"(SELECT CIF_ID FROM TBAADM.GAM WHERE FORACID = '"+CUST.GCHRG.drAcctId+"')"
			PRINT(sv_s)
			sv_s = urhk_dbSelectWithBind(sv_s)
			print(sv_s)
			IF(sv_s == 0)THEN
			#{
				CASH.WITH.isCorporate= BANCS.OUTPARAM.isCorporate
				PRINT(CASH.WITH.isCorporate)
				
				IF(CASH.WITH.isCorporate == "G") THEN
					PRINT(COLL.GLBDATA.IS_CORPORATE_NO_OF_FREE_WTH)
					CUST.GCHRG.eventId = COLL.GLBDATA.IS_CORPORATE_NO_OF_FREE_WTH
				ENDIF
			#}
			ELSE
			#{
				CASH.WITH.isCorporate = 0
				PRINT(CASH.WITH.isCorporate)
			#}
			ENDIF
			
			sv_s="isPSI|SELECT CASE WHEN COUNT(1) > 0 THEN 'G' ELSE 'Z' END FROM TBAADM.GAM WHERE FORACID = '"+CUST.GCHRG.drAcctId+"' AND SCHM_CODE IN ('CA794', 'CA796', 'CA797')"
			PRINT(sv_s)
			sv_s = urhk_dbSelectWithBind(sv_s)
			print(sv_s)
			IF(sv_s == 0)THEN
			#{
				CASH.WITH.isPSI= BANCS.OUTPARAM.isPSI
				PRINT(CASH.WITH.isPSI)
				
				IF(CASH.WITH.isPSI == "G") THEN
					PRINT(COLL.GLBDATA.IS_PSI_NO_OF_FREE_WTH)
					CUST.GCHRG.eventId = COLL.GLBDATA.IS_PSI_NO_OF_FREE_WTH
				ENDIF
			#}
			ELSE
			#{
				CASH.WITH.isPSI= 0
				PRINT(CASH.WITH.isPSI)
			#}
			ENDIF
			
			##############Tariff Last check start
			IF((CASH.WITH.isCorporate == "G") OR (CASH.WITH.isPSI == "G"))THEN
			#{
				PRINT(CUST.GCHRG.drAcctId)
				sv_s = "entityId, foracid, cust_id|"
				sv_s = sv_s + "SELECT ACID, FORACID, CIF_ID FROM TBAADM.GAM WHERE FORACID = '"+CUST.GCHRG.drAcctId+"'"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN	
					BANCS.INPUT.entityId = BANCS.OUTPARAM.entityId
					BANCS.INPUT.foracid = BANCS.OUTPARAM.foracid
					BANCS.INPUT.cust_id = BANCS.OUTPARAM.cust_id
					
					BANCS.INPUT.eventtype = "GCHRG"
					#BANCS.INPUT.eventid = COLL.GLBDATA.CWNOINSTR
					BANCS.INPUT.eventid = CUST.GCHRG.eventId
					
					PRINT(BANCS.INPUT.eventtype)
					PRINT(BANCS.INPUT.eventid)
					PRINT(BANCS.INPUT.entityId)
					PRINT(BANCS.INPUT.foracid)
					PRINT(BANCS.INPUT.cust_id)
				ELSE
					PRINT("Error occurred.")
					exitscript
				ENDIF
				
				##Variable Initialization
				BANCS.INPUT.AMTIND="N"
				BANCS.INPUT.AMT="0"
				BANCS.INPUT.PRCNT="0"
				
				#Acid
				IF(FIELDEXISTS(BANCS.INPUT.entityId))THEN
					
					print(BANCS.INPUT.entityId)
					
					sv_s = " corp_id, SEGMENT, foracid,cust_id,ccy| select corp_id, SEGMENTATION_CLASS,foracid,cif_id,acct_crncy_code from crmuser.accounts,tbaadm.gam " 
					sv_s = sv_s + " where orgkey =cif_id  and acid ='"+BANCS.INPUT.entityId+"'"
					sv_s = sv_s + " and gam.bank_id='"+BANCS.STDIN.contextBankId+"'     and  rownum=1"
					print(sv_s)
					sv_u = urhk_dbselectwithBind(sv_s)
					print(sv_u)
					IF (sv_u == 0) THEN		

						if(BANCS.OUTPARAM.corp_id !="") then
							BANCS.INPUT.custtype="C"
						else
							BANCS.INPUT.custtype="R"
						endif
						BANCS.INPUT.SME=BANCS.OUTPARAM.SEGMENT
						BANCS.INPUT.foracid=BANCS.OUTPARAM.foracid
						BANCS.INPUT.ccy=BANCS.OUTPARAM.ccy
						BANCS.INPUT.cust_id=BANCS.OUTPARAM.cust_id
					else
						BANCS.INPUT.SME=""
						BANCS.INPUT.foracid=""
						BANCS.INPUT.cust_id=""
						BANCS.INPUT.custtype=""
					ENDIF
				
				ELSE
					BANCS.INPUT.eventid="XXXXX"
					BANCS.INPUT.eventtype="XXXXX"
					BANCS.INPUT.foracid=""
					BANCS.INPUT.cust_id="XXXX"
					BANCS.INPUT.cifid="XXX"
					BANCS.INPUT.AGREEMENT_CODE=""
					BANCS.INPUT.SME=""
					BANCS.INPUT.custtype=""
					print(BANCS.INPUT.cust_id) 
					BANCS.INPUT.AMT1= 0
				ENDIF
				
				
				#Foracid
				sv_s =" AMTIND, PRCNT,AMT | select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
				sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
				sv_s = sv_s + " and foracid ='"+BANCS.INPUT.foracid +"'"
				sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
				sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN

					BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
					BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
					BANCS.INPUT.AMT1=BANCS.OUTPARAM.AMT
					BANCS.INPUT.PRCNT=BANCS.OUTPARAM.PRCNT
					print(BANCS.INPUT.AMT)
				else
					##BANCS.INPUT.AMTIND="N"
					##BANCS.INPUT.AMT="0"
					##BANCS.INPUT.PRCNT="0"
					BANCS.INPUT.TEST="1"
					
					BANCS.INPUT.AMTIND=BANCS.INPUT.AMTIND
					BANCS.INPUT.AMT=BANCS.INPUT.AMT
					BANCS.INPUT.PRCNT=BANCS.INPUT.PRCNT
				ENDIF
				
				
				#Cif id
				sv_s =" AMTIND, PRCNT,AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE   from custom.c_cpcm_data where entity_cre_flg='Y' and "
				sv_s = sv_s + " del_flg='N' and event_type ='"+BANCS.INPUT.eventtype+"' and event_id='"+BANCS.INPUT.eventid+"'"
				sv_s = sv_s + " and cust_id ='"+BANCS.INPUT.cust_id+"'"
				sv_s = sv_s + " and END_DATE >= to_date('"+BANCS.STDIN.BODDate+"','DD-MM-YYYY HH24:MI:SS') "
				sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
				print(sv_s)
				sv_u = urhk_dbselectwithBind(sv_s)
				print(sv_u)
				IF (sv_u == 0) THEN
					BANCS.INPUT.AMTIND=BANCS.OUTPARAM.AMTIND
					BANCS.INPUT.AMT=BANCS.OUTPARAM.AMT
