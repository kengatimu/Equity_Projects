					#sv_s = sv_s + " AND BANK_ID='"+BANCS.STDIN.contextBankId+"' and SRL_NUM IN (SELECT SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+COLL.GLBDATA.CWNOINSTR+"' AND  "
					sv_s = sv_s + " EVENT_ID IN '"+CUST.GCHRG.eventId+"' AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y' AND SCHM_CODE ='"+sv_h+"' AND CRNCY_CODE='"+sv_f+"' "
					sv_s = sv_s + " AND BANK_ID='"+BANCS.STDIN.contextBankId+"' and SRL_NUM IN (SELECT SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+CUST.GCHRG.eventId+"' AND  "
					sv_s = sv_s + " EVENT_TYPE='GCHRG' AND BANK_ID = '"+BANCS.STDIN.contextBankId+"') AND ROWNUM = 1"
