					sv_s = sv_s + " AND BANK_ID='"+BANCS.STDIN.contextBankId+"' and SRL_NUM IN (SELECT SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID = '"+CUST.GCHRG.eventId+"' AND  "
