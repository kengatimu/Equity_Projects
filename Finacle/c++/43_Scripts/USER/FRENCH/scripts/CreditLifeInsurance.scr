			BANCS.OUTPUT.AmountWithNoDiscount = CDOUBLE("0")
			PRINT(BANCS.OUTPUT.AmountWithNoDiscount)
			
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((CUST.DATA.custAge >= 18) AND (CUST.DATA.custAge <= 35))THEN
		#{
			IF(CUST.DATA.loanTenor == 1)THEN
			#{
				CUST.DATA.chrgPcnt = "0.45"
			#}
			ENDIF
			
