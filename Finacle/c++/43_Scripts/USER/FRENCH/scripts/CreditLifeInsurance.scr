		#-------------------------#
		#--	Charges calculation --#
		#-------------------------#
		
		PRINT(CUST.DATA.chrgPcnt)
		PRINT(CUST.DATA.uDisbAmt)
		PRINT(CUST.DATA.uCrncyCode)
		
		IF((CUST.DATA.uCrncyCode == "USD") AND (CUST.DATA.chrgPcnt != ""))THEN
		#{
			CUST.DATA.chrgPcnt = CDOUBLE(CUST.DATA.chrgPcnt) / 100
			PRINT(CUST.DATA.chrgPcnt)
			CUST.DATA.chrgAmt = CDOUBLE(CUST.DATA.uDisbAmt) * CDOUBLE(CUST.DATA.chrgPcnt)
			PRINT(CUST.DATA.chrgAmt)
			
			BANCS.OUTPUT.collAmount = CUST.DATA.chrgAmt
			PRINT(BANCS.OUTPUT.collAmount)
			BANCS.OUTPUT.collCrncy = CUST.DATA.uCrncyCode
			PRINT(BANCS.OUTPUT.collCrncy)
			BANCS.OUTPUT.AmountWithNoDiscount = CUST.DATA.chrgAmt
			PRINT(BANCS.OUTPUT.AmountWithNoDiscount)

		#}
		ELSE
		#{
			BANCS.OUTPUT.collAmount = CDOUBLE("0")
			PRINT(BANCS.OUTPUT.collAmount)
			BANCS.OUTPUT.collCrncy = CUST.DATA.uCrncyCode
			PRINT(BANCS.OUTPUT.collCrncy)
			BANCS.OUTPUT.AmountWithNoDiscount = CDOUBLE("0")
			PRINT(BANCS.OUTPUT.AmountWithNoDiscount)
		#}
		ENDIF
		
	
		#---------------------#
		# SRV Error check	--#
		#---------------------#
		ERRORCHECK:	
			IF (lv_q != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}									
				ELSE
				#{
					sv_v = 0
				#}
				ENDIF
				IF(sv_v > 0)THEN
				#{
					sv_u = system("echo 'Error'")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)

						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>XXXXXXXXXXXXXerror.log")
						print(sv_u)
						
						#Error response
						sv_t = "ERROR | " +sv_e
						sv_u = urhk_SetOrbOut(sv_t)

						GOTO ENDOFSCRIPT
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
	
		ENDOFSCRIPT: 
			EXITSCRIPT
	
	TRACE OFF
	
