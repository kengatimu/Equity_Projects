		#-----------------------------#
		
		CUST.DATA.uForacid = BANCS.INPUT.foracid
		PRINT(CUST.DATA.uForacid)
		CUST.DATA.uDisbAmt = TRIM(BANCS.INPUT.inputAmount)
		PRINT(CUST.DATA.uDisbAmt)
		CUST.DATA.uCrncyCode = BANCS.INPUT.inputCrncy
