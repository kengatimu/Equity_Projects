		PRINT(CUST.DATA.chrgPcnt)
		CUST.DATA.loanTenor = ""
		PRINT(CUST.DATA.loanTenor)
		
		#---------------------------------#
		#--	Get customers DOB and AGE	--#
		#---------------------------------#
		
		lv_s = "dateOfBirth, custAge|"
		lv_s = lv_s + " SELECT "
		lv_s = lv_s + " TO_CHAR(CUST_DOB, 'YYYY') AS DOB_YEAR, "
		lv_s = lv_s + " FLOOR(MONTHS_BETWEEN(SYSDATE, CUST_DOB) / 12) AS AGE "
		lv_s = lv_s + " FROM CRMUSER.ACCOUNTS  "
		lv_s = lv_s + " WHERE ORGKEY IN ( "
		lv_s = lv_s + " SELECT CIF_ID FROM TBAADM.GAM WHERE FORACID = '"+CUST.DATA.uForacid+"') "
		PRINT(lv_s)
		
		lv_q = urhk_dbSelectWithBind(lv_s) 
		PRINT(lv_q)
		
		IF(lv_q != 0)THEN
		#{
			GOTO ERRORCHECK
		#}
		ELSE
		#{
			CUST.DATA.custDOB = BANCS.OUTPARAM.dateOfBirth
			PRINT(CUST.DATA.custDOB)
			CUST.DATA.custAge = CINT(BANCS.OUTPARAM.custAge)
			PRINT(CUST.DATA.custAge)
		#}
		ENDIF
		
		#-----------------------------#
		#--	Get loan tenor in yrs	--#
		#-----------------------------#
		
		lv_s = "loanTenor|"
		lv_s = lv_s + " SELECT "
		lv_s = lv_s + " CEIL(REP_PERD_MTHS / 12) AS REP_PERD_YEARS "
		lv_s = lv_s + " FROM TBAADM.LAM "
		lv_s = lv_s + " WHERE ACID IN ( "
		lv_s = lv_s + " SELECT ACID FROM TBAADM.GAM WHERE FORACID = '"+CUST.DATA.uForacid+"') "
		PRINT(lv_s)
		
		lv_q = urhk_dbSelectWithBind(lv_s) 
		PRINT(lv_q)
		
		IF(lv_q != 0)THEN
		#{
			GOTO ERRORCHECK
		#}
		ELSE
		#{
			CUST.DATA.loanTenor = CINT(BANCS.OUTPARAM.loanTenor)
			PRINT(CUST.DATA.loanTenor)
		#}
		ENDIF
		
		#-------------------------------------------------------------#
		#--	Charges calculation with respect to loan tenor and age	--#
		#-------------------------------------------------------------#
		
		IF(CUST.DATA.custAge < 18)THEN
