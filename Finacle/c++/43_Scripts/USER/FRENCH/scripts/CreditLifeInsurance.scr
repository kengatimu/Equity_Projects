			#}
			ENDIF
			
			IF(CUST.DATA.loanTenor == 4)THEN
			#{
				CUST.DATA.chrgPcnt = "1.89"
			#}
			ENDIF
			
			IF(CUST.DATA.loanTenor == 5)THEN
			#{
				CUST.DATA.chrgPcnt = "2.41"
			#}
			ENDIF
			
			IF(CUST.DATA.loanTenor == 6)THEN
			#{
				CUST.DATA.chrgPcnt = "2.95"
			#}
			ENDIF
			
			IF(CUST.DATA.loanTenor == 7)THEN
			#{
				CUST.DATA.chrgPcnt = "3.52"
			#}
			ENDIF
			
			IF(CUST.DATA.loanTenor == 8)THEN
			#{
				CUST.DATA.chrgPcnt = "4.10"
			#}
			ENDIF
			
			IF(CUST.DATA.loanTenor == 9)THEN
