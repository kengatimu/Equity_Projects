			#}
			ENDIF
			
			IF(CUST.DATA.loanTenor == 10)THEN
			#{
				CUST.DATA.chrgPcnt = "5.34"
			#}
			ENDIF
			
		#}
		ENDIF
		
		IF((CUST.DATA.custAge >= 36) AND (CUST.DATA.custAge <= 45))THEN
