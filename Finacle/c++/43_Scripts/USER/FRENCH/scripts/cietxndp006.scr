		print(sv_u)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		print(sv_u)
		sv_u = urhk_SetOrbOut("Error_1|Error^Could not get Inter Entity Transaction Reference Number^prodCode")
		print(sv_u)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	######################################################################################
	# Create Transaction in the Current Entity
	######################################################################################
	
	CUST.CIETXN.entity1 = CUST.CIETXN.contextBankId
	CUST.CIETXN.entity2 = CUST.CIETXN.drAcctNumEntityId
	CUST.CIETXN.ieTxnRefNo = "IE" + CUST.CIETXN.entity1 + CUST.CIETXN.entity2 +CUST.CIETXN.ieTimeStamp+ CUST.CIETXN.seqNextVal
	PRINT(CUST.CIETXN.ieTxnRefNo)
		######################################################################################
		# Create an entry into CUSTOM.IE_TEMP_TBL 
		######################################################################################
		
		sv_b = "INSERT INTO CUSTOM.IE_TEMP (IE_TXN_REF_NO,USER_ID,INIT_ENTITY,TARGET_ENTITY,RCRE_TIME) VALUES "
		sv_b = sv_b + "(?SVAR,?SVAR,?SVAR,?SVAR,SYSDATE)"
		
		BANCS.INPARAM.BINDVARS = CUST.CIETXN.ieTxnRefNo + "|" + BANCS.STDIN.userId + "|" + CUST.CIETXN.entity1 + "|" + CUST.CIETXN.entity2 
		print(sv_b)
		print(BANCS.INPARAM.BINDVARS)
		
		sv_c = urhk_dbSQLWithBind(sv_b)
		PRINT(sv_c)
		
		IF(sv_c == 0)THEN
		#{
			sv_u = urhk_dbSqlWithBind("COMMIT")
		#}
		ELSE
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Failed to create an entry in IE_TEMP table")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	

	######################################################################################
	# Checking if another withdrawal exists 
	######################################################################################

	
	sv_s = "count|select count(1) "
	sv_s = sv_s + " from tbaadm.dtd where bank_id = ?SVAR and value_date = (select db_stat_date from tbaadm.gct where bank_id = ?SVAR) "
	sv_s = sv_s + "and acid in (select acid from tbaadm.gam where foracid = ?SVAR) "
	sv_s = sv_s + "and  tran_particular like 'CASH WITHDRWL THRU%' and tran_amt = ?SVAR "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.drAcctNumEntityId +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.CIETXN.drAcctNum + "|" + CUST.CIETXN.tranAmt
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d==0)THEN
	#{
		sv_f = BANCS.OUTPARAM.count
		IF(sv_f != 0) THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Transaction Already Created in the Target Entity for this Customer^prodCode")
			print(sv_u)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	sv_s = "count|select count(1) "
	sv_s = sv_s + " from tbaadm.dtd where tran_date = (select db_stat_date from tbaadm.gct where bank_id = ?SVAR) "
	sv_s = sv_s + "and ref_num = ?SVAR and  tran_particular like 'CASH WITHDRWL THRU%' and ref_amt = ?SVAR "
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.CIETXN.drAcctNum + "|" + CUST.CIETXN.refAmt
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_d==0)THEN
	#{
		sv_f = cint(BANCS.OUTPARAM.count)
		IF(sv_f != 0) THEN
		#{
			sv_u = urhk_dbSqlWithBind("ROLLBACK")
			print(sv_u)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			print(sv_u)
			sv_u = urhk_SetOrbOut("Error_1|Error^Transaction Already Created in the Initiating Entity for this Customer^prodCode")
