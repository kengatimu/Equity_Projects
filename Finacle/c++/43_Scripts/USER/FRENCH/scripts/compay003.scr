	sv_s = sv_s + " AND (DEL_FLG <> 'Y' AND ENTITY_CRE_FLG = 'Y')))"
	
	print(sv_s)
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  EQT.COMM.fxdCrncy + "|" + EQT.COMM.varCrncy + "|" + EQT.COMM.ratecode
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQT.COMM.varCrncy + "|" + EQT.COMM.fxdCrncy + "|" + EQT.COMM.ratecode
