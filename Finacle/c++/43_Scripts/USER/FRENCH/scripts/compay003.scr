		GOTO ENDOFSCRIPT
	#}
	endif
	
	sv_s = "varCrncy| SELECT VAR_CRNCY_UNITS FROM tbaadm.RTL WHERE BANK_ID = ?SVAR AND  VAR_CRNCY_CODE = ?SVAR  AND FXD_CRNCY_CODE = ?SVAR AND RATECODE = ?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  EQT.COMM.varCrncy + "|" + EQT.COMM.fxdCrncy + "|" + EQT.COMM.ratecode
