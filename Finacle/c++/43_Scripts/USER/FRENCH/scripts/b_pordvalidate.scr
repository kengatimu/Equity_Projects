<--START
CHECKSUM="97e343160c47f1c2f0f89916a1b15c35d9f6d928a39bd5c0014411eecfa24ace"
	TRACE ON
	sv_a=urhk_B2k_PrintRepos("BANCS")
	print(sv_a)
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		
		CREATEREP("CUST")
		
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST", "CDDUM") == 0) THEN
	#{
		
		CREATECLASS("CUST", "CDDUM", 5)
		
	#}
	ENDIF
	
	sv_a=urhk_SRV_GetVal("pordPaymentDtls.freeText1")
	PRINT(sv_a)
	CUST.CDDUM.freetext = BANCS.OUTPARAM.srvValue
	print(CUST.CDDUM.freetext)
	
	sv_a=urhk_SRV_GetVal("pordHeaderDtls.chrgAcct.foracid")
	PRINT(sv_a)
	CUST.CDDUM.foracid = BANCS.OUTPARAM.srvValue
	print(CUST.CDDUM.foracid)
	
	IF ((CUST.CDDUM.foracid=="0180293713910") OR (CUST.CDDUM.foracid=="0180291051982")) THEN
	#{
		
		IF (CUST.CDDUM.freetext=="") THEN
		#{
			
			sv_u = urhk_SRV_setErr("pordPaymentDtls.freeText1|Visit Additional details tab:Add Cheque No. in Freetext Line1")
			BANCS.OUTPUT.successOrFailure="F"
			
			
		#}
		ENDIF
	#}
	ENDIF
	###################################################
	#fetching schmCode of the tran account
	####################################################
		
	sv_r = urhk_getAcctDetailsInRepository(CUST.CDDUM.foracid)
	
	IF(sv_r == 0)THEN
	#{
		PRINT(BANCS.OUTPARAM.schmCode)
		CUST.CDDUM.schmCode = BANCS.OUTPARAM.schmCode
		
		IF(CUST.CDDUM.schmCode =="CA243")THEN
			sv_u = urhk_SRV_setErr("Outgoing Transfers Not Allowed on this schm Code:CA243")
			BANCS.OUTPUT.successOrFailure="F"

		ENDIF
			
	#}
	ENDIF

	
	TRACE OFF
	EXITSCRIPT
