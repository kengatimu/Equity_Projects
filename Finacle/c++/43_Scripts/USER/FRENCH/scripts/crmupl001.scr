		sv_z = urhk_SetOrbOut(sv_g)

		PRINT(sv_z)

		  #===========Fetch data for verification  START
		
                    sv_s = "customerid,customertype, myUserId | select CIF_ID,CUST_TYPE, RM from custom.CUSTOM_RM_UPDATE_CIF where ref_code=?SVAR and bank_id='"+BANCS.STDIN.contextBankId+"' "
                    BANCS.INPARAM.BINDVARS = CUST.CCRRM.refcode
