					CUST.CCRRM.SorFmessage = CUST.CCRRM.cust_id +"   "+CUST.CCRRM.SorFmessage 
					print(CUST.CCRRM.SorFmessage)
                                    
					 sv_r = system("echo '   "+CUST.CCRRM.SorFmessage+"' >> "+CUST.CCRRM.reportfile)
					print(sv_r)

					   		#++++++++++Update the records after verification
                                    
                                    #--------------------------------------------------------------------------------------------
                                    #-- Updating the CUSTOM_RM_UPDATE_CIF  table on the success condition  ---
                                    #-- status U - uploaded no modifification done yet-----------
                                    #-- status F - Failed to do modifification ------------------
                                    #-- status V - modification done, pending verification ------
                                    #-- status P - uploaded , modified done and verified --------
							  #-- status PP - uploaded , modified done and verified  and account manager modified--------
							  # status E - uploaded,modified CIF done, verified CIF, Failed to do account manager modification	
                                    #-----------------------------------------------------------------------------------------------            



                                    sv_s = "update CUSTOM.CUSTOM_RM_UPDATE_CIF  set STATUS_FLG=?SVAR,LCHG_USER_ID=?SVAR,LCHG_TIME=sysdate where CIF_ID=?SVAR  and REF_CODE=?SVAR and bank_id=?SVAR"
                                    print(sv_s)
                                    BANCS.INPARAM.BINDVARS =   CUST.CCRRM.verifyflg +"|"+ BANCS.STDIN.userId +"|"+ CUST.CCRRM.cust_id  +"|"+ CUST.CCRRM.refcode +"|"+BANCS.STDIN.contextBankId
                                    print(BANCS.INPARAM.BINDVARS)
                                    print(sv_s)
                                    sv_d=urhk_dbSqlWithBind(sv_s)
                                    IF (sv_d == 0)THEN
                                        sv_d = urhk_dbSQLWithBind("COMMIT")
