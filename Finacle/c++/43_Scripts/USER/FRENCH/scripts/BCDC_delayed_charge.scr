				#{
					CUST.CHRG.LIEN_STATUS_FLG = "Y"
					CUST.CHRG.LIEN_APPLIED_AMT = CUST.CHRG.lienAmt
					CUST.CHRG.remark = " Lien to be applied ON pending amount " 
					CUST.CHRG.resMsg = CUST.CHRG.acct + "|" + "    NA" + "|" + CUST.CHRG.remark
					PRINT(CUST.CHRG.resMsg)
					sv_b = urtn_fileWrite(CUST.CHRG.successFileIndex1  + "|" + CUST.CHRG.resMsg)
					GOTO FAILURE
					#}
				ELSE
					#{
					PRINT("LIEN UPDATION FAILED")
					CUST.CHRG.remark = CUST.CHRG.LienFailureReason
					GOTO FAILURE
				#}
				ENDIF
				#}
			ELSE
			### When the partial adjustment is failed and no lien marked earlier then lien should be marked with the remaining amount 
				#{
				IF((CUST.CHRG.taxflg == "N") AND (CUST.CHRG.adjstStatus == "P") )THEN
				#{
					IF(CUST.CHRG.LIEN_STATUS_FLG == "N")THEN
					#{
						CUST.CHRG.lienMark = "Y"
						CUST.CHRG.lienAmt = sv_i
					#	CALL("delayed_chrg_lien.scr")
					CUST.CHRG.LienSuccessOrFailure = "S"
						IF(CUST.CHRG.LienSuccessOrFailure == "S")THEN
						#{
							CUST.CHRG.LIEN_STATUS_FLG = "Y"
							CUST.CHRG.LIEN_APPLIED_AMT = 0
							CUST.CHRG.remark = " Lien to be applied ON pending amount "
							CUST.CHRG.resMsg = CUST.CHRG.acct + "|" + "NA" + "|" + CUST.CHRG.remark
							PRINT(CUST.CHRG.resMsg)
							sv_b = urtn_fileWrite(CUST.CHRG.successFileIndex1  + "|" + CUST.CHRG.resMsg)
							GOTO FAILURE
							#}
						ELSE
							#{
							PRINT("LIEN UPDATION FAILED")
							CUST.CHRG.remark = CUST.CHRG.LienFailureReason
							GOTO FAILURE
						#}
						ENDIF
						
					#}
					ENDIF
					
				#}
				ENDIF
			#}
			ENDIF
			
		#}
		ENDIF
		
		FAILURE:
			
			############################################################
			# update record IN CUSTOM.C_CHARGE_COLLECTION_BCDC
			############################################################
			CUST.CHRG.LIEN_APPLIED_AMT=0
			CUST.CHRG.LIEN_STATUS_FLG =""			

			sv_s= "UPDATE CUSTOM.C_CHARGE_COLLECTION_BCDC SET TOT_ADJ_AMT=?SVAR,FULLY_ADJUSTED_FLG=?SVAR,"
			sv_s= sv_s + "LAST_ADJUSTED_DATE=TO_DATE(?SVAR,'DD-MM-YY'),LIEN_STATUS_FLG=?SVAR,"
			sv_s= sv_s + "LIEN_APPLIED_AMT=?SVAR,LCHG_USER_ID=?SVAR,LCHG_TIME=SYSDATE,FAILURE_REMARKS=?SVAR WHERE SRL_NUM=?SVAR AND CHARGE_TYPE = ?SVAR"
			sv_s= sv_s + " AND TRAN_DATE =TO_DATE(?SVAR,'DD-MM-YY') AND ACCT_NUM=?SVAR AND SOL_ID=?SVAR AND BANK_ID=?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.CHRG.TOT_ADJ_AMT + "|" + CUST.CHRG.FULLY_ADJUSTED_FLG  + "|" + CUST.CHRG.BODDate
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CHRG.LIEN_STATUS_FLG+"|"+CUST.CHRG.LIEN_APPLIED_AMT
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId+ "|" + CUST.CHRG.remark+ "|" +CUST.CHRG.SRL_NUM
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  +"|"+ CUST.CHRG.CHARGE_TYPE +"|"+CUST.CHRG.TRAN_DATE
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CHRG.acct+ "|"+ BANCS.STDIN.mySolId+"|"+BANCS.STDIN.contextBankId
			sv_r = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_r)
			
			
			
			IF(sv_r == 0)THEN
			#{
				CUST.CHRG.resMsg = CUST.CHRG.acct + "|" + "Updated the record successfully"
				PRINT(CUST.CHRG.resMsg)
				#}
			ELSE
				#{
				CUST.CHRG.resMsg = CUST.CHRG.acct + "|" + "Failed to update the record"
				PRINT(CUST.CHRG.resMsg)
				sv_u = urhk_dbSqlWithBind("ROLLBACK")
			#}
			ENDIF

			
			IF(TRIM(CUST.CHRG.tranid) != "")THEN
			#{
				sv_s = "INSERT INTO CUSTOM.C_CHARGE_COLLECTION_TRAN_TBL(FORACID,SOL_ID,TRAN_DATE,TRAN_ID,TRAN_AMT,CHRG_CCY_CODE,RCRE_USER_ID"
				sv_s = sv_s +",RCRE_TIME,BANK_ID) VALUES (?SVAR,?SVAR,to_date(?SVAR,'DD-MM-YY'),?SVAR,?SVAR,?SVAR,?SVAR,sysdate,?SVAR)"
				BANCS.INPARAM.BINDVARS = CUST.CHRG.acct +"|"+ BANCS.STDIN.mySolId +"|"+ CUST.CHRG.BODDate +"|"+ CUST.CHRG.tranid +"|"+CUST.CHRG.debitAmt
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CHRG.CHARGE_CRNCY_CODE +"|"+ BANCS.STDIN.userId+"|"+BANCS.STDIN.contextBankId
				PRINT(sv_s)
				PRINT(BANCS.INPARAM.BINDVARS)
	                        sv_r = urhk_dbSqlWithBind(sv_s)
       		                PRINT(sv_r)

	                        IF(sv_r == 0)THEN
                        	#{
                                	CUST.CHRG.resMsg = CUST.CHRG.acct + "|" + "Inserted the record successfully"
                                	PRINT(CUST.CHRG.resMsg)
                                #}
                        	ELSE
                                #{
                                	CUST.CHRG.resMsg = CUST.CHRG.acct + "|" + "Failed to insert the record"
                                	PRINT(CUST.CHRG.resMsg)
				#}
				ENDIF
                        #}
                        ENDIF

		NEXTACID:
			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_n)
		PRINT(sv_c)
		
	ENDOFSCRIPT:
		IF(CUST.CHRG.errMsg == "") THEN
		#{
			CUST.CHRG.errMsg = " Other Accounts|Batch Job executed with out any Errors"
			sv_b = urtn_fileWrite(CUST.CHRG.failFileIndex1 + "|" + CUST.CHRG.errMsg)
			PRINT(sv_b)
		#}
		ENDIF
		
		sv_c = urtn_fileClose(CUST.CHRG.failFileIndex1)
		PRINT(sv_c)
		sv_c = urtn_fileClose(CUST.CHRG.successFileIndex1)
		PRINT(sv_c)
		
		CUST.CHRG.ERR000002 = "Failed "
		PRINT(CUST.CHRG.list_file_name)
		sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.CHRG.mrt_file_name + " " + CUST.CHRG.list_file_name + " " + CUST.CHRG.rpt
		PRINT(sv_r)
		sv_r = SYSTEM(sv_r)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.CHRG.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.CHRG.rpt_file_name+" '" + CUST.CHRG.title+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		
		##############
		
		PRINT(CUST.CHRG.list_file_nameSuccess )
		sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.CHRG.mrt_file_name1 + " " + CUST.CHRG.list_file_nameSuccess  + " " + CUST.CHRG.rptSuccess
		PRINT(sv_r)
		sv_r = SYSTEM(sv_r)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.CHRG.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.CHRG.rpt_file_nameSuccess+" '" + CUST.CHRG.titleSuccess+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		
		
		##############
		
		
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.CHRG.ERR000002 + "^DATE")
			GOTO FINISH
		#}
		ENDIF
		
		sv_c = urtn_fileClose(CUST.CHRG.failFileIndex1)
		PRINT(sv_c)
		
		
	FINISH:
		TRACE OFF
		
END-->


