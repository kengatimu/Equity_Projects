						PRINT("LIEN UPDATION FAILED")
						CUST.CHRG.remark = CUST.CHRG.LienFailureReason
						GOTO FAILURE
					#}
					ENDIF
					
				#}
				ENDIF
			#}
			ENDIF
			### When the partial  amount is adjusted lien should be marked/removed with the remaining/adjusted amount 
			IF((CUST.CHRG.taxflg == "Y") AND (CUST.CHRG.adjstStatus == "P") )THEN
