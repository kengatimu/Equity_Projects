						#{
							PRINT("LIEN UPDATION FAILED")
							CUST.CHRG.remark = CUST.CHRG.LienFailureReason
							GOTO FAILURE
						#}
						ENDIF
					
					#}
					ELSE
					#{
						CUST.CHRG.resMsg = CUST.CHRG.acct + "|" + "    NA" + "|" + CUST.CHRG.remark
						PRINT(CUST.CHRG.resMsg)
						sv_b = urtn_fileWrite(CUST.CHRG.successFileIndex1  + "|" + CUST.CHRG.resMsg)
						GOTO FAILURE
					#}
					ENDIF
				#}
