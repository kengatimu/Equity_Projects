					CUST.CHRG.LIEN_APPLIED_AMT = CDOUBLE(CUST.CHRG.TOTAL_CHARGE_AMT) - CDOUBLE(CUST.CHRG.TOT_ADJ_AMT)
				#}
				ENDIF
			#}
			ENDIF
			
			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)
