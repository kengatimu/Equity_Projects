						print(CUST.CHRG.collChargeAmt)

					sv_l= CDOUBLE(CUST.CHRG.TOT_ADJ_AMT) + CDOUBLE(CUST.CHRG.collChargeAmt) + CDOUBLE(CUST.CHRG.collVatAmt)
