		#}
	ELSE
		#{
		CUST.DATA.errorFlg="Y"
		#CUST.DATA.errorMsg ="Invalid Input entered"
		CUST.DATA.errorMsg ="Maximum allowed preferential interest is not maintianed for the user Role"
		GOTO ENDOFSCRIPT
		#}
		
	#}
	ENDIF
	CUST.DATA.intrst = BANCS.OUTPARAM.intrst
	PRINT(CUST.DATA.intrst)
	
	IF(CDOUBLE(CUST.DATA.prIntrst) > CDOUBLE(CUST.DATA.intrst)) THEN
	#{
		CUST.DATA.errorFlg="Y"
		CUST.DATA.errorMsg ="Maximum Allowed Preferential Interest is " + CUST.DATA.intrst + " only"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	ENDOFSCRIPT:
