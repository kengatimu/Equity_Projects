	###########################################################################################
	
	sv_s = "role| select ROLE_ID from tbaadm.upr where USER_ID=?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS=BANCS.STDIN.userId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	CUST.DATA.role = BANCS.OUTPARAM.role
	PRINT(CUST.DATA.role)
	
	###########################################################################################
	# Fetching preferential interest from custom table
	###########################################################################################
	
	sv_s ="intrst| select PREF_INTEREST from custom.c_prefint where ROLE_ID=?SVAR AND bank_id=?SVAR AND ENTITY_CRE_FLG='Y' AND DEL_FLG='N'"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS=CUST.DATA.role +"|" + BANCS.STDIN.contextBankId
