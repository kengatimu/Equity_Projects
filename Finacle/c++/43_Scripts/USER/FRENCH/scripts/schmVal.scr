	CUST.DATA.errorMsg = " "
	CUST.DATA.role = " "
	CUST.DATA.intrst =" "
	CUST.DATA.schm =" "
	IF(FIELDEXISTS(BANCS.INPUT.prIntrst)) THEN
	#{
		IF(TRIM(BANCS.INPUT.prIntrst) != "")THEN
		#{
			CUST.DATA.prIntrst= TOUPPER(TRIM(BANCS.INPUT.prIntrst))
			PRINT(CUST.DATA.prIntrst)
		#}
		ENDIF
	#}
	ENDIF
	CUST.DATA.acctNum=BANCS.INPUT.acctNum
	PRINT(CUST.DATA.acctNum)
	
	sv_s = "schm| select SCHM_TYPE from tbaadm.gam where foracid =?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS=CUST.DATA.acctNum
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	CUST.DATA.schm = BANCS.OUTPARAM.schm
