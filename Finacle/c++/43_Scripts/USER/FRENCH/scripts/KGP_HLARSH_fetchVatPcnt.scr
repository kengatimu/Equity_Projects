<--START
TRACE ON
	
	#-----------------------------------------
	#  Create the required repository Classes
	#------------------------------------------
	
                IF(REPEXISTS("CUST") == 0) THEN
                #{
                        CREATEREP("CUST")
                #}
                ENDIF

                IF (CLASSEXISTS("CUST", "LARSH") == 0) THEN
                #{
                        CREATECLASS("CUST", "LARSH", 5)
                #}
                ENDIF
		sv_e = urhk_B2k_PrintRepos("BANCS")
		print(sv_e)
	#-----------------------------------------------------
	# Input Fields Values
	#-----------------------------------------------------
		IF(FIELDEXISTS(BANCS.INPUT.acct_number)) THEN
		#{
			CUST.LARSH.acct_number = BANCS.INPUT.acct_number
			PRINT(CUST.LARSH.acct_number)
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.sol_id)) THEN
		#{
			CUST.LARSH.sol_id = BANCS.INPUT.sol_id
			PRINT(CUST.LARSH.sol_id)
		#}
		ENDIF


	#--------------------------------
	# Intialization of Local Fields
	#-------------------------------
	
		CUST.LARSH.vatPcnt	= "0"
		CUST.LARSH.gracePerdiod	= "0"
		CUST.LARSH.loanAmount	= "0"
	
	#---------------------------------------------
	#	Fetching Event details from PTT table
	#---------------------------------------------

		lv_q = "vatPcnt|SELECT AMT_PCNT FROM TBAADM.PTT,TBAADM.ADM WHERE AMT_DERV_SRL_NUM = AMT_DRV_SRL_NUM "
		lv_q = lv_q + " AND EVENT_TYPE = 'LNKED' AND EVENT_ID = ?SVAR AND PTT.ENTITY_CRE_FLG = 'Y' "
		lv_q = lv_q + " AND PTT.DEL_FLG != 'Y' AND ADM.ENTITY_CRE_FLG = 'Y' AND ADM.DEL_FLG != 'Y'"
		lv_q = lv_q + " AND AMT_IND = 'P' AND PTT.BANK_ID = ?SVAR AND ADM.BANK_ID = ?SVAR"

		PRINT(lv_q)

		#BANCS.INPARAM.BINDVARS = "OUTRTGCHG_DUTY" +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = "VATEUR" +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		lv_u = urhk_dbSelectWithBind(lv_q)
		PRINT(lv_u)

		IF(lv_u == "0") THEN
		#{
			CUST.LARSH.vatPcnt	 = BANCS.OUTPARAM.vatPcnt
			PRINT(CUST.LARSH.vatPcnt)
		#}
		ENDIF

	#---------------------------------------------
	#	Fetching grace period  
	#---------------------------------------------

		lv_q = "gracePerdiod,loanAmount|SELECT INSTLMNT_GRACE_PERD_MNTHS,SANCT_LIM FROM TBAADM.LAM, TBAADM.GAM"
		lv_q = lv_q + " WHERE LAM.ACID = GAM.ACID AND FORACID = ?SVAR "
		lv_q = lv_q + " AND GAM.BANK_ID = ?SVAR AND LAM.BANK_ID = ?SVAR "
		PRINT(lv_q)

		BANCS.INPARAM.BINDVARS = CUST.LARSH.acct_number +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		lv_u = urhk_dbSelectWithBind(lv_q)
		PRINT(lv_u)

		IF(lv_u == "0") THEN
		#{
			CUST.LARSH.gracePerdiod	 = BANCS.OUTPARAM.gracePerdiod
			PRINT(CUST.LARSH.gracePerdiod)

			CUST.LARSH.loanAmount	 = BANCS.OUTPARAM.loanAmount
			PRINT(CUST.LARSH.loanAmount)
		#}
		ENDIF

	#---------------------------------------------
	#	Sending values back to mrt
	#---------------------------------------------
	
		BANCS.OUTPUT.vatPcnt      = CUST.LARSH.vatPcnt
		BANCS.OUTPUT.gracePerdiod = CUST.LARSH.gracePerdiod
		BANCS.OUTPUT.loanAmount   = CUST.LARSH.loanAmount

 
	#-------------------------------------------------------------------
	#     Inserting data in the custom date C_HLARSH_OUTPUT
	#-------------------------------------------------------------------
	
	#sv_s = "INSERT INTO custOM.C_HLARSH_OUPUT(SOL_ID,ACCT_NUM,ACCT_NAME,SCHM_CODE,ACCT_OPN_DATE,FLOW_DATE,FLOW_AMT,INTEREST_AMT,ACCT_CRNCY_CODE) VALUES("
	#sv_s = sv_s + " ?svar,"
	#sv_s = sv_s + " ?svar,"
	#sv_s = sv_s + " ?svar,"
	#sv_s = sv_s + " ?svar,"
	#sv_s = sv_s + " ?svar,"
	#sv_s = sv_s + " ?svar,"
	#sv_s = sv_s + " ?svar,"

	#sv_s = sv_s + " ?svar)"

	#print(sv_s)
	#call("HLARSH_GettingValues.scr")

