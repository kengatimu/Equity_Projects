<--START
CHECKSUM="22c624c4bbff5129ffa2aea2cc57403435624a8919345e2117c653c57a4a288f"
	TRACE ON
	
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUSTS") == 0) THEN
	#{
		CREATEREP("CUSTS")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUSTS","SBACT") == 0) THEN
	#{
		CREATECLASS("CUSTS","SBACT", 5)
	#}
	ENDIF
	#------------------------------------------------------------------------------
	#Initialisig required repository variables
	#------------------------------------------------------------------------------
	CUSTS.SBACT.errMsg = ""
	CUSTS.SBACT.b2kidnew = ""
	CUSTS.SBACT.b2kidnewflg = ""
	
	#------------------------------------------------------------------------------
	#Finding count of records that need to be processed
	#------------------------------------------------------------------------------
	sv_s="custcount|"
	sv_s = sv_s + " select count(1) from custom.bulklien_recon_transDR3   where REMOVELIENID is not null   "
	print(sv_s)
	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF (sv_d != 0) THEN
	#{
		CUSTS.SBACT.errMsg = "DB ERROR!"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.custcount)
		IF (CINT(BANCS.OUTPARAM.custcount)== 0) THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	CUSTS.SBACT.b2kidnewflg="N"
	print(CUSTS.SBACT.b2kidnewflg)
	
	sv_s=" foracid,sol_id, narr, cyc_code,lien_amt,foracid_recover,lienreasoncode,b2kid,postseq,removelienid|"
	sv_s = sv_s + " select foracid,'15000' sol_id , TRAN_PARTICULAR narr, ACCT_CRNCY_CODE cyc_code,TRAN_AMT lien_amt, (select foracid from tbaadm.gam  where bank_id='43' and  acid=dd.acid and rownum<2 ) foracid_recover  "
	sv_s = sv_s + " , 'CHRGL' lienreasoncode,TRAN_PARTICULAR_21 b2kid,POSTSEQ,REMOVELIENID from custom.bulklien_recon_transDR3 dd where foracid is not null  and TRANDETAILS_FLG='N' and REMOVELIENID is not null  "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_c)
	
	IF (sv_c==0) THEN
	#{
		CUSTS.SBACT.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
		print(sv_k)
		
		WHILE (sv_k == 0)
		#{
			CUSTS.SBACT.foracid	= BANCS.OUTPARAM.foracid
			CUSTS.SBACT.sol_id	= BANCS.OUTPARAM.sol_id
			CUSTS.SBACT.narr	= BANCS.OUTPARAM.narr
			CUSTS.SBACT.cyc_code = BANCS.OUTPARAM.cyc_code
			print(CUSTS.SBACT.cyc_code)
			CUSTS.SBACT.lien_amt = BANCS.OUTPARAM.lien_amt
			print(CUSTS.SBACT.lien_amt)
			CUSTS.SBACT.amount = CUSTS.SBACT.lien_amt
			print(CUSTS.SBACT.amount)
			CUSTS.SBACT.LIEN_AMT = CUSTS.SBACT.amount
			print(CUSTS.SBACT.LIEN_AMT)
			CUSTS.SBACT.NEW_LIEN=0
			CUSTS.SBACT.foracid_recover = BANCS.OUTPARAM.foracid_recover
			print(CUSTS.SBACT.foracid_recover)
			CUSTS.SBACT.lienreasoncode = BANCS.OUTPARAM.lienreasoncode
			print(CUSTS.SBACT.lienreasoncode)
			CUSTS.SBACT.b2kid = BANCS.OUTPARAM.b2kid
			print(CUSTS.SBACT.b2kid)
			CUSTS.SBACT.narr=MID$(CUSTS.SBACT.narr,0,50)
			print(CUSTS.SBACT.narr)
			CUSTS.SBACT.LIEN_REMARKS = CUSTS.SBACT.narr
			print(CUSTS.SBACT.LIEN_REMARKS)
			CUSTS.SBACT.postseq = BANCS.OUTPARAM.postseq
			print(CUSTS.SBACT.postseq)
			CUSTS.SBACT.removelienid = BANCS.OUTPARAM.removelienid
			print(CUSTS.SBACT.removelienid)
			CUSTS.SBACT.b2kid = CUSTS.SBACT.removelienid
			print(CUSTS.SBACT.b2kid)
			
			print(CUSTS.SBACT.foracid)
			CUSTS.SBACT.FORACID = CUSTS.SBACT.foracid
			print(CUSTS.SBACT.FORACID)
			print(CUSTS.SBACT.sol_id)
			print(CUSTS.SBACT.amount)
			
			#######

			CUSTS.SBACT.NEW_LIEN = CUSTS.SBACT.LIEN_AMT
			PRINT(CUSTS.SBACT.NEW_LIEN)
			CUSTS.SBACT.collChargeAmt = CUSTS.SBACT.NEW_LIEN
			print(CUSTS.SBACT.collChargeAmt)
	
			CUSTS.SBACT.NEW_LIEN_PRE = 0
			PRINT(CUSTS.SBACT.NEW_LIEN)
			PRINT(CUSTS.SBACT.b2kid)
			PRINT(CUSTS.SBACT.FORACID)
			PRINT(CUSTS.SBACT.LIEN_AMT)
			#fetch all the details of the exisiting lien.
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUSTS.SBACT.FORACID)
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleId|" + CUSTS.SBACT.b2kid)
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00")
			sv_a = urhk_ExecSrvNoCommit("SRV_FetchLienDtlsOnAcForMod|retain_all_output = Y")
			PRINT(sv_a)
			IF (sv_a != 0) THEN
				PRINT("Lien fetch error ")
				###########
				IF (sv_a != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						PRINT(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					
					IF (sv_v > 0) THEN
					#{
						sv_i =1
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)

						sv_h = mid$(BANCS.STDIN.BODDate,0,10)
						print(sv_h)
						sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
						BANCS.INPARAM.BINDVARS =  sv_h
						sv_d = urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						
						IF (sv_d =="0") THEN
						#{
							print(BANCS.OUTPARAM.getboddate)
							sv_y = BANCS.OUTPARAM.getboddate
							print(sv_y)
							#SYSTEM_DATE ,  FORACID,  B2K_ID ,    LIEN_AMT ,  NARRATIONS ,  ERROR_DESC ,  BANK_ID

							BANCS.INPARAM.BINDVARS = sv_y + "|" + CUSTS.SBACT.FORACID + "|" + CUSTS.SBACT.b2kid + "|" + CUSTS.SBACT.LIEN_AMT + "|" + CUSTS.SBACT.LIEN_REMARKS  + "|" + sv_e  + "|" +  BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_j = "insert into CUSTOM.AUTO_LIEN_CHECK values ( ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR) "
							sv_w = urhk_dbSQLWithBind(sv_j)
							sv_w = urhk_dbSQLWithBind("COMMIT")
							print(sv_j)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				###########
				GOTO NEXTACID
			ENDIF

			sv_a = urhk_CopyOutToIn("")
			PRINT(sv_a)

			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUSTS.SBACT.NEW_LIEN_PRE + "|"+ CUSTS.SBACT.cyc_code)
			sv_a = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
			PRINT(sv_a)
			IF (sv_a!=0) THEN
				PRINT("Lien removal error ")
				IF (sv_a != 0) THEN
				#{
					IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
					#{
						PRINT(BANCS.OUTPARAM.Error_num)
						sv_v = BANCS.OUTPARAM.Error_num
						#}
					ELSE
						#{
						sv_v = 0
					#}
					ENDIF
					
					IF (sv_v > 0) THEN
					#{
						sv_i =1
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)

						sv_h = mid$(BANCS.STDIN.BODDate,0,10)
						print(sv_h)
						sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
						BANCS.INPARAM.BINDVARS =  sv_h
						sv_d = urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						
						IF (sv_d =="0") THEN
						#{
							print(BANCS.OUTPARAM.getboddate)
							sv_y = BANCS.OUTPARAM.getboddate
							print(sv_y)
							#SYSTEM_DATE ,  FORACID,  B2K_ID ,    LIEN_AMT ,  NARRATIONS ,  ERROR_DESC ,  BANK_ID

							BANCS.INPARAM.BINDVARS = sv_y + "|" + CUSTS.SBACT.FORACID + "|" + CUSTS.SBACT.b2kid + "|" + CUSTS.SBACT.LIEN_AMT + "|" + CUSTS.SBACT.LIEN_REMARKS  + "|" + sv_e  + "|" +  BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_j = "insert into CUSTOM.AUTO_LIEN_CHECK values ( ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR)"
							sv_w = urhk_dbSQLWithBind(sv_j)
							sv_w = urhk_dbSQLWithBind("COMMIT")
							print(sv_j)
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				GOTO NEXTACID
			ELSE
				BANCS.INPARAM.BINDVARS = CUSTS.SBACT.FORACID + "|" + CUSTS.SBACT.b2kid + "|" + CUSTS.SBACT.postseq
				print(BANCS.INPARAM.BINDVARS)
				sv_j = " update custom.bulklien_recon_transDR3 set TRANDETAILS_FLG='P'  where FORACID=?SVAR and REMOVELIENID = ?SVAR and POSTSEQ= ?SVAR  "
				print(sv_j)
				sv_w = urhk_dbSQLWithBind(sv_j)
				print(sv_w)
				sv_w = urhk_dbSQLWithBind("COMMIT")
				print(sv_w)

				CUSTS.SBACT.b2kidnewflg="Y"
				print(CUSTS.SBACT.b2kidnewflg)
			ENDIF
			#######

			IF (CUSTS.SBACT.b2kidnewflg=="Y")  THEN
				print("Ok go to posting")
				 CALL("AutoLienColl_PostDebitbackRB3.scr")
			ENDIF

			NEXTACID:
			
			sv_k = urhk_dbCursorFetch(CUSTS.SBACT.DbcursorNumber)
			print(sv_k)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(CUSTS.SBACT.DbcursorNumber)
		print(sv_c)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUSTS.SBACT.errMsg != "") THEN
		#{
			sv_u = system("echo '"+CUSTS.SBACT.errMsg+"' >>lienedfttgyhuj.log")
		#}
		ENDIF
		
		EXITSCRIPT
END-->
