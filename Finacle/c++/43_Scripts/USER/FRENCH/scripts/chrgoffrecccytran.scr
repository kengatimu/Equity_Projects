	#ENDIF
	#sv_u = urhk_MTTS_PopulateInputDetails("")
	
	#PRINT(sv_r)
	
	#==========================================================*
	# Intilializing the Variables
	#==========================================================*
	
	CUST.CHRGOF.tranId = ""
	CUST.CHRGOF.ErrMsg = ""
	CUST.CHRGOF.Fccybacid = ""
	CUST.CHRGOF.Hccybacid = ""
	CUST.CHRGOF.Fccyacnt = ""
	CUST.CHRGOF.Hccyacnt = ""
	CUST.CHRGOF.failRmks = ""
	CUST.CHRGOF.rateCode = ""
	CUST.CHRGOF.FCrncy = ""
	CUST.CHRGOF.Tranrmks = ""

        sv_s = "timeStamp|select to_char(sysdate,'ddmmyyyyhhmiss') from dual"
        PRINT(sv_s)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
                CUST.CHRGOF.timeStamp = BANCS.OUTPARAM.timeStamp
                PRINT(CUST.CHRGOF.timeStamp)
        #}
        ENDIF

	
    	CUST.CHRGOF.BODDate=MID$(BANCS.STDIN.BODDate,0,10)

    	CUST.CHRGOF.failureFile = "failfile_FcyCHRGtoHcyCHRG_" + BANCS.STDIN.mySolId + ".lst"
    	CUST.CHRGOF.failFileIndex1 = ""
    	CUST.CHRGOF.failFileIndex1 = urtn_fileOpen(CUST.CHRGOF.failureFile + "|w")

    	CUST.CHRGOF.successFile = "successFile_FcyCHRGtoHcyCHRG_" + BANCS.STDIN.mySolId + ".lst"
    	CUST.CHRGOF.successFileIndex1 = ""
    	CUST.CHRGOF.successFileIndex1 = urtn_fileOpen(CUST.CHRGOF.successFile + "|w")

    	PRINT(CUST.CHRGOF.failFileIndex1)
    	PRINT(CUST.CHRGOF.successFileIndex1)

    	CUST.CHRGOF.list_file_name = CUST.CHRGOF.failureFile
    	CUST.CHRGOF.title = "FccyPL to HccyPL Failure Report"
    	CUST.CHRGOF.mrt_file_name = "FcyCHRGtoHcyCHRG.mrt"
    	CUST.CHRGOF.rpt_file_name = "FcyCHRGtoHcyCHRG_" + CUST.CHRGOF.timeStamp + ".rpt"
    	CUST.CHRGOF.rpt =  "FcyCHRGtoHcyCHRG_" + CUST.CHRGOF.timeStamp

    	CUST.CHRGOF.list_file_nameSuccess = CUST.CHRGOF.successFile
    	CUST.CHRGOF.titleSuccess = "FccyPL to HccyPL Success Report"
    	CUST.CHRGOF.mrt_file_name1 = "FcyCHRGtoHcyCHRG.mrt"
    	CUST.CHRGOF.rpt_file_nameSuccess = "FcyCHRGtoHcyCHRGSuccess_" + CUST.CHRGOF.timeStamp + ".rpt"
    	CUST.CHRGOF.rptSuccess =  "FcyCHRGtoHcyCHRGSuccess_" +  CUST.CHRGOF.timeStamp

	#sv_r = urhk_MTTS_Close("")
	#PRINT(sv_r)
	
	#----------------------------------------------------------------*
	# fetching the rate code from CPARAM table
	#----------------------------------------------------------------*
	CUST.CHRGOF.parameterId = "FCHRGOFF_RATECODE"
	CUST.CHRGOF.module = "OT"
	
	sv_s = "ratecode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPVALUE CV,CUSTOM.C_CPMASTER CM WHERE CV.PARAMETER_ID = ?SVAR AND "
	sv_s = sv_s + " CM.MODULE_NAME = ?SVAR AND CM.PARAMETER_ID = CV.PARAMETER_ID AND CV.BANK_ID = ?SVAR AND CM.BANK_ID = CV.BANK_ID"
	
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.CHRGOF.parameterId + "|" + CUST.CHRGOF.module + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		CUST.CHRGOF.rateCode = BANCS.OUTPARAM.ratecode
		PRINT(CUST.CHRGOF.rateCode)
	#}
	ELSE
	#{
		CUST.CHRGOF.ErrMsg = "CPARAM is not maintained for ratecode:"+CUST.CHRGOF.parameterId
		PRINT(CUST.CHRGOF.ErrMsg)
		sv_b = urtn_fileWrite(CUST.CHRGOF.failFileIndex1 + "|" + CUST.CHRGOF.ErrMsg)
		GOTO ENDOFSCRIPT	
	#}
	ENDIF

        sv_s = "Fccyacnt,Fccybacid,FCrncy|select foracid,bacid,acct_crncy_code from tbaadm.gam where bank_id=?SVAR and del_flg='N' and acct_cls_flg='N'"
        sv_s = sv_s +"  and entity_cre_flg='Y' and bacid in (select distinct RECOVER_LOSSLINE_BACID from tbaadm.gsp where bank_id=?SVAR and schm_type='LAA'  "
	sv_s = sv_s +"and RECOVER_LOSSLINE_BACID is not null) and acct_crncy_code in ('USD','EUR') and sol_id=?SVAR and gam.clr_bal_amt<>0"

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF(sv_c != 0)THEN
	#{
		CUST.CHRGOF.ErrMsg = "There are no Foriegn Currency Charge Off accounts exists for Sol " + BANCS.STDIN.mySolId
		PRINT(CUST.CHRGOF.ErrMsg)
		sv_b = urtn_fileWrite(CUST.CHRGOF.failFileIndex1 + "|" + CUST.CHRGOF.ErrMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(sv_n)
	
	sv_f = urhk_dbCursorFetch(sv_n)
	PRINT(sv_f)
	
	IF(sv_f != 0)THEN
	#{
		CUST.CHRGOF.ErrMsg = "There are no Foriegn Currency Charge Off accounts exists for Sol " + BANCS.STDIN.mySolId
		PRINT(CUST.CHRGOF.ErrMsg)
		sv_b = urtn_fileWrite(CUST.CHRGOF.failFileIndex1 + "|" + CUST.CHRGOF.ErrMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	WHILE(sv_f == 0)
	#{
		CUST.CHRGOF.Fccyacnt = BANCS.OUTPARAM.Fccyacnt
		CUST.CHRGOF.Fccybacid = BANCS.OUTPARAM.Fccybacid
		CUST.CHRGOF.FCrncy = BANCS.OUTPARAM.FCrncy
		PRINT(CUST.CHRGOF.Fccyacnt)
		PRINT(CUST.CHRGOF.Fccybacid)
		PRINT(CUST.CHRGOF.FCrncy)
		CUST.CHRGOF.tranAmt = ""	
		CUST.CHRGOF.tranId = ""
		CUST.CHRGOF.pstdFlg = "N"
		CUST.CHRGOF.Hccyacnt = ""
		CUST.CHRGOF.Msg = ""
		
		sv_u = urhk_getAcctDetailsInRepository(CUST.CHRGOF.Fccyacnt)
		IF(sv_u == 0) THEN
		#{
			CUST.CHRGOF.tranAmt = BANCS.OUTPARAM.EffAvailableAmt
		#}
		ENDIF

		#-------------------------------------------------------------------------------------------*
		# fetching the Home Currency account
		#--------------------------------------------------------------------------------------------*
		
		sv_s = "Hccyacnt|select foracid from tbaadm.gam where del_flg='N' and acct_cls_flg='N' and entity_cre_flg='Y' and"
		sv_s = sv_s +" bacid =?SVAR and bank_id=?SVAR and acct_crncy_code =?SVAR and sol_id=?SVAR"

		BANCS.INPARAM.BINDVARS = CUST.CHRGOF.Fccybacid +"|"+ BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode +"|"+ BANCS.STDIN.mySolId
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.CHRGOF.Hccyacnt = BANCS.OUTPARAM.Hccyacnt
			PRINT(CUST.CHRGOF.Hccyacnt)
		#}
		ELSE
		#{
			CUST.CHRGOF.ErrMsg = "There are no Home Currency Charge Off accounts exists for Sol "+ BANCS.STDIN.mySolId +" and bacid "+ CUST.CHRGOF.Fccybacid
			PRINT(CUST.CHRGOF.ErrMsg)
			sv_b = urtn_fileWrite(CUST.CHRGOF.failFileIndex1 + "|" + CUST.CHRGOF.ErrMsg)
			GOTO NXTBACID			
		#}
		ENDIF	
		
		IF(CUST.CHRGOF.FCrncy == BANCS.STDIN.homeCrncyCode) THEN
		#{
			CUST.CHRGOF.tranAmt = CDOUBLE(CUST.CHRGOF.tranAmt)
			PRINT(CUST.CHRGOF.tranAmt)
			#}
		ELSE
			#{
			BANCS.INPARAM.FromCurrency = CUST.CHRGOF.FCrncy
			PRINT(BANCS.INPARAM.FromCurrency)
			BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
			PRINT(BANCS.INPARAM.ToCurrency)
			BANCS.INPARAM.RateCode = CUST.CHRGOF.rateCode
			PRINT(BANCS.INPARAM.RateCode)
			BANCS.INPARAM.Rate = "0.00"
			BANCS.INPARAM.CustId = ""
			BANCS.INPARAM.InputAmount = CUST.CHRGOF.tranAmt
			sv_u = urhk_B2k_ConvertAmount("")
			PRINT(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				CUST.CHRGOF.tranAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(CUST.CHRGOF.tranAmt)
				
				#}
			ELSE
				#{
				CUST.CHRGOF.ErrMsg = "Amount Conversion is failed for bacid "+ CUST.CHRGOF.Fccybacid+" From Currency "+CUST.CHRGOF.FCrncy
				PRINT(CUST.CHRGOF.ErrMsg)
				sv_b = urtn_fileWrite(CUST.CHRGOF.failFileIndex1 + "|" + CUST.CHRGOF.ErrMsg)
				GOTO NXTBACID			
			#}
			ENDIF
		#}
		ENDIF
		
		
		
		#==========================================================*
		# Transaction part starts here
		#==========================================================*
		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.CommitFlg = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
		BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw = "Y"
		BANCS.INPARAM.CheckExceptions = "Y"
		#sv_r = urhk_MTTS_Initialize("")
		#PRINT(sv_r)
		#---------------------------------------------------------------------------------*
		# Populate Transaction details
		#---------------------------------------------------------------------------------*
		MTT.TranDetails.TranID = ""
		MTT.TranDetails.TranDate = "0"
		MTT.TranDetails.TranType = "T"
		MTT.TranDetails.TranSubType = "BI"
		MTT.TranDetails.IgnoreExcp = "I"
		MTT.TranDetails.Consolidate = "N"
		MTT.TranDetails.ReversalFlag ="N"
		MTT.TranDetails.ValidationFlag = "Y"
		MTT.TranDetails.PostFlag = "Y"
		MTT.TranDetails.CommitFlg = "Y"
		MTT.TranDetails.CheckExceptions = "Y"
		#MTT.TranDetails.Remarks = "Fccy to Hccy Charge Off settlement"
		MTT.TranDetails.Remarks = "FCY to LCY conversion"
		MTT.TranDetails.PostTranFlg = "Y"
		MTT.TranDetails.flgPostTransaction = "Y"
		CUST.CHRGOF.Tranrmks = MTT.TranDetails.Remarks
		
		#------------------------------------------------------------------*
		# Defining the Transaction
		#------------------------------------------------------------------*
		
		sv_u = urhk_MTTS_DefineTransaction("TRAN")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.CHRGOF.ErrMsg = "Error Encountered in Defining the Transaction"
			PRINT(CUST.CHRGOF.ErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		
		MTT.PartTranDetails.TODRefType = ""
		
		MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.CHRGOF.tranAmt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Account = CUST.CHRGOF.Fccyacnt
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.ACPARTB2kId=CUST.CHRGOF.Hccyacnt
		MTT.PartTranDetails.ACPARTB2kType= "ACCNT"
		
		IF(CUST.CHRGOF.FCrncy == BANCS.STDIN.homeCrncyCode) THEN
		#{
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.Rate = ""
			#}
		ELSE
			#{
			MTT.PartTranDetails.RateCode = CUST.CHRGOF.rateCode
			MTT.PartTranDetails.Rate = "0.00"
		#}
		ENDIF
		#MTT.PartTranDetails.CarveAmtFlg = "Y"
		MTT.PartTranDetails.TranIdentifier = "TRAN"
		#MTT.PartTranDetails.Particulars = "Debiting the Foreign Currency Account" + ":" + CUST.CHRGOF.Fccyacnt
		MTT.PartTranDetails.Particulars = "FCY to LCY conversion"
		
		sv_u = urhk_MTTS_DefinePartTran("PARTTRAN1")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.CHRGOF.ErrMsg = "Error Encountered in Defining the Debit part Transaction"
			PRINT(CUST.CHRGOF.ErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		
		#------------------------------------------------------------*
		# Crediting the central Account
		#------------------------------------------------------------*
		
		MTT.PartTranDetails.TODRefType = ""
		
		MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.CHRGOF.tranAmt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Account = CUST.CHRGOF.Hccyacnt
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Rate = ""
		#MTT.PartTranDetails.CarveAmtFlg = "Y"
		MTT.PartTranDetails.TranIdentifier = "TRAN"
		#MTT.PartTranDetails.Particulars = "Crediting the Home Currency Account" + ":" + CUST.CHRGOF.Hccyacnt
		MTT.PartTranDetails.Particulars = "FCY to LCY conversion"
		MTT.PartTranDetails.ACPARTB2kId= CUST.CHRGOF.Fccyacnt
		MTT.PartTranDetails.ACPARTB2kType= "ACCNT"
		
		sv_u = urhk_MTTS_DefinePartTran("PARTTRAN1")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.CHRGOF.ErrMsg = "Error Encountered in Defining the Credit part Transaction"
			PRINT(CUST.CHRGOF.ErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		sv_r = urhk_putExceptionsIntoRepository("")
		PRINT(sv_r)
		
		sv_s = urhk_b2k_printRepos("EXCP")
		#---------------------------------------------------------*
		# Committing the Transaction
		#---------------------------------------------------------*
		sv_u = urhk_MTTS_EndDefinition("")
		PRINT(sv_u)
		IF(sv_u !=0) THEN
		#{
			sv_a = "Transaction Commit Failed"
			PRINT(sv_a)
			sv_r = urhk_MTTS_ReportErrorCondition("")
			PRINT(sv_r)
			PRINT(MTT.Error.Description)
			CUST.CHRGOF.ErrMsg = MTT.Error.Description
			sv_r = urhk_MTTS_HandleExceptions("POST")
			PRINT(sv_r)
			sv_r=urhk_B2k_PrintRepos("MTT")
			PRINT(sv_r)
			#sv_r = urhk_dbSQL("rollback")
			#PRINT(sv_r)
			#BANCS.INPARAM.BINDVARS=""
			#sv_d = urhk_dbSelectWithBind("rollback")
			#PRINT(sv_d)
			
			#CUST.CHRGOF.ErrMsg = "transcation failed for box " + CUST.CHRGOF.boxName
			CUST.CHRGOF.pstdFlg = "N"
			#}
		ELSE
			#{
			PRINT(BANCS.OUTPARAM.MTTTranId)
			CUST.CHRGOF.tranId = BANCS.OUTPARAM.MTTTranId
			PRINT(CUST.CHRGOF.tranId)
			#			CUST.CHRGOF.errmsg = MTT.Error.Description
			#			PRINT(CUST.CHRGOF.errmsg)
			IF(CUST.CHRGOF.tranId != "") THEN
			#{
				sv_a = "Transaction is successful"
				PRINT(sv_a)
				#BANCS.INPARAM.BINDVARS=""
				#sv_d = urhk_dbSelectWithBind("commit")
				#PRINT(sv_d)
				CUST.CHRGOF.pstdFlg = "Y"
				#}
			ELSE
				#{
				#sv_d = urhk_dbSQL("rollback")
				#PRINT(sv_d)
				#BANCS.INPARAM.BINDVARS=""
				#sv_d = urhk_dbSelectWithBind("rollback")
				#PRINT(sv_d)
				sv_r=urhk_B2k_PrintRepos("MTT")
				PRINT(sv_r)
				CUST.CHRGOF.ErrMsg = "Transcation failed for bacid " + CUST.CHRGOF.Fccybacid
				CUST.CHRGOF.pstdFlg = "N"
				
			#}
			ENDIF
			
			
		#}
		ENDIF
			
                #sv_z = urhk_MTTS_Close("")
                #PRINT(sv_z)

		IF(TRIM(CUST.CHRGOF.tranId) != "")THEN
		#{	
		
			CUST.CHRGOF.Msg = "Amount is settled for bacid "+ CUST.CHRGOF.Fccybacid+" From Currency "+CUST.CHRGOF.FCrncy+" tran Id:"+CUST.CHRGOF.tranId
			PRINT(CUST.CHRGOF.Msg)
			sv_b = urtn_fileWrite(CUST.CHRGOF.successFileIndex1 + "|" + CUST.CHRGOF.Msg)
				
			sv_s = "insert into custom.FPLTRAN (TRAN_ID,TRAN_DATE,CR_ACCT_ID,DR_ACCT_ID,FCCY,HCCY,TRAN_AMT,DR_ACCT_SOLID,TRAN_PARTICULAR,POSTED_FLG,"
			sv_s = sv_s + "POSTED_USER_ID,BANK_ID)"
			sv_s = sv_s + " values(?SVAR,sysdate,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
			BANCS.INPARAM.BINDVARS = CUST.CHRGOF.tranId + "|" + CUST.CHRGOF.Hccyacnt + "|" + CUST.CHRGOF.Fccyacnt + "|" + CUST.CHRGOF.FCrncy 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.homeCrncyCode + "|" + CUST.CHRGOF.tranAmt + "|" + BANCS.STDIN.mySolId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CHRGOF.Tranrmks + "|" + CUST.CHRGOF.pstdFlg
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		#}
		ENDIF
		
		PRINT(sv_s)
		
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_u = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_u)
		sv_u = urhk_dbSQLWithBind("COMMIT")
		BANCS.STDIN.InsrtFlag = "Y"
		#sv_r = urhk_MTTS_Close("")
		CUST.CHRGOF.ErrMsg = ""
		
		NXTBACID:
		sv_f = urhk_dbCursorFetch(sv_n)
		PRINT(sv_f)
	#}
	DO
	
        sv_c = urhk_dbCursorClose(sv_n)
        PRINT(sv_c)

	ENDOFSCRIPT:
        sv_z = urhk_MTTS_Close("")
        PRINT(sv_z)
	
     	sv_c = urtn_fileClose(CUST.CHRGOF.failFileIndex1)
     	PRINT(sv_c)
     	sv_c = urtn_fileClose(CUST.CHRGOF.successFileIndex1)
     	PRINT(sv_c)

     	CUST.CHRGOF.ERR000002 = "Failed "
     	PRINT(CUST.CHRGOF.list_file_name)
     	sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.CHRGOF.mrt_file_name + " " + CUST.CHRGOF.list_file_name + " " + CUST.CHRGOF.rpt
     	PRINT(sv_r)
     	sv_r = SYSTEM(sv_r)
     	IF (sv_r != 0) THEN
     	#{
             	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
             	sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.CHRGOF.ERR000002 + "")
             	GOTO FINISH
     	#}
     	ENDIF
     	sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.CHRGOF.rpt_file_name+" '" + CUST.CHRGOF.title+"' MANAGER 1 N"
     	PRINT(sv_q)
     	sv_r = SYSTEM(sv_q)

     ##############

     	PRINT(CUST.CHRGOF.list_file_nameSuccess )
     	sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.CHRGOF.mrt_file_name1 + " " + CUST.CHRGOF.list_file_nameSuccess  + " " + CUST.CHRGOF.rptSuccess
     	PRINT(sv_r)
     	sv_r = SYSTEM(sv_r)
     	IF (sv_r != 0) THEN
     	#{
             	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
             	sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.CHRGOF.ERR000002 + "")
             	GOTO FINISH
     	#}
     	ENDIF
     	sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.CHRGOF.rpt_file_nameSuccess+" '" + CUST.CHRGOF.titleSuccess+"' MANAGER 1 N"
     	PRINT(sv_q)
     	sv_r = SYSTEM(sv_q)
    	IF (sv_r != 0) THEN
    	#{
            	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
            	sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.CHRGOF.ERR000002 + "^DATE")
            	GOTO FINISH
    	#}
    	ENDIF

	FINISH:
TRACE OFF
		
