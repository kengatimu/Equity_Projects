		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","HOTCE") == 0) THEN
	#{
		CREATECLASS("CUST","HOTCE",5)
	#}
	ENDIF
	
	
	CUST.HOTCE.errMsg    = ""
		
		
	IF (BANCS.STDIN.contextBankId =="43") THEN	
		sv_u = urhk_SRV_GetVal("ecsTranGenDet.remitAmt")
			IF (sv_u == 0) THEN
			#{
				CUST.HOTCE.remitAmt = TRIM(BANCS.OUTPARAM.srvValue)
				PRINT(CUST.HOTCE.remitAmt)
				CUST.HOTCE.LENGTH = STRLEN(CUST.HOTCE.remitAmt)
				PRINT (CUST.HOTCE.LENGTH )
				CUST.HOTCE.remitAmt= MID$(CUST.HOTCE.remitAmt,0,(cint(CUST.HOTCE.LENGTH)-4))
				PRINT(CUST.HOTCE.remitAmt)
				#}
			ELSE
				#{
				CUST.HOTCE.errMsg = "Error in finding remitAmt"
				PRINT(CUST.HOTCE.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		
		sv_u = urhk_SRV_GetVal("ecsTranGenDet.remitCrncy")
		IF (sv_u == 0) THEN
		#{
			CUST.HOTCE.remitCrncy = TRIM(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.HOTCE.remitCrncy)
			#}
		ELSE
			#{
			CUST.HOTCE.errMsg = "Error in finding remitCrncy"
			PRINT(CUST.HOTCE.errMsg)
			GOTO ENDOFSCRIPT
		#}
		ENDIF


		BANCS.INPUT.parameterId = "REMIT_LIMT_USD"
		BANCS.INPUT.moduleName = "OT"
		CALL ("getcparamvalue.scr")
		IF(BANCS.OUTPUT.parameterVal != "")THEN
			CUST.HOTCE.limitAmt = BANCS.OUTPUT.parameterVal
		ELSE
			CUST.HOTCE.errMsg = "Limit setup has not done for parameter ID:"+BANCS.INPUT.parameterId
			GOTO ENDOFSCRIPT
		ENDIF

		BANCS.INPUT.moduleName = "OT"
                BANCS.INPUT.parameterId = "REMIT_LIMT_EUR_RATE"
                CALL ("getcparamvalue.scr")
                IF(BANCS.OUTPUT.parameterVal != "")THEN
                        CUST.HOTCE.schmparmVal = BANCS.OUTPUT.parameterVal
                ELSE
                        CUST.HOTCE.errMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                        GOTO ENDOFSCRIPT
                ENDIF

			BANCS.INPARAM.InputAmount  = CUST.HOTCE.remitAmt
			BANCS.INPARAM.FromCurrency = CUST.HOTCE.remitCrncy
			BANCS.INPARAM.ToCurrency   = "USD"
			BANCS.INPARAM.RateCode     = CUST.HOTCE.schmparmVal
			BANCS.INPARAM.Rate         = CDOUBLE("0.0")
			sv_u = urhk_B2k_ConvertAmount("")
			CUST.HOTCE.remitAmt = BANCS.OUTPARAM.OutputAmount
			PRINT(CUST.HOTCE.remitAmt)

			IF(    CDOUBLE(CUST.HOTCE.remitAmt) > CDOUBLE(CUST.HOTCE.limitAmt))THEN
				CUST.HOTCE.errMsg = "Amount above 25000 USD limit"
				GOTO ENDOFSCRIPT	
			ENDIF
		
		sv_u = urhk_SRV_GetVal("ecsTranGenDet.tranRmks")
		IF (sv_u == 0) THEN
			CUST.HOTCE.tranRmks = TRIM(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.HOTCE.tranRmks)
				
				sv_s = "SpecChar|SELECT REGEXP_INSTR(?SVAR,'[^[:alnum:] ]') FROM dual "
				BANCS.INPARAM.BINDVARS =  CUST.HOTCE.tranRmks
				sv_u = urhk_dbSelectWithBind(sv_s)
				IF (sv_d == 0) THEN	
					CUST.HOTCE.SpecChar=BANCS.OUTPARAM.SpecChar
					PRINT(CUST.HOTCE.SpecChar)					
					IF (CUST.HOTCE.SpecChar > 0) THEN
				
						CUST.HOTCE.errMsg = "Tran remarks should not have special characters" 
						PRINT(CUST.HOTCE.errMsg)
						GOTO ENDOFSCRIPT			
					ENDIF
				ENDIF	
		ELSE
			#{
			CUST.HOTCE.errMsg = "Error in finding tran remarks"
			PRINT(CUST.HOTCE.errMsg)
			GOTO ENDOFSCRIPT
		#}
		ENDIF

	ENDIF




	
	sv_u = urhk_SRV_GetVal("ecsTranGenDet.custAcct.foracid")
	IF (sv_u == 0) THEN
	#{
		CUST.HOTCE.acctId = TRIM(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.HOTCE.acctId)
		#}
	ELSE
		#{
		CUST.HOTCE.errMsg = "Error in finding account id"
		PRINT(CUST.HOTCE.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	## Bank 43 - Restrict CA243 
	IF(BANCS.STDIN.contextBankId== "43")THEN

		sv_s = "schmCode|SELECT schm_code FROM tbaadm.gam "
		sv_s = sv_s + "WHERE bank_id = ?SVAR "
		sv_s = sv_s + "AND FORACID = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.HOTCE.acctId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d == 0)THEN
			CUST.HOTCE.schmCode=BANCS.OUTPARAM.schmCode
			PRINT(CUST.HOTCE.schmCode)
			IF ((CUST.HOTCE.schmCode == "CA243") ) THEN
			#{
				CUST.HOTCE.errMsg = "Transfers Not Allowed under this Scheme Code CA243!"
				PRINT(CUST.HOTCE.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF


		ENDIF

	ENDIF

	sv_u = urhk_SRV_GetVal("ecsTranGenDet.chrgEventId.eventId")
	IF (sv_u == 0) THEN
	#{
		CUST.HOTCE.eventId = TRIM(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.HOTCE.eventId)
		#}
	ELSE
		#{
		CUST.HOTCE.errMsg = "Error in finding event id"
		PRINT(CUST.HOTCE.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("ecsTranGenDet.freeText5")
	IF (sv_u == 0) THEN
	#{
		CUST.HOTCE.freetext5 = TRIM(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.HOTCE.freetext5)
		#}
	ELSE
		#{
		CUST.HOTCE.errMsg = "Error in finding freetext5"
		PRINT(CUST.HOTCE.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.HOTCE.freetext5 == "") THEN
	#{
		CUST.HOTCE.errMsg = "Enter account id in freetext5"
		PRINT(CUST.HOTCE.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.HOTCE.acctId != CUST.HOTCE.freetext5) THEN
	#{
		CUST.HOTCE.errMsg = "Account Id AND freetext5 value must be same"
		PRINT(CUST.HOTCE.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF (FIELDEXISTS(BANCS.STDIN.moduleIdentity)) THEN
	#{
		IF (BANCS.STDIN.moduleIdentity=="BJMS") THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	IF((BANCS.STDIN.contextBankId== "50")  AND (BANCS.STDIN.menuId == "HOTCE"))THEN
	#{
		sv_s = "schmCode|SELECT schm_code FROM tbaadm.gam "
		sv_s = sv_s + "WHERE bank_id = ?SVAR "
		sv_s = sv_s + "AND FORACID = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.HOTCE.acctId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.HOTCE.schmCode=BANCS.OUTPARAM.schmCode
			PRINT(CUST.HOTCE.schmCode)
			
			IF ((CUST.HOTCE.schmCode == "CA202") AND (CUST.HOTCE.eventId != "")) THEN
			#{
				CUST.HOTCE.errMsg = "No charges for accounts under scheme CA202. Kindly Remove eventID " + CUST.HOTCE.eventId
				PRINT(CUST.HOTCE.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.HOTCE.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr("ecsTranGenDet.freeText5|"+CUST.HOTCE.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		EXITSCRIPT
END-->
