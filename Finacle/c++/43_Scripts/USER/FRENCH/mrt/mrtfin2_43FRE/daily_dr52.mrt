#*********************************************************************
#       Author          :      Mabel Gichengo
#
#**********************************************************************
#  DESC   :  Outward Credit Register (Foreign Currency)
######################################################################
RECORDLAYOUT
####################################################################
#
####################################################################
#
tran_id        	    stringtype
foracid             stringtype 
acct_name           stringtype 
instrmnt_desc       stringtype 
value_date          stringtype 
acct_crncy_code     stringtype 
bill_amt            numbertype 
bill_amt_inr        numbertype 
rate                numbertype
gam.sol_id          stringtype 
party_name          stringtype

LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
SUB_total_amt    numbertype
SUB_total_famt   numbertype
grand_total_amt  numbertype
grand_total_famt numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType

GROUPANDSORT
####################################################################
#
#################################################################### 
acct_crncy_code ascending

REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
branchName      stringtype
#############################################################################
REPOSITORY  argv4
#############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
#
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperpage     70
pageheaderlines      5 
pagefooterlines       2 
topmargin       1
bottommargin   1
leftmargin       2 
rightmargin     2 
columnsperline 170 
#
ONSTARTOFREPORT
####################################################################  

execute brBankHdg 
execute pageHdg
#
PAGEHEADER
####################################################################
#
execute brBankHdg 
execute pageHdg

####################################################################
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################
NEXTLINE
print tran_id  column 3 
print foracid column 13
print acct_name column 29 
print instrmnt_desc column 48 
print value_date column 60 
print acct_crncy_code column 72 
print bill_amt column 85        format "###,###,###.##" 
PRINT bill_amt_inr COLUMN 105    
PRINT rate  COLUMN 122                
PRINT gam.sol_id COLUMN 135    
PRINT party_name  COLUMN 145      
#BEFOREBREAKOF SECU_CODE 
#
AFTERBREAKOF acct_crncy_code
separatorline
set sub_total_FAMT = groupsum bill_amt
set sub_TOTAL_AMT = groupSUM bill_amt_inr
print "SUB TOTAL:" column 72
print sub_total_FAMT       format "###,###,###.##" 
print sub_TOTAL_AMT        format "###,###,###.##" 
separatorline
####################################################################
# After break 
####################################################################
#
ONENDOFREPORT
#############################################################################
#
#############################################################################

begin
 
     separatorline
     set GRAND_total_FAMT = totalsum bill_amt
     set GRAND_TOTAL_AMT = totalsum bill_amt_inr
     print "GRAND TOTAL:" column 72
     print GRAND_total_FAMT       format "###,###,###.##" 
     print GRAND_TOTAL_AMT        format "###,###,###.##" 
     separatorline
     nextline
     nextline
end

begin
     print "printed by:"  size  85 center
     print  lv_userId
     nextline
     nextline
     nextline
     print "verified by:" size  85 center
     print "........................" column  87 
     nextline
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 170 center
     separatorline
end
#
#
#############################################################################
Procedure  pageHdg
#############################################################################

begin
     nextline
     print "OUTWARD CREDIT REGISTER (FOREIGN CURRENCY)  "  size  170 center 
     nextline
     nextline
     print " From  " column  65 
     print ipFrmDate  
     print "  TO  "
     print ipToDate   
     nextline
end

begin
   separatorline
    print "TRAN ID"  column 3
    print "ACC NO." column 13
    print "NAME" column 29
    print "INST DESC" column 48
    print "VALUE DATE" column 60
    print "CRNCY ID" column 72
    print "FRGN AMT" column 87
    PRINT "AMT" COLUMN 107
    PRINT "EXCH RATE"  COLUMN 122
    PRINT "BRANCH" COLUMN 135
    PRINT "DRAWER"  COLUMN 145
    separatorline
end
#
#
########################################################################
PROCEDURE brBankHdg
##############################################################################

begin
     print "Page No. "   column  130 
     print page_number precision 0
     nextline
     print today column  130
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 170 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 170 center 
end

####################################################################
# End of File
######################################################################
