PROCEDURE taxDetails
#==============================================================================
if(taxHeaderPrinted = "N")
begin
    execute taxDetailHeader
	set taxHeaderPrinted = "Y"
end
if(idtIddtInd = 3) execute wtaxDetails
if(idtIddtInd = 3 AND prePostInd = 1)
set netPreTaxAmt = netPreTaxAmt	+ tax_amount
if(idtIddtInd = 3 AND prePostInd = 2)
set netPostTaxAmt= netPostTaxAmt + tax_amount
nextline

