#==============================================================================
ONSTARTOFREPORT
#==============================================================================
set localyears = strToNum localYearsToAdd
set pageNumber = 1
set recCount = 0
set totInt = 0
set totIntNor  = 0
set totIntPenal = 0
set totIntAdd  	= 0
set totIntOverDue = 0
set totIntStock = 0
set totIntQIS  	= 0
set totIntForAcct = 0
set intAdjAmt = 0
set intRndAmt = 0
set taxAmt 	  = 0
set recalcAmt = 0
set netPreAmt = 0
set netPreAmtForAcct = 0
set netPostAmt = 0
set netPostAmtForAcct = 0
set intRecalcHeaderPrinted = "N"
set RecalcReasonPrinted = "N"
set limitHeaderPrinted = "N"
set dpHeaderPrinted = "N"
set todHeaderPrinted = "N"
set genHeaderPrinted = "N"
set detHeaderPrinted = "N"
set minMaxHeaderPrinted = "N"
set tranFlg = "N"
set locAlrdyProcessAmt = 0
set locTotProcessAmt = 0
set locRunProcessAmt = 0
set locProcessUptoAmtFlg = "N"
set taxHeaderPrinted = "N"
set netPreTaxAmt = 0
set netPreTaxAmtForAcct = 0
set netPostTaxAmt = 0
set netPostTaxAmtForAcct = 0
execute commonPageHdr
nextline
execute printCriteria
nextPage
#=========================================================================
PAGEHEADER
#=========================================================================
execute commonPageHdr
nextline
nextline
#==============================================================================
AFTERBREAKOF interestInd
#==============================================================================
if(recCount !=0)
begin
if(ProcessFlg = "LMBOOKING")
	set	ProcessFlg = "BOOKING"
if(diffAmtForAcct !=0)
execute printRecalcSummaryDetails
if (diffTaxAmtForAcct !=0 AND SDTRecordInd = 9)
execute printWtaxRecalcSummaryDetails
execute printSummaryDetails
if(Process = "BOOKING" OR Process = "INTRUN" AND ProcessFlg != "INTPRF")
begin
	execute printProcessDetails
end
end
set totInt = 0
set totIntNor  = 0
set totIntPenal = 0
set totIntAdd  	= 0
set totIntOverDue = 0
set totIntStock = 0
set totIntQIS  	= 0
set totIntForAcct = 0
set intAdjAmt = 0
set intRndAmt = 0
set recalcAmt = 0
set netPreAmt = 0
set netPreAmtForAcct = 0
set netPostAmt = 0
set netPostAmtForAcct = 0
set intRecalcHeaderPrinted = "N"
set RecalcReasonPrinted = "N"
set limitHeaderPrinted = "N"
set dpHeaderPrinted = "N"
set todHeaderPrinted = "N"
set genHeaderPrinted = "N"
set detHeaderPrinted = "N"
set minMaxHeaderPrinted = "N"
set tranFlg = "N"
set locProcessUptoAmtFlg = "N"
set taxHeaderPrinted = "N"
set netPreTaxAmt = 0
set netPreTaxAmtForAcct = 0
set netPostTaxAmt = 0
set netPostTaxAmtForAcct = 0
############################################
AFTERBREAKOF prePostInd	 
############################################
begin
if(SDTRecordInd = 6) 
begin
# if(prePostInd = 0) 
# begin
	nextline 
	print "Total interest" column 80
	print totInt  rightjustify autocomma size 20 column 96
	separatorLine
	
	if(detrecordInd = 1)
   	set totIntNor = totInt

	if(detrecordInd = 2)
   	set totIntPenal = totInt

	if(detrecordInd = 3)
   	set totIntAdd = totInt
	
	if(detrecordInd = 4)
   	set totIntQis = totInt

	if(detrecordInd = 5)
   	set totIntStock = totInt

	if(detrecordInd = 6)
   	set totIntOverDue = totInt

# end
if (prePostInd = 2)
	begin
		nextline
		print "Difference in Interest" column 10
		set diffAmt =  netPostAmt-netPreAmt	
		print diffAmt column 40
		set netPreAmtForAcct=netPreAmtForAcct+netPreAmt
		set netPostAmtForAcct=netPostAmtForAcct+netPostAmt
	set netPreAmt =0
	set netPostAmt =0
	set totInt = 0
	end
	set totInt = 0
	set detHeaderPrinted = "N" 
end
set diffAmtForAcct =netPostAmtForAcct-netPreAmtForAcct
end
if (SDTRecordInd = 9)
begin
if(prePostInd=2)
begin
nextline
print "Difference in WithHolding Tax" column 10
set diffTaxAmt =  netPostTaxAmt-netPreTaxAmt
print diffTaxAmt column 40
set netPreTaxAmtForAcct	=	netPreTaxAmtForAcct	 +	netPreTaxAmt
set netPostTaxAmtForAcct=	netPostTaxAmtForAcct +	netPostTaxAmt
set netPreTaxAmt =0
set netPostTaxAmt =0
set diffTaxAmtForAcct = netPostTaxAmtForAcct-netPreTaxAmtForAcct
end
set taxHeaderPrinted = "N" 
end
############################################ 
AFTERBREAKOF idtIddtInd 
############################################ 
set locFullEffProduct = locFullProduct - locFullDetProduct 
set locFullEffInt     = locFullInt - locFullDetInt 
if(locFullEffProduct != locFullProduct AND lastRecord="Y" AND idtIddtInd=2 AND locFullEffProduct != 0 AND entityType="ACCNT") 
begin 
print locFullEffProduct  rightjustify autocomma size 20 column 54 
print entityType  column 76 
print locFullRate  column 90 precision 4 
print locFullEffInt   rightjustify autocomma size 20 column  100 
nextline 
end 

#==============================================================================
PROCEDURE printHeaderDetails 
#==============================================================================
set locTotProcessAmt = 0
set locRunProcessAmt = 0
separatorLine
print "Account ID                   :" column 5
print entityId column 40
print acctCrncyCode column 60
print SolId column 70
print acctName column 80
nextline
print "CIF ID                       :" column 5
print cifId column 40
nextline
print "Schm Code                    :" column 5
print schmCodeRegSubType  column 40
nextline
print "Interest Indicator           :" column 5
if (interestInd = "C")
print "Credit"  column 40
if (interestInd = "D")
print "Debit"  column 40
nextline
print "Start Date                   :" column 5
set localdate = stringToDate processStartDate 
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 40
print "End Date    :" column 60
set localdate = stringToDate  processEndDate
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 80
nextline
nextline
separatorLine
nextline
nextline
nextline
print "INTEREST CALCULATION PARAMETERS" column 20
nextline
	if (interestInd = "C")
	begin
	print "Interest Method                   :" column 5
	if(intMethod = "M")
	print "Minimum balance Method" column 40
	else if(intMethod = "A")
	print "Average balance Method" column 40
	else if(intMethod = "I") 
	print "Average for Interest Period Method" column 40 
	else
	print "EOD Balance Method" column 40
	nextline
	end
	if (interestInd = "D")
	begin
		print "Min Interest Collected Amount     :" column 5
		print minIntCollAmt  column 40
	end
	if (interestInd = "C")
	begin
		print "Min Interest Payable Amount       :" column 5
		print minIntPayAmt  column 40
	end
	nextline
	print "Days in a Year                    :" column 5
	if (interestInd = "D")
	print  days_in_year_for_int_dr column 40
	if (interestInd = "C")
	print  days_in_year_for_int_cr column 40
	nextline
	if(drIntRoundOffStatus  ="H")
	set drIntRoundOffStatus ="HIGHEST"
	else if(drIntRoundOffStatus ="L")
	set drIntRoundOffStatus ="LOWEST"
	else if(drIntRoundOffStatus ="N")
	set drIntRoundOffStatus ="NEAREST"
	else
	set drIntRoundOffStatus ="NONE"
	if (crIntRoundOffStatus ="H")
	set crIntRoundOffStatus ="HIGHEST"
	else if (crIntRoundOffStatus ="L")
	set crIntRoundOffStatus ="LOWEST"
	else if(crIntRoundOffStatus ="N")
	set crIntRoundOffStatus ="NEAREST"
	else
	set crIntRoundOffStatus ="NONE"

	print "Interest Round Off                :" column 5
	if (interestInd = "D")
	begin
		print drIntRoundOffStatus  column 40
		print drIntRoundOffAmt  column 55 
	end
	if (interestInd = "C")
	begin
		print crIntRoundOffStatus column 40
		print crIntRoundOffAmt  column 55
	end
	nextline
	print "WithHolding Considrd For Cr Compd :" column 5 
	if (wtax_for_cr_comp = "Y")
		set wtax_for_cr_comp ="Yes"  
	else
		set wtax_for_cr_comp ="No"
	print wtax_for_cr_comp column 40
	nextline
	print "Credit Compounding Frequency      :" column 5
	if( int_compounding_frq_cr= "D")
	begin
    	print "Daily" column 40	
	end
	else if(int_compounding_frq_cr = "M" )
	begin
    	print "Monthly" column 40
	end
	else if(int_compounding_frq_cr = "Q" )
	begin
    	print "Quarterly" column 40
	end
	else if(int_compounding_frq_cr = "H" )
	begin 
		print "Half Yearly " column 40
	end
	else if(int_compounding_frq_cr = "Y")
	begin
		print "Yearly " column 40
	end
	else if(int_compounding_frq_cr =" ")
	begin
    	print "None" column 40
end
	nextline
	print "Debit Compounding Frequency       :" column 5
	if( daily_comp_flg= "D")
	begin
    	print "Daily" column 40	
	end
	else if(daily_comp_flg = "M" )
	begin
    	print "Monthly" column 40
	end
	else if(daily_comp_flg = "Q" )
	begin
    	print "Quarterly" column 40
	end
	else if (daily_comp_flg = " " ) 
	begin
    	print "None" column 40
	end
	separatorLine
nextline
set locPrintIntDetail	=printIntDetail
#==============================================================================
#==============================================================================
PROCEDURE DetailHeader 
#==============================================================================
if(intRecalcHeaderPrinted="N" AND (prePostInd = 1))
begin
    print " RECALCULATION DETAILS" column 35
	nextline
	print "Recalc Reason:" column 5
	print locRecalcReason  column 20
    nextline
	print "Recalc Remark:" column 5
	print locRecalcRemark  column 20
    nextline
	nextline
	set intRecalcHeaderPrinted = "Y"
end
nextline
nextline
if(prePostInd =0)
begin
print interestTypeDesc column 20
print "INTEREST     CALCULATION      DETAILS" column 35
end
if(prePostInd = 1) 
begin
print interestTypeDesc column 20
print "INTEREST     RECALCULATION      DETAILS" column 35
nextline
nextline
print "INTEREST     PRE-RECALCULATION      DETAILS" column 20
end
if(prePostInd = 2) 
begin
print "INTEREST     POST-RECALCULATION      DETAILS" column 20
end
separatorLine
execute normalHeader
separatorLine
nextline 


#==============================================================================
ONEVERYRECORD 
#==============================================================================
set recCount = recCount +1
if(ProcessFlg = "LMBOOKING") 
begin 
    set     ProcessFlg = "BOOKING" 
end 
if(SDTRecordInd = 1 AND genHeaderPrinted = "N")
begin
	execute printHeaderDetails
	set genHeaderPrinted ="Y"
end
if(tranId !="" and tranFlg ="N")
begin
set locTranId = tranId
set locTrandate = tranDate
set tranFlg ="Y"
end
if(recalcReason !="" and RecalcReasonPrinted="N" )
begin
set locRecalcReason	=recalcReason
set locRecalcRemark	=recalcRemark
set RecalcReasonPrinted	="Y"
end
	if(interestType = "N")
	set interestTypeDesc ="NORMAL" 

	if(interestType = "P")
   	set interestTypeDesc ="PENAL" 

	if(interestType = "A")
   	set interestTypeDesc ="ADDITIONAL" 

	if(interestType = "Q")
   	set interestTypeDesc ="QIS" 

	if(interestType = "S")
   	set interestTypeDesc ="STOCK" 

	if(interestType = "O")
   	set interestTypeDesc ="OVERDUE" 
	
	if(interestLevel = "A")
	set interestLevel = "ACCNT"

	if(interestLevel = "L")
	set interestLevel = "LIMIT"

	if(interestLevel = "T")
	set interestLevel = "TOD"
	
	if(interestLevel = "D")
	set interestLevel = "DRAWDOWN"
    
	if(interestLevel = "P")
	set interestLevel = "INSTPENAL"

	if(interestLevel = "C")
	set interestLevel = "CLTRL"
	if	(SDTRecordInd = 2 )	execute minMaxDetails
	if 	(SDTRecordInd = 3 ) execute limitDetails
	if 	(SDTRecordInd = 4 ) execute dpDetails
 	if 	(SDTRecordInd = 5 ) execute todDetails
	if	(SDTRecordInd = 6 )	execute printDetails
	if	(SDTRecordInd = 9 ) execute taxDetails
	if	(SDTRecordInd = 7 )
	begin
   	set intAdjAmt = intAdjAmt + adjAmt
	
	if (Process = ProcessFlg OR (Process = "INTRUN" AND ProcessFlg = "INTPRF"))
	begin
		set locAlrdyProcessAmt =  processUptoAmt
        set locProcessUptoAmtFlg = "Y"
        set locRunProcessAmt =  locRunProcessAmt + processRunAmt
        set locTotProcessAmt = locTotProcessAmt + processRunAmt +
                                locAlrdyProcessAmt
        if(locProcessUptoAmtFlg = "Y")
        begin
            set locAlrdyProcessAmt = locTotProcessAmt -
                                    locRunProcessAmt
        end
	
	if(ProcessFlg != "INTPRF")
	begin
		if(interestType = "N")
		set totIntNor =  processRunAmt

		if(interestType = "P")
		set totIntPenal = processRunAmt

		if(interestType = "A")
		set totIntAdd = processRunAmt

		if(interestType = "Q")
		set totIntQIS = processRunAmt

		if(interestType = "S")
		set totIntStock = processRunAmt

		if(interestType = "O")
		set totIntOverDue = processRunAmt
	end
	end
	end
	
	if  (SDTRecordInd = 8 )
	begin
	set intAdjAmt = intAdjAmt + adjAmt
	end
	if	(SDTRecordInd = 10 )	execute summaryDetails
nextline
if(Process = "INTRUN")
begin
if(locTranId != "")
begin
set callscript = runscript "VATTranUpdateOD.scr" "entityId|locTranId" "|"
end
end
#==============================================================================
PROCEDURE printSummaryDetails
#==============================================================================
nextline
nextline
if (ProcessFlg != "INTPRF")
begin
if (Process = "INTRUN")
print "INTEREST  SUMMARY   DETAILS " column 20
else
print "ACCRUAL   SUMMARY   DETAILS " column 20
end
if (ProcessFlg = "INTPRF")
print "SUMMARY   DETAILS " column 20
separatorLine
nextline
print "TYPE OF INTEREST"   column 2
print "AMOUNT"   column 38
nextline
nextline
	print "Normal Interest" column 2
	print totIntNor rightjustify autocomma size 20 column 30
	nextline
	print "Penal Interest" column 2
   	 print totIntPenal rightjustify autocomma size 20 column 30
	nextline
	print "OverDue Interest" column 2
   	print totIntoverDue rightjustify autocomma size 20 column 30
	nextline
	print "Additional Interest" column 2
   	print totIntAdd rightjustify autocomma size 20 column 30
	nextline
	print "QIS Interest" column 2
   	print totIntQis rightjustify autocomma size 20 column 30
	nextline
	print "Stock Interest" column 2
   	 print totIntStock rightjustify autocomma size 20 column 30
nextline
	print "Interest on Recalculation" column 2
   	print  recalcAmt rightjustify autocomma size 20 column 30
	nextline
	print "Interest Adjustment" column 2
   	print  intAdjAmt rightjustify autocomma size 20 column 30
	nextline
	print "Interest Round Off Amount" column 2
   	print  intRndAmt rightjustify autocomma size 20 column 30
	nextline
    if(locale_code !="BE")
    begin
        if(interestInd="C")
        begin
            print "WithHolding Tax Amount" column 2
            print taxAmt rightjustify autocomma size 20 column 30
        end
    end
    else
    begin
        if(interestInd="C")
        begin
            nextline
            print "Total Tax Amount" column 2
            print taxAmt rightjustify autocomma size 20 column 30
        end
    end
nextline
nextline
print "TOTAL INT FOR ACCOUNT" 	column 2
if (ProcessFlg = "INTPRF")
set totIntForAcct = totIntNor + totIntPenal + totIntAdd + totIntQis +
totIntoverDue + intAdjAmt + intRndAmt + totIntStock + recalcAmt
else 
set totIntForAcct = totIntNor + totIntPenal + totIntAdd + totIntQis +
totIntoverDue + intAdjAmt + intRndAmt + totIntStock 
print totIntForAcct rightjustify autocomma size 20 column 30  
nextline
if (PostFlag = "Y" AND ProcessFlg != "BOOKING")
execute tranDetails

#==============================================================================
PROCEDURE  tranDetails
#==============================================================================
print "Interest" column 2 
if (interestInd = "C")
print "Credited is"  column 11
if (interestInd = "D")
print "Debited is"  column 11
print acctCrncyCode column 23
print tranAmt  column 27
print "by Tran ID" column 46
if (((zeroIntAllow = "Y") AND (tranAmt = 0)) OR (tranAmt > 0))
begin
print locTranId  column 58
set localdate = stringToDate  locTranDate
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 76
end
print "dated" column 70 


#==============================================================================
PROCEDURE  tranIdDate
#==============================================================================
print "Tran Id" column 2 
print locTranId  column 13
print "dated" column 25 
set localdate = stringToDate  locTranDate
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 31

#==============================================================================
PROCEDURE  printDetails
#==============================================================================
if(detHeaderPrinted = "N")
begin
	execute DetailHeader
	set detHeaderPrinted = "Y"
end
if(idtIddtInd =1) execute normalDetails
if(idtIddtInd =2) execute normalDetailsIDDT
if(idtIddtInd =1)
set totInt = totInt + detRecdIntAmt
if(prePostInd = 1 AND idtIddtInd =1)
set netPreAmt = netPreAmt+ detRecdIntAmt
if(prePostInd = 2  AND idtIddtInd =1) 
set netPostAmt= netPostAmt+ detRecdIntAmt

#==============================================================================
PROCEDURE commonPageHdr
#==============================================================================
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 1
print " "
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "HH24:NN:SS"
print bankName 	column 35 
print "Page:" column 65
print pageNumber column 71 precision 0
nextline
print branchName column 35 
nextLine
nextLine
if (ProcessFlg != "INTPRF")
print "INTEREST CALCULATION REPORT" column 25
if(ProcessFlg = "BOOKING") 
print "BOOKING SUCCESS REPORT" column 25 
if (ProcessFlg = "ACCRUAL") 
print "ACCRUAL SUCCESS REPORT" column 25 
if(ProcessFlg = "INTPRF")
print "INTEREST PROOFING REPORT" column 25
nextline
	
#==============================================================================
PROCEDURE limitDetails
#==============================================================================
if (limitHeaderPrinted = "N") 
begin 
	nextline
	nextline
	print "LIMIT DETAILS" column 20
	separatorLine
	print "Limit Eff Date"    		column 2
	print "Limit Expiry Date"    		column 20
	print "Limit Amount"    		column 50
	print "Limit Normal Rate"   column 65 
	print "Limit Penal Rate "   column 85
	print "Limit Level Int "   column 105
	separatorLine
	nextline
	set limitHeaderPrinted ="Y"
end
	set localdate = stringToDate  limitEffDate
	set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 2

	set localdate = stringToDate  limitExpDate
	set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 20
		
	print limitAmt   rightjustify autocomma size 20  column 42
	print limitNormalPcnt   column 65
	print limitPenalPcnt   column 85
	if (limitLevelIntFlg ="Y")
	set limitLevelIntFlg = "YES"
	else
	set limitLevelIntFlg = "NO"
	print limitLevelIntFlg   column 105
	nextline

#==============================================================================
PROCEDURE dpDetails
#==============================================================================
if (dpHeaderPrinted = "N") 
begin 
	nextline
	nextline
	print "DRAWING POWER DETAILS" column 20
	separatorLine
	print "Applicable Date"    		column 2
	print "Drawing Power"    		column 22
	print "Status"   column 45 
	separatorLine
	nextline
	set dpHeaderPrinted ="Y"
end
	set localdate = stringToDate applicableDate 
	set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 2

	print drawingPower   rightjustify autocomma size 20  column 15
	if (status = "A") set status="Active"
	if (status = "D") set status="Deleted"
	if (status = "S") set status="Superceded"
	if (status = "F") set status="Future"
	print status   column 45
	nextline
