# Template Name :		daily_dr49.mrt
# Description	:		Advances Classification Summary
# Author			E.G.KAROBIA, 27/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include monthly_dr49.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
total			numberType
tot_schm_code		numberType	
tot_total_arreas	numberType
tot_ost_bal		numberType
tot_principal		numberType
tot_interest		numberType
tot_penal_interest	numberType
tot_nof_accts		numberType
tot_total		numberType
grnd_schm_code          numberType
grnd_total_arreas       numberType
grnd_ost_bal            numberType
grnd_principal          numberType
grnd_interest           numberType
grnd_penal_interest     numberType
grnd_nof_accts          numberType
grnd_total		numberType


#
GROUPANDSORT
sol_id ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 160
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
set total = 0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF sol_id	
    print "SOL ID : " 
    print " "
    print sol_id	
    nextline
    nextline
#
AFTERBREAKOF sol_id	
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
	print schm_code   column 5
	print ost_bal   column 20	format "#,###,###,###.##"
	print total_arreas column 37	format "#,###,###,###.##"
	print arrearspct     column 62	
	print nof_accts    column 72
	print principal     column 77 format "#,###,###,###.##"
	print   interest   column 95 format "#,###,###,###.##"	
	print penal_interest  column 112 format "#,###,###,###.##"
	set total = principal + interest + penal_interest 
	print Total  column 131 format "#,###,###,###.##"
	print classification column 150
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "Scheme Code"   column 5
	print "O/s Balance"   column 25
	print "Total Arrears" column 42
	print "Arrears %"     column 58
	print "No of A/cs"    column 68
	print "Principal"     column 82 
	print "Normal Int"    column 98
	print "Penal Int"     column 121
	print "Total"         column 140
	print " Classification" column 146
	separatorline
end 

PROCEDURE printGrandTotals
##############################################################################
begin
        set grnd_schm_code = totalcount schm_code
        set grnd_total_arreas = totalsum total_arreas
        set grnd_ost_bal = totalsum ost_bal
        set grnd_principal = totalsum principal
        set grnd_interest = totalsum interest
        set grnd_penal_interest = totalsum penal_interest
        set grnd_nof_accts = totalsum nof_accts
        set grnd_total = grnd_principal + grnd_interest + grnd_penal_interest
	separatorline
        print "Grand Total" column 1
	print grnd_schm_code   column 13
	print grnd_ost_bal   column 20	format "#,###,###,###.##"
	print grnd_total_arreas column 37	format "#,###,###,###.##"
	print grnd_principal     column 77 format "#,###,###,###.##"
	print grnd_interest     column 95 format "#,###,###,###.##"	
	print grnd_penal_interest   column 112 format "#,###,###,###.##"
	print grnd_Total          column 131 format "#,###,###,###.##"
	separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	set tot_schm_code = groupcount schm_code
	set tot_total_arreas = groupsum total_arreas
	set tot_ost_bal = groupsum ost_bal
	set tot_principal = groupsum principal
	set tot_interest = groupsum interest
	set tot_penal_interest = groupsum penal_interest
	set tot_nof_accts = groupsum nof_accts
	set tot_total = tot_principal + tot_interest + penal_interest
	
 	separatorline
	print "Subtotal" column 1
	print tot_schm_code   column 11
	print tot_ost_bal   column 20	format "#,###,###,###.##"
	print tot_total_arreas column 37	format "#,###,###,###.##"
	print tot_principal   column 77 format "#,###,###,###.##"
	print tot_interest    column 95 format "#,###,###,###.##"	
	print tot_penal_interest  column 112 format "#,###,###,###.##"
	print tot_Total   column 131 format "#,###,###,###.##"
	nextline
        
	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "ADVANCES CLASSIFICATION-SUMMARY"  column 64
	nextline
	nextline
	print "AS AT :" column 64
	print "  "
	print date
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
