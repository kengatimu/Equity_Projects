#  DESC   :    InActive Profiles Report 
#             
######################################################################
RECORDLAYOUT
####################################################################
#   
####################################################################

ROLE_ID 		stringtype
SCHEME_CODE 		stringtype
ACCESS_TYPE 		stringtype
ROLE_DESC 		stringtype
LCHG_USER_ID 		stringtype
LCHG_TIME 		stringtype
RCRE_USER_ID 		stringtype
RCRE_TIME 		stringtype


LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
total_profs numberType
gr_total_profs numbertype

totalpages stringtype
total_pages stringtype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType

GROUPANDSORT
####################################################################
#   
#################################################################### 
ROLE_ID ascending
#
#
REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
branchName      stringtype
REPOSITORY  argv4
#############################################################################
from_roleid                      stringtype
to_roleid                        stringtype 
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#
#IGNORERECORD
#############################################################################
#
#
#############################################################################
#
#
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################

widowOrphanLines 3
LinesPerPage 64
Topmargin       2
BottomMargin 2
columnsPerLine 100
pageHeaderLines 8
pageFooterLines 2
#
ONSTARTOFREPORT
####################################################################  

set total_profs = 0
set gr_total_profs  = 0

set totalpages = 0
set total_pages = 0

execute brBankHdg 
execute pageHdg


#
PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg
#
#
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
print "Pg:" column 2
print pagenumber column 5
print "of" column 7
print "<<TOP>>" column 10
nextline
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################
Print SCHEME_CODE column 2
print ACCESS_TYPE column 12
Print ROLE_DESC column 22
Print LCHG_USER_ID column 45 
Print LCHG_TIME column 55
Print RCRE_USER_ID column 70
Print RCRE_TIME column 86

#
####################################################################

BEFOREBREAKOF ROLE_ID
####################################################################
#Before Break of Role_Id
####################################################################
print "ROLE_ID" column 2
print ROLE_ID column 12
nextline

AFTERBREAKOF ROLE_ID
####################################################################
# After break of ROLE_ID
####################################################################
set total_profs = groupcount SCHEME_CODE
print "Total Scheme Codes in Role" column 2
print total_profs column 32
separatorline
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
    separatorline
     set gr_total_profs = totalcount role_id
     print "Total No. Of Inactive Profiles: " column 2 
     print gr_total_profs column 35
     separatorline
end

begin
     
set total_pages = numtostr pagenumber
set totalpages = prntagval "TOP" total_pages
end

begin
     print "printed by:" column 40 
     print  lv_userId
     nextline
     nextline
     print "verified by:" column 40 
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 100 center
    end 

#
#
#############################################################################
Procedure  pageHdg
#############################################################################

begin
     print " INACTIVE PROFILES REPORT  "  size 100 center 
     nextline
     print " FROM  " column 35 
     print from_roleid 
     print "  TO  "
     print to_roleid     
     nextline
   end
begin
	separatorline
     print "SCHM CDE" column 2
     print "ACSTYP" column 12
     print "ROLE DESC" column 22
     print "CHANGED ON" column 45
     print "CHANGED BY" column 55
     print "CREATED ON" column 70
     print "CREATED BY" column 86
     separatorline
end
########################################################################
PROCEDURE brBankHdg
##############################################################################

begin
     print "Page No. "   column  85 
     print page_number precision 0
     nextline
     print today column 85 
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 100 center 
     set lv_setid = ipsetId
#set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 100 center 
     nextline
        
end

####################################################################
# End of File
######################################################################
