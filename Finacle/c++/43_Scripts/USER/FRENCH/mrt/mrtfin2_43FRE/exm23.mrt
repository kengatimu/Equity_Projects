#	Author		:       P.Senthil kumar		
#	Date		:	28-12-2005
#
#***************************************************************************************

#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
gl_code			stringType
acct_name		stringType
crncy_code		stringType
balance			numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
callscript      stringType
lv_setid        stringType  
lv_setdesc      stringType
total		 numbertype
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId 		stringtype
asondate	stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
set total = 0
execute header
execute pageHdg 
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   100 
columnsperline 163 
topMargin      2 
bottomMargin   2 
leftMargin     0 
pageheaderlines 4 
pagefooterlines 4
#---------------------------------------------------------------------------------------
#***************************************************************************************
PAGEHEADER
#***************************************************************************************
execute pageHdg 
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
execute pipe
print acct_name column 2 size 30
print balance column 51 size 20 autocomma precision 2
set total = total + balance
#**************************************************************************************
ONENDOFREPORT
#**************************************************************************************
begin
separatorline
execute pipe
print "Total :" column 5
print total column 51 size 20 autocomma precision 2 
separatorline
nextline
nextline
nextline
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:_______________________________________" column 20 
nextline
end 
#***************************************************************************************
PROCEDURE pipe
begin
        print "|"               column 1
        print "|"               column 34 
        print "|"               column 49 
        print "|"               column 72
        print "|"               column 89
	print "|"		column 111
	print "|" 		column 128
	print "|"		column 150
	print "|"		column 162
end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
print "EXM/23" column 125 
nextline
nextline
print "INSTITUTION:  EQUITY BANK LIMITED " column 5 
print "DATE:" column 125  
print asondate column 130 size 10
nextline
nextline
print " BRANCH    :"  column 5 
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc size 20
nextline
nextline
print "TERM BORROWINGS BY THE BANK" size 100 center
nextline
print "___________________________" size 100 center
nextline
nextline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
separatorline
print "|" column 1
print "NAME OF INSTITUTION" column 2 size 30
print "|" column 34 
print "DATE OF" column 35  center size 12 
print "|" column 49 
print "PRINCIPAL" column 50 size 20 center
print "|" column 72 
print "ACCRUED" column  73 center size 15
print "|" column 89
print "TOTAL" column 90 size 20 center
print "|" column 111
print "TYPE OF" column 112 size 15 center
print "|" column 128 
print "VALUE OF SECURITY" column 129 size 20 center
print "|" column 150
print "REMARKS" column 151 size 10
print "|" column 162 
nextline
print "|" column 1
print "|" column 34
print "BORROWING" column 35  center size 12
print "|" column 49  
print "|" column 72
print "INTEREST" column  73 center size 15
print "|" column 89  
print "|" column 111
print "SECURITY" column 112 size 15 center
print "|" column 128 
print "|" column 150  
print "|" column 162 
separatorline
end
#****************************************************************************************

