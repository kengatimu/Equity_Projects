# Template Name :		monthly_dr103.mrt
# Description	:		Accounts without Imanges
# Author			E.G.KAROBIA, 17-05-2006
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
sol_id		stringType	
schm_type	stringType		
schm_code	stringType
foracid		stringType	
oldacc		stringType
acct_name	stringType
ACCT_OPN_DATE	stringType

LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
totalsol		numbertype
totalbank		numbertype

#
GROUPANDSORT sol_id

PAGEFORMAT
#
linesperpage 70
columnsperline 90
pageheaderlines 10
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipUserid			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter != 0)
 begin
 separatorline
  set totalbank = totalcount foracid
  execute pipe
  print "Grand Total " column 2
  print totalbank column 20
 separatorline
 end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 10
Print lv_userId
print "   " 
print today  
print "       Authorised Signatory"  column 40
nextline
nextline
nextline
nextline
print "********************End Of Report*********************" size 90 center 

BEFOREBREAKOF sol_id
print "For Branch - >  " column 1
print sol_id
#
AFTERBREAKOF sol_id
set totalsol= groupcount foracid
separatorline
execute pipe
print "Sub Total" column 1
print totalsol column 20
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
 begin
       execute pipe
	print sol_id column 2			
	print schm_type column 10 		
	print schm_code column 20 		
	print foracid column 30 			
	print substr acct_name,1,29 column  45 
        print ACCT_OPN_DATE column 75 	
 end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
        execute pipe
	print "BRANCH"  column 2			
	print "SCHM_TYPE" column 10 		
	print "SCHM_CODE" column 20 		
	print "ACCNT_NUM" column 32 			
	print "ACCT_NAME" column 47 
	print "ACCT_OPN_DATE" column 76
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 90 center 
	nextline
	nextline
	print "ACCOUNTS WITHOUT IMAGES REPORT"   size 90 center 
	nextline
	nextline
	print "FOR BRANCH:" column 40
	print ipSetId
	nextline
	nextline
	
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 90 center 
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

     begin
 	print "|" column 1			
	print "|" column 9 		
	print "|" column 19 		
	print "|" column 29			
	print "|" column 44		
	print "|" column 74 	
	print "|" column 90	
	end


