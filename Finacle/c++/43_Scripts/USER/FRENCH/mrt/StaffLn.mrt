###############################################################################
RECORDLAYOUT
###############################################################################
sol_id                          stringtype
foracid				stringtype
amt				stringtype	
ind				stringtype
###############################################################################
LOCALVARIABLES
###############################################################################
crncy				stringtype
sol_lpad			stringtype
for_lpad			stringtype
clr_lpad			stringtype
takataka			stringtype
taka_lp				stringtype
trap_lpad			stringtype
tran_part_2			stringtype
part_amt			numbertype
part_amt_str			stringtype
amt_2				numbertype
off_acct_1			stringtype 
off_acct_2                      stringtype
indrev				stringtype
subforacid			stringtype
###############################################################################
GROUPANDSORT
###############################################################################
REPOSITORY  argv4
#############################################################################
tran_part_1			stringType
###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine  1000
LinesPerPage   	5000 
LeftMargin       00
RightMargin      00
Topmargin        00
BottomMargin     00
pageHeaderLines  00
pageFooterLines  00
##############################################################################
ONEVERYRECORD
##############################################################################
set for_lpad = rpad foracid 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print ind column 28

set clr_lpad = lpad amt 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part_1 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 800 " "
print takataka size 800 column 76
set subforacid =  substr foracid,4,13
if subforacid != "3000100774"
begin
 print "COLLC" size 5 column 931
end

##############################################################################
ONSTARTOFREPORT
##############################################################################
set crncy = "KES"
set takataka = " " 
##############################################################################
ONENDOFREPORT
