#######################################################################
ONEVERYRECORD
#######################################################################
if (vars = "LAA")
begin
        set tot_laa_nor_hom     = var1
        set tot_laa_los_hom     = var2
        set tot_laa_sub_hom     = var3
        set tot_laa_dbt_hom     = var4
        set tot_laa_wat_hom = var5
        set tot_laa_nor_hom_cnt = var6
        set tot_laa_los_hom_cnt = var7
        set tot_laa_sub_hom_cnt = var8
        set tot_laa_dbt_hom_cnt = var9
        set tot_laa_wat_hom_cnt = var10

        set tot_laa_nor_fgn = var11
        set tot_laa_los_fgn = var12
        set tot_laa_sub_fgn = var13
        set tot_laa_dbt_fgn = var14
        set tot_laa_wat_fgn = var15
        set tot_laa_nor_fgn_cnt = var16
        set tot_laa_los_fgn_cnt = var17
        set tot_laa_sub_fgn_cnt = var18
        set tot_laa_dbt_fgn_cnt = var19
        set tot_laa_wat_fgn_cnt = var20
end
if (vars = "CAA")
begin
        set tot_oda_nor_hom = var1
        set tot_oda_los_hom = var2
        set tot_oda_sub_hom = var3
        set tot_oda_dbt_hom = var4
        set tot_oda_wat_hom = var5
        set tot_oda_nor_hom_cnt = var6
        set tot_oda_los_hom_cnt = var7
        set tot_oda_sub_hom_cnt = var8
        set tot_oda_dbt_hom_cnt = var9
        set tot_oda_wat_hom_cnt = var10

        set tot_oda_nor_fgn = var11
        set tot_oda_los_fgn = var12
        set tot_oda_sub_fgn = var13
        set tot_oda_dbt_fgn = var14
        set tot_oda_wat_fgn = var15
        set tot_oda_nor_fgn_cnt = var16
        set tot_oda_los_fgn_cnt = var17
        set tot_oda_sub_fgn_cnt = var18
        set tot_oda_dbt_fgn_cnt = var19
        set tot_oda_wat_fgn_cnt = var20
end

#######################################################################   
ONSTARTOFREPORT
#######################################################################
print "LOANS AND ADVANCES PERFORMANCE REPORT"	column 1
nextline
print "Institution: "	column 1
nextline
print "Financial Year:" column 1
nextline
print "Start Date:"	column 1
nextline
print "End Date:"	column 1
nextline
nextline
print "A. LOANS"	column 1
nextline
separatorline
print "LOCAL CURRENCY"	column 58
print "FOREIGN CURRENCY"	column 98
print "GRAND TOTAL"		column 138
nextline
print "A"			column 55
print "B"			column 75
print "C"			column 95
print "D"			column 115
print "E"			column 135
print "F"			column 155
print "G"			column 175
print "H"			column 195
print "F"			column 215
print "H"			column 235
print "I"			column 255
print "J"			column 275
separatorline
print "NO. |"			column 1
print "PERIOD OF PAST DUE"	column 6
print "No. of"			column 45
print "Amount"			column 65
print "% of"			column 85
print "No. of"			column 105
print "Amount"			column 125
print "% of"                    column 145
print "No. of"                  column 165
print "Amount"                  column 185
print "% of"                    column 205
nextline
print "A/cs"			column 45
print "SHS"			column 65
print "Total"			column 85
print "A/cs"                    column 105
print "SHS"                     column 125
print "Total"                   column 145 
print "A/cs"                    column 165 
print "SHS"                     column 185
print "Total"                   column 205
separatorline
#######################################################################
ONENDOFREPORT
#######################################################################
set tot_hom_laa = tot_laa_los_hom	+ tot_laa_sub_hom + tot_laa_dbt_hom + tot_laa_wat_hom 
set tot_hom_cnt_laa = tot_laa_nor_hom_cnt + tot_laa_los_hom_cnt + tot_laa_sub_hom_cnt + tot_laa_dbt_hom_cnt + tot_laa_wat_hom_cnt 
set tot_fgn_laa = tot_laa_nor_fgn	+ tot_laa_los_fgn + tot_laa_sub_fgn + tot_laa_dbt_fgn + tot_laa_wat_fgn
set tot_fgn_cnt_laa = tot_laa_nor_fgn_cnt + tot_laa_los_fgn_cnt + tot_laa_sub_fgn_cnt + tot_laa_dbt_fgn_cnt + tot_laa_wat_fgn_cnt

set tot_laa = tot_hom_laa + tot_fgn_laa
set tot_laa_cnt = tot_hom_cnt_laa + tot_fgn_cnt_laa

set tot_hom_oda = tot_oda_los_hom	+ tot_oda_sub_hom + tot_oda_dbt_hom + tot_oda_wat_hom 
set tot_hom_cnt_oda = tot_oda_nor_hom_cnt + tot_oda_los_hom_cnt + tot_oda_sub_hom_cnt + tot_oda_dbt_hom_cnt + tot_oda_wat_hom_cnt 
set tot_fgn_oda = tot_oda_nor_fgn	+ tot_oda_los_fgn + tot_oda_sub_fgn + tot_oda_dbt_fgn + tot_oda_wat_fgn
set tot_fgn_cnt_oda = tot_oda_nor_fgn_cnt + tot_oda_los_fgn_cnt + tot_oda_sub_fgn_cnt + tot_oda_dbt_fgn_cnt + tot_oda_wat_fgn_cnt

set tot_oda = tot_hom_oda + tot_fgn_oda
set tot_oda_cnt = tot_hom_cnt_oda + tot_fgn_cnt_oda

print "1" 			column 1
print "30 to 90 days"		column 6
print tot_laa_wat_hom_cnt 	column 45 size 20 autocomma precision 2
set tot_pd_laa_cnt_hom = tot_laa_wat_hom_cnt 
print tot_laa_wat_hom		column 65 size 20 autocomma precision 2
set tot_pd_laa_hom	= tot_laa_wat_hom
set tot_per = (tot_laa_wat_hom / tot_hom_laa) * 100
print tot_per			column 85 size 20 autocomma precision 2 
set tot_pd_per_hom		= tot_per
print tot_laa_wat_fgn_cnt	column 105 size 20 autocomma precision 2
set tot_pd_laa_cnt_fgn = tot_laa_wat_fgn_cnt 
print tot_laa_wat_fgn		column 125 size 20 autocomma precision 2
set tot_pd_laa_fgn = tot_laa_wat_fgn
set tot_per = (tot_laa_wat_fgn / tot_hom) * 100
print tot_per 			column 145  size 20 autocomma precision 2
set tot_pd_per_fgn = tot_per
set tot_cnt = tot_laa_wat_hom_cnt + tot_laa_wat_hom_fgn
print tot_cnt 			column 165  size 20 autocomma precision 2
set tot_pd_cnt = tot_cnt
set tot_per = (tot_cnt / tot_cnt_laa) * 100
print tot_per			column 185 size 20 autocomma precision 2
set tot_pd_per_cnt = tot_per
set tot_amt = tot_laa_wat_hom + tot_laa_wat_fgn
print tot_amt 			column 205  size 20 autocomma precision 2
set tot_pd_amt = tot_amt
set tot_per = (tot_amt / tot_laa) * 100
print tot_per 			column 225  size 20 autocomma precision 2
set tot_pd_per_amt = tot_per
nextline

print "2"			column 1 
print "More than 90 to 180 days"           column 6
print tot_laa_sub_hom_cnt 	column 45 size 20 autocomma precision 2
set tot_pd_laa_cnt_hom = tot_laa_sub_hom_cnt 
