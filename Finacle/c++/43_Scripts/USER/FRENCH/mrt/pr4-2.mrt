set tot_pd_per_fgn = tot_pd_per_fgn + tot_per
set tot_cnt = tot_laa_sub_hom_cnt + tot_laa_sub_hom_fgn
print tot_cnt 			column 165  size 20 autocomma precision 2
set tot_pd_cnt = tot_pd_cnt + tot_cnt
set tot_per = (tot_cnt / tot_cnt_laa) * 100
print tot_per			column 185 size 20 autocomma precision 2
set tot_pd_per_cnt = tot_pd_per_cnt + tot_per
set tot_amt = tot_laa_sub_hom + tot_laa_sub_fgn
print tot_amt 			column 205  size 20 autocomma precision 2
set tot_pd_amt = tot_pd_amt + tot_amt
set tot_per = (tot_amt / tot_laa) * 100
print tot_per 			column 225  size 20 autocomma precision 2
set tot_pd_per_amt = tot_pd_per_amt + tot_per

nextline
