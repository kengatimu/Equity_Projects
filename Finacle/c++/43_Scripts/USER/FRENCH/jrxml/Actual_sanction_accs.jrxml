ameter%String::and%CATOD_SANCTION_TABLE.ACCT_NUM%=%$P{ACCT_NUM}%Parameter%String::and%CATOD_SANCTION_TABLE.STATUS_FLG%=%$P{STATUS_FLG}%Parameter%String::and%CATOD_SANCTION_TABLE.SANCT_DATE%=%$P{SANCT_DATE}%Parameter%Date::and%CATOD_SANCTION_TABLE.EXPIRY_DATE%=%$P{EXPIRY_DATE}%Parameter%Date::|SOL_ID%java.lang.String%8%!NULL!%SOL_ID@DBQUERY%PRODUCT!@!SolID_List#@#N%java.lang.String!@!DEFAULT!@!0!@!8%CONSTANT%N%N::REQUEST_ID%java.lang.String%16%!NULL!%REQUEST_ID@DBQUERY%NONE%java.lang.String!@!DEFAULT!@!0!@!16%CONSTANT%N%N::ACCT_NUM%java.lang.String%16%!NULL!%ACCT_NUM@DBQUERY%PRODUCT!@!AC_ID_Lookup#@#N%java.lang.String!@!DEFAULT!@!0!@!16%CONSTANT%N%N::STATUS_FLG%java.lang.String%1%!NULL!%STATUS_FLG@DBQUERY%NONE%java.lang.String!@!DEFAULT!@!0!@!1%CONSTANT%N%N::SANCT_DATE%java.sql.Timestamp%10%!NULL!%SANCT_DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::EXPIRY_DATE%java.sql.Timestamp%10%!NULL!%EXPIRY_DATE@DBQUERY%NONE%java.sql.Timestamp!@!DEFAULT!@!8!@!10%CONSTANT%N%N::|!NULL!|!NULL!|!NULL!|select     CATOD_SANCTION_TABLE.REQUEST_ID as *REQUEST_ID* ,     CATOD_SANCTION_TABLE.ACCT_NAME as *CATOD_SANCTION_TABLE_ACCT_NAME* from     CUSTOM.CATOD_SANCTION_TABLE CATOD_SANCTION_TABLE  where    CATOD_SANCTION_TABLE.SOL_ID = $P{SOL_ID}     and CATOD_SANCTION_TABLE.REQUEST_ID = $P{REQUEST_ID}     and CATOD_SANCTION_TABLE.ACCT_NUM = $P{ACCT_NUM}     and CATOD_SANCTION_TABLE.STATUS_FLG = $P{STATUS_FLG}     and CATOD_SANCTION_TABLE.SANCT_DATE = TO_DATE( CAST ( $P{SANCT_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )     and CATOD_SANCTION_TABLE.EXPIRY_DATE = TO_DATE( CAST ( $P{EXPIRY_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )|SELECT REQUEST_ID,ACCT_NUM,ACCT_NAME,SOL_ID,SCHM_TYPE, DECODE(REQ_TYPE,'F','FRESH','E',DECODE(E_TYPE,'01','ENHANCEMENT','02','EXTENSION','03','EXT/ENC'),'C','TERMINATED') REQ_TYPE, DECODE(STATUS_FLG,'A','APPROVED','P','PENDING','R','REJECTED','X','EXPIRED','C','TERMINATED') STATUS, NVL(TO_CHAR(CREATED_BY),'-') CREATED_BY, NVL(TO_CHAR(CREATED_DATE,'DD-MM-YYYY'),'-')CREATED_DATE,  NVL(TO_CHAR(MODIFIED_BY),'-') MODIFIED_BY, NVL(TO_CHAR(MODIFIED_DATE,'DD-MM-YYYY'),'-') MODIFIED_DATE,  NVL(TO_CHAR(VERIFY_BY),'-')VERIFY_BY, NVL(TO_CHAR(VERIFY_DATE,'DD-MM-YYYY'),'-')VERIFY_DATE,  NVL(TO_CHAR(SANCT_DATE,'DD-MM-YYYY'),'-') SANCT_DATE, NVL(TO_CHAR(SANCT_PERIOD),'-')SANCT_PERIOD, NVL(TO_CHAR(EXPIRY_DATE,'DD-MM-YYYY'),'-')EXPIRY_DATE, NVL(TO_CHAR(SANCT_AMT),'-')SANCT_AMT   FROM CUSTOM.CATOD_SANCTION_TABLE A  WHERE    A.SOL_ID = $P{SOL_ID}     and A.REQUEST_ID = $P{REQUEST_ID}     and A.ACCT_NUM = $P{ACCT_NUM}     and A.STATUS_FLG = $P{STATUS_FLG}     and (A.SANCT_DATE = TO_DATE( CAST ( $P{SANCT_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )     or NVL($P{SANCT_DATE},'ALL') = 'ALL')    and (A..EXPIRY_DATE = TO_DATE( CAST ( $P{EXPIRY_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )    or NVL($P{EXPIRY_DATE},'ALL') = 'ALL')|true"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT REQUEST_ID,ACCT_NUM,ACCT_NAME,SOL_ID,SCHM_TYPE,
DECODE(REQ_TYPE,'F','FRESH','E',DECODE(E_TYPE,'01','ENHANCEMENT','02','EXTENSION','03','EXT/ENC'),'C','TERMINATED') REQ_TYPE, DECODE(STATUS_FLG,'A','APPROVED','P','PENDING','R','REJECTED','X','EXPIRED','C','TERMINATED') STATUS,
NVL(TO_CHAR(CREATED_BY),'-') CREATED_BY, NVL(TO_CHAR(CREATED_DATE,'DD-MM-YYYY'),'-')CREATED_DATE, 
NVL(TO_CHAR(MODIFIED_BY),'-') MODIFIED_BY, NVL(TO_CHAR(MODIFIED_DATE,'DD-MM-YYYY'),'-') MODIFIED_DATE, 
NVL(TO_CHAR(VERIFY_BY),'-')VERIFY_BY, NVL(TO_CHAR(VERIFY_DATE,'DD-MM-YYYY'),'-')VERIFY_DATE, 
NVL(TO_CHAR(SANCT_DATE,'DD-MM-YYYY'),'-') SANCT_DATE, NVL(TO_CHAR(SANCT_PERIOD),'-')SANCT_PERIOD,
NVL(TO_CHAR(EXPIRY_DATE,'DD-MM-YYYY'),'-')EXPIRY_DATE, NVL(TO_CHAR(SANCT_AMT),'-')SANCT_AMT 

FROM CUSTOM.CATOD_SANCTION_TABLE A

WHERE
   A.SOL_ID = $P{SOL_ID} 
   and A.REQUEST_ID = $P{REQUEST_ID} 
   and A.ACCT_NUM = $P{ACCT_NUM} 
   and A.STATUS_FLG = $P{STATUS_FLG} 
   and (A.SANCT_DATE = TO_DATE( CAST ( $P{SANCT_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' ) 
   or NVL($P{SANCT_DATE},'ALL') = 'ALL')
   and (A.EXPIRY_DATE = TO_DATE( CAST ( $P{EXPIRY_DATE} AS VARCHAR(10) ) , 'dd-MM-yyyy' )
   or NVL($P{EXPIRY_DATE},'ALL') = 'ALL')]]></queryString>

