		IF(CUST.LADISB.err != "") THEN
		#{
			#sv_s = "echo '" + CUST.LADISB.foracid + ":" + CUST.LADISB.err+"' >>"+CUST.LADISB.failFile
			sv_s = "echo '" + CUST.LADISB.err+"' >>"+CUST.LADISB.failFile
			PRINT(sv_s)
			sv_a = SYSTEM(sv_s)
			PRINT(sv_a)
			
			BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = " DELETE FROM TBAADM.CLTT "
			sv_s = sv_s + "  WHERE "
			sv_s = sv_s + "  EVENT_ID ='PYOFF'"
			sv_s = sv_s + "  AND FUNC_CODE='P'"
			sv_s = sv_s + "  AND bank_id = ?SVAR"
			sv_s = sv_s + "  AND RCRE_USER_ID = ?SVAR"
			PRINT(sv_s)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			
			sv_d = urhk_dbSqlWithBind("COMMIT")
			PRINT(sv_d)
			
			#---------------------------------------------------------------------------------
			# Checking if report file is of zero bytes
			#---------------------------------------------------------------------------------
			sv_a = "test -s " + CUST.LADISB.failFile
			sv_b = SYSTEM(sv_a)
			PRINT(sv_b)
			
			#---------------------------------------------------------------------------------
			# Moving the File to  HPR menu
			#---------------------------------------------------------------------------------
			IF (sv_b == 0)THEN
			#{
				sv_a = "cp " + CUST.LADISB.failFile + " ${FIN_REPORTS_DIR}/" + BANCS.STDIN.userId + "/" + CUST.LADISB.failFile
				PRINT(sv_a)
				sv_b = SYSTEM(sv_a)
				PRINT(sv_b)
				
				sv_x = "babx4040 ${B2K_SESSION_ID} ${FIN_REPORTS_DIR}/"+ BANCS.STDIN.userId + "/"+ CUST.LADISB.failFile +' '+'"'+" Payoff Error Report "+'"'+" MANAGER 1 N"
				PRINT(sv_x)
				sv_h = SYSTEM (sv_x)
				PRINT(sv_h)
			#}
			ENDIF
			
			EXITSCRIPT
		#}
		ENDIF
		
		#---------------------------------------------------------------------------------
		# Checking if report file is of zero bytes
		#---------------------------------------------------------------------------------
		sv_a = "test -s " + CUST.LADISB.sucsFile
		sv_b = SYSTEM(sv_a)
		PRINT(sv_b)
		
		#---------------------------------------------------------------------------------
		# Moving the File to  HPR menu
		#---------------------------------------------------------------------------------
		IF (sv_b == 0)THEN
		#{
			sv_a = "cp " + CUST.LADISB.sucsFile + " ${FIN_REPORTS_DIR}/" + BANCS.STDIN.userId + "/" + CUST.LADISB.sucsFile
			PRINT(sv_a)
			sv_b = SYSTEM(sv_a)
			PRINT(sv_b)
			
			sv_x = "babx4040 ${B2K_SESSION_ID} ${FIN_REPORTS_DIR}/"+ BANCS.STDIN.userId + "/"+ CUST.LADISB.sucsFile +' '+'"'+" Payoff Success Report "+'"'+" MANAGER 1 N"
			PRINT(sv_x)
			sv_h = SYSTEM (sv_x)
			PRINT(sv_h)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
