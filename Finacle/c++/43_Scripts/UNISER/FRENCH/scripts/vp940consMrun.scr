<--start
trace on
#Reps/Class
#++++++++++
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        if(repexists("NFZ")==0)then
                createrep("NFZ")
        endif
        if(classexists("NFZ","GLBDATA")==0)then
                createclass("NFZ","GLBDATA",5)
        endif
        NFZ.GLBDATA.genYN = "N"
        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                NFZ.GLBDATA.AcctId = MTT.InputDetails.Argument1
                NFZ.GLBDATA.UserId = MTT.InputDetails.Argument2
                NFZ.GLBDATA.CifId = MTT.InputDetails.Argument3
        else
                sv_u = urhk_MTTS_Close("")
                print(sv_u)
                NFZ.GLBDATA.CifId = "43100183538"
                NFZ.GLBDATA.AcctId = "300000085591714"
        endif
        lv_d = " sCifId,sAcctId,stmtStartDate,stmtRunDays,nxtStmtStartDate,nxtExecutionDate,exCnt,upNxtDate | "
        lv_d = lv_d + " select cif_id,foracid,to_date(stmt_start_date,'DD-MM-RRRR'),stmt_run_days,"
        lv_d = lv_d + " to_date(nxt_stmt_start_date,'DD-MM-RRRR'),to_date(stmt_execution_date,'DD-MM-RRRR'),"
        lv_d = lv_d + " nvl(free_text_1,0),to_date(stmt_start_date,'DD-MM-RRRR') +1 "
        lv_d = lv_d + " from custom.mt940_cons_tbl "
        lv_d = lv_d + " where bank_id=?SVAR "
        lv_d = lv_d + " and cif_id=?SVAR "
        lv_d = lv_d + " and foracid=?SVAR "
        lv_d = lv_d + " and entity_cre_flg='Y' "
        lv_d = lv_d + " and del_flg='N' "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + NFZ.GLBDATA.CifId + "|" + NFZ.GLBDATA.AcctId
        print(BANCS.INPARAM.BINDVARS)
        print(lv_d)
        lv_u = urhk_dbCursorOpenWithBind(lv_d)
        if(lv_u == 0)then
                NFZ.GLBDATA.nfzCurNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        else
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Database Error ")
                goto SIFNO
        endif
        NFZ.GLBDATA.recNum = 0
        lv_f = urhk_dbCursorFetch(NFZ.GLBDATA.nfzCurNum)
        if(lv_f !=0)then
                lv_f = urhk_dbCursorClose(NFZ.GLBDATA.nfzCurNum)
                print(lv_f)
                sv_u = urhk_SetOrbOut("SuccessOrFailure|F")
                sv_u = urhk_SetOrbOut("ErrorCode|E9999")
                sv_u = urhk_SetOrbOut("Message|Database Error ")
                NFZ.GLBDATA.isRecYN="N"
                goto SIFNO
        else
                NFZ.GLBDATA.isRecYN="Y"
        endif
        while(lv_f ==0)
        ##{
                NFZ.GLBDATA.sCifId = BANCS.OUTPARAM.sCifId
                NFZ.GLBDATA.sAcctId = BANCS.OUTPARAM.sAcctId
                NFZ.GLBDATA.stmtStartDate = BANCS.OUTPARAM.stmtStartDate
                NFZ.GLBDATA.stmtRunDays = BANCS.OUTPARAM.stmtRunDays
                NFZ.GLBDATA.nxtStmtStartDate = BANCS.OUTPARAM.nxtStmtStartDate
                NFZ.GLBDATA.nxtExecutionDate = BANCS.OUTPARAM.nxtExecutionDate
                NFZ.GLBDATA.exCnt = BANCS.OUTPARAM.exCnt
                NFZ.GLBDATA.upNxtDate = BANCS.OUTPARAM.upNxtDate
                print(NFZ.GLBDATA.sCifId)
                print(NFZ.GLBDATA.sAcctId)
                print(NFZ.GLBDATA.stmtStartDate)
                print(NFZ.GLBDATA.stmtRunDays)
                print(NFZ.GLBDATA.nxtStmtStartDate)
                print(NFZ.GLBDATA.nxtExecutionDate)
                print(NFZ.GLBDATA.exCnt)
                print(NFZ.GLBDATA.upNxtDate)
                sv_u = urhk_getAcctDetailsInRepository(NFZ.GLBDATA.sAcctId)
                if(sv_u == 0)then
                        NFZ.GLBDATA.oacctSolId = BANCS.OUTPARAM.acctSolId
                        NFZ.GLBDATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
                else
                        NFZ.GLBDATA.oacctSolId = ""
                        NFZ.GLBDATA.acctCrncyCode = ""
                endif
                sv_q = urhk_B2k_ForacidToAcid(NFZ.GLBDATA.sAcctId)
                if(sv_q==0)then
                        NFZ.GLBDATA.opAcid = BANCS.OUTPARAM.Acid
                        print(NFZ.GLBDATA.opAcid)
                else
                        NFZ.GLBDATA.opAcid = ""
                endif
#Loop
                BANCS.INPARAM.date2 = "12-12-2020"
                BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10)
                sv_u = urhk_B2K_dateDiff("")
                print(sv_u)
                if(sv_u == 0 ) then
                        BANCS.INPUT.migdatediff = BANCS.OUTPARAM.dateDiff
                        sv_e = BANCS.OUTPARAM.dateDiff
                else
                        sv_e = 0
                        BANCS.INPUT.migdatediff = "0"
                endif
                print(BANCS.INPUT.migdatediff)
                sv_x = 1
                while(sv_x<=sv_e)
                ##{
                        print(sv_x)
                        print(sv_e)
                        #run 940
                        lv_z = BANCS.STDIN.mySolId
                        if(sv_x==1)then
                                lv_a = "12-12-2020"
                                BANCS.INPUT.rnum = sv_e
                                lv_r = "-" + BANCS.INPUT.rnum
                        else
                                lv_a = BANCS.INPARAM.date2
                                if(sv_t!=0)then
                                        BANCS.INPUT.rnum = sv_t
                                        lv_r = "-" + BANCS.INPUT.rnum
                                else
                                        BANCS.INPUT.rnum = sv_t
                                        lv_r = BANCS.INPUT.rnum
                                endif
                        endif
                        print(lv_r)
                                NFZ.GLBDATA.stmtDate = lv_a
                                NFZ.GLBDATA.stmtDays = lv_r
                                print(NFZ.GLBDATA.stmtDate)
                                print(NFZ.GLBDATA.stmtDays)
                                NFZ.GLBDATA.stmtCRunDays = NFZ.GLBDATA.stmtDays
                                NFZ.GLBDATA.NCMRunDays = NFZ.GLBDATA.stmtDays
                                NFZ.GLBDATA.datName = "STMT_" + NFZ.GLBDATA.sAcctId + "" + NFZ.GLBDATA.stmtCRunDays + ".DAT"
                                NFZ.GLBDATA.swdatName = "SW_" + NFZ.GLBDATA.sAcctId + "" + NFZ.GLBDATA.stmtCRunDays + ".DAT"
                                NFZ.GLBDATA.qote = ""
                                sv_m = "touch " + NFZ.GLBDATA.datName
                                sv_m = system(sv_m)
                                sv_m = "touch " + NFZ.GLBDATA.swdatName
                                sv_m = system(sv_m)
                                callscriptifexist("vp940baor5073.scr")
                                if(NFZ.GLBDATA.isBatchYN=="Y")then
                                #{
                                        print("Batch Success")
                                        sv_a = "rm -f " + NFZ.GLBDATA.datName
                                        sv_r = system(sv_a)
                                        sv_a = "rm -f " + NFZ.GLBDATA.swdatName
                                        sv_r = system(sv_a)
                                        lv_d = "update custom.mt940_cons_tbl set stmt_run_days=?SVAR,nxt_stmt_start_date=to_date(?SVAR,'DD-MM-RRRR') , "
                                        lv_d = lv_d + " stmt_execution_date=sysdate-1,free_text_1=1,lchg_user_id=?SVAR, "
                                        lv_d = lv_d + " lchg_time=sysdate "
                                        lv_d = lv_d + " where bank_id=?SVAR and cif_id=?SVAR and foracid=?SVAR and entity_cre_flg='Y' "
                                        lv_d = lv_d + " and del_flg='N' "
                                        print(lv_d)
                                        BANCS.INPARAM.BINDVARS = NFZ.GLBDATA.stmtCRunDays + "|" + NFZ.GLBDATA.upNxtDate + "|" + BANCS.STDIN.userId+ "|" +BANCS.STDIN.contextBankId + "|" + NFZ.GLBDATA.sCifId + "|" + NFZ.GLBDATA.sAcctId
                                        print(BANCS.INPARAM.BINDVARS)
                                        lv_h = urhk_dbSqlWithBind(lv_d)
                                        if(lv_h==0)then
                                                lv_h = urhk_dbSqlWithBind("commit")
                                        endif
                                else
                                        print("Batch Fail")
                                        sv_a = "rm -f " + NFZ.GLBDATA.datName
                                        sv_r = system(sv_a)
                                        sv_a = "rm -f " + NFZ.GLBDATA.swdatName
                                        sv_r = system(sv_a)
                                #}
                                endif
                        lv_x = lv_z + "|" + lv_a
                        print(lv_x)
                        lv_e = urhk_GetNextWorkingDate(lv_x)
                        print(lv_e)
                        if(lv_e==0)then
                                print(BANCS.OUTPARAM.NextWorkingDate)
                                print(BANCS.OUTPARAM.PrevWorkingDate)
                                print(BANCS.OUTPARAM.NextDataCentreWorkingDate)
                                print(BANCS.OUTPARAM.PrevDataCentreWorkingDate)
                        endif

                        BANCS.INPARAM.date2 = left$(BANCS.OUTPARAM.NextWorkingDate,10)
                        BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10)
                        sv_u = urhk_B2K_dateDiff("")
                        print(sv_u)
                        if(sv_u == 0 ) then
                                BANCS.INPUT.migdatediff = BANCS.OUTPARAM.dateDiff
                                sv_t = BANCS.OUTPARAM.dateDiff
                        else
                                sv_t = 0
                                BANCS.INPUT.migdatediff = "0"
                        endif
                        if(sv_t<0)then
                                NFZ.GLBDATA.genYN = "Y"
                                goto CONTI
                        endif
                        sv_x = sv_x + 1
                        print(sv_x)
                ##}
                do
                NXTACCTL:
                lv_f = urhk_dbCursorFetch(NFZ.GLBDATA.nfzCurNum)
                print(NFZ.GLBDATA.nfzCurNum)
                NFZ.GLBDATA.recNum = cint(NFZ.GLBDATA.recNum) + 1
        ##}
        do
        lv_f = urhk_dbCursorClose(NFZ.GLBDATA.nfzCurNum)
        print(lv_f)
        CONTI:
        if(NFZ.GLBDATA.genYN=="Y")then
                print(NFZ.GLBDATA.AcctId)
                print(BANCS.STDIN.userId)
                NFZ.GLBDATA.acctc = left$(NFZ.GLBDATA.AcctId,13)
        endif
trace off
end-->
