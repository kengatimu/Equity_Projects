                       # -----------------------------------------------------------------------------
                       # Charge amount for the account
                       # -----------------------------------------------------------------------------
                       CUST.DATA.chrgAmt = BANCS.OUTPARAM.OutputAmount
                       print(CUST.DATA.chrgAmt)
		#}
		ENDIF	
					
		CUST.DATA.totalchrgAmt = (CUST.DATA.totalchrgAmt) + (CUST.DATA.chrgAmt)
		sv_f = urhk_dbCursorFetch(sv_n)
		PRINT(sv_f)
			
	#}
	DO
