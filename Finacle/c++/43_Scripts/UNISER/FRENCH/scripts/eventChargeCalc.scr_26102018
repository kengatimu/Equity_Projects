		PRINT(CUST.DATA.minAmt)
		PRINT(CUST.DATA.maxAmt)
		PRINT(CUST.DATA.chrgAmt)
		PRINT(CUST.DATA.slabCode)

		IF(CUST.DATA.chrgType == "P")THEN
		#{
			CUST.DATA.chrgAmt = CDOUBLE(CUST.DATA.inputAmt) * CDOUBLE(CUST.DATA.chrgpcnt) * (0.01)
			IF(CUST.DATA.chrgAmt < CUST.DATA.minAmt)THEN
			#{
				CUST.DATA.chrgAmt = CUST.DATA.minAmt
			#}
			ENDIF
			IF(CUST.DATA.chrgAmt > CUST.DATA.maxAmt)THEN
			#{
				CUST.DATA.chrgAmt = CUST.DATA.maxAmt
			#}
			ENDIF
		#}
		ENDIF

		IF(CUST.DATA.chrgType == "S")THEN
		#{
			IF(CUST.DATA.slabCode == "")THEN
			#{
                        	sv_e="Charge slab code not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
                        	sv_u = urhk_SetOrbErr(sv_e)
                        	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                        	GOTO ENDOFSCRIPT
			#}
			ENDIF
			BANCS.INPARAM.CurrencyCode = CUST.DATA.crncy
			BANCS.INPARAM.AmountTableCode = CUST.DATA.slabCode	
			BANCS.INPARAM.InputAmount = CUST.DATA.inputAmt
                        PRINT(BANCS.INPARAM.AmountTableCode)
                        PRINT(BANCS.INPARAM.CurrencyCode)
                        PRINT(BANCS.INPARAM.InputAmount)

                        # -----------------------------------------------------------------------------
