	IF((BANCS.STDIN.menuId == "HTM") OR (BANCS.STDIN.menuId == "HXFER") OR (BANCS.STDIN.menuId == "HCASHWD") OR (BANCS.STDIN.menuId == "HORM"))THEN
        #{
               	IF(FIELDEXISTS(BANCS.INPUT.entityId))THEN  
