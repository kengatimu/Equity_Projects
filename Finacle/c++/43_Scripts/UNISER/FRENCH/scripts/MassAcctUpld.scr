			sv_s = "mrbx4004 $B2K_SESSION_ID MassUploadSuc.mrt " + CUST.CATOD.successlogFile + " " + CUST.CATOD.successlogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.successlogFile = CUST.CATOD.successlogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/" + BANCS.STDIN.userId  +"/" + CUST.CATOD.successlogFile+  " 'SUCCESS UPLOAD REPORT FOR MASS ACCT' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			#-----------------------------------
			# Failure Report
			#-----------------------------------
			
			sv_s = "mrbx4004 $B2K_SESSION_ID MassUploadFai.mrt " + CUST.CATOD.failurelogFile + " " + CUST.CATOD.failurelogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.failurelogFile = CUST.CATOD.failurelogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/"+ BANCS.STDIN.userId +"/"+CUST.CATOD.failurelogFile+" 'FAILURE UPLOAD REPORT FOR MASS ACCT' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			
		#}
		ENDIF
		
		EXITSCRIPT
