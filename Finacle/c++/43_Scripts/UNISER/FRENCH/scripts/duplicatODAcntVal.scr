<--START
	
	TRACE ON
	
	sv_a = REPEXISTS("CUST")
	IF(sv_a == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.cifId = " "
	CUST.DATA.errorFlg = "N"
	CUST.DATA.errorMsg = " "
	CUST.DATA.recCount = "0"
	CUST.DATA.odAcnt = " "

	IF(FIELDEXISTS(BANCS.INPUT.cifId))THEN
	#{
		IF(BANCS.INPUT.cifId !="")THEN
		#{
			CUST.DATA.cifId = TOUPPER(TRIM(BANCS.INPUT.cifId))
			PRINT(CUST.DATA.cifId)
		#}
		ELSE
		#{
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.schmCode))THEN
	#{
		IF(BANCS.INPUT.schmCode !="")THEN
		#{
			CUST.DATA.schmCode = TOUPPER(TRIM(BANCS.INPUT.schmCode))
			PRINT(CUST.DATA.schmCode)
		#}
		ELSE
		#{
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

        BANCS.INPUT.moduleName  = "OT"
        BANCS.INPUT.parameterId = "ODCA_SCHEMES"
        CALL ("getcparamvalue.scr")
        IF(BANCS.OUTPUT.parameterVal != "")THEN
        #{
                CUST.DATA.schmparmVal = BANCS.OUTPUT.parameterVal
                #}
        ELSE
                #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                GOTO ENDOFSCRIPT

        #}
        ENDIF

	sv_p = GETPOSITION(CUST.DATA.schmparmVal,CUST.DATA.schmCode)
	PRINT(sv_p)

	IF(sv_p <= "0")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_s = "recCount|SELECT COUNT(1) FROM TBAADM.GAM WHERE CIF_ID=?SVAR AND BANK_ID=?SVAR AND SCHM_TYPE='ODA' AND DEL_FLG='N' AND ACCT_CLS_FLG='N'"
	BANCS.INPARAM.BINDVARS = CUST.DATA.cifId + "|" + BANCS.STDIN.contextBankId 
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "DB error,Please contact DBA"
		#}
	ELSE
		#{
		CUST.DATA.recCount = BANCS.OUTPARAM.recCount
	#}
	ENDIF
	
	IF(CUST.DATA.recCount != "0")THEN
	#{
	        sv_s = "odAcnt|SELECT FORACID FROM TBAADM.GAM WHERE CIF_ID=?SVAR AND BANK_ID=?SVAR AND SCHM_TYPE='ODA' AND DEL_FLG='N' AND ACCT_CLS_FLG='N' AND ROWNUM<2"
        	BANCS.INPARAM.BINDVARS = CUST.DATA.cifId + "|" + BANCS.STDIN.contextBankId

        	PRINT(sv_s)
        	PRINT(BANCS.INPARAM.BINDVARS)

        	sv_d = urhk_dbSelectWithBind(sv_s)
        	PRINT(sv_d)

        	IF(sv_d == 0)THEN
        	#{
                	CUST.DATA.odAcnt = BANCS.OUTPARAM.odAcnt
        	#}
        	ENDIF

		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "Already active OD account: "+CUST.DATA.odAcnt+" exist for the cif: "+CUST.DATA.cifId
	#}
	ENDIF
	
	ENDOFSCRIPT:
	sv_a = urhk_SetOrbOut("errorFlg|"+CUST.DATA.errorFlg)
	sv_a = urhk_SetOrbOut("errorMsg|"+CUST.DATA.errorMsg)
	
	TRACE OFF
END-->
