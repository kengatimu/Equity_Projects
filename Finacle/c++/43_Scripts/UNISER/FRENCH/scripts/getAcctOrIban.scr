<--start
trace on
#Rep/Class
	
IF (REPEXISTS("CUST") == 0 ) THEN
    CREATEREP("CUST")
ENDIF
IF (CLASSEXISTS("CUST","DATA") == 0) THEN
    CREATECLASS("CUST","DATA",5)
ENDIF

CUST.DATA.errMsg=""
CUST.DATA.acctNum=""
CUST.DATA.ibanNum=""

IF( (FIELDEXISTS(("BANCS").("INPUT").("Value"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply A/C or Iban value"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Value=BANCS.INPUT.Value
	print(CUST.DATA.Value)
ENDIF
	if(STRLEN(CUST.DATA.Value)>16)then
			BANCS.INPARAM.iban_number = CUST.DATA.Value 
			sv_r=urhk_getForacidFromIBANnumber("")
			if(sv_r == 0) then
				CUST.DATA.acctNum =BANCS.OUTPARAM.foracid
				CUST.DATA.ibanNum  =CUST.DATA.Value 					
				sv_u = urhk_SetOrbOut("acctNum|" + CUST.DATA.acctNum)
				sv_u = urhk_SetOrbOut("ibanNum|" + CUST.DATA.ibanNum)
					
			else
				CUST.DATA.errMsg = "Invalid IBAN Number  " + CUST.DATA.Value 
				sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
				GOTO END					
			endif
			
	ELSE
		sv_a ="acctNum,ibanNum|"
		sv_a = sv_a + "SELECT foracid ,iban_number FROM tbaadm.gam  WHERE foracid =?SVAR and bank_id =?SVAR"		
		print(sv_a)		
		BANCS.INPARAM.BINDVARS = CUST.DATA.Value  + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_d)
		IF(sv_d != 0)THEN
			CUST.DATA.errMsg ="Y"
			CUST.DATA.errMsg = "Invalid Acct Number  " + CUST.DATA.Value 
			sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
			GOTO END
		ELSE			
			CUST.DATA.acctNum = BANCS.OUTPARAM.acctNum		
			
			IF (BANCS.OUTPARAM.ibanNum !="") THEN
				CUST.DATA.ibanNum = BANCS.OUTPARAM.ibanNum	
			ELSE
				CUST.DATA.ibanNum = " "
			ENDIF			
			sv_u = urhk_SetOrbOut("acctNum|" + CUST.DATA.acctNum)
			sv_u = urhk_SetOrbOut("ibanNum|" + CUST.DATA.ibanNum)
		ENDIF
	endif

	Print  (CUST.DATA.acctNum)
	Print  (CUST.DATA.ibanNum)
END:
EXITSCRIPT
#trace off
END-->


