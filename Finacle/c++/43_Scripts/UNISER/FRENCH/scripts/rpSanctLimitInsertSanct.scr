#======================================================#
#Source Name                    :rpSanctLimitInsertSanct.scr
#Menu                           :HACLHM
#Date                           :27-03-2023
#Description                    :To Add commission charge applicable date in custom.oda_commmission_tbl.
#Author                         :Ranjith Palani
#Calling Service Script		:SRV_VerifyAcctSanctLimit_post_process_data.scr
#======================================================#
<--start
trace on
	if(repexists("CUST") == 0)then
		createrep("CUST")
	endif

	if(classexists("CUST","DRCODC") == 0)then
		createclass("CUST","DRCODC",5)
	endif

	CUST.DRCODC.foracid = CUST.EQTYL.foracid
	CUST.DRCODC.acctSolId = CUST.EQTYL.acctSolId 
	CUST.DRCODC.schmType = CUST.EQTYL.schmType 
	CUST.DRCODC.schmCode = CUST.EQTYL.schmCode 
	CUST.DRCODC.acctOpenDate = CUST.EQTYL.acctOpenDate 
	sv_a= urhk_SRV_GetVal("limitHdr.limitAcct.acid")
	if(sv_a == 0)then
		CUST.DRCODC.acid = BANCS.OUTPARAM.srvValue
	endif
	
	sv_n = urhk_SRV_NumOfRecs("limitLL")
	if(sv_n == 0)then
		CUST.DRCODC.numOfRecords = BANCS.OUTPARAM.srvValue
	else
		 sv_u = urhk_SRV_SetErr("Error:urhk_SRV_NumOfRecs failed")
		 BANCS.OUTPUT.successOrFailure = "F"
		 goto endofscript
	endif

	sv_x = 0
	while(sv_x < cint(CUST.DRCODC.numOfRecords))
	#{
		print(sv_x)
		sv_r = format$(sv_x,"%d")
		sv_t = "<rec_"+sv_r+">"
		print(sv_t)
		print("asd")
		print("kkk")
		sv_a= urhk_SRV_GetVal("limitLL." +sv_t+ ".lhtSrlNum")
		if(sv_a == 0)then
			CUST.DRCODC.lhtSrlNum = BANCS.OUTPARAM.srvValue
			print(CUST.DRCODC.lhtSrlNum)
		endif

		sv_a= urhk_SRV_GetVal("limitLL." +sv_t+ ".sanctLimit")
		if(sv_a == 0)then
			CUST.DRCODC.sanctLimit = BANCS.OUTPARAM.srvValue
			print(CUST.DRCODC.sanctLimit)
		endif

		sv_a= urhk_SRV_GetVal("limitLL." +sv_t+ ".sanctDate")
		if(sv_a == 0)then
			CUST.DRCODC.sanctDate = BANCS.OUTPARAM.srvValue
			print(CUST.DRCODC.sanctDate)
		endif

		sv_a= urhk_SRV_GetVal("limitLL." +sv_t+ ".applicableDate")
		if(sv_a == 0)then
			CUST.DRCODC.applicableDate = BANCS.OUTPARAM.srvValue
			print(CUST.DRCODC.applicableDate)
		endif

		sv_a= urhk_SRV_GetVal("limitLL." +sv_t+ ".expiryDate")
		if(sv_a == 0)then
			CUST.DRCODC.expiryDate = BANCS.OUTPARAM.srvValue
			print(CUST.DRCODC.expiryDate)
		endif

		sv_a= urhk_SRV_GetVal("limitLL." +sv_t+ ".rmks")
		if(sv_a == 0)then
			CUST.DRCODC.rmksAsCommChrgPrcnt = BANCS.OUTPARAM.srvValue
			print(CUST.DRCODC.rmksAsCommChrgPrcnt)
		endif

		CUST.DRCODC.commChargeApplicableDate = CUST.DRCODC.sanctDate

		sv_i = "insert into custom.oda_commission_chrg_tbl" 
		sv_i = sv_i + " (com_acid,com_foracid,com_serial_num,com_sanct_limit,com_crncy_code,"
		sv_i = sv_i + " com_sanct_date,com_applicalbe_date,com_expiry_date,com_charge_applicable_date,"
		sv_i = sv_i + " bank_id,com_charge_percentage,com_schm_type,com_schm_code,acct_opn_date,com_sol_id)"
		sv_i = sv_i + " values(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(?SVAR,'dd-mm-yyyy'),to_date(?SVAR,'dd-mm-yyyy'),to_date(?SVAR,'dd-mm-yyyy'),"
		sv_i = sv_i + " to_date(?SVAR,'dd-mm-yyyy'),?SVAR,?SVAR,?SVAR,?SVAR,to_date(?SVAR,'dd-mm-yyyy'),?SVAR)"
		print(sv_i)
		BANCS.INPARAM.BINDVARS = CUST.DRCODC.acid +"|"+ CUST.DRCODC.foracid +"|"+ CUST.DRCODC.lhtSrlNum +"|"+ CUST.DRCODC.sanctLimit +"|"+ mid$(CUST.DRCODC.sanctDate,0,10)
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ mid$(CUST.DRCODC.applicableDate,0,10) +"|"+ mid$(CUST.DRCODC.expiryDate,0,10) +"|"+ mid$(CUST.DRCODC.commChargeApplicableDate,0,10)
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DRCODC.rmksAsCommChrgPrcnt +"|"+ CUST.DRCODC.schmType +"|"+ CUST.DRCODC.schmCode 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ mid$(CUST.DRCODC.acctOpenDate,0,10) +"|"+ CUST.DRCODC.acctSolId 
		print(BANCS.INPARAM.BINDVARS)
		sv_i = urhk_dbSqlWithBind(sv_i)
		if(sv_i == 0)then
		#{
			sv_i = urhk_dbSqlWithBind("commit")
		#}
		endif

	sv_x = sv_x + 1
	print(sv_x)
	#}
	do

trace off
end-->
