			sv_s = sv_s + "BANK_ID = ?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.COMM.commFreq +"|"+ CUST.COMM.commStartDate + "|" + CUST.COMM.commCode + "|" + CUST.COMM.commflg +"|" + BANCS.STDIN.userId + "|" + CUST.COMM.lcOrBgNumber+ "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_q = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_q)
			IF(sv_q != 0) THEN
			#{
				CUST.COMM.errorFlg ="Y"
				CUST.COMM.errorMsg ="Database Updation Failed"
				
				
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_s = "DELETE FROM CUSTOM.C_COMM_MAINT_MOD WHERE LC_OR_BG_NUMBER = ?SVAR AND BANK_ID = ?SVAR "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.COMM.lcOrBgNumber+ "|" + BANCS.STDIN.contextBankId
