##--- FX transactions blocking to use TTS,TTB and CNB and CNS  start 
IF ((BANCS.INPUT.DccId != "SWT") AND (BANCS.INPUT.DccId != "BS1") AND (BANCS.INPUT.DccId != "AME") AND (BANCS.INPUT.DccId != "MC1") AND (BANCS.INPUT.DccId!= "EFR") ) THEN
