				print("line 1074")
				GOTO ENDOFSCRIPT
			ELSE
				CUST.ATM.creditcurrency = BANCS.OUTPARAM.acctCrncyCode
				print(CUST.ATM.creditcurrency)
			ENDIF
			CUST.ATM.statusflg="N"
			IF (CUST.ATM.Debitcurrency!=CUST.ATM.creditcurrency) THEN  
				IF ((BANCS.INPUT.DccId == "BRK") OR (BANCS.INPUT.DccId == "CMS") OR (BANCS.INPUT.DccId == "MAG") OR (BANCS.INPUT.DccId == "EUN")) THEN
					CUST.ATM.RateCode="CRC"
					IF (BANCS.INPUT.ReservedField1!="CHARGE") THEN
						IF (BANCS.INPUT.ReservedField2=="ATMWIT") THEN
							IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum) == 1) THEN
								CUST.ATM.RateCode=BANCS.INPUT.ConsumerNum
								print(CUST.ATM.RateCode)
								IF ((CUST.ATM.RateCode=="CNB") OR (CUST.ATM.RateCode=="CNS")) THEN
									CUST.ATM.RateCode ="CDCI_RATE_CODE|" + CUST.ATM.RateCode
									CUST.ATM.Put = urhk_putEnv(CUST.ATM.RateCode)
									print(CUST.ATM.Put)
									CUST.ATM.Get = urhk_getEnv("CDCI_RATE_CODE")
