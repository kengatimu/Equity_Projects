												print(BANCS.OUTPUT.contraAccount)
												GOTO ENDOFSCRIPT
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
							BANCS.OUTPUT.contraAccount= BANCS.INPUT.CrForacid
							print(BANCS.OUTPUT.contraAccount)
						ELSE
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.successOrFailure = "F"
							GOTO ENDOFSCRIPT
						ENDIF
					ENDIF
