					print("line 1063") 
					GOTO ENDOFSCRIPT3
				ELSE
					CUST.ATM.Debitcurrency = BANCS.OUTPARAM.acctCrncyCode
					print(CUST.ATM.Debitcurrency)
				ENDIF
			ENDIF
			IF (FIELDEXISTS(BANCS.INPUT.CrForacid)==1) THEN
