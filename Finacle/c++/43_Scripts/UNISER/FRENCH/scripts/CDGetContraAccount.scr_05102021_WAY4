				ELSE
					IF (FIELDEXISTS(BANCS.OUTPUT.contraAccount)==1) THEN
						IF (BANCS.OUTPUT.contraAccount!="") THEN
							CUST.ATM.DebitAccount = BANCS.OUTPUT.contraAccount
							print(CUST.ATM.DebitAccount)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
