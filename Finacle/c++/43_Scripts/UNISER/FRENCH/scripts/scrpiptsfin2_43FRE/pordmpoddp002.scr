<--START
TRACE ON
        IF (REPEXISTS("CUST") == 0 ) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","DATA") == 0) THEN
        #{
                CREATECLASS("CUST","DATA",5)
        #}
        ENDIF

        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.paysysId = " "

        IF(FIELDEXISTS(BANCS.INPUT.remitCrncy))THEN
        #{
                IF(BANCS.INPUT.remitCrncy !="")THEN
                #{
                        CUST.DATA.remitCrncy = TOUPPER(TRIM(BANCS.INPUT.remitCrncy))
                        PRINT(CUST.DATA.remitCrncy)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Remittance Currency Not Entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Remittance Currency Not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.remitAmt))THEN
        #{
                IF(BANCS.INPUT.remitAmt !="")THEN
                #{
                        CUST.DATA.remitAmt = TOUPPER(TRIM(BANCS.INPUT.remitAmt))
                        PRINT(CUST.DATA.remitAmt)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                	CUST.DATA.errMsg = "Remittance Amount Not Entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Remittance Amount Not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        ############Fecthinh scheme codes from CPARAM ###########################
	BANCS.INPUT.moduleName = "OT"

	IF(CUST.DATA.remitCrncy == "EUR")THEN
	#{
        	BANCS.INPUT.parameterId = "REMIT_LIMT_USD"
	#}
	ELSE
	#{
        	BANCS.INPUT.parameterId = "REMIT_LIMT_"+CUST.DATA.remitCrncy
	#}
	ENDIF

	IF(CUST.DATA.remitCrncy == "ZAR")THEN
	#{
		CUST.DATA.paysysId = "SWIFT"
                CUST.DATA.errFlg = "N"
                CUST.DATA.errMsg = " "
                GOTO ENDOFSCRIPT
	#}
	ENDIF

        CALL ("getcparamvalue.scr")
        IF(BANCS.OUTPUT.parameterVal != "")THEN
        #{
                CUST.DATA.limitAmt = BANCS.OUTPUT.parameterVal
                #}
        ELSE
                #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                GOTO ENDOFSCRIPT

        #}
        ENDIF

	IF(CUST.DATA.remitCrncy == "EUR")THEN
	#{
	        BANCS.INPUT.moduleName = "OT"
        	BANCS.INPUT.parameterId = "REMIT_LIMT_EUR_RATE"
        	CALL ("getcparamvalue.scr")
        	IF(BANCS.OUTPUT.parameterVal != "")THEN
        	#{
                	CUST.DATA.schmparmVal = BANCS.OUTPUT.parameterVal
                #}
        	ELSE
                #{
                	CUST.DATA.errFlg = "Y"
                	CUST.DATA.errMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                	GOTO ENDOFSCRIPT
		#}
		ENDIF

                BANCS.INPARAM.InputAmount  = CUST.DATA.remitAmt
                BANCS.INPARAM.FromCurrency = CUST.DATA.remitCrncy
                BANCS.INPARAM.ToCurrency   = "USD"
                BANCS.INPARAM.RateCode     = CUST.DATA.schmparmVal
                BANCS.INPARAM.Rate         = CDOUBLE("0.0")

                sv_u = urhk_B2k_ConvertAmount("")

                CUST.DATA.remitAmt = BANCS.OUTPARAM.OutputAmount
		PRINT(CUST.DATA.remitAmt)

        #}
        ENDIF



	#IF(CDOUBLE(CUST.DATA.remitAmt) <= CDOUBLE(CUST.DATA.limitAmt))THEN
	#{
	#	CUST.DATA.paysysId = "RTGS"
	#}
	#ELSE
	#{
	#	CUST.DATA.paysysId = "SWIFT"
	#}	
	#ENDIF	


ENDOFSCRIPT:
        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
	sv_u = urhk_SetOrbOut("paysysId|"+CUST.DATA.paysysId)

TRACE OFF
END-->
