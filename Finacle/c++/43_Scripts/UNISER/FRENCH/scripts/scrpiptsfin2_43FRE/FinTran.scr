		#print(sv_z)
		sv_s = "clglmt|"
		sv_s = sv_s + " SELECT r.user_clg_cr_lim"
		sv_s = sv_s + " FROM CUSTOM.CRCL r, TBAADM.UPR u"
		sv_s = sv_s + " WHERE r.role_id=u.role_id "
		#sv_s = sv_s + " AND u.user_id= ?SVAR"
		#sv_s = sv_s + " AND r.crncy_code = ?SVAR"
		sv_s = sv_s + " AND r.bank_id = u.home_bank_id"
