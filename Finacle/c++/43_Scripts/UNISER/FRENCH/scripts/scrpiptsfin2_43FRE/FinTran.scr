	# ======================================= #
	PRINT(BANCS.STDIN.mySolId)
	PRINT(BANCS.INPUT.AcctSolId)
	
	IF (BANCS.INPUT.Event == "TM_REQUEST_POST") THEN
	#{
		#sv_u = BANCS.STDIN.userId
		#sv_z = BANCS.INPUT.TranCurrency
		#sv_n = BANCS.STDIN.mySolId
		#sv_o = BANCS.INPUT.AcctSolId
		CUST.FINTRAN.userId = BANCS.STDIN.userId
		CUST.FINTRAN.tranCurrency = BANCS.INPUT.TranCurrency
		CUST.FINTRAN.mySolId = BANCS.STDIN.mySolId
		CUST.FINTRAN.acctSolId = BANCS.INPUT.AcctSolId
		#print(sv_z)
		#print(sv_r)
		IF (BANCS.INPUT.DrCrInd == "C") THEN
		#{
			IF (BANCS.INPUT.TranType == "T") THEN
			#{
				sv_s = "tranlmt,tranintsolmt|"
				sv_s = sv_s + " SELECT r.user_xfer_cr_lim,"
				sv_s = sv_s + " r.user_intersol_xfer_cr_limit"
				sv_s = sv_s + " FROM CUSTOM.CRCL r, TBAADM.UPR u"
				sv_s = sv_s + " WHERE r.role_id=u.role_id "
				sv_s = sv_s + " AND u.user_id=?SVAR"
				sv_s = sv_s + " AND r.crncy_code =?SVAR"
				sv_s = sv_s + " AND r.bank_id =u.home_bank_id"
				sv_s = sv_s + " AND r.bank_id =?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = CUST.FINTRAN.userId + "|" + CUST.FINTRAN.tranCurrency
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
				sv_d = urhk_dbSelectWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					CUST.CPARAM.tranlmt		 = BANCS.OUTPARAM.tranlmt
					CUST.CPARAM.tranintsolmt = BANCS.OUTPARAM.tranintsolmt
					CUST.CPARAM.tranAmt		 = BANCS.INPUT.TranAmt
					#sv_b = cdouble(BANCS.OUTPARAM.tranlmt)
					#sv_l = cdouble(BANCS.OUTPARAM.tranintsolmt)
					#sv_t = cdouble(BANCS.INPUT.TranAmt)
					PRINT(sv_t)
					IF (CUST.FINTRAN.mysoId == CUST.FINTRAN.acctSolId) THEN
					#{
						IF ( CDOUBLE(CUST.CPARAM.tranAmt) > CDOUBLE(CUST.CPARAM.tranlmt) ) THEN
						#{
							PRINT(BANCS.INPUT.ExceptionIgnoreFlg)
							PRINT(BANCS.INPUT.ValMode)
							BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
							BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
							#BANCS.INPARAM.ExceptionIgnoreFlg = "Y"
							BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
							sv_t=urhk_B2k_PutUserException("CE1")
							#sv_t=urhk_TBAF_ShowUserException("")
							# If the return value is 1 then it is an error. Otherwise the
							# exception has been raised successfully.
							IF (sv_t == 1) THEN
							#{
								BANCS.OUTPUT.successOrFailure = "F"
								BANCS.OUTPUT.ErrorDesc = "Credit Transfer Limit Exceeded for user. check table CRCL OR menu CPM."
								CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
								GOTO ENDOFSCRIPT
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					
					IF (CUST.FINTRAN.mysoId != CUST.FINTRAN.acctSolId) THEN
					#{
						PRINT(CUST.CPARAM.tranintsolmt)
						PRINT(CUST.CPARAM.tranAmt)
						IF ( CDOUBLE(CUST.CPARAM.tranAmt)> CDOUBLE(CUST.CPARAM.tranintsolmt) ) THEN
						#{
							PRINT(BANCS.INPUT.ExceptionIgnoreFlg)
							PRINT(BANCS.INPUT.ValMode)
							PRINT(CUST.CPARAM.tranAmt)
							BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
							BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
							BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
							sv_u=urhk_B2k_PutUserException("CE1")
							#sv_u=urhk_TBAF_ShowUserException("")
							IF (sv_u == 1) THEN
							#{
								BANCS.OUTPUT.successOrFailure = "F"
								BANCS.OUTPUT.ErrorDesc = "Credit Intersol Transfer Limit Exceeded for user.check table CRCL."
								CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
								GOTO ENDOFSCRIPT
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				
				IF (BANCS.INPUT.TranType == "T") THEN
				#{
					sv_s = "cashlmt,cashintsolmt|"
					sv_s = sv_s + " SELECT r.user_cash_cr_lim,"
					sv_s = sv_s + " r.user_intersol_cash_cr_limit"
					sv_s = sv_s + " FROM CUSTOM.CRCL r, TBAADM.UPR u"
					sv_s = sv_s + " WHERE r.role_id=u.role_id "
					sv_s = sv_s + " AND u.user_id=?SVAR"
					sv_s = sv_s + " AND r.crncy_code =?SVAR"
					sv_s = sv_s + " AND r.bank_id =u.home_bank_id"
					sv_s = sv_s + " AND r.bank_id =?SVAR"
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = ""
					BANCS.INPARAM.BINDVARS = CUST.FINTRAN.userId + "|" + CUST.FINTRAN.tranCurrency
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
					sv_d = urhk_dbSelectWithBind(sv_s)
					IF (sv_d == 0) THEN
					#{
						#sv_s = cdouble(BANCS.OUTPARAM.cashlmt)
						#sv_l = cdouble(BANCS.OUTPARAM.cashintsolmt)
						#sv_t = cdouble(BANCS.INPUT.TranAmt)
						CUST.FINTRAN.cashlmt = BANCS.OUTPARAM.cashlmt
						CUST.FINTRAN.cashintsolmt =	 BANCS.OUTPARAM.cashintsolmt
						CUST.FINTRAN.tranAmt = BANCS.INPUT.TranAmt
						#print(sv_t)
						IF (CUST.FINTRAN.mysoId == CUST.FINTRAN.acctSolId) THEN
						#{
							IF (CDOUBLE(CUST.FINTRAN.tranAmt) > CDOUBLE(CUST.FINTRAN.tranlmt) ) THEN
							#{
								PRINT(BANCS.INPUT.ExceptionIgnoreFlg)
								PRINT(BANCS.INPUT.ValMode)
								BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
								BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
								#BANCS.INPARAM.ExceptionIgnoreFlg = "Y"
								BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
								sv_u=urhk_B2k_PutUserException("CE0")
								#sv_u=urhk_TBAF_ShowUserException("")
								# If the return value is 1 then it is an error. Otherwise the
								# exception has been raised successfully.
								IF (sv_u == 1) THEN
								#{
									BANCS.OUTPUT.successOrFailure = "F"
									BANCS.OUTPUT.ErrorDesc = "Credit Cash Limit Exceeded for user.check table CRCL OR menu CPM."
									CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
									GOTO ENDOFSCRIPT
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
						
						IF (CUST.FINTRAN.mysoId != CUST.FINTRAN.acctSolId) THEN
						#{
							PRINT(CUST.FINTRAN.cashintsolmt)
							PRINT(CUST.FINTRAN.tranAmt)
							#print(sv_l)
							#print(sv_t)
							IF ( CDOUBLE(CUST.FINTRAN.tranAmt) > CDOUBLE(CUST.FINTRAN.cashintsolmt) ) THEN
							#{
								PRINT(BANCS.INPUT.ExceptionIgnoreFlg)
								PRINT(BANCS.INPUT.ValMode)
								BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
								BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
								BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
								sv_u=urhk_B2k_PutUserException("CE2")
								#sv_u=urhk_TBAF_ShowUserException("")
								IF (sv_u == 1) THEN
								#{
									BANCS.OUTPUT.successOrFailure = "F"
									BANCS.OUTPUT.ErrorDesc = "Credit Intersol cash Limit Exceeded for user.check table CRCL OR menu CPM."
									CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
									GOTO ENDOFSCRIPT
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				# ----------------------------------------------
				# To check that at least one part tran
				# belongs to initiating sol id. This check
				# is only done for non cash type of transactions
				# ----------------------------------------------
				
				CUST.FINTRAN.tranType = BANCS.INPUT.TranType
				IF( CUST.FINTRAN.tranType != "C") THEN
				#{
					CUST.FINTRAN.mySolId = BANCS.STDIN.mySolId
					CUST.FINTRAN.acctSolId = BANCS.INPUT.AcctSolId
					
					#if( sv_a == sv_b ) then
					
					# If the Class SOLCHK and field chksol do not exist ,
					# they are created in the preload script  .
					
					#	BANCS.SOLCHK.chksol = 1
					#endif
				#}
				ENDIF
				
				# -----------------------------------------
				# Hard Coded Error condition: Amount cannot
				# be greater than 100000.
				# -----------------------------------------
				IF (BANCS.INPUT.SchemeCode == CUST.CPARAM.schemeCode) THEN
				#{
					CUST.FINTRAN.tranAmt = BANCS.INPUT.TranAmt
					IF ( CDOUBLE(CUST.FINTRAN.tranAmt) > CUST.CPARAM.tranAmtLmt) THEN
					#{
						BANCS.OUTPUT.successOrFailure = "F"
						BANCS.OUTPUT.ErrorDesc="Part Tran Amount exceeded max-100000 in SBGEN Scheme."
						CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				#}
				ENDIF
				
				# ---------------------------------------------
				# Check for exception condition
				# If the amount is not multiple of 1000's
				# in SBGEN scheme code, then raise an exception
				# ---------------------------------------------
				IF (BANCS.INPUT.SchemeCode ==  CUST.CPARAM.schemeCode) THEN
				#{
					CUST.FINTRAN.tranAmt  = BANCS.INPUT.TranAmt
					sv_b = STRLEN(CUST.FINTRAN.tranAmt )
					sv_c = mid$(CUST.FINTRAN.tranAmt , sv_b - 6, sv_b)
					IF (sv_c != "000.00") THEN
					#{
						BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
						BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
						BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
						sv_u = urhk_FTS_RaiseException("000")
						IF (sv_u == 1) THEN
						#{
							# It is an error.
							BANCS.OUTPUT.successOrFailure = "F"
							BANCS.OUTPUT.ErrorDesc = BANCS.OUTPARAM.ErrorDesc
							CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
							GOTO ENDOFSCRIPT
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
				# Populate the output details.
				BANCS.OUTPUT.AddtlDetails = BANCS.INPUT.AddtlDetails
				# No need to proceed further
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	# ======================================= #
	#		TM Request Post mode - End	  	  #
