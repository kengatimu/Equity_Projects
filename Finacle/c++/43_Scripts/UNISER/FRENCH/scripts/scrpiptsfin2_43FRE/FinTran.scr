		#{
			CUST.FINTRAN.clglmt  = BANCS.OUTPARAM.clglmt
			CUST.FINTRAN.tranAmt = BANCS.INPUT.TranAmt
			IF ( CDOUBLE(CUST.FINTRAN.tranAmt) > CDOUBLE(CUST.FINTRAN.clglmt) ) THEN
			#{
				#BANCS.INPARAM.ExceptionIgnoreFlg = "N"
				BANCS.INPARAM.AcctNum = BANCS.INPUT.AcctNum
				sv_d = urhk_OWCLG_RaiseException("CE9")
				IF (sv_d == 1) THEN
				#{
					BANCS.OUTPUT.successOrFailure = "F"
					BANCS.OUTPUT.ErrorDesc = "Credit Clearing Limit Exceeded for user. Check table CRCL OR menu CPM"
					CUST.FINTRAN.errMsg=BANCS.OUTPUT.ErrorDesc
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
			#}
		ELSE
			#{
		#}
		ENDIF
		
		
		IF (BANCS.INPUT.SchemeCode ==CUST.CPARAM.schemeCode) THEN
		#{
			sv_a = CDOUBLE(BANCS.INPUT.TranAmt)
