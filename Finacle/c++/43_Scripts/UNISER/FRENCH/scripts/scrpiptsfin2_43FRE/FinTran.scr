		#		CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
		#		GOTO ENDOFSCRIPT
		#	#}
		#	ENDIF
		#}
		#ENDIF
		
		
		# -----------------------------
		# Hard Coded Error condition.
		# -----------------------------
		IF (BANCS.INPUT.SchemeCode == CUST.CPARAM.schemeCode) THEN
		#{
			CUST.FINTRAN.tranAmt = BANCS.INPUT.TranAmt
			IF ( CDOUBLE(CUST.FINTRAN.tranAmt) > CUST.CPARAM.tranAmtLmt) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.ErrorDesc = "Part TranAmt exceeded max-100000 in SB Scheme."
				CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		# ---------------------------------------------
		# If the amount is not multiple of 1000's
		# in SBGEN scheme code, then raise an exception
		# ---------------------------------------------
		IF (BANCS.INPUT.SchemeCode == CUST.CPARAM.schemeCode) THEN
		#{
			CUST.FINTRAN.tranAmt = BANCS.INPUT.TranAmt
			sv_b = STRLEN(CUST.FINTRAN.tranAmt)
			sv_c = mid$(CUST.FINTRAN.tranAmt, sv_b - 6, sv_b)
			IF (sv_c != "000.00") THEN
			#{
				BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
				BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
				BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
				sv_u = urhk_FTS_RaiseException("000")
				IF (sv_u == 1) THEN
				#{
					# It is an error.
					BANCS.OUTPUT.successOrFailure = "F"
					BANCS.OUTPUT.ErrorDesc = BANCS.OUTPARAM.ErrorDesc
					CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#--------------------------------------------------
		# If the tod amt changes at the time of posting ,
		# raise exception if the difference is more than
		# 100 .
		#--------------------------------------------------
		CUST.FINTRAN.instantTodAmt = BANCS.INPUT.InstantTodAmt
		IF ( CDOUBLE(CUST.FINTRAN.instantTodAmt) != 0.00 ) THEN
		#{
			PRINT(BANCS.INPUT.Event)
			PRINT("The Tod Amount")
			PRINT(BANCS.INPUT.InstantTodAmt)
			CUST.FINTRAN.acctNum = BANCS.INPUT.AcctNum
			sv_u = urhk_getAcctDetailsInRepository(CUST.FINTRAN.acctNum)
			IF (sv_u == 1) THEN
			#{
				BANCS.OUTPUT.OutString = "Account number is invalid"
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			CUST.FINTRAN.availableAmt = BANCS.OUTPARAM.AvailableAmt
			CUST.FINTRAN.fullEffAvailableAmt= BANCS.OUTPARAM.FullEffAvailableAmt
			IF ( CDOUBLE(CUST.FINTRAN.fullEffAvailableAmt) < 0 ) THEN
			#{
				CUST.FINTRAN.fullEffAvailableAmt=0
			#}
			ENDIF
			CUST.FINTRAN.fullAvailableAmt=BANCS.OUTPARAM.FullAvailableAmt
			sv_h = CDOUBLE(BANCS.INPUT.TranAmt)
			CUST.FINTRAN.todLvlIntFlg =	BANCS.INPUT.TodLvlIntFlg
			CUST.FINTRAN.tranAmt = BANCS.INPUT.TranAmt
			
			sv_i = CDOUBLE(CUST.FINTRAN.tranAmt) - CDOUBLE(CUST.FINTRAN.fullEffAvailableAmt)
			sv_j = CDOUBLE(CUST.FINTRAN.instantTodAmt) - 100
			sv_k = CDOUBLE(CUST.FINTRAN.instantTodAmt) + 100
			
			PRINT("Tod amount")
			PRINT(CUST.FINTRAN.instantTodAmt)
			PRINT("Your Min Limit")
			PRINT(sv_j)
			PRINT("Your Max Limit")
			PRINT(sv_k)
			IF ( ( sv_i < sv_j ) OR ( sv_i > sv_k ) ) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.ErrorDesc = "Error: TOD Amt. is different from that of specified value"
				CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	#========================================== #
	# 		Part Tran posting Mode - End #
	#========================================== #
	
	
	# Something is wrong. Invalid Entry mode.
	PRINT (BANCS.INPUT.Event)
	
	ENDOFSCRIPT:
		BANCS.OUTPUT.successOrFailure = "S"
		BANCS.OUTPUT.ErrorDesc = ""
		BANCS.OUTPUT.AddtlDetails = ""
		BANCS.OUTPUT.DeleteUAD = "Y"
		
		IF (FIELDEXISTS(BANCS.STDIN.menuId) == 1)THEN
		#{
			IF (BANCS.STDIN.menuId == "HTM") THEN
			#{
				IF (BANCS.INPUT.Event == "PTRAN_POSTING") THEN
				#{
					IF (BANCS.INPUT.TranParticulars2=="TCR") THEN
					#{
						#IF (BANCS.INPUT.DrCrInd=="C") THEN
						#CUST.FINTRAN.transaction_id ="transaction_deposit"
						#print(CUST.FINTRAN.transaction_id)
						#ENDIF
						IF (BANCS.INPUT.DrCrInd=="D") THEN
						#{
							CUST.FINTRAN.transaction_id ="transaction_dispense"
							PRINT(CUST.FINTRAN.transaction_id)
							CUST.FINTRAN.TranCurrency= BANCS.INPUT.TranCurrency
							PRINT(CUST.FINTRAN.TranCurrency)
							CUST.FINTRAN.TranAmt=BANCS.INPUT.TranAmt
							PRINT(CUST.FINTRAN.TranAmt)
							CALL("glory_outbound2.scr")
						#}
						ENDIF
						
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
			#{
		#}
		ENDIF

		##### SIEXE

#SELECT gam.sol_id,gam.foracid, gam.acct_name,dtd.PART_TRAN_TYPE from tbaadm.dtd ,tbaadm.gam,tbaadm.dth WHERE gam.acid=dtd.ACID 
#and dtd.tran_id=DTH.TRAN_ID and dtd.bank_id =gam.bank_id and dtd.bank_id =dth.bank_id and dtd.tran_date = dth.tran_date   and dtd.tran_id=LPAD('433',9)
#and dtd.tran_date='11-mar-2020'   and dtd.PART_TRAN_TYPE='C' and dtd.bank_id = '43' and dtd.TRAN_SUB_TYPE='SI' and dtd.del_flg='N'

		##### SIEXE
		IF (BANCS.INPUT.EventType=="SIEXE") THEN
			
			IF (BANCS.INPUT.TranSubType=="SI") THEN
				IF (BANCS.INPUT.DrCrInd=="C") THEN
					sv_h = mid$(BANCS.STDIN.BODDate,0,10)
					sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
					BANCS.INPARAM.BINDVARS =  sv_h
					sv_d = urhk_dbSelectWithBind(sv_s)
					##print(sv_d)
					IF (sv_d =="0") THEN
						CUST.FINTRAN.getboddate = BANCS.OUTPARAM.getboddate
						print(CUST.FINTRAN.getboddate)
					ENDIF
					sv_s = "sol_id, foracid,acct_name,part_tran_type |"
					sv_s = sv_s + " SELECT gam.sol_id,gam.foracid, gam.acct_name,dtd.PART_TRAN_TYPE from tbaadm.dtd ,tbaadm.gam,tbaadm.dth WHERE gam.acid=dtd.ACID "
					sv_s = sv_s + " and dtd.tran_id=DTH.TRAN_ID and dtd.bank_id =gam.bank_id and dtd.bank_id =dth.bank_id and dtd.tran_date = dth.tran_date   and dtd.tran_id=LPAD(?SVAR,9) "
					sv_s = sv_s + " and dtd.PART_TRAN_TYPE='C' and dtd.bank_id = ?SVAR and dtd.TRAN_SUB_TYPE='SI' and dtd.del_flg='N' AND dtd.TRAN_DATE = ?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS =  BANCS.INPUT.TranId + "|" +  BANCS.STDIN.contextBankId + "|" + CUST.FINTRAN.getboddate 
					PRINT (BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUST.FINTRAN.sol_id = BANCS.OUTPARAM.sol_id
						PRINT(CUST.FINTRAN.sol_id)
						CUST.FINTRAN.foracid = BANCS.OUTPARAM.foracid
						PRINT(CUST.FINTRAN.foracid)
						CUST.FINTRAN.acct_name = BANCS.OUTPARAM.acct_name
						PRINT(CUST.FINTRAN.acct_name)
						CUST.FINTRAN.part_tran_type = BANCS.OUTPARAM.part_tran_type
						PRINT(CUST.FINTRAN.part_tran_type)

						#####
							CUST.FINTRAN.narratdebitside="Virement permanent, De "
							print(CUST.FINTRAN.narratdebitside)
							CUST.FINTRAN.narratdebitside= CUST.FINTRAN.narratdebitside +""+ CUST.FINTRAN.foracid
							print(CUST.FINTRAN.narratdebitside)
							sv_s = "UPDATE TBAADM.DTD SET TRAN_PARTICULAR = ?SVAR WHERE TRAN_ID = LPAD(?SVAR,9)"
							sv_s = sv_s + " AND TRAN_DATE = ?SVAR AND BANK_ID = ?SVAR  and PART_TRAN_TYPE='D' and rownum<2 "
							print(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.FINTRAN.narratdebitside + "|" + BANCS.INPUT.TranId + "|" + CUST.FINTRAN.getboddate 
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_w = urhk_dbSQLWithBind(sv_s)
							print(sv_w)
							IF(sv_w != 0)THEN
								sv_w = urhk_dbSQLWithBind(sv_s)
								print(sv_w)
								IF(sv_w != 0)THEN
								ENDIF
							ENDIF
						#####
					#}
					ENDIF
				ELSE
					sv_h = mid$(BANCS.STDIN.BODDate,0,10)
					sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
					BANCS.INPARAM.BINDVARS =  sv_h
					sv_d = urhk_dbSelectWithBind(sv_s)
					##print(sv_d)
					IF (sv_d =="0") THEN
						CUST.FINTRAN.getboddate = BANCS.OUTPARAM.getboddate
						print(CUST.FINTRAN.getboddate)
					ENDIF
					sv_s = "sol_id, foracid,acct_name,part_tran_type |"
					sv_s = sv_s + " SELECT gam.sol_id,gam.foracid, gam.acct_name,dtd.PART_TRAN_TYPE from tbaadm.dtd ,tbaadm.gam,tbaadm.dth WHERE gam.acid=dtd.ACID "
					sv_s = sv_s + " and dtd.tran_id=DTH.TRAN_ID and dtd.bank_id =gam.bank_id and dtd.bank_id =dth.bank_id and dtd.tran_date = dth.tran_date   and dtd.tran_id=LPAD(?SVAR,9) "
					sv_s = sv_s + " and dtd.PART_TRAN_TYPE='D' and dtd.bank_id = ?SVAR and dtd.TRAN_SUB_TYPE='SI' and dtd.del_flg='N' AND dtd.TRAN_DATE = ?SVAR "
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS =  BANCS.INPUT.TranId + "|" +  BANCS.STDIN.contextBankId + "|" + CUST.FINTRAN.getboddate 
					PRINT (BANCS.INPARAM.BINDVARS)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d == 0) THEN
					#{
						CUST.FINTRAN.sol_id = BANCS.OUTPARAM.sol_id
						PRINT(CUST.FINTRAN.sol_id)
						CUST.FINTRAN.foracid = BANCS.OUTPARAM.foracid
						PRINT(CUST.FINTRAN.foracid)
						CUST.FINTRAN.acct_name = BANCS.OUTPARAM.acct_name
						PRINT(CUST.FINTRAN.acct_name)
						CUST.FINTRAN.part_tran_type = BANCS.OUTPARAM.part_tran_type
						PRINT(CUST.FINTRAN.part_tran_type)

						#####
							CUST.FINTRAN.narratdebitside="Virement permanent, De "
							print(CUST.FINTRAN.narratdebitside)
							CUST.FINTRAN.narratdebitside= CUST.FINTRAN.narratdebitside +""+ CUST.FINTRAN.foracid
							print(CUST.FINTRAN.narratdebitside)
							sv_s = "UPDATE TBAADM.DTD SET TRAN_PARTICULAR = ?SVAR WHERE TRAN_ID = LPAD(?SVAR,9)"
							sv_s = sv_s + " AND TRAN_DATE = ?SVAR AND BANK_ID = ?SVAR  and PART_TRAN_TYPE='C' and rownum<2 "
							print(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.FINTRAN.narratdebitside + "|" + BANCS.INPUT.TranId + "|" + CUST.FINTRAN.getboddate 
							BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
							print(BANCS.INPARAM.BINDVARS)
							sv_w = urhk_dbSQLWithBind(sv_s)
							print(sv_w)
							IF(sv_w != 0)THEN
								sv_w = urhk_dbSQLWithBind(sv_s)
								print(sv_w)
								IF(sv_w != 0)THEN
								ENDIF
							ENDIF
						#####
					#}
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		IF(CUST.FINTRAN.errMsg != "") THEN
		#{
			sv_u = SYSTEM("echo '"+CUST.FINTRAN.errMsg+"' >>fintran.log")
		#}
		ENDIF
		
		EXITSCRIPT
		TRACE OFF
