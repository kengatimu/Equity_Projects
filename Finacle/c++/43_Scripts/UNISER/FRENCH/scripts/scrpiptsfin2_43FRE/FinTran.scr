	# ======================================= #
	IF (BANCS.INPUT.Event == "TM_ENTRY") THEN
	#{
		# -----------------------------------------
		# Hard Coded Error condition: Amount cannot
		# be greater than 100000.
		# -----------------------------------------
		IF (BANCS.INPUT.SchemeCode == CUST.CPARAM.schemeCode) THEN
		#{
			CUST.FINTRAN.tranAmt = CDOUBLE(BANCS.INPUT.TranAmt)
			IF (CUST.FINTRAN.tranAmt > CUST.CPARAM.tranAmtLmt) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.ErrorDesc="Part Tran Amount exceeded max-100000 in SBGEN Scheme."
				CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		# -----------------------------------------
		# Hard Coded Error condition: If RPC_FLG is
		# Y then can not enter transaction through
		# TM
		# -----------------------------------------
		IF (BANCS.STDIN.onlineOrBatch == CUST.CPARAM.onlineBatch) THEN
		#{
			IF (BANCS.INPUT.RPCAccountFlag == "Y") THEN
			#{
				BANCS.OUTPUT.successOrFailure = "S"
				sv_u = urhk_SetOrbOut("Warning: Transaction to a Running Packing Credit Account.")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		# ---------------------------------------------
		# Check for exception condition
		# If the amount is not multiple of 1000's
		# in SBGEN scheme code, then raise an exception
		# ---------------------------------------------
		IF (BANCS.INPUT.SchemeCode == CUST.CPARAM.schemeCode) THEN
		#{
			CUST.FINTRAN.tranAmt = BANCS.INPUT.TranAmt
			sv_b = STRLEN(CUST.FINTRAN.tranAmt)
			sv_c = mid$(CUST.FINTRAN.tranAmt, sv_b - 6, sv_b)
			IF (sv_c != "000.00") THEN
			#{
				BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
				BANCS.INPARAM.DrCrInd = BANCS.INPUT.DrCrInd
				BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
				sv_u = urhk_FTS_RaiseException("000")
				IF (sv_u == 1) THEN
				#{
					# It is an error.
					BANCS.OUTPUT.successOrFailure = "F"
					BANCS.OUTPUT.ErrorDesc = BANCS.OUTPARAM.ErrorDesc
					CUST.FINTRAN.errMsg = BANCS.OUTPUT.ErrorDesc
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		# -------------------------------------
		# Now accept additional data by calling
		# parameter acceptance form
		# -------------------------------------
		
		#  ---------------------------------
		#  Accept Screen literals and length
		#  ---------------------------------
	#}
	ENDIF
	
	# ======================================= #
	#			TM Entry mode - End		  	  #
