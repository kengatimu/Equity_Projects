	IF (BANCS.INPUT.Event == "PTRAN_POSTING") THEN
	#{
		# ----------------------------------------
		# TO check that at least one ptran belongs
		# to initiating sol id.This check is only
		# done for non cash type of transactions.
		# ----------------------------------------
		
		CUST.FINTRAN.tranType = BANCS.INPUT.TranType
		#sv_x = CLASSEXISTS("BANCS", "SOLCHK")
		#IF((sv_x != 0) AND (sv_g != "C")) then
		#{
		#	sv_e = BANCS.SOLCHK.chksol
		#	IF (sv_e != 1) then
		#	#{
		#		BANCS.OUTPUT.ErrorDesc = "At Least one part tran should belong to Initiating Sol Id "
