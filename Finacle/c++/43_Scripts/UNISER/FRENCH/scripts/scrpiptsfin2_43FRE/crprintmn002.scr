<--START
TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
        	CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
        	CREATECLASS ("CUST","DATA",5)
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","RATE") == 0) THEN
	#{
        	CREATECLASS ("CUST","RATE",5)
	#}
	ENDIF

        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.acctNum = " "
	CUST.DATA.funcCode = " "
	CUST.DATA.recCount = "0"

        
        IF(FIELDEXISTS(BANCS.INPUT.funcCode))THEN
        #{
                IF(BANCS.INPUT.funcCode !="")THEN
                #{
                        CUST.DATA.funcCode = TOUPPER(TRIM(BANCS.INPUT.funcCode))
                        PRINT(CUST.DATA.funcCode)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Function code not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Function Code not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF
		
		IF(CUST.DATA.funcCode == "TCPI")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.acctNo))THEN
        #{
                IF(BANCS.INPUT.acctNo !="")THEN
                #{
                        CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNo))
                        PRINT(CUST.DATA.acctNum)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Account Number not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Account Number not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	IF(CUST.DATA.funcCode != "CHQ")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

#	sv_s = "recCount|SELECT COUNT(1) FROM CUSTOM.CUSTOM_CBR WHERE BANK_ID=?SVAR AND FORACID=?SVAR AND TO_DATE(LCHG_TIME,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY') AND REQ_STATUS='U'"
	sv_s = "recCount|SELECT COUNT(1) FROM TBAADM.CBT WHERE BANK_ID=?SVAR AND TO_DATE(CHQ_ISSU_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY') AND ACID = (SELECT ACID " 
	sv_s =sv_s + "FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR)"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ MID$(BANCS.STDIN.BODDate,0,10) +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum 
        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
		CUST.DATA.recCount = BANCS.OUTPARAM.recCount
	#}
	ELSE
	#{
                 CUST.DATA.errFlg = "Y"
                 CUST.DATA.errMsg = "Database Error"
                 GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF(CUST.DATA.recCount == "0")THEN
	#{
                 CUST.DATA.errFlg = "Y"
                 CUST.DATA.errMsg = "No Cheques is issued for the account: "+CUST.DATA.acctNum
                 GOTO ENDOFSCRIPT
        #}
        ENDIF
	GOTO ENDOFSCRIPT
	
	TCPI:
	
	IF(CUST.DATA.funcCode == "TCPI")THEN
	#{
		sv_s = "cashcount|SELECT count(1) "
		sv_s = sv_s + " FROM tbaadm.GEC,tbaadm.GAM,tbaadm.cnc WHERE 1 = 1 AND GEC.emp_id= ?SVAR AND GAM.ACCT_CRNCY_CODE=GEC.crncy_code AND "
		sv_s = sv_s + " GEC.del_flg != 'Y' AND GAM.bacid=GEC.emp_cash_acct AND GAM.sol_id=GEC.sol_id and gam.del_flg='N' and gam.entity_cre_flg='Y' and "
		sv_s = sv_s + " gam.acct_cls_flg='N' AND GEC.sol_id = ?SVAR  AND GEC.bank_id = ?SVAR  AND GAM.bank_id = ?SVAR  and cnc.bank_id=?SVAR and cnc.bank_id=?SVAR "
		sv_s = sv_s + " and cnc.crncy_code=gam.acct_crncy_code ORDER BY GEC.CRNCY_CODE"

		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.EmployeeId + "|" + BANCS.STDIN.mySolId + "|" +BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" +BANCS.STDIN.contextBankId + "|" +BANCS.STDIN.contextBankId 
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)

		IF(sv_d == 0)THEN
		#{
			CUST.DATA.cashcount = BANCS.OUTPARAM.cashcount
		#}
		ELSE
		#{
			CUST.DATA.errFlg = "Y"
			 CUST.DATA.errMsg = "Failed to fetch the Account details"
			 GOTO ENDOFSCRIPT
			
		#}
		ENDIF

		IF(CUST.DATA.cashcount == "0")THEN
		#{
			
			CUST.DATA.errFlg = "Y"
			CUST.DATA.errMsg = " Employee -"+BANCS.STDIN.EmployeeId +" has no teller account data"
			GOTO ENDOFSCRIPT
		#}
		ENDIF


ENDOFSCRIPT:
        #sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
	IF(CUST.DATA.errFlg == "Y")THEN
	#{
		BANCS.OUTPUT.sucFailFlg = urhk_SetOrbOut("SuccessOrFailure|N")
		sv_u = urhk_SetOrbErr("errMsg|"+CUST.DATA.errMsg)
	#}
	ELSE
	#{
		BANCS.OUTPUT.sucFailFlg = urhk_SetOrbOut("SuccessOrFailure|Y")
	#}
	ENDIF


TRACE OFF
END-->
