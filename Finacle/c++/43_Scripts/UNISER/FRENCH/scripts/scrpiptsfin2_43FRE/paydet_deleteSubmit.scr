
<--START
	# Script body goes here
	TRACE ON
	

	IF ((CUST.DATA.Ecstranrefnum!= "") AND (CUST.DATA.paysysid!= "") AND (CUST.DATA.trantype!= "")) THEN
	#{
		
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.Ecstranrefnum+"|"+ CUST.DATA.paysysid+"|"+ CUST.DATA.trantype+"|"+ BANCS.STDIN.contextBankId 
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_a = "count|select count(*) from custom.ECS_TRAN where Ecstranrefnum = ?SVAR AND paysysid = ?SVAR AND trantype=?SVAR"
		sv_a = sv_a + " AND bank_id = ?SVAR AND DEL_FLG = 'N' and entity_cre_flg='N' "
		PRINT(sv_a)
		
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF (sv_b == 0) THEN
		#{
			CUST.DATA.tsCount = BANCS.OUTPARAM.count
			PRINT(CUST.DATA.tsCount)
	ELSE
		#{
		CUST.DATA.errMsg = "Backend Error."
		sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
		
	
	CUST.DATA.temp = (CINT(CUST.DATA.tsCount) + 1)
	sv_a =""
	sv_a = "UPDATE CUSTOM.ECS_TRAN SET"
	sv_a = sv_a + " LCHG_USER_ID = ?SVAR,LCHG_TIME = SYSDATE,DEL_FLG = 'Y' "
	sv_a = sv_a + "  WHERE Ecstranrefnum =?SVAR "
	sv_a = sv_a + "  and entity_cre_flg='N' and del_flg='N' "
		PRINT(sv_a)
	print(CUST.DATA.Ecstranrefnum)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ CUST.DATA.Ecstranrefnum 
	
	sv_b = urhk_dbSQLWithBind(sv_a)
	PRINT(sv_b)
	IF (sv_b == 0) THEN
	#{
		sv_b = urhk_dbSQLWithBind("COMMIT")
		#}
	ELSE
		#{
		sv_b = urhk_dbSQLWithBind("ROLLBACK")

		CUST.DATA.errMsg = "Backend Error."
		sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
		print(CUST.DATA.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.DATA.errMsg == "") THEN
		#{
			CUST.DATA.sucessMsg = "Records Deleted successfully"
		#}
		ENDIF
		EXITSCRIPT
END-->
