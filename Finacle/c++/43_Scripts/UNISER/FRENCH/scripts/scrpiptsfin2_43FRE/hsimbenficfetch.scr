<--START
	# Script body goes here
	TRACE ON
	IF (REPEXISTS("EQT") == 0) THEN
	#{
		CREATEREP("EQT")
	#}
	ENDIF
	
	IF (CLASSEXISTS("EQT","SICHRG") == 0) THEN
	#{
		CREATECLASS("EQT","SICHRG",5)
	#}
	ENDIF
	
	EQT.SICHRG.errFlg = "N"
	EQT.SICHRG.errMsg = " "
	EQT.SICHRG.addrs1 = " "
	EQT.SICHRG.addrs2 = " "
	EQT.SICHRG.addrs3 = " "
	EQT.SICHRG.cntryCode = " "
	EQT.SICHRG.bankCode = " "
	EQT.SICHRG.branchCode = " "
	
        IF(FIELDEXISTS(BANCS.INPUT.bankCode))THEN
        #{
                IF(TRIM(BANCS.INPUT.bankCode) != "")THEN
                #{
                        EQT.SICHRG.bankCode = TOUPPER(TRIM(BANCS.INPUT.bankCode))
                        print(EQT.SICHRG.bankCode)
                #}
                ENDIF
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.branchCode))THEN
        #{
                IF(TRIM(BANCS.INPUT.branchCode) != "")THEN
                #{
                        EQT.SICHRG.branchCode = TOUPPER(TRIM(BANCS.INPUT.branchCode))
                        print(EQT.SICHRG.branchCode)
                #}
                ENDIF
        #}
        ENDIF

	
	#------------------------------------------------#
	sv_s = "addrs1,addrs2,addrs3,cntryCode|select br_addr_1,br_addr_2,br_addr_3,cntry_code from tbaadm.bct where bank_id=?SVAR and bank_code=?SVAR and br_code=?SVAR"

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ EQT.SICHRG.bankCode +"|"+ EQT.SICHRG.branchCode
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		EQT.SICHRG.addrs1 = BANCS.OUTPARAM.addrs1
		PRINT(EQT.SICHRG.addrs1)
		EQT.SICHRG.addrs2 = BANCS.OUTPARAM.addrs2
		PRINT(EQT.SICHRG.addrs2)
		EQT.SICHRG.addrs3 = BANCS.OUTPARAM.addrs3
		PRINT(EQT.SICHRG.addrs3)
		EQT.SICHRG.cntryCode = BANCS.OUTPARAM.cntryCode
		PRINT(EQT.SICHRG.cntryCode)
		#}
	ELSE
		#{
		EQT.SICHRG.errFlg = "Y"
		EQT.SICHRG.errMsg = "Invalid beneficiary bank or branch code"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		print(EQT.SICHRG.errMsg)
		sv_u = urhk_SetOrbOut("errFlg|"+EQT.SICHRG.errFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("errMsg|"+EQT.SICHRG.errMsg)
		PRINT(sv_u)

                IF(TRIM(EQT.SICHRG.addrs1) == "")THEN
                #{
                        EQT.SICHRG.addrs1 = " "
                #}
                ENDIF

                IF(TRIM(EQT.SICHRG.addrs2) == "")THEN
                #{
                        EQT.SICHRG.addrs2 = " "
                #}
                ENDIF

                IF(TRIM(EQT.SICHRG.addrs3) == "")THEN
                #{
                        EQT.SICHRG.addrs3 = " "
                #}
                ENDIF

                IF(TRIM(EQT.SICHRG.cntryCode) == "")THEN
                #{
                        EQT.SICHRG.cntryCode = " "
                #}
                ENDIF

		sv_u = urhk_SetOrbOut("addrs1|"+EQT.SICHRG.addrs1)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("addrs2|"+EQT.SICHRG.addrs2)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("addrs3|"+EQT.SICHRG.addrs3)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("cntryCode|"+EQT.SICHRG.cntryCode)
		PRINT(sv_u)
		
TRACE OFF
END-->
