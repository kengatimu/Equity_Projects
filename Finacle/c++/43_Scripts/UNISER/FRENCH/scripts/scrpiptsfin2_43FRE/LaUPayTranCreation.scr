                if (MTT.InputDetails.FuncCode == "R") then
                MTT.PartTranDetails.Particulars = "Reversal of Crediting Rebate Benefit Account: " + MTT.InputDetails.RebateBenefitAccount
				MTT.PartTranDetails.sysPartTranCode = "PTRN03877" 
            #   print(MTT.PartTranDetails.Account)
                MTT.PartTranDetails.RefAmount       = -sv_x
