	endif

# PartTran for margin money acct if a/c is forward ijarsh type in construction period.
    sv_q=CDOUBLE(MTT.InputDetails.LoanAcctTranAmt)
    if ((MTT.InputDetails.ForwardIjarahInCP == "Y") AND (sv_q != 0)) then
    #{

        MTT.PartTranDetails.RefAmount       = sv_q
        MTT.PartTranDetails.Account         = MTT.InputDetails.MarginMnyAccnt
        MTT.PartTranDetails.ValueDate       = MTT.InputDetails.ValueDate
        MTT.PartTranDetails.RefCurrency     = MTT.InputDetails.LoanAccountCrncyCode
        MTT.PartTranDetails.RateCode        = ""
        MTT.PartTranDetails.TreaRefNum      = ""

        # Call to common script to modify tran particulars if script is present
        MTT.PartTranDetails.ScriptEventType = "LAPAY"
        sv_m=urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
        if (sv_m==0) then
            call("getMTTTranPart.scr")
        endif
        MTT.PartTranDetails.Consolidate     = "N"
        MTT.PartTranDetails.EntryUserId     = MTT.InputDetails.EntryUserId
        MTT.PartTranDetails.EntryTime       = MTT.InputDetails.EntryTime
        MTT.PartTranDetails.Particulars     = MTT.InputDetails.LoanAccount + " : Margin Money Acct Credit"
        MTT.PartTranDetails.Remarks         = "Margin Money Acct Credit"
		MTT.PartTranDetails.sysPartTranCode = "PTRN03778"

        MTT.PartTranDetails.ACPARTB2kType   = "ACCNT"
        MTT.PartTranDetails.ACPARTB2kId     = MTT.InputDetails.LoanAccount
        if (MTT.InputDetails.FuncCode == "R") then
        #{
            MTT.PartTranDetails.Particulars =MTT.InputDetails.LoanAccount + " : Margin Money Acct Debit"
            MTT.PartTranDetails.Remarks         = "Margin Money Acct Debit"
			MTT.PartTranDetails.sysPartTranCode = "PTRN03634"
        #}
        endif
        MTT.PartTranDetails.TranIdentifier    ="LoanRecovery"
        MTT.PartTranDetails.PTranBusinessType ="MARMONREDIT"
        sv_r = urhk_MTTS_DefinePartTran("MARGIN_MONEY_ACCT_CREDIT")
        if (sv_r == 1) then
            GOTO GET_NEXT_REC
        endif
    #}
    endif

#----------------------------------------------------------
# Credit the Charges.
#----------------------------------------------------------

	sv_r = urhk_getLaPaymentFeeTranDetails(MTT.InputDetails.LoanAccount)
		
	#If the Collection Currency & Charge Currency are different then Cr & Dr part 
	#trans to the Parking account will have to be done for the total amount used for
	#Fees collection ie sum of feeAdjustment & prePaymentAdjustment Amts	

	if(sv_r < 1) then 
	#{
		#-----------------------------------------------------------
		# Charges Parking Acct Credit			 	     				 
		#-----------------------------------------------------------

		if (MTT.InputDetails.FuncCode == "R") then 
		sv_t = CDOUBLE(MTT.InputDetails.RevFeeAdj)
		endif

		if ((MTT.InputDetails.FeeCalcCrncy != MTT.InputDetails.LoanAccountCrncyCode) AND (MTT.InputDetails.FeeCalcCrncy != "" ) AND (sv_m != 0 )) then 
		#{
			MTT.PartTranDetails.Account = MTT.InputDetails.FeeParkAcct
			MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
			if (MTT.InputDetails.FuncCode != "R") then 
				MTT.PartTranDetails.RefAmount = sv_m
				MTT.PartTranDetails.sysPartTranCode = "PTRN01782"
#	print(MTT.PartTranDetails.RefAmount)
			else 
				MTT.PartTranDetails.RefAmount = -sv_t
				MTT.PartTranDetails.sysPartTranCode = "PTRN01783"
#	print(MTT.PartTranDetails.RefAmount)
			endif
			MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAccountCrncyCode
            #MSG0309190 = "Parking Account Credit for Loan Fee Collection"
            sv_u = urhk_getMSGCodeErrDesc("MSG0309190")
            if(sv_u == 0) then
            MTT.PartTranDetails.Particulars = BANCS.OUTPARAM.errDesc
            endif
			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LAPAY"
			sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			if (sv_z == 0) then
				call("getMTTTranPart.scr")
			endif
		
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
			MTT.PartTranDetails.RateCode=MTT.InputDetails.ChargeRateCode
			MTT.PartTranDetails.Rate=MTT.InputDetails.ChargeRate
			MTT.PartTranDetails.TreaRate = MTT.InputDetails.ChargeTreaRate
			MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.TreaRefNum
			MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
			MTT.PartTranDetails.PTranBusinessType = "FEECOLL"
			MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId 
            MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime 

			sv_z = urhk_MTTS_DefineLoanPartTran("FEEPARKCR")	
			if (sv_z == 1) then
			   GOTO GET_NEXT_REC
			endif
			
			#Calling B2K Convert Amt to find out how much to Debit the Parking Acct
			#and the subsequent Charge Credits .

			#-----------------------------------------------------------
			#Charges Parking Acct Debit 			 	        				 
			#-----------------------------------------------------------

			MTT.PartTranDetails.Account=MTT.InputDetails.FeeParkAcct
			MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
