		MTT.PartTranDetails.Particulars = "UNSCH Loan Account Payments From : " + MTT.InputDetails.LoanAccount
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAPAY"
		sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_z == 0) then
			call("getMTTTranPart.scr")
		endif
	
		MTT.PartTranDetails.RefAmount = sv_q
        #if(MTT.InputDetails.IntRouteFlg == "O") then
        #    MTT.PartTranDetails.RefAmount = sv_q
        #else
        #   MTT.PartTranDetails.RefAmount = sv_q+sv_u
        #endif
#	print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
		MTT.PartTranDetails.PartTranIdentifier = "LA_CR"
		MTT.PartTranDetails.PTranBusinessType = "RECOV"
		MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId 
		MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime 
		MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
		MTT.PartTranDetails.Remarks = MTT.InputDetails.TranRemarks
		MTT.PartTranDetails.Refnum = MTT.InputDetails.ReferenceNumber
		MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.LoanAccount
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.DefaultCollecFlowId
		MTT.PartTranDetails.sysPartTranCode = "PTRN01780"

		if ((sv_q < 0) AND (MTT.InputDetails.FuncCode == "M")) then
			MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.TransferFlowId
		endif

		MTT.LAAddnlDetails.OriginOfTran = "LAPAY"
		MTT.LAAddnlDetails.TypeOfDemand = "A"	

		if (MTT.InputDetails.FuncCode == "R") then
		#{
			#MTT.PartTranDetails.RefAmount = sv_q
			MTT.PartTranDetails.sysPartTranCode ="PTRN01781"
            #MSG0309176 = "Loan Recovery Reversal From :" + MTT.InputDetails.SourceDebitAccount
            sv_o=urhk_getMSGCodeErrDesc("MSG0309176")
            if(sv_o == 0) then
            sv_s = BANCS.OUTPARAM.errDesc
            endif
            MTT.PartTranDetails.Particulars = sv_s + MTT.InputDetails.SourceDebitAccount
			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LAPAY"
			sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			if (sv_z == 0) then
				call("getMTTTranPart.scr")
			endif
		
			MTT.LAAddnlDetails.ReversalTranId = MTT.InputDetails.RevTranId	
			MTT.LAAddnlDetails.ReversalTranDate = MTT.InputDetails.RevTranDate	
			MTT.LAAddnlDetails.ReversalPtranSrlNum = MTT.InputDetails.RevLoanAcctPTranSrlNum	
			MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.RevLoanAcctFlowId	
			MTT.LAAddnlDetails.PrincipalAmt	= "0"
			MTT.LAAddnlDetails.InterestAmt	= "0"
			MTT.LAAddnlDetails.BankChrgAmt	= "0"
			MTT.LAAddnlDetails.OtherChrgAmt	= "0"
		#}
		endif

		MTT.LAAddnlDetails.AdvancePaymentFlg="Y"   
		MTT.LAAddnlDetails.oFlowAdjFlg = "L" 

		if (  MTT.InputDetails.collIntTillValueDateFlg == "Y") then
			MTT.LAAddnlDetails.intCollOnPrepayFlg = "Y"
		else
			MTT.LAAddnlDetails.intCollOnPrepayFlg = "N"
		endif
		if(MTT.InputDetails.prepaymentType == "M") then
			MTT.LAAddnlDetails.prepayTypeFlg = "M"
		else
			MTT.LAAddnlDetails.prepayTypeFlg = "V"
		endif
		
		sv_r = urhk_MTTS_DefineLoanPartTran("LOAN_ACCT_CR")								
		if (sv_r == 1) then
			GOTO GET_NEXT_REC
		endif
