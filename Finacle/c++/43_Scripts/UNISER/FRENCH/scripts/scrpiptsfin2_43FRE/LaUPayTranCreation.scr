#----------------------------------------------------------------------------
#       SCRIPT FOR Unschedule Payment for Loans.
#
# Srl No     Modified Date    Author          Modification    Version
# ------     -------------    -------         --------------   --------
# 001        08-NOV-04        Nisha        	  Original         1.0
#----------------------------------------------------------------------------
#										Inputs To Script
#----------------------------------------------------------------------------
#		MTT.InputDetails.LoanAccount			Loan AccountNumber  
#		MTT.InputDetails.LoanPaymentAccount		Loan Payment account
#		MTT.InputDetails.LoanInterestAccount	Loan Interest Account
#		MTT.InputDetails.IntSuspenceAccount 	Interest Suspence Account
#		MTT.InputDetails.ExcessCreditAccount 	Excess Credit Account
#		MTT.InputDetails.SourceDebitAccount 	Source Debit Account
#		MTT.InputDetails.OAPTranId 				Tran Id (valid in case the SourceDebitAccount is of
#												OAP schme type only)
#		MTT.InputDetails.OAPTranDate 			Tran Date (valid in case the SourceDebitAccount is 
#												of OAP schme type only)
#		MTT.InputDetails.OAPPTranSrlNum			Part Tran Serial Number (valid in case the 
#												SourceDebitAccount is of OAP schme type only)
#		MTT.InputDetails.LoanAccountCrncyCode	Loan Account Currency Code   
#		MTT.InputDetails.CifId					Loan Account Customer CIF Id
#		MTT.InputDetails.PrePaymentFeeAdj		Pre-Payment Fee to be e    
#		MTT.InputDetails.SourceAcctTranAmt		Amount to be Debited from Source Account
#		MTT.InputDetails.LoanAcctTranAmt		Amount to be Credited to Loan Account
#		MTT.InputDetails.ReferenceNumber		Reference Number 
#		MTT.InputDetails.TranRemarks			Transaction Remarks
#		MTT.InputDetails.ValueDate				Value Date of transaction
#		MTT.InputDetails.IntRouteFlg			Flag indicating whether Interest is routed through 
#												Loan Account("L") or Loan Interest Account("O")
#		MTT.InputDetails.ChrgRouteFlg			Flag indicating whether Charge is routed through
#												Loan Account("L") or Loan Interest Account("O")
#		MTT.InputDetails.DefaultCollecFlowId	Default collection Flow-Id
#		MTT.InputDetails.FuncCode				Function Code of LAPAY menu


#-----------------------------------------------------------
#  The Script starts here 							
#-----------------------------------------------------------

<--start
#trace on
sv_r = CDOUBLE("0")      
sv_r = urhk_MTTS_PopulateInputDetails("")
if(sv_r == 1) then
	exitscript	
endif

MTT.TranDetails.TranDate="0"
MTT.TranDetails.TranType=MTT.InputDetails.tranType
if (MTT.InputDetails.tranType == "C" ) then 
	if (MTT.InputDetails.FuncCode != "R") then 
		MTT.TranDetails.TranSubType = "CR" 
	else 
	   MTT.TranDetails.TranSubType = "CP"
	endif
else 
MTT.TranDetails.TranSubType="BI"							
endif 
#MSG0008815="Loan Recovery"
sv_b = urhk_getMSGCodeErrDesc("MSG0008815")
if(sv_b == 0) then
MTT.TranDetails.Remarks= BANCS.OUTPARAM.errDesc
endif
MTT.TranDetails.IgnoreExcp="N"								
MTT.TranDetails.Consolidate="Y"						
MTT.TranDetails.PrintAdviceInd="Y"							
MTT.TranDetails.ReversalFlg="N"				
# newly added the tranId while verification
MTT.TranDetails.TranID = MTT.InputDetails.tranId 
#MTT.TranDetails.ReversalDate=MTT.InputDetails.reversalDate	
MTT.TranDetails.sysTranCode="LOANAA012"

sv_r = urhk_MTTS_DefineTransaction("LoanRecovery")
if(sv_r == 1) then
	MTT.Error.Description="Transaction definition could not be created"
	sv_r = urhk_MTTS_ReportErrorCondition("")
	exitscript	
endif

sv_p = 0

while(sv_r < 1)
#{

	sv_m = CDOUBLE(MTT.InputDetails.PrePaymentFeeAdj)
	sv_c = CDOUBLE(MTT.InputDetails.prepayFeeInChrgCrncy) 

	sv_p = CDOUBLE(MTT.InputDetails.SourceAcctTranAmt)
	sv_q = CDOUBLE(MTT.InputDetails.LoanAcctTranAmt)
	
	if ((MTT.InputDetails.RevOriginOfTran == "LDS") AND (MTT.InputDetails.FuncCode == "R") AND (MTT.InputDetails.LoanAccountCrncyCode != MTT.InputDetails.DebitAcctCrncyCode )) then 
		sv_a = "1"  
	else 
		sv_a = "0"  
	endif
	if (MTT.InputDetails.FuncCode == "R") then 
		sv_t = CDOUBLE(MTT.InputDetails.RevFeeAdj)
	endif
    if( MTT.InputDetails.UnearnIncAcctFlg == "Y" ) then
        sv_u = CDOUBLE(MTT.InputDetails.benefitAmt)
    else
        sv_u = CDOUBLE("0")
    endif
	##################################
	
#----------------------------------------------------------------------------
# Debit the source account for the complete amount
#----------------------------------------------------------------------------
	MTT.PartTranDetails.Account = MTT.InputDetails.SourceDebitAccount 
	MTT.PartTranDetails.RefCurrency = MTT.InputDetails.DebitAcctCrncyCode
    #MSG0309578 = "Loan Account Payments For : " + MTT.InputDetails.LoanAccount
    #sv_e=urhk_getMSGCodeErrDesc("MSG0309578")
    #if(sv_e == 0) then
   # sv_f = BANCS.OUTPARAM.errDesc
    #endif
sv_f ="Paiement anticipatif partiel du credit "
	
MTT.PartTranDetails.Particulars = sv_f + MTT.InputDetails.LoanAccount	
	MTT.PartTranDetails.Consolidate = "N"
	MTT.PartTranDetails.RefAmount = -sv_p
	MTT.PartTranDetails.sysPartTranCode = "PTRN01774"	 
	MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
    if (MTT.InputDetails.FuncCode == "R") then
    #{
        #if(MTT.InputDetails.IntRouteFlg == "O") then
            MTT.PartTranDetails.RefAmount = sv_p
			MTT.PartTranDetails.sysPartTranCode = "PTRN01775"
        #else
        #    MTT.PartTranDetails.RefAmount = sv_p-sv_u
        #endif
        #MSG0309174 = "Loan Payment Reversal For : " + MTT.InputDetails.LoanAccount
        sv_g=urhk_getMSGCodeErrDesc("MSG0309174")
        if(sv_g == 0) then
        sv_h = BANCS.OUTPARAM.errDesc
        endif
        MTT.PartTranDetails.Particulars = sv_h + MTT.InputDetails.LoanAccount
    #}
    endif

	MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
	MTT.PartTranDetails.PartTranIdentifier = "SOURCE_DEBIT"
	MTT.PartTranDetails.PTranBusinessType = "RECOV"								
	MTT.PartTranDetails.ACPARTB2kId = MTT.InputDetails.LoanAccount
	MTT.PartTranDetails.ACPARTB2kType = "ACCNT"

	MTT.PartTranDetails.EntryTime=MTT.InputDetails.EntryTime 
	MTT.PartTranDetails.EntryUserId=MTT.InputDetails.EntryUserId 
	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LAPAY"
	sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	if (sv_z == 0) then
		call("getMTTTranPart.scr")
	endif
	
	#--------------------------------------------
    # Enter OAP Details if account is of OAP Type
    #--------------------------------------------		
	if(MTT.InputDetails.OAPSchmTypeFlg == "Y")then
	#{
		MTT.PartTranDetails.Refnum = MTT.InputDetails.OAPRefNum
		MTT.OAPAddnlDetails.OffsetAmount = sv_p
		MTT.OAPAddnlDetails.OrgTranID = MTT.InputDetails.OAPTranId
		MTT.OAPAddnlDetails.OrgTranDate = MTT.InputDetails.OAPTranDate 
		MTT.OAPAddnlDetails.OrgPartTran = MTT.InputDetails.OAPPTranSrlNum 
	#}
	endif

	#------------------------------------------
	# Dump the instrument Details
	#-------------------------------------------
	if(MTT.InputDetails.tranType == "T") then
		if (MTT.InputDetails.FuncCode != "R") then
			MTT.PartTranDetails.InstrmntType = MTT.InputDetails.instrmntType

			if(MTT.InputDetails.instrmntDate !="") then
				BANCS.INPARAM.date1 = MID$(MTT.InputDetails.instrmntDate,0,10)
				BANCS.INPARAM.date2 = MID$(BANCS.STDIN.BODDate,0,10)
				sv_r = urhk_B2k_dateDiff("")
				MTT.PartTranDetails.InstrmntDate=BANCS.OUTPARAM.dateDiff
			endif

			MTT.PartTranDetails.InstrmntNum = MTT.InputDetails.instrmntNum
			MTT.PartTranDetails.InstrmntAlpha = MTT.InputDetails.instrmntAlpha
		endif
	endif

	MTT.PartTranDetails.svsTranId = MTT.InputDetails.svsTranId
	
	sv_r = urhk_MTTS_DefineLoanPartTran("SOURCE_DEBIT")

	if (sv_r == 1) then
		exitscript
	endif

	#-------------------------------------------------------------------
	#If loan account currency is different from  source account currency	
	#-------------------------------------------------------------------
	if (MTT.InputDetails.LoanAccountCrncyCode != MTT.InputDetails.DebitAcctCrncyCode) then 
	#{
		#----------------------------------------------------------
		#Loan Acct Xfer Parking Credit 					
		#----------------------------------------------------------
		
		MTT.PartTranDetails.Account = MTT.InputDetails.XferParkAcct 
        #MSG0309578 = "Loan Account Payments For : " + MTT.InputDetails.LoanAccount
        #sv_i=urhk_getMSGCodeErrDesc("MSG0309578")
        #if(sv_i == 0) then
       # sv_j = BANCS.OUTPARAM.errDesc
        #endif
sv_j ="Paiement anticipatif partiel du credit "

        MTT.PartTranDetails.Particulars = sv_j + MTT.InputDetails.LoanAccount
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAPAY"
		sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_z == 0) then
			call("getMTTTranPart.scr")
		endif
		
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.DebitAcctCrncyCode
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
		MTT.PartTranDetails.RefAmount = sv_p
		MTT.PartTranDetails.sysPartTranCode = "PTRN01776"
		if (MTT.InputDetails.FuncCode == "R") then 
			MTT.PartTranDetails.RefAmount = -sv_p
			MTT.PartTranDetails.sysPartTranCode = "PTRN01777"
		endif

		if (sv_a == "1" ) then 
			MTT.PartTranDetails.Account = MTT.InputDetails.ConsolLoanParkAcct 
			MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAccountCrncyCode 
			MTT.PartTranDetails.RefAmount = -sv_q + sv_t
		endif
		MTT.PartTranDetails.RateCode=MTT.InputDetails.TranRateCode
		MTT.PartTranDetails.Rate=MTT.InputDetails.TranRate
		MTT.PartTranDetails.TreaRate = MTT.InputDetails.TranTreaRate
	    MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.TreaRefNum
		MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
		MTT.PartTranDetails.PartTranIdentifier = "SOURCE_DEBIT"
		MTT.PartTranDetails.PTranBusinessType = "RECOV"								
		sv_r = urhk_MTTS_DefineLoanPartTran("LA_PARK_CREDIT")
		if (sv_r == 1) then
			exitscript
		endif

		BANCS.INPARAM.InputAmount=sv_p
		BANCS.INPARAM.FromCurrency=MTT.InputDetails.DebitAcctCrncyCode
		BANCS.INPARAM.ToCurrency=MTT.InputDetails.LoanAccountCrncyCode
		if (sv_a == "1" ) then 
			BANCS.INPARAM.InputAmount=sv_q - sv_t
			BANCS.INPARAM.FromCurrency= MTT.InputDetails.LoanAccountCrncyCode
			BANCS.INPARAM.ToCurrency=MTT.InputDetails.DebitAcctCrncyCode
		endif
		BANCS.INPARAM.RateCode=MTT.InputDetails.TranRateCode
		BANCS.INPARAM.Rate=MTT.InputDetails.TranRate
		sv_z=urhk_B2k_ConvertAmount("")
		sv_x= CDOUBLE(BANCS.OUTPARAM.OutputAmount)

		#-----------------------------------------------------------
		# Loan Acct Xfer Parking Debit 					
		#-----------------------------------------------------------

		MTT.PartTranDetails.Account = MTT.InputDetails.XferParkAcct 
		#print (MTT.PartTranDetails.Account ) 
        #MSG0309578 = "Loan Account Payments For : " + MTT.InputDetails.LoanAccount
       # sv_i=urhk_getMSGCodeErrDesc("MSG0309578")
       # if(sv_i == 0) then
       # sv_j = BANCS.OUTPARAM.errDesc
       # endif
sv_j ="Paiement anticipatif partiel du credit "

        MTT.PartTranDetails.Particulars = sv_j + MTT.InputDetails.LoanAccount
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LAPAY"
		sv_z = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		if (sv_z == 0) then
			call("getMTTTranPart.scr")
		endif
	
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAccountCrncyCode
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.ValueDate = MTT.InputDetails.ValueDate
		MTT.PartTranDetails.RefAmount = -sv_x
		MTT.PartTranDetails.sysPartTranCode = "PTRN01778"
		if ((MTT.InputDetails.FuncCode == "R") OR (MTT.InputDetails.FuncCode == "W")) then 
		MTT.PartTranDetails.RefAmount = sv_x
		MTT.PartTranDetails.sysPartTranCode = "PTRN01779"
		endif
		if (sv_a == "1" ) then 
			MTT.PartTranDetails.Account = MTT.InputDetails.ConsolLoanParkAcct 
			MTT.PartTranDetails.RefCurrency = MTT.InputDetails.DebitAcctCrncyCode
		endif 
		MTT.PartTranDetails.TranIdentifier = "LoanRecovery"
		MTT.PartTranDetails.PartTranIdentifier = "SOURCE_DEBIT"
		MTT.PartTranDetails.PTranBusinessType = "RECOV"								


		sv_r = urhk_MTTS_DefineLoanPartTran("LA_PARK_CREDIT")
		if (sv_r == 1) then
			exitscript
		endif
	#}
	endif
    
	#if forward a/c in construction period then make sv_q as 0
    if (MTT.InputDetails.ForwardIjarahInCP == "Y") then
        sv_q = 0
    endif
#----------------------------------------------------------
# Loan Acct Credit			 					 
#----------------------------------------------------------
	if (sv_q != 0 ) then 
	#{

		MTT.PartTranDetails.Account = MTT.InputDetails.LoanAccount
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAccountCrncyCode
##Commenting for harcoding the tran particulars
