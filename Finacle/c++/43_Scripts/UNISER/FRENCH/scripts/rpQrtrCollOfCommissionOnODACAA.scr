#======================================================#
#Source Name			:rpQrtrCollOfCommissionOnODA.scr
#Menu				:HBJE
#Batch Name			:ODCOM
#Date				:27-03-2023
#Description			:To collect commission charges from ODA accounts.
#Author				:Ranjith Palani
#======================================================#
<--start
trace on
	if(repexists("CUST") == 0)then
		createrep("CUST")
	endif
	if(classexists("CUST","DRCODC") == 0)then
		createclass("CUST","DRCODC",5)
	endif
	if(classexists("CUST","RATE") == 0)then
		createclass("CUST","RATE",5)
	endif

	CUST.DRCODC.successFile = "ODCOM-SUC_"+ mid$(BANCS.STDIN.sysDate,0,10) +"_"+ BANCS.STDIN.mySolId +".LST"
	sv_s = "echo '   A/c Id Dr.   |A/c Crncy Dr.|   A/c Id Cr.   |A/c Crncy Cr.|LimitSerailNum| TranId  ' >"+CUST.DRCODC.successFile
	sv_s = system(sv_s)
	print(sv_s)
	CUST.DRCODC.failureFile = "ODCOM-FAI_"+ mid$(BANCS.STDIN.sysDate,0,10) +"_"+ BANCS.STDIN.mySolId +".LST"
	sv_f = "echo '   A/c Id Dr.   |A/c Crncy Dr.|   A/c Id Cr.   |A/c Crncy Cr.|LimitSerailNum| FailureRemarks' >"+CUST.DRCODC.failureFile
	sv_f = system(sv_f)
	print(sv_f)

	sv_b = urhk_B2k_printRepos("BANCS")
	print(sv_b)


	#----------------------------#
	#Populate MTT Input Details.
	#----------------------------#
	sv_p = urhk_MTTS_PopulateInputDetails("")
	if(sv_p != 0)then
	#{
		sv_e = urhk_MTTS_ReportErrorCondition("")
		CUST.DRCODC.errMsg = MTT.Error.Description
		print(CUST.DRCODC.errMsg)
		exitscript
	#}
	endif

	#----------------------------#
	#Closing of MTT if it opens.
	#----------------------------#
	sv_c = urhk_MTTS_Close("")
	if(sv_c != 0)then
	#{
		sv_e = urhk_MTTS_ReportErrorCondition("")
		CUST.DRCODC.errMsg = MTT.Error.Description
		print(CUST.DRCODC.errMsg)
		exitscript
	#}
	endif

	#----------------------------#
	#Initialize MTT Details.
	#----------------------------#
	BANCS.INPARAM.PostTranFlg		= "Y"
	BANCS.INPARAM.CommitFlg			= "Y"
	BANCS.INPARAM.InsertTranWithValidnFlg	= "Y"
	BANCS.INPARAM.ValidationFlag		= "N"
	BANCS.INPARAM.RestrictModifyInd		= "FIRST_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw		= "Y"
	BANCS.INPARAM.CheckExceptions		= "Y"
	sv_i = urhk_MTTS_Initialize("")
	if(sv_i != 0)then
	#{
		sv_e = urhk_MTTS_ReportErrorCondition("")
		CUST.DRCODC.errMsg = MTT.Error.Description
		print(CUST.DRCODC.errMsg)
		exitscript
	#}
	endif

	#----------------------------#
	#Define the Transaction.
	#----------------------------#
	MTT.TranDetails.TranDate	= "0"
	MTT.TranDetails.TranType	= "T"
	MTT.TranDetails.TranSubType	= "BI"
	MTT.TranDetails.ValidationFlag	= "N"
	MTT.TranDetails.IgnoreExcp	= "I"
	MTT.TranDetails.CommitFlg	= "Y"
	MTT.TranDetails.PostFlag	= "Y"
	sv_d = urhk_MTTS_DefineTransaction("COMMISSION")
	if(sv_d != 0)then
	#{
		sv_e = urhk_MTTS_ReportErrorCondition("")
		CUST.DRCODC.errMsg = MTT.Error.Description
		print(CUST.DRCODC.errMsg)
		exitscript
	#}
	endif

	#--Cursor Starts.
	sv_l = "comAcid,comForacid,comSchmType,comCrncyCode,serialNum,sanctLimitAmt,limSanctDate,limExpDate,applicableDate,commChrgApplicableDate,commPrcnt|"
	sv_l = sv_l + " select c.com_acid,c.com_foracid,c.com_schm_type,c.com_crncy_code,lht.serial_num,lht.sanct_lim,lht.lim_sanct_date,lht.lim_exp_date,lht.applicable_date,"
	sv_l = sv_l + " to_char(c.com_charge_applicable_date,'dd-mm-yyyy'),c.com_charge_percentage"
	sv_l = sv_l + " from tbaadm.lht,custom.oda_commission_chrg_tbl c"
	sv_l = sv_l + " where lht.acid=c.com_acid"
	sv_l = sv_l + " and lht.bank_id=c.bank_id"
	sv_l = sv_l + " and lht.serial_num=c.com_serial_num"
	sv_l = sv_l + " and lht.bank_id=?SVAR"
	sv_l = sv_l + " and c.bank_id=?SVAR"
	sv_l = sv_l + " and lht.entity_cre_flg!='N'"
	sv_l = sv_l + " and lht.del_flg!='Y'"
	sv_l = sv_l + " and lht.status='A'"
	sv_l = sv_l + " and lht.sanct_lim > 0" 
	sv_l = sv_l + " and lht.lim_exp_date >= to_date(?SVAR,'dd-mm-yyyy')"
	sv_l = sv_l + " and exists(select 1 from tbaadm.sst where bank_id=?SVAR and sst.bank_id=c.bank_id and sst.sol_id=c.com_sol_id and sst.set_id=?SVAR)"
	#sv_l = sv_l + " and lim_exp_date <= to_date(?SVAR,'dd-mm-yyyy')"
	sv_l = sv_l + " order by c.com_acid,c.com_serial_num asc"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ mid$(BANCS.STDIN.BODDate,0,10) +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId
	#BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ mid$(BANCS.STDIN.BODDate,0,10)
	print(BANCS.INPARAM.BINDVARS)
	sv_l = urhk_dbCursorOpenWithBind(sv_l)
	if(sv_l != 0)then
	#{
		exitscript
	#}
	endif
		CUST.DRCODC.curNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_n = urhk_dbCursorFetch(CUST.DRCODC.curNum)
		print(sv_n)
		if(sv_n != 0)then
		#{
			sv_a = urhk_dbCursorClose(CUST.DRCODC.curNum)
			print(sv_a)
			exitscript
		#}
		endif

		while(sv_n == 0)
		#{
			CUST.DRCODC.comAcid = BANCS.OUTPARAM.comAcid
			print(CUST.DRCODC.comAcid)
			CUST.DRCODC.comForacid = BANCS.OUTPARAM.comForacid
			print(CUST.DRCODC.comForacid)
			CUST.DRCODC.comSchmType = BANCS.OUTPARAM.comSchmType
			print(CUST.DRCODC.comSchmType)
			CUST.DRCODC.comCrncyCode = BANCS.OUTPARAM.comCrncyCode
			print(CUST.DRCODC.comCrncyCode)
			CUST.DRCODC.serialNum = BANCS.OUTPARAM.serialNum
			print(CUST.DRCODC.serialNum)
			CUST.DRCODC.sanctLimitAmt = BANCS.OUTPARAM.sanctLimitAmt
			print(CUST.DRCODC.sanctLimitAmt)
			CUST.DRCODC.limSanctDate = BANCS.OUTPARAM.limSanctDate
			print(CUST.DRCODC.limSanctDate)
			CUST.DRCODC.limExpDate = BANCS.OUTPARAM.limExpDate
			print(CUST.DRCODC.limExpDate)
			CUST.DRCODC.applicableDate = BANCS.OUTPARAM.applicableDate
			print(CUST.DRCODC.applicableDate)
			CUST.DRCODC.commChrgApplicableDate = BANCS.OUTPARAM.commChrgApplicableDate
			print(CUST.DRCODC.commChrgApplicableDate)
			CUST.DRCODC.commPrcnt = BANCS.OUTPARAM.commPrcnt
			print(CUST.DRCODC.commPrcnt)

			sv_g = urhk_getAcctDetailsInRepository(CUST.DRCODC.comForacid)
			if(sv_g == 0)then
				CUST.DRCODC.acctCloseflg = BANCS.OUTPARAM.acctCloseflg
				print(CUST.DRCODC.acctCloseflg)
				if(CUST.DRCODC.acctCloseflg != "N")then
					goto nextRec
				endif
			endif

			CUST.DRCODC.commissionAmount = cdouble(CUST.DRCODC.sanctLimitAmt) * (cdouble(CUST.DRCODC.commPrcnt)/100)
			print(CUST.DRCODC.commissionAmount +"|"+ CUST.DRCODC.comCrncyCode)
			if(cdouble(CUST.DRCODC.commissionAmount) <= 0)then
				goto nextRec
			endif

			print(mid$(BANCS.STDIN.BODDate,0,10) +"|"+ mid$(CUST.DRCODC.commChrgApplicableDate,0,10) +"|"+ CUST.DRCODC.commissionAmount)
			BANCS.INPARAM.date1 = mid$(BANCS.STDIN.BODDate,0,10) 
			BANCS.INPARAM.date2 = mid$(CUST.DRCODC.commChrgApplicableDate,0,10) 
			sv_u = urhk_B2K_dateDiff("")
			print(sv_u)
			if(sv_u == 0 ) then
				CUST.DRCODC.dateDiff = BANCS.OUTPARAM.dateDiff
				print(CUST.DRCODC.dateDiff)
				if(CUST.DRCODC.dateDiff != "0")then
					goto nextRec
				endif
			else
				goto nextRec
			endif

			if(CUST.DRCODC.comSchmType == "CAA")then
				CUST.DRCODC.caaOrOperAcctDr = CUST.DRCODC.comForacid
				CUST.DRCODC.caaOrOperCrncyDr = CUST.DRCODC.comCrncyCode
				goto CaaOrOperToComm
			endif

			if(CUST.DRCODC.comSchmType == "ODA")then
				sv_a = urhk_getAdvanceDetailsForAccount(CUST.DRCODC.comForacid)
				if(sv_a == 0)then
					CUST.DRCODC.IntDrAcctId = BANCS.OUTPARAM.IntDrAcctId
					print(CUST.DRCODC.IntDrAcctId)
					if(CUST.DRCODC.IntDrAcctId != "")then
						sv_g = urhk_getAcctDetailsInRepository(CUST.DRCODC.IntDrAcctId)
						if(sv_g == 0)then
							CUST.DRCODC.AvailableAmt = cdouble(BANCS.OUTPARAM.AvailableAmt)
							CUST.DRCODC.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
							print(CUST.DRCODC.AvailableAmt +"|"+ CUST.DRCODC.acctCrncyCode)
						endif
					endif
				endif
			endif

			if(CUST.DRCODC.comCrncyCode != CUST.DRCODC.acctCrncyCode)then
				print("cross crncy")
				sv_r = "rateCode| select ratecode_tran from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
				BANCS.INPARAM.BINDVARS = CUST.DRCODC.comCrncyCode +"|"+ CUST.DRCODC.acctCrncyCode +"|"+ BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_r = urhk_dbSelectWithBind(sv_r)
				if(sv_r == 0)then
					CUST.DRCODC.rateCode = BANCS.OUTPARAM.rateCode
					print(CUST.DRCODC.rateCode)
					BANCS.INPARAM.InputAmount  = CUST.DRCODC.commissionAmount
					BANCS.INPARAM.FromCurrency = CUST.DRCODC.comCrncyCode 
					BANCS.INPARAM.ToCurrency   = CUST.DRCODC.acctCrncyCode 
					BANCS.INPARAM.RateCode     = CUST.DRCODC.rateCode 
					BANCS.INPARAM.Rate         = cdouble("0")
					sv_x = urhk_B2k_ConvertAmount("")
					if(sv_x == 0)then
						CUST.DRCODC.OutputAmount = BANCS.OUTPARAM.OutputAmount
						print(CUST.DRCODC.OutputAmount +"|"+ CUST.DRCODC.acctCrncyCode)
						if(cdouble(CUST.DRCODC.AvailableAm) < cdouble(CUST.DRCODC.OutputAmount))then
							CUST.DRCODC.comForacidDr = CUST.DRCODC.comForacid
							CUST.DRCODC.comCrncyCodeDr =CUST.DRCODC.comCrncyCode
							CUST.DRCODC.IntDrAcctIdCr = CUST.DRCODC.IntDrAcctId
							CUST.DRCODC.acctCrncyCodeCr = CUST.DRCODC.acctCrncyCode
							print("Insufficient Fund in Operative,First Debit from ODA to CAA then CAA to Commission Account - Diff Crncy")
							goto OdaToOperToComm	
						endif
						if(cdouble(CUST.DRCODC.AvailableAm) >= cdouble(CUST.DRCODC.OutputAmount))then
							CUST.DRCODC.caaOrOperAcctDr = CUST.DRCODC.IntDrAcctId
							CUST.DRCODC.caaOrOperCrncyDr = CUST.DRCODC.acctCrncyCode
							print("Sufficient Fund in CaaOrOperative,Directly debit from CAA to Commission Account - Diff Crncy")
							goto CaaOrOperToComm
						endif
					endif
				else
					goto nextRec
				endif
			endif 

			if(CUST.DRCODC.comCrncyCode == CUST.DRCODC.acctCrncyCode)then
				print("same crncy")
				print(cdouble(CUST.DRCODC.AvailableAmt))
				print(cdouble(CUST.DRCODC.commissionAmount))
				if(cdouble(CUST.DRCODC.AvailableAmt) < cdouble(CUST.DRCODC.commissionAmount))then
					CUST.DRCODC.comForacidDr = CUST.DRCODC.comForacid
					CUST.DRCODC.comCrncyCodeDr =CUST.DRCODC.comCrncyCode
					CUST.DRCODC.IntDrAcctIdCr = CUST.DRCODC.IntDrAcctId
					CUST.DRCODC.acctCrncyCodeCr = CUST.DRCODC.acctCrncyCode
					print("Insufficient Fund in Operative,First Debit from ODA to CAA then CAA to Commission Account - Same Crncy")
					goto OdaToOperToComm	
				endif	
				print(cdouble(CUST.DRCODC.AvailableAmt))
				print(cdouble(CUST.DRCODC.commissionAmount))
				if(cdouble(CUST.DRCODC.AvailableAmt) >= cdouble(CUST.DRCODC.commissionAmount))then
					CUST.DRCODC.caaOrOperAcctDr = CUST.DRCODC.IntDrAcctId
					CUST.DRCODC.caaOrOperCrncyDr = CUST.DRCODC.acctCrncyCode
					print("Sufficient Fund in CaaOrOperative,Directly debit from CAA to Commission Account - Same Crncy")
					goto CaaOrOperToComm
				endif
			endif 

			CaaOrOperToComm:
			#=========================MTT Begins=========================#
			#--------------------------------------#
			#Debit the CAA/Operative accounts.
			#--------------------------------------#
			print(cdouble(CUST.DRCODC.commissionAmount))
			MTT.PartTranDetails.Account        = CUST.DRCODC.caaOrOperAcctDr 
			MTT.PartTranDetails.RefAmount      = -cdouble(CUST.DRCODC.commissionAmount)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.RefCurrency    = CUST.DRCODC.caaOrOperCrncyDr #BANCS.STDIN.homeCrncyCode 
			MTT.PartTranDetails.TranCurrency   = CUST.DRCODC.caaOrOperCrncyDr 
			if(CUST.DRCODC.caaOrOperCrncyDr != BANCS.STDIN.homeCrncyCode)then
			#{
				#MTT.PartTranDetails.RateCode = "TTB"
				MTT.PartTranDetails.Rate = "1"
				#MTT.PartTranDetails.TreaRate = "2012.1804"
				#CUST.RATE.acctCrncy = BANCS.STDIN.homeCrncyCode
				#CUST.RATE.refCrncy = CUST.DRCODC.acctCrncyCode
				#CUST.RATE.TranType = "T"
				#call("fetchRateCode.scr")
			#}
			endif

			print(MTT.PartTranDetails.RefAmount)

			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "Commission Charges on CAAorODAOperativeAcct A/c: " + CUST.DRCODC.caaOrOperAcctDr
			MTT.PartTranDetails.Remarks        = "Commission Debit" 
			MTT.PartTranDetails.TranIdentifier = "COMMISSION" 
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = CUST.DRCODC.serialNum 
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			sv_d = urhk_MTTS_DefinePartTran("DR_COMMISSION")
			if(sv_d != 0)then
			#{
				sv_e = urhk_MTTS_ReportErrorCondition("")
				CUST.DRCODC.errMsg = MTT.Error.Description
				print(CUST.DRCODC.errMsg)
				exitscript
			#}
			endif

			#--------------------------------------#
			#Credit the Commission Placeholder.
			#--------------------------------------#
			CUST.DRCODC.commissionBacid = "CCCOM"
			sv_f = CUST.DRCODC.commissionBacid + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId 
			sv_f = urhk_B2k_BacidToAcctId(sv_f)
			if(sv_f != 0)then
			#{
				print("Commission Placeholder not found for the currency and sol.")
				exitscript
			#}
			else
			#{
				CUST.DRCODC.commCrAcct = BANCS.OUTPARAM.AcctId
			#}
			endif
			print(cdouble(CUST.DRCODC.commissionAmount))
			MTT.PartTranDetails.Account        = CUST.DRCODC.commCrAcct 
			MTT.PartTranDetails.RefAmount      = cdouble(CUST.DRCODC.commissionAmount)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.RefCurrency    = CUST.DRCODC.caaOrOperCrncyDr # BANCS.STDIN.homeCrncyCode 
			MTT.PartTranDetails.TranCurrency   = BANCS.STDIN.homeCrncyCode #CUST.DRCODC.caaOrOperCrncyDr 
			if(CUST.DRCODC.caaOrOperCrncyDr != BANCS.STDIN.homeCrncyCode)then
			#{
				CUST.RATE.acctCrncy = CUST.DRCODC.caaOrOperCrncyDr
				CUST.RATE.refCrncy = BANCS.STDIN.homeCrncyCode
				CUST.RATE.TranType = "T"
				call("fetchRateCode.scr")
				MTT.PartTranDetails.RateCode = CUST.RATE.rateCode #"TTB"
				MTT.PartTranDetails.Rate = CUST.RATE.rate #"2020"
				MTT.PartTranDetails.TreaRate = CUST.RATE.treaRate #"2012.1804"
			#}
			endif
			MTT.PartTranDetails.ValueDate      = "0"
			MTT.PartTranDetails.Particulars    = "Commission Charges Credit on OAB A/c: " + CUST.DRCODC.commCrAcct 
			MTT.PartTranDetails.Remarks        = "Commission Credit"
			MTT.PartTranDetails.TranIdentifier = "COMMISSION"
			MTT.PartTranDetails.Consolidate    = "N"
			MTT.PartTranDetails.Refnum         = CUST.DRCODC.serialNum 
			MTT.TranDetails.PostFlag           = "Y"
			MTT.TranDetails.IgnoreExcp         = "Y"
			sv_c = urhk_MTTS_DefinePartTran("CR_COMMISSION")
			if(sv_d != 0)then
			#{
				sv_e = urhk_MTTS_ReportErrorCondition("")
				CUST.DRCODC.errMsg = MTT.Error.Description
				print(CUST.DRCODC.errMsg)
				exitscript
			#}
			endif

			#--------------------------------------#
			#MTT Ending definition to create transaction
			#--------------------------------------#
			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)

			if(FIELDEXISTS(MTT.Error.Description))then
			#{
				print(MTT.Error.Description)
				sv_f = "echo '" + rpad(CUST.DRCODC.caaOrOperAcctDr,16,' ') +"|"+ rpad(CUST.DRCODC.caaOrOperCrncyDr,13,' ') +"|"+ rpad(CUST.DRCODC.commCrAcct,16,' ') +"|"+ rpad(BANCS.STDIN.homeCrncyCode,13,' ') +"|"+ rpad(CUST.DRCODC.serialNum,12,' ') +"|"+ MTT.Error.Description +"' >>"+CUST.DRCODC.failureFile
				sv_f = system(sv_f)
				print(sv_f)
				goto nextRec
			#}
			endif

			if(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId))then
			#{
				CUST.DRCODC.tranId = TRIM(BANCS.OUTPARAM.MTTTranId)
				print(CUST.DRCODC.tranId)
				sv_s = "echo '" + rpad(CUST.DRCODC.caaOrOperAcctDr,16,' ') +"|"+ rpad(CUST.DRCODC.caaOrOperCrncyDr,13,' ') +"|"+ rpad(CUST.DRCODC.commCrAcct,16,' ') +"|"+ rpad(BANCS.STDIN.homeCrncyCode,13,' ') +"|"+ rpad(CUST.DRCODC.serialNum,12,' ') +"|"+ rpad(CUST.DRCODC.tranId,9,' ') +"' >>"+CUST.DRCODC.successFile
				sv_s = system(sv_s)
				print(sv_s)
				#--Upate Custom.
				sv_u = "update custom.oda_commission_chrg_tbl set com_charge_applicable_date="
				sv_u = sv_u + " case when to_date(com_expiry_date,'dd-mm-yyyy') > add_months(to_date(com_charge_applicable_date,'dd-mm-yyyy'),3) then"
				sv_u = sv_u + "		add_months(com_charge_applicable_date,3)"
				sv_u = sv_u + " else"
				sv_u = sv_u + "		com_sanct_date"
				sv_u = sv_u + " end,"
				sv_u = sv_u + " comm_coll_cnt=nvl(comm_coll_cnt,0)+1,"
				sv_u = sv_u + " last_comm_coll_tran_id=?SVAR"
				sv_u = sv_u + " where com_acid=?SVAR and com_serial_num=?SVAR"
				print(sv_u)
				BANCS.INPARAM.BINDVARS = CUST.DRCODC.tranId +"|"+ CUST.DRCODC.comAcid +"|"+ CUST.DRCODC.serialNum
				print(BANCS.INPARAM.BINDVARS)
				sv_u = urhk_dbSqlWithBind(sv_u)
				if(sv_u == 0)then
				#{
					sv_u = urhk_dbSqlWithBind("commit")
					print(sv_u)
					print("Updated Successfully")
					goto nextRec
				#}
				endif
				#--Upate Custom.
			#}
			endif
			#=========================MTT Ends=========================#
			OdaToOperToComm:
			#--------------------------------------#
			#Debit the ODA accounts.
			#--------------------------------------#
			print(cdouble(CUST.DRCODC.commissionAmount))
			MTT.PartTranDetails.Account        = CUST.DRCODC.comForacidDr 
			MTT.PartTranDetails.RefAmount      = -cdouble(CUST.DRCODC.commissionAmount)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.RefCurrency    = CUST.DRCODC.comCrncyCodeDr #BANCS.STDIN.homeCrncyCode 
			MTT.PartTranDetails.TranCurrency   = CUST.DRCODC.comCrncyCodeDr 
			if(CUST.DRCODC.comCrncyCodeDr != BANCS.STDIN.homeCrncyCode)then
			#{
				#MTT.PartTranDetails.RateCode = "TTB"
				MTT.PartTranDetails.Rate = "1"
				#MTT.PartTranDetails.TreaRate = "2012.1804"
				#CUST.RATE.acctCrncy = BANCS.STDIN.homeCrncyCode
