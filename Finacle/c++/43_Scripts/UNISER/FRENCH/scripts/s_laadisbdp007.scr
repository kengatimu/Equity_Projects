#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="fe07f6b98277578129cd405c79aef186113bad5f27c7ba50ff2c3f71a83e0639"
	TRACE ON
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	sv_a = urhk_B2K_printRepos("BANCS")
	print(sv_a)
	
	#-------------------------------------------------------------------------------
	#Initializing Required variables
	#-------------------------------------------------------------------------------
	CUST.LADISB.errMsg 		= ""
	CUST.LADISB.loanType	= ""
	CUST.LADISB.tranid		= ""
	CUST.LADISB.tranMsg 	= ""
	CUST.LADISB.MTTErrDesc	= ""
	
	#------------------------------------------------------------------------------
	# Getting acctId code from front end
	#------------------------------------------------------------------------------
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	CUST.LADISB.loanAcctId  = BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.loanAcctId)
	
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
	CUST.LADISB.disbAmt             = BANCS.OUTPARAM.srvValue
	sv_a=getPosition(CUST.LADISB.disbAmt,"|")
	sv_b=strlen(CUST.LADISB.disbAmt)
	CUST.LADISB.disbAmt		=LEFT$(CUST.LADISB.disbAmt,sv_a-1)
	print(CUST.LADISB.disbAmt)
	
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.partTranLL.<rec_0>.tranRmks")
	CUST.LADISB.tranPart	= BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.tranPart)
	
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.partTranLL.<rec_0>.oapRefNum")
	CUST.LADISB.refNum		= BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.refNum)
	CUST.LADISB.refNum		= ""
	
	#------------------------------------------------------------------------------
	# Exitscript if function code is Reversal
	#------------------------------------------------------------------------------
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.reversalTranId")
	CUST.LADISB.reversalTran = BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.reversalTran)
	IF (CUST.LADISB.reversalTran != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Calling common script for common values
	#------------------------------------------------------------------------------
	print(CUST.LADISB.loanAcctId)
	CALL("laadisbdp004.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.LADISB.stepVal="7"
	CALL("laadisbdp008.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#################################################################################
	# Inclusion for stima loan
	#################################################################################
	print(CUST.LADISB.loanType)
	IF (CUST.LADISB.loanType == "S") THEN
	#{
		CUST.LADISB.tranMsg = "Stima Loan"
		IF (CUST.LADISB.operAcctFlg == "N") THEN
		#{
			CUST.LADISB.errMsg = "Operative account not linked"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		print(CUST.LADISB.tranPart)
		print(CUST.LADISB.refNum)
		sv_w = getPosition(CUST.LADISB.tranPart,"/")
		CUST.LADISB.refNum = MID$(CUST.LADISB.tranPart,0, (sv_w-1))
		print(CUST.LADISB.refNum)
		sv_y = STRLEN(CUST.LADISB.tranPart)
		CUST.LADISB.tranPart = MID$(CUST.LADISB.tranPart,sv_w, sv_y)
		print(CUST.LADISB.tranPart)
		
		#------------------------------------------------------------------
		#  Calculatin lace and insurance Amount
		#------------------------------------------------------------------
		IF (CDOUBLE(CUST.LADISB.laceAmt) != 0) THEN
		#{
			sv_i = CUST.CPARAM.stBacidLacAct + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
			print(sv_i)
			sv_u = urhk_B2k_BacidToAcctId(sv_i)
			IF (sv_u != 0 ) THEN
			#{
				CUST.LADISB.errMsg ="Lace Collection A/C not set up "
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			CUST.LADISB.laceCrAccnt = BANCS.OUTPARAM.AcctId
			print(CUST.LADISB.laceCrAccnt)
		#}
		ENDIF
		
		IF (CDOUBLE(CUST.LADISB.insuAmt) != 0) THEN
		#{
			sv_i = CUST.CPARAM.stBacidInsAct + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
			print(sv_i)
			sv_u = urhk_B2k_BacidToAcctId(sv_i)
			IF (sv_u != 0 ) THEN
			#{
				CUST.LADISB.errMsg ="Insuarance A/C not set up"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			CUST.LADISB.insuCrAccnt = BANCS.OUTPARAM.AcctId
			print(CUST.LADISB.insuCrAccnt)
		#}
		ENDIF
		
		
		#--------------------------------------------------------------------------
		# Initialise the MTT repository
		#--------------------------------------------------------------------------
		
		sv_r = REPEXISTS("MTT")
		IF (sv_r == 0) THEN
		#{
			CREATEREP("MTT")
		#}
		ENDIF
		
		sv_r = CLASSEXISTS("MTT","TranDetails")
		IF (sv_r == 0) THEN
		#{
			CREATECLASS("MTT","TranDetails",5)
		#}
		ENDIF
		
		sv_r = CLASSEXISTS("MTT","PartTranDetails")
		IF (sv_r == 0) THEN
		#{
			CREATECLASS("MTT","PartTranDetails",5)
		#}
		ENDIF
		sv_r = CLASSEXISTS("MTT","InputDetails")
		IF (sv_r == 0) THEN
		#{
			CREATECLASS("MTT","InputDetails",5)
		#}
		ENDIF
		
		sv_r = CLASSEXISTS("MTT","LAAddnlDetails")
		IF (sv_r == 0) THEN
		#{
			CREATECLASS("MTT","LAAddnlDetails",5)
		#}
		ENDIF
		
		sv_r = CLASSEXISTS("MTT","Error")
		IF (sv_r == 0) THEN
		#{
			CREATECLASS("MTT","Error",5)
		#}
		ENDIF
		
		sv_r = REPEXISTS("BANCS")
		IF (sv_r == 0) THEN
		#{
			CREATEREP("BANCS")
		#}
		ENDIF
		
		sv_r = CLASSEXISTS("BANCS","INPARAM")
		IF (sv_r == 0) THEN
		#{
			CREATECLASS("BANCS","INPARAM",5)
		#}
		ENDIF
		
		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "N"
		BANCS.INPARAM.CommitFlg="Y"
		BANCS.INPARAM.RestrictModifyInd="FOURTH_GROUP"
		
		BANCS.INPARAM.ErrorCheckForLuw="Y"
		BANCS.INPARAM.CheckExceptions="N"
		MTT.TranDetails.TranDate="0"
		MTT.TranDetails.TranType = "T"
		MTT.TranDetails.TranSubType = "CI"
		MTT.TranDetails.IgnoreExcp = "I"
		MTT.TranDetails.Consolidate = "N"
		MTT.TranDetails.Remarks = CUST.CPARAM.stTranDetailRmks1
		
		sv_r = urhk_MTTS_Initialize("")
		print(sv_r)
		
		sv_v = "Stima"
		print(sv_v)
		
		sv_u = urhk_MTTS_DefineTransaction("Stima")
		
		sv_u = urhk_MTTS_PopulateInputDetails("")
		
		CUST.LADISB.totalAmt=CDOUBLE(CUST.LADISB.laceAmt)+CDOUBLE(CUST.LADISB.contribution)+CDOUBLE(CUST.LADISB.insuAmt)
		print(CUST.LADISB.totalAmt)
		
		IF (CDOUBLE(CUST.LADISB.laceAmt)!= 0) THEN
		#{
			MTT.PartTranDetails.Account = CUST.LADISB.laceCrAccnt
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.RateCode = CUST.CPARAM.rateCode
			MTT.PartTranDetails.Rate = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.CPARAM.stParticulars1
			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.LADISB.laceAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.LADISB.tranPart
			MTT.PartTranDetails.RefNum = CUST.LADISB.refNum
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_e = "StimaLn"
			sv_r = urhk_MTTS_definePartTran(sv_e)
			print(sv_r)
			IF(FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.LADISB.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF
		#}
		ENDIF
		
		IF (CDOUBLE(CUST.LADISB.insuAmt)!=0) THEN
		#{
			MTT.PartTranDetails.Account = CUST.LADISB.insuCrAccnt
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.RateCode = CUST.CPARAM.rateCode
			MTT.PartTranDetails.Rate = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.CPARAM.stParticulars2
			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.LADISB.insuAmt)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.LADISB.tranPart
			MTT.PartTranDetails.RefNum = CUST.LADISB.refNum
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_e = "StimaLn"
			sv_r = urhk_MTTS_definePartTran(sv_e)
			print(sv_r)
			IF(FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.LADISB.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF
		#}
		ENDIF
		
		IF (CDOUBLE(CUST.LADISB.contribution) != 0) THEN
		#{
			MTT.PartTranDetails.Account = CUST.LADISB.loanAcctId
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.RateCode = CUST.CPARAM.rateCode
			MTT.PartTranDetails.Rate = "0"
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.CPARAM.stParticulars3
			MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.LADISB.contribution)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.LADISB.tranPart
			MTT.PartTranDetails.RefNum = CUST.LADISB.refNum
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			MTT.PartTranDetails.PTranBusinessType="MAIN"
			MTT.LAAddnlDetails.DemandFlowId=CUST.CPARAM.demandFlowId
			MTT.LAAddnlDetails.TypeOfDemand=""
			MTT.LAAddnlDetails.LoanAcctId = CUST.LADISB.loanAcctId
			MTT.LAAddnlDetails.OriginOfTran=""
			MTT.LAAddnlDetails.ReversalTranId=""
			MTT.LAAddnlDetails.ReversalTranDate=""
			MTT.LAAddnlDetails.ReversalPtranSrlNum=""
			MTT.LAAddnlDetails.ReversalDmdSrlNum=""
			MTT.LAAddnlDetails.AdvancePaymentFlg=""
			MTT.LAAddnlDetails.PrincipalAmt=""
			MTT.LAAddnlDetails.InterestAmt=""
			MTT.LAAddnlDetails.OtherChrgAmt=""
			MTT.LAAddnlDetails.BankChrgAmt=""
			MTT.LAAddnlDetails.DemandSatisfyFlg=""
			MTT.LAAddnlDetails.raiseDemandFlg=""
			MTT.LAAddnlDetails.oFlowAdjFlg=""
			MTT.LAAddnlDetails.DemandAmt=""
			sv_e = "StimaLn"
			sv_r = urhk_MTTS_definePartTran(sv_e)
			print(sv_r)
			IF(FIELDEXISTS(MTT.Error.Description)) THEN
			#{
				print(MTT.Error.Description)
				CUST.LADISB.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF
			
		#}
		ENDIF
		
		#------------------------------------------------------------------
		# Customer Debit Partran
		#------------------------------------------------------------------
		MTT.PartTranDetails.Account = CUST.LADISB.operAcctId
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.RateCode =CUST.CPARAM.rateCode
		MTT.PartTranDetails.Rate = "0"
		MTT.PartTranDetails.ValueDateDiff = "0"
		MTT.PartTranDetails.Particulars = CUST.CPARAM.stParticulars4
		sv_a = CDOUBLE(CUST.LADISB.totalAmt)
		sv_a= -(sv_a)
		MTT.PartTranDetails.RefAmount = sv_a
		print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Remarks = CUST.LADISB.tranPart
		MTT.PartTranDetails.RefNum = CUST.LADISB.refNum
		MTT.PartTranDetails.IgnoreExcp = "I"
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.TranIdentifier = sv_v
		sv_h = "D" + CUST.LADISB.operAcctId
		sv_u = urhk_MTTS_definePartTran(sv_h)
		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
			CUST.LADISB.MTTErrDesc = MTT.Error.Description
		#}
		ENDIF
		
		sv_r = urhk_MTTS_EndDefinition("")
		print(sv_r)
		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			print(BANCS.OUTPARAM.MTTTranId)
			CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
			print(CUST.LADISB.tranid)
		#}
		ENDIF
		
		sv_r = urhk_MTTS_Close("")
		print(sv_r)
		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			print(BANCS.OUTPARAM.MTTTranId)
			CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
			print(CUST.LADISB.tranid)
		#}
		ENDIF
	#}
	ENDIF
	
	#################################################################################
	# Inculusion for Merchandizing - laptop project
	#################################################################################
	print(CUST.LADISB.laSchmCode)
	CUST.LADISB.stepVal="5"
	CALL("laadisbdp008.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.LADISB.laSchmCode == CUST.CPARAM.lpSchmCode)  THEN
	#{
		CUST.LADISB.tranMsg = "Merchandizing Loan"
		IF (CUST.LADISB.operAcctFlg == "N") THEN
		#{
			CUST.LADISB.errMsg = "Operative account not linked"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_s = "ysum|"
		sv_s = sv_s + " SELECT"
		sv_s = sv_s + " SUM(OD.det_sup_base_price)"
		sv_s = sv_s + " FROM"
		sv_s = sv_s + " CUSTOM.ORDER_DETAILS OD"
		sv_s = sv_s + " WHERE"
		sv_s = sv_s + " OD.det_ord_order_no =?SVAR"
		sv_s = sv_s + " AND OD.bank_id 		=?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  CUST.LADISB.loanAcctId 	+ "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			CUST.LADISB.errMsg 	= "Error in finding insu amount"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.insuAmt=BANCS.OUTPARAM.ysum
			print(CUST.LADISB.insuAmt)
		#}
		ENDIF
		
		sv_s = "FreeCode6|"
		sv_s = sv_s + " SELECT d.free_code_6"
		sv_s = sv_s + " FROM TBAADM.GAM a, TBAADM.LAM b, TBAADM.GAM c, TBAADM.GAC d"
		sv_s = sv_s + " WHERE a.acid = b.acid"
		sv_s = sv_s + " AND b.op_acid = c.acid"
		sv_s = sv_s + " AND d.acid = b.acid"
		sv_s = sv_s + " AND a.entity_cre_flg ='Y'"
		sv_s = sv_s + " AND a.del_flg = 'N'"
		sv_s = sv_s + " AND a.foracid = ?SVAR "
		sv_s = sv_s + " AND a.bank_id = b.bank_id"
		sv_s = sv_s + " AND b.bank_id = c.bank_id"
		sv_s = sv_s + " AND c.bank_id = d.bank_id"
		sv_s = sv_s + " AND d.bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  CUST.LADISB.loanAcctId 	+ "|" +BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			CUST.LADISB.errMsg 	= "Error in finding free code6 value"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.freeCode6= BANCS.OUTPARAM.FreeCode6
			print(CUST.LADISB.freeCode6)
		#}
		ENDIF
		
		IF (CUST.LADISB.freeCode6 !="") THEN
		#{
			sv_s = "codename|"
			sv_s = sv_s + " SELECT RCT.ref_desc"
			sv_s = sv_s + " FROM TBAADM.RCT"
			sv_s = sv_s + " WHERE RCT.ref_code= ?SVAR"
			sv_s = sv_s + " AND RCT.ref_rec_type='AG'"
			sv_s = sv_s + " AND RCT.bank_id= ?SVAR"
			BANCS.INPARAM.BINDVARS =  CUST.LADISB.freeCode6 + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d=urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d != 0) THEN
			#{
				CUST.LADISB.errMsg 	= "Error in finding ref_desc"
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.LADISB.codeName= BANCS.OUTPARAM.codename
				print(CUST.LADISB.codeName)
			#}
			ENDIF
		#}
		ENDIF
		
		IF (CDOUBLE(CUST.LADISB.insuAmt)!=0) THEN
		#{
			#----------------------------------------------------------------
			#  ParameterId for FREECODE6
			#---------------------------------------------------------------
			BANCS.INPUT.parameterId = "LP_FRECD_" +CUST.LADISB.freeCode6
			CALL ("getcparamvalue.scr")
			IF (BANCS.OUTPUT.parameterVal != "") THEN
			#{
				CUST.CPARAM.lpFreeCode = BANCS.OUTPUT.parameterVal
				print(CUST.CPARAM.lpFreeCode)
				#}
			ELSE
				#{
				CUST.LADISB.errMsg = "CPARAM setup not done for LP_FRECD_"+CUST.LADISB.freeCode6
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF (CUST.CPARAM.lpSchmCode =="LA519") THEN
		#{
			
			#####################################################################
			sv_s = "applicationid,nationalid,dbstatdate |"
			sv_s = sv_s + " SELECT applicationid,nationalid,db_stat_date "
			sv_s = sv_s + " FROM CUSTOM.online_apps,TBAADM.gct "
			sv_s = sv_s + " WHERE NATIONALID=("
			sv_s = sv_s + 					" SELECT CMG.nat_id_card_num"
			sv_s = sv_s + 					" FROM TBAADM.CMG"
			sv_s = sv_s + 					" WHERE CMG.cif_id=("
			sv_s = sv_s + 										" SELECT cif_id"
			sv_s = sv_s + 										" FROM TBAADM.GAM"
			sv_s = sv_s + 										" WHERE GAM.foracid = ?SVAR "
			sv_s = sv_s + 										" AND GAM.bank_id= CMG.bank_id"
			sv_s = sv_s + 										" )"
			sv_s = sv_s +					" AND CMG.bank_id =GCT.bank_id"
			sv_s = sv_s + 					" )"
			sv_s = sv_s + " AND online_apps.statusflag= ?SVAR"
			sv_s = sv_s + " AND online_apps.bank_id= GCT.bank_id"
			sv_s = sv_s + " AND GCT.bank_id= ?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS =  CUST.LADISB.loanAcctId
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + CUST.CPARAM.statusFlg+ "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			sv_d=urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d != 0) THEN
