				print(MTT.Error.Description)
				CUST.LADISB.MTTErrDesc = MTT.Error.Description
			#}
			ENDIF
		#}
		ENDIF
		
		#------------------------------------------------------------------
		# Customer Debit Partran
		#------------------------------------------------------------------
		MTT.PartTranDetails.Account = CUST.LADISB.operAcctId
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.RateCode =CUST.CPARAM.rateCode
		MTT.PartTranDetails.Rate = "0"
		MTT.PartTranDetails.ValueDateDiff = "0"
		MTT.PartTranDetails.Particulars = CUST.CPARAM.ipoParticulars5
		sv_a = CDOUBLE(CUST.LADISB.totalAmt)
		sv_a= -(sv_a)
		MTT.PartTranDetails.RefAmount = sv_a
		print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Remarks = CUST.LADISB.tranPart
		MTT.PartTranDetails.Refnum = CUST.LADISB.refNum
		MTT.PartTranDetails.IgnoreExcp = "I"
		MTT.PartTranDetails.Consolidate = "N"
		MTT.PartTranDetails.TranIdentifier = sv_v
		sv_h = "D" + CUST.LADISB.operAcctId
		sv_u = urhk_MTTS_definePartTran(sv_h)
		IF(FIELDEXISTS(MTT.Error.Description)) THEN
		#{
			print(MTT.Error.Description)
			CUST.LADISB.MTTErrDesc = MTT.Error.Description
		#}
		ENDIF
		
		sv_r = urhk_MTTS_EndDefinition("")
		print(sv_r)
		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			print(BANCS.OUTPARAM.MTTTranId)
			CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
			print(CUST.LADISB.tranid)
		#}
		ENDIF
		
		sv_r = urhk_MTTS_Close("")
		print(sv_r)
		
		
		IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
		#{
			print(BANCS.OUTPARAM.MTTTranId)
			CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
			print(CUST.LADISB.tranid)
		#}
		ENDIF
		#------------------------------------------
		#Update the status to the SHARE_INVEST table
		#------------------------------------------
		sv_s ="UPDATE CUSTOM.SHARE_INVEST"
		sv_s = sv_s + " SET SHARE_INVEST.entity_cre_flg= 'Y',"
		sv_s = sv_s + " SHARE_INVEST.tran_remarks=?SVAR"
		sv_s = sv_s + " WHERE SHARE_INVEST.loan_acct_id =?SVAR"
		sv_s = sv_s + " AND SHARE_INVEST.share_invest_acct_id =?SVAR"
		sv_s = sv_s + " AND SHARE_INVEST.bank_id=?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.LADISB.tranid + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.loanAcctId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.shareInvestAcctId +"|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			#CUST.LADISB.errMsg =" The table SHARE_INVEST not updated successfully "
			#GOTO ENDOFSCRIPT
			sv_d = 1
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# Report file creation
	#-----------------------------------------------------------------------------------------------
	IF ((CUST.LADISB.laSchmCode == CUST.CPARAM.lpSchmCode) OR (CUST.LADISB.loanType == "I") OR (CUST.LADISB.loanType == "S"))  THEN
	#{
		sv_p = urhk_B2k_PID("")
		CUST.LADISB.pid = TRIM(BANCS.OUTPARAM.PID)
		print(CUST.LADISB.pid)
		CUST.LADISB.fileName = "LADISB"+ CUST.LADISB.pid +".log"
		print(CUST.LADISB.fileName)
		IF (CUST.LADISB.tranid != "") THEN
		#{
			sv_s= " SUCCESSFULL: " + CUST.LADISB.tranMsg + " transcation & charges collected successfully Transaction ID:"
			sv_s = sv_s +  CUST.LADISB.tranid
			ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataIn + "~ladisbres|"+CUST.LADISB.tranid+"|"+CUST.LADISB.tranMsg
			
			sv_c = "echo '" + CUST.LADISB.tranid + "' > LADTmpTran.txt"
			print(sv_c)
			sv_a = system(sv_c)
			print(sv_a)
			#}
		ELSE
			#{
			sv_s = "FAILED: " + CUST.LADISB.tranMsg + " transaction & charges were not posted...Proceed with manual intervention from Account."
			sv_s = sv_s + " " + CUST.LADISB.MTTErrDesc
			ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataIn + "~ladisbres|Charges not Collected|"+CUST.LADISB.tranMsg
			#ONS.CUSTOM.custDataOut = "~ladisbres|"+CUST.LADISB.tranid+"|"+CUST.LADISB.tranMsg
		#}
		ENDIF
		sv_s = "echo '" + sv_s + "' >"+CUST.LADISB.fileName
		print(sv_s)
		sv_a = system(sv_s)
		
		#--------------------------------------------------------------------------------------------------------------
		# For HPR Entry
		#--------------------------------------------------------------------------------------------------------------
		sv_s = "babx4040 ${B2K_SESSION_ID} "+CUST.LADISB.fileName+' '+'"'+"HLADISB Charges Report "+'"'+" MANAGER 1 N"
		print(sv_s)
		sv_a = system(sv_s)
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "") THEN
		#{
			sv_a = urhk_SRV_SetErr(CUST.LADISB.errMsg)
			print(CUST.LADISB.errMsg)
		#}
		ENDIF
		
		IF(CUST.LADISB.MTTErrDesc != "" ) THEN
		#{
			#sv_a = urhk_SRV_SetErr(CUST.LADISB.MTTErrDesc)
			print(CUST.LADISB.MTTErrDesc)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
