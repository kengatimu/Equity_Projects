<--START
TRACE ON
IF(REPEXISTS("CUST")==0)THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF(CLASSEXISTS("CUST","DATA")==0)THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF



        sv_u = urhk_B2K_PrintRepos("BANCS")
        PRINT(sv_u)

	CUST.DATA.errMsg                   = ""
	CUST.DATA.resMsg                   = ""
	CUST.DATA.agentcode                = ""
	CUST.DATA.crncyCode                = ""
	CUST.DATA.agenttitlecode           = ""
	CUST.DATA.agentname                = ""
	CUST.DATA.agentshortname           = ""
	CUST.DATA.agentphonenum            = ""
	CUST.DATA.agentaddr1               = ""
	CUST.DATA.agentaddr2               = ""
	CUST.DATA.agentaddr3               = ""
	CUST.DATA.agentcitycode            = ""
	CUST.DATA.agentstatecode           = ""
	CUST.DATA.agentcntrycode           = ""
	CUST.DATA.agentpin                 = ""
	CUST.DATA.crncycode                = ""
	CUST.DATA.operacctnum              = ""
	CUST.DATA.inoperacctnum            = ""
	CUST.DATA.itaxpcnt                 = ""
	CUST.DATA.dummyintamtceiling       = ""
	CUST.DATA.dummysecurityamt         = ""
	CUST.DATA.dummyexceptedcollection  = ""
	CUST.DATA.noofacctopened           = ""
	CUST.DATA.freetext                 = ""	
	CUST.DATA.del_flg                  = ""
	CUST.DATA.DATEL                    = ""

	CUST.DATA.funcCode    		   = BANCS.INPUT.funcCode
	CUST.DATA.agentcode                = BANCS.INPUT.agentcode
	CUST.DATA.crncyCode                = BANCS.INPUT.crncyCode
	CUST.DATA.agenttitlecode           = BANCS.INPUT.agenttitlecode
	CUST.DATA.agentname                = BANCS.INPUT.agentname
	CUST.DATA.agentshortname           = BANCS.INPUT.agentshortname
	CUST.DATA.agentphonenum            = BANCS.INPUT.agentphonenum
	CUST.DATA.agentaddr1               = BANCS.INPUT.agentaddr1
	CUST.DATA.agentaddr2               = BANCS.INPUT.agentaddr2
	CUST.DATA.agentaddr3               = BANCS.INPUT.agentaddr3
	CUST.DATA.agentcitycode            = BANCS.INPUT.agentcitycode
	CUST.DATA.agentstatecode           = BANCS.INPUT.agentstatecode
	CUST.DATA.agentcntrycode           = BANCS.INPUT.agentcntrycode
	CUST.DATA.agentpin                 = BANCS.INPUT.agentpin
	CUST.DATA.crncycode                = BANCS.INPUT.crncycode
	CUST.DATA.operacctnum              = BANCS.INPUT.operacctnum
	CUST.DATA.inoperacctnum            = BANCS.INPUT.inoperacctnum
	CUST.DATA.itaxpcnt                 = BANCS.INPUT.itaxpcnt
	CUST.DATA.dummyintamtceiling       = CINT(BANCS.INPUT.dummyintamtceiling)
	CUST.DATA.dummysecurityamt         = CINT(BANCS.INPUT.dummysecurityamt)
	CUST.DATA.dummyexceptedcollection  = CINT(BANCS.INPUT.dummyexceptedcollection)
	CUST.DATA.noofacctopened           = BANCS.INPUT.noofacctopened
	CUST.DATA.freetext                 = BANCS.INPUT.freetext
	CUST.DATA.DATEL                    = MID$(BANCS.STDIN.sysDate,0,10)
	CUST.DATA.DrAcid                   = ""
	CUST.DATA.CrAcid                   = ""
	PRINT(CUST.DATA.DATEL)
	PRINT(CUST.DATA.funcCode)
	PRINT(CUST.DATA.agentcode)
	PRINT(CUST.DATA.crncyCode)
	PRINT(CUST.DATA.agenttitlecode)
	PRINT(CUST.DATA.agentname)
	PRINT(CUST.DATA.agentshortname)
	PRINT(CUST.DATA.agentphonenum)
	PRINT(CUST.DATA.agentaddr1)
	PRINT(CUST.DATA.agentaddr2)
	PRINT(CUST.DATA.agentaddr3)
	PRINT(CUST.DATA.agentcitycode)
	PRINT(CUST.DATA.agentstatecode)
	PRINT(CUST.DATA.agentcntrycode)
	PRINT(CUST.DATA.agentpin)
	PRINT(CUST.DATA.crncycode)
	PRINT(CUST.DATA.operacctnum)
	PRINT(CUST.DATA.inoperacctnum)
	PRINT(CUST.DATA.itaxpcnt)
	PRINT(CUST.DATA.dummyintamtceiling)
	PRINT(CUST.DATA.dummysecurityamt)
	PRINT(CUST.DATA.dummyexceptedcollection)
	PRINT(CUST.DATA.dummyintamtceiling)
	PRINT(CUST.DATA.noofacctopened)
	PRINT(CUST.DATA.freetext)

	IF(CUST.DATA.funcCode =="M") THEN
	#{
		CUST.DATA.del_flg = "N"

		IF(CUST.DATA.operacctnum !="")THEN
		#{
			sv_a= urhk_B2k_ForacidToAcid(CUST.DATA.operacctnum)
			IF(sv_a==0)THEN
			#{
				CUST.DATA.DrAcid = BANCS.OUTPARAM.Acid
				PRINT(CUST.DATA.DrAcid)
			#}
			ELSE
			#{
				CUST.DATA.drAcid = ""
			#}
			ENDIF
		#}
		ENDIF
		
		IF(CUST.DATA.inoperacctnum !="")THEN
                #{
			sv_b= urhk_B2k_ForacidToAcid(CUST.DATA.inoperacctnum)
			IF(sv_b==0)THEN
			#{
				CUST.DATA.CrAcid = BANCS.OUTPARAM.Acid
				PRINT(CUST.DATA.CrAcid)
			#}
			ELSE
			#{
				CUST.DATA.CrAcid = ""
			#}
			ENDIF
		#}
		ENDIF

		BANCS.INPARAM.BINDVARS = CUST.DATA.agenttitlecode +"|"+ CUST.DATA.agentname +"|"+ CUST.DATA.agentshortname
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.agentphonenum +"|"+ CUST.DATA.agentaddr1
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.agentaddr2 +"|"+ CUST.DATA.agentaddr3
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.agentcitycode +"|"+ CUST.DATA.agentstatecode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.agentcntrycode +"|"+ CUST.DATA.agentpin
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.crncycode +"|"+ CUST.DATA.DrAcid
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.CrAcid +"|"+ CUST.DATA.itaxpcnt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.dummyintamtceiling +"|"+ CUST.DATA.dummysecurityamt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.dummyexceptedcollection +"|"+ CUST.DATA.noofacctopened
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId +"|"+ CUST.DATA.DATEL
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.freetext +"|"+ CUST.DATA.agentcode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.crncyCode +"|"+ CUST.DATA.del_flg
		PRINT(BANCS.INPARAM.BINDVARS)
	
		sv_b = "UPDATE TBAADM.AGT SET AGENT_TITLE_CODE = ?SVAR,AGENT_NAME = ?SVAR,AGENT_SHORT_NAME = ?SVAR,"
		sv_b = sv_b + "AGENT_PHONE_NUM = ?SVAR,AGENT_ADDR1 = ?SVAR ,AGENT_ADDR2 = ?SVAR,AGENT_ADDR3 = ?SVAR ,"
		sv_b = sv_b + "AGENT_CITY_CODE  = ?SVAR,AGENT_STATE_CODE  = ?SVAR,AGENT_CNTRY_CODE  = ?SVAR,"
		sv_b = sv_b + "AGENT_PIN = ?SVAR,CRNCY_CODE = ?SVAR,OPER_CREDIT_ACID = ?SVAR,"
		sv_b = sv_b + "INOPER_CREDIT_ACID = ?SVAR,ITAX_PCNT = ?SVAR,INT_AMT_CEILING = ?SVAR,"
		sv_b = sv_b + "SECURITY_AMT = ?SVAR,EXPECTED_COLLECTION = ?SVAR,NO_OF_ACCT_OPENED = ?SVAR,"
		sv_b = sv_b + "LCHG_USER_ID = ?SVAR,LCHG_TIME = TO_DATE(?SVAR,'DD-MM-YYYY'),"
		sv_b = sv_b + "FREE_TEXT = ?SVAR WHERE AGENT_CODE = ?SVAR AND CRNCY_CODE = ?SVAR AND DEL_FLG = ?SVAR "
		PRINT(sv_b)

		sv_v = urhk_dbSQLWithBind(sv_b)
		PRINT(sv_v)

		IF(sv_v == 0)THEN
		#{
			sv_x = urhk_dbSQLWithBind("commit")
		#}
		ELSE
		#{
			sv_x = urhk_dbSQLWithBind("rollback")
			CUST.DATA.errMsg = "Updation failed"
		#}
		ENDIF

		CUST.DATA.errMsg                = ""
		CUST.DATA.resMsg                = "Agent Code "+CUST.DATA.agentcode+" and Currency "+CUST.DATA.crncycode+" modified successfully"
		IF(CUST.DATA.errMsg =="")THEN
		#{

			lv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
			lv_b = urhk_SetOrbOut("RESULT_MSG|" +CUST.DATA.resMsg)
		#}
		ELSE
		#{
			sv_z = "Error_03|ERROR^Unable to modify the record "
			sv_u = urhk_SetOrbOut(sv_z)
			GOTO ENDOFSCRIPT
		#}
		ENDIF

	#}
        ENDIF

	IF(CUST.DATA.funcCode =="D")THEN
	#{
		CUST.DATA.del_flg = "Y"
		BANCS.INPARAM.BINDVARS = CUST.DATA.del_flg +"|"+ BANCS.STDIN.userId +"|"+ CUST.DATA.DATEL
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.agentcode +"|"+ CUST.DATA.crncycode
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_b = "UPDATE TBAADM.AGT SET DEL_FLG = ?SVAR,LCHG_USER_ID = ?SVAR,LCHG_TIME = TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_b = sv_b + "WHERE AGENT_CODE = ?SVAR AND CRNCY_CODE = ?SVAR AND DEL_FLG = 'N' "
		PRINT(sv_b)

                sv_v = urhk_dbSQLWithBind(sv_b)
                PRINT(sv_v)
		
		IF(sv_v == 0)THEN
		#{
			sv_x = urhk_dbSQLWithBind("commit")
		#}
		ELSE
		#{
			sv_x = urhk_dbSQLWithBind("rollback")
			CUST.DATA.errMsg = "Updation failed"
		#}
		ENDIF
		
		CUST.DATA.errMsg = ""
                CUST.DATA.resMsg = "Agent Code "+CUST.DATA.agentcode+" and Currency "+CUST.DATA.crncycode+" deleted successfully"
                IF(CUST.DATA.errMsg =="")THEN
		#{
			lv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
                        lv_b = urhk_SetOrbOut("RESULT_MSG|" +CUST.DATA.resMsg)
                #}
                ELSE
                #{
               		sv_z = "Error_03|ERROR^Unable to delete the record "
                        sv_u = urhk_SetOrbOut(sv_z)
                        GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	IF(CUST.DATA.funcCode =="U")THEN
	#{
		CUST.DATA.del_flg = "N"
                BANCS.INPARAM.BINDVARS = CUST.DATA.del_flg +"|"+ BANCS.STDIN.userId +"|"+ CUST.DATA.DATEL
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.agentcode +"|"+ CUST.DATA.crncycode
                PRINT(BANCS.INPARAM.BINDVARS)

                sv_b = "UPDATE TBAADM.AGT SET DEL_FLG = ?SVAR,LCHG_USER_ID = ?SVAR,LCHG_TIME = TO_DATE(?SVAR,'DD-MM-YYYY') "
                sv_b = sv_b + "WHERE AGENT_CODE = ?SVAR AND CRNCY_CODE = ?SVAR AND DEL_FLG = 'Y' "
                PRINT(sv_b)

                sv_v = urhk_dbSQLWithBind(sv_b)
                PRINT(sv_v)

		IF(sv_v == 0)THEN
                #{
                	sv_x = urhk_dbSQLWithBind("commit")
                #}
                ELSE
                #{
			sv_x = urhk_dbSQLWithBind("rollback")
                        CUST.DATA.errMsg = "Updation failed"
		#}
		ENDIF
		CUST.DATA.errMsg = ""
                CUST.DATA.resMsg = "Agent Code "+CUST.DATA.agentcode+" and Currency "+CUST.DATA.crncycode+" undeleted successfully"
                IF(CUST.DATA.errMsg =="")THEN
		#{
			lv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
                        lv_b = urhk_SetOrbOut("RESULT_MSG|" +CUST.DATA.resMsg)
		#}
		ELSE
		#{
			sv_z = "Error_03|ERROR^Unable to delete the record "
                        sv_u = urhk_SetOrbOut(sv_z)
                        GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

ENDOFSCRIPT:
EXITSCRIPT
TRACE OFF
END-->

