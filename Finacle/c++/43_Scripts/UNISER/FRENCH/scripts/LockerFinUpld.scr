########################################################################################
# Source Name         			: LockerFinUpld.scr
# Author              			: Irungu James
# Date                			: 02-MAR-2022
# Title               			: Bulk Uplaod transfer through uploads
# Description         			: This Script selects records from uploaded CSV file and read the record

#   <Serial No.>     	<Date>         <Author Name>			<Description>
#	1		02-MAR-2022	Irungu James			Original version
#########################################################################################
<--START
CHECKSUM="d24e95e7718342acf32e641bbe97e61719499adbb752d202783f4d1a042b52e8"
	TRACE ON
	LIBNAME CUSTOMSO
	sv_u=urhk_B2k_PrintRepos("BANCS")
	print(sv_u)
	
	#--------------------------------------------------------------------------------------------------
	# Creating the log File
	#--------------------------------------------------------------------------------------------------
	sv_s = "startTime|"
	sv_s = sv_s + " SELECT TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') "
	sv_s = sv_s + " FROM DUAL"
	print(sv_s)
	sv_r = urhk_dbSelectWithBind(sv_s)
	print(sv_r)
	
	CUST.CATOD.startTime = BANCS.OUTPARAM.startTime
	CUST.CATOD.successlogFile = "Upload_Success_" + CUST.CATOD.startTime + ".log"
	CUST.CATOD.failurelogFile = "Upload_Failure_" + CUST.CATOD.startTime + ".log"
	print(CUST.CATOD.startTime)
	print(CUST.CATOD.successlogFile)
	print(CUST.CATOD.successlogFile)
	
	#--------------------------------------------------------------------------------------------------
	# Creating the Sucess and Failure report files
	#--------------------------------------------------------------------------------------------------
	sv_s = "touch " + CUST.CATOD.successlogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	
	sv_s = "touch " + CUST.CATOD.failurelogFile
	sv_d = SYSTEM(sv_s)
	print(sv_d)
	
	#=================================================================================*
	#	Start Reading the CSV file
	#=================================================================================*
	
	sv_o = urtn_fileOpen(CUST.CATOD.fileName + "|r")
	print(sv_o)
	IF (sv_o == 0) THEN
	#{
		CUST.CATOD.fileindex = sv_o
		print(CUST.CATOD.fileindex)
		print(CUST.CATOD.selectedRec)
		
		sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")

		IF(sv_x == 0) THEN
		#{
			sv_n = "1"
			sv_v = "Y"
			WHILE(sv_x==0)
			#{
				sv_c = 0
				print(CUST.CATOD.selectedRec)
				print(BANCS.OUTPARAM.buffer)
				CUST.CATOD.selectedRec = BANCS.OUTPARAM.buffer
				CUST.CATOD.recBackUp = CUST.CATOD.selectedRec
				print(CUST.CATOD.selectedRec)
				print(CUST.CATOD.recBackUp)
				#=================================================================================*
				# Reading the data from CSV file
				#=================================================================================*
				#sv_l = STRLEN(CUST.CATOD.selectedRec)
				#print(sv_l)

				CUST.CATOD.selectedRec = ltrim(rtrim(CUST.CATOD.selectedRec))
				print(CUST.CATOD.selectedRec)
				sv_l = STRLEN(CUST.CATOD.selectedRec)
				print(sv_l)
				IF (sv_l == 0)THEN
					GOTO NEXTREC
				ENDIF
				CUST.CATOD.selectedRec = CUST.CATOD.selectedRec + "|"
				print(CUST.CATOD.selectedRec)
				sv_z=CUST.CATOD.selectedRec
				sv_h="1"
				sv_t = 0
				WHILE(sv_l > 0)
				#{
					sv_l = STRLEN(sv_z)
					print(sv_l)
					sv_p = GETPOSITION(sv_z, "|")
					print(sv_p)
					sv_t = sv_t + 1
					print(sv_t)
					CUST.CATOD.numOfValues = sv_t
					print(CUST.CATOD.numOfValues)
					
					IF(sv_p==0)THEN
					#{
						sv_l=-1
						print(sv_l)
					#}
					ENDIF
					
					sv_a = LEFT$(sv_z, sv_p - 1)
					print(sv_a)
					CUST.CATOD.num=sv_h
					print(CUST.CATOD.num)
					("CUST").("CATOD").("fieldData" + CUST.CATOD.num) = sv_a
					print(sv_a)
					
					
					IF (CUST.CATOD.num=="1") THEN
					#{
						CUST.CATOD.FORACID=sv_a
						print(CUST.CATOD.FORACID)
					#}
					ENDIF
					IF (CUST.CATOD.num=="2") THEN
					#{
						CUST.CATOD.SOL_ID=sv_a
						print(CUST.CATOD.SOL_ID)
					#}
					ENDIF
					IF (CUST.CATOD.num=="3") THEN
					#{
						CUST.CATOD.NARRATION=sv_a
						print(CUST.CATOD.NARRATION)
					#}
					ENDIF
					IF (CUST.CATOD.num=="4") THEN
					#{
						CUST.CATOD.ACCT_CRNCY=sv_a
						print(CUST.CATOD.ACCT_CRNCY)
					#}
					ENDIF
					IF (CUST.CATOD.num=="5") THEN
					#{
						CUST.CATOD.REF_CRNCY_CODE=sv_a
						print(CUST.CATOD.REF_CRNCY_CODE)
					#}
					ENDIF
					IF (CUST.CATOD.num=="6") THEN
					#{
						CUST.CATOD.TRAN_TYPE=sv_a
						print(CUST.CATOD.TRAN_TYPE)
					#}
					ENDIF
					IF (CUST.CATOD.num=="7") THEN
					#{
						CUST.CATOD.REF_AMT=sv_a
						print(CUST.CATOD.REF_AMT)
					#}
					ENDIF
					IF (CUST.CATOD.num=="8") THEN
					#{
						CUST.CATOD.BACID=sv_a
						print(CUST.CATOD.BACID)
					#}
					ENDIF
					IF (CUST.CATOD.num=="9") THEN
					#{
						CUST.CATOD.FREE_TEXT1=sv_a
						print(CUST.CATOD.FREE_TEXT1)
					#}
					ENDIF

				
					sv_h=CINT(CUST.CATOD.num)+1
					print(sv_h)
					
					sv_z = RIGHT$(sv_z, STRLEN(sv_z) - sv_p)
					print(sv_z)
					sv_l=sv_l-sv_p
					print(sv_l)
					
					IF((sv_l == 0)AND(sv_h < 10))THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
				#}
				DO
				Print (CUST.CATOD.numOfValues)

				IF (CINT(CUST.CATOD.numOfValues) != 9) THEN
				#{				

					IF (CINT(CUST.CATOD.numOfValues) > 9) THEN
					#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						GOTO RECORDSEXCEED
						#}
					ELSE
						#{
						sv_v = "N"
						sv_c = sv_c + 1
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||" +"~" + "Invalid Record Structure"
						print(CUST.CATOD.errColl)
						CUST.CATOD.recBackUp="Record " +sv_n
						GOTO INVALID
					#}
					ENDIF
					
				#}
				ENDIF
								
				
				#--------------- Get Account number from the file ------------------------


				IF(FIELDEXISTS(CUST.CATOD.FORACID))THEN
					IF (CUST.CATOD.FORACID=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "FORACID  is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF
					sv_u = urhk_getAcctDetailsInRepository(CUST.CATOD.FORACID)
					print(sv_u)			
					IF (sv_u != 0) THEN
			
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "FORACID  Account is Invalid"
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					
					ENDIF
				 ENDIF
				 IF(FIELDEXISTS(CUST.CATOD.REF_AMT))THEN
					IF (CUST.CATOD.REF_AMT=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "REF_AMT is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF
					sv_s = "SpecChar|SELECT REGEXP_INSTR(?SVAR,'[^0-9 . ]') FROM dual  "
					BANCS.INPARAM.BINDVARS =  CUST.CATOD.REF_AMT
					sv_u = urhk_dbSelectWithBind(sv_s)
					IF (sv_d == 0) THEN
					CUST.CATOD.SpecChar=BANCS.OUTPARAM.SpecChar
					PRINT(CUST.CATOD.SpecChar)
						IF (CUST.CATOD.SpecChar > 0) THEN
							sv_v = "N"
							sv_c = sv_c + 1
							CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "REF_AMT is not in numeric format"
							GOTO INVALID
						ENDIF
					ENDIF
				 ENDIF
				IF(FIELDEXISTS(CUST.CATOD.FREE_TEXT1))THEN
					IF (CUST.CATOD.FREE_TEXT1=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "FREE_TEXT1  is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF
					sv_u = urhk_getAcctDetailsInRepository(CUST.CATOD.FREE_TEXT1)
					print(sv_u)			
					IF (sv_u != 0) THEN
			
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "FREE_TEXT1  Account is Invalid"
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					
					ENDIF
				 ENDIF				 
				 IF(FIELDEXISTS(CUST.CATOD.BACID))THEN
					IF (CUST.CATOD.BACID=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "BACID is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF					
				 ENDIF				
				IF(FIELDEXISTS(CUST.CATOD.NARRATION))THEN
					IF (CUST.CATOD.NARRATION=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "NARRATION is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF					
				 ENDIF
				 IF(FIELDEXISTS(CUST.CATOD.ACCT_CRNCY))THEN
					IF (CUST.CATOD.ACCT_CRNCY=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "ACCT_CRNCY is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF					
				 ENDIF
				 IF(FIELDEXISTS(CUST.CATOD.REF_CRNCY_CODE))THEN
					IF (CUST.CATOD.REF_CRNCY_CODE=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "REF_CRNCY_CODE is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF					
				 ENDIF				
				IF(FIELDEXISTS(CUST.CATOD.SOL_ID))THEN
					IF (CUST.CATOD.SOL_ID=="") THEN		
						CUST.CATOD.errColl = CUST.CATOD.errColl + "||||~" + "SOL_ID is Mandatory "
						sv_v = "N"
						sv_c = sv_c + 1
						GOTO INVALID
					ENDIF					
				 ENDIF

					
					CALL("LockerUpld.scr")
					print(CUST.CATOD.numOfValues)
					print(sv_c)
					IF ((CINT(CUST.CATOD.numOfValues) == 9 ) AND (sv_c == 0)) THEN
					#{
						sv_s = "echo" + " '" +  CUST.CATOD.recBackUp + "||||' >>" + " " + CUST.CATOD.successlogFile
						sv_d = system(sv_s)
						print(sv_d)
						#}
					ELSE
						#{
						GOTO INVALID
					#}
					ENDIF

					IF (CUST.CATOD.errColl != "") THEN
					#{
						GOTO INVALID
					#}
					ENDIF
				INVALID:
					print(sv_c)
					IF (sv_c  != 0 ) THEN
					#{
						
						CUST.CATOD.error = CUST.CATOD.recBackUp + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				RECORDSEXCEED:
					IF (sv_c  != 0 ) THEN
					#{
						CUST.CATOD.error = CUST.CATOD.fieldData1 + "|" + CUST.CATOD.errColl
						sv_s = "echo" + " '" +  CUST.CATOD.error + "' >>" + " " + CUST.CATOD.failurelogFile
						sv_d = system(sv_s)
						print(sv_r)
						CUST.CATOD.recBackUp = ""
						CUST.CATOD.errColl = ""
						GOTO NEXTREC
					#}
					ENDIF
				NEXTREC:
					#=================================================================================*
					# Reading the data from CSV file
					#=================================================================================*
					print(CUST.CATOD.fileindex)
					sv_x = urtn_fileRead(CUST.CATOD.fileindex + "|" + "BANCS.OUTPARAM.buffer")
					print(sv_x)
					print(sv_n)
					CUST.CATOD.recCnt = sv_n
					sv_n = CINT(CUST.CATOD.recCnt) + 1
					CUST.CATOD.recCnt = sv_n
					sv_n = CUST.CATOD.recCnt
					print(sv_n)
				#}
				DO
				sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
				sv_g = "RESULT_MSG|Upload Process Initiated Success fully - Check status in HPR after some time "
				print(sv_g)
				sv_z = urhk_SetOrbOut(sv_g)
				print(sv_z)
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				sv_e = "File Opened but Unable to Read."
				sv_m = "fileName"
				CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
				GOTO FAILURE
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_e = "Not able to open the file for upload."
			sv_m = "fileName"
			CUST.CATOD.errMsg = "Error_1|ERROR:^"+ sv_e +".^"+ sv_m +""
			GOTO FAILURE
		#}
		ENDIF
		
	FAILURE:
		sv_z = "SuccessOrFailure|N"
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		sv_z = CUST.CATOD.errMsg
		print(sv_z)
		sv_u = urhk_SetOrbOut(sv_z)
		print(sv_u)
		
		
	ENDOFSCRIPT:
		
		IF (CUST.CATOD.errMsg == "") THEN
		#{
			#==========================================================================*
			#Pushing the Reports to HPR menu
			#==========================================================================*
			#-----------------------------------
			# Report Generation
			#-----------------------------------
			
			sv_b = urhk_getEnv("FIN_REPORTS_DIR")
			print(sv_b)
			IF (sv_b==0) THEN
			#{
				CUST.CATOD.envValue = BANCS.OUTPARAM.envValue
				print(CUST.CATOD.envValue)
			#}
			ENDIF
			
			CUST.CATOD.envValue =CUST.CATOD.envValue
			print(CUST.CATOD.envValue)
			
			#sv_a = urhk_B2K_printRepos("CUST")
			#print(sv_a)
			
			#-----------------------------------
			# Success Report
			#-----------------------------------
			sv_s = "mrbx4004 $B2K_SESSION_ID LockerUploadSuc.mrt " + CUST.CATOD.successlogFile + " " + CUST.CATOD.successlogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.successlogFile = CUST.CATOD.successlogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/" + BANCS.STDIN.userId  +"/" + CUST.CATOD.successlogFile+  " 'SUCCESS Trade Fin Amrtization UPLD Report' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			#-----------------------------------
			# Failure Report
			#-----------------------------------
			
			sv_s = "mrbx4004 $B2K_SESSION_ID LockerUploadFai.mrt " + CUST.CATOD.failurelogFile + " " + CUST.CATOD.failurelogFile + "_RPT"
			print(sv_s)
			sv_d = SYSTEM(sv_s)
			print(sv_d)
			
			CUST.CATOD.failurelogFile = CUST.CATOD.failurelogFile + "_RPT.rpt"
			
			sv_x = "babx4040 $B2K_SESSION_ID " + CUST.CATOD.envValue + "/"+ BANCS.STDIN.userId +"/"+CUST.CATOD.failurelogFile+" 'FAILURE Trade Fin Amrtization UPLD Report' MANAGER 1 N"
			print(sv_x)
			sv_h = system(sv_x)
			PRINT (sv_h)
			
		#}
		ENDIF
		
		EXITSCRIPT
END-->
