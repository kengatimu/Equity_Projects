<--START

TRACE ON
sv_u = urhk_B2k_PrintRepos("BANCS")
print(sv_u)
sv_r = REPEXISTS("STDWFS")   
IF (sv_r == 0) THEN  
	CREATEREP("STDWFS")  
ENDIF

sv_r = CLASSEXISTS("STDWFS", "GLBDATA")  
IF (sv_r == 0) THEN  
	CREATECLASS("STDWFS", "GLBDATA", 5)  
ENDIF

####IF ((BANCS.INPUT.Foracid=="1000110042264") OR (BANCS.INPUT.Foracid=="1000110XXXXX022180") OR (BANCS.INPUT.Foracid=="1000110042220") OR (BANCS.INPUT.Foracid=="1000110042266") OR (BANCS.INPUT.Foracid=="1000110042285") OR (BANCS.INPUT.Foracid=="1000110042277") OR (BANCS.INPUT.Foracid=="1000110022270") OR (BANCS.INPUT.Foracid=="1000110042275")) THEN

STDWFS.GLBDATA.Foracid1="1000110042264"
print(STDWFS.GLBDATA.Foracid1)
sv_h = urhk_getAcctDetailsInRepository(STDWFS.GLBDATA.Foracid1)
print(sv_h)
IF (sv_h==0) THEN
		
sv_u = urhk_B2k_PrintRepos("BANCS")
print(sv_u)
sv_r = REPEXISTS("STDWFS")   
IF (sv_r == 0) THEN  
	CREATEREP("STDWFS")  
ENDIF
sv_r = CLASSEXISTS("STDWFS", "GLBDATA")  
IF (sv_r == 0) THEN  
	CREATECLASS("STDWFS", "GLBDATA", 5)  
ENDIF
		STDWFS.GLBDATA.solidsh = BANCS.OUTPARAM.acctSolId
		print(STDWFS.GLBDATA.solidsh)
		 
		STDWFS.GLBDATA.schmcodesh = BANCS.OUTPARAM.schmCode  
		print(STDWFS.GLBDATA.schmcodesh) 
		 
		STDWFS.GLBDATA.schmType = BANCS.OUTPARAM.schmType
		print(STDWFS.GLBDATA.schmType)   
		 
		STDWFS.GLBDATA.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
		print(STDWFS.GLBDATA.EffAvailableAmttr)  
		 
		STDWFS.GLBDATA.EffAvailableAmttr = cdouble(trim(STDWFS.GLBDATA.EffAvailableAmttr ))
		 
		print(STDWFS.GLBDATA.EffAvailableAmttr)  
		 
		IF (FIELDEXISTS(BANCS.INPUT.TranAmt) == 1) THEN
			print(BANCS.OUTPUT.TranAmt)
			STDWFS.GLBDATA.dedittr = cdouble(BANCS.INPUT.TranAmt)/cdouble("100") 
			print(STDWFS.GLBDATA.dedittr)

			sv_q = "sumamount|select (case when ('" + STDWFS.GLBDATA.dedittr + "' - '" + STDWFS.GLBDATA.EffAvailableAmttr + "')<0 then 'Y' else 'N' end) from dual 
			print(sv_q)
			sv_w=urhk_dbSelectWithBind(sv_q)
			if (sv_w == 0) then
				print("sumamount")
				STDWFS.GLBDATA.sumamount = BANCS.OUTPARAM.sumamount
				print(STDWFS.GLBDATA.sumamount)
				IF (STDWFS.GLBDATA.sumamount=="Y") THEN
					print(" less amount exit ")
					#BANCS.OUTPUT.RespCode = "99"
					#BANCS.OUTPUT.successOrFailure = "F"
					#exitscript
				ENDIF
			endif
		ENDIF
ENDIF

