#-------------------------------------------------------------------------------------    
#    Name				: getmoreinfo.scr
#    Description     	: This script will be called from the mrt for generating report 
#						: of tran details for given tran id, serial number and tran date. 
#						: Also employer short name for given employee ID. 
#    Date            	: 11-01-2013
#    Author          	: Rajavel
#    Input           	: BANCS.INPUT.lv_trandate ,BANCS.INPUT.lv_srlnum , BANCS.INPUT.lv_tranid 
#    Output				: BANCS.OUTPUT.lv_bacid ,BANCS.OUTPUT.refnum ,BANCS.OUTPUT.lv_datetime ,BANCS.OUTPUT.lv_username 
#					: BANCS.OUTPUT.lv_userlogedon , BANCS.OUTPUT.lv_PRINTid
#    Called Script	 	: NA
#    Calling Script	 	: NA
#    Menu Option		: NA
#    Srl. No		Date			Author			Description.   
#    -------		----			------			----------------
#    1.0		11-01-2013		Rajavel	 	Original Version
#------------------------------------------------------------------------------------- 
<--START
TRACE ON

BANCS.OUTPUT.lv_benename = " "
BANCS.OUTPUT.lv_beneid = " "
BANCS.OUTPUT.lv_benePhone= " "
BANCS.OUTPUT.lv_Billnum= " "
BANCS.OUTPUT.lv_senderName= " "
BANCS.OUTPUT.lv_senderPhone= " "
BANCS.OUTPUT.lv_accttype=" "
BANCS.INPUT.lv_trandate = MID$(BANCS.INPUT.lv_trandate,0,10)
PRINT(BANCS.INPUT.lv_trandate)

sv_s = "bacid,refnum,datetime,username,part_tran_srl_num,tranrmks,custname,trandate|SELECT bacid,ref_num,"
sv_s = sv_s + "pstd_date,emp_short_name,part_tran_srl_num,tran_rmks,SUBSTR(TRAN_PARTICULAR,INSTR(TRAN_PARTICULAR,' ')+1) cust_name, "
sv_s = sv_s + "to_CHAR(tran_date,'YYYYMMDD')tran_date "
sv_s = sv_s + "FROM TBAADM.GAM,TBAADM.DTD,TBAADM.GET,TBAADM.UPR "
sv_s = sv_s + "WHERE GAM.bank_id = ?SVAR "
sv_s = sv_s + "AND GAM.acid = DTD.acid "
sv_s = sv_s + "AND GAM.bank_id = DTD.bank_id "
sv_s = sv_s + "AND DTD.pstd_user_id = UPR.user_id "
sv_s = sv_s + "AND GET.emp_id= UPR.user_emp_id "
sv_s = sv_s + "AND DTD.tran_id = ?SVAR "
sv_s = sv_s + "AND DTD.part_tran_srl_num = ?SVAR "
sv_s = sv_s + "AND DTD.tran_date = to_date(?SVAR,'DD-MM-YYYY') "
sv_s = sv_s + "AND GAM.del_flg = 'N' "
sv_s = sv_s + "AND GAM.entity_cre_flg = 'Y' "
sv_s = sv_s + "AND GAM.acct_cls_flg = 'N' "
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.lv_tranid  + "|" + BANCS.INPUT.lv_srlnum  + "|" + BANCS.INPUT.lv_trandate
PRINT(BANCS.INPARAM.BINDVARS)
PRINT(sv_s)
sv_u = urhk_dbSelectWithBind(sv_s)
PRINT(sv_u)
IF (sv_u == 0) THEN
	BANCS.OUTPUT.lv_bacid = TRIM(BANCS.OUTPARAM.bacid)
	BANCS.OUTPUT.refnum = TRIM(BANCS.OUTPARAM.refnum)
	BANCS.OUTPUT.lv_datetime = BANCS.OUTPARAM.datetime
	BANCS.OUTPUT.lv_username = TRIM(BANCS.OUTPARAM.username)
	BANCS.OUTPUT.lv_tranrmks = BANCS.OUTPARAM.tranrmks
	BANCS.OUTPUT.lv_custname = BANCS.OUTPARAM.custname
	BANCS.OUTPUT.lv_vendordate = BANCS.OUTPARAM.trandate + trim(BANCS.INPUT.lv_tranid) +  "-" + "2"
	PRINT(BANCS.OUTPUT.lv_bacid)
	PRINT(BANCS.OUTPUT.refnum)
	PRINT(BANCS.OUTPUT.lv_datetime)
	PRINT(BANCS.OUTPUT.lv_username)
	PRINT(BANCS.OUTPUT.lv_tranrmks)
ELSE
	BANCS.OUTPUT.lv_bacid = " "
	BANCS.OUTPUT.refnum = " "
	BANCS.OUTPUT.lv_datetime = " "
	BANCS.OUTPUT.lv_username = " "
	BANCS.OUTPUT.lv_tranrmks = " "
	BANCS.OUTPUT.lv_custname = " "
	BANCS.OUTPUT.lv_vendordate = " "
ENDIF

#Getting the name of the user logged in 
PRINT(BANCS.STDIN.EmployeeId)
sv_s = "lv_userlogedon|"
sv_s = sv_s + "SELECT emp_short_name "
sv_s = sv_s + "FROM TBAADM.GET " 
sv_s = sv_s + "WHERE GET.emp_id = ?SVAR "
sv_s = sv_s + "AND GET.del_flg = 'N' "
sv_s = sv_s + "AND GET.entity_cre_flg = 'Y'"

BANCS.INPARAM.BINDVARS = BANCS.STDIN.EmployeeId
sv_r = urhk_dbSelectWithBind(sv_s)
PRINT(sv_r)

IF ( sv_r == "0" ) THEN
	BANCS.OUTPUT.lv_userlogedon = TRIM(BANCS.OUTPARAM.lv_userlogedon)
	BANCS.OUTPUT.lv_printid = TRIM(BANCS.STDIN.userId)
	PRINT(BANCS.OUTPUT.lv_userlogedon)
	PRINT(BANCS.OUTPUT.lv_printid)
ELSE
	BANCS.OUTPUT.lv_userlogedon = " "
	BANCS.OUTPUT.lv_printid= " "
ENDIF
IF(TRIM(BANCS.INPUT.schmcode) != "")THEN
#{
PRINT(BANCS.INPUT.schmcode)
sv_a = urhk_getSchemeDetailsInRepository(BANCS.INPUT.schmcode)
IF(sv_a ==0)THEN
#{
BANCS.OUTPUT.lv_accttype=BANCS.OUTPARAM.SchemeDescription
PRINT(BANCS.OUTPUT.lv_accttype)
#}
ENDIF
#}
ENDIF
TRACE OFF
EXITSCRIPT
END-->

