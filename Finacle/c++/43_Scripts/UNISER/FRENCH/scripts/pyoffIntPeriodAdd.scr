<--START

	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	IF(sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether WHT Class exists else create it
	###########################################################################################
	sv_c = CLASSEXISTS("CUST", "PYOFF")
	IF(sv_c == 0) THEN
	#{
		CREATECLASS("CUST", "PYOFF", 5)
	#}
	ENDIF
	
	CUST.PYOFF.acctNum = ""
	CUST.PYOFF.userDefinedDays = ""
	CUST.PYOFF.userDefinedMonths = ""
	IF(FIELDEXISTS(BANCS.INPUT.userDefinedDays))THEN
	#{
		IF (BANCS.INPUT.userDefinedDays != "")THEN
		#{
			CUST.PYOFF.userDefinedDays = BANCS.INPUT.userDefinedDays
			PRINT(CUST.PYOFF.userDefinedDays)
		#}
		ENDIF
	#}
	ENDIF
	IF(FIELDEXISTS(BANCS.INPUT.userDefinedMonths))THEN
	#{
		IF (BANCS.INPUT.userDefinedMonths != "")THEN
		#{
			CUST.PYOFF.userDefinedMonths = BANCS.INPUT.userDefinedMonths
			PRINT(CUST.PYOFF.userDefinedMonths)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF (BANCS.INPUT.acctNum != "")THEN
		#{
			CUST.PYOFF.acctNum = BANCS.INPUT.acctNum
			PRINT(CUST.PYOFF.acctNum)
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	CUST.PYOFF.errorFlg = "N"
	CUST.PYOFF.errorMsg = " "
	
	CUST.PYOFF.userId =  BANCS.STDIN.userId
	CUST.PYOFF.recCount = "0"
	CUST.PYOFF.modRecCount = "0"
	
	CUST.PYOFF.srno =""
	
	
	
	
	############################################################################
	#Insert into custom table
	############################################################################
	
	
	sv_s = "srno|select CUSTOM.C_PAYOFF_INT_SEQ.nextval from dual"
	
	BANCS.INPARAM.BINDVARS = ""
	
	sv_a = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_a)
	
	IF(sv_a == 0)THEN
	#{
		PRINT(BANCS.OUTPARAM.srno)
		CUST.PYOFF.srno = TRIM(BANCS.OUTPARAM.srno)
		
	#}
	ELSE
	#{
		PRINT("FAILED TO FETCH DATA FROM DB")
		CUST.PYOFF.errorFlg = "Y"
		CUST.PYOFF.errorMsg = "FAILED TO FETCH DATA FROM DB"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
		sv_s = "INSERT INTO CUSTOM.C_PAYOFF_INT_PERIOD(SRNO,ACCT_NUM,NUM_OF_DAYS,NUM_OF_MONTHS,RCRE_TIME,RCRE_USER_ID,LCHG_TIME,LCHG_USER_ID)"
		sv_s = sv_s + " VALUES(?SVAR,?SVAR,?SVAR,?SVAR,SYSDATE,?SVAR,SYSDATE,?SVAR)"
		BANCS.INPARAM.BINDVARS = CUST.PYOFF.srno   + "|" + CUST.PYOFF.acctNum + "|" + CUST.PYOFF.userDefinedDays + "|" + CUST.PYOFF.userDefinedMonths
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.userId 
		
		PRINT(BANCS.INPARAM.BINDVARS)
		PRINT(sv_s)
		
		sv_d = urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d != 0)THEN
		#{
			#ERROR
			CUST.PYOFF.errorFlg = "Y"
			CUST.PYOFF.errorMsg = "FAILED TO UPDATE DATA"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	
		
	ENDOFSCRIPT:
	
	PRINT(CUST.PYOFF.errorMsg)
	PRINT(CUST.PYOFF.errorFlg)
	IF(CUST.PYOFF.errorFlg =="Y")THEN
	#{
	
		sv_u = urhk_SetOrbOut("errMsg|"+ CUST.PYOFF.errorMsg)
		sv_u = urhk_SetOrbOut("errFlg|"+ CUST.PYOFF.errorFlg)
	#}
	ENDIF
	EXITSCRIPT
END-->
