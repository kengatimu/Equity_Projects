<--START
CHECKSUM="1aa54181614143a1a3339b3f3aa79e09ffcbd529c404aa1c4e796c008ac5fe80"
	TRACE ON
	
	#--------------------------------------------------------------------------
	#  Creation of MISS repository and CHRG class
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("BANCS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("BANCS")
	#}
	ENDIF
	
	sv_r = REPEXISTS("MISS")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("MISS")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MISS", "CHRG")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MISS", "CHRG", 5)
	#}
	ENDIF
	
	MISS.CHRG.SCHM = "CA235"

	#--------------------------------------------------------------------------
	# Selecting total number of accounts which are not charged
	#--------------------------------------------------------------------------
	
		sv_s = "dtd_Count|"
		sv_s = sv_s + " SELECT count(*) "
		sv_s = sv_s + " from  tbaadm.gam where ENTITY_CRE_FLG='Y' AND schm_code =?SVAR  and  BANK_ID=?SVAR  "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = MISS.CHRG.SCHM + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		sv_q = BANCS.OUTPARAM.dtd_Count
		print(sv_q)
		IF (sv_q == "0") THEN
		#{
			GOTO Finish
		#}
		ENDIF
		
		#--------------------------------------------------------------------------
		# Selecting accounts from DTD
		#--------------------------------------------------------------------------
		
		
		sv_s = "SettAcc ,OpAcc |"
		sv_s = sv_s + " select foracid , gac.FREE_TEXT_1  from tbaadm.gac , tbaadm.gam  where   schm_code  = ?SVAR    "
		sv_s = sv_s + "  and gac.acid = gam.acid   and gam.bank_id =gac.bank_id and gam.bank_id = ?SVAR  "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = MISS.CHRG.SCHM + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)		
		sv_o = urhk_dbCursorOpenWithBind(sv_s)
		print(sv_o)		
		print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
		MISS.CHRG.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		print(MISS.CHRG.MainCursor)
		
		#--------------------------------------------------------------------------
		# Initialise the Local Variables
		#--------------------------------------------------------------------------
		
		#------------------------------------------------------------------
		#  Variable Initialisation for counter. It should be Zero
		#------------------------------------------------------------------
		sv_z = 0
		#------------------------------------------------------------------
		#  Variable Initialisation for credit amount to the bank income
		#  account. It should be Zero.
		#------------------------------------------------------------------
		MISS.CHRG.done = "N"
		
		
		#--------------------------------------------------------------------------
		# Initialise the MTT repository
		#--------------------------------------------------------------------------
			

		sv_u = urhk_MTTS_PopulateInputDetails("")
		print(sv_u)
		
		MTT.TranDetails.TranDate="0"
		MTT.TranDetails.TranType = "T"
		MTT.TranDetails.TranSubType = "BI"
		MTT.TranDetails.Remarks = "WU Settlement"
		MTT.TranDetails.IgnoreExcp = "I"
		MTT.TranDetails.PSTUpdateFlg ="N"	
		
		sv_v = "bCashWithCrg"
		print(sv_v)
		
		sv_u = urhk_MTTS_DefineTransaction("bCashWithCrg")
		
		#--------------------------------------------------------------------------
		# MTT code for creating tranxs like individual debit from customer and
		# consolidated credit to the income Account.
		#--------------------------------------------------------------------------
		
		WHILE (sv_o == 0)
		#{
			sv_c = urhk_dbCursorFetch(MISS.CHRG.MainCursor)
			print(sv_c)
			IF (sv_c != 0) THEN
			#{
				sv_r = urhk_MTTS_EndDefinition("")
				print(sv_r)
				
				
				print(sv_c)
				sv_o = 1
				
				#}
			ELSE
				#{
				
				MISS.CHRG.OpAcc =BANCS.OUTPARAM.OpAcc
				print(MISS.CHRG.OpAcc)				
				MISS.CHRG.SettAcc =BANCS.OUTPARAM.SettAcc
				print(MISS.CHRG.SettAcc)				

				sv_h = urhk_getAcctDetailsInRepository(MISS.CHRG.OpAcc)
				print(sv_h)
				IF (sv_h==0) THEN
					MISS.CHRG.OpAval = BANCS.OUTPARAM.EffAvailableAmt
					print(MISS.CHRG.OpAval)
				ENDIF				
				sv_h = urhk_getAcctDetailsInRepository(MISS.CHRG.SettAcc)
				print(sv_h)
				IF (sv_h==0) THEN
					MISS.CHRG.SettAval = BANCS.OUTPARAM.EffAvailableAmt
					print(MISS.CHRG.SettAval)
					MISS.CHRG.transaction_currencycode= BANCS.OUTPARAM.acctCrncyCode
					Print(MISS.CHRG.transaction_currencycode)

					IF ( CDOUBLE(MISS.CHRG.SettAval) == CDOUBLE ("0")) then
						GOTO STEP3
					ENDIF
				ENDIF

				IF ( CDOUBLE(MISS.CHRG.SettAval) < CDOUBLE ("0") ) then 
					MISS.CHRG.transactionamount = MISS.CHRG.SettAval
					MISS.CHRG.credit_accountid = MISS.CHRG.SettAcc
					MISS.CHRG.charge_acc = MISS.CHRG.OpAcc
					IF (cdouble(MISS.CHRG.OpAval) >  CDOUBLE ("0") ) then						
						IF (Cdouble(MISS.CHRG.transactionamount) > cdouble(MISS.CHRG.OpAval))THEN
							MISS.CHRG.transactionamount= MISS.CHRG.OpAval
						ENDIF					
					ELSE
						Print ("No Funds")
						GOTO STEP3
					ENDIF				
				ELSE				
					MISS.CHRG.transactionamount = MISS.CHRG.SettAval
					MISS.CHRG.credit_accountid =  MISS.CHRG.OpAcc
					MISS.CHRG.charge_acc = MISS.CHRG.SettAcc
				ENDIF


				MISS.CHRG.rate="0"
				MISS.CHRG.ratecode="MEAN"
					
				MISS.CHRG.stamp = "Y"
				
				#------------------------------------------
				# counter setting for defining different PartTran
				#------------------------------------------
				sv_z = sv_z + 1
				MISS.CHRG.Counter = sv_z
				
				#--------------------------------------------------------------------------
				# Create the narration
				#--------------------------------------------------------------------------
							
				MISS.CHRG.narr1 = "Sweep btw "  + MISS.CHRG.credit_accountid   + " and  " + MISS.CHRG.charge_acc
				MISS.CHRG.parttrnrmks = MISS.CHRG.credit_accountid   + "/" + MISS.CHRG.charge_acc
				MISS.CHRG.narr2 = "WU Transit Account Sweep"				
				
				#------------------------------------------------------------------
				#  Credit Partran customer 1
				#------------------------------------------------------------------
				print(MISS.CHRG.credit_accountid)
				MTT.PartTranDetails.Account = MISS.CHRG.credit_accountid
				print(MTT.PartTranDetails.Account)
				MTT.PartTranDetails.RefCurrency = MISS.CHRG.transaction_currencycode
				MTT.PartTranDetails.RateCode ="TTB"
				MTT.PartTranDetails.Rate = ""
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = MISS.CHRG.narr1
				#MTT.PartTranDetails.Particulars2 = MISS.CHRG.narr2
				MTT.PartTranDetails.RefAmount = cdouble(MISS.CHRG.transactionamount)
				print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = MISS.CHRG.parttrnrmks
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
				sv_e = "Credt" + MISS.CHRG.Counter
				print(sv_e)
				sv_r = urhk_MTTS_definePartTran(sv_e)
				print(sv_r)
				IF(sv_r != 0) THEN
				#{
					MISS.CHRG.finalstatus="E"
					print(MISS.CHRG.finalstatus)
					MISS.CHRG.error_desc="Transaction not Posted check data"
					print(MISS.CHRG.error_desc)
					GOTO STEP3
				#}
				ENDIF
				
				
				#------------------------------------------------------------------
				# Debit Partran customer 1
				#------------------------------------------------------------------
				
				print(MISS.CHRG.charge_acc)
				MTT.PartTranDetails.Account = MISS.CHRG.charge_acc
				MTT.PartTranDetails.RefCurrency = MISS.CHRG.transaction_currencycode
				MTT.PartTranDetails.RateCode = "TTB"
				MTT.PartTranDetails.Rate = ""
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = MISS.CHRG.narr1
				#MTT.PartTranDetails.Particulars2 = MISS.CHRG.narr2
				sv_a = cdouble(MISS.CHRG.transactionamount)
				print(sv_a)
				sv_a = -(sv_a)
				print(sv_a)
				MTT.PartTranDetails.RefAmount = sv_a
				print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = MISS.CHRG.parttrnrmks
				##MTT.PartTranDetails.RefNum = MISS.CHRG.id
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
				sv_h = "Debit" + MISS.CHRG.Counter
				print(sv_h)
				sv_u = urhk_MTTS_definePartTran(sv_h)
				print(sv_u)
				IF(sv_u != 0) THEN
				#{
					MISS.CHRG.finalstatus="E"
					print(MISS.CHRG.finalstatus)
					MISS.CHRG.error_desc="Transaction not Posted check data"
					print(MISS.CHRG.error_desc)
					GOTO STEP3
				#}
				ENDIF
				
				#######
				
				sv_r = urhk_MTTS_EndDefinition("")
				print(sv_r)
				
				sv_r = urhk_MTTS_HandleExceptions("POST")
				print(sv_r)
				
				IF (FIELDEXISTS(BANCS.OUTPARAM.tranId) == 1) THEN
				#{
					print(BANCS.OUTPARAM.tranId)
				#}
				ENDIF
				
				IF (FIELDEXISTS(BANCS.OUTPARAM.MTTTranId) == 1) THEN
					MISS.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
					print(MISS.CHRG.tranid)					
					print(BANCS.STDIN.userId)					
					print(BANCS.STDIN.sysDate)					
					print(BANCS.STDIN.BODDate)					
				ELSE								
					MISS.CHRG.tranid="NULL"
				ENDIF

				########
				STEP3:
			#}
			ENDIF
		#}
		DO
		
		sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor)
		Finish:

EXITSCRIPT
END-->