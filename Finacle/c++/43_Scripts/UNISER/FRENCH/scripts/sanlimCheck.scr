<--START
TRACE ON
	IF (REPEXISTS("CUST") == 0) THEN
	#{
        	CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
        	CREATECLASS ("CUST","DATA",5)
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","RATE") == 0) THEN
	#{
        	CREATECLASS ("CUST","RATE",5)
	#}
	ENDIF

        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.acctNum = " "
        CUST.DATA.chrgCrncy = " "
        CUST.DATA.chrgAmt = "0"
        CUST.DATA.vatCrncy = " "
        CUST.DATA.vatAmt = "0"
	CUST.DATA.chrgPcnt = "0"
	CUST.DATA.funcCode = " "

        IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
        #{
                IF(BANCS.INPUT.acctNum !="")THEN
                #{
                        CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
                        PRINT(CUST.DATA.acctNum)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Account Number not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Account Number not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.ChrgAmt))THEN
        #{
                IF(BANCS.INPUT.ChrgAmt !="")THEN
                #{
                        CUST.DATA.ChrgAmt = TOUPPER(TRIM(BANCS.INPUT.ChrgAmt))
                        PRINT(CUST.DATA.ChrgAmt)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	IF(CDOUBLE(CUST.DATA.ChrgAmt) == CDOUBLE("0"))THEN
	#{
                CUST.DATA.errFlg = "N"
                CUST.DATA.errMsg = " "
		GOTO ENDOFSCRIPT
	#}
	ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.ChrgCrncy))THEN
        #{
                IF(BANCS.INPUT.ChrgCrncy !="")THEN
                #{
                        CUST.DATA.ChrgCrncy = TOUPPER(TRIM(BANCS.INPUT.ChrgCrncy))
                        PRINT(CUST.DATA.ChrgCrncy)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.vatAmt))THEN
        #{
                IF(BANCS.INPUT.vatAmt !="")THEN
                #{
                        CUST.DATA.vatAmt = TOUPPER(TRIM(BANCS.INPUT.vatAmt))
                        PRINT(CUST.DATA.vatAmt)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.vatCrncy))THEN
        #{
                IF(BANCS.INPUT.vatCrncy !="")THEN
                #{
                        CUST.DATA.vatCrncy = TOUPPER(TRIM(BANCS.INPUT.vatCrncy))
                        PRINT(CUST.DATA.vatCrncy)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.chrgPcnt))THEN
        #{
                IF(BANCS.INPUT.chrgPcnt !="")THEN
                #{
                        CUST.DATA.chrgPcnt = TOUPPER(TRIM(BANCS.INPUT.chrgPcnt))
                        PRINT(CUST.DATA.chrgPcnt)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.vFuncCode))THEN
        #{
                IF(BANCS.INPUT.vFuncCode !="")THEN
                #{
                        CUST.DATA.funcCode = TOUPPER(TRIM(BANCS.INPUT.vFuncCode))
                        PRINT(CUST.DATA.funcCode)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Function code not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Function Code not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.newsanctLim))THEN
        #{
                IF(BANCS.INPUT.newsanctLim !="")THEN
                #{
                        CUST.DATA.newsanctLim = TOUPPER(TRIM(BANCS.INPUT.newsanctLim))
                        PRINT(CUST.DATA.newsanctLim)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Function code not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Function Code not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	IF(CUST.DATA.funcCode == "X")THEN
	#{
		sv_s = "DELETE FROM CUSTOM.SANLIM_TRAN WHERE BANK_ID=?SVAR AND ODACCT_NUM=?SVAR AND POST_FLG='N'"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum
                PRINT(sv_s)
                PRINT(BANCS.INPARAM.BINDVARS)
                sv_q = urhk_dbSQLWithBind(sv_s)
                PRINT(sv_q)
                IF(sv_q != 0)THEN
                #{

                        CUST.DATA.errFlg = "N"
                        CUST.DATA.errMsg = "Record Deletion failed"
                #}
                ENDIF
		GOTO ENDOFSCRIPT
        #}
        ENDIF



	sv_s = "intDrAccnt|SELECT FORACID FROM TBAADM.GAC,TBAADM.GAM WHERE GAC.BANK_ID=?SVAR AND GAM.ACID=GAC.INT_DR_ACID AND GAM.BANK_ID=GAC.BANK_ID AND "
	sv_s = sv_s + "GAC.ACID=(SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR)"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum
        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
		CUST.DATA.intDrAccnt = BANCS.OUTPARAM.intDrAccnt
	#}
	ELSE
	#{
                 CUST.DATA.errFlg = "Y"
                 CUST.DATA.errMsg = "Interest Debit account not mapped to :"+CUST.DATA.acctNum
                 GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.intDrAccnt)

	IF(sv_u == "0")THEN
	#{
		CUST.DATA.avlblAmt = BANCS.OUTPARAM.EffAvailableAmt
		PRINT(CUST.DATA.avlblAmt)
		CUST.DATA.intCrncy = BANCS.OUTPARAM.acctCrncyCode
		PRINT(CUST.DATA.intCrncy)
	#}
        ELSE
        #{
                 CUST.DATA.errFlg = "Y"
                 CUST.DATA.errMsg = "Interest Debit account not mapped to :"+CUST.DATA.acctNum
                 GOTO ENDOFSCRIPT
        #}
        ENDIF

	CUST.DATA.totalAmt = CDOUBLE(CUST.DATA.ChrgAmt) + CDOUBLE(CUST.DATA.vatAmt)
	PRINT(CUST.DATA.totalAmt)

	IF(CUST.DATA.intCrncy != CUST.DATA.ChrgCrncy)THEN
	#{
	        CUST.RATE.acctCrncy = CUST.DATA.ChrgCrncy
                CUST.RATE.refCrncy = CUST.DATA.intCrncy
                CUST.RATE.TranType = "T"
                CALL("fetchRateCode.scr")
                IF(CUST.RATE.errorFlg != "Y")THEN
                #{
                        CUST.DATA.rateCode      =       CUST.RATE.rateCode
                        CUST.DATA.rate          =       CUST.RATE.rate
                #}
                ENDIF

                PRINT(CUST.DATA.totalAmt)
                BANCS.INPARAM.InputAmount  = CUST.DATA.totalAmt
                BANCS.INPARAM.FromCurrency = CUST.DATA.ChrgCrncy
                BANCS.INPARAM.ToCurrency   = CUST.DATA.intCrncy
                BANCS.INPARAM.RateCode     = CUST.DATA.rateCode
                BANCS.INPARAM.Rate         = CDOUBLE("0.0")
                #----------------------------------------------------------------------
                #Convert The Amount Into operative account currency 
                #----------------------------------------------------------------------
                lv_f = urhk_B2k_ConvertAmount("")
                IF(lv_f == 0)THEN
                #{
                        CUST.DATA.totalAmt = BANCS.OUTPARAM.OutputAmount
                        PRINT(CUST.DATA.totalAmt)
                #}
                ENDIF

                BANCS.INPARAM.InputAmount  = CUST.DATA.newsanctLim
                BANCS.INPARAM.FromCurrency = CUST.DATA.ChrgCrncy
                BANCS.INPARAM.ToCurrency   = CUST.DATA.intCrncy
                BANCS.INPARAM.RateCode     = CUST.DATA.rateCode
                BANCS.INPARAM.Rate         = CDOUBLE("0.0")
                #----------------------------------------------------------------------
                #Convert The Amount Into operative account currency 
                #----------------------------------------------------------------------
                lv_f = urhk_B2k_ConvertAmount("")
                IF(lv_f == 0)THEN
                #{
                        CUST.DATA.newsanctLim = BANCS.OUTPARAM.OutputAmount
                        PRINT(CUST.DATA.newsanctLim)
                #}
                ENDIF
	#}
	ENDIF	

	CUST.DATA.avlblAmt = CDOUBLE(CUST.DATA.avlblAmt) + CDOUBLE(CUST.DATA.newsanctLim)
	PRINT(CUST.DATA.avlblAmt)
	#IF(CUST.DATA.funcCode == "V")THEN
	#{
		IF(CDOUBLE(CUST.DATA.totalAmt) > CDOUBLE(CUST.DATA.avlblAmt))THEN
		#{
                 	CUST.DATA.errFlg = "Y"
                 	CUST.DATA.errMsg = "No sufficient balance to collect Charge and VAT, Modification not allowed"
                 	GOTO ENDOFSCRIPT
		#}
		ENDIF
        #}
        #ENDIF

	IF(CDOUBLE(CUST.DATA.totalAmt) != CDOUBLE("0.0"))THEN
	#{

		sv_s = "recCount|SELECT COUNT(*) FROM CUSTOM.SANLIM_TRAN WHERE BANK_ID=?SVAR AND ODACCT_NUM=?SVAR AND POST_FLG = 'N' AND CHRG_INIT_MENU = ?SVAR"
        	BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum+"|"+ BANCS.STDIN.menuId
                PRINT(sv_s)
                PRINT(BANCS.INPARAM.BINDVARS)
                sv_q = urhk_dbSelectWithBind(sv_s)
                PRINT(sv_q)
                IF(sv_q == 0)THEN
                #{

                        CUST.DATA.recCount= BANCS.OUTPARAM.recCount
                #}
                ENDIF

		IF(CUST.DATA.recCount != "0")THEN
		#{
			sv_s = "DELETE FROM CUSTOM.SANLIM_TRAN WHERE BANK_ID=?SVAR AND ODACCT_NUM=?SVAR AND POST_FLG = 'N' AND CHRG_INIT_MENU = ?SVAR"
	                BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum+"|"+ BANCS.STDIN.menuId
	                sv_q = urhk_dbSQLWithBind(sv_s)
       		        PRINT(sv_q)
       		        IF(sv_q != 0)THEN
                	#{
				

                        CUST.DATA.errFlg = "N"
                        CUST.DATA.errMsg = "Table insertion failed"
			#}
			ENDIF
                #}
                ENDIF



        	sv_s = "INSERT INTO CUSTOM.SANLIM_TRAN(ODACCT_NUM,OPACCT_NUM,CHRG_AMT,CHRG_CRNCY_CODE,VAT_AMT,CHRG_PACNT,TRAN_ID,TRAN_AMT,TRAN_DATE,CHRG_REASON,"
		sv_s = sv_s + "CHRG_INIT_MENU,POST_FLG,BANK_ID,RCRE_USER_ID,RCRE_TIME) "
        	sv_s = sv_s + "VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,null,null,null,null,?SVAR,'N',?SVAR,?SVAR,sysdate)"

        	BANCS.INPARAM.BINDVARS = CUST.DATA.acctNum+"|"+CUST.DATA.intDrAccnt+"|"+CUST.DATA.ChrgAmt+"|"+CUST.DATA.ChrgCrncy +"|"+ CUST.DATA.vatAmt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+"|"+CUST.DATA.chrgPcnt +"|"+ BANCS.STDIN.menuId +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.userId

        	PRINT(sv_s)
        	PRINT(BANCS.INPARAM.BINDVARS)
        	sv_q = urhk_dbSQLWithBind(sv_s)
        	PRINT(sv_q)
        	IF(sv_q != 0)THEN
        	#{

			CUST.DATA.errFlg = "N"
			CUST.DATA.errMsg = "Table insertion failed"
		#}
		ENDIF
	#}
	ENDIF

ENDOFSCRIPT:
        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
TRACE OFF
END-->
