<--START
	# Script body goes here

	TRACE ON

	sv_r=urhk_B2k_PrintRepos("BANCS")
	print(sv_r)
	
	#==================================================================================================
	# Repository and Class Creation
	#==================================================================================================
	IF (REPEXISTS("CUST")== 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST" , "DATA",5)
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","RATE") == 0) THEN
	#{
		CREATECLASS("CUST" , "RATE",5)
	#}
	ENDIF


CUST.DATA.chrgAmt="0.00"
CUST.DATA.eventId=" "
CUST.DATA.chargeamt="0"
CUST.DATA.errFlg=" "
CUST.DATA.errMsg=" "
CUST.DATA.eventid=" "

CUST.RATE.acctCrncy=""
CUST.RATE.refCrncy=BANCS.INPUT.remitCrncy
CUST.RATE.TranType="T"
BANCS.INPUT.inputCrncy =CUST.RATE.refCrncy
CUST.DATA.chrgacc=BANCS.INPUT.drAccount
CUST.DATA.remitamt=BANCS.INPUT.remitAmt
CUST.DATA.tranccy=BANCS.INPUT.remitCrncy


BANCS.OUTPUT.eventid=""
BANCS.OUTPUT.errFlg=""
BANCS.OUTPUT.errMsg=""

IF (FIELDEXISTS(BANCS.INPUT.drAccount)) THEN

		 sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.drAccount)
                PRINT(sv_u)

                IF(sv_u == 0)THEN
                #{
			BANCS.INPUT.SOLID=BANCS.OUTPARAM.acctSolId
			CUST.DATA.EffAvailableAmt=BANCS.OUTPARAM.EffAvailableAmt
			CUST.RATE.acctCrncy=BANCS.OUTPARAM.acctCrncyCode

                        print(BANCS.INPUT.SOLID)
                        print(CUST.RATE.acctCrncy)



	sv_s =""
	sv_s = sv_s + " SET_ID | select SET_ID from tbaadm.sst where Sol_id='"+BANCS.INPUT.SOLID+"' and bank_id='"+BANCS.STDIN.contextBankId+"' and set_id ='BCDC'  and rownum=1"
	print(sv_s)
	sv_u = urhk_dbselectwithBind(sv_s)
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
			BANCS.INPUT.SET_ID=BANCS.OUTPARAM.SET_ID
			print(BANCS.INPUT.SET_ID)
		else

			BANCS.INPUT.SET_ID="0"

	#}
	ENDIF



			IF(BANCS.INPUT.SET_ID=="BCDC") then
				call("pordmpod_bcdc_fetch_chrgevnt.scr")

				IF(CUST.DATA.eventid != "" ) then
				call("PORDMcalcChrgAndVAT.scr")
				goto ENDOFSCRIPT
				ENDIF
			ELSE

				BANCS.INPUT.inputCrncy= CUST.RATE.acctCrncy #CUST.DATA.tranccy
				print(BANCS.INPUT.inputCrncy)
				call("pordmpod_ecb_fetch_chrgevnt.scr")
				call("PORDMcalcChrgAndVAT.scr")
				goto ENDOFSCRIPT


			ENDIF

                ELSE

                        CUST.DATA.custId=""
                #}
                ENDIF


ELSE
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Customer Account Not Entered"
                        GOTO ENDOFSCRIPT

ENDIF


ENDOFSCRIPT:
        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
        sv_u = urhk_SetOrbOut("eventid|"+CUST.DATA.eventid)
        sv_u = urhk_SetOrbOut("chargeamt|"+CUST.DATA.chrgAmt)
        sv_u = urhk_SetOrbOut("vatAmt|"+CUST.DATA.vatAmt)
        sv_u = urhk_SetOrbOut("evntChrgCrncy|"+CUST.DATA.evntChrgCrncy)

		EXITSCRIPT
		TRACE OFF
END-->


