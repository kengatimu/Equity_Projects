<--start
trace on
sv_r = urhk_B2k_PrintRepos("BANCS")
PRINT(sv_r)
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	EBSRV.GLBDATA.tranType=BANCS.OUTPARAM.srvValue
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	EBSRV.GLBDATA.tranSubType=BANCS.OUTPARAM.srvValue
	if ((EBSRV.GLBDATA.tranSubType == "CI") or (EBSRV.GLBDATA.tranSubType=="BI") or (EBSRV.GLBDATA.tranSubType=="NR") or (EBSRV.GLBDATA.tranSubType=="NP") or (EBSRV.GLBDATA.tranSubType =="I")) then

	sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
	sv_i = BANCS.OUTPARAM.srvValue
	print(sv_i)
	sv_p = 1
	sv_j = 0
	sv_p = FORMAT$(sv_p,"%d")
	sv_j = FORMAT$(sv_j,"%d")
	while(sv_j < sv_i)
	#{

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.partTranType.code")
			EBSRV.GLBDATA.CrDrcode=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.CrDrcode)

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.key.serial_num")
			EBSRV.GLBDATA.serialnum=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.serialnum)

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.acctId.foracid")
			EBSRV.GLBDATA.foracid=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.foracid)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.tranAmt")
			EBSRV.GLBDATA.tran_amt=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_amt)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j +">.partTranType.code")
			EBSRV.GLBDATA.partTranType=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.partTranType)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranRmks")
			EBSRV.GLBDATA.tran_rmks=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tran_rmks)
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars")
			EBSRV.GLBDATA.tranParticulars=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars)
		if(EBSRV.GLBDATA.tranSubType=="NR")then
			if(EBSRV.GLBDATA.CrDrcode=="C")then
				print(EBSRV.GLBDATA.tranParticulars)
				EBSRV.GLBDATA.tranParticulars = "Depot en cash," + EBSRV.GLBDATA.tranParticulars
				print(EBSRV.GLBDATA.tranParticulars)
				sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars )
			endif
		endif
		#------TCI Edwin
		if(EBSRV.GLBDATA.tranSubType=="CI")then
			print(EBSRV.GLBDATA.tranParticulars)
			EBSRV.GLBDATA.tranParticulars = "Virement interne," + EBSRV.GLBDATA.tranParticulars
			print(EBSRV.GLBDATA.tranParticulars)
			if(EBSRV.GLBDATA.CrDrcode=="D")then
				EBSRV.GLBDATA.Dforacid=EBSRV.GLBDATA.foracid
				print(EBSRV.GLBDATA.Dforacid)
				sv_b = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.Dforacid)	
				if(sv_b == 0)then
					EBSRV.GLBDATA.DName = BANCS.OUTPARAM.acctName	
					print(EBSRV.GLBDATA.DName)
				endif
			else
				EBSRV.GLBDATA.Cforacid=EBSRV.GLBDATA.foracid
                                print(EBSRV.GLBDATA.Cforacid)
                                sv_b = urhk_getAcctDetailsInRepository(EBSRV.GLBDATA.Cforacid)
                                if(sv_b == 0)then
                                        EBSRV.GLBDATA.CName = BANCS.OUTPARAM.acctName
                                        print(EBSRV.GLBDATA.CName)
                                endif
			endif	
                endif
		#------Edwin
		if(EBSRV.GLBDATA.tranSubType=="NP")then
			if(EBSRV.GLBDATA.CrDrcode=="D")then
				print(EBSRV.GLBDATA.tranParticulars)
				sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.instrmnt.instrmntNum")
				EBSRV.GLBDATA.instrmntNum=BANCS.OUTPARAM.srvValue
				print(EBSRV.GLBDATA.instrmntNum)
				IF ((EBSRV.GLBDATA.instrmntNum!="") AND (EBSRV.GLBDATA.instrmntNum!=" ")) THEN
					EBSRV.GLBDATA.instrmntNum = rtrim(ltrim(EBSRV.GLBDATA.instrmntNum))
					print(EBSRV.GLBDATA.instrmntNum)
					EBSRV.GLBDATA.tranParticulars = "Retrait Cheques," + EBSRV.GLBDATA.instrmntNum + " " + EBSRV.GLBDATA.tranParticulars
					print(EBSRV.GLBDATA.tranParticulars)
					sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars )
					print(sv_u)
				ELSE
					EBSRV.GLBDATA.tranParticulars = "Retrait en cash," + EBSRV.GLBDATA.tranParticulars
					print(EBSRV.GLBDATA.tranParticulars)
					sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars|" + EBSRV.GLBDATA.tranParticulars )
					print(sv_u)
				ENDIF
			endif
		endif

		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2")
			EBSRV.GLBDATA.tranParticulars2=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.tranParticulars2)
			if ((EBSRV.GLBDATA.tranSubType=="NP") OR (EBSRV.GLBDATA.tranSubType=="NR")) then
				EBSRV.GLBDATA.tranParticulars2=" "
				print(EBSRV.GLBDATA.tranParticulars2)
				sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.tranParticulars2|" + EBSRV.GLBDATA.tranParticulars2 )
				print(sv_u)
			endif
		sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL.<rec_" + sv_j + ">.delFlg")
			EBSRV.GLBDATA.recDelYN=BANCS.OUTPARAM.srvValue
			print(EBSRV.GLBDATA.recDelYN)
	sv_j = CINT(sv_j) + 1
	sv_j = FORMAT$(sv_j,"%d")
	#}
	DO
	endif
