	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------
#TAX

	IF (FIELDEXISTS(CUST.ATM.solid) == 1) THEN
		CUST.ATM.solId = mid$(CUST.ATM.solid,0,2)
		print(CUST.ATM.solId)
		if (CUST.ATM.solId == "15")then
			CUST.ATM.Tax_account="347010005"
			print(CUST.ATM.Tax_account)
		else
			CUST.ATM.Tax_account="340011434"
			print(CUST.ATM.Tax_account)
		endif
		CUST.ATM.Tax_accountGL = CUST.ATM.solid + CUST.ATM.Tax_account
		print(CUST.ATM.Tax_accountGL)
	ENDIF


call("copyBancsToCustC24.scr")

#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------

	IF(REPEXISTS("MTT") == 0 ) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF

          
	IF (CLASSEXISTS("MTT","TranDetails")==0) THEN
	#{
		CREATECLASS("MTT","TranDetails",5)
	#}
	ENDIF  
	
	IF (CLASSEXISTS("MTT","PartTranDetails")==0) THEN
	#{
		CREATECLASS("MTT","PartTranDetails",5)
	#}
	ENDIF

	IF (REPEXISTS("BANCS")==0) THEN
	#{
	   CREATEREP("BANCS")
	#}
	ENDIF
          
	IF (CLASSEXISTS("BANCS","PartTranDetails")==0) THEN
	#{
		CREATECLASS("BANCS","PartTranDetails",5)
	#}
	ENDIF  

    IF (CLASSEXISTS("BANCS","INPARAM")==0) THEN
    #{
        CREATECLASS("BANCS","INPARAM",5)
    #}
    ENDIF

    BANCS.INPARAM.PostTranFlg = "Y"
    BANCS.INPARAM.InsertTranWithValidnFlg = "N"
    BANCS.INPARAM.CommitFlg="N"
    BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
    BANCS.INPARAM.ErrorCheckForLuw="Y"
    BANCS.INPARAM.CheckExceptions="N"
    MTT.TranDetails.TranDate="0"
    MTT.TranDetails.TranType = "T"
    MTT.TranDetails.TranSubType = "BI"
    MTT.TranDetails.IgnoreExcp = "I"
    MTT.TranDetails.Consolidate = "N"
    MTT.TranDetails.Remarks = CUST.ATM.narr1

    sv_u = urhk_MTTS_Initialize("")
    #print(sv_r)

    sv_v = "CashBackComm"
    #print(sv_v)

    sv_u = urhk_MTTS_DefineTransaction("CashBackComm")
	print(sv_u)

    sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)
	
	#--------------------------------------------------
    # Income To Branch A/c
    #--------------------------------------------------

    MTT.PartTranDetails.Account = CUST.ATM.crAccount
    MTT.PartTranDetails.RefCurrency = BANCS.INPUT.TranCrncy
    IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
	MTT.PartTranDetails.RateCode = "TTB"
	MTT.PartTranDetails.Rate = ""
    ENDIF
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.Particulars = CUST.ATM.narr1
    MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
    MTT.PartTranDetails.RefAmount = cdouble(CUST.ATM.drCrAmount)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = ""
    MTT.PartTranDetails.RefNum = ""
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = sv_v
    sv_e = "CashBackIncome"
	
    sv_u = urhk_MTTS_definePartTran(sv_e)
	#print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		CUST.ATM.Sucessfail1     = "N"
	#}
	ELSE
	#{
		CUST.ATM.Sucessfail1     = "Y"
	#}
	ENDIF

	#------------------------------------------------------------------
    # Debit Partran To Agent Pool A/C
    #------------------------------------------------------------------

    MTT.PartTranDetails.Account = CUST.ATM.drAccount
    MTT.PartTranDetails.RefCurrency = BANCS.INPUT.TranCrncy
    IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
	MTT.PartTranDetails.RateCode = "TTB"
	MTT.PartTranDetails.Rate = ""
    ENDIF
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.Particulars = CUST.ATM.narr1
    MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
    sv_a = cdouble(CUST.ATM.drCrAmount)
	sv_a = -(sv_a)
	print(sv_a)
    MTT.PartTranDetails.RefAmount = sv_a
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "" 
    MTT.PartTranDetails.RefNum = "" 
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = sv_v
    sv_h = "D" + CUST.ATM.drAccount
    sv_u = urhk_MTTS_definePartTran(sv_h)
	
	sv_u = urhk_MTTS_EndDefinition("")
	print(sv_r)
	if(sv_u ==0) then
	#{
		CUST.ATM.TestTranID     = BANCS.OUTPARAM.MTTTranId
		print(CUST.ATM.TestTranID)
	#}
	ENDIF


	###### start TAX

	#--------------------------------------------------
    # Income To Branch A/c
    #--------------------------------------------------

    MTT.PartTranDetails.Account = CUST.ATM.Tax_accountGL
    MTT.PartTranDetails.RefCurrency = BANCS.INPUT.TranCrncy
    IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
	MTT.PartTranDetails.RateCode = "TTB"
	MTT.PartTranDetails.Rate = ""
    ENDIF
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.Particulars = CUST.ATM.narrtax
    MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
    MTT.PartTranDetails.RefAmount = cdouble(CUST.ATM.Amounttax)
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = ""
    MTT.PartTranDetails.RefNum = ""
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = sv_v
    sv_e = "CashBackIncome"
	
    sv_u = urhk_MTTS_definePartTran(sv_e)
	#print(sv_u)
	
	IF (sv_u != 0) THEN
	#{
		CUST.ATM.Sucessfail1     = "N"
	#}
	ELSE
	#{
		CUST.ATM.Sucessfail1     = "Y"
	#}
	ENDIF

	#------------------------------------------------------------------
    # Debit Partran To Agent Pool A/C
    #------------------------------------------------------------------

    MTT.PartTranDetails.Account = CUST.ATM.drAccount
    MTT.PartTranDetails.RefCurrency = BANCS.INPUT.TranCrncy
    IF (BANCS.INPUT.TranCrncy!=BANCS.STDIN.homeCrncyCode) THEN
	MTT.PartTranDetails.RateCode = "TTB"
	MTT.PartTranDetails.Rate = ""
    ENDIF
    MTT.PartTranDetails.ValueDateDiff = "0"
    MTT.PartTranDetails.Particulars = CUST.ATM.narrtax
    MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
    sv_a = cdouble(CUST.ATM.Amounttax)
	sv_a = -(sv_a)
	print(sv_a)
    MTT.PartTranDetails.RefAmount = sv_a
    print(MTT.PartTranDetails.RefAmount)
    MTT.PartTranDetails.Remarks = "" 
    MTT.PartTranDetails.RefNum = "" 
    MTT.PartTranDetails.IgnoreExcp = "I"
    MTT.PartTranDetails.Consolidate = "N"
    MTT.PartTranDetails.TranIdentifier = sv_v
    sv_h = "D" + CUST.ATM.drAccount
    sv_u = urhk_MTTS_definePartTran(sv_h)
	
	sv_u = urhk_MTTS_EndDefinition("")
	print(sv_r)
	if(sv_u ==0) then
	#{
		CUST.ATM.TestTranID     = BANCS.OUTPARAM.MTTTranId
		print(CUST.ATM.TestTranID)
	#}
	ENDIF

	########

    sv_u = urhk_MTTS_Close("")
    #print(sv_r)

call("copyCust24ToBancs.scr")
ENDIF
