			#{
				CUST.ATM.bacid8 = BANCS.OUTPUT.parameterVal
				print(CUST.ATM.bacid8)
			#}
			ELSE
			#{
				CUST.ATM.errMsg = "bacid setup not done CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.drAccount)
			print(sv_u)
			IF (sv_u != 0) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ELSE
				CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
				print(CUST.ATM.solid)
				CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
				print(CUST.ATM.schmcodesh)
