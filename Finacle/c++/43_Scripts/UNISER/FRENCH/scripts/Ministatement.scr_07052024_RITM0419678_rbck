			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT foracid "
			sv_s = sv_s + " FROM GAM "
			sv_s = sv_s + " WHERE sol_id = ?SVAR "
			sv_s = sv_s + " AND bacid = ?SVAR "
			sv_s = sv_s + " AND del_flg ='N' "
			sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
			sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
			BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + CUST.ATM.bacid8 + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
			print(sv_s)
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == "0") THEN
				BANCS.OUTPUT.CrForacid = BANCS.OUTPARAM.contra
				print(BANCS.OUTPUT.CrForacid)
				CUST.ATM.crAccount = BANCS.OUTPUT.CrForacid
				print(CUST.ATM.crAccount)
