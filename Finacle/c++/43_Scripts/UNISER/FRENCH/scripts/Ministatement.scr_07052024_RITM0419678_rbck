		sv_a = MID$(sv_a,12,16)
		print(sv_a)
		CUST.ATM.Amount =sv_a
		print(CUST.ATM.Amount)
		CUST.ATM.Amount=cdouble(CUST.ATM.Amount)/cdouble("100")
		print(CUST.ATM.Amount)
		sv_a=BANCS.INPUT.StlmntFee
		print(sv_a)
		sv_a = MID$(sv_a,41,16)
		print(sv_a)
		CUST.ATM.Amounttax = sv_a
		print(CUST.ATM.Amounttax)
		CUST.ATM.Amounttax=cdouble(CUST.ATM.Amounttax)/cdouble("100")
		print(CUST.ATM.Amounttax)

		sv_q = "sumamount|select ('" + CUST.ATM.Amount + "' + '" + CUST.ATM.Amounttax + "') from dual "
		print(sv_q)
		sv_w=urhk_dbSelectWithBind(sv_q)
		if (sv_w == 0) then
			print("sumamount")
			CUST.ATM.sumamount = cdouble(BANCS.OUTPARAM.sumamount)
			print(CUST.ATM.sumamount)
			CUST.ATM.EffAvailableAmttr = cdouble(CUST.ATM.EffAvailableAmttr)
			print(CUST.ATM.EffAvailableAmttr)
			if ((CUST.ATM.EffAvailableAmttr) < (CUST.ATM.sumamount)) then 
				print(" NOT PERMITED ")
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.ReservedField3="Insuffecient Funds for Ministatement "
				exitscript
			endif
		endif
	ENDIF
ENDIF
