				print(CUST.ATM.EffAvailableAmttr)
				CUST.ATM.lienAmt = BANCS.OUTPARAM.lienAmt
				print(CUST.ATM.lienAmt)
				###
				########### Start Status 
				PRINT(CUST.ATM.drAccount)
				sv_s = "SOL_ID,FORACID,SCHM_CODE,NAME,CIF_ID,ACCT_STATUS,ACCT_CRNCY_CODE,FREZ_CODE,FREZ_REASON_CODE "
