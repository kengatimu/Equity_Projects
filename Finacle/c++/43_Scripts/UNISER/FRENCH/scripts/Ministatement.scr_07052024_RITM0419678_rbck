	sv_s = "sysdate "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
	sv_s = sv_s + " FROM DUAL"
	BANCS.INPARAM.BINDVARS = sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
		CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate

		sv_s = "sysdateDRC "
                sv_s = sv_s + " | "
                sv_s = sv_s + " select to_char(sysdate-0.0833333333333333,'DD-MM-RRRR HH:MI:SS AM') from dual "
                print(sv_s)
                sv_d = urhk_dbSelectWithBind(sv_s)
                print(sv_d)
