	CUST.ATM.Amount = "0"
	GOTO ENDOFSCRIPT
ELSE
	CUST.ATM.Amount=CUST.ATM.Amount
	print(CUST.ATM.Amount)
	CUST.ATM.drCrAmount=CUST.ATM.Amount
	print(CUST.ATM.drCrAmount)

	#--------------------------------------------------------------------------
	# Create the narration
	#--------------------------------------------------------------------------
	sv_e = MID$(BANCS.STDIN.BODDate,0,10)
