					ENDIF
					IF ((BANCS.OUTPARAM.ACCT_STATUS=="D") OR (BANCS.OUTPARAM.ACCT_STATUS=="I")) THEN
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.ReservedField1 = "Account is Dormant Or Inactive Transaction Not allowed "
						print(BANCS.OUTPUT.ReservedField1)
						BANCS.OUTPUT.successOrFailure="F"
						exitscript
