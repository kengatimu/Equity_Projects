				########### End Status  
			ENDIF

			############ start commision to ATM branch
			IF ((BANCS.INPUT.DccId == "SWT") OR (BANCS.INPUT.DccId == "BRK") OR (BANCS.INPUT.DccId == "MC1") OR (BANCS.INPUT.DccId == "WPD")) THEN
				IF (FIELDEXISTS(BANCS.INPUT.DeviceId) == 1) THEN
					sv_s = "atmsolidnew"
