		IF (CUST.ATM.DccId=="SMS") THEN 
			CUST.ATM.narr1 ="M-KESHO MINISTATEMENT CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdateDRC
		ENDIF
