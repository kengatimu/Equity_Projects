				sv_s = sv_s + " SELECT gam.sol_id,gam.foracid,gam.schm_code,RPAD(GAM.acct_name,80,' ') name,GAM.cif_id,acct_status,acct_crncy_code,FREZ_CODE,FREZ_REASON_CODE "
				sv_s = sv_s + " FROM TBAADM.GAM , TBAADM.smt WHERE  smt.acid=GAM.acid AND GAM.foracid = ?SVAR AND GAM.bank_id = ?SVAR AND  GAM.bank_id = smt.bank_id AND rownum<2 "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ATM.drAccount + "|" + BANCS.STDIN.contextBankId
