			CUST.ATM.narr1 ="EAZZY-MINISTATEMENT-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdateDRC
		ENDIF
		IF (CUST.ATM.DccId=="OMK") THEN 
			CUST.ATM.narr1 ="ORANGEM-MINISTATEMENT-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdateDRC
		ENDIF

		IF (CUST.ATM.DccId=="WYM") THEN 
			IF (BANCS.INPUT.Command == "MSIR") THEN
				CUST.ATM.narr1 ="WAYMB-MINISTATEMENT-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdateDRC
			ENDIF
			IF (BANCS.INPUT.Command == "BLIR") THEN
				CUST.ATM.narr1 ="WAYMB-BAL_INQ-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdateDRC
			ENDIF
		ENDIF
		IF ((CUST.ATM.DccId=="SWT") OR (CUST.ATM.DccId=="BRK") OR (CUST.ATM.DccId=="MC1")) THEN 
			CUST.ATM.serialm= LTRIM(BANCS.INPUT.ReservedField3,'0') 
			print(CUST.ATM.serialm)
			IF (BANCS.INPUT.Command == "MSIR") THEN
				CUST.ATM.narr1 ="ATM-MINISTATEMENT-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdateDRC
				CUST.ATM.narrtax ="TVA ATM-MINISTATEMENT-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdateDRC
			ENDIF
			IF (BANCS.INPUT.Command == "BLIR") THEN
				CUST.ATM.narr1 ="ATM-BAL_INQ-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
				CUST.ATM.narrtax ="TVA ATM-BAL_INQ-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
			ENDIF
		ENDIF
		IF (CUST.ATM.DccId=="WPD") THEN 
			CUST.ATM.serialm= LTRIM(BANCS.INPUT.ReservedField3,'0') 
			print(CUST.ATM.serialm)
			IF (BANCS.INPUT.Command == "MSIR") THEN
				CUST.ATM.narr1 ="POS-MINISTATEMENT-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
				CUST.ATM.narrtax ="TVA POS-MINISTATEMENT-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
			ENDIF
			IF (BANCS.INPUT.Command == "BLIR") THEN
				CUST.ATM.narr1 ="POS-BAL_INQ-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
				CUST.ATM.narrtax ="TVA POS-BAL_INQ-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
			ENDIF
		ENDIF
	ELSE
	 GOTO ENDOFSCRIPT
