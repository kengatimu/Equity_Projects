					IF ((BANCS.OUTPARAM.FREZ_CODE=="D") OR (BANCS.OUTPARAM.FREZ_CODE=="T")) THEN
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.ReservedField1 = "Account is Frozen Transaction Not allowed "
						print(BANCS.OUTPUT.ReservedField1)
						BANCS.OUTPUT.successOrFailure="F"
						exitscript
					ENDIF
