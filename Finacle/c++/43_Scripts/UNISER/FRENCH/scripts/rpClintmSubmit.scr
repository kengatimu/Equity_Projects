#======================================================#
#Source Name                    :rpClintmSubmit.scr
#Menu                           :CLINTM
#Date                           :31-03-2023
#Description                    :On Click Submit button from CLINTM Menu.
#Author                         :Ranjith Palani
#======================================================#
<--start
trace on

	#--------------------------------#
	#Repository and Class Creation.
	#--------------------------------#
	if(repexists("CUST") == 0)then
	#{
		createrep("CUST")
	#}
	endif
	if(classexists("CUST","CLINTM") == 0)then
	#{
		createclass("CUST","CLINTM",5)
	#}
	endif

	sv_a = urhk_SetOrbOut("SuccessOrFailure|Y")
	print(sv_a)

	sv_a = urhk_B2k_PrintRepos("BANCS")
	print(sv_a)

	#BANCS.INPUT.funcCode
	CUST.CLINTM.acctId = BANCS.INPUT.acctId
	CUST.CLINTM.custPrefInt = BANCS.INPUT.custPrefInt
	CUST.CLINTM.acctPrefInt = BANCS.INPUT.acctPrefInt
	CUST.CLINTM.chnlPrefInt = BANCS.INPUT.chnlPrefInt
	CUST.CLINTM.negotiatedRate = BANCS.INPUT.negotiatedRate
	CUST.CLINTM.minInt = BANCS.INPUT.minInt
	CUST.CLINTM.maxInt = BANCS.INPUT.maxInt
	CUST.CLINTM.startDate = BANCS.INPUT.startDate_ui
	CUST.CLINTM.endDate = BANCS.INPUT.endDate_ui
	CUST.CLINTM.intAppliedStatus = BANCS.INPUT.intAppliedStatus
	if(fieldexists(BANCS.INPUT.funcCode))then
		if(trim(BANCS.INPUT.funcCode) != "")then
			CUST.CLINTM.funcCode = toupper(trim(BANCS.INPUT.funcCode))
			print(CUST.CLINTM.funcCode)
		endif
	endif

	#--Add.
	if(CUST.CLINTM.funcCode == "A")then
		CUST.CLINTM.entityCreFlg = "N"
		CUST.CLINTM.delFlg = "N"
		sv_i = "insert into custom.loan_interest_float(foracid,start_date,entity_cre_flg,del_flg,end_date,lchg_user_id,lchg_time,rcre_user_id,rcre_time,cust_dr_pref_pcnt,id_dr_pref_pcnt,"
		sv_i = sv_i + "min_int_pcnt_dr,max_int_pcnt_dr,negotiated_rate_dr,chnl_dr_pref_pcnt,float_interest_applied_status,bank_id)"
		sv_i = sv_i + " values(?SVAR,to_date(?SVAR,'dd-mm-yyyy'),?SVAR,?SVAR,to_date(?SVAR,'dd-mm-yyyy'),"
		sv_i = sv_i + "?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
		print(sv_i)
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ CUST.CLINTM.startDate +"|"+ CUST.CLINTM.entityCreFlg +"|"+ CUST.CLINTM.delFlg +"|"+ CUST.CLINTM.endDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.sysDate +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.sysDate +"|"+ CUST.CLINTM.custPrefInt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CLINTM.acctPrefInt +"|"+ CUST.CLINTM.minInt +"|"+ CUST.CLINTM.maxInt +"|"+ CUST.CLINTM.negotiatedRate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CLINTM.chnlPrefInt +"|"+ CUST.CLINTM.intAppliedStatus +"|"+ BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_i = urhk_dbSQLWithBind(sv_i)
		if(sv_i == 0)then
			sv_i = urhk_dbSQLWithBind("commit")
			goto drceqty
		endif
	endif

	#--Verify.
	if(CUST.CLINTM.funcCode == "V")then
		sv_m = "modCount|select count(1) from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.modCount = BANCS.OUTPARAM.modCount
		endif

		sv_m = "mainCount|select count(1) from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR and entity_cre_flg='N'"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_m = urhk_dbSelectWithBind(sv_m)
		if(sv_m == 0)then
			CUST.CLINTM.mainCount = BANCS.OUTPARAM.mainCount
		endif
			if(CUST.CLINTM.modCount == 1 and CUST.CLINTM.mainCount == 1)then
				CUST.CLINTM.entityCreFlg = "Y"
				sv_u = "update custom.loan_interest_float a set entity_cre_flg=?SVAR,"
				sv_u = sv_u + "end_date=(select end_date from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "lchg_user_id=(select lchg_user_id from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "lchg_time=(select lchg_time from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "cust_dr_pref_pcnt=(select cust_dr_pref_pcnt from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "id_dr_pref_pcnt=(select id_dr_pref_pcnt from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "min_int_pcnt_dr=(select min_int_pcnt_dr from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "max_int_pcnt_dr=(select max_int_pcnt_dr from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "negotiated_rate_dr=(select negotiated_rate_dr from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "chnl_dr_pref_pcnt=(select chnl_dr_pref_pcnt from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id),"
				sv_u = sv_u + "float_interest_applied_status=(select float_interest_applied_status from custom.loan_interest_float_mod b where b.foracid=a.foracid and b.bank_id=a.bank_id)"
				sv_u = sv_u + " where a.foracid=?SVAR and a.bank_id=?SVAR"
				print(sv_u)
				BANCS.INPARAM.BINDVARS = CUST.CLINTM.entityCreFlg +"|"+ CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_u = urhk_dbSQLWithBind(sv_u)
				if(sv_u == 0)then
					sv_u = urhk_dbSQLWithBind("commit")
					if(sv_u == 0)then
						sv_d = "delete from custom.loan_interest_float_mod where foracid=?SVAR and bank_id=?SVAR"
						BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
						sv_d = urhk_dbSQLWithBind(sv_d)
						if(sv_d == 0)then
							sv_d = urhk_dbSQLWithBind("commit")
						endif
					endif
				endif
			endif

			if(CUST.CLINTM.modCount == 0 and CUST.CLINTM.mainCount == 1)then
				CUST.CLINTM.entityCreFlg = "Y"
				sv_u = "update custom.loan_interest_float set entity_cre_flg=?SVAR where foracid=?SVAR and entity_cre_flg='N' and del_flg='N' and bank_id=?SVAR"
				BANCS.INPARAM.BINDVARS = CUST.CLINTM.entityCreFlg +"|"+ CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
				sv_u = urhk_dbSQLWithBind(sv_u)
				if(sv_u == 0)then
					sv_u = urhk_dbSQLWithBind("commit")
				endif
			endif
	endif

	#--Modify.
	if(CUST.CLINTM.funcCode == "M")then
		CUST.CLINTM.entityCreFlg = "N"
		CUST.CLINTM.delFlg = "N"
		CUST.CLINTM.modIntAppliedStatus = "N"
		sv_i = "insert into custom.loan_interest_float_mod(foracid,start_date,entity_cre_flg,del_flg,end_date,lchg_user_id,lchg_time,"
		sv_i = sv_i + "cust_dr_pref_pcnt,id_dr_pref_pcnt,min_int_pcnt_dr,max_int_pcnt_dr,negotiated_rate_dr,chnl_dr_pref_pcnt,float_interest_applied_status,bank_id)"
		sv_i = sv_i + " values(?SVAR,to_date(?SVAR,'dd-mm-yyyy'),?SVAR,?SVAR,to_date(?SVAR,'dd-mm-yyyy'),?SVAR,to_date(?SVAR,'dd-mm-yyyy hh24:mi:ss'),"
		sv_i = sv_i + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
		print(sv_i)
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ CUST.CLINTM.startDate +"|"+ CUST.CLINTM.entityCreFlg +"|"+ CUST.CLINTM.delFlg +"|"+ CUST.CLINTM.endDate
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.sysDate +"|"+ CUST.CLINTM.custPrefInt +"|"+ CUST.CLINTM.acctPrefInt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CLINTM.minInt +"|"+ CUST.CLINTM.maxInt +"|"+ CUST.CLINTM.negotiatedRate +"|"+ CUST.CLINTM.chnlPrefInt 
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.CLINTM.modIntAppliedStatus +"|"+ BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_i = urhk_dbSQLWithBind(sv_i)
		if(sv_i == 0)then
			sv_i = urhk_dbSQLWithBind("commit")
			if(sv_i == 0)then
				sv_e = "update custom.loan_interest_float set entity_cre_flg='N' where foracid=?SVAR and bank_id=?SVAR"
				BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
				sv_e = urhk_dbSQLWithBind(sv_e)
				if(sv_i == 0)then
					sv_e = urhk_dbSQLWithBind("commit")
				endif
			endif
		endif
	endif

	#--Cancel
	if(CUST.CLINTM.funcCode == "X")then
		sv_x = "delete from custom.loan_interest_float where foracid=?SVAR and bank_id=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.CLINTM.acctId +"|"+ BANCS.STDIN.contextBankId
		sv_x = urhk_dbSQLWithBind(sv_x)
		if(sv_x == 0)then
			sv_x = urhk_dbSQLWithBind("commit")
		endif
	endif

	if(CUST.CLINTM.funcCode == "I")then
		BANCS.OUTPUT.SuccessOrFailure = "S"
		sv_s = urhk_SetOrbOut("SuccessOrFailure|Y")
		goto drceqty
	endif

drceqty:
	if(BANCS.OUTPUT.successOrFailure == "S")then
	#{
		if(CUST.CLINTM.funcCode == "A")then
			sv_r = urhk_SetOrbOut("SuccessOrFailure|Y")
			CUST.CLINTM.resultMessage = "Record Added Successfully:" + CUST.CLINTM.acctId 
			sv_r = urhk_SetOrbOut("RESULT_MSG|" + CUST.CLINTM.resultMessage)
		endif

		if(CUST.CLINTM.funcCode == "V")then
			sv_r = urhk_SetOrbOut("SuccessOrFailure|Y")
			CUST.CLINTM.resultMessage = "Record Verified Successfully:" + CUST.CLINTM.acctId 
			sv_r = urhk_SetOrbOut("RESULT_MSG|" + CUST.CLINTM.resultMessage)
		endif

		if(CUST.CLINTM.funcCode == "M")then
			sv_r = urhk_SetOrbOut("SuccessOrFailure|Y")
			CUST.CLINTM.resultMessage = "Record Modified Successfully:" + CUST.CLINTM.acctId 
			sv_r = urhk_SetOrbOut("RESULT_MSG|" + CUST.CLINTM.resultMessage)
		endif

		if(CUST.CLINTM.funcCode == "I")then
			sv_r = urhk_SetOrbOut("SuccessOrFailure|Y")
			CUST.CLINTM.resultMessage = "Inquired Account is:" + CUST.CLINTM.acctId 
			sv_r = urhk_SetOrbOut("RESULT_MSG|" + CUST.CLINTM.resultMessage)
		endif

		if(CUST.CLINTM.funcCode == "X")then
			sv_r = urhk_SetOrbOut("SuccessOrFailure|Y")
			CUST.CLINTM.resultMessage = "Deleted Account is:" + CUST.CLINTM.acctId 
			sv_r = urhk_SetOrbOut("RESULT_MSG|" + CUST.CLINTM.resultMessage)
		endif
	#}
	endif
exitscript
trace off
end-->
