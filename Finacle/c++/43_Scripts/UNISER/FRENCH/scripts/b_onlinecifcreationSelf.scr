	CUST.INTERFACE.State="102"
	CUST.INTERFACE.PostalCode="00100"
	CUST.INTERFACE.Nationality="CD"
        CUST.INTERFACE.Doc=BANCS.OUTPARAM.DOC_CODE
Print(CUST.INTERFACE.Doc)
IF(CUST.INTERFACE.Doc=="3") THEN
	CUST.INTERFACE.docdesc="PASSPORT"
	CUST.INTERFACE.Expirydate =BANCS.OUTPARAM.EXPIRY_DATE
print (CUST.INTERFACE.Expirydate)
CUST.INTERFACE.dateX=BANCS.OUTPARAM.dateX
print(CUST.INTERFACE.dateX)
CUST.INTERFACE.monthX=BANCS.OUTPARAM.monthX
print(CUST.INTERFACE.monthX)
CUST.INTERFACE.yearX=BANCS.OUTPARAM.yearX
print(CUST.INTERFACE.yearX)
CUST.INTERFACE.Expirydate = CUST.INTERFACE.yearX + CUST.INTERFACE.sign + CUST.INTERFACE.monthX + CUST.INTERFACE.sign + CUST.INTERFACE.dateX + CUST.INTERFACE.lastdatepart 
print (CUST.INTERFACE.Expirydate)
ENDIF
IF(CUST.INTERFACE.Doc=="5") THEN
	CUST.INTERFACE.docdesc="VOTER REGISTRATION CARD"
ENDIF

IF(CUST.INTERFACE.Doc=="6") THEN
	CUST.INTERFACE.docdesc="DRIVING LICENSE"
	CUST.INTERFACE.Expirydate =BANCS.OUTPARAM.EXPIRY_DATE
print (CUST.INTERFACE.Expirydate)
CUST.INTERFACE.dateX=BANCS.OUTPARAM.dateX
print(CUST.INTERFACE.dateX)
CUST.INTERFACE.monthX=BANCS.OUTPARAM.monthX
print(CUST.INTERFACE.monthX)
CUST.INTERFACE.yearX=BANCS.OUTPARAM.yearX
print(CUST.INTERFACE.yearX)
CUST.INTERFACE.Expirydate = CUST.INTERFACE.yearX + CUST.INTERFACE.sign + CUST.INTERFACE.monthX + CUST.INTERFACE.sign + CUST.INTERFACE.dateX + CUST.INTERFACE.lastdatepart 
print (CUST.INTERFACE.Expirydate)
ENDIF

ENDIF

CUST.INTERFACE.freetext = "FREE_TEXT_FORMAT"
CUST.INTERFACE.firstname=BANCS.OUTPARAM.firstname
print(CUST.INTERFACE.firstname)
CUST.INTERFACE.shortname=MID$(BANCS.OUTPARAM.firstname,0,9)
print(CUST.INTERFACE.shortname)
CUST.INTERFACE.middlename=BANCS.OUTPARAM.middlename
CUST.INTERFACE.lastname=BANCS.OUTPARAM.lastname
CUST.INTERFACE.natidno=BANCS.OUTPARAM.nationalid
CUST.INTERFACE.solid=BANCS.OUTPARAM.solid
CUST.INTERFACE.gender=BANCS.OUTPARAM.gender
CUST.INTERFACE.dateofbirth=BANCS.OUTPARAM.dateofbirth
print(CUST.INTERFACE.dateofbirth)
CUST.INTERFACE.datec=BANCS.OUTPARAM.datec
print(CUST.INTERFACE.datec)
CUST.INTERFACE.monthc=BANCS.OUTPARAM.monthc
print(CUST.INTERFACE.monthc)
CUST.INTERFACE.yearc=BANCS.OUTPARAM.yearc
print(CUST.INTERFACE.yearc)
CUST.INTERFACE.dateofbirth =  CUST.INTERFACE.yearc + CUST.INTERFACE.sign + CUST.INTERFACE.monthc + CUST.INTERFACE.sign + CUST.INTERFACE.datec + CUST.INTERFACE.lastdatepart 
print(CUST.INTERFACE.dateofbirth)

CUST.INTERFACE.PHONE=BANCS.OUTPARAM.PHONE
PRINT (CUST.INTERFACE.PHONE)
