<--start
trace on

CALL("Common_Interface_CreateRepos.scr")


sv_s="Row_num,CRNCY, RM,SEG,SUBSEG,address,nationalid,firstname,middlename,lastname,solid,gender,dateofbirth,datec,monthc,yearc,DOC_CODE, EXPIRY_DATE,dateX,monthX,yearX,PHONE,EMPLOYERID |"
sv_s = sv_s + " SELECT Row_num, CRNCY,R_MANAGER,SEGMENT,SUB_SEGMENT,ADDRESS,national_id,first_name,CASE WHEN sur_name IS NULL THEN 'XX' ELSE middle_name  END middle_name  , CASE WHEN sur_name IS NULL THEN  middle_name  ELSE   sur_name  END sur_name,sol_id,gender,date_of_birth,substr (to_char((to_date(DATE_OF_BIRTH,'DD-MM-RRRR')),'DD-MM-RRRR'),0,2) as datec, "
sv_s = sv_s + " substr (to_char((to_date(DATE_OF_BIRTH,'DD-MM-RRRR')),'DD-MM-RRRR'),4,2) as monthc,substr (to_char((to_date(DATE_OF_BIRTH,'DD-MM-RRRR')),'DD-MM-RRRR'),7,4) as yearc, "
sv_s = sv_s + " DOC_CODE, EXPIRY_DATE,substr (to_char((to_date(EXPIRY_DATE,'DD-MM-RRRR')),'DD-MM-RRRR'),0,2) as dateX, substr (to_char((to_date(EXPIRY_DATE,'DD-MM-RRRR')),'DD-MM-RRRR'),4,2) as monthX,substr (to_char((to_date(EXPIRY_DATE,'DD-MM-RRRR')),'DD-MM-RRRR'),7,4) as yearX ,"
sv_s = sv_s + " CASE WHEN PHONE IS NULL THEN '24375104' ELSE PHONE END PHONE,  CASE WHEN EMPLOYERID IS NULL THEN 'SELF' ELSE EMPLOYERID  END EMPLOYERID FROM CUSTOM.BULK_CIF_DRC_SELF  "
sv_s = sv_s + " WHERE entity_cre_flg='N' "
#sv_s = sv_s + " AND sol_id= ?SVAR"
sv_s = sv_s + " AND bank_id = ?SVAR  "
print(sv_s)
#BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId 
BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)

sv_c = urhk_dbCursorOpenWithBind(sv_s)
print(sv_c)

IF (sv_c==0) then
#{

	CUST.INTERFACE.DbcursorNumber = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
	print(sv_k)

WHILE (sv_k == 0)
#{

CUST.INTERFACE.interfaceRequestID = "RetCustAdd"
CUST.INTERFACE.interfaceRequestVersion = "10.2"
