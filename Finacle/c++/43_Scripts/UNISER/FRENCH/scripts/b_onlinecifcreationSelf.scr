CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<preferredUniqueId>Y</preferredUniqueId>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<IDIssuedOrganisation>001</IDIssuedOrganisation>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</EntityDoctData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PsychographicData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<PsychographMiscData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<StrText10>" + CUST.INTERFACE.StrText10 + "</StrText10>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Type>CURRENCY</Type>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PsychographMiscData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<preferred_Locale>test</preferred_Locale>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</PsychographicData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TradeFinData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<CustNative>Y</CustNative>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<InlandTradeAllowed>Y</InlandTradeAllowed>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<Rmks/>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<TradeAuthorityCode/>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</TradeFinData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RelatedDtls>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustAddRq>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<RetCustAdd_CustomData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<custStatus>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</custStatus>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "<custCaste>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</custCaste>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustAdd_CustomData>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</RetCustAddRequest>"
CUST.INTERFACE.bodyXMLMsg = CUST.INTERFACE.bodyXMLMsg + "</Body>"

#-------------------------------------------------------------------------
#Appending the header XML and body XML.
#-------------------------------------------------------------------------
CUST.INTERFACE.reqXMLMsg = "MSG_TYPE=XML,MSG_SUB_TYPE=FIXML###"
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "<FIXML>"
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.headerXML 
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + CUST.INTERFACE.bodyXMLMsg
CUST.INTERFACE.reqXMLMsg = CUST.INTERFACE.reqXMLMsg + "</FIXML>"

#-------------------------------------------------------------------------------
# Setting input values for urhk_ConnectToFIAndSendMsg userhook
#-------------------------------------------------------------------------------
BANCS.INPARAM.SERVICE_NAME              = "FIJCA"
print(BANCS.INPARAM.SERVICE_NAME)
BANCS.INPARAM.SEND_RECV_FLG             = "R"
sv_a = CUST.INTERFACE.reqXMLMsg
PRINT(sv_a)

#-------------------------------------------------------------------------
#- Executing the userhook to make the Outbound Call
#-------------------------------------------------------------------------
sv_l = urhk_ConnectToFIAndSendMsg(sv_a)
print(sv_l)
IF (sv_l != 0) THEN
#{
	print(BANCS.OUTPARAM.ErrMsg)
	CUST.INTERFACE.errorMsgFlg = "Y"
	CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg
	CUST.INTERFACE.errorMsgCode = "FIERR"  
	GOTO ENDOFSCRIPT
#}
ENDIF
IF (BANCS.OUTPARAM.ErrMsg != "") THEN
#{
	CUST.INTERFACE.errorMsgFlg = "Y"
	CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
	CUST.INTERFACE.errorMsgDesc = BANCS.OUTPARAM.ErrMsg 
	CUST.INTERFACE.errorMsgCode = "FIERR" 
	GOTO ENDOFSCRIPT
#}
ELSE
#{
	CUST.INTERFACE.respXMLMsg = BANCS.OUTPARAM.RespMesg
	print(CUST.INTERFACE.respXMLMsg)
	CUST.INTERFACE.errorMsgFlg = ""
	CUST.INTERFACE.errorMsgDesc = ""
	
CUST.INTERFACE.opndate = ""
CUST.INTERFACE.cifid = ""
CUST.INTERFACE.errorCode = ""
CUST.INTERFACE.errorDesc = ""
sv_x = CUST.INTERFACE.respXMLMsg

#--------------------------------------------------------------------------------------------------------
# Fetching the status of the request
#--------------------------------------------------------------------------------------------------------
sv_y = "<Status>"
sv_z = "</Status>"
sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
sv_e = GETPOSITION(sv_x, sv_z) - 1
IF (GETPOSITION(sv_x, sv_y) != 0) THEN
#{
	CUST.INTERFACE.tranStatus = MID$(sv_x, sv_b, (sv_e - sv_b))
#}
ELSE
#{
	CUST.INTERFACE.tranStatus = ""
#}
ENDIF
print(CUST.INTERFACE.tranStatus)
#--------------------------------------------------------------------------------------------------------
# If Success fetching cif id and cif opn date else fetching error code and description
#--------------------------------------------------------------------------------------------------------
IF (CUST.INTERFACE.tranStatus =="SUCCESS")  THEN
#{
	CUST.INTERFACE.errorMsgFlg = "N"
	sv_x = CUST.INTERFACE.respXMLMsg
	sv_y = "<CustId>"
	sv_z = "</CustId>"
	sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
	sv_e = GETPOSITION(sv_x, sv_z) - 1
	IF (GETPOSITION(sv_x, sv_y) != 0) THEN
	#{
		CUST.INTERFACE.cifid = MID$(sv_x, sv_b, (sv_e - sv_b))
		print(CUST.INTERFACE.cifid)
	#}
	ENDIF
				#----------------------------------------------------------------------------------------------------
				# Update custom table status
				#----------------------------------------------------------------------------------------------------
				sv_s = "UPDATE CUSTOM.BULK_CIF_DRC_SELF "
				sv_s = sv_s + " SET entity_cre_flg = 'P',cif_id= ?SVAR"
				sv_s = sv_s + " WHERE national_id= ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR and  Row_num = ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.INTERFACE.cifid + "|" + CUST.INTERFACE.natidno + "|" + BANCS.STDIN.contextBankId + "|" + CUST.INTERFACE.Row_num
				print(BANCS.INPARAM.BINDVARS)
		
				sv_d = urhk_dbSQLWithBind(sv_s)
				IF (sv_d == 0) THEN
				#{
					sv_c = urhk_dbSQLWithBind("commit")
					print(sv_c)
				#}
				ENDIF
		
	IF (CUST.INTERFACE.cifid == "") THEN
	#{
		CUST.INTERFACE.errorMsgFlg = "Y"
		CUST.INTERFACE.errorCode = "SYSERR"
		CUST.INTERFACE.errorDesc = "Could not get response from server"
	#}
	ENDIF
#}
ELSE
#{
	CUST.INTERFACE.errorMsgFlg = "Y"
	IF(CUST.INTERFACE.tranStatus != "SUCCESS") THEN
	#{
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<ErrorCode>"
		sv_z = "</ErrorCode>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.errorCode = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
		ENDIF
		sv_x = CUST.INTERFACE.respXMLMsg
		sv_y = "<ErrorDesc>"
		sv_z = "</ErrorDesc>"
		sv_b = GETPOSITION(sv_x, sv_y) + STRLEN(sv_y) - 1
		sv_e = GETPOSITION(sv_x, sv_z) - 1
		IF (GETPOSITION(sv_x, sv_y) != 0) THEN
		#{
			CUST.INTERFACE.errorDesc = MID$(sv_x, sv_b, (sv_e - sv_b))
		#}
		ENDIF

			#----------------------------------------------------------------------------------------------------
			# Update custom table failure status
			#----------------------------------------------------------------------------------------------------
			IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
			#{
				CUST.INTERFACE.errorCode = "SYSERR"
				CUST.INTERFACE.errorDesc = "Could not get response from server"
			#}
			ENDIF

			sv_s = "UPDATE CUSTOM.BULK_CIF_DRC_SELF "
			sv_s = sv_s + " SET entity_cre_flg = 'E',ERROR_CODE =?SVAR  "
			sv_s = sv_s + " WHERE national_id= ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR and  Row_num = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.INTERFACE.errorDesc + "|" + CUST.INTERFACE.natidno + "|" + BANCS.STDIN.contextBankId  + "|" + CUST.INTERFACE.Row_num
			print(BANCS.INPARAM.BINDVARS)
	
			sv_d = urhk_dbSQLWithBind(sv_s)
			IF (sv_d == 0) THEN
			#{
				sv_c = urhk_dbSQLWithBind("commit")
				print(sv_c)
			#}
			ENDIF
	#}
	ENDIF
	IF((CUST.INTERFACE.errorCode == "") AND (CUST.INTERFACE.errorDesc == "")) THEN
	#{
		CUST.INTERFACE.errorCode = "SYSERR"
		CUST.INTERFACE.errorDesc = "Could not get response from server"
	#}
	ENDIF
#}
ENDIF

print(CUST.INTERFACE.errorMsgFlg)
print(CUST.INTERFACE.cifid)
print(CUST.INTERFACE.opndate)
print(CUST.INTERFACE.errorCode)
print(CUST.INTERFACE.errorDesc)
#}
ENDIF

		sv_k = urhk_dbCursorFetch(CUST.INTERFACE.DbcursorNumber)
		print(sv_k)

	#}
	DO

	sv_c = urhk_dbCursorClose(CUST.INTERFACE.DbcursorNumber)
	print(sv_c)
#}
ENDIF

