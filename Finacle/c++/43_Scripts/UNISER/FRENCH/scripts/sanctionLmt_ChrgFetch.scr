<--START
TRACE ON

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST","DATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","DATA",5)
        #}
        ENDIF

        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.acctNum = " "
        CUST.DATA.chrgCrncy = " "
        CUST.DATA.chrgAmt = "0"
        CUST.DATA.vatAmt = "0"
	CUST.DATA.schmCode = " "
	CUST.DATA.chrgPcnt = "0"

        IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
        #{
                IF(BANCS.INPUT.acctNum !="")THEN
                #{
                        CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
                        PRINT(CUST.DATA.acctNum)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Account Number not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Account Number not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "schmCode,chrgPcnt,CrncyCode|SELECT SCHM_CODE,ACID,ACCT_CRNCY_CODE FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
		CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
		CUST.DATA.chrgPcnt = BANCS.OUTPARAM.chrgPcnt
		CUST.DATA.vatAmt = BANCS.OUTPARAM.CrncyCode	
		PRINT(CUST.DATA.schmCode)
		PRINT(CUST.DATA.chrgPcnt)
		PRINT(CUST.DATA.vatAmt)
	#}
	ELSE
	#{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Invalid Account"
                GOTO ENDOFSCRIPT
	#}
	ENDIF

        BANCS.INPUT.moduleName  = "OT"
        BANCS.INPUT.parameterId = "ODSAN_SCHMS"
        CALL ("getcparamvalue.scr")
        IF(BANCS.OUTPUT.parameterVal != "")THEN
        #{
                CUST.DATA.schmparmVal = BANCS.OUTPUT.parameterVal
                #}
        ELSE
                #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                GOTO ENDOFSCRIPT

        #}
        ENDIF

        sv_p = GETPOSITION(CUST.DATA.schmparmVal,CUST.DATA.schmCode)
        PRINT(sv_p)

        IF(sv_p <= "0")THEN
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "chrgAmt,chrgCrncy,vatAmt,chrgPcnt|SELECT CHRG_AMT,CHRG_CRNCY_CODE,VAT_AMT,CHRG_PACNT FROM CUSTOM.SANLIM_TRAN WHERE BANK_ID=?SVAR AND ODACCT_NUM=?SVAR AND POST_FLG='N'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
                CUST.DATA.chrgAmt = BANCS.OUTPARAM.chrgAmt
                PRINT(CUST.DATA.chrgAmt)
                CUST.DATA.chrgCrncy = BANCS.OUTPARAM.chrgCrncy
                PRINT(CUST.DATA.chrgCrncy)
                CUST.DATA.vatAmt = BANCS.OUTPARAM.vatAmt
                PRINT(CUST.DATA.vatAmt)
                CUST.DATA.chrgPcnt = BANCS.OUTPARAM.chrgPcnt
                PRINT(CUST.DATA.chrgPcnt)
        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = " "
                GOTO ENDOFSCRIPT
        #}
        ENDIF

ENDOFSCRIPT:

        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
	IF(CUST.DATA.chrgCrncy == "")THEN
	#{
		CUST.DATA.chrgCrncy = " "
	#}
	ENDIF
	IF(CUST.DATA.chrgAmt == "")THEN
	#{
		CUST.DATA.chrgAmt = "0"	
	#}
	ENDIF
	IF(CUST.DATA.vatAmt == "")THEN
	#{
		CUST.DATA.vatAmt = "0"
	#}
	ENDIF
	IF(CUST.DATA.chrgPcnt == "")THEN
	#{
		CUST.DATA.chrgPcnt = "0"
	#}
	ENDIF

        sv_u = urhk_SetOrbOut("chrgCrncy|"+CUST.DATA.chrgCrncy)
        sv_u = urhk_SetOrbOut("chrgAmt|"+CUST.DATA.chrgAmt)
        sv_u = urhk_SetOrbOut("vatAmt|"+CUST.DATA.vatAmt)
        sv_u = urhk_SetOrbOut("chrgPcnt|"+CUST.DATA.chrgPcnt)

TRACE OFF
END-->

