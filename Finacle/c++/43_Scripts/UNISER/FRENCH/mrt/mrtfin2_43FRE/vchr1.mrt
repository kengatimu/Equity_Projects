######################################################################
#  PROCEDURE BLOCK
######################################################################

PROCEDURE page_hdr
begin
if tranType = "T"
begin
	if partTranType="D"
	begin
		set tc_oacct_no=foracid
		set tc_oacct_name=acct_name
		set tc_occy=tranCrncyCode
		set tc_oamt=tranAmt
		set tc_part=tranparticulars
	end
	if partTranType="C"
	begin
		set tc_bacct_no=foracid
		set tc_bacct_name=acct_name
	end
end
if tranType = "C"
begin
	if (pagenumber = 1) 
	begin
		if(postEmailInd = "EMAIL")
		begin
			print "REPORT!MAILID#"
			nextline
		end
	end		
	print "EQUITY BCDC" column 12
	nextline
	print branchname column 12	
	nextline
	set localdate = stringToDate  today
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 12
	print " "
	set localdate = stringToDate  today
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "HH24:NN:SS"	
	nextline
					
if tranSubType = "NR"
begin
	print "Bordereau de Depot" column 12 
end
if tranSubType = "RI"
begin
	print "Bordereau de Depot" column 12 
end
if tranSubType = "NP"
begin
	print "Bordereau de retrait" column 10 
end
if tranSubType = "PI"
begin
	print "Bordereau de retrait" column 10 
end
if tranSubType = "CP"
begin
	print "Bordereau de retrait" column 10 
end
if tranSubType = "CR"
begin
	print "Bordereau de Depot" column 12 
end
if tranSubType = "CT"
begin
	print "mouvement de caisse" column 10 
end	

nextline
	nextline
	print "Execute par :" column 1
	print posted_user_id column 14
	nextline
	print "Execute sur :" column 1
	set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 14
print " "
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "HH24:NN:SS"
	nextline
	nextline
end
end
##############################################################################
PROCEDURE tran_details
begin
	set lv_foracid = foracid
	set lv_tranid = tran_id
	set lv_srlnum = part_tran_srl_num
	set lv_userid = posted_user_id
	set lv_trandate= tranDate
	set lv_parttrantype = partTranType 
	set callscript = runscript "getmoreinfo.scr" "lv_foracid|lv_tranid|lv_srlnum|tranAmt|lv_userid|lv_trandate|lv_parttrantype|schmcode" "lv_bacid|refnum|lv_datetime|lv_username|lv_userlogedon|lv_printid|lv_benename|lv_beneid|lv_benePhone|lv_Billnum|lv_senderName|lv_senderPhone|lv_accttype"

	set recipttype =  "0"	
	if tranType = "T"
	begin
	if partTranType="D"
		begin
			set tc_oacct_type=lv_accttype
		end
	end
if tranType = "C"
begin
	set lv_bacid = ltrim lv_bacid " "
	set lv_bacid = rtrim lv_bacid " "

	set sb_bacid = substr lv_bacid 1,5
	IF tranType ="T"																			       	
		begin																					       	
			set svar2 ="T"																       	
		end																					       	
	Else																					       
	Begin
		if tranSubType = "NR"
			set svar2 ="D" 
		else
			if tranSubType = "RI"
				begin
				set svar2 ="D"
				end
			else 
				begin
				set svar2 ="W" 
				end
	end
	IF sb_bacid =  "INTER"
	begin
	 set recipttype = "1"
	end

#---For normal receipt
	If recipttype = "0"
	begin
		print "N de transaction" column 1
		print ":" column 22
		print tran_id column 23
		nextline
		print "N de compte" column 1
		print ":" column 22
		print foracid column 23
		nextline
		print "Intitule du compte" column 1
		print ":" column 22
		print acct_name column 23
		nextline
		print "Devise" column 1
		print ":" column 22
		print tranCrncyCode column 23
		nextline
		print "Montant" column 1
		print ":" column 22
		print tranAmt column 23 autocomma size 23 leftjustify
		nextline
			if svar2 = "D"
			begin
				print "Montant en lettres" column 1
				print ":" column 22
				set amt_in_words = numTOWords tranAmt
				set Crncy_Code = tranCrncyCode
				set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words|Crncy_Code" "amt_in_french1"
				set amt_in_french = amt_in_french1
				set amtlen = strlen amt_in_french
				set amtStr = splitstring amt_in_french 1 19
				set amtlen1 = strlen amtStr
				execute tprint_amount_in_words
				set amtlen1 = amtlen1 + 1
				set amtStr = splitstring amt_in_french amtlen1 40
				set amtlen2 = strlen amtStr
				set amtlen1 = amtlen1 + amtlen2
				if (amtlen2 != 0)
				begin
				nextLine
					execute print_amount_in_words
				end
set amtlen1 = amtlen1 + 1
				set amtStr = splitstring amt_in_french amtlen1 40
				set amtlen2 = strlen amtStr
				set amtlen1 = amtlen1 + amtlen2
				if (amtlen2 != 0)
				begin
				nextLine
					execute print_amount_in_words
				end
			end
		else
			if svar2 = "W"
				begin
					print "Montant en lettres" column 1
					print ":" column 22
				set amt_in_words = numTOWords tranAmt
				set Crncy_Code = tranCrncyCode
				set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words|Crncy_Code" "amt_in_french1"
				set amt_in_french = amt_in_french1
					set amtlen = strlen amt_in_french
					set amtStr = splitstring amt_in_french 1 19
					set amtlen1 = strlen amtStr
					execute tprint_amount_in_words
					set amtlen1 = amtlen1 + 1
					set amtStr = splitstring amt_in_french amtlen1 40
					set amtlen2 = strlen amtStr
					set amtlen1 = amtlen1 + amtlen2
					if (amtlen2 != 0)
					begin
					nextLine
						execute print_amount_in_words
					end
set amtlen1 = amtlen1 + 1
					set amtStr = splitstring amt_in_french amtlen1 40
					set amtlen2 = strlen amtStr
					set amtlen1 = amtlen1 + amtlen2
					if (amtlen2 != 0)
					begin
					nextLine
						execute print_amount_in_words
					end
				end
		if svar2 ="D" 
			begin
				print "Montant total credite" column 1
				print ":" column 22
				print tranAmt column 23 autocomma  size 23 leftjustify
				nextline
			end
		else
			if svar2 ="W" 
				begin
					print "Montant total debite" column 1
					print ":" column 22
					print tranAmt column 23 autocomma  size 23 leftjustify
					nextline
				end
			
		if svar2 ="D" 
			begin
				print "Raison" column 1
				print ":" column 22
				set svar1=splitstring tranparticulars 1 19
				set var2=strlen tranparticulars
				set var3=strlen svar1
				print svar1 column 23
				nextLine
				 if (var3 < var2)
				begin
					set var3=var3+1
					set svar1=splitstring tranparticulars var3 40
					print svar1 column 1
					nextline
				end			
			end
		else
			if svar2 ="W" 
				begin
					print "Montant en lettres" column 1
					print ":" column 22
				set amt_in_words = numTOWords tranAmt
				set Crncy_Code = tranCrncyCode
				set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words|Crncy_Code" "amt_in_french1"
				set amt_in_french = amt_in_french1
					set amtlen = strlen amt_in_french
					set amtStr = splitstring amt_in_french 1 19
					set amtlen1 = strlen amtStr
					execute tprint_amount_in_words
					set amtlen1 = amtlen1 + 1
					set amtStr = splitstring amt_in_french amtlen1 40
					set amtlen2 = strlen amtStr
					set amtlen1 = amtlen1 + amtlen2
					if (amtlen2 != 0)
					begin
					nextLine
						execute print_amount_in_words
					end
set amtlen1 = amtlen1 + 1
					set amtStr = splitstring amt_in_french amtlen1 40
					set amtlen2 = strlen amtStr
					set amtlen1 = amtlen1 + amtlen2
					if (amtlen2 != 0)
					begin
					nextLine
						execute print_amount_in_words
					end
				end
			if svar2 ="W" 
				begin
					print "Raison de transaction" column 1
					print ":" column 22
					set svar1=splitstring tranparticulars 1 19
					set var2=strlen tranparticulars
					set var3=strlen svar1
					print svar1 column 23
					nextLine
					 if (var3 < var2)
					begin
						set var3=var3+1
						set svar1=splitstring tranparticulars var3 40
						print svar1 column 1
						nextline
					end	
				end
			
			end
	end
end

##############################################################################
PROCEDURE page_footer
begin
if ( endofrecord = 1)
begin
    print "!"
    print email_id
    print "#"
	set endofrecord = 0
end
end
##############################################################################
# PROCEDURE print_amount_in_words 
##############################################################################
PROCEDURE print_amount_in_words
begin
	print amtStr column 1
   if (amtlen1 >= amtlen)
	begin
		print " seulement"
		nextLine
	end
	
end
##############################################################################
# PROCEDURE tprint_amount_in_words 
##############################################################################
PROCEDURE tprint_amount_in_words
begin
	print amtStr column 23
   if (amtlen1 >= amtlen)
	begin
		print " seulement"
		nextLine
	end	
end
