##############################################################################
ONEVERYRECORD
##############################################################################
nextline
nextline  
nextline
nextline  
print "LETTRE D'ENGAGEMENT ET D'INDEMNISATION" column 37
nextline
print "A L'OBTENTION D'UNE GARANTIE DE BONNE EXECUTION" column 32
nextline
nextline
nextline
print "En considération de la garantie de"
print " "
print loc_crncy_code1
print " "
print loc_BG_amount1
print " ("
### amount to words starts
if(loc_crncy_code1 = "USD")
begin
  print "Dollars Américains"
  print " "
  set decimal_desc = "cent"
end
if(loc_crncy_code1 = "GBP")
begin
  print "Livres britanniques"
  print " "
  set decimal_desc = "penny"
end
if(loc_crncy_code1 = "CDF")
begin
  print "Franc congolais"
  print " "
  set decimal_desc = "centime"
end
set amt_in_words = crncyNumToWords loc_BG_amount1 decimal_desc 
set Crncy_Code = loc_crncy_code1
set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words|Crncy_Code" "amt_in_french1"
set amt_in_french = amt_in_french1
#set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words" "amt_in_french"
set s1 = splitstring amt_in_french 1 35
set deplen1 = strlen s1
if(deplen1 > 0)
begin
   print s1
end
set deplen0 = deplen1 + 1
set s2 = splitstring amt_in_french deplen0 100
set deplen2 = strlen s2
if(deplen2 > 0)
begin
   nextline
   print s2
end
set deplen0 = deplen1 + deplen2 + 1
set s3 = splitstring amt_in_french deplen0 100
set deplen3 = strlen s3
if(deplen3 > 0)
begin
   nextline
   print s3
end
### amount to words ends
print ")."
nextline
print "en faveur du"
print " "
print loc_ben_name1
nextline
print "que vous avez émise selon le texte ci-dessous qui a reçu notre plein accord :"
print " "
nextline
nextline   
nextline
print "GARANTIE DE BONNE EXECUTION" column 40
nextline
nextline
nextline
print "Au"
print " "
print loc_ben_name2
nextline
print "sise"
print " "
print loc_ben_add1
print ", à"
print " "
print loc_ben_city
print "-"
print loc_ben_area
print "."                     
nextline
nextline
print "Nous avons été informés que"
print " "
print loc_Client_Name
print " (ci-après dénommé << le Fournisseur >>) a conclu avec vous "
nextline
print "le Marché"
print " "
print loc_Market_Ref
print " au mois "
print " d'"
print loc_BOD
print " "
print "pour"
print " "
print loc_Purpose_of_BG
nextline
print "(ci-après dénommée << le Marché >>). "
nextline
nextline
print "De plus, nous comprenons qu'une garantie de bonne exécution est exigée en vertu des"
nextline
print "conditions du Marché."
print " "
nextline
nextline
print "A la demande du Fournisseur, nous, EQUITY BCDC nous engageons par"
print " "
nextline
print "la présente, sans réserve et irrévocablement, à vous payer à première demande, toutes"
print " "
nextline
print "sommes d'argent que vous pourriez réclamer dans la limite de"
print " "
print loc_crncy_code2
print " "
print loc_BG_amount2
print " "
print "("
### amount to words starts
if(loc_crncy_code2 = "USD")
begin
  print "Dollars Américains"
  print " "
  set decimal_desc = "cent"
end
if(loc_crncy_code2 = "GBP")
begin
  print "Livres britanniques"
  print " "
  set decimal_desc = "penny"
end
if(loc_crncy_code2 = "CDF")
begin
  print "Franc congolais"
  print " "
  set decimal_desc = "centime"
end
set amt_in_words = crncyNumToWords loc_BG_amount2 decimal_desc 
set Crncy_Code = loc_crncy_code2
set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words|Crncy_Code" "amt_in_french1"
set amt_in_french = amt_in_french1
#set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words" "amt_in_french"
set s1 = splitstring amt_in_french 1 35
set deplen1 = strlen s1
if(deplen1 > 0)
begin
   print s1
end
set deplen0 = deplen1 + 1
set s2 = splitstring amt_in_french deplen0 100
set deplen2 = strlen s2
if(deplen2 > 0)
begin
   nextline
   print s2
end
set deplen0 = deplen1 + deplen2 + 1
set s3 = splitstring amt_in_french deplen0 100
set deplen3 = strlen s3
if(deplen3 > 0)
begin
   nextline
   print s3
end
### amount to words ends
print ")."
nextline
print "Votre demande en paiement doit être accompagnée d'une déclaration attestant que le"
nextline
print "Soumissionnaire ne se conforme pas aux conditions du Marché, sans que vous ayez à"
nextline
print "prouver ou à donner les raisons ou le motif de votre demande ou du montant indiqué"
nextline
print "dans votre demande."
nextline
nextline
print "La présente garantie prend effet le"
print " "
print loc_Eff_date
print " "
print "et expire au plus tard"
print " "
print loc_Exp_date
print "."
nextline
print "Toute demande de paiement y relative doit être reçue par nous, à nos bureaux,"
nextline
print "à cette au plus tard." 
nextline
nextline
print "La présente garantie est régie par les Règles uniformes de la CCI relatives aux garanties"
nextline
print "sur demande en vigueur."
print " "
nextline
nextline
print "Fait à"
print " "
print loc_SOL_City 
print ", le"
print " "
print loc_Issue_date
print "."
nextline
nextline
nextline
nextline
print loc_Responsible1
print loc_Responsible2 column 60
nextline
print loc_Resp1_designation
print loc_Resp2_designation column 60
nextline
nextline
print "Dûment habilités à signer cette garantie pour et au nom de Equity BCDC."
