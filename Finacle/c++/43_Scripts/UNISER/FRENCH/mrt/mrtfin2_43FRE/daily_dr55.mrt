# Template Name :		daily_dr55.mrt
# Description	:		Customer Arrears Executive summary
# Author			E.G.KAROBIA, 12/10/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr35.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

tot_brname_cntr		numberType
tot_pric_amt            numberType
tot_advnd_amt           numberType
tot_arrears             numberType
tot_int_amt             numberType
tot_penal_int		numberType
tot_upto30		numberType
tot_upto60		numberType
tot_upto90		numberType
tot_upto120		numberType
tot_upto150		numberType
tot_upto210		numberType
tot_upto270		numberType
tot_upto360		numberType
tot_over360		numberType
tot_upto180   		numberType

#
GROUPANDSORT
sol_id ascending

PAGEFORMAT
#
linesperpage     60
columnsperline  180
pageheaderlines  8
topMargin	 2
bottomMargin	 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
if total_arreas = 0 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" size 180 center

BEFOREBREAKOF sol_id
    print "Branch : " 
    print " "
    print sol_id    
    nextline
    nextline
#
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
        print sol_id    column 3
	print brname         column 16   
	print pric_amt  column 30 format "#,###,###,###.##"
	print adv_amt  column 51 format "#,###,###,###.##"
	print total_arreas   column 67 format "#,###,###,###.##"
	print upto30  column 83  format "#,###,###,###.##"  
	print upto90  column 99 format "#,###,###,###.##"
	print upto150 column 115 format "#,###,###,###.##"
	print upto210 column 131 format "#,###,###,###.##"
	print upto360 column 147 format "#,###,###,###.##"
	nextline
	print interest   column 49 format "#,###,###,###.##"
	print penal_int column 65 format "#,###,###,###.##"
	print upto60   column 81 format "#,###,###,###.##"
	print upto120  column 97 format "#,###,###,###.##"
	print upto180  column 113 format "#,###,###,###.##"
	print upto270  column 129 format "#,###,###,###.##"
	print over360  column 145 format "#,###,###,###.##"
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "Branch Id "     column 5
	print "Branch Name "   column 18
	print "T_Princpal"    column 38
	print "  T_Amt advanced" column 51
	Print "  T_Arrears "  column 72
	print "  1-30"    column 95
	print "  61-90"   column 111
	print "  121-150" column 127
	print "  181-210" column 143
	print "  271-360"  column 159
	nextline
	print "T_Interest"  column 53
	print "T_Penal Int." column 72
	print "31-60"   column 95
	print "91-120"  column 111
	print "151-180" column 127 
	print "211-270" column 143
	print "Over 360" column 159
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
separatorline
        print "Grand Total" column 1
	set tot_brname_cntr = totalcount brname
	set tot_pric_amt  = totalsum  pric_amt
	set tot_advnd_amt = totalsum advnd_amt
	set tot_arrears  = totalsum  arrears
	set tot_int_amt  = totalsum   int_amt        
	set tot_penal_int = totalsum penal_int		
	set tot_upto30	= totalsum upto30	
	set tot_upto60	= totalsum upto60	
	set tot_upto90	= totalsum upto90	
	set tot_upto120	= totalsum upto120	
	set tot_upto150	= totalsum upto150		
	set tot_upto210	= totalsum upto210	
	set tot_upto270	= totalsum upto270	
	set tot_upto360	= totalsum upto360	
	set tot_over360	= totalsum over360	
	set tot_upto180  = totalsum upto180	
	
	print tot_brname_cntr column 16
        print tot_pric_amt  column 30 format "#,###,###,###.##"
	print tot_advnd_amt column 51 format "#,###,###,###.##"
	print tot_arrears  column 67 format "#,###,###,###.##"
	print tot_upto30  column 83 format "#,###,###,###.##"
	print tot_upto90  column 99 format "#,###,###,###.##"
	print tot_upto150  column 115 format "#,###,###,###.##"
	print tot_upto210  column 131 format "#,###,###,###.##"
	print tot_upto360  column 147 format "#,###,###,###.##"
	nextline
	print tot_int_amt column 49 format "#,###,###,###.##"	
	print tot_penal_int column 65 format "#,###,###,###.##"
        print tot_upto60   column 81 format "#,###,###,###.##"
        print tot_upto120  column 97 format "#,###,###,###.##"
        print tot_upto180  column 113 format "#,###,###,###.##"
        print tot_upto270  column 129 format "#,###,###,###.##"
        print tot_over360  column 145 format "#,###,###,###.##"
	separatorline
end

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     size 180 center
	nextline
	nextline
	print "CUSTOMER ARREARS EXECUTIVE SUMMARY "  size 180 center
	nextline
	nextline
	print "AS AT :" column 70
	print " "
	print date
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 180 center
nextline
nextline
nextline
end

