# Template Name :		daily_dr41.mrt
# Description	:		Customer Arrears Report-Summary
# Author			E.G.KAROBIA, 12/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr41.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
tot_advance_amt		numberType
tot_principal		numberType
tot_interest		numberType
tot_penal_int		numberType
tot_adv_amt		numberType
tot_total_arrears	numberType	
tot_upto30		numberType
tot_upto60		numberType
tot_upto90		numberType
tot_upto120		numberType
tot_upto150		numberType
tot_upto180		numberType
tot_upto210		numberType
tot_upto270		numberType
tot_upto360		numberType
tot_over360		numberType

grnd_advance_amt	numberType
grnd_principal		numberType
grnd_interest		numberType
grnd_penal_int		numberType
grnd_adv_amt		numberType
grnd_total_arrears	numberType
grnd_upto30		numberType
grnd_upto60		numberType
grnd_upto90		numberType
grnd_upto120		numberType
grnd_upto150		numberType
grnd_upto180		numberType
grnd_upto210		numberType
grnd_upto270		numberType
grnd_upto360		numberType
grnd_over360		numberType
#
GROUPANDSORT
sol_id ascending


PAGEFORMAT
#
linesperpage 60
columnsperline 180
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType
REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader

IGNORERECORD
#if total_arrears = 0

ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF sol_id
    print "Branch  : "  column 5
    print " "
    print sol_id     
    nextline
    nextline
#
AFTERBREAKOF sol_id
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
 	 execute printScheduleData
	nextline
end
##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
        print schm_code column 4
	print adv_amt  column 12 format "#,###,###,###.##"
	print principal  column 33 format "#,###,###,###.##"
	print total_arrears column 51 format "#,###,###,###.##"	
	print upto30  column 67  format "#,###,###,###.##"  
	print upto90  column 83 format "#,###,###,###.##"
	print upto150 column 99 format "#,###,###,###.##"
	print upto210 column 115 format "#,###,###,###.##"
	print upto360 column 131 format "#,###,###,###.##"
	nextline
	print interest   column 10 format "#,###,###,###.##"
	print penal_int column 31 format "#,###,###,###.##"
	print upto60   column 65 format "#,###,###,###.##"
	print upto120  column 81 format "#,###,###,###.##"
	print upto180  column 97 format "#,###,###,###.##"
	print upto270  column 113 format "#,###,###,###.##"
	print over360  column 129 format "#,###,###,###.##"
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "  Scheme Code "   column 1
	print "  Advanced Amnt"    column 18
	print "	 Principal" column 38 
	print "  Risk Amnt"  column 53
	print "  1-30"    column 72
	print "  61-90"   column 95
	print "  121-150" column 111
	print "  181-210" column 127
	print "  271-360"  column 143
	nextline
	print "Interest" column 18
	print "Penal Int." column 38
	print "31-60"   column 72
	print "91-120"  column 95
	print "151-180" column 111 
	print "211-270" column 127
	print "Over 360" column 143
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
separatorline
	 print "Grand Total" column 1
	set grnd_principal = totalsum principal
	set grnd_interest = totalsum interest
	set grnd_penal_int = totalsum penal_int
	set grnd_adv_amt = totalsum adv_amt
	set grnd_total_arrears = totalsum total_arrears
	set grnd_upto30 = totalsum upto30
	set grnd_upto60 = totalsum upto60
	set grnd_upto90 = totalsum upto90
	set grnd_upto120 = totalsum upto120
	set grnd_upto150 = totalsum upto150
	set grnd_upto180 = totalsum upto180
	set grnd_upto210 = totalsum upto210
	set grnd_upto270 = totalsum upto270
	set grnd_upto360 = totalsum upto360
	set grnd_over360 = totalsum over360

	print grnd_adv_amt  column 12 format "#,###,###,###.##"
        print grnd_principal  column 33 format "#,###,###,###.##"
        print grnd_total_arrears column 51 format "#,###,###,###.##"
        print grnd_upto30  column 67  format "#,###,###,###.##"
        print grnd_upto90  column 83 format "#,###,###,###.##"
        print grnd_upto150 column 99 format "#,###,###,###.##"
        print grnd_upto210 column 115 format "#,###,###,###.##"
        print grnd_upto360 column 131 format "#,###,###,###.##"
        nextline
        print grnd_interest   column 10 format "#,###,###,###.##"
        print grnd_penal_int column 31 format "#,###,###,###.##"
        print grnd_upto60   column 65 format "#,###,###,###.##"
        print grnd_upto120  column 81 format "#,###,###,###.##"
        print grnd_upto180  column 97 format "#,###,###,###.##"
        print grnd_upto270  column 113 format "#,###,###,###.##"
        print grnd_over360  column 129 format "#,###,###,###.##"

	
separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	separatorline
	 print "Subtotal" column 1
	set tot_principal = groupsum principal
	set tot_interest = groupsum interest
	set tot_penal_int = groupsum penal_int
	set tot_adv_amt = groupsum adv_amt
	set tot_total_arrears = groupsum total_arrears
	set tot_upto30 = groupsum upto30
	set tot_upto60 = groupsum upto60
	set tot_upto90 = groupsum upto90
	set tot_upto120 = groupsum upto120
	set tot_upto150 = groupsum upto150
	set tot_upto180 = groupsum upto180
	set tot_upto210 = groupsum upto210
	set tot_upto270 = groupsum upto270
	set tot_upto360 = groupsum upto360
	set tot_over360 = groupsum over360

	print tot_adv_amt  column 12 format "#,###,###,###.##"
        print tot_principal  column 33 format "#,###,###,###.##"
        print tot_total_arrears column 51 format "#,###,###,###.##"
        print tot_upto30  column 67  format "#,###,###,###.##"
        print tot_upto90  column 83 format "#,###,###,###.##"
        print tot_upto150 column 99 format "#,###,###,###.##"
        print tot_upto210 column 115 format "#,###,###,###.##"
        print tot_upto360 column 131 format "#,###,###,###.##"
        nextline
        print tot_interest   column 10 format "#,###,###,###.##"
        print tot_penal_int column 31 format "#,###,###,###.##"
        print tot_upto60   column 65 format "#,###,###,###.##"
        print tot_upto120  column 81 format "#,###,###,###.##"
        print tot_upto180  column 97 format "#,###,###,###.##"
        print tot_upto270  column 113 format "#,###,###,###.##"
        print tot_over360  column 129 format "#,###,###,###.##"
	

	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "CUSTOMER ARREARS REPORT-SUMMARY "  column 68
	nextline
	nextline
	print "AS AT :" column 70
	print " "
	print date
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end

