#*********************************************************************
#       Author          :     Robert Oduor 
#
#**********************************************************************
#  DESC   : Summary of Monthly Recoveries on Write-Offs Report  
#            
######################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
#
#
solid    	stringType
prvmthtot       numbertype
curmthtot       numbertype 
cumtot          numbertype 
per             numbertype 
prvmthac        numbertype
curmthac        numbertype
ctot            numbertype	
cper            numbertype 
dmdtot          numbertype 
ttot            numbertype 
LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
#Total_Dis_amt numbertype

GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is already sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in
#   RECORDLAYOUT section.
#################################################################### 

REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
#branchName      stringtype
#############################################################################
#
#   REPOSITORY (Optional Section) - Fixed-Type Repository.
#   This section tells about the Repository Information. A  Repository  is  a
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#   Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#
#############################################################################
REPOSITORY argv4
setId           stringtype
asondate        stringType
#
#
#MASSAGERECORD
#############################################################################
#
#   MASSAGERECORD (Optional Section).
#   The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#   later. This Block is executed every time a new record is read.
#
#############################################################################
#
#
#IGNORERECORD
#############################################################################
#
#   IGNORERECORD (Optional Section).
#   The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
#   for input records), the record is Ignored.
#
#############################################################################
#
#
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperpage     70
pageheaderlines      5 
pagefooterlines       2 
topmargin       1
bottommargin   1
leftmargin       2 
rightmargin     2 
columnsperline 160 
#
ONSTARTOFREPORT
####################################################################  
print bankname   size 100 center 
nextline
print "SUMMARY OF MONTHLY RECOVERIES ON WRITE-OFFS REPORT"   size 100 center 
nextline
print "From Branch xxx to Branch yyy"   size 100 center 
nextline
print "Total write offs as at "   column 2 
print today column 25  size 10
print "Kshs" column 36 size 5
print "No. of Accounts written off."   size 100 center
separatorline
execute pipe
print "Branch" column 5 
print "recovery last month" column 13
print "Recovery this" column 33 size 20 center
print "Cummulative" column 53 size 20 center 
print "Total %"  column  74 size 13 center 
print "No. of A/Cs" column  87 size 15 center 
print "No. of A/Cs" column 103 size 15 center 
print "Cummulative"column 118 size 12 center
print "Total % A/Cs" column 131 size 15 center 
nextline
execute pipe
print "(shs)" column 13 size 19 center
print "months (shs)" column 33 size 20 center
print "Recovery to date"column 53 size 20 center
print "recovered to" column 74 size 13 center
print "recovered last" column 87 size 15 center
print "recovered this" column 103 size 15 center
print" No. of A/Cs" column 118 size 12 center
print "recovered to" column 131 size 15 center
nextline
execute pipe
print"Kshs" column 53 size 20 center
print "date" column 74 size 13 center
print "month" column 87 size 15 center
print "month" column 103 size 15 center
print "recovered" column 118 size 12 center
print "date" column 131 size 15 center
separatorline
#
#
PAGEHEADER
####################################################################
#pageheader on each page
####################################################################
#execute pghdr
print "SUMMARY OF MONTHLY RECOVERIES ON WRITE-OFFS REPORT" column  30 
print today column 65
nextline
separatorline
print "From Branch xxx to Branch yyy"   size 100 center
nextline
print "Total write offs as at today"   column 2
print "No. of Accounts written off."   size 100 center
separatorline
print "Branch" column 5
print "recovery last month (kshs)" column 13
print "Recovery this mnth (Kshs)" column 29
print "Cummulative Recovery to date (kshs)" column 51
print "Total % Recovered to Date"  column 50
print "No. of A/Cs recovered last mnth" column 65
print "No. of A/Cs recovered this mnth"
print "Cummulative no. of A/Cs recovered"
print "Total % A/Cs recovered to date"
separatorline
#
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################
print solid         column 5   size 8  
print prvmthtot     column 13 format "###,###,###.##"   
print curmthtot     column 33  format "###,###,###.##" 
print cumtot        column 53  format "###,###,###.##" 
print per           column 74  size 13 
print prvmthac      column 87  size 15
print curmthac       column 103 size 15  
print ctot          column 118 size 12  
print cper          column  131 size 15 

#BEFOREBREAKOF 
#
#
#AFTERBREAKOF 
#separatorline
#set sub_total = groupsum secu_value
#set sub_count = groupcount acct_name
#print "SUB TOTAL" column 5
#print sub_count column 23
#print sub_total column 70 size 15 precision 2 rightjustify 
#separatorline
####################################################################
# After break 
####################################################################
#
#
ONENDOFREPORT
#############################################################################
#
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
#
#############################################################################
#set Total_Dis_amt = totalsum dis_amt 
#print Total_Dis_amt column 50 size 15 precision 2 rightjustify
separatorline
nextline
nextline
print "Printed by:.................." column  70 
nextline
nextline
print "System......................"   column  70 
nextline
nextline
print "Time:..............." column  70 
#
#
#############################################################################
#
#   PROCEDURE BLOCK.
#   Procedure  itself is a Independent  Block  and  defined at the end of the
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#   Template File, Makes  it  Structured  and  avoids burring the same set of
#   codes at several places.
#
#############################################################################
#
#
#procedure pghdr
########################################################################
PROCEDURE pipe 
##############################################################################
begin
print "|" column 1
print "|" column 12
print "|" column 32 
print "|" column 52
print "|" column 73
print "|" column 86
print "|" column 102
print "|" column 117
print "|" column 130
print "|" column 149
end
####################################################################
# End of File
######################################################################
