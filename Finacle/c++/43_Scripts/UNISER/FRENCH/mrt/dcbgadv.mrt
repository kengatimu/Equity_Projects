#
###################################################################
#
#
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include dcbgadv.mri
#
LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
#
tot_debit_amt		numbertype
tot_debit_amt_str	stringtype	
amt_in_words		stringtype
toggle 				numbertype
currency			stringtype
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in 
#   RECORDLAYOUT section.
####################################################################
dc_bg_num
ChargeTranId
#############################################################################
#
#	REPOSITORY (Optional Section) - Fixed-Type Repository.
#	This section tells about the Repository Information. A  Repository  is  a 
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#	Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#   
#############################################################################
REPOSITORY  argv4
bankName		stringType
branchName		stringType
branchAddr1		stringType
branchAddr2		stringType
branchCity		stringType
branchState		stringType
branchPinCode		stringType
bodDate			stringType
languageCode		stringType
PAGE_NUMBER		numberType

MASSAGERECORD
#############################################################################

# 	MASSAGERECORD (Optional Section).
# 	The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#	later. This Block is executed every time a new record is read.
#
#############################################################################


#############################################################################
#
# 	IGNORERECORD (Optional Section).
# 	The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
# 	for input records), the record is Ignored.
#
#############################################################################
IGNORERECORD
####################################################################
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    65
columnsperline  80
topMargin        0
bottomMargin     0
leftMargin       0

 BEFOREBREAKOF ChargeTranId
####################################################################
#   This section will be print heading for a single Advice
####################################################################

set toggle = 0
set currency = currency_code

print "" size 80 fillAscii 45 
nextLine

print "To" column 1
print " | " column 39
#
print "From" column 40
nextLine
#
print name size 38 column 1
print " | "
print bankName size 38
nextLine
#
print address1 size 38 column 1
print " | "
print branchName size 38
nextLine
#
print address2 size 38 column 1
print " | "
print branchAddr1 size 38
nextLine
#
print address3 size 38 column 1
print " | "
print branchAddr2 size 38
nextline
#

print  partyStateName  
print " | "	column 39 
#print ", "
print branchState
print " -"
print branchPinCode
nextLine
#
print partyCntryName size 38 column 1
print " | "
print	"KENYA" 
print bodDate size 10 column 70
nextLine
#
print "" size 80 fillAscii 45 
nextLine
#
if dc_bg_ind = "D"
begin
 print "DC  CHARGES  ADVICE"  center size 80 column 1
end
if dc_bg_ind = "B"
begin
 print "BG  CHARGES  ADVICE"  center size 80 column 1
end
nextLine
#
#
print "" size 80 fillAscii 45 
nextLine
#
#
if dc_bg_ind = "D"
begin
	print "DC  Number  " column 1
	print dc_bg_num
end
else if dc_bg_ind = "B"
begin
	print "BG  No.  " column 1
	print dc_bg_num 
end

print	"For" column 48
print 	"  "	
print   entity_crncy_code
print 	"  "	
print 	entity_open_amt
#print 	"  "	
#if entity_crncy_code !=	"INR"
#begin
#print	entity_rate precision 2
#end
nextline
if dc_bg_ind = "D"
 begin
  print "DC Favouring:  " column 1
end
if dc_bg_ind = "B"
begin
 print "BG Favouring:  " column 1
end

print other_party_name
nextline

print "Event Type: " column 1
execute printCurrentOperation
print "Transaction Date : " column 48
print chrg_tran_date size 10 column 67
nextLine


print "Event Value: " column 1
print	event_crncy_code
print 	"  "	
print   event_amt 
# print "Charge Value" column 48
# Execute chrgval
nextline


IF dc_bg_ind = "B"
BEGIN
#print "BG Tenor:"	column 1
# print bg_tenor~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#nextline
print "BG Expiry Date " column 1
print	expiry_date SIZE 10
nextline
#print "BG Claim period" column 1
# print ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#nextline
END
#
ELSE
BEGIN
print "DC Expiry Date " column 1
PRINT expiry_date		column 16  size 10
END

separatorline

print " We advice having debited your account as under: "	column 1
nextline
#print "Your Ref:"	column 1
# Print letter_ref_num ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
nextline
#print "DC Favouring: "
#print other_party_name
#separatorline  
#print " Debit Advice"   size 80 	column 1 center
#separatorLine
print "A/C No.:" column 1
print foracid
print "Amount: " column 48
#print currency_code 
print "<<CRNCY>>" 
print "  "
print 	"<<DEBIT>>" 
#end	
separatorline
print "Break-Up Of Debit" column 1
separatorline
# Print PST details if they are dumped.
#execute printConvDetails

BEFOREBREAKOF	dc_bg_num 
####################################################################
#   This section will be print heading for a single Advice
####################################################################

#

AFTERBREAKOF dc_bg_num 
#####################################################################
#   This section will be responsible for  ending advice for a single tran_id
####################################################################



AFTERBREAKOF ChargeTranId
####################################################################
#   This section will be print heading for a single Advice
####################################################################
set tot_debit_amt		=	GROUPSUM	tran_amount
set amt_in_words		=	NumtoWords	tot_debit_amt
#set tot_debit_amt_str	=   numtostr	tot_debit_amt
#set tot_debit_amt		=	prnTagval	"DEBIT"  tot_debit_amt_str
print "" size 80 fillAscii 45 
nextline
print "Amount in Words (Total Debit): " column 1

if toggle = 0
begin
print currency 
print " "
print amt_in_words
set tot_debit_amt_str	=   numtostr	tot_debit_amt
set tot_debit_amt		=	prnTagval	"DEBIT"  tot_debit_amt_str
set currency			=   prnTagval   "CRNCY"	 currency
end	
else
begin
set tot_debit_amt       =   prnTagval   "DEBIT"  ""
set currency            =   prnTagval   "CRNCY"  "" 
end

separatorline
nextline
nextline
nextline
print "Authorised Signatory    " column 1
nextline
nextline
nextline
print "TRADE FINANCE DEPT:"  column 1

#print "***This is a computer generated advice and does not require any signature***" column 1
nextPage
#
ONEVERYRECORD
####################################################################
#   This section will be responsible for actual printing of TRANSACTION
#	ADVICE. It will be executed once for each recod.
####################################################################
#
#print charge_desc column 1 size 50
print charge_desc column 1 
execute PrintCommDet
#print currency_code column 55
print currency_code column 60 size 5
print	tran_amount column 65 	size 15		rightjustify

if currency != currency_code
begin 
set toggle = 1
end



ONENDOFREPORT
##############################################################################
#
#	ONENDOFREPORT (Optional Section).
#	This Section  will be  executed  Only  Once  during the Processing of the 
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#	NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#	If, Else, execute, DontFlushAfterSection.
#
#############################################################################
print "" size 80 fillAscii 45 
set PAGE_NUMBER = PAGE_NUMBER + pageNumber
#############################################################################
#
# 	PROCEDURE BLOCK.
#  	Procedure  itself is a Independent  Block  and  defined at the end of the 
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#	Template File, Makes  it  Structured  and  avoids burring the same set of 
#   codes at several places.
#
#############################################################################
PROCEDURE printCurrentOperation
if dc_bg_ind= "D"
begin
	if event_type = "R"
		print "Reinstatement"
	if event_type = "B"
		print "Utilis"
	if event_type = "U"
		print "Utilisation"
	if event_type = "A"
		print "Amendment"
	if event_type = "E"
		print "Advise"
	if event_type = "S"
		print "Issue"
	if event_type = "F"
		print "Status Change"
	if event_type = "T"
		print "Transferred"
	if event_type = "G"
		print "Lodge"
	if event_type = "N"
		print "Transfer"
	if event_type = "Z"
		print "Close"
end		
#		
else if dc_bg_ind= "B" 
begin
	if event_type = "A"
		print "ISSUE"
	if event_type = "E"
		print "Extend"
	if event_type = "O"
		print "Expire"
	if event_type = "G"
		print "Invoke"
	if event_type = "N"
		print "Invoke"
	if event_type = "R"
		print "Reverse"
	if event_type = "K"
		print "InvokeAndClose"
	if event_type = "Z"
		print "Closure"
	if event_type = "P"
		print "Utilise"
	if event_type = "X"
		print "Cancel"
	if event_type = "M"
		print "Amendment"
end		
#

Procedure PrintCommDet

if system_calc_amt = tran_amount
begin
#print "  (@2.0%)" 
print "    "
end


# **************      END OF MRT FILE dcbgadv.mrt    ************************
