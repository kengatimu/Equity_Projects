RECORDLAYOUT  
####################################################################
# 	This is a sample mrt for FAB cash withdrawal voucher printing 
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include fab_tran.mri

LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
callscript		stringType
lv_setid		stringType
lv_userId		stringType
lv_setdesc		stringType
lv_username		stringType
lv_accnt		stringType
lv_accntname		stringType
lv_accntname1		stringType
lv_accntname2		stringType
 namlen			numberType
 namlen1		numberType
sumTotal		numberType
amtInWords 		stringType
amtlen			numberType
amtlen1			numberType
amtlen2			numberType
amtStr			stringType
amtStr2			stringType
endofrecord		numberType
date			stringType


GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################

IGNORERECORD
	
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
LinesPerPage 55
LeftMargin  0
rightMargin 	0
Topmargin 1
BottomMargin 1
columnsPerLine 55
pageHeaderLines	6
pageFooterLines 1


ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
set date = today

PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
nextline
execute page_hdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute voucher_routine 

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
begin
nextline
nextline
print "To the debit of my or our" 
 nextline
 print "account" column 1
nextline
nextline
print "SIGNATURE:__________________" column 1
nextline
nextline
print "AUTHORISED BY:____________________" column 1
nextline
 nextline
 print "THANK YOU FOR YOUR CONTINUED SUPPORT" column 1
 nextline
 nextline
print "YOU WERE SERVED BY: " column 1
set lv_userid = posted_user_id
set callscript = runscript "getuser.scr" "lv_userid" "lv_username"
print lv_username 
nextline
nextline
print "Kes 2/- Stamp Duty Paid" column 1
nextline
print "for withdrawal above 40/-"
end


######################################################################
#  PROCEDURE page_hdr
######################################################################
PROCEDURE page_hdr

begin
print "****EQUITY BANK LIMITED****" column 8
nextline
set lv_setid = initSolId 
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print lv_setdesc column 10
nextline
print "CASH WITHDRAWAL" column 8
nextline
nextline
end
######################################################################
#  PROCEDURE voucher_routine 
######################################################################

PROCEDURE voucher_routine 

print "SECURITY NO:" column 1
print tranId 
nextline
nextline
print "DATE :      " column 1
print tranDate size 10
nextline
nextline
print "TIME :      " column 1
set date=splitstring date 12, 8
print date
nextline
nextline
print "ACCOUNT NO :" column 1
print drAcct
nextline
nextline
print "NAME: " column 1
set lv_accnt = drAcct  
set callscript = runscript "getname.scr" "lv_accnt" "lv_accntname"
begin
 set namlen = strlen lv_accntname
 set lv_accntname1 = splitstring lv_accntname 1,18
 set namlen1 = strlen lv_accntname1
 set lv_accntname2 = splitstring lv_accntname namlen1,37
 print lv_accntname1 
 nextline 
 print  lv_accntname2 column 5
end
nextline
nextline
print "CHEQUE NO: " column 1
print " "
print instNum 
nextline
nextline
print "REMARKS: " column 1 
print tranparticulars size 24 
nextline
nextline
print "Received the sum of " column 1
nextline
nextline
print drAcctDtlacctCrncyCode column 1
print " "
print tranAmt autocomma size 20 
nextLine
nextline
set amtInWords = numTOWords tranAmt
set amtlen = strlen amtInWords
set amtStr = splitstring amtInWords 1 25
set amtlen1 = strlen amtStr
execute print_amount_in_words
set amtlen1 = amtlen1 + 1
set amtStr = splitstring amtInWords amtlen1 25
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
execute print_amount_in_words
end
set amtStr = splitstring amtInWords amtlen1 25
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
execute print_amount_in_words
end
set amtStr = splitstring amtInWords amtlen1 25
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
execute print_amount_in_words
end
set amtStr = splitstring amtInWords amtlen1 25
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
execute print_amount_in_words
end
set amtStr = splitstring amtInWords amtlen1 25
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
execute print_amount_in_words
end
set amtStr = splitstring amtInWords amtlen1 25
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
execute print_amount_in_words
end
##############################################################################
# PROCEDURE print_amount_in_words 
##############################################################################
PROCEDURE print_amount_in_words
begin
	print amtStr column 1
   if (amtlen1 >= amtlen)
	begin
		print "Only."
	end
	nextLine
end
