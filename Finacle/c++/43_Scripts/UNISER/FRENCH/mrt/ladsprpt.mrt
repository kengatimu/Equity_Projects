#################################################################
#  FILE   :  ladsprpt.mrt
#  DATE   :  12-04-99
#  AUTHOR :  Rajendra
#  DESC   :  This is the Mahareport specs for generating 
#             loan recovery report
###################################################################
#
#
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
LoanAccount  stringtype
LoanAccountCurrency stringtype
LoanAccountSolId stringtype
LoanAccountCustId stringtype
LoanInterestAccount stringtype
LoanOperativeAccount stringtype
OperativeAccountCurrency stringtype
OperativeAccountSolId stringtype
OperativeAccountBalance stringtype
DemandsatisfiedRatecode stringtype
PrincipalDemandRecovered numbertype
InterestDemandRecovered numbertype
BankchargesDemandRecovered numbertype 
OtherchargesDemandRecovered numbertype 
TranId     stringtype
InterestRouteFlag   stringtype
DemandsatisfiedMethod stringtype
LienAmounttobelifted stringtype
RecoveryMode   stringtype
PrincipalDemandPending numbertype
InterestDemandPending numbertype
BankchargesDemandPending numbertype
OtherchargesDemandPending numbertype
TodAmount      stringtype
LoanpaymentAccount stringtype
AmtSatFromOperAcct  stringtype
ExcreditinLPA stringtype
AmtSatFromLPA	stringtype
totalFeeCollAmt numbertype
#
LOCALVARIABLES
####################################################################
# Local variables are defined here
recsum numbertype
pendsum numbertype
Reccount numbertype    
len1 numbertype   
localdate       numberType
localyears      numberType
localtoday      numberType 
callscript      stringType
####################################################################
#
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in 
#   RECORDLAYOUT section.
####################################################################
LoanAccountSolId    Ascending
LoanAccountCurrency 
LoanAccount   Ascending
#############################################################################
#
#	REPOSITORY (Optional Section) - Fixed-Type Repository.
#	This section tells about the Repository Information. A  Repository  is  a 
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#	Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#   
#############################################################################
REPOSITORY argv4
reportTo stringType
SolSetId stringtype
SetIdDesc stringtype
TypeofDmd stringtype
DmdDesc stringtype
RecovMode stringtype
RecovModeDesc stringtype
FromAcct stringtype
ToAcct stringtype
Schmes stringtype
ExcessCrFlg stringtype
RecFeeFlg stringtype  
ProductGrp stringtype
ProductGrpDesc stringtype
PrioritizationFlg stringtype
pageno             numberType
###########################################################################
REPOSITORY  bankRepos.rip
###########################################################################
bankName   stringType
branchName stringType
uniformBrcode stringType
branchCity stringType
branchPinCode stringType
branchState stringType
branchAddr1 stringType
branchAddr2 stringType
branchAddr3	stringType  
localYearsToAdd                 stringType
#############################################################################
MASSAGERECORD
#############################################################################
#
# 	MASSAGERECORD (Optional Section).
# 	The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#	later. This Block is executed every time a new record is read.
#
#############################################################################


#############################################################################
#
# 	IGNORERECORD (Optional Section).
#The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
# 	for input records), the record is Ignored.
#
#############################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    65
columnsperline  132
topMargin        2
bottomMargin     2
leftMargin       2
pageHeaderLines	 7
pageFooterLines   7
####################################################################
PAGEHEADER
####################################################################
# This section prints the header
####################################################################
print "     "
set localtoday = stringToDate today
set localtoday = periodAdd localtoday localyears Y
print localtoday DateFormat "" column 1
print " "
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "HH24:NN:SS"
print bankName column 30
print "   "
print branchName column 50
print "Page: "  column 90
print pageNumber column 95  size 4 precision 0
nextline
print "Recovery modes:"
nextline
print "O = From Operative Account" column 1
print "   F= From Overflow Amount"
print "   L = From Loan Payment Account" 
print "   B = From Loan Payment  & Operative Account" 
nextline 
####################################################################
# This section prints the footer
####################################################################
PAGEFOOTER
####################################################################
ONSTARTOFREPORT
####################################################################
# This section initializes all the local variables.
set localyears = strToNum localYearsToAdd
set Reccount = 0
set recsum = 0
set pendsum = 0
set pageNumber = 1
set localtoday = stringToDate today
set localtoday = periodAdd localtoday localyears Y
print localtoday DateFormat "" column 1
print " "
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "HH24:NN:SS"
print "     "
print bankName column 30
print " "
print branchName column 60
print "Page: "  column 90
print pageNumber column 95  size 4 precision 0
nextline
nextline
nextline
nextline
nextline
print      "LOAN RECOVERY STATUS REPORT" column 29
nextline
nextline
print "CRITERIA" column 35
nextline
nextline
print "Report To  " column 20 
print ":" column 58 
print reportTo column 60 
nextline
print "SERVICE OUTLET SET ID    " column 20
print ":" column 58
print SolSetId   column 60
print SetIdDesc column 70
nextline
print "TYPE OF DEMAND  " column 20
print ":" column 58
print TypeofDmd column 60
print DmdDesc column 62
nextline
print "RECOVERY MODE " column 20
print ":" column 58
print RecovMode column 60
print RecovModeDesc column 62
nextline
print "FROM ACCOUNT" column 20
print ":" column 58
print FromAcct column 60
nextline
print "TO ACCOUNT" column 20
print ":" column 58
print ToAcct column 60
nextline
print "PRODUCT GROUP" column 20
print ":" column 58
print ProductGrp column 60
print ProductGrpDesc column 66
nextline
print "SCHEMES" column 20
print ":" column 58
set len1 = strlen Schmes
if(len1 > 60)
begin
    print substr Schmes 1 60 column 60
    nextline
    print substr Schmes 61 120 column 60
end
else
begin
    print Schmes size 60 column 60
end
nextline
print "Leave Excess Amt in Loan Payment A/c " column 20
print ":" column 58
print ExcessCrFlg column 60
nextline
print "Collect Pending Fee" column 20
print ":" column 58
print RecFeeFlg column 60
nextline
print "Prioritization Flag  " column 20
print ":" column 58
print PrioritizationFlg column 60
nextpage 
####################################################################
BEFOREBREAKOF LoanAccountSolId
####################################################################
print "SERVICE OUTLET:" column 2
print LoanAccountSolid column 21
####################################################################
BEFOREBREAKOF LoanAccount
####################################################################
print "Account Id" column 2
print "CIF ID" column 21 
print "TranId" column 40
print "Recovery Mode" column 50
nextline
print LoanAccount  column 2 
print LoanAccountCustId column 21 
print TranId column 40
print Recoverymode column 50
nextline
execute PrintHeader
dontFlushAfterSection	
##################################################################
BEFOREBREAKOF LoanAccountCurrency
##################################################################
print "CURRENCY CODE :    " column 2
print LoanAccountCurrency column 21
####################################################################
AFTERBREAKOF  LoanAccount  
####################################################################
if (Reccount = 0)
begin
execute PrintHeader
nextline
separatorline
nextline
print "**********No records are selected************" column 50 
nextline
separatorline
end
nextline
print "Recovered" column 2
print groupSum PrincipalDemandRecovered size 15 column 13 rightJustify autoComma   
print groupSum InterestDemandRecovered size 15 column 31 rightJustify autoComma    
print groupSum BankchargesDemandRecovered size 15 column 46 rightJustify autoComma  
print groupSum OtherchargesDemandRecovered size 15 column 64 rightJustify autoComma  
print groupSum totalFeeCollAmt size 15 column 82 rightJustify autoComma  
set recsum = PrincipalDemandRecovered+InterestDemandRecovered+BankchargesDemandRecovered+OtherchargesDemandRecovered+totalFeeCollAmt   
print recsum size 18 column 100 rightJustify autoComma
nextline 
print "Pending" column 2
print groupMin PrincipalDemandPending size 15   column 13 rightJustify autoComma  
print groupMin InterestDemandPending size 15 column 31 rightJustify autoComma  
print groupMin BankchargesDemandPending size 15  column 46 rightJustify autoComma  
print groupMin OtherchargesDemandPending size 15  column 64 rightJustify autoComma  
set pendsum = PrincipalDemandPending+InterestDemandPending+BankchargesDemandPending +OtherchargesDemandPending 
print pendsum size 18 column 100 rightJustify autoComma
nextline
nextline
####################################################################
ONEVERYRECORD
####################################################################
#	It will be executed once for each recod.
########################################################################
set Reccount = Reccount + 1
if(TranId != "")
begin
set callscript = runscript "VATTranUpdate.scr" "LoanAccount|TranId" "|"
end
dontFlushAfterSection
####################################################################
ONENDOFREPORT
set pageno = pageNumber
#############################################################################
#
#	ONENDOFREPORT (Optional Section).
#	This Section  will be  executed  Only  Once  during the Processing of the 
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#	If, Else, execute, DontFlushAfterSection.
#
#############################################################################
nextline
nextline
print "Date" column 1
set localtoday = stringToDate today
set localtoday = periodAdd localtoday localyears Y
print localtoday DateFormat "" column 6
nextline
print "Place" column 1
print " " column 8
print "Verified By  " column 40
print "Senior Manager" column 80
#############################################################################
#
# 	PROCEDURE BLOCK.
#  	Procedure  itself is a Independent  Block  and  defined at the end of the 
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#	Template File, Makes  it  Structured  and  avoids burring the same set of 
#   codes at several places.
#
#############################################################################
PROCEDURE PrintHeader
#############################################################################
separatorline
print "Principal" size 15  column 13 rightJustify
print "Interest" size 15  column 31 rightJustify
print "Bank Charges" size 15  column 46 rightJustify
print "Other Charges" size 15 column 64 rightJustify
print "Fees Collected" size 15 column 82 rightJustify
print "Total" size 15 column 103  rightJustify
separatorline
nextline
#############################################################################
