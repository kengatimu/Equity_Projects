# Template Name :		nwaccounts.mrt
# Description	:		unverified Accounts
# Author			E.G.KAROBIA,27-05-2006
# 
#########################################################################
RECORDLAYOUT
sol_id		stringType
foracid		stringtype
iban_number	stringtype
acct_name	stringtype
schm_code	stringtype
acct_crncy_code	stringtype
cif_id		stringtype
NATIONAL_ID	stringtype
acct_opn_date	stringType

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 70
columnsperline 150
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId				stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 70 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print sol_id		column 2
	print foracid		column 9  
	print iban_number	column 27 
	print acct_name		column 53 
	print schm_code		column 85 
	print acct_crncy_code	column 97 
	print cif_id		column 105
	print NATIONAL_ID	column 119
	print acct_opn_date	column 137	
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "Branch "		column 2	
	print "Foracid"		column 9
	print "Iban_Number"	column 27
	print "Acct_name"	column 53
	print "Schm_code"	column 85
	print "Crncy"		column 97
	print "Cif_id"		column 105
	print "NATIONAL_ID"	column 119
	print "Open_date"	column 137
	Separatorline
end 


#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 70 center 
	nextline
	print branchName  size 70 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 70 center
	nextline
	print " Mass Accounts Opened "  size 70 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 70 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	
	print "|"   column 1
	print "|"   column 8
	print "|"   column 26
	print "|"   column 52
	print "|"   column 84
	print "|"   column 96
	print "|"   column 104
	print "|"   column 118
	print "|"   column 136
	print "|"   column 149
end


