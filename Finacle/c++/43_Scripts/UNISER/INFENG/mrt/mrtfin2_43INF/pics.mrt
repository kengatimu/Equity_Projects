# Template Name :		pics.mrt
# Description	:		Inward clearing schedule for PICS
# Author		:   	P.N.MOORTHY,20/9/96
# Modified			E.G.KAROBIA, 08/09/05
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include inwclginstdetails.mri
$$$include inwclgstatdetails.mri
$$$include inwclgptrandetails.mri
#
#

LOCALVARIABLES
###########################################################################
#	For MICR instruments only
###########################################################################
date	            stringType
date1		    stringType
date2               stringType
tot_inst_amt        numberType
inst_num_cntr       numberType
grand_tot_inst_amt  numberType
grand_inst_num_cntr numberType
record_counter      numberType
localdate		numberType
localyears		numberType
localtoday		numberType

#
GROUPANDSORT
ZoneSolId
tranCode

PAGEFORMAT
#
linesperpage 60
columnsperline 160
pageheaderlines 50
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType
dpCode		    stringType
localYearsToAdd		stringType
#
REPOSITORY argv4
PAGE_NUMBER                     numberType
zone_date                       stringType 
pg0_zone_code               	stringType
zone_desc                   	stringType
zone_set_id            		stringType
zone_set_id_desc                stringType
inst_set_id           		stringType
inst_set_id_desc               	stringType
report_to              	 	stringType
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute reportheader
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
print "Authorised Signatory (BRANCH)" column 50	
print "Authorised Signatory"  column 107
nextline
nextline
nextline
print "Signature" column 107
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF ZoneSolId
    print "Transcations For Service Outlet : " 
    print " "
    print   ZoneSolId   
    nextline
    nextline
#
AFTERBREAKOF tranCode 
if (record_counter != 0)
begin
execute printSubTotals
set grand_tot_inst_amt=grand_tot_inst_amt+tot_inst_amt 
set grand_inst_num_cntr=grand_inst_num_cntr+inst_num_cntr
set tot_inst_amt=0
set inst_num_cntr=0 
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	set tot_inst_amt=tot_inst_amt+instrumentAmount
	set inst_num_cntr=inst_num_cntr+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
	print tranCode           size 5 column 1
	print foracid            size 13 column 6
	print custName           size 20 column 20
	print instrumentNumber   size 10 column 40
	print issuingBankName    size 15 column 52
	print issuingBranchName  size 15 column 70
	print tranParticulars    size 15 column 85
	print instrumentAmount   autocomma size 15 column 95
	print lchgUserId         size 15 column 125
	print verifiedUserId     size 15  column 135
#	print tranRemarks    size 12 column 150
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "Tran Code "    column 1
	print "A/c #"         column 10 
	print "A/c Name"      column 24
	print "Inst #"        column 43
	print "Bank "         column 55
	print "Branch"        Column 70
	print "Payee"         column 85
	print "Amount"        column 105
        print "OperatorId"   column 120
	print "SupervisorId" column 132
	print "Remarks "      column 145
	separatorline
        set date = substr zone_date 1,10
end 

PROCEDURE printGrandTotals
##############################################################################
begin
separatorline
print "Grand Total" column 25
print grand_inst_num_cntr     column 43
print grand_tot_inst_amt autocomma size 16 column 95 
print " "
print zoneCurrencyCode    
separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	print "----------------------------------------------------------------------------------------"  column 25 
	nextline
	print "Subtotal" column 25
	print inst_num_cntr    column 43
	print tot_inst_amt autocomma size 16 column 95
	print " "
	print zoneCurrencyCode  
	nextline
	print "----------------------------------------------------------------------------------------"  column 25 
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "INWARD CLEARING REPORT "  column 70
	nextline
	nextline

end	
############################################################################
											   
PROCEDURE reportheader
############################################################################
begin
	set date = substr zone_date 1,10

	print "ZONE SETID:"   column 20
	print " "
	print zone_set_id 
	print " "
	print zone_set_id_desc  
	print "; "
	print "INST SETID:"  
	print " "
	print inst_set_id                    
	print " "
	print inst_set_id_desc 
	print "; "
	print "ZONE DATE:" 
	print " "
	print date 
	print "; "
	print "ZONE CODE:"
	print " "
	print  pg0_zone_code
	print " ;"
	nextline
	nextline
end
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end

