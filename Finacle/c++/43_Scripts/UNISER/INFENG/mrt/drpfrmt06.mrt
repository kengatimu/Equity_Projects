RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include drp.mri

LOCALVARIABLES 
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
attribute				stringType
deposit_amount_in_words stringType
amt_in_words 		 stringType
amt_in_french		stringType
amt_in_words1 		 stringType
amt_in_french1		stringType
DepYrs		numberType
DepMon		numberType
DepDays		numberType
Duration	stringType
Dur_in_french1	stringType
Crncy_CodeX		stringType
amtlen			numberType
amtlen1			numberType
amtlen2			numberType
amtStr			stringType
amtStr2			stringType
amtStr3			stringType
lv_var16		stringType
lv_var17		stringType
lv_var18		stringType
lv_var19		stringType
s1 			stringType
s2 			stringType
s3 			stringType
s4 			stringType
s5 			stringType
deplen1     numberType
deplen2     numberType
row_num     numberType
localdate		numberType
localyears		numberType
tdAcctNum		stringType
opAcctNum		stringType
BrsolId		stringType
BrCity		stringType
callscript              stringtype
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
localYearsToAdd		stringType

IGNORERECORD
	
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
	LinesPerPage 64
#	LeftMargin 3 
#	rightMargin 2	
#	Topmargin	2
	BottomMargin 2
#	columnsPerLine 80
	columnsPerLine 120 
      pageHeaderLines	1
      pageFooterLines 2

ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
set localyears = strToNum localYearsToAdd
PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
set deposit_amount_in_words = numToWords deposit_amount
	if crncy_code = "INR"
	begin
		set crncy_code = "Rs."
	end
set deposit_amount_in_words = crncyNumToWords deposit_amount desiDesc
#set s1 = splitstring deposit_amount_in_words 1 40
set s1 = splitstring deposit_amount_in_words 1 40
set deplen1 = strlen s1
set deplen1 = deplen1 + 1
set row_num = 1
set s2 = splitstring deposit_amount_in_words deplen1 80
set deplen2 = strlen s2
set deplen1 = deplen1 + deplen2
	if deplen2 > 0
	begin
		set row_num = 2
	end
set s3 = splitstring deposit_amount_in_words deplen1 45
set deplen2 = strlen s3
set deplen1 = deplen1 + deplen2
	if deplen2 > 0
	begin
		set row_num = 3
	end
set s4 = splitstring deposit_amount_in_words deplen1 45
set deplen2 = strlen s4
set deplen1 = deplen1 + deplen2
	if deplen2 > 0
	begin
		set row_num = 4
	end
set s5 = splitstring deposit_amount_in_words deplen1 45
set deplen2 = strlen s5
	if deplen2 > 0
	begin
		set row_num = 5
	end

execute dep1Details
#BEFOREBREAKOF srlnum

#AFTERBREAKOF srlnum

#BEFOREBREAKOF pt_type
#AFTERBREAKOF pt_type
ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################

##############################################################################
# PROCEDURE print_amount_in_words 
##############################################################################
PROCEDURE print_amount_in_words
begin
	print amtStr column 35
   if (amtlen1 >= amtlen)
	begin		
		nextLine
	end
	
end
##############################################################################
# PROCEDURE tprint_amount_in_words 
##############################################################################
PROCEDURE tprint_amount_in_words
begin
	print amtStr column 35
	if (amtlen1 >= amtlen)
	begin		
		nextLine
	end	
end

######################################################################
#  PROCEDURE BLOCK
######################################################################
PROCEDURE dep1Details
nextline
nextline
nextline
nextline 
nextline
nextline
nextline 
nextline
print "<font size='5'>"
print "CERTIFICAT DE DEPOT A TERME" column 25 
print "</font>"
nextline
nextline
nextline
print "La Société EQUITY BANQUE COMMERCIALE DU CONGO SA, Société Anonyme avec Conseil " column 1
nextline
print "d’Administration, au capital social en Francs Congolais de 8.248.511.900 ayant " column 1
nextline 
print "son siège social au n° 15, Boulevard du 30 Juin, commune de la Gombe, Kinshasa," column 1
nextline 
print "République Démocratique du Congo/Boite Postale 2798 Kinshasa 1 , immatriculée " column 1
nextline
print "au RCCM sous le numéro : CD/KIN/RCCM/14-B-3364, N° Impôt :A0703770G et à l’ID  " column 1
nextline
print "Nat: 01-K6500-N44216E, confirme par le présent certificat l’existence d’un dépôt" column 1
nextline
print "à terme avec les caractéristiques suivantes :  " column 1
nextline
nextline
print "Date d’ouverture                 :" column 1
set localdate = stringToDate  acct_open_date
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" 
nextline
nextline
print "Agence d’ouverture dépôt à terme :" column 1
print branchName 
nextline
nextline
print "Numéro de compte dépôt à terme   :" column 1
print accountNumber 
nextline
nextline
set tdAcctNum = accountNumber 
set callscript = runscript "ebDrpGet.scr" "tdAcctNum" "opAcctNum"
print "Numéro de compte principal       :" column 1
print opAcctNum 
nextline
nextline
print "Titulaire                        :" column 1
print accountName 
nextline
nextline
print "Montant principal                :" column 1
print deposit_amount  autocomma leftjustify size 17
print crncy_code
nextline
nextline
print "Montant en lettres               :" column 1
set amt_in_words = numTOWords deposit_amount
set Crncy_CodeX = crncy_code
set callscript = runscript "amttoWordsinFrench1.scr" "amt_in_words|Crncy_CodeX" "amt_in_french1"
set amt_in_french = amt_in_french1

set lv_var18="Franc congolais, "
set lv_var17="Euro, "
set lv_var16="Dollar americain, "

if crncy_code="USD"
begin
	set amt_in_french=strcat lv_var16 amt_in_french
end
if crncy_code="EUR"
begin
	set amt_in_french=strcat lv_var17 amt_in_french
end
if crncy_code="CDF"
begin
	set amt_in_french=strcat lv_var18 amt_in_french
end
set amtlen = strlen amt_in_french
set amtStr = splitstring amt_in_french 1 19
set amtlen1 = strlen amtStr  
execute tprint_amount_in_words
set amtlen1 = amtlen1 + 1
set amtStr = splitstring amt_in_french amtlen1 40
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
nextLine
	execute print_amount_in_words
end

set amtlen1 = amtlen1 + 1
set amtStr = splitstring amt_in_french amtlen1 40
set amtlen2 = strlen amtStr
set amtlen1 = amtlen1 + amtlen2
if (amtlen2 != 0)
begin
	nextLine
	execute print_amount_in_words
end
nextline
set DepYrs = years
##set DepMon = deposit_period_mths
set DepMon = months
set DepDays = deposit_period_days
set callscript = runscript "TDDurationtoWords.scr" "DepYrs|DepMon|DepDays" "Duration"
set Dur_in_french1 = strcat lv_var19 Duration
print "Durée de placement               :" column 1
print Dur_in_french1
nextline
nextline
print "Date d’échéance                  :" column 1
set localdate = stringToDate  maturity_date
set localdate = periodAdd localdate localyears Y
print localdate DateFormat ""  
nextline
nextline
print "Intérêt par an                   :" column 1
print interest_rate 
print "% " 
nextline
nextline
print "Renouvellement automatique       :" column 1
if auto_renewal_flg = "U"
begin
     print "Yes"
end
if auto_renewal_flg = "L"
begin
     print "Yes"
end
if auto_renewal_flg = "N"
begin
     print "No"
end
##print auto_renewal_flg
nextline
nextline
print "Montant à recevoir à l’échéance  :" column 1
print maturity_amount  autocomma leftjustify size 17
print crncy_code
nextline
nextline
nextline
#BrsolId	stringType
#BrCity		stringType
#set BrsolId = sol_id 
#set callscript = runscript "ebDrpGet.scr" "BrsolId" "BrCity"
print "Fait a " column 25
print br_city_desc 
print " ,le "
set localdate = stringToDate  acct_open_date
set localdate = periodAdd localdate localyears Y
print localdate DateFormat ""
nextline 
nextline
nextline
print "EQUITY BANQUE COMMERCIALE DU CONGO SA" column 23
nextline
nextline
nextline
#print "................." column 1 
#print "................." column 25 
nextline
print "SIGNATURE CLIENT" column 1
print "SIGNATURE AUTORISEE BANQUE" column 50
#print prtg_rmks column 3 size 70
nextline
nextline
if menu_parm = 'D'
	begin
 		set attribute = "DUPLICATE"
		print "**** "  column 19
		print attribute  column 24 size 50
		print "**** "  column 33
	end
#nextpage
###############################################################################
