# Template Name :		images.mrt
# Description	:		unverified images 
# Author			E.G.KAROBIA,27-05-2006
#Modified			James Irungu 22-08-2018  
#Modified			James Irungu 22-10-2019
#########################################################################
RECORDLAYOUT
SOL_ID		stringType
ACTIVITY		 stringtype
ACCTID	 stringtype
OCCUREDAT	stringType
USER_ID	       stringType

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 90
columnsperline 90
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId				stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 95 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print SOL_ID      column 5
	print ACTIVITY     column 13
	print ACCTID   column 28
	print OCCUREDAT	column 61
	print USER_ID	column 75
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "BRANCH "     COLUMN 2	
	print "OPERATION"   column 15
	print "IMAGE ACCTOUNT"   column 35
	print "AUDIT DATE" column  61
	print "USER_ID" column  75
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 90 center 
	nextline
	print branchName  size 90 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 90 center
	nextline
	print " UNVERIFIED IMAGES REPORT "  size 90 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 90 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 1
	print "|"   column 11
	print "|"   column 27
	print "|"   column 59
	print "|"   column 73
	print "|"   column 90


		
end