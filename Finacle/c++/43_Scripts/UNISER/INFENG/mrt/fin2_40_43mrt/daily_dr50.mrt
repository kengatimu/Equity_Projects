# Template Name :		daily_dr50.mrt
# Description	:		Interest/Provision Report
# Author			E.G.KAROBIA, 16/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr50.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number		        numberType
record_counter			numberType
date				stringType
lv_setid			stringType  
callscript			stringType
lv_setdesc			stringType
lv_userId			stringType 
tot_schm_code_cnt		numberType
tot_ostamt			numberType
tot_total_arreas		numberType	
tot_suspended_interest		numberType
tot_provision_interest		numberType
grnd_schm_code_cnt		numberType	
grnd_ostamt			numberType
grnd_total_arreas		numberType	
grnd_suspended_interest		numberType
grnd_provision_interest		numberType

#
GROUPANDSORT
sol_id ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 120
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
if total_arreas = 0 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF sol_id
    print "Branch : " 
    print " "
    print sol_id    
    nextline
    nextline
#
AFTERBREAKOF sol_id
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
	print schm_code			  column 3
	print ostamt			  column 18     format "#,###,###,###.##"
	print total_arreas		  column 38	format "#,###,###,###.##"
	Print suspended_interest	  column 61	format "#,###,###,###.##"
	print provision_interest	  column 83	format "#,###,###,###.##"

	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "Scheme code "        column 3
	print "O/s Amnt"             column 23
	print "Tot.Arrears "         column 45
	Print "Suspended Interest"   column 66
	print "Specific Prov."       column 87
		
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
	separatorline
        print "Grand Total" column 1
	set grnd_schm_code_cnt = totalcount schm_code
        set grnd_ostamt = totalsum ostamt
        set grnd_total_arreas = totalsum total_arreas
        set grnd_suspended_interest = totalsum suspended_interest
        set grnd_provision_interest = totalsum provision_interest
     
	print grnd_schm_code_cnt	  column 3
	print grnd_ostamt		  column 18     format "#,###,###,###.##"
	print grnd_total_arreas		  column 38	format "#,###,###,###.##"
	Print grnd_suspended_interest	  column 61	format "#,###,###,###.##"
	print grnd_provision_interest	  column 83	format "#,###,###,###.##"

	separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	separatorline
	print "Subtotal" column 1

	set tot_schm_code_cnt = totalcount schm_code
        set tot_ostamt = totalsum ostamt
        set tot_total_arreas = totalsum total_arreas
        set tot_suspended_interest = totalsum suspended_interest
        set tot_provision_interest = totalsum provision_interest

	print tot_schm_code_cnt	  column 3
	print tot_ostamt		  column 18     format "#,###,###,###.##"
	print tot_total_arreas		  column 38	format "#,###,###,###.##"
	Print tot_suspended_interest	  column 61	format "#,###,###,###.##"
	print tot_provision_interest	  column 83	format "#,###,###,###.##"

	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "INTEREST SUSPENCE / PROVISION-SUMMARY "  column 64
	nextline
	nextline
	print "AS AT :" column 64
	print "  "
	print date
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" column 50
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
