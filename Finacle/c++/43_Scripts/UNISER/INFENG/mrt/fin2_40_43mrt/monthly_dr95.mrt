# Template Name :		daily_dr95.mrt
# Description	:		Advances Summary by Branch 
# Author			E.G.KAROBIA, 13-04-2006
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
$$$include monthly_dr95.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
tdisb			numberType
tacnt			numberType
gdisb			numberType
gacnt			numberType

#
GROUPANDSORT sol_id

PAGEFORMAT
#
linesperpage 70
columnsperline 70
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipfrmdate			stringType
ipuserid			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter != 0)
 begin
 separatorline
 set tdisb = totalsum disbt	
 set tacnt = totalsum accounts	
 print "GRAND TOTAL" column 2
 print tdisb    column 31  format "##,###,###,###.##"
 print tacnt  column 51  
 separatorline
 end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 5
Print lv_userId
print "   " 
print today  
print "       Authorised Signatory"  column 35
nextline
nextline
nextline
nextline
print "********************End Of Report*********************" size 70 center

BEFOREBREAKOF sol_id
print " FOR BRANCH -> " column 2
print sol_id
nextline
#
AFTERBREAKOF sol_id
set gacnt = groupsum accounts
set gdisb = groupsum disbt
separatorline
print "Subtotal" column 2
print gdisb    column 31  format "##,###,###,###.##"
print gacnt  column 51  
separatorline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print SOL_ID  column 2 
	print SCHmCODE   column 11
	PRINT disbt    column 31  format "##,###,###,###.##"
	print ACCOUNTS column 51  
  nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "BRANCH"   column 2
	print "SCHM_CODE"   column 15
	PRINT "BALANCE"    column 31 
	print "# OF A/CS" column 55  
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 70 center 
	nextline
	print "ADVANCES SUMMARY BY BRANCH"  size 70 center
	nextline
	print "FOR BRANCH:" column 20
	print ipSetId
	nextline
	print "DATE :" column 20
	print "   "
	print ipFrmDate
#PRINT "   "
#	PRINT "TO  "
#	print iptodate
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 70 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 1
	print "|"   column 9
	PRINT "|"    column 29 
	print "|" column 49  
	print "|"  column 69
	
	
end


