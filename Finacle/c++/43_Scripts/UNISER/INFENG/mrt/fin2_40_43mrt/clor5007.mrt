###############################################################################
#	File Name: clor5007.mrt
#	Description: Template for Outward Clearing Waste
#	Developed By: Palit, 30-11-95
#	Modified By; Eric Karobia 8-11-2005 
###############################################################################
RECORDLAYOUT
$$$include clor5007.mri
###############################################################################
LOCALVARIABLES
###############################################################################
tot_instrumntid			numbertype
tot_instrumntamt		numbertype
record_counter                  numberType
lv_setid			stringType  
callscript			 stringType
lv_setdesc			stringType
lv_userId			stringType 


###############################################################################
GROUPANDSORT
###############################################################################
tran_id
set_num
acct_num
part_trn_srl_num
instrmnt_srl_num
###############################################################################
REPOSITORY bankRepos.rip
###############################################################################
bankName		stringType
branchName		stringType
###############################################################################
REPOSITORY argv4
###############################################################################
report_to		stringType
clg_zone_date		stringType
pg0_clg_zone_code	stringType
clg_zone_desc		stringType
extn_cntr_code_desc	stringType
page_number		numberType
set_id			stringType
set_id_desc		stringType
###############################################################################
PAGEFORMAT
###############################################################################
pageheaderlines  12
topMargin	  2
bottomMargin	  4
linesperpage	 64
columnsperline	152
###############################################################################
ONSTARTOFREPORT
###############################################################################
set tot_instrumntid = 0
set tot_instrumntamt = 0
execute firstpage
execute header_details
nextline
###############################################################################
ONENDOFREPORT
###############################################################################
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = set_id	
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
nextline
print "       Authorised Signatory (BRANCH)" column 20	
nextline
nextline
nextline
nextline
nextline
print "********************End Of Report*********************" size 152 center


###############################################################################
PAGEHEADER
###############################################################################
execute page_head
###############################################################################
#
#
#
IGNORERECORD
#
ONEVERYRECORD
set record_counter=record_counter+1
set tran_id =  ltrim tran_id " "
print tran_id column 1
#print part_trn_srl_num column 5 size 4
print acct_num column 10
print acct_name column 26
print tran_rmks column 46
#print part_tran_crncy_amt column 59 autocomma size 15
#print ocp_entry_user_id column 75
print instrmnt_srl_num  column 68 size 3 rightjustify precision 0
print tran_code  column 76 size 4 rightjustify
print instrmnt_id  column 79
print instrmnt_amt column 95 autocomma size 20
print bank_code  column 120  size 5
print br_name    column 126 size 17
print entry_user_id column 139 size 6
print vfd_user_id  column 146
#
###############################################################################
PROCEDURE page_head
#########################################################################
begin
	set page_number = page_number+1
	print "EQUITY BANK LIMITED" size 132 center
	print "PAGE NO." column 115
	print page_number column 125 precision 0
	nextline
	print branchName size 132 center
	print today column 115
	print "OUTWARD CLEARING REGISTER"  size 132 center
	nextline
	separatorline
end
############################################################################
PROCEDURE firstpage
############################################################################
begin
	set page_number = page_number+1
	print "EQUITY BANK LIMITED" size 152 center
	print "PAGE NO. " column 130
	print page_number 
	nextline
	print branchName size 152 center
	print today column 130
	print "OUTWARD CLEARING REGISTER"  size 152 center
	nextline
	print "ZONE CODE/DATE : "  column 62
	print pg0_clg_zone_code
	print " "
	print "/"
	print clg_zone_date size 10
	print " "
	nextline
	nextline
	nextline
end
##############################################################################
PROCEDURE header_details
##############################################################################
begin
separatorline
print "TRAN ID :" column 1
print "ACCOUNT NO"  column 11
print "ACCOUNT NAME" column 30
print "TRAN RMKS" column 50
#print "AMOUNT"    column 68
#print "LAST"       column 76
print "INST"     column 68
print "TRAN"   column 76
print "INSTR."  column 83
print "INSTRUMENT"  column 104
print "DRAWEE BANK / BRANCH"  column 115
print "LAST"   column 140 size 6
print "SET"    column 147
nextline
#print "MOD BY"  column 76
print "SL.NO."  column 68
print "CODE"    column 76
print "NUMBER"  column 83
print "AMOUNT"  column 105
print "MOD BY"  column 140
print "VFD BY"  column 147
separatorline
end
#
##############################################################################
PROCEDURE  printGrandTotals
##############################################################################
begin
set tot_instrumntid = totalcount instrmnt_id
set tot_instrumntamt = totalsum instrmnt_amt
 nextline
 print "TOTALS FOR DATA CENTER"
 nextline
 separatorline
 print "TOTAL INSTRUMENT AMOUNT:  " column 1
 print tot_instrumntamt 
 print "   TOTAL #INSTRUMENTS:  " column 40
 print tot_instrumntid 
 nextline
 separatorline
 end
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 152 center 
nextline
nextline
nextline
nextline
nextline
nextline
end
