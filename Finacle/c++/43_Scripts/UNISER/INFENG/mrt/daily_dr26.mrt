#*********************************************************************
#       Author          :     Robert Oduor 
#
#**********************************************************************
#  DESC   : Loan Balances By Slabs Report  
#            
######################################################################
RECORDLAYOUT
####################################################################
####################################################################
solid                 stringType
Amount_Disb1          numbertype
Amount_Disb2          numbertype 
Amount_Disb3          numbertype 
Amount_Disb4          numbertype 
Amount_Disb5          numbertype
Amount_Disb6          numbertype
Tot_Amont_Disb        numbertype 
Bal_Outstanding1      numbertype	
Bal_Outstanding2      numbertype 
Bal_Outstanding3      numbertype 
Bal_Outstanding4      numbertype 
Bal_Outstanding5      numbertype
Bal_Outstanding6      numbertype
Tot_Bal_Outstanding   numbertype

LOCALVARIABLES
####################################################################
####################################################################
Grandtot 	numberType
balout		numberType
page_number     numberType
lv_setid	stringType  
callscript      stringType
lv_setdesc	stringType
lv_userId	stringType 
GROUPANDSORT
############################################################################
#   RECORDLAYOUT section.
#################################################################### 
#
#
REPOSITORY argv4  
ipSetId				stringType
ipFrmDate			stringType

#############################################################################
#MASSAGERECORD
#############################################################################
#############################################################################
#IGNORERECORD
#############################################################################
#############################################################################
#----------------------------------------------------------------------------
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperpage     70
pageheaderlines      5 
pagefooterlines       2 
topmargin       1
bottommargin   1
leftmargin       2 
rightmargin     2 
columnsperline  100 

ONSTARTOFREPORT
####################################################################  
execute brBankHdg 
execute pageHdg 
#
PAGEHEADER
####################################################################
#pageheader on each page
####################################################################
execute pageHdg 
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
#
ONEVERYRECORD 
####################################################################
#-------------------------------------------------------------------
####################################################################
set Grandtot = Grandtot + Amount_Disb1 + Amount_Disb2 + Amount_Disb3 + Amount_Disb4 + Amount_Disb5  + Amount_Disb6  
set balout = balout + Bal_Outstanding1 + Bal_Outstanding2 + Bal_Outstanding3 + Bal_Outstanding4 + Bal_Outstanding5 + Bal_Outstanding6
print solid         column 2
print "0-100,000"   column  10 
print Amount_Disb1     column   33   format "###,###,###.##" 
print Bal_Outstanding1    column   54  format "###,###,###.##" 
nextline
print "100,000-500,000"   column 10 
print Amount_Disb2     column  33  format "###,###,###.##" 
print Bal_Outstanding2  column   54 format "###,###,###.##"  
nextline
print "500,000-1,000,000" column  10 
print Amount_Disb3    column   33  format "###,###,###.##" 
print Bal_Outstanding3  column   54 format "###,###,###.##"  
nextline
print "1,000,000-5,000,000" column  10 
print Amount_Disb4    column   33   format "###,###,###.##" 
print Bal_Outstanding4  column  54  format "###,###,###.##"  
nextline
print"5,000,000-10,000,000" column  10 
print Amount_Disb5      column   33  format "###,###,###.##" 
print Bal_Outstanding5    column 54 format "###,###,###.##" 
nextline
print "10,000,000.01 over"  column   10 
print Amount_Disb6       column    33  format "###,###,###.##" 
print Bal_Outstanding6  column  54  format "###,###,###.##"  
#----------------------------------------------------------------
#BEFOREBREAKOF 
#
#AFTERBREAKOF 
#separatorline
####################################################################
# After break 
####################################################################
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
separatorline
print "Grand total" column 5
print Grandtot column 35 format "###,###,###.##" 
print balout column 58  format "###,###,###.##" 
separatorline
nextline
nextline
print "Printed by:....." column  65 
print " "
print lv_userId
nextline
nextline
print "System......................"   column  65 
nextline
nextline
print "Time:..............." column 65 
#
#############################################################################
#
#############################################################################
#
procedure pageHdg
########################################################################

begin
 separatorline
 print "Branch" column 2 
 print "Slabs"   column 10 
 print "Amount Disbursed" column 37 
 print "Bal OUTSTANDING" column 57 size 20 center 
 separatorline
end

procedure brBankHdg 
begin
        print "Page No. "   column 75
        print page_number precision 0
        nextline
        print today column 75 
        nextline
        nextline
	print "            EQUITY BANK LIMITED" column 25
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc column 40
	nextline
	print "        LOAN BALANCES BY SLABS REPORT " COLUMN 25
        set page_number= page_number+1
	nextline
end
#PROCEDURE pipe 
##############################################################################
####################################################################
# End of File
######################################################################
