#********************************************************************************
#    Report Name                        :       cbk_exm21.mrt                   *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    GENERAL REPORT DESCRIPTION                                                 *
#    --------------------------                                                 *
#     DEPOSITS FROM INSTITUTIONS                                                *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#    MODIFICATION LOG                                                           *
#    ----------------                                                           *
#                                                                               *
#    Sr.no.  Date           Author                 Description                  *
#    ------  --------       ------------           -----------                  *
#    1.0     25-07-2005     P.Senthil kumar        Original Version             *
#                                                                               *
#################################################################################
#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
recnum                  stringType
sol_id			stringType	
acno			stringType
Acctname                stringType
depamt                  numberType
accint                  numberType
opendate                stringType
matdate                 stringType
period_m                numberType
period_d                numberType
intrate                 numberType
sector			stringType
sub_sector		stringType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
callscript     	        stringType
lv_setid      	        stringType
lv_setdesc     	        stringType
principal               numberType
totint                  numberType
total                   numberType
grandtot                numberType
period                  numberType
amountinTho             numberType
amountinTho1            numberType
amountinTho2            numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
alreadysorted
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg
set principal = 0
set totint = 0
set total = 0
set grandtot = 0
set intrate = 0
set period = 0
set amountinTho = 0
set amountinTho1 = 0
set amountinTho2 = 0
#***************************************************************************************
IGNORERECORD
#***********************************************************************************
#if (ref_desc = "CENTRAL GOVERNMENT")
#if (ref_desc = "LOCAL GOVERNMENT")
#*************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   55
columnsperline 190
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines  5 
pagefooterlines 4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
#execute header
execute pageHdg
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
set amountinTho = (depamt / 1000)
set principal = principal + amountinTho
set amountinTho1 = (accint / 1000)
set totint = totint + amountinTho1
set total = amountinTho + amountinTho1
set grandtot = grandtot + total
begin
execute pipe
print   sol_id          column 2        size   4
print   recnum          column  9       size   10 
print   acno 		column  24      size   16 
print   Acctname        column  42      size    25
print   amountinTho     column  69      size    18 
print   amountinTho1    column  91      size    12  precision 0
print   total           column  107     size    17  precision 0 
print   opendate        column 129      size    10
print   matdate         column 141      size    10
print   period_m        column 153      size    3
print "/" column 156 size 1
print   period_d        column 158      size    3
print   intrate         column 165      size    5
end
#**************************************************************************************
ONENDOFREPORT
#**************************************************************************************
begin
#execute Line
separatorline
execute pipe
print "Total :" column 5
print principal  precision 0 column 69 size 20
print totint  precision 0 column 91 size 14
print grandtot precision 0 column 107 size 20
nextline
separatorline
nextline
nextline
print "*DEPOSITS FROM BANKS,FINANCIAL INSTITUTIONS,BUILDING SOCIETIES" column 5
nextline
print " AND MORTGAGE FINANCE COMPANIES" column 5
nextline
#print "CBK/BSD/EXM/21. Highlight or list Separately the dormant accounts" column 5
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:_______________________________________" column 20
nextline
end
#**************************************************************************************
#***************************************************************************************

PROCEDURE pipe

begin
        print "|"               column 1
        print "|"               column 7
        print "|"               column 22
        print "|"               column 40 
        print "|"               column 67 
        print "|"               column 89 
        print "|"               column 105 
        print "|"               column 127
        print "|"               column 140
        print "|"               column 152
        print "|"               column 164
	print "|" 		column 176
	print "|"		column 190
end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
print "EXM21" column 165
nextline
print "INSTITUTION:  EQUITY BANK LIMITED " column 5
print "DATE:" column 165
print asondate column 170
nextline
nextline
print " BRANCH    :"  column 5
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc size 20
print "(shs '000)" column 166
nextline
nextline
print "DEPOSITS FROM INSTITUTIONS" size 105 center
nextline
print "__________________________" size 105 center
nextline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
separatorline
print "|" column 1
print "SOL" column 2
print "|" column 7
print "FDR NO." column 9 
print "|" column 22
print "A/C NO" column 23
print "|" column 40
print "INSTITUTIONS" column 41  center size 25
print "|" column 67 
print "PRINCIPAL" column 68 size 20 center
print "|" column 89 
print "ACCRUED" column  90 center size 14
print "|" column 105
print "TOTAL" column 106 center size 20
print "|" column 127 
print "DATE OF" column 128
print "|" column 140
print  "DATE OF" column 141
print "|" column 152
print "TERM" column 153
print "|" column 164
print "RATE OF" column 165
print "|" column 176
print "Remarks" column 178
print "|" column 190
nextline
print "|" column 1
print "|" column 7  
print "|" column 22
print "|" column 40
print "|" column 67
print "|" column 89 
print "INTEREST" column 90 center size 14
print "|" column 105 
print "|" column 127
print "PLACEMENT" column 128
print "|" column 140
print "MATURITY" column 141
print "|" column 152
print "|" column 164
print "INTEREST" column 165
print "|" column 176
print "|" column 190
nextline
separatorline
end
#****************************************************************************************


