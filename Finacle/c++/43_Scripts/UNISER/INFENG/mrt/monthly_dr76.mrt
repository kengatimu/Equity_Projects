#	DESC	:    Savings Interest Accrued For Every Month 
#	                    in The Current Year
###################################################################
recordlayout
###################################################################
#  
####################################################################
sol_id					stringtype
SCHM_CODE				stringtype
ACCT_NUM				numbertype
ACCT_NAME				stringtype
jan_tot_accrued_bal			numbertype
feb_tot_accrued_bal			numbertype
mar_tot_accrued_bal			numbertype
apr_tot_accrued_bal			numbertype
may_tot_accrued_bal			numbertype
jun_tot_accrued_bal			numbertype
jul_tot_accrued_bal			numbertype
aug_tot_accrued_bal			numbertype
sep_tot_accrued_bal			numbertype
oct_tot_accrued_bal			numbertype
nov_tot_accrued_bal			numbertype
dec_tot_accrued_bal			numbertype

localvariables
#####################################################################
#localvariables are defined here
#####################################################################
jan_tot		numbertype
feb_tot		numbertype
mar_tot		numbertype
apr_tot		numbertype
may_tot		numbertype
jun_tot		numbertype
jul_tot		numbertype
aug_tot		numbertype
sep_tot		numbertype
oct_tot		numbertype
nov_tot		numbertype
dec_tot		numbertype	
g_jan_tot		numbertype
g_feb_tot		numbertype
g_mar_tot		numbertype
g_apr_tot		numbertype
g_may_tot		numbertype
g_jun_tot		numbertype
g_jul_tot		numbertype
g_aug_tot		numbertype
g_sep_tot		numbertype
g_oct_tot		numbertype
g_nov_tot		numbertype
g_dec_tot		numbertype	
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType 
groupandsort
###########################################################################
###########################################################################
SOL_ID		ascending	
SCHM_CODE	ascending
ACCT_NUM	ascending

repository bankRepos.rip  
############################################################################
bankname	stringtype
branchName      stringtype

REPOSITORY  argv4
#############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################

PAGEFORMAT
##############################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
##############################################################################

linesperPage   65
columnsperline 160 
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13
pagefooterlines 4

onstartofreport
##############################################################################
execute brBankHdg 
execute pageHdg

pageheader
#####################################################################
execute brBankHdg 
execute pageHdg
#
PAGEFOOTER
######################################################################
separatorline
#
######################################################################
oneveryrecord
######################################################################

print ACCT_NUM 				column 3 
print ACCT_NAME	size 22			column 17
print jan_tot_accrued_bal		column 40
print feb_tot_accrued_bal		column 50
print mar_tot_accrued_bal		column 60
print apr_tot_accrued_bal		column 70
print may_tot_accrued_bal		column 80
print jun_tot_accrued_bal		column 90
print jul_tot_accrued_bal		column 100
print aug_tot_accrued_bal		column 110
print sep_tot_accrued_bal		column 120
print oct_tot_accrued_bal		column 130
print nov_tot_accrued_bal		column 140
print dec_tot_accrued_bal		column 150

#######################################################################
#afterbreakof
#######################################################################
afterbreakof sol_id
print "SOL totals:" column 3
set jan_tot = groupsum jan_tot_accrued_bal		
set feb_tot = groupsum feb_tot_accrued_bal			
set mar_tot = groupsum mar_tot_accrued_bal			
set apr_tot = groupsum apr_tot_accrued_bal		
set may_tot = groupsum may_tot_accrued_bal	
set jun_tot = groupsum jun_tot_accrued_bal			
set jul_tot = groupsum jul_tot_accrued_bal			
set aug_tot = groupsum aug_tot_accrued_bal		
set sep_tot = groupsum sep_tot_accrued_bal		
set oct_tot = groupsum oct_tot_accrued_bal		
set nov_tot = groupsum nov_tot_accrued_bal	
set dec_tot = groupsum dec_tot_accrued_bal		
print jan_tot		column 40
print feb_tot		column 50
print mar_tot		column 60
print apr_tot		column 70
print may_tot		column 80
print jun_tot		column 90
print jul_tot		column 100
print aug_tot		column 110
print sep_tot		column 120
print oct_tot		column 130
print nov_tot		column 140
print dec_tot		column 150
separatorline

#########################################################################
beforebreakof sol_id
print sol_id
#########################################################################
afterbreakof SCHM_CODE
print SCHM_CODE column 17

print "Total interest for" column 3
print SCHM_CODE column 22
nextline
#########################################################################
#
#############################################################################
onendofreport
#############################################################################
begin
      set g_jan_tot = totalsum jan_tot_accrued_bal
      set g_feb_tot =   feb_tot_accrued_bal
      set g_mar_tot = mar_tot_accrued_bal
      set g_apr_tot =   apr_tot_accrued_bal
      set g_may_tot = may_tot_accrued_bal
      set g_jun_tot = jun_tot_accrued_bal
      set g_jul_tot = jul_tot_accrued_bal
      set g_aug_tot = aug_tot_accrued_bal
      set g_sep_tot = sep_tot_accrued_bal
      set g_oct_tot = oct_tot_accrued_bal
      set g_nov_tot = nov_tot_accrued_bal
      set g_dec_tot = dec_tot_accrued_bal

	separatorline
      print "Grand Totals" column 3
      print g_jan_tot           column 40
      print g_feb_tot           column 50
      print g_mar_tot           column 60
      print g_apr_tot           column 70
      print g_may_tot           column 80
      print g_jun_tot           column 90
      print g_jul_tot           column 100
      print g_aug_tot           column 110
      print g_sep_tot           column 120
      print g_oct_tot           column 130
      print g_nov_tot           column 140
      print g_dec_tot           column 150
      	separatorline
end


begin
     nextline
     nextline
     print "printed by:"  size  50 center 
     print  lv_userId
     nextline
     nextline
     nextline
     print "verified by:" size 50 center 
     print "............." column 50 
     nextline
     nextline
     nextline
     print "***************END OF REPORT******************" size 160 center 
 end
##############################################################################

Procedure  pageHdg
##############################################################################
begin
      nextline
      print "SAVINGS INTEREST ACCRUED REPORT"  size  160 center 
      nextline
      nextline
      print "YEAR:   " column 65
      print ipFrmDate 
      print "  SCHEME CODE:   "
      print ipToDate
      nextline
      nextline
end

begin
     separatorline
     print "ACCT_NUM" column 3
     print "ACCT_NAME" column 17
     print "Jan" column 40
     print "Feb" column 50
     print "Mar" column 60
     print "Apr" column 70
     print "May" column 80
     print "Jun" column 90
     print "Jul" column 100
     print "Aug" column 110
     print "Sep" column 120
     print "Oct" column 130
     print "Nov" column 140
     print "Dec" column 150
     separatorline
     nextline
end

PROCEDURE brBankHdg
############################################################################

begin
     print "Page No. "   column  100 
     print page_number precision 0
     nextline
     print today column   100 
     nextline
     nextline
     print " EQUITY BANK LIMITED"  size  160 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 160 center 
     nextline

end

####################################################################
# End of File
