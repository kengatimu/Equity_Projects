set head off
set verify off
set feed off
set term off
set pages 0
set linesize 250
set trims on
set maxdata 60000
set serveroutput on size 1000000
spool unzerocashgls.lst
select (concat((concat(gam.sol_id||' ',(select ' Emp:'||EMP_ID||' ' from tbaadm.gec  gc where bank_id='43' and del_flg='N' and gc.EMP_CASH_ACCT=gam.bacid and gam.acct_crncy_code=gc.CRNCY_CODE and gam.SOL_ID=gc.sol_id and gam.bank_id=gc.bank_id))),
(concat(gam.sol_id,(select ' Name:'||EMP_NAME from tbaadm.get where emp_id in (select EMP_ID from tbaadm.gec  gc where bank_id='43' and del_flg='N' 
and gc.EMP_CASH_ACCT=gam.bacid and gam.acct_crncy_code=gc.CRNCY_CODE and gam.SOL_ID=gc.sol_id and gam.bank_id=gc.bank_id))) )) ) 
||'|'||gam.FORACID||'|'||substr(gam.ACCT_NAME,1,30)||'|'||clr_bal_amt from TBAADM.gam
where sol_id  = '&1'
AND GAM.del_flg!='Y' 
AND GAM.entity_cre_flg = 'Y' 
AND GAM.bank_id = '&2'
and GAM.acct_cls_flg='N' 
--and GAM.schm_code  in ( 'OTHBC','CASBC','CASH') and (bacid  like '%TELLER%' or bacid    like '%INTRADAY%')
and GAM.schm_code  in ('OTHER','OTHBC','CASBC','CASH') and ((bacid  like '%TELLER%' or bacid    like '%INTRADAY%') and  bacid  not like 'ATMTELLER%' )  
and GAM.bacid not  like '%ATM%' and foracid not in ('15055107010375','15055107020261','15055107020271','15055107020042','15055107020043') and clr_bal_amt<>0 ;

spool off;
exit;
