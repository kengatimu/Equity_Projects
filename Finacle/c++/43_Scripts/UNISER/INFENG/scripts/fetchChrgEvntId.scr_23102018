<--START
CHECKSUM="a3b9a62a38fbaf90807d9608423993ff7cc80ebec2cb0a48f2dbea5106d65a7a"
	# Script body goes here
	TRACE ON
	IF (REPEXISTS("EQT") == 0) THEN
	#{
		CREATEREP("EQT")
	#}
	ENDIF
	
	IF (CLASSEXISTS("EQT","TRAN") == 0) THEN
	#{
		CREATECLASS("EQT","TRAN",5)
	#}
	ENDIF
	
	EQT.TRAN.errorFlg = "N"
	EQT.TRAN.errorMsg = " "
	EQT.TRAN.chrgEvntId = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.acctId))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctId) != "")THEN
		#{
			EQT.TRAN.acctId = TOUPPER(BANCS.INPUT.acctId)
			PRINT(EQT.TRAN.acctId)
			#}
		ELSE
			#{
			EQT.TRAN.errorFlg ="Y"
			EQT.TRAN.errorMsg ="Account Id not passed!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		EQT.TRAN.errorFlg ="Y"
		EQT.TRAN.errorMsg ="Account Id not passed!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------#
	#          Checking Ownership of Account         #
	#------------------------------------------------#
	
	sv_s = "owner|select acct_ownership from tbaadm.gam where foracid=?SVAR and bank_id= ?SVAR"
	
	BANCS.INPARAM.BINDVARS = EQT.TRAN.acctId + "|" +  BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.owner)
		EQT.TRAN.owner = BANCS.OUTPARAM.owner
		
		IF(TRIM(EQT.TRAN.owner)=="")THEN
		#{
			EQT.TRAN.errorFlg = "Y"
			EQT.TRAN.errorMsg = "Unable to Fetch Account Details!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(EQT.TRAN.owner!="C")THEN
		#{
			EQT.TRAN.errorFlg = "Y"
			EQT.TRAN.errorMsg = "Not a Customer Account!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#}
	ELSE
		#{
		EQT.TRAN.errorFlg = "Y"
		EQT.TRAN.errorMsg = "Unable to Fetch Account Details!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------#
	#          Fetching Event ID from CPARAM         #
	#------------------------------------------------#
	
	BANCS.INPUT.moduleName = "OT"
	BANCS.INPUT.parameterId = "XFER_CHRG_EVNT_ID"
	
	sv_g = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER WHERE "
	sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
	sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
	sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
	sv_g = sv_g + " C_CPVALUE.del_flg != 'Y' AND "
	sv_g = sv_g + " C_CPVALUE.entity_cre_flg = 'Y' AND "
	sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
	sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
	sv_g = sv_g + " C_CPVALUE.parameter_id = ?SVAR"
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.moduleName + "|" + BANCS.INPUT.parameterId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_g)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.parameterVal)
		
		IF(TRIM(BANCS.OUTPARAM.parameterVal)=="")THEN
		#{
			EQT.TRAN.errorFlg = "Y"
			EQT.TRAN.errorMsg = "Event Id for Charge Collection is not maintained in CPARAM!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		EQT.TRAN.errorFlg = "Y"
		EQT.TRAN.errorMsg = "Event Id for Charge Collection is not maintained in CPARAM!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	EQT.TRAN.chrgEvntId = BANCS.OUTPARAM.parameterVal
	
	#------------------------------------------------#
	#        	  Validating Event ID                #
	#------------------------------------------------#
	
	sv_s = "count|SELECT count(*) FROM tbaadm.PTT where ENTITY_CRE_FLG ='Y' and del_flg='N' "
	sv_s = sv_s + " and  event_type ='TRANF' and event_id =?SVAR and  bank_id= ?SVAR "
	
	BANCS.INPARAM.BINDVARS = EQT.TRAN.chrgEvntId + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.count)
		IF(BANCS.OUTPARAM.count == "0")THEN
		#{
			EQT.TRAN.errorFlg = "Y"
			EQT.TRAN.errorMsg = "Invalid Event Id: "+EQT.TRAN.chrgEvntId+" for Charge Collection!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		EQT.TRAN.errorFlg = "Y"
		EQT.TRAN.errorMsg = "Invalid Event Id: "+EQT.TRAN.chrgEvntId+" for Charge Collection!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		print(EQT.TRAN.errorMsg)
		sv_u = urhk_SetOrbOut("errorFlg|"+EQT.TRAN.errorFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("message|"+EQT.TRAN.errorMsg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("chrgEventId|"+EQT.TRAN.chrgEvntId)
		PRINT(sv_u)
		
		DELETECLASS("EQT","TRAN")
		DELETEREP("EQT")
END-->

