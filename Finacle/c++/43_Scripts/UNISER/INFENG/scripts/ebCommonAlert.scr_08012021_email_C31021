<--start
trace on
#Rep/Class
        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(classexists("CUST","ALERTS")==0)then
                createclass("CUST","ALERTS",5)
        endif
	EBSRV.GLBDATA.isLienYN = ""
        EBSRV.GLBDATA.comfil = ""
        EBSRV.GLBDATA.toAddr = ""
        EBSRV.GLBDATA.PartyName = "NA"
        EBSRV.GLBDATA.PartyLname = "NA"
        EBSRV.GLBDATA.PartyAcct = ""
        EBSRV.GLBDATA.tranparti = "NA"
	EBSRV.GLBDATA.mlYN = ""
	EBSRV.GLBDATA.drMYN = ""
	EBSRV.GLBDATA.crMYN = "" 
	EBSRV.GLBDATA.drMLt = 0 
	EBSRV.GLBDATA.crMLt = 0 
	EBSRV.GLBDATA.alMail = ""
	if(fieldexists(CUST.ALERTS.AlertModule)==1)then
		if(CUST.ALERTS.AlertModule=="GEN")then
			if(CUST.ALERTS.tranParticular == "")then
				CUST.ALERTS.tranParticular = "NA"	
			endif
			sv_d = "tranParticular,tranRemarks| "
			sv_d = sv_d + " select replace(?SVAR,' ', '-'),replace(?SVAR,' ', '-') "
			sv_d = sv_d + " from dual "  
			print(sv_d)
			if(CUST.ALERTS.tranRemarks!="")then
				BANCS.INPARAM.BINDVARS = CUST.ALERTS.tranParticular + "|" + CUST.ALERTS.tranRemarks  
			else
				BANCS.INPARAM.BINDVARS = CUST.ALERTS.tranParticular + "|NA"
			endif
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EBSRV.GLBDATA.tranparti = BANCS.OUTPARAM.tranParticular
				EBSRV.GLBDATA.tranRemarks = BANCS.OUTPARAM.tranRemarks
			else
				EBSRV.GLBDATA.tranparti = "NA"
				EBSRV.GLBDATA.tranRemarks = "NA"
			endif
		endif
	else
		CUST.ALERTS.AlertModule =""
	endif
	sv_u = urhk_getAcctDetailsInRepository(CUST.ALERTS.AcctNum)
	if(sv_u==0)then
		EBSRV.GLBDATA.CifId = BANCS.OUTPARAM.cifId
		EBSRV.GLBDATA.solid = BANCS.OUTPARAM.acctSolId
		EBSRV.GLBDATA.ActBal = BANCS.OUTPARAM.EffAvailableAmt
		EBSRV.GLBDATA.ActCrncy = BANCS.OUTPARAM.acctCrncyCode
		EBSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
	else
		EBSRV.GLBDATA.CifId = ""
		EBSRV.GLBDATA.solid = ""
		EBSRV.GLBDATA.ActBal = ""
		EBSRV.GLBDATA.ActCrncy =""
		EBSRV.GLBDATA.schmCode = ""
	endif
	if(CUST.ALERTS.AlertModule=="GEN")then
		sv_s = "drMYN,drMLt,crMYN,crMLt,alMail,mobNo,SmsAlert|" 
		sv_s = sv_s + " select dr_alert_flg,dr_min_amount,cr_alert_flg,cr_min_amount,email_address, mobile_no,activation_status "
		sv_s = sv_s + " from custom.cust_alerts_tbl where bank_id=?SVAR "
		sv_s = sv_s + " and del_flg<>'Y' and entity_cre_flg='Y' and foracid=?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.AcctNum 
		print(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u==0)then
			EBSRV.GLBDATA.drMYN = BANCS.OUTPARAM.drMYN
			EBSRV.GLBDATA.crMYN = BANCS.OUTPARAM.crMYN
			EBSRV.GLBDATA.drMLt = BANCS.OUTPARAM.drMLt
			EBSRV.GLBDATA.crMLt = BANCS.OUTPARAM.crMLt
			EBSRV.GLBDATA.alMail = BANCS.OUTPARAM.alMail
			EBSRV.GLBDATA.mobNo = BANCS.OUTPARAM.mobNo
			EBSRV.GLBDATA.SmsAlert = BANCS.OUTPARAM.SmsAlert

		else
			EBSRV.GLBDATA.drMYN = "" 
			EBSRV.GLBDATA.crMYN = "" 
			EBSRV.GLBDATA.drMLt = "" 
			EBSRV.GLBDATA.crMLt = "" 
			EBSRV.GLBDATA.alMail = "" 
			EBSRV.GLBDATA.mobNo = ""
			EBSRV.GLBDATA.SmsAlert = ""
		endif
		sv_d = "idO,idT| select substr(?SVAR,1,4),lpad(substr(?SVAR,-4),10,'X') from dual "
		BANCS.INPARAM.BINDVARS = CUST.ALERTS.AcctNum +"|"+CUST.ALERTS.AcctNum
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			EBSRV.GLBDATA.idO = BANCS.OUTPARAM.idO
			EBSRV.GLBDATA.idT = BANCS.OUTPARAM.idT
			EBSRV.GLBDATA.foracid = EBSRV.GLBDATA.idO +""+EBSRV.GLBDATA.idT
			print(EBSRV.GLBDATA.foracid)
		endif
		if((CUST.ALERTS.partTranType=="C") and (EBSRV.GLBDATA.crMYN!="Y"))then
			goto VAYU 
		endif
		print(CUST.ALERTS.partTranType)
		print(EBSRV.GLBDATA.crMYN)
		print(CUST.ALERTS.TranAmt)
		print(EBSRV.GLBDATA.crMLt)
		if((CUST.ALERTS.partTranType=="C") and (EBSRV.GLBDATA.crMYN=="Y") and (cdouble(EBSRV.GLBDATA.crMLt)<= cdouble(CUST.ALERTS.TranAmt)))then
			EBSRV.GLBDATA.mlYN = "Y" 
			EBSRV.GLBDATA.isLienYN = "N"
		endif
		if((CUST.ALERTS.partTranType=="D") and (EBSRV.GLBDATA.drMYN!="Y"))then
			goto VAYU 
		endif
		print(CUST.ALERTS.partTranType)
		print(EBSRV.GLBDATA.drMYN)
		print(CUST.ALERTS.TranAmt)
		print(EBSRV.GLBDATA.drMLt)
		if((CUST.ALERTS.partTranType=="D") and (EBSRV.GLBDATA.drMYN=="Y") and (cdouble(EBSRV.GLBDATA.drMLt)<= cdouble(CUST.ALERTS.TranAmt)))then
			EBSRV.GLBDATA.mlYN = "Y" 
			EBSRV.GLBDATA.isLienYN = "N"
		endif
	else
		EBSRV.GLBDATA.foracid = CUST.ALERTS.AcctNum 
		EBSRV.GLBDATA.mlYN = "Y"
		EBSRV.GLBDATA.isLienYN = "Y"
	endif
	print(EBSRV.GLBDATA.mlYN)
	if((EBSRV.GLBDATA.foracid!="") and (EBSRV.GLBDATA.mlYN=="Y"))then
	##{
		sv_s = "PartyName,PartyLname,PartySal | select (case when instrc(nvl(cust_short_name,cust_first_name),' ',1,1) >0 "
		sv_s = sv_s + " then substr(nvl(cust_short_name,cust_first_name),1,instrc(nvl(cust_short_name,cust_first_name),' ',1,1)) "
		sv_s = sv_s + " else cust_short_name end) as firstName, "
		sv_s = sv_s + " (case when instrc(nvl(cust_last_name,cust_last_name),' ',1,1) >0 "
		sv_s = sv_s + " then substr(nvl(cust_last_name,cust_last_name),1,instrc(nvl(cust_last_name,cust_last_name),' ',1,1)) "
		sv_s = sv_s + " else cust_last_name end) as lastName,nvl(cust_title_code,'Mr/Mrs') "
		sv_s = sv_s + " from tbaadm.cmg where cif_id =?SVAR "
		sv_s = sv_s + " and bank_id=?SVAR "
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.CifId + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u == 0)then
				EBSRV.GLBDATA.PartyName    = BANCS.OUTPARAM.PartyName
				EBSRV.GLBDATA.PartyLname     = BANCS.OUTPARAM.PartyLname
				EBSRV.GLBDATA.PartySal     = BANCS.OUTPARAM.PartySal
		else
				EBSRV.GLBDATA.PartyName    = "NA"
				EBSRV.GLBDATA.PartyLname     = "NA"
				EBSRV.GLBDATA.PartySal = "NA"
		endif
		if(EBSRV.GLBDATA.PartyName == EBSRV.GLBDATA.PartyLname)then
			EBSRV.GLBDATA.PartyName = EBSRV.GLBDATA.PartyName
			EBSRV.GLBDATA.PartyLname = "NA"
		endif
		sv_s = " toAddr |select email from tbaadm.cemail where email_b2kid =?SVAR "
		sv_s = sv_s + " and preferredflag='Y' "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.CifId
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u==0)then
		       EBSRV.GLBDATA.toAddr = BANCS.OUTPARAM.toAddr
		else
		       EBSRV.GLBDATA.toAddr = "NA"
		endif
		#---------SMS start Edwin
		if (BANCS.STDIN.contextBankId =="43") then
		if (EBSRV.GLBDATA.SmsAlert =="Y") then
			if ((EBSRV.GLBDATA.schmCode =="CA700") or (EBSRV.GLBDATA.schmCode =="CA705") or (EBSRV.GLBDATA.schmCode =="CA706") or (EBSRV.GLBDATA.schmCode =="CA790") or (EBSRV.GLBDATA.schmCode =="SB700") or (EBSRV.GLBDATA.schmCode =="SB722") or (EBSRV.GLBDATA.schmCode =="SB704")) then

				print(EBSRV.GLBDATA.mobNo)
				CUST.ALERTS.TranAmt = trim(CUST.ALERTS.TranAmt)
				print(CUST.ALERTS.TranAmt)
				EBSRV.GLBDATA.ActBal = trim(EBSRV.GLBDATA.ActBal)
				print(EBSRV.GLBDATA.ActBal)
				print(BANCS.STDIN.sysDate)
				CUST.ALERTS.Date = Mid$(BANCS.STDIN.sysDate,0,10)	
				print(CUST.ALERTS.Date)
				CUST.ALERTS.Time = Mid$(BANCS.STDIN.sysDate,11,19)
				print(CUST.ALERTS.Time)
                                sv_u = "drcTime | SELECT TO_CHAR(SYSDATE-2/24, 'HH24:MI:SS') FROM  dual"
                                sv_d = urhk_dbSelectWithBind(sv_u)
                                if(sv_d==0)then
                                        CUST.ALERTS.Time = BANCS.OUTPARAM.drcTime
                                endif
				if (CUST.ALERTS.partTranType =="C") then
					CUST.ALERTS.partTranType = "CREDITE"
				else
					CUST.ALERTS.partTranType = "DEBITE"
				endif

				if (EBSRV.GLBDATA.mobNo != "") then			
					EBSRV.GLBDATA.SmsVal = "LE " + CUST.ALERTS.Date + " A " + CUST.ALERTS.Time + ", VOTRE COMPTE BCDC " + EBSRV.GLBDATA.foracid +  " EST " +CUST.ALERTS.partTranType + " DE "+CUST.ALERTS.TranAmt + " " + CUST.ALERTS.tranCrncyCode + ". VOTRE SOLDE INDICATIF EST DE "+EBSRV.GLBDATA.ActBal + " " +EBSRV.GLBDATA.ActCrncy+ "."
					CUST.ALERTS.massage = EBSRV.GLBDATA.SmsVal
					print(CUST.ALERTS.massage)
					CUST.ALERTS.phoneno = EBSRV.GLBDATA.mobNo
					CUST.ALERTS.trandate = mid$(BANCS.STDIN.BODDate,0,10)
					CUST.ALERTS.dumpSmsCnt = "Y"
					########callscriptifexist("smspushothers.scr")
					sv_e = "nohup babx4061 $B2K_SESSION_ID ebsmspushothers.scr " +'"'+CUST.ALERTS.massage+'"'+ " " +'"'+CUST.ALERTS.phoneno+ '"' + " " +'"'+CUST.ALERTS.trandate+ '"' + " " +'"'+ CUST.ALERTS.dumpSmsCnt + '"'+ "@s &"
					sv_a = system(sv_e)
					print(sv_a)
				endif
			endif
		endif
		endif
		#----------SMS stop

		if((EBSRV.GLBDATA.alMail!="") and (BANCS.STDIN.contextBankId !="54"))then
			goto VAYU
		else
			print(EBSRV.GLBDATA.alMail)
			print(EBSRV.GLBDATA.toAddr)
			#######EBSRV.GLBDATA.toAddr = "JOHN.WAMAI@EQUITYBANK.CO.KE,vino.palani@simbatech.biz,Edwin.Mureithi@equitybank.co.ke"
			EBSRV.GLBDATA.toAddr = EBSRV.GLBDATA.toAddr + "," + EBSRV.GLBDATA.alMail
		endif
		print(EBSRV.GLBDATA.toAddr)
		sv_u = urhk_getFileLocation("COM|ebCommonTranAlert.com")
		if(sv_u ==0)then
			print(BANCS.OUTPARAM.fileLocation)
			EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "ebCommonTranAlert.com"
			print(EBSRV.GLBDATA.comfil)
			print(EBSRV.GLBDATA.toAddr)
			print(EBSRV.GLBDATA.PartyName)
			print(EBSRV.GLBDATA.PartyLname)
			print(CUST.ALERTS.TranAmt)
			print(EBSRV.GLBDATA.tranparti)
			if((EBSRV.GLBDATA.tranparti=="") or (EBSRV.GLBDATA.tranparti==" "))then
				EBSRV.GLBDATA.tranparti ="NA"
			endif
			print(CUST.ALERTS.partTranType)
			if(EBSRV.GLBDATA.isLienYN=="N")then
			EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " +'"'+ EBSRV.GLBDATA.toAddr +'"'+ " " +'"'+ EBSRV.GLBDATA.PartyName+ '"'+" " +'"'+ EBSRV.GLBDATA.PartyLname +'"'+ " " +'"'+ EBSRV.GLBDATA.foracid +'"'+ " " + '"'+CUST.ALERTS.TranAmt +'"'+ " " +'"'+ CUST.ALERTS.TranId +'"'+ " " +'"'+ EBSRV.GLBDATA.tranparti +'"'+ " " +'"'+CUST.ALERTS.partTranType+'"'+ " " +'"'+ CUST.ALERTS.tranCrncyCode +'"'+ " " + '"'+EBSRV.GLBDATA.PartySal +'"'+ " " +'"'+ EBSRV.GLBDATA.isLienYN + '"' + " "
			endif
			if(EBSRV.GLBDATA.isLienYN=="Y")then
			EBSRV.GLBDATA.tranparti = "Channel Lien Marking"
			EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " +'"'+ EBSRV.GLBDATA.toAddr + '"'+" " +'"'+ EBSRV.GLBDATA.PartyName+'"'+ " " +'"'+ EBSRV.GLBDATA.PartyLname +'"'+ " " +'"'+ EBSRV.GLBDATA.foracid +'"'+ " " +'"'+ CUST.ALERTS.TranAmt +'"'+ " " +'"'+ CUST.ALERTS.TranId +'"'+ " " +'"'+ EBSRV.GLBDATA.tranparti +'"'+ " " +'"'+CUST.ALERTS.partTranType+'"'+ " " +'"'+ CUST.ALERTS.tranCrncyCode +'"'+ " " + '"'+EBSRV.GLBDATA.PartySal +'"'+ " " +'"'+EBSRV.GLBDATA.isLienYN +'"'+ " "
			endif
		else
			EBSRV.GLBDATA.comfil   = ""
		endif
		if(EBSRV.GLBDATA.comfil != "")then
			print(EBSRV.GLBDATA.comfil)
			sv_u = system(EBSRV.GLBDATA.comfil)
			if(sv_u ==0)then
				print("smtp success")
			else
				print("failed smtp")
			endif
		else
			goto VAYU
		endif
	else
		goto VAYU
	##}
	endif
VAYU:
