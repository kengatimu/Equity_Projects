<--START
	
	TRACE ON
	
	sv_a = REPEXISTS("CUST")
	IF(sv_a == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.intrDraccnt = " "
	CUST.DATA.cifId = " "
	CUST.DATA.odaccnt = " "
	CUST.DATA.errorFlg = "N"
	CUST.DATA.errorMsg = " "
	CUST.DATA.recCount = "0"
	CUST.DATA.CArecCount = "0"
	CUST.DATA.allowseeps = ""
	IF(FIELDEXISTS(BANCS.INPUT.intrDraccnt))THEN
	#{
		IF(BANCS.INPUT.intrDraccnt !="")THEN
		#{
			CUST.DATA.intrDraccnt = TOUPPER(TRIM(BANCS.INPUT.intrDraccnt))
		#}
		ELSE
		#{
        		CUST.DATA.errorFlg = "Y"
        		CUST.DATA.errorMsg = "Interest debit account is not Entered "
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.cifId))THEN
	#{
		IF(BANCS.INPUT.cifId !="")THEN
		#{
			CUST.DATA.cifId = TOUPPER(TRIM(BANCS.INPUT.cifId))
		#}
		ELSE
		#{
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF(FIELDEXISTS(BANCS.INPUT.schmCode))THEN
	#{
		IF(BANCS.INPUT.schmCode !="")THEN
		#{
			CUST.DATA.schmCode = TOUPPER(TRIM(BANCS.INPUT.schmCode))
		#}
		ELSE
		#{
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.crncyCode))THEN
        #{
                IF(BANCS.INPUT.crncyCode !="")THEN
                #{
                        CUST.DATA.crncyCode = TOUPPER(TRIM(BANCS.INPUT.crncyCode))
			PRINT(CUST.DATA.crncyCode)
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        BANCS.INPUT.moduleName  = "OT"
        BANCS.INPUT.parameterId = "ODCA_SCHEMES"
        CALL ("getcparamvalue.scr")
        IF(BANCS.OUTPUT.parameterVal != "")THEN
        #{
                CUST.DATA.schmparmVal = BANCS.OUTPUT.parameterVal
                #}
        ELSE
                #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                GOTO ENDOFSCRIPT

        #}
        ENDIF

        sv_p = GETPOSITION(CUST.DATA.schmparmVal,CUST.DATA.schmCode)
        PRINT(sv_p)

        IF(sv_p <= "0")THEN
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "recCount|SELECT COUNT(1) FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND CIF_ID=?SVAR AND FORACID =?SVAR AND SCHM_TYPE='CAA' AND DEL_FLG='N' AND "
	sv_s = sv_s + "ACCT_CLS_FLG='N' AND ENTITY_CRE_FLG='Y'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.cifId + "|" + CUST.DATA.intrDraccnt 
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "DB error,Please contact DBA"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.recCount = BANCS.OUTPARAM.recCount
	#}
	ENDIF
	
	IF(CUST.DATA.recCount == "0")THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "Please enter Current account mapped to cifId:"+CUST.DATA.cifId
		GOTO ENDOFSCRIPT
	#}
	ENDIF
		
	sv_s = "recCount|SELECT COUNT(1) FROM TBAADM.GAC WHERE BANK_ID=?SVAR AND INT_DR_ACID=(SELECT ACID FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID = ?SVAR)"
	sv_s = sv_s + " AND INT_DR_ACCT_FLG='P'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.intrDraccnt  + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "DB error,Please contact DBA"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.CArecCount = BANCS.OUTPARAM.recCount
	#}
	ENDIF
	
	IF(CUST.DATA.CArecCount != "0")THEN
	#{
		sv_s = "odaccnt|SELECT FORACID FROM TBAADM.GAM WHERE ACID =(SELECT ACID FROM TBAADM.GAC WHERE BANK_ID=?SVAR AND INT_DR_ACID=(SELECT ACID FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID = ?SVAR)"
		sv_s = sv_s + " AND INT_DR_ACCT_FLG='P') AND BANK_ID=?SVAR AND DEL_FLG='N' AND ACCT_CLS_FLG='N'"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.intrDraccnt  + "|" + BANCS.STDIN.contextBankId   + "|" + BANCS.STDIN.contextBankId 
	
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
	
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
	
		IF(sv_d == 0)THEN
		#{
		#	CUST.DATA.errorFlg = "Y"
		#	CUST.DATA.errorMsg = "DB error,Please contact DBA"
		#	GOTO ENDOFSCRIPT
		#}
		#ELSE
		#{
			CUST.DATA.odaccnt = BANCS.OUTPARAM.odaccnt
			CUST.DATA.errorFlg = "Y"
			CUST.DATA.errorMsg = "Entered CAA account already linked to ODA account "+CUST.DATA.odaccnt
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF

        sv_s = "crncyCode,allow_sweeps|SELECT ACCT_CRNCY_CODE,ALLOW_SWEEPS FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID =?SVAR AND DEL_FLG='N' AND SCHM_TYPE='CAA' AND ACCT_CLS_FLG='N' AND ENTITY_CRE_FLG='Y'"
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.intrDraccnt

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d != 0)THEN
        #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "Invalid CAA Account"
                GOTO ENDOFSCRIPT
                #}
        ELSE
                #{
                CUST.DATA.cacrncyCode = BANCS.OUTPARAM.crncyCode
                CUST.DATA.allowseeps = BANCS.OUTPARAM.allow_sweeps
        #}
        ENDIF

	
	IF(TRIM(CUST.DATA.crncyCode) != TRIM(CUST.DATA.cacrncyCode))THEN
	#{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "Please Enter current account of currency code: "+CUST.DATA.crncyCode
                GOTO ENDOFSCRIPT
        #}
	ENDIF

	IF((TRIM(CUST.DATA.allowseeps) != "Y") AND (CUST.DATA.CArecCount == 0))THEN
	#{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "Sweep not allowed on the Account, Can not link the account to OD"
                GOTO ENDOFSCRIPT
        #}
	ENDIF

	sv_s = "recCount|SELECT COUNT(*) FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR AND POOL_ID IS NOT NULL"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.intrDraccnt
        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d != 0)THEN
        #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "Invalid CAA Account"
                GOTO ENDOFSCRIPT
                #}
        ELSE
                #{
                CUST.DATA.recCount = BANCS.OUTPARAM.recCount

		PRINT(CUST.DATA.recCount)
        #}
        ENDIF

	IF(CUST.DATA.recCount !="0")THEN
	#{
	        sv_s = "poolId|SELECT POOL_ID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR AND POOL_ID IS NOT NULL"
        	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.intrDraccnt
        	PRINT(sv_s)
        	PRINT(BANCS.INPARAM.BINDVARS)

        	sv_d = urhk_dbSelectWithBind(sv_s)
        	PRINT(sv_d)

        	IF(sv_d != 0)THEN
        	#{
                	CUST.DATA.errorFlg = "Y"
                	CUST.DATA.errorMsg = "Invalid CAA Account"
                	GOTO ENDOFSCRIPT
                #}
        	ELSE
                #{
         	       CUST.DATA.poolId = BANCS.OUTPARAM.poolId
                	PRINT(CUST.DATA.poolId)
                	CUST.DATA.errorFlg = "Y"
                	CUST.DATA.errorMsg = "Account is already pooled, pool ID:"+CUST.DATA.poolId+".Please remove the pool using HSWEEPS menu"
                	GOTO ENDOFSCRIPT
		#}
		ENDIF
        #}
        ENDIF
	
	ENDOFSCRIPT:
	sv_a = urhk_SetOrbOut("errorFlg|"+CUST.DATA.errorFlg)
	sv_a = urhk_SetOrbOut("errorMsg|"+CUST.DATA.errorMsg)
		
	TRACE OFF
END-->
