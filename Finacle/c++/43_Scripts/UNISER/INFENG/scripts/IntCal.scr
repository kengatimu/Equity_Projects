<--START
CHECKSUM="37c600251992aac7aa02ed350b5091a76f24c7eddf845d764f4d9e34e74f3f23"
	TRACE ON
	
	
	sv_s = "StartDate,EndDate,IntAmt1,IntComp|SELECT start_date,end_date,interest_amount,"
	sv_s = sv_s + "interest_amount/(end_date - start_date + 1) FROM TBAADM.IDT"
	sv_s = sv_s + " WHERE entity_id = ?SVAR"
	sv_s = sv_s + " AND end_date >= TO_DATE(?SVAR,'DD-MM-YYYY')"
	sv_s = sv_s + " AND start_date <= TO_DATE(?SVAR,'DD-MM-YYYY')"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.ODAA.acctAcid + "|" + CUST.ODAA.FromDate + "|" + CUST.ODAA.ToDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	
	PRINT(sv_c)
	CUST.ODAA.IntAmt = "0"
	CUST.ODAA.ActualAmt = "0"
	
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_r = urhk_dbCursorFetch(sv_m)
	
	WHILE(sv_r == 0)
	#{
		CUST.ODAA.StartDate = BANCS.OUTPARAM.StartDate
		PRINT(CUST.ODAA.StartDate)
		CUST.ODAA.EndDate = BANCS.OUTPARAM.EndDate
		PRINT(CUST.ODAA.EndDate)
		CUST.ODAA.IntAmt1 = BANCS.OUTPARAM.IntAmt1
		PRINT(CUST.ODAA.IntAmt1)
		CUST.ODAA.IntComp = BANCS.OUTPARAM.IntComp
		PRINT(CUST.ODAA.IntComp)
		
		sv_s = "dateDiff1|SELECT TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " - TO_DATE(?SVAR,'DD-MM-YYYY') FROM DUAL"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ODAA.StartDate + "|" + CUST.ODAA.FromDate
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			IF (BANCS.OUTPARAM.dateDiff1 < 0) THEN
			#{
				PRINT("Inside IF")
				CUST.ODAA.StartDate = CUST.ODAA.FromDate
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = "dateDiff2|select TO_DATE(?SVAR,'DD-MM-YYYY')"
		sv_s = sv_s + " - TO_DATE(?SVAR,'DD-MM-YYYY') FROM DUAL"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ODAA.EndDate + "|" + CUST.ODAA.ToDate
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			IF (BANCS.OUTPARAM.dateDiff2 > 0) THEN
			#{
				PRINT("Inside IF")
				CUST.ODAA.EndDate = CUST.ODAA.ToDate
			#}
			ENDIF
		#}
		ENDIF
		
		sv_s = "DaysDiff|select TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " - TO_DATE(?SVAR,'DD-MM-YYYY') FROM DUAL"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.ODAA.EndDate + "|" + CUST.ODAA.StartDate
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
		#{
			CUST.ODAA.DaysDiff = BANCS.OUTPARAM.DaysDiff
		#}
		ENDIF
		
		CUST.ODAA.DaysDiff = CINT(CUST.ODAA.DaysDiff) + 1
		PRINT(CUST.ODAA.DaysDiff)
		
		CUST.ODAA.ActualAmt = CDOUBLE(CUST.ODAA.IntComp) * CDOUBLE(CUST.ODAA.DaysDiff)
		PRINT(CUST.ODAA.ActualAmt)
		
		CUST.ODAA.IntAmt = CDOUBLE(CUST.ODAA.IntAmt) + CDOUBLE(CUST.ODAA.ActualAmt)
		PRINT(CUST.ODAA.IntAmt)
		
		
		sv_r = urhk_dbCursorFetch(sv_m)
	#}
	DO
	sv_r = urhk_dbCursorClose(sv_m)
	PRINT(sv_r)
	
	
	EXITSCRIPT
END-->
