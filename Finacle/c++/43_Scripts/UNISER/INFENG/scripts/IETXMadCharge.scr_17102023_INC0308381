			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d=urhk_dbSelectWithBind(sv_s)
			IF(sv_d == 0) THEN
				CUST.DATA.CHRG=BANCS.OUTPARAM.PRCNT	
				PRINT(CUST.DATA.CHRG)
			ENDIF		
		
		#Agremment
			
			sv_s = " AMTIND, PRCNT,AMT,MIN_AMT,MAX_AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE,MIN_AMT,MAX_AMT   from custom.c_cpcm_data where entity_cre_flg='Y' and "
			sv_s = sv_s + " del_flg='N' and event_type ='"+CUST.DATA.eventType+"' and event_id='"+CUST.DATA.eventId+"'"
			sv_s = sv_s + " and AGREEMENT_CODE = (select employerid from CRMUSER.DEMOGRAPHIC where orgkey ='"+CUST.DATA.CIF_ID+"') "
			sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'and rownum=1"
			print(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN
			#{
				CUST.DATA.CHRG=BANCS.OUTPARAM.PRCNT	
				PRINT(CUST.DATA.CHRG)
			#{
			ENDIF

		#check CIF level

			sv_s =" AMTIND, PRCNT,AMT,MIN_AMT,MAX_AMT| select PERCENT,PERCENT_VALUE ,AMT_VALUE,MIN_AMT,MAX_AMT   from custom.c_cpcm_data where entity_cre_flg='Y' and "
			sv_s = sv_s + " del_flg='N' and event_type ='"+CUST.DATA.eventType+"' and event_id='"+CUST.DATA.eventId+"'"
			sv_s = sv_s + " and cust_id ='"+CUST.DATA.CIF_ID+"'"
			sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"'	and  rownum=1"
			print(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN				
				CUST.DATA.CHRG=BANCS.OUTPARAM.PRCNT	
				PRINT(CUST.DATA.CHRG)
			ENDIF	
		
		
		#check account level

			sv_s =" AMTIND, PRCNT,AMT,MIN_AMT,MAX_AMT | select PERCENT,PERCENT_VALUE ,AMT_VALUE,MIN_AMT,MAX_AMT   from custom.c_cpcm_data where entity_cre_flg='Y' and "
			sv_s = sv_s + " del_flg='N' and event_type ='"+CUST.DATA.eventType+"' and event_id='"+CUST.DATA.eventId+"'"
			sv_s = sv_s + " and foracid ='"+BANCS.INPUT.DebitAccount+"'"
			sv_s = sv_s + " and bank_id='"+BANCS.STDIN.contextBankId+"' and  rownum =1 "
			print(sv_s)
			sv_u = urhk_dbselectwithBind(sv_s)
			print(sv_u)
			IF (sv_u == 0) THEN
				CUST.DATA.CHRG=BANCS.OUTPARAM.PRCNT	
				PRINT(CUST.DATA.CHRG)
			ENDIF
			
		
			IF(CUST.DATA.CHRG !="") THEN 				
				CUST.DATA.chrgAmt = CDOUBLE(CUST.DATA.inputAmt) * (CDOUBLE(CUST.DATA.CHRG) * (0.01))
				print(CUST.DATA.chrgAmt)
				#CUST.DATA.chrgAmt = CDOUBLE(CUST.DATA.chrgAmt) + (CDOUBLE(CUST.DATA.chrgAmt ) * (0.16))
