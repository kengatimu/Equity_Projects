			ENDIF


			IF(CUST.DATA.crncy != BANCS.INPUT.chrgCollCrncy)THEN
				BANCS.INPARAM.InputAmount  = CUST.DATA.chrgAmt
				BANCS.INPARAM.FromCurrency =BANCS.INPUT.inputCrncy 
				#BANCS.INPARAM.FromCurrency = CUST.DATA.crncy
				BANCS.INPARAM.ToCurrency   = BANCS.INPUT.chrgCollCrncy
				BANCS.INPARAM.RateCode     = "TTB"
				BANCS.INPARAM.Rate         = CDOUBLE("0.0")
				sv_u = urhk_B2k_ConvertAmount("")
				CUST.DATA.chrgAmt = BANCS.OUTPARAM.OutputAmount
				print(CUST.DATA.chrgAmt)
			ELSE
				print(CUST.DATA.chrgAmt)
			ENDIF
	ELSE
		CUST.DATA.errFlg = "Y"
		CUST.DATA.MSG ="Customer Account Not Valid"
		GOTO ENDOFSCRIPT
	ENDIF
ELSE
	CUST.DATA.errFlg = "Y"
	CUST.DATA.MSG = "Customer Account Not Entered"
	GOTO ENDOFSCRIPT

ENDIF

ENDOFSCRIPT:

		BANCS.OUTPUT.collAmount = CUST.DATA.chrgAmt
                BANCS.OUTPUT.collCrncy = BANCS.INPUT.chrgCollCrncy
		#BANCS.OUTPUT.collCrncy = BANCS.OUTPUT.collCrncy
