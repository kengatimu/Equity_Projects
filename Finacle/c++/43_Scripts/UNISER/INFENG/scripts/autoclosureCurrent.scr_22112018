						sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						PRINT(sv_b)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						PRINT(sv_a)
						sv_d = sv_d + 1
						sv_n = sv_n + 1
						sv_d = sv_c + 1
					#}
					DO
					CUST.AUTOCLS.errorFlg = "Y"
					CUST.AUTOCLS.errorMsg = sv_b
					
					#Failure message written in the final report
					#sv_t = urtn_fileWrite(CUST.DATA.fileIndex + "|" + CUST.DATA.message)
					
					sv_q = CUST.AUTOCLS.errorMsg
					PRINT(sv_q)
					sv_q = CUST.AUTOCLS.foracid +"|"+ sv_q
					sv_b = urtn_fileWrite(CUST.AUTOCLS.failFileIndex1 + "|" + sv_q)
					PRINT(sv_b)
					
					GOTO NEXTACID
					
				#}
				ENDIF
				sv_u = urhk_SetUrhkInp("acctBasic.foracid|" +CUST.AUTOCLS.foracid)
				#sv_u = urhk_SetUrhkInp("clsrProcCrit.xferBalFlg|N")
				sv_u = urhk_ExecSrvNoCommit("SRV_FetchOperAcctClsrDtlForVerify|retain_all_output = Y|same_user_verify =	Y")
				PRINT(sv_u)
				
				IF (sv_u == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Fatal_num)
					PRINT(BANCS.OUTPARAM.Error_num)
					PRINT(BANCS.OUTPARAM.Warning_num)
					PRINT(BANCS.OUTPARAM.UserInfo_num)
					PRINT(BANCS.OUTPARAM.Xcpn_num)
					PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
					PRINT(BANCS.OUTPARAM.Xcpn_Xcpn_num)
					PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
					
					sv_d = 1
					sv_n = 1
					sv_c = CINT(BANCS.OUTPARAM.Error_num)
					WHILE (sv_d <= sv_c)
					#{
						sv_f = FORMAT$(sv_d,"%d")
						sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						PRINT(sv_b)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						PRINT(sv_a)
						sv_d = sv_d + 1
						sv_n = sv_n + 1
						sv_d = sv_c + 1
					#}
					DO
					CUST.AUTOCLS.errorFlg = "Y"
					CUST.AUTOCLS.errorMsg = sv_b
					
					#Failure message written in the final report
					#sv_t = urtn_fileWrite(CUST.DATA.fileIndex + "|" + CUST.DATA.message)
					
					sv_q = CUST.AUTOCLS.errorMsg
					PRINT(sv_q)
					sv_q = CUST.AUTOCLS.foracid +"|"+ sv_q
					sv_b = urtn_fileWrite(CUST.AUTOCLS.failFileIndex1 + "|" + sv_q)
					PRINT(sv_b)
					
					GOTO NEXTACID
				#}
				ENDIF
				
				sv_a = urhk_CopyOutToIn("")
				
				sv_u = urhk_ExecSrvNoCommit("SRV_VerifyOperAcctClsrDtl|retain_all_output = Y|same_user_verify = Y|call_mode = N")
				PRINT(sv_u)
				
				IF (sv_u == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Fatal_num)
					PRINT(BANCS.OUTPARAM.Error_num)
					PRINT(BANCS.OUTPARAM.Warning_num)
					PRINT(BANCS.OUTPARAM.UserInfo_num)
					PRINT(BANCS.OUTPARAM.Xcpn_num)
					PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
					PRINT(BANCS.OUTPARAM.Xcpn_Xcpn_num)
					PRINT(BANCS.OUTPARAM.Xcpn_Err_num)
					
					sv_d = 1
					sv_n = 1
					sv_c = CINT(BANCS.OUTPARAM.Error_num)
					WHILE (sv_d <= sv_c)
					#{
						sv_f = FORMAT$(sv_d,"%d")
						sv_b = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						PRINT(sv_b)
						sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_a = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						PRINT(sv_a)
						sv_d = sv_d + 1
						sv_n = sv_n + 1
						sv_d = sv_c + 1
					#}
					DO
					CUST.AUTOCLS.errorFlg = "Y"
					CUST.AUTOCLS.errorMsg = sv_b
					
					#Failure message written in the final report
					#sv_t = urtn_fileWrite(CUST.DATA.fileIndex + "|" + CUST.DATA.message)
					
					sv_q = CUST.AUTOCLS.errorMsg
					PRINT(sv_q)
					sv_q = CUST.AUTOCLS.foracid +"|"+ sv_q
					sv_b = urtn_fileWrite(CUST.AUTOCLS.failFileIndex1 + "|" + sv_q)
					PRINT(sv_b)
					
					GOTO NEXTACID
					#}
				ELSE
					#{
					
					sv_q = "Account successfully Autoclosed"
					PRINT(sv_q)
					sv_q = CUST.AUTOCLS.foracid +"|"+ sv_q
					sv_b = urtn_fileWrite(CUST.AUTOCLS.succFileIndex1 + "|" + sv_q)
					PRINT(sv_b)
					
					GOTO NEXTACID
					
				#}
				ENDIF
				
			#}
			ENDIF
			#}
		ELSE
			#{
			
