			#PRINT(sv_b)
			
			GOTO NEXTACID
			
		#}
		ENDIF
		
		
		NEXTACID:
			sv_f = urhk_dbCursorFetch(sv_l)
			PRINT(sv_f)
			
		#}
		DO
		
		sv_c = urhk_dbCursorClose(sv_l)
		PRINT(sv_c)
		
		
	ENDOFSCRIPT:
		
		sv_c = urtn_fileClose(CUST.AUTOCLS.failFileIndex1)
		PRINT(sv_c)
		
		sv_c = urtn_fileClose(CUST.AUTOCLS.succFileIndex1)
		PRINT(sv_c)
		
		
		CUST.AUTOCLS.ERR000002 = "Failed "
		PRINT(CUST.AUTOCLS.list_file_name)
		sv_q = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.AUTOCLS.mrt_file_name + " " + CUST.AUTOCLS.list_file_name + " " + CUST.AUTOCLS.rpt
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.AUTOCLS.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		
		PRINT(CUST.AUTOCLS.mrt_file_name)
		PRINT(CUST.AUTOCLS.list_file_name1)
		PRINT(CUST.AUTOCLS.rpt1)
		
		sv_q = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.AUTOCLS.mrt_file_name + " " + CUST.AUTOCLS.list_file_name1 + " " + CUST.AUTOCLS.rpt1
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.AUTOCLS.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		
		sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.AUTOCLS.rpt_file_name+" '" + CUST.AUTOCLS.title+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.AUTOCLS.ERR000002 + "^DATE")
			GOTO FINISH
		#}
		ENDIF
		
		sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.AUTOCLS.rpt_file_name1+" '" + CUST.AUTOCLS.title1+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		IF (sv_r != 0) THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.AUTOCLS.ERR000002 + "^DATE")
			GOTO FINISH
		#}
		ENDIF
		
	FINISH:
