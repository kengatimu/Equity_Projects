	##################################
	#Interest Calculated till date will be minimum of finIntMaxDate,legIntMaxDate
	##################################
	
	sv_s = "dummy|"
	sv_s = sv_s + "select dummy from dual where to_date(?SVAR,'dd-mm-yyyy')>=to_date(?SVAR,'dd-mm-yyyy')"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.finIntDate+"|"+CUST.EQB.migDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r != "0") THEN
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="legacy schedule end date is before migration date. Interest Adjustment cannot be done for this account"
