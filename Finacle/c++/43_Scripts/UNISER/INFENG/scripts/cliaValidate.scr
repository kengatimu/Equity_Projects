	#}
	ENDIF
	
	##################################
	# Fetch Maximum date for which legacy Interest is available
	##################################
	
	sv_s = "legIntMaxDate|"
	sv_s = sv_s + "select to_char(max(end_date),'dd-mm-yyyy') from custom.c_lsbt where acid=?SVAR AND bank_id=?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.legIntMaxDate=BANCS.OUTPARAM.legIntMaxDate
		PRINT(CUST.EQB.legIntMaxDate)
		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Account is not a valid Migrated Loan Account"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	##################################
	#Interest Calculated till date will be minimum of finIntMaxDate,legIntMaxDate
	##################################
	
	sv_s = "dummy|"
	sv_s = sv_s + "select dummy from dual where to_date(?SVAR,'dd-mm-yyyy')>to_date(?SVAR,'dd-mm-yyyy')"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.finIntMaxDate+"|"+CUST.EQB.legIntMaxDate
