		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Interest is not yet Collected in Finacle System"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
		##################################
	#Interest Calculated till date will be minimum of finIntMaxDate,legIntMaxDate
	##################################
	
	sv_s = "dummy|"
	sv_s = sv_s + "select dummy from dual where to_date(?SVAR,'dd-mm-yyyy')>=to_date(?SVAR,'dd-mm-yyyy')"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.migDate+"|"+CUST.EQB.finIntMaxDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Finacle Interest application is not done post migration.Interest Adjustment cannot be done for this account"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	##################################
	# Fetch currency code in which finacle interest is available
	##################################
	
	sv_s = "finIntCcy|"
	sv_s = sv_s + "select tax_crncy_code from tbaadm.int_adm where acid=?SVAR AND bank_id=?SVAR AND end_date=to_date(?SVAR,'dd-mm-yyyy') AND entity_cre_flg='Y' AND del_flg='N'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId+"|"+CUST.EQB.finIntMaxDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.finIntCcy=BANCS.OUTPARAM.finIntCcy
		PRINT(CUST.EQB.finIntCcy)
		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to retrieve Finacle Interest"
