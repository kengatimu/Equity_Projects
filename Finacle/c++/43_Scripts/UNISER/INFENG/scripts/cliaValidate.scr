	#}
	ENDIF
	
	##################################
	# Account Reschedule check
	##################################
	
	sv_s = "count|"
	sv_s = sv_s + "select count(1) from tbaadm.lrs where acid=?SVAR AND bank_id=?SVAR AND flow_id='EIDEM' AND shdl_num='01'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (BANCS.OUTPARAM.count  == "0") THEN
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Account is already Rescheduled "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	##################################
	# Interest Rate Change Check
	##################################
	
	sv_s = "count|"
	sv_s = sv_s + "select count(distinct int_tbl_code_srl_num) from tbaadm.itc where entity_id=?SVAR AND bank_id=?SVAR AND entity_type='ACCNT'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (BANCS.OUTPARAM.count > 1) THEN
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Rate of Interest is changed for the Account"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	##################################
	# Charge off Check
	##################################
	
	sv_s = "count|"
	sv_s = sv_s + "select count(1) from tbaadm.lam where acid=?SVAR AND bank_id=?SVAR AND CHRGE_OFF_FLG='Y'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (BANCS.OUTPARAM.count == "1") THEN
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Account is already Charged OFF "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	##################################
	# Calculate Maximum date for which finacle interest is available#
	##################################
	
	sv_s = "finIntMaxDate|"
	sv_s = sv_s + "select to_char(max(end_date),'dd-mm-yyyy') from tbaadm.int_adm where acid=?SVAR AND bank_id=?SVAR AND entity_cre_flg='Y' AND del_flg='N'"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.finIntMaxDate=TRIM(BANCS.OUTPARAM.finIntMaxDate)
