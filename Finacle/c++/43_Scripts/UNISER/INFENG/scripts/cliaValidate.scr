	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.acctCrncyCode=BANCS.OUTPARAM.acctCrncyCode
		PRINT(CUST.EQB.acctCrncyCode)
		
		CUST.EQB.clsFlg=BANCS.OUTPARAM.clsFlg
		PRINT(CUST.EQB.clsFlg)
		IF(CUST.EQB.clsFlg == "Y")THEN
		#{
			CUST.EQB.errorFlg="Y"
			CUST.EQB.errorMsg="Account is Closed"
