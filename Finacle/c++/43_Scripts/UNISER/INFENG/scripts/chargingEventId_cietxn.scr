	CUST.CIETXN.part_tran_srl_num = "1"
	
	sv_m = "INSERT INTO c_detd (sol_id,dxfer_id,dxfer_flg,ptran_type,crncy_code,denom_ind,denom_value,"
	sv_m = sv_m + "denom_count,teller_id,tran_date,"
	sv_m = sv_m + "value_date,"
	sv_m = sv_m + "part_tran_srl_num,rcre_user_id,rcre_time,"
	sv_m = sv_m + "lchg_user_id,lchg_time,bank_id)"
	sv_m = sv_m + " VALUES (?SVAR,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_m = sv_m + "TO_DATE(?SVAR,'DD-MM-YYYY'),"
	sv_m = sv_m + "?SVAR,?SVAR,"
	sv_m = sv_m + "sysdate,"
	sv_m = sv_m + "?SVAR,"
	sv_m = sv_m + "sysdate,"
	sv_m = sv_m + "?SVAR )"
	
	CUST.CIETXN.bindvarsM  =  CUST.CIETXN.sol_id +"|"+CUST.CIETXN.tranId+"|" +CUST.CIETXN.dxfer_flg + "|"  +  CUST.CIETXN.ptran_type +  "|" + CUST.CIETXN.CrncyCode1 +"|" +CUST.CIETXN.denom_ind +"|"+ CUST.CIETXN.CoinDenomVal
	CUST.CIETXN.bindvarsM  = CUST.CIETXN.bindvarsM + "|" +CUST.CIETXN.CoinDenomCnt + "|" +CUST.CIETXN.teller_id +"|"+ CUST.CIETXN.tranDate+"|"+ CUST.CIETXN.tranDate
	CUST.CIETXN.bindvarsM  = CUST.CIETXN.bindvarsM  + "|" +CUST.CIETXN.part_tran_srl_num+ "|"+BANCS.STDIN.userId+ "|"+BANCS.STDIN.userId+ "|" + BANCS.STDIN.contextBankId
	
	BANCS.INPARAM.BINDVARS = CUST.CIETXN.bindvarsM
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_q = sv_m
	print(sv_q)
	sv_v = urhk_dbsqlWithBind(sv_q)
	print(sv_v)
	IF (sv_v != 0)THEN
	#{
		print("Charge collection failed")
		CUST.CIETXN.errorFlg = "Y"
		GOTO FINISH
	#}
	# ELSE
	#sv_d = urhk_dbSQLWithBind("commit")
	#print(sv_d)
	
	CUST.CIETXN.chargeTranId = CUST.CIETXN.tranId
	CUST.CIETXN.chargeTranDate =CUST.CIETXN.tranDate
	CUST.CIETXN.fxChargeResult = " :          Please Modify AND post the charge Transaction from HTM menu to capture the denomination : " + CUST.CIETXN.tranId
	print(CUST.CIETXN.fxChargeResult)

	#}
	ELSE
	sv_d = urhk_dbSQLWithBind("commit")
	print(sv_d)

	CUST.CIETXN.chargeTranId = CUST.CIETXN.tranId
	CUST.CIETXN.chargeTranDate =CUST.CIETXN.tranDate

	#}
