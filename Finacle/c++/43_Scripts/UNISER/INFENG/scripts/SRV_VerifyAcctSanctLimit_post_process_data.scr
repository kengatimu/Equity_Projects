<--START
CHECKSUM="e55db38bd0db23fc433954cbe5ad4d6428de11728540c3e981cc4b4926fc62a1"
	TRACE ON
if(repexists("CUST") == 0)then
	createrep("CUST")
endif
if(classexists("CUST","EQTYL") == 0)then
	createclass("CUST","EQTYL",5)
endif
	
	#CALL("s_aclhmauthmn001.scr")
	#call("ebSanctLimChrg.scr")
	#call("ebSanctLimChrgCalc.scr")

	sv_a= urhk_SRV_GetVal("limitHdr.limitAcct.foracid")
	if(sv_a == 0)then
		CUST.EQTYL.foracid = BANCS.OUTPARAM.srvValue
	endif

	sv_a = urhk_getAcctDetailsInRepository(CUST.EQTYL.foracid)
	if(sv_a == 0)then
		CUST.EQTYL.acctSolId = BANCS.OUTPARAM.acctSolId
		CUST.EQTYL.schmType = BANCS.OUTPARAM.schmType
		CUST.EQTYL.schmCode = BANCS.OUTPARAM.schmCode
		CUST.EQTYL.acctOpenDate = BANCS.OUTPARAM.acctOpenDate
		if((CUST.EQTYL.schmType == "ODA") or (CUST.EQTYL.schmType == "CAA"))then
			call("rpSanctLimitInsertSanct.scr")	
		endif
	endif
	
	EXITSCRIPT
END-->
