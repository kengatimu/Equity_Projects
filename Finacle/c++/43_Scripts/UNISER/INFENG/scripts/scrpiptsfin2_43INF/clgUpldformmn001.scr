############################################################################################################

<--START
CHECKSUM="496648142107fe59d540d825a11118808e647855056265423b6e60850d2575be"
	TRACE ON
	
	#--------------------------------------------------------------------------------
	# Creating repository and class
	#--------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------------
	#--To get the values
	#---------------------------------------------------------------------------------------
	
	CUST.DATA.zoneDate= BANCS.INPUT.zoneDate
	PRINT(CUST.DATA.zoneDate)
	
	CUST.DATA.zoneCode= BANCS.INPUT.zoneCode
	PRINT(CUST.DATA.zoneCode)
	
	CUST.DATA.fileName= BANCS.INPUT.fileName
	PRINT(CUST.DATA.fileName)
	
	#CUST.DATA.confirm= BANCS.INPUT.confirm
	#PRINT(CUST.DATA.confirm)
	
	#---------------------------------------------------
	#--Validate zone date
	#------------------------------------------------------
	sv_s = "zoneDateV|SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
	BANCS.INPARAM.BINDVARS = CUST.DATA.zoneDate
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
	#{
		CUST.DATA.zoneDateV= BANCS.OUTPARAM.zoneDateV
		print(CUST.DATA.zoneDateV)
	#}
	ENDIF
	
	#---------------------------------------------------
	#--Validate zone code
	#------------------------------------------------------
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "ZONE_CTSINHSE"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.setZoneCode1=BANCS.OUTPUT.parameterVal
		print(CUST.DATA.setZoneCode1)
		#}
	ELSE
		#{
		sv_g = "Err|Parameter value not set in C_CPARAM_VALUE_TABLE"
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "ZONE_CTSBOWZ"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.setZoneCode2=BANCS.OUTPUT.parameterVal
		print(CUST.DATA.setZoneCode2)
		#}
	ELSE
		#{
		sv_g = "Err|Parameter value not set in C_CPARAM_VALUE_TABLE"
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	sv_s = "count|SELECT count(1) "
	sv_s = sv_s + " FROM TBAADM.OZH "
	sv_s = sv_s + " WHERE ZONE_STAT='O' "
	sv_s = sv_s + " AND CLG_ZONE_DATE= to_date(?SVAR,'DD-MM-YYYY') "
	sv_s = sv_s + " AND CLG_ZONE_CODE IN (?SVAR, ?SVAR) "
	sv_s = sv_s + " AND sol_id= ?SVAR "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.zoneDate +"|"+ CUST.DATA.setZoneCode1 +"|"+ CUST.DATA.setZoneCode2 +"|"+ BANCS.STDIN.mySolId +"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d=urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	
	IF (sv_d != 0)THEN
	#{
		sv_u = urhk_SetOrbOut("Err|Database error contact Support")
		GOTO Finish
		#}
	ELSE
		#{
		CUST.DATA.count = BANCS.OUTPARAM.count
		print(CUST.DATA.count)
	#}
	ENDIF
	
	IF (CUST.DATA.count == 0) THEN
	#{
		sv_u = urhk_SetOrbOut("MSG|Open Zone for Inhouse use CTSINHSE, Outward Use CTSBOWZ")
		GOTO Finish
		#}
	ELSE
		#{
		sv_s = "count2|SELECT count(1) "
		sv_s = sv_s + " FROM TBAADM.OZH "
		sv_s = sv_s + " WHERE ZONE_STAT='O' "
		sv_s = sv_s + " AND CLG_ZONE_CODE= ?SVAR "
		sv_s = sv_s + " AND CLG_ZONE_DATE= TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + " AND  CLG_ZONE_CODE IN (?SVAR, ?SVAR) "
		sv_s = sv_s + " AND sol_id= ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.zoneCode +"|"+ CUST.DATA.zoneDate +"|"+ CUST.DATA.setZoneCode1 +"|"+ CUST.DATA.setZoneCode2 +"|"+ BANCS.STDIN.mySolId +"|"+ BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0)THEN
		#{
			sv_u = urhk_SetOrbOut("Err|Database error contact Support")
			GOTO Finish
			#}
		ELSE
			#{
			CUST.DATA.count2 = BANCS.OUTPARAM.count2
			print(CUST.DATA.count2)
		#}
		ENDIF
		
		IF (CUST.DATA.count2!=1)THEN
		#{
			sv_u = urhk_SetOrbOut("MSG|Zone Not Opened")
			GOTO Finish
		#}
		ENDIF
	#}
	ENDIF
	#---------------------------------------------------------------------------
	#--The foll step is to Validate Type of File and the Zone being uploaded
	#--KBA files can only be uploaded in CTSBOWZ
	#--Home clearing cheques can only be uploaded in CTSINHSE Zone
	#---------------------------------------------------------------------------
	
	CUST.DATA.chq = MID$(CUST.DATA.fileName,0,4)
	print(CUST.DATA.chq)
	
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "CLGFORM_CHQ"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.setChq1=BANCS.OUTPUT.parameterVal
		print(CUST.DATA.setChq1)
		#}
	ELSE
		#{
		sv_g = "Err|Parameter value not set in C_CPARAM_VALUE_TABLE"
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	IF ((CUST.DATA.chq == CUST.DATA.setChq1) AND (CUST.DATA.zoneCode !=CUST.DATA.setZoneCode1)) THEN
	#{
		sv_u = urhk_SetOrbOut("MSG|Use CTSINHSE Zone for Inhouse Cheques")
		GOTO Finish
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "CLGFORM_CHQ1"
	CALL("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.setChq2=BANCS.OUTPUT.parameterVal
		print(CUST.DATA.setChq2)
		#}
	ELSE
		#{
		sv_g = "Err|Parameter value not set in C_CPARAM_VALUE_TABLE"
		sv_z = urhk_SetOrbOut(sv_g)
	#}
	ENDIF
	
	IF ((CUST.DATA.chq == CUST.DATA.setChq2) AND (CUST.DATA.zoneCode !=CUST.DATA.setZoneCode2)) THEN
	#{
		sv_u = urhk_SetOrbOut("MSG|Use CTSBOWZ Zone for Outward KBA Cheques")
		GOTO Finish
	#}
	ENDIF
	
	#-------------------------------------------------------
	#----Moving and Backingup Posted file to BackUp location
	#-------------------------------------------------------
	sv_u = urhk_getEnv("DATA_PATH")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Data path is not set in common ENV^testMode")
		GOTO Finish
		#}
	ELSE
		#{
		CUST.DATA.userPath = BANCS.OUTPARAM.envValue
		print(CUST.DATA.userPath)
	#}
	ENDIF
	
	sv_u = urhk_getEnv("FILE_BAK_PATH")
	print(sv_u)
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Back up path is not set in common ENV^testMode")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.userBakPath = BANCS.OUTPARAM.envValue
		print(CUST.DATA.userBakPath)
	#}
	ENDIF
	
	#============================================================
	#File moving to user locations
	#===========================================================
	sv_s = "test -f " + CUST.DATA.userPath  + BANCS.INPUT.fileName
	print(sv_s)
	sv_r = system(sv_s)
	print(sv_r)
	IF (sv_r != 0) THEN
	#{
		sv_u = urhk_SetOrbOut("MSG|File does not exist")
		GOTO Finish
	#}
	ENDIF
	
	sv_f = "cp "
	sv_f = sv_f + CUST.DATA.userPath + BANCS.INPUT.fileName
	sv_f = sv_f + " ."
	#sv_f = sv_f +"/"+BANCS.STDIN.userId
	print(sv_f)
	sv_f = SYSTEM(sv_f)
	print(sv_f)
	
	sv_n="mv"
	print(sv_n)
	sv_q = CUST.DATA.userPath + CUST.DATA.fileName
	print(sv_q)
	sv_r =  sv_n + " " + sv_q + " " + CUST.DATA.userBakPath +CUST.DATA.fileName
	print(sv_r)
	sv_u = SYSTEM(sv_r)
	print(sv_u)
	
	IF (sv_u == 0) THEN
	#{
		sv_b = "MSG1|The File has been Successfully Backup"
		sv_z = urhk_SetOrbOut(sv_b)
		GOTO Finish
		#}
	ELSE
		#{
		sv_b = "MSG1|The File has not Backup"
		sv_z = urhk_SetOrbOut(sv_b)
	#}
	ENDIF
	
	Finish:
		EXITSCRIPT
		TRACE OFF
END-->
