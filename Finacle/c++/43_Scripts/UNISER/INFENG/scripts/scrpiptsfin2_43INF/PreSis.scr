IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.ATM.crForAcid22 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.ATM.errMsg = "Credit Foracid setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

IF (CDCI.Request.dccId !="EAZ") THEN 
	IF ((CDCI.Request.crForacid==CUST.ATM.crForAcid18) OR (CDCI.Request.crForacid == CUST.ATM.crForAcid19)) then
		CDCI.Request.ModeOfAction = "F"
		CDCI.Request.respCode = "99"
		exitscript
	ENDIF
ENDIF
#-Restriction for IPO
# put ipo account
IF (CDCI.Request.crForacid == CUST.ATM.crForAcid20) then
	  CDCI.Request.ModeOfAction = "F"
		    CDCI.Request.respCode = "99"
			      exitscript
ENDIF

#-Restriction For HARAKA - KANINI
IF (CDCI.Request.crForacid == CUST.ATM.crForAcid21) then
  CDCI.Request.ModeOfAction = "F"
      CDCI.Request.respCode = "99"
	    exitscript
 ENDIF

 #-Restriction For KENLO PROPERTIES LIMITED
IF (CDCI.Request.dccId =="WPD") THEN
	IF (CDCI.Request.crForacid == CUST.ATM.crForAcid22) then
	  CDCI.Request.ModeOfAction = "F"
	      CDCI.Request.respCode = "99"
		    exitscript
	 ENDIF
ENDIF


