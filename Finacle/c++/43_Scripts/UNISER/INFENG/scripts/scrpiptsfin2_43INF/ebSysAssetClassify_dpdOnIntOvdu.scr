	if (sv_d == 0) then
		CUST.ASSTCLASS.HTDSUM = BANCS.OUTPARAM.HTDSUM
		print(CUST.ASSTCLASS.HTDSUM)
	else
		CUST.ASSTCLASS.HTDSUM = CDOUBLE("0")
	endif
	
	sv_a = "DTDSUM|select nvl(abs(sum(decode(part_tran_type,'C',tran_amt,-1*tran_amt))),0)"
	sv_a = sv_a + "	from tbaadm.dtd"
	sv_a = sv_a + " where acid = ?SVAR"
	sv_a = sv_a + "	AND bank_id = ?SVAR"
	sv_a = sv_a + " AND pstd_flg = 'Y'"
	sv_a = sv_a + " AND del_flg = 'N'"
	sv_a = sv_a + " AND tran_type = 'T'"
	sv_a = sv_a + " AND tran_sub_type = 'IC'"
	if(CUST.ASSTCLASS.MININTCOLLDATE != "31-12-2099") then
		sv_a = sv_a + " AND tran_date between to_date('" + CUST.ASSTCLASS.MININTCOLLDATE + "','dd-mm-yyyy') AND to_date('" + BANCS.STDIN.BODDate + "','dd-mm-yyyy')"
		#sv_a = sv_a + " AND tran_date between '" + CUST.ASSTCLASS.MININTCOLLDATE + "' AND '" + BANCS.STDIN.BODDate + "'"
	endif
	print(sv_a)
	#BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MININTCOLLDATE + "|" + BANCS.STDIN.BODDate
	BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	if (sv_d == 0) then
		CUST.ASSTCLASS.DTDSUM = BANCS.OUTPARAM.DTDSUM
		print(CUST.ASSTCLASS.DTDSUM)
	else
		CUST.ASSTCLASS.DTDSUM = CDOUBLE("0")
	endif
	
	CUST.ASSTCLASS.TOTINTBOOKED = CDOUBLE(CUST.ASSTCLASS.HTDSUM) + CDOUBLE(CUST.ASSTCLASS.DTDSUM)
	print(CUST.ASSTCLASS.TOTINTBOOKED)
	
	sv_a = "HTDSUMCREDIT|select nvl(sum(tran_amt),0)"
	sv_a = sv_a + "	from tbaadm.htd"
	sv_a = sv_a + " where acid = ?SVAR"
	sv_a = sv_a + "	AND bank_id = ?SVAR"
	if(CUST.ASSTCLASS.MININTCOLLDATE != "31-12-2099") then
		sv_a = sv_a + " AND tran_date between to_date('" + CUST.ASSTCLASS.MININTCOLLDATE + "','dd-mm-yyyy') AND to_date('" + BANCS.STDIN.BODDate + "','dd-mm-yyyy')"
		#sv_a = sv_a + " AND tran_date between '" + CUST.ASSTCLASS.MININTCOLLDATE + "' AND '" + BANCS.STDIN.BODDate + "'"
	endif
	sv_a = sv_a + " AND pstd_flg = 'Y'"
	sv_a = sv_a + " AND del_flg = 'N'"
	sv_a = sv_a + " AND part_tran_type = 'C'"
	sv_a = sv_a + " AND NVL(module_id,'A') <> 'XGL'"
	print(sv_a)
	#BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MININTCOLLDATE + "|" + BANCS.STDIN.BODDate
	BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	if (sv_d == 0) then
		CUST.ASSTCLASS.HTDSUMCREDIT = BANCS.OUTPARAM.HTDSUMCREDIT
		print(CUST.ASSTCLASS.HTDSUMCREDIT)
	else
		CUST.ASSTCLASS.HTDSUMCREDIT = CDOUBLE("0")
	endif
	
	sv_a = "DTDSUMCREDIT|select nvl(sum(tran_amt),0)"
	sv_a = sv_a + "	from tbaadm.dtd"
	sv_a = sv_a + " where acid = ?SVAR"
	sv_a = sv_a + "	AND bank_id = ?SVAR"
	if(CUST.ASSTCLASS.MININTCOLLDATE != "31-12-2099") then
		sv_a = sv_a + " AND tran_date between to_date('" + CUST.ASSTCLASS.MININTCOLLDATE + "','dd-mm-yyyy') AND to_date('" + BANCS.STDIN.BODDate + "','dd-mm-yyyy')"
		#sv_a = sv_a + " AND tran_date between '" + CUST.ASSTCLASS.MININTCOLLDATE + "' AND '" + BANCS.STDIN.BODDate + "'"
	endif
	sv_a = sv_a + " AND pstd_flg = 'Y'"
	sv_a = sv_a + " AND del_flg = 'N'"
	sv_a = sv_a + " AND part_tran_type = 'C'"
	sv_a = sv_a + " AND  NVL(module_id,'A') <> 'XGL'"
	print(sv_a)
	#BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MININTCOLLDATE + "|" + BANCS.STDIN.BODDate
	BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	if (sv_d == 0) then
		CUST.ASSTCLASS.DTDSUMCREDIT = BANCS.OUTPARAM.DTDSUMCREDIT
		print(CUST.ASSTCLASS.DTDSUMCREDIT)
	else
		CUST.ASSTCLASS.DTDSUMCREDIT = CDOUBLE("0")
	endif
	
	CUST.ASSTCLASS.TOTDEPOSITAMT = CDOUBLE(CUST.ASSTCLASS.HTDSUMCREDIT) + CDOUBLE(CUST.ASSTCLASS.DTDSUMCREDIT)
	
	print(BANCS.STDIN.BODDate)
	print(CUST.ASSTCLASS.MAXCRBALDATE)
	print(CUST.ASSTCLASS.MINDRBALDATE)
	print(CUST.ASSTCLASS.MININTCOLLDATE)
	print(CUST.ASSTCLASS.HTDSUM)
	print(CUST.ASSTCLASS.DTDSUM)
	print(CUST.ASSTCLASS.HTDSUMCREDIT)
	print(CUST.ASSTCLASS.DTDSUMCREDIT)
	print(CUST.ASSTCLASS.TOTINTBOOKED)
	print(CUST.ASSTCLASS.TOTDEPOSITAMT)
	print(CUST.ASSTCLASS.DPDCNTR)
	print(CUST.ASSTCLASS.CUMINTBOOKEDAMT)
	print(CUST.ASSTCLASS.INTCOLLDATE)
	print(CUST.ASSTCLASS.INTCOLLAMT)
	
	if (CDOUBLE(CUST.ASSTCLASS.TOTINTBOOKED) <= CDOUBLE(CUST.ASSTCLASS.TOTDEPOSITAMT)) then
	#{
		CUST.ASSTCLASS.DPDCNTR = CINT("0")
		#}
	else
		#{
		if(CDOUBLE(CUST.ASSTCLASS.TOTINTBOOKED) > CDOUBLE(CUST.ASSTCLASS.TOTDEPOSITAMT)) then
		#{
			sv_a = "TRANDATE,TRANAMT|select to_char(tran_date,'dd-mm-yyyy') tran_date,tran_amt"
			sv_a = sv_a + " from tbaadm.htd"
			sv_a = sv_a + " where acid = ?SVAR"
			sv_a = sv_a + " AND bank_id = ?SVAR"
			if(CUST.ASSTCLASS.MININTCOLLDATE != "31-12-2099") then
			#{
				sv_a = sv_a + " AND tran_date between to_date('" + CUST.ASSTCLASS.MININTCOLLDATE + "','dd-mm-yyyy') AND to_date('" + BANCS.STDIN.BODDate + "','dd-mm-yyyy')"
				#sv_a = sv_a + " AND tran_date between '" + CUST.ASSTCLASS.MININTCOLLDATE + "' AND '" + BANCS.STDIN.BODDate + "'"
			#}
			endif
			sv_a = sv_a + " AND pstd_flg = 'Y'"
			sv_a = sv_a + " AND del_Flg = 'N'"
			sv_a = sv_a + " AND tran_type = 'T'"
			sv_a = sv_a + " AND tran_sub_type = 'IC'"
			sv_a = sv_a + " AND part_tran_type = 'D'"
			sv_a = sv_a + " union all"
			sv_a = sv_a + " select to_char(tran_date,'dd-mm-yyyy') tran_date,tran_amt"
			sv_a = sv_a + " from tbaadm.dtd"
			sv_a = sv_a + " where acid = ?SVAR"
			sv_a = sv_a + " AND bank_id = ?SVAR"
			if(CUST.ASSTCLASS.MININTCOLLDATE != "31-12-2099") then
			#{
				sv_a = sv_a + " AND tran_date between to_date('" + CUST.ASSTCLASS.MININTCOLLDATE + "','dd-mm-yyyy') AND to_date('" + BANCS.STDIN.BODDate + "','dd-mm-yyyy')"
				#sv_a = sv_a + " AND tran_date between '" + CUST.ASSTCLASS.MININTCOLLDATE + "' AND '" + BANCS.STDIN.BODDate + "'"
			#}
			endif
			sv_a = sv_a + " AND pstd_flg = 'Y'"
			sv_a = sv_a + " AND del_Flg = 'N'"
			sv_a = sv_a + " AND tran_type = 'T'"
			sv_a = sv_a + " AND tran_sub_type = 'IC'"
			sv_a = sv_a + " AND part_tran_type = 'D'"
			#sv_a = sv_a + " order by tran_date"
			print(sv_a)
			
			#BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MININTCOLLDATE + "|" + BANCS.STDIN.BODDate
			#BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MININTCOLLDATE + "|" + BANCS.STDIN.BODDate
			BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_c = urhk_dbCursorOpenWithBind(sv_a)
			print(sv_c)
			
			if(sv_c != 0) then
			#{
				EXITSCRIPT
			#}
			endif
			
			sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(sv_n)
			
			sv_f = urhk_dbCursorFetch(sv_n)
			print(sv_f)
			
			WHILE(sv_f == 0)
			#{
				CUST.ASSTCLASS.TRANDATE = BANCS.OUTPARAM.TRANDATE
				CUST.ASSTCLASS.TRANAMT = BANCS.OUTPARAM.TRANAMT
				print(CUST.ASSTCLASS.TRANDATE)
				print(CUST.ASSTCLASS.TRANAMT)
				
				CUST.ASSTCLASS.CUMINTBOOKEDAMT = CDOUBLE(CUST.ASSTCLASS.CUMINTBOOKEDAMT) + CDOUBLE(CUST.ASSTCLASS.TRANAMT)
				print(CUST.ASSTCLASS.CUMINTBOOKEDAMT)
				
				if (CDOUBLE(CUST.ASSTCLASS.CUMINTBOOKEDAMT) > CDOUBLE(CUST.ASSTCLASS.TOTDEPOSITAMT)) then
				#{
					BANCS.INPARAM.date1 = BANCS.STDIN.BODDate
					BANCS.INPARAM.date2 = CUST.ASSTCLASS.TRANDATE
					sv_u = urhk_B2K_dateDiff("")
					print(sv_u)
					
					if(sv_u == 0 ) then
					#{
						CUST.ASSTCLASS.DPDCNTR = BANCS.OUTPARAM.dateDiff
						if(CINT(CUST.ASSTCLASS.DPDCNTR) <= 0) then
						#{
							CUST.ASSTCLASS.DPDCNTR= "0"
						#}
						endif
						#}
					else
						#{
						CUST.ASSTCLASS.DPDCNTR = "0"
					#}
					endif
					
					GOTO FINISH
				#}
				endif
				sv_f = urhk_dbCursorFetch(sv_n)
				print(sv_f)
				
			#}
			DO
			
			FINISH:
				sv_c = urhk_dbCursorClose(sv_n)
				print(sv_c)
				
			#}
			endif
		#}
		endif
		if(fieldexists(BANCS.INPUT.foracid)==1)then
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.foracid)
		if(sv_u==0)then
			CUST.ASSTCLASS.sanctionLimit = BANCS.OUTPARAM.sanctionLimit
			CUST.ASSTCLASS.drawingPower = BANCS.OUTPARAM.drawingPower
			CUST.ASSTCLASS.clearBalance = BANCS.OUTPARAM.clearBalance
			CUST.ASSTCLASS.unclearBalance =  BANCS.OUTPARAM.unclearBalance
			CUST.ASSTCLASS.acctSolId =  BANCS.OUTPARAM.acctSolId
		else
			CUST.ASSTCLASS.sanctionLimit = ""
			CUST.ASSTCLASS.drawingPower = ""
			CUST.ASSTCLASS.clearBalance = ""
			CUST.ASSTCLASS.unclearBalance = ""
			CUST.ASSTCLASS.acctSolId =  "" 
		endif
		else
			CUST.ASSTCLASS.acctSolId = ""
		endif
		sv_d = "lmtCnt |  select count(*) from tbaadm.lht where bank_id= ?SVAR and acid= ?SVAR and entity_cre_flg='Y' and STATUS='A' and sol_id=?SVAR and del_flg='N' and lim_exp_date>sysdate "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.ACID + "|" + CUST.ASSTCLASS.acctSolId 
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.ASSTCLASS.lmtCnt = BANCS.OUTPARAM.lmtCnt
		else
			CUST.ASSTCLASS.lmtCnt = 0
		endif
		if(cdouble(CUST.ASSTCLASS.lmtCnt)>=1)then	
			CUST.ASSTCLASS.dpdOnIntOvdu = CINT("0")
			print(CUST.ASSTCLASS.dpdOnIntOvdu)
		else
			CUST.ASSTCLASS.dpdOnIntOvdu = CINT(CUST.ASSTCLASS.DPDCNTR)
			print(CUST.ASSTCLASS.dpdOnIntOvdu)
		endif
		CUST.ASSTCLASS.dpdOnIntOvdu = "0"
END-->
