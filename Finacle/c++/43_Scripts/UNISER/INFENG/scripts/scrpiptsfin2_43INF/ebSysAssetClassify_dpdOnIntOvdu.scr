<--start
	trace on
	sv_u = urhk_B2k_PrintRepos("BANCS")
	
	print(BANCS.INPUT.b2kType)
	print(BANCS.INPUT.b2kId)
	print(BANCS.INPUT.solId)
	print(BANCS.INPUT.foracid)
	
#Initializing the variables
	CUST.ASSTCLASS.DPDCNTR = "0"
	CUST.ASSTCLASS.CUMINTBOOKEDAMT = CDOUBLE("0")
	CUST.ASSTCLASS.INTCOLLDATE = CDOUBLE("0")
	CUST.ASSTCLASS.INTCOLLAMT = CDOUBLE("0")
	CUST.ASSTCLASS.dpdOnIntOvdu = ""
	
#Input Variables
#Acid
	CUST.ASSTCLASS.ACID = BANCS.INPUT.b2kId
	print(CUST.ASSTCLASS.ACID)
	
#Sol BOD DAte
	BANCS.STDIN.BODDate = LEFT$(BANCS.STDIN.BODDate,10)
	print(BANCS.STDIN.BODDate)
	
#Finding the last date the account has gone into credit balance
	#sv_a = "MAXCRBALDATE|select to_date(to_char(max(eod_date),'dd-mm-yyyy'),'dd-mm-yyyy')"
	sv_a = "MAXCRBALDATE|select to_char(max(eod_date),'dd-mm-yyyy')"
	sv_a = sv_a + "	from tbaadm.eab"
	sv_a = sv_a + " where acid = ?SVAR"
	sv_a = sv_a + " AND bank_id = ?SVAR"
	sv_a = sv_a + " AND tran_date_bal >= 0"
	print(sv_a)
	BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	
	if (sv_d == 0) then
		CUST.ASSTCLASS.MAXCRBALDATE = BANCS.OUTPARAM.MAXCRBALDATE
	else
		CUST.ASSTCLASS.MAXCRBALDATE = "31-12-2099"
	endif
	if(CUST.ASSTCLASS.MAXCRBALDATE == "") then
		CUST.ASSTCLASS.MAXCRBALDATE = "31-12-2099"
	endif
	print(CUST.ASSTCLASS.MAXCRBALDATE)
	
#Finding the date the account has first gone into debit balance after the last credit balance
	#sv_a = "MINDRBALDATE|select to_date(to_char(min(eod_date),'dd-mm-yyyy'),'dd-mm-yyyy')"
	sv_a = "MINDRBALDATE|select to_char(min(eod_date),'dd-mm-yyyy')"
	sv_a = sv_a + " from tbaadm.eab"
	sv_a = sv_a + " where acid = ?SVAR"
	sv_a = sv_a + " AND tran_date_bal < 0"
	sv_a = sv_a + " AND bank_id = ?SVAR"
	#sv_a = sv_a + " AND eod_date > to_date(?SVAR,'dd-mm-yyyy')"
	if(CUST.ASSTCLASS.MAXCRBALDATE != "31-12-2099") then
	#{
		sv_a = sv_a + " AND eod_date >= to_date('" + CUST.ASSTCLASS.MAXCRBALDATE + "','dd-mm-yyyy')"
	#}
	endif
	print(sv_a)
	#BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MAXCRBALDATE
	BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	if (sv_d == 0) then
		CUST.ASSTCLASS.MINDRBALDATE = BANCS.OUTPARAM.MINDRBALDATE
		print(CUST.ASSTCLASS.MINDRBALDATE)
	else
		CUST.ASSTCLASS.MINDRBALDATE = "31-12-2099"
		print(CUST.ASSTCLASS.MINDRBALDATE)
	endif
	if(CUST.ASSTCLASS.MINDRBALDATE == "") then
		CUST.ASSTCLASS.MINDRBALDATE = "31-12-2099"
		print(CUST.ASSTCLASS.MINDRBALDATE)
	endif
	print(CUST.ASSTCLASS.MINDRBALDATE)
	
#Finding the minimum interest collection date
	#sv_a = "MININTCOLLDATE|select to_date(to_char(min(tran_date),'dd-mm-yyyy'),'dd-mm-yyyy')"
	sv_a = "MININTCOLLDATE|select to_char(min(tran_date),'dd-mm-yyyy')"
	sv_a = sv_a + " from tbaadm.htd"
	sv_a = sv_a + " where acid = ?SVAR"
	sv_a = sv_a + " AND bank_id = ?SVAR"
	#sv_a = sv_a + " AND tran_date >= to_date(?SVAR,'dd-mm-yyyy')"
	if(CUST.ASSTCLASS.MINDRBALDATE != "31-12-2099") then
		sv_a = sv_a + " AND tran_date >= to_date('" + CUST.ASSTCLASS.MINDRBALDATE + "','dd-mm-yyyy')"
	endif
	sv_a = sv_a + " AND tran_type = 'T'"
	sv_a = sv_a + " AND tran_sub_type = 'IC'"
	sv_a = sv_a + " AND del_flg = 'N'"
	sv_a = sv_a + " AND pstd_flg = 'Y'"
	print(sv_a)
	#BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MINDRBALDATE
	BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
	print(sv_d)
	if (sv_d == 0) then
		CUST.ASSTCLASS.MININTCOLLDATE = BANCS.OUTPARAM.MININTCOLLDATE
	else
		CUST.ASSTCLASS.MININTCOLLDATE = "31-12-2099"
	endif
	if(CUST.ASSTCLASS.MININTCOLLDATE == "") then
		CUST.ASSTCLASS.MININTCOLLDATE = "31-12-2099"
	endif
	print(CUST.ASSTCLASS.MININTCOLLDATE)
	
#Logic starts here
	sv_a = "HTDSUM|select nvl(abs(sum(decode(part_tran_type,'C',tran_amt,-1*tran_amt))),0)"
	sv_a = sv_a + "	from tbaadm.htd"
	sv_a = sv_a + " where acid = ?SVAR"
	sv_a = sv_a + "	AND bank_id = ?SVAR"
	sv_a = sv_a + " AND pstd_flg = 'Y'"
	sv_a = sv_a + " AND del_flg = 'N'"
	sv_a = sv_a + " AND tran_type = 'T'"
	sv_a = sv_a + " AND tran_sub_type = 'IC'"
	if(CUST.ASSTCLASS.MININTCOLLDATE != "31-12-2099") then
	#{
		sv_a = sv_a + " AND tran_date between to_date('" + CUST.ASSTCLASS.MININTCOLLDATE + "','dd-mm-yyyy') AND to_date('" + BANCS.STDIN.BODDate + "','dd-mm-yyyy')"
		#sv_a = sv_a + " AND tran_date between '" + CUST.ASSTCLASS.MININTCOLLDATE + "' AND '" + BANCS.STDIN.BODDate + "'"
	#}
	endif
	print(sv_a)
	#BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.ASSTCLASS.MININTCOLLDATE + "|" + BANCS.STDIN.BODDate
	BANCS.INPARAM.BINDVARS = CUST.ASSTCLASS.ACID + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_a)
