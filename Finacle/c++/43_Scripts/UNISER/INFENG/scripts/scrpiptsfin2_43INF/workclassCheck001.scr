<--START
TRACE ON

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
        #{
                CREATECLASS("CUST", "DATA", 5)
        #}
        ENDIF

	CUST.DATA.workClass = " "
	CUST.DATA.paramValue = " "
	
	#CUST.DATA.workClass = TOUPPER(BANCS.INPUT.workClass)
	#PRINT(CUST.DATA.workClass)
	sv_s = "workClass|SELECT USER_WORK_CLASS FROM TBAADM.UPR WHERE USER_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId

	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	IF(sv_d == ")")THEN
	#{
		CUST.DATA.workClass = BANCS.OUTPARAM.workClass
		PRINT(CUST.DATA.workClass)
	#}
	ELSE
	#{
		CUST.DATA.errMsg = " "
		sv_u = urhk_SetOrbOut("errFlg|N")
                sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
                sv_u = urhk_SetOrbOut("wrkclsFlg|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	CUST.DATA.parameterId="ERR_CRCTN_WORK_CLASS"
	CUST.DATA.moduleName="OT"
	
        sv_g = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER"
        sv_g = sv_g + " WHERE "
        sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
        sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
        sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
        sv_g = sv_g + " C_CPVALUE.del_flg != 'Y' AND "
        sv_g = sv_g + " C_CPVALUE.entity_cre_flg = 'Y' AND "
        sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
        sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
        sv_g = sv_g + " C_CPVALUE.parameter_id = ?SVAR"
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.moduleName + "|" + CUST.DATA.parameterId
        sv_d = urhk_dbSelectWithBind(sv_g)
        print(sv_d)

        IF(sv_d == 0) THEN
        #{
                print(BANCS.OUTPARAM.parameterVal)
		CUST.DATA.paramValue = BANCS.OUTPARAM.parameterVal
		PRINT(CUST.DATA.paramValue)
	#}
	ELSE
	#{
		CUST.DATA.errMsg = "Work Class Details not maintained in CPARAM"
		sv_u = urhk_SetOrbOut("errFlg|Y")
		sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
		sv_u = urhk_SetOrbOut("wrkclsFlg|N")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_p = GETPOSITION(CUST.DATA.paramValue,CUST.DATA.workClass)
	IF(sv_p > 0)THEN
	#{
		CUST.DATA.errMsg = " "
                sv_u = urhk_SetOrbOut("errFlg|N")
                sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
                sv_u = urhk_SetOrbOut("wrkclsFlg|Y")
                GOTO ENDOFSCRIPT
	#}
        ELSE
        #{
                CUST.DATA.errMsg = " "
                sv_u = urhk_SetOrbOut("errFlg|N")
                sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
                sv_u = urhk_SetOrbOut("wrkclsFlg|N")
                GOTO ENDOFSCRIPT
        #}
        ENDIF



ENDOFSCRIPT:
TRACE OFF
END-->

