<--START
	
	TRACE ON
	
	sv_a = REPEXISTS("CUST")
	IF(sv_a == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.acctNum = " "
	CUST.DATA.errorFlg = "N"
	CUST.DATA.errorMsg = " "
	CUST.DATA.recCount = "0"
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		IF(BANCS.INPUT.acctNum !="")THEN
		#{
			CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
		#}
		ELSE
		#{
        		CUST.DATA.errorFlg = "N"
        		CUST.DATA.errorMsg = " "
			GOTO ENDOFSCRIPT
		#}	
		ENDIF
		
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "recCount|SELECT COUNT(1) FROM TBAADM.SMT WHERE BANK_ID=?SVAR AND ACID =(SELECT OP_ACID FROM TBAADM.LAM,TBAADM.GAM WHERE GAM.BANK_ID=?SVAR AND "
	sv_s = sv_s + "LAM.BANK_ID=GAM.BANK_ID AND GAM.FORACID=?SVAR AND LAM.ACID=GAM.ACID AND GAM.ACCT_CLS_FLG='N' AND GAM.ENTITY_CRE_FLG='Y') AND ACCT_STATUS !='A'"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.acctNum
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "DB error,Please contact DBA"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.DATA.recCount = BANCS.OUTPARAM.recCount
	#}
	ENDIF
	
	IF(CUST.DATA.recCount != "0")THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "Operative account is not active,"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
		
	sv_s = "frezCode|SELECT FREZ_CODE FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND ACID=(SELECT OP_ACID FROM TBAADM.GAM,TBAADM.LAM WHERE FORACID=?SVAR AND "
	sv_s = sv_s + "GAM.BANK_ID = ?SVAR AND LAM.BANK_ID=GAM.BANK_ID AND LAM.ACID=GAM.ACID)"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.acctNum  + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.DATA.frezCode = BANCS.OUTPARAM.frezCode
		PRINT(CUST.DATA.frezCode)
	#}
	ENDIF
	
	IF(TRIM(CUST.DATA.frezCode) == "D")THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "Operative account is having the Debit FREEZE on it,"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF(TRIM(CUST.DATA.frezCode) == "T")THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "Operative account is having the Total FREEZE on it,"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF(TRIM(CUST.DATA.frezCode) == "C")THEN
	#{
		CUST.DATA.errorFlg = "Y"
		CUST.DATA.errorMsg = "Operative account is having the Credit FREEZE on it,"
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	ENDOFSCRIPT:
	sv_a = urhk_SetOrbOut("errorFlg|"+CUST.DATA.errorFlg)
	sv_a = urhk_SetOrbOut("errorMsg|"+CUST.DATA.errorMsg)
		
	TRACE OFF
END-->
