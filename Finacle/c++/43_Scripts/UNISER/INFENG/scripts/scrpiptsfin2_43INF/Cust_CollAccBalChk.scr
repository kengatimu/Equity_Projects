<--START
CHECKSUM="9a728a933ce0f27a4234897818e5813fb484c9b12f3736110202663bc6c006f1"
	TRACE ON
	
	#sv_a = urhk_B2K_printRepos("BANCS")
	
	#-----------------------------------------------------------------------------------------------
	# Creating Repositories and classes
	#-----------------------------------------------------------------------------------------------
	sv_u = REPEXISTS("CUST")
	IF (sv_u == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_u = CLASSEXISTS("CUST", "DATA")
	IF (sv_u == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	
	CUST.DATA.errorMsg = ""
	
	
	#-------------------------------------------------------------------------------------------------
	# Getting netPayOffAmtAdj
	#-------------------------------------------------------------------------------------------------
	sv_b = urhk_SRV_GetVal("payOffDtl.netPayOffAmtAdj")
	print(sv_b)
	IF (sv_b == 0) THEN
	#{
		CUST.DATA.netPayOffAmtAdj	= BANCS.OUTPARAM.srvValue
		print(CUST.DATA.netPayOffAmtAdj)
		
		#Removing the '|KES' from the result obtained
		
		CUST.DATA.Pos = GETPOSITION(CUST.DATA.netPayOffAmtAdj, "|")
		print(CUST.DATA.Pos)
		
		CUST.DATA.netPayOffAmtAdj = MID$(CUST.DATA.netPayOffAmtAdj, 0, CINT(CUST.DATA.Pos)-1)
		print(CUST.DATA.netPayOffAmtAdj)
		
		#}
	ELSE
		#{
		CUST.DATA.errorMsg = "Error in getting value of netPayOffAmtAdj"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	#get foracid from front end
	sv_b = urhk_SRV_GetVal("payOffCrit.collAcct.foracid")
	print(sv_b)
	IF (sv_b == 0) THEN
	#{
		CUST.DATA.foracid	= BANCS.OUTPARAM.srvValue
		print(CUST.DATA.foracid)
		#}
	ELSE
		#{
		CUST.DATA.errorMsg = "Error in getting value of foracid"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------
	# getting Collection acct balance.
	#-------------------------------------------------------------------------------------------------
	#BANCS.INPARAM.acctId = CUST.DATA.foracid
	#BANCS.INPARAM.asOnDate = BANCS.STDIN.BODDate
	#sv_a = urhk_getAcctBalanceAsOnDate("")
	
	
	BANCS.INPARAM.InBuff = CUST.DATA.foracid
	sv_a = urhk_getFullAvailAmtForAcct(BANCS.INPARAM.InBuff)
	#BANCS.OUTPARAM.FFDAvailableAmt
	
	IF (sv_a == 0) THEN
	#{
		#CUST.DATA.collAcctBal = BANCS.OUTPARAM.acctBal
		CUST.DATA.collAcctBal = BANCS.OUTPARAM.FullAvailableAmt
		print(CUST.DATA.collAcctBal)
		#}
	ELSE
		#{
		CUST.DATA.errorMsg = "Error in getting value of collAcctBal"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------
	# validating the account balance of the collecting account.
	#-------------------------------------------------------------------------------------------------
	
	IF ((cdouble(CUST.DATA.collAcctBal) < cdouble(CUST.DATA.netPayOffAmtAdj)) AND (cdouble(CUST.DATA.netPayOffAmtAdj)) > 0) THEN
	#{
		CUST.DATA.errorMsg = "Balance of the Collecting account is less than the net Payoff amount"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------
	
	
	ENDOFSCRIPT:
		IF(CUST.DATA.errorMsg != "") THEN
		#{
			print(CUST.DATA.errorMsg)
			#sv_u = urhk_SRV_SetErr(CUST.DATA.errorMsg)
			#sv_u = urhk_SetOrbOut(CUST.DATA.errorMsg)
		#}
		ENDIF
		#exitscript
END-->
