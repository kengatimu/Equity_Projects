			#}
			ENDIF
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.dmgCrncy))THEN
		#{
			IF(TRIM(BANCS.INPUT.dmgCrncy) != "")THEN
			#{
				EQT.CSH.dmgCrncy = TOUPPER(TRIM(BANCS.INPUT.dmgCrncy))
				PRINT(EQT.CSH.dmgCrncy)
				#}
			ELSE
				#{
				EQT.CSH.errorFlg ="Y"
				EQT.CSH.Msg ="Damaged Amount Currency not Passed!"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		IF(EQT.CSH.isAuto == "Y")THEN
		#{
			GOTO SKIP_FTCH_ACCT
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.dmgRateCode))THEN
		#{
			IF(TRIM(BANCS.INPUT.dmgRateCode) != "")THEN
			#{
				EQT.CSH.dmgRateCode = TOUPPER(TRIM(BANCS.INPUT.dmgRateCode))
				PRINT(EQT.CSH.dmgRateCode)
			#}
			ENDIF
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.dmgRate))THEN
		#{
			IF(TRIM(BANCS.INPUT.dmgRate) != "")THEN
			#{
				EQT.CSH.dmgRate = TRIM(BANCS.INPUT.dmgRate)
				PRINT(EQT.CSH.dmgRate)
			#}
			ENDIF
		#}
		ENDIF
		
		print(BANCS.STDIN.homeCrncyCode)
		IF(BANCS.STDIN.homeCrncyCode!=EQT.CSH.dmgCrncy)THEN
		#{
			IF(EQT.CSH.dmgRateCode == "")THEN
			#{
				EQT.CSH.errorFlg ="Y"
				EQT.CSH.Msg ="Rate Code not Passed!"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			IF(EQT.CSH.dmgRate == "")THEN
			#{
				EQT.CSH.errorFlg ="Y"
				EQT.CSH.Msg ="Rate not Passed for the Rate Code: "+EQT.CSH.dmgRateCode
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		endif
		
	LABEL_1:
		IF(EQT.CSH.isAuto == "Y")THEN
		#{
			GOTO SKIP_FTCH_ACCT
		#}
		ENDIF
		
		BANCS.INPUT.acctType = "COMMISSION"
		CALL("fetchAcctForComm.scr")
		
		IF(EQT.COMM.errorFlg == "Y")THEN
		#{
			EQT.CSH.errorFlg ="Y"
			EQT.CSH.Msg =EQT.COMM.errorMsg
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			PRINT(EQT.COMM.crAcctNum)
			EQT.CSH.commAcct = EQT.COMM.crAcctNum
		#}
		endif
		
		BANCS.INPUT.acctType = "TAX"
		CALL("fetchAcctForComm.scr")
		
		IF(EQT.COMM.errorFlg == "Y")THEN
		#{
			EQT.CSH.errorFlg ="Y"
			EQT.CSH.Msg =EQT.COMM.errorMsg
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			PRINT(EQT.COMM.crAcctNum)
			EQT.CSH.vatAcct = EQT.COMM.crAcctNum
		#}
		endif
		
	SKIP_FTCH_ACCT:
		
		IF(EQT.CSH.calcReq == "N")THEN
		#{
			EQT.CSH.chrgPrcnt = "0"
			EQT.CSH.vatPrcnt = "0"
			EQT.COMM.chrgAmt = EQT.CSH.dmgChrgAmt
			EQT.COMM.vatAmt = EQT.CSH.dmgVATAmt
			GOTO SKIP_CPARAM
		#}
		ENDIF
		
		BANCS.INPUT.parameterId = "COMM_CHARGE_PERCENT"
		BANCS.INPUT.moduleName = "OT"
		
		PRINT(BANCS.STDIN.contextBankId)
		PRINT(BANCS.INPUT.moduleName)
		PRINT(BANCS.INPUT.parameterId)
		
		sv_g = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER"
		sv_g = sv_g + " WHERE "
		sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
		sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
		sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
		sv_g = sv_g + " C_CPVALUE.del_flg != 'Y' AND "
		sv_g = sv_g + " C_CPVALUE.entity_cre_flg = 'Y' AND "
		sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
		sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
		sv_g = sv_g + " C_CPVALUE.parameter_id = ?SVAR"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.moduleName + "|" + BANCS.INPUT.parameterId
		sv_d = urhk_dbSelectWithBind(sv_g)
		PRINT(sv_d)
		
		IF(sv_d == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.parameterVal)
			EQT.CSH.chrgPrcnt = BANCS.OUTPARAM.parameterVal
			#}
		ELSE
			#{
			EQT.CSH.errorFlg = "Y"
			EQT.CSH.Msg = "Charge Percent is not maintained in CPARAM for Parameter Id: "+BANCS.INPUT.parameterId
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(TRIM(BANCS.OUTPARAM.parameterVal)=="")THEN
		#{
			EQT.CSH.errorFlg = "Y"
			EQT.CSH.Msg = "Charge Percent is not maintained in CPARAM for Parameter Id: "+BANCS.INPUT.parameterId
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		BANCS.INPUT.parameterId = "COMM_VAT_PERCENT"
		BANCS.INPUT.moduleName = "OT"
		
		PRINT(BANCS.STDIN.contextBankId)
		PRINT(BANCS.INPUT.moduleName)
		PRINT(BANCS.INPUT.parameterId)
		
		sv_g = "parameterVal|SELECT parameter_value FROM CUSTOM.C_CPVALUE , CUSTOM.C_CPMASTER"
		sv_g = sv_g + " WHERE "
		sv_g = sv_g + " C_CPMASTER.bank_id = C_CPVALUE.bank_id  AND "
		sv_g = sv_g + " C_CPMASTER.module_name = C_CPVALUE.module_name  AND "
		sv_g = sv_g + " C_CPMASTER.parameter_id = C_CPVALUE.parameter_id AND "
		sv_g = sv_g + " C_CPVALUE.del_flg != 'Y' AND "
		sv_g = sv_g + " C_CPVALUE.entity_cre_flg = 'Y' AND "
		sv_g = sv_g + " C_CPMASTER.bank_id = ?SVAR AND "
		sv_g = sv_g + " C_CPMASTER.module_name = ?SVAR AND "
		sv_g = sv_g + " C_CPVALUE.parameter_id = ?SVAR"
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.moduleName + "|" + BANCS.INPUT.parameterId
		sv_d = urhk_dbSelectWithBind(sv_g)
		PRINT(sv_d)
		
		IF(sv_d == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.parameterVal)
			EQT.CSH.vatPrcnt = BANCS.OUTPARAM.parameterVal
			#}
		ELSE
			#{
			EQT.CSH.errorFlg = "Y"
			EQT.CSH.Msg = "VAT Percent is not maintained in CPARAM for Parameter Id: "+BANCS.INPUT.parameterId
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(TRIM(BANCS.OUTPARAM.parameterVal)=="")THEN
		#{
			EQT.CSH.errorFlg = "Y"
			EQT.CSH.Msg = "VAT Percent is not maintained in CPARAM for Parameter Id: "+BANCS.INPUT.parameterId
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_c = CDOUBLE(EQT.CSH.dmgAmt)*CDOUBLE(EQT.CSH.chrgPrcnt)*(0.01)
		print(sv_c)
		EQT.COMM.chrgAmt = sv_c
		BANCS.INPARAM.RoundOffAmt = CDOUBLE("0.01")
		BANCS.INPARAM.InputAmount= sv_c
		BANCS.INPARAM.RoundOffFlag="H"
		sv_r=urhk_B2k_RoundOff("")
		print(sv_r)
		
		IF(sv_r==0)THEN
		#{
			sv_p = BANCS.OUTPARAM.OutputAmount
			PRINT(sv_p)
			EQT.COMM.chrgAmt = sv_p
			sv_q = 0
			sv_q = GETPOSITION(sv_p,".")
			PRINT(sv_q)
			
			IF(sv_q > 0)THEN
			#{
				EQT.COMM.chrgAmt  = MID$(sv_p,0,sv_q-1)
				PRINT(EQT.COMM.chrgAmt)
				EQT.COMM.chrgAmt = EQT.COMM.chrgAmt + "." + MID$(sv_p,sv_q,2)
				PRINT(EQT.COMM.chrgAmt)
			#}
			ENDIF
		#}
		ENDIF
		
		sv_t = sv_c * CDOUBLE(EQT.CSH.vatPrcnt) *(0.01)
		print(sv_t)
		EQT.COMM.vatAmt = sv_t
		BANCS.INPARAM.RoundOffAmt = CDOUBLE("0.01")
		BANCS.INPARAM.InputAmount= sv_t
		BANCS.INPARAM.RoundOffFlag="H"
		sv_r=urhk_B2k_RoundOff("")
		print(sv_r)
		
		IF(sv_r==0)THEN
		#{
			sv_p = BANCS.OUTPARAM.OutputAmount
			PRINT(sv_p)
			EQT.COMM.vatAmt = sv_p
			sv_q = 0
			sv_q = GETPOSITION(sv_p,".")
			PRINT(sv_q)
			
			IF(sv_q > 0)THEN
			#{
				EQT.COMM.vatAmt  = MID$(sv_p,0,sv_q-1)
				PRINT(EQT.COMM.vatAmt)
				EQT.COMM.vatAmt = EQT.COMM.vatAmt + "." + MID$(sv_p,sv_q,2)
				PRINT(EQT.COMM.vatAmt)
			#}
			ENDIF
		#}
		endif
		
		EQT.COMM.totChrg = CDOUBLE(EQT.COMM.chrgAmt) + CDOUBLE(EQT.COMM.vatAmt)
		PRINT(EQT.COMM.totChrg)
		
		sv_p = EQT.COMM.totChrg
		PRINT(sv_p)
		EQT.COMM.totChrg = sv_p
		sv_q = 0
		sv_q = GETPOSITION(sv_p,",")
		PRINT(sv_q)
		
		IF(sv_q > 0)THEN
		#{
			EQT.COMM.totChrg  = MID$(sv_p,0,sv_q-1)
			PRINT(EQT.COMM.totChrg)
			EQT.COMM.totChrg = EQT.COMM.totChrg + "." + MID$(sv_p,sv_q,2)
			PRINT(EQT.COMM.totChrg)
		#}
		ENDIF
		
	SKIP_CPARAM:
		
		IF((EQT.CSH.isDummy == "Y") AND (EQT.CSH.isAuto == "N"))THEN
		#{
			EQT.CSH.Msg = " "
			#			EQT.CSH.Msg = "For the damaged amount, a charge of "+ EQT.CSH.dmgCrncy + " " + EQT.COMM.chrgAmt
			#			EQT.CSH.Msg = EQT.CSH.Msg + " and VAT of " + EQT.CSH.dmgCrncy + " " +  EQT.COMM.vatAmt +" making a total charge of "+ EQT.CSH.dmgCrncy + " " + EQT.COMM.totChrg + " will be applicable."
			#			EQT.CSH.Msg = EQT.CSH.Msg + " Do you want to continue? Click Ok to Continue with the charge and Cancel to terminate the transaction."
			GOTO SKIP_TRAN_INSERT
		#}
		ENDIF
		
		IF(EQT.CSH.isAuto == "Y") THEN
		#{
			EQT.CSH.Msg = EQT.COMM.chrgAmt + "-" +(EQT.COMM.vatAmt)
			print(EQT.CSH.Msg)
			GOTO SKIP_TRAN_INSERT
		#}
		ENDIF
		
		sv_s = "Insert into CUSTOM.C_DNTD (TRAN_ID, TRAN_DATE, TRAN_TYPE, TRAN_SUB_TYPE, INIT_SOL_ID, CRNCY_CODE, DMG_NOTE_AMT, CHARGE_AMT,"
		sv_s = sv_s + " VAT_AMT, ACCT_ID, COMM_ACCT_ID, VAT_ACCT_ID, RATE_CODE, RATE, RCRE_USER_ID, RCRE_TIME, BANK_ID, TRAN_STATUS) Values ("
		sv_s = sv_s + " ?SVAR, TO_DATE(?SVAR,'DD-MM-YYYY'), ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, "
		sv_s = sv_s + " ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR, SYSDATE, ?SVAR, 'E' )"
		
		print(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.cTranId + "|" +  MID$(BANCS.INPUT.cTranDate,0,10) + "|" + BANCS.INPUT.tType + "|" + BANCS.INPUT.tSubType + "|" + BANCS.STDIN.mySolId
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQT.CSH.dmgCrncy + "|" + EQT.CSH.dmgAmt + "|" + EQT.COMM.chrgAmt
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQT.COMM.vatAmt + "|" + EQT.CSH.acctId + "|" + EQT.CSH.commAcct + "|" + EQT.CSH.vatAcct  + "|" + EQT.CSH.dmgRateCode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + EQT.CSH.dmgRate + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d != 0) THEN
		#{
			EQT.CSH.errorFlg = "Y"
			EQT.CSH.Msg = "Error in Saving Damage Note details in DB!!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
	SKIP_TRAN_INSERT:
		
	ENDOFSCRIPT:
		sv_u = urhk_SetOrbOut("errFlg|" + EQT.CSH.errorFlg)
		sv_u = urhk_SetOrbOut("message|" + EQT.CSH.Msg)
		
		DELETECLASS("EQT","CSH")
		sv_a = CLASSEXISTS("EQT", "COMM")
		IF (sv_a != 0 ) THEN
		#{
			DELETECLASS("EQT","COMM")
		#}
		ENDIF
		DELETEREP("EQT")
END-->
