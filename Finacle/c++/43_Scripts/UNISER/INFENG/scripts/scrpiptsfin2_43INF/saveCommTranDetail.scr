			PRINT(EQT.CSH.dmgChrgAmt)
			EQT.CSH.calcReq = "N"
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.dmgVATAmt))THEN
