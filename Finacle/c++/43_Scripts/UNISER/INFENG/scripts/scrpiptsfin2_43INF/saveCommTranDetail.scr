				CALL("modifyCommTran.scr")
				GOTO ENDOFSCRIPT
			#}
			endif
		#}
		ENDIF
	#}
	ENDIF
	
	IF(EQT.CSH.isDummy == "Y")THEN
	#{
		GOTO SKIP_TRAN_INQ
	#}
	endif
	
	sv_s = "recCount|select nvl(max(tran_sub_type),0) from tbaadm.dtd where tran_id=?SVAR and tran_date=TO_DATE(?SVAR,'DD-MM-YYYY') and  pstd_flg!='Y' and bank_id=?SVAR "
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.cTranId + "|" +  MID$(BANCS.INPUT.cTranDate,0,10) + "|" + BANCS.STDIN.contextBankId
	
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		EQT.CSH.errorFlg ="Y"
		EQT.CSH.Msg ="Error in Database Operation!!"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		print(BANCS.OUTPARAM.recCount)
		EQT.CSH.recCount = BANCS.OUTPARAM.recCount
	#}
	ENDIF
	
	IF((EQT.CSH.recCount== "RI") OR (EQT.CSH.recCount == "CR"))THEN
	#{
		sv_s = "account|select foracid from tbaadm.gam where acid in (select acid from tbaadm.dtd where tran_id =?SVAR and tran_date=TO_DATE(?SVAR,'DD-MM-YYYY') "
		sv_s = sv_s + "	and bank_id =?SVAR and PART_TRAN_TYPE ='C' and rownum =1  ) and bank_id=?SVAR and acct_ownership !='O' "
		
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.cTranId + "|" +  MID$(BANCS.INPUT.cTranDate,0,10) + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d == 0)THEN
		#{
			print(BANCS.OUTPARAM.account)
			IF(TRIM(BANCS.OUTPARAM.account)!="")THEN
			#{
				EQT.CSH.acctId = BANCS.OUTPARAM.account
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	SKIP_TRAN_INQ:
		
		IF(FIELDEXISTS(BANCS.INPUT.dmgAmt))THEN
		#{
			IF(TRIM(BANCS.INPUT.dmgAmt) != "")THEN
			#{
				EQT.CSH.dmgAmt = TRIM(BANCS.INPUT.dmgAmt)
				PRINT(EQT.CSH.dmgAmt)
				IF(CDOUBLE(EQT.CSH.dmgAmt)==0)THEN
				#{
					EQT.CSH.dmgCrncy=""
					EQT.CSH.dmgRateCode =""
					EQT.CSH.dmgRate=""
					EQT.CSH.isZero = "Y"
