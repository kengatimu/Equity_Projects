<--START
#called from calcChrgAndVAT.scr
	# Script body goes here
	TRACE ON
	sv_a = urhk_B2k_PrintRepos("BANCS")
	print(sv_a)
	sv_a = urhk_B2k_PrintRepos("CHRG")
	print(sv_a)
	
	#
	sv_s = "amtInd, amtPrct, fxdAmt, minInd, minAmt, minAmtCrncy, maxInd, maxAmt, maxAmtCrncy |"
    sv_s = sv_s + " select CHARGE_TYPE,PRCNT,CHRG_AMT,'N',MIN_AMT,CRNCY_CODE,'N',MAX_AMT,CRNCY_CODE,
	sv_s = sv_s + " from custom.custom_ccprm where bank_id= ?SVAR and event_id = ?SVAR "
	sv_s = sv_s + " and schm_code =?SVAR  and CRNCY_CODE =?SVAR "
	sv_s = sv_s + " and DEL_FLG = 'N' and ENTITY_CRE_FLG= 'Y' and srl_num=?SVAR   and =rownum=1 "
	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" +  CHRG.TXN.eventId + "|" + CHRG.TXN.schmCode+ "|" + CHRG.TXN.evntChrgCrncy + "|" + CHRG.TXN.srl_num
	print(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbselectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r != 0) THEN
	#{
	
	CHRG.TXN.chrgAmt=0
	CHRG.TXN.evntChrgCrncy=""
	
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	

		IF(BANCS.OUTPARAM.amtInd == "F")THEN
		#{
			CHRG.TXN.chrgAmt =  CDOUBLE(CHRG.TXN.chrgAmt) +  CDOUBLE(BANCS.OUTPARAM.fxdAmt)
			CHRG.TXN.evntChrgCrncy = BANCS.OUTPARAM.maxAmtCrncy
		#}
		ENDIF
		
		IF(BANCS.OUTPARAM.amtInd == "P")THEN
		#{
			print(BANCS.OUTPARAM.amtPrct)
			CHRG.TXN.temp = (CDOUBLE(CHRG.TXN.refAmt) * CDOUBLE(BANCS.OUTPARAM.amtPrct)) / 100
			
			IF((BANCS.OUTPARAM.minInd == "Y") AND (BANCS.OUTPARAM.minAmt != ""))THEN
			#{
				IF(CHRG.TXN.temp < BANCS.OUTPARAM.minAmt)THEN
				#{
					CHRG.TXN.temp = BANCS.OUTPARAM.minAmt
				#}
				ENDIF
			#}
			ENDIF
			
			IF(CHRG.TXN.temp >BANCS.OUTPARAM.maxAmt) THEN
			#{
				CHRG.TXN.temp = BANCS.OUTPARAM.maxAmt
			#}
			ENDIF
			
			CHRG.TXN.chrgAmt = CDOUBLE(CHRG.TXN.chrgAmt) + CDOUBLE(CHRG.TXN.temp)
			print(CHRG.TXN.chrgAmt)
			CHRG.TXN.evntChrgCrncy = BANCS.OUTPARAM.maxAmtCrncy
		#}
		ENDIF

			ENDOFSCRIPT:
	
END-->
		