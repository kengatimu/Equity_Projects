<--START
TRACE ON

	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST","CHRG")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CHRG",5)
	#}
	ENDIF

	sv_s = "instrNum,instrType,acctId|SELECT INSTR_NUM,INSTR_TYPE,ACCTID FROM CUSTOM.CHRG_TEMP_TBL WHERE BANK_ID=?SVAR AND USER_ID=?SVAR AND "
	sv_s = sv_s + "TO_DATE(RCRE_TIME,'DD-MM-YY')=TO_DATE(sysdate,'DD-MM-YY')"
	BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)
        sv_b=urhk_dbSelectWithBind(sv_s)
        PRINT(sv_b)
        IF (sv_b == 0) THEN
        #{
                CUST.CHRG.acctId=BANCS.OUTPARAM.acctId
                CUST.CHRG.instrNum=TRIM(BANCS.OUTPARAM.instrNum)
                CUST.CHRG.instrType=TRIM(BANCS.OUTPARAM.instrType)
	#}
	ENDIF

	PRINT(CUST.CHRG.acctId)
	PRINT(CUST.CHRG.instrNum)
	PRINT(CUST.CHRG.instrType)

	CUST.CHRG.chrgAmt="0"
	CUST.CHRG.vatAmt="0"
	CUST.CHRG.totalAmt="0"
	CUST.CHRG.chrgFlg = "Y"
	CUST.CHRG.chrgMsg = " "

	sv_s = "chrgAmt,vatAmt,totalAmt,chrgCrncy|SELECT CHARGE_AMT,VAT_AMT,TOTAL_CHARGE_AMT,CHARGE_CRNCY_CODE FROM CUSTOM.C_CHARGE_COLLECTION WHERE ACCT_NUM=?SVAR AND"
	sv_s = sv_s + " CHARGE_TYPE='REJCHRG' AND INSTR_NUM=?SVAR AND INSTR_TYPE=?SVAR AND TO_DATE(RCRE_TIME,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY') AND BANK_ID=?SVAR"
	sv_s = sv_s + " AND SRL_NUM = (SELECT MAX(SRL_NUM) FROM CUSTOM.C_CHARGE_COLLECTION WHERE ACCT_NUM=?SVAR AND"
        sv_s = sv_s + " CHARGE_TYPE='REJCHRG' AND INSTR_NUM=?SVAR AND INSTR_TYPE=?SVAR AND TO_DATE(RCRE_TIME,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY') AND BANK_ID=?SVAR)"
	BANCS.INPARAM.BINDVARS=CUST.CHRG.acctId+ "|" +CUST.CHRG.instrNum+ "|" +CUST.CHRG.instrType+ "|" +MID$(BANCS.STDIN.BODDate,0,10)+ "|" +BANCS.STDIN.contextBankId 
	BANCS.INPARAM.BINDVARS=BANCS.INPARAM.BINDVARS + "|" + CUST.CHRG.acctId+ "|" +CUST.CHRG.instrNum+ "|" +CUST.CHRG.instrType+ "|" +MID$(BANCS.STDIN.BODDate,0,10)+ "|" +BANCS.STDIN.contextBankId 

	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_b=urhk_dbSelectWithBind(sv_s)
	PRINT(sv_b)
	IF (sv_b == 0) THEN
	#{
		CUST.CHRG.chrgAmt=BANCS.OUTPARAM.chrgAmt
		CUST.CHRG.vatAmt=BANCS.OUTPARAM.vatAmt
		CUST.CHRG.totalAmt=BANCS.OUTPARAM.totalAmt
		CUST.CHRG.chrgCrncy=BANCS.OUTPARAM.chrgCrncy
		
		PRINT(CUST.CHRG.chrgAmt)
		PRINT(CUST.CHRG.vatAmt)
		PRINT(CUST.CHRG.totalAmt)
		PRINT(CUST.CHRG.chrgCrncy)
		CUST.CHRG.chrgFlg = "N"
		CUST.CHRG.chrgMsg = "Charge Amount of: "+CUST.CHRG.chrgAmt+CUST.CHRG.chrgCrncy+" and VAT amount of: "+CUST.CHRG.vatAmt+CUST.CHRG.chrgCrncy+" will be "
		CUST.CHRG.chrgMsg = CUST.CHRG.chrgMsg + "collected during Delayed Charge collection batch job as Customer account not having sufficient balance"

		sv_s = "DELETE FROM CUSTOM.CHRG_TEMP_TBL WHERE BANK_ID=?SVAR AND USER_ID=?SVAR AND TO_DATE(RCRE_TIME,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY')"
		BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId + "|" + MID$(BANCS.STDIN.BODDate,0,10)
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
                PRINT(sv_d)
                IF (sv_d == 0) THEN
                #{
			sv_q = urhk_dbSQLWithBind("COMMIT")
                #}
                ENDIF

	#}
	ENDIF

	sv_u=urhk_SetOrbOut("chrgFlg|"+CUST.CHRG.chrgFlg)
	PRINT(sv_u)
	sv_u=urhk_SetOrbOut("chrgMsg|"+CUST.CHRG.chrgMsg)
	PRINT(sv_u)
TRACE OFF
END-->
