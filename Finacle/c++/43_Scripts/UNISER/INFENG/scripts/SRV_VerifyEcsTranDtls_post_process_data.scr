<--START
CHECKSUM="b33b3dbabf993c35c900ab77d84fa68a5d9e66dac0b25fed2375b159c2eee4b9"
	TRACE ON
	
	sv_r = urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_r)

IF (BANCS.STDIN.contextBankId=="43") THEN
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	IF (CLASSEXISTS("CUST","GETDATADRC") == 0) THEN
	#{
		CREATECLASS ("CUST","GETDATADRC",5)
	#}
	ENDIF
	IF (BANCS.STDIN.menuId == "HOTCE") THEN
		IF (FIELDEXISTS(BANCS.INPUT.partTranType) == 1) THEN
			##########
			IF (FIELDEXISTS(BANCS.INPUT.tranParticular) == 1) THEN
				print(BANCS.INPUT.tranParticular)
				######
				sv_h = mid$(BANCS.STDIN.BODDate,0,10)
				sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
				BANCS.INPARAM.BINDVARS =  sv_h
				sv_d = urhk_dbSelectWithBind(sv_s)
				##print(sv_d)
				IF (sv_d =="0") THEN
					CUST.GETDATADRC.getboddate = BANCS.OUTPARAM.getboddate
					print(CUST.GETDATADRC.getboddate)
				ENDIF
				CUST.GETDATADRC.TranIdeft =  trim(BANCS.INPUT.TranId)
				print(CUST.GETDATADRC.TranIdeft)
				sv_s = "dest_cust_nameeft,tran_rmkseft,dest_cust_accteft,ecs_tran_ref_noeft|select DEST_CUST_NAME,TRAN_RMKS,DEST_CUST_ACCT,ECS_TRAN_REF_NO from  TBAADM.otc WHERE TRAN_ID = LPAD(?SVAR,9)  "
				sv_s = sv_s + " AND TRAN_DATE = ?SVAR "
				sv_s = sv_s + " AND BANK_ID = ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.GETDATADRC.TranIdeft + "|" + CUST.GETDATADRC.getboddate
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)
				sv_w = urhk_dbSelectWithBind(sv_s)
				print(sv_w)
				IF (sv_w == 0) THEN
					CUST.GETDATADRC.dest_cust_nameeft = BANCS.OUTPARAM.dest_cust_nameeft
					print(BANCS.OUTPARAM.dest_cust_nameeft)
					CUST.GETDATADRC.tran_rmkseft = BANCS.OUTPARAM.tran_rmkseft
					print(BANCS.OUTPARAM.tran_rmkseft)
					CUST.GETDATADRC.dest_cust_accteft = BANCS.OUTPARAM.dest_cust_accteft
					print(BANCS.OUTPARAM.dest_cust_accteft)
					CUST.GETDATADRC.ecs_tran_ref_noeft = BANCS.OUTPARAM.ecs_tran_ref_noeft
					print(BANCS.OUTPARAM.ecs_tran_ref_noeft)
					IF (CUST.GETDATADRC.tran_rmkseft!="0") THEN
					######
						CUST.GETDATADRC.SISrlNum = ""
						IF (FIELDEXISTS(BANCS.INPUT.SISrlNum) == 1) THEN
							CUST.GETDATADRC.SISrlNum = BANCS.INPUT.SISrlNum
							print(CUST.GETDATADRC.SISrlNum)
						ELSE
							CUST.GETDATADRC.SISrlNum = ""
							print(CUST.GETDATADRC.SISrlNum)
						ENDIF
						#####
							IF (BANCS.INPUT.partTranType=="D") THEN
								print(BANCS.INPUT.partTranType)
								sv_k ="EFT "
								sv_c = CUST.GETDATADRC.dest_cust_nameeft 
								BANCS.INPUT.tranParticular = sv_k + "/" + sv_c + "/" + CUST.GETDATADRC.tran_rmkseft 
								print(BANCS.INPUT.tranParticular)
								BANCS.INPUT.tranParticular2 = CUST.GETDATADRC.dest_cust_accteft 
								print(BANCS.INPUT.tranParticular2)
								CUST.GETDATADRC.TranRmks = BANCS.STDIN.sysDate
								print(CUST.GETDATADRC.TranRmks)
								CUST.GETDATADRC.RefNum = CUST.GETDATADRC.ecs_tran_ref_noeft
								print(CUST.GETDATADRC.RefNum)
							ELSE
								sv_k ="EFT "
								sv_c = CUST.GETDATADRC.dest_cust_nameeft 
								BANCS.INPUT.tranParticular = sv_k + "/" + sv_c + "/" + CUST.GETDATADRC.tran_rmkseft 
								print(BANCS.INPUT.tranParticular)
								BANCS.INPUT.tranParticular2 = CUST.GETDATADRC.dest_cust_accteft 
								print(BANCS.INPUT.tranParticular2)
								CUST.GETDATADRC.TranRmks = BANCS.STDIN.sysDate
								print(CUST.GETDATADRC.TranRmks)
								CUST.GETDATADRC.RefNum = CUST.GETDATADRC.ecs_tran_ref_noeft
								print(CUST.GETDATADRC.RefNum)
							ENDIF
						#####
						BANCS.INPUT.tranParticular2 = MID$(BANCS.INPUT.tranParticular2,0,50)
						print(BANCS.INPUT.tranParticular2)
						CUST.GETDATADRC.RefNum = MID$(CUST.GETDATADRC.RefNum,0,20)
						print(CUST.GETDATADRC.RefNum)
						BANCS.INPUT.tranParticular = MID$(BANCS.INPUT.tranParticular,0,50)
						print(BANCS.INPUT.tranParticular)
						CUST.GETDATADRC.TranRmks = MID$(CUST.GETDATADRC.TranRmks,0,30)
						print(CUST.GETDATADRC.TranRmks)

						sv_s = "UPDATE TBAADM.DTD SET TRAN_PARTICULAR_2 = ?SVAR, REF_NUM = ?SVAR, TRAN_PARTICULAR = ?SVAR, TRAN_RMKS = ?SVAR WHERE TRAN_ID = LPAD(?SVAR,9)"
						sv_s = sv_s + " AND TRAN_DATE = ?SVAR "
						sv_s = sv_s + " AND BANK_ID = ?SVAR "
						print(sv_s)
						BANCS.INPARAM.BINDVARS = BANCS.INPUT.tranParticular2 + "|" + CUST.GETDATADRC.RefNum + "|" + BANCS.INPUT.tranParticular + "|" + CUST.GETDATADRC.TranRmks + "|" + CUST.GETDATADRC.TranIdeft + "|" + CUST.GETDATADRC.getboddate
						BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
						print(BANCS.INPARAM.BINDVARS)
						sv_w = urhk_dbSQLWithBind(sv_s)
						print(sv_w)
						IF(sv_w != 0)THEN
							sv_w = urhk_dbSQLWithBind(sv_s)
							print(sv_w)
								IF(sv_w != 0)THEN
									sv_w = urhk_dbSQLWithBind(sv_s)
									print(sv_w)
										IF(sv_w != 0)THEN
											sv_w = urhk_dbSQLWithBind(sv_s)
											print(sv_w)
										ENDIF
								ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
