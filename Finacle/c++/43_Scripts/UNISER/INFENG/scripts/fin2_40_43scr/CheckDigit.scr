<--START
CHECKSUM="07aebddbdb673ecfdc5150163818a908dc87d4231c8669280bc2de55de15df7c"
	# Input parameters to the script are: numType, applyString, nextNum,
	# checkDigitFlag, prefixString, suffixString, acctType, crncyCode, crncyAlias,
