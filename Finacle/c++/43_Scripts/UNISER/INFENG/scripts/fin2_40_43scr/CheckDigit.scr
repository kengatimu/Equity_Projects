	# Output parameters from the script are: nextNum, checkDigit, applyString,
	# successOrFailure, errorString (if there is any error)
	TRACE ON
	
	sv_r=urhk_B2k_PrintRepos("BANCS")
	
	BANCS.OUTPUT.errorString = ""
	BANCS.OUTPUT.checkDigit = ""
	BANCS.OUTPUT.nextNum = BANCS.INPUT.nextNum
	BANCS.OUTPUT.applyString = BANCS.INPUT.applyString
	BANCS.OUTPUT.successOrFailure = "S"
	
	# check for num type other than account-"A"
	IF (BANCS.INPUT.numType != "A") THEN
	#{
		BANCS.OUTPUT.errorString = "No logic specified in the script for num type other than account"
		BANCS.OUTPUT.successOrFailure = "F"
		EXITSCRIPT
	#}
	ENDIF
	
	sv_a = CLASSEXISTS("BANCS", "CHKDGT")
	IF (sv_a == 0) THEN
	#{
		CREATECLASS("BANCS", "CHKDGT", 5)
	#}
	ENDIF
	
	BANCS.CHKDGT.applyString = BANCS.INPUT.applyString
	BANCS.CHKDGT.nextNum = BANCS.INPUT.nextNum
	
	PRINT(BANCS.STDIN.myBankCode)
	PRINT(BANCS.STDIN.myBrCode)
	PRINT(BANCS.INPUT.schmCode)
	
	sv_u = "schmType|select schm_type from tbaadm.gsp where schm_code = ?SVAR AND bank_id = ?SVAR"
	
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.schmCode + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_q = urhk_dbSelectWithBind(sv_u)
	
	IF(sv_q!=0) THEN
	#{
		BANCS.CHKDGT.message= "Unable to Perform DB Operation"
		PRINT(BANCS.CHKDGT.message)
		BANCS.OUTPUT.successOrFailure = "N"
		#GOTO ENDOFSCRIPT
		EXITSCRIPT
		#}
	ELSE
		#{
		BANCS.CHKDGT.schmType=BANCS.OUTPARAM.schmType
		PRINT (BANCS.CHKDGT.schmType)
	#}
	ENDIF
	
	IF(BANCS.CHKDGT.schmType == "LAA") THEN
	#{
		# SKIPPING CHECK DIGIT LOGIC FOR LOAN ACCOUNTS
		EXITSCRIPT
	#}
	ENDIF
	
	BANCS.CHKDGT.bankCode = BANCS.STDIN.myBankCode
	BANCS.CHKDGT.branchCode = BANCS.STDIN.myBrCode
	
	BANCS.CHKDGT.cifId = ""
	BANCS.CHKDGT.noOfAcct = ""
	BANCS.CHKDGT.ribKey = ""
	BANCS.CHKDGT.acctNum = ""
	#BANCS.CHKDGT.IBANNumber = ""
	
	# Skipping IBAN generation for Office Accounts
	#	IF( BANCS.STDIN.menuId == "HACMDB ")THEN
	#	#{
	#		EXITSCRIPT
	#	#}
	#	ENDIF
	
	sv_b = LPAD(BANCS.CHKDGT.bankCode, 5, '0')
	sv_c = LPAD(BANCS.CHKDGT.branchCode, 5, '0')
	
	PRINT(sv_b)
	PRINT(sv_c)
	
	sv_u = LPAD(BANCS.INPUT.nextNum, 9, '0')
	PRINT(sv_u)
	
	print(BANCS.STDIN.mySolId)
	BANCS.CHKDGT.chkDgt = "00018" + "005" + MID$(BANCS.STDIN.mySolId,1,3) +  BANCS.INPUT.acctType + sv_u
	PRINT(BANCS.CHKDGT.chkDgt)
	
	BANCS.CHKDGT.tempAcct =  BANCS.CHKDGT.chkDgt
	
	##       Logic For Generating RIB Key     ##
	
	BANCS.INPARAM.BINDVARS = BANCS.CHKDGT.tempAcct
	
	sv_s = "tempAcct1|select to_char( ?SVAR * 100 )from dual"
	sv_q = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_q!=0) THEN
	#{
		BANCS.CHKDGT.message= "Unable to Perform DB Operation"
		PRINT(BANCS.CHKDGT.message)
		BANCS.OUTPUT.successOrFailure = "N"
		#GOTO ENDOFSCRIPT
		EXITSCRIPT
		#}
	ELSE
		#{
		sv_v=BANCS.OUTPARAM.tempAcct1
		PRINT (sv_v)
	#}
	ENDIF
	
	BANCS.INPARAM.BINDVARS = sv_v
	PRINT (BANCS.INPARAM.BINDVARS)
	
	sv_s = "eucMod|SELECT  DISTINCT(TO_CHAR(97-MOD((?SVAR),97))) FROM dual"
	sv_q = urhk_dbSelectWithBind(sv_s)
	
	IF(sv_q!=0) THEN
	#{
		BANCS.CHKDGT.message= "Unable to Perform Mod Operation"
		PRINT(BANCS.CHKDGT.message)
		BANCS.OUTPUT.successOrFailure = "N"
		#GOTO ENDOFSCRIPT
		EXITSCRIPT
		#}
	ELSE
		#{
		sv_g=BANCS.OUTPARAM.eucMod
		PRINT (sv_g)
		BANCS.CHKDGT.ribKey = sv_g
	#}
	ENDIF
	
	BANCS.CHKDGT.ribKey = LPAD(BANCS.CHKDGT.ribKey, 2, '0')
	PRINT(BANCS.CHKDGT.ribKey)
	
	#BANCS.CHKDGT.IBANNumber = "00018" + "005" + BANCS.CHKDGT.tempAcct + BANCS.CHKDGT.ribKey
	BANCS.CHKDGT.IBANNumber = BANCS.CHKDGT.chkDgt + BANCS.CHKDGT.ribKey
	PRINT(BANCS.CHKDGT.IBANNumber)
	
	BANCS.OUTPUT.IBANNumber = BANCS.CHKDGT.IBANNumber
	BANCS.OUTPUT.RIBNumber = BANCS.CHKDGT.IBANNumber
	
	#Calling user hook to get account number
	
	BANCS.INPARAM.iban_number = BANCS.OUTPUT.IBANNumber
	sv_u = urhk_getForacidFromIBANnumber("")
	PRINT(sv_u)
	
	IF(sv_u != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.errorMessage = "User hook failed"
		EXITSCRIPT
	#}
	ENDIF
	
	IF(BANCS.OUTPARAM.foracid == "") THEN
	#{
		PRINT("IBAN not mapped to an account number")
	#}
	ENDIF
	
	PRINT(BANCS.OUTPARAM.foracid)
	
	IF(BANCS.OUTPARAM.foracid != "") THEN
	#{
		PRINT("IBAN already mapped to an account")
		BANCS.OUTPUT.IBANNumber = ""
		BANCS.OUTPUT.RIBNumber = ""
		BANCS.INPUT.nextNum = CINT(BANCS.INPUT.nextNum) + 1
		PRINT(BANCS.INPUT.nextNum)
		CALL("CheckDigit.scr")
	#}
	ENDIF
	
	########      END OF LOGIC    ###############
	
	BANCS.OUTPUT.successOrFailure = "S"
	BANCS.OUTPUT.nextNum = BANCS.CHKDGT.nextNum
	BANCS.OUTPUT.checkDigit = BANCS.CHKDGT.ribKey
	BANCS.OUTPUT.applyString = BANCS.INPUT.applyString
	PRINT(BANCS.OUTPUT.nextNum)
	PRINT(BANCS.OUTPUT.checkDigit)
	PRINT(BANCS.OUTPUT.applyString)
	#ENDOFSCRIPT:
	EXITSCRIPT
