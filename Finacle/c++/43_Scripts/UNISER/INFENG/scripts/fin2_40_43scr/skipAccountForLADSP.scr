BANCS.OUTPUT.successOrFailure = "S"
if ((TRIM(sv_d) == "") OR (TRIM(sv_e) == ""))then
#{
	BANCS.OUTPUT.SkipFlg = "Y"
	BANCS.OUTPUT.errorDesc = "Unable to Fetch Account Details"
	BANCS.OUTPUT.successOrFailure = "S"
	GOTO ENDOFSCRIPT
#}
ENDIF
lv_u = urhk_B2k_ForacidToAcid(sv_e)
print(lv_u)
IF(lv_u == 0)THEN
#{
	sv_g = BANCS.OUTPARAM.Acid
	print(sv_g)
#}
ELSE
#{
	BANCS.OUTPUT.SkipFlg = "Y"
	BANCS.OUTPUT.errorDesc = "Unable to Fetch Account Details"
	BANCS.OUTPUT.successOrFailure = "S"
	GOTO ENDOFSCRIPT
#}
ENDIF
sv_a = "isEntered|select distinct 'Y' from tbaadm.dtd where "
sv_a = sv_a + " acid = ?SVAR and bank_id = ?SVAR and DEL_FLG ='N' "
sv_a = sv_a + " and PSTD_FLG = 'N' and tran_particular like '%Loan Recovery%'"
sv_a = sv_a + " and (tran_id,tran_date) in"
sv_a = sv_a + " (select tran_id, tran_date from tbaadm.dtd where "
sv_a = sv_a + " acid = ?SVAR and bank_id = ?SVAR and DEL_FLG ='N' "
sv_a = sv_a + " and tran_particular like '%Loan Recovery%')"
print(sv_a)
BANCS.INPARAM.BINDVARS= sv_g+"|"+BANCS.STDIN.contextBankId 
BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|" + sv_d + "|"+BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)
sv_b = urhk_dbselectWithBind(sv_a)
if(sv_b == 0 ) then
#{
	BANCS.OUTPUT.SkipFlg = "Y"
	BANCS.OUTPUT.errorDesc = "Already a Transaction Exist in Entered Status"
	BANCS.OUTPUT.successOrFailure = "S"
	GOTO ENDOFSCRIPT
#}
ENDIF
