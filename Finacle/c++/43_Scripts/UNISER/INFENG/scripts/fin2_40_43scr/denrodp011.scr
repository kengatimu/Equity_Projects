					CUST.DENOM.round_off_amt = CDOUBLE(CUST.DENOM.tot_roundoff_amt2) - CDOUBLE(CUST.DENOM.tot_roundoff_amt1)
					PRINT(CUST.DENOM.round_off_amt)
