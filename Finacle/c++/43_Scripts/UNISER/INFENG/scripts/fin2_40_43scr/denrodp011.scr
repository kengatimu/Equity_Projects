		#------------QUERY FOR THE PLACHOLDER OF P AND L ACCOUNT WHICH IS SET IN HSETVAR : Start ----------
		
		# In HSETVAR an entry is set with module code as DENOM, sub module code as DENOM, type as BACID,
		# variable name as PANDL and variable value as 8905001 for the P AND L account.
		BANCS.INPARAM.parLevel="BNKL"
		BANCS.INPARAM.bankId = BANCS.STDIN.contextBankId
		#BANCS.INPARAM.modName = "DENM"
		#BANCS.INPARAM.modName = "DUM"
		#BANCS.INPUT.parId = "PANDL"
		#sv_t = urtn_getCPARAM(BANCS.INPUT.parId)
		#print(sv_t)
		sv_s = ""
