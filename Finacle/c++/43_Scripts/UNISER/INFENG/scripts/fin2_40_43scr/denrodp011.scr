					#--------------------- GETTING THE SUM OF ROUND OFF AMOUNT FOR DEBIT TYPE OF PART TRAN : START---------------
					sv_a = "tot_roundoff_amt2|SELECT sum(roundoff_amt) FROM c_derd "
					sv_a = sv_a + " WHERE status = 'N'"
					sv_a = sv_a + " AND teller_id = '" + CUST.DENOM.teller_id + "'"
					sv_a = sv_a + " AND crncy_code = '" + CUST.DENOM.crncy_code + "'"
