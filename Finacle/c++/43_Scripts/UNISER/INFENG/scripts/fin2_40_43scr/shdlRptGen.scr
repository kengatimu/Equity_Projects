	sv_s = sv_s + " UNION "
	sv_s = sv_s + " SELECT FLOW_DATE,ACCT_NUM,LST_RPHSD_DATE,SHDL_NUM,CHRG_COMP,PRIN_COMP,INT_COMP,FLOW_AMOUNT FROM"
