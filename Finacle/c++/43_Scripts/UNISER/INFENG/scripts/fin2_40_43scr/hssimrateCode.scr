        ENDIF

	ENDOFSCRIPT:
	sv_u = urhk_SetOrbOut("errFlg|" + CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|" + CUST.DATA.errMsg)
        sv_u = urhk_SetOrbOut("rateCode|" + CUST.DATA.rateCode)
