	sv_s = "rateCode|SELECT RATE_CODE FROM TBAADM.ADM WHERE BANK_ID=?SVAR AND AMT_DRV_SRL_NUM IN (SELECT AMT_DERV_SRL_NUM FROM TBAADM.PTT WHERE EVENT_ID=?SVAR AND "
	sv_s = sv_s + "BANK_ID=?SVAR)"

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.eventId + "|" + BANCS.STDIN.contextBankId
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)

        sv_d=urhk_dbSelectWithBind(sv_s)
        IF(sv_d != "0")THEN
        #{
		CUST.DATA.errFlg = "N"
