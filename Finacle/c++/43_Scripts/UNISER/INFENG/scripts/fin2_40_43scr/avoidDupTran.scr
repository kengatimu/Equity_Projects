<--start
trace on 

lv_o = "S"
lv_e = "NA"

lv_s = urhk_b2k_printRepos("BANCS")

IF(FIELDEXISTS(BANCS.STDIN.menuId)) THEN
#{
	IF((BANCS.STDIN.menuId == "HTM" ) OR (BANCS.STDIN.menuId =="HCASHDEP") OR (BANCS.STDIN.menuId == "HCASHWD") OR (BANCS.STDIN.menuId == "HXFER")) THEN
        #{
				IF(((BANCS.INPUT.TranType == "C") AND ((BANCS.INPUT.TranSubType =="NR") OR (BANCS.INPUT.TranSubType =="NP"))) OR ((BANCS.INPUT.TranType == "T") AND ((BANCS.INPUT.TranSubType =="CI") OR (BANCS.INPUT.TranSubType =="BI")))) THEN
                                #{
                                        IF( (BANCS.STDIN.userId !="CDCI") AND (BANCS.STDIN.userId !="FIVUSR") ) THEN
                                        #{

						lv_a = "dupTranId,dupTranDate|"
                                                lv_a = lv_a + " select tran_id,tran_date from tbaadm.dtd "
                                                lv_a = lv_a + " where acid = (select acid from tbaadm.gam where foracid = ?SVAR and del_flg ='N' "
                                                lv_a = lv_a + " and acct_cls_flg != 'Y') "
                                                lv_a = lv_a + "   and ((sysdate - rcre_time)*24*60*60) < 120"
                                                lv_a = lv_a + " and tran_type = ?SVAR and tran_sub_type = ?SVAR "
                                                lv_a = lv_a + " and entry_user_id =?SVAR   and part_tran_type = ?SVAR "
                                                lv_a = lv_a + " and dth_init_sol_id =?SVAR  and bank_id=?SVAR  and rownum<2"

                                                BANCS.INPARAM.BINDVARS = BANCS.INPUT.AcctNum + "|" + BANCS.INPUT.TranType
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.TranSubType + "|" + BANCS.STDIN.userId
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +  "|" + BANCS.INPUT.PartTranType + "|" +  BANCS.STDIN.mySolId
                                                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +  "|" + BANCS.STDIN.contextBankId
	
						print(lv_a)
						print(BANCS.INPARAM.BINDVARS)

                                                lv_d = urhk_dbSelectWithBind(lv_a)

                                                IF(lv_d == 0) THEN
                                                #{
                                                        lv_b = BANCS.OUTPARAM.dupTranId
							lv_c = BANCS.OUTPARAM.dupTranDate
                                                        lv_o = "F"
                                                        lv_e = "Transaction for the same account with Tran ID "+ lv_b +" has been Processed Just Now. Please check and re-initiate the request to avoid duplicate transaction."
                                                        GOTO ENDOFSCRIPT
                                                #}
                                                ENDIF
                                        #}
                                        ENDIF
				#}
				ENDIF

	#}
	ENDIF

#}
ENDIF

ENDOFSCRIPT:

lv_a = urhk_SetOrbOut(lv_o + "|" + lv_e)
end-->
