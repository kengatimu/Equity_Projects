        ##lv_e = lv_e + " to_char(nvl(sum(VALUE_DATE_TOT_TRAN),0),9999999999999999.99) as daytrans "
        lv_e = lv_e + " to_char(nvl(sum(TRAN_DATE_TOT_TRAN),0),9999999999999999.99) as daytrans "
        lv_e = lv_e + " from tbaadm.eab where acid =?SVAR "
        ##lv_e = lv_e + " and eod_date <= to_date(?SVAR,'YYYY-MM-DD') "
        ##lv_e = lv_e + " and end_eod_date >= to_date(?SVAR,'YYYY-MM-DD') "
        lv_e = lv_e + " and eod_date <= to_date(?SVAR ,'DD-MM-YYYY HH24:MI:SS') "
