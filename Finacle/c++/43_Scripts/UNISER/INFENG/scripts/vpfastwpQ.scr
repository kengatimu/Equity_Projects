                        ##sv_u = urhk_SetOrbOut("Message|" + EQSRV.GLBDATA.msge )
                        ##goto SIFNO
                #}
                endif
#Get Opn/Cls from hook
        lv_i = "opnBalDatee,clsBalDatee | select to_char(to_date(?SVAR,'DD-MM-RRRR')-1,'DD-MM-RRRR'),to_char(to_date(?SVAR,'DD-MM-RRRR')-1,'DD-MM-RRRR') from dual "
        BANCS.INPARAM.BINDVARS = left$(EQSRV.GLBDATA.lfrmDate,10) + "|" + left$(EQSRV.GLBDATA.ltoDate,10)
