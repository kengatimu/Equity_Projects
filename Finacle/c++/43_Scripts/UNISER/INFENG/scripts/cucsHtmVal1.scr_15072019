<--START

	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	sv_r = REPEXISTS("CUST")
	IF(sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether WHT Class exists else create it
	###########################################################################################
	sv_c = CLASSEXISTS("CUST", "CUCS")
	IF(sv_c == 0) THEN
	#{
		CREATECLASS("CUST", "CUCS", 5)
	#}
	ENDIF
	
	CUST.CUCS.chkNo = ""
	CUST.CUCS.acctNo = ""
	IF(FIELDEXISTS(BANCS.INPUT.chkNo))THEN
	#{
		IF (BANCS.INPUT.chkNo != "")THEN
		#{
			CUST.CUCS.chkNo = BANCS.INPUT.chkNo
			PRINT(CUST.CUCS.chkNo)
		#}
		ENDIF
	#}
	ENDIF
	IF(FIELDEXISTS(BANCS.INPUT.acctNo))THEN
	#{
		IF (BANCS.INPUT.acctNo != "")THEN
		#{
			CUST.CUCS.acctNo = BANCS.INPUT.acctNo
			PRINT(CUST.CUCS.acctNo)
		#}
		ENDIF
	#}
	ENDIF
	###########################################################################################
	# Initialize the variables
	###########################################################################################
	CUST.CUCS.errorFlg = "N"
	CUST.CUCS.errorMsg = " "
	
	CUST.CUCS.userId =  BANCS.STDIN.userId
	
	CUST.CUCS.recCount = "0"
	CUST.CUCS.modRecCount = "0"
	
	
	
	
	sv_s = "recCount|SELECT COUNT(1) FROM CUSTOM.C_CUCS WHERE ACCT_NUMBER = ?SVAR AND CHEQUE_NUM = ?SVAR AND DEL_FLG = 'N' AND BANK_ID = ?SVAR"
	
	BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|" + CUST.CUCS.chkNo + "|" + BANCS.STDIN.contextBankId
	
	sv_a = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_a)
	
	IF(sv_a == 0)THEN
	#{
		PRINT(BANCS.OUTPARAM.recCount)
		CUST.CUCS.recCount = BANCS.OUTPARAM.recCount
		IF(CUST.CUCS.recCount != "0")THEN
		#{
			#PRINT("Cheque has been certified/released already")
			#CUST.CUCS.errorFlg = "Y"
			#CUST.CUCS.errorMsg = CUST.CUCS.chkNo+" Cheque has been certified/released already"
			
			sv_n=urhk_SRV_SetErr("Cheque has been certified/released already")
			BANCS.OUTPUT.successOrFailure="F"
			exitscript
		#}
		ENDIF
	#}
	ELSE
	#{
		#PRINT("FAILED TO FETCH DATA FROM DB")
		#CUST.CUCS.errorFlg = "Y"
		#CUST.CUCS.errorMsg = "FAILED TO FETCH DATA FROM DB"
		#GOTO ENDOFSCRIPT
		
		
		sv_n=urhk_SRV_SetErr("FAILED TO FETCH DATA FROM DB")
		BANCS.OUTPUT.successOrFailure="F"
		exitscript
	#}
	ENDIF
		
	ENDOFSCRIPT:
	
	
END-->
