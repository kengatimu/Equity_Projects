			sv_e = BANCS.OUTPARAM.EffAvailableAmt
			PRINT(sv_e)
			CUST.CHRG.effavlamt = sv_e

			IF ((CUST.CHRG.frezCode == "D") OR (CUST.CHRG.frezCode == "T"))THEN
