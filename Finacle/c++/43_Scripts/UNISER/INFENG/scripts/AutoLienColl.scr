						sv_a = urhk_ExecSrvNoCommit("SRV_AddLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
						PRINT(sv_a)
						IF (sv_a != 0) THEN
							GOTO NEXTACID
						ENDIF
				
					ELSE
						
						BANCS.INPARAM.BINDVARS = CUST.CHRG.ACID + "|" + BANCS.STDIN.contextBankId + "|" + CUST.CHRG.LIEN_REASON_CODE
						sv_a = "count|select count(*) from tbaadm.alt where acid = ?SVAR AND b2k_type='ULIEN' AND BANK_ID= ?SVAR AND LIEN_REASON_CODE = ?SVAR "
						PRINT(sv_a)
						sv_s = urhk_dbSelectWithBind(sv_a)
						PRINT(sv_s)
						IF (sv_s !=0) THEN						
							CUST.CHRG.LienSuccessOrFailure = "F"
							CUST.CHRG.LienFailureReason = "Query to fetch count of lien record details of normal lien ON ALT table failed"
							sv_s = CUST.CHRG.FORACID + "|" + "Query to fetch count of lien record details of normal lien ON ALT table failed"
							PRINT(sv_s)
							GOTO NEXTACID
						ELSE
							PRINT (BANCS.OUTPARAM.count)
							
							sv_a = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.FORACID)
							sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
							sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00")

