			ENDIF
			MTT.PartTranDetails.RefCurrency= CUST.CHRG.CHARGE_CRNCY_CODE
			MTT.PartTranDetails.ValueDate="0"
			MTT.PartTranDetails.ReportCode = ""
			MTT.PartTranDetails.Consolidate="Y"
			MTT.PartTranDetails.TranIdentifier="Auto_Lien_Coll"
			MTT.PartTranDetails.TranBusinessType=""
						
			sv_u = urhk_MTTS_DefineChargePartTran("Delayed_Chrg_Credit_Tran")
			PRINT(sv_u)
			
			IF (sv_u != 0) THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
				PRINT(MTT.Error.Description)
				CUST.CHRG.ErrorMessage=MTT.Error.Description
				PRINT(CUST.CHRG.ErrorMessage)
				CUST.CHRG.remark = CUST.CHRG.ErrorMessage
				CUST.CHRG.errMsg = CUST.CHRG.FORACID + "|"+CUST.CHRG.remark
				PRINT(CUST.CHRG.errMsg)
				GOTO NEXTACID
			ENDIF	
			
			#--------------------------------------------------------------------------------------------------	
			
			sv_r = urhk_putExceptionsIntoRepository("")
			PRINT(sv_r)			
			sv_s = urhk_b2k_printRepos("EXCP")			
			sv_r = urhk_MTTS_EndDefinition("")
			PRINT(sv_r)			
			IF(sv_r !=0) THEN
				sv_a = "Transaction Commit Failed"
				PRINT(sv_a)
				sv_h = urhk_MTTS_ReportErrorCondition("")
				PRINT(sv_h)
				PRINT(MTT.Error.Description)
				CUST.CHRG.remark = MTT.Error.Description
