			MTT.PartTranDetails.Particulars2 = MID$(CUST.CHRG.chrgAcntNAME,0,50) 
			MTT.PartTranDetails.Remarks = "Lien Auto Collection"
			IF(CUST.CHRG.CHARGE_CRNCY_CODE != CUST.CHRG.actcrncy)THEN
				MTT.PartTranDetails.RateCode= CUST.CHRG.rateCode
				MTT.PartTranDetails.Rate = CUST.CHRG.rate
			ENDIF
			MTT.PartTranDetails.RefAmount = -cdouble(CUST.CHRG.debitAmt)
			PRINT(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "Auto_Lien_Coll"
			MTT.PartTranDetails.CarveAmtFlg="Y"
			
			#----------------------------------------------------------------------------------
			# Defining the Debit Part Tran for Charge amount
			#----------------------------------------------------------------------------------
			sv_u = urhk_MTTS_DefinePartTran("Delayed_Chrg_Debit_Tran")
			PRINT(sv_u)
			
			IF (sv_u != 0) THEN
