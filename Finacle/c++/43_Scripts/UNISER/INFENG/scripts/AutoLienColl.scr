			#ENDIF
		ENDIF

			CUST.CHRG.NEW_LIEN_PRE = 0
			PRINT(CUST.CHRG.NEW_LIEN)
			PRINT(CUST.CHRG.B2K_ID)
			PRINT(CUST.CHRG.FORACID)
			PRINT(CUST.CHRG.LIEN_AMT)
			#fetch all the details of the exisiting lien.
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.FORACID)
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleId|" + CUST.CHRG.B2K_ID)
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00")
