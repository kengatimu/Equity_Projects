	sv_s = " ACID,B2K_TYPE, B2K_ID,LIEN_AMT,LIEN_REASON_CODE,LIEN_REMARKS, ALT_CRNCY_CODE,REQUEST_DEPARTMENT,FORACID,Acct_status | "
	sv_s = sv_s + "  select ACID,B2K_TYPE, B2K_ID,LIEN_AMT,LIEN_REASON_CODE,LIEN_REMARKS, ALT_CRNCY_CODE,REQUEST_DEPARTMENT,FORACID,Acct_status from (  "
	sv_s = sv_s + " select alt.acid,B2K_TYPE,B2K_ID,alt.LIEN_AMT,LIEN_REASON_CODE,LIEN_REMARKS,ALT_CRNCY_CODE,REQUEST_DEPARTMENT, A.foracid, Acct_status  ,  "
	sv_s = sv_s + " (select foracid from tbaadm.gam where foracid =REQUEST_DEPARTMENT and bank_id = ?SVAR  and  FREZ_CODE not in ('T','C') and acct_cls_flg ='N' ) IX  "
	sv_s = sv_s + " from tbaadm.alt , tbaadm.gam A, tbaadm.smt  where alt.bank_id =?SVAR   and A.acid =alt.acid and A.acid =smt.acid and A.bank_id =smt.bank_id and A.bank_id =alt.bank_id    "
	sv_s = sv_s + " and A.acid =alt.acid and A.acid =smt.acid  and A.bank_id =smt.bank_id  and A.bank_id =alt.bank_id   AND LIEN_REASON_CODE ='CHRGL' and REQUEST_DEPARTMENT  is not  null   "
	sv_s = sv_s + " and Acct_status ='A' and  FREZ_CODE not in ('T','D') and REGEXP_INSTR(REQUEST_DEPARTMENT,'[^[:digit:] ]')  ='0' and (A.clr_bal_amt- A.lien_amt) >= 0 and alt.lien_amt <> 0 )   "
	sv_s = sv_s + " where  IX is not null "	
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId   +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_e = urhk_dbCursorOpenWithBind(sv_s)
