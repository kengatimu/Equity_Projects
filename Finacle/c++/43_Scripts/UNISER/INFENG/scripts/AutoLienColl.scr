			CALL("fetchRateCode.scr")
			CUST.CHRG.rateCode2 =CUST.RATE.rateCode
			CUST.CHRG.rate2=CUST.RATE.rate
		ENDIF

		sv_c  = CUST.CHRG.effavlamt
		sv_j = CUST.CHRG.LIEN_AMT

		PRINT(CUST.CHRG.effavlamt)
		PRINT(CUST.CHRG.LIEN_AMT)
		
		sv_c = CDOUBLE(sv_c) + CDOUBLE(sv_j)
		PRINT(sv_c)

		
		IF(sv_c > sv_j)THEN
			IF(sv_c > 0)THEN
				CUST.CHRG.collChargeAmt = CUST.CHRG.LIEN_AMT
