					exitscript
				ENDIF
			print(sv_q)

	WHILE (sv_q==0)
			
		CUST.CHRG.ACID = BANCS.OUTPARAM.ACID
		CUST.CHRG.B2K_TYPE = BANCS.OUTPARAM.B2K_TYPE
