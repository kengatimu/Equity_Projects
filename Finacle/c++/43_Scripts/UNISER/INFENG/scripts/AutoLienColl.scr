				PRINT(sv_h)
				sv_h=urhk_B2k_PrintRepos("MTT")
				PRINT(sv_h)
				CUST.CHRG.errMsg = CUST.CHRG.FORACID  + "|"+CUST.CHRG.remark
				CUST.CHRG.pstdFlg = "N"
				GOTO NEXTACID
			ENDIF
								
			sv_u = urhk_MTTS_EndDefinition("")
			PRINT(sv_u)
			
			PRINT(BANCS.OUTPARAM.MTTTranId)
			CUST.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
	

			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)
							
			sv_d = " Sleep 3"
			PRINT(sv_d)
			sv_u = SYSTEM(sv_d)
			PRINT(sv_u)
				
				BANCS.INPARAM.BINDVARS = CUST.CHRG.ACID + "|" + BANCS.STDIN.contextBankId
