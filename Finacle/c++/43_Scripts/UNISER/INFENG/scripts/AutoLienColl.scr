				PRINT(sv_a)
				sv_s = urhk_dbSelectWithBind(sv_a)
				PRINT(sv_s)
				
				IF (sv_s !=0) THEN
					CUST.CHRG.LienSuccessOrFailure = "F"
					CUST.CHRG.LienFailureReason = "Query to fetch count of lien record details of normal lien ON ALT table failed"
					sv_s = CUST.CHRG.FORACID+ "|" + "Query to fetch count of lien record details of normal lien ON ALT table failed"
					PRINT(sv_s)
					GOTO NEXTACID
				ELSE
					CUST.CHRG.NewRecNum = BANCS.OUTPARAM.count
						PRINT(CUST.CHRG.NewRecNum)
					IF ((CUST.CHRG.NewRecNum) == 0 ) THEN	
						sv_l = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.CHRG.FORACID)
						sv_l = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
						sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00")
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.CHRG.NEW_LIEN + "|"+CUST.CHRG.CHARGE_CRNCY_CODE)
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|0|"+CUST.CHRG.CHARGE_CRNCY_CODE)
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|31-12-2099 00:00:00")
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.CHRG.LIEN_REMARKS)
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|" + CUST.CHRG.LIEN_REASON_CODE)
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.effFromDate|" + BANCS.STDIN.BODDate)
						sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.CHRG.REQUEST_DEPARTMENT)
