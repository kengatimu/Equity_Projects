				GOTO NEXTACID
			ENDIF
				
			CUST.CHRG.debitAmt = CUST.CHRG.collChargeAmt
			######################################
			# Debit part tran for charge
			######################################
			
			MTT.PartTranDetails.Account     = CUST.CHRG.FORACID
			MTT.PartTranDetails.RefCurrency= CUST.CHRG.CHARGE_CRNCY_CODE
