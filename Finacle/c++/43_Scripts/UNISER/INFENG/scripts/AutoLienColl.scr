			PRINT(sv_a)

			IF (sv_a != 0) THEN
					GOTO NEXTACID
			ENDIF
			sv_a = urhk_CopyOutToIn("")
			PRINT(sv_a)

			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.CHRG.NEW_LIEN_PRE + "|"+CUST.CHRG.CHARGE_CRNCY_CODE)
			sv_a = urhk_ExecSrv("SRV_ModifyLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
			PRINT(sv_a)

			sv_z = urhk_MTTS_Close("")
			PRINT(sv_z)
			
			BANCS.INPARAM.PostTranFlg = "Y"
			BANCS.INPARAM.CommitFlg = "Y"
			BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
			BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
			BANCS.INPARAM.ErrorCheckForLuw = "Y"
			BANCS.INPARAM.CheckExceptions = "Y"
			sv_r = urhk_MTTS_Initialize("")
			PRINT(sv_r)
			IF(sv_r != 0)THEN
				sv_r = urhk_MTTS_ReportErrorCondition("")
