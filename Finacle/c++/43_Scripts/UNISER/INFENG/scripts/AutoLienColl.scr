				CUST.CHRG.remark = sv_q
				GOTO NEXTACID
			ENDIF
		ENDIF


		sv_r = urhk_getAcctDetailsInRepository(CUST.CHRG.chrgAcnt)
		IF(sv_r != 0)THEN
			sv_q ="account is not found"
			PRINT(sv_q)
			sv_q = CUST.CHRG.chrgAcnt+"|"+sv_q
			GOTO NEXTACID
		ELSE
			CUST.CHRG.chrgAcntCrncy = BANCS.OUTPARAM.acctCrncyCode
			CUST.CHRG.chrgAcntNAME = BANCS.OUTPARAM.acctName 
			
		ENDIF
			

		PRINT(CUST.CHRG.actcrncy)
		PRINT(CUST.CHRG.CHARGE_CRNCY_CODE)
		
		##########################################################
		#RateCode######
		##########################################################
		
		IF(CUST.CHRG.CHARGE_CRNCY_CODE != CUST.CHRG.actcrncy)THEN		
			sv_r = REPEXISTS("CUST")
			
			IF(sv_r == 0) THEN
				CREATEREP ("CUST")
			ENDIF
			sv_r = CLASSEXISTS("CUST","RATE")
			IF(sv_r == 0) THEN
				CREATECLASS ("CUST","RATE",5)
			ENDIF
			
			CUST.RATE.acctCrncy = CUST.CHRG.actcrncy
			CUST.RATE.refCrncy = CUST.CHRG.CHARGE_CRNCY_CODE	
			CUST.RATE.TranType = "T"
			CALL("fetchRateCode.scr")
			
			CUST.CHRG.rateCode = CUST.RATE.rateCode
			CUST.CHRG.rate = CUST.RATE.rate
		ENDIF

		IF(CUST.CHRG.CHARGE_CRNCY_CODE !=  CUST.CHRG.chrgAcntCrncy )THEN
			sv_r = REPEXISTS("CUST")
			IF(sv_r == 0) THEN
				CREATEREP ("CUST")
			ENDIF
			sv_r = CLASSEXISTS("CUST","RATE")
			IF(sv_r == 0) THEN
				CREATECLASS ("CUST","RATE",5)
			ENDIF
			CUST.RATE.acctCrncy = CUST.CHRG.chrgAcntCrncy
			CUST.RATE.refCrncy = CUST.CHRG.CHARGE_CRNCY_CODE
