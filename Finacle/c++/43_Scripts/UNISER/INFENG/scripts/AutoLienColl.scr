							sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.effFromDate|" + BANCS.STDIN.BODDate)
							sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.requestedBy|")
							sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.requestDept|" + CUST.CHRG.REQUEST_DEPARTMENT)
							sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.CHRG.NewRecNum + ">.contactNum|")
							sv_a = urhk_ExecSrvNoCommit("SRV_ModifyLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
							PRINT(sv_a)

							IF (sv_a != 0) THEN
								GOTO NEXTACID
							ENDIF
						ENDIF
					ENDIF	
				ENDIF
			NEXTACID:
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
	DO

	sv_x = urhk_dbCursorClose(sv_m)

	ENDOFSCRIPT:
		IF(CUST.CHRG.errMsg == "") THEN
			CUST.CHRG.errMsg = " Other Accounts|Batch Job executed with out any Errors"
		ENDIF
		
	FINISH:
TRACE OFF
		
END-->

