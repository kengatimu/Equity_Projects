        ############Fecthinh scheme codes from CPARAM ###########################



               sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.drAccount)
                PRINT(sv_u)

                IF(sv_u == 0)THEN
                #{
                        CUST.DATA.avblAmt = BANCS.OUTPARAM.EffAvailableAmt
