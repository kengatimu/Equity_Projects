        IF(FIELDEXISTS(BANCS.INPUT.paysysId))THEN
        #{
                IF(BANCS.INPUT.paysysId !="")THEN
                #{
                        CUST.DATA.paysysId = TOUPPER(TRIM(BANCS.INPUT.paysysId))
                        PRINT(CUST.DATA.paysysId)
