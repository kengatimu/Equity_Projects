	IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="OUR") and (BANCS.INPUT.bencntry=="CD")) then
			CUST.DATA.eventid="RTGSOUR"
		print(CUST.DATA.eventid)

	ENDIF

	IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="OUR") and (BANCS.INPUT.bencntry !="CD")) then
			CUST.DATA.eventid="SWIFTOUR"
		print(CUST.DATA.eventid)

	ENDIF

	IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="BEN") and (BANCS.INPUT.bencntry =="CD")) then
			CUST.DATA.eventid="RTGSBEN"
		print(CUST.DATA.eventid)

	ENDIF

	IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="BEN") and (BANCS.INPUT.bencntry !="CD")) then
			CUST.DATA.eventid="SWIFTBEN"
		print(CUST.DATA.eventid)

	ENDIF

	IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="SHA") and (BANCS.INPUT.bencntry =="CD")) then
			CUST.DATA.eventid="RTGSSHR"
		print(CUST.DATA.eventid)

	ENDIF
	IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="SHA") and (BANCS.INPUT.bencntry !="CD")) then
			CUST.DATA.eventid="SWIFTSHR"
		print(CUST.DATA.eventid)

	ENDIF

	IF((BANCS.INPUT.paysysId=="SWIFT") and (BANCS.INPUT.chargeOption=="SHA") ) then
			CUST.DATA.eventid="SWIFTSHR"
		print(CUST.DATA.eventid)

	ENDIF

	IF((BANCS.INPUT.paysysId=="RTGS") and (BANCS.INPUT.chargeOption=="SHA") ) then
			CUST.DATA.eventid="RTGSSHR"
		print(CUST.DATA.eventid)

	ENDIF
	IF((BANCS.INPUT.paysysId=="RTGS") and (BANCS.INPUT.chargeOption=="OUR") ) then
			CUST.DATA.eventid="RTGSOUR"
		print(CUST.DATA.eventid)

	ENDIF
	IF((BANCS.INPUT.paysysId=="RTGS") and (BANCS.INPUT.chargeOption=="BEN") ) then
			CUST.DATA.eventid="RTGSOUR"
		print(CUST.DATA.eventid)

	ENDIF



		print(CUST.DATA.eventid)
ENDOFSCRIPT:

	IF(BANCS.STDIN.userId !="FIVUSR43") THEN
        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
        sv_u = urhk_SetOrbOut("eventid|"+CUST.DATA.eventid)

	ELSE
