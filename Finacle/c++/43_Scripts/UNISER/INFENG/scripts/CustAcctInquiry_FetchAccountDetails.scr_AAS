#----------------------------------------------------------------------------------------------------------
# Filename              :       CustAcctInquiry_FetchAccountDetails.scr
# Author                :       Venkatesh T R
# Description           :       This script fetches all the accounts of the customer along with some details
# Input                 :       Customer ID
# Output                :       None
# Called Script         :       None
# Calling Script        :       CustAcctInquiry_main.scr
# Modification History
# Sl. #           Date             Author             Modification           Version
# -----           -----           --------          ----------------        ---------
#  1           04-03-2012         Venkatesh          Original Version          1.0
#  2           02-09-2019         Irungu James       DRC req all accounts atatched to cif (related party details)         
#-----------------------------------------------------------------------------------------------------------
<--start
#trace on
sv_a = urhk_GetChannelInfo("")
	print(sv_a)
	CUST.INTERFACE.DccId =BANCS.OUTPARAM.DccId
	print(CUST.INTERFACE.DccId)

	#---------------------------------------------------------------------------------
	# Fetch Account Details 
	#---------------------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.INTERFACE.customerID + "|" + CUST.INTERFACE.bankID
	sv_s = "foracid,acid,acctOpenDate,solID,Branch,schemeCode,schemeType,acctName,crncyCode,acctOwnership,"
	sv_s = sv_s + "acctClosureFlg,freezeCode,clrBalAmt,unClearBalAmt,sanctLimit,lienAmt,drawingPower,"
	sv_s = sv_s + "modeOfOperation|"
	sv_s = sv_s + "SELECT foracid,gam.acid,to_char(ACCT_OPN_DATE,'DD-MM-YYYY'),GAM.SOL_ID,SOL_DESC,SCHM_CODE,gam.SCHM_TYPE,ACCT_NAME,"
	sv_s = sv_s + " ACCT_CRNCY_CODE,ACCT_OWNERSHIP,ACCT_CLS_FLG,FREZ_CODE,CLR_BAL_AMT,"
	sv_s = sv_s + " (un_clr_bal_amt + future_un_clr_bal_amt + future_clr_bal_amt),SANCT_LIM,LIEN_AMT,DRWNG_POWER,MODE_OF_OPER_CODE"
	sv_s = sv_s + " FROM TBAADM.GAM GAM,TBAADM.SOL SOL,  tbaadm.aas ,crmuser.cmg WHERE CMG.CIF_ID = ?SVAR AND GAM.BANK_ID = ?SVAR AND GAM.DEL_FLG = 'N'"
	sv_s = sv_s + " AND ((SCHM_CODE='SB777' AND GAM.ENTITY_CRE_FLG ='N') OR (GAM.ENTITY_CRE_FLG ='Y' )) AND GAM.SOL_ID=SOL.SOL_ID "
	sv_s = sv_s + " and cmg.cust_id =STMT_CUST_ID and aas.acid =gam.acid  and aas.bank_id =gam.bank_id "
	IF(CUST.INTERFACE.accountID != "") THEN
	#{
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.INTERFACE.accountID
		sv_s = sv_s + " AND foracid = ?SVAR"
	#}
	ENDIF
	sv_d = urhk_dbCursorOpenWithBind(sv_s)
	IF(sv_d == 0) THEN
	#{
		sv_c = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_r = urhk_dbCursorFetch(sv_c)
		sv_q = 0
		WHILE(sv_r == 0)	
		#{
			sv_q = sv_q + 1
			
			sv_v = "foracid_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.foracid
			sv_v = "acid_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acid
			CUST.INTERFACE.acid = BANCS.OUTPARAM.acid
			sv_v = "acctOpenDate_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctOpenDate
			sv_v = "solID_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.solID
			sv_v = "Branch_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.Branch
			sv_v = "schemeCode_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.schemeCode
			sv_v = "schemeType_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.schemeType
			CUST.INTERFACE.schemeType = BANCS.OUTPARAM.schemeType
			sv_v = "acctName_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctName
			sv_v = "crncyCode_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.crncyCode
			sv_v = "acctOwnership_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctOwnership
			sv_v = "acctClosureFlg_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctClosureFlg
			sv_v = "freezeCode_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.freezeCode
			sv_v = "clrBalAmt_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.clrBalAmt
			sv_v = "unClearBalAmt_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.unClearBalAmt
			sv_v = "sanctLimit_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.sanctLimit
			sv_v = "lienAmt_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.lienAmt
			sv_v = "drawingPower_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.drawingPower
			sv_v = "modeOfOperation_" + FORMAT$(sv_q, "%d")
			("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.modeOfOperation
			
			#------------------------------------------------------
			# Fetching Account Status
			#------------------------------------------------------
			sv_v = "accountStatus_" + FORMAT$(sv_q, "%d")
			BANCS.INPARAM.acid = BANCS.OUTPARAM.acid
			sv_u = urhk_getAcctStatus("")
			IF(sv_u == 0) THEN
			#{
				("CUST").("INTERFACE").(sv_v) = BANCS.OUTPARAM.acctStatus
			#}
			ELSE
			#{
				("CUST").("INTERFACE").(sv_v) = ""
			#}
			ENDIF
			
			#------------------------------------------------------
			# Fetching LAA additional details
			#------------------------------------------------------
			IF((CUST.INTERFACE.schemeType == "LAA") OR (CUST.INTERFACE.schemeType == "CLA")) THEN
			#{
				CALL("CustAcctInquiry_FetchLAADetails.scr")
				
	                  
			#}
			ENDIF
	 			
			#------------------------------------------------------
			# Fetching TDA additional details
			#------------------------------------------------------
			IF((CUST.INTERFACE.schemeType == "TDA") OR (CUST.INTERFACE.schemeType == "TUA")) THEN
			#{
			       print ("123")
				CALL("CustAcctInquiry_FetchTDDetails.scr")
			#}
                        ENDIF

		sv_r = urhk_dbCursorFetch(sv_c)
		#}
		DO
		sv_r = urhk_dbCursorClose(sv_c)
		CUST.INTERFACE.accountCount = sv_q
		print(CUST.INTERFACE.accountCount)
	
			
	#}
	ENDIF
	
#trace off
end-->
