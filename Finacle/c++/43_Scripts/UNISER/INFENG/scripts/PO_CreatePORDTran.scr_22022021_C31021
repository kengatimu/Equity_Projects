			MTT.PartTranDetails.TodNrmlIntPcnt = MTT.InputDetails.TodNrmlIntPcnt
			MTT.PartTranDetails.TodPenalIntPcnt = MTT.InputDetails.TodPenalIntPcnt
			MTT.PartTranDetails.TodPermittedBy = MTT.InputDetails.TodPermittedBy
			PRINT(MTT.InputDetails.TodPermittedBy)
			MTT.PartTranDetails.TodRemarks = MTT.InputDetails.TodRemarks
		#}
		ENDIF
	#}
	ENDIF
	
	MTT.PartTranDetails.EntryUserId = MTT.InputDetails.EntryUserId
	MTT.PartTranDetails.EntryTime   = MTT.InputDetails.EntryTime
	MTT.PartTranDetails.sysPartTranCode ="PTRN01288"
	PRINT("PTRN01288 : Dr. Cus. A/c. for Payment Order Txn : Account=["+MTT.PartTranDetails.Account+"]RefCurrency["+MTT.PartTranDetails.RefCurrency+"]RefAmount=["+MTT.PartTranDetails.RefAmount+"]Rate=["+MTT.PartTranDetails.Rate+"]")
	sv_z = urhk_MTTS_DefinePartTran("PORD_INW_DEBIT")
	IF (sv_z != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.scriptError = "urhk_MTTS_DefinePartTran returns FAILURE"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###############################################################################
	# Credit Settlement A/c set in Paysys
	###############################################################################
	
	IF((MTT.InputDetails.ChargeType == "OUR") AND (sv_g > 0) AND (MTT.InputDetails.NostroChrgFlg == "Y")) THEN
	#{
		# Normal Crncy
		IF (sv_x == MTT.InputDetails.remitCrncy) THEN
		#{
			PORD.GLBDATA.RBCHDIRECTADD = "Y"
			IF (MTT.InputDetails.netOffChargesFlg == "Y" ) THEN
			#{
				MTT.InputDetails.remitAmt = (CDOUBLE(MTT.InputDetails.remitAmt)) - sv_k + sv_r
				#}
			ELSE
				#{
				MTT.InputDetails.remitAmt = (CDOUBLE(MTT.InputDetails.remitAmt)) + sv_r
			#}
			ENDIF
			#}
			
			#}
		ELSE
			#{
			PORD.GLBDATA.RBCHDIRECTADD = "N"
		#}
		ENDIF
		#}
	ELSE
		#{
		IF ((MTT.InputDetails.netOffChargesFlg == "Y" ) AND (sv_m != 1)) THEN
		#{
			MTT.InputDetails.remitAmt = (CDOUBLE(MTT.InputDetails.remitAmt)) - sv_k
			#}
		ELSE
			#{
			IF(sv_m != 0) THEN
			#{
				BANCS.INPARAM.TranCrncyCode=PORD.GLBDATA.chargeCrncy
				BANCS.INPARAM.acctCrncyCode=MTT.InputDetails.remitCrncy
				BANCS.INPARAM.RateCode=PORD.GLBDATA.PTTRATECODE
	PRINT(PORD.GLBDATA.chargeCrncy)
				PRINT(MTT.InputDetails.remitCrncy)
				PRINT(PORD.GLBDATA.PTTRATECODE)
				sv_b=urhk_getTranRate("")
				IF(sv_b == 0)THEN
				#{
	IF(PORD.GLBDATA.chargeCrncy == MTT.InputDetails.remitCrncy)THEN
					#{
					PORD.GLBDATA.PTTRATE=CDOUBLE("1.0000")
					#}
					ELSE
					#{
					PORD.GLBDATA.PTTRATE=BANCS.OUTPARAM.exchgRate
					#}
					ENDIF
					PRINT(PORD.GLBDATA.PTTRATE)
					#}
				ELSE
					#{
					BANCS.OUTPUT.successOrFailure = "F"
					BANCS.OUTPUT.scriptError = "Rate derivation failed"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				BANCS.INPARAM.InputAmount=sv_k
				BANCS.INPARAM.FromCurrency=PORD.GLBDATA.chargeCrncy
				BANCS.INPARAM.ToCurrency=MTT.InputDetails.remitCrncy
				BANCS.INPARAM.RateCode=PORD.GLBDATA.PTTRATECODE
				#BANCS.INPARAM.Rate=PORD.GLBDATA.PTTRATE
				BANCS.INPARAM.Rate=cdouble("0")
				sv_b=urhk_B2k_ConvertAmount("")
				sv_c=CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				MTT.InputDetails.remitAmt = (CDOUBLE(MTT.InputDetails.remitAmt)) - sv_c
				#}
			ELSE
				#{
				MTT.InputDetails.remitAmt = (CDOUBLE(MTT.InputDetails.remitAmt))
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	MTT.PartTranDetails.Account=MTT.InputDetails.CrAcct
	PRINT(MTT.InputDetails.CrAcct)
	sv_u = MTT.InputDetails.pymtRefNum
	sv_x = "CreditAccount,Status,SettlementMode | select benef_party_acct,"
	sv_x = sv_x + " status,settlement_mode from PORD "
	sv_x = sv_x + " where "
	sv_x = sv_x + " pymt_ref_num = '" + sv_u + "'"
	sv_x = sv_x + " AND bank_id = '" + BANCS.STDIN.contextBankId + "'"
	sv_t = urhk_dbSelectWithBind(sv_x)
	sv_v = BANCS.OUTPARAM.CreditAccount
	PRINT(sv_v)
	sv_w = BANCS.OUTPARAM.Status
	PRINT(sv_w)
	sv_x = BANCS.OUTPARAM.SettlementMode
	PRINT(sv_x)
	IF((sv_x == "W") AND (sv_w == "F") AND (sv_v != "")) THEN
	#{
		MTT.PartTranDetails.Account = sv_v
		PRINT(MTT.PartTranDetails.Account)
	#}
	ENDIF
	
	MTT.PartTranDetails.RefAmount= (CDOUBLE(MTT.InputDetails.remitAmt))
	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.remitCrncy
	MTT.PartTranDetails.RateCode = MTT.InputDetails.exchangeRateCode
	MTT.PartTranDetails.Rate = MTT.InputDetails.exchangeRate
	MTT.PartTranDetails.TreaRate = MTT.InputDetails.treasuryRate
	MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.treasuryRefNo
	
	IF (BANCS.STDIN.moduleIdentity == "FI") THEN
	#{
		sv_a = urhk_GetChannelInfo("")
		PRINT(sv_a)
		IF (sv_a!=0) THEN
		#{
			sv_u = urhk_SRV_SetErr("Error: Channel ID is not passed/Incorrect")
			#}
		ELSE
			#{
			BANCS.OUTPARAM.DccId = BANCS.OUTPARAM.DccId
			PRINT(BANCS.OUTPARAM.DccId)
		#}
		ENDIF
		IF(FIELDEXISTS(BANCS.OUTPARAM.DccId) == 1) THEN
		#{
			IF (BANCS.OUTPARAM.DccId!="XXX") THEN
			#{
				IF(FIELDEXISTS(BANCS.INPUT.pFreeText) == 1) THEN
				#{
					PRINT(BANCS.INPUT.pFreeText)
					IF(FIELDEXISTS(BANCS.INPUT.benefPartyName) == 1) THEN
					#{
						sv_f = BANCS.INPUT.benefPartyName
						PRINT(sv_f)
						IF(FIELDEXISTS(BANCS.INPUT.origPaysysId) == 1) THEN
						#{
							PRINT(BANCS.INPUT.origPaysysId)
							IF (BANCS.INPUT.origPaysysId=="RTGS") THEN
							#{
								sv_j = "RTGS:"
								PRINT(sv_j)
								IF (CUST.DATA.isBCDC!="0") THEN
									sv_j="CION TRANSFERT RTGS:"
									PRINT(sv_j)
								ENDIF
								#}
							ELSE
								#{
								sv_j = "SWIFT:"
								PRINT(sv_j)
								IF (CUST.DATA.isBCDC!="0") THEN
									sv_j="CION TRANSFERT SWIFT:"
									PRINT(sv_j)
								ENDIF
							#}
							ENDIF
							#}
						ELSE
							#{
							sv_j = "Payment:"
							PRINT(sv_j)
						#}
						ENDIF
						sv_f = sv_j + " " + BANCS.INPUT.pFreeText + " " + sv_f
						PRINT(sv_f)
						IF (FIELDEXISTS(BANCS.INPUT.senderToRecvrInfo5) == 1) THEN
						#{
							IF ((BANCS.INPUT.senderToRecvrInfo5!="") AND (BANCS.INPUT.senderToRecvrInfo5!=" ")) THEN
							#{
								sv_f = BANCS.INPUT.pFreeText + " " + BANCS.INPUT.senderToRecvrInfo5
								PRINT(sv_f)
							#}
							ENDIF
						#}
						ENDIF
						MTT.PartTranDetails.Particulars = MID$(sv_f,0,50)
						PRINT(MTT.PartTranDetails.Particulars)
						#}
					ELSE
						#{
						sv_f = "Cr.TRF :"
						PRINT(sv_f)
						MTT.PartTranDetails.Particulars = sv_f + " " + BANCS.INPUT.pFreeText
						PRINT(MTT.PartTranDetails.Particulars)
					#}
					ENDIF
					#}
				ELSE
					#{
					MTT.PartTranDetails.Particulars= "Cr. TRF :" + MTT.InputDetails.pymtRefNum
					print(MTT.PartTranDetails.Particulars)
				#}
				ENDIF
				#}
			ELSE
				#{
				MTT.PartTranDetails.Particulars= "Cr. TRF :" + MTT.InputDetails.pymtRefNum
				print(MTT.PartTranDetails.Particulars)
			#}
			ENDIF
			#}
		ELSE
			#{
			MTT.PartTranDetails.Particulars= "Cr. TRF :" + MTT.InputDetails.pymtRefNum
			print(MTT.PartTranDetails.Particulars)
		#}
		ENDIF
		#}
	ELSE
		#{
		MTT.PartTranDetails.Particulars= "Cr. TRF :" + MTT.InputDetails.pymtRefNum
		print(MTT.PartTranDetails.Particulars)
	#}
	ENDIF
	
	#MTT.PartTranDetails.Particulars= "Cr. TRF :" + MTT.InputDetails.pymtRefNum
	MTT.PartTranDetails.Consolidate="N"
	MTT.PartTranDetails.TranIdentifier = "PordPayment"
	MTT.PartTranDetails.PartTranIdentifier="PORD_CREDIT"
	MTT.PartTranDetails.PTranBusinessType="PORD"
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.CrValueDate
	MTT.PartTranDetails.Refnum = MTT.InputDetails.pymtRefNum
	MTT.PartTranDetails.EntryUserId = MTT.InputDetails.EntryUserId
	MTT.PartTranDetails.EntryTime   = MTT.InputDetails.EntryTime
	MTT.PartTranDetails.sysPartTranCode ="PTRN01289"
	PRINT("PTRN01289 : Cr. Cus. A/c. Payment Order Txn : Account=["+MTT.PartTranDetails.Account+"]RefCurrency["+MTT.PartTranDetails.RefCurrency+"]RefAmount=["+MTT.PartTranDetails.RefAmount+"]Rate=["+MTT.PartTranDetails.Rate+"]")
	sv_z = urhk_MTTS_DefinePartTran("PORD_CREDIT")
	PRINT(sv_z)
	IF (sv_z != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.scriptError = "urhk_MTTS_DefinePartTran returns FAILURE"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	###############################################################################
	# DR and CR to consolidated bacid specified at GCT level
	# These part trans are applicable only when charge collection currency and
	# remit currency are different.
	###############################################################################
	
	IF(MTT.InputDetails.consolBacid != "") THEN
	#{
		IF(sv_m != 0) THEN
		#{
			sv_d = MTT.InputDetails.consolBacid + "|"
			sv_d = sv_d + MTT.InputDetails.remitCrncy + "|"
			sv_d = sv_d + BANCS.STDIN.mySolId
			sv_e = urhk_B2k_BacidToAcctId(sv_d)
			IF(sv_e != 0) THEN
			#{
				MTT.Error.Description = "Account not available for " + MTT.InputDetails.remitCrncy + " AND sol id " + BANCS.STDIN.mySolId + " for consolidated placeholder"
				sv_f=urhk_MTTS_ReportErrorCondition("")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			BANCS.OUTPUT.ConsolAcct = BANCS.OUTPARAM.AcctId
			
			MTT.PartTranDetails.Account = BANCS.OUTPUT.ConsolAcct
			MTT.PartTranDetails.RefAmount= -sv_k
			MTT.PartTranDetails.RefCurrency=PORD.GLBDATA.chargeCrncy
			MTT.PartTranDetails.RateCode=PORD.GLBDATA.PTTRATECODE
			MTT.PartTranDetails.Rate = PORD.GLBDATA.PTTRATE
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDate
			MTT.PartTranDetails.Refnum = MTT.InputDetails.pymtRefNum
			MTT.PartTranDetails.Particulars= "Consolidated Dr TRF :" + MTT.InputDetails.pymtRefNum
			MTT.PartTranDetails.TranIdentifier="PordPayment"
			MTT.PartTranDetails.PTranBusinessType="PORD"
			
			MTT.PartTranDetails.EntryUserId = MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime   = MTT.InputDetails.EntryTime
			
			PRINT("PordPayment : Consolidated Dr TRF : Account=["+MTT.PartTranDetails.Account+"]RefCurrency["+MTT.PartTranDetails.RefCurrency+"]RefAmount=["+MTT.PartTranDetails.RefAmount+"]Rate=["+MTT.PartTranDetails.Rate+"]")
			sv_z = urhk_MTTS_DefinePartTran("PORD_CONSOL_DEBIT")
			IF(sv_z != 0) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.scriptError = "urhk_MTTS_DefinePartTran returns FAILURE"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			MTT.PartTranDetails.Account=BANCS.OUTPUT.ConsolAcct
			MTT.PartTranDetails.RefAmount=sv_c
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.remitCrncy
			MTT.PartTranDetails.RateCode=PORD.GLBDATA.PTTRATECODE
			MTT.PartTranDetails.Rate = PORD.GLBDATA.PTTRATE
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDate
			MTT.PartTranDetails.Refnum = MTT.InputDetails.pymtRefNum
			MTT.PartTranDetails.Particulars= "Consolidated Cr TRF :" + MTT.InputDetails.pymtRefNum
			MTT.PartTranDetails.TranIdentifier="PordPayment"
			MTT.PartTranDetails.PTranBusinessType="PORD"
			
			MTT.PartTranDetails.EntryUserId = MTT.InputDetails.EntryUserId
			MTT.PartTranDetails.EntryTime   = MTT.InputDetails.EntryTime
			
			PRINT("PordPayment : Consolidated Cr TRF : Account=["+MTT.PartTranDetails.Account+"]RefCurrency["+MTT.PartTranDetails.RefCurrency+"]RefAmount=["+MTT.PartTranDetails.RefAmount+"]Rate=["+MTT.PartTranDetails.Rate+"]")
			sv_z = urhk_MTTS_DefinePartTran("PORD_CONSOL_CREDIT")
			IF(sv_z != 0) THEN
			#{
				BANCS.OUTPUT.successOrFailure = "F"
				BANCS.OUTPUT.scriptError = "urhk_MTTS_DefinePartTran returns FAILURE"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		#}
	ELSE
		#{
		MTT.Error.Description = "Consolidated placeholder not specified"
		sv_f=urhk_MTTS_ReportErrorCondition("")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	###############################################################################
	###############################################################################
	
	MTT.OutputDetails.TotalChrgCrncy = MTT.InputDetails.remitCrncy
	MTT.OutputDetails.TotalChrgAmt = sv_k
	PRINT(sv_k)
	MTT.OutputDetails.RecvrBankChrgAmt = sv_r
	PRINT(sv_r)
	IF(MTT.InputDetails.remitCrncy != PORD.GLBDATA.chargeCrncy) THEN
	#{
		MTT.OutputDetails.SenderBankChrgCrncy = PORD.GLBDATA.chargeCrncy
		MTT.OutputDetails.RecvrBankChrgCrncy = PORD.GLBDATA.chargeCrncy
		#}
	ELSE
		#{
		MTT.OutputDetails.SenderBankChrgCrncy = MTT.InputDetails.remitCrncy
		MTT.OutputDetails.RecvrBankChrgCrncy = MTT.InputDetails.remitCrncy
	#}
	ENDIF
	
	
        IF(MTT.InputDetails.ChargeType=="BEN")then
        	MTT.OutputDetails.SenderBankChrgAmt = sv_k
        ELSE
       		MTT.OutputDetails.SenderBankChrgAmt = sv_s
        ENDIF

	PRINT(sv_s)
	MTT.OutputDetails.RerouteCrncy = MTT.InputDetails.remitCrncy
	MTT.OutputDetails.RerouteAmt = CDOUBLE(MTT.InputDetails.remitAmt)
	PRINT(MTT.OutputDetails.RerouteAmt)
	sv_z = urhk_MTTS_EndDefinition("")
	PRINT(sv_z)
	IF (sv_z != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.scriptError = "urhk_MTTS_EndDefinition returns FAILURE"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	PRINT(BANCS.OUTPARAM.MTTTranId)
	IF (sv_z != 0) THEN
	#{
		BANCS.OUTPUT.successOrFailure = "F"
		BANCS.OUTPUT.scriptError = "urhk_MTTS_EndDefinition returns FAILURE"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	ENDOFSCRIPT:
		EXITSCRIPT
