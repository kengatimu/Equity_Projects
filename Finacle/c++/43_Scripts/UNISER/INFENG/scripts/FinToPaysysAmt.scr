<--START
CHECKSUM="0d3efdc373cd3f6c849aaff334894efa05e915552bb299ef47ec4b1ca091a679"
        #************************************************************************
        # Formatting of amount from FiNACLE Amount format  to Paysys amount format
        #********************************************************************
        # Input  :
        #               BANCS.INPUT.PaysysId   --> Give PaysysId here as formatting may differ for dif. Payment System
        #                       BANCS.INPUT.FinAmt --> Give Input Amount here.
        # Output :
        #                       BANCS.OUTPUT.PaysysAmt   --> Script gives back formatted Amount here.
        #
        #********************************************************************
        TRACE ON
        BANCS.OUTPUT.PaysysAmt = "0"
        IF(BANCS.INPUT.FinAmt != "") THEN
        #{
                if((BANCS.INPUT.MessageId=="940")and(BANCS.STDIN.contextBankId=="43"))then
                        if(cdouble(BANCS.INPUT.FinAmt)<0)then
                        BANCS.INPUT.dumamt = trim(BANCS.INPUT.FinAmt)
                        BANCS.INPUT.FinAmt = trim(BANCS.INPUT.dumamt,'-')
                        print(BANCS.INPUT.FinAmt)
                        endif
                endif
                IF ((BANCS.INPUT.PaysysId == "SWIFT") OR (BANCS.INPUT.PaysysId == "RTGS")) THEN
                #{
                        #SWIFT will always have ',' in amount field
                        print(BANCS.INPUT.FinAmt)
                        BANCS.INPUT.FinAmt = ltrim(BANCS.INPUT.FinAmt, ' ')
                        sv_t = getposition(BANCS.INPUT.FinAmt, '.')
                        print(sv_t)
                        IF(sv_t != 0) THEN
                        #{
                                sv_l = mid$(BANCS.INPUT.FinAmt,sv_t,strlen(BANCS.INPUT.FinAmt)-sv_t)
                                print(sv_l)
                                IF (CDOUBLE(sv_l) == 0 ) THEN
                                #{
                                        BANCS.OUTPUT.PaysysAmt  = mid$(BANCS.INPUT.FinAmt,0,sv_t - 1) + ",00"
                                        print(BANCS.OUTPUT.PaysysAmt)
                                        #}
                                ELSE
                                        #{
                                        print(mid$(BANCS.INPUT.FinAmt,0,sv_t - 1))
                                        print(mid$(BANCS.INPUT.FinAmt,sv_t,strlen(BANCS.INPUT.FinAmt)-sv_t))
                                        BANCS.OUTPUT.PaysysAmt  = mid$(BANCS.INPUT.FinAmt,0,sv_t - 1) + "," + mid$(BANCS.INPUT.FinAmt,sv_t,strlen(BANCS.INPUT.FinAmt)-sv_t)
                                        print(BANCS.OUTPUT.PaysysAmt)
                                #}
                                ENDIF
                                #}
                        ELSE
                                #{
                                BANCS.OUTPUT.PaysysAmt  = BANCS.INPUT.FinAmt + ",00"
                                print(BANCS.OUTPUT.PaysysAmt)

                        #}
                        ENDIF
                #}
                ENDIF
        #}
        ENDIF
#       TRACE OFF
END-->
