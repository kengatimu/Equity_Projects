			print(MISS.CHRG.clr_bal_amt)
			
			
			MISS.CHRG.stamp = "Y"

		

			#------------------------------------------
                        # counter setting for defining different PartTran
                        #------------------------------------------
                        	sv_z = sv_z + 1
                                MISS.CHRG.Counter = sv_z

			#--------------------------------------------------------------------------
			# Create the narration
			#--------------------------------------------------------------------------

			
			sv_m = "TRADE SWEEPS-"
			print(sv_m)
			sv_y = MISS.CHRG.foracid
			sv_x = " "
			sv_k = MISS.CHRG.acct_name
			print(sv_k)
			sv_w = sv_m + sv_y + sv_x + sv_k
			print(sv_w)
			MISS.CHRG.narr1 = sv_w
			print(MISS.CHRG.narr1)

			sv_s = "sol_idincm,foracidincm,acct_nameincm,bacidincm,acct_crncy_codeincm,schm_codeincm,clr_bal_amtincm|  "
			sv_s = sv_s + " select sol_id,foracid,acct_name,bacid,acct_crncy_code,schm_code,clr_bal_amt  from tbaadm.gam "
			sv_s = sv_s + "  where bank_id=?SVAR  and clr_bal_amt>0 and bacid in  "
			sv_s = sv_s + " ('INTINCBCD','INTINCINVF','INTINCONF','INTINCPREF','INTINCIMPC','INTINCEXPC','INTINCIMLC','INTINCEXLC','INTFINBDC','INTFINPRE') and ACCT_CRNCY_CODE='CDF' "
			sv_s = sv_s + " and sol_id=?SVAR and bacid= ?SVAR  "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|"+ MISS.CHRG.sol_id +"|"+ MISS.CHRG.bacid
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbselectWithBind(sv_s)
			IF (sv_d =="0") THEN
				MISS.CHRG.sol_idincm = BANCS.OUTPARAM.sol_idincm
				print(MISS.CHRG.sol_idincm)
				MISS.CHRG.foracidincm = BANCS.OUTPARAM.foracidincm
				print(MISS.CHRG.foracidincm)
				MISS.CHRG.acct_nameincm = BANCS.OUTPARAM.acct_nameincm
				print(MISS.CHRG.acct_nameincm)
				MISS.CHRG.bacidincm = BANCS.OUTPARAM.bacidincm
				print(MISS.CHRG.bacidincm)
				MISS.CHRG.acct_crncy_codeincm = BANCS.OUTPARAM.acct_crncy_codeincm
				print(MISS.CHRG.acct_crncy_codeincm)
				MISS.CHRG.schm_codeincm = BANCS.OUTPARAM.schm_codeincm
				print(MISS.CHRG.schm_codeincm)
				MISS.CHRG.clr_bal_amtincm = BANCS.OUTPARAM.clr_bal_amtincm
				print(MISS.CHRG.clr_bal_amtincm)
			ENDIF

			MISS.CHRG.narr3 = MISS.CHRG.getboddate
			print(MISS.CHRG.narr3)
			
			sv_m = "TRADE SWEEPS-"
			print(sv_m)
			sv_y = MISS.CHRG.foracidincm
			sv_x = " "
			sv_k = MISS.CHRG.acct_nameincm
			print(sv_k)
			sv_w = sv_m + sv_y + sv_x + sv_k
			print(sv_w)
			MISS.CHRG.narr2 = sv_w
			print(MISS.CHRG.narr2)

			MISS.CHRG.wtax_amt = ""
			print(MISS.CHRG.wtax_amt)

			#--------------------------------------------------
        		# Withholding Tax Account
        		#--------------------------------------------------

        		IF (MISS.CHRG.stamp == "Y") THEN

                		MTT.PartTranDetails.Account = MISS.CHRG.foracidincm
				print(MTT.PartTranDetails.Account)
                		MTT.PartTranDetails.RefCurrency = MISS.CHRG.acct_crncy_code
				IF (MISS.CHRG.acct_crncy_code!=BANCS.STDIN.homeCrncyCode) THEN
                                        MTT.PartTranDetails.RateCode = "TTS"
                                        MTT.PartTranDetails.Rate = ""
                                ENDIF
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr1  
				MTT.PartTranDetails.Particulars2 = MISS.CHRG.narr2
                		MTT.PartTranDetails.RefAmount = cdouble(MISS.CHRG.clr_bal_amt)
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.narr3
                		MTT.PartTranDetails.RefNum = MISS.CHRG.foracid
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_e = "Credt" + MISS.CHRG.Counter
				print(sv_e)
                		sv_r = urhk_MTTS_definePartTran(sv_e)
                		print(sv_r)

        		ENDIF

			#------------------------------------------------------------------
        		# Customer Debit Partran
        		#------------------------------------------------------------------

               			MTT.PartTranDetails.Account = MISS.CHRG.foracid
                		MTT.PartTranDetails.RefCurrency = MISS.CHRG.acct_crncy_code
                                IF (MISS.CHRG.acct_crncy_code!=BANCS.STDIN.homeCrncyCode) THEN
                                        MTT.PartTranDetails.RateCode = "TTS"
                                        MTT.PartTranDetails.Rate = ""
                                ENDIF
                                MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars2 =MISS.CHRG.narr2
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr1
                		sv_a = cdouble(MISS.CHRG.clr_bal_amt)
				print(sv_a)
				sv_a = -(sv_a)
				print(sv_a)
                		MTT.PartTranDetails.RefAmount = sv_a
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.narr3
                		MTT.PartTranDetails.RefNum = MISS.CHRG.foracidincm
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_h = "Debit" + MISS.CHRG.Counter
				print(sv_h)
                		sv_u = urhk_MTTS_definePartTran(sv_h)
				print(sv_u)
		#}
			#######
			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)

			MISS.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
			print(MISS.CHRG.tranid)

			print(BANCS.STDIN.userId)

			print(BANCS.STDIN.sysDate)

			print(BANCS.STDIN.BODDate)

			sv_g = mid$(BANCS.STDIN.sysDate,0,10) 
			print(sv_g)
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)

			########
		ENDIF
	DO

	sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor) 

