<--START
	TRACE ON
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether GCHRG Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","GCHRG")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","GCHRG",5)
	#}
	ENDIF
	CUST.GCHRG.gchSrlNum = ""

	IF(FIELDEXISTS(BANCS.INPUT.srvcallmode))THEN
	#{
		CUST.GCHRG.srvcallmode = BANCS.INPUT.srvcallmode
	#}
	ELSE
	#{
		CUST.GCHRG.srvcallmode = ""
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranId")
	CUST.GCHRG.tranId = TRIM(BANCS.OUTPARAM.srvValue)
	PRINT(CUST.GCHRG.tranId)

	sv_u = urhk_SRV_GetVal("tranHdr.tranIdentifier.tranDate")
	PRINT(sv_u)
	CUST.GCHRG.tranDate = BANCS.OUTPARAM.srvValue
	PRINT(CUST.GCHRG.tranDate)

	sv_s = "count|SELECT COUNT(1) FROM CUSTOM.C_SMS_CHARGE_TBL WHERE TRIM(MAIN_TRAN_ID) = TRIM(?SVAR) AND BANK_ID=?SVAR AND TO_DATE(TRAN_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY')"
	BANCS.INPARAM.BINDVARS = CUST.GCHRG.tranId + "|" + BANCS.STDIN.contextBankId + "|" + MID$(CUST.GCHRG.tranDate,0,10)
	sv_u =  urhk_dbSelectWithBind(sv_s)
	IF(sv_u == "0")	THEN
	#{
		CUST.GCHRG.count = BANCS.OUTPARAM.count
		PRINT(CUST.GCHRG.count)
	#}
	ENDIF

	IF(CUST.GCHRG.count > 0)THEN
	#{
		sv_s = "gchrgsrlNum,tranType,transubType,chrgAmt,chrgCrncy,eventId,drAcctId,crncyCode|SELECT CHRG_SRL_NUM,TRAN_TYPE,TRAN_SUB_TYPE,CHRG_AMT,CHRG_CRNCY"
		sv_s = sv_s + ",EVENT_ID,DR_ACCT,CRNCY_CODE FROM CUSTOM.C_SMS_CHARGE_TBL WHERE TRIM(MAIN_TRAN_ID) = TRIM(?SVAR) AND BANK_ID=?SVAR AND "
		sv_s = sv_s + "TO_DATE(TRAN_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY')"
	        BANCS.INPARAM.BINDVARS = CUST.GCHRG.tranId + "|" + BANCS.STDIN.contextBankId + "|" + MID$(CUST.GCHRG.tranDate,0,10)
	        sv_p = urhk_dbCursorOpenWithBind(sv_s)
        	PRINT(sv_p)
        	IF(sv_p!=0) THEN
        	#{
                	GOTO ENDOFSCRIPT

        	#}
        	ENDIF


        	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        	PRINT(sv_n)

        	sv_f = urhk_dbCursorFetch(sv_n)
        	PRINT(sv_f)
        	WHILE(sv_f == 0)
        	#{

                	CUST.GCHRG.gchSrlNum 	= BANCS.OUTPARAM.gchrgsrlNum
                	CUST.GCHRG.tranType 	= BANCS.OUTPARAM.tranType
                	CUST.GCHRG.tranSubType 	= BANCS.OUTPARAM.transubType
                	CUST.GCHRG.chrgAmt 	= BANCS.OUTPARAM.chrgAmt
                	CUST.GCHRG.chrgCrncy 	= BANCS.OUTPARAM.chrgCrncy
                	CUST.GCHRG.eventId 	= BANCS.OUTPARAM.eventId
                	CUST.GCHRG.drAcctId 	= BANCS.OUTPARAM.drAcctId
                	CUST.GCHRG.acctCrncyCode= BANCS.OUTPARAM.crncyCode
			PRINT(CUST.GCHRG.gchSrlNum)
			PRINT(CUST.GCHRG.tranType)
			PRINT(CUST.GCHRG.tranSubType)
			PRINT(CUST.GCHRG.chrgAmt)
			PRINT(CUST.GCHRG.chrgCrncy)
			PRINT(CUST.GCHRG.eventId)
			PRINT(CUST.GCHRG.drAcctId)
			PRINT(CUST.GCHRG.acctCrncyCode)

			IF(CUST.GCHRG.gchSrlNum == "")THEN
			#{
				GOTO NEXTRCRD
			#}
			ENDIF

	sv_a = urhk_SetUrhkInp("genChrgCrit.gchSrlNum|" + CUST.GCHRG.gchSrlNum)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|" + CUST.GCHRG.tranType)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|" + CUST.GCHRG.tranSubType)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.GCHRG.drAcctId)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" + CUST.GCHRG.eventId)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgAmt|" + CUST.GCHRG.chrgAmt+"|"+CUST.GCHRG.chrgCrncy)
	print(sv_u)
	sv_u = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" + CUST.GCHRG.acctCrncyCode)
	print(sv_u)
	
	
	IF(CUST.GCHRG.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#}
	ELSE
		#{
		sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			print(sv_u)
			
			sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------------------------
	# Checking for errors
	#---------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		CUST.GCHRG.successOrFailure	= "F"
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				print(sv_e)
				CUST.GCHRG.gchrgErrMsg = CUST.GCHRG.gchrgErrMsg + " ! " + sv_e
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				print(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.OUTPARAM.Xcpn_num) == 1)THEN
		#{
			sv_d = 1
			sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
			WHILE (sv_d <= sv_c)
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_e = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
				PRINT(sv_e)
				
				sv_d = sv_d + 1
				sv_n = sv_n + 1
				sv_d = sv_c + 1
			#}
			DO
		#}
		ENDIF
		
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	##################################################
	# VerifyGenChrgDtl
	##################################################
	
	sv_u = urhk_CopyOutToIn("")
	print(sv_u)
	
	sv_a = urhk_SetUrhkInp("genChrgCrit.gchSrlNum|" + CUST.GCHRG.gchSrlNum)
	sv_a = urhk_SetUrhkOut("genChrgCrit.tranId|tranId")
	sv_a = urhk_SetUrhkOut("genChrgCrit.tranDate|tranDate")
	
	IF(CUST.GCHRG.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#}
	ELSE
		#{
		sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			print(sv_u)
			
			sv_a = urhk_SetUrhkOut("genChrgCrit.tranId|tranId")
			sv_a = urhk_SetUrhkOut("genChrgCrit.tranDate|tranDate")
			sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------------------------------
	# Checking for errors
	#---------------------------------------------------------------------------------------------------
	IF (sv_u != 0) THEN
	#{
		CUST.GCHRG.successOrFailure	= "F"
		IF (FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
		#{
			print(BANCS.OUTPARAM.Error_num)
			sv_v = BANCS.OUTPARAM.Error_num
			#}
		ELSE
			#{
			sv_v = 0
		#}
		ENDIF
		IF (sv_v > 0) THEN
		#{
			sv_i = 1
			WHILE (sv_i <= sv_v)
			#{
				sv_f = FORMAT$(sv_i,"%d")
				sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
				print(sv_e)
				CUST.GCHRG.gchrgErrMsg = CUST.GCHRG.gchrgErrMsg + " ! " + sv_e
				sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
				print(sv_e)
				sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
				print(sv_e)
				sv_i = sv_i + 1
			#}
			DO
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.OUTPARAM.Xcpn_num) == 1)THEN
		#{
			sv_d = 1
			sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
			WHILE (sv_d <= sv_c)
			#{
				sv_f = FORMAT$(sv_d,"%d")
				sv_e = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
				PRINT(sv_e)
				
				sv_d = sv_d + 1
				sv_n = sv_n + 1
				sv_d = sv_c + 1
			#}
			DO
		#}
		ENDIF
		
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.GCHRG.chargeTranId = BANCS.OUTPARAM.tranId
	print(CUST.GCHRG.chargeTranId)
	CUST.GCHRG.cTranDate = BANCS.OUTPARAM.tranDate
	CUST.GCHRG.chargeTranDate = MID$(BANCS.OUTPARAM.tranDate,0,10)
	print(CUST.GCHRG.chargeTranDate)
	
	#---------------------------------------------------------------------------------------------------
	# Checking for unposted transactions in DTD
	#---------------------------------------------------------------------------------------------------
	sv_s = "dCount|SELECT count(1) FROM TBAADM.DTD "
	sv_s = sv_s + " WHERE DTD.tran_id =?SVAR "
	sv_s = sv_s + " AND DTD.TRAN_DATE = to_date(?SVAR,'dd-mm-yyyy')"
	sv_s = sv_s + " AND DTD.pstd_flg = 'N' "
	sv_s = sv_s + " AND DTD.del_flg='N' "
	sv_s = sv_s + " AND DTD.bank_id=?SVAR "
	sv_s = sv_s + " AND ENTRY_USER_ID = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.GCHRG.chargeTranId + "|" + CUST.GCHRG.chargeTranDate + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	CUST.GCHRG.dCount = BANCS.OUTPARAM.dCount
	
	IF (CUST.GCHRG.dCount != 0) THEN
	#{
		sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+CUST.GCHRG.cTranDate)
		sv_u = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranId|"+CUST.GCHRG.chargeTranId)
		sv_u = urhk_SetUrhkInp("tranDtl.ignoreXcpnFlg|Y")
		sv_u = urhk_SetUrhkInp("tranDtl.pstFlg|Y")
		
		IF(CUST.GCHRG.srvcallmode == "E")THEN
		#{
			sv_u = urhk_ExecSrvNoCommit("SRV_FetchTranDtlsForPost|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_ExecSrvNoCommit("SRV_FetchTranDtlsForPost|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
			
			IF(sv_u != 0)THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				print(sv_u)
				
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
				sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
				
				sv_u = urhk_ExecSrvNoCommit("SRV_FetchTranDtlsForPost|same_user_verify = Y|retain_all_output = Y")
				print(sv_u)
			#}
			ENDIF
		#}
		ENDIF
		
		
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
				#}
			ELSE
				#{
				sv_v = 0
			#}
			ENDIF
			
			IF (sv_v > 0) THEN
			#{
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					print(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
				#}
				DO
			#}
			ENDIF
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.Xcpn_num) == 1)THEN
			#{
				sv_d = 1
				sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
				WHILE (sv_d <= sv_c)
				#{
					sv_f = FORMAT$(sv_d,"%d")
					sv_e = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
					PRINT(sv_e)
					
					sv_d = sv_d + 1
					sv_n = sv_n + 1
					sv_d = sv_c + 1
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF
		
		
		sv_u = urhk_SetUrhkOut("tranHdr.tranIdentifier.tranId|tranId")
		sv_u = urhk_SetUrhkOut("tranHdr.tranIdentifier.tranDate|tranDate")
		sv_u = urhk_SetUrhkOut("tranDtl.ignoreXcpnFlg|ignoreXcpnFlg")
		
		IF(CUST.GCHRG.srvcallmode == "E")THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
			
			IF(sv_u != 0)THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				print(sv_u)
				sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
				print(sv_u)
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_u = urhk_CopyOutToIn("")
			sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
			
			IF(sv_u != 0)THEN
			#{
				sv_u = urhk_CopyOutToIn("")
				print(sv_u)
				sv_u = urhk_ExecSrvNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
				print(sv_u)
			#}
			ENDIF
		#}
		ENDIF
		
		IF (sv_u != 0) THEN
		#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
			#{
				print(BANCS.OUTPARAM.Error_num)
				sv_v = BANCS.OUTPARAM.Error_num
				#}
			ELSE
				#{
				sv_v = 0
			#}
			ENDIF
			
			IF (sv_v > 0) THEN
			#{
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					print(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
				#}
				DO
			#}
			ENDIF
			
			IF(FIELDEXISTS(BANCS.OUTPARAM.Xcpn_num) == 1)THEN
			#{
				sv_d = 1
				sv_c = CINT(BANCS.OUTPARAM.Xcpn_num)
				WHILE (sv_d <= sv_c)
				#{
					sv_f = FORMAT$(sv_d,"%d")
					sv_e = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_f)
					PRINT(sv_e)
					
					sv_d = sv_d + 1
					sv_n = sv_n + 1
					sv_d = sv_c + 1
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	NEXTRCRD:

        sv_f = urhk_dbCursorFetch(sv_n)
        PRINT(sv_f)

        #}
        DO
        sv_p = urhk_dbCursorClose(sv_n)
        PRINT(sv_p)

	#}
	ENDIF	
	
	ENDOFSCRIPT:
		
		EXITSCRIPT
END-->
		
