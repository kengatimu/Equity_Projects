<--START
TRACE ON

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
        #{
                CREATECLASS("CUST", "DATA", 5)
        #}
        ENDIF

	CUST.DATA.cifID = ""
	CUST.DATA.cifID2 = " "
	CUST.DATA.cifID1 = " "
        sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
        PRINT(sv_u)
        CUST.DATA.tranType = BANCS.OUTPARAM.srvValue

        sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
        PRINT(sv_u)
        CUST.DATA.tranSubType = BANCS.OUTPARAM.srvValue
        sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")
        PRINT(sv_u)
        IF (sv_u == 0) THEN
        #{
	        CUST.DATA.NumOfRecs = BANCS.OUTPARAM.srvValue
                PRINT(CUST.DATA.NumOfRecs)
	#}
	ENDIF
	IF(CUST.DATA.NumOfRecs == "0")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

		
IF((CUST.DATA.tranType == "T") AND (CUST.DATA.tranSubType == "CI"))THEN
#{
	CUST.DATA.cifID1 = ""
	CUST.DATA.cifID2 = ""
			
	sv_l = 0
	WHILE(sv_l < 2)
	#{
                sv_v = Format$(sv_l,"%d")
                sv_r = "<rec_"+sv_v+">"
                PRINT(sv_r)

                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
                PRINT(sv_u)		
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.DATA.partTranType = BANCS.OUTPARAM.srvValue
                sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")
		PRINT(BANCS.OUTPARAM.srvValue)
		CUST.DATA.foracid = BANCS.OUTPARAM.srvValue
		sv_s = "cifId|SELECT NMA_KEY_ID FROM TBAADM.AAS WHERE BANK_ID=?SVAR AND RELATED_PARTY_TYPE='CUSTOMER' AND ACID = (SELECT ACID FROM TBAADM.GAM"
		sv_s = sv_s + " WHERE BANK_ID=?SVAR AND FORACID=?SVAR)"
		BANCS.INPARAM.BINDVARS= BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.foracid
        	PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbCursorOpenWithBind(sv_s)
        	PRINT(sv_d)
        	IF(sv_d !=0) THEN
        	#{
                	CUST.DATA.errMsg = "DB Error: | Error in opening cursor, Please contact DBA"
                	PRINT(CUST.DATA.errMsg)
                	GOTO ENDOFSCRIPT
        	#}
        	ENDIF


        	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
        	PRINT(sv_n)

        	sv_f = urhk_dbCursorFetch(sv_n)
        	PRINT(sv_f)
        	IF(sv_f!=0) THEN
        	#{
               		CUST.DATA.errMsg = "DB Error: | No accounts exist"
                	PRINT(CUST.DATA.errMsg)
                	GOTO ENDOFSCRIPT
        	#}
        	ENDIF
        	WHILE(sv_f == 0)
        	#{

			IF(sv_k == "0")THEN
			#{
				IF(sv_v == 0)THEN
				#{
					IF(TRIM(CUST.DATA.cifID1) == "")THEN
					#{
						CUST.DATA.cifID1 = BANCS.OUTPARAM.cifId
					#}
					ELSE
					#{
						CUST.DATA.cifID1 = CUST.DATA.cifID1 + "," + BANCS.OUTPARAM.cifId
					#}
					ENDIF
				#}
				ELSE
				#{
                                        IF(TRIM(CUST.DATA.cifID2) == "")THEN
                                        #{
                                                CUST.DATA.cifID2 = BANCS.OUTPARAM.cifId
                                        #}
                                        ELSE
                                        #{
                                                CUST.DATA.cifID2 = CUST.DATA.cifID2 + "," + BANCS.OUTPARAM.cifId
                                        #}
                                        ENDIF
				#}
				ENDIF
			#}
			ENDIF
                        sv_f = urhk_dbCursorFetch(sv_n)
                        PRINT(sv_f)

                #}
                DO
                sv_c = urhk_dbCursorClose(sv_n)
                PRINT(sv_c)

	       sv_l= sv_l+1
       #}
       DO

		PRINT(CUST.DATA.cifID1)
		PRINT(CUST.DATA.cifID2)
		sv_a = ""
		sv_b = CUST.DATA.cifID1
		sv_c = GETPOSITION(sv_b,",")
		IF(sv_c!=0) THEN
		#{
	
			sv_l =STRLEN(sv_b)
			PRINT(sv_l)
			PRINT(sv_c)
			WHILE(sv_c !=0)
			#{
				sv_a =MID$(sv_b,0,sv_c - 1)
				PRINT(sv_a)
				PRINT(CUST.DATA.cifID2)
				sv_d = GETPOSITION(CUST.DATA.cifID2,sv_a)
				PRINT(sv_d)					
				IF(sv_d != "0")THEN
				#{
					GOTO REMOVECHRG
				#}
				ENDIF
				sv_b=MID$(sv_b,sv_c,sv_l)
				PRINT(sv_b)
				sv_c = GETPOSITION(sv_b,",")
				sv_l =STRLEN(sv_b)
				PRINT(sv_l)
				PRINT(sv_c)
				IF(sv_c == "0")THEN
				#{
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			DO
			sv_y = sv_a
		#}
		ELSE
		#{
			IF(TRIM(CUST.DATA.cifID1) != "")THEN
			#{
				sv_d = GETPOSITION(CUST.DATA.cifID2,CUST.DATA.cifID1)
                	        IF(sv_d != "0")THEN
                                #{
                                        GOTO REMOVECHRG
                                #}
				ELSE
				#{
					GOTO ENDOFSCRIPT
				#}
                                ENDIF
			#}
			ELSE
			#{
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
			
		REMOVECHRG:
                sv_l = 0
                PRINT(sv_l)
                WHILE(sv_l < CUST.DATA.NumOfRecs)
                #{
                        sv_v = Format$(sv_l,"%d")
                        sv_r = "<rec_"+sv_v+">"
                        PRINT(sv_r)

                        sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
                        PRINT(sv_u)		
			CUST.DATA.partTranType = BANCS.OUTPARAM.srvValue
			IF(CUST.DATA.partTranType == "D")THEN
			#{
				sv_u = urhk_SRV_SetVal("tranDtl.partTranDetailLL." +sv_r+ ".pTranChrgEventId.eventId| ")
			#}
			ENDIF
			sv_l= sv_l+1
		#}
		DO		
			

	#}
	ENDIF
ENDOFSCRIPT:
	TRACE OFF
END-->

