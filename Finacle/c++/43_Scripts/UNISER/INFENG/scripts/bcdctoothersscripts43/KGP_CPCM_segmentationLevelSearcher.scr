		sv_s = ""
		sv_d = ""
		sv_u = ""
		CPCM.DATA.recCounter    = "0"
		CPCM.DATA.CursorNum = ""
		CPCM.DATA.Date =  mid$(BANCS.STDIN.BODDate,0,10)
		PRINT(CPCM.DATA.Date)

        #----------------------------------------
        # To Derive Records For Searcher
        #----------------------------------------
        
		CPCM.DATA.funcCode    =       BANCS.INPUT.funcCode
		PRINT(CPCM.DATA.funcCode)

		CPCM.DATA.segmentationLevel    =       BANCS.INPUT.segmentationLevel
		PRINT(CPCM.DATA.segmentationLevel)

        #----------------------------------------------
        #Query for Fetching Customer Id based on Function Code
        #----------------------------------------------

	sv_s    = "segmentationLevel,segmentationDesc|SELECT M.VALUE,N.LOCALETEXT from CRMUSER.CATEGORIES M,CRMUSER.CATEGORY_LANG N "
	sv_s = sv_s + " WHERE M.CATEGORYID= N.CATEGORYID and CATEGORYTYPE = 'SEGMENTATION_CLASS' and M.BANK_ID = N.BANK_ID"
	PRINT(sv_s)

	BANCS.INPARAM.BINDVARS  = BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)	

        sv_d = urhk_dbCursorOpenWithBind(sv_s)
        PRINT(sv_d)

        IF (sv_d == 0) THEN
        #{
                CPCM.DATA.CursorNum     =       BANCS.OUTPARAM.DB_CURSOR_NUMBER
                PRINT(CPCM.DATA.CursorNum)
                sv_f = urhk_dbCursorFetch(CPCM.DATA.CursorNum)
                PRINT(sv_f)
                IF(sv_f == 0) THEN
                #{
                        WHILE (sv_f == 0)
                        #{
                                CPCM.DATA.recCounter            =       CINT(CPCM.DATA.recCounter) + 1

                                CPCM.DATA.segmentationLevel =       BANCS.OUTPARAM.segmentationLevel
				print(CPCM.DATA.segmentationLevel)
	
				CPCM.DATA.segmentationDesc	= BANCS.OUTPARAM.segmentationDesc
				print(CPCM.DATA.segmentationDesc)

                                sv_z = urhk_SetOrbOut("count|"+CPCM.DATA.recCounter)
                                PRINT(sv_z)

                                sv_u = urhk_SetOrbOut("segmentationLevel_" + CPCM.DATA.recCounter + "| " + CPCM.DATA.segmentationLevel)
				print(sv_u)	
				sv_z = urhk_SetOrbOut("segmentationDesc_" + CPCM.DATA.recCounter + "| " + CPCM.DATA.segmentationDesc)
				print(sv_z)	
                                sv_f = urhk_dbCursorFetch(CPCM.DATA.CursorNum)
                                PRINT(sv_f)

                                IF(sv_f != 0) THEN
                                #{
                                        sv_u = urhk_dbCursorClose(CPCM.DATA.CursorNum)
                                        GOTO ENDOFSCRIPT
                                #}
                                ENDIF
                        #}
                        DO
                        sv_u = urhk_dbCursorClose(CPCM.DATA.CursorNum)
		#}
		ENDIF
	#}
	ENDIF

ENDOFSCRIPT:
	
