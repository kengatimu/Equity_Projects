<--start
trace on
#Rep/Class
	if(repexists("EBSRV")==0)then
		createrep("EBSRV")
	endif
	if(classexists("EBSRV","GLBDATA")==0)then
		createclass("EBSRV","GLBDATA",5)
	endif
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_r = urhk_MTTS_PopulateInputDetails("")
        print(sv_r)
        if(sv_r==0)then
                EBSRV.GLBDATA.PoNumber = MTT.InputDetails.Argument1
                EBSRV.GLBDATA.PoAmount = MTT.InputDetails.Argument2
                EBSRV.GLBDATA.PoCrAcctId = MTT.InputDetails.Argument3
                EBSRV.GLBDATA.PoStatus = MTT.InputDetails.Argument4
		EBSRV.GLBDATA.DrAcct = MTT.InputDetails.Argument5
		EBSRV.GLBDATA.AwiBIC = MTT.InputDetails.Argument6
		EBSRV.GLBDATA.PoCtry = MTT.InputDetails.Argument7
		EBSRV.GLBDATA.AwiName = MTT.InputDetails.Argument8
		EBSRV.GLBDATA.CRNCY = MTT.InputDetails.Argument9
        else

                EBSRV.GLBDATA.PoNumber = "" 
                EBSRV.GLBDATA.PoAmount = "" 
                EBSRV.GLBDATA.PoCrAcctId = "" 
                EBSRV.GLBDATA.PoStatus = ""		 
		EBSRV.GLBDATA.DrAcct = "" 
		EBSRV.GLBDATA.AwiBIC = ""
		EBSRV.GLBDATA.PoCtry = "" 
		EBSRV.GLBDATA.AwiName = "" 
		EBSRV.GLBDATA.CRNCY = ""
        endif
	print(EBSRV.GLBDATA.PoNumber)
	print(EBSRV.GLBDATA.PoAmount)
	print(EBSRV.GLBDATA.PoCrAcctId)
	print(EBSRV.GLBDATA.PoStatus)
	EBSRV.GLBDATA.isModuleType = "SWIFT"
	EBSRV.GLBDATA.toAddr = "christian.bakaly@equitybcdc.cd,ebanking_bo@equitybcdc.cd"
	sv_u = urhk_getFileLocation("COM|SwiftAlertUg.com")
	if(sv_u ==0)then
		print(BANCS.OUTPARAM.fileLocation)
		EBSRV.GLBDATA.comfil = BANCS.OUTPARAM.fileLocation + "SwiftAlertCd.com"
		print(EBSRV.GLBDATA.comfil)
		print(EBSRV.GLBDATA.toAddr)
		if(EBSRV.GLBDATA.isModuleType=="SWIFT")then
			EBSRV.GLBDATA.comfil = EBSRV.GLBDATA.comfil + " " +'"'+ EBSRV.GLBDATA.toAddr + '"'+" " +'"'+ EBSRV.GLBDATA.PoNumber+'"'+ " " +'"'+ EBSRV.GLBDATA.PoAmount +'"'+ " " +'"'+ EBSRV.GLBDATA.PoCrAcctId +'"'+ " " +'"'+ EBSRV.GLBDATA.CRNCY +'"'+ " " +'"'+ EBSRV.GLBDATA.isModuleType +'"'+ " " +'"'+ EBSRV.GLBDATA.DrAcct +'"'+ " " +'"'+ EBSRV.GLBDATA.AwiBIC +'"'+ " " +'"'+ EBSRV.GLBDATA.PoCtry +'"'+ " " +'"'+ EBSRV.GLBDATA.AwiName +'"'+ " "
		endif
	else
		EBSRV.GLBDATA.comfil   = ""
	endif
	if(EBSRV.GLBDATA.comfil != "")then
		print(EBSRV.GLBDATA.comfil)
		sv_u = system(EBSRV.GLBDATA.comfil)
		if(sv_u ==0)then
			print("smtp success")
		else
			print("failed smtp")
		endif
	endif
#trace off
end-->
