###########################################################################################
#
#  Script Name : OtherPaymentSystemToSWIFT.scr
#
#  Description : This script maps the other payment system message number 
#				 with the SWIFT payment system message number
#
#  Author      : Pradeep B.R
#                Rakesh B.N
#
#  Date        : 13-5-2010
#
###########################################################################################
#
<--start
#trace on
#-------------------------- Initializing Variables ----------------------------#

BANCS.OUTPUT.MappedSWIFTMsgNum = ""

if(BANCS.INPUT.OtherPaysysId=="SWIFT")  then
        BANCS.OUTPUT.MappedSWIFTMsgNum  = BANCS.INPUT.OtherPaysysMsgNum
endif
#------------------------------------------------------------------------------#

if(BANCS.INPUT.OtherPaysysId=="SFMS")  then

    if(BANCS.INPUT.OtherPaysysMsgNum=="100") then
        BANCS.OUTPUT.MappedSWIFTMsgNum  = "103"
    	exitscript
	endif
	
    BANCS.OUTPUT.MappedSWIFTMsgNum = BANCS.INPUT.OtherPaysysMsgNum
endif

exitscript
#trace off
end-->
#------------------------------- END OF SCRIPT--------------------------------#
