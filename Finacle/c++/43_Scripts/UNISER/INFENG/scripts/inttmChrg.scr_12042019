<--START
TRACE ON

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST","DATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","DATA",5)
        #}
        ENDIF

        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.acctNum = " "
        CUST.DATA.newprefInt = "0"
        CUST.DATA.oldprefInt = "0"
	CUST.DATA.chnlprefInt = "0"
        CUST.DATA.chrgCrncy = " "
        CUST.DATA.chrgAmt = " "
        CUST.DATA.vatAmt = " "
        CUST.DATA.acid = " "
        CUST.DATA.crncyCode = " "
	CUST.DATA.schmCode = " "
	CUST.DATA.tranAmt = "0"

        IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
        #{
                IF(BANCS.INPUT.acctNum !="")THEN
                #{
                        CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
                        PRINT(CUST.DATA.acctNum)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Account Number not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Account Number not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "schmCode|SELECT SCHM_CODE FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
		CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(CUST.DATA.schmCode)
	#}
	ELSE
	#{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Invalid Account"
                GOTO ENDOFSCRIPT
	#}
	ENDIF

        BANCS.INPUT.moduleName  = "OT"
        BANCS.INPUT.parameterId = "ODSAN_SCHMS"
        CALL ("getcparamvalue.scr")
        IF(BANCS.OUTPUT.parameterVal != "")THEN
        #{
                CUST.DATA.schmparmVal = BANCS.OUTPUT.parameterVal
                #}
        ELSE
                #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                GOTO ENDOFSCRIPT

        #}
        ENDIF

        sv_p = GETPOSITION(CUST.DATA.schmparmVal,CUST.DATA.schmCode)
        PRINT(sv_p)

        IF(sv_p <= "0")THEN
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF


        IF(FIELDEXISTS(BANCS.INPUT.newprefInt))THEN
        #{
                IF(BANCS.INPUT.newprefInt !="")THEN
                #{
                        CUST.DATA.newprefInt = TOUPPER(TRIM(BANCS.INPUT.newprefInt))
                        PRINT(CUST.DATA.newprefInt)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Preferential Interest Not Entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Preferential Interest Not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.chnlprefInt))THEN
        #{
                IF(BANCS.INPUT.chnlprefInt !="")THEN
                #{
                        CUST.DATA.chnlprefInt = TOUPPER(TRIM(BANCS.INPUT.chnlprefInt))
                        PRINT(CUST.DATA.chnlprefInt)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "CHANNEL Preferential Interest Not Entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Channel Preferential Interest Not Entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF


	sv_s = "oldprefInt|SELECT ID_DR_PREF_PCNT FROM TBAADM.ITC a WHERE BANK_ID=?SVAR AND ENTITY_ID=(SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND "
	sv_s = sv_s + "FORACID=?SVAR) AND  INT_TBL_CODE_SRL_NUM=(SELECT MAX(INT_TBL_CODE_SRL_NUM) FROM TBAADM.ITC WHERE ENTITY_ID=a.ENTITY_ID AND BANK_ID=?SVAR "
	sv_s = sv_s + "AND DEL_FLG='N' AND ENTITY_CRE_FLG='Y') AND DEL_FLG='N' AND ENTITY_CRE_FLG='Y'"
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum +"|"+ BANCS.STDIN.contextBankId 

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
                CUST.DATA.oldprefInt = BANCS.OUTPARAM.oldprefInt

	#}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Invalid Account ID"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	PRINT(CUST.DATA.oldprefInt)

	CUST.DATA.oldprefInt = CDOUBLE(CUST.DATA.oldprefInt) - CDOUBLE(CUST.DATA.chnlprefInt)
	PRINT(CUST.DATA.oldprefInt)
	
	IF(CUST.DATA.oldprefInt >= CDOUBLE(CUST.DATA.newprefInt))THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
        sv_s = "oldsanctLim,crncyCode,acid|SELECT SANCT_LIM,CRNCY_CODE,ACID FROM TBAADM.LHT "
        sv_s = sv_s + "WHERE BANK_ID=?SVAR AND ACID = (SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR) AND SERIAL_NUM=(SELECT MAX(SERIAL_NUM) "
	sv_s = sv_s + "FROM TBAADM.LHT WHERE BANK_ID=?SVAR AND ACID = (SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR)) AND STATUS='A'"
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum +"|"+ BANCS.STDIN.contextBankId 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
                CUST.DATA.oldsanctLim = BANCS.OUTPARAM.oldsanctLim
                PRINT(CUST.DATA.oldsanctLim)
                CUST.DATA.crncyCode = BANCS.OUTPARAM.crncyCode
                PRINT(CUST.DATA.crncyCode)
                CUST.DATA.acid = BANCS.OUTPARAM.acid
                PRINT(CUST.DATA.acid)
        #}
        ELSE
        #{
        #        CUST.DATA.errFlg = "Y"
        #        CUST.DATA.errMsg = "Invalid Account ID"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        CUST.DATA.tranAmt = CUST.DATA.oldsanctLim

        BANCS.INPUT.entityId = CUST.DATA.acid
        BANCS.INPUT.eventId = "INTSAN"
        BANCS.INPUT.eventType = "GCHRG"
        BANCS.INPUT.inputAmount = CUST.DATA.tranAmt
        BANCS.INPUT.CallMode = "SCRIPT"
        BANCS.INPUT.chrgCollCrncy = CUST.DATA.crncyCode
	BANCS.STDIN.ScriptName = "eventChargeCalc_1.scr"

  CUST.DATA.ODacnt = CUST.DATA.acctNum
	sv_e = " "
        CALL("eventChargeCalc_1.scr")

	IF(TRIM(sv_e) != "")THEN
	#{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = sv_e
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        CUST.DATA.chrgAmt = BANCS.OUTPUT.collAmount
        CUST.DATA.chrgCrncy = CUST.DATA.crncyCode

        sv_s = "lnkedEvent|SELECT LINKED_EVENT_ID FROM TBAADM.PTT WHERE EVENT_ID='SANLIM' AND BANK_ID=?SVAR AND EVENT_TYPE='GCHRG'"
        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)

        IF(sv_d == "0")THEN
        #{
                CUST.DATA.vatEvent = BANCS.OUTPARAM.lnkedEvent
                PRINT(CUST.DATA.vatEvent)

                BANCS.INPUT.inputCrncy = CUST.DATA.crncyCode
                BANCS.INPUT.inputAmount = CUST.DATA.chrgAmt
                BANCS.INPUT.entityId    = CUST.DATA.acid

                CALL("vatOnEventChargeCalc.scr")

                CUST.DATA.vatAmt = BANCS.OUTPUT.collAmount

        #}
        ENDIF

ENDOFSCRIPT:

        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
        sv_u = urhk_SetOrbOut("chrgCrncy|"+CUST.DATA.chrgCrncy)
        sv_u = urhk_SetOrbOut("chrgAmt|"+CUST.DATA.chrgAmt)
        sv_u = urhk_SetOrbOut("vatAmt|"+CUST.DATA.vatAmt)

TRACE OFF
END-->

