        #}
        ENDIF

        IF(CUST.DATA.recCount == "0")THEN
        #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "Please enter the account mapped to cifId:"+CUST.DATA.cifId
                GOTO ENDOFSCRIPT
        #}
