        ENDIF
        sv_r = CLASSEXISTS("CUST","DATA")
        IF (sv_r == 0) THEN
        #{
                CREATECLASS("CUST", "DATA", 5)
        #}
        ENDIF

        CUST.DATA.AcctNum = " "
        CUST.DATA.cifId = " "
        CUST.DATA.errorFlg = "N"
        CUST.DATA.errorMsg = " "
        CUST.DATA.recCount = "0"
        IF(FIELDEXISTS(BANCS.INPUT.AcctNum))THEN
        #{
                IF(BANCS.INPUT.AcctNum !="")THEN
                #{
                        CUST.DATA.AcctNum = TOUPPER(TRIM(BANCS.INPUT.AcctNum))
                #}
                ELSE
                #{
                        CUST.DATA.errorFlg = "Y"
                        CUST.DATA.errorMsg = "Account is not Entered "
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.cifId))THEN
        #{
                IF(BANCS.INPUT.cifId !="")THEN
                #{
                        CUST.DATA.cifId = TOUPPER(TRIM(BANCS.INPUT.cifId))
                #}
                ELSE
                #{
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF


        sv_s = "recCount|SELECT COUNT(1) FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND CIF_ID=?SVAR AND FORACID =?SVAR AND DEL_FLG='N' AND ACCT_CLS_FLG='N' AND ENTITY_CRE_FLG='Y'"
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.cifId + "|" + CUST.DATA.AcctNum

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d != 0)THEN
        #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "DB error,Please contact DBA"
                GOTO ENDOFSCRIPT
                #}
        ELSE
                #{
