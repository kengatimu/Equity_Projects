#------------------------------------------------------------------------------------------------
#   RTGS and SWIFT CANCEL
#-----------------------------------------------------------------------------------------------
<--start
trace on

sv_r = REPEXISTS("CUSTS")
IF (sv_r == 0) THEN
	CREATEREP("CUSTS")
ENDIF

sv_r = CLASSEXISTS("CUSTS", "GLBDATA")
IF (sv_r == 0) THEN
     CREATECLASS("CUSTS", "GLBDATA", 5)
ENDIF

sv_b = BANCS.STDIN.mySolId
print(sv_b)

sv_q="PYMT_REF_NUM|SELECT PYMT_REF_NUM FROM tbaadm.PORD WHERE PORD.rcre_time IS NOT NULL AND  PORD.pymt_ref_num is not NULL AND PORD.lchg_time IS NOT NULL and  PORD.bank_id =?SVAR "
sv_q = sv_q + "  AND PORD.routed_paysys_id  in ('SWIFT' ,'RTGS')  AND  PORD.status = 'A'  and PORD.RCRE_TIME>'01-jan-2019' and PORD.RCRE_TIME<sysdate-2  "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)

sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
	    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	    sv_q = urhk_dbCursorFetch(sv_m)
	    print(sv_q)

	   IF(sv_q == 1) THEN
		 sv_x = urhk_dbCursorClose(sv_m)
		 print(sv_x)
		 exitscript
	   ENDIF
	  print(sv_q)

WHILE (sv_q==0)
	CUSTS.GLBDATA.PYMT_REF_NUM=BANCS.OUTPARAM.PYMT_REF_NUM
	print(CUSTS.GLBDATA.PYMT_REF_NUM)



	
	sv_a=urhk_SetUrhkInp("pordCrit.pymtRefNum|" + CUSTS.GLBDATA.PYMT_REF_NUM)
	print(sv_a)

	sv_u = urhk_ExecSrv("SRV_FetchPymtOrderMaintDtlsForDelete|retain_all_output = Y")
	print(sv_u)

		IF (sv_u == 0 ) THEN
		#{
				sv_u = urhk_CopyOutToIn("")
				PRINT(sv_u)

				sv_a=urhk_SetUrhkInp("pordCrit.pymtRefNum|" + CUSTS.GLBDATA.PYMT_REF_NUM)
				print(sv_a)

				sv_a=urhk_SetUrhkInp("pordHeaderDtls.pymtRefNum|" + CUSTS.GLBDATA.PYMT_REF_NUM)
				print(sv_a)

				sv_u = urhk_ExecSrv(" SRV_DeletePymtOrderMaintDtls|retain_all_output = Y")
				PRINT(sv_u)
				
		#}
		ENDIF	
		
		IF (sv_u != 0) THEN
			#{
			IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}
				ELSE
				#{
					sv_v = 0
				#}
			ENDIF

			IF (sv_v > 0) THEN
			#{
				sv_u = system("echo 'Error for Acct:"+CUSTS.GLBDATA.PYMT_REF_NUM+" ' >>rtgsswift.log")
				sv_i = 1
				WHILE (sv_i <= sv_v)
				#{
					sv_f = FORMAT$(sv_i,"%d")
					sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
					sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
					sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
					print(sv_e)
					sv_i = sv_i + 1
					sv_u = system("echo '"+sv_e+"' >>rtgsswift.log")
					print(sv_u)
				#}
				DO
			#}
			ENDIF
		#}
		ENDIF

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)	

DO
sv_d = urhk_dbCursorClose(sv_m)
        print(sv_d)

               print("ALL Deleted ")
ENDIF

trace off
exitscript
end-->
