# Template Name :		trans.mrt
# Description	:		unverified transfered accounts
# Author			E.G.KAROBIA,27-05-2006
# 
#########################################################################
RECORDLAYOUT
sol_id		stringType
foracid		 stringtype
acct_name	 stringtype
AUDIT_BOD_DATE	stringType
srl_num		stringType
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 70
columnsperline 70
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId				stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 70 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
  
 begin
        execute pipe
	print srl_num      column 5
	print foracid     column 13
	print acct_name   column 28
	print AUDIT_BOD_DATE column 60
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SI NUM"     COLUMN 2	
	print "ACCOUNT NO"   column 15
	print "ACCTOUNT NAME"   column 35
	print "AUDIT DATE" column  60
	Separatorline
end 

#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 70 center 
	nextline
	print branchName  size 70 center
	nextLine
	print "ABH-CHECK EXECUTION REPORT"  size 70 center
	nextline
	Print " UNVERIFIED TRANSFRED ACCOUNTS " size 70 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 70 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"   column 1
	print "|"   column 11
	print "|"   column 27
	print "|"   column 59
	print "|"  column 70


		
end


