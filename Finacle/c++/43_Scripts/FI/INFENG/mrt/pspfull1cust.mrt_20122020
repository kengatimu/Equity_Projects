procedure address2
###########################################################################
begin
if address_type = "C"
begin
	if cust_comu_addr1 ="."
	set cust_comu_addr1="  "

	if pin_code = "."
	set pin_code =" "

	if pin_code = "."
		print " " column 15
#	else
#	Set address1 = StrCat cust_comu_addr1 "-"

#	Set address2 =  strcat address1 pin_code
#	print address2  column 15      
#	nextline
	
	If city_desc = "."
	set city_desc = " "
	
	if city_desc = "MISSING @MIGRATION"
	set city_desc = " "
#		print " "
#	else
#		print city_desc column 15
		print "Boîte Postale " column 15
		print pin_code
		nextline
		print city_desc column 15
end

if address_type = "P"
begin
       if cust_perm_addr1="."
        set cust_perm_addr1=" "

	if perm_pin_code = "."
	set perm_pin_code= " "

	else
		Set address1 = StrCat cust_perm_addr1 "-"

                Set address2 =  strcat address1 perm_pin_code
#		print address2  column 15      
#                nextline
		If perm_city_desc = "."
		set perm_city_desc = " "

		if perm_city_desc = "MISSING @MIGRATION"
		set perm_city_desc = " "
#		print " "	
#		else
#		print perm_city_desc column 15
#		print perm_pin_code column 15
#		nextline
#		print perm_city_desc column 15
		print "Boîte Postale " column 15
		print pin_code
		nextline
		print city_desc column 15
  end

if address_type = "E"
begin
       if cust_emp_addr1="."
        set cust_emp_addr1 =" "
#       print cust_emp_addr1  column 15
#         nextline
#       if cust_emp_addr2 = "."
#        set cust_emp_addr2=" "
#       print cust_emp_addr2 column 15
		if emp_pin_code = "."
		set emp_pin_code= " "

#		if emp_pin_code = "."
#		print " "
#	else
#		Set address1 = StrCat cust_emp_addr1 "-"
#                Set address2 =  strcat address1 emp_pin_code
#		print address2  column 15   
#                nextline
		If emp_city_desc = "."
		set emp_city_desc = " "

		if emp_city_desc = "MISSING @MIGRATION"
		set emp_city_desc = " "
#		print " "
#	else
#		print emp_city_desc column 15
#		print perm_pin_code column 15
#		nextline
#		print perm_city_desc column 15
		print "Boîte Postale " column 15
		print pin_code
		nextline
		print city_desc column 15
end
end
