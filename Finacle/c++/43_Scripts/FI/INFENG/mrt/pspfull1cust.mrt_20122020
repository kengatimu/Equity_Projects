procedure footerPrint
nextLine
        execute pageTotProc
        nextLine
        set string1 = substr user_rmks_1 1,75
        print   string1 column 1 size 75
nextLine
nextline	
nextline
print "Besoin d’une opération de change ? Veuillez contacter votre superviseur ou l’équipe Trésorerie au" column 3
