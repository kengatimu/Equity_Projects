		print ":" column 40
		print sbsdy_code column 42
		nextline
		print   "Store Cash Flows" column 10
		print ":" column 40
		print ftcf_flag column 42
		nextline
		separatorLine
#=========================================================================
ONENDOFREPORT
#=========================================================================
	if ( proj_amort_schdl = "N" AND count > 0 )
	nextline
	begin
	print " Note : Amortization Schedule is drawn based on Actual balance of loan account when Schedule is set as Actual " size 110 column 4
	end
	nextline
	if ( count < 1)
	begin
	print " NO RECORD SELECTED " size 40 column 12
	end
    separatorLine
    print "***   " column 1
    print pageNumber size 3 column 8 precision 0
    print "PAGES PRINTED. ****END OF REPORT****" size 40 column 12
