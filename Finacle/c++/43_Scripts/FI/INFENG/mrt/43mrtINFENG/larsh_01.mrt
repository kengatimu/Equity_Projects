####################################################################

####################################################################
RECORDLAYOUT  
####################################################################
$$$include larsh.mri
####################################################################
LOCALVARIABLES
####################################################################
localdate			numberType
localyears			numberType
sum_interest        numberType
sum_principal		numberType
sum_charge			numberType
sum_amount			numberType
count               numberType
fail_count			numberType
recCount			numberType
sum_sbsdy1Amt		numberType
sum_sbsdy2Amt       numberType
sum_sbsdy3Amt       numberType
sum_quantity        numberType
callscript          stringType
vatPcnt             numberType
loanAmount             numberType
gracePerdiod             numberType
outstanding_principal		numberType
vatAmount             numberType
vatSum             numberType
flowAmount             numberType
####################################################################
GROUPANDSORT
####################################################################
acct_number
sortDate
flowAmt
alreadysorted
##################################################################
# adding alreadysorted as part of Leasing change to sort the 	##
# Residual Value record	(Call ID : 365844)						##
####################################################################
REPOSITORY bankRepos.rip readonly
####################################################################
localYearsToAdd		stringType
bankName   		stringType
branchName		stringType

####################################################################
REPOSITORY argv4
####################################################################
sol_set_id   				stringtype
acct_from					stringtype
acct_to 					stringtype
from_date         			stringtype
to_date                   	stringtype
schm_code_list				stringtype
product_group				stringtype
rep_schdl_from_date         stringtype
no_of_months                numberType
value_date_wise				stringtype
include_reph_acct			stringtype
proj_amort_schdl			stringtype
sbsdy_code					stringtype
page_number					numberType
ftcf_flag					stringtype

####################################################################
MASSAGERECORD
####################################################################
	set principal = roundoff principal N 0.001
	set interest = roundoff interest N 0.001
	set combPrinIntChrDmdAmt = roundoff combPrinIntChrDmdAmt N 0.001
	set sbsdy1Amt = roundoff sbsdy1Amt N 0.001
    set sbsdy2Amt = roundoff sbsdy2Amt N 0.001
    set sbsdy3Amt = roundoff sbsdy3Amt N 0.001
	set bankSharePcnt = roundoff bankSharePcnt N 0.000001
	set custSharePcnt = roundoff custSharePcnt N 0.000001
	set quantityPerMonth = roundoff quantityPerMonth N 0.01
	set sellPriceAmt = roundoff sellPriceAmt N 0.001
####################################################################
IGNORERECORD
####################################################################

####################################################################
PAGEFORMAT
####################################################################
LinesPerPage	 64
LeftMargin 		  2 
rightMargin       2
Topmargin	      2
BottomMargin      2
columnsPerLine  200
pageHeaderLines	 16
pageFooterLines   2
    
####################################################################
ONSTARTOFREPORT
####################################################################
set localyears = strToNum localYearsToAdd
execute commonPageHdr
execute printCriteria
nextPage
set pageNumber = 1
set count = 0
set fail_count = 0
set recCount = 0
####################################################################
BEFOREBREAKOF acct_number
####################################################################
set callscript = runscript "KGP_HLARSH_fetchVatPcnt.scr" "acct_number" "vatPcnt|gracePerdiod|loanAmount"
set count = count + 1
set recCount = 0
if ( count > 0  )
begin
	if (sucFailFlg  = "S")
	begin
		execute pageHdr
	end
	else
	begin
		if (fail_count = 0)
		begin
		execute failHdr
		end
		execute faildetail
	end
end
####################################################################
AFTERBREAKOF acct_number
####################################################################
if ( count > 0  )
begin
	if (sucFailFlg  = "S")
	begin
		execute sumforacct
	end
end
####################################################################
PAGEHEADER 
####################################################################
#execute pageHdr

####################################################################
PAGEFOOTER
####################################################################
print "" size 190 fillAscii 61

####################################################################
ONEVERYRECORD 
####################################################################
if (schm_type = "LAA" AND disbursementIndFlg != "Y")
begin
	execute laaOnEveryRecord
end
if (schm_type = "CLA" AND disbursementIndFlg != "Y")
begin
	if (ei_schm_flg = "N")
	begin
		execute claOnEveryRecord
	end
	else
	begin
		execute laaOnEveryRecord
	end
end
####################################################################
PROCEDURE laaOnEveryRecord
####################################################################
nextLine
if (sucFailFlg  = "S")
begin
    set localdate = stringToDate  flowDate
    set localdate = periodAdd localdate localyears Y
    print localdate DateFormat "" column 2

	set outstanding_principal = loanAmount - sum_principal - principal
        set vatAmount = interest * vatPcnt / 100.00
	set vatAmount = roundoff vatAmount N 0.001
        set vatSum = vatSum + vatAmount
#	set flowAmount = combPrinIntChrDmdAmt + vatAmount
#	set flowAmount = roundoff flowAmount N 0.001

    if (defmntInd = "Y")
    begin
        print "INSTALLMENT DEFERRED" column 52
    end
    else
    begin
        print combPrinIntChrDmdAmt autocomma size 18 column 20
#        print flowAmount  autocomma size 18 column 20
		if(leasei_type != "O")
		begin
			print interest autocomma size 18 column 52 
			print principal autocomma size 18 column 78 rightjustify
		end
    end

	if(islamicProductTypeFlg = "U" OR islamicProductTypeFlg = "D")
	begin
		print bankSharePcnt autocomma size 18 column 90
		print custSharePcnt autocomma size 18 column 111
		print fixChargeDmdAmt autocomma size 18 column 138
	end
	else
	begin
		print fixChargeDmdAmt autocomma size 18 precision 2 column 101 rightjustify
		print vatAmount autocomma size 18 precision 2 column 124
		print outstanding_principal autocomma size 18 precision 2 column 149
	end
    if(islamicProductTypeFlg = "S")
	begin
	print quantityPerMonth autocomma size 18 column 115 precision 0 
	end
	else if((islamicProductTypeFlg = "I" OR forwardIjarahFlg = "Y")  OR (lease_type = "F"))
	begin
		print shdlBal autocomma size 18 column 123 
	end
	if(sbsdy_ind = "I")
	begin
		print sbsdy1Amt autocomma size 18 column 127 
		print sbsdy2Amt autocomma size 18 column 152
		print sbsdy3Amt autocomma size 18 column 170 

		set sum_sbsdy1Amt = sum_sbsdy1Amt + sbsdy1Amt
		set sum_sbsdy2Amt = sum_sbsdy2Amt + sbsdy2Amt
		set sum_sbsdy3Amt = sum_sbsdy3Amt + sbsdy3Amt
	end

        if(islamicProductTypeFlg = "M" OR islamicProductTypeFlg = "T" OR islamicProductTypeFlg = "B" OR islamicProductTypeFlg = "A")
        begin
                print sellPriceAmt autocomma size 18 column 122
        end

    set sum_interest = sum_interest + interest
    set sum_principal = sum_principal + principal
    set sum_charge = sum_charge + fixChargeDmdAmt

    set sum_amount = sum_amount + combPrinIntChrDmdAmt
	if(islamicProductTypeFlg = "S")
	begin
	set sum_quantity = sum_quantity + quantityPerMonth
	end
end
####################################################################
PROCEDURE claOnEveryRecord
####################################################################
nextLine
if (sucFailFlg  = "S")
begin
    if (freq_ind = "Y")
    begin
        execute print_freq_det
    end
    else
    begin
        if (recCount = 0)
        begin
            execute print_col_hdr
            set recCount = 1
        end
        set localdate = stringToDate  flowDate
	set localdate = periodAdd localdate localyears Y
        print localdate DateFormat "" column 2
    
        if (defmntInd = "Y")
        begin
            print "INSTALLMENT DEFERRED" column 52
        end
        else
        begin
            print combPrinIntChrDmdAmt autocomma size 18 column 27
        	print interest autocomma size 18 column 59 
            print principal autocomma size 18 column 84
        end
        print fixChargeDmdAmt autocomma size 18 column 109
    	set sum_interest = sum_interest + interest
        set sum_principal = sum_principal + principal
        set sum_charge = sum_charge + fixChargeDmdAmt

        set sum_amount = sum_amount + combPrinIntChrDmdAmt
    end
end
####################################################################
PROCEDURE print_freq_det
####################################################################
print "From Date : " column 10
 set localdate = stringToDate  flowStartDate
 set localdate = periodAdd localdate localyears Y
 print localdate DateFormat ""
        
print "Frequency : " column 60
print int_freq_type
print "/"
print int_freq_week_num
print "/"
print int_freq_week_day
print "/"
print int_freq_start_dd
print "/"
print int_freq_months
print "/"
print int_freq_days
print "/"
print int_freq_hldy_stat
####################################################################
PROCEDURE print_col_hdr
####################################################################
nextline
separatorline
print "Flow Date" column 2
print "Flow Amount" column 33
if(islamicProductTypeFlg = "S")
begin
print "Profit Component" column 58
end
else if(islamicProductTypeFlg = "F")
	begin
	print "Variable Rental" column 58
	end
else
begin
print "Interest Component" column 58
end
if(islamicProductTypeFlg = "F")
    begin
	print "Fixed Rental"   column 83
	end
else
begin
print "Principal Component" column 83
end
if(islamicProductTypeFlg = "U" OR islamicProductTypeFlg = "D")
begin
	print "BankShare Pcnt"      column 108
	print "CustShare Pcnt"      column 123
	print "Charges Component" 	column 138
end
if(islamicProductTypeFlg = "S")
begin
    print "Charges Component"   column 108
    print "Quantity to be delivered " column 123
end
else if(islamicProductTypeFlg = "F")
	begin
	print "Supplementary Charge" column 108
	end
else
begin
	print "Charges Component" 	column 108
	print "Outstanding" 	        column 130
end
separatorline

####################################################################
PROCEDURE sumforacct
####################################################################
if (schm_type = "LAA")
begin
	execute laaSumForAcct
end
if (schm_type = "CLA")
begin
	if (ei_schm_flg = "N")
	begin
		execute claSumForAcct
	end
	else
	begin
		execute laaSumForAcct
	end
end
####################################################################
PROCEDURE laaSumForAcct
####################################################################
    nextline
    print "=============================================================================================================================================================================================="
    nextline
#   set count = count + 1
    print "SUM TOTALS" column 5
#    set sum_amount  = sum_amount + vatSum
    print sum_amount size 18 column 20 autocomma
	if(lease_type != "O")
	begin
    print sum_interest size 18 column 52 autocomma
    print sum_principal size 18 column 70 autocomma
	end
    print sum_charge size 18 column 101 autocomma precision 2
	if(islamicProductTypeFlg = "S")
	begin
	print sum_quantity size 18 column 115 autocomma precision 0  
	end
	if(sbsdy_ind = "I")
	begin
    	print sum_sbsdy1Amt size 18 column 127 autocomma
    	print sum_sbsdy2Amt size 18 column 152 autocomma
    	print sum_sbsdy3Amt size 18 column 170 autocomma
	end
    print vatSum size 18 column 124 autocomma precision 2
    print outstanding_principal size 18 column 149 autocomma precision 2
    nextline
    print "=============================================================================================================================================================================================="
    nextline
set sum_interest = 0
set sum_principal = 0
set sum_amount = 0
set sum_quantity = 0
set PAGE_NUMBER = pageNumber
nextPage
####################################################################
PROCEDURE claSumForAcct
####################################################################
    nextline
    print "==================================================================================================================================== "
    nextline
    print "SUM TOTALS" column 5
    print sum_amount size 18 column 27 autocomma
    print sum_interest size 18 column 59 autocomma
    print sum_principal size 18 column 84 autocomma
    print sum_charge size 18 column 109 autocomma
    nextline
    print "==================================================================================================================================== "
    nextline
set sum_interest = 0
set sum_principal = 0
set sum_amount = 0
set PAGE_NUMBER = pageNumber
nextPage
