	end
	end
	if(islamicProductTypeFlg = "U" OR islamicProductTypeFlg = "D")
	begin
		print "BankShare Pcnt"      column 102
		print "CustShare Pcnt"      column 117
		print "Charges Component" 	column 132
	end
	else if(islamicProductTypeFlg = "F")
		begin
		print "Supplementary Charge"   column 102
		end
	else
	begin
	if(lease_type = "F" OR lease_type = "O" OR lease_type = "I")
	begin
	print "Charges"             column 109
	end
	else
	begin
	print "Charges Component" 	column 102
	print "Vat Amount" 	column 132
	print "Outstanding" 	column 156
	end
	end
    if(islamicProductTypeFlg = "S")
	begin
	print "Quantity to be delivered " column 123
	end
	else if((islamicProductTypeFlg = "I" OR forwardIjarahFlg = "Y") OR (lease_type = "F"))
	begin
		print "Principal Outstanding"   column 123
	end
	if (sbsdy_ind = "I")
	begin
		print "Subsidy 1" column 127
		print "Subsidy 2" column 152
		print "Subsidy 3" column 172
	end
        if(islamicProductTypeFlg = "M" OR islamicProductTypeFlg = "T" OR islamicProductTypeFlg = "B" OR islamicProductTypeFlg = "A")
        begin
                print "Outstanding Selling Price"       column 122
        end
    separatorline
######################################################################
PROCEDURE failHdr
######################################################################
set fail_count = fail_count + 1
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "" column 1
print " "
set localdate = stringToDate  today
set localdate = periodAdd localdate localyears Y
print localdate DateFormat "HH24:NN:SS"
print "REPAYMENT SCHEDULE FOR LOANS PRINTING FAILED FOR FOLLOWING ACCOUNTS" size 128  center 
print "Page : " column 130
print pageNumber size 3 precision 0
nextLine
print "ACCOUNT NO.                                 REASON FOR FAILURE" size 128 center
nextline
######################################################################
PROCEDURE faildetail
######################################################################
nextline
print acct_number  column 35
nextline
print message column 55  size 128 center 
