PROCEDURE printCriteria
####################################################################
nextline
nextline
separatorLine
nextline
print	"REPORT CRITERIA" center
nextline
print	"-------------------" center
nextline
nextline
print   "Sol Id" column 10
print ":" column 40
print sol_set_id column 42
nextLine
print   "Acct Range" column 10
print ":" column 40
print acct_from column 42
print   " To "  column 58
print acct_to column 65
nextLine
print   "Date Range"  column 10
print ":" column 40
set localdate = stringToDate  from_date
 set localdate = periodAdd localdate localyears Y
  print localdate DateFormat "" column 42

   print   " To "  column  52
   set localdate = stringToDate  to_date
    set localdate = periodAdd localdate localyears Y
	 print localdate DateFormat "" column 56

	  nextLine
	  print   "SchemeCodes" column 10
	  print ":" column 40
	  print schm_code_list column 42
	  nextLine
	  print   "Product Group" column 10
	  print ":" column 40
	  print product_group column 42
	  nextLine
	  print   "Generate Schedule From" column 10
	  print ":" column 40
	  set localdate = stringToDate  rep_schdl_from_date
	   set localdate = periodAdd localdate localyears Y
	    print localdate DateFormat "" column 42
		nextLine
		if ( no_of_months = 0 )
		begin
		print   "No of Months" column 10
		print ":" column 40
		end
		else
		begin
		print   "No of Months" column 10
		print ":" column 40
		print no_of_months precision 0 column 42
		end
		nextLine
		print   "Open/Value Date Flg" column 10
		print ":" column 40
		print value_date_wise column 42
		nextLine
		print   "Include Rephased A/C" column 10
		print ":" column 40
