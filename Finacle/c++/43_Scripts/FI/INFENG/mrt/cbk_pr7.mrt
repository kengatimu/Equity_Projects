#  This is the Mahareport for Profit & Loss Consolidated 
###############################################################################
RECORDLAYOUT
###############################################################################
hom_cny                                      numbertype
gl_sub_head_code	                     numbertype 
gl_code                                      numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript    			               stringType
lv_setid   	    			       stringType  
lv_setdesc    				       stringType
total						numbertype
inc_tot						numberType
exp_tot						numberType
nii_tot						numbertype
nie_tot						numbertype
lle_tot						numbertype
netinc						numberType
flag 						numbertype
flag1						numberType
flag2						numberType
grp_tot						numberType
tot_grp						numberType 
flag3						numberType
flag4						numberType
################################################################################
GROUPANDSORT
###############################################################################
gl_code,gl_sub_head_code
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
############################################################################
#IGNORERECORD
###########################################################################
###############################################################################
PAGEFORMAT
##############################################################################



ColumnsPerLine   84 
LinesPerPage     5000
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "FORM CBK/PR7"  column 65
nextline
print   "PROFIT & LOSS STATEMENT"  column 1 size 80 
nextline
nextline
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print "NAME OF INSTITUTION.............................................................." column 1 
print lv_setdesc column  35
nextline
nextline
print "STATEMENT FOR PERIOD ENDING......................................................" column 1
print asondate column 50 
nextline
nextline
separatorline 
print "50" column 03
print "INTEREST INCOME"  column 14
separatorline
nextline
print "50.1" column 03
print "Interest and discounts" column 14
nextline
set total  = 0      
set flag =  1                       
set flag1 = 0
set flag2 = 0
set flag3 = 0
set flag4 = 0
end
#############################################################################
AFTERBREAKOF gl_sub_head_code
#############################################################################
execute afterBreakof
#############################################################################
ONEVERYRECORD
#############################################################################
if(flag = 0)
begin
if(gl_code = 1)
begin
	if(gl_sub_head_code = 2)
	begin
        print "50.1.1" column 03
	print "Money market lendings" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
	nextline
	end
	
	if(gl_sub_head_code = 3)
        begin
        print "50.1.2" column 03 
	print "Loans and advances" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
        end

        if(gl_sub_head_code = 4)
        begin
        print "50.1.3" column 03 
	print "Bills discounted and negotiated" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
        end

        if(gl_sub_head_code = 5)
        begin
        print "50.2" column 03
	print "Placements with financial institutions" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
        end

        if(gl_sub_head_code = 6)
        begin
        print "50.3" column 03 
	print "Treasury instruments" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
        end

        if(gl_sub_head_code = 7)
        begin
        print "50.3.1" column 03
	print "Treasury bills" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
        end

        if(gl_sub_head_code = 8)
        begin
        print "50.3.1" column 03
	print "Treasury bonds" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
        end
end
if (gl_code = 2)
begin
	if(gl_sub_head_code = 1)
	begin
	print "50.3.3" column 03	
	print "Goverment Bearer Bonds" column 14
	nextline
	print "50.3.4" column 03     
	print "Government stocks" column 14
        nextline
        print "50.3.5" column 03     
	print "Others" column 14
        nextline
       	print "50.4" column 03       
	print "Other interest income" column 14
	print tot_grp column 63 size 20 autocomma precision 2
	nextline
	separatorline
        print "50.5" column 03       
	print "Total Interest Income" column 14
        print total column 63 size 20 autocomma precision 2
	set inc_tot = total
	set total = 0 
        set flag  = 1 
        separatorline
	print "51" column 03         
	print "INTEREST EXPENSE:"	column 14
	separatorline
	print "51.1" column 03	  	
	print "Deposits" column 14
	nextline
	end
	if(gl_sub_head_code = 2)
        begin
        print "51.1.1" column 03     
	print "Demand" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 3)
        begin
        print "51.1.2" column 03    
	print "Call" column  14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	print "51.1.3" column 03	  
	print "Seven days notice" column 14
	nextline
	end
	if(gl_sub_head_code = 4)
        begin
        print "51.1.4" column 03     
	print "Time" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 5)
        begin
        print "51.1.5" column 03     
	print "Savings" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
        print "51.1.6" column 03    
	print "Certificate of deposit" column 14
	end
end
if (gl_code = 3)
begin
	if(gl_sub_head_code = 1)
        begin
        print "51.1.7" column 03     
	print "Money market borrowing" column 14
        print tot_grp column 63 size 20 autocomma precision 2
	nextline
	print "51.2" column 03	  
	print "Loans and advances receievd" column 14
	nextline
	print "51.2.1" column 03	  
	print "Domestic market" column 14
	nextline
	print "51.2.1.1" column 03  
	print "Central Bank of Kenya" column 14
	nextline
	print "51.2.1.2" column 03	  
	print "Other Domestic sources" column 14
	nextline
	print "51.2.2" column 03	  
	print "Overseas" column 14
	nextline
	print "51.3" column 03	  
	print "Other Interset expenses" column 14
	nextline
	separatorline
	print "51.4" column 03	  
	print "Total Interest Expense" column 14
        print total column 63 size 20 autocomma precision 2
	set exp_tot = total
	set total = 0 
        set flag  = 1 
        separatorline
	nextline
	print "52" column 03         
	print "NET INTEREST INCOME/(EXPENSE)"	column 14
	separatorline
	print "53" column 03	  
	print "NON-INTEREST INCOME" column 14
	separatorline
	nextline
        set flag = 1
	end
	if(gl_sub_head_code = 2)
        begin
        print "53.1" column 03       
	print "Service charges" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 3)
        begin
        print "53.2" column 03       
	print "Commissions" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 4)
        begin
        print "53.3" column 03       
	print "Foreign exchange gain/(loss)" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	print "53.4" column 03	  
	print "Management fees" column 14
	nextline
	print "53.5" column 03	  
	print "Trading Account securities" column 14
	nextline
	print "53.5.1" column 03	  
	print "Securities trading gain/(loss)" column 14
	nextline
	print "53.5.2" column 03	  
	print "Dividends on investments" column 14
	nextline
	print "53.6" column 03	  
	print "Trust income" column 14
	nextline
	end
	
end
if(gl_code = 4)
begin
	if(gl_sub_head_code = 1)
	begin
	print "53.7" column 03	  
	print "Other non-interest income" column 14
	print tot_grp column 63 size 20 autocomma precision 2
	nextline
	separatorline
	print "53.8" column 03	  
	print "Total Non-Interest Income" column 14
	print total column 63 size 20 autocomma precision 2
	separatorline
	set nii_tot = total
	set total = 0
	set flag = 1
	nextline
	separatorline
	print "54" column 03	  
	print "Non-Interest Expesnse:" column 14
	separatorline
	nextline
	end
	if(gl_sub_head_code = 2)
        begin
        print "54.1" column 03       
	print "Director's emoluments" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 3)
        begin
        print "54.2" column 03      
	print "Salaries and other staff costs" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	print "54.3" column 03       
	print "Management fees" column 14
        nextline
	end
	if(gl_sub_head_code = 4)
        begin
        print "54.4" column 03       
	print "Occupancy expenses" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 5)
        begin
	print "54.5" column 03       
	print "Operating licence fees" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 6)
        begin
        print "54.6" column 03       
	print "Fines and penalties" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 7)
        begin
        print "54.7" column 03       
	print "Deposit Protection Fund Board contribution" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 8)
        begin
        print "54.8" column 03       
	print "Business promotion" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 9)
        begin
        print "54.9" column 03       
	print "Donations" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
	if(gl_sub_head_code = 10)
        begin
	print "54.10" column 03	  
	print "Depreciation" column 14       
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	end
end
if(gl_code = 5)
begin
	if(gl_sub_head_code = 1)
	begin
	print "54.11" column 03	  
	print "Others" column 14
        print tot_grp column 63 size 20 autocomma precision 2
	nextline
	separatorline
	print "54.12" column 03 	  
	print "Total Non-Interest Expense" column 14
	print total column 63 size 20 autocomma precision 2
	separatorline
	nextline
	separatorline
	print "55" column 03	  
	print "LOAN LOSS EXPENSE*" column 14
	separatorline
	nextline
	set nie_tot = total
	set total = 0
	set flag = 1
	end
	if(gl_sub_head_code = 2)
        begin
	print "55.1" column 03	  
	print "Provisions" column  14       
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	print "55.2" column 03	  
	print "Write offs" column 14
	nextline
	end
	if(gl_sub_head_code = 3)
        begin
	print "55.3" column 03	  
	print "Recoveries" column 14
        print tot_grp column 63 size 20 autocomma precision 2
        set flag = 1
        nextline
	separatorline
	print "55.4" column 03	  
	print "Total" column 14
	print total column 63 size 20 autocomma precision 2
	separatorline
	nextline
	set lle_tot = total
	set total = 0
	end
	if(gl_sub_head_code = 4)
        begin
	print "56" column 03	  
	print "RENTAL INCOME" column 14
	print tot_grp column 63 size 20 autocomma precision 2
	set flag = 1
        nextline
	end
	
end
end
set total = total + hom_cny
###############################################################################
ONENDOFREPORT
###############################################################################
begin
	print "57" column 03	  
	print "PROFIT/(LOSS) ON DISPOSAL OF ASSETS" column 14
	print tot_grp column 63 size 20 autocomma precision 2
	nextline
	nextline
	print "*Disclose separately provisions, recoveries and write-offs for" column 01
	nextline
	print "advances and provisions" column 01
	nextline
	nextline 
	print "58" column 03	  
	print "OTHER NON-OPERATING INCOME" column 14
	nextline
	print "59" column 03	  
	print "NET INCOME BEFORE TAX" column 14
	set grp_tot = inc_tot + exp_tot + nii_tot + nie_tot + lle_tot + total
	print grp_tot column 63 size 20 autocomma precision 2 
	nextline
	print "60" column 03	  
	print "PROVISION FOR TAXATION" column 14
	nextline
	print "61" column 03	  
	print "NET INCOME AFTER TAX" column 14
	nextline
	print "62" column 03	  
	print "EXTRAORDINARY ITEMS" column 14
	nextline
	print "63" column 03	  
	print "PROFIT/(LOSS) ATTRIBUTABLE TO S/HOLDERS" column 14
	nextline
	print "64" column 03	  
	print "PROVISION FOR DIVIDENDS" column 14
	nextline
	print "65" column 03	  
	print "OTHER APPROPRIATIONS" column 14
	nextline
	print "66" column 03	  
	print "RETAINED PROFIT/(LOSS) FOR THE YEAR" column 14
	nextline
	nextline
	nextline
	print "18." column 03
	print "STAFF NUMBERS" column 14
	nextline
	print "Management" column 14
	nextline
	print "Supervisory" column 14
	nextline
	print "Clerical" column 14
	nextline
	print "Secretarial" column 14
	nextline
	print "Other Categories" column 14
	nextline
	print "Total" column 14
	nextline	
	nextline
	nextline
	nextline
	nextline
	print "Name of Officer:_______________________________________________________________" column 01
	nextline
	nextline 
	print "Designation:___________________________________________________________________" column 01
	nextline
	nextline 
	print "Signature:_____________________________________________________________________" column 01
	nextline
	nextline 
	print "Date:__________________________________________________________________________" column 01
	nextline
	nextline 
	nextline
	separatorline
end
#############################################################################
PROCEDURE afterBreakof
#00##############################################################################
begin
set tot_grp =  groupSum hom_cny
set flag = 0
end
