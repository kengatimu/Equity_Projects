#
###################################################################
recordlayout
###################################################################
#  
####################################################################
acid	 	stringtype
acct_name 	stringtype	
chrg_tran_date	stringtype 
system_calc_amt numbertype	
actual_amt_coll	numbertype
event_type	stringtype
rcre_user_id	stringtype

localvariables
######################################################################
#
#####################################################################
total_sys_amt	numbertype
total_act_chg	numbertype
wvd_amt		numbertype
total_wvd_amt	numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType
#
#########################################################################
groupandsort
#########################################################################
#   
#########################################################################
chrg_tran_date

repository bankRepos.rip  
##########################################################################
bankname	stringtype
branchName      stringtype
REPOSITORY  argv4
#############################################################################

ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#____________________________________________________________________________
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################

PAGEFORMAT
####################################################################
#   
####################################################################
linesperPage   65
columnsperline 120 
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 13
pagefooterlines 4
######################################################

onstartofreport
#####################################################################

execute brBankHdg 
execute pageHdg

#
####################################################################
PAGEHEADER
####################################################################
execute brBankHdg 
execute pageHdg
###############################################################
oneveryrecord
###############################################################
set wvd_amt =system_calc_amt - actual_amt_coll
set total_wvd_amt = total_wvd_amt + wvd_amt
print chrg_tran_date column 3 
print acct_name column 15
print acid column 55
print event_type column 70 
print system_calc_amt column 76 format "#,###.##" 
print actual_amt_coll column 89 format "#,###.##" 
print wvd_amt column 99 format "#,###.##" 
print rcre_user_id column 109 

####################################################################
#afterbreakof 
####################################################################
onendofreport
#############################################################################
#
#############################################################################
begin
     set total_sys_amt = totalsum system_calc_amt 
     set total_act_chg = totalsum actual_amt_coll 
     print "Total value" column 3 
     print total_sys_amt column 70 format "##,###,###,###,###.##" 
     print total_act_chg column 80 format "##,###,###,###,###.##"
     print total_wvd_amt column 90 format "##,###,###,###,###.##"
     separatorline
     nextline
end

begin
     print "printed by:"  size 120 center
     print  lv_userId
     nextline
     nextline
     print "verified by:" size  120 center
      nextline
     nextline
     print "*************************END OF REPORT****************************" size 120 center
    end
#
############################################################################
Procedure  pageHdg
############################################################################
begin
     print "CHARGES EDITED BY USER REPORT  "  size  120 center 
     nextline
     nextline
     print " From  " column   45
     print ipFrmDate  
     print "  &  "
     print ipToDate   
     nextline
end

begin
     separatorline
     print "DATE" column 3
     print "ACC NAME" column 15
     print "ACC ID" column 55
     print "TYPE" column  70
     print "DEFAULT" column 76
     print "ACTUAL " column 89
     print "WAIVED" column 99
     print "EDITED BY:" column 109
     separatorline
  end
#
############################################################################
PROCEDURE brBankHdg
############################################################################
begin
     print "Page No. "   column  75
     print page_number precision 0
     nextline
     print today column 75 
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 120 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 120 center 
   end
#
#############################################################################
####################################################################
# End of File
######################################################################

