#  DESC   : PAYMENT DUE REPORT
#
######################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
FORACID               stringType
ACCT_NAME            stringtype
RECEIPT_NUMBER        stringtype 
DEPOSIT_AMOUNT       numbertype
interest_rate        numbertype
OPEN_EFFECTIVE_DATE          stringtype
MATURITY_DATE               stringtype 
maturity_amount               numbertype
NRML_ACCRUED_AMOUNT_CR     numbertype	 
NRML_BOOKED_AMOUNT_CR     numbertype
lien_amt                  numbertype 
LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
Dep.Total   numbertype
Mat.Total   numbertype
Total.Int.Paid  numbertype
Total.Int.Paybl  numbertype
Tot.Lien.Amt    numbertype


GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is already sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in
#   RECORDLAYOUT section.
####################################################################

OPEN_EFFECTIVE_DATE
ACCT_NAME
FORACID
RECEIPT_NUMBER

REPOSITORY bankRepos.rip

############################################################################
#bankName        stringType
#branchName      stringtype
#############################################################################
#
#   REPOSITORY (Optional Section) - Fixed-Type Repository.
#   This section tells about the Repository Information. A  Repository  is  a
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#   Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#
#############################################################################

bankname             stringtype
branchname           stringtype

#MASSAGERECORD
#############################################################################
#
#   MASSAGERECORD (Optional Section).
#   The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#   later. This Block is executed every time a new record is read.
#
#############################################################################
#set round_off_bal=round CLR_BAL_AMT N 100
#set round_off_bal=round UN_CLR_BAL_AMT N 100

#IGNORERECORD
#############################################################################
#
#   IGNORERECORD (Optional Section).
#   The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
#   for input records), the record is Ignored.
#
#############################################################################
#
#
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are

#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################

linesperpage     64
pageheaderlines   4
pagefooterlines   4
topmargin         2
bottommargin      2
leftmargin       1
rightmargin     1
columnsperline  185
ONSTARTOFREPORT
####################################################################
print bankname    size 145 center
nextline
print branchname   size 145 center
nextline
print "PAYMENT DUE REPORT"  size  145 center
nextline
nextline
execute pghdr

PAGEHEADER
####################################################################
#pageheader on each page
####################################################################
execute pghdr
#
#
PAGEFOOTER
####################################################################
#pagefooter on each page

####################################################################
#
#

ONEVERYRECORD
####################################################################
#on every record
####################################################################
print FORACID column 2
print acct_Name  column  18
print RECEIPT_NUMBER column 35 
print DEPOSIT_AMOUNT column   44  size 20 autocomma precision 2
print interest_rate column  67 
print OPEN_EFFECTIVE_DATE column   71 
print MATURITY_DATE column   82 
print maturity_amount   column  94 size 20 autocomma precision 2  
print NRML_ACCRUED_AMOUNT_CR column  113  size 20 autocomma precision 2 
print NRML_BOOKED_AMOUNT_CR column  139   size 20 autocomma precision 2 
print lien_amt column  161 size 20 autocomma precision 2 
#BEFOREBREAKOF
#
#
#AFTERBREAKOF
####################################################################
# After break
####################################################################
#
#
ONENDOFREPORT
#############################################################################
#
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
#

#############################################################################
separatorline
set Dep.Total = totalsum DEPOSIT_AMOUNT 
print Dep.Total column 46  size 20   autocomma precision 2
set Mat.Total =totalsum  maturity_amount 
print Mat.Total column    94 size  20 autocomma  precision 2
set Total.Int.Paid = totalsum NRML_ACCRUED_AMOUNT_CR 
print Total.Int.Paid  column 113  size 20 autocomma  precision 2
set Total.Int.Paybl = totalsum NRML_BOOKED_AMOUNT_CR
print Total.Int.Paybl  column  139  size 20 autocomma precision 2
set Tot.Lien.Amt = totalsum  lien_amt 
print Tot.Lien.Amt column   155 size 20 autocomma precision 2 
separatorline
nextline
nextline
print "Printed by:.................." column 90
nextline
nextline
print "Date:.................."   column 90
nextline
nextline
print "Verified By:..............." column 90

####################################################################
#
#
#AFTERBREAKOF
####################################################################
# After break
####################################################################
#
#
#ONENDOFREPORT
#############################################################################
#
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
#
#############################################################################
#
#############################################################################
#
#   PROCEDURE BLOCK.
#   Procedure  itself is a Independent  Block  and  defined at the end of the
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#   Template File, Makes  it  Structured  and  avoids burring the same set of
#   codes at several places.
#
#############################################################################
#
#
procedure pghdr
########################################################################
# PROCEDURE pghdr
##############################################################################
separatorline
print "A/C NO." column 2
print "A/C Name" column   18
print "Receipt NO." column 35
print "Dep Amount" column  52 
print "Rate" column  65 
print "Strt Date" column    71
print "Mat Date" column  82
print "Mat Value" column  102 
print "Int. Paid" column    123 
print "Int.Paybl" column   146 
print "Lien Amount"  column 169 
separatorline

####################################################################
# End of File
######################################################################
