#********************************************************************************
#    Report Name                        :    daily_dr85.mrt  
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*

#################################################################################

#**********************************************************************
#  DESC   :  This is the Mahareport specs for generating the 
#			 Teller Transcations Register
######################################################################
#
#
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
#
TRAN_ID			stringtype
foracid			stringtype
acct_Name		stringtype
CRNCY_CODE		stringtype
TRAN_AMT		numbertype
INSTRMNT_NUM		stringtype
TRAN_PARTICULAR		stringtype
ENTRY_USER_ID		stringtype
VFD_USER_ID		stringtype	
TRAN_TYPE		stringtype
TRAN_SUB_TYPE           stringType
PSTD_FLG		stringtype


LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
page_number		numberType
callscript		stringType
lv_setid		stringType  
lv_setdesc		stringType
lv_userId		stringType 
type			stringType
stype			stringType
grptran			numberType
grptotal		numberType
tottran			numberType
tottotal		numberType


#
#
GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is already sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in
#   RECORDLAYOUT section.
####################################################################
TRAN_SUB_TYPE
#
#
#############################################################################
#
#   REPOSITORY (Optional Section) - Fixed-Type Repository.
#   This section tells about the Repository Information. A  Repository  is  a
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#   Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#
#############################################################################
REPOSITORY bankRepos.rip
############################################################################
bankName        stringType
branchName      stringtype

REPOSITORY  argv4
ipSetId		stringtype	
ipDate		stringtype			
ipttype		stringtype	
iptstype	stringtype	
ipuser		stringtype
#
#
#MASSAGERECORD
#############################################################################
#
#   MASSAGERECORD (Optional Section).
#   The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#   later. This Block is executed every time a new record is read.
#
#############################################################################
#
#
IGNORERECORD
#############################################################################
#
#   IGNORERECORD (Optional Section).
#   The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
#   for input records), the record is Ignored.
#
#############################################################################
#
#
ONSTARTOFREPORT
#############################################################################
begin
if ipttype = "C"
 set type = "CASH"
if ipttype = "T"
 set type = "TRANSFER"
if ipttype = "ALL"
 set type = "ALL"
if iptstype = "NR"
 set Stype = "NORMAL RECEIPT"
if iptstype = "NP"
 set Stype = "NORMAL PAYMENT"
 if iptstype = "BI"
 set Stype = "BANK INDUCED"
 if iptstype = "CI"
 set Stype = "CUSTOMER INDUCED"
if iptstype = "ALL"
 set Stype = "ALL"
end
execute  pageHdr
execute  commonPageHdr
set page_number = 1
#
#
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
linesperPage    66
columnsperline  160
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines 12
pagefooterlines 0
#
Beforebreakof TRAN_SUB_TYPE
####################################################################
#Abeforebreakoff date
####################################################################
AFTERBREAKOF TRAN_SUB_TYPE
####################################################################
#AFTERBREAKOF 
####################################################################
set grptran = groupcount tran_id
set grptotal = groupsum tran_amt
separatorline
print "Subtotal" column 2
print grptran column 28
print grptotal size 20 column 65 autocomma precision 2
separatorline
#
ONEVERYRECORD
####################################################################
# ON EVERY RECORD
####################################################################
execute pipe
print TRAN_ID		column 2
print foracid		column 10 
set acct_name = splitstring acct_name 1 29
print acct_Name		column 26
print CRNCY_CODE	column 58 
print TRAN_AMT	size 20 column 65 autocomma precision 2	
print INSTRMNT_NUM	column 86
set TRAN_PARTICULAR = splitstring TRAN_PARTICULAR 1 29
print TRAN_PARTICULAR	column 96
set  ENTRY_USER_ID = splitstring  ENTRY_USER_ID 1 10
print ENTRY_USER_ID	column 123
set  VFD_USER_ID = splitstring  VFD_USER_ID 1 10
print VFD_USER_ID	column 138 
print TRAN_TYPE		column 151
print TRAN_SUB_TYPE     column 153
print PSTD_FLG		column 157 
#
#
ONENDOFREPORT
#############################################################################
#
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
#
#############################################################################
nextline
begin
if ( totalCount foracid = 0 )
begin
nextline
nextline
nextline
separatorline
print "  NO RECORD SELECTED FOR THE GIVEN CRITERIA " column 20
separatorline
end
else
set tottran = totalcount tran_id
set tottotal = totalsum tran_amt
separatorline
print "Grand Total" column 2
print tottran column 28
print tottotal size 20 column 65 autocomma precision 2
separatorline

begin
 nextline
 nextline
 nextline
 nextline
 print "       Printed By:  " column 20
 print lv_userId
 print "                          Verified By: " 
 nextline
 print today  column 27
end
end
#
#
PAGEHEADER
#######################################################################
#PageHeader on each Page
#######################################################################
execute  pageHdr
execute  commonPageHdr
################################################################################# 
PAGEFOOTER
separatorline


################################################################################# 
#
#
#############################################################################
#
#   PROCEDURE BLOCK.
#   Procedure  itself is a Independent  Block  and  defined at the end of the
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#   Template File, Makes  it  Structured  and  avoids burring the same set of
#   codes at several places.
#
#############################################################################
#
#
PROCEDURE commonPageHdr
########################################################################
# PROCEDURE commonPageHdr
##############################################################################
begin
	separatorline
	execute pipe
	print "TranID" column 2
	print "A/C Number" column 13 
	print "A/C Name " column 28
	print "CCY" column 60 
	print "Amount" column 67 
   	print "INST#" column 88 
	print "Particulars" column 96 
	print "Operator" column 125 
	print "Supervisor" column 138 
	print "Ttype" column 150 
	print "Pflg" column 156 
	separatorline
end
PROCEDURE pageHdr
########################################################################
# PROCEDURE pageHdr
##############################################################################
begin
    	print "Page No. "   column 115
        print page_number 
        nextline
        print today column 115 
        nextline
        nextline
	print "EQUITY BANK LIMITED" size 160 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 160 center
        set page_number= page_number+1
	nextline
	print " TELLER TRANSACTION REGISTER FOR:  " column 60
	print ipDate
        nextline
	nextline
	print " FOR TELLER " column 2
	print ipuser
	print ":          "
	print "TRAN-TYPE "
	print type
	print ":          "  
	print "TRAN-SUBTYPE "
	print stype
end

PROCEDURE pipe
##############################################################################
#PROCEDURE pipe
##############################################################################

begin
	print "|"  column 1
	print "|" column 9 
	print "|" column 25
	print "|" column 57
	print "|" column 64
   	print "|" column 87
	print "|" column 95
	print "|" column 122
	print "|" column 136
	print "|" column 149
	print "|" column 155
	print "|" column 160
	
end

####################################################################
# End of File
######################################################################
