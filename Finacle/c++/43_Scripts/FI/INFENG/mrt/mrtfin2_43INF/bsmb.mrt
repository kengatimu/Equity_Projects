print "* Relates only to transaction denominated by foriegn currency" column 02
nextline
nextline
print  "TBALE B:"                     							column 02 
nextline                    
print  "PART 1: ANALYSIS OF DEPOSITS (Table A Item 2,4.1)"                          	column 02
nextline
