ONSTARTOFREPORT
##############################################################################
print  "DATE"                             						column 88
print asondate size 10                       						column 98 
nextline 
print  "MARGINS"				column 02
separatorline
print "0-1 year | Over 1 year"			column 65
separatorline
print  "Letters of Credit"			column 02
nextline
print  "Guarantees"				column 02 
nextline
print  "Acceptances"				column 02 
nextline
print "Others n.e.s"				column 02
nextline
separatorline					
nextline
print "ANALYSIS OF CONTRA ITEMS"		column 02
separatorline
print "ITEM"					column 04
print "Kshs	|	Forex*	|	TOTAL"	column 83
print "(Kshs equiv)"				column 101
nextline
separatorline
print "1 Undelivered spot sales"		column 04
nextline
print "2 Forward sales"				column 04
nextline
print "3 Guarantees"				column 04 
nextline
print "4 Acceptances"				column 04
nextline
print "5 Performance Bonds"			column 04
nextline
print "6 Bills for collection"			column 04
nextline
print "7 Others"				column 04
separatorline
print "TOTAL"					column 06
separatorline
nextline

print "ANALYSIS CONTRA ITEMS"			column 02
separatorline
print "ITEM"                                    column 04
print "Kshs     |       Forex*  |       TOTAL"  column 83
print "(Kshs equiv)"                            column 101
nextline
