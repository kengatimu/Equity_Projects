#
#**********************************************************************
#  DESC   :  Inactive Users Report
######################################################################
RECORDLAYOUT
####################################################################
#   
####################################################################

USER_ID 			stringtype
SOL_ID 				stringtype
USER_EMP_ID 			stringtype
ROLE_ID 			stringtype
USER_WORK_CLASS 		stringtype
USER_ACCT_EXPY_DATE 		stringtype
lchg_time 			stringtype
lchg_user_id			stringtype

LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
#
total_users numberType
gr_total_users numbertype
totalpages stringtype
total_pages stringtype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType
#
GROUPANDSORT
####################################################################
#   
#################################################################### 
SOL_ID ascending
#
#
REPOSITORY bankRepos.rip  
############################################################################
bankName        stringType
branchName      stringtype
#
REPOSITORY  argv4
#############################################################################
ipSetId				stringType

#
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################
#
PAGEFORMAT
####################################################################
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines 3
LinesPerPage 64
Topmargin       2
BottomMargin 2
columnsPerLine 100
pageHeaderLines 8
pageFooterLines 2
#
ONSTARTOFREPORT
####################################################################  

execute brBankHdg 
execute pageHdg
#
PAGEHEADER
###################################################################
#
execute brBankHdg 
execute pageHdg
#
#
####################################################################
#
PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
print "Pg:" column 2
print pagenumber column 5
print "of" column 7
print "<<TOP>>" column 10
nextline
#
#
ONEVERYRECORD 
####################################################################
#on every record
####################################################################


Print USER_ID 			column 2
print USER_EMP_ID 		column 10
print ROLE_ID 			column 20
Print USER_WORK_CLASS 		column 40
Print USER_ACCT_EXPY_DATE 	column 52
Print lchg_time			column 67
Print lchg_user_id		column 80

#####################################################################
BEFOREBREAKOF SOL_ID

print  "BRANCH ID: " column 2
print SOL_ID  column 16
nextline
#
#
AFTERBREAKOF SOL_ID
####################################################################
# After break of SOL_ID
####################################################################
nextline
separatorline
print " Inactive Users:  " column 2
set total_users = groupcount user_id
print total_users column 25
nextline
separatorline
#
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
begin
     separatorline
     nextline
     set gr_total_users = totalcount user_id
     print " Total No. Of Inactive Users: " column 2 

     print gr_total_users column 33
     separatorline
end

begin
     print "printed by: "  column 37
     print  lv_userId
     nextline
     nextline
     print "verified by:"  column 37
     nextline
     nextline
     nextline
     print "*************************END OF REPORT****************************" size 100 center
end
#
#
#############################################################################
Procedure  pageHdg
#############################################################################

begin
     nextline
     print "INACTIVE USERS REPORT  "  size  100 center 
     nextline
     nextline
    end

begin
     separatorline
     print "USER ID "        column  2
     print "EMP NO"          column 10
     print "ROLE ID"         column 20
     print "WRK CLS"         column 40
     print "PWD EXP"         column 52
     print "DEL DATE"        column 67
     print "DEL BY"          column 80
     separatorline 
end
#
#   
########################################################################
PROCEDURE brBankHdg
##############################################################################
begin
     print "Page No. "   column  80 
     print page_number precision 0
     nextline
     print today column  80
     nextline
     nextline
     print "EQUITY BANK LIMITED"  size 100 center 
     nextline
     set lv_setid = ipsetId
     set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
     print lv_setdesc size 100 center 
  end

####################################################################
# End of File
######################################################################
